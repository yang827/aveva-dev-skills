--
-- File:            appdefn.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Thu Jan 29 17:28:00 2004
--
--
-- Description:     Add-in definition object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addModuleStartupCall(STRING)     -                   adds callback to be run when we enter PDMS
--  addObjects(ARRAY)                -                   adds array of objects to define toolbars and menus
--  addStartupCall(STRING)           -                   adds callback to be run when the application is first started
--  addSwitchCall(STRING)            -                   adds callback to be run when we switch to the application
--  appDefn()                        -                   sets defaults for application definition constructed without arguments
--  initialiseForm()                 -                   run when switching to application; similar function to ISYSTEM
--  menu()                           STRING              returns text for menu entry
--  modifyForm()                     -                   modifies the main form on startup
--  modifyMenus()                    -                   modifies the menus on the main form
--  object(STRING)                   -                   sets application's "helper" object
--
------------------------------------------------------------------------
define object APPDEFN

  -- name of application, e.g. GEN, EQUI, ...
  member .name         is STRING

  -- title of application, e.g. General, Equipment, ...
  member .title        is STRING
  -- menu entry if different from title
  member .menu         is STRING

  -- name of the object used to define this application
  member .objectName   is STRING
  -- stored as first item in array because the type of object varies depending on the application,
  -- and we can't say 'member .object is ANY'
  -- helper object used to define this application
  member .object       is ARRAY

  -- directory containing application macros within %PDMSUI%
  member .directory    is STRING

  -- synonym for calling application macros
  member .synonym      is STRING

  -- determines whether application is administrative or not (used in Draft)
  member .admin        is BOOLEAN

  -- types of sheet or library used by this application (used in Draft)
  member .types        is STRING

  -- integer to determine gadgets used by application (used in Draft)
  member .gadgets      is REAL

  -- determines whether application has an entry on the applications menu
  member .showOnMenu   is BOOLEAN

  -- determines help file for application
  member .helpAlias is STRING

  -- name of group (if any)
  member .groupName    is STRING
  -- number of group (if any)
  member .groupNumber  is REAL

  -- function to call to initialise application
  member .initcall     is STRING

  -- flag whether application has already been loaded
  member .loaded       is BOOLEAN

  -- run when the application is loaded for the first time
  member .startupCalls is ARRAY
  -- array of applications whose constructor calls this application modifies
  member .modifiesStartup is ARRAY
  -- and the callbacks it adds
  member .modifyStartupCalls is ARRAY

  -- run whenever we switch to application
  member .switchCalls    is ARRAY
  -- array of applications whose initcalls this application modifies
  member .modifiesSwitch is ARRAY
  -- and the callbacks it adds
  member .modifySwitchCalls is ARRAY

  -- run when we enter the module
  member .moduleStartupCalls is ARRAY

endobject
-- End of object definition for APPDEFN

------------------------------------------------------------------------
--
-- Method:      .appDefn()
--
-- Description: sets defaults for application definition constructed without arguments
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appDefn()
  -- default to show application on menu
  !this.showOnMenu = false

  -- application has not been loaded
  !this.loaded     = false

  -- no callback by default
  !this.initcall   = ''

  -- no help file by default
  !this.helpAlias = ''

  -- not administrative by default
  !this.admin      = false

  -- set gadgets to 0 initially, i.e. nothing shown
  !this.gadgets    = 0
endmethod
-- End of method definition for .appDefn()

------------------------------------------------------------------------
--
-- Method:      .addSwitchCall()
--
-- Description: adds callback to be run when we switch to the application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSwitchCall(!call is STRING)
  if (!this.switchCalls.findFirst(!call).unset()) then
    !this.switchCalls.append(!call)
  endif
endmethod
-- End of method definition for .addSwitchCall(STRING)

------------------------------------------------------------------------
--
-- Method:      .addStartupCall()
--
-- Description: adds callback to be run when the application is first started
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addStartupCall(!call is STRING)
  if (!this.startupCalls.findFirst(!call).unset()) then
    !this.startupCalls.append(!call)
  endif
endmethod
-- End of method definition for .addStartupCall(STRING)

------------------------------------------------------------------------
--
-- Method:      .addModuleStartupCall()
--
-- Description: adds callback to be run when we enter PDMS
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addModuleStartupCall(!call is STRING)
  if (!this.moduleStartupCalls.findFirst(!call).unset()) then
    !this.moduleStartupCalls.append(!call)
  endif
endmethod
-- End of method definition for .addModuleStartupCall(STRING)

------------------------------------------------------------------------
--
-- Method:      .object()
--
-- Description: sets application's "helper" object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .object(!objName is STRING)
  !this.objectName = !objName
  !this.object[1] = object $!objName()
endmethod
-- End of method definition for .object(STRING)

------------------------------------------------------------------------
--
-- Method:      .addObjects()
--
-- Description: adds array of objects to define toolbars and menus
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addObjects(!arr is ARRAY)
  !toolbars = ARRAY()
  !menus = ARRAY()

  do !object values !arr
    if (!object.objectType() eq 'ADDTOOLBAR') then
      !toolbars.append(!object)
    elseif (!object.objectType() eq 'ADDMENU') then
      !menus.append(!object)
    endif
  enddo

  !this.object[2] = !toolbars
  !this.object[3] = !menus
endmethod
-- End of method definition for .addObjects(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: modifies the main form on startup
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  -- return if this application has no object
  if (!this.object.empty()) then
    return
  endif
  if (defined(!this.object[1])) then
    !this.object[1].modifyForm()
    handle (2,779)
      -- handle any errors if this function not present
    endhandle
  endif
  -- if a alternative-style toolbar definition has occurred, run that in
  if (defined(!this.object[2])) then
    do !defn values !this.object[2]
      !defn.add()
    enddo
  endif
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: modifies the menus on the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  -- return if this application has no object
  if (!this.object.empty()) then
    return
  endif
  if (defined(!this.object[1])) then
    !this.object[1].modifyMenus()
    handle (2,779)
      -- handle any errors if this function not present
    endhandle
  endif
  -- if a alternative-style menu definition has occurred, run that in
  if (defined(!this.object[3])) then
    do !menuDefn values !this.object[3]
      !menuDefn.add()
    enddo
  endif
endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .initialiseForm()
--
-- Description: run when switching to application; similar function to ISYSTEM
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseForm()
  -- return if this application has no object
  if (!this.object.empty()) then
    return
  endif
  !object = !this.object[1]
  !object.initialiseForm()
  handle (2,779)
    -- handle any errors if this function not present
  endhandle
endmethod
-- End of method definition for .initialiseForm()

------------------------------------------------------------------------
--
-- Method:      .menu()
--
-- Description: returns text for menu entry
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   STRING
--
------------------------------------------------------------------------
define method .menu() is STRING
  if (!this.menu.set()) then
    return !this.menu
  elseif (!this.title.set()) then
    return !this.title
  else
    return ''
  endif
endmethod
-- End of method definition for .menu() STRING
