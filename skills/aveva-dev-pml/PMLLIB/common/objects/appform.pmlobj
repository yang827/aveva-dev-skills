--
-- File:            appform.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Wed Feb 04 16:22:34 2004
--
--
-- Description:     Controls visibility of forms and reshowing forms on entry to PDMS
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appForm()                        -                   Constructor method
--  appForm(FORM)                    -                   Constructor method
--  appForm(FORM,ARRAY,ARRAY,BOOLEAN,BOOLEAN) -                   Constructor method
--  visibleInApps(STRING)            -
--
------------------------------------------------------------------------
define object APPFORM
  -- Form to be registered
  member .form is FORM

  -- Applications the form is visible in
  member .visibleInApps is ARRAY

  -- Applications required to be loaded before this form is shown
  member .requiredApps is ARRAY

  -- TRUE to reshow form on entry to PDMS if it was previously open
  member .showOnStartup is BOOLEAN

  -- TRUE to reshow on entry to application if it was previously open in that application
  member .showOnSwitch is BOOLEAN

  -- TRUE if forms is currently shown
  member .shown is BOOLEAN
endobject
-- End of object definition for APPFORM

------------------------------------------------------------------------
--
-- Method:      .appForm()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appForm(!form is FORM)
  !this.form = !form
  !this.shown = !form.shown()
  !this.showOnSwitch = true
  !this.showOnStartup = true
endmethod
-- End of method definition for .appForm(FORM)

------------------------------------------------------------------------
--
-- Method:      .appForm()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM
--    2   R      ARRAY
--    3   R      ARRAY
--    4   R      BOOLEAN
--    5   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appForm(!form is FORM, !visibleInApps is ARRAY, !requiredApps is ARRAY, !showOnSwitch is BOOLEAN, !showOnStartup is BOOLEAN)
  !this.form = !form
  !this.shown = !form.shown()
  !this.visibleInApps = !visibleInApps
  !this.requiredApps = !requiredApps
  !this.showOnSwitch = !showOnSwitch
  !this.showOnStartup = !showOnStartup
endmethod
-- End of method definition for .appForm(FORM, ARRAY, ARRAY, BOOLEAN, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .appForm()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appForm()
  !this.shown = false
  !this.showOnStartup = false
  !this.showOnSwitch = false
endmethod
-- End of method definition for .appForm()

------------------------------------------------------------------------
--
-- Method:      .visibleInApps()
--
-- Description: adds application to list of applications this form's visible in
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .visibleInApps(!app is STRING)
  !appUC = !app.upcase()
  !index = !this.visibleInApps.findFirst(!appUC)
  if (!index.unset()) then
    !this.visibleInApps.append(!appUC)
  endif
endmethod
-- End of method definition for .visibleInApps(STRING)
