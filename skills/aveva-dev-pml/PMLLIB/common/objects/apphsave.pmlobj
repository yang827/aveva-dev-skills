--
-- File:            apphsave.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        design
--   Replaces:
--
-- Author:          Malcolm Barlow
-- Created:         Thu Mar 29 2007
--
-- Description:     Object for autosave utility [NOT SUPPORTED]
--                  This object is instantiated by the PML add-in system
--                  ADD-IN FILE ASAVE MUST BE CHANGED TO ENABLE THIS OBJECT
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appHsave()                       -                   Constructor
--  check()                          -                   callback from some event to check time since last save
--  getSettings(REAL,BOOLEAN,BOOLEAN) -                   Get the autosave interval and operation
--  initialise(BOOLEAN)              -                   initialisation for autosave application
--  modifyMenus()                    -                   Runs all other menu creation methods
--  settings(REAL,BOOLEAN,BOOLEAN)   -                   Set the autosave interval and operation
--
------------------------------------------------------------------------
define object APPHSAVE

  -- true if autosave service is service is active
  member .autoSaveOn    is BOOLEAN
  -- Autosave time interval
  member .autoInterval  is REAL
  -- set the operations
  member .autoSavework  is BOOLEAN
  member .autoGetwork   is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .appHsave()
--
-- Description: Constructor
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appHsave()

  -- initialise variables
  !!lastSaveDateTime = object DATETIME()
  !this.autoSaveOn   = false
  !this.autoSavework = true
  !this.autoGetwork  = false
  !this.autoInterval = 60
  -- create global variable so that methods of this object can be called from elsewhere
  !!appHsave = !this

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  -- add option to menu in general app
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Save Work Options...', 'vmAutoSave', 'appHSave')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .initialise
--
-- Description: initialisation for autosave application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true to enable the service, false to disable
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!serviceOn is BOOLEAN)

  -- switch autosave on and off
  !this.autoSaveOn = !serviceOn
  -- reset the last save time to the time that autosave was switched on
  -- (although no save is done)
  !!lastSaveDateTime = object DATETIME()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .settings()
--
-- Description: Set the autosave interval and operation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Time interval in minutes
--    2   R      BOOLEAN     Perform savework operation if true
--    2   R      BOOLEAN     Perform getwork operation if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settings(!interval is REAL, !savework is BOOLEAN, !getwork is BOOLEAN)

  -- set the autosave time interval
  !this.autoInterval = !interval
  -- set the operations
  !this.autoSavework = !savework
  !this.autoGetwork  = !getwork

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .getSettings()
--
-- Description: Get the autosave interval and operation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     REAL        Time interval in minutes
--    2   RW     BOOLEAN     Perform savework operation if true
--    2   RW     BOOLEAN     Perform getwork operation if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSettings(!interval is REAL, !savework is BOOLEAN, !getwork is BOOLEAN)

  -- set the autosave time interval
  !interval = !this.autoInterval
  -- set the operations
  !savework = !this.autoSavework
  !getwork  = !this.autoGetwork

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .check()
--
-- Description: callback from some event to check time since last save
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .check()

  -- check that this method should run
  if( !this.autoSaveOn.not() ) then
    return
  endif
  if( undefined( !!lastSaveDateTime ) ) then
    return
  endif

  -- get current time
  !ceT    = object DATETIME()
  !ceH    = !ceT.hour()
  -- get last save time
  !lastH  = !!lastSaveDateTime.hour()
  -- test for last save before midnight & current time after midnight
  if(!ceH lt !lastH) then
    !ceH = !ceH + 24
  endif
   -- get current time in minutes
  !ceTime    = (!ceH * 60) + !ceT.minute()
  -- get last save time in minutes
  !startTime = (!lastH * 60) + !!lastSaveDateTime.minute()

  if ((!ceTime - !startTime) ge !this.autoInterval) then
    -- reset the interval start
    !!lastSaveDateTime = object DATETIME()
    -- confirm the action
    !message = 'AUTOSAVE: Do you want to '
    if( !this.autoSavework ) then
      !message = !message + 'Save Work'
      if( !this.autoGetwork ) then
        !message = !message + ' & '
      endif
    endif
    if( !this.autoGetwork ) then
      !message = !message + 'Get Work'
    endif
    !saveConfirm = !!alert.confirm(!message)
    if(!saveConfirm eq 'YES') then
      if( !this.autoGetwork ) then
        GETWORK
        handle any
        endhandle
      endif
      if( !this.autoSavework ) then
        SAVEWORK
        handle any
          !!alert.error(!!error.text)
          return
        endhandle
      endif
    endif
  endif

endmethod
-- End of method definition
