--
-- Description:
-- Application math library
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  globalInstance()                 -                   Create global instance of object
--  string()                         STRING              Constructor
--
------------------------------------------------------------------------

-- Define object
define object APPMATHLIB

  -- Circle constructors
  member .gmfArc       is GMFARC

  -- Line constructors
  member .gmfLine      is GMFLINE

  -- Position constructors
  member .gmfPosition  is GMFPOSITION

  -- Plane constructors
  member .gmfPlane     is GMFPLANE

  -- Box
  member .gmfBox       is GMFBOX

  -- Direction
  member .gmfDirection is GMFDIRECTION

  -- Angle
  member .gmfAngle     is GMFANGLE

  -- Real Arc object
  member .arc          is ARC

  -- Real Line object
  member .line         is LINE

  -- Real Plane
  member .plane        is PLANE

  -- Real Position
  member .position     is POSITION

  -- Real Point vector
  member .pointVector  is POINTVECTOR

  -- Linear Grid
  member .linearGrid   is LINEARGRID

  -- Radial Grid
  member .radialGrid   is RADIALGRID

  -- Plant Grid
  member .plantGrid    is PLANTGRID

  -- Volume
  member .volume       is VOLUME

  -- Direction
  member .direction    is DIRECTION

endobject
-- End of object definition for APPMATHLIB

------------------------------------------------------------------------
--
-- Method:      string()
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .string() is STRING

  return 'Application Math Library'

endmethod
-- End of method definition for .string() STRING

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!appMathLib    = !this

endmethod
-- End of method definition for .globalInstance()
