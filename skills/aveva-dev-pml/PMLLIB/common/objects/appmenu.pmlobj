-- File:            appmenu.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Tue Feb 10 15:29:55 2004
--
--
-- Description:     used to hold information about menu fields visible in an application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activate(BOOLEAN)                -                   activates the fields in the object
--  add(STRING)                      -                   add separator
--  add(STRING,STRING)               -                   add named separator
--  add(STRING,STRING,STRING)        -                   insert new field after named field
--  add(STRING,STRING,STRING,STRING) -                   add field following previous field
--  addFieldName(STRING)             -                   adds field name to list
--  appMenu(MENU)                    -                   Constructor method
--  appMenu(STRING)                  -                   Constructor method
--  empty()                          BOOLEAN             returns true if the menu has had no items added (or removed)
--  insertAfter(STRING,STRING)       -                   insert new unnamed separator after named field
--  insertAfter(STRING,STRING,STRING) -                   insert named separator after named field
--  insertAfter(STRING,STRING,STRING,STRING) -                   insert new field after named field
--  insertAfter(STRING,STRING,STRING,STRING,STRING) -                   insert new field after named field
--  insertBefore(STRING,STRING)      -                   insert new unnamed separator before named field
--  insertBefore(STRING,STRING,STRING) -                   insert named separator before named field
--  insertBefore(STRING,STRING,STRING,STRING) -                   insert new field before named field
--  insertBefore(STRING,STRING,STRING,STRING,STRING) -                   insert new field before named field
--  remove(STRING)                   -                   remove item with given fieldname from menu
--  removeSystem(STRING)             -                   remove system menu item (defined in APPDESMAIN) with given fieldname from menu
--
------------------------------------------------------------------------
define object APPMENU
  -- array containing unique ids
  member .fieldNames is ARRAY

  -- array containing unique ids of menu fields to remove
  member .removeFieldNames is ARRAY

  -- array containing unique ids of system (APPDESMAIN) menu fields to remove
  member .removeSystemFieldNames is ARRAY

  -- menu on main form that this one corresponds to
  member .menu is MENU

  -- property we want to set to deactivate menus
  member .property is STRING

  -- field name of last menu item added
  member .previous is STRING
endobject
-- End of object definition for APPMENU

------------------------------------------------------------------------
--
-- Method:      .appMenu()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        menu to add items to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appMenu(!menu is MENU)
  -- set the menu this corresponds to
  !this.menu = !menu

  !this.property = 'VISIBLE'
endmethod
-- End of method definition for .appMenu(MENU)

------------------------------------------------------------------------
--
-- Method:      .appMenu()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      name of menu to add items to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appMenu(!menuName is STRING)
  !menu = !!appCntrl.mainForm.attribute(!menuName)
  handle(2,766)
    -- attribute does not exist
    -- create new menu
    !menu = !!appCntrl.mainForm.newMenu(!menuName)
  endhandle
  !this.menu = !menu

  !this.property = 'VISIBLE'
endmethod
-- End of method definition for .appMenu(STRING)

------------------------------------------------------------------------
--
-- Method:      .insertBefore()
--
-- Description: insert new field before named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field to insert before
--    2   R      STRING      field type
--    3   R      STRING      dtext
--    4   R      STRING      rtext
--    5   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertBefore(!item is STRING, !fieldType is STRING, !dtext is STRING, !rtext is STRING, !fieldName is STRING)
  !this.menu.insertBefore(!item, !fieldType, !dtext, !rtext, !fieldName)
  handle(61,566)
    -- menu item of this fieldname is already present
    -- ignore the error
  elsehandle none
    !this.menu.setFieldProperty(!fieldName, !this.property, false)
  endhandle

  !this.addFieldName(!fieldName)
endmethod
-- End of method definition for .insertBefore(STRING, STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertBefore()
--
-- Description: insert new field before named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      STRING
--    3   R      STRING
--    4   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertBefore(!item is STRING, !fieldType is STRING, !dtext is STRING, !rtext is STRING)
  -- set unique fieldname to dtext if no field name specified
  !this.insertBefore(!item, !fieldType, !dtext, !rtext, !dtext)
endmethod
-- End of method definition for .insertBefore(STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertBefore()
--
-- Description: insert new unnamed separator before named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field to insert before
--    2   R      STRING      field type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertBefore(!item is STRING, !fieldType is STRING)
  !this.menu.insertBefore(!item, !fieldType)
endmethod
-- End of method definition for .insertBefore(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertBefore()
--
-- Description: insert named separator before named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field to insert before
--    2   R      STRING      field type
--    3   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertBefore(!item is STRING, !fieldType is STRING, !fieldName is STRING)
  !this.menu.insertBefore(!item, !fieldType, !fieldName)
  -- !this.addFieldName(!fieldName)
endmethod
-- End of method definition for .insertBefore(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertAfter()
--
-- Description: insert new field after named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field to insert after
--    2   R      STRING      field type
--    3   R      STRING      dtext
--    4   R      STRING      rtext
--    5   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertAfter(!item is STRING, !fieldType is STRING, !dtext is STRING, !rtext is STRING, !fieldName is STRING)
  !this.menu.insertAfter(!item, !fieldType, !dtext, !rtext, !fieldName)
  handle(61,566)
    -- menu item of this fieldname is already present
    -- ignore the error
  elsehandle none
    !this.menu.setFieldProperty(!fieldName, !this.property, false)
  endhandle

  !this.addFieldName(!fieldName)
endmethod
-- End of method definition for .insertAfter(STRING, STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertAfter()
--
-- Description: insert new field after named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      STRING
--    3   R      STRING
--    4   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertAfter(!item is STRING, !fieldType is STRING, !dtext is STRING, !rtext is STRING)
  -- set unique fieldname to dtext if no field name specified
  !this.insertAfter(!item, !fieldType, !dtext, !rtext, !dtext)
endmethod
-- End of method definition for .insertAfter(STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertAfter()
--
-- Description: insert new unnamed separator after named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field to insert before
--    2   R      STRING      field type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertAfter(!item is STRING, !fieldType is STRING)
  !this.menu.insertAfter(!item, !fieldType)
endmethod
-- End of method definition for .insertAfter(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertAfter()
--
-- Description: insert named separator after named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field to insert before
--    2   R      STRING      field type
--    3   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertAfter(!item is STRING, !fieldType is STRING, !fieldName is STRING)
  !this.menu.insertAfter(!item, !fieldType, !fieldName)
  -- !this.addFieldName(!fieldName)
endmethod
-- End of method definition for .insertAfter(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: add field following previous field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field type
--    2   R      STRING      dtext
--    3   R      STRING      rtext
--    4   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!fieldType is STRING, !dtext is STRING, !rtext is STRING, !fieldName is STRING)
  if (!this.previous.set()) then
    !this.menu.insertAfter(!this.previous, !fieldType, !dtext, !rtext, !fieldName)
    handle(61,566)
      -- menu item of this fieldname is already present
      -- ignore the error
    elsehandle none
      !this.menu.setFieldProperty(!fieldName, !this.property, false)
    endhandle
    !this.previous = !fieldName
  else
    !this.menu.add(!fieldType, !dtext, !rtext, !fieldName)
    handle(61,566)
      -- menu item of this fieldname is already present
      -- ignore the error
      !this.previous = !fieldName
    elsehandle none
      -- !this.menu.setActive(!dtext, false)
      !this.menu.setFieldProperty(!fieldName, !this.property, false)
    endhandle
  endif

  !this.addFieldName(!fieldName)
endmethod
-- End of method definition for .add(STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: insert new field after named field
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      STRING
--    3   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!fieldType is STRING, !dtext is STRING, !rtext is STRING)
  -- set unique fieldname to dtext if no field name specified
  !this.add(!fieldType, !dtext, !rtext, !dtext)
endmethod
-- End of method definition for .add(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: add separator
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!fieldType is STRING)
  !this.menu.add(!fieldType)

  !this.previous = STRING()
endmethod
-- End of method definition for .add(STRING)

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: add named separator
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field type
--    2   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!fieldType is STRING, !fieldName is STRING)
  !this.menu.add(!fieldType, !fieldName)
  handle (61,566)
    !this.previous = !fieldName
  elsehandle none
    !this.previous = STRING()
  endhandle

  -- !this.addFieldName(!fieldName)
endmethod
-- End of method definition for .add(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .remove()
--
-- Description: remove item with given fieldname from menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field name to remove
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!fieldName is STRING)
  !pos = !this.removeFieldNames.findFirst(!fieldName)
  if (!pos.unset()) then
    !this.removeFieldNames.append(!fieldName)
  endif
endmethod
-- End of method definition for .remove(STRING)

------------------------------------------------------------------------
--
-- Method:      .removeSystem()
--
-- Description: remove system menu item (defined in APPDESMAIN) with given fieldname from menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field name to remove
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeSystem(!fieldName is STRING)
  !pos = !this.removeSystemFieldNames.findFirst(!fieldName)
  if (!pos.unset()) then
    !this.removeSystemFieldNames.append(!fieldName)
  endif
endmethod
-- End of method definition for .removeSystem(STRING)

------------------------------------------------------------------------
--
-- Method:      .addFieldName()
--
-- Description: adds field name to list
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      field name
-- Return:
--   [Data Type] [Description]
--   STRING)
--
------------------------------------------------------------------------
define method .addFieldName(!fieldName is STRING)
  -- find out if a menu item with this id has already been created
  !pos = !this.fieldNames.findFirst(!fieldName.upcase())

  -- if not, add to ids
  if (!pos.unset()) then
    !this.fieldNames.append(!fieldName.upcase())
  endif
endmethod
-- End of method definition for .addFieldName(STRING) STRING)

------------------------------------------------------------------------
--
-- Method:      .activate()
--
-- Description: activates the fields in the object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     set active or not?
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activate(!active is BOOLEAN)

  -- Reinstate system (APPDESMAIN) defined menus that have been removed
  if (!active.not()) then
    do !fieldName values !this.removeSystemFieldNames
      !this.menu.setFieldProperty(!fieldName, !this.property, true)
    enddo
  endif

  do !fieldName values !this.fieldNames
    !this.menu.setFieldProperty(!fieldName, !this.property, !active)
    -- insert handle here so no error is raised if the field can't be found?
    -- no, because the menu item will have been added by this object so we know it's there
  enddo

  -- if we're activating this menu, make sure all entries that should be hidden are hidden
  if (!active) then
    do !fieldName values !this.removeFieldNames
      !this.menu.setFieldProperty(!fieldName, !this.property, false)
    enddo
    do !fieldName values !this.removeSystemFieldNames
      !this.menu.setFieldProperty(!fieldName, !this.property, false)
    enddo
  endif

endmethod
-- End of method definition for .activate(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .empty()
--
-- Description: returns true if the menu has had no items added (or removed)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      is this APPMENU object empty?
--
------------------------------------------------------------------------
define method .empty() is BOOLEAN
  return (!this.fieldNames.empty() and !this.removeFieldNames.empty() and !this.removeSystemFieldNames.empty())
endmethod
-- End of method definition for .empty() BOOLEAN
