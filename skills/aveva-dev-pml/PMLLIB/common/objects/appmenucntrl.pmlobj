--
-- File:            appmenucntrl.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Wed Feb 18 10:16:35 2004
--
--
-- Description:     Controls visibility of menus across applications
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateMenus(STRING,BOOLEAN)    BOOLEAN             set the active state of the menu options in the given app
--  addBarMenu(APPBARMENU,STRING)    -                   registers an APPBARMENU object of pulldown menus to show in the given application
--  addMenu(APPBARMENU,STRING)       -                   registers an APPBARMENU object of pulldown menus to show in the given application
--  addMenu(APPMENU,STRING)          -                   register APPMENU object to show menu entries in given application
--  appMenuCntrl()                   -                   controls visibility of menu fields in applications
--
------------------------------------------------------------------------
define object APPMENUCNTRL
  -- applications registered with this object
  member .apps is ARRAY

  -- this array contains an array of menus for each application
  member .menus is ARRAY
endobject
-- End of object definition for APPMENUCNTRL

------------------------------------------------------------------------
--
-- Method:      .appMenuCntrl()
--
-- Description: controls visibility of menu fields in applications
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appMenuCntrl()
  -- add default application ALL so menus can be shown in all applications
  !this.apps.append('ALL')
  !this.menus.append(object ARRAY())
endmethod
-- End of method definition for .appMenuCntrl()

------------------------------------------------------------------------
--
-- Method:      .addMenu()
--
-- Description: register APPMENU object to show menu entries in given application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      APPMENU
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addMenu(!menu is APPMENU, !app is STRING)
  -- don't add if the menu is empty
  if (!menu.empty()) then
    return
  endif

  -- find if app is already present
  !pos = !this.apps.findFirst(!app.upcase())

  -- add it if it's not
  if (!pos.unset()) then
    !this.apps.append(!app.upcase())
    !pos = !this.apps.size()
    !this.menus[!pos] = ARRAY()
  endif

  -- put menu in array for given app
  !this.menus[!pos].append(!menu)

endmethod
-- End of method definition for .addMenu(STRING, APPMENU)

------------------------------------------------------------------------
--
-- Method:      .addMenu()
--
-- Description: registers an APPBARMENU object of pulldown menus to show in the given application
--              added so calling !!appMenuCntrl.addMenu with an APPBARMENU object doesn't fail silently during form creation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      APPBARMENU
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addMenu(!bmenu is APPBARMENU, !app is STRING)
  !this.addBarMenu(!bmenu, !app)
endmethod
-- End of method definition for .addMenu(APPBARMENU, STRING)

------------------------------------------------------------------------
--
-- Method:      .addBarMenu()
--
-- Description: registers an APPBARMENU object of pulldown menus to show in the given application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      APPBARMENU
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addBarMenu(!bmenu is APPBARMENU, !app is STRING)
  -- don't add if the menu is empty
  if (!bmenu.empty()) then
    return
  endif

  !pos = !this.apps.findFirst(!app.upcase())
  if (!pos.unset()) then
    !this.apps.append(!app.upcase())
    !pos = !this.apps.size()
    !this.menus[!pos] = ARRAY()
  endif

  -- put menu in array for given app
  !this.menus[!pos].append(!bmenu)
endmethod
-- End of method definition for .addBarMenu(STRING, APPBARMENU)

------------------------------------------------------------------------
--
-- Method:      .activateMenus()
--
-- Description: set the active state of the menu options in the given app
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
--
------------------------------------------------------------------------
define method .activateMenus(!app is STRING, !active is BOOLEAN) is BOOLEAN
  -- activate menus that are shown in ALL applications
  do !menu values !this.menus[1]
    !menu.activate(!active)
  enddo

  !pos = !this.apps.findFirst(!app.upcase())
  if (!pos.unset()) then
    return false
  endif

  -- activate menus for this application
  do !menu values !this.menus[!pos]
    !menu.activate(!active)
  enddo

  return true
endmethod
-- End of method definition for .activateMenus(STRING, BOOLEAN) BOOLEAN
