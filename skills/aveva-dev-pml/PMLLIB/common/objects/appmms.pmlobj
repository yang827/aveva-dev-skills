------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  modifyMenus()                    -                   Runs all other menu creation methods
--  utilitiesMenu()                  -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPMMS
endobject
-- End of object definition for APPMMS
------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.utilitiesMenu()
endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .utilitiesMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilitiesMenu()

  -- Check for availability of Clash Manager
  !mmsClash = TRUE
  !unusedCheck = object CLASHMANAGERINTERFACE(TRUE)
  handle any
    !mmsClash = FALSE
  endhandle

  -- Check for old Model Management or Standalone Clash Manager project
  !mmsProj = !!mmsIsThis3dmmProj()
  if (!mmsProj) then
    -- load the mmsconfig file if a 3dmm project
    !!comDefineGlobal(object MMSCONFIG())
    !!comDefineGlobal(object MMSINTERFACE())
    -- This check must not return false if Clash Manager check above returned true
    !mmsClash = (!mmsClash or !!mmsConfig.isClashManagerStandAlone())
  endif

  if (!mmsClash or !mmsProj) then
    -- what module we in
    !session  = CURRENT SESSION
    !module   = !session.module()
    !isDesign = (!module.upcase() eq 'DESIGN' or !module.upcase() eq 'OUTFITTING')

    if (!isDesign) then
      !menu = object APPMENU('sysUtil')
    else
      !menu = object APPMENU('utilities')
    endif
    if (!mmsClash) then
      if (!isDesign) then
        !menu.insertAfter('autonaming', 'SEPARATOR', 'mmsSep')
        !menu.insertAfter('mmsSep', 'CALLBACK', 'Clash Manager Start Up...', '!!mmsCall3dmm()', 'clashManagerStart')
      endif
    else
      !menu.insertAfter('autonaming', 'SEPARATOR', 'mmsSep')
      !menu.insertAfter('mmsSep', 'CALLBACK', 'Model Management Start Up...', '!!mmsCall3dmm()', 'modelManagerStart')
      if (!isDesign) then
        !menu.insertAfter('modelManagerStart', 'CALLBACK', 'Model Management PDMS Menu...', 'show !!mmsMainMenu', 'modelManagerMenu')
      endif
    endif
    !!appMenuCntrl.addMenu(!menu, 'ALL')
  else
    return
  endif

endmethod
-- End of method definition for .utilitiesMenu()
