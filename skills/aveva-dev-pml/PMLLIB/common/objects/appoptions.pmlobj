-- File:            appoptions.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Wed Feb 18 10:17:07 2004
--
--
-- Description:     object to store options for application switching and form control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appOptions()                     -                   Constructor method
--  load()                           -                   load options from file
--  save()                           -                   save options to file
--
------------------------------------------------------------------------
define object APPOPTIONS
  -- restore current element on loading
  member .restoreCe       is BOOLEAN

  -- restore previously open application on loading
  member .reloadApp       is BOOLEAN

  -- restore toolbar visibility (or revert to default)
  member .restoreToolbars is BOOLEAN

  -- reshown previously opened forms
  member .reshowForms     is BOOLEAN
endobject
-- End of object definition for APPOPTIONS

------------------------------------------------------------------------
--
-- Method:      .appOptions()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appOptions()
  -- set default values for options
  !this.restoreCe = true
  !this.reloadApp = true
  !this.restoreToolbars = true
  !this.reshowForms = true

  -- load options from file to override defaults if we can
  !this.load()
endmethod
-- End of method definition for .appOptions()

------------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: save options to file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()
  !file = object FILE('%PDMSUSER%\appcntrl-opt.pmldat')

  !out = ARRAY()
  !out.append('restoreCe: ' & !this.restoreCe)
  !out.append('reloadApp: ' & !this.reloadApp)
  !out.append('restoreToolbars: ' & !this.restoreToolbars)
  !out.append('reshowForms: ' & !this.reshowForms)

  !file.writeFile('OVERWRITE', !out)
endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      .load()
--
-- Description: load options from file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load()
  !file = object FILE('%PDMSUSER%\appcntrl-opt.pmldat')
  if (!file.exists().not()) then
    return
  endif

  !lines = !file.readFile()
  handle any
    return
  endhandle

  do !line values !lines
    skip if (!line.trim().empty() or !line.substring(1,1) eq '#')
    !key = !line.part(1, ':').trim().lowcase()
    !value = !line.after(':').trim()
    if (!key eq 'restorece') then
      !this.restoreCe = !value.boolean()
    elseif (!key eq 'reloadapp') then
      !this.reloadApp = !value.boolean()
    elseif (!key eq 'restoretoolbars') then
      !this.restoreToolbars = !value.boolean()
    elseif (!key eq 'reshowforms') then
      !this.reshowForms = !value.boolean()
    endif
  enddo
endmethod
-- End of method definition for .load()
