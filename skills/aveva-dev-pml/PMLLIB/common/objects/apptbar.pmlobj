-- File:            apptbar.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Wed Feb 18 10:18:27 2004
--
--
-- Description:     object to store information about registered toolbar
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appTbar(GADGET)                  -                   Constructor method
--  appTbar(GADGET,ARRAY,ARRAY,BOOLEAN,BOOLEAN) -                   Constructor method
--
------------------------------------------------------------------------
define object APPTBAR
  -- Form to be registered
  member .toolbar is GADGET

  -- Applications the form is visible in
  member .visibleInApps is ARRAY

  -- Applications required to be loaded before this form is shown
  member .requiredApps is ARRAY

  -- TRUE to reshow form on entry to PDMS if it was previously open
  -- member .showOnStartup is BOOLEAN

  -- TRUE to reshow on entry to application if it was previously open in that application
  -- member .showOnSwitch is BOOLEAN

  -- TRUE if forms is currently shown
  member .visible is BOOLEAN

  -- TRUE if active state of toolbar is controlled
  member .controlled is BOOLEAN
endobject
-- End of object definition for APPFORM

------------------------------------------------------------------------
--
-- Method:      .appTbar()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appTbar(!toolbar is GADGET)
  !this.toolbar = !toolbar
  !this.visible = true
  -- !this.showOnSwitch = false
  -- !this.showOnStartup = false
  !this.controlled = true
endmethod
-- End of method definition for .appTbar(GADGET)

------------------------------------------------------------------------
--
-- Method:      .appTbar()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET
--    2   R      ARRAY
--    3   R      ARRAY
--    4   R      BOOLEAN
--    5   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appTbar(!toolbar is GADGET, !visibleInApps is ARRAY, !requiredApps is ARRAY, !visible is BOOLEAN, !controlled is BOOLEAN)
  !this.toolbar = !toolbar
  !this.visibleInApps = !visibleInApps
  !this.requiredApps = !requiredApps
  !this.visible = !visible
  !this.controlled = !controlled
endmethod
-- End of method definition for .appTbar(GADGET, ARRAY, ARRAY, BOOLEAN, BOOLEAN)
