-- Define object
define object ARROW

  -- Direction
  member .dir     is DIRECTION
  -- Height
  member .length  is REAL
  -- Ratio of length to arrow head size
  member .ratio   is REAL
  -- Position
  member .pos     is POSITION

endobject
-- End of object definition for ARROW
