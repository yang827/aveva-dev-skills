--  Created:         Mon Oct 13 17:18:57 2008
--
-- Description:
-- Object representing an association member element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assMember()                      -                   Constructor
--  assMember(DBREF)                 -                   Constructor - build object from existing assmbr element
--  assMemberSet()                   BOOLEAN
--  debug()                          BOOLEAN             Returns true if debug mode switched on (!!assocDebug = true)
--  getEncodedData(STRING,STRING)    STRING              Finds data !dataCode encoded into !sourceString
--  getMemberReference()             DBREF               Get the AMEMRF of this member.
--  getReference()                   DBREF               Get the ASSTAR of this member if set,otherwise get AMEMRF.
--  getTargetReference()             DBREF               Get the ASSTAR of this member.
--  plane()                          PLANE               return plane derived from posev and direv
--  pointVector()                    POINTVECTOR         return point vector derived from posev and direv
--  save(DBREF)                      -                   Save settings in this object to an existing ASSMBR element
--  setExpression(DBREF,STRING,STRING) -                   Set expression
--  showPlane(REAL)                  -
--  stdDesignPoint(DBREF,DBREF)      -                   Create standard Design Point member
--  stdElement(DBREF)                -                   Create standard element member
--  stdPPoint(DBREF,REAL)            -                   Create standard P-Point member
--
------------------------------------------------------------------------
--

define object ASSMEMBER

  -- Association member element
  member .assMbr         is DBREF
  -- Element reference
  member .amemrf         is DBREF
  -- Target reference - corresponds to ASSTAR attribute, but may contain deprecated TARF attribute value
  member .tarf           is DBREF
  -- P-point number
  member .ppNumb         is REAL
  -- D-point number
  member .numb           is REAL
  -- D-point reference
  member .desPoiRef      is DBREF
  -- Position expression
  member .posExpression  is STRING
  -- Direction expression
  member .dirExpression  is STRING
  -- Real expression
  member .realExpression is STRING
  -- Purpose of member
  member .purpose        is STRING
  -- P-line name
  member .pKey           is STRING
  -- Distance along P-line
  member .pkDistance     is REAL
  -- Saved Position
  member .savPosition    is POSITION
  -- Saved Direction
  member .savDirection   is DIRECTION
  -- Derived position
  member .posEv          is POSITION
  -- Derived direction
  member .dirEv          is DIRECTION
  -- Actual type - potentially useful for recovery from deleted target reference (tarf)
  member .actType        is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      assMember
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assMember()

  -- P-point number
  !this.ppNumb        = -1
  -- DP-point number
  !this.numb          = -1
  -- DP-point ref
  !this.desPoiRef     = object DBREF()
  -- P-line name
  !this.pKey          = ''
  -- Distance along P-line
  !this.pkDistance    = 0
  -- initialise purpose
  !this.purpose       = ''
  -- clear expressions
  !this.posExpression = ''
  !this.dirExpression = ''
  !this.realExpression = ''

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      assMember
--
-- Description: Constructor - build object from existing assmbr element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association member element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assMember(!associationMember is DBREF)

  if( badref(!associationMember)) then
    -- leave object unset if bad reference
    return
  endif
  -- Association member element
  !this.assMbr       = !associationMember
  -- Element reference
  !this.amemrf       = !associationMember.amemrf
  -- Target reference
  -- Allow for deprecated   attribute
  if( !associationMember.asstar.set() ) then
    -- ASSTAR set - could be BADREF
    !this.tarf       = !associationMember.asstar
  else
    if( !associationMember.tarf.set() ) then
      -- TARF set and ASSTAR not set (deprecated)
      !this.tarf       = !associationMember.tarf
    else
      -- neither TARF nor ASSTAR set
      !this.tarf       = object DBREF()
    endif
  endif
  -- P-point number
  !this.ppNumb       = !associationMember.ppNumb
  -- DP-point number
  !this.numb         = !associationMember.numb
  -- P-line name
  !this.pKey         = !associationMember.pKey
  -- Distance along P-line
  !this.pkDistance   = !associationMember.pkDistance
  -- Saved Position
  -- test for unset saved position (side effect of dynamic attributes)
  if(!associationMember.savPosition.unset()) then
    !this.savPosition   = object POSITION('E0 WRT WORLD')
  else
    !this.savPosition   = !associationMember.savPosition
  endif
  -- Saved Direction
  -- test for unset saved direct, allowing for PML assignment bug (side effect of dynamic attributes)
  if(!associationMember.savDirection.east.unset()) then
    !this.savDirection  = object DIRECTION('UP WRT WORLD')
  else
    !this.savDirection  = !associationMember.savDirection
  endif
  -- look for expressions (for special cases)
  !posExpressionAttr = !associationMember.posXpr
  if( !posExpressionAttr.empty() ) then
    !this.posExpression = ''
  else
    !this.posExpression = !posExpressionAttr
  endif
  !dirExpressionAttr    = !associationMember.dirXpr
  if( !dirExpressionAttr.empty() ) then
    !this.dirExpression = ''
  else
    !this.dirExpression = !dirExpressionAttr
  endif
  !realExpressionAttr    = !associationMember.realXpr
  if( !realExpressionAttr.empty() ) then
    !this.realExpression = ''
  else
    !this.realExpression = !realExpressionAttr
  endif
  -- Derived position
  !this.posEv        = !associationMember.posEv
  handle any
    !this.posEv      = object POSITION()
  endhandle
  -- Derived direction
  !this.dirEv        = !associationMember.dirEv
  handle any
    !this.dirEv      = object DIRECTION()
  endhandle
  -- initialise purpose
  !this.purpose      = ''
  -- set actual type if set
  !this.actType = !this.getEncodedData(!associationMember.description, 'ACTTYPE')

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      pointVector
--
-- Description: return point vector derived from posev and direv
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POINTVECTOR point vector derived from posev and direv
--
------------------------------------------------------------------------
define method .pointVector() is POINTVECTOR

  -- Initialise variables
  if( !this.posEv.unset() or !this.dirEv.unset() ) then
    return object POINTVECTOR()
  endif

  -- get distance from point to plane
  !pv = object POINTVECTOR(!this.posEv, !this.dirEv)

  return !pv

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: return plane derived from posev and direv
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane derived from posev and direv
--
------------------------------------------------------------------------
define method .plane() is PLANE

  -- Initialise variables
  if( !this.posEv.unset() or !this.dirEv.unset() ) then
    return object PLANE()
  endif

  -- get distance from point to plane
  !pv    = object POINTVECTOR(!this.posEv, !this.dirEv)
  !plane = !pv.plane()

  return !plane

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save settings in this object to an existing ASSMBR element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      DBREF of the ASSMBR element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save(!associationMember is DBREF)

  if( badref(!associationMember)) then
    -- leave object unset if bad reference
    return
  endif

  !saveCE = !!ce
  -- ce changed because PML 1 syntax must be used to set some attributes
  !!ce = !associationMember

  -- Element reference
  if( badref( !this.amemrf ) ) then
    -- unset member reference
    AMEMRF UNSET
  else
    -- set member
    !associationMember.amemrf = !this.amemrf
    handle any
      !!alert.error(!!error.text)
      return
    endhandle
  endif

  -- Association member element
  !this.assMbr       = !associationMember

  -- Target reference
  if( badref( !this.tarf ) ) then
    -- unset member reference (old and new TARF)
    TARF   UNSET
    ASSTAR UNSET
  else
    -- set member
    !associationMember.asstar = !this.tarf
    handle any
      !!alert.error(!!error.text)
      return
    endhandle
    -- unset deprecated TARF
    TARF   UNSET
  endif

  -- P-point number
  if( !this.ppNumb.unset() ) then
    !associationMember.ppNumb = -1
  else
    !associationMember.ppNumb = !this.ppNumb
  endif

  -- DP-point number
  if( !this.numb.unset() ) then
    !associationMember.numb = -1
  else
    !associationMember.numb = !this.numb
  endif

  -- P-line name
  if( !this.pKey.unset() ) then
    !associationMember.pKey = ''
  else
    !associationMember.pKey = !this.pKey
  endif

  -- Distance along P-line
  if( !this.pkDistance.unset() ) then
    !associationMember.pkDistance = 0
  else
    !associationMember.pkDistance = !this.pkDistance
  endif

  -- Expressions for special cases
  !this.setExpression(!associationMember, 'posXpr',  !this.posExpression.trim())
  !this.setExpression(!associationMember, 'dirXpr',  !this.dirExpression.trim())
  !this.setExpression(!associationMember, 'realXpr', !this.realExpression.trim())

  -- Saved Position
  -- note that unset test on east member only because of core bug
  if( !this.savPosition.east.unset() ) then
    -- unset position
    !associationMember.savPosition = object POSITION('E0 WRT WORLD')
  else
    !associationMember.savPosition = !this.savPosition
  endif

  -- Saved Direction
  -- note that unset test on east member only because of core bug
  -- PML 1 syntax used to avoid core direction assignment bug
  if( !this.savDirection.east.unset() ) then
    -- unset position
    SAVDIR UP WRT WORLD
  else
    SAVDIR $!this.savDirection
  endif

  if( !this.actType.set() ) then
  if( !this.actType.trim().empty().not() ) then
    !associationMember.description = '~ACTTYPE='+ !this.actType + '~'
  endif
  endif

  -- reset this object to get actual stored values
  !this.assMember(!!ce)

  !!ce = !saveCE

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setExpression
--
-- Description: Set expression
--              Data elements must be removed if changed to standard expression
--              Data elements must be added if changed to special expression
--              position expression is called POSX
--              direction expression is called DIRX
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association member element
--    2   R      STRING      Property name
--    3   R      STRING      expression
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExpression(!associationMember is DBREF, !property is STRING, !expression is STRING)

  !clearExpression         = !expression.trim().empty()
  !currentValue            = !associationMember.attribute(!property)
  -- nothing to do if attribute unset and null expression
  if( !currentValue.empty() and !clearExpression ) then
    return
  endif

  -- have to set or clear an expression
  !saveRef = !!ce
  !!ce     = !associationMember
  if( !clearExpression ) then
   $!<property> UNSET
  else
    $!<property> ( $!<expression> )
  endif

  !!ce = !saveRef

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .debug() is BOOLEAN

  -- output trace if enabled
  !debugOn = false
  !debugOn = !!assocDebug
  handle any
    !debugOn = false
  endhandle
  return !debugOn

endmethod
-- End of function definition

-----------------------------------------------------------------
--
-- Method:      feedback
--
-- Description: Draw rotation axes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPlane(!aidNumber is REAL)

  if( !this.posEv.unset() or !this.dirEv.unset() ) then
    return
  endif

  -- set point vector from posEv and dirEv
  !pv = object POINTVECTOR(!this.posEv, !this.dirEv)

  -- initialise feedback
  !plane = !pv.plane()
  !gphPlane               = object GPHPLANE(!plane)
  !gphPlane.tag           = true
  !gphPlane.detail        = false
  !gphPlane.x             = 150mm
  !gphPlane.y             = 150mm
--  !gphPlane.description = !this.plane.description
  !gphPlane.filled(true)
  if( !this.purpose.empty() ) then
    !gphPlane.description = 'MYFA'
  else
    !gphPlane.description = !this.purpose
  endif

  -- Aid Number
  !gphPlane.draw(!aidNumber, false)

  !gphPV                 = object GPHPOINTVECTOR(!pv)
  !gphPV.tag             = false
  !gphPV.detail          = false
  !gphPlane.description  = ' '

  -- Aid Number
  !gphPV.draw(!aidNumber, false)

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .assMemberSet
--
-- Description: returns true if amemrf is set
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .assMemberSet() is BOOLEAN

  !set = ( not badref( !this.amemrf ) )
  return !set

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .getEncodedData
--
-- Description: Finds data !dataCode encoded into !sourceString
--              Data format is dataCode=value, separated by the character ~
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getEncodedData(!sourceString is STRING, !dataCode is STRING) is STRING

  if( !sourceString.trim().empty() ) then
    return ''
  endif

  -- separate out any coded data
  !splitStrings = !sourceString.split('~')
  !result       = ''
  !searchString = !dataCode.trim() + '='

  -- loop through split strings to find coded data
  do !splitString values !splitStrings

    -- skip if data code not found at the start of this sub-string
    skip if( !splitString.match(!searchString) neq 1 )

    !result = !splitString.after(!searchString)
    break

  enddo

  return !result

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .stdElement
--
-- Description: Create standard element member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .stdElement(!element is DBREF)

  !this.amemrf      = !element
  !this.purpose     = 'ZDIR'
  !this.posEv       = !element.pos.wrt( /* )
  !this.dirEv       = !element.orientation.zDir()
  !this.actType     = !element.actType
  !this.savPosition = !this.posEv

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .stdDesignPoint
--
-- Description: Create standard Design Point member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .stdDesignPoint(!element is DBREF, !designPointRef is DBREF)

  !this.amemrf      = !element
  !this.desPoiRef   = !designPointRef
  !number           = !designPointRef.number
  !this.numb        = !number
  !this.purpose     = !designPointRef.purpose
  !this.posEv       = !element.dpps[!number]
  !this.dirEv       = !element.dpdir[!number]
  !this.actType     = !element.actType
  !this.savPosition = !this.posEv

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .stdPPoint
--
-- Description: Create standard P-Point member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .stdPPoint(!element is DBREF, !pPoint is REAL)

  !this.amemrf      = !element
  !this.ppNumb      = !pPoint
  !this.purpose     = !element.ppurp[!pPoint]
  !this.posEv       = !element.ppos[!pPoint]
  !this.dirEv       = !element.pdir[!pPoint]
  !this.actType     = !element.actType
  !this.savPosition = !this.posEv

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .getMemberReference
--
-- Description: Get the AMEMRF of this member.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getMemberReference() is DBREF

  return !this.amemrf

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .getMemberReference
--
-- Description: Get the AMEMRF of this member.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getMemberReference() is DBREF

  return !this.amemrf

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .getTargetReference
--
-- Description: Get the ASSTAR of this member.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getTargetReference() is DBREF

  return !this.tarf

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .getReference
--
-- Description: Get the ASSTAR of this member if set,otherwise get AMEMRF.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getReference() is DBREF

  if( !this.tarf.set() ) then
    return !this.tarf
  else
    return !this.amemrf
  endif

endmethod
-- End of method definition
