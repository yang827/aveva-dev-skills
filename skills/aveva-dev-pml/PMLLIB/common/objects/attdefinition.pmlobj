-- Created:         Fri Oct 17 16:45:26 WAT 1997
--
--
-- Description:
-- Attribute Library definition
-- WARNING: THIS OBJECT HAS BEEN EXTENDED FOR PDMS 12. IT IS STILL USED
-- WITH attlibget.pmlfnc, AND THAT INTERFACE SHOULD BE MAINTAINED.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  attDefinition()                  -                   Constructor
--  attlibGet(STRING)                -                   Load details of given attribute
--  clear()                          -                   Load details of given attribute
--

define object ATTDEFINITION

  -- Description (compiled from rptx or qtxt or name)
  member .description    is STRING
  -- Description (compiled from DESTEX or description)
  member .fullDescription is STRING
  -- Name
  member .name           is STRING
  -- Member Name
  member .member         is STRING
  -- Report Text
  member .rptx           is STRING
  -- Definition Type
  member .definition     is STRING
  -- Data Type
  member .type           is STRING
  -- Database Type
  member .dbType         is STRING
  -- Size
  member .size           is REAL
  -- Units
  member .units          is STRING
  -- Visible Flag
  member .visible        is BOOLEAN
  -- Settable Flag
  member .settable       is BOOLEAN
  -- Query text
  member .qtxt           is STRING
  -- Type Code
  member .typeCode       is REAL
  -- DB Type Code
  member .dbTypeCode     is REAL
  -- DB Type Code
  member .defiCode       is REAL
  -- ITYP Code
  member .iType          is REAL
  -- Attribute is valid
  member .isValidAttribute is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      attDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .attDefinition()

  -- Initialise Variables
  !this.clear()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      attlibGet
--
-- Description: Load details of given attribute
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .attlibGet(!attribute is STRING)

  -- Initialise Variables
  !this.clear()

  -- Member
  !this.member = !attribute

  !objAttribute = object ATTRIBUTE(!attribute)
  !isUDA        = !objAttribute.isUDA()

  -- Get ATTDEF data    ( OLD SYNTAX )
  var !data ATTDEF $!<attribute> NAME TYPE RPTX SIZE DEFI DTYP UNIT VISI QSET QTXT ITYP DESTEX
  handle any
    return
  endhandle
  -- Attribute is valid
  !this.isValidAttribute = true
  -- Name
  !this.name       = !data[1]
  -- Type
  !this.typeCode   = !data[2].real()
  handle any
    !this.typeCode = 0
  endhandle
  if(!this.typeCode.unset() ) then
    !this.typeCode = 0
  endif
  !this.type       = !!attlibConstant('TYPE', !this.typeCode)
  if( !isUDA and !this.type.upcase() eq 'TEXT' ) then
    -- test for word UDA
    !upAttribute   = !attribute.upCase().subString(2)
    VAR !strRefUDA COLLECT ALL UDA WITH ( UPCASE(UDNAME) eq |$!upAttribute| )
    if( !strRefUDA.empty().not() ) then
      !this.type   = !strRefUDA[1].dbRef().uType
    endif
  endif
  -- Report Text
  !this.rptx       = !data[3]
  -- Size
  !this.size       = !data[4].real()
  handle any
    !this.size = 0
  endhandle
  -- Definition
  !this.defiCode   = !data[5].real()
  handle any
    !this.defiCode = 0
  endhandle
  if(!this.defiCode.unset() ) then
    -- got for pseudo as a default
    !this.defiCode = 4
  endif
  !this.definition = !!attlibConstant('DEFI', !this.defiCode)
  -- DBType
  !this.dbTypeCode   = !data[6].real()
  handle any
    !this.dbTypeCode = 0
  endhandle
  if(!this.dbTypeCode.unset() ) then
    !this.dbTypeCode = 0
  endif
  !this.dbType     = !!attlibConstant('TYPE', !this.dbTypeCode)
  -- Units
  if(!data[7] eq 'DIST') then
    !this.units    = 'Distance'
  elseif (!data[7] eq 'BORE') then
    !this.units    = 'Bore'
  elseif (!data[7] eq 'NONE') then
    !this.units    = 'None'
  elseif (!data[7].empty()) then
    !this.units    = 'N/A'
  else
    !this.units    = !data[7]
  endif
  -- Visible
  !this.visible    = !data[8].boolean()
  handle any
    !this.visible  = false
  endhandle
  -- Query
  !this.settable   = !data[9].boolean()
  handle any
    !this.settable = false
  endhandle
  -- Query Text
  !this.qtxt       = !data[10]
  -- Description
  if( !this.rptx.trim().empty() ) then
    if( !this.qtxt.trim().empty() ) then
      !this.description = !this.name.trim()
    else
      !this.description = !this.qtxt.trim()
    endif
  else
    !this.description = !this.rptx.trim()
  endif
  -- ITYP code
  !this.iType      = !data[11].real()
  -- If the description is still unset - use the attribute name
  if( !this.description.empty() ) then
    !this.description = !attribute
  endif
  !this.description = !this.description.subString(1,1).upcase() + !this.description.subString(2).lowcase()
  -- Full Description
  !this.fullDescription = !data[12]
  if( !this.fullDescription.trim().empty() ) then
    !this.fullDescription = !this.description
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Load details of given attribute
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()
  -- Name
  !this.name         = ''
  -- Member Name
  !this.member       = ''
  -- Report Text
  !this.rptx         = ''
  -- Definition Type
  !this.definition   = ''
  -- Data Type
  !this.type         = ''
  -- Database Type
  !this.dbType       = ''
  -- Size
  !this.size         = 0
  -- Units
  !this.units        = ''
  -- Visible Flag
  !this.visible      = false
  -- Settable Flag
  !this.settable     = false
  -- Query text
  !this.qtxt         = ''
  -- Code
  !this.typeCode     = 0
  -- DB Type Code
  !this.dbTypeCode   = 0
  -- Definition Code
  !this.defiCode     = 0
  -- ITYP Code
  !this.iType        = 0
  -- Attribute is valid
  !this.isValidAttribute = false
  -- descriptions
  !this.description     = ''
  !this.fullDescription = ''

endmethod
-- End of function definition
