-- Define object
define object BOX

  -- Xlength
  member .x   is REAL
  -- Ylength
  member .y   is REAL
  -- Zlength
  member .z   is REAL
  -- Position
  member .pos is POSITION
  -- Orientation
  member .ori is ORIENTATION
  -- Wrt
  member .wrt is DBREF

endobject
-- End of object definition for BOX
