-- File:            chkclass.pmlobj
--   Type:          Object Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
-- Major class of check
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  chkClass(STRING)                 -                   Constructor
--  definition()                     -                   Returns a string array of the object that can be written to file
--  listGroups(GADGET)               -                   List groups into passed gadget
--
------------------------------------------------------------------------

define object CHKCLASS

  -- Class Name (quick access)
  member .name         is STRING

  -- Class Description
  member .description   is STRING

  -- Available groups for the class (Array of chkGroup's)
  member .groups        is ARRAY

endobject
-- End of object definition for CHKCLASS

------------------------------------------------------------------------
--
-- Method:      chkClass
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chkClass(!name is STRING)

  !this.name        = !name.upcase()
  !this.description = !name

endmethod
-- End of method definition for .chkClass(STRING)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description:
--   Returns a string array of the object that can be written to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Definition
--
------------------------------------------------------------------------

define method .definition()

  -- Initialise Variables
  !return     = ARRAY()
  !return.append('!defClass                  = object CHKCLASS()')
  !return.append('!defClass.name             = ''' & !this.name & '''')
  !return.append('!defClass.description      = ''' & !this.description & '''')

  -- Write object to store
  !return.append('!!chkStore.add(!defClass')


endmethod
-- End of method definition for .definition()
------------------------------------------------------------------------
--
-- Method:      listGroups
--
-- Description:
--  List groups into passed gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     GADGET      Gadget to be populated
-- Return:
--   [Data Type] [Description]
--

--
------------------------------------------------------------------------
define method .listGroups(!gadget is GADGET)

  -- Loop through the classes then set the passed gadget with groups
  do !i indices !this.groups
    !group[!i] = !this.groups[!i].description
    !rText[!i] = !i.string()
  enddo

  !gadget.dText = !group
  !gadget.rText = !rText

endmethod
-- End of method definition for .listGroups(GADGET)
