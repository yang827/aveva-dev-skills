--
-- File:            chkdefinition.pmlobj
--   Type:          Object Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
-- Check definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  chkDefinition(STRING)            -                   Constructor
--  definition(STRING,STRING)        ARRAY               Returns a string array of the object that can written to file
--
------------------------------------------------------------------------

define object CHKDEFINITION

  -- Check Name (quick access)
  member .name         is STRING

  -- Check Description (as displayed)
  member .description  is STRING

  -- Function for checking
  member .function     is STRING

  -- Expression for checking (mutually exclusive with .function)
  member .expression   is STRING

  -- Action on passing
  member .passed       is STRING

  -- Action on failed
  member .failed       is STRING

  -- Where rule was loaded from (AVEVA, appware, project, user)
  member .type         is STRING

endobject
-- End of object definition for CHKDEFINITION

------------------------------------------------------------------------
--
-- Method:      chkDefinition
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chkDefinition(!name is STRING)

  !this.name        = !name.upcase()

endmethod
-- End of method definition for .chkDefinition(STRING)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description:
--   Returns a string array of the object that can written to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Class name
--    2   R      STRING      Group name
-- Return:
--   [Data Type] [Description]
--    ARRAY       Definition
--
------------------------------------------------------------------------

define method .definition(!dummyClass is STRING, !dummyGroup is STRING) is ARRAY

  return object ARRAY()

endmethod
-- End of method definition for .definition(STRING, STRING) ARRAY
