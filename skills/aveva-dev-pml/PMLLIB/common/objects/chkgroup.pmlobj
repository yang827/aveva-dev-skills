-- File:            chkgroup.pmlobj
--   Type:          Object Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
-- Group of "like" check.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  chkGroup(STRING)                 -                   Constructor
--  definition(STRING)               ARRAY               Returns a string array of the object that can be written to file
--  listChecks(GADGET)               -                   List checks into passed gadget
--
------------------------------------------------------------------------

define object CHKGROUP

  -- Group Name (quick access)
  member .name         is STRING

  -- Group Description
  member .description  is STRING

  -- Check available for the group (Array of chkDefinition's)
  member .checks       is ARRAY

  -- Types of element the check can be performed on
  member .types        is ARRAY

  -- Rule to be performed
  member .rule         is STRING

endobject
-- End of object definition for CHKGROUP

------------------------------------------------------------------------
--
-- Method:      chkGroup
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chkGroup(!name is STRING)

  !this.name        = !name.upcase()
  !this.description = !name

endmethod
-- End of method definition for .chkGroup(STRING)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description:
--   Returns a string array of the object that can be written to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Class name
-- Return:
--   [Data Type] [Description]
--    ARRAY       Definition
--
------------------------------------------------------------------------

define method .definition(!dummyClass is STRING) is ARRAY

  -- Initialise Variables
  !return     = ARRAY()
  !return.append('!defGroup                  = object CHKCLASS()')
  !return.append('!defGroup.name             = ''' & !this.name & '''')
  !return.append('!defGroup.description      = ''' & !this.description & '''')
  !return.append('!defGroup.rule             = ''' & !this.rule &  '''')

  -- Load Types
  do !i indices !this.types
    !return.append('!defGroup.types.append(''' & !this.types[!i] & ''')')
  enddo

  -- Write object to store
  !return.append('!!chkStore.add(!defGroup')


endmethod
-- End of method definition for .definition(STRING) ARRAY
------------------------------------------------------------------------
--
-- Method:      listChecks
--
-- Description:
--  List checks into passed gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     GADGET      Gadget to be populated
-- Return:
--   [Data Type] [Description]
--

--
------------------------------------------------------------------------
define method .listChecks(!gadget is GADGET)

  -- Loop through the classes then set the passes gadget with checks
  do !i indices !this.checks
    !check[!i] = !this.checks[!i].description
    !rText[!i] = !i.string()
  enddo

  !gadget.dText = !check
  !gadget.rText = !rText

endmethod
-- End of method definition for .listChecks(GADGET)
