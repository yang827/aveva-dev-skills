--
--
-- Description:
-- Main Check object for containing all the available check.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edit()                           -                   Display the edit form for the check store object
--  globalInstance()                 -                   Create a global instance of the object
--  listClasses(GADGET)              -                   List classes into passed gadget
--  load()                           -                   Load check definitions into the store
--  save()                           -                   Save the stores contents to file
--  upgrade()                        -                   Method to upgrade old Checker form object array !!checker.checks
--  view()                           -                   Display the viewing form for the check store object
--
------------------------------------------------------------------------

define object CHKSTORE

  -- Available Classes of Check
  member .classes    is ARRAY

endobject
-- End of object definition for CHKSTORE

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- create the global variable
  !!chkStore = !this
  !!chkStore.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:     save
--
-- Description:
--   Save the stores contents to file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  -- Initialise Variables
  !unusedSave = true

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:     load
--
-- Description:
--   Load check definitions into the store
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- Currently using loading through the old checker form
  !unusedLoad = true

endfunction
-- End of function definition for .load()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--  Display the edit form for the check store object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .edit()

  -- Display the stores edit form
  show !!chkStoreEdit

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      view
--
-- Description:
--   Display the viewing form for the check store object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .view()

  -- Display the stores viewing form
  show !!chkStoreView

endmethod
-- End of method definition for .view()
------------------------------------------------------------------------
--
-- Method:      upgrade
--
-- Description:
--   Method to upgrade old Checker form object array !!checker.checks
--   to be stored on this object. chkstore.obj
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .upgrade()

  -- !!checker.checks contained the following string members
  -- Name, Failed, Title, FileType, Passed, Rule, Function, Group, Class, Module, Types.

  -- Upgrade Name
  do !i indices !!checker.checks
    -- Get each different class and create a new array for each
    !exists = false
    do !j indices !this.classes
      if (!!checker.checks[!i].class.upcase() eq !this.classes[!j].name.upcase()) then
        !classIndex = !j
        !exists = true
        break
      endif
    enddo
    -- no class exists of type
    if (!exists.not()) then
      !this.classes.append(object CHKCLASS(!!checker.checks[!i].class))
      !classIndex = !this.classes.size()
    endif

    -- Get each different group and create a new array for each within the relevant class
    !exists = false
    do !j indices !this.classes[!classIndex].groups
      if (!!checker.checks[!i].group.upcase() eq !this.classes[!classIndex].groups[!j].name.upcase()) then
        !groupIndex = !j
        !exists = true
        break
      endif
    enddo
    -- no group exists of type
    if (!exists.not()) then
      !this.classes[!classIndex].groups.append(object CHKGROUP(!!checker.checks[!i].group))
      !groupIndex = !this.classes[!classIndex].groups.size()
    endif

    -- Having got the 2 array value simply add to the .checks array of the chkGroup object
    !this.classes[!classIndex].groups[!groupIndex].checks.append(object CHKDEFINITION(!!checker.checks[!i].name))

    -- Record the array element number created
    !currentArrayItem = !this.classes[!classIndex].groups[!groupIndex].checks.size()
    -- Map the old !!checker.check members to the new !!chkStore members
    !this.classes[!classIndex].groups[!groupIndex].checks[!currentArrayItem].description   = !!checker.checks[!i].title
    !this.classes[!classIndex].groups[!groupIndex].checks[!currentArrayItem].type          = !!checker.checks[!i].fileType
    !this.classes[!classIndex].groups[!groupIndex].checks[!currentArrayItem].function      = !!checker.checks[!i].function
    !this.classes[!classIndex].groups[!groupIndex].rule                                    = !!checker.checks[!i].rule
    -- Split the !!checker.types string to load into the !chkGroups.types array
    !this.classes[!classIndex].groups[!groupIndex].types    = !!checker.checks[!i].types.split()
  enddo

endmethod
-- End of method definition for .upgrade()
------------------------------------------------------------------------
--
-- Method:      listClasses
--
-- Description:
--  List classes into passed gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     GADGET      Gadget to be populated
-- Return:
--   [Data Type] [Description]
--

--
------------------------------------------------------------------------
define method .listClasses(!gadget is GADGET)

  if (!this.classes.size() gt 0) then
    -- Loop through the classes then set the passed gadget with classes
    do !i indices !this.classes
      !class[!i] = !this.classes[!i].description
      !rText[!i] = !i.string()
    enddo

    !gadget.dText = !class
    !gadget.rText = !rText

  endif

endmethod
-- End of method definition for .listClasses(GADGET)
