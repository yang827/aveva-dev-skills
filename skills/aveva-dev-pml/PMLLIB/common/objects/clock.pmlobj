-- Description:
-- Contains current clock information
--
------------------------------------------------------------------------

-- Define object
define object CLOCK

  -- Day of Month
  member .dom   is REAL
  -- Day of Week
  member .dow   is STRING
  -- Month
  member .month is STRING
  -- Year
  member .year  is REAL
  -- Date dd mmm yy
  member .date  is STRING
  -- Time
  member .time  is STRING

endobject
-- End of object definition for CLOCK
