--
-- Description:
-- Collection object for containing collection data.
--
------------------------------------------------------------------------

-- Define object
define object COLLECT

  -- Selection Class ALL, MEMBERS, ITEMS
  member .classes      is STRING
  -- Element list
  member .types        is STRING
  -- Expression
  member .expression   is STRING
  -- Exclusive
  member .exclusive    is BOOLEAN
  -- Volume Item
  member .volumeGid    is DBREF
  -- Volume From/To
  member .volume       is VOLUME
  -- Search Gid
  member .search       is DBREF
  -- DB Type (only applicable when searching worlds)
  member .dbType       is STRING

endobject
-- End of object definition for COLLECT
