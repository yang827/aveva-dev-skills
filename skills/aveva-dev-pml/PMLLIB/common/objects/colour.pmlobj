--
-- File:            colour.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     COLOUR
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Feb 3 17:54:56 GMT 1997
--
--
-- Description:
-- Colour object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  colour(REAL)                     -                   Constructor
--  colour(STRING)                   -                   Constructor
--  initialise()                     -                   initialise the object members
--  key()                            ANY                 return the key for the colour
--  setColour(STRING,STRING)         -
--  string()                         STRING              convert colour to string
--
------------------------------------------------------------------------

-- Define object
define object COLOUR

  -- Colour Name
  member .name is STRING

  -- Colour number code
  member .code is REAL

  -- Colour type (SPECIFIC, MIX, <other value>)
  -- where:  SPECIFIC = a specific named colour (e.g. yellow, red, green...)
  --         MIX      = a colour mix (e.g. red 30, green 20, blue 50)
  --         Pre defined colour type (e.g. visible, ce, active...)
  member .type is STRING

  -- values for a colour mix
  member .red   is REAL
  member .green is REAL
  member .blue  is REAL

endobject
-- End of object definition for COLOUR

------------------------------------------------------------------------
--
-- Method:      !colour(STRING)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [colour to assign to object]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .colour(!value is STRING)

  --*** P-34652 (rcfl 21/Feb/2011) avoid !value.real() with failure
  --*** where simple colour name is not a number. This causes problem
  --*** in PML parser.
  -- check if it is just a number in the string
  if (!value.isDigits()) then
    !this.colour(!value.Digits())
  endif

  !this.initialise()

  -- check if the colour name is actually a mix
  if (!value.subString(1,3).eqNoCase('MIX')) then
    !this.red   = !value.part(3).real()
    !this.green = !value.part(5).real()
    !this.blue  = !value.part(7).real()
    !this.type  = 'MIX'
  else

    -- check that colour is valid
    var !check COLOUR $!<value>
    handle any
      !!messageFile.error(146, 30, !value)
    elsehandle none
      -- the colour is valid
      -- is the colour name a specific colour or a colour type
      if (!check.upcase() eq !value.upcase()) then
        -- colour is specific colour name
        !this.name = !value
        !this.type  = 'SPECIFIC'
      else
        -- colour is type name (e.g. visible/ce ...etc)
        !this.type = !value
        !this.name = !check
      endif
    endhandle

    -- find colour number
    if (!this.name.isDigits()) then
      !this.code = !this.name.Digits()
    else
      var !colNum COLOUR NUMBER $!<this.name>
      !this.code = !colNum.real()
    endif

  endif

endmethod
-- End of method definition for .colour(STRING)

------------------------------------------------------------------------
--
-- Method:      !colour(REAL)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [colour to assign to object]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .colour(!value is REAL)

  !this.initialise()

  -- get the colour name
  var !colName COLOUR $!<value>
  handle any
    !!messageFile.error(146, 30, !value)
  endhandle

  -- check if the colour is defined as a mix
  if (!colName.subString(1,3).upcase() eq 'MIX') then
    !this.red   = !colName.part(3).real()
    !this.green = !colName.part(5).real()
    !this.blue  = !colName.part(7).real()
    !this.type  = 'MIX'
  else
    -- specific named colour
    !this.name = !colName
    !this.type  = 'SPECIFIC'
  endif

  -- set the colour number
  !this.code = !value

endmethod
-- End of method definition for .colour(REAL)

------------------------------------------------------------------------
--
-- Method:      !colour(STRING, STRING)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [colour to assign to object]
--   [2] [R] [STRING] [area of colour table to use USERLIST, DICTIONARY, TABLE]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .setColour(!value is STRING, !table is STRING)

  !this.initialise()

  -- check if the colour name is actually a mix
  if (!value.subString(1,3).upcase() eq 'MIX') then
    !this.red   = !value.part(3).real()
    !this.green = !value.part(5).real()
    !this.blue  = !value.part(7).real()
    !this.type  = 'MIX'
  else

    -- check that colour is valid
    var !check COLOUR $!<value>
    handle any
      !!messageFile.error(146, 30, !value)
    elsehandle none
      -- the colour is valid
      -- is the colour name a specific colour or a colour type
      if (!check.upcase() eq !value.upcase()) then
        -- colour is specific colour name
        !this.name = !value
        !this.type  = 'SPECIFIC'
      else
        -- colour is type name (e.g. visible/ce ...etc)
        !this.type = !value
        !this.name = !check
      endif
    endhandle

    -- find colour number
    var !colNum COLOUR NUMBER $!<this.name> $!<table>
    !this.code = !colNum.real()

  endif

endmethod
-- End of method definition for .setColour(STRING, STRING)


------------------------------------------------------------------------
--
-- Method:      !initialise()
--
-- Description: initialise the object members
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .initialise()

  -- the COLOUR object requires the colour table to be correctly loaded
  -- this involves checking for user defined colours.
  -- check here for the colour table and load it if necessary.
  if (undefined(!!appColours)) then
    !!appColours    = !!loadColours(object FILE('%PDMSDFLTS%/PDMS-COLOURS'))
  endif

  -- initialise the object members
  !this.name = STRING()
  !this.code = REAL()
  !this.red = REAL()
  !this.green = REAL()
  !this.blue = REAL()
  !this.type = STRING()

endmethod
-- End of method definition for .initialise()



------------------------------------------------------------------------
--
-- Method:      !key()
--
-- Description: return the key for the colour
--
-- Method Type: Function
-- Return:
--   [ANY] [STRING or REAL depending on whether the  ]
--         [        key is the number or description ]
--
------------------------------------------------------------------------
define method .key() is ANY

  -- Return a string/real that specifies the colour.
  -- Values are returned in priority as follows
  -- 1. colour name
  -- 2. colour type
  -- 3. colour number
  -- 4. colour mix
  if (!this.type eq 'SPECIFIC') then
    !result = !this.name
  elseif (!this.type eq 'MIX' and !this.code.unset()) then
    !result = 'Red ' & !this.red & ' Green ' & !this.green & ' Blue ' & !this.blue
  elseif (!this.type eq 'MIX') then
    !result = !this.code
  else
    !result = !this.type
  endif

  return !result

endmethod
-- End of method definition for .key() ANY

------------------------------------------------------------------------
--
-- Method:      !string()
--
-- Description: convert colour to string
--
-- Method Type: Function
--
-- Return:
--   [STRING] [Colour as STRING]
------------------------------------------------------------------------
define method .string() is STRING

  if (!this.type eq 'MIX') then
    !result = 'Red ' & !this.red & ' Green ' & !this.green & ' Blue ' & !this.blue
  else
    !result = !this.name
  endif

  return !result

endmethod
-- End of method definition for .string() STRING
