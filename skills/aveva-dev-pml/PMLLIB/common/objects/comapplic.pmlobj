--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        common
--   Replaces:
--
-- Author:          Gail Wynne-Jones
-- Created:         8 November 1999
--
--
-- Description:
--   holds status information about an application (as read from
--   file called  DFLTS/COMAPPLICATIONS)
--   Set up by CLIB/FILES/ESTDAPPS and added into COMAPPLICLIST object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comapplic (ARRAY)                -
--
define object COMAPPLIC

member .filename    is STRING
member .directory   is STRING
member .admin       is BOOLEAN
member .title       is STRING
member .menu        is STRING
member .form        is STRING
member .callback    is STRING
member .group       is STRING
member .groupName   is STRING
member .synonym     is STRING
member .gadgets     is STRING
member .libType     is STRING
member .appType     is STRING
member .liteBar     is STRING

endobject
-- End of object definition for COMAPPLIC

----------------------------------------------------------------------------
define method .comapplic (!a is ARRAY )
--constructor method
----------------------------------------------------------------------------

   if (!a[1] eq 'ADMIN') then
      !this.admin = true
   else
      !this.admin = false
   endif
   !this.directory = !a[2]
   !this.title     = !a[3]
   !this.menu      = !a[4]
   !this.form      = !a[5]
   !this.callback  = !a[6]
   !this.group     = !a[7]
   !this.groupName = !a[8]
   !this.synonym   = !a[9]

   !this.gadgets   = !a[10]
   if (!this.admin) then
      !this.libType = !a[11]
   else
      !this.appType = !a[11]
   endif

endmethod
-- End of method definition for .comapplic (ARRAY )
