--   Module:        common
--   Replaces:
--
-- Author:          Gail Wynne-Jones
-- Created:         8 November 1999
--
--
-- Description:
--   holds status information about all current applications
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addApplic (ARRAY)                -
--  addApplic (COMAPPLIC)            -
--  comApplicList()                  -
--  findApplic(STRING)               BOOLEAN             check if given app name is in the COMAPPLICLIST object
--  getApplic(STRING)                COMAPPLIC           get COMAPPLIC object with given name from array
--  getApplic(STRING,COMAPPLIC)      BOOLEAN             true if COMAPPLIC object is in list, if so return it in arg2
--  isAdmin(STRING)                  BOOLEAN             true if COMAPPLIC object with given name has ADMIN status
--
------------------------------------------------------------------------
define object COMAPPLICLIST

-- holds an array of COMAPPLIC objects
member .apps     is ARRAY

endobject
-- End of object definition for COMAPPLICLIST

----------------------------------------------------------------------------
define method .comApplicList()
----------------------------------------------------------------------------
   !this.apps.clear()

endmethod
-- End of method definition for .comApplicList()

----------------------------------------------------------------------------
define method .addApplic ( !newApp is COMAPPLIC)
----------------------------------------------------------------------------
-- add a new COMAPPLIC object as long as it is not already in list
  if (not !this.findApplic(!newApp.form) ) then
      !this.apps.append (!newApp)
  endif

endmethod
-- End of method definition for .addApplic ( COMAPPLIC)

----------------------------------------------------------------------------
define method .addApplic ( !newAppInfo is ARRAY)
----------------------------------------------------------------------------
-- check that an COMAPPLIC object with same name is not already in list
-- and if not create a new one and add it
  if (not !this.findApplic(!newAppInfo[5]) ) then
-- the INFO array is the one created from global variable
--   !!CDCOMAPPLIC_APPS
      !newApp = object COMAPPLIC(!newAppInfo)
      !this.apps.append (!newApp)
  endif

endmethod
-- End of method definition for .addApplic ( ARRAY)

---------------------------------------------------------------------------
define method .findApplic( !appName is STRING) is BOOLEAN
---------------------------------------------------------------------------
-- check if given application is in list
  do !x values !this.apps
     if (!x.form eq !appName) then
         return true
     endif
  enddo

  return false
endmethod
-- End of method definition for .findApplic( STRING) BOOLEAN

---------------------------------------------------------------------------
define method .getApplic( !appName is STRING) is COMAPPLIC
---------------------------------------------------------------------------
-- get the COMAPPLIC object with given name. findApplic should be called first
  do !x values !this.apps
     if (!x.form eq !appName) then
         return !x
     endif
  enddo

endmethod
-- End of method definition for .getApplic( STRING) COMAPPLIC

---------------------------------------------------------------------------
define method .getApplic( !appName is STRING, !app is COMAPPLIC ) is BOOLEAN
---------------------------------------------------------------------------
-- if the COMAPPLIC object with given name exists,it is returned in !app
-- otherwise the method returns false

  do !x values !this.apps
     if (!x.form eq !appName) then
         !app = !x
         return true
     endif
  enddo
   return false
endmethod
-- End of method definition for .getApplic( STRING, COMAPPLIC ) BOOLEAN

---------------------------------------------------------------------------
define method .isAdmin( !appName is STRING ) is BOOLEAN
---------------------------------------------------------------------------
-- if the COMAPPLIC object with given name exists, return its admin status
  do !x values !this.apps
     if (!x.form eq !appName) then
         return !x.admin
     endif
  enddo
   return false
endmethod
-- End of method definition for .isAdmin( STRING ) BOOLEAN
