--
--  Description:     Get PML PROFILE objects from the catalogue----
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comCataProfiles()                -                   Constructor method
--  comCataProfiles(DBREF)           -                   Constructor method
--  combineProfiles(ARRAY)           ARRAY               Union each profile with the next and take the largest
--  convexProfile()                  PROFILE             get convex hull of raw profiles
--  findRawProfiles(DBREF)           BOOLEAN             get raw profiles for this element
--  findUnionedProfiles()            -                   Union all profiles together to find a single boundary
--  getRawProfiles()                 ARRAY               get raw profiles for this element
--  setElement(DBREF)                BOOLEAN             set element to given element
--
-- Description:     Get PML PROFILE objects from the catalogue
--
--
------------------------------------------------------------------------
--
define object COMCATAPROFILES

  -- Element corresponding to profiles
  member .element          is DBREF
  -- Array of raw profiles from the catalogue
  member .rawProfiles      is ARRAY
  -- Array of unioned profiles
  member .unionedProfiles  is ARRAY
  -- Drawing level for these profiles
  member .drawingLevel     is REAL

endobject
-- End of object definition for appAPModel

------------------------------------------------------------------------
--
-- Method:      .comCataProfiles()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comCataProfiles()

  -- Default level is mass properties level

  var !repr repre mass
  !this.drawingLevel = !repr.real()
  handle any
    !this.drawingLevel = 6
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .comCataProfiles()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference of element represented by profiles
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comCataProfiles(!element is DBREF)

  -- Default level is mass properties level
  !this.comCataProfiles()
  !this.setElement(!element)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .setElement()
--
-- Description: set element to given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference of element represented by profiles
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if raw profiles extracted
--
------------------------------------------------------------------------
define method .setElement(!element is DBREF) is BOOLEAN

  if( badref(!element) ) then
    return false
  else
    !this.element = !element
  endif

  -- initialise arrays for this element
  !this.rawProfiles     = ARRAY()
  !this.unionedProfiles = ARRAY()

  return !this.findRawProfiles(!element)

endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .findRawProfiles()
--
-- Description: get raw profiles for this element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference of element represented by profiles
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if raw profiles extracted
--
------------------------------------------------------------------------
define method .findRawProfiles(!element is DBREF) is BOOLEAN

  !gmss = !element.gstRef
  handle any
    return false
  endhandle
  if( badref(!gmss)) then
    return false
  endif

  !returnProfiles   = ARRAY()

  -- get profile from each cross section shape
  do !shape values !gmss.members

    -- only process x-sections
    skip if( not !shape.type inset('SPRO','SREC','SANN') )
    -- only SPRO for now
--    skip if( !shape.type neq |SPRO| )
    skip if( !this.drawingLevel.between(!shape.level[1],!shape.level[2]).not() or !shape.tuFlag.not() )
    -- Get profile for SPRO
    !profile = object PROFILE(!shape,!element)
    handle any
      skip
    endhandle
    !returnProfiles.append(!profile)

  enddo

  !this.rawProfiles = !returnProfiles

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .getRawProfiles()
--
-- Description: get raw profiles for this element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       ARRAY of PML PROFILE objects from this element
--
------------------------------------------------------------------------
define method .getRawProfiles() is ARRAY

  return !this.rawProfiles = ARRAY()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .findUnionedProfiles()
--
-- Description: Union all profiles together to find a single boundary
--              NOTE that profiles must overlap so that a single outer
--              boundary can be found. If this is not the case, then only
--              the largest profile resulting from the combination will be found.
--              The algorithm starts by unioning every pair of profiles together
--              before attempting to reduce the number of profiles to one
--              in the combineProfiles method.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference of element represented by profiles
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if raw profiles extracted
--
------------------------------------------------------------------------
define method .findUnionedProfiles()

  if( !this.rawProfiles.size() leq 1 ) then
    !this.unionedProfiles = !this.rawProfiles
    return
  endif

  !localProfiles = ARRAY()
  !saveProfiles  = ARRAY()
  !remainingProfiles = !this.rawProfiles

  -- loop until all profiles have been unioned
  do

    !firstProfile = !remainingProfiles.removeFirst()
    -- Union each profile with the next and take the largest resulting profile from each union
    -- The results (one less PROFILE) are processed until there is only one profile left
    do !index indices !remainingProfiles

      !localProfiles = !firstProfile.union(!remainingProfiles[!index])
      if( !localProfiles.size() eq 1 ) then
        !saveProfiles.append(!localProfiles[1])
      else
        -- sort by area to get biggest
        !areas = ARRAY()
         do !loopIndex indices !localProfiles
          !areas[!loopIndex] = !localProfiles[!loopIndex].area()
        enddo
        -- save profile with greatest area
        !saveProfiles.append(!localProfiles[!areas.sortedIndices().last()])
      endif

    enddo

    break if( !remainingProfiles.size() eq 1 )
  enddo

  -- Loop through raw profiles until profile count cannot be reduced
  !this.unionedProfiles = !this.combineProfiles(!saveProfiles)

  !this.unionedProfiles[1] = !this.unionedProfiles[1].mergePoints().mergeLines()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .combineProfiles()
--
-- Description: Union each profile with the next and take the largest
--              resulting profile from each union
--              The results (one less PROFILE) are processed until there
--              is only one profile left.
--              NOTE that profiles must overlap so that a single outer
--              boundary can be found. If this is not the case, then only
--              the largest profile resulting from the combination will be found.
--              NOTE THIS METHOD IS CALLED RECURSIVELY
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of profiles
-- Return:
--   [Data Type] [Description]
--    ARRAY       New array of Profiles
--
------------------------------------------------------------------------
define method .combineProfiles(!profilesIn is ARRAY) is ARRAY

  if( !profilesIn.size() eq 1 ) then
    return !profilesIn
  endif

  -- sort arrays in order of largest area first
  !areas = ARRAY()
  do !index indices !profilesIn
    !areas[!index] = !profilesIn[!index].area()
  enddo

  !areaIndex = !areas.sortedIndices().invert()

  !localProfiles = ARRAY()
  !saveProfiles  = ARRAY()

  -- Union each profile with the next and take the largest resulting profile from each union
  -- The results (one less PROFILE) are processed until there is only one profile left
  do !index from 2 to !areaIndex.size()

    !localProfiles = !profilesIn[!areaIndex[!index - 1]].union(!profilesIn[!areaIndex[!index]])
    if( !localProfiles.size() eq 1 ) then
      !saveProfiles.append(!localProfiles[1])
    else
      -- sort by area to get biggest
      !areas = ARRAY()
       do !loopIndex indices !localProfiles
        !areas[!loopIndex] = !localProfiles[!loopIndex].area()
      enddo
      -- save profile with greatest area
      !saveProfiles.append(!localProfiles[!areas.sortedIndices().last()])
    endif

  enddo

  return !this.combineProfiles(!saveProfiles)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .convexProfile()
--
-- Description: get convex hull of raw profiles
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROFILE     Convex hull of Profiles
--
------------------------------------------------------------------------
define method .convexProfile() is PROFILE

  if( !this.rawProfiles.empty() ) then
    return object PROFILE()
  endif

  -- get plane from first profile
  !plane = !this.rawProfiles[1].plane()

  -- get convex hull profile
  !convexHull = object CONVEXBOUNDARY()

  !convexHull.add(!plane,!this.rawProfiles)

  return !convexHull.profile()

endmethod
-- End of method definition
