--
--  Description:     Object used to check element claim or lock
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkDBwrite(DBREF)              BOOLEAN             check element claim or lock
--
------------------------------------------------------------------------
define object COMCHECKDBWRITE
  member .errorMessage is STRING
  member .showAlert    is BOOLEAN
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      checkDBwrite
--
-- Description: check element claim or lock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return true if element and query is valid.
--
------------------------------------------------------------------------
define method .checkDBwrite(!element is DBREF) is BOOLEAN
  !result = true
  !this.errorMessage = ''

  -- Check for write access to db
  if(!element.dbWrite.not()) then
    !this.errorMessage = 'Cannot modify : No write access to DB'
    !result = false

  -- Check claim status
  elseif (!element.dbAccess eq 'MULTIWRITE' and (not !element.okClaim and not !element.lclm)) then

    -- Find the user with the claim, if necessary navigating up the hierarchy until a name is found
    !ownerList = !element.ownlst
    !ownerList.append(!element)
    !ownerList.invert()

    do !ref values !ownerList
      !userClaim = !ref.userC
      break if (!userClaim.empty().not())
    enddo

    if (!userClaim.empty()) then
      !this.errorMessage = 'Cannot modify: Claimed'
    else
      !this.errorMessage = 'Cannot modify: Claimed by ' + !userClaim
    endif

    !result = false

  -- Check lock status
  elseif (!element.lock) then
    !this.errorMessage = 'Cannot modify: Locked ' & !element.type & ' ' & !element.name
    !result = false
  endif

  if (!this.showAlert and not !result) then
    !!alert.error(!this.errorMessage)
  endif

  return !result
endfunction
