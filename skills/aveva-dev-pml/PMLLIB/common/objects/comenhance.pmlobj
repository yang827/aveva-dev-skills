--
--  File:            comenhance.pmlobj
--    Type:          Object Definition
--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Undefined
--  Author:          Undefined
--  Created:         Fri Dec 10 15:16:51 2010
--
--  Description:     Object to manage collection of items ENHANCED in a Design function
--                   Deals with colour and translucency
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addItem(DBREF)                   -                   Add item to highlight
--  addItems(ARRAY)                  -                   Add array of items to highlight
--  clear()                          -                   clear highlight on all items
--  comEnhance()                     -                   Constructor
--  enhanceItem(DBREF)               -                   enhance item with current settings
--  getEnhancedElements(DBREF)       BOOLEAN             check if element has previously been enhanced
--  refresh()                        -                   enhance all items with current settings
--  removeItem(DBREF)                -                   unhighlight selected item
--  setColour(COLOUR)                -                   Set enhance colour number from COLOUR object
--  setColour(REAL)                  -                   Set enhance colour number
--  setColour(STRING)                -                   Set enhance colour number from a colour name
--  setHighlightColour()             -                   Set enhance colour number to current selected highlight colour
--  setTranslucency(REAL)            -                   Set translucency value
--
------------------------------------------------------------------------

define object COMENHANCE

  -- array of DBREF of enhanced items
  member .enhanceList    is ARRAY

  -- Colour number code
  member .colourCode     is REAL

  -- Translucency
  member .translucency   is REAL

endobject
-- End of object definition for COMENHANCE

------------------------------------------------------------------------
--
-- Method:      comEnhance
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
define method .comEnhance()

  -- default to set highlight colour and solid
  !this.colourCode   = !!gphcolopt.highlight().code
  -- negative number means don't change current object translucency
  !this.translucency = -1
  !this.enhanceList.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      addItems
--
-- Description: Add array of items to highlight
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Elements to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addItems(!items is ARRAY)

  do !item values !items
    !this.addItem(!item)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      addItem
--
-- Description: Add item to highlight
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addItem(!item is DBREF)

  if( badref(!item) ) then
    return
  else
    if( !this.enhanceList.findFirst(!item).unset() ) then
      -- only add to list once
      !this.enhanceList.append(!item)
    endif
  endif

  !this.enhanceItem(!item)

endmethod

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: enhance all items with current settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

  do !item values !this.enhanceList
    !this.enhanceItem(!item)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: clear highlight on all items
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  do !item values !this.enhanceList
    UNENHANCE $!item
    handle any
    endhandle
    -- cannot unenhance translucency - it has to be set to zero
    if( !this.translucency.set() ) then
      if( !this.translucency ge 0 ) then
        ENHANCE $!item TRANSLUCENCY 0
        handle any
        endhandle
      endif
    endif
  enddo
  !this.enhanceList.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      enhanceItem
--
-- Description: enhance item with current settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhanceItem(!item is DBREF)

  if( !this.colourCode.set() ) then
    !colour = !this.colourCode
  else
    !colour = !!gphcolopt.highlight().code
  endif
  if( !colour ge 0 ) then
    -- only change colour if not negative
    ENHANCE $!item COLOUR $!colour
    handle any
    endhandle
  endif
  if( !this.translucency.set() ) then
    if( !this.translucency ge 0 ) then
      -- only change translucency if not negative
      ENHANCE $!item TRANSLUCENCY $!this.translucency
      handle any
      endhandle
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      removeItem
--
-- Description: unhighlight selected item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to unenhance
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeItem(!item is DBREF)

  if( badref(!item) ) then
    return
  else
    !index = !this.enhanceList.findFirst(!item)
    if( !index.set() ) then
      -- remove item
      !this.enhanceList.remove(!index)
      UNENHANCE $!item
      handle any
      endhandle
      -- cannot unenhance translucency - it has to be set to zero
      if( !this.translucency.set() ) then
        if( !this.translucency ge 0 ) then
          ENHANCE $!item TRANSLUCENCY 0
          handle any
          endhandle
        endif
      endif
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Set enhance colour number from a colour name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Colour name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColour(!colourName is STRING)

  -- Get Colour Number
  !colourObject = object COLOUR(!colourName)
  !this.setColour(!colourObject.code)

endmethod

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Set enhance colour number from COLOUR object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      COLOUR      Colour object for highlight colour
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColour(!colour is COLOUR)

  -- Get Colour Number
  !this.setColour(colour.code)

endmethod

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Set enhance colour number
--              Use -ve colour number to change translucency and leave
--              colour unchanged
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColour(!colour is REAL)

  !this.colourCode = !colour

  -- refresh with new colour
  !this.refresh()

endmethod

------------------------------------------------------------------------
--
-- Method:      setHighlightColour
--
-- Description: Set enhance colour number to current selected highlight colour
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHighlightColour()

  -- Set to highlight colour
  !this.setColour(!!gphcolopt.highlight().code)

endmethod

-----------------------------------------------------------------------
--
-- Method:      setTranslucency
--
-- Description: Set translucency value
--              Use -ve number to change colour and leave translucency
--              unchanged
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        translucency value
-- Return:
--   [Data Type] [Description]
---
------------------------------------------------------------------------
define method .setTranslucency(!translucency is REAL)

  !this.translucency = !translucency

  -- refresh with new colour
  !this.refresh()

endmethod
-----------------------------------------------------------------------
--
-- Method:      getEnhancedElements()
--
-- Description: check if element has previously been enhanced
--
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
---
------------------------------------------------------------------------
define method .getEnhancedElements(!element is DBREF) is BOOLEAN

  return !this.enhanceList.findFirst(!element).set()




endmethod
