------------------------------------------------------------------------
-- Method:      compare
--
-- Description:
--   Compare against the currently selected data source
--   This is the command line equivalent of pressing the refresh button in the application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Source list
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .compare(!list is STRING)

  using namespace 'Aveva.Pdms.InstrumentationImport.Addin'

  -- Validate lists
  !valid = FALSE
  if (!list inset(|Loops|, |Cables|, |Cable Catalogue|)) then
    return error 1 |List not currently supported for command line usage|
  endif
  if (!this.source eq ||) then
    return error 1 |Source database not selected|
  else
  !valid = !!compareUpdate.coreObject[!this.instance].isElementExist(|!list|)
  !sourceList = !list
  endif
  if (not !valid) then
    return error 1 |Invalid source list|
  endif

  !this.list = !sourceList

  -- Compare against the source list
  !!compareUpdate.coreObject[!this.instance].compare(!sourceList)

endmethod
-- End of method definition for .compare(STRING)

------------------------------------------------------------------------
-- Method:      owner
--
-- Description:
--   Validate and set owner object name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Owner object
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .owner(!owner is STRING)

  -- Validate and set owner object name
  !this.owner = ||
  !unusedElement = !owner.dbref()
  handle any
    return error 1 |Invalid owner name|
  endhandle
  !this.owner = !owner

endmethod
-- End of method definition for .owner()

