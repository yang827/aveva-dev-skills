------------------------------------------------------------------------
-- Method:      updateLink
--
-- Description:
--   Update the target database using switches to link
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateLink()

  -- Set switches to link and not update attributes
  !linkInsertedElements = TRUE
  !linkMatchedElements  = TRUE
  !updateAttributesForLinkedInsertedElements = TRUE
  !updateAttributesForLinkedMatchedElements  = TRUE
  !unlinkSelectedElements = FALSE

  -- Update target data
  !this.update(!linkInsertedElements, !linkMatchedElements, !updateAttributesForLinkedInsertedElements, !updateAttributesForLinkedMatchedElements, !unlinkSelectedElements)

endmethod
-- End of method definition for .updateLink()

------------------------------------------------------------------------
-- Method:      updateUnlink
--
-- Description:
--   Update the target database using switches to unlink
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateUnlink()

  -- Set switches to unlink
  !linkInsertedElements = FALSE
  !linkMatchedElements  = FALSE
  !updateAttributesForLinkedInsertedElements = FALSE
  !updateAttributesForLinkedMatchedElements  = FALSE
  !unlinkSelectedElements = TRUE

  -- Update target data
  !this.update(!linkInsertedElements, !linkMatchedElements, !updateAttributesForLinkedInsertedElements, !updateAttributesForLinkedMatchedElements, !unlinkSelectedElements)

endmethod
-- End of method definition for .updateUnlink()

------------------------------------------------------------------------
-- Method:      update
--
-- Description:
--   Update the target database using the results from the last run compare
--   This is the command line equivalent of selecting accept all, update database, then update in the application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Link inserted elements
--    2   R      BOOLEAN     Link matched elements
--    3   R      BOOLEAN     Update attributes for linked inserted elements
--    4   R      BOOLEAN     Update attributes for linked matched elements
--    5   R      BOOLEAN     Unlink selected elements
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .update(!linkInsertedElements is BOOLEAN, !linkMatchedElements is BOOLEAN, !updateAttributesForLinkedInsertedElements is BOOLEAN, !updateAttributesForLinkedMatchedElements is BOOLEAN, !unlinkSelectedElements is BOOLEAN)

  using namespace 'Aveva.Pdms.InstrumentationImport.Addin'

  -- Set owner for currently selected source list
  !elements[0] = !this.list
  !owners[0]   = !this.owner

  -- Update the target data according to the selected switches
  !!compareUpdate.coreObject[!this.instance].update(!linkInsertedElements, !linkMatchedElements, !updateAttributesForLinkedInsertedElements, !updateAttributesForLinkedMatchedElements, !unlinkSelectedElements, !elements, !owners)

endmethod
-- End of method definition for .update(BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN)

------------------------------------------------------------------------
-- Method:      export
--
-- Description:
--   Export the current results of the last run compare
--   This is the command line equivalent of saving the content of the grid tabs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File path for elements grid
--    2   R      STRING      File path for attributes grid
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .export(!elementsFilePath is STRING, !attributesFilePath is STRING)

  using namespace 'Aveva.Pdms.InstrumentationImport.Addin'

  -- Check file paths are valid
  !file = object FILE(!elementsFilePath)
  handle any
    return error 1 |Invalid file path|
  endhandle
  !file = object FILE(!attributesFilePath)
  handle any
    return error 1 |Invalid file path|
  endhandle

  -- Write out the contents of the grids to files
  !!compareUpdate.coreObject[!this.instance].export(!elementsFilePath,!attributesFilePath)

endmethod
-- End of method definition for .export(STRING,STRING)
