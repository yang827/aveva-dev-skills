-- File:            compareUpdate.pmlobj
--   Type:          Object Definition
--   Group:         Compare/Update
--
--    Keyword:      Compare/Update
--    Module:       General
--
-- Author:          Mac Lewis
-- Created:         Fri May 27   10:0:01  2011
--
-- Description:
-- Command line access to Compare/Update functionality
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acceptAllDisplayed()             -                   set accept all setting for all displayed item
--  acceptAllLinked()                -                   set accept all setting for linked item
--  acceptAllMatched()               -                   set accept all setting for matched item
--  acceptAllUnmatched()             -                   set accept all setting for unmatched item
--  compare(STRING)                  -                   Compare against the currently selected data source
--  compareCableCatalogue()          -                   Compare cable catalogue
--  compareCables()                  -                   Compare cables
--  compareEquipment()               -                   Compare equipment
--  compareInstruments()             -                   Compare instruments
--  compareLines()                   -                   Compare lines
--  compareLoops()                   -                   Compare instrument loops
--  comparePipes()                   -                   Compare lines/pipes
--  comparePipingSpecials()          -                   Compare piping specials
--  compareUpdate()                  -                   Constructor
--  compareValves()                  -                   Compare valves
--  export(STRING,STRING)            -                   Export the current results of the last run compare
--  globalInstance()                 -                   Create global instance of object
--  messageLog(ARRAY)                -                   Output messages to command line
--  owner(STRING)                    -                   Validate and set owner object name
--  selectDesign()                   -                   Select Design database source
--  selectElectrical()               -                   Select AVEVA Electrical source
--  selectEngineering()              -                   Select Engineering database source
--  selectInstrumentation()          -                   Select AVEVA Instrumentation source
--  selectPID()                      -                   Select AVEVA PID source
--  selectSchematic()                -                   Select Schematic database source
--  selectSourceDb(STRING)           -                   Select source database type
--  update(BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN) -                   Update the target database using the results from the last run compare
--  updateLink()                     -                   Update the target database using switches to link
--  updateUnlink()                   -                   Update the target database using switches to unlink
--

--
------------------------------------------------------------------------

define object COMPAREUPDATE

  -- Array of core application instance objects
	member .coreObject           is ARRAY

  -- Core application instance used by this object
	member .instance             is REAL

  -- Currently selected source database and list
  member .source               is STRING
  member .list                 is STRING

  -- Owner objects for update
  member .owner                is STRING

endobject

------------------------------------------------------------------------
-- Method:      compareUpdate
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .compareUpdate()

  using namespace 'Aveva.Pdms.InstrumentationImport.Addin'

  -- Setup global Compare/Update object to hold array of core application instances
  if (not defined(!!compareUpdate)) then
    !this.globalInstance()
  endif

  -- Set the application instance number to be used by this object
  !this.instance = !!compareUpdate.coreObject.size() + 1
  !!compareUpdate.coreObject[!this.instance] = object INSTRUMENTATIONIMPORTPMLNET()

  -- Define callback
  !!compareUpdate.coreObject[!this.instance].addEventHandler(|PMLLogHandler|, !!compareUpdate, |messageLog|)

endmethod
-- End of method definition for compareUpdate()

------------------------------------------------------------------------
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .globalInstance()

  -- Create global variable
  !!compareUpdate = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
-- Method:      messageLog
--
-- Description:
--   Output messages to command line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Message texts
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .messageLog(!message is ARRAY)

  -- Output message log to command line
  do !i indices !message
    write !message[!i]
  enddo

endmethod
-- End of method definition for .messageLog(ARRAY)

