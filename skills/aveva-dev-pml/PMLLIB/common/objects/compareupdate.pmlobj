------------------------------------------------------------------------
-- Method:      selectSourceDb
--
-- Description:
--   Select source database type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Source database type
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .selectSourceDb(!source is STRING)

  using namespace 'Aveva.Pdms.InstrumentationImport.Addin'

  -- Validate sources
  !this.source = ||
  !valid       = FALSE
  !same        = FALSE
  !supported   = TRUE
  !session     = CURRENT SESSION
  if (!source eq |Design Database|) then
    !same = (!session.module() eq |DESIGN| or !session.module() eq |OUTFITTING|)
    !valid = TRUE
  elseif (!source eq |Schematic Database|) then
    !same =  (!session.module() eq |DIAGRAMS| or !session.module() eq |SCHEMATICMODELMANAGER|)
    !valid = TRUE
  elseif (!source eq |Engineering Database|) then
    !same =  FALSE
    !valid = TRUE
  elseif (!source eq |AVEVA Instrumentation|) then
    !supported = FALSE
  elseif (!source eq |AVEVA Electrical|) then
    !supported = FALSE
  elseif (!source eq |AVEVA PID|) then
    !supported = FALSE
  endif
  if (!same) then
    return error 1 |Cannot select source same as current target database|
  elseif (not !supported) then
    return error 1 |Source not currently supported for command line usage|
  elseif (not !valid) then
    return error 1 |Invalid source database type|
  endif
  !this.source = !source

  -- Select the source database
  !!compareUpdate.coreObject[!this.instance].selectSourceDb(!source)

endmethod
-- End of method definition for .selectSourceDb(STRING)

------------------------------------------------------------------------
-- Method:      compareEquipment
--
-- Description:
--   Compare equipment
------------------------------------------------------------------------
define method .compareEquipment()
  if (!this.source eq |Design Database| or !this.source eq |Schematic Database| or !this.source eq |Engineering Database|) then
    !sourceType = !this.source.before(| Database|) & | | & |Equipment|
  	!this.compare(!sourceType)
  endif
endmethod
-- End of method definition for .compareEquipment()

------------------------------------------------------------------------
-- Method:      compareLines
--
-- Description:
--   Compare lines
------------------------------------------------------------------------
define method .compareLines()
  if (!this.source eq |Schematic Database| or !this.source eq |Engineering Database|) then
    !sourceType = !this.source.before(| Database|) & | | & |Lines|
  	!this.compare(!sourceType)
  endif
endmethod
-- End of method definition for .compareLines()

------------------------------------------------------------------------
-- Method:      comparePipes
--
-- Description:
--   Compare lines/pipes
------------------------------------------------------------------------
define method .comparePipes()
  if (!this.source eq |Design Database|) then
    !sourceType = !this.source.before(| Database|) & | | & |Pipes|
  	!this.compare(!sourceType)
  elseif (!this.source eq |Schematic Database|) then
    !sourceType = !this.source.before(| Database|) & | | & |Pipelines|
  	!this.compare(!sourceType)
  endif
endmethod
-- End of method definition for .comparePipes()

