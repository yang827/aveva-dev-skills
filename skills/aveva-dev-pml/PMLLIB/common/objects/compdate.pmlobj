-- File:            compdate.pmlobj
--   Type:          Object Definition
--   Group:         Change Style
--     Keyword:     CHANGE
--   Module:        ALL
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 2001
--
--
-- Description:
-- Change comparison date form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING,STRING)             -                   Either passes back the chosen date to the calling form or updates
--  cancel()                         -                   Closes the form
--  ce()                             -                   Refreshes the form for the current element
--  checkCrsf()                      -                   Checks that the VIEW element does reference a change ruleset
--  checkValue(GADGET,STRING)        -                   Checks the range for the entered gadget value
--  comparisonDate()                 -                   Reads any set comparison date
--  dateActive(BOOLEAN)              -                   Sets the date gadgets active status
--  dateUnset()                      -                   Unsets the date gadgets
--  displayMode(STRING)              -                   Populates the stamp list gadget
--  init(STRING,STRING)              -                   The form initialisation
--  month(BOOLEAN)                   -                   Populates the day gadget with the relevant range for the chosen month
--  selectStamp()                    -                   Select a stamp if the input date matches any of those listed
--  setCompDate(STRING)              -                   Make the command SETCOMPDATE
--  setDate(DATETIME)                -                   Set the form time & date gadgets to reflect the passed time/date
--  setView()                        -                   Choose a stamp or set the date according to the current view setting
--  showForm(FORM)                   -                   Show the form, called by FOVIEW and FMUVIEW
--  stampDate(STRING)                -                   Store the date for the selected date
--  storeDate()                      -                   Store the selected date in this object
--  upDown(GADGET,STRING,STRING)     -                   Raise and lower the gadget values
--  update(STRING,STRING)            -                   Make the relevant draft UPDATE and SHOW CHANGES
--  zero(STRING)                     STRING              Test if a leading zero character is required to maintain the format 00:00
--
------------------------------------------------------------------------
-- Define object
define object COMPDATE

  member .form is FORM
  member .currDate is DATETIME
  member .compDate is DATETIME
  member .compDateString is STRING
  member .stampRef is DBREF
  member .type is STRING
  member .allStamp is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .apply(STRING,STRING)
--
-- Description: Either passes back the chosen date to the calling form or updates
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      From where the action is being called either FORM or MENU
--    2   R      STRING      For a MENU call what update command DESI, ANNO or ALL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .apply(!callType is STRING, !updateType is STRING)

  -- Check for future date
  if (!this.compDate.gt(object DATETIME())) then
    !!alert.error('You have set the date to a time in the future. The date will be reset to the present....')
    !this.setDate(object DATETIME())
    !this.storeDate()
    return
  endif

  -- For a calling form
  if (!callType.eq('FORM')) then

    -- Test if there is no date to pass
    if (!this.compDateString.unset()) then

      -- Must use a stamp
      !this.form.callingForm.formMethods.type = 'STAMP'

    else

      -- Test if date or stamp to be used
      if (!this.form.stampList.selection().eq('DATE')) then
        !this.form.callingForm.formMethods.type = 'DATE'
      else
        if (!this.compDateString.eq(!this.form.stampList.selection().dbref().setDat)) then
          !this.form.callingForm.formMethods.type = 'STAMP'
        else
          !this.form.callingForm.formMethods.type = 'DATE'
        endif
      endif

    endif

    -- Pass the stamp name to the calling form
    if (!this.form.callingForm.formMethods.type.eq('STAMP')) then
      !this.form.callingForm.formMethods.compDateString = STRING()
      !this.form.callingForm.date.val = 'Stamp ' & !this.form.stampList.selection().dbref().flnn

    -- Pass the dates back to the calling form
    else
      !this.form.callingForm.formMethods.currDate = !this.currDate
      !this.form.callingForm.formMethods.compDate = !this.compDate
      !this.form.callingForm.formMethods.compDateString = !this.compDateString
      !this.form.callingForm.date.val = !this.compDateString
    endif

    -- Clear the form
    !this.form.callingForm = object FORM()

    -- Hide form
    !this.cancel()

  -- For a menu call
  else

    -- For a date
    if (!this.form.stampList.selection().eq('DATE')) then
      !this.type = 'DATE'

    -- For Unset
    elseif (!this.form.stampList.selection().eq('UNSET')) then
      !this.type = 'UNSET'

    -- For a stamp
    else

      -- Test for no date string
      if (!this.compDateString.unset()) then
        !this.type = 'STAMP'

      -- Test for date match to selected stamp date
      elseif (!this.compDateString.eq(!this.form.stampList.selection().dbref().setDat)) then
        !this.type = 'STAMP'
      else
        !this.type = 'DATE'
      endif

    endif

    -- Test for setting the comparison date directly
    if (!updateType.eq('SET')) then
      !this.setCompDate(!this.type)

    -- Update the ce
    else

      -- Access the ce & update
      if (!this.form.ceRef.badref()) then
        !!alert.error('Current Element does not exist!')
      else
        !!ce = !this.form.ceRef
        !this.update('MENU',!updateType)
      endif

    endif

  endif

endmethod
-- End of method definition for .apply(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Closes the form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cancel()

  hide !!compDate

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Refreshes the form for the current element
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ce()

  -- Initialise variables
  !testString = 'DRWG SHEE VIEW'

  -- Test the current element if at or below DRWG
  if (!testString.match(!!ce.type.upCase()).eq(0)) then

    -- Test for below view level
    -- Have to access the view since 'show changes' does not function below that level
    VIEW
    handle (2,111)
      !!alert.error('You need to be positioned at a DRWG, SHEE or VIEW to Update Changes!')
      return
    endhandle

  endif

  -- Update for ce
  !this.form.type.val = !!ce.type.upCase()
  !this.form.name.val = !!ce.flnm
  !this.form.ceRef = !!ce

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      .checkCrsf()
--
-- Description: Checks that the VIEW element does reference a change ruleset
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkCrsf()

  -- Check that the view references a change style
  if (!this.form.show.val) then
    if (!this.form.crsf.selection().upCase().eq('UNSET')) then
      !!alert.warning('To show changes, the view must reference a change rule. Please select one.')
      !this.form.show.val = false
      return
    elseif (!this.form.crsf.selection().dbref().badref()) then
      !!alert.warning('The view has an illegal change rule reference. Please reset it.')
      !this.form.show.val = false
      return
    endif
  endif

endmethod
-- End of method definition for .checkCrsf()

------------------------------------------------------------------------
--
-- Method:      .checkValue(GADGET,STRING)
--
-- Description: Checks the range for the entered gadget value
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget being checked
--    2   R      STRING      Type of value being checked MINS, HOUR or YEAR
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkValue(!gadget is GADGET, !type is STRING)

  -- Check that the entered value is valid
  if (!type.eq('MINS')) then
    if (!gadget.val.real().gt(59)) then
      !!alert.error('The maximum value allowed is 59')
      !gadget.val = '59'
    elseif (!gadget.val.real().lt(0)) then
      !!alert.error('The minimum value allowed is 0')
      !gadget.val = '0'
    endif
  elseif (!type.eq('HOUR')) then
    if (!gadget.val.real().gt(23)) then
      !!alert.error('The maximum value allowed is 23')
      !gadget.val = '23'
    elseif (!gadget.val.real().lt(0)) then
      !!alert.error('The minimum value allowed is 0')
      !gadget.val = '0'
    endif
  elseif (!type.eq('YEAR')) then
    if (!gadget.val.real().lt(1996) or !gadget.val.real().gt(!this.currDate.year())) then
      !!alert.error('The year specified (' & !gadget.val & ') must be between 1996 and ' & !this.currDate.year())
      !gadget.val = !this.currDate.year()
    endif
  endif

  -- Store the date
  !this.storeDate()

  -- Select any relevant stamp
  !this.selectStamp()

endmethod
-- End of method definition for .checkValue(GADGET,STRING)

------------------------------------------------------------------------
--
-- Method:      .comparisonDate()
--
-- Description: Reads any set comparison date
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .comparisonDate()

  -- Test for existing comparison date
  VAR !compDate COMPDATE DATE
  if (!compDate.upCase().neq('UNSET')) then
    !this.form.stampList.select('RTEXT','DATE')
    !this.dateActive(true)
    !this.setDate(object DATETIME(!compDate))
    !this.storeDate()

  -- Test for existing comparison stamp
  else
    VAR !compStamp COMPDATE STAMP
    if (!compStamp.upCase().neq('UNSET')) then
      !this.form.stampList.select('DTEXT',!compStamp.subString(2))
      !this.stampDate('MENU')
    else

      -- No comparison date has been set
      !this.form.stampList.select('RTEXT','UNSET')
      !this.stampDate('MENU')

    endif
  endif

endmethod
-- End of method definition for .comparisonDate()

------------------------------------------------------------------------
--
-- Method:      .dateActive(BOOLEAN)
--
-- Description: Sets the date gadgets active status
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to set the gadgets active or inactive
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dateActive(!active is BOOLEAN)

  -- Set date gadgets on
  if (!active) then

    !this.form.upH.active = true
    !this.form.dnH.active = true
    !this.form.hour.active = true
    !this.form.mins.active = true
    !this.form.upM.active = true
    !this.form.dnM.active = true
    !this.form.day.active = true
    !this.form.month.active = true
    !this.form.year.active = true
    !this.form.upY.active = true
    !this.form.dnY.active = true

  -- Set date gadgets off
  else

    !this.form.upH.active = false
    !this.form.dnH.active = false
    !this.form.hour.active = false
    !this.form.mins.active = false
    !this.form.upM.active = false
    !this.form.dnM.active = false
    !this.form.day.active = false
    !this.form.month.active = false
    !this.form.year.active = false
    !this.form.upY.active = false
    !this.form.dnY.active = false

  endif

endmethod
-- End of method definition for .dateActive(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .dateUnset()
--
-- Description: Unset the date gadgets
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dateUnset()

    !this.form.hour.val = ''
    !this.form.mins.val = ''
    !this.form.day.val = 1
    !this.form.month.val = 1
    !this.form.year.clear()

endmethod
-- End of method definition for .dateUnset()

------------------------------------------------------------------------
--
-- Method:      .displayMode(STRING)
--
-- Description: Populates the stamp list gadget
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Update type DESI, ANNO, ALL or SET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .displayMode(!updateType is STRING)

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- For no found stamps
  if (!this.allStamp.empty()) then

    -- Populate stamp list
    !dtext.append('Time & Date')
    !rtext.append('DATE')
    if (!updateType.eq('SET')) then
      !dtext.append('Unset')
      !rtext.append('UNSET')
    endif
    !this.form.stampList.dtext = !dtext
    !this.form.stampList.rtext = !rtext

  else

    -- Get stamp data
    do !stamp val !this.allStamp
      if (!this.form.mode.selection().eq('NAME')) then
        !dtext.append(!stamp.dbref().flnn)
      elseif (!this.form.mode.selection().eq('DESCRIPTION')) then
        !description = !stamp.dbref().desc
        if (!description.eq('')) then
          !dtext.append('Unset')
        else
          !dtext.append(!description)
        endif
      elseif (!this.form.mode.selection().eq('DATE')) then
        !setDat = !stamp.dbref().setDat
        if (!setDat.eq('')) then
          !dtext.append('Unset')
        else
          !dtext.append(!setDat)
        endif
      else
        !function = !stamp.dbref().func
        if (!function.eq('')) then
          !dtext.append('Unset')
        else
          !dtext.append(!function)
        endif
      endif
      !rtext.append(!stamp)
    enddo

    -- Sort the output
    !sorted = !dtext.sortedIndices()
    !dtext.sort()
    !rtext.reIndex(!sorted)

    -- Add time & date option
    !dtext.append('Time & Date')
    !rtext.append('DATE')
    if (!updateType.eq('SET')) then
      !dtext.append('Unset')
      !rtext.append('UNSET')
    endif

    -- Populate the stamp list
    !this.form.stampList.dtext = !dtext
    !this.form.stampList.rtext = !rtext

  endif

endmethod
-- End of method definition for .displayMode(STRING)

------------------------------------------------------------------------
--
-- Method:      .init(STRING)
--
-- Description: The form initialisation
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Whether called from FORM or MENU
--    2   R      STRING      Update type DESI, ANNO, ALL or SET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init(!callType is STRING, !updateType is STRING)

  -- Get current element type
  !ceType = !!ce.type.upCase()

  -- For a menu call
  if (!callType.eq('MENU')) then

    -- For ce
    if (!updateType.neq('SET')) then
      !this.ce()
    endif

  endif

  -- Get all existing stamps
  VAR !allStamp COLL ALL STAMP
  !this.allStamp = !allStamp

  -- Populate stamp list
  !this.displayMode(!updateType)

  -- Populate date gadgets
  if (!this.allStamp.empty() or !ceType.eq('DRWG') or !ceType.eq('SHEE')) then
    !this.stampDate('NOW')
  else
    !this.stampDate(!callType)
  endif

  -- Store new date/time
  if (!this.compDateString.set()) then
    !this.storeDate()
  endif

  -- Choose current setting
  if (!ceType.eq('VIEW') and !updateType.neq('SET')) then
    !this.setView()
  elseif (!ceType.neq('DRWG') and !ceType.neq('SHEE')) then
    !this.comparisonDate()
  endif

endmethod
-- End of method definition for .init(STRING)

------------------------------------------------------------------------
--
-- Method:      .month(BOOLEAN)
--
-- Description: Populates the day gadget with the relevant range for the chosen month
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to store the date or not
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .month(!store is BOOLEAN)

  -- Initialise variables
  !days30 = 'SEPTEMBER APRIL JUNE NOVEMBER'

  -- Build day array
  if (!this.form.month.selection('DTEXT').upCase().eq('FEBRUARY')) then

    -- Test for leap year
    !divide = !this.form.year.val / 4
    if (!divide.string().match('.').eq(0)) then
      -- Leap year
      !limit = 29
    else
      !limit = 28
    endif

  elseif (!days30.match(!this.form.month.selection('DTEXT').upCase()).neq(0)) then
    !limit = 30
  else
    !limit = 31
  endif
  do !count from 1 to 31
    !text[!count] = !count.string()
    break if (!count.eq(!limit))
  enddo

  -- Populate day gadget
  !this.form.day.dtext = !text

  -- Store new date/time
  if (!store) then
    !this.storeDate()
    !this.selectStamp()
  endif

endmethod
-- End of method definition for .month(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .selectStamp()
--
-- Description: Select a stamp if the input date matches any of those listed
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .selectStamp()

  -- Initialise variables
  !found = false

  -- Check if the input date matches any of the listed stamps
  do !stamp val !this.allStamp
    if (!stamp.dbref().setDat.eq(!this.compDateString)) then
      !this.form.stampList.select('RTEXT',!stamp)
      !found = true
      break
    endif
  enddo

  -- If no stamp found
  if (!found.not()) then
    !this.form.stampList.select('RTEXT','DATE')
  endif

endmethod
-- End of method definition for .selectStamp()

------------------------------------------------------------------------
--
-- Method:      .setCompDate( STRING)
--
-- Description: Make the command SETCOMPDATE
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Whether to set the comparison date to a DATE, STAMP or UNSET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setCompDate(!arg is STRING)

  -- Unset the comparison date
  if (!arg.eq('UNSET')) then
    SETCOMPDATE UNSET

  -- Set comparison date
  elseif (!arg.eq('DATE')) then

    -- Initialise variables
    !compDate = !this.compDateString

-- Testing
--  write 'SETCOMPDATE $!compDate'

    -- Set comparison date
    SETCOMPDATE $!compDate

  -- Set comparison stamp
  else

    -- Initialise variables
    !stampName = !this.stampRef.flnm

-- Testing
--  write 'SETCOMPDATE STAMP  $!stampName'

    -- Set comparison date to the chosen Stamp
    SETCOMPDATE STAMP $!stampName
      handle (43,388)
        -- A db is not valid for the current mdb
      endhandle

  endif

endmethod
-- End of method definition for .setCompDate(STRING)

------------------------------------------------------------------------
--
-- Method:      .setDate(DATETIME)
--
-- Description: Set the form time & date gadgets to reflect the passed time/date
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DATETIME    Date & Time for gadget values
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setDate(!dateTime is DATETIME)

    -- Current date
    !this.currDate = object DATETIME()

    -- Set date gadgets
    -- Hour/Mins
    !this.form.hour.val = !this.zero(!dateTime.hour().string())
    !this.form.mins.val = !this.zero(!dateTime.minute().string())

    -- Do year before month to check for leap year
    !this.form.year.val = !dateTime.year()

    -- Do month before day so can populate day gadget
    !this.form.month.select('DTEXT',!dateTime.monthString())
    !this.month(false)

    -- Do day
    !this.form.day.select('DTEXT',!dateTime.date().string())

endmethod
-- End of method definition for .setDate(DATETIME)

------------------------------------------------------------------------
--
-- Method:      .setView()
--
-- Description: Choose a stamp or set the date according to the current view setting
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setView()

  -- Choose a stamp or set the date according to the current view setting
  if (!!ce.vCompStamp.badref().not()) then

    -- Select the referenced stamp
    !this.form.stampList.select('RTEXT',!!ce.vCompStamp.string())

    -- Set the date to reflect the stamp
    !this.stampDate('MENU')

  elseif (!!ce.vCompDate.set()) then

    -- Use date
    !this.setDate(object DATETIME(!!ce.vCompDate))
    !this.form.stampList.select('RTEXT','DATE')
    !this.dateActive(true)

    -- Store new date/time
    !this.storeDate()

  else

    -- Use any set comparison date
    VAR !compDate COMPDATE DATE
    if (!compDate.upCase().neq('UNSET')) then

      !this.form.stampList.select('RTEXT','DATE')
      !this.dateActive(true)
      !this.setDate(object DATETIME(!compDate))
      !this.storeDate()

    -- Test for existing comparison stamp
    else

      VAR !compStamp COMPDATE STAMP
      if (!compStamp.upCase().neq('UNSET')) then
        !this.form.stampList.select('DTEXT',!compStamp.subString(2))
        !this.stampDate('MENU')
      else

        -- No comparison date has been set so select date as of now
        !this.stampDate('NOW')

      endif

    endif

  endif

endmethod
-- End of method definition for .setView()

------------------------------------------------------------------------
--
-- Method:      .showForm(FORM)
--
-- Description: Show the form, called by FOVIEW and FMUVIEW
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        The calling form !!cdroview or !!cdrmuview
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .showForm(!form is FORM)

  -- Load the form
  !!compDate('FORM','NONE')

  -- Store the calling form name
  !!compDate.callingForm = !form

  -- Show the form
  show !!compDate

endmethod
-- End of method definition for .showForm(FORM)

------------------------------------------------------------------------
--
-- Method:      .stampDate(STRING)
--
-- Description: Store the date for the selected date
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      NOW to set the stamp date as of now
--                           FORM when called from a form
--                           MENU when called from a menu
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stampDate(!callType is STRING)

  -- Get date for selected stamp
  -- For NOW
  if (!callType.eq('NOW')) then

    -- Set date gadgets active
    !this.dateActive(true)

    -- Use today
    !this.setDate(object DATETIME())
    if (!this.form.callingForm.unset()) then
      !this.stampRef = object DBREF()
      !this.type = 'DATE'
    else
      !this.form.callingForm.formMethods.stampRef = object DBREF()
      !this.form.callingForm.formMethods.type = 'DATE'
    endif

    -- Select 'Time & Date' entry
    !this.form.stampList.select('RTEXT','DATE')

  -- For DATE
  elseif (!this.form.stampList.selection().eq('DATE')) then

    -- Initialise variables
    !this.stampRef = object DBREF()
    !this.type = 'DATE'

    -- Set date gadgets active
    !this.dateActive(true)

    -- If previous selection did not have a date, use now
    if (!this.form.year.val.unset()) then
      !this.setDate(object DATETIME())
    endif

  -- For UNSET
  elseif (!this.form.stampList.selection().eq('UNSET')) then

    !this.dateActive(false)
    !this.dateUnset()
    !this.compDateString = STRING()
    return

  else

    -- Store stamp reference
    if (!callType.eq('FORM')) then
      !this.form.callingForm.formMethods.stampRef = !this.form.stampList.selection().dbref()
      !this.form.callingForm.formMethods.type = 'STAMP'
    else
      !this.stampRef = !this.form.stampList.selection().dbref()
      !this.type = 'STAMP'
    endif

    -- For a stamp without a set date
    if (!this.form.stampList.selection().dbref().setDat.eq('')) then

      -- Set default day
      !this.month(false)

      -- Set date gadgets inactive
      !this.dateActive(false)
      !this.dateUnset()
      !this.compDateString = STRING()
      return

    -- For a stamp with a set date
    else

      -- Set date gadgets active
      !this.dateActive(true)

      -- Use stamp date
      !this.setDate(object DATETIME(!this.form.stampList.selection().dbref().setDat))

    endif

  endif

  -- Store new date/time
  !this.storeDate()

endmethod
-- End of method definition for .stampDate(STRING)

------------------------------------------------------------------------
--
-- Method:      .storeDate()
--
-- Description: Store the selected date in this object
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .storeDate()

  -- Build & store the date object for the comparison date/time
  !hourMins = !this.form.hour.val & ':' & !this.form.mins.val
  !day = !this.form.day.selection('DTEXT')
  !month = !this.form.month.selection('DTEXT')
  !year = !this.form.year.val
  !this.compDate = object DATETIME(!hourMins & ' ' & !day & ' ' & !month & ' ' & !year)

  -- Store the date/time as a string WITHOUT the seconds
  !hour = !this.zero(!this.compDate.hour().string())
  !mins = !this.zero(!this.compDate.minute().string())
  !this.compDateString = !hour & ':' & !mins & ' ' & !this.compDate.date() & ' ' & !this.compDate.monthString().subString(1,3) & ' ' & !this.compDate.year()

endmethod
-- End of method definition for .storeDate()

------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: Make the relevant draft UPDATE and SHOW CHANGES
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update(!callType is STRING, !updateType is STRING)

  -- Update via form call
  if (!callType.eq('FORM')) then

    -- Initialise variables
    !elemRef = !this.form.name.val.dbref()

   -- Test view
    if (!elemRef.badref()) then
      !!alert.error('Cannot access the VIEW ' & !elemRef.flnm)
      return
    endif

    -- Current date
    !this.currDate = object DATETIME()

    -- For a given date
    if (!this.form.show.val and !this.form.formMethods.type.eq('DATE')) then

      -- Get chosen comparison date from the passed gadget
      !this.compDate = object DATETIME(!this.form.date.val)

      -- Check that the comparison date/time is not the same as the now date/time
      if (!this.compDate.eq(!this.currDate)) then
        !!alert.warning('The comparison date/time is the same as the current date/time!')
        return
      endif

      -- Check that the comparison date/time is not after the current date/time
      if (!this.compDate.geq(!this.currDate)) then
        !!alert.warning('The comparison date/time is later than the current date/time!')
        return
      endif

      -- Set comparison date string
      !this.compDateString = !this.form.date.val

    endif

    -- Process the view
    if (!elemRef.type.upCase().eq('VIEW')) then

      -- Access the view
      !!ce = !elemRef

      -- Test for update design show changes
      !isLDP = !this.form.updateDesignOnApply.val.eq(3)
      if (!this.form.show.val) then

        -- Set the comparison date
        !this.setCompDate(!this.type)

        -- Update design changes
        if( !isLDP ) then $* LDP
          !session = current session
          !save = 'NO'
          if (!session.modified()) then
            !save = !!alert.confirm('The Background Process will use the latest saved session data, Do you wish to Savework?')
          endif
          if (!save.boolean()) then
            SAVEWORK
          endif
          UPDATE DESIGN IGNORE SHOW CHANGES NOWAIT
          handle any
            !!alert.error(!!error.text)
          endhandle
        else
          UPDATE DESIGN IGNORE SHOW CHANGES
          handle any
            !!alert.error(!!error.text)
          endhandle
        endif

      else
        if( !isLDP ) then
          !session = current session
          !save = 'NO'
          if (!session.modified()) then
            !save = !!alert.confirm('The Background Process will use the latest saved session data, Do you wish to Savework?')
          endif
          if (!save.boolean()) then
            SAVEWORK
          endif
          $M "%PDMSUI%/DRA/CLIB/UUPDATE" $<DESIGN$> $<IGNORE$> $<NOWAIT$>
        else
          $M "%PDMSUI%/DRA/CLIB/UUPDATE" $<DESIGN$>
        endif
      endif

    endif

  -- For a menu call
  else

    -- Current date
    !this.currDate = object DATETIME()

    -- Check that the comparison date/time is not the same as the now date/time
    if (!this.compDate.eq(!this.currDate)) then
      !!alert.warning('The comparison date/time is the same as the current date/time!')
      return
    endif

    -- Check that the comparison date/time is not after the current date/time
    if (!this.compDate.geq(!this.currDate)) then
      !!alert.warning('The comparison date/time is later than the current date/time!')
      return
    endif

    -- Set the comparison using the stamp or the date
    !this.setCompDate(!this.type)

    -- Update changes
    -- To Allow for ldp on All and design possibilities
    if (!updateType.lowcase().match('nowait') gt 0) then
      !update = !updateType.lowcase().before('nowait')
      !nowait = 'NOWAIT'
    else
      !update = !updateType
      !nowait = ''
    endif
    if (!nowait eq 'NOWAIT') then
      !session = current session
      !save = 'NO'
      if (!session.modified()) then
        !save = !!alert.confirm('The Background Process will use the latest saved session data, Do you wish to Savework?')
      endif
      if (!save.boolean()) then
        SAVEWORK
      endif
    endif
    UPDATE $!update SHOW CHANGES $!nowait
    handle any
      !!alert.error(!!error.text)
    endhandle

-- Testing
--  write 'UPDATE $!update SHOW CHANGES' $!nowait

  endif

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      .upDown()
--
-- Description: Raise and lower the gadget values
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .upDown(!gadget is GADGET, !dir is STRING, !type is STRING)

  -- Initialise variables
  if (!type.eq('HOUR')) then
    !max = 23
    !min = 0
  elseif (!type.eq('MINS')) then
    !max = 59
    !min = 0
  elseif (!type.eq('YEAR')) then
    !max = !this.currDate.year()
    !min = 1996
  endif

  -- Calculate new value
  if (!dir.eq('UP')) then
    if (!gadget.val.real().eq(!max)) then
      !value = !min
    else
      !value = !gadget.val.real() + 1
    endif
  else
    if (!gadget.val.real().eq(!min)) then
      !value = !max
    else
      !value = !gadget.val.real() - 1
    endif
  endif

  -- Display value
  if (!type.eq('YEAR')) then
    !gadget.val = !value
  else
    !gadget.val = !this.zero(!value.string())
  endif

  -- Store new date/time
  !this.storeDate()

  -- Select any relevant stamp
  !this.selectStamp()

endmethod
-- End of method definition for .upDown()

------------------------------------------------------------------------
--
-- Method:      .zero(STRING)
--
-- Description: Tests if a hour or minute value requires a leading zero
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value to be tested
-- Return:
--   [Data Type] [Description]
--    STRING      Returned string
--
------------------------------------------------------------------------
-- Define method
define method .zero(!string is STRING) is STRING

  -- Is a leading zero required?
  if (!string.length().eq(1)) then
    !value = '0' & !string
  else
    !value = !string
  endif
  return !value

endmethod
-- End of method definition for .zero(STRING)
