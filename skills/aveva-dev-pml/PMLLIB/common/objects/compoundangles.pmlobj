-- File:            compoundangles.pmlobj
--   Type:          Object Definition
--   Group:
--
--     Keyword:     Compound Angles Orientation
--   Module:        General
--   Replaces:
--
-- Author:          Neil.Holmes
-- Created:         Saturday Jan 20 10:00:00 GMT 2007
--
-- Description:
--   Used to convert angles to/form orientations
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angles()                         ARRAY               Derive the angles from the current orientation and plane
--  angles(ORIENTATION,PLANE)        ARRAY               Derive the angles from the current orientation and plane
--  compoundAngles(ORIENTATION)      -                   Constructor
--
------------------------------------------------------------------------

define object COMPOUNDANGLES

  -- Orientation
  member .orientation     is ORIENTATION

  -- Plane (should be horizontal plane of orientation)
  member .plane           is PLANE

  -- Angles
  member .nAngle          is REAL
  member .hAngle          is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      compoundAngles
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .compoundAngles(!orientation is ORIENTATION)

  -- Angles
  !this.angles(!orientation, object PLANE(N0, Y is N))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      angles
--
-- Description: Derive the angles from the current orientation and plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .angles() is ARRAY
  return !this.angles(!this.orientation, !this.plane)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      angles
--
-- Description: Derive the angles from the current orientation and plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .angles(!orientation is ORIENTATION, !plane is PLANE) is ARRAY

  -- Set form members
  !this.orientation = !orientation
  !this.plane       = !plane

  -- Initialise Variables
  !angles           = ARRAY()
  !yDirection       = !orientation.yDir()
  !xDirection       = !orientation.xDir()
  !planeNorth       = !plane.orientation.yDir()
  !planeDirection   = !plane.direction()

  -- Handle Vertical North to reference plane
  if(!yDirection.isParallel(!planeDirection)) then
    !angles[2]      = 90

    -- Set sign of angle
    if(!yDirection.angle(!planeDirection).neq(0)) then
      !angles[2]    = -90
    endif

    -- Determine angle from N using the opposite of the Z of the orientation
    !yDirection     = !orientation.zDir().opposite()

  endif

  -- Determine angle from North (anti-clock-wise is positive)
  -- Map north vector on to plane
  !nMapped        = !yDirection.projected(!plane)
  !angles[1]      = !nMapped.angle(!planeNorth)

  -- If mapped direction and plan direction are not parallel
  -- set the sign of the angle
  if(!nMapped.isParallel(!planeNorth).not()) then
    if(!plane.direction().angle(!planeNorth.orthogonal(!nMapped)).neq(0)) then
      !angles[1]  = !angles[1] * -1
    endif
  endif

  -- Determine angle from horizontal if not set
  if(undefined(!angles[2])) then
    !angles[2]    = !nMapped.angle(!yDirection)

    -- Angle from horizontal greater than zero
    if(!angles[2].gt(0)) then

    if(!xDirection.angle(!yDirection.orthogonal(!nMapped)).eq(0)) then
      !angles[2]  = !angles[2] * -1
    endif

  endif
  endif
  -- Set results
  !this.nAngle    = !angles[1]
  !this.hAngle    = !angles[2]

  -- Return
  return !angles

endmethod
-- End of method
