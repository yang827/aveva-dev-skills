--
-- Description:
-- Repeat definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   clear the definition
--  comRepeat()                      -                   Constructor
--  comRepeat(DBREF)                 -                   Constructor - builds repeat object from given DBREF
--  getRepeatDefinition()            -                   Sets this object to an existing repeat definition element
--  owner(DBREF)                     -                   Set owner (TMRPSE) of repeat element to be created
--  save()                           -
--

define object COMREPEAT

  -- Repeat definition Element
  member .element             is DBREF
  -- Repeat Set containing the Repeat element
  member .repeatSet           is DBREF
  -- Element to be repeated
  member .repeatElement       is DBREF
  -- Number of repeats rule
  member .numberRule          is STRING
  -- Maximum Number of Repeats
  member .maxNumber           is REAL
  -- Repeat type
  member .repeatType          is STRING
  -- For Cartesian (DELT) repeat
  member .xOffset             is REAL
  member .yOffset             is REAL
  member .zOffset             is REAL
  member .xOffsetRule         is ATTRIBUTERULE
  member .yOffsetRule         is ATTRIBUTERULE
  member .zOffsetRule         is ATTRIBUTERULE
  -- For Linear (LINE) repeat
  member .offsetDistance      is REAL
  member .offsetDirection     is DIRECTION
  member .offsetDistanceRule  is ATTRIBUTERULE
  member .offsetDirectionRule is ATTRIBUTERULE
  -- For radial (RADI) repeat
  member .radius              is REAL
  member .angle               is REAL
  member .origin              is POSITION
  member .axisDirection       is DIRECTION
  member .rotateElement       is BOOLEAN
  member .radiusRule          is ATTRIBUTERULE
  member .angleRule           is ATTRIBUTERULE
  member .originRule          is ATTRIBUTERULE
  member .axisDirectionRule   is ATTRIBUTERULE
  -- Repeat description
  member .description         is STRING
  member .purpose             is STRING
  -- Element to own repeats
  member .masterOwner         is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      comRepeat
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comRepeat()

  -- Initialise Variables
  !this.clear()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      comRepeat
--
-- Description: Constructor - builds repeat object from given DBREF
--              DBREF can be to a TMRREL element or to an element
--              to be repeated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference of repeat definition or repeated element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comRepeat(!item is DBREF)

  -- Initialise Variables
  !this.clear()
  if( badref(!item) ) then
    return error 1 'Bad repeat object reference'
  endif

  if(!item.hardtype eq 'TMRREL') then

    -- At repeat definition element
    !this.element = !item
    !this.getRepeatDefinition()

  else

    -- Should be at a target element
    !repeatPointerAttrib = 'TMRREF'
    if( !item.attlis.findFirst(!repeatPointerAttrib).unset() ) then
      return error 2 'Not a repeatable element'
    endif
    !this.repeatElement = !item
    if( not badref( !item.tmrref ) ) then
      -- this element already has a repeat defined
      !this.element = !item.tmrref
      !this.getRepeatDefinition()
    endif

  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getRepeatDefinition
--
-- Description: Sets this object to an existing repeat definition element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRepeatDefinition()

  -- Load data from TMRREL element
 !this.owner(!this.element.owner)
  -- reference to repeat element
  if( not badref(!this.element.tmrmas) ) then
    !this.repeatElement = !this.element.tmrmas
  endif
  -- reference to owner of repeated elements - by default owner of repeat element
  if( not badref(!this.element.tmrown) ) then
    !this.masterOwner = !this.element.tmrown
  else
    if( not badref(!this.repeatElement) ) then
      !this.masterOwner = !this.repeatElement.owner
    endif
  endif
  -- number of elements
  !!ce = !this.element
  VAR !rule TMRRUL
  !this.numberRule = !rule
  -- repeat type
  !type = !this.element.offtyp
  if( !type eq 'DELT' ) then
    !this.repeatType = 'CARTESIAN'
  elseif( !type eq 'LINE' ) then
    !this.repeatType = 'LINEAR'
  elseif( !type eq 'RADI' ) then
    !this.repeatType = 'RADIAL'
  endif
  if(!this.repeatType.empty()) then
    -- nothing to do if type not set
    return
  endif
  -- get repeat properties for repeat type
  if( !this.repeatType eq 'CARTESIAN' ) then
    !this.xOffset = !this.element.deltae
    !this.yOffset = !this.element.deltan
    !this.zOffset = !this.element.deltau
    !this.xOffsetRule.getRule(!this.element,'DELTAE')
    !this.yOffsetRule.getRule(!this.element,'DELTAN')
    !this.zOffsetRule.getRule(!this.element,'DELTAU')
    -- get rules if any set
  elseif( !this.repeatType eq 'LINEAR' ) then
    !this.offsetDistance      = !this.element.offdis
    !this.offsetDirection     = !this.element.offdir
    !this.offsetDistanceRule.getRule(!this.element,'OFFDIS')
    !this.offsetDirectionRule.getRule(!this.element,'OFFDIR')
  elseif( !this.repeatType eq 'RADIAL' ) then
    !this.radius              = !this.element.offdis
    !this.angle               = !this.element.delang
    !this.origin              = !this.element.axipos
    !this.axisDirection       = !this.element.axidir
    !this.rotateElement       = !this.element.rorien
    !this.radiusRule.getRule(!this.element,'OFFDIS')
    !this.angleRule.getRule(!this.element,'DELANG')
    !this.originRule.getRule(!this.element,'AXIPOS')
    !this.axisDirectionRule.getRule(!this.element,'AXIDIR')
  endif
  -- get other attributes
  !this.description = !this.element.description
  !this.purpose     = !this.element.purpose

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: clear the definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Repeat TMRREL element
  !this.element             = object DBREF()
  -- Repeat TMRPSE element
  !this.repeatSet           = object DBREF()
  -- Element to be repeated
  !this.repeatElement       = object DBREF()
  -- Number of repeats rule
  !this.numberRule          = ''
  -- Maximum Number of Repeats
  !this.maxNumber           = 100
  -- Repeat type
  !this.repeatType          = ''
  -- For Cartesian (DELT) repeat
  !this.xOffset             = 0
  !this.yOffset             = 0
  !this.zOffset             = 0
  !this.xOffsetRule         = object ATTRIBUTERULE()
  !this.yOffsetRule         = object ATTRIBUTERULE()
  !this.zOffsetRule         = object ATTRIBUTERULE()
  -- For Linear (LINE) repeat
  !this.offsetDistance      = 0
  !this.offsetDirection     = object DIRECTION('U WRT WORLD')
  !this.offsetDistanceRule  = object ATTRIBUTERULE()
  !this.offsetDirectionRule = object ATTRIBUTERULE()
  -- For radial (RADI) repeat
  !this.radius              = 0
  !this.angle               = 0
  !this.origin              = object POSITION('E0N0U0 WRT WORLD')
  !this.axisDirection       = object DIRECTION('U WRT WORLD')
  !this.rotateElement       = false
  !this.radiusRule          = object ATTRIBUTERULE()
  !this.angleRule           = object ATTRIBUTERULE()
  !this.originRule          = object ATTRIBUTERULE()
  !this.axisDirectionRule   = object ATTRIBUTERULE()
  -- Repeat description
  !this.description         = ''
  !this.purpose             = ''
  -- Element to own repeats
  !this.masterOwner         = object DBREF()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      owner
--
-- Description: Set owner (TMRPSE) of repeat element to be created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .owner(!repeatOwner is DBREF)

  if( not badref(!repeatOwner) ) then
    !this.repeatSet = !repeatOwner
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      saveRepeatDefinition
--
-- Description: Save repeat definition to DB
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()

  -- Create TMRREL element if required
  if( badref(!this.element) ) then
    if( badref(!this.repeatSet) ) then
      -- need to create a repeat set
      return error 2 'Repeat set element not found'
    else
      -- repeat element does not exist, but repeat set does exist
      !!ce = !this.repeatSet
      NEW TMRREL
      !this.element = !!ce
    endif
  else
    -- repeat definition element already exists
    !this.repeatSet = !this.element.owner
  endif

  -- reference to repeat element
  if( not badref(!this.repeatElement) ) then
    -- set back pointer from element to repeat definition
     !this.repeatElement.tmrref = !this.element
     -- set forward pointer from repeat definition to element
     !this.element.tmrmas       = !this.repeatElement
  endif

  -- reference to owner of repeated elements - by default owner of repeat element
  if( not badref(!this.element.tmrown) ) then
    !this.element.tmrown =  !this.masterOwner
  else
    !this.element.tmrown =  !this.repeatElement.owner
  endif

  -- number of elements
  !!ce = !this.element
  !rule = !this.numberRule
  TMRRUL $!<rule>

  -- repeat type
  if( !this.repeatType eq 'CARTESIAN' ) then
    !this.element.offtyp = 'DELT'
  elseif( !this.repeatType eq 'LINEAR' ) then
    !this.element.offtyp = 'LINE'
  elseif( !this.repeatType eq 'RADIAL' ) then
    !this.element.offtyp = 'RADI'
  endif

  -- get repeat properties for repeat type
  if( !this.repeatType eq 'CARTESIAN' ) then
    !this.element.deltae = !this.xOffset
    !this.element.deltan = !this.yOffset
    !this.element.deltau = !this.zOffset
--    !this.xOffsetRule.getRule(!this.element,'DELTAE')
--    !this.yOffsetRule.getRule(!this.element,'DELTAN')
--    !this.zOffsetRule.getRule(!this.element,'DELTAU')
    -- get rules if any set
  elseif( !this.repeatType eq 'LINEAR' ) then
    !this.element.offdis = !this.offsetDistance
    !this.element.offdir = !this.offsetDirection
--    !this.offsetDistanceRule.getRule(!this.element,'OFFDIS')
--    !this.offsetDirectionRule.getRule(!this.element,'OFFDIR')
  elseif( !this.repeatType eq 'RADIAL' ) then
    !this.element.offdis = !this.radius
    !this.element.delang = !this.angle
    !this.element.axipos = !this.origin
    !this.element.axidir = !this.axisDirection
    !this.element.rorien = !this.rotateElement
--    !this.radiusRule.getRule(!this.element,'OFFDIS')
--    !this.angleRule.getRule(!this.element,'DELANG')
--    !this.originRule.getRule(!this.element,'AXIPOS')
--    !this.axisDirectionRule.getRule(!this.element,'AXIDIR')
  endif
  -- get other attributes
  !this.element.description = !this.description
  !this.element.purpose     = !this.purpose

endmethod
-- End of function definition
