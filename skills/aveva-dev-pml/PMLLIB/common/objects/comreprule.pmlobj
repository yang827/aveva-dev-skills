--
-- Description:
-- Representation rule
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arcTolerance()                   REAL                Return arcTolerance
--  branchMemberFlag()               BOOLEAN             Return branch member flag
--  centreline()                     BOOLEAN             Return centreline
--  checkExpression(STRING)          EXPRESSION          Check expression string
--  colour()                         REAL                Return colour
--  colourName()                     STRING              Return colour name
--  comRepRule(STRING)               -                   Constructor with tilde separated string
--  comRepRule(STRING,EXPRESSION,REAL,BOOLEAN,BOOLEAN,STRING,STRING,REAL,REAL,EXPRESSION,STRING,BOOLEAN) -
--  comRepRule(STRING,STRING,REAL,BOOLEAN,BOOLEAN,STRING,STRING,REAL,REAL,STRING,STRING,BOOLEAN) -
--  drawlistMemberType()             STRING              Return drawlist member type
--  evaluateDrawlist(ARRAY,ARRAY)    ARRAY               Get applicable members of drawlist, e.g. pipes
--  evaluateMembers(ARRAY,ARRAY)     ARRAY               Get applicable members of members of drawlist, e.g. instruments
--  expression()                     STRING              Return expression
--  gtype()                          STRING              Return gtype
--  insulation()                     STRING              Return gtype
--  level()                          REAL                Return gtype
--  matchingExpression()             STRING              Return matching expression
--  obstruction()                    STRING              Return obstruction
--  output()                         STRING              Output rule as string
--  ruleData()                       ARRAY               Output rule as array of strings excluding last two members
--  stringRep(BOOLEAN)               STRING              Convert boolean to string On or Off
--  tube()                           BOOLEAN             Return tube
--
------------------------------------------------------------------------

define object COMREPRULE

  member .gtype               is STRING
  member .expression          is EXPRESSION
  member .colour              is REAL
  member .tube                is BOOLEAN
  member .centreline          is BOOLEAN
  member .insulation          is STRING
  member .obstruction         is STRING
  member .level               is REAL
  member .arcTolerance        is REAL
  member .referenceExpression is EXPRESSION
  member .drawlistMemberType  is STRING
  member .branchMemberFlag    is BOOLEAN

endobject

--NB there is likely to be problem with arctolerance and units since no regard seems to be taken of
--   current units in the rule.

------------------------------------------------------------------------
-- Method:      comRepRule
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype, e.g. PIPE, EQUI, HVAC, INST or STRU
--    2   R      EXPRESSION  Expression, e.g. bore gt 50mm
--    3   R      REAL        Colour
--    4   R      BOOLEAN     Tube
--    5   R      BOOLEAN     Centreline
--    6   R      STRING      Insulation translucency, e.g. Off, Solid, 12%, 25%, 50%, 75%, or 87%
--    7   R      STRING      Obstruction translucency, e.g. Off, Solid, 12%, 25%, 50%, 75%, or 87%
--    8   R      REAL        Level, e.g. 6
--    9   R      REAL        Arc Tolerance, e.g. 10mm
--   10   R      EXPRESSION  Expression to return reference of gtype, e.g. refn of owner, refn for branch member
--   11   R      STRING      Drawlist member type, e.g. BRAN
--   12   R      BOOLEAN     Branch member flag, e.g. true for INST
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .comRepRule(!gtype is STRING, !expression is EXPRESSION, !colour is REAL, !tube is BOOLEAN, !centreline is BOOLEAN, !insulation is STRING, !obstruction is STRING, !level is REAL, !arcTolerance is REAL, !referenceExpression is EXPRESSION, !drawlistMemberType is STRING, !branchMemberFlag is BOOLEAN)

  -- Constructor
  !this.gtype               = !gtype
  !this.expression          = !expression
  !this.colour              = !colour
  !this.tube                = !tube
  !this.centreline          = !centreline
  !this.insulation          = !insulation
  !this.obstruction         = !obstruction
  !this.level               = !level
  !this.arcTolerance        = !arcTolerance
  !this.referenceExpression = !referenceExpression
  !this.drawlistMemberType  = !drawlistMemberType
  !this.branchMemberFlag    = !branchMemberFlag

endmethod

------------------------------------------------------------------------
-- Method:      comRepRule
--
-- Description:
--   Constructor with expression strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
--    2   R      STRING      Expression
--    3   R      REAL        Colour
--    4   R      BOOLEAN     Tube
--    5   R      BOOLEAN     Centreline
--    6   R      STRING      Insulation translucency
--    7   R      STRING      Obstruction translucency
--    8   R      REAL        Level
--    9   R      REAL        Arc Tolerance
--   10   R      STRING      Expression to return reference of gtype
--   11   R      STRING      Drawlist member type
--   12   R      BOOLEAN     Branch member flag
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .comRepRule(!gtype is STRING, !expression is STRING, !colour is REAL, !tube is BOOLEAN, !centreline is BOOLEAN, !insulation is STRING, !obstruction is STRING, !level is REAL, !arcTolerance is REAL, !referenceExpression is STRING, !drawlistMemberType is STRING, !branchMemberFlag is BOOLEAN)

  -- Constructor with expression strings
  !this.comRepRule(!gtype, !this.checkExpression(!expression), !colour, !tube, !centreline, !insulation, !obstruction, !level, !arcTolerance, !this.checkExpression(!referenceExpression), !drawlistMemberType, !branchMemberFlag)

endmethod

------------------------------------------------------------------------
-- Method:      comRepRule
--
-- Description:
--   Constructor with tilde separated string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Tilde separated string rule data (as loaded from file)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .comRepRule(!input is STRING)

  -- Constructor with tilde separated string
  !data = !input.split(|~|)
  if (!data.size() ne 12) then
    return error 1 |Rule data is invalid and cannot be loaded|
  endif
  !this.comRepRule(!data[1], !this.checkExpression(!data[2]), real(!data[3], !!integerFmt), !data[4].boolean(), !data[5].boolean(), !data[6], !data[7], real(!data[8], !!integerFmt), real(!data[9], !!distanceFmt), !this.checkExpression(!data[10]), !data[11], !data[12].boolean())

endmethod

------------------------------------------------------------------------
-- Method:      gtype
--
-- Description:
--   Return gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Gtype
------------------------------------------------------------------------
define method .gtype() is STRING

  -- Output member
  return !this.gtype

endmethod

------------------------------------------------------------------------
-- Method:      expression
--
-- Description:
--   Return expression
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Expression
------------------------------------------------------------------------
define method .expression() is STRING

  -- Output member
  return !this.expression.string()

endmethod

------------------------------------------------------------------------
-- Method:      colour
--
-- Description:
--   Return colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
