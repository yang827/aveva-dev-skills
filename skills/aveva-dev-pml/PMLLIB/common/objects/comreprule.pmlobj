------------------------------------------------------------------------
define method .colour() is REAL

  -- Output member
  return !this.colour

endmethod

------------------------------------------------------------------------
-- Method:      colourName
--
-- Description:
--   Return colour name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING        Colour name
------------------------------------------------------------------------
define method .colourName() is STRING

  -- Output colour name
  !colourName = !!colourName(!this.colour)
  handle any
    -- If colour is not a named colour then default to colour 1 grey
    !colourName = !!colourName(1)
  endhandle
  return !colourName

endmethod

