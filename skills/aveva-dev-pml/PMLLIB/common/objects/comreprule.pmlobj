------------------------------------------------------------------------
-- Method:      stringRep
--
-- Description:
--   Convert boolean to string On or Off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Value to be converted
-- Return:
--   [Data Type] [Description]
--    STRING      On or Off
------------------------------------------------------------------------
define method .stringRep(!value is BOOLEAN) is STRING

  -- Output string
  !data = |Off|
  if (!value.set()) then
    if (!value) then
      !data = |On|
    endif
  endif
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      checkExpression
--
-- Description:
--   Check expression string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String expression to be checked
-- Return:
--   [Data Type] [Description]
--    EXPRESSION  Checked expression
------------------------------------------------------------------------
define method .checkExpression(!expression is STRING) is EXPRESSION

  -- Test rule expression
  !ruleExpression = object EXPRESSION()
  if (!expression.trim() ne ||) then
    !ruleExpression = object EXPRESSION(!expression)
    handle(2,849)
      -- Invalid expression string
    endhandle
  endif
  return !ruleExpression

endmethod

------------------------------------------------------------------------
-- Method:      ruleData
--
-- Description:
--   Output rule as array of strings excluding last two members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of strings to populate list row
------------------------------------------------------------------------
define method .ruleData() is ARRAY

  -- Output data as array of strings excluding last two members
  !data = ARRAY()
  if (!this.set()) then
    !data.append(!this.gtype)
    !data.append(!this.expression.string())
    !data.append(!this.colourName())
    !data.append(!this.stringRep(!this.tube))
    !data.append(!this.stringRep(!this.centreline))
    !data.append(!this.insulation)
    !data.append(!this.obstruction)
    !data.append(!this.level.string(!!integerFmt))
    !data.append(!this.arcTolerance.string(!!distanceFmt))
  endif
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      output
--
-- Description:
--   Output rule as string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      String to print or save to file
------------------------------------------------------------------------
define method .output() is STRING

  -- Output data as string
  !data = ||
  if (!this.set()) then
    !data = !this.gtype & |~| & !this.expression.string() & |~| & !this.colour.string(!!integerFmt) & |~| & !this.stringRep(!this.tube) & |~| & !this.stringRep(!this.centreline) & |~| & !this.insulation & |~| & !this.obstruction & |~| & !this.level.string(!!integerFmt) & |~| & !this.arcTolerance.string(!!distanceFmt) & |~| & !this.referenceExpression.string() & |~| & !this.drawlistMemberType & |~| & !this.branchMemberFlag
  endif
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      evaluateDrawlist
--
-- Description:
--   Get applicable members of drawlist, e.g. pipes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Drawlist members as strings
--    2   RW     ARRAY       Flags of members of drawlist already done
-- Return:
--   [Data Type] [Description]
--    ARRAY       Indices of members of drawlist to which rule should be applied
------------------------------------------------------------------------
define method .evaluateDrawlist(!drawlist is ARRAY, !doneIndices is ARRAY) is ARRAY

  -- Initialise
  !applicableIndices = ARRAY()

  -- Rule is for drawlist members or reference thereof, e.g. PIPE, HVAC, EQUI, STRU
  if (!this.branchMemberFlag.not()) then
    -- Evaluate type for drawlist members, done this way for performance better than in loops
    var !elementTypeTest evaluate (match (|$!<this.drawlistMemberType>|,type) gt 0 ) for all from !drawlist ignore any |false|

    -- Evaluate reference expression for drawlist members
    var !worldRef refn of world
    var !matches evaluate ($!<this.referenceExpression>) for all from !drawlist ignore any |$!<worldRef>|

    -- Evaluate match on gtype for allowed drawlist members
    var !gtypeTest evaluate (type eq |$!<this.gtype>|) for all from !matches ignore any |false|

   -- Evaluate expression against matched allowed drawlist members, unset expression means always true
     if (!this.expression.set()) then
      var !expressionTest evaluate ($!<this.expression>) for all from !matches ignore any |false|
    else
      var !expressionTest evaluate (true) for all from !matches
    endif

    -- Evaluate match on gtype for elements in drawlist
    var !gtypeInDrawlistTest evaluate (type eq |$!<this.gtype>|) for all from !drawlist

    -- Get indices of applicable drawlist members that have not been done, and update done indices
    -- Special for items below FRMW and CWALL SBFR PIPE etc elements as they are not stored in the draw list
    VAR !topf noundef $!this.gtype TOPF
    !notTOPF = !topf[1].boolean().not()
    do !i indices !drawlist
      -- Not TOPF elements expanded to their members but these are also members of other valid gtypes so need to be overridden
      if (!doneIndices[!i] ) then
      	if (!notTOPF) then
        	!drawitem = object DBREF(!drawlist[!i])
        	-- cancel doneness of all drawlist items whose type matches members of this rule
        	!doneIndices[!i] = ( !this.drawlistMemberType().match(!drawitem.type) eq 0 )
        else
        	-- cancel doneTRUEs if drawlist item type matches the rule type (gtypeinDrawlistTest TRUE) as this indicates has been done by
        	-- rule on higher level administrative item and may need to do again by subsidiary rule
        	-- To allow BRAN rules following PIPE rules to get executed, and if before complains about wrong order
        	!doneIndices[!i] = !gtypeInDrawlistTest[!i].boolean().not()
        endif
      endif
      	
      if (!doneIndices[!i].not() and !elementTypeTest[!i].boolean() and !gtypeTest[!i].boolean() and !expressionTest[!i].boolean()) then
        !applicableIndices.append(!i)
        !doneIndices[!i] = TRUE
      endif
    enddo

  endif
  return !applicableIndices

endmethod

------------------------------------------------------------------------
-- Method:      evaluateMembers
--
-- Description:
--   Get applicable members of members of drawlist, e.g. instruments
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Drawlist members as strings
--    2   RW     ARRAY       Members of members of drawlist already done
-- Return:
--   [Data Type] [Description]
--    ARRAY       Members of members of drawlist to which rule should be applied
------------------------------------------------------------------------
define method .evaluateMembers(!drawlist is ARRAY, !doneMembers is ARRAY) is ARRAY

  -- Initialise
  !applicableMembers = ARRAY()
  !testedMembers     = ARRAY()

  -- Rule is for members of drawlist members, e.g. INST
  if (!this.branchMemberFlag) then

    -- Evaluate type for drawlist members, done this way for performance better than in loops
    var !elementTypeTest evaluate (match (|$!<this.drawlistMemberType>|,type) gt 0 ) for all from !drawlist ignore any |false|

    -- Loop through drawlist members to process their members
    do !i indices !drawlist

      -- Ignore drawlist members that do not match on type
      skip if (!elementTypeTest[!i].boolean().not())

      -- Collect members of drawlist members that match on gtype
      var !members collect members of $!drawlist[$!i] with (type eq |$!<this.gtype>|)

      -- Evaluate expression against members of drawlist members, unset expression means always true
      if (!this.expression.set()) then
        var !expressionTest evaluate ($!<this.expression>) for all from !members ignore any |false|
      else
        var !expressionTest evaluate (true) for all from !members
      endif

      -- Get elements that this rule applies to
      do !j indices !members
        if (!expressionTest[!j].boolean()) then
          !testedMembers.append(!members[!j].dbref())
        endif
      enddo

    enddo

    -- Get applicable members that have not been done, and update done members
    !applicableMembers = !testedMembers.difference(!doneMembers)
    !doneMembers.appendArray(!applicableMembers)

  endif
  return !applicableMembers

endmethod
