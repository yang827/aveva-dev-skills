-- Created:         Mon Jan 05   11:38:01  2009
--
-- Description:
-- Representation rule
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING,STRING,REAL,BOOLEAN,BOOLEAN,STRING,STRING,REAL,REAL) -                   Add a rule to the set
--  addOnlyToDrawlist(ARRAY,REAL)    -                   Add members to drawlist
--  addToDrawlist(ARRAY,ARRAY,REAL)  -                   Add elements to drawlist
--  allowableGtypes()                ARRAY               Return allowable gtypes
--  apply()                          -                   Apply rule set to current drawlist
--  arcTolerance(REAL)               REAL                Return arc tolerance of selected rule
--  centreline(REAL)                 BOOLEAN             Return centreline of selected rule
--  colour(REAL)                     REAL                Return colour of selected rule
--  comRepRuleSet()                  -                   Constructor
--  currentFilename()                STRING              Return current filename
--  directory()                      STRING              Determine project defaults folder name
--  drawlist()                       ARRAY               Get current drawlist members
--  expression(REAL)                 STRING              Return expression of selected rule
--  getDrawlistToken()               -                   Get current view drawlist token if available
--  gtype(REAL)                      STRING              Return gtype of selected rule
--  indexValid(REAL)                 BOOLEAN             Check passed index into rules array is valid
--  insulation(REAL)                 STRING              Return insulation of selected rule
--  level(REAL)                      REAL                Return level of selected rule
--  load()                           -                   Load rules from the first file found to exist
--  load(FILE)                       -                   Load rules from specified file location
--  loadSettings()                   -                   Load settings
--  lookUpExpression(STRING)         STRING              Look up matching expression for Gtype
--  lookUpMember(STRING)             BOOLEAN             Look up branch member flag for Gtype
--  lookUpType(STRING)               STRING              Look up member type for Gtype
--  obstruction(REAL)                STRING              Return obstruction of selected rule
--  output()                         ARRAY               Output rules as array of strings
--  print()                          -                   Print rules to screen
--  remove(REAL)                     -                   Remove a rule from the set
--  removeFromDrawlist(ARRAY,ARRAY)  -                   Remove element from drawlist
--  removeOnlyFromDrawlist(ARRAY)    -                   Remove members from drawlist
--  reorder(REAL,REAL)               -                   Reorder the rules
--  replace(REAL,STRING,STRING,REAL,BOOLEAN,BOOLEAN,STRING,STRING,REAL,REAL) -
--  resetDisplay()                   -                   Reset display to global default representation
--  resetRepresentation()            -                   Reset representation to defaults using drawlist object if available
--  ruleData()                       ARRAY               Output rules as array of array of strings
--  ruleOrderCheck()                 -                   Check rule order for, e.g. INST rule ahead of PIPE rule
--  save(FILE)                       -                   Save rules to file
--  saveSettings()                   -                   Save settings
--  setRepresentation(COMREPRULE)    -                   Set representation settings
--  translucencySettings()           ARRAY               Return translucency settings
--  tube(REAL)                       BOOLEAN             Return tube of selected rule
--  unsavedChanges()                 BOOLEAN             Return unsaved changes flag
--
------------------------------------------------------------------------

define object COMREPRULESET

  member .allowableGtypes      is ARRAY
  member .drawlistMemberTypes  is ARRAY
  member .referenceExpressions is ARRAY
  member .branchMemberFlags    is ARRAY
  member .translucencySettings is ARRAY
  member .rules                is ARRAY
  member .unsavedChanges       is BOOLEAN
  member .drawlistToken        is REAL
  member .currentFilename      is STRING

endobject

------------------------------------------------------------------------
-- Method:      comRepRuleSet
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .comRepRuleSet()

  -- Initialise
  !this.unsavedChanges  = FALSE
  !this.drawlistToken   = 0
  !this.currentFilename = ||

  -- Allowable Gtypes
  !this.allowableGtypes = ARRAY()
  !this.allowableGtypes.append(|PIPE|)
  !this.allowableGtypes.append(|BRAN|)
  !this.allowableGtypes.append(|CWBRAN|)
  !this.allowableGtypes.append(|EQUI|)
  !this.allowableGtypes.append(|SUBE|)

  !this.allowableGtypes.append(|NOZZ|)
  !this.allowableGtypes.append(|HVAC|)
  !this.allowableGtypes.append(|INST|)
  !this.allowableGtypes.append(|VALV|)
  !this.allowableGtypes.append(|CWAY|)

  !this.allowableGtypes.append(|STRU|)
  !this.allowableGtypes.append(|FRMW|)
  !this.allowableGtypes.append(|SBFR|)
  !this.allowableGtypes.append(|CWALL|)
  !this.allowableGtypes.append(|STWALL|)

  !this.allowableGtypes.append(|GWALL|)
  !this.allowableGtypes.append(|CFLOOR|)
  !this.allowableGtypes.append(|FLOOR|)
  !this.allowableGtypes.append(|DETGRP|)

  -- Drawlistmembertypes to be processed against Gtypes
  -- IF GTYPE is a toplevel object
  --   THEN this is a copy of the GTYPE
  -- ELSE GTYPE is nontoplevel THEN
  --   IF  administrative (i.e. owns toplevel elements)
  --     THEN this is list of all known toplevel elements GTYPE can own (e.g. PIPE owns BRAN)
  --   ELSE NOT administrative
  --     THEN this is list of all possible toplevel owners (e.g. EQUI/SUBE own NOZZ)
  --   ENDIF
  -- ENDIF
-- therefore if branchmember is false, these are either ownertypes, or own type
  !this.drawlistMemberTypes = ARRAY()
  !this.drawlistMemberTypes.append(|BRAN|)
  !this.drawlistMemberTypes.append(|BRAN|)
  !this.drawlistMemberTypes.append(|CWBRAN|)
  !this.drawlistMemberTypes.append(|EQUI|)
  !this.drawlistMemberTypes.append(|SUBE|)

  !this.drawlistMemberTypes.append(|EQUI SUBE|)
  !this.drawlistMemberTypes.append(|BRAN|)
  !this.drawlistMemberTypes.append(|BRAN|)
  !this.drawlistMemberTypes.append(|BRAN|)
  !this.drawlistMemberTypes.append(|CWBRAN|)

  !this.drawlistMemberTypes.append(|STRU|)
  !this.drawlistMemberTypes.append(|STWALL GWALL SCTN GENSEC PANE WALL FIXING PALJ PNOD FLOOR SCREED|)
  !this.drawlistMemberTypes.append(|STWALL GWALL SCTN GENSEC PANE WALL FIXING PALJ PNOD FLOOR SCREED|)
  !this.drawlistMemberTypes.append(|STWALL GWALL SCTN GENSEC PANE WALL FIXING PALJ PNOD|)
  !this.drawlistMemberTypes.append(|STWALL|)

  !this.drawlistMemberTypes.append(|GWALL|)
  !this.drawlistMemberTypes.append(|FLOOR SCTN GENSEC SCREED PANE|)
  !this.drawlistMemberTypes.append(|FLOOR|)
  !this.drawlistMemberTypes.append(|AREADE BNDLIN CLNPNG ELFITT FPFITT HVACFI INFITT PANE CTWALL DOOR FIXTUR FLRCOV FURNIT HANDRA INSURQ LADDER WINDOW|)

  -- Expressions to return references of Gtypes from drawlist members, these should return a dbref
  !this.referenceExpressions = ARRAY()
  !this.referenceExpressions.append(|refn of PIPE|)
  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn|)

  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn of HVAC|)
  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn of CWAY|)

  !this.referenceExpressions.append(|refn of STRU|)
  !this.referenceExpressions.append(|refn of FRMW|)
  !this.referenceExpressions.append(|refn of SBFR|)
  !this.referenceExpressions.append(|refn of CWALL|)
  !this.referenceExpressions.append(|refn|)

  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn of CFLOOR|)
  !this.referenceExpressions.append(|refn|)
  !this.referenceExpressions.append(|refn of DETGRP|)

  -- Flags for members of drawlist (TOPLEVEL) members, these should be a boolean
  -- if TRUE then GTYPE is not TOPLEVEL, nor owns TOPLEVEL, but under a TOPLEVEL
  !this.branchMemberFlags = ARRAY()
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)

  !this.branchMemberFlags.append(TRUE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(TRUE)
  !this.branchMemberFlags.append(TRUE)
  !this.branchMemberFlags.append(FALSE)

  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)

  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)
  !this.branchMemberFlags.append(FALSE)

  -- Translucency values for insulation and obstruction
  !this.translucencySettings = ARRAY()
  !this.translucencySettings.append(|Off|)
  !this.translucencySettings.append(|Solid|)
  !this.translucencySettings.append(|12%|)
  !this.translucencySettings.append(|25%|)
  !this.translucencySettings.append(|50%|)
  !this.translucencySettings.append(|75%|)
  !this.translucencySettings.append(|87%|)

endmethod

------------------------------------------------------------------------
-- Method:      ruleData
--
-- Description:
--   Output rules as array of array of strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of array of strings to populate list row
------------------------------------------------------------------------
define method .ruleData() is ARRAY

  -- Output data as array of array of strings
  !data = ARRAY()
  do !rule values !this.rules
    if (!rule.set()) then
      !data.append(!rule.ruleData())
    endif
  enddo
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      output
--
-- Description:
--   Output rules as array of strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of strings to print or save to file
------------------------------------------------------------------------
define method .output() is ARRAY

  -- Output data as array of array of strings
  !data = ARRAY()
  do !rule values !this.rules
    if (!rule.set()) then
      !data.append(!rule.output())
    endif
  enddo
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      print
--
-- Description:
--   Print rules to screen
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .print()

  -- Write out rules
  do !rule values !this.output()
    write !rule
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      unsavedChanges
--
-- Description:
--   Return unsaved changes flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Unsaved changes flag
------------------------------------------------------------------------
define method .unsavedChanges() is BOOLEAN

  -- Output member
  return !this.unsavedChanges

endmethod

