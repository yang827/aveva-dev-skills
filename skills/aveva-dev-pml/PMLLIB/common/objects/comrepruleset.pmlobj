------------------------------------------------------------------------
-- Method:      insulation
--
-- Description:
--   Return insulation of selected rule
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rule number
-- Return:
--   [Data Type] [Description]
--    STRING      Insulation
------------------------------------------------------------------------
define method .insulation(!index is REAL) is STRING

  -- Output member
  return !this.rules[!index].insulation()

