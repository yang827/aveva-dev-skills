--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rule number
-- Return:
--   [Data Type] [Description]
--    STRING      Gtype
------------------------------------------------------------------------
define method .gtype(!index is REAL) is STRING

  -- Output member
  return !this.rules[!index].gtype()

endmethod

