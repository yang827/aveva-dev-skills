------------------------------------------------------------------------
-- Method:      arcTolerance
--
-- Description:
--   Return arc tolerance of selected rule
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rule number
-- Return:
--   [Data Type] [Description]
--    REAL        Arc tolerance
------------------------------------------------------------------------
define method .arcTolerance(!index is REAL) is REAL

  -- Output member
  return !this.rules[!index].arcTolerance()

endmethod

------------------------------------------------------------------------
-- Method:      lookUpExpression
--
-- Description:
--   Look up matching expression for Gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
-- Return:
--   [Data Type] [Description]
--    STRING      Expression
------------------------------------------------------------------------
define method .lookUpExpression(!gtype is STRING) is STRING

  -- Look up reference expression
  !referenceExpression = ||
  !gtypeIndex = !this.allowableGtypes.findFirst(!gtype)
  if (!gtypeIndex.set()) then
    !referenceExpression = !this.referenceExpressions[!gtypeIndex]
  endif
  return !referenceExpression

endmethod

------------------------------------------------------------------------
-- Method:      lookUpType
--
-- Description:
--   Look up member type for Gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
-- Return:
--   [Data Type] [Description]
--    STRING      Type
------------------------------------------------------------------------
define method .lookUpType(!gtype is STRING) is STRING

  -- Look up member type
  !drawlistMemberType = ||
  !gtypeIndex = !this.allowableGtypes.findFirst(!gtype)
  if (!gtypeIndex.set()) then
    !drawlistMemberType = !this.drawlistMemberTypes[!gtypeIndex]
  endif
  return !drawlistMemberType

endmethod

------------------------------------------------------------------------
-- Method:      lookUpMember
--
-- Description:
--   Look up branch member flag for Gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Flag
------------------------------------------------------------------------
define method .lookUpMember(!gtype is STRING) is BOOLEAN

  -- Look up branch member flag
  !branchMemberFlag = FALSE
  !gtypeIndex = !this.allowableGtypes.findFirst(!gtype)
  if (!gtypeIndex.set()) then
    !branchMemberFlag = !this.branchMemberFlags[!gtypeIndex]
  endif
  return !branchMemberFlag

endmethod

------------------------------------------------------------------------
-- Method:      add
--
-- Description:
--   Add a rule to the set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
--    2   R      STRING      Expression
--    3   R      REAL        Colour
--    4   R      BOOLEAN     Tube
--    5   R      BOOLEAN     Centreline
--    6   R      STRING      Insulation translucency
--    7   R      STRING      Obstruction translucency
--    8   R      REAL        Level
--    9   R      REAL        Arc Tolerance
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .add(!gtype is STRING, !expression is STRING, !colour is REAL, !tube is BOOLEAN, !centreline is BOOLEAN, !insulation is STRING, !obstruction is STRING, !level is REAL, !arcTolerance is REAL)

  -- Add new rule
  !this.rules.append(object COMREPRULE(!gtype, !expression, !colour, !tube, !centreline, !insulation, !obstruction, !level, !arcTolerance, !this.lookUpExpression(!gtype), !this.lookUpType(!gtype), !this.lookUpMember(!gtype)))
  !this.unsavedChanges = TRUE

endmethod

------------------------------------------------------------------------
-- Method:      replace
--
-- Description:
--   Replace a rule in the set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index to be replaced
--    2   R      STRING      Gtype
--    3   R      STRING      Expression
--    4   R      REAL        Colour
--    5   R      BOOLEAN     Tube
--    6   R      BOOLEAN     Centreline
--    7   R      STRING      Insulation translucency
--    8   R      STRING      Obstruction translucency
--    9   R      REAL        Level
--   10   R      REAL        Arc Tolerance
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .replace(!index is REAL, !gtype is STRING, !expression is STRING, !colour is REAL, !tube is BOOLEAN, !centreline is BOOLEAN, !insulation is STRING, !obstruction is STRING, !level is REAL, !arcTolerance is REAL)

  -- Replace rule
  if (!this.indexValid(!index)) then
    !this.rules[!index] = object COMREPRULE(!gtype, !expression, !colour, !tube, !centreline, !insulation, !obstruction, !level, !arcTolerance, !this.lookUpExpression(!gtype), !this.lookUpType(!gtype), !this.lookUpMember(!gtype))
    !this.unsavedChanges = TRUE
  endif

endmethod

------------------------------------------------------------------------
-- Method:      remove
--
-- Description:
--   Remove a rule from the set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index to be removed
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .remove(!index is REAL)

  -- Add new rule
  if (!this.indexValid(!index)) then
    !this.rules.remove(!index)
    !this.unsavedChanges = TRUE
  endif

endmethod

------------------------------------------------------------------------
-- Method:      reorder
--
-- Description:
--   Reorder the rules
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Old index
--    2   R      REAL        New index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .reorder(!oldIndex is REAL, !newIndex is REAL)

  -- Remove rule and insert it at new position in array
  if (!this.indexValid(!oldIndex) and !this.indexValid(!newIndex)) then
    !rule = !this.rules.remove(!oldIndex)
    !this.rules.insert(!newIndex, !rule)
    !this.unsavedChanges = TRUE
  endif

endmethod

------------------------------------------------------------------------
-- Method:      indexValid
--
-- Description:
--   Check passed index into rules array is valid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if index is valid
------------------------------------------------------------------------
define method .indexValid(!index is REAL) is BOOLEAN

  -- Check index is valid for array
  return (!index gt 0 and !index le !this.rules.size())

endmethod

------------------------------------------------------------------------
-- Method:      ruleOrderCheck
--
-- Description:
--   Check rule order for, e.g. INST rule ahead of BRAN ahead of PIPE rules
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .ruleOrderCheck()

  -- Where it is possible from the stored datastructure
  -- Check for rule with same drawlist member type in wrong order for branch member flag
  do !i indices !this.rules
    -- Check for matching drawlist member type in rule with false branch member flag lower down
    do !j indices !this.rules
      skip if (!j le !i)
      if (!this.rules[!i].branchMemberFlag()) then
      	-- this tests that member non-toplevel elements (NOZZ, INST, VALV) rule above a direct toplevel owner (EQUI,BRAN) rule
      	-- also above other elements  that have members which are elements that VALV/INST are owned by
      	--    e.g. PIPE has BRAN members, VALVs are members of BRAN
      	--  (BUT would probably not work for ZONE or SITE)
        if (!this.rules[!j].branchMemberFlag().not()) then
          if ( (!this.rules[!i].drawlistMemberType().match(!this.rules[!j].gtype()) gt 0 )  or $
               (!this.rules[!i].drawlistMemberType().match(!this.rules[!j].drawlistMemberType()) gt 0) ) then
            !message = |Rule with Gtype | & !this.rules[!i].gtype() & | should be below rule with Gtype | & !this.rules[!j].gtype()
            return error 1 |$!message|
          endif
        endif
      else
        if (!this.rules[!j].branchMemberFlag().not()) then
        	-- this tests for rules on toplevel elements are NOT above an owning administrative element which lists them as members
        	-- e.g.  BRAN must be below PIPE or HVAC, STWALL rules must be below FRMW rules
          if ( !this.rules[!j].drawlistMemberType().match(!this.rules[!i].gtype()) gt 0  and $
            !this.rules[!j].drawlistMemberType() ne !this.rules[!j].gtype()  ) then
          	!message = |Rule with Gtype | & !this.rules[!i].gtype() & | should be below rule with Gtype | & !this.rules[!j].gtype()
            !!alert.message( !message )
          endif
        endif
      endif
      -- It is impossible to check for administrative elements (e.g. FRMW) rule above a toplevel element (STRU) rule
      -- It is impossible to check for toplevel element (SUBE) rule above toplevel element (EQUI) rule
      -- It is impossible to check for member elements (VALV) rule above a non direct owner (PIPE) rule
      -- There is not enough information available in the data structures to check.  So if defects that get reported they CANNOT BE FIXED by inspection
      -- THIS WAS NOT POSSIBLE ORIGINALLY so probably expected limitation?
      -- Possibly have to hardcode a sequence order required in additional data structure but this would be problem for saved rules
    enddo   	
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      saveSettings
--
-- Description:
--   Save settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .saveSettings()

  -- Save settings
  !file = object FILE(|%pdmsuser%/des-representationRuleSetSettings.pmldat|)
  !data = ARRAY()
  !data.append(|LastUsedFilename | & !this.currentFilename)
  !file.writeFile(|Overwrite|, !data)

endmethod

------------------------------------------------------------------------
-- Method:      loadSettings
--
-- Description:
--   Load settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .loadSettings()

  -- Load settings
  !file = object FILE(|%pdmsuser%/des-representationRuleSetSettings.pmldat|)
  if (!file.exists()) then
    do !line values !file.readFile()
      if (!line.substring(1, 17) eq |LastUsedFilename |) then
        !this.currentFilename = !line.after(|LastUsedFilename |)
      endif
    enddo
  endif

endmethod

------------------------------------------------------------------------
-- Method:      directory
--
-- Description:
--   Determine project defaults folder name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Folder name
------------------------------------------------------------------------
define method .directory() is STRING

  -- On first time start in project defaults folder
  if (!this.currentFilename.trim() eq ||) then
    !project  = current project
    !projCode = !project.code().lowcase()
    !folder = |%| & !projCode & |dflts%|
    !file = object FILE(!folder)
    if (!file.exists().not()) then
      return error 1 |Folder $!folder does not exist|
    endif
  else
    -- Return last used directory
    !file = object FILE(!this.currentFilename)
    !folder = !file.directory().string()
  endif
  return !folder

endmethod

------------------------------------------------------------------------
-- Method:      load
--
-- Description:
--   Load rules from the last used file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .load()

  -- Load rules from last used file
  !this.loadSettings()
  if (!this.currentFilename.trim() ne ||) then
    !file = object FILE(!this.currentFilename)
    handle any
      -- Ignore any error with the filename
    elsehandle none
      if (!file.exists()) then
        !this.load(!file)
      endif
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      load
--
-- Description:
--   Load rules from specified file location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File to be loaded
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .load(!file is FILE)

  -- Load rules from specified file
  !this.rules.clear()
  do !rule values !file.readFile()
    !this.rules.append(object COMREPRULE(!rule))
  enddo

  -- Update settings
  !this.currentFilename = !file.string()
  !this.saveSettings()
  !this.unsavedChanges = FALSE

endmethod

------------------------------------------------------------------------
-- Method:      save
--
-- Description:
--   Save rules to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File to be saved
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .save(!file is FILE)

  -- Check rule order
  !this.ruleOrderCheck()

  -- Save rules to specified file
  !file.writeFile(|Overwrite|, !this.output())

  -- Update settings
  !this.currentFilename = !file.string()
  !this.saveSettings()
  !this.unsavedChanges = FALSE

endmethod

------------------------------------------------------------------------
-- Method:      getDrawlistToken
--
-- Description:
--   Get current view drawlist token if available
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getDrawlistToken()

  -- Get current view drawlist token if available
  !this.drawlistToken = 0
  if (defined(!!gphdrawlists)) then
    if (!!gphviews.views.empty().not()) then
      !form = !!fmsys.currentDocument()
      handle any
        -- No current view
      elsehandle none
        if (!form.set()) then
          !this.drawlistToken = !!gphdrawlists.token(!form.view)
        endif
      endhandle
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      apply
--
-- Description:
--   Apply rule set to current drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .apply()

  -- Check rule order
  !this.ruleOrderCheck()

  -- Get drawlist members
  !this.getDrawlistToken()
  !drawlist = !this.drawlist()

  -- Create a parallel array to mark which drawlist have been processed
  var !doneStrings evaluate (false) for all from !drawlist
  !doneIndices = !doneStrings.evaluate(object BLOCK(|!doneStrings[!evalIndex].boolean()|))

  -- Initialise arrays that will be updated during rule evaluation
  !applicableIndices = ARRAY()
  !applicableMembers = ARRAY()
  !doneMembers       = ARRAY()

  -- For each rule, find the elements in the drawlist that it applies to, and re-add with new representation
  do !rule values !this.rules

    -- Rule applies to members of members of the drawlist, e.g. INST
    if (!rule.branchMemberFlag()) then

      -- Evaluate rule against drawlist, returns members it applies to, updates done members
      !applicableMembers = !rule.evaluateMembers(!drawlist, !doneMembers)

            -- Remove the applicable members of members of drawlist from the display, update representation and add back
      !this.removeOnlyFromDrawlist(!applicableMembers)
      !this.setRepresentation(!rule)
      !this.addOnlyToDrawlist(!applicableMembers, !rule.colour())

    -- Rule applies to references of members of the drawlist, e.g. PIPE
    else

      -- Evaluate rule against drawlist, returns indices it applies to, updates done indices
      !applicableIndices = !rule.evaluateDrawlist(!drawlist, !doneIndices)

      -- Remove the applicable members of drawlist from the display, update representation and add back
      !this.removeFromDrawlist(!drawlist, !applicableIndices)
      !this.setRepresentation(!rule)
      !this.addToDrawlist(!drawlist, !applicableIndices, !rule.colour())

    endif

  enddo

  -- Reset representation back to the global settings
  !this.resetRepresentation()

endmethod

------------------------------------------------------------------------
-- Method:      drawlist
--
-- Description:
--   Get current drawlist members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Drawlist members as strings
------------------------------------------------------------------------
define method .drawlist() is ARRAY

  -- Get drawlist members, using drawlist object if available
  !drawlistMembers = ARRAY()
  if (!this.drawlistToken gt 1) then
    !elements = !!gphdrawlists.drawlist(!this.drawlistToken).members()
    !drawlistMembers = !elements.evaluate(object BLOCK(|!elements[!evalIndex].refn.string()|))
  else
    var !drawlistMembers collect all from drawlist
  endif
  return !drawlistMembers

endmethod

------------------------------------------------------------------------
-- Method:      removeFromDrawlist
--
-- Description:
--   Remove elements from drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Drawlist elements as strings
--    2   R      ARRAY       Indices of elements to be removed
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .removeFromDrawlist(!elements is ARRAY, !applicableIndices is ARRAY)

  -- Remove elements from drawlist, using drawlist object if not the global drawlist
  if (!this.drawlistToken gt 1) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !elementsToRemove = ARRAY()
    do !i values !applicableIndices
      !elementsToRemove.append(!elements[!i].dbref())
    enddo
    !drawlist.removeMembers(!elementsToRemove)
  else
    do !i values !applicableIndices
      REMOVE $!elements[$!i]
    enddo
  endif

endmethod

------------------------------------------------------------------------
-- Method:      removeOnlyFromDrawlist
--
-- Description:
--   Remove members from drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Members of drawlist elements
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .removeOnlyFromDrawlist(!elements is ARRAY)

  -- Remove member from drawlist
  if (!this.drawlistToken gt 0) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !drawlist.removeOnlyMembers(!elements)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      addToDrawlist
--
-- Description:
--   Add elements to drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Drawlist elements as strings
--    2   R      ARRAY       Indices of elements to be added
--    3   R      REAL        Colour to add element with
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .addToDrawlist(!elements is ARRAY, !applicableIndices is ARRAY, !colour is REAL)

  -- Add elements to drawlist, using drawlist object if not the global drawlist
  if (!this.drawlistToken gt 1) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !elementsToAdd = ARRAY()
    do !i values !applicableIndices
      !elementsToAdd.append(!elements[!i].dbref())
    enddo
    !drawlist.addMembers(!elementsToAdd)
    !drawlist.colour(!elementsToAdd, !colour)
  else
    do !i values !applicableIndices
      ADD $!elements[$!i] COLOUR $!colour
    enddo
  endif

endmethod

------------------------------------------------------------------------
-- Method:      addOnlyToDrawlist
--
-- Description:
--   Add members to drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Members of drawlist elements
--    2   R      REAL        Colour to add element with
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .addOnlyToDrawlist(!elements is ARRAY, !colour is REAL)

  -- Add member from drawlist
  if (!this.drawlistToken gt 0) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !drawlist.addOnlyMembers(!elements)
    -- Workaround for P-15059 is to use a local array in the colour method
    !localElements = !elements
    !drawlist.colour(!localElements, !colour)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      setRepresentation
--
-- Description:
--   Set representation settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      COMREPRULE  Rule to be applied
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .setRepresentation(!rule is COMREPRULE)

  -- Get insulation settings
  !insulation        = FALSE
  !insulationTrans   = 0
  if (!rule.insulation() eq |Solid|) then
    !insulation      = TRUE
  elseif (!rule.insulation().matchwild(|??%|)) then
    !insulation      = TRUE
    !insulationTrans = !rule.insulation().before(|%|).real()
    handle any
      -- Not a number
    endhandle
  endif

  -- Get obstruction settings
  !obstruction        = FALSE
  !obstructionTrans   = 0
  if (!rule.obstruction() eq |Solid|) then
    !obstruction      = TRUE
  elseif (!rule.obstruction().matchwild(|??%|)) then
    !obstruction      = TRUE
    !obstructionTrans = !rule.obstruction().before(|%|).real()
    handle any
      -- Not a number
    endhandle
  endif

  -- Set representation, using drawlist object if not the global drawlist
  if (!this.drawlistToken gt 1) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !drawlist.tube(!rule.tube())
    !drawlist.centreline(!rule.centreline())
    !drawlist.insulation(!insulation)
    !drawlist.insulationTrans(!insulationTrans)
    !drawlist.obstruction(!obstruction)
    !drawlist.obstructionTrans(!obstructionTrans)
    !drawlist.pipeLevel(!rule.level())
    !drawlist.struLevel(!rule.level())
    !drawlist.nozzLevel(!rule.level())
    !drawlist.level(!rule.level())
    !drawlist.arcTol(!rule.arcTolerance())
  else
    -- Use local copy of global representation, don't use !!gphRepOpt.localCopy() as this changes !!gphRepOpt
    !repOpt                    = !!gphRepOpt
    !repOpt.global             = FALSE
    !repOpt.tube               = !rule.tube()
    !repOpt.centreline         = !rule.centreline()
    !repOpt.insulation         = !insulation
    !repOpt.insulationTrans    = !insulationTrans
    !repOpt.obstruction        = !obstruction
    !repOpt.obstructionTrans   = !obstructionTrans
    !repOpt.pipeLevel          = !rule.level()
    !repOpt.struLevel          = !rule.level()
    !repOpt.nozzLevel          = !rule.level()
    !repOpt.generalLevel       = !rule.level()
    !repOpt.arcTolerance       = !rule.arcTolerance()
    !repOpt.coreSettings()
  endif

  -- Switch off autocolour
  AUTOCOLOUR OFF

endmethod

------------------------------------------------------------------------
-- Method:      resetRepresentation
--
-- Description:
--   Reset representation to defaults using drawlist object if available
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .resetRepresentation()

  -- Reset representation to global options, using drawlist object if not the global drawlist
  if (!this.drawlistToken gt 1) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !drawlist.tube(!!gphRepOpt.tube)
    !drawlist.centreline(!!gphRepOpt.centreline)
    !drawlist.insulation(!!gphRepOpt.insulation)
    !drawlist.insulationTrans(!!gphRepOpt.insulationTrans)
    !drawlist.obstruction(!!gphRepOpt.obstruction)
    !drawlist.obstructionTrans(!!gphRepOpt.obstructionTrans)
    !drawlist.level(!!gphRepOpt.generalLevel)
    !drawlist.pipeLevel(!!gphRepOpt.pipeLevel)
    !drawlist.nozzLevel(!!gphRepOpt.nozzLevel)
    !drawlist.struLevel(!!gphRepOpt.struLevel)
    !drawlist.arcTol(!!gphRepOpt.arcTolerance)
  else
    !!gphRepOpt.coreSettings()
  endif

  -- Reset autocolour setting
  !!gphColOpt.coreSettings()

endmethod

------------------------------------------------------------------------
-- Method:      resetDisplay
--
-- Description:
--   Reset display to global default representation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .resetDisplay()

  -- Reset display to global default representation, using drawlist object if not the global drawlist
  !this.getDrawlistToken()
  !this.resetRepresentation()
  if (!this.drawlistToken gt 1) then
    !drawlist = !!gphdrawlists.drawlist(!this.drawlistToken)
    !drawlist.update()
  else
    !!gphRepOpt.update()
  endif

endmethod
