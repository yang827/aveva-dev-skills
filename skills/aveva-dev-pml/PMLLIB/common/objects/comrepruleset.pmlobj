------------------------------------------------------------------------
-- Method:      centreline
--
-- Description:
--   Return centreline of selected rule
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rule number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Centreline
------------------------------------------------------------------------
define method .centreline(!index is REAL) is BOOLEAN

  -- Output member
  return !this.rules[!index].centreline()

