--
-- File:            comspreadsheetloader.pmlobj
--   Type:          object Definition
--   Group:         Utilities
--     Keyword:     GENERAL
--   Module:        design
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Wed Nov 1 00:00:00 BST 2006
--
--
-- Description:
--   Load spreadsheet .csv or .xls file into PML Arrays
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comSpreadsheetLoader()           -                   Constructor
--  firstRowIsHeading(BOOLEAN)       -                   If argument is true, the first row of the data source
--  getHeadings()                    ARRAY               Return data source headings as an array of strings
--  getRows()                        ARRAY               Return data source as array of rows, where each
--  loadDataSource()                 -                   Load from data source into raw table
--  loadDataSource(FILE)             -                   Load from data source from the file name
--  loadDataSource(STRING)           -                   Load from data source from the file name
--  setDataSource(FILE)              STRING              Set data source file object - can be csv or xls file
--  setDataSource(STRING)            STRING              Set data source filename - can be csv or xls file
--
import 'GridControl'
handle any
endhandle

define object COMSPREADSHEETLOADER

  -- Raw table
  member .rawTable            is ARRAY
  -- Headings - or first row of table if data source has no headings
  member .headings            is ARRAY
  -- Data source filename as provided
  member .rawDataSource       is STRING
  -- Data source pathname
  member .dataSourcePath      is STRING
  -- Data source file object
  member .dataSource          is FILE
  -- Flag indicating how to interpret the first row of the data source
  member .firstRowHeading     is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      comSpreadsheetLoader
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .comSpreadsheetLoader()

  -- Initialise Variables
  !this.firstRowHeading = true
  !this.rawDataSource   = ''
  !this.dataSourcePath  = ''

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDataSource
--
-- Description: Set data source filename - can be csv or xls file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename of csv or xls file
-- Return:
--   [Data Type] [Description]
--    STRING      Full pathname of file or empty if the file does not exist
--
------------------------------------------------------------------------

define method .setDataSource(!fileName is STRING) is STRING

  -- Initialise Variables
  !this.rawDataSource   = !fileName
  !datasourceFileObject = object FILE(!fileName)
  return !this.setDataSource(!datasourceFileObject)

endmethod
----------------------------------------------------------------------
--
-- Method:      setDataSource
--
-- Description: Set data source file object - can be csv or xls file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE       Filename object for csv or xls file
-- Return:
--   [Data Type] [Description]
--    STRING      Full pathname of file or empty if the file does not exist
--
------------------------------------------------------------------------

define method .setDataSource(!file is FILE) is STRING

  -- Initialise Variables
  !this.dataSource       = !file

  if( !file.unset() ) then
    !this.dataSourcePath = ''
    return ''
  endif

  if( !this.dataSource.exists() ) then
    !this.dataSourcePath = !this.dataSource.fullname()
  else
    !this.dataSourcePath = ''
  endif
  return !this.dataSourcePath

endmethod

-------------------------------------------------------------------
--
-- Method:      loadDataSource
--
-- Description: Load from data source into raw table
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadDataSource()
  -- Initialise Variables
  !this.rawTable = ARRAY()
  !this.headings = ARRAY()

  -- exit if no file
  if( !this.dataSourcePath.empty() ) then
    return
  endif

  -- use the grid control (silently) to read the data source
  using namespace  'Aveva.Pdms.Presentation'
  !dbCtrl = object NETGRIDCONTROL()
  !nds    = object NETDATASOURCE('spreadsheet', !this.dataSourcePath)

  handle NONE
    !dbCtrl.bindToDataSource(!nds)

    -- The grid control treats the first row as a heading row
    -- The rawTable does not included the first (heading) row
    !this.rawTable = !dbCtrl.getRows()
    !temp          = !dbCtrl.getColumns()
    -- TEMPORARY TO AVOID A BUG - CURRENTLY .headings() returns array element 0
    !this.headings = ARRAY()
    do !i from 1 to ( !temp.size() )
      !this.headings[!i] = !temp[!i]
    enddo
  elsehandle (1000, 0)
     !errorText = !!error.text
     if (!errorText.match('Microsoft.Office.Interop.Excel').set()) then
		!!alert.error('Failed to load Microsoft.Office.Interop.Excel.dll. Please contact your system administrator.')
	 else
       !!alert.error(!errorText)
     endif
  endhandle
endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      loadDataSource
--
-- Description: Load from data source from the file name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename of csv or xls file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadDataSource(!fileName is STRING)

  -- set the file information
  !this.setDataSource(!fileName)

  -- load the data
  !this.loadDataSource()
endmethod
-- End of method
-------------------------------------------------------------------
--
-- Method:      loadDataSource
--
-- Description: Load from data source from the file name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--1   R      FILE   File object for csv or xls file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadDataSource(!file is FILE)

  -- set the file information
  !this.setDataSource(!file)

  -- load the data
  !this.loadDataSource()
endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      firstRowIsHeading
--
-- Description: If argument is true, the first row of the data source
-- is treated as a heading, otherwise it is treated as data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if first row of data source is treated
--                           as a heading row - otherwise it is data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .firstRowIsHeading(!firstRowHeading is BOOLEAN)

  !this.firstRowHeading = !firstRowHeading

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      getRows
--
-- Description: Return data source as array of rows, where each
--              row is an array
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of rows (ARRAY)
--
------------------------------------------------------------------------

define method .getRows() is ARRAY

  if( !this.firstRowHeading ) then
    -- first row is a heading
    return !this.rawTable
  else
    -- first row is data - add it to the table
    !temp    = ARRAY()
    !temp[1] = !this.headings
    !temp.appendArray(!this.rawTable)
    return !temp
  endif

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      getHeadings
--
-- Description: Return data source headings as an array of strings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of rows (ARRAY)
--
------------------------------------------------------------------------

define method .getHeadings() is ARRAY

  return !this.headings

endmethod
-- End of method
