-- File:            comstatus.pmlobj
--   Type:          Object Definition
--   Group:         Common
--     Keyword:     PROMPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Wed Jun 03 16:31:05 WAT 1998
--
--
-- Description:
-- Object for controlling multiple status fields
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addPane(REAL)                    REAL                add a pane to the prompt area
--  clear()                          -                   clear all prompt panes
--  comStatus()                      -                   constructor
--  globalInstance()                 -                   create a global instance of this object
--  setPane(REAL,STRING)             -                   set the contents of a pane
--  updateStatus()                   -                   update the status area
--

define object COMSTATUS

  member .paneList is ARRAY

  member .paneContents is ARRAY

  member .string is STRING

  member .spaces is STRING

endobject
-- End of object definition for COMSTATUS

------------------------------------------------------------------------
--
-- Method:      !comStatus()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .comStatus()

  -- string     0123456789
  !tenSpaces = '          '

  -- create string of 100 spaces
  !this.spaces = !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces + !tenSpaces

endmethod
-- End of method definition for .comStatus()

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of this object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  !!comStatus = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !addPane()
--
-- Description: add a pane to the prompt area
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [REAL] [width of pane]
-- Return:
--   [REAL] [pane index]
--
------------------------------------------------------------------------
define method .addPane(!width is REAL) is REAL

  !this.paneList.append(!width)
  !this.paneContents.append('')

  return !this.paneList.size()

endmethod
-- End of method definition for .addPane(REAL) REAL

--   setPane()         set the contents of a pane
------------------------------------------------------------------------
--
-- Method:      !setPane()
--
-- Description: set the contents of a pane
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [pane index]
--   [2] [R] [STRING] [pane content]
--
------------------------------------------------------------------------
define method .setPane(!index is REAL, !content is STRING)

  -- check that index is valid
  if (!index le !this.paneList.size()) then
    !this.paneContents[!index] = !content
    !this.updateStatus()
  else
    !!alert.error('prompt pane (' & !index & ') does not exist')
  endif

endmethod
-- End of method definition for .setPane(REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      !clear()
--
-- Description: clear all prompt panes
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clear()

  !this.paneList = ARRAY()
  !this.paneContents = ARRAY()

  !this.updateStatus()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      !updateStatus()
--
-- Description: update the status area
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .updateStatus()

  !promptString = ''

  -- build prompt from contents of each pane
  do !i indices !this.paneList
    !paneString = SUBSTRING(!this.paneContents[!i] + !this.spaces, 1, !this.paneList[!i])
    if (!i eq 1) then
      !promptString = !promptString + !paneString
    else
      !promptString = !promptString + '   ' + !paneString
    endif
  enddo

  !this.string = !promptString

  prompt '$!<promptString>'

endmethod
-- End of method definition for .updateStatus()
