--
-- File:            comsysopt.pmlobj
--   Type:          Object Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Aug 18 14:12:58 BST 1997
--
--
-- Description:
-- Object to store system options available in all PDMS modules
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAllShownForms()               -                   add any shown forms with a rebuild member to the childform list
--  addChildForm(STRING)             -                   adds a child form to the object for update
--  addMainForm(STRING)              -                   adds the main form to the object for update
--  alarm()                          BOOLEAN             get the system alarm setting
--  alarm(BOOLEAN)                   -                   set the system alarm setting
--  clickPop()                       BOOLEAN             get the system clickPop setting
--  clickPop(BOOLEAN)                -                   set the system clickPop setting
--  comSysOpt()                      -                   Constructor
--  comSysOpt(BOOLEAN)               -                   Constructor
--  copyToGlobal()                   -                   copy the object to the global instance
--  coreSettings()                   -                   Align all core settings with the member values
--  default(BOOLEAN)                 -                   Default options settings
--  edit()                           -                   edit the options via the GUI
--  globalInstance()                 -                   create a global instance of the object
--  iconSize()                       REAL                get the system iconsSize setting
--  largeIcons()                     BOOLEAN             get the largeIcons flag
--  largeIcons(BOOLEAN)              -                   set the largeIcons flag
--  load()                           -                   Load options from system and user files
--  localCopy()                      COMSYSOPT           return a local copy of the object
--  mainToolBar()                    BOOLEAN             get the main toolbar display setting
--  mainToolBar(BOOLEAN)             -                   set the main toolbar display setting
--  rebuildChildForm()               -                   rebuilds the child forms
--  rebuildMainForm()                -                   rebuilds the main form
--  remChildForm(STRING)             -                   removes the child form
--  remMainForm()                    -                   removes the main form
--  save()                           -                   Save options settings to %PDMSUSER%
--
------------------------------------------------------------------------

-- Define object
define object COMSYSOPT

  -- current options file name for this object
  member .filename is STRING

  -- global object flag, if set then global core options are also set
  member .global is BOOLEAN

  -- member to hold the current setting for the system alarm
  -- it is necessary to hold the value here, as it can not be queried.
  member .alarm is BOOLEAN

  -- member to hold size of toolbar icons
  member .largeIcons is BOOLEAN

  -- member to flag if main toolbar is shown
  member .mainToolBar is BOOLEAN

  member .updateToolbar is BOOLEAN
  member .updateIcons is BOOLEAN

  member .mainForm is STRING
  member .childForm is ARRAY

  member .clickPop is BOOLEAN

endobject
-- End of object definition for COMSYSOPT

------------------------------------------------------------------------
--
-- Method:      !comSysOpt()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .comSysOpt()

  -- set file name
  !module = !!module()
  !this.filename = !module.appKey + '-sys.pmldat'

  !this.updateToolbar = false
  !this.updateIcons = false

  -- initialise the global flag
  !this.global = false

  -- set the default values
  !this.default(false)

endmethod
-- End of method definition for .comSysOpt()

------------------------------------------------------------------------
--
-- Method:      !comSysOpt(BOOLEAN)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .comSysOpt(!globalValue is BOOLEAN)

  -- set file name
  !module = !!module()
  !this.filename = !module.appKey + '-sys.pmldat'

  -- initialise the global flag
  !this.global = !globalValue

  -- set the default values
  !this.default(!globalValue)

endmethod
-- End of method definition for .comSysOpt(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !default(BOOLEAN)
--
-- Description: Default options settings
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .default(!setCore is BOOLEAN)

  !this.alarm = true
  !this.largeIcons = false
  !this.mainToolBar = true
  !this.clickPop = true

  if (!setCore) then
    !this.coreSettings()
  endif

endmethod
-- End of method definition for .default(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- create the global variable
  !!comSysOpt = !this
  !!comSysOpt.global = true

  -- load the options
  !!comSysOpt.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [COMSYSOPT] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is COMSYSOPT

  -- copy this object to a local variable and unset the global flag
  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() COMSYSOPT

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  !!comSysOpt = !this
  !!comSysOpt.global = true
  !!comSysOpt.coreSettings()

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method: !coreSettings()
--
-- Description: Align all core settings with the member values
--
-- Method Type: Procedure
--
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .coreSettings()

  if (!this.alarm) then
    ALARM ON
  else
    ALARM OFF
  endif

  if (!this.updateIcons or !this.updateToolbar) then
    !this.addAllShownForms()
    !this.rebuildChildForm()
    !this.rebuildMainForm()
  endif

  !this.updateToolbar = false
  !this.updateIcons   = false

  !!fmsys.clickPop(!this.clickPop)
  handle any
  endhandle

endmethod
-- End of method definition for .coreSettings()
------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------
define method .load()

  -- get the locations of system options file and user options file
  !optionFiles = !!comGetOptFiles(!this.filename)

  -- create a temporary global variable to store the data
  if (defined(!!tmpComSysOpt)) then
    !!tmpComSysOpt.delete()
  endif
  !!tmpComSysOpt = !this

  -- if a system options file has been found, load the data
  if (defined(!optionFiles[1])) then

    -- load options file
    !localName = !optionFiles[1].fullName()
    $m "$!<localName>"
    handle any
      !!messageFile.warning(146, 31, !optionFiles[1].fullName())
      !this.default(false)
    endhandle
  endif

  -- if a user options file has been found, load the options
  if (defined(!optionFiles[2])) then

    -- load options file
    !localName = !optionFiles[2].fullName()
    $m "$!<localName>"
    handle any
      !!messageFile.warning(146, 32, !optionFiles[2].fullName())
      !this.default(false)
    endhandle
  endif

  -- copy temporary object to this object and reset the global value
  !this = !!tmpComSysOpt

  !this.coreSettings()

  !!tmpComSysOpt.delete()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method: !save()
--
-- Description: Save options settings to %PDMSUSER%
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

  -- write header information
  !saveContents.append('-- Data file for module system options')
  !saveContents.append('')

  -- options are not saved if they are the same as the default values
  -- currently the default values are put in here directly, this is
  -- for performance reasons, it would be better to have a member for
  -- each existing member, that held its default value.

  ----------------------------------------------------------------------
  -- user options are  saved for all users
  ----------------------------------------------------------------------
  if (!this.alarm ne TRUE) then
    !saveContents.append('!!tmpComSysOpt.alarm = ' & !this.alarm())
  endif
  if (!this.largeIcons ne FALSE) then
    !saveContents.append('!!tmpComSysOpt.largeIcons = ' & !this.largeIcons())
  endif
  if (!this.mainToolBar ne TRUE) then
    !saveContents.append('!!tmpComSysOpt.mainToolBar = ' & !this.mainToolBar())
  endif
  if (!this.clickPop ne TRUE) then
    !saveContents.append('!!tmpComSysOpt.clickPop = ' & !this.clickPop())
  endif

  -- end of user options

  ----------------------------------------------------------------------
  -- system options are only saved if the user has administrator status
  ----------------------------------------------------------------------
--  if (!!comAdminStatus()) then

--  endif
  -- end of system options

  !!writeFile('%PDMSUSER%/' + !this.filename, 'OVERWRITE', !saveContents)

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
-- Description: edit the options via the GUI
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .edit()

  show !!comSysEdit

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      !alarm()
--
-- Description: get the system alarm setting
--
-- Method Type: Function
-- Return:
--   [BOOLEAN] [value of alarm setting]
--
------------------------------------------------------------------------
define method .alarm() is BOOLEAN

  return !this.alarm

endmethod
-- End of method definition for .alarm() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !alarm(BOOLEAN)
--
-- Description: set the system alarm setting
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [value for alarm setting]
--
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .alarm(!value is BOOLEAN)

  !this.alarm = !value

  -- if this the global instance set the core option
  if (!this.global) then
    if (!this.alarm) then
      ALARM ON
    else
      ALARM OFF
    endif
  endif

endmethod
-- End of method definition for .alarm(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !iconSize()
--
-- Description: get the system iconsSize setting
--
-- Method Type: Function
-- Return:
--   [REAL] [value of iconSize setting]
--
------------------------------------------------------------------------
define method .iconSize() is REAL

  if (!this.largeIcons) then
    !iconSize = 24
  else
    !iconSize = 16
  endif

  return !iconSize

endmethod
-- End of method definition for .iconSize() REAL

------------------------------------------------------------------------
--
-- Method:      !largeIcons()
--
-- Description: get the largeIcons flag
--
-- Method Type: Function
-- Return:
--   [BOOLEAN] [value of iconSize setting]
--
------------------------------------------------------------------------
define method .largeIcons() is BOOLEAN

  return !this.largeIcons

endmethod
-- End of method definition for .largeIcons() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !largeIcons(BOOLEAN)
--
-- Description: set the largeIcons flag
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [value for largeIcons flag]
--
------------------------------------------------------------------------
define method .largeIcons(!value is BOOLEAN)

  if (!value ne !this.largeIcons) then
    !this.largeIcons = !value
    !this.updateIcons = true
  endif

endmethod
-- End of method definition for .largeIcons(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !mainToolBar()
--
-- Description: get the main toolbar display setting
--
-- Method Type: Function
-- Return:
--   [BOOLEAN] [value of main toolbar display setting]
--
------------------------------------------------------------------------
define method .mainToolBar() is BOOLEAN

  return !this.mainToolBar

endmethod
-- End of method definition for .mainToolBar() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !mainToolBar(BOOLEAN)
--
-- Description: set the main toolbar display setting
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [value for main toolbar display setting]
--
------------------------------------------------------------------------
define method .mainToolBar(!value is BOOLEAN)

  if (!value ne !this.mainToolBar) then
    !this.mainToolBar = !value
    !this.updateToolbar = true
  endif

endmethod
-- End of method definition for .mainToolBar(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !clickPop()
--
-- Description: get the system clickPop setting
--
-- Method Type: Function
-- Return:
--   [BOOLEAN] [value of clickPop setting]
--
------------------------------------------------------------------------
define method .clickPop() is BOOLEAN

  return !this.clickPop

endmethod
-- End of method definition for .clickPop() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !clickPop(BOOLEAN)
--
-- Description: set the system clickPop setting
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [value for clickPop setting]
--
------------------------------------------------------------------------
define method .clickPop(!value is BOOLEAN)

  !this.clickPop = !value

  -- if this the global instance set the core option
  if (!this.global) then
    !!fmsys.clickPop(!value)
  endif

endmethod
-- End of method definition for .clickPop(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !addMainForm()
--
-- Description: adds the main form to the object for update
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of main form]
--
------------------------------------------------------------------------
define method .addMainForm(!formName is STRING)

  !this.mainForm = !formName

endmethod
-- End of method definition for .addMainForm(STRING)

------------------------------------------------------------------------
--
-- Method:      !addChildForm()
--
-- Description: adds a child form to the object for update
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of main form]
--
------------------------------------------------------------------------
define method .addChildForm(!formName is STRING)

  if (!this.childForm.findFirst(!formName).unset()) then
    !this.childForm.append(!formName)
  endif

endmethod
-- End of method definition for .addChildForm(STRING)

------------------------------------------------------------------------
--
-- Method:      !remMainForm()
--
-- Description: removes the main form
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of main form]
--
------------------------------------------------------------------------
define method .remMainForm()

  !this.mainForm = STRING()

endmethod
-- End of method definition for .remMainForm()

------------------------------------------------------------------------
--
-- Method:      !remChildForm()
--
-- Description: removes the child form
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of main form]
--
------------------------------------------------------------------------
define method .remChildForm(!formName is STRING)

  !index = !this.childForm.findFirst(!formName)

  if (!index.unset().not()) then
    !this.childForm.remove(!index)
  endif

endmethod
-- End of method definition for .remChildForm(STRING)

------------------------------------------------------------------------
--
-- Method:      !rebuildMainForm()
--
-- Description: rebuilds the main form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .rebuildMainForm()

  if (!this.mainForm.unset().not()) then

    !form = !!$!<this.mainForm>
    handle (2,751)
      -- nothing to do
    elsehandle none
      !rebuildCommand = !form.rebuild
      !form.delete()
      swap main !!emptyForm
      $!<rebuildCommand>
      handle any
        !!alert.error(!!error.text)
      endhandle

      swap main _$!<this.mainForm>

    endhandle
  endif

endmethod
-- End of method definition for .rebuildMainForm()

------------------------------------------------------------------------
--
-- Method:      !rebuildChildForm()
--
-- Description: rebuilds the child forms
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .rebuildChildForm()

  !removeArray = ARRAY()

  do !i indices !this.childForm

    !formName = !this.childForm[!i]

    !form = !!$!<formName>
    handle (2,751)
      !removeArray.append(!i)
    elsehandle none
      if (!form.shown()) then
        !rebuildCommand = !form.rebuild
        !form.delete()
        $!<rebuildCommand>
        handle any
        endhandle
        show _$!<formName>
      endif
    endhandle

  enddo

  !removeArray.sort()
  !removeArray.invert()

  do !remIndex values !removeArray
    !this.childForm.remove(!remIndex)
  enddo

endmethod
-- End of method definition for .rebuildChildForm()
------------------------------------------------------------------------
--
-- Method: addAllShownForms()
--
-- Description: add any shown forms with a rebuild member to the childform list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .addAllShownForms()

!shownForms = !!fmsys.shownForms()

do !i values !shownForms

  if(defined(!i.rebuild)) then
    !this.addChildForm(!i.string())
  endif
enddo

endmethod
-- End of method definition for .addAllShownForms()
