-- File:            comunits.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--  Created:         Tue Mar 16 16:19:08 2010
--
-- Description:
-- Query, save and restore system units.
-- This may be replaced by new core functions.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comUnits()                       -                   Constructor
--  comUnits(BOOLEAN)                -                   Constructor with save units option
--  getCurrentUnitsByPType(STRING)   STRING
--  getDescriptionFromPType(STRING)  STRING
--  getDimensionIndex(STRING)        REAL
--  getPType(STRING)                 STRING              get PType for dimension
--  getSavedUnitsByPtype(STRING)     STRING
--  initialisePTypes()               -                   initialise dimension PTYPE
--  isImperialSavedBore()            BOOLEAN             true if saved bore units are imperial
--  isImperialSavedDist()            BOOLEAN             true if saved distance units are imperial
--  isImperialSavedLength(STRING)    BOOLEAN             true if saved distance units are imperial
--  restoreAllSavedUnits()           -                   Restore all saved units
--  restoreSavedBoreDist()           -                   Restore saved units Bore and Distance
--  restoreSavedUnitsByPtype(STRING) STRING
--  saveCurrentUnits()               -                   Save current units
--  setUnits(STRING,STRING,STRING)   STRING
--
------------------------------------------------------------------------

define object COMUNITS

  -- members for new dimensions & units (12.1)
  -- The following arrays form a table
  -- corresponding array of dimension PTYPE codes (can be used for DTEXT)
  member .dimensionPTypes            is ARRAY
  -- corresponding array of dimension PTYPE codes (can be used for DTEXT)
  member .dimensionNames             is ARRAY
  -- last saved units - one entry per PTYPE
  member .savedUnits                 is ARRAY
  -- array of MEASURE objects - one for each dimension
  member .allDimensions              is ARRAY
  -- table of PTYPE names against PTYPE codes (temporary until core method provided)
  member .pTypeNames                 is ARRAY
  member .pTypes                     is ARRAY

endobject
-- End of object definition for COMUNITS

------------------------------------------------------------------------
--
-- Method:      comUnits()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .comUnits()

  -- store dimension list
  !dimensions         = object MEASURE()
  !this.allDimensions = !dimensions.allDimensions()

  -- initialise pType table of names against PTYPE words (temporary)
  !this.initialisePTypes()

  -- cache the dimension PTYPES
  do !index indices !this.allDimensions
    !this.dimensionNames[!index]   = !this.allDimensions[!index].name().upcase()
    !this.dimensionPTypes[!index]  = !this.getPType(!this.dimensionNames[!index])
  enddo

endmethod
-- End of method definition for .comFormats()

------------------------------------------------------------------------
--
-- Method:      comUnits()
--
-- Description: Constructor with save units option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .comUnits(!save is BOOLEAN)

  !this.comUnits()
  if( !save ) then
    -- initialise with current units
    !this.saveCurrentUnits()
  endif

endmethod
-- End of method definition for .comFormats()

------------------------------------------------------------------------
--
-- Method:      getPType()
--
-- Description: get PType for dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPType(!name is STRING) is STRING

  !index = !this.pTypeNames.findFirst(!name)
  if( !index.unset() ) then
    !return = 'UNKNOWN'
  else
    !return = !this.pTypes[!index]
  endif

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialisePTypes()
--
-- Description: initialise dimension PTYPE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

