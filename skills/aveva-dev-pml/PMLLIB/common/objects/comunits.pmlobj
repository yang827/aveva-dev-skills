-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getDimensionIndex
--
-- Description: Get index for PTYP
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PTYP
-- Return:
--   [Data Type] [Description]
--    STRING     PTYP description
--
------------------------------------------------------------------------

define method .getDimensionIndex( !pType is STRING ) is REAL

  !index   = !this.dimensionPTypes.findFirst(!pType)
  if( !index.unset() ) then
    !index = !this.dimensionNames.findFirst(!pType)
  endif

  return !index

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDescriptionFromPType
--
-- Description: Get descriptive text for given PTYP
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PTYP
-- Return:
--   [Data Type] [Description]
--    STRING     PTYP description
--
------------------------------------------------------------------------

define method .getDescriptionFromPType( !pType is STRING ) is STRING

  !index = !this.getDimensionIndex(!pType)
  if( !index.unset() ) then
    return 'UNKNOWN'
  else
    return !this.allDimensions[!index].description()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getCurrentUnitsByPtype
--
-- Description: Get current units for given dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Dimension
-- Return:
--   [Data Type] [Description]
--    STRING     Current Unit
--
------------------------------------------------------------------------

define method .getCurrentUnitsByPType( !pTypeArg is STRING ) is STRING

  !pType   = !pTypeArg.upcase()
  if(!pType eq 'L') then
    !pType = 'DIST'
  elseif(!pType eq 'L2') then
    !pType = 'SQDI'
  elseif(!pType eq 'L3') then
    !pType = 'CUDI'
  endif

  -- get current unit for given PTYPE
  !index = !this.getDimensionIndex(!pType)
  if( !index.unset() ) then
    return 'UNKNOWN'
  else
    !unitQualifier     = !this.allDimensions[!index].currentUnits().unitQualifier()
    -- deal with special case of FINCH
    if( !unitQualifier.upcase() eq 'IN' and !pType eq 'DIST') then
      VAR !tempUnit UNIT
      if( !tempUnit.split()[3] eq 'FINC' ) then
        !unitQualifier = 'FINC'
      endif
    endif
  endif
  return !unitQualifier

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveCurrentUnits
--
-- Description: Save current units
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveCurrentUnits()

  -- store current units for all dimensions
  do !index indices !this.allDimensions
    !unitQualifier     = !this.allDimensions[!index].currentUnits().unitQualifier()
    -- deal with special case of FINCH
    if( !unitQualifier.upcase() eq 'IN' ) then
      VAR !tempUnit UNIT

      -- Deal with Bores having INCH rather than FINC
      if( !this.allDimensions[!index].pType() eq 'BORE' ) then
        !unitIndex = 1
      else
        !unitIndex = 3
      endif
      if( !tempUnit.split()[!unitIndex] eq 'FINC' ) then
        !unitQualifier = 'FINC'
      endif
    endif
    !this.savedUnits[!index] = !unitQualifier
  enddo
  return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      restoreAllSavedUnits
--
-- Description: Restore all saved units
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .restoreAllSavedUnits()

  -- restore current units for all dimensions
  do !index indices !this.allDimensions
    !this.restoreSavedUnitsByPtype( !this.dimensionPTypes[!index] )
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSavedUnitsByPtype
--
-- Description: Restore saved units for given dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Dimension
-- Return:
--   [Data Type] [Description]
--    STRING     Restored Unit
--
------------------------------------------------------------------------

define method .getSavedUnitsByPtype( !pTypeArg is STRING ) is STRING

  -- deal with special cases
  !pType  = !pTypeArg.upcase()
  if(!pType eq 'L') then
    !pType = 'DIST'
  elseif(!pType eq 'L2') then
    !pType = 'SQDI'
  elseif(!pType eq 'L3') then
    !pType = 'CUDI'
  endif

  -- get saved unit for given PTYPE
  !index = !this.getDimensionIndex(!pType)
  if( !index.unset() ) then
    !unit = 'UNKNOWN'
  else
    !unit = !this.savedUnits[!index]
  endif

  return !unit

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      restoreSavedUnitsByPtype
--
-- Description: Restore saved units for given dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Dimension
-- Return:
--   [Data Type] [Description]
--    STRING     Restored Unit
--
------------------------------------------------------------------------

define method .restoreSavedUnitsByPtype( !pTypeArg is STRING ) is STRING

  !pType   = !pTypeArg.upcase()
  if(!pType eq 'L') then
    !pType = 'DIST'
  elseif(!pType eq 'L2') then
    !pType = 'SQDI'
  elseif(!pType eq 'L3') then
    !pType = 'CUDI'
  endif

  -- get saved unit for given PTYPE
  !index = !this.getDimensionIndex(!pType)
  if( !index.unset() ) then
    !unit = 'UNKNOWN'
  else
    if( defined(!this.savedUnits[!index]) ) then
      !unitQualifier = !this.savedUnits[!index]
      !unitQualifier = !this.setUnits('', !pType, !unitQualifier)
    else
      -- units have not been saved - do nothing except return current unit
      !unitQualifier = !this.getCurrentUnitsByPType(!pType)
    endif
  endif

  return !unitQualifier

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      restoreSavedBoreDist
--
-- Description: Restore saved units Bore and Distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .restoreSavedBoreDist()

  !this.restoreSavedUnitsByPtype('DIST')
  !this.restoreSavedUnitsByPtype('BORE')

endmethod

------------------------------------------------------------------------
--
-- Method:      isImperialSavedBore
--
-- Description: true if saved bore units are imperial
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if imperial bore units
--
------------------------------------------------------------------------

define method .isImperialSavedBore() is BOOLEAN

  return !this.isImperialSavedLength('BORE')

endmethod

------------------------------------------------------------------------
--
-- Method:      isImperialSavedDist
--
-- Description: true if saved distance units are imperial
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if imperial bore units
--
------------------------------------------------------------------------

define method .isImperialSavedDist() is BOOLEAN

  return !this.isImperialSavedLength('DIST')

endmethod

------------------------------------------------------------------------
--
-- Method:      isImperialSavedLength
--
-- Description: true if saved distance units are imperial
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if imperial bore units
--
------------------------------------------------------------------------

define method .isImperialSavedLength(!pType is STRING) is BOOLEAN

  return ( !this.getSavedUnitsByPtype(!pType).upcase() inset('IN', 'FINC', 'FT', 'YD', 'MILE', 'THOU') )

endmethod

------------------------------------------------------------------------
--
-- Method:      setUnits
--
-- Description: set units for given dimension. Any error leaves units unchanged
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Dimension (as in UNITS command)
--    2   R      STRING      PTYP corresponding to the dimension
--    3   R      STRING      Units qualifier corresponding to the dimension
-- Return:
--   [Data Type] [Description]
--    STRING     Current units for given PTYP (in case of failure)
--
------------------------------------------------------------------------

define method .setUnits( !dummyDimensionString is STRING,  !pType is STRING, !unitQualifier is STRING) is STRING

  if( !unitQualifier eq 'FINC' ) then
    UNITS FINCH DIST
    handle any
    endhandle
  elseif( !unitQualifier eq '' ) then
    !dimension = object MEASURE(!pType)
    !dimension.numeric()
  else
    !dimension = object MEASURE(!pType)
    !unit      = object UNIT(!unitQualifier)
    !dimension.setUnits(!unit)
  endif
  return !this.getCurrentUnitsByPType(!pType)

endmethod
-- End of method
