---
-- Description:--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  axesFullNames()                  ARRAY               Returns an array of full axis IDs suitable e.g. for OPTION gadgets
--  axesShortNames()                 ARRAY               Returns an array of short axis IDs suitable e.g. for OPTION gadgets
--  axesString(STRING,STRING)        STRING              Returns a string of axis identifiers separated by the given separator
--  axisID(STRING)                   REAL                Translates a XYZ or ENU axis short identifier into an axis index
--  axisIDDirInsensitive(STRING)     REAL                Translates a XYZ or ENU axis short identifier into an index, ignoring -ve and +ve directions
--  coordstransfer()                 -                   Constructor
--  enuDir(STRING)                   STRING
--  enuPos(STRING)                   STRING
--  globalInstance()                 -                   Create Global variable of object
--  isXYZ()                          BOOLEAN
--  isoDirID(STRING)                 REAL                Identifies one of the ISO directions in either the ENU, XYZ or 'ISO[ ]*\d' form
--  isoDirs()                        ARRAY               Returns an array of four ISO view directions in XYZ or ENU system
--  replaceXYZ(STRING)               STRING
--  setCoordAxesOptions(FORM,STRING) -                   Sets the Option gadgets to the pair of coordinate labels (X, -X or E, W, etc.)
--
------------------------------------------------------------------------

define object COORDSTRANSFER

  member .xyzFlag is BOOLEAN
  member .enuAxesShort is ARRAY  $* array of ENU short axis names (E,W,N,S,U,D)
  member .enuAxesFull is ARRAY   $* array of ENU long axis names (East,West,North,...)
  member .xyzAxes is ARRAY       $* array of XYZ short/long axis names (X,-X,Y,-Y,Z,-Z)
  member .enuIsoDir is ARRAY     $* array of ENU isometric directions
  member .xyzIsoDir is ARRAY     $* array of XYZ isometric directions
  member .isoDirLabels is ARRAY  $* array of isometric direction labels

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      coordstransfer
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coordstransfer()

  !this.isXYZ()
  !s = 'X -X Y -Y Z -Z'
  !this.xyzAxes = !s.split()
  !s = 'East West North South Up Down'
  !this.enuAxesFull = !s.split()
  !s = 'E W N S U D'
  !this.enuAxesShort = !s.split()
  !s = '-X 45 -Y 35.26 -Z/-X 45 Y 35.26 -Z/X 45 Y 35.26 -Z/-Y 45 X 35.26 -Z'
  !this.xyzIsoDir = !s.split('/')
  !s = 'W 45 S 35.26 D/W 45 N 35.26 D/E 45 N 35.26 D/S 45 E 35.26 D'
  !this.enuIsoDir = !s.split('/')
  !s = 'ISO 1/ISO 2/ISO 3/ISO 4'
  !this.isoDirLabels = !s.split('/')

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create Global variable of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!coords   = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      isXYZ
--
-- Description: get the flag for XYZ co-ordinate system. True if the co-ordinates system is XYZ.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isXYZ() is BOOLEAN
  var !coord coord
  !this.xyzFlag = !coord.eq('XYZ')
  return !this.xyzFlag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: enuDir
--
-- Description: Gives the equivalent DIRECTION in the ENU  co-ordinate system.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enuDir(!xyzDir is STRING) is STRING

  !dir  = object DIRECTION(!xyzDir)
  handle ANY
    return error noalert
  elsehandle  NONE
    !enuDir = !this.replaceXYZ(!dir.string())
  endhandle

  return !enuDir

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: enuPos
--
-- Description: Gives the equivalent Position in the ENU  co-ordinate system.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enuPos(!xyzPos is STRING) is STRING

  !pos  = object POSITION(!xyzPos)
  handle ANY
    return error noalert
  elsehandle  NONE
    !enuPos = !this.replaceXYZ(!pos.string())
  endhandle

  return !enuPos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: replaceXYZ
--
-- Description: Gives the Directional values of XYZ co-ordinate with equivalent  ENU system.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .replaceXYZ(!xyzVal is STRING) is STRING

  !newVal = !xyzVal.string().before(|WRT|).upcase()
  -- Replacing the XYZ cardinal direction with the ENU direction
  -- really we need not replace X Y and Z
  -- RWF remove AXIS - do not want X to be replace by E
  -- RWF really do not have remove anything other than WRT as Draft DIR syntax will now take AXIS key word
  !enuVal = !newVal.replace('AXIS ', '').replace('-X', 'W').replace('-Y', 'S').replace('-Z', 'D').replace('X', 'E').replace('Y', 'N').replace('Z', 'U')

  return !enuVal

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: axisID
--
-- Description: Translates a XYZ or ENU axis short identifier into an axis index
--              1 - E/X, 2 - W/-X,  3 - N/Y, 4 - S/-Y, 5 - U/Z, 6 - D/-Z, unset - invalid
--
-- Method Type: Function
-- Arguments:
--   1  STRING  The short axis identifier
-- Return:
--   REAL  The axis index
--
------------------------------------------------------------------------
define method .axisID(!axisString is STRING) is REAL
  !n = !this.enuAxesShort.findFirst(!axisString)
  if( !n.unset() ) then
    !n = !this.xyzAxes.findFirst(!axisString.replace('AXIS ', ''))
  endif
  return !n
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: axisIDDirInsensitive
--
-- Description: Translates a XYZ or ENU axis short identifier into an index, ignoring -ve and +ve directions
--              1 - E/W/X/-X, 2 - N/S/Y/-Y, 3 - U/D/Z/-Z, unset - invalid
--
-- Method Type: Function
-- Arguments:
--   1  STRING  The short axis identifier
-- Return:
--   REAL  The axis index
--
------------------------------------------------------------------------
define method .axisIDDirInsensitive(!axisString is STRING) is REAL
  !n = !this.enuAxesShort.findFirst(!axisString)
  if( !n.unset() ) then
    !n = !this.xyzAxes.findFirst(!axisString.replace('AXIS ', ''))
    if( !n.unset() ) then
      return !n
    endif
  endif
  !n = INT( ( !n + 1 ) / 2 )
  return !n
endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method: axesShortNames
--
-- Description: Returns an array of short axis IDs suitable e.g. for OPTION gadgets
--
-- Method Type: Function
-- Arguments:
-- Return:
--   ARRAY  The array of short axes names
--
------------------------------------------------------------------------
define method .axesShortNames() is ARRAY
  if( !this.isXYZ() ) then
    return !this.xyzAxes
  else
    return !this.enuAxesShort
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: axesFullNames
--
-- Description: Returns an array of full axis IDs suitable e.g. for OPTION gadgets
--
-- Method Type: Function
-- Arguments:
-- Return:
--   ARRAY  The array of full axes names
--
------------------------------------------------------------------------
define method .axesFullNames() is ARRAY
  if( !this.isXYZ() ) then
    return !this.xyzAxes
  else
    return !this.enuAxesFull
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: isoDirs
--
-- Description: Returns an array of four ISO view directions in XYZ or ENU system
--
-- Method Type: Function
-- Arguments:
-- Return:
--   ARRAY  The array of full axes names
--
------------------------------------------------------------------------
define method .isoDirs() is ARRAY
  if( !this.isXYZ() ) then
    return !this.xyzIsoDir
  else
    return !this.enuIsoDir
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: axesString
--
-- Description: Returns a string of axis identifiers separated by the given separator
--
-- Method Type: Function
-- Arguments:
--   1  R  STRING  The separator to use for concatenation
--   2  R  STRING  ENU - consider short ENU names only
--                 XYZ - consider XYZ names only
--                 any other - consider both ENU and XYZ names
-- Return:
--   ARRAY  The array of full axes names
--
------------------------------------------------------------------------
define method .axesString(!separator is STRING, !coordSetting is STRING) is STRING
  if( !coordSetting.eq('ENU') ) then
    !s = !separator & !this.enuAxesShort.join(!separator) & !separator
  elseif( !coordSetting.eq('XYZ') ) then
    !s = !separator & !this.xyzAxes.join(!separator) & !separator
  else
    !s = !separator & !this.enuAxesShort.join(!separator) & !separator & !this.xyzAxes.join(!separator) & !separator
  endif
  return !s
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: setCoordAxesOptions
--
-- Description: Sets the Option gadgets to the pair of coordinate labels (X, -X or E, W, etc.)
--    The first gadget gets X/-X or E/W, second Y/-Y or N/S, third Z/-Z or U/D
--    If there are subsequent gadgets in the string, the sequence of axes winds up back to X/-X or E/W, etc.
--
-- Method Type: Procedure
-- Arguments:
--   1  R  FORM    The form owning the gadgets
--   2  R  STRING  Space-separated names of the gadgets to be set (without the leading underscore)
-- Return:
--   ARRAY  The array of full axes names
--
------------------------------------------------------------------------
define method .setCoordAxesOptions(!form is FORM, !gadgetNames is STRING)
  !gNames = !gadgetNames.split()
  !ind = 1
  if( !this.isXYZ() ) then
    do !gName values !gNames
      -- in XYZ mode full and short axes names are the same
      !form.$!gName$n.dText = !this.xyzAxes.from(!ind, 2) $* rText is set automatically to the same
      if( !ind.lt(4) ) then $* 1 -> 3, 3 -> 5
        !ind = !ind + 2
      else
        !ind = 1 $* 5 -> 1
      endif
    enddo
  else $* ENU
    do !gName values !gNames
      !form.$!gName$n.dText = !this.enuAxesFull.from(!ind, 2)
      !form.$!gName$n.rText = !this.enuAxesShort.from(!ind, 2)
      if( !ind.lt(5) ) then
        !ind = !ind + 2
      else
        !ind = 1
      endif
    enddo
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: isoDirID
--
-- Description: Identifies one of the ISO directions in either the ENU, XYZ or 'ISO[ ]*\d' form
--
-- Method Type: Function
-- Arguments:
--   1  R  STRING  The direction string being identified
-- Return:
--   REAL  1, 2, 3 or 4 if identified, otherwise UNSET
--
------------------------------------------------------------------------
define method .isoDirID(!dir is STRING) is REAL
  !ind = !this.enuIsoDir.findFirst(!dir)
  if( !ind.unset() ) then
    !ind = !this.xyzIsoDir.findFirst(!dir.replace('AXIS ', ''))
    if( !ind.unset() ) then
      if( !dir.subString(1,3).eq('ISO') ) then
        !s = '1 2 3 4'
        !ind = !s.split().findFirst(!dir.subString(4).trim())
      endif
    endif
  endif
  return !ind
endmethod
-- End of method
