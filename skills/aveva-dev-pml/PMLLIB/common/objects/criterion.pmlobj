-- File:            criterion.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        ALL
--   Replaces:
--
-- Author:          L.Leppin
-- Created:         Tue Jul 25 11:36:00 GMT 2006
--
-- Description:     container for criterion data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkValue(ANY)                  -                   checks the passed value against
--  complete(REAL,REAL)              -                   completes values
--  criterion()                      -                   Constructor
--  criterion(DBREF)                 -                   constructor
--  description()                    STRING              returns the description
--  input(BORE)                      REAL                return passed value (BORE converted to REAL)
--  input(REAL)                      REAL                return passed value (common interface for BORE)
--  max()                            ANY                 returns the maximum value
--  max(ANY)                         -                   set the maximum value
--  min()                            ANY                 returns the minimum value
--  min(ANY)                         -                   set the minimum value
--  nearestLessValue(ANY)            ANY                 returns value that is nearest to one of the valid values and is less
--  nearestValue(ANY)                ANY                 returns value that is nearest to one of the valid values (assumed to ascending!!!)
--  optimum()                        ANY                 returns the optimum
--  optimum(ANY)                     -                   set the optimum
--  propertyType()                   STRING              returns the property type
--  propertyType(REAL)               ANY                 return passed value as appropriate data type converted to current units
--  string()                         STRING              returns description
--  tolerance()                      REAL                returns the tolerance
--  tolerance(REAL)                  -                   returns the tolerance
--  validValues()                    ARRAY               returns all valid values
--  validValues(ARRAY)               -                   set valid values
--  value()                          ANY                 returns the value
--  value(BORE)                      REAL
--  value(REAL)                      REAL
--
define object CRITERION

  -- description
  member .description       is STRING

  -- minimum value
  member .min               is REAL

  -- maximum value
  member .max               is REAL

  -- optimum
  member .optimum           is REAL

  -- tolerance
  member .tolerance         is REAL

  -- array of valid values
  member .validValues       is ARRAY

  -- formula (this should really be ANY but a member cannot be ANY)
  -- So use an array[1] instead. value could be real or string (PDMS expression)
  member .value             is ARRAY

  -- Property Type
  member .propertyType      is STRING

  -- TODO: SB added for future so when data is changed we can edit the DDAT instead of, as now, where all DDATs are deleted and recreated.
  -- Database Reference
  member .databaseRef       is DBREF

  -- Set status for Maximum, minimum and optimum values
  member .setstatemax       is BOOLEAN
  member .setstatemin       is BOOLEAN
  member .setstateopt       is BOOLEAN

  -- imperial units flag.
  -- This allows values without specific units to be interpreted correctly
  member .imperialUnits     is BOOLEAN


endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      criterion
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .criterion()

  -- Set defaults
  !this.imperialUnits = false
  if (!this.propertyType.unset()) then
    !this.propertyType = 'DIST'
  endif
  if (!this.description.unset()) then
    !this.description = ''
  endif
  if (!this.tolerance.unset()) then
    !this.tolerance = 0
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      criterion
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DDAT element the data are taken from
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .criterion(!data is DBREF)

  !this.criterion()

  -- exit if passed dbref is not DDAT
  if (!data.type.neq('DDAT')) then
    return
  endif

  -- set reference and units
  !this.databaseRef   = !data
  !this.imperialUnits = !data.ownls[!data.ahlis.findfirst('APPLDW')].function.upcase().trim().eq('IMPERIAL')
  handle ANY
  endhandle

  -- set optimum value
  !this.optimum = !data.fdepd.ddat
  handle  ANY
  endhandle

  -- set max/min value
  if (!data.maxmin.size().eq(2)) then
    !this.max = !this.value(!data.maxmin[1]).max(!this.value(!data.maxmin[2]))
    !this.min = !this.value(!data.maxmin[1]).min(!this.value(!data.maxmin[2]))
  endif

  -- set property type
  if (!data.ptype.empty().not()) then
    !this.propertyType = !data.ptype
  endif

  if (!this.description.empty()) then
    if (!data.dtitl.empty().not()) then
      !this.description = !data.dtitl
    endif
  endif

  -- valid values
  do !vval values !data.memb
    !value = REAL()
    skip if (!vval.type.neq('VVALUE'))
    !value = !vval.ldpr.vali.real()
    handle ANY
      skip
    endhandle
    !this.validValues.append(!value)
  enddo
  !this.validValues.sort()

  -- tolerance
  !this.tolerance = !data.ptoler

  -- complete data
  if (!this.min.unset()) then
    if (!this.validValues.set()) then
      !this.min = !this.validValues.first()
      !this.max = !this.validValues.last()
      if (!this.optimum.unset()) then
        !this.optimum = !this.min
      endif
    else
      if (!this.optimum.set()) then
        !this.min = !this.optimum
        !this.max = !this.optimum
      endif
    endif
  else
    if (!this.optimum.unset()) then
      !this.optimum = !this.min
    endif
  endif

  if ( !this.min.unset() ) then
    return error 1 'Empty or unset passed object'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        default minimum value
--    2   R      REAL        default minimum value
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete(!min is REAL, !max is REAL)

  !this.setstatemax  = !this.max.set()
  !this.setstatemin  = !this.min.set()
  !this.setstateopt  = !this.optimum.set()

  -- there is a set of valid values
  if ( !this.validValues.empty().not() ) then
    !this.validValues = !this.validValues.sort()
    !this.min = !this.validValues.first()
    !this.max = !this.validValues.last()

    -- if optimum is unset uses the first valid value
    if ( !this.optimum.unset() ) then
      !this.optimum   = !this.validValues.first()
    endif

  -- handles min and max limits
  else
    if ( !this.min.unset() ) then
      if ( !this.optimum.set() ) then
        !this.min = !this.optimum
      else
        !this.min(!min)
      endif
    endif

    if ( !this.max.unset() ) then
      if ( !this.optimum.set() ) then
        !this.max = !this.optimum
      else
        !this.max(!max)
      endif
    endif

    if ( !this.optimum.unset() ) then
      !this.optimum = !this.min
    endif
  endif

  -- tolerance
  if ( !this.tolerance.unset() ) then
    !this.tolerance = 0
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      description
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      description
------------------------------------------------------------------------

define method .description() is STRING

  -- checks if the description is defined
  if ( !this.description.set() ) then
    return !this.description
  else
    return ''
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      min
--
-- Description: returns the minimum value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ANY         REAL or BORE value
------------------------------------------------------------------------

define method .min() is ANY

  return !this.propertyType(!this.min)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      min
--
-- Description: set the minimum value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         REAL or BORE value
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .min(!value is ANY)

  !this.min = !this.input(!value)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      max
--
-- Description: returns the maximum value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        maximum value
------------------------------------------------------------------------

define method .max() is ANY

  return !this.propertyType(!this.max)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      max
--
-- Description: set the maximum value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         REAL or BORE value
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .max(!value is ANY)

  !this.max = !this.input(!value)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      optimum
--
-- Description: returns the optimum
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        optimum
------------------------------------------------------------------------

define method .optimum() is ANY

  return !this.propertyType(!this.optimum)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      optimum
--
-- Description: set the optimum
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         REAL or BORE value
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .optimum(!value is ANY)

  !this.optimum = !this.input(!value)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tolerance
--
-- Description: returns the tolerance
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        tolerance
------------------------------------------------------------------------

define method .tolerance() is REAL

  -- checks if the tolerance is defined
  if ( !this.tolerance.set() ) then
    if( !this.imperialUnits ) then
      !unit = 'inch'
    else
      !unit = 'mm'
    endif
    !result = !!comConvertUnknownValue(!this.tolerance, !unit)
  else
    !result = 0mm
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tolerance
--
-- Description: returns the tolerance
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        tolerance
------------------------------------------------------------------------

define method .tolerance(!value is REAL)

  !this.tolerance = !this.input(!value)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validValues
--
-- Description: returns all valid values
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       valid values
------------------------------------------------------------------------

define method .validValues() is ARRAY

  !result = ARRAY()
  do !value values !this.validValues
    !result.append(!this.propertyType(!value))
    handle ANY
    endhandle
  enddo
  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validValues
--
-- Description: set valid values
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    ARRAY       valid values
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validValues(!values is ARRAY)

  !validValues = ARRAY()
  do !value values !values
    !validValues.append(!this.input(!value))
    handle ANY
    endhandle
  enddo

  !this.validValues = !validValues

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      value
--
-- Description: returns the value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING       value
------------------------------------------------------------------------

define method .value() is ANY

  return !this.value

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      propertyType
--
-- Description: returns the property type
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING        property type
------------------------------------------------------------------------

define method .propertyType() is STRING

  return !this.propertyType

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkValue
--
-- Description: checks the passed value against
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Value to checked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkValue(!inputValue is ANY)

  -- returned errors:
  -- 1   value is less than minimum
  -- 2   value is greater than maximum
  -- 3   value doesn't match any of valid values

  !tolerance = !this.tolerance()

  -- get current units
  !value     = !this.value(!inputValue)
  !min       = !this.min()
  !max       = !this.max()

  -- round off value
  !strValue  = !value.string()
  !strMin    = !min.string()
  !strMax    = !max.string()

  if (!this.validValues.set()) then
  -- compare passed value to valid values in array
    !isValid = FALSE
    do !validval values !this.validValues
      skip if (!validval.objectType().neq('REAL'))
      !min = !validval - !tolerance
      !max = !validval + !tolerance
      if (!value.between(!min,!max)) then
        !isValid = TRUE
        break
      endif
    enddo
    if (!isValid.not()) then
      !errorText = !this & ' (' & !strValue & ') does not match any of the valid values'
      !errorText = !errorText.replace(|'|,|''|)
      return error 3 '$!errorText'
    endif
  else
  -- check whether it is within min and max
    if (!value.lt(!min)) then
      !errorText = !this & ' (' & !strValue & ') is less than minimum specified (' & !strMin & ')'
      !errorText = !errorText.replace(|'|,|''|)
      return error 1 '$!errorText'
    endif
    if (!value.gt(!max)) then
      !errorText = !this & ' (' & !strValue & ') is greater than maximum specified (' & !strMax & ')'
      !errorText = !errorText.replace(|'|,|''|)
      return error 2 '$!errorText'
    endif
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      nearestValue
--
-- Description: returns value that is nearest to one of the valid values (assumed to be ascending!!!)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         passed value
--
-- Return:
--   [Data Type] [Description]
--    ANY         "best" nearest value
--
------------------------------------------------------------------------

define method .nearestValue(!value is ANY) is ANY

  !nearest = REAL()

  if (!this.validValues.unset()) then
  -- return unset value if there is no valid value defined
    return !nearest
  endif

  !validValues = !this.validValues()

  !minDifference = abs(!value - !validValues[1])
  !minIndex      = 1

  do !index indices !validValues
    !diff = abs(!value - !validValues[!index])
    skip if( !diff gt !minDifference )
    !minDifference = !diff
    !minIndex      = !index
  enddo

  -- return result
  return !validValues[!minIndex]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nearestLessValue
--
-- Description: returns value that is nearest to one of the valid values and is less
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         passed value
--
-- Return:
--   [Data Type] [Description]
--    ANY         nearest less value
--
------------------------------------------------------------------------

define method .nearestLessValue(!value is ANY) is ANY

  !allValidValues = !this.validValues()

  -- remove valid values greater than the given value
  !validValues = ARRAY()
  do !v values !allValidValues
    if( !value gt !v ) then
      !validValues.append(!v)
    endif
  enddo

  if (!validValues.empty()) then
  -- return passed value if there is no valid value defined
    return object REAL()
  endif

  !minDifference = abs(!value - !validValues[1])
  !minIndex      = 1

  do !index indices !validValues
    !diff = abs(!value - !validValues[!index])
    skip if( !diff gt !minDifference )
    !minDifference = !diff
    !minIndex      = !index
  enddo

  -- return result
  return !validValues[!minIndex]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: returns description when object is converted to string
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Object description
------------------------------------------------------------------------

define method .string() is STRING

  return !this.description

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      propertyType
--
-- Description: return passed value as appropriate data type converted to current units
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        value to be returned
-- Return:
--   [Data Type] [Description]
--    ANY         Returned value (REAL or BORE)
------------------------------------------------------------------------

define method .propertyType(!value is REAL) is ANY

  !ptyp = !this.propertyType
  --!ptyp = 'REAL'

  if (!ptyp.eq('BORE')) then
  -- convert REAL to BORE
    if (!this.imperialUnits) then
      !buni = 'in'
    else
      !buni = 'mm'
    endif
    !result = object BORE(!value.value() & !buni)
  else
  -- return REAL value
    !result = !value
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      input
--
-- Description: return passed value to nearest bore value if BORE PTYPE
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        REAL value
-- Return:
--   [Data Type] [Description]
--    REAL        Real value - to nearest bore if BORE PTYPE
------------------------------------------------------------------------

define method .input(!value is REAL) is REAL

  !ptyp = !this.propertyType
  if (!ptyp.eq('BORE')) then
    !result = !value.bore().string().real()
  else
  -- return REAL value
    !result = !value
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      input
--
-- Description: return passed value converted to REAL
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BORE        BORE value to be converted to REAL
-- Return:
--   [Data Type] [Description]
--    REAL        Real value
------------------------------------------------------------------------

define method .input(!value is BORE) is REAL

  return !value.string().real()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      input
--
-- Description: return passed value (common interface for BORE)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       REAL value
-- Return:
--   [Data Type] [Description]
--    REAL        Real value
------------------------------------------------------------------------

define method .value(!value is REAL) is REAL

  return !value

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      input
--
-- Description: return passed value (BORE converted to REAL)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BORE        BORE value to be converted to REAL
-- Return:
--   [Data Type] [Description]
--    REAL        Returned REAL value
------------------------------------------------------------------------

define method .value(!value is BORE) is REAL

  if( !value.unset() ) then
    return 0mm
  else
    return !value.string().real()
  endif

endmethod
-- End of method
