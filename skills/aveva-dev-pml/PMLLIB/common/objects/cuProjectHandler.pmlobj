------------------------------------------------------------------------
-- Method:      beginUpdate
--
-- Description:
--   Add actions before updating the whole set of accepted objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      BOOLEAN     True/False Link inserted elements
--   2   R      BOOLEAN     True/False Link matched elements
--   3   R      BOOLEAN     True/False Update attributes for linked inserted elements
--   4   R      BOOLEAN     True/False Update attributes for linked matched elements
--   5   R      BOOLEAN     True/False Unlink selected elements
--   6   R      DBREF       Owner to be used if not overridden per element
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beginUpdate(!linkInsertedElements is BOOLEAN, !linkMatchedElements is BOOLEAN, !updateLinkedInsertedElements is BOOLEAN, !updateLinkedMatchedElements is BOOLEAN, !unlinkElements is BOOLEAN, !ownerElement is DBREF) is STRING

  -- Initialise
  !this.linkInsertedElements         = !linkInsertedElements
  !this.linkMatchedElements          = !linkMatchedElements
  !this.updateLinkedInsertedElements = !updateLinkedInsertedElements
  !this.updateLinkedMatchedElements  = !updateLinkedMatchedElements
  !this.unlinkElements               = !unlinkElements
  !this.ownerElement                 = !ownerElement

  -- Trace
  if (!this.debug) then
    if (!this.ownerElement.badref()) then
      !owner = |unset|
    else
      !owner = !ownerElement.flnm
    endif
    !output = |..cuProjectHandler.beginUpdate(| & !linkInsertedElements & |, | & !linkMatchedElements & |, | & !updateLinkedInsertedElements & |, | & !updateLinkedMatchedElements & |, | & !unlinkElements & |, | & !owner & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Add actions here before updating the whole set of accepted objects
  --====================================================================
  -- Start of customisation



  -- End of customisation
  --====================================================================

  -- A non-blank return message will abort the whole update
  return !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeUpdate(DBREF, DBREF, STRING)
--
-- Description:
--   Add actions before updating when the matched source object is a dbref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       Source object
--   2   R      DBREF       Destination object
--   3   R      STRING      Destination object type
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beforeUpdate(!sourceElement is DBREF, !destinationElement is DBREF, !destinationType is STRING) is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.beforeUpdate(| & !sourceElement.flnm & |, | & !destinationElement.flnm & |, | & !destinationType & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Add actions here before updating when the matched source object is a dbref
  --====================================================================
  -- Start of customisation

  $(
  -- Example set the value for Import Status to Updateable so that the destination object may be updated
  -- Note this works with a status definition with two values Updateable number 0 and Updated number 100
  -- and a DAC that has condition ( ATTRIB STVNUM(ID /ImportStatus ) GE 50)) to deny modify and delete
  !status = object STATUSDATA(!destinationElement, |/ImportStatus|)
  if (!status.number.unset()) then
    !status.assign()
  else
    !status.set('/Updateable')
  endif
  $)

  -- End of customisation
  --====================================================================

  -- A non-blank return message will skip update of this object
  return !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeUpdate(STRING, DBREF, STRING)
--
-- Description:
--   Add actions before updating when the matched source object is an external named string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      ID of source object
--   2   R      DBREF       Destination object
--   2   R      STRING      Destination object type
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beforeUpdate(!sourceId is STRING, !destinationElement is DBREF, !destinationType is STRING) is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.beforeUpdate(| & !sourceId & |, | & !destinationElement.flnm & |, | & !destinationType & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Add actions here before updating when the matched source object is an external named string
  --====================================================================
  -- Start of customisation

  $(
  -- Example set the value for Import Status to Updateable so that the destination object may be updated
  -- Note this works with a status definition with two values Updateable number 0 and Updated number 100
  -- and a DAC that has condition ( ATTRIB STVNUM(ID /ImportStatus ) GE 50)) to deny modify and delete
  !status = object STATUSDATA(!destinationElement, |/ImportStatus|)
  if (!status.number.unset()) then
    !status.assign()
  else
    !status.set('/Updateable')
  endif
  $)

  -- End of customisation
  --====================================================================

  -- A non-blank return message will skip update of this object
  return !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeUpdate(DBREF, STRING, DBREF)
--
-- Description:
--   Add actions before updating when the unmatched source object is a dbref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       Source object
--   2   R      STRING      Destination object type
--   3   RW     DBREF       Owner to be used for this object
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beforeUpdate(!sourceElement is DBREF, !destinationType is STRING, !ownerRef is DBREF) is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.beforeUpdate(| & !sourceElement.flnm & |, | & !destinationType & |, | & !ownerRef & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Unset new owner means use owner specified for run
  !newOwner = object DBREF()

  -- Add actions here before updating when the unmatched source object is a dbref
  --====================================================================
  -- Start of customisation

  $(
  -- Example do not update if source element is below Status Work in Progress
  !status = object STATUSDATA(!sourceElement, |/Status|)
  !statusNumber = !status.number
  if (!statusNumber.unset()) then
    !statusNumber = 0
  endif
  if (!statusNumber lt 50) then
    !returnMessage = |Source object | & !sourceElement.flnm & | has not reached Work in Progress Status yet|
  endif
  $)

  $(
  -- Example to set owner based on source data and create it if not existing
  if (!destinationType eq |EQUIPMENT| ) then
    if (!sourceElement.name.match(|21-|) gt 0) then
      !location = !!ce
      /ZONE-21
      handle any
        /DEMO-SITE
        new zone /ZONE-21
      endhandle
      !newOwner = !!ce
      !!ce = !location
    endif
  endif

  -- Example to set owner based on configuration name and return error if the owner is not available
  if (!this.configurationName eq 'Design Equipment') then
    /GROUP-21
    handle any
      !returnMessage = |Owner element specified in callback does not exist|
    elsehandle none
      !newOwner = !!ce
    endhandle
  endif
  $)

  -- End of customisation
  --====================================================================

  -- A valid owner means it will override the owner specified for the run
  !ownerRef = !newOwner

  -- A non-blank return message will skip update of this object
  return !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeUpdate(STRING, STRING, DBREF)
--
-- Description:
--   Add actions before updating when the unmatched source object is an external named string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      ID of source object
--   2   R      STRING      Destination object type
--   3   RW     DBREF       Owner to be used for this object
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beforeUpdate(!sourceId is STRING, !destinationType is STRING, !ownerRef is DBREF) is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.beforeUpdate(| & !sourceId & |, | & !destinationType & |, | & !ownerRef & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Unset new owner means use owner specified for run
  !newOwner = object DBREF()

  -- Add actions here before updating when the unmatched source object is an external named string
  --====================================================================
  -- Start of customisation



  -- End of customisation
  --====================================================================

  -- A valid owner means it will override the owner specified for the run
  !ownerRef = !newOwner

  -- A non-blank return message will skip update of this object
  return !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeUpdate(DBREF, STRING)
--
-- Description:
--   Add actions before updating when the unmatched destination object is a dbref
--
-- Method Type: Function/Procedure
