------------------------------------------------------------------------
-- Method:      raiseEvents
--
-- Description:
--   Switch events on or off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     True if events are to be run
------------------------------------------------------------------------
define method .raiseEvents() is BOOLEAN

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.raiseEvents()|
    write !output
  endif

  -- Set this TRUE to switch events ON
  !raiseEvents = TRUE

  --====================================================================
  -- Start of customisation



  -- End of customisation
  --====================================================================

  -- FALSE in return value will switch off all Compare/Update other PML callback events
  return !raiseEvents

endmethod

------------------------------------------------------------------------
-- Method:      beginCompare
--
-- Description:
--   Add checks before comparing the whole set of objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Current module
--   2   R      STRING      Configuration name
--   3   R      STRING      Source database type
--   4   R      STRING      Source type
--   5   R      STRING      Destination database type
--   6   R      STRING      Destination type
--   7   R      STRING      Mode: Source or Destination
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beginCompare(!module is STRING, !configurationName is STRING, !sourceDatabase is STRING, !sourceType is STRING, !destinationDatabase is STRING, !destinationType is STRING, !mode is STRING) is STRING

  -- Initialise
  !this.module              = !module
  !this.configurationName   = !configurationName
  !this.sourceDatabase      = !sourceDatabase
  !this.sourceType          = !sourceType
  !this.destinationDatabase = !destinationDatabase
  !this.destinationType     = !destinationType
  !this.mode                = !mode

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.beginCompare(| & !this.module & |, | & !this.configurationName & |, | & !this.sourceDatabase & |, | & !this.sourceType & |, | & !this.destinationDatabase & |, | & !this.destinationType & |, | & !this.mode & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Add checks here before comparing the whole set of objects
  --====================================================================
  -- Start of customisation



  -- End of customisation
  --====================================================================

  -- A non-blank return message will abort the whole run
  return !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeCompare(DBREF)
--
-- Description:
--   Add checks before comparing a source/destination object that is a dbref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       Object to be compared
-- Return:
--   [Data Type] [Description]
--   STRING      Return message
------------------------------------------------------------------------
define method .beforeCompare(!element is DBREF) is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.beforeCompare(| & !element.flnm & |)|
    write !output
  endif

  -- Blank return message means no error
  !returnMessage = ||

  -- Add checks here before comparing a source/destination object that is a dbref
  --====================================================================
  -- Start of customisation

  $(
  -- Example do not compare if source element is below Status Identified
  !status = object STATUSDATA(!element, |/Status|)
  !statusNumber = !status.number
  if (!statusNumber.unset()) then
    !statusNumber = 0
  endif
  if (!statusNumber lt 10) then
    !returnMessage = |Source object | & !element.flnm & | has not reached Identified Status yet|
  endif
  $)

  -- End of customisation
  --====================================================================

  -- A non-blank return message will skip comparison of this object
  return !returnMessage

endmethod

