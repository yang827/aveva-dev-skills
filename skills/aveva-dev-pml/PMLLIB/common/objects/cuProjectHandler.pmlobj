------------------------------------------------------------------------
-- Method:      getUpdateResults
--
-- Description:
--   Capture the update results grid content
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   STRING      File path for update grid results
------------------------------------------------------------------------
define method .getUpdateResults() is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.getUpdateResults()|
    write !output
  endif

  -- Blank file path means do not save results to file
  !filePath = ||

  -- Capture the update results grid content
  --====================================================================
  -- Start of customisation

  $(
  -- Example path for update results Excel file
  !filePath = |C:\temp\updateResults.xls|
  $)

  -- End of customisation
  --====================================================================

  -- A non-blank file path will trigger the file to be written
  return !filePath

endmethod
