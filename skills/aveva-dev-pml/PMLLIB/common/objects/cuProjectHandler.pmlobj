-- File:            cuProjectHandler.pmlobj
--   Type:          Object Definition
--   Group:         Compare/Update
--
--    Keyword:      Integrator
--    Module:       General
--
-- Author:          Mac Lewis
-- Created:         Fri Oct 25   15:03:01  2013
--
-- Description:
-- Compare/Update project customisable event handler
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  afterCompare(BOOLEAN,STRING,DBREF) -                   Add actions after comparing an unmatched source or destination object that is a dbref
--  afterCompare(BOOLEAN,STRING,DBREF,DBREF) -                   Add actions after comparing a matched source objects that is a dbref
--  afterCompare(BOOLEAN,STRING,STRING) -                   Add actions after comparing an unmatched source object that is an external named string
--  afterCompare(BOOLEAN,STRING,STRING,DBREF) -                   Add actions after comparing a matched source object that is an external named string
--  afterUpdate(BOOLEAN,STRING,DBREF,ARRAY) -                   Add actions after updating when the unmatched source or destination object is a dbref
--  afterUpdate(BOOLEAN,STRING,DBREF,DBREF,ARRAY) -                   Add actions after updating when the matched source object is a dbref
--  afterUpdate(BOOLEAN,STRING,STRING,ARRAY) -                   Add actions after updating when the unmatched source object is an external named string
--  afterUpdate(BOOLEAN,STRING,STRING,DBREF,ARRAY) -                   Add actions after updating when the matched source object is an external named string
--  beforeCompare(DBREF)             STRING              Add checks before comparing a source/destination object that is a dbref
--  beforeCompare(STRING)            STRING              Add checks before comparing a source object that is an external named string
--  beforeUpdate(DBREF,DBREF,STRING) STRING              Add actions before updating when the matched source object is a dbref
--  beforeUpdate(DBREF,STRING)       STRING              Add actions before updating when the unmatched destination object is a dbref
--  beforeUpdate(DBREF,STRING,DBREF) STRING              Event
--  beforeUpdate(STRING,DBREF,STRING) STRING              Add actions before updating when the matched source object is an external named string
--  beforeUpdate(STRING,STRING,DBREF) STRING              Event
--  beginCompare(STRING,STRING,STRING,STRING,STRING,STRING,STRING) STRING              Add checks before comparing the whole set of objects
--  beginUpdate(BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,DBREF) STRING              Add actions before updating the whole set of accepted objects
--  cuProjectHandler()               -                   Constructor
--  debugOff()                       -                   Clear debug flag
--  debugOn()                        -                   Set debug flag
--  endCompare()                     STRING              Event
--  endUpdate()                      -                   Event
--  getCompareResults()              STRING              Event
--  getUpdateResults()               STRING              Event
--  raiseEvents()                    BOOLEAN             Switch events on or off
--

--
------------------------------------------------------------------------

define object CUPROJECTHANDLER

  member .debug                         is BOOLEAN
  -- Module
  member .module                        is STRING
  -- Mode: Source or Destination
  member .mode                          is STRING
  -- Selected configuration name
  member .configurationName             is STRING
  -- Source database type
  member .sourceDatabase                is STRING
  -- Source type
  member .sourceType                    is STRING
  -- Destination database type
  member .destinationDatabase           is STRING
  -- Destination type
  member .destinationType               is STRING
	-- Update setting for link inserted elements
  member .linkInsertedElements          is BOOLEAN
	-- Update setting for link matched elements
  member .linkMatchedElements           is BOOLEAN
	-- Update setting for update linked inserted elements
  member .updateLinkedInsertedElements  is BOOLEAN
	-- Update setting for update linked matched elements
  member .updateLinkedMatchedElements   is BOOLEAN
	-- Update setting for unlink elements
  member .unlinkElements                is BOOLEAN
	-- Update setting for owner element
  member .ownerElement                  is DBREF

  -- Add any members required for customisation
  --====================================================================
  -- Start of customisation



  -- End of customisation
  --====================================================================

endobject

