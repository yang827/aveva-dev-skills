------------------------------------------------------------------------
-- Method:      endCompare
--
-- Description:
--   Add actions after comparing the whole set of objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   STRING      File path to capture list of skipped objects and reasons
------------------------------------------------------------------------
define method .endCompare() is STRING

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.endCompare()|
    write !output
  endif

  -- Blank  file path means do not save list of skipped objects and reasons
  !filePath = ||

  -- Add actions here after comparing the whole set of objects
  --====================================================================
  -- Start of customisation

  $(
  -- Example file path for skipped objects and reasons
  !filePath = |C:\temp\CompareUpdateSkippedObjects.csv|
  $)

  -- End of customisation
  --====================================================================

  -- A non-blank file path will trigger the file to be written
  return !filePath

endmethod

