------------------------------------------------------------------------
-- Method:      afterUpdate(BOOLEAN, STRING, DBREF, DBREF, ARRAY)
--
-- Description:
--   Add actions after updating when the matched source object is a dbref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      BOOLEAN     True if update result is Ok
--   2   R      STRING      Update result: Ok or specific error message as output in grid
--   3   R      DBREF       Source object
--   4   R      DBREF       Destination object
--   5   R      ARRAY       Updated attributes
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .afterUpdate(!updateOk is BOOLEAN, !updateResult is STRING, !sourceElement is DBREF, !destinationElement is DBREF, !updatedAttributes is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.afterUpdate(| & !updateResult & |, | & !sourceElement.flnm & |, | & !destinationElement.flnm & |)|
    write !output
  endif

  -- Add actions here after updating when the matched source object is a dbref
  --====================================================================
  -- Start of customisation

  $(
   -- Example promote the destination element to Status Work in Progress
  !status = object STATUSDATA(!destinationElement, |/Status|)
  if (!status.number.unset()) then
    !status.assign()
  endif
  if (!status.number lt 50) then
    !status.promote()
  endif
  $)

  $(
  -- Example rename branches of pipe when pipe name has been updated due to change in line name
  if (!destinationElement.type eq |PIPE|) then
    if (!updatedAttributes.findFirst(|NAME|).set()) then
      do !member values !destinationElement.members
        if (!member.type eq |BRAN|) then
          !member.name = !destinationElement.name & |/B| & !member.name.after(|/B|)
        endif
      enddo
    endif
  endif
  $)

  $(
  -- Example update autonaming of offspring (note not applied to the destination element itself)
  !location = !!ce
  do !member values !destinationElement.members
    !!ce = !member
    !!autoNameCE(TRUE)
  enddo
  !!ce = !location
  $)

  $(
  -- Example set the value for Import Status to Updated so that the destination object may not be updated
  -- Note this works with a status definition with two values Updateable number 0 and Updated number 100
  -- and a DAC that has condition ( ATTRIB STVNUM(ID /ImportStatus ) GE 50)) to deny modify and delete
  !status = object STATUSDATA(!destinationElement, |/ImportStatus|)
  if (!status.number.unset()) then
    !status.assign()
  endif
  !status.set('/Updated')
  $)

  -- End of customisation
  --====================================================================

endmethod

------------------------------------------------------------------------
-- Method:      afterUpdate(BOOLEAN, STRING, STRING, DBREF, ARRAY)
--
-- Description:
--   Add actions after updating when the matched source object is an external named string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      BOOLEAN     True if update result is Ok
--   2   R      STRING      Update result: Ok or specific error message as output in grid
--   3   R      STRING      ID of source object
--   4   R      DBREF       Destination object
--   5   R      ARRAY       Updated attributes
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .afterUpdate(!updateOk is BOOLEAN, !updateResult is STRING, !sourceId is STRING, !destinationElement is DBREF, !updatedAttributes is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |..cuProjectHandler.afterUpdate(| & !updateResult & |, | & !sourceId & |, | & !destinationElement.flnm & |)|
    write !output
  endif

  -- Add actions here after updating when the matched source object is an external named string
  --====================================================================
  -- Start of customisation

  $(
  -- Example set the value for Import Status to Updated so that the destination object may not be updated
  -- Note this works with a status definition with two values Updateable number 0 and Updated number 100
  -- and a DAC that has condition ( ATTRIB STVNUM(ID /ImportStatus ) GE 50)) to deny modify and delete
  !status = object STATUSDATA(!destinationElement, |/ImportStatus|)
  if (!status.number.unset()) then
    !status.assign()
  endif
  !status.set('/Updated')
  $)

  -- End of customisation
  --====================================================================

endmethod

