--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            cuSupportHandler.pmlobj
--   Type:          Object Definition
--   Group:         Compare/Update
--
--    Keyword:      Integrator
--    Module:       General
--
-- Author:          Mac Lewis
-- Created:         Fri Oct 25   15:03:01  2013
--
-- Description:
-- Compare/Update event handler
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  afterCompare(ARRAY)              -                   Event
--  afterUpdate(ARRAY)               -                   Event
--  beforeCompare(ARRAY)             -                   Event
--  beforeUpdate(ARRAY)              -                   Event
--  beginCompare(ARRAY)              -                   Event
--  beginUpdate(ARRAY)               -                   Event
--  cuSupportHandler()               -                   Constructor
--  debugOff()                       -                   Clear debug flag
--  debugOn()                        -                   Set debug flag for project handler
--  debugOnFull()                    -                   Set debug flag for project handler and support handler
--  endCompare(ARRAY)                -                   Event
--  endUpdate(ARRAY)                 -                   Event
--  getCompareResults(ARRAY)         -                   Event
--  getUpdateResults(ARRAY)          -                   Event
--  globalInstance()                 -                   Create global instance of object
--  instantiateEquipment(DBREF,DBREF) -                   Instantiate equipment template
--  raiseEvents(ARRAY)               -                   Switch events on or off
--

--
------------------------------------------------------------------------

define object CUSUPPORTHANDLER

  member .debug                         is BOOLEAN
  -- Array of core application instance objects
  member .coreObject                    is ARRAY
  -- Core application instance used by this object
  member .instance                      is REAL
  -- Flag for invoked from GUI or command line
  member .fromGUI                       is BOOLEAN
  -- Objects and their messages skipped before compare, comma separated strings of |object id, message|
  member .skippedObjects                is ARRAY
  -- Mode: Source or Destination
  member .mode                          is STRING
  -- Selected configuration name
  member .configurationName             is STRING
  -- Source database type
  member .sourceDatabase                is STRING
  -- Source type
  member .sourceType                    is STRING
  -- Destination database type
  member .destinationDatabase           is STRING
  -- Destination type
  member .destinationType               is STRING
	-- Update setting for link inserted elements
  member .linkInsertedElements          is BOOLEAN
	-- Update setting for link matched elements
  member .linkMatchedElements           is BOOLEAN
	-- Update setting for update linked inserted elements
  member .updateLinkedInsertedElements  is BOOLEAN
	-- Update setting for update linked matched elements
  member .updateLinkedMatchedElements   is BOOLEAN
	-- Update setting for unlink elements
  member .unlinkElements                is BOOLEAN
	-- Update setting for owner element
  member .ownerElement                  is DBREF
	
endobject

------------------------------------------------------------------------
-- Method:      cuSupportHandler
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .cuSupportHandler()

  -- Initialise
  !this.debug   = FALSE
  !this.fromGUI = FALSE

  -- Setup global cuSupportHandler
  if (not defined(!!cuSupportHandler)) then
    !this.globalInstance()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  using namespace 'Aveva.Pdms.InstrumentationImport.Addin'

  -- Create global variables
  if (not defined(!!cuSupportHandler)) then
    !!cuSupportHandler = !this
    !!cuProjectHandler = object CUPROJECTHANDLER()

    -- Provide some synonyms
    if (not istty) then
      !!command(|$$S cuDebugOn      = !!cuSupportHandler.debugOn()|)
      !!command(|$$S cuDebugOnFull  = !!cuSupportHandler.debugOnFull()|)
      !!command(|$$S cuDebugOff     = !!cuSupportHandler.debugOff()|)
    endif

    -- Set the application instance number to be used by this object
    !!cuSupportHandler.instance = 1
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance] = object INSTRUMENTATIONIMPORTPMLNET()

    -- Add the event handlers
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|BeginCompare|,      !!cuSupportHandler, |BeginCompare|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|BeforeCompare|,     !!cuSupportHandler, |BeforeCompare|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|AfterCompare|,      !!cuSupportHandler, |AfterCompare|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|EndCompare|,        !!cuSupportHandler, |EndCompare|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|GetCompareResults|, !!cuSupportHandler, |GetCompareResults|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|BeginUpdate|,       !!cuSupportHandler, |BeginUpdate|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|BeforeUpdate|,      !!cuSupportHandler, |BeforeUpdate|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|AfterUpdate|,       !!cuSupportHandler, |AfterUpdate|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|EndUpdate|,         !!cuSupportHandler, |EndUpdate|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|GetUpdateResults|,  !!cuSupportHandler, |GetUpdateResults|)
    !!cuSupportHandler.coreObject[!!cuSupportHandler.instance].addEventHandler(|RaisePMLEvent|,     !!cuSupportHandler, |raiseEvents|)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      debugOn
--
-- Description:
--   Set debug flag for project handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .debugOn()

  -- Set debug flag for project handler only
  !this.debug = FALSE
  !!cuProjectHandler.debugOn()

endmethod

------------------------------------------------------------------------
-- Method:      debugOnFull
--
-- Description:
--   Set debug flag for project handler and support handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .debugOnFull()

  -- Set debug flag for project and support handler
  !this.debug = TRUE
  !!cuProjectHandler.debugOn()

endmethod

------------------------------------------------------------------------
-- Method:      debugOff
--
-- Description:
--   Clear debug flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .debugOff()

  -- Clear debug flag for project and support handler
  !this.debug = FALSE
  !!cuProjectHandler.debugOff()

endmethod

------------------------------------------------------------------------
-- Method:      raiseEvents
--
-- Description:
--   Switch events on or off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  RW  STRING    TRUE or FALSE
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .raiseEvents(!args is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.raiseEvents()|
    write !output
  endif

  -- FALSE in return message will switch off all Compare/Update other PML callback events
  !returnFlag = !!cuProjectHandler.raiseEvents()
  if (!this.debug) then
    if (!returnFlag) then
      write |Events on|
    else
      write |Events off|
    endif
  endif
  !args[0] = !returnFlag.string()

endmethod

------------------------------------------------------------------------
-- Method:      beginCompare
--
-- Description:
--   Event callback before comparing all objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    TRUE if invoked from GUI, FALSE if invoked from command line
--   args[1]  R   STRING    Configuration name
--   args[2]  R   STRING    Source database type
--   args[3]  R   STRING    Source type
--   args[4]  R   STRING    Destination database type
--   args[5]  R   STRING    Destination type
--   args[6]  R   STRING    Mode: Source or Destination
--   args[7]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beginCompare(!args is ARRAY)

  -- Initialise
  !session                  = CURRENT SESSION
  !module                   = !session.module()
  !this.skippedObjects      = ARRAY()
  !this.fromGUI             = !args[0].boolean()
  !this.configurationName   = !args[1]
  !this.sourceDatabase      = !args[2]
  !this.sourceType          = !args[3]
  !this.destinationDatabase = !args[4]
  !this.destinationType     = !args[5]
  !this.mode                = !args[6]

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.beginCompare(| & !this.fromGUI & |, | & !this.configurationName & |, | & !this.sourceDatabase & |, | & !this.sourceType & |, | & !this.destinationDatabase & |, | & !this.destinationType & |, | & !this.mode & |)|
    write !output
  endif

  -- Actions before comparing all objects
  !returnMessage = !!cuProjectHandler.beginCompare(!module, !this.configurationName, !this.sourceDatabase, !this.sourceType, !this.destinationDatabase, !this.destinationType, !this.mode)

  -- A non-blank return message will abort the whole run
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[7] = !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeCompare
--
-- Description:
--   Event callback before comparing each object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Source ID type: Dbref or Other
--   args[1]  R   STRING    Object ID e.g. dbref or loop/instrument number
--   args[2]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beforeCompare(!args is ARRAY)

  -- Initialise
  !returnMessage = ||
  !sourceType    = !args[0]
  !element       = object DBREF()
  !elementId     = |Unknown|
  if (!sourceType eq |Dbref| or !this.mode eq |Destination|) then
    !element = !args[1].dbref()
    handle any
      !elementId = |Badref | & !args[1]
    elsehandle none
      !elementId = !element.flnm
    endhandle
  else
    !elementId = !args[1]
  endif

  -- Trace
  if (!this.debug) then
   !output = |cuSupportHandler.beforeCompare(| & !sourceType & |, | & !elementId & |)|
    write !output
  endif

  -- Actions before comparing each object
  if (!sourceType eq |Dbref| and !element.badref().not()) then
    -- Object is a dbref
    !returnMessage = !!cuProjectHandler.beforeCompare(!element)
  elseif (!sourceType eq |Other| and !elementId.trim() ne ||) then
    -- Object is an external named string
    !returnMessage = !!cuProjectHandler.beforeCompare(!elementId)
  endif

  -- A non-blank return message will skip comparison of this object
  if (!returnMessage.trim() ne ||) then
    !this.skippedObjects.append(!elementId & |,| & !returnMessage)
    if (!this.debug) then
      write !returnMessage
    endif
  endif
  !args[2] = !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      afterCompare
--
-- Description:
--   Event callback after comparing each object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Compare result: Yes, No, Multiple Matches, Linked, Multiple Links
--   args[1]  R   STRING    Source ID type: Dbref or Other
--   args[2]  R   STRING    Source object ID e.g. dbref or loop/instrument number
--   args[3]  R   STRING    Destination object dbref
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .afterCompare(!args is ARRAY)

  -- Initialise
  !compareResult = !args[0]
  !compareOk     = (!args[0] ne |No|)
  !sourceType    = !args[1]
  !sourceId      = |Unknown|
  !destinationId = |Unknown|
  !source        = FALSE
  !destination   = FALSE
  !sourceElement      = object DBREF()
  !destinationElement = object DBREF()

  -- Get source element details
  if (!this.mode eq |Source| or !compareResult ne |No|) then
    if (!sourceType.upcase() eq |DBREF|) then
      !sourceElement = !args[2].dbref()
      handle any
        !sourceId = |Badref | & !args[2]
      elsehandle none
        if (!sourceElement.badref()) then
          !sourceId = |Badref | & !args[2]
        else
          !sourceId = !sourceElement.flnm
          !source   = TRUE
        endif
      endhandle
    else
      !sourceId = !args[2]
      !source   = (!sourceId.trim() ne ||)
    endif
  endif

  -- Get destination element details
  if (!this.mode eq |Destination| or !compareResult ne |No|) then
    !destinationElement = !args[3].dbref()
    handle any
      !destinationId = |Badref | & !args[3]
    elsehandle none
      if (!destinationElement.badref()) then
        !destinationId = |Badref | & !args[3]
      else
        !destinationId = !destinationElement.flnm
        !destination   = TRUE
      endif
    endhandle
  endif

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.afterCompare(| & !compareResult & |, | & !sourceType & |, | & !sourceId & |, | & !destinationId & |)|
    write !output
  endif

  -- Actions after comparing each object
  if (!source and !destination) then
    if (!sourceType eq |Dbref|) then
      -- Matched source object is a dbref
      !!cuProjectHandler.afterCompare(!compareOk, !compareResult, !sourceElement, !destinationElement)
    elseif (!sourceType eq |Other|) then
      -- Matched source object is an external named string
      !!cuProjectHandler.afterCompare(!compareOk, !compareResult, !sourceId, !destinationElement)
    endif
  elseif (!source) then
    if (!sourceType eq |Dbref|) then
      -- Unmatched source object is a dbref
      !!cuProjectHandler.afterCompare(!compareOk, !compareResult, !sourceElement)
    elseif (!sourceType eq |Other|) then
      -- Unmatched source object is an external named string
      !!cuProjectHandler.afterCompare(!compareOk, !compareResult, !sourceId)
    endif
  elseif (!destination) then
    -- Destination object is unmatched
    !!cuProjectHandler.afterCompare(!compareOk, !compareResult, !destinationElement)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      endCompare
--
-- Description:
--   Event callback after comparing all objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .endCompare(!args is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.endCompare()|
    write !output
  endif

  -- Actions after comparing all objects
  !filePath = !!cuProjectHandler.endCompare()
  if (!this.debug and !filePath.trim() ne ||) then
    write !filePath
  endif

  -- Write out file of objects and reasons skipped
  if (!filePath.trim() ne ||) then
    !timeStamp = object DATETIME()
    !file = object FILE(!filePath)
    handle any
      if (!this.debug) then
        !message = |Bad file path | & !filePath
        write !message
      endif
    elsehandle none
      !file.open(|Append|)
      !file.writeRecord(|Objects skipped by Compare | & !timeStamp)
      !file.writeFile(|Append|, !this.skippedObjects)
      !file.close()
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      getCompareResults
--
-- Description:
--   Event callback to get compare results grid content
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  RW  STRING    File path to write grid contents to
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getCompareResults(!args is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.getCompareResults()|
    write !output
  endif

  -- Only possible when invoked from GUI as uses grid output (command line object provides alternative methods)
  if (!this.fromGUI) then
    -- Return path
    !filePath = !!cuProjectHandler.getCompareResults()
    if (!this.debug and !filePath.trim() ne ||) then
      write !filePath
    endif
    !args[0] = !filePath
  endif

endmethod

------------------------------------------------------------------------
-- Method:      beginUpdate
--
-- Description:
--   Event callback before updating all objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    True/False Link inserted elements
--   args[1]  R   STRING    True/False Link matched elements
--   args[2]  R   STRING    True/False Update attributes for linked inserted elements
--   args[3]  R   STRING    True/False Update attributes for linked matched elements
--   args[4]  R   STRING    True/False Unlink selected elements
--   args[5]  R   STRING    Owner to be used if not overridden per element
--   args[6]  R   STRING    TRUE if invoked from GUI, FALSE if invoked from command line
--   args[7]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beginUpdate(!args is ARRAY)

  -- Initialise
  !ownerId                           = |Unknown|
  !this.ownerElement                 = object DBREF()
  !this.linkInsertedElements         = !args[0].boolean()
  !this.linkMatchedElements          = !args[1].boolean()
  !this.updateLinkedInsertedElements = !args[2].boolean()
  !this.updateLinkedMatchedElements  = !args[3].boolean()
  !this.unlinkElements               = !args[4].boolean()
  !this.fromGUI                      = !args[6].boolean()

  -- Get owner element details
  !this.ownerElement = !args[5].dbref()
  handle any
    !ownerId = |Badref| & !args[5]
  elsehandle none
    !ownerId = !this.ownerElement.flnm
  endhandle

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.beginUpdate(| & !this.linkInsertedElements & |, | & !this.linkMatchedElements & |, | & !this.updateLinkedInsertedElements & |, | & !this.updateLinkedMatchedElements & |, | & !this.unlinkElements & |, | & !ownerId & |, | & !this.fromGUI & |)|
    write !output
  endif

  -- Actions before updating all objects
  !returnMessage = !!cuProjectHandler.beginUpdate(!this.linkInsertedElements, !this.linkMatchedElements, !this.updateLinkedInsertedElements, !this.updateLinkedMatchedElements, !this.unlinkElements, !this.ownerElement)

  -- A non-blank return message will abort the whole run
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[7] = !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      beforeUpdate
--
-- Description:
--   Event callback before updating each object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Source ID type: Dbref or Other
--   args[1]  R   STRING    Source object ID e.g. dbref or loop/instrument number
--   args[2]  R   STRING    Destination actual type, e.g. EQUI, :PIPELINE, etc.
--   args[3]  R   STRING    Destination object dbref (unset if does not yet exist)
--   args[4]  RW  STRING    Owner dbref to be used for this element
--   args[5]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beforeUpdate(!args is ARRAY)

  -- Initialise
  !returnMessage = ||
  !ownerRef      = object DBREF()
  !sourceType    = !args[0]
  !sourceId      = |Unknown|
  !destinationId = |Unset|
  !source        = FALSE
  !destination   = FALSE
  !sourceElement      = object DBREF()
  !destinationElement = object DBREF()
  !destinationType    = !args[2]

  -- Get source element details
  if (!sourceType eq |Dbref|) then
    !sourceElement = !args[1].dbref()
    handle any
      !sourceId = |Badref | & !args[1]
    elsehandle none
      if (!sourceElement.badref()) then
        !sourceId = |Badref | & !args[1]
      else
        !sourceId = !sourceElement.flnm
        !source   = TRUE
      endif
    endhandle
  else
    !sourceId = !args[1]
    !source   = (!sourceId.trim() ne ||)
  endif

  -- Get destination element details
  if (!args[3].trim() ne ||) then
    !destinationElement = !args[3].dbref()
    handle any
      !destinationId = |Badref | & !args[3]
    elsehandle none
      if (!destinationElement.badref()) then
        !destinationId = |Badref | & !args[3]
      else
        !destinationId = !destinationElement.flnm
        !destination   = TRUE
      endif
    endhandle
  endif

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.beforeUpdate(| & !sourceType & |, | & !sourceId & |, | & !destinationId & |, | & !destinationType & |)|
    write !output
  endif

  -- Actions before updating each object, including returning a specific owner element dbref
  if (!source and !destination) then
    if (!sourceType eq |Dbref|) then
      -- Matched source object is a dbref
      !returnMessage = !!cuProjectHandler.beforeUpdate(!sourceElement, !destinationElement, !destinationType)
    elseif (!sourceType eq |Other| and !sourceId.trim() ne ||) then
      -- Matched source object is an external named string
      !returnMessage = !!cuProjectHandler.beforeUpdate(!sourceId, !destinationElement, !destinationType)
    endif
  elseif (!source) then
    if (!sourceType eq |Dbref|) then
      -- Unmatched source object is a dbref
      !returnMessage = !!cuProjectHandler.beforeUpdate(!sourceElement, !destinationType, !ownerRef)
    elseif (!sourceType eq |Other|) then
      -- Unmatched source object is an external named string
      !returnMessage = !!cuProjectHandler.beforeUpdate(!sourceId, !destinationType, !ownerRef)
    endif
  elseif (!destination) then
    -- Destination object is unmatched
    !returnMessage = !!cuProjectHandler.beforeUpdate(!destinationElement, !destinationType)
  endif

   -- Validate owner reference to override the default owner for the run
  !returnOwner  = ||
  if (!ownerRef.badref().not()) then
    !returnOwner = !ownerRef.refn.string()
    if (!this.debug) then
      !ownerMessage = |Owner set to | & !ownerRef.flnm
      write !ownerMessage
    endif
  endif
  !args[4] = !returnOwner

  -- A non-blank return message will skip update of this object
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[5] = !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      afterUpdate
--
-- Description:
--   Event callback after updating each object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Update result: Ok or specific error message as output in grid
--   args[1]  R   STRING    Source ID type: Dbref or Other
--   args[2]  R   STRING    Source object ID e.g. dbref or loop/instrument number
--   args[3]  R   STRING    Destination object dbref (unset if error)
--   args[4]  R   STRING    TRUE if object built this time, FALSE if updated or otherwise
--   args[5+] R   STRING    Attributes that have been updated, e.g. NAME, DESCRIPTION, etc
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .afterUpdate(!args is ARRAY)

  -- Initialise
  !updateResult  = !args[0]
  !updateOk      = (!updateResult eq |Ok|)
  !sourceType    = !args[1]
  !built         = !args[4].boolean()
  !sourceId      = |Unknown|
  !destinationId = |Unknown|
  !source        = FALSE
  !destination   = FALSE
  !sourceElement      = object DBREF()
  !destinationElement = object DBREF()
  !updatedAttributes  = ARRAY()

  -- Get list of attributes that have been updated
  do !i from 5
    break if (undefined(!args[!i]))
    break if (!args[!i].trim() eq ||)
    !updatedAttributes.append(!args[!i])
  enddo

  -- Get source element details
  if (!sourceType eq |Dbref|) then
    !sourceElement = !args[2].dbref()
    handle any
      !sourceId = |Badref | & !args[2]
    elsehandle none
      if (!sourceElement.badref()) then
        !sourceId = |Badref | & !args[2]
      else
        !sourceId = !sourceElement.flnm
        !source   = TRUE
      endif
    endhandle
  else
    !sourceId = !args[2]
    !source   = (!sourceId.trim() ne ||)
  endif

  -- Get destination element details
  if (!updateResult eq |Ok| and !args[3].trim() ne ||) then
    !destinationElement = !args[3].dbref()
    handle any
      !destinationId = |Badref | & !args[3]
    elsehandle none
      if (!destinationElement.badref()) then
        !destinationId = |Badref | & !args[3]
      else
        !destinationId = !destinationElement.flnm
        !destination   = TRUE
      endif
    endhandle
  endif

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.afterUpdate(| & !updateResult & |, | & !sourceType & |, | & !sourceId & |, | & !destinationId & |, | & !built & |)|
    write !output
    !output = ||
    do !attribute values !updatedAttributes
      if (!output eq ||) then
        !output = !attribute
      else
        !output = !output & |,| & !attribute
      endif
    enddo
    write !output
  endif

  -- Instantiate 3D equipment template
  if (!destination and !built) then
    !this.instantiateEquipment(!sourceElement, !destinationElement)
    handle any
      !message = |Error instantiating equipment: | & !!error.text
      write !message
    endhandle
  endif

  -- Actions after updating each object
  if (!source and !destination) then
    if (!sourceType eq |Dbref|) then
      -- Matched source object is a dbref
      !!cuProjectHandler.afterUpdate(!updateOk, !updateResult, !sourceElement, !destinationElement, !updatedAttributes)
    elseif (!sourceType eq |Other| and !sourceId.trim() ne ||) then
      -- Matched source object is an external named string
      !!cuProjectHandler.afterUpdate(!updateOk, !updateResult, !sourceId, !destinationElement, !updatedAttributes)
    endif
  elseif (!source) then
    if (!sourceType eq |Dbref|) then
      -- Unmatched source object is a dbref
      !!cuProjectHandler.afterUpdate(!updateOk, !updateResult, !sourceElement, !updatedAttributes)
    elseif (!sourceType eq |Other|) then
      -- Unmatched source object is an external named string
      !!cuProjectHandler.afterUpdate(!updateOk, !updateResult, !sourceId, !updatedAttributes)
    endif
  elseif (!destination) then
    -- Destination object is unmatched
    !!cuProjectHandler.afterUpdate(!updateOk, !updateResult, !destinationElement, !updatedAttributes)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      endUpdate
--
-- Description:
--   Event callback after updating all objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .endUpdate(!args is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.endUpdate()|
    write !output
  endif

  -- Actions after updating all objects
  !!cuProjectHandler.endUpdate()

endmethod

------------------------------------------------------------------------
-- Method:      getUpdateResults
--
-- Description:
--   Event callback to get update results grid content
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  RW  STRING    File path to write grid contents to
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getUpdateResults(!args is ARRAY)

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.getUpdateResults()|
    write !output
  endif

  -- Only possible when invoked from GUI as uses grid output (command line object provides alternative methods)
  if (!this.fromGUI) then
    -- Return path
    !filePath = !!cuProjectHandler.getUpdateResults()
    if (!this.debug and !filePath.trim() ne ||) then
      write !filePath
    endif
    !args[0] = !filePath
  endif

endmethod

------------------------------------------------------------------------
-- Method:      instantiateEquipment
--
-- Description:
--   Instantiate equipment template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source element
--    2   R      DBREF       Destination element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .instantiateEquipment(!sourceElement is DBREF, !destinationElement is DBREF)

  -- Trace
  if (!this.debug) then
    !output = |cuSupportHandler.instantiateEquipment()|
    write !output
  endif

  -- Instantiate template when destination element is equipment and spref has been set
  if (!destinationElement.badref().not()) then
    if (!destinationElement.type inset(|EQUI|, |SUBE|)) then

      -- If the spref has been set then instantiate the equipment template
      if (!destinationElement.spre.badref().not()) then

        -- Graphics mode only for common properties code
        if (not istty) then
          if (!this.debug) then
            write |..Common properties instantiate template|
          endif
          !commonProp = object COMPROP()
          !commonProp.initialise(!destinationElement.spref)
          !commonProp.setProperties(!destinationElement)
          !commonProp.unsetDesiElement()
        elseif (!destinationElement.spre.tmpref.set()) then
          if (!destinationElement.spre.tmpref.badref().not()) then
            if (!this.debug) then
              write |..Simple copy template|
            endif
            !tmpref = !destinationElement.spre.tmpref
            new tmpl
            copy rexe $!tmpref
            end
          endif
        endif

      endif
    endif
  endif

endmethod
