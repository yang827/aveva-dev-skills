--
-- Description:
-- Report print, export and publish support
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ExportAsPdf(STRING,STRING)       BOOLEAN             Exports datasheet as pdf
--  ExportAsXlsx(STRING,STRING)      BOOLEAN             Exports datasheet as excel in .xlsx format
--  Print(STRING)                    -                   Print datasheet. This function will open the printer setting dialog
--  PrintDirect(STRING,REAL)         -                   Print datasheet directly using the user's preferred printing setting
--  callback(ARRAY)                  -
--  datasheetio()                    -                   Constructor
--  nameRuleExists(STRING)           BOOLEAN
--
define object datasheetio
	member .PMLDatasheetIO         is ARRAY
	member .datasheetInstanceNo    is REAL
endobject

------------------------------------------------------------------------
--
-- Method:       datasheetio
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .datasheetio()

  USING NAMESPACE 'AVEVA.Datasheets.Addin'


if (defined(!!datasheetpmlinstance)) then
    !this.datasheetInstanceNo = !!datasheetpmlinstance.PMLDatasheetIO.size() + 1
    !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo] = object PMLDatasheet()
  endif

  if (not defined(!!datasheetpmlinstance)) then
    !!datasheetpmlinstance = !this
    !!datasheetpmlinstance.PMLDatasheetIO[1] = object PMLDatasheet()
    !this.datasheetInstanceNo = 1
  endif

  !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo].addEventHandler('Response',!!datasheetpmlinstance,'callback')

endmethod
-- End of method definition for datasheetio()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for PMLDatasheet
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()
------------------------------------------------------------------------
--
-- Method:      Print
--
-- Description: Print Datasheet
--
-- Method Type:
-- Arguments:
-- datasheetfilename
-- Return:
------------------------------------------------------------------------

define method .Print(!datasheetfilename is STRING)is BOOLEAN
   !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo].Print(!datasheetfilename)
endmethod

------------------------------------------------------------------------
--
-- Method:      Print
--
-- Description:  Print datasheet. This function will open the printer setting dialog
--
-- Method Type:
-- Arguments:
-- Return:
------------------------------------------------------------------------

define method .Print(!datasheetReference is STRING)
   !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo].Print(!datasheetReference)
endmethod


------------------------------------------------------------------------
--
-- Method:      PrintDirect(!datasheetReference is STRING,!number is REAL)
--
-- Description:  Print datasheet. This function will open the printer setting dialog
--
-- Method Type:
-- Arguments:
-- Return:
------------------------------------------------------------------------

define method .PrintDirect(!datasheetReference is STRING,!number is REAL)
   !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo].PrintDirect(!datasheetReference,!number)
endmethod
------------------------------------------------------------------------
--
-- Method:      ExportAsXlsx
--
-- Description: Exports datasheet as excel in .xlsx format
--
-- Method Type:
-- Arguments:
-- Return:
------------------------------------------------------------------------

define method .ExportAsXlsx(!refId is STRING,!destinationFilename is STRING)is BOOLEAN
   !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo].ExportAsXlsx(!refId, !destinationFilename)
endmethod

------------------------------------------------------------------------
--
-- Method:      ExportAsPdf
--
-- Description: Export datasheet as pdf
--
-- Method Type:
-- Arguments:
-- Return:
------------------------------------------------------------------------

define method .ExportAsPdf(!refId is STRING,!destinationFilename is STRING)is BOOLEAN
    !!datasheetpmlinstance.PMLDatasheetIO[!this.datasheetInstanceNo].ExportAsPdf(!refId, !destinationFilename)
endmethod
------------------------------------------------------------------------
--
-- Method:      !nameString()
--
-- Description: method to return an auto name string
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to apply autoname rules to]
--   [2] [R] [STRING] [AutoName key, used to look up data in data structure]
--   [3] [R] [BOOLEAN] [flag to indicate if rule is to be checked]
--   [4] [R] [BOOLEAN] [flag to indicate if return is in wildcard format]
-- Return:
--   [STRING] [Auto name string]
--
------------------------------------------------------------------------

-- Define method
define method .nameRuleExists(!elementType is STRING) is BOOLEAN

   -- Try and Determine Format from gtyp and rule
    !foundnamerule = FALSE
    !valid = FALSE
	!rules = !!namOpt.rules()
    do !i indices !rules
      -- get the rule
      !ruleObj = !!ruleStore.element.getRule(!rules[!i].rule)
      handle (12, 004)
        skip
      endhandle

      !types = !ruleObj.types.split()
      do !j from 1 to !types.size()
          if (!types[!j] eq !elementType) then
            -- Check if rule is valid
            if (!ruleObj.rule.trim() eq '') then
              !valid = TRUE
            endif

            if (!valid) then
              !nameData = !rules[!i]
              break
            else
              skip
            endif
          else
            skip
          endif
      enddo

      if (!valid) then
        break
      endif

    enddo

  -- Build Name using !nameData if it has been defined
  if (defined(!nameData)) then
      !foundnamerule = TRUE
  endif
  write | $!valid |
  return !foundnamerule

endmethod
------------------------------------------------------------------------
