--
-- File:            dbeattribsearch.pmlobj
--   Type:          Object Definition
--   Group:         Any
--     Keyword:     Element attribute search
--   Module:        All
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Fri May 18 11:00:00 GMT 2007
--
-- Description:
--    Object for searching the hierarchy (parentage) for specific attributes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbeAttribSearch()                -                   Constructor
--  dbeAttribSearch(DBREF,STRING,ARRAY) -                   Constructor
--  element()                        DBREF               Derive element and set members from current source element
--  element(DBREF)                   DBREF               Derive element and set members from passed element
--  test()                           -                   Test method
--
------------------------------------------------------------------------

define object DBEATTRIBSEARCH

  -- Element (element containing desired attribute)
  member .element         is DBREF

  -- Attribute (attribute identified)
  member .attribute       is STRING

  -- Description for attribute
  member .description     is STRING

  -- Source element (element initially given)
  member .source          is DBREF

  -- List of attributes to check against (first is the primary)
  member .attributes      is ARRAY

  -- Description modifiable (if false then the selected attributes description is used)
  member .modifiableDesc  is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeAttribSearch
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeAttribSearch()

  -- Initialise Variables
  !this.modifiableDesc  = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      dbeAttribSearch
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source element
--    2   R      STRING      Primary attribute
--    3   R      ARRAY       Alternative attributes performing same function
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeAttribSearch(!source is DBREF, !attribute is STRING, !alternatives is ARRAY)

  -- Initialise Variables
  !this.dbeAttribSearch()
  !this.attributes.clear()
  !this.source        = !source
  !this.attributes.append(!attribute)
  !this.attributes.appendArray(!alternatives)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      test
--
-- Description: Test method
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .test()

  -- Initialise Variables
  !alternatives = ARRAY()
  !alternatives.append('FlrHeight')
  !alternatives.append('ClnHeight')
  !alternatives.append('Position')
  !this.dbeAttribSearch(!!ce, 'Elevation', !alternatives)
  QUERY VAR !this.element()
  QUERY VAR !this
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      element
--
-- Description: Derive element and set members from current source element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .element() is DBREF
  return !this.element(!this.source)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      element
--
-- Description: Derive element and set members from passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .element(!element is DBREF) is DBREF

  -- Initialise Variables
  !this.source  = !element
  !this.element = object DBREF()

  -- Define list of elements to check
  !elements     = !element.ownLst
  !elements.append(!element)
  !elements.invert()

  -- Check if element has any of the attributes
  do !i indices !elements

    -- Check if any of the attributes are available for the element
    !valid      = !elements[!i].attributes().intersect(!this.attributes)

    -- If there are any valid attributes, use the first attribute found
    if(!valid.set()) then
      !this.element   = !elements[!i]
      !this.attribute = !valid.first()

      -- Set description of attribute
      if(!this.modifiableDesc) then
        !this.description   = !this.attribute
        var !definition attdef $!<this.attribute> destex
        handle ANY
        elsehandle NONE
          !this.description = !definition[1]
        endhandle
      endif
      break
    endif

  enddo

  -- Return
  return !this.element

endmethod
-- End of method definition
