--
--
-- Description:
-- Panel group object for manipulating a group.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbeLoopGroup()                   -                   Constructor, using whole loop definition
--  dbeLoopGroup(DBREF)              -                   Constructor, using whole loop definition
--  dbeLoopGroup(DBREF,ARRAY)        -                   Constructor, using list of vertices to be used as the definer
--  draw(REAL)                       -                   Draw group
--  draw(REAL,BOOLEAN)               -                   Draw group
--  insert(DBREF)                    -                   Insert the group after passed element
--  mirror()                         -                   Mirror about mirror line
--  mirror(LINE)                     -                   Mirror about passed line
--  move(BOOLEAN)                    -                   Move order clockwise
--  offsetEdges(REAL)                -                   Offset members of the group
--  origin(POSITION)                 -                   Set new Origin to position
--  origin(REAL)                     -                   Set new Origin to vertex point
--  origin(XYPOSITION)               -                   Set new Origin to xyPosition (must be in same frame of reference)
--  pathVector()                     -                   Set path vector
--  position(XYPOSITION)             -                   Position origin at passed position
--  replace()                        -                   Replace vertices within the group to the new position
--  reverse()                        -                   Reverse order of polygon
--  rotate(REAL)                     -                   Rotate about group origin
--
------------------------------------------------------------------------

define object DBELOOPGROUP

  -- Vertex used as origin of group
  member .origin         is XYPOSITION
  member .originPoint    is REAL

  -- Mirror line (two XYPOSITIONS)
  member .arrivePath     is POINTVECTOR
  member .leavePath      is POINTVECTOR

  -- Path of group
  member .path           is POINTVECTOR

  -- DB vertices group has been derived from
  member .vertices       is ARRAY

  -- Polygon used to define group
  member .polygon        is GMFPOLYGON

  -- Sizes
  member .blobSize       is REAL
  member .arrowSize      is REAL
  member .length         is REAL

endobject
-- End of object definition for DBELOOPGROUP

------------------------------------------------------------------------
--
-- Method:      dbeLoopGroup
--
-- Description: Constructor, using whole loop definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeLoopGroup()

  -- Initialise Variables
  !this.arrowSize  = 500mm
  !this.blobSize   = 100mm

endmethod
-- End of method definition for .dbeLoopGroup()

------------------------------------------------------------------------
--
-- Method:      dbeLoopGroup
--
-- Description: Constructor, using whole loop definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop to be made into a group
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeLoopGroup(!loop is DBREF)

  -- Initialise Variables
  !this.dbeLoopGroup()

  -- Create polygon of selected vertices
  !this.vertices   = !loop.members
  !minimum         = 1
  !maximum         = !loop.members.size()

  -- Polygon of vertices
  !this.polygon.gmfPolygon(object PLANE(!loop.owner.position, !loop.owner.orientation), !this.vertices)

  -- Origin of group
  !this.origin(1)

  -- Arrive Path
  !start           = !this.polygon.plane.threeDPosition(!this.polygon.positions.last())
  !indices = !this.polygon.positions.indices()
  !end = !this.polygon.plane.threeDPosition(!this.polygon.positions.first())

  if(!start eq !end) then
    !this.arrivePath.pointVector(!this.polygon.plane.threeDPosition(!this.origin), !this.polygon.plane.orientation.yDir())
    !this.leavePath           = !this.arrivePath
    !this.leavePath.direction = !this.leavePath.direction.opposite()
    !this.path                = !this.arrivePath
    !this.length              = 0
    return
  endif

  !this.arrivePath = object POINTVECTOR(!end,!start.direction(!end))
  !this.leavePath  = object POINTVECTOR(!start,!end.direction(!start))

  -- First leg item
  !this.pathVector()


endmethod
-- End of method definition for .dbeLoopGroup(DBREF)

------------------------------------------------------------------------
--
-- Method:      dbeLoopGroup
--
-- Description: Constructor, using list of vertices to be used as the definer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop group is to be extracted from
--    2   R      ARRAY       Indices of vertices in group
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeLoopGroup(!loop is DBREF, !indices is ARRAY)
  -- Initialise Variables
  !this.dbeLoopGroup()

  -- Create polygon of selected vertices
  !vertices        = !loop.members
  !this.vertices   = !vertices.reIndex(!indices)
  !minimum         = !indices[1]
  !maximum         = !indices[!indices.size()]

  -- Polygon of vertices
  !this.polygon.gmfPolygon(object PLANE(!loop.owner.position, !loop.owner.orientation), !this.vertices)
  -- Origin of group
  !this.origin(1)
  -- If there is only one indices, then assume all paths
  -- Arrive Path
  if(!minimum eq 1) then
    !previous = !loop.members[!loop.members.size()]
  else
    !previous = !loop.members[!minimum - 1]
  endif
  !start           = !this.polygon.plane.near(!previous.position)
  !end             = !this.polygon.plane.threeDPosition(!this.polygon.positions.first())
  if (!start ne !end) then
    !this.arrivePath = object POINTVECTOR(!end,!start.direction(!end))
  else
    !this.arrivePath = object POINTVECTOR(!start, !this.polygon.plane.orientation.yDir())
    !this.leavePath           = !this.arrivePath
    !this.leavePath.direction = !this.leavePath.direction.opposite()
    !this.path                = !this.arrivePath
    !this.length              = 0
    return

  endif


  -- Leave Path
  if(!maximum eq !loop.members.size()) then
    !next     = !loop.members[1]
  else
    !next     = !loop.members[!maximum + 1]
  endif
  !start           = !this.polygon.plane.threeDPosition(!this.polygon.positions.last())
  !end             = !this.polygon.plane.near(!next.position)
  if (!start ne !end) then
    !this.leavePath= object POINTVECTOR(!end,!start.direction(!end))
  else
    !this.leavePath = object POINTVECTOR(!start, !this.polygon.plane.orientation.yDir().opposite())
    return
  endif

  -- First leg item
  !this.pathVector()

endmethod
-- End of method definition for .dbeLoopGroup(DBREF, ARRAY)

------------------------------------------------------------------------
--
-- Method:      pathVector
--
-- Description: Set path vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pathVector()

  -- Initialise Variables
  !start           = !this.polygon.plane.threeDPosition(!this.polygon.positions.first())

  if (!this.polygon.positions.size() gt 1) then
  	
    !next            = !this.polygon.plane.threeDPosition(!this.polygon.positions[2])
  else
    !next = !start
  endif
  !this.length     = !start.distance(!next)
  if (!this.length eq 0) then
    --handle distance of 0 between 1st 2 points
    !this.path = object POINTVECTOR()
    !this.path.position = !start
  else
    !this.path       = object POINTVECTOR(!start, !start.direction(!next))
  endif

  !this.arrivePath.position = !this.polygon.plane.threeDPosition(!this.polygon.positions.first())
  !this.leavePath.position  = !this.polygon.plane.threeDPosition(!this.polygon.positions.last())

  -- If origin point is set, then translate the point
  if(!this.originPoint.set()) then
    !this.origin      = !this.polygon.positions[!this.originPoint]
  endif

endmethod
-- End of method definition for .pathVector()
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true)

endmethod
-- End of method definition for .draw(REAL)
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !tag is BOOLEAN)

  -- Remove aid sphere
  !!aidNumbers.hide(!aidNumber)

  -- Initialise Variables
  !length     = !this.length * 0.25
  !length     = !length.max(!this.arrowSize)

  !blobSize = !!dbeLoopEdit.aidVertexSize
  handle any
    !blobSize   = !length * 0.25
    !blobSize   = !blobSize.min(!this.blobSize)
    !blobSize   = !blobSize.min(100mm)
  elsehandle NONE
    if (!blobSize.unset()) then
      !blobSize = 100mm
    endif
  endhandle
  !circleSize = !!dbeLoopEdit.aidCircleSize
  handle any
    !circleSize = !blobSize + 6mm
  elsehandle NONE
    if (!circleSize.unset()) then
      !circleSize = !blobSize + 6mm
    endif
  endhandle
  !originSize = !!dbeLoopEdit.aidOriginSize
  handle any
    !originSize = !blobSize
  elsehandle NONE
    if (!originSize.unset()) then
      !originSize = !blobSize
    endif
  endhandle
  !gp         = object GPHPOLYGON(!this.polygon)
  !gp.sphereSize = !blobSize
  !gp.sphereTranslucency = 60
  !gp.draw(!aidNumber)

  -- Tag origin
  !position   = !this.polygon.plane.threeDPosition(!this.origin)
  AID TRANSL 60
  AID SPHERE NUMBER $!<aidNumber> $!<position> DIAMETER $!<originSize>
  AID TRANSL 0
  if (!tag) then
    AID TEXT   NUMBER $!<aidNumber> ' Origin'  AT $!<position>
  endif

  -- Start path of group
  !positionA    = !this.path.position
  !positionA.up = !position.up
  !direction  = !this.path.direction
  if (!direction.unset()) then
    AID CYLINDER NUMBER $!<aidNumber> AT $!<positionA> DIAMETER $!<circleSize> HEIGHT 0
  else
    AID ARROW NUMBER $!<aidNumber> AT $!<positionA> DIRECTION $!<direction> HEIGHT $!<length>
  endif
  -- Tag each point
  AID TRANSL 60
  do !i from 1 to !this.polygon.positions.size()

    !position   = !this.polygon.plane.threeDPosition(!this.polygon.positions[!i])
    AID SPHERE NUMBER $!<aidNumber> $!<position> DIAMETER $!<blobSize>

  enddo
  AID TRANSL 0

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      origin
--
-- Description: Set new Origin to vertex point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        New origin point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origin(!point is REAL)

  -- Initialise Variables
  !this.originPoint = !point
  !this.origin      = !this.polygon.positions[!this.originPoint]

endmethod
-- End of method definition for .origin(REAL)

------------------------------------------------------------------------
--
-- Method:      origin
--
-- Description: Set new Origin to position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New origin
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origin(!position is POSITION)

  -- Initialise Variables
  !this.originPoint = REAL()
  !this.origin      = !this.polygon.plane.xyOffset(!position)

endmethod
-- End of method definition for .origin(POSITION)

------------------------------------------------------------------------
--
-- Method:      origin
--
-- Description: Set new Origin to xyPosition (must be in same frame of reference)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  New origin
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origin(!xyPosition is XYPOSITION)

  -- Initialise Variables
  !this.originPoint = REAL()
  !this.origin      = !xyPosition

endmethod
-- End of method definition for .origin(XYPOSITION)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position origin at passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  XY position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION)

  -- Initialise Variables
  !this.polygon.position(!this.origin, !xyPosition)

  -- Reposition origin
  !this.origin = !xyPosition

  -- Path line
  !this.pathVector()

endmethod
-- End of method definition for .position(XYPOSITION)

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate about group origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Rotation angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL)

  -- Initialise Variables
  !this.polygon.rotate(!angle, !this.origin)

  -- Translate arrive and leave paths
  !ori                       = Y IS $!<this.arrivePath.direction>
  !ori.gamma                 = !ori.gamma + !angle
  !this.arrivePath.direction = !ori.yDir()
  !ori                       = Y IS $!<this.leavePath.direction>
  !ori.gamma                 = !ori.gamma + !angle
  !this.leavePath.direction  = !ori.yDir()

  -- Path line
  !this.pathVector()

endmethod
-- End of method definition for .rotate(REAL)

------------------------------------------------------------------------
--
-- Method:      offsetEdges
--
-- Description: Offset members of the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset distance
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetEdges(!offset is REAL)

  -- Initialise Variables
  !this.polygon.offsetEdges(!offset)

  -- Path line
  !this.pathVector()

endmethod
-- End of method definition for .offsetEdges(REAL)

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror about mirror line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Mirror line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror()

  -- Initialise Variables
  !this.polygon.mirror(!this.arrivePath.line(1000mm))

  -- Path line
  !this.pathVector()

endmethod
-- End of method definition for .mirror()

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror about passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Mirror line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror(!line is LINE)

  -- Initialise Variables
  !this.polygon.mirror(!line)

  -- Path line
  !this.pathVector()

  -- Translate arrive and leave paths

endmethod
-- End of method definition for .mirror(LINE)

------------------------------------------------------------------------
--
-- Method:      reverse
--
-- Description: Reverse order of polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reverse()

  -- Initialise Variables
  !this.polygon.reverseOrder()
  !this.vertices.invert()

  -- Translate arrive and leave paths
  !path                      = !this.arrivePath
  !this.arrivePath           = !this.leavePath
  !this.arrivePath.direction = !this.arrivePath.direction.opposite()
  !this.leavePath            = !path
  !this.leavePath.direction  = !this.leavePath.direction.opposite()

  -- Path line
  !this.pathVector()

endmethod
-- End of method definition for .reverse()

------------------------------------------------------------------------
--
-- Method:      move
--
-- Description: Move order clockwise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for clock-wise shift
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .move(!clockwise is BOOLEAN)

  -- Initialise Variables

  -- Clock-wise move
  if(!clockwise) then
    !this.vertices.append(!this.vertices[1])
    !this.vertices.remove(1)
    !this.polygon.positions.append(!this.polygon.positions[1])
    !this.polygon.positions.remove(1)
  else
    !max = !this.vertices.size()
    !this.vertices.insert(1, !this.vertices[!max])
    !this.vertices.remove(!max + 1)
    !this.polygon.positions.insert(1, !this.polygon.positions[!max])
    !this.polygon.positions.remove(!max + 1)
  endif

  -- First leg item
  !this.leavePath = !this.arrivePath
  !this.pathVector()

endmethod
-- End of method definition for .move(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: Replace vertices within the group to the new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace()

  -- Initialise Variables
  !reference = !!ce

  -- Move to vertex
  !!ce       = !this.vertices[1]

  -- Insert contents of polygon in at new position
  do !i indices !this.polygon.positions
    !!ce = !this.vertices[!i]
    AT X$!<this.polygon.positions[$!<i>].x> Y$!<this.polygon.positions[$!<i>].y>
  enddo

  !!ce = !reference

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      insert
--
-- Description: Insert the group after passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insert(!vertex is DBREF)

  -- Initialise Variables
  !reference  = !!ce
  !indices    = ARRAY()

  -- Move to vertex
  !!ce        = !vertex
  !vertexType = !vertex.fullType

  -- Insert contents of polygon in at new position
  do !i indices !this.polygon.positions
    NEW $!<vertexType>
    AT X$!<this.polygon.positions[$!<i>].x> Y$!<this.polygon.positions[$!<i>].y> FRADIUS $!<this.vertices[$!<i>].fRadius>
   !indices.append(!!ce.sequence)
  enddo

  -- Redefine group
  !this.dbeLoopGroup(!vertex.owner, !indices)

  !!ce = !reference

endmethod
-- End of method definition for .insert(DBREF)
