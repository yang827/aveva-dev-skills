--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Sep 24 17:50:12 BST 1998
--
--
-- Description:
--   Database element Ppoint
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc()                            ARC                 Return circle definition
--  dbePPoint(DBREF)                 -                   Constructor, element passed, its sequence being the ppoint number
--  dbePPoint(DBREF,REAL)            -                   Constructor, element a ppoint passed
--  line()                           LINE
--

define object DBEPPOINT

  -- Element ppoint belongs to
  member .element     is DBREF

  -- Point number
  member .number      is REAL

  -- Point vector of ppoint
  member .pointVector is POINTVECTOR

endobject
-- End of object definition for DBEPPOINT

------------------------------------------------------------------------
--
-- Method:      dbePPoint
--
-- Description: Constructor, element a ppoint passed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Elements DBREF
--    2   R      REAL        Ppoint number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbePPoint(!element is DBREF, !number is REAL)

  -- Initialise Variables
  !this.element     = !element
  !this.number      = !number
  !this.pointVector = object POINTVECTOR(!this.element.pPosition[!this.number], !this.element.pDirection[!this.number])

endmethod
-- End of method definition for .dbePPoint(DBREF, REAL)

------------------------------------------------------------------------
--
-- Method:      dbePPoint
--
-- Description: Constructor, element passed, its sequence being the ppoint number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Elements DBREF
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbePPoint(!element is DBREF)

  -- Initialise Variables
  !this.element     = !element
  !this.number      = !element.sequence
  !this.pointVector = object POINTVECTOR(!this.element.pPosition[0], !this.element.pDirection[0])

endmethod
-- End of method definition for .dbePPoint(DBREF)

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description:  Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARC         Arc definition of ppoint
--
------------------------------------------------------------------------

define method .arc() is ARC

  -- Initialise Variables
  !arc   = object ARC(n0, y is n, 0, 90, 1000mm, false)

  -- Special case for Loop based points
  if(!this.element.hardType inset('PANE','EXTRU','NXTR','REVO','PLOO','LOOP','PAVE','VERT')) then

    -- Handle Panel/Extrusion Loops
    if(!this.element.hardType inset('PLOO','LOOP')) then
      !vertex = !this.members[!this.number]

    -- Handle Loop vertices
    elseif (!this.element.hardType inset('PAVE','VERT')) then
      !vertex = !this.element

    -- Handle Panel/extrusions/...
    else

      -- Get loop
      if(!this.element.hardType eq 'PANE') then
        !loop = PLOOP 1 of $!this.element
      else
        !loop = LOOP  1 of $!this.element
      endif
      !vertex = !loop.members[!this.number]

    endif

    -- Derive the arc, this will always be anti-clock-wise, starting at X = 0
    if(!this.element.fRadius ne 0) then
      !plane           = !this.element.pPosition[8].plane(!this.element.pPosition[4], !this.element.pPosition[6])
      !arc.position    = !plane.position
      !arc.orientation = object ORIENTATION('Z is ' & !plane.orientation.zDir() & ' and X is ' & !plane.position.direction(!this.element.pPosition[6]))
      !arc.startAngle  = 0
      !arc.endAngle    = !arc.near(!this.element.pPosition[4])
      !arc.radius      = !this.element.fRadius
    else
      !arc.orientation = !this.element.owner.owner.orientation
      !arc.position    = !this.element.pPosition[8]
      !arc.endAngle    = 0
      !arc.radius      = 0
    endif

  -- Handle any other item
  else

    !radius = !this.element.ppBore[!this.number].real()
    handle any
      return object ARC()
    endhandle

    -- Check the radius is set
    if(!radius eq 0) then
      return object ARC()
    else
      !radius = !radius / 2
    endif

    -- Define return arc
    !arc.position    = !this.element.pPosition[!this.number]
    !arc.orientation = object ORIENTATION('Z is ' & !this.element.pDirection[!this.number])
    !arc.radius      = !radius

  endif

  -- Return
  return !arc

endmethod
-- End of method definition for .arc() ARC

------------------------------------------------------------------------
--
-- Method:      dbPpoint
--
-- Description:
--   Convert passed ppoint of an element into a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE        1metre long line from ppoint
--
------------------------------------------------------------------------

define method .line() is LINE

  -- Initialise Variables
  !return = object LINE()

  -- Project line in the ppoint direction by a metre
  !return.startPosition     = !this.element.pPosition[!this.number]
  !return.endPosition       = !this.element.pPosition[!this.number]
  !return.endPosition.east  = !this.element.pDirection[!this.number].east  * 1000mm + !return.endPosition.east
  !return.endPosition.north = !this.element.pDirection[!this.number].north * 1000mm + !return.endPosition.north
  !return.endPosition.up    = !this.element.pDirection[!this.number].up    * 1000mm + !return.endPosition.up

  -- Return
  return !return

endmethod
-- End of method definition for .line() LINE
