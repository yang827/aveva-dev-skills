define object DBETYPES

  -- Database Element Types

    -- Structural Elements
    -- Panels
    member .panel       is DBEPANEL
    member .floor       is DBEPANEL

endobject
-- End of object definition for DBETYPES

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Define Global instances
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  -- Create Global Variable
  !!dbeTypes   = !this

endmethod
-- End of method definition for .globalInstance()
