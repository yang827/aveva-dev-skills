--
--
-- Description:
-- Vertex definition object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbeVertex(DBREF)                 -                   Constructor using passed vertex element
--

define object DBEVERTEX

  -- Reference item
  member .reference is DBREF

  -- Vertex position
  member .position  is XYPOSITION

  -- Radius
  member .radius    is REAL

endobject
-- End of object definition for DBEVERTEX

------------------------------------------------------------------------
--
-- Method:      dbeVertex
--
-- Description: Constructor using passed vertex element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Vertex element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeVertex(!vertex is DBREF)

  -- Initialise Variables
  !this.reference = !vertex
  !this.position.xyPosition(!vertex.position.east, !vertex.position.north)
  !this.radius    = !vertex.fRadius

endmethod
-- End of method definition for .dbeVertex(DBREF)
