-- Created:         Tue Jul 25 16:29:19 BST 2000
--
--
-- Description:
-- List of DB objects with methods to extract data from the list
-- Aware of Global locations for Global projects in addition to normal
-- non-Global operation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearLocation()                  -                   Set a location and regenerate object
--  dbListObj()                      -                   Constructor
--  getDbDesc()                      ARRAY               Get array of db descriptions from the db list
--  getDbDetails(STRING)             ARRAY               Get detailed report on given DB name
--  getDbDetailsTabbed(STRING)       ARRAY               Get detailed report on given DB name (tabbed output)
--  getDbNames()                     ARRAY               Get array of db names from the db list
--  getDbRefs()                      ARRAY               Get array of db names from the db list
--  setForeign(BOOLEAN)              -                   Include/exclude Foreign DBs from list
--  setLocation(LOCATION)            -                   Set a location and regenerate object (for Global project only)
--  setOnlyExtrHeir(BOOLEAN)         -
--  setSecondary(BOOLEAN)            -                   Include/exclude Secondary DBs from list
--  setTransaction(BOOLEAN)          -                   Include/exclude Transaction DBs from list
--  update()                         -                   Update dblist from project (Global or Local)
--  updateGlobal()                   -                   Update dblist from Global project
--  updateLocal()                    -                   Update dblist from Local (i.e. non-Global) project
--  workingList()                    ARRAY               Return array of working extract DBs for this project
--
------------------------------------------------------------------------

define object DBLISTOBJ

  -- list of DB objects in this project (less any DB's filtered out by methods)
  member .listOfDbs         is ARRAY
  -- location for Global projects
  member .location          is LOCATION
  -- true if this is a Global project
  member .isGlobalProject   is BOOLEAN
  -- true if Foreign DB's are to be included in the list
  member .foreign           is BOOLEAN
  -- true if DB's secondary at this location are to be included in the list (Global only)
  member .secondary         is BOOLEAN
  -- true if transaction DB's at this location are to be included in the list (Global only)
  member .transaction       is BOOLEAN
  -- true if only DB's in an extract hierarchy are to be included in the list
  member .extractHeirOnly   is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .dbListObj()
--
-- Description: Constructor
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbListObj()

  !this.location        = object LOCATION()
  !project              = CURRENT PROJECT
  !this.isGlobalProject = !project.isGlobal()
  !this.foreign         = true
  !this.secondary       = true
  !this.transaction     = true
  !this.extractHeirOnly = false

endmethod
-- End of method definition for .dbListObj()

------------------------------------------------------------------------
--
-- Method:      .setLocation()
--
-- Description: Set a location and regenerate object (for Global project only)
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LOCATION    Location for this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setLocation( !location is LOCATION )

  !this.location = !location
  !this.update()

endmethod
-- End of method definition for .setLocation()

------------------------------------------------------------------------
--
-- Method:      .clearLocation()
--
-- Description: Set a location and regenerate object
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearLocation( )

  !this.location = object LOCATION()
  !this.update()

endmethod
-- End of method definition for .clearLocation()

------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: Update dblist from project (Global or Local)
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  if( !this.isGlobalProject ) then
    !this.updateGlobal()
  else
    !this.updateLocal()
  endif

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      .updateLocal()
--
-- Description: Update dblist from Local (i.e. non-Global) project
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLocal()

  -- Clear the current list of databases
  !this.listOfDbs.clear()
  !collectWith = ''
  !dbRefs      = ARRAY()

  !this.listOfDbs = DBS

  -- Store any filters to be applied to the DB list
  !removeForeign     = !this.foreign
  !removeSec         = !this.isGlobalProject and !this.secondary.not()
  !removeTransaction = !this.isGlobalProject and !this.transaction.not()
  !onlyExtr          = !this.extractHeirOnly

  -- if no filters then result can be returned immediately
  if( !removeForeign.not() and !removeSec.not() and !removeTransaction.not() and !onlyExtr.not() ) then
    -- add working DB's (which cannot be foreign or secondary or transaction, and must be extracts)
    !this.listOfDbs.appendArray(!this.workingList())
    return
  endif

  -- get DB references to use in collection
  do !i indices !this.listOfDbs
    !dbRefs[!i] = !this.listOfDbs[!i].refno
  enddo

  -- build expression for a collection to filter out required DB's
  if( !removeForeign ) then
    !collectWith = ||
  else
    !collectWith = |FOREIGN eq 'LOCAL' and |
  endif
  if( !removeSec ) then
    !collectWith = !collectWith + |ISPRIM and |
  else
    !collectWith = !collectWith + |TRUE and |
  endif
  if( !removeTransaction ) then
    !collectWith = !collectWith + |(STYPE neq 'TRAN') and |
  else
    !collectWith = !collectWith + |TRUE and |
  endif
  if( !onlyExtr ) then
--    !collectWith = !collectWith + |NOT (BADREF(EXTOWN) and BADREF(EXTCLS[1]))|
    !collectWith = !collectWith + |NOT (BADREF(EXTOWN))|
  else
    !collectWith = !collectWith + |TRUE|
  endif

  VAR  !collectDbs COLLECT ALL WITH ( $!collectWith ) FROM !dbRefs

  -- rebuild list of DB's
  !this.listOfDbs.clear()
  do !i indices !collectDbs
    !this.listOfDbs[!i] = object DB(!collectDbs[!i])
  enddo

  -- add working DB's (which cannot be foreign or secondary)
  !this.listOfDbs.appendArray(!this.workingList())

  -- performance of EXTCLS is poor, so masters of selected extracts are gathered separately
  if( !onlyExtr ) then
    !masters = ARRAY()
    do !extract values !this.listOfDbs
      !refno = !extract.refno
      !masters.append(extMaster OF $!refno)
    enddo
    !masters.unique()
    do !master values !masters
      !this.listOfDbs.append(object DB(!master))
    enddo
  endif

endmethod
-- End of method definition for .updateLocal()

------------------------------------------------------------------------
--
-- Method:      .updateGlobal()
--
-- Description: Update dblist from Global project
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGlobal()

  -- Clear the current list of databases
  !this.listOfDbs.clear()
  if( !this.location.set() ) then
    -- This uses a function which returns all dbs
    !this.listOfDbs = !this.location.dbList()
    !this.listOfDbs.appendArray(!this.workingList())
  else
    -- should not be needed, but allows for unset location
    !this.updateLocal()
  endif

endmethod
-- End of method definition for .updateGlobal()

------------------------------------------------------------------------
--
-- Method:      .workingList()
--
-- Description: Return array of working extract DBs for this project
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .workingList() is ARRAY

  !workingExtracts = ARRAY()
  -- get a list of all users
  !userList = USERS
  -- collect working extracts for each user
  do !user values !userList
    !workDbs = !user.workingList()
    handle (2,109)
      -- skip an unnamed user
      skip
    endhandle
    !workingExtracts.appendArray(!workDbs)
  enddo

  return !workingExtracts

endmethod
-- End of method definition for .workingList()

------------------------------------------------------------------------
--
-- Method:      .getDbNames()
--
-- Description: Get array of db names from the db list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of STRING - Database names
--
------------------------------------------------------------------------

define method .getDbNames() is ARRAY

  !dbNames = ARRAY()

  -- Clear the current list of database names
  do !i indices !this.listOfDbs
    !dbNames[!i] = !this.listOfDbs[!i].name
  enddo

  return !dbNames

endmethod
-- End of method definition for .getDbNames()

------------------------------------------------------------------------
--
-- Method:      .getDbRefs()
--
-- Description: Get array of db names from the db list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of STRING - Database names
--
------------------------------------------------------------------------

define method .getDbRefs() is ARRAY

  !dbRefs = ARRAY()

  -- Clear the current list of database names
  do !i indices !this.listOfDbs
    !dbRefs[!i] = !this.listOfDbs[!i].refno
  enddo

  return !dbRefs

endmethod
-- End of method definition for .getDbNames()

------------------------------------------------------------------------
--
-- Method:      .setOnlyExtrHeir()
--
-- Description: Include/exclude Foreign DBs from list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    true to include foreign DBs. False to exclude
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOnlyExtrHeir( !onlyExtrHeir is BOOLEAN )

  !this.extractHeirOnly = !onlyExtrHeir

endmethod
-- End of method definition for .setOnlyExtrHeir()

------------------------------------------------------------------------
--
-- Method:      .setForeign()
--
-- Description: Include/exclude Foreign DBs from list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    true to include foreign DBs. False to exclude
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setForeign( !foreign is BOOLEAN )

  !this.foreign = !foreign

endmethod
-- End of method definition for .setForeign()

------------------------------------------------------------------------
--
-- Method:      .setSecondary()
--
-- Description: Include/exclude Secondary DBs from list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    true to include secondary DBs. False to exclude
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSecondary( !secondary is BOOLEAN )

  !this.secondary = !secondary

endmethod
-- End of method definition for .setSecondary()
------------------------------------------------------------------------
--
-- Method:      .setTransaction()
--
-- Description: Include/exclude Transaction DBs from list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    true to include Transaction DBs. False to exclude
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTransaction( !transaction is BOOLEAN )

  !this.transaction = !transaction

endmethod
-- End of method definition for .setTransaction()

------------------------------------------------------------------------
--
-- Method:      .getDbDesc()
--
-- Description: Get array of db descriptions from the db list
--              Substitute the DB name if there is no description
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of STRING - Database descriptions
--
------------------------------------------------------------------------

define method .getDbDesc() is ARRAY

  !dbDesc = ARRAY()

  -- Clear the current list of database descriptions
  do !i indices !this.listOfDbs
    !dbDesc[!i] = !this.listOfDbs[!i].description.trim()
    if( !dbDesc[!i].unset() or !dbDesc[!i].empty() ) then
      !dbDesc[!i] = !this.listOfDbs[!i].name
    endif
  enddo

  return !dbDesc

endmethod
-- End of method definition for .getDbDesc()

------------------------------------------------------------------------
--
-- Method:      .getDbDetails(STRING)
--
-- Description: Get detailed report on given DB name
--              Return report as an array of strings
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of STRING - Report on given DB
--
------------------------------------------------------------------------

define method .getDbDetails( !dbName is STRING ) is ARRAY

  -- Find DB in the list
  !db = object DB( !dbName  )
  handle any
    !dbReport[1] = 'Could not get details for DB ' + !dbName
    return !dbReport
  endhandle

  -- Set the selected DB's team name
  !dbTeam = !db.team.name
  handle any
    !dbTeam = 'UNKNOWN'
  endhandle
  !dbTeamDesc = !db.team.description
  handle any
    !dbTeamDesc = 'UNKNOWN'
  endhandle

  -- Display the selected DB's properties
  !dbRefNo = !db.refno.dbref()
  if( !dbRefNo.extown.set() ) then
    !dbExtract = 'Extract of DB ' + !dbRefNo.extown.name.substring(3)
    if( !dbRefNo.owner.owner.type.upcase().trim() eq 'USER' ) then
      !dbExtractType = 'Working extract for user ' + !dbRefNo.owner.owner.namn
    endif
  else
    !dbExtract = 'Master Database'
  endif
  !dbType    = !db.type
  !dbNumb    = !db.number
  !dbSize    = !db.size()
  !dbAcc     = !db.access
  !dbClm     = !db.claim
  !dbFor     = !db.foreign

  -- get report details
  !dbReport[1]   = !db.description
  if (!dbReport[1].unset() or !dbReport[1].empty()) then
    !dbReport[1]  = |-- no description --|
  endif
  if(!this.isGlobalProject) then
    -- Start change DFN1372
    --if( !dbRefNo.isPrim ) then
    --  !dbReport.append('Database is Primary at this location')
    --else
    --  !dbReport.append('Database is Secondary at this location')
    --endif
    -- Better to say where db is primary
    !memory = !!ce
    !!ce = !dbRefNo
    var !primaryAt LOCRF OF DBLOC 1
    handle ANY
      !dbReport.append('Database is Primary at ---')
    elsehandle NONE
      !dbReport.append('Database is Primary at ' & !primaryAt.trim('L', '/') )
    endhandle
    !!ce = !memory
    -- End change DFN1372
  endif
  !dbReport.append(| |)
  !dbReport.append(|Team   : | + !dbTeam.trim())
  !dbReport.append(|Type   : | + !dbType.trim())
  !dbReport.append(|         | + !dbExtract.trim())
  if( defined(!dbExtractType) ) then
    !dbReport.append(|         | + !dbExtractType)
  endif
  !dbReport.append(|Number : | + !dbNumb.trim())
  !dbReport.append(|Size   : | + !dbSize.string())
  if (!dbClm.set()) then
    !dbReport.append(|Access : | + !dbAcc.trim() + ' ' + !dbClm)
  else
    !dbReport.append(|Access : | + !dbAcc.trim())
  endif
  !dbReport.append(|Source : | + !dbFor.trim().substring(1,1) + !dbFor.trim().substring(2).lowcase())
  !dbReport.append(| |)

  -- Process the selected DB's mdblist
  !dbReport.append(|MDB List:|)
  !mdbs = !db.mdbList()

  do !i indices !mdbs
    !mdbList[!i] = !mdbs[!i].description
    if (!mdbList[!i].unset()) then
      !mdbList[!i] = |          | + !mdbs[!i].name.after(|/|)
    else
      !mdbList[!i] = |          | + !mdbs[!i].name.after(|/|) + |   | + !mdbList[!i]
    endif
  enddo

  -- Display the constructed array if it has elements
  if (defined(!mdbList)) then
    !mdbList.sort()
    !dbReport.appendArray(!mdbList)
  endif

  -- list the extract children
  !extractChildren = !db.refno.dbref().extcls
  handle any
  endhandle
  if( !extractChildren.size() gt 0 ) then
    !dbReport.append('Extract Databases owned by this Database:')
    do !extractChild values !extractChildren
      !dbReport.append(|          | + !extractChild.name.substring(3) )
    enddo
  endif

  -- list the extract ancestors
  !extractOwners = !db.refno.dbref().extals
  handle any
  endhandle
  if( !extractOwners.size() gt 1 ) then
    !dbReport.append('Master DB for this extract Database:')
    !dbReport.append(|          | + !extractOwners.last().name.substring(3) )
  endif

  return !dbReport

endmethod
-- End of method definition for .getDbDetails(STRING)

------------------------------------------------------------------------
--
-- Method:      .getDbDetailsTabbed(STRING)
--
-- Description: Get detailed report on given DB name
--              Return report as an array of tabbed strings
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of STRING - Report on given DB
--
------------------------------------------------------------------------

define method .getDbDetailsTabbed( !dbName is STRING ) is ARRAY

  -- Find DB in the list
  !db = object DB( !dbName  )
  handle any
    !dbReport[1] = 'Could not get details for DB ' + !dbName
    return !dbReport
  endhandle

  -- Set the selected DB's team name
  !dbTeam = !db.team.name
  handle any
    !dbTeam = 'UNKNOWN'
  endhandle
  !dbTeamDesc = !db.team.description
  handle any
    !dbTeamDesc = 'UNKNOWN'
  endhandle

  -- Display the selected DB's properties
  !dbRefNo = !db.refno.dbref()
  if( !dbRefNo.extown.set() ) then
    !dbExtract = 'Extract of DB ' + !dbRefNo.extown.name.substring(3)
    if( !dbRefNo.owner.owner.type.upcase().trim() eq 'USER' ) then
      !dbExtractType = 'Working extract for user ' + !dbRefNo.owner.owner.namn
    endif
  else
    !dbExtract = 'Master Database'
  endif
  !dbType    = !db.type
  !dbNumb    = !db.number
  !dbSize    = !db.size()
  !dbAcc     = !db.access
  !dbClm     = !db.claim
  !dbFor     = !db.foreign

  -- get report details
  !desc = !db.description
  if (!desc.unset() or !desc.empty()) then
    !desc = 'unset'
  endif
  !dbReport[1] = 'Description:	' & !desc

  if(!this.isGlobalProject) then
    -- Start change DFN1372
    --if( !dbRefNo.isPrim ) then
    --  !dbReport.append('Database is Primary at this location')
    --else
    --  !dbReport.append('Database is Secondary at this location')
    --endif
    -- Better to say where db is primary
    !memory = !!ce
    !!ce = !dbRefNo
    var !primaryAt LOCRF OF DBLOC 1
    handle ANY
      !dbReport.append('Primary location:	---')
    elsehandle NONE
      !dbReport.append('Primary location:	' & !primaryAt.trim('L', '/') )
    endhandle
    !!ce = !memory
    -- End change DFN1372
  endif
  !dbReport.append(||)
  !dbReport.append(|Team:	| + !dbTeam.trim())
  !dbReport.append(|Type:	| + !dbType.trim())
  !dbReport.append('	' + !dbExtract.trim())
  if( defined(!dbExtractType) ) then
    !dbReport.append('	' + !dbExtractType)
  endif
  !dbReport.append(|Number:	| + !dbNumb.trim())
  !dbReport.append(|Size:	| + !dbSize.string())
  if (!dbClm.set()) then
    !dbReport.append(|Access:	| + !dbAcc.trim() + ' ' + !dbClm)
  else
    !dbReport.append(|Access:	| + !dbAcc.trim())
  endif
  !dbReport.append(|Source:	| + !dbFor.trim().substring(1,1) + !dbFor.trim().substring(2).lowcase())
  !dbReport.append(||)

  -- Process the selected DB's mdblist
  !mdbs = !db.mdbList()

  do !i indices !mdbs
  -- !dbReport.append(|MDB List:|)
    !mdbList[!i] = !mdbs[!i].description
    if (!mdbList[!i].unset()) then
      !mdbList[!i] = |	| + !mdbs[!i].name.after(|/|)
    else
      !mdbList[!i] = |	| + !mdbs[!i].name.after(|/|) + | | + !mdbList[!i]
    endif
  enddo

  -- Display the constructed array if it has elements
  if (defined(!mdbList)) then
    !mdbList.sort()
    !mdbList[1] = 'MDB List:' & !mdbList[1]
  else
    !mdbList[1] = 'MDB List:'
  endif
  !dbReport.appendArray(!mdbList)

  -- list the extract children
  !extractChildren = !db.refno.dbref().extcls
  handle any
  endhandle
  if( !extractChildren.size() gt 0 ) then
    !desc = 'Extracts owned:'
    do !extractChild values !extractChildren
      !dbReport.append(!desc & |	| & !extractChild.name.substring(3))
      !desc = ''
    enddo
  endif

  -- list the extract ancestors
  !extractOwners = !db.refno.dbref().extals
  handle any
  endhandle
  !desc = ''
  if( !extractOwners.size() gt 1 ) then
    -- !dbReport.append('Master DB for this extract Database:')
    !dbReport.append(|Master DB:	| & !extractOwners.last().name.substring(3))
  endif

  return !dbReport

endmethod
-- End of method definition for .getDbDetailsTabbed(STRING)
