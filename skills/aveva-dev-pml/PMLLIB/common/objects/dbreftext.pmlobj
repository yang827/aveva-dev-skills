-- Description:
-- Generic object to contain associated text for a DBREF
-- element.
--
------------------------------------------------------------------------

-- Define object
define object DBREFTEXT

  -- DBREF item
  member .element is DBREF
  -- Brief Description
  member .brief   is STRING
  -- Detail Description
  member .detail  is STRING

endobject
-- End of object definition for DBREFTEXT
