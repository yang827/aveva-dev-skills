--   Group:         File Handling
--     Keyword:     FILE
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Apr 9 09:29:11 WAT 1997
--
--
-- Description:
-- Default file object, contains information about a defaults
-- file.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDefaultType()                 STRING              Return file type as required by colour and naming options
--  name()                           STRING              Return file name as required by colour and naming options
--

-- Define object
define object DEFAULTFILE

  -- Full file data
  member .file        is FILE
  -- Fullname
  member .fullName    is STRING
  -- Defaults file type
  member .defaultType is STRING
  -- Description
  member .description is STRING
  -- Environment Variable
  member .evar        is STRING

endobject
-- End of object definition for DEFAULTFILE

------------------------------------------------------------------------
--
-- Method:      .getDefaultType()
--
-- Description: Return file type as required by colour and naming options
--
------------------------------------------------------------------------
define method .getDefaultType() is STRING

  if( !this.defaultType eq 'PDMS' ) then
    !type = 'DEFAULT'
  elseif( !this.defaultType eq 'PROJ' ) then
    !type = 'PROJ'
  else
    !type = 'USER'
  endif

  return !type

endmethod

------------------------------------------------------------------------
--
-- Method:      .name()
--
-- Description: Return file name as required by colour and naming options
--
------------------------------------------------------------------------
define method .name() is STRING

  return !this.file.name()

endmethod
