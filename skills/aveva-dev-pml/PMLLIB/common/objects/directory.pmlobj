-- Define object
define object DIRECTORY

  -- Name
  member .name       is STRING

  -- Fullname of directory
  member .fullName   is STRING

  -- Array of sub-directories
  member .subDirs     is ARRAY

  -- Array of filenames
  member .files       is ARRAY

endobject
-- End of object definition for DIRECTORY
