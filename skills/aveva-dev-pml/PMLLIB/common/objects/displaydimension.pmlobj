-- Created:         Mon Sep 18 09:24:00 GMT 2006
--
-- Description:     display dimension - line or angle
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayDimension(STRING,DIRECTION,POSITION,POSITION,REAL,REAL) -                   default constructor - line
--  displayDimension(STRING,POSITION,POSITION,POSITION,REAL,REAL) -                   default constructor - angle
--  showAngularDimension()           -                   create and show angular dimension - given positions
--  showLinearDimension()            -                   create and show linear dimension
--

-- Define object
define object DISPLAYDIMENSION

  -- description
  member .description       is STRING

  -- array of positions
  member .positions         is ARRAY

  -- direction
  member .direction         is DIRECTION

  -- height
  member .height            is REAL

  -- angle
  member .angle             is REAL

  -- radius of arc
  member .radius            is REAL

  -- reserved number for this dimension
  member .number            is REAL

endobject
-- End of object definition for displayDimension

------------------------------------------------------------------------
--
-- Method:      displayDimension
--
-- Description: default constructor - line
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      label
--    2   R      DIRECTION   direction of helplines
--    3   R      POSITION    start position
--    4   R      POSITION    end position
--    5   R      REAL        height of helplines
--    6   R      REAL        number of helplines
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .displayDimension(!info is STRING, !direct is DIRECTION, !startPos is POSITION, !endPos is POSITION, !height is REAL, !number is REAL)

  !this.positions.append(!startPos)
  !this.positions.append(!endPos)

  !this.description = !info

  !this.direction   = !direct

  !this.height      = !height

  !this.number      = !number

  !this.showLinearDimension()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayDimension
--
-- Description: default constructor - angle
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      label
--    2   R      DIRECTION   direction of helplines
--    3   R      POSITION    position
--    4   R      POSITION    position
--    5   R      POSITION    position
--    6   R      REAL        radius of arc
--    7   R      REAL        number of helplines
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .displayDimension(!info is STRING, !origin is POSITION, !startPos is POSITION, !endPos is POSITION, !radius is REAL, !number is REAL)

  !this.positions.append(!origin)
  !this.positions.append(!startPos)
  !this.positions.append(!endPos)

  !this.description = !info

  !this.radius      = !radius

  !this.number      = !number

  !this.showAngularDimension()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showLinearDimension
--
-- Description: create and show linear dimension
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showLinearDimension()

  -- create plane through start position orthogonal to the direction of aid lines
  !plane1 = object PLANE(!this.positions[1], object ORIENTATION('Z IS ' & !this.direction.string()))

  -- define the projection of the end position on the plane
  !pos2OnPlane1 = !plane1.near(!this.positions[2])
  -- get the distance between this plane and the end position
  !distance     = !pos2OnPlane1.distance(!this.positions[2])

  -- define aid line positions by adding the desired height of dimension to the given positions
  !posHelp1 = !this.positions[1].offset(!this.direction, !this.height)
  !posHelp2 = !this.positions[2].offset(!this.direction, !this.height)

  -- add the distance calculated above to the 'lower' position
  if ( !distance.gt(1) ) then
    !line = object LINE(!this.positions[1], !this.positions[1].offset(!this.direction, 2 * !distance))
    if ( !line.onProjected(!this.positions[2]) ) then
      !posHelp1 = !posHelp1.offset(!this.direction, !distance)
    else
      !posHelp2 = !posHelp2.offset(!this.direction, !distance)
    endif
  endif

  -- to extend aid lines define two additional positions
  !posHelp3  = !posHelp1.offset(!this.direction, 50)
  !posHelp4  = !posHelp2.offset(!this.direction, 50)

  -- use them to define the label position
  !posText   = !posHelp3.midPoint(!posHelp4)

  -- define the parameter of the arrows - two become one
  !posArrow  = !posHelp1.midPoint(!posHelp2)
  !lenArrow  = !posHelp1.distance(!posArrow)
  if ( !lenArrow.gt(1) ) then
    !dirArrow1 = !posArrow.direction(!posHelp1)
    !dirArrow2 = !posArrow.direction(!posHelp2)
  endif

  -- draw the dimension
  AID LINE  NUMB $!this.number $!this.positions[1] TO $!posHelp3
  AID LINE  NUMB $!this.number $!this.positions[2] TO $!posHelp4

  if ( !lenArrow.gt(1) ) then
    AID ARROW NUMB $!this.number AT $!posArrow DIR $!dirArrow1 HEIGHT $!lenArrow PROPORTION 0.1
    AID ARROW NUMB $!this.number AT $!posArrow DIR $!dirArrow2 HEIGHT $!lenArrow PROPORTION 0.1
  endif

  AID TEXT  NUMB $!this.number |$!this.description| AT $!posText

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showAngularDimension
--
-- Description: create and show angular dimension - given positions
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showAngularDimension()

  -- define lines enclosing the angle
  !helpLine1   = object LINE(!this.positions[1], !this.positions[2])
  !helpLine2   = object LINE(!this.positions[1], !this.positions[3])

  if ( !helpLine1.length().lt(!this.radius)   or $
       !helpLine2.length().lt(!this.radius) ) then
    !helpLine1 = !helpLine1.extendEnd(!this.radius + 100 - !helpLine1.length())
    !helpLine2 = !helpLine2.extendEnd(!this.radius + 100 - !helpLine2.length())
  endif

  -- explicitly find out the used directions and set orientation
  !xDirection  = !helpline1.direction()
  !zDirection  = !xDirection.orthogonal(!helpline2.direction())

  !orientation = object ORIENTATION('Z IS ' & !zDirection & ' AND X IS ' & !xDirection)

  -- find the angle between the given lines
  !angle = !this.positions[1].angle(!this.positions[2], !this.positions[3])

  -- default drawing direction of the arc is clockwise
  !clockwise = true

  !arcangle = object ARC(!this.positions[1], !orientation, 0, !angle, !this.radius, !clockwise)

  !helpline1.draw(!this.number, 1, 5)
  !helpline2.draw(!this.number, 1, 5)

  !arcangle.draw(!this.number, 1, 5)

  -- define text position in the middle of the arc
  !posText   = !arcangle.anglePosition(!angle / 2)

  AID TEXT  NUMB $!this.number |$!this.description| AT $!posText

endmethod
-- End of method
