--
-- Description:
-- global object to store softtype definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arraySTypesFor(STRING)           ARRAY               get softtypes as an array
--  dtbSoftTypes()                   -                   Constructor
--  globalInstance()                 -                   create a global instance of the object
--  stringSTypesFor(STRING)          STRING              get softtypes as an array
--
------------------------------------------------------------------------

define object DTBSOFTTYPES

  -- Hardtypes available with softtypes

  member .pipe is ARRAY
  member .elbo is ARRAY
  member .redu is ARRAY
  member .tee is ARRAY
  member .olet is ARRAY
  member .cap is ARRAY
  member .pcom is ARRAY
  member .atta is ARRAY
  member .pcla is ARRAY
  member .hele is ARRAY
  member .scla is ARRAY
  member .sbfr is ARRAY
  member .gensec is ARRAY
  member .sctn is ARRAY
  member .pane is ARRAY


endobject
-- End of object definition for DTBSOFTTYPES

------------------------------------------------------------------------
--
-- Method:      dtbSoftTypes
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dtbSoftTypes()

  -- set current softtypes for each hardtype

  !this.pipe[1] = 'PIPE'
  !this.pipe[2] = 'HVAC'

  !this.elbo[1] = 'ELBO'
  !this.elbo[2] = 'FLEX'

  !this.redu[1] = 'REDU'
  !this.redu[2] = 'TAPE'
  !this.redu[3]  = 'TRNS'
  !this.redu[4]  = 'STRT'
  !this.redu[5]  = 'OFST'
  !this.redu[6]  = 'PLEN'
  !this.redu[7]  = 'PLAT'

  !this.tee[1] = 'TEE'
  !this.tee[2] = 'THRE'

  !this.olet[1] = 'OLET'
  !this.olet[2] = 'BRCO'

  !this.cap[1] = 'CAP'
  !this.cap[2] = 'MESH'
  !this.cap[3] = 'GRIL'
  !this.cap[4] = 'COWL'


  !this.pcom[1] = 'PCOM'
  !this.pcom[2] = 'AHU'
  !this.pcom[3] = 'DAMP'
  !this.pcom[4] = 'HFAN'
  !this.pcom[5] = 'SILE'
  !this.pcom[6] = 'BATT'


  !this.atta[1] = 'ATTA'
  !this.atta[2] = 'SKIR'
  !this.atta[3] = 'STIF'
  !this.atta[4] = 'HACC'
  !this.atta[5] = 'HSAD'
  !this.atta[6] = 'IDAM'
  !this.atta[7] = 'TP'
  !this.atta[8] =  'SPLR'


  !this.pcla[1] = 'PCLA'
  !this.pcla[2] = 'PCLI'
  !this.pcla[3] = 'PLUG'
  !this.pcla[4] = 'SHOE'
  !this.pcla[5] = 'UBOL'
  !this.pcla[6] = 'POST'
  !this.pcla[7] = 'TRNN'


  !this.hele[1]  = 'HELE'
  !this.hele[2]  = 'HROD'
  !this.hele[3]  = 'EYRD'
  !this.hele[4]  = 'RCPL'
  !this.hele[5]  = 'TRNB'
  !this.hele[6]  = 'WASH'
  !this.hele[7]  = 'CLEV'
  !this.hele[8]  = 'EYNT'
  !this.hele[9]  = 'HPIN'
  !this.hele[10]  = 'HNUT'
  !this.hele[11] = 'VSPR'
  !this.hele[12] = 'SWBR'
  !this.hele[13] = 'SNUB'


  !this.scla[1] = 'SCLA'
  !this.scla[2] = 'SLUG'
  !this.scla[3] = 'BWLD'
  !this.scla[4] = 'BBLT'
  !this.scla[5] = 'SOST'
  !this.scla[6] = 'STLS'
  !this.scla[7] = 'SPAC'
  !this.scla[8] = 'WPAD'


  !this.sbfr[1] = 'SBFR'
  !this.sbfr[2] = 'CFLOOR'
  !this.sbfr[3] = 'CSCREE'
  !this.sbfr[4] = 'CWALL'


  !this.gensec[1] = 'GENSEC'
  !this.gensec[2] = 'WALL'


  !this.sctn[1] = 'SCTN'
  !this.sctn[2] = 'STWALL'


  !this.pane[1] = 'PANE'
  !this.pane[2] = 'SCREED'
  !this.pane[3] = 'FLOOR'
  !this.pane[4] = 'GWALL'

endmethod
-- End of method definition for .dtbSoftTypes()

------------------------------------------------------------------------
--
-- Method:      arraySTypesFor
--
-- Description: get softtypes as an array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [hardtype to get softtypes from]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Array of strings of softtypes available (including the hardtype)
--
------------------------------------------------------------------------

define method .arraySTypesFor(!hardtype is STRING) is ARRAY

  !array = !this.attribute(!hardtype.upcase())
  handle any
    -- if invalid hardtype passed
    !array = ARRAY()
  endhandle
  return !array

endmethod
-- End of method definition for .arraySTypesFor(STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      stringSTypesFor
--
-- Description: get softtypes as an array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [hardtype to get softtypes from]
-- Return:
--   [Data Type] [Description]
--   [STRING]     [string of softtypes available (including the hardtype)
--
------------------------------------------------------------------------

define method .stringSTypesFor(!hardtype is STRING) is STRING

  !string = ''

  !array = !this.attribute(!hardtype.upcase())
  handle any
    -- if invalid hardtype passed
    !array = ARRAY()
  endhandle

  -- make string from array

  do !index values !array
    !string = !string & ' ' & !index
  enddo

  return !string

endmethod
-- End of method definition for .stringSTypesFor(STRING) STRING

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- create the global instance of this object
  !!dtbSoftTypes = !this

endmethod
-- End of method definition for .globalInstance()
