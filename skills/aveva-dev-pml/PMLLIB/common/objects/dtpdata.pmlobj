-- File:            dtpdata.pmlobj
--   Type:          Object Definition
--   Group:         Data set and properties
--     Keyword:     PROPERTY
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jun 29 09:38:35 BST 1998
--
--
-- Description:
-- Data property data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catParameter(REAL)               -                   Setup to be a catalogue parameter
--  desParameter(REAL)               -                   Setup to be a design parameter
--  dtpData(DBREF)                   -                   Constructor (load with passed DATA settings)
--  plotfile(STRING,STRING,STRING)   -                   Setup object to be a plotfile property
--
------------------------------------------------------------------------

define object DTPDATA

  -- Description
  member .description   is STRING

  -- Key/Short code
  member .key           is STRING

  -- Type
  member .type          is STRING

  -- Number
  member .number        is REAL

  -- Purpose
  member .purpose       is STRING

  -- Property
  member .property      is STRING
  -- Default (String)

  member .defaultString is STRING
  -- Default (Real)
  member .defaultReal   is REAL

  -- Reference item
  member .reference     is DBREF


endobject
-- End of object definition for DTPDATA

------------------------------------------------------------------------
--
-- Method:      dtpData
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Data element to populate object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dtpData(!item is DBREF)

  -- Make sure item is a data element
  if(not !item.type inset('DATA', 'DDAT')) then
    return
  endif

  -- Initialise Variables
  !this.reference     = !item

  -- Description
  !this.description   = !item.dTitle

  -- Key/Short code
  !this.key           = !item.dKey

  -- Type
  !this.type          = !item.pType

  -- Number
  !this.number        = !item.number

  -- Property
  !this.purpose       = !item.purpose

  -- Property
  !this.property      = !item.pProperty

  -- Default (String)
  !this.defaultString = !item.dProperty

endmethod
-- End of method definition for .dtpData(DBREF)

------------------------------------------------------------------------
--
-- Method:      desParameter
--
-- Description:
--   Setup to be a design parameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Design parameter number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .desParameter(!number is REAL)

  -- Purpose
  !this.purpose  = 'DESP'

  -- Number
  !this.number   = !number

  -- Property
  !this.property = '(DESP[' & !number & '])'

endmethod
-- End of method definition for .desParameter(REAL)

------------------------------------------------------------------------
--
-- Method:      catParameter
--
-- Description:
--   Setup to be a catalogue parameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Catalogue parameter number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .catParameter(!number is REAL)

  -- Purpose
  !this.purpose  = 'PARA'

  -- Number
  !this.number   = !number

  -- Property
  !this.property = '(PARA[' & !number & '])'

endmethod
-- End of method definition for .catParameter(REAL)

------------------------------------------------------------------------
--
-- Method:      plotfile
--
-- Description:
--   Setup object to be a plotfile property
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Plotfile name
--    2   R      STRING      Sub directory
--    3   R      STRING      Plotfile orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plotfile(!plotfile is STRING, !directory is STRING, !format is STRING)

  -- Check if plotfile exist
  !filename = '%PDMSPLOTS%/' & !directory & '/' & !plotfile
  !file     = object FILE(!filename)

  -- Do we want to use the data or forget it
  if(!file.exists().not()) then
    if(!!alert.confirm('Plotfile "' & !filename & '" does not exist, OK to define data?').boolean().not()) then
      return
    endif
  endif

  -- Key
  !this.key          = 'PLOT'

  -- Purpose
  !this.purpose      = 'PLOT'

  -- Description
  !this.description  = 'Plotfile'

  -- Set plotfile format/orientation
  if(!format.upcase() eq 'LANDSCAPE') then
    !this.type       = 'LPRT'
  else
    !this.type       = 'PPRT'
  endif

  -- Number
  !this.number       = REAL()

  -- Property
  !this.property     = '(''' & !plotfile & ''')'

  -- Sub-directory
  !this.defaultString = '(''' & !directory & ''')'

endmethod
-- End of method definition for .plotfile(STRING, STRING, STRING)
