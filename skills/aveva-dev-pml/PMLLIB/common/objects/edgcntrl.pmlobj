------------------------------------------------------------------------
--
-- Method:      tidyForms
--
-- Description Hide forms associated with current state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyForms()

  -- Initialise Variables
  !this.tidyForms(0)

endmethod
-- End of method definition for .tidyForms()

------------------------------------------------------------------------
--
-- Method:      tidyForms
--
-- Description Hide forms associated with [i] packet on the stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Entry number (zero for currently active form)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyForms(!entry is REAL)

  -- Initialise Variables
  !positioning        = FALSE

  -- Get event packet form
  if(!entry eq 0) then
    !form             = !this.state.packetForm
    !formCache        = !this.state.formCache
    !positioning      = !this.state.positioning
    !stackedForms     = ARRAY()
    !positionRequired = FALSE
  else
    !form             = !this.stack[!entry].packetForm
    !formCache        = !this.stack[!entry].formCache
    !positioning      = !this.stack[!entry].positioning
    !stackedForms     = !this.state.formCache
    !positionRequired = !this.state.positioning
  endif

  -- Remove packet form
  if(!form.set()) then
    !form.hide()
  endif

  -- Return if there are no pick type forms or positioning control
  if(!formCache.empty() and !positioning.not()) then
    return
  endif

  -- Build list of forms and test to see if any of the packets require
  -- positioning control
  do !i indices !this.stack
    skip if(!i eq !entry)
    !positionRequired = !positionRequired.or(!this.stack[!i].positioning)
    skip if(!this.stack[!i].formCache.empty())
    !stackedForms.appendArray(!this.stack[!i].formCache)
  enddo

  -- Remove unique forms of packet from system
  if(!formCache.empty().not()) then

    -- If there are no forms in the cache, then the all forms in the formCache can be removed
    if (!stackedForms.empty()) then
      !differences = !formCache
    else
      -- Array differences
      !differences = !formCache.difference(!stackedForms)
    endif

    -- Remove pick forms that are used by this stack only
    do !i indices !differences
      !differences[!i].hide()
    enddo

  endif

  -- Remove positioning forms
  if(!positionRequired.not() and !positioning) then
    !!edgPosCntrl.hide()
  endif

endmethod
-- End of method definition for .tidyForms(REAL)

------------------------------------------------------------------------
--
-- Method:      viewStack
--
-- Description: View the edg stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewStack()

  -- Initialise Variables
  !this.viewStack(-1)

endmethod
-- End of method definition for .viewStack()

------------------------------------------------------------------------
--
-- Method:      viewStack
--
-- Description: View the edg stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewStack(!mode is STRING) is ARRAY

  -- Initialise Variables
  !return       = ARRAY()

  !allPackets = !this.stack
  !allPackets.insert(1, !this.state)

  -- Loop thought packets
  do !i indices !allPackets
    if(!i eq 1) then
      !return.append('Currently Active Packet')
    else
      !return.append('Packet in position [' & (!i - 1) & '] on the stack')
    endif
    !return.appendArray(!allPackets[!i].packet.query())
    !return.append('')
  enddo

  return !return

endmethod
-- End of method definition for .viewStack(STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      viewStack
--
-- Description: View the edg stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Depth of stack to be views
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewStack(!levels is REAL)

  -- Initialise Variables
  !return       = ARRAY()
  !allPackets   = ARRAY()
  !max          = !levels.min(!this.stack.size())

  -- Get Active packet
  if(!levels le 0) then
    !return.append('Currently Active EDG Packet')
    !return.appendArray(!this.state.packet.query())
    !return.append('')

    if(!levels lt 0) then
      !max = !this.stack.size()
    else
      !max = 0
    endif
  endif

  -- Loop thought packets
  do !i from 1 to !max
    !return.append('EDG Packet - Stack position [' & (!i) & ']')
    !return.appendArray(!this.stack[!i].packet.query())
    !return.append('')
  enddo

  do !i indices !return
    write(!return[!i])
  enddo


endmethod
-- End of method definition for .viewStack(REAL)

------------------------------------------------------------------------
--
-- Method:      setRemoveState
--
-- Description: Sets .remove member of all packets of the same type to the given state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Packet type
--    2   R      BOOLEAN     Remove state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRemoveState(!type is STRING, !state is BOOLEAN)

  -- Change "current state" if required to
  if(!this.state.packet.type eq !type) then
    !this.state.packet.remove = !state
  endif

  -- Change any packets on the stack
  do !i indices !this.stack
    skip if(!this.stack[!i].packet.type ne !type)
    !this.stack[!i].packet.remove = !state
  enddo

endmethod
-- End of method definition for .setRemoveState(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setPrompt
--
-- Description: Set primary prompt (pickPacket prompt) of current state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Primary prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPrompt(!primaryPrompt is STRING)

  -- Update primary prompt
  if(!primaryPrompt.set()) then

    -- Set prompt
    !this.state.pickPacket.prompt        = !primaryPrompt
    !this.state.packet.pickPacket.prompt = !primaryPrompt

    -- Apply prompt to system
    !this.state.pick.applyPrompt(!this.state.prompt())

  endif

endmethod
-- End of method definition for .setPrompt(STRING)

------------------------------------------------------------------------
--
-- Method:      setPrompt
--
-- Description: Set primary (pickPacket prompt) and secondary prompt (pickType prompt) of current state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Primary prompt
--    2   R      STRING      Secondary prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPrompt(!primaryPrompt is STRING, !secondaryPrompt is STRING)

  -- Initialise Variables
  !update = FALSE

  -- Update primary prompt
  if(!primaryPrompt.set()) then
    !this.state.pickPacket.prompt        = !primaryPrompt
    !this.state.packet.pickPacket.prompt = !primaryPrompt
    --    !this.state.primaryPrompt(!primaryPrompt)
    !update = TRUE
  endif

  -- Update secondary prompt
  if(!secondaryPrompt.set()) then
    !this.state.pickType.prompt                                        = !secondaryPrompt
    !this.state.pickPacket.picks[!!edgCntrl.state.major].prompt        = !secondaryPrompt
    !this.state.packet.pickPacket.picks[!!edgCntrl.state.major].prompt = !secondaryPrompt
    --    !this.state.secondaryPrompt(!secondaryPrompt)
    !update = TRUE
  endif

  -- Apply prompt to system
  if(!update) then
    !this.state.pick.applyPrompt(!this.state.prompt())
  endif

endmethod
-- End of method definition for .setPrompt(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      setStackPrompt
--
-- Description: Set primary prompt (pickPacket prompt) for passed event on the stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Event on stack
--    2   R      STRING      Primary prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStackPrompt(!event is STRING, !prompt is STRING)

  -- Update primary prompt
  if(!prompt.set()) then

    -- Check the current active event
    if(!event eq !this.state.packet.description) then
      !this.setPrompt(!prompt)
    endif

    -- Loop through events on the stack
    do !i indices !this.stack
      if(!event eq !this.stack[!i].packet.description) then
        !this.stack[!i].primaryPrompt(!prompt)
        break
      endif
    enddo
  endif

endmethod
-- End of method definition for .setStackPrompt(STRING, STRING)

