------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(EDGPACKET)                BOOLEAN             Check if packet is already in the system
--  active(STRING)                   BOOLEAN             Check if packet description is already in the system (quick check)
--  add(EDGPACKET)                   BOOLEAN             Add edg packet to stack.
--  addView(GADGET)                  -                   Add edg packet to stack
--  aidFilter(STRING)                -                   Sets the element filters to the passed expression
--  canvasPick(GADGET,STRING)        -                   pick on graphics canvas, all picks go through this method
--  default()                        -                   Default edg mode (Navigation)
--  edgCntrl()                       -                   Constructor
--  elementFilter(STRING)            -                   Sets the element filters to the passed expression
--  escape()                         -                   Escape action when from system (does not carry out continue action)
--  explicitPosition(POSITION)       -                   pick on graphics canvas, all picks go through this method
--  filterModifiable(BOOLEAN)        -                   Set the filters modifiable state
--  globalInstance()                 -                   Create global instance of object
--  graphicalFilter(STRING)          -                   Sets the graphical filters to the passed expression
--  navigateAction(STRING)           -                   Set the default navigate action
--  pLineFilter(STRING)              -                   Sets the pline filters to the passed expression
--  pointFilter(STRING)              -                   Sets the point filters to the passed expression
--  priority(EDGPACKET)              BOOLEAN             Check how the new packet is to be added into the system
--  remove(EDGPACKET)                -                   Remove edg packet from stack by packet
--  remove(REAL)                     -                   Remove edg packet from stack by index. Zero indicates that the current state is to be removed
--  remove(STRING)                   -                   Remove edg packet from stack by description
--  removeView(GADGET)               -                   Remove edg packet to stack
--  replacePickType(EDGPICKTYPE)     -                   Replaces the pick type for subsequent inclusion into the system
--  retrieve()                       -                   Retrieve first packet from stack and make active
--  setFilter(REAL,STRING)           -                   Sets the filters index to the passed expression
--  setFilters()                     -                   Apply the current filters to the currently active picks
--  setModeState()                   -                   Sets edit mode active state if there are no EDG events stacked
--  setPrompt(STRING)                -                   Set primary prompt (pickPacket prompt) of current state
--  setPrompt(STRING,STRING)         -                   Set primary (pickPacket prompt) and secondary prompt (pickType prompt) of current state
--  setRemoveState(STRING,BOOLEAN)   -                   Sets .remove member of all packets of the same type to the given state
--  setStackPrompt(STRING,STRING)    -                   Set primary prompt (pickPacket prompt) for passed event on the stack
--  tidyForms()                      -                   pick on graphics canvas, all picks go through this method
--  tidyForms(REAL)                  -                   pick on graphics canvas, all picks go through this method
--  viewStack()                      -                   View the edg stack
--  viewStack(REAL)                  -                   View the edg stack
--  viewStack(STRING)                ARRAY               View the edg stack
--
------------------------------------------------------------------------

-- Define object
define object EDGCNTRL

  -- Description
  member .description       is STRING

  ----------------------- Current Pick Information ---------------------
  member .state             is EDGSTATE
  ----------------------------------------------------------------------

  -- EDG packet stack of edgState's
  member .stack             is ARRAY

  -- Views (list of active "design" views)
  member .views             is ARRAY

  -- Available Pick Packets
  member .pickPackets       is ARRAY

  -- Picked View (view pick came from)
  member .view              is GADGET

  -- Return data from last pick
  member .pickData          is EDGPICKDATA

  -- Action when adding equivalent packet priorities
  member .lowLevelReplace   is BOOLEAN
  member .highLevelReplace  is BOOLEAN

  -- Do we query if we replace an equivalent packet
  member .lowLevelQuery     is BOOLEAN
  member .highLevelQuery    is BOOLEAN

  -- Allow duplicate packets
  member .duplicates        is BOOLEAN

  -- action for default navigate pick mode
  member .navigateAction    is STRING

  -- System Status (Removed as STATE is not available in any other module)
  --member .systemState       is STATE

  -- Pick settings
  member .inmodeData        is ARRAY

endobject
-- End of object definition for EDGCNTRL

------------------------------------------------------------------------
--
-- Method:      edgCntrl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgCntrl()

  -- Default title of edg control system
  !this.description   = 'Main EDG Controlling Object'

  -- Do we
  !this.lowLevelReplace  = TRUE
  !this.lowLevelQuery    = FALSE
  !this.highLevelReplace = TRUE
  !this.highLevelQuery   = TRUE
  !this.duplicates       = FALSE

  -- initialise inmodeData array
  !this.inmodeData[1] = ''
  !this.inmodeData[2] = ''
  !this.inmodeData[3] = ''

  -- Get module
  !module = !!module()

  -- Special case for Spooling module
  if (!module.appKey.upcase() eq 'SPL') then
    !this.navigateAction      = '!this.moveToDbTube()'
  else
    !this.navigateAction      = '!this.moveToDbRef()'
  endif

endmethod
-- End of method definition for .edgCntrl()

------------------------------------------------------------------------
--
-- Method:      setModeState
--
-- Description: Sets edit mode active state if there are no EDG events stacked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setModeState()

  -- Check we are in design
  if((!!module().appKey.upcase() eq 'DES') or (!!module().appKey.upcase() eq 'MARHDES')) then

    -- Enable/Disable the modify mode if there are active events
    !systemState = object STATE()
    !systemState.enableModifyMode(!this.stack.empty())

    -- If the stack is empty activate the Modify Mode button
    !!appDesMain.coreModifyButton.active = !this.stack.empty()
    handle ANY
    endhandle
--    !!appDesMain.mtbNavigate = !this.stack.empty().not()
--    handle ANY
--    endhandle

  endif

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!edgCntrl    = !this

  -- Initialise global edgPosCntrol object
  !!comDefineGlobal(object EDGPOSCNTRL())

  -- Set default packet for system (navigate)
  !!edgCntrl.default()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      .navigateAction()
--
-- Description: Set the default navigate action
--
-- Method Type: Procedure
-- Arguments:
--    1   R      STRING  Action
--
------------------------------------------------------------------------

define method .navigateAction(!action is STRING)

  if (!action.unset()) then
    !this.navigateAction = '!this.moveToDbRef()'
  elseif (!action.trim() eq '') then
    !this.navigateAction = !this.moveToDbRef()
  else
    !this.navigateAction = !action
  endif

endmethod
-- End of method definition for .navigateAction(STRING)

------------------------------------------------------------------------
--
-- Method:      active
--
-- Description: Check if packet is already in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPACKET   Packet
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true is already in the system
--
------------------------------------------------------------------------

define method .active(!packet is EDGPACKET) is BOOLEAN

  -- Initialise Variables
  !return = FALSE

  -- Default Packet

  return !return

endmethod
-- End of method definition for .active(EDGPACKET) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      active
--
-- Description: Check if packet description is already in the system (quick check)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Packet description
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true is already in the system
--
------------------------------------------------------------------------

define method .active(!description is STRING) is BOOLEAN

  -- Initialise Variables
  !return = FALSE

  -- Scan the system for the passed packet

  -- If current state is the passed packet, then
  -- retrieve the from the stack
  if(!description eq !this.state.packet.description) then
    !return = TRUE

    -- Else scan the current stack and remove from it
  else

    do !i indices !this.stack
      if(!this.stack[!i].packet.description eq !description) then
        !return = TRUE
        break
      endif
    enddo
  endif

  return !return

endmethod
-- End of method definition for .active(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      default
--
-- Description: Default edg mode (Navigation)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .default()

  -- Default Packet
  !packet = object EDGPACKET()
  !packet.navigate()

  -- Add to state
  !this.state.setPacket(!packet)

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add edg packet to stack.
--
--   When a packet is added to the system, a check will be made to make
--   sure that there is no other packet of the equivalent priority in the
--   system. Where an equivalent packet is found, a check will be made to
--   see if its the "same" packet.
--
--   Where a packet is found on the stack, all others of lower priority
--   will be removed from the system.
--
--   Subsequent additions of the same packet will be ignored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPACKET   Edg Packet
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is packet has been added to system
--
------------------------------------------------------------------------

define method .add(!packet is EDGPACKET) is BOOLEAN

  -- Check for active model edit mode
  if((!!module().appKey.upcase() eq 'DES') or (!!module().appKey.upcase() eq 'MARHDES')) then
    !systemState = object STATE()
    -- if(!systemState.modifyMode()) then    **** See below changed to dismiss modify mode instead of message.
    --  !!alert.warning('Utility is not available while in "Modify" mode.')
    --  return false
    -- endif
    !systemState.modifyMode(FALSE)
    !!appDesMain.coreModifyButton.val = FALSE
    handle ANY
    endhandle
    !!appDesMain.coreModifyButton.active = FALSE
    handle ANY
    endhandle
  endif

  -- Check for the standard navigate and empty stack  **** Removed for 11.6.sp3 so navigate button will work on demand as an edg action.
  --  if(!this.stack.empty() and !packet.description eq 'Standard Navigate') then
  --    return true
  --  endif

  -- Check packet priority and maintain the stack/state accordingly
  if(!this.priority(!packet)) then

    -- Move current state to stack
    !this.stack.insert(1, !this.state)

    --   -- If there is a main form for the packet, then grey it out
    --   if(!this.state.packetForm.set()) then
    --     !this.state.packetForm.setActive(false)
    --   endif

    -- If there is a pick form, then grey it out
    if(!this.state.pickForm.set()) then
      !this.state.pickForm.setActive(FALSE)
      if(!this.state.isPositionMode()) then
        !!edgEPosition.setActive(FALSE)
      endif
    endif

    -- Add New packet to the state (overwrite)
    !this.state = object EDGSTATE()
    !this.state.setPacket(!packet)

    -- Check we are in design
    if((!!module().appKey.upcase() eq 'DES') or (!!module().appKey.upcase() eq 'MARHDES')) then

      -- Stop modify mode from being turned on
      !systemState = object STATE()
      !systemState.enableModifyMode(FALSE)

    endif

    return TRUE
  endif

  return FALSE

endmethod
-- End of method definition for .add(EDGPACKET) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      priority
--
-- Description: Check how the new packet is to be added into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPACKET    edg Packet to be added into the system
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if packet can be added into the system
--
------------------------------------------------------------------------

define method .priority(!packet is EDGPACKET) is BOOLEAN

  -- Initialise Variables
  !allPackets = !this.stack
  !allPackets.insert(1, !this.state)

  -- Loop thought packets
  do !i indices !allPackets

    -- Stack position
    !stackPosition = !i - 1

    -- Check if item is already in system
    if(!packet.priority eq !allPackets[!i].packet.priority) then

      -- Do we allow items of same priority to be replaces
      if(!this.highLevelReplace.not() and !this.lowLevelReplace.not()) then
        !!alert.error('Unable to add "' & !packet.description & '" into system (overwriting of existing edg packets is not permitted).')
        return FALSE
      endif

      -- High level packet
      if(!packet.priority eq 0) then
        if(!this.highLevelReplace.not()) then
          !!alert.error('Unable to add "' & !packet.description & '" into system (a major application/utility edg packets can not be replaced by another).')
          return FALSE

          -- OK to over write currently major packet?
        else

          -- Query the replacement
          if(!this.highLevelQuery) then
            if(!!alert.confirm('OK to replace currently active major application/utility "' & !allPackets[!i].packet.description & '" ?').boolean().not()) then
              return FALSE
            endif
          endif

          -- Remove current high level application from the stack
          !this.remove(!stackPosition)
        endif

        -- Lower level packets
      else
        if(!this.lowLevelReplace.not()) then
          !!alert.error('Unable to add "' & !packet.description & '" into system (an equivalent application/utility edg packets can not be replaced by another).')
          return FALSE

          -- OK to over write currently major packet?
        else

          -- Query the replacement
          if(!this.lowLevelQuery) then
            if(!!alert.confirm('OK to replace currently equivalent application/utility "' & !allPackets[!i].packet.description & '" ?').boolean().not()) then
              return FALSE
            endif
          endif

          -- Remove current low level application from the stack
          !this.remove(!stackPosition)
        endif

      endif
    endif

  enddo
  return TRUE

endmethod
-- End of method definition for .priority(EDGPACKET) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove edg packet from stack by packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPACKET   Edg Packet
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove(!packet is EDGPACKET)

  -- Scan the system for the passed packet

  -- If current state is the passed packet, then
  -- retrieve the from the stack
  if(!packet.description eq !this.state.packet.description) then

    -- Retrieve previous packet
    !this.retrieve()

    -- Else scan the current stack and remove from it
  else

    -- Copy stack so we can remove it
    !stack = !this.stack

    -- Loop through each entry
    do !i indices !stack
      if(!this.stack[!i].packet.description eq !packet.description) then

        -- Reclaim Aid number of packet
        !!aidNumbers.remove(!this.stack[!i].packet.aidNumber)

        -- Remove redundant froms
        !this.tidyForms(!i)

        -- Remove from Stack
        !this.stack.remove(!i)
        break
      endif
    enddo

  endif

  -- Set mode state
  !this.setModeState()

endmethod
-- End of method definition for .remove(EDGPACKET)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove edg packet from stack by description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Edg Packet
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove(!description is STRING)

  -- Scan the system for the passed packet

  -- If current state is the passed packet, then
  -- retrieve the from the stack
  if(!description eq !this.state.packet.description) then

    -- Retrieve previous packet
    !this.retrieve()

    -- Else scan the current stack and remove from it
  else

    -- Copy stack so we can remove it
    !stack = !this.stack

    -- Loop through each entry
    do !i indices !stack
      if(!this.stack[!i].packet.description eq !description) then

        -- Get the continue action
        !continue = !this.stack[!i].packet.continue

        -- Carry out any close action
        !this.stack[!i].packet.closeAction()

        -- Reclaim Aid number of packet
        !!aidNumbers.remove(!this.stack[!i].packet.aidNumber)

        -- Remove redundant froms
        !this.tidyForms(!i)

        -- Remove from Stack
        !this.stack.remove(!i)

        -- Action continue
        if(!continue.set()) then
          $!<continue>
          handle ANY
            !error = 'Packet Continue action (' & !continue & ') failed.'
            return error 1 '$!error'
          endhandle
        endif
        break
      endif
    enddo

  endif

  -- Set mode state
  !this.setModeState()

endmethod
-- End of method definition for .remove(STRING)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description:  Remove edg packet from stack by index. Zero indicates that the current state is to be removed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edg Packet number on the stack
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove(!index is REAL)

  -- If zero is passed, remove form state
  if(!index eq 0) then

    -- Retrieve previous packet
    !this.retrieve()

    -- Else scan the current stack and remove from it
  else

    -- Don't do anything if index > stack
    if(!index gt !this.stack.size()) then
      return
    endif

    -- Carry out any close action
    !this.stack[!index].packet.closeAction()

    -- Reclaim Aid number of packet
    !!aidNumbers.remove(!this.stack[!index].packet.aidNumber)

    -- Remove redundant froms
    !this.tidyForms(!index)

    -- Remove from Stack
    !this.stack.remove(!index)

  endif

  -- Set mode state
  !this.setModeState()

endmethod
-- End of method definition for .remove(REAL)

------------------------------------------------------------------------
--
-- Method:      retrieve
--
-- Description: Retrieve first packet from stack and make active
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .retrieve()

  -- If there are no packets on the stack, reload default
  if(!this.stack.unset()) then

    -- Default packet
    !this.default()

    -- Reinstate packet from stack
  else

    -- Get the continue action
    !continue = !this.state.packet.continue

    -- Carry out any close action
    !this.state.packet.closeAction()
    handle ANY
      !!alert.warning(!!error.text)
    endhandle

    -- Reclaim aid number
    !!aidNumbers.remove(!this.state.packet.aidNumber)

    -- Remove redundant froms
    !this.tidyForms()

    -- Reset state to packet
    !this.state = object EDGSTATE()
    !this.state.reinstatePacket(!this.stack.remove(1))

    -- Action continue
    if(!continue.set()) then

      -- Force modify mode on just in case the continue action tried to reinstate
      -- the model editor mode.
      !systemState = object STATE()
      !systemState.enableModifyMode(TRUE)

      $!<continue>
      handle ANY
        !error = 'Packet Continue action (' & !continue & ') failed.'
        return error 1 '$!error'
      endhandle
    endif
  endif

endmethod
-- End of method definition for .retrieve()

------------------------------------------------------------------------
--
-- Method:      escape
--
-- Description: Escape action when from system (does not carry out continue action)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .escape()

  -- If there are no packets on the stack, reload default
  if(!this.stack.unset()) then

    -- Default packet
    !!edgCntrl.default()

    -- Reinstate packet from stack
  else

    -- Get escape actions
    !escape   = !this.state.packet.escape

    -- Carry out any close action
    !this.state.packet.closeAction()
    handle ANY
      !!alert.warning(!!error.text)
    endhandle

    -- Reclaim aid number
    !!aidNumbers.remove(!this.state.packet.aidNumber)

    -- Remove redundant froms
    !this.tidyForms()

    -- Reset state to packet
    !this.state = object EDGSTATE()
    !this.state.reinstatePacket(!this.stack.remove(1))

    -- Action escape
    if(!escape.set()) then

      -- the model editor mode.
      !systemState = object STATE()
      !systemState.enableModifyMode(TRUE)

      $!<escape>
      handle ANY
        !error = 'Packet escape action (' & !escape & ') failed.'
        return error 1 '$!error'
      endhandle
    endif

  endif

  -- Set mode state
  !this.setModeState()

endmethod
-- End of method definition for .escape()

------------------------------------------------------------------------
--
-- Method:      addView
--
-- Description: Add edg packet to stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addView(!view is GADGET)

  -- Add view
  !this.views.append(!view)

  -- Set callback on view gadget
  !view.callback = '!!edgCntrl.canvasPick('

  -- Apply the current edg pick to the view
  !this.state.pick.applyToView(!view, !this.state.prompt())

endmethod
-- End of method definition for .addView(GADGET)

------------------------------------------------------------------------
--
-- Method:      removeView
--
-- Description: Remove edg packet to stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeView(!view is GADGET)

  -- Make copy of view list (we'll be modifying its contents)
  !viewList = !this.views

  -- Scan views for passed view
  do !i indices !viewList

    if(!view eq !viewList[!i]) then
      !this.views.remove(!i)
      break
    endif
  enddo

endmethod
-- End of method definition for .removeView(GADGET)

------------------------------------------------------------------------
--
-- Method:      canvasPick
--
-- Description: pick on graphics canvas, all picks go through this method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View Picked
--    2   R      STRING      Type of Pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .canvasPick(!pickedView is GADGET, !mode is STRING)

  --clock init all
  -- Test for escape from event
  if (!mode eq 'ESCAPE') then
    !!edgCntrl.escape()

    ---------------------------------------------------------
    -- Called only if MDS Alignment Utility is being used.
    if( defined(!!kGPHAlign)) then
      if (!!edgCntrl.state.packetForm.eq(!!kGPHAlign)) then
        -- Dismiss the form !!mdsAlign cleanly.
        !!kactioncommands(!!mdsAlign.dismissform)
      endif
    endif
    ---------------------------------------------------------

  else

    -- Speeds up the standard navigate mode in everything except equipment application
    if(!this.state.packet.key eq 'stdNavigate' and !!appcntrl.currentApp() ne 'EQUI') then
      !!ce = !pickedView.inmode.data[3]
      return
    endif

    -- Remember view picked in common focus point
    !this.view = !pickedView

    -- Push data into common store
    !this.pickData.viewData(!this.view)

    -- Carry out event actions
    !!edgCntrl.state.action()

    ---------------------------------------------------------
    -- Called only if MDS Alignment Utility is being used.
    if( defined(!!kGPHAlign)) then
      if (!!edgCntrl.state.packetForm.eq(!!kGPHAlign)) then

        -- Check if FIRST Picked Item is MEMBER of the Current MDS
        -- Support being Created or Modified.
        if (!!edgCntrl.state.pickPacket.return.empty().not() and !!edgCntrl.view.prompt.val.match('end').gt(0)) then

          !form   = !!currentalignform
          if (!!edgCntrl.pickData.type.neq('DESIGNAID')) then
            !dbref1 = !!edgCntrl.state.pickPacket.return[1].item
          else
            !!alert.error ('The FIRST Picked item MUST belong to the Current MDS Support "$!!mdsAlign.name", and NOT a Design Aid.')
            -- Re-Initialise the Alignment Utility
            !!kactioncommands(!!mdsAlign.dismissform)
            !!mdsxalign(!form)
            return
          endif

          if (!!mdscurrsuppname(!dbref1,!form)) then
            !xTyp1  = ''
            !dbnam1 = !dbref1.fullname

            if (!dbnam1.match('/').eq(1)) then
              !xTyp1 = !dbref1.fulltype.lowcase()
            endif

            !text1    = ARRAY()

            if (!!edgCntrl.state.pickPacket.return[1].type.upcase().eq('ELEMENT')) then
              !text1[1] = !xTyp1 & ' ' & !dbnam1
              !text1[1] = !text1[1].trim()
            else
              !text1[1] = !!edgCntrl.state.pickPacket.return[1].type.lowcase() & ' ' & !!edgCntrl.state.pickPacket.return[1].$!!edgCntrl.state.pickPacket.return[1].type
              !text1[2] = 'of Element ' & !dbnam1
            endif

            -- Populate the FIRST text pane gadget '.pick1'
            !!mdsAlign.pick1.clear()
            !!mdsAlign.pick1.val = !text1

          else

            !!alert.error ('The FIRST Picked item MUST belong to the Current MDS Support "$!!mdsAlign.name".')
            -- Re-Initialise the Alignment Utility
            !!kactioncommands(!!mdsAlign.dismissform)
            !!mdsxalign(!form)
            return
          endif

        else
          -- Check if the FIRST Pick textpane gadget '.pick1'a is NOT 'unset'
          !pick1 = !!mdsAlign.pick1.val
          if (!pick1[1].neq('unset') and !!edgCntrl.view.prompt.val.match('start').gt(0)) then

            -- Add the SECOND Picked Item to the !!mdsAlign Form
            !form   = !!currentalignform
            !text2  = ARRAY()

            if (!!edgCntrl.pickData.item.badref()) then
              -- Item2 is a DESIGN AID element
              !text2[1] = 'Design Aid' & !!edgCntrl.pickData.aidtype & ' ' & !!edgCntrl.pickData.point
            else
              -- Item2 is a <DBREF> element or belongs to a <DBREF> element
              --!fType2 = !!edgCntrl.pickData.item.fulltype
              !dbref2 = !!edgCntrl.pickData.item
              !xTyp2  = ''
              !dbnam2 = !dbref2.fullname

              if (!dbnam2.match('/').eq(1)) then
                !xTyp2 = !dbref2.fulltype.lowcase()
              endif

              if (!!edgCntrl.pickData.type.upcase().eq('ELEMENT')) then
                !text2[1] = !xTyp2 & ' ' & !dbnam2
                !text2[1] = !text2[1].trim()
              else
                !objType  =  !!edgCntrl.pickData.type.lowcase()
                -- The FIRST Pick above, uses the EDG OBJECT !!edgCntrl.state, where the OBJECT member is named 'ppoint',
                -- However this SECOND Pick uses the EDG OBJECT !!edgCntrl.picData, where the OBJECT member is named 'point',
                -- Hence the check for 'ppoint' below.
                if (!objType.eq('ppoint')) then
                  !objType = 'point'
                endif
                --              !text2[1] = !!edgCntrl.pickData.type.lowcase() & ' ' & !!edgCntrl.pickData.$!!edgCntrl.pickData.type
                !text2[1] = !!edgCntrl.pickData.type.lowcase() & ' ' & !!edgCntrl.pickData.$!objType
                !text2[2] = 'of Element ' & !dbnam2
              endif

            endif

            -- Populate the SECOND text pane gadget '.pick2'
            !!mdsAlign.pick2.clear()
            !!mdsAlign.pick2.val = !text2

          endif

        endif

        -- Set the Direction Gadget '!!kGPHAlign.direction' to reflect the ORTHOGONAL Direction
        -- of The Current Supports' Datum Atta 'Pleave Direction'
        !planeDir                 = !!kcalcorthdir(!form.support.datum)
        !!kGPHAlign.direction.val = !planeDir.string()

      endif
    endif
    ---------------------------------------------------------

  endif
  --clock read all

endmethod
-- End of method definition for .canvasPick(GADGET, STRING)

