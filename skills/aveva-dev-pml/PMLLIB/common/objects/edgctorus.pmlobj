------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc(DBREF)                       ARC                 Return circle definition
--  arc(DBREF,POSITION)              ARC                 Return circle definition through a reference position
--  arc(DBREF,REAL)                  ARC                 Return circle definition through a given ppoint
--
------------------------------------------------------------------------

define object EDGCTORUS

  -- Dummy
  member .dummy      is STRING
  -- Edit Form
  member .editForm   is FORM
  -- Create Form
  member .createForm is FORM

endobject
-- End of object definition for EDGCTORUS

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF) is ARC

  -- Initialise Variables
  !start   = !dbRef.pPosition[1]
  !end     = !dbRef.pPosition[2]
  !control = !dbRef.pPosition[3]

  return !!appMathLib.gmfArc.through3Points(!start, !control, !end)

endmethod
-- End of method definition for .arc(DBREF) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a given ppoint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
--    2   R      REAL        Ppoint number
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !pPoint is REAL) is ARC

  -- Initialise Variables
  !radius      = (!dbRef.rout - !dbRef.rins) / 2
  !position    = !dbRef.pPosition[!pPoint]
  !orientation = object ORIENTATION('Z is ' & !dbRef.pDirection[!pPoint] & ' and Y is ' & !dbRef.orientation.zDir())
  !arc         = object ARC(!position.wrt(World), !orientation.wrt(World), 0, 360, !radius, true)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, REAL) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a reference position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
--    2   R      REAL        Ppoint number
--    3   R      POSITION    Reference point through which the arc passed
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !position is POSITION) is ARC

  -- Initialise Variables
  !arc          = !this.arc(!dbRef)

  -- Plane of the arc
  !plane        = object PLANE(!dbRef.position, !dbRef.orientation )

  -- Map position onto plane
  !newPosition  = !plane.near(!position)
  !distance     = !plane.position.distance(!newPosition)

  -- Radius of "torus"
  !radius       = (!dbRef.rout - !dbRef.rins) / 2

  -- Centre line radius
  !clRadius     = (!dbRef.rout + !dbRef.rins) / 2

  -- Determine if we are near an "edge"
  !min          = !distance - !radius * 0.02
  !max          = !distance + !radius * 0.02

  -- Centre Line
  if(!clRadius.between(!min, !max)) then

    -- Distance from position picked and surface of plane
    if(!position.distance(!newPosition) gt 0) then
      if(!newPosition.direction(!position).angle(!arc.orientation.zDir()) eq 0) then
        !arc.position.up = !arc.position.up - !radius
      else
        !arc.position.up = !arc.position.up + !radius
      endif
      !arc.position = !arc.position.wrt(World)
    endif

  -- Inside radius
  elseif (!dbRef.rins.between(!min, !max)) then
    !arc.radius = !dbRef.rins

  -- Outside radius
  elseif (!dbRef.rout.between(!min, !max)) then
    !arc.radius = !dbRef.rout

  -- Surface
  else

    -- Move the "end" through the new position
    !newArc      = !arc.endPosition(!newPosition)
    !newPosition = !newArc.anglePosition(!newArc.endAngle)
    !orientation = object ORIENTATION('Z is ' & !newArc.endTangent() & ' and Y is ' & !dbRef.orientation.zDir())
    !arc         = object ARC(!newPosition.wrt(World), !orientation.wrt(World), 0, 360, !radius, true)

  endif

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, POSITION) ARC
