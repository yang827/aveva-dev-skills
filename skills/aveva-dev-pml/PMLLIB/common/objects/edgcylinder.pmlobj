--
-- Description:
-- Cylinder Handles
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc(DBREF)                       ARC                 Return circle definition
--  arc(DBREF,POSITION)              ARC                 Return circle definition through a reference position
--  arc(DBREF,REAL)                  ARC                 Return circle definition through a given ppoint
--  line(DBREF)                      LINE
--
------------------------------------------------------------------------

-- Define object
define object EDGCYLINDER

  -- Dummy
  member .dummy      is STRING
  -- Edit Form
  member .editForm   is FORM
  -- Create Form
  member .createForm is FORM

endobject
-- End of object definition for EDGCYLINDER

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Cylinder DBREF
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF) is ARC

  -- Initialise Variables
  !radius       = !dbRef.diameter / 2
  !position     = !dbRef.position
  !orientation  = !dbRef.orientation

  -- Define return arc
  !arc          = object ARC(!position.wrt(World), !orientation.wrt(World), 0, 360, !radius, true)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a given ppoint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Cylinder DBREF
--    2   R      REAL        Ppoint number
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !pPoint is REAL) is ARC

  -- Initialise Variables
  !arc          = !this.arc(!dbRef)
  !arc.position = !dbRef.pPosition[!pPoint].wrt(World)

  -- Orientation in ppoint direction
  !arc.orientation = object ORIENTATION('Z is ' & !dbRef.pDirection[!pPoint] & ' and Y is ' & !dbRef.orientation.yDir())
  handle any
    !arc.orientation = object ORIENTATION('Z is ' & !dbRef.pDirection[!pPoint] & ' and X is ' & !dbRef.orientation.xDir())
  endhandle
  !arc.orientation   = !arc.orientation.wrt(World)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, REAL) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a reference position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Cylinder DBREF
--    2   R      REAL        Ppoint number
--    3   R      POSITION    Reference point through which the arc passed
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !position is POSITION) is ARC

  -- Initialise Variables
  !arc  = !this.arc(!dbRef)

  -- Line reference position is to be projected onto
  !pv           = object POINTVECTOR(!arc.position, !arc.orientation.zDir())
  !arc.position = !pv.line(1000).near(!position).wrt(World)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, POSITION) ARC

------------------------------------------------------------------------
--
-- Method:    line
--
-- Description:
--   Return line definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Cylinder DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Cylinder as a LINE
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- Initialise Variables
  !line               = object LINE()
  !line.startPosition = !dbRef.pPosition[1].wrt(World)
  !line.endPosition   = !dbRef.pPosition[2].wrt(World)

  -- Return
  return !line

endmethod
-- End of method definition for .line(DBREF) LINE
