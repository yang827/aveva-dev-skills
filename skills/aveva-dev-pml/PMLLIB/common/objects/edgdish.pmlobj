--
-- Description:
-- Dish Handles
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc(DBREF)                       ARC                 Return Dish as a arc object
--  line(DBREF)                      LINE                Return Dish as a line object
--
------------------------------------------------------------------------

-- Define object
define object EDGDISH

  -- Dummy
  member .dummy      is STRING
  -- Edit Form
  member .editForm   is FORM
  -- Create Form
  member .createForm is FORM

endobject
-- End of object definition for EDGDISH

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Dish DBREF
-- Return:
--   [Data Type] [Description]
--    ARC         Dish as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF) is ARC

  -- Initialise Variables
  !radius          = !dbRef.diameter / 2
  !position        = !dbRef.position
  !orientation     = !dbRef.orientation

  -- Define return arc
  !return          = object ARC(!position.wrt(World), !orientation.wrt(World), 0, 360,!radius, true)

  -- Return
  return !return

endmethod
-- End of method definition for .arc(DBREF) ARC

------------------------------------------------------------------------
--
-- Method:    line
--
-- Description:  Return line definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Dish DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Dish as a LINE
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- Initialise Variables
  !return               = object LINE()
  !return.startPosition = !dbRef.pPosition[1].wrt(World)
  !return.endPosition   = !dbRef.pPosition[2].wrt(World)

  -- Return
  return !return

endmethod
-- End of method definition for .line(DBREF) LINE
