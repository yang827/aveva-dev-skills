--
------------------------------------------------------------------------

define method .fraction(!dbRef is DBREF, !fraction is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Get Surface of plane to work with
  !surface      = !this.surfacePicked(!dbRef, !refLine.direction())

  -- Get Plane
  !plane       = !this.plane(!dbRef, !surface)

  -- Intersection of lines
  !iPosition   = !plane.intersection(!refLine)

