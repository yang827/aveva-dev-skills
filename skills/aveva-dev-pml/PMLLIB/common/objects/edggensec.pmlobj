--
-- Description:
-- EDG Gensec handler.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc(DBREF)                       ARC
--  arc(DBREF,POINTVECTOR)           ARC                 Return circle definition through a reference position
--  arc(DBREF,POSITION)              ARC                 Return circle definition through a reference position
--  curve(DBREF)                     DBREF               Returns curve of passed segment
--  curve(DBREF,POINTVECTOR)         DBREF               Returns curve nearest to passed point vector
--  curve(DBREF,POSITION)            DBREF               Returns curve nearest to passed point
--  distance(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified distance from nearest end/snap to point vector on the section
--  distance(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified distance from nearest end/snap to point vector on the section
--  edgGensec()                      -                   Constructor
--  exact(DBREF,LINE)                POSITION            Return the intersection of the passed point vector with the section
--  exact(DBREF,POINTVECTOR)         POSITION            Return the intersection of the passed point vector with the section
--  fraction(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  fraction(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  line(DBREF)                      LINE                Return line definition of section where it only contain two POINSPs
--  line(DBREF,POINTVECTOR)          LINE                Return line definition of section using object settings
--  nextCurve(DBREF)                 DBREF               Returns next curve to passed curve
--  previousCurve(DBREF)             DBREF               Returns previous curve to passed curve
--  proportion(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  proportion(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  segmentArc(DBREF)                ARC                 Return arc definition of curve of spine
--  segmentLines(DBREF)              ARRAY               Return line definition of segment of spine
--  selectLine(ARRAY,POSITION)       LINE                Return the line with the point vector is closest to an within its bounds
--  snap(DBREF,LINE,BOOLEAN)         POSITION            Return nearest snap point on line using a passed line
--  snap(DBREF,POINTVECTOR,BOOLEAN)  POSITION            Return nearest snap point on line using a passed point vector
--
------------------------------------------------------------------------

define object EDGGENSEC

  -- Edit Form
  member .editForm      is FORM
  -- Create Form
  member .createForm    is FORM

  -- Extension options for theoretical start/end
  member .project       is BOOLEAN
  -- Attached line to project onto
  member .attachedLine  is STRING
  -- Owning line to project to
  member .owningLine    is STRING

  -- Snap considerations
  member .fitting       is BOOLEAN
  member .joint         is BOOLEAN
  member .node          is BOOLEAN

endobject
-- End of object definition for EDGGENSEC

------------------------------------------------------------------------
--
-- Method:      edgGensec
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgGensec()

  -- Initialise Variables
  !this.project       = false
  !this.attachedLine  = 'JUSLINE'
  !this.owningLine    = 'JUSLINE'
  !this.fitting       = false
  !this.joint         = false
  !this.node          = false

endmethod
-- End of method definition for .edgGensec()

------------------------------------------------------------------------
--
-- Method:      curve
--
-- Description: Returns curve of passed segment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curve(!segment is DBREF) is DBREF

  -- Initialise Variables
  return !segment.owner.members[!segment.sequence + 1]

endmethod
-- End of method definition for .curve(DBREF) DBREF

------------------------------------------------------------------------
--
-- Method:      curve
--
-- Description: Returns curve nearest to passed point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Gensec dbref
--    2   R      POSITION    Position near spine
-- Return:
--   [Data Type] [Description]
--    DBREF       Curve nearest point
--
------------------------------------------------------------------------

define method .curve(!dbRef is DBREF, !position is POSITION) is DBREF

  -- Initialise Variables
  !reference   = !!ce
  !curve       = object DBREF()

  -- Justification
  !justification = !dbRef.jusLine
  if(!justification.unset()) then
    !justification = 'NA'
  endif

  -- Get segment of spine
  !!ce       = !dbRef
  var !segmentString ID SEGMENT PPLINE $!<justification> THROUGH $!<position> VIA PLINE BOUND
  handle any
    var !segmentString ID SEGMENT PPLINE ANY THROUGH $!<position> VIA PLINE BOUND
    handle any
      !!ce   = !reference
      return !curve
    endhandle
  endhandle
  !!ce       = !reference

  -- If there is no segment set, then return
  if(!segmentString.unset()) then
    return !curve
  endif

  !segment   = !segmentString.dbRef()

  return !this.curve(!segment)

endmethod
-- End of method definition for .curve(DBREF, POSITION) DBREF

------------------------------------------------------------------------
--
-- Method:      curve
--
-- Description: Returns curve nearest to passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Gensec dbref
--    1   R      POSITIONVECTOR  Point vector
-- Return:
--   [Data Type] [Description]
--    DBREF       Curve nearest point
--
------------------------------------------------------------------------

define method .curve(!dbRef is DBREF, !pointVector is POINTVECTOR) is DBREF

  -- Initialise Variables
  -- Get plane of gensec
  !plane    = object PLANE(!dbRef.position, !dbRef.orientation)

  -- Get point vector intersection with plane
  !position = !plane.intersection(!pointVector)

  return !this.curve(!dbRef, !position)
endmethod
-- End of method definition for .curve(DBREF, POINTVECTOR) DBREF

------------------------------------------------------------------------
--
-- Method:      previousCurve
--
-- Description: Returns previous curve to passed curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .previousCurve(!curve is DBREF) is DBREF

  -- Initialise Variables
  if(!curve.unset()) then
    return object DBREF()
  endif

  -- Check if curves position is le to 2
  if(!curve.sequence le 2) then
    return object DBREF()
  endif

  !previous = !curve.owner.members[!curve.sequence - 2]

  if(!previous.type ne 'CURVE') then
    return object DBREF()
  endif

  return !previous

endmethod
-- End of method definition for .previousCurve(DBREF) DBREF

------------------------------------------------------------------------
--
-- Method:      nextCurve
--
-- Description: Returns next curve to passed curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nextCurve(!curve is DBREF) is DBREF

  -- Initialise Variables
  if(!curve.unset()) then
    return object DBREF()
  endif

  -- Check if curves position is le to 2
  if(!curve.sequence ge !curve.owner.members.size() - 2) then
    return object DBREF()
  endif

  !next = !curve.owner.members[!curve.sequence + 2]

  if(!next.type ne 'CURVE') then
    return object DBREF()
  endif
  return !next

endmethod
-- End of method definition for .nextCurve(DBREF) DBREF

------------------------------------------------------------------------
--
-- Method:      segmentArc
--
-- Description: Return arc definition of curve of spine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       curve DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .segmentArc(!curve is DBREF) is ARC

  -- Initialise Variables
  !arc   = object ARC()

  -- Calculate arc
  !arc   = !!appMathLib.gmfArc.through3Points(!curve.pPosition[3], !curve.pPosition[7], !curve.pPosition[4])

  -- Return
  return !arc

endmethod
-- End of method definition for .segmentArc(DBREF) ARC

-----------------------------------------------------------------------
--
-- Method:      arc
--
-- Description:
--   Return circle definition of section (only can handle sections which
--   have a property of DIAM
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
-- Return:
--   [Data Type] [Description]
--    ARC         Arc
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF) is ARC

  -- Initialise Variables

  -- If gensec is flagged as a "RING", then return the arc of the ring
  if(!dbRef.function eq 'RING') then

    -- Get spine
    !spine            = !!dtbMemberOfType(!dbRef, 'SPINE', 1)
    !memberCount      = !spine.members.size()
      !curve          = !!dtbMemberOfType(!spine, 'CURVE', 1)

    -- If there are three members to the spine, then we will assume an arc < 360 degrees
    if(!memberCount eq 3) then
      !arc            = object ARC(!dbRef.position, !dbRef.orientation, 0, 180, !curve.radius, true)
      !arc            = !arc.startPosition(!curve.pPosition[3])
      !arc            = !arc.endPosition(!curve.pPosition[4])

      -- Angle between start, origin and curve point[7]
      --!segmentAngle   = !dbRef.position.angle(!curve.pPosition[3], !curve.pPosition[7])
      !arc.sense      = !arc.onProjected(!curve.pPosition[7])

    -- If there are five members, then we will assume a 360 degree arc
    elseif (!memberCount eq 5) then
      !endCurve       = !!dtbMemberOfType(!spine, 'CURVE', 2)
      !arc            = object ARC(!dbRef.position, !dbRef.orientation, 0, 360, !endCurve.radius, true)

    else
      return object ARC()
    endif

    -- Special case for "WALL" rings (wall always point UP)
    if(!dbRef.type eq 'WALL') then

      -- Check orientation of arc against the orientation of the wall
      if(!dbRef.orientation.zDir().angle(!arc.orientation.zDir()).int() ne 0) then
        !oldArc = !arc
        !arc.orientation  = !dbRef.orientation.wrt(World)
        !startAngle       = !arc.near(!oldArc.anglePosition(!oldArc.startAngle))
        !endAngle         = !arc.near(!oldArc.anglePosition(!oldArc.endAngle))
        !arc.startAngle   = !startAngle
        !arc.endAngle     = !endAngle
        if(!arc.startAngle eq !arc.endAngle) then
          !arc.endAngle   = 0
          !arc.startAngle = 360
        endif
        !arc.sense        = false
      endif
    endif

    return !arc

  endif

endmethod
-- End of method definition for .arc(DBREF) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a reference position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
--    2   R      POSITION    Reference point through which the arc passed
-- Return:
--   [Data Type] [Description]
--    ARC         Arc
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !position is POSITION) is ARC

  -- Initialise Variables
  !arc       = object ARC()

  -- Handle Ring sections
  if(!dbRef.function eq 'RING') then
    return !this.arc(!dbRef)
  endif

  -- Get the curve
  !curve = !this.curve(!dbRef, !position)

  -- Check for returned curve point
  if(!curve.unset()) then
    return !arc
  endif

  -- Get relevant ppoint of curve
  !arc   = !this.segmentArc(!curve)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, POSITION) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a reference position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
--    2   R      POINTVECTOR Point vector of pick
-- Return:
--   [Data Type] [Description]
--    ARC         Arc
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !pointVector is POINTVECTOR) is ARC

  -- Initialise Variables
  !arc       = object ARC()

  !plane     = object PLANE(!dbRef.position, !dbRef.orientation)
  !position  = !plane.intersection(!pointVector)
  return !this.arc(!dbRef, !position)

endmethod
-- End of method definition for .arc(DBREF, POINTVECTOR) ARC

------------------------------------------------------------------------
--
-- Method:      segmentLines
--
-- Description: Return line definition of segment of spine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       segment DBREF
-- Return:
--   [Data Type] [Description]
--    ARRAY       Adjacent lines to curve definition
--
------------------------------------------------------------------------

define method .segmentLines(!curve is DBREF) is ARRAY

  -- Initialise Variables
  !lines[1] = object LINE()
  !lines[2] = object LINE()

  -- Previous Curve
  !previous = !this.previousCurve(!curve)
  !next     = !this.nextCurve(!curve)

  -- Previous curve defined
  if(!previous.set()) then
    !lines[1].startPosition = !previous.pPosition[4].wrt(World)
  else
    !lines[1].startPosition = !curve.pPosition[1].wrt(World)
  endif

  -- Next curve defined
  if(!next.set()) then
    !lines[2].endPosition   = !next.pPosition[3].wrt(World)
  else
    !lines[2].endPosition   = !curve.pPosition[2].wrt(World)
  endif

  !lines[1].endPosition     = !curve.pPosition[3].wrt(World)
  !lines[2].startPosition   = !curve.pPosition[4].wrt(World)

  -- Return
  return !lines

endmethod
-- End of method definition for .segmentLines(DBREF) ARRAY

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return line definition of section where it only contain two POINSPs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- Initialise Variables
  !line  = object LINE()

  -- Get spine
  !spine = !!dtbMemberOfType(!dbRef, 'SPINE', 1)

  -- If there are more than two members of the spine, then
  -- return no line
  if(!spine.members.size() gt 2) then
    return object LINE()
  endif

  !line = object LINE(!dbRef.posStart.wrt(World), !dbRef.posEnd.wrt(World))
  handle any
    return object LINE()
  endhandle

  return !line

endmethod
-- End of method definition for .line(DBREF) LINE

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return line definition of section using object settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Pick on line
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF, !pointVector is POINTVECTOR) is LINE

  -- Initialise Variables

  -- Get curve segment nearest to pick
  !curve = !this.curve(!dbRef, !pointVector)

  -- Segment line
  !lines = !this.segmentLines(!curve)

  -- Intersection of point on lines
  !iPosition[1] = !lines[1].intersection(!pointVector)
  !iPosition[2] = !lines[2].intersection(!pointVector)

  -- Determine if intersection lies on the either line
  -- Line 1
  if(!lines[1].onProjected(!iPosition[1])) then
    return !lines[1]

  -- Line 2
  elseif (!lines[2].onProjected(!iPosition[2])) then
    return !lines[2]

  endif

  return object LINE()

endmethod
-- End of method definition for .line(DBREF, POINTVECTOR) LINE

------------------------------------------------------------------------
--
-- Method:      selectLine
--
-- Description: Return the line with the point vector is closest to an within its bounds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Lines
--    2   R      POSITION    Position to test against
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .selectLine(!lines is ARRAY, !position is POSITION) is LINE

  -- Initialise Variables
  !online[1] = false
  !online[2] = false
  if( !lines[1].set() ) then
    if( !lines[1].length() gt 0mm ) then
      -- Intersection of point on lines
      !iPosition[1] = !lines[1].near(!position)
      -- On project line
      !online[1]    = !lines[1].onProjected(!iPosition[1])
      -- Distance from lines
      !distance[1]  = !lines[1].distance(!position)
    endif
  endif
  if( !lines[2].set() ) then
    if( !lines[2].length() gt 0mm ) then
      -- Intersection of point on lines
      !iPosition[2] = !lines[2].near(!position)
      -- On project line
      !online[2]    = !lines[2].onProjected(!iPosition[2])
      -- Distance from lines
      !distance[2]  = !lines[2].distance(!position)
    endif
  endif

  -- Determine the line to use
  if(!online[1].not() and !online[2].not()) then
    return object LINE()

  elseif(!online[1].not()) then
    return !lines[2]

  elseif(!online[2].not()) then
    return !lines[1]

  else

    if (!distance[1] le !distance[2]) then
      return !lines[1]
    else
      return !lines[2]
    endif

  endif

endmethod
-- End of method definition for .selectLine(ARRAY, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Point vector to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Handle RING GENSEC elements
  if(!dbRef.function.upcase() eq 'RING') then
    !gmfArc   = object GMFARC(!this.arc(!dbRef))
    !position = !gmfArc.snap(!pointVector)

  -- Decompose into lines & arcs
  else

    -- Get curve segment nearest to pick
    !curve = !this.curve(!dbRef, !pointVector)

    -- If curve if a POINSP, then we have a straight gensec
    if(!curve.type eq 'POINSP') then
      !line       = !this.line(!dbRef)
      !iPosition  = !line.intersection(!pointVector)
      !gmfLine    = object GMFLINE(!line)
      !position   = !gmfLine.snap(!iPosition)

    else

      -- Plane
      !plane = object PLANE(!dbRef.position, !dbRef.orientation)

      -- Segment line
      !lines      = !this.segmentLines(!curve)

      -- Determine the line to use
      !line       = !this.selectLine(!lines, !plane.intersection(!pointVector))

      -- Snap on line
      if(!line.set()) then
        !position = !line.intersection(!pointVector)
        !gmfLine  = object GMFLINE(!line)
        !position = !gmfLine.snap(!position)

      -- Arc
      else
        !arc      = !this.segmentArc(!curve)
        !gmfArc   = object GMFARC(!arc)
        !position = !gmfArc.snap(!pointVector)
      endif
    endif
  endif

  -- Return position
  return !position.wrt(World)

endmethod
-- End of method definition for .snap(DBREF, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      LINE        Line to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  return !this.snap(!dbRef, !refLine.pointVector(), !intermediates)

endmethod
-- End of method definition for .snap(DBREF, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position of specified distance from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Distance
--    2   R      POINTVECTOR Point vector
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Distance position on line
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Handle RING GENSEC elements
  if(!dbRef.function.upcase() eq 'RING') then
    !gmfArc   = object GMFARC(!this.arc(!dbRef))
    !position = !gmfArc.distance(!distance, !pointVector)

  -- Decompose into lines & arcs
  else

    -- Get curve segment nearest to pick
    !curve = !this.curve(!dbRef, !pointVector)

    -- If curve if a POINSP, then we have a straight gensec
    if(!curve.type eq 'POINSP') then
      !line         = !this.line(!dbRef)
      !iPosition    = !line.intersection(!pointVector)
      !gmfLine      = object GMFLINE(!line)
      !position     = !gmfLine.distance(!distance, !iPosition)

    else

      -- Plane
      !plane = object PLANE(!dbRef.position, !dbRef.orientation)

      -- Segment line
      !lines      = !this.segmentLines(!curve)

      -- Determine the line to use
      !line       = !this.selectLine(!lines, !plane.intersection(!pointVector))

      -- Snap on line
      if(!line.set()) then
        !position = !line.intersection(!pointVector)
        !gmfLine  = object GMFLINE(!line)
        !position = !gmfLine.distance(!distance, !position)

      -- Arc
      else
        !arc      = !this.segmentArc(!curve)
        !gmfArc   = object GMFARC(!arc)
        !position = !gmfArc.distance(!distance, !pointVector)
      endif
    endif
  endif

  -- Return point
  return !position.wrt(World)

endmethod
-- End of method definition for .distance(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position of specified distance from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Distance
--    3   R      LINE        Line to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Distance position on line
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  return !this.distance(!dbRef, !distance, !refLine.pointVector(), !intermediates)

endmethod
-- End of method definition for .distance(DBREF, REAL, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      proportion
--
-- Description: Return position of specified proportion from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Proportion
--    2   R      POINTVECTOR Point vector
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .proportion(!dbRef is DBREF, !proportion is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Handle RING GENSEC elements
  if(!dbRef.function.upcase() eq 'RING') then
    !gmfArc   = object GMFARC(!this.arc(!dbRef))
    !position = !gmfArc.proportion(!proportion, !pointVector)

  -- Decompose into lines & arcs
  else

    -- Get curve segment nearest to pick
    !curve = !this.curve(!dbRef, !pointVector)

    -- If curve if a POINSP, then we have a straight gensec
    if(!curve.type eq 'POINSP') then
      !line         = !this.line(!dbRef)
      !iPosition    = !line.intersection(!pointVector)
      !gmfLine      = object GMFLINE(!line)
      !position     = !gmfLine.proportion(!proportion, !iPosition)

    else

      -- Plane
      !plane = object PLANE(!dbRef.position, !dbRef.orientation)

      -- Segment line
      !lines      = !this.segmentLines(!curve)

      -- Determine the line to use
      !line       = !this.selectLine(!lines, !plane.intersection(!pointVector))

      -- Snap on line
      if(!line.set()) then
        !position = !line.intersection(!pointVector)
        !gmfLine  = object GMFLINE(!line)
        !position = !gmfLine.proportion(!proportion, !position)

      -- Arc
      else
        !arc      = !this.segmentArc(!curve)
        !gmfArc   = object GMFARC(!arc)
        !position = !gmfArc.proportion(!proportion, !pointVector)
      endif
    endif
  endif

  -- Return point
  return !position.wrt(World)

endmethod
-- End of method definition for .proportion(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      proportion
--
-- Description: Return position of specified proportion from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Proportion
--    3   R      LINE        Line to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .proportion(!dbRef is DBREF, !proportion is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  return !this.proportion(!dbRef, !proportion, !refLine.pointVector(), !intermediates)

endmethod
-- End of method definition for .proportion(DBREF, REAL, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      fraction
--
-- Description: Return position of specified proportion from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Fraction
--    2   R      POINTVECTOR Point vector
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .fraction(!dbRef is DBREF, !fraction is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Handle RING GENSEC elements
  if(!dbRef.function.upcase() eq 'RING') then
    !gmfArc   = object GMFARC(!this.arc(!dbRef))
    !position = !gmfArc.fraction(!fraction, !pointVector)

  -- Decompose into lines & arcs
  else

    -- Get curve segment nearest to pick
    !curve = !this.curve(!dbRef, !pointVector)

    -- If curve if a POINSP, then we have a straight gensec
    if(!curve.type eq 'POINSP') then
      !line         = !this.line(!dbRef)
      !iPosition    = !line.intersection(!pointVector)
      !gmfLine      = object GMFLINE(!line)
      !position     = !gmfLine.fraction(!fraction, !iPosition)

    else

      -- Plane
      !plane = object PLANE(!dbRef.position, !dbRef.orientation)

      -- Segment line
      !lines      = !this.segmentLines(!curve)

      -- Determine the line to use
      !line       = !this.selectLine(!lines, !plane.intersection(!pointVector))

      -- Snap on line
      if(!line.set()) then
        !position = !line.intersection(!pointVector)
        !gmfLine  = object GMFLINE(!line)
        !position = !gmfLine.fraction(!fraction, !position)

      -- Arc
      else
        !arc      = !this.segmentArc(!curve)
        !gmfArc   = object GMFARC(!arc)
        !position = !gmfArc.fraction(!fraction, !pointVector)
      endif
    endif
  endif

  -- Return point
  return !position.wrt(World)

endmethod
-- End of method definition for .fraction(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      fraction
--
-- Description: Return position of specified proportion from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Fraction
--    3   R      LINE        Line to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .fraction(!dbRef is DBREF, !fraction is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  return !this.fraction(!dbRef, !fraction, !refLine.pointVector(), !intermediates)

endmethod
-- End of method definition for .fraction(DBREF, REAL, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return the intersection of the passed point vector with the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !pointVector is POINTVECTOR) is POSITION

  -- Handle RING GENSEC elements
  if(!dbRef.function.upcase() eq 'RING') then
    !gmfArc   = object GMFARC(!this.arc(!dbRef))
    !position = !gmfArc.exact(!pointVector)

   -- Decompose into lines & arcs
  else

     -- Get curve segment nearest to pick
    !curve = !this.curve(!dbRef, !pointVector)

    -- If curve if a POINSP, then we have a straight gensec
    if(!curve.type eq 'POINSP') then
      !line         = !this.line(!dbRef)
      !position     = !line.intersection(!pointVector)

    else

      -- Plane
      !plane = object PLANE(!dbRef.position, !dbRef.orientation)

      -- Segment line
      !lines      = !this.segmentLines(!curve)

      -- Determine the line to use
      !line       = !this.selectLine(!lines, !plane.intersection(!pointVector))

      -- Snap on line
      if(!line.set()) then
        !position = !line.intersection(!pointVector)

      -- Arc
      else
        !arc      = !this.segmentArc(!curve)
        !gmfArc   = object GMFARC(!arc)
        !position = !gmfArc.exact(!pointVector)
      endif
    endif
  endif

  -- Return point
  return !position.wrt(World)

endmethod
-- End of method definition for .exact(DBREF, POINTVECTOR) POSITION

------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return the intersection of the passed point vector with the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      LINE        Line
--
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !refLine is LINE) is POSITION

  return !this.exact(!dbRef, !refLine.pointVector())

endmethod
-- End of method definition for .exact(DBREF, LINE) POSITION
