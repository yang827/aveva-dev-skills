--
------------------------------------------------------------------------

define method .fraction(!dbRef is DBREF, !fraction is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Convert point vector into a line and use snap line method
  return !this.fraction(!dbRef, !fraction, !pointVector.line(1000mm), !intermediates)

endmethod
-- End of method definition for .fraction(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      fraction
--
-- Description: Return position to nearest fraction of the nearest edge line to the passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      REAL        fraction
--    3   R      LINE        Line
--    4   R      BOOLEAN     Intermediate snaps (not required)
-- Return:
--   [Data Type] [Description]
--    POSITION    position on edge
--
------------------------------------------------------------------------

define method .fraction(!dbRef is DBREF, !fraction is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Get Surface of plane to workwith
  !surface      = !this.surfacePicked(!dbRef, !refLine.direction())

  -- Get Plane
  !plane       = !this.plane(!dbRef, !surface)

  -- Intersection of lines
  !iPosition   = !plane.intersection(!refLine)

  -- Get nearest edge to pick
  !gmfLine     = object GMFLINE(!this.nearestEdge(!dbRef, !iPosition, !surface))
  return !gmfLine.fraction(!fraction, !iPosition)

endmethod
-- End of method definition for .fraction(DBREF, REAL, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return intersection of point vector on the "picked" panel surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    POSITION    position on panel
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !pointVector is POINTVECTOR) is POSITION

  -- Convert point vector into a line and use snap line method
  return !this.exact(!dbRef, !pointVector.line(1000mm))

endmethod
-- End of method definition for .exact(DBREF, POINTVECTOR) POSITION

------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return intersection of point vector on the "picked" panel surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      LINE        Line
-- Return:
--   [Data Type] [Description]
--    POSITION    position on panel
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !refLine is LINE) is POSITION

  -- Get Surface of plane to workwith
  !surface = !this.surfacePicked(!dbRef, !refLine.direction())

  -- Get Plane
  !plane   = !this.plane(!dbRef, !surface)

  -- Snap to edges
  if(!this.edges) then

    -- Get nearest edge to pick
    !iPosition = !plane.intersection(!refLine)
    !line      = !this.nearestEdge(!dbRef, !iPosition, !surface)

    -- Get position on edge
    return !line.intersection(!refLine).wrt(World)

  else

    -- Intersection of line and panel
    return !plane.intersection(!refLine).wrt(World)

  endif

endmethod
-- End of method definition for .exact(DBREF, LINE) POSITION

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return edge line nearest to point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        Panel DBREF
--    2   R      POINTVECTOR Pick line
-- Return:
--   [Data Type] [Description]
--    LINE        Edge line
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF, !pointVector is POINTVECTOR) is LINE

  -- Get Surface of plane to workwith
  !surface   = !this.surfacePicked(!dbRef, !pointVector.direction)

  -- Get Plane
  !plane     = !this.plane(!dbRef, !surface)

  -- Get nearest edge to pick
  !refLine   = !pointVector.line(1000mm)
  !iPosition = !plane.intersection(!refLine)
  !line      = !this.nearestEdge(!dbRef, !iPosition, !surface)

  -- Get position on edge
  return !line

endmethod
-- End of method definition for .line(DBREF, POINTVECTOR) LINE
