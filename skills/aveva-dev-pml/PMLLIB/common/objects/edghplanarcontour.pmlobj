--
-- Description:
-- Hull plate and panel handler
-- INTERFACE MUST BE MAINTAINED EVEN IF OPERATIONS NOT USED (e.g. intermediate snap)
-- This object derived from PANEL handle
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allProfiles(DBREF)               ARRAY               Return array of Boundary Profile elements for the input element.
--  arc(DBREF)                       ARRAY               Return circle definition
--  arc(DBREF,POINTVECTOR)           ARC                 Return circle definition
--  arc(DBREF,POSITION)              ARC                 Return circle definition
--  distance(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position at specified distance from the start/end of the nearest edge line to the passed line
--  distance(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position at specified distance from the start/end of the nearest edge line to the passed point vector
--  edgHPlanarContour()              -
--  edgeLines(DBREF)                 ARRAY               Return edges as an array of line definitions
--  edgeLines(DBREF,STRING)          ARRAY               Return edges as an array of line definitions mapped onto a specific surface of the panel
--  exact(DBREF,LINE)                POSITION            Return intersection of point vector on the "picked" panel surface
--  exact(DBREF,POINTVECTOR)         POSITION            Return intersection of point vector on the "picked" panel surface
--  fraction(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position to nearest fraction of the nearest edge line to the passed point vector
--  fraction(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position to nearest fraction of the nearest edge line to the passed point vector
--  interpret(DBREF,POINTVECTOR)     ANY                 Interpret panel as and edge or plane dependent on .edges setting
--  justification()                  STRING              Return the justification setting
--  justification(STRING)            -                   Set the justification setting
--  line(DBREF,POINTVECTOR)          LINE                Return edge line nearest to point vector
--  loop(DBREF)                      DBREF               Return loop of panel
--  nearestEdge(DBREF,POINTVECTOR)   LINE                Returns nearest edge to passed position when mapped onto the passed surface
--  nearestEdge(DBREF,POSITION,STRING) LINE                Returns nearest edge to passed position when mapped onto the passed surface
--  pickSurface()                    STRING              Returns the surface settings
--  pickSurface(STRING)              -                   Set the current pick surface settings
--  plane(DBREF)                     PLANE               Return the plane of the panel, using surface settings
--  plane(DBREF,STRING)              PLANE               Return the plane of the panel using the passed surface
--  profile(DBREF)                   PROFILE             Return profile of passed element
--  profileNoArcs(DBREF)             PROFILE             Return profile of panel with arcs replaced by lines
--  proportion(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position at specified proportion from the start/end of the nearest edge line to the passed line
--  proportion(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position at specified proportion from the start/end of the nearest edge line to the passed point vector
--  snap(DBREF,LINE,BOOLEAN)         POSITION            Return nearest snap point on line using a passed line
--  snap(DBREF,POINTVECTOR,BOOLEAN)  POSITION            Return nearest snap point on line using a passed point vector
--  snapPoints(PROFILE)              ARRAY               return array of points at ends of spans
--  surface(DBREF,DIRECTION)         STRING              Return the surface towards the passed direction (visible)
--  surfacePicked(DBREF,DIRECTION)   STRING              Return the surface picked using the current pick settings
--
------------------------------------------------------------------------

define object EDGHPLANARCONTOUR

  -- Edit Form
  member .editForm   is FORM
  -- Create Form
  member .createForm is FORM

  -- Snap considerations
  member .fitting       is BOOLEAN
  member .vertex        is BOOLEAN
  member .edges         is BOOLEAN

  -- Surface for picked items
  member .visible       is BOOLEAN
  member .invisible     is BOOLEAN
  member .middle        is BOOLEAN
  member .origin        is BOOLEAN

  -- Surface of panel for plane
  member .top           is BOOLEAN
  member .bottom        is BOOLEAN
  member .centre        is BOOLEAN
  member .justification is BOOLEAN

  -- Depth in from surface
  member .offset        is REAL

  -- Do we consider negative elements?
  member .negative      is BOOLEAN

endobject
-- End of object definition for EDGPANEL

-----------------------------------------------------------------------
--
-- Method:      edgPanel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgHPlanarContour()

  -- Initialise Variables
  !this.edges          = false
  !this.fitting        = false
  !this.vertex         = true
  !this.negative       = false

  -- Surface for picked items
  !this.visible        = true
  !this.invisible      = false
  !this.middle         = false
  !this.origin         = false

  -- The justification
  !this.top            = false
  !this.bottom         = false
  !this.centre         = false
  !this.justification  = true

  -- Depth in from surface
  !this.offset         = 0

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      loop
--
-- Description: Return reference from which boundary can be determined
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
-- Return:
--   [Data Type] [Description]
--    DBREF       Loop
--
------------------------------------------------------------------------

define method .loop(!dbRef is DBREF) is DBREF

  -- make sure that this element has a boundary
  !element     = !dbRef
--  !pntArray    = !dbRef.pntArr
--  handle any
--    !pntArray  = ARRAY()
--  endhandle
--
--  -- if no boundary try to climb one level in the DB hierarchy
--  if( !pntArray.empty() ) then
--    !element   = !dbRef.owner
--  endif

  -- calling function must check that the element has a valid pntArr
  return !element

endmethod
-- End of method definition for .loop(DBREF) DBREF

-----------------------------------------------------------------------
--
-- Method:      allProfiles
--
-- Description: Return array of Boundary Profile elements for the input element.
--              First is the outer boundary - The rest are hole profiles of panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of Boundary Profile elements. First is the outer boundary
--                The rest may be holes
--
------------------------------------------------------------------------

define method .allProfiles(!dbRef is DBREF) is ARRAY

  -- get element holding boundary definition
  !element     = !this.loop(!dbRef)

  !profiles    = ARRAY()
  -- first add outer boundary
  !profiles[1] = !this.profile( !element )
  -- for HPLATE - climb to HPANEL element to get holes
  if( !element.hardType eq 'HPLATE' ) then
    --!types[1]    = 'HPANEL'
    --!hPanel      = !!dtbOwnerOfTypes(!element, !types)
    --if( !hPanel.unset() ) then
    --  return !profiles
    --endif
    !hPanel = !dbRef.owner

    -- first check that original HPLATE had a boundary - some don't!
    if( !profiles[1].unset() ) then
      -- original profile did not have a boundary - try to get it from the HPANEL
      !profiles[1] = !this.profile( !hPanel )
      if( !profiles[1].unset() ) then
        -- if not boundary can be found return an empty array
        return ARRAY()
      endif
    endif

    -- find holes in the element
    !hPanelMembers = !hPanel.members
    do !member values !hPanelMembers
      skip if( !member.hardType neq 'HHOLE')
      !holeProfile = !this.profile( !member )
      skip if( !holeProfile.unset() )
      -- only add to list if this hole is at least partly contained
      -- in the outer profile
      skip if( !profiles[1].isWithout( !holeProfile ) )
      !profiles.append( !holeProfile )
    enddo

  endif

  return !profiles

endmethod
-- End of method definition for .profile(DBREF) DBREF

-----------------------------------------------------------------------
--
-- Method:      profile
--
-- Description: Return profile of passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of Boundary Profile elements. First is the outer boundary
--                The rest may be holes
--
------------------------------------------------------------------------

define method .profile(!dbRef is DBREF) is PROFILE

  -- Get Ploop
  !profile = object PROFILE( !this.loop(!dbRef) )

  return !profile

endmethod
-- End of method definition for .profile(DBREF) DBREF

-----------------------------------------------------------------------
--
-- Method:      profileNoArcs
--
-- Description: Return profile of panel with arcs replaced by lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
-- Return:
--   [Data Type] [Description]
--    PROFILE     Boundary Profile (no arcs)
--
------------------------------------------------------------------------

define method .profileNoArcs(!dbRef is DBREF) is PROFILE

  -- Get Ploop
  !element = !this.loop(!dbRef)
  !profile = !this.profile(!element)
  -- return edges with arcs replaced by lines
  !profile = !profile.projectArcs(1)
  return !profile

endmethod
-- End of method definition for .profile(DBREF) DBREF

-----------------------------------------------------------------------
--
-- Method:      snapPoints
--
-- Description: return array of points at ends of spans
--              Arcs are replaced by a single chord from arc
--              start to arc end
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to convert into points
-- Return:
--   [Data Type] [Description]
--    DBREF       Array of points
--
------------------------------------------------------------------------

define method .snapPoints(!profile is PROFILE) is ARRAY

  -- Initialise variables
  !points   = ARRAY()
  !lastEdge = object LINE()

  -- Get Ploop
  !edges = !profile.edges()
  do !index indices !edges
    !edge = !edges[!index]
    if( !edge.objectType() eq 'LINE' ) then
      !points.append( !edge.startPosition )
    elseif( !edge.objectType() eq 'ARC' ) then
      if( !lastEdge.objectType() eq 'ARC' ) then
        -- do not include tangent continuous transition from arc to arc (tolerance 1 degree)
        if( !lastEdge.endTangent().angle(!edge.startTangent()).abs() gt 1 ) then
          -- last arc and this arc not tangent continuous at ends - get arc start point
          !points.append( !edge.anglePosition(!edge.startAngle) )
        endif
      else
        -- last edge was straight - get arc start point
        !points.append( !edge.anglePosition(!edge.startAngle) )
      endif
    endif
    -- record the last edge to test for tangent continuous arcs
    !lastEdge.delete()
    !lastEdge = !edge
    -- must delete edge because its type changes
    !edge.delete()
  enddo

  -- if profile is not closed then the end point must be added
  if( !profile.isClosed().not() ) then

    !edge = !edges.last()
    if( !edge.objectType() eq 'LINE' ) then
      !points.append( !edge.endPosition )
    elseif( !edge.objectType() eq 'ARC' ) then
      -- get arc start point
      !points.append( !edge.anglePosition(!edge.endAngle) )
    endif

  endif

  return !points

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      interpret
--
-- Description: Interpret panel as an edge or plane dependent on .edges setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
--    2   R      POINTVECTOR Pick vector
-- Return:
--   [Data Type] [Description]
--    ANY         Plane/Line depending on settings
--
------------------------------------------------------------------------

define method .interpret(!dbRef is DBREF, !pointVector is POINTVECTOR) is ANY

  -- If edge then return the nearest line
  if(!this.edges) then

    return !this.nearestEdge(!dbRef, !pointVector)

  else

    -- Get Surface of plane to work with
    !surface        = !this.surfacePicked(!dbRef, !pointVector.direction)

    -- Get Plane
    !plane          = !this.plane(!dbRef, !surface)

    -- Intersection of lines
    !plane.position = !pointVector.intersection(!plane)
    return !plane

  endif

endmethod
-- End of method definition for .interpret(DBREF, POINTVECTOR) ANY

-----------------------------------------------------------------------
--
-- Method:      justification
--
-- Description: Return the justification setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Current setting
--
------------------------------------------------------------------------

define method .justification() is STRING

  -- The justification
  if(!this.top) then
    return 'Top'
  elseif (!this.bottom) then
    return 'Bottom'
  elseif (!this.centre) then
    return 'Centre'
  elseif (!this.justification) then
    return 'Defined justification'
  endif
  return STRING()

endmethod
-- End of method definition for .justification() STRING

-----------------------------------------------------------------------
--
-- Method:      justification
--
-- Description: Set the justification setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Justification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .justification(!justify is STRING)

  -- Initialise Variables
  !this.top              = false
  !this.bottom           = false
  !this.centre           = false
  !this.justification    = false

  if(!justify.upcase() eq 'TOP') then
    !this.top            = true
  elseif (!justify.upcase() eq 'BOTTOM') then
    !this.bottom         = true
  elseif (!justify.upcase() eq 'CENTRE') then
    !this.centre         = true
  else
    !this.justification  = true
  endif

endmethod
-- End of method definition for .justification(STRING)

-----------------------------------------------------------------------
--
-- Method:      pickSurface
--
-- Description: Set the current pick surface settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Surface
-- Return:
--   [Data Type] [Description]
--    STRING      Current setting
--
------------------------------------------------------------------------

define method .pickSurface(!surface is STRING)

  -- Initialise Variables
  !this.visible     = false
  !this.invisible   = false
  !this.middle      = false
  !this.origin      = false

  -- The justification
  if(!surface.upcase() eq 'VISIBLE') then
    !this.visible   = true
  elseif (!surface.upcase() eq 'INVISIBLE') then
    !this.invisible = true
  elseif (!surface.upcase() eq 'MIDDLE') then
    !this.middle    = true
  else
    !this.origin    = true
  endif

endmethod
-- End of method definition for .pickSurface(STRING)

-----------------------------------------------------------------------
--
-- Method:      pickSurface
--
-- Description: Returns the surface settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickSurface() is STRING

  -- The justification
  if(!this.visible) then
    return 'Visible'
  elseif (!this.invisible) then
    return 'Invisible'
  elseif (!this.middle) then
    return 'Middle'
  elseif (!this.origin) then
    return 'Origin'
  endif
  return STRING()

endmethod
-- End of method definition for .pickSurface() STRING

-----------------------------------------------------------------------
--
-- Method:      surface
--
-- Description: Return the surface towards the passed direction (visible)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      DIRECTION   "look" direction towards panel
-- Return:
--   [Data Type] [Description]
--    STRING      Current setting
--
------------------------------------------------------------------------

define method .surface(!dbRef is DBREF, !direction is DIRECTION) is STRING

  -- Initialise Variables
  !panelDirection = !dbRef.orientation.zDir()

  -- Angle between passed direction and panel direction
  !angle = !panelDirection.angle(!direction)

  -- If angle ge 90, then we are "looking" at the top
  if(!angle ge 90) then
    return 'Top'
  -- Looking at the bottom
  else
    return 'Bottom'
  endif

endmethod
-- End of method definition for .surface(DBREF, DIRECTION) STRING

-----------------------------------------------------------------------
--
-- Method:      surfacePicked
--
-- Description: Return the surface picked using the current pick settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      DIRECTION   "look" direction towards panel
-- Return:
--   [Data Type] [Description]
--    STRING      Current setting
--
------------------------------------------------------------------------

define method .surfacePicked(!dbRef is DBREF, !direction is DIRECTION) is STRING

  -- Initialise Variables
  !panelDirection = !dbRef.orientation.zDir()

  -- Visible/Invisible surface
  if(!this.visible or !this.invisible) then
    -- Visible side
    if(!this.visible) then
      !angle = !panelDirection.angle(!direction)
    else
      !angle = !panelDirection.angle(!direction.opposite())
    endif

    -- If angle ge 90, then we are "looking" at the top
    if(!angle ge 90) then
      return 'Top'
    -- Looking at the bottom
    else
      return 'Bottom'
    endif

  -- Middle of panel
  elseif (!this.middle) then

    return 'Middle'

  -- Origin of panel
  else

    return 'Origin'

  endif

endmethod
-- End of method definition for .surfacePicked(DBREF, DIRECTION) STRING

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return the plane of the panel, using surface settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
-- Return:
--   [Data Type] [Description]
--    PLANE       plane of the panel
--
------------------------------------------------------------------------

define method .plane(!dbRef is DBREF) is PLANE

  -- Initialise Variables
  !return             = object PLANE()
  !return.position    = !dbRef.position
  !return.orientation = !dbRef.orientation

  -- If we are looking for the justification plane then just return
  if(!this.justification) then
    return !return
  endif

  -- Top Plane
  if(!this.top) then
    return !this.plane( !dbRef, 'TOP' )

  -- Bottom Plane
  elseif (!this.bottom) then
    return !this.plane( !dbRef, 'BOTTOM' )

  -- Centre Plane
  elseif (!this.centre) then
    return !this.plane( !dbRef, 'MIDDLE' )

  endif

  return !return

endmethod
-- End of method definition for .plane(DBREF) PLANE

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return the plane of the panel using the passed surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      DBREF       Surface plane is onto
-- Return:
--   [Data Type] [Description]
--    PLANE       plane of the panel surface
--
------------------------------------------------------------------------

define method .plane(!dbRef is DBREF, !surface is STRING) is PLANE

  -- Initialise Variables
  !return             = object PLANE()
  !return.position    = !dbRef.position
  !return.orientation = !dbRef.orientation

  -- Get Ploop
  !loop          = !this.loop(!dbRef)

  -- Top Plane
  if(!surface.upcase() eq 'TOP') then

    -- drop through because pos should be on the 'top' face

  -- Bottom Plane
  elseif (!surface.upcase() eq 'BOTTOM') then

    -- offset the plane in the opposite direction to zdir by the thickness
    !thickness = !loop.loHeight
    handle any
      !thickness = 0
    endhandle
    !pv        = !return.pointVector()
    !pvOffset  = !pv.offset( -1 * !thickness )
    !return.position = !pvOffset.position

  -- Centre Plane
  elseif (!surface.upcase() inset('MIDDLE','CENTRE')) then

    -- offset the plane in the opposite direction to zdir by the thickness
    !thickness = !loop.loHeight
    handle any
      !thickness = 0
    endhandle
    !pv        = !return.pointVector()
    !pvOffset  = !pv.offset( -1 * !thickness / 2 )
    !return.position = !pvOffset.position

  else

    -- default plane
    return !return

  endif

  -- Move plane through new position
  return !return

endmethod
-- End of method definition for .plane(DBREF, STRING) PLANE

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of arcs
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()
  !profile     = !this.profile(!dbRef)
  !edges       = !profile.edges()

  -- Get all vertices with frad > 0 and use these
  do !i indices !edges.members
    skip if( !edges[!i].objectType() neq 'ARC' )
    !returnArray.append(!edges[!i])
  enddo

  return !returnArray

endmethod
-- End of method definition for .arc(DBREF) ARRAY

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      POSITION    Reference point
-- Return:
--   [Data Type] [Description]
--    ARC         Arc definition
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !position is POSITION) is ARC

  -- Initialise Variables
  !arcs     = ARRAY()
  !distance = ARRAY()
  !arc      = object ARC()

  -- Get edges of all profiles for this element
  !profiles = !this.allProfiles(!dbRef)

  do !profile values !profiles

    !edges  = !profile.edges()

    -- Get all LINE edges
    do !i indices !edges
      skip if( !edges[!i].objectType() neq 'ARC' )
      !arcs.append(!edges[!i])
    enddo

  enddo

  -- handle case where there are no arcs
  if(!arcs.size() eq 0) then
    -- Get edges of outer loop
    return !arc
  endif

  -- find nearest arc
  -- Loop through edges, to find closest edge
  do !i indices !arcs
    skip if(!arcs[!i].onProjected(!position).not())
    !gap = !arcs[!i].anglePosition(!arcs[!i].near(!position)).distance(!position)
    if( defined(!distance[1]) ) then
      if( !gap lt !distance[1] ) then
        -- closer than previous recorded arc
        !arc         = !arcs[!i]
        !distance[1] = !gap
      endif
    else
      -- first recorded arc
      !arc           = !arcs[!i]
      !distance[1]   = !gap
    endif
    break if( !gap lt 0.0001mm )
  enddo


  return !arc


endmethod
-- End of method definition for .arc(DBREF, POSITION) ARC

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      POSITION    Reference point
-- Return:
--   [Data Type] [Description]
--    ARC         Arc definition
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !pointVector is POINTVECTOR) is ARC

  -- Initialise Variables
  !profile     = !this.profile(!dbRef)
  !position    = !profile.intersection(!pointVector)
  !edgeNumbers = !profile.nearEdges(!position)
  !edge        = !profile.edge(!edgeNumbers[1])
  if(!edge.objectType() eq 'ARC') then
    return !edge
  else
    return object ARC()
  endif


endmethod
-- End of method definition for .arc(DBREF, POINTVECTOR) ARC

------------------------------------------------------------------------
--
-- Method:      edgeLines
--
-- Description: Return edges as an array of line definitions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of lines
--
------------------------------------------------------------------------

define method .edgeLines(!dbRef is DBREF) is ARRAY

  -- Initialise Variables
  !lines   = ARRAY()

  -- Get edges of all profiles for this element
  !profiles = !this.allProfiles(!dbRef)

  do !profile values !profiles

    !edges   = !profile.edges()

    -- Get all LINE edges
    do !i indices !edges
      skip if( !edges[!i].objectType() neq 'LINE' )
      !lines.append(!edges[!i])
    enddo

  enddo

  -- handle case where there are no straight lines
  if(!lines.size() eq 0) then
    -- Get edges of outer loop
    !profile = !this.profileNoArcs(!dbRef)
    !lines   = !profile.edges()
  endif

  return !lines

endmethod
-- End of method definition for .edgeLines(DBREF) ARRAY

------------------------------------------------------------------------
--
-- Method:      edgeLines
--
-- Description: Return edges as an array of line definitions mapped onto a specific surface of the panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      STRING      Surface edges are to be mapped onto
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of lines
--
------------------------------------------------------------------------

define method .edgeLines(!dbRef is DBREF, !surface is STRING) is ARRAY

  -- Initialise Variables
  !lines = !this.edgeLines(!dbRef)

  -- Define Plane
  !plane = !this.plane(!dbRef, !surface)

  -- Loop through lines and project onto plane
  do !i indices !lines
    !lines[!i] = !lines[!i].projected(!plane)
  enddo

  return !lines

endmethod
-- End of method definition for .edgeLines(DBREF, STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      nearestEdge
--
-- Description: Returns nearest edge to passed position when mapped onto the passed surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    LINE        Edge as a line
--
------------------------------------------------------------------------

define method .nearestEdge(!dbRef is DBREF, !pointVector is POINTVECTOR) is LINE

  -- Get Surface of plane to work with
  !surface     = !this.surfacePicked(!dbRef, !pointVector.direction)

  -- Get Plane
  !plane       = !this.plane(!dbRef, !surface)

  -- Intersection of lines
  !iPosition   = !pointVector.intersection(!plane)

  return !this.nearestEdge(!dbRef, !iPosition, !surface)

endmethod
-- End of method definition for .nearestEdge(DBREF, POINTVECTOR) LINE

------------------------------------------------------------------------
--
-- Method:      nearestEdge
--
-- Description: Returns nearest edge to passed position when mapped onto the passed surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      POSITION    Position
--    2   R      STRING      Surface edges are to be mapped onto
-- Return:
--   [Data Type] [Description]
--    LINE        Edge as a line
--
------------------------------------------------------------------------

define method .nearestEdge(!dbRef is DBREF, !position is POSITION, !surface is STRING) is LINE

  -- Initialise Variables
  !line     = object LINE()
  !distance = ARRAY()

  -- Get all Lines
  !lines = !this.edgeLines(!dbRef, !surface)

  -- Loop through edges, only use ones where the position lies on the line
  do !i indices !lines
    skip if(!lines[!i].onProjected(!position).not())
    !gap = !lines[!i].distance(!position)
    if( defined(!distance[1]) ) then
      if( !gap lt !distance[1] ) then
        -- closer than previous recorded line
        !line        = !lines[!i]
        !distance[1] = !gap
      endif
    else
      -- first recorded line
      !line          = !lines[!i]
      !distance[1]   = !gap
    endif
    break if( !gap lt 0.0001mm )
  enddo

  return !line

endmethod
-- End of method definition for .nearestEdge(DBREF, POSITION, STRING) LINE

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      POINTVECTOR Point vector to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (not required)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Convert point vector into a line and use snap line method
  return !this.snap(!dbRef, !pointVector.line(1000mm), !intermediates)

endmethod
-- End of method definition for .snap(DBREF, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      LINE        Line to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (not required)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Get Surface of plane to workwith
  !surface   = !this.surfacePicked(!dbRef, !refLine.direction())

  -- Get Plane
  !plane     = !this.plane(!dbRef, !surface)

  -- Intersection of lines
  !iPosition = !plane.intersection(!refLine)

  -- Snap to edges
  if(!this.edges) then

    -- Get nearest edge to pick
    !line      = !this.nearestEdge(!dbRef, !iPosition, !surface)

    -- Find nearest end
    !distStart = !line.startPosition.distance(!iPosition)
    !distEnd   = !line.endPosition.distance(!iPosition)
    if( !distEnd lt !distStart ) then
      !newPosition = !distEnd
    else
      !newPosition = !distStart
    endif

    return !newPosition.wrt(World)

  else
  -- Snap to nearest vertex or arc end point

    -- If no snap components are set, then use panel origin
    if(!this.vertex.not()) then
      return !plane.near(!dbRef.position).wrt(World)
    endif

    -- Get snap points
    !profiles    = !this.allProfiles(!dbRef)
    !snapPoints = ARRAY()
    do !profile values !profiles
      !snapPoints.appendArray(!this.snapPoints(!profile))
    enddo

    -- If there are no element in the snap points array, use origin
    if(!snapPoints.size() eq 0) then
      return !plane.near(!dbRef.position).wrt(World)
    endif

    -- find nearest point
    !distance     = !iPosition.distance(!snapPoints[1])
    !snapPosition = !snapPoints[1]
    do !snapPoint values !snapPoints
      !gap = !iPosition.distance(!snapPoint)
      skip if( !gap geq !distance )
      -- found new nearest point
      !snapPosition = !snapPoint
      !distance     = !gap
      break if( !gap lt 0.001mm )
    enddo

    -- return nearest point
     return !plane.near(!snapPosition).wrt(World)

  endif

endmethod
-- End of method definition for .snap(DBREF, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position at specified distance from the start/end of the nearest edge line to the passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      REAL        Distance
--    3   R      POINTVECTOR Point vector to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (not required)
-- Return:
--   [Data Type] [Description]
--    POSITION    position on edge
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Convert point vector into a line and use snap line method
  return !this.distance(!dbRef, !distance, !pointVector.line(1000mm), !intermediates)

endmethod
-- End of method definition for .distance(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position at specified distance from the start/end of the nearest edge line to the passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel DBREF
--    2   R      REAL        Distance
--    3   R      LINE        Line
--    4   R      BOOLEAN     Intermediate snaps (not required)
-- Return:
--   [Data Type] [Description]
--    POSITION    position on edge
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Get Surface of plane to workwith
  !surface      = !this.surfacePicked(!dbRef, !refLine.direction())

  -- Get Plane
  !plane       = !this.plane(!dbRef, !surface)

  -- Intersection of lines
  !iPosition   = !plane.intersection(!refLine)

  -- Get nearest edge to pick
  !gmfLine     = object GMFLINE(!this.nearestEdge(!dbRef, !iPosition, !surface))
  return !gmfLine.distance(!distance, !iPosition)

endmethod
-- End of method definition for .distance(DBREF, REAL, LINE, BOOLEAN) POSITION

