--
--
-- Description:
-- EDG Packet, contains all the information about an application EDG
-- pick requirements.
--
--  Packet Priority, this controls how the packets are allowed into the
--  EDG system, the lower the number the higher their priority. The system
--  will only allow packets into the system where they have a lower
--  priority than any that are currently on the system
--
--  General rule for priority numbers are:
--
--     0     - Major applications using EDG, e.g. create section
--     1     - Main utilities, e.g. measure, graphic "explicit" forms
--     2     - Graphic aid constructors, e.g. direct gadget measure
--     3     - Low level graphic events, e.g. window, copy view
--    10     - Lowest of the low (only should be for the navigate packet)
--
--   Any priority with a negative number have been placed onto the system
--   via the old EDG wrapper, these should not allow any other EDG event
--   to be place onto the system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidPick(STRING)                  -                   Standard aid element pick packet
--  anyPick(STRING)                  -                   Standard any pick packet
--  closeAction()                    -                   Carry out close action
--  defineAid(STRING)                -                   Define picking for Aid elements
--  defineCircle(STRING)             -                   Define circle
--  defineDirection(STRING)          -                   Define a direction packet
--  defineLine(STRING)               -                   Define a line
--  defineMeasure(STRING)            -                   Define a measurement packet
--  definePlane(STRING)              -                   Define a plane
--  definePoint(STRING)              -                   Define working point in 3D space
--  definePosition(STRING)           -                   Define basic positioning packet
--  defineWrapper(STRING,STRING,STRING) -                   Standard navigate packet
--  defineWrapper(STRING,STRING,STRING,DBREF) -                   Standard navigate packet
--  edgPacket()                      -                   Constructor
--  elementPick(STRING)              -                   Standard element pick packet
--  initialise()                     -                   Initialise Packet
--  isIn2Dmode()                     -                   Check we are in 2D mode
--  moveToDbRef()                    -                   Standard navigate packet
--  moveToDbTube()                   -                   navigate packet that includes TUBI elements
--  moveToSigDbRef(STRING)           -                   Significant element navigate packet
--  navigate()                       -                   Standard navigate packet
--  orientationLink(STRING,STRING)   -                   Orientation about a position (through two points X & Y)
--  pLinePick(STRING)                -                   Standard pline pick packet
--  positionLink(STRING,STRING)      -                   Copy pick view setting and apply to passed view
--  query()                          ARRAY               Displays current settings
--  runAction()                      -                   Carry out packet action
--  setupWithView(GADGET)            -                   Initialise return data block with passed view
--  showForm()                       FORM                Show the associated form
--
------------------------------------------------------------------------

-- Define object
define object EDGPACKET

  -- Application identifier/key
  member .key            is STRING

  -- Application Description
  member .description    is STRING

  -- Packet type
  member .type           is STRING

  -- Application Priority (1 - super application (highest) 2 > lower)
  member .priority       is REAL

  -- Initialisation for Packet (action carried pack invoked)
  member .initialisation is STRING

  -- Action on closing down packet
  member .close          is STRING

  -- Action after event packet has been removed from system
  member .continue       is STRING

  -- Action on <esc> from graphics canvas
  member .escape         is STRING

  -- Application Function (action carried out after each complete
  -- edgPickPacket)
  member .action         is STRING

  -- Application Control form
  member .form           is FORM

  -- Pick Packet (pre defined pick packet)
  member .pickPacket     is EDGPICKPACKET

  -- Remove from control on completion
  member .remove         is BOOLEAN

  -- Any required input data
  member .input          is ARRAY

  -- Return Data
  member .return         is ARRAY

  -- Aid Number for tagging
  member .aidNumber      is REAL

endobject
-- End of object definition for EDGPACKET

------------------------------------------------------------------------
--
-- Method:      edgPacket
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgPacket()

  !this.key              = 'edgPacket'
  !this.description      = 'default packet'
--  !this.type
  !this.priority         = 0
--  !this.initialisation
--  !this.action
--  !this.form
--  !this.pickPacket
  !this.remove           = true
--  !this.input
--  !this.return
--  !this.aidNumber

endmethod
-- End of method definition for .edgPacket()

------------------------------------------------------------------------
--
-- Method:      query
--
-- Description: Displays current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Formatted description of
--
------------------------------------------------------------------------

define method .query() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()
  !return.append('    Description : ' & !this.description)
  !return.append('            Key : ' & !this.key)
  !return.append('           Type : ' & !this.type)
  !return.append('       Priority : ' & !this.priority)
  if(!this.initialisation.set() and !this.initialisation.empty().not()) then
    !return.append(' Initialisation : ' & !this.initialisation)
  else
    !return.append(' Initialisation : None')
  endif
  if(!this.action.set() and !this.action.empty().not()) then
    !return.append('         Action : ' & !this.action)
  else
    !return.append('         Action : None')
  endif
  if(!this.form.set()) then
    !return.append('           Form : ' & !this.form)
  else
    !return.append('           Form : None')
  endif
  !return.append('         Remove : ' & !this.remove.string().lowcase())
  if(!this.input.set() and !this.input.empty().not()) then
      !return.append('     Input Data :')
    do !i indices !this.input
      !return.append('           [' & !i & ']' & !this.input[!i])
    enddo
  else
    !return.append('     Input Data : None')
  endif
  !return.append('')
  !return.append('     Pick Packet')
  !return.append('        Description : ' & !this.pickPacket.description)

  return !return

endmethod
-- End of method definition for .query() ARRAY

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description: Carry out packet action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .runAction()

  -- Type and action anything in the member .action
  if(!this.action.set() and !this.action.empty().not()) then
    !command = !this.action
    $!<command>
    return
  endif

endmethod
-- End of method definition for .runAction()

------------------------------------------------------------------------
--
-- Method:      closeAction
--
-- Description: Carry out close action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closeAction()

  -- Type and action anything in the member .action
  if(!this.close.set() and !this.close.empty().not()) then
    !command = !this.close
    $!<command>
    handle any
      -->>>>>>>>>>> into message system
      !error = 'Packet Close action (' & !command & ') failed.'
      return error 1 '$!error'
    endhandle
  endif

endmethod
-- End of method definition for .closeAction()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise Packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Only run initialise, if there is on
  if(!this.initialisation.set() and !this.initialisation.empty().not()) then
    !command = !this.initialisation
    $!command
    handle any
      !!alert.error('Initialisation of packet failed, action (' & !command & ').')
    endhandle
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setupWithView
--
-- Description: Initialise return data block with passed view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupWithView(!passedView is GADGET)

  -- Initialise return data for state
  !this.return.clear()
  !this.return.append(!passedView)

endmethod
-- End of method definition for .setupWithView(GADGET)

------------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description: Show the associated form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    FORM        Form shown
--
------------------------------------------------------------------------

define method .showForm() is FORM

  -- Initialise Variables
  if(!this.form.unset()) then
    return !this.form
  endif

  -- show form
  if(!this.form.shown().not()) then
    !this.form.show('AT',0.9,0.12)
  endif

  return !this.form

endmethod
-- End of method definition for .showForm() FORM

------------------------------------------------------------------------
--
-- Method:      isIn2Dmode
--
-- Description: Check we are in 2D mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isIn2Dmode()

  -- Initialise Variables
  if(!!edgPosCntrl.activePlane().not()) then
    !!alert.error('There is no active working plane.')
    return error 1 noalert
  endif

endmethod
-- End of method definition for .isIn2Dmode()

------------------------------------------------------------------------
--
-- Method:      moveToDbRef
--
-- Description: Standard navigate packet
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .moveToDbRef()

  -- Move to picked element
  !!ce = !this.return[1].item

  -- Empty the return array
  !this.return.clear()

endmethod
-- End of method definition for .moveToDbRef()

------------------------------------------------------------------------
--
-- Method:      moveToDbTube
--
-- Description: navigate packet that includes TUBI elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .moveToDbTube()


  -- Move to picked element
  if (!this.return[1].type eq 'TUBING') then
    !!ce = ILEAV TUBE of $!<this.return[1].item>
  else
    !!ce = !this.return[1].item
    handle ANY
    endhandle
  endif

  -- Empty the return array
  !this.return.clear()

endmethod
-- End of method definition for .moveToDbTube()

------------------------------------------------------------------------
--
-- Method:      .moveToSigDbRef(STRING)
--
-- Description: Significant element navigate packet
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .moveToSigDbRef(!elementTypes is STRING)

  -- Move to picked element
  !!ce = !this.return[1].item

  -- navigate to significant element
  !sigTypes = !elementTypes.split()
  do !type values !sigTypes
    $!type
    handle any
      skip
    elsehandle none
      break
    endhandle
  enddo

  -- Empty the return array
  !this.return.clear()

endmethod
-- End of method definition for .moveToSigDbRef(STRING)

--------------------------- PACKET DEFINITIONS -------------------------

------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Standard navigate packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigate()

  -- Set Data
  !this.key         = 'stdNavigate'
  !this.description = 'Standard Navigate'
  !this.type        = 'navi'
  !this.priority    = 10

  !this.action      = '$$!!edgCntrl.navigateAction'

  !this.pickPacket.stdElement('Navigate')
  !this.remove      = false

endmethod
-- End of method definition for .navigate()

