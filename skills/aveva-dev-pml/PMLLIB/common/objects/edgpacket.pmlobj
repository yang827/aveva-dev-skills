------------------------------------------------------------------------
--
-- Method:      positionLink
--
-- Description: Copy pick view setting and apply to passed view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Position gadget group POSLINK object pointer
--    2   R      STRING      Primary prompt of position link
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionLink(!posLinkGvar is STRING, !text is STRING)

  -- Set Data
  !this.key            = 'positionLink'
  !this.description    = 'Position pick to POSLINK object'
  !this.type           = 'pos'
  !this.priority       = 0
  !this.action         = !posLinkGvar & '.position(!this.return[1].position)'
  !this.pickPacket.stdPosition(!text)
  !this.remove         = false

endmethod
-- End of method definition for .positionLink(STRING, STRING)

