------------------------------------------------------------------------
--
-- Method:      defineCircle
--
-- Description: Define circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method of construction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineCircle(!constructMethod is STRING)

  -- Set Data
  !this.key         = 'defineCircle'
  !this.type        = 'construct'
  !this.priority    = 0
  !this.remove      = true

  -- Circle through 3 Positions
  if(!constructMethod.upcase() eq '3PNT') then

    !this.description = 'Circle through 3 Points'
    !this.pickPacket.circle3Pnts()

  -- Circle through 2 Positions (diameter defined) 3D
  elseif (!constructMethod.upcase() eq 'DIAMETER3D') then
    !this.description = 'Circle derived diameter'
    !this.pickPacket.circleDia3D()

  -- Circle define centre and radius + control point 3D
  elseif (!constructMethod.upcase() eq 'RADIUS3D') then
    !this.description = 'Circle centred, derived radius'
    !this.pickPacket.circleRad3D()

  -- Circle centred of defined radius 3D
  elseif (!constructMethod.upcase() eq 'FIXEDRADIUS3D') then
    if(undefined(!!edgRadius)) then
      pml reload form !!edgRadius
    endif
    !this.description = 'Circle Centre, defined radius'
    !this.form        = !!edgRadius
    !this.pickPacket.circleFixRad3d('!!edgRadius.radius.val')

  -- Circle centred of defined diameter 3D
  elseif (!constructMethod.upcase() eq 'FIXEDDIAMETER3D') then
    if(undefined(!!edgDiameter)) then
      pml reload form !!edgDiameter
    endif
    !this.description = 'Circle Centre, defined diameter'
    !this.form        = !!edgDiameter
    !this.pickPacket.circleFixDia3d('!!edgDiameter.diameter.val')

  -- Circle through 2 Positions (diameter defined) 2D
  elseif (!constructMethod.upcase() eq 'DIAMETER2D') then
    !this.isIn2Dmode()
    !this.description = 'Circle derived diameter'
    !this.pickPacket.circleDia2d('!!edgPosCntrl.workPlane')

  -- Circle define centre and radius + control point 2D
  elseif (!constructMethod.upcase() eq 'RADIUS2D') then
    !this.isIn2Dmode()
    !this.description = 'Circle centred, derived radius'
    !this.pickPacket.circleRad2d('!!edgPosCntrl.workPlane')

  -- Circle centred of defined radius 2D
  elseif (!constructMethod.upcase() eq 'FIXEDRADIUS2D') then
    if(undefined(!!edgRadius)) then
      pml reload form !!edgRadius
    endif
    !this.isIn2Dmode()
    !this.description = 'Circle Centre, defined radius'
    !this.form        = !!edgRadius
    !this.pickPacket.circleFixRad2d('!!edgPosCntrl.workPlane','!!edgRadius.radius.val')

  -- Circle centred of defined diameter 2D
  elseif (!constructMethod.upcase() eq 'FIXEDDIAMETER2D') then
    if(undefined(!!edgDiameter)) then
      pml reload form !!edgDiameter
    endif
    !this.isIn2Dmode()
    !this.description = 'Circle Centre, defined diameter'
    !this.form        = !!edgDiameter
    !this.pickPacket.circleFixDia2d('!!edgPosCntrl.workPlane','!!edgDiameter.diameter.val')

  -- Fillet circle of defined radius
  elseif (!constructMethod.upcase() eq 'FILLET') then
    if(undefined(!!edgRadius)) then
      pml reload form !!edgRadius
    endif
    !this.description = 'Fillet Circle of defined radius'
    !this.form        = !!edgRadius
    !this.pickPacket.circleFillet('!!edgRadius.radius.val')

  -- Circle tangential to two other circles
  elseif (!constructMethod.upcase() eq 'TANTAN') then
    if(undefined(!!edgRadius)) then
      pml reload form !!edgRadius
    endif
    !this.description = 'Circle tangential to two other circles'
    !this.form        = !!edgRadius
    !this.pickPacket.circleTanTan('!!edgRadius.radius.val')

  -- Circle from point to tangent of another circle
  elseif (!constructMethod.upcase() eq 'PNTTAN') then
    !this.description = 'Circle centred and tangential to another circles'
    !this.pickPacket.circlePntTan()

  -- Circle from point to tangent of another circle
  elseif (!constructMethod.upcase() eq 'FIXEDRADIUSPNTTAN') then
    if(undefined(!!edgRadius)) then
      pml reload form !!edgRadius
    endif
    !this.description = 'Circle centred and tangential to another circles, fixed radius'
    !this.form        = !!edgRadius
    !this.pickPacket.circleFRadPntTan('!!edgRadius.radius.val')

  -- Circle through 2 points + polar control point
  elseif (!constructMethod.upcase() eq 'FIXEDRADIUSPNTPNT') then
    if(undefined(!!edgRadius)) then
      pml reload form !!edgRadius
    endif
    !this.description = 'Circle through 2 points + polar control point'
    !this.form        = !!edgRadius
    !this.pickPacket.circleFRadPntPnt('!!edgRadius.radius.val')

  -- Circle copy
  elseif (!constructMethod.upcase() eq 'DERIVE') then
    !this.description = 'Derive a circle'
    !this.pickPacket.circleDerive()

  -- Circle copy
  elseif (!constructMethod.upcase() eq 'TAN3LINES') then
    !this.description = 'Circle tangential to 3 lines'
    !this.pickPacket.circleTan3Lines()

  else
    return error 1 noalert
  endif

endmethod
-- End of method definition for .defineCircle(STRING)

------------------------------------------------------------------------
--
-- Method:      definePoint
--
-- Description: Define working point in 3D space
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method of construction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePoint(!constructMethod is STRING)

  -- Set Data
  !this.key         = 'definePoint'
  !this.type        = 'construct'
  !this.priority    = 0
  !this.remove      = true

  -- Working point at position
  if(!constructMethod.upcase() eq 'PNT') then
    !this.description = 'Define Working Point'
    !this.pickPacket.pointPnt()
  else
    return error 1 noalert
  endif

endmethod
-- End of method definition for .definePoint(STRING)

------------------------------------------------------------------------
--
-- Method:      defineLine
--
-- Description: Define a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method of construction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineLine(!constructMethod is STRING)

  -- Set Data
  !this.key         = 'defineLine'
  !this.type        = 'construct'
  !this.priority    = 0
  !this.remove      = true

  -- Line between to points
  if(!constructMethod.upcase() eq 'PNTPNT') then
    !this.description = 'Line between two points'
    !this.pickPacket.linePntPnt()

  -- Line offset by an angle from the picked line, towards the second pick
  elseif (!constructMethod.upcase() eq 'ANGLE') then
    if(undefined(!!edgAngle)) then
      pml reload form !!edgAngle
    endif
    !this.description = 'Line offset by angle from another'
    !this.form        = !!edgAngle
    !this.pickPacket.lineAngle('!!edgAngle.angle')

  -- Copy an existing linear item
  elseif (!constructMethod.upcase() eq 'DERIVE') then
    !this.description = 'Derive a line'
    !this.pickPacket.lineDerive()

  -- Line between point an tangent of arc
  elseif (!constructMethod.upcase() eq 'PNTTAN') then
    !this.description = 'Line between point and tangent of arc'
    !this.pickPacket.linePntTan()

  -- Line between tangent points of two arcs
  elseif (!constructMethod.upcase() eq 'TANTAN') then
    !this.description = 'Line between tangents of two arcs'
    !this.pickPacket.lineTanTan()

  -- Bisect lines (smallest angle)
  elseif (!constructMethod.upcase() eq 'BISECT') then
    !this.description = 'Line between to other'
    !this.pickPacket.lineBisect()

  -- Line at intersections of two planes
  elseif (!constructMethod.upcase() eq 'TWOPLANES') then
    !this.description = 'Line at intersection of two planes'
    !this.pickPacket.lineTwoPlanes()

  -- Line Shortest between two picks
  elseif (!constructMethod.upcase() eq 'SHORTEST') then
    !this.description = 'Line shortest between'
    !this.pickPacket.lineShortest()

  else
    return error 1 noalert
  endif

endmethod
-- End of method definition for .defineLine(STRING)

------------------------------------------------------------------------
--
-- Method:      definePlane
--
-- Description: Define a plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method of construction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePlane(!constructMethod is STRING)

  -- Set Data
  !this.key         = 'definePlane'
  !this.type        = 'construct'
  !this.priority    = 0
  !this.remove      = true

  -- Through 3 Positions
  if(!constructMethod.upcase() eq '3PNTS') then
    !this.description = 'Plane Through 3 Positions'
    !this.pickPacket.plane3Pnts()

  -- Copy an other plane
  elseif (!constructMethod.upcase() eq 'COPY') then
    !this.description = 'Copy a plane'
    !this.pickPacket.planeCopy()

  else
    return error 1 noalert
  endif


endmethod
-- End of method definition for .definePlane(STRING)

------------------------------------------------------------------------
--
-- Method:      defineAid
--
-- Description: Define picking for Aid elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Prompt String
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineAid(!text is STRING)

  -- Set Data
  !this.key         = 'defineAid'
  !this.type        = 'construct'
  !this.priority    = 0
  !this.remove      = true
  !this.description = 'Design Aid Pick'
  !this.pickPacket.stdAid(!text)


endmethod
-- End of method definition for .defineAid(STRING)

------------------------------------------------------------------------
--
-- Method:      defineMeasure
--
-- Description: Define a measurement packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Measurement Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineMeasure(!type is STRING)

  -- Set Data
  !this.key         = 'defineMeasure'
  !this.type        = 'measure'
  !this.priority    = 3
  !this.remove      = true

  -- Standard linear distance measure
  if(!type.upcase() eq 'DISTANCE') then
    !this.description = 'Measure Distance'
    !this.pickPacket.measureDistance()

  -- Standard angle measure
  elseif (!type.upcase() eq 'SHORTEST') then
    !this.description = 'Measure Distance'
    !this.pickPacket.lineShortest()

  -- Standard angle measure (returns arc)
  elseif (!type.upcase() eq 'ANGLE') then
    !this.description = 'Measure Angle'
    !this.pickPacket.measureAngle()

  -- Standard angle measure (returns real)
  elseif (!type.upcase() eq 'LINEANGLE') then
    !this.description = 'Measure Angle'
    !this.pickPacket.measureLineAngle()

  -- Standard perpendicular to line/plane measure (returns arc)
  elseif (!type.upcase() eq 'PERPENDICULARTO') then
    !this.description = 'Measure Perpendicular'
    !this.pickPacket.measurePerpendicularToPoint()

  endif

endmethod
-- End of method definition for .defineMeasure(STRING)

------------------------------------------------------------------------
--
-- Method:      defineDirection
--
-- Description: Define a direction packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      direction Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineDirection(!type is STRING)

  -- Set Data
  !this.key         = 'defineDirection'
  !this.type        = 'direction'
  !this.priority    = 2
  !this.remove      = true

  -- Standard linear distance measure
  !this.description = 'Derive Direction'
  !this.pickPacket.direction('pick')

endmethod
-- End of method definition for .defineDirection(STRING)

------------------------------------------------------------------------
--
-- Method:      defineWrapper
--
-- Description: Standard navigate packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Pick Packet Types
--    2   R      STRING      Action to be executed
--    3   R      STRING      Primary Prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineWrapper(!type is STRING, !action is STRING, !pPrompt is STRING)

  -- Set Data
  !this.key         = 'defineWrapper'
  !this.description = 'Wrapper'
  !this.type        = ''
  !this.priority    = 1
  !this.action      = '!!edgWrapper(''' & !action & ''',!this.return)'
  !this.remove      = false

  -- Position Pick Packet
  if(!type.upcase() eq 'POSITION') then
    !this.pickPacket.stdPosition(!pPrompt)

  -- Pick Any Element
  elseif (!type.upcase() eq 'ELEMENT') then
    !this.pickPacket.stdElement(!pPrompt)

  -- Pick Panel Element
  elseif (!type.upcase() eq 'PANEL') then
    !this.pickPacket.stdElement(!pPrompt)
    !this.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE eq ''PANE'''
    !this.pickPacket.picks[1].pick.modifiable = false

  -- Pick Panel Vertex only
  elseif (!type.upcase() eq 'PANELVERTEX') then
    !this.pickPacket.stdPpoint(!pPrompt)
    !this.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE eq ''PANE'''
    !this.pickPacket.picks[1].pick.modifiable = false

  -- Pick Section Element
  elseif (!type.upcase() eq 'SECTION') then
    !this.pickPacket.stdElement(!pPrompt)
    !this.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE eq ''SCTN'''
    !this.pickPacket.picks[1].pick.modifiable = false


  endif

endmethod
-- End of method definition for .defineWrapper(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      defineWrapper
--
-- Description: Standard navigate packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Pick Packet Types
--    2   R      STRING      Action to be executed
--    3   R      STRING      Primary Prompt
--    4   R      DBREF       Filter item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineWrapper(!type is STRING, !action is STRING, !pPrompt is STRING, !item is DBREF)

  -- Set Data
  !this.key         = 'defineWrapper'
  !this.description = 'Wrapper'
  !this.type        = ''
  !this.priority    = 1
  !this.action      = '!!edgWrapper(''' & !action & ''',!this.return)'
  !this.remove      = false

  -- Pick Panel vertex (on passed item)
  if(!type.upcase() eq 'PANELVERTEX') then

    !this.pickPacket.stdPpoint(!pPrompt)
    !this.pickPacket.picks[1].pick.input[3]   = 'REFNO eq ' & !item.string() & ''
    !this.pickPacket.picks[1].pick.modifiable = false

  endif

endmethod
-- End of method definition for .defineWrapper(STRING, STRING, STRING, DBREF)
