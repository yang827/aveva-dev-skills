-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stdAid()

  -- Set data for pick
  !this.key         = 'stdAid'
  !this.description = 'Aid'
  !this.inMode      = 'pany'
  !this.cursor      = 'pointer'
  !this.modifiable  = false

  -- Special qualifiers
  !this.input[1] = 'PKEY eq ''rubbish'''
  !this.input[2] = 'PNUM eq -99'
  !this.input[3] = 'TYPE eq ''rubbish'''
  !this.input[5] = 'TYPE eq ''rubbish'''

endmethod
-- End of method definition for .stdAid()

