-- File:            edgpick.pmlobj
--   Type:          Object Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Jan 16 15:21:51 WAT 1998
--
--
-- Description:
--   Basic pick types.
--
--   Rules:
--      1. edgPick with modifiable set to true will use the current
--         qualifier settings held by the qualifier system.
--
--   Qualifiers for inmodes "input" array
--
--      [1]  - Pline
--      [2]  - Ppoint
--      [3]  - Element
--      [4]  - Design Aids
--      [5]  - Tubing
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyFilters()                   -                   Apply filters to system
--  applyPrompt(STRING)              -                   Apply prompt to views
--  applyToView(GADGET,STRING)       -                   Apply the pick to the passed view.
--  applyToViews(STRING)             -                   Apply the pick to the current active view. All active "design"
--  circleEvaluate()                 EDGPOSITIONDATA     Evaluate circle from pick data
--  dbCircle()                       -                   Standard pick interpreter for Circle element
--  dbLine()                         -                   Standard pick interpreter for linear element
--  dbPlane()                        -                   Standard pick interpreter for Plane element
--  lineEvaluate()                   EDGPOSITIONDATA     Evaluate line from pick data
--  planeEvaluate()                  EDGPOSITIONDATA     Evaluate plane from pick data
--  positionArc()                    EDGPOSITIONDATA     Positioning pick for arc elements,check that the item picked is
--  positionLinear()                 EDGPOSITIONDATA     Positioning pick for linear elements
--  positionPlane()                  EDGPOSITIONDATA     Positioning pick for plane elements
--  runAction()                      ANY                 Carry out pick action
--  stdAid()                         -                   Standard pick interpreter for Graphical Aids
--  stdAny()                         -                   Standard pick interpreter for Element, Ppoint or Pline
--  stdArc()                         -                   Standard pick interpreter for Arc elements
--  stdElement()                     -                   Standard pick interpreter for an element
--  stdExternal()                    -                   Standard pick interpreter for a ray in a laser model
--  stdGraphics()                    -                   Standard pick interpreter for any graphic element
--  stdLinear()                      -                   Standard pick interpreter for linear element
--  stdPlane()                       -                   Standard pick interpreter for plane element
--  stdPline()                       -                   Standard pick interpreter for a pline
--  stdPpoint()                      -                   Standard pick interpreter for a ppoint
--  stdScreen()                      -                   Standard pick interpreter for screen position
--
------------------------------------------------------------------------

-- Define object
define object EDGPICK

  -- Pick key
  member .key         is STRING

  -- Description
  member .description is STRING

  -- Prompt (secondary prompt)
  member .prompt      is STRING

  -- Inmode
  member .inMode      is STRING

  -- Action on complete pick
  member .action      is STRING

  -- Cursor Type
  member .cursor      is STRING

  -- Modifiable by external means (could be member on "inmode")
  member .modifiable  is BOOLEAN

  -- Qualifier and input data for pick
  member .input       is ARRAY

endobject
-- End of object definition for EDGPICK

------------------------------------------------------------------------
------------------------------------------------------------------------
--                                                                    --
--                >>>>>> Processing Methods <<<<<<                    --
--                                                                    --
------------------------------------------------------------------------
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description:
--   Carry out pick action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ANY         Result from action
--
------------------------------------------------------------------------

define method .runAction() is ANY

  -- Type and action anything in the member .action
  if(!this.action.set() and !this.action.empty().not()) then
    !command = !this.action
    !return  = $!<command>
    handle any
      !this.return.clear()
      return error 1 '$!!error.text' noalert
    endhandle
    return !return

  -- If there is no action to process data, pass return up to calling level
  else
     return !!edgCntrl.pickData
  endif

endmethod
-- End of method definition for .runAction() ANY

------------------------------------------------------------------------
--
-- Method:      applyToView
--
-- Description:
--   Apply the pick to the passed view.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View Gadget
--    1   R      STRING      Prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyToView(!view is GADGET, !prompt is STRING)

  -- Initialise Variables
  !input = !this.input

  -- Prompt String
  if(!prompt.unset()) then
    !promptString = ' : '
  else
    !promptString = !prompt & ' : '
  endif

  -- Set inmode data
  !view.attribute(!this.inMode).cursor  = !this.cursor
  handle (61,113)
    --$P DFN9103: attempt to access non-existent view gadget
    return
  endhandle
  !view.attribute(!this.inMode).prompt  = !promptString.trim('LMR')

  -- Apply the input qualifiers
  !view.attribute(!this.inMode).input   = !this.input

  -- Can we modify the inmode input qualifiers
  if(!this.modifiable) then
    !input[1]      = !!edgPlineFilter.inMode
    !input[2]      = !!edgPointFilter.inMode
    !input[3]      = !!edgElementFilter.inMode
  endif

  -- Setup view for passed edgPick
  !view.setInMode(!this.inMode)
  !view.inMode.input = !input

endmethod
-- End of method definition for .applyToView(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyToViews
--
-- Description:
--   Apply the pick to the current active view. All active "design"
--   views are held in !!edgCntrl.views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyToViews(!prompt is STRING)

  -- Loop through view (held in edgCntrl object !!edgCntrl)
  do !view values !!edgCntrl.views

    !this.applyToView(!view, !prompt)

  enddo

endmethod
-- End of method definition for .applyToViews(STRING)

------------------------------------------------------------------------
--
-- Method:      applyPrompt
--
-- Description:
--   Apply prompt to views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyPrompt(!prompt is STRING)

   -- Prompt String
  if(!prompt.unset()) then
    !promptString = ' : '
  else
    !promptString = !prompt & ' : '
  endif

  -- Loop through view (held in edgCntrl object !!edgCntrl)
  do !view values !!edgCntrl.views

    -- Set inmode data
    !view.attribute(!this.inMode).prompt  = !promptString.trim('LMR')

    -- Setup view for passed edgPick
    !view.setInMode(!this.inMode)

  enddo

endmethod
-- End of method definition for .applyPrompt(STRING)

------------------------------------------------------------------------
--
-- Method:      applyFilters
--
-- Description:
--   Apply filters to system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyFilters()

  -- Initialise Variables

  -- Can we modify the inmode input qualifiers
  if(!this.modifiable.not()) then
    return
  endif

  -- Declare the filters
  --      [1]  - Pline
  --      [2]  - Ppoint
  --      [3]  - Element
  !input = !this.input
  !input[1]      = !!edgPlineFilter.inMode
  !input[2]      = !!edgPointFilter.inMode
  !input[3]      = !!edgElementFilter.inMode

  -- Loop through view (held in edgCntrl object !!edgCntrl)
  do !view values !!edgCntrl.views
    !view.inMode.input = !input
  enddo

endmethod
-- End of method definition for .applyFilters()

------------------------------------------------------------------------
--
-- Method:      positionLinear
--
-- Description:
--   Positioning pick for linear elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--    EDGPOSITIONDATA  Processed pick return
--
------------------------------------------------------------------------

define method .positionLinear() is EDGPOSITIONDATA

  -- Positioning Data
  !positionData      = !this.lineEvaluate()

  -- Derive picked position on the line
  !positionData.position = !positionData.line.intersection(!positionData.pointVector)

  -- Position onto active working plane
  if(!!edgPosCntrl.activePlane) then

    -- Project line onto plane
    if(!positionData.line.set()) then
      !positionData.line = !positionData.line.projected(!!edgPosCntrl.workPlane)
    endif

  endif

  -- Return
  return !positionData

endmethod
-- End of method definition for .positionLinear() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      positionArc
--
-- Description:
--   Positioning pick for arc elements,check that the item picked is
--   and "arc" based item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--    EDGPOSITIONDATA  Processed pick return
--
------------------------------------------------------------------------

define method .positionArc() is EDGPOSITIONDATA

  -- Positioning Data
  !positionData      = !this.circleEvaluate()

  -- Determine the picked position on the arc
  !intersections = !positionData.arc.intersections(!positionData.pointVector)
  !intersection  = !positionData.arc.plane().intersection(!positionData.pointVector)

  -- If there is only one intersection with the are, use it
  if(!intersections.size() eq 1) then
    !positionData.position = !positionData.arc.anglePosition(!intersections[1])

  -- Which is the nearest arc angle to the position on the plane
  else
    !angleAPosition = !positionData.arc.anglePosition(!intersections[1])
    !angleBPosition = !positionData.arc.anglePosition(!intersections[2])
    if(!angleAPosition.distance(!intersection) le !angleBPosition.distance(!intersection)) then
      !positionData.position = !angleAPosition
    else
      !positionData.position = !angleBPosition
    endif
  endif

  -- Are we in 2D mode, if so, check the picked circle lies in the same plane
  if(!!edgPosCntrl.activePlane) then

    -- Temporary (should project arc onto plane, not copy plane orientation)
    -- Could make this a 2D option, project arc onto plane or not?
    !positionData.arc.orientation = !!edgPosCntrl.workPlane.orientation

    -- If the arc item was derived from a linear item, then position
    -- the arc at the intersection (only if it intersects within the
    -- length of the line)
    if(!positionData.line.set()) then

      -- If line, lies on the plane, use point picked
      !dirY = !positionData.line.direction()
      !dirZ = !!edgPosCntrl.workPlane.orientation.zDir()

      var !angleStr CONSTRUCT ANGLE $!dirY AND $!dirZ
      if(!angleStr.real().nint() eq 90) then
        var !iPos CONSTRUCT POSITION INTERSECT LINE $!dirY THROUGH $!positionData.line.startPosition LINE $!pickVector.direction THROUGH $!pickVector.position
        !positionData.arc.position    = !iPos.position()
      else

        -- Calculate intersection point
        !intersect = !!edgPosCntrl.workPlane.intersection(!positionData.line)
        if(!positionData.line.onProjected(!intersect)) then
          !positionData.arc.position    = !intersect

          -- Use the pick point, and project circle onto plane from that point
        else
          var !iPos CONSTRUCT POSITION INTERSECTLINE $!dirY THROUGH $!positionData.line.startPosition LINE $!pickVector.direction THROUGH $!pickVector.position
          !positionData.arc.position    = !iPos.position()
        endif
      endif
    endif

    !positionData.arc.position    = !!edgPosCntrl.workPlane.near(!positionData.arc.position)

  endif

  -- Return
  return !positionData

endmethod
-- End of method definition for .positionArc() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      positionPlane
--
-- Description:
--   Positioning pick for plane elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--    EDGPOSITIONDATA  Processed pick return
--
------------------------------------------------------------------------

define method .positionPlane() is EDGPOSITIONDATA

  -- Positioning Data
  !positionData      = !this.planeEvaluate()

  -- Determine the picked position on the plane
  !positionData.position = !positionData.plane.intersection(!positionData.pointVector)

  -- Return
  return !positionData

endmethod
-- End of method definition for .positionPlane() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      lineEvaluate
--
-- Description:
--   Evaluate line from pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--    EDGPOSITIONDATA  Processed pick return
--
------------------------------------------------------------------------

define method .lineEvaluate() is EDGPOSITIONDATA

  -- Positioning Data
  !positionData      = !!edgCntrl.pickData.positionData()
  !positionData.line()
  -- Return
  return !positionData

endmethod
-- End of method definition for .lineEvaluate() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      circleEvaluate
--
-- Description:
--   Evaluate circle from pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--    EDGPOSITIONDATA  Processed pick return
--
------------------------------------------------------------------------

define method .circleEvaluate() is EDGPOSITIONDATA

  -- Positioning Data
  !positionData      = !!edgCntrl.pickData.positionData()
  !positionData.arc()

  -- Return
  return !positionData

endmethod
-- End of method definition for .circleEvaluate() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      planeEvaluate
--
-- Description:
--   Evaluate plane from pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--    EDGPOSITIONDATA  Processed pick return
--
------------------------------------------------------------------------

define method .planeEvaluate() is EDGPOSITIONDATA

  -- Positioning Data
  !positionData      = !!edgCntrl.pickData.positionData()
  !positionData.plane()

  -- Return
  return !positionData

endmethod
-- End of method definition for .planeEvaluate() EDGPOSITIONDATA



