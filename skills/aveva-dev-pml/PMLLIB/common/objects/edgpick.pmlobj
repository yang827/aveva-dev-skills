------------------------------------------------------------------------
--
-- Method:      stdScreen
--
-- Description:
--   Standard pick interpreter for screen position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stdScreen()

  -- Set data for pick
  !this.key         = 'stdScreen'
  !this.description = 'Screen'
  !this.inMode      = 'screen'
  $* P-27785: cross hair freezes for measurements (rcfl 15/July/2011)
  $* Inmode starts with pointer, and Handler converts to crosshair
  $* between mouse_down and mouse_up, then reverts to pointer
  $*--!this.cursor      = 'crosshair'
  !this.cursor      = 'pointer'
  !this.modifiable  = false

endmethod
-- End of method definition for .stdScreen()

