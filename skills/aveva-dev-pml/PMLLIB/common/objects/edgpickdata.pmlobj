--
--
-- Description:
-- Pickdata from a inmode .data member.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  positionData()                   EDGPOSITIONDATA     Return object as a position data object
--  viewData(GADGET)                 -                   Returns passed view pick data
--
------------------------------------------------------------------------

-- Define object
define object EDGPICKDATA

  -- [1]  Pick type
  member .type          is STRING
  -- [2]  Tubing (arrive/leave)
  member .tubing        is STRING
  -- [3]  Item picked
  member .item          is DBREF
  -- [4]  Ppoint
  member .point         is REAL
  -- [5]  Pline
  member .pLine         is STRING
  -- [6]  Aid Type
  member .aidType       is STRING
  -- Pick Line [7] & [8]
  member .pickLine      is POINTVECTOR
  -- [9]
  member .notUsed       is STRING
  -- [10]
  member .primitiveType is STRING
  -- [11]
  member .primaryObject is STRING
  -- [12] Number of vertices in graphic pick
  member .vertexCount   is REAL
  -- [13] Vertices picked
  member .vertices      is ARRAY
  -- [14] Number of lines in graphic pick
  member .lineCount     is REAL
  -- [15] Lines picked
  member .lines         is ARRAY
  -- [16] Number of Facets in graphic pick
  member .facetCount    is REAL
  -- [17] Facets picked
  member .facets        is ARRAY

  -- Pre-defined position (explicit position bye-pass all other position deriving data)
  member .position      is POSITION

endobject
-- End of object definition for EDGPICKDATA

------------------------------------------------------------------------
--
-- Method:      viewData
--
-- Description: Returns passed view pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      VIEW
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewData(!view is GADGET)

  -- [1]  Pick type
  !this.type          = !view.inMode.data[1]
  -- [2]  Tubing (arrive/leave)
  !this.tubing        = !view.inMode.data[2]
  -- [3]  Item picked
  !this.item          = !view.inMode.data[3]
  -- [4]  Ppoint
  !this.point         = !view.inMode.data[4]
  -- [5]  Pline
  !this.pLine         = !view.inMode.data[5]
  -- [6]  Aid Type
  !this.aidType       = !view.inMode.data[6]
  -- Pick Line [7] & [8]
  !this.pickLine.position  = !view.inMode.data[7]
  !this.pickLine.direction = !view.inMode.data[8]
  -- [9]
  !this.notUsed       = ''
  -- [10]
  !this.primitiveType = !view.inMode.data[10]
  -- [11]
  !this.primaryObject = !view.inMode.data[11]
  -- [12] Number of vertices in graphic pick
  !this.vertexCount   = !view.inMode.data[12]
  -- [13] Vertices picked
  !this.vertices      = !view.inMode.data[13]
  -- [14] Number of lines in graphic pick
  !this.lineCount     = !view.inMode.data[14]
  -- [15] Lines picked
  !this.lines         = !view.inMode.data[15]
  -- [16] Number of Facets in graphic pick
  !this.facetCount    = !view.inMode.data[16]
  -- [17] Facets picked
  !this.facets        = !view.inMode.data[17]
  -- Explicit position
  !this.position      = object POSITION()

endmethod
-- End of method definition for .viewData(GADGET)

------------------------------------------------------------------------
--
-- Method:      positionData
--
-- Description: Return object as a position data object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionData() is EDGPOSITIONDATA

  -- Initialise Variables
  !return              = object EDGPOSITIONDATA()

  -- If position is already defined, then ignore all other data
  if(!this.position.set()) then
    !return.position   = !this.position
    return !return
  endif

  -- Set data for deriving position
  !return.type         = !this.type
  !return.originalType = !this.type
--   !return.direction   =
  !return.pointVector  = !this.pickLine
--   !return.line        =
--   !return.plane       =
--   !return.arc         =
  !return.item         = !this.item
--   !return.items       =
  !return.pPoint       = !this.point
  !return.pLine        = !this.pLine
  !return.tubing       = !this.tubing

  if (!this.aidType eq 'RAY') then
     !return.originalType = STRING()
     !return.position     = !this.pickLine.position
     return !return
  endif

  -- Determine if we have picked a graphics item
  if(!this.primaryObject.trim().empty().not()) then

    -- Change type to a graphics pick
    !return.type        = 'GRAPHICS'

    -- Convert into line
    if(!this.primaryObject eq 'EDGE') then
      !return.line     = object LINE(!this.lines[1], !this.lines[2])

      -- Convert into plane
    elseif (!this.primaryObject eq 'FACET') then
      !return.plane    = !this.facets[1].plane(!this.facets[2], !this.facets[3])
      handle any
        !return.plane  = !this.facets[1].plane(!this.facets[2], !this.facets[4])
      endhandle

      -- Handle Unset planes
      if(!return.plane.unset()) then
        !return.plane  = !this.facets[1].plane(!this.facets[2], !this.facets[4])
        handle any
        endhandle
      endif

    -- Convert into position
    elseif (!this.primaryObject eq 'VERTEX') then
      !return.position = !this.vertices[1]

    endif

  endif

  return !return

endmethod
-- End of method definition for .positionData() EDGPOSITIONDATA
