--    1   R      ANY         Means of determining the plane, result
--                           MUST be a plane object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circleRad2d(!planeData is ANY)

  -- Set Data
  !this.key         = 'circleRad2d'
  !this.description = 'Circle centred, derived radius'
  !this.prompt      = 'Circle (derived radius)'
  !this.action      = '!!appMathLib.gmfArc.radius2Points(!this.return[1].position, !this.return[2].position,' & !planeData & ')'
  !this.picks.clear()
  !this.picks[1]    = object EDGPICKTYPE()
  !this.picks[1].stdPosition('centre')
  !this.picks[2]    = object EDGPICKTYPE()
  !this.picks[2].stdPosition('radius through point')

endmethod
-- End of method definition for .circleRad2d(ANY)

