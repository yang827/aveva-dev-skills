--
------------------------------------------------------------------------

define method .circleFillet(!realData is ANY)

  -- Set Data
  !this.key         = 'circleFillet'
  !this.description = 'Fillet Circle of defined radius'
  !this.prompt      = 'Circle (fillet)'
  !this.action      = '!this.circleFillet(' & !realData & ', !this.return[1], !this.return[2])'
  !this.picks.clear()
  !this.picks[1]    = object EDGPICKTYPE()
  !this.picks[1].stdGraphics('First element')
  !this.picks[2]    = object EDGPICKTYPE()
  !this.picks[2].stdGraphics('Second element')

endmethod
-- End of method definition for .circleFillet(ANY)

------------------------------------------------------------------------
--
-- Method:      circleFillet
--
-- Description: Fillet circle of defined radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Means of determining the radius, result MUST be a real value
--    2   R      ANY         First pick
--    3   R      ANY         Second pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circleFillet(!realData is ANY, !firstPick is ANY, !secondPick is ANY) is ARC

  -- Set Data
  !positionData[1] = !firstPick.positionData()
  !positionData[2] = !secondPick.positionData()

  -- Convert picks into lines and arc
  !line[1]         = !positionData[1].getLine()
  !line[2]         = !positionData[2].getLine()
  !arc[1]          = !positionData[1].getArc()
  !arc[2]          = !positionData[2].getArc()

  -- If both arcs are defined, then derive the arc fillet using the mid-point between
  -- to two picked position as the centre side
  if(!arc[1].set() and !arc[2].set()) then

    -- Get position nearest to the pick on the arc
    do !i indices !arc
      !angle        = !arc[!i].near(!arc[!i].plane().intersection(!positionData[!i].pointVector))
      !position[!i] = !arc[!i].anglePosition(!angle)
    enddo

    return !!appMathLib.gmfArc.tanArcArc(!realData, !position[1], !arc[1], !position[2], !arc[2])

    -- Fillet for line an line
  elseif (!arc[1].unset() and !arc[2].unset()) then

    -- if picks on plane then arcs cannot be determined - drop through to error return
    if( !line[1].set() and !line[2].set() ) then
      if( !line[1].direction().isParallel(!line[2].direction()) ) then
        -- cannot calculate fillet arc between parallel lines
        return error 2 'EDG:Cannot calculate fillet arc between parallel lines'
      else
        -- Positions
        do !i indices !line
          !position[!i] = !line[!i].intersection(!positionData[!i].pointVector)
        enddo

        return !!appMathLib.gmfArc.fillet(!realData, !line[1], !position[1], !line[2], !position[2])
      endif
    else
      return error 1 'EDG:Cannot calculate an arc from  picked geometry'
    endif

  -- One Line One arc
  else

    -- First point picked was an arc
    if(!arc[1].set()) then
      !angle     = !arc[1].near(!arc[1].plane().intersection(!positionData[1].pointVector))
      !aPosition = !arc[1].anglePosition(!angle)
      !lPosition = !line[2].intersection(!positionData[2].pointVector)

      return !!appMathLib.gmfArc.tanArcLine(!realData, !aPosition ,!arc[1], !lPosition, !line[2])

    -- Second point picked was an arc
    else
      !angle     = !arc[2].near(!arc[2].plane().intersection(!positionData[2].pointVector))
      !aPosition = !arc[2].anglePosition(!angle)
      !lPosition = !line[1].intersection(!positionData[1].pointVector)

      return !!appMathLib.gmfArc.tanLineArc(!realData, !lPosition, !line[1] ,!aPosition ,!arc[2])

    endif

  endif

  return object ARC()

endmethod
-- End of method definition for .circleFillet(ANY, ANY, ANY) ARC

