--
------------------------------------------------------------------------

define method .circleFixRad3d(!radiusData is ANY)

  -- Set Data
  !this.key         = 'circleFixRad3d'
  !this.description = 'Circle Centre, defined radius'
  !this.prompt      = 'Circle (defined radius)'
  !this.action      = '!!appMathLib.gmfArc.fRadius3Points(' & !radiusData & ', !this.return[1].position, !this.return[2].position, !this.return[3].position)'
  !this.picks.clear()
  !this.picks[1]    = object EDGPICKTYPE()
  !this.picks[1].stdPosition('centre')
  !this.picks[2]    = object EDGPICKTYPE()
  !this.picks[2].stdPosition('first control point (X)')
  !this.picks[3]    = object EDGPICKTYPE()
  !this.picks[3].stdPosition('second control point (Y)')

endmethod
-- End of method definition for .circleFixRad3d(ANY)

