--
-- Description:
-- Pick control type, defines the type of pick mechanism being used:
--
--   Positioning Pick
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  circle3Pnts()                    -                   Circle through 3 Points
--  circleDerive()                   -                   Derive a circle from a DB element
--  circleDia2d(ANY)                 -                   Circle through 2 Positions (diameter defined) 2D
--  circleDia3d()                    -                   Circle through 2 Positions (diameter defined) 3D
--  circleFRadPntPnt(ANY)            -                   Circle going through two points + polar control point
--  circleFRadPntTan(ANY)            -                   Circle, centred and tangential to another circles of fixed radius
--  circleFillet(ANY)                -                   Fillet circle of defined radius
--  circleFillet(ANY,ANY,ANY)        ARC                 Fillet circle of defined radius
--  circleFixDia2d(ANY,ANY)          -                   Circle centred of defined diameter 2D
--  circleFixDia3d(ANY)              -                   Circle centred of defined diameter 3D
--  circleFixRad2d(ANY,ANY)          -                   Circle define centre and radius + control point 2D
--  circleFixRad3d(ANY)              -                   Circle centred of defined radius 3D
--  circlePntTan()                   -                   Circle, centred and tangential to another circles
--  circleRad2d(ANY)                 -                   Circle define centre and radius + control point 2D
--  circleRad3d()                    -                   Circle define centre and radius + control point 3D
--  circleTan3Lines()                -                   Circle tangential to 3 lines
--  circleTanTan(ANY)                -                   Circle tangential to two other circles
--  direction(STRING)                -                   Standard Aid element pick
--  lineAngle(ANY)                   -                   Line offset by an angle from the picked line, towards the second pick
--  lineBisect()                     -                   Line bisecting two other lines (smallest angle side)
--  lineDerive()                     -                   Derive a line from a db element
--  linePntPnt()                     -                   Define a line
--  linePntTan()                     -                   Line between point an tangent of arc
--  lineShortest()                   -                   Shortest Line between to picked items
--  lineTanTan()                     -                   Line between tangent points of two arcs
--  lineTwoPlanes()                  -                   Line at intersection of two planes
--  measureAngle()                   -                   Standard angle measure between three points
--  measureDistance()                -                   Standard distance measure
--  measureLineAngle()               -                   Standard angle measure between 2 lines
--  measurePerpendicularToPoint()    -                   Measure from point perpendicular to target item
--  plane2Pnts(POSITION)             -                   Define a plane through 3 Positions
--  plane3Pnts()                     -                   Define a plane through 3 Positions
--  planeDerive()                    -                   Derive a plane from a db element
--  pointPnt()                       -                   Define working point in 3D space
--  query()                          -
--  runAction()                      ANY                 Carry out pickPacket action
--  stdAid(STRING)                   -                   Standard Aid element pick
--  stdAny(STRING)                   -                   Standard element pick
--  stdElement(STRING)               -                   Standard element pick
--  stdGphWindow(STRING)             -                   Standard graphical window pick (only screen position used)
--  stdGraphic(STRING)               -                   Standard Graphic pick
--  stdPline(STRING)                 -                   Standard pline pick
--  stdPosition(STRING)              -                   Standard 3D single position pick
--  stdPpoint(STRING)                -                   Standard ppoint pick
--  stdScreen(STRING)                -                   Standard screen pick
--  stdView(STRING)                  -                   Standard screen pick
--  windowCircle()                   ARC                 Construct and returns a "circle" from the current pick information
--
------------------------------------------------------------------------

-- Define object
define object EDGPICKPACKET

  -- Pick Packet Key Identifier
  member .key         is STRING

  -- Description
  member .description is STRING

  -- Application prompt
  member .prompt      is STRING

  -- Action after all picks have been completed
  member .action      is STRING

  -- Array of "edgPickTypes" required for pick packet completion
  member .picks       is ARRAY

  -- Any required input data
  member .input       is ARRAY

  -- Return Data
  member .return      is ARRAY

endobject
-- End of object definition for EDGPICKPACKET

------------------------------------------------------------------------
--
-- Method:      query
--
-- Description:
--   Displays current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .query()

  QUERY VARIABLE !this.key
  QUERY VARIABLE !this.description
  QUERY VARIABLE !this.prompt
  QUERY VARIABLE !this.action
  QUERY VARIABLE !this.picks
  QUERY VARIABLE !this.input
  QUERY VARIABLE !this.return

endmethod
-- End of method definition for .query()

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description: Carry out pickPacket action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ANY         Result from action
--
------------------------------------------------------------------------

define method .runAction() is ANY

  -- Type and action anything in the member .action
  if(!this.action.set() and !this.action.empty().not()) then
    !command = !this.action
    !return  = $!<command>
    handle any
      !this.return.clear()
      return error 1 '$!!error.text' noalert
    endhandle
    return !return

  -- If there is no action to process data, pass return up to calling level
  else
    -- If there is only one entry, then return it
    if(!this.return.size() eq 1) then
      return !this.return[1]
    else
      return !this.return
    endif
  endif

endmethod
-- End of method definition for .runAction() ANY

------------------------------------------------------------------------
--
-- Method:      stdGphWindow
--
-- Description: Standard graphical window pick (only screen position used)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Application Prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stdGphWindow(!text is STRING)

  -- Set Data
  !this.key         = 'stdGphWindow'
  !this.description = 'Standard Graphical Window Pick'
  !this.prompt      = !text
  !this.action      = '!this.windowCircle()'
  !this.picks[1]    = object EDGPICKTYPE()
  !this.picks[1].stdScreen('first point')
  !this.picks[1].pick.cursor = 'topleft'
  !this.picks[2]    = object EDGPICKTYPE()
  !this.picks[2].stdScreen('second point')
  !this.picks[2].pick.cursor = 'bottomright'

endmethod
-- End of method definition for .stdGphWindow(STRING)

------------------------------------------------------------------------
--
-- Method:      windowCircle
--
-- Description: Construct and returns a "circle" from the current pick information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARC         Basic Circle Definition
--
------------------------------------------------------------------------

define method .windowCircle() is ARC

  -- Initialise Variables
  !returnCircle             = object ARC()

  -- Constants
  !returnCircle.startAngle  = 0
  !returnCircle.endAngle    = 180
  !returnCircle.sense       = true

  -- Calculate Circle Origin
  !returnCircle.position    = !this.return[1].position.midPoint(!this.return[2].position)

  -- Circle Diameter
  !returnCircle.radius      = !this.return[1].position.distance(!this.return[2].position) / 2

  -- Circle Orientation (default Y is N)
  !returnCircle.orientation = object ORIENTATION('Y is N')
  return !returnCircle

endmethod
-- End of method definition for .windowCircle() ARC

