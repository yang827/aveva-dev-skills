--
--
-- Description:
-- EDG Positioning Data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc()                            -                   Evaluate arc definition for current data
--  getArc()                         ARC
--  getLine()                        LINE
--  getPlane()                       PLANE               Return plane definition for current data. Plane member not set
--  line()                           -                   Evaluate line definition for current data
--  plane()                          -                   Evaluate plane definition for current data
--
------------------------------------------------------------------------

-- Define object
define object EDGPOSITIONDATA

  -- Position derive type
  member .type         is STRING
  member .originalType is STRING

  -- Position
  member .position     is POSITION
  -- Direction
  member .direction    is DIRECTION
  -- Point Vector
  member .pointVector  is POINTVECTOR
  -- Line
  member .line         is LINE
  -- Plane
  member .plane        is PLANE
  -- Arc
  member .arc          is ARC
  -- Item Picked
  member .item         is DBREF
  -- Items Picked (where multiple items have been picked, i.e. intersections)
  member .items        is ARRAY
  -- Ppoint
  member .pPoint       is REAL
  -- Pline
  member .pLine        is STRING
  -- Tubing (arrive/leave)
  member .tubing        is STRING

endobject
-- End of object definition for EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Evaluate line definition for current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--
------------------------------------------------------------------------

define method .line()

  -- Get Arc of item
  !line = !this.getLine()

  if(!line.unset()) then
    !this.line = object LINE()
    !!alert.warning('Unable to derive a line definition from the picked item, pick another graphic element.')
  else
    !this.line = !line
  endif

endmethod
-- End of method definition for .line()

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Evaluate arc definition for current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--
------------------------------------------------------------------------

define method .arc()

  -- Get Arc of item
  !arc = !this.getArc()

  if(!arc.unset()) then
    !this.arc = object ARC()
    !!alert.warning('Unable to derive an arc definition from the picked item, pick another graphic element.')
  else
    !this.arc = !arc
  endif

endmethod
-- End of method definition for .arc()

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Evaluate plane definition for current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--
------------------------------------------------------------------------

define method .plane()

  -- Get Arc of item
  !plane = !this.getPlane()

  if(!plane.unset()) then
    !this.plane = object PLANE()
    !!alert.warning('Unable to derive a plane definition from the picked item, pick another graphic element.')
  else
    !this.plane = !plane
  endif

endmethod
-- End of method definition for .plane()

------------------------------------------------------------------------
--
-- Method:      getline
--
-- Description: Return line definition for current data. line member not set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--
------------------------------------------------------------------------

define method .getLine() is LINE

  -- Initialise Variables
  !line   = !this.line

  -- If a line has been defined, process data
  if(!line.unset()) then

    -- Determine how we interpret the line

    -- Design Aid Picked
    if(!this.originalType eq 'DESIGNAID') then

      -- Aid Number
      !aidNumber  = !this.pPoint
      !aidElement = !!aidNumbers.numbers[!aidNumber].coreObject()
      !aidType    = !aidElement.objectType()

      -- Determine the type of aid picked (use !!aidNumbers.numbers definition)
      if(undefined(!!aidNumbers.numbers[!aidNumber])) then
        !!alert.warning('Graphic aid is has not been registered.')
        return
      endif

      -- Line
      if(!aidType eq 'LINE') then
        !line = !aidElement
      endif

    -- Design DB tubing
    elseif (!this.originalType eq 'TUBING') then
      !line = !!edgTypes.attribute('TUBING').line(!this.item, !this.tubing)

    -- Design DB pline
    elseif (!this.originalType eq 'PLINE') then
      !line  = !!edgTypes.attribute('PLINE').line(!this.item, !this.pLine)

      -- Special Case, the pick line need to be considered to determine
      handle any
        !line  = !!edgTypes.attribute('PLINE').line(!this.item, !this.pLine, !this.pointVector)
        handle any
        endhandle
      elsehandle none
        if(!line.unset()) then
          !line  = !!edgTypes.attribute('PLINE').line(!this.item, !this.pLine, !this.pointVector)
          handle any
          endhandle
        endif
      endhandle

    -- Design DB Ppoint
    elseif (!this.originalType eq 'PPOINT') then
      !line = !!edgTypes.attribute('PPOINT').line(!this.item, !this.pPoint)

    -- Design DB element (last resort to determine the line from the DB element)
    elseif (!this.item.set()) then
      !line = !!edgTypes.attribute(!this.item.fullType.upcase()).line(!this.item)

      -- Special Case, the pick line need to be considered to determine
      handle any
        !line = !!edgTypes.attribute(!this.item.fullType.upcase()).line(!this.item, !this.pointVector)
        handle any
        endhandle
      endhandle

    endif

  -- Special Case for Plines
  else
    -- Design DB pline
    if(!this.pLine.trim().empty().not()) then
      !line  = !!edgTypes.attribute('PLINE').line(!this.item, !this.pLine)

      -- Special Case, the pick line need to be considered to determine
      handle any
        !line  = !!edgTypes.attribute('PLINE').line(!this.item, !this.pLine, !this.pointVector)
        handle any
        endhandle
      elsehandle none
        if(!line.unset()) then
          !line  = !!edgTypes.attribute('PLINE').line(!this.item, !this.pLine, !this.pointVector)
          handle any
          endhandle
        endif
      endhandle
    endif

    -- Check that we have picked a line item
    !check = !line.near(n0)
    handle any
      !line = object LINE()
    endhandle

  endif

  -- Return
  return !line

endmethod
-- End of method definition for .getLine() LINE

------------------------------------------------------------------------
--
-- Method:      getarc
--
-- Description: Return arc definition for current data. Arc member not set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--
------------------------------------------------------------------------

define method .getArc() is ARC

  -- Initialise Variables
  !arc = !this.arc

  -- If a line has been defined, process data
  if(!arc.unset()) then

    -- Determine the "reference" position to derive the arc position
    if(!this.position.set()) then
      !refPosition = !this.position
    elseif (!this.line.set()) then
      !refPosition = !this.line.intersection(!this.pointVector)
    elseif (!this.plane.set()) then
      !refPosition = !this.plane.intersection(!this.pointVector)
    endif

    -- >>>>>>>>>>>>>>>>>>>>>>>> Design Aid Picked <<<<<<<<<<<<<<<<<<<<<<<
    if(!this.originalType eq 'DESIGNAID') then

      -- Aid Number
      !aidNumber  = !this.pPoint
      !aidElement = !!aidNumbers.numbers[!aidNumber].coreObject()
      !aidType    = !aidElement.objectType()

      -- Determine the type of aid picked (use !!aidNumbers.numbers definition)
      if(undefined(!!aidNumbers.numbers[!aidNumber])) then
        !!alert.warning('Graphic aid is has not been registered.')
        return
      endif

      -- Arc
      if(!aidType eq 'ARC') then
        !arc = !aidElement
      endif

    -- Design DB pline
    elseif (!this.originalType eq 'PLINE' or (!this.pLine.set() and !this.pLine.trim().empty().not())) then
      !arc   = !!edgTypes.attribute('PLINE').arc(!this.item, !this.pLine)

      -- Special Case, the pick line need to be considered to determine
      handle any
        !arc  = !!edgTypes.attribute('PLINE').arc(!this.item, !this.pLine, !this.pointVector)
        handle any
        endhandle
      elsehandle none
        if(!arc.unset()) then
          !arc  = !!edgTypes.attribute('PLINE').arc(!this.item, !this.pLine, !this.pointVector)
          handle any
          endhandle
        endif
      endhandle

    -- Design DB element
    elseif (!this.originalType eq 'ELEMENT') then

      -- If a Ppoint has been picked, then we will use the arc ppoint method
      -- of the item (if it has one)
      if(!this.pPoint ne 0) then
        !arc  = !!edgTypes.attribute(!this.item.fullType.upcase()).arc(!this.item, !this.pPoint )
        handle any
        endhandle
      endif

      -- Derive the arc from the reference position
      if(define(!refPosition) and !arc.unset()) then
        !arc  = !!edgTypes.attribute(!this.item.fullType.upcase()).arc(!this.item, !refPosition )
        handle any
        endhandle
      endif

      -- Use basic arc method
      if(!arc.unset()) then
        !arc  = !!edgTypes.attribute(!this.item.fullType.upcase()).arc(!this.item)
        handle any
        endhandle
      endif

      -- Try as last resort if a ppoint had been picked
      if(!this.pPoint ne 0 and !arc.unset()) then
        !arc  = !!edgTypes.attribute('PPOINT').arc(!this.item, !this.pPoint)
        handle any
        endhandle
      endif

    -- >>>>>>>>>>>>>>>>>>>>>>>> Design DB tubing <<<<<<<<<<<<<<<<<<<<<<<
    elseif (!this.originalType eq 'TUBING') then

      -- Derive the arc from the reference position
      if(define(!refPosition)) then
        !arc  = !!edgTypes.attribute('TUBING').arc(!this.item, !refPosition )
        handle any
        endhandle
      endif

      -- Use basic arc method
      if(!arc.unset()) then
        !arc  = !!edgTypes.attribute('TUBING').arc(!this.item)
        handle any
        endhandle
      endif

    -- >>>>>>>>>>>>>>>>>>>>>>>> Design DB Ppoint <<<<<<<<<<<<<<<<<<<<<<<
    elseif (!this.originalType eq 'PPOINT') then
      !arc  = !!edgTypes.attribute('PPOINT').arc(!this.item, !this.pPoint)
      handle any
      endhandle

    endif

    -- Check that we have picked a arc item
    !check = !arc.near(n0)
    handle any
      !arc = object ARC()
    endhandle

  endif

  -- Return
  return !arc

endmethod
-- End of method definition for .getArc() ARC

------------------------------------------------------------------------
--
-- Method:      getPlane
--
-- Description: Return plane definition for current data. Plane member not set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]      [Description]
--
------------------------------------------------------------------------

define method .getPlane() is PLANE

  -- Initialise Variables
  !plane = !this.plane

  -- If a line has been defined, process data
  if(!plane.unset()) then

    -- Design Aid Picked
    if(!this.type eq 'DESIGNAID') then

      -- Aid Number
      !aidNumber  = !this.pPoint
      !aidElement = !!aidNumbers.numbers[!aidNumber].coreObject()
      !aidType    = !aidElement.objectType()

      -- Determine the type of aid picked (use !!aidNumbers.numbers definition)
      if(undefined(!!aidNumbers.numbers[!aidNumber])) then
        !!alert.warning('Graphic aid is has not been registered.')
        return
      endif

      -- Underlying plane picked
      if(!aidElement.objectType() eq 'PLANE') then
         !plane = !aidElement

      -- If core object isn't a plane, can it be converted into on
      else

        -- Convert item into plane
        !plane = !aidElement.plane()
        handle any
        endhandle

      endif

    -- Design DB element
    elseif (!this.type eq 'ELEMENT') then
      if(!this.item.fullType eq 'PANEL') then
        !plane = !!edgTypes.panel.plane(!this.item, !!edgTypes.panel.surfacePicked(!this.item, !this.pointVector.direction))
      else
        !plane = !!edgTypes.attribute(!this.item.fullType).plane(!this.item)
        handle any
        endhandle
      endif
      !plane  = !!edgTypes.attribute(!this.item.fullType.upcase()).plane(!this.item)
      handle any
      endhandle

    -- Design DB pline
    elseif (!this.type eq 'PLINE') then

      -- Test for line pline
      !line          = !this.getLine()
      if(!line.set()) then
        if(!this.position.unset()) then
          !position  = !line.intersection(!this.pointVector)
        else
          !position  = !this.position
        endif

        -- Get orientation of pline
        !orientation = !this.item.plOrientation.attribute(!this.pLine)

        -- Get orientation of pline
        if(!orientation.alpha.unset()) then
          !reference = !!ce
          !!ce       = !this.item

          -- Determine the Zdistance of the position
          var !zDistanceString PLDIST PPLINE $!<this.pLine> THROUGH $!<position> VIA PLINE BOUND
          handle any
            !!ce     = !reference
            return object PLANE()
          endhandle
          !curve = !!edgTypes.gensec.curve(!this.item, !position)

          -- Straight gensec
          if(!curve.type eq 'POINSP') then
            var !zDirection      PPLINE $!<this.pLine> Z DIRECTION DISTANCE $!<zDistanceString> VIA PLINE FROM START
            handle any
              !!ce     = !reference
              return object PLANE()
            endhandle

            -- Get y direction
            var !yDirection      PPLINE $!<this.pLine> Y DIRECTION DISTANCE $!<zDistanceString> VIA PLINE FROM START
            handle any
              !!ce     = !reference
              return object PLANE()
            endhandle

          else

            -- Get z direction
            var !zDirection      PPLINE $!<this.pLine> Z DIRECTION DISTANCE $!<zDistanceString> VIA PLINE FROM START OF $!<curve>
            handle any
              !!ce     = !reference
              return object PLANE()
            endhandle

            -- Get y direction
            var !yDirection      PPLINE $!<this.pLine> Y DIRECTION DISTANCE $!<zDistanceString> VIA PLINE FROM START OF $!<curve>
            handle any
              !!ce     = !reference
              return object PLANE()
            endhandle

          endif
          !!ce     = !reference

          !orientation = object ORIENTATION('Y is ' & !yDirection & ' wrt World and Z is ' & !zDirection & ' wrt World')
        endif

      -- Text for arc pline
      else
        !arc      = !this.getArc()
        if(!arc.set()) then
          !gmfArc      = object GMFARC(!arc)
          if(!this.position.unset()) then
            !position = !gmfArc.exact(!this.pointVector)
          else
            !position = !this.position
          endif

          -- Get orientation of pline
          !reference = !!ce
          !!ce       = !this.item

          -- Determine the Zdistance of the position
          var !zDistanceString PLDIST PPLINE $!<this.pLine> THROUGH $!<position> VIA PLINE BOUND
          handle any
            !!ce     = !reference
            return object PLANE()
          endhandle
          !curve = !!edgTypes.gensec.curve(!this.item, !position)

          -- Get z direction
          var !zDirection      PPLINE $!<this.pLine> Z DIRECTION DISTANCE $!<zDistanceString> VIA PLINE FROM START OF $!<curve>
          handle any
            !!ce     = !reference
            return object PLANE()
          endhandle

          -- Get y direction
          var !yDirection      PPLINE $!<this.pLine> Y DIRECTION DISTANCE $!<zDistanceString> VIA PLINE FROM START OF $!<curve>
          handle any
            !!ce     = !reference
            return object PLANE()
          endhandle
          !!ce     = !reference

          !orientation = object ORIENTATION('Y is ' & !yDirection & ' wrt World and Z is ' & !zDirection & ' wrt World')

        else
          return object PLANE()
        endif
      endif

     !plane             = object PLANE()
     !plane.position    = !position
     !plane.orientation = !orientation

    -- Design DB Ppoint
    elseif (!this.type eq 'PPOINT') then
     !plane             = object PLANE()
     !plane.position    = !this.item.pPosition[!this.pPoint]
     !plane.orientation = object ORIENTATION('Z is ' & !this.item.pDirection[!this.pPoint])

    endif

    -- Check that we have picked a arc item
    !check = !plane.near(n0)
    handle any
      !plane = object PLANE()
    endhandle
  endif

  -- Return
  return !plane

endmethod
-- End of method definition for .getPlane() PLANE
