define object EDGPPOINT

  -- Dummy
  member .dummy      is STRING
  -- Edit Form
  member .editForm   is FORM
  -- Create Form
  member .createForm is FORM

endobject
-- End of object definition for EDGPPOINT

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description:
--   Return circle definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Elements DBREF
--    2   R      REAL        Ppoint number
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !number is REAL) is ARC

  -- Initialise Variables

  -- If there is a BORE of the item, then use it
  !radius = !dbRef.ppBore[!number].real()
  handle any

    -- Special Ppoints

    -- Handle Panel/Extrusion Ppoints (vertices)
    if(!dbRef.hardType inset('PANE','EXTRU','NXTR','REVO')) then

      -- Handle PLOOPs
      if(!dbRef.hardType eq 'PANE') then
        !loop = PLOOP 1 of $!dbRef
      else
        !loop = LOOP 1 of $!dbRef
      endif

      -- Get "vertex" of loop
      !startPosition  = !loop.members[!number].pPosition[6]
      !centrePosition = !loop.members[!number].pPosition[8]
      !endPosition    = !loop.members[!number].pPosition[4]
      return !!appMathLib.gmfArc.radius3Points(!centrePosition, !startPosition, !endPosition)

    -- Handle Panel/Extrusion Loops
    elseif (!dbRef.type inset('PLOO','LOOP')) then

      -- Get "vertex" of loop
      !startPosition  = !loop.members[!number].pPosition[6]
      !centrePosition = !loop.members[!number].pPosition[8]
      !endPosition    = !loop.members[!number].pPosition[4]
      return !!appMathLib.gmfArc.radius3Points(!centrePosition, !startPosition, !endPosition)

    -- Handle Panel/Extrusion Loops
    elseif (!dbRef.type inset('PAVE','VERT')) then

      -- Get "vertex" of loop
      !startPosition  = !dbRef.pPosition[6]
      !centrePosition = !dbRef.pPosition[8]
      !endPosition    = !dbRef.pPosition[4]
      return !!appMathLib.gmfArc.radius3Points(!centrePosition, !startPosition, !endPosition)

    endif

  elsehandle none

    -- Check the radius is set
    if(!radius eq 0) then
      return object ARC()
    else
      !radius = !radius / 2
    endif

  endhandle

  -- Get Position and orientation

  -- Define return arc
  !position     = !dbRef.pPosition[!number]
  !orientation  = object ORIENTATION('Z is ' & !dbRef.pDirection[!number])
  !arc          = object ARC(!position.wrt(World), !orientation.wrt(World), 0, 360, !radius, true)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, REAL) ARC

------------------------------------------------------------------------
--
-- Method:      dbPpoint
--
-- Description:
--   Convert passed ppoint of an element into a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database Element
--    2   R      REAL        Ppoint number
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF, !number is REAL) is LINE

  -- Initialise Variables
  !return = object LINE()

  -- Project line in the ppoint direction by a metre
  !return.startPosition     = !dbRef.pPosition[!number]
  !return.endPosition       = !dbRef.pPosition[!number]
  !return.endPosition.east  = !dbRef.pDirection[!number].east  * 1000mm + !return.endPosition.east
  !return.endPosition.north = !dbRef.pDirection[!number].north * 1000mm + !return.endPosition.north
  !return.endPosition.up    = !dbRef.pDirection[!number].up    * 1000mm + !return.endPosition.up
  !return.startPosition     = !return.startPosition.wrt(World)
  !return.endPosition       = !return.endPosition.wrt(World)

  -- Return
  return !return

endmethod
-- End of method definition for .line(DBREF, REAL) LINE
