-- Description:
-- EDG Handler form pyramid element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  line(DBREF)                      LINE                Return element as a line object
--
------------------------------------------------------------------------

define object EDGPYRAMID

  -- Dummy
  member .dummy      is STRING
  -- Edit Form
  member .editForm   is FORM
  -- Create Form
  member .createForm is FORM

endobject
-- End of object definition for EDGPYRAMID

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return element as a line object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Element as a LINE
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- Initialise Variables
  !return               = object LINE()
  !return.startPosition = !dbRef.pPosition[1]
  !return.endPosition   = !dbRef.pPosition[2]

  -- Return
  return !return

endmethod
-- End of method definition for .line(DBREF) LINE
