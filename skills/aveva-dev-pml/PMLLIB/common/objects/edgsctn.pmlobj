------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc(DBREF)                       ARC
--  arc(DBREF,POSITION)              ARC                 Return circle definition through a reference position
--  distance(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified distance from nearest end/snap to point vector on the section
--  distance(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified distance from nearest end/snap to point vector on the section
--  edgSctn()                        -                   Constructor
--  exact(DBREF,LINE)                POSITION            Return the intersection of the passed point vector with the section
--  exact(DBREF,POINTVECTOR)         POSITION            Return the intersection of the passed point vector with the section
--  fraction(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  fraction(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  line(DBREF)                      LINE                Return line definition of section using object settings
--  line(DBREF,POINTVECTOR)          LINE                Return line definition of section using object settings nearest to the picked point vector
--  lineProjected(DBREF,STRING,STRING) LINE                Return line definition of section projected to attached items
--  lineUnprojected(DBREF)           LINE                Return line definition of section elements start/end
--  projectEnd(DBREF,STRING,STRING,STRING) POSITION            Returns the projected end of a section
--  proportion(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  proportion(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  snap(DBREF,LINE,BOOLEAN)         POSITION            Return nearest snap point on line using a passed line
--  snap(DBREF,POINTVECTOR,BOOLEAN)  POSITION            Return nearest snap point on line using a passed point vector
--  snapLine(DBREF,POSITION)         LINE                Returns the "snap" line of the section for the passed position
--
------------------------------------------------------------------------

define object EDGSCTN

  -- Edit Form
  member .editForm      is FORM
  -- Create Form
  member .createForm    is FORM

  -- Extension options for theoretical start/end
  member .project       is BOOLEAN
  -- Attached line to project onto
  member .attachedLine  is STRING
  -- Owning line to project to
  member .owningLine    is STRING

  -- Snap considerations
  member .fitting       is BOOLEAN
  member .joint         is BOOLEAN
  member .node          is BOOLEAN

endobject
-- End of object definition for EDGSCTN

-----------------------------------------------------------------------
--
-- Method:      edgSctn
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgSctn()

  -- Initialise Variables
  !this.project       = false
  !this.attachedLine  = 'JUSLINE'
  !this.owningLine    = 'JUSLINE'
  !this.fitting       = false
  !this.joint         = false
  !this.node          = true

endmethod
-- End of method definition for .edgSctn()

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Return circle definition of section (only can handle sections which have a property of DIAM
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
-- Return:
--   [Data Type] [Description]
--    ARC         Section as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF) is ARC

  -- Initialise Variables

  -- Get Diameter (from property diameter, if there isn't one, error)
  !radius     = !dbRef.property.diam.real() / 2
  handle any
    return object ARC()
  endhandle

  -- Set Data
  !arc          = object ARC(!dbRef.position.wrt(World), !dbRef.orientation.wrt(World), 0, 360, !radius, true)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF) ARC

------------------------------------------------------------------------
--
-- Method:    arc
--
-- Description: Return circle definition through a reference position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element DBREF
--    2   R      REAL        Ppoint number
--    3   R      POSITION    Reference point through which the arc passed
-- Return:
--   [Data Type] [Description]
--    ARC         Cylinder as a ARC
--
------------------------------------------------------------------------

define method .arc(!dbRef is DBREF, !position is POSITION) is ARC

  -- Initialise Variables
  !arc  = !this.arc(!dbRef)

  -- Line reference position is to be projected onto
  !arc.position = !this.lineUnprojected(!dbRef).near(!position).wrt(World)

  -- Return
  return !arc

endmethod
-- End of method definition for .arc(DBREF, POSITION) ARC

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return line definition of section using object settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- No projection of derived line
  if(!this.project.not()) then
    !line = !this.lineUnprojected(!dbRef)

  -- Project the line
  else
    !line = !this.lineProjected(!dbRef, !this.owningLine, !this.attachedLine)
  endif

  return !line

endmethod
-- End of method definition for .line(DBREF) LINE

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return line definition of section using object settings nearest to the picked point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Pick point vector
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF, !pointVector is POINTVECTOR) is LINE

  -- Convert section into a line
  !sectionLine = !this.line(!dbRef)

  -- Intersection of lines
  !iPosition   = !sectionLine.intersection(!pointVector)

  return!this.snapLine(!dbRef, !iPosition)

endmethod
-- End of method definition for .line(DBREF, POINTVECTOR) LINE

------------------------------------------------------------------------
--
-- Method:      lineUnprojected
--
-- Description: Return line definition of section elements start/end
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .lineUnprojected(!dbRef is DBREF) is LINE

  -- Initialise Variables
  !return               = object LINE()
  !return.startPosition = !dbRef.posStart.wrt(World)
  !return.endPosition   = !dbRef.posEnd.wrt(World)

  -- Return
  return !return

endmethod
-- End of method definition for .lineUnprojected(DBREF) LINE

------------------------------------------------------------------------
--
-- Method:      lineProjected
--
-- Description: Return line definition of section projected to attached items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      STRING      Owning projection line
--    3   R      STRING      Attached projection line
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .lineProjected(!dbRef is DBREF, !owning is STRING, !attached is STRING) is LINE

  -- Initialise Variables
  !return               = object LINE()

  -- Derived Start Position
  !return.startPosition = !this.projectEnd(!dbRef, 'START', !owning, !attached)

  -- Derived End Position
  !return.endPosition   = !this.projectEnd(!dbRef, 'END', !owning, !attached)

  -- Return
  return !return

endmethod
-- End of method definition for .lineProjected(DBREF, STRING, STRING) LINE

------------------------------------------------------------------------
--
-- Method:      projectEnd
--
-- Description: Returns the projected end of a section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      STRING      End to be projected
--    3   R      STRING      Owning projection line
--    4   R      STRING      Attached projection line
-- Return:
--   [Data Type] [Description]
--    POSITION    Projected position
--
------------------------------------------------------------------------

define method .projectEnd(!dbRef is DBREF, !end is STRING, !owning is STRING, !attached is STRING) is POSITION

  -- Initialise Variables
  !return               = object POSITION()

  -- Unconnected end
  if(!dbRef.attribute('JOI' & !end).unset()) then
    return !dbRef.attribute('POS' & !end)
  endif

  -- Get line of OWNING
  !owningLine               = object LINE()

  -- No specref
  if(!dbRef.spref.unset()) then
    !owningLine.startPosition = !dbRef.posStart
    !owningLine.endPosition   = !dbRef.posEnd

  -- Use pline associated with attribute
  else

    -- If there is no pline associated with attribute, use NA
    if(!dbRef.attribute(!owning).unset()) then
      !owningLine.startPosition = !dbRef.plStart.na
      !owningLine.endPosition   = !dbRef.plEnd.na
    else
      !owningLine.startPosition = !dbRef.plStart.attribute(!dbRef.attribute(!owning))
      !owningLine.endPosition   = !dbRef.plEnd.attribute(!dbRef.attribute(!owning))
    endif
  endif

  -- Get attach Item Type
  !attachType = !dbRef.attribute('JOI' & !end).type

  -- Secondary Joints
  if(!attachType eq 'SJOI') then
    -- attach Section
    !attachSection = !dbRef.attribute('JOI' & !end).owner.owner

    -- Get line of attach
    !attachLine               = object LINE()

    -- No spref
    if(!attachSection.spref.unset()) then
      !attachLine.startPosition = !attachSection.posStart
      !attachLine.endPosition   = !attachSection.posEnd

    -- Use pline associated with attribute
    else

      -- If there is no pline associated with attribute, use NA
      if(!attachSection.attribute(!attached).unset()) then
        !attachLine.startPosition = !attachSection.plStart.na
        !attachLine.endPosition   = !attachSection.plEnd.na
      else
        !attachLine.startPosition = !attachSection.plStart.attribute(!attachSection.attribute(!attached))
        !attachLine.endPosition   = !attachSection.plEnd.attribute(!attachSection.attribute(!attached))
      endif
    endif

    return !owningLine.intersection(!attachLine)

  -- Primary Joints
  elseif (!attachType eq 'PJOI') then

    -- Convert Joint into a plane
    !pointVector           = object POINTVECTOR()
    !pointVector.position  = !owningLine.startPosition
    !pointVector.direction = !owningLine.direction()
    !plane = object PLANE()
    !plane.position        = !dbRef.attribute('JOI' & !end).position
    !plane.orientation     = !dbRef.attribute('JOI' & !end).orientation
    return !pointVector.intersection(!plane)

  endif

  -- Return
  return !return.wrt(World)

endmethod
-- End of method definition for .projectEnd(DBREF, STRING, STRING, STRING) POSITION

------------------------------------------------------------------------
--
-- Method:      snapLine
--
-- Description: Returns the "snap" line of the section for the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POSITION    Position on line to determine snap line
-- Return:
--   [Data Type] [Description]
--    LINE        Line between snap items
--
------------------------------------------------------------------------

define method .snapLine(!dbRef is DBREF, !position is POSITION) is LINE

  -- Convert section into a line
  !sectionLine = !this.line(!dbRef)

   -- No snapping elements set
  if(!this.fitting.not() and !this.joint.not() and !this.node.not()) then
    return !sectionLine
  endif

  -- Collect all items to be considered as "snap" points
  !searchList = ''
  if(!this.fitting) then
    !searchList = !searchList & ' FITT'
  endif
  if(!this.joint) then
    !searchList = !searchList & ' SJOI SUBJ'
  endif
  if(!this.node) then
    !searchList = !searchList & ' SNOD'
  endif

  -- Collect all items for section
  var !collection COLLECT ALL ($!searchList) FOR $!dbRef

  -- Get distance of each item from startPosition of line
  if(!collection.size() gt 0) then

    -- Distance
    !positions    = ARRAY()
    !distances    = ARRAY()
    !positions[1] = !sectionLine.startPosition
    !distances[1] = 0

    -- Loop through snap elements
    do !i indices !collection
      !positions.append(!sectionLine.near(!collection[!i].dbRef().position))
      !distances.append(!sectionLine.startPosition.distance(!sectionLine.near(!collection[!i].dbRef().position)))
    enddo

    !positions.append(!sectionLine.endPosition)
    !distances.append(!sectionLine.length())

    -- Sort into order
    !sortA = !distances.sortedIndices()

    do !i from 2 to !sortA.size()
      !newLine = !positions[!sortA[!i - 1]].line(!positions[$!sortA[$!i]])
      -- Ignore lines of zero length
      skip if(!newLine.startPosition.distance(!newLine.endPosition) eq 0)
      if(!newLine.onProjected(!position)) then
        return !newLine
      endif
    enddo

  endif

  return !sectionLine

endmethod
-- End of method definition for .snapLine(DBREF, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Point vector to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Convert point vector into a line and use snap line method
  return !this.snap(!dbRef, !pointVector.line(1000mm), !intermediates)

endmethod
-- End of method definition for .snap(DBREF, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      LINE        Line to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Convert section into a line
  !sectionLine = !this.line(!dbRef)

  -- Intersection of lines
  !iPosition   = !sectionLine.intersection(!refLine)

  -- Consider intermediate snap points
  if(!intermediates) then
    -- Get the snap Line
    !snapLine    = !this.snapLine(!dbRef, !iPosition)
  else
    !snapLine    = !sectionLine
  endif

  -- Determine the nearest end
  if(!snapLine.startPosition.distance(!iPosition) le !snapLine.endPosition.distance(!iPosition)) then
    !nearPosition = !snapLine.startPosition
  else
    !nearPosition = !snapLine.endPosition
  endif

  -- Get intersection point on section line of reference line
  return !nearPosition.wrt(World)

endmethod
-- End of method definition for .snap(DBREF, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position of specified distance from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Distance
--    2   R      POINTVECTOR Point vector
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Distance position on line
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

   -- Convert point vector into a line and use snap line method
  return !this.distance(!dbRef, !distance, !pointVector.line(1000mm), !intermediates)

endmethod
-- End of method definition for .distance(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position of specified distance from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Distance
--    3   R      LINE        Line to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Distance position on line
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Convert section into a line
  !sectionLine = !this.line(!dbRef)

  -- Intersection of lines
  !iPosition   = !sectionLine.intersection(!refLine)

  -- Consider intermediate snap points
  if(!intermediates) then
    -- Get the snap Line
    !snapLine    = !this.snapLine(!dbRef, !iPosition)
  else
    !snapLine    = !sectionLine
  endif

  -- Determine the distance from end of line
  !gmfLine = object GMFLINE(!snapLine)

  return !gmfLine.distance(!distance, !iPosition)

endmethod
-- End of method definition for .distance(DBREF, REAL, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      proportion
--
-- Description: Return position of specified proportion from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Proportion
--    2   R      POINTVECTOR Point vector
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .proportion(!dbRef is DBREF, !proportion is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

   -- Convert point vector into a line and use snap line method
  return !this.proportion(!dbRef, !proportion, !pointVector.line(1000mm), !intermediates)

endmethod
-- End of method definition for .proportion(DBREF, REAL, POINTVECTOR, BOOLEAN) POSITION

------------------------------------------------------------------------
--
-- Method:      proportion
--
-- Description: Return position of specified proportion from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Proportion
--    3   R      LINE        Line to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .proportion(!dbRef is DBREF, !proportion is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  -- Convert section into a line
  !sectionLine = !this.line(!dbRef)

  -- Intersection of lines
  !iPosition   = !sectionLine.intersection(!refLine)

  -- Consider intermediate snap points
  if(!intermediates) then
    -- Get the snap Line
    !snapLine    = !this.snapLine(!dbRef, !iPosition)
  else
    !snapLine    = !sectionLine
  endif

  -- Define a gmfLine to calculate relative end
  !gmfLine = object GMFLINE(!snapLine)

  return !gmfLine.proportion(!proportion, !iPosition)

endmethod
-- End of method definition for .proportion(DBREF, REAL, LINE, BOOLEAN) POSITION

------------------------------------------------------------------------
