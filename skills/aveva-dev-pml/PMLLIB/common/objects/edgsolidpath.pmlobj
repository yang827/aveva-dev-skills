--
--
-- Description:
-- EDG handler for RPATH based elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  distance(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified distance from nearest end/snap to point vector on the section
--  distance(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified distance from nearest end/snap to point vector on the section
--  edgSolidPath()                   -
--  exact(DBREF,LINE)                POSITION            Return the intersection of the passed point vector with the section
--  exact(DBREF,POINTVECTOR)         POSITION            Return the intersection of the passed point vector with the section
--  fraction(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  fraction(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  line(DBREF)                      LINE                Return line definition of where  rpath only contains two POINTS
--  proportion(DBREF,REAL,LINE,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  proportion(DBREF,REAL,POINTVECTOR,BOOLEAN) POSITION            Return position of specified proportion from nearest end/snap to point vector on the section
--  routePath(DBREF)                 DBREF               Return route path of element
--  snap(DBREF,LINE,BOOLEAN)         POSITION            Return nearest snap point on line using a passed line
--  snap(DBREF,POINTVECTOR,BOOLEAN)  POSITION            Return nearest snap point on line using a passed point vector
--
------------------------------------------------------------------------

define object EDGSOLIDPATH

  -- Route Path as Polyline
  member .polyLine      is PMLPOLYLINE

  -- Segment Index into polyLine.segments list
  member .segmentIndex  is REAL

  -- Positions
  member .exactPosition is POSITION
  member .snapPosition  is POSITION

  -- Snap End
  member .snapEnd       is STRING

  -- Snap considerations
  member .openings      is BOOLEAN
  member .connections   is BOOLEAN

endobject
-- End of object definition for EDGGENSEC

------------------------------------------------------------------------
--
-- Method:      edgsolidpath
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgSolidPath()

  -- Initialise Variables
  !this.openings    = false
  !this.connections = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Point vector to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Initialise Variables
  !this.snapPosition = object POSITION()

  -- Get exact position
  !exactPosition    = !this.exact(!dbRef, !pointVector)
  if(!exactPosition.unset()) then
    return object POSITION()
  endif

  -- Get segment from polyline object
  !segment          = !this.polyLine.segments[!this.segmentIndex]

  -- At some point we need to consider the snapping to feature along the RPATH
  -- this would be done here, i.e. the initial segment of the polyline would be
  -- found, then we need to determine the features within that segment to determine
  -- which one we snap to.
  -- But due to time we are only considering the segments of the poly line.

  -- Determine end of segment to snap to
  -- Line segment
  if(!segment.objectType().eq('LINE')) then
    !line             = object GMFLINE(!segment)
    !this.snapEnd     = !line.end(!exactPosition)
    !position         = !segment.attribute(!this.snapEnd & 'Position')

  -- Arc segment
  elseif (!segment.objectType().eq('ARC')) then
    !arc              = object GMFARC(!segment)
    !this.snapEnd     = !arc.end(!exactPosition)
    !position         = !segment.anglePosition(!segment.attribute(!this.snapEnd & 'Angle'))
  endif

  -- Define snap position
  !this.snapPosition  = !position.wrt(World)

  -- Return position
  return !this.snapPosition

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return nearest snap point on line using a passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      LINE        Line to nearest to snap point
--    3   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Snap position on line
--
------------------------------------------------------------------------

define method .snap(!dbRef is DBREF, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  return !this.snap(!dbRef, !refLine.pointVector(), !intermediates)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position of specified distance from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Distance
--    2   R      POINTVECTOR Point vector
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Distance position on line
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Get exact position
  !position     = !this.exact(!dbRef, !pointVector)
  if(!position.unset()) then
    return object POSITION()
  endif

  -- Get segment from polyline object
  !segment      = !this.polyLine.segments[!this.segmentIndex]

  -- Get proportion along segment from nearest end
  -- Line segment
  if(!segment.objectType().eq('LINE')) then
    !gmfLine    = object GMFLINE(!segment)
    !position   = !gmfLine.distance(!distance, !position)

    -- Check that point is on the line, if its passed the end of the line then snap it
    -- back to the nearest end
    !length     = !segment.length()
    !distanceA  = !segment.startPosition.distance(!position)
    !distanceB  = !segment.endPosition.distance(!position)
    if(!distanceA.gt(!length).or(!distanceB.gt(!length))) then
      if(!distanceA.lt(!distanceB)) then
        !position = !segment.startPosition
      else
        !position = !segment.endPosition
      endif
    endif

  -- Arc segment
  elseif (!segment.objectType().eq('ARC')) then
    !gmfArc     = object GMFARC(!segment)
    !position   = !gmfArc.distance(!distance, !position)

  endif

  -- Define position
  !position = !position.wrt(World)

  -- Return position
  return !position

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Return position of specified distance from nearest end/snap to point vector on the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      REAL        Distance
--    3   R      LINE        Line to nearest to snap point
--    4   R      BOOLEAN     Intermediate snaps (considers elements within)
-- Return:
--   [Data Type] [Description]
--    POSITION    Distance position on line
--
------------------------------------------------------------------------

define method .distance(!dbRef is DBREF, !distance is REAL, !refLine is LINE, !intermediates is BOOLEAN) is POSITION

  return !this.distance(!dbRef, !distance, !refLine.pointVector(), !intermediates)

endmethod
-- End of method definition

