------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return the intersection of the passed point vector with the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !pointVector is POINTVECTOR) is POSITION

  -- Initialise Variables
  !this.exactPosition = object POSITION()
  !this.segmentIndex  = REAL()
  !intersect          = True


  -- find the point on the object we actually picked
  !intersectVector = !pointVector.intersections(!dbRef,True)[1]
  handle any
    !intersect     = False
  endhandle

  -- Get Polyline of RPATH
  !rPath = !this.routePath(!dbRef)
  if(!rPath.unset()) then
    return object POSITION()
  endif

  -- Get Poly Line of Rpath
  !this.polyLine      = object PMLPOLYLINE(!rPath)

  -- Determine the segment we have picked within
  if(!intersect) then
    !position           = !this.polyLine.near(!intersectVector.position)
  else
    !position           = !this.polyLine.near(!pointVector)
  endif

  !this.segmentIndex  = !this.polyLine.segment
  !this.exactPosition = !position.wrt(World)

  -- Return position
  return !this.exactPosition

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return the intersection of the passed point vector with the section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
--    2   R      LINE        Line
--
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !refLine is LINE) is POSITION

  return !this.exact(!dbRef, !refLine.pointVector())

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      routePath
--
-- Description: Return route path of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element owning RPATH
-- Return:
--   [Data Type] [Description]
--    DBREF       RPATH
--
------------------------------------------------------------------------

define method .routePath(!dbRef is DBREF) is DBREF

  -- Check if RPATH
  !types  = ARRAY()
  !types.append('RPATH')

  -- Loop through members
  do !i indices !dbRef.members
    !type   = !dbRef.members[!i].type
    !index  = !types.findFirst(!type)
    skip if(!index.unset())
    return !dbRef.members[!i]
  enddo

  -- Return
  return object DBREF()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return line definition of where  rpath only contains two POINTS
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section DBREF
-- Return:
--   [Data Type] [Description]
--    LINE        Line definition
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- Initialise Variables
  !line  = object LINE()

  -- Get Polyline of RPATH
  !rPath              = !this.routePath(!dbRef)
  if(!rPath.unset()) then
    return object POSITION()
  endif

  -- Get Poly Line of Rpath
  !this.polyLine      = object PMLPOLYLINE(!rPath)

  -- If there is more than one segment return line
  if(!this.polyLine.segments.size() gt 1) then
    return object LINE()
  endif

  !line = !this.polyLine.segments[1]
  handle any
    return object LINE()
  endhandle

  return !line

endmethod
-- End of method definition for .line(DBREF) LINE
