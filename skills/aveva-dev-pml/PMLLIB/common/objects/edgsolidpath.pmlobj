------------------------------------------------------------------------

define method .proportion(!dbRef is DBREF, !proportion is REAL, !pointVector is POINTVECTOR, !intermediates is BOOLEAN) is POSITION

  -- Get exact position
  !position     = !this.exact(!dbRef, !pointVector)
  if(!position.unset()) then
    return object POSITION()
  endif

  -- Get segment from polyline object
  !segment      = !this.polyLine.segments[!this.segmentIndex]

  -- Get proportion along segment from nearest end
  -- Line segment
  if(!segment.objectType().eq('LINE')) then
    !gmfLine    = object GMFLINE(!segment)
    !position   = !gmfLine.proportion(!proportion, !position)

    -- Check that point is on the line, if its passed the end of the line then snap it
    -- back to the nearest end
    !length     = !segment.length()
    !distanceA  = !segment.startPosition.distance(!position)
    !distanceB  = !segment.endPosition.distance(!position)
    if(!distanceA.gt(!length).or(!distanceB.gt(!length))) then
      if(!distanceA.lt(!distanceB)) then
        !position = !segment.startPosition
      else
        !position = !segment.endPosition
      endif
    endif

  -- Arc segment
  elseif (!segment.objectType().eq('ARC')) then
    !gmfArc     = object GMFARC(!segment)
    !position   = !gmfArc.proportion(!proportion, !position)
  endif

  -- Define position
  !position = !position.wrt(World)

  -- Return position
  return !position

endmethod
