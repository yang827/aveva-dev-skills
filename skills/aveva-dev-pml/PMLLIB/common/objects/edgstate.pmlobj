--
--
-- Description:
-- Current edg packet status.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Action commands
--  appendReturn(ANY)                -                   Append information to return member
--  clearReturn()                    -                   Clear all information from return member
--  edgState()                       -                   Constructor
--  errorCatch()                     -                   Output debug data for action error handle if !!edgDebug
--  getReturn()                      ARRAY               Get all information from return member
--  isPositionMode()                 BOOLEAN             Check if current pickType is in a positioning mode.
--  mdsErrorCatch()                  BOOLEAN             Special code for MDS - must be removed here.
--  primaryPrompt(STRING)            -                   Set primary prompt of packet in state
--  prompt()                         STRING              Build prompt string
--  reinstatePacket(EDGSTATE)        -                   Reinstate current packet of information
--  secondaryPrompt(STRING)          -                   Set secondary prompt of packet in state
--  setOldPacket(EDGPACKET)          -                   Setup state with passed packet
--  setPacket(EDGPACKET)             -                   Setup state with "new" passed packet
--  setPick(EDGPICK)                 -                   Replace pick with new one
--  setPickPacket(EDGPICKPACKET)     -                   Replace pick type with new one
--  setPickType(EDGPICKTYPE)         -                   Replace pick type with new one
--  tagPrompt()                      STRING              Build tag prompt (i.e. without the pick prompt portion)
--  updatePrompt()                   -                   Re-apply current prompt to all active views
--
------------------------------------------------------------------------

-- Define object
define object EDGSTATE

  -- Current Packet in its natural state (should not be used)
  member .packet      is EDGPACKET
  member .packetForm  is FORM

  -- Current Pick Packet
  member .pickPacket  is EDGPICKPACKET

  -- Current Major Picks
  member .majorPicks  is ARRAY

  -- Major pick index
  member .major       is REAL

  -- Current Pick type
  member .pickType    is EDGPICKTYPE
  member .pickForm    is FORM

  -- Minor pick index
  member .minor       is REAL

  -- Current Pick
  member .pick        is EDGPICK

  -- Return data from picks and packets
  member .return      is ARRAY

  -- Cache all pick forms used
  member .formCache      is ARRAY

  -- Positioning (has positioning pick type been used
  member .positioning is BOOLEAN

endobject
-- End of object definition for EDGSTATE

------------------------------------------------------------------------
--
-- Method:      edgState
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgState()

  -- Initialise Variables
  !this.positioning = FALSE

endmethod
-- End of method definition for .edgState()

------------------------------------------------------------------------
--
-- Method:      setPacket
--
-- Description: Setup state with "new" passed packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPacket(!workPacket is EDGPACKET)

  -- Current Packet
  !this.packet      = !workPacket
  !this.packet.return.clear()

  -- Get Aid number for packet
  if(!workPacket.aidNumber.unset()) then
    !this.packet.aidNumber = !!aidNumbers.add(!this.packet.description)
  else
    AID CLEAR TEXT $!this.packet.aidNumber
    handle ANY
    endhandle
  endif

  -- Initialise the packet (only run when added to system)
  !this.packet.initialise()

  -- Show any form for controlling packet (this doesn't work if there is
  -- another form being shown for the packet (i.e. in a pickType).
  -- You must make sure function show the form first.
  !this.packetForm = !this.packet.showForm()

  -- Set pick packer
  !this.setPickPacket(!this.packet.pickPacket)

endmethod
-- End of method definition for .setPacket(EDGPACKET)

------------------------------------------------------------------------
--
-- Method:      setOldPacket
--
-- Description: Setup state with passed packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOldPacket(!workPacket is EDGPACKET)

  -- Current Packet
  !this.packet      = !workPacket
  !this.packet.return.clear()

  -- Get Aid number for packet
  if(!workPacket.aidNumber.unset()) then
    !this.packet.aidNumber = !!aidNumbers.add(!this.packet.description)
  else
    AID CLEAR TEXT $!this.packet.aidNumber
    handle ANY
    endhandle
  endif

  -- Show any form for controlling packet (this doesn't work if there is
  -- another form being shown for the packet (i.e. in a pickType).
  -- You must make sure function show the form first.
  !this.packetForm = !this.packet.showForm()

  -- Set pick packer
  !this.setPickPacket(!this.packet.pickPacket)

endmethod
-- End of method definition for .setOldPacket(EDGPACKET)

------------------------------------------------------------------------
--
-- Method:      setPickPacket
--
-- Description: Replace pick type with new one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKPACKET  Pick packet to replace current one
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPickPacket(!newPickPacket is EDGPICKPACKET)

  -- Current Pick Packet
  !this.pickPacket  = !newPickPacket
  !this.pickPacket.return.clear()

  -- Current Major Picks
  !this.majorPicks  = !this.pickPacket.picks

  -- Initialise major pick index
  !this.major       = 1

  -- Special handle for positioning pick
  if(!this.majorPicks[!this.major].positioning) then
    !this.setPickType(!!edgPosCntrl.pickType)
  else
    !this.setPickType(!this.majorPicks[!this.major])
  endif

endmethod
-- End of method definition for .setPickPacket(EDGPICKPACKET)
------------------------------------------------------------------------
--
-- Method:      setPickType
--
-- Description: Replace pick type with new one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKTYPE  Pick type to replace current one
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPickType(!newPickType is EDGPICKTYPE)

  -- If previous pickType had a form associated with it, and it is
  -- different from the current, then make it in-active
  if(!this.pickType.form.set()) then
    if(!this.pickType.form ne !newPickType.form) then
      !this.pickType.form.setActive(FALSE)
    endif
  endif

  -- Set Pick type
  !this.pickType        = !newPickType
  !this.pickType.return.clear()

  -- Set the prompt to the original
  !this.pickType.prompt = !this.packet.pickPacket.picks[!this.major].prompt

  -- Show any form for controlling pick type
  !this.pickForm        = !this.pickType.showForm()

  -- Check if the pick type was a positioning pick
  !this.positioning     = !this.positioning.or(!this.pickType.positioning)

  -- Add the pick form to a cache
  if (!this.pickForm.set()) then
    !this.formCache.append( !this.pickForm)
  endif

  -- Set minor incremental counter
  !this.minor         = 1

  -- Special handle for positioning pick
  if(!this.pickType.positioning) then
    !this.setPick(!!edgPosCntrl.pick)
  else
    !this.setPick(!this.pickType.pick)
  endif

endmethod
-- End of method definition for .setPickType(EDGPICKTYPE)

------------------------------------------------------------------------
--
-- Method:      setPick
--
-- Description: Replace pick with new one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICK     Pick to replace current one
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPick(!newPick is EDGPICK)

  -- Initialise Variables
  !this.pick = !newPick

  -- Make pick active
  !this.pick.applyToViews(!this.prompt())

endmethod
-- End of method definition for .setPick(EDGPICK)

------------------------------------------------------------------------
--
-- Method:      prompt
--
-- Description: Build prompt string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Prompt string
--
------------------------------------------------------------------------

define method .prompt() is STRING

  -- Initialise Variables
  !returnString = ''
  -- Get all prompts
  if(!this.pickPacket.prompt.set()) then
    !returnString = !returnString & ' ' & !this.pickPacket.prompt
  endif

  if(!this.pickType.prompt.set()) then
    !returnString = !returnString & ' ' & !this.pickType.prompt
  endif

  if(!this.pick.prompt.set()) then
    !returnString = !returnString & ' (' & !this.pick.prompt & ')'
  endif

  !stringArray[1] = STRING()
  !block          = object BLOCK('''$!<returnString>''')
  !stringArray    = !stringArray.evaluate(!block)

  -- Special case handler for positioning prompts
  if(!this.isPositionMode()) then
    if(!!edgPosCntrl.activePlane) then
      !stringArray[1] = !stringArray[1] & ' WP '
    endif

    if(!!edgPosCntrl.offsetType ne 'NONE') then
      !stringArray[1] = !stringArray[1] & ' Offset'
    endif

    if(!!edgPosCntrl.intermediate) then
      !stringArray[1] = !stringArray[1] & ' Snap'
    endif

  endif

  return !stringArray[1].trim()

endmethod
-- End of method definition for .prompt() STRING

------------------------------------------------------------------------
--
-- Method:      updatePrompt
--
-- Description: Re-apply current prompt to all active views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatePrompt()

  -- Make pick active
  !this.pick.applyToViews(!this.prompt())

endmethod
-- End of method definition for .updatePrompt()

------------------------------------------------------------------------
--
-- Method:      tagPrompt
--
-- Description: Build tag prompt (i.e. without the pick prompt portion)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Prompt string
--
------------------------------------------------------------------------

define method .tagPrompt() is STRING

  -- Initialise Variables
  !returnString = ''

  -- Get all prompts
  if(!this.pickPacket.prompt.set()) then
    !returnString = !returnString & ' ' & !this.pickPacket.prompt
  endif

  if(!this.pickType.prompt.set()) then
    !returnString = !returnString & ' ' & !this.pickType.prompt
  endif

  return !returnString.trim()

endmethod
-- End of method definition for .tagPrompt() STRING

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description: Action commands
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  --   -- Special case navigate (by pass all other functionality
  --   if(!this.packet.navigate) then
  --     !this.packet.return.append(!!edgCntrl.pickData)
  --     !this.packet.runAction()
  --     handle any
  --     endhandle
  --
  --     -- Remove packet from system and retrieve last action
  --     if(!this.packet.remove) then
  --       !!edgCntrl.remove(!this.packet.description)
  --
  --     -- Reinstate packet
  --     else
  --       !this.setOldPacket(!this.packet)
  --     endif
  --     return
  --
  --   endif

  -- Execute pick action if it has one
  !pickData = !this.pick.runAction()
  handle ANY
    !this.errorCatch()
    --!!messageFile.warning(146 ,8 ,!this.pick.action ,!!error.text)
    return
  elsehandle NONE

    -- Add pickData to return stack for pickType
    !this.pickType.return.append(!pickData)

    -- Is there another pick
    if(!this.minor lt !this.pickType.numberOfPicks) then

      -- Increment minor pick
      !this.minor = !this.minor + 1
      return

      -- Move to next major pick
    else

      -- Execute pickType action if there is one
      !oldPickCount = !this.pickType.numberOfPicks
      !pickTypeDate = !this.pickType.runAction()
      handle ANY
        !this.errorCatch()
        --!!messageFile.warning(146 ,8 ,!this.pickType.action ,!!error.text)
        return
      elsehandle NONE
        -- If the number of "picks" required have changed, then we don't continue
        if(!this.pickType.numberOfPicks gt !oldPickCount) then
          -- Reapply the prompt
          !this.minor = !this.minor + 1
          !this.pick.applyPrompt(!this.prompt())
          return
        endif

        -- Add pickTypeDate to return stack for pickPacket
        !this.pickPacket.return.append(!pickTypeDate)

        -- Is there another major pick (pickType)
        if(!this.major lt !this.majorPicks.size()) then

          -- If there is a position in element one, then tag it with the
          -- current prompt
          if(defined(!this.pickPacket.return[!this.pickPacket.return.size()].position)) then
            if(!this.pickPacket.return[!this.pickPacket.return.size()].position.set()) then
              !prompt   = !this.tagPrompt()
              !position = !this.pickPacket.return[!this.pickPacket.return.size()].position
              AID TEXT NUMBER $!<this.packet.aidNumber> '$!prompt' AT $!position
            endif
          endif

          -- Increment major pick
          !this.major = !this.major + 1

          -- Special handle for positioning pick
          if(!this.majorPicks[!this.major].positioning) then
            !this.setPickType(!!edgPosCntrl.pickType)
          else
            !this.setPickType(!this.majorPicks[!this.major])
          endif

          -- All major pick are complete
        else
          -- Is there an action for the edg pick packet
          ---- Pick Packet Action $!this.pickPacket.action
          !pickPacketData = !this.pickPacket.runAction()
          handle ANY
            !this.errorCatch()
            --!!messageFile.warning(146 ,8 ,!this.pickPacket.action ,!!error.text)
            if( !!error.text.subString(1,4) eq 'EDG:' ) then
              -- Report error direct to user
              !message1 = ''
              !message2 = !!error.text.after(':')
            else
              !message1 = !this.pickPacket.action
              !message2 = !!error.text
            endif
            -- Remove packet from system and retrieve last action
            if(!this.packet.remove) then
              !!messageFile.warning(146 ,8 ,!message1 & ' (Removed)'  ,!message2)
              !!edgCntrl.remove(!this.packet.description)

              -- Reinstate packet from the beginning
            else
              !!messageFile.warning(146 ,8 ,!message1 & ' (Reinstated)'  ,!message2)
              !this.setOldPacket(!this.packet)
            endif

            return

          elsehandle NONE

            -- Add packetData to return stack for pickPacket
            !this.packet.return.append(!pickPacketData)

            -- is there an action for the edg packet
            ---- Packet Action $!this.packet.action
            !this.packet.runAction()
            handle ANY
              !this.errorCatch()
              -- Remove packet from system and retrieve last action
              if(!this.packet.remove) then
                !!messageFile.warning(146 ,8 ,!this.packet.action & ' (Removed)' ,!!error.text)
                !!edgCntrl.remove(!this.packet.description)

                -- Reinstate packet from the beginning
              else
                !!messageFile.warning(146 ,8 ,!this.packet.action & ' (Reinstated)' ,!!error.text)
                !this.setOldPacket(!this.packet)
              endif

              return
            endhandle

            -- Remove packet from system and retrieve last action
            if(!this.packet.remove) then
              !!edgCntrl.remove(!this.packet.description)

              -- Reinstate packet
            else
              !this.setOldPacket(!this.packet)
            endif
          endhandle
        endif
      endhandle
    endif
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      appendReturn
--
-- Description: Append information to return member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Data to be appended to return member
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .appendReturn(!data is ANY)

  !this.return.append(!data)

endmethod
-- End of method definition for .appendReturn(ANY)

------------------------------------------------------------------------
--
-- Method:      clearReturn
--
-- Description: Clear all information from return member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearReturn()

  !this.return.clear()

endmethod
-- End of method definition for .clearReturn()

------------------------------------------------------------------------
--
-- Method:      getReturn
--
-- Description: Get all information from return member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       All return data
--
------------------------------------------------------------------------

define method .getReturn() is ARRAY

  return !this.return

endmethod
-- End of method definition for .getReturn() ARRAY

------------------------------------------------------------------------
--
-- Method:      reinstatePacket
--
-- Description: Reinstate current packet of information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       All return data
--
------------------------------------------------------------------------

define method .reinstatePacket(!oldState is EDGSTATE)

  -- Set this to the passed old state
  !this = !oldState

  -- Activate form for the packet
  if(!this.packetForm.set()) then
    !this.packetForm.setActive(TRUE)
  endif

  -- Activate form for pick
  if(!this.pickForm.set()) then
    !this.pickForm.setActive(TRUE)
    if(!this.isPositionMode()) then
      !!edgEPosition.setActive(TRUE)
    endif
  endif

  -- Re-apply pick type
  !this.setPickType(!this.pickType)

endmethod
-- End of method definition for .reinstatePacket(EDGSTATE)

------------------------------------------------------------------------
--
-- Method:      isPositionMode
--
-- Description: Check if current pickType is in a positioning mode.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if we are in a position mode
--
------------------------------------------------------------------------

define method .isPositionMode() is BOOLEAN

  -- Make pick active
  if(!this.pickType.positioning) then
    return TRUE
  else
    return FALSE
  endif

endmethod
-- End of method definition for .isPositionMode() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      primaryPrompt
--
-- Description: Set primary prompt of packet in state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Primary prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .primaryPrompt(!prompt is STRING)

  -- Update primary prompts
  if(!prompt.set()) then
    !this.pickPacket.prompt        = !prompt
    !this.packet.pickPacket.prompt = !prompt
  endif

endmethod
-- End of method definition for .primaryPrompt(STRING)

------------------------------------------------------------------------
--
-- Method:      secondaryPrompt
--
-- Description: Set secondary prompt of packet in state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Secondary prompt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .secondaryPrompt(!prompt is STRING)

  -- Update primary prompts
  if(!prompt.set()) then
    !this.pickType.prompt        = !prompt
  endif

endmethod
-- End of method definition for .secondaryPrompt(STRING)

------------------------------------------------------------------------
--
-- Method:      errorCatch
--
-- Description: Output debug data for action error handle if !!edgDebug
--              variable set to TRUE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .errorCatch()

  -- output error data if !!edgDebug variable set
  if( defined(!!edgDebug) ) then
    if( !!edgDebug ) then
      !errorText      = !!error.text
      !errorLine      = !!error.line
      !errorCommand   = !!error.command
      !errorCallStack = !!error.callStack
    endif
  endif

  ---------------------------------------------------------
  -- Special code for MDS - must be removed from of here.
  !mdsHandledError = !this.mdsErrorCatch()
  handle any
    !mdsHandledError = false
  endhandle
  if( !mdsHandledError ) then
    return
  endif
  ---------------------------------------------------------

  -- output error data if !!edgDebug variable set
  if( defined(!!edgDebug) ) then
    if( !!edgDebug ) then
      QUERY VAR !errorText
      QUERY VAR !errorLine
      QUERY VAR !errorCommand
      QUERY VAR !errorCallStack
    endif
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      mdsErrorCatch
--
-- Description: Special code for MDS - must be removed here.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if MDS has handled the error
--
------------------------------------------------------------------------

define method .mdsErrorCatch() is BOOLEAN

  -- Called only if MDS Alignment Utility is being used.
  if( defined(!!kgphalign) ) then
    if (!!edgCntrl.state.packetForm.eq(!!kgphalign)) then
      !message     = !!error.text &  '. EDG action failed.' & ' ' & 'Re-Initialising the Alignment Utility. Please select the SCTN Pline in another VIEW direction.'
      !!alert.warning(!message)
      !alignString      = !!mdsalign.applyform[1].after('(').before(')')
      !form        = $!alignString
      -- Re-Initialise the Alignment Utility
      !!kactioncommands(!!mdsalign.dismissform)
      !!mdsxalign(!form)
      return true
    endif
  endif
  return false

endmethod
-- End of method
