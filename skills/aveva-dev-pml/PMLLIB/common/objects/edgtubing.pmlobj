------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return the intersection of the passed point vector with the tube
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Branch/Component DBREF
--    2   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    POSITION    position on line
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !pointVector is POINTVECTOR) is POSITION

  -- Convert point vector into a line and use snap line method
  return !this.exact(!dbRef, !pointVector.line(1000mm))

endmethod
-- End of method definition for .exact(DBREF, POINTVECTOR) POSITION

------------------------------------------------------------------------
--
-- Method:      exact
--
-- Description: Return the intersection of the passed line with the tube
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Branch/Component DBREF
--    2   R      LINE        Line
-- Return:
--   [Data Type] [Description]
--    POSITION    position on line
--
------------------------------------------------------------------------

define method .exact(!dbRef is DBREF, !refLine is LINE) is POSITION

  -- Tube
  !tubeLine = !this.line(!dbRef)

  -- Intersection of lines
  !iPosition   = !tubeLine.intersection(!refLine)
  handle any
    -- handle zero length or parallel line
    !iPosition = !tubeLine.startPosition
  endhandle

  -- Intersection of lines
  return !iPosition

endmethod
-- End of method definition for .exact(DBREF, LINE) POSITION

-----------------------------------------------------------------------
--
-- Method: pointVector
--
-- Description returns a vector representing either the arrive or
-- leave directions of the passed element
-----------------------------------------------------------------------
define method .pointVector(!dbRef is DBREF,!flow is BOOLEAN ) is POINTVECTOR

  -- Initialise Variables

  -- If branch passed, used HEAD tube vector
  if(!dbRef.type eq 'BRAN') then
    if !flow then
      return !this.pointVector(!dbRef, 'HEAD')
    else
      return !this.pointVector(!dbRef, 'TAIL')
    endif
  -- Return leave tube vector of component
  else
    if !flow then
      return !this.pointVector(!dbRef, 'LEAVE')
    else
      return !this.pointVector(!dbRef, 'ARRIVE')
    endif
  endif

endmethod
-- End of method definition for .pointVector(DBREF) LINE

------------------------------------------------------------------------
--
-- Method:      pointVector
--
-- Description: Return the arrive/leave as a pointVector
--
------------------------------------------------------------------------

define method .pointVector(!dbRef is DBREF, !end is STRING) is POINTVECTOR

  -- Initialise Variables
  !pointVector = object POINTVECTOR()

  -- Head type identified
  if(!end.upcase() eq 'HEAD') then
    !pointVector.position = !dbRef.hPosition.wrt(World)
    !pointVector.direction   = !dbRef.hDirection.wrt(World)
  elseif (!end.upcase() eq 'TAIL') then
    !pointVector.position = !dbRef.tPosition.wrt(World)
    !pointVector.direction   = !dbRef.tDirection.wrt(World)
  elseif (!end.upcase() eq 'ARRIVE') then
    !pointVector.position = !dbRef.aPosition.wrt(World)
    !pointVector.direction   = !dbRef.aDirection.wrt(World)
  -- Leave tube identified
  else
    !pointVector.position = !dbRef.lPosition.wrt(World)
    !pointVector.direction   = !dbRef.lDirection.wrt(World)
  endif

  -- Return a pointvector object
  return !pointVector

endmethod
-- End of method definition for .line(DBREF, STRING) LINE
-----------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Return the intersection of the tube with the passed position
--
--
------------------------------------------------------------------------

define method .through(!dbRef is DBREF, !throughPosition is POSITION, !flow is BOOLEAN )is POSITION

  !lineVector = !this.pointVector(!dbRef,!flow)
  -- Intersection of lines
  !iPosition   = !lineVector.through(!throughPosition)
  handle any
    -- handle zero length or parallel line
    !iPosition = !lineVector
  endhandle

  -- Intersection of lines
  return !iPosition.position

endmethod
-- End of method definition for .exact(DBREF, LINE) POSITION
