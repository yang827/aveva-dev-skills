--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  globalInstance()                 -
--
------------------------------------------------------------------------

-- Define object
define object EDGTYPES

  -- Database Element Types

  -- Piping Components
    -- Elbow
    member .elbow       is EDGELBOW
    -- Bend
    member .bend        is EDGBEND
    -- Nozzle
    member .nozzle      is EDGNOZZLE

  -- Primitives
    -- Cylinder
    member .cylinder    is EDGCYLINDER
    member .ncylinder   is EDGCYLINDER
    member .slcylinder  is EDGCYLINDER
    member .nslcylinder is EDGCYLINDER

    -- Rectangular Torus
    member .rtorus      is EDGRTORUS
    member .nrtorus     is EDGRTORUS
    -- Circular Torus
    member .ctorus      is EDGCTORUS
    member .nctorus     is EDGCTORUS
    -- Dish
    member .dish        is EDGDISH
    member .ndish       is EDGDISH

    -- Cone
    member .cone        is EDGSNOUT
    member .ncone       is EDGSNOUT

    -- Cone
    member .snout       is EDGSNOUT
    member .nsnout      is EDGSNOUT

    -- Pyramid
    member .pyramid     is EDGPYRAMID
    member .npyramid    is EDGPYRAMID


    -- Extrusions
--     member .nxtrusion   is EDGEXTRUSION
--     member .extrusion   is EDGEXTRUSION
--     member .nrevolution is EDGEXTRUSION
--     member .revolution  is EDGEXTRUSION
    member .flrcov      is EDGEXTRUSION
    member .flrlay      is EDGEXTRUSION
    member .insurq      is EDGEXTRUSION
    member .aextrusion  is EDGEXTRUSION

  -- Structural Elements
    -- Section
    member .sctn        is EDGSCTN
    member .stwall      is EDGSCTN
    member .gensec      is EDGGENSEC
    member .wall        is EDGGENSEC

    -- Panels
    member .panel       is EDGPANEL
    member .floor       is EDGPANEL
    member .screed      is EDGPANEL

    -- Route path based elements
    member .ctwall      is EDGSOLIDPATH
    member .handra      is EDGRPATH
    member .cwbran      is EDGSOLIDPATH

  -- Element Components
    -- Plines
    member .pLine       is EDGPLINE
    -- Ppoints
    member .pPoint      is EDGPPOINT
    -- Tubing
    member .tubing      is EDGTUBING

  -- HULL -----------------------------
    -- Hull stiffener
    member .hstiff      is EDGHLINEARPROFILE
    -- Hull pillar
    member .hpillr      is EDGHLINEARPROFILE
    -- Hull Plate
    member .hplate      is EDGHPLANARCONTOUR
    -- Hull Doubling Plate
    member .hdopla      is EDGHPLANARCONTOUR
    -- hull Panel
    member .hpanel      is EDGHPLANARCONTOUR
    -- hull Bracket
    member .hbrckt      is EDGHPLANARCONTOUR
    -- hull RSO face
    member .hrsof       is EDGHPLANARCONTOUR


endobject
-- End of object definition for EDGTYPES

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!edgTypes    = !this

  -- Force constructs
--   !!edgTypes.sctn.edgSctn()
