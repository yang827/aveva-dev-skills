--
-- Description:
-- Attribute Rule definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToRulePasteBuffer()           -                   Copy this object to the global rule paste buffer
--  clear()                          -                   Load details of given attribute
--  copyRulesTo(DBREF)               BOOLEAN             Write these rules the given element
--  elementRules()                   -                   Constructor
--  elementRules(DBREF)              -                   Constructor
--  getRule(DBREF,STRING)            ATTRIBUTERULE       Get rule for selected attribute from selected element
--  getRules(DBREF)                  -                   Load rules of given element
--  hasRules()                       DBREF               True if object has any attribute rules (even if not set)
--

define object ELEMENTRULES

  -- Element
  member .element        is DBREF
  -- Array of ATTRIBUTERULE objects - one for each attribute that can have a rule
  member .attributeRules is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      elementRules
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .elementRules()

  -- Initialise Variables
  !this.clear()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      elementRules(DBREF)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .elementRules(!element is DBREF)

  -- Initialise Variables
  !this.getRules(!element)

endmethod
-- End of function definition
------------------------------------------------------------------------
--
-- Method:      getRules
--
-- Description: Load rules of given element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRules(!element is DBREF)

  -- Initialise Variables
  !this.clear()
  if( badref(!element) ) then
    return
  endif

  -- Member
  !this.element       = !element

    -- Get attributes
  !attributeList = !element.attributes()
  -- If there is a POS attribute, then handle EASTING, NORTHING and UPPING rules
  !posIndex = !attributeList.findFirst('Position')
  if( !posIndex.set() ) then
    !temp[1] = 'Easting'
    !temp[2] = 'Northing'
    !temp[3] = 'Upping'
    !attributeList.insertArray(!posIndex,!temp)
  endif

  -- Loop through attributes to find those with rules
  do !attribute values !attributeList
    !attrib     = !attribute.upcase()

    -- Exclusions - using attribute name
    skip if(!attrib inset('MEMBERS','ORRF','INVFARRAY','QUAN','NAMETY','PRIMTY','CRINFO'))
    -- Get ATTDEF object containing attribute definition details
    !attributeDefinition = object ATTRIBUTERULE()
    !attributeDefinition = !this.getRule(!element, !attrib)
    if( !attributeDefinition.canHaveRule ) then
      -- attribute that can have a rule gets an entry in the table
      !this.attributeRules.append(!attributeDefinition)
    endif

  enddo

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getRule
--
-- Description: Get rule for selected attribute from selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element reference
--    2   R      STRING      Attribute name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getRule(!element is DBREF, !attribute is STRING) is ATTRIBUTERULE

  -- Initialise variables
  -- Get definition of attribute
  !return = object ATTRIBUTERULE()
  !return.getRule(!element, !attribute.upcase().trim())

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      hasRules
--
-- Description: True if object has any attribute rules (even if not set)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       True if this object has any rules (even if not set)
--
------------------------------------------------------------------------

define method .hasRules() is DBREF

  return !this.attributeRules.empty()

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      copyRulesTo
--
-- Description: Write these rules the given element
-- Only rules for attributes common to the target element and
-- this object will be written
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element used as target for rules
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if at least 1 rule written - false otherwise
--
------------------------------------------------------------------------

define method .copyRulesTo(!element is DBREF) is BOOLEAN

  !changedRules = false

  if( badref(!element) )then
    return false
  endif

  -- For each attribute, try to force the equivalent attribute on another
  -- element to have the same rule
  -- If the rule cannot be set it is simply ignored
  do !rule values !this.attributeRules

    !changed = !rule.copyRuleTo(!element)
    if( !changed ) then
      !changedRules = true
    endif

  enddo

  return !changedRules

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addToRulePasteBuffer
--
-- Description: Copy this object to the global rule paste buffer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToRulePasteBuffer()

  -- Copy this object to the global rule paste buffer
  !!globalRulePasteBuffer = !this

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Load details of given attribute
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Element
  !this.element       = object DBREF()
  -- Array of attribute rules
  !this.attributeRules = object ARRAY()

endmethod
-- End of function definition
