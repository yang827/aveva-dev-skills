--
-- File:            elementstore.pmlobj
--   Type:          Object Definition
--   Group:         Any
--     Keyword:     Element Store Tables
--   Module:        All
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Fri May 18 11:00:00 GMT 2007
--
-- Description:
--    Object for holding default storage areas for an application.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   Clears storage areas (leave all other settings)
--  collection(COLLECTION)           -                   Define collection used to get possible storage areas
--  collection(COLLECTION,DBREF)     -                   Define collection used to get possible storage areas
--  elementStore()                   -                   Constructor
--  elementStore(STRING)             -                   Constructor
--  elementStore(STRING,STRING,STRING) -                   Constructor
--  elements()                       ARRAY               Return list of possible store elements derived from collection
--  evaluate()                       BOOLEAN             Evaluate collection object with current scope
--  evaluate(DBREF)                  BOOLEAN             Evaluate collection object with passed element
--  expression(EXPRESSION)           -                   Set expression to check against
--  isValidType(DBREF)               BOOLEAN             Check if passed element is of valid type
--  navigate()                       BOOLEAN             Navigate to current storage area
--  rule(BLOCK)                      -                   Set rule to check against
--  store()                          DBREF               Return current store
--  store(DBREF)                     BOOLEAN             Sets passed element as the storage area
--  store(DBREF,BOOLEAN)             BOOLEAN             Sets passed element as the storage area
--  testRule(DBREF)                  BOOLEAN             Test Rule
--  types(ARRAY)                     -                   Sets permissible types for store
--
------------------------------------------------------------------------

define object ELEMENTSTORE

  -- Name of Table
  member .name            is STRING

  -- Description
  member .description     is STRING

  -- Key of storage, used to identify the store
  member .key             is STRING

  -- Storage Element
  member .element         is DBREF

  -- Settable store (collection are not settable)
  member .settable        is BOOLEAN

  -- Permissible type of elements allowed to be used as a store
  member .types           is ARRAY

  -- Rule/expression to derive storage area (where store is based on a rule
  -- or expression rather then just a specific element)
  member .rule            is BLOCK
  member .expression      is EXPRESSION

  -- Collection object for searching for possible
  member .collection      is COLLECTION

  -- Scope of collection
  member .scope           is DBREF

  -- List of elements conforming to rule
  member .elements        is ARRAY

  -- Automatically check if parent of element passed elements is a valid store
  member .checkParent     is BOOLEAN

  -- Check if rule/expression is validated against
  member .checkRule       is BOOLEAN
  member .checkExpression is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      elementStore
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementStore()

  -- Default settable, collection stores are not settable
  !this.settable        = true

  -- Assume we always check parent type to see if it is valid
  !this.checkParent     = true

  -- Rule/Expression should only be check if a rule has been set
  !this.checkRule       = false
  !this.checkExpression = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      elementStore
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store Key
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementStore(!key is STRING)

  -- Initialise Variables
  !this.elementStore()

  -- Set Key
  !this.key    = !key.upcase()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Clears storage areas (leave all other settings)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()

  -- Initialise Variables
  !this.element = object DBREF()
  !this.elements.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Navigate to current storage area
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .navigate() is BOOLEAN

  -- Navigate to element
  !!ce = !this.element
  handle ANY
    return false
  endhandle

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      testRule
--
-- Description: Test Rule
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testRule(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  write 'Test Rule'

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      elementStore
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      STRING      Name for storage area
--    3   R      STRING      Description for storage area
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementStore(!key is STRING, !name is STRING, !description is STRING)

  -- Initialise Variables
  !this.elementStore()

  -- Set Key
  !this.key         = !key.upcase()
  !this.name        = !name
  !this.description = !description

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isValidType
--
-- Description: Check if passed element is of valid type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid
--
------------------------------------------------------------------------

define method .isValidType(!element is DBREF) is BOOLEAN

  -- Initialise
  !valid      = false

  -- Handle empty list (no specific type)
  !valid      = !this.types.empty().or(!this.types.findFirst(!element.hardtype).set().or(!this.types.findFirst(!element.type).set()).or(!this.types.findFirst(!element.fulltype).set()))

  -- If valid and a rule/expression if required
  if(!valid.and(!this.checkRule.or(!this.checkExpression))) then

    -- Check rule against element
    if(!this.checkRule) then
      !valid    = !this.rule.evaluate()
      handle ANY
        !valid  = false
      endhandle

    -- Check expression against element
    elseif (!this.checkExpression) then
      !valid    = !this.expression.evaluate(!element)
      handle ANY
        !valid  = false
      endhandle
    endif

    -- Handle unset "valid"
    if(!valid.unset()) then
      !valid    = false
    endif
  endif

  -- See if element is in the list, by hardtype, type or fulltyp
  return !valid

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      store
--
-- Description: Return current store
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Element used as store area
--
------------------------------------------------------------------------

define method .store() is DBREF
  return !this.element
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      store
--
-- Description: Sets passed element as the storage area
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF  Element used as store area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if set
--
------------------------------------------------------------------------

define method .store(!element is DBREF) is BOOLEAN
  return !this.store(!element, !this.checkParent)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      store
--
-- Description: Sets passed element as the storage area
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element used as store area
--    2   R      BOOLEAN     True if we should check parent
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if set
--
------------------------------------------------------------------------

define method .store(!element is DBREF, !parent is BOOLEAN) is BOOLEAN

  -- Check object is settable
  if(!this.settable.not()) then
    !!error.text    = 'Object is a "collection" type store, it is not settable by passing an element.'
    return false
  endif

  -- Initialise Variables
  !store            = !element
  !valid            = false

  -- Check element type is a valid type (if .types is set)
  if(!this.isValidType(!store).not()) then

    -- Check only if passed element is valid
    if(!parent.not()) then
      !!error.text  = 'Element (' & !store.namn & ') is of wrong type.'
      return false

    -- Check if element or one of its parents is valid
    else

      -- Get owning parents
      !owners         = !element.ownLst
      !owners.invert()
      !owningTypes    = !element.ahList
      !owningTypes.invert()

      -- Loop through owning types if relevant
      do !i indices !owners
        if(!this.isValidType(!owners[!i])) then
          !store      = !owners[!i]
          !valid      = true
          break
        endif
      enddo

      -- If no owner has been found, then return with error
      if(!valid.not()) then
        !!error.text  = 'Element (' & !store.namn & ') or any of its parents are not valid storage area elements.'
        return false
      endif
    endif
  endif

  -- Set store
  !this.element   = !store

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      types
--
-- Description: Sets permissible types for store
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of element types
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .types(!types is ARRAY)

  -- Initialise Variables
  !this.types.clear()

  -- Force all types to uppercase
  do !i indices !types
    !this.types.append(!types[!i].upcase())
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rule
--
-- Description: Set rule to check against
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BLOCK       Rule to execute on test
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rule(!rule is BLOCK)
  !this.rule            = !rule
  !this.checkExpression = false
  !this.checkRule       = true
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      expression
--
-- Description: Set expression to check against
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EXPRESSION  Expression to execute on test
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expression(!expresion is EXPRESSION)
  !this.expression      = !expresion
  !this.checkExpression = true
  !this.checkRule       = false
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: Define collection used to get possible storage areas
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      COLLECTION  Collection object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collection(!collection is COLLECTION)
  !this.collection(!collection, object DBREF())
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: Define collection used to get possible storage areas
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      COLLECTION  Collection object
--    2   R      DBREF       Scope of collection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collection(!collection is COLLECTION, !scope is DBREF)

  -- Initialise Variables
  !this.settable        = false
  !this.checkParent     = false
  !this.checkExpression = false
  !this.checkRule       = false
  !this.collection      = !collection
  !this.scope           = !scope

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: Evaluate collection object with current scope
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .evaluate() is BOOLEAN
  return !this.evaluate(!this.scope)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: Evaluate collection object with passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    2   R      DBREF       Scope of collection
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .evaluate(!scope is DBREF) is BOOLEAN

  -- Check object is unsettable (only collections can be unsettable)
  if(!this.settable) then
    !!error.text    = 'Object in not of the correct type to evaluate.'
    return false
  endif

  -- Initialise Variable
  !collection       = !this.collection

  -- Set scope
  if(!scope.set()) then
    !collection.scope(!scope)
  endif

  -- Get element
  !this.elements    = !collection.results()

  -- Set first as default
  if(!this.elements.set()) then
    !this.element   = !this.elements.first()
  endif

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      elements
--
-- Description: Return list of possible store elements derived from collection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Element used as store area
--
------------------------------------------------------------------------

define method .elements() is ARRAY
  return !this.elements
endmethod
-- End of method definition
