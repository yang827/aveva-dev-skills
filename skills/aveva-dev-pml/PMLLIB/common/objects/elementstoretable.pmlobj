--
-- File:            elementstoretable.pmlobj
--   Type:          Object Definition
--   Group:         Any
--     Keyword:     Element Store Tables
--   Module:        All
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Fri May 18 11:00:00 GMT 2007
--
-- Description:
--    Object for holding default storage areas for an application.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear(STRING)                    BOOLEAN             Clears storage areas (leave all other settings)
--  collection(STRING,COLLECTION)    -                   Define collection used to get possible storage areas
--  collection(STRING,COLLECTION,DBREF) -                   Define collection used to get possible storage areas and set scope
--  elementStoreTable()              -                   Constructor
--  elementStoreTable(STRING,STRING) -                   Constructor
--  elementsForStore(STRING)         ARRAY               Return elements for the passed store (collection type only)
--  evaluate(STRING)                 BOOLEAN             Evaluate collection for storage area
--  evaluate(STRING,DBREF)           BOOLEAN             Evaluate collection for storage area passing scope
--  exists(STRING)                   BOOLEAN             Check if passed storage area key exists
--  expression(STRING,EXPRESSION)    -                   Sets passed check expression for storage are
--  getIndex(STRING)                 REAL                Get index for passed store key
--  getSetIndex(STRING)              REAL                Check if passed storage area key exists, if not creates store
--  getStore(STRING)                 DBREF               Returns the store for the passed key
--  navigate(STRING)                 BOOLEAN             Navigate to current storage area
--  register(STRING)                 REAL                Register a storage area with the table
--  register(STRING,STRING,STRING)   REAL                Register a storage area with the table
--  rule(STRING,BLOCK)               -                   Sets passed check rule for storage are
--  setStore(STRING,DBREF)           BOOLEAN             Sets the passed element as the store for the passed key (create key if none found)
--  storeType(STRING,STRING)         -                   Sets passed element type for the store key (create key if none found)
--  storeTypes(STRING,ARRAY)         -                   Sets passed element types permissible for the store key (create key if none found)
--  test()                           -                   Test
--
------------------------------------------------------------------------

define object ELEMENTSTORETABLE

  -- Name of Table
  member .name            is STRING

  -- Description
  member .description     is STRING

  -- Primary Key of storage areas within table, index to list of storage areas
  member .primaryKeys     is ARRAY

  -- List of storage areas (Array of ELEMENTSTORE's)
  member .storageAreas    is ARRAY

  -- Error state, secondary where methods done return a boolean but a null is returned
  member .errorState      is BOOLEAN
  member .errorText       is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      elementStoreTable
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementStoreTable()

  -- Initialise Variables
  !this.errorState    = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      elementStoreTable
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementStoreTable(!name is STRING, !description is STRING)

  -- Initialise Variables
  !this.elementStoreTable()
  !this.name        = !name
  !this.description = !description

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      test
--
-- Description: Test
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .test()

  -- Initialise Variables
  !types      = ARRAY()
  !types.append('DETGRP')
  !types.append('CEILING')

  -- Define store with no checking
  !this.register('basic', 'Basic', 'Basic store with no checking')

  -- Define store with basic type check
  !this.register('types', 'With Types', 'Store with specific types')
  !this.storeTypes('types', !types)

  -- Define store with type check and rule
  !this.register('expression', 'With Expression', 'Store with a type and expression')
  !this.storeType('expression', 'DETGRP')
  !expression = object EXPRESSION('PURP eq ''WALL''')
  !this.expression('expression', !expression)

  -- Define store with type check and rule
  !this.register('rule', 'With Rule', 'Store with a type and rule')
  !this.storeType('rule', 'ROOM')
  -- Rule should have "!element" within them as this is the local variable
  -- that contains the element to be checked (DBREF). Also if a function
  -- is used, then it must return a boolean.
  !rule       = object BLOCK('!this.testRule(!element)')
  !this.rule('rule', !rule)

  -- Define "collection" type store
  !this.register('collection', 'Collection', 'Collection store')
  !collection = object COLLECTION()
  !collection.type('DETGRP')
  !collection.filter(object EXPRESSION('PURP eq ''CLN'''))
  !this.collection('collection', !collection)


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Clears storage areas (leave all other settings)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .clear(!key is STRING) is BOOLEAN

  -- Initialise Variables
  !this.errorState    = false
  !index              = !this.getIndex(!key)

  -- Clear storage area
  if(!index.set()) then
    !this.storageAreas[!index].clear()

  -- No storage key defined
  else
    !this.errorState  = true
    !this.errorText   = 'Store key "' & !key & '" is not registered with table.'
  endif

  -- Return
  return !this.errorState

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Navigate to current storage area
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .navigate(!key is STRING) is BOOLEAN

  -- Initialise Variables
  !this.errorState    = false
  !index              = !this.getIndex(!key)

  -- Clear storage area
  if(!index.set()) then
    !this.errorState  = !this.storageAreas[!index].navigate()

  -- No storage key defined
  else
    !this.errorState  = true
    !this.errorText   = 'Store key "' & !key & '" is not registered with table.'
  endif

  -- Return
  return !this.errorState

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      exists
--
-- Description: Check if passed storage area key exists
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if exists
--
------------------------------------------------------------------------

define method .exists(!key is STRING) is BOOLEAN
  return !this.primaryKeys.findFirst(!key.upcase()).set()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getIndex
--
-- Description: Get index for passed store key
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    REAL        Index of store
--
------------------------------------------------------------------------

define method .getIndex(!key is STRING) is REAL
  return !this.primaryKeys.findFirst(!key.upcase())
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getSetIndex
--
-- Description: Check if passed storage area key exists, if not creates store
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    REAL        Index of store
--
------------------------------------------------------------------------

define method .getSetIndex(!key is STRING) is REAL

  -- Initialise Variables
  !index            = !this.getIndex(!key)

  -- Check if store exists
  if(!index.unset()) then
    !index          = !this.register(!key)
  endif

  -- Return
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      register
--
-- Description: Register a storage area with the table
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    REAL        Index in table
--
------------------------------------------------------------------------

define method .register(!key is STRING) is REAL
  return !this.register(!key, object STRING(), object STRING())
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      register
--
-- Description: Register a storage area with the table
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      STRING      Name for storage area
--    3   R      STRING      Description for storage area
-- Return:
--   [Data Type] [Description]
--    REAL        Index in table
--
------------------------------------------------------------------------

define method .register(!key is STRING, !name is STRING, !description is STRING) is REAL

  -- Initialise Variables
  !this.errorState    = false
  !index              = 0

  -- Check if key exists
  if(!this.exists(!key).not()) then
    !index            = !this.primaryKeys.size() + 1

    -- Create new entry
    !this.primaryKeys[!index]   = !key.upcase()
    !this.storageAreas[!index]  = object ELEMENTSTORE(!key, !name, !description)

    -- Key doesn't exist
  else
    !this.errorState  = true
    !this.errorText   = 'Store key "' & !key & '" is already registered with table.'
  endif

  -- Return index
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getStore
--
-- Description: Returns the store for the passed key
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    DBREF       Element registered against key
--
------------------------------------------------------------------------

define method .getStore(!key is STRING) is DBREF

  -- Initialise Variables
  !this.errorState    = false
  !index              = !this.getIndex(!key)

  -- Return if index is unset
  if(!index.unset()) then
    !this.errorState  = true
    !this.errorText   = 'Store key "' & !key & '" is not registered with table.'

    return object DBREF()

  endif

  -- Return entry of store (could be unset if none assigned)
  return !this.storageAreas[!index].store()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setStore
--
-- Description: Sets the passed element as the store for the passed key (create key if none found)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      DBREF       Element to be used as store area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .setStore(!key is STRING, !store is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.errorState    = false
  !index              = !this.getSetIndex(!key)

  -- Set store
  if(!this.storageAreas[!index].store(!store)) then
    return true
  else
    !this.errorState  = true
    !this.errorText   = !!error.text
    return false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      storeType
--
-- Description: Sets passed element type for the store key (create key if none found)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      STRING      Element type that can ve used as a store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storeType(!key is STRING, !type is STRING)
  !types[1] = !type
  !this.storeTypes(!key, !types)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      storeTypes
--
-- Description: Sets passed element types permissible for the store key (create key if none found)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      ARRAY       Element types that can ve used as a store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storeTypes(!key is STRING, !types is ARRAY)
  !index  = !this.getSetIndex(!key)
  !this.storageAreas[!index].types(!types)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rule
--
-- Description: Sets passed check rule for storage are
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      BLOCK       Check rule
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rule(!key is STRING, !rule is BLOCK)
  !index  = !this.getSetIndex(!key)
  !this.storageAreas[!index].rule(!rule)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      expression
--
-- Description: Sets passed check expression for storage are
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      EXPRESSION  Check rule
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expression(!key is STRING, !expression is EXPRESSION)
  !index  = !this.getSetIndex(!key)
  !this.storageAreas[!index].expression(!expression)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: Define collection used to get possible storage areas
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      COLLECTION  Collection object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collection(!key is STRING, !collection is COLLECTION)
  !this.collection(!key, !collection, object DBREF())
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: Define collection used to get possible storage areas and set scope
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
--    2   R      COLLECTION  Collection object
--    3   R      DBREF       Scope of collection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collection(!key is STRING, !collection is COLLECTION, !scope is DBREF)
  !index  = !this.getSetIndex(!key)
  !this.storageAreas[!index].collection(!collection, !scope)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: Evaluate collection for storage area
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if the collection was executed
--
------------------------------------------------------------------------

define method .evaluate(!key is STRING) is BOOLEAN

  -- Initialise Variables
  !index  = !this.getIndex(!key)

  -- Evaluate store object
  !return = !this.storageAreas[!index].evaluate()

  if(!return.not()) then
    !this.errorState  = true
    !this.errorText   = !!error.text
  endif

  -- Return
  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: Evaluate collection for storage area passing scope
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if the collection was executed
--
------------------------------------------------------------------------

define method .evaluate(!key is STRING, !scope is DBREF) is BOOLEAN

  -- Initialise Variables
  !index  = !this.getIndex(!key)

  -- Evaluate store object
  !return = !this.storageAreas[!index].evaluate(!scope)

  if(!return.not()) then
    !this.errorState  = true
    !this.errorText   = !!error.text
  endif

  -- Return
  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      elementsForStore
--
-- Description: Return elements for the passed store (collection type only)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key for storage area
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of element
--
------------------------------------------------------------------------

define method .elementsForStore(!key is STRING) is ARRAY

  -- Initialise Variables
  !index  = !this.getIndex(!key)

  -- Return
  return !this.storageAreas[!index].elements()

endmethod
-- End of method definition
