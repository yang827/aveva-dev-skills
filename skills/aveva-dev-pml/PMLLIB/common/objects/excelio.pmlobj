-- File:            excelio.pmlobj
--   Type:          Object Definition
--   Group:         Aveva.Pdms.ExcelInterface
--
--   Keyword:       Aveva.Pdms.ExcelInterface
--   Module:        All
--   Replaces:
--
-- Author:
-- Created:         Mon May 12th 2008
--
--
-- Description:
-- Excel input and output support for Db structures
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  callback(ARRAY)                  -
--  configurationNames()             ARRAY
--  excelio()                        -
--  export(STRING,STRING)            REAL
--  import(STRING)                   REAL
--  import(STRING,STRING)            REAL
--
------------------------------------------------------------------------
define object EXCELIO


endobject
-- End of object definition for EXCELIO

------------------------------------------------------------------------
--
-- Method:      EXCELIO
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .excelio()

  USING NAMESPACE 'Aveva.Pdms.ExcelInterface'

  if (not defined(!!excelioinstance)) then
    !!excelioinstance = !this
    !!excelioNetInstance = object ExcelIONet()
    !!excelioNetInstance.addEventHandler('Response',!!excelioinstance,'callback')
  endif

endmethod
-- End of method definition for EXCELIO()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for ExcelIONet
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()
------------------------------------------------------------------------
--
-- Method:      CONFIGURATIONNAMES
--
-- Description: Imports a specified xml file into the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .configurationNames() is ARRAY

  return !!excelioNetInstance.ConfigurationNames()
	
endmethod
-- End of method definition for .configurationNames()
------------------------------------------------------------------------
--
-- Method:      IMPORT
--
-- Description: Imports a specified xml file into the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .import(!filename is STRING) is REAL

  return !!excelioNetInstance.Import(!filename)
	
endmethod
-- End of method definition for .importFile()
------------------------------------------------------------------------
--
-- Method:      IMPORT
--
-- Description: Imports a specified excel file into the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .import(!filename is STRING, !configName is STRING) is REAL

  return !!excelioNetInstance.Import(!filename,!configName)

endmethod
-- End of method definition for .import()
------------------------------------------------------------------------
--
-- Method:      EXPORT
--
-- Description: Exports an excel file from the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to create/overwrite
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .export(!filename is STRING, !configName is STRING) is REAL

  return !!excelioNetInstance.Export(!filename,!configName)
	
endmethod
-- End of method definition for .export()
