--
--
-- Description:
-- Encapsulation of Query functionality
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   close connection with data server
--  connected()                      BOOLEAN             return true if connected
--  delimiter(STRING)                -                   set data field delimiter
--  external(STRING)                 -                   open connection to data server
--  external(STRING,STRING)          -                   open connection to data server
--  external(STRING,STRING,STRING)   -                   open connection to data server
--  getAllRows()                     ARRAY               get all rows of result data
--  getAllRows(REAL)                 ARRAY               get up to !maxRows rows of result data
--  getHeader()                      ARRAY               get header data
--  getResult()                      ARRAY               get result of send
--  getRow()                         ARRAY               get single row of result data
--  request(ARRAY)                   ARRAY               send request to data server and get all result data
--  request(STRING)                  ARRAY               send request to data server and get all result data
--  send(ARRAY)                      -                   send request to data server
--  send(STRING)                     -                   send request to data server
--  toggleTrace()                    -                   toggle daemon trace flag
--
------------------------------------------------------------------------

define object EXTERNAL

  -- daemon connection token
  member .token is REAL

endobject
-- End of object definition for EXTERNAL

------------------------------------------------------------------------
--
-- Method:      !external(STRING,STRING,STRING)
--
-- Description: open connection to data server
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [daemon synonym]
--   [2] [R] [STRING] [connect string]
--   [3] [R] [STRING] [remote host]
--
------------------------------------------------------------------------

define method .external(!daemonSynonym is STRING, !connectString is STRING, !remoteHost is STRING)

  -- close if already open
  if (!this.token.set()) then
    !this.close()
  endif

  -- protect evaluated syntax from embedded quotes
  !daemon =  !daemonSynonym.replace('|', '||')
  !connect = !connectString.replace('|', '||')
  !host =    !remoteHost.replace('|', '||')

  -- connect
  EXTERNAL OPEN |$!daemon| !token AS |$!connect| ON |$!host|

  -- store daemon token
  !this.token = !token.real()

endmethod
-- End of method definition for .external(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !external(STRING,STRING)
--
-- Description: open connection to data server
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [daemon synonym]
--   [2] [R] [STRING] [connect string]
--
------------------------------------------------------------------------

define method .external(!daemonSynonym is STRING, !connectString is STRING)

  -- close if already open
  if (!this.token.set()) then
    !this.close()
  endif

  -- protect evaluated syntax from embedded quotes
  !daemon =  !daemonSynonym.replace('|', '||')
  !connect = !connectString.replace('|', '||')

  -- connect
  EXTERNAL OPEN |$!daemon| !token AS |$!connect|

  -- store daemon token
  !this.token = !token.real()

endmethod
-- End of method definition for .external(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !external(STRING)
--
-- Description: open connection to data server
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [daemon synonym]
--
------------------------------------------------------------------------

define method .external(!daemonSynonym is STRING)

  -- close if already open
  if (!this.token.set()) then
    !this.close()
  endif

  -- protect evaluated syntax from embedded quotes
  !daemon = !daemonSynonym.replace('|', '||')

  -- connect
  EXTERNAL OPEN |$!daemon| !token

  -- store daemon token
  !this.token = !token.real()

endmethod
-- End of method definition for .external(STRING)

------------------------------------------------------------------------
--
-- Method:      !close()
--
-- Description: close connection with data server
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .close()

  -- close connection
  EXTERNAL CLOSE $!<this.token>

  -- mark as not in use
  !this.token = REAL()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      !send(STRING)
--
-- Description: send request to data server
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [request string]
--
------------------------------------------------------------------------

define method .send(!requestString is STRING)

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- protect evaluated syntax from embedded quotes
  !request = !requestString.replace('|', '||')

  -- send request
  EXTERNAL SEND $!<this.token> |$!request|

endmethod
-- End of method definition for .send(STRING)

------------------------------------------------------------------------
--
-- Method:      !send(ARRAY)
--
-- Description: send request to data server
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [ARRAY of STRINGs] [request strings]
--
------------------------------------------------------------------------

define method .send(!requestStrings is ARRAY)

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- protect evaluated syntax from embedded quotes
  !requests = ARRAY()
  do !request values !requestStrings
    !requests.append(!request.replace('|', '||'))
  enddo

  -- need to construct a block of commands for send
  !commands = ARRAY()
  !commands.append('EXTERNAL SEND $!<this.token> START')
  do !request values !requests
    !commands.append('|' & !request & '|')
  enddo
  !commands.append('END')

  -- limit it to twenty lines
  if (!commands.size() gt 20) then
    return error 1 'Request error: too many request strings'
  endif

  -- pad up to twenty lines as no do syntax inside send block
  do !i from (!commands.size() + 1) to 20
    !commands.append(||)
  enddo

  -- send requests (currently no more elegant way available)
  $!commands[1]
  $!commands[2]
  $!commands[3]
  $!commands[4]
  $!commands[5]
  $!commands[6]
  $!commands[7]
  $!commands[8]
  $!commands[9]
  $!commands[10]
  $!commands[11]
  $!commands[12]
  $!commands[13]
  $!commands[14]
  $!commands[15]
  $!commands[16]
  $!commands[17]
  $!commands[18]
  $!commands[19]
  $!commands[20]

endmethod
-- End of method definition for .send(ARRAY)

------------------------------------------------------------------------
--
-- Method:      !getResult()
--
-- Description: get result of send
--
-- Method Type: Function
-- Return:
--   [ARRAY of STRINGs] [Results]
--
------------------------------------------------------------------------

define method .getResult() is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- get result
  var !data EXTERNAL GET $!<this.token> RESULT

  -- no more data
  handle (79,10)
    return ARRAY()
  endhandle

  return !data

endmethod
-- End of method definition for .getResult() ARRAY

------------------------------------------------------------------------
--
-- Method:      !getHeader()
--
-- Description: get header data
--
-- Method Type: Function
-- Return:
--   [ARRAY of STRINGs] [Headers]
--
------------------------------------------------------------------------

define method .getHeader() is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- get header
  var !data EXTERNAL GET $!<this.token> HEADER

  -- no more data
  handle (79,10)
    return ARRAY()
  endhandle

  return !data

endmethod
-- End of method definition for .getHeader() ARRAY

------------------------------------------------------------------------
--
-- Method:      !getRow()
--
-- Description: get single row of result data
--
-- Method Type: Function
-- Return:
--   [ARRAY of STRINGs] [row of data]
--
------------------------------------------------------------------------

define method .getRow() is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- get row
  var !data EXTERNAL GET $!<this.token> NEXT

  -- no more data
  handle (79,10)
    return ARRAY()
  endhandle

  return !data

endmethod
-- End of method definition for .getRow() ARRAY

------------------------------------------------------------------------
--
-- Method:      !getAllRows()
--
-- Description: get all rows of result data
--
-- Method Type: Function
-- Return:
--   [ARRAY of ARRAYs of STRINGs] [all rows of data]
--
------------------------------------------------------------------------

define method .getAllRows() is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  !returnData = ARRAY()

  -- get data
  do
    !data = !this.getRow()
    break if (!data.unset())
    !returnData.append(!data)
  enddo

  return !returnData

endmethod
-- End of method definition for .getAllRows() ARRAY

------------------------------------------------------------------------
--
-- Method:      !getAllRows(REAL)
--
-- Description: get up to !maxRows rows of result data
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [STRING] [request string]
-- Return:
--   [ARRAY of ARRAYs of STRINGs] [all rows of data]
--
------------------------------------------------------------------------

define method .getAllRows(!maxRows is REAL) is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  !returnData = ARRAY()

  -- get data
  do !i to !maxRows
    !data = !this.getRow()
    break if (!data.unset())
    !returnData.append(!data)
  enddo

  return !returnData

endmethod
-- End of method definition for .getAllRows(REAL) ARRAY

------------------------------------------------------------------------
--
-- Method:      !request(STRING)
--
-- Description: send request to data server and get all result data
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [request string]
-- Return:
--   [ARRAY of ARRAYs of STRINGs] [all rows of data]
--
------------------------------------------------------------------------

define method .request(!requestString is STRING) is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  !returnData = ARRAY()

  -- process request
  !this.send(!requestString)
  !returnData.append(!this.getHeader())
  !returnData.appendArray(!this.getAllRows())

  return !returnData

endmethod
-- End of method definition for .request(STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      !request(ARRAY)
--
-- Description: send request to data server and get all result data
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [ARRAY of STRINGs] [request strings]
-- Return:
--   [ARRAY of ARRAYs of STRINGs] [all rows of data]
--
------------------------------------------------------------------------

define method .request(!requestStrings is ARRAY) is ARRAY

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  !returnData = ARRAY()

  -- process request
  !this.send(!requestStrings)
  !returnData.append(!this.getHeader())
  !returnData.appendArray(!this.getAllRows())

  return !returnData

endmethod
-- End of method definition for .request(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method:      !delimiter(STRING)
--
-- Description: set data field delimiter
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [delimiter character]
--
------------------------------------------------------------------------

define method .delimiter(!delimiter is STRING)

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- protect evaluated syntax from embedded quotes
  !delimiterChar = !delimiter.subString(1, 1).replace('|', '||')

  -- set delimiter
  EXTERNAL DELIMIT $!<this.token> |$!delimiterChar|

endmethod
-- End of method definition for .delimiter(STRING)

------------------------------------------------------------------------
--
-- Method:      !toggleTrace()
--
-- Description: toggle daemon trace flag
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .toggleTrace()

  -- check if already open
  if (!this.token.unset()) then
    return error 1 'No external connection'
  endif

  -- toggle trace
  EXTERNAL TOGGLE $!<this.token> TRACE

endmethod
-- End of method definition for .toggleTrace()

------------------------------------------------------------------------
--
-- Method:      !connected()
--
-- Description: return true if connected
--
-- Method Type: Function
-- Returns:
--   [BOOLEAN] [true if connected]
--
------------------------------------------------------------------------

define method .connected() is BOOLEAN

  -- open if token is set
  return !this.token.set()

endmethod
-- End of method definition for .connected() BOOLEAN
