--
-- Description:
-- Object for containing a finite line definition, i.e. a line
-- defined between two points.
--
------------------------------------------------------------------------

-- Define object
define object FINITELINE

  -- Start Position
  member .startPosition is POSITION
  -- End Position
  member .endPosition   is POSITION

endobject
-- End of object definition for FINITELINE
