-- Description:
-- Dummy Forms&Menus object to allow module-switching into a non-gui module
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  string()                         STRING
--
define object FORM
   member .elt is REAL
   member .refer is BOOLEAN
   member .ftkn is REAL
endobject
-- End of object definition for FORM

define method .string() is STRING
  return 'FORM-PROXY'
endmethod
-- End of method definition for .string() STRING
