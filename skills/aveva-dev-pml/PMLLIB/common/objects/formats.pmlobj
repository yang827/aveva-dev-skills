-- Define object
define object FORMATS

  -- Format Type (group)
  member .type        is STRING
  -- Description
  member .description is STRING
  -- Global Variable name format is related to
  member .gvar        is STRING
  -- Example of Formatted item
  member .example     is STRING
  -- Format
  member .format      is FORMAT

endobject
-- End of object definition for FORMATS
