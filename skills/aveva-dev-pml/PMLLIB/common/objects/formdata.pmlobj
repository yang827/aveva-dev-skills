--
--
-- Description:
-- Default form data, used to pass data to a configurable form or it
-- can be used when generating a form. This object is basically a
-- dummy form object, therefore if we get any new member in a form
-- object, this should be updated. Also the object can contain other
-- information.
--
------------------------------------------------------------------------

-- Define object
define object FORMDATA

  -- Form Name
  member .formName        is STRING
  -- Form as a pointer
  member .form            is FORM
  -- Form Title
  member .formTitle       is STRING
  -- Form Revision
  member .formRevision    is STRING
  -- Icon Title
  member .iconTitle       is STRING
  -- Auto callback
  member .autoCall        is STRING
  -- Callback (executed on showing the form)
  member .callback        is STRING

  -- Main Action Button Callbacks
    -- Apply/OK Button
    member .apply         is STRING
    -- Dismiss/Cancel
    member .dismiss       is STRING
    -- Reset
    member .reset         is STRING

  -- Is the form to be shown when created/loaded
  member .show            is BOOLEAN

  -- Members specific to View gadgets
    -- Width
    member .width         is REAL
    -- Height
    member .height        is REAL
    -- Aspect Ratio
    member .ratio         is REAL

endobject
-- End of object definition for FORMDATA
