---
-- Description:
--  Accommodation control object, use to manage distribution of current
--  active accommodation elements
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  formSubscription()               -                   Constructor
--  refresh(FORM)                    -                   Run all registered methods for passed form
--  refresh(STRING)                  -                   Run all registered methods for passed form
--  register(FORM,BLOCK)             -                   Register action to be carried out on change
--  register(STRING,BLOCK)           -                   Register action to be carried out on change
--
------------------------------------------------------------------------

define object FORMSUBSCRIPTION

  -- Register of forms
  member .forms     is ARRAY

  -- Register of methods to be carried out for when form is updated.
  -- 2D array, paired with forms
  member .methods   is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      formSubscription
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .formSubscription()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      register
--
-- Description: Register action to be carried out on change
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .register(!form is FORM, !block is BLOCK)
  !this.register(!form.name(), !block)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      register
--
-- Description: Register action to be carried out on change
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .register(!formname is STRING, !block is BLOCK)

  -- Get form index
  !form     = !formname.upcase()
  !fIndex   = !this.forms.findFirst(!form)

  -- Add form to list
  if(!fIndex.unset()) then
    !this.forms.append(!form)
    !fIndex = !this.forms.size()
    !this.methods[!fIndex]  = ARRAY()
  endif

  -- Quick check to see if block is already in the system
  !index  = !this.methods[!fIndex].findFirst(!block)

  -- Add entry to system
  if(!index.unset()) then
    !this.methods[!fIndex].append(!block)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Run all registered methods for passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh(!form is FORM)
  !this.refresh(!form.name())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Run all registered methods for passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh(!formname is STRING)

  -- Get form index
  !form     = !formname.upcase()
  !fIndex   = !this.forms.findFirst(!form)

  -- Form not registered
  if(!fIndex.unset()) then
    return
  endif

  -- Loop through the registered methods
  do !i indices !this.methods[!fIndex]
    !this.methods[!fIndex][!i].evaluate()
    handle ANY
      q var !!error
    endhandle
  enddo

endmethod
-- End of method
