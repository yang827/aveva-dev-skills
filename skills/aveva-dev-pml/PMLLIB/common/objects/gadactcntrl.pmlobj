--
-- Author:          T.Lisowski
--
-- Description:
-- Gadget active state controller
--
------------------------------------------------------------------------
--

define object GADACTCNTRL
  -- The form containing toggles and other gadgets to manipulate
  member .form is FORM
endobject

------------------------------------------------------------------------
--
-- Method:      gadActCntrl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        The form whose gadgets are to be manipulated
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gadActCntrl(!form is FORM)

  !this.form = !form

endmethod
-- End of method definition for .gadActCntrl()

------------------------------------------------------------------------
--
-- Method:      process
--
-- Description: Activates gadgets BEFORE the dash ('-') item
--              Deactivates gadgets AFTER the dash item
--
-- Example:
--   !a[1] = 'G1'
--   !a[2] = 'G2'
--   !a[3] = '-'
--   !a[4] = 'G3'
--   process(!a)
--     make G1, G2 active, G3 - inactive
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Array of gadget names to be considered (including the '-')
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Status of operation (TRUE - success, FALSE - failure)
------------------------------------------------------------------------

define method .process(!activeInfo is ARRAY) is BOOLEAN

  if (!activeInfo.set()) then
    -- The gadget name array is set
    !status = TRUE
    do !name values !activeInfo
      if (!name.eq('-')) then
        !status = FALSE
      else
        !this.form.attribute(!name).active = !status
        handle (2,766) (2,759)
          !!alert.error('GADACTCNTRL.process(): Unknown or incompatible gadget - ' + !name)
          return FALSE
        endhandle
      endif
    enddo
  endif
  -- no error so far
  return TRUE

endmethod
-- End of method definition for .process()

------------------------------------------------------------------------
--
-- Method:      process
--
-- Description: Activates gadgets BEFORE the dash ('-') item
--              Deactivates gadgets AFTER the dash item
--
-- Example:
--   process('G1 G2 - G3')
--     make G1, G2 active, G3 - inactive
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The formatted list of gadget names to be considered
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Status of operation (TRUE - success, FALSE - failure)
------------------------------------------------------------------------

define method .process(!activeInfo is STRING) is BOOLEAN

  !aiArray = !activeInfo.split()
  return !this.process(!aiArray)

endmethod
-- End of method definition for .process()

------------------------------------------------------------------------
--
-- Method:      process
--
-- Description: Activates gadgets BEFORE the dash ('-') item
--              Deactivates gadgets AFTER the dash item.
--              Does the above in sequence interrogating the toggle gadgets
--
-- Examples:
--   process('', 'G1 G2 - G3')
--     Make G1, G2 active, G3 - inactive UNCONDITIONALLY
--   process('TOG1', 'G1 G2 - G3')
--     If (TOG1.val) then make G1, G2 active, G3 - inactive
--     else make G1, G2 inactive, G3 active (the reverse of the above!)
--   process('TOG1', 'G1 G2 - G3/G1 - G2 G3')
--     If (TOG1.val) then make G1, G2 active, G3 - inactive
--     else make G1 active, G1, G3 - inactive
--   process('TOG1 TOG2', 'G1 G2 - G3/G1 - G2 G3/- G1 G2 G3')
--     If (TOG1.val) then make G1, G2 active, G3 - inactive
--     elseif (TOG2.val) then make G1 active, G1, G3 - inactive
--     else make None active, G1, G2, G3 inactive
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The toggle name list (all but one!)
--    2   R      STRING      Formatted list of gadget names to be made
--                           active or inactive
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Status of operation (TRUE - success, FALSE - failure)
------------------------------------------------------------------------

define method .process(!toggleNames is STRING, !activeInfo is STRING) is BOOLEAN

  !togList = !toggleNames.split()       $* list of toggle gadget names
  !activeList = !activeInfo.split('/')  $* list of corresponding sections with gadget names
  !nToggles = !togList.size()           $* number of toggles
  !nActiveDefs = !activeList.size()     $* number of sections with gadget names

  -- unconditional active state setting (empty string as the firstargument)
  if (!nToggles.eq(0)) then
    if (!nActiveDefs.eq(1)) then
      return !this.process(!activeList[1])
    else
      !!alert.error('GADACTCNTRL.process(): Single gadget name section expected for the unconditional call!')
      return FALSE
    endif
  endif
  -- at least one toggle name given - conditional active state setting
  -- single toggle name and one section in !activeInfo - derive the second section if necessary
  if (!nToggles.eq(1) and !nActiveDefs.eq(1)) then
    !togStatus = !this.form.attribute(!togList[1]).val
    handle (2,766) (2,759)
      !!alert.error('GADACTCNTRL.process(): Unknown toggle gadget - ' + !togList[1])
      return FALSE
    endhandle
    !items = !activeList[1].split()
    if (!togStatus) then
      return !this.process(!items)
    else
      !second = !items.invert()
      return !this.process(!second)
    endif
  endif
  -- general case of !nToggles > 0
  !nt1 = !nToggles + 1
  if (!nActiveDefs.eq(!nt1)) then
    do !ind from 1 to !nToggles
      !togStatus = !this.form.attribute(!togList[!ind]).val
      handle (2,766) (2,759) (2,761)
        !!alert.error('GADACTCNTRL.process(): Unknown or incompatible toggle gadget - ' + !togList[!ind])
        return FALSE
      endhandle
      if(!togStatus) then
        return !this.process(!activeList[!ind])
      endif
    enddo
    -- None of the toggle gadgets so far was set - apply the last setting
    return !this.process(!activeList[!nActiveDefs])
  endif
  -- invalid number of sections as compared to the number of toggles
  !!alert.error('GADACTCNTRL.process(): Invalid syntax - consult the method description and examples!')
  return FALSE

endmethod
-- End of method definition for .process()
