------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  enhance()                        -                   enhances the element
--  erase()                          -                   erase the element
--  gate()                           -                   Constructor
--  gate(DBREF)                      -                   Constructor
--  gate(POSITION,DIRECTION,DIRECTION) -                   Constructor
--  getArrivePosition()              POSITION            get the arrive position of the gate
--  getLeavePosition()               POSITION            et the leave position of the gate
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates STRLNG element
--
define object GATE

  -- public members
  ---------------------------------------------------------------------------
  -- entry direction
  member .entryDirection    is DIRECTION

  -- exit direction
  member .exitDirection     is DIRECTION

  -- height of the gate
  member .height            is REAL

  -- position
  member .position          is POSITION

  -- reference
  member .refe              is DBREF

  -- width of the gate
  member .arriveOffset      is REAL
  member .leaveOffset       is REAL

  -- private members
  ---------------------------------------------------------------------------

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      gate
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .gate()

  -- inits
  !this.arriveOffset = 500mm
  !this.leaveOffset  = 500mm
  !this.height       = 2200mm

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gate
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position
--    2   R      DIRECTION   entry direction
--    3   R      DIRECTION   exit direction
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .gate(!position is POSITION, !entryDir is DIRECTION, !exitDir is DIRECTION)

  -- inits
  !this.height         = 2200mm
  !this.arriveOffset   = 500mm
  !this.leaveOffset    = 500mm
  !this.position       = !position
  !this.entryDirection = !entryDir
  !this.exitDirection  = !exitDir

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gate
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .gate(!refe is DBREF)

--TODO: missing attribute
  !this.arriveOffset   = 0
  !this.entryDirection = !refe.strExtDirection
  !this.exitDirection  = !refe.strExtDirection.opposite()
--TODO: missing attribute
  !this.height         = 0
--TODO: missing attribute
  !this.leaveOffset    = 0
  !this.position       = !refe.position
  !this.refe           = !refe

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erase the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getArrivePosition
--
-- Description: get the arrive position of the gate
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getArrivePosition() is POSITION

  !arriveDirection = !this.entryDirection.orthogonal(U)

  return !this.position.offset(!arriveDirection, !this.arriveOffset)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getLeavePosition
--
-- Description: et the leave position of the gate
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getLeavePosition() is POSITION

  !leaveDirection = !this.entryDirection.orthogonal(D)

  return !this.position.offset(!leaveDirection, !this.leaveOffset)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()

  !orthogonal          = !this.entryDirection.orthogonal(U)

    -- draws the direction arrow
    ---------------------------------------------------------------------------
  AID SPHERE NUMBER $!!<aslCentralData.aidVolMain>    $!<this.position>                               DIAM    250mm

  if ( !this.height.gt(0) ) then
    AID ARROW  NUMBER $!!<aslCentralData.aidVolMain> AT $!<this.position> DIR $!<this.entryDirection> HEIGHT 1500mm

    -- draws the frame
    ---------------------------------------------------------------------------
    !line1               = object LINE()
    !line1.startPosition = !this.position.offset(!orthogonal, !this.arriveOffset)
    !line1.endPosition   = !this.position.offset(!orthogonal, !this.arriveOffset).offset(U, !this.height)
    !line1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

    !line2               = object LINE()
    !line2.startPosition = !this.position.offset(!orthogonal.opposite(), !this.leaveOffset)
    !line2.endPosition   = !this.position.offset(!orthogonal.opposite(), !this.leaveOffset).offset(U, !this.height)
    !line2.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

    !line3               = object LINE()
    !line3.startPosition = !line1.endPosition
    !line3.endPosition   = !line2.endPosition
    !line3.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

    !line4               = object LINE()
    !line4.startPosition = !line1.startPosition
    !line4.endPosition   = !line2.startPosition
    !line4.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

    !line5               = object LINE()
    !line5.startPosition = !line1.startPosition
    !line5.endPosition   = !line2.endPosition
    !line5.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

    !line6               = object LINE()
    !line6.startPosition = !line1.endPosition
    !line6.endPosition   = !line2.startPosition
    !line6.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

    -- draws the reserved volume
    ---------------------------------------------------------------------------
    !line7               = object LINE()
    !line7.startPosition = !this.position.offset(!orthogonal, !this.arriveOffset)
    !line7.endPosition   = !this.position.offset(!orthogonal, !this.arriveOffset).offset(!this.entryDirection, !this.arriveOffset)
    !line7.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourAid)

    !line8               = object LINE()
    !line8.startPosition = !this.position.offset(!orthogonal.opposite(), !this.leaveOffset)
    !line8.endPosition   = !this.position.offset(!orthogonal.opposite(), !this.leaveOffset).offset(!this.entryDirection, !this.arriveOffset)
    !line8.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourAid)

    !line9               = object LINE()
    !line9.startPosition = !line7.endPosition
    !line9.endPosition   = !line8.endPosition
    !line9.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourAid)

    !line10               = object LINE()
    !line10.startPosition = !line7.startPosition
    !line10.endPosition   = !line8.endPosition
    !line10.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourAid)

    !line11               = object LINE()
    !line11.startPosition = !line7.endPosition
    !line11.endPosition   = !line8.startPosition
    !line11.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourAid)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: unenhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates STRLNG element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair exit')
    !undo.add()
  endif



  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method
