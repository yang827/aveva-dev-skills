------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  betweenLines(EDGPOSITIONDATA,EDGPOSITIONDATA) REAL                Constructor
--  gmfAngle()                       -                   Constructor
--
------------------------------------------------------------------------

-- Define object
define object GMFANGLE

  -- Line
  member .angle is REAL

endobject
-- End of object definition for GMFANGLE

------------------------------------------------------------------------
--
-- Method:      gmfAngle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfAngle()

  -- Assign passed line
  !this.angle =  0

endmethod
-- End of method definition for .gmfAngle()

------------------------------------------------------------------------
--
-- Method:      betweenLines
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA  Base line
--    2   R      EDGPOSITIONDATA  Reference Line
-- Return:
--   [Data Type] [Description]
--    REAL        Angle calculated
--
------------------------------------------------------------------------

define method .betweenLines(!base is EDGPOSITIONDATA, !reference is EDGPOSITIONDATA) is REAL

  -- Initialise Variables
  !baseLine      = !base.line
  !referenceLine = !reference.line

  -- Parallel Line
  -- Get intersection between the two lines
  !rootPosition  = !baseLine.intersection(!referenceLine)
  -- Parallel Line
  handle any
    !this.angle  = 0
    return 0
  endhandle

  -- Define plane between lines
  !orthogonal    = !baseLine.direction().orthogonal(!referenceLine.direction())
  !plane         = object PLANE(!rootPosition, object ORIENTATION('Z is ' & !orthogonal & ' and X is ' & !baseLine.direction()))

  -- Map intersection point of reference line onto plane
  !this.angle    = !rootPosition.angle(!baseLine.intersection(!base.pointVector), !plane.near(!referenceLine.intersection(!reference.pointVector)))

  return !this.angle

endmethod
-- End of method definition for .betweenLines(EDGPOSITIONDATA, EDGPOSITIONDATA) REAL
