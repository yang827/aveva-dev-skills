define object GMFBOX

  -- Xlength
  member .xLength     is REAL
  -- Ylength
  member .yLength     is REAL
  -- Zlength
  member .zLength     is REAL
  -- Position
  member .position    is POSITION
  -- Orientation
  member .orientation is ORIENTATION

endobject
-- End of object definition for GMFBOX
