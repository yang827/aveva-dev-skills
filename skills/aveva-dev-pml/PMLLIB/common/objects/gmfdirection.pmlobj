--  ===========                      ======              ===========
--  direction(EDGPICKDATA)           DIRECTION           Derive direction from pick data
--
------------------------------------------------------------------------

define object GMFDIRECTION

  --  Dummy
  member .dummy is STRING

endobject
-- End of object definition for GMFDIRECTION

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--  Derive direction from padded pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Pick data
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Derived direction
--
------------------------------------------------------------------------

define method .direction(!pickData is EDGPICKDATA) is DIRECTION

  !positionData = !pickData.positionData()

  -- Line picked
  if(!positionData.line.set()) then

    -- Determine position on the line and work out direction from
    -- the nearest end to that point
    !line     = !positionData.line
    !position = !line.intersection(!positionData.pointVector)
    if(!position.distance(!line.startPosition) le !position.distance(!line.endPosition)) then
      return !line.startPosition.direction(!position)
    else
      return !line.endPosition.direction(!position)
    endif

  -- Plane Picked
  elseif (!positionData.plane.set()) then

    return !positionData.plane.orientation.zDir()

  endif

  return object DIRECTION()

endmethod
-- End of method definition for .direction(EDGPICKDATA) DIRECTION
