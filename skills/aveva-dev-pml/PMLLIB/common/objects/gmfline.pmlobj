--
-- Description:
-- Line construction methods.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angle(REAL,LINE,POSITION,POSITION,POSITION) LINE                Line angled from passed line in the direction of the passed position
--  between2Points(POSITION,POSITION) LINE                Line between 2 points
--  bisect(LINE,LINE)                LINE                Line bisecting two other lines
--  bisect(LINE,POINTVECTOR,LINE,POINTVECTOR) LINE                Line bisecting two other lines
--  bisect(LINE,POSITION,LINE,POSITION) LINE                Line bisecting two other lines
--  copyAt(LINE,POSITION)            LINE                Copy passed line and position start at the passed position
--  distance(REAL,POSITION)          POSITION            Position given distance from nearest end to position
--  end(POSITION)                    STRING              Determine the "end" nearest of the line to the passed position
--  fraction(REAL,POSITION)          POSITION            Position to nearest fraction to position
--  gmfLine()                        -                   Constructor
--  gmfLine(LINE)                    -                   Constructor
--  offset(REAL,LINE,POSITION)       LINE                Copy passed line, offset by <value> in the direction normal from the line to the passed position
--  offsets(REAL,REAL,LINE,POSITION) ARRAY               Copy passed line, <nth> number of time, offset by <value> in the direction normal from the line to the passed position
--  parallel(LINE)                   LINE                Return gmfline line parallel to passed about the start position
--  pntTan(POSITION,ARC,POSITION)    LINE                Line between passed point and nearest tangent point on arc
--  proportion(REAL,POSITION)        POSITION            Position proportion from nearest end to position
--  shortest(EDGPICKDATA,EDGPICKDATA) LINE                Returns the shortest line between the to items
--  snap(POSITION)                   POSITION            Return position of end nearest to passed position
--  tanTan(ARC,POSITION,ARC,POSITION) LINE                Line between nearest tangent point on passed arcs and positions
--  twoPlanes(PLANE,PLANE)           LINE                Line bisecting two other lines
--
------------------------------------------------------------------------

-- Define object
define object GMFLINE

  -- Line
  member .line is LINE

endobject
-- End of object definition for GMFLINE

------------------------------------------------------------------------
--
-- Method:      gmfLine
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfLine()

  -- Assign passed line
  !this.line.startPosition = N0
  !this.line.endPosition   = N1000mm

endmethod
-- End of method definition for .gmfLine()

------------------------------------------------------------------------
--
-- Method:      gmfLine
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfLine(!line is LINE)

  -- Assign passed line
  !this.line = !line

endmethod
-- End of method definition for .gmfLine(LINE)

------------------------------------------------------------------------
--
-- Method:      end
--
-- Description: Determine the "end" nearest of the line to the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position from end
-- Return:
--   [Data Type] [Description]
--    STRING      Start/End
--
------------------------------------------------------------------------

define method .end(!position is POSITION) is STRING

  -- Initialise Variables
  !line             = !this.line
  !nPosition        = !line.near(!position)
  !distanceA        = !line.startPosition.distance(!nPosition)
  !distanceB        = !line.endPosition.distance(!nPosition)

  -- Determine nearest end
  if(!distanceA.leq(!distanceB)) then
    return 'Start'
  else
    return 'End'
  endif

endmethod
-- End of method definition for .end(POSITION) STRING

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Return position of end nearest to passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Control position
-- Return:
--   [Data Type] [Description]
--    POSITION    Position given distance from nearest end to position
--
------------------------------------------------------------------------

define method .snap(!position is POSITION) is POSITION

  -- Initialise Variables

  -- Determine the end nearest to the passed position
  !newPosition = !this.line.near(!position)

  -- Transpose line if we are nearer the end than the start (reverseSense)
  if(!newPosition.distance(!this.line.startPosition) gt !newPosition.distance(!this.line.endPosition)) then
    return !this.line.endPosition
  else
    return !this.line.startPosition
  endif

endmethod
-- End of method definition for .snap(POSITION) POSITION

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description:  Position given distance from nearest end to position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Distance along lne
--    2   R      POSITION    Control position
-- Return:
--   [Data Type] [Description]
--    POSITION    Position given distance from nearest end to position
--
------------------------------------------------------------------------

define method .distance(!distance is REAL, !position is POSITION) is POSITION

  -- Initialise Variables

  -- Determine the end nearest to the passed position
  !newPosition = !this.line.near(!position)

  -- Transpose line if we are nearer the end than the start (reverseSense)
  if(!newPosition.distance(!this.line.startPosition) gt !newPosition.distance(!this.line.endPosition)) then
    !newLine   = !this.line.reverseSense()
  else
    !newLine   = !this.line
  endif

  -- Convert distance into proportion
  !proportion  = !distance / !newLine.length()

  -- Return proportion along length of line
  return !newLine.proportion(!proportion)

endmethod
-- End of method definition for .distance(REAL, POSITION) POSITION

------------------------------------------------------------------------
--
-- Method:      proportion
--
-- Description: Position proportion from nearest end to position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Proportion along lne
--    2   R      POSITION    Control position
-- Return:
--   [Data Type] [Description]
--    POSITION    Position proportion from nearest end to position
--
------------------------------------------------------------------------

define method .proportion(!proportion is REAL, !position is POSITION) is POSITION

  -- Initialise Variables

  -- Determine the end nearest to the passed position
  !newPosition = !this.line.near(!position)

  -- Transpose line if we are nearer the end than the start (reverseSense)
  if(!newPosition.distance(!this.line.startPosition) gt !newPosition.distance(!this.line.endPosition)) then
    !newLine   = !this.line.reverseSense()
  else
    !newLine   = !this.line
  endif

  -- if new position is not on the extent of the line then return
  if (!newLine.onProjected(!newPosition).not()) then
    return !newLine.startPosition
  endif

  -- Return proportion along length of line
  return !newLine.proportion(!proportion)

endmethod
-- End of method definition for .proportion(REAL, POSITION) POSITION

------------------------------------------------------------------------
--
-- Method:      fraction
--
-- Description: Position to nearest fraction to position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Fraction along lne
--    2   R      POSITION    Control position
-- Return:
--   [Data Type] [Description]
--    POSITION    Position to nearest fraction to position
--
------------------------------------------------------------------------

define method .fraction(!fraction is REAL, !position is POSITION) is POSITION

  -- Determine the end nearest to the passed position
  !newPosition = !this.line.near(!position)
  !frac        = !fraction.int()

  -- Transpose line if we are nearer the end than the start (reverseSense)
  if(!newPosition.distance(!this.line.startPosition) gt !newPosition.distance(!this.line.endPosition)) then
    !newLine   = !this.line.reverseSense()
  else
    !newLine   = !this.line
  endif

  -- if new position is not on the extent of the line then return
  if (!newLine.onProjected(!newPosition).not()) then
    return !newLine.startPosition
  endif

  -- Loop through the line until we lie within a new segment
  !start = !newLine.startPosition

  do !i from 1 to !frac
    !end       = !newLine.proportion(!i / !frac)

    -- Does position lie within the segment
    if(!start.line(!end).onProjected(!newPosition)) then

      -- Determine which end we are near and return it
      if(!newPosition.distance(!start) gt !newPosition.distance(!end)) then
        return !end
      else
        return !start
      endif

      break
    endif

    -- Make start, previous end
    !start     = !end
  enddo

  return !newPosition

endmethod
-- End of method definition for .fraction(REAL, POSITION) POSITION

------------------------------------------------------------------------
--
-- Method:      between2Points
--
-- Description: Line between 2 points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    First position
--    2   R      POSITION    Second position
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .between2Points(!startPosition is POSITION, !endPosition is POSITION) is LINE

  -- Initialise Variables
  !return = !startPosition.line(!endPosition)

  -- Return
  return !return

endmethod
-- End of method definition for .between2Points(POSITION, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      angle
--
-- Description: Line angled from passed line in the direction of the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle from reference line
--    2   R      LINE        Reference line to be copied
--    3   R      POSITION    Reference position on original line
--    4   R      POSITION    Control position (line directed to)
--    5   R      POSITION    New start position of line
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .angle(!angle is REAL, !line is LINE, !linePosition is POSITION, !controlPosition is POSITION, !startPosition is POSITION) is LINE

  -- Initialise Variables
  !return               = object LINE()

  -- Project line position onto line
  !lineStart            = !line.near(!linePosition)

  -- Project control position onto line
  !lineControl          = !line.near(!controlPosition)

  -- Reference Plane
  !plane                = !lineStart.plane(!lineControl, !controlPosition)
  !plane.orientation    = object ORIENTATION('X is ' & !lineStart.line(!lineControl).direction() & ' and Z is ' & !plane.direction())
  !plane.position       = !startPosition

  -- Define offset in X and Y or the angle
  !xyOffset             = object XYPOSITION()
  !xyOffset.x           = COS(!angle) * !line.length()
  !xyOffset.y           = SIN(!angle) * !line.length()
  !lineEnd              = !plane.threeDPosition(!xyOffset)

  !return.startPosition = !startPosition
  !return.endPosition   = !lineEnd

  -- Return
  return !return

endmethod
-- End of method definition for .angle(REAL, LINE, POSITION, POSITION, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      copyAt
--
-- Description: Copy passed line and position start at the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Reference line to be copied
--    2   R      POSITION    Position new line is to be directed to
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .copyAt(!line is LINE, !position is POSITION) is LINE

  -- Initialise Variables
  !newLine   = !line.parallel(!position)
  !distance  = !newLine.proportion(0.5).distance(!position)
  if(!distance ge 0.001) then
    !direction = !newLine.proportion(0.5).line(!position).direction()

    -- Construct direction from start to new position
    !return    = !newLine.offset(!direction, !distance)
  else
    !return    = !newLine
  endif

  -- Return
  return !return

endmethod
-- End of method definition for .copyAt(LINE, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Copy passed line, offset by <value> in the direction normal from the line to the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset distance
--    2   R      LINE        Reference line to be copied
--    3   R      POSITION    Position new line is to be directed to
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .offset(!distance is REAL, !line is LINE, !position is POSITION) is LINE

  -- Initialise Variables
  !return = object LINE()

  -- Define direction normal to line
  !nearPoint = !line.near(!position)

  -- Direction
  var !dirStr CONSTRUCT DIRECTION $!nearPoint TO $!position

  -- Define parallel line
  !return = !line.offset(!dirStr.direction(), !distance)

   -- Return
  return !return

endmethod
-- End of method definition for .offset(REAL, LINE, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      offsets
--
-- Description: Copy passed line, <nth> number of time, offset by <value> in the direction normal from the line to the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset distance
--    2   R      REAL        Number of copies
--    3   R      LINE        Reference line to be copied
--    4   R      POSITION    Position new line is to be directed to
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of lines
--
------------------------------------------------------------------------

define method .offsets(!distance is REAL, !number is REAL, !line is LINE, !position is POSITION) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Define direction normal to line
  !nearPoint = !line.near(!position)

  -- Direction
  var !dirStr CONSTRUCT DIRECTION $!nearPoint TO $!position
  !direction = !dirStr.direction()

  -- Loop number of times
  do !i from 1 to !number

    -- Calculate move distance
    !move = !distance * !i

    -- Define parallel line
    !returnArray.append(!line.offset(!direction, !move))
  enddo

  -- Return
  return !returnArray

endmethod
-- End of method definition for .offsets(REAL, REAL, LINE, POSITION) ARRAY

------------------------------------------------------------------------
--
-- Method:      pntTan
--
-- Description: Line between passed point and nearest tangent point on arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Start position of line
--    2   R      ARC         Arc
--    3   R      POSITION    Position on arc for nearest tangent point
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .pntTan(!startPosition is POSITION, !arc is ARC, !arcPosition is POSITION) is LINE

  -- Initialise Variables
  !return             = !startPosition.line(!arcPosition)

  -- Define working plane
  !plane              = object PLANE()
  !plane.position     = !arc.position
  !plane.orientation  = !arc.orientation

  -- Start Position onto plane
  !sPosition          = !plane.near(!startPosition)

  -- Calculate tangent points on arc
  !tangentAngles      = !arc.tangents(!sPosition)

  -- If there are no tangentAngles set, give an error
  if(!tangentAngles.unset()) then
    !!alert.error('no intersection')
    return error 1 noalert
  endif

  -- Determine the nearest tangent point to the pick
  !pointA             = !arc.anglePosition(!tangentAngles[1])
  !pointB             = !arc.anglePosition(!tangentAngles[2])
  if(!arc.position.angle(!arcPosition, !pointA) le !arc.position.angle(!arcPosition, !pointB)) then
    !return.endPosition = !pointA
  else
    !return.endPosition = !pointB
  endif

  -- Return
  return !return

endmethod
-- End of method definition for .pntTan(POSITION, ARC, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      tanTan
--
-- Description: Line between nearest tangent point on passed arcs and positions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         First Arc
--    2   R      POSITION    Position of first arc for nearest tangent point
--    3   R      ARC         Second Arc
--    4   R      POSITION    Position of second arc for nearest tangent point
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tanTan(!primaryArc is ARC, !startPosition is POSITION, !secondaryArc is ARC, !endPosition is POSITION) is LINE

  -- Initialise Variables
  !return               = object LINE()
  !angles               = ARRAY()
  !positionA            = ARRAY()
  !positionB            = ARRAY()
  !newArc               = !secondaryArc

  -- If arcs are not parallel, then map the secondary onto the primary
  if(!primaryArc.orientation.zDir().isParallel(!secondaryArc.orientation.zDir()).not()) then
    !newArc.orientation = !primaryArc.orientation
  endif

  -- Tangent Points
  !tangents             = !primaryArc.tangents(!newArc)

  -- Check circle are not inside each other
  if(!tangents.unset()) then
    !!alert.error('no intersection')
    return error 1 noalert
  endif

  -- Loop thought tangent points
  !max = !tangents.size()
  do !i from 1 to !max by 2
    !j = !i + 1

    -- Distance between the picks and tangent points (as angles)
    !angles.append(!primaryArc.position.angle(!startPosition, !tangents[!i]) + !newArc.position.angle(!endPosition, !tangents[!j]))
    !positionA.append(!tangents[!i])
    !positionB.append(!tangents[!j])
  enddo

  -- Sort angles
  !sort    = !angles.sortedIndices()
  !index   = !sort[1].real()

  -- Define start/end
  !return.startPosition = !positionA[!index]
  !return.endPosition   = !newArc.anglePosition(!newArc.near(!positionB[!index]))

  -- Return
  return !return

endmethod
-- End of method definition for .tanTan(ARC, POSITION, ARC, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      bisect
--
-- Description: Line bisecting two other lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        First line
--    2   R      LINE        Second line
-- Return:
--   [Data Type] [Description]
--    LINE        New Line
--
------------------------------------------------------------------------

define method .bisect(!firstLine is LINE, !secondLine is LINE) is LINE

  -- Get intersection of the two lines
  !pointVector           = object POINTVECTOR()
  !pointVector.position  = !firstLine.intersection(!secondLine)
  !pointVector.direction = !firstLine.direction().bisect(!secondLine.direction())

  -- New Line
  !line = !pointVector.line(!firstLine.length())
  return !line

endmethod
-- End of method definition for .bisect(LINE, LINE) LINE

------------------------------------------------------------------------
--
-- Method:      bisect
--
-- Description: Line bisecting two other lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        First line
--    2   R      POINTVECTOR Derive position on first line for direction
--    3   R      LINE        Second line
--    4   R      POINTVECTOR Derive position on second line for direction
-- Return:
--   [Data Type] [Description]
--    LINE        New Line
--
------------------------------------------------------------------------

define method .bisect(!firstLine is LINE, !firstPoint is POINTVECTOR, !secondLine is LINE, !secondPoint is POINTVECTOR) is LINE

  -- Get picked position on line
  !firstPosition   = !firstLine.intersection(!firstPoint.line(1000mm))
  !secondPosition  = !secondLine.intersection(!secondPoint.line(1000mm))

  -- Intersections of both lines
  !firstIPosition  = !firstLine.intersection(!secondLine)
  !secondIPosition = !secondLine.intersection(!firstLine)

  -- Direction between intersection points and pick positions
  !firstDirection  = !firstIPosition.line(!firstPosition).direction()
  !secondDirection = !secondIPosition.line(!secondPosition).direction()

  -- Create point vector of first intersection point and bisect direction
  !pointVector           = object POINTVECTOR()
  !pointVector.position  = !firstIPosition
  !pointVector.direction = !firstDirection.bisect(!secondDirection)

  -- New Line
  !line = !pointVector.line(!firstLine.length())
  return !line

endmethod
-- End of method definition for .bisect(LINE, POINTVECTOR, LINE, POINTVECTOR) LINE

------------------------------------------------------------------------
--
-- Method:      bisect
--
-- Description: Line bisecting two other lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        First line
--    2   R      POSITION    Position on line
--    3   R      LINE        Second line
--    4   R      POSITION    Position on line
-- Return:
--   [Data Type] [Description]
--    LINE        New Line
--
------------------------------------------------------------------------

define method .bisect(!firstLine is LINE, !firstPosition is POSITION, !secondLine is LINE, !secondPosition is POSITION) is LINE

  -- Intersections of both lines
  !firstIPosition  = !firstLine.intersection(!secondLine)
  !secondIPosition = !secondLine.intersection(!firstLine)

  -- Direction between intersection points and pick positions
  !firstDirection  = !firstIPosition.line(!firstPosition).direction()
  !secondDirection = !secondIPosition.line(!secondPosition).direction()

  -- Create point vector of first intersection point and bisect direction
  !pointVector           = object POINTVECTOR()
  !pointVector.position  = !firstIPosition
  !pointVector.direction = !firstDirection.bisect(!secondDirection)

  -- New Line
  !line = !pointVector.line(!firstLine.length())
  return !line

endmethod
-- End of method definition for .bisect(LINE, POSITION, LINE, POSITION) LINE

------------------------------------------------------------------------
--
-- Method:      twoPlanes
--
-- Description: Line bisecting two other lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       First plane
--    2   R      PLANE       Second plane
-- Return:
--   [Data Type] [Description]
--    LINE        New Line
--
------------------------------------------------------------------------

define method .twoPlanes(!firstPlane is PLANE, !secondPlane is PLANE) is LINE

  -- Intersections of both lines
  return !firstPlane.intersection(!secondPlane)

endmethod
-- End of method definition for .twoPlanes(PLANE, PLANE) LINE

------------------------------------------------------------------------
--
-- Method:      shortest
--
-- Description: Returns the shortest line between the to items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA First pick
--    2   R      EDGPICKDATA Second pick
-- Return:
--   [Data Type] [Description]
--    LINE        New Line
--
------------------------------------------------------------------------

define method .shortest(!first is EDGPICKDATA, !second is EDGPICKDATA) is LINE


  -- Convert to positionData
  !posData[1] = !first.positionData()
  !posData[2] = !second.positionData()

  -- Point to point distance
  if(!posData[1].position.set() and !posData[2].position.set()) then
    !start = !posData[1].position
    !end   = !posData[2].position

  -- Point to Line
  elseif ((!posData[1].position.set() and !posData[2].line.set())  or (!posData[1].line.set()  and !posData[2].position.set())) then

    -- Map position onto line
    if(!posData[2].line.set()) then
      !start = !posData[1].position
      !end   = !posData[2].line.near(!posData[1].position)
    else
      !start = !posData[1].line.near(!posData[2].position)
      !end   = !posData[2].position
    endif

  -- Point to Plane
  elseif ((!posData[1].position.set() and !posData[2].plane.set()) or (!posData[1].plane.set() and !posData[2].position.set())) then

    -- Map position onto line
    if(!posData[2].plane.set()) then
      !start = !posData[1].position
      !end   = !posData[2].plane.near(!posData[1].position)
    else
      !start = !posData[1].plane.near(!posData[2].position)
      !end   = !posData[2].position
    endif

  -- Line to Line
  elseif (!posData[1].line.set() and !posData[2].line.set()) then

    -- Parallel lines, use the picked position on the first for the start
    if(!posData[1].line.direction().isParallel(!posData[2].line.direction())) then
      !start = !posData[1].line.intersection(!posData[1].pointVector)
      handle any
        !start = !posData[1].line.startPosition
      endhandle
      !end   = !posData[2].line.near(!start)

    -- None parallel line (use intersection)
    else
      !start = !posData[1].line.intersection(!posData[2].line)
      !end   = !posData[2].line.intersection(!posData[1].line)
    endif

  -- Line to Plane
  elseif ((!posData[1].line.set() and !posData[2].plane.set()) or (!posData[1].plane.set() and !posData[2].line.set())) then

    -- Define Line/Plane
    if(!posData[1].line.set()) then
      !line        = !posData[1].line
      !plane       = !posData[2].plane
      !pointVector = !posData[1].pointVector
    else
      !line        = !posData[2].line
      !plane       = !posData[1].plane
      !pointVector = !posData[2].pointVector
    endif

    -- Project line onto plane (if they are parallel, then as above)
    !projectedLine = !line.projected(!plane)
    if(!line.direction().isParallel(!projectedLine.direction())) then
      !start = !line.intersection(!pointVector)
      handle any
        !start = !line.startPosition
      endhandle
      !end   = !projectedLine.near(!start)

    -- If lines are not parallel, then they must intersect, therefore it zero length
    else
      !start = N0
      !end   = N0
    endif

  -- Plane to Plane
  elseif (!posData[1].plane.set() and !posData[2].plane.set()) then

    -- Only parallel planes can be used
    if(!posData[1].plane.direction().isParallel(!posData[2].plane.direction())) then
      !start = !posData[1].line.intersection(!posData[1].pointVector)
      handle any
        !start = !posData[1].plane.position
      endhandle
      !end   = !posData[2].plane.near(!start)

    -- If lines are not parallel, then they must intersect, therefore it zero length
    else
      !start = N0
      !end   = N0
    endif

  endif

  -- Handle zero length line
  if(!start.distance(!end) eq 0) then
    return object LINE()
  else
    return !start.line(!end)
  endif

endmethod
-- End of method definition for .shortest(EDGPICKDATA, EDGPICKDATA) LINE

------------------------------------------------------------------------
--
-- Method:      parallel
--
-- Description: Return gmfline line parallel to passed about the start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line to be made parallel with
-- Return:
--   [Data Type] [Description]
--    LINE        New Line
--
------------------------------------------------------------------------

define method .parallel(!parallelLine is LINE) is LINE

  -- Initialise Variables
  !line    = !this.line

  -- Move reference line through origin of line
  !refLine = !parallelLine.parallel(!this.line.startPosition)

  -- Map end position onto reference line
  !line.endPosition = !refLine.near(!this.line.endPosition)
  !line             = !line.setLengthEnd(!this.line.length())

  return !line

endmethod
-- End of method definition for .parallel(LINE) LINE
