--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  through3Points(POSITION,POSITION,POSITION) PLANE               Plane through 3 points (Y is from 1 to 2)
--
------------------------------------------------------------------------

-- Define object
define object GMFPLANE

  -- Dummy member
  member .dummy is STRING

endobject
-- End of object definition for GMFPLANE

------------------------------------------------------------------------
--
-- Method:      through3Points
--
-- Description:
--   Plane through 3 points (Y is from 1 to 2)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    First position (centre)
--    2   R      POSITION    Second position (X)
--    3   R      POSITION    Third position (Y)
-- Return:
--   [Data Type] [Description]
--    PLANE       Defined plane
--
------------------------------------------------------------------------

define method .through3Points(!centrePosition is POSITION, !xPosition is POSITION, !yPosition is POSITION) is PLANE

  -- Initialise Variables
  !return     = !centrePosition.plane(!xPosition, !yPosition)

  -- Make X direction from
  !xDirection = !centrePosition.line(!xPosition).direction()

  -- Define Orientation using position
  !return.orientation = object ORIENTATION('X is ' & !xDirection & ' AND Z is ' & !return.direction())

  -- Return
  return !return

endmethod
-- End of method definition for .through3Points(POSITION, POSITION, POSITION) PLANE
