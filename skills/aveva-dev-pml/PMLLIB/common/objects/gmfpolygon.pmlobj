--
--
-- Description:
-- Polygon handler.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clockwise()                      BOOLEAN
--  clockwise(BOOLEAN)               REAL
--  contract(REAL)                   -                   Contract edges by passed value
--  expand(REAL)                     -                   Expand edges by passed value
--  gmfPolygon(DBREF)                -
--  gmfPolygon(PLANE,ARRAY)          -
--  mirror(LINE)                     -                   Mirror the points about the passed line
--  nearestEdge(POINTVECTOR)         REAL                Return point at beginning of edge, nearest to point of intersection of point vector on plane, making the edge of the polygon
--  nearestEdge(POSITION)            REAL                Return point at beginning of edge, nearest to position on plane, making the edge of the polygon
--  nearestPoint(POINTVECTOR)        REAL                Return point index nearest to point of intersection of point vector and plane
--  nearestPoint(POSITION)           REAL                Return point index nearest to position on plane, making the edge of the polygon
--  offset(DIRECTION,REAL)           -                   Offset the polygon by 3D direction and distance
--  offset(REAL,REAL)                -                   Offset the polygon by angle (from x) and distance
--  offset(XYPOSITION)               -                   Offset the polygon by XY value
--  offsetEdges(REAL)                -                   Offset loop by passed value
--  outOfBounds(POSITION)            BOOLEAN             Returns whether the passed position
--  outOfBounds(XYPOSITION)          BOOLEAN             Returns whether the passed position
--  position(REAL,POSITION)          -                   Position polygon point at position, maintaining relative position of other points
--  position(REAL,XYPOSITION)        -                   Position polygon point at position, maintaining relative position of other points
--  position(XYPOSITION,XYPOSITION)  -                   Moves the polygon the difference between passed positions
--  reverseOrder()                   -                   Reverses the order of the polygon definition
--  rotate(REAL,POSITION)            -                   Rotates the points about the passed point
--  rotate(REAL,XYPOSITION)          -                   Rotates the points about the passed point
--  within(GMFPOLYGON)               ARRAY               Returns the index positions of !this which lie within passed polygon
--
------------------------------------------------------------------------

define object GMFPOLYGON

  -- Array of XY positions
  member .positions is ARRAY

  -- Plane of polygon
  member .plane     is PLANE

endobject
-- End of object definition for GMFPOLYGON

------------------------------------------------------------------------
--
-- Method:      gmfpolygon
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfPolygon(!loop is DBREF)

  !this.gmfPolygon(object PLANE(!loop.owner.position, !loop.owner.orientation), !loop.members)

endmethod
-- End of method definition for .gmfPolygon(DBREF)

------------------------------------------------------------------------
--
-- Method:      gmfpolygon
--
-- Description: Constructor, passed array of element MUST have the same owner
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane points are to be mapped onto
--    1   R      ARRAY       Array of "loop" elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfPolygon(!plane is PLANE, !loop is ARRAY)

  -- Initialise Variables
  !this.plane     = !plane
  !this.positions.clear()

  -- Get all positions (only XY component of Loop)
  do !i indices !loop
    !this.positions[!i] = object XYPOSITION(!loop[!i].position.east, !loop[!i].position.north)
  enddo

  -- Remove any duplicated points
--  !this.positions.unique()

endmethod
-- End of method definition for .gmfPolygon(PLANE, ARRAY)

------------------------------------------------------------------------
--
-- Method:      clockWise
--
-- Description: Returns true is the orientation of the path is clock-wise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Returns true for clock wise path
--
------------------------------------------------------------------------

define method .clockwise() is BOOLEAN

  -- Initialise Variables

  -- Determine clock-wise or anti-clock-wise polygon
  !line      = object LINE(!this.plane.threeDPosition(!this.positions[1]), !this.plane.threeDPosition(!this.positions[2]))
  !direction = !this.plane.orientation.zDir().orthogonal(!line.direction())
  !position  = !line.proportion(0.5).offset(!direction, 1mm)

  -- return true if position is outside polygon
  !outside = !this.outOfBounds(!position)
  !return  = !outside.not()

  return !return
endmethod
-- End of method definition for .clockwise() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      clockWise
--
-- Description: override version of clockWise
-- returns 1 if clockwise, -1 if anti-clockwise and 0 if unable to determine path direction
-- e.g. if looking at coincident points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL     Returns 1 for clockwise path, -1 for anti-clockwise and 0 for unable to establish
--
------------------------------------------------------------------------

define method .clockwise(!dummyTestForCoincident is BOOLEAN) is REAL

  -- Initialise Variables

  -- Determine clock-wise or anti-clock-wise polygon
  !line      = object LINE(!this.plane.threeDPosition(!this.positions[1]), !this.plane.threeDPosition(!this.positions[2]))
  handle any
    return 0
  endhandle
  if (!line.startPosition eq !line.endPosition) then
  	return 0
  endif
  !direction = !this.plane.orientation.zDir().orthogonal(!line.direction())
  handle any
    return 0
  endhandle
  !position  = !line.proportion(0.5).offset(!direction, 1mm)

  -- return true if position is outside polygon
  !outside = !this.outOfBounds(!position)
  !return  = !outside.not()
  if (!return) then
  	return 1
  else
  	return -1
  endif
endmethod
-- End of method definition for .clockwise() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      contract
--
-- Description: Contract edges by passed value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .contract(!offset is REAL)
  !this.offsetEdges(abs(!offset) * -1)
endmethod
-- End of method definition for .contract(REAL)

------------------------------------------------------------------------
--
-- Method:      expand
--
-- Description: Expand edges by passed value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expand(!offset is REAL)
  !this.offsetEdges(abs(!offset))
endmethod
-- End of method definition for .expand(REAL)

------------------------------------------------------------------------
--
-- Method:      offsetEdges
--
-- Description: Offset loop by passed value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetEdges(!offset is REAL)

  -- Initialise Variables
  -- Positions
  !positions = !this.positions

  -- Close loop
  if (!positions[!this.positions.size()] ne !positions[1]) then
    !positions.append(!this.positions[1])
  endif
  !clockwise = !this.clockwise(true)
  if(!clockwise eq 0) then
    --need to find a more elegant way of handing coincident points eventually!
    !!alert.warning('Unable to perform Expand/Contract operation due to coincident vertices')
    return
  endif

  -- Offset each line by given value
  do !i indices !this.positions
    !end = !i + 1
    if (!end gt !positions.size()) then
    	!end = 1
    endif
    !line      = object LINE(!this.plane.threeDPosition(!positions[!i]), !this.plane.threeDPosition(!positions[!end]))
    !direction = !this.plane.orientation.zDir().orthogonal(!line.direction())
    handle any
       return
    endhandle
    !lines[!i] = !line.offset(!direction, !offset * !clockwise)
  enddo

  -- Add last line to beginning of list
  !lines.insert(1,!lines[!lines.size()])

  -- Get New position points
  do !i from 1 to !lines.size() - 1
    !notPar = !lines[!i].direction().isParallel(!lines[!i + 1].direction()).not()
    if (!notPar) then
      !this.positions[!i] = !this.plane.xyOffset(!lines[!i].intersection(!lines[!i + 1]))
      handle any
        --the intersection method appears to have a bit of tolerance built into it which
        --means that it will fail to find an intersection if the two lines are very nearly
        --but not quite parallel
        !this.positions[!i] = !this.plane.xyOffset(!lines[!i].endPosition)
      endhandle
    else
      !this.positions[!i] = !this.plane.xyOffset(!lines[!i].endPosition)
    endif
  enddo

endmethod
-- End of method definition for .offsetEdges(REAL)

------------------------------------------------------------------------
--
-- Method:      outOfBounds
--
-- Description: Returns whether the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    3D Position to check
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if outside polygon, false if within it
--
------------------------------------------------------------------------

define method .outOfBounds(!position is POSITION) is BOOLEAN

  return !this.outOfBounds(!this.plane.xyOffset(!position))

endmethod
-- End of method definition for .outOfBounds(POSITION) BOOLEAN


------------------------------------------------------------------------
--
-- Method:      outOfBounds
--
-- Description: Returns whether the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  2D Position to check
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if outside polygon, false if within it
--
------------------------------------------------------------------------

define method .outOfBounds(!xyPosition is XYPOSITION) is BOOLEAN
  -- Initialise Variables
  !size       = !this.positions.size()
  !tan        = ARRAY()

  -- Total Angle
  !totalAngle = 0

  -- Map position onto plane
--   !block      = object BLOCK('!this.positions[!evalIndex].x - !xyPosition.x')
--   !x          = !this.positions.evaluate(!block)
--   !block      = object BLOCK('!this.positions[!evalIndex].y - !xyPosition.y')
--   !y          = !this.positions.evaluate(!block)

  do !i indices !this.positions
    !x[!i] = !this.positions[!i].x - !xyPosition.x
    !y[!i] = !this.positions[!i].y - !xyPosition.y
  enddo

  -- Get angles of all points
  -- Formula
  --          (x1 * y2) - (x2 * y1)
  -- tan(a) = ---------------------
  --          (x1 * x2) + (y1 * y2)

  -- Loop through all vertices
  do !i from 1 to !size - 1
    !j        = !i + 1
    !tan[!i]  = ATANT((!x[!i] * !y[!j]) - (!x[!j] * !y[!i]), (!x[!i] * !x[!j]) + (!y[!i] * !y[!j]))
     handle (2,433)
      return true
    endhandle
    if(!tan[!i].between(179.9999, 180.0001)) then
      return true
    endif
    !totalAngle   = !totalAngle + !tan[!i]
  enddo

  -- Last Edge (from first to last point creating a closed loop)
  !tan[!size]  = ATANT( (!x[!size] * !y[1]) - (!x[1] * !y[!size]) , (!x[!size] * !x[1]) + (!y[!size] * !y[1]))
  handle (2,433)
    return true
  endhandle

  if(!tan[!size].between(179.9999, 180.0001)) then
    return true
  endif

 !totalAngle   = ABS(!totalAngle + !tan[!size])

  -- If angle is near 360 degrees then its inside the polygon
  return !totalAngle.between(359.999, 360.001)

endmethod
-- End of method definition for .outOfBounds(XYPOSITION) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotates the points about the passed point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      POSITION    Rotation point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!rotateAngle is REAL, !xyPosition is XYPOSITION)

  !this.rotate(!rotateAngle, !this.plane.threeDPosition(!xyPosition))

endmethod
-- End of method definition for .rotate(REAL, XYPOSITION)

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotates the points about the passed point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      POSITION    Rotation point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!rotateAngle is REAL, !position is POSITION)

  -- Initialise Variables
  !angle  = !rotateAngle

  -- Define rotation plane, i.e. polygon plane reposition to passed position
  !plane          = !this.plane
  !plane.position = !this.plane.near(!position)

  !direction = !plane.position.direction(!plane.threeDPosition(object XYPOSITION(cos(!rotateAngle) * 1000, sin(!rotateAngle) * 1000)))
  handle any
    return
  endhandle
  -- Re orientate plane
  !ori = object ORIENTATION('Z is ' & !plane.direction() & ' and X is ' & !direction)
  !plane.orientation = !ori

  do !i indices !this.positions

    -- Get position of points wrt to new plane
    !newXY              = !this.plane.xyOffset(!this.plane.threeDPosition(!this.positions[!i]))
    -- Set position wrt to offset plane
    !this.positions[!i] = !this.plane.xyOffset(!plane.threeDPosition(!newXY))
  enddo

endmethod
-- End of method definition for .rotate(REAL, POSITION)

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror the points about the passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Mirror line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror(!line is LINE)

  -- Initialise Variables

  -- Define mirror plane, i.e. direction of polygon and direction of line
  !plane              = !this.plane
  !plane.orientation  = object ORIENTATION('Z is ' & !this.plane.orientation.zDir() & ' and Y is ' & !line.direction())
  !plane.position     = !line.near(!this.plane.position)

  -- Mirror plane
  !mPlane             = !plane
  !mPlane.orientation = object ORIENTATION('Z is ' & !this.plane.orientation.zDir().opposite() & ' and Y is ' & !line.direction())

  -- loop through points
  do !i indices !this.positions
    -- Get position of points wrt to new plane
    !newXY              = !plane.xyOffset(!this.plane.threeDPosition(!this.positions[!i]))

    -- Set position wrt to offset plane
    !this.positions[!i] = !this.plane.xyOffset(!mPlane.threeDPosition(!newXY))
  enddo

endmethod
-- End of method definition for .mirror(LINE)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset the polygon by 3D direction and distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Direction of offset
--    2   R      REAL        Distance of offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!direction is DIRECTION, !distance is REAL)

  -- Initialise Variables

  -- Map direction onto plane
  !newDirection = !direction.projected(!this.plane)

  -- Determine new position
  !newPosition  = !this.plane.position.offset(!newDirection, !distance)

  -- Offset
  !this.offset(!this.plane.xyOffset(!newPosition))

endmethod
-- End of method definition for .offset(DIRECTION, REAL)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset the polygon by angle (from x) and distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Direction of offset
--    2   R      REAL        Distance of offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!angle is REAL, !distance is REAL)

  -- Initialise Variables
  !x = !angle.cosine() * !distance
  !y = !angle.sine()   * !distance

  -- Get difference from passed position to reference vertex position
  !this.offset(object XYPOSITION(!x, !y))

endmethod
-- End of method definition for .offset(REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset the polygon by XY value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    2   R      XYPOSITION  Offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!xyPosition is XYPOSITION)

  -- Initialise Variables

  -- Loop through positions and offset the, by passed values
  do !i indices !this.positions
    !this.positions[!i] = object XYPOSITION(!xyPosition.x + !this.positions[!i].x, !xyPosition.y + !this.positions[!i].y)
  enddo

endmethod
-- End of method definition for .offset(XYPOSITION)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position polygon point at position, maintaining relative position of other points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Point to be positioned
--    2   R      XYPOSITION New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!vertex is REAL, !xyPosition is XYPOSITION)

  -- Initialise Variables
  !polygon = !this

  -- Get difference from passed position to reference vertex position
  !this.offset(object XYPOSITION(!xyPosition.x - !this.positions[!vertex].x, !xyPosition.y - !this.positions[!vertex].y))

endmethod
-- End of method definition for .position(REAL, XYPOSITION)


------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Moves the polygon the difference between passed positions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION From position
--    2   R      XYPOSITION New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!fromPosition is XYPOSITION, !toPosition is XYPOSITION)

  -- Get difference from passed position to reference vertex position
  !this.offset(object XYPOSITION(!toPosition.x - !fromPosition.x, !toPosition.y - !fromPosition.y))

endmethod
-- End of method definition for .position(XYPOSITION, XYPOSITION)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position polygon point at position, maintaining relative position of other points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Point to be positioned
--    2   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!vertex is REAL, !position is POSITION)

  -- Initialise Variables
  !this.position(!vertex, !this.plane.xyPosition(!position))

endmethod
-- End of method definition for .position(REAL, POSITION)

------------------------------------------------------------------------
--
-- Method:      reverseOrder
--
-- Description: Reverses the order of the polygon definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reverseOrder()

  -- Initialise Variables
  !this.positions.invert()

endmethod
-- End of method definition for .reverseOrder()

------------------------------------------------------------------------
--
-- Method:      within
--
-- Description: Returns the index positions of !this which lie within passed polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFPOLYGON  Polygon
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of index pointers into current polygon
--
------------------------------------------------------------------------

define method .within(!polygon is GMFPOLYGON) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Convert passed polygon into the same frame of reference as the current
  !newPolygon  = !polygon

  do !i indices !polygon.positions
    !newPolygon.positions[!i] = !this.plane.xyOffset(!polygon.plane.threeDPosition(!polygon.positions[!i]))
  enddo
  !newPolygon.plane = !this.plane

  -- Loop through passed polygon
  do !i indices !this.positions
    skip if(!newPolygon.outOfBounds(!this.positions[!i]).not())
    !returnArray.append(!i)
  enddo
  return !returnArray

endmethod
-- End of method definition for .within(GMFPOLYGON) ARRAY

------------------------------------------------------------------------
--
-- Method:      nearestEdge
--
-- Description: Return point at beginning of edge, nearest to point of intersection of point vector on plane, making the edge of the polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    REAL        Edge start point
--
------------------------------------------------------------------------

define method .nearestEdge(!pointVector is POINTVECTOR) is REAL

  -- Initialise Variables
  return !this.nearestEdge(!this.plane.intersection(!pointVector))

endmethod
-- End of method definition for .nearestEdge(POINTVECTOR) REAL

------------------------------------------------------------------------
--
-- Method:      nearestEdge
--
-- Description: Return point at beginning of edge, nearest to position on plane, making the edge of the polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--    REAL        Edge start point
--
------------------------------------------------------------------------

define method .nearestEdge(!position is POSITION) is REAL
  -- Initialise Variables
  -- Polygon used to derive edges
  !edges = !this.positions
  !edges.append(!this.positions[1])

  -- Project position onto plane
  !newPosition = !this.plane.near(!position)
  -- Loop through all edges
  do !i indices !this.positions
    !j = !i + 1

    -- Line of edge
    !line = !this.plane.threeDPosition(!edges[!i]).line(!this.plane.threeDPosition(!edges[!j]))

    -- Don't include lines of zero length
    skip if(!line.startPosition.distance(!line.endPosition) eq 0)

    -- If position is out of bounds of the line, ignore it
    skip if(!line.onProjected(!newPosition).not())

    -- Calculate distance between position and line
    !distances[!i] = !line.distance(!newPosition)

  enddo
  --make sure there are some values, otherwise
  -- Sort into order
  !sort = !distances.sortedIndices()
  handle any
    return 0
  endhandle
  -- Return
  return !sort[1]

endmethod
-- End of method definition for .nearestEdge(POSITION) REAL

------------------------------------------------------------------------
--
-- Method:      nearestPoint
--
-- Description: Return point index nearest to point of intersection of point vector and plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Point vector
-- Return:
--   [Data Type] [Description]
--    REAL        Index to nearest point
--
------------------------------------------------------------------------

define method .nearestPoint(!pointVector is POINTVECTOR) is REAL

  -- Initialise Variables
  return !this.nearestPoint(!this.plane.intersection(!pointVector))

endmethod
-- End of method definition for .nearestPoint(POINTVECTOR) REAL

------------------------------------------------------------------------
--
-- Method:      nearestPoint
--
-- Description: Return point index nearest to position on plane, making the edge of the polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--    REAL        Index to nearest point
--
------------------------------------------------------------------------

define method .nearestPoint(!position is POSITION) is REAL

  -- Initialise Variables

  -- Loop through
  do !i indices !this.positions
    !distances[!i] = !position.distance(!this.plane.threeDPosition(!this.positions[!i]))
  enddo

  -- Sort into sequences
  !sort = !distances.sortedIndices()

  return !sort[1]

endmethod
-- End of method definition for .nearestPoint(POSITION) REAL
