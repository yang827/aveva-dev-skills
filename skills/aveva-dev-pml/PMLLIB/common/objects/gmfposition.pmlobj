--
-- Description:
-- Position construction methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  nearestTanPoint(ARC,POSITION,POSITION) POSITION            Nearest tangent point on an arc to the passed position
--  polarPoint(ARC)                  POSITION            Returns position at polar point of arc
--  polarPoint(POSITION,REAL,POSITION,POSITION,POSITION) POSITION            polarPoint(POSITION,   POSITION     Returns polar position at
--
------------------------------------------------------------------------

-- Define object
define object GMFPOSITION

  -- Dummy member
  member .dummy is STRING

endobject
-- End of object definition for GMFPOSITION

------------------------------------------------------------------------
--
-- Method:      polarPoint
--
-- Description:
--   Fixed diameter Circle onto passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc position
-- Return:
--   [Data Type] [Description]
--    POSITION    Polar position
--
------------------------------------------------------------------------

define method .polarPoint(!arc is ARC) is POSITION

  -- Initialise Variables
  !return = object POSITION()

  -- Determine if we have a major/minor arc
  !angle  = !arc.angle()
  if(!arc.sense.not()) then
    !angle = 360 - !angle
  endif

  -- If arc angle => 180 degree, don't allow
  if(!arc.angle() ge 180) then
    return error 1 'Arc angle equal or greater than 180 degrees.'
  endif

  --- Calculate tangent angles
  !startDirection = !arc.position.line(!arc.anglePosition(!arc.startAngle)).direction()
  !endDirection   = !arc.position.line(!arc.anglePosition(!arc.endAngle)).direction()

  -- Tangelt point
  !pointVectorA           = object POINTVECTOR()
  !pointVectorA.position  = !arc.anglePosition(!arc.startAngle)
  !pointVectorA.direction = !startDirection.orthogonal(!arc.orientation.zDir())
  !pointVectorB           = object POINTVECTOR()
  !pointVectorB.position  = !arc.anglePosition(!arc.endAngle)
  !pointVectorB.direction = !endDirection.orthogonal(!arc.orientation.zDir())
  !return = !pointVectorA.intersection(!pointVectorB)

  return !return

endmethod
-- End of method definition for .polarPoint(ARC) POSITION

------------------------------------------------------------------------
--
-- Method:      polarPoint
--
-- Description:
--    polarPoint(POSITION,   POSITION     Returns polar position at
--               RADIUS,                  at intersection of tangent
--               POSITION,                lines between two points an
--               POSITION,                an arc of radius centred at
--               POSITION)                a position
--   Fixed diameter Circle onto passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Arc centre
--    2    R     REAL        Arc radius
--    3    R     POSITION    First point
--    4    R     POSITION    Second Point
--    5    R     POSITION    Arc control point
-- Return:
--   [Data Type] [Description]
--    POSITION    Polar position
--
------------------------------------------------------------------------

define method .polarPoint(!centre is POSITION, !radius is REAL, !start is POSITION, !end is POSITION, !control is POSITION) is POSITION

  -- Define arc plane
  !plane = !centre.plane(!start, !end)

  -- Arc
  !arc   = object ARC()
  !arc.position    = !centre
  !arc.orientation = !plane.orientation
  !arc.radius      = !radius
  !arc.sense       = true
  !arc.startAngle  = 0
  !arc.endAngle    = 180

  -- Get tangent of first point on arc
  PIN1 AT $!start
  PIN2 AT $!end
  PIN3 AT $!control

  !tangentA        = !this.nearestTanPoint(!arc, !start, !control)
  !tangentB        = !this.nearestTanPoint(!arc, !end, !control)

  -- Intersection of line
  !lineA           = object LINE()
  !lineA.startPosition = !start
  !lineA.endPosition   = !tangentA
  !lineB           = object LINE()
  !lineB.startPosition = !end
  !lineB.endPosition   = !tangentB

  -- Return
  return !lineA.intersection(!lineB)

endmethod
-- End of method definition for .polarPoint(POSITION, REAL, POSITION, POSITION, POSITION) POSITION

------------------------------------------------------------------------
--
-- Method:      nearestTanPoint
--
-- Description:
--   Nearest tangent point on an arc to the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc position
--    2   R      POSITION    Start Point
--    3   R      POSITION    Control point to tangent
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .nearestTanPoint(!arc is ARC, !start is POSITION, !control is POSITION) is POSITION

  -- Intersection of point onto arc
  !angles    = !arc.tangents(!start)

  -- If there are no angles, then the is no intersection
  if(!angles.unset()) then
    !!alert.error('No intersections.')
    return error 1 noalert
  endif

  -- Get position on arc picked
  !nearAngle = !arc.near(!control)

  -- Get angles between points
  !angleA = !arc.position.angle(!arc.anglePosition(!nearAngle), !arc.anglePosition(!angles[1]))
  !angleB = !arc.position.angle(!arc.anglePosition(!nearAngle), !arc.anglePosition(!angles[2]))

  -- Return relevant position
  if(!angleA lt !angleB) then
    return !arc.anglePosition(!angles[1])
  else
    return !arc.anglePosition(!angles[2])
  endif

endmethod
-- End of method definition for .nearestTanPoint(ARC, POSITION, POSITION) POSITION
