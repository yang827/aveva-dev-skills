-- File:            gmfrotate.pmlobj
--   Type:          Object Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Dec 9 9:13:19 "GMT 1999
--
--
-- Description:
-- Rotates the passed geometry objects about a point vector by a given angle.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gmfRotate(LINE,ANY)              -                   Constructor, using line and list of items to rotate
--  gmfRotate(PLANE,ANY)             -                   Constructor, using plane and list of items to rotate
--  gmfRotate(POINTVECTOR,ANY)       -                   Constructor, using point vector and list of items to rotate
--  rotate()                         ANY                 Returns array of items rotated by current angle
--  rotate(REAL)                     ANY                 Returns array of items rotated by specified amount
--  rotate(REAL,LINE,ANY)            ANY                 Returns array of items rotated by specified amount about a line
--  rotate(REAL,PLANE,ANY)           ANY                 Returns array of items rotated by specified amount about a plane
--  rotate(REAL,POINTVECTOR,ANY)     ANY                 Returns array of items rotated by specified amount about a point vector
--
------------------------------------------------------------------------

define object GMFROTATE

  -- List of objects to be rotated
  member .members    is ARRAY

  -- Single item rotate
  member .singleItem is BOOLEAN

  -- Angle of rotation
  member .angle      is REAL

  -- Rotation plane
  member .plane      is PLANE

  -- Rotation line
  member .axes       is LINE

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      gmfRotate
--
-- Description: Constructor, using plane and list of items to rotate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane of rotation
--    2   R      ANY         Any geometrical item or array of them
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfRotate(!plane is PLANE, !members is ANY)

  -- Initialise Variables
  !this.plane   = !plane
  !this.axes    = !plane.line(1000mm)
  !this.members.clear()

  -- If none array passed, then we will use single item rotation
  if(!members.objectType() ne 'ARRAY') then
    !this.singleItem = true
    !this.members[1] = !members
  else
    !this.singleItem = false
    !this.members    = !members
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gmfRotate
--
-- Description: Constructor, using point vector and list of items to rotate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Point of rotation
--    2   R      ANY         Any geometrical item or array of them
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfRotate(!pointVector is POINTVECTOR, !members is ANY)
  !this.gmfRotate(!pointVector.plane(), !members)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gmfRotate
--
-- Description: Constructor, using line and list of items to rotate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line of rotation
--    2   R      ANY         Any geometrical item or array of them
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfRotate(!line is LINE, !members is ANY)
  !this.gmfRotate(!line.plane(), !members)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Returns array of items rotated by specified amount about a plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      PLANE       Plane of rotation
--    3   R      ANY         Any geometrical item or array of them
-- Return:
--   [Data Type] [Description]
--    ANY         Geometrical item or array of them rotated
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL, !plane is PLANE, !members is ANY) is ANY

  -- Initialise Variables
  !this.gmfRotate(!pointVector, !members)
  !this.angle = !angle

  -- Return result
  return !this.rotate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Returns array of items rotated by specified amount about a point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      POINTVECTOR Point of rotation
--    3   R      ANY         Any geometrical item or array of them
-- Return:
--   [Data Type] [Description]
--    ANY         Geometrical item or array of them rotated
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL, !pointVector is POINTVECTOR, !members is ANY) is ANY

  -- Initialise Variables
  !this.gmfRotate(!pointVector, !members)
  !this.angle = !angle

  -- Return result
  return !this.rotate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Returns array of items rotated by specified amount about a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      LINE        Line (axes) of rotation
--    3   R      ANY         Any geometrical item or array of them
-- Return:
--   [Data Type] [Description]
--    ANY         Geometrical item or array of them rotated
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL, !line is LINE, !members is ANY) is ANY

  -- Initialise Variables
  !this.gmfRotate(!line, !members)
  !this.angle = !angle

  -- Return result
  return !this.rotate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Returns array of items rotated by specified amount
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
-- Return:
--   [Data Type] [Description]
--    ANY         Geometrical item or array of them rotated
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL) is ANY

  -- Set rotation angle
  !this.angle = !angle

  -- Return result
  return !this.rotate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Returns array of items rotated by current angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ANY         Geometrical item or array of them rotated
--
------------------------------------------------------------------------

define method .rotate() is ANY

  -- Initialise Variables
  !return   = ARRAY()

  -- Check we have items to return (by default an unset array is returned)
  if(!this.members.empty()) then
    return object ARRAY()
  endif

  -- If for some reason, i.e. a user have changed the members list directly
  -- rather than using the appropriate method. We could have a singleItem
  -- setting but a members list with more than one entry. In this case, we
  -- will automatically set the singleItem flag to true
  if(!this.singleItem and !this.members.size() gt 1) then
    !this.singleItem = false
  endif

  -- Define planes
  !plane                    = !this.plane

  !y = sin(!this.angle) * 1000mm
  !x = cos(!this.angle) * 1000mm

  !rPlane             = !this.plane
  !rPlane.orientation = object ORIENTATION('Z is ' & !plane.direction() & ' and X is ' & !plane.position.direction(!plane.threeDPosition(object XYPOSITION(!x, !y))))

  -- Loop through all the elements in the list
  do !i indices !this.members

    -- Rotate a line
      !this.members[!i].draw(1,1,1)
    if(!this.members[!i].objectType() eq 'LINE') then

      !plane.position         = !this.axes.near(!this.members[!i].startPosition)
      !rPlane.position        = !plane.position
      !xyStart                = !plane.xyOffset(!this.members[!i].startPosition)
      !start                  = !rPlane.threeDPosition(!xyStart)

      !plane.position         = !this.axes.near(!this.members[!i].endPosition)
      !rPlane.position        = !plane.position
      !xyEnd                  = !plane.xyOffset(!this.members[!i].endPosition)
      !end                    = !rPlane.threeDPosition(!xyEnd)

      !return[!i]             = object LINE(!start, !end)

    -- Rotate other object (assume items have position and orientation)
    else
      !return[!i]             = !this.members[!i]

      -- Rotate Position
      !plane.position         = !this.axes.near(!this.members[!i].position)
      !rPlane.position        = !plane.position
      !xyPosition             = !plane.xyOffset(!this.members[!i].position)
      !position               = !rPlane.threeDPosition(!xyPosition)

      -- Rotate Orientation
      !xUnit                  = !this.members[!i].position.offset(!this.members[!i].orientation.xDir(), 1000mm)
      !plane.position         = !this.axes.near(!xUnit)
      !rPlane.position        = !plane.position
      !xyXunit                = !plane.xyOffset(!xUnit)
      !xPosition              = !rPlane.threeDPosition(!xyXunit)

      !yUnit                  = !this.members[!i].position.offset(!this.members[!i].orientation.yDir(), 1000mm)
      !plane.position         = !this.axes.near(!yUnit)
      !rPlane.position        = !plane.position
      !xyYunit                = !plane.xyOffset(!yUnit)
      !yPosition              = !rPlane.threeDPosition(!xyYunit)

      !return[!i].orientation = object ORIENTATION('X is ' & !position.direction(!xPosition) & ' and Y is ' & !position.direction(!yPosition))
      !return[!i].position    = !position

    endif
    !return[!i].draw(2,3,4)

  enddo

  -- Return result
  if(!this.singleItem) then
    return !return[1]
  else
    return !return
  endif

endmethod
-- End of method
