--
--
-- Description:
-- Spine definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  centre(ARC)                      -                   Constructor to sets point as a arc point
--  centre(DBREF)                    -                   Constructor to sets point as a centre arc from passed curve
--  control(DBREF)                   -                   Constructor to sets point as a control arc from passed poinsp
--  control(POSITION)                -                   Constructor to sets point as a control point
--  curve(DBREF)                     -                   Constructor to sets point to passed curve
--  curvePoint(REAL)                 GMFSPINEPOINT       Return curve point definition from definition list, i.e any point where the position member is unset
--  curvePoints()                    REAL                Return number of curve points
--  end()                            POSITION            Return end point position
--  endPoint()                       GMFSPINEPOINT       Return start point definition
--  fillet(ARC)                      -                   Constructor to sets point as a fillet point
--  fillet(DBREF)                    -                   Constructor to sets point as a fillet arc from passed curve
--  gmfSpine(ARRAY)                  -                   Constructor, using passed array of arcs to define the spine.
--  gmfSpine(DBREF)                  -                   Constructor, using passed array of arcs to define the spine.
--  start()                          POSITION            Return start point position
--  startPoint()                     GMFSPINEPOINT       Return start point definition
--  tangent(POSITION)                -                   Constructor to sets point as a tangent point
--
------------------------------------------------------------------------

define object GMFSPINE

  -- Reference spine
  member .spine     is DBREF

  -- Spine definition (array of spine points)
  member .points    is ARRAY

endobject
-- End of object definition for GMFSPINE

------------------------------------------------------------------------
--
-- Method:      gmfSpine
--
-- Description: Constructor, using passed array of arcs to define the spine.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Spine used to define definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfSpine(!spine is DBREF)

  -- Initialise Variables
  !this.spine = !spine

  -- Build list of points up
  do !i indices !this.spine.members

    -- Determine the type of the point

    -- Control points
    if(!this.spine.members[!i].fullType eq 'POINSP') then
      !this.control(!this.spine.members[!i])

    -- Curve point
    elseif (!this.spine.members[!i].fullType eq 'CURVE') then
      !this.curve(!this.spine.members[!i])
    endif

  enddo

endmethod
-- End of method definition for .gmfSpine(DBREF)

------------------------------------------------------------------------
--
-- Method:      gmfSpine
--
-- Description: Constructor, using passed array of arcs to define the spine.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of arcs used to define spine
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gmfSpine(!definition is ARRAY)

  -- Initialise Variables
  !max      = !definition.size()
  !points   = ARRAY()
  !point    = object GMFSPINEPOINT()
  !this.points.clear()

  -- Loop through the definition
  do !i indices !definition

    -- Initialise
    !control = false
    !tangent = false

    -- If the definition has a radius, it must be an arc
    if(!definition[!i].radius ne 0) then


    -- Definition doesn't have a radius
    else

      -- Tangential to previous arc
      if(!i gt 1) then
        if(!definition[!i - 1].radius ne 0) then
          if(!definition[!i].position.near(!definition[!i - 1].anglePosition(!definition[!i - 1].endAngle),1mm)) then
            !tangent = true
          endif
        endif
      endif

      -- Tangential to next arc
      if(!i lt !max) then
        if(!definition[!i + 1].radius ne 0) then
          if(!definition[!i].position.near(!definition[!i + 1].anglePosition(!definition[!i + 1].startAngle),1mm)) then
            !tangent = true
          endif
        endif
      else
        !tangent = true
      endif

      if(!tangent.not()) then
        !control = true
      endif

    endif

    -- Add spine point into the point list as a "control" point
    if(!control) then
      !point.control(!definition[!i].position)

    -- Add spine point into the point list as a "tangent" point
    elseif (!tangent) then
      !point.tangent(!definition[!i].position)

    -- Add spine point into the point list
    else
      !point.arc(!definition[!i])
    endif
   !points.append(!point)
  enddo

  -- Initialise Variables
  !count = 0

  -- Include first control point (if required)
  if(!points[1].type inset('CENTRE','FILLET')) then

    -- Point has no radius, therefore we can make it a control point
    if(!points[1].arc.radius eq 0) then
      !points[1].gmfSpine(!points[1].arcPosition)
    else
      !position = !points[1].arc.anglePosition(!points[1].arc.startAngle)
      !point.control(!position)
      !points.insert(1,!point)
    endif
  endif

  -- Control toggle
  !controlToggle = true

  -- Process the loop so we get point, arc, point
  do !i
    -- Increment count
    !count = !count + 1

    -- If we are at the last point
    break if(!count ge !points.size())

    -- If point is a control, point, then don't do anything
    if(!points[!count].position.set()) then
      !controlToggle = true
      skip
    endif

    -- If next point is an control point, then skip
    if(!points[!count + 1].position.set()) then
      !controlToggle = true
      skip
    endif

    -- Assumption at this point is the current point and next are "arc" based
    -- items.

    -- Determine control point position

    -- Zero radius point
    if(!points[!count].arc.radius eq 0) then
      !start = !points[!count].arc.position
    else
      !start = !points[!count].arc.anglePosition(!points[!count].arc.endAngle)
    endif

    if(!points[!count + 1].arc.radius eq 0) then
      !end   = !points[!count+ 1].arc.position
    else
      !end   = !points[!count + 1].arc.anglePosition(!points[!count + 1].arc.startAngle)
    endif

    -- If distance between start and end is zero, then we have a tangent point
    if(!start.near(!end,1mm)) then

     !point.tangent(!start)

   -- Line between start and end
   else
     !line  = !start.line(!end)

     -- Define control point at mid point of the adjacent arcs
     !point.control(!line.proportion(0.5))

    endif
    !points.insert(!count + 1, !point)

    -- Arc point
    !controlToggle = true

  enddo

  -- Load point into object points member
  !this.points = !points

endmethod
-- End of method definition for .gmfSpine(ARRAY)

------------------------------------------------------------------------
--
-- Method:      curvePoints
--
-- Description: Return number of curve points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL  Definition of Nth curve
--
------------------------------------------------------------------------

define method .curvePoints() is REAL

  -- Initialise Variables
  !count = 0

  -- Loop through each point
  do !i indices !this.points
    if(!this.points[!i].type inset('CENTRE','FILLET')) then
      !count = !count + 1
    endif
  enddo

  return !count

endmethod
-- End of method definition for .curvePoints() REAL

------------------------------------------------------------------------
--
-- Method:      start
--
-- Description: Return start point position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Definition of start point
--
------------------------------------------------------------------------

define method .start() is POSITION

  return !this.points[1].position

endmethod
-- End of method definition for .start() POSITION

------------------------------------------------------------------------
--
-- Method:      startPoint
--
-- Description: Return start point definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    GMFSPINEPOINT  Definition of start point
--
------------------------------------------------------------------------

define method .startPoint() is GMFSPINEPOINT

  return !this.points[1]

endmethod
-- End of method definition for .startPoint() GMFSPINEPOINT

------------------------------------------------------------------------
--
-- Method:      end
--
-- Description: Return end point position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Definition of end point
--
------------------------------------------------------------------------

define method .end() is POSITION

  return !this.points[!this.points.size()].position

endmethod
-- End of method definition for .end() POSITION

------------------------------------------------------------------------
--
-- Method:      endPoint
--
-- Description: Return start point definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    GMFSPINEPOINT  Definition of start point
--
------------------------------------------------------------------------

define method .endPoint() is GMFSPINEPOINT

  return !this.points[!this.points.size()]

endmethod
-- End of method definition for .endPoint() GMFSPINEPOINT

------------------------------------------------------------------------
--
-- Method:      curvePoint
--
-- Description: Return curve point definition from definition list, i.e any point where the position member is unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Curve number
-- Return:
--   [Data Type] [Description]
--    GMFSPINEPOINT  Definition of Nth curve
--
------------------------------------------------------------------------

define method .curvePoint(!number is REAL) is GMFSPINEPOINT

  -- Initialise Variables
  !point = object GMFSPINEPOINT()
  !count = 0

  -- Loop through each point
  do !i indices !this.points

    -- Check definition type
    if(!this.points[!i].type inset('CENTRE','FILLET')) then
      !count = !count + 1
      if(!count eq !number) then
        return !this.points[!i]
      endif
    endif

  enddo

  return !point

endmethod
-- End of method definition for .curvePoint(REAL) GMFSPINEPOINT

------------------------------------------------------------------------
--
-- Method:      curve
--
-- Description: Constructor to sets point to passed curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Curve
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curve(!element is DBREF)

  -- Fillet type curves
  if(!element.curType eq 'FILL') then
    !this.fillet(!element)

  -- Centre type curves
  elseif (!element.curType eq 'CENT') then
    !this.centre(!element)

  -- Unknown curve types
  else
    !!alert.warning('Unable to handle curve point of type "' & !element.curType & '" for (' & !element.flnn & ').')
  endif

endmethod
-- End of method definition for .curve(DBREF)

------------------------------------------------------------------------
--
-- Method:      centre
--
-- Description: Constructor to sets point as a arc point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Control point definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .centre(!arc is ARC)

  -- Initialise Variables
  !point = object GMFSPINEPOINT()
  !point.centre(!arc)
  !this.points.append(!point)

endmethod
-- End of method definition for .centre(ARC)

------------------------------------------------------------------------
--
-- Method:      centre
--
-- Description: Constructor to sets point as a centre arc from passed curve
--
-- Method Type: Function/Procedure
