------------------------------------------------------------------------
--
-- Method:      tangent
--
-- Description:  Constructor to sets point as a tangent point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Control point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

