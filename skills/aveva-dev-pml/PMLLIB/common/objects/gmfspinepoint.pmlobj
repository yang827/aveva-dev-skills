-- File:            gmfspinepoint.pmlobj
--   Type:          Object Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Nov 13 12:25:33 "GMT 1998
--
--
-- Description:
-- Spine definition.
--
--  Permissible "types" are:
--                            ARC     - Basic arc definition
--                            CONTROL - Control point
--                            TANGENT - Tangent control point
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arc(ARC)                         -                   Constructor to sets point as a arc point
--  centre(ARC)                      -                   Constructor to sets point as a arc point
--  centre(DBREF)                    -                   Constructor derived centre point from passed curve element
--  control(DBREF)                   -                   Constructor derived control point from passed poinsp element
--  control(POSITION)                -                   Constructor to sets point as a control point
--  fillet(ARC)                      -                   Constructor to sets point as a fillet point
--  fillet(DBREF)                    -                   Constructor derived fillet point from passed curve element
--  tangent(POSITION)                -                   Constructor to sets point as a tangent point
--
------------------------------------------------------------------------

define object GMFSPINEPOINT

  -- Reference to point derived from
  member .point    is DBREF

  -- Spine point definition
  member .arc       is ARC

  -- Control point
  member .position  is POSITION

  -- Spine point type
  member .type      is STRING


endobject
-- End of object definition for GMFSPINEPOINT

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Constructor to sets point as a arc point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Control point definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arc(!arc is ARC)

  -- Initialise Variables
  !this.position = object POSITION()
  !this.arc      = !arc

  -- If arc radius is zero, then we have a 'sharp/line' corner
  if(!arc.radius eq 0) then
    !this.type   = 'LINE'
  else
    !this.type   = 'CENTRE'
  endif
  !this.point    = object DBREF()

endmethod
-- End of method definition for .arc(ARC)

------------------------------------------------------------------------
--
-- Method:      centre
--
-- Description: Constructor to sets point as a arc point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Control point definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .centre(!arc is ARC)

  -- Initialise Variables
  -- Control point
  !this.position = !arc.anglePosition(!arc.angle() / 2 + !arc.startAngle)
  !this.arc      = !arc
  !this.type     = 'CENTRE'
  !this.point    = object DBREF()

endmethod
-- End of method definition for .centre(ARC)

------------------------------------------------------------------------
--
-- Method:      centre
--
-- Description:  Constructor derived centre point from passed curve element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Curve Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .centre(!point is DBREF)

  -- Initialise Variables
  !this.arc      = !!appMathLib.gmfArc.through3Points(!point.pPosition[3], !point.pPosition[7], !point.pPosition[4])
  !this.position = !point.pPosition[7]
  !this.type     = 'CENTRE'
  !this.point    = !point

endmethod
-- End of method definition for .centre(DBREF)

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description:  Constructor to sets point as a fillet point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Control point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fillet(!arc is ARC)

  -- Initialise Variables
  !this.arc      = !arc
  !this.position = !arc.pole()
  !this.type     = 'FILLET'
  !this.point    = object DBREF()

endmethod
-- End of method definition for .fillet(ARC)

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description:  Constructor derived fillet point from passed curve element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Curve Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fillet(!point is DBREF)

  -- Initialise Variables
  !this.arc      = !!appMathLib.gmfArc.fillet(!point.radius, !point.pPosition[3], !point.pPosition[6], !point.pPosition[4])
  !this.position = !point.pPosition[6]
  !this.type     = 'FILLET'
  !this.point    = !point

endmethod
-- End of method definition for .fillet(DBREF)

------------------------------------------------------------------------
--
-- Method:      control
--
-- Description:  Constructor to sets point as a control point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Control point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .control(!position is POSITION)

  -- Initialise Variables
  !this.arc      = object ARC()
  !this.position = !position
  !this.type     = 'CONTROL'
  !this.point    = object DBREF()

endmethod
-- End of method definition for .control(POSITION)

------------------------------------------------------------------------
--
-- Method:      control
--
-- Description:  Constructor derived control point from passed poinsp element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       poinsp element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .control(!point is DBREF)

  -- Initialise Variables
  !this.arc      = object ARC()
  !this.position = !point.position
  !this.type     = 'CONTROL'
  !this.point    = !point

endmethod
-- End of method definition for .control(DBREF)

------------------------------------------------------------------------
--
-- Method:      tangent
--
-- Description:  Constructor to sets point as a tangent point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Control point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tangent(!position is POSITION)

  -- Initialise Variables
  !this.arc      = object ARC()
  !this.position = !position
  !this.type     = 'TANGENT'
  !this.point    = object DBREF()

endmethod
-- End of method definition for .tangent(POSITION)
