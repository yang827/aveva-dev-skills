--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     ARC                 Returns underlying core object of graphical object (returns a line even though this isn't the core object, it gives us something to use)
--  definition()                     ARRAY               Definition of object to save to file
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw dimension to graphics canvas
--  edit()                           -                   Display edit form
--  edit(REAL)                       -                   Edit a specific dimension in the aid number system
--  gphAngleDimension()              -                   Constructor
--  gphAngleDimension(ARC)           -                   Constructor
--  labelENU()                       -                   Sets labelling to offset
--  labelUVW()                       -
--  labelXYZ()                       -                   Sets labelling to XYZ
--  offset()                         ARRAY               Returns XYZ offset values
--  setDimension(ARC)                -                   Set dimension
--  wrt(DBREF)                       -                   Sets with respect to
--

------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------


define object GPHANGLEDIMENSION

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Type of labelling
  member .labelType    is STRING
  member .labelText    is ARRAY

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Dimension Definition
  member .arc          is ARC

  -- Frame of reference
  member .wrt          is DBREF

  -- Default output format
  member .format       is FORMAT

endobject
-- End of object definition for GPHANGLEDIMENSION

------------------------------------------------------------------------
--
-- Method:      gphAngleDimension
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAngleDimension()
  -- Initialise Variables
  !this.tag       = false
  !this.detail    = true
  !this.visible   = true
  !this.wrt       = World
  !this.arc       = object ARC(object POSITION('E0 N0 U0'), object ORIENTATION('Y IS N AND Z IS UP'), 0 , 0, 0, TRUE)
  !this.format    = !!angleFmt
  var !coordinate coordinate
  if(!coordinate eq 'ENU')then
  !this.labelXYZ()
  else
   !this.labelUVW()
  endif

endmethod
-- End of method definition for .gphAngleDimension()

------------------------------------------------------------------------
--
-- Method:      gphAngleDimension
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    1   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAngleDimension(!arc is ARC)

  -- Initialise Variables
  !this.gphAngleDimension()
  !this.arc = !arc
  !this.arc.position = !arc.position.wrt(!this.wrt)
  !this.arc.orientation = !arc.orientation.wrt(!this.wrt)

endmethod
-- End of method definition for .gphAngleDimension(POSITION, POSITION)
------------------------------------------------------------------------
--
-- Method:      setDimension
--
-- Description: Set dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    1   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDimension(!arc is ARC)
  -- Initialise Variables)
  !this.arc = !arc
  !this.arc.position = !arc.position.wrt(!this.wrt)
  !this.arc.orientation = !arc.orientation.wrt(!this.wrt)

endmethod
-- End of method definition for .setDimension(POSITION, POSITION)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object (returns a line even though this isn't the core object, it gives us something to use)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE        Line from start to finish
--
------------------------------------------------------------------------

define method .coreObject() is ARC
  return !this.arc

endmethod
-- End of method definition for .coreObject() LINE
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw dimension to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Don't do anything if the angle is zero
  if(!this.arc.angle() eq 0) then
    return
  endif

  -- Draw Angular dimension
  !angle         = !this.arc.angle().string(!!angleFmt)
  !startPosition = !this.arc.anglePosition(!this.arc.startAngle)
  !endPosition   = !this.arc.anglePosition(!this.arc.endAngle)

  -- slightly reduce arc radius to be inside the dimension lines
  !indent = min(!this.arc.radius * 0.02, 50mm)
  !this.arc.radius = !this.arc.radius - !indent

  -- Dimension label position
  !midPoint = !this.arc.anglePosition(!this.arc.angle() / 2)
  !arcStart = !this.arc.anglePosition(!this.arc.startAngle)
  !arcEnd   = !this.arc.anglePosition(!this.arc.endAngle)

  AID LINE NUMBER $!<aidNumber> $!<this.arc.position> TO $!<startPosition>
  AID LINE NUMBER $!<aidNumber> $!<this.arc.position> TO $!<endPosition>
  AID ARC NUMBER  $!<aidNumber> $!<arcStart> TO $!<arcEnd> THRU $!<midPoint>
  AID TEXT NUMBER $!<aidNumber> |Angle $!<angle>| AT $!<midPoint>

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Display edit form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- Load line edit form is required
  if(undefined(!!gphAngleMeasure)) then
    pml load form !!gphAngleMeasure
  endif

  -- Setup line
  !!gphAngleMeasure.setup()

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.defineMeasure('ANGLE')
  !packet.key            = 'editAngleDimension'
  !packet.description    = 'Define an angular dimension'
  !packet.action         = '!!gphAngleMeasure.setMeasure(!this.return[1])'
  !packet.form           = !!gphAngleMeasure
  !packet.close          = '!!gphAngleMeasure.tidy()'
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit a specific dimension in the aid number system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Load line edit form is required
  if(undefined(!!gphAngleMeasure)) then
    pml load form !!gphAngleMeasure
  endif

  -- Setup line
  !!gphAngleMeasure.setup(!aidNumber)

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.definePosition('Define Dimension')
  !packet.key            = 'editAngleDimension'
  !packet.description    = 'Define an angular dimension'
  !packet.action         = '!!gphAngleMeasure.setMeasure(!this.return[1])'
  !packet.form           = !!gphAngleMeasure
  !packet.close          = '!!gphAngleMeasure.tidy()'
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      labelXYZ
--
-- Description: Sets labelling to XYZ
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .labelXYZ()

  -- Initialise Variables
  !this.labelType    = 'XYZ'
  !this.labelText[1] = 'X'
  !this.labelText[2] = 'Y'
  !this.labelText[3] = 'Z'

endmethod
-- End of method definition for .labelXYZ()

------------------------------------------------------------------------
--
-- Method:      labelENU
--
-- Description: Sets labelling to offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .labelENU()

  -- Initialise Variables
  !this.labelType    = 'ENU'
  !this.labelText[1] = 'E'
  !this.labelText[2] = 'N'
  !this.labelText[3] = 'U'

endmethod
-- End of method definition for .labelENU()

------------------------------------------------------------------------
--
-- Method:      labelUVW
--
-- Description: Sets labelling to UVW
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .labelUVW()

  -- Initialise Variables
  !this.labelType    = 'UVW'
  !this.labelText[1] = 'U'
  !this.labelText[2] = 'V'
  !this.labelText[3] = 'W'

endmethod
-- End of method definition for .labelUVW()

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Sets with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wrt(!item is DBREF)
  -- Initialise Variables
  !this.wrt   = !item
  !this.arc.position  = !this.arc.position.wrt(!item)
  !this.arc.orientation  = !this.arc.orientation.wrt(!item)

endmethod
-- End of method definition for .wrt(DBREF)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Returns XYZ offset values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       XYZ values
--
------------------------------------------------------------------------

define method .offset() is ARRAY

  -- Initialise Variables
  !return = ARRAY()

  -- Distance in XY
  !return[1] = !this.to.east  - !this.from.east
  !return[2] = !this.to.north - !this.from.north
  !return[3] = !this.to.up    - !this.from.up

  return !return

endmethod
-- End of method definition for .offset() ARRAY

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()
  return !return

endmethod
-- End of method definition for .definition() ARRAY
