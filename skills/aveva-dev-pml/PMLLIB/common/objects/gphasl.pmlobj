--
-- Description:
-- Graphic representation of stairs/ladders.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draw(REAL)                       -                   Draw the item
--  gphAsl()                         -                   Constructor
--
------------------------------------------------------------------------

define object GPHASL

  -- Description
  member .description  is STRING

  -- Tag
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Detail label type
  member .labelType    is STRING

  -- Basic representations (used for speed)
  member .basic        is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- From Position
  member .from         is POSITION

  -- To position
  member .to           is POSITION

  --  Direction (when line is vertical, this is used)
  member .direction    is DIRECTION

  -- Width (optional)
  member .width        is REAL

  -- Tread Range
  member .treadMin     is REAL
  member .treadMax     is REAL

endobject
-- End of object definition for GPHASL

------------------------------------------------------------------------
--
-- Method:      gphAsl
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAsl()

   -- Initialise Variables
  !this.tag         = false
  !this.detail      = false
  !this.basic       = false
  !this.visible     = true
  !this.width       = 0
  !this.treadMin    = 200
  !this.treadMax    = 250

endmethod
-- End of method definition for .gphAsl()

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description:
--   Returns basic definition of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

--define method .coreObject() is LINE



--endmethod

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description:
--   Draw the item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  -- Clear Current Grid
  AID CLEAR ARROW $!<aidNumber>
  handle any
  endhandle
  AID CLEAR TEXT $!<aidNumber>
  handle any
  endhandle
  AID CLEAR LINE $!<aidNumber>
  handle any
  endhandle
  AID CLEAR BOX $!<aidNumber>
  handle any
  endhandle
  AID CLEAR SPHERE $!<aidNumber>
  handle any
  endhandle

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Set out points
  AID TEXT   NUMBER $!<aidNumber> 'Bottom S.O.P.' AT $!<this.from>
  AID TEXT   NUMBER $!<aidNumber> 'Top S.O.P.'    AT $!<this.to>
  AID SPHERE NUMBER $!<aidNumber> $!<this.from> DIAMETER 100mm
  AID SPHERE NUMBER $!<aidNumber> $!<this.to>   DIAMETER 100mm

 -- Define reference plane
  !plane = object PLANE(!this.from, Z is U wrt World)

  -- If the direction from the from to the to is up, then we'll use
  -- the defined direction
  if(!this.from.direction(!this.to) eq U) then
    !direction = !this.direction

  -- Direction when line is not U
  else
    -- Map direction onto plane
    !direction = !this.from.direction(!this.to).projected(!plane)

  endif

  -- Draw direction axes
  !arrowLength  = 1000mm
  AID ARROW NUMBER $!<aidNumber> AT $!<this.from> DIRECTION $!<direction> HEIGHT $!<arrowLength>
  !textPos      = !this.from.offset(!direction,  !arrowLength)
  AID TEXT  NUMBER $!<aidNumber> '$!direction' AT $!textPos

  -- Width > 0, draw to parallel lines & some treads (nominal)
  if(!this.width gt 0) then

    -- Parallel Direction movement
    !sideOffsetDir   = !direction.orthogonal(!plane.orientation.zDir())
    !line            = !this.from.line(!this.to)
    !leftLine        = !line.offset(!sideOffsetDir, !this.width * 0.5)
    !rightLine       = !line.offset(!sideOffsetDir, !this.width * -0.5)

    AID LINE NUMBER $!<aidNumber> $!<leftLine.startPosition>  TO $!<leftLine.endPosition>
    AID LINE NUMBER $!<aidNumber> $!<rightLine.startPosition> TO $!<rightLine.endPosition>

    -- Determine number of treads (only a guess)
    !length          = !this.from.distance(!this.to)
    !treadOffsetDir  = !this.from.direction(!this.to)

    !treadMax        = INT(!length / !this.treadMax)
    !treadMin        = INT(!length / !this.treadMin)
    !treads          = !treadMin.min(!treadMax)
    !treadOffset     = !length / !treads

    -- Tread Line
    !treadLine       = object LINE(!leftLine.startPosition, !rightLine.startPosition)

    -- Draw the treads
    do from 1 to !treads - 1
      !treadLine     = !treadLine.offset(!treadOffsetDir, !treadOffset)
      AID LINE NUMBER $!<aidNumber> $!<treadLine.startPosition> TO $!<treadLine.endPosition>
    enddo

  -- Single line representation
  else
    AID LINE NUMBER $!<aidNumber> $!<this.from> TO $!<this.to>
  endif



endmethod
-- End of method definition for .draw(REAL)
