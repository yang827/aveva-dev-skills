--
-- File:            gphautocolour.pmlobj
--   Type:          Object Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Aug 18 14:12:58 BST 1997
--
--
-- Description:
-- Object to store autocolour entry
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gphAutoColour(STRING,ANY)        -                   constructor
--  gphAutoColour(STRING,ANY,REAL,BOOLEAN) -                   constructor
--  save()                           ARRAY               return an array of strings to write to a file
--  setAutoColour()                  -                   set autocolour values in the core
--
------------------------------------------------------------------------

-- Define object
define object GPHAUTOCOLOUR

  -- name of standard rule to use
  member .rule is STRING

  -- colour for the current entry
  -- this can be a specific colour or an expression
  member .colour is COLOUR
  member .colourExp is STRING
  member .translucency is REAL
  member .edgeOn is BOOLEAN

endobject
-- End of object definition for GPHAUTOCOLOUR

------------------------------------------------------------------------
--
-- Method:      !gphAutoColour()
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [rule name]
--   [2] [R] [ANY] [colour for rule, may be colour object or expression]
--   [3] [R] [REAL] [Translucency]
--   [4] [R] [BOOLEAN] [To on and off edges in element's colour]
--
------------------------------------------------------------------------
define method .gphAutoColour(!ruleValue is STRING, !colValue is ANY, !translVal is REAL, !edgeOn is BOOLEAN)

  -- set the object members
  !this.rule = !ruleValue
  !this.translucency = !translVal
  !this.edgeOn = !edgeOn

  -- the colour is set to a different member depending on
  -- the data type, in either case one member is set and
  -- the other is initialised to 'unset'
  if (!colValue.objectType() eq 'COLOUR') then
    !this.colour = !colValue
    !this.colourExp = STRING()
  else
    !this.colourExp = !colValue
    !this.colour = object COLOUR()
  endif

endmethod
-- End of method definition for .gphAutoColour(STRING,ANY,REAL,BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !gphAutoColour()
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [rule name]
--   [2] [R] [ANY] [colour for rule, may be colour object or expression]
-- this method provide backward compatibility to earlier option file
------------------------------------------------------------------------
define method .gphAutoColour(!ruleValue is STRING, !colValue is ANY)

  -- assume that earlier option file has no edge on and translucency is solid
  !translVal = 0
  !edgeOn = false

  -- pass this values to .gphAutoColour() method
  !this.gphAutoColour(!ruleValue, !colValue, !translVal, !edgeOn)

endmethod
-- End of method definition for the .gphAutoColour(STRING,ANY)
------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: return an array of strings to write to a file
--
-- Method Type: Function
-- Return:
--   [ARRAY] [array of strings used to recreate the object]
--
------------------------------------------------------------------------
define method .save() is ARRAY

  -- initialise array to contain strings
  !saveContents = ARRAY()
  !saveContents.append('!gphAutoColourRul = |' + !this.rule.replace('|', '||') + '|')
  !saveContents.append('!gphAutoColTnslVal = ' + !this.translucency.string())
  !saveContents.append('!gphAutoColEdgeOn = ' + !this.edgeOn.string())
  if (!this.colourExp.unset()) then
    !saveContents.append('!gphAutoColourCol = object COLOUR(' + !!comQuoteIfString(!this.colour.key()) + ')')
    !saveContents.append('!gphAutoColour    = object GPHAUTOCOLOUR(!gphAutoColourRul, !gphAutoColourCol, !gphAutoColTnslVal, !gphAutoColEdgeOn)')
  else
    !saveContents.append('!gphAutoColourExp = |' + !this.colourExp.replace('|', '||') + '|')
    !saveContents.append('!gphAutoColour    = object GPHAUTOCOLOUR(!gphAutoColourRul, !gphAutoColourExp, !gphAutoColTnslVal, !gphAutoColEdgeOn)')
  endif

  return !saveContents

endmethod
-- End of method definition for .save() ARRAY
------------------------------------------------------------------------
--
-- Method:      !setAutoColour()
--
-- Description: set autocolour values in the core
--
-- Method Type: Procedure
-- Return:
--
--
------------------------------------------------------------------------
define method .setAutoColour()

   -- get the rule object
   !ruleString = !!ruleStore.element.getRule(!this.rule).string()
   !transl = !this.translucency.real()
   if (!this.edgeOn) then
      !edgeOn ='ON'
   else
      !edgeOn ='OFF'
   endif

   if (!this.colourExp.unset()) then
      !colString = !this.colour.code.string()
   else
      !colString = '( ' + !this.colourExp + ' )'
   endif

   AUTOCOLOUR $!<ruleString> COLOUR $!<colString> TRANSLUCENCY $!<transl> EDGES $!<edgeOn>
   handle(47,15)
      !!alert.warning(!ruleString + ' is an invalid rule , Please select a  valid colour rule')
      return error noalert
   elsehandle any
      !!alert.warning('Autocolours could not be applied')
      return error noalert
   endhandle
endmethod
--end of method definition for .setAutoColour()
