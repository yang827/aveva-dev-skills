--
-- Description:
-- Graphical axis.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     POSITION            Returns underlying core object of graphical object (returns a position even though this isn't the core object, it gives us something to use)
--  definition()                     ARRAY               Definition of object to save to file
--  draw(REAL)                       -                   Draw axes (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw axes
--  edit(REAL)                       -                   Edit graphic position
--  gphAxes()                        -                   Constructor
--  gphAxes(DBREF)                   -                   Constructor
--  gphAxes(PLANE)                   -                   Constructor, using plane
--  gphAxes(POSITION,ORIENTATION)    -                   Constructor, using position and orientation
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--  wrt(DBREF)                       -                   Set with respect to
--
------------------------------------------------------------------------

define object GPHAXES

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- XYZ flag, false gives ENU
  member .xyz          is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Position
  member .position     is POSITION

  -- Orientation
  member .orientation  is ORIENTATION

  -- Axes size
  member .height       is REAL

  -- Individual axis control
  member .visibleX     is BOOLEAN
  member .visibleY     is BOOLEAN
  member .visibleZ     is BOOLEAN

endobject
-- End of object definition for GPHAXES

------------------------------------------------------------------------
--
-- Method:      gphAxes
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAxes()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.xyz       = true
  !this.visible   = true
  !this.height    = 500mm
  !this.visibleX  = true
  !this.visibleY  = true
  !this.visibleZ  = true

endmethod
-- End of method definition for .gphAxes()

------------------------------------------------------------------------
--
-- Method:      gphAxes
--
-- Description: Constructor, using position and orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
--    2   R      ORIENTATION Orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAxes(!position is POSITION, !orientation is ORIENTATION)

  -- Initialise Variables
  !this.gphAxes()
  !this.position    = !position
  !this.orientation = !orientation

endmethod
-- End of method definition for .gphAxes(POSITION, ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      gphAxes, using database element
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAxes(!item is DBREF)

  -- Initialise Variables
  !this.gphAxes()
  !this.position    = !item.position
  !this.orientation = !item.orientation

endmethod
-- End of method definition for .gphAxes(DBREF)

------------------------------------------------------------------------
--
-- Method:      gphAxes
--
-- Description: Constructor, using plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAxes(!plane is PLANE)

  -- Initialise Variables
  !this.gphAxes()
  !this.position    = !plane.position
  !this.orientation = !plane.orientation

endmethod
-- End of method definition for .gphAxes(PLANE)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object (returns a position even though this isn't the core object, it gives us something to use)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Origin of axes
--
------------------------------------------------------------------------

define method .coreObject() is POSITION

  return !this.position

endmethod
-- End of method definition for .coreObject() POSITION

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw axes (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)
  !this.draw(!aidNumber, true)
endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     True to hide old aid numbers
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  -- Remove old aids
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Initialise Variables
  !position    = !this.position
  !orientation = !this.orientation
    !aidTextX = 'E'
    !aidTextY = 'N'
    !aidTextZ = 'U'
  -- Draw item
  !xDir = !orientation.xDir()
  !yDir = !orientation.yDir()
  !zDir = !orientation.zDir()
  if( !this.visibleX) then
    AID ARROW NUMBER $!<aidNumber> AT $!<position> DIR $!<xDir> HEIGHT $!<this.height>
  endif
  if( !this.visibleY) then
    AID ARROW NUMBER $!<aidNumber> AT $!<position> DIR $!<yDir> HEIGHT $!<this.height>
  endif
  if( !this.visibleZ) then
    AID ARROW NUMBER $!<aidNumber> AT $!<position> DIR $!<zDir> HEIGHT $!<this.height>
  endif
  !xPos = !position.offset(!xDir, !this.height)
  !yPos = !position.offset(!yDir, !this.height)
  !zPos = !position.offset(!zDir, !this.height)

  -- Draw detail of axes
  if(!this.detail) then

    !xDirString = !xDir.string().before('WRT').trim()
    !yDirString = !yDir.string().before('WRT').trim()
    !zDirString = !zDir.string().before('WRT').trim()

    if( !this.visibleX) then
      AID TEXT NUMBER $!<aidNumber> '$!xDirString' AT $!<xPos>
    endif
    if( !this.visibleY) then
      AID TEXT NUMBER $!<aidNumber> '$!yDirString' AT $!<yPos>
    endif
    if( !this.visibleZ) then
      AID TEXT NUMBER $!<aidNumber> '$!zDirString' AT $!<zPos>
    endif

  -- XYZ axes
  else
    if (!!coords.isxyz() ) then
      if(!this.xyz ) then
        !aidTextX = 'U'
        !aidTextY = 'V'
        !aidTextZ = 'W'
      else
        !aidTextX = 'X'
        !aidTextY = 'Y'
        !aidTextZ = 'Z'
      endif
    else
      if(!this.xyz ) then
        !aidTextX = 'X'
        !aidTextY = 'Y'
        !aidTextZ = 'Z'
      else
        !aidTextX = 'E'
        !aidTextY = 'N'
        !aidTextZ = 'U'
      endif
    endif

    -- display the aid text with appropriate text
    if( !this.visibleX) then
      AID TEXT NUMBER $!<aidNumber> |$!<aidTextX>| AT $!<xPos>
    endif
    if( !this.visibleY) then
      AID TEXT NUMBER $!<aidNumber> |$!<aidTextY>| AT $!<yPos>
    endif
    if( !this.visibleZ) then
      AID TEXT NUMBER $!<aidNumber> |$!<aidTextZ>| AT $!<zPos>
    endif

  endif

  -- Tag Axes
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Axes [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> |$!text| AT $!<position>
  endif

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)


  -- Load line edit form is required
  if(undefined(!!gphAxesEdit)) then
    pml load form !!gphAxesEdit
  endif

  -- Setup line
  if(!aidNumber le 0) then
    !!gphAxesEdit.setup()
  else
    !!gphAxesEdit.setup(!aidNumber)
  endif

  -- Show form
  !!gphAxesEdit.show()

--   -- Define Edit line packet
--   !packet             = object EDGPACKET()
--   !packet.anyPick('Pick Item')
--
--   !packet.key            = 'editAxes'
--   !packet.description    = 'Define Axes'
--   !packet.action         = '!!gphAxesEdit.setElement(!this.return[1])'
--   !packet.form           = !!gphAxesEdit
--   !packet.priority       = 1
--   !packet.remove         = false
--   !packet.type           = 'tag'
--
--   -- Restrict picking
--   !packet.pickPacket.picks[1].pick.input[2]   = 'NUMB eq -99'
--   !packet.pickPacket.picks[1].pick.input[4]   = 'RUBBISH'
--   !packet.pickPacket.picks[1].pick.modifiable = false
--
--   -- Add into EDG packet
--   !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Set with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wrt(!item is DBREF)

  -- Initialise Variables
  !this.position    = !this.position.wrt(!item)
  !this.orientation = !this.orientation.wrt(!item)

endmethod
-- End of method definition for .wrt(DBREF)

