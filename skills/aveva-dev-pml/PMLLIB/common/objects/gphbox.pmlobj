-- Created:         Tue Apr 14 11:15:59 WAT 1998
--
--
-- Description:
-- Draw a gmfBox object.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     GMFBOX              Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  draw(REAL)                       -                   Draw box (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw box
--  edit(REAL)                       -                   Edit graphic position
--  filled(BOOLEAN)                  -                   Sets fill of box
--  gphBox()                         -                   Constructor
--  gphBox(GMFBOX)                   -                   Constructor, using GMFBIX
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

define object GPHBOX

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Box definition
  member .box          is GMFBOX

  -- Solid/Wireline
  member .fill         is STRING

endobject
-- End of object definition for GPHBOX

------------------------------------------------------------------------
--
-- Method:      gphBox
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphBox()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.visible   = true
  !this.filled(false)

endmethod
-- End of method definition for .gphBox()

------------------------------------------------------------------------
--
-- Method:      gphBox
--
-- Description: Constructor, using GMFBOX
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFBOX      Box description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphBox(!box is GMFBOX)

  -- Initialise Variables
  !this.gphBox()
  !this.box    = !box

endmethod
-- End of method definition for .gphBox(GMFBOX)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is GMFBOX

  return !this.box

endmethod
-- End of method definition for .coreObject() GMFBOX

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw box (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)
  !this.draw(!aidNumber, true)
endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     True to hide old aid numbers
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  -- Remove old aids
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Draw item
  AID BOX NUMBER $!<aidNumber> AT $!<this.box.position> ORIENTATION  $!<this.box.orientation> XLENGTH $!<this.box.xLength> YLENGTH $!<this.box.yLength> ZLENGTH $!<this.box.zLength> filled $!<this.fill>

  -- Draw detail of Box
  if(!this.detail) then
    !xDirection = !this.box.orientation.xDir()
    !yDirection = !this.box.orientation.yDir()
    !zDirection = !this.box.orientation.zDir()
    !xLength    = !this.box.xLength * 0.25
    !yLength    = !this.box.yLength * 0.25
    !zLength    = !this.box.xLength * 0.25
    !xPosition  = !this.box.position.offset(!xDirection, !xLength)
    !yPosition  = !this.box.position.offset(!yDirection, !yLength)
    !zPosition  = !this.box.position.offset(!zDirection, !zLength)
    AID ARROW NUMBER $!<aidNumber> AT $!<this.box.position> DIR $!<xDirection> HEIGHT $!<xLength>
    AID ARROW NUMBER $!<aidNumber> AT $!<this.box.position> DIR $!<yDirection> HEIGHT $!<yLength>
    AID ARROW NUMBER $!<aidNumber> AT $!<this.box.position> DIR $!<zDirection> HEIGHT $!<zLength>
    AID TEXT NUMBER $!<aidNumber> 'X' AT $!<xPosition>
    AID TEXT NUMBER $!<aidNumber> 'Y' AT $!<yPosition>
    AID TEXT NUMBER $!<aidNumber> 'Z' AT $!<zPosition>
  endif

  -- Tag Box
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Box [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.box.position>
  endif

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- To be done at some later date
  !!alert.error('No default edit method.')
  return error 1 noalert

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description: Sets fill of box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.box.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.box.position = !position

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Return orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION Orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  return !this.box.orientation

endmethod
-- End of method definition for .orientation() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION Orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  !this.box.orientation = !orientation

endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  return !return

endmethod
-- End of method definition for .definition() ARRAY
