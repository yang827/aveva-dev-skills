--
-- Description:
-- Graphical Circle
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     ARC                 Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw arc to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw line to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw line to graphics canvas
--  edit(REAL)                       -                   Edit graphic circle
--  filled(BOOLEAN)                  -                   Sets fill start of plane
--  gphCircle()                      -                   Constructor
--  gphCircle(ARC)                   -                   Constructor
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHCIRCLE

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Circle Definition
  member .circle       is ARC

  -- Filled/Unfilled
  member .fill         is STRING

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

  -- Plant or Marine
  member .marine       is BOOLEAN

endobject
-- End of object definition for GPHCIRCLE

------------------------------------------------------------------------
--
-- Method:      gphCircle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphCircle()

  -- Define defaults
  !this.tag       = false
  !this.detail    = true
  !this.visible   = true
  !this.displayStyle()
  !this.filled(false)

  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    !this.marine = TRUE
  else
    !this.marine = FALSE
  endif

endmethod
-- End of method definition for .gphCircle()

------------------------------------------------------------------------
--
-- Method:      gphCircle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphCircle(!circleDef is ARC)

  -- Define Circle
  !this.gphCircle()
  !this.circle    = !circleDef

endmethod
-- End of method definition for .gphCircle(ARC)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is ARC

  return !this.circle

endmethod
-- End of method definition for .coreObject() ARC

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 1

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Initialise Variables

  -- Draw Basic definition of circle/arc
  !this.circle.draw(!aidNumber, !style, !colour)

  -- Draw detail of circle/arc
  if(!this.detail) then
    if (!this.circle.startAngle.between(0.01, -0.01)) then
      !this.circle.startAngle = 0
    endif
    if (!this.circle.endAngle.between(0.01, -0.01)) then
      !this.circle.endAngle = 0
    endif

    -- Draw Start and End Angle
    !startLine = !this.circle.position.line(!this.circle.anglePosition(!this.circle.startAngle))
    !endLine   = !this.circle.position.line(!this.circle.anglePosition(!this.circle.endAngle))
    !startLine.draw(!aidNumber, !style, !colour)
    !endLine.draw(!aidNumber, !style, !colour)

    !startAngle = !this.circle.startAngle.string(!!realFmt)
    !endAngle   = !this.circle.endAngle.string(!!realFmt)
    if(!this.circle.angle() ne 360) then
      AID TEXT NUMBER $!<aidNumber> '$!startAngle' AT $!<startLine.endPosition>
    endif
    AID TEXT NUMBER $!<aidNumber> '$!endAngle' AT $!<endLine.endPosition>

    -- Draw Circle Plane arrow
    !direction = !this.circle.orientation.zDir()
    !height    = !this.circle.radius * 0.5
    !height    = !height.min(500mm)
    AID ARROW NUMBER $!<aidNumber> AT $!<this.circle.position> DIRECTION $!<direction> HEIGHT $!<height>

    -- Draw X axis
    if(!this.circle.startAngle ne 0) then
      !line = object LINE(!this.circle.position, !this.circle.anglePosition(0))
      !line.draw(!aidNumber, !style, !colour)
      !zeroPosition = !this.circle.anglePosition(0)
      AID TEXT NUMBER $!<aidNumber> 'X' AT $!<zeroPosition>
    endif
  endif

  -- Tag circle
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Circle [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.circle.position>
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:  Edit graphic circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build if it has not already been built
  if(undefined(!!gphCircleEdit)) then
    pml reload form !!gphCircleEdit
  endif

  -- Setup definePlane
  !!gphCircleEdit.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!gphCircleEdit.position', 'Modify Circle')
  !packet.key            = 'editCircle'
  !packet.description    = 'Edit aid circle definition'
  !packet.form           = !!gphCircleEdit
  !packet.close          = '!!gphCircleEdit.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description: Sets fill start of plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.circle.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.circle.position = !position

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Return orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION Orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  return !this.circle.orientation

endmethod
-- End of method definition for .orientation() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION Orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  !this.circle.orientation = !orientation

endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  !return.append('!definition             = object GPHCIRCLE()')
  if(!this.description.set()) then
    !return.append('!definition.description = ''' & !this.description & '''')
  endif
  !return.append('!definition.tag         = '   & !this.tag)
  !return.append('!definition.detail      = '   & !this.detail)
  !return.append('!definition.visible     = '   & !this.visible)
  !return.append('!definition.fill        = '''   & !this.fill & '''')
  !return.append('!definition.colour      = '   & !this.colour)
  !return.append('!definition.style       = '   & !this.style)
  if (!this.marine) then
    !xPos   = !this.circle.position.east.string()
    !yPos   = !this.circle.position.north.string()
    !zPos   = !this.circle.position.up.string()
    !circleString = '!definition.circle        = object ARC(X' & !xPos & ' Y' & !yPos & ' Z' & !zPos & ' ,' & !this.circle.orientation & ' ,' & !this.circle.startAngle & ' ,' & !this.circle.endAngle & ' ,' & !this.circle.radius & ' ,' & !this.circle.sense & ' )'
    !return.append(!circleString)
  else
    !return.append('!definition.circle      = object ARC(' & !this.circle.position & ' ,' & !this.circle.orientation & ' ,' & !this.circle.startAngle & ' ,' & !this.circle.endAngle & ' ,' & !this.circle.radius & ' ,' & !this.circle.sense & ' )')
  endif

  return !return

endmethod
-- End of method definition for .definition() ARRAY
