------------------------------------------------------------------------
--
-- Method:      enable
--
-- Description:
--   Enable Clipping
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .enable()

  -- Check for zero dimension
  if(!this.box.xlength le 0.9mm or !this.box.ylength le 0.9mm or !this.box.zlength le 0.9mm) then
    return
  endif

  -- Switch on clipping
  !this.active = TRUE
  !this.view.clipPlanesAllOff = TRUE
  !this.view.clipping = TRUE
  !this.view.owner().lclippingMenu.select('Enable',true)

  -- Update button, if it exists
  if(defined(!this.view.owner().clippingButton)) then
    !this.view.owner().clippingButton.val = true
  endif

  -- Hide clip planes form and aid graphics
  if (defined(!!gphClipPlaneEdit)) then
    if (!!gphClipPlaneEdit.shown()) then
      if (!this.view.owner() eq !!gphClipPlaneEdit.parentForm) then
    hide !!gphClipPlaneEdit
    !!gphClipPlaneEdit.close()
  endif
    endif
  endif

endmethod
-- End of method definition for .enable()

------------------------------------------------------------------------
--
-- Method:      disable
--
-- Description:
--   Disable Clip Capping
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .disable()

  -- Switch off clipping
  !this.active = false
  !this.view.clipping = FALSE
  !this.view.owner().lclippingMenu.select('Enable',false)

  -- Update button, if it exists
  if(defined(!this.view.owner().clippingButton)) then
    !this.view.owner().clippingButton.val = false
  endif

  -- Leave clip planes off true as this will be changed when a clip plane is enabled
  !this.view.clipPlanesAllOff = TRUE

endmethod
-- End of method definition for .disable()

------------------------------------------------------------------------
--
-- Method:      capOn
--
-- Description:
--   Enable Clipping Capping
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .capOn()

  -- Switch capping on
  !this.capping = TRUE
  !this.view.clipBoxCapping = TRUE

endmethod
-- End of method definition for .capOn()

------------------------------------------------------------------------
--
-- Method:      capOff
--
-- Description:
--   Disable Clipping Cap
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .capOff()

  -- Switch capping on
  !this.capping = FALSE
  !this.view.clipBoxCapping = FALSE

endmethod
-- End of method definition for .capOff()

------------------------------------------------------------------------
--
-- Method:      set
--
-- Description:
--   Set Clip box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .set()

  -- Check for zero dimension
  if(!this.box.xlength le 0.9mm or !this.box.ylength le 0.9mm or !this.box.zlength le 0.9mm) then

    !radius = !this.view.radius
    if(!this.box.xlength le 0.9mm) then
      !this.box.xlength = $!<radius>mm
    endif
    if(!this.box.ylength le 0.9mm) then
      !this.box.ylength = $!<radius>mm
    endif
    if(!this.box.zlength le 0.9mm) then
      !this.box.zlength = $!<radius>mm
    endif

  endif

  -- Get world ref
  !worldName = |/*|
  !world  = !worldName.dbref()

  -- Setup Clip box
  !this.view.clipBoxXlen = !this.box.xLength
  !this.view.clipBoxYlen = !this.box.yLength
  !this.view.clipBoxZlen = !this.box.zLength
  !positionArray       = ARRAY()
  !orientationArray    = ARRAY()
  !positionArray[1]    = !this.box.position.wrt(!world).east
  !positionArray[2]    = !this.box.position.wrt(!world).north
  !positionArray[3]    = !this.box.position.wrt(!world).up
  !orientationArray[1] = !this.box.orientation.wrt(!world).alpha
  !orientationArray[2] = !this.box.orientation.wrt(!world).beta
  !orientationArray[3] = !this.box.orientation.wrt(!world).gamma
  !this.view.clipBoxPosition    = !positionArray
  !this.view.clipBoxOrientation = !orientationArray

  if(!this.active.set()) then
    if(!this.active) then
      !this.enable()
    endif
  endif

endmethod
-- End of method definition for .set()

------------------------------------------------------------------------
--
-- Method:      capColour
--
-- Description:
--   Set Clip cap colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .capColour(!colour is REAL)

  -- Set capping colour
  !this.capColour.colour(!colour)
  !this.view.clipBoxCapColour = !colour

endmethod
-- End of method definition for .capColour(REAL)

