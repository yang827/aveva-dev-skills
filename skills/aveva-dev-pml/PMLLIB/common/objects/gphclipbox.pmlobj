------------------------------------------------------------------------
--
-- Method:      save
--
-- Description:
--   Return array of strings to save object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Strings to recreate object
--
------------------------------------------------------------------------

define method .save() is ARRAY

  -- Build array of data
  !data = ARRAY()
  !data.append(|!clipbox                 = object GPHCLIPBOX()|)
  !data.append(|!clipbox.description     = | & !this.description)
  !data.append(|!clipbox.tag             = | & !this.tag)
  !data.append(|!clipbox.detail          = | & !this.detail)
  !data.append(|!clipbox.visible         = | & !this.visible)
  !data.append(|!clipbox.capping         = | & !this.capping)
  !data.append(|!clipbox.active          = | & !this.active)
  !data.append(|!clipbox.capColour       = | & !this.capColour)
  !data.append(|!clipbox.view            = | & !this.view.fullname())
  !data.append(|!clipbox.box.xlength     = | & !this.box.xlength)
  !data.append(|!clipbox.box.ylength     = | & !this.box.ylength)
  !data.append(|!clipbox.box.zlength     = | & !this.box.zlength)
  !data.append(|!clipbox.box.position    = | & !this.box.position.string())
  !data.append(|!clipbox.box.orientation = | & !this.box.orientation.string())
  !data.append(!this.view.owner().fullname() & |.clipbox = !clipbox|)
  return !data

endmethod
-- End of method definition for .save() ARRAY

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description:
--   Return array of strings to save object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Strings to recreate object
--
------------------------------------------------------------------------

define method .save() is ARRAY

  -- Build array of data
  !data = ARRAY()
  !data.append(|!clipbox                 = object GPHCLIPBOX()|)
  !data.append(|!clipbox.description     = '| & !this.description & |'|)
  !data.append(|!clipbox.tag             = | & !this.tag)
  !data.append(|!clipbox.detail          = | & !this.detail)
  !data.append(|!clipbox.visible         = | & !this.visible)
  !data.append(|!clipbox.capping         = | & !this.capping)
  !data.append(|!clipbox.active          = | & !this.active)
  !data.append(|!clipbox.capColour = object colour(| & !this.capColour.code & |)| )
  !data.append(|!clipbox.view            = | & !this.view.fullname())
  !data.append(|!clipbox.box.xlength     = | & !this.box.xlength)
  !data.append(|!clipbox.box.ylength     = | & !this.box.ylength)
  !data.append(|!clipbox.box.zlength     = | & !this.box.zlength)
  !data.append(|!clipbox.box.position    = | & !this.box.position.string())
  !data.append(|!clipbox.box.orientation = | & !this.box.orientation.string())
  !data.append(!this.view.owner().fullname() & |.clipbox = !clipbox|)

  -- Enable
  if (!this.active) then
    !data.append(!this.view.owner().fullname() & |.clipbox.set()|)
  endif

  -- Capping
  if (!this.capping) then
    !data.append(!this.view.owner().fullname() & |.clipbox.capOn()| )
    !data.append(!this.view.owner().fullname() & |.clipbox.capColour(| & !this.capColour.code & |)| )
  endif

  return !data

endmethod
-- End of method definition for .save() ARRAY
