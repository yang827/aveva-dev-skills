--
-- Description:
-- View Clip Box
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  capColour(REAL)                  -
--  capOff()                         -
--  capOn()                          -
--  coreObject()                     GMFBOX
--  definition()                     ARRAY
--  disable()                        -
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw clip box to graphics canvas
--  edit(REAL)                       -
--  enable()                         -
--  gphClipbox()                     -
--  gphClipbox(GADGET)               -
--  orientation()                    ORIENTATION
--  orientation(ORIENTATION)         -
--  position()                       POSITION
--  position(POSITION)               -
--  save()                           ARRAY               Return array of strings to save object
--  set()                            -
--
------------------------------------------------------------------------

-- Define object
define object GPHCLIPBOX

  -- Description
  member .description is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Box definition
  member .box         is GMFBOX

  -- Clip cap colour
  member .capColour   is COLOUR

  -- Capping active
  member .capping     is BOOLEAN

  -- Until we have a method to determine if clipping is enabled
  -- we'll have to maintain this member
  member .active      is BOOLEAN

  -- View box gadget is associated to
  member .view        is GADGET

endobject
-- End of object definition for GPHCLIPBOX

------------------------------------------------------------------------
--
-- Method:      gphClipBox
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .gphClipbox()

  -- Initialise Variables
  !this.tag             = TRUE
  !this.detail          = FALSE
  !this.visible         = TRUE
  !this.active          = FALSE
  !this.capping         = FALSE
  !this.box.orientation = object ORIENTATION('Y is N')
  !this.box.position    = object POSITION('N0')
  !this.box.xLength     = 1000mm
  !this.box.yLength     = 1000mm
  !this.box.zLength     = 1000mm
  !this.capColour.colour('red')

endmethod
-- End of method definition for .gphClipbox()

------------------------------------------------------------------------
--
-- Method:      gphClipBox
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .gphClipbox(!gadget is GADGET)

  -- Initialise Variables
  !this.gphClipbox()

  -- Get form name
  !text = 'Clipbox (' & !gadget.owner().type & ' ' & !gadget.owner().number & ')'

  -- Clip box data (should be in clipbox object)
  !this.view            = !gadget
  !this.description     = !text

endmethod
-- End of method definition for .gphClipbox(GADGET)

