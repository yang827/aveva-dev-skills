-- File:            gphclipplane.pmlobj
--   Type:          Object Definition
--   Group:         Graphics
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Nov 06 10:09:38 WAT 2006
--
--
-- Description:     Clipping plane for graphical view
-- Graphical Plane
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  capColour(REAL)                  -                   Set clip cap colour
--  capOff()                         -                   Disable Clipping Cap
--  capOn()                          -                   Enable Clipping Cap
--  clear()                          -                   Unset position and direction
--  define(POSITION,DIRECTION)       -                   Define clipping plane
--  draw(REAL,REAL)                  -                   Draw plane to graphics canvas
--  enable(BOOLEAN)                  -                   Enable clipping plane
--  enabledInView()                  BOOLEAN             True if plane is enabled and clip planes are on
--  gphClipPlane()                   -                   Constructor
--  gphClipPlane(GADGET,REAL)        -                   Constructor
--  notDefined()                     BOOLEAN             True if position or direction unset
--  save()                           ARRAY               Return array of strings to save object
--
------------------------------------------------------------------------

-- Define object
define object GPHCLIPPLANE

  -- Owning view
  member .view          is GADGET

  -- Plane number
  member .number        is REAL

  -- Position
  member .position      is POSITION

  -- Orientation
  member .direction     is DIRECTION

  -- Enabled
  member .enabled       is BOOLEAN

  -- Capping colour
  member .capColour     is COLOUR

  -- Capping on
  member .capping       is BOOLEAN

endobject
-- End of object definition for GPHPLANE

------------------------------------------------------------------------
--
-- Method:      gphClipPlane
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET        View gadget on parent form
--    2   R      REAL        Clipping plane number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphClipPlane()

  -- Initialise variables
  !this.enabled = FALSE
  !this.capping = FALSE
  !this.capColour.colour('red')

endmethod
-- End of method definition for .gphClipPlane()

------------------------------------------------------------------------
--
-- Method:      gphClipPlane
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET        View gadget on parent form
--    2   R      REAL        Clipping plane number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphClipPlane(!view is GADGET, !number is REAL)

  -- Initialise variables
  !this.gphClipPlane()
  !this.view    = !view
  !this.number  = !number

endmethod
-- End of method definition for .gphClipPlane(VIEW, REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw plane to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !colour is REAL)

  -- Mark position of clip plane
  !arrowHeight = 1000mm
  !text = |Clip Plane | & !this.number
  AID CLEAR ALL $!<aidNumber>
  AID ARROW NUMBER $!<aidNumber> AT $!<this.position> DIR $!<this.direction> HEIGHT $!arrowHeight
  AID TEXT NUMBER $!<aidNumber> |$!text| AT $!this.position

endmethod
-- End of method definition for .draw(REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      define
--
-- Description: Define clipping plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Clip plane position
--    2   R      DIRECTION   Clip plane direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .define(!position is POSITION, !direction is DIRECTION)

  -- Get world ref
  !worldName = |/*|
  !world  = !worldName.dbref()

  -- Define clipping plane
  !this.position  = !position
  !this.direction = !direction
  !positionArray  = ARRAY()
  !directionArray = ARRAY()
  !positionArray[1]  = !this.position.wrt(!world).east
  !positionArray[2]  = !this.position.wrt(!world).north
  !positionArray[3]  = !this.position.wrt(!world).up
  !directionArray[1] = !this.direction.wrt(!world).east
  !directionArray[2] = !this.direction.wrt(!world).north
  !directionArray[3] = !this.direction.wrt(!world).up
  !this.view.defineClipPlane(!this.number, !positionArray, !directionArray)
  !this.view.setClipPlaneCapping(!this.number, !this.capColour.code, !this.capping)

endmethod
-- End of method definition for .define()

------------------------------------------------------------------------
--
-- Method:      notDefined
--
-- Description: True if position or direction unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if position or direction unset
--
------------------------------------------------------------------------

define method .notDefined() is BOOLEAN

  -- Check clipping plane has been defined (badref may mean user has switched MDBs in Design)
  return (!this.position.unset() or !this.direction.unset() or !this.position.origin.badref())

endmethod
-- End of method definition for .notDefined()

------------------------------------------------------------------------
--
-- Method:      enabledInView
--
-- Description: True if plane is enabled and clip planes are on
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if plane is enabled and clip planes are on
--
------------------------------------------------------------------------

define method .enabledInView() is BOOLEAN

  -- Check if clipping plane is enabled and displayed
  return (!this.enabled and !this.view.clipPlanesAllOff.not())

endmethod
-- End of method definition for .enabledInView()

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Unset position and direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()

  -- Unset position and direction so clipplane is notDefined()
  !this.position = object POSITION()
  !this.direction = object DIRECTION()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      enable
--
-- Description: Enable clipping plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Enabled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enable(!enabled is BOOLEAN)

  -- Enable (or disable) clipping plane
  !this.enabled = !enabled
  !this.view.setClipPlaneEnabled(!this.number, !enabled)
  !this.view.clipPlanesAllOff = FALSE
  !this.view.clipping = TRUE

  -- Update buttons
  !this.view.owner().lclippingMenu.select('Enable',true)
  if(defined(!this.view.owner().clippingButton)) then
    !this.view.owner().clippingButton.val = true
  endif

  -- Hide clip box form and aid graphics
  if (defined(!!gphClipBoxEdit)) then
    if (!!gphClipBoxEdit.shown()) then
      if (!this.view eq !!gphClipBoxEdit.clipbox.view) then
    hide !!gphClipBoxEdit
    !!gphClipBoxEdit.close()
  endif
    endif
  endif

endmethod
-- End of method definition for .enable(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      capOn
--
-- Description:
--   Enable Clipping Capping
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .capOn()

  -- Switch capping on
  !this.capping = TRUE
  if (!this.enabled) then
    !this.view.setClipPlaneCapping(!this.number, !this.capColour.code, TRUE)
  endif

endmethod
-- End of method definition for .capOn()

------------------------------------------------------------------------
--
-- Method:      capOff
--
-- Description:
--   Disable Clipping Cap
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .capOff()

  -- Switch capping off
  !this.capping = FALSE
  if (!this.enabled) then
    !this.view.setClipPlaneCapping(!this.number, !this.capColour.code, FALSE)
  endif

endmethod
-- End of method definition for .capOff()

------------------------------------------------------------------------
--
-- Method:      capColour
--
-- Description:
--   Set clip cap colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .capColour(!colour is REAL)

  -- Set capping colour
  !this.capColour.colour(!colour)
  if (!this.enabled) then
    !this.view.setClipPlaneCapping(!this.number, !colour, !this.capping)
  endif

endmethod
-- End of method definition for .capColour(REAL)

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description:
--   Return array of strings to save object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Strings to recreate object
--
------------------------------------------------------------------------

define method .save() is ARRAY

  -- Build array of data
  !data = ARRAY()
  !data.append(|!clipplane           = object GPHCLIPPLANE()|)
  !data.append(|!clipplane.number    = | & !this.number)
  !data.append(|!clipplane.view      = | & !this.view.fullname())
  !data.append(|!clipplane.capping   = | & !this.capping)
  !data.append(|!clipplane.capColour = object colour(| & !this.capColour.code & |)| )
  !data.append(!this.view.owner().fullname() & |.clipplanes[| & !this.number & |] = !clipplane|)

  -- Define plane
  if (!this.notDefined().not()) then
    !posString = |object position('|  & !this.position.string()  & |')|
    !dirString = |object direction('| & !this.direction.string() & |')|
    !data.append(!this.view.owner().fullname() & |.clipplanes[| & !this.number & |].define(| & !posString & |, | & !dirString & |)| )
  endif

  -- Enable plane
  if (!this.enabledInView()) then
    !data.append(!this.view.owner().fullname() & |.clipplanes[| & !this.number & |].enable(TRUE)| )
  endif

  -- Capping
  if (!this.capping) then
    !data.append(!this.view.owner().fullname() & |.clipplanes[| & !this.number & |].capOn()| )
  endif

  return !data

endmethod
-- End of method definition for .save() ARRAY
