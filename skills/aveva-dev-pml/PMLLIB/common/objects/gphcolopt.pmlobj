-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [value for the visible element colour]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .visible(!value is REAL)

  -- convert the REAL to a COLOUR
  !colourObject = object COLOUR()
  !colourObject.colour(!value)

  -- set the visible colour
  !this.visible = !colourObject

  -- if this is the global instance then set the core options
  if (!this.global) then
    !colString = !colourObject.string()
    COLOUR VISIBLE $!<colString>
  endif

endmethod
-- End of method definition for .visible(REAL)

