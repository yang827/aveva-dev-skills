-- Created:         Mon Aug 18 14:12:58 BST 1997
--
--
-- Description:
-- Object to store colour options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active()                         COLOUR              get the active element colour
--  active(COLOUR)                   -                   set the active element colour
--  active(REAL)                     -                   set the active element colour
--  active(STRING)                   -                   set the active element colour
--  aids()                           COLOUR              get the aid graphics colour
--  aids(COLOUR)                     -                   set the aid graphics colour
--  aids(REAL)                       -                   set the aid graphics colour
--  aids(STRING)                     -                   set the aid graphics colour
--  autoColour()                     BOOLEAN             get the auto add colour state
--  autoColour(BOOLEAN)              -                   set the auto add colour state
--  autoColourRules()                ARRAY               get the auto add colour rules
--  autoColourRules(ARRAY)           -                   set the auto add colour rules
--  ce()                             COLOUR              get the current element colour
--  ce(COLOUR)                       -                   set the current element colour
--  ce(REAL)                         -                   set the current element colour
--  ce(STRING)                       -                   set the current element colour
--  copyToGlobal()                   -                   copy the object to the global instance
--  coreSettings()                   -                   Align all core settings with the member values
--  default(BOOLEAN)                 -                   Default options settings
--  dynamicAutoColour()              BOOLEAN             get the dynamic auto colour state
--  dynamicAutoColour(BOOLEAN)       -                   set the dynamic auto colour state
--  edit()                           -                   edit the options via the GUI
--  getCoreSettings()                -                   Get all core settings into member values
--  globalInstance()                 -                   create a global instance of the object
--  gphColOpt()                      -                   Constructor
--  gphColOpt(BOOLEAN)               -                   Constructor
--  highlight()                      COLOUR              get the highlight element colour
--  highlight(COLOUR)                -                   set the highlight element colour
--  highlight(REAL)                  -                   set the highlight element colour
--  highlight(STRING)                -                   set the highlight element colour
--  load()                           -                   Load options from system and user files
--  localCopy()                      GPHCOLOPT           return a local copy of the object
--  save()                           -                   Save options settings to %PDMSUSER%
--  visible()                        COLOUR              get the visible element colour
--  visible(COLOUR)                  -                   set the visible element colour
--  visible(REAL)                    -                   set the visible element colour
--  visible(STRING)                  -                   set the visible element colour
--
------------------------------------------------------------------------

-- Define object
define object GPHCOLOPT

  -- current options file name for this object
  member .filename is STRING
  member .optionsFileType is STRING
  member .optionFileObject is DEFAULTFILE

  -- global object flag, if set then global core options are also set
  member .global is BOOLEAN

  -- members to store colour settings
  member .ce        is COLOUR
  member .active    is COLOUR
  member .aids      is COLOUR
  member .visible   is COLOUR
  member .highlight is COLOUR

  -- array of GPHAUTOCOLOUR objects
  member .autoColourRules is ARRAY

  member .autoColour is BOOLEAN
  member .dynamicAutoColour is BOOLEAN

endobject
-- End of object definition for GPHCOLOPT

------------------------------------------------------------------------
--
-- Method:      !gphColOpt()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphColOpt()

  -- set file name
  -- implemented a check for the modkey of the module to make sure we are getting the correct outfitting defaults
  !module = !!module()
  !thisModkey = !module.modKey.upcase()
  handle ANY
    !this.filename = !module.appKey + '-col.pmldat'
  elsehandle NONE
    if (!thisModkey.eq('MARODES')) then
      !this.filename = !module.modKey + '-col.pmldat'
    else
      !this.filename = !module.appKey + '-col.pmldat'
    endif
  endhandle
  !this.optionsFileType = ''

  -- initialise the global flag
  !this.global = false

  -- set the default values
  !this.default(false)

endmethod
-- End of method definition for .gphColOpt()

------------------------------------------------------------------------
--
-- Method:      !gphColOpt(BOOLEAN)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .gphColOpt(!globalValue is BOOLEAN)

  -- run default constructor
  !this.gphColOpt()

  -- initialise the global flag
  !this.global = !globalValue

  -- set the default values
  !this.default(!globalValue)

endmethod
-- End of method definition for .gphColOpt(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !default(BOOLEAN)
--
-- Description: Default options settings
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .default(!setCore is BOOLEAN)

  !module = !!module()

  -- define default settings here
  !this.ce.colour('yellow')
  !this.active.colour('orange')
  !this.aids.colour('blue')
  !this.visible.colour('lightgrey')
  !this.highlight.colour('white')

  --!session = current session
  --if (!session.module().lowcase() eq 'draft') then
  if (!module.appName.upcase() eq 'DRAFT') then
    !this.highlight.colour('brightred')
  endif

  if (!module.appKey.upcase() eq 'SPL') then

    !gphAutoColourRul = |Spool Elements|
    !gphAutoColourCol = object COLOUR(|cyan|)
    !gphAutoColour    = object GPHAUTOCOLOUR(!gphAutoColourRul, !gphAutoColourCol)
    !tempArray[1] = !gphAutoColour

    !gphAutoColourRul = |Field Elements|
    !gphAutoColourCol = object COLOUR(|green|)
    !gphAutoColour    = object GPHAUTOCOLOUR(!gphAutoColourRul, !gphAutoColourCol)
    !tempArray[2] = !gphAutoColour

    !this.autoColourRules = !tempArray

    !this.autoColour = true
    !this.dynamicAutoColour = false

  else
    !this.autoColour = false
    !this.dynamicAutoColour = false
  endif

  if (!setCore) then
    !this.coreSettings()
  endif

endmethod
-- End of method definition for .default(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- create the global instance of this object
  !!gphColOpt = !this
  !!gphColOpt.global = true

  -- load the options settings
  !!gphColOpt.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [GPHREPOPT] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is GPHCOLOPT

  -- get core settings before making local copy
  !this.getCoreSettings()

  -- copy this object to a local variable and unset the global flag
  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() GPHCOLOPT

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  !!gphColOpt = !this
  !!gphColOpt.global = true
  !!gphColOpt.coreSettings()

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method: !coreSettings()
--
-- Description: Align all core settings with the member values
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .coreSettings()

  !colString = !this.ce.string()
  COLOUR CE $!<colString>

  !colString = !this.active.string()
  COLOUR ACTIVE $!<colString>

  !colString = !this.aids.string()
  COLOUR AIDS $!<colString>

  !colString = !this.visible.string()
  COLOUR VISIBLE $!<colString>

  AUTOCOLOUR RESET
  do !entry values !this.autoColourRules
    !entry.setAutoColour()
  enddo

  if (!this.autoColour) then
    AUTOCOLOUR ON
  else
    AUTOCOLOUR OFF
  endif

  if (!this.dynamicAutoColour) then
    AUTOCOLOUR DYNAMIC ON
  else
    AUTOCOLOUR DYNAMIC OFF
  endif

endmethod
-- End of method definition for .coreSettings()

------------------------------------------------------------------------
--
-- Method: !getCoreSettings()
--
-- Description: Get all core settings into the member values
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getCoreSettings()

  var !tmp COLOUR CE
  !this.ce.colour(!tmp)

  var !tmp COLOUR ACTIVE
  !this.active.colour(!tmp)

  var !tmp COLOUR AIDS
  !this.aids.colour(!tmp)

  var !tmp COLOUR VISIBLE
  -- If visible colour is unset keep default colour
  if (!tmp eq 'Mix Red 0 Green 0 Blue 0') then
    !visible = !!gphColOpt.visible()
    COLOUR VISIBLE $!visible
    var !tmp COLOUR VISIBLE
  endif
  !this.visible.colour(!tmp)

  var !tmp AUTOCOLOUR MODE
  !this.autoColour = !tmp.boolean()

  var !tmp AUTOCOLOUR DYNAMIC
  !this.dynamicAutoColour = !tmp.boolean()

endmethod
-- End of method definition for .getCoreSettings()

------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------
define method .load()

  -- get the locations of system options file and user options file (ARRAY of DEFAULTFILE())
  !optionDefaultFiles = !!searchPaths(!this.filename)
  -- put USER in [1], PROJ in [2] and DFLTS in [3]
  !optionFiles = ARRAY()
  do !oDefaultFile values !optionDefaultFiles
    !optionType = !oDefaultFile.getDefaultType()
    if(!optionType eq 'DEFAULT') then
      !index = 3
    elseif(!optionType eq 'PROJ') then
      !index = 2
    else
      -- assume USER
      !index = 1
    endif
    !optionFiles[!index] = !oDefaultFile
  enddo

  if( !optionFiles.empty() ) then
    -- no colour rules found
    !this.coreSettings()
    !this.optionsFileType  = 'USER'
    !this.optionFileObject = object DEFAULTFILE()
    return
  endif

  -- colour rules found
  -- user USER, PROJ, DFLTS in that order of preference
  if( defined(!optionFiles[1]) ) then
    !warning     = 32
    !optionsFile = 'USER'
    !this.optionFileObject = !optionFiles[1]
  elseif( defined(!optionFiles[2]) ) then
    !warning     = 31
    !optionsFile = 'PROJ'
    !this.optionFileObject = !optionFiles[2]
  elseif( defined(!optionFiles[3]) ) then
    !warning     = 31
    !optionsFile = 'DEFAULT'
    !this.optionFileObject = !optionFiles[3]
  endif
  !localName   = !this.optionFileObject.fullName

  -- create a temporary global variable to store the data
  if (defined(!!tmpGphColOpt)) then
    !!tmpGphColOpt.delete()
  endif
  !!tmpGphColOpt = !this

    -- load options file
  $m "$!<localName>"
  handle any
    !!messageFile.warning(146, !warning, !localName)
    !this.default(false)
    !optionsFile = ''
  endhandle

  !this = !!tmpGphColOpt
  !this.coreSettings()
  !this.optionsFileType = !optionsFile

  -- set core highlight colour
  !anyDrawlist = object drawlist()
  !anyDrawlist.highlightColour(!this.highlight.code)

  !!tmpGphColOpt.delete()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method: !save()
--
-- Description: Save options settings to %PDMSUSER%
--
-- Method Type: Function
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()
  !userEnvironmentVariable = '%PDMSUSER%/'

  -- write header information
  !saveContents.append('-- Data file for graphical colour options')
  !saveContents.append('')

  ----------------------------------------------------------------------
  -- user options are  saved for all users
  ----------------------------------------------------------------------
  -- save colours
  !saveContents.append('!!tmpGphColOpt.ce.colour(' & !!comQuoteIfString(!this.ce.key()) & ')')
  !saveContents.append('!!tmpGphColOpt.active.colour(' & !!comQuoteIfString(!this.active.key()) & ')')
  !saveContents.append('!!tmpGphColOpt.aids.colour(' & !!comQuoteIfString(!this.aids.key()) & ')')
  !saveContents.append('!!tmpGphColOpt.visible.colour(' & !!comQuoteIfString(!this.visible.key()) & ')')
  !saveContents.append('!!tmpGphColOpt.highlight.colour(' & !!comQuoteIfString(!this.highlight.key()) & ')')

  -- save autocolour rules
  -- check for element rules disallowed
  !disallowedRules = ARRAY()
  if( !this.optionsFileType eq 'DEFAULT' ) then
    !disallowedRules[1] = 'USER'
    !disallowedRules[2] = 'PROJ'
  elseif( !this.optionsFileType eq 'PROJ' ) then
    !disallowedRules[1] = 'USER'
  endif

  !disallowedRuleType = ''
  if (!this.autoColourRules.empty().not()) then
    !saveContents.append('')
    !saveContents.append('!tempArray = ARRAY()')
    !saveContents.append('')
    do !i indices !this.autoColourRules
      -- check for using disallowed rules
      if ( !this.optionsFileType neq 'USER' and !disallowedRuleType.empty() ) then
        -- saving a system colour rule set, so must make sure that no user element rules are used
        -- if one user element rule has been found we do not need to test the remaining colour rules
        !rule = !!ruleStore.element.getRule(!this.autoColourRules[!i].rule)
        if(!disallowedRules.findFirst(!rule.location).set()) then
          !disallowedRuleType = !rule.location
        endif
      endif
      !saveContents.appendArray(!this.autoColourRules[!i].save())
      !saveContents.append('!tempArray[' & !i & '] = !gphAutoColour')
      !saveContents.append('')
    enddo
    !saveContents.append('!!tmpGphColOpt.autoColourRules = !tempArray')
  endif

  -- save autocolour status
  !saveContents.append('!!tmpGphColOpt.autoColour = ' & !this.autoColour)
  -- save dynamic autocolour status
  !saveContents.append('!!tmpGphColOpt.dynamicAutoColour = ' & !this.dynamicAutoColour)

  -- end of user options
  -- if writing a USER rule set, then anyone can do this
  if ( !this.optionsFileType eq 'USER' ) then
    !!writeFile(!userEnvironmentVariable + !this.filename, 'OVERWRITE', !saveContents)
    handle (41,319)
      !!alert.error('You do not have write access to %PDMSUSER%/' + !this.filename)
    endhandle
    return
  endif

  ----------------------------------------------------------------------
  -- system options are only saved if the user has administrator status
  ----------------------------------------------------------------------
  !failedWriteToDefaultsFile = false
  if( !!comAdminStatus() ) then
    -- write to DEFAULT file
    if( !disallowedRuleType.empty().not() ) then
      -- cannot write to defaults area a file using user rules
      !!alert.warning('Colour rules cannot be saved in System defaults file because at least one colour rule uses a local (' + !disallowedRuleType + ') element rule.')
      !failedWriteToDefaultsFile = true
    else
      -- write rules to system file
      !!writeFile(!this.optionFileObject.name(), 'OVERWRITE', !saveContents)
      handle any
        -- cannot write to file
        !failedWriteToDefaultsFile = true
      endhandle
    endif
  else
    -- cannot write to  defaults file if not ADMIN status
    !failedWriteToDefaultsFile = true
  endif

  if( !failedWriteToDefaultsFile.not() ) then
    -- defaults file has been written
    return
  endif

  -- Offer to write to User file
  if( !this.optionsFileType eq 'PROJ' ) then
    !message = 'Project'
  else
    !message = 'System'
  endif
  !reply = !!alert.confirm('Access denied to write to ' + !message  + ' colour rules. Do you want to write to local (user) colour rules?')
  if( !reply eq 'YES' ) then
    -- write user colour rules file
    !!writeFile(!userEnvironmentVariable + !this.filename, 'OVERWRITE', !saveContents)
    !this.optionsFileType = 'USER'
  endif
  return

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
-- Description: edit the options via the GUI
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .edit()

  -- show the main edit form
  loadform !!gphSettings
  !!gphSettings.showForm('COLOUR')

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: get the current element colour
--
-- Method Type: Function
-- Return:
--   [COLOUR] [value of the current element colour]
--
------------------------------------------------------------------------
define method .ce() is COLOUR

  return !this.ce

endmethod
-- End of method definition for .ce() COLOUR

------------------------------------------------------------------------
--
-- Method:      !ce(COLOUR)
--
-- Description: set the current element colour
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [COLOUR] [value for the current element colour]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .ce(!value is COLOUR)

  -- set the ce colour
  !this.ce = !value

  -- if this is the global instance then set the core options
  if (!this.global) then
    !colString = !value.string()
    COLOUR CE $!<colString>
  endif

endmethod
-- End of method definition for .ce(COLOUR)

------------------------------------------------------------------------
--
-- Method:      !ce(STRING)
--
-- Description: set the current element colour
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [value for the current element colour]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .ce(!value is STRING)

  -- convert the STRING to a COLOUR
  !colourObject = object COLOUR()
  !colourObject.colour(!value)

  -- set the ce colour
  !this.ce = !colourObject

  -- if this is the global instance then set the core options
  if (!this.global) then
    !colString = !colourObject.string()
    COLOUR CE $!<colString>
  endif

endmethod
-- End of method definition for .ce(STRING)

