------------------------------------------------------------------------
--
-- Method: !dynamicAutoColour(BOOLEAN)
--
-- Description: set the auto add colour state
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [values for auto add colour state]
--
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .dynamicAutoColour(!value is BOOLEAN)

  -- set the autocolour option
  !this.dynamicAutoColour = !value

  -- if this is the global instance then set the core options
  if (!this.global) then
    if (!value) then
      AUTOCOLOUR DYNAMIC ON
    else
      AUTOCOLOUR DYNAMIC OFF
    endif
  endif

endmethod
-- End of method definition for .autoColour(BOOLEAN)
