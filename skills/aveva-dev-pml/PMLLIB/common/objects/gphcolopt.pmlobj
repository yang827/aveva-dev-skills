------------------------------------------------------------------------
--
-- Method: !autoColourRules()
--
-- Description: get the auto add colour rules
--
-- Method Type: Procedure
-- Return:
--   [REAL] [value of the auto add colour rules]
--
------------------------------------------------------------------------

define method .autoColourRules() is ARRAY

  return !this.autoColourRules

endmethod
-- End of method definition for .autoColourRules() ARRAY

------------------------------------------------------------------------
--
-- Method: !autoColourRules(ARRAY)
--
-- Description: set the auto add colour rules
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [ARRAY] [values for auto add colour rules]
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------

define method .autoColourRules(!value is ARRAY)

  -- set the autocolour rules
  !this.autoColourRules = !value

  -- if this is the global instance then set the core options
  if (!this.global) then

    AUTOCOLOUR RESET
    do !entry values !this.autoColourRules
      -- get the rule object
      !ruleString = !!ruleStore.element.getRule(!entry.rule).string()

      if (!entry.colourExp.unset()) then
        !colString = !entry.colour.code.string()
      else
        !colString = '( ' + !entry.colourExp + ' )'
      endif
      AUTOCOLOUR $!<ruleString> COLOUR $!<colString>
    enddo
  endif

endmethod
-- End of method definition for .autoColourRules(ARRAY)

------------------------------------------------------------------------
--
-- Method: !autoColour()
--
-- Description: get the auto add colour state
--
-- Method Type: Procedure
-- Return:
--   [BOOLEAN] [value of the auto add colour state]
--
------------------------------------------------------------------------
define method .autoColour() is BOOLEAN

  return !this.autoColour

endmethod
-- End of method definition for .autoColour() BOOLEAN

------------------------------------------------------------------------
--
-- Method: !autoColour(BOOLEAN)
--
-- Description: set the auto add colour state
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [values for auto add colour state]
--
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .autoColour(!value is BOOLEAN)

  -- set the autocolour option
  !this.autoColour = !value

  -- if this is the global instance then set the core options
  if (!this.global) then
    if (!value) then
      AUTOCOLOUR ON
    else
      AUTOCOLOUR OFF
    endif
  endif

endmethod
-- End of method definition for .autoColour(BOOLEAN)

------------------------------------------------------------------------
--
-- Method: !dynamicAutoColour()
