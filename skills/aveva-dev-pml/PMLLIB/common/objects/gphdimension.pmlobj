--
--
-- Description:
-- Graphical dimension.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidLine(REAL,POSITION,POSITION)  -                   MDS  Only
--  align()                          -                   MDS Only - Display MDS Framework Support - Align Form
--  coreObject()                     LINE                Returns underlying core object of graphical object (returns a line even though this isn't the core object, it gives us something to use)
--  definition()                     ARRAY               Definition of object to save to file
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,ARC)                   -                   Draw dimension to graphics canvas
--  draw(REAL,BOOLEAN)               -                   Draw dimension to graphics canvas
--  edit()                           -                   Display edit form
--  edit(REAL)                       -                   Edit a specific dimension in the aid number system
--  editPerpendicular()              -                   Display edit form
--  gphDimension()                   -                   Constructor
--  gphDimension(POSITION,POSITION)  -                   Constructor
--  labelENU()                       -                   Sets labelling to offset
--  labelUVW()                       -                   Sets labelling to UVW
--  labelXYZ()                       -                   Sets labelling to XYZ
--  offset()                         ARRAY               Returns XYZ offset values
--  setDimension(ARC)                -                   Set dimension to arc definition
--  setDimension(POSITION,POSITION)  -                   Set dimension
--  setPerpendicular(BOOLEAN)        -                   Set dimension in perpendicular or distance mode
--  wrt(DBREF)                       -                   Sets with respect to
--
------------------------------------------------------------------------


define object GPHDIMENSION

  -- Description
  member .description     is STRING

  -- Tag with data
  member .tag             is BOOLEAN

  -- Type of labelling
  member .labelType       is STRING
  member .labelText       is ARRAY
  member .dimensionLabel  is STRING
  -- show arrow heads on dimension lines
  member .arrowHeads      is BOOLEAN
  -- show orthogonal dimension lines but not the direct dimension line
  member .orthogonalOnly  is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Dimension Definition
  member .from         is POSITION
  member .to           is POSITION
  member .arc          is ARC

  -- Frame of reference
  member .wrt          is DBREF

  -- Default output format
  member .format       is FORMAT

endobject
-- End of object definition for GPHDIMENSION

------------------------------------------------------------------------
--
-- Method:      gphDimension
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphDimension()

  -- Initialise Variables
  !this.tag        = FALSE
  !this.detail     = TRUE
  !this.visible    = TRUE
  !this.arrowHeads = true
  !this.orthogonalOnly = false
  !this.dimensionLabel = 'Distance'
  !this.wrt        = World
  !this.from       = object POSITION('E0 N0 U0')
  !this.to         = object POSITION('E0 N0 U0')
  !this.arc        = object ARC()
  !this.format     = !!distanceFmt
  var !coordinate coordinate
  if(!coordinate eq 'ENU')then
    !this.labelXYZ()
  else
    !this.labelUVW()
  endif

endmethod
-- End of method definition for .gphDimension()

------------------------------------------------------------------------
--
-- Method:      gphDimension
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    1   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphDimension(!from is POSITION, !to is POSITION)

  -- Initialise Variables
  !this.gphDimension()
  !this.from  = !from.wrt(!this.wrt)
  !this.to    = !to.wrt(!this.wrt)

endmethod
-- End of method definition for .gphDimension(POSITION, POSITION)
------------------------------------------------------------------------
--
-- Method:      setDimension
--
-- Description: Set dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    2   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDimension(!from is POSITION, !to is POSITION)

  -- Initialise Variables
  !this.from  = !from.wrt(!this.wrt)
  !this.to    = !to.wrt(!this.wrt)
  !this.arc   = object ARC()

endmethod
-- End of method definition for .setDimension(POSITION, POSITION)
------------------------------------------------------------------------
--
-- Method:      setDimension
--
-- Description: Set dimension to arc definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc definition of dimension
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDimension(!arc is ARC)

  -- Initialise Variables
  !this.arc     = !arc
  if( !this.arc.set() ) then
    !this.from  = !arc.position
    !this.to    = !arc.anglePosition(0)
  else
    !this.from  = object POSITION()
    !this.to    = object POSITION()
  endif

endmethod
-- End of method definition for .setDimension(POSITION, POSITION)

------------------------------------------------------------------------
--
-- Method:      setPerpendicular
--
-- Description: Set dimension in perpendicular or distance mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    1   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPerpendicular(!perpendicular is BOOLEAN)

  if( !perpendicular ) then
    !this.editPerpendicular()
  else
    !this.edit()
  endif

endmethod
-- End of method definition for .setPerpendicular(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object (returns a line even though this isn't the core object, it gives us something to use)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE        Line from start to finish
--
------------------------------------------------------------------------

define method .coreObject() is LINE

  return object LINE(!this.from, !this.to)

endmethod
-- End of method definition for .coreObject() LINE
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, TRUE)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw dimension to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  if( !this.arc.set() ) then
    -- draw dimension from ARC parameters
    !this.draw(!aidNumber, !this.arc)
    return
  endif

  -- Don't do anything if the distance is zero
  !length   = !this.from.distance(!this.to)

  if(!length eq 0) then
    return
  endif
  -- Dimension information
  !midPoint = !this.from.midPoint(!this.to)
  !offset   = !this.offset()

  -- Draw Linear dimension
  if( !this.orthogonalOnly.not() or !this.detail.not() ) then
    !tempString    = !length.string(!this.format)
    !this.aidLine(!aidNumber, !this.from, !this.to)
    if( !this.dimensionLabel.empty().not() ) then
      !tempString  = !this.dimensionLabel + ' ' + !tempString
    endif
    AID TEXT NUMBER $!<aidNumber> |$!<tempString>| AT $!<midPoint>
  endif

  -- Draw detail of line
  if(!this.orthogonalOnly or (!this.detail and int(!offset[1] + !offset[2] + !offset[3]) ne int(!length))) then

    !xPosition       = !this.from
    !xPosition.east  = !this.to.east
    !yPosition       = !xPosition
    !yPosition.north = !this.to.north

    -- Only draw dimension ne 0
    if(!offset[1].between(-0.1mm, 0.1mm).not()) then
      !tempString    = !offset[1].string(!this.format)
      !xMidPoint = !this.from.midPoint(!xPosition)
      !this.aidLine(!aidNumber, !this.from, !xPosition)
      AID TEXT NUMBER $!<aidNumber> |$!<this.labelText[1]> $!<tempString>| AT $!xMidPoint
    endif

    if(!offset[2].between(-0.1mm, 0.1mm).not()) then
      !tempString    = !offset[2].string(!this.format)
      !yMidPoint = !xPosition.midPoint(!yPosition)
      !this.aidLine(!aidNumber, !xPosition, !yPosition)
      AID TEXT NUMBER $!<aidNumber> |$!<this.labelText[2]> $!<tempString>| AT $!yMidPoint
    endif

    if(!offset[3].between(-0.1mm, 0.1mm).not()) then
      !tempString    = !offset[3].string(!this.format)
      !zMidPoint = !yPosition.midPoint(!this.to)
      !this.aidLine(!aidNumber, !yPosition, !this.to)
      AID TEXT NUMBER $!<aidNumber> |$!<this.labelText[3]> $!<tempString>| AT $!zMidPoint
    endif
  endif

  -- Tag Line
  if(!this.tag) then
    AID TEXT NUMBER $!<aidNumber> 'From $!<this.from>' AT $!<this.from>
    AID TEXT NUMBER $!<aidNumber> 'To $!<this.to>'     AT $!<this.to>
  endif

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw dimension to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !arc is ARC)

  if( !arc.unset() ) then
    return
  endif

  !from     = !arc.anglePosition(0)
  !to       = !arc.position

  -- Don't do anything if the distance is zero
  !length   = !from.distance(!to)

  if(!length eq 0) then
    return
  endif

  -- Dimension information
  !midPoint = !from.midPoint(!to)

  -- Draw Linear dimension
  if( !this.orthogonalOnly.not() or !this.detail.not() ) then
    !tempString    = !length.string(!this.format)
    !this.aidLine(!aidNumber, !from, !to)
    if( !this.dimensionLabel.empty().not() ) then
      !tempString  = !this.dimensionLabel + ' ' + !tempString
    endif
    AID TEXT NUMBER $!<aidNumber> |$!<tempString>| AT $!<midPoint>
  endif

  -- Tag Line
  if(!this.tag) then
    AID TEXT NUMBER $!<aidNumber> 'From $!<from>' AT $!<from>
    AID TEXT NUMBER $!<aidNumber> 'To $!<to>'     AT $!<to>
  endif

  if( !this.detail or !this.orthogonalOnly) then
    !pv       = object POINTVECTOR(!to, object DIRECTION('D WRT WORLD'))
    !line     = !pv.line(1000mm)
    !datum    = !line.near(!from)

    if( !to.distance(!datum) lt 1mm or !from.distance(!datum) lt 1mm ) then
      -- if orthogonal dimensions are not drawn, then the linear dimension must be drawn
      if( !this.orthogonalOnly ) then
        !tempString    = !length.string(!this.format)
        !this.aidLine(!aidNumber, !from, !to)
        if( !this.dimensionLabel.empty().not() ) then
          !tempString  = !this.dimensionLabel + ' ' + !tempString
        endif
        AID TEXT NUMBER $!<aidNumber> |$!<tempString>| AT $!<midPoint>
      endif
      return
    endif

    !tempString    = !to.distance(!datum).string(!this.format)
    !midPoint      = !to.midPoint(!datum)
    !this.aidLine(!aidNumber, !to, !datum)
    AID TEXT NUMBER $!<aidNumber> |$!<tempString>| AT $!midPoint

    !tempString    = !from.distance(!datum).string(!this.format)
    !midPoint      = !from.midPoint(!datum)
    !this.aidLine(!aidNumber, !from, !datum)
    AID TEXT NUMBER $!<aidNumber> |$!<tempString>| AT $!midPoint
  endif

endmethod
-- End of method definition for .draw(REAL, ARC)

------------------------------------------------------------------------
--
-- Method:      aidLine
--
-- Description: MDS  Only -- Display MDS Align form -- !!kgphalign
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidLine(!aidNumber is REAL, !from is POSITION, !to is POSITION)

  -- draw line or arrow
  AID LINE NUMBER $!<aidNumber> $!<from> TO $!<to>
  if(!this.arrowHeads) then
    !midPoint  = !from.midPoint(!to)
    !line      = object LINE(!from,!to)
    !direction = !line.direction()
    !arrowSize = min( 32mm, !line.length() / 3)
    !pv        = object POINTVECTOR(!from, !direction)
    !pv        = !pv.offset(!arrowSize)
    !arrowPos1 = !pv.position
    !arrowDir1 = !direction.opposite()
    aid arrow number $!aidNumber at $!arrowPos1 dir $!arrowDir1 height $!arrowSize prop 1
    !pv        = object POINTVECTOR(!to, !arrowDir1)
    !pv        = !pv.offset(!arrowSize)
    !arrowPos2 = !pv.position
    aid arrow number $!aidNumber at $!arrowPos2 dir $!direction height $!arrowSize prop 1
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      align
--
-- Description: MDS  Only -- Display MDS Align form -- !!kgphalign
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .align()

  -- Load line align form if required
  if(undefined(!!kgphalign)) then
    pml load form !!kgphalign
  endif

  -- Setup line
  !!kgphalign.setup()

  -- Define Edit line packet
  !packet                = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.key            = 'editDimension'
  !packet.description    = 'Define a linear dimension'
  !packet.action         = '!!kgphalign.setMeasure(!this.return[1])'
  !packet.form           = !!kgphalign
  !packet.close          = '!!kgphalign.tidy()'
  !packet.priority       = 1
  !packet.remove         = FALSE
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Display edit form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- Load line edit form is required
  if(undefined(!!gphMeasure)) then
    pml load form !!gphMeasure
  endif

  -- Setup line
  !!gphMeasure.setup()

  if( !!gphMeasure.perpendicularTo.val ) then
    !this.editPerpendicular()
    return
  endif

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.key            = 'editDimension'
  !packet.description    = 'Define a linear dimension'
  !packet.action         = '!!gphMeasure.setMeasure(!this.return[1])'
  !packet.form           = !!gphMeasure
  !packet.close          = '!!gphMeasure.tidy()'
  !packet.priority       = 1
  !packet.remove         = FALSE
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      editPerpendicular
--
-- Description: Display edit form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .editPerpendicular()

  -- Load line edit form is required
  if(undefined(!!gphMeasure)) then
    pml load form !!gphMeasure
  endif

  -- Setup line
  !!gphMeasure.setup()

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.defineMeasure('PERPENDICULARTO')
  !packet.key            = 'editDimension'
  !packet.description    = 'Define perpendicular linear dimension'
  !packet.action         = '!!gphMeasure.setPerpendicularMeasure(!this.return[1])'
  !packet.form           = !!gphMeasure
  !packet.close          = '!!gphMeasure.tidy()'
  !packet.priority       = 1
  !packet.remove         = FALSE
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit a specific dimension in the aid number system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Load line edit form is required
  if(undefined(!!gphMeasure)) then
    pml load form !!gphMeasure
  endif

  -- Setup line
  !!gphMeasure.setup(!aidNumber)

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.definePosition('Define Dimension')
  !packet.key            = 'editDimension'
  !packet.description    = 'Define a linear dimension'
  !packet.action         = '!!gphMeasure.setMeasure(!this.return[1])'
  !packet.form           = !!gphMeasure
  !packet.close          = '!!gphMeasure.tidy()'
  !packet.priority       = 1
  !packet.remove         = FALSE
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      labelXYZ
--
-- Description: Sets labelling to XYZ
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .labelXYZ()

  -- Initialise Variables
  !this.labelType    = 'XYZ'
  !this.labelText[1] = 'X'
  !this.labelText[2] = 'Y'
  !this.labelText[3] = 'Z'

endmethod
-- End of method definition for .labelXYZ()

------------------------------------------------------------------------
--
-- Method:      labelENU
--
-- Description: Sets labelling to offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .labelENU()

  -- Initialise Variables
  !this.labelType    = 'ENU'
  !this.labelText[1] = 'E'
  !this.labelText[2] = 'N'
  !this.labelText[3] = 'U'

endmethod
-- End of method definition for .labelENU()

------------------------------------------------------------------------
--
-- Method:      labelUVW
--
-- Description: Sets labelling to UVW
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .labelUVW()

  -- Initialise Variables
  !this.labelType    = 'UVW'
  !this.labelText[1] = 'U'
  !this.labelText[2] = 'V'
  !this.labelText[3] = 'W'

endmethod
-- End of method definition for .labelUVW()

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Sets with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wrt(!item is DBREF)

  -- Initialise Variables
  !this.wrt   = !item
  !this.from  = !this.from.wrt(!item)
  !this.to    = !this.to.wrt(!item)

endmethod
-- End of method definition for .wrt(DBREF)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Returns XYZ offset values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       XYZ values
--
------------------------------------------------------------------------

define method .offset() is ARRAY

  -- Initialise Variables
  !return = ARRAY()

  -- Distance in XY
  !return[1] = !this.to.east  - !this.from.east
  !return[2] = !this.to.north - !this.from.north
  !return[3] = !this.to.up    - !this.from.up

  return !return

endmethod
-- End of method definition for .offset() ARRAY

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()
  return !return

endmethod
-- End of method definition for .definition() ARRAY
