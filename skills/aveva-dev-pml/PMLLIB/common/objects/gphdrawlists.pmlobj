-- Author:          M.Lewis
-- Created:         Fri Dec 08 13:55:05 WAT 2006
--
-- Description:
-- Object for local drawlist control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  attachView(REAL,GADGET)          -                   Attach a view to a drawlist
--  createDrawlist()                 REAL                Create a new drawlist and add it to the system
--  createDrawlist(BOOLEAN)          REAL                Create a new drawlist and add it to the system
--  createDrawlist(REAL)             -                   Create a new drawlist with explicit token and add it to the system
--  deleteDrawlist(REAL)             -                   Delete a drawlist and remove it from the system
--  detachAllViews(REAL)             -                   Detach a view from a drawlist
--  detachView(GADGET)               -                   Detach a view from any drawlist it is attached to
--  detachView(REAL,GADGET)          -                   Detach a view from a drawlist
--  drawlist(GADGET)                 DRAWLIST            Return drawlist which has given view attached
--  drawlist(REAL)                   DRAWLIST            Return drawlist for given token
--  globalInstance()                 -                   Create global instance of object
--  gphdrawLists()                   -                   Constructor
--  list(REAL)                       -                   List data for a drawlist
--  listAll()                        -                   List data for all drawlist
--  restoreAll()                     -                   Restore definitions of all drawLists
--  save(REAL)                       ARRAY               Save definition of drawlist
--  save(REAL,EXPRESSION)            ARRAY               Save definition of drawlist
--  saveAll()                        -                   Save definitions of all drawLists
--  token(GADGET)                    REAL                Return token for drawlist which has given view attached
--  update()                         -                   Process a drawlist update event
--  views(REAL)                      ARRAY               Return views for given drawlist token
--
------------------------------------------------------------------------

-- Define object
define object GPHDRAWLISTS

  -- List of drawLists
  member .drawLists     is ARRAY
  member .debug         is BOOLEAN

endobject
-- End of object definition for GPHdrawLists

------------------------------------------------------------------------
--
-- Method:      gphdrawLists
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .gphdrawLists()

  -- Initialise trace flag
  !this.debug = FALSE

endmethod
-- End of method definition for .gphdrawLists()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!gphdrawLists = !this

  -- Create the first drawlist and set it to the global drawlist
  !!gphdrawLists.drawLists[1] = object DRAWLIST()
  !!gphdrawLists.drawLists[1] = !!gphdrawLists.drawLists[1].globalDrawlist()

  -- Add the update event handler which is common to all drawLists
  !!gphdrawLists.drawLists[1].addEventHandler(|update|, !!gphdrawLists, |update|)

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Process a drawlist update event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  if (defined(!!pfFabricationPipeEnd)) then
    if (!!pfFabricationPipeEnd.displayPipEnd.val) then
      !!pfFabricationPipeEnd.displayFabPipeEnd()
    endif
  endif

  if (defined(!!componentcreation)) then
    ATTABREAK ON bran
    handle (2,25)
--    Read only DB
    endhandle
  endif

  -- Trace
  if (!!gphdrawLists.debug) then
    !message = |!!gphdrawLists.update()|
    write !message
  endif

  -- Pass the event to the drawlist form
  if (defined(!!gphDrawlist)) then
    !!gphDrawlist.update()
  endif

  if (defined(!!componentcreation)) then
    ATTABREAK SPKBRK bran
    handle (2,25)
--    Read only DB
    endhandle
  endif

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      createDrawlist
--
-- Description: Create a new drawlist and add it to the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Integer token
--
------------------------------------------------------------------------

-- Define method
define method .createDrawlist() is REAL

  -- Create a new drawlist object and return a token to reference it
  !this.drawLists.append(object DRAWLIST())
  return !this.drawLists.maxIndex()

endmethod
-- End of method definition for .createDrawlist() is REAL

------------------------------------------------------------------------
--
-- Method:      createDrawlist
--
-- Description: Create a new drawlist and add it to the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Add on create flag
-- Return:
--   [Data Type] [Description]
--    REAL        Integer token
--
------------------------------------------------------------------------

-- Define method
define method .createDrawlist(!addOnCreate is BOOLEAN) is REAL

  -- Create a new drawlist object and set the add on create flag
  !token = !this.createDrawlist()
  !this.drawLists[!token].addOnCreate(!addOnCreate)
  return !token

endmethod
-- End of method definition for .createDrawlist(BOOLEAN) is REAL

------------------------------------------------------------------------
--
-- Method:      createDrawlist
--
-- Description: Create a new drawlist with explicit token and add it to the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token for drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .createDrawlist(!token is REAL)

  -- Check token is valid
  !index = !token.int()
  if (!index eq 1) then
    return error 1 |Cannot create drawlist with token 1 as this is reserved for global drawlist|
  elseif (!index lt 2) then
    return error 2 |Cannot create drawlist for invalid token $!token|
  endif

  -- Create a new drawlist object at this index
  !this.drawLists[!index] = object DRAWLIST()

endmethod
-- End of method definition for .createDrawlist(REAL)

------------------------------------------------------------------------
--
-- Method:      deleteDrawlist
--
-- Description: Delete a drawlist and remove it from the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token for drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .deleteDrawlist(!token is REAL)

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  elseif (!index eq 1) then
    return error 1 |Cannot delete drawlist with token 1 as this is reserved for global drawlist|
  endif

  -- Delete drawlist from the system (tokens are not reused)
  !this.drawLists[!index].delete()

endmethod
-- End of method definition for .deleteDrawlist(REAL)

------------------------------------------------------------------------
--
-- Method:      attachView
--
-- Description: Attach a view to a drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token for drawlist
--    2   R      GADGET      View to attach to drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .attachView(!token is REAL, !view is GADGET)

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  elseif (!index eq 1) then
    -- Ignore any attempt to attach views to global drawlist
    return
  endif

  -- Check view has been added via global object
  !viewIndex = !!gphviews.viewIndex(!view)
  if (!viewIndex.unset()) then
    !error = |View | & !view.fullname() & | has not been added via object !!gphviews|
    return error 1 |$!error|
  endif

  -- Attach view to drawlist
  -- The core method attachView must be passed a pml global variable
  -- not a gadget even though this is global
  !drawlist = !this.drawLists[!index]
  if (!drawlist.views().find(!view).unset()) then
    !drawlist.attachView(!!gphviews.views[!viewIndex])
  endif



endmethod
-- End of method definition for .attachView(REAL, GADGET)

------------------------------------------------------------------------
--
-- Method:      detachView
--
-- Description: Detach a view from a drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token for drawlist
--    2   R      GADGET      View to detach from drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .detachView(!token is REAL, !view is GADGET)

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  elseif (!index eq 1) then
    return error 1 |Cannot detach view from drawlist 1 as this is reserved for global drawlist|
  endif

  -- Detach view from drawlist
  !foundIndex = !this.drawLists[!index].views().findFirst(!view)
  if (!foundIndex.set()) then
    !this.drawLists[!index].detachView(!view)
  endif

endmethod
-- End of method definition for .detachView(REAL, GADGET)

------------------------------------------------------------------------
--
-- Method:      detachView
--
-- Description: Detach a view from any drawlist it is attached to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View to detach from drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .detachView(!view is GADGET)

  -- Detach view from any drawlist it is attached to
  do !i indices !this.drawLists
    skip if (!i eq 1)
    !foundIndex = !this.drawLists[!i].views().findFirst(!view)
    if (!foundIndex.set()) then
      !this.drawLists[!i].detachView(!view)
      break
    endif
  enddo

endmethod
-- End of method definition for .detachView(GADGET)

------------------------------------------------------------------------
--
-- Method:      detachAllViews
--
-- Description: Detach all view from a drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token for drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .detachAllViews(!token is REAL)

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  elseif (!index eq 1) then
    return error 1 |Cannot detach view from drawlist 1 as this is reserved for global drawlist|
  endif

  -- Detach views from drawlist
  !this.drawLists[!index].detachAllViews()

endmethod
-- End of method definition for .detachAllViews(REAL)

------------------------------------------------------------------------
--
-- Method:      list
--
-- Description: List data for a drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token for drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .list(!token is REAL)

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  endif

  -- List views and members
  !texts = ARRAY()
  if (!index eq 1) then
    !texts.append(|Drawlist | & !index & | (global drawlist)|)
  else
    !texts.append(|Drawlist | & !index)
  endif
  do !view values !this.views(!index)
    !texts.append(|  View | & !view.fullname())
  enddo
  do !member values !this.drawLists[!index].members()
    !texts.append(|  | & !member.fullname)
  enddo
  do !text values !texts
    write |$!text|
  enddo

endmethod
-- End of method definition for .list(REAL)

------------------------------------------------------------------------
--
-- Method:      listAll
--
-- Description: List data for all drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .listAll()

  -- List views and elements
  do !token indices !this.drawLists
    !this.list(!token)
  enddo

endmethod
-- End of method definition for .listAll()

------------------------------------------------------------------------
--
-- Method:      token
--
-- Description: Return token of drawlist for given view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View
-- Return:
--   [Data Type] [Description]
--    REAL        Token for drawlist
--
------------------------------------------------------------------------

-- Define method
define method .token(!view is GADGET) is REAL

  -- Return drawlist if we find one with this view attached
  do !i indices !this.drawLists
    if (!this.drawLists[!i].views().findFirst(!view).set()) then
      return !i
    endif
  enddo

  -- No drawlist has this view attached so return global drawlist
  return 1

endmethod
-- End of method definition for .token(GADGET) is REAL

------------------------------------------------------------------------
--
-- Method:      drawlist
--
-- Description: Return drawlist for given token
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token
-- Return:
--   [Data Type] [Description]
--    DRAWLIST    Drawlist with this token, error if none found
--
------------------------------------------------------------------------

-- Define method
define method .drawlist(!token is REAL) is DRAWLIST

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  endif

  -- Return drawlist with this token
  return !this.drawLists[!index]

endmethod
-- End of method definition for .drawlist(REAL) is DRAWLIST

------------------------------------------------------------------------
--
-- Method:      drawlist
--
-- Description: Return drawlist for given view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View
-- Return:
--   [Data Type] [Description]
--    DRAWLIST    Drawlist
--
------------------------------------------------------------------------

-- Define method
define method .drawlist(!view is GADGET) is DRAWLIST

  -- Return drawlist with this view attached, or global drawlist if no view attached
  return !this.drawLists[!this.token(!view)]

endmethod
-- End of method definition for .drawlist(GADGET) is DRAWLIST

------------------------------------------------------------------------
--
-- Method:      views
--
-- Description: Return views for given drawlist token
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token
-- Return:
--   [Data Type] [Description]
--    ARRAY    Array of view gadgets for drawlist with this token, error if none found
--
------------------------------------------------------------------------

-- Define method
define method .views(!token is REAL) is ARRAY

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  endif

  if (!index eq 1) then

    -- Global drawlist so get all views not attached to a local view
    !views = ARRAY()
    do !view values !!gphviews.views
      if (!this.token(!view) eq 1) then
        !views.append(!view)
      endif
    enddo
    return !views

  else

    -- Return views for local drawlist
    return !this.drawLists[!index].views()

  endif

endmethod
-- End of method definition for .views(REAL) is ARRAY

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save definition of drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token
-- Return:
--   [Data Type] [Description]
--    ARRAY       Definition data
--
------------------------------------------------------------------------

-- Define method
define method .save(!token is REAL) is ARRAY

  return !this.save(!token, object EXPRESSION())

endmethod
-- End of method definition for .save(REAL)

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save definition of drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Token
--    2   R      EXPRESSION  expression which filters elements out of the list if true
-- Return:
--   [Data Type] [Description]
--    ARRAY       Definition data
--
------------------------------------------------------------------------

-- Define method
define method .save(!token is REAL, !removeExpression is EXPRESSION) is ARRAY

  -- Check token is valid
  !index = !token.int()
  if (undefined(!this.drawLists[!index])) then
    return error 1 |No drawlist for token $!index|
  endif

  -- Save definition for this drawlist (index 1 is assigned global drawlist in globalInstance)
  !drawlist = !this.drawLists[!index]
  !data = ARRAY()
  if (!index gt 1) then
    !data.append( |!!gphdrawLists.createDrawlist(| & !index & |)| )
  endif
  !data.append( |!drawlist = !!gphdrawLists.drawlist(| & !index & |)| )

  -- Add on create property (allow for backwards compatibility both here and in the saved macro)
  !addOnCreate = !drawlist.addOnCreate()
  handle (2,779)
    -- Method not available
  elsehandle none
    !data.append( |!drawlist.addOnCreate(| & !addOnCreate & |)| )
    !data.append( |handle any| )
    !data.append( |endhandle|  )
  endhandle

  -- Representation
  !data.append( |!drawlist.arcTol(|           & !drawlist.arcTol()           & |)| )
  !data.append( |!drawlist.centreLine(|       & !drawlist.centreLine()       & |)| )
  !data.append( |!drawlist.holes(|            & !drawlist.holes()            & |)| )
  !data.append( |!drawlist.insulation(|       & !drawlist.insulation()       & |)| )
  !data.append( |!drawlist.insulationTrans(|  & !drawlist.insulationTrans()  & |)| )
  !data.append( |!drawlist.level(|            & !drawlist.level()            & |)| )
  !data.append( |!drawlist.nozzLevel(|        & !drawlist.nozzLevel()        & |)| )
  !data.append( |!drawlist.obstruction(|      & !drawlist.obstruction()      & |)| )
  !data.append( |!drawlist.obstructionTrans(| & !drawlist.obstructionTrans() & |)| )
  !data.append( |!drawlist.pipeLevel(|        & !drawlist.pipeLevel()        & |)| )
  !data.append( |!drawlist.pkey(|             & !drawlist.pkey()             & |)| )
  !data.append( |!drawlist.pline(|            & !drawlist.pline()            & |)| )
  !data.append( |!drawlist.pnode(|            & !drawlist.pnode()            & |)| )
  !data.append( |!drawlist.points(|           & !drawlist.points()           & |)| )
  !data.append( |!drawlist.ppointNumbers(|    & !drawlist.ppointNumbers()    & |)| )
  !data.append( |!drawlist.ppoints(|          & !drawlist.ppoints()          & |)| )
  !data.append( |!drawlist.snode(|            & !drawlist.snode()            & |)| )
  !data.append( |!drawlist.struLevel(|        & !drawlist.struLevel()        & |)| )
  !data.append( |!drawlist.tube(|             & !drawlist.tube()             & |)| )
  !data.append( |!drawlist.update()| )
  !data.append( |repre update| )

  -- Views
  if (!index gt 1) then
    do !view values !this.views(!index)
      !data.append( |!!gphdrawLists.attachView(| & !index & |, | & !view.fullname() & |)|  )
    enddo
  endif

  -- Members and visual properties
  !members = !drawlist.members()
  -- Global variable used to count the number of elements which could not be restored
  -- However this does not need to be in the macro itself because it is always initialised by the method that calls the macro
  --  !data.append( |!!unloaded = 0| )
  do !member values !members
    if( !removeExpression.set() ) then
      !result = !removeExpression.evaluate(!member)
      handle any
        !result = false
      endhandle
      skip if(!result)
      handle any
      endhandle
    endif
    !data.append( |!member  = '| & !member & |'|                                                )
    !data.append( |!element = !member.dbref()|                                                  )
    !data.append( |handle any|                                                                  )
    !data.append( |!!unloaded = !!unloaded + 1|                                                 )
    !data.append( |elsehandle none|                                                             )
    !data.append( |  !drawlist.add(!element)|                                                   )
    !data.append( |  !drawlist.visibility(!element, |   & !drawlist.visibility(!member)   & |)| )
    !data.append( |  !drawlist.edges(!element, |        & !drawlist.edges(!member)        & |)| )
    !data.append( |  !drawlist.colour(!element, |       & !drawlist.colour(!member)       & |)| )
    !data.append( |  !drawlist.translucency(!element, | & !drawlist.translucency(!member) & |)| )
    !data.append( |endhandle|                                                                   )
  enddo

  return !data

endmethod
-- End of method definition for .save(REAL)

------------------------------------------------------------------------
--
-- Method:      saveAll
--
-- Description: Save definitions of all drawLists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .saveAll()

  -- Save each drawlist definition along with macro call to run it back in
  !data = ARRAY()
  do !index indices !this.drawLists
    -- Do not save Integrator drawlist
    if (!index gt 1) then
      !views = !this.drawLists[!index].views()
      skip if (!views[1].owner().formTitle eq |Integrator 3D View|)
      handle any
      endhandle
    endif
    !data.appendArray(!this.save(!index))
  enddo

  -- Output macro to restore all drawLists
  !module   = !!module().appkey
  !project  = current project
  !projCode = !project.code().lowcase()
  var !mdb mdb
  !mdb = !mdb.after('/')
  --account for instances where a user may have used a forward slash in the mdbName (not common)
  --rename any occurrences with '_F-S_'
  !mdb = !mdb.replace('/', '_F-S_')
  !file = object FILE(|%pdmsuser%\| & !module & |-| & !projCode & '-' & !mdb & |-gphdrawLists.pmldat|)
  !file.writeFile(|OVERWRITE|, !data)

endmethod
-- End of method definition for .saveAll()

------------------------------------------------------------------------
--
-- Method:      restoreAll
--
-- Description: Restore definitions of all drawLists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .restoreAll()

  -- Restore all drawLists
  !module   = !!module().appkey
  !project  = current project
  !projCode = !project.code().lowcase()
  var !mdb mdb
  !mdb = !mdb.after('/')
  --account for instances where a user may have used a forward slash in the mdbName (not common)
  --rename any occurrences with '_F-S_'
  !mdb = !mdb.replace('/', '_F-S_')
  !!runMacro(|%pdmsuser%\| & !module & |-| & !projCode & '-' & !mdb & |-gphdrawLists.pmldat|, ||)
  handle any
  endhandle

endmethod
-- End of method definition for .restoreAll()
