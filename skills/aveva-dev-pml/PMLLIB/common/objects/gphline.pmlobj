--
--
-- Description:
-- Graphical Line
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     LINE                Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw line to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw to graphics canvas
--  edit(REAL)                       -                   Edit graphic line
--  gphLine()                        -                   Constructor
--  gphLine(LINE)                    -                   Constructor, using passed line
--  onToPlane(PLANE)                 -                   Lies line onto plane (this is not a projection), the line length is maintained.
--  orientation()                    ORIENTATION         Return orientation of line (line defines Z axes of orientation, the others are derived from the standard ORI defaults)
--  orientation(ORIENTATION)         -                   Sets the "mid" position of the line, maintaining start/end relationship
--  position()                       POSITION            Return "mid" position of line
--  position(POSITION)               -                   Sets the "mid" position of the line, maintaining start/end relationship
--
------------------------------------------------------------------------

-- Define object
define object GPHLINE

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN
  member .detailType   is STRING

  -- Visible
  member .visible      is BOOLEAN

  -- Line Definition
  member .line         is LINE

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

  -- Plant or Marine
  member .marine       is BOOLEAN

endobject
-- End of object definition for GPHLINE

------------------------------------------------------------------------
--
-- Method:      gphLine
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLine()

  -- Initialise Variables
  !this.tag        = false
  !this.detail     = false
  !this.detailType = 'STANDARD'
  !this.visible    = true
  !this.displayStyle()

  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    !this.marine = TRUE
  else
    !this.marine = FALSE
  endif

endmethod
-- End of method definition for .gphLine()

------------------------------------------------------------------------
--
-- Method:      gphLine
--
-- Description: Constructor, using passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLine(!lineDef is LINE)

  -- Initialise Variables
  !this.gphLine()
  !this.line      = !lineDef

endmethod
-- End of method definition for .gphLine(LINE)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is LINE

  return !this.line

endmethod
-- End of method definition for .coreObject() LINE

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 1

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Handle unset lines
  if(!this.line.unset()) then
    return
  endif

  -- Draw Line
  !this.line.draw(!aidNumber, !style, !colour )
  handle ANY
    return
  endhandle

  -- Draw detail of line
  if(!this.detail) then
    !format             = object FORMAT()
    !format.units       = 'MM'
    !format.dp          = 0
    !format.dimension   = 'L'
    !length             = !this.line.length() / 2
    !l                  = !length.string(!format)
    !direction          = !this.line.direction()
    if(!this.detailType.upcase() eq 'START') then
      AID TEXT NUMBER $!<aidNumber> 'START' AT $!<this.line.startPosition>
      AID TEXT NUMBER $!<aidNumber> 'end'   AT $!<this.line.endPosition>
    elseif (!this.detailType.upcase() eq 'END') then
      AID TEXT NUMBER $!<aidNumber> 'start' AT $!<this.line.startPosition>
      AID TEXT NUMBER $!<aidNumber> 'END'   AT $!<this.line.endPosition>
    elseif (!this.detailType.upcase() eq 'BOTH') then
      AID TEXT NUMBER $!<aidNumber> 'START' AT $!<this.line.startPosition>
      AID TEXT NUMBER $!<aidNumber> 'END'   AT $!<this.line.endPosition>
    else
      AID ARROW NUMBER $!<aidNumber> AT $!<this.line.startPosition> DIR $!<direction> HEIGHT $!<l>
      AID TEXT NUMBER $!<aidNumber> 'Start' AT $!<this.line.startPosition>
      AID TEXT NUMBER $!<aidNumber> 'End'   AT $!<this.line.endPosition>
    endif
  endif

  -- Tag Line
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Line [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    !midPoint  = !this.line.proportion(0.5)
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!midPoint
  endif

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Load line edit form is required
  if(undefined(!!gphLineEdit)) then
    pml load form !!gphLineEdit
  endif

  -- Setup line
  !!gphLineEdit.setup(!aidNumber)

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.definePosition('Modify line')
  !packet.key            = 'editLine'
  !packet.description    = 'Edit aid line definition'
  !packet.action         = '!!gphLineEdit.setPosition(!this.return[1].position)'
  !packet.form           = !!gphLineEdit
  !packet.close          = '!!gphLineEdit.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  !return.append('!definition             = object GPHLINE()')
  if(!this.description.set()) then
    !return.append('!definition.description = ''' & !this.description & '''')
  endif
  !return.append('!definition.tag         = '   & !this.tag)
  !return.append('!definition.detail      = '   & !this.detail)
  !return.append('!definition.visible     = '   & !this.visible)
  !return.append('!definition.colour      = '   & !this.colour)
  !return.append('!definition.style       = '   & !this.style)
  if (!this.marine) then
    !xStartPos = !this.line.startPosition.east.string()
    !yStartPos = !this.line.startPosition.north.string()
    !zStartPos = !this.line.startPosition.up.string()
    !xEndPos   = !this.line.endPosition.east.string()
    !yEndPos   = !this.line.endPosition.north.string()
    !zEndPos   = !this.line.endPosition.up.string()
    !lineString = '!definition.line        = object LINE(X' & !xStartPos & ' Y' & !yStartPos & ' Z' & !zStartPos & ' ,X' & !xEndPos & ' Y' & !yEndPos & ' Z' & !zEndPos & ' )'
    !return.append(!lineString)
  else
    !return.append('!definition.line        = object LINE(' & !this.line.startPosition & ' ,' & !this.line.endPosition & ' )')
  endif

  return !return

endmethod
-- End of method definition for .definition() ARRAY

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return "mid" position of line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.line.proportion(0.5)

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Sets the "mid" position of the line, maintaining start/end relationship
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Reference
  !refLine   = object GMFLINE()
  !this.line = !refLine.copyAt(!this.line, !position)

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Return orientation of line (line defines Z axes of orientation, the others are derived from the standard ORI defaults)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION Orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  -- Initialise Variables
  !direction   = !this.line.direction()
  !orientation = object ORIENTATION('Z is ' & !direction)
  return !orientation

endmethod
-- End of method definition for .orientation() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Sets the "mid" position of the line, maintaining start/end relationship
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION Orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  -- Define a plane through the origin of the line with the
  -- orientation, then we'll map the line onto this plane
  !direction      = !orientation.zDir()

  -- Redefine direction
  !this.line = !this.line.direction(!direction)

  -- Re-position so the rotation is about the centre
  !this.line = !this.line.offset(!direction.opposite(), !this.line.length() / 2)

endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      onToPlane
--
-- Description: Lies line onto plane (this is not a projection), the line length is maintained.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane, line is to be laid onto
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .onToPlane(!plane is PLANE)

  -- Direction of the line
  !lineDirection  = !this.line.direction()
  !lineLength     = !this.line.length()
  !midPoint       = !this.line.proportion(0.5)

  -- If line and plane direction are parallel, then we'll use the
  -- Y direction of the plane to lie the line on
  if(!plane.orientation.zDir().isParallel(!lineDirection)) then
    !direction = !plane.orientation.yDir()

  -- Map direction onto the plane using the orientation
  else
    !direction = !lineDirection.projected(!plane)

    -- Don't do anything if the new direction and original are the same
    if(!direction.isParallel(!lineDirection)) then
      return
    endif

  endif

  -- Redefine line
  !this.line.startPosition = !midPoint
  !this.line = !this.line.direction(!direction)
  !this.line = !this.line.setLengthEnd(!lineLength)

  -- Re-position so the rotation is about the centre
  !this.line = !this.line.offset(!direction.opposite(), !this.line.length() / 2)

endmethod
-- End of method definition for .onToPlane(PLANE)
