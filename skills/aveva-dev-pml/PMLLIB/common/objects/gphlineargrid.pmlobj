--
--
-- Description:
-- Graphical Linear Grid
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     LINEARGRID          Returns underlying core object of graphical object
--  definition()                     ARRAY               Return definition of object for writing to file
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw linear grid to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw line to graphics canvas
--  edit(REAL)                       -                   Edit graphic grid
--  gphLinearGrid()                  -                   Constructor
--  gphLinearGrid(LINEARGRID)        -                   Constructor
--  lines(REAL,REAL)                 -                   Define lines
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  plane()                          PLANE               Return plane
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHLINEARGRID

  -- Description
  member .description  is STRING

  -- Tag
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Basic representations (used for speed)
  member .basic        is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Grid Definition
  member .grid         is LINEARGRID

  -- Number of grid lines
  member .x            is REAL
  member .y            is REAL

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

endobject
-- End of object definition for GPHLINEARGRID

------------------------------------------------------------------------
--
-- Method:      gphLinearGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Definition of grid
--    2   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLinearGrid()

  -- Initialise Variables
  !this.tag         = false
  !this.detail      = false
  !this.basic       = false
  !this.visible     = true
  !this.x           = 10
  !this.y           = 10

  -- Default display style for main lines
  !this.displayStyle()

endmethod
-- End of method definition for .gphLinearGrid()

------------------------------------------------------------------------
--
-- Method:      gphLinearGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Definition of grid
--    2   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLinearGrid(!gridDef is LINEARGRID)

  -- Initialise Variables
  !this.gphLinearGrid()
  !this.grid        = !gridDef

endmethod
-- End of method definition for .gphLinearGrid(LINEARGRID)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is LINEARGRID

  return !this.grid

endmethod
-- End of method definition for .coreObject() LINEARGRID

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 2

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Initialise Variables
  !projection         = !this.grid.xSpacing.min(!this.grid.ySpacing).min(500mm)

  -- Maximum/Minimum x/y values
  !xDirection         = !this.grid.orientation.xDir()
  !yDirection         = !this.grid.orientation.yDir()
  !xLength            = !this.x * !this.grid.xSpacing
  !yLength            = !this.y * !this.grid.ySpacing
  !xmax               = !this.grid.position.offset(!xDirection, (!xLength + !projection) / 2)
  !xmin               = !this.grid.position.offset(!xDirection.opposite(), (!xLength + !projection) / 2)
  !ymax               = !this.grid.position.offset(!yDirection, (!yLength + !projection) / 2)
  !ymin               = !this.grid.position.offset(!yDirection.opposite(), (!yLength + !projection) / 2)


  -- Main axes
  !xline = !this.grid.position.offset(!xDirection, !xLength / 2 + !projection).line(!this.grid.position.offset(!xDirection.opposite(), !xLength / 2 + !projection))
  !yline = !this.grid.position.offset(!yDirection, !yLength / 2 + !projection).line(!this.grid.position.offset(!yDirection.opposite(), !yLength / 2 + !projection))
  !xline.draw(!aidNumber, !style, !colour)
  !yline.draw(!aidNumber, !style, !colour)
  AID TEXT NUMBER $!<aidNumber> 'X' AT $!<xline.startPosition>
  AID TEXT NUMBER $!<aidNumber> 'Y' AT $!<yline.startPosition>

--  if(!this.detail) then
  AID TEXT NUMBER $!<aidNumber> '0'  AT $!<this.grid.position>
--  endif

  -- Basic representation of grid
  if(!this.basic) then

    -- Only define box if they have more than 1 spacing
    if(!xLength gt 1 and !yLength gt 1) then
      !xMaximum    = int(!this.x * 0.5)
      !yMaximum    = int(!this.y * 0.5)
      !position[1] = !this.grid.gridPoint(!xMaximum * -1, !yMaximum * -1)
      !position[2] = !this.grid.gridPoint(!xMaximum * -1, !yMaximum)
      !position[3] = !this.grid.gridPoint(!xMaximum,      !yMaximum)
      !position[4] = !this.grid.gridPoint(!xMaximum,      !yMaximum * -1)
      !position[5] = !position[1]
      do !i from 1 to 4
        !line = !position[!i].line(!position[!i + 1])
        !line.draw(!aidNumber, !style, !colour)
      enddo
    endif

  -- Standard representation of grid
  else

    -- Basic Line definitions
    !xline = object LINE(!xmin, !xmax)
    !yline = object LINE(!ymin, !ymax)

    -- Define lines offset in the X direction
    do !i from 1 to int(!this.x / 2)
      !xPositive = !yline.offset(!xDirection, !this.grid.xSpacing * !i)
      !xPositive.draw(!aidNumber, !style, !colour)
      !xNegative = !yline.offset(!xDirection.opposite(), !this.grid.xSpacing * !i)
      !xNegative.draw(!aidNumber, !style, !colour)

      skip if(!this.detail.not())
      !ni    = !i * -1
      !posVe = !xPositive.proportion(0.5)
      !negVe = !xNegative.proportion(0.5)
      AID TEXT NUMBER $!<aidNumber> '$!i'  AT $!<posVe>
      AID TEXT NUMBER $!<aidNumber> '$!ni' AT $!<negVe>
    enddo

    -- Define lines offset in the Y direction
    do !i from 1 to int(!this.y / 2)
      !yPositive = !xline.offset(!yDirection, !this.grid.ySpacing * !i)
      !yPositive.draw(!aidNumber, !style, !colour)
      !yNegative = !xline.offset(!yDirection.opposite(), !this.grid.ySpacing * !i)
      !yNegative.draw(!aidNumber, !style, !colour)
      skip if(!this.detail.not())
      !ni    = !i * -1
      !posVe = !yPositive.proportion(0.5)
      !negVe = !yNegative.proportion(0.5)
      AID TEXT NUMBER $!<aidNumber> '$!i'  AT $!<posVe>
      AID TEXT NUMBER $!<aidNumber> '$!ni' AT $!<negVe>
    enddo

  endif

  -- Tag Grid
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Grid [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.grid.position>
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build for is it hasn't already be built
  if(undefined(!!linearGrids)) then
    pml reload form !!linearGrids
  endif

  -- Setup definePlane
  !!linearGrids.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!linearGrids.position', 'Modify Grid')
  !packet.key            = 'editLinearGrid'
  !packet.form           = !!linearGrids
  !packet.close          = '!!linearGrids.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'
  !packet.description    = 'Edit aid linear grid definition'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      lines
--
-- Description: Define lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Lines in X direction
--    2   R      REAL        Lines in Y direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lines(!xLines is REAL, !yLines is REAL)

  -- Only allow even numbers
  !this.x = INT(!xLines / 2) * 2
  !this.y = INT(!yLines / 2) * 2

endmethod
-- End of method definition for .lines(REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane
--
------------------------------------------------------------------------

define method .plane() is PLANE

  -- Initialise Variables
  !plane = object PLANE(!this.grid.position, !this.grid.orientation)

  return !plane

endmethod
-- End of method definition for .plane() PLANE

------------------------------------------------------------------------
