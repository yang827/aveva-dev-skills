-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.grid.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.grid.position = !position

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Return orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION Orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  return !this.grid.orientation

endmethod
-- End of method definition for .orientation() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION Orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  !this.grid.orientation = !orientation

endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Return definition of object for writing to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

   -- Initialise Variables
  !return      = ARRAY()

  !return.append('!definition                  = object GPHLINEARGRID()')
  if(!this.description.set()) then
    !return.append('!definition.description      = ''' & !this.description & '''')
  endif
  !return.append('!definition.tag              = '   & !this.tag)
  !return.append('!definition.detail           = '   & !this.detail)
  !return.append('!definition.visible          = '   & !this.visible)
  !return.append('!definition.basic            = '   & !this.basic)
  !return.append('!definition.x                = '   & !this.x)
  !return.append('!definition.y                = '   & !this.y)
  !return.append('!definition.grid             = object LINEARGRID()')
  !return.append('!definition.grid.position    = ' & !this.grid.position)
  !return.append('!definition.grid.orientation = ' & !this.grid.orientation)
  !return.append('!definition.grid.xSpacing    = ' & !this.grid.xSpacing)
  !return.append('!definition.grid.ySpacing    = ' & !this.grid.ySpacing)

  return !return

endmethod
-- End of method definition for .definition() ARRAY
