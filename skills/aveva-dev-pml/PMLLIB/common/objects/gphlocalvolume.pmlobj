-- Created:
--
--
-- Description:
-- Graphical representation of a local volume.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     LOCALVOLUME
--  definition()                     ARRAY
--  draw(REAL)                       -                   Draw box for local volume
--  draw(REAL,BOOLEAN)               -                   Draw box
--  edit(REAL)                       -
--  filled(BOOLEAN)                  -
--  gphLocalVolume()                 -
--  gphLocalVolume(LOCALVOLUME)      -
--
------------------------------------------------------------------------

define object GPHLOCALVOLUME

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Volume
  member .volume       is LOCALVOLUME

  -- Solid
  member .fill         is STRING

endobject
-- End of object definition for GPHLOCALVOLUME

------------------------------------------------------------------------
--
-- Method:      gphLocalVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLocalVolume()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.visible   = true
  !this.filled(false)

endmethod
-- End of method definition for .gphLocalVolume()

------------------------------------------------------------------------
--
-- Method:      gphLocalVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VOLUME      Volume definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLocalVolume(!localVolume is LOCALVOLUME)

  -- Initialise Variables
  !this.gphLocalVolume()
  !this.volume = !localVolume

endmethod
-- End of method definition for .gphLocalVolume(LOCALVOLUME)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description:
--   Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LOCALVOLUME
--
------------------------------------------------------------------------

define method .coreObject() is LOCALVOLUME

  return !this.volume

endmethod
-- End of method definition for .coreObject() LOCALVOLUME

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw box for local volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)
  !this.draw(!aidNumber, true)
endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     True to hide old aid numbers
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  -- Remove old aids
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Convert volume into a box
  !box                = !this.volume.box()

  -- Draw item
  AID BOX NUMBER $!<aidNumber> AT $!<box.position> ORIENTATION  $!<box.orientation> XLENGTH $!<box.xLength> YLENGTH $!<box.yLength> ZLENGTH $!<box.zLength> filled $!<this.fill>

  -- Draw detail of Box
  if(!this.detail) then
    AID TEXT NUMBER $!<aidNumber> 'From' AT $!<this.volume.from>
    AID TEXT NUMBER $!<aidNumber> 'To'   AT $!<this.volume.to>
  endif

  -- Tag Box
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'LocalVolume [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<box.position>
  endif


endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description:
--   Sets fill of volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Edit graphic volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- To be done at some later date
  !!alert.error('No default edit method.')
  return error 1 noalert

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description:
--   Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  return !return

endmethod
-- End of method definition for .definition() ARRAY
