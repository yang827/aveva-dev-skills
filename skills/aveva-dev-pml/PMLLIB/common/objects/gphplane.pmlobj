--
-- Description:
-- Graphical Plane
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     PLANE               Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw plane (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw plane to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw line to graphics canvas
--  edit(REAL)                       -                   Edit graphic plane
--  filled()                         BOOLEAN             Return current plane setting
--  filled(BOOLEAN)                  -                   Sets fill start of plane
--  gphPlane()                       -                   Constructor
--  gphPlane(PLANE)                  -                   Constructor, using passed plane
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  plane()                          PLANE               Return plane
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHPLANE

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Plane Definition
  member .plane        is PLANE

  -- Plane Size
  member .x            is REAL
  member .y            is REAL

  -- Filled/Unfilled
  member .fill         is STRING

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

endobject
-- End of object definition for GPHPLANE

------------------------------------------------------------------------
--
-- Method:      gphPlane
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPlane()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.visible   = true
  !this.x         = 5000mm
  !this.y         = 5000mm
  !this.filled(false)

  -- Default display style for main lines
  !this.displayStyle()

endmethod
-- End of method definition for .gphPlane()

------------------------------------------------------------------------
--
-- Method:      gphPlane
--
-- Description: Constructor, using passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Definition of plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPlane(!planeDef is PLANE)

  -- Initialise Variables
  !this.gphPlane()
  !this.plane     = !planeDef

endmethod
-- End of method definition for .gphPlane(PLANE)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is PLANE

  return !this.plane

endmethod
-- End of method definition for .coreObject() PLANE


------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables

  if (defined(!!gphColOpt)) then
    !this.colour = !!gphColOpt.aids.code
  else
    !this.colour = 1
  endif
  !this.style  = 1

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Remove old aids
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  !line = object LINE(!this.plane.position, !this.plane.position.offset(!this.plane.direction(), 1mm))
  !line.draw(!aidNumber, !style, !colour)

  -- Is it filled in
  if(!this.fill eq 'ON') then
    AID BOX NUMBER $!<aidNumber> AT $!<this.plane.position> ORIENTATION $!<this.plane.orientation> XLENGTH $!<this.x> YLENGTH $!<this.y> ZLENGTH 1mm FILLED $!<this.fill>

  else

    !position[1] = !this.plane.threeDPosition(object XYPOSITION(!this.x * -0.5, !this.y * -0.5))
    !position[2] = !this.plane.threeDPosition(object XYPOSITION(!this.x * -0.5, !this.y *  0.5))
    !position[3] = !this.plane.threeDPosition(object XYPOSITION(!this.x *  0.5, !this.y *  0.5))
    !position[4] = !this.plane.threeDPosition(object XYPOSITION(!this.x *  0.5, !this.y * -0.5))
    !position[5] = !position[1]
    do !i from 1 to 4
      !line = !position[!i].line(!position[!i + 1])
      !line.draw(!aidNumber, !style, !colour)
    enddo

  endif

  -- Draw detail of circle/arc
  if(!this.detail) then
    !xDirection = !this.plane.orientation.xDir()
    !yDirection = !this.plane.orientation.yDir()
    !zDirection = !this.plane.orientation.zDir()
    !xLength    = !this.x * 0.25
    !yLength    = !this.y * 0.25
    !xLength    = !xLength.min(4000mm)
    !yLength    = !yLength.min(4000mm)
    !zLength    = !xLength.max(!yLength)
    !xPosition  = !this.plane.position.offset(!xDirection, !xLength)
    !yPosition  = !this.plane.position.offset(!yDirection, !yLength)
    !zPosition  = !this.plane.position.offset(!zDirection, !zLength)
    AID ARROW NUMBER $!<aidNumber> AT $!<this.plane.position> DIR $!<xDirection> HEIGHT $!<xLength>
    AID ARROW NUMBER $!<aidNumber> AT $!<this.plane.position> DIR $!<yDirection> HEIGHT $!<yLength>
    AID ARROW NUMBER $!<aidNumber> AT $!<this.plane.position> DIR $!<zDirection> HEIGHT $!<zLength>
    AID TEXT NUMBER $!<aidNumber> 'X' AT $!<xPosition>
    AID TEXT NUMBER $!<aidNumber> 'Y' AT $!<yPosition>
    AID TEXT NUMBER $!<aidNumber> 'Z' AT $!<zPosition>
  endif

  -- Tag Plane
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Plane [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.plane.position>
  endif

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build for is it hasn't already be built
  if(undefined(!!gphPlaneEdit)) then
    pml reload form !!gphPlaneEdit
  endif

  -- Setup definePlane
  !!gphPlaneEdit.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!gphPlaneEdit.position', 'Modify Plane')
  !packet.key            = 'editPlane'
  !packet.description    = !!gphPlaneEdit.plane.description
  !packet.form           = !!gphPlaneEdit
  !packet.close          = '!!gphPlaneEdit.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description: Return current plane setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True for filled
--
------------------------------------------------------------------------

define method .filled() is BOOLEAN

  -- Fill
  if(!this.fill eq 'ON') then
    return true
  else
    return false
  endif

endmethod
-- End of method definition for .filled() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description: Sets fill start of plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane
--
------------------------------------------------------------------------

define method .plane() is PLANE

  return !this.plane

endmethod
-- End of method definition for .plane() PLANE

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.plane.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.plane.position = !position

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Return orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION Orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  return !this.plane.orientation

endmethod
-- End of method definition for .orientation() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION Orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  !this.plane.orientation = !orientation

endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  !return.append('!definition             = object GPHPLANE()')
  if(!this.description.set()) then
    !return.append('!definition.description = ''' & !this.description & '''')
  endif
  !return.append('!definition.tag         = '   & !this.tag)
  !return.append('!definition.detail      = '   & !this.detail)
  !return.append('!definition.visible     = '   & !this.visible)
  !return.append('!definition.plane       = object PLANE(' & !this.plane.position & ' ,' & !this.plane.orientation & ' )')
  !return.append('!definition.x           = '   & !this.x)
  !return.append('!definition.y           = '   & !this.y)
  !return.append('!definition.fill        = '''   & !this.visible & '''')
  return !return

endmethod
-- End of method definition for .definition() ARRAY
