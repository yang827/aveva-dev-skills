--
-- Description:
-- Graphical Plant Grid
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     PLANTGRID           Returns underlying core object of graphical object
--  definition()                     ARRAY               Return definition of object for writing to file
--  derive(ARRAY)                    PLANTGRID           Derive from passed lines or positions
--  deriveGrid(ARRAY)                PLANTGRID           Derive the grid passed positions
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw plant grid to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw line to graphics canvas
--  edit(REAL)                       -                   Edit graphic grid
--  gphPlantGrid()                   -                   Constructor
--  gphPlantGrid(PLANTGRID)          -                   Constructor, using passed plane
--  labelEnu()                       -                   Sets labelling to ENU
--  labelOffset()                    -                   Sets labelling to offset
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  plane()                          PLANE               Return plane
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHPLANTGRID

  -- Description
  member .description  is STRING

  -- Tag
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Detail label type
  member .labelType    is STRING

  -- Basic representations (used for speed)
  member .basic        is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Grid Definition
  member .grid         is PLANTGRID

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

endobject
-- End of object definition for GPHPLANTGRID

------------------------------------------------------------------------
--
-- Method:      gphPlantGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPlantGrid()

  -- Initialise Variables
  !this.tag         = false
  !this.detail      = false
  !this.labelType   = 'OFFSET'
  !this.basic       = false
  !this.visible     = true

  -- Default display style for main lines
  !this.displayStyle()

endmethod
-- End of method definition for .gphPlantGrid()

------------------------------------------------------------------------
--
-- Method:      gphPlantGrid
--
-- Description: Constructor, using passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Definition of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPlantGrid(!gridDef is PLANTGRID)

  -- Initialise Variables
  !this.gphPlantGrid()
  !this.grid        = !gridDef

endmethod
-- End of method definition for .gphPlantGrid(PLANTGRID)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is PLANTGRID

  return !this.grid

endmethod
-- End of method definition for .coreObject() PLANTGRID

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 2

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Initialise Variables
  !projection         = 1000mm

  -- Define Plane
  !plane              = object PLANE(!this.grid.position, !this.grid.orientation)

  -- Maximum/Minimum x/y values
  !xDirection         = !this.grid.orientation.xDir()
  !yDirection         = !this.grid.orientation.yDir()
  !xLength            = !this.grid.xSize()
  handle any
    !xLength = 0
  endhandle
  !yLength            = !this.grid.ySize()
  handle any
    !yLength = 0
  endhandle
  !xmax               = !this.grid.position.offset(!xDirection, !xLength + !projection / 2)
  !xmin               = !this.grid.position.offset(!xDirection.opposite(), !projection / 2)
  !ymax               = !this.grid.position.offset(!yDirection, !yLength + !projection / 2)
  !ymin               = !this.grid.position.offset(!yDirection.opposite(), !projection / 2)

  !xline              = !this.grid.position.offset(!xDirection, !xLength + !projection).line(!this.grid.position.offset(!xDirection.opposite(), !projection))
  !yline              = !this.grid.position.offset(!yDirection, !yLength + !projection).line(!this.grid.position.offset(!yDirection.opposite(), !projection))

  -- Main axes
  !xline.draw(!aidNumber, !style, !colour)
  !yline.draw(!aidNumber, !style, !colour)
  AID TEXT NUMBER $!<aidNumber> 'X' AT $!<xline.startPosition>
  AID TEXT NUMBER $!<aidNumber> 'Y' AT $!<yline.startPosition>

  if(!this.detail.not() or !this.labelType eq 'OFFSET') then
    AID TEXT NUMBER $!<aidNumber> '0'  AT $!<this.grid.position>

  -- Label
  else

    -- Label with ENU from Grid origin
    if (!this.labelType eq 'ENU') then
      !text = 'Elev ' & !this.grid.position.up.string(!!distanceFmt)
      AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<this.grid.position>

      var !coordinate coordinate
      if (!coordinate.eq('XYZ') ) then
         !eastTag  = 'X '
         !northTag = 'Y '
      else
         !eastTag  = 'E '
         !northTag = 'N '
      endif

    -- Label with A and 0
    elseif (!this.labelType eq 'A1') then
      AID TEXT NUMBER $!<aidNumber> |A|  AT $!<yline.endPosition>
      AID TEXT NUMBER $!<aidNumber> |1|  AT $!<xline.endPosition>
   endif

  endif

  -- Basic representation of grid
  if(!this.basic) then

    -- Only define box if they have more than 1 spacing
    if(!xLength gt 1 and !yLength gt 1) then
      !xMaximum    = !this.grid.xSpacings.size()
      !yMaximum    = !this.grid.ySpacings.size()
      !position[1] = !this.grid.gridPoint(0,         0)
      !position[2] = !this.grid.gridPoint(0,         !yMaximum)
      !position[3] = !this.grid.gridPoint(!xMaximum, !yMaximum)
      !position[4] = !this.grid.gridPoint(!xMaximum, 0)
      !position[5] = !position[1]
      do !i from 1 to 4
        !line = !position[!i].line(!position[!i + 1])
        !line.draw(!aidNumber, !style, !colour)
      enddo
    endif

  -- Standard representation of grid
  else

    -- Basic Line definitions
    !xline = object LINE(!xmin, !xmax)
    !yline = object LINE(!ymin, !ymax)

    -- Remove when core object is in place
    !x     = 0
    !y     = 0

    -- Define lines offset in the X direction
    do !i indices !this.grid.xSpacings
      !x     = !x + !this.grid.xSpacings[!i]

      !yline = !yline.offset(!xDirection, !this.grid.xSpacings[!i])
      !yline.draw(!aidNumber, !style, !colour)

      skip if(!this.detail.not())

      -- Label with Offset from previous
      if(!this.labelType eq 'OFFSET') then
        !text = !this.grid.xSpacings[!i].string(!!distanceFmt)

        -- Offset position
        !newPosition = !plane.threeDPosition(object XYPOSITION(!x - !this.grid.xSpacings[!i] / 2, 0))
        AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<newPosition>

      -- Label with ENU from Grid origin
      elseif (!this.labelType eq 'ENU') then
        !text = !eastTag  & !x.string(!!distanceFmt)
        AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<yline.startPosition>

      -- Label with A,B,C... in X and 1, 2, 3 on Y
      elseif (!this.labelType eq 'A1') then
        !text = substring('BCDEFGHIJKLMNOPQRSTUVWXYZ', !i, 1)
        AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<yline.startPosition>

      endif

    enddo

    -- Define lines offset in the Y direction
    do !i indices !this.grid.ySpacings
      !y     = !y + !this.grid.ySpacings[!i]

      !xline = !xline.offset(!yDirection, !this.grid.ySpacings[!i])
      !xline.draw(!aidNumber, !style, !colour)

      skip if(!this.detail.not())

      -- Label with Offset from previous
      if(!this.labelType eq 'OFFSET') then
        !text = !this.grid.ySpacings[!i].string(!!distanceFmt)

        -- Offset position
        !newPosition = !plane.threeDPosition(object XYPOSITION(0, !y - !this.grid.ySpacings[!i] / 2))
        AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<newPosition>

      -- Label with ENU from Grid origin
      elseif (!this.labelType eq 'ENU') then
        !text = !northTag  & !y.string(!!distanceFmt)
        AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<xline.startPosition>

      -- Label with A,B,C... in X and 1, 2, 3 on Y
      elseif (!this.labelType eq 'A1') then
        !text = STRING(!i + 1)
        AID TEXT NUMBER $!<aidNumber> |$!text|  AT $!<xline.startPosition>

      endif
    enddo

  endif

  -- Tag Grid
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Grid [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> |$!text| AT $!<this.grid.position>
  endif

endmethod
-- End of method definition for

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build for is it hasn't already be built
  if(undefined(!!plantGrids)) then
    pml reload form !!plantGrids
  endif

  -- Setup definePlane
  !!plantGrids.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!plantGrids.position', 'Modify Grid')
  !packet.key            = 'editPlantGrid'
  !packet.description    = 'Edit aid plant grid definition'
  !packet.form           = !!plantGrids
  !packet.close          = '!!plantGrids.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

