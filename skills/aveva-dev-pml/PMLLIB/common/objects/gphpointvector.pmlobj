-- Created:         Fri Feb 6 15:42:21 WAT 1998
--
--
-- Description:
-- Graphical Point Vector
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     POINTVECTOR         Returns underlying core object of graphical object
--  direction()                      DIRECTION           Return direction
--  direction(DIRECTION)             -                   Set direction
--  draw(REAL)                       -                   Draw point vector (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw point vector to graphics canvas
--  gphPointVector()                 -                   Constructor
--  gphPointVector(POINTVECTOR)      -                   Constructor, passing point vector
--  pointVector()                    POINTVECTOR         Return point vector
--  pointVector(POINTVECTOR)         -                   Set Point Vector
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHPOINTVECTOR

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Force direction label to be WRT world
  member .wrtWorld     is BOOLEAN

  -- Plane Definition
  member .pointVector  is POINTVECTOR

  -- Visible
  member .visible      is BOOLEAN

  -- Length of point
  member .length       is REAL

endobject
-- End of object definition for GPHPOINTVECTOR

------------------------------------------------------------------------
--
-- Method:      gphPointVector
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPointVector()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.wrtWorld  = true
  !this.visible   = true
  !this.length    = 500mm

endmethod
-- End of method definition for .gphPointVector()

------------------------------------------------------------------------
--
-- Method:      gphPointVector
--
-- Description: Constructor, passing point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPointVector(!pointVector is POINTVECTOR)

  -- Initialise Variables
  !this.gphPointVector()
  !this.pointVector = !pointVector

endmethod
-- End of method definition for .gphPointVector(POINTVECTOR)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POINTVECTOR Point vector
--
------------------------------------------------------------------------

define method .coreObject() is POINTVECTOR

  return !this.pointVector

endmethod
-- End of method definition for .coreObject() POINTVECTOR

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw point vector (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)
  !this.draw(!aidNumber, true)
endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw point vector to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     True to hide old aid numbers
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  -- Remove old aids
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Initialise Variables

  -- Draw Circle
  AID ARROW NUMBER $!<aidNumber> AT $!<this.pointVector.position> DIRECTION $!<this.pointVector.direction> HEIGHT $!<this.length>

  -- Draw detail of point vector
  if(!this.detail) then
    if( !this.wrtWorld ) then
      !direction = !this.pointVector.direction.wrt(World).string()
    else
      !origin      = !this.pointVector.direction.origin
      if( !origin.isnamed ) then
        !direction = !this.pointVector.direction.string()
      else
        !direction = !this.pointVector.direction.string().replace(!origin.string(), !origin.fullname)
      endif
    endif
    !position  = !this.pointVector.position.offset(!this.pointVector.direction, !this.length)
    AID TEXT NUMBER $!<aidNumber> '$!direction' AT $!<position>
  endif

   -- Tag Point Vector
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Point Vector [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.pointVector.position>
  endif

endmethod
-- End of method definition for .draw(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.pointVector.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.pointVector.position = !position

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Return direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction
--
------------------------------------------------------------------------

define method .direction() is DIRECTION

  return !this.pointVector.direction

endmethod
-- End of method definition for .direction() DIRECTION

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  !this.pointVector.direction = !direction

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      pointVector
--
-- Description: Return point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POINTVECTOR Point Vector
--
------------------------------------------------------------------------

define method .pointVector() is POINTVECTOR

  return !this.pointVector

endmethod
-- End of method definition for .pointVector() POINTVECTOR

------------------------------------------------------------------------
--
-- Method:      pointVector
--
-- Description: Set Point Vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Point Vector
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointVector(!pointVector is POINTVECTOR)

  !this.pointVector = !pointVector

endmethod
-- End of method definition for .pointVector(POINTVECTOR)
