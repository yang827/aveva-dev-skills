-- File:            gphpolygon.pmlobj
--   Type:          Object Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Sep 25 11:29:36 BST 1998
--
--
-- Description:
-- Graphical polygon.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     GMFPOLYGON          Returns underlying "core" object of graphical object
--  draw(REAL)                       -                   Draw circle to graphics canvas
--  draw(REAL,BOOLEAN)               -                   Draw polygon to graphics canvas, true means close the loop
--  drawOpen(REAL)                   -                   Draw polygon to graphics canvas (open loop)
--  gphPolygon()                     -                   Constructor
--  gphPolygon(GMFPOLYGON)           -
--
------------------------------------------------------------------------

define object GPHPOLYGON

 -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Polygon
  member .polygon      is GMFPOLYGON

  -- Sphere size
  member .sphereSize   is REAL

  -- Sphere translucency
  member .sphereTranslucency  is REAL

endobject
-- End of object definition for GPHPOLYGON

------------------------------------------------------------------------
--
-- Method:      gphpolygon
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPolygon()

  -- Define defaults
  !this.tag       = false
  !this.detail    = true
  !this.visible   = true
  !this.sphereSize = 100mm
  !this.sphereTranslucency = 0

endmethod
-- End of method definition for .gphPolygon()

------------------------------------------------------------------------
--
-- Method:      gphpolygon
--
-- Description: Constructor with passed polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFPOLYGON  Polygon definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPolygon(!polygon is GMFPOLYGON)

  -- Define polygon
  !this.gphPolygon()
  !this.polygon = !polygon
  !this.sphereSize = 100mm
  !this.sphereTranslucency = 0


endmethod
-- End of method definition for .gphPolygon(GMFPOLYGON)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying "core" object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is GMFPOLYGON

  return !this.polygon

endmethod
-- End of method definition for .coreObject() GMFPOLYGON

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw polygon to graphics canvas (closing loop)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  -- Remove graphics for circle
  !this.draw(!aidNumber, true)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      drawOpen
--
-- Description: Draw polygon to graphics canvas (open loop)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawOpen(!aidNumber is REAL)

  -- Remove graphics for circle
  !this.draw(!aidNumber, false)

endmethod
-- End of method definition for .drawOpen(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw polygon to graphics canvas, true means close the loop
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     True if loop is closed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !closeLoop is BOOLEAN)
  -- Remove graphics for circle
  AID CLEAR CYLI $!<aidNumber>
  handle any
  endhandle
  AID CLEAR LINE $!<aidNumber>
  handle any
  endhandle
  AID CLEAR ARROW $!<aidNumber>
  handle any
  endhandle
  AID CLEAR SPHERE $!<aidNumber>
  handle any
  endhandle
  AID CLEAR TEXT $!<aidNumber>
  handle any
  endhandle

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif
  -- Initialise Variables
  !from = !this.polygon.plane.threeDPosition(!this.polygon.positions[1])
  if(!this.polygon.positions.size() eq 1) then
    AID TRANSL $!<this.sphereTranslucency>	
    AID SPHERE NUMBER $!<aidNumber> $!<from> DIAM $!<this.sphereSize>
    AID TRANSL 0
  else

    do !i from 2 to !this.polygon.positions.size()
      !to   = !this.polygon.plane.threeDPosition(!this.polygon.positions[!i])
      AID LINE NUMBER $!<aidNumber> $!<from> TO $!<to>

      -- Tag edge
      if(!this.tag) then
        !midPoint = !from.midPoint(!to)
        !j        = !i - 1
        AID TEXT NUMBER $!<aidNumber> '[$!j]' AT $!<midPoint>
      endif

      !from = !to

    enddo

    if(!closeLoop) then
      !to = !this.polygon.plane.threeDPosition(!this.polygon.positions[1])
      AID LINE NUMBER $!<aidNumber> $!<from> TO $!<to>

      -- Tag edge
      if(!this.tag) then
        !midPoint = !from.midPoint(!to)
        !j        = !this.polygon.positions.size()
        AID TEXT NUMBER $!<aidNumber> '[$!j]' AT $!<midPoint>
      endif
    endif

  endif
endmethod
-- End of method definition for .draw(REAL, BOOLEAN)
