--
-- Description:
-- Graphic sphere
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     POSITION            Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  diameter()                       -                   Return diameter
--  diameter(REAL)                   -                   Sets diameter
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw position to graphics canvas
--  draw(REAL,BOOLEAN)               -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw to graphics canvas
--  edit(REAL)                       -                   Edit graphic position
--  filled(BOOLEAN)                  -                   Sets fill sphere
--  gphPosition()                    -                   Constructor
--  gphPosition(POSITION)            -                   Constructor
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHPOSITION

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Position
  member .position    is POSITION

  -- Diameter
  member .diameter    is REAL

  -- Filled/Unfilled
  member .fill        is STRING

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

endobject
-- End of object definition for GPHPOSITION

------------------------------------------------------------------------
--
-- Method:      gphPosition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPosition()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.visible   = true
  !this.diameter  = 200mm
  !this.filled(false)
  !this.displayStyle()

endmethod
-- End of method definition for .gphPosition()

------------------------------------------------------------------------
--
-- Method:      gphPosition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPosition(!posDef is POSITION)

  -- Clear Current
  !this.gphPosition()
  !this.position    = !posDef

endmethod
-- End of method definition for .gphPosition(POSITION)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description:Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is POSITION

  return !this.position

endmethod
-- End of method definition for .coreObject() POSITION


------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 1

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Draw Circle
  AID SPHERE NUMBER $!<aidNumber> $!this.position DIAMETER $!this.diameter

  -- Draw detail of position
  if(!this.detail and !this.tag.not()) then
    AID TEXT NUMBER $!<aidNumber> |$!this.position| AT $!this.position
  endif

  -- Tag Line
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Position [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    if(!this.detail) then
      !text = !text & ' (' & !this.position & ')'
    endif
    AID TEXT NUMBER $!<aidNumber> |$!text| AT $!this.position
  endif

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build for is it hasn't already be built
  if(undefined(!!gphPositionEdit)) then
    pml reload form !!gphPositionEdit
  endif

  -- Setup define position
  !!gphPositionEdit.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!gphPositionEdit.position', 'Modify Position')
  !packet.key            = 'editPosition'
  !packet.description    = 'Edit aid position definition'
  !packet.form           = !!gphPositionEdit
  !packet.close          = '!!gphPositionEdit.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description: Sets fill sphere
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      diameter
--
-- Description: Return diameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Diameter of sphere
--
------------------------------------------------------------------------

define method .diameter()

  return !this.diameter

endmethod
-- End of method definition for .diameter()

------------------------------------------------------------------------
--
-- Method:      diameter
--
-- Description: Sets diameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Diameter of sphere
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .diameter(!diameter is REAL)

  -- Set size
  !this.diameter = !diameter

endmethod
-- End of method definition for .diameter(REAL)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  !return.append('!definition             = object GPHPOSITION()')
  if(!this.description.set()) then
    !return.append('!definition.description = ''' & !this.description & '''')
  endif
  !return.append('!definition.tag         = '    & !this.tag)
  !return.append('!definition.detail      = '    & !this.detail)
  !return.append('!definition.visible     = '    & !this.visible)
  !return.append('!definition.fill        = '''  & !this.fill & '''')
  !return.append('!definition.diameter    = '    & !this.diameter)
  if (!this.position.set()) then
    !return.append('!definition.position    = '    & !this.position)
  endif

  return !return

endmethod
-- End of method definition for .definition() ARRAY

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.position = !position

endmethod
-- End of method definition for .position(POSITION)
