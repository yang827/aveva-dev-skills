--
-- Description:
-- Graphical Grid Definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     RADIALGRID          Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw radial grid to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw line to graphics canvas
--  edit(REAL)                       -                   Edit graphic grid
--  gphRadialGrid()                  -                   Constructor
--  gphRadialGrid(RADIALGRID)        -                   Constructor
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  plane()                          PLANE               Return plane
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHRADIALGRID

  -- Description
  member .description  is STRING

  -- Tag
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Basic representations (used for speed)
  member .basic        is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Grid Definition
  member .grid         is RADIALGRID

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

endobject
-- End of object definition for GPHRADIALGRID

------------------------------------------------------------------------
--
-- Method:      gphradialgrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphRadialGrid()

  -- Initialise Variables
  !this.tag         = false
  !this.detail      = false
  !this.basic       = false
  !this.visible     = true

  -- Default display style for main lines
  !this.displayStyle()

endmethod
-- End of method definition for .gphRadialGrid()

------------------------------------------------------------------------
--
-- Method:      gphradialgrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Definition of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphRadialGrid(!gridDef is RADIALGRID)

  -- Initialise Variables
  !this.gphRadialGrid()
  !this.grid        = !gridDef

endmethod
-- End of method definition for .gphRadialGrid(RADIALGRID)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description:  Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is RADIALGRID

  return !this.grid

endmethod
-- End of method definition for .coreObject() RADIALGRID

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 2

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if(!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Initialise Variables
  -- Determine the maximum diameter
  if(!this.grid.radii.empty()) then
    !minRadius = 0mm
    !maxRadius = 5000mm
  else
    !minRadius = !this.grid.radii.first()
    !maxRadius = !this.grid.radii.last()
  endif

  -- if the minimum radius equals zero increase it by 1/1000th of a unit.
  if (!minRadius eq 0) then
    !minRadius = 0.001
  endif

  -- Derive a "sensible" projection
  !projection  = !minRadius.min(1000mm)

  -- Projected Line
  !lineProjected = !maxRadius + !projection
  !lineProject   = !maxRadius + !projection / 2

  -- Maximum/Minimum values
  !zDirection  = !this.grid.orientation.zDir()

  -- Draw grid axes
  !height = !minRadius
  !height = !height.min(500mm)
  !height = !height.max(300mm)
  AID ARROW NUMBER $!<aidNumber> AT $!<this.grid.position> DIRECTION $!<zDirection> HEIGHT $!<height>

  -- Working Plane
  !plane = object PLANE(!this.grid.position, !this.grid.orientation)
  !xmax  = !plane.threeDPosition(object XYPOSITION(!lineProjected, 0))
  !ymax  = !plane.threeDPosition(object XYPOSITION(0, !lineProjected))

  -- Basic representation of grid
  if(!this.basic) then

    !xline  = !xmax.line(!plane.threeDPosition(object XYPOSITION(!lineProjected * -1, 0)))
    !yline  = !ymax.line(!plane.threeDPosition(object XYPOSITION(0, !lineProjected * -1)))

    -- Draw "maximum diameter
    !arc      = object ARC(!this.grid.position, !this.grid.orientation, 0, 360, !maxRadius, true)
    !arc.draw(!aidNumber, !style, !colour)

  -- Standard representation of grid
  else

    -- Draw the radii (if there are any)
    do !i indices !this.grid.radii
      -- if the radius is zero it won't draw so it will be drawn very small (1/1000th of a unit)
      if (!this.grid.radii[!i] eq 0) then
        !this.grid.radii[!i] = 0.001
      endif
      !arc      = object ARC(!this.grid.position, !this.grid.orientation, 0, 360, !this.grid.radii[!i], true)
      !arc.draw(!aidNumber, !style, !colour)

      -- Detail
      if(!this.detail) then
        !xPosition = !plane.threeDPosition(object XYPOSITION(!this.grid.radii[!i], 0))
        !radius    = !this.grid.radii[!i]
        !r         = !radius.string(!!distanceFmt)
        AID TEXT NUMBER $!<aidNumber> |$!r| AT $!<xPosition>
      endif

    enddo

    -- Radial Line

    -- Draw angle lines
    do !i indices !this.grid.angles
      !line = !plane.threeDPosition(object XYPOSITION(cos(!this.grid.angles[!i]) * !minRadius, sin(!this.grid.angles[!i]) * !minRadius)).line(!plane.threeDPosition(object XYPOSITION(cos(!this.grid.angles[!i]) * !lineProject, sin(!this.grid.angles[!i]) * !lineProject)))
      !line.draw(!aidNumber, !style, !colour)

      -- Detail
      if(!this.detail) then
        AID TEXT NUMBER $!<aidNumber> '$!this.grid.angles[$!i]' AT $!<line.endPosition>
      endif
    enddo

    -- Draw XY axes
    !xline  = !xmax.line(!plane.threeDPosition(object XYPOSITION(!maxRadius, 0)))
    !yline  = !ymax.line(!plane.threeDPosition(object XYPOSITION(0, !maxRadius)))

  endif

  -- Draw axes line
  !xline.draw(!aidNumber, 4, !colour)
  !yline.draw(!aidNumber, 4, !colour)

  -- Tag axes
  AID TEXT NUMBER $!<aidNumber> 'X' AT $!<xmax>
  AID TEXT NUMBER $!<aidNumber> 'Y' AT $!<ymax>

  -- Tag Grid
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Grid [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.grid.position>
  endif

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build for is it hasn't already be built
  if(undefined(!!radialGrids)) then
    pml reload form !!radialGrids
  endif

  -- Setup definePlane
  !!radialGrids.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!radialGrids.position', 'Modify Grid')
  !packet.key            = 'editRadialGrid'
  !packet.description    = 'Edit aid radial grid definition'
  !packet.form           = !!radialGrids
  !packet.close          = '!!radialGrids.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane
--
------------------------------------------------------------------------

define method .plane() is PLANE

  -- Initialise Variables
  !plane = object PLANE(!this.grid.position, !this.grid.orientation)

  return !plane

endmethod
-- End of method definition for .plane() PLANE

------------------------------------------------------------------------
