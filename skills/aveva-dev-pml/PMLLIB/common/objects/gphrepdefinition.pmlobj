--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Apr 6 14:08:58 BST 1999
--
--
-- Description:
-- Representation definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyTo(DBREF)                   BOOLEAN             Apply the definition to the passed element
--  gphRepDefinition(DBREF)          -                   Constructor, uses passed element
--  gphRepDefinition(STRING)         -                   Constructor, uses string as defined in the definition file
--
------------------------------------------------------------------------

define object GPHREPDEFINITION

  -- Description
  member .description is STRING

  -- Key
  member .key         is STRING

  -- Drawing levels
  member .level       is ARRAY

  -- Obstruction
  member .obstruction is REAL

  -- Centre Line Flag
  member .clFlag      is BOOLEAN

  -- Tube Flag
  member .tuFlag      is BOOLEAN

endobject
-- End of object definition for GPHREPDEFINITION

------------------------------------------------------------------------
--
-- Method:      gphRepDefinition
--
-- Description: Constructor, uses string as defined in the definition file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Basic string definition of the representation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphRepDefinition(!data is STRING)

  -- Initialise Variables

  -- Split into component parts
  !definition = !data.split('\')

  -- If there are not 7 entries, return
  if(!definition.size() ne 7) then
    return
  endif

  !this.description = !definition[7]
  !this.key         = !definition[1].upcase()
  !this.level[1]    = !definition[2].real()
  !this.level[2]    = !definition[3].real()
  !this.obstruction = !definition[4].real()
  !this.clFlag      = !definition[5].boolean()
  !this.tuFlag      = !definition[6].boolean()

endmethod
-- End of method definition for .gphRepDefinition(STRING)

------------------------------------------------------------------------
--
-- Method:      gphRepDefinition
--
-- Description: Constructor, uses passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to get representation data from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphRepDefinition(!element is DBREF)

  -- Initialise Variables
  !this.description = STRING()
  !this.key         = STRING()

  -- Get elements attributes
  !attribs          = !element.attributes()
  !block            = object BLOCK('!attribs[!evalIndex].upcase()')
  !attributes       = !attribs.evaluate(!block)

  -- Check if element has the attribute
  if(!attributes.findFirst('OBSTRUCTION').set()) then
    !this.obstruction = !element.obstruction
  endif

  if(!attributes.findFirst('LEVEL').set()) then
    !this.level       = !element.level
  endif

  if(!attributes.findFirst('CLFLAG').set()) then
    !this.clFlag       = !element.clFlag
  endif

  if(!attributes.findFirst('TUFLAG').set()) then
    !this.tuFlag       = !element.tuFlag
  endif

endmethod
-- End of method definition for .gphRepDefinition(DBREF)

------------------------------------------------------------------------
--
-- Method:      applyTo
--
-- Description: Apply the definition to the passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element definition is to be applied to
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if element has been updated
--
------------------------------------------------------------------------

define method .applyTo(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !return     = false

  -- Check we have access to change the element
  if(!!dbRefUpdate(!element).not()) then
    return false
  endif

  -- Set obstruction
  if(!this.obstruction.set()) then

    -- Handle element without attribute
    OBST $!<this.obstruction>
    handle any
    elsehandle none
      !return = true
    endhandle

  endif

  -- Set level
  if(!this.level.set()) then

    -- Handle element without attribute
    LEVEL $!<this.level[1]> $!<this.level[2]>
    handle any
    elsehandle none
      !return = true
    endhandle

  endif

  -- Set Centre Line
  if(!this.clFlag.set()) then

    -- Handle element without attribute
    CLFLAG $!<this.clFlag>
    handle any
    elsehandle none
      !return = true
    endhandle

  endif

  -- Set Tube
  if(!this.tuFlag.set()) then

    -- Handle element without attribute
    TUFLAG $!<this.tuFlag>
    handle any
    elsehandle none
      !return = true
    endhandle

  endif

  -- Set error text if the return is false
  if(!return.not()) then
    !!error.text = 'Element (' & !element.flnn & ') has no representation attributes.'
  endif

  return !return
endmethod
-- End of method definition for .applyTo(DBREF) BOOLEAN
