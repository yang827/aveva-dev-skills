--
--
-- Description:
-- Link object for representation gadgets.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  callback(GADGET,STRING)          -                   Callback action for change
--  centreLine(GADGET)               -                   Toggle gadgets centre line is to be linked to
--  level(GADGET,GADGET)             -                   Input gadgets levels are to be linked to
--  obstruction(GADGET)              -                   List gadget to obstructions are to be linked to
--  predefined(GADGET)               -                   List gadget to predefined entries are to be linked to
--  representation()                 GPHREPDEFINITION    Returns current representation
--  setCallback(GADGET,STRING)       -                   Set callback for passed gadget
--  setup()                          -                   Setup gadgets with current predefined setting
--  setup(DBREF)                     -                   Setup form with passed element data
--  setup(GPHREPDEFINITION)          -                   Setup gadgets with passed representation definition
--  setup(STRING)                    -                   Setup gadgets with passed representation KEY
--  tube(GADGET)                     -                   Toggle gadgets tube is to be linked to
--  update()                         -                   Update gadgets with definition
--
------------------------------------------------------------------------

define object GPHREPLINK

  -- Obstruction gadget
  member .obstruction    is GADGET

  -- Level "from" gadget
  member .from           is GADGET

  -- Level "to" gadget
  member .to             is GADGET

  -- Predefined definitions gadget
  member .predefined     is GADGET

  -- Centre line gadget
  member .centreLine     is GADGET

  -- Tube gadget
  member .tube           is GADGET

  -- Representation Definition
  member .representation is GPHREPDEFINITION

  -- Private Members
  -- Callback applied to gadget (once derived for a link object can be applied to all other gadgets)
  member .callback       is STRING

endobject
-- End of object definition for GPHREPLINK

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup gadgets with current predefined setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Can only setup if the predefined gadget has been set
  if(!this.predefined.set()) then
    !this.callback(!this.predefined, 'PREDEFINED')
  endif

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup gadgets with passed representation KEY
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Representation key
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!key is STRING)

   -- Get representation from element
  !this.representation = !!gphRepLst.key(!key)

  -- Update gadgets
  !this.update()

endmethod
-- End of method definition for .setup(STRING)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup gadgets with passed representation definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GPHREPDEFINITION Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!representation is GPHREPDEFINITION)

  -- Initialise Variables
  !this.representation = !representation

  -- Update gadgets
  !this.update()

endmethod
-- End of method definition for .setup(GPHREPDEFINITION)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed element data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       DBREF      Element to setup with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!element is DBREF)

  -- Get representation from element
  !this.representation = object GPHREPDEFINITION(!element)

  -- Get "key"
  !key                 = !!gphRepLst.search(!this.representation)

  if(!key.empty().not()) then
    !this.representation = !!gphRepLst.key(!key)
  endif

  -- Update gadgets
  !this.update()

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update gadgets with definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Predefined Representations
  if(!this.predefined.set()) then

    -- Handle unset key
    if(!this.representation.key.unset()) then
      !this.representation.key = ''
    endif

    !this.predefined.select('RTEXT',!this.representation.key)
  endif

  -- Obstruction
  if(!this.obstruction.set()) then
    !this.obstruction.select('RTEXT', !this.representation.obstruction.string())
  endif

  -- Level "From" & "To"
  if(!this.from.set() and !this.to.set()) then
    !this.from.val       = !this.representation.level[1]
    !this.to.val         = !this.representation.level[2]
  endif

  -- Centre Line
  if(!this.centreLine.set()) then
    !this.centreLine.val = !this.representation.clFlag
  endif

  -- Tube
  if(!this.tube.set()) then
    !this.tube.val       = !this.representation.tuFlag
  endif


endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Returns current representation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    GPHREPDEFINITION Representation definition
--
------------------------------------------------------------------------

define method .representation() is GPHREPDEFINITION
  return !this.representation
endmethod
-- End of method definition for .representation() GPHREPDEFINITION

------------------------------------------------------------------------
--
-- Method:      obstruction
--
-- Description: List gadget to obstructions are to be linked to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .obstruction(!gadget is GADGET)

  -- Initialise Variables
  !this.obstruction      = !gadget

  !dtext                 = ARRAY()
  !rtext                 = ARRAY()

  -- Obstruction Settings
  !dtext.append('Hard')
  !rtext.append('2')
  !dtext.append('Soft')
  !rtext.append('1')
  !dtext.append('None')
  !rtext.append('0')
  !this.obstruction.dtext = !dtext
  !this.obstruction.rtext = !rtext

  -- Set callback
  !this.setCallback(!gadget, 'OBSTRUCTION')

endmethod
-- End of method definition for .obstruction(GADGET)

------------------------------------------------------------------------
--
-- Method:      predefined
--
-- Description: List gadget to predefined entries are to be linked to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .predefined(!gadget is GADGET)

  -- Initialise Variables
  !this.predefined = !gadget

  -- Load Predefined representations into gadget
  if(undefined(!!gphRepLst)) then
    call !!comDefineGlobal(object GPHREPLST())
  endif

  -- Get Available list of descriptions and keys
  !descriptions = !!gphRepLst.descriptions()
  !keys         = !!gphRepLst.keys()
  !descriptions.append('Unknown')
  !keys.append('')

  -- Update list
  !this.predefined.dtext = !descriptions
  !this.predefined.rtext = !keys

  -- Set callback
  !this.setCallback(!gadget, 'PREDEFINED')

endmethod
-- End of method definition for .predefined(GADGET)

------------------------------------------------------------------------
--
-- Method:      level
--
-- Description: Input gadgets levels are to be linked to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      From input gadget
--    2   R      GADGET      To input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .level(!from is GADGET, !to is GADGET)

  -- Initialise Variables
  !this.from = !from
  !this.to   = !to

  -- Set callback
  !this.setCallback(!from, 'FROM')
  !this.setCallback(!to,   'TO')

endmethod
-- End of method definition for .level(GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      centreLine
--
-- Description: Toggle gadgets centre line is to be linked to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Toggle gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .centreLine(!gadget is GADGET)

  -- Initialise Variables
  !this.centreLine = !gadget

  -- Set callback
  !this.setCallback(!gadget, 'CENTRELINE')

endmethod
-- End of method definition for .centreLine(GADGET)

------------------------------------------------------------------------
--
-- Method:      tube
--
-- Description: Toggle gadgets tube is to be linked to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Toggle gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tube(!gadget is GADGET)

  -- Initialise Variables
  !this.tube = !gadget

  -- Set callback
  !this.setCallback(!gadget, 'TUBE')

endmethod
-- End of method definition for .tube(GADGET)

------------------------------------------------------------------------
--
-- Method:      setCallback
--
-- Description: Set callback for passed gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Toggle gadget
--    2   R      STRING      Gadget type (FROM, TO, OBSTRUCTION, CENTRELINE, TUBE or PREDEFINED)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCallback(!gadget is GADGET, !type is STRING)

  -- Initialise Variables

  -- If callback is already set, then use the it
  if(!this.callback.set()) then
    !gadget.callback = !this.callback & !gadget.name() & ',|' & !type & '|)'
    return
  endif

  -- Derive the LINK object
  !form        = !gadget.owner()
  !formMembers = !form.attributes()

  do !i indices !formMembers
    skip if(!form.attribute(!formMembers[!i]).objectType() ne 'GPHREPLINK')

    -- Set callback
    !this.callback = '!this.' & !formMembers[!i] & '.callback(!this.'
    break
  enddo

  -- Set callback
  !gadget.callback = !this.callback & !gadget.name() & ',|' & !type & '|)'

endmethod
-- End of method definition for .setCallback(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      callback
--
-- Description: Callback action for change
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Toggle gadget
--    2   R      STRING      Gadget Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .callback(!gadget is GADGET, !type is STRING)

  -- Initialise Variables

  -- Change in predefined setting
  if(!type eq 'PREDEFINED') then

    -- Get definition from list
    !representation  = !!gphRepLst.key(!gadget.selection())

    -- If representation is unset, then don't do anything
    if(!representation.unset()) then
      return
    endif

    -- Set up form
    !this.representation = !representation

    -- Obstruction
    if(!this.obstruction.set()) then
      !this.obstruction.select('RTEXT', !this.representation.obstruction.string())
    endif

    -- Level "From" & "To"
    if(!this.from.set() and !this.to.set()) then
      !this.from.val       = !this.representation.level[1]
      !this.to.val         = !this.representation.level[2]
    endif

    -- Centre Line
    if(!this.centreLine.set()) then
      !this.centreLine.val = !this.representation.clFlag
    endif

    -- Tube
    if(!this.tube.set()) then
      !this.tube.val       = !this.representation.tuFlag
    endif

  -- Look for predefined conforming to current settings
  else

    -- If there is no predefined definition gadget, there is no need to do anything
    if(!this.predefined.unset()) then
      return
    endif

    -- Preprocess level data if set
    if(!type inset('FROM','TO')) then

      -- Level
      !level      = !gadget.val.int()

      -- If level < than zero, make it zero
      if(!level lt 0) then
        !level = 0
      endif
      !gadget.val = !level

      -- If from  >  to, then swap
      if(!this.from.val gt !this.to.val) then
        !level         = !this.from.val
        !this.from.val = !this.to.val
        !this.to.val   = !level
      endif

    endif

    -- Look for definition "like" current settings
    !this.representation = object GPHREPDEFINITION()

    -- Obstruction
    if(!this.obstruction.set()) then
      !this.representation.obstruction = !this.obstruction.selection().real()
    endif

    -- Level "From"
    if(!this.from.set() and !this.to.set()) then
      !this.representation.level[1]    = !this.from.val
      !this.representation.level[2]    = !this.to.val
    endif

    -- Centre Line
    if(!this.centreLine.set()) then
      !this.representation.clFlag      = !this.centreLine.val
    endif

    -- Tube
    if(!this.tube.set()) then
      !this.representation.tuFlag      = !this.tube.val
    endif

    -- Get key
    !key = !!gphRepLst.search(!this.representation)

    -- If key us set, then get predefined definition
    if(!key.empty().not()) then
      !this.representation  = !!gphRepLst.key(!key)
    endif

    -- Set predefined gadget
    !this.predefined.select('RTEXT',!key)

  endif

endmethod
-- End of method definition for .callback(GADGET, STRING)
