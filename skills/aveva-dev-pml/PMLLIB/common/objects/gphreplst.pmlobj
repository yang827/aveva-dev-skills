--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Apr 6 14:14:34 BST 1999
--
--
-- Description:
-- List of predefined representation definitions.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  descriptions()                   ARRAY               Return list of descriptions
--  globalInstance()                 -                   Define global instance of object
--  gphRepLst()                      -                   Constructor
--  key(STRING)                      GPHREPDEFINITION    Return representation definition for passed key
--  keys()                           ARRAY               Return list of keys
--  load()                           -                   Load object with all DES-DREP files
--  loadFile(FILE)                   -                   Load file into list
--  replace(STRING,GPHREPDEFINITION) BOOLEAN             Replace definition with new definition, else adds it, if not found
--  search(GPHREPDEFINITION)         STRING              Search for definition with passed <set> values, (excluding key and description)
--  update()                         -                   Update list to latest version if required
--
------------------------------------------------------------------------

define object GPHREPLST

  -- List of representation definitions
  member .list         is ARRAY

  -- Indexes of data for fast searching
  -- Description is an uppercase version of the definition in the list array
  -- this makes it easier to search for the same strings
  member .description  is ARRAY
  member .key          is ARRAY
  member .obstruction  is ARRAY
  member .level        is ARRAY
  member .clFlag       is ARRAY
  member .tuFlag       is ARRAY

  -- Object Data
  member .date         is DATETIME

endobject
-- End of object definition for GPHREPLST

------------------------------------------------------------------------
--
-- Method:      gphRepLst
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphRepLst()

  -- Initialise Variables

  -- Remember when the object was initially defined
  !this.date = object DATETIME()

endmethod
-- End of method definition for .gphRepLst()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Define global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  -- Initialise Variables

  -- Assign this to the global variable
  !!gphRepLst = !this

  -- Load object with predefined data
  !!gphRepLst.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update list to latest version if required
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Initialise Variables
  !date  = !this.date

  -- Get all Design representation file paths
  !paths = !!searchPaths('DES-DREP')

  -- Loop through the available paths and load their data into the list
  do !i indices !paths

    -- If file has been modified after the last load, then reload the file
    if(!date.lt(!paths[!i].file.dtm())) then
      !this.loadFile(!paths[!i].file)

      -- Update the date time stamp
      !this.date = object DATETIME()
    endif
  enddo

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load object with all DES-DREP files
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

  -- Initialise Variables

  -- Get all Design representation file paths
  !paths = !!searchPaths('DES-DREP')

  -- Loop through the available paths and load their data into the list
  do !i indices !paths

    -- Load File in list
    !this.loadFile(!paths[!i].file)

  enddo

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      loadFile
--
-- Description: Load file into list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File to be read
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadFile(!file is FILE)

  -- Initialise Variables

  -- Get Record
  !records = !file.readFile()

  -- Loop through each entry and load into the list
  do !i indices !records

    -- Get definition of record
    !definition = object GPHREPDEFINITION(!records[!i])

    -- Replace definition
    !this.replace(!definition.key, !definition)

  enddo

endmethod
-- End of method definition for .loadFile(FILE)

------------------------------------------------------------------------
--
-- Method:      descriptions
--
-- Description: Return list of descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of descriptions
--
------------------------------------------------------------------------

define method .descriptions() is ARRAY

  -- Initialise Variables
  !descriptions = ARRAY()

  do !i indices !this.list
    !descriptions.append(!this.list[!i].description)
  enddo

  -- Return
  return !descriptions

endmethod
-- End of method definition for .descriptions() ARRAY

------------------------------------------------------------------------
--
-- Method:      keys
--
-- Description: Return list of keys
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of keys
--
------------------------------------------------------------------------

define method .keys() is ARRAY
  return !this.key
endmethod
-- End of method definition for .keys() ARRAY

------------------------------------------------------------------------
--
-- Method:      key
--
-- Description: Return representation definition for passed key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key to search on
-- Return:
--   [Data Type] [Description]
--    GPHREPDEFINITION Definition
--
------------------------------------------------------------------------

define method .key(!key is STRING) is GPHREPDEFINITION

  -- Initialise Variables
  !index = !this.key.findFirst(!key.upcase())

  -- If the index is unset, then return an unset object
  if(!index.unset()) then
    return object GPHREPDEFINITION()
  else
    return !this.list[!index]
  endif

endmethod
-- End of method definition for .key(STRING) GPHREPDEFINITION

------------------------------------------------------------------------
--
-- Method:      search
--
-- Description: Search for definition with passed <set> values, (excluding key and description)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GPHREPDEFINITION      Key to search on
-- Return:
--   [Data Type] [Description]
--    STRING      Key with definition
--
------------------------------------------------------------------------

define method .search(!search is GPHREPDEFINITION) is STRING

  -- Initialise Variables
  !block          = object BLOCK('!evalIndex')

  -- If there is no definition, return an empty string
  if(!search.unset()) then
    return ''
  endif

  -- Search indexes for arrays
  -- Obstruction List
  if(!search.obstruction.set()) then
    !obstructions = !this.obstruction.find(!search.obstruction)
  else
    !obstructions = !this.obstruction.evaluate(!block)
  endif

  -- Level List
  if(!search.level.set()) then
    !levels       = !this.level.find(!search.level)
  else
    !levels       = !this.level.evaluate(!block)
  endif

  -- Centre Line List
  if(!search.clFlag.set()) then
    !clFlags      = !this.clFlag.find(!search.clFlag)
  else
    !clFlags      = !this.clFlag.evaluate(!block)
  endif

  -- Tube List
  if(!search.tuFlag.set()) then
    !tuFlags     = !this.tuFlag.find(!search.tuFlag)
  else
    !tuFlags      = !this.tuFlag.evaluate(!block)
  endif

  -- Compare the lists
  !index = !obstructions.intersect(!levels).intersect(!clFlags).intersect(!tuFlags)

  -- If index is unset, then return empty string
  if(!index.unset()) then
    return ''
  else
    return !this.key[!index[1]]
  endif

endmethod
-- End of method definition for .search(GPHREPDEFINITION) STRING

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: Replace definition with new definition, else adds it, if not found
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GPHREPDEFINITION Definition to be replace
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if added
--
------------------------------------------------------------------------

define method .replace(!key is STRING, !definition is GPHREPDEFINITION) is BOOLEAN

  -- If definition us unset, don't do anything
  if(!definition.unset()) then
    return false
  endif

  -- Check for duplicate KEY
  !index = !this.key.findFirst(!key)

  -- Get next index
  if(!index.unset()) then
    !index = !this.list.size() + 1
  endif

  -- Add definition
  !this.list[!index]        = !definition
  !this.key[!index]         = !key
  !this.description[!index] = !definition.description.upcase()
  !this.level[!index]       = !definition.level
  !this.obstruction[!index] = !definition.obstruction
  !this.clFlag[!index]      = !definition.clFlag
  !this.tuFlag[!index]      = !definition.tuFlag

  -- Return
  return true

endmethod
-- End of method definition for .replace(STRING, GPHREPDEFINITION) BOOLEAN
