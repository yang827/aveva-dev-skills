--
-- Description:     Ship Grid object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  drawBaseLines()                  -                   Draw base lines for grid
--  drawScale()                      -                   Draw a scale along the base lines
--  drawXY()                         -                   Draw grid in XY plane, we'll assume that the grid
--  drawXZ()                         -                   Draw grid in XZ plane, we'll assume that the grid
--  drawYZ()                         -                   Draw grid in YZ plane, we'll assume that the grid
--  gphShipGrid()                    -                   Constructor
--  gphShipGrid(SHIPGRID)            -                   Constructor using passed ship grid
--  hide()                           -                   Hide all graphics
--  hideBaseLines()                  -                   Hide base lines
--  hideTags()                       -                   Hide tags
--  hideXY()                         -                   Hide XY graphics
--  hideXZ()                         -                   Hide XZ graphics
--  hideYZ()                         -                   Hide YZ graphics
--  limits()                         -                   Set view to ship limits
--  startIndex(REAL,REAL)            REAL                Get the starting index for grid axis for the passed
--  tagGrids()                       -                   tag grids
--

define object GPHSHIPGRID

  -- Ship Grid
  member .grid            is SHIPGRID

  -- Visible Grids
  member .xyVisible       is BOOLEAN
  member .xzVisible       is BOOLEAN
  member .yzVisible       is BOOLEAN

  -- Grid line which tags are displayed
  member .xTagLine        is REAL
  member .yTagLine        is REAL
  member .zTagLine        is REAL

  -- Tag Increment
  member .xIncrement      is REAL
  member .yIncrement      is REAL
  member .zIncrement      is REAL

  -- Aid Graphics
  member .baseAid         is REAL
  member .tagAid          is REAL
  member .gridAidXY       is REAL
  member .gridAidXZ       is REAL
  member .gridAidYZ       is REAL

  -- Line Styles
  member .baseLine        is REAL
  member .tagLine         is REAL
  member .gridLine        is REAL

  -- Line Colours
  member .baseColour      is REAL
  member .tagColour       is REAL
  member .gridColourXY    is REAL
  member .gridColourXZ    is REAL
  member .gridColourYZ    is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      gphShipGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphShipGrid()

  -- Visible Grids
  !this.xyVisible     = false
  !this.xzVisible     = false
  !this.yzVisible     = false

  -- Tag Positions
  !this.xTagLine      = 0
  !this.yTagLine      = 0
  !this.zTagLine      = 0

  -- Tag Increment
  !this.xIncrement    = 5
  !this.yIncrement    = 1
  !this.zIncrement    = 1

  -- Allocate aid numbers
  !this.baseAid       = !!aidNumbers.add('Ship Grid Base Aid')
  !this.tagAid        = !!aidNumbers.add('Ship Grid Tag Aid')
  !this.gridAidXY     = !!aidNumbers.add('Ship Grid XY Aid')
  !this.gridAidXZ     = !!aidNumbers.add('Ship Grid XZ Aid')
  !this.gridAidYZ     = !!aidNumbers.add('Ship Grid YZ Aid')

  -- Line Styles
  !this.baseLine      = 1
  !this.tagLine       = 1
  !this.gridLine      = 2

  -- Line Colours
  !this.baseColour    = 212
  !this.tagColour     = 212
  !this.gridColourXY  = 233
  !this.gridColourXZ  = 224
  !this.gridColourYZ  = 243

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gphShipGrid
--
-- Description: Constructor using passed ship grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      SHIPGRID    Ship grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphShipGrid(!grid is SHIPGRID)

  -- Initialise Variables
  !this.gphShipGrid()
  !this.grid  = !grid

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      startIndex
--
-- Description: Get the starting index for grid axis for the passed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Start value
--    2   R      REAL        Increments
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .startIndex(!start is REAL, !increment is REAL) is REAL

  -- Initialise Variables
  !startValue   = REAL()
  !startValue   = nint(!start / !increment)
  !startValue   = !startValue * !increment
  if(!startValue.lt(!start)) then
    !startValue = !startValue + !increment
  endif

  -- Return
  return !startValue

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hide
--
-- Description: Hide all graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hide()
  !this.hideXY()
  !this.hideXZ()
  !this.hideYZ()
  !this.hideBaseLines()
  !this.hideTags()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hideBaseLines
--
-- Description: Hide base lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hideBaseLines()
--  AID CLEAR ALL $!<this.baseAid>
    !!aidNumbers.remove(!this.baseAid)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hideTags
--
-- Description: Hide tags
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hideTags()
--  AID CLEAR ALL $!<this.tagAid>
    !!aidNumbers.remove(!this.tagAid)
endmethod
-- End of method

------------------------------------------------------------------------
