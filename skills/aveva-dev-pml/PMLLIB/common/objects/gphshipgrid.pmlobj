------------------------------------------------------------------------

define method .hideXZ()
  !this.xzVisible   = false
--  AID CLEAR ALL $!<this.gridAidXZ>
    !!aidNumbers.remove(!this.gridAidXZ)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hideYZ
--
-- Description: Hide YZ graphics
--
-- Method Type: Function/Procedure
