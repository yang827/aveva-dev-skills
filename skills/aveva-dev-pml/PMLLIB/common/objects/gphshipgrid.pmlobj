-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hideYZ()
  !this.yzVisible   = false
--  AID CLEAR ALL $!<this.gridAidYZ>
    !!aidNumbers.remove(!this.gridAidYZ)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description: Set view to ship limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limits()

  -- Get maximum extents of the grid
  !volume       = !this.grid.volume()

  -- Set limits
  !limits[1]    = !volume.from.east
  !limits[2]    = !volume.to.east
  !limits[3]    = !volume.from.north
  !limits[4]    = !volume.to.north
  !limits[5]    = !volume.from.up
  !limits[6]    = !volume.to.up
  !!gphViews.views[1].limits = !limits

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawXY
--
-- Description: Draw grid in XY plane, we'll assume that the grid
--              is in the cardinal directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawXY()

  -- Remove aid graphics
  !this.hideXY()

  -- Initialise Variables
  !this.xyVisible = true

  -- Reference point grid is drawn through
  !origin         = !this.grid.position(!this.xTagLine, !this.yTagLine, !this.zTagLine)

  !projection     = 1000mm
  !xMaxIndex      = !this.grid.xOffset.size()
  !yMaxIndex      = !this.grid.yOffset.size()

  -- Get maximum extents of the grid
  !volume         = !this.grid.volume()
  !minimum        = !volume.from
  !maximum        = !volume.to

  -- Draw X grid lines in the Y direction
  !from           = !origin
  !from.north     = !volume.from.north - 300mm
  !to             = !origin
  !to.north       = !volume.to.north + 300mm
  do !x from 1 to !xMaxIndex
    !from.east    = !this.grid.xOffset[!x]
    !to.east      = !from.east
    !line         = !from.line(!to)
    !line.draw(!this.gridAidXY, !this.gridLine, !this.gridColourXY)
  enddo

  -- Draw Y grid lines in the X direction
  !from           = !origin
  !from.east      = !volume.from.east - 300mm
  !to             = !origin
  !to.east        = !volume.to.east + 300mm
  !line           = !from.line(!to)
  !line.draw(!this.gridAidXY, !this.gridLine, !this.gridColourXY)
  do !y from 1 to !yMaxIndex
    !from.north   = !this.grid.yOffset[!y]
    !to.north     = !from.north
    !line         = !from.line(!to)
    !line.draw(!this.gridAidXY, !this.gridLine, !this.gridColourXY)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawXZ
--
-- Description: Draw grid in XZ plane, we'll assume that the grid
--              is in the cardinal directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawXZ()

  -- Remove aid graphics
  !this.hideXZ()

  -- Initialise Variables
  !this.xzVisible = true

  -- Reference point grid is drawn through
  !origin         = !this.grid.position(!this.xTagLine, !this.yTagLine, !this.zTagLine)

  !projection     = 1000mm
  !xMaxIndex      = !this.grid.xOffset.size()
  !zMaxIndex      = !this.grid.zOffset.size()

  -- Get maximum extents of the grid
  !volume         = !this.grid.volume()
  !minimum        = !volume.from
  !maximum        = !volume.to

  -- Draw X grid lines in the Z direction
  !from           = !origin
  !from.up        = 0
  !to             = !origin
  !to.up          = !volume.to.up + 300mm
  do !x from 1 to !xMaxIndex
    !from.east    = !this.grid.xOffset[!x]
    !to.east      = !from.east
    !line         = !from.line(!to)
    !line.draw(!this.gridAidXZ, !this.gridLine, !this.gridColourXZ)
  enddo

  -- Draw Z grid lines in the X direction
  !from           = !origin
  !from.east      = !volume.from.east - 300mm
  !from.up        = 0
  !to             = !from
  !to.east        = !volume.to.east + 300mm
  !line         = !from.line(!to)
  !line.draw(!this.gridAidXZ, !this.gridLine, !this.gridColourXZ)
  do !z from 1 to !zMaxIndex
    !from.up      = !this.grid.zOffset[!z]
    !to.up        = !from.up
    !line         = !from.line(!to)
    !line.draw(!this.gridAidXZ, !this.gridLine, !this.gridColourXZ)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawYZ
--
-- Description: Draw grid in YZ plane, we'll assume that the grid
--              is in the cardinal directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawYZ()

  -- Remove aid graphics
  !this.hideYZ()

  -- Initialise Variables
  !this.yzVisible = true

  -- Reference point grid is drawn through
  !origin         = !this.grid.position(!this.xTagLine, !this.yTagLine, !this.zTagLine)

  !projection     = 1000mm
  !yMaxIndex      = !this.grid.yOffset.size()
  !zMaxIndex      = !this.grid.zOffset.size()

  -- Get maximum extents of the grid
  !volume         = !this.grid.volume()
  !minimum        = !volume.from
  !maximum        = !volume.to

  -- Draw Y grid lines in the Z direction
  !from           = !origin
  !from.up        = 0
  !to             = !from
  !to.up          = !volume.to.up + 300mm
  !line           = !from.line(!to)
  !line.draw(!this.gridAidYZ, !this.gridLine, !this.gridColourYZ)
  do !y from 1 to !yMaxIndex
    !from.north   = !this.grid.yOffset[!y]
    !to.north     = !from.north
    !line         = !from.line(!to)
    !line.draw(!this.gridAidYZ, !this.gridLine, !this.gridColourYZ)
  enddo

  -- Draw Z grid lines in the Y direction
  !from           = !origin
  !from.north     = !volume.from.north - 300mm
  !from.up        = 0
  !to             = !from
  !to.north       = !volume.to.north + 300mm
  !line           = !from.line(!to)
  !line.draw(!this.gridAidYZ, !this.gridLine, !this.gridColourYZ)
  do !z from 1 to !zMaxIndex
    !from.up      = !this.grid.zOffset[!z]
    !to.up        = !from.up
    !line         = !from.line(!to)
    !line.draw(!this.gridAidYZ, !this.gridLine, !this.gridColourYZ)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tagGrids
--
-- Description: tag grids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagGrids()

  -- Remove aid graphics
  !this.hideTags()

  -- Draw the scale
  !this.drawScale()

  -- Initialise Variables
  !xMaxIndex        = !this.grid.xOffset.size()
  !yMaxIndex        = !this.grid.yOffset.size()
  !zMaxIndex        = !this.grid.zOffset.size()

  -- Reference point grid is drawn through
  !origin           = !this.grid.position(!this.xTagLine, !this.yTagLine, !this.zTagLine)

  -- X Tags
  if(!this.xyVisible.or(!this.xzVisible)) then

    -- Draw X tag line
    !from           = !origin
    !from.east      = !this.grid.xOffset.first() - 300mm
    !to             = !origin
    !to.east        = !this.grid.xOffset.last() + 300mm
    !xTagLine       = !from.line(!to)
    !xTagLine.draw(!this.tagAid, !this.tagLine, !this.tagColour)

    -- Tag text
    !xStart         = !this.startIndex(!this.grid.xId.first(), !this.xIncrement)
    !xIndex         = !this.grid.xId.findFirst(!xStart)
    !tagPos         = !origin

    -- xIndex may be unset if the increment number is greater than the number of grids -x of the origin
    if (!xIndex.unset()) then
      !xIndex = 1
    endif

    do !x from !xIndex to !xMaxIndex by !this.xIncrement
      !tagText      = !this.grid.xPrefix & ' ' & !this.grid.xId[!x]
      !tagPos.east  = !this.grid.xOffset[!x]
      AID TEXT NUMBER $!this.tagAid '$!tagText' AT $!tagPos
    enddo

  endif

  -- Y Tags
  if(!this.xyVisible.or(!this.yzVisible)) then

    -- Draw X tag line
    !from           = !origin
    !from.north     = !this.grid.yOffset.first() - 300mm
    !to             = !origin
    !to.north       = !this.grid.yOffset.last() + 300mm
    !yTagLine       = !from.line(!to)
    !yTagLine.draw(!this.tagAid, !this.tagLine, !this.tagColour)

    -- Tag text
    !yStart         = !this.startIndex(!this.grid.yId.first(), !this.yIncrement)
    !yIndex         = !this.grid.yId.findFirst(!yStart)
    !tagPos         = !origin

    -- yIndex may be unset if the increment number is greater than the number of grids -y of the origin
    if (!yIndex.unset()) then
      !yIndex = 1
    endif

    do !y from !yIndex to !yMaxIndex by !this.yIncrement
      !tagText      = !this.grid.yPrefix & ' ' & !this.grid.yId[!y]
      !tagPos.north = !this.grid.yOffset[!y]
      AID TEXT NUMBER $!this.tagAid '$!tagText' AT $!tagPos
    enddo

  endif

  -- Z Tags
  if(!this.xzVisible.or(!this.yzVisible)) then

    -- Draw Z tag line
    !from           = !origin
    !from.up        = 0
    !to             = !origin
    !to.up          = !this.grid.zOffset.last() + 300mm
    !zTagLine       = !from.line(!to)
    !zTagLine.draw(!this.tagAid, !this.tagLine, !this.tagColour)

    -- Tag text
    !zStart         = !this.startIndex(!this.grid.zId.first(), !this.zIncrement)
    !zIndex         = !this.grid.zId.findFirst(!zStart)
    !tagPos         = !origin

    -- zIndex may be unset if the increment number is greater than the number of grids -z of the origin
    if (!zIndex.unset()) then
      !zIndex = 1
    endif

    do !z from !zIndex to !zMaxIndex by !this.zIncrement
      !tagText      = !this.grid.zPrefix & ' ' & !this.grid.zId[!z]
      !tagPos.up    = !this.grid.zOffset[!z]
      AID TEXT NUMBER $!this.tagAid '$!tagText' AT $!tagPos
    enddo

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawBaseLines
--
-- Description: Draw base lines for grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawBaseLines()

  -- Remove aid graphics
  !this.hideBaseLines()

  -- Initialise Variables
--  !refPos           = !this.grid.refPosition
  -- Reference point grid is drawn through
  !refPos           = !this.grid.position(!this.xTagLine, !this.yTagLine, !this.zTagLine)
  !xMaxIndex        = !this.grid.xOffset.size()
  !yMaxIndex        = !this.grid.yOffset.size()
  !zMaxIndex        = !this.grid.zOffset.size()

  -- X Base Line
  !from           = !refPos
  !from.east      = !this.grid.xOffset.first() - 3000mm
  !to             = !refPos
  !to.east        = !this.grid.xOffset.last() + 3000mm
  !xBaseLine      = object LINE(!from, !to)
  !xBaseLine.draw(!this.baseAid, !this.baseLine, !this.baseColour)
  AID TEXT NUMBER $!<this.baseAid> 'Aft' AT $!<from>
  AID TEXT NUMBER $!<this.baseAid> 'Fwd' AT $!<to>

  -- Y Base Line
  !from           = !refPos
  !from.north     = !this.grid.yOffset.first() - 3000mm
  !to             = !refPos
  !to.north       = !this.grid.yOffset.last() + 3000mm
  !yBaseLine      = object LINE(!from, !to)
  !yBaseLine.draw(!this.baseAid, !this.baseLine, !this.baseColour)
  AID TEXT NUMBER $!<this.baseAid> 'Stbd' AT $!<from>
  AID TEXT NUMBER $!<this.baseAid> 'Port' AT $!<to>

  -- Z Base Line
  !from           = !refPos
  !from.up        = !this.grid.zOffset.first() - 3000mm
  !to             = !refPos
  !to.up          = !this.grid.zOffset.last() + 3000mm
  !zBaseLine      = object LINE(!from, !to)
  !zBaseLine.draw(!this.baseAid, !this.baseLine, !this.baseColour)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawScale
--
-- Description: Draw a scale along the base lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawScale()

  -- Initialise Variables
  !xMaxIndex        = !this.grid.xOffset.size()
  !yMaxIndex        = !this.grid.yOffset.size()
  !zMaxIndex        = !this.grid.zOffset.size()

  -- Always refresh base lines
  !this.drawBaseLines()

  -- Reference point grid is drawn through
  !origin           = !this.grid.position(!this.xTagLine, !this.yTagLine, !this.zTagLine)
--  pin 1 at $!origin

  !tagPos         = !origin

  do !x from 1 to !xMaxIndex by 1
    !tagPos.east  = !this.grid.xOffset[!x]
    !a = !tagPos
    !b = !tagPos
    !a.north = !a.north + 200mm
    !b.north = !b.north - 200mm
    !line = object LINE(!a, !b)
    !gphLine = object GPHLINE(!line)
    !gphLine.draw(!this.baseAid, false, !this.tagColour, 1)
  enddo

  do !x from 1 to !xMaxIndex by 1
    !tagPos.east  = !this.grid.xOffset[!x]
    !a = !tagPos
    !b = !tagPos
    !a.up = !a.up + 200mm
    !b.up = !b.up - 200mm
    !line = object LINE(!a, !b)
    !gphLine = object GPHLINE(!line)
    !gphLine.draw(!this.baseAid, false, !this.tagColour, 1)
  enddo

  !tagPos         = !origin

  do !y from 1 to !yMaxIndex by 1
    !tagPos.north  = !this.grid.yOffset[!y]
    !a = !tagPos
    !b = !tagPos
    !a.east = !a.east + 200mm
    !b.east = !b.east - 200mm
    !line = object LINE(!a, !b)
    !gphLine = object GPHLINE(!line)
    !gphLine.draw(!this.baseAid, false, !this.tagColour, 1)
  enddo

  do !y from 1 to !yMaxIndex by 1
    !tagPos.north  = !this.grid.yOffset[!y]
    !a = !tagPos
    !b = !tagPos
    !a.up = !a.up + 200mm
    !b.up = !b.up - 200mm
    !line = object LINE(!a, !b)
    !gphLine = object GPHLINE(!line)
    !gphLine.draw(!this.baseAid, false, !this.tagColour, 1)
  enddo

  !tagPos         = !origin

  do !z from 1 to !zMaxIndex by 1
    !tagPos.up  = !this.grid.zOffset[!z]
    !a = !tagPos
    !b = !tagPos
    !a.east = !a.east + 200mm
    !b.east = !b.east - 200mm
    !line = object LINE(!a, !b)
    !gphLine = object GPHLINE(!line)
    !gphLine.draw(!this.baseAid, false, !this.tagColour, 1)
  enddo

  do !z from 1 to !zMaxIndex by 1
    !tagPos.up = !this.grid.zOffset[!z]
    !a = !tagPos
    !b = !tagPos
    !a.north = !a.north + 200mm
    !b.north = !b.north - 200mm
    !line = object LINE(!a, !b)
    !gphLine = object GPHLINE(!line)
    !gphLine.draw(!this.baseAid, false, !this.tagColour, 1)
  enddo

endmethod
-- End of method
