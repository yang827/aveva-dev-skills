--
--
-- Description:
-- Graphic sphere
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draw()                           -                   Draw plane to graphics canvas
--  filled(BOOLEAN)                  -                   Sets fill sphere
--  gphSphere(POSITION,REAL)         -                   Constructor
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--
------------------------------------------------------------------------

-- Define object
define object GPHSPHERE

  -- Position
  member .position    is POSITION

  -- Diameter
  member .diameter    is REAL

  -- Aid number
  member .aidNumber   is REAL

  -- Filled/Unfilled
  member .fill        is STRING

endobject
-- End of object definition for GPHSPHERE

------------------------------------------------------------------------
--
-- Method:      gphSphere
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphSphere(!posDef is POSITION, !number is REAL)

  -- Clear Current
  !this.position  = !posDef
  !this.aidNumber = !number
  !this.diameter  = 200mm
  !this.fill      = 'OFF'

endmethod
-- End of method definition for .gphSphere(POSITION, REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description:
--   Draw plane to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Clear Current
  AID CLEAR SPHERE $!this.aidNumber
  handle any
  endhandle

  -- Draw Circle
  AID SPHERE NUMBER $!this.aidNumber $!this.position DIAMETER $!this.diameter

endmethod
-- End of method definition for .draw()

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description:
--   Sets fill sphere
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description:
--   Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description:
--   Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  !this.position = !position

endmethod
-- End of method definition for .position(POSITION)
