--   Group:         Aid element handlers

--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Dec 2 14:17:57 "GMT 1998
--
--
-- Description:
-- Graphical representation of s spine.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     GMFSPINE            Returns underlying core object of graphical object
--  draw(REAL)                       -
--  gphSpine()                       -                   Constructor
--  gphSpine(GMFSPINE)               -                   Constructor
--
------------------------------------------------------------------------

define object GPHSPINE

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Line Definition
  member .spine        is GMFSPINE

endobject
-- End of object definition for GPHSPINE

------------------------------------------------------------------------
--
-- Method:      gphSpine
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphSpine()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.visible   = true

endmethod
-- End of method definition for .gphSpine()

------------------------------------------------------------------------
--
-- Method:      gphSpine
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFSPINE    Spnedefinition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphSpine(!spine is GMFSPINE)

  -- Initialise Variables
  !this.gphSpine()
  !this.spine = !spine

endmethod
-- End of method definition for .gphSpine(GMFSPINE)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description: Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is GMFSPINE

  return !this.spine

endmethod
-- End of method definition for .coreObject() GMFSPINE


------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw spine to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  -- Clear Current Line
  AID CLEAR LINE $!<aidNumber>
  handle any
  endhandle
  AID CLEAR CYLINDER $!<aidNumber>
  handle any
  endhandle
  AID CLEAR ARROW $!<aidNumber>
  handle any
  endhandle
  AID CLEAR TEXT $!<aidNumber>
  handle any
  endhandle

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Loop through spine points
  do !i indices !this.spine.points

    -- Draw Arc
    if(!this.spine.points[!i].arc.set()) then
      !diameter = !this.spine.points[!i].arc.radius * 2
      AID CYLI NUMBER $!<aidNumber> DIAMETER $!diameter HEIGHT 1mm POSITION $!this.spine.points[$!i].arc.position ORIENTATION $!this.spine.points[$!i].arc.orientation  FILLED OFF
    endif

  enddo

return


  -- Draw detail of line
  if(!this.detail) then
    !length    = !this.line.length() / 2
    !direction = !this.line.direction()
    AID ARROW NUMBER $!<aidNumber> AT $!this.line.startPosition DIR $!direction HEIGHT $!length
    AID TEXT NUMBER $!<aidNumber> 'Start' AT $!this.line.startPosition
    AID TEXT NUMBER $!<aidNumber> 'End'   AT $!this.line.endPosition
  endif

  -- Tag Line
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Spine [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    !midPoint  = !this.line.proportion(0.5)
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!midPoint
  endif

endmethod
-- End of method definition for .draw(REAL)
