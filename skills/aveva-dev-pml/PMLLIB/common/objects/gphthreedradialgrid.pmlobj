-- File:            gphthreedradialgrid.pmlobj
--   Type:          Object Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Dec 17 16:36:46 WAT 1997
--
--
-- Description:
-- Graphical Grid Definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreGrids()                      -                   Create core grids for displayed axes of grid system
--  coreObject()                     RADIALGRID          Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  displayStyle()                   -                   Sets the default style of the graphical item
--  displayStyle(REAL,REAL)          -                   Sets the style of the graphical item
--  draw(REAL)                       -                   Draw (remove previous definitions of aid number)
--  draw(REAL,BOOLEAN)               -                   Draw radial grid to graphics canvas
--  draw(REAL,BOOLEAN,REAL)          -                   Draw to graphics canvas
--  draw(REAL,BOOLEAN,REAL,REAL)     -                   Draw line to graphics canvas
--  drawForEDG(BOOLEAN,REAL)         -                   Set drawForEDG flag
--  edit(REAL)                       -                   Edit graphic grid
--  gphThreeDRadialGrid()            -                   Constructor
--  gphThreeDRadialGrid(DBREF)       -                   Constructor, using grid system
--  gphThreeDRadialGrid(RADIALGRID)  -                   Constructor
--  labelEnu()                       -                   Sets labelling to ENU
--  labelId()                        -                   Sets labelling to gridline ID
--  labelOffset()                    -                   Sets labelling to offset
--  list(STRING)                     ARRAY               Return selection list for given axis
--  localLimits()                    ARRAY               Returns grid min max offsets as array of 6 values
--  orientation()                    ORIENTATION         Return orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  plane()                          PLANE               Return plane
--  position()                       POSITION            Return position
--  position(POSITION)               -                   Set position
--  saveAsGridSystem(STRING)         -                   Persist definition to database as grid system
--  setLimits()                      -                   Set graphical view limits to encompass grid
--  volume()                         VOLUME              Return volume to draw grid within
--
------------------------------------------------------------------------

-- Define object
define object GPHTHREEDRADIALGRID

  -- Description
  member .description  is STRING

  -- Tag
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Detail label type
  member .labelType    is STRING

  -- Basic representations (used for speed)
  member .basic        is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Colour
  member .colour       is REAL

  -- Line style
  member .style        is REAL

  -- Drawing mode
  member .drawForEDG       is BOOLEAN

  -- Member radialGrid for EDG interaction
  member .gridxy           is GPHRADIALGRID

  -- Aid number for radialGrid
  member .aidNumberGridxy  is REAL

  -- Position and orientation
  member .position     is POSITION
  member .orientation  is ORIENTATION

  -- Axis labels
  member .aAxisLabel   is STRING
  member .rAxisLabel   is STRING
  member .zAxisLabel   is STRING

  -- Gridline IDs
  member .aAxisIDs     is ARRAY
  member .rAxisIDs     is ARRAY
  member .zAxisIDs     is ARRAY

  -- Gridline offsets
  member .aOffsets     is ARRAY
  member .rOffsets     is ARRAY
  member .zOffsets     is ARRAY

  -- Database grid system (if grid has been persisted)
  member .gridSystem   is DBREF

  -- Axes offsets for drawing (0 is draw thru grid position, n is draw thru offset n)
  member .zOffsetThru  is REAL

endobject
-- End of object definition for GPHTHREEDRADIALGRID

------------------------------------------------------------------------
--
-- Method:      gphThreeDRadialGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphThreeDRadialGrid()

  -- Initialise Variables
  !this.tag         = false
  !this.detail      = false
  !this.labelType   = 'ENU'
  !this.basic       = false
  !this.visible     = TRUE
  !this.drawForEDG  = FALSE
  !this.rAxisLabel  = ||
  !this.aAxisLabel  = ||
  !this.zAxisLabel  = ||

  -- Default display style for main lines
  !this.displayStyle()

  -- Default axes draw selection
  !this.zOffsetThru = 0

  -- Clear arrays in case object is being reused
  !this.gridSystem = object DBREF()
  !this.aOffsets = ARRAY()
  !this.rOffsets = ARRAY()
  !this.zOffsets = ARRAY()

endmethod
-- End of method definition for .gphThreeDRadialGrid()

------------------------------------------------------------------------
--
-- Method:      gphThreeDRadialGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Definition of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphThreeDRadialGrid(!gridDef is RADIALGRID)

  -- Initialise Variables
  !this.gphThreeDRadialGrid()
  !this.position    = !gridDef.position
  !this.orientation = !gridDef.orientation

  -- Axes data with single z element
  do !a values !gridDef.angles
    !this.aOffsets.append(!a)
  enddo
  !this.rOffsets.append(0)
  do !r values !gridDef.radii
    !this.yOffsets.append(!r)
  enddo
  !this.zOffsets.append(0)

endmethod
-- End of method definition for .gphThreeDRadialGrid(RADIALGRID)

------------------------------------------------------------------------
--
-- Method:      gphThreeDRadialGrid
--
-- Description: Constructor, using passed grid system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Grid system
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphThreeDRadialGrid(!gridSystem is DBREF)

  -- Initialise Variables
  !this.gphThreeDRadialGrid()

  -- Reconstruct members from grid system object
  if (!gridSystem.type ne |GRIDSY|) then
    return error 1 |object is not a grid system|
  endif
  !this.gridSystem = !gridSystem

  -- Position and orientation
  !this.position    = !this.gridSystem.position
  !this.orientation = !this.gridSystem.orientation

  -- Get grid axis and grid line data
  !grdaxes = ARRAY()
  !grdlbls = ARRAY()
  !grdids  = ARRAY()
  !grdoffs = ARRAY()
  !gridAxes = !this.gridSystem.members
  do !i indices !gridAxes
    skip if (!gridAxes[!i].type ne |GRIDAX|)
    !grdaxes[!i] = !gridAxes[!i].grdaxe
    !grdlbls[!i] = !gridAxes[!i].grdlbl
    !grdids[!i]  = ARRAY()
    !grdoffs[!i] = ARRAY()
    !gridLines = !gridAxes[!i].members
    do !j indices !gridLines
      skip if (!gridLines[!j].type ne |GRIDLN|)
      !grdids[!i][!j]  = !gridLines[!j].grdid
      !grdoffs[!i][!j] = !gridLines[!j].grdoff
    enddo
    -- Sort into ascending order of offsets in each axis
    !sortedIndices = !grdoffs[!i].sortedIndices()
    !grdoffs[!i].reindex(!sortedIndices)
    !grdids[!i].reindex(!sortedIndices)
  enddo

  -- Set member data according to axis label
  do !i indices !grdaxes
    if (!grdaxes[!i] eq |A| or !grdaxes[!i] eq |X|) then
      !this.aAxisLabel = !grdlbls[!i]
      do !j indices !grdids[!i]
        !this.aAxisIDs[!j] = !grdids[!i][!j]
        !this.aOffsets.append(!grdoffs[!i][!j].dbUnits().value().string('D2').real())
      enddo
    elseif (!grdaxes[!i] eq |R| or !grdaxes[!i] eq |Y|) then
      !this.rAxisLabel = !grdlbls[!i]
      do !j indices !grdids[!i]
        !this.rAxisIDs[!j] = !grdids[!i][!j]
        !this.rOffsets.append(!grdoffs[!i][!j])
      enddo
    elseif (!grdaxes[!i] eq |Z|) then
      !this.zAxisLabel = !grdlbls[!i]
      do !j indices !grdids[!i]
        !this.zAxisIDs[!j] = !grdids[!i][!j]
        !this.zOffsets[!j] = !grdoffs[!i][!j]
      enddo
    endif
  enddo

endmethod
-- End of method definition for .gphThreeDRadialGrid(DBREF)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description:  Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is RADIALGRID

  -- Construct a core grid object from the data
  !this.coreGrids()
  return !this.gridxy.grid

endmethod
-- End of method definition for .coreObject() RADIALGRID

------------------------------------------------------------------------
--
-- Method:      localLimits
--
-- Description: Returns grid min max offsets as array of 6 values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       6 reals, xmin, xmax, ymin, ymax, zmin, zmax in grid offset coordinates
--
------------------------------------------------------------------------

define method .localLimits() is ARRAY

  -- Offsets arrays are sorted and may be empty
  !size = ARRAY()
  do !i from 1 to 6
    !size[!i] = 0
  enddo
  -- Use outside radius for min and max in both x and y directions
  if (!this.rOffsets.empty().not()) then
    !size[1] = 0 - !this.rOffsets.last()
    !size[2] = !this.rOffsets.last()
    !size[3] = 0 - !this.rOffsets.last()
    !size[4] = !this.rOffsets.last()
  endif
  if (!this.zOffsets.empty().not()) then
    -- Include axes in limits even if grid is offset in positive direction
    !size[5] = !this.zOffsets.first().min(0)
    !size[6] = !this.zOffsets.last()
  endif
  return !size

endmethod
-- End of method definition for .localLimits() ARRAY

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the default style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle()

  -- Initialise Variables
  !this.colour = !!gphColOpt.aids.code
  !this.style  = 2

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayStyle
--
-- Description: Sets the style of the graphical item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
--    2   R      REAL        Style code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStyle(!colour is REAL, !style is REAL)

  -- Initialise Variables
  !this.colour = !colour
  !this.style  = !style

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw (remove previous definitions of aid number)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  !this.draw(!aidNumber, true, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN)

  !this.draw(!aidNumber, !hide, !this.colour, !this.style)

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL)

  !this.draw(!aidNumber, !hide, !colour, !this.style)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw line to graphics canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
--    2   R      BOOLEAN     hide is true
--    3   R      REAL        Colour code
--    4   R      REAL        Line style
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL, !hide is BOOLEAN, !colour is REAL, !style is REAL)

  -- Clear Current Line
  if (!hide) then
    AID CLEAR ALL $!<aidNumber>
  endif

  -- Return if invisible
  if (!this.visible.not()) then
    return
  endif

  -- Draw separate core radialGrid for EDG interaction
  if (!this.drawForEDG and !this.basic.not()) then

    -- Create grid data
    !this.coreGrids()

    -- Draw separate radialGrid without text
    if (!this.aidNumberGridxy.unset()) then
      !this.aidNumberGridxy = !!aidNumbers.add(!this.gridxy)
    else
      !!aidNumbers.replace(!this.aidNumberGridxy, !this.gridxy)
    endif
    AID CLEAR TEXT $!<this.aidNumberGridxy>

  endif

  -- Initialise Variables
  !projection = 2000mm

  -- Define Plane
  !plane      = object PLANE(!this.position, !this.orientation)

  -- Maximum/Minimum x/y/z values
  !xDirection = !this.orientation.xdir()
  !yDirection = !this.orientation.ydir()
  !zDirection = !this.orientation.zdir()
  !minMaxs    = !this.localLimits()
  !xMin       = !minMaxs[1]
  !xMax       = !minMaxs[2]
  !yMin       = !minMaxs[3]
  !yMax       = !minMaxs[4]
  !zMin       = !minMaxs[5]
  !zMax       = !minMaxs[6]
  --!unusedXLength    = !minMaxs[2] - !minMaxs[1]
  --!unusedYLength    = !minMaxs[4] - !minMaxs[3]
  --!unusedZLength    = !minMaxs[6] - !minMaxs[5]

  -- Determine the maximum diameter
  if(!this.rOffsets.empty()) then
    !minRadius = 0mm
    !maxRadius = 5000mm
  else
    !minRadius = !this.rOffsets.first()
    !maxRadius = !this.rOffsets.last()
  endif

  -- if the minimum radius equals zero increase it by 1/1000th of a unit.
  if (!minRadius eq 0) then
    !minRadius = 0.001
  endif

  -- Projected line
  !lineProjected = !maxRadius + !projection
  !lineProject   = !maxRadius + !projection / 2

  -- Draw grid axes
  !height = !minRadius
  !height = !height.min(500mm)
  !height = !height.max(300mm)
  if (!this.drawForEDG.not()) then
    AID ARROW NUMBER $!<aidNumber> AT $!<this.position> DIRECTION $!<zDirection> HEIGHT $!<height>
  endif

  -- Main axes
  !xline  = !plane.threeDPosition(object XYPOSITION(!lineProjected, 0)).line(!plane.threeDPosition(object XYPOSITION(!maxRadius, 0)))
  !yline  = !plane.threeDPosition(object XYPOSITION(0, !lineProjected)).line(!plane.threeDPosition(object XYPOSITION(0, !maxRadius)))
  !zline  = !this.position.offset(!zDirection, !zMax + !projection).line(!this.position.offset(!zDirection, !zMin - !projection))
  if (!this.drawForEDG.not()) then
    !xline.draw(!aidNumber, 4, !colour)
    !yline.draw(!aidNumber, 4, !colour)
    !zline.draw(!aidNumber, 4, !colour)
    AID TEXT NUMBER $!aidNumber 'X' AT $!<xline.startPosition>
    AID TEXT NUMBER $!aidNumber 'Y' AT $!<yline.startPosition>
    AID TEXT NUMBER $!aidNumber 'Z' AT $!<zline.startPosition>
  endif

  -- Label 0 at grid origin
  if(!this.detail.not() or !this.labelType eq 'ID' or !this.labelType eq 'OFFSET') then
    AID TEXT NUMBER $!aidNumber '0'  AT $!<this.position>

  -- Label elev at grid origin
  else

    -- Label with ENU from Grid origin
    if (!this.labelType eq 'ENU') then
      --!text = 'Elev ' & !this.position.up.string(!!distanceFmt)
      --AID TEXT NUMBER $!aidNumber |$!text|  AT $!<this.position>
    endif

  endif

  -- Basic representation of grid
  if(!this.basic) then

    !xline  = !plane.threeDPosition(object XYPOSITION(!lineProjected, 0)).line(!plane.threeDPosition(object XYPOSITION(0 - !lineProjected, 0)))
    !yline  = !plane.threeDPosition(object XYPOSITION(0, !lineProjected)).line(!plane.threeDPosition(object XYPOSITION(0, 0 - !lineProjected)))

    -- Draw maximum diameter
    !arc = object ARC(!this.position, !this.orientation, 0, 360, !maxRadius, true)
    !arc.draw(!aidNumber, !style, !colour)

  -- Standard representation of grid
  else

    -- Offset position for radii if z offset chosen
    !arcPosition = !this.position
    if (!this.zOffsetThru gt 0) then
      !arcPosition = !arcPosition.offset(!zDirection, !this.zOffsets[!this.zOffsetThru])
    endif

    -- Draw the radii
    do !i indices !this.rOffsets
      !radius = !this.rOffsets[!i]
      -- If the radius is zero it won't draw so it will be drawn very small (1/1000th of a unit)
      if (!radius eq 0) then
        !radius = 0.001
      endif
      !arc = object ARC(!arcPosition, !this.orientation, 0, 360, !radius, true)
      if (!this.drawForEDG.not()) then
        !arc.draw(!aidNumber, !style, !colour)
      endif

      -- Detail
      if (!this.detail) then

        -- Label with Gridline label and ID
        if (!this.labelType eq 'ID') then
          !text = !this.rAxisLabel & !this.rAxisIDs[!i]
          !xPosition = !plane.threeDPosition(object XYPOSITION(!this.rOffsets[!i], 0))

        -- Label with radius from Grid origin
        elseif (!this.labelType eq 'ENU') then
          !text = !this.rOffsets[!i].string(!!distanceFmt)
          !xPosition = !plane.threeDPosition(object XYPOSITION(!this.rOffsets[!i], 0))

        -- Label with Offset from previous
        elseif (!this.labelType eq 'OFFSET') then
          skip if (!i eq 1)
          !spacing = !this.rOffsets[!i] - !this.rOffsets[!i - 1]
          !text = !spacing.string(!!distanceFmt)
          !xPosition = !plane.threeDPosition(object XYPOSITION(!this.rOffsets[!i] - !spacing / 2, 0))

        endif
        if (!this.zOffsetThru gt 0) then
          !xPosition = !xPosition.offset(!zDirection, !this.zOffsets[!this.zOffsetThru])
        endif
        AID TEXT NUMBER $!aidNumber |$!text| AT $!xPosition
      endif

    enddo

    -- Draw angle lines
    do !i indices !this.aOffsets
      !angle = !this.aOffsets[!i]
      -- Use centre of grid for start of line rather than where it cross first radius
      -- !line = !plane.threeDPosition(object XYPOSITION(cos(!angle) * !minRadius, sin(!angle) * !minRadius)).line(!plane.threeDPosition(object XYPOSITION(cos(!angle) * !lineProject, sin(!angle) * !lineProject)))
      !line = !this.position.line(!plane.threeDPosition(object XYPOSITION(cos(!angle) * !lineProject, sin(!angle) * !lineProject)))
      if (!this.zOffsetThru gt 0) then
        !line = !line.offset(!zDirection, !this.zOffsets[!this.zOffsetThru])
      endif
      if (!this.drawForEDG.not()) then
        !line.draw(!aidNumber, !style, !colour)
      endif

      -- Detail
      if (!this.detail) then

        -- Label with Gridline label and ID
        if (!this.labelType eq 'ID') then
          !text = !this.aAxisLabel & !this.aAxisIDs[!i]
          !position = !line.endPosition

        -- Label with angle from Grid origin
        elseif (!this.labelType eq 'ENU') then
          !text = !angle.string()
          !position = !line.endPosition

        -- Label with Offset from previous
        elseif (!this.labelType eq 'OFFSET') then
          skip if (!i eq 1)
          !spacing = !this.aOffsets[!i] - !this.aOffsets[!i - 1]
          !text = !spacing.string()
          !angleMid = !angle - !spacing / 2
          !midLine = !plane.threeDPosition(object XYPOSITION(cos(!angleMid) * !minRadius, sin(!angleMid) * !minRadius)).line(!plane.threeDPosition(object XYPOSITION(cos(!angleMid) * !lineProject, sin(!angleMid) * !lineProject)))
          !position = !midLine.endPosition
          if (!this.zOffsetThru gt 0) then
            !position = !position.offset(!zDirection, !this.zOffsets[!this.zOffsetThru])
          endif

        endif
        AID TEXT NUMBER $!aidNumber |$!text| AT $!position
      endif
    enddo

    -- Special case for final angle in circle (from last to first angular offset)
    if (!this.aOffsets.empty().not()) then
      if (!this.detail and !this.labelType eq 'OFFSET' and !this.aOffsets.last() lt 360) then
        !spacing = !this.aOffsets.first() + 360 - !this.aOffsets.last()
        !text = !spacing.string()
        !angleMid = !this.aOffsets.first() + 360 - !spacing / 2
        !midLine = !plane.threeDPosition(object XYPOSITION(cos(!angleMid) * !minRadius, sin(!angleMid) * !minRadius)).line(!plane.threeDPosition(object XYPOSITION(cos(!angleMid) * !lineProject, sin(!angleMid) * !lineProject)))
        !position = !midLine.endPosition
        if (!this.zOffsetThru gt 0) then
          !position = !position.offset(!zDirection, !this.zOffsets[!this.zOffsetThru])
        endif
        AID TEXT NUMBER $!<aidNumber> |$!text| AT $!<position>
      endif
    endif

    if (!this.drawForEDG.not()) then

      -- Basic line definitions for z axis with offsets shown with just small projections at each level
      !zXline = !this.position.offset(!xDirection.opposite(), !projection).line(!this.position.offset(!xDirection, !projection))
      !zYline = !this.position.offset(!yDirection.opposite(), !projection).line(!this.position.offset(!yDirection, !projection))

      -- Define lines offset in the Z direction
      do !i indices !this.zOffsets
        !line1 = !zXline.offset(!zDirection, !this.zOffsets[!i])
        !line2 = !zYline.offset(!zDirection, !this.zOffsets[!i])
        !line1.draw(!aidNumber, !style, !colour)
        !line2.draw(!aidNumber, !style, !colour)

        if (!this.detail) then

          -- Label with Offset from previous
          if (!this.labelType eq 'OFFSET') then
            skip if (!i eq 1)
            !spacing = !this.zOffsets[!i] - !this.zOffsets[!i - 1]
            !text = !spacing.string(!!distanceFmt)
            !newPosition = !line1.proportion(0.5).offset(!zDirection.opposite(), !spacing / 2)

          -- Label with ENU from Grid origin
          elseif (!this.labelType eq 'ENU') then
            !text = 'EL ' & !this.zOffsets[!i].string(!!distanceFmt)
            !newPosition = !line1.proportion(0.5)

          -- Label with Gridline label and ID
          elseif (!this.labelType eq 'ID') then
            !text = !this.zAxisLabel & !this.zAxisIDs[!i]
            !newPosition = !line1.proportion(0.5)

          endif
          AID TEXT NUMBER $!aidNumber |$!text| AT $!newPosition
        endif
      enddo

    endif
  endif

  -- Tag Grid
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Grid [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!<this.position>
  endif

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit graphic grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- Build form if it has not already been built
  if(undefined(!!radialGrids)) then
    pml reload form !!radialGrids
  endif

  -- Setup definePlane
  !!radialGrids.setup(!aidNumber)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!radialGrids.position', 'Modify Grid')
  !packet.key            = 'editRadialGrid'
  !packet.description    = 'Edit aid radial grid definition'
  !packet.form           = !!radialGrids
  !packet.close          = '!!radialGrids.tidy()'
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit(REAL)

