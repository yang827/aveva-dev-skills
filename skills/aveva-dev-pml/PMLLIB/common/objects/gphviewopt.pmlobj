--
--
-- Description:
-- Graphical View Options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyToView(GADGET)              -                   Apply setting to view
--  applyToView(GADGET,STRING)       -                   Constructor
--  default()                        -                   Default settings
--  edit()                           -                   Show edit form
--  globalInstance()                 -                   Create global instance of object
--  gphViewOpt()                     -                   Constructor
--  load()                           -                   Load object from file
--  save()                           -                   Save object to file
--
------------------------------------------------------------------------

define object GPHVIEWOPT

  -- View Settings

  -- Storage File
  member .filename        is STRING

  -- Title (default)
  member .title           is STRING
  member .titleModifiable is BOOLEAN

  -- Shaded
  member .shaded          is BOOLEAN
  -- Borders
  member .borders         is BOOLEAN
  -- Walkthrough
  member .walkThrough     is BOOLEAN

  -- View type
  member .projection      is STRING
  -- Rotate
  member .rotate          is BOOLEAN
  -- Show World Axes
  member .showAxes        is BOOLEAN

  -- Colour settings
  member .background      is COLOUR
  member .highlight       is COLOUR

  -- View Size
  member .width           is REAL
  member .height          is REAL

  -- popup menus type
  member .longMenus       is BOOLEAN

  -- Design Menu Settings
  member .designQuery     is BOOLEAN
  member .designLook      is BOOLEAN
  member .designIso       is BOOLEAN
  member .designLimits    is BOOLEAN
  member .designRotate    is BOOLEAN
  member .designClipping  is BOOLEAN
  member .designConstruct is BOOLEAN
  member .designDrawlist  is BOOLEAN

  -- Navigate Menu Settings
  member .naviQuery       is BOOLEAN
  member .naviLook        is BOOLEAN
  member .naviIso         is BOOLEAN
  member .naviLimits      is BOOLEAN
  member .naviRotate      is BOOLEAN
  member .naviClipping    is BOOLEAN
  member .naviDrawlist    is BOOLEAN

  -- Use Draft Pick Mode
  member .pickMode        is BOOLEAN

endobject
-- End of object definition for GPHVIEWOPT

------------------------------------------------------------------------
--
-- Method:      gphViewOpt
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphViewOpt()

  -- Set default filename
  !module = !!module()
  !this.filename = !module.appKey + '-gphview.pmldat'

  -- Load defaults
  !this.default()

endmethod
-- End of method definition for .gphViewOpt()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!gphViewOpt = !this

  -- Load default settings from file
  !!gphViewOpt.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      default
--
-- Description:
--   Default settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .default()

  !this.title           = '3D View'
  !this.titleModifiable = true
  !this.shaded          = true
  !this.borders         = false
  !this.walkThrough     = false
  !this.projection      = 'PARALLEL'
  !this.rotate          = true
  !this.showAxes        = false
  !this.background.colour('black')
  !this.highlight.colour('white')
  !this.width           = 90
  !this.height          = 20
  !this.longMenus       = false
  !this.designQuery     = true
  !this.designLook      = true
  !this.designIso       = true
  !this.designLimits    = true
  !this.designRotate    = true
  !this.designClipping  = true
  !this.designConstruct = true
  !this.designDrawlist  = true
  !this.naviQuery       = true
  !this.naviLook        = true
  !this.naviIso         = true
  !this.naviLimits      = true
  !this.naviRotate      = true
  !this.naviClipping    = true
  !this.naviDrawlist    = true
  !this.pickMode        = true

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      applyToView
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VIEW        View gadget to apply settings to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyToView(!view is GADGET)

  -- View Setup
  !view.shaded             = !this.shaded
  !view.borders            = !this.borders
  !view.projection         = !this.projection

  !view.walkThrough        = !this.walkThrough

  !view.showAxes           = !this.showAxes
  !view.owner().axesButton.val = !view.showAxes
  handle any
    -- Form does not have this button
    !view.showAxes = FALSE
  endhandle

  !view.background         = !this.background.name
  !view.highlight          = !this.highlight.name

  !view.owner().formTitle  = !this.title & ' (' & !view.owner().number & ')'

  -- Label style set to current coordinates setting
  var !coord COORD
  !view.labelStyle = !coord

endmethod
-- End of method definition for .applyToView(GADGET)

------------------------------------------------------------------------
--
-- Method:      applyToView
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VIEW        View gadget to apply settings to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyToView(!view is GADGET, !formTitle is STRING)

  -- View Setup
  !this.applyToView(!view)
  !view.owner().formTitle  = !formTitle

  -- Label style set to current coordinates setting
  var !coord COORD
  !view.labelStyle = !coord

endmethod
-- End of method definition for .applyToView(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method: save
--
-- Description:
--   Save options settings to %PDMSUSER%
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

  -- write header information
  !saveContents.append('-- Data file for Graphical View Options')
  !saveContents.append('')

  -- Write Data
  !saveContents.append('!!tmpGphViewOpt.title           = ' & !!comQuoteIfString(!this.title))
  !saveContents.append('!!tmpGphViewOpt.titleModifiable = ' & !this.titleModifiable)
  !saveContents.append('!!tmpGphViewOpt.shaded          = ' & !this.shaded)
  !saveContents.append('!!tmpGphViewOpt.borders         = ' & !this.borders)
  !saveContents.append('!!tmpGphViewOpt.walkThrough     = ' & !this.walkThrough)
  !saveContents.append('!!tmpGphViewOpt.projection      = ' & !!comQuoteIfString(!this.projection))
  !saveContents.append('!!tmpGphViewOpt.rotate          = ' & !this.rotate)
  !saveContents.append('!!tmpGphViewOpt.showAxes        = ' & !this.showAxes)
  !saveContents.append('!!tmpGphViewOpt.width           = ' & !this.width)
  !saveContents.append('!!tmpGphViewOpt.height          = ' & !this.height)
  !saveContents.append('!!tmpGphViewOpt.longMenus       = ' & !this.longMenus)
  -- Currently not used
--   !saveContents.append('!!tmpGphViewOpt.designQuery     = ' & !this.designQuery)
--   !saveContents.append('!!tmpGphViewOpt.designLook      = ' & !this.designLook)
--   !saveContents.append('!!tmpGphViewOpt.designIso       = ' & !this.designIso)
--   !saveContents.append('!!tmpGphViewOpt.designLimits    = ' & !this.designLimits)
--   !saveContents.append('!!tmpGphViewOpt.designRotate    = ' & !this.designRotate)
--   !saveContents.append('!!tmpGphViewOpt.designClipping  = ' & !this.designClipping)
--   !saveContents.append('!!tmpGphViewOpt.designConstruct = ' & !this.designConstruct)
--   !saveContents.append('!!tmpGphViewOpt.designDrawlist  = ' & !this.designDrawlist)
--   !saveContents.append('!!tmpGphViewOpt.naviQuery       = ' & !this.naviQuery)
--   !saveContents.append('!!tmpGphViewOpt.naviLook        = ' & !this.naviLook)
--   !saveContents.append('!!tmpGphViewOpt.naviIso         = ' & !this.naviIso)
--   !saveContents.append('!!tmpGphViewOpt.naviLimits      = ' & !this.naviLimits)
--   !saveContents.append('!!tmpGphViewOpt.naviRotate      = ' & !this.naviRotate)
--   !saveContents.append('!!tmpGphViewOpt.naviClipping    = ' & !this.naviClipping)
--   !saveContents.append('!!tmpGphViewOpt.naviDrawlist    = ' & !this.naviDrawlist)

  -- Colour Settings
  !saveContents.append('!!tmpGphViewOpt.background.colour(' & !!comQuoteIfString(!this.background.key()) & ')')
  !saveContents.append('!!tmpGphViewOpt.highlight.colour(' & !!comQuoteIfString(!this.highlight.key()) & ')')
  !saveContents.append('!!tmpGphViewOpt.pickMode       = ' & !this.pickMode)

  -- Write data to file
  !!writeFile('%PDMSUSER%/' + !this.filename, 'OVERWRITE', !saveContents)

endmethod
-- End of method definition for .save()


------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------
define method .load()

  -- get the locations of system options file and user options file
  !optionFiles = !!comGetOptFiles(!this.filename)

  -- create a temporary global variable to store the data
  if (defined(!!tmpGphViewOpt)) then
    !!tmpGphViewOpt.delete()
  endif
  !!tmpGphViewOpt = !this

  -- if a system options file has been found, load the data
  if (defined(!optionFiles[1])) then

    -- load options file
    !localName = !optionFiles[1].fullName()
    $m "$!<localName>"
    handle any
      !this.default()
      if( not defined(!optionFiles[2])) then
        !!alert.warning('Saved view style not loaded. Continuing with default view style: Errors found in ' + !localName )
        !!tmpGphViewOpt.delete()
        return
      endif
    endhandle
  endif

  -- if a user options file has been found, load the options
  if (defined(!optionFiles[2])) then

    -- load options file
    !localName = !optionFiles[2].fullName()
    $m "$!<localName>"
    handle any
        !!alert.warning('Saved view style not loaded. Continuing with default view style: Errors found in ' + !localName )
      !this.default()
      !!tmpGphViewOpt.delete()
      return
    endhandle
  endif

  !this = !!tmpGphViewOpt

  !!tmpGphViewOpt.delete()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Show edit form for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edit()
  -- load and display !!gphSettings form with 3D view options frame active
  loadform !!gphSettings
  !!gphSettings.showForm('3DView')
endmethod
-- End of method definition for .edit()
