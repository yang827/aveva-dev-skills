--
--
-- Description:
-- Graphic representation for a volume object.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coreObject()                     VOLUME              Returns underlying core object of graphical object
--  definition()                     ARRAY               Definition of object to save to file
--  draw(REAL)                       -                   Constructor
--  edit(REAL)                       -                   Edit graphic volume
--  filled(BOOLEAN)                  -                   Sets fill of volume
--  gphVolume()                      -                   Constructor
--  gphVolume(VOLUME)                -                   Constructor
--
------------------------------------------------------------------------

define object GPHVOLUME

  -- Description
  member .description  is STRING

  -- Tag with data
  member .tag          is BOOLEAN

  -- Detailed graphic display
  member .detail       is BOOLEAN

  -- Visible
  member .visible      is BOOLEAN

  -- Volume
  member .volume       is VOLUME

  -- Solid
  member .fill         is STRING

endobject
-- End of object definition for GPHVOLUME

------------------------------------------------------------------------
--
-- Method:      gphVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphVolume()

  -- Initialise Variables
  !this.tag       = false
  !this.detail    = false
  !this.visible   = true
  !this.filled(false)

endmethod
-- End of method definition for .gphVolume()

------------------------------------------------------------------------
--
-- Method:      gphVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VOLUME      Volume definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphVolume(!volume is VOLUME)

  -- Initialise Variables
  !this.gphVolume()
  !this.volume = !volume

endmethod
-- End of method definition for .gphVolume(VOLUME)

------------------------------------------------------------------------
--
-- Method:      coreObject
--
-- Description:
--   Returns underlying core object of graphical object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreObject() is VOLUME

  return !this.volume

endmethod
-- End of method definition for .coreObject() VOLUME

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  -- Clear Current box
  AID CLEAR BOX $!<aidNumber>
  handle any
  endhandle
  AID CLEAR TEXT $!<aidNumber>
  handle any
  endhandle

  -- Return if invisible
  if(!this.visible.not()) then
    return
  endif

  -- Convert volume into a box
  !box         = !this.volume.box()

  -- Draw item
  AID BOX NUMBER $!<aidNumber> AT $!box.position ORIENTATION  $!box.orientation XLENGTH $!box.xLength YLENGTH $!box.yLength ZLENGTH $!box.zLength filled $!this.fill

  -- Draw detail of Box
  if(!this.detail) then
    AID TEXT NUMBER $!<aidNumber> 'From' AT $!this.volume.from
    AID TEXT NUMBER $!<aidNumber> 'To'   AT $!this.volume.to
  endif

  -- Tag Box
  if(!this.tag) then
    if(!this.description.unset()) then
      !text = 'Volume [' & !aidNumber & ']'
    else
      !text = !this.description
    endif
    AID TEXT NUMBER $!<aidNumber> '$!text' AT $!box.position
  endif


endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      filled
--
-- Description:
--   Sets fill of volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for filled
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filled(!state is BOOLEAN)

  -- Fill
  if(!state) then
    !this.fill = 'ON'
  else
    !this.fill = 'OFF'
  endif

endmethod
-- End of method definition for .filled(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Edit graphic volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!aidNumber is REAL)

  -- To be done at some later date
  !!alert.error('No default edit method.')
  return error 1 noalert

endmethod
-- End of method definition for .edit(REAL)

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description:
--   Definition of object to save to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is ARRAY

  -- Initialise Variables
  !return      = ARRAY()

  return !return

endmethod
-- End of method definition for .definition() ARRAY
