---
-- Description:
--  Defaults for grid control.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  data()                           ARRAY               Returns the default data as a string array
--  gridControlDefaults()            -                   Constructor
--

define object GRIDCONTROLDEFAULTS

  member .columnExcelFilter     is BOOLEAN
  member .outlookGroupStyle     is BOOLEAN
  member .columnSummaries       is BOOLEAN
  member .fixedHeaders          is BOOLEAN
  member .fixedRows             is BOOLEAN
  member .singleRowSelection    is BOOLEAN
  member .labelVisibility       is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      gridControlDefaults
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridControlDefaults()

  -- Initialise Variables
  !this.columnExcelFilter   = false
  !this.outlookGroupStyle   = false
  !this.columnSummaries     = false
  !this.fixedHeaders        = false
  !this.fixedRows           = false
  !this.singleRowSelection  = false
  !this.labelVisibility     = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      data
--
-- Description: Returns the default data as a string array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .data() is ARRAY
  !data = ARRAY()
  !data.append(!this.columnExcelFilter)
  !data.append(!this.outlookGroupStyle)
  !data.append(!this.columnSummaries)
  !data.append(!this.fixedHeaders)
  !data.append(!this.fixedRows)
  !data.append(!this.singleRowSelection)
  !data.append(!this.labelVisibility)
  return !data
endmethod
-- End of method
