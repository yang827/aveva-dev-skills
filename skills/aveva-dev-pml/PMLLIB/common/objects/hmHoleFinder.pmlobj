--
--  Description:     -- Find Hole Management data --
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(DBREF)                       -
--  clear()                          -                   Reset this object
--  filterHolesFrom(ARRAY)           ARRAY               Get only HOLE associations from a list of Associations
--  getHolesFrom(DBREF)              ARRAY               Get only HOLE associations from a list of Associations
--  hmHoleFinder(DBREF)              -
--  hmHoleFinder(DBREF,DBREF)        -
--  result()                         ARRAY               Return number of elements in holes array
--  search()                         ARRAY               Search for holes common to the input list
--  size()                           REAL                Returns number of elements in holes array
--
------------------------------------------------------------------------
--

define object HMHOLEFINDER

  -- List of references provided to find common holes
  member .inputReferences      is ARRAY
  -- Common hole references
  member .holeAssocReferences  is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmHoleFinder
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element reference to locate hole
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmHoleFinder( !input is DBREF )

  -- Initialise Variables
  !this.inputReferences = ARRAY()
  if( not badref(!input) ) then
    !this.inputReferences[1] = !input
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      hmHoleFinder
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       First element reference to locate hole
--    2   R      DBREF       Second element reference to locate hole
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmHoleFinder( !input1 is DBREF,  !input2 is DBREF )

  -- Initialise Variables
  !this.inputReferences = ARRAY()
  if( not badref(!input1) ) then
    !this.inputReferences[1] = !input1
  endif
  if( not badref(!input2) ) then
    !this.inputReferences.append(!input2)
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add a new element to the list of elements to test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       New element reference to locate hole
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add( !input is DBREF )

  -- Initialise Variables
  if( not badref(!input) ) then
    !this.inputReferences.append(!input)
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Reset this object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Initialise Variables
  !this.inputReferences     = ARRAY()
  !this.holeAssocReferences = ARRAY()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      search
--
-- Description: Search for holes common to the input list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Search results
--
------------------------------------------------------------------------
define method .search() is ARRAY

  -- Initialise Variables
  !types[1] = 'ASSOC'
  !this.holeAssocReferences = ARRAY()

  do !item values !this.inputReferences

    skip if(!item.type eq 'WORL')
    !assocArray = ARRAY()
    -- First check for a member of a hole Association
    !assocRef = !!dtbOwnerOfTypes( !item, !types )
    if( not badref( !assocRef ) ) then
      -- get hole direct from ASSOC element
      !assocArray[1] = !assocRef
      !assocArray    = !this.filterHolesFrom(!assocArray)
    else
      -- get hole from association reference to item
      !assocArray = !this.getHolesFrom(!item)
    endif

    -- if there are no holes for this item, then search has failed
    if( !assocArray.empty() ) then
      !this.holeAssocReferences = ARRAY()
      break
    else
      -- check for common holes
      if( !this.holeAssocReferences.empty() ) then
        -- first time through
        !this.holeAssocReferences = !assocArray
      else
        !this.holeAssocReferences = !this.holeAssocReferences.intersect(!assocArray)
      endif
    endif
    -- if no common holes - finish search
    break if( !this.holeAssocReferences.empty() )

  enddo

  return !this.holeAssocReferences

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getHolesFrom
--
-- Description: Get only HOLE associations from a list of Associations
--              NOTE - CALLED RECURSIVELY
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      ASSOC element
-- Return:
--   [Data Type] [Description]
--    ARRAY     Array of Hole Associations
--
------------------------------------------------------------------------
define method .getHolesFrom(!item is DBREF) is ARRAY

  -- Try for direct membership of a hole
  !assocArray = !this.filterHolesFrom(!item.dassos)
  if( !assocArray.empty() ) then
    -- try for indirect membership of a hole
    !assocArray = !this.filterHolesFrom(!item.assos)
  endif
  if( !assocArray.empty() ) then
    -- Special cases where owner of item is considered
    if( !item.owner.hardType inset('BRAN','HPANEL','PANE') ) then
      -- NOTE RECURSIVE CALL
      !assocArray = !this.getHolesFrom(!item.owner)
    endif
  endif

  return !assocArray

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      filterHolesFrom
--
-- Description: Get only HOLE associations from a list of Associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      ASSOC element
-- Return:
--   [Data Type] [Description]
--    ARRAY     Array of Hole Associations
--
------------------------------------------------------------------------
define method .filterHolesFrom(!assocArray is ARRAY) is ARRAY

  !result = ARRAY()
  do !item values !assocArray

    skip if( !item.owner.purpose.neq('HOLE') )
    !result.append(!item)

  enddo

  return !result

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      size
--
-- Description: Returns number of elements in holes array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      ASSOC element
-- Return:
--   [Data Type] [Description]
--    REAL        Size of holes array
--
------------------------------------------------------------------------
define method .size() is REAL

  return ( !this.holeAssocReferences.size() )

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      result
--
-- Description: Return number of elements in holes array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of holes found
--
------------------------------------------------------------------------
define method .result() is ARRAY

  return !this.holeAssocReferences

endmethod
-- End of function definition
