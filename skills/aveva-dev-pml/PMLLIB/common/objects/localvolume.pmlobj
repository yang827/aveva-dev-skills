--
--
-- Description:
--   Local volume of an item
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  box()                            GMFBOX              Returns box definition of volume
--  localVolume(ARRAY,DBREF)         -                   Constructor
--  localVolume(DBREF,DBREF)         -                   Constructor, using passed
--  localVolume(POSITION,POSITION,DBREF) -                   Constructor
--  localVolume(STRING,DBREF)        -                   Constructor
--

define object LOCALVOLUME

  -- From position
  member .from is POSITION
  -- To position
  member .to   is POSITION

  -- Frame of reference
  member .wrt  is DBREF

endobject
-- End of object definition for LOCALVOLUME

------------------------------------------------------------------------
--
-- Method:      localVolume
--
-- Description: Constructor, using passed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element
--    2   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .localVolume(!item is DBREF, !wrt is DBREF)

  -- If a section (use start & end position)
  if(!item.hardType eq 'SCTN' and !wrt.hardType eq 'SCTN') then
    var !volume LVOL OF $!<item> WRT $!<wrt>
    handle any
      !!alert.error(!!error.text)
      return
    endhandle
--     !posStart  = !item.posStart.wrt(!wrt)
--     !posEnd    = !item.posEnd.wrt(!wrt)
--     !volume[1] = !posStart.east
--     !volume[2] = !posStart.north
--     !volume[3] = !posStart.up
--     !volume[4] = !posEnd.east
--     !volume[5] = !posEnd.north
--     !volume[6] = !posEnd.up

  -- Section/Panel Elements
  elseif (!item.owner.hardType inset('SCTN','PANE') and !wrt.owner.hardType inset('SCTN','PANE')) then

    !worldVolume = !item.wVolume
    handle any
      !from = !item.position
      !to   = !from

    elsehandle NONE
      if (!worldVolume.unset() ) then
          !from = !item.position
          !to   = !from
      else
          !from       = object POSITION('N0')
          !from.east  = !worldVolume[1]
          !from.north = !worldVolume[2]
          !from.up    = !worldVolume[3]
          !to         = object POSITION('N0')
          !to.east    = !worldVolume[4]
          !to.north   = !worldVolume[5]
          !to.up      = !worldVolume[6]
      endif
    endhandle
    !this.localVolume(!from, !to, world)
    return

  -- Get Volume of item
  else
    var !volume LVOL OF $!item WRT $!wrt
    handle any
      !errorMessage = !!error.text
      !worldVolume  = !item.wvol
      handle any
        !worldVolume  = ARRAY()
      endhandle
      if( !worldVolume.empty() ) then
        -- cannot get volume from this object - try for a POS
        !from = !item.position
        handle any
          -- this object has no position or volume - error
          !!alert.error(!errorMessage)
          return
        endhandle
        !to   = !from
      endif
      !this.localVolume(!from, !to, world)
      return
    endhandle

  endif

  -- Convert string into volume
  !this.localVolume(!volume, !wrt)

endmethod
-- End of method definition for .localVolume(DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:      localVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Volume as returned from Q LVOLUME OF <gid>
--    2   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .localVolume(!string is STRING, !wrt is DBREF)

  -- Initialise Variables
  if(!string eq 'unset' or !string.empty()) then
    return
  endif
  !array = !string.split()
  !this.from        = object POSITION()
  !this.from.origin = !wrt
  !this.from.east   = !array[1].real()
  !this.from.north  = !array[2].real()
  !this.from.up     = !array[3].real()
  !this.to          = object POSITION()
  !this.to.origin   = !wrt
  !this.to.east     = !array[4].real()
  !this.to.north    = !array[5].real()
  !this.to.up       = !array[6].real()
  !this.wrt         = !wrt

endmethod
-- End of method definition for .localVolume(STRING, DBREF)
------------------------------------------------------------------------
--
-- Method:      localVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Volume as returned from !x = lvol of <gid>
--    2   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .localVolume(!array is ARRAY, !wrt is DBREF)

  -- Initialise Variables
  !this.from        = object POSITION()
  !this.from.origin = !wrt
  !this.from.east   = !array[1]
  !this.from.north  = !array[2]
  !this.from.up     = !array[3]
  !this.to          = object POSITION()
  !this.to.origin   = !wrt
  !this.to.east     = !array[4]
  !this.to.north    = !array[5]
  !this.to.up       = !array[6]
  !this.wrt         = !wrt

endmethod
-- End of method definition for .localVolume(ARRAY, DBREF)

------------------------------------------------------------------------
--
-- Method:      localVolume
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    2   R      POSITION    To position
--    3   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .localVolume(!from is POSITION, !to is POSITION, !wrt is DBREF)

  -- Initialise Variables
  !this.from = !from.wrt(!wrt)
  !this.to   = !to.wrt(!wrt)
  !this.wrt  = !wrt

endmethod
-- End of method definition for .localVolume(POSITION, POSITION, DBREF)

-----------------------------------------------------------------------
--
-- Method:      box
--
-- Description:
--   Returns box definition of volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .box() is GMFBOX

  -- Initialise Variables
  !return             = object GMFBOX()

  -- Orientation of box
  !return.orientation = !this.wrt.orientation
  handle ANY
    !return.orientation = object ORIENTATION('Y is N')
  endhandle

  -- Position
  !return.position    = !this.from.midPoint(!this.to)

  -- Calculate XYZ lengths
  !return.xLength     = ABS(!this.from.east  - !this.to.east)
  !return.yLength     = ABS(!this.from.north - !this.to.north)
  !return.zLength     = ABS(!this.from.up    - !this.to.up)
  if(!return.xLength eq 0) then
    !return.xLength   = 50
  endif

  if(!return.yLength eq 0) then
    !return.yLength   = 50
  endif

  if(!return.zLength eq 0) then
    !return.zLength   = 50
  endif

  return !return

endmethod
-- End of method definition for .box() GMFBOX
