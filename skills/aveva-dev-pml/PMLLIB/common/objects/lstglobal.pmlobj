-- File:            lstglobal.pmlobj
--   Type:          Object Definition
--   Group:         Form List Maintenance
--     Keyword:     LST
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Oct 28 15:28:48 WAT 1997
--
--
-- Description:
-- Global Store for all "List" stores.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING)                      -                   Adds a Store Group to the Object
--  addLinkList(STRING,GADGET,BOOLEAN,ARRAY,ARRAY) -                   Adds link to list gadget in relevant store
--  addLinkMenu(STRING,MENU,BOOLEAN,ARRAY,ARRAY,STRING) -
--  exists(STRING)                   BOOLEAN             Checks if the passed store exists
--  list()                           -
--  number(STRING)                   REAL                Checks if the passed store exists
--  storedLists(STRING)              ARRAY
--
------------------------------------------------------------------------

-- Define object
define object LSTGLOBAL

  -- List Storage Identifiers (array of STRING)
  member .keys   is ARRAY

  -- Store areas (array of LSTSTORE)
  member .stores is ARRAY

endobject
-- End of object definition for LSTGLOBAL

------------------------------------------------------------------------
--
-- Method:      number
--
-- Description:
--   Checks if the passed store exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store ID
-- Return:
--   [Data Type] [Description]
--    REAL     True if store exits
--
------------------------------------------------------------------------

-- Define method
define method .number(!store is STRING) is REAL

  -- Check if there is already a store of the passed ID
  return !this.keys.findFirst(!store.upcase())

endmethod
-- End of method definition for .number(STRING) REAL

------------------------------------------------------------------------
--
-- Method:      exists
--
-- Description:
--   Checks if the passed store exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store ID
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if store exits
--
------------------------------------------------------------------------

-- Define method
define method .exists(!store is STRING) is BOOLEAN

  -- Check if there is already a store of the passed ID
  if(!this.keys.findFirst(!store.upcase()).set()) then
    return true
  else
    return false
  endif

endmethod
-- End of method definition for .exists(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description:
--   Adds a Store Group to the Object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store ID
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!store is STRING)

  -- Check if there is already a store of the passed ID
  if(!this.exists(!store).not()) then

    -- Define ID
    !this.keys.append(!store.upcase())

    -- Define Store
    !lstStore        = object LSTSTORE()

    -- Define Store
    -- Standard Database Reference Store
    if(!store.upcase() eq 'DBREFS') then
      !lstStore.title  = 'General DB Reference Store'
      !lstStore.type   = 'References'

    -- Any other store
    else
      !lstStore.title  = !store
      !lstStore.type   = !store
    endif

    !this.stores.append(!lstStore)

  endif

endmethod
-- End of method definition for .add(STRING)

------------------------------------------------------------------------
--
-- Method:      addLinkList
--
-- Description:
--   Adds link to list gadget in relevant store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store Reference
--    2   R      GADGET      List gadget being linked
--    3   R      BOOLEAN     Do we show empty lists in gadget
--    4   R      ARRAY       Constant Display Text
--    5   R      ARRAY       Replacement Text for Display Test
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addLinkList(!store is STRING, !gadget is GADGET, !empty is BOOLEAN, !dText is ARRAY, !rText is ARRAY)

  -- Add List link to store
  !this.stores[!this.keys.findFirst(!store.upcase())].addLinkList(!gadget, !empty, !dText, !rText)

endmethod
-- End of method definition for .addLinkList(STRING, GADGET, BOOLEAN, ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method:      addLinkMenu
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store Reference
--    2   R      MENU        Menu being linked
--    3   R      BOOLEAN     Do we show empty lists in gadget
--    4   R      ARRAY       Constant Display Text
--    5   R      ARRAY       Replacement Text for Display Test
--    6   R      STRING      Menu callback
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addLinkMenu(!store is STRING, !menu is MENU, !empty is BOOLEAN, !dText is ARRAY, !rText is ARRAY, !menuCallback is STRING)

  -- Add List link to store
  !this.stores[!this.keys.findFirst(!store.upcase())].addLinkMenu(!menu, !empty, !dText, !rText, !menuCallback)

endmethod
-- End of method definition for .addLinkMenu(STRING, MENU, BOOLEAN, ARRAY, ARRAY, STRING)

------------------------------------------------------------------------
--
-- Method:      storedLists
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store Key
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of lists for the store
--
------------------------------------------------------------------------

-- Define method
define method .storedLists(!store is STRING) is ARRAY

  if(!this.exists(!store)) then

    -- Return List from store
    return !this.stores[!this.number(!store)].lists

  -- Return empty array
  else
    return ARRAY()
  endif

endmethod
-- End of method definition for .storedLists(STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      list
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .list()

  QUERY var !this.keys

endmethod
-- End of method definition for .list()
