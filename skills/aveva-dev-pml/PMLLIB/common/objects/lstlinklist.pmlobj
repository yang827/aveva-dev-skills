--
--
-- Description:
-- List Gadget Link (Associations), This object must only contain list
-- or option gadgets only.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(GADGET,BOOLEAN,ARRAY,ARRAY)  -                   Add List gadget data to list object
--  update(ARRAY)                    -                   Update Gadget with list data
--
------------------------------------------------------------------------

-- Define object
define object LSTLINKLIST

  -- List/Option Gadget Name
  member .gadget       is GADGET

  -- Show empty lists
  member .showEmpty    is BOOLEAN

   -- Addition to list, other than list members (add before list members)
    -- Display Text
    member .dText      is ARRAY
    -- Replacement Text
    member .rText      is ARRAY

endobject
-- End of object definition for LSTLINKLIST

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description:
--   Add List gadget data to list object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List Gadget Name
--    2   R      BOOLEAN     Do we show empty list in gadget
--    3   R      ARRAY       Addition Display Test
--    4   R      ARRAY       Replacement Text for Display Test
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!lGadget is GADGET, !empty is BOOLEAN, !lDtext is ARRAY, !lRtext is ARRAY)

  -- Define Data
  !this.gadget    = !lGadget
  !this.showEmpty = !empty
  !this.dText     = !lDtext
  !this.rText     = !lRtext

endmethod
-- End of method definition for .add(GADGET, BOOLEAN, ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Update Gadget with list data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of LST objects
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update(!lists is ARRAY)

  -- Get current selection
  !currentSelection = !this.gadget.selection('DTEXT')

  -- Build List Data
  !display  = !this.dText
  !replace  = !this.rText

  -- Get indices of available lists
  if(!lists.set()) then

    -- Do we include empty list
    if(!this.showEmpty) then
      !block    = object BLOCK('!lists[!evalIndex].title')
      !newList  = !lists.evaluate(!block)
      !block    = object BLOCK('''LIST\'' & !lists[!evalIndex].title')
      !rNewList = !lists.evaluate(!block)

    -- Exclude empty list
    else
      !newList  = ARRAY()
      !rNewList = ARRAY()

      do !i indices !lists

        skip if(!lists[!i].members.unset())
        !newList.append(!lists[!i].title)
        !rNewList.append('LIST\' & !lists[!i].title)
      enddo

    endif

    -- Populate Gadget
    !display.appendArray(!newList)
    !replace.appendArray(!rNewList)
  endif

  -- Empty List
  if(!display.unset()) then

    !temp[1]            = 'No Lists Defined'
    !tempNumber[1]      = '0'
    !this.gadget.dText  = !temp
    !this.gadget.rText  = !tempNumber

    -- Make gadget inactive
    !this.gadget.active = false

  -- Populate with Data
  else
    -- Make gadget active
    !this.gadget.active = true

    !this.gadget.dText  = !display
    !this.gadget.rText  = !replace

    -- Try and reselect the last selection
    !this.gadget.select('DTEXT',!currentSelection)
    handle any

    endhandle

  endif

endmethod
-- End of method definition for .update(ARRAY)
