-- Created:         Fri Oct 24 11:42:27 WAT 1997
--
--
-- Description:
-- List Gadget Link (Associations), This object must only contain list
-- or option gadgets only.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(MENU,BOOLEAN,ARRAY,ARRAY,STRING) -                   Add List gadget data to list object
--  update(ARRAY)                    -                   Update menu with list data
--
------------------------------------------------------------------------

-- Define object
define object LSTLINKMENU

  -- List/Option Gadget Name
  member .menu         is MENU

  -- Show empty lists
  member .showEmpty    is BOOLEAN

  -- Addition to list, other than list members (add before list members)
    -- Display Text
    member .dText      is ARRAY
    -- Replacement Text
    member .rText      is ARRAY

 -- Callback
  member .callback     is STRING

endobject
-- End of object definition for LSTLINKMENU

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description:
--   Add List gadget data to list object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu Gadget Name
--    2   R      BOOLEAN     Do we show empty list in menu
--    3   R      ARRAY       Addition Display Test
--    4   R      ARRAY       Replacement Text for Display Test
--    5   R      STRING      Callback on selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!lMenu is MENU, !empty is BOOLEAN, !lDtext is ARRAY, !lRtext is ARRAY, !menuCallback is STRING)

  -- Define Data
  !this.menu      = !lMenu
  !this.showEmpty = !empty
  !this.dText     = !lDtext
  !this.rText     = !lRtext
  !this.callback  = !menuCallback

endmethod
-- End of method definition for .add(MENU, BOOLEAN, ARRAY, ARRAY, STRING)

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Update menu with list data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List
-- Return:
--   [Data Type] [Description]
--    Add              Add menu data to link object
--    Update           Update menu with list data
--
------------------------------------------------------------------------

-- Define method
define method .update(!lists is ARRAY)

 -- Build List Data
  !display  = !this.dText
  !replace  = !this.rText

  -- Empty List
  if(!lists.set()) then

    -- Do we include empty list
    if(!this.showEmpty) then
      !block    = object BLOCK('!lists[!evalIndex].title')
      !newList  = !lists.evaluate(!block)
      !block    = object BLOCK('''LIST\'' & !lists[!evalIndex].title')
      !rNewList = !lists.evaluate(!block)

    -- Exclude empty list
    else
      !newList  = ARRAY()
      !rNewList = ARRAY()

      do !i indices !lists

        skip if(!lists[!i].members.unset())
        !newList.append(!lists[!i].title)
        !rNewList.append('LIST\' & !lists[!i].title)
      enddo

    endif

    -- Populate Gadget
    !display.appendArray(!newList)
    !replace.appendArray(!rNewList)

  endif

  -- Empty List
  if(!display.unset()) then

    !modMenu = !this.menu
    !modMenu.clear()
    !modMenu.add('CALLBACK','No Lists Defined','')
    !modMenu.setActive('No Lists Defined', false)

  -- Populate with Data
  else

    !modMenu = !this.menu
    !modMenu.clear()
    do !i indices !display
      !modMenu.add('CALLBACK',!display[!i],!this.callback & '''' & !replace[!i] & ''')')
    enddo

  endif

endmethod
-- End of method definition for .update(ARRAY)
