-- Description:
-- standard element list menus
--
define object LSTSTANDARDMENU
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCe()                          -
--  addCeMem()                       -
--  addItems(ARRAY)                  -
--  addPicked(DBREF)                 -                   Add Picked element to the List and Display
--  display()                        -
--  listLst(STRING,STRING)           -                   Maintain the list of elements
--  listsAvailable()                 BOOLEAN
--  lststandardmenu(FORM,GADGET)     -
--  pick(MENU,STRING)                -
--  pullDowns()                      -                   Maintain the pull-downs
--  removeAll()                      -
--  removeCe()                       -
--  removeCeMem()                    -
--  removePicked(DBREF)              -                   Remove Picked element from the List and unhighlight
--  removeSelected()                 -
--  selectMember(GADGET,STRING)      -
--  shift(STRING)                    -
--  standardAdd(STRING,STRING)       -
--  standardRemove(STRING,STRING)    -
--  update(MENU)                     -
--  updateAddListMenu()              -
--  updateRemoveListMenu()           -
--
--------------------------------------------------------------------
--
-- This is an object to allow you to control a list of PDMS ELEMENTS
-- in a LIST gadget on your form.

-- The list of elements will be controlled via "Add" and "Remove" menus
-- on the menu bar.

-- This is an effort to rationalise the many element list
-- control schemes throughout the PDMS appWare.

-- This could save you writing a whole bunch of code.

-- The control logic has been ripped from the "DB Listings" form and
-- packaged in a more general form.

--  How to use this object -
----------------------------
-- 0) Look at example FORM commented-out at the
--    bottom of this file.  It is fairly simple.

-- i ) First of all you will have to set up your form
--    and include on it a LIST (multi) gadget as a member.
--    Also you should include  lststandardmenu object as a member.
--    This object MUST be named ".stanMenu"
-- e.g.
--      list   .elementList 'Elems' at xmin ymin multi width 40 height 10
--      member .stanMenu is lststandardmenu

-- ii)  In the form's default constructor you should
--      store the FORM and LIST gadget into your LSTSTANDARDMENU
--      form member. Thus-
--
--      !this.stanMenu = object lststandardmenu(!this,!this.elementList)

-- iii) In the form's default constructor you will have to define
--     "add" and "remove" menu headings as usual on the bar-menu
-- e.g.

--      !bar.add('Add','addMenu')
--      !bar.add('Remove','removeMenu')

-- iv)   After you have defined all your menu-bar headings
--       you should call these two methods.  Probably still
--       in your form's default constructor.  These will define the
--       contents of the Add and Remove menus, and set up all
--       the callbacks.

--      !this.stanMenu.standardAdd('Add','addMenu')
--      !this.stanMenu.standardRemove('Remove','removeMenu')

-- NB input strings should be the same as the bar-menu definition

--  v) Define the contents of any further menus you have
--     defined on your form.

-- You can find an example FORM commented-out at the bottom of this file.
----------------------------------------------------------------------------

  member .theForm           is FORM
  member .theList           is GADGET
  member .elements          is ARRAY
  member .allowedTypes      is ARRAY
  member .allowedTypesError is STRING
  member .addMenuName       is STRING
  member .removeMenuName    is STRING
  member .addMenuHeading    is STRING
  member .removeMenuHeading is STRING
endobject
-- End of object definition for LSTSTANDARDMENU

----------------------------
define method .lststandardmenu(!inForm is FORM, !inList is GADGET)
  !this.theForm = !inForm
  !this.theList = !inList
  !this.theList.callBack = '!this.stanMenu.selectMember('
endmethod
-- End of method definition for .lststandardmenu(FORM, GADGET)
----------------------------------
define method .standardAdd(!menuHeading is STRING, !menuName is STRING)
-----------------------------------------------
-- method to add a "Add to List" menu to the menu-bar
------------------------------------------------
   !this.addMenuName    = !menuName
   !this.addMenuHeading = !menuHeading

    !menu = !this.theForm.newMenu(!menuName)

    !menu.add('CALLBACK', 'CE',         '!this.stanMenu.addCe()')
    !menu.add('CALLBACK', 'CE Members', '!this.stanMenu.addCeMem()')

    if (!this.listsAvailable()) then
      !menu.add('separator')
    endif

    if ( !!module().appName.upcase() eq 'DESIGN') then
     !menu.add('TOGGLE', 'Pick',       '!this.stanMenu.pick(')
    endif

    if (!this.listsAvailable()) then
      !menu.add('MENU',     'List',      'addListMenu')

      !menu = !this.theForm.newMenu('addListMenu')
      !this.update(!this.theForm.addListMenu)
   endif
endmethod
-- End of method definition for .standardAdd(STRING, STRING)


define method .standardRemove(!menuHeading is STRING, !menuName is STRING)
--------------------------------------------
-- Method to add a Remove menu to a menu-bar
----------------------------------------------

    !this.removeMenuName    = !menuName
    !this.removeMenuHeading = !menuHeading

    !menu = !this.theForm.newMenu(!menuName)

    !menu.add('CALLBACK', 'All',        '!this.stanMenu.removeAll()')
    !menu.add('CALLBACK', 'Selected',   '!this.stanMenu.removeSelected()')
    !menu.add('separator')
    !menu.add('CALLBACK', 'CE',         '!this.stanMenu.removeCe()')
    !menu.add('CALLBACK', 'CE Members', '!this.stanMenu.removeCeMem()')

    if (!this.listsAvailable()) then
      !menu.add('separator')
    endif

    if ( !!module().appName.upcase() eq 'DESIGN') then
     !menu.add('TOGGLE', 'Pick',   '!this.stanMenu.pick(')
    endif

    if (!this.listsAvailable()) then
     !menu.add('MENU',     'List',  'removeListMenu')
--     !menu.CALLBACK = '!this.stanMenu.update(!this.removeListMenu)'
     !menu = !this.theForm.newMenu('removeListMenu')
     !this.update(!this.theForm.removeListMenu)
    endif

    !this.pullDowns()
endmethod
-- End of method definition for .standardRemove(STRING, STRING)
----------------------------

define method .addCe()
  -- Add ce to list

  if (!this.allowedTypes.size() gt 0) then
    var !ceType TYPE
    !i = !this.allowedTypes.findFirst(!ceType)
    if (!i.unset()) then
       return error 2 |$!this.allowedTypesError|
    endif
  endif

  if (!this.theList.pickedField lt 1 or !this.theList.pickedField ge !this.theList.rText.size()) then
     !this.elements.append(!!ce)
  else
    !nextField = !this.theList.pickedField + 1
    !this.elements.insert(!nextField, !!ce)
  endif

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addCe()
---------------------------------
define method .addItems(!items is ARRAY)
-- add array of items to the list

  !items.unique()

  if (!items.size() eq 0) then
    return
  endif

  !checkType = (!this.allowedTypes.size() gt 0)

  !nAppend = 0
  !ele = object DBREF()
  do !x values !items

    !ele = !x.dbref()
     handle any
       skip
     endhandle

    if (!checkType) then
      !eleType = TYPE OF $!ele
      !i = !this.allowedTypes.findFirst(!eleType)
      if (!i.unset()) then
         skip
       endif
    endif

    !this.elements.append(!ele)
    !nAppend = !nAppend + 1
  enddo

  if (!checkType and !nAppend eq 0) then
    return error 2 |$!this.allowedTypesError|
  else
    !this.display()
  endif
endmethod
-- End of method definition for .addItems(ARRAY)
-----------------------------
define method .addCeMem()
-- add the members of the CE to the list
  !ceMem = !!ce.members
  if (!ceMem.size() eq 0) then
    return
  endif


-- loop over members and keep the allowed
-- members in an array
  if (!this.allowedTypes.size() gt 0) then
   !ceMemCopy = !ceMem
   !ceMem.clear()
  do !ele values !ceMemCopy
     !eleType = TYPE OF $!ele
     !i = !this.allowedTypes.findFirst(!eleType)
     if (!i.set()) then
       !ceMem.append(!ele)
     endif
   enddo

  endif
--
  -- Add ce members to list
  if (!this.theList.pickedField lt 1 or !this.theList.pickedField ge !this.theList.rText.size()) then
    !this.elements.appendArray(!ceMem)
  else
    !nextField = !this.theList.pickedField + 1
    !this.elements.insertArray(!nextField, !ceMem)
  endif

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addCeMem()

----------------------------------------
define method .display()
-- redisplay the list

  -- Re-build list
  if(!this.elements.set()) then

      -- Remove Duplications
    !this.elements.unique()

      do !indx indices !this.elements
        !listStr[!indx] = !this.elements[!indx].string()
        !listNam[!indx] = !listStr[!indx].dbref().fullName
      enddo

      !this.theList.dText = !listNam
      !this.theList.rText = !listStr

  else
    !this.theList.dText = ARRAY()

  endif

  -- Maintain Pull-Downs for current list
    !this.pullDowns()
  -- Maintain If Screen Gadgets
--  !this.ifScreen()

endmethod
-- End of method definition for .display()

----- REMOVE METHODS ------------------

define method .removeCe()
------------------------------------------------
-- remove current element from the element list
------------------------------------------------
    -- If passed CE exists in list, the remove it
  !index = !this.elements.findFirst(!!ce)
  if(!index.set()) then
    !this.elements[!index].delete()
  endif

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .removeCe()

define method .removeCeMem()
-------------------------------------------------------
-- remove the members of the ce from the element list
--------------------------------------------------------
  -- Get members of Item
  !ceMembers = !!ce.members

  -- Difference
  !newList     = !this.elements.difference(!ceMembers)
  !this.elements = !newList

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeCeMem()

define method .removeAll()
--------------------------------------------------------
-- remove all elements from the element list
--------------------------------------------------------
  -- Remove all entries List
  !this.elements.clear()

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeAll()

define method .removeSelected()
-----------------------------------------------------
-- remove the selected elements from the element list
----------------------------------------------------0
  -- Check there are some selections
  if(!this.theList.selection().unset()) then
    !!messageFile.warning(149,006)
    return
  endif

  -- Remove entries List
  do !i values !this.theList.val
    !this.elements[!i].delete()
  enddo

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeSelected()

define method .selectMember(!listGadget is GADGET, !select is STRING)
---------------------------------------------------------
-- change the CE to the picked element in the list
--------------------------------------------------------
  -- If select, then move to item
  if(!select.upcase() eq 'SELECT') then
    !picked  = !listGadget.pickedField
    !!ce = !this.theList.rText[!picked].dbref()
    handle any
    !!alert.error(!!error.text)
    endhandle
  endif

endmethod
-- End of method definition for .selectMember(GADGET, STRING)
------------------------------------------------------------------------
--
-- Method:      addPicked
--
-- Description:
--   Add Picked element to the List and Display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option  = !menu.pickedField

if(!option.upcase() eq 'PICK') then

  if(!selected eq 'SELECT') then

    -- Define edg Packet for picking elements
    !packet             = object EDGPACKET()

    !desc = 'Output report packet'
    !!edgCntrl.remove(!desc)

    if (!menu.name().upcase() eq !this.addMenuName.upcase()) then
      !packet.elementPick('Pick element to Add')
      !packet.remove      = false
      !packet.description = !desc
      !packet.action  =  '!!' & !this.theForm.name() & |.stanMenu.addPicked(!this.return[1].item)|
      !command = '!this.theForm.' & !this.removeMenuName & |.select('Pick',false)|
      $!command
      !packet.close       =  '!!' & !this.theForm.name() & '.' & !this.addMenuName & |.select('Pick',false)|
    else
      !packet.elementPick('Pick element to Remove')
      !packet.remove      = false
      !packet.description = !desc
      !packet.action  =  '!!' & !this.theForm.name() & |.stanMenu.removePicked(!this.return[1].item)|
      !command = '!this.theForm.' & !this.addMenuName & |.select('Pick',false)|
      $!command
      !packet.close       =  '!!' & !this.theForm.name() & '.' & !this.removeMenuName & |.select('Pick',false)|
    endif

    !!edgCntrl.add(!packet)

  else
    !!edgCntrl.remove('Output report packet')
  endif

endif

endmethod
-- End of method definition for .pick(MENU, STRING)
------------------------------------------------------------------------
--
-- Method:      addPicked
--
-- Description:
--   Add Picked element to the List and Display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addPicked(!picked is DBREF)

  -- Maintain the array of picks

  -- If the picked element is not already in the array then add it
  if (!this.elements.findFirst(!picked).unset()) then

    -- Add item to list
    if (!this.theList.pickedField lt 1 or !this.theList.pickedField ge !this.theList.rText.size()) then
    !this.elements.append(!picked)
    else
      !nextField = !this.theList.pickedField + 1
      !this.elements.insert(!nextField, !picked)
    endif

    -- Enhance Colour of picked element
    !colour = !!gphColOpt.highlight.key()
    ENHANCE $!picked COLOUR $!colour

  else
    -- If the picked element is already in the array then remove it
    !this.elements.remove(!this.elements.findFirst(!picked))
    UNENHANCE $!picked

  endif

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addPicked(DBREF)
------------------------------------------------------------------------
--
-- Method:      removePicked
--
-- Description:
--   Remove Picked element from the List and unhighlight
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removePicked(!picked is DBREF)

   -- If passed item exists in list, the remove it
  !index = !this.elements.findFirst(!picked)
  if(!index.set()) then
    !this.elements[!index].delete()
    UNENHANCE $!picked
  endif


  -- Re Display
  !this.display()

endmethod
-- End of method definition for .removePicked(DBREF)

-- Define method
define method .updateAddListMenu()
-- updates the menu of PDMS Lists under the "Add" menu
  !this.update(!this.theForm.addListMenu)
endmethod
-- End of method definition for .updateAddListMenu()

-- Define method
-- updates the menu of PDMS Lists under the "Remove" menu
define method .updateRemoveListMenu()
  !this.update(!this.theForm.removeListMenu)
endmethod
-- End of method definition for .updateRemoveListMenu()

-- Define method
define method .update(!menu is MENU)
  !option = ''
  !menuName = ''
  if (!menu.name().upcase() eq 'ADDLISTMENU') then
   !option = 'ADD'
   !menuName = !this.addMenuName
  else
   !option = 'REMOVE'
   !menuName = !this.removeMenuName
  endif

  if (!this.listsAvailable()) then
      !listForm = !!cdcList
      !menu.clear()
    do !i indices !listForm.name.dText
      !menu.add('CALLBACK', '$!listForm.name.dText[$!i]', '!this.stanMenu.listLst(|$!option| , |$!i|)')
    enddo
    !command = '!this.theForm.' & !menuName & |.setActive('List', true)|
    $!command
  else
    !menu.clear()
    !menu.add('CALLBACK', 'No list', '')
    !command = '!this.theForm.' & !menuName & |.setActive('List', false)|
    $!command
  endif

-- Activate the List menu as required
   !menu.setActive('No list', false)
    handle any
    endhandle

endmethod
-- End of method definition for .update(MENU)
------------------------------------------------------------------------
--
-- Method:      listLst
--
-- Description:
--   Maintain the list of elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       ADD or REMOVE
--    2   R      STRING       list name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

define method .listLst(!option is STRING, !listData is STRING)

    !entries = ARRAY()

    -- Get list
    !entriesStr  = '!!' & 'CDLIST' & !listData

    do !i indices $!entriesStr
      !entries[!i] = $!entriesStr[$!i].dbref()
    enddo

     !checkType = (!this.allowedTypes.size() gt 0)
     if (!checkType and !option eq 'ADD') then
--        strip out disallowed types before adding to element list
         !entriesCopy = !entries
         !entries.clear()
      do !ele values !entriesCopy
         !eleType = TYPE OF $!ele
         !j = !this.allowedTypes.findFirst(!eleType)
         if (!j.set()) then
           !entries.append(!ele)
         endif
      enddo
     endif

    -- Option
    if(!option.upcase() eq 'ADD') then
      -- Add item to list
      if (!this.theList.pickedField lt 1 or !this.theList.pickedField ge !this.theList.rText.size()) then
      !this.elements.appendArray(!entries)
      else
        !nextField = !this.theList.pickedField + 1
        !this.elements.insertArray(!nextField, !entries)
      endif

      -- Re Display
      !this.display()

    elseif (!option.upcase() eq 'REMOVE') then

      -- Difference
      !newList     = !this.elements.difference(!entries)
      !this.elements = !newList

      -- Display
      !this.display()

    endif

endmethod
-- End of method definition for .listLst(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      pullDowns
--
-- Description:
--   Maintain the pull-downs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pullDowns()

  !bar  = !this.theForm.bar
  !xx =  '!!' & !this.theForm.name() & '.' & !this.removeMenuName
  !menu = $!xx

  -- If there are no members, then grey-out remove options

  if(!this.theList.dText.size() eq 0 ) then
    !bar.setActive(!this.removeMenuHeading, false)
    !menu.setActive('All',        false)
    !menu.setActive('Selected',   false)
    !menu.setActive('CE',         false)
    !menu.setActive('CE Members', false)
     if (!!module().appName.upcase() eq 'DESIGN') then
       !menu.setActive('Pick',       false)
     endif
    if (!this.listsAvailable()) then
      !menu.setActive('List', false)
    endif
  else
    !bar.setActive(!this.removeMenuHeading, true)
    !menu.setActive('All',        true)
    !menu.setActive('Selected',   true)
    !menu.setActive('CE',         true)
    !menu.setActive('CE Members', true)
    if (!!module().appName.upcase() eq 'DESIGN') then
      !menu.setActive('Pick',       true)
    endif
    if (!this.listsAvailable()) then
      !menu.setActive('List', true)
    endif
  endif

endmethod
-- End of method definition for .pullDowns()

define method .listsAvailable() is BOOLEAN
--------------------------
-- Method .listsAvailable
--   returns false for graphical modules
--  for which element lists are unavailable
--------------------------
  !m = !!module().appName.upcase()

  if (!m eq 'MONITOR' or !m eq 'ADMIN' or !m eq 'ISODRAFT' or !m eq 'PARAGON' ) then
    return false
  else
    return true
  endif

endmethod
-- End of method definition for .listsAvailable() BOOLEAN
-------------------------------
-- method to shift the selected list element up
-- or down the list
------------------------------
define method .shift(!shiftDir is STRING)

!selArray = !this.theList.val
if (!selArray.size() eq 0) then
  return
endif
!s = !selArray.last()

-- !this.theList.val.clearSelection()
-- !this.theList.val.append(!s)

if( !s.unset() ) then
  return
endif

!l = !this.elements
!tmp = !l[$!s]

if( !shiftDir eq 'UP' ) then
  if( !s eq 1 ) then
    return
  endif
  !l[$!s] = !l[ $!s - 1 ]
  !l[ $!s - 1 ] = !tmp
else
  if( !s eq !l.size() ) then
    return
  endif
  !l[$!s] = !l[ $!s + 1 ]
  !l[ $!s + 1 ] = $!tmp
endif

!this.elements = !l
!x[1] = '$!tmp'
!this.display()
!this.theList.select('Rtext',!x)


-- _BSLIST.select('RText','$!tmp')
endmethod
-- End of method definition for .shift(STRING)
