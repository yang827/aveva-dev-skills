--   Group:         Form List Maintenance
--     Keyword:     LST
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Oct 24 11:31:28 WAT 1997
--
--
-- Description:
--   List Store
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addLinkList(GADGET,BOOLEAN,ARRAY,ARRAY) -                   Add the link to the store
--  addLinkMenu(MENU,BOOLEAN,ARRAY,ARRAY,STRING) -                   Add the link to the store
--  addList(STRING,ARRAY)            -                   Add the list to the store
--  defined()                        ARRAY
--  emptyList()                      -                   Empty the contents of the passed list
--  exists(STRING)                   BOOLEAN             Check if list, of passed title, exists in the current available
--  listNumber(STRING)               REAL                Returns the Lists index for the passed list tag
--  members(STRING)                  ARRAY               Return the members of the passed list
--  removeList(STRING)               -                   Add the list to the store
--  replaceList(STRING,ARRAY)        -                   Replace the members of a list
--  update()                         -                   Update all linked form gadgets with the current lists
--
------------------------------------------------------------------------

-- Define object
define object LSTSTORE

  -- Title
  member .title        is STRING

  -- Type of List
  member .type         is STRING

  -- List of Associations (array of LSTLINKLIST/LSTLINKMENU)
  member .associations is ARRAY

  -- List of Lists objects (array of LST)
  member .lists        is ARRAY

endobject
-- End of object definition for LSTSTORE

------------------------------------------------------------------------
--
-- Method:      exists
--
-- Description:
--   Check if list, of passed title, exists in the current available
--   lists. Title check is case insensitive
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Checks if list already in store
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is already in store
--
------------------------------------------------------------------------

-- Define method
define method .exists(!tag is STRING) is BOOLEAN

  if(!this.listNumber(!tag).set()) then
    return true
  else
    return false
  endif

endmethod
-- End of method definition for .exists(STRING) BOOLEAN
------------------------------------------------------------------------
--
-- Method:      listNumber
--
-- Description:
--   Returns the Lists index for the passed list tag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List Tag
-- Return:
--   [Data Type] [Description]
--    REAL        Index of list in list store
--
------------------------------------------------------------------------

-- Define method
define method .listNumber(!tag is STRING) is REAL

  -- Get all available list
  !availableLists = !this.defined()

  -- If there are no list defined. then return false
  if(!availableLists.unset()) then
    return REAL()
  endif

  -- Upcase all tags and compare against passed tag
  !block    = object BLOCK('!availableLists[!evalIndex].title.upcase()')
  !testList = !availableLists.evaluate(!block)
  return !testList.findFirst(!tag.subString(1,20).upcase())

endmethod
-- End of method definition for .listNumber(STRING) REAL

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Update all linked form gadgets with the current lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Get Available Lists
  !availableLists = !this.defined()

  -- Loop through all associations
  do !linkage values !this.associations
    !linkage.update(!availableLists)
  enddo

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      addList
--
-- Description:
--   Add the list to the store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List Title
--    2   R      ARRAY       List contents (members)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addList(!tag is STRING, !members is ARRAY)

  -- Check if list already exists
  if(!this.exists(!tag)) then

    !!messageFile.warning(149, 003, !tag)

  -- Define New List
  else
    !list          = object LST()
    !list.title    = !tag.subString(1,20)
    !list.members  = !members
    !this.lists.append(!list)

    !this.update()
  endif

endmethod
-- End of method definition for .addList(STRING, ARRAY)

------------------------------------------------------------------------
--
-- Method:      removeList
--
-- Description:
--   Add the list to the store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List Title
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeList(!tag is STRING)

 -- Check if list already exists
  if(!this.exists(!tag).not()) then

    !!messageFile.warning(149, 002, !tag)

  -- Remove List from Store
  else
    !this.lists[!this.listNumber(!tag)].delete()
    !this.lists.compress()
    !this.update()
  endif

endmethod
-- End of method definition for .removeList(STRING)

------------------------------------------------------------------------
--
-- Method:      addLinkList
--
-- Description:
--   Add the link to the store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to be linked
--    2   R      BOOLEAN     Do we show empty lists in gadget
--    3   R      ARRAY       Display text to be added to list
--    4   R      ARRAY       Replacement text to DText
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addLinkList(!gadget is GADGET, !empty is BOOLEAN, !dText is ARRAY, !rText is ARRAY)

  -- Define an entry in the Associations list
  !linkList   = object LSTLINKLIST()
  !linkList.add(!gadget, !empty, !dText, !rText)
  !this.associations.append(!linkList)

  -- Update the list gadget just added
  !this.associations[!this.associations.size()].update(!this.defined())

endmethod
-- End of method definition for .addLinkList(GADGET, BOOLEAN, ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method:      addLinkMenu
--
-- Description:
--   Add the link to the store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to be linked
--    2   R      BOOLEAN     Do we show empty lists in gadget
--    3   R      ARRAY       Display text to be added to list
--    4   R      ARRAY       Replacement text to DText
--    5   R      STRING      Callback for menu
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addLinkMenu(!menu is MENU, !empty is BOOLEAN, !dText is ARRAY, !rText is ARRAY, !menuCallback is STRING)

  -- Define an entry in the Associations list
  !linkMenu   = object LSTLINKMENU()
  !linkMenu.add(!menu, !empty, !dText, !rText, !menuCallback)
  !this.associations.append(!linkMenu)

  -- Update the list gadget just added
  !this.associations[!this.associations.size()].update(!this.defined())

endmethod
-- End of method definition for .addLinkMenu(MENU, BOOLEAN, ARRAY, ARRAY, STRING)

------------------------------------------------------------------------
--
-- Method:      replaceList
--
-- Description:
--   Replace the members of a list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List Title
--    2   R      ARRAY       List contents (members)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .replaceList(!tag is STRING, !members is ARRAY)

  -- Get List Number
  !listNumber = !this.listNumber(!tag)

  -- Replace list data
  if(!listNumber.set()) then
    !this.lists[!listNumber].members = !members
  else
    !!messageFile.warning(149, 099, !tag)
  endif

endmethod
-- End of method definition for .replaceList(STRING, ARRAY)

------------------------------------------------------------------------
--
-- Method:      emptyList
--
-- Description:
--   Empty the contents of the passed list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .emptyList()

  -- If ID exists in list, then use it
  if(defined(!index)) then

    !this.lists[!index].members.clear()
    return true

  endif

  return false

endmethod
-- End of method definition for .emptyList()

------------------------------------------------------------------------
--
-- Method:      define
--
-- Description:
--   Returns the currently defined lists as an array (ie .lists is
--   passed back)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       All defined list objects
--
------------------------------------------------------------------------

-- Define method
define method .defined() is ARRAY

   return !this.lists

endmethod
-- End of method definition for .defined() ARRAY

-----------------------------------------------------------------------
--
-- Method:      members
--
-- Description:
--   Return the members of the passed list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List tag
-- Return:
--   [Data Type] [Description]
--    ARRAY       All defined list objects
--
------------------------------------------------------------------------

-- Define method
define method .members(!tag is STRING) is ARRAY

  -- Get list
  !number = !this.listNumber(!tag)

  return !this.lists[!number].members

endmethod
-- End of method definition for .members(STRING) ARRAY
