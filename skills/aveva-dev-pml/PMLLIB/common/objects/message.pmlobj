-- Define object
define object MESSAGE

  -- Format for message
  member .format          is BLOCK
  -- Description
  member .description     is STRING
  -- Detail (developers note)
  member .detail          is STRING
  -- Application Number
  member .number          is REAL

endobject
-- End of object definition for MESSAGE
