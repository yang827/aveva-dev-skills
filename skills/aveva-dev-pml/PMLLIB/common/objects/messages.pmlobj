-- Define object
define object MESSAGES

  -- Application Description
  member .description     is STRING
  -- Application Number
  member .number          is REAL
  -- List of messages (array of MESSAGE objects)
  member .message         is ARRAY

endobject
-- End of object definition for MESSAGES
