--
-- File:            module.pmlobj
--   Type:          Object Definition
--   Group:         Checking routines
--     Keyword:     GENERAL
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Feb 24 12:03:59 GMT 1997
--
--
-- Description:
-- Contains module information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  module()                         -                   Constructor method
--

-- Define object
define object MODULE

  -- Module Name (return from product)
  member .name          is STRING
  -- Appware Module Name (nice name format)
  member .appName       is STRING
  -- Appware Module Name (short key used for files, etc.)
  member .appKey        is STRING
  -- Module Key (short key used to know the real module in)
  member .modKey        is STRING
  -- Module Company
  member .company       is STRING
  -- Module Copyright
  member .copyright     is STRING
  -- Module Status
  member .status        is STRING
  -- Version
  member .version       is STRING
  -- Compile OS
  member .compileOS     is STRING
  -- Compile Date
  member .compileDate   is STRING

  -- Product (PLANT or MARINE)
  member .productFamily is STRING
  -- Family Group (PDMS, HULL or OUTFITTING)
  member .product       is STRING
  -- Product Group (PDMS, Marine, Diagrams or Engineering)
  member .productgroup  is STRING
  -- Full Module Name
  member .fullname      is STRING
  -- Display Name Text
  member .dtext         is STRING

  -- Current DDL
  member .ddl           is STRING
  -- DDL Type
  member .ddlType       is STRING
  -- DDL Version
  member .ddlVersion    is STRING
  -- DDL Date
  member .ddlDate       is STRING

endobject
-- End of object definition for MODULE

------------------------------------------------------------------------
--
-- Method:      .module()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .module()

  -- Initialise Variables
  !mm = object AVEVAModuleManager()
  !brand = !mm.CurrentBrandName()
  !this.productFamily = 'Plant'
  if (match(!brand.upcase(), 'AVEVA MARINE') gt 0) then
  	!this.productFamily = 'Marine'
  endif
  !this.productgroup = !mm.CurrentProductName()
  !this.product = !mm.CurrentProductName()

  -- Get Module Data
  var !data BANN NAME
  !this.name              = !data
  !m = !mm.CurrentModule()
  --!this.name = !m.Name()
  !this.fullname = !m.Name()
  !this.appName = !m.Name()
  !this.dtext = !m.DText()

  -- Module related information
  if(match(!this.name.upcase(), 'HULLDESIGN') gt 0) then
    !this.appKey          = 'marhdes'
    !this.modKey          = 'marhdes'
    !this.product         = 'Hull'
    !this.fullname        = 'Design'
  elseif (match(!this.name.upcase(), 'MARINEDRAFTING') gt 0) then
    !this.appKey          = 'mardra'
    !this.modKey          = 'mardra'
    !this.fullname        = 'Drafting'
  elseif (match(!this.name.upcase(), 'OUTFITTINGDRAFT') gt 0) then
    !this.appKey          = 'dra'
    !this.modKey          = 'marodra'
    !this.product         = 'Outfitting'
    !this.fullname        = 'Draft'
  elseif (match(!this.name.upcase(), 'OUTFITTING') gt 0) then
    !this.product         = 'Outfitting'
    !this.appName         = 'Design'
    !this.appKey          = 'des'
    !this.modKey          = 'marodes'
  elseif (match(!this.name.upcase(), 'SCHEMATICMODELMANAGER') gt 0) then
    !this.appKey          = 'smm'
    !this.modKey          = 'smm'
  elseif (match(!this.name.upcase(), 'TAGS') gt 0) then
    !this.appKey          = 'tags'
    !this.modKey          = 'tags'
  elseif (match(!this.name.upcase(), 'DESIGN') gt 0) then
    !this.appKey          = 'des'
    !this.modKey          = 'des'
  elseif (match(!this.name.upcase(), 'PARAGON') gt 0) then
    !this.appKey          = 'cat'
    !this.modKey          = 'cat'
  elseif (match(!this.name.upcase(), 'ISODRAFT') gt 0) then
    !this.appKey          = 'iso'
    !this.modKey          = 'iso'
  elseif (match(!this.name.upcase(), 'DRAFT') gt 0) then
    !this.appKey          = 'dra'
    !this.modKey          = 'dra'
  elseif (match(!this.name.upcase(), 'ADMIN') gt 0) then
    !this.appKey          = 'adm'
    !this.modKey          = 'adm'
  elseif (match(!this.name.upcase(), 'LEXICON') gt 0) then
    !this.appKey          = 'lex'
    !this.modKey          = 'lex'
  elseif (match(!this.name.upcase(), 'SPOOLER') gt 0) then
    !this.appKey          = 'spl'
    !this.modKey          = 'spl'
  elseif (match(!this.name.upcase(), 'MONITOR') gt 0) then
    !this.appKey          = 'mon'
    !this.modKey          = 'mon'
  elseif (match(!this.name.upcase(), 'TOOLBOX') gt 0) then
    !this.appKey          = 'tbox'
    !this.modKey          = 'tbox'
  elseif (match(!this.name.upcase(), 'DIAGRAMS') gt 0) then
  	-- keep this entry last to avoid mistaking the "Diagrams" product name for the module name
    !this.appKey          = 'diagrams'
    !this.modKey          = 'diagrams'
  endif

  -- Set fullname is unset
  if(!this.fullname.unset()) then
    !this.fullname        = !this.appName
  endif

  var !data BANN STATUS
  !this.status            = !data

  var !data BANN COPYRIGHT
  !this.copyright         = !data

  var !data BANN COMPANY
  !this.company           = !data

  -- Get Short Banner and parse data from it
  -- format '<module name> <version> (<compile OS>) (<compile date>)'
  var !data BANN SHORT

  -- Version
  !this.version           = !data.after(!this.name).before('(').trim()

  -- Compile OS
  !this.compileOS         = !data.after('(').before(')').trim()

  -- Compile Date
  !data                   = !data.after(')')
  !this.compileDate = !data.after('(').before(')').trim()

  -- DDL Data
  -- Format <ddl type> DDL - Mark <version> <date>
  if (!this.appName.upcase().neq('MONITOR')) then

    var !data DDL

    -- DDL Type
    !this.ddlType         = !data.part(1)

    -- DDL Version
    !this.ddlVersion      = !data.part(5)

    -- DDL Data
    !this.ddlDate         = !data.part(-1)

  endif

endmethod
-- End of method definition
