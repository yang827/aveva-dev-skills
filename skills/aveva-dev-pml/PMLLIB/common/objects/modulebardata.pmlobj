--
-- Description:
-- Data used by the module bar to allow users to switch modules.
--
------------------------------------------------------------------------

-- Define object
define object MODULEBARDATA

  -- Module name (Returned by SESSION.module())
  member .name          is STRING

  -- Menu entry display text
  member .dText         is STRING

  -- Command used for module switch
  member .command       is STRING

  -- Wordy description
  member .description   is STRING

  -- Does module have a UI
  member .gui           is BOOLEAN

  -- Can module be restored
  member .restore       is BOOLEAN

  -- Is the module restricted access
  member .restricted    is BOOLEAN

  -- Does the module write to databases
  member .dbRw          is BOOLEAN

  -- Directory name used by PML Macros (OLD)
  member .directory     is STRING

  -- Level of menu bar
  member .level         is STRING

endobject
-- End of object definition for MODULEBARDATA
