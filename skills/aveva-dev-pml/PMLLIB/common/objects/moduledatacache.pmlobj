--
--
-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  append(MODULEBARDATA)            -                   append a module to the list
--  moduleData()                     ARRAY               return module data for all modules
--  moduleData(STRING)               MODULEBARDATA       return module data for named module
--
define object MODULEDATACACHE

  member .modules is ARRAY
  member .nameIndex is ARRAY

endobject
-- End of object definition for MODULEDATACACHE

------------------------------------------------------------------------
--
-- Method:      !append()
--
-- Description: append a module to the list
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [MODULEBARDATA] [data to append]
--
------------------------------------------------------------------------
define method .append(!data is MODULEBARDATA)

  !this.modules.append(!data)
  !this.nameIndex.append(!data.name.upcase())

endmethod
-- End of method definition for .append(MODULEBARDATA)

------------------------------------------------------------------------
--
-- Method:      !moduleData()
--
-- Description: return module data for all modules
--
-- Method Type: Function
-- Return:
--   [ARRAY] [array of module bar data]
--
------------------------------------------------------------------------
define method .moduleData() is ARRAY

  return !this.modules

endmethod
-- End of method definition for .moduleData() ARRAY

------------------------------------------------------------------------
--
-- Method:      !moduleData(STRING)
--
-- Description: return module data for named module
--
-- Method Type: Function
-- Return:
--   [MODULEBARDATA] [module bar data]
--
------------------------------------------------------------------------
define method .moduleData(!name is STRING) is MODULEBARDATA

  -- allow for global extensions which report administered location as well as the module
  !moduleName = !name.split()
  return !this.modules[!this.nameIndex.findFirst(!moduleName[1].upcase())]

endmethod
-- End of method definition for .moduleData(STRING) MODULEBARDATA
