--
-- File:            msgmodules.pmlobj
--   Type:          Object Definition
--   Group:         Message modules number definitions
--     Keyword:     MSGMODULES
--   Module:        common
--   Replaces:
--
-- Author:          S.Ellis
-- Created:         Mon Feb 23 1998
--
--
-- Description:
-- Object to store message module numbers
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copyToGlobal()                   -                   copy the object to the global instance
--  default()                        -                   Default options settings
--  globalInstance()                 -                   create a global instance of the object
--
------------------------------------------------------------------------

-- Define object
define object MSGMODULES

  -- Administration application
  member .admin is REAL

  -- Checker Utility module
  member .checker is REAL

  -- Draft module
  member .draft is REAL

  -- Event Driven Graphic Utilities
  member .edg is REAL

  -- Database, Navigation and DB operation Messages
  member .db is REAL

  -- General Utilities
  member .general is REAL

  -- Graphical View Utilities
  member .graphical is REAL

  -- Isodraft
  member .isodraft is REAL

 -- List Maintenance Utilities
  member .list is REAL

  -- Administration and Monitor Utilities
  member .monitor is REAL

  -- Positioning & Orientation Utilities
  member .posori is REAL

  -- Common Rule Definition
  member .rule is REAL

 -- Specification Maintenance and Use Application
  member .spec is REAL

  -- Spooler modules
  member .spooler is REAL

endobject
-- End of object definition for MSGMODULES

------------------------------------------------------------------------
--
-- Method:      !default()
--
-- Description: Default options settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .default()

  -- define default settings here
  -- add any new modules at end, DO NOT CHANGE EXISTING MODULE NUMBERS

  !this.admin = 141
  !this.checker = 142
  !this.db = 143
  !this.draft = 144
  !this.edg = 145
  !this.general = 146
  !this.graphical = 147
  !this.isodraft = 148
  !this.list = 149
  !this.monitor = 150
  !this.posori = 151
  !this.rule = 152
  !this.spec = 153
  !this.spooler = 154

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  if (defined(!!msgModules)) then
    !!msgModules.delete()
  endif

  -- create the global variable
  !!msgModules = object MSGMODULES()

  -- allocate module numbers

  !!msgModules.default()

  -- execute the constructor
  -- (this will not be necessary at a later release of PDMS)
  !!msgModules.msgModules()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  -- if the global instance does not exist, then define it
  if (undefined(!!msgModules)) then
    !this.globalInstance()
  endif

  -- set all values in the global object specifically, this is necessary
  -- to cause the core settings to be made

endmethod
-- End of method definition for .copyToGlobal()
