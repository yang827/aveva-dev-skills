------------------------------------------------------------------------
--
-- Method:      !getName()
--
-- Description: get a name object given a key
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [STRING] [key for name rule object]
-- Return:
--   [NAMOPTRULE] [naming rule]
--
------------------------------------------------------------------------

-- Define method
define method .getName(!key is STRING) is NAMOPTRULE

  !returnValue = object NAMOPTRULE()

  -- select the naming rule with the key that matches !key
  -- the search is case insensitive
  do !nameRule values !this.rules
    if (!key.upcase().trim() eq !nameRule.key.upcase().trim()) then
      !returnValue = !nameRule
      break
    endif
  enddo

  return !returnValue

endmethod
-- End of method definition for .getName(STRING) NAMOPTRULE

------------------------------------------------------------------------
--
-- Method:      !nameString()
--
-- Description: method to return an auto name string
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to apply autoname rules to]
--   [2] [R] [STRING] [AutoName key, used to look up data in data structure]
--   [3] [R] [BOOLEAN] [flag to indicate if rule is to be checked]
--   [4] [R] [BOOLEAN] [flag to indicate if return is in wildcard format]
-- Return:
--   [STRING] [Auto name string]
--
------------------------------------------------------------------------

-- Define method
define method .nameString(!element is DBREF, !key is STRING, !check is BOOLEAN, !wildCard is BOOLEAN) is STRING

  -- If <key> has been passed, get format directly
  if(!key.unset().not() and !key.trim() ne '') then
    -- Get the naming rule specified by key
    !nameObj = !this.getName(!key)
    if (!nameObj.unset()) then
      !!messageFile.error(146, 18, !key)
    endif

    -- get the rule
    !ruleObj = !!ruleStore.element.getRule(!nameObj.rule)
    handle (152, 4)
      !!alert.error(!!error.text)
    endhandle

    -- Check if rule is valid
    if (!check) then
      if (!ruleObj.rule.trim() ne '' and !element.evaluate(!ruleObj.rule.block()).not()) then
        !!messageFile.errorNoAlert(146, 19, !ruleObj.rule, !element.name)
      endif
    endif

    -- set the name data
    !nameData = !nameObj

  -- Try and Determine Format from gtyp and rule
  else

    !valid = false

    do !i indices !this.rules

      -- get the rule
      !ruleObj = !!ruleStore.element.getRule(!this.rules[!i].rule)
      handle (12, 004)
        skip
      endhandle

      !types = !ruleObj.types.split()
      do !j from 1 to !types.size()
          if (!types[!j] eq !element.type) then

            -- Check if rule is valid
            if (!ruleObj.rule.trim() ne '') then
              !valid = !element.evaluate(!ruleObj.rule.block())
              handle any
                !valid = false
              endhandle
            else
              !valid = true
            endif

            if (!valid) then
              !nameData = !this.rules[!i]
              break
            else
              skip
            endif

          else

            skip

          endif
      enddo

      if (!valid) then
        break
      endif

    enddo
  endif


  -- Build Name using !nameData if it has been defined
  if (defined(!nameData)) then

    if (!nameData.format.trim().empty().not()) then

      -- Check for USERFUNC and call any user defined functions
      do !i

        break if(!nameData.format.matchWild('*USRFUNC(*)*').not())

        -- Get function from format
        !bStr = !nameData.format.before('USRFUNC(')
        !aStr = !nameData.format.after('USRFUNC(')
        !func = !aStr.before(')')
        !macro = !func.part(1)
        !args = !func.after(!macro)
        !aStr = !aStr.after(')')

        -- Rebuild format
        !module = !!module()
        -- call user macro
        call !!runMacro('%PDMSUI%/' + !module.appName.subString(1,3).upcase() + '/FUNC/' + !macro, !args)

        !nameData.format = !bStr + |'| + !!cdcnRtn + |'| + !aStr

      enddo
      -- if format contains !index, set index flag
      if (!nameData.format.lowcase().matchWild('*!index*')) then

        -- Generate Wildcard string using fixed length indices
        if(!nameData.indices.empty().not()) then
          !iLen = !nameData.indices.length()
          !index = substring('?????', 1, !iLen)
          !iCmd = |(substring('00000' + !nIndex.string(),-1, (-1 * !iLen)))|

        -- Generate Wildcard string using free length indices
        else
          !index = '*'
          !iCmd = '!nIndex'
        endif

        -- Build Template

        if (!nameData.format.upcase().matchWild('*IFTRUE*')) then
          !temp = !nameData.format.split('&')
          !tempString = ''
          do !i index !temp
            var !t $!temp[$!i]
            handle ANY
              !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
            endhandle
            !tempString = !tempString & !t
          enddo
          !wildString = !tempString
        else
          !wildString = !element.evaluate(!nameData.format.block())
          handle ANY
            !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
          endhandle
        endif

        -- Before/After strings
        !bStr = !wildString.before(!index)
        !aStr = !wildString.after(!index)

        if (!nameData.scan.empty()) then
          !nameData.scan = 'WORLD'
        endif

        -- Generate collection of like names
        !unusedTestScanLevel = !nameData.scan.dbref()
        handle ANY
            !nameData.scan = !!ce.type
        endhandle

        -- Generate collection of like names
        !coll = !!collectAllFor(!ruleObj.types, |matchWild(NAME, '/' + '| + !wildString + |')|, !nameData.scan.dbref())
        handle ANY
          !nameString = STRING()
          return !nameString
        endhandle

        -- Get new index and save in !nIndex
        if (!!namOpt.mode.upcase() eq 'APPEND') then
          -- Sort name into order
          if(!coll.empty().not()) then
            -- extract name from all DBREF objects
            !evalName = object BLOCK('!coll[!evalIndex].name')
            !eval = !coll.evaluate(!evalName)

            -- sort the array in descending order
            !eval.sort().invert()

            -- set initial index value (in case existing index is not found)
            !nIndex = 1

            -- Find the highest existing VALID index, i.e. purely numeric
            do !name values !eval
              if(!bStr.empty().not()) then
                !name = !name.after(!bStr)
              endif
              if(!aStr.empty().not()) then
                !name = !name.before(!aStr)
              endif
              -- Check that !name string contains only numeric values - first check that there is not a letter
              -- at the end as this may still be converted by the real() method (as a unit).
              !name.subString(!name.length()).real()
              handle (2,441)
                skip
              endhandle
              -- set the new index value
              !nIndex = !name.real() + 1
              handle (2,441)
                skip
              elsehandle NONE
                break
              endhandle
            enddo

          else
            !nIndex = 1
          endif

        elseif (!!namOpt.mode.upcase() eq 'INFILL') then
          -- Find the gap in the list of names
          if(!coll.empty().not()) then
            -- extract name from all DBREF objects
            !evalName = object BLOCK('!coll[!evalIndex].name')
            !eval = !coll.evaluate(!evalName)

            -- sort the array in ascending order
            !eval.sort()

            -- set nIndex to the index value of the first gap found
            do !i indices !eval
              !name = !eval[!i]
              if(!bStr.empty().not()) then
                !name = !name.after(!bStr)
              endif
              if(!aStr.empty().not()) then
                !name = !name.before(!aStr)
              endif
              if (!name.real() ne !i) then
                !nIndex = !i
                break
              else
                !nIndex = !i + 1
              endif
            enddo
          else
            !nIndex = 1
          endif
        endif

        !index = !element.evaluate(!iCmd.block())
        handle any
          !!messageFile.errorNoAlert(146, 56, !iCmd, !element.name)
        endhandle

      else

        if (!nameData.format.upcase().matchWild('*IFTRUE*')) then
          !temp = !nameData.format.split('&')
          !tempString = ''
          do !i index !temp
            var !t $!temp[$!i]
            handle ANY
              !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
            endhandle
            !tempString = !tempString & !t
          enddo
          !wildString = !tempString
        else
          !wildString = !element.evaluate(!nameData.format.block())
          handle any
            !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
          endhandle
        endif

      endif

      if (!nameData.format.upcase().matchWild('*IFTRUE*')) then
        !temp = !nameData.format.split('&')
        !tempString = ''
        do !i index !temp
          var !t $!temp[$!i]
          handle ANY
            !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
          endhandle
          !tempString = !tempString & !t
        enddo
        !nameString = !tempString
      else
        !nameString = !element.evaluate(!nameData.format.block())
        handle any
          !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
        endhandle
      endif

    else
      -- nothing to do except return default string
      !nameString = STRING()
      !wildString = STRING()

    endif

  else
    -- nothing to do except return default string
    !nameString = STRING()
    !wildString = STRING()

  endif

  if (!wildCard) then
    !returnString = !wildString
  else
    !returnString = !nameString
  endif

  return !returnString
endmethod
-- End of method definition for .nameString(DBREF, STRING, BOOLEAN, BOOLEAN) STRING

------------------------------------------------------------------------
--
-- Method:        .nameString(STRING,STRING,BOOLEAN,BOOLEAN)STRING
--
-- Description:   Make the application toolbar and main menu options active
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element to apply autoname rules to
--    2   R      STRING      AutoName key, used to look up data in data structure
--    3   R      BOOLEAN     Flag to indicate if rule is to be checked
--    4   R      BOOLEAN     Flag to indicate if return is in wildcard format
--
-- Return:
--   [Data Type] [Description]
--   STRING       Auto name string
--
------------------------------------------------------------------------
define method .nameString(!element is STRING, !key is STRING, !check is BOOLEAN, !wildCard is BOOLEAN) is STRING

  -- If <key> has been passed, get format directly
  if(!key.unset().not() and !key.trim() ne '') then

    -- Get the naming rule specified by key
    !nameObj = !this.getName(!key)

    if (!nameObj.unset()) then
      !!messageFile.error(146, 18, !key)
    endif

    -- get the rule
    !ruleObj = !!ruleStore.element.getRule(!nameObj.rule)
    handle (152, 4)
      !!alert.error(!!error.text)
    endhandle

    -- Check if rule is valid
    if (!check) then
      if (!ruleObj.rule.trim() ne '' and !element.evaluate(!ruleObj.rule.block()).not()) then
        !!messageFile.errorNoAlert(146, 19, !ruleObj.rule, !element.name)
      endif
    endif

    -- set the name data
    !nameData = !nameObj

  -- Try and Determine Format from gtyp and rule
  else

    !valid = false

    do !i indices !this.rules

      -- get the rule
      !ruleObj = !!ruleStore.element.getRule(!this.rules[!i].rule)
      handle (12, 004)
        skip
      endhandle

      !types = !ruleObj.types.split()
      do !j from 1 to !types.size()
          if (!types[!j] eq !element) then

            -- Check if rule is valid
            if (!ruleObj.rule.trim() ne '') then
              !valid = !element.evaluate(!ruleObj.rule.block())
              handle any
                !valid = false
              endhandle
            else
              !valid = true
            endif

            if (!valid) then
              !nameData = !this.rules[!i]
              break
            else
              skip
            endif

          else

            skip

          endif
      enddo

      if (!valid) then
        break
      endif

    enddo
  endif

  -- Build Name using !nameData if it has been defined
  if (defined(!nameData)) then

    if (!nameData.format.trim().empty().not()) then

      -- Check for USERFUNC and call any user defined functions
      do !i

        break if(!nameData.format.matchWild('*USRFUNC(*)*').not())

        -- Get function from format
        !bStr = !nameData.format.before('USRFUNC(')
        !aStr = !nameData.format.after('USRFUNC(')
        !func = !aStr.before(')')
        !macro = !func.part(1)
        !args = !func.after(!macro)
        !aStr = !aStr.after(')')

        -- Rebuild format
        !module = !!module()
        -- call user macro
        call !!runMacro('%PDMSUI%/' + !module.appName.subString(1,3).upcase() + '/FUNC/' + !macro, !args)

        !nameData.format = !bStr + |'| + !!cdcnRtn + |'| + !aStr

      enddo

      -- if format contains !index, set index flag
      if (!nameData.format.lowcase().matchWild('*!index*')) then

        -- Generate Wildcard string using fixed length indices
        if(!nameData.indices.empty().not()) then
          !iLen = !nameData.indices.length()
          !index = substring('?????', 1, !iLen)
          !iCmd = |(substring('00000' + !nIndex.string(),-1, (-1 * !iLen)))|

        -- Generate Wildcard string using free length indices
        else
          !index = '*'
          !iCmd = '!nIndex'
        endif

        -- Build Template
        !wildString = !element.evaluate(!nameData.format.block())
        handle any
          !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
        endhandle

        -- Before/After strings
        !bStr = !wildString.before(!index)
        !aStr = !wildString.after(!index)

        if (!nameData.scan.empty()) then
          !nameData.scan = 'WORLD'
        endif

        -- Generate collection of like names
        !coll = !!collectAllFor(!ruleObj.types, |matchWild(NAME, '/' + '| + !wildString + |')|, !nameData.scan.dbref())

        -- Get new index and save in !nIndex
        if (!!namOpt.mode.upcase() eq 'APPEND') then
          -- Sort name into order
          if(!coll.empty().not()) then
            -- extract name from all DBREF objects
            !evalName = object BLOCK('!coll[!evalIndex].name')
            !eval = !coll.evaluate(!evalName)

            -- sort the array in descending order
            !eval.sort().invert()

            !name = !eval[1]
            if(!bStr.empty().not()) then
              !name = !name.after(!bStr)
            endif
            if(!aStr.empty().not()) then
              !name = !name.before(!aStr)
            endif

            -- set the new index value
            !nIndex = !name.real() + 1
          else
            !nIndex = 1
          endif

        elseif (!!namOpt.mode.upcase() eq 'INFILL') then
          -- Find the gap in the list of names
          if(!coll.empty().not()) then
            -- extract name from all DBREF objects
            !evalName = object BLOCK('!coll[!evalIndex].name')
            !eval = !coll.evaluate(!evalName)

            -- sort the array in ascending order
            !eval.sort()

            -- set nIndex to the index value of the first gap found
            do !i indices !eval
              !name = !eval[!i]
              if(!bStr.empty().not()) then
                !name = !name.after(!bStr)
              endif
              if(!aStr.empty().not()) then
                !name = !name.before(!aStr)
              endif
              if (!name.real() ne !i) then
                !nIndex = !i
                break
              else
                !nIndex = !i + 1
              endif
            enddo
          else
            !nIndex = 1
          endif
        endif

        !index = !element.evaluate(!iCmd.block())
        handle any
          !!messageFile.errorNoAlert(146, 56, !iCmd, !element.name)
        endhandle

      else

        !wildString = !element.evaluate(!nameData.format.block())
        handle any
          !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
        endhandle

      endif

      !nameString = !element.evaluate(!nameData.format.block())
      handle any
        !!messageFile.errorNoAlert(146, 56, !nameData.format, !element.name)
      endhandle

    else
      -- nothing to do except return default string
      !nameString = STRING()
      !wildString = STRING()

    endif

  else
    -- nothing to do except return default string
    !nameString = STRING()
    !wildString = STRING()

  endif

  if (!wildCard) then
    !returnString = !wildString
  else
    !returnString = !nameString
  endif

  return !returnString

endmethod
-- End of method definition for .nameString(STRING, STRING, BOOLEAN, BOOLEAN) STRING
