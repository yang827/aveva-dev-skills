-- File:            namopt.pmlobj
--   Type:          Object Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Apr 7 08:54:26 BST 1997
--
--
-- Description:
-- Autoname object used to hold data for an autonaming rule
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  auto()                           BOOLEAN             get the auto naming state
--  auto(BOOLEAN)                    -                   set the auto naming state
--  copyToGlobal()                   -                   copy the object to the global instance
--  coreSettings()                   -                   Align all core settings with the member values
--  default(BOOLEAN)                 -                   Default options settings
--  edit()                           -                   edit the options via the GUI
--  getName(STRING)                  NAMOPTRULE          get a name object given a key
--  globalInstance()                 -                   create a global instance of the object
--  load()                           -                   Load options from system and user files
--  localCopy()                      NAMOPT              return a local copy of the object
--  mode()                           STRING              get the naming mode
--  mode(STRING)                     -                   set the naming mode
--  namOpt()                         -                   Constructor
--  namOpt(BOOLEAN)                  -                   Constructor
--  nameString(DBREF,STRING,BOOLEAN,BOOLEAN) STRING              method to return an auto name string
--  nameString(STRING,STRING,BOOLEAN,BOOLEAN) STRING
--  rules()                          ARRAY               get the auto naming rules
--  rules(ARRAY)                     -                   set the auto naming rules
--  save()                           -                   Save options settings to %PDMSUSER%
--
------------------------------------------------------------------------

-- Define object
define object NAMOPT

  -- current options file name for this object
  member .filename is STRING
  member .optionsFileType is STRING
  member .optionFileObject is DEFAULTFILE

  -- global object flag, if set then global core options are also set
  member .global is BOOLEAN

  -- members to store naming settings
  member .rules is ARRAY
  member .auto  is BOOLEAN
  member .mode is STRING

endobject
-- End of object definition for NAMOPT

------------------------------------------------------------------------
--
-- Method:      !namOpt()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .namOpt()

  -- Initialise as non-global instance
  !this.namOpt(false)

endmethod
-- End of method definition for .namOpt()

------------------------------------------------------------------------
--
-- Method:      !namOpt(BOOLEAN)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .namOpt(!globalValue is BOOLEAN)

  -- set file name
  !module = !!module()
  -- a change made at 12.1 caused a file naming mis-match for modules whose .appKey
  -- is different to the .modKey.
  !this.filename = !module.modKey + '-nam.pmldat'

  -- initialise the global flag
  !this.global = !globalValue

  -- set the default values
  !this.default(!globalValue)
  !this.optionsFileType = ''

endmethod
-- End of method definition for .namOpt(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !default(BOOLEAN)
--
-- Description: Default options settings
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .default(!setCore is BOOLEAN)

  !module = !!module()

  -- define default settings here
  !this.auto = FALSE
  !this.mode = 'Append'

  if (!module.appKey.upcase() eq 'DES') then

    !namOptRule     = object NAMOPTRULE()
    !namOptRule.key  = |HS Restraints Name|
    !namOptRule.description = |Naming rule for all HS restraints|
    !namOptRule.rule = |HS Restraints|
    !namOptRule.scan = |SITE|
    !namOptRule.format  = |USRFUNC(GADGET CLASS) & '-' & USRFUNC(DEFAULT HSUSER 0506) & '-' & !index|
    !namOptRule.indices  = |0000|
    !this.rules.append(!namOptRule)

  endif

  if (!setCore) then
    !this.coreSettings()
  endif

endmethod
-- End of method definition for .default(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- if the global instance already exists then delete it
  if (defined(!!namOpt)) then
    !!namOpt.delete()
  endif

  -- create the global instance of this object
  !!namOpt = object NAMOPT(true)

  -- load the options settings
  !!namOpt.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [NAMOPT] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is NAMOPT

  -- copy this object to a local variable and unset the global flag
  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() NAMOPT

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  -- if the global instance does not exist, then define it
  if (undefined(!!namOpt)) then
    !this.globalInstance()
  endif

  !!namOpt = !this
  !!namOpt.global = true
  !!namOpt.coreSettings()

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method: !coreSettings()
--
-- Description: Align all core settings with the member values
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------
define method .coreSettings()

  -- This is an empty method
  !unused = 0

endmethod
-- End of method definition for .coreSettings()

------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------
define method .load()

  -- get the locations of system options file and user options file (ARRAY of DEFAULTFILE())
  !optionDefaultFiles = !!searchPaths(!this.filename)
  -- put USER in [1], PROJ in [2] and DFLTS in [3]
  !optionFiles = ARRAY()
  do !oDefaultFile values !optionDefaultFiles
    !optionType = !oDefaultFile.getDefaultType()
    if(!optionType eq 'DEFAULT') then
      !index = 3
    elseif(!optionType eq 'PROJ') then
      !index = 2
    else
      -- assume USER
      !index = 1
    endif
    !optionFiles[!index] = !oDefaultFile
  enddo

  if( !optionFiles.empty() ) then
    -- no naming rules found
    !this.coreSettings()
    !this.optionsFileType  = 'USER'
    !this.optionFileObject = object DEFAULTFILE()
    return
  endif

  -- create a temporary global variable to store the data
  if (defined(!!tmpNamOpt)) then
    !!tmpNamOpt.delete()
  endif
  !!tmpNamOpt   = object NAMOPT()
  !systemNamOpt = !!tmpNamOpt
  !numberOfBaseRules = !!tmpNamOpt.rules.size()

  -- naming rules found
  -- user USER, PROJ, DFLTS in that order of preference
  -- first load project or system options because user option may contain only auto-name on/off or infill/append
  !optionsFile = ''
  if( defined(!optionFiles[2]) ) then
    !warning     = 31
    !optionsFile = 'PROJ'
    !localOptionFileObject = !optionFiles[2]
  elseif( defined(!optionFiles[3]) ) then
    !warning     = 31
    !optionsFile = 'DEFAULT'
    !localOptionFileObject = !optionFiles[3]
  endif
  -- load system or project options
  if( !optionsFile.empty().not()) then
    !localName   = !localOptionFileObject.fullName
    -- load options file
    $m "$!<localName>"
    handle any
      !!messageFile.warning(146, !warning, !localName)
      !this.default(false)
      !optionsFile = ''
    endhandle
    !systemNamOpt = !!tmpNamOpt
  endif

  -- user file might have auto-name on/off or infill/append switched on, but no rules
  if( defined(!optionFiles[1]) ) then
    !!tmpNamOpt   = object NAMOPT()
    !warning     = 32
    !localName   = !optionFiles[1].fullName
    -- load user options file
    $m "$!<localName>"
    handle any
      -- warn user and use system file if error
      !!messageFile.warning(146, !warning, !localName)
    elsehandle none
      !numberOfRules = !!tmpNamOpt.rules.size()
      if( !numberOfRules gt !numberOfBaseRules ) then
        -- new rules have been defined in user option file
        !optionsFile = 'USER'
        !localOptionFileObject = !optionFiles[1]
      else
        -- use system rules with user on/off or infill/append options
        !auto = !!tmpNamOpt.auto
        !mode = !!tmpNamOpt.mode
        !!tmpNamOpt = !systemNamOpt
        !!tmpNamOpt.auto = !auto
        !!tmpNamOpt.mode = !mode
      endif
    endhandle
  endif

  !this = !!tmpNamOpt
  !this.coreSettings()
  !this.optionsFileType  = !optionsFile
  !this.optionFileObject = !localOptionFileObject

  !!tmpNamOpt.delete()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method: !save()
--
-- Description: Save options settings to %PDMSUSER%
--
-- Method Type: Function
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()
  !userEnvironmentVariable = '%PDMSUSER%/'

  -- write header information
  !saveContents.append('-- Data file for naming options')
  !saveContents.append('')

  -- options are not saved if they are the same as the default values
  -- currently the default values are put in here directly, this is
  -- for performance reasons, it would be better to have a member for
  -- each existing member, that held its default value.

  ----------------------------------------------------------------------
  -- user options are  saved for all users
  ----------------------------------------------------------------------
  !saveContents.append('!!tmpNamOpt.auto = ' & !this.auto)
  !saveContents.append('!!tmpNamOpt.mode = |' & !this.mode & '|')

  -- end of user options

  ----------------------------------------------------------------------
  -- system options are only saved if the user has administrator status
  ----------------------------------------------------------------------
  !disallowedRules = ARRAY()
  if( !this.optionsFileType eq 'DEFAULT' ) then
    !disallowedRules[1] = 'USER'
    !disallowedRules[2] = 'PROJ'
  elseif( !this.optionsFileType eq 'PROJ' ) then
    !disallowedRules[1] = 'USER'
  endif

  !disallowedRuleType = ''
  if (!!comAdminStatus()) then

    if (!this.rules.empty().not()) then
      !saveContents.append('')
      !saveContents.append('!tempArray = ARRAY()')
      !saveContents.append('')
      do !i indices !this.rules
        -- check for using disallowed rules
        if ( !this.optionsFileType neq 'USER' and !disallowedRuleType.empty() ) then
          -- saving a system name rule set, so must make sure that no user element rules are used
          -- if one user element rule has been found we do not need to test the remaining name rules
          !rule = !!ruleStore.element.getRule(!this.rules[!i].rule)
          if(!disallowedRules.findFirst(!rule.location).set()) then
            !disallowedRuleType = !rule.location
          endif
        endif
        !saveContents.appendArray(!this.rules[!i].save())
        !saveContents.append('!tempArray.append(!namOptRule)')
        !saveContents.append('')
      enddo
      !saveContents.append('!!tmpNamOpt.rules = !tempArray')
    endif

  endif
  -- end of system options

  -- writing a USER rule set
  if ( !this.optionsFileType eq 'USER' or !!comAdminStatus().not()) then
    -- write user naming rules file
    !!writeFile(!userEnvironmentVariable + !this.filename, 'OVERWRITE', !saveContents)
    handle (41,319)
      !!alert.error('You do not have write access to ' + !userEnvironmentVariable + !this.filename)
    endhandle
    return
  endif

  -- if writing a DEFAULTS (system) rule set, then check that the rules can be saved
  !failedWriteToDefaultsFile = false
  if( !disallowedRuleType.empty().not() ) then
   -- cannot write to defaults area a file using user rules
   !!alert.warning('Naming rules cannot be saved in System defaults file because at least one naming rule uses a local (' + !disallowedRuleType + ') element rule.')
   !failedWriteToDefaultsFile = true
  else
    -- write rules to system file
    !!writeFile(!this.optionFileObject.name(), 'OVERWRITE', !saveContents)
    handle any
      -- cannot write to file
      !failedWriteToDefaultsFile = true
    elsehandle none
      -- finished - system file written
      return
    endhandle
  endif

   if( !failedWriteToDefaultsFile.not() ) then
    -- defaults file has been written
    return
  endif

  -- Offer to write to User file
  if( !this.optionsFileType eq 'PROJ' ) then
    !message = 'Project'
  else
    !message = 'System'
  endif
  -- check to see if user wants to save to user file
  !reply         = !!alert.confirm('Access denied to ' + !message  + ' naming rules. Do you want to write to local (user) naming rules?')
  if( !reply eq 'YES' ) then
    -- write user naming rules file
    !!writeFile(!userEnvironmentVariable + !this.filename, 'OVERWRITE', !saveContents)
    !this.optionsFileType = 'USER'
  endif
  return

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
