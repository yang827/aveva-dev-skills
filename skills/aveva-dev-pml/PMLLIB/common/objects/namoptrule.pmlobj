-- Created:         Mon Apr 7 08:54:26 BST 1997
--
--
-- Description:
-- Autoname object used to hold data for an autonaming rule
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  namOptRule(STRING,STRING,STRING,STRING,STRING,STRING) -                   constructor
--  save()                           ARRAY               return an array of strings to write to a file
--
------------------------------------------------------------------------

-- Define object
define object NAMOPTRULE

  -- key for the naming rule, used to locate the rule
  member .key is STRING

  -- description of naming rule
  member .description is STRING

  -- standard rule used to select elements to name
  member .rule is STRING

  -- database hierarchy level that will be scanned
  member .scan is STRING

  -- format of the name string
  member .format is STRING

  -- indices to be incremented
  member .indices is STRING

endobject
-- End of object definition for NAMOPTRULE

------------------------------------------------------------------------
--
-- Method:      !namOptRule()
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [value for key member]
--   [2] [R] [STRING] [value for description]
--   [3] [R] [STRING] [value for rule member]
--   [4] [R] [STRING] [value for scan member]
--   [5] [R] [STRING] [value for format member]
--   [6] [R] [STRING] [value for indices member]
--
------------------------------------------------------------------------
define method .namOptRule(!keyValue is STRING, !descValue is STRING, !ruleValue is STRING, !scanValue is STRING, !formatValue is STRING, !indicesValue is STRING)

  -- set the object members to the argument values
  !this.key = !keyValue
  !this.description = !descValue
  !this.rule = !ruleValue
  !this.scan = !scanValue
  !this.format = !formatValue
  !this.indices = !indicesValue

endmethod
-- End of method definition for .namOptRule(STRING, STRING, STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: return an array of strings to write to a file
--
-- Method Type: Function
-- Return:
--   [ARRAY] [array of strings used to recreate the object]
--
------------------------------------------------------------------------
define method .save() is ARRAY

  -- initialise array to contain strings
  !saveContents = ARRAY()

  !saveContents.append('!namOptRule             = object NAMOPTRULE()')
  !saveContents.append('!namOptRule.key         = |' + !this.key.replace('|', '||') + '|')
  !saveContents.append('!namOptRule.description = |' + !this.description.replace('|', '||') + '|')
  !saveContents.append('!namOptRule.rule        = |' + !this.rule.replace('|', '||') + '|')
  !saveContents.append('!namOptRule.scan        = |' + !this.scan.replace('|', '||') + '|')
  !saveContents.append('!namOptRule.format      = |' + !this.format.replace('|', '||') + '|')
  !saveContents.append('!namOptRule.indices     = |' + !this.indices.replace('|', '||') + '|')

  return !saveContents

endmethod
-- End of method definition for .save() ARRAY
