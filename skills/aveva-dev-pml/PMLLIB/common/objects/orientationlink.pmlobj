------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  get()                            ORIENTATION         Return current orientation
--  initialise()                     -                   Initialisation
--  linkInput(STRING,STRING,GADGET,STRING,GADGET,STRING,GADGET) -                   Define link input gadgets
--  newInput(GADGET,STRING)          -                   Update orientation  with input data
--  orientation()                    ORIENTATION         Return current orientation
--  orientation(ORIENTATION)         -                   Set orientation
--  runAction()                      -                   Run action command
--  setAction(STRING)                -                   Define action
--  setOrientation(ORIENTATION)      -                   Set orientation
--  setWrt(DBREF)                    -                   Set with respect to
--  update(GADGET)                   -                   Update orientation with input data of passed gadget
--  update(GADGET,DIRECTION)         -                   Update orientation with direction to specific gadget
--
------------------------------------------------------------------------

-- Define object
define object ORIENTATIONLINK

  -- Orientation
  member .orientation  is ORIENTATION

  -- First Direction (must be a TEXT input and TOGGLE gadget)
  member .directionA   is STRING
  member .inputA       is GADGET

  -- Second Direction (must be a TEXT input and TOGGLE gadget)
  member .directionB   is STRING
  member .inputB       is GADGET

  -- Third Direction (must be a paragraph gadget)
  member .directionC   is STRING
  member .inputC       is GADGET

  -- With respect to
  member .wrt          is DBREF

  -- Function/Method to be actioned (what do we do the position data)
  member .action       is STRING

endobject
-- End of object definition for ORIENTATIONLINK

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Set default position
  !this.orientation = object ORIENTATION('Y is N')
  !this.wrt         = World

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      linkInput
--
-- Description: Define link input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      POSLINK object name, being linked to
--    2   R      STRING      First Direction
--    3   R      GADGET      First Direction input gadget
--    4   R      STRING      Second Direction
--    5   R      GADGET      Second Direction input gadget
--    6   R      STRING      Third Direction
--    7   R      GADGET      Third Direction input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkInput(!object is STRING, !strA is STRING, !dirA is GADGET, !strB is STRING, !dirB is GADGET, !strC is STRING, !dirC is GADGET)

  -- Set links

  -- Set callback on input gadget
  -- First Direction
  !this.inputA       = !dirA
  !this.directionA   = !strA
  if(!this.inputA.type() eq 'TEXT') then
    !this.inputA.callback = !object & '.newInput('
  endif

  -- Second Direction
  !this.inputB       = !dirB
  !this.directionB   = !strB
  if(!this.inputB.type() eq 'TEXT') then
    !this.inputB.callback = !object & '.newInput('
  endif

  -- Third Direction (must be paragraph gadget)
  !this.inputC       = !dirC
  !this.directionC   = !strC

  -- Set initial object
  !this.initialise()

endmethod
-- End of method definition for .linkInput(STRING, STRING, GADGET, STRING, GADGET, STRING, GADGET)

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description: Run action command
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .runAction()

  -- Execute action (may need a better way to execute method/functions)
  $!this.action

endmethod
-- End of method definition for .runAction()

------------------------------------------------------------------------
--
-- Method:      setAction
--
-- Description: Define action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Tag Method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setAction(!method is STRING)

  -- Check that a correct method/function has been passed

  -- Tag method
  !this.action = !method

endmethod
-- End of method definition for .setAction(STRING)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Return current orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION    Returns the current orientation for the object
--
------------------------------------------------------------------------

-- Define method
define method .orientation() is ORIENTATION
  return !this.orientation
endmethod
-- End of method definition for .orientation() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      get
--
-- Description: Return current orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ORIENTATION    Returns the current orientation for the object
--
------------------------------------------------------------------------

-- Define method
define method .get() is ORIENTATION
  return !this.orientation
endmethod
-- End of method definition for .get() ORIENTATION

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION New orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .orientation(!newOrientation is ORIENTATION)
  return !this.setOrientation(!newOrientation)
endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      setOrientation
--
-- Description: Set orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ORIENTATION New orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOrientation(!newOrientation is ORIENTATION)

  -- Convert to current wrt
  !tempOrientation  = !newOrientation.wrt(!this.wrt)

  -- Determine if input can be update
  !this.orientation = !tempOrientation

  -- Write orientation to display

  if(!this.directionA eq 'X') then
    !this.inputA.val = !this.orientation.xDir().string().before('WRT').trim()
  elseif (!this.directionA eq 'Y') then
    !this.inputA.val = !this.orientation.yDir().string().before('WRT').trim()
  elseif (!this.directionA eq 'Z') then
    !this.inputA.val = !this.orientation.zDir().string().before('WRT').trim()
  endif

  if(!this.directionB eq 'X') then
    !this.inputB.val = !this.orientation.xDir().string().before('WRT').trim()
  elseif (!this.directionB eq 'Y') then
    !this.inputB.val = !this.orientation.yDir().string().before('WRT').trim()
  elseif (!this.directionB eq 'Z') then
    !this.inputB.val = !this.orientation.zDir().string().before('WRT').trim()
  endif

  if(!this.directionC eq 'X') then
    !this.inputC.val = !this.directionC & ' is ' & !this.orientation.xDir().string().before('WRT').trim()
  elseif (!this.directionC eq 'Y') then
    !this.inputC.val = !this.directionC & ' is ' & !this.orientation.yDir().string().before('WRT').trim()
  elseif (!this.directionC eq 'Z') then
    !this.inputC.val = !this.directionC & ' is ' & !this.orientation.zDir().string().before('WRT').trim()
  endif

  -- Run action command
  !this.runAction()

endmethod
-- End of method definition for .setOrientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update orientation with input data of passed gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update(!gadget is GADGET)

  -- Update
  !this.newInput(!gadget, '')

endmethod
-- End of method definition for .update(GADGET)

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update orientation with direction to specific gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      DIRECTION   Direction to be updated
--- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update(!gadget is GADGET, !direction is DIRECTION)

  -- Get direction if wrt to current
  !gadget.val = !direction.wrt(!this.wrt).string().before(' WRT')

  -- Update
  !this.newInput(!gadget, '')

endmethod
-- End of method definition for .update(GADGET, DIRECTION)

------------------------------------------------------------------------
--
-- Method:      newInput
--
-- Description: Update orientation  with input data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
--- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .newInput(!gadget is GADGET, !dummy is STRING)

  -- Initialise Variables

  -- Check that data is a permissible direction
  !direction = !gadget.val.direction()
  handle any
    -- revert to original
    !this.setOrientation(!this.orientation)
    !!messageFile.error(151,200)
  endhandle

  -- Determine which gadget direction has been picked
  if(!gadget eq !this.inputA) then
    !dirStr       = !this.directionA
    !dirStrRef    = !this.directionB
    !otherGadget  = !this.inputB
  else
    !dirStr       = !this.directionB
    !dirStrRef    = !this.directionA
    !otherGadget  = !this.inputA
  endif

  -- Convert into new dirStr
  !newDirStr      = !dirStr    & ' is ' & !gadget.val  & ' wrt ' & !this.wrt
  !refDirStr      = !dirStrRef & ' is ' & !otherGadget & ' wrt ' & !this.wrt

  -- Derive the new orientation
  !newOrientation = object ORIENTATION(!newDirStr & ' and ' & !refDirStr)
  handle any
    -- revert to original
    !this.setOrientation(!this.orientation)
    !!messageFile.error(151,201)
  endhandle

  -- Set new dirStr
  !this.setOrientation(!newOrientation)

endmethod
-- End of method definition for .newInput(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Set with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Wrt element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt(!element is DBREF)

  -- Don't do anything if the element and origin are the same
  if(!this.wrt eq !element) then
    return
  endif

  -- Set new wrt
  !this.wrt         = !element

  -- Get orientation and Convert to New
  !newOrientation   = !this.orientation.wrt(!element)

  -- Set orientation
  !this.orientation = !newOrientation

  -- Re-display position (force information)
  !this.setOrientation(!newOrientation)

endmethod
-- End of method definition for .setWrt(DBREF)
