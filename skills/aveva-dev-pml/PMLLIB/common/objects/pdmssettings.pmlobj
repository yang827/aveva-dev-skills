--
--
-- Description:
-- Object to contain settings to be used in multiple modules.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  load()                           -                   load data from session file
--  pdmsSettings()                   -                   constructor
--

-- Define object
define object PDMSSETTINGS

  -- Setting used on reentry to Monitor
  member .projName     is STRING
  member .projNumb     is STRING
  member .project      is STRING
  member .user         is STRING
  member .mdb          is STRING
  member .module       is STRING
  member .restore      is BOOLEAN
  member .readOnly     is BOOLEAN

  -- Used when querying project elements (NAME/DESC)
  member .showAs       is STRING

endobject
-- End of object definition for PDMSSETTINGS

------------------------------------------------------------------------
--
-- Method:      !pdmsSettings()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pdmsSettings()

  !this.projName   = ''
  !this.projNumb   = ''
  !this.project    = ''
  !this.user       = ''
  !this.mdb        = ''
  !this.module     = 'MONITOR'
  !this.restore    = false
  !this.readOnly   = false
  !this.showAs     = 'NAME'

endmethod
-- End of method definition for .pdmsSettings()


------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load data from session file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- Get the users login name
  -- This line can be replaced once CURRENT SESSION can be used before
  -- the username and password have been set.
  VAR !login LOGIN

  -- See if the user has a sessions file
  !sessionFile = object FILE('%PDMSUSER%/session_' + !login)

  if (!sessionFile.exists()) then
    !fileData = !sessionFile.readFile()
  endif

  ----------------------------------------------
  -- parse the contents of the session file
  ----------------------------------------------

  -- Process the records returned
  do !line values !fileData

    -- Skip lines in the following cases
    skip if (!line.empty())
    skip if (!line.subString(1,1) eq |#|)

    -- Line has data so extract it
    if (!line.part(1) eq |PROJNAME|) then

      -- Assign project setting
      !this.projName  = !line.part(2)

    elseif (!line.part(1) eq |PROJNUMB|) then

      -- Assign code setting
      !this.projNumb  = !line.part(2)

    elseif (!line.part(1) eq |PROJECT|) then

      -- Assign code setting
      !this.project  = !line.part(2)

    elseif (!line.part(1) eq |USERNAME|) then

      -- Assign user setting
      !this.user     = !line.part(2)

    elseif (!line.part(1) eq |MDB|) then

      -- Assign Mdb setting
      !this.mdb      = !line.part(2)

    elseif (!line.part(1) eq |MODULE|) then

      -- Assign Module setting
      !this.module      = !line.part(2)

    elseif (!line.part(1) eq |RESTORE|) then

      -- Assign loadMethod setting
      !this.restore      = !line.part(2).boolean()

    elseif (!line.part(1) eq |READONLY|) then

      -- Assign loadMethod setting
      !this.readOnly      = !line.part(2).boolean()

    endif

  enddo

endmethod
-- End of method definition for .load()
