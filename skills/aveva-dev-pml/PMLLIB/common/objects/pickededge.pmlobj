--
-- Description:
-- Information about an boundary/extrusion edge.
--
------------------------------------------------------------------------

-- Define object
define object PICKEDEDGE

  -- Edge number
  member .number         is REAL
  -- Edge nearest to line (as a vector) on picked surface
  member .line           is VECTOR
  -- Edge as a (line object)  -- Surface picked as a plane
  member .finiteLine     is FINITELINE
  -- Surface actual picked (TOP/BOTTOM)
  member .surface        is STRING
  -- Surface picked as a plane
  member .pickedPlane    is VECTOR
  -- Opposite surface as a plane
  member .oppositePlane  is VECTOR
  -- Position on the Surface
  member .surfacePos     is POSITION
  -- Position nearest pick on edge
  member .edgePos        is POSITION
  -- Vertex at beginning of edge
  member .vertex         is DBREF
  -- Distance from pick to edge
  member .distance       is REAL

endobject
-- End of object definition for PICKEDEDGE
