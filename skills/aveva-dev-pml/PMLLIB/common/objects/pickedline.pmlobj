-- Description:
-- Information about an boundary/extrusion edge.
--
------------------------------------------------------------------------

-- Define object
define object PICKEDLINE

  -- Line segment number
  member .number          is REAL
  -- Line nearest to line (as a vector) on picked surface
  member .line            is VECTOR
  -- Line segment as a (line object)  -- Surface picked as a plane
  member .finiteLine      is FINITELINE
  -- Position on line picked
  member .position        is POSITION
  -- Element at beginning of Line segment
  member .point           is DBREF
  -- Distance from start/End
  member .distance        is REAL
  -- Nearest End of Pick
  member .end             is STRING

endobject
-- End of object definition for PICKEDLINE
