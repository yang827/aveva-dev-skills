-- Description:
--   Information about the surface of a panel/extrusion
--
------------------------------------------------------------------------

-- Define object
define object PICKEDSURFACE

  -- Extrusion
  member .extrusion      is DBREF
  -- Surface actual picked (TOP/BOTTOM)
  member .surface        is STRING
  -- Surface picked as a plane
  member .pickedPlane    is VECTOR
  -- Opposite surface as a plane
  member .oppositePlane  is VECTOR
  -- Position on the Surface
  member .surfacePos     is POSITION

endobject
-- End of object definition for PICKEDSURFACE
