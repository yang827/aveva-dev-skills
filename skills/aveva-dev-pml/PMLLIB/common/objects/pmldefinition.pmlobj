-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pmlDefinition(FILE)              -                   Constructor
--  pmlDefinition(FILE,STRING)       -                   Constructor
--  read()                           -                   Read file
--  string()                         STRING              String definition
--

define object PMLDEFINITION

  -- File
  member .file      is FILE

  -- PML File index
  member .index     is FILE

  -- Type of file
  member .type      is STRING

  -- Definition name
  member .name      is STRING

  -- File date time modified
  member .dtm       is DATETIME

  -- Derived data when item has been opened
  -- Return
  member .return    is STRING

  -- Arguments to object/function
  member .arguments is ARRAY

  -- Methods within the file
  member .methods   is ARRAY

  -- Members
  member .members   is ARRAY

endobject
-- End of object definition

----------------------------------------------------------------------
--
-- Method:      pmlDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlDefinition(!index is FILE, !filename is STRING)

  -- Initialise Variables

  -- Get file data
  !this.file   = object FILE(!filename)
  handle ANY
    return
  endhandle

  !this.index  = !index
  !this.name   = !this.file.entry().part(1, '.')
  !fileType    = !filename.part(-1, '.')

  if(!fileType eq 'pmlfrm') then
    !this.type = 'form'
  elseif (!fileType eq 'pmlobj') then
    !this.type = 'object'
  elseif (!fileType eq 'pmlfnc') then
    !this.type = 'function'
  elseif (!fileType eq 'pmldat') then
    !this.type = 'data'
  elseif (!fileType eq 'pmlmac') then
    !this.type = 'macro'
  elseif (!fileType eq 'png') then
    !this.type = 'icon'
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      pmlDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlDefinition(!file is FILE)

  -- Initialise Variables

  -- Get file data
  !this.file   = !file
  handle ANY
    return
  endhandle
  !filename    = !file.entry()
  !fileType    = !filename.part(-1, '.')
  handle ANY
    !!alert.warning('File ' & !filename & ' does not have an extension.')
    return
  endhandle

  -- Set data
  !this.index  = object FILE()
  !this.name   = !this.file.entry().part(1, '.')

  if(!fileType eq 'pmlfrm') then
    !this.type = 'form'
  elseif (!fileType eq 'pmlobj') then
    !this.type = 'object'
  elseif (!fileType eq 'pmlfnc') then
    !this.type = 'function'
  elseif (!fileType eq 'pmldat') then
    !this.type = 'data'
  elseif (!fileType eq 'pmlmac') then
    !this.type = 'macro'
  elseif (!fileType eq 'png') then
    !this.type = 'icon'

  else
    !!alert.warning('File ' & !filename & ' does not have recognised extension.')
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      read
--
-- Description: Read file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .read()

  -- Initialise Variables
  !definitionName = !this.file.entry().before('.').lowcase()

  -- Check if we need to load the file
  !load = !this.dtm ne !this.file.dtm()

  -- Load the form
  if(!load) then

    -- Initialise Data
    !this.return    = STRING()
    !this.arguments = ARRAY()
    !this.methods   = ARRAY()
    !this.members   = ARRAY()

    !this.dtm = !this.file.dtm()

    -- Ignore all but forms, objects and functions
    if(!this.type inset('form','function','object')) then

      -- Read file contents
      !records = !this.file.readFile()

      -- Loop through the records
      do !i  indices !records

        skip if(!records[!i].empty())

        !record = !records[!i]

        !part1  = !record.trim().upcase().part(1)

        -- Handle Definitions
        if(!part1 eq 'DEFINE') then

          !define      = !record.part(2).upcase()
          !name        = !record.after(!define).before('(').trim()

          -- Get method definition
          if(!define inset('METHOD','FUNCTION')) then

            -- Get definition of method
            !definition = object PMLMETHOD(!record, !i)

            -- Define method argument definition
            !this.methods.append(!definition)

            -- If the name and the definition name (when both lower cased)
            -- are the same. Use the method name
            if(!definition.name.lowcase() eq !definitionName) then
              !this.name = !definition.name
            endif

          -- Object definition
          elseif (!define eq 'OBJECT') then
            !this.name = !record.part(3).upcase()

          endif

        -- Handle Members
        elseif (!part1 eq 'MEMBER') then
          !this.members.append(!record.after(!record.trim().part(1)).trim())

        -- Handle Form Setup
        elseif (!part1 eq 'SETUP') then
          !this.name   = !record.part(3).trim().after('!!')

        -- Handle endmethod
        elseif (!part1 eq 'ENDMETHOD') then
          !index       = !this.methods.size()
          !this.methods[!index].end(!i)
        endif

      enddo

    endif

  endif


endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      string
--
-- Description: String definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .string() is STRING

  -- Initialise Variables

  -- Handle unset file
  if(!this.file.unset()) then
    return 'Unset'
  else
    return !this.type.upcase() & ' ' & !this.name
  endif

endmethod
-- End of method
