--
--
-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arguments()                      ARRAY               Return arguments
--  end(REAL)                        -                   End line
--  pmlMethod(STRING)                -                   Constructor
--  pmlMethod(STRING,REAL)           -                   Constructor
--  return()                         STRING              Return string
--  start(REAL)                      -                   Start line
--

define object PMLMETHOD

  -- Method Name
  member .name          is STRING

  -- Return data
  member .return        is STRING

  -- Argument Names
  member .arguments     is ARRAY
  member .argumentTypes is ARRAY

  -- Start Line
  member .start         is REAL

  -- End Line
  member .end           is REAL

  -- Definition string
  member .definition    is STRING

endobject
-- End of object definition

----------------------------------------------------------------------
--
-- Method:      pmlMethod
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlMethod(!record is STRING)

  -- Get Name
  !define            = !record.part(2)
  !this.name         = !record.after(!define).before('(').trim()

  -- Definition string
  !this.definition   = !this.name

  -- Arguments
  !arguments         = !record.after('(').before(')')

  -- Split arguments into component parts
  if(!arguments.trim().empty().not()) then
    !this.definition = !this.definition & '('
    !argString       = ''
    !args            = !arguments.split(',')

    do !i indices !args
      !this.arguments.append(!args[!i].part(1))
      !type          = !args[!i].part(3)
      !this.argumentTypes.append(!type)
      !argString     = !argString & ', <' & !type & '>'
    enddo

    !this.definition = !this.definition & !argString.subString(3) & ')'

  -- No arguments
  else
    !this.definition = !this.definition & '()'
  endif

  -- Get return
  !return            = !record.after(')')
  if(!return.trim().empty().not()) then
    !this.return     = !return.after('is').trim()
    !this.definition = !this.definition & ' is <' & !this.return & '>'
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      pmlMethod
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlMethod(!record is STRING, !lineNumber is REAL)

  -- Get data
  !this.pmlMethod(!record)

  -- Set start line
  !this.start(!lineNumber)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      start
--
-- Description: Start line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .start(!lineNumber is REAL)
  !this.start = !lineNumber
endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      end
--
-- Description: End line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .end(!lineNumber is REAL)
  !this.end = !lineNumber
endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      return
--
-- Description: Return string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .return() is STRING

  -- Return
  if(!this.return.unset()) then
    return '<none>'
  else
    return '<' & !this.return & '>'
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      arguments
--
-- Description: Return arguments
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arguments() is ARRAY

  -- Initialise Variables
  !return = ARRAY()

  -- Get arguments
  if(!this.arguments.empty()) then
    !return.append('<none>')
  else

    !width = !this.argumentTypes.width() + 2

    -- Loop though arguments
    do !i indices !this.arguments
      var !dprt compose space 1 '[$!i]' width 4 r space 1 '<$!this.argumentTypes[$!i]>' width $!<width> c space 1 '$!this.arguments[$!i]'
      !return.append(!dprt[1])
    enddo

  endif

  -- Return
  return !return

endmethod
-- End of method
