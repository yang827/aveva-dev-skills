--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  calculatePolyline(ARRAY,ARRAY)   -                   Constructor
--  dbWrite(DBREF)                   -                   create a db element from the given object
--  draw(REAL,REAL,REAL)             ARRAY               get the edges of the object
--  edges()                          ARRAY               get the edges of the object
--  isFillet(REAL)                   BOOLEAN             is the given edge a fillet
--  length()                         REAL                get the length of the object
--  mergeLines()                     POLYLINE            remove colinear contiguous lines into one
--  mirror(LINE)                     POLYLINE            mirror on a line
--  nearEdges(POSITION)              ARRAY               gets the nearest edges
--  plane()                          PLANE               get the plane of the object
--  polyline(DBREF)                  -                   Constructor
--  polyline(POSITION,ORIENTATION,ARRAY) -                   Constructor
--  polyline(POSITION,ORIENTATION,ARRAY,ARRAY) -                   Constructor
--  vertices()                       ARRAY               get the vertices of the object with the radiuses
--
define object POLYLINE

  -- diameter of the circular shape
  member .position          is POSITION

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .orientation       is ORIENTATION

  -- all edges (lines and arcs)
  member .edges             is ARRAY

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      polyline
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .polyline(!position is POSITION, !orientation is ORIENTATION, !edges is ARRAY)

  !this.position    = !position
  !this.orientation = !orientation
  !this.edges       = !edges

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      polyline
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .polyline(!position is POSITION, !orientation is ORIENTATION, !vertices is ARRAY, !radius is ARRAY)

  !this.position    = !position
  !this.orientation = !orientation

  !this.calculatePolyline(!vertices, !radius)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      polyline
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbref object
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .polyline(!dbRef is DBREF)

  !type = !dbRef.type
  if ( !type.eq('RPATH') ) then
    !this.position    = !dbRef.owner.position
    !this.orientation = !dbRef.owner.orientation
  endif

  !vertices = ARRAY()
  !radius   = ARRAY()
  do !member value !dbRef.members
    if ( !type.eq('RPATH') ) then
      !vertices.append(!member.position.wrt(WORLD))
      !radius.append(!member.fRadius)
    endif
  enddo

  !this.calculatePolyline(!vertices, !radius)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      calculatePolyline
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       the vertex points
--    2   R      ARRAY       the radiuses related to the vertex points
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .calculatePolyline(!vertices is ARRAY, !radius is ARRAY)

  -- first of all create an array of vertex points and arcs
  !vertexArcs = ARRAY()
  do !i index !vertices
    -- Radius is 0
    if ( !i inset (1, !vertices.size()) or $
         !radius[!i].eq(0) ) then
      !vertexArcs.append(!vertices[!i])

    -- Radius is unequal 0, append the arc
    else
      !plane = !vertices[!i].plane(!vertices[!i - 1], !vertices[!i + 1])
      handle any
        !vertexArcs.append(!vertices[!i])
        skip
      endhandle

      !arc   = !vertices[!i].arcFillet(!vertices[!i - 1], !vertices[!i + 1], !plane.orientation.zDir(), !radius[!i])
      !vertexArcs.append(!arc)
    endif
  enddo

  -- complete the arcs with lines
  !edges = ARRAY()
  do !i index !vertexArcs
    skip if ( !i.eq(!vertices.size()) )

    -- skip if vertex lies on previous one
    skip if ( !vertices[!i].distance(!vertices[!i + 1]).lt(1) )

    -- define the start position of the line
    if ( !vertexArcs[!i].objectType().eq('POSITION') ) then
      !startPosition = !vertexArcs[!i]
    else
      -- append the arc to the edges and use the end of the arc as startposition of the line
      !edges.append(!vertexArcs[!i])
      !startPosition = !vertexArcs[!i].angleposition(!vertexArcs[!i].endangle)
    endif

    -- define the end position of the line
    if ( !vertexArcs[!i + 1].objectType().eq('POSITION') ) then
      !endPosition = !vertexArcs[!i + 1]
    else
      -- use the start of the arc as startposition of the line
      !endPosition = !vertexArcs[!i + 1].angleposition(!vertexArcs[!i + 1].startangle)
    endif

    -- check the distance
    !distance = !startPosition.distance(!endPosition)
    if ( !distance.gt(0) ) then
      !edges.append(object LINE(!startPosition, !endPosition))
    endif
  enddo
  !this.edges = !edges

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbWrite
--
-- Description: create a db element from the given object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbWrite(!dbRef is DBREF)

  !getVertices = !this.vertices()
  !vertices    = !getVertices[1]
  !radius      = !getVertices[2]

  !type        = !dbRef.type

  do !i index !vertices
    if ( !type.eq('RPATH') ) then
      NEW POINTR
    elseif ( !type.eq('SPINE') ) then
      NEW POINSP
    endif
    !!ce.position = !vertices[!i]
    if ( !type.eq('RPATH') ) then
      !!ce.fRadius = !radius[!i]
    endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: get the edges of the object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       edges
------------------------------------------------------------------------

define method .draw(!number is REAL, !lineType is REAL, !colour is REAL) is ARRAY

  do !i index !this.edges
    !this.edges[!i].draw(!number, !lineType, !colour)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edges
--
-- Description: get the edges of the object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       edges
------------------------------------------------------------------------

define method .edges() is ARRAY

  return !this.edges

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isFillet
--
-- Description: is the given edge a fillet
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        number of edge
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if fillet
------------------------------------------------------------------------

define method .isFillet(!number is REAL) is BOOLEAN

  if ( !number inset (1, !this.edges.size()) or $
       !this.edges[!number].objectType().neq('ARC') ) then
    return false
  endif

  -- get the directions of the previous/next edges
  !previousEdge = !this.edges[!number - 1]
  if ( !previousEdge.objectType().eq('LINE') ) then
    !previousDirection = !previousEdge.direction()
  else
    !previousDirection = !previousEdge.endTangent()
  endif
  !nextEdge     = !this.edges[!number + 1]
  if ( !nextEdge.objectType().eq('LINE') ) then
    !nextDirection = !nextEdge.direction()
  else
    !nextDirection = !nextEdge.startTangent()
  endif

  -- check whether the tangential directions are equal to the previous/next directions
  !angleToPrevious = !this.edges[!number].startTangent().angle(!previousDirection)
  !angleToNext     = !this.edges[!number].endTangent().angle(!nextDirection)
  !return          = !angleToPrevious.lt(0.1) and $
                     !angleToNext.lt(0.1)

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      length
--
-- Description: get the length of the object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       polyline plane
------------------------------------------------------------------------

define method .length() is REAL

  !length = 0

  do !i index !this.edges
    !length = !length + !this.edges[!i].length()
  enddo

  return !length

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeLines
--
-- Description: remove colinear contiguous lines into one
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POLYLINE    the mirrored polyline object
------------------------------------------------------------------------

define method .mergeLines() is POLYLINE

  !edges = !this.edges()

  do
    !mergeFlag = false
    do !i index !edges
      skip if ( !i.eq(!edges.size()) )

      skip if ( !edges[!i].objectType().eq('ARC') or $
                !edges[!i + 1].objectType().eq('ARC') )

      if ( !edges[!i].direction().isParallel(!edges[!i + 1].direction()) ) then
        !edges[!i] = !edges[!i].union(!edges[!i + 1])
        !edges.remove(!i + 1)
        !mergeFlag = true
        break
      endif
    enddo
    break if ( !mergeFlag.not() )
  enddo

  return object POLYLINE(!this.position, !this.orientation, !edges)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: mirror on a line
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        the line to be mirrored on
-- Return:
--   [Data Type] [Description]
--    POLYLINE    the mirrored polyline object
------------------------------------------------------------------------

define method .mirror(!line is LINE) is POLYLINE

  !pos1  = !line.startPosition
  !pos2  = !line.endPosition
  !pos3  = !pos1.offset(U, 10000)
  !plane = !pos1.plane(!pos2, !pos3)

  !edges = ARRAY()

  do !i index !this.edges

    -- mirror the line
    if ( !this.edges[!i].objectType().eq('LINE') ) then
      !line            = !this.edges[!i]
      !edges[!i]       = !line

      !startPosOnPlane = !plane.near(!line.startPosition)
      !distance        = !line.startPosition.distance(!startPosOnPlane)
      if ( !distance.gt(0) ) then
        !direction               = !line.startPosition.direction(!startPosOnPlane)
        !edges[!i].startPosition = !line.startPosition.offset(!direction, 2 * !distance)
      endif

      !endPosOnPlane   = !plane.near(!line.startPosition)
      !distance        = !line.endPosition.distance(!endPosOnPlane)
      if ( !distance.gt(0) ) then
        !direction             = !line.endPosition.direction(!endPosOnPlane)
        !edges[!i].endPosition = !line.endPosition.offset(!direction, 2 * !distance)
      endif

    -- mirror the arc
    elseif ( !this.edges[!i].objectType().eq('ARC') ) then

      !arc             = !this.edges[!i]
      !edges[!i]       = !arc

      !positionOnPlane = !plane.near(!arc.position)
      !distance        = !arc.position.distance(!positionOnPlane)
      if ( !distance.gt(0) ) then
        !direction          = !arc.position.direction(!positionOnPlane)
        !edges[!i].position = !arc.position.offset(!direction, 2 * !distance)
      endif


    endif
  enddo

  return !edges

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nearEdges
--
-- Description: gets the nearest edges
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position
-- Return:
--   [Data Type] [Description]
--    ARRAY       edges
------------------------------------------------------------------------

define method .nearEdges(!position is POSITION) is ARRAY

  !distances    = object ARRAY()
  !edgesIndices = object ARRAY()

  do !i index !this.edges
    -- ignore invalid edges
    skip if ( !this.edges[!i].onProjected(!position).not() )

    -- evaluates and stores the distance between position and the projected position
    !projectedPosition = !this.edges[!i].near(!position)
    !distances.append(!position.distance(!projectedPosition))
    !edgesIndices.append(!i)
  enddo

  -- sort
  !sortedIndices = !distances.sortedIndices()

  return !edgesIndices.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: get the plane of the object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       polyline plane
------------------------------------------------------------------------

define method .plane() is PLANE

  return object PLANE(!this.position, !this.orientation)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      vertices
--
-- Description: get the vertices of the object with the radiuses
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       vertices and radiuses
------------------------------------------------------------------------

define method .vertices() is ARRAY

  !edges           = !this.edges()
  if ( !edges.empty() ) then
    !return[1] = ARRAY()
    !return[2] = ARRAY()
    return !return
  endif

  !vertices    = ARRAY()
  !radius      = ARRAY()
  !currentEdge = !edges[1]

  do !i index !edges
    !currentEdge.delete()
    !currentEdge = !edges[!i]
    if ( !i.eq(1) ) then
      !previousIdx = !edges.size()
    else
      !previousIdx = !i - 1
    endif
    if ( !i.eq(!edges.size()) ) then
      !nextIdx = 1
    else
      !nextIdx = !i + 1
    endif

    -- take start/end of line only if there is no following arc as a fillet
    if ( !currentEdge.objectType().eq('LINE') ) then
      if ( !edges[!previousIdx].objectType().eq('ARC') and $
           !this.isFillet(!previousIdx).not()       or  $
           !edges[!previousIdx].objectType().eq('LINE') ) then
        !vertices.append(!currentEdge.startPosition)
        !radius.append(0)
      endif
      if ( !edges[!nextIdx].objectType().eq('ARC') and $
           !this.isFillet(!nextIdx).not()  ) then
        !vertices.append(!currentEdge.endPosition)
        !radius.append(0)
      endif
    elseif ( !currentEdge.objectType().eq('ARC') ) then
      !line1 = !currentEdge.anglePosition(!currentEdge.startAngle).line(!currentEdge.anglePosition(!currentEdge.startAngle).offset(!currentEdge.startTangent(), 1000))
      !line2 = !currentEdge.anglePosition(!currentEdge.endAngle).line(!currentEdge.anglePosition(!currentEdge.endAngle).offset(!currentEdge.endTangent(), 1000))
      !vertices.append(!line1.intersection(!line2))
      handle ANY
      endhandle
      !radius.append(!currentEdge.radius)
    endif

    if ( !i.eq(!edges.size()) ) then
      !vertices.append(!currentEdge.endPosition)
      handle ANY
      endhandle
      !radius.append(0)
    endif
  enddo

  !return[1] = !vertices
  !return[2] = !radius
  return !return

endmethod
-- End of method
