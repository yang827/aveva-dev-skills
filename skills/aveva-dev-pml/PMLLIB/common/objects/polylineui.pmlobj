--
-- Description:     controls the appearance of the polyline form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  load()                           -                   loads the form
--  polylineUI()                     -                   default constructor
--

-- Define object
define object polylineUI

  -- the profile object to be modified (can also be an empty string for create)
  member .acceptCallback  is STRING

  -- display text for the accept button
  member .acceptDText     is STRING

  -- flag to open the form in create of modify status
  member .create          is BOOLEAN

  -- discard callback (e.g. !!myForm.profileDiscard(!this.meProfiles))
  member .discardCallback is STRING

  -- display text for the discard button
  member .discardDText    is STRING

  -- form title
  member .formTitle       is STRING

  -- the profile object to be modified (can also be an empty string for create)
  member .polyline        is POLYLINE

  -- true if only 2D
  member .twoDFlag        is BOOLEAN

endobject
-- End of object definition for polylineUI

------------------------------------------------------------------------
--
-- Method:      polylineUI
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .polylineUI()

  !this.create   = false
  !this.twoDFlag = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: loads the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .load()

  -- show the form
  show !!polylineUI

  -- set the title
  !!polylineUI.formTitle = !this.formTitle

  -- load the profile for modification
  !!polylineUI.mePolylines.clear()
  if ( !this.polyline.set() ) then
    !!polylineUI.mePolylines[1] = !this.polyline
  endif

  !!polylineUI.me2DFlag = !this.twoDFlag

  -- open the form in create or modify mode
  if ( !this.create ) then
    !!polylineUI.create()
  else
    !!polylineUI.modify()
  endif

  -- buttons
  !!polylineUI.lkAcceptChanges.tag  = !this.acceptDText
  !!polylineUI.lkDiscardChanges.tag = !this.discardDText

  -- store the callbacks in the form
  !!polylineUI.meAcceptCallback  = !this.acceptCallback
  !!polylineUI.meDiscardCallback = !this.discardCallback

endmethod
-- End of method
