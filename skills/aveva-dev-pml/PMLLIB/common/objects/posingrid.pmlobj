--
--
-- Description:
-- World and Grid coords
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draw(REAL)                       -                   Mark position with aid graphics
--  posInGrid(DBREF,POSITION)        -                   Constructor
--
------------------------------------------------------------------------

-- Define object
define object POSINGRID

  -- Origin
  member .world        is DBREF

  -- Grid definition
  member .gridSystem   is DBREF

  -- Position picked
  member .position     is POSITION

  -- World coord value strings
  member .east         is STRING
  member .north        is STRING
  member .up           is STRING

  -- Nearest gridlines
  member .xNearest     is DBREF
  member .yNearest     is DBREF
  member .zNearest     is DBREF

  -- Grid coord value strings
  member .xCoord       is STRING
  member .yCoord       is STRING
  member .zCoord       is STRING

endobject
-- End of object definition for POSINGRID

------------------------------------------------------------------------
--
-- Method:      posInGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Grid system
--    2   R      POSITION    Position to be converted to grid coords
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posInGrid(!gridSystem is DBREF, !position is POSITION)

  -- Set grid system and picked position
  if (!gridSystem.type ne |GRIDSY|) then
    return error 1 |$!gridSystem is not a Grid System|
  endif
  !this.gridSystem = !gridSystem
  !world = |/*|
  !this.world = !world.dbref()
  !this.position = !position.wrt(!this.world)

  -- Set axes label
  if (!this.gridSystem.purpose eq |RADI|) then
    !axis1 = |A|
    !axis2 = |R|
    !axis3 = |Z|
  else
    !axis1 = |X|
    !axis2 = |Y|
    !axis3 = |Z|
  endif

  -- For mm give rounded coords with unit tag to match refgrid output
  !format = !!distanceFmt
  if (!format.units eq |MM|) then
    !format.dp = 0
    !format.label = |mm|
  endif

  -- Format world position strings
  !this.east  = !this.position.string().part(1) & | | & !this.position.east.abs().string(!format)
  !this.north = !this.position.string().part(3) & | | & !this.position.north.abs().string(!format)
  !this.up    = !this.position.string().part(5) & | | & !this.position.up.abs().string(!format)

  -- Get nearest grid lines
  !refGrid = object REFGRID(!this.gridSystem)
  !this.xNearest = !refGrid.getNearest(!axis1, !this.position)
  !this.yNearest = !refGrid.getNearest(!axis2, !this.position)
  !this.zNearest = !refGrid.getNearest(!axis3, !this.position)

  -- Format position in grid coords
  !this.xCoord = !refGrid.format(!this.xNearest, !this.position)
  !this.yCoord = !refGrid.format(!this.yNearest, !this.position)
  !this.zCoord = !refGrid.format(!this.zNearest, !this.position)

endmethod
-- End of method definition for .posInGrid(DBREF,POSITION)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Mark position with aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  -- Mark position
  !text = |Position|
  AID CLEAR ALL $!aidNumber
  AID TEXT NUMBER $!aidNumber |$!text| AT $!this.position

endmethod
-- End of method definition for .draw(REAL)
