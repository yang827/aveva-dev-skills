--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Dec 1 18:23:22 WAT 1997
--
--
-- Description:
-- Standard 3D Positioning Linkage object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(BOOLEAN)                  -                   Grey/un-grey all linked gadgets, maintain greying on locked gadgets when associated gadgets are made active
--  get()                            POSITION            Return current position
--  initialise()                     -                   Initialisation
--  linkInput(STRING,GADGET,GADGET,GADGET) -                   Link input gadgets
--  linkLock(STRING,GADGET,GADGET,GADGET) -                   Link input gadgets
--  linkOption(STRING,GADGET,GADGET,GADGET,STRING) -                   Link option gadgets
--  newInput(GADGET,STRING)          -                   Update position with input data
--  position()                       POSITION            Get current position
--  position(POSITION)               -                   Set position, use locks and action
--  position(POSITION,BOOLEAN,BOOLEAN) -                   Set position, supply whether the action is run and is the lock are to be used.
--  runAction()                      -                   Run action command
--  setAction(STRING)                -                   Set action
--  setLock(GADGET,STRING)           -                   Set lock on relevant gadgets
--  setPosition(POSITION)            -                   Set position
--  setPositionForce(POSITION)       -                   Set position
--  setPositionNoAct(POSITION)       -                   Set position (no action is carried out)
--  setWrt(DBREF)                    -                   Set with respect to
--  unlockAll()                      -                   Unlock all gadgets
--
------------------------------------------------------------------------

-- Define object
define object POSITIONLINK

  -- Position
  member .position   is POSITION

  -- All gadget are stored in an ARRAY X = [1], Y = [2], Z = [3]
  -- XYZ text input fields
  member .input      is ARRAY
  -- XYZ lock toggles
  member .lock       is ARRAY
  -- XYZ Options
  member .option     is ARRAY

  -- With respect to
  member .wrt        is DBREF

  -- Function/Method to be actioned (what do we do the position data)
  member .action     is STRING

endobject
-- End of object definition for POSITIONLINK

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Set default position
  !this.position = object POSITION('N0')
  !this.wrt      = World

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      linkInput
--
-- Description: Link input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      positionLink object name, being linked to
--    2   R      GADGET      X input gadget
--    3   R      GADGET      Y input gadget
--    4   R      GADGET      Z input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkInput(!object is STRING, !xInput is GADGET, !yInput is GADGET, !zInput is GADGET)

  -- Set callback on input gadget
  if(!xInput.set()) then
    !this.input[1]   = !xInput
    if(!xInput.type() eq 'TEXT') then
      !xInput.callback = !object & '.newInput('
    endif
  endif

  if(!yInput.set()) then
   !this.input[2]   = !yInput
   if(!yInput.type() eq 'TEXT') then
      !yInput.callback = !object & '.newInput('
    endif
  endif

 if(!zInput.set()) then
   !this.input[3]   = !zInput
   if(!zInput.type() eq 'TEXT') then
     !zInput.callback = !object & '.newInput('
   endif
 endif

  -- Set initial object
  !this.initialise()

endmethod
-- End of method definition for .linkInput(STRING, GADGET, GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      linkLock
--
-- Description: Link input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      positionLink object name, being linked to
--    2   R      GADGET      X input gadget
--    3   R      GADGET      Y input gadget
--    4   R      GADGET      Z input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkLock(!object is STRING, !xLock is GADGET, !yLock is GADGET, !zLock is GADGET)

  -- Set links
  -- Set callback on lock gadget
  if(!xLock.set()) then
    !this.lock[1]   = !xLock
    !xLock.callback = !object & '.setLock('
  endif
  if(!yLock.set()) then
    !this.lock[2]   = !yLock
    !yLock.callback = !object & '.setLock('
  endif
  if(!zLock.set()) then
    !this.lock[3]   = !zLock
    !zLock.callback = !object & '.setLock('
  endif

endmethod
-- End of method definition for .linkLock(STRING, GADGET, GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      linkLock
--
-- Description: Link option gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      positionLink object name, being linked to
--    2   R      GADGET      X input gadget
--    3   R      GADGET      Y input gadget
--    4   R      GADGET      Z input gadget
--    5   R      STRING      Type of Option ENU or XYZ
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkOption(!object is STRING, !xOpt is GADGET, !yOpt is GADGET, !zOpt is GADGET, !type is STRING)

  -- Set links
  -- Set callback on option gadget
  if(!xOpt.set()) then
    !this.option[1]   = !xOpt
    !xOpt.callback = !object & '.newInput('
  endif

  if(!yOpt.set()) then
    !this.option[2]   = !yOpt
    !yOpt.callback = !object & '.newInput('
  endif

  if(!zOpt.set()) then
    !this.option[3]   = !zOpt
    !zOpt.callback = !object & '.newInput('
  endif

  -- Define Options
  !rText[1] = '1'
  !rText[2] = '-1'

  -- East, North, Up
  if(!type.upcase() eq 'ENU') then
    -- East/West
    if(defined(!this.option[1])) then
      !dText[1] = 'East'
      !dText[2] = 'West'
      !xOpt.dText = !dText
      !xOpt.rText = !rText
    endif

    -- North/South
    if(defined(!this.option[2])) then
      !dText[1] = 'North'
      !dText[2] = 'South'
      !yOpt.dText = !dText
      !yOpt.rText = !rText
    endif

    -- Up/Down
    if(defined(!this.option[3])) then
      !dText[1] = 'Up'
      !dText[2] = 'Down'
      !zOpt.dText = !dText
      !zOpt.rText = !rText
    endif

  -- X, Y, Z
  else
    -- East/West
    if(defined(!this.option[1])) then
      !dText[1] = 'X'
      !dText[2] = '-X'
      !xOpt.dText = !dText
      !xOpt.rText = !rText
    endif

    -- North/South
    if(defined(!this.option[2])) then
      !dText[1] = 'Y'
      !dText[2] = '-Y'
      !yOpt.dText = !dText
      !yOpt.rText = !rText
    endif

    -- Up/Down
    if(defined(!this.option[3])) then
      !dText[1] = 'Z'
      !dText[2] = '-Z'
      !zOpt.dText = !dText
      !zOpt.rText = !rText
    endif
  endif

endmethod
-- End of method definition for .linkOption(STRING, GADGET, GADGET, GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description: Run action command
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .runAction()

  -- Execute action (may need a better way to execute method/functions)
  $!this.action

endmethod
-- End of method definition for .runAction()

------------------------------------------------------------------------
--
-- Method:      setAction
--
-- Description: Set action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Tag Method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setAction(!method is STRING)

  -- Tag method
  !this.action = !method

endmethod
-- End of method definition for .setAction(STRING)

------------------------------------------------------------------------
--
-- Method:      get
--
-- Description: Return current position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Returns the current position for the object
--
------------------------------------------------------------------------

-- Define method
define method .get() is POSITION
  return !this.position
endmethod
-- End of method definition for .get() POSITION

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPosition(!newPosition is POSITION)

  -- Set position
  !this.position(!newPosition, true, false)

endmethod
-- End of method definition for .setPosition(POSITION)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Get current position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Returns the current position for the object
--
------------------------------------------------------------------------

-- Define method
define method .position() is POSITION
  return !this.position
endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position, use locks and action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .position(!newPosition is POSITION)
   !this.position(!newPosition, true, false)
 endmethod

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position, supply whether the action is run and is the lock are to be used.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New Position
--    2   R      BOOLEAN     Run action
--    3   R      BOOLEAN     Force result
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .position(!newPosition is POSITION, !action is BOOLEAN, !force is BOOLEAN)

  -- Set position
  !tempPosition = !newPosition.wrt(!this.wrt)

  -- Set gadgets

  -- East/West
  if(!this.input[1].active or !force) then
    if(defined(!this.option[1])) then
      if(!tempPosition.east lt 0) then
        !this.option[1].select('RTEXT', '-1')
      elseif(!tempPosition.east gt 0) then
        !this.option[1].select('RTEXT', '1')
      endif

      !value = !tempPosition.east.abs()
    else
      !value = !tempPosition.east
    endif

    -- Assign to gadget
    !this.input[1].val = !value
    handle any
      !this.input[1].val = !value.string()
    endhandle

    -- Set New Easting
    !this.position.east = !tempPosition.east

  endif

  -- North/South
  if(!this.input[2].active or !force) then
    if(defined(!this.option[2])) then
      if(!tempPosition.north lt 0) then
        !this.option[2].select('RTEXT', '-1')
      elseif(!tempPosition.north gt 0) then
        !this.option[2].select('RTEXT', '1')
      endif
      !value = !tempPosition.north.abs()
    else
      !value = !tempPosition.north
    endif

    -- Assign to gadget
    !this.input[2].val = !value
    handle any
      !this.input[2].val = !value.string()
    endhandle

    -- Set New Northing
    !this.position.north = !tempPosition.north

  endif

  -- Up/Down
  if(!this.input[3].active or !force) then
    if(defined(!this.option[3])) then
      if(!tempPosition.up lt 0) then
        !this.option[3].select('RTEXT', '-1')
      elseif(!tempPosition.up gt 0) then
        !this.option[3].select('RTEXT', '1')
       endif
      !value = !tempPosition.up.abs()
    else
      !value = !tempPosition.up
    endif

    -- Assign to gadget
    !this.input[3].val = !value
    handle any
      !this.input[3].val = !value.string()
    endhandle

    -- Set New Upping
    !this.position.up = !tempPosition.up

  endif

  -- Run action command
  if(!action) then
    !this.runAction()
  endif

endmethod
-- End of method definition for .position(POSITION, BOOLEAN, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setPositionNoAct
--
-- Description: Set position (no action is carried out)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPositionNoAct(!newPosition is POSITION)

  !this.position(!newPosition, false, false)
  return

  -- Set position
  !tempPosition = !newPosition.wrt(!this.wrt)

  -- Set gadgets

  -- East/West
  if(!this.input[1].active) then
    if(defined(!this.option[1])) then
      if(!tempPosition.east lt 0) then
        !this.option[1].select('RTEXT', '-1')
      else
        !this.option[1].select('RTEXT', '1')
      endif

      !value = !tempPosition.east.abs()
    else
      !value = !tempPosition.east
    endif

    -- Assign to gadget
    !this.input[1].val = !value
    handle any
      !this.input[1].val = !value.string()
    endhandle

    -- Set New Easting
    !this.position.east = !tempPosition.east

  endif

  -- North/South
  if(!this.input[2].active) then
    if(defined(!this.option[2])) then
      if(!tempPosition.north lt 0) then
        !this.option[2].select('RTEXT', '-1')
      else
        !this.option[2].select('RTEXT', '1')
      endif
      !value = !tempPosition.north.abs()
    else
      !value = !tempPosition.north
    endif

    -- Assign to gadget
    !this.input[2].val = !value
    handle any
      !this.input[2].val = !value.string()
    endhandle

    -- Set New Northing
    !this.position.north = !tempPosition.north

  endif

  -- Up/Down
  if(!this.input[3].active) then
    if(defined(!this.option[3])) then
      if(!tempPosition.up lt 0) then
        !this.option[3].select('RTEXT', '-1')
      else
        !this.option[3].select('RTEXT', '1')
       endif
      !value = !tempPosition.up.abs()
    else
      !value = !tempPosition.up
    endif

    -- Assign to gadget
    !this.input[3].val = !value
    handle any
      !this.input[3].val = !value.string()
    endhandle

    -- Set New Upping
    !this.position.up = !tempPosition.up

  endif

endmethod
-- End of method definition for .setPositionNoAct(POSITION)

------------------------------------------------------------------------
--
-- Method:      setPositionForce
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPositionForce(!newPosition is POSITION)

  !this.position(!newPosition, true, true)

endmethod
-- End of method definition for .setPositionForce(POSITION)

------------------------------------------------------------------------
--
-- Method:      newInput
--
-- Description: Update position with input data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
--- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .newInput(!gadget is GADGET, !selected is STRING)

  -- Initialise Variables
  !cardinal[1] = 'EAST'
  !cardinal[2] = 'NORTH'
  !cardinal[3] = 'UP'

  -- Text input gadget set
  if(!gadget.type() eq 'TEXT') then

    !component = !gadget.val.real()
    handle any
      !component = object REAL()
    endhandle
    if( !component.unset() ) then
      !gadget.val = 0mm
    endif
    !index = !this.input.findFirst(!gadget)

    -- don't do anything if there is no change
    !noChange = !this.position.attribute(!cardinal[!index]) eq ( !this.option[!index].selection().real() * !gadget.val.real() )
    handle any
      !noChange = false
    endhandle
    if( !noChange ) then
      return
    endif

  -- Option gadget
  elseif (!gadget.type() eq 'LIST') then

    -- Ignore unselect events
    if (!selected eq |UNSELECT|) then
     return
    endif

    !index = !this.option.findFirst(!gadget)
    -- don't do anything if there is no change
    !noChange = !this.position.attribute(!cardinal[!index]) eq ( !this.option[!index].selection().real() * !this.input[!index].val )
    handle any
      !noChange = false
    endhandle
    if( !noChange ) then
      return
    endif
  endif

  -- Update the appropriate gadgets
  if(defined(!this.option[!index])) then
    !this.position.attribute(!cardinal[!index]) = !this.option[!index].selection().real() * !this.input[!index].val
    handle any
      if (!this.input[!index].val.unset()) then
        !this.input[!index].val = 0
      endif
      !this.position.attribute(!cardinal[!index]) = !this.option[!index].selection().real() * !this.input[!index].val.real()
    endhandle
  else
    !this.position.attribute(!cardinal[!index]) = !this.input[!index].val
  endif

  -- Run action command
  !this.runAction()

endmethod
-- End of method definition for .newInput(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      setLock
--
-- Description: Set lock on relevant gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setLock(!gadget is GADGET, !selected is STRING)

  -- Determine the set of gadgets to grey/un-grey
  !index = !this.lock.findFirst(!gadget)

  -- Grey out gadgets
  if(!selected eq 'SELECT') then

    -- Grey out option, if defined
    if(defined(!this.option[!index])) then
      !this.option[!index].active = false
    endif

    -- Grey out input, if defined
    !this.input[!index].active = false

    -- Un-grey gadgets
  else

    -- Un-grey out option, if defined
    if(defined(!this.option[!index])) then
      !this.option[!index].active = true
    endif

    -- Un-grey input, if defined
    !this.input[!index].active = true

  endif

endmethod
-- End of method definition for .setLock(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      unLockAll
--
-- Description: Unlock all gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .unlockAll()

  -- Unlock all gadgets
  do !i from 1 to 3

    -- Un-grey input gadget
    if(defined(!this.input[!i])) then
      !this.input[!i].active    = true
    endif

    -- unselect lock gadget
    if(defined(!this.lock[!i])) then
      !this.lock[!i].val      = false
    endif

    -- Un-grey option gadget
    if(defined(!this.option[!i])) then
      !this.option[!i].active = true
    endif

  enddo

endmethod
-- End of method definition for .unlockAll()

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Set with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Wrt element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt(!element is DBREF)

  -- Don't do anything if the element and origin are the same
  if(!this.wrt eq !element) then
    return
  endif

  -- Set new wrt
  !this.wrt      = !element

  -- Get Position and Convert to New
  !newPosition   = !this.position.wrt(!element)

  -- Set Position
  !this.position = !newPosition

  -- Re-display position (force information)
  !this.setPositionForce(!newPosition)

endmethod
-- End of method definition for .setWrt(DBREF)

------------------------------------------------------------------------
--
-- Method:      active
--
-- Description: Grey/un-grey all linked gadgets, maintain greying on locked gadgets when associated gadgets are made active
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Wrt element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .active(!flag is BOOLEAN)

  -- Grey-out all Gadgets
  if(!flag.not()) then
    do !i indices !this.lock
      !this.lock[!i].active   = false
    enddo
    do !i indices !this.input
      !this.input[!i].active  = false
    enddo
    do !i indices !this.option
      !this.option[!i].active = false
    enddo

  -- Un-grey all gadgets
  else

    do !i indices !this.lock
      !this.lock[!i].active   = true
    enddo
    do !i indices !this.input
      if(defined(!this.lock[!i])) then
        skip if(!this.lock[!i].val)
      endif
      !this.input[!i].active  = true
    enddo

    do !i indices !this.option
      if(defined(!this.lock[!i])) then
        skip if(!this.lock[!i].val)
      endif
      !this.option[!i].active  = true
    enddo

  endif

endmethod
-- End of method definition for .active(BOOLEAN)
