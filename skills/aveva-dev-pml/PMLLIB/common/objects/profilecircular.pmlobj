--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluatePicks(ARRAY)             ARRAY               evaluate a shape from the picks
--  evaluateProfile()                PROFILE             returns the description
--  profileCircular()                -                   Constructor
--  profileCircular(REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILECIRCULAR

  -- diameter of the circular shape
  member .diameter          is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profile           is PROFILE

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileCircular
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileCircular()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileCircular
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileCircular(!diameter is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.diameter          = !diameter
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePicks
--
-- Description: evaluate a shape from the picks
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       the picks
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of options
------------------------------------------------------------------------

define method .evaluatePicks(!picks is ARRAY) is ARRAY

  !options = ARRAY()

  -- only one pick
  ---------------------------------------------------------------------------
  if ( !picks.size().eq(1) ) then
    !arcs        = ARRAY()
    !position    = !picks[1].position
    !orientation = Z IS U
    !arcs.append(object ARC(!position, !orientation, 0, 360, 1000, true))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !arcs)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Single pick', 'circle16.png', false)
    !options.append(!option)

  -- two picks
  ---------------------------------------------------------------------------
  elseif ( !picks.size().geq(2) ) then
    if ( !picks.size().geq(3) ) then
      !plane       = !picks[1].position.plane(!picks[2].position, !picks[3].position)
      !orientation = !plane.orientation
    endif

    -- option 1, first pick is centre
    ---------------------------------------------------------------------------
    !arcs        = ARRAY()
    !position    = !picks[1].position
    !radius      = !picks[1].position.distance(!picks[2].position)
    !direction   = !picks[1].position.direction(!picks[2].position)
    if ( !picks.size().eq(2) ) then
      if ( !direction.angle(U).gt(0) ) then
        !orientation = object ORIENTATION('Y IS ' & !direction.string().before(' WRT') & ' AND Z IS U')
      else
        !orientation = object ORIENTATION('Y IS ' & !direction.string().before(' WRT'))
      endif
    endif
    !arcs.append(object ARC(!position, !orientation, 0, 360, !radius, true))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !arcs)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'First pick is centre', 'circlerad2d16.png', false)
    !options.append(!option)

    -- option 2, second pick is centre
    ---------------------------------------------------------------------------
    !arcs        = ARRAY()
    !position    = !picks[2].position
    !radius      = !picks[2].position.distance(!picks[1].position)
    !direction   = !picks[2].position.direction(!picks[1].position)
    if ( !picks.size().eq(2) ) then
      if ( !direction.angle(U).gt(0) ) then
        !orientation = object ORIENTATION('Y IS ' & !direction.string().before(' WRT') & ' AND Z IS U')
      else
        !orientation = object ORIENTATION('Y IS ' & !direction.string().before(' WRT'))
      endif
    endif
    !arcs.append(object ARC(!position, !orientation, 0, 360, !radius, true))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !arcs)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Second pick is centre', 'circle2ndpick16.png', false)
    !options.append(!option)

    -- option 3, picked positions define the diameter
    ---------------------------------------------------------------------------
    !arcs        = ARRAY()
    !line        = object LINE(!picks[1].position, !picks[2].position)
    !position    = !line.proportion(0.5)
    !radius      = !line.length() / 2
    !direction   = !picks[1].position.direction(!picks[2].position)
    if ( !picks.size().eq(2) ) then
      if ( !direction.angle(U).gt(0) ) then
        !orientation = object ORIENTATION('Y IS ' & !direction.string().before(' WRT') & ' AND Z IS U')
      else
        !orientation = object ORIENTATION('Y IS ' & !direction.string().before(' WRT'))
      endif
    endif
    !arcs.append(object ARC(!position, !orientation, 0, 360, !radius, true))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !arcs)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Picks define diameter', 'circle2pntdiam16.png', false)
    !options.append(!option)

    -- option 4, three picks define circle
    ---------------------------------------------------------------------------
    if ( !picks.size().geq(3) ) then
      !arcs        = ARRAY()
      !arc         = !picks[1].position.arcThru(!picks[2].position, !picks[3].position, !orientation.zDir())
      !arcs.append(!arc.circle())

      -- create the profile object
      !profiles[1] = object PROFILE(!position, !orientation, !arcs)
      !profiles[1].close()
      !option      = object PROFILEOPTION(!profiles, 'Through three picks', 'circle3pnt16.png', false)
      !options.append(!option)
    endif
  endif

  return !options

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROFILE     the profiles
------------------------------------------------------------------------

define method .evaluateProfile() is PROFILE

  -- define the profile lines
  !arcs = ARRAY()
  !arcs.append(object ARC(!this.position, !this.orientation, 0, 360, !this.diameter / 2, true))

  -- create the profile object
  !this.profile = object PROFILE(!this.position, !this.orientation, !arcs)
  !this.profile.close()

  return !this.profile

endmethod
-- End of method
