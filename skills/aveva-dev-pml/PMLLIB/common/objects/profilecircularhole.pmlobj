-- File:            PROFILEcircularhole.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluateProfile()                ARRAY               returns the description
--  profileCircularHole()            -                   Constructor
--  profileCircularHole(REAL,REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILECIRCULARHOLE

  -- outer diameter of the circular shape
  member .outerDiameter     is REAL

  -- inner diameter of the circular shape
  member .innerDiameter     is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profiles          is ARRAY

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileCircularHole
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileCircularHole()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileCircularHole
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileCircularHole(!outerDiameter is REAL, !innerDiameter is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.outerDiameter     = !outerDiameter
  !this.innerDiameter     = !innerDiameter
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is ARRAY

  -- define the profile lines
  !arcs = ARRAY()
  !arcs.append(object ARC(!this.position, !this.orientation, 0, 360, !this.outerDiameter / 2, true))

  -- create the profile object
  !this.profiles[1] = object PROFILE(!this.position, !this.orientation, !arcs)
  !this.profiles[1].close()

  -- define the profile lines
  !arcs = ARRAY()
  !arcs.append(object ARC(!this.position, !this.orientation, 0, 360, !this.innerDiameter / 2, true))

  -- create the profile object
  !this.profiles[2] = object PROFILE(!this.position, !this.orientation, !arcs)
  !this.profiles[2].close()

  return !this.profiles

endmethod
-- End of method
