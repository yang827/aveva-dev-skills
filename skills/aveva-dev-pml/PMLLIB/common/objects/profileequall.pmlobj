-- File:            PROFILEequall.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluatePicks(ARRAY)             ARRAY               evaluate a shape from the picks
--  evaluateProfile()                PROFILE             returns the description
--  profileEqualL()                  -                   Constructor
--  profileEqualL(REAL,REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILEEQUALL

  -- width of the equal l
  member .width             is REAL

  -- thickness of the equal l
  member .thickness         is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profile           is PROFILE

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileEqualL
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileEqualL()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileEqualL
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileEqualL(!width is REAL, !thickness is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.width             = !width
  !this.thickness         = !thickness
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePicks
--
-- Description: evaluate a shape from the picks
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       the picks
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of options
------------------------------------------------------------------------

define method .evaluatePicks(!picks is ARRAY) is ARRAY

  !options = ARRAY()

  -- only one pick
  ---------------------------------------------------------------------------
  if ( !picks.size().eq(1) ) then
    !points      = ARRAY()
    !position    = !picks[1].position
    !orientation = Z IS U
    !points.append(!position)
    !points.append(!position.offset(!orientation.xDir(), 2000))
    !points.append(!position.offset(!orientation.xDir(), 2000).offset(!orientation.yDir(), 200))
    !points.append(!position.offset(!orientation.xDir(), 200).offset(!orientation.yDir(), 200))
    !points.append(!position.offset(!orientation.xDir(), 200).offset(!orientation.yDir(), 2000))
    !points.append(!position.offset(!orientation.yDir(), 2000))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Single pick', 'circle16.png', false)
    !options.append(!option)

  -- two picks
  ---------------------------------------------------------------------------
  elseif ( !picks.size().geq(2) ) then
    !startPosition  = !picks[1].position
    !endPosition    = !picks[2].position
    !direction      = !picks[1].position.direction(!picks[2].position)
    !distance       = !startPosition.distance(!endPosition)
    if ( !picks.size().geq(3) ) then
      !plane         = !picks[2].position.plane(!picks[1].position, !picks[3].position)
      !orientation   = !plane.orientation
      !line          = object LINE(!startPosition, !endPosition)
      !smallDistance = !line.distance(!picks[3].position)
    else
      if ( !direction.angle(U).gt(0) ) then
        !orientation = object ORIENTATION('X IS ' & !direction.string().before(' WRT') & ' AND Z IS U')
      else
        !orientation = object ORIENTATION('X IS ' & !direction.string().before(' WRT'))
      endif
      !smallDistance = !distance / 5
    endif

    -- option 1, first pick is start, shape to the right
    ---------------------------------------------------------------------------
    !points      = ARRAY()
    !points.append(!startPosition)
    !points.append(!startPosition.offset(!orientation.xDir(), !distance))
    !points.append(!startPosition.offset(!orientation.xDir(), !distance).offset(!orientation.yDir(), !smallDistance))
    !points.append(!startPosition.offset(!orientation.xDir(), !smallDistance).offset(!orientation.yDir(), !smallDistance))
    !points.append(!startPosition.offset(!orientation.xDir(), !smallDistance).offset(!orientation.yDir(), !distance))
    !points.append(!startPosition.offset(!orientation.yDir(), !distance))

    -- create the profile object
    !profiles[1] = object PROFILE(!startPosition, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'First pick start, shape left', 'circle16.png', false)
    !options.append(!option)

    -- option 2, first pick is start, shape to the left
    ---------------------------------------------------------------------------
    !points      = ARRAY()
    !points.append(!startPosition)
    !points.append(!startPosition.offset(!orientation.xDir(), !distance))
    !points.append(!startPosition.offset(!orientation.xDir(), !distance).offset(!orientation.yDir().opposite(), !smallDistance))
    !points.append(!startPosition.offset(!orientation.xDir(), !smallDistance).offset(!orientation.yDir().opposite(), !smallDistance))
    !points.append(!startPosition.offset(!orientation.xDir(), !smallDistance).offset(!orientation.yDir().opposite(), !distance))
    !points.append(!startPosition.offset(!orientation.yDir().opposite(), !distance))

    -- create the profile object
    !profiles[1] = object PROFILE(!startPosition, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'First pick start, shape right', 'circle16.png', false)
    !options.append(!option)

    -- option 3, first pick is end, shape to the right
    ---------------------------------------------------------------------------
    !points      = ARRAY()
    !points.append(!endPosition)
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !distance))
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !distance).offset(!orientation.yDir(), !smallDistance))
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !smallDistance).offset(!orientation.yDir(), !smallDistance))
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !smallDistance).offset(!orientation.yDir(), !distance))
    !points.append(!endPosition.offset(!orientation.yDir(), !distance))

    -- create the profile object
    !profiles[1] = object PROFILE(!startPosition, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Second pick start, shape left', 'circle16.png', false)
    !options.append(!option)

    -- option 4, first pick is end, shape to the left
    ---------------------------------------------------------------------------
    !points      = ARRAY()
    !points.append(!endPosition)
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !distance))
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !distance).offset(!orientation.yDir().opposite(), !smallDistance))
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !smallDistance).offset(!orientation.yDir().opposite(), !smallDistance))
    !points.append(!endPosition.offset(!orientation.xDir().opposite(), !smallDistance).offset(!orientation.yDir().opposite(), !distance))
    !points.append(!endPosition.offset(!orientation.yDir().opposite(), !distance))

    -- create the profile object
    !profiles[1] = object PROFILE(!startPosition, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Second pick start, shape right', 'circle16.png', false)
    !options.append(!option)

  endif

  return !options

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is PROFILE

  !positions = ARRAY()
  !positions.append(!this.position)
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.width))
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.width).offset(!this.orientation.xDir(), !this.thickness))
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.thickness).offset(!this.orientation.xDir(), !this.thickness))
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.thickness).offset(!this.orientation.xDir(), !this.width))
  !positions.append(!this.position.offset(!this.orientation.xDir(), !this.width))

  -- create the profile object
  !this.profile = object PROFILE(!this.position, !this.orientation, !positions)
  !this.profile.close()

  -- move the profile object if the respective vertex point is not the centre
  if ( !this.positionReference.eq('Vtx 2') ) then
    !this.profile = !this.profile.translate(0, !this.width * -1)
  elseif ( !this.positionReference.eq('Vtx 3') ) then
    !this.profile = !this.profile.translate(!this.thickness * -1, !this.width * -1)
  elseif ( !this.positionReference.eq('Vtx 4') ) then
    !this.profile = !this.profile.translate(!this.thickness * -1, !this.thickness * -1)
  elseif ( !this.positionReference.eq('Vtx 5') ) then
    !this.profile = !this.profile.translate(!this.width * -1, !this.thickness * -1)
  elseif ( !this.positionReference.eq('Vtx 6') ) then
    !this.profile = !this.profile.translate(!this.width * -1, 0)
  endif

  return !this.profile

endmethod
-- End of method
