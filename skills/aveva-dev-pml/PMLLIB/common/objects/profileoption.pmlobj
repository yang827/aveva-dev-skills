-- File:            PROFILEoption.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  profileOption(ARRAY,STRING,STRING,BOOLEAN) -                   Constructor
--
define object PROFILEOPTION

  -- profile (including possible negative one, therefore array)
  member .profile           is ARRAY

  -- the description
  member .description       is STRING

  -- the assigned pixmap
  member .pixmap            is STRING

  -- type of profile (ARRAY of profiles (pos and neg) used for polyhedrons or only one profile (including pos and neg))
  member .profileArray      is BOOLEAN

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileOption
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileOption(!profile is ARRAY, !description is STRING, !pixmap is STRING, !profileArray is BOOLEAN)

  !this.profile      = !profile
  !this.description  = !description
  !this.pixmap       = !!pml.getPathName(!pixmap)
  !this.profileArray = !profileArray

endmethod
-- End of object definition for Criterion
