-- File:            profilePolyhedron.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluatePicks(ARRAY,REAL)        ARRAY               evaluate a shape from the picks
--  evaluateProfile()                PROFILE             returns the description
--  profilePolyhedron()              -                   Constructor
--  profilePolyhedron(REAL,REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILEPOLYHEDRON

  -- diameter of the circular shape
  member .diameter          is REAL

  -- number of edges
  member .numberOfEdges     is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profile           is PROFILE

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profilePolyhedron
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profilePolyhedron()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profilePolyhedron
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profilePolyhedron(!diameter is REAL, !numberOfEdges is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.diameter          = !diameter
  !this.numberOfEdges     = !numberOfEdges
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePicks
--
-- Description: evaluate a shape from the picks
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       the picks
--    2   R      ARRAY       number of edges
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of options
------------------------------------------------------------------------

define method .evaluatePicks(!picks is ARRAY, !numberOfEdges is REAL) is ARRAY

  return !!getPolyhedronOptions(!picks, !numberOfEdges)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is PROFILE

  -- angle between the rays from centre to all corners
  !centreAngle = 360 / !this.numberOfEdges

  -- define the profile points
  !points      = ARRAY()
  do !i to !this.numberOfEdges
    !direction = object DIRECTION('E ' & !centreAngle * (!i - 0.5) & ' N')
    !points.append(!this.position.offset(!direction, !this.diameter))
  enddo

  -- create the profile object
  !this.profile = object PROFILE(!this.position, !this.orientation, !points)
  !this.profile.close()

  return !this.profile

endmethod
-- End of method
