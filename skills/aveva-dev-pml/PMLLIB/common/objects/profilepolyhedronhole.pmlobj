-- File:            profilePolyhedronhole.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluateProfile()                ARRAY               returns the description
--  profilePolyhedronHole()          -                   Constructor
--  profilePolyhedronHole(REAL,REAL,REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILEPOLYHEDRONHOLE

  -- outer diameter of the octagon shape
  member .outerDiameter     is REAL

  -- inner diameter of the octagon shape
  member .innerDiameter     is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profiles          is ARRAY

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profilePolyhedronHole
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profilePolyhedronHole()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profilePolyhedronHole
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profilePolyhedronHole(!outerDiameter is REAL, !numberOfEdges is REAL, !innerDiameter is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.outerDiameter     = !outerDiameter
  !this.innerDiameter     = !innerDiameter
  !this.numberOfEdges     = !numberOfEdges
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is ARRAY

  !angle = 45
  !sine  = !angle.sine()

  -- define the profile lines
  !positions = ARRAY()
  !positions.append(!this.position.offset(!this.orientation.yDir(),            !this.outerDiameter / 2))
  !positions.append(!this.position.offset(!this.orientation.yDir(),            !this.outerDiameter / 2 * !sine).offset(!this.orientation.xDir(),            !this.outerDiameter / 2 * !sine))
  !positions.append(!this.position.offset(!this.orientation.xDir(),            !this.outerDiameter / 2))
  !positions.append(!this.position.offset(!this.orientation.yDir().opposite(), !this.outerDiameter / 2 * !sine).offset(!this.orientation.xDir(),            !this.outerDiameter / 2 * !sine))
  !positions.append(!this.position.offset(!this.orientation.yDir().opposite(), !this.outerDiameter / 2))
  !positions.append(!this.position.offset(!this.orientation.yDir().opposite(), !this.outerDiameter / 2 * !sine).offset(!this.orientation.xDir().opposite(), !this.outerDiameter / 2 * !sine))
  !positions.append(!this.position.offset(!this.orientation.xDir().opposite(), !this.outerDiameter / 2))
  !positions.append(!this.position.offset(!this.orientation.yDir(),            !this.outerDiameter / 2 * !sine).offset(!this.orientation.xDir().opposite(), !this.outerDiameter / 2 * !sine))

  -- create the profile object
  !this.profiles[1] = object PROFILE(!this.position, !this.orientation, !positions)
  !this.profiles[1].close()

  -- define the profile lines
  !arcs = ARRAY()
  !arcs.append(object ARC(!this.position, !this.orientation, 0, 360, !this.innerDiameter / 2, true))

  -- create the profile object
  !this.profiles[2] = object PROFILE(!this.position, !this.orientation, !arcs)
  !this.profiles[2].close()

  -- move the profile object if the respective vertex point is not the centre
  if ( !this.positionReference.eq('Vtx 1') ) then
    !this.profiles[1] = !this.profiles[1].translate(0,                                    !this.outerDiameter / 2 * -1)
    !this.profiles[2] = !this.profiles[2].translate(0,                                    !this.outerDiameter / 2 * -1)
  elseif ( !this.positionReference.eq('Vtx 2') ) then
    !this.profiles[1] = !this.profiles[1].translate(!this.outerDiameter / 2 * !sine * -1, !this.outerDiameter / 2 * !sine * -1)
    !this.profiles[2] = !this.profiles[2].translate(!this.outerDiameter / 2 * !sine * -1, !this.outerDiameter / 2 * !sine * -1)
  elseif ( !this.positionReference.eq('Vtx 3') ) then
    !this.profiles[1] = !this.profiles[1].translate(!this.outerDiameter / 2 * -1,         0)
    !this.profiles[2] = !this.profiles[2].translate(!this.outerDiameter / 2 * -1,         0)
  elseif ( !this.positionReference.eq('Vtx 4') ) then
    !this.profiles[1] = !this.profiles[1].translate(!this.outerDiameter / 2 * !sine * -1, !this.outerDiameter / 2 * !sine)
    !this.profiles[2] = !this.profiles[2].translate(!this.outerDiameter / 2 * !sine * -1, !this.outerDiameter / 2 * !sine)
  elseif ( !this.positionReference.eq('Vtx 5') ) then
    !this.profiles[1] = !this.profiles[1].translate(0,                                    !this.outerDiameter / 2)
    !this.profiles[2] = !this.profiles[2].translate(0,                                    !this.outerDiameter / 2)
  elseif ( !this.positionReference.eq('Vtx 6') ) then
    !this.profiles[1] = !this.profiles[1].translate(!this.outerDiameter / 2 * !sine,      !this.outerDiameter / 2 * !sine)
    !this.profiles[2] = !this.profiles[2].translate(!this.outerDiameter / 2 * !sine,      !this.outerDiameter / 2 * !sine)
  elseif ( !this.positionReference.eq('Vtx 7') ) then
    !this.profiles[1] = !this.profiles[1].translate(!this.outerDiameter / 2,              0)
    !this.profiles[2] = !this.profiles[2].translate(!this.outerDiameter / 2,              0)
  elseif ( !this.positionReference.eq('Vtx 8') ) then
    !this.profiles[1] = !this.profiles[1].translate(!this.outerDiameter / 2 * !sine,      !this.outerDiameter / 2 * !sine * -1)
    !this.profiles[2] = !this.profiles[2].translate(!this.outerDiameter / 2 * !sine,      !this.outerDiameter / 2 * !sine * -1)
  endif

  return !this.profiles

endmethod
-- End of method
