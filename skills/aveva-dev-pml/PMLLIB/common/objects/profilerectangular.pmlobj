-- File:            PROFILEsquare.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluatePicks(ARRAY)             ARRAY               evaluate a shape from the picks
--  evaluateProfile()                PROFILE             returns the description
--  profilerectAngular()             -                   Constructor
--  profilerectAngular(REAL,REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILERECTANGULAR

  -- width of the square
  member .width             is REAL

  -- length of the square
  member .length            is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profile           is PROFILE

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profilerectAngular
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profilerectAngular()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profilerectAngular
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profilerectAngular(!width is REAL, !length is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.width             = !width
  !this.length            = !length
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePicks
--
-- Description: evaluate a shape from the picks
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       the picks
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of options
------------------------------------------------------------------------

define method .evaluatePicks(!picks is ARRAY) is ARRAY

  !options = ARRAY()

  -- only one pick
  ---------------------------------------------------------------------------
  if ( !picks.size().eq(1) ) then
    !position    = !picks[1].position
    !orientation = Z IS U
    !width       = 3000
    !length      = 2000

    !points = ARRAY()
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir().opposite(), !length / 2))
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir().opposite(), !length / 2))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Single pick', 'rectangular16.png', false)
    !options.append(!option)

  -- two picks
  ---------------------------------------------------------------------------
  elseif ( !picks.size().eq(2) ) then
    !line        = object LINE(!picks[1].position, !picks[2].position)
    !width       = !line.length()
    !xDir        = !line.direction()
    !length      = !width * 2 / 3
    if ( !xDir.angle(U).gt(0) ) then
      !orientation = object ORIENTATION('X IS ' & !xDir.string().before(' WRT') & ' AND Z IS U')
    else
      !orientation = object ORIENTATION('X IS ' & !xDir.string().before(' WRT'))
    endif

    -- option one -- centre
    ---------------------------------------------------------------------------
    !position = !line.proportion(0.5)

    !points = ARRAY()
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir().opposite(), !length / 2))
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir().opposite(), !length / 2))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Picks define centre', 'rectangularcentre16.png', false)
    !options.append(!option)

    -- option two -- left edge
    ---------------------------------------------------------------------------
    !position = !line.proportion(0.5).offset(!orientation.yDir(), !length / 2)

    !points = ARRAY()
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir().opposite(), !length / 2))
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir().opposite(), !length / 2))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Picks define left edge', 'rectangularleftedge16.png', false)
    !options.append(!option)

    -- option three -- right edge
    ---------------------------------------------------------------------------
    !position = !line.proportion(0.5).offset(!orientation.yDir().opposite(), !length / 2)

    !points = ARRAY()
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir().opposite(), !length / 2))
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir().opposite(), !length / 2))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Picks define right edge', 'rectangularrightedge16.png', false)
    !options.append(!option)


  -- three picks
  ---------------------------------------------------------------------------
  elseif ( !picks.size().gt(2) ) then
    !line        = object LINE(!picks[1].position, !picks[2].position)
    !width       = !line.length()
    !xDir        = !line.direction()
    !length      = !picks[3].position.distance(!line)
    !plane       = !picks[1].position.plane(!picks[2].position, !picks[3].position)
    !orientation = !plane.orientation

    !yDir        = !picks[3].position.direction(!line.near(!picks[3].position))
    !orientation = object ORIENTATION('X IS ' & !xDir & ' AND Y IS ' & !yDir)

    !position    = !line.proportion(0.5).offset(!orientation.yDir().opposite(), !length / 2)

    !points = ARRAY()
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir(),            !length / 2))
    !points.append(!position.offset(!orientation.xDir(),            !width / 2).offset(!orientation.yDir().opposite(), !length / 2))
    !points.append(!position.offset(!orientation.xDir().opposite(), !width / 2).offset(!orientation.yDir().opposite(), !length / 2))

    -- create the profile object
    !profiles[1] = object PROFILE(!position, !orientation, !points)
    !profiles[1].close()
    !option      = object PROFILEOPTION(!profiles, 'Three points', 'rectangularthreepoints16.png', false)
    !options.append(!option)

  endif

  return !options

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is PROFILE

  !positions = ARRAY()
  !positions.append(!this.position.offset(!this.orientation.xDir().opposite(), !this.width / 2).offset(!this.orientation.yDir(),            !this.length / 2))
  !positions.append(!this.position.offset(!this.orientation.xDir(),            !this.width / 2).offset(!this.orientation.yDir(),            !this.length / 2))
  !positions.append(!this.position.offset(!this.orientation.xDir(),            !this.width / 2).offset(!this.orientation.yDir().opposite(), !this.length / 2))
  !positions.append(!this.position.offset(!this.orientation.xDir().opposite(), !this.width / 2).offset(!this.orientation.yDir().opposite(), !this.length / 2))

  -- create the profile object
  !this.profile = object PROFILE(!this.position, !this.orientation, !positions)
  !this.profile.close()

  -- move the profile object if the respective vertex point is not the centre
  if ( !this.positionReference.eq('Vtx 1') ) then
    !this.profile = !this.profile.translate(!this.width / 2,      !this.length / 2 * -1)
  elseif ( !this.positionReference.eq('Vtx 2') ) then
    !this.profile = !this.profile.translate(!this.width / 2 * -1, !this.length / 2 * -1)
  elseif ( !this.positionReference.eq('Vtx 3') ) then
    !this.profile = !this.profile.translate(!this.width / 2 * -1, !this.length / 2)
  elseif ( !this.positionReference.eq('Vtx 4') ) then
    !this.profile = !this.profile.translate(!this.width / 2,      !this.length / 2)
  endif

  return !this.profile

endmethod
-- End of method
