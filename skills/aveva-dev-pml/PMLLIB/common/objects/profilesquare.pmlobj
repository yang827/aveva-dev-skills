-- File:            PROFILEsquare.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluatePicks(ARRAY)             ARRAY               evaluate a shape from the picks
--  evaluateProfile()                PROFILE             returns the description
--  profileSquare()                  -                   Constructor
--  profileSquare(REAL,POSITION,STRING,ORIENTATION) -                   Constructor
--
define object PROFILESQUARE

  -- width of the square
  member .width             is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profile           is PROFILE

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileSquare
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileSquare()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileSquare
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileSquare(!width is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.width             = !width
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePicks
--
-- Description: evaluate a shape from the picks
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       the picks
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of options
------------------------------------------------------------------------

define method .evaluatePicks(!picks is ARRAY) is ARRAY

  return !!getPolyhedronOptions(!picks, 4)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is PROFILE

  !positions = ARRAY()
  !positions.append(!this.position.offset(!this.orientation.xDir().opposite(), !this.width / 2).offset(!this.orientation.yDir(),            !this.width / 2))
  !positions.append(!this.position.offset(!this.orientation.xDir(),            !this.width / 2).offset(!this.orientation.yDir(),            !this.width / 2))
  !positions.append(!this.position.offset(!this.orientation.xDir(),            !this.width / 2).offset(!this.orientation.yDir().opposite(), !this.width / 2))
  !positions.append(!this.position.offset(!this.orientation.xDir().opposite(), !this.width / 2).offset(!this.orientation.yDir().opposite(), !this.width / 2))

  -- create the profile object
  !this.profile = object PROFILE(!this.position, !this.orientation, !positions)
  !this.profile.close()

  -- move the profile object if the respective vertex point is not the centre
  if ( !this.positionReference.eq('Vtx 1') ) then
    !this.profile = !this.profile.translate(!this.width / 2,      !this.width / 2 * -1)
  elseif ( !this.positionReference.eq('Vtx 2') ) then
    !this.profile = !this.profile.translate(!this.width / 2 * -1, !this.width / 2 * -1)
  elseif ( !this.positionReference.eq('Vtx 3') ) then
    !this.profile = !this.profile.translate(!this.width / 2 * -1, !this.width / 2)
  elseif ( !this.positionReference.eq('Vtx 4') ) then
    !this.profile = !this.profile.translate(!this.width / 2,      !this.width / 2)
  endif

  return !this.profile

endmethod
-- End of method
