--
-- Description:     controls the appearance of the polyline form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  load()                           -                   loads the form
--  profileUI()                      -                   default constructor
--

-- Define object
define object profileUI

  -- the profile object to be modified (can also be an empty string for create)
  member .acceptCallback  is STRING

  -- display text for the accept button
  member .acceptDText     is STRING

  -- flag to open the form in create of modify status
  member .create          is BOOLEAN

  -- discard callback (e.g. !!myForm.profileDiscard(!this.meProfiles))
  member .discardCallback is STRING

  -- display text for the discard button
  member .discardDText    is STRING

  -- form title
  member .formTitle       is STRING

  -- the profile object to be modified (can also be an empty string for create)
  member .profile         is PROFILE

endobject
-- End of object definition for profileUI

------------------------------------------------------------------------
--
-- Method:      profileUI
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileUI()

  !this.create = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: loads the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .load()

  -- show the form
  show !!profileUI

  -- set the title
  !!profileUI.formTitle = !this.formTitle

  -- load the profile for modification
  !!profileUI.meProfiles.clear()
  if ( !this.profile.set() ) then
    !!profileUI.meProfiles[1] = !this.profile
  endif

  -- open the form in create or modify mode
  if ( !this.create ) then
    !!profileUI.create()
  else
    !!profileUI.modify()
  endif

  -- buttons
  !!profileUI.lkAcceptChanges.tag  = !this.acceptDText
  !!profileUI.lkDiscardChanges.tag = !this.discardDText

  -- store the callbacks in the form
  !!profileUI.meAcceptCallback  = !this.acceptCallback
  !!profileUI.meDiscardCallback = !this.discardCallback

endmethod
-- End of method
