--
-- File:            PROFILEunequall.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     PROFILE
--   Module:        ALL
--   Replaces:
--
-- Author:          Martin Eich
-- Created:         Tue Feb 06 11:36:00 GMT 2006
--
-- Description:     container for square objects for the profile application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluateProfile()                PROFILE             returns the description
--  profileUnEqualL()                -
--  profileUnEqualL(REAL,REAL,REAL,REAL,POSITION,STRING,ORIENTATION) -
--
define object PROFILEUNEQUALL

  -- width of the unequal l
  member .width             is REAL

  -- length of the unequal l
  member .length            is REAL

  -- thickness1 of the unequal l
  member .thickness1        is REAL

  -- thickness2 of the unequal l
  member .thickness2        is REAL

  -- the reference point (centre, vtx1, etc.) of the square that holds the position
  member .positionReference is STRING

  -- position of the square
  member .position          is POSITION

  -- orientation of the square
  member .orientation       is ORIENTATION

  -- the resulting profile
  member .profile           is PROFILE

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileEqualL
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileUnEqualL()

endmethod
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      profileEqualL
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .profileUnEqualL(!width is REAL, !length is REAL, !thickness1 is REAL, !thickness2 is REAL, !position is POSITION, !positionReference is STRING, !orientation is ORIENTATION)

  !this.width             = !width
  !this.length            = !length
  !this.thickness1        = !thickness1
  !this.thickness2        = !thickness2
  !this.position          = !position
  !this.positionReference = !positionReference
  !this.orientation       = !orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateProfile
--
-- Description: returns the description
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateProfile() is PROFILE

  !positions = ARRAY()
  !positions.append(!this.position)
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.length))
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.length).offset(!this.orientation.xDir(), !this.thickness1))
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.thickness2).offset(!this.orientation.xDir(), !this.thickness1))
  !positions.append(!this.position.offset(!this.orientation.yDir(), !this.thickness2).offset(!this.orientation.xDir(), !this.width))
  !positions.append(!this.position.offset(!this.orientation.xDir(), !this.width))

  -- create the profile object
  !this.profile = object PROFILE(!this.position, !this.orientation, !positions)
  !this.profile.close()

  -- move the profile object if the respective vertex point is not the centre
  if ( !this.positionReference.eq('Vtx 2') ) then
    !this.profile = !this.profile.translate(0, !this.length * -1)
  elseif ( !this.positionReference.eq('Vtx 3') ) then
    !this.profile = !this.profile.translate(!this.thickness1 * -1, !this.length * -1)
  elseif ( !this.positionReference.eq('Vtx 4') ) then
    !this.profile = !this.profile.translate(!this.thickness1 * -1, !this.thickness2 * -1)
  elseif ( !this.positionReference.eq('Vtx 5') ) then
    !this.profile = !this.profile.translate(!this.width * -1, !this.thickness2 * -1)
  elseif ( !this.positionReference.eq('Vtx 6') ) then
    !this.profile = !this.profile.translate(!this.width * -1, 0)
  endif

  return !this.profile

endmethod
-- End of method
