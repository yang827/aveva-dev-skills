------------------------------------------------------------------------

define method .exportAsCsv(!reportfilename is STRING, !csvFileName is STRING)
	!!reportpmlinstance.pmlReport[!this.instanceNo].exportAsCsv(!reportfilename, !csvFileName)
endmethod

-- End of method definition for .exportAsCsv()

------------------------------------------------------------------------
--
-- Method:      exportAsCsv
--
-- Description: export report as CSV
--
-- Method Type:
-- Arguments:
--  1 R STRING name of report file (.repv)
--  2 R STRING name of CSV file where the content of report will be exported.
--  3 R/RW STRING name of Encoding type , supported Unicode(UTF16),UTF32,UTF7,UTF8,BigEndianUnicode(UTF16BE),ASCII,Default(windows specific encoding type).
--  4 R/RW STRING name of export text mode either text or value.
--  4 R/RW STRING name of separator to separate text elements.
--  6 R/RW BOOLEAN set true to quote (place quotation marks around) text elements containing symbols which are the same as the specified separator string; otherwise, false
--  The file will be generated at the specified directory with specified name
-- Return:
------------------------------------------------------------------------

define method .exportAsCsv(!reportfilename is STRING, !csvFileName is STRING, !encoding is STRING, !exportTextmode is STRING, !separator is STRING, !quoteStringsWithSeparators is BOOLEAN)
	!!reportpmlinstance.pmlReport[!this.instanceNo].exportAsCsv(!reportfilename, !csvFileName, !encoding, !exportTextmode, !separator, !quoteStringsWithSeparators)
endmethod

-- End of method definition for .exportAsCsv()
--------------------------------------------------------------------------
