-- Return:
------------------------------------------------------------------------

define method .publishToAVEVANET(!reportfilename is STRING, !pdfFileName is STRING)
	!!reportpmlinstance.pmlReport[!this.instanceNo].publishToAVEVANET(!reportfilename, !pdfFileName)
