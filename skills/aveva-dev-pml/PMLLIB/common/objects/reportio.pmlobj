--
--   Keyword:       Aveva.Pdms.Reporting
--   Module:        All
--   Replaces:
--
-- Author:
-- Created:         Wed April 20th 2011
--
--
-- Description:
-- Report print, export and publish support
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addParameters(ARRAY,ARRAY)       -                   add parameters to parameterised report
--  addScope(STRING,STRING)          -                   add scope to report for limiting the data to be displayed in report, existing scope defined in the report will be overridden.
--  addScope(STRING,STRING,BOOLEAN,REAL,REAL,REAL,REAL,REAL,REAL) -                   add scope to report for limiting the data to be displayed in report, existing scope defined in the report will be overridden.
--  callback(ARRAY)                  -
--  exportAsCsv(STRING,STRING)       -                   export report as CSV
--  exportAsCsv(STRING,STRING,STRING,STRING,STRING,BOOLEAN) -                   export report as CSV with encoding ,export text mode either text or value,separate text elements and Quote Strings With Separators.
--  exportAsPdf(STRING,STRING)       -                   export report as Pdf
--  exportAsXls(STRING,STRING)       -                   export report as Xls
--  exportAsXls(STRING,STRING,STRING,STRING,STRING,STRING,BOOLEAN) -                   export report as Xls with grid-line option whether export grid lines or not ,export text mode either text or value,sheetName , export mode either single file or different files and page range it applicable if export mode is different files only.
--  exportAsXlsx(STRING,STRING)      -                   export report as Xlsx
--  exportAsXlsx(STRING,STRING,STRING,STRING,STRING,STRING,BOOLEAN) -                   export report as Xlsx with grid-line option whether export grid lines or not and export text mode either text or value,sheetName , export mode either single file or different files and page range it applicable if export mode is different files only.
--  print(STRING)                    BOOLEAN             print to report. this function will open the printer setting dialog
--  printDirect(STRING)              -                   print to report directly using the user's preferred printing setting
--  publishToAVEVANET(STRING,STRING) -                   publish report to AVEVANET
--  removeParameters()               -
--  removeScope()                    -                   remove scope to report to use existing scope defined in the report if any.
--  reportIO()                       -
--
define object REPORTIO
  member .pmlReport         is ARRAY
  member .instanceNo        is REAL
endobject


------------------------------------------------------------------------
--
-- Method:      ReportIO
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reportIO()

  USING NAMESPACE 'Aveva.Pdms.Reporting'

  if (defined(!!reportpmlinstance)) then
    !this.instanceNo = !!reportpmlinstance.pmlReport.size() + 1
    !!reportpmlinstance.pmlReport[!this.instanceNo] = object PMLREPORT()
  endif

  if (not defined(!!reportpmlinstance)) then
    !!reportpmlinstance = !this
    !!reportpmlinstance.pmlReport[1] = object PMLREPORT()
    !this.instanceNo = 1
  endif

  !!reportpmlinstance.pmlReport[!this.instanceNo].addEventHandler('Response',!!reportpmlinstance,'callback')

endmethod
-- End of method definition for Report()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for PMLReport
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()

------------------------------------------------------------------------
--
-- Method:      addParameters
--
-- Description: add parameters to parameterised report
--
-- Method Type:
-- Arguments:
--  1 R ARRAY Name of parameters
--  2 R ARRAY Value of parameters
--
-- Return:
------------------------------------------------------------------------

define method .addParameters(!argNames is ARRAY, !argValues is ARRAY)
   !!reportpmlinstance.pmlReport[!this.instanceNo].addParameters(!argNames, !argValues)
endmethod

-- End of method definition for .addParameters()

------------------------------------------------------------------------
--
-- Method:      addScope
--
-- Description: add scope to report for limiting the data to be displayed in report, existing scope defined in the report will be overridden.
--
-- Method Type:
-- Arguments:
--  1 R STRING comma separated name of ancestor elements
--  2 R STRING comma separated name of elements
--
-- Return:
------------------------------------------------------------------------

define method .addScope(!ancestorElements is STRING, !elements is STRING)
   !!reportpmlinstance.pmlReport[!this.instanceNo].addScope(!ancestorElements, !elements)
endmethod

-- End of method definition for .addScope()

------------------------------------------------------------------------
--
-- Method:      addScope
--
-- Description: add scope to report for limiting the data to be displayed in report, existing scope defined in the report will be overridden.
--
-- Method Type:
-- Arguments:
--  1 R STRING comma separated name of ancestor elements
--  2 R STRING comma separated name of elements
--  3 R BOOLEAN fully or partially within limit box
--  4 R REAL minimum X for constructing limit box
--  5 R REAL minimum Y for constructing limit box
--  6 R REAL minimum Z for constructing limit box
--  7 R REAL maximum X for constructing limit box
--  8 R REAL maximum Y for constructing limit box
--  9 R REAL maximum Z for constructing limit box
--
-- Return:
------------------------------------------------------------------------

define method .addScope(!ancestorElements is STRING, !elements is STRING, !fully is BOOLEAN, !minimumX is REAL, !minimumY is REAL, !minimumZ is REAL, !maximumX is REAL, !maximumY is REAL, !maximumZ is REAL)
   !!reportpmlinstance.pmlReport[!this.instanceNo].addScope(!ancestorElements, !elements, !fully, !minimumX, !minimumY, !minimumZ, !maximumX, !maximumY, !maximumZ )
endmethod

-- End of method definition for .addScope()

------------------------------------------------------------------------
--
-- Method:      removeScope
--
-- Description: remove scope to report to use existing scope defined in the report if any.
--
-- Method Type:
-- Arguments:
--
-- Return:
------------------------------------------------------------------------

define method .removeScope()
   !!reportpmlinstance.pmlReport[!this.instanceNo].removeScope()
endmethod

-- End of method definition for .removeScope()

------------------------------------------------------------------------
--
-- Method:      RemoveParameters
--
-- Description: removes the parameters to be applied to report..
--
-- Method Type:
-- Arguments:
--
-- Return:
------------------------------------------------------------------------

define method .removeParameters()
   !!reportpmlinstance.pmlReport[!this.instanceNo].removeParameters()
endmethod

-- End of method definition for .removeParameters()

------------------------------------------------------------------------
--
-- Method:      print
--
-- Description: print to report. this function will open the printer setting dialog
--
-- Method Type:
-- Arguments:
--  1 R STRING name of report file (.repv)
--
-- Return:

define method .print(!reportfilename is STRING) is BOOLEAN
   !!reportpmlinstance.pmlReport[!this.instanceNo].print(!reportfilename)
endmethod

-- End of method definition for .print()

------------------------------------------------------------------------
--
-- Method:      printDirect
--
-- Description: print to report directly using the user's preferred printing setting
--
-- Method Type:
-- Arguments:
--  1 R STRING name of report file (.repv)
--
-- Return:
------------------------------------------------------------------------

define method .printDirect(!reportfilename is STRING)
   !!reportpmlinstance.pmlReport[!this.instanceNo].printDirect(!reportfilename)
endmethod

-- End of method definition for .printDirect()

------------------------------------------------------------------------
--
-- Method:      exportAsPdf
--
-- Description: export report as Pdf
--
-- Method Type:
-- Arguments:
--  1 R STRING name of report file (.repv)
--  2 R STRING name of PDF file where the content of report will be exported.
--  The file will be generated at the specified directory with specified name
-- Return:
------------------------------------------------------------------------

define method .exportAsPdf(!reportfilename is STRING, !pdfFileName is STRING)
	!!reportpmlinstance.pmlReport[!this.instanceNo].exportAsPdf(!reportfilename, !pdfFileName)
endmethod

-- End of method definition for .exportAsPdf()

------------------------------------------------------------------------
--
-- Method:      exportAsXls
--
-- Description: export report as Xls
--
-- Method Type:
-- Arguments:
--  1 R STRING name of report file (.repv)
--  2 R STRING name of Xls file where the content of report will be exported.
--  The file will be generated at the specified directory with specified name
-- Return:
------------------------------------------------------------------------

define method .exportAsXls(!reportfilename is STRING, !xlsFileName is STRING)
	!!reportpmlinstance.pmlReport[!this.instanceNo].exportAsXls(!reportfilename, !xlsFileName)
endmethod

-- End of method definition for .exportAsXls()

------------------------------------------------------------------------

--
-- Method:      exportAsXls
--
-- Description: export report as Xls
--
-- Method Type:
-- Arguments:
--  1 R STRING name of report file (.repv)
--  2 R STRING name of Xlsx file where the content of report will be exported.
--  3 R/RW STRING Allow export of a document into single file or different files
--  4 R/RW STRING Specifying the range of pages.The ranges are separated by commas. For example: "1,3,5-12"
--  5 R/RW STRING name of sheet
--  6 R/RW STRING name of export text mode either text or value
--  7 R/RW BOOLEAN True to show the grid lines in the resulting XLS file; otherwise, false
--  The file will be generated at the specified directory with specified name
-- Return:
------------------------------------------------------------------------

define method .exportAsXls(!reportfilename is STRING, !xlsFileName is STRING,  !exportmode is STRING, !pagerange is STRING, !sheetName is STRING, !textExportMode is STRING, !showGridLines is BOOLEAN )
	!!reportpmlinstance.pmlReport[!this.instanceNo].exportAsXls(!reportfilename, !xlsFileName, !exportmode, !pagerange, !sheetName, !textExportMode, !showGridLines )
endmethod

-- End of method definition for .exportAsXls()

