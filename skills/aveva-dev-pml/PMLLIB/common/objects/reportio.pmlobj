define method .exportAsXlsx(!reportfilename is STRING, !xlsxFileName is STRING,  !exportmode is STRING, !pagerange is STRING, !sheetName is STRING, !textExportMode is STRING, !showGridLines is BOOLEAN )
	!!reportpmlinstance.pmlReport[!this.instanceNo].exportAsXlsx(!reportfilename, !xlsxFileName, !exportmode, !pagerange, !sheetName, !textExportMode, !showGridLines )
