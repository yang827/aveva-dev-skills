--
--  Description:     -- Test that two derived data input directions are parallel and opposite-- Input 1:  DIRECTION-- Input 2:  DIRECTION--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  debug()                          BOOLEAN             Returns true if debug mode switched on (!!assocDebug = true)
--  isOpposite()                     BOOLEAN             Perform parallel and opposite test on input restriction members
--  testev()                         BOOLEAN             return success or failure of direction opposite test
--  trace()                          -                   Output trace if variable !!assocTrace is true
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            resdiropposite.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Test that two derived data input directions are parallel and opposite
-- Input 1:  DIRECTION
-- Input 2:  DIRECTION
--
------------------------------------------------------------------------
--

define object RESDIROPPOSITE

  -----------  ASSOCIATION MEMBERS  -----------
  -- Association
  member .association    is DBREF
  -- Restriction
  member .component      is DBREF
  -- Input member 1 reference object
  member .resMember1     is DBREF
  -- Input member 2 reference object
  member .resMember2     is DBREF
  -- Input member 1 ASSMBR
  member .mbrResMember1  is DBREF
  -- Input member 2 ASSMBR
  member .mbrResMember2  is DBREF

  -----------  LOCAL MEMBERS  -----------
  -- Allowable tolerance in angle between directions ( degrees )
  member .angleTolerance is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      testev
--
-- Description: return success or failure of direction opposite test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if inputs are parallel and opposite. False otherwise
--
------------------------------------------------------------------------
define method .testev() is BOOLEAN

  -- initialise variables
  -- Angular tolerance of 0.1 degrees
  !this.angleTolerance = 0.1

  -- output trace if enabled
  !this.trace()

  -- Check for parallel and opposite inputs
  if( !this.debug() ) then
    -- do not handle errors in debug mode
    !result = !this.isOpposite()
  else
    -- Do the test, making sure that all errors are handled
    !result = !this.isOpposite()
    handle any
      !result = false
    endhandle
  endif

  return !result

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      isOpposite
--
-- Description: Perform parallel and opposite test on input restriction members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isOpposite() is BOOLEAN

  -- get direction from member1 and member2
  !dirMember1 = !this.mbrResMember1.direv
  !dirMember2 = !this.mbrResMember2.direv

  -- check that directions are parallel within tolerance
  !cosAngleBetweenDirections = !dirMember1.dot(!dirMember2)
  !isOppositeDir = ( ( !cosAngleBetweenDirections ) lt cos( 180 - !this.angleTolerance ) )

  return !isOppositeDir

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      trace
--
-- Description: Output trace if variable !!assocTrace is true
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .trace()

  -- output trace if enabled
  !traceOn = false
  !traceOn = !!assocTrace
  handle any
    return
  endhandle
  if( !traceOn ) then
    WRITE |RESDIROPPOSITE|
    !temp = '   ASSOC:' + !this.association.name + ' RESTRI:' + !this.component.name + ' Input1:' + !this.resMember1.name + ' Input2:' +  !this.resMember2.name
    handle any
      !temp = '   Problem with association members: ' + !!error.text
    endhandle
    WRITE |$!temp|
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .debug() is BOOLEAN

  -- output trace if enabled
  !debugOn = false
  !debugOn = !!assocDebug
  handle any
    !debugOn = false
  endhandle
  return !debugOn

endmethod
-- End of function definition
