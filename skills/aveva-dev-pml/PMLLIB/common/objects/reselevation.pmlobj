--
--  Description:     -- Test that the gap between input positions elevations are < = > a given-- distance apart ( gap in Z wrt world )-- Input 1:  POSITION-- Input 2:  POSITION--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  debug()                          BOOLEAN             Returns true if debug mode switched on (!!assocDebug = true)
--  isElevation()                    BOOLEAN             Perform z distance apart test on input restriction members
--  testev()                         BOOLEAN             return success or failure of elevation test
--  trace()                          -                   Output trace if variable !!assocTrace is true
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            reselevation.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Test that the gap between input positions elevations are < = > a given
-- distance apart ( gap in Z wrt world )
-- Input 1:  POSITION
-- Input 2:  POSITION
--
------------------------------------------------------------------------
--

define object RESELEVATION

  -----------  ASSOCIATION MEMBERS  -----------
  -- Association
  member .association    is DBREF
  -- Restriction
  member .component      is DBREF
  -- Input member 1 - actual element
  member .resMember1     is DBREF
  -- Input member 2 - actual element
  member .resMember2     is DBREF
  -- Input member 1 - ASSMBR element
  member .mbrResMember1  is DBREF
  -- Input member 2 - ASSMBR element
  member .mbrResMember2  is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      testev
--
-- Description: return success or failure of elevation test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if input elevations are OK. False otherwise
--
------------------------------------------------------------------------
define method .testev() is BOOLEAN

  -- initialise variables

  -- output trace if enabled
  !this.trace()

  -- Check for parallel inputs
  if( !this.debug() ) then
    -- do not handle errors in debug mode
    !result = !this.isElevation()
  else
    -- Do the test, making sure that all errors are handled
    !result = !this.isElevation()
    handle any
      !result = false
    endhandle
  endif

  return !result

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      isElevation
--
-- Description: Perform z distance apart test on input restriction members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if distance apart is OK. False otherwise
--
------------------------------------------------------------------------
define method .isElevation() is BOOLEAN

  -- get parameters
  !operation  = !this.association.wdesp[1].subString(1,2).upCase()
  handle any
    return false
  endhandle
  !separation = !this.association.ddesp[2]
  handle any
    return false
  endhandle

  -- get position from member1 and member2
  !posMember1   = !this.mbrResMember1.posev
  !posMember2   = !this.mbrResMember2.posev

  -- check distance
  !elevation1   = !posMember1.wrt( /* ).up
  !elevation2   = !posMember2.wrt( /* ).up
  !difference   = !elevation1 - !elevation2
  if( !operation eq 'LE' ) then
    !distanceOk = !difference.abs().leq(!separation)
  elseif( !operation eq 'GE' ) then
    !distanceOk = !difference.abs().geq(!separation)
  elseif( !operation eq 'EQ' ) then
    -- allow 1/64 inch tolerance for equal
    !difference = !difference.abs() - !separation
    !distanceOk = !difference.abs().lt(0.4mm)
  else
    !distanceOk = false
  endif


  return !distanceOk

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      trace
--
-- Description: Output trace if variable !!assocTrace is true
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .trace()

  -- output trace if enabled
  !traceOn = false
  !traceOn = !!assocTrace
  handle any
    return
  endhandle
  if( !traceOn ) then
    WRITE |RESELEVATION|
    !temp = '   ASSOC:' + !this.association.name + ' RESTRI:' + !this.component.name + ' Input1:' + !this.mbrResMember1.name + ' Input2:' +  !this.mbrResMember2.name
    handle any
      !temp = '   Problem with association members: ' + !!error.text
    endhandle
    WRITE |$!temp|
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .debug() is BOOLEAN

  -- output trace if enabled
  !debugOn = false
  !debugOn = !!assocDebug
  handle any
    !debugOn = false
  endhandle
  return !debugOn

endmethod
-- End of function definition
