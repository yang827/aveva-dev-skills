--
--  Description:     -- Test that two derived data input directions are parallel and check-- separation rule-- Input 1:  POSITION + DIRECTION-- Input 2:  POSITION + DIRECTION--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  debug()                          BOOLEAN             Returns true if debug mode switched on (!!assocDebug = true)
--  isParallel()                     BOOLEAN             Perform parallel test on input restriction members
--  testev()                         BOOLEAN             return success or failure of parallel test
--  trace()                          -                   Output trace if variable !!assocTrace is true
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            resparalleloffset.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Test that two derived data input directions are parallel and check
-- separation rule
-- Input 1:  POSITION + DIRECTION
-- Input 2:  POSITION + DIRECTION
--
------------------------------------------------------------------------
--

define object RESPARALLELOFFSET

  -----------  ASSOCIATION MEMBERS  -----------
  -- Association
  member .association    is DBREF
  -- Restriction
  member .component      is DBREF
  -- Input member 1 - actual element
  member .resMember1     is DBREF
  -- Input member 2 - actual element
  member .resMember2     is DBREF
  -- Input member 1 - ASSMBR element
  member .mbrResMember1  is DBREF
  -- Input member 2 - ASSMBR element
  member .mbrResMember2  is DBREF

  -----------  LOCAL MEMBERS  -----------
  -- Allowable tolerance in angle between directions ( degrees )
  member .angleTolerance is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      testev
--
-- Description: return success or failure of parallel test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if inputs are parallel. False otherwise
--
------------------------------------------------------------------------
define method .testev() is BOOLEAN

  -- initialise variables
  -- Angular tolerance of 0.1 degrees
  !this.angleTolerance = 0.1

  -- output trace if enabled
  !this.trace()

  -- Check for parallel inputs
  if( !this.debug() ) then
    -- do not handle errors in debug mode
    !result = !this.isParallel()
  else
    -- Do the test, making sure that all errors are handled
    !result = !this.isParallel()
    handle any
      !result = false
    endhandle
  endif

  return !result

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      isParallel
--
-- Description: Perform parallel test on input restriction members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if directions are parallel. False otherwise
--
------------------------------------------------------------------------
define method .isParallel() is BOOLEAN

  -- get parameters
  !operation  = !this.association.wdesp[1].subString(1,2).upCase()
  handle any
    return false
  endhandle
  !separation = !this.association.ddesp[2]
  handle any
    return false
  endhandle

  -- get point vectors from member1 and member2
  !posMember1   = !this.mbrResMember1.posev
  !posMember2   = !this.mbrResMember2.posev
  !dirMember1   = !this.mbrResMember1.direv
  !dirMember2   = !this.mbrResMember2.direv

  -- check that directions are parallel within tolerance
  !cosAngleBetweenDirections = !dirMember1.dot(!dirMember2)
  !isParallelDir = ( !cosAngleBetweenDirections.abs() gt cos( !this.angleTolerance ) )

  if( !isParallelDir.not() ) then
    return false
  endif

  -- directions are parallel = now check distance
  !pv           = object POINTVECTOR(!posMember1, !dirMember1)
  !line         = !pv.line(1000mm)
  !distance     = !posMember2.distance(!line)
  if( !operation eq 'LE' ) then
    !pointOnLine = !distance.abs().leq(!separation)
  elseif( !operation eq 'GE' ) then
    !pointOnLine = !distance.abs().geq(!separation)
  elseif( !operation eq 'EQ' ) then
    -- allow 1/64 inch tolerance for equal
    !difference = !distance.abs() - !separation
    !pointOnLine = !difference.abs().lt(0.4mm)
  else
    !pointOnLine = false
  endif


  return !pointOnLine

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      trace
--
-- Description: Output trace if variable !!assocTrace is true
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .trace()

  -- output trace if enabled
  !traceOn = false
  !traceOn = !!assocTrace
  handle any
    return
  endhandle
  if( !traceOn ) then
    WRITE |RESPARALLELOFFSET|
    !temp = '   ASSOC:' + !this.association.name + ' RESTRI:' + !this.component.name + ' Input1:' + !this.mbrResMember1.name + ' Input2:' +  !this.mbrResMember2.name
    handle any
      !temp = '   Problem with association members: ' + !!error.text
    endhandle
    WRITE |$!temp|
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .debug() is BOOLEAN

  -- output trace if enabled
  !debugOn = false
  !debugOn = !!assocDebug
  handle any
    !debugOn = false
  endhandle
  return !debugOn

endmethod
-- End of function definition
