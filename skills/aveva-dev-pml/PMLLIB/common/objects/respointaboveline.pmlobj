--
--  Description:     -- Test that member 1 position lies above the line defined by the member 2-- position and direction (within given parameters)-- Input 1:  POSITION-- Input 2:  POSITION + DIRECTION--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  debug()                          BOOLEAN             Returns true if debug mode switched on (!!assocDebug = true)
--  isPointAboveLine()               BOOLEAN
--  testev()                         BOOLEAN             return success or failure of test
--  trace()                          -                   Output trace if variable !!assocTrace is true
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            respointaboveline.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Test that member 1 position lies above the line defined by the member 2
-- position and direction (within given parameters)
-- Input 1:  POSITION
-- Input 2:  POSITION + DIRECTION
--
------------------------------------------------------------------------
--

define object RESPOINTABOVELINE

  -----------  ASSOCIATION MEMBERS  -----------
  -- Association
  member .association    is DBREF
  -- Restriction
  member .component      is DBREF
  -- Input member 1 - actual element
  member .resMember1     is DBREF
  -- Input member 2 - actual element
  member .resMember2     is DBREF
  -- Input member 1 - ASSMBR element
  member .mbrResMember1  is DBREF
  -- Input member 2 - ASSMBR element
  member .mbrResMember2  is DBREF

  -----------  LOCAL MEMBERS  -----------
  -- Allowable tolerance distance between point and plane
  member .tolerance      is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      testev
--
-- Description: return success or failure of test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if inputs are valid. False otherwise
--
------------------------------------------------------------------------
define method .testev() is BOOLEAN

  -- initialise variables
  -- Gap between point and plane tolerance of 0.1mm
  !this.tolerance = 0.1mm

  -- output trace if enabled
  !this.trace()

  -- Check for coplanar inputs
  if( !this.debug() ) then
    -- do not handle errors in debug mode
    !result = !this.isPointAboveLine()
  else
    -- Do the test, making sure that all errors are handled
    !result = !this.isPointAboveLine()
    handle any
      !result = false
    endhandle
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isPointAboveLine
--
-- Description: Perform point on line test on input restriction members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Test result - true if passed
--
------------------------------------------------------------------------
define method .isPointAboveLine() is BOOLEAN

  -- Initialise variables
  -- get parameters
  !operation  = !this.association.wdesp[1].subString(1,2).upCase()
  handle any
    return false
  endhandle
  !separation = !this.association.ddesp[2]
  handle any
    return false
  endhandle

  -- get position and direction from member1 and member2
  !posMember1   = !this.mbrResMember1.posev
  !posMember2   = !this.mbrResMember2.posev
  !dirMember2   = !this.mbrResMember2.direv

  -- get distance from point to a plane defined vertical through member 2
  -- In special case where member 2 is vertical, just check horizontal
  -- distance from point to vertical line
  !pvMember2      = object POINTVECTOR(!posMember2, !dirMember2)
  !dirUp          = object DIRECTION('UP WRT /*')
  !dirPlaneNormal = !dirUp.orthogonal(!dirMember2)
  handle any
    -- case where member 2 is vertical
    !line         = !pvMember2.line(1000mm)
    !distance     = !line.distance(!posMember1)
  elsehandle none
    -- find distance from point to plane through member 2
    !pvNormal     = object POINTVECTOR(!posMember2, !dirPlaneNormal)
    !plane        = !pvNormal.plane()
    !distance     = !posMember1.distance(!plane)
  endhandle

  -- test distance against criterion
  if( !operation eq 'LE' ) then
    !pointAboveLine = !distance.abs().leq(!separation)
  elseif( !operation eq 'GE' ) then
    !pointAboveLine = !distance.abs().geq(!separation)
  elseif( !operation eq 'EQ' ) then
    -- allow 1/64 inch tolerance for equal
    !difference = !distance.abs() - !separation
    !pointAboveLine = !difference.abs().lt(0.4mm)
  else
    !pointAboveLine = false
  endif

  return !pointAboveLine

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      trace
--
-- Description: Output trace if variable !!assocTrace is true
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Message to be output to the command window
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .trace()

  -- output trace if enabled
  !traceOn = false
  !traceOn = !!assocTrace
  handle any
    return
  endhandle
  if( !traceOn ) then
    WRITE |RESPOINTABOVELINE|
    !temp = '   ASSOC:' + !this.association.name + ' RESTRI:' + !this.component.name + ' Input1:' + !this.mbrResMember1.name + ' Input2:' +  !this.mbrResMember2.name
    handle any
      !temp = '   Problem with association members: ' + !!error.text
    endhandle
    WRITE |$!temp|
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .debug() is BOOLEAN

  -- output trace if enabled
  !debugOn = false
  !debugOn = !!assocDebug
  handle any
    !debugOn = false
  endhandle
  return !debugOn

endmethod
-- End of method
