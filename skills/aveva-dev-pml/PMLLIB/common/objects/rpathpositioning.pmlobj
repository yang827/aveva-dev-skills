--
-- File:            rpathpositioning.pmlobj
--   Type:          object Definition
--   Group:         Common
--     Keyword:     GENERAL
--   Module:        design
--   Replaces:
--
-- Author:          Neil Holmes
-- Created:         Wed Apr 16 2008
--
--
-- Description:
--   Object to manage the positioning of elements along an RPATH
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  feature(DBREF)                   BOOLEAN             Set the rPath feature to be modified
--  owningrPath(DBREF)               DBREF
--  rPath(DBREF)                     DBREF               Return RPATH for passed element
--  rPathPositioning()               -                   Constructor
--  rPathPositioning(DBREF)          -                   Constructor
--  setPosition(DBREF,REAL)          BOOLEAN             Sets the current feature position
--  setPositionNear(POSITION,BOOLEAN) BOOLEAN
--
------------------------------------------------------------------------

define object RPATHPOSITIONING

  -- Poly line definition of RPATH
  member .polyline        is  PMLPOLYLINE

  -- Reference Point
  member .referencePoint  is DBREF

  -- Zdistance
  member .zDistance       is REAL

  -- Element belonging to the RPATH (Element being modified)
  member .feature         is DBREF

  -- Reference Attributes for reference point
  member .refAtts         is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      rPathPositioning
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rPathPositioning()

  -- Initialise Variables
  !this.refAtts.clear()
  -- Case sensitive
  !this.refAtts.append('StaRef')
  !this.refAtts.append('PosRef')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rPathPositioning
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element type which can be decomposed into a polyline
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rPathPositioning(!path is DBREF)

  -- Initialise Variables
  !this.rPathPositioning()

  -- Get rPath for passed feature
  !rPath  = !this.rPath(!path)
  if(!rPath.unset()) then
    !!error.text  = 'Feature "' & !feature.flnn & '" does not relate to an RPATH element.'
    return false
  endif

  -- Setup polyline
  !this.polyline  = object PMLPOLYLINE(!rPath)

  if(!this.polyline.unset()) then
    return
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      feature
--
-- Description: Set the rPath feature to be modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be managed along the rPath
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid element
--
------------------------------------------------------------------------
define method .feature(!feature is DBREF) is BOOLEAN

  -- Initialise Variables
  !return         = true

  -- Check element has a point reference attribute
  if(!feature.attributes().intersect(!this.refAtts).unset()) then
    !!error.text  = 'Feature "' & !feature.flnn & '" does not have a point reference attribute.'
    return false
  endif

  -- Get rPath for passed feature
  !rPath  = !this.owningrPath(!feature)
  if(!rPath.unset()) then
    !!error.text  = 'Feature "' & !feature.flnn & '" does not relate to an RPATH element.'
    return false
  endif

  -- Set path
  !this.rPathPositioning(!rPath)

  -- Set Feature
  !this.feature   = !feature

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rPath
--
-- Description: Return RPATH for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to get RPATH for
-- Return:
--   [Data Type] [Description]
--    DBREF       rPath
--
------------------------------------------------------------------------
define method .rPath(!element is DBREF) is DBREF

  -- Initialise Variables
  !type           = !element.fulltype
  !return         = object DBREF()

  -- Check for RPATH

  -- Element is or owned by a RPATH
  !ownTypes       = !element.ahList
  !ownTypes.append(!element.type)
  !oIndex         = !ownTypes.findFirst('RPATH')
  if(!oIndex.set()) then
    !ownList      = !element.ownLst
    !ownList.append(!element)
    return !ownList[!oIndex]
  endif

  -- Does element own a RPATH
  if(!element.list.findFirst('RPATH').set()) then
    do !i indices !element.members
      skip if(!element.members[!i].type.neq('RPATH'))
      return !element.members[!i]
    enddo
  endif

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      owning rPath
--
-- Description: Return the owning RPATH for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to get RPATH for
-- Return:
--   [Data Type] [Description]
--    DBREF       rPath
--
------------------------------------------------------------------------
define method .owningrPath(!element is DBREF) is DBREF

  -- Initialise Variables
  !type           = !element.fulltype
  !return         = object DBREF()

  -- Element is or owned by a RPATH
  !ownTypes       = !element.ahList
  !ownList        = !element.ownLst
  !oIndex         = !ownTypes.findFirst('RPATH')
  if(!oIndex.set()) then
    return !ownList[!oIndex]
  endif

  -- Work up list (invert array)
  !ownList.invert()

  -- Do one of the parents own an RPATH
  do !i indices !ownList
    -- Does owner own an RPATH
    if(!ownList[!i].list.findFirst('RPATH').set()) then
      do !j indices !ownList[!i].members
        skip if(!ownList[!i].members[!j].type.neq('RPATH'))
        return !ownList[!i].members[!j]
      enddo
    endif
  enddo

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPositionNear
--
-- Description: Sets the current feature near point on path from passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to map onto polyline

-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if moved current feature
--
------------------------------------------------------------------------
define method .setPositionNear(!position is POSITION, !dbWrite is BOOLEAN ) is BOOLEAN

  -- Initialise Variables
  !return         = false

  -- Get nearest point on rPath
  !pathPosition   = !this.polyline.near(!position)

  -- Get Reference Point and segments
  !referencePoint = !this.polyline.pointElement()
  !segments       = !this.polyline.pointSegments()

  -- Determine the position along the segment

  -- Is POINTR a "fillet" (features can not be placed on fillet curves)
  !filletCurve    = !referencePoint.type.eq('POINTR').and(!segments[1].objectType().eq('ARC').and(!referencePoint.fRadius.neq(0)))
  if(!filletCurve) then

    -- If there is a second segment, then use it
    if(!segments.size().gt(1)) then
      !segment      = !segments[2]

      -- If point is of the end of the line, then snap it to the nearest end
      !valid        = !segment.onProjected(!pathPosition)
      if(!valid.not()) then
        !distanceA  = !segment.startPosition.distance(!pathPosition)
        !distanceB  = !segment.endPosition.distance(!pathPosition)
        if(!distanceA.leq(!distanceB)) then
          !distance = 0
        else
          !distance = !segment.length()
        endif

      -- Determine distance from start of line
      else
        !distance   = !segment.startPosition.distance(!pathPosition)
      endif
    endif

  -- Non-fillet segments
  else

    -- Initialise zDistance
    !zDistance      = 0

    -- Loop through segments to determine the segment the position lie on
    do !i indices !segments
        -- Ignore segment if point is of the segment
        if(!segments[!i].onProjected(!pathPosition).not()) then
          !zDistance  = !zDistance + !segments[!i].length()
          skip
        endif

        -- Determine distance along the segment
        -- Line
        if(!segments[!i].objectType().eq('LINE')) then
          !distance   = !segments[!i].startPosition.distance(!pathPosition)

        -- Arc
        else
          !newArc     = !segments[!i].endPosition(!pathPosition)
          !distance   = !newArc.length()
        endif

        -- Add accumulated zDistance
        !distance     = !zDistance + !distance
        break
    enddo

  endif

  -- Set position
  if(defined(!distance))then
   if !dbWrite then
      !return = !this.setPosition(!referencePoint, !distance)
   else
       !this.referencePoint    = !referencePoint
       !this.zDistance         = !distance
       return  TRUE
  endif
  endif


  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Sets the current feature position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference point
--    2   R      REAL        Distance from start of segment
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if moved current feature
--
------------------------------------------------------------------------
define method .setPosition(!referencePoint is DBREF, !distance is REAL) is BOOLEAN

  -- Initialise Variables
  !this.referencePoint    = !referencePoint
  !this.zDistance         = !distance

  -- Update element
  !this.feature.posRef    = !referencePoint
  handle ANY
    return false
  endhandle
  !this.feature.zDistance = !distance
  handle ANY
    return FALSE
  endhandle

  -- Return
  return true

endmethod
-- End of method
