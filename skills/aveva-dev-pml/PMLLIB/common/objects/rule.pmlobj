--
-- File:            rule.pmlobj
--   Type:          Object Definition
--   Group:         Rule handling routines
--     Keyword:     RULES
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Wed Dec 17 10:12:14 GMT 1997
--
--
-- Description:
-- object to store a rule definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  insetString()                    STRING              convert rule to an inset command for event driven graphics
--  location(STRING)                 -                   set the location member
--  rule(STRING,STRING,STRING,STRING) BOOLEAN             constructor
--  save()                           ARRAY               return an array of strings to write to a file
--  string()                         STRING              convert to string
--
------------------------------------------------------------------------

-- Define object
define object RULE

  -- name of rule
  member .name is STRING

  -- rule expression to apply to element types
  member .rule is STRING

  -- element types that the rule applies to
  member .types is STRING

  -- description of the rule
  member .description is STRING

  -- where the rule was defined (CADC, PDMS, PROJ, USER)
  member .location is STRING

endobject
-- End of object definition for RULE

------------------------------------------------------------------------
--
-- Method:      !rule()
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name for rule]
--   [2] [R] [STRING] [PDMS rule]
--   [3] [R] [STRING] [types for rule]
--   [4] [R] [STRING] [description for rule]
-- Return:
--   [BOOLEAN] [True if rule if valid or only error (2,201)]
--
------------------------------------------------------------------------
define method .rule(!ruleName is STRING, !ruleValue is STRING, !typeList is STRING, !descValue is STRING) is BOOLEAN

  -- Set data
  !this.name        = !ruleName
  !this.rule        = !ruleValue
  !this.types       = !typeList
  !this.description = !descValue

  -- Check types
  !failTypes        = ''
  !types            = !this.types.split()
  do !type values !types
    var !unusedNoun nounDef $!<type> name
    handle ANY
      !failTypes    = !failTypes & ' ' & !type
    endhandle
  enddo

  -- Check for failed types
  if(!failTypes.trim().empty().not()) then
    !!error.text    = 'Unknown element type(s) - ' & !failTypes.trim()
    return false
  endif

  -- Check if rule needs to be checked
  if(!this.rule.set() and !this.rule.trim().empty().not()) then

    -- Check rule
    var !testCheck ($!<this.rule>)

    -- Can not access attribute, assumes is OK!
    handle (2,201)
      return true
    elsehandle ANY
      !!error.text    = 'The expression (' & !this.rule & ') is invalid. ' & !!error.text
      return false
    endhandle
	
	
    -- At this point, there may be a result. Check to see if the result
    -- can be converted to a Boolean
    !unusedCheck = !testCheck.boolean()
    handle ANY
      !!error.text    = 'The expression (' & !this.rule & ') does not produce a <BOOLEAN> result.'
      return false
    endhandle

  endif

  return true

endmethod
-- End of method definition for .rule(STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !location()
--
-- Description: set the location member
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [value for location member]
--
------------------------------------------------------------------------
define method .location(!value is STRING)

  !this.location = !value

endmethod
-- End of method definition for .location(STRING)

------------------------------------------------------------------------
--
-- Method:      !string()
--
-- Description: convert to string
--
-- Method Type: Function
-- Return:
--   [STRING] [string to represent the rule]
--
------------------------------------------------------------------------
define method .string() is STRING

  -- build the rule string
  !result = 'ALL ( ' + !this.types + ' )'

  -- only add the expression if it is set
  if (!this.rule.trim() ne '') then
    !result = !result + ' WITH (' + !this.rule + ' )'
  endif

  return !result

endmethod
-- End of method definition for .string() STRING

------------------------------------------------------------------------
--
-- Method:      !insetString()
--
-- Description: convert rule to an inset command for event driven graphics
--
-- Method Type: Function
-- Return:
--   [STRING] [inset command based on rule]
--
------------------------------------------------------------------------

-- Define method
define method .insetString() is STRING

  -- split the types into an array
  !typeArray = !this.types.split()

  -- arrange types in inset command format
  !insetCommand = |TYPE inset( |
  do !i indices !typeArray
    if (!i eq 1) then
      !insetCommand = !insetCommand + |'| + !typeArray[!i] + |'|
    else
      !insetCommand = !insetCommand + |, '| + !typeArray[!i] + |'|
    endif
  enddo
  !insetCommand = !insetCommand + | )|

  -- if a rule is defined then append it to the inset command
  if (!this.rule.trim() ne '') then
    !insetCommand = !insetCommand + | and | + !this.rule
  endif

  return !insetCommand

endmethod
-- End of method definition for .insetString() STRING


------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: return an array of strings to write to a file
--
-- Method Type: Function
-- Return:
--   [ARRAY] [array of strings used to recreate the object]
--
------------------------------------------------------------------------
define method .save() is ARRAY

  -- initialise array to contain strings
  !saveContents = ARRAY()

  !saveContents.append('!rule             = object RULE()')
  !saveContents.append('!rule.name        = |' + !this.name.replace('|', '||') + '|')
  !saveContents.append('!rule.rule        = |' + !this.rule.replace('|', '||') + '|')
  !saveContents.append('!rule.types       = |' + !this.types.replace('|', '||') + '|')
  !saveContents.append('!rule.description = |' + !this.description.replace('|', '||') + '|')

  return !saveContents

endmethod
-- End of method definition for .save() ARRAY
