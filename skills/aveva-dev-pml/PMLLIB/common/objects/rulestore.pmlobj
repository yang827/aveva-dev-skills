--
-- File:            rulestore.pmlobj
--   Type:          Object Definition
--   Group:         Rule handling routines
--     Keyword:     RULES
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Wed Dec 17 10:04:26 GMT 1997
--
--
-- Description:
-- object to store all rule types (element, pline, point)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copyToGlobal()                   -                   create a global instance of the object
--  globalInstance()                 -                   create a global instance of the object
--  load()                           -                   load data
--  localCopy()                      RULESTORE           return a local copy of the object
--  ruleStore()                      -                   constructor
--  ruleStore(BOOLEAN)               -                   constructor
--
------------------------------------------------------------------------

-- Define object
define object RULESTORE

  -- flag to indicate if the object is global
  member .global is BOOLEAN

  -- members to store different types of rules

  -- element rules
  member .element is RULESTOREDATA

  -- pline rules
  member .pLine   is RULESTOREDATA

  -- ppoint rules
  member .point   is RULESTOREDATA

endobject
-- End of object definition for RULESTORE

------------------------------------------------------------------------
--
-- Method:      !ruleStore()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ruleStore()

  -- construct each object to hold specific rule types
  !this.element.ruleStoreData('element')
  !this.pLine.ruleStoreData('pline')
  !this.point.ruleStoreData('point')

    -- initialise the global flag
  !this.global = false

endmethod
-- End of method definition for .ruleStore()

------------------------------------------------------------------------
--
-- Method:      !ruleStore(BOOLEAN)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------
define method .ruleStore(!globalValue is BOOLEAN)

  -- construct each object to hold specific rule types
  !this.element.ruleStoreData('element', !globalValue)
  !this.pLine.ruleStoreData('pline', !globalValue)
  !this.point.ruleStoreData('point', !globalValue)

    -- initialise the global flag
  !this.global = !globalValue

endmethod
-- End of method definition for .ruleStore(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- create the global variable
  !!ruleStore = !this
  !!ruleStore.global = true
  !!ruleStore.element.global = true
  !!ruleStore.pLine.global = true
  !!ruleStore.point.global = true

  !!ruleStore.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [GPHREPOPT] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is RULESTORE

  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() RULESTORE

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  !!ruleStore = !this
  !!ruleStore.global = true
  !!ruleStore.element.global = true
  !!ruleStore.pLine.global = true
  !!ruleStore.point.global = true

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load data
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data for each type of rule
  !this.element.load()
  !this.pLine.load()
  !this.point.load()

endmethod
-- End of method definition for .load()
