--
-- File:            rulestoredata.pmlobj
--   Type:          Object Definition
--   Group:         Rule handling routines
--     Keyword:     RULES
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Wed Dec 17 10:09:16 GMT 1997
--
--
-- Description:
-- object to store arrays of data for each default area
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  badName(STRING)                  BOOLEAN             checks to see if a rule name has been used
--  buildNameTable(STRING)           -                   builds the name table for each default area
--  copyToGlobal()                   -                   copy the object to the global instance
--  default()                        -                   default
--  edit(STRING)                     -                   edit rule definitions
--  getIndex(STRING)                 ARRAY               get the index and location for a rule name
--  getRule(STRING)                  RULE                find and return a rule in the list
--  getRules()                       ARRAY               get the rule names from the global rule store
--  getTypeRules()                   ARRAY               gets all rules that apply to single element types
--  include(ANY)                     -                   include a rule in the list
--  load()                           -                   load data
--  localCopy()                      RULESTOREDATA       return a local copy of the object
--  remove(STRING)                   RULE                remove a rule from the list
--  replace(STRING,ANY)              -                   replace a rule in the list
--  ruleStoreData(STRING)            -                   constructor
--  ruleStoreData(STRING,BOOLEAN)    -                   constructor
--  save()                           -                   save the rules
--  sort(ARRAY,ARRAY)                -                   sort a pair of arrays into alphabetical order
--
------------------------------------------------------------------------

-- Define object
define object RULESTOREDATA

  -- current options file name for this object
  member .filename is STRING

  -- types of rules being stored by this object (ELEMENT, PLINE, PPOINT)
  member .ruleType is STRING

  -- global object flag
  member .global is BOOLEAN

  -- members to store rules defined by AVEVA
  member .aveva is ARRAY
  member .avevaNameTable is ARRAY
  member .avevaFile is FILE
  member .avevaSave is BOOLEAN

  -- members to store rules defined in %PDMSDFLTS%
  member .pdms is ARRAY
  member .pdmsNameTable is ARRAY
  member .pdmsFile is FILE
  member .pdmsSave is BOOLEAN

  -- members to store rules defined in %<project name>DFLTS%
  member .proj is ARRAY
  member .projNameTable is ARRAY
  member .projFile is FILE
  member .projSave is BOOLEAN

  -- members to store rules defined in %PDMSUSER%
  member .user is ARRAY
  member .userNameTable is ARRAY
  member .userFile is FILE
  member .userSave is BOOLEAN

endobject
-- End of object definition for RULESTOREDATA

------------------------------------------------------------------------
--
-- Method:      !ruleStoreData()
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [type of rules]
--
------------------------------------------------------------------------
define method .ruleStoreData(!type is STRING)

  -- set file name
  !module = !!module()
  -- implemented a check for the modkey of the module to make sure we are getting the correct outfitting defaults
  !modKey = !module.modKey.upcase()
  handle ANY
    !this.filename = !module.appKey + '-' + !type.lowcase() + '-rules.pmldat'
  elsehandle NONE
    if (!modKey.eq('MARODES')) then
      !this.filename = !module.modKey + '-' + !type.lowcase() + '-rules.pmldat'
    else
      !this.filename = !module.appKey + '-' + !type.lowcase() + '-rules.pmldat'
    endif
  endhandle

  -- initialise the global flag
  !this.global = false

  -- set the rule type
  !this.ruleType = !type

endmethod
-- End of method definition for .ruleStoreData(STRING)

------------------------------------------------------------------------
--
-- Method:      !ruleStoreData(STRING, BOOLEAN)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [type of rules]
--   [2] [R] [BOOLEAN] [flag to indicate global object]
--
------------------------------------------------------------------------
define method .ruleStoreData(!type is STRING, !globalValue is BOOLEAN)

  -- set file name
  !module = !!module()
  !modKey = !module.modKey.upcase()
  handle ANY
    !this.filename = !module.appKey + '-' + !type.lowcase() + '-rules.pmldat'
  elsehandle NONE
    if (!modKey.eq('MARODES')) then
      !this.filename = !module.modKey + '-' + !type.lowcase() + '-rules.pmldat'
    else
      !this.filename = !module.appKey + '-' + !type.lowcase() + '-rules.pmldat'
    endif
  endhandle

  -- initialise the global flag
  !this.global = !globalValue

  -- set the rule type
  !this.ruleType = !type

endmethod
-- End of method definition for .ruleStoreData(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !default()
--
-- Description: default
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .default()

  !module = !!module()

  -- Rules that the standard AVEVA appware is dependent upon,
  -- should be placed in this method.
  -- the format is the same as the user rule data files,
  -- with the exception that !!tmpRuleArray is replaced by !this.aveva

  if (!module.appKey.upcase() eq 'DES') then

    if (!this.ruleType.upcase() eq 'ELEMENT') then
       !rule       = object RULE()
       !rule.name  = |Penetration Holes|
       !rule.rule  = |GTYP eq 'PENH'|
       !rule.types = |CMPF CMFI FITT SBFI|
       !rule.description = |Rule for all Penetration Holes|
       !this.aveva.append(!rule)

       !rule       = object RULE()
       !rule.name  = |HS Restraints|
       !rule.rule  = ||
       !rule.types = |REST|
       !rule.description = |Rule for all HS restraints|
       !this.aveva.append(!rule)

--     elseif (!this.ruleType.upcase() eq 'POINT') then
--
--     elseif (!this.ruleType.upcase() eq 'PLINE') then

    endif

  elseif (!module.appKey.upcase() eq 'SPL') then

     if (!this.ruleType.upcase() eq 'ELEMENT') then
       !rule       = object RULE()
       !rule.name  = |Field Elements|
       !rule.rule  = |type of owner ne 'SPLTMP'|
       !rule.types = |FIELD|
       !rule.description = |General rule for all field elements|
       !this.aveva.append(!rule)

       !rule       = object RULE()
       !rule.name  = |Spool Elements|
       !rule.rule  = |type of owner ne 'SPLTMP'|
       !rule.types = |SPOOL|
       !rule.description = |General rule for all spool elements|
       !this.aveva.append(!rule)

--     elseif (!this.ruleType.upcase() eq 'POINT') then
--
--     elseif (!this.ruleType.upcase() eq 'PLINE') then

    endif

  endif

  !this.avevaFile = object FILE('%PDMSUSER%/' + 'aveva-' + !this.filename)

  -- build the name table for the file
  !this.buildNameTable('aveva')

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [RULESTOREDATA] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is RULESTOREDATA

  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() RULESTOREDATA

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  -- copy the object to the global instance
  !!ruleStore.attribute(!this.ruleType.upcase()) = !this
  !!ruleStore.attribute(!this.ruleType.upcase()).global = true

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method:      !include()
--
-- Description: include a rule in the list
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [RULE]   [rule to add to list]
--
------------------------------------------------------------------------
define method .include(!rule is ANY)

  !location = !rule.location

  -- check name is not empty
  if (!rule.name.trim() eq '') then
    !!messageFile.error(152, 001)
  endif

  -- check if the rule name already exists
  if (!this.badName(!rule.name.trim())) then
    !!messageFile.error(152, 002,  !rule.name)
  endif

  -- append the rule to the appropriate location array and
  -- add the name to the name index
  !this.attribute(!location.upcase()).append(!rule)
  !this.attribute(!location.upcase() + 'NAMETABLE').append(!rule.name.upcase())

  -- sort the rules into alphabetical name order
  !this.sort(!this.attribute(!location.upcase() + 'NAMETABLE'), !this.attribute(!location.upcase()))

  -- set the save flag for the data
  !this.attribute(!location.upcase() + 'SAVE') = true

endmethod
-- End of method definition for .include(ANY)

------------------------------------------------------------------------
--
-- Method:      !replace()
--
-- Description: replace a rule in the list
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of rule to replace]
--   [2] [R] [RULE]   [rule to add to list]
--
------------------------------------------------------------------------
define method .replace(!name is STRING, !rule is ANY)

  -- find the rule
  !ruleIndex = !this.getIndex(!name)
  if (!ruleIndex.unset()) then
    !!messageFile.error(152, 004,  !name)
  endif

  -- check name is not empty
  if (!rule.name.trim() eq '') then
    !!messageFile.error(152, 001)
  endif

  -- check if the new rule and the rule to be replaced have the same name
  if (!this.attribute(!ruleIndex[1].upcase())[!ruleIndex[2]].name ne !name) then
    -- check if the rule name already exists in another rule
    if (!this.badName(!rule.name)) then
      !!messageFile.error(152, 002,  !rule.name)
    endif
  endif

  !rule.location(!ruleIndex[1])

  -- replace the rule
  !this.attribute(!ruleIndex[1].upcase())[!ruleIndex[2]] = !rule
  !this.attribute(!ruleIndex[1].upcase() + 'NAMETABLE')[!ruleIndex[2]] = !rule.name.upcase()

  -- sort the rules into alphabetical name order
  !this.sort(!this.attribute(!ruleIndex[1].upcase() + 'NAMETABLE'), !this.attribute(!ruleIndex[1].upcase()))

  -- set the save flag for the data
  !this.attribute(!ruleIndex[1].upcase() + 'SAVE') = true

endmethod
-- End of method definition for .replace(STRING, ANY)

------------------------------------------------------------------------
--
-- Method:      !remove()
--
-- Description: remove a rule from the list
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [STRING] [Name of rule to remove]
-- Return:
--   [RULE] [rule that has just been removed]
--
------------------------------------------------------------------------
define method .remove(!name is STRING) is RULE

  -- find the rule
  !ruleIndex = !this.getIndex(!name)
  if (!ruleIndex.unset()) then
    !!messageFile.error(152, 004,  !name)
  endif

  -- remove the data from the rule data structure
  !rule = !this.attribute(!ruleIndex[1].upcase()).remove(!ruleIndex[2])
  !this.attribute(!ruleIndex[1].upcase() + 'NAMETABLE').remove(!ruleIndex[2])

  -- set the save flag for the data
  !this.attribute(!ruleIndex[1].upcase() + 'SAVE') = true

  return !rule

endmethod
-- End of method definition for .remove(STRING) RULE

------------------------------------------------------------------------
--
-- Method:      !getRule()
--
-- Description: find and return a rule in the list
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [STRING] [Name of rule to get]
-- Return:
--   [RULE] [rule that has just been located]
--
------------------------------------------------------------------------
define method .getRule(!name is STRING) is RULE

  -- find the rule from the rule name
  !ruleIndex = !this.getIndex(!name)
  if (!ruleIndex.unset()) then
    !!messageFile.errorNoAlert(152, 004,  !name)
  endif

  !rule = !this.attribute(!ruleIndex[1].upcase())[!ruleIndex[2]]

  return !rule

endmethod
-- End of method definition for .getRule(STRING) RULE

------------------------------------------------------------------------
--
-- Method:      !sort()
--
-- Description: sort a pair of arrays into alphabetical order
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [ARRAY] [array of rule names]
--   [2] [R] [ARRAY] [array of rule objects]
--
------------------------------------------------------------------------
define method .sort(!nameArray is ARRAY, !dataArray is ARRAY)

  !tempArray = ARRAY()

  -- sort the rules into alphabetical name order
  !sortedIndices = !nameArray.sortedIndices()
  do !i values !sortedIndices
    !tempArray.append(!dataArray[!i])
  enddo
  !dataArray = !tempArray
  !nameArray.sort()

endmethod
-- End of method definition for .sort(ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method:      !badName()
--
-- Description: checks to see if a rule name has been used
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [STRING] [name of rule]
-- Return:
--   [BOOLEAN] [flag to indicate if name has been used]
--
------------------------------------------------------------------------
define method .badName(!name is STRING) is BOOLEAN

  !tempArray = ARRAY()

  -- group all rule stores into one array
  !tempArray.appendArray(!this.avevaNameTable)
  !tempArray.appendArray(!this.pdmsNameTable)
  !tempArray.appendArray(!this.projNameTable)
  !tempArray.appendArray(!this.userNameTable)

  -- find the first instance of a rule name by doing a case insensitive
  -- search through the rule name table.  If the rule name exists
  -- then it can not be used for a new rule, so return true
  if (!tempArray.findFirst(!name.upcase()).unset()) then
    !check = false
  else
    !check = true
  endif

  return !check

endmethod
-- End of method definition for .badName(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !getIndex()
--
-- Description: get the index and location for a rule name
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [STRING] [rule name]
-- Return:
--   [ARRAY] [index and location for rule]
--
------------------------------------------------------------------------
define method .getIndex(!name is STRING) is ARRAY

  -- find the index for a rule object, given the rule name

  -- search through each area until the rule is found
  !index = !this.avevaNameTable.findFirst(!name.upcase())
  if (!index.unset().not()) then
    !returnArray[1] = 'aveva'
    !returnArray[2] = !index

  else
    !index = !this.pdmsNameTable.findFirst(!name.upcase())
    if (!index.unset().not()) then
      !returnArray[1] = 'PDMS'
      !returnArray[2] = !index

    else
      !index = !this.projNameTable.findFirst(!name.upcase())
      if (!index.unset().not()) then
        !returnArray[1] = 'PROJ'
        !returnArray[2] = !index

      else
        !index = !this.userNameTable.findFirst(!name.upcase())
        if (!index.unset().not()) then
          !returnArray[1] = 'USER'
          !returnArray[2] = !index

        else
          !returnArray = ARRAY()
        endif
      endif
    endif
  endif

  return !returnArray

endmethod
-- End of method definition for .getIndex(STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      !buildNameTable()
--
-- Description: builds the name table for each default area
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [default area to use]
--
------------------------------------------------------------------------
define method .buildNameTable(!location is STRING)

  -- build the name table and set the location for all rules in this location
  do !i indices !this.attribute(!location.upcase())
    !this.attribute(!location.upcase() + 'NAMETABLE')[!i] = !this.attribute(!location.upcase())[!i].name.upcase()
    !this.attribute(!location.upcase())[!i].location(!location)
  enddo

endmethod
-- End of method definition for .buildNameTable(STRING)

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load data
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------
define method .load()

  -- clear the object members
  !this.aveva = ARRAY()
  !this.avevaNameTable = ARRAY()
  !this.pdms = ARRAY()
  !this.pdmsNameTable = ARRAY()
  !this.proj = ARRAY()
  !this.projNameTable = ARRAY()
  !this.user = ARRAY()
  !this.userNameTable = ARRAY()

  -- load default (aveva) rules
  !this.default()

  -- Get all locations of options file, this will return an
  -- array of objects, one object for each location of the
  -- options file, valid locations are PDMS, PROJ, USER
  !files = !!searchPaths(!this.filename)

  do !defaultFile values !files

    -- create a temporary global variable to store the data
    if (defined(!!tmpRuleArray)) then
      !!tmpRuleArray.delete()
    endif
    !!tmpRuleArray = ARRAY()

    -- load the data
    !localName = !defaultFile.file.fullName()
    $m "$!<localName>"
    handle any
      !!messageFile.error(152, 005, !defaultFile.file.fullName())
      skip
    endhandle

    !this.attribute(!defaultFile.defaultType.upcase()) = !!tmpRuleArray
    !!tmpRuleArray.delete()

    !this.attribute(!defaultFile.defaultType.upcase() + 'FILE') = !defaultFile.file

    -- build the name table for the file
    !this.buildNameTable(!defaultFile.defaultType)

  enddo

  -- reset all the save flags
  !this.avevaSave = false
  !this.pdmsSave = false
  !this.projSave = false
  !this.userSave = false

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the rules
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  !saveArray = ARRAY()

  -- populate an array with the file locations to save
  if (!this.avevaSave) then
    !saveArray.append('AVEVA')
  endif
    if (!this.pdmsSave) then
    !saveArray.append('PDMS')
  endif
  if (!this.projSave) then
    !saveArray.append('PROJ')
  endif
  if (!this.userSave) then
    !saveArray.append('USER')
  endif

  do !location values !saveArray

    -- initialise array for file contents
    !saveContents = ARRAY()

    -- write header information
    !saveContents.append('-- Data file containing ' + !this.ruleType + ' rule definitions')
    !saveContents.append('')

    do !rule values !this.attribute(!location.upcase())
      !saveContents.appendArray(!rule.save())
      !saveContents.append('!!tmpRuleArray.append(!rule)')
      !saveContents.append('')
    enddo

    if (!this.attribute(!location.upcase() + 'FILE').unset()) then
      if (!location.upcase() eq 'AVEVA') then
        !saveFile = object FILE('%PDMSUSER%/' + 'AVEVA-' + !this.filename)
        !!alert.message('Default rules will be saved to ' + !saveFile + ' These should only be added to the RULESTOREDATA object, if PDMS is dependent on them')
      elseif (!location.upcase() eq 'PDMS') then
        !saveFile = object FILE('%PDMSDFLTS%/' + !this.filename)
      elseif (!location.upcase() eq 'PROJ') then
        !evar = CURRENT PROJECT
        !project = !evar.evar.subString(1,3)
        !saveFile = object FILE('%' + !project + 'DFLTS%/' + !this.filename)
      else
        !saveFile = object FILE('%PDMSUSER%/' + !this.filename)
      endif
      !this.attribute(!location.upcase() + 'FILE') = !saveFile
    endif

    !this.attribute(!location.upcase() + 'FILE').writeFile('OVERWRITE', !saveContents)
    handle any
      !!alert.warning(!!error.text)
    endhandle

    -- reset the save flag
    !this.attribute(!location.upcase() + 'SAVE') = false

  enddo

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
-- Description: edit rule definitions
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [function to run on ok action]
--
------------------------------------------------------------------------
define method .edit(!func is STRING)

  -- load the form if it is undefined
  if (undefined(!!ruleDef)) then
    pml load form !!ruleDef
  endif

  -- initialise the form data member to store this object
  !!ruleDef.data = !this

  -- set the additional function for the ok action
  !!ruleDef.function = !func

  -- if the form is shown, then run the initialisation
  -- otherwise, just show the form
  if (!!ruleDef.shown()) then
    -- Run the initialisation
    !!ruleDef.init()
  else
    -- Show the form
    show !!ruleDef
  endif

endmethod
-- End of method definition for .edit(STRING)

------------------------------------------------------------------------
--
-- Method:      !getTypeRules()
--
-- Description: gets all rules that apply to single element types
--
-- Method Type: Function
-- Return:
--   [ARRAY] [array of rule names]
--
------------------------------------------------------------------------
define method .getTypeRules() is ARRAY

  !ruleList = ARRAY()

  -- in each area get the rule name for each rule that only
  -- applies to single element types
  do !i indices !this.aveva
    if (!this.aveva[!i].types.split().size() eq 1) then
      !ruleList.append(!this.aveva[!i].name)
    endif
  enddo

  do !i indices !this.pdms
    if (!this.pdms[!i].types.split().size() eq 1) then
      !ruleList.append(!this.pdms[!i].name)
    endif

  enddo

  do !i indices !this.proj
    if (!this.proj[!i].types.split().size() eq 1) then
      !ruleList.append(!this.proj[!i].name)
    endif

  enddo

  do !i indices !this.user
    if (!this.user[!i].types.split().size() eq 1) then
      !ruleList.append(!this.user[!i].name)
    endif

  enddo

  return !ruleList


endmethod
-- End of method definition for .getTypeRules() ARRAY

------------------------------------------------------------------------
--
-- Method:      !getRules()
--
-- Description: get the rule names from the global rule store
--
-- Method Type: Function
-- Return:
--   [ARRAY] [array of rule names]
--
------------------------------------------------------------------------
define method .getRules() is ARRAY

  !ruleList = ARRAY()

  -- in each area get the rule name for each rule
  do !i indices !this.aveva
    !ruleList.append(!this.aveva[!i].name)
  enddo

  do !i indices !this.pdms
    !ruleList.append(!this.pdms[!i].name)
  enddo

  do !i indices !this.proj
    !ruleList.append(!this.proj[!i].name)
  enddo

  do !i indices !this.user
    !ruleList.append(!this.user[!i].name)
  enddo

  return !ruleList

endmethod
-- End of method definition for .getRules() ARRAY
