--   Group:         General Application
--     Keyword:     GEN
--   Module:        ALL
--   Replaces:
--
-- Author:          Lars Leppin
-- Created:         Tue Aug 7 09:00:00 GMT 2006
--
-- Description:     container for setting data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  collectAll(STRING)               ARRAY               collect all elements of the given type below the setting
--  setting()                        -                   constructor Method
--  string()                         STRING              returns description
--
define object SETTING

  -- description
  member .description is STRING

  -- purpose
  member .purpose is STRING

  -- contains all setting data
  member .settingData is ARRAY

  -- contains all subsettings
  member .subSettings is ARRAY

  -- added for delete flag
  member .deleteFlag is BOOLEAN

  -- type of the SETTING
  member .type is STRING

endobject
-- End of object definition for Setting

---------------------------------------------------------------------------
--Method:       setting()
--
--Description:  constructor Method
--
--Method Type:  constructor
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
--
--Return:
--             [Data Type] [Description]
--
---------------------------------------------------------------------------

define method .setting()

!this.deleteFlag = false
!this.type = 'DFLTS'

endmethod
--end of Method

---------------------------------------------------------------------------
--Method:       collectAll()
--
--Description:  collect all elements of the given type below the setting
--
--Method Type:  Function
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       STRING      type of element, e.g. STRFLT
--
--Return:
--             [Data Type] [Description]
--              ARRAY       collection of elements
---------------------------------------------------------------------------

define method .collectAll(!element is STRING) is ARRAY

  !settingData = object ARRAY()
  do !subSetting value !this.subSettings
    skip if ( !subSetting.purpose.neq(!element) )
    !settingData = !subSetting.settingData
    break
  enddo

  !return = object ARRAY()
  do !settingDatum value !settingData
    !return.append(!settingDatum.value.dbRef())
  enddo
  return !return

endmethod

---------------------------------------------------------------------------
--Method:       string()
--
--Description:  print out purpose and description
--
--Method Type:  Function
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
--Return:
--             [Data Type] [Description]
--              STRING      object purpose and description
---------------------------------------------------------------------------

define method .string() is STRING

  if !this.description.unset() then
     !result = 'Unset'
  else
     !result = !this.description
  endif

  return  !result

endmethod
