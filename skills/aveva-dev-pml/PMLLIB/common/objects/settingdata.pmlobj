--
--   Description:   container for setting data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  settingdata()                    -                   Default value
--  string()                         STRING              print out purpose and description
--
define object SETTINGDATA

  -- purpose
  member .purpose is STRING

  -- value
  member .value   is STRING

  -- assigned status
  member .assigned is BOOLEAN

endobject
-- End of object definition for SettingData
---------------------------------------------------------------------------
--Method:       settingdata
--
--Description:  Default value
--
--Method Type:  Constructor
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
---------------------------------------------------------------------------
define method .settingdata()

  !this.assigned = true

endmethod
-- end of method
---------------------------------------------------------------------------
--Method:       string()
--
--Description:  print out purpose and description
--
--Method Type:  Function
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
--Return:
--             [Data Type] [Description]
--              STRING      object purpose and description
---------------------------------------------------------------------------

define method .string() is STRING

  !purp = !this.purpose
  if !purp.unset() then
     !purp = ''
  endif

  !val = !this.value
  if !val.unset() then
     !val = ''
  endif

  !result = !purp + ' ' + !val
  !result = !result.trim()

  if !result.empty() then
     !result = 'Unset'
  endif

  return !result

endmethod
-- end of method
