---
-- Description:
--    Object for generating and holding rectangle definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  circle(REAL)                     PROFILE             Default circle shape, with origin at the centre.
--  circlefromcentandrad(POSITION,POSITION) PROFILE             Default circle shape, with origin at the centre.
--

define object SHAPECIRCLE

  -- Description
  member .description         is STRING

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  member .derived             is BOOLEAN

  --radius of circle
  member .radius           is REAL

  --Centre point of derived circle
  --member .derivedcentrepoint is POSITION

  member .xyoffset            is XYPOSITION

  member .originposition      is POSITION

  member .originalorigin      is POSITION

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      circle
--
-- Description: Default circle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       radius
--    2   R      REAL       origin number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .circle(!radius is REAL) is PROFILE

  --!position         = !this.profile.position
  !position         = !this.originalorigin
  !orientation      = !this.profile.orientation
  --!this.derived = FALSE
  --if !this.derived then

    --!derivedcentrepoint = !this.derivedcentrepoint
    --!counter = 1
    --AID CLEAR ALL 22
    --AID TEXT NUMBER 22 '$!counter' AT $!derivedcentrepoint

    --if numeric input gadget set to 1, set position of profile to centre of circle
    --if !origin.eq(1) then
    --  !position = !this.derivedcentrepoint
    --else
    --  !position = !this.originalorigin
    --endif

    --!arc = object arc(!this.derivedcentrepoint,!orientation,0,360,!radius,TRUE)

    --!this.originposition = !position
  --else

    !this.description = 'Circle'

    --not currently doing anything with origin point number for non-derived circle
    --could use this to position circle about origin

    !arc = object arc(!position,!orientation,0,360,!radius,TRUE)

    !this.originposition = !position
  --endif

  !arrayofarcs = ARRAY()
  !arrayofarcs.append(!arc)

  !this.profile = object profile(!position,!orientation,!arrayofarcs)

  --if derived circle, then offset positions to position of derived shape

  if !this.derived then
    !this.profile.translate(!this.xyoffset.x,!this.xyoffset.y)
  endif

   return !this.profile

endmethod
------------------------------------------------------------------------
--
-- Method:      circlefromcentandrad
--
-- Description: Default circle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       radius
--    2   R      REAL       origin number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .circlefromcentandrad(!centrepoint is POSITION, !radiuspoint is POSITION) is PROFILE

  !this.description = 'Derived Circle'
  !this.derived = TRUE

  !position         = !this.profile.position
  !orientation      = !this.profile.orientation

  !centrepointonplane     = !this.plane.near(!centrepoint)
  !radiuspointonplane     = !this.plane.near(!radiuspoint)

  --!this.derivedcentrepoint = !centrepointonplane

  !this.xyoffset = !this.plane.xyoffset(!centrepointonplane)

  !radius = !centrepointonplane.distance(!radiuspointonplane)
  !this.radius = !radius

  !arc = object arc(!centrepointonplane,!orientation,0,360,!radius,TRUE)

  !arrayofarcs = ARRAY()
  !arrayofarcs.append(!arc)

  !this.originposition = !position

  !this.profile = object profile(!position,!orientation,!arrayofarcs)

   return !this.profile

endmethod

------------------------------------------------------------------------
