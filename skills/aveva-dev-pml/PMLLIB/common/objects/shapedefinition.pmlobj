---
-- Description:
--    Object for holding basic geometry definition for shapes passed
--    between forms in accommodation and ASL applications
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL)                 -                   Set aid numbers
--  circle(REAL)                     PROFILE             Default circle shape, with origin at the centre.
--  circlefromcentandrad(POSITION,POSITION) PROFILE             Default circle shape, with origin at the centre.
--  draw()                           -                   Draw profile
--  freeform(ARRAY)                  PROFILE             Default rectangle shape, with origin at the centre.
--  lShape(REAL,REAL,REAL,REAL)      PROFILE             Default L shape, with origin at the centre.
--  lshape(REAL)                     PROFILE
--  lshape(REAL,POSITION,POSITION,POSITION) PROFILE
--  polygon(REAL,REAL,STRING)        PROFILE             Default polygon, with origin at the centre.
--  rectangle(POSITION,POSITION)     PROFILE             Default rectangle shape, from corner points (positions)
--  rectangle(REAL,REAL)             PROFILE             Default rectangle shape, with origin at the centre.
--  shapeDefinition()                -                   Constructor
--  shapeDefinition(POSITION,ORIENTATION) -                   Constructor
--

define object SHAPEDEFINITION

  -- Description
  member .description         is STRING

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  -- Rectangle
  member .rectangle           is SHAPERECTANGLE

  -- Circle
  member .circle              is SHAPECIRCLE

  -- L shape
  member .lshape              is SHAPELSHAPE

  -- Free form picked shape
  member .freeform            is SHAPEFREEFORM

  -- Polygon
  member .polygon             is SHAPEPOLYGON

  member .shapeoutlinenum     is REAL

  member .originposition      is POSITION

  member .origintext          is STRING

  --origin first passed
  member .originalorigin      is POSITION

  member .originalnonderivedprofile is PROFILE

  member .derived             is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      shapeDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shapeDefinition()

  -- Initialise Variables
  !this.profile.position    = N0
  !this.profile.orientation = Y is N
  !this.plane               = object PLANE(!this.profile.position, !this.profile.orientation)

  !this.shapeoutlinenum = !!aidNumbers.add('Shape Definition - Shape Outline')
  !this.origintext = 'Origin'
  !this.derived = FALSE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shapeDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Default position
--    2   R      ORIENTATION Default orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shapeDefinition(!position is POSITION, !orientation is ORIENTATION)

  -- Initialise Variables
  !this.profile.position    = !position
  !this.profile.orientation = !orientation
  !this.plane               = object PLANE(!position, !orientation)

  !this.shapeoutlinenum = !!aidNumbers.add('Shape Definition - Shape Outline')
  !this.origintext = 'Origin'
  !this.derived = FALSE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Don't draw if there is no aid number
  if(!this.shapeoutlinenum.unset())then
    return
  endif

  aid clear all $!<this.shapeoutlinenum>
  !this.profile.draw(!this.shapeoutlinenum,1,4)
  --draw !this.origintext at !this.originposition
  AID TEXT NUMBER $!<this.shapeoutlinenum> 'ORIGIN' AT $!<this.originposition>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .aidNumbers(!shapeoutlinenum is REAL)

  -- Set Aid number
  !this.shapeoutlinenum = !shapeoutlinenum

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Default rectangle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       X dimension
--    2   R      REAL       Y dimension
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

--define method .rectangle(!x is REAL, !y is REAL) is PROFILE
--  return !this.rectangle(!x, !y)
--endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Default rectangle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       X dimension
--    2   R      REAL       Y dimension
--    3   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .rectangle(!x is REAL, !y is REAL) is PROFILE

  !this.rectangle.profile = !this.profile
  !this.rectangle.plane = !this.plane
  !this.rectangle.originalorigin = !this.originalorigin

  !this.rectangle.rectangle(!x,!y)
  !this.derived = !this.rectangle.derived
  !this.description = !this.rectangle.description
  !this.profile = !this.rectangle.profile
  !this.originposition = !this.rectangle.originposition
  !this.originalnonderivedprofile = !this.profile
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Default rectangle shape, from corner points (positions)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION   Corner pos 1
--    2   R      POSITION   Corner pos 2 (opposite)
--    3   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .rectangle(!pos1 is POSITION, !pos2 is POSITION) is PROFILE

  !this.rectangle.profile = !this.profile
  !this.rectangle.plane = !this.plane
  !this.rectangle.originalorigin = !this.originalorigin

  !this.rectangle.rectangle(!pos1,!pos2)
  !this.derived = !this.rectangle.derived
  !this.description = !this.rectangle.description
  !this.profile = !this.rectangle.profile
  !this.originposition = !this.rectangle.originposition
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lShape
--
-- Description: Default L shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    X axis, True for Right, False for Left
--    2   R      BOOLEAN    Y axis, True for Right, False for Left
--    3   R      REAL       X dimension
--    4   R      REAL       X1 dimension
--    5   R      REAL       X dimension
--    6   R      REAL       Y1 dimension
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

--define method .lShape(!xAxis is BOOLEAN, !yAxis is BOOLEAN, !x is REAL, !x1 is REAL, !y is REAL, !y1 is REAL) is PROFILE
--  return !this.lShape(!xAxis, !yAxis, !x, !x1, !y, !y1, 0)
--endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lShape
--
-- Description: Default L shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    X axis, True for Right, False for Left
--    2   R      BOOLEAN    Y axis, True for Right, False for Left
--    3   R      REAL       X dimension
--    4   R      REAL       X1 dimension
--    5   R      REAL       X dimension
--    6   R      REAL       Y1 dimension
--    7   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .lShape(!x is REAL, !x1 is REAL, !y is REAL, !y1 is REAL) is PROFILE

  !this.lshape.profile = !this.profile
  !this.lshape.plane = !this.plane
  !this.lshape.originalorigin = !this.originalorigin

  !this.lshape.lshape(!x,!x1,!y,!y1)
  !this.description = !this.lshape.description
  !this.profile = !this.lshape.profile
  !this.derived = !this.lshape.derived
  !this.originposition = !this.lshape.originposition
  !this.originalnonderivedprofile = !this.profile
  return !this.profile

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      L shape
--
-- Description: L shape, from corner points (positions)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Number of alternative shapes, returned by association
--    1   R      POSITION   Pos 1
--    2   R      POSITION   Pos 2 (corner)
--    3   R      POSITION   Pos 3
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .lshape(!numaltshapes is REAL, !pos1 is POSITION, !pos2 is POSITION, !pos3 is POSITION) is PROFILE

  !this.lshape.profile = !this.profile
  !this.lshape.plane = !this.plane
  !this.lshape.originalorigin = !this.originalorigin
  !numaltshapes = 1
  !this.lshape.lshape(!numaltshapes,!pos1,!pos2,!pos3)

  !this.description = !this.lshape.description
  !this.profile = !this.lshape.profile
  !this.derived = !this.lshape.derived
  !this.originposition = !this.lshape.originposition
  return !this.profile

endmethod
-- End of method
------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      L shape
--
-- Description: Switch to Lshape from array of alternative Lshapes (derived Lshapes)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Alternative shape number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .lshape(!altlshape is REAL) is PROFILE

  !this.lshape.lshape(!altlshape)

  !this.profile = !this.lshape.profile

  return !this.profile

endmethod
-- End of method
------------------------------------------------------------------------
-- Method:      freeform
--
-- Description: Default rectangle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Array of points
--    2   R      REAL       Origin number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------
define method .freeform(!arrayofpoints is ARRAY) is PROFILE

  !this.freeform.profile = !this.profile
  !this.freeform.plane = !this.plane
  !this.freeform.originalorigin = !this.originalorigin

  !this.freeform.freeform(!arrayofpoints)
  !this.derived     = !this.freeform.derived
  !this.description = !this.freeform.description
  !this.profile = !this.freeform.profile
  !this.originposition = !this.freeform.originposition

  return !this.profile

endmethod
------------------------------------------------------------------------
--
-- Method:      circle
--
-- Description: Default circle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       radius
--    2   R      REAL       origin number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .circle(!radius is REAL) is PROFILE

  !this.circle.profile = !this.profile
  !this.circle.plane = !this.plane
  !this.circle.originalorigin = !this.originalorigin


  !this.circle.circle(!radius)
  !this.description = !this.circle.description
  !this.profile = !this.circle.profile
  !this.originposition = !this.circle.originposition
  !this.originalnonderivedprofile = !this.profile
  return !this.profile

endmethod
------------------------------------------------------------------------
--
-- Method:      circlefromcentandrad
--
-- Description: Default circle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       radius
--    2   R      REAL       origin number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .circlefromcentandrad(!centrepoint is POSITION, !radiuspoint is POSITION) is PROFILE

  !this.circle.profile = !this.profile
  !this.circle.plane = !this.plane
  !this.circle.originalorigin = !this.originalorigin

  !this.circle.circlefromcentandrad(!centrepoint,!radiuspoint)
  !this.derived = !this.circle.derived
  !this.description = !this.circle.description
  !this.profile = !this.circle.profile
  !this.originposition = !this.circle.originposition

  return !this.profile

endmethod


------------------------------------------------------------------------
--
-- Method:      polygon
--
-- Description: Default polygon, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Number of sides
--    2   R      REAL       Distance across
--    3   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .polygon(!numsides is REAL, !distance is REAL, !dimtype is STRING) is PROFILE

  !this.polygon.profile = !this.profile
  !this.polygon.plane = !this.plane

  !this.polygon.polygon(!numsides,!distance,!dimtype)
  !this.description = !this.polygon.description
  !this.profile = !this.polygon.profile
  !this.derived = !this.polygon.derived
  !this.originposition = !this.polygon.originposition
  !this.originalnonderivedprofile = !this.profile
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
