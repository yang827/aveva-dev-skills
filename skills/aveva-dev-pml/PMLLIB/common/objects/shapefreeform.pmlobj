---
-- Description:
--    Object for generating and holding rectangle definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  freeform(ARRAY)                  PROFILE             Default rectangle shape, with origin at the centre.
--

define object SHAPEFREEFORM

  -- Description
  member .description         is STRING

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  member .originposition      is POSITION

  member .originalorigin      is POSITION

  member .derived             is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      freeform
--
-- Description: Default rectangle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Array of points
--    2   R      REAL       Origin number
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------
define method .freeform(!arrayofpoints is ARRAY) is PROFILE

  --could have 'freeform shape with x vertices'
  !this.description = 'Freeform picked shape'
  !this.derived = TRUE
  --map points onto plane

  !pointsonplanearray = ARRAY()

  do !i values !arrayofpoints
    !pointonplane = !this.plane.near(!i)
    !pointsonplanearray.append(!pointonplane)
  enddo

  --draw points on plane
  --AID CLEAR ALL 22
  --!counter = 1
  --do !i values !pointsonplanearray

  --  AID TEXT NUMBER 22 '$!counter' AT $!i
  --  !counter = !counter + 1

  --enddo

  --draw origin

  -- Define Profile

  -- If origin is other than zero, move origin point of profile to numbered point
  --if(!origin.neq(0)) then
  --  !position = !pointsonplanearray[!origin]
  --else
    !position         = !this.originalorigin
  --endif

  !orientation      = !this.profile.orientation
  !this.profile = object profile(!position,!orientation,!pointsonplanearray)
  --!this.profile.draw(1,1,1)
  !this.profile.close()

  !this.originposition = !position

  return !this.profile

endmethod
------------------------------------------------------------------------
