---
-- Description:
--    Object for generating and holding rectangle definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  lShape(REAL,REAL,REAL,REAL)      PROFILE             Default L shape, with origin at the centre.
--  lshape(REAL)                     PROFILE
--  lshape(REAL,POSITION,POSITION,POSITION) PROFILE
--

define object SHAPELSHAPE

  -- Description
  member .description         is STRING

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  member .derived      is BOOLEAN

  member .x1            is REAL
  member .y1            is REAL
  member .x2            is REAL
  member .y2            is REAL

  member .lshapeSolution1 is ARRAY
  member .lshapeSolution2 is ARRAY

  --member .distanceoffset      is REAL
  --member .directionoffset     is DIRECTION

  member .profilearray is ARRAY

  member .xyoffset is XYPOSITION

  member .originposition      is POSITION

  member .originalorigin      is POSITION

endobject
-- End of object definition

------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      lShape
--
-- Description: Default L shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    X axis, True for Right, False for Left
--    2   R      BOOLEAN    Y axis, True for Right, False for Left
--    3   R      REAL       X dimension
--    4   R      REAL       X1 dimension
--    5   R      REAL       X dimension
--    6   R      REAL       Y1 dimension
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

--define method .lShape(!xAxis is BOOLEAN, !yAxis is BOOLEAN, !x is REAL, !x1 is REAL, !y is REAL, !y1 is REAL) is PROFILE
--  return !this.lShape(!xAxis, !yAxis, !x, !x1, !y, !y1, 0)
--endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lShape
--
-- Description: Default L shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    X axis, True for Right, False for Left
--    2   R      BOOLEAN    Y axis, True for Right, False for Left
--    3   R      REAL       X dimension
--    4   R      REAL       X1 dimension
--    5   R      REAL       X dimension
--    6   R      REAL       Y1 dimension
--    7   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .lShape(!x is REAL, !x1 is REAL, !y is REAL, !y1 is REAL) is PROFILE

  -- Initialise Variables
  !this.description = 'L Shape X: ' & !x.string(!!distanceFmt) & ' Y: ' & !y.string(!!distanceFmt)

  --  Definition of points
  !points           = ARRAY()
  !points.append(object XYPOSITION(!x, 0))
  !points.append(object XYPOSITION(!x, !y))
  !points.append(object XYPOSITION(0, !y))
  !points.append(object XYPOSITION(0, !y - !y1))
  !points.append(object XYPOSITION(!x - !x1, !y - !y1))
  !points.append(object XYPOSITION(!x - !x1, 0))

  -- Derive the position with respect to the plane
  !positions        = ARRAY()
  do !i indices !points
    !positions.append(!this.plane.threeDPosition(!points[!i]))
  enddo

  -- Define Profile
  !position            = !this.profile.position
  !this.originposition = !position
  !orientation         = !this.profile.orientation
  !this.profile        = object PROFILE(!position, !orientation, !positions)
  !this.profile.close()

  --if derived lshape, then offset positions to position of derived shape

  if (!this.derived) then
    !this.profile.translate(!this.xyoffset.x,!this.xyoffset.y)
  endif

  -- Return profile
  return !this.profile

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      L shape
--
-- Description: L shape, from corner points (positions)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION   Pos 1
--    2   R      POSITION   Pos 2 (corner)
--    3   R      POSITION   Pos 3
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .lshape(!numaltshapes is REAL, !pos1 is POSITION, !pos3 is POSITION, !pos2 is POSITION) is PROFILE

  -- Initialise Variables
  !this.description = 'L shape derived from 3 points'
  !this.derived = TRUE

  !position         = !this.profile.position
  !orientation      = !this.profile.orientation
  !numaltshapes = 2
  --First L shape from the 3 points

  --Define six points around L shape

  !point1 = !this.plane.near(!pos1)

  !point3 = !this.plane.near(!pos2)

  !point5 = !this.plane.near(!pos3)

  !pv1 = object pointvector(!point1,!orientation.xdir())

  !pv2 = object pointvector(!point3,!orientation.ydir())

  !point2 = !pv1.intersection(!pv2)

  !pv3 = object pointvector(!point3,!orientation.xdir())

  !pv4 = object pointvector(!point5,!orientation.ydir())

  !point4 = !pv3.intersection(!pv4)

  !pv5 = object pointvector(!point1,!orientation.ydir())

  !pv6 = object pointvector(!point5,!orientation.xdir())

  !point6 = !pv5.intersection(!pv6)

  --calculate xlen and ylen of rectangle to put back into form

  !this.x1 = !point6.distance(!point5)
  !this.y1 = !point1.distance(!point6)
  !this.x2 = !point1.distance(!point2)
  !this.y2 = !point4.distance(!point5)

  -- Store lshape solution 1 dimensions
  !this.lshapeSolution1.append(!this.x1)
  !this.lshapeSolution1.append(!this.y1)
  !this.lshapeSolution1.append(!this.x2)
  !this.lshapeSolution1.append(!this.y2)

  --calculate origin position (to offset l-shapes re-sized using
  --text gadgets on form)

  !oripos = !pv1.intersection(!pv4)

  --calculate offset (direction and distance)
  !this.xyoffset = !this.plane.xyoffset(!oripos)
  --!this.distanceoffset = !this.profile.position.distance(!oripos)
  --!this.directionoffset = !this.profile.position.direction(!oripos)

  !points           = ARRAY()

  !points.append(!point1)
  !points.append(!point2)
  !points.append(!point3)
  !points.append(!point4)
  !points.append(!point5)
  !points.append(!point6)

  !profile     = object PROFILE(!position, !orientation, !points)
  !profile.close()
  !this.profilearray.append(!profile)

  --Second L shape from the 3 points
  --Define six points around L shape

  !point1 = !this.plane.near(!pos1)

  !point3 = !this.plane.near(!pos3)

  !point5 = !this.plane.near(!pos2)

  !pv1 = object pointvector(!point1,!orientation.xdir())

  !pv2 = object pointvector(!point3,!orientation.ydir())

  !point2 = !pv1.intersection(!pv2)

  !pv3 = object pointvector(!point3,!orientation.xdir())

  !pv4 = object pointvector(!point5,!orientation.ydir())

  !point4 = !pv3.intersection(!pv4)

  !pv5 = object pointvector(!point1,!orientation.ydir())

  !pv6 = object pointvector(!point5,!orientation.xdir())

  !point6 = !pv5.intersection(!pv6)

  --calculate xlen and ylen of rectangle to put back into form

  !this.x1 = !point1.distance(!point2)
  !this.y1 = !point2.distance(!point3)
  !this.x2 = !point4.distance(!point3)
  !this.y2 = !point1.distance(!point6)

  -- Store lshape solution 2 dimensions
  !this.lshapeSolution2.append(!this.x1)
  !this.lshapeSolution2.append(!this.y1)
  !this.lshapeSolution2.append(!this.x2)
  !this.lshapeSolution2.append(!this.y2)

  --calculate origin position (to offset l-shapes re-sized using
  --text gadgets on form)

  !oripos = !pv5.intersection(!pv3)

  --calculate offset (direction and distance)
  !this.xyoffset = !this.plane.xyoffset(!oripos)
  --!this.distanceoffset = !this.profile.position.distance(!oripos)
  --!this.directionoffset = !this.profile.position.direction(!oripos)

  !points           = ARRAY()

  !points.append(!point1)
  !points.append(!point2)
  !points.append(!point3)
  !points.append(!point4)
  !points.append(!point5)
  !points.append(!point6)

  !profile     = object PROFILE(!position, !orientation, !points)
  !profile.close()

  !this.profilearray.append(!profile)

  !this.originposition = !position

  !this.profile = !this.profilearray[1]

  -- Return profile
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      L shape
--
-- Description: L shape, from corner points (positions)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION   Pos 1
--    2   R      POSITION   Pos 2 (corner)
--    3   R      POSITION   Pos 3
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------
define method .lshape(!altlshape is REAL) is PROFILE

  !this.profile = !this.profilearray[!altlshape]
  handle ANY
  endhandle
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
