---
-- Description:
--    General shape modifier object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alternativeOrigins()             ARRAY               Derive alternative origins for the profile, i.e. corners
--  intersect(PLANE)                 PROFILE             Intersect the current profile onto the plane
--  intersect(PROFILE)               PROFILE             Intersect the profile onto the plane
--  intersect(PROFILE,PLANE)         PROFILE             Intersect passed profile onto the passed plane
--  mirror(BOOLEAN,BOOLEAN)          PROFILE             Mirror
--  offset(PROFILE,REAL)             PROFILE             Offset passed boundary by given amount and return new profile
--  offset(REAL)                     PROFILE             Offset boundary by given amount
--  project(PLANE)                   PROFILE             Project the current profile onto the plane
--  project(PROFILE)                 PROFILE             Project the profile onto the plane
--  project(PROFILE,PLANE)           PROFILE             Project passed profile onto passed plane
--  shapeModifier()                  -                   Constructor
--  shapeModifier(PROFILE)           -                   Constructor
--

define object SHAPEMODIFIER

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  -- Origin Position
  member .origin              is POSITION

  -- Fixed origin
  member .fixedOrigin         is BOOLEAN

  -- Identifiable origin points
  member .pOrigins            is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      shapeModifier
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shapeModifier()

  -- Initialise Variables

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shapeModifier
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shapeModifier(!profile is PROFILE)

  -- Initialise Variables
  !this.profile       = !profile
  !this.plane         = !profile.plane()
  !this.origin        = !profile.position
  !this.fixedOrigin   = true

  -- Derive possible alternative origins
  !this.alternativeOrigins()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      alternativeOrigins
--
-- Description: Derive alternative origins for the profile, i.e. corners
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of alternative origins
--
------------------------------------------------------------------------

define method .alternativeOrigins() is ARRAY

  -- Initialise Variables
  !this.pOrigins.clear()

  -- If profile is circle return only centre
  if(!this.profile.isCircle()) then
    !positionarray    = !this.profile.edges()
    !position = !positionarray[1].position
    !this.pOrigins.append(!position)
    return !this.pOrigins
  endif

  -- Loop through profile edges
  !edges        = !this.profile.edges()
  !edges.append(!edges.first())

  do !i from 1 to !edges.size() - 1
    if(!edges[!i].objectType().eq('LINE').and(!edges[!i + 1].objectType().eq('LINE'))) then
      !position = !edges[!i].endPosition
      !this.pOrigins.append(!position)
    endif
  enddo

  -- Return
  return !this.pOrigins

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset passed boundary by given amount and return new profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to offset
--    2   R      REAL        Offset value
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .offset(!profile is PROFILE, !offset is REAL) is PROFILE
  !this.shapeModifier(!profile)
  return !this.offset(!offset)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset boundary by given amount
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset value
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .offset(!passedOffset is REAL) is PROFILE

  -- Initialise Variables
  !profile  = !this.profile
  !eSize    = !profile.edges().size()

  -- Merge arcs
  do !i
    !profile  = !profile.mergeArcs(350, 1mm)
    !nSize    = !profile.edges().size()
    if(!nSize.lt(!eSize)) then
      !eSize  = !nSize
    else
      break
    endif
  enddo

  !profile  = !profile.mergeLines()
  !edges    = !profile.edges()
  !normal   = !this.plane.direction()
  !sense    = !profile.sense()
  if(!sense) then
    !offset = !passedOffset * -1
  else
    !offset = !passedOffset
  endif

  !newEdges = ARRAY()

  -- Loop through edges
  do !edge values !edges

    -- Offset line
    if(!edge.objectType().eq('LINE')) then
      !direction  = !edge.direction()
      !offsetDir  = !normal.cross(!direction)
      !line       = !edge.offset(!offsetDir, !offset)
      !newEdges.append(!line)

    -- Offset arc
    elseif (!edge.objectType().eq('ARC')) then
      !arc        = !edge
      !sPosition  = !arc.anglePosition(!arc.startAngle)
      !direction  = !arc.startTangent()
      if(!sense) then
        !offsetDir  = !direction.cross(!normal)
      else
        !offsetDir  = !normal.cross(!direction)
      endif

      -- If direction is to origin, then decrease radius
      !sPosition  = !arc.anglePosition(!arc.startAngle)
      !cDir       = !sPosition.direction(!arc.position)
      !angle      = !offsetDir.angle(!cDir)
      -- Modify radius of arc
      if(!angle.int().eq(0)) then
        !radius   = !arc.radius - !passedOffset
      else
        !radius   = !arc.radius + !passedOffset
      endif

      -- Only save arcs with radii greater than 0
      if(!radius.gt(0)) then
        !arc.radius = !radius
        !newEdges.append(!arc)
      endif

    endif
  enddo

  -- Add first edge to end of list
  !previousEdge   = !newEdges.last()
  !newEdges.append(!newEdges.first())
  !maxSize        = !newEdges.size()

  -- Modify edges
  do !i from 1 to !maxSize - 1
    !edge         = !newEdges[!i]
    !previousType = !previousEdge.objectType()
    !nextEdge     = !newEdges[!i + 1]
    !nextType     = !nextEdge.objectType()

    -- Modify Line
    if(!edge.objectType().eq('LINE')) then

      -- Modify start with respect to previous line
      if(!previousType.eq('LINE')) then
        !edge.startPosition   = !edge.intersection(!previousEdge)

      -- Modify start with respect to previous arc
      elseif (!previousType.eq('ARC')) then
        !angle                = !edge.direction().angle(!previousEdge.endTangent())
        -- Line is not tangential to leave of arc
        if(!angle.int().gt(0)) then
          !iPos               = !edge.intersections(!previousEdge)

          -- Determine the appropriate intersection point
          !distances[1]       = !edge.endPosition.distance(!iPos[1])
          !distances[2]       = !edge.endPosition.distance(!iPos[2])
          !sort               = !distances.sortedIndices()
          !iPos.reIndex(!sort)
          !edge.startPosition = !iPos[1]
        endif
      endif

      -- Modify end with respect to next line
      if(!nextType.eq('LINE')) then
        !edge.endPosition     = !edge.intersection(!nextEdge)

      -- Modify end with respect to previous arc
      elseif (!nextType.eq('ARC')) then
        !angle                = !edge.direction().angle(!nextEdge.startTangent())
        -- Line is not tangential to leave of arc
        if(!angle.int().gt(0)) then
          !iPos               = !edge.intersections(!nextEdge)

          -- Determine the appropriate intersection point
          !distances[1]       = !edge.startPosition.distance(!iPos[1])
          !distances[2]       = !edge.startPosition.distance(!iPos[2])
          !sort               = !distances.sortedIndices()
          !iPos.reIndex(!sort)
          !edge.endPosition   = !iPos[1]
        endif
      endif

    -- Modify Arc
    elseif (!edge.objectType().eq('ARC')) then

      -- Modify start with respect to previous line
      if(!previousType.eq('LINE')) then
        !angle                = !edge.startTangent().angle(!previousEdge.direction())

        -- Arc is not tangential to previous line
        if(!angle.int().gt(0)) then
          !iAngle             = !edge.intersections(!previousEdge)
          !edge.startAngle    = !iAngle[1]
        endif

      -- Modify start with respect to previous arc
      elseif (!previousType.eq('ARC')) then
        !angle                = !edge.startTangent().angle(!previousEdge.endTangent())

        -- Arcs are not fillets
        if(!angle.int().gt(0)) then
          !iAngle             = !edge.intersections(!previousEdge)
          if(!sense) then
            !edge.startAngle  = !iAngle[1]
          else
            !edge.startAngle  = !iAngle[2]
          endif
        endif

      endif

      -- Modify end with respect to next line
      if(!nextType.eq('LINE')) then
        !angle                = !edge.endTangent().angle(!nextEdge.direction())

        -- Arc is not tangential to previous line
        if(!angle.int().gt(0)) then
          !iAngle             = !edge.intersections(!nextEdge)
          !edge.endAngle      = !iAngle[2]
        endif

      -- Modify end with respect to next arc
      elseif (!nextType.eq('ARC')) then
        !angle                = !edge.endTangent().angle(!nextEdge.startTangent())

        -- Arcs are not fillets
        if(!angle.int().gt(0)) then
          !iAngle             = !edge.intersections(!nextEdge)
          if(!sense) then
            !edge.endAngle    = !iAngle[2]
          else
            !edge.endAngle    = !iAngle[1]
          endif
        endif

      endif

    endif
    !newEdges[!i] = !edge

    -- Remove definition and define current as previous
    !edge.delete()
    !nextEdge.delete()
    !previousEdge.delete()
    !previousEdge = !newEdges[!i]
  enddo

  !newEdges.remove(!maxSize)
  !newProfile     = object PROFILE(!profile.position, !profile.orientation, !newEdges)
  !newProfile.close()

  !this.profile   = !newProfile

  -- Return
  return !newProfile

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      project
--
-- Description: Project the profile onto the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .project(!profile is PROFILE) is PROFILE
  !this.project(!profile, !this.plane)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      project
--
-- Description: Project the current profile onto the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .project(!plane is PLANE) is PROFILE
  !this.project(!this.profile, !plane)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      project
--
-- Description: Project passed profile onto passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to map
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .project(!passedProfile is PROFILE, !passedPlane is PLANE) is PROFILE

  -- Initialise Variables
  !this.plane     = !passedPlane
  !this.origin    = !passedPlane.position
  !plane          = !passedPlane
  !position       = !plane.position
  !profile        = !passedProfile
  !profilePlane   = !profile.plane()

  -- Plane direction
  !pDir           = !plane.direction()
  !prfDir         = !profilePlane.direction()

  -- If profile and plane direction are parallel, then map profile onto plane
  if(!pDir.isParallel(!prfDir)) then
    !edges    = !profile.edges()
    !profile  = object PROFILE(!position, !plane.orientation, !edges)

  -- Convert profile into a polyline
  else
    !polyline = !profile.polyline(0.5)
    !edges    = !polyline.edges()
    !profile  = object PROFILE(!position, !plane.orientation, !edges)

  endif

  -- Update and return profile
  !this.profile = !profile
  return !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      intersect
--
-- Description: Intersect the profile onto the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .intersect(!profile is PROFILE) is PROFILE
  !this.intersect(!profile, !this.plane)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      intersect
--
-- Description: Intersect the current profile onto the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .intersect(!plane is PLANE) is PROFILE
  !this.intersect(!this.profile, !plane)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      intersect
--
-- Description: Intersect passed profile onto the passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to map
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .intersect(!passedProfile is PROFILE, !passedPlane is PLANE) is PROFILE

  -- Initialise Variables
  !this.plane     = !passedPlane
  !this.origin    = !passedPlane.position
  !plane          = !passedPlane
  !position       = !plane.position
  !profile        = !passedProfile
  !profilePlane   = !profile.plane()

  -- Plane direction
  !pDir           = !plane.direction()
  !prfDir         = !profilePlane.direction()

  -- If profile and plane direction are parallel, then map profile onto plane
  if(!pDir.isParallel(!prfDir)) then
    !edges        = !profile.edges()
    !profile      = object PROFILE(!position, !plane.orientation, !edges)

  -- Convert profile into a polyline
  else
    !polyline     = !profile.polyline(0.5)
    !edges        = !polyline.edges()
    !direction    = !profilePlane.direction()
    do !j indices !edges
      !lines[!j]  = object LINE(!plane.intersection(object POINTVECTOR(!edges[!j].startPosition, !direction)), !plane.intersection(object POINTVECTOR(!edges[!j].endPosition, !direction)))
    enddo
    !profile      = object PROFILE(!position, !plane.orientation, !lines)

  endif

  -- Update and return profile
  !this.profile   = !profile
  return !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--    PROFILE     Modified profile
--
------------------------------------------------------------------------

define method .mirror(!xaxis is BOOLEAN, !yaxis is BOOLEAN) is PROFILE

  !profile = !this.profile

    -- Mirror about the XY axis
  if(!xAxis) then
    !pv   = object POINTVECTOR(!profile.position, !profile.orientation.yDir())
    !line = !pv.line(1000mm)
    !profile.mirror(!line)
  endif

  if(!yAxis) then
    !pv   = object POINTVECTOR(!profile.position, !profile.orientation.xDir())
    !line = !pv.line(1000mm)
    !profile.mirror(!line)
  endif

  !this.profile   = !profile
  return !profile

endmethod
-- End of method
