---
-- Description:
--    Object for generating and holding rectangle definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  polygon(REAL,REAL,STRING)        PROFILE             Default polygon, with origin at the centre.
--

define object SHAPEPOLYGON

  -- Description
  member .description         is STRING

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  member .originposition      is POSITION

  member .derived             is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      polygon
--
-- Description: Default polygon, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Number of sides
--    2   R      REAL       Distance across
--    3   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .polygon(!numsides is REAL, !distance is REAL, !dimtype is STRING) is PROFILE

  -- Initialise Variables
  --!this.description = 'Rectangular X: ' & !x.string(!!distanceFmt) & ' Y: ' & !y.string(!!distanceFmt)
  !this.description = !numsides.string() & ' Sided Polygon'

  !this.derived = FALSE

    -- Angles
  !increment = 360 / !numsides

  --if(!this.dimensionType.active) then
  !angle   = !increment / 2
  --else
  --  !angle   = 90
  --endif

  -- Define arc
  if(!dimtype eq 'corners') then
    !radius  = !distance / 2

  elseif (!dimtype eq 'faces') then
    !radius  = !distance / cos(!angle) / 2
  else
    !radius  = !distance / sine(!angle) / 2
  endif

  -- Arc
  !arc          = object ARC(!this.plane.position, !this.plane.orientation, 0, 360, !radius, true)

  -- Define positions
  do !i from 1 to !numsides
    !positions[!i] = !arc.anglePosition(!angle)
    !angle         = !angle + !increment
    !directionoffset[!i] = !this.profile.position.direction(!positions[!i])

    !distanceoffset[!i] = !this.profile.position.distance(!positions[!i])

  enddo

  -- Define profile
  !position         = !this.profile.position
  !orientation      = !this.profile.orientation

  --if(!origin.neq(0)) then
  --  !counter = 1

  --  do !i values !positions

  --    !new = !i.offset(!directionoffset[!origin],!distanceoffset[!origin])
  --    !test[!counter] = !new
  --    !counter = !counter + 1
  --  enddo

  --  !this.profile = object PROFILE(!this.plane.position, !this.plane.orientation, !test)

  --else
    !this.profile = object PROFILE(!this.plane.position, !this.plane.orientation, !positions)
  --endif

  !this.originposition = !this.plane.position

  !this.profile.close()

  -- Return profile
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
