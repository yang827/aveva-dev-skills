---
-- Description:
--    Object for generating and holding rectangle definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  rectangle(POSITION,POSITION)     PROFILE             Default rectangle shape, from corner points (positions)
--  rectangle(REAL,REAL)             PROFILE             Default rectangle shape, with origin at the centre.
--

define object SHAPERECTANGLE

  -- Description
  member .description         is STRING

  -- Basic shape definition
  member .profile             is PROFILE

  -- Reference plane
  member .plane               is PLANE

  member .derived             is BOOLEAN

  --store xlen and ylen of derived rectangle to pass back to form
  member .xlen            is REAL
  member .ylen            is REAL

  --member .distanceoffset      is REAL
  --member .directionoffset     is DIRECTION

  member .xyoffset is XYPOSITION

  member .originposition      is POSITION

  member .originalorigin      is POSITION

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Default rectangle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       X dimension
--    2   R      REAL       Y dimension
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

--define method .rectangle(!x is REAL, !y is REAL) is PROFILE
--  return !this.rectangle(!x, !y, 0)
--endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Default rectangle shape, with origin at the centre.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       X dimension
--    2   R      REAL       Y dimension
--    3   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .rectangle(!x is REAL, !y is REAL) is PROFILE

  -- Initialise Variables
  !this.description = 'Rectangular X: ' & !x.string(!!distanceFmt) & ' Y: ' & !y.string(!!distanceFmt)

  --  Definition of points
  !points           = ARRAY()
  !points.append(object XYPOSITION(!x * -0.5, !y * -0.5))
  !points.append(object XYPOSITION(!x * 0.5, !y * -0.5))
  !points.append(object XYPOSITION(!x * 0.5, !y * 0.5))
  !points.append(object XYPOSITION(!x * -0.5, !y * 0.5))

  -- Derive the position with respect to the plane
  !positions        = ARRAY()
  do !i indices !points
    !positions.append(!this.plane.threeDPosition(!points[!i]))
  enddo

  -- Define Profile
  --!position         = !this.profile.position

    --could/should use translate of profile?
    --!positions[1] = !positions[1].offset(!this.directionoffset,!this.distanceoffset)
    --!positions[2] = !positions[2].offset(!this.directionoffset,!this.distanceoffset)
    --!positions[3] = !positions[3].offset(!this.directionoffset,!this.distanceoffset)
    --!positions[4] = !positions[4].offset(!this.directionoffset,!this.distanceoffset)

    --AID CLEAR ALL 22
    --!counter = 1
    --do !i values !positions
    --  AID TEXT NUMBER 22 '$!counter' AT $!i
    --  !counter = !counter + 1
    --enddo

    --if !origin.neq(0) then
    --  !position = !positions[!origin]
    --else
      !position = !this.originalorigin
    --endif
  --endif

  !this.originposition = !position

  !orientation      = !this.profile.orientation
  !this.profile     = object PROFILE(!position, !orientation, !positions)
  !this.profile.close()

  --if derived rectangle, then offset positions to position of derived shape

  if !this.derived then
    !this.profile.translate(!this.xyoffset.x,!this.xyoffset.y)
  endif

  --if !this.derived.eq(FALSE) then
    -- If origin is other than zero, offset through point
  --  if(!origin.neq(0)) then
      -- Invert the XY positions to get the correct offset.
  --    !this.profile.translate(!points[!origin].x * -1, !points[!origin].y * -1)
  --  endif
  --endif

  -- Return profile
  return !this.profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Default rectangle shape, from corner points (positions)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION   Corner pos 1
--    2   R      POSITION   Corner pos 2 (opposite)
--    3   R      REAL       Corner shape is defined about
-- Return:
--   [Data Type] [Description]
--    PROFILE     Shape returned via the profile
--
------------------------------------------------------------------------

define method .rectangle(!pos1 is POSITION, !pos2 is POSITION) is PROFILE

  -- Initialise Variables
  !this.description = 'Rectangular derived from corners'
  !this.derived = TRUE

  !position         = !this.profile.position
  !orientation      = !this.profile.orientation

  --Define four corner-points

  !point1 = !this.plane.near(!pos1)

  !point3 = !this.plane.near(!pos2)

  !pv1 = object POINTVECTOR(!point1,!orientation.xdir())

  !pv2 = object POINTVECTOR(!point3,!orientation.ydir())

  !point2 = !pv1.intersection(!pv2)

  !pv3 = object POINTVECTOR(!point1,!orientation.ydir())

  !pv4 = object POINTVECTOR(!point3,!orientation.xdir())

  !point4 = !pv3.intersection(!pv4)

  --calculate xlen and ylen of rectangle to put back into form

  !this.xlen = !point1.distance(!point2)
  !this.ylen = !point2.distance(!point3)

  --calculate centre point position (to offset rectangles re-sized using
  --x length/y length text gadgets on form)

  !centPos = !point1.midPoint(!point3)
  !this.xyoffset = !this.plane.xyoffset(!centPos)

  !points           = ARRAY()

  !points.append(!point1)
  !points.append(!point2)
  !points.append(!point3)
  !points.append(!point4)

  !this.originposition = !position

  !this.profile     = object PROFILE(!position, !orientation, !points)
  !this.profile.close()

  -- Return profile
  return !this.profile

endmethod
-- End of method
