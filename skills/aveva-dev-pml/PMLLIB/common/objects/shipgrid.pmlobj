--
-- Description:     Ship Grid object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbWrite(DBREF)                   BOOLEAN             Writes current ship grid to passed grid GRIDSY
--  position(REAL,REAL,REAL)         POSITION            Returns position from given reference lines
--  position(REAL,REAL,REAL,REAL,REAL,REAL) POSITION            Returns position from given reference lines with offsets
--  shipGrid()                       -                   Constructor
--  shipGrid(DBREF)                  -                   Constructor
--  shipGridPosition(POSITION)       SHIPGRIDPOSITION    Return ship grid positions form passed position
--  volume()                         VOLUME              Return volume of ship grid
--  xRange()                         ARRAY               Return maximum and minimum values for X
--  yRange()                         ARRAY               Return maximum and minimum values for Y
--  zRange()                         ARRAY               Return maximum and minimum values for Z
--
------------------------------------------------------------------------

define object SHIPGRID

  -- Position
  member .position          is POSITION

  -- Orientation
  member .orientation       is ORIENTATION

  -- Main Grid Element
  member .gridElement       is DBREF

  -- Frame of reference positions are derived from (N0 from Grid Element)
  member .refPosition       is POSITION

  -- Reference Grid
  member .refGrid           is REFGRID

  -- Prefixes
  member .xPrefix           is STRING
  member .yPrefix           is STRING
  member .zPrefix           is STRING

  -- Axes Tags
  member .xTag              is STRING
  member .yTag              is STRING
  member .zTag              is STRING

  -- XYZ Ref Identifiers
  member .xID               is ARRAY
  member .yID               is ARRAY
  member .zID               is ARRAY

  -- XYZ Offsets
  member .xOffset           is ARRAY
  member .yOffset           is ARRAY
  member .zOffset           is ARRAY


endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      shipGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shipGrid()

  -- Default labels for axes
  !this.xTag  = 'FR'
  !this.yTag  = 'LH'
  !this.zTag  = 'LV'

  -- Load Reference Grid
  !unusedXx = !this.refGrid.gridSy
  handle ANY

  elsehandle NONE
    !this.shipGrid(!this.refGrid.gridSy)
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shipGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element holding ship grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shipGrid(!grid is DBREF)

  -- Initialise Variables
  -- Default labels for axes
  !this.xTag        = 'FR'
  !this.yTag        = 'LH'
  !this.zTag        = 'LV'

  -- Check passed element is a GRIDSYSTEM
  if(!grid.fulltype.neq('GRIDSYSTEM')) then
    !!error.text = 'Element ' & !grid.flnn & ' is not a GRIDSYSTEM element.'
    return
  endif

  -- Grid Element
  !this.gridElement = !grid
  !this.position    = !grid.position
  !this.orientation = !grid.orientation

  -- Frame of reference for deriving positions
  !this.refPosition         = N0
  !this.refPosition.origin  = !this.gridElement

  -- Load X grid lines

  -- Define Collection
  !collection   = object COLLECTION()
  !collection.scope(!this.gridElement)
  !collection.addType('GRIDLN')

  -- Define table columns
  !exprRef      = object EXPRESSION()
  !exprRef.expression('grdoff')
  !columns[1]   = object COLUMN(!exprRef, true, true, 'GrdOff')
  !exprRef      = object EXPRESSION()
  !exprRef.expression('real(grdid)')
  !columns[2]   = object COLUMN(!exprRef, false, false, 'GrdId')

  ----------------- Define table for X columns -----------------
  -- Expression to find X grid lines
  !expression   = object EXPRESSION()
  !expression.expression('grdaxe of owner eq ''X''')
  !collection.filter(!expression)

  -- Define table
  !table        = object TABLE()
  !table.columns(!columns)
  !table.primaryKey(!collection)
  !table.evaluate()

  -- Define X Information
  !this.xID     = !table.column('GrdId')
  !this.xOffset = !table.column('GrdOff')
  !xOwner       = !table.primaryKey()[1].owner
  handle ANY
    !!alert.warning('No Frame (X) grids')
    !this.xPrefix = 'X'
    !this.xID     = object ARRAY()
    !this.xID[1]  = 0
    !this.xOffset = object ARRAY()
    !this.xOffset[1] = 0mm
  elsehandle NONE
    !this.xPrefix = !xOwner.grdLbl
  endhandle

  -- Set X tag
  if(defined(!xOwner) and !xOwner.description.set() and !xOwner.description.trim().empty().not()) then
    !this.xTag  = !xOwner.description
  endif

  ----------------- Define table for Y columns -----------------
  -- Expression to find Y grid lines
  !expression.expression('grdaxe of owner eq ''Y''')
  !collection.clearFilter()
  !collection.filter(!expression)

  -- Define table
  !table        = object TABLE()
  !table.columns(!columns)
  !table.primaryKey(!collection)
  !table.evaluate()

  -- Define Y Information
  !this.yID     = !table.column('GrdId')
  !this.yOffset = !table.column('GrdOff')
  !yOwner       = !table.primaryKey()[1].owner
  handle ANY
    !!alert.warning('No longitudinal (Y) grids')
    !this.yPrefix = 'Y'
    !this.yID     = object ARRAY()
    !this.yID[1]  = 0
    !this.yOffset = object ARRAY()
    !this.yOffset[1] = 0mm
  elsehandle NONE
    !this.yPrefix = !yOwner.grdLbl
  endhandle

  -- Set Y tag
  if(defined(!yOwner) and !yOwner.description.set() and !yOwner.description.trim().empty().not()) then
    !this.yTag  = !yOwner.description
  endif

  ----------------- Define table for Z columns -----------------
  -- Expression to find Z grid lines
  !expression.expression('grdaxe of owner eq ''Z''')
  !collection.clearFilter()
  !collection.filter(!expression)

  -- Define table
  !table        = object TABLE()
  !table.columns(!columns)
  !table.primaryKey(!collection)
  !table.evaluate()

  -- Define Z Information
  !this.zID     = !table.column('GrdId')
  !this.zOffset = !table.column('GrdOff')
  !zOwner       = !table.primaryKey()[1].owner
  handle ANY
    !!alert.warning('No vertical (Z) grids')
    !this.zPrefix = 'Z'
    !this.zID     = object ARRAY()
    !this.zID[1]  = 0
    !this.zOffset = object ARRAY()
    !this.zOffset[1] = 0mm
  elsehandle NONE
    !this.zPrefix = !zOwner.grdLbl
  endhandle

  -- Set Z tag
  if(defined(!zOwner) and !zOwner.description.set() and !zOwner.description.trim().empty().not()) then
    !this.zTag  = !zOwner.description
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbWrite
--
-- Description: Writes current ship grid to passed grid GRIDSY
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Grid System ship grid is to be written to
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if created grid
--
------------------------------------------------------------------------

define method .dbWrite(!grid is DBREF) is BOOLEAN

  -- Initialise Variables
  !reference      = !!ce

  -- Check passed element is the correct type
  if(!grid.fulltype.neq('GRIDSYSTEM')) then
    !!error.text  = 'Element ' & !grid.flnn & ' is not a GRIDSYSTEM element.'
    return false
  endif

  -- Navigate to Grid element
  !!ce            = !grid

  -- Set Purpose to SHIP
  !grid.purpose   = 'SHIP'

  -- Define grid axes, delete previous definitions
  DELETE GRIDSYSTEM MEMBERS

  -- Create X axis
  NEW GRIDAXIS
  !xAxis          = !!ce
  grdaxe 'X'
  !xAxis.grdLbl   = !this.xPrefix

  -- Create Z grid lines
  do !x indices !this.xOffset
    NEW GRIDLN
    !!ce.grdOff   = !this.xOffset[!x]
    !!ce.grdid    = !this.xID[!x].string()
  enddo

  -- Create Y axis
  NEW GRIDAXIS
  !yAxis          = !!ce
  grdaxe 'Y'
  !yAxis.grdLbl   = !this.yPrefix

  -- Create Z grid lines
  do !y indices !this.yOffset
    NEW GRIDLN
    !!ce.grdOff   = !this.yOffset[!y]
    !!ce.grdid    = !this.yID[!y].string()
  enddo

  -- Create Z axis
  NEW GRIDAXIS
  !yAxis          = !!ce
  grdaxe 'Z'
  !yAxis.grdLbl   = !this.zPrefix

  -- Create Z grid lines
  do !z indices !this.zOffset
    NEW GRIDLN
    !!ce.grdOff   = !this.zOffset[!z]
    !!ce.grdid    = !this.zID[!z].string()
  enddo

  -- Return to original reference
  !!ce              = !reference

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Returns position from given reference lines with offsets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X grid line ID
--    2   R      REAL        X offset from grid line
--    3   R      REAL        Y grid line ID
--    4   R      REAL        Y offset from grid line
--    5   R      REAL        Z grid line ID
--    6   R      REAL        Z offset from grid line
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position(!xGridline is REAL, !xOffset is REAL, !yGridline is REAL, !yOffset is REAL, !zGridline is REAL, !zOffset is REAL) is POSITION

  -- Get Position
  !position = !this.position(!xGridline, !yGridline, !zGridline)

  -- Apply offset to X position
  !position.east    = !position.east + !xOffset

  -- Apply offset to Y position
  !position.north   = !position.north + !yOffset

  -- Apply offset to Z position
  !position.up      = !position.up + !zOffset

  -- Return Position
  return !position

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Returns position from given reference lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X grid line ID
--    2   R      REAL        Y grid line ID
--    3   R      REAL        Z grid line ID
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .position(!xGridline is REAL, !yGridline is REAL, !zGridline is REAL) is POSITION

  -- Get position
  !position         = !this.refPosition

  !x                = !this.xID.findFirst(!xGridline)
  if(!x.set()) then
    !position.east  = !this.xOffset[!x]
  else
    !position.east  = 0
  endif

  !y                = !this.yID.findFirst(!yGridline)
  if(!y.set()) then
    !position.north = !this.yOffset[!y]
  else
    !position.north = 0
  endif

  !z                = !this.zID.findFirst(!zGridline)
  if(!z.set()) then
    !position.up    = !this.zOffset[!z]
  else
    !position.up    = 0
  endif

  -- Return Position
  return !position.wrt(World)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shipGridPosition
--
-- Description: Return ship grid positions form passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shipGridPosition(!position is POSITION) is SHIPGRIDPOSITION

  -- Initialise Variable
  !shipPosition = object SHIPGRIDPOSITION(!position, !this.refGrid)

  -- Return
  return !shipPosition

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Return volume of ship grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume() is VOLUME

  -- Define volume
  !volume             = object VOLUME()
  !volume.from        = !this.refPosition
  !volume.from.east   = !this.xOffset.first()
  !volume.from.north  = !this.yOffset.first()
  !volume.from.up     = !this.zOffset.first()
  !volume.to          = !this.refPosition
  !volume.to.east     = !this.xOffset.last()
  !volume.to.north    = !this.yOffset.last()
  !volume.to.up       = !this.zOffset.last()

  -- Return
  return !volume

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xRange
--
-- Description: Return maximum and minimum values for X
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xRange() is ARRAY
  !range[1] = !this.xID.first()
  !range[2] = !this.xID.last()
  return !range
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      yRange
--
-- Description: Return maximum and minimum values for Y
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .yRange() is ARRAY
  !range[1] = !this.yID.first()
  !range[2] = !this.yID.last()
  return !range
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      zRange
--
-- Description: Return maximum and minimum values for Z
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .zRange() is ARRAY
  !range[1] = !this.zID.first()
  !range[2] = !this.zID.last()
  return !range
endmethod
-- End of method
