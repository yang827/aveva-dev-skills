-- File:            shipgridposition.pmlobj
--   Type:          Object Definition
--   Group:         Reference System
--     Keyword:     Ship Grid
--   Module:        All
--
-- Author:          neil.holmes
--  Created:         Thu Apr 28 10:17:24 2005
--
-- Description:     Ship Grid object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  shipGridPosition()               -                   Constructor
--  shipGridPosition(POSITION,REFGRID) -
--  valid()                          BOOLEAN             Return true if position set from supplied grid
--
------------------------------------------------------------------------

define object SHIPGRIDPOSITION

  -- object valid - true if members have been set
  member .valid             is BOOLEAN

  -- Prefixes
  member .xPrefix           is STRING
  member .yPrefix           is STRING
  member .zPrefix           is STRING

  -- Grid lines
  member .xGridline         is REAL
  member .yGridline         is REAL
  member .zGridline         is REAL

  -- XYZ Offsets
  member .xOffset           is REAL
  member .yOffset           is REAL
  member .zOffset           is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      shipGridPosition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shipGridPosition()

  -- Initialise grid line members
  !this.xGridline = 0
  !this.yGridline = 0
  !this.zGridline = 0

  !this.xOffset   = 0mm
  !this.yOffset   = 0mm
  !this.zOffset   = 0mm

  !this.xPrefix   = 'X'
  !this.yPrefix   = 'Y'
  !this.zPrefix   = 'Z'

  -- Set to true only if valid grid position derived
  !this.valid     = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shipGridPosition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
--    2   R      REFGRID     Reference grid to deriver position from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shipGridPosition(!position is POSITION, !grid is REFGRID)

  if( !grid.unset() ) then
    !this.valid = false
    return
  endif
  if( !grid.valid().not() ) then
    !this.valid = false
    return
  endif

  -- Get position with respect to the reference grid
  !refPosition = !position.wrt(!grid.gridSy)
  handle any
    !this.valid = false
    return
  endhandle

  !this.valid   = true

  -- avoid units bug in REFGRID object
  !savedUnits  = object COMUNITS(true)
  UNITS MM DIST
  -- have to build position from string otherwise REFGRID still fails
  !positionMM  = object POSITION(!position.string())
  -- Get Gridlines elements
  !xGridline   = !grid.getNearest('X', !positionMM)
  handle ANY
    !xGridline = 0
  endhandle
  !yGridline   = !grid.getNearest('Y', !positionMM)
  handle ANY
    !yGridline = 0
  endhandle
  !zGridline   = !grid.getNearest('Z', !positionMM)
  handle ANY
    !zGridline = 0
  endhandle
  !savedUnits.restoreSavedUnitsByPtype('DIST')

  -- Derive and set gridlines
  -- If grid ID is not numeric, use unset object to indicate error
  !this.xGridline   = !xGridline.grdId.real()
  handle any
    !this.xGridline = 0
  endhandle
  !this.yGridline   = !yGridline.grdId.real()
  handle any
    !this.yGridline = 0
  endhandle
  !this.zGridline   = !zGridline.grdId.real()
  handle any
    !this.zGridline = 0
  endhandle

  -- Derive and set offsets from the grid line
  !this.xOffset   = !refPosition.east - !xGridline.grdOff
  handle ANY
    !this.xOffset = !refPosition.east - 0mm
  endhandle

  !this.yOffset   = !refPosition.north - !yGridline.grdOff
  handle ANY
    !this.yOffset = !refPosition.north - 0mm
  endhandle

  !this.zOffset   = !refPosition.up - !zGridline.grdOff
  handle ANY
    !this.zOffset = !refPosition.up - 0mm
  endhandle

  -- Derive and set prefixes
  !this.xPrefix   = !xGridline.owner.grdLbl
  handle ANY
    !this.xPrefix = 'X'
  endhandle
  !this.yPrefix   = !yGridline.owner.grdLbl
  handle ANY
    !this.yPrefix = 'Y'
  endhandle
  !this.zPrefix   = !zGridline.owner.grdLbl
  handle ANY
    !this.zPrefix = 'Z'
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      valid
--
-- Description: Return true if position set from supplied grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if position set from supplied grid - false if unset
--
------------------------------------------------------------------------

define method .valid() is BOOLEAN

  return !this.valid

endmethod
-- End of method
