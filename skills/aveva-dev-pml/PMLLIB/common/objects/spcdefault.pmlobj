-- File:            spcdefault.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Sep 2 15:27:23 BST 1998
--
--
-- Description:
-- Default specification for a utility/application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  spcDefault(DBREF)                -                   Constructor
--
------------------------------------------------------------------------

define object SPCDEFAULT

  -- Description
  member .description      is STRING

  -- Key
  member .key              is STRING

  -- Specification pointer
  member .specification    is DBREF

  -- Specification Component
  member .component        is DBREF

  -- Design Parameter Definitions
  member .designParameters is ARRAY

  -- Attribute List
  member .attributesName   is ARRAY
  member .attributesData   is ARRAY

endobject
-- End of object definition for SPCDEFAULT

------------------------------------------------------------------------
--
-- Method:      spcDefault
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcDefault(!element is DBREF)

  -- Check a SPCO has been passed
  if(!element.type ne 'SPCO') then
    return
  endif

  -- Initialise Variables
  !this.specification    = SPEC of $!<element>
  !this.component        = !element
  !this.description      = ''
  !this.key              = ''
  !this.designParameters.clear()
  !this.attributesName.clear()
  !this.attributesData.clear()

endmethod
-- End of method definition for .spcDefault(DBREF)
