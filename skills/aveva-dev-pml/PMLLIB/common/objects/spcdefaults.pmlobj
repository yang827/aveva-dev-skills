-- File:            spcdefaults.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Sep 2 15:27:23 BST 1998
--
--
-- Description:
-- List of all default/active specifications.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(SPCDEFAULT)                  -                   Add a specification default to the system
--  get(STRING)                      SPCDEFAULT          Get a specification default from the list
--  globalInstance()                 -                   Constructor
--  index(STRING)                    REAL                Get a specification default from the list
--  replace(SPCDEFAULT)              -                   Replace the passed specification default to the system
--
------------------------------------------------------------------------

define object SPCDEFAULTS

  -- List of available
  member .defaults is ARRAY

endobject
-- End of object definition for SPCDEFAULTS

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  !!spcDefaults = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add a specification default to the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      SPCDEFAULT  Specification default to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!default is SPCDEFAULT)

  -- Same as replace
  !this.replace(!default)

endmethod
-- End of method definition for .add(SPCDEFAULT)

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: Replace the passed specification default to the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      SPCDEFAULT  Specification default to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace(!default is SPCDEFAULT)

  -- See if item is already in the system
  !index = !this.index(!default.key)

  if(!index eq 0) then
    !this.defaults.append(!default)
  else
    !this.defaults[!index] = !default
  endif

endmethod
-- End of method definition for .replace(SPCDEFAULT)

------------------------------------------------------------------------
--
-- Method:      get
--
-- Description: Get a specification default from the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Default key
-- Return:
--   [Data Type] [Description]
--    SPCDEFAULT  Returned default
--
------------------------------------------------------------------------

define method .get(!key is STRING) is SPCDEFAULT

  -- Get index
  !index = !this.index(!key)

  if(!index eq 0) then
    return object SPCDEFAULT()
  else
    return !this.defaults[!index]
  endif

endmethod
-- End of method definition for .get(STRING) SPCDEFAULT

------------------------------------------------------------------------
--
-- Method:      index
--
-- Description: Get a specification default from the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Default key
-- Return:
--   [Data Type] [Description]
--    REAL        Index pointer into array
--
------------------------------------------------------------------------

define method .index(!key is STRING) is REAL

  -- Initialise Variables
  !searchKey = !key.upcase()

  -- Loop thought index
  do !i indices !this.defaults
    if(!this.defaults[!i].key.upcase() eq !searchKey) then
      return !i
    endif
  enddo
  return 0

endmethod
-- End of method definition for .index(STRING) REAL
