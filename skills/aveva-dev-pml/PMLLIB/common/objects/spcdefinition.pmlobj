--
-- File:            spcdefinition.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
-- Object for defining a question and answer definition, ie.
-- What the question is, what the answer type is, string, real, range, etc.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  spcDefinition(DBREF)             -                   Constructor
--  valid(BOOLEAN)                   BOOLEAN             Check passed boolean against the results
--  valid(REAL)                      BOOLEAN             Check passed value against the results
--  valid(STRING)                    BOOLEAN             Check passed string against the results
--
------------------------------------------------------------------------

define object SPCDEFINITION

  -- Element
  member .selector    is DBREF

  -- Description
  member .description is STRING

  -- Question
  member .question    is STRING

  -- Question Key
  member .key         is STRING

  -- Answer Type
  member .type        is STRING

  -- Real Answer
  member .real        is REAL

  -- String/Text Answer
  member .text        is STRING

  -- Range Answers
  member .minimum     is REAL
  member .maximum     is REAL

endobject
-- End of object definition for SPCDEFINITION

------------------------------------------------------------------------
--
-- Method:      spcDefinition
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item definition is being derived from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcDefinition(!selector is DBREF)

  -- Error if not a SELE or SPCO
  if( not !selector.type inset('SELE','SPCO')) then
    !!messageFile.error(153, 11, !selector.flnn )
    return
  endif

  -- Set data
  !this.selector    = !selector

  -- If at spco, then get relevant info
  if(!selector.type eq 'SPCO') then
    if(!selector.catRef.set()) then
      !this.description = !selector.catRef.flnn
    elseif (!selector.tmpRef.set()) then
      !this.description = !selector.tmpRef.flnn
    else
      !this.description = !selector.flnn
    endif
  else
    !this.description   = !selector.description
  endif

  -- Get question from owner
  !this.question    = !selector.owner.tQuestion
  !this.key         = !selector.owner.question

  -- Determine the answer type
  -- Text Answer
  if(!selector.tAnswer.set() and !selector.tAnswer.trim().empty().not()) then
    !this.type      = 'TEXT'
    !this.text      = !selector.tAnswer

  -- Range Answer
  elseif (!selector.answer ne !selector.maxAnswer) then
    !this.type      = 'RANGE'
    !this.minimum   = !selector.answer
    !this.maximum   = !selector.maxAnswer

  -- Value Answer
  else
    !this.type      = 'VALUE'
    !this.real      = !selector.answer
  endif

endmethod
-- End of method definition for .spcDefinition(DBREF)

------------------------------------------------------------------------
--
-- Method:      valid
--
-- Description:
--   Check is passed real is valid for the definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Test value
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid
--
------------------------------------------------------------------------

define method .valid(!value is REAL) is BOOLEAN

  -- Check VALUE a against real
  if(!this.type eq 'VALUE') then
    return (!this.real eq !value)

  -- Check within a range
  elseif (!this.type eq 'RANGE') then
    return (!value.between(!this.minimum, !this.maximum))
  endif

  return false

endmethod
-- End of method definition for .valid(REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      valid
--
-- Description:
--   Check is passed string is valid for the definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Test value
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid
--
------------------------------------------------------------------------

define method .valid(!text is STRING) is BOOLEAN

  -- Check TTEXT a against TEXT
  if(!this.type eq 'TEXT') then
    return (!this.text eq !text)
  endif
  return false

endmethod
-- End of method definition for .valid(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      valid
--
-- Description:
--   Check is passed boolean is valid for the definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Test value
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid
--
------------------------------------------------------------------------

define method .valid(!flag is BOOLEAN) is BOOLEAN

  -- Check TTEXT a against TEXT
  if(!this.type eq 'TEXT') then
    return (!this.text.upcase() eq !flag.string().upcase())
  endif
  return false

endmethod
-- End of method definition for .valid(BOOLEAN) BOOLEAN
