--   Group:         Specification handling utilities

--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Dec 11 8:55:00 "GMT 1998
--
--
-- Description:
-- Spec Answer header definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  spcHeader(DBREF)                 -                   Constructor, setup table with passed selector
--

define object SPCHEADER

  -- Description (TQuestion)
  member .description   is STRING

  -- Identifier key (Question)
  member .key           is STRING

  -- Type of answers (BORE, REAL, DISTANCE, BOOLEAN or TEXT)
  member .type          is STRING

  -- Default (single element array, as arrays can hold any data type)
  member .default       is ARRAY

endobject
-- End of object definition for SPCHEADER


------------------------------------------------------------------------
--
-- Method:      spcHeader
--
-- Description: Constructor, setup table with passed selector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selector to define the table
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spcHeader(!element is DBREF)

  -- Initialise Variables
  !this.description = !element.owner.description
  !this.key         = !element.owner.question

  -- Determine the header type from the answer of the passed item

  -- Text or boolean
  if(!element.tAnswer.set() and !element.tAnswer.trim().empty().not()) then

    -- Test boolean
    if(!element.tAnswer.upcase() inset('TRUE','FALSE')) then
      !this.type = 'BOOLEAN'
      if(!element.owner.tDefault.set()) then
        !this.default[1] = !element.owner.tDefault.boolean()
      endif
    else
      !this.type = 'TEXT'
      if(!element.owner.tDefault.set()) then
        !this.default[1] = !element.owner.tDefault
      endif
    endif

  -- Real, Bore or Distance
  else
    !temp      = !element.answer
    !this.type = !temp.objectType()
    if(!element.owner.default.set()) then
      !this.default[1] = !element.owner.default
    endif

  endif


endmethod
-- End of method definition for .spcHeader(DBREF)
