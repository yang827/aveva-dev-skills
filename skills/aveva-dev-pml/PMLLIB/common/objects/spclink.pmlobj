--
-- File:            spclink.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
--   Specification linking object, contains gadget linkage for handling
--   the selection and choice of specification elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Action the auto selection choice
--  actionAutoSelect()               -                   Action the auto selection choice
--  autoSelect(GADGET)               -                   Returns current autoSelect link gadget
--  choice()                         ARRAY               Returns current selector choice from the specdata member
--  default(GADGET)                  -                   Returns current default link gadget
--  linkMember(FORM)                 STRING              Returns the link member of the passed form
--  permissible(GADGET)              -                   Returns current permissible link gadget
--  preference(STRING,ANY)           -                   Define a preference
--  preferenceClear()                -                   Clears the current preferences
--  question(GADGET)                 -                   Returns current question link gadget
--  selPermissible()                 -                   Selected permissible
--  selSelection()                   -                   Selected selection
--  selSpecification()               -                   Selected specification
--  selection()                      DBREF               Returns current selection
--  selection(GADGET)                -                   Returns current selection link gadget
--  setAction(STRING)                -                   Set action on selection
--  setAutoSelect()                  -                   Set Auto Select for current selection
--  setDefault()                     -                   Set default for current selection
--  setPermissible()                 -                   Setup permissible gadget with passed selector
--  setSelection()                   -                   Setup selection gadget with passed selector
--  setSpecification()               -                   Setup specification gadget with passed specification
--  setup()                          -                   Setup to current .specData member
--  setup(DBREF)                     -                   Setup to passed design database element
--  setup(SPCSPECIFICATION)          -                   Setup to passed spcSpecification
--  sort(GADGET)                     -                   Returns current specification sort link gadget
--  sortSpecification()              -                   Sort Specification
--  specification(GADGET)            -                   Returns current specification link gadget
--  specification(GADGET,SPCSEARCH)  -                   Returns current specification link gadget
--  valid()                          BOOLEAN             Check to see if the selector conforms to all the qualifiers, etc
--
------------------------------------------------------------------------

define object SPCLINK

  -- Gadget displaying the specification (can be List/Option/Text/Paragraph
  member .specification    is GADGET

  -- Gadget displaying sort type for specification
  member .sort             is GADGET

  -- Gadget displaying current selection (must be a list gadget)
  member .selection        is GADGET

  -- Gadget displaying permissible selection (must be a list gadget)
  member .permissible      is GADGET

  -- Gadget displaying Question of permissibles
  member .question         is GADGET

  -- Use default
  member .default          is GADGET

  -- Auto select
  member .autoSelect       is GADGET

  -- Specification Data
  member .specData         is SPCSPECIFICATION

  -- Specification search criteria
  member .specSearch       is SPCSEARCH

  -- Action on selection
  member .action           is STRING

endobject
-- End of object definition for SPCLINK

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup to current .specData member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()
  !this.setup(!this.specData)
endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup to passed spcSpecification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!specData is SPCSPECIFICATION)

  -- Initialise Variables
  !specification = !specData.specification
  !newSpecData   = !specData

  -- Unset specification, use selected element out of the specification list
  if(!specification.unset()) then

    if (!this.specification.selection().upcase() eq 'RELOAD' or !this.specification.selection().trim() eq '') then
        !this.selSpecification()
      return
    else
      !specification = !this.specification.selection().dbRef()
      handle any
        !this.specification.select('RTEXT', 'RELOAD')
        !this.selSpecification()
        return
      elsehandle none
        !newSpecData   = object SPCSPECIFICATION(!specification)
      endhandle
    endif
  endif

  -- Check specification has been passed
  if(!specification.type ne 'SPEC') then
    !!messageFile.error(153,7, !specification.flnn)
    return
  endif

  -- Assign passed
  !this.specData = !newSpecData

  -- Spec gadget is a LIST
  if(!this.specification.type() eq 'LIST') then

    -- See if spec exist in the list (assuming RTEXT is always references
    !specIndex = !this.specification.rText.findFirst(!specification.refNo.string())

    -- If not in list, the put it in
    if(!specIndex.unset()) then

      !dText = !this.specification.dText
      !rText = !this.specification.rText

      -- Rebuild lists
      if(!specification.description.unset() or !specification.description.trim().empty()) then
        !description = !specification.flnn
      else
        !description = !specification.description
      endif
      !dText.append(!description)
      !rText.append(!specification.refNo.string())

      -- Redefine spec
      !this.specification.dText = !dText
      !this.specification.rText = !rText

    -- Select specification in the list
    else
      !this.specification.val = !specIndex
    endif

  -- Gadget must be TEXT or PARAGRAPH
  else
    if(!this.specification.dataType eq 'STRING') then
      !this.specification.val = !specification.name
    elseif (!this.specification.dataType eq 'DBREF') then
      !this.specification.val = !specification
    endif
  endif

  -- Build Selection list
  !this.specData.choose()
  !this.setSelection()
  !this.setPermissible()
  !this.setSpecification()

endmethod
-- End of method definition for .setup(SPCSPECIFICATION)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup to passed design database element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element to setup with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!element is DBREF)

  -- Define SPCSPECIFICATION object
  !this.specData.defineWith(!element)

  !this.setup(!this.specData)

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      selSpecification
--
-- Description: Selected specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selSpecification()

  -- Get selected specification
  !selection = !this.specification.selection()

  -- If reload, then reload gadget with current search
  if(!selection eq 'RELOAD') then
    !this.specSearch.search()

    -- Populate gadget
    !dText = !this.specSearch.display()
    !rText = !this.specSearch.replacement()

    if (!this.sort.set()) then
      if (!this.sort.selection('RTEXT') eq 'NAME') then
    	  !nameSort = !dText.sortedIndices()  	
  	    !dText.reIndex(!nameSort)
  	    !rText.reIndex(!nameSort)
  	  endif
  	endif

    -- Append to the bottom the "reload" method
    !dText.append('Reload')
    !rText.append('RELOAD')

    !this.specification.dText = !dText
    !this.specification.rText = !rText

    !this.specification.val = 1
    !selection = !this.specification.selection()

    -- Check for reload again
    if(!selection eq 'RELOAD') then
      if (defined(!this.selection)) then
        !this.selection.clear()
      endif
      if (defined(!this.permissible)) then
        !this.permissible.clear()
      endif
      if (defined(!this.permissible)) then
        !this.question.val = ''
      endif
      !!messageFile.warning(153, 2, !this.specSearch.type )
      return
    endif
  endif

  -- Set specification to current selection
  !this.specData.selector(!selection.dbRef())

  -- Build lists
  !this.specData.choose()
  !this.selection.clear()

  !this.selSelection()

endmethod
-- End of method definition for .selSpecification()

------------------------------------------------------------------------
--
-- Method:      sortSpecification()
--
-- Description: Sort Specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sortSpecification()

  if (!this.sort.selection('RTEXT') eq 'NAME') then
  	
  	!dbrefs = !this.specification.rText
  	!names  = !this.specification.dText
  	!dbrefs.removeLast()
  	!names.removeLast()
  	  	
  	!nameSort = !names.sortedIndices()  	
  	!names.reIndex(!nameSort)
  	!dbrefs.reIndex(!nameSort)
  	
  	!names.append('Reload')
  	!dbrefs.append('RELOAD')

    !this.specification.dText = !names
    !this.specification.rText = !dbrefs

    !this.specification.val = 1
    !selection = !this.specification.selection()
    !this.specData.selector(!selection.dbRef())

  else
  	!this.specSearch.search()
  	
  	-- Populate gadget
    !dText = !this.specSearch.display()
    !rText = !this.specSearch.replacement()

    -- Append to the bottom the "reload" method
    !dText.append('Reload')
    !rText.append('RELOAD')

    !this.specification.dText = !dText
    !this.specification.rText = !rText
    !selection = !this.specification.selection()
    !this.specData.selector(!selection.dbRef())

  endif

  -- Build lists
  !this.specData.choose()
  !this.selection.clear()

  !this.selSelection()

endmethod
------------------------------------------------------------------------
--
-- Method:      selSelection
--
-- Description: Selected selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selSelection()

  -- Initialise Variables
  !selected = !this.selection.selection()

  !this.specData.selector(!selected.dbRef())
  !this.specData.choose()
  !this.setSelection()
  !this.setPermissible()
  !this.setSpecification()

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .selSelection()

------------------------------------------------------------------------
--
-- Method:      selPermissible
--
-- Description: Selected permissible
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selPermissible()

  -- Initialise Variables
  !selected = !this.permissible.selection()
  !this.specData.selector(!selected.dbRef())
  !this.specData.choose()
  !this.setSelection()
  !this.setPermissible()
  !this.setSpecification()

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .selPermissible()

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Setup specification gadget with passed specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selection to set up with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpecification()

  -- Update gadget
  !this.specData.specGadget(!this.specification)

endmethod
-- End of method definition for .setSpecification()
------------------------------------------------------------------------
--
-- Method:      setSelection
--
-- Description: Setup selection gadget with passed selector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selection to set up with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSelection()

  -- Update gadget
  !this.specData.selectionGadget(!this.selection)

endmethod
-- End of method definition for .setSelection()

------------------------------------------------------------------------
--
-- Method:      setPermissible
--
-- Description: Setup permissible gadget with passed selector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selection to set up with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPermissible()

  !this.specData.choiceGadget(!this.permissible)
  !this.question.val = !this.specData.question()

endmethod
-- End of method definition for .setPermissible()

------------------------------------------------------------------------
--
-- Method:      setDefault
--
-- Description: Set default for current selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDefault()

  -- Set data
  !this.specData.useDefault = !this.default.val

endmethod
-- End of method definition for .setDefault()

------------------------------------------------------------------------
--
-- Method:      setAutoSelect
--
-- Description: Set Auto Select for current selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAutoSelect()

  -- Set data
  !this.specData.autoSelect = !this.autoSelect.val

endmethod
-- End of method definition for .setAutoSelect()

------------------------------------------------------------------------
--
-- Method:      setAction
--
-- Description: Set action on selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAction(!action is STRING)

  -- Set data
  !this.action = !action

endmethod
-- End of method definition for .setAction(STRING)

------------------------------------------------------------------------
--
-- Method:      actionAutoSelect
--
-- Description: Action the auto selection choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .actionAutoSelect()

  -- Set data
  !this.specData.autoSelect = true
  !this.specData.choose()
  !this.specData.autoSelect = false

  !this.setup()

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .actionAutoSelect()

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description: Action the auto selection choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Check for unset/null
  if(!this.action.unset() or !this.action.empty()) then
    return
  endif

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      specification
--
-- Description: Returns current specification link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Specification gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specification(!gadget is GADGET)

  -- Check gadget type
  !gadgetType = !gadget.type()

  -- If type is not a list, text or paragraph then error
  if(not !gadgetType inset('LIST','TEXT','PARAGRAPH')) then
    !!alert.error('Specification gadget must be either a "LIST","TEXT" or "PARAGRAPH".')
    return
  endif

  -- Assign the callback to the gadget
  !gadget.callback = !this.linkMember(!gadget.owner()) & '.selSpecification()'

  -- Assign gadget to member
  !this.specification = !gadget

endmethod
-- End of method definition for .specification(GADGET)

------------------------------------------------------------------------
--
-- Method:      sort(!gadget is GADGET)
--
-- Description: Returns current specification sort link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Specification gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sort(!gadget is GADGET)

  -- Assign the callback to the gadget
  !gadget.callback = !this.linkMember(!gadget.owner()) & '.sortSpecification()'

  -- Assign gadget to member
  !this.sort = !gadget

endmethod
------------------------------------------------------------------------
--
-- Method:      specification
--
-- Description: Returns current specification link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Specification gadget
--    2    R     SPCSEARCH   Specification search data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specification(!gadget is GADGET, !search is SPCSEARCH)

  -- Set gadget link
  !this.specification(!gadget)

  -- Assign search data
  !this.specSearch = !search

  -- Populate gadgets
  !dText = !this.specSearch.display()
  !rText = !this.specSearch.replacement()

  -- Append to the bottom the "reload" method
  !dText.append('Reload')
  !rText.append('RELOAD')

  !this.specification.dText = !dText
  !this.specification.rText = !rText

  -- set the gadget to the current
  !this.setSpecification()

endmethod
-- End of method definition for .specification(GADGET, SPCSEARCH)

------------------------------------------------------------------------
--
-- Method:      selection
--
-- Description: Returns current selection link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Selection gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selection(!gadget is GADGET)

  -- Check gadget type
  !gadgetType = !gadget.type()

  -- If type is not a list, text or paragraph then error
  if(not !gadgetType inset('LIST')) then
    !!alert.error('Selection gadget must be a "LIST".')
    return
  endif

  -- Assign the callback to the gadget
  !gadget.callback = !this.linkMember(!gadget.owner()) & '.selSelection()'

  -- Assign gadget to member
  !this.selection = !gadget

endmethod
-- End of method definition for .selection(GADGET)

------------------------------------------------------------------------
--
-- Method:      permissible
--
-- Description: Returns current permissible link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Permissible gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .permissible(!gadget is GADGET)

  -- Check gadget type
  !gadgetType = !gadget.type()

  -- If type is not a list, text or paragraph then error
  if(not !gadgetType inset('LIST')) then
    !!alert.error('Permissible gadget must be a "LIST".')
    return
  endif

  -- Assign the callback to the gadget
  !gadget.callback = !this.linkMember(!gadget.owner()) & '.selPermissible()'

  -- Assign gadget to member
  !this.permissible = !gadget

endmethod
-- End of method definition for .permissible(GADGET)

------------------------------------------------------------------------
--
-- Method:      question
--
-- Description: Returns current question link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Question gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .question(!gadget is GADGET)

  -- Check gadget type
  !gadgetType = !gadget.type()

  -- If type is not a list, text or paragraph then error
  if(not !gadgetType inset('PARAGRAPH')) then
    !!alert.error('Permissible gadget must be a "PARAGRAPH".')
    return
  endif

  -- Assign gadget to member
  !this.question = !gadget

endmethod
-- End of method definition for .question(GADGET)

------------------------------------------------------------------------
--
-- Method:      default
--
-- Description: Returns current default link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Default gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .default(!gadget is GADGET)

  -- Check gadget type
  !gadgetType = !gadget.type()

  -- If type is not a list, text or paragraph then error
  if(not !gadgetType inset('TOGGLE')) then
    !!alert.error('Default gadget must be a "TOGGLE".')
    return
  endif

  -- Assign the callback to the gadget
  !gadget.callback = !this.linkMember(!gadget.owner()) & '.setDefault()'

  -- Handle unset default
  if(!this.specData.useDefault.unset()) then
    !this.specData.useDefault = false
  endif
  !gadget.val      = !this.specData.useDefault

  -- Assign gadget to member
  !this.default = !gadget

endmethod
-- End of method definition for .default(GADGET)

------------------------------------------------------------------------
--
-- Method:      autoSelect
--
-- Description: Returns current autoSelect link gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      AutoSelect gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoSelect(!gadget is GADGET)

  -- Check gadget type
  !gadgetType = !gadget.type()

  -- If type is not a list, text or paragraph then error
  if(not !gadgetType inset('TOGGLE','BUTTON')) then
    !!alert.error('Auto Select gadget must be a "TOGGLE" or a "BUTTON".')
    return
  endif

  -- Toggle Gadget, sets the auto select member of the specData
  if(!gadgetType eq 'TOGGLE') then

    -- Assign the callback to the gadget
    !gadget.callback = !this.linkMember(!gadget.owner()) & '.setAutoSelect()'

    -- Handle unset autoSelect
    if(!this.specData.autoSelect.unset()) then
      !this.specData.autoSelect = false
    endif

    !gadget.val      = !this.specData.autoSelect

    -- Assign gadget to member
    !this.autoSelect = !gadget

  -- Button Gadget (set auto select, do a choose, then unset auto select)
  else

    -- Assign the callback to the gadget
    !gadget.callback = !this.linkMember(!gadget.owner()) & '.actionAutoSelect()'

    -- Handle unset autoSelect
    if(!this.specData.autoSelect.unset()) then
      !this.specData.autoSelect = false
    endif

  endif


endmethod
-- End of method definition for .autoSelect(GADGET)

------------------------------------------------------------------------
--
-- Method:      linkMember
--
-- Description: Returns the link member of the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     FORM        Form link object is searched in
-- Return:
--   [Data Type] [Description]
--    STRING      SPCLINK member of form
--
------------------------------------------------------------------------

define method .linkMember(!form is FORM) is STRING

  -- Get form members
  !members = !form.attributes()

  do !i indices !members
    if(!form.attribute(!members[!i]).objectType() eq 'SPCLINK') then
      !memberName = '!!' & !form.name() & '.' & !members[!i]
      return !memberName
    endif
  enddo

  return STRING()

endmethod
-- End of method definition for .linkMember(FORM) STRING

------------------------------------------------------------------------
--
-- Method:      selection
--
-- Description: Returns current selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    GADGET      Specification gadget
--
------------------------------------------------------------------------

define method .selection() is DBREF

  return !this.specData.selector

endmethod
-- End of method definition for .selection() DBREF

------------------------------------------------------------------------
--
-- Method:      choice
--
-- Description: Returns current selector choice from the specdata member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of SPCDEFINITION
--
------------------------------------------------------------------------

define method .choice() is ARRAY

  return !this.specData.choice()

endmethod
-- End of method definition for .choice() ARRAY

------------------------------------------------------------------------
--
-- Method:      preferenceClear
--
-- Description: Clears the current preferences
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preferenceClear()

  !this.specData.preferenceClear()

endmethod
-- End of method definition for .preferenceClear()

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description: Define a preference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question key
--    2   R      ANY         Answer for question
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference(!key is STRING, !answer is ANY)

  !this.specData.preference(!key, !answer)

endmethod
-- End of method definition for .preference(STRING, ANY)

