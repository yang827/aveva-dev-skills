--
-- File:            spcsearch.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
-- Specification selection of object, use to search out specification
-- within the project with relevant search criteria
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        ARRAY               Returns the display text
--  like(DBREF)                      ARRAY               Sets object and searched for "like' specs
--  populateGadget(GADGET)           -                   Populates the passed gadget with the current specifications
--  replacement()                    ARRAY               Returns the replacement text
--  search()                         ARRAY               Search for specs of set criteria
--
------------------------------------------------------------------------

define object SPCSEARCH

  -- Specifications
  member .specifications    is ARRAY

  -- Display & Replacement text for gadget/information
  member .display           is ARRAY
  member .replacement       is ARRAY

  -- Specification Search Data
  -- Spec World Type (Purpose)
  member .spwlType          is STRING

  -- Spec Type (Purpose)
  member .type              is STRING
  -- Material
  member .material          is DBREF
  -- Fluid
  member .fluid             is DBREF
  -- Rating
  member .rating            is REAL
  -- Standard
  member .standard          is STRING

endobject
-- End of object definition for SPCSEARCH

------------------------------------------------------------------------
--
-- Method:      search
--
-- Description:
--   Search for all specs conforming to the set criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Spec found like reference spec
--
------------------------------------------------------------------------

define method .search() is ARRAY

  -- Initialise Variables
  !this.specifications.clear()
  !this.replacement.clear()
  !this.display.clear()
  !collection = ARRAY()

  -- Build search string
  !searchRules = ARRAY()

  -- Spec world type defined
  if(!this.spwlType.set() and !this.spwlType.trim().empty().not()) then
    !searchRules.append('PURPOSE of SPWL eq ''' & !this.spwlType & '''')
  endif

  -- Spec type defined
  if(!this.type.set() and !this.type.trim().empty().not()) then
    !searchRules.append('PURPOSE eq ''' & !this.type & '''')
  endif

  -- Spec material defined
  if(!this.material.set()) then
    !searchRules.append('MATREF eq ' & !this.material )
  endif

  -- Spec fluid defined
  if(!this.fluid.set()) then
    !searchRules.append('FLUREF eq ' & !this.fluid )
  endif

  -- Spec rating defined
  if(!this.rating.set() and !this.rating ne 0) then
    !searchRules.append('RATING eq ' & !this.rating )
  endif

  -- Spec standard defined
  if(!this.standard.set() and !this.standard.trim().empty().not()) then
    !searchRules.append('CSTANDARD eq ''' & !this.standard & '''')
  endif

  -- Rules defined
  if(!searchRules.empty().not()) then

    -- Define rule
    !rule = !searchRules[1]

    -- Add all rules together
    if(!searchRules.size() gt 1) then

      -- Loop through each rule list
      do !i from 2 to !searchRules.size()
        !rule = !rule & ' AND ' & !searchRules[!i]
      enddo
    endif

    !rememberHere = !!ce
    goto frstw CATA
    var !spwlds SPLIT MEMB SPWL

    do !i indices !spwlds
      -- Collect all specs
      var !c COLLECT ALL SPEC WITH ( $!<rule> ) for $!spwlds[$!i]
      !collection.appendArray(!c)
    enddo

    !!ce = !rememberHere

  -- No rules defined
  else

    !rememberHere = !!ce
    goto frstw CATA
    var !spwlds SPLIT MEMB SPWL

    do !i indices !spwlds
      -- Collect all specs
      var !c COLLECT ALL SPEC for $!spwlds[$!i]
      !collection.appendArray(!c)
    enddo

    !!ce = !rememberHere

  endif

  -- String definition for replacement text
  !this.replacement = !collection

  -- Convert all collected items from string to dbref
  do !i indices !collection
    !spec = !collection[!i].dbRef()
    !this.specifications.append(!spec)

    -- Get description
    if(!spec.description.set() and !spec.description.trim().empty().not()) then
      !this.display.append(!spec.description)
    else
      !this.display.append(!spec.flnn)
    endif

  enddo

  return !this.specifications

endmethod
-- End of method definition for .search() ARRAY

------------------------------------------------------------------------
--
-- Method:      like
--
-- Description:
--   Populates the passed gadget with the current specifications
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Spec to be used to search link
-- Return:
--   [Data Type] [Description]
--    ARRAY       Spec found like reference spec
--
------------------------------------------------------------------------

define method .like(!reference is DBREF) is ARRAY

  -- Check we have a spec
  if(!reference.type ne 'SPEC') then
    !!messageFile.error(153,7,!reference.flnm)
    return
  endif

  -- Set criteria "like"
  !this.spwlType = !reference.owner.purpose
  !this.type     = !reference.purpose
  !this.material = !reference.matRef
  !this.fluid    = !reference.fluRef
  !this.rating   = !reference.rating
  !this.standard = !reference.cStandard

  return !this.search()

endmethod
-- End of method definition for .like(DBREF) ARRAY

------------------------------------------------------------------------
--
-- Method:      populateGadget
--
-- Description:
--   Populates the passed gadget with the current specifications
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to be updated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateGadget(!gadget is GADGET)

  !gadget.dText = !this.display
  !gadget.rText = !this.replacement

endmethod
-- End of method definition for .populateGadget(GADGET)

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   Return display text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Display text
--
------------------------------------------------------------------------

define method .display() is ARRAY

 return !this.display

endmethod
-- End of method definition for .display() ARRAY

------------------------------------------------------------------------
--
-- Method:      replacement
--
-- Description:
--   Return replacement text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       replacement text
--
------------------------------------------------------------------------

define method .replacement() is ARRAY

 return !this.replacement

endmethod
-- End of method definition for .replacement() ARRAY
