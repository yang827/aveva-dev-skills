-- File:            spcspecification.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:
--
--
-- Description:
-- Specification Object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  answerType(DBREF)                STRING              Returns the "type" of the answer of the passed item Must be the same mechanism as used by the SPCDEFINITION object
--  choice()                         ARRAY               Returns current selector choice
--  choiceGadget(GADGET)             -                   Populate the passed list gadget with the current choices data
--  choose()                         -                   Choose the specification items from the current reference item and specification selection
--  choose(DBREF)                    -                   Choose the best specification item for the passed design item using the current specification
--  choose(DBREF,DBREF)              -                   Choose the best specification item for the passed design item using the passed specification item to determine the spec to choose from
--  defineWith(DBREF)                -                   Define with DB element
--  edit()                           -                   Display generic specification edit form
--  preference(STRING,BOOLEAN)       -                   Add a preference (question and answer) to be considered in the choice
--  preference(STRING,REAL)          -                   Add a preference (question and answer) to be considered in the choice
--  preference(STRING,STRING)        -                   Add a preference (question and answer) to be considered in the choice
--  preferenceClear()                -                   Remove all preferences from the object
--  question()                       STRING              Return the current selector's question
--  question(DBREF)                  STRING              Return the of the passed spec item
--  reference(DBREF)                 -                   Define reference design element
--  selectionGadget(GADGET)          -                   Populate the passed list gadget with the current selection's question and answer structure, ie its owners structure.
--  selector(DBREF)                  -                   Define reference design element
--  spcSpecification(DBREF)          -                   Constructor
--  specGadget(GADGET)               -                   Populate the passed option gadget with the current spec description
--  valid()                          BOOLEAN             Determines if the selector member satisfies the owning spec structure selection criteria
--  view()                           -                   Display generic specification viewing form
--
------------------------------------------------------------------------

define object SPCSPECIFICATION

  -- Reference Specification
  member .specification    is DBREF

  -- Reference Item (Design element)
  member .reference        is DBREF

  -- Specification Reference
  member .selector         is DBREF

  -- Current choices
  member .choices          is ARRAY

  -- Default Questions/Answers
  member .questions        is ARRAY
  member .answers          is ARRAY

  -- Default chose or no logical choice
  member .useDefault       is BOOLEAN

  -- Auto selection
  member .autoSelect       is BOOLEAN

endobject
-- End of object definition for SPCSPECIFICATION

------------------------------------------------------------------------
--
-- Method:      spcSpecification
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcSpecification(!specification is DBREF)

  -- Initialise Variables
  !this.useDefault    = false
  !this.autoSelect    = false

  -- Set specification
  !this.specification = !specification
  !this.selector      = !specification

endmethod
-- End of method definition for .spcSpecification(DBREF)

------------------------------------------------------------------------
--
-- Method:      defineWith
--
-- Description: Define with DB element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design DB element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineWith(!element is DBREF)

  -- Check that element has a SPREF
  if(!element.attributes().findFirst('Spref').unset()) then
    !!messageFile.error(153, 15, !element.flnn )
    return
  endif

  -- Handle unset specRefs
  if(!element.spref.unset() or badref(!element.spref)) then
    !!messageFile.error(153, 5, !element.flnn )
    return
  endif

  -- Initialise Variables
  !this.reference     = !element
  !this.selector      = !element.spref
  !this.specification = SPEC of $!<this.selector>

  -- Current choices
  !this.choices.clear()

  -- Default Questions/Answers
  !this.questions.clear()
  !this.answers.clear()

  !this.useDefault    = false
  !this.autoSelect    = false

endmethod
-- End of method definition for .defineWith(DBREF)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Display generic specification edit form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- Check edit form exists
  if(undefined(!!spcEdit)) then
    pml reload form !!spcEdit
  endif

  -- Display Specification edit form
  !!spcEdit.edit(!this.specification)

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      answerType
--
-- Description: Returns the "type" of the answer of the passed item Must be the same mechanism as used by the SPCDEFINITION object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Spec element
-- Return:
--   [Data Type] [Description]
--    STRING      Answer type
--
------------------------------------------------------------------------

define method .answerType(!selector is DBREF) is STRING

  -- Text Answer
  if(!selector.tAnswer.set() and !selector.tAnswer.trim().empty().not()) then
    return 'TEXT'

  -- Range Answer
  elseif (!selector.answer ne !selector.maxAnswer) then
    return 'RANGE'

  -- Value Answer
  else
    return 'VALUE'
  endif

endmethod
-- End of method definition for .answerType(DBREF) STRING

------------------------------------------------------------------------
--
-- Method:      view
--
-- Description: Display generic specification viewing form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .view()

  -- Check edit form exists
  if(undefined(!!spcView)) then
    pml reload form !!spcView
  endif

  -- Display Specification edit form
  !!spcView.view(!this)

endmethod
-- End of method definition for .view()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose the specification items from the current reference item and specification selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference database element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .choose()

  -- Choose form top of specification
  !this.choose(!this.reference, !this.selector)

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose the best specification item for the passed design item using the current specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference database element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .choose(!reference is DBREF)

  -- Choose form top of specification
  !this.choose(!reference, !this.selector)

endmethod
-- End of method definition for .choose(DBREF)

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose the best specification item for the passed design item using the passed specification item to determine the spec to choose from
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference database element
--    2   R      DBREF       Selection seed element (must be within current spec)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .choose(!reference is DBREF, !selection is DBREF)

  -- Initialise Variables
  !this.reference       = !reference
  !this.choices.clear()

  -- Handle unset data
  if(!this.autoSelect.unset()) then
    !this.autoSelect    = false
  endif

  -- If no selection is passed, use the spec
  if(!selection.unset()) then
    !selection          = !this.specification

  -- Set specification to spec of passed selection
  else
    !this.specification = SPEC of $!<selection>
  endif

  -- Initial start point in the spec
  !this.selector   = !selection

  -- Stack of previous qualifiers and answer, so we don't need to reprocess
  !qualifiers      = ARRAY()
  !previousAnswers = ARRAY()

  -- Loop
  do !infinite

    -- No more selection possible
    break if(!this.selector.type eq 'SPCO')

    -- What is the question?
    !question = !this.selector.question

    -- See if there has been a answers supplied to the passed question
    !questionIndex = !this.questions.find(!question)
    if(!questionIndex.set()) then
      !result = ARRAY()
      do !i indices !questionIndex
        !result.append(!this.answers[!questionIndex[!i]])
      enddo

    else

      -- Is there a qualifier?
      if(!this.selector.tQualifier.set() and !this.selector.tQualifier.empty().not()) then

        -- Qualifier
        !qualifier = !this.selector.tQualifier

        -- Qualifier is a function
        if(!qualifier.subString(1,2) eq '!!') then

          -- Use result of qualifier, if the qualifier has been executed before
          !refIndex = !qualifiers.findFirst(!qualifier)
          if(!refIndex.set()) then
            !result[1] = !previousAnswers[!refIndex]
          else

            -- Execute function
            !result[1] = $!<qualifier>

            !qualifiers.append(!qualifier)
            !previousAnswers.append(!result)
          endif

        -- Assume qualifier is an Attribute?
        else
          if(!this.reference.set()) then
          !result[1] = !reference.attribute(!qualifier)
            handle any
              !result  = ARRAY()
            endhandle
          endif
        endif

      -- Numeric Qualifier?
      else

        -- If qualifier is zero (then its not set (assumption))
        if(!this.selector.qualifier ne 0) then
          !result[1] = !this.selector.qualifier
        endif

      endif
    endif

    -- Initialise Variables for answers

    -- If there is no result and we can use the default selection
    if((undefined(!result) or !result.unset()) and !this.useDefault) then
      if(!this.selector.tDefault.set() and !this.selector.tDefault.empty().not()) then
        !result[1] = !this.selector.tDefault
      elseif (!this.selector.default ne 0) then
        !result[1] = !this.selector.default
      else
        !result[1] = STRING()
      endif
    endif

    -- Do we have a result
    if(defined(!result) and !result.set()) then

      -- Result must be either a REAL or STRING (this included BOOLEAN)
      -- Always use the first result
      !resultType = !result[1].objectType()

      if(not !resultType inset('STRING','REAL', 'BOOLEAN')) then
        !!alert.error('Specification (' & !this.specification.flnn & ') incorrectly defined. Element (' & !this.selector.flnn & ') has invalid qualifier result type.')
        return ARRAY()
      endif

      -- Get answers of members
      do !i indices !this.selector.members

        -- Spec item
        !specItem = !this.selector.members[!i]

        -- Ignore non SELE or SPCO items
        skip if(not !specItem.type inset('SELE','SPCO'))

        -- Test tAnswers
        if(!resultType eq 'STRING') then
          if(!result.findFirst(!specItem.tAnswer).set()) then
            !this.choices.append(!specItem)
          endif

        -- Test tAnswer as a boolean
        elseif (!resultType eq 'BOOLEAN') then

          !boolean = !specItem.tAnswer.boolean()
          handle any
            skip
          endhandle

          -- if result is same as any result, we'll use it
          -- Can be a problem where someone give both true and
          -- false as the preference
          do !j indices !result
            if(!boolean and !result[!j]) then
              !this.choices.append(!specItem)
              break
            endif
          enddo

        -- Test answer/maxAnswer
        else
          do !j indices !result
            if(!result[!j].between(!specItem.answer, !specItem.maxAnswer)) then
              !this.choices.append(!specItem)
              break
            endif
          enddo
        endif
      enddo

    -- As there is no result, we'll have to let the user choose
    else
      -- All Members
      !this.choices = !this.selector.members
    endif

    -- There is no or more than one choice
    break if(!this.choices.size() eq 0 or !this.choices.size() gt 1 or !this.autoSelect.not())

    -- Use the choice as the selector
    !this.selector = !this.choices[1]

    -- Empty the choices
    !this.choices.clear()

    -- If there are no members, then we don't continue
    break if(!this.selector.mCount eq 0)

    -- Initialise Variables
    if(defined(!result)) then
      !result.delete()
    endif

  enddo

endmethod
-- End of method definition for .choose(DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:      choice
--
-- Description: Returns current selector choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]    [Description]
--    ARRAY          Array of SPCDEFINITION
--
------------------------------------------------------------------------

define method .choice() is ARRAY

  -- Initialise Variables
  !choice   = ARRAY()
  !selector = !this.selector

  -- Loop from selector upto SPEC
  do !infinite

    break if(!selector.type eq 'SPEC')

    -- Get definition of spec element
    !choice.append(object SPCDEFINITION(!selector))

    -- Get owning element
    !selector = !selector.owner
    handle any
      break
    endhandle
  enddo

  -- Return choices
  return !choice

endmethod
-- End of method definition for .choice() ARRAY

------------------------------------------------------------------------
--
-- Method:      valid
--
-- Description: Determines if the selector member satisfies the owning spec structure selection criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]    [Description]
--    BOOLEAN        True if selector satisfies owning spec selection
--
------------------------------------------------------------------------

define method .valid() is BOOLEAN

  -- Check for set reference
  if(!this.reference.unset()) then
    !!alert.error('No reference element has been defined.')
    return false
  endif

  -- Initialise Variables
  !selector   = !this.selector
  !reference  = !this.reference

  -- Stack of previous qualifiers and answer, so we don't need to reprocess
  !qualifiers      = ARRAY()
  !previousAnswers = ARRAY()

  -- Loop from selector upto SPEC
  do !infinite

    break if(!selector.type eq 'SPEC')

    -- Selector
    !selection = !selector

    -- Get owning item (this hold the qualifier check)
    !selector  = !selector.owner
    handle any
      break
    endhandle

    -- Get Qualifier data
    !question = !selector.question

    -- Is there a qualifier?
    if(!selector.tQualifier.set() and !selector.tQualifier.empty().not()) then

      -- Qualifier
      !qualifier = !selector.tQualifier

      -- Qualifier is a function
      if(!qualifier.subString(1,2) eq '!!') then

        -- Use result of qualifier, if the qualifier has been executed before
        !refIndex = !qualifiers.findFirst(!qualifier)
        if(!refIndex.set()) then
          !result = !previousAnswers[!refIndex]
        else

          -- Execute function
          !result = $!<qualifier>

          !qualifiers.append(!qualifier)
          !previousAnswers.append(!result)
        endif

      -- Assume qualifier is an Attribute?
      else
        !result = !reference.attribute(!qualifier)
      endif

    -- Numeric Qualifier?
    else

      -- If qualifier is zero (then its not set (assumption))
      if(!selector.qualifier ne 0) then
        !result = !selector.qualifier
      endif

    endif

    skip if(undefined(!result))

    -- Get definition of spec element
    !choice = object SPCDEFINITION(!selection)
    if(!choice.valid(!result).not()) then
      return false
    endif

    !result.delete()

  enddo

  -- Return choices
  return true

endmethod
-- End of method definition for .valid() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description: Add a preference (question and answer) to be considered in the choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question
--    2   R      STRING      Answer
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference(!question is STRING, !answer is STRING)

  -- Add to lists
  !this.questions.append(!question.upcase())
  !this.answers.append(!answer)

endmethod
-- End of method definition for .preference(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description: Add a preference (question and answer) to be considered in the choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question
--    2   R      REAL        Answer
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference(!question is STRING, !answer is REAL)

  -- Add to lists
  !this.questions.append(!question.upcase())
  !this.answers.append(!answer)

endmethod
-- End of method definition for .preference(STRING, REAL)

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description: Add a preference (question and answer) to be considered in the choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question
--    2   R      BOOLEAN     Answer
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference(!question is STRING, !answer is BOOLEAN)

  -- Add to lists
  !this.questions.append(!question.upcase())
  !this.answers.append(!answer.string())

endmethod
-- End of method definition for .preference(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      preferenceClear
--
-- Description: Remove all preferences from the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preferenceClear()

  -- Add to lists
  !this.questions.clear()
  !this.answers.clear()

endmethod
-- End of method definition for .preferenceClear()

------------------------------------------------------------------------
--
-- Method:      reference
--
-- Description: Define reference design element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design reference element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reference(!reference is DBREF)

  -- Set data
  !this.reference = !reference

endmethod
-- End of method definition for .reference(DBREF)

------------------------------------------------------------------------
--
-- Method:      selector
--
-- Description: Define reference design element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selector reference element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selector(!selector is DBREF)

  -- If selector is set, then make sure the specification is the same
  if(!selector.set()) then

    -- Check we have a SPCO
    if(not !selector.type inset('SPCO','SELE', 'SPEC')) then
      !!messageFile.error(153, 11, !selector.flnn)
      return
    endif

    -- Assign spec to spec of passed selector/spco
    !this.specification = SPEC of $!<selector>

  endif

  -- Set data
  !this.selector = !selector

endmethod
-- End of method definition for .selector(DBREF)

------------------------------------------------------------------------
--
-- Method:      selectionGadget
--
-- Description: Populate the passed list gadget with the current selection's question and answer structure, ie its owners structure.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget data is to be written to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectionGadget(!gadget is GADGET)

  -- Initialise Variables
  !item      = !this.selector
  !questions = ARRAY()
  !answers   = ARRAY()
  !dText     = ARRAY()
  !rText     = ARRAY()

  -- Clear gadget down
  !gadget.clear()

  -- Don't do anything is the selector is a spec
  if(!item.type eq 'SPEC') then
    return
  endif
  -- Loop until we hit the spec
  do !i

    -- Get Text of SPCO (use catref for moment)
    if(!item.type eq 'SPCO') then
      if(!item.catRef.set()) then
       if(!item.catRef.description.set() and !item.catRef.description.trim() ne '') then
          !answer = !item.catRef.description
        else
        !answer = !item.catRef.flnn
        endif
      elseif (!item.tmpRef.badref().not()) then
        if(!item.tmpRef.description.set() and !item.tmpRef.description.trim() ne '') then
          !answer = !item.tmpRef.description
        else
        !answer = !item.tmpRef.flnn
        endif
      else
        !answer = !item.flnn
      endif

    -- Get Description
    else
      !answer  = !item.description
    endif

    break if(!item.type eq 'SPEC')

    !questions.append(!this.question(!item.owner))
    !answers.append(!answer)
    !rText.append(!item.owner.string())

    !item = !item.owner

  enddo

  -- Build display text
  !maxWidth = !questions.width()
  do !i indices !answers
    var !dprt COMPOSE SPACE 2 '$!questions[$!i]' WIDTH $!maxWidth R ' - $!answers[$!i]'
    !dText[!i] = !dprt[1]
  enddo

  -- Update gadget
  !dText.invert()
  !rText.invert()
  !gadget.dText = !dText
  !gadget.rText = !rText

endmethod
-- End of method definition for .selectionGadget(GADGET)
------------------------------------------------------------------------
--
-- Method:      specGadget
--
-- Description: Populate the passed option gadget with the current spec description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Option gadget data is to be written to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specGadget(!gadget is GADGET)

  !ref = !this.specification.string()
  if (!ref ne 'Unset') then
    !gadget.select('rtext', !ref)
    handle any
      -- could be that the specs no longer there
    endhandle
  endif

endmethod
-- End of method definition for .specGadget(GADGET)

------------------------------------------------------------------------
--
-- Method:      choiceGadget
--
-- Description: Populate the passed list gadget with the current choices data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget data is to be written to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .choiceGadget(!gadget is GADGET)

  -- Initialise Variables
  !choices = !this.choices
  !dText   = ARRAY()
  !rText   = ARRAY()

  -- Loop through each member
  do !i indices !choices

    -- Ignore none spec elements
    skip if(not !choices[!i].type inset('SELE','SPCO'))

    !selector = !choices[!i]

    -- Build Display Data
    !type     = !this.answerType(!selector)

    if(!type eq 'TEXT') then
      !answer  = '"' & !selector.tAnswer & '"'

    elseif (!type eq 'VALUE') then
      !answer  = !selector.answer.string()

    elseif (!type eq 'RANGE') then
      !answer  = !selector.answer & ' to ' & !selector.maxAnswer
    endif

    -- If type of selector is a SPCO, show CATR or TMPL
    if(!selector.type eq 'SPCO') then
      if(!selector.catRef.badref().not()) then
        if(!selector.catRef.description.set() and !selector.catRef.description.trim() ne '') then
          !description = !selector.catRef.description
        else
        !description = !selector.catRef.flnn
        endif
      elseif (!selector.tmpRef.badref().not()) then
        if(!selector.tmpRef.description.set() and !selector.tmpRef.description.trim() ne '') then
          !description = !selector.tmpRef.description
        else
        !description = !selector.tmpRef.flnn
        endif
      else
        !description = '>> No Catalogue Reference <<'
      endif

      -- Use description
    else
      if(!selector.description.set()) then
        !description = !selector.description
      else
        !description = 'unset'
      endif
    endif

    var !dprt COMPOSE SPACE 2 '$!answer' WIDTH 16 R SPACE 6 '$!description'
    !dText.append(!dprt[1])
    !rText.append(!selector.string())

  enddo

  -- Update gadget
  !gadget.dText = !dText
  !gadget.rText = !rText

endmethod
-- End of method definition for .choiceGadget(GADGET)

------------------------------------------------------------------------
--
-- Method:      question
--
-- Description: Return the current selector's question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .question() is STRING

  return !this.question(!this.selector)

endmethod
-- End of method definition for .question() STRING

------------------------------------------------------------------------
--
-- Method:      question
--
-- Description: Return the of the passed spec item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .question(!selector is DBREF) is STRING

  -- Initialise Variables

  -- If at a SPCO, then there is no more selections
  if(!selector.type eq 'SPCO') then
    return !!messageFile.messageString(153,9)
  endif

  !question = !selector.tQuestion

  -- If the selector's tQuestion is unset or empty then return the question
  if(!question.trim().empty()) then
    !question = !selector.question
    if(!question.trim().empty()) then
      if(!selector.type eq 'SELE') then
        !question = 'Selection'
      else
        !question = !selector.fullType.subString(1,1) & !selector.fullType.subString(2).lowcase()
      endif
    endif
  endif
  return !question

endmethod
-- End of method definition for .question(DBREF) STRING
