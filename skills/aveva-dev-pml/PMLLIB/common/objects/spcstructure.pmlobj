--
-- File:            spcstructure.pmlobj
--   Type:          Object Definition
--   Group:         Specification handling utilities

--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Dec 10 10:01:15 "GMT 1998
--
--
-- Description:
-- Main definition for a specification.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addTable(DBREF)                  -                   Add a table to the list of tables
--  spcStructure(DBREF)              -                   Constructor, setup table with passed specification
--
------------------------------------------------------------------------


define object SPCSTRUCTURE

  -- Specification Data

  -- Reference to original specification
  member .reference is DBREF

  -- Name
  member .name      is STRING

  -- Type (equates to PURPOSE)
  member .type      is STRING

  -- NEED other associated attribute of specification
  --      standard
  --      material, etc, etc

  -- Main tables within the specification (types, e.g. TUBE, BEND, TEE, etc)
  -- array of SPCTABLE
  member .tables    is ARRAY

  -- Direct pointer to tables (index to each table in the .tables list)
  member .types     is ARRAY


endobject
-- End of object definition for SPCSTRUCTURE

------------------------------------------------------------------------
--
-- Method:      spcStructure
--
-- Description: Constructor, setup table with passed specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spcStructure(!specification is DBREF)

  -- Initialise Variables
  !this.reference = !specification
  !this.type      = !specification.purpose

  -- Loop through each member and create a table of then
  do !i indices !specification.members

    -- Ignore no SELE elements
    skip if(!this.reference.members[!i].fullType ne 'SELEC')

    -- Add a table to the system
    !this.addTable(!specification.members[!i])

  enddo

endmethod
-- End of method definition for .spcStructure(DBREF)

------------------------------------------------------------------------
--
-- Method:      addTable
--
-- Description: Add a table to the list of tables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Table element (top level selector)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addTable(!selector is DBREF)

  -- Initialise Variables

  -- Return passed selector as a table
  !table = object SPCTABLE(!selector)

  -- Add table into list of tables
  !this.tables.append(!table)

  -- Add quick reference to table into types list
  !this.types.append(!table.type)

endmethod
-- End of method definition for .addTable(DBREF)
