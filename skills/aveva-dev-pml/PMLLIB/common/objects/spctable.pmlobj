--
--
-- Description:
-- Contains the definition for a "family" of a given type.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  spcTable(DBREF)                  -                   Constructor, setup table with passed selector
--
------------------------------------------------------------------------

define object SPCTABLE

  -- Reference Element
  member .reference    is DBREF

  -- Description
  member .description  is STRING

  -- Type
  member .type         is STRING

  -- Table header definition
  member .headers      is ARRAY

  -- Quick reference to headers
  member .headerList   is ARRAY

  -- Pointers to spec component (when defined)
  member .components   is ARRAY

  -- Table of answers (each element contains the answers for the question, paired for max/min)
  member .minimums     is ARRAY
  member .maximums     is ARRAY
  member .booleans     is ARRAY
  member .texts        is ARRAY

  -- Catalogue references
  member .catRefs      is ARRAY

  -- Detail Text references
  member .detailRefs   is ARRAY

  -- Material Text references
  member .materialRefs is ARRAY

  -- Property Component references
  member .propertyRefs is ARRAY

  -- Bolting references
  member .boltRefs     is ARRAY

  -- May need other attributes defined

endobject
-- End of object definition for SPCTABLE

------------------------------------------------------------------------
--
-- Method:      spcTable
--
-- Description: Constructor, setup table with passed selector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selector to define the table
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spcTable(!selector is DBREF)

  -- Initialise Variables
  !this.reference      = !selector
  !this.description    = !selector.description
  !this.type           = !selector.tAnswer

  -- Build the Header definition for the table

  -- Collect all the SPCO for the selector/table
  var !specComponents COLLECT ALL SPCO FOR $!<selector>

  -- Get the lowest element (we'll use the first spco in the list)
  !specComponent   = !specComponents[1].dbRef()

  -- Owner list
  !owners          = !specComponent.ownLst
  !owners.append(!specComponent)

  -- Invert list of owners, so we start from the bottom
  !owners.invert()

 -- Loop through the owner list getting the questions/answers
  do !i indices !owners

    -- Get header for column
    !header[!i] = object SPCHEADER(!owners[!i])

    -- When we are at the item below the passed selector, stop looking for any more headers
    break if(!owners[!i].owner eq !selector)

  enddo

  -- Define the header array
  !header.invert()

  !this.headers = !header

  -- Build quick reference list
  do !i indices !this.headers
    !this.headerList[!i] = !this.headers[!i].key
  enddo

  -- Load the table with each all the answers
  do !i indices !specComponents

    !specComponent         = !specComponents[!i].dbRef()

    -- References
    !this.components[!i]   = !specComponent
    !this.catRefs[!i]      = !specComponent.catRef
    !this.detailRefs[!i]   = !specComponent.detRef
    !this.materialRefs[!i] = !specComponent.matxt
    !this.propertyRefs[!i] = !specComponent.cmpref
    !this.boltRefs[!i]     = !specComponent.bltref

    -- Go through each answer for the table
    !owners = !specComponent.ownLst
    !owners.append(!specComponent)
    !owners.invert()

    -- Only look up the number of header elements
    !owners = !owners.from(1, !this.headers.size())
    !owners.invert()

    -- Get the header information
    do !j indices !owners

      !this.minimums[!j][!i]        = !owners[!j].answer
      !this.maximums[!j][!i]        = !owners[!j].maxAnswer

      if(!this.headers[!j].type eq 'BOOLEAN') then
        !this.booleans[!j][!i]     = !owners[!j].tAnswer.boolean()
      else
        !this.booleans[!j][!i]     = BOOLEAN()
      endif

      !this.texts[!j][!i]          = !owners[!j].tAnswer
    enddo
  enddo

endmethod
-- End of method definition for .spcTable(DBREF)
