-- Define object
define object SPECDATA

  -- Spec Link (Gadget links)
  member .specLink         is SPECLINK

  -- Specification Name
  member .specName         is DBREF

  -- Selection Reference Item (i.e. the item we are to use to set the spec up)
  member .reference        is DBREF

  -- Current Selection
  member .currentSelection is DBREF

  -- Type of Spec (bottom level SPCO, or bottom level SELE
  -- only owning SPCOs)
  member .standardSpec     is BOOLEAN

  -- Do we look for part selection SPCOs
  member .partSelection    is BOOLEAN

  -- Default selection
  member .defaultSelection is BOOLEAN

  -- Do we try and set up the spec from the SPRE of the "Selection Item" or
  -- do we only use it for reference (true if we try and set using  "Selection Item")
  member .autoSelection    is BOOLEAN

  -- Permissible Members
  member .permissibles     is ARRAY

  -- Action carried out on selections
  member .action           is STRING

  -- Action flag, if true action is carried out on each item selected
  member .actionState      is BOOLEAN

  -- Question/Answer must be pairs, these are arrays so we
  -- can have ANY item stored.
  -- Question Array
  member .questions  is ARRAY
  -- Answer Array
  member .answers    is ARRAY

endobject
-- End of object definition for SPECDATA
