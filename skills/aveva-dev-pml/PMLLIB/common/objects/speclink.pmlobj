-- Define object
define object SPECLINK

  -- Specifications
  member .specifications is GADGET
  -- Selected List
  member .selected       is GADGET
  -- Permissible selections
  member .permissible    is GADGET
  -- Question gadget
  member .question       is GADGET
  -- Auto select gadget
  member .autoSelect     is GADGET
  -- Default gadget
  member .default        is GADGET
  -- Direct selection
  member .specComp       is GADGET
  -- Member containing SPECDATA
  member .specData       is STRING

endobject
-- End of object definition for SPECLINK
