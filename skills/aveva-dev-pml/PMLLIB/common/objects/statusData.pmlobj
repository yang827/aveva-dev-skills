import 'Aveva.Pdms.DataManagement.PML'
handle any
endhandle
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            statusData.pmlobj
--   Type:          Object Definition
--   Group:         Status management
--
--    Keyword:      Status
--    Module:       General
--
-- Author:          Mac Lewis
-- Created:         Wed Nov 12   10:0:01  2008
--
-- Description:
-- Status for a single status definition for single object or objects
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assign()                         -                   Assign status definition to object
--  assign(STRING)                   -                   Assign status definition to object and set comment
--  assignStatus(DBREF)              -                   Assign status definition to object
--  assignStatus(DBREF,STRING)       -                   Assign status definition to object
--  assignStatus(STRING)             -                   Assign status definition to object
--  assignStatus(STRING,STRING)      -                   Assign status definition to object
--  clear()                          -                   Clear member data
--  debugOff()                       -                   Clear debug flag
--  debugOn()                        -                   Set debug flag
--  demote()                         -                   Demote status for object
--  demote(STRING)                   -                   Demote status for object and set comment
--  demoteStatus(DBREF)              -                   Demote status for object
--  demoteStatus(DBREF,STRING)       -                   Demote status for object
--  demoteStatus(STRING)             -                   Demote status for object
--  demoteStatus(STRING,STRING)      -                   Demote status for object
--  init()                           -                   Common constructor initialisation
--  output()                         ARRAY               Return one line status summary per object
--  outputAll()                      ARRAY               Return array of status details for object
--  print()                          -                   Print one line status summary for object
--  printAll()                       -                   Print array of status details for object
--  promote()                        -                   Promote status for object
--  promote(STRING)                  -                   Promote status for object and set comment
--  promoteStatus(DBREF)             -                   Promote status for object
--  promoteStatus(DBREF,STRING)      -                   Promote status for object
--  promoteStatus(STRING)            -                   Promote status for object
--  promoteStatus(STRING,STRING)     -                   Promote status for object
--  refresh()                        -                   Reread status data for controlled object
--  refreshMode(STRING)              -                   Set refreshMode
--  refreshModeFull()                -                   Set refreshMode
--  refreshModeNone()                -                   Set refreshMode
--  refreshModePart()                -                   Set refreshMode
--  remove()                         -                   Remove status definition from object
--  removeStatus(DBREF)              -                   Remove status definition from object
--  removeStatus(STRING)             -                   Remove status definition from object
--  set(STRING)                      -                   Set status for object
--  set(STRING,STRING)               -                   Set status for object and set comment
--  setStatus(DBREF,STRING)          -                   Set status for object
--  setStatus(DBREF,STRING,STRING)   -                   Set status for object
--  setStatus(STRING,STRING)         -                   Set status for object
--  setStatus(STRING,STRING,STRING)  -                   Set status for object
--  sortSteps(DBREF)                 ARRAY               Sort the step descriptions
--  statusData()                     -                   Constructor
--  statusData(ARRAY)                -                   Constructor
--  statusData(ARRAY,DBREF)          -                   Constructor
--  statusData(ARRAY,STRING)         -                   Constructor
--  statusData(DBREF)                -                   Constructor
--  statusData(DBREF,DBREF)          -                   Constructor
--  statusData(DBREF,STRING)         -                   Constructor
--  statusData(STRING)               -                   Constructor
--
------------------------------------------------------------------------

define object STATUSDATA

  -- Array of core status objects
  member .status       is ARRAY

  -- Array of statusData objects one per status definition
  member .list         is ARRAY

  -- Flag to indicate if this object has a list of objects for multiple status definitions
  -- False means the data for a single status definition is in this object; true means the data is in the list array
  member .bulk         is BOOLEAN

  -- Status definition for this object
  member .definition   is DBREF
  member .statusName   is STRING

  -- Data for elements in this object for the current status definition
  member .elements     is ARRAY
  member .elementNames is ARRAY
  member .values       is ARRAY
  member .valnames     is ARRAY
  member .descriptions is ARRAY
  member .numbers      is ARRAY
  member .comments     is ARRAY
  member .validValues  is ARRAY
  member .users        is ARRAY
  member .modifieds    is ARRAY
  member .transitions  is ARRAY

  -- Data for first element for backwards compatibility with code written for 12.0 using this object for single elements
  member .element      is DBREF
  member .elementName  is STRING
  member .value        is DBREF
  member .valname      is STRING
  member .description  is STRING
  member .number       is REAL
  member .comment      is STRING
  member .validValue   is BOOLEAN
  member .user         is STRING
  member .modified     is STRING
  member .steps        is ARRAY

  -- Flag to indicate if tracing should be output
  member .debug        is BOOLEAN

  -- Refresh mode indicates how much data is re-read from the database into this object after each action
  -- Set to none, part or full according to needs; should be set to none for best performance
  member .refreshMode  is STRING

endobject

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       (Candidate) Controlled object
--    2   R      DBREF       Name of status definition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!element is DBREF, !definition is DBREF)

  using namespace 'Aveva.Pdms.DataManagement.PML'

  -- Constructor for single status on single element
  !this.init()
  if (!definition.badref().not()) then
    if (!definition.type eq |STADEF|) then
      !this.definition = !definition
      !this.statusName = !definition.name
      !this.status[1]  = object STATUS(!this.definition.name)
      if (!element.badref().not()) then
        !this.elements[1]     = !element
        !this.elementNames[1] = !element.name
      endif
      !this.refresh()
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       (Candidate) Controlled object
--    2   R      STRING      Name of status definition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!element is DBREF, !definition is STRING)

  -- Alternative constructor
  !this.statusData(!element, !definition.dbref())

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of (Candidate) Controlled objects
--    2   R      DBREF       Name of status definition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!elements is ARRAY, !definition is DBREF)

  using namespace 'Aveva.Pdms.DataManagement.PML'

  -- Constructor for single status on multiple elements
  !this.init()
  if (!definition.badref().not()) then
    if (!definition.type eq |STADEF|) then
      !this.definition = !definition
      !this.statusName = !definition.name
      !this.status[1]  = object STATUS(!this.definition.name)
      do !element values !elements
        skip if (!element.objectType() ne |DBREF|)
        skip if (!element.badref())
        !this.elements.append(!element)
        !this.elementNames.append(!element.name)
      enddo
      !this.refresh()
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of (Candidate) Controlled objects
--    2   R      STRING      Name of status definition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!elements is ARRAY, !definition is STRING)

  -- Alternative constructor
  !this.statusData(!elements, !definition.dbref())

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       (Candidate) Controlled object
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!element is DBREF)

  -- Constructor for all statuses on single object
  !this.init()
  if (!element.badref().not()) then
    !definitions = !element.stvasd
    if (!definitions.size() eq 1) then
      !this.statusData(!element, !definitions[1])
    else
      !this.bulk = TRUE
      do !definition values !definitions
        !this.list.append(object STATUSDATA(!element, !definition))
      enddo
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of (Candidate) Controlled objects
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!elements is ARRAY)

  -- Constructor for all statuses on multiple objects
  !this.init()
  !this.bulk = TRUE
  -- Get a unique list of all the status definitions
  !definitions = ARRAY()
  do !element values !elements
    skip if (!element.objectType() ne |DBREF|)
    skip if (!element.badref())
    !definitions.appendArray(!element.stvasd)
  enddo
  !definitions.unique()
  -- Create an object for each definition and populate with the affected elements
  do !definition values !definitions
    !elementList = ARRAY()
    do !element values !elements
      skip if (!element.objectType() ne |DBREF|)
      skip if (!element.badref())
      if (!element.stvasd.findFirst(!definition).set()) then
        !elementList.append(!element)
      endif
    enddo
    if (!definitions.size() eq 1) then
      !this.statusData(!elementList, !definition)
    else
      !this.list.append(object STATUSDATA(!elementList, !definition))
    endif
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData()

  -- Constructor for all statuses on current element
  !this.statusData(!!ce)

endmethod

------------------------------------------------------------------------
-- Method:      statusData
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of status definition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusData(!definition is STRING)

  -- Constructor for one status on current element
  !this.statusData(!!ce, !definition.dbref())

endmethod

------------------------------------------------------------------------
-- Method:      init
--
-- Description:
--   Common constructor initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .init()

  -- Initialise member data
  !this.bulk = FALSE
  !this.elements.clear()
  !this.elementNames.clear()
  !this.elementName = ||
  !this.element     = object DBREF()
  !this.definition  = object DBREF()
  !this.statusName  = ||
  !this.clear()
  !this.list.clear()
  !this.debug = FALSE
  !this.refreshMode = |part|

endmethod

------------------------------------------------------------------------
-- Method:      clear
--
-- Description:
--   Clear member data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .clear()

  -- Clear member data
  !this.values.clear()
  !this.numbers.clear()
  !this.valnames.clear()
  !this.descriptions.clear()
  !this.comments.clear()
  !this.validValues.clear()
  !this.transitions.clear()
  !this.value  = object DBREF()
  !this.number = object REAL()
  !this.valname     = ||
  !this.description = ||
  !this.comment     = ||
  !this.validValue  = TRUE
  !this.steps.clear()

endmethod

------------------------------------------------------------------------
-- Method:      debugOn
--
-- Description:
--   Set debug flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .debugOn()

  !this.debug = TRUE
  do !status values !this.list
    !status.debugOn()
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      debugOff
--
-- Description:
--   Clear debug flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .debugOff()

  !this.debug = FALSE
  do !status values !this.list
    !status.debugOff()
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      refreshMode
--
-- Description:
--   Set refreshMode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Refresh mode none, part, full
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .refreshMode(!refreshMode is STRING)

  !this.refreshMode = !refreshMode
  do !status values !this.list
    !status.refreshMode(!refreshMode)
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      refreshModeNone
--
-- Description:
--   Set refreshMode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .refreshModeNone()

  !this.refreshMode(|none|)

endmethod

------------------------------------------------------------------------
-- Method:      refreshModePart
--
-- Description:
--   Set refreshMode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .refreshModePart()

  !this.refreshMode(|part|)

endmethod

------------------------------------------------------------------------
-- Method:      refreshModeFull
--
-- Description:
--   Set refreshMode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .refreshModeFull()

  !this.refreshMode(|full|)

endmethod

------------------------------------------------------------------------
-- Method:      refresh
--
-- Description:
--   Reread status data for controlled object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .refresh()

  -- Get available status data
  if (!this.bulk) then
    do !status values !this.list
      !status.refresh()
    enddo
  else
    -- Refresh data unless mode is none
    if (!this.refreshMode ne |none|) then
      !this.clear()
      !statusArray[1] = !this.definition
      do !i indices !this.elements
        if (!this.elements[!i].badref().not()) then
          -- Get status value for this object if available
          !values = !this.elements[!i].attribute(|STVVAL|, !statusArray)
          if (!values[1].badref()) then
            -- Element does not have any value for this status
            !this.valnames[!i]     = ||
            !this.values[!i]       = object DBREF()
            !this.descriptions[!i] = ||
            !this.numbers[!i]      = object REAL()
            !this.comments[!i]     = ||
            !this.validValues[!i]  = TRUE
            !this.users[!i]        = ||
            !this.modifieds[!i]    = ||
            !this.transitions[!i]  = ARRAY()
          else
            -- Get status data
            !this.values[!i]       = !values[1]
            !this.valnames[!i]     = !values[1].name
            !this.descriptions[!i] = !this.elements[!i].attribute(|STVDSC|, !statusArray)
            !this.comments[!i]     = !this.elements[!i].attribute(|STVCOM|, !statusArray)
            !this.users[!i]        = !this.elements[!i].attribute(|STVUSE|, !statusArray)
            !this.modifieds[!i]    = !this.elements[!i].attribute(|STVMOD|, !statusArray)
            !numbers               = !this.elements[!i].attribute(|STVNUM|, !statusArray)
            !this.numbers[!i]      = !numbers[1]
            !valid                 = !this.elements[!i].attribute(|STVVLD|, !statusArray)
            !this.validValues[!i]  = !valid[1]
            !this.transitions[!i]  = !this.sortSteps(!this.values[!i])
          endif
          -- Copy first element data for member compatibility with customer code written for the 12.0 version
          if (!i eq 1) then
            !this.element     = !this.elements[1]
            !this.elementName = !this.element.name
            !this.valname     = !this.valnames[1]
            !this.value       = !this.values[1]
            !this.number      = !this.numbers[1]
            !this.description = !this.descriptions[1]
            !this.comment     = !this.comments[1]
            !this.validValue  = !this.validValues[1]
            !this.user        = !this.users[1]
            !this.modified    = !this.modifieds[1]
            !this.steps       = !this.transitions[1]
          endif
        endif
      enddo
      -- Trace
      if (!this.debug) then
        !this.print()
      endif
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      sortSteps
--
-- Description:
--   Sort the step descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Status value
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of available transitions
------------------------------------------------------------------------
define method .sortSteps(!value is DBREF) is ARRAY

  -- Get available transitions into sorted list including current value (only if refresh mode is full)
  !steps   = ARRAY()
  if (!this.refreshMode eq |full|) then
    !numbers = ARRAY()
    !steps.append(!value.description & | | & !value.valnumber & | (Current)|)
    !numbers.append(!value.valnumber)
    do !i indices !value.valarray
      if (!i eq !value.promix) then
        !steps.append(!value.valarray[!i].description & | | & !value.valarray[!i].valnumber & | (Promote)|)
      elseif (!i eq !value.demix) then
        !steps.append(!value.valarray[!i].description & | | & !value.valarray[!i].valnumber & | (Demote)|)
      else
        !steps.append(!value.valarray[!i].description & | | & !value.valarray[!i].valnumber & | (Change)|)
      endif
      !numbers.append(!value.valarray[!i].valnumber)
    enddo
    !steps.reindex(!numbers.sortedIndices())
  endif
  return !steps

endmethod

------------------------------------------------------------------------
-- Method:      output
--
-- Description:
--   Return one line status summary per object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Status summaries
------------------------------------------------------------------------
define method .output() is ARRAY

  -- Format data
  !data = ARRAY()
  if (!this.bulk) then
    do !status values !this.list
      !data.appendArray(!status.output())
    enddo
  else
    -- Refresh if necessary
    if (!this.refreshMode eq |none|) then
      !this.refreshMode = |part|
      !this.refresh()
      !this.refreshMode = |none|
    endif
    do !i indices !this.elements
      if (!this.elements[!i].badref().not()) then
        if (!this.values[!i].set()) then
          if (!this.validValues[!i]) then
            !data.append(!this.elements[!i].type & | | & !this.elements[!i].namn & | | & !this.definition.namn & | | & !this.descriptions[!i] & | | & !this.numbers[!i])
          else
            !data.append(!this.elements[!i].type & | | & !this.elements[!i].namn & | | & !this.definition.namn & | Invalid | & !this.descriptions[!i] & | | & !this.numbers[!i])
          endif
        else
          !data.append(!this.elements[!i].type & | | & !this.elements[!i].namn & | | & !this.definition.namn & | unset|)
        endif
      endif
    enddo
  endif
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      print
--
-- Description:
--   Print one line status summary for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .print()

  -- Print summary data
  do !line values !this.output()
    write !line
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      outputAll
--
-- Description:
--   Return array of status details for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      Status details as strings
------------------------------------------------------------------------
define method .outputAll() is ARRAY

  -- Format data
  !data = ARRAY()
  if (!this.bulk) then
    do !status values !this.list
      !data.appendArray(!status.outputAll())
    enddo
  else
    -- Refresh if necessary
    if (!this.refreshMode ne |full|) then
      !refreshMode = !this.refreshMode
      !this.refreshMode = |full|
      !this.refresh()
      !this.refreshMode = !refreshMode
    endif
    do !i indices !this.elements
      if (!this.elements[!i].badref().not()) then
        if (!this.values[!i].set()) then
          if (!this.validValues[!i]) then
            !data.append(!this.elements[!i].type & | | & !this.elements[!i].name & | Status | & !this.definition.name & | Value | & !this.valnames[!i])
          else
            !data.append(!this.elements[!i].type & | | & !this.elements[!i].name & | Status | & !this.definition.name & | Invalid Value | & !this.valnames[!i])
          endif
          if (!this.comments[!i].trim() ne || and !this.comments[!i] ne |unset|) then
            !data.append(|Comment | & !this.comments[!i])
          endif
          !data.append(|Modified by | & !this.users[!i] & | | & !this.modifieds[!i])
        else
          !data.append(!this.elements[!i].type & | | & !this.elements[!i].name & | Status | & !this.definition.name & | Value unset|)
        endif
        if (!this.validValues[!i]) then
          if (!this.transitions[!i].size() gt 0) then
            do !j indices !this.transitions[!i]
              !data.append(|(| & !j & |) | & !this.transitions[!i][!j])
            enddo
          endif
        endif
      endif
    enddo
  endif
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      printAll
--
-- Description:
--   Print array of status details for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .printAll()

  -- Print full data
  do !line values !this.outputAll()
    write !line
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      assign
--
-- Description:
--   Assign status definition to object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .assign()

  using namespace 'Aveva.Pdms.DataManagement.PML'

  -- Assign status
  if (!this.bulk) then
    do !status values !this.list
      !status.assign()
    enddo
  else
    !this.status[1].assign(!this.elementNames)
    handle any
      !line = !!error.text
      write !line
    endhandle
    !this.refresh()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      assign
--
-- Description:
--   Assign status definition to object and set comment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Comment for status transition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .assign(!comment is STRING)

  using namespace 'Aveva.Pdms.DataManagement.PML'

  -- Assign status
  if (!this.bulk) then
    do !status values !this.list
      !status.assign(!comment)
    enddo
  else
    !this.status[1].assign(!this.elementNames, !comment)
    handle any
      !line = !!error.text
      write !line
    endhandle
    !this.refresh()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      assignStatus
--
-- Description:
--   Assign status definition to object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Status definition
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .assignStatus(!definition is DBREF)

  -- Assign status
  if (!this.bulk) then
    do !status values !this.list
      !status.assignStatus(!definition)
    enddo
  else
    if (!this.definition eq !definition) then
      !this.assign()
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      assignStatus
--
-- Description:
--   Assign status definition to object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
