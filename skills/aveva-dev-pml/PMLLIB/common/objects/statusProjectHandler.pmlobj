------------------------------------------------------------------------
-- Method:      traceBack
--
-- Description:
--   Output last error (used following core event called methods when traceback is otherwise lost)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .traceBack()

  -- Format traceback for writing to commands view
  !errorText    = !!error.text
  !errorLine    = !!error.line
  !errorCommand = !!error.command
  write !errorText !errorLine !errorCommand
  do !stack values !!error.callstack
    write !stack
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      beforeStatusAssignCallback
--
-- Description:
--   Event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Model object dbref
--   args[1]  R   STRING    Status definition dbref
--   args[2]  R   STRING    Status to value dbref (may be =0/0)
--   args[3]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beforeStatusAssignCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beforeStatusAssign(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod
------------------------------------------------------------------------
define method .beforeStatusAssign(!args is ARRAY)

  -- Trace
  !elementArray = !args[0]
  !statusDefinition = !args[1].dbref().name
  if (!this.debug) then
    do !item values !elementArray
      !element = !item.dbref()
      !output = |statusProjectHandler.beforeStatusAssign(| & !element.flnm & |, | & !statusDefinition & |)|
      write !output
    enddo
  endif

  -- Blank return message means no error
  !returnMessage = ||

  --====================================================================
  -- Start of customisation
  $(
  -- Add actions here for array of objects

  do !item values !elementArray
    !element = !item.dbref()

    -- Add actions here for individual objects

  enddo
  $)
  -- End of customisation
  --====================================================================

  -- Return message
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[3] = !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      afterStatusAssignCallback
--
-- Description:
--   Event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Model object dbref
--   args[1]  R   STRING    Status definition dbref
--   args[2]  R   STRING    Status to value dbref (may be =0/0)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .afterStatusAssignCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.afterStatusAssign(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod
------------------------------------------------------------------------
define method .afterStatusAssign(!args is ARRAY)

  -- Trace
  !elementArray = !args[0]
  !statusDefinition = !args[1].dbref().name
  if (!this.debug) then
    do !item values !elementArray
      !element = !item.dbref()
      !output = |statusProjectHandler.afterStatusAssign(| & !element.flnm & |, | & !statusDefinition & |)|
      write !output
    enddo
  endif

  --====================================================================
  -- Start of customisation
  $(
  -- Add actions here for array of objects

  do !item values !elementArray
    !element = !item.dbref()

    -- Add actions here for individual objects

    -- Example to cascade assembly status to offspring
    if (!statusDefinition eq |/AssemblyStatus|) then
      if (!element.type eq |ASMBLY|) then
        !ownerStatus = object STATUSDATA(!element, !statusDefinition)
        do !member values !element.members
          if (!member.type eq |ASMBLY|) then
            !memberStatus = object STATUSDATA(!member, !statusDefinition)
            !memberStatus.assign(!ownerStatus.comment)
          endif
        enddo
      endif
    endif

  enddo
  $)
  -- End of customisation
  --====================================================================

endmethod

