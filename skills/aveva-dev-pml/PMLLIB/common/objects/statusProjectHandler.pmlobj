------------------------------------------------------------------------
-- Method:      traceChangedElements
--
-- Description:
--   Output lists of elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Status definition dbref
--   args[1]  R   ARRAY     Elements that got status assigned
--   args[2]  R   ARRAY     Elements that got status changed
--   args[3]  R   ARRAY     Elements that got status removed
--   args[4]  RW  STRING    Return message (has no effect for this method)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .traceChangedElements(!args is ARRAY)

  -- Output the lists of elements that got status assigned, changed or removed
  !output = ARRAY()
  !output.append(|Elements that got status assigned|)
  do !element values !args[1]
    !output.append(!element.dbref().flnm)
  enddo
  !output.append(|Elements that got status changed|)
  do !element values !args[2]
    !output.append(!element.dbref().flnm)
  enddo
  !output.append(|Elements that got status removed|)
  do !element values !args[3]
    !output.append(!element.dbref().flnm)
  enddo
  do !line values !output
    write !line
  enddo

endmethod
