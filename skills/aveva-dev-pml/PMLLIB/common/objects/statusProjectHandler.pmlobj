--
-- Description:
-- Status project customisable event handler
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  afterFlush(ARRAY)                -
--  afterFlushCallback(ARRAY)        -                   Event
--  afterSavework(ARRAY)             -
--  afterSaveworkCallback(ARRAY)     -                   Event
--  afterStatusAssign(ARRAY)         -
--  afterStatusAssignCallback(ARRAY) -                   Event
--  afterStatusChange(ARRAY)         -
--  afterStatusChangeCallback(ARRAY) -                   Event
--  afterStatusRemove(ARRAY)         -
--  afterStatusRemoveCallback(ARRAY) -                   Event
--  beforeControlledElementDelete(ARRAY) -
--  beforeControlledElementDeleteCallback(ARRAY) -                   Event
--  beforeFlush(ARRAY)               -
--  beforeFlushCallback(ARRAY)       -                   Event
--  beforeSavework(ARRAY)            -
--  beforeSaveworkCallback(ARRAY)    -                   Event
--  beforeStatusAssign(ARRAY)        -
--  beforeStatusAssignCallback(ARRAY) -                   Event
--  beforeStatusChange(ARRAY)        -
--  beforeStatusChangeCallback(ARRAY) -                   Event
--  beforeStatusRemove(ARRAY)        -
--  beforeStatusRemoveCallback(ARRAY) -                   Event
--  debugOff()                       -                   Clear debug flag
--  debugOn()                        -                   Set debug flag
--  errorStatusAssign(ARRAY)         -
--  errorStatusAssignCallback(ARRAY) -                   Event
--  errorStatusChange(ARRAY)         -
--  errorStatusChangeCallback(ARRAY) -                   Event
--  errorStatusRemove(ARRAY)         -
--  errorStatusRemoveCallback(ARRAY) -                   Event
--  globalInstance()                 -                   Create global instance of object
--  statusProjectHandler()           -                   Constructor
--  traceBack()                      -                   Output last error (used following core event called methods when traceback is otherwise lost)
--  traceChangedElements(ARRAY)      -                   Output lists of elements
--
------------------------------------------------------------------------

define object STATUSPROJECTHANDLER

  member .debug                  is BOOLEAN
  member .statusDefinitions      is ARRAY
  member .pmlStatusEvents        is ARRAY

endobject

------------------------------------------------------------------------
-- Method:      statusProjectHandler
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .statusProjectHandler()

  -- Initialise
  !this.debug = FALSE

  -- Setup global statusProjectHandler
  if (not defined(!!statusProjectHandler)) then
    !this.globalInstance()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  using namespace 'Aveva.Pdms.DataManagement.PML'

  -- Create global variable
  if (not defined(!!statusProjectHandler)) then
    !!statusProjectHandler = !this
  endif

  -- Add event handlers for each status definition only once
  if (!!statusProjectHandler.pmlStatusEvents.empty()) then

    -- Get available status definitions
    !statusManagement = object STATUSMANAGEMENT()
    !statusDefinitions = !statusManagement.statuses()

    do !i indices !statusDefinitions

      -- Store status definition name
      !!statusProjectHandler.statusDefinitions[!i] = !statusDefinitions[!i].name()

      -- Initialise event handler object
      !!statusProjectHandler.pmlStatusEvents[!i] = object STATUSEVENTS()
      !!statusProjectHandler.pmlStatusEvents[!i].initialise(!!statusProjectHandler.statusDefinitions[!i])

      -- Add event handlers
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|BeforeStatusAssign|, !!statusProjectHandler, |beforeStatusAssignCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|AfterStatusAssign|,  !!statusProjectHandler, |afterStatusAssignCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|ErrorStatusAssign|,  !!statusProjectHandler, |errorStatusAssignCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|BeforeStatusRemove|, !!statusProjectHandler, |beforeStatusRemoveCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|AfterStatusRemove|,  !!statusProjectHandler, |afterStatusRemoveCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|ErrorStatusRemove|,  !!statusProjectHandler, |errorStatusRemoveCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|BeforeStatusChange|, !!statusProjectHandler, |beforeStatusChangeCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|AfterStatusChange|,  !!statusProjectHandler, |afterStatusChangeCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|ErrorStatusChange|,  !!statusProjectHandler, |errorStatusChangeCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|BeforeControlledElementDelete|, !!statusProjectHandler, |beforeControlledElementDeleteCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|BeforeSavework|,     !!statusProjectHandler, |beforeSaveworkCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|AfterSavework|,      !!statusProjectHandler, |afterSaveworkCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|BeforeFlush|,        !!statusProjectHandler, |beforeFlushCallback|)
      !!statusProjectHandler.pmlStatusEvents[!i].addEventHandler(|AfterFlush|,         !!statusProjectHandler, |afterFlushCallback|)

    enddo
  endif

endmethod

------------------------------------------------------------------------
-- Method:      debugOn
--
-- Description:
--   Set debug flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .debugOn()

  -- Set debug flag
  !this.debug = TRUE

endmethod

