define method .beforeSavework(!args is ARRAY)

  -- Trace
  !statusDefinition = !args[0].dbref().name
  if (!this.debug) then
    !output = |statusProjectHandler.beforeSavework(| & !statusDefinition & |)|
    write !output
    !this.traceChangedElements(!args)
  endif

  -- Blank return message means no error
  !returnMessage = ||

  --====================================================================
  -- Start of customisation


  -- End of customisation
  --====================================================================

  -- Return message
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[4] = !returnMessage

endmethod

