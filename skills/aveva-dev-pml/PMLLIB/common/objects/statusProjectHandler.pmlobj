------------------------------------------------------------------------
-- Method:      beforeStatusChangeCallback
--
-- Description:
--   Event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Model object dbref
--   args[1]  R   STRING    Status definition dbref
--   args[2]  R   STRING    Status to value dbref
--   args[3]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beforeStatusChangeCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beforeStatusChange(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod
------------------------------------------------------------------------
define method .beforeStatusChange(!args is ARRAY)

  -- Trace
  !elementArray = !args[0]
  !statusRef = !args[1].dbref()
  !statusDefinition = !statusRef.name
  !toValue = !args[2].dbref().name
  if (!this.debug) then
    do !item values !elementArray
      !element = !item.dbref()
      !statusDefinitionArray[1] = !statusRef
      !fromValueArray = !element.attribute(|STVVAL|, !statusDefinitionArray)
      !fromValue = !fromValueArray[1].name
      !output = |statusProjectHandler.beforeStatusChange(| & !element.flnm & |, | & !statusDefinition & |, | & !fromValue & |, | & !toValue & |)|
      write !output
    enddo
  endif

  -- Blank return message means no error
  !returnMessage = ||

  --====================================================================
  -- Start of customisation
  $(
  -- Add actions here for array of objects

  do !item values !elementArray
    !element = !item.dbref()

    -- Add actions here for individual objects

    -- Example: Pipe Design Status may not be set to Preliminary unless linked schematic Line Design Status is Issued For Design
    if (!statusDefinition eq |/PipeDesignStatus|) then
      if (!toValue eq |/Preliminary|) then
        if (!element.schlnk.badref().not()) then
          !status = object STATUSDATA(!element.schlnk, |/LineDesignStatus|)
          if (!status.value.set()) then
            if (!status.valname ne |/IssuedForDesign|) then
              !returnMessage = |Status error: You may not set Pipe Design Status if schematic pipeline has not been Issued For Design|
            endif
          endif
        endif
      endif
    endif

    -- Example: Pipe Construction Status may not be set to Fabricated unless Pipe Design Status is Issued For Construction
    if (!statusDefinition eq |/PipeConstructionStatus|) then
      if (!toValue eq |/Fabricated|) then
        !status = object STATUSDATA(!element, |/PipeDesignStatus|)
        if (!status.value.set()) then
          if (!status.number lt 100) then
            !returnMessage = |Status error: You may not set Pipe Construction Status if pipe has not been Issued For Construction|
          endif
        endif
      endif
    endif

    -- Example: Engineering Tag can not be set to approved before all its distributed data is also approved
    if (!statusDefinition eq |/TagStatus|) then
      if (!toValue eq |/TagApproved|) then
        !xrList = !element.xrList
        handle any
          -- No bound data
        elsehandle none
          do !listItem values !xrList
            !status = object STATUSDATA(!listItem, |/TagAttStatus|)
            if (!status.value.unset()) then
              !returnMessage = |Status error: You may not Approve the tag unless all the attribute data is also Approved|
            elseif (!status.valname ne |/Approved|) then
              !returnMessage = |Status error: You may not Approve the tag unless all the attribute data is also Approved|
            endif
          enddo
        endhandle
        do !member values !element.members
          !status = object STATUSDATA(!member, |/TagStatus|)
          if (!status.value.unset()) then
            !returnMessage = |Status error: You may not Approve the tag unless all the member data is also Approved|
          elseif (!status.valname ne |/Approved|) then
            !returnMessage = |Status error: You may not Approve the tag unless all the member data is also Approved|
          endif
        enddo
      endif
    endif

  enddo
  $)
  -- End of customisation
  --====================================================================

  -- Return message
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[3] = !returnMessage

endmethod

------------------------------------------------------------------------
-- Method:      afterStatusChangeCallback
--
-- Description:
--   Event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Model object dbref
--   args[1]  R   STRING    Status definition dbref
--   args[2]  R   STRING    Status to value dbref
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .afterStatusChangeCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.afterStatusChange(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod
------------------------------------------------------------------------
define method .afterStatusChange(!args is ARRAY)

  -- Trace
  !elementArray = !args[0]
  !statusRef = !args[1].dbref()
  !statusDefinition = !statusRef.name
  !toValue = !args[2].dbref().name
  if (!this.debug) then
    do !item values !elementArray
      !element = !item.dbref()
      !statusDefinitionArray[1] = !statusRef
      !fromValueArray = !element.attribute(|STVVAL|, !statusDefinitionArray)
      !fromValue = !fromValueArray[1].name
      !output = |statusProjectHandler.afterStatusChange(| & !element.flnm & |, | & !statusDefinition & |, | & !fromValue & |, | & !toValue & |)|
      write !output
    enddo
  endif

  --====================================================================
  -- Start of customisation
  $(
  -- Add actions here for array of objects

  do !item values !elementArray
    !element = !item.dbref()

    -- Add actions here for individual objects

    -- Example to cascade assembly status to offspring
    if (!statusDefinition eq |/AssemblyStatus|) then
      if (!element.type eq |ASMBLY|) then
        !ownerStatus = object STATUSDATA(!element, !statusDefinition)
        do !member values !element.members
          if (!member.type eq |ASMBLY|) then
            !memberStatus = object STATUSDATA(!member, !statusDefinition)
            !memberStatus.set(!toValue, !ownerStatus.comment)
          endif
        enddo
      endif
    endif

  enddo
  $)
  -- End of customisation
  --====================================================================

endmethod

------------------------------------------------------------------------
-- Method:      errorStatusChangeCallback
--
-- Description:
--   Event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Model object dbref
--   args[1]  R   STRING    Status definition dbref
--   args[2]  R   STRING    Status to value dbref
--   args[3]  R   STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .errorStatusChangeCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.errorStatusChange(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod
------------------------------------------------------------------------
define method .errorStatusChange(!args is ARRAY)

  -- Trace
  !elementArray = !args[0]
  !statusDefinition = !args[1].dbref()
  !errorMessage = !args[3]
  !toValue = !args[2].dbref()
  if (!toValue.badref()) then
    !toName = ||
  else
    !toName = !toValue.name
  endif
  if (!this.debug) then
    do !item values !elementArray
      !element = !item.dbref()
      !statusDefinitionArray[1] = !statusDefinition
      !fromValue = !element.attribute(|STVVAL|, !statusDefinitionArray)
      !output = |statusProjectHandler.errorStatusChange(| & !element.flnm & |, | & !statusDefinition.name & |, | & !fromValue[1].name & |, | & !toName & |) | & !errorMessage
      write !output
    enddo
  endif

  --====================================================================
  -- Start of customisation
  $(
  -- Add actions here for array of objects

  do !item values !elementArray
    !element = !item.dbref()

    -- Add actions here for individual objects

  enddo
  $)
  -- End of customisation
  --====================================================================

endmethod

------------------------------------------------------------------------
-- Method:      beforeControlledElementDeleteCallback
--
-- Description:
--   Event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   args[0]  R   STRING    Model object dbref
--   args[1]  R   STRING    Status definition dbref
--   args[2]  R   STRING    Status to value dbref (may be =0/0)
--   args[3]  RW  STRING    Return message
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .beforeControlledElementDeleteCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beforeControlledElementDelete(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod
------------------------------------------------------------------------
define method .beforeControlledElementDelete(!args is ARRAY)

  -- Trace
  !elementArray = !args[0]
  !statusDefinition = !args[1].dbref().name
  if (!this.debug) then
    do !item values !elementArray
      !element = !item.dbref()
      !output = |statusProjectHandler.beforeControlledElementDelete(| & !element.flnm & |, | & !statusDefinition & |)|
      write !output
    enddo
  endif

  -- Blank return message means no error
  !returnMessage = ||

  --====================================================================
  -- Start of customisation

  -- Prevent general user deleting a controlled object - comment this block out if you do not want this control
  var !user USER
  !currentUser = object USER(!user)
  if (!currentUser.access.upcase() ne 'FREE') then
    !returnMessage = |Status error: You may not delete a controlled object|
  endif

  -- End of customisation
  --====================================================================

  -- Return message
  if (!this.debug and !returnMessage.trim() ne ||) then
    write !returnMessage
  endif
  !args[3] = !returnMessage

endmethod

