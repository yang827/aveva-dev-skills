-- Define object
define object STORE

  -- Storage Name (unique)
  member .name            is STRING
  -- Group generic group storage area is associated with
  member .group           is STRING
  -- Title
  member .title           is STRING
  -- PDMS Element type rule is associated with
  member .elementType     is STRING
  -- Rule to determine the storage area
  member .autoSelectRule  is STRING
  -- Generic element types the store can be stored beneath
  -- MUST be in order of preference (SBFR FRMW ....)
  member .owningTypes     is ARRAY
  -- User modifiable storage area
  member .fileType        is STRING

  -- The following members are set/used by the Appware
  -- Database Reference where item is to be stored
  member .store           is DBREF
  -- Group Number
  member .groupNumber     is REAL
  -- Area Number
  member .areaNumber      is REAL
  -- List of gadgets that need to be updated for the area
  member .gadgets         is ARRAY
  -- List of callbacks that need to be run for the area
  member .callbacks       is ARRAY

endobject
-- End of object definition for STORE
