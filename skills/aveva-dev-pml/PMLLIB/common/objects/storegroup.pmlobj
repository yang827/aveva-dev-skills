-- Define object
define object STOREGROUP

  -- Storage Name (unique)
  member .name     is STRING

  -- Title
  member .title       is STRING
  -- User modifiable storage area
  member .fileType    is STRING

  -- The following members are set/used by the Appware
  -- Permissible Storage areas for groups
  member .areas       is ARRAY
  -- List of gadgets that need to be updated for the group
  member .gadgets     is ARRAY
  -- Group Number
  member .groupNumber is REAL
endobject
-- End of object definition for STOREGROUP
