--
-- Description:     container for subsetting data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  string()                         STRING              print out purpose and description
--
define object SUBSETTING

  -- purpose
  member .purpose is STRING

  -- contains all setting data
  member .settingData is ARRAY

endobject
-- End of object definition for SubSetting

---------------------------------------------------------------------------
--Method:       string()
--
--Description:  print out purpose and description
--
--Method Type:  Function
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
--Return:
--             [Data Type] [Description]
--              STRING      object purpose and description
---------------------------------------------------------------------------

define method .string() is STRING

  !purp = !this.purpose
  if !purp.unset() then
     !purp = 'Unset'
  endif

  return !purp

endmethod
-- end of method
