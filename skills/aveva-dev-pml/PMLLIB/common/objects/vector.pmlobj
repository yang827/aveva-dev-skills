-- Description:
-- Basic Vector object of 3D Geometry Calculator.
--    This object when we have methods should have two methods:
--      Return the vector as a line definition LINE <dir> THROUGH <POS>
--      Return the vector as a plane definition PLANE <dir> THROUGH <POS>
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define object
define object VECTOR

  -- Direction
  member .direction is DIRECTION
  -- Position
  member .position  is POSITION

endobject
-- End of object definition for VECTOR
