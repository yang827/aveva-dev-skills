--
--
-- Description:
-- Volume definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  box()                            GMFBOX              Returns box definition of volume
--  cable(DBREF)                     -                   Sets from and to positions for volume of cable
--  volume(ARRAY)                    -                   Constructor, using array of passed dbref's
--  volume(DBREF)                    -                   Constructor, using passed dbref
--  volume(GADGET)                   -                   Constructor, using passed view gadget
--  volume(GMFBOX)                   -                   Constructor, using passed GMFBOX
--  volume(POSITION,POSITION)        -                   Constructor, using passed positions (from, to)
--  volume(STRING)                   -                   Constructor, using passed string (a returned from q volume)
--
------------------------------------------------------------------------

-- Define object
define object VOLUME

  -- From position
  member .from is POSITION
  -- To position
  member .to   is POSITION

endobject
-- End of object definition for VOLUME

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Constructor, using passed dbref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume(!item is DBREF)

  -- Initialise as unset
  !this.from = object POSITION()
  !this.to   = object POSITION()

  -- Get Volume of item
  !worldVolume = !item.wvol
  handle any
    return
  endhandle

  -- Cables are not in the spatial map so have to use their coordinates
  !cable = FALSE
  if (!item.type eq 'CABLE') then
    !this.cable(!item)
    !cable = TRUE
  elseif (!item.type inset('SITE', 'ZONE')) then
    var !cables collect all cable for $!item
    if (!cables.size() gt 0) then
      -- Use the list method to process each cable
      !this.volume(!item.members)
      !cable = TRUE
    endif
  endif

  -- Allow for unset wvol, e.g. on empty TMPW or EQUI with no members
  if (!worldVolume.set() and !cable.not()) then
    !this.from = object POSITION('E ' & !worldVolume[1] & ' N ' & !worldVolume[2]& ' U ' & !worldVolume[3])
    !this.to   = object POSITION('E ' & !worldVolume[4] & ' N ' & !worldVolume[5]& ' U ' & !worldVolume[6])
  endif

endmethod
-- End of method definition for .volume(DBREF)

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Constructor, using passed string (a returned from q volume)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Volume as returned from Q VOLUME <gid>
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume(!string is STRING)

  -- Initialise Variables
  !this.from = !string.upcase().before('TO').position()
  !this.to   = !string.upcase().after('TO').position()

endmethod
-- End of method definition for .volume(STRING)

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Constructor, using passed positions (from, to)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    2   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume(!from is POSITION, !to is POSITION)

  -- Initialise Variables
  !this.from = !from
  !this.to   = !to

endmethod
-- End of method definition for .volume(POSITION, POSITION)

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Constructor, using passed GMFBOX
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFBOX      Box object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume(!box is GMFBOX)

  -- Initialise Variables
  !this.from       = !box.position
  !this.from.east  = !this.from.east  - !box.xLength / 2
  !this.from.north = !this.from.north - !box.yLength / 2
  !this.from.up    = !this.from.up    - !box.zLength / 2
  !this.to         = !box.position
  !this.to.east    = !this.to.east    + !box.xLength / 2
  !this.to.north   = !this.to.north   + !box.yLength / 2
  !this.to.up      = !this.to.up      + !box.zLength / 2

endmethod
-- End of method definition for .volume(GMFBOX)

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Constructor, using passed view gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume(!view is GADGET)

  -- Get limits
  !limits = !view.limits

  -- Initialise Variables
  !this.from       = object POSITION('N0')
  !this.from.east  = $!limits[1]mm
  !this.from.north = $!limits[3]mm
  !this.from.up    = $!limits[5]mm
  !this.to         = object POSITION('N0')
  !this.to.east    = $!limits[2]mm
  !this.to.north   = $!limits[4]mm
  !this.to.up      = $!limits[6]mm
--   !this.from       = object POSITION('N0')
--   !this.from.east  = !limits[1]
--   !this.from.north = !limits[3]
--   !this.from.up    = !limits[5]
--   !this.to         = object POSITION('N0')
--   !this.to.east    = !limits[2]
--   !this.to.north   = !limits[4]
--   !this.to.up      = !limits[6]

endmethod
-- End of method definition for .volume(GADGET)

------------------------------------------------------------------------
--
-- Method:      volume
--
-- Description: Constructor, using array of passed dbref's
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       list of DBREFs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .volume(!list is ARRAY)

  -- Initialise Variables
  !eastings   = ARRAY()
  !northings  = ARRAY()
  !elevations = ARRAY()

  -- Get each of the component from the volume and find the max/min
  do !i indices !list
    !volume  = object VOLUME(!list[!i])
    skip if(!volume.unset())

    -- Load positions into xyz array
    !eastings.append(!volume.from.east)
    !eastings.append(!volume.to.east)
    !northings.append(!volume.from.north)
    !northings.append(!volume.to.north)
    !elevations.append(!volume.from.up)
    !elevations.append(!volume.to.up)

  enddo

  -- If there are no element in the array, then set volume to unset
  if(!eastings.empty()) then
    !this.from = object POSITION()
    !this.to   = object POSITION()
    return
  endif

  -- Sort into order
  !eastings.sort()
  !northings.sort()
  !elevations.sort()

  -- Assign max/min values to volume
  !this.from        = object POSITION('N0')
  !this.from.east   = !eastings[1]
  !this.from.north  = !northings[1]
  !this.from.up     = !elevations[1]
  !this.to          = object POSITION('N0')
  !this.to.east     = !eastings[!eastings.size()]
  !this.to.north    = !northings[!northings.size()]
  !this.to.up       = !elevations[!elevations.size()]

endmethod
-- End of method definition for .volume(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      box
--
-- Description: Returns box definition of volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .box() is GMFBOX

  -- Initialise Variables
  !return             = object GMFBOX()

  -- Orientation of box
  !return.orientation = object ORIENTATION('Y is N')

  -- Position
  !return.position    = !this.from.midPoint(!this.to)

  -- Calculate XYZ lengths
  !return.xLength     = ABS(!this.from.east  - !this.to.east)
  !return.yLength     = ABS(!this.from.north - !this.to.north)
  !return.zLength     = ABS(!this.from.up    - !this.to.up)

  return !return

endmethod
-- End of method definition for .box() GMFBOX

-----------------------------------------------------------------------
--
-- Method:      cable
--
-- Description: Sets from and to positions for volume of cable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cable(!item is DBREF)

  -- Cables are not in the spatial map so have to use their coordinates
  !positions = ARRAY()
  !worldName = '/*'
  !world = !worldName.dbref()

  -- Get start and end positions in case connected but not routed
  !positions.append(!item.staref.position.wrt(!world))
  handle any
  endhandle
  !positions.append(!item.endref.position.wrt(!world))
  handle any
  endhandle

  -- Get routing points
  var !elements collect all pointr for $!item
  do !ele values !elements
    !positions.append(!ele.dbref().position.wrt(!world))
    handle any
    endhandle
  enddo

  -- Get external geometry points
  var !elements collect all extgeo for $!item
  do !ele values !elements
    !positions.append(!ele.dbref().staref.position.wrt(!world))
    handle any
    endhandle
    !positions.append(!ele.dbref().endref.position.wrt(!world))
    handle any
    endhandle
  enddo

  -- If there are no positions then set volume to unset
  if (!positions.empty()) then
    !this.from = object POSITION()
    !this.to   = object POSITION()
    return
  endif

  -- Calculate limits
  !eastings   = ARRAY()
  !northings  = ARRAY()
  !elevations = ARRAY()

  -- Get each position and find the max/min
  do !pos values !positions
    skip if (!pos.unset())
    !eastings.append(!pos.east)
    !northings.append(!pos.north)
    !elevations.append(!pos.up)
  enddo

  -- Sort into order
  !eastings.sort()
  !northings.sort()
  !elevations.sort()

  -- Assign max/min values to volume
  !this.from        = object POSITION('N0')
  !this.from.east   = !eastings[1]
  !this.from.north  = !northings[1]
  !this.from.up     = !elevations[1]
  !this.to          = object POSITION('N0')
  !this.to.east     = !eastings[!eastings.size()]
  !this.to.north    = !northings[!northings.size()]
  !this.to.up       = !elevations[!elevations.size()]

endmethod
-- End of method definition for .cable(DBREF)
