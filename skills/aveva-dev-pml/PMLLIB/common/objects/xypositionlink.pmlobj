--
--
-- Description:
--   Standard XY Positioning Linkage object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(BOOLEAN)                  -                   Grey/un-grey all linked gadgets, maintain greying on locked gadgets
--  initialise()                     -                   Initialisation
--  linkInput(STRING,GADGET,GADGET)  -                   Link input gadgets
--  linkLock(STRING,GADGET,GADGET)   -                   Link input gadgets
--  linkOption(STRING,GADGET,GADGET,STRING) -
--  newInput(GADGET,STRING)          -                   Update position with input data
--  runAction()                      -                   Run Action command
--  setAction(STRING)                -                   set Tag
--  setLock(GADGET,STRING)           -                   Set lock on relevant gadgets
--  unlockAll()                      -
--  xyPosition()                     XYPOSITION          Get current xyPosition
--  xyPosition(XYPOSITION)           -                   Set position
--  xyPosition(XYPOSITION,BOOLEAN,BOOLEAN) -
--
------------------------------------------------------------------------

-- Define object
define object XYPOSITIONLINK

  -- Position
  member .xyPosition is XYPOSITION

  -- All gadget are stored in an ARRAY X = [1], Y = [2]
  -- XY text input fields
  member .input      is ARRAY
  -- XY lock toggles
  member .lock       is ARRAY
  -- XY Options
  member .option     is ARRAY

  -- Function/Method to be actioned (what do we do with the position data)
  member .action     is STRING

endobject
-- End of object definition for XYPOSITIONLINK

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--  Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Set default position
  !this.xyPosition = object XYPOSITION(0,0)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      linkInput
--
-- Description:
--   Link input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      positionLink object name, being linked to
--    2   R      GADGET      X input gadget
--    3   R      GADGET      Y input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkInput(!object is STRING, !xInput is GADGET, !yInput is GADGET)

  -- Set callback on input gadget
  if(!xInput.set()) then
    !this.input[1]   = !xInput
    if(!xInput.type() eq 'TEXT') then
      !xInput.callback = !object & '.newInput('
    endif
  endif

  if(!yInput.set()) then
    !this.input[2]   = !yInput
    if(!yInput.type() eq 'TEXT') then
      !yInput.callback = !object & '.newInput('
    endif
  endif

  -- Set initial object
  !this.initialise()

endmethod
-- End of method definition for .linkInput(STRING, GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      linkLock
--
-- Description:
--   Link input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      positionLink object name, being linked to
--    2   R      GADGET      X input gadget
--    3   R      GADGET      Y input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkLock(!object is STRING, !xLock is GADGET, !yLock is GADGET)

  -- Set links
  -- Set callback on lock gadget
  if(!xLock.set()) then
    !this.lock[1]   = !xLock
    !xLock.callback = !object & '.setLock('
  endif
  if(!yLock.set()) then
    !this.lock[2]   = !yLock
    !yLock.callback = !object & '.setLock('
  endif

endmethod
-- End of method definition for .linkLock(STRING, GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      linkLock
--
-- Description:
--   Link option gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      positionLink object name, being linked to
--    2   R      GADGET      X input gadget
--    3   R      GADGET      Y input gadget
--    4   R      STRING      Type of Option EN or XY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .linkOption(!object is STRING, !xOpt is GADGET, !yOpt is GADGET, !type is STRING)

  -- Set links
  -- Set callback on option gadget
  if(!xOpt.set()) then
    !this.option[1]   = !xOpt
    !xOpt.callback = !object & '.newInput('
  endif

  if(!yOpt.set()) then
    !this.option[2]   = !yOpt
    !yOpt.callback = !object & '.newInput('
  endif

 -- Define Options
  !rText[1] = '1'
  !rText[2] = '-1'

  -- East, North
  if(!type.upcase() eq 'EN') then
    -- East/West
    if(defined(!this.option[1])) then
      !dText[1] = 'East'
      !dText[2] = 'West'
      !xOpt.dText = !dText
      !xOpt.rText = !rText
    endif

    -- North/South
    if(defined(!this.option[2])) then
      !dText[1] = 'North'
      !dText[2] = 'South'
      !yOpt.dText = !dText
      !yOpt.rText = !rText
    endif

  -- X, Y
  else
    -- East/West
    if(defined(!this.option[1])) then
      !dText[1] = 'X'
      !dText[2] = '-X'
      !xOpt.dText = !dText
      !xOpt.rText = !rText
    endif

    -- North/South
    if(defined(!this.option[2])) then
      !dText[1] = 'Y'
      !dText[2] = '-Y'
      !yOpt.dText = !dText
      !yOpt.rText = !rText
    endif

  endif

endmethod
-- End of method definition for .linkOption(STRING, GADGET, GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description:
--   Run Action command
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .runAction()

  -- Execute action (may need a better way to execute method/functions)
  $!this.action

endmethod
-- End of method definition for .runAction()

------------------------------------------------------------------------
--
-- Method:      setAction
--
-- Description:
--   set Tag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Tag Method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setAction(!method is STRING)

  -- Check that a correct method/function has been passed

  -- Tag method
  !this.action = !method

endmethod
-- End of method definition for .setAction(STRING)

------------------------------------------------------------------------
--
-- Method:      xyPosition
--
-- Description:
--   Get current position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    XYPOSITION  Returns the current xyPosition for the object
--
------------------------------------------------------------------------

-- Define method
define method .xyPosition() is XYPOSITION

  -- Return current position
  return !this.xyPosition

endmethod
-- End of method definition for .xyPosition() XYPOSITION

------------------------------------------------------------------------
--
-- Method:      xyPosition
--
-- Description:
--   Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  New Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .xyPosition(!newPosition is XYPOSITION)

  -- Set position
  !this.xyPosition(!newPosition, true, false)

endmethod
-- End of method definition for .xyPosition(XYPOSITION)

------------------------------------------------------------------------
--
-- Method:      setPositionNoAct
--
-- Description:
--   Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  New Position
--    2   R      BOOLEAN     Run action
--    3   R      BOOLEAN     Force result
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .xyPosition(!newPosition is XYPOSITION, !action is BOOLEAN, !force is BOOLEAN)

  -- Set position
  !tempPosition = !newPosition

  -- Set gadgets

  -- East/West
  if(!this.input[1].active or !force) then
    if(defined(!this.option[1])) then
      if(!tempPosition.x lt 0) then
        !this.option[1].select('RTEXT', '-1')
      else
        !this.option[1].select('RTEXT', '1')
      endif

      !value = !tempPosition.x.abs()
    else
      !value = !tempPosition.x
    endif

    -- Assign to gadget
    !this.input[1].val = !value
    handle any
      !this.input[1].val = !value.string()
    endhandle

    -- Set New Easting
    !this.xyPosition.x = !tempPosition.x

  endif

  -- North/South
  if(!this.input[2].active or !force) then
    if(defined(!this.option[2])) then
      if(!tempPosition.y lt 0) then
        !this.option[2].select('RTEXT', '-1')
      else
        !this.option[2].select('RTEXT', '1')
      endif
      !value = !tempPosition.y.abs()
    else
      !value = !tempPosition.y
    endif

    -- Assign to gadget
    !this.input[2].val = !value
    handle any
      !this.input[2].val = !value.string()
    endhandle

    -- Set New Northing
    !this.xyPosition.y = !tempPosition.y

  endif

  -- Run action command
  if(!action) then
    !this.runAction()
  endif

endmethod
-- End of method definition for .xyPosition(XYPOSITION, BOOLEAN, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      newInput
--
-- Description:
--   Update position with input data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
--- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .newInput(!gadget is GADGET, !selected is STRING)

  -- Initialise Variables
  !cardinal[1] = 'X'
  !cardinal[2] = 'Y'

  -- Text input gadget set
  if(!gadget.type() eq 'TEXT') then
    !index = !this.input.findFirst(!gadget)
    -- don't do anything if there is no change
    if(!this.xyPosition.attribute(!cardinal[!index]) eq !gadget.val.real()) then
      return
    endif

    -- Check for unset gadget
    if( !gadget.datatype eq 'REAL' and !gadget.val.unset() ) then
      !gadget.val = 0
    endif

  -- Option gadget
  elseif (!gadget.type() eq 'LIST') then
  	
  	-- Ignore unselect events
    if (!selected eq |UNSELECT|) then
     return
    endif
    !index = !this.option.findFirst(!gadget)

    -- don't do anything if there is no change
    if(!this.xyPosition.attribute(!cardinal[!index]) lt 0 and !gadget.selection().real() lt 0) then
      return
    endif
  endif

  -- Update the appropriate gadgets
  if(defined(!this.option[!index])) then
    !this.xyPosition.attribute(!cardinal[!index]) = !this.option[!index].selection().real() * !this.input[!index].val
    handle any
      if (!this.input[!index].val.unset()) then
        !this.input[!index].val = 0
      endif
      !this.xyPosition.attribute(!cardinal[!index]) = !this.option[!index].selection().real() * !this.input[!index].val.real()
    endhandle
  else
    !this.xyPosition.attribute(!cardinal[!index]) = !this.input[!index].val
  endif

  -- Run action command
  !this.runAction()

endmethod
-- End of method definition for .newInput(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      setLock
--
-- Description:
--   Set lock on relevant gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setLock(!gadget is GADGET, !selected is STRING)

  -- Determine the set of gadgets to grey/un-grey
  !index = !this.lock.findFirst(!gadget)

  -- Grey out gadgets
  if(!selected eq 'SELECT') then

    -- Grey out option, if defined
    if(defined(!this.option[!index])) then
      !this.option[!index].active = false
    endif

    -- Grey out input, if defined
    !this.input[!index].active = false

    -- Un-grey gadgets
  else

    -- Un-grey out option, if defined
    if(defined(!this.option[!index])) then
      !this.option[!index].active = true
    endif

    -- Un-grey input, if defined
    !this.input[!index].active = true

  endif

endmethod
-- End of method definition for .setLock(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      unLockAll
--
-- Description:
--   Unlock all gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .unlockAll()

  -- Unlock all gadgets
  do !i from 1 to 2

    -- Un-grey input gadget
    !this.input[!i].active    = true

    -- unselect lock gadget
    if(defined(!this.lock[!i])) then
      !this.lock[!i].val      = false
    endif

    -- Un-grey option gadget
    if(defined(!this.option[!i])) then
      !this.option[!i].active = true
    endif

  enddo

endmethod
-- End of method definition for .unlockAll()

------------------------------------------------------------------------
--
-- Method:      active
--
-- Description:
--   Grey/un-grey all linked gadgets, maintain greying on locked gadgets
--   when associated gadgets are made active
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Wrt element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .active(!flag is BOOLEAN)

  -- Grey-out all Gadgets
  if(!flag.not()) then
    do !i indices !this.lock
      !this.lock[!i].active   = false
    enddo
    do !i indices !this.input
      !this.input[!i].active  = false
    enddo
    do !i indices !this.option
      !this.option[!i].active = false
    enddo

  -- Un-grey all gadgets
  else

    do !i indices !this.lock
      !this.lock[!i].active   = true
    enddo
    do !i indices !this.input
      if(defined(!this.lock[!i])) then
        skip if(!this.lock[!i].val)
      endif
      !this.input[!i].active  = true
    enddo

    do !i indices !this.option
      if(defined(!this.lock[!i])) then
        skip if(!this.lock[!i].val)
      endif
      !this.option[!i].active  = true
    enddo

  endif

endmethod
-- End of method definition for .active(BOOLEAN)
