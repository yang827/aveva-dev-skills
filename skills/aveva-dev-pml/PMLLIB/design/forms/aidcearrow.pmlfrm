-- File:            aidcearrow.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          S.Karthigeyan
--  Created:         Wed Dec  3 13:57:26 2008
--
-- Description:     Form for Aid Arrow display
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidceArrow()                     -                   constructor
--  apply()                          -                   callback for apply button
--  ceArrow()                        -                   callback for CE Arrow On/Off toggle
--  init()                           -                   initialisation
--
------------------------------------------------------------------------
setup form !!aidceArrow

   !!aidceArrow.formTitle     = 'Aid CE Arrow'
   !!aidceArrow.iconTitle     = 'CE Arrow'
   !!aidceArrow.callback      = '!!aidceArrow.init()'
   !!aidceArrow.formRevision  = ' $Revision: 1.7 $ '

   -- Create a format for the proportion to be to 2 decimal places
   !!aidArrowProportionFormat = object FORMAT()
   !!aidArrowProportionFormat.dp = 2

   --Hold ce Arrow ON/OFF state
   member .ceArrowStat is BOOLEAN
   --Hold ce Arrow height value (always stored in millimetres)
   member .ceArrowHeight is REAL
   --Hold ce Arrow proportion
   member .ceArrowProp is REAL
   --Hold ce Arrow position
   member .ceArrowPos is STRING

   frame .fmeceArrow 'Aid CE Arrow' at xMin yMin
      path down
      halign left
      vdist 0

      toggle .tglCeArrow 'Visible'
      text .txtHeight 'Height     ' width 14 is REAL format !!distanceFmt
      text .txtProportion  'Proportion ' width 14 is REAL format !!aidArrowProportionFormat
      option .optPosition 'Position   ' width 10
   exit
exit
-- End of form definition for !!aidceArrow
------------------------------------------------------------------------
--
-- Method:      !aidceArrow()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .aidceArrow()

   --Populate option gadget with allowed arrow position
   !optArray[1] = 'Origin'
   !optArray[2] = 'Arrive'
   !optArray[3] = 'Leave'
   !this.optPosition.dText = !optArray

   --Set default values to the members
   !this.ceArrowStat = false
   !this.ceArrowHeight = 100mm
   !this.ceArrowProp = 0.2
   !this.ceArrowPos = 'Origin'

   -- Define callbacks
   !this.tglCeArrow.callback = '!this.ceArrow()'
   !this.txtHeight.callback = '!this.apply()'
   !this.txtProportion.callback = '!this.apply()'
   !this.optPosition.callback = '!this.apply()'

endmethod
-- End of method definition for .aidceArrow()
------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .init()

   --Assign member value to gadget
   !this.tglCeArrow.val= !this.ceArrowStat
   !this.ceArrow()

   --Assign member values to gadgets
   !this.txtHeight.val     = !this.ceArrowHeight
   !this.txtProportion.val = !this.ceArrowProp
   !this.optPosition.select('RTEXT',!this.ceArrowPos)

   -- Run the Apply just because if form is ever killed then aid axis could still retain old values
   !this.apply()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      !ceArrow()
--
-- Description: callback for CE Arrow On/Off toggle
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ceArrow()

   --Using ce Arrow toggle state to grey out ce Arrow settings
   !this.ceArrowStat = !this.tglCeArrow.val
   !stat = !this.ceArrowStat
   !this.txtHeight.active = !stat
   !this.txtProportion.active = !stat
   !this.optPosition.active = !stat

   --Enable aid ce Arrow according to the toggle
   if (!stat) then
      AID CEARROW ON
   else
      AID CEARROW OFF
   endif

endmethod
-- End of method definition for .ceArrow()
------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: callback for apply button
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .apply()

   -- If no values set, default values will be used
   !this.ceArrowPos = !this.optPosition.selection()
   if (!this.txtHeight.val.set()) then
      !this.ceArrowHeight = !this.txtHeight.val
   endif
   if (!this.txtProportion.val.set()) then
      !this.ceArrowProp = !this.txtProportion.val
   endif
   -- Prevent zero proportion
   if (!this.ceArrowProp.between(0.01,1)) then
   	--OK
   else
     !this.ceArrowProp = 0.2
     !this.txtProportion.val = 0.2
   endif

   -- Do the actual PDMS command
   AID CEARROW HEIGHT $!<this.ceArrowHeight> PROPORTION $!<this.ceArrowProp> $!<this.ceArrowPos>

endmethod
-- End of method definition for .apply()
