--
--
-- Description:
-- Form for Aid Mirroring
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidCopyMirror()                  -                   Constructor
--  append()                         -                   Append picked aid graphics to the list
--  apply()                          -                   Apply copies/move
--  clear()                          -                   Clear aid list down
--  close()                          -                   Close form down
--  direction()                      -                   Set direction
--  direction(DIRECTION)             -                   Setup to direction of offset
--  display(EDGPICKDATA)             -                   Set form to passed element and tag graphics
--  draw()                           -                   Draw changes
--  drawPlane()                      -                   Draw plane
--  escape()                         -                   Escape from the edg event
--  initialise()                     -                   Initialisation form
--  mirrorPlane()                    -                   Packet for picking mirror plane
--  mirrorPlane(PLANE)               -                   Define rotation line
--  mirrorPoint()                    -                   Packet for picking mirror point
--  mirrorPoint(POSITION)            -                   Set mirror plane position
--  option()                         -                   Set up form for Copy option or Move option
--  option(STRING)                   -                   Set up form for Copy option or Move option
--  position()                       -                   Set position
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setup()                          -                   Setup form gadgets
--  tidy()                           -                   Tidy graphics
--  wrt()                            -                   Set up with new wrt item
--

-- Set up form
setup form !!aidCopyMirror

  !this.formTitle     = 'Aid Copy/Move Mirror'
  !this.iconTitle     = 'Aid Mirror'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.14 $ '

  path right

  -- Aid graphics
  frame .graphicFrame 'Graphic Aids' at xmin form ymax width 32

    button .append 'Pick'        at x1          ymax tooltip 'Pick graphical aids to append to the list' callback '!this.append()'
    button .clear  'Clear'                           tooltip 'Clear all graphical aids from the list'    callback '!this.clear()'

    -- Paragraph
    paragraph .aidText           at xmax+1      ymin text 'Selected : '
    paragraph .aidCount          at xmax        ymin text '000'

  exit

  -- Information from
  frame .informationFrame 'Settings' at xmin ymax+0.25 width 32

    -- Body of form definition
    option .option 'Option ' at x2     ymax          tooltip 'Action to be performed on graphical aids'  callback '!this.option()' width 4

  exit

  -- Distances
  frame .planeFrame 'Mirror Plane'   at xmin ymax+0.25

    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax
      button .mirrorPoint     at x1 ymax pixmap width 16 height 16 tooltip 'Pick position of mirror plane' callback '!this.mirrorPoint()'
      button .mirrorPlane                pixmap width 16 height 16 tooltip 'Pick mirror plane'             callback '!this.mirrorPlane()'

      path down
      halign right
      option .ew          at x1     ymax+0.2 width 5
      option .ns                             width 5
      option .ud                             width 5
      text   .x           at xmax+1 ymin.ew  width 14 is REAL format !!distanceFmt
      text   .y           at xmin   ymin.ns  width 14 is REAL format !!distanceFmt
      text   .z           at xmin   ymin.ud  width 14 is REAL format !!distanceFmt


      toggle .xFlag at xmax.x+1     ymin.ew
      toggle .yFlag at xmin         ymin.ns
      toggle .zFlag at xmin         ymin.ud
      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

    exit

    vdist 0.5
    text .direction  'Direction ' callback '!this.direction()'     width 18 is STRING
    vdist 0
    text .wrt        'wrt '       callback '!this.wrt()'           width 25 is STRING

  exit

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax+0.25 callback '!this.close()' ok
  -- Apply
  button .apply 'Apply' at xmin form-0 ymin callback '!this.apply()'

  -- Form Members

  -- Aid modification object
  member .modify           is AIDMODIFY

  -- Position
  member .position         is POSITIONLINK

  -- Wrt element
  member .wrtElement       is DBREF

  -- EDG Active
  member .edgActive        is BOOLEAN

  -- EDG Description
  member .edgDescription   is STRING

  -- Aid Number
  member .aidPlane         is REAL
  member .aidNumber        is REAL

exit
-- End of form definition for !!aidCopyMirror

------------------------------------------------------------------------
--
-- Method:      aidCopyMirror
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .aidCopyMirror()

  -- Initial rotation angle
  !dtext[1]           = 'Copy'
  !rtext[1]           = 'COPY'
  !dtext[2]           = 'Move'
  !rtext[2]           = 'MOVE'
  !this.option.dtext  = !dtext
  !this.option.rtext  = !rtext

  -- Setup the mirror plane
  !this.modify.mirrorPlane(object PLANE(N0, Z is E))

  -- Defaults
  !this.aidCount.val  = !this.modify.aidList.size().string()

  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!aidCopyMirror.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!aidCopyMirror.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!aidCopyMirror.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!aidCopyMirror.position()')

  -- Set defaults for form
  !this.position.position(!this.modify.mirrorPlane.position, false, true)

  !this.direction.val = !this.modify.mirrorPlane.direction().string().before('WRT').trim()
  !this.wrtElement    = !this.modify.mirrorPlane.position.origin
  !this.wrt.val       = !this.wrtElement.flnm

  -- Icons
  !this.mirrorPoint.addPixmap(!!pml.getPathName('navigate16.png'))
  !this.mirrorPlane.addPixmap(!!pml.getPathName('planecopy16.png'))

  -- EDG Data
  !this.edgActive      = false
  !this.edgDescription = 'Aid Copy Mirror'

  -- Aid Number
  !this.aidPlane      = !!aidNumbers.add('Aid Modify - axes')
  !this.aidNumber     = !!aidNumbers.add('Aid Modify')

  -- Cancel Callback
  !this.cancelCall    = '!this.tidy()'

  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!this.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Z Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!this.direction(!this.modify.mirrorPlane.direction().opposite())')
  !this.direction.setPopup(!this.directionMenu)

endmethod
-- End of method definition for .aidCopyMirror()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form gadgets
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !active            = !this.modify.aidList.empty().not()

  -- Grey out gadgets
  !this.clear.active = !active
  !this.apply.active = !this.edgActive.not() and !active

  -- Update aid count
  !this.aidCount.val = !this.modify.aidList.size().string()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!aidCopyMirror.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Setup form
  !this.setup()

  -- Expect the user to pick an aid
  !this.append()

  -- Draw axes
  !this.drawPlane()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form down
--
------------------------------------------------------------------------

define method .close()

  -- Tidy
  !this.tidy()

  -- Close form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy graphics
--
------------------------------------------------------------------------

define method .tidy()

  -- Clear modify list
  !this.clear()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidPlane)

  -- Remove EDG events
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply copies/move
--
------------------------------------------------------------------------

define method .apply()

  -- Check for invalid data
  if(!this.modify.aidList.empty()) then
    !!alert.warning('There are no graphical aids selected to mirror.')
    return
  endif

  -- Initialise Variables

  -- Copy
  if(!this.modify.copy) then


    -- Loop through the aid list
    do !index values !this.modify.aidList

      -- Get original
      !aid = !!aidNumbers.get(!index)
      handle ANY
        skip
      endhandle

      -- Set the default style for the aid
      !aid.displayStyle()

      -- Mirror the aid
      !aid = !this.modify.mirror(!aid)

      -- Aid aid to system
      !!aidConstructors.add(!aid)

      -- Remove the aid
      !aid.delete()

    enddo


  -- Move
  else

    do !aidIndex values !this.modify.aidList
      !!aidNumbers.replace(!aidIndex, !this.modify.mirror(!!aidNumbers.get(!aidIndex)))
    enddo

    !this.modify.mirror()

  endif

  !this.draw()

  -- Remove the now overlayed dashed temporary aid because it causes problem if delete is used
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description:  Clear aid list down
--
------------------------------------------------------------------------

define method .clear()

  -- Clear out the modification list
  !this.modify.clear()

  -- Setup form
  !this.setup()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      append
--
-- Description: Append picked aid graphics to the list
--
------------------------------------------------------------------------

-- Define method
define method .append()

   -- Initialise Variables
  !this.edgActive        = true
  !packet                = object EDGPACKET()

  -- Delete a graphical aid
  !packet.defineAid('Pick Aid to Copy/Move Mirror')
  !packet.description    = !this.edgDescription
  !packet.action         = '!!aidCopyMirror.display(!this.return[1])'
  !packet.escape         = '!!aidCopyMirror.escape()'
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  if(!!edgCntrl.add(!packet)) then
    !this.setup()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      escape
--
-- Description: Escape from the edg event
--
------------------------------------------------------------------------

-- Define method
define method .escape()

   -- Initialise Variables
   !this.edgActive        = false

  -- Update the gadgets
  !this.setup()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Set form to passed element and tag graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!element is EDGPICKDATA)

  -- Initialise Variables
  !aidNumber = !element.point

  -- Check against forms aid numbers
  if(!aidNumber eq !this.aidNumber or !aidNumber eq !this.aidPlane) then
    !!alert.warning('Unable to use the "Copy/Mirror" aid graphics.')
    return
  endif

  -- See if aid number is used
  if(!!aidNumbers.isRegistered(!aidNumber).not()) then
    !!alert.error(!!error.text)
    return
  endif

  -- If aid is already in the list, then remove it
  if(!this.modify.isAdded(!aidNumber)) then
    !this.modify.remove(!aidNumber)
  else
    !this.modify.add(!aidNumber)
  endif

  -- Setup form
  !this.setup()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      option
--
-- Description: Set up form for Copy option or Move option
--
------------------------------------------------------------------------

-- Define method
define method .option()

  -- Initialise Variables
  !copyFlag           = !this.option.selection().upcase() eq 'COPY'

  -- Set modify
  !this.modify.copy   = !copyFlag

  -- Form title
  !this.formTitle     = 'Aid ' & !this.option.selection('DTEXT') & ' Mirror'

endmethod
-- End of method definition for .option()

------------------------------------------------------------------------
--
-- Method:      option
--
-- Description: Set up form for Copy option or Move option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     MODE or COPY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .option(!choice is STRING)

  -- Put the form in the chosen mode
  if (!choice eq 'MOVE') then
    !this.option.select('RTEXT', 'MOVE')
  else
    !this.option.select('RTEXT', 'COPY')
  endif

  -- Call over loading method
  !this.option()

endmethod
-- End of method definition for .option(STRING)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
------------------------------------------------------------------------

-- Define method
define method .position()

  -- Get current position
  !position    = !this.position.get()

  -- Get direction
  !direction   = !this.modify.mirrorPlane.direction()

  -- Set rotation line
  !pointVector = object POINTVECTOR(!position, !direction)
  !this.modify.mirrorPlane(!pointVector.plane())

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.defineDirection('')
    !packet.description = !this.edgDescription
    !packet.action      = '!!aidCopyMirror.direction(!this.return[1])'
    !!edgCntrl.add(!packet)

  -- Direction
  else

    -- Check we have an orientation
    !orientation = !!ce.orientation
    handle any
      return
    endhandle

    -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction(!orientation.xDir())
    elseif (!option.match('Y').boolean()) then
      !this.direction(!orientation.yDir())
    else
      !this.direction(!orientation.zDir())
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction
--
------------------------------------------------------------------------

-- Define method
define method .direction()

  -- Initialise Variables
  !string                = !this.direction.val & ' wrt ' & !this.wrtElement
  !direction             = !string.direction()
  handle ANY
    !!alert.warning('Invalid direction given.')
    !this.direction.val  = !this.modify.mirrorPlane.direction().string().before('WRT').trim()
    return
  endhandle

  -- Update direction
  !this.direction(!direction)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- If direction is unset, then don't do anything
  if(!direction.unset()) then
    return
  endif

  -- Write angle to form
  !this.direction.val = !direction.wrt(!this.wrtElement).string().before('WRT').trim()

  -- Set direction of mirror plane
  !pointVector        = object POINTVECTOR(!this.modify.mirrorPlane.position, !direction.wrt(!this.wrtElement))
  !this.modify.mirrorPlane(!pointVector.plane())

  -- Draw
  !this.draw()

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .wrt()

  -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !wrtElement = World
  endhandle

  -- Set with respect to element
  !this.wrtElement = !wrtElement

  -- Get direction
  !direction          = !this.modify.mirrorPlane.direction().wrt(!this.wrtElement)
  !this.direction.val = !direction.string().before('WRT')

  -- Set tagging method up
  !this.position.setWrt(!wrtElement)

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      mirrorPoint
--
-- Description: Packet for picking mirror point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirrorPoint()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Position Mirror Plane')
  !packet.description    = !this.edgDescription
  !packet.priority       = 1
  !packet.action         = '!!aidCopyMirror.mirrorPoint(!this.return[1].position)'
  !packet.key            = 'aidCopyMirror'
  !packet.remove         = false
  !packet.escape         = '!!aidCopyMirror.escape()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorPoint
--
-- Description: Set mirror plane position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirrorPoint(!position is POSITION)

  -- Initialise Variables

  -- Check for line
  if(!position.unset()) then
    return
  endif

  -- Initialise variables
  !position  = !position.wrt(!this.wrtElement)
  !direction = !this.modify.mirrorPlane.direction()

  -- Setup position
  !this.position.position(!position)
  !newPosition = !this.position.position()

  -- Set rotation line
  !pointVector = object POINTVECTOR(!newPosition, !direction)
  !this.modify.mirrorPlane(!pointVector.plane())

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorPlane
--
-- Description: Packet for picking mirror plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirrorPlane()

  -- Packet definition
  !packet                   = object EDGPACKET()
  !packet.key               = 'mirrorPlane'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!aidCopyMirror.mirrorPlane(!this.return[1].getPlane())'
  !packet.remove            = true
  !packet.pickPacket.planeDerive()
  !packet.close             = '!!aidCopyMirror.escape()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorPlane
--
-- Description: Define rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Mirror plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirrorPlane(!plane is PLANE)

  -- Check if data has been passed
  if(!plane.unset()) then
    return
  endif

  -- Initialise variables
  !newPlane   = object PLANE(!plane.position.wrt(!this.wrtElement), !plane.orientation.wrt(!this.wrtElement))

  -- Set rotation line
  !this.modify.mirrorPlane(!newPlane)

  -- Setup gadgets
  !this.position.position(!newPlane.position)
  !this.direction.val = !newPlane.direction().string().before('WRT').trim()

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawPlane
--
-- Description: Draw plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPlane()

  -- Initialise Variables
  !plane     = !this.modify.mirrorPlane
  !direction = !plane.direction()
  !position  = !plane.position

  -- Clear aids
  AID CLEAR ALL $!<this.aidPlane>

  -- Draw rotation line
  !gPlane             = object GPHPLANE(!this.modify.mirrorPlane)
  !gPlane.description = 'Mirror plane'
  !gPlane.tag         = true
  !gPlane.displayStyle(5, 3)
  !gPlane.draw(!this.aidPlane)

  -- Draw direction
  AID ARROW NUMBER $!<this.aidPlane> AT $!<position> DIRECTION $!<direction> HEIGHT 1000mm

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Draw Axes
  !this.drawPlane()

  -- Remove old aid graphics
  !!aidNumbers.hide(!this.aidNumber)

  -- If angle is zero, then don't do anything
  if(!this.modify.aidList.empty()) then
    return
  endif

  -- Draw modified aids
  do !aid values !this.modify.graphicsList

    !aid.detail = false
    !aid.tag    = false
    !aid.basic  = true
    handle ANY
    endhandle
    !aid.displayStyle(4, 2)
    handle ANY
    endhandle

    !aid.draw(!this.aidNumber, false)
  enddo

endmethod
-- End of method
