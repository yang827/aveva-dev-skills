--
--
-- Description:
-- Form for Aid Rotation Axis
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidCopyOffset()                  -                   Constructor
--  append()                         -                   Append picked aid graphics to the list
--  apply()                          -                   Apply copies/move
--  clear()                          -                   Clear aid list down
--  close()                          -                   Close form down
--  copies()                         -                   Set copies
--  direction()                      -                   Set direction
--  direction(DIRECTION)             -                   Setup to direction of offset
--  display(EDGPICKDATA)             -                   Set form to passed element and tag graphics
--  distance()                       -                   Set direction
--  draw()                           -                   Draw changes
--  drawOffset()                     -                   Draw axes
--  escape()                         -                   Escape from the edg event
--  initialise()                     -                   Initialisation form
--  measure()                        -                   Setup for measure
--  measure(LINE)                    -                   Setup to direction of offset
--  option()                         -                   Set up form for Copy option or Move option
--  option(STRING)                   -                   Set up form for Copy option or Move option
--  position()                       -                   Set position
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setup()                          -                   Setup form gadgets
--  tidy()                           -                   Tidy graphics
--  wrt()                            -                   Set up with new wrt item
--

-- Set up form
setup form !!aidCopyOffset

  !this.formTitle     = 'Aid Copy/Move Rotate'
  !this.iconTitle     = 'Aid Rotate'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.15 $ '

  path right

  -- Aid graphics
  frame .graphicFrame 'Graphic Aids' at xmin form ymax width 32

    button .append 'Pick'        at x1          ymax tooltip 'Pick graphical aids to append to the list' callback '!this.append()'
    button .clear  'Clear'                           tooltip 'Clear all graphical aids from the list'    callback '!this.clear()'

    -- Paragraph
    paragraph .aidText           at xmax+1      ymin text 'Selected : '
    paragraph .aidCount          at xmax        ymin text '000'

  exit

  -- Information from
  frame .informationFrame 'Copy Settings' at xmin ymax+0.25 width 32

    -- Body of form definition
    option .option 'Option ' at x2     ymax          tooltip 'Action to be performed on graphical aids'  callback '!this.option()' width 4

    -- Copies
    text .copies   'copies ' at xmax+2 ymin          tooltip 'Number of copies'                          callback '!this.copies()' width 4 is REAL format !!integerFmt

  exit

  -- Distances
  frame .axesFrame 'Offset Settings' at xmin ymax+0.25

    -- Offset type
    rgroup .xyzOffset 'Type' at x1 ymax callback '!this.setup()' frame vertical
      add tag 'Cardinal offset'             select 'true'
      add tag 'Distance & Direction' select 'false'
    exit

    valign bottom
    button .measure at xmax+2 tooltip 'Measure' pixmap width 16 height 16 callback '!this.measure()'

    -- Positioning Gadgets
    frame .positionFrame 'Offset' at xmin.xyzOffset ymax.xyzOffset+0.25
      path right

      path down
      halign right
      option .ew          at x6     ymax+0.2 width 5
      option .ns                             width 5
      option .ud                             width 5
      text   .x           at xmax+1 ymin.ew  width 14 is REAL format !!distanceFmt
      text   .y           at xmin   ymin.ns  width 14 is REAL format !!distanceFmt
      text   .z           at xmin   ymin.ud  width 14 is REAL format !!distanceFmt

    exit

    -- Distance Direction
    frame .distanceFrame 'Distance Direction' at xmin ymax+0.5
      text .distance   'Distance '  at x6 ymax  callback '!this.distance()'  width 14 is REAL format !!distanceFmt
      path down
      halign right
      text .direction  'Direction '             callback '!this.direction()' width 17 is STRING
    exit

    text .wrt        'wrt '       callback '!this.wrt()'           width 25 is STRING

  exit

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax+0.25 callback '!this.close()' ok
  -- Apply
  button .apply 'Apply' at xmin form-0 ymin callback '!this.apply()'

  -- Form Members

  -- Aid modification object
  member .modify           is AIDMODIFY

  -- Position
  member .position         is POSITIONLINK

  -- Wrt element
  member .wrtElement       is DBREF

  -- EDG Active
  member .edgActive        is BOOLEAN

  -- EDG Description
  member .edgDescription   is STRING

  -- Aid Number
  member .aidOffset       is REAL
  member .aidNumber     is REAL

exit
-- End of form definition for !!aidCopyOffset

------------------------------------------------------------------------
--
-- Method:      aidCopyOffset
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .aidCopyOffset()

  -- Initial rotation angle
  !dtext[1]           = 'Copy'
  !rtext[1]           = 'COPY'
  !dtext[2]           = 'Move'
  !rtext[2]           = 'MOVE'
  !this.option.dtext  = !dtext
  !this.option.rtext  = !rtext

  -- Defaults
  !this.copies.val    = !this.modify.copies
  !this.aidCount.val  = !this.modify.aidList.size().string()

  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!aidCopyOffset.position', !this.x, !this.y, !this.z)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!aidCopyOffset.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!aidCopyOffset.position()')

  -- Set defaults for form
  !this.position.position(!this.modify.offsetXYZ, false, true)

  -- Direction
  !this.direction.val = !this.modify.offsetDirection.string().before('WRT').trim()

  -- Distance
  !this.distance.val  = !this.modify.offsetDistance


  !this.wrtElement    = !this.modify.offsetXYZ.origin
  !this.wrt.val       = !this.wrtElement.flnm

  -- Icons
  !this.measure.addPixmap(!!pml.getPathName('measure16.png'))

  -- EDG Data
  !this.edgActive      = false
  !this.edgDescription = 'Aid Copy Rotate'

  -- Aid Number
  !this.aidOffset      = !!aidNumbers.add('Aid Modify - axes')
  !this.aidNumber      = !!aidNumbers.add('Aid Modify')

  -- Cancel Callback
  !this.cancelCall     = '!this.tidy()'

  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!this.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Z Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!this.direction(!this.modify.offsetDirection.opposite())')
  !this.direction.setPopup(!this.directionMenu)

endmethod
-- End of method definition for .aidCopyOffset()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form gadgets
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !active            = !this.modify.aidList.empty().not()

  -- Grey out gadgets
  !this.clear.active = !active
  !this.apply.active = !this.edgActive.not() and !active

  -- Update aid count
  !this.aidCount.val = !this.modify.aidList.size().string()

  -- Set offset modes
  !xyzOffset             = !this.xyzOffset.selection().boolean()
  !this.ew.active        = !xyzOffset
  !this.ns.active        = !xyzOffset
  !this.ud.active        = !xyzOffset
  !this.x.active         = !xyzOffset
  !this.y.active         = !xyzOffset
  !this.z.active         = !xyzOffset

  !this.distance.active  = !xyzOffset.not()
  !this.direction.active = !xyzOffset.not()


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects with current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!aidCopyOffset.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- change to the current coordinate
  !this.direction.val =  !this.direction.val.direction().string().before('WRT').trim()
  handle ANY
   !this.direction.val = !this.modify.offsetDirection.string().before('WRT').trim()
  endhandle

  -- Setup form
  !this.setup()

  -- Setup number of copies to 1
  !this.copies.val = 1
  !this.copies()

  -- Expect the user to pick an aid
  !this.append()

  -- Draw axes
  !this.drawOffset()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form down
--
------------------------------------------------------------------------

define method .close()

  -- Tidy
  !this.tidy()

  -- Close form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy graphics
--
------------------------------------------------------------------------

define method .tidy()

  -- Clear modify list
  !this.clear()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidOffset)

  -- Remove EDG events
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply copies/move
--
------------------------------------------------------------------------

define method .apply()

  -- Check for invalid data
  if(!this.modify.copies lt 1 and !this.modify.copy) then
    !!alert.warning('There must be at least one copy.')
    return
  elseif (!this.modify.aidList.empty()) then
    !!alert.warning('There are no graphical aids selected to rotate.')
    return
  endif

  -- Initialise Variables

  -- Copy
  if(!this.modify.copy) then


    -- Loop through the aid list
    do !index values !this.modify.aidList

      -- Get original
      !aid = !!aidNumbers.get(!index)
      handle ANY
        skip
      endhandle

      -- Set the default style for the aid
      !aid.displayStyle()


      -- Loop through the copies
      do from 1 to !this.modify.copies

        -- Rotate the aid
        !aid = !this.modify.offset(!aid)

        -- Aid aid to system
        !!aidConstructors.add(!aid)

      enddo

      -- Remove the aid
      !aid.delete()

    enddo

    -- Reset the copies so we can't accidentally do a double copy
    !this.copies.val = 0
    !this.modify.copies = 0
    !this.draw()

  -- Move
  else

    do !aidIndex values !this.modify.aidList
      !!aidNumbers.replace(!aidIndex, !this.modify.offset(!!aidNumbers.get(!aidIndex)))
    enddo

    !this.direction()

  endif

  -- Remove the now overlayed dashed temporary aid because it causes problem if delete is used
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description:  Clear aid list down
--
------------------------------------------------------------------------

define method .clear()

  -- Clear out the modification list
  !this.modify.clear()

  -- Setup form
  !this.setup()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      append
--
-- Description: Append picked aid graphics to the list
--
------------------------------------------------------------------------

-- Define method
define method .append()

   -- Initialise Variables
  !this.edgActive        = true
  !packet                = object EDGPACKET()

  -- Delete a graphical aid
  !packet.defineAid('Pick Aid to Copy/Move Rotate')
  !packet.description    = !this.edgDescription
  !packet.key            = 'aidCopyOffset'
  !packet.action         = '!!aidCopyOffset.display(!this.return[1])'
  !packet.escape         = '!!aidCopyOffset.escape()'
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  if(!!edgCntrl.add(!packet)) then
    !this.setup()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      escape
--
-- Description: Escape from the edg event
--
------------------------------------------------------------------------

-- Define method
define method .escape()

   -- Initialise Variables
   !this.edgActive        = false

  -- Update the gadgets
  !this.setup()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Set form to passed element and tag graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!element is EDGPICKDATA)

  -- Initialise Variables
  !aidNumber = !element.point

  -- Check against forms aid numbers
  if(!aidNumber eq !this.aidNumber or !aidNumber eq !this.aidOffset) then
    !!alert.warning('Unable to use the "Copy/Offset" aid graphics.')
    return
  endif

  -- See if aid number is used
  if(!!aidNumbers.isRegistered(!aidNumber).not()) then
    !!alert.error(!!error.text)
    return
  endif

  -- If aid is already in the list, then remove it
  if(!this.modify.isAdded(!aidNumber)) then
    !this.modify.remove(!aidNumber)
  else
    !this.modify.add(!aidNumber)
  endif

  -- Setup form
  !this.setup()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      option
--
-- Description: Set up form for Copy option or Move option
--
------------------------------------------------------------------------

-- Define method
define method .option()

  -- Initialise Variables
  !copyFlag           = !this.option.selection().upcase() eq 'COPY'

  -- Form title
  !this.formTitle     = 'Aid ' & !this.option.selection('DTEXT') & ' Offset'

  -- Set gadgets
  !this.copies.active = !copyFlag

  -- Setup modify object
  !this.modify.copy   = !copyFlag

  -- Check that number of copies is valid
  !this.copies()

  -- Draw
  !this.draw()

endmethod
-- End of method definition for .option()

------------------------------------------------------------------------
--
-- Method:      option
--
-- Description: Set up form for Copy option or Move option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     MODE or COPY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .option(!choice is STRING)

  -- Put the form in the chosen mode
  if (!choice eq 'MOVE') then
    !this.option.select('RTEXT', 'MOVE')
  else
    !this.option.select('RTEXT', 'COPY')
  endif

  -- Call over loading method
  !this.option()

endmethod
-- End of method definition for .option(STRING)

------------------------------------------------------------------------
--
-- Method:      copies
--
-- Description: Set copies
--
------------------------------------------------------------------------

-- Define method
define method .copies()

  -- Check for negative copy
  if(!this.copies.val le 0 and !this.modify.copy) then
    !!alert.warning('Number of copies MUST be greater than zero.')
    !this.copies.val = !this.modify.copies
    return
  endif

  -- Set number of copies
  !this.modify.copies = !this.copies.val

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
------------------------------------------------------------------------

-- Define method
define method .position()

  -- Get current position
  !position    = !this.position.get()

  -- Set position of offset
  !this.modify.offset(!position)

  -- Update direction and distance
  !this.distance.val  = !this.modify.offsetDistance
  !this.direction.val = !this.modify.offsetDirection.string().before('WRT').trim()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description: Setup for measure
--
------------------------------------------------------------------------

-- Define method
define method .measure()

  -- Define Edit line packet
  !packet             = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.key            = 'aidCopyOffset'
  !packet.description    = !this.edgDescription
  !packet.action         = '!!aidCopyOffset.measure(!this.return[1])'
  !packet.priority       = 2
  !packet.remove         = true
  !packet.type           = 'measure'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Measurement line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Initialise Variables
  !from  = !line.startPosition.wrt(!this.wrtElement)
  !to    = !line.endPosition.wrt(!this.wrtElement)

  -- Derive distance and direction
  !distance = !from.distance(!to)

  -- If distance is greater than zero, get direction
  if(!distance gt 0) then
    !direction = !from.direction(!to)
  else
    !direction = !this.modify.offsetDirection
  endif

  -- Define position
  !position    = !this.modify.offsetOrigin.offset(!direction, !distance)

  -- Setup form
  !this.position.position(!position, true, true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.defineDirection('')
    !packet.key         = 'aidCopyOffset'
    !packet.description = !this.edgDescription
    !packet.action      = '!!aidCopyOffset.direction(!this.return[1])'
    !!edgCntrl.add(!packet)

  -- Direction
  else

    -- Check we have an orientation
    !orientation = !!ce.orientation.wrt(!this.wrtElement)
    handle any
      return
    endhandle

    -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction(!orientation.xDir())
    elseif (!option.match('Y').boolean()) then
      !this.direction(!orientation.yDir())
    else
      !this.direction(!orientation.zDir())
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction
--
------------------------------------------------------------------------

-- Define method
define method .direction()

  -- Initialise Variables
  !string                 = !this.direction.val & ' wrt ' & !this.wrtElement
  !direction              = !string.direction()
  handle ANY
    !!alert.warning('Invalid direction given.')
    !this.direction.val   = !this.modify.offsetDirection.string().before('WRT').trim()
    return
  endhandle

  -- Update direction
  !this.direction(!direction)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- New direction
  !newDirection       = !direction.wrt(!this.wrtElement)

  -- Write angle to form
  !this.direction.val = !newDirection.string().before('WRT').trim()

  -- Update
  !this.modify.offset(!this.modify.offsetDistance, !newDirection)

  -- Update XYZ position
  !this.position.position(!this.modify.offsetXYZ, true, true)

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Set direction
--
------------------------------------------------------------------------

-- Define method
define method .distance()

  -- Update
  !this.modify.offset(!this.distance.val, !this.modify.offsetDirection)

  -- Update XYZ position
  !this.position.position(!this.modify.offsetXYZ, true, true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .wrt()

  -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !wrtElement = World
  endhandle

  -- Set with respect to element
  !this.wrtElement    = !wrtElement

  -- Get position
  !position           = !this.position.position()
  !position.origin    = !wrtElement

  -- Set tagging method up
  !this.position.setWrt(!wrtElement)

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.name

  -- Set position
  !this.position.position(!position,true,true)

  -- Update direction
  !this.modify.offset(!position)

  -- Update distance and direction
  !this.direction.val = !this.modify.offsetDirection.string().before('WRT').trim()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      drawOffset
--
-- Description: Draw axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawOffset()

  -- Clear aids
  AID CLEAR ALL $!<this.aidOffset>

  -- Initialise Variables

  -- If there are any elements in the list, then use the first on
  if(!this.modify.aidList.empty().not()) then
    !position    = !!aidNumbers.get(!this.modify.aidList.first()).position()
  else
    !position    = !this.modify.offsetOrigin
  endif

  -- Define reference line
  if(!this.modify.offsetDistance gt 0) then
    !pointVector = object POINTVECTOR(!position, !this.modify.offsetDirection)
    !line        = !pointVector.line(!this.modify.offsetDistance)
    !line.draw(!this.aidOffset, 2, 5)

    -- Tag to
    AID TEXT NUMBER $!<this.aidOffset> 'To' AT $!<line.endPosition>

  endif

  -- Tag origin
  AID TEXT NUMBER $!<this.aidOffset> 'From' AT $!<position>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Draw Axes
  !this.drawOffset()

  -- Remove old aid graphics
  !!aidNumbers.hide(!this.aidNumber)

  -- Offset is zero
  if(!this.modify.offsetDistance eq 0 or !this.modify.aidList.empty()) then
    return
  endif

  -- Draw copies
  if(!this.copies.val gt 1 and !this.option.selection().upcase() eq 'COPY') then

    !newAid = !this.modify.graphicsList.first()
    !newAid.displayStyle(4, 2)
    handle ANY
    endhandle

    do from 2 to !this.copies.val
      !newAid        = !this.modify.offset(!newAid)
      !newAid.detail = false
      !newAid.tag    = false
      !newAid.basic  = true
      handle ANY
      endhandle
      !newAid.draw(!this.aidNumber, false)
    enddo

  endif

  -- Draw modified aids
  do !aid values !this.modify.graphicsList
    !aid.detail = false
    !aid.tag    = false
    !aid.basic  = true
    handle ANY
    endhandle
    !aid.displayStyle(4, 2)
    handle ANY
    endhandle

    !aid.draw(!this.aidNumber, false)
  enddo

endmethod
-- End of method
