-- Created:         Thu Dec 2 15:00:00 "GMT 1999
--
--
-- Description:
-- Form for Aid Rotation Axis
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidCopyRotate()                  -                   Constructor
--  append()                         -                   Append picked aid graphics to the list
--  apply()                          -                   Apply copies/move
--  clear()                          -                   Clear aid list down
--  close()                          -                   Close form down
--  copies()                         -                   Set copies
--  direction()                      -                   Set direction
--  direction(DIRECTION)             -                   Setup to direction of offset
--  display(EDGPICKDATA)             -                   Set form to passed element and tag graphics
--  draw()                           -                   Draw changes
--  drawAxes()                       -                   Draw axes
--  escape()                         -                   Escape from the edg event
--  initialise()                     -                   Initialisation form
--  option()                         -                   Set up form for Copy option or Move option
--  option(STRING)                   -                   Set up form for Copy option or Move option
--  position()                       -                   Set position
--  rotate()                         -                   Set rotation
--  rotationLine()                   -                   Packet for picking rotation line
--  rotationLine(LINE)               -                   Define rotation line
--  rotationPoint()                  -                   Packet for picking rotation point
--  rotationPoint(POSITION)          -                   Set rotation line position
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setup()                          -                   Setup form gadgets
--  tidy()                           -                   Tidy graphics
--  wrt()                            -                   Set up with new wrt item
--

-- Set up form
setup form !!aidCopyRotate

  !this.formTitle     = 'Aid Copy/Move Rotate'
  !this.iconTitle     = 'Aid Rotate'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.17 $ '

  path right

  -- Aid graphics
  frame .graphicFrame 'Graphic Aids' at xmin form ymax width 32

    button .append 'Pick'        at x1          ymax tooltip 'Pick graphical aids to append to the list' callback '!this.append()'
    button .clear  'Clear'                           tooltip 'Clear all graphical aids from the list'    callback '!this.clear()'

    -- Paragraph
    paragraph .aidText           at xmax+1      ymin text 'Selected : '
    paragraph .aidCount          at xmax        ymin text '000'

  exit

  -- Information from
  frame .informationFrame 'Settings' at xmin ymax+0.25 width 32

    -- Body of form definition
    option .option 'Option ' at x2     ymax          tooltip 'Action to be performed on graphical aids'  callback '!this.option()' width 4

    -- Copies
    text .copies   'copies ' at xmax+2 ymin          tooltip 'Number of copies'                          callback '!this.copies()' width 4 is REAL format !!integerFmt

    -- Distance
    path down
    halign right
    text .rotate 'Rotation Angle'              tooltip 'Angle of rotation'                         callback '!this.rotate()' width 9 is REAL format !!angleFmt

  exit

  -- Distances
  frame .axesFrame 'Rotation Axes' at xmin ymax+0.25

    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax
      path right
      button .rotationPoint     at x1 ymax pixmap width 16 height 16 tooltip 'Pick position of Rotation' callback '!this.rotationPoint()'
      button .rotationLine 'Rotation Line' pixmap width 16 height 16 tooltip 'Pick rotation line'        callback '!this.rotationLine()'

      path down
      halign right
      option .ew          at x1     ymax+0.2 width 5
      option .ns                             width 5
      option .ud                             width 5
      text   .x           at xmax+1 ymin.ew  width 14 is REAL format !!distanceFmt
      text   .y           at xmin   ymin.ns  width 14 is REAL format !!distanceFmt
      text   .z           at xmin   ymin.ud  width 14 is REAL format !!distanceFmt

      toggle .xFlag at xmax.x+1     ymin.ew
      toggle .yFlag at xmin         ymin.ns
      toggle .zFlag at xmin         ymin.ud
      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

    exit

    vdist 0.5
    text .direction  'Direction ' callback '!this.direction()'     width 18 is STRING
    vdist 0
    text .wrt        'wrt '       callback '!this.wrt()'           width 25 is STRING

  exit

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax+0.25 callback '!this.close()' ok
  -- Apply
  button .apply 'Apply' at xmin form-0 ymin callback '!this.apply()'

  -- Form Members

  -- Aid modification object
  member .modify           is AIDMODIFY

  -- Position
  member .position         is POSITIONLINK

  -- Wrt element
  member .wrtElement       is DBREF

  -- EDG Active
  member .edgActive        is BOOLEAN

  -- EDG Description
  member .edgDescription   is STRING

  -- Aid Number
  member .aidAxes       is REAL
  member .aidNumber     is REAL

exit
-- End of form definition for !!aidCopyRotate

------------------------------------------------------------------------
--
-- Method:      aidCopyRotate
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .aidCopyRotate()

  -- Initial rotation angle
  !dtext[1]           = 'Copy'
  !rtext[1]           = 'COPY'
  !dtext[2]           = 'Move'
  !rtext[2]           = 'MOVE'
  !this.option.dtext  = !dtext
  !this.option.rtext  = !rtext

  -- Defaults
  !this.copies.val    = !this.modify.copies
  !this.rotate.val    = !this.modify.angle
  !this.aidCount.val  = !this.modify.aidList.size().string()

  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!aidCopyRotate.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!aidCopyRotate.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
    var !coordinate coordinate
  !this.position.linkOption('!!aidCopyRotate.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!aidCopyRotate.position()')

  -- Set defaults for form
  !this.position.position(!this.modify.rotationLine.startPosition, false, true)

  !this.direction.val = !this.modify.rotationLine.direction().string().before('WRT').trim()
  !this.wrtElement    = !this.modify.rotationLine.startPosition.origin
  !this.wrt.val       = !this.wrtElement.flnm

  -- Icons
  !this.rotationPoint.addPixmap(!!pml.getPathName('navigate16.png'))
  !this.rotationLine.addPixmap(!!pml.getPathName('linecopy16.png'))

  -- EDG Data
  !this.edgActive      = false
  !this.edgDescription = 'Aid Copy Rotate'

  -- Aid Number
  !this.aidAxes       = !!aidNumbers.add('Aid Modify - axes')
  !this.aidNumber     = !!aidNumbers.add('Aid Modify')

  -- Cancel Callback
  !this.cancelCall    = '!this.tidy()'

  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!this.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Z Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!this.direction(!this.modify.rotationLine.direction().opposite())')
  !this.direction.setPopup(!this.directionMenu)

endmethod
-- End of method definition for .aidCopyRotate()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form gadgets
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !active            = !this.modify.aidList.empty().not()

  -- Grey out gadgets
  !this.clear.active = !active
  !this.apply.active = !this.edgActive.not() and !active

  -- Update aid count
  !this.aidCount.val = !this.modify.aidList.size().string()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects
    var !coordinate coordinate
  !this.position.linkOption('!!aidCopyRotate.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- change to the current coordinate
  !this.direction.val =  !this.direction.val.direction().string().before('WRT').trim()
  handle ANY
   !this.direction.val  = !this.modify.rotationLine.direction().string().before('WRT').trim()
 endhandle

  -- Setup form
  !this.setup()

  -- Setup number of copies to 1
  !this.copies.val = 1
  !this.copies()

  -- Expect the user to pick an aid
  !this.append()

  -- Draw axes
  !this.drawAxes()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form down
--
------------------------------------------------------------------------

define method .close()

  -- Tidy
  !this.tidy()

  -- Close form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy graphics
--
------------------------------------------------------------------------

define method .tidy()

  -- Clear modify list
  !this.clear()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

  -- Remove EDG events
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply copies/move
--
------------------------------------------------------------------------

define method .apply()

  -- Check for invalid data
  if(!this.modify.angle eq 0) then
    !!alert.warning('There must be an angle or rotation.')
    return
  elseif (!this.modify.copies lt 1 and !this.modify.copy) then
    !!alert.warning('There must be at least one copy.')
    return
  elseif (!this.modify.aidList.empty()) then
    !!alert.warning('There are no graphical aids selected to rotate.')
    return
  endif

  -- Initialise Variables

  -- Copy
  if(!this.modify.copy) then


    -- Loop through the aid list
    do !index values !this.modify.aidList

      -- Get original
      !aid = !!aidNumbers.get(!index)
      handle ANY
        skip
      endhandle

      -- Set the default style for the aid
      !aid.displayStyle()


      -- Loop through the copies
      do from 1 to !this.modify.copies

        -- Rotate the aid
        !aid = !this.modify.rotate(!this.modify.angle, !aid)

        -- Aid aid to system
        !!aidConstructors.add(!aid)


      enddo

      -- Remove the aid
      !aid.delete()

    enddo

    -- Reset the copies so we can't accidentally do a double copy
    !this.copies.val = 0
    !this.modify.copies = 0
    !this.draw()

  -- Move
  else

    do !aidIndex values !this.modify.aidList
      !!aidNumbers.replace(!aidIndex, !this.modify.rotate(!this.rotate.val, !!aidNumbers.get(!aidIndex)))
    enddo

    !this.rotate()

  endif

  -- Remove the dashed temporary aid because it causes problem if delete is used
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description:  Clear aid list down
--
------------------------------------------------------------------------

define method .clear()

  -- Clear out the modification list
  !this.modify.clear()

  -- Setup form
  !this.setup()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      append
--
-- Description: Append picked aid graphics to the list
--
------------------------------------------------------------------------

-- Define method
define method .append()

   -- Initialise Variables
  !this.edgActive        = true
  !packet                = object EDGPACKET()

  -- Delete a graphical aid
  !packet.defineAid('Pick Aid to Copy/Move Rotate')
  !packet.description    = !this.edgDescription
  !packet.action         = '!!aidCopyRotate.display(!this.return[1])'
  !packet.escape         = '!!aidCopyRotate.escape()'
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'aidConstructors'

  -- Add into EDG packet
  if(!!edgCntrl.add(!packet)) then
    !this.setup()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      escape
--
-- Description: Escape from the edg event
--
------------------------------------------------------------------------

-- Define method
define method .escape()

   -- Initialise Variables
   !this.edgActive        = false

  -- Update the gadgets
  !this.setup()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Set form to passed element and tag graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!element is EDGPICKDATA)

  -- Initialise Variables
  !aidNumber = !element.point

  -- Check against forms aid numbers
  if(!aidNumber eq !this.aidNumber or !aidNumber eq !this.aidAxes) then
    !!alert.warning('Unable to use the "Copy/Rotate" aid graphics.')
    return
  endif

  -- See if aid number is used
  if(!!aidNumbers.isRegistered(!aidNumber).not()) then
    !!alert.error(!!error.text)
    return
  endif

  -- If aid is already in the list, then remove it
  if(!this.modify.isAdded(!aidNumber)) then
    !this.modify.remove(!aidNumber)
  else
    !this.modify.add(!aidNumber)
  endif

  -- Setup form
  !this.setup()

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      option
--
-- Description: Set up form for Copy option or Move option
--
------------------------------------------------------------------------

-- Define method
define method .option()

  -- Initialise Variables
  !copyFlag           = !this.option.selection().upcase() eq 'COPY'

  -- Form title
  !this.formTitle     = 'Aid ' & !this.option.selection('DTEXT') & ' Rotate'

  -- Set gadgets
  !this.copies.active = !copyFlag

  -- Setup modify object
  !this.modify.copy   = !copyFlag

  -- Check that number of copies is valid
  !this.copies()

  -- Draw
  !this.draw()

endmethod
-- End of method definition for .option()

------------------------------------------------------------------------
--
-- Method:      option
--
-- Description: Set up form for Copy option or Move option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     MODE or COPY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .option(!choice is STRING)

  -- Put the form in the chosen mode
  if (!choice eq 'MOVE') then
    !this.option.select('RTEXT', 'MOVE')
  else
    !this.option.select('RTEXT', 'COPY')
  endif

  -- Call over loading method
  !this.option()

endmethod
-- End of method definition for .option(STRING)

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Set rotation
--
------------------------------------------------------------------------

-- Define method
define method .rotate()

  -- Check the rotation angle and number off
  if(!this.rotate.val.sbetween(-360, 360).not()) then
    !!alert.warning('Angle must be between -360 and 360 degrees.')
    !this.rotate.val = !this.modify.angle
    return
  endif

  -- Check copies
  !this.copies()

  -- Rotate
  !this.modify.rotate(!this.rotate.val)

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copies
--
-- Description: Set copies
--
------------------------------------------------------------------------

-- Define method
define method .copies()

  -- Check for negative copy
  if(!this.copies.val le 0 and !this.modify.copy) then
    !!alert.warning('Number of copies MUST be greater than zero.')
    !this.copies.val = !this.modify.copies
    return
  endif

  -- Only perform copy check if we are copying
  if(!this.modify.copy and !this.rotate.val gt 0) then

    -- Check the copies against rotation angle
    !maximum = int(359.99 / !this.rotate.val.abs())

    if(!maximum lt !this.copies.val) then
      !!alert.warning('Maximum number of copies is ' & !maximum & ' given an angle of ' & !this.rotate.val &  ' .')
      !this.copies.val = !maximum
    endif

  endif

  -- Set number of copies
  !this.modify.copies = !this.copies.val

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
------------------------------------------------------------------------

-- Define method
define method .position()

  -- Get current position
  !position    = !this.position.get()

  -- Get direction
  !direction   = !this.modify.rotationLine.direction()

  -- Set rotation line
  !pointVector = object POINTVECTOR(!position, !direction)
  !this.modify.rotationLine(!pointVector.line(2000mm))

  -- Draw
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.defineDirection('')
    !packet.description = !this.edgDescription
    !packet.action      = '!!aidCopyRotate.direction(!this.return[1])'
    !!edgCntrl.add(!packet)

  -- Direction
  else

    -- Check we have an orientation
    !orientation = !!ce.orientation
    handle any
      return
    endhandle

    -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction(!orientation.xDir())
    elseif (!option.match('Y').boolean()) then
      !this.direction(!orientation.yDir())
    else
      !this.direction(!orientation.zDir())
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction
--
------------------------------------------------------------------------

-- Define method
define method .direction()

  -- Initialise Variables
  !string                = !this.direction.val & ' wrt ' & !this.wrtElement
  !direction             = !string.direction()
  handle ANY
    !!alert.warning('Invalid direction given.')
    !this.direction.val  = !this.modify.rotationLine.direction().string().before('WRT').trim()
    return
  endhandle

  -- Update direction
  !this.direction(!direction)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.direction.val = !direction.wrt(!this.wrtElement).string().before('WRT').trim()

  -- Set direction of line
  !pointVector        = object POINTVECTOR(!this.modify.rotationLine.startPosition, !direction.wrt(!this.wrtElement))
  !this.modify.rotationLine(!pointVector.line(2000mm))

  -- Draw
  !this.draw()

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .wrt()

  -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !wrtElement = World
  endhandle

  -- Set with respect to element
  !this.wrtElement = !wrtElement

  -- Get direction
  !direction          = !this.modify.rotationLine.direction().wrt(!wrtElement)
  !this.direction.val = !direction.string().before('WRT')

  -- Set tagging method up
  !this.position.setWrt(!wrtElement)

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rotationPoint
--
-- Description: Packet for picking rotation point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationPoint()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Position Rotation Axis')
  !packet.description    = !this.edgDescription
  !packet.priority       = 1
  !packet.action         = '!!aidCopyRotate.rotationPoint(!this.return[1].position)'
  !packet.key            = 'aidCopyRotate'
  !packet.remove         = false
  !packet.escape         = '!!aidCopyRotate.escape()'
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationPoint
--
-- Description: Set rotation line position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationPoint(!position is POSITION)

  -- Initialise Variables

  -- Check for line
  if(!position.unset()) then
    return
  endif

  -- Initialise variables
  !position  = !position.wrt(!this.wrtElement)
  !direction = !this.modify.rotationLine.direction()

  -- Setup position
  !this.position.position(!position)
  !newPosition = !this.position.position()

  -- Set rotation line
  !this.modify.rotationLine(object POINTVECTOR(!newPosition, !direction))

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationLine
--
-- Description: Packet for picking rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationLine()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to rotate about'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'rotationLine'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!aidCopyRotate.rotationLine(!this.return[1])'
  !packet.remove            = true
  !packet.close             = '!!aidCopyRotate.escape()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationLine
--
-- Description: Define rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationLine(!line is LINE)

  -- Check for line
  if(!line.unset()) then
    return
  endif

  -- Initialise variables
  !position  = !line.startPosition.wrt(!this.wrtElement)
  !direction = !line.direction().wrt(!this.wrtElement)

  -- Setup position
  !this.position.position(!position)
  !this.direction.val = !direction.string().before('WRT').trim()

  -- Set rotation line
  !this.modify.rotationLine(object POINTVECTOR(!position, !direction))

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawAxes
--
-- Description: Draw axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawAxes()

  -- Initialise Variables
  !rotationLine = !this.modify.rotationLine

  -- Clear aids
  AID CLEAR ALL $!<this.aidAxes>

  -- Draw rotation line
  !rotationLine.draw(!this.aidAxes, 4, 5)

  -- Tag rotation line
  !centre = !rotationLine.proportion(0.5)
  AID TEXT NUMBER $!<this.aidAxes> 'Rotation Line' AT $!<centre>

  -- If angle is zero, then don't do anything
  if(!this.rotate.val eq 0 or !this.modify.aidList.empty()) then
    return
  endif

  -- Get first object
  !coreObject        = !this.modify.graphicsList.first().coreObject()
  !firstAid          = !!aidNumbers.get(!this.modify.aidList.first()).coreObject()

  if(!coreObject.attributes().findFirst('POSITION').set()) then
    !fromPosition    = !firstAid.position
    !toPosition      = !coreObject.position
  elseif (!coreObject.objectType() eq 'LINE') then
    !fromPosition    = !firstAid.proportion(0.5)
    !toPosition      = !coreObject.proportion(0.5)
  elseif (!coreObject.objectType() eq 'POSITION') then
    !fromPosition    = !firstAid
    !toPosition      = !coreObject
  endif

  -- Position on rotation line
  !cPosition         = !this.modify.rotationLine.near(!fromPosition)

  -- Define arc from to
  !orientation       = object ORIENTATION('Z is ' & !this.modify.rotationLine.direction() & ' and X is ' & !cPosition.direction(!fromPosition))
  handle ANY
    return
  endhandle

  !arc               = object ARC(!cPosition, !orientation, 0, !this.rotate.val, !cPosition.distance(!fromPosition), !this.rotate.val ge 0)
  !arc.draw(!this.aidAxes, 4, 5)

  -- If radius is near zero, then done do anything
  if(!arc.radius le 1mm) then
    return
  endif

  -- Centre of arc
  !centre            = !arc.anglePosition((!arc.startAngle + !arc.endAngle) / 2)

  AID TEXT NUMBER $!<this.aidAxes> '$!this.rotate.val' AT $!<centre>
  !line = !cPosition.line(!fromPosition)
  !line.draw(!this.aidAxes, 4, 5)
  !line = !cPosition.line(!toPosition)
  !line.draw(!this.aidAxes, 4, 5)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Draw Axes
  !this.drawAxes()

  -- Remove old aid graphics
  !!aidNumbers.hide(!this.aidNumber)

  -- If angle is zero, then don't do anything
  if(!this.rotate.val eq 0 or !this.modify.aidList.empty()) then
    return
  endif

  -- Draw copies
  if(!this.copies.val gt 1 and !this.option.selection().upcase() eq 'COPY') then

    !newAid = !this.modify.graphicsList.first()
    !newAid.displayStyle(4, 2)
    handle ANY
    endhandle


    do from 2 to !this.copies.val
      !newAid        = !this.modify.rotate(!this.rotate.val, !newAid)
      !newAid.detail = false
      !newAid.tag    = false
      !newAid.basic  = true
      handle ANY
      endhandle
      !newAid.draw(!this.aidNumber, false)
    enddo

  endif

  -- Draw modified aids
  do !aid values !this.modify.graphicsList
    !aid.detail = false
    !aid.tag    = false
    !aid.basic  = true
    handle ANY
    endhandle
    !aid.displayStyle(4, 2)
    handle ANY
    endhandle

    !aid.draw(!this.aidNumber, false)
  enddo

endmethod
-- End of method
