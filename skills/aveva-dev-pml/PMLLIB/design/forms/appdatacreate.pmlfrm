--  File:            appdatacreate.pmlfrm
--    Type:          Form Definition
--    Group:         Design
--      Keyword:     Application Data
--    Module:        Design
--  Author:          Steve Bentley
--  Created:         Wed May 12 10:00:00 2010
--
--  Description:     Create application data top level elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   OK callback
--  create()                         -
--  init()                           -
--
setup form !!appDataCreate at xr 0 yr 0

  title    |Create|
  init     |!this.init()|

 -- Template Name
  text .name   |Name       | at x0.5 ymax callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 32 name

 -- Data
  option .purp |Purpose    |     at xmin ymax width 30
  text   .desc |Description| at xmin ymax width 32 string

 -- Bottom Line
  button .apply   |  OK  | at xmin form+0 ymax+0.5 call |!this.apply()|
  button .dismiss |Cancel| at xmax form-size ymin  cancel

 -- Userdata
  -- Creation mode flag
  member .mode         is STRING
  -- Create type
  member .type         is STRING
  -- Item to Modify/place to create
  member .current      is DBREF
  -- Assembly name to be modified
  member .assemblyName is STRING

-- End of form definition
exit

-------------------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------------
define method .init()

  !purp[1] = 'Standard Model Library'
  !text[1] = 'STDM'

  !this.purp.dtext = !purp
  !this.purp.rtext = !text

  -- Clear Name and Description
  if !this.mode.neq('modify') then
    !this.name.val = ''
    !this.desc.val = ''
  endif

  !!ce = !this.current

endmethod

-------------------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: OK callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------------
define method .apply()

  -- handle any errors on create or modify
  !this.create()
  handle any
    !!alert.error(!!error.text)
    return
  endhandle

  !this.hide()

endmethod

-------------------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create new application data elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------------
define method .create()

  !!ce = !this.current
  --check that the name gadget is populated
  if !this.name.val.eq('unset').or(!this.name.val.trim().eq('')) then
    return error 1 'Please enter a name for the element'
  elseif !this.desc.val.trim().eq('')then
    return error 1 'Please enter a description for the element'
  endif

  if !this.mode.eq('modify') then
    !!ce = !this.current
    NAME $!this.name
    PURP $!this.purp
    DESC '$!this.desc'
    if !this.type.eq('APPLDW') then
      !this.owner().getWorld(1)
    elseif  !this.type.eq('APPDAR') then
      !this.owner().getWorld(2)
    elseif !this.type.eq('APPLDA') then
      ZONE $!this.assemblyName-ZONE
      handle ANY
        -- Name must not exist anymore
        1 ZONE
        handle ANY
        elsehandle NONE
          !this.owner().selectCurrent(!!ce)
        endhandle
      elsehandle NONE
        NAME $!this.name-ZONE
        PURP $!this.purp
        !this.owner().selectCurrent(!!ce)
      endhandle
    endif

  else
    !!ce = !this.current
    if (!!ce.type neq 'WORL') then
      TAIL
    endif
    NEW  $!this.type
    !me = !!ce
    NAME $!this.name
    PURP $!this.purp
    DESC '$!this.desc'
    if !this.type.eq('APPLDW') then
      !this.owner().getWorld(1)
    !this.owner().selectCurrent(!me)
    elseif  !this.type.eq('APPDAR') then
      !this.owner().getWorld(2)
    !this.owner().selectCurrent(!me)
    elseif !this.type.eq('APPLDA') then
      NEW zone  $!this.name-ZONE
      PURP $!this.purp
      !this.owner().selectCurrent(!!ce)
      !this.owner().getWorld(3)
    endif
  endif

endmethod
