  !menu.add('CALLBACK', 'Update from Template', 'show !!tmplInstanceUpdate', 'updateFromOriginal')

  -- Hierarchy menu
  !menu = !this.newMenu('sysHier')
  !menu.add('CALLBACK', 'Include...', 'CALLIB UFORMS MEMB _CDCINCLUDE', 'Include')
  !menu.add('CALLBACK', 'Reverse Order', 'CALLIB MREOREV', 'ReverseOrder')
  !menu.add('FORM', 'Reorder...', 'reorderHierarchy', 'Reorder')


  -- Copy Attributes Like
  !menu = !this.newMenu('sysLike')
  !menu.add('CALLBACK', 'picked element', 'CALLG MCOPYLIKE ID   CE', 'pickedElement')
  !menu.add('CALLBACK', 'current element', 'CALLG MCOPYLIKE CE   ID', 'currentElement')
  !menu.add('CALLBACK', 'CE into list', 'CALLG MCOPYLIKE CE LIST', 'CEintolist')

  -- Deletion Menu
  !menu = !this.newMenu('sysDel')
  !menu.add('CALLBACK', |CE|,         |!!deleteCE()|, 'CE')
  !menu.add('CALLBACK', |Identified|, |CALLIB MDELMULTI PICK|, 'Identified')
  !menu.add('CALLBACK', |List|,       |CALLIB MDELMULTI LIST|, 'List')
  !menu.add('CALLBACK', |Name...|,    |show _CDCDELNAME|,      'Name')
  !menu.add('MENU',     |Members|,    |sysDelMem|,             'Members')

  -- Delete Members Menu
  !menu = !this.newMenu('sysDelMem')
  !menu.add('FORM', 'Selection...', 'CDCDELSEL', 'Selection')
  !menu.add('CALLBACK', 'All', '!!deleteMembers()', 'All')

  -- build module menus
  !!moduleMenus(!this)

  -- add menus for other applications
  !!appCntrl.modifyMenus()
endmethod
-- End of method definition for .appDesMain()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: takes the place of the DES\GEN\ISYSTEM macro
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

--CW set default Insulation and Tracing specs--
  !this.defInsul = 1
  !this.defTrac = 1


  -- Setup positioning control gadgets
  if(defined(!!edgPosCntrl)) then
    !!edgPosCntrl.showActive()
  endif

  -- set the autoclash toggle
  if (defined(!this.sysCla)) then
    var !clash AUTOCLASH
    !this.sysCla.val = !clash.boolean()
  endif

  -- Build the active list option
  if (defined(!this.list)) then
    !listForm = !!cdcList
    !this.list.dtext = !listForm.name.dtext
    !this.list.rtext = !listForm.name.rtext
    !this.list.val = !listForm.name.val
    handle ANY
    endhandle
  endif

  -- Update the navigate button
  !this.navigate()
  handle ANY
  endhandle

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      .navigate()
--
-- Description: set edg navigate depending on the navigate toggle
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigate()

  -- set edg navigate depending on the navigate toggle
  if (!this.mtbNavigate.val) then
    if (!!gphViews.navigate().not()) then
      !this.mtbNavigate.val = FALSE
    endif
  else
    !!edgCntrl.remove('Standard Navigate')
  endif

endmethod
-- End of method definition for .navigate()
------------------------------------------------------------------------
--
--Method: .systemExplorer()
--
-- Description: Callback to control whether the system explorer is shown or not
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .systemExplorer()

	if(defined(!!systemDesign))then
	  if(!!systemDesign.shown())then
	  	hide !!systemDesign
	    !this.explorersMenu.setFieldProperty('System Explorer','selected',false)
	  else
	    show !!systemDesign
	    !this.explorersMenu.setFieldProperty('System Explorer','selected',true)
	  endif
	else
	   show !!systemDesign
	   !this.explorersMenu.setFieldProperty('System Explorer','selected',true)
	endif

endmethod
-- End of method definition for .systemExplorer

-----------------------------------------------------------------------
--
-- Method:      .track()
--
-- Description: set edg navigate depending on the navigate toggle
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

  -- Test gap since last savework if the function is loaded (UNSUPPORTED)
  -- Using CE change as a convenient event to trigger the test
  !!appHsave.check()
  handle any
  endhandle

endmethod
-- End of method definition
------------------------------------------------------------------------
--
--Method: .addLink()
--
-- Description: Callback to display the AddLink Dialog (LinkDocuments)
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addLink()

  import 'linksaddin'
  handle(1000,0)
  endhandle
  using namespace 'Aveva.Pdms.LinksAddin'
  !aa = object PMLENTRY()
     handle (46,87)
      -- Errors here if addin not present. (Defect 3742)
      return
     endhandle
  !aa.addLink()

endmethod
-- End of method definition for .addLink()
