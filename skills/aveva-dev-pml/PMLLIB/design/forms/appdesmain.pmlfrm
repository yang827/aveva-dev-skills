--
-- File:            appdesmain.pmlfrm
--   Type:          Form Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        design
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Thu Jan 29 17:12:15 2004
--
--
-- Description:     Main form for Design
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addLink()                        -                   Callback to display the AddLink Dialog (LinkDocuments)
--  appDesMain()                     -                   Constructor method
--  initialise()                     -                   takes the place of the DES\GEN\ISYSTEM macro
--  navigate()                       -                   set edg navigate depending on the navigate toggle
--  systemExplorer()                 -                   Callback to control whether the system explorer is shown or not
--  track()                          -                   set edg navigate depending on the navigate toggle
--
------------------------------------------------------------------------
setup form !!appDesMain at xr 0 yr 0 main VarChars
  -- get list of applications
  if (undefined(!!appCntrl)) then
    !!appreadappdefns('DES')
  endif

  if( defined(!!appHsave) ) then
      -- allow tracking only if UNSUPPORTED auto save is installed
      -- this is used to check the time since last savework
      track |DESICE|  call '!this.track()'
  endif

  -- !iconSize = !!comSysOpt.iconSize()
  -- icon size is now 16 because we can't change the size of icons on toolbars
 !iconSize = 16

  title     |Design - AVEVA PDMS|
  iconTitle |Design - AVEVA PDMS|
  revision  | $$Revision: 1.17 $ |
  !this.quitCall = |CALLIB XEXIT|

  -- Main bar Menu
  bar
    add |Design|    _sysDes
    add |Display|   _sysView
      add |Edit|      _coreEditMenu
      add |View|      _coreViewMenu
      add |Selection| _coreSelectMenu
    add |Query|     _sysQry
    add |Settings|  _sysSet
    add |Utilities| _sysUtil
    add |Create|    _sysCrt
    add |Modify|    _sysMod
    add |Delete|    _sysDel
    add window
    add help
  exit

  -- define toolbar icons
  -------------------------------------------
  -- Main toolbar
  -------------------------------------------
  -- get work
  button .mtbGetWork 'Get Work' tooltip 'Get Work' pixmap width $!iconSize height $!iconSize callback |GETWORK|

  -- save work
  button .mtbSaveWork 'Save Work' tooltip 'Save Work' pixmap width $!iconSize height $!iconSize callback |CALLG MSAVEW|

  -- Add CE to drawlist
  button .mtbAddCe 'Add CE to Drawlist' tooltip 'Add CE to Drawlist' pixmap width $!iconSize height $!iconSize callback |CALLG MADDELEM CE|

  -- Remove CE from drawlist
  button .mtbRemoveCe 'Remove CE from Drawlist' tooltip 'Remove CE from Drawlist' pixmap width $!iconSize height $!iconSize callback |REMOVE CE|

  -- Remove All from drawlist
  button .mtbRemoveAll 'Remove All from Drawlist' tooltip 'Remove All from Drawlist' pixmap width $!iconSize height $!iconSize callback |REMOVE ALL|

  -- List Creation/modification
  button .mtbCreateList 'Create/Modify Lists' tooltip 'Create/Modify Lists' pixmap width $!iconSize height $!iconSize callback |CALLIB SHOWFORM _CDCLIST|

  -- Active List/Collection
  option .list at xmax tooltip 'Active List' callback |CALLIB ILIST $$_list| width 15

  -- Delete CE
  button .mtbDeleteCe 'Delete CE' tooltip 'Delete CE' pixmap width $!iconSize height $!iconSize callback |!!deleteCE()|

  ----------------------------------------------------------------------------------------------------------------------------------
  --  DO NOT ATTEMPT TO MODIFY THE NAMES OR DEFINITIONS OF ANY .core BUTTONS.  THESE ARE CONTROLLED BY PDMS DESIGN CORE.
  ----------------------------------------------------------------------------------------------------------------------------------
  ---- Graphical interaction model editor, undo & redo buttons
    !modifyIcon     = !!pml.getPathName('editmodel' & !iconSize & '.png')
    !undoIcon     = !!pml.getPathName('activeundo' & !iconSize & '.png')
    !redoIcon     = !!pml.getPathName('activeredo' & !iconSize & '.png')
    frame .modelEditorToolbar toolbar 'Model Editor'
      button .coreModifyButton toggle 'Model Editor' tooltip 'Model Editor'  pixmap "$!<modifyIcon>" width $!iconSize height $!iconSize
      button .coreUndoButton          'Undo'         tooltip 'Undo'          pixmap "$!<undoIcon>"   width $!iconSize height $!iconSize
      button .coreRedoButton          'Redo'         tooltip 'Redo'          pixmap "$!<redoIcon>"   width $!iconSize height $!iconSize
    exit
    !this.coreUndoButton.active = false
    !this.coreRedoButton.active = false
    !this.coreModifyButton.val  = false
    !!appTbarCntrl.addToolbar('modelEditorToolbar')

  frame .utilitiesToolbar toolbar 'Utilities'
    -- single navigate
    button .mtbNavigate toggle 'Navigate to Element' tooltip 'Navigate to Element' pixmap width $!iconSize height $!iconSize callback |!this.navigate()|

    -- distance measure
    button .mtbMeasure 'Measure Distance' tooltip 'Measure Distance' pixmap width $!iconSize height $!iconSize callback |!!gphViews.measure('DISTANCE')|

    -- angle measure
    button .mtbAngleMeasure 'Measure Angle' tooltip 'Measure Angle' pixmap width $!iconSize height $!iconSize callback |!!gphViews.measure('ANGLE')|

    -- target position
    button .mtbTargetPosition 'Query Target Position' tooltip 'Query Target Position' pixmap width $!iconSize height $!iconSize callback |show !!queryPosition|

    -- axes on CE
    button .mtbAxes 'Display Axes on CE' tooltip 'Display Axes on CE' pixmap width $!iconSize height $!iconSize callback |!!gphViews.tag('AXES')|

    -- Auto Clasher toggle
    !autoCPix = !!pml.getPathName('autoclashoff' & !iconSize & '.png')
    button .sysCla toggle 'Auto Clash' tooltip 'Auto Clash' pixmap "$!<autoCPix>" width $!iconSize height $!iconSize callback |CALLCL XAUTO $$_sysCla|
  exit
  !!appTbarCntrl.addToolbar('utilitiesToolbar')

  -- set pixmaps for above buttons
  !this.mtbGetWork.addPixmap(!!pml.getPathName('getwork' & !iconSize & '.png'))
  !this.mtbSaveWork.addPixmap(!!pml.getPathName('savework' & !iconSize & '.png'))
  !this.mtbAddCe.addPixmap(!!pml.getPathName('addce' & !iconSize & '.png'))
  !this.mtbRemoveCe.addPixmap(!!pml.getPathName('removece' & !iconSize & '.png'))
  !this.mtbRemoveAll.addPixmap(!!pml.getPathName('removeall' & !iconSize & '.png'))
  !this.mtbNavigate.addPixmap(!!pml.getPathName('navigate' & !iconSize & '.png'))
  !this.mtbMeasure.addPixmap(!!pml.getPathName('measure' & !iconSize & '.png'))
  !this.mtbAngleMeasure.addPixmap(!!pml.getPathName('angle' & !iconSize & '.png'))
  !this.mtbTargetPosition.addPixmap(!!pml.getPathName('pickpos' & !iconSize & '.png'))
  !this.mtbAxes.addPixmap(!!pml.getPathName('axes' & !iconSize & '.png'))
  !this.mtbDeleteCe.addPixmap(!!pml.getPathName('deletece' & !iconSize & '.png'))
  !this.mtbCreateList.addPixmap(!!pml.getPathName('createlist' & !iconSize & '.png'))

  -- Positioning data
  -- Working Plane
  !wpOn  = !!pml.getPathName('workingplaneon' & !iconSize & '.png')
  !wpOff = !!pml.getPathName('workingplaneoff' & !iconSize & '.png')
  !offsetPosition = !!pml.getPathName('offsetposition16.png')

  frame .edgPositioningToolbar toolbar 'Positioning Control'
    button .wp toggle 'Turn working plane on/off' tooltip 'Turn working plane on/off' pixmap unsel "$!<wpOff>" sel "$!<wpOn>" width $!iconSize height $!iconSize

    -- Pick Types  (Element, Pline, etc)
    option .pick     width  8

    -- Pick Option (position deriving mechanism)
    option .pickType width 10

    -- Explicit Positioning Form
    if(undefined(!!edgFormat)) then
      !!edgFormat = object FORMAT()
    endif
    text   .input    width 14 is REAL format !!edgFormat

    -- Explicit position pick form
    !explicitIcon         = !!pml.getPathName('xyz' & !iconSize & '.png')
    button .explicit 'Explicit Position' tooltip 'Explicit Position' pixmap "$!<explicitIcon>" width $!iconSize height $!iconSize callback |!!edgPosition()|
    button .offsetToggle toggle  'Offset Position'   tooltip 'Offset Position'   pixmap "$!<offsetPosition>" width $!iconSize height $!iconSize callback |!!edgPosCntrl.offsetToggle(!this.offsetToggle.val)|
  exit
  !this.edgPositioningToolbar.active = false
--CW storing default insulation and tracing specs
  member .defInsul is REAL
  member .defTrac  is REAL
  member .currentslope is REAL
  -- now load all the toolbars for the other applications
  !!appCntrl.modifyForm()
exit

------------------------------------------------------------------------
--
-- Method:      .appDesMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appDesMain()
  -- set initialisation callback
  !this.initcall = '!this.initialise()'

  -- find current project and global status
  !project = current project
  !isGlobal = !project.isGlobal()
  !marine = FALSE
  !mod = !!module()
  if (!mod.modkey eq 'marodes') then
    !marine = TRUE
  endif

  -- initialise EDG offet to be switched off
  !this.offsetToggle.val = false

  -- Design Menu
  !menu = !this.newMenu('sysDes')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Save Work', 'CALLG MSAVEW', 'savework')
  !menu.add('CALLBACK', 'Get Work', 'GETWORK', 'getwork')
  !menu.add('CALLBACK', 'Extract Control...', 'call !!admExtractCntrl()', 'extractControl')
  !menu.add('CALLBACK', 'Session Comment...', 'show !!msgsavework', 'sessionComment')
  !menu.add('SEPARATOR')
  -- Application Definitions
  !!appCntrl.appMenu(!menu, |!!appxload('MODULE', 'APPNAME', false)|)
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Modules', 'modules', 'modules')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Exit', 'CALLIB XEXIT', 'exit')

  -- View Menu
  !menu = !this.newMenu('sysView')
  !menu.add('CALLBACK', 'Graphical View',      '!!gphViews.addDesign()' ,          'graphicalView')
  !menu.add('FORM',     'View Control...',     'gphControl',                       'viewControl')
  !menu.add('FORM',     'Plot View...',        'plotView',                         'plotView')
  !menu.add('SEPARATOR')
  !explorersMenu = !this.newMenu('explorersMenu')
  !menu.add('MENU', 'Explorers', 'explorersMenu')
  !moduleManager = object AVEVAMODULEMANAGER()
  if (!moduleManager.currentModule().name().upcase() eq 'DESIGN') then
     !explorersMenu.add('TOGGLE',   'Design Explorer',     '',                                 'Design Explorer')
     !explorersMenu.add('TOGGLE',   'Schematic Explorer',     '',                              'Schematic Explorer')
     !explorersMenu.add('TOGGLE',   'System Explorer',     '',           'System Explorer')
     !explorersMenu.add('TOGGLE',   'Fabrication Explorer',     'call !!pffabexplorer()',       'Fabrication Explorer ')
  elseif (!moduleManager.currentModule().name().upcase() eq 'OUTFITTING') then
     !explorersMenu.add('TOGGLE',   'Design Explorer',     '',                                 'Design Explorer')
     !explorersMenu.add('TOGGLE',   'Schematic Explorer',     '',                              'Schematic Explorer')
     !explorersMenu.add('TOGGLE',   'Manufacturing Explorer',     '',                          'Manufacturing Explorer')
     !explorersMenu.add('TOGGLE',   'Draft Explorer',     '',                          'Draft Explorer')
     !explorersMenu.add('TOGGLE',   'System Explorer',     '',           'System Explorer')
     !explorersMenu.add('TOGGLE',   'Fabrication Explorer',     'call !!pffabexplorer()',       'Fabrication Explorer ')
  endif
  !menu.add('CALLBACK', 'Drawlist',            '!!gphViews.drawlist()' ,           'sysViewDrawlist')
  !menu.add('TOGGLE',   'My Data',             '',                                 'My Data')
  !menu.add('TOGGLE',   'Reference List',      '',                                 'Reference List')
  !menu.add('TOGGLE',   'Attributes...',  '',                                 'Attributes Utility')
  !menu.add('TOGGLE',   'Search...',  '',                                       'Find Utility')
  !menu.add('TOGGLE',   'Search Results...',  '',                                       'Output Utility')
  if (!marine) then
     !menu.add('TOGGLE',   'Assembly Planning ',  '',                                 'Assembly Planning')
     !menu.add('TOGGLE',   'Catalog Search ',  '',                                 'Catalog Search')
     !menu.add('TOGGLE',   'Design Reuse ',  '',                                 'Design Reuse')
  endif
  !linksMenu = !this.newMenu('linksMenu')
  !menu.add('MENU',   'Link Documents',  'linksMenu')
  !linksMenu.add('CALLBACK', 'Add Link...',    '!this.addLink()')
  !linksMenu.add('TOGGLE',   'Links',  '',      'Links List')
  !menu.add('SEPARATOR')
  !menu.add('TOGGLE',   'Status Controller',  '',                                       'Status Controller')
   !compareUpdateMenu = !this.newMenu('compareUpdateMenu')
   !menu.add('MENU',   'Compare / Update',  'compareUpdateMenu','compareUpdateMenu')
   !compareUpdateMenu.add('CALLBACK', 'Open', '', 'Compare / Update')
   !compareUpdateMenu.add('CORECALLBACK', 'Compare Draw List', '',   'Compare Graphical List')
   !compareUpdateMenu.add('CORECALLBACK', 'Compare Current Selection', '',   'Compare Graphical Selection')
   !compareUpdateMenu.add('CORECALLBACK', 'Compare CE', '',   'Compare CE')
  !menu.add('SEPARATOR')
   if (!marine) then
     !menu.add('TOGGLE',   'Edit Members ',  '',                                 'EditElements')
  endif
  !menu.add('CALLBACK', 'Members...',          'CALLIB UFORMS MEMB _CDCMEMBER FREE',    'members')
  !menu.add('CALLBACK', 'Advanced Members...', 'CALLIB UFORMS MEMB _CDCADVMEMBER FREE', 'advMembers')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Command Window...',     'show _cadcBth free',               'commandLine')

    -------------------------------------------
    -- Add core callbacks for NextGen menus
    -------------------------------------------
    -- View menu
    !coreViewMenu = !this.newMenu('coreViewMenu')
    !coreMiddleButtonDrag = !this.newMenu('coreMiddleButtonDrag')
    !coreViewMenu.add('MENU', 'Middle Button Drag', 'coreMiddleButtonDrag')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Zoom Rectangle', '','V_ZOOR')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Zoom In/Out','', 'V_ZOOM')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Rotate','', 'V_ROTE')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Pan', '','V_PANN')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Walk','', 'V_WALK')
    !coreViewMenu.add('SEPARATOR')

    !coreViewMenu.add('CORECALLBACK', 'Print Graphics...', '', 'V_PRNG')

    !coreCopyImage = !this.newMenu('coreCopyImage')
    !coreViewMenu.add('MENU', 'Copy Image', 'coreCopyImage')
    !coreCopyImage.add('CORECALLBACK', '640x480','', 'V_CPY1')
    !coreCopyImage.add('CORECALLBACK', '800x600', '','V_CPY2')
    !coreCopyImage.add('CORECALLBACK', '1024x768', '','V_CPY3')
    !coreCopyImage.add('CORECALLBACK', '1600x1200','', 'V_CPY4')
    !coreViewMenu.add('SEPARATOR')

    !coreZoomTo = !this.newMenu('coreZoomTo')
    !coreViewMenu.add('MENU', 'Zoom To', 'coreZoomTo')
    !coreZoomTo.add('CORECALLBACK', 'Selection', '','V_ZSEL')
    !coreZoomTo.add('CORECALLBACK', 'Identify Element...','', 'V_ZELE')
    !coreZoomTo.add('CORECALLBACK', 'Entire Draw List', '','V_ZDRW')

    !coreWalkTo = !this.newMenu('coreWalkTo')
    !coreViewMenu.add('MENU', 'Walk To', 'coreWalkTo')
    !coreWalkTo.add('CORECALLBACK', 'Selection', '','V_WSEL')
    !coreWalkTo.add('CORECALLBACK', 'Identify Element...','', 'V_WELE')
    !coreWalkTo.add('CORECALLBACK', 'Entire Draw List', '','V_WDRW')
    !coreViewMenu.add('SEPARATOR')

    !coreSaveView = !this.newMenu('coreSaveView')
    !coreViewMenu.add('MENU', 'Save View', 'coreSaveView')
    !coreSaveView.add('CORECALLBACK', 'View 1', '','V_SAV1')
    !coreSaveView.add('CORECALLBACK', 'View 2', '','V_SAV2')
    !coreSaveView.add('CORECALLBACK', 'View 3', '','V_SAV3')
    !coreSaveView.add('CORECALLBACK', 'View 4', '','V_SAV4')

    !coreRestoreView = !this.newMenu('coreRestoreView')
    !coreViewMenu.add('MENU', 'Restore View', 'coreRestoreView')
    !coreRestoreView.add('CORECALLBACK', 'View 1', '','V_REV1')
    !coreRestoreView.add('CORECALLBACK', 'View 2', '','V_REV2')
    !coreRestoreView.add('CORECALLBACK', 'View 3', '','V_REV3')
    !coreRestoreView.add('CORECALLBACK', 'View 4', '','V_REV4')
    !coreViewMenu.add('SEPARATOR')

    !coreLook = !this.newMenu('coreLook')
    !coreViewMenu.add('MENU', 'Look', 'coreLook')
    if (!marine) then
      !coreLook.add('CORECALLBACK', 'Y', '','V_LNOR')
      !coreLook.add('CORECALLBACK', '-Y', '','V_LSOU')
      !coreLook.add('CORECALLBACK', 'X', '','V_LEAS')
      !coreLook.add('CORECALLBACK', '-X', '','V_LWES')
      !coreLook.add('CORECALLBACK', 'Z', '','V_LUPP')
      !coreLook.add('CORECALLBACK', '-Z', '','V_LDOW')
    else
      !coreLook.add('CORECALLBACK', 'North', '','V_LNOR')
      !coreLook.add('CORECALLBACK', 'South', '','V_LSOU')
      !coreLook.add('CORECALLBACK', 'East', '','V_LEAS')
      !coreLook.add('CORECALLBACK', 'West', '','V_LWES')
      !coreLook.add('CORECALLBACK', 'Up', '','V_LUPP')
      !coreLook.add('CORECALLBACK', 'Down', '','V_LDOW')
    endif

    !corePlan = !this.newMenu('corePlan')
    !coreViewMenu.add('MENU', 'Plan', 'corePlan')
    if (!marine) then
      !corePlan.add('CORECALLBACK', 'Y', '','V_PNOR')
      !corePlan.add('CORECALLBACK', '-Y', '','V_PSOU')
      !corePlan.add('CORECALLBACK', 'X', '','V_PEAS')
      !corePlan.add('CORECALLBACK', '-X', '','V_PWES')
    else
      !corePlan.add('CORECALLBACK', 'North', '','V_PNOR')
      !corePlan.add('CORECALLBACK', 'South', '','V_PSOU')
      !corePlan.add('CORECALLBACK', 'East', '','V_PEAS')
      !corePlan.add('CORECALLBACK', 'West', '','V_PWES')
    endif

    !coreIsometric = !this.newMenu('coreIsometric')
    !coreViewMenu.add('MENU', 'Isometric', 'coreIsometric')
    !coreIsometric.add('CORECALLBACK', 'ISO 1', '','V_ISO1')
    !coreIsometric.add('CORECALLBACK', 'ISO 2', '','V_ISO2')
    !coreIsometric.add('CORECALLBACK', 'ISO 3', '','V_ISO3')
    !coreIsometric.add('CORECALLBACK', 'ISO 4', '','V_ISO4')
    !coreViewMenu.add('SEPARATOR')

    !coreSetCentreofView = !this.newMenu('coreSetCentreofView')
    !coreViewMenu.add('MENU', 'Set Centre of View', 'coreSetCentreofView')
    !coreSetCentreofView.add('CORECALLBACK', 'Selection', '','V_CSEL')
    !coreSetCentreofView.add('CORECALLBACK', 'Identify Element...', '','V_CELE')
    !coreSetCentreofView.add('CORECALLBACK', 'Screen Pick...','', 'V_CPIK')
    !coreViewMenu.add('SEPARATOR')

    !coreViewSettings = !this.newMenu('coreViewSettings')
    !coreViewMenu.add('MENU', 'Settings', 'coreViewSettings')
    !coreViewSettings.add('CORETOGGLE', 'Eye', '','V_EYEM')
    !coreViewSettings.add('CORETOGGLE', 'Shaded','','V_SHAD')
    !coreViewSettings.add('CORETOGGLE', 'Borders','', 'V_BORD')
    !coreViewSettings.add('CORETOGGLE', 'Perspective','','V_PERS')
    !coreViewSettings.add('SEPARATOR')
    !coreViewSettings.add('CORETOGGLE', 'Black Background','', 'V_BLKB')
    !coreViewSettings.add('CORETOGGLE', 'White Background', '','V_WHIB')
    !coreViewSettings.add('SEPARATOR')
    !coreViewSettings.add('CORETOGGLE', 'High Quality', '','V_QUAL')
    !coreViewSettings.add('CORETOGGLE', 'Show Tooltips', '','V_TTIP')
    !coreViewSettings.add('CORETOGGLE', 'Animations', '','V_ANIM')

    -------------------------------------------
    -- Edit Menu
    !coreEditMenu = !this.newMenu('coreEditMenu')
    !coreEditMenu.add('CORETOGGLE', 'Model Editor', '','E_MOED')
    !coreEditMenu.add('SEPARATOR')
    !coreEditMenu.add('CORECALLBACK', 'Undo', '','E_UNDO')
    !coreEditMenu.add('CORECALLBACK', 'Redo', '','E_REDO')
    !coreEditMenu.add('CORECALLBACK', 'Re-Select', '','E_RESE')
    !coreEditMenu.add('SEPARATOR')

    !coreMoveSelection = !this.newMenu('coreMoveSelection')
    !coreEditMenu.add('MENU', 'Move Selection', 'coreMoveSelection')
    !coreMoveSelection.add('CORECALLBACK', 'Offset in 3D...', '','E_SMO3')
    !coreMoveSelection.add('CORECALLBACK', 'Set 3D Position...','', 'E_SM3D')
    !coreMoveSelection.add('CORECALLBACK', 'Snap to Point...','', 'E_SMSN')

    !coreRotateSelection = !this.newMenu('coreRotateSelection')
    !coreEditMenu.add('MENU', 'Rotate Selection','coreRotateSelection')
    !coreRotateSelection.add('CORECALLBACK', 'To World', '','E_SRWO')
    !coreRotateSelection.add('CORECALLBACK', 'About X...','', 'E_SRAX')
    !coreRotateSelection.add('CORECALLBACK', 'About Y...', '','E_SRAY')
    !coreRotateSelection.add('CORECALLBACK', 'About Z...', '','E_SRAZ')
    !coreEditMenu.add('SEPARATOR')

    !coreMoveHandle = !this.newMenu('coreMoveHandle')
    !coreEditMenu.add('MENU', 'Move Handle', 'coreMoveHandle')
    !coreMoveHandle.add('CORECALLBACK', 'Offset in 3D...','', 'E_HMO3')
    !coreMoveHandle.add('CORECALLBACK', 'Set 3D Position...','', 'E_HM3D')
    !coreMoveHandle.add('CORECALLBACK', 'Snap to Point...','', 'E_HMSN')

    !coreRotateHandle = !this.newMenu('coreRotateHandle')
    !coreEditMenu.add('MENU', 'Rotate Handle', 'coreRotateHandle')
    !coreRotateHandle.add('CORECALLBACK', 'To World', '','E_HRWO')
    !coreRotateHandle.add('CORECALLBACK', 'About X...','', 'E_HRAX')
    !coreRotateHandle.add('CORECALLBACK', 'About Y...', '','E_HRAY')
    !coreRotateHandle.add('CORECALLBACK', 'About Z...','', 'E_HRAZ')
    !coreEditMenu.add('SEPARATOR')
    !coreEditMenu.add('CALLBACK', 'Delete Selection', '!!deleteSelection()','E_DELS')

    -------------------------------------------
    -- Selection Menu
    !coreSelectMenu = !this.newMenu('coreSelectMenu')
    !coreSelectMenu.add('CORETOGGLE', 'Feature Highlighting', '','S_FHMO')
    !coreSelectMenu.add('SEPARATOR')
    !coreSelectMenu.add('CORECALLBACK', 'Set Increments...', '','S_SINC')
    !coreSelectMenu.add('SEPARATOR')

    !coreSetHandleColour = !this.newMenu('coreSetHandleColour')
    !coreSelectMenu.add('MENU', 'Set Handle Colour','coreSetHandleColour')
    !coreSetHandleColour.add('CORETOGGLE', 'White', '','S_HCWH')
    !coreSetHandleColour.add('CORETOGGLE', 'Orange', '','S_HCOR')
    !coreSetHandleColour.add('CORETOGGLE', 'Blue', '','S_HCBL')
    !coreSetHandleColour.add('CORETOGGLE', 'Green', '','S_HCGR')
    !coreSetHandleColour.add('CORETOGGLE', 'Cyan', '','S_HCCY')
    !coreSetHandleColour.add('CORETOGGLE', 'Magenta', '','S_HCMA')
    !coreSetHandleColour.add('CORETOGGLE', 'Yellow', '','S_HCYE')

    !coreDragImage = !this.newMenu('coreDragImage')
    !coreSelectMenu.add('MENU', 'Drag Image', 'coreDragImage')
    !coreDragImage.add('CORETOGGLE', 'Solid', '','S_DISO')
    !coreDragImage.add('CORETOGGLE', 'Translucent', '','S_DITR')
    !coreDragImage.add('CORETOGGLE', 'Wireline', '','S_DIWL')
    !coreSelectMenu.add('SEPARATOR')

    !coreSelectRectangle = !this.newMenu('coreSelectRectangle')
    !coreSelectMenu.add('MENU', 'Select Rectangle', 'coreSelectRectangle')
    !coreSelectRectangle.add('CORETOGGLE', 'Wholly Within', '','S_WHWM')
    !coreSelectRectangle.add('CORETOGGLE', 'Wholly and Partially Within','', 'S_WPWM')
    --  !coreSelectRectangle.add('CORECALLBACK', 'SelectCubeMode','', 'S_CUBE')
    --  !coreSelectRectangle.add('CORECALLBACK', 'SelectRectMode', '','S_RECT')
    -------------------------------------------

  -- Graphical View
  !menu = !this.newMenu('sysGphViews')
  !menu.add('CALLBACK', 'Design (EDG)', '!!gphViews.addDesign()', 'DesignEDG')
