  show _CDCATTGLOB', 'AttributesGlobal')
  !menu.add('MENU', 'Like', 'sysLike', 'Like')
  !menu.add('FORM', 'Lock...', 'CDLOCK', 'Lock')
  !menu.add('MENU', 'Hierarchy', 'sysHier', 'Hierarchy')
