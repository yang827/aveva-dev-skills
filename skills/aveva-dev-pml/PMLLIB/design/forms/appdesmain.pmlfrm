  -- Report menu
  !menu = !this.newMenu('sysRep')
  !menu.add('CALLBACK', 'Run...', 'CALLIBR XREPSEL RUN', 'Run')
  !menu.add('CALLBACK', 'Create...', 'CALLIBR XREPDEF', 'Create')
  !menu.add('CALLBACK', 'Modify...', 'CALLIBR XREPSEL MODIFY', 'Modify')
  !menu.add('CALLBACK', 'Delete...', 'CALLIBR XREPSEL DELETE', 'Delete')

   -- Dev Xpress Reporting menu
  !menu = !this.newMenu('sysExpReporting')
  !menu.add('CALLBACK', 'Run Report...', '', 'Run Report')
  !menu.add('CALLBACK', 'Designer...', '', 'Reporting Designer')

  var !user user
  !u=object user(!user)
  !teamList = !u.teamList()
  do !teamName values !teamList
    if (!teamName.name eq 'AVEVANETADMIN') then
      !menu.add('SEPARATOR')
