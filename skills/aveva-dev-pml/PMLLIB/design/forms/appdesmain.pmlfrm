  !menu.add('CALLBACK', 'Delete...', 'CALLXR XEXPMAIN DELETE', 'Delete')
  !menu.add('CALLBACK', 'Dump Attributes...', 'show !!cdxattdump at xr 0.5 yr 0.5', 'DumpAttributes')
  !menu.add('CALLBACK', 'Select Driver ...', 'CALLXR INIT
  show _CDXDRVSEL', 'SelectDriver')

  -- Mass Properties
  !menu = !this.newMenu('sysMassProp')
  !menu.add('FORM', 'Weight and Centre of Gravity...', 'massCofg', 'weightAndCofg')
  !menu.add('FORM', 'Surface Area...', 'massSurface', 'surfaceArea')
  !menu.add('FORM', 'Volume...', 'massVolume', 'volume')

  -- Create Menu
  !menu = !this.newMenu('sysCrt')
  !menu.add('MENU', 'Copy', 'sysCopy', 'Copy')
  !menu.add('CALLBACK', 'Site...', 'CALLG XCRTPURP SITE $$<Create Site$$>', 'Site')
  !menu.add('CALLBACK', 'Zone...', 'CALLG XCRTPURP ZONE $$<Create Zone$$>', 'Zone')
  !menu.add('FORM', 'Group...', 'group', 'Group')
  !menu.add('CALLBACK', |From Standard Model Library...|, |show !!stdlibrarycreation|, |stdlibrarycreation|)

  var !user user
  !u=object user(!user)
  if (!u.access.upcase() eq 'FREE') then
    !menu.add('FORM', 'System Hierarchy...', 'systemHierarchy', 'SYSTEM')
  else
    !teamList = !u.teamList()
    do !teamName values !teamList
      if (!teamName.name eq 'DESADMIN') then
        !menu.add('FORM', 'System Hierarchy...', 'systemHierarchy', 'SYSTEM')
        break
      endif
    enddo
  endif


  -- Copy
  !menu = !this.newMenu('sysCopy')
  !menu.add('CALLBACK', 'Offset...', 'CALLIB UFORMS COPY _CDCOPYXYZ', 'Offset')
  --!menu.add('CALLBACK', 'Along...', 'CALLIB UFORMS COPY _CDCOPYDIR', 'Along')
