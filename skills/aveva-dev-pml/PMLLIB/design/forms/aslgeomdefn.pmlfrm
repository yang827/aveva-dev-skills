------------------------------------------------------------------------
--
-- Method:      specSelect
--
-- Description: start spec selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specSelect()

  if( !!aslSpec.shown() ) then
    !!alert.error( 'Specification selection form already in use' )
    return
  endif
  show !!aslSpec

  -- initialise spec selection form with an existing spec
  -- nullref or badref OK - this initialises to top level ASL spec
  if( badref(!this.object.spec) ) then
    -- start from with no current spec for ASL spec
    !!aslSpec.init( 'STL', 'ASL' )
  else
    -- start from with current spec.
    !!aslSpec.init( !this.object.spec )
  endif

endmethod
-- End of method definition for .specSelect()

------------------------------------------------------------------------
--
-- Method:      setSpec
--
-- Description: Sets spec to value typed into spec field
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpec()

  -- allow blank entry to clear field
  if( !this.aslSpec.val.set() ) then
    if( !this.aslSpec.val.trim().empty() ) then
      !this.aslSpec.val = 'Unset'
      !this.properties.active = false
      !this.object.spec = object DBREF()
       -- set apply inactive
      !this.apply.active = false
      return
    endif
  endif

  -- check spec name
  call !!nameGadget( !this.aslSpec, 'OLD' )

  !specName = !this.aslSpec.val.trim()
  handle any
    !specName = 'unset'
  endhandle

  if( !specName.empty() or !specName eq 'unset' ) then
    !this.specSelect()
  else
    !spec = !specName.dbRef()
    handle any
      !!alert.error('Error in Specification selection')
      !this.specSelect()
    elsehandle none
      if(!spec.type ne 'SPCO') then
        !!alert.error('Error in Specification selection - this is not a SPecification COmponent element')
        !this.specSelect()
      else
        -- set spec data
        !this.aslSetSpec(!spec)
      endif
    endhandle
  endif

  -- reset text field
  if( badref(!this.object.spec) ) then
    !this.aslSpec.val = ''
    !this.properties.active = false
  else
    !this.aslSpec.val = !this.object.spec.flnm
    !this.properties.active = true
     -- set apply active
    !this.apply.active = true

  endif

endmethod
-- End of method definition for .setSpec()

------------------------------------------------------------------------
--
-- Method:      aslSetSpec
--
-- Description: called from child spec. selection form when spec selected
-- sets current selected spec. data for this form, and for the asl
-- instance object.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbref of a SPCO element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslSetSpec( !selectedSpec is DBREF )

  if( not badref(!selectedSpec) ) then
    !this.selectedSpec.selector(!selectedSpec)
    -- set the selected spec gadget on this form
    !this.aslSpec.val       = !selectedSpec.flnm
    -- set the current instance spec
    !this.object.spec       = !selectedSpec
    !this.properties.active = true
    -- give a warning if check conditions not satisfied
    !this.aslCheckSpec()
    -- set an angle if minmax set
    if( !this.object.aslGeometry.minAngle.set() and !this.angleString.val.empty() ) then
      !this.angleString.val = !this.object.aslGeometry.minAngle.string()
      !this.object.aslGeometry.angle = !this.object.aslGeometry.minAngle
    endif
    -- set a height if minmax set
    if( !this.object.aslGeometry.minHeight.set() and !this.heightString.val.empty() ) then
      !this.heightString.val = !this.object.aslGeometry.minHeight.string()
      !this.object.aslGeometry.height = !this.object.aslGeometry.minHeight
    endif
    -- set a span if minmax set
    if( !this.object.aslGeometry.minSpan.set() and !this.spanString.val.empty() ) then
      !this.spanString.val = !this.object.aslGeometry.minSpan.string()
      !this.object.aslGeometry.span = !this.object.aslGeometry.minSpan
    endif
     -- set apply active
    !this.apply.active = true
    -- make sure that auto selection is off now that selection has been made
    !this.eval.active = false
  else
    !!alert.error('Selected specification not found')
  endif

  -- new object for properties
    !this.template.initialise(!selectedSpec)
    !this.template.editFormBlockOwn(true)

endmethod
-- End of method definition for .aslSetSpec( DBREF )

------------------------------------------------------------------------
--
-- Method:      aslCheckSpec
--
-- Description: Checks the selection made to see if it agrees with current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbref of a SPCO element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslCheckSpec()

  if( !this.selectedSpec.unset() ) then
    !!alert.error('Specification not set')
    return
  endif
  !status = STRING()

  -- get list of choices
  !choices = !this.selectedSpec.choice().invert()
  -- initialise limits
  !this.object.aslGeometry.minAngle  = REAL()
  !this.object.aslGeometry.maxAngle  = REAL()
  !this.object.aslGeometry.minHeight = REAL()
  !this.object.aslGeometry.maxHeight = REAL()
  !this.object.aslGeometry.minSpan   = REAL()
  !this.object.aslGeometry.maxSpan   = REAL()
  !this.object.aslGeometry.minLength = REAL()
  !this.object.aslGeometry.maxLength = REAL()
  !status = ''
  !this.object.aslGeometry.status = ''

  -- set limits
  do !i indices !choices

    -- see if condition is relevant
    if( !choices[!i].type eq 'RANGE' ) then
      if(!choices[!i].key eq 'ANGL' ) then
        !this.object.aslGeometry.minmaxAngle( !choices[!i].minimum, !choices[!i].maximum)
      elseif(!choices[!i].key eq 'HEIG' ) then
        !this.object.aslGeometry.minmaxHeight( !choices[!i].minimum, !choices[!i].maximum)
      elseif(!choices[!i].key eq 'SPAN' ) then
        !this.object.aslGeometry.minmaxSpan( !choices[!i].minimum, !choices[!i].maximum)
      elseif(!choices[!i].key eq 'LENG' ) then
        !this.object.aslGeometry.minmaxLength( !choices[!i].minimum, !choices[!i].maximum)
      endif
    elseif( !choices[!i].type eq 'VALUE' ) then
      if(!choices[!i].key eq 'ANGL' ) then
        !this.object.aslGeometry.minmaxAngle( !choices[!i].real, !choices[!i].real)
      elseif(!choices[!i].key eq 'HEIG' ) then
        !this.object.aslGeometry.minmaxHeight( !choices[!i].real, !choices[!i].real)
      elseif(!choices[!i].key eq 'SPAN' ) then
        !this.object.aslGeometry.minmaxSpan( !choices[!i].real, !choices[!i].real)
      elseif(!choices[!i].key eq 'LENG' ) then
        !this.object.aslGeometry.minmaxLength( !choices[!i].real, !choices[!i].real)
      endif
    endif
    -- collect warning
    if( !this.object.aslGeometry.status.empty().not() ) then
      !status = !this.object.aslGeometry.status
    endif

  enddo

  -- give range warning if necessary
  if( !this.object.aslGeometry.status.empty().not() ) then
    !!alert.warning( !status )
  endif

endmethod
-- End of method definition for .aslCheckSpec()

------------------------------------------------------------------------
--
-- Method:      autoSelect
--
-- Description: Selects specification given the geometry set on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoSelect()

  -- get auto select parameters
  !angle  = !this.object.aslGeometry.angle()
  !height = !this.object.aslGeometry.height()
  !span   = !this.object.aslGeometry.span()
  !length = !this.object.aslGeometry.length()

  !this.specSelect()

  -- set preferences
  if( !angle.set() ) then
    !!aslSpec.preference('ANGL', !angle)
  endif
  if( !height.set() ) then
    !!aslSpec.preference('HEIG', !height)
  endif
  if( !span.set() ) then
    !!aslSpec.preference('SPAN', !span)
  endif
  if( !length.set() ) then
    !!aslSpec.preference('LENG', !length)
  endif

  -- Find entries that conform to the preferences
  !!aslSpec.autoSelect()

endmethod
-- End of method definition for .autoSelect()

------------------------------------------------------------------------
--
-- Method:      properties
--
-- Description: build and show the properties form for the current spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .properties()

  -- get current spec
  !selectedSpre = !this.object.spec
  if( not badref(!selectedSpre) ) then
    -- set desp parameters
    if(!this.opMode eq |CREATE|) then
      !!aslProperties(!selectedSpre,|NEW|,|ASL Properties|,|!!aslGetProperties(!!aslGeomDefn)|,||)
    else
      !!ce = !this.object.currentElement
      !!aslProperties(!selectedSpre,|MODIFY|,|ASL Properties|,|!!aslGetProperties(!!aslGeomDefn)|,||)
    endif
     -- set apply active
    !this.apply.active = true
  else
    !!alert.error('Specification must be selected to set properties')
  endif

endmethod
-- End of method definition for .properties()
