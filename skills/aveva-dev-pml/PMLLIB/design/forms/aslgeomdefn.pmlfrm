-- File:            aslgeomdefn.pmlfrm
--   Type:          Form Definition
--   Group:         Access, Stairs & Ladders Application

--     Keyword:     ASL
--   Module:        design
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Sat Dec 12 17:26:28 "GMT 1998
--
--
-- Description:
-- Form to create and modify general ASL components (as GENSECs with templates)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslApply()                       -                   Callback for apply button, runs create or modify method
--  aslCheckSpec()                   -                   Checks the selection made to see if it agrees with current settings
--  aslGeomDefn()                    -                   Constructor
--  aslSetSpec(DBREF)                -                   called from child spec. selection form when spec selected
--  autoSelect()                     -                   Selects specification given the geometry set on the form
--  close()                          -                   Close form down, inc. EDG
--  createAsl()                      -                   Start form for new Accessway creation
--  deriveDirection()                -                   find a default direction from the first pick
--  editAsl()                        -                   Start form for existing Accessway modification
--  flip()                           -                   swap start position with end position
--  flipAngle()                      -                   swap angle up/down by mirroring about start point
--  init()                           -                   Initialise Form
--  lockAngle()                      -                   Lock/unlock angle
--  lockDirection()                  -                   Lock/unlock direction
--  lockHeight()                     -                   Lock/unlock height
--  lockLength()                     -                   Lock/unlock length
--  lockSpan()                       -                   Lock/unlock span length
--  nameItem()                       -                   Sets the name of an ASL item
--  pick(EDGPOSITIONDATA)            -                   Called by EDG to return pick data
--  properties()                     -                   build and show the properties form for the current spec
--  reDefineEnd()                    -
--  resetGeom()                      -                   clear geometry start and end to force new positions.
--  setAngle()                       -                   set the input angle, allows <val> taken as degrees, <val> in <val> or <val>%
--  setDirection()                   -                   Set the ASL horizontal direction.
--  setGeom()                        -                   Set the form geometry gadgets to current instance object values
--  setHeight()                      -                   Set height data
--  setPosition()                    -                   Called by position link mechanism to return position information
--  setSpan()                        -                   Set span data
--  setSpec()                        -                   Sets spec to value typed into spec field
--  setup()                          -                   general form setup
--  specSelect()                     -                   start spec selection form
--  tag()                            -                   Tag item with aid graphics
--  tidy()                           -                   tidy form data when form closed
--
------------------------------------------------------------------------

-- Define form
setup form !!aslGeomDefn

  !this.formTitle     = 'Create Access Ways'
  !this.iconTitle     = 'ASLCRT'
  !this.callback      = '!!aslGeomDefn.init()'
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition

  -- Form Members ---------------------------------------------

  -- instance describing ASL data and geometry
  -- NOTE THAT THIS MUST BE CALLED OBJECT, BECAUSE ASLSPEC FORM REQUIRES IT
  member .object         is ASLINSTANCE

  -- currently selected specification
  member .selectedSpec   is SPCSPECIFICATION

  -- ASL Element start/end link
  member .position       is POSITIONLINK

  -- EDG Packet Name to remove from the system on dismiss
  member .packetName     is STRING

  -- Aid number used by the ASL form
  member .aidAxes        is REAL
  member .aidLine        is REAL

  member .startPos       is EDGPOSITIONDATA

  -- create or modify mode
  member .opMode         is STRING


  member .template is  COMPROP



  -- Body of form definition ------------------------------------------------

  -- Display CE Name
--  para .ceName at x0.5 y0.2  text '' width 62 lines 1

  -- Name Option
  option .autoName at x0.5 y0.2 width 8
  -- Element Name
  text   .name ' ' at xmax ymin  width 35 is STRING

  -- Current specification, and specification selection
  button .aslSpecSel 'Specification...' at xmin.autoName  ymax.autoName+0.5
  text   .aslSpec    at xmax+0.5 ymin  width 45 is STRING

  -- Positioning & Orientation
  frame .pframe at x0.5 ymax+0.2 'Position & Rotation'

    para   .lockDirTitle   at x 61   ymin+0.5 text 'Lock' width 4

    -- ASL direction (as a direction first point to second point)
    text .direction at x24 ymax  'Direction '       width 24  is DIRECTION
    !this.direction.val = N WRT WORLD

    path down
    halign right
    -- Angle of ASL
    text .angleString  'Angle  '   width 14 is STRING

    -- Height of ASL
    text .heightString 'Height '  width 14 is REAL format !!distanceFmt

    -- Span of ASL
    text .spanString   'Span   '    width 14 is REAL format !!distanceFmt

    -- Length of ASL
--    text .lengthString 'Length ' callback '!this.setLength()' width 14 is REAL format !!distanceFmt

    --  flip start and end
    button .flipAngle  'Swap Angle (Up/Down)'
    --  flip start and end
    button .flipStartEnd  'Swap Start and End'
    button .eval    |Auto Select|

    path down
    halign left
    toggle .dFlagEnd at xmax.direction+1 ymin.direction
    toggle .aFlagEnd at xmin.dFlagEnd ymin.angleString
    toggle .hFlagEnd at xmin.dFlagEnd ymin.heightString
    toggle .sFlagEnd at xmin.dFlagEnd ymin.spanString
--    toggle .lFlagEnd callback '!this.lockLength()'

    -- End Position
    frame    .endFrame    at x 1 ymax.direction 'Setting Out Point'

      -- Define End
      option  .defineEnd 'Define S.O.P. ' at xmin+0.5  ymax  width 6

      -- Define XYZ data
      path down
      halign left
      option .ewEnd    at xmin.defineEnd ymax width 5
      option .nsEnd                           width 5
      option .udEnd                           width 5
      text   .xEnd     at xmax+1 ymin.ewEnd   width 14 is REAL format !!distanceFmt
      text   .yEnd                            width 14 is REAL format !!distanceFmt
      text   .zEnd                            width 14 is REAL format !!distanceFmt
      toggle .xFlagEnd at xmax+1 ymin.ewEnd
      toggle .yFlagEnd
      toggle .zFlagEnd
      para   .lockPosTitle    at xmin-1 ymin.defineEnd text 'Lock'

    exit

  exit

  button .properties |Properties...|  at x0.5       ymax+0.5  apply
  button .check      |Check Data|     at xmax form-size ymin

  -- Bottom Line
  button .apply   |Apply|   at x0.5       ymax+0.5   apply
  button .dismiss |Dismiss| at xmax form-size ymin  OK

exit
-- End of form definition for !!aslGeomDefn

------------------------------------------------------------------------
--
-- Method:      aslGeomDefn
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslGeomDefn()

  -- callbacks

  !this.name.callback         = '!this.name.val = !!checkName(!this.name.val, |NEW|)'
  !this.aslSpecSel.callback   = '!this.specSelect()'
  !this.aslSpec.callback      = '!this.setSpec()'
  !this.direction.callback    = '!this.setDirection()'
  !this.angleString.callback  = '!this.setAngle()'
  !this.heightString.callback = '!this.setHeight()'
  !this.spanString.callback   = '!this.setSpan()'
  !this.flipAngle.callback    = '!this.flipAngle()'
  !this.flipStartEnd.callback = '!this.flip()'
  !this.eval.callback         = '!this.autoSelect()'
  !this.dFlagEnd.callback     = '!this.lockDirection()'
  !this.aFlagEnd.callback     = '!this.lockAngle()'
  !this.hFlagEnd.callback     = '!this.lockHeight()'
  !this.sFlagEnd.callback     = '!this.lockSpan()'
  !this.defineEnd.callback    = '!this.reDefineEnd()'
  !this.properties.callback   = '!this.template.editProperties()'
  !this.check.callback        = '!this.aslCheckSpec()'
  !this.apply.callback        = '!this.aslApply()'
  !this.dismiss.callback      = '!this.close()'


  -- Setup permissible position
  !dText[1]               = 'Start'
  !rText[1]               = 'START'
  !dText[2]               = 'End'
  !rText[2]               = 'END'
  !this.defineEnd.dText   = !dText
  !this.defineEnd.rText   = !rText

  -- POSITION setup
  -- Link Input Gadgets to Objects
  !this.position.linkInput('!!aslGeomDefn.position',!this.xEnd, !this.yEnd, !this.zEnd)
  -- Link Lock Gadgets to Objects
  !this.position.linkLock('!!aslGeomDefn.position',!this.xFlagEnd, !this.yFlagEnd, !this.zFlagEnd)
  -- Link Option Gadgets to Objects
  !this.position.linkOption('!!aslGeomDefn.position',!this.ewEnd, !this.nsEnd, !this.udEnd, 'ENU')
  -- Set tagging method
  !this.position.setAction('!!aslGeomDefn.setPosition()')

  -- set apply inactive until next definition complete
  !this.apply.active = false


endmethod
-- End of method definition for .aslGeomDefn()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Allocate aid numbers
  !this.aidAxes = !!aidNumbers.add('ASL Axes')
  !this.aidLine = !!aidNumbers.add('ASL Line')
  -- disable properties until spec set
  !this.properties.active = false

  -- set apply inactive until next definition complete
  !this.apply.active = false

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      createAsl
--
-- Description: Start form for new Accessway creation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createAsl()

  -- make sure that the spec. selection form is loaded
  if( not defined(!!aslSpec) )  then
    pml load form !!aslSpec
  endif

  -- set storage reference
  !store = !this.object.setStore()
  if(!store.unset()) then
    !!alert.warning('Cannot find storage area to create ASL item. Set a storage area or go to an element that can own a GENSEC.')
    return
  endif

--  !this.ceName.val = |New Accessway in | &  !store.flnn
  !this.formTitle  = |Access Stairs & Ladders (Create)|

  -- Set mode of form
  !this.opMode     = 'CREATE'

  !this.setup()

  -- Define EDG Packet
  !packet                = object EDGPACKET()
  !packet.positionLink('!!aslGeomDefn.position','Pick set out point ')
  !packet.type           = 'ASL'
  !packet.remove         = false
  !packet.form           = !!aslGeomDefn
  !packet.action         = '!!aslGeomDefn.pick(!this.return[1])'
  !packet.close          = '!!aslGeomDefn.tidy()'
  !packet.description    = 'ASL Create'
--  !packet.initialisation = '!!aslGeomDefn.createSetup()'
  !this.packetName       = !packet.description
  -- Add packet to system
  !!edgCntrl.add(!packet)

  -- make sure that no locks remembered from before
  !this.position.unlockAll()

  -- clear name
  !this.name.val = STRING()

  -- make sure that auto selection is set
  !this.eval.active = true

endmethod
-- End of method definition for .createAsl()

------------------------------------------------------------------------
--
-- Method:      editAsl
--
-- Description: Start form for existing Accessway modification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .editAsl()

  -- make sure that the spec. selection form is loaded
  if( not defined(!!aslSpec) )  then
    pml load form !!aslSpec
  endif

  !curRef = !!ce

  -- Set mode of form
  !this.opMode             = 'MODIFY'

  !this.setup()

  -- set reference data
  !aslItem = !this.object.edit(!!ce,'GENSEC')
  !this.setGeom()

  -- initialise form header
--  !this.ceName.val       = !aslItem.flnn
  !this.formTitle        = |Access Stairs & Ladders (Modify)|

  -- Define EDG Packet
  !packet                = object EDGPACKET()
  !packet.positionLink('!!aslGeomDefn.position','Pick set out point ')
  !packet.type           = 'ASL'
  !packet.remove         = false
  !packet.form           = !!aslGeomDefn
  !packet.action         = '!!aslGeomDefn.pick(!this.return[1])'
  !packet.description    = 'ASL Modify'
--  !packet.initialisation = '!!aslGeomDefn.editSetup()'
  !!aslGeomDefn.packetName = !packet.description
  -- Add packet to system
  !!edgCntrl.add(!packet)

  if( badref(!aslItem) ) then
    !!alert.error('No current ASL item to modify. Go to an ASL element.')
    !!ce = !curRef
    return
  endif

  -- set up position link etc.
  !this.position.position(!this.object.aslGeometry.start, false, true)
  !this.tag()

  -- make sure that no locks remembered from before
  !this.position.unlockAll()

  -- display spec
  !spec = !this.object.spec
  if( not badref(!spec) ) then
    !this.aslSpec.val = !spec.flnn
    !this.properties.active = true
    -- set apply active
    !this.apply.active = true
  endif

  -- make sure that auto selection is set
  !this.eval.active = BADREF(!spec)

endmethod
-- End of method definition for .editAsl()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down, inc. EDG
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Clear EDG
  !!edgCntrl.remove(!this.packetName)

  -- tidy up
  !this.tidy()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: tidy form data when form closed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Hide Aid Lines
  !!aidNumbers.hide(!this.aidAxes)
  !!aidNumbers.hide(!this.aidLine)

  -- clear positions & empty the instance object
  !this.angleString.val    = object STRING()
  !this.heightString.val   = object REAL()
  !this.spanString.val     = object REAL()
  !this.direction.val      = N WRT WORLD
  !this.object             = object ASLINSTANCE()

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: general form setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise form data
  !this.xEnd.val            = object REAL()
  !this.yEnd.val            = object REAL()
  !this.zEnd.val            = object REAL()
  !this.xFlagEnd.val        = false
  !this.yFlagEnd.val        = false
  !this.zFlagEnd.val        = false

  !this.angleString.val     = ''
  !this.heightString.val    = REAL()
  !this.spanString.val      = REAL()
  !this.aFlagEnd.val        = false
  !this.hFlagEnd.val        = false
  !this.sFlagEnd.val        = false
  !this.dFlagEnd.val        = false
  !this.angleString.active  = true
  !this.heightString.active = true
  !this.spanString.active   = true
  !this.aFlagEnd.active     = true
  !this.hFlagEnd.active     = true
  !this.sFlagEnd.active     = true
  !this.direction.active    = true
  !this.dFlagEnd.active     = true
--  !this.direction.val  = N WRT WORLD
  !this.defineEnd.select('RTEXT', 'START')
  -- initialise the geometry for this ASL form
  !this.object.aslGeometry         = object ASLCONSTRAINGEOM()

  !this.aslSpec.val         = object STRING()
  !this.aslSpec.active      = true

  -- setup Autoname option gadget
  !dText = ARRAY()
  !rText = ARRAY()

  !dText[1]               = 'Name'
  !rText[1]               = 'false'
  if( !this.opMode eq 'CREATE' ) then
    !dText[2]               = 'Autoname'
    !rText[2]               = 'true'
  endif

  !this.name.val       = STRING()
  !this.autoName.dText = !dText
  !this.autoName.rText = !rText

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      resetGeom
--
-- Description: clear geometry start and end to force new positions.
--   clear aid graphics. This method leaves height,angle and span data
--   for use on the next create operation, but new position input forced
--   by clearing start and end.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resetGeom()

  -- Initialise form data
  !this.xEnd.val            = object REAL()
  !this.yEnd.val            = object REAL()
  !this.zEnd.val            = object REAL()
  !this.xFlagEnd.val        = false
  !this.yFlagEnd.val        = false
  !this.zFlagEnd.val        = false

  !this.defineEnd.select('RTEXT', 'START')
  -- initialise the geometry for this ASL form
  !this.object.aslGeometry.start = object POSITION()
  !this.object.aslGeometry.end   = object POSITION()
  -- initialise to new element
  !this.object.currentElement    = object DBREF()
  -- unlock direction if locked so that first pick can set direction
  if( !this.dFlagEnd.val ) then
    !this.dFlagEnd.val = false
    !this.lockDirection()
  endif

  -- Hide Aid Lines
  !!aidNumbers.hide(!this.aidAxes)
  !!aidNumbers.hide(!this.aidLine)

  -- set apply inactive until next definition complete
  !this.apply.active = false

  -- clear the name
  !this.name.val       = STRING()

endmethod
-- End of method definition for .resetGeom()

------------------------------------------------------------------------
--
-- Method:      aslApply
--
-- Description: Callback for apply button, runs create or modify method
--   depending on current form operation.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslApply()

  -- Initialise Variables
  !selectedSpre = !this.object.spec

  -- error if selection not complete - must be a SPCO
  if( !selectedSpre.unset() ) then
    !!alert.error( 'Specification selection not complete' )
    return
  endif

  -- error if selection not complete - must be a SPCO
  if( !selectedSpre.type.upcase() ne 'SPCO' ) then
    !!alert.error( 'Specification selection not complete' )
    return
  endif

  -- check that geometry has been set
  if( !this.object.aslGeometry.unset() ) then
    !!alert.error( 'Definition of geometry not complete' )
    return
  endif
  if( !this.object.aslGeometry.start.unset() ) then
    !!alert.error( 'Definition of geometry not complete' )
    return
  endif
  if( !this.object.aslGeometry.end.unset() ) then
    !!alert.error( 'Definition of geometry not complete' )
    return
  endif
  if( !this.object.aslGeometry.start.distance(!this.object.aslGeometry.end) eq 0.0 ) then
    !!alert.error( 'Start and end points must not be in the same position' )
    return
  endif

  if( !this.opMode eq 'CREATE' ) then

    -- CREATE the ASL object
    !this.object.create()
    -- name the item
    !this.nameItem()

    -- new properties object
    !this.template.setProperties(!this.object.currentElement)
    !this.template.unsetDesiElement()
    -- clear the start and end positions to force another position input
    -- for the next create. Leaves angle height etc. as it was.
    !this.resetGeom()

  else

    -- MODIFY ASL object
    !this.object.modify()
    -- name the item
    !this.nameItem()
    -- reset form in case adjustment made
    !this.setGeom()
    -- Draw definition
    !this.tag()

  endif


endmethod
-- End of method definition for .aslApply()

------------------------------------------------------------------------
--
-- Method:      nameItem
--
-- Description: Set name of ASL element, using autoname if set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameItem()

  -- set name
  if( !this.autoName.selection().boolean() ) then
    -- autoname
    !name = !!namOpt.nameString(!this.object.currentElement,'', false ,false)
    !name = !!namToPdmsName(!name)
  else
    -- given name
    if( !this.name.val.set() ) then
      !name = !!namToPdmsName(!this.name.val)
    else
      !name = STRING()
    endif
  endif

  -- Name the object
  if(!name.set()) then
    !!ce = !this.object.currentElement
    if( !name ne !!ce.name ) then
      NAME $!<name>
    endif
  endif

endmethod
-- End of method definition for .nameItem()

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description: Set the ASL horizontal direction.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection()

  -- set direction
  !ok = !this.object.aslGeometry.direction( !this.direction.val )

  if( !ok ) then
    -- reset the input gadget because direction has been mapped to horizontal
    !this.direction.val = !this.object.aslGeometry.direction()
    !this.tag()
  else
    !!alert.error(!this.object.aslGeometry.status)
  endif

endmethod
-- End of method definition for .setDirection()

------------------------------------------------------------------------
--
-- Method:      setAngle
--
-- Description: set the input angle, allows <val> taken as degrees, <val> in <val> or <val>%
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAngle()

   -- Check for "IN"
  if(!this.angleString.val.upcase().match('IN').boolean()) then

    -- Convert into angle
    !a     = !this.angleString.val.upcase().before('IN').trim().real()
    handle any
      !!alert.warning('Invalid slope definition')
      !a = 0
    endhandle
    !b     = !this.angleString.val.upcase().after('IN').trim().real()
    handle any
      !!alert.warning('Invalid slope definition')
      !b = 0
    endhandle
    if( !a eq 0 ) then
      !angle = 0
    elseif( !b eq 0 ) then
      !angle = 90
    else
      !angle = ATAN(!a.real() / !b.real())
    endif

  -- Check for %
  elseif (!this.angleString.val.trim().subString(-1,1) eq '%' ) then

    -- Get value before %
    !a     = !this.angleString.val.before('%').trim().real()
    handle any
      !!alert.warning('Invalid slope definition')
      !a = 0
    endhandle
    !angle = ATAN(!a / 100)

  -- Assume degrees (real)
  else

    !angle = !this.angleString.val.trim().real()
    handle any
      !!alert.error('Invalid angle definition')
      return
    endhandle
  endif

  -- set new angle
  !ok = !this.object.aslGeometry.angle( !angle )

--  if( !ok.not() ) then
--    !!alert.warning( !this.object.aslGeometry.status )
--  endif
  if( !this.object.aslGeometry.status.empty().not() ) then
    !!alert.warning( !this.object.aslGeometry.status )
  endif

  -- set form geometry gadgets
  !this.setGeom()
  -- Draw definition
  !this.tag()

endmethod
-- End of method definition for .setAngle()

------------------------------------------------------------------------
--
-- Method:      setGeom
--
-- Description: Set the form geometry gadgets to current instance object values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGeom()

  -- Write data to angle gadget
  !this.angleString.val = !this.object.aslGeometry.angle.string()
  handle any
    !this.angleString.val = object STRING()
  endhandle
  -- Write data to span gadget
  !this.spanString.val = !this.object.aslGeometry.span
  handle any
    !this.spanString.val = object REAL()
  endhandle
  -- Write data to height gadget
  !this.heightString.val = !this.object.aslGeometry.height
  handle any
    !this.heightString.val = object REAL()
  endhandle
  -- Write data to direction gadget
  !this.direction.val = !this.object.aslGeometry.direction()
  handle any
    !this.direction.val = object STRING()
  endhandle
  -- reset position gadget data to actual position
  -- don't action position gadget else get recursion  2nd arg false
  -- force position (overriding position locks)       3rd arg true
  !whichEnd = !this.defineEnd.selection().trim().upcase()
  if( !whichEnd eq 'END' and !this.object.aslGeometry.end.set() ) then
    -- set end position in gadget through link
    !this.position.position(!this.object.aslGeometry.end, false, true)
  elseif( !whichEnd eq 'START' and !this.object.aslGeometry.start.set() ) then
    -- set start position in gadget through link
    !this.position.position(!this.object.aslGeometry.start, false, true)
  endif

  -- set auto selection on only if spec not already selected
  !this.eval.active = BADREF(!this.object.spec)
  -- set apply active if spec is set
  if( not badref(!this.object.spec) ) then
    -- set apply active
    !this.apply.active = true
  endif

  -- set the name
  if( !this.object.currentElement.set() ) then
    !elementName = !this.object.currentElement.name
    if( !elementName.subString(1,1) neq '=' ) then
      !this.name.val = !!namToPdmsName(!elementName)
    endif
  endif

endmethod
-- End of method definition for .setGeom()

------------------------------------------------------------------------
--
-- Method:      redefineEnd
--
-- Description: Setup to define start or end position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reDefineEnd()

  -- find out whether start of end position selected
  !whichEnd = !this.defineEnd.selection().trim().upcase()
  if(!whichEnd eq 'START') then
    !position = !this.object.aslGeometry.start
  else
    !position = !this.object.aslGeometry.end
  endif

  -- force start/end position back into position gadgets
  if(!position.set()) then
    !this.position.position(!position, false, true)
  else
    -- this position not yet defined, so just initialise the position link
    !this.position.initialise()
    !this.position.unlockAll()
    -- have to unset gadget values
    !this.xEnd.val = object REAL()
    !this.yEnd.val = object REAL()
    !this.zEnd.val = object REAL()
  endif

  !this.tag()

endmethod
-- End of method definition for .reDefineEnd()

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Called by EDG to return pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     EDGPOSITIONDATA    returned from EDG pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick(!pickedData is EDGPOSITIONDATA)

   !this.startPos = !pickedData
  -- Put picked position into the linked gadget, which in turn kicks off
  -- the link position action which finally sets the position if
  -- position constraints satisfied
  !this.position.position(!pickedData.position)

endmethod
-- End of method definition for .pick(EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Called by position link mechanism to return position information
--   when start/end position gadget changed.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    New derived position
--
------------------------------------------------------------------------

define method .setPosition()

  -- get position from gadget
  !newPosition = !this.position.get()
  !whichEnd = !this.defineEnd.selection().trim().upcase()

  -- get initial direction from first pick
  if( !this.object.aslGeometry.start.unset() and !this.object.aslGeometry.end.unset() ) then
    -- determine a direction from pick
    !this.deriveDirection()
  elseif( !this.object.aslGeometry.start.unset() and !whichEnd eq 'END' ) then
    -- determine a direction from pick
    !this.deriveDirection()
  elseif( !this.object.aslGeometry.end.unset()   and !whichEnd eq 'START' ) then
    -- determine a direction from pick
    !this.deriveDirection()
  endif

  -- choose start or end to set - and set it (applying modifiers/constraints)
  if( !whichEnd eq 'START' ) then
    -- setting the start position
    !ok = !this.object.aslGeometry.start(!newPosition)
    !actualPosition = !this.object.aslGeometry.start
  else
    -- setting the end position
    !ok = !this.object.aslGeometry.end(!newPosition)
    !actualPosition = !this.object.aslGeometry.end
  endif

  -- update geometry gadgets on the form
  if( !ok ) then

    -- update the position gadget with actual position - don't action
    -- (else get recursion), and force position (overriding position locks)
    if( !this.object.aslGeometry.status.empty().not() ) then
      !!alert.warning( !this.object.aslGeometry.status )
    endif
    !this.position.position(!actualPosition, false, true)
    !this.setGeom()
    -- Tag Line
    !this.tag()
    handle any
    endhandle
  else
    !!alert.error(!this.object.aslGeometry.status)
  endif

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      deriveDirection
--
-- Description: find a default direction from the first pick
--             (until both ends defined)
--  Tries to determine a direction from the pick, but sets N wrt world
--  if it can't.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveDirection()

  -- do nothing if direction is locked
  if( !this.dFlagEnd.val ) then
    return
  endif

  -- initialise horizontal plane and up direction
  !horiz = object PLANE( N0,  Y is N and Z is U wrt WORLD)
  !up    = UP WRT /*

--  q var   !this.startPos !this.startPos.line !this.startPos.plane !this.startPos.arc !this.startPos.pLine

  if( !this.startPos.line.set() ) then
    !line = !this.startPos.line
  else
    !line = !this.startPos.getLine()
  endif

  if( !line.set() ) then

    -- got a line from the pick, find a direction
    !lDir      = !line.direction()
    !direction = !lDir.orthogonal(!up)
    handle any
      -- probably got a vertical line
      !direction = N WRT WORLD
    endhandle

  else

    !arc = !this.startPos.getArc()

    if( !arc.set() ) then
      -- got an arc, get horizontal direction from centre to pick point
      !pDir      = !arc.position.direction(!this.startPos.position)
      handle any
        -- horizontal plane
        !pDir      = !arc.orientation.zDir()
      endhandle
      !direction = !pDir.projected(!horiz)
      handle any
        -- horizontal plane
        !direction = N WRT WORLD
      endhandle

    else

      !plane = !this.startPos.getPlane()

      if( !plane.set() ) then
        -- got a plane, get horizontal direction
        !pDir      = !plane.pointVector().direction
        !direction = !pDir.projected(!horiz)
        handle any
          -- horizontal plane
          !direction = N WRT WORLD
        endhandle
      else

        -- got no arc, line or plane, so use default N
        !direction = N WRT WORLD

      endif

    endif

  endif

  -- now find direction wrt pick
  !dot = !direction.dot(!this.startPos.pointVector.direction)
  -- find out whether start of end position selected
  !whichEnd = !this.defineEnd.selection().trim().upcase()
    -- direction opposite to pick for start; direction with pick for end
  !dirOppToPick = !whichEnd eq 'START'
  if( !dot lt 0 ) then
    if( !dirOppToPick.not() ) then
      !direction = !direction.opposite()
    endif
  else
    if( !dirOppToPick ) then
      !direction = !direction.opposite()
    endif
  endif
  -- set direction gadgets
  !this.object.aslGeometry.lockDirection(false)
  !this.object.aslGeometry.direction( !direction )
  !this.direction.val = !this.object.aslGeometry.direction()
--  !this.dFlagEnd.val = true
--  !this.lockDirection()

endmethod
-- End of method definition for .deriveDirection()

------------------------------------------------------------------------
--
-- Method:      flip
--
-- Description: swap start position with end position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flip()

  -- flip the ends in the geometry object
  !this.object.aslGeometry.reverseSense()

  -- choose start or end to set - and set it (applying modifiers/constraints)
  if( !this.defineEnd.selection().trim().upcase() eq 'START' ) then
    -- setting the start position
    !actualPosition = !this.object.aslGeometry.start
  else
    -- setting the end position
    !actualPosition = !this.object.aslGeometry.end
  endif

  -- update the position gadget with actual position - don't action
  -- (else get recursion), and force position (overriding position locks)
  !this.position.position(!actualPosition, false, true)

  -- Write data to direction gadget (will have been reversed)
  !this.direction.val = !this.object.aslGeometry.direction
  handle any
    !this.direction.val = object DIRECTION()
  endhandle

  -- Tag Line
  !this.tag()

endmethod
-- End of method definition for .flip()

------------------------------------------------------------------------
--
-- Method:      flipAngle
--
-- Description: swap angle up/down by mirroring about start point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flipAngle()

  -- flip the ends in the geometry object
  !this.object.aslGeometry.flipAngle( !this.defineEnd.selection().trim().upcase() )

  -- Tag Line
  !this.tag()

endmethod
-- End of method definition for .flipAngle()

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag item with aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tag()

  -- Hide current lines
  !!aidNumbers.hide(!this.aidLine)

  !start = !this.object.aslGeometry.start
  !end   = !this.object.aslGeometry.end

  -- determine which end currently being defined
  !whichEnd = !this.defineEnd.selection().trim().upcase()
  if( !whichEnd eq 'END' ) then
    !endLabel = 'END'
    !startLabel = 'start'
    !tagEnd = !end
  elseif( !whichEnd eq 'START' ) then
    !endLabel = 'end'
    !startLabel = 'START'
    !tagEnd = !start
  endif

  -- if either start or end are unset, Only label is output
  if(!start.set() and !end.set()) then

    -- Only output line if not zero length
    if(!start ne !end) then
      !gphLine =    object GPHLINE(object LINE(!start, !end))
      !gphLine.draw(!this.aidLine)
--      !!aidNumbers.replace(!this.aidLine, !gphLine)
    endif

  endif

  if( !start.set() ) then
    AID TEXT NUMBER $!this.aidLine |$!startLabel| AT $!start
  endif
  if(!end.set() ) then
    AID TEXT NUMBER $!this.aidLine |$!endLabel|   AT $!end
  endif

  if( !tagEnd.set() ) then
    -- draw arrow showing direction
    if( !this.object.aslGeometry.direction.set() ) then
      !pv = object POINTVECTOR(!tagEnd, !this.object.aslGeometry.direction)
      !gphDirection = object GPHPOINTVECTOR( !pv )
      !gphDirection.draw(!this.aidLine)
    endif

  endif

endmethod
-- End of method definition for .tag()

------------------------------------------------------------------------
--
-- Method:      setHeight
--
-- Description: Set height data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setHeight()

  !height = !this.heightString.val
  handle any
    return
  endhandle

  -- set new height
  !ok = !this.object.aslGeometry.height( !height )

  if( !ok ) then
    -- update the geometry
    !this.setGeom()
    -- Tag Line
    !this.tag()
  else
    -- report problem
    !!alert.error( !this.object.aslGeometry.status)
    -- reset value
    !this.heightString.val = !this.object.aslGeometry.height
    handle any
      !this.heightString.val = object REAL()
    endhandle
  endif

endmethod
-- End of method definition for .setHeight()

------------------------------------------------------------------------
--
-- Method:      setSpan
--
-- Description: Set span data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpan()

  !span = !this.spanString.val
  handle any
    return
  endhandle

  -- set new height
  !ok = !this.object.aslGeometry.span( !span )

  if( !ok ) then
    -- update the geometry
    !this.setGeom()
    -- Tag Line
    !this.tag()

  else
    -- report problem
    !!alert.error( !this.object.aslGeometry.status)
    !this.spanString.val = !this.object.aslGeometry.span
    -- reset value
    handle any
      !this.spanString.val = object REAL()
    endhandle

  endif

endmethod
-- End of method definition for .setSpan()


------------------------------------------------------------------------
--
-- Method:      lockDirection
--
-- Description: Lock/unlock direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lockDirection()

  -- only allow lock if set
  if( !this.object.aslGeometry.direction().unset() ) then
    -- make sure that gadget is not grey and toggle is unset
    !locked = false
  else
    -- flip the state of the gadget and data
    !locked = !this.dFlagEnd.val
  endif

  -- lock/unlock gadget
  !this.direction.active = !locked.not()
  -- lock/unlock data
  !this.object.aslGeometry.lockDirection(!locked)

endmethod
-- End of method definition for .lockDirection()

------------------------------------------------------------------------
--
-- Method:      lockAngle
--
-- Description: Lock/unlock angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lockAngle()

  -- only allow lock if set
  if( !this.object.aslGeometry.angle().unset() ) then
    -- make sure that gadget is not grey and toggle is unset
    !locked = false
  else
    -- flip the state of the gadget and data
    !locked = !this.aFlagEnd.val
  endif

  -- lock/unlock gadget
  !this.angleString.active = !locked.not()
  -- lock/unlock data
  !this.object.aslGeometry.lockAngle(!locked)

endmethod
-- End of method definition for .lockAngle()


