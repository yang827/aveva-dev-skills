-- File:            aslhandrail.pmlfrm
--   Type:          Form Definition
--   Group:         Access, Stairs :group: Ladders Application
--     Keyword:     ASL
--   Module:        design
--   Replaces:
--
-- Author:          A.kirkland
-- Created:         Fri Nov 28 14:00:24 GMT 1997
--
--
-- Description:
-- form for creating handrailing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -
--  createRails(STRING)              -
--  getDefaults()                    -
--  getDesps()                       -
--  initialise(STRING)               -
--  loadSpec()                       -
--  pick()                           -
--  reDefStart()                     -
--
------------------------------------------------------------------------

-- Define form
setup form !!aslHandrail

  !!aslHandrail.formTitle     = 'HandRail Selection'
  !!aslHandrail.iconTitle     = ''
  !!aslHandrail.callback      = '!!aslHandrail.initialise(!!aslHandrail.checkMode)'
  !!aslHandrail.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

  -- Define CE Button
  button .ce |CE| at x0.5 y0.2 call |!!aslHandrail.initialise('MODIFY')|

  -- Display CE Name
  para .ceName at xmax+1 ymin  width 63 lines 1

  -- Create/Modify
  !displayOption = 'Create Modify'
  !replaceOption = !displayOption.upcase()
  !displayMode          = !displayOption.split()
  !replaceMode          = !replaceOption.split()
  option .mode || at xmax form-size  ymin call |!!aslHandrail.initialise(!!aslHandrail.mode.selection('RTEXT'))| width 7
  !!aslHandrail.mode.dText  = !displayMode
  !!aslHandrail.mode.rText  = !replaceMode

  -- Spec selection
  frame .sframe at x0.5 ymax+0.2 |Specification Data|

    -- Load Spec
    button .loadSpec |Load Specs| at xmin+0.4 ymax call |!!aslHandrail.loadSpec()|

    -- Permissible Spec
    option .specifications at xmax+1 ymin width 20

    -- Default Select mode
    toggle .default |Auto Default Selection| at xmax+2 ymin
    -- Create option list
    -- Available Types

    list .selected |Current Selection| at x1 ymax.loadSpec+0.1 width 64 length 5
    list .perms at xmin ymax+1 width 64 length 5
    para .question at xmin.perms ymin.perms-1 width 40 lines 1

    -- At Frmw to create
    member .storage is DBREF
    -- for spec selector lists
    member .specData is SPECDATA
    -- to set in modify or create
    member .checkMode is STRING
    -- start pick from EDG
    member .start is EDGDATA
    -- End Pick from EDG
    member .end is EDGDATA
    -- Rail direction
    member .railDir is DIRECTION
    -- Store Design para defaults
    member .defaultStore is ARRAY
    -- store the connection fitting for the rail
    member .connections is DBREF
    -- store items created
    member .railStore is ARRAY
    -- which side to put the rail
    member .railSide is DIRECTION
  exit
  -- Edg and rail spacing required


  button .reDefStart at xmin ymax+0.5 |Redefine Start|  call |!!aslHandrail.reDefStart()|
  frame .edgRelated at xmax+0.2 ymin-0.5 |Spacing Control|
    -- which method is required for spacing

    toggle .equal |Equal Rail Spacing|  call ''
    _equal.val = true
    toggle .defaultDesp |Default Design Parameters| at xmax ymin call ''
    _defaultDesp.val  = true
  exit

  -- Bottom Line

  button .dismiss |Dismiss| at xmax.perms-7 ymax+0.5 call |!!aslHandrail.close()| ok
  button .apply   |Apply|   at xmin form-0     ymin    call |!!aslHandrail.getDesps()| apply


exit
-- End of form definition for !!aslHandrail

-- link gadgets with spec data

call !!specLinks(!!aslHandrail.specData,'SpecData',!!aslHandrail.selected,!!aslHandrail.perms)

call !!specAddLink(!!aslHandrail.specData, 'SPECS',!!aslHandrail.specifications)
call !!specAddLink(!!aslHandrail.specData, 'QUESTION',!!aslHandrail.question)
call !!specAddLink(!!aslHandrail.specData, 'DEFAULT',!!aslHandrail.default)



------------------------------------------------------------------------
--
-- Method:      <initialise>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise(!dummyHRMode is STRING)

  -- don't allow apply until edg has two points to work from
  !this.apply.active = FALSE
  -- set ce for create/modify

  if(!this.checkMode.eq('CREATE') ) then

    !this.ce.active = FALSE
    -- check at level for creation

    FRMW
    handle any
      TMPL
      handle any
        call !!edgPop(-1)
        return error 1 |Unable Create Handrail at this level.|
        -- the above line  don't seem to be returning
        --return
      endhandle
    endhandle

    -- Set Data

    -- Set where to create items
    !this.storage = !!ce

    !this.formTitle  = |HandRail Selection. (Creation)|

    !this.ceName.val = 'New HandRail for ' & !!ce.flnn
    !this.mode.select('rtext','CREATE')
  else
    !this.ceName.val = !!ce.flnn
    !this.mode.select('rtext','MODIFY')
  endif

  -- load spec if not done already

  if(!this.specifications.val.eq(0) ) then
    !!aslHandrail.loadSpec()
  endif

endmethod
-- End of method definition for .initialise(STRING)

------------------------------------------------------------------------
--
-- Method:      <reDefStart>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .reDefStart()

  -- don't allow apply active 'til edg has two points to work from
  !this.apply.active = FALSE

  -- only reset start if form shown
  if(!!aslHandrail.shown()) then
    !this.start = object EDGDATA()
  endif


  !this.end   = object EDGDATA()
  !!edgGeomPrmpt('Handrail Definition','Define Rail Start : ', '')
  !!aidClear(|ALL|,|ALL|)

  !this.railStore.clear()

  !this.railDir = object DIRECTION()
  !this.railSide = object DIRECTION()

endmethod
-- End of method definition for .reDefStart()

------------------------------------------------------------------------
--
-- Method:      <pick>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick()

  -- get edg data from pick
  !pickedData = !!getEdgData()
  -- find out first or second pick
  if(!!aslHandrail.start.item.unset()) then
    --  first point picked
    -- clear aids from graphics
    !!aidClear(|15005|,|ALL|)
    --  Reposition aids
    !!aidAxes(15005, |Start HandRail Point|, !pickedData.pos, 500)

    --  set start pos gadget
    !!aslHandrail.start = !pickedData
    -- set prompt
    !!edgGeomPrmpt('Handrail Definition','Define Rail End : ','')
    !args              = object EDGPUSHPARAMS()
    !args.appName      = 'Handrail Definition'

    !!edgUpdateApp(!args)
    -- get direction of rail (assumed to be the side of sct picked)

    !itemDir = !!edgGeomData.vector.direction
    !pickDir = !!edgGeomData.pickLine
    !uPlane  = !!planePntDir(!!aslHandrail.start.pos,!this.start.item.orientation.yDir())
    !pickOnUPlane     = !!directionOnPlane(!pickDir,!uPlane)
    !directTmp        = !!normalToDirs(!itemDir, !pickOnUPlane)
    !this.railSide    = !!normalToDirs(!itemDir, !directTmp)

    -- the variable !this.railSide is the  side the rail has to be created

  else


    !!aidClear(|15007|,|ALL|)
    !!aslHandrail.end = !pickedData
    !!aidAxes(15007, |End HandRail Point|, !pickedData.pos, 500)
    !!aidLine(15007,!!aslHandrail.start.pos,!!aslHandrail.end.pos)
    -- *** OLD STYLE PML ***
    var !tmpDir CONST DIR $!this.start.pos TO $!this.end.pos
    !this.railDir = $!tmpDir
    handle (2,779)
      !this.railDir = axis $!tmpDir
    endhandle
    -- two points selected
    !this.apply.active = TRUE
  endif

endmethod
-- End of method definition for .pick()


------------------------------------------------------------------------
--
-- Method:      <getDesps>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDesps()

  -- no need to show property form for default
  if(!this.defaultDesp.val.not()) then
    if(!this.checkMode.eq('CREATE')) then
      !selection = !!genGetLevel(!!aslHandrail)[1]

      --   !selection = !this.selected.selection('rtext').dbRef()
      handle any
        -- do nothing if sele is selected in the list
        return error 1 'Selection is not complete.'
      endhandle
      -- set desp parameters
      !!genPropertyShow(!selection,|NEW|,|Rail Properties|,|!!aslHandrail.createRails('')|,|!!dismiss()|)
    endif
  else
    !this.defaultStore.clear()
    !this.getDefaults()
    !this.createRails('DEFAULT')
  endif
endmethod
-- End of method definition for .getDesps()

------------------------------------------------------------------------
--
-- Method:      <getDefaults>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDefaults()

  -- initialise variables
  !spre     = !!genGetLevel(!!aslHandrail)[1]
  handle any
    -- do nothing if sele is selected in the list
    return
  endhandle
  -- set the connection fitting for the rail
  !this.connections = !!genGetLevel(!!aslHandrail)[2]

  !message  = STRING()
  !template = BOOLEAN()
  !cata[1]  = object DBREF()
  !desp[1]  = object DBREF()
  !data[1]  = object DBREF()
  !attr[1]  = object DBREF()
  !plot[1]  = object DBREF()

  -- Get information from dataset

  !!findDataSet(!spre, !message, !template, !cata, !desp, !data, !attr, !plot )

  -- use do 'cos EVALUATE block is slow

  do !despDdats indices !desp
    !number = !desp[!despDdats].numb
    !dddf   = !desp[!despDdats].dddf.trim('L','( ').trim('R',' )').real()
    !this.defaultStore[!despDdats] = 'DESP NUMB ' & !number & ' ' & !dddf
  enddo



endmethod
-- End of method definition for .getDefaults()

------------------------------------------------------------------------
--
-- Method:      <createRails>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .createRails(!defDesp is STRING)

  if(!this.mode.selection('RTEXT').eq('CREATE')) then

    if(!this.connections.set()) then
      !items[1] = !this.start.item.string()
      !items[2] = !this.end.item.string()
      -- save clasher defaults
      !!claDataHandle('SET',!items)
      -- set up clasher limits and obstruction list
      !!claDataHandle('OBST',!items)
    endif

    -- Initialise variables
    !this.railStore.clear()
    !selection = !!genGetLevel(!!aslHandrail)[1]
    handle any
      -- do nothing if sele is selected in the list
      return error 1 'Selection is not complete.'
    endhandle
    -- set the connection for fitting of the rail

    !this.connections = !!genGetLevel(!!aslHandrail)[2]

    !template   = !selection.tmpr
    handle any
      -- if selection is not complete
      return error 1 'No Handrail has been selected from the specification'
    endhandle
    !genericType = !template.gType

    -- goto Tmpl and get properties **** OLD STYLE PML ***
    !!ce = !template
    var !type DEPR TYPE
    var !tmpLeng LDPR LENG
    -- convert to real
    !leng = $!tmpLeng

    -- Put in storage area
    !!ce = !this.storage
    -- create sbfr for elements to go into (continuous to do at some time)
    NEW SBFR
    PURP RAIL

    -- calc dist between two points
    -- **** OLD Style PML
    var !tmpDist CONST DIST $!this.start.pos TO $!this.end.pos
    -- convert to real
    !dist = $!tmpDist
    -- check type of rail selected
    if(!type.eq('FIXED')) then
      -- find out whether squeeze to fit or max length required
      if(!this.equal.val) then
        -- calc how many rails are needed reducing their length
        !noRails = (int(!dist / !leng) + 1 )
        !newLeng = (!dist / !noRails)
        -- don't show extra form
        !showExtraForm = False

      else
        -- max leng rails
        !noRails = (int(!dist / !leng) )
        !newLeng = !leng
        -- set a flag to show that this OPTION has been used
        !showExtraForm = True
      endif
      !flipPos = 'POSE'
      -- create gensecs
      do !index to !noRails
        if(!index.eq(1) ) then
          !startPos = 'AT $!this.start.pos'
        else
          !startPos = 'AT $!flipPos OF PREV GENSEC'
        endif
        NEW GENSEC $!startPos
        SPRE $!selection
        GTYP $!genericType
        handle any
          -- in case generic type is null
        endhandle
        -- add to form storage
        !this.railStore.append(!!ce)
        NEW SPINE
        NEW POINSP $!startPos
        !datumPnt = !!ce
        NEW POINSP POLAR $!this.railDir DIST $!newLeng

        GENSEC
        -----------------------------------------------------
        -- Flip the sctn if offs is going W wrt poinsp 1
        if(!this.railSide.wrt(!datumPnt).string().part(1).eq('W')) then
          !poss = POSS WRT WORLD
          !pose = POSE WRT WORLD
          AT $!pose
          POSS $!pose
          POSE $!poss
          -- if the prev has been flipped
          !flipPos = 'POSS'
        endif
        ------------------------------------------------------
        -- only do this if not default
        if(!defDesp.neq('DEFAULT')) then
          -- Pick up design para from the form
          !despars = !!genProperty.current
          handle any
            -- when there are no desps
          endhandle
          -- when its a catref do nothing
          if(!template.unset()) then
            return
          endif

          -- Set Design Parameters from the gen property form
          if(defined (!despars)) then
            if( not !despars.unset() ) then
              do !ind indices !despars
                DESP NUMB $!ind $!despars[$!ind]
              enddo
            endif
          endif
        else
          -- put default desps on
          do !dflt values !this.defaultStore
            $!dflt
          enddo
        endif

        -- Reset tmpl or create
        --if(not !!genProperty.specComp.tmpr.unset()) then
        TMPL 1 OF GENSEC
        handle any

          NEW TMPL COPY REXE $!template

        endhandle
        --endif
        UNLOCK ALL
        -- Go back to OWNER
        OWNER
        -- Create DDSE at Gensec level if spref's are variable

        !built = !!aslCmpSprefInvo(FALSE)
        if(!built) then
          call !!aslCmpSpref('')
        endif

        GENSEC
        LOCK ALL
      enddo
    else
      -- continuous

    endif
    -- pass to new form with selection for bit left
    if(!showExtraForm) then
      -- show extra form
    endif
  else
    -- get from ce
    -- **********MODIFY
    -- not sure modify will be viable
  endif
  -- ***********************************************************************************
  -- *
  -- * Connections created via spec
  -- *
  -- ***********************************************************************************
  -- create connections if selected
  if(!this.connections.set()) then
    -- get picked items for passing to obst list (do it as strings easier for collection)
    -- taken set obst from here

    -- Clash rails against obst list
    !clashPoints = !!claRailPoints(!this.railStore)

    -- create fittings
    !clashPoints.crtConnection(!this.connections)

    -- restore clasher defaults
    --  !!claDataHandle('RESTORE',array())
  endif

  !!ce = !this.storage

  -- reset prompt for next picks
  if(!!aslHandrail.shown()) then
    !!aslHandrail.start = object EDGDATA()
  endif


  !!aslHandrail.end   = object EDGDATA()
  !!edgGeomPrmpt('Handrail Definition','Define Rail Start : ', '')
  !!aidClear(|ALL|,|ALL|)
  !this.connections = object DBREF()
  !this.apply.active = FALSE

  !this.railStore.clear()

  !this.railDir = object DIRECTION()
  !this.railSide = object DIRECTION()

endmethod
-- End of method definition for .createRails(STRING)



------------------------------------------------------------------------
--
-- Method:      <close>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()
  -- clear Aids
  !!aidClear(|ALL|,|ALL|)
  -- reset form members holding picked info
  !this.start = object EDGDATA()
  !this.end   = object EDGDATA()
  !this.storage = object DBREF()
  !this.railDir = object DIRECTION()
  !this.defaultStore.clear()
  !this.connections =  object DBREF()
  !this.railSide = object DIRECTION()

  -- close EDG
  !!edgPop(-1)
  !this.railStore.clear()
endmethod
-- End of method definition for .close()


------------------------------------------------------------------------
--
-- Method:      <loadSpec>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .loadSpec()

  -- Initialise Variables
  !specs   = ARRAY()
  !message = STRING()

  -- Get all messages

  call !!findSpecs('STL','HAND',object DBREF(),!message,!specs)

  -- If there are no specs, the we can't set any
  if(!specs.unset()) then
    return error 1 'Unable to find any HANDRAIL specifications.'
  endif

  -- Load Spec gadget with data
  !block  = object BLOCK('!specs[!evalIndex].description')
  !dText  = !specs.evaluate(!block)
  !block  = object BLOCK('!specs[!evalIndex].string()')
  !rText  = !specs.evaluate(!block)
  !!aslHandrail.specifications.dText = !dText
  !!aslHandrail.specifications.rText = !rText
  !!aslHandrail.specifications.val   = 1

  call !!specLoad(!!aslHandrail.specData, 'AUTO',  false )
  call !!specLoad(!!aslHandrail.specData, 'SPEC',  !!aslHandrail.specifications.selection().dbRef() )
  call !!specLoad(!!aslHandrail.specData, 'SPCO',  object DBREF() )
  call !!specLoad(!!aslHandrail.specData, 'REF',   object DBREF() )
  call !!specLoad(!!aslHandrail.specData, 'STANDARD',  true )
  --call !!specLoad(!!aslHandrail.specData, 'ACTION', '!!aslHandrailCriteria()' )

  -- Re-load specification
  call !!specSetUp(!!aslHandrail.specData)


endmethod
-- End of method definition for .loadSpec()
