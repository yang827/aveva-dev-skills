--
-- Description:
-- Form for controlling picking items for linking
--
------------------------------------------------------------------------

-- Define form
setup form !!aslLinkRail

  !!aslLinkRail.formTitle     = 'Rail Post Linking'
  !!aslLinkRail.iconTitle     = 'RailLink'
  !!aslLinkRail.callback      = '!!aslLinkRailInit(!!aslLinkRail.post,|POST|,|RED|,|NORMAL|)'
  !!aslLinkRail.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition


path down

 frame .pickO |Pick Option|

  button .post | Pick Post  | call |!!aslLinkRailInit(!!aslLinkRail.post,'POST', 'RED','REPICK')|
  button .bracket |Pick Bracket| call |!!aslLinkRailInit(!!aslLinkRail.bracket,'BRACKET', 'RED','REPICK')|

 exit

  button .accept |Accept| call |!!aslLinkRailExec(!!aslLinkRail.posts, !!aslLinkRail.brackets)|
path right

 -- Bottom Line
  button .cancel |Dismiss| at xmax form-size call |!!edgAppClear('ASL Rail Linking')| ok

  member .whichPick is GADGET
  member .posts is ARRAY
  member .brackets is ARRAY
  member .pickedItem is DBREF
  member .pickedItemSave is DBREF

exit

-- Initialise button and member
   !!aslLinkRail.post.background = 'RED'

-- End of form definition for !!aslLinkRail
