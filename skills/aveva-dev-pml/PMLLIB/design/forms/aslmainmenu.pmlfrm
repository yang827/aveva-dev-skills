-- Define form
   setup form !!aslMainMenu

   !!aslMainMenu.formTitle     = 'ASL Main Menu'
   !!aslMainMenu.iconTitle     = 'ASLMENU'
   !!aslMainMenu.callback      = ''
   !!aslMainMenu.formRevision  = ' $Revision: 1.5 $ '

-- Bar Menu
   bar

   exit

   para .dummyForFormWid at ymin width 65 lines 1


  frame .storage at xmin ymax  |Storage Areas|

     button .ladder |Ladders | at xmin+0.5 ymax
     para   .ladders  at xmax.ladder ymin width 30 lines 1
     _ladders.val = | Not Set|

     button .stair | Stairs |   at xmin.ladder ymax
     para   .stairs  at xmax.stair ymin width 30 lines 1
     _stairs.val  = | Not Set|

     button .ramp | Ramps  | at xmin.ladder ymax
     para   .ramps  at xmax.ramp ymin width 30 lines 1
     _ramps.val  = | Not Set|

     button .walk |Walkways| at xmin.ladder ymax
     para   .walks  at xmax.walk ymin width 30 lines 1
     _walks.val  = | Not Set|

    exit
-- End of form definition for !!aslMainMenu
   exit

   -- Define Bar Menu

   !bar = !!aslMainMenu.bar
      !bar.add('Control',   'Cntrl')
      !bar.add('Checking', 'Checker')
      !bar.add('Setting',  'Settings')
      !bar.add('Create',  'Create')
      !bar.add('Modify',  'Modify')
      !bar.add('Connect', 'Connect')
   -- Create Menu

   !menu = !!aslMainMenu.newMenu('Create')

-- reference to old until new functions are available
     !menu.add('CALLBACK', 'ASL Framework...', 'CALLG XCRTPURP FRMW')
     !menu.add('CALLBACK', 'ASL Sub-Frame...', 'CALLG XCRTPURP SBFR')
     !menu.add('CALLBACK', 'Access Way...',    'Call !!aslSpecInvo(|CREATE|)')
     !menu.add('CALLBACK', 'Platform...',      'show !!aslSpecInvo(|CREATE|)')
     !menu.add('CALLBACK', 'Handrail...',      '!!aslHandrailInvo(|CREATE|,!!ce)')
     !menu.add('Separator')
     !menu.add('CALLBACK', 'Fixing...',        'show !!aslSpec')
     !menu.add('CALLBACK', 'Cage...',          'show !!aslSpec')
     !menu.add('CALLBACK', 'Lower Fitting...', 'show !!aslSpec')
     !menu.add('CALLBACK', 'Upper Fitting...', 'CALLAC XASLFITT CREATE FITT')



-- Control
   !menu = !!aslMainMenu.newMenu('Cntrl')
     !menu.add('CALLBACK', 'Close', '!!aslMainMenu.hide()')


-- Checker
   !menu = !!aslMainMenu.newMenu('Checker')
     !menu.add('CALLBACK', 'Data Consistency...', 'show !!checker')


-- Settings
   !menu = !!aslMainMenu.newMenu('Settings')
     !menu.add('CALLBACK', 'Defaults...', 'show !!tmpDfltLoad')
--     add |Storage Areas...|      |call !!todo() |



-- Modify Menu
   !menu = !!aslMainMenu.newMenu('Modify')
     !menu.add('CALLBACK', 'Access Way...',    'Call !!aslSpecInvo(|MODIFY|)')
     !menu.add('CALLBACK', 'Platform...',      'show !!aslSpec')
     !menu.add('MENU','Handrail', 'HandRail')
     !menu.add('Separator')
     !menu.add('CALLBACK', 'Fixing...',        'show !!aslSpec')
     !menu.add('CALLBACK', 'Cage...',          'show !!aslSpec')
     !menu.add('CALLBACK', 'Lower Fitting...', 'show !!aslSpec')
     !menu.add('CALLBACK', 'Upper Fitting...', 'show !!aslSpec')

-- Connect menu
   !menu = !!aslMainMenu.newMenu('Connect')
   !menu.add('CALLBACK','Link Rails...', 'Call  !!aslLinkRailInvo()')
   !menu.add('CALLBACK','Realign Connections...', 'Call  !!aslFittToPostAlg(!!ce)')
-- Sub menu information

-- Handrail Menu
   !menu = !!aslMainMenu.newMenu('HandRail')
     !menu.add('CALLBACK', 'Specification...', 'Call !!aslHandrailInvo(|MODIFY|,!!ce)')
     !menu.add('CALLBACK', 'Components...',    'Call !!aslCmpSprefInvo(TRUE)')


   call !!storageForArea(!!aslMainMenu.ladder,!!aslMainMenu.ladders,'ASL','LADDER','NOCHECK')
   call !!storageForArea(!!aslMainMenu.stair,!!aslMainMenu.stairs,'ASL','STAIR','NOCHECK')
   call !!storageForArea(!!aslMainMenu.ramp,!!aslMainMenu.ramps,'ASL','RAMP','NOCHECK')
   call !!storageForArea(!!aslMainMenu.walk,!!aslMainMenu.walks,'ASL','WALKWAY','NOCHECK')
