--
--
-- Description:
-- form to create and modify ASL components
--
------------------------------------------------------------------------

-- Define form
setup form !!aslSpec

  !!aslSpec.formTitle     = 'Create Access Ways'
  !!aslSpec.iconTitle     = 'ASLCRT'
  --!!aslSpec.callback      = '!!aslSpecInit(|LOAD|,object dbref())'
  !!aslSpec.formRevision  = ' $Revision: 1.6 $ '

-- Body of form definition


-- Define CE Button
    button .ce |CE| at x0.5 y0.2 call |Call !!aslSpecInit('MODIFY',!!ce)|

-- Display CE Name
    para .ceName at xmax+1 ymin  text || width 63 lines 1
-- Create/Modify
   !displayOption = 'Create Modify'
   !replaceOption = !displayOption.upcase()
   !displayMode          = !displayOption.split()
   !replaceMode          = !replaceOption.split()
   option .mode || at xmax form-size ymin call |call !!aslSpecInit(!!aslSpec.mode.selection('RTEXT'),!!aslSpec.ceName)| width 7
   !!aslSpec.mode.dText  = !displayMode
   !!aslSpec.mode.rText  = !replaceMode

-- Spec selection
    frame .sframe at x0.5 ymax+0.2 |Specification Data|

-- Load Spec
   button .loadSpec |Load Specs| at xmin+0.4 ymax call |call !!aslSpecLoad()|

-- Permissible Spec
   option .specifications at xmax+1 ymin width 20

-- Default Select mode
   toggle .default |Auto Default Selection| at xmax+2 ymin
--   option .sort |List | at xmax+4 ymin call |call !!aslSpecLoad()| width 12
-- Create option list
--    !dText[1] = |Constructions|
--    !dText[2] = |Details|
--    !dText[3] = |All|
--    !rText[1] = |SPACE|
--    !rText[2] = |DETAIL|
--    !rText[3] = |ALL|
-- Set option list from arrays above
 --   !!aslSpec.sort.dText = !dText
 --   !!aslSpec.sort.rText = !rText

-- Available Types

   list .selected |Current Selection| at x1 ymax.loadSpec+0.1 width 64 length 5
   list .perms at xmin ymax+1 width 64 length 5


   para .question at xmin.perms ymin.perms-1 width 40 lines 1

-- Temporary button for getting default info from selected spco

   button .temporary |Set Default Criteria| at xmax ymin call |Call !!aslSpecCriteria()|

   member .specData is SPECDATA


  exit

-- Positioning & Orientation

  frame .pframe at x0.5 ymax+0.2 |Position & Rotation|

-- ASL direction (as a direction first point to second point)
    text .direction at xmin+0.5 ymax+0.3  |Direction| call || width 20  is DIRECTION
    !!aslSpec.direction.val = N
   option .topOrBot |Picking Type:| at xmax+1 ymin call || width 6
-- Set options available
    !options = 'Top Bottom'
    !rOptions = 'D U'
    !pickDirs = !rOptions.split()
    !pickTypeDisplay = !options.split()
    !!aslSpec.topOrBot.dText = !pickTypeDisplay
    !!aslSpec.topOrBot.rText = !pickDirs
-- Angle of ASL
   text .angle at xmin.direction+4 ymax |Angle| call |!!aslGeom()| width 10 is REAL


-- Picking type
    frame .iframe at x1 ymax+0.2 |Pick Options|
     button .pt2pt | Point To Point | call |!!whichPick(!!aslSpec.pt2pt,false,false,'RED')|  at x1 y1
     button .ptNrm |Point To Plane/Angle| call |!!whichPick(!!aslSpec.ptNrm,true,false,'RED')| at xmax ymin
     button .ptLev | Point To Plane/Line | call |!!whichPick(!!aslSpec.ptLev,true,false,'RED')| at  xmax ymin
    exit

-- Start Position (WP 1)
   frame .start at x1 ymax+0.2 |First WP Position|
-- Fix Datum Lock
    toggle .firstWpFix |Lock WP As Datum Point| at xmin+1 ymax call |!!aslWpLock(!!aslSpec.firstWpFix,'First')|
-- Define start
    toggle .reDef |Define First WP| at xmin ymax call |!!reDefStart(true)|
   para  .lock  at xmax+8 ymin text |Lock|
-- Define XYZ data
   option   .xO at xmin.reDef ymax+0.1 call |!!reStatePos(!!aslSpec.xO,!!aslSpec.x, !!aslSpec.startPos.pos.east,'Start',!!aslSpec.angle.val)| width 6
   !dText = ARRAY()
   !rText = ARRAY()
   !dText[1] = |East|
   !rText[1] = ||
   !dText[2] = |West|
   !rText[2] = |-|
   !!aslSpec.xO.dText = !dText
   !!aslSpec.xO.rText = !rText

   text .x  at xmax+1 ymin call |!!reStatePos(!!aslSpec.xO,!!aslSpec.x, !!aslSpec.startPos.pos.east,'Start',!!aslSpec.angle.val)| width 12 isou
   !!aslSpec.x.val = |0|
    toggle .xT at xmax ymin call |$p grey out line| states |false| |true|
   !!aslSpec.xT.val = false

  option   .yO at xmin_xO ymax+0.2 call |!!reStatePos(!!aslSpec.yO,!!aslSpec.y, !!aslSpec.startPos.pos.north,'Start',!!aslSpec.angle.val)| width 6
   !dText[1] = |North|
   !rText[1] = ||
   !dText[2] = |South|
   !rText[2] = |-|
   !!aslSpec.yO.dText = !dText
   !!aslSpec.yO.rText = !rText


  text .y  at xmax+1 ymin call |!!reStatePos(!!aslSpec.yO,!!aslSpec.y, !!aslSpec.startPos.pos.north,'Start',!!aslSpec.angle.val)| width 12 isou
  !!aslSpec.y.val = |0|
    toggle .yT at xmax ymin call |$p grey out line| states |false| |true|
   !!aslSpec.yT.val = false

  option   .zO at xmin_xO ymax+0.2 call |!!reStatePos(!!aslSpec.zO,!!aslSpec.z, !!aslSpec.startPos.pos.up,'Start',!!aslSpec.angle.val)| width 6
   !dText[1] = |Up|
   !rText[1] = ||
   !dText[2] = |Down|
   !rText[2] = |-|
   !!aslSpec.zO.dText = !dText
   !!aslSpec.zO.rText = !rText


  text .z  at xmax+1 ymin call |!!reStatePos(!!aslSpec.zO,!!aslSpec.z, !!aslSpec.startPos.pos.up,'Start',!!aslSpec.angle.val)| width 12 isou
  !!aslSpec.z.val = |0|
    toggle .zT at xmax ymin call |$p grey out line| states |false| |true|
   !!aslSpec.zT.val = false

   exit

-- End Position
   frame .end at xmax.start+1 ymin.start   |Second WP Position|
-- Fix Datum Lock
    toggle .secondWpFix |Lock WP as Datum Point| at xmin+1 ymax call |!!aslWpLock(!!aslSpec.secondWpFix,'Second')|
-- Define End
    toggle .reDefEnd |Define Second WP| at xmin ymax call |!!reDefStart(false)|
   para  .locke  at xmax+8 ymin text |Lock|
-- Define XYZ data
   option   .xO1 at xmin.reDefEnd ymax+0.1 call |!!reStatePos(!!aslSpec.xO1,!!aslSpec.x1, !!aslSpec.endPos.pos.east,'End',!!aslSpec.angle.val)| width 6
   !dText[1] = |East|
   !rText[1] = ||
   !dText[2] = |West|
   !rText[2] = |-|
   !!aslSpec.xO1.dText = !dText
   !!aslSpec.xO1.rText = !rText

   text .x1  at xmax+1 ymin call |!!reStatePos(!!aslSpec.xO1,!!aslSpec.x1, !!aslSpec.endPos.pos.east,'End',!!aslSpec.angle.val)| width 12 isou
   !!aslSpec.x1.val = |0|
   toggle .xT1 at xmax ymin call |$p grey out line| states |false| |true|
   !!aslSpec.xT1.val = false


  option   .yO1 at xmin_xO1 ymax+0.2 call |!!reStatePos(!!aslSpec.yO1,!!aslSpec.y1, !!aslSpec.endPos.pos.north,'End',!!aslSpec.angle.val)| width 6
   !dText[1] = |North|
   !rText[1] = ||
   !dText[2] = |South|
   !rText[2] = |-|
   !!aslSpec.yO1.dText = !dText
   !!aslSpec.yO1.rText = !rText


  text .y1  at xmax+1 ymin call |!!reStatePos(!!aslSpec.yO1,!!aslSpec.y1, !!aslSpec.endPos.pos.north,'End',!!aslSpec.angle.val)| width 12 isou
  !!aslSpec.y1.val = |0|
  toggle .yT1 at xmax ymin call |$p grey out line| states |false| |true|
  !!aslSpec.yT1.val = false

  option   .zO1 at xmin_xO1 ymax+0.2 call |!!reStatePos(!!aslSpec.zO1,!!aslSpec.z1, !!aslSpec.endPos.pos.up.'End',!!aslSpec.angle.val)| width 6
   !dText[1] = |Up|
   !rText[1] = ||
   !dText[2] = |Down|
   !rText[2] = |-|
   !!aslSpec.zO1.dText = !dText
   !!aslSpec.zO1.rText = !rText


  text .z1  at xmax+1 ymin call |!!reStatePos(!!aslSpec.zO1,!!aslSpec.z1, !!aslSpec.endPos.pos.up,'End',!!aslSpec.angle.val)| width 12 isou
  !!aslSpec.z1.val = |0|
   toggle .zT1 at xmax ymin call |$p grey out line| states |false| |true|
   !!aslSpec.zT1.val = false

   exit

  exit

-- Bottom Line

    button .dismiss |Dismiss| at xmax+1-size ymax+0.5 call |!!closeAsl()| ok
    button .apply   |Apply|   at xmin form-0     ymin    call |!!createAsl()| apply
-- temporary for GENSEC / SCTN evaluation
    toggle .gensec  |Gensec|  at xmax+1    ymin  states |false| |true|
    button .eval |Auto Select| at xmax+1 ymin call |CALLAC DSELSPEC|
    button .check |Check Data| at xmax+1 ymin call |$p check data set is correct to selected ASL comp|
  -- Display plot file
    button .plot |Plotfile...| at xmin.dismiss-13 ymin call |CALLSTL XSTLPLOT  $$!!aslSpec.spre.selection('Rtext')|

-- what was the old Userdata (define members)

    member .refe is DBREF    $* Current Ref



    member .startPos is EDGDATA
    member .endPos is EDGDATA
    member .endDerPos is POSITION
    member .dflts is SPECDFLTS
    member .whichPick is GADGET
    member .maxLength is REAL
-- members for CE Spec selection
    member .storeSpec is STRING
    member .storeGtyp is STRING
    member .storeStyp is STRING
    member .storeSpre is STRING

    !!aslSpec.refe  = REFE
 --   !!aslSpec.mode.select('RTEXT','MODIFY')
--    !!aslSpec.type  = |SCTN|


-- set values of buttons
   !!aslSpec.pt2pt.val = |Point2Point|
   !!aslSpec.ptNrm.val = |Normal|
   !!aslSpec.ptLev.val = |Point2Plane|


   !!whichPick(!!aslSpec.ptNrm,true,false,'RED')


-- End of form definition for !!aslSpec
exit


-- link gadgets with spec data

   call !!specLinks(!!aslSpec.specData,'SpecData',!!aslSpec.selected,!!aslSpec.perms)

   call !!specAddLink(!!aslSpec.specData, 'SPECS',!!aslSpec.specifications)
   call !!specAddLink(!!aslSpec.specData, 'QUESTION',!!aslSpec.question)
   call !!specAddLink(!!aslSpec.specData, 'DEFAULT',!!aslSpec.default)
