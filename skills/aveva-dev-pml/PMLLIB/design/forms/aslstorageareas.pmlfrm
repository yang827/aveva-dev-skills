-- Define form
setup form !!aslStorageAreas

  !!aslStorageAreas.formTitle     = 'Storage Areas'
  !!aslStorageAreas.iconTitle     = 'Storage Areas'
  !!aslStorageAreas.callback      = ''
  !!aslStorageAreas.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  path down

  -- List setting
  list   .list 'Storage Areas' width 50 length 4

exit

-- End of form definition for !!aslStorageAreas

if (undefined(!!storageAreas)) then
  pml load form !!storageAreas
endif

-- Link gadgets to group storage
call !!storageForGroup(!!aslStorageAreas.list, 'ASL','NOCHECK')

-- Load gadgets
call !!storageAreasDisp()
