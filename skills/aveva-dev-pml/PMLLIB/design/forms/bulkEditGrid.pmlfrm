-- Description:
--- form definition
import 'GridControl'
handle (1000,0)
endhandle

import 'OutputAddin'
handle (1000,0)
endhandle


setup form !!bulkEditGrid dialog docking

  using namespace 'Aveva.Pdms.Presentation'


  path down

  frame .filterFrame anchor t+l+r |Options| at xmax+0.5 ymax+0.5 width 72
    para .loadHeading width 20 lines 1
    option .loadOption anchor t+l at xmin ymax width 18
    list   .columns anchor t+l 'Columns' at xmax+3 ymin.loadHeading multiple width 32 height 6
    button .refresh 'Refresh' at xmin.loadOption ymax.columns-size
  exit

  path down

  frame .tagsFrame |Objects| at xmin_filterFrame ymax+0.5 anchor all
    container .conTagsFrame PmlNetControl 'NET' anchor all width 70 height 24
  exit

  menu .tagsPopup popup
  !this.tagsPopup.add( 'CALLBACK', 'Navigate To', '!this.navigate()' )
  !this.tagsPopup.add( 'CALLBACK', 'Reset Cell Feedback', '!this.resetCellFeedback()' )
  !this.tagsPopup.add( 'CALLBACK', 'Refresh Grid', '!this.refresh()' )
  !this.tagsPopup.add( 'CALLBACK', 'Claim', '!this.claimTag()' )
  !this.tagsPopup.add( 'separator' )
  !this.tagsPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.editGrid, ||, |Save As|)' )
  !this.tagsPopup.add( 'callback', 'Print Preview...', '!this.editGrid.printpreview()' )

  --Form members
  member .tag  is DBREF
  member .tags is ARRAY
  member .editGrid is NETGRIDCONTROL

exit

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyCellCallback(ARRAY)         -                   Check the changes made to editable cell and save if permitted
--  bulkEditGrid()                   -                   Constructor
--  claimTag()                       -                   Claim out the selected tags
--  initialise()                     -                   populate the grid
--  navigate()                       -                   navigate to the selected grid item
--  popupGridCallback(ARRAY)         -                   Right click options
--  refresh()                        -                   Recalculate the content of every cell to refresh to the latest database state.
--  resetCellFeedback()              -                   Reset the cell editing feedback highlight colour and tooltip text
--
-- Method:      bulkEditGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .bulkEditGrid()

  using namespace 'Aveva.Pdms.Presentation'
  !this.formTitle = 'Bulk Edit Grid'
  !this.iconTitle = 'Grid'
  !this.initcall  = '!this.initialise()'

  -- column selection
  !this.columns.add('NAME')
  !this.columns.add('TYPE')
  !this.columns.add('AREA')
  !this.columns.add('BUILT')
  !this.columns.add('CMPSTS')
  !this.columns.add('DESC')
  !this.columns.add('DUTY')
  !this.columns.add('FUNC')
  !this.columns.add('NUMB')
  !this.columns.add('POSITION')
  !this.columns.add('PRESS')
  !this.columns.add('PSPE')
  !this.columns.add('PURP')
  !this.columns.add('TEMP')
  !initialSelection = ARRAY()
  !initialSelection.append('NAME')
  !initialSelection.append('TYPE')
  !this.columns.select('Dtext', !initialSelection)

  -- load options
  !this.loadHeading.val = 'Load from'
  !dText = ARRAY()
  !rText = ARRAY()
  !dText.append('Graphical Selection')
  !dText.append('Drawlist')
  !dText.append('Members of CE')
  !dText.append('Primary Types below CE')
  !dText.append('Search Results')
  !rText.append('GRAPH')
  !rText.append('DRAW')
  !rText.append('CE')
  !rText.append('PRIMARY')
  !rText.append('SEARCH')
  !this.loadOption.dText = !dText
  !this.loadOption.rText = !rText
  !this.loadOption.select('Rtext', 'GRAPH')

  -- callbacks
  !this.loadOption.callback = '!this.initialise()'
  !this.refresh.callback    = '!this.initialise()'
  -- create instance of .Net control
  !this.editGrid = object NETGRIDCONTROL()
  -- add .Net control to PML container
  !this.conTagsFrame.control = !this.editGrid.handle()

  -- add PML event handlers to .Net control
  !this.editGrid.addeventhandler('OnPopup', !this, 'PopupGridCallback')
  !this.editGrid.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellCallback')

   -- make bulk editable grid
  !this.editGrid.bulkEditableGrid(TRUE)
  !this.editGrid.columnExcelFilter(TRUE)
  !this.editGrid.outlookGroupStyle(TRUE)
  !this.editGrid.fixedHeaders(TRUE)
  !this.editGrid.fixedRows(TRUE)
  !this.editGrid.feedbackSuccessColor('Green')
  !this.editGrid.feedbackFailColor('Red')
  !this.editGrid.syntaxErrorColor('Orange')
  !this.editGrid.readOnlyCellColor('Grey')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      popupGridCallback
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupGridCallback(!data is ARRAY)
   !this.conTagsFrame.popup = !this.tagsPopup
   !this.conTagsFrame.showPopup(!data[0], !data[1])
   !this.tag = !data[2][1].dbref()
   !this.tags.clear()
   do !item values !data[2]
     !this.tags.append(!item.dbref())
   enddo

endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .applyCellCallback()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyCellCallback(!data is ARRAY)
   !!mmsaccess = '3DMM'
   !this.editGrid.doDabaconCellUpdate(!data)
   !!mmsaccess.delete()
endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: populate the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--               option       initialise or re-populate
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Attributes selection
  !attributes = ARRAY()
  do !attribute values !this.columns.selection()
    !attributes.append(!attribute)
  enddo

  -- Load option
  if (!this.loadOption.selection() eq 'CE') then
    -- Members of current element
    !collection = !!ce.members
  elseif (!this.loadOption.selection() eq 'PRIMARY' or !this.loadOption.selection() eq 'ALL') then
    -- Primary types below CE or all
    !firstPass = object COLLECTION()
    !firstPass.filter(object EXPRESSION('PRIMTYPE eq TRUE'))
    if (!this.loadOption.selection() eq 'ALL') then
      if (!!alert.confirm('Are you sure you want to load all primary types in the MDB? This may take some time.') ne 'YES') then
        return
      endif
    elseif (!this.loadOption.selection() eq 'PRIMARY') then
      !firstPass.scope(!!ce)
    endif
    !primaryTypes = !firstPass.results()
    !collection = ARRAY()
    -- Work around defect that primary types array can include TUBIs
    do !ele values !primaryTypes
      if (!ele.type ne 'TUBI') then
        !collection.append(!ele)
      endif
    enddo
  elseif (!this.loadOption.selection() eq 'DRAW') then
    -- Find the currently selected view and its draw list members
    if (!!gphviews.views.empty()) then
      !collection = ARRAY()
    else
      !collection = !!gphDrawLists.drawList(!!fmsys.currentDocument().view).members()
    endif
  elseif (!this.loadOption.selection() eq 'GRAPH') then
    -- Find the currently graphically selected items
    !selection = object SELECTION()
    !selection.getCurrent()
    !collection = !selection.getSelection()
  elseif (!this.loadOption.selection() eq 'SEARCH') then
    -- find out the search results
    using namespace 'Aveva.Pdms.Presentation.OutputAddin'
    !searchResults = object PMLSEARCHRESULTS()
    !collection = !searchResults.items()
  endif

  if (!this.loadOption.selection() eq 'SEARCH') then
    !names = !collection
  else
    !names = !collection.evaluate(object BLOCK('!collection[!evalIndex].string()'))
  endif

  using namespace 'Aveva.Pdms.Presentation'
  !tableName = 'Bulk Edit Grid'
  !nds = object NETDATASOURCE(!tableName, !attributes, !names)
  !nds.displayUnsetAs('')
  !nds.displayNulrefAs('=0')
  !this.editGrid.bindToDataSource(!nds)
  !this.editGrid.gridHeight(1000.0)
  !this.editGrid.setNameColumnImage()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: navigate to the selected grid item
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

  !!ce=!this.tag

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      resetCellFeedback
--
-- Description: Reset the cell editing feedback highlight colour and tooltip text
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resetCellFeedback()
   !this.editGrid.resetCellFeedback()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Recalculate the content of every cell to refresh to the latest database state.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()
   !this.editGrid.refreshTable()
endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      claimTag
--
-- Description: Claim out the selected tags
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .claimTag()
  do !item values !this.tags
    claim $!<item> hier
    handle ANY
    endhandle
  enddo
endmethod

-- End of method definition

-- For Information ------------------------------------------------------------------------------------
--
-- To customise the graphical view drawlist menu to show this form for the graphical selection
-- Create a pml function pmllib\common\functions\bulkEditGrid.pmlfnc
-- with the following content
--
--      define function !!bulkEditGrid()
--
--        if (undefined(!!bulkEditGrid)) then
--          pml load form !!bulkEditGrid
--        endif
--        !!bulkEditGrid.loadOption.select('Rtext', 'GRAPH')
--        show !!bulkEditGrid
--
--      endfunction
--
-- and add an entry in pmllib\common\functions\gph3dDesign.pmlfnc
-- to the end of the block that defines the drawlist menu, i.e.
--
--      !formName.newMenu('drawlistMenu')
--      ...
--      !formName.drawlistMenu.add('callback', 'Bulk Edit Graphical Selection...', '!!bulkEditGrid()')
--
-------------------------------------------------------------------------------------------------------
