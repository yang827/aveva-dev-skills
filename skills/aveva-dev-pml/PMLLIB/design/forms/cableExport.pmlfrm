-- File:    cableExport.pmlfrm
-- Type:    Form Definition
-- Group:   Cabling System Application
-- Keyword:
-- Module:  Design
--
-- Author:  J.Wyatt
-- Created: 23/10/2009
--
-- Description:
-- Allows the user to Export cable information to a spreadsheet.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cableExport()                    -                   Constructor
--  cancelFormMethod()               -                   Add rectangle to list
--  findData()                       -                   Collects data for the grid gadget
--  init()                           -                   Initialise the form when shown
--  initGrid()                       -                   Initialises the grid gadget and fills it with the collected data
--  rightClickGrid(ARRAY)            -                   Controls the right-click menu for the grid gadget
--  rightClickGridActive(BOOLEAN)    -                   Set .net pop-up active control
--  setCE()                          -                   Callback for CE button, checks selection is valid
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

setup form !!cableExport resize

  using namespace 'Aveva.Pdms.Presentation'

  -- Define grid gadgets right-click menu
  menu .gridPopup popup
  !this.gridPopup.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.netExport, |CableExport.xls|, |Save As|)', 'EXPORT' )
  !this.gridPopup.add( 'callback', 'Print Preview...', '!this.netExport.printpreview()', 'PRINT' )

  frame .frOpen 'Select Site/Zone'		     at x0                 ymin     anchor T+L+R     width 70
  	button    .buZone 'CE' width 4
  	--paragraph .paZoneTitle                 at x1                 ymax     text 'Selected:' width 13
    paragraph .paZone                      at xmax+1             ymin     text 'unset'     width 25
  exit
  frame  .frExport      'Cable Data'         at xmin.frOpen        ymax     anchor ALL       width 70
    container .coExport nobox PMLNetCONTROL 'Input' DOCK FILL height 18
  exit

	button .export 'Export' at xmax form-18 ymax+0.25 anchor b+r width 8
  button .dismiss 'Dismiss' at xmax+.2 ymin anchor b+r width 8 cancel

	member .netExport is NETGRIDCONTROL
  member .names            is ARRAY
  member .selectedSiteZone is DBREF
  member .prevSaveLocation is STRING
  member .currentFile      is STRING
  member .cableRefs        is ARRAY
  member .cableHeadings    is ARRAY
  member .cableData        is ARRAY
exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      cableExport
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cableExport()
  using namespace 'Aveva.Pdms.Presentation'
  !this.formRevision = ' $Revision$ '
  !this.initCall     = '!this.init()'
  !this.formTitle    = 'Cable Export'
  !this.quitCall     = '!this.cancelFormMethod()'

  !this.prevSaveLocation = |C:\|

  -- Callbacks
  !this.buZone.callback = '!this.setCE()'
  !this.export.callback = '!!exportToExcel(!this.netExport, |CableExport.xls|, |Save As|)'

  -- Tooltips
  !this.export.setTooltip('Export to Excel')
  !this.buZone.setTooltip('Select a Site / Zone Current Element')
  !this.dismiss.setTooltip('Dismiss')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise the form when shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Clears the grid gadget when the form is shown
  --!this.netExport.clearGrid()

	!this.initGrid()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      findData
--
-- Description: Collects data for the grid gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findData()

  -- format for cable length output
  !cableLengthFormat             = object FORMAT()
  !cableLengthFormat.dimension   = 'DIST'
  !cableLengthFormat.label       = ''
  !cableLengthFormat.dp          = 2
  !cableLengthFormat.trailZeros  = true
  if( !!isImperialLength('DIST') ) then
    !cableLengthFormat.units     = 'ft'
  else
    !cableLengthFormat.units     = 'metre'
  endif

  !this.cableRefs = ARRAY()
  !this.cableData = ARRAY()

  -- Collect all cables below the CE
  !cableColl = object COLLECTION()
  !cableColl.type('CABLE')
  !location = !this.selectedSiteZone
  !cableColl.scope(!location)
  !this.cableRefs = !cableColl.results()

  -- Sort the headings for use in the grid gadget
  !headings = !!cableHeaderDflts('EXPORT')
  do !row index !headings
    	!this.cableHeadings[!row] = !headings[!row][2]
    if( !headings[!row][1] eq 'CBTOLE' ) then
      !this.cableHeadings[!row] = !this.cableHeadings[!row] + ' (' + !cableLengthFormat.units + ')'
    endif
  enddo
  !nameType = STRING()
  do !j index !headings
     if (!headings[!j][1].eq('NAME') or !headings[!j][1].eq('FLNN')or !headings[!j][1].eq('NAMN'))  then
         	 !nameType= !headings[!j][1]
     endif
  enddo
  if (not !nameType.set()) then
	 !!alert.error('Headings invalid: The table must contain a NAME or FLNN or NAMN column')
   return
  endif

  -- Collect data for each of the cables
  do !i index !this.cableRefs
    do !j index !headings
      !ref  = !headings[!j][1]
      !attribs = !this.cableRefs[!i].$!<ref>.attributes()
      handle ANY
        !attribs = ARRAY()
      endhandle
      if !ref.eq('CBTOLE') then
        -- Output cable length in metre for metric or feet for imperial
        !this.cableData[!i][!j]   = !this.cableRefs[!i].cbtole.string(!cableLengthFormat)
        handle ANY
          !this.cableData[!i][!j] = ''
        endhandle
      elseif !ref.upcase().eq('ROUTND') then
        -- ROUTND attribute is exported as semicolon separated values
        !routndString = ''
        if !this.cableRefs[!i].routnd.set() then
          do !routnd values !this.cableRefs[!i].routnd
            !routndName   = !routnd.flnm
            !routndString = !routndString & !routndName & ';'
          enddo
          !routndString = !routndString.substring(1,!routndString.length() - 1)
        endif
        !this.cableData[!i][!j]   = !routndString

      elseif !attribs.findfirst('Name').set() then
        -- Output NAME rather than DBREF
        !this.cableData[!i][!j] = !this.cableRefs[!i].$!<ref>.$!nameType
        handle ANY
          !this.cableData[!i][!j] = ''
        endhandle
      elseif !this.cableRefs[!i].$!<ref>.unset() then
        !this.cableData[!i][!j] = 'unset'
      else
        !this.cableData[!i][!j] = !this.cableRefs[!i].$!<ref>
        handle ANY
          !this.cableData[!i][!j] = ''
        endhandle
      endif
    enddo
  enddo

  using namespace  'Aveva.Pdms.Presentation'
  !netDataSource = object NETDATASOURCE(' ', !this.cableHeadings, !this.cableData)
  !this.netExport.bindToDataSource(!netDataSource)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initGrid
--
-- Description: Initialises the grid gadget and fills it with the collected data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initGrid()
  using namespace  'Aveva.Pdms.Presentation'
  !this.netExport = object NETGRIDCONTROL()
  !this.netExport.columnExcelFilter(false)
  !this.netExport.outlookGroupStyle(false)
  !this.netExport.fixedHeaders(FALSE)
  !this.netExport.fixedRows(false)
  !this.netExport.editableGrid(FALSE)
  !this.netExport.headerSort(true)
  !this.netExport.setLabelVisibility(FALSE)
  !this.netExport.resetcolumnproperties()
  !this.coExport.control = !this.netExport.handle()
  !this.netExport.addeventhandler('OnPopup', !this, 'rightClickGrid')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rightClickGrid
--
-- Description: Controls the right-click menu for the grid gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Location of the pointer click
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rightClickGrid(!data is ARRAY)

  !this.rightClickGridActive(!this.netExport.getRows().size() gt 0)

-- Show the Popup
  !this.coExport.popup = !this.gridPopup
  !this.coExport.showPopup(!data[0], !data[1])

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      rightClickGridActive
--
-- Description: Set .net Pop-up active control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rightClickGridActive(!active is BOOLEAN)

  !this.gridPopup.setFieldProperty('EXPORT', 'active', !active)
  !this.gridPopup.setFieldProperty('PRINT' , 'active', !active)

endmethod
------------------------------------------------------------------------
--
-- Method:      setCE
--
-- Description: Callback for CE button, checks selection is valid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCE()
  !test = !!cableHeaderDflts('EXPORT')
  if !test.unset() then
    !!alert.error('Cable import/export headings definition file %PDMSDFLTS%/CableHeaderRefs.pmldat does not exist.')
  elseif (type eq 'ZONE') then
    --!this.paZoneTitle.val = 'Current Zone:'
    !this.selectedSiteZone = !!ce.refno
    !this.paZone.val = !!ce.name
    !this.findData()
  elseif (type eq 'SITE') then
    --!this.paZoneTitle.val = 'Current Site:'
    !this.selectedSiteZone = !!ce.refno
    !this.paZone.val = !!ce.name
    !this.findData()
  else
    !!alert.error('Please select a SITE or ZONE')
    --!this.paZoneTitle.val = 'Select Site or Zone:'
    !this.netExport.clearGrid()
    !this.paZone.val = 'unset'
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      cancelFormMethod
--
-- Description: Hides form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancelFormMethod()
  !this.hide()
endmethod
-- End of method
