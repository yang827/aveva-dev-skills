--
-- File:           cabtraybranchoffset.pmlfrm
-- Type:           Form Definition
-- Group:          Cabling Application
--
-- Keyword:        CABLING
-- Module:         design
-- Replaces:
--
-- Author:         Maciej Majewski
-- Created:
-- Last Modified:
-- Description:    Form to set offset on cable tray branch
--
--

setup form !!cabtraybranchoffset

  !this.formTitle = |Offset Position|
  !this.initCall = |!this.init()|

  !this.okCall = |!this.okCall()|
  !this.cancelCall = |!this.cancelCall()|
  !this.quitCall = |!this.quitCall()|
  !this.killingCall = |!this.killCall()|
  para .offXTabOffset TEXT 'Offset:'
  para .offXTab at XMAX YMIN TEXT 'X     '
  text .offX at XMAX.offXTab YMIN  callback '!this.tag()' WIDTH 9 is REAL format !!distanceFmt

  para .offYTabOffset at XMIN.offXTabOffset YMAX.offXTabOffset TEXT 'Offset:'
  para .offYTab at XMAX YMIN TEXT 'Y     '
  text .offY at XMAX  YMIN  callback '!this.tag()' WIDTH 9 is REAL format !!distanceFmt

  para .offZTabOffset at XMIN.offYTabOffset YMAX.offYTabOffset TEXT 'Offset:'
  para .offZTab at XMAX YMIN TEXT 'Z     '
  text .offZ at XMAX YMIN  callback '!this.tag()' WIDTH 9 is REAL format !!distanceFmt
  button .ok | OK | at XMAX + 1 YMIN OK

  member .storedPosition is POSITION

  member .tag is REAL

exit
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cabtraybranchoffset()            -                   Constructor
--  cancelCall()                     -                   cancel Call
--  init()                           -                   initialise
--  killCall()                       -                   kill Call
--  okCall()                         -                   ok Call
--  quitCall()                       -                   quit Call
--  tag()                            -                   Tag offset position
--  tidy()                           -                   tidy aids
--
-- Method:   cabtraybranchoffset()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cabtraybranchoffset()

   !this.tag            = !!aidNumbers.add('Cable Tray Position')

endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method:   init()
--
-- Description: initialise
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  if (!!ce.type NEQ 'BRAN') then
    !!alert.error('Not at a branch')
  endif

  !this.offXTab.val = !!cdctbrat.ewopt.dtext[1]
  !this.offYTab.val = !!cdctbrat.nsopt.dtext[1]
  !this.offZTab.val = !!cdctbrat.udopt.dtext[1]

  !this.offX.val = 0
  !this.offY.val = 0
  !this.offZ.val = 0

  if (!!cdctbrat.ht.val eq 1) then
    !this.storedPosition = !!ce.hpos.wrt(world)
    !this.formTitle = |Offset Head Position|
  else
    !this.storedPosition = !!ce.tpos.wrt(world)
    !this.formTitle = |Offset Tail Position|
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      okCall
--
-- Description: ok Call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .okCall()

  if ( !!cdctbrat.ewopt.val eq 1) then
    !!cdctbrat.ewpos.val = object STRING(!!cdctbrat.ewpos.val.real() + !this.offX.val )
  else
    !!cdctbrat.ewpos.val = object STRING(!!cdctbrat.ewpos.val.real() - !this.offX.val )
  endif

  if ( !!cdctbrat.nsopt.val eq 1) then
    !!cdctbrat.nspos.val = object STRING(!!cdctbrat.nspos.val.real() + !this.offY.val )
  else
    !!cdctbrat.nspos.val = object STRING(!!cdctbrat.nspos.val.real() - !this.offY.val )
  endif

  if ( !!cdctbrat.udopt.val eq 1) then
    !!cdctbrat.udpos.val = object STRING(!!cdctbrat.udpos.val.real() + !this.offZ.val)
  else
    !!cdctbrat.udpos.val = object STRING(!!cdctbrat.udpos.val.real() - !this.offZ.val)
  endif


  !this.tidy()
endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      cancelCall
--
-- Description: cancel Call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancelCall()
   !this.tidy()
endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      quitCall
--
-- Description: quit Call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .quitCall()
  !this.tidy()
endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      killCall
--
-- Description: kill Call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .killCall()
  !this.tidy()
endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag offset position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tag()

  -- Initialise Variables
  AID CLEAR ALL $!<this.tag>

  -- Text description
  !endText      = 'Offset Position'
  !displayPos = !this.storedPosition
  !displayPos.east = !this.storedPosition.east + !this.offX.val
  !displayPos.north = !this.storedPosition.north + !this.offY.val
  !displayPos.up = !this.storedPosition.up + !this.offZ.val

  -- Aid info
  AID TEXT NUMBER $!<this.tag> '$!endText' AT $!<displayPos>

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: tidy aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.tag>

endmethod
