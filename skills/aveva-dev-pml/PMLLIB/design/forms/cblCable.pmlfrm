------------------------------------------------------------------------
--
-- Method:    autoRouteCable
--
-- Description: route Cable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoRouteCable(!cable is DBREF)

      !undo = object UNDOABLE()
      !undo.add()
      !!ce  = !cable
       !zoneArray = ARRAY()
       do !i from 1 to !this.listZone.selection().size()
         !zoneArray.append(!this.listZone.selection()[!i].dbref())
       enddo
       if(!zoneArray.empty() )then
         !!alert.message('No Zone selected to route the Cable')
         !!ce = !this.cableObj.dbref
         !undo.endundoable()
         return
       endif


			 !this.cableManager.unRouteCable(!cable)

       !colRpath = object COLLECTION()
       !colRpath.type('RPATH')
       !colRpath.scope(!this.cableObj.dbref)
       if(!colRpath.results().unset())then
         NEW RPATH
         handle (2,18)
           !!alert.error('Element $!!ce.name is locked.')
           !undo.endundoable()
            return
          elsehandle(2,25)
            !!alert.error('Read only DB')
            !undo.endundoable()
            return
         endhandle
--         !this.setTask('MODIFY','CABLE')
       endif

       !col = object COLLECTION()
       !col.type('EXTGEO')
       !col.scope(!this.cableObj.dbref)
       !colResults = !col.results()
       do !j from 1 to !colResults.size()
         !!ce = !colResults[!j]
         delete $!!ce.type
       enddo
       !!ce = rpath1
       !colPointr = object COLLECTION()
       !colPointr.type('POINTR')
       !colPointr.scope(!this.currentElement)
       !colPointrResults = !colPointr.results()
       do !k from 1 to !colPointrResults.size()
         !!ce = !colPointrResults[!k]
         delete $!!ce.type
       enddo

       !connectionManager = object MDRCONNECTIONMANAGER()
       --!graph = !connectionManager.createConnectionGraphFromBranches(!colZone.results())

       -- get connection graph
       if(!this.listZone.val.set() )then
         --!!cblRouteCable(!cable , !graph , !zoneArray)
         --!this.cableManager.setConnectionsGraph(!graph)
         --!this.cableManager.routeCable(!cable)
         !rtext = object ARRAY()
         do !j from 1 to !this.listZone.rtext.size()
           !nameTrim = !this.listZone.rtext[!j].before(' ')
           !rtext.append(!nameTrim)
         enddo

	       !zoneName=''
				 do !zone values !zoneArray
				   if !zoneName eq '' then
				     !zoneName = !zone.name
				   else
				     !zoneName = !zoneName + ' ' + !zone.name
				   endif
				 enddo
				 !!ce = !this.currentElement
				 if ( !zoneName.occurs('/*') gt 0 ) then
				    rlse all cwbran
				 else
				    rlse all cwbran for $!zoneName
				 endif
         -- Redraw cable in 3D view
         REM CE ADD CE
				 !this.cableManager.routeCable(!cable)
         handle ANY
           !!alert.error(!!error.text)
           !this.cableObj.dbref.cbsta = 2
           !!ce = !this.cableObj.dbref
           !this.loadData('CABLE')
           !undo.endundoable()
           return
         endhandle
       else
         !!alert.message('No Zone selected to route the Cable')
         !!ce = !this.cableObj.dbref
         !undo.endundoable()
         return
       endif
       !!ce = !this.cableObj.dbref
       !this.loadData('CABLE')
       if !!ce.cbsta.eq(2) or !!ce.cbsta.eq(0) then
         !!ce = CE
         --!!alert.warning('Cable is either Un-routed or routing failed. Check the proximity of connected equipment from the Cable way branch. Set proximity distance accordingly.')
         --return
       endif
       !undo.endundoable()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: modifyPointr()
--
-- Description: create a routing point element and append its data to the list gadget
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPointr()

  !undo = object UNDOABLE()
  !undo.add()
  if(!!ce.type.eq('POINTR'))then
    !this.cableObj.pointr.position = !this.getPosFromCntrl(!this.posControl.xyz())
    axes at $!this.cableObj.pointr
    AID clear line $!this.startPosAidNumber
    handle (41,6)
    endhandle
    AID clear line $!this.endPosAidNumber
    handle (41,6)
    endhandle
  else
    !!alert.message('Be at a Route Point to modify')
    return
  endif
  !undo.endundoable()
  endmethod
------------------------------------------------------------
-- Method: aid
--
-- Description: Creation of aid text
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aid(!location is STRING , !pos is POSITION)

  !mode = 'POINTR'
  !aidPos = !pos
  !aidNumber = 1

  if (!location.upcase().eq('NEWPOS')) then
    !aidNumberStart = !this.startPosAidNumber
    !aidNumberEnd   = !this.endPosAidNumber
    AID clear line $!aidNumberStart
    handle (41,6)
    endhandle
    AID clear line $!aidNumberEnd
    handle (41,6)
    endhandle
  elseif (!location.upcase().eq('CONNECTION POS')) then
     !aidNumber = !this.segStartAidNumber
  endif

  AID clear text $!aidNumber
   handle (41,6)
   endhandle

  !loc = '<' & !location & '>'

  if (!location.upcase().eq('NEWPOS')) then
    !!ce = !this.cableObj.pointr
   if (!mode.upcase().eq('POINTR')) then
     !firstPos  = !!ce.position.wrt(worl)
     nex
     handle ANY
     endhandle
     if(!!ce.type.neq('POINTR'))then
       pre
       !lastPos   = !!ce.position.wrt(worl)
     else
       !lastPos   = !!ce.position.wrt(worl)
     endif
     handle ANY
     return
     endhandle
     AID LINE NUMBER $!aidNumberStart $!firstPos to $!aidPos  linestyle dashdot
     AID LINE NUMBER $!aidNumberEnd   $!aidPos   to $!lastPos linestyle dashdot
     handle(46,28)
     endhandle
   else
     !firstPos = !!ce.position.wrt(worl)
     nex
     !lastPos  = !!ce.position.wrt(worl)
     pre
     handle ANY
     endhandle
     AID LINE NUMBER $!aidNumberStart $!firstPos to $!aidPos  linestyle dashdot
     AID LINE NUMBER $!aidNumberEnd   $!aidPos   to $!lastPos linestyle dashdot
   endif

  else
  AID TEXT NUMBER $!aidNumber |$!loc| at $!aidPos
  endif
  !!ce = !this.cableObj.pointr

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: aidClear
--
-- Description: Clearing of aid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidClear(!task is STRING)

    aid clear line $!this.startPosAidNumber
    handle ANY
    endhandle
    aid clear line $!this.endPosAidNumber
    handle ANY
    endhandle
    aid clear text $!this.equiStartAidNumber
    handle ANY
    endhandle
    aid clear text $!this.equiEndAidNumber
    handle ANY
    endhandle
    aid clear text $!this.startAidNum
    handle ANY
    endhandle
    aid clear text $!this.endAidNum
    handle ANY
    endhandle
    aid clear text $!this.starAidNum
    handle ANY
    endhandle
    aid clear text $!this.prpAid
    handle ANY
    endhandle
    if(!task eq 'EXISTING')then
      aid clear text $!this.attaNumber
      handle ANY
      endhandle
      aid clear text $!this.manualAid
      handle ANY
      endhandle
    endif
    if(!task eq 'ENTRY')then
      aid clear text $!this.entryAidNum
      handle ANY
      endhandle
      aid clear text $!this.manualEntryAid
      handle ANY
      endhandle
    endif
    if(!task eq 'ENTRYPART')then
      aid clear text $!this.entryPartAidNum
      handle ANY
      endhandle
      aid clear text $!this.entryManualAidNum
      handle ANY
      endhandle
    endif
    if(!task eq 'EXIT')then
      aid clear text $!this.exitAidNum
      handle ANY
      endhandle
      aid clear text $!this.manualExitAid
      handle ANY
      endhandle
    endif

endmethod
------------------------------------------------------------------------
--
-- Method: getPosFromCntrl
--
-- Description: Converts array from position control to position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPosFromCntrl(!pos is ARRAY) is POSITION

   !position           = object POSITION('E0 N0 U0')
   !east  = !pos[0].string()
   !north = !pos[1].string()
   !up    = !pos[2].string()
   !position = object POSITION('E $!east N $!north U $!up')

   return !position

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: pointrAction
--
-- Description: Actions performed upon selecting POINTR from form
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointrAction()

  !selection            = !this.listPointr.selection()
  !selectionNumber      = !this.listPointr.val
  !this.cableObj.pointr = !this.listPointr.dtext[!selectionNumber].dbref()
  !position             = !this.cableObj.pointr.position.wrt(World)
  !this.posControl.forceXYZ(!position.east, !position.north, !position.up)
  if(!selectionNumber eq 1)then
    !this.direction.active = false
    !this.lengthCwSeg.active = false
  else
    !this.direction.active = true
    !this.lengthCwSeg.active = true
  endif
  !this.setLengthAndDirection('Normal')

  axes at $!this.cableObj.pointr
  handle(2,759)
  if (!this.task.upcase().eq('CREATE') and !this.cableObj.pointr.sequence.eq(!this.cableObj.pointr.owner.members.size()))then
    !!alert.error('Branch tail is connected. Do not create another point after$
                  branch tail')
  endif
  endhandle
  !!ce = !this.cableObj.pointr

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: setLengthAndDirection
--
-- Description: Sets Length and direction Gadgets
-- POINTR from form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setLengthAndDirection(!type is STRING)

     !line  = object LINE()

     !!ce  = !this.cableObj.pointr

     if (!type.upcase().eq('GADGET')) then
      !line.endPosition = !this.getPosFromCntrl(!this.posControl.xyz())
     else
      !line.endPosition = !!ce.position.wrt(worl)
     endif

     if (!this.cableObj.pointr.sequence.neq(1)) then
        pre
        if(!!ce.type.neq('POINTR'))then
          --nex
          !line.startPosition = !!ce.endRef.position.wrt(worl)
        else
          !line.startPosition = !!ce.position.wrt(worl)
        endif
        nex
     else
        !line.startPosition = !!ce.position.wrt(worl)
     endif

     if (!type.upcase().eq('GADGET')) then
        !line.startPosition = !!ce.position.wrt(worl)
     endif

     !this.direction.val    = !line.direction()

     handle (2,785)
     --First member
       nex
       handle ANY
      endhandle
       if(!!ce.type.neq('POINTR'))then
        return
       endif
       handle ANY
        !this.direction.val = U wrt /*
       elsehandle NONE
       !line.endPosition = !!ce.position.wrt(worl)
       pre
       handle ANY
       endhandle
       !this.direction.val         = !line.direction()
        handle ANY
          !this.direction.val      = U wrt /*
        endhandle
      endhandle
     endhandle
     --load Length

    if (!type.upcase().eq('GADGET')) then
      !this.lengthCwSeg.val        = !line.length()
    else
      !this.lengthCwSeg.val        = !line.length()
    endif
    if(!this.cableObj.pointr.sequence.eq(1))then
      !this.direction.val = U wrt /*
      !this.lengthCwSeg.val = 0
    else
     !!ce  = !this.cableObj.pointr
      pre
      if(!!ce.type.eq('EXTGEO'))then
       !this.direction.val      = U wrt /*
      else
       !this.direction.val = !this.cableObj.pointr.pdir[1]
       if !this.direction.val.unset() then
         !this.direction.val = !this.cableObj.pointr.pdir[2]
         if(!this.direction.val .unset())then
           !this.direction.val  = U wrt /*
         endif
       endif
      endif
      sam
    endif
    !this.aid('NewPos', !this.getPosFromCntrl(!this.posControl.xyz()))

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: setPointrPositionGadget
--
-- Description: Sets POINTR position Gadgets
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPointrPositionGadget()

 !!ce  = !this.cableObj.pointr
 pre
  if(!!ce.type.eq('EXTGEO'))then
   !startPos = !!ce.endRef.position.wrt(worl)
  else
   !startPos = !!ce.position
  endif
 nex

 !endPos = !startPos.offset(!this.direction.val, !this.lengthCwSeg.val)
 !this.posControl.xyz(!endPos.east, !endPos.north, !endPos.up)
 !this.aid('NewPos', !this.getPosFromCntrl(!this.posControl.xyz()))
 !!ce  = !this.cableObj.pointr

endmethod

------------------------------------------------------------------------
--
-- Method: extgeoConnList
--
-- Description: extgeos connection list details
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .extgeoConnList(!attaList is STRING)

 if(!attaList eq 'STARTCONNROUTE')then

   !selection = !this.listStartAttaRoute.selection()
   !selectionNumber = !this.listStartAttaRoute.val
   !attaExtGeo = !this.listStartAttaRoute.rtext[!selectionNumber].dbref()
   !this.aidClear('ENTRY')
   aid text num $!this.entryAidNum '<Entry>' at $!attaExtGeo.pos

 elseif(!attaList eq 'ENDCONNROUTE')then

   !selection = !this.listEndAttaRoute.selection()
   !selectionNumber = !this.listEndAttaRoute.val
   !attaExtGeo = !this.listEndAttaRoute.rtext[!selectionNumber].dbref()
   !this.aidClear('EXIT')
   aid text num $!this.exitAidNum '<Exit>' at $!attaExtGeo.pos

 elseif(!attaList eq 'STARTPARTROUTE')then

   !selection = !this.listStartPartAttaRoute.selection()
   !selectionNumber = !this.listStartPartAttaRoute.val
   !attaExtGeo = !this.listStartPartAttaRoute.rtext[!selectionNumber].dbref()
   !this.aidClear('ENTRYPART')
   aid text num $!this.entryPartAidNum '<Route>' at $!attaExtGeo.pos

 elseif(!attaList eq 'STARTMANUALROUTE')then

   !selection = !this.listStartManualAttaRoute.selection()
   !selectionNumber = !this.listStartManualAttaRoute.val
   !attaExtGeo = !this.listStartManualAttaRoute.rtext[!selectionNumber].dbref()
   !this.aidClear('ENTRYPART')
   if !this.manualModify.val.not() then
     !this.aidClear('EXISTING')
   endif
   aid text num $!this.entryManualAidNum '<Route>' at $!attaExtGeo.pos

 endif

endmethod

------------------------------------------------------------------------
--
-- Method: addToList
--
-- Description: extgeos connection list details
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToList(!toList is STRING)

  if(!toList.split()[1].eq('PRP'))then
    if(!this.listStartPartAttaRoute.count.eq(0))then
      !!alert.message('No attachment point to add')
      return
    endif

    !newPrpDtext = !this.listStartPartAttaRoute.dtext[!this.listStartPartAttaRoute.val]
    !newPrpRtext = !this.listStartPartAttaRoute.rtext[!this.listStartPartAttaRoute.val]
    !listSelection = !this.listEndPartAttaRoute.val
    !pos = !newPrpRtext.dbref().pos.wrt(worl)
    -- Get dtext and rtext from current list
    !dtext = !this.listEndPartAttaRoute.dtext
    !rtext = !this.listEndPartAttaRoute.rtext

    if( !dtext.find(!newPrpDtext).size().gt(0) ) then
      !!alert.error('Element has already been added to the list')
      return
    endif

    -- Insert new PRP into list
    if(!toList.split()[2].eq('BEFORE'))then
      !position = !listSelection
      !listSelection = !listSelection + 1
    elseif(!toList.split()[2].eq('AFTER'))then
      !position = !listSelection + 1
    elseif(!toList.split()[2].eq('BOTTOM'))then
      !position = !this.listEndPartAttaRoute.count + 1
    endif
    !dtext.insert(!position, !newPrpDtext)
    !rtext.insert(!position, !newPrpRtext)

    -- Update Gadget
    !this.listEndPartAttaRoute.dtext = !dtext
    !this.listEndPartAttaRoute.rtext = !rtext
    !this.listEndPartAttaRoute.val = !position

    !this.aidClear('ENTRYPART')
    !this.prpAids(|SHOW|)

  elseif(!toList.eq('ADDMANUAL'))then
 	  !this.manualRoute()

  elseif(!toList.eq('REMOVE'))then

    if(!this.listEndPartAttaRoute.count.eq(0))then
      !!alert.message('No attachment point to remove')
      return
    endif
    !this.listEndPartAttaRoute.clear(!this.listEndPartAttaRoute.val)
    !this.aidClear('EXISTING')

  elseif(!toList.eq('REMOVEMANUAL'))then
    if(!this.listEndManualAttaRoute.count.eq(0))then
      !!alert.message('No attachment point to remove')
      return
    endif
  	!index = !this.listEndManualAttaRoute.val
  	!undo = object UNDOABLE()
    !undo.add()
    $!this.cableObj.dbref
    RPATH1
    EXTGEO $!index
    DELETE EXTGEO
    $!this.cableObj.dbref
    !rtext = !this.listEndManualAttaRoute.rtext
    !dtext = !this.listEndManualAttaRoute.dtext
    !rtext.removefrom(!index, 1)
    !dtext.removefrom(!index, 1)
    !this.listEndManualAttaRoute.dtext = !dtext
    !this.listEndManualAttaRoute.rtext = !rtext

    --!this.listEndManualAttaRoute.clear(!this.listEndManualAttaRoute.val)
    !this.aidClear('EXISTING')
    !undo.undoable()
  elseif(!toList.eq('FREEROUTE'))then

    !this.freeRoute = object CBLFREEROUTE(!this.cableObj.dbref)
    !this.freeRoute.pick('!!cblCable.freeRoute', !this.edgDescription)

  endif
endmethod

------------------------------------------------------------------------
--
-- Method: prpRouting
--
-- Description: route the cable through PRPs
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .prpRouting()

  -- Warnings
  if !this.listEndPartAttaRoute.count.eq(0) then
    !!alert.message('Pick attachment points for routing')
    return
  endif

  !undo = object UNDOABLE()
  !undo.add()

  !ce = !!ce
  !!ce = !this.cableObj.dbref
  !this.cableManager.unRouteCable(!!ce)


  !prps = ARRAY()
  !m = object MDRBASEMANAGER()
  !rt = object MDRROUTER()

  -- Create Route Points from points in list gadget
  do !i values !this.listEndPartAttaRoute.rtext
    !dbref = object DBREF(!i)
    handle ANY
      !dbref = object DBREF('/' + !i)
    endhandle
    !prps.append(!m.createRoutePoint(!dbref))
  enddo

  !routePointStart = !this.listEndPartAttaRoute.rtext[1].dbref()
  handle ANY
    !routePointStart = object DBREF('/' + !this.listEndPartAttaRoute.rtext[1])
  endhandle
  --!routePoint1 = !this.cableManager.createRoutePoint(!routePointStart)
  --!startPos =  !routePoint1.position()

  !routePointEnd  = !this.listEndPartAttaRoute.rtext[!this.listEndPartAttaRoute.rtext.size()].dbref()
  handle ANY
    !routePointEnd  = object DBREF('/' + !this.listEndPartAttaRoute.rtext[!this.listEndPartAttaRoute.rtext.size()])
  endhandle
  --!routePoint2 = !this.cableManager.createRoutePoint(!routePointEnd)
  --!this.cableManager.setConnectionsGraph(!graph)

  -- Update Cables ROUTND attribute with array of prps
  !rtext = object ARRAY()
  routnd unset
  do !j from 1 to !this.listEndPartAttaRoute.rtext.size()
    !rtextRef = object DBREF(!this.listEndPartAttaRoute.rtext[!j])
    handle ANY
      !rtextRef = object DBREF('/' + !this.listEndPartAttaRoute.rtext[!j])
    endhandle
    !rtext.append(!rtextRef)
    !!ce.routnd[!j] = !rtext[!j]
  enddo

  -- Check if Cableway Zones have been specified and that selected PRPs exist
  -- within those zones.  !zoneArray value is then set to be used later as the scope for routing.
  !zoneArray = ARRAY()
  !rlseZones = ''
  if(!this.listZone3.val.set())then
    do !i from 1 to !this.listZone3.selection().size()
      !zoneArray.append(!this.listZone3.selection()[!i].dbref())
      !rlseZones =  !this.listZone3.selection()[!i].dbref().name & ' ' & !rlseZones
    enddo
    !badPRPs = ''
    do !prp values !prps
      !!ce = !prp.dbelement()
      CWBRAN
      handle any
      elsehandle none
        ZONE
        if !zoneArray.findfirst(!!ce).unset() and !zoneArray.findfirst( /* ).unset() then
          !badPRPs = !badPRPs & !prp.dbelement().flnm & ' '
        endif
      endhandle
    enddo
    !!ce = !this.cableObj.dbref

    if !badPRPs.neq('') then
      !!alert.error('PRPs: ' & !badPRPs & 'do not exist in defined Cableway Zones.')
      !this.zoneCollectRoute3.expanded = TRUE
      return
    endif
  else
    !routeWorld = !!alert.confirm('Are you sure you want to route via any Cableways found in WORLD?  (This could take a long time for large projects).')
    if !routeWorld.boolean() then
      !zoneArray[1] = /*
      !rlseZones = '/*'
    else
      !this.zoneCollectRoute3.expanded = TRUE
      return
    endif
  endif

  if ( !rlseZones.occurs('/*') gt 0 ) then
    rlse all cwbran
	else
		rlse all cwbran for $!rlseZones
	endif

  -- Redraw cable in 3D view
  REM CE ADD CE

  -- Route Cable and set cable CBSTA attribute to 1 (Routed) if successful
  !this.cableManager.routeCable(!this.cableObj.dbref)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle
  cbsta 1

  !this.aidClear('ENTRY')
  !this.aidClear('EXIT')
  !this.aidClear('EXISTING')

  !this.loadData('CABLE')
  !!ce = !ce
  !undo.endundoable()

  -- Return to main Modify Cable Form upon completion
  !this.setTask(|MODIFY|,|CABLE|)
endmethod


------------------------------------------------------------------------
--
-- Method: headTailRoute
--
-- Description: free route specified end of cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .headTailRoute(!mode is STRING)
  !m = object CABLEMANAGER()
  if(!mode.eq(|HEAD|))then
    if !this.cableObj.dbref.staRef.badref() then
      !!alert.error('Head free route is not possible as Cable Start Reference is unset.')
      return
    else
      !m.reconnectCable(!this.cableObj.dbref, true, 'xyz')
    endif
  elseif(!mode.eq(|TAIL|))then
    if !this.cableObj.dbref.endRef.badref() then
      !!alert.error('Tail free route is not possible as Cable End Reference is unset.')
      return
    else
      !m.reconnectCable(!this.cableObj.dbref, false, 'xyz')
    endif
  endif

  if !this.routingCheck() then
    !this.cableObj.dbref.cbsta = 1
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: routingCheck
--
-- Description: Checks if the cable is routed all the way to the head
--              and tail positions of the cable.  Also checks that at
--              least one EXTGEO element exists.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if routed to both cable head and tail positions
--
------------------------------------------------------------------------
define method .routingCheck() is BOOLEAN

  if !this.cableObj.dbref.staRef.badref() and !this.cableObj.dbref.endRef.badref() then
    return FALSE
  endif

  -- Get Head and Tail positions of Cable
  !cableHead = !this.cableObj.staRef.pos.wrt(WORLD)
  !cableTail = !this.cableObj.endRef.pos.wrt(WORLD)

  -- Find RPATH element and its members
  !colRpath = object COLLECTION()
  !colRpath.type('RPATH')
  !colRpath.scope(!this.cableObj.dbref)
  !rPath = !colRpath.results()
  !route = !rPath[1].members

  -- Check that at least one EXTGEO element exists
  !types = !route.evaluate(object block('!route[!evalIndex].type'))
  if !types.findfirst('EXTGEO').unset() then
    return FALSE
  endif

  -- Check that first POINTR (or staRef pos of EXTGEO) matches head position of CABLE
  if !route[1].type.eq('POINTR') then
    if !cableHead.neq(!route[1].pos.wrt(WORLD)) then
      return FALSE
    endif
  elseif !route[1].type.eq('EXTGEO') then
    if !cableHead.neq(!route[1].staRef.pos.wrt(WORLD)) then
      return FALSE
    endif
  endif

  -- Check that last POINTR (or endRef pos of EXTGEO) matches tail position of CABLE
  !routeLast = !route[!route.size()]
  if !routeLast.type.eq('POINTR') then
    if !cableTail.neq(!routeLast.pos.wrt(WORLD)) then
      return FALSE
    endif
  elseif !routeLast.type.eq('EXTGEO') then
    if !cableTail.neq(!routeLast.endRef.pos.wrt(WORLD)) then
      return FALSE
    endif
  endif

  return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method: prpAids
--
-- Description: showing and removing aids for manual routing
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .prpAids(!aid is STRING)

  if(!aid.eq('SHOW'))then

    !prp = !this.listEndPartAttaRoute.rtext[!this.listEndPartAttaRoute.val].dbref()
    !prpName = !this.listEndPartAttaRoute.dtext[!this.listEndPartAttaRoute.val]
    !pos = !prp.pos.wrt(worl)
    !label = 'PRP' & !this.listEndPartAttaRoute.val & ': ' & !prpName

    !this.aidClear('EXISTING')
    aid text number $!this.attaNumber '<$!label>' at $!pos

  elseif(!aid.eq('ALL'))then

    !this.aidClear('EXISTING')
    do !j from 1 to !this.listEndPartAttaRoute.rtext.size()
      !prp = !this.listEndPartAttaRoute.rtext[!j].dbref()
      !prpName = !this.listEndPartAttaRoute.dtext[!j]
      !pos = !prp.pos.wrt(worl)
      !label = 'PRP' & !j & ': ' & !prpName
      aid text number $!this.attaNumber '<$!label>' at $!pos
    enddo

  elseif(!aid.eq('SHOWMANUAL'))then

    !rtext = object ARRAY()
    do !j from 1 to !this.listEndManualAttaRoute.rtext.size()
      !array = !this.listEndManualAttaRoute.rtext[!j].split()
      !rtextRef = !array[1].dbref()
      !rtextRef2 = !array[2].dbref()
      !rtextArray = object ARRAY()
      !rtextArray.append(!rtextRef)
      !rtextArray.append(!rtextRef2)
      handle ANY
        !rtextRef = object DBREF('/' + !this.listEndManualAttaRoute.rtext[!j])
      endhandle
      !rtext.append(!rtextArray)
    enddo
    if(!rtext.empty())then
      return
    endif
    !pos = !rtext[!this.listEndManualAttaRoute.val][1].pos.wrt(worl)
    !pos2 = !rtext[!this.listEndManualAttaRoute.val][2].pos.wrt(worl)
  	
  	!gadgetText = !rtext[!this.listEndManualAttaRoute.val][1].flnn
  	!gadgetText2 = !rtext[!this.listEndManualAttaRoute.val][2].flnn

--    !this.selectedBranch.val = !this.listEndManualAttaRoute.dtext[!this.listEndManualAttaRoute.val]
    if (!this.manualModify.val) then
    	!this.exitManual.val   = !rtext[!this.listEndManualAttaRoute.val][2].flnn
    	!this.entryManual.val  = !rtext[!this.listEndManualAttaRoute.val][1].flnn
    	!this.manualEntryPoint = !rtext[!this.listEndManualAttaRoute.val][1]
  		!this.manualExitPoint  = !rtext[!this.listEndManualAttaRoute.val][2]
    endif
    !this.aidClear('EXISTING')
    !this.aidClear('ENTRYPART')
    aid text number $!this.manualAid '<Entry: $!gadgetText>' at $!pos
  	aid text number $!this.manualAid '<Exit: $!gadgetText2>' at $!pos2
    !this.aidRemoveManual.tag = 'Remove Aids'
    !this.aidRemoveManual.callback = '!this.prpAids(|REMOVE|)'

  elseif(!aid.eq('REMOVE'))then

    !this.aidClear('ENTRY')
    !this.aidClear('EXIT')
    !this.aidClear('EXISTING')
    !this.aidClear('ENTRYPART')
    !this.aidRemoveManual.tag = 'Display Aids'
    !this.aidRemoveManual.callback = '!this.prpAids(|SHOWMANUAL|)'

  endif

endmethod

------------------------------------------------------------------------
--
-- Method: modifyCbl
--
-- Description: modify cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyCbl()

  !!ce = !this.cableObj.dbref
  if(!!ce.type.neq('CABLE'))then
    !!alert.message('Be at a Cable to modify')
    return
  endif
  -- remove any current highlight
  !this.highlight('FALSE')
  -- if core spec data was previously unset then we can check for a spec and apply the new changes
  -- NOTE: this is only done in this case only, if a spec had been set previously then core data must
  -- be altered via the modify core function
--if(!!ce.spref.set())then
  !core = object ARRAY()
  !obj = object MDRLICENCEMANAGER()
	!licenceError= !obj.getLicence('CABLES')
	!error = !obj.lastError()
  if (!licenceError LT 0) then
	--Alert the user of invalid licence/seats
		!!alert.error('$!error')
    return
  else

    -- feed the cable attributes from the form into the cable object
    !this.updateCbl(|MODIFY|)
    -- then (providing there are no errors) we create the cable.
    !this.cableObj.modify()
    -- Warn user if outside diameter is unset/zero on chosen cable spec
    !warning = !this.cableObj.checkOutsideDiameter()
    if !warning.length().neq(0) then
      !!alert.warning(!warning)
    endif

    if(!this.cableObj.dbref.staRef.set())then
      !this.startRefPick.visible = FALSE
      !this.startRefClear.visible = TRUE
    endif
    if(!this.cableObj.dbref.endRef.set())then
      !this.endRefPick.visible = FALSE
      !this.endRefClear.visible = TRUE
    endif
    if(!this.cableObj.dbref.staRef.unset())then
      !this.startRefPick.visible = TRUE
      !this.startRefClear.visible = FALSE
    endif
    if(!this.cableObj.dbref.endRef.unset())then
      !this.endRefPick.visible = TRUE
      !this.endRefClear.visible = FALSE
    endif
    !this.highlightCable('TRUE')
    !this.prevCableSpec = !this.cableObj.spref
    !this.loadData('CABLE')
  endif
  !this.loadData('CABLE')
endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: pick
--
-- Description: picks the element through EDG
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick(!elementType is STRING)

     -- Define EDG Packet
     --!packet                 = object EDGPACKET()
  if(!elementType eq 'START')then
    if(defined(!!pickedStartEqui[1]))then
      !!pickedStartEqui.delete()
    endif
    !packet                 = object EDGPACKET()
    !packet.description     = !this.edgDescription
    !packet.key             = 'collEqui'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action          = '!!pickedStartEqui[1] = !this.return[1].item'
    !packet.elementPick('Identify Equi/Valve/Inst/Pcom/Elconn for Start Ref:')
    !packet.remove          = true
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|START|,|MODIFY|)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'END')then
    if(defined(!!pickedEndEqui[1]))then
      !!pickedEndEqui.delete()
    endif
    !packet                 = object EDGPACKET()
    !packet.description     = !this.edgDescription
    !packet.key             = 'collEqui'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action          = '!!pickedEndEqui[1] = !this.return[1].item'
    !packet.elementPick('Identify Equi/Valve/Inst/Pcom/Elconn for End Ref:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|END|,|MODIFY|)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'CORESTART')then
    if(defined(!!pickedCoreStartEqui[1]))then
      !!pickedCoreStartEqui.delete()
    endif
    !packet                 = object EDGPACKET()
    !packet.description     = !this.edgDescription
    !packet.key             = 'collElconn'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action          = '!!pickedCoreStartEqui[1] = !this.return[1].item'
    !packet.elementPick('Identify Starting Elconn:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.input[3]   = |match('ELCONN', TYPE) eq 1|
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|CORESTART|,||)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'COREEND')then
    if(defined(!!pickedCoreEndEqui[1]))then
      !!pickedCoreEndEqui.delete()
    endif
    !packet                 = object EDGPACKET()
    !packet.description     = !this.edgDescription
    !packet.key             = 'collElconn'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action          = '!!pickedCoreEndEqui[1] = !this.return[1].item'
    !packet.elementPick('Identify Ending Elconn:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.input[3]   = |match('ELCONN', TYPE) eq 1|
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|COREEND|,||)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'EXTGEOSTART')then
    if(defined(!!pickedExtGeoStartAtta[1]))then
      !!pickedExtGeoStartAtta.delete()
    endif
    !packet                 = object EDGPACKET()
    !packet.description     = !this.edgDescription
    !packet.key             = 'collHatta'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action          = '!!pickedExtGeoStartAtta[1] = !this.return[1].item'
    !packet.elementPick('Identify Cableway Branch:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|EXTGEOSTART|,||)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'EXTGEOPART')then
    if(defined(!!pickedExtGeoStartPartAtta[1]))then
      !!pickedExtGeoStartPartAtta.delete()
    endif
    !packet                 = object EDGPACKET()
    --!packet.initialisation  = '!!pickedExtGeoStartPartAtta  = object ARRAY()'
    !packet.description     = !this.edgDescription
    !packet.key             = 'collHatta'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action   = '!!pickedExtGeoStartPartAtta[1] = !this.return[1].item'
    !packet.elementPick('Identify Cableway Branch:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|EXTGEOPART|,||)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'EXTGEOMANUAL')then
    if(defined(!!pickedExtGeoStartManAtta))then
      !!pickedExtGeoStartManAtta.delete()
    endif
    !packet                 = object EDGPACKET()
    --!packet.initialisation  = '!!pickedExtGeoStartPartAtta  = object ARRAY()'
    !packet.description     = !this.edgDescription
    !packet.key             = 'collHatta'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action   = '!!pickedExtGeoStartManAtta = !this.return[1].item'
    !packet.elementPick('Identify Cableway Branch:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|EXTGEOMANUAL|,||)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'EXTGEOEND')then
    if(defined(!!pickedExtGeoEndAtta[1]))then
      !!pickedExtGeoEndAtta.delete()
    endif
    !packet                 = object EDGPACKET()
    !packet.description     = !this.edgDescription
    !packet.key             = 'collHatta'
    -- When the component has been created successfully
    !packet.priority        = 2
    !packet.action          = '!!pickedExtGeoEndAtta[1] = !this.return[1].item'
    !packet.elementPick('Identify Cableway Branch:')
    !packet.remove          = TRUE
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.pickpacket.picks[1].numberofpicks   = 1
    !packet.escape   = ''
    !packet.continue = '!!cblCable.updateName(|EXTGEOEND|,||)'
    !!edgCntrl.add(!packet)
  elseif(!elementType eq 'POINTR')then

    !packet = object EDGPACKET()
    !packet.action      = '!!cblCable.pickedElementPos = !this.return[1].position.wrt(worl)'
    !packet.defineposition('Pick to define position')
    !packet.priority    = 2
    !packet.remove      = TRUE
    !packet.continue  = '!!cblCable.updateName(|POINTR|,||)'
    !!edgCntrl.add(!packet)
  endif
  -- Add to event system
  --!!edgCntrl.add(!packet)
endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method: posControl
--
-- Description: For Position control gadgets
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .posControl(!posContainer is STRING,!posControl is STRING)

 --Initialise Variables
  -------------------- Setup for position control ----------------------
  --Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  --Create new instance of the position control
  !this.$!<posControl>  = object POSITIONCONTROL()
  !this.$!<posControl>.enuFormat()
  --Load ship grid data
  !grid                 = object SHIPGRID()

  --Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then

    do !i indices !grid.xID
      !xGridData[!i][1]   = !grid.xID[!i]
      !xGridData[!i][2]   = !grid.xOffset[!i]
    enddo
    do !i indices !grid.yID
      !yGridData[!i][1]   = !grid.yID[!i]
      !yGridData[!i][2]   = !grid.yOffset[!i]
    enddo
    do !i indices !grid.zID
      !zGridData[!i][1]   = !grid.zID[!i]
      !zGridData[!i][2]   = !grid.zOffset[!i]
    enddo

    --Set grid data
    !this.$!<posControl>.gridData(!xGridData,!yGridData,!zGridData)

    --Initialize as grid control and Specify tags
    --!this.$!<posControl>.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    --Set position column starting
    !this.$!<posControl>.heading('World Position')
  endif

  --Initialise Control

  !this.$!<posControl>.forceXYZ(0,0,0)

  --state is XYZ, then we will assume that all positions using the control
  --are to be displayed using the gridFormat.
  var !coordinate coordinate
  if(!grid.set().and(!coordinate.eq('XYZ'))) then
    !this.$!<posControl>.gridFormat()
  else
    !this.$!<posControl>.enuFormat()
  endif

  if (!posControl.lowcase().eq('poscontrol')) then
     !this.posControl.changeAction('!!cblCable.setLengthAndDirection(|Gadget|)')
  endif

  --Add PMLNet control to PML frame
  !this.$!<posContainer>.control  = !this.$!<posControl>.handle()

endmethod

------------------------------------------------------------------------
--
-- Method: delete
--
-- Description: deletes the cable and other relevant elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .delete(!elementType is STRING)

if(!elementType.eq('CABLE'))then
    handle (2,822)
      !!alert.message('Cable is not currently selected.')
      return
    endhandle
    !enhanCable = ARRAY()
    if(!this.cableObj.dbref.type eq 'CABLE') then
      if(!this.cableObj.dbref.cbsta.eq(1))then
       !del = !!alert.confirm('Association between the routing data will be lost.Do you still want to delete Cable $!this.cableObj.dbref.flnn?')
      else
       !del = !!alert.confirm('Do you really want to delete Cable $!this.cableObj.dbref.flnn?')
      endif
       if(!del eq 'YES')then
         unenhance all from !enhanCable
         -- remove highlighting
         !this.highlight('FALSE')
         -- delete the cable element
         !this.cableObj.deletecbl()
         -- reset the cable object reference
         !this.cableObj.unset()
         !!ce = CE
			   !this.setTask(|CREATE|,|CABLE|)
       else
         unenhance all from !enhanCable
         return
       endif
    else
      !!alert.message('Current element is not a Cable.')
    endif

elseif(!elementType.eq('CORE'))then
  -- get the current core ref from the list
  !selection = !this.listCore.selection()
  !selectionDbref = !selection.dbref()
  !this.cableObj.deleteCore(!selectionDbref)
  !this.loadData('CORE')

elseif(!elementType.eq('EXTGEO'))then

  !this.cableObj.extgeo = !this.cableObj.extgeos[1]
  !this.loadData(|EXTGEO|)
  do !i from 1 to !this.cableObj.extgeos.size()
    if (!this.cableObj.extgeos[!i].eq(!this.cableObj.extgeo)) then
      -- we have the correct core so delete it using the core method
      !delExtGeo = !!alert.confirm('Do you really want to delete ExtGeo $!this.cableObj.extgeos[$!i].flnn?')
      if(!delExtGeo.eq('YES'))then
       !this.cableObj.deleteExtGeo()
      else
        return
      endif
    endif
  enddo
 !!ce = CE
 !this.setTask('MODIFY','ROUTE')

elseif(!elementType.eq('POINTR'))then

  -- get the current core ref from the list
  !selection = !this.listPointr.selection()
  !selectionNumber = !this.listPointr.val
  if !this.listPointr.dtext.set() then
    !this.cableObj.pointr = !this.listPointr.dtext[!selectionNumber].dbref()
    !this.loadData(|POINTRCREATE|)
    do !i from 1 to !this.cableObj.pointrs.size()
      if (!this.cableObj.pointrs[!i].eq(!this.cableObj.pointr)) then
        -- we have the correct core so delete it using the core method
        !delPointr = !!alert.confirm('Do you really want to delete route point $!this.cableObj.pointrs[$!i].flnn?')
        if(!delPointr.eq('YES'))then
         !this.cableObj.deletePointr()
        else
          return
        endif
      endif
    enddo
    axes off

    if !this.pointrcreatemode.val then
      !this.setTask('MODIFY','POINTR')
      !this.setTask('CREATE','POINTR')
    elseif !this.pointrmodifymode.val then
      !this.setTask('MODIFY','POINTR')
    endif
    if !this.listPointr.dtext.unset() then
      !this.pointrPrev.active = FALSE
      !this.pointrNext.active  = FALSE
    else
      !this.pointrPrev.active = TRUE
      !this.pointrNext.active  = TRUE
    endif
    if(!this.listPointr.dtext.size() leq 1)then
      !this.direction.active = false
      !this.lengthCwSeg.active = false
    else
      !this.direction.active = true
      !this.lengthCwSeg.active = true
    endif
    !!ce = !this.cableObj.dbref

  else
   !!alert.message('No Route point to delete')
   return
  endif
endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: dismiss
--
-- Description: dismiss the cable form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dismiss()

  !this.aidClear('ENTRY')
  !this.aidClear('EXIT')
  !this.aidClear('EXISTING')
  !this.aidClear('ENTRYPART')
  unenhance all
  axes off
  !this.highlight('FALSE')
  !this.hide()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: loadData
--
-- Description: loads data for cable and other elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadData(!element is STRING)

  !this.currentElement = !!ce
  !type = !this.currentElement.type
  if(!element eq 'CABLE') then
    !this.cableObj = object CABLE(!this.currentElement)
    !this.highlight('TRUE')
    -- populate gadget values using stored cable object
    if (!!ce.spref.set())then
      !this.specDesc.val    = !this.cableObj.spref.own.desc
      !this.specChoose.val  = !this.cableObj.spref.namn
      !this.specCore.val    = !this.getNumberOfCores(!this.cableObj.spref)
      handle ANY
        !this.specCore.val    = ''
      endhandle
      !this.specOutDia.val = !this.cableObj.spref.propre.attribute('OUTD').string()
      handle any
        !this.specOutDia.val = 'Unset'
      endhandle
    else
      !this.specChoose.val  = ''
      !this.specDesc.val    = ''
      !this.specCore.val    = ''
      !this.specOutDia.val  = ''
    endif

    !this.cableIclass.val = !!ce.iclass
    !this.elementName.val = !!ce.flnn

    if(!!ce.staRef.badref() and !!ce.endRef.badref()) then
      !this.cableStartRefData.val = ''
      !this.cableEndRefData.val   = ''
      !this.startRefPick.visible  = TRUE
      !this.startRefClear.visible = FALSE
      !this.endRefPick.visible    = TRUE
      !this.endRefClear.visible   = FALSE
    elseif (!!ce.staRef.badref().not() and !!ce.endRef.badref()) then
      !this.cableStartRefData.val = !!ce.staRef.flnn
      !this.cableStartRefDesc.val = !!ce.staRef.desc
      !this.cableEndRefData.val   = ''
      !this.cableEndRefDesc.val   = ''
      !this.startRefPick.visible  = FALSE
      !this.startRefClear.visible = TRUE
      !this.endRefPick.visible    = TRUE
      !this.endRefClear.visible   = FALSE
    elseif (!!ce.staRef.badref() and !!ce.endRef.badref().not()) then
      !this.cableStartRefData.val = ''
      !this.cableStartRefDesc.val = ''
      !this.cableEndRefData.val   = !!ce.endRef.flnn
      !this.cableEndRefDesc.val   = !!ce.endRef.desc
      !this.startRefPick.visible  = TRUE
      !this.startRefClear.visible = FALSE
      !this.endRefPick.visible    = FALSE
      !this.endRefClear.visible   = TRUE
    else
      !this.cableStartRefData.val = !!ce.staRef.flnn
      !this.cableEndRefData.val   = !!ce.endRef.flnn
      !this.cableStartRefDesc.val = !!ce.staRef.desc
      handle (2,201)
      endhandle
      !this.cableEndRefDesc.val   = !!ce.endRef.desc
      handle (2,201)
      endhandle
      !this.startRefPick.visible  = FALSE
      !this.startRefClear.visible = TRUE
      !this.endRefPick.visible    = FALSE
      !this.endRefClear.visible   = TRUE
    endif
    !this.cableDesc.val           = !!ce.description
    !this.cableFunc.val           = !!ce.function
    !this.cablePurp.val           = !!ce.purpose
    !this.fillChk.select('rtext',!!ce.filchk.string())
    !this.systemReference.select('rtext',!!ce.mdsysf[1].name)
    handle (2,759)
      !this.systemReference.clearselection()
    elsehandle (61,567)
      !this.systemReference.add(!!ce.mdsysf[1].descri, !!ce.mdsysf[1].name)
      !this.systemReference.select('rtext',!!ce.mdsysf[1].name)
    endhandle

    !this.cexes1.val              = !!ce.cexes[1]
    !this.cexes2.val              = !!ce.cexes[2]
    !this.cexes3.val              = !!ce.cexes[3]
    !this.cexes4.val              = !!ce.cexes[4]

    !cableTotLength                = !!ce.cbtole.nint()
    handle ANY
      !cableTotLength = 0
    endhandle
    !this.cableLength.val          = !cableTotLength.string(!!distanceFmt)
    !cableFreeLengths              = !!ce.cbfrle
    handle ANY
      !cableFreeLengths= object ARRAY()
      !cableFreeLengths[1] = 0
      !cableFreeLengths[2] = 0
    endhandle
    !this.cableFreeLength.val      = !cableFreeLengths.last().nint().string(!!distanceFmt)
    !this.cableFreeLengthStart.val = !cableFreeLengths[1].nint().string(!!distanceFmt)
    !this.cableFreeLengthEnd.val   = !cableFreeLengths[!cableFreeLengths.size() - 1].nint().string(!!distanceFmt)
    !this.cableProximity.val       = !!ce.raneq

    -- Setup cable routing status gadgets
    if(!!ce.cbsta.eq(0))then
      !routingDesc = 'Un-routed'
    elseif(!!ce.cbsta.eq(1))then
      !routingDesc = 'Routed'
    elseif(!!ce.cbsta.eq(2))then
      !routingDesc = 'Routing Failed'
    elseif(!!ce.cbsta.eq(3))then
      !routingDesc = 'Partially Routed'
    elseif(!!ce.cbsta.eq(4))then
      !routingDesc = 'Partially Failed'
    elseif(!!ce.cbsta.eq(5))then
      !routingDesc = 'Manually Routed'
    else
      !routingDesc = 'Unknown Status'
    endif
    !this.cableCbsta.val          = !!ce.cbsta.string() + ' ( ' + !routingDesc + ' )'
    !dtext = !this.modifyRoutingStatus.dtext.to(6)
    if (!!ce.cbsta.leq(5).and(!!ce.cbsta.geq(0))) then
      !this.modifyRoutingStatus.dtext = !dtext
      !this.modifyRoutingStatus.val = !this.currentElement.cbsta + 1
    else
      -- Add extra option if CBStatus is set to an unknown value
      !dtext.append(!!ce.cbsta.string() + ' ( Unknown Status )')
      !this.modifyRoutingStatus.dtext = !dtext
      !this.modifyRoutingStatus.val = !dtext.size()
    endif
    -- Only make Modify Routing Status active if the cable has a valid rpath
    !this.modifyRoutingStatus.active = FALSE
    do !member values !!ce.members
      if !member.type.eq('RPATH').and(!member.members.set()) then
        !this.modifyRoutingStatus.active = TRUE
        break
      endif
    enddo

    !colPointr = object COLLECTION()
    !colPointr.type('POINTR')
    !colPointr.scope(!this.currentElement)
    !res     = !colPointr.results()
    if(!res.unset())then
      --!this.cableObj.dbref.cexes[1] = 0
      --!this.cexes1.val = 0
      --!this.cableObj.dbref.cexes[4] = 0
      --!this.cexes4.val = 0
      !this.modifyExtGeo.active = FALSE
      return
    else
      !this.modifyExtGeo.active = TRUE
    endif
    !this.ceName.visible = TRUE
    !this.ceAuto.visible = FALSE

    -- Fold up the zone list panels
    !this.zoneCollectRoute.expanded    = FALSE
    !this.zoneCollectRoute2.expanded   = FALSE
    !this.zoneCollectRoute3.expanded   = FALSE

  elseif (!element.eq('DELETE')) then

    if(!!ce.spref.set())then
      !this.specCable.val     = !!ce.spref.namn
      if(!!ce.desc eq '')then
        !this.cableSpecDesc.val = 'Unset'
      else
        !this.cableSpecDesc.val = !!ce.desc
      endif
      !cableVolt              = !!ce.spref.prtref.cmpref
      !this.cableVolt.val     = !cableVolt.voltdc.after('( ').before(' )')
      !this.cableSelectedSpco.val = !!ce.spref.namn
      --!this.cableNumOfCore.val = !this.getNumberOfCores(!!ce.spref)
      !this.cableSystemReference.val =   !!ce.mdsysf[1].name
      handle (2,759)
        !this.cableSystemReference.val = 'Unset'
      endhandle
      !cableNumOfCore = !this.getNumberOfCores(!!ce.spref)
      if(!cableNumOfCore.unset())then
        !this.cableNumOfCore.val = ''
      else
        !this.cableNumOfCore.val = !cableNumOfCore
      endif
      !this.cableCoreSize.val  = !!ce.spref.prtref.cmpref.xarea
    else
      !this.specCable.val      = 'Unset'
      if(!!ce.desc eq '')then
        !this.cableSpecDesc.val = 'Unset'
      else
        !this.cableSpecDesc.val = !!ce.desc
      endif
      !this.cableVolt.val      = 'Unset'
      !this.cableNumOfCore.val = 'Unset'
      !this.cableCoreSize.val  = 'Unset'
      !this.cableSelectedSpco.val = 'Unset'
    endif

    if(!this.cableObj.staRef.unset() and !this.cableObj.endRef.unset()) then
      !this.cableStaRef.val = 'Nulref'
      !this.cableEndRef.val = 'Nulref'
    elseif (!this.cableObj.staRef.set() and !this.cableObj.endRef.unset()) then
      !this.cableStaRef.val = !this.cableObj.staRef.flnn
      !this.cableEndRef.val = 'Nulref'
    elseif (!this.cableObj.staRef.unset() and !this.cableObj.endRef.set()) then
      !this.cableStaRef.val = 'Nulref'
      !this.cableEndRef.val = !this.cableObj.endRef.flnn
    else
      !this.cableStaRef.val = !this.cableObj.staRef.flnn
      !this.cableEndRef.val = !this.cableObj.endRef.flnn
    endif

    !this.cableStapt.val = !this.cableObj.staPoint.string()
    !this.cableEndpt.val = !this.cableObj.endPoint.string()

  elseif(!element.eq('CORE'))then

    -- update owning element
    if(!type eq 'CABLE') then
      --update list gadget
      !cores = object ARRAY()
      !cores = !this.cableObj.cores
      !linesArray = object ARRAY()
      !rtextArray = object ARRAY()
      -- loop through the cores array and create the data for each row in the list
      do !i from 1 to !cores.size()
        !lineTtext = object ARRAY()
        !coreName = !cores[!i].name
        !staRef = !cores[!i].staRef.string()
        !endRef = !cores[!i].endRef.string()
        !desc   = !cores[!i].desc.string()
        !lineTtext.append(!coreName)
        !lineTtext.append(!desc)
        !lineTtext.append(!staRef)
        !lineTtext.append(!endRef)
        !linesArray.append(!lineTtext)
        !rtextArray.append(!cores[!i].dbref.string())
      enddo
      !this.listCore.setrows(!linesArray)
      !this.listCore.rtext = !rtextArray
    endif

  elseif(!element.eq('ZONE'))then
    !colResult = ARRAY()
    !colZone = object COLLECTION()
    !colZone.type('ZONE')
    !exp = object EXPRESSION('TYPE OF OWNER eq |SITE|')
    !colZone.filter(!exp)
    !colZoneResults = !colZone.results()
    do !i from 1 to !colZoneResults.size()
      !col = object COLLECTION()
      !col.type('CWAY')
      !col.scope(!colZoneResults[!i])
      !colResults = !col.results()
      if(!colResults.set())then
        !colResult.append(!colZoneResults[!i])
      endif
    enddo
    !linesArray = object ARRAY()
    !rtextArray = object ARRAY()
    !lineTetext = object ARRAY()
    !lineTetext.append('/*')
    !lineTetext.append('World')
    !linesArray.append(!lineTetext)
    !rtextArray.append(!lineTetext[1])
    -- loop through the cores array and create the data for each row in the list
    do !j from 1 to !colResult.size()
      !lineTtext = object ARRAY()
      !zoneName = !colResult[!j].flnn
      !type     = !colResult[!j].type
      !lineTtext.append(!zoneName)
      !lineTtext.append(!type)
      !linesArray.append(!lineTtext)
      !rtextArray.append(!colResult[!j].string())
    enddo
    !this.listZone.val  = ARRAY()
    !this.listZone.setrows(!linesArray)
    !this.listZone.rtext = !rtextArray
    !this.listZone2.val = ARRAY()
    !this.listZone2.setrows(!linesArray)
    !this.listZone2.rtext = !rtextArray
    !this.listZone3.val = ARRAY()
    !this.listZone3.setrows(!linesArray)
    !this.listZone3.rtext = !rtextArray

  elseif(!element.eq('ROUTE'))then

    !colExtGeo = object COLLECTION()
    !colExtGeo.type('EXTGEO')
    !colExtGeo.scope(!!ce)
    !colExtResults = !colExtGeo.results()
    if(!colExtResults.set())then
     !this.formTitle             = 'Modify Route'
    else
     !this.listStartAttaRoute.clear()
     !this.listEndAttaRoute.clear()
    endif
    !collExtGeo = object COLLECTION()
    !collExtGeo.type('EXTGEO')
    if(!!ce.type.eq('EXTGEO'))then
      !collExtGeo.scope(!!ce.owner)
    elseif(!!ce.type.eq('CABLE'))then
      !collExtGeo.scope(!!ce)
    endif
    !collExtGeoResults = !collExtGeo.results()
    !this.cableObj.extgeos = !collExtGeoResults

    if !this.cableObj.dbref.staRef.badref() then
      !this.routePartHeadRouteAuto.active = FALSE
      !this.routePartHeadRoute.active     = FALSE
    else
      !this.routePartHeadRouteAuto.active = TRUE
      !this.routePartHeadRoute.active     = TRUE
    endif
    if !this.cableObj.dbref.endRef.badref() then
      !this.routePartTailRouteAuto.active = FALSE
      !this.routePartTailRoute.active     = FALSE
    else
      !this.routePartTailRouteAuto.active = TRUE
      !this.routePartTailRoute.active     = TRUE
    endif
    if !this.cableObj.dbref.staRef.badref() or !this.cableObj.dbref.endRef.badref() then
      !this.routeHeadTailFree.val         = FALSE
      !this.routeHeadTailFree.active      = FALSE
    else
      !this.routeHeadTailFree.active      = TRUE
    endif

  elseif(!element.eq('ROUTEPRP'))then

    if !!ce.routnd.set() then
      !this.formTitle             = 'Modify Route Through PRPs'

      !linesArray = object ARRAY()
      !rtextArray = object ARRAY()
      -- loop through the routNds and create the data for each row in the list
      do !routeNode values !!ce.routnd
        !lineTtext = object ARRAY()
        !pointrName = !routeNode.flnn
        !lineTtext.append(!pointrName)
        !linesArray.append(!lineTtext)
        !rtextArray.append(!routeNode.string())
      enddo
      !this.listEndPartAttaRoute.setrows(!linesArray)
      !this.listEndPartAttaRoute.rtext = !rtextArray
    else
      !this.listStartPartAttaRoute.clear()
      !this.listEndPartAttaRoute.clear()
    endif
  elseif(!element.eq('MANUAL'))then

    !routePoints = object ARRAY()
    do !points index !this.listStartManualAttaRoute.rtext
      !unusedRoutePoint = !this.listStartManualAttaRoute.rtext[!points].dbref()
      handle ANY
        !routePoints.append(!this.listStartManualAttaRoute.dtext[!points])
      endhandle
    enddo
    do !badrefPoint values !routePoints
      !this.listStartManualAttaRoute.clear(!badrefPoint)
    enddo
    !rtext = object ARRAY()
    !dtext  = object ARRAY()

    !extgeoColl = object COLLECTION()
    !extgeoColl.type('EXTGEO')
    !extgeoColl.scope(!this.cableObj.dbref)
    !extgeos = !extgeoColl.results()
    do !extgeo values !extgeos
      !text = object STRING()
    	!text = !extgeo.staRef.string() & ' ' & !extgeo.endRef.string()
    	!staRef = !extgeo.staRef
    	!bran = CWBRAN of $!staRef
      !dtext.append(!bran.flnn)
    	!rtext.append(!text)
    enddo
	  !!cblCable.manualExitPoint  = object DBREF()
    !!cblCable.manualEntryPoint = object DBREF()
    !this.exitManual.val  = ||
    !this.entryManual.val = ||
    !this.listEndManualAttaRoute.dtext = !dtext
    !this.listEndManualAttaRoute.rtext = !rtext

    if !this.listStartManualAttaRoute.dtext.set() then
      !this.aidRemoveManual.active = TRUE
    else
      !this.aidRemoveManual.active = false
    endif
    !this.manualAppend.val = TRUE
    !this.manualInsertAfter.val = TRUE
    !this.manualModeToggle()

    if !this.cableObj.dbref.staRef.badref() then
      !this.routeManualHeadRouteAuto.active = FALSE
      !this.routeManualHeadRoute.active     = FALSE
    else
      !this.routeManualHeadRouteAuto.active = TRUE
      !this.routeManualHeadRoute.active     = TRUE
    endif
    if !this.cableObj.dbref.endRef.badref() then
      !this.routeManualTailRouteAuto.active = FALSE
      !this.routeManualTailRoute.active     = FALSE
    else
      !this.routeManualTailRouteAuto.active = TRUE
      !this.routeManualTailRoute.active     = TRUE
    endif

  elseif (!element.eq('POINTR')) then

    --update list gadget
    !collPointr = object COLLECTION()
    !collPointr.type('POINTR')
    if(!!ce.type.eq('POINTR'))then
      !collPointr.scope(!!ce.owner)
    elseif(!!ce.type.eq('CABLE'))then
      !collPointr.scope(!!ce)
    endif
    !collPointrResults = !collPointr.results()
    !this.cableObj.pointrs = !collPointrResults
    !linesArray = object ARRAY()
    !rtextArray = object ARRAY()
    -- loop through the cores array and create the data for each row in the list
    do !i from 1 to !this.cableObj.pointrs.size()
      !lineTtext = object ARRAY()
      !pointrName = !this.cableObj.pointrs[!i].flnn
      !lineTtext.append(!pointrName)
      !linesArray.append(!lineTtext)
      !rtextArray.append(!this.cableObj.pointrs[!i].string())
    enddo
    !this.listPointr.setrows(!linesArray)
    !this.listPointr.rtext = !rtextArray

  elseif (!element.eq('POINTRCREATE')) then

     --update list gadget
     !collPointr = object COLLECTION()
     !collPointr.type('POINTR')
     if(!!ce.type.eq('POINTR'))then
       !collPointr.scope(!!ce.owner)
     elseif(!!ce.type.eq('CABLE'))then
       !collPointr.scope(!!ce)
     endif
     !collPointrResults = !collPointr.results()
     !this.cableObj.pointrs = !collPointrResults
     !linesArray = object ARRAY()
     !rtextArray = object ARRAY()
     -- loop through the cores array and create the data for each row in the list
     do !i from 1 to !this.cableObj.pointrs.size()
       !lineTtext = object ARRAY()
       !pointrName = !this.cableObj.pointrs[!i].flnn
       !lineTtext.append(!pointrName)
       !linesArray.append(!lineTtext)
       !rtextArray.append(!this.cableObj.pointrs[!i].string())
     enddo
     !this.listPointr.setrows(!linesArray)
     !this.listPointr.rtext = !rtextArray

  elseif (!element.eq('CORECREATE')) then

    if(!!ce.type.eq('CORE'))then
      --update list gadget
      !cores = object ARRAY()
      !cores = !this.cableObj.cores
      !linesArray = object ARRAY()
      !rtextArray = object ARRAY()
      -- loop through the cores array and create the data for each row in the list
      do !i from 1 to !cores.size()
        !lineTtext = object ARRAY()
        !coreName = !cores[!i].name
        !href = !cores[!i].staRef.string()
        !tref = !cores[!i].endRef.string()
        !lineTtext.append(!coreName)
        !lineTtext.append(!href)
        !lineTtext.append(!tref)
        !linesArray.append(!lineTtext)
        !rtextArray.append(!cores[!i].dbref.string())
      enddo
      !this.listCore.setrows(!linesArray)
      !this.listCore.rtext = !rtextArray
    endif
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: createData
--
-- Description: creates data for cable and other elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createData(!element is STRING)

  if (!element eq 'CABLE') then
    if (undefined(!!cbldflts)) then
    	pml reload form !!cbldflts
  	endif
    !this.elementName.val        = ''
    !this.cableStartRefData.val  = ''
    !this.cableEndRefData.val    = ''
    !this.cableDesc.val          = ''
    !this.cableFunc.val          = ''
    !this.cablePurp.val          = ''
    !this.fillChk.select('rtext',!!cbldflts.cableFillLevelCheck.string())
    !this.cableIclass.val        = ''
    !this.cexes1.val             = !!cbldflts.cexes1.val
    !this.cexes2.val             = !!cbldflts.cexes2.val
    !this.cexes3.val             = !!cbldflts.cexes3.val
    !this.cexes4.val             = !!cbldflts.cexes4.val
    !this.cableCbsta.val         = '0 (Un-routed)'
    !this.cableStartRefDesc.val  = ''
    !this.cableEndRefDesc.val    = ''
    !this.specChoose.val         = ''
    !this.specDesc.val           = ''
    !this.specCore.val           = ''
    !this.specOutDia.val         = ''
    !this.startRefPick.visible   = TRUE
    !this.endRefPick.visible     = TRUE
    !this.startRefClear.visible  = FALSE
    !this.endRefClear.visible    = FALSE
    !this.ceName.visible         = FALSE
    !this.ceAuto.visible         = TRUE
    !this.cableCbstaTag.visible  = TRUE
    !this.cableCbsta.visible     = TRUE
    !this.cableLengthTag.visible = TRUE
    !this.cableLength.visible    = TRUE
    !this.cableFreeLengthTag.visible = TRUE
    !this.cableFreeLength.visible    = TRUE
    !this.cableFreeLengthStart.visible = TRUE
    !this.cableFreeLengthStartTag.visible = TRUE
    !this.cableFreeLengthEnd.visible = TRUE
    !this.cableFreeLengthEndTag.visible = TRUE
    !this.cableCbstaTag.active       = FALSE
    !this.cableCbsta.active          = FALSE
    !this.cableLengthTag.active      = FALSE
    !this.cableLength.active         = FALSE
    !this.cableFreeLengthTag.active  = FALSE
    !this.cableFreeLength.active     = FALSE
    !this.cableFreeLengthStart.active = FALSE
    !this.cableFreeLengthStartTag.active = FALSE
    !this.cableFreeLengthEnd.active  = FALSE
    !this.cableFreeLengthEndTag.active = FALSE
    !this.cableLength.val          = '0'
    !this.cableFreeLength.val      = '0'
    !this.cableFreeLengthStart.val = '0'
    !this.cableFreeLengthEnd.val   = '0'
    !this.cableProximity.val        = !!cbldflts.cableProximity.val
    !this.autoNameCe(|CREATE|)
    !this.highlight('TRUE')

  -- Loading SYSREF from Cabling Defaults
	  !this.systemReference.val = !this.systemReference.rtext.findfirst(!!cbldflts.cablesysrefdefault.name)
	  handle (2,754)
	     !this.systemReference.clearselection()
	  endhandle

  !spec = !!cbldflts.cablespecdefault
  if(!spec.unset())then
    return
  endif
  !collection = object COLLECTION()
  !collection.scope(!spec)
  !collection.type('TABITE')
  !sprefArray  = !collection.results()

  if(!sprefArray.empty().not())then
    !spref  = !sprefArray.first()
    if(defined(!spref) and !spref.badref().not())then
      !this.prevCableSpec = !spref
    endif
  endif

  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: autoNameCe
--
-- Description: Autonaming cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoNameCe(!mode is STRING)
  !undo               = object UNDOABLE()
  !undo.add()
  !undo.description('autoNameCe')

	if(!mode.eq('CREATE'))then
	  !this.elementName.val = !!cblautoname(|CABLE|, !!ce)
	elseif(!mode.eq('MODIFY'))then
	  !this.elementNameMod.val = !!cblautoname(|CABLE|, !this.cableObj.owner)
	endif
	!undo.endundoable()
	undodb
	
endmethod

-----------------------------------------------------------------------
--
-- Method: updateCbl
--
-- Description: updates cable object data
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateCbl(!task is STRING)

  -- assign the name to the object
  !name = '/' & !this.elementName.val
  !this.cableObj.name = !name

  -- build the cexes array
  !cexesArr = ARRAY()
  !cexesArr.append(!this.cexes1.val)
  !cexesArr.append(!this.cexes2.val)
  !cexesArr.append(!this.cexes3.val)
  !cexesArr.append(!this.cexes4.val)
  -- assign the cexes array to the object
  !this.cableObj.cexes = !cexesArr

  -- assign description, function and purpose to the object
  !this.cableObj.desc = !this.cableDesc.val
  !this.cableObj.func = !this.cableFunc.val
  !this.cableObj.purp = !this.cablePurp.val
  !this.cableObj.iclass = !this.cableIclass.val
  !this.cableObj.startDesc = !this.cableStartRefDesc.val
  !this.cableObj.endDesc = !this.cableEndRefDesc.val
  !this.cableObj.raneq   = !this.cableProximity.val
  !this.cableObj.fillChk = !this.fillChk.selection().boolean()
  !this.cableObj.system[1]  = object DBREF( !this.systemReference.selection())
  handle (2,813)
    !this.cableObj.system = object ARRAY()
  endhandle

  -- assign start reference and end reference to the object
  if (!this.cableStartRefData.val.eq('Nulref') or !this.cableStartRefData.val.eq(''))then
    if(!task eq 'MODIFY')then
      staRef unset
    endif
  else
    !this.cableObj.staRef = !this.getStartEndRef('START')
  endif
  handle (2,813)
    -- ref is not set in the gadget just do nothing
  endhandle

  if (!this.cableEndRefData.val.eq('Nulref') or !this.cableEndRefData.val.eq(''))then
    if(!task eq 'MODIFY')then
      endRef unset
    endif
  else
    !this.cableObj.endRef = !this.getStartEndRef('END')
  endif
  handle (2,813)
    -- ref is not set in the gadget just do nothing
  endhandle

  -- assign spref to the object
  if(!this.specChoose.val neq '')then
    if(!this.specChoose.val.substring(1,1) eq '/')then
      !specChosen  = !this.specChoose.val
    else
      !specChosen  = '/' + !this.specChoose.val
    endif
    !specification = !specChosen.dbref()
    if(!specification.set()) then
      !this.cableObj.spref = !specification
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: nameCheck
--
-- Description: Check the correctness of the name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameCheck(!elementType is STRING)

  if(!elementType.eq('CABLE'))then
    --Check name of Element
    !stringLen = !this.elementName.val.length()
    !name                    = !!checkName(!this.elementName.val, 'NEW')
    --Update gadget with name
    if(!name.set()) then
      if (!stringLen.eq(!name.length())) then
        !name = !name
      else
        !name = !name.after('/')
      endif
      !this.elementName.val  = !name
    endif
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: getCe
--
-- Description: get the current element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getCe(!mode is STRING)

  -- turn off any highlight
  if (!this.cableObj.set()) then
    !this.highlight('true')
  endif
  -- re-initialise the form at the current element
  if (!mode.eq('MODIFY')) then
    if(!!ce.type.neq('CABLE'))then
     --navigate to Cable
     CABLE
     handle ANY
       !!alert.error('Not able to navigate to a CABLE from current element')
       return
     endhandle
    endif
    !this.loadData('CABLE')
    !this.loadData('ZONE')
    !this.highlight('TRUE')
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: back
--
-- Description: redisplay the form specified by !mode
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .back(!mode is STRING)

  if (!mode.eq('MODIFY')) then
    axes off
    !this.cableMainTaskPane.visible   = TRUE
    !this.modifyCoresTaskPane.visible  = FALSE
    !this.routeTaskPane.visible = FALSE
    !this.routePrpTaskPane.visible = FALSE
    !this.routeManualTaskPane.visible  = FALSE
    !this.modifyPointrTaskPane.visible = FALSE
    !this.formTitle = 'Modify Cable'
    !!ce = !this.cableObj.dbref
    !this.highlight('FALSE')
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: updateCores()
--
-- Description: update the core elements with the data stored in the forms
--              this will use the core object update method
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCores()

  -- get the current core ref from the list
  !selection = !this.listCore.selection()
  !selectionNumber = !this.listCore.val
  !selectionDbref  = !selection.dbref()
  do !i from 1 to !this.cableObj.cores.size()
    if (!this.cableObj.cores[!i].dbref.eq(!selectionDbref)) then
      -- we have the correct core so update the cable core members
      -- assign start reference and end reference to the object
        if(!this.coreStartRefData.val eq 'Nulref')then
          !!ce = !this.cableObj.cores[!i].dbref
          staRef unset
          !!ce = !this.currentElement
        elseif(!this.coreStartRefData.val neq 'Nulref')then
          if (!this.coreStartRefData.val.substring(1,1).neq('/') and !this.coreStartRefData.val.substring(1,1).neq('=')) then
            !staRef = '/' + !this.coreStartRefData.val
            !this.cableObj.coreHref = !staRef.dbref()
          else
            !staRef = !this.coreStartRefData.val
            !this.cableObj.coreHref = !staRef.dbref()
          endif
         --endif
        endif
        handle (2,813)
          -- ref is not set in the gadget just do nothing
        endhandle
        if (!this.coreEndRefData.val eq 'Nulref') then
          !!ce = !this.cableObj.cores[!i].dbref
          endRef unset
          !!ce = !this.currentElement
        elseif(!this.coreEndRefData.val neq 'Nulref')then
          if (!this.coreEndRefData.val.substring(1,1).neq('/') and !this.coreEndRefData.val.substring(1,1).neq('=')) then
            !endRef = '/' + !this.coreEndRefData.val
            !this.cableObj.coreTref = !endRef.dbref()
          else
            !endRef = !this.coreEndRefData.val
            !this.cableObj.coreTref = !endRef.dbref()
          endif
        endif
    endif
    !this.cableObj.updateCore(!selectionDbref)
    !this.loadData(|CORE|)
    !this.listCore.val = !selectionNumber
  enddo
  !this.setTask(|MODIFY|,|CABLE|)
  !this.setTask(|MODIFY|,|CORE|)

endmethod

------------------------------------------------------------------------
--
-- Method: CoreGadgets()
--
-- Description: populate the core gadgets for the current core
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coreGadgets()

  !colCore = object COLLECTION()
  !colCore.type('CORE')
  !colCore.scope(!this.cableObj.dbref)
  !colCoreResults = !colCore.results()
  if(!colCoreResults.unset())then
    !this.setTask(|MODIFY|,|CABLE|)
    !!alert.message('No Core to modify')
    return
  endif

  !this.loadData('CABLE')
  -- get the current core ref from the list
  !selection = !this.listCore.selection()
  !selectionDbref = !selection.dbref()
  do !i from 1 to !this.cableObj.cores.size()
    if (!this.cableObj.cores[!i].dbref.eq(!selectionDbref)) then
      handle(2,751)
      endhandle
      !this.coreStartRefData.val = !this.cableObj.cores[!i].staRef.string()
      !this.coreEndRefData.val   = !this.cableObj.cores[!i].endRef.string()

      if(!this.cableObj.cores[!i].staRef.unset())then
        !this.coreStartRefData.val = 'Nulref'
      endif
      if(!this.cableObj.cores[!i].endRef.unset())then
        !this.coreEndRefData.val = 'Nulref'
      endif
    endif
  enddo

  if(!this.coreStartRefData.val.unset() or !this.coreStartRefData.val eq '' or !this.coreStartRefData.val eq 'Nulref')then
    !this.startRefPickCore.visible  = TRUE
    !this.startRefClearCore.visible = FALSE
  else
    !this.startRefPickCore.visible  = FALSE
    !this.startRefClearCore.visible = TRUE
  endif
  if(!this.coreEndRefData.val.unset() or !this.coreEndRefData.val eq '' or !this.coreEndRefData.val eq 'Nulref')then
    !this.endRefPickCore.visible  = TRUE
    !this.endRefClearCore.visible = FALSE
  else
    !this.endRefPickCore.visible  = FALSE
    !this.endRefClearCore.visible = TRUE
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: highlightCable
--
-- Description: highlights the start and end point of the cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlightCable(!mode is STRING)

  --aid clear all
  !this.aidClear('ENTRY')
  !this.aidClear('EXIT')
  !this.aidClear('EXISTING')
  !this.aidClear('ENTRYPART')
  if(!mode eq 'FALSE')then
    !this.startAidNum = !!aidNumbers.add('CableStart')
    !this.endAidNum   = !!aidNumbers.add('CableEnd')
    aid clear text $!this.endAidNum
    handle ANY
    endhandle
    aid clear text $!this.startAidNum
    handle ANY
    endhandle
    unenhance all
  endif
  -- this method needs refinement, the enhance colour
  -- needs to be linked to values that are appropriate for the autocolour of the model.
  if !this.startAidNum.unset() then
    !this.startAidNum = !!aidNumbers.add('CableStart')
  else
    !num = !this.startAidNum
    aid clear text $!num
    handle ANY
    endhandle
  endif

  if !this.endAidNum.unset() then
    !this.endAidNum = !!aidNumbers.add('CableEnd')
  else
    !num  = !this.endAidNum
    aid clear text $!num
    handle ANY
    endhandle
  endif

  unenhance all

  -- mode will be TRUE or FALSE dependent upon whether you want to switch on or turn off highlighting
  if !mode.eq('TRUE') then
    if !this.cableStartRefData.val.set() then
      !startEquip = !this.getStartEndRef('START')
      enhance all for $!startEquip colour green
      handle ANY
      endhandle
      if(!startEquip.set())then
        !pos = !startEquip.position.wrt( /* )
        aid text num $!this.startAidNum '<Start>' at $!pos
      endif
    endif

    if !this.cableEndRefData.val.set() then
      !endEquip = !this.getStartEndRef('END')
      enhance all for $!endEquip colour green
      handle ANY
      endhandle
      if(!endEquip.set())then
        !pos = !endEquip.position.wrt( /* )
        aid text num $!this.endAidNum '<End>' at $!pos
      endif
    else
      return
    endif
  else
    --aid clear all
    !this.aidClear('ENTRY')
    !this.aidClear('EXIT')
    !this.aidClear('EXISTING')
    !this.aidClear('ENTRYPART')
    -- do nothing we have already un-enhanced
    unenhance all

  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: highlight
--
-- Description: highlights the start and end point of the cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight(!mode is STRING)

  --aid clear all
  !this.aidClear('ENTRY')
  !this.aidClear('EXIT')
  !this.aidClear('EXISTING')
  !this.aidClear('ENTRYPART')
  if(!mode eq 'FALSE')then
    !this.startAidNum = !!aidNumbers.add('CableStart')
    !this.endAidNum   = !!aidNumbers.add('CableEnd')
    aid clear text $!this.endAidNum
    handle ANY
    endhandle
    aid clear text $!this.startAidNum
    handle ANY
    endhandle
    unenhance all
  endif
  -- this method needs refinement, the enhance colour
  -- needs to be linked to values that are appropriate for the autocolour of the model.
  if !this.startAidNum.unset() then
    !this.startAidNum = !!aidNumbers.add('CableStart')
  else
    !num = !this.startAidNum
    aid clear text $!num
    handle ANY
    endhandle
  endif

  if !this.endAidNum.unset() then
    !this.endAidNum = !!aidNumbers.add('CableEnd')
  else
  !num  = !this.endAidNum
    aid clear text $!num
    handle ANY
    endhandle
  endif

  unenhance all

  -- mode will be TRUE or FALSE dependent upon whether you want to switch on or turn off highlighting
  if !mode.eq('TRUE') then
    if !this.cableObj.staRef.badref().not() then
      enhance all for $!this.cableObj.staRef colour green
      !pos = !this.cableObj.staRef.position.wrt( /* )
      aid text num $!this.startAidNum '<Start>' at $!pos
    endif

    if !this.cableObj.endRef.badref().not() then
      enhance all for $!this.cableObj.endRef colour green
      !pos = !this.cableObj.endRef.position.wrt( /* )
      aid text num $!this.endAidNum '<End>' at $!pos
    endif
  else
    --aid clear all
    !this.aidClear('ENTRY')
    !this.aidClear('EXIT')
    !this.aidClear('EXISTING')
    !this.aidClear('ENTRYPART')
    unenhance all
    -- do nothing we have already un-enhanced
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: findNearestExtgeo()
--
-- Description: finds the nearest attachment points
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findNearestExtgeo(!listGadget is GADGET, !reference is DBREF)

   !nearest = 1000000000
   !counter = 1
   do !findNearest values !listGadget.rtext
     if !reference.badref().not() then
       !startPosition = position of $!reference
       !endPosition   = position of $!findNearest
       var !distanceTo const dist $!startPosition to $!endPosition
       if !distanceTo.real(!!distanceFmt).lt(!nearest) then
         !unusedNearestRef = !findNearest
         !listRef = !counter
         !nearest = !distanceTo.real(!!distanceFmt)
      endif
      !counter = !counter + 1
    endif
  enddo
  if !nearest.neq(1000000000) then
    !listGadget.val   = !listRef
    !callBackOfGadget = !listGadget.callback
    $!callBackOfGadget
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: findNearestAtta()
--
-- Description: finds the nearest attachment points
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findNearestAtta(!cable is DBREF, !element is STRING)

  !rt = object MDRROUTER()
  !m  = object MDRBASEMANAGER()
  if(!cable.staRef.set() and !cable.endRef.set())then
    !start = !cable.staRef.worpos
    !end   = !cable.endRef.worpos
  else
    -- Make sure we have the latest data
    !this.modifyCbl()
    -- Try again
    if(!cable.staRef.set() and !cable.endRef.set())then
      !start = !cable.staRef.worpos
      !end   = !cable.endRef.worpos
    elseif(!cable.staRef.set() and !cable.endRef.unset())then
      -- If only one of staRef or endref is set use it's pos for both ends
      !start = !cable.staRef.worpos
      !end   = !cable.staRef.worpos
    elseif(!cable.staRef.unset() and !cable.endRef.set())then
      !start = !cable.endRef.worpos
      !end   = !cable.endRef.worpos
    else
      -- If cables staRef/endRef is not set then use pos of owning zone
      !start = !cable.owner.worpos
      !end   = !cable.owner.worpos
    endif
  endif

  !ret = ARRAY()
  !a = ARRAY()
  !col = object COLLECTION()
  !col.type('CWBRAN')
  !all = !col.results()
  do !i from 1 to !all.size()
    !a.append(!all[!i].string())
  enddo
  do !b values !a
    !route = !m.createRoute(object DBREF(!b))
    !ret.append(!route)
  enddo
  !routes = !ret

  !rps = !rt.findNearestRoutePointsOnRoutesArray(!m.createRoutePoint(!start), !routes)
  do !i from 1 to !rps.size()
    if(!rps[!i].dbelement().type.neq('POINTR'))then
      !this.nearestStartAtta = !rps[!i].dbelement()
      break
    endif
  enddo

  if !this.nearestStartAtta.set() then
    if !element.eq('ROUTE') then
      if(!this.nearestStartAtta.type eq 'RATTA' or !this.nearestStartAtta.type eq 'RNODE')then
        !!pickedExtGeoStartAtta[1] = !this.nearestStartAtta.own.own
      else
        !!pickedExtGeoStartAtta[1] = !this.nearestStartAtta.own
      endif
      !this.updateName('EXTGEOSTART','')

    elseif !element.eq('ROUTEPRP') then
      if(!this.nearestStartAtta.type eq 'RATTA' or !this.nearestStartAtta.type eq 'RNODE')then
        !!pickedExtGeoStartPartAtta[1] = !this.nearestStartAtta.own.own
      else
        !!pickedExtGeoStartPartAtta[1] = !this.nearestStartAtta.own
      endif
      !this.updateName('EXTGEOPART','')
      return
    endif
  endif

  !rps1 = !rt.findNearestRoutePointsOnRoutesArray(!m.createRoutePoint(!end), !routes)
  do !i from 1 to !rps1.size()
    if(!rps1[!i].dbelement().type.neq('POINTR'))then
      !this.nearestEndAtta = !rps1[!i].dbelement()
      break
    endif
  enddo

  if !this.nearestEndAtta.set() then
   if(!this.nearestEndAtta.type eq 'RATTA' or !this.nearestEndAtta.type eq 'RNODE')then
    !!pickedExtGeoEndAtta[1] = !this.nearestEndAtta.own.own
   else
    !!pickedExtGeoEndAtta[1] = !this.nearestEndAtta.own
   endif
   !this.updateName('EXTGEOEND','')
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: copyPosValues
--
-- Description: copies the values between position gadgets
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPosValues(!first is STRING, !second is STRING)

    if !first.upcase().eq('POINTR') then
      if !second.upcase().eq('PREV') then
        !!ce = !this.cableObj.pointr
        !ce  = !this.cableObj.pointr
        prev POINTR
        handle ANY
          !!alert.error('The current point is the first point. Cannot pick previous point')
          return
        endhandle
        --!!ce = !this.cableObj.pointr
        !newPos = !!ce.pos.wrt(worl)
        !!ce = !ce
        !this.posControl.xyz(!newPos.east, !newPos.north, !newPos.up)
        !!ce = !this.cableObj.dbref
      elseif !second.upcase().eq('NEXT') then
        !!ce = !this.cableObj.pointr
        !ce  = !this.cableObj.pointr
        next POINTR
        handle ANY
          !!alert.error('The current point is the last point. Cannot pick next point')
          return
        endhandle
        !newPos = !!ce.pos.wrt(worl)
        !!ce = !ce
        !this.posControl.xyz(!newPos.east, !newPos.north, !newPos.up)
        !!ce = !this.cableObj.dbref
      endif
      !this.setLengthAndDirection(|Gadget|)
    endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: getNumberOfCores
--
-- Description: Gets the number of cores for a tab-item
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getNumberOfCores(!tabItem is DBREF) is STRING

 !col  = object COLLECTION()
 !col.scope(!tabItem)
 !col.type('TABQUE')
 !number = object STRING()
 do !core values !col.results()
  if !core.tquestion.upcase().occurs('CORE').gt(0) then
    !number = !core.tanswer
    break
  endif
 enddo
 return !number

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: validateDBName
--
-- Description: Gets the number of cores for a tab-item
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     STRING      Start Point or End Point
--  2    R     GADGET      Gadget to be validated
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDBName(!mode is STRING,!gadget is GADGET)

  !referenceString   = !gadget.val.trim()
  !modeString        = !mode.lowcase()
  !ce = !!ce
  if(!gadget.val.trim().upcase() eq 'CE')then
    !reference   = !!ce
    !gadget.val  = !!ce.namn
  elseif(!referenceString.substring(1,1) eq '/')then
    --Specify DBTYPE DESI as elements in the SCHEMATIC database can have the same name
    DBTYPE DESI $!referenceString
    handle ANY
      !!alert.warning('Enter a valid Element name for $!modeString Reference')
      !reference    = object DBREF()
    elsehandle NONE
      !reference    = !!ce.ref
    endhandle
  else
    --Specify DBTYPE DESI as elements in the SCHEMATIC database can have the same name
    DBTYPE DESI /$!referenceString
    handle NONE
      !reference    = !!ce.ref
    elsehandle ANY
      -- This means item must be unnamed (i.e. ELCONN 1 of EQUIPMENT /equi)
      !reference = object DBREF(!referenceString)
      handle NONE
        !reference    = !!ce.ref
      elsehandle ANY
        !!alert.warning('Enter a valid Element name for $!modeString Reference')
        !reference    = object DBREF()
      endhandle
    endhandle
  endif
  !!ce = !ce

  if(!reference.set())then
    !validTypes = object ARRAY()
    !validTypes.append('EQUI')
    !validTypes.append('INST')
    !validTypes.append('VALV')
    !validTypes.append('ELCONN')
    !validTypes.append('PCOM')
    if(!validTypes.findfirst(!reference.type).unset())then
      !!alert.warning('Select only an Equipment/Valve/Instrument/PCOM or ELCONNs for $!<modeString> Reference of cable')
      !reference   = object DBREF()
    endif
    if !this.validateSelectedReference(!reference).not() then
      !reference   = object DBREF()
    endif
  endif

  if(!reference.unset())then
    !gadget.val  = ''
    if(!mode eq 'START')then
      aid clear text $!!cblCable.startAidNum
      handle ANY
      endhandle
    else
      aid clear text $!!cblCable.endAidNum
      handle ANY
      endhandle
    endif
  else
    if(!mode eq 'START')then
      aid clear text $!!cblCable.startAidNum
      handle ANY
      endhandle
      !pos = !reference.position
      aid text num $!!cblCable.startAidNum '<Start>' at $!pos
    else
      aid clear text $!!cblCable.endAidNum
      handle ANY
      endhandle
      !pos = !reference.position
      aid text num $!!cblCable.endAidNum '<End>' at $!pos
    endif
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: validateSelectedReference
--
-- Description: Validate Selected references( Start / End ) for CABLE
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     DBREF       DBREF to be validated
-- Return:
--  1    R     BOOLEAN     Return if the reference is valid or not
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateSelectedReference(!dbref is DBREF) is BOOLEAN
  if(!dbref.unset())then
    return false
  endif
  !ce = !!ce
  !elcxrf  = !dbref.elcxrf
  handle (2,201)
    !!ce = !dbref
    !equi = EQUI
    handle any
      !!ce = !ce
      return false
    endhandle
    !elcxrf = !equi.elcxrf
    !type   = !equi.type
  elsehandle NONE
    !type   = !dbref.type
  endhandle

  !!ce = !ce
  if !elcxrf.set() and !elcxrf.size().gt(0) then
    if !!alert.confirm('Selected $!type is already connected with some other cable. OK to Connect anyway?').eq('YES') then
      return true
    else
      return false
    endif
  else
    return true
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: changeOrder
--
-- Description: Changes the order of the PRP's in the list gadget.
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     DBREF       DBREF to be validated
-- Return:
--  1    R     BOOLEAN     Return if the reference is valid or not
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeOrder(!actionType IS STRING)
  !tmpDtext = object ARRAY()
  !tmpRtext = object ARRAY()
  !listSize = !this.listEndPartAttaRoute.count
  if (!listSize.eq(0)) then
    return
  endif
  !tmpDtext = !this.listEndPartAttaRoute.dtext
  !tmpRtext = !this.listEndPartAttaRoute.rtext
  !currentIdx  = !this.listEndPartAttaRoute.val
  !reference   = !this.listEndPartAttaRoute.dtext[!currentIdx]
  !itemSize    = !this.listEndPartAttaRoute.dtext.size()
  if (!actionType.eq('UP') or !actionType.eq('TOP')) and !currentIdx.eq(1) then
    return
  elseif (!actionType.eq('DOWN') or !actionType.eq('BOTTOM')) and !currentIdx.eq(!itemSize) then
    return
  endif
  if (!actionType.eq('UP')) then
    !destinationIdx = !this.listEndPartAttaRoute.val - 1
  elseif (!actionType.eq('DOWN')) then
    !destinationIdx = !this.listEndPartAttaRoute.val + 1
  elseif (!actionType.eq('TOP')) then
    !destinationIdx = 1
  elseif (!actionType.eq('BOTTOM')) then
    !destinationIdx = !listSize
  endif
  !tmpValue                  = !this.listEndPartAttaRoute.dtext[!destinationIdx]
  !tmpDtext[!destinationIdx] = !this.listEndPartAttaRoute.dtext[!currentIdx ]
  !tmpDtext[!currentIdx]     = !tmpValue
  !tmpValue                  = !this.listEndPartAttaRoute.rtext[!destinationIdx]
  !tmpRtext[!destinationIdx] = !this.listEndPartAttaRoute.rtext[!currentIdx ]
  !tmpRtext[!currentIdx]     = !tmpValue
  !this.listEndPartAttaRoute.clear()
  !this.listEndPartAttaRoute.dtext = !tmpDtext
  !this.listEndPartAttaRoute.rtext = !tmpRtext
  !this.listEndPartAttaRoute.val = !reference
  !this.prpAids(|REMOVE|)
  !this.prpAids(|SHOW|)

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: setRoutingStatus
--
-- Description: Sets the Cable CBStatus attribute when selected from
--              option gadget.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setRoutingStatus()

  -- Get selected routing status value
  !routingStatus = !this.modifyRoutingStatus.dtext[!this.modifyRoutingStatus.val]
  !routingValue = !routingStatus.split()[1].real()

  if !routingValue.eq(!this.currentElement.cbsta) then
    return
  endif

  -- Ask for confirmation before completing action
  !oldRoutingStatus = !this.cableCbsta.val
  !answer = !!alert.confirm('Modify Routing Status (CBStatus) from  $!oldRoutingStatus to $!routingStatus')

  if !answer.eq('YES') then

    !undo = object UNDOABLE()
    !undo.add()

    -- Set CBSta value on cable and update form gadget
    !this.currentElement.cbsta = !routingValue
    !this.cableCbsta.val = !routingStatus

    !ce = !!ce
    !!ce = !this.currentElement
    -- For manually routed cable setting RlSelect to CE shows cable in view as routed, i.e. not dashed line
    if !routingValue.eq(5) then
      RLSE CE
    elseif !routingValue.eq(1) then

      -- Find ZONEs of connected CWBRAN
      !cwbranZone = ''
      do !cbpref values !!ce.cbpref
        !!ce = !cbpref
        CWBRAN
        handle any
        elsehandle none
          ZONE
          if !cwbranZone.match(!!ce.name).eq(0) then
            !cwbranZone = !cwbranZone & !!ce.name & ' '
          endif
        endhandle
      enddo

      !!ce = !this.currentElement
      -- Set RlSelect attribute to zones if found if not setting to CE also shows cable as routed (not dashed line)
      if !cwbranZone.neq('') then
        RLSE ALL CWBRAN FOR $!cwbranZone
      else
        RLSE CE
      endif

    -- For any other routing status setting RlSelect to NULREF shows cable in view as un-routed, i.e. dashed line
    else
      RLSE NULREF
    endif
    !!ce = !ce

    -- Redraw cable in 3D view
    REM CE ADD CE

    !undo.endundoable()

  else
    -- Reset option gadget to current value
    if (!this.currentElement.cbsta.leq(5).and(!this.currentElement.cbsta.geq(0))) then
      !this.modifyRoutingStatus.val = !this.currentElement.cbsta + 1
    else
      !this.modifyRoutingStatus.val = 7
    endif
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: sortPoints
--
-- Description: Correctly orders and names points along a Cableway Branch
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    RW     ARRAY       DBREFs of the points along the Cableway Branch
-- Return:
-- [Data Type] [Description]
--   ARRAY      Contains two arrays that can be used to populate a list gadget
--
------------------------------------------------------------------------
define method .sortPoints(!points is ARRAY) is ARRAY

  -- Put points in the correct order
  !order = object ARRAY()
  !distance = object ARRAY()
  !hatta = object DBREF()
  !tatta = object DBREF()
  do !node values !points
    if (!node.type.eq('HATTA')) then
      !hatta = !node
    elseif (!node.type.eq('TATTA')) then
      !tatta = !node
    else
      !order.append(!node)
      !distance.append(!node.distfh[1])
    endif
  enddo
  !sort = !distance.sortedindices()
  !order.reindex(!sort)
  if !hatta.set() and !tatta.set() then
    !order.insert(1, !hatta)
    !order.append(!tatta)
  endif
  !points = !order

  -- Rename the points and put them in arrays suitable to create a list gadget
  !count = 1
  !counter = 1
  !linesArray = object ARRAY()
  !rtextArray = object ARRAY()
  do !i from 1 to !points.size()
    !lineTtext = object ARRAY()
    !pointName = !points[!i].flnn
    if(!pointName.occurs('TATTA') gt 0)then
      !pointName = !pointName.replace('TATTA 1','Tail')
    elseif(!pointName.occurs('HATTA') gt 0)then
      !pointName = !pointName.replace('HATTA 1','Head')
    elseif(!pointName.occurs('RATTA') gt 0)then
      !pointName = !pointName.replace('RATTA $!count of CONSEQ 1','Route Attachment $!count')
      !count = !count + 1
    elseif(!pointName.occurs('RNODE') gt 0)then
      !pointName = !pointName.replace('RNODE $!counter of RTFEAT 1','Route Node $!counter')
      !counter = !counter + 1
    endif
    !lineTtext.append(!pointName)
    !linesArray.append(!lineTtext)
    !rtextArray.append(!points[!i].string())
  enddo

  -- Return the two arrays that can be used to create a list gadget
  !return = ARRAY()
  !return.append(!linesArray)
  !return.append(!rtextArray)
  return !return

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: .showCblListCables
--
-- Description: Show cblListCables form
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCblListCables(!list is STRING)

  if(undefined(!!cblListCables))then
    pml load form !!cblListCables
  endif

  if !list.eq(|START|) then
    !element = !this.listStartAttaRoute.rtext[!this.listStartAttaRoute.val].dbref()
  elseif !list.eq(|END|) then
    !element = !this.listEndAttaRoute.rtext[!this.listEndAttaRoute.val].dbref()
  elseif !list.eq(|PRPPICK|) then
    !element = !this.listStartPartAttaRoute.rtext[!this.listStartPartAttaRoute.val].dbref()
  elseif !list.eq(|PRPLIST|) then
    !element = !this.listEndPartAttaRoute.rtext[!this.listEndPartAttaRoute.val].dbref()
  endif

  !ce = !!ce
  !!ce = !element
  !!cblListCables.show(!element)
  !!ce = !ce

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: .navigateToZone
--
-- Description: Navigate to selected zone
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigateToZone()

  if !this.cableMainTaskPane.visible then
    !zoneString = !this.listZone.rtext[!this.listZone.pickedfield]
  elseif !this.routeTaskPane.visible then
    !zoneString = !this.listZone2.rtext[!this.listZone2.pickedfield]
  elseif !this.routePrpTaskPane.visible then
    !zoneString = !this.listZone3.rtext[!this.listZone3.pickedfield]
  endif

  !!ce = !zoneString.dbref()
  handle any
  endhandle

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: manualRoute
--
-- Description:
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualRoute()

  !ce = !!ce

  if (!this.entryManual.val.eq(||).or(!this.exitManual.val.eq(||))) then
    !!alert.error(|Please select Entry and Exit Points before continuing.|)
    return
  else
    !ref =  !this.manualExitPoint
    !bran = CWBRAN of $!ref
    !ref2 = !this.manualEntryPoint
    !bran2 = CWBRAN of $!ref2
    if (!bran.neq(!bran2)) then
      !!alert.error(|Chosen Entry and Exit points do not belong to the same Cableway branch.|)
      return
    else
      -- check the fill level on the cable before routing
      if (!this.cableObj.dbref.filchk) then
        !check = !this.manualFillCheck(!ref2, !ref)
        if (!check) then
      	  !string = !this.manualFillError()
      	  !!alert.error('Cable routing failed because of fill level check at the following points;  $!string')
          !!ce = !ce
      	  return
      	endif
    	endif
    	!text = !ref2.string() & | | & !ref.string()
    	!rtext = !this.listEndManualAttaRoute.rtext
    	!dtext = !this.listEndManualAttaRoute.dtext

    	if (!this.manualAppend.val) then
    	  !!ce = !this.cableObj.dbref
    	  RPATH1
    	  handle ANY
    	    NEW RPATH
    	  endhandle
    	  LAST EXTGEO
    	  handle ANY
    	  endhandle
    	  NEW EXTGEO
    	  !extgeo = !!ce
    	  !extgeo.staRef = !ref2
    	  !extgeo.endRef = !ref
    	  if (!this.cableObj.dbref.filchk) then
    	    !check = !this.manualFillCheck(!ref2, !ref)
          if (!check) then
   	      	!string = !this.manualFillError()
    	      !!alert.error('Cable routing failed because of fill level check at the following points;  $!string')
    	      !!ce = !extgeo
    	      DELETE EXTGEO
            !!ce = !ce
    	      return
    	    endif
    	    !!ce = !this.cableObj.dbref
    	  endif
    	  !rtext.append(!text)
    	  !dtext.append(!bran.flnn)
    	  !listPosition = !dtext.size()
    		
    	elseif (!this.manualInsert.val) then
    	  !!ce = !this.cableObj.dbref
    	  RPATH1
    	  handle ANY
    	  NEW RPATH
    	  endhandle
    	  if (!this.manualInsertAfter.val) then
    		  !value = !this.listEndManualAttaRoute.val
    		  EXTGEO $!value
    		  handle ANY
    		  endhandle
    		  NEW EXTGEO
    	  else
    		  !value = !this.listEndManualAttaRoute.val - 1
    		  if (!value.leq(0)) then
    		    RPATH1
    		    FIRST EXTGEO
    		    handle ANY
    		    endhandle
    		    PREV
    		    handle ANY
    		    RPATH1
    		    endhandle
    		    NEW EXTGEO
    		  else
    		    EXTGEO $!value
    		    NEW EXTGEO
    		  endif
    	  endif
    	  !extgeo = !!ce
    	  !extgeo.staRef = !ref2
    	  !extgeo.endRef = !ref
    	  if (!this.cableObj.dbref.filchk) then
          !check = !this.manualFillCheck(!ref2, !ref)
          if (!check) then
            !string = !this.manualFillError()
            !!alert.error('Cable routing failed because of fill level check at the following points;  $!string')
            !!ce = !extgeo
            DELETE EXTGEO
            !!ce = !ce
            return
          endif
          !!ce = !this.cableObj.dbref
        endif
        !listPosition = !value + 1
        !rtext.insert(!listPosition, !text)
        !dtext.insert(!listPosition, !bran.flnn)
      else
        !listPosition = !this.listEndManualAttaRoute.val
        !!ce = !this.cableObj.dbref
        RPATH1
        handle ANY
          !!alert.error('Cannot Modify Segment as cable does not have any EXTGEO elements')
          !!ce = !ce
          return
        endhandle
        EXTGEO $!listPosition
        handle ANY
          !!alert.error('Cannot Modify Segment as cable does not have any EXTGEO elements')
          !!ce = !ce
          return
        endhandle
        !extgeo = !!ce
        !oriRef1 = !extgeo.staRef
        !oriRef2 = !extgeo.endRef
        !extgeo.staRef = !ref2
        !extgeo.endRef = !ref
        if (!this.cableObj.dbref.filchk) then
          !check = !this.manualFillCheck(!ref2, !ref)
          if (!check) then
            !string = !this.manualFillError()
            !!alert.error('Cable routing failed because of fill level check at the following points;  $!string')
            !!ce = !extgeo
            !extgeo.staRef = !oriRef1
            !extgeo.endRef = !oriRef2
            !!ce = !ce
            return
          endif
          !!ce = !this.cableObj.dbref
        endif
        !rtext[!listPosition] = !text
        !dtext[!listPosition] = !bran.flnn
        endif
    endif
  endif
  !this.aidClear('ENTRY')
  !this.aidClear('EXIT')
  !this.aidClear('ENTRYPART')
  !this.listEndManualAttaRoute.dtext = !dtext
  !this.listEndManualAttaRoute.rtext = !rtext
  !!cblCable.manualExitPoint = object DBREF()
  !!cblCable.manualEntryPoint = object DBREF()

  !!ce = !this.cableObj.dbref
  if (!!ce.rlsel.unset()) then
    RLSEL ALL CWBRAN
  endif
  CBSTA 5
  !this.exitManual.val = ||
  !this.entryManual.val = ||

  !this.listEndManualAttaRoute.val = !listPosition
  !this.prpAids(|SHOWMANUAL|)

  !!ce = !ce

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: prpChangeOrder
--
-- Description: Changes the order of the PRP's in the list gadget.
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     DBREF       DBREF to be validated
-- Return:
--  1    R     BOOLEAN     Return if the reference is valid or not
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualAddEntries(!entry is STRING)

  if(!this.listStartManualAttaRoute.count.eq(0))then
    !!alert.message('No attachment point to add')
	  return
  endif

  if (!entry.eq(|ENTRY|)) then
    !this.manualEntryPoint = !this.listStartManualAttaRoute.rtext[!this.listStartManualAttaRoute.val].dbref()
 		!this.entryManual.val = !this.listStartManualAttaRoute.dtext[!this.listStartManualAttaRoute.val]
 		!pos = !this.manualEntryPoint.pos.wrt(worl)
    !this.aidClear('ENTRYPART')
    !this.aidClear('ENTRY')
  	aid text number $!this.manualEntryAid '<New Entry: $!this.entryManual.val>' at $!pos

  elseif (!entry.eq(|EXIT|)) then

    !this.manualExitPoint = !this.listStartManualAttaRoute.rtext[!this.listStartManualAttaRoute.val].dbref()
    !this.exitManual.val = !this.listStartManualAttaRoute.dtext[!this.listStartManualAttaRoute.val]
    !pos = !this.manualExitPoint.pos.wrt(worl)
    !this.aidClear('ENTRYPART')
    !this.aidClear('EXIT')
    aid text number $!this.manualExitAid '<New Exit: $!this.exitManual.val>' at $!pos

  endif

  !this.listEndManualAttaRoute.refresh()

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: manualGetPoints
--
-- Description: Gets the points along a CWBRANCH between specified start
--              and end.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     DBREF       Start point for routing on CWBRANCH
--  2    R     DBREF       End point for routing on CWBRANCH
-- Return:
--  1    R     ARRAY       DBREFs of CWBRANCH points (e.g. HATTAs, TATTAs, RNODEs)
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualGetPoints(!ref1 is DBREF, !ref2 is DBREF) is ARRAY

  !returnArray = object ARRAY()
	!type = !ref1.type	
	if (!type inset(|HATTA| , |TATTA|)) then
		!start = !ref1
	elseif (!type inset(|RNODE| , |RATTA|)) then
	  !start = !ref1
	endif
  !type = !ref2.type
  if (!type inset (|HATTA| , |TATTA|)) then
    !scope = !ref2.owner
    !end = !ref2
  elseif (!type inset (|RNODE| , |RATTA|)) then
  	!scope = CWBRAN of $!ref2
  	!end = !ref2
  endif

 	!coll = object COLLECTION()
  !coll.scope(!scope)
  !coll.addType(|HATTA|)
  !coll.addType(|TATTA|)
  !coll.addType(|RNODE|)
  !coll.addType(|RATTA|)
  !results = !coll.results()
  !flag = FALSE
  !newArray = object ARRAY()
  if (!start.distfh[1].lt(!end.distfh[1])) then
    -- CABLE DIRECTION FROM HEAD TO TAIL
  	!flag = TRUE
  endif
  if (!flag) then
    -- delete all the figures which are smaller then start and larger than the end
  	do !i indices !results
  		if ((!results[!i].distfh[1].geq(!start.distfh[1])) and (!results[!i].distfh[1].leq(!end.distfh[1]))) then
        !newArray.append(!results[!i])
  			skip
  		endif
  	enddo
  else
 	  do !i indices !results
 	    if ((!results[!i].distfh[1].leq(!start.distfh[1])) and (!results[!i].distfh[1].geq(!end.distfh[1]))) then
        !newArray.append(!results[!i])
        skip
      endif
 	  enddo
  endif
  !distance = object ARRAY()
  do !val values !newArray
    !distance.append(!val.distfh[1])
  enddo
  !sort= !distance.sortedindices()
  !newArray.reindex(!sort)
  --This array is head tail direction
 	!returnArray = !newArray
  return !returnArray

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: manualFillCheck
--
-- Description: Fill Check for manual routing
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     DBREF       Start point for routing on CWBRANCH
--  2    R     DBREF       End point for routing on CWBRANCH
-- Return:
--  1    R     BOOLEAN     Returns true if fill level is exceeded
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualFillCheck (!start is DBREF, !end is DBREF) is BOOLEAN

  !list = !this.manualGetPoints(!start, !end)
  !cwbran = CWBRAN of $!start

  !this.fillArray.clear()
  --Iterating thru array and query Fill level for all elements, special case for first and last elements
  do !val values !list
  	--ignore fill checks at this point
  	if (!val.func.eq('OVER')) then
  		skip
  	endif

  	if (!list.first() eq !val) then
    	if (!val.flevel[2].gt(!cwbran.maxfil)) then
    	  !this.fillArray.append(!val)
      endif
  	
  	elseif (!list.last() eq !val) then
    	if (!val.flevel[1].gt(!cwbran.maxfil)) then
    	  !this.fillArray.append(!val)
      endif
  	
  	else
    	if (!val.flevel[1].gt(!cwbran.maxfil) or !val.flevel[2].gt(!cwbran.maxfil)) then
    	  !this.fillArray.append(!val)
      endif
    endif

  enddo
  return !this.fillArray.empty().not()
endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: deleteFreeRoute
--
-- Description: Deletes free routing POINTRs
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteFreeRoute()

  !collPointr = object COLLECTION()
  !collPointr.type('POINTR')
  !collPointr.scope(!this.cableObj.dbref)
  !pointrs = !collPointr.results()

  do !val values !pointrs
  	!!ce = !val
  	DELETE POINTR
  enddo
  !!ce = !this.cableObj.dbref

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: manualModeToggle
--
-- Description: Changes the mode of adding points in Manual Routing
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualModeToggle()

  if (!this.manualAppend.val) then
  	!confirm = object STRING()
  	if ((!this.exitManual.val.neq(||)) or (!this.entryManual.val.neq(||))) then
  		!confirm = !!alert.confirm('Clear the selected Entry/Exit points ?')
  	endif
  	if (!confirm.eq(|YES|)) then
  		!this.exitManual.val = ||
    	!this.entryManual.val = ||
    endif
    !this.manualInsertChoice.visible = FALSE
  	!this.endRefManualPickRoute.tag = 'Create Cable Segment'
    !this.aidClear('EXISTING')
  	
  elseif (!this.manualInsert.val) then
  	!confirm = object STRING()
  	if ((!this.exitManual.val.neq(||)) or (!this.entryManual.val.neq(||))) then
  		!confirm = !!alert.confirm('Clear the selected Entry/Exit points ?')
  	endif
  	if (!confirm.eq(|YES|)) then
  		!this.exitManual.val = ||
    	!this.entryManual.val = ||
    endif
    !this.manualInsertChoice.visible = TRUE
  	!this.endRefManualPickRoute.tag = 'Create Cable Segment'
    !this.aidClear('EXISTING')

  else
  	!confirm = object STRING()
  	if ((!this.exitManual.val.neq(||)) or (!this.entryManual.val.neq(||))) then
  		!confirm = !!alert.confirm('Clear the selected Entry/Exit points ?')
  	endif
  	if (!confirm.eq(|YES|)) then
  		!this.exitManual.val = ||
    	!this.entryManual.val = ||
    endif
  	!this.manualInsertChoice.visible = FALSE
    -- modify mode
  	!this.endRefManualPickRoute.tag = 'Modify Cable Segment'
  	
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getStartEndRef
--
-- Description: Ensures that staRef or endRef is in a DESI database.  This
--              is due to elconns having the same name as the schematic equivalent
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getStartEndRef(!type is STRING) is DBREF

  if !type.eq('START') then
    !refName = !this.cableStartRefData.val.trim()
  elseif !type.eq('END') then
    !refName = !this.cableEndRefData.val.trim()
  endif

  if !refName.eq('') or !refName.upcase().eq('NULREF') then
    !dbref = object DBREF()
    return !dbref
  endif

  !ce = !!ce

  DBTYPE DESI $!refName
  handle NONE
    !dbref = !!ce.ref
  elsehandle ANY
    DBTYPE DESI /$!refName
    handle NONE
      !dbref = !!ce.ref
    elsehandle ANY
      -- This means item must be unnamed (i.e. ELCONN 1 of EQUIPMENT /equi)
      !dbref = object DBREF(!refName)
      handle ANY
        !dbref = object DBREF()
      endhandle
    endhandle
  endhandle

  !!ce = !ce

  return !dbref

endmethod
------------------------------------------------------------------------
--
-- Method: manualFillError
--
-- Description: Changes the mode of adding points in Manual Routing
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualFillError() is STRING
 !string = object STRING()
 do !points indices !this.fillArray
   if !points.eq(1) then
   	 !string = !this.fillArray[!points].flnn
   else	
	   !string = !string + |, | + !this.fillArray[!points].flnn
 	 endif
 enddo
 return !string
endmethod
--End of method definition
