-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:           cblCable.pmlfrm
-- Type:           Form Definition
-- Group:          Cabling Application
--
-- Keyword:        CABLING
-- Module:         design
-- Replaces:
--
-- Author:         Prashant Srivastava
-- Created:        29 Jun 2006
--
-- Description:
-- Cable ,Cable route Branch, Cable core element, free Cable route,
-- Cable estimate length creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actions()                        -                   Set Specifications
--  addToList(STRING)                -                   extgeos connection list details
--  aid(STRING,POSITION)             -
--  aidClear(STRING)                 -                   Clearing of aid
--  autoNameCe(STRING)               -
--  autoRouteCable(DBREF)            -                   route Cable method
--  back(STRING)                     -                   redisplay the form specified by !mode
--  cableMainGadgets(STRING)         -                   Sets the  gadgets required to create / modify cable
--  cblCable()                       -
--  changeOrder()                    -                   Changes the order of the PRP's in the list gadget.
--  checkIClass(DBREF)               BOOLEAN             checkIClass
--  chooseSpec()                     -                   Setup Specifications
--  copyPosValues(STRING,STRING)     -
--  coreGadgets()                    -
--  create(STRING)                   -
--  createData(STRING)               -                   creates data for cable and other elements
--  currentElement()                 -                   Loads the data of current Element to form
--  delete(STRING)                   -                   deletes the cable
--  deleteFreeRoute()                -                   Deletes free routing POINTRs
--  dismiss()                        -                   dismiss the cable form
--  extgeoConnList(STRING)           -                   extgeo connection list details
--  findNearestAtta(DBREF,STRING)    -                   finds the nearest attachment points
--  findNearestExtgeo(GADGET,DBREF)  -
--  getCe(STRING)                    -
--  getElconn(GADGET,STRING)         -
--  getNumberOfCores(DBREF)          STRING              Gets the number of cores for a tab-item
--  getPosFromCntrl(ARRAY)           POSITION            Converts array from position control to position
--  getStartEndRef(STRING)           DBREF               Ensures that staRef or endRef is in a DESI database.  This
--  headTailRoute(STRING)            -                   free route cable in manual routing
--  highlight(STRING)                -                   highlights the start and end point of the cable
--  highlightCable(STRING)           -
--  init()                           -
--  listEqui(STRING)                 -
--  loadData(STRING)                 -                   loads data for cable and other elements
--  manualAddEntries(STRING)         -
--  manualFillCheck (DBREF,DBREF)    BOOLEAN
--  manualFillError()                STRING              Changes the mode of adding points in Manual Routing
--  manualGetPoints(DBREF,DBREF)     ARRAY               Gets the points along a CWBRANCH between specified start
--  manualModeToggle()               -                   Changes the mode of adding points in Manual Routing
--  manualOrAuto()                   -                   to check if the cable is manually or auto routed
--  manualRoute()                    -
--  modifyCbl()                      -                   modify cable
--  modifyPointr()                   -                   create a routing point element and append its data to the list gadget
--  nameCheck(STRING)                -
--  navigateToZone()                 -                   Navigate to selected zone
--  pick(STRING)                     -                   picks the element for routing through EDG
--  pointrAction()                   -
--  pointrGadgets(STRING)            -                   Sets the gadgets required to create
--  posControl(STRING,STRING)        -                   For Position control gadgets
--  prpAids(STRING)                  -
--  prpRouting()                     -
--  routeCable(DBREF)                -                   routeCable method
--  routeGadgets(STRING)             -                   Sets the  gadgets required to route
--  routingCheck()                   BOOLEAN             Checks if the cable is routed all the way to the head
--  setLengthAndDirection(STRING)    -                   Sets Length and direction Gadgets
--  setPointrPositionGadget()        -                   Sets POINTR position Gadgets
--  setRoutingStatus()               -                   Sets the Cable CBStatus attribute when selected from
--  setSpec()                        -                   Set Specifications
--  setTask(STRING,STRING)           -
--  setupSystemReference()           -                   set up System Reference
--  showCblListCables(STRING)        -                   Show cblListCables form
--  sortPoints(ARRAY)                ARRAY               Correctly orders and names points along a Cableway Branch
--  unRouteCable()                   -                   un-route Cable method
--  updateCbl(STRING)                -                   updates cable object data
--  updateCores()                    -                   update the core elements with the data stored in the forms
--  updateName(STRING,STRING)        -                   updates the element and the picked element
--  validateDBName(STRING,GADGET)    -                   Gets the number of cores for a tab-item
--  validateSelectedReference(DBREF) BOOLEAN             Validate Selected references( Start / End ) for CABLE
--

-- Import DLL
import 'PositionControl'
handle ANY
endhandle

setup form !!cblCable dialog dock right
  !this.autoscroll = true
  !this.initcall = |!!cblCable.init()|
  !this.quitcall = |!this.dismiss()|
  --track 'DESICE' callback '!this.initialise()'

  -- create mode task pane
  frame .cableMainTaskPane panel                   anchor l+t     at x0           y0

    paragraph .namingTag                           anchor l+t     at x0.1         ymin      text 'Element Naming'
    line      .tagLine                             anchor l+t     at x0.1         ymax-0.1      Horiz    width 40

    --Element Name and Name Tags
    paragraph .nameTag                             anchor l+t     at x1           ymax0.1   text  'Name:       '
    text      .elementName                         anchor l+t     at xmax+1       ymin      call '!this.nameCheck(|CABLE|)' width 20 is STRING
    button    .ceAuto                              anchor l+t     at xmax         ymin      pixmap call '!this.autoNameCe(|CREATE|)' tooltip 'AutoNaming'
    button    .ceName  linklabel 'CE'              anchor l+t     at xmin         ymin      call '!this.getCe(|MODIFY|)' tooltip 'Current Element'
    paragraph .namesystemReference                 anchor l+t     at x1           ymax0.1   text  'Primary System:'  width 13
    option    .systemReference                     anchor l+t     at xmin.elementName ymin call '' width 22

    --Element basic data
    paragraph .basicDataTag                         anchor l+t     at x0.1        ymax+0.2  text 'Basic Data'
    line .createModeLine1                           anchor l+t     at x0.1        ymax-0.1  horizontal width 40
    text      .cableDesc     'Description:'         anchor l+t     at x1          ymax+0.1  call '' width 24 is STRING
    text      .cableFunc     'Function:   '         anchor l+t     at x1          ymax+0.1  call '' width 24 is STRING
    text      .cablePurp     'Purpose:    '         anchor l+t     at x1          ymax+0.1  call '' width 24 is STRING
    option    .fillChk       'Fill Check: '         anchor l+t     at x1          ymax+0.1  call '' width 22

    paragraph .cexesTag                             anchor l+t     at x1          ymax+0.1  text 'Excess Lengths:    ' width 13
    paragraph .cexesTagHead                         anchor l+t     at xmax        ymin      text  'Head' width 4
    text      .cexes1                               anchor l+t     at xmax+0.7    ymin      call '!!gdgtDatChk(!this.cexes1)'   width 9 is REAL format !!distanceFmt
    text      .cexes2                               anchor l+t     at xmax+0.3    ymin      call '!!gdgtDatChk(!this.cexes2)'   width 9 is REAL format !!distanceFmt
    paragraph .cexesTagTail                         anchor l+t     at xmin.cexesTagHead ymax+0.1  text  'Tail' width 4
    text      .cexes3                               anchor l+t     at xmin.cexes1 ymin      call '!!gdgtDatChk(!this.cexes3)'   width 9 is REAL format !!distanceFmt
    text      .cexes4                               anchor l+t     at xmax+0.3    ymin      call '!!gdgtDatChk(!this.cexes4)'   width 9 is REAL format !!distanceFmt
    paragraph .cableProximityTag                    anchor l+t     at x1          ymax+0.1  text 'Proximity Distance:' width 13 lines 1
    text      .cableProximity                       anchor l+t     at xmax        ymin      call '!!gdgtDatChk(!this.cableProximity)' width 9 is REAL format !!distanceFmt
    paragraph .cableCbstaTag                        anchor l+t     at x1          ymax+0.1  text 'Routing Status:   ' width 13
    paragraph .cableCbsta                           anchor l+t     at xmax        ymin                                width 14 lines 1
    paragraph .cableLengthTag                       anchor l+t     at x1          ymax      text 'Cable Length:     ' width 13
    paragraph .cableLength                          anchor l+t     at xmax        ymin                                width 10 lines 1
    paragraph .cableFreeLengthTag                   anchor l+t     at x1          ymax      text 'Cable Free Length:' width 13
    paragraph .cableFreeLength                      anchor l+t     at xmax        ymin                                width 9 lines 1
    paragraph .cableFreeLengthStartTag              anchor l+t     at xmax+1      ymin      text 'Start:'             width 4
    paragraph .cableFreeLengthStart                 anchor l+t     at xmax        ymin                                width 9 lines 1
    paragraph .cableFreeLengthEndTag                anchor l+t     at xmin.cableFreeLengthStartTag ymax  text 'End:'  width 4
    paragraph .cableFreeLengthEnd                   anchor l+t     at xmax        ymin                                width 9 lines 1

    --Segment Specification
    paragraph .specDataTag                          anchor l+t     at x0.1        ymax      text 'Specification'
    line      .createModeLine2                      anchor l+t     at x0.1        ymax-0.1  horizontal width 40
    button    .specPick  linklabel 'Choose Cable...' anchor l+t    at x1          ymax      call '!this.chooseSpec()' tooltip 'Choose Specifications'
    paragraph .specChooseTag                        anchor l+t     at x1          ymax      text  'Specification:'      width 13
    paragraph .specChoose                           anchor l+t     at xmax-0.1    ymin                                  width 21 lines 1
    paragraph .specDescTag                          anchor l+t     at x1          ymax      text  'Description:'        width 13
    paragraph .specDesc                             anchor l+t     at xmax-0.1    ymin                                  width 21 lines 1
    paragraph .specCoreTag                          anchor l+t     at x1          ymax      text  'No. of Cores:'       width 13
    paragraph .specCore                             anchor l+t     at xmax        ymin                                  width 21 lines 1
    paragraph .specOutDiaTag                        anchor l+t     at x1          ymax      text  'Outside Diameter:'   width 13
    paragraph .specOutDia                           anchor l+t     at xmax        ymin                                  width 21 lines 1
    paragraph .iclassTag                            anchor l+t     at x1          ymax      text  'Interference Class:' width 13
    text      .cableIclass                          anchor l+t     at xmax        ymin                                  width 24 is STRING
    --Cable start and end details
    paragraph .startTag                             anchor l+t     at x0.1        ymax+0.2  text 'Start'
    line      .createModeLine3                      anchor l+t     at x0.1        ymax-0.1  horizontal width 40
    text      .cableStartRefData      'Reference: ' anchor l+t     at x1          ymax+0.1  tagwid 13  call '!this.validateDBName(|START|,!!cblCable.cableStartRefData)' width 17 is STRING
    button    .startRefPick  linklabel 'Pick'       anchor l+t     at xmax+0.2    ymin      call '!this.pick(|START|)' tooltip 'Pick Start Ref' width 8
    button    .startRefClear linklabel 'Disconnect' anchor l+t     at xmin        ymin      call '!this.updateName(|STACLEAR|,|MODIFY|)' tooltip 'Disconnect Staref' width 8
    paragraph .cableStartRefDescTag                 anchor l+t     at x1          ymax      text 'Description:'  width 13
    paragraph .cableStartRefDesc                    anchor l+t     at xmax        ymin      width 21 lines 1
    button    .equiListHead  linklabel 'List Equipment...'  anchor l+t  at xmin-13  ymax    call '!this.listEqui(|HEAD|)' width 13

    paragraph .endTag                               anchor l+t     at x0.1        ymax+0.2  text 'End'
    line .createModeLine4                           anchor l+t     at x0.1        ymax-0.1  horizontal width 40
    text      .cableEndRefData 'Reference: '        anchor l+t     at x1          ymax+0.1  tagwid 13 call '!this.validateDBName(|END|,!!cblCable.cableEndRefData)' width 17 is STRING
    button    .endRefPick  linklabel 'Pick'         anchor l+t     at xmax+0.2    ymin      call '!this.pick(|END|)' tooltip 'Pick End Ref' width 8
    button    .endRefClear linklabel 'Disconnect'   anchor l+t     at xmin        ymin      call '!this.updateName(|ENDCLEAR|,|MODIFY|)' tooltip 'Disconnect Endref' width 8
    paragraph .cableEndRefDescTag                   anchor l+t     at x1          ymax      text 'Description:' width 13
    paragraph .cableEndRefDesc                      anchor l+t     at xmax        ymin      width 21 lines 1
    button    .equiListTail  linklabel 'List Equipment...'  anchor l+t  at xmin-13  ymax    call '!this.listEqui(|TAIL|)' width 13

    paragraph .tasksTag                             anchor l+t     at x0.1        ymax+0.2  text 'Tasks'
    line .createModeLine5                           anchor l+t     at x0.1        ymax-0.1  horizontal width 40
    --Apply
    paragraph .createCreate                         anchor l+t     at x1          ymax       pixmap
    button    .createCableApply  linklabel  'Create Cable'         anchor l+t     at xmax+0.1    ymin     call '!this.create(|CABLE|)' tooltip 'Create Cable'
    paragraph .modifyApply                                         anchor l+t     at x1          ymin     pixmap
    button    .modifyCableApply  linklabel  'Apply Changes'        anchor l+t     at xmax+0.1    ymin     call '!this.modifyCbl()'
    frame     .zoneCollectRoute FoldUpPanel 'Define Auto Routing'  anchor l+t     at x1          ymax+0.5 width 34 heig 6
      button    .modifyZone  linklabel  'Reload Zones / Deselect All'  anchor l+t  at x1         ymax-5   call '!this.loadData(|ZONE|)'
      list      .listZone                                          anchor l+t     at x1          ymax     multi columns width 35 height 10
      !headings = object ARRAY()
      !headings.append('Select Scope for Cable Routing')
      !headings.append('Type')
      !this.listZone.setHeadings(!headings)
      button    .modifyRoute     linklabel  'AutoRoute Cable'      anchor l+t     at x1   ymax     call '!this.manualOrAuto()'
    exit
    button    .modifyPointr     linklabel  'Define Route'          anchor l+t     at x1         ymax+0.1 call '!this.setTask(|MODIFY|,|ROUTE|)'
    button    .modifyPRPRoute   linklabel  'Define Route Through PRPs'  anchor l+t  at xmin     ymax     call '!this.setTask(|MODIFY|,|ROUTEPRP|)'
    button    .modifyManRoute   linklabel  'Manual Route Cable'    anchor l+t     at x1         ymax     callback '!this.setTask(|MODIFY|,|MANUAL|)'
    button    .modifyFreeRoute  linklabel  'Free Route Cable'      anchor l+t     at x1         ymax     call '!this.addToList(|FREEROUTE|)'
    button    .modifyExtGeo     linklabel  'Modify Free Points'    anchor l+t     at x1         ymax     call '!this.setTask(|MODIFY|,|POINTR|)'

    option    .modifyRoutingStatus 'Modify Routing Status:'  tagwid 15 anchor T+L at x1         ymax     call '!this.setRoutingStatus()' width 20

    button    .unRouteCable      linklabel  'UnRoute Cable'        anchor l+t     at x1         ymax     call '!this.unRouteCable()'
    --button    .modifyCores       linklabel  'Modify Cores'         anchor l+t     at x1         ymax     call '!this.setTask(|MODIFY|,|CORE|)'
    button    .deleteCable       linklabel  'Delete Cable'         anchor l+t     at x1         ymax     call '!this.setTask(|MODIFY|,|DELETE|)'

    button    .cableBackToCreate linklabel  'Back to Create Cable' anchor l+t     at xmax-10.1  ymax     call '!this.setTask(|CREATE|,|CABLE|)'
    paragraph .cableBack                                           anchor l+t     at x1         ymin     pixmap

  exit

  -- modify Cores task pane
  frame .modifyCoresTaskPane panel                  anchor l+t     at x0            y0

    --Modify Core
    paragraph .refTagCore                           anchor l+t     at x0            y0             text 'Cores'   width 40
    line      .refLineCore                          anchor l+t     at x0            ymax-0.1       horizontal width 40
    list      .listCore                             anchor l+t     at x1            ymax+0.5       call '!this.coreGadgets()'  single columns width 36 height 6.5
    !headings = object ARRAY()
    !headings.append('Cores')
    !headings.append('Desc')
    !headings.append('Start Ref')
    !headings.append('End Ref')
    !this.listCore.setHeadings(!headings)
    --Core start and end details
    paragraph .startTagCore                              anchor l+t     at x0        ymax+0.5       text 'Core Start'
    line      .coreModeLine                              anchor l+t     at x0        ymax-0.1       horizontal width 40
    text      .coreStartRefData 'Reference: '            anchor l+t     at x1        ymax           tagwid 13 call '' width 10 is STRING
    button    .startRefPickCore  linklabel 'Pick'        anchor l+t     at xmax+0.2  ymin           call '!this.pick(|CORESTART|)' width 8
    button    .startRefClearCore linklabel 'Disconnect'  anchor l+t     at xmin      ymin           call '!this.updateName(|CORESTACLEAR|,||)' width 8

    paragraph .endTagCore                                anchor l+t     at x0        ymax+0.2       text 'Core End'
    line      .coreModeLine2                             anchor l+t     at x0        ymax-0.1       horizontal width 40
    text      .coreEndRefData 'Reference: '              anchor l+t     at x1        ymax           tagwid 13 call '' width 10 is STRING
    button    .endRefPickCore  linklabel 'Pick'          anchor l+t     at xmax+0.2  ymin           call '!this.pick(|COREEND|)' width 8
    button    .endRefClearCore linklabel 'Disconnect'    anchor l+t     at xmin      ymin           call '!this.updateName(|COREENDCLEAR|,||)' width 8

    paragraph .lineUnderListTag                          anchor l+t     at x0        ymax+0.5       text 'Core Tasks'   width 40
    line      .lineUnderList                             anchor l+t     at x0        ymax-0.1       Horiz    width 40
    -- Apply core
    paragraph .coreApply                                 anchor l+t     at x1        ymax           pixmap
    button    .modifyCoresApply  linklabel 'Modify Core' anchor l+t     at xmax+0.1  ymin           call '!this.updateCores()'
    -- delete core
    paragraph .coreDelete                                anchor l+t     at x1        ymax           pixmap
    button    .deleteCore        linklabel 'Delete Core' anchor l+t     at xmax+0.1  ymin           call '!this.delete(|CORE|)'
    -- back button
    button    .coreBackToModify  linklabel 'Back to Modify Cable'  anchor l+t  at xmin  ymax        call '!this.setTask(|BACK|,|CABLE|)'
    paragraph .coreBack                                  anchor l+t     at x1        ymin           pixmap
  exit

  frame .routeTaskPane panel                  anchor l+t                   at x0                     y0

    --Extgeo start and end details
    paragraph .startTagRoute                              anchor l+t     at x0          y0            text 'Cableway Branch Entry'
    line      .routeModeLine                              anchor l+t     at x0          ymax-0.1      horizontal width 40
    button    .startRefPickRoute  linklabel 'Pick Routing Branch'  anchor r+t  at x1    ymax          call '!this.pick(|EXTGEOSTART|)' tooltip 'Connect ExtGeo' width 15
    paragraph .startCwbranch                              anchor l+t     at xmax        ymin          text ''  width 23
    list      .listStartAttaRoute                         anchor l+t     at x1          ymax+0.1      call '!this.extgeoConnList(|STARTCONNROUTE|)'   single columns width 36 height 10
    !startings = object ARRAY()
    !startings.append('Select Entry Points...')
    !this.listStartAttaRoute.setHeadings(!startings)

    paragraph .endTagRoute                                anchor l+t     at x0          ymax+0.5      text 'Cableway Branch Exit'
    line      .routeModeLine2                             anchor l+t     at x0          ymax-0.1      horizontal width 40
    button    .endRefPickRoute    linklabel 'Pick Routing Branch' anchor l+t at x1      ymax          call '!this.pick(|EXTGEOEND|)' tooltip 'Connect ExtGeo' width 15
    paragraph .endCwbranch                                anchor l+t     at xmax        ymin          text ''   width 23
    list      .listEndAttaRoute                           anchor l+t     at x1          ymax+0.1      call '!this.extgeoConnList(|ENDCONNROUTE|)'   single columns width 36 height 10
    !endings = object ARRAY()
    !endings.append('Select Exit Points...')
    !this.listEndAttaRoute.setHeadings(!endings)

    paragraph .cablewayZonesRoute                         anchor l+t     at x0          ymax+0.5      text 'Routing Options'
    line      .routeModeLine3                             anchor l+t     at x0          ymax-0.1      horizontal width 40
    toggle    .routeHeadTailFree                          anchor l+t     at x1          ymax          'Auto Head/Tail Free Route'
    frame   .zoneCollectRoute2 FoldUpPanel 'Define Specific Cableway Zones' anchor l+t at x1  ymax+0.2  width 34 heig 6
      button  .modifyZone2      linklabel  'Reload Zones / Deselect All'    anchor l+t  at x1  ymax-5   call '!this.loadData(|ZONE|)'
      list    .listZone2                                  anchor l+t     at x1          ymax            multi columns width 35 height 10
      !headings = object ARRAY()
      !headings.append('Select Scope for Cable Routing')
      !headings.append('Type')
      !this.listZone2.setHeadings(!headings)
    exit

    paragraph .lineUnderRouteListTag                      anchor l+t   at x0            ymax+0.6      text 'Routing Tasks'
    line      .lineUnderRouteList                         anchor l+t   at x0            ymax-0.1      Horiz    width 40
    paragraph .routeRoute                                            anchor l+t   at x1          ymax       pixmap
    button    .routeRouteAuto  linklabel  'AutoRoute from Entry to Exit Point'  anchor l+t  at xmax+0.1  ymin  call '!this.manualOrAuto()'
    paragraph .routePartHeadRoute                                    anchor l+t   at x1          ymax       pixmap
    button    .routePartHeadRouteAuto  linklabel  'Head Free Route'  anchor l+t   at xmax+0.1    ymin       call '!this.headTailRoute(|HEAD|)'
    paragraph .routePartTailRoute                                    anchor l+t   at x1          ymax       pixmap
    button    .routePartTailRouteAuto  linklabel  'Tail Free Route'  anchor l+t   at xmax+0.1    ymin       call '!this.headTailRoute(|TAIL|)'
    -- back button
    paragraph .routeBack                                             anchor l+t   at x1          ymax       pixmap
    button    .routeBackToModify  linklabel  'Back to Modify Cable'  anchor l+t   at xmax        ymin       call '!this.setTask(|MODIFY|,|CABLE|)'
  exit

  -- Route Through PRPs Task
  frame .routePrpTaskPane panel                            anchor l+t     at x0          y0

    paragraph .startPartTagRoute                              anchor l+t     at x0          ymax       text 'Routing Through PRPs'
    line      .routePartModeLine                              anchor l+t     at x0          ymax-0.1   horizontal width 40
    button    .startRefPartPickRoute  linklabel 'Pick Routing Branch'   anchor r+t  at x1   ymax+0.1   call '!this.pick(|EXTGEOPART|)' tooltip 'Pick Cable Way Branch' width 15
    paragraph .prpCwbranch                                    anchor l+t     at xmax        ymin          text ''  width 23

    -- List of PRPs on selected Branch
    list      .listStartPartAttaRoute                         anchor l+t     at x1          ymax+0.3   call '!this.extgeoConnList(|STARTPARTROUTE|)' single columns width 36 height 10
    !startings = object ARRAY()
    !startings.append('Select Preliminary Route Points from Cwbranch...')
    !this.listStartPartAttaRoute.setHeadings(!startings)

    -- Buttons for adding to PRP list
    button .prpAddAbove    tooltip 'Insert Before Selected PRP'   pixmap anchor r+t   at x15     ymax+0.2  call '!this.addToList(|PRP BEFORE|)'    width 16 height 16
    button .prpAddBelow    tooltip 'Insert After Selected PRP'    pixmap anchor r+t   at xmax+1  ymin      call '!this.addToList(|PRP AFTER|)'     width 16 height 16
    button .prpAddBottom   tooltip 'Add to Bottom of PRP List'    pixmap anchor r+t   at xmax+1  ymin      call '!this.addToList(|PRP BOTTOM|)'    width 16 height 16

    -- Buttons for moving PRPs in list
    button .moveTop    tooltip 'Move to Top'    pixmap anchor r+t   at x1        ymax+1.7   call '!this.changeOrder(|TOP|)'     width 16 height 16
    button .moveUp     tooltip 'Move Up'        pixmap anchor r+t   at xmin      ymax+0.2   call '!this.changeOrder(|UP|)'      width 16 height 16
    button .removePrp  tooltip 'Remove'         pixmap anchor r+t   at xmin      ymax+0.2   call '!this.addToList(|REMOVE|)'    width 16 height 16
    button .moveDown   tooltip 'Move Down'      pixmap anchor r+t   at xmin      ymax+0.2   call '!this.changeOrder(|DOWN|)'    width 16 height 16
    button .moveBottom tooltip 'Move to Bottom' pixmap anchor r+t   at xmin      ymax+0.2   call '!this.changeOrder(|BOTTOM|)'  width 16 height 16

    -- List of PRPs
    list      .listEndPartAttaRoute                    anchor l+t   at xmax+0.5  ymax.prpAddAbove+0.3   call '!this.prpAids(|SHOW|)'   single columns width 33 height 11
    !endings = object ARRAY()
    !endings.append('List of Preliminary Route Points')
    !this.listEndPartAttaRoute.setHeadings(!endings)

    button    .prpLabelAll       linklabel 'Label All PRPs'      anchor l+t  at xmin  ymax+0.1   call '!this.prpAids(|ALL|)' tooltip 'Remove Selected Point'
    button    .aidRemove         linklabel 'Remove All Labels'   anchor l+t  at xmax  ymin       call '!this.prpAids(|REMOVE|)' tooltip 'Remove Aids'

    paragraph .cablewayZonesPartRoute                     anchor l+t     at x0          ymax+0.3      text 'Routing Options'
    line      .routeModeLine4                             anchor l+t     at x0          ymax-0.1      horizontal width 40
    -- Fold-up for selecting specific zones from list
    frame   .zoneCollectRoute3 FoldUpPanel 'Define Specific Cableway Zones' anchor l+t at x1  ymax+0.2  width 34 heig 6
      button  .modifyZone3      linklabel  'Reload Zones / Deselect All'    anchor l+t  at x1  ymax-5   call '!this.loadData(|ZONE|)'
      list    .listZone3                                  anchor l+t     at x1          ymax            multi columns width 35 height 10
      !headings = object ARRAY()
      !headings.append('Select Scope for Cable Routing')
      !headings.append('Type')
      !this.listZone3.setHeadings(!headings)
    exit

    paragraph .lineUnderPartRouteListTag                      anchor l+t   at x0       ymax+0.5     text 'Routing Tasks'
    line      .lineUnderPartRouteList                         anchor l+t   at x0       ymax-0.1     Horiz    width 40
    paragraph .routePartRoute                                 anchor l+t   at x1       ymax         pixmap
    button    .routePartRouteAuto  linklabel  'Route Cable'   anchor l+t  at xmax+0.1  ymin         call '!this.prpRouting()'
    -- back button
    paragraph .routePartBack                                            anchor l+t   at x1        ymax             pixmap
    button    .routePartBackToModify  linklabel  'Back to Modify Cable' anchor l+t   at xmax      ymin             call '!this.setTask(|MODIFY|,|CABLE|)'
  exit

  frame .routeManualTaskPane panel                            anchor l+t     at x0          y0

    --Extgeo start and end details
    paragraph .startManualTagRoute                              anchor l+t     at x0          y0             text 'Cableway Branch Entry/Exit'
    line      .routeManualModeLine                              anchor l+t     at x0          ymax-0.1       horizontal width 40
    button    .startRefManualPickRoute  linklabel 'Pick Routing Branch'  anchor r+t  at x1    ymax+0.1       callback '!this.pick(|EXTGEOMANUAL|)' tooltip 'Pick Cwbran' width 15
    paragraph .startManualCwbranch                              anchor l+t     at xmax        ymin           text ''  width 23
    list      .listStartManualAttaRoute                         anchor l+t     at x1          ymax+0.1       callback '!this.extgeoConnList(|STARTMANUALROUTE|)'   single columns width 36 height 15
    !startings = object ARRAY()
    !startings.append('Select Entry/Exit from Cableway Branch... ')
    !this.listStartManualAttaRoute.setHeadings(!startings)

		paragraph .entryTag                                      anchor l+t   at xmin        ymax       text 'Entry:'        width 5
		paragraph .entryManual																	 anchor l+t   at xmax        ymin       text ''              width 29
		button    .addEntry    linklabel 'Add'                   anchor l+t   at xmax        ymin       callback '!this.manualAddEntries(|ENTRY|)' tooltip 'Add Selected Route Point as an entry' width 2
		paragraph .exitTag                                       anchor l+t   at xmin.entryTag ymax.entryTag	text 'Exit:'   width 5
		paragraph .exitManual 																	 anchor l+t   at xmax        ymin				text ''		           width 29
		button    .addExit    linklabel 'Add'                    anchor l+t   at xmax        ymin       callback '!this.manualAddEntries(|EXIT|) ' tooltip 'Add Selected Route Point as an exit' width 2
		
		frame .levelToggle                                       anchor l+t   at xmin.exitTag ymin.exitTag+0.8     width 37.9
      rtoggle   .manualAppend       'Append'                 anchor l+t 	at xmin+1.5    ymin+0.5   callback '!this.manualModeToggle()'
      rToggle   .manualInsert       'Insert'                 anchor l+t   at xmax+4      ymin       callback '!this.manualModeToggle()'
      rToggle   .manualModify       'Modify'                 anchor l+t   at xmax+4      ymin       callback '!this.manualModeToggle()'
    exit
    paragraph .routeManualRoute                              anchor l+t   at x1          ymax+0.3   pixmap
    button    .endRefManualPickRoute  linklabel 'Create Cable Segment'  anchor l+t  at xmax  ymin   callback '!this.addToList(|ADDMANUAL|)' tooltip 'Route Cable from Entry to Exit' width 14

    frame .manualInsertChoice                                anchor l+t   at xmax        ymax.levelToggle-0.2  width 14
    	rtoggle  .manualInsertAfter  'After'                   anchor l+t   at xmin+1      ymin+0.5   callback ||
    	rtoggle  .manualInsertBefore 'Before'                  anchor l+t   at xmax        ymin       callback ||
    exit

    paragraph .existingManualTagRoute                        anchor l+t     at x0        ymax+0.3   text 'Existing Cable Segments'
    line      .existingManualModeLine                        anchor l+t     at x0        ymax       horizontal width 40
--    paragraph .selection                                     anchor l+t   at xmin.routeManualRoute ymax.routeManualRoute text 'Selected Branch: ' width 12
