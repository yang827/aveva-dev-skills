    paragraph .manualDeleteRoute                                 anchor l+t   at x1      ymax+0.1      pixmap
    button    .manualDeleteRouteAuto linklabel 'Delete Selected Segment'  anchor l+t  at xmax+0.1  ymin  callback '!this.addToList(|REMOVEMANUAL|)' tooltip 'Remove Selected Route Segment' width 16
    button    .aidRemoveManual          linklabel 'Remove Aids'  anchor l+t   at xmax+8  ymin          callback '!this.prpAids(|REMOVE|)' tooltip 'Remove Aids'

    paragraph .lineUnderManualRouteListTag                       anchor l+t   at x0       ymax+0.5      text 'Routing Tasks'   width 40
    line      .lineUnderManualRouteList                          anchor l+t   at x0       ymax          Horiz    width 40
    paragraph .routeManualHeadRoute                              anchor l+t   at x1       ymax          pixmap
    button    .routeManualHeadRouteAuto  linklabel  'Head Free Route'  anchor l+t  at xmax+0.1  ymin    callback '!this.headTailRoute(|HEAD|)'
    paragraph .routeManualTailRoute                              anchor l+t   at x1       ymax          pixmap
    button    .routeManualTailRouteAuto  linklabel  'Tail Free Route'  anchor l+t  at xmax+0.1  ymin    callback '!this.headTailRoute(|TAIL|)'
    paragraph .deleteFreeRoute                                   anchor l+t   at x1       ymax          pixmap
