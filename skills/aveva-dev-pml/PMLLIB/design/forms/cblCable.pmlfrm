    paragraph .cableSelectedSpcoTag            anchor l+t     at x0            ymax        text  'Spref:        '
    paragraph .cableSelectedSpco               anchor l+t     at xmax+1        ymin        width 23 lines 1
    paragraph .cableSystemReferenceTag         anchor l+t     at x0            ymax        text  'System Ref:   '
    paragraph .cableSystemReference            anchor l+t     at xmax+1        ymin        width 23 lines 1
    --Staref and Endref details for deletion
    paragraph .cableStaRefTag                  anchor l+t     at x0            ymax        text  'Start ref:    '
    paragraph .cableStaRef                     anchor l+t     at xmax+1        ymin        width 28 lines 1
    paragraph .cableStaptTag                   anchor l+t     at x0            ymax        text  'Start point:  '
    paragraph .cableStapt                      anchor l+t     at xmax+1        ymin        width 14 lines 1
    paragraph .cableEndRefTag                  anchor l+t     at x0            ymax        text  'End ref:      '
    paragraph .cableEndRef                     anchor l+t     at xmax+1        ymin        width 28 lines 1
    paragraph .cableEndptTag                   anchor l+t     at x0            ymax        text  'End point:    '
