    paragraph .cableVoltTag                    anchor l+t     at x0            ymax        text  'Voltage:      '
    paragraph .cableVolt                       anchor l+t     at xmax+1        ymin        width 18 lines 1
    paragraph .cableNumOfCoreTag               anchor l+t     at x0            ymax        text  'Cores:        '
    paragraph .cableNumOfCore                  anchor l+t     at xmax+1        ymin        width 18 lines 1
    paragraph .cableCoreSizeTag                anchor l+t     at x0            ymax        text  'Size:         '
