      container .netPositionFrame1 PMLNetCONTROL 'NET' dock fill
      button .pointrPos    linklabel 'Pick  Position...' anchor l+t  at x1.3      ymax+3        call '!this.pick(|POINTR|)'
      button .pointrPrev   linklabel 'Copy  Previous' anchor l+t   at x1.3        ymax          call '!this.copyPosValues(|POINTR|,|PREV|)'
      button .pointrNext   linklabel 'Copy  Next'     anchor l+t   at x1.3        ymax          call '!this.copyPosValues(|POINTR|,|NEXT|)'

    exit

    frame .pointrmode 'Mode' anchor l+t at x1 ymax+0.2
       rtoggle .pointrcreatemode |Creation|            anchor l+t     at x1 ymax call |!this.setTask('CREATE','POINTR')|
       path right
       rtoggle .pointrmodifymode |Modification|            anchor l+t     at xmax+7 ymin call |!this.setTask('MODIFY','POINTR')|
    exit

    paragraph .lineUnderPointrListTag                                anchor l+t   at x1           ymax+0.3      text 'Route Point Tasks'   width 40
    line      .lineUnderPointrList                                   anchor l+t   at xmin         ymax-0.1      Horiz    width 40
    -- create route point
    paragraph .pointrCreate                                          anchor l+t   at x1           ymax          pixmap
    button    .createPointr         linklabel  'Create Route Point'  anchor l+t   at xmax         ymin          call '!this.create(|POINTR|)'
    --Apply changes
    paragraph .pointrApply                                           anchor l+t   at x1           ymin          pixmap
    button    .modifyPointrApply      linklabel  'Apply Changes'     anchor l+t   at xmax         ymin          call '!this.modifyPointr()'
    -- back button
    button    .pointrBackToModify     linklabel  'Back to Modify Cable'    anchor l+t  at xmin    ymax          call '!this.setTask(|BACK|,|CABLE|)'
    paragraph .pointrBack                                            anchor l+t     at x1         ymin          pixmap

  exit

  frame .deleteTaskPane panel                  anchor l+t     at x0            y0

    paragraph .namingTagDelete                 anchor l+t     at x0            y0         text 'Element To Delete'
    line      .tagLineDelete                   anchor l+t     at x0            ymax-0.1    Horiz    width 40
    --Showing spec details
    paragraph .specCableTag                    anchor l+t     at x0            ymax+0.2    text  'Specification:'
