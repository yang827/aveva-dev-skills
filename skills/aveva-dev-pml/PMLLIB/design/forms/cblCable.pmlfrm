  -- !!listingEqui.listingEquipTail.clear()
  --elseif(!mode eq 'TAIL')then
  -- !!listingEqui.elconnSelectionApply.visible = false
  -- !!listingEqui.elconnEndSelectApply.visible = true
  -- !!listingEqui.listingEquip.visible = false
