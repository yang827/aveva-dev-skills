   if !formTask eq 'CREATE' then

     !this.createCreate.visible         = TRUE
     !this.createCableApply.visible     = TRUE
     !this.modifyApply.visible          = FALSE
     !this.modifyCableApply.visible     = FALSE
     !this.zoneCollectRoute.visible     = FALSE
     !this.modifyPointr.visible         = FALSE
     !this.modifyPRPRoute.visible       = FALSE
     !this.modifyManRoute.visible       = FALSE
     !this.unRouteCable.visible         = FALSE
     !this.routeManualHeadRoute.visible = FALSE
     !this.routeManualTailRoute.visible = FALSE
     !this.modifyFreeRoute.visible      = FALSE
     !this.deleteCable.visible          = FALSE
     !this.modifyExtGeo.visible         = FALSE
     !this.modifyRoutingStatus.visible  = FALSE
     !this.startRefPick.visible         = TRUE
     !this.startRefClear.visible        = FALSE
     !this.endRefPick.visible           = TRUE
     !this.endRefClear.visible          = FALSE
     !this.cableBackToCreate.visible    = FALSE
     !this.cableBack.visible            = FALSE
     !this.cableCbstaTag.visible        = FALSE
     !this.cableCbsta.visible           = FALSE
     !this.cableLengthTag.visible       = FALSE
     !this.cableLength.visible          = FALSE
     !this.cableFreeLengthTag.visible   = FALSE
     !this.cableFreeLength.visible      = FALSE
     !this.cableFreeLengthStart.visible = FALSE
     !this.cableFreeLengthStartTag.visible = FALSE
     !this.cableFreeLengthEnd.visible   = FALSE
     !this.cableFreeLengthEndTag.visible = FALSE

     !this.ceName.visible               = FALSE

   elseif !formTask eq 'MODIFY' then

     !this.createCreate.visible         = FALSE
     !this.createCableApply.visible     = FALSE
     !this.modifyApply.visible          = TRUE
     !this.modifyCableApply.visible     = TRUE
     !this.modifyPointr.visible         = TRUE
     !this.modifyPRPRoute.visible       = TRUE
     !this.modifyManRoute.visible       = TRUE
     !this.modifyFreeRoute.visible      = TRUE
     !this.unRouteCable.visible         = TRUE
     !this.routeManualHeadRoute.visible = TRUE
     !this.routeManualTailRoute.visible = TRUE
     !this.zoneCollectRoute.visible     = TRUE
     !this.deleteCable.visible          = TRUE
     !this.modifyExtGeo.visible         = TRUE
     !this.modifyRoutingStatus.visible  = TRUE
     !this.startRefPick.visible         = FALSE
     !this.startRefClear.visible        = TRUE
     !this.endRefPick.visible           = FALSE
     !this.endRefClear.visible          = TRUE
     !this.cableBackToCreate.visible    = TRUE
     !this.cableBack.visible            = TRUE
     !this.cableCbstaTag.visible        = TRUE
     !this.cableCbsta.visible           = TRUE
     !this.cableLengthTag.visible       = TRUE
     !this.cableLength.visible          = TRUE
     !this.cableFreeLengthTag.visible   = TRUE
     !this.cableFreeLength.visible      = TRUE
     !this.cableFreeLengthStart.visible = TRUE
     !this.cableFreeLengthStartTag.visible = TRUE
     !this.cableFreeLengthEnd.visible   = TRUE
     !this.cableFreeLengthEndTag.visible = TRUE
     !this.cableCbstaTag.active         = TRUE
     !this.cableCbsta.active            = TRUE
     !this.cableLengthTag.active        = TRUE
     !this.cableLength.active           = TRUE
     !this.cableFreeLengthTag.active    = TRUE
     !this.cableFreeLength.active       = TRUE
     !this.cableFreeLengthStart.active  = TRUE
     !this.cableFreeLengthStartTag.active = TRUE
     !this.cableFreeLengthEnd.active    = TRUE
     !this.cableFreeLengthEndTag.active = TRUE
     !this.ceName.visible               = TRUE

   endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: routeGadgets
--
-- Description: Sets the  gadgets required to route
-- cableway
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .routeGadgets(!formTask is STRING)

    if !formTask eq 'CREATE' then
      !this.routeRoute.visible      = FALSE
      !this.routeRouteAuto.visible  = FALSE

    elseif !formTask eq 'MODIFY' then
      !this.routeRoute.visible      = TRUE
      !this.routeRouteAuto.visible  = TRUE
      !this.modifyPRPRoute.active   = FALSE
    endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: pointrGadgets
--
-- Description: Sets the gadgets required to create
-- POINTR elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pointrGadgets(!formTask is STRING)

    -- clear aids
    !this.aidClear('ENTRY')
    !this.aidClear('EXIT')
    !this.aidClear('EXISTING')
    !this.aidClear('ENTRYPART')
    if !formTask eq 'CREATE' then
      !this.createPointr.visible            = TRUE
      !this.modifyPointrApply.visible       = FALSE
      !this.pointrApply.visible             = FALSE
      !this.pointrCreate.visible            = TRUE
      !this.pointrmode.val  =  1

    elseif !formTask eq 'MODIFY' then
      !this.createPointr.visible            = FALSE
      !this.modifyPointrApply.visible       = TRUE
      !this.pointrApply.visible             = TRUE
      !this.pointrCreate.visible            = FALSE
      !this.pointrmode.val  =  2

   endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: currentElement
--
-- Description: Loads the data of current Element to form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .currentElement()

   --!this.cableObj = object CABLE(!!ce)
    !elemList[1] = 'CABLE'
    !elemList[2] = 'POINTR'
    !elemList[3] = 'EXTGEO'
    !elemList[4] = 'CORE'

    --Check whether the current element type is in elemList
    !type  = !!ce.type
    !exist = !!ce.ownlst.findfirst(CABLE)

    if !exist.set() then
      !!ce = !!ce.ownlst[!exist]
      !this.setTask(|MODIFY|,|CABLE|)
    else
      !!alert.error('This action cannot be performed on the current element')
       return
    endif
endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      chooseSpec
--
-- Description: Setup Specifications
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseSpec()
if !!stChooseData.purpose.neq('CABL') then
  -- reload cable data to global choose data object
  !!stChooseData = !this.tableChooseData
endif

show !!stChoose
!!stChoose.disableLocalEdit()
!!stChoose.bnApply.callback = '!!cblCable.setSpec()'

  if(!this.tableChooseData.getSelTabs().empty()) then
   !!alert.warning('No cable specification available in the project')
   hide !!stChoose
   return
  endif

if(!this.cableObj.spref.set())then
  !chosenSpec = !this.specChoose.val.string()
  !chooseSpec  = !chosenSpec
  --if(!!stChoose.opSelTypes.val.eq(!this.specDesc.val))then
  do !j from 1 to !!stChoose.opSelTables.dtext.size()
    if(!this.cableObj.spref.own.own.name.eq(!!stChoose.opSelTables.dtext[!j]))then
      !!stChoose.opSelTables.val = !j
      break
    endif
  enddo
   !!stChoose.selectedSelTab = object SELECTIONTABLE(!!stChoose.selTables[!!stChoose.opSelTables.val])
   !!stChoose.initSelTypeList()
  do !k from 1 to !!stChoose.opSelTypes.dtext.size()
    if(!this.specDesc.val.eq(!!stChoose.opSelTypes.dtext[!k]))then
      !!stChoose.opSelTypes.val = !k
      break
    endif
  enddo
  !!stChoose.initTable()

  do !i from 1 to !!stChoose.netSelTabItems.getcolumn('Item Name').size()
     if(!chooseSpec.eq(!!stChoose.netSelTabItems.getcolumn('Item Name')[!i]))then
       !!stChoose.netSelTabItems.selectrow(!i)
       break
     endif
  enddo
  !chosenSpec = !this.specChoose.val.string()
else
  !this.actions()
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      actions
--
-- Description: Set Specifications
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actions()

  if(!this.tableChooseData.getSelTabs().empty()) then
   !!alert.warning('No cable specification available in the project')
   hide !!stChoose
   return
  endif
  if(!this.prevCableSpec.set())then
    !prevCableSpecOwner = !this.prevCableSpec.own.own
    !!stChoose.opSelTables.select('dtext',!prevCableSpecOwner.name)
    !!stChoose.actions(!!stChoose.opSelTables,'SELECT')
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      setupSystemReference
--
-- Description: set up System Reference
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupSystemReference()

  !rtext  = object ARRAY()
  !dtext  = object ARRAY()
  !rtext.append('TRUE')
  !rtext.append('FALSE')
  !dtext.append('On')
  !dtext.append('Off')

  !this.fillChk.dtext  = !dtext
  !this.fillChk.rtext  = !rtext

  !!collectSystemReference('ELEC', !dtext, !rtext)

  !dtext2 = object ARRAY()
  !rtext2 = object ARRAY()

  !!collectSystemReference('ALL', !dtext2, !rtext2)

  !dtext2.removeFirst()
  !rtext2.removeFirst()

  !dtext.appendArray(!dtext2)
  !rtext.appendArray(!rtext2)


  !this.systemReference.dtext = !dtext
  !this.systemReference.rtext = !rtext

endmethod

------------------------------------------------------------------------
--
-- Method:      setSpec
--
-- Description: Set Specifications
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpec()

  !spref = !!stChoose.getSelection()
  if !spref.badref().not() then
    !this.prevCableSpec  = !spref
  endif
  if( !this.prevCableSpec.badref().not() ) then
    !this.specChoose.val = !this.prevCableSpec.namn
    !this.specDesc.val   = !!stChoose.opSelTypes.dtext[!!stChoose.opSelTypes.val]
  endif
  !this.specCore.val   = !this.getNumberOfCores(!this.prevCableSpec)
  handle (61,620)
    !this.specCore.val   = 'Unset'
  endhandle
  !this.specOutDia.val = !this.prevCableSpec.propre.attribute('OUTD').string()
  handle any
    !this.specOutDia.val = 'Unset'
  endhandle
  -- check if cable has a DINTER set in cmpref
  !dinter = !this.prevCableSpec.prtref.cmpref.dinter
  handle ANY
    !this.cableIclass.val  = ''
  elsehandle NONE
    !this.cableIclass.val  = !dinter
  endhandle
  !!stChoose.hide()

endmethod

------------------------------------------------------------------------
--
-- Method: getElconn
--
-- Description: list the elconn and populate the gadget
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getElconn(!gadget is GADGET,!action is STRING)
 !unusedGadget = !gadget
 if(!action.eq('HEAD'))then
  !this.cableStartRefData.val = !!liststartelconn.listElconn.dtext[!!liststartelconn.listElconn.val]
 elseif(!action.eq('TAIL'))then
  !this.cableEndRefData.val = !!liststartelconn.listElconn.dtext[!!liststartelconn.listElconn.val]
 endif
endmethod

------------------------------------------------------------------------
--
-- Method: updateName
--
-- Description: updates the element and the picked element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateName(!element is STRING,!mode is STRING)

  !ce = !!ce
  if (!!ce.type eq 'CABLE') then
    !this.cable = !!ce
    !members = !this.cable.members
  else
    !this.cable = !!ce.own
    !members = !this.cable.members
  endif

  if(!element eq 'CWSEG')then
    !cwbran = !!pickedCwSeg[1].owner.owner
    !!ce = !cwbran
    !conseq = object COLLECTION()
    !conseq.scope(!!ce)
    !conseq.type('CONSEQ')
    !conseqPresent = !conseq.results()
    if(!conseqPresent.set())then
      CONSEQ1
    else
      NEW CONSEQ
    endif
    NEW RATTA
    !ratta = !!ce
    !!ce.posRef = $!!pickedCwSeg[1].staRef
    !this.cableMarkRef.val = '$!ratta.namn'
    !!ce = !this.currentElement

  elseif(!element eq 'CWBRAN')then
    !linesArray = object ARRAY()
    !rtextArray = object ARRAY()
    !pickedCwbranchSize = !!pickedCwbran.size()
    -- loop through the cores array and create the data for each row in the list
    do !i from 1 to !pickedCwbranchSize
      !lineTtext = object ARRAY()
      !extgeoName = !!pickedCwbran[!i].name
      !lineTtext.append(!extgeoName)
      !linesArray.append(!lineTtext)
    enddo

  elseif (!element eq 'START')then
    if(undefined(!!pickedStartEqui[1]))then
      !!ce = !ce
      return
    endif
    !pickedStartEquip      = !!pickedStartEqui[1]
    if !this.validateSelectedReference(!pickedStartEquip).not() then
      !!ce = !ce
      return
    endif
    if(!pickedStartEquip.type.eq('ELCONN')) then
      !this.cableStartRefData.val = !pickedStartEquip.flnn
      !this.cableStartRefDesc.val = !pickedStartEquip.desc
    elseif(!pickedStartEquip.owner.type.eq('EQUI')) then
      !col = object COLLECTION()
      !col.type('ELCONN')
      !col.scope(!pickedStartEquip.owner)
      !colResult = !col.results()
      if(!colResult.unset())then
        !this.cableStartRefData.val = !pickedStartEquip.own.flnn
        !this.cableStartRefDesc.val = !pickedStartEquip.own.desc
      elseif(!colResult.size().eq(1))then
        !!alert.message('Cable will connect to the only "elconn" under the Equipment')
        !this.cableStartRefData.val = !colResult[1].flnn
        !this.cableStartRefDesc.val = !colResult[1].desc
      elseif(!colResult.size().gt(1))then
        !elconn = object ARRAY()
        show !!liststartelconn
        do !j from 1 to !colResult.size()
          !elconn.append(!colResult[!j].flnn)
        enddo
        !!liststartelconn.listElconn.dtext = !elconn
        !!liststartelconn.elconnStartSelectApply.visible = TRUE
        !!liststartelconn.elconnEndSelectApply.visible = FALSE
      endif
    elseif(!pickedStartEquip.owner.owner.type.eq('EQUI')) then
      !col = object COLLECTION()
      !col.type('ELCONN')
      !col.scope(!pickedStartEquip.owner.owner)
      !colResult = !col.results()
      if(!colResult.unset())then
        !this.cableStartRefData.val = !pickedStartEquip.own.own.flnn
        !this.cableStartRefDesc.val = !pickedStartEquip.own.own.desc
      elseif(!colResult.size().eq(1))then
        !!alert.message('Cable will connect to the only elconn under the Equipment')
        !this.cableStartRefData.val = !colResult[1].flnn
        !this.cableStartRefDesc.val = !colResult[1].desc
      elseif(!colResult.size().gt(1))then
        !elconn = object ARRAY()
        show !!liststartelconn
        do !j from 1 to !colResult.size()
          !elconn.append(!colResult[!j].flnn)
        enddo
        !!liststartelconn.listElconn.dtext = !elconn
        !!liststartelconn.elconnStartSelectApply.visible = TRUE
        !!liststartelconn.elconnEndSelectApply.visible = FALSE
      endif
    elseif(!pickedStartEquip.type.eq('VALV'))then
      !this.cableStartRefData.val = !pickedStartEquip.flnn
    elseif(!pickedStartEquip.type.eq('PCOM'))then
      !col = object COLLECTION()
      !col.type('PCOM')
      !col.scope(!pickedStartEquip.owner)
      !colResult = !col.results()
      if(!colResult.unset())then
        !!ce = !ce
        !!alert.message('No PCOM to select.')
        return
      elseif(!colResult.size().eq(1))then
        !!alert.message('Cable will connect to the only pcom present.')
        !this.cableStartRefData.val = !colResult[1].flnn
      elseif(!colResult.size().gt(1))then
        !pcom = object ARRAY()
        show !!liststartelconn
        do !j from 1 to !colResult.size()
          !pcoms = object ARRAY()
          !pcom.append(!colResult[!j].flnn)
        enddo
        !!liststartelconn.listElconn.dtext = !pcom
        !!liststartelconn.formTitle = 'List of PCOMs'
        !!liststartelconn.elconnStartSelectApply.visible = TRUE
        !!liststartelconn.elconnEndSelectApply.visible = FALSE
      endif
    elseif(!pickedStartEquip.type.eq('ELFITT'))then
      !this.cableStartRefData.val = !pickedStartEquip.flnn
    elseif(!pickedStartEquip.type.eq('INST'))then
      !this.cableStartRefData.val = !pickedStartEquip.flnn
    elseif(!pickedStartEquip.owner.type.eq('TMPL'))then
      if(!pickedStartEquip.own.own.type.eq('SUBE'))then
        !this.cableStartRefData.val = !pickedStartEquip.own.own.own.flnn
        !this.cableStartRefDesc.val = !pickedStartEquip.own.own.own.desc
      else
        !this.cableStartRefData.val = !pickedStartEquip.own.own.flnn
        !this.cableStartRefDesc.val = !pickedStartEquip.own.own.desc
      endif
    elseif(!pickedStartEquip.owner.type.eq('SUBE'))then
      !this.cableStartRefData.val = !pickedStartEquip.own.own.flnn
      !this.cableStartRefDesc.val = !pickedStartEquip.own.own.desc
    else
      !!alert.message('Select only an Equipment/Valve/Instrument/PCOM for Start Reference of cable')
    endif
    !this.cableObj.staRef = !this.getStartEndRef('START')
    !this.highlightCable('TRUE')
    !this.startRefPick.visible = TRUE
    !this.startRefClear.visible = FALSE

  elseif (!element eq 'END')then

    if(undefined(!!pickedEndEqui[1]))then
      !!ce = !ce
      return
    endif
    !pickedEndEquip      = !!pickedEndEqui[1]
    if !this.validateSelectedReference(!pickedEndEquip).not() then
      !!ce = !ce
      return
    endif
    if(!pickedEndEquip.type.eq('ELCONN'))then
      !this.cableEndRefData.val = !pickedEndEquip.flnn
      !this.cableEndRefDesc.val = !pickedEndEquip.desc
    elseif(!pickedEndEquip.owner.type.eq('EQUI'))then
      !col = object COLLECTION()
      !col.type('ELCONN')
      !col.scope(!pickedEndEquip.owner)
      !colResult = !col.results()
      if(!colResult.unset())then
        !this.cableEndRefData.val = !pickedEndEquip.own.flnn
        !this.cableEndRefDesc.val = !pickedEndEquip.own.desc
      elseif(!colResult.size().eq(1))then
       !!alert.message('Cable will connect to the only elconn under the Equipment')
        !this.cableEndRefData.val = !colResult[1].flnn
        !this.cableEndRefDesc.val = !colResult[1].desc
      elseif(!colResult.size().gt(1))then
        !elconn = object ARRAY()
        show !!liststartelconn
        do !j from 1 to !colResult.size()
          !elconn.append(!colResult[!j].flnn)
        enddo
        !!liststartelconn.listElconn.dtext = !elconn
        !!liststartelconn.elconnStartSelectApply.visible = FALSE
         !!liststartelconn.elconnEndSelectApply.visible = TRUE
      endif
    elseif(!pickedEndEquip.owner.owner.type.eq('EQUI'))then
      !col = object COLLECTION()
      !col.type('ELCONN')
      !col.scope(!pickedEndEquip.owner.owner)
      !colResult = !col.results()
      if(!colResult.unset())then
        !this.cableEndRefData.val = !pickedEndEquip.own.own.flnn
        !this.cableEndRefDesc.val = !pickedEndEquip.own.own.desc
      elseif(!colResult.size().eq(1))then
       !!alert.message('Cable will connect to the only elconn under the Equipment')
        !this.cableEndRefData.val = !colResult[1].flnn
        !this.cableEndRefDesc.val = !colResult[1].desc
      elseif(!colResult.size().gt(1))then
        !elconn = object ARRAY()
        show !!liststartelconn
        do !j from 1 to !colResult.size()
          !elconn.append(!colResult[!j].flnn)
        enddo
        !!liststartelconn.listElconn.dtext = !elconn
        !!liststartelconn.elconnStartSelectApply.visible = FALSE
        !!liststartelconn.elconnEndSelectApply.visible = TRUE
      endif
    elseif(!pickedEndEquip.type.eq('VALV'))then
      !this.cableEndRefData.val = !pickedEndEquip.flnn
    elseif(!pickedEndEquip.type.eq('PCOM'))then
      !col = object COLLECTION()
      !col.type('PCOM')
      !col.scope(!pickedEndEquip.owner)
      !colResult = !col.results()
      if(!colResult.unset())then
        !!ce = !ce
        !!alert.message('No PCOM to select.')
        return
      elseif(!colResult.size().eq(1))then
        !!alert.message('Cable will connect to the only elconn under the Equipment')
        !this.cableEndRefData.val = !colResult[1].flnn
      elseif(!colResult.size().gt(1))then
        !pcom = object ARRAY()
        show !!liststartelconn
        do !j from 1 to !colResult.size()
          !pcoms = object ARRAY()
          !pcom.append(!colResult[!j].flnn)
        enddo
        !!liststartelconn.listElconn.dtext = !pcom
        !!liststartelconn.formTitle = 'List of PCOMs'
        !!liststartelconn.elconnStartSelectApply.visible = FALSE
        !!liststartelconn.elconnEndSelectApply.visible = TRUE
      endif

    elseif(!pickedEndEquip.type.eq('ELFITT'))then
      !this.cableEndRefData.val = !pickedEndEquip.flnn
    elseif(!pickedEndEquip.type.eq('INST'))then
      !this.cableEndRefData.val = !pickedEndEquip.flnn
    elseif(!pickedEndEquip.owner.type.eq('TMPL'))then
      if(!pickedEndEquip.own.own.type.eq('SUBE'))then
        !this.cableEndRefData.val = !pickedEndEquip.own.own.own.flnn
        !this.cableEndRefDesc.val = !pickedEndEquip.own.own.own.desc
      else
        !this.cableEndRefData.val = !pickedEndEquip.own.own.flnn
        !this.cableEndRefDesc.val = !pickedEndEquip.own.own.desc
      endif
    elseif(!pickedEndEquip.owner.type.eq('SUBE'))then
      !this.cableEndRefData.val = !pickedEndEquip.own.own.flnn
      !this.cableEndRefDesc.val = !pickedEndEquip.own.own.desc
    else
      !!alert.message('Select only an Equipment/Valve/Instrument/PCOM for End Reference of cable')
    endif
    !this.cableObj.endRef = !this.getStartEndRef('END')
    !this.highlightCable('TRUE')
    !this.endRefPick.visible = TRUE
    !this.endRefClear.visible = FALSE

  elseif(!element eq 'STACLEAR') then

    !cableStartRef = !this.cableStartRefData.val
    !this.cableStartRefData.val = 'Nulref'
    if(!this.cableObj.dbref.staRef.unset())then
      !!alert.warning('Cable Start is already disconnected ')
      !this.startRefPick.visible = TRUE
      !this.startRefClear.visible = FALSE
      !!ce = !ce
      return
    endif
    !confirm = !!alert.confirm('Do you really want to disconnect the start of the cable?')
    if (!confirm eq 'YES' and !this.cableStartRefData.val.eq('Nulref'))then
      if(!mode.eq('MODIFY'))then
        !!ce = !this.cableObj.dbref
        staRef unset
        feqdesc unset
      endif
      !this.cableStartRefData.val = 'Nulref'
      !this.cableStartRefDesc.val = ''
      !this.startRefPick.visible = TRUE
      !this.startRefClear.visible = false
      !this.loadData('CABLE')
      !this.startAidNum = !!aidNumbers.add('CableStart')

      aid clear text $!this.startAidNum
      handle ANY
      endhandle
      if (!!ce.cbsta.neq(0)) then
        !this.unRouteCable()
      endif
   else
      !this.cableStartRefData.val = !cableStartRef
      !this.startRefPick.visible = FALSE
      !this.startRefClear.visible = TRUE
      !this.highlightCable('TRUE')
    endif

  elseif(!element eq 'ENDCLEAR') then

    !cableEndRef = !this.cableEndRefData.val
    !this.cableEndRefData.val = 'Nulref'
    if(!this.cableObj.dbref.endRef.unset())then
      !!alert.warning('Cable End is already disconnected ')
      !this.endRefPick.visible = TRUE
      !this.endRefClear.visible = FALSE
      !!ce = !ce
      return
    endif
    !confirm = !!alert.confirm('Do you really want to disconnect the end of the cable?')
    if (!confirm eq 'YES' and !this.cableEndRefData.val.eq('Nulref'))then
      if(!mode.eq('MODIFY'))then
        !!ce = !this.cableObj.dbref
        endRef unset
        teqdesc unset
      endif
      !this.cableEndRefData.val = 'Nulref'
      !this.cableEndRefDesc.val = ''
      !this.endRefPick.visible = TRUE
      !this.endRefClear.visible = false
      !this.loadData('CABLE')
      !this.endAidNum = !!aidNumbers.add('CableEnd')
      aid clear text $!this.endAidNum
      handle ANY
      endhandle
      if (!!ce.cbsta.neq(0)) then
        !this.unRouteCable()
      endif
    else
      !this.cableEndRefData.val = !cableEndRef
      !this.endRefPick.visible = FALSE
      !this.endRefClear.visible = TRUE
      !this.highlightCable('TRUE')
    endif

  elseif(!element eq 'CORESTART')then

    if(undefined(!!pickedCoreStartEqui[1]))then
      !!ce = !ce
      return
    endif
    !pickedCoreStartEquip      = !!pickedCoreStartEqui[1]
    !this.coreStartRefData.val = !pickedCoreStartEquip.namn
    !this.cableObj.staRef = !pickedCoreStartEquip
    !this.startRefPickCore.visible = FALSE
    !this.startRefClearCore.visible = TRUE

  elseif(!element eq 'COREEND')then

    if(undefined(!!pickedCoreEndEqui[1]))then
      !!ce = !ce
      return
    endif
    !pickedCoreEndEquip      = !!pickedCoreEndEqui[1]
    !this.coreEndRefData.val = !pickedCoreEndEquip.namn
    !this.cableObj.endRef = !pickedCoreEndEquip
    !this.endRefPickCore.visible = FALSE
    !this.endRefClearCore.visible = TRUE

  elseif(!element eq 'CORESTACLEAR') then

    !this.coreStartRefData.val = 'Nulref'
    !this.highlight('FALSE')
    !this.startRefPickCore.visible = TRUE
    !this.startRefClearCore.visible = FALSE

  elseif(!element eq 'COREENDCLEAR') then

    !this.coreEndRefData.val   = 'Nulref'
    !this.highlight('FALSE')
    !this.endRefPickCore.visible = TRUE
    !this.endRefClearCore.visible = FALSE

  elseif(!element eq 'EXTGEOSTART')then

    -- Check for valid selection of CWBRAN
    if(undefined(!!pickedExtGeoStartAtta[1]))then
      !!ce = !ce
      return
    elseif(!!pickedExtGeoStartAtta[1].type.neq('CWBRAN'))then
      !!ce = !ce
      !!alert.message('Select a Cableway Branch')
      return
    endif

    if ( not !this.checkIClass(!!pickedExtGeoStartAtta[1]) ) then
    		!!ce = !ce
	      return
    endif

    -- Collect all points on selected Branch
    !collRatta = object COLLECTION()
    !collRatta.type('TATTA')
    !collRatta.addType('HATTA')
    !collRatta.addType('RATTA')
    !collRatta.addType('RNODE')
    !collRatta.scope(!!pickedExtGeoStartAtta[1])
    !collRattaResults = !collRatta.results()
    !extgeoStaRef = !collRattaResults
    !this.extgeoStartName = !collRattaResults
    !extgeos = !this.cableObj.extgeoHref

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoStaRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listStartAttaRoute.setrows(!linesArray)
    !this.listStartAttaRoute.rtext = !rtextArray
    !this.startCwbranch.val = !!pickedExtGeoStartAtta[1].flnm
    !this.findNearestExtgeo(!this.listStartAttaRoute,!this.cableObj.staRef)

  elseif(!element eq 'EXTGEOEND')then

    -- Check for valid selection of CWBRAN
    if(undefined(!!pickedExtGeoEndAtta[1]))then
      !!ce = !ce
      return
    elseif(!!pickedExtGeoEndAtta[1].type.neq('CWBRAN'))then
      !!ce = !ce
      !!alert.message('Select a Cableway Branch')
      return
    endif
    if ( not !this.checkIClass(!!pickedExtGeoEndAtta[1]) ) then
    		!!ce = !ce
	      return
    endif

    -- Collect all points on selected Branch
    !collRatta = object COLLECTION()
    !collRatta.type('TATTA')
    !collRatta.addType('HATTA')
    !collRatta.addType('RATTA')
    !collRatta.addType('RNODE')
    !collRatta.scope(!!pickedExtGeoEndAtta[1])
    !collRattaResults = !collRatta.results()
    !extgeoEndRef = !collRattaResults
    !extgeos = !this.cableObj.extgeoTref

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoEndRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listEndAttaRoute.setrows(!linesArray)
    !this.listEndAttaRoute.rtext = !rtextArray
    !this.endCwbranch.val = !!pickedExtGeoEndAtta[1].flnm
    !this.findNearestExtgeo(!this.listEndAttaRoute,!this.cableObj.endRef)

  elseif(!element eq 'EXTGEOPART')then

    -- Check for valid selection of CWBRAN
    if(undefined(!!pickedExtGeoStartPartAtta[1]))then
      !!ce = !ce
      return
    elseif(!!pickedExtGeoStartPartAtta[1].type.neq('CWBRAN'))then
      !!ce = !ce
      !!alert.message('Select a Cableway Branch')
      return
    endif

    if ( not !this.checkIClass(!!pickedExtGeoStartPartAtta[1]) ) then
    		!!ce = !ce
	      return
    endif

		
    -- Collect all points on selected Branch
    !collRatta = object COLLECTION()
    !collRatta.type('TATTA')
    !collRatta.addType('HATTA')
    !collRatta.addType('RATTA')
    !collRatta.addType('RNODE')
    !collRatta.scope(!!pickedExtGeoStartPartAtta[1])
    !collRattaResults = !collRatta.results()
    !extgeoStaRef = !collRattaResults

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoStaRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listStartPartAttaRoute.setrows(!linesArray)
    !this.listStartPartAttaRoute.rtext = !rtextArray
    !this.prpCwbranch.val = !!pickedExtGeoStartPartAtta[1].flnm

    -- Update aids
    if(!this.listStartPartAttaRoute.dtext.set())then
      !this.aidRemove.active = true
    else
      !this.aidRemove.active = false
    endif

  elseif(!element eq 'EXTGEOMANUAL')then

    -- Check for valid selection of CWBRAN
    if(undefined(!!pickedExtGeoStartManAtta))then
      !!ce = !ce
      return
    elseif(!!pickedExtGeoStartManAtta.type.neq('CWBRAN'))then
      !!ce = !ce
      !!alert.message('Select a Cableway Branch')
      return
    endif
    if ( not !this.checkIClass(!!pickedExtGeoStartManAtta) ) then
    		!!ce = !ce
	      return
    endif

    -- Collect all points on selected Branch
    !collRatta = object COLLECTION()
    !collRatta.type('TATTA')
    !collRatta.addType('HATTA')
    !collRatta.addType('RATTA')
    !collRatta.addType('RNODE')
    !collRatta.scope(!!pickedExtGeoStartManAtta)
    !collRattaResults = !collRatta.results()
    !extgeoStaRef = !collRattaResults

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoStaRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listStartManualAttaRoute.setrows(!linesArray)
    !this.listStartManualAttaRoute.rtext = !rtextArray

      !this.aidClear('ENTRY')
      !this.aidClear('EXIT')
      !this.aidClear('ENTRYPART') 			
 			if (!this.manualModify.val.not()) then
 				!!cblCable.manualExitPoint = object DBREF()
  			!!cblCable.manualEntryPoint = object DBREF()
  			!this.exitManual.val = ||
  			!this.entryManual.val = ||
  		endif

    -- Update aids
    if(!this.listStartManualAttaRoute.dtext.set())then
      !this.aidRemoveManual.active = true
    else
      !this.aidRemoveManual.active = false
    endif
      !this.startManualCwbranch.val = !!pickedExtGeoStartManAtta.flnm

  elseif(!element eq 'NEARSTARTATTA')then

    !collRatta = object COLLECTION()
    --!collRatta.type('TATTA')
    --!collRatta.addType('HATTA')
    !collRatta.type('RATTA')
    !collRatta.addType('RNODE')
    !collRatta.scope(!this.nearestStartAtta.own)
    !collRattaResults = !collRatta.results()
    !extgeoStaRef = !collRattaResults
    !extgeos = !this.cableObj.extgeoHref

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoStaRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listStartAttaRoute.setrows(!linesArray)
    !this.listStartAttaRoute.rtext = !rtextArray
    !this.findNearestExtgeo(!this.listStartAttaRoute,!this.cableObj.staRef)

  elseif(!element eq 'EXTGEOSTARTROUTED')then

    -- Collect all points and extgeo on selected Branch
    !collRatta = object COLLECTION()
    !collRatta.type('TATTA')
    !collRatta.addType('HATTA')
    !collRatta.addType('RATTA')
    !collRatta.addType('RNODE')
    !col = object COLLECTION()
    !col.type('EXTGEO')
    !col.scope(!!ce)
    if(!col.results().unset())then
      !!alert.message('Cable is not Routed.')
      !!ce = CE
      !this.setTask('MODIFY','CABLE')
      return
    else
      if(!col.results()[1].staRef.unset())then
        !!alert.message('Start reference is not set')
        return
      endif
      if(!col.results()[1].staRef.type inset('HATTA','TATTA'))then
        !collRatta.scope(!col.results()[1].staRef.own)
      else
        !collRatta.scope(!col.results()[1].staRef.own.own)
      endif
    endif
    !collRattaResults = !collRatta.results()
    !extgeoStaRef     = !collRattaResults
    !this.extgeoStartName = !collRattaResults
    !extgeos = !this.cableObj.extgeoHref

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoStaRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listStartAttaRoute.setrows(!linesArray)
    !this.listStartAttaRoute.rtext = !rtextArray

    -- Select Entry Point in the list gadget and display aid text
    !entryPoint = !col.results()[1].staRef
    do !i indices !rtextArray
      if(!col.results()[1].staRef.string().eq(!rtextArray[!i]))then
        !this.listStartAttaRoute.val = !i
        !this.aidClear('ENTRY')
        aid text num $!this.entryAidNum '<Entry>' at $!entryPoint.pos
      endif
    enddo

  elseif(!element eq 'EXTGEOENDROUTED')then

    -- Collect all points and extgeo on selected Branch
    !collRatta = object COLLECTION()
    !collRatta.type('TATTA')
    !collRatta.addType('HATTA')
    !collRatta.addType('RATTA')
    !collRatta.addType('RNODE')
    !col = object COLLECTION()
    !col.type('EXTGEO')
    !col.scope(!!ce)
    if(!col.results().unset())then
      !!alert.message('Cable is not Routed.')
      !!ce = CE
      !this.setTask('MODIFY','CABLE')
      !!ce = !ce
      return
    else
      if(!col.results()[!col.results().size()].endRef.type inset('HATTA','TATTA'))then
        !collRatta.scope(!col.results()[!col.results().size()].endRef.own)
      else
        !collRatta.scope(!col.results()[!col.results().size()].endRef.own.own)
      endif
    endif
    !collRattaResults = !collRatta.results()
    !extgeoEndRef = !collRattaResults
    !extgeos = !this.cableObj.extgeoTref

    -- Sort and rename collected points and update list gadget
    !list = !this.sortPoints(!extgeoEndRef)
    !linesArray = !list[1]
    !rtextArray = !list[2]
    !this.listEndAttaRoute.setrows(!linesArray)
    !this.listEndAttaRoute.rtext = !rtextArray

    -- Select Exit Point in the list gadget and display aid text
    !exitPoint = !col.results()[!col.results().size()].endRef
    do !i indices !rtextArray
      if(!col.results()[!col.results().size()].endRef.string().eq(!rtextArray[!i]))then
        !this.listEndAttaRoute.val = !i
        !this.aidClear('EXIT')
        aid text num $!this.exitAidNum '<Exit>' at $!exitPoint.pos
      endif
    enddo

  elseif(!element eq 'POINTR') then

    if (!this.pickedElementPos.origin.unset())then
      !!ce = !ce
      return
    endif
    !pos        = object POSITION('E0 N0 U0')
    !pos.east   = !this.pickedElementPos.east
    !pos.north  = !this.pickedElementPos.north
    !pos.up     = !this.pickedElementPos.up
    !this.posControl.xyz(!pos.east, !pos.north, !pos.up)
    !this.aid('NewPos', !this.getPosFromCntrl(!this.posControl.xyz()))

  endif

  !!ce = !ce
endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method: checkIClass
--
-- Description: checkIClass
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     DBREF       DBREF to be check
-- Return:
--  1    R     BOOLEAN     Return true if IClass on cable matching Iclass om Cableway Branch
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkIClass(!element is DBREF) is BOOLEAN
	
	if (!element.rllo.neq('')) then
			!rllo = !element.rllo
			var !result evaluate $!rllo for $!this.currentElement
			if (not !result[1].boolean()) then
				 !!alert.message('Current cable has IClass set to '& !this.currentElement.iclass & ' Please select a Cableway Branch, which allows this type of cable.')
			return false
			endif
	endif
	return true

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: create
--
-- Description: creation
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!elementType is STRING)

  if(!elementType eq 'CABLE')then
  --check if the Cabling System Licence is Valid
    !obj = object MDRLICENCEMANAGER()
  	!licenceError= !obj.getLicence('CABLES')
  	!error = !obj.lastError()
    if (!licenceError LT 0) then
  	--Alert the user of invalid licence/seats
  		!!alert.error('$!error')
      return
    else
      --feed the cable attributes from the form into the cable object
      !this.updateCbl(|CREATE|)
      --create the cable with the required number of cores
      !this.cableObj.create()
      !!ce = CE
      !this.setTask('MODIFY', 'CABLE')
      !this.highlight('TRUE')
      !!ce = !this.cableObj.dbref
      -- Warn user if outside diameter is unset/zero on chosen cable spec
      !warning = !this.cableObj.checkOutsideDiameter()
      if !warning.length().neq(0) then
        !!alert.warning(!warning)
      endif
      !this.prevCableSpec = !this.cableObj.spref
    endif
  elseif(!elementType eq 'CORE')then
    !this.cableObj.addCore()
    !this.loadData(|CORECREATE|)

  elseif(!elementType eq 'POINTR')then
    if(!this.listPointr.dtext.set())then
     !selection = !this.listPointr.selection()
     !selectionNumber = !this.listPointr.val
     !this.cableObj.pointr = !this.listPointr.dtext[!selectionNumber].dbref()
     !!ce = !this.cableObj.pointr
    endif
    !this.cableObj.createPointr()
    !!ce = !this.cableObj.pointr
    !xPoss = !this.posControl.xyz()[0].string()
    !yPoss = !this.posControl.xyz()[1].string()
    !zPoss = !this.posControl.xyz()[2].string()
    !this.cableObj.pointr.pos = E $!xPoss N $!yPoss U $!zPoss wrt world

    !this.loadData(|POINTRCREATE|)
    !this.setLengthAndDirection('Normal')
    if !this.listPointr.dtext.set() then
     !this.pointrPrev.active = true
     !this.pointrNext.active = true
    else
     !this.pointrPrev.active = false
     !this.pointrNext.active = false
    endif
    !!ce = !this.cableObj.dbref

  elseif(!elementType eq 'EXTGEO')then

   !this.cableObj.createExtGeo()
   !selectionStartNumber = !this.listStartAttaRoute.val
   !attaStartExtGeo      = !this.listStartAttaRoute.rtext[!selectionStartNumber].dbref()
   !this.cableObj.extgeo.staRef = !attaStartExtGeo
   !selectionEndNumber   = !this.listEndAttaRoute.val
   !attaEndExtGeo        = !this.listEndAttaRoute.rtext[!selectionEndNumber].dbref()
   !this.cableObj.extgeo.endRef = !attaEndExtGeo

   !this.loadData(|ROUTE|)
   !!ce = !this.cableObj.dbref

  elseif(!elementType eq 'ROUTE')then
    if (!this.routeStartRefData.val.set()) then
      if (!this.routeStartRefData.val.eq('Nulref')) then
        !staRef = '=0/0'
        staRef unset
      elseif (!this.routeStartRefData.val.substring(1,1).neq('/') and !this.routeStartRefData.val.substring(1,1).neq('=')) then
        !staRef = '/' + !this.routeStartRefData.val
        !this.cableObj.extgeo.staRef = !staRef.dbref()
      else
        !staRef = !this.routeStartRefData.val
        !this.cableObj.extgeo.staRef = !staRef.dbref()
      endif
      handle (2,813)
        -- ref is not set in the gadget just do nothing
      endhandle
    endif

    if (!this.routeEndRefData.val.set()) then
     if (!this.routeEndRefData.val.eq('Nulref')) then
       !endRef = '=0/0'
       endRef unset
     elseif (!this.routeEndRefData.val.substring(1,1).neq('/') and !this.routeEndRefData.val.substring(1,1).neq('=')) then
       !endRef = '/' + !this.routeEndRefData.val
       !this.cableObj.extgeo.endRef = !endRef.dbref()
     else
       !endRef = !this.routeEndRefData.val
       !this.cableObj.extgeo.endRef = !endRef.dbref()
     endif
     handle (2,813)
       -- ref is not set in the gadget just do nothing
     endhandle
    endif
    !this.loadData(|ROUTE|)
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:    routeCable
--
-- Description: route Cable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .routeCable(!cable is DBREF)

    -- Get route start and end points selected in list gadgets
    !routePointStart  = !this.listStartAttaRoute.rtext[!this.listStartAttaRoute.val].dbref()
    !routePointEnd  = !this.listEndAttaRoute.rtext[!this.listEndAttaRoute.val].dbref()

    -- Collect the CWBRANs of the Entry and Exit Points selected on form
    !pickedCwbrans[1] = CWBRAN of $!routePointStart
    !pickedCwbrans[2] = CWBRAN of $!routePointEnd

    -- Check if Cableway Zones have been specified and that selected Entry/Exit points exist
    -- within those zones.  !zoneArray value is then set to be used later as the scope for routing.
    !zoneArray = ARRAY()
    !rlseZones = ''
    if(!this.listZone2.val.set())then
      do !i from 1 to !this.listZone2.selection().size()
        !zoneArray.append(!this.listZone2.selection()[!i].dbref())
        !rlseZones =  !this.listZone2.selection()[!i].dbref().name & ' ' & !rlseZones
      enddo
      !ce = !!ce
      do !i from 1 to 2
        !!ce = !pickedCwbrans[!i]
        ZONE
        !!ce.string()
        if !zoneArray.findfirst(!!ce).unset() and !zoneArray.findfirst( /* ).unset() then
          !!ce = !ce
          !this.zoneCollectRoute2.expanded = TRUE
          !!alert.error('Cableway Branch Entry/Exit Point does not exist in defined Cableway Zones.')
          return
        endif
      enddo
      !!ce = !ce
    else
      !routeWorld = !!alert.confirm('Are you sure you want to route via any Cableways found in WORLD?  (This could take a long time for large projects).')
      if !routeWorld.boolean() then
        !zoneArray[1] = /*
        !rlseZones = '/*'
      else
        !this.zoneCollectRoute2.expanded = TRUE
        return
      endif
    endif

    !undo = object UNDOABLE()
    !undo.add()
    !!ce = !cable
    !rt = object MDRROUTER()
    !m  = object MDRBASEMANAGER()
    !colRpath = object COLLECTION()
    !colRpath.type('RPATH')
    !colRpath.scope(!this.cableObj.dbref)
    if(!colRpath.results().unset())then
      NEW RPATH
      handle (2,18)
        !!alert.error('Element $!!ce.name is locked.')
        return
      elsehandle(2,25)
        !!alert.error('Read only DB')
        return
      endhandle
--      !this.setTask('MODIFY','CABLE')
    endif

    -- Collect all association members
    !routePath = object COLLECTION()
    !routePath.type('CWBRAN')

    !!ce = !cable
    -- Set routing scope attribute on cable and set scope for graph
    if ( !rlseZones.occurs('/*') gt 0 ) then
		  rlse all cwbran
	  else
		  rlse all cwbran for $!rlseZones
			!routePath.scope(!zoneArray)
		endif

    !cwayBranch = !routePath.results()

    !col = object COLLECTION()
    !col.type('EXTGEO')
    !col.scope(!this.cableObj.dbref)
    !colResults = !col.results()
    do !j from 1 to !colResults.size()
      !!ce = !colResults[!j]
      delete $!!ce.type
    enddo
    !!ce = rpath1
    !colPointr = object COLLECTION()
    !colPointr.type('POINTR')
    !colPointr.scope(!this.currentElement)
    !colPointrResults = !colPointr.results()
    do !k from 1 to !colPointrResults.size()
      !!ce = !colPointrResults[!k]
      delete $!!ce.type
    enddo

    !connectionManager = object MDRCONNECTIONMANAGER()
    !graph = !connectionManager.createConnectionGraphFromBranches(!cwayBranch)

    if(!this.listStartAttaRoute.count.eq(0) or !this.listEndAttaRoute.count.eq(0))then
      !!alert.message('Select Entry/Exit point for Cable routing')
      !!ce = !cable
      return
    endif
    -- get connection graph
    !routePoint1 = !this.cableManager.createRoutePoint(!routePointStart)
    !startPos =  !routePoint1.position()
    !routePoint2 = !this.cableManager.createRoutePoint(!routePointEnd)
    !endPos   =  !routePoint2.position()
    !this.cableManager.setConnectionsGraph(!graph)

    -- Find Cable Route
    !cableRoute = !this.cableManager.findRoute( !this.cableObj.dbref , !routePoint1 , !routePoint2)
    !!ce = !this.cableObj.dbref

    -- Reset routnd attribute as this is only used for PRP routing
    routnd unset
    handle ANY
    endhandle


    -- Redraw cable in 3D view
    REM CE ADD CE

    !routeSuccess = !this.cableManager.routeCable(!this.cableObj.dbref, !cableRoute)
    handle ANY
      !!alert.error(!!error.text)
      !this.cableObj.dbref.cbsta = 2
      return
    endhandle

    !findExtGeo = object COLLECTION()
    !findExtGeo.type('EXTGEO')
    !findExtGeo.scope(!this.cableObj.dbref)
    !extgeo = !findExtGeo.results()

    -- Check that routing was successful before continuing
    if !routeSuccess.not() or !extgeo.unset() then
      !!alert.error('Routing Failed, Please re-consider validity of route definition.')
      !this.cableObj.dbref.cbsta = 2
      return
    endif

    -- Set cable as partially routed if staRef or endRef is unset
    if !this.cableObj.dbref.staRef.badref() or !this.cableObj.dbref.endRef.badref() then
      !warning = 'Cable can only be partially routed as Cable Start/End Reference is unset.'
      !!alert.warning(!warning)
      !this.cableObj.dbref.cbsta = 3
    else
      -- Check that start of cable matches entry point.  If not, then ask if the user wants the ends
      -- to be free routed to complete routing.  If not, set routing status to partially routed (3).
      !warning1 = ''
      !warning2 = ''
      if !this.cableObj.staRef.pos.wrt(WORLD).neq(!extgeo[1].staRef.pos.wrt(WORLD)) then
        if !this.routeHeadTailFree.val then
          !this.headTailRoute(|HEAD|)
        else
          !warning1 = '
 - Cable Head does not match Entry Point'
          !warning2 = 'Head '
        endif
      endif
      if !this.cableObj.endRef.pos.wrt(WORLD).neq(!extgeo[1].endRef.pos.wrt(WORLD)) then
        if !this.routeHeadTailFree.val then
          !this.headTailRoute(|TAIL|)
        else
          !warning1 = !warning1 & '
 - Cable Tail does not match Exit Point'
          !warning2 = !warning2 & 'Tail'
        endif
      endif
      if !warning1.length().gt(0) then
        if !warning2.length().gt(6) then
          !warning2 = !warning2.split()[1] & ' and ' & !warning2.split()[2]
        endif
        !warning = 'Cable can only be partially routed as:' & !warning1 & '
Would you like to Free Route the ' & !warning2 & ' to complete cable routing?'
        !routeFree = !!alert.confirm(!warning)
        !cblMan = object CABLEMANAGER()
        if !routeFree.boolean() then
          if !warning2.upcase().match('HEAD').gt(0) then
            !cblMan.reconnectCable(!this.cableObj.dbref, true, 'xyz')
          endif
          if !warning2.upcase().match('TAIL').gt(0) then
            !cblMan.reconnectCable(!this.cableObj.dbref, false, 'xyz')
          endif
        else
          !this.cableObj.dbref.cbsta = 3
        endif
      endif
    endif

    !!ce = !this.cableObj.dbref

    !this.loadData('CABLE')
    !undo.endundoable()

    -- Return to main Modify Cable Form if cable is completely routed
    if(!this.cableObj.dbref.cbsta.eq(1))then
      !this.setTask(|MODIFY|,|CABLE|)
    endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    unRouteCable
--
-- Description: un-route Cable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unRouteCable()

 !cabMan = object CABLEMANAGER()
 !!ce = !this.cableObj.dbref
 if(!!ce.cbsta.neq(0))then
   !confUnRoute = !!alert.confirm('Do you really want to un-route cable?')
   if(!confUnRoute.eq('NO'))then
     return
   endif
   !cabMan.unRouteCable(!!ce)
   if !!ce.routnd.set() then
     !removeRouteNode = !!alert.confirm('Do you want to remove route node information?')
     if(!removeRouteNode.eq('YES')) then
       ROUTND UNSET
       handle ANY
       endhandle
     endif
  endif
 else
  !!alert.message('Cable is not routed')
  return
 endif
 !this.listStartManualAttaRoute.clear()
 !this.listEndManualAttaRoute.clear()
 !this.loadData('CABLE')

endmethod

------------------------------------------------------------------------
--
-- Method:    manualOrAuto
--
-- Description: to check if the cable is manually or auto routed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manualOrAuto()

    !this.currentElement = !this.cableObj.dbref
    if(!this.currentElement.badref())then
    	!!alert.error('Cable is deleted.')
    	return
    endif
    if(!this.currentElement.cbsta.eq(5))then
      !conf = !!alert.confirm('Cable is manually routed ,do you want to auto-route the cable?')
      if(!conf.eq('NO'))then
        return
      elseif(!conf.eq('YES'))then
        if(!this.listStartAttaRoute.visible)then
          !this.routeCable(!this.currentElement)
        else
          !this.autoRouteCable(!this.currentElement)
        endif
      endif
    else
      if(!this.listStartAttaRoute.visible)then
        !this.routeCable(!this.currentElement)
      else
        !this.autoRouteCable(!this.currentElement)
      endif
    endif

endmethod

------------------------------------------------------------------------
