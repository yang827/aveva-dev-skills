------------------------------------------------------------------------
--
-- Method:   cblCable()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblCable()

  !this.ceAuto.addPixmap(!!pml.getPathname('autoname.png'))
  -- back icon
  !backIcon = !!pml.getPathname('back.png')
  !this.coreBack.addPixmap(!backIcon)
  !this.cableBack.addPixmap(!backIcon)
  !this.routeBack.addPixmap(!backIcon)
  !this.pointrBack.addPixmap(!backIcon)
  !this.cableDelBack.addPixmap(!backIcon)
  !this.routePartBack.addPixmap(!backIcon)
  !this.routeManualBack.addPixmap(!backIcon)
  -- apply icon
  !apply = !!pml.getPathname('accept.png')
  !this.modifyApply.addPixmap(!apply)
  !this.coreApply.addPixmap(!apply)
  !this.pointrApply.addPixmap(!apply)
  -- create icon
  !create = !!pml.getPathname('create.png')
  !this.createCreate.addPixmap(!create)
  !this.routeRoute.addPixmap(!create)
  !this.routePartRoute.addPixmap(!create)
  !this.routePartHeadRoute.addPixmap(!create)
  !this.routePartTailRoute.addPixmap(!create)
  !this.routeManualRoute.addPixmap(!create)
  !this.routeManualHeadRoute.addPixmap(!create)
  !this.routeManualTailRoute.addPixmap(!create)
  !this.pointrCreate.addPixmap(!create)
  -- dismiss icon
  !dismiss = !!pml.getPathname('discard.png')
  !this.coreDelete.addPixmap(!dismiss)
  !this.deleteBack.addPixmap(!dismiss)
  -- delete icon
  !delete = !!pml.getPathname('deletece16.png')
  !this.deleteFreeRoute.addPixmap(!delete)
  !this.manualDeleteRoute.addPixmap(!delete)

  -- PRP list icons
  !this.prpAddAbove.addPixmap(!!pml.getPathname('uparrow16.png'))
  !this.prpAddBelow.addPixmap(!!pml.getPathname('downarrow16.png'))
  !this.prpAddBottom.addPixmap(!!pml.getPathname('downdownarrow16.png'))
  !this.removePrp.addPixmap(!!pml.getPathname('draft_t_024.png'))
  !this.moveTop.addPixmap(!!pml.getPathname('upuparrow16.png'))
  !this.moveUp.addPixmap(!!pml.getPathname('uparrow16.png'))
  !this.moveDown.addPixmap(!!pml.getPathname('downarrow16.png'))
  !this.moveBottom.addPixmap(!!pml.getPathname('downdownarrow16.png'))

  --Register Aid numbers
  !this.startPosAidNumber  = !!aidNumbers.add('New Start Position')
  !this.endPosAidNumber    = !!aidNumbers.add('New End Position')
  !this.equiStartAidNumber = !!aidNumbers.add('New Start Position')
  !this.equiEndAidNumber   = !!aidNumbers.add('New End Position')
  !this.entryAidNum        = !!aidNumbers.add('Entry Point')
  !this.starAidNum         = !!aidNumbers.add('Entry Point')
  !this.exitAidNum         = !!aidNumbers.add('Exit Point')
  !this.startAidNum        = !!aidNumbers.add('Cable Start')
  !this.endAidNum          = !!aidNumbers.add('Cable End')
  !this.attaNumber         = !!aidNumbers.add('Route')
  !this.entryPartAidNum    = !!aidNumbers.add('Entry Point')
  !this.prpAid             = !!aidNumbers.add('PRP position')
  !this.manualAid          = !!aidNumbers.add('Manual position')
  !this.entryManualAidNum  = !!aidNumbers.add('Route Point')
  !this.manualEntryAid     = !!aidNumbers.add('Manual Entry')
  !this.manualExitAid      = !!aidNumbers.add('Manual Exit')

  -- Setup right-click menus
  !this.listZone.setpopup(!this.navigateToZonePopup)
  !this.listZone2.setpopup(!this.navigateToZonePopup)
  !this.listZone3.setpopup(!this.navigateToZonePopup)
  !this.listStartAttaRoute.setpopup(!this.routeStartPopup)
  !this.listEndAttaRoute.setpopup(!this.routeEndPopup)
  !this.listStartPartAttaRoute.setpopup(!this.routePRPPickPopup)
  !this.listEndPartAttaRoute.setpopup(!this.routePRPListPopup)

  !menu   =   !this.newMenu('deletepointr')
  !menu.add('callback','Delete','!this.delete(|POINTR|)')
  !this.listPointr.setpopup(!menu)

  -- Set up option gadget
  !routingStatus = ARRAY()
  !routingStatus.append('0 ( Un-routed )')
  !routingStatus.append('1 ( Routed )')
  !routingStatus.append('2 ( Routing Failed )')
  !routingStatus.append('3 ( Partially Routed )')
  !routingStatus.append('4 ( Partially Failed )')
  !routingStatus.append('5 ( Manually Routed )')
  !this.modifyRoutingStatus.dtext = !routingStatus

  !this.setupSystemReference()

  !this.cableMainTaskPane.visible    = TRUE
  !this.modifyCoresTaskPane.visible  = FALSE
  !this.routeTaskPane.visible        = FALSE
  !this.routePrpTaskPane.visible     = FALSE
  !this.routeManualTaskPane.visible  = FALSE
  !this.modifyPointrTaskPane.visible = FALSE
  !this.deleteTaskPane.visible       = FALSE
  !this.posControl('netPositionFrame1','posControl')
  !this.zoneCollectRoute.expanded    = FALSE
  !this.zoneCollectRoute2.expanded   = FALSE
  !this.zoneCollectRoute3.expanded   = FALSE
  !this.listStartPartAttaRoute.clear()
  !this.listEndPartAttaRoute.clear()
  !this.edgDescription = 'Cable Routing'
  !this.loadData(|ZONE|)
  -- load catalogue data
  !this.tableChooseData.cleardata()
  !this.tableChooseData.setTitle('cable')
  !this.tableChooseData.setdata('CABLE','CABL')

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: init
--
-- Description: Initialisation method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

 !this.loadData(|ZONE|)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: setTask
--
-- Description: To set the task based on the action to be performed.
--              Switching the gadgets on /off
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!formTask is STRING,!element is STRING )

  !task = !formTask.upcase()
  !ce = !!ce

  --Change the form title
  if !task.eq('CREATE') then
    !title = 'Create'
    if(!element neq 'POINTR')then
     !this.cableObj      = object CABLE()
    endif
    !this.aidClear('ENTRY')
    !this.aidClear('EXIT')
    !this.aidClear('EXISTING')
    !this.aidClear('ENTRYPART')
  elseif !task.eq('MODIFY') then
    !title = 'Modify'
    --!this.cableObj      = object CABLE(!this.cableObj.dbref)
  elseif !task.eq('BACK') then
    !title = 'Modify'
  endif

  !this.cableMainTaskPane.visible    = FALSE
  !this.modifyCoresTaskPane.visible  = FALSE
  !this.routeTaskPane.visible        = FALSE
  !this.routePrpTaskPane.visible     = FALSE
  !this.routeManualTaskPane.visible  = FALSE
  !this.deleteTaskPane.visible       = FALSE
  !this.modifyPointrTaskPane.visible = FALSE

  --set Task
  if (!element eq 'CABLE') then
    !this.cableMainTaskPane.visible = TRUE
    !this.formTitle = !title & ' Cable'
    if !title.eq('Create') then
      !this.helpContextID = 'HID_CBLCABLE'
    elseif !title.eq('Modify') then
      !this.helpContextID = 'HID_CBLMODCABLE'
    endif
   !this.cableMainGadgets(!task)

  elseif (!element eq 'CORE') then
    !this.modifyCoresTaskPane.visible = TRUE
    !this.listCore.clear()
    !this.coreGadgets()
    !this.formTitle = !title & ' Core Tasks'

  elseif (!element eq 'ROUTE') then
    !this.formTitle = 'Route Cable'
    !this.helpContextID = 'HID_CBLROUTE'
    !this.routeTaskPane.visible = true

  elseif (!element eq 'ROUTEPRP') then
    !this.formTitle = 'Route Through PRPs'
    !this.helpContextID = 'HID_CBLPRPS'
    !this.routePrpTaskPane.visible = TRUE

  elseif (!element eq 'MANUAL') then
    !this.formTitle = 'Manual Route Cable'
    !this.helpContextID = 'HID_CBLMANUAL'
    !this.routeManualTaskPane.visible = true

  elseif(!element eq 'POINTR')then
    !this.formTitle = !title & ' Free Point'
    if !title.eq('Create') then
      !this.helpContextID = 'HID_CBLFREEPOINT'
    elseif !title.eq('Modify') then
      !this.helpContextID = 'HID_CBLMODFREEPOINT'
    endif
    !this.modifyPointrTaskPane.visible = TRUE
    if !this.listPointr.dtext.set() then
      !this.pointrPrev.active = TRUE
      !this.pointrNext.active = TRUE
    else
      !this.pointrPrev.active = FALSE
      !this.pointrNext.active = FALSE
    endif
    !this.pointrGadgets(!task)

  elseif (!element eq 'DELETE') then
    !this.formTitle = 'Delete Tasks'
    !this.helpContextID = 'HID_CBLDELTASKS'
    !this.deleteTaskPane.visible = TRUE
  endif

  if(!task eq 'CREATE') then
    !this.createData(!element)
    if(!this.prevCableSpec.set())then
      !this.specChoose.val = !this.prevCableSpec.namn
      !this.specDesc.val = !this.prevCableSpec.own.desc
      !this.specCore.val = !this.getNumberOfCores(!this.prevCableSpec)
      handle (61,620)
        !this.specCore.val = 'Unset'
      endhandle
      !this.specOutDia.val  = !this.prevCableSpec.propre.attribute('OUTD').string()
      handle any
        !this.specOutDia.val = 'Unset'
      endhandle
      !this.cableIclass.val = !this.prevCableSpec.prtref.cmpref.dinter
    else
      !this.specChoose.val = ''
      !this.specDesc.val = ''
      !this.specCore.val = ''
      !this.cableIclass.val = ''
      !this.specOutDia.val = ''
    endif

  elseif(!task eq 'MODIFY') then
    if(!!ce.type.neq('CABLE'))then
      !!ce = !this.cableObj.dbref
    endif
    !this.loadData(!element)
    !this.loadData('ZONE')
    !this.highlight('TRUE')
    if(!element.eq('ROUTE') or !element.eq('ROUTEPRP') and (!this.cableObj.staRef.set() and !this.cableObj.endRef.set()))then
      !this.findNearestAtta(!this.cableObj.dbref,!element)
    endif
    !col = object COLLECTION()
    !col.scope(!this.cableObj.dbref)
    !col.type('EXTGEO')
    -- Initialise Routing / PRP Routing choice list gadgets
    if(!col.results().set() and !task.eq('MODIFY') and !element.eq('ROUTE'))then
      !this.updateName('EXTGEOSTARTROUTED','')
      !this.updateName('EXTGEOENDROUTED','')
    elseif(!this.cableObj.dbref.routnd.set() and !col.results().set() and !element.eq('ROUTEPRP')) then
      !routeNode = !this.cableObj.dbref.routnd[!this.cableObj.dbref.routnd.size()]
      !!pickedExtGeoStartPartAtta[1] = !routeNode.own.own
      !this.updateName('EXTGEOPART','')
    endif
    if !element.eq('POINTR') and !this.listPointr.dtext.set() then
      !this.pointrPrev.active = TRUE
      !this.pointrNext.active = TRUE
      !this.listPointr.val = 1
      !this.pointrAction()
    else
      !this.pointrPrev.active = FALSE
      !this.pointrNext.active = FALSE
    endif

  elseif(!task eq 'BACK')then
    if(!!ce.type.neq('CABLE'))then
      !!ce = !this.cableObj.dbref
    endif
    !this.loadData(!element)
    if(!element eq 'POINTR')then
    endif

  elseif(!task eq 'AUTOROUTE')then
    !this.loadData('ZONE')
  endif
  !!ce = !ce

endmethod
--End of method definition

------------------------------------------------------------------------
--
