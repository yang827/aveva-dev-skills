    paragraph .deleteBack                      anchor l+t     at x0            ymax       pixmap
    button    .delete       linklabel 'Delete' anchor l+t     at xmax+1        ymin       width 5  call '!this.delete(|CABLE|)'
    paragraph .cableDelBack                    anchor l+t     at x0            ymax       pixmap
    button    .cableBackFromDelete  linklabel  'Back To Modify Cable'     anchor l+t     at xmax+1        ymin  call '!this.setTask(|BACK|,|CABLE|)'


  exit

  -- Right click menus
  menu .navigateToZonePopup popup
     !this.navigateToZonePopup.add( 'CALLBACK', 'Navigate To' , '!this.navigateToZone()')
  menu .routeStartPopup popup
     !this.routeStartPopup.add( 'CALLBACK', 'List of Associated Cables...' , '!this.showCblListCables(|START|)')
  menu .routeEndPopup popup
     !this.routeEndPopup.add( 'CALLBACK', 'List of Associated Cables...' , '!this.showCblListCables(|END|)')
  menu .routePRPPickPopup popup
