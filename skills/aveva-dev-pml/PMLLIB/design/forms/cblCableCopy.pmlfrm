--
--
--  Description:     cable copy with or without connections
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoName(STRING,DBREF)           -
--  cblCableCopy()                   -                   Constructor
--  cblCableCopyInit()               -
--  checkRoutingPath()               -                   Disable correct routing toggles on current Element
--  clearGadgets()                   -
--  copyCable()                      -                   copies CABLE with/without connected equipment
--  copyCable2()                     BOOLEAN             Copy cable continued...
--  dismiss()                        -                   dismiss the cable form
--  getCe()                          -                   get the current element
--  getEndReference()                -                   Get Endref of cable
--  getSpref(GADGET,GADGET)          -                   Get the specification to the new cable
--  getStartReference()              -                   Get Staref of cable
--  numberOfCopies()                 -
--  setCableStatus()                 -                   copy cable status depending on which attributes are to be copied
--  toggleRouting()                  -                   toggle routing options
--  validateNewName(GADGET,STRING)   BOOLEAN             validate a new name to check it is allowed not type specific
--  validateOldName(GADGET,STRING)   BOOLEAN             validate an existing (old) cable name and type
--
----------------------------------------------------------------------
import 'PositionControl'
handle ANY
endhandle
setup form !!cblCableCopy dialog dock right

  !this.autoscroll = true
  line      .scrollLine       at x32         y0     Horiz    width .1

  -- Cable Without Connections
  frame .copyCableTaskPane panel                anchor l+t+r      at x0         y0
    -- text gadgets have been grouped to allow user to tab through them
    paragraph .namingTagCopyCab                 anchor l+t      at xmin       ymax +0.2                 text 'Cable To Copy'
    line      .tagLineCopyCab                   anchor l+t+r    at xmin       ymax -0.2                 Horiz    width 35
    text      .copyElementCab                   anchor l+t+r    at xmin       ymax +.2      callback '' width 25 is STRING
    button    .ceCopyCab     linklabel 'CE'     anchor r+t      at xmax+.2    ymin          callback '!this.getCe()'

    paragraph .cableCopiedCableTag              anchor l+t      at xmin.copyElementCab       ymax +0.2  text 'New Cable'
    line      .cableLineCopy                    anchor l+t+r    at xmin       ymax -0.2                 Horiz    width 35
    text      .cableCopyCableName               anchor l+t+r    at xmin       ymax +.2      callback '' width 25 is STRING
    button    .ceAuto                           anchor r+t      at xmax+.2    ymin       pixmap callback '!this.autoName(|CABLE|,!!cblCableCopy.currentElement.owner)' tooltip 'AutoNaming'


    paragraph .numberOfCabCopiesLabel           anchor l+t      at xmin.cableCopyCableName       ymax-.2 text 'Number of Copies:'   width 14
    text      .numberOfCabCopies                anchor l+t+r    at xmax+4     ymin              width 6.5 is REAL
    line      .attributesLine                   anchor l+t+r    at xmin.numberOfCabCopiesLabel      ymax+.2                 Horiz    width 35
    paragraph .attributes                       anchor l+t      at xmin       ymax +.2     text 'Cable Attributes to Copy:'

    toggle    .copyCableSpec                    anchor l+t      at xmin       ymax+.2   'Spec Ref' call '!this.getSpref(!this.cableSpref, !this.copyCableSpec)'
    paragraph .cableSpref                       anchor l+t      at xmax+3.8   ymin                        width 22 lines 1

    toggle    .copyStaref                       anchor l+t      at xmin.copyCableSpec ymax+.2      'Start Ref' call '!this.getStartReference()'
    paragraph .cableStaref                      anchor l+t      at xmin.cableSpref  ymin width 22 lines 1

    toggle    .copyEndref                       anchor l+t      at xmin.copyStaref  ymax+.2        'End Ref' call '!this.getEndReference()'
    paragraph .cableEndref                      anchor l+t      at xmin.cableStaref ymin  width 22 lines 1

    line      .routeLine                        anchor l+t+r    at xmin.copyEndref ymax+.2 Horiz width 35
    paragraph .routePath                        anchor l+t      at xmin            ymax+.2 text 'Route Path:'
    toggle    .cableRpath                       anchor l+t      at xmin.routePath  ymax+.2 'Copy Route Path' call '!this.toggleRouting()'
    toggle    .head                             anchor l+t      at xmin.cableRpath ymax+.2 'Head Free Route'
    toggle    .tail                             anchor l+t      at xmin.head       ymax+.2 'Tail Free Route'


    paragraph .copyCabApply                     anchor l+t      at xmin.tail    ymax+1        pixmap
    button    .copyCableApply  linklabel 'Copy Cable'      anchor l+b   at xmax.copyCabApply ymin+.2  callback '!this.copyCable()'

  exit

  -- Form Members
  member .currentElement  is DBREF

  -- Undoable member
  member .undo       is UNDOABLE

exit

------------------------------------------------------------------------
--
-- Method:   cblCableCopy()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblCableCopy()

  !this.quitcall = '!this.dismiss()'
  !this.initCall = |!this.cblCableCopyInit()|

  !autoIcon = !!pml.getPathname('autoname.png')
  !apply    = !!pml.getPathname('accept.png')
  !this.ceAuto.addPixmap(!autoIcon)
  !this.copyCabApply.addPixmap(!apply)
  !this.numberOfCabCopies.val     = 1

   -- Gadget validation calls
  !this.copyElementCab.callback             = '!this.validateOldName(!this.copyElementCab, |CABLE|)'
  !this.cableCopyCableName.callback         = '!this.validateNewName(!this.cableCopyCableName, ||)'
  !this.numberOfCabCopies.callback          = '!this.numberOfCopies()'

   -- Undoable
  !this.undo.description('')
  !this.undo.undoAction('')
  !this.undo.redoAction('')
  !this.copyCableApply.setUndoable(!!cblCableCopy.undo)

endmethod

------------------------------------------------------------------------
--
-- Method:   cblCableCopyInit(!mode) where mode is a string which defines what operation we need to perform
--
-- Description: initialise method for cabling forms, set up with a mode string so we know which panels to populate and
--              initialise
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblCableCopyInit()

  -- Load cable defaults form
  if (undefined(!!cbldflts)) then
    pml reload form !!cbldflts
  endif

  --Form and Icon Title
  !this.iconTitle             = 'Core Modify Task'
  !this.formTitle             = 'Copy Cable'
  !this.clearGadgets()

  --show the modify mode taskpane and make sure all other taskpane are hidden
  !this.currentElement = !!ce
  !this.copyElementCab.val = !this.currentElement.namn
  !!ce = !this.currentElement

  !this.checkRoutingPath()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: autoNameCe
--
-- Description: Autonaming cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoName(!type is STRING, !own is DBREF)

  !name = !!cblAutoName(|CABLE|, !own)
  !this.cableCopyCableName.val    = !name

  if( !name.empty() ) then
    !!alert.warning('Cannot autoname element')
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: getCe
--
-- Description: get the current element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getCe()

  !memory = object DBREF()
  if(!this.currentElement.set() and !this.currentElement.badref().not())then
    !memory = !this.currentElement
  endif
  CABLE
  handle ANY
    !!alert.error('Navigate to CABLE Element and try again.')
    return
  endhandle
  !this.currentElement = !!ce

  -- re-initialise the form at the current element

  !this.cblCableCopyInit()

  -- Set the attributes of cable
  !this.getSpref(!this.cableSpref, !this.copyCableSpec)
  !this.getStartReference()
  !this.getEndReference()

endmethod
--End of method definition

-----------------------------------------------------------------------
--
-- Method: clearGadgets
--
-- Description: clears all gadget fields and sets if attribute is set.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearGadgets()

  -- clear cable copy gadgets

  !this.cableCopyCableName.val   = ''
  if (!!ce.type neq 'CABLE') then
    !!ce = !!dtbFindOwnerOfType(!!ce, 'CABLE', false)
  endif

  if (!!ce.type eq 'CABLE') then
    if (!!ce.spref.set()) then
      !this.copyCableSpec.val    = true
      !this.cableSpref.val       = !!ce.spref.name
    else
      !this.copyCableSpec.val    = false
      !this.copyCableSpec.active = false
      !this.cableSpref.val       = 'unset'
    endif

    if (!!ce.staref.set()) then
      !this.copyStaref.val       = true
      !this.cableStaref.val      = !!ce.staref.name
    else
      !this.copyStaref.val       = false
      !this.copyStaref.active    = false
      !this.cableStaref.val      = 'unset'
    endif

    if (!!ce.endref.set()) then
      !this.copyEndref.val       = true
      !this.cableEndref.val      = !!ce.endref.name
    else
      !this.copyEndref.val       = false
      !this.copyEndref.active    = false
      !this.cableEndref.val      = 'unset'
    endif
  else
    !!ce = !!dtbFindOwnerOfType(!!ce, 'CABLE', false)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: copyCable
--
-- Description: Checks current element is cable, ready for copy
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyCable()

   if(!this.currentElement.unset())then
     !!alert.message('Please select a Cable to Copy.')
     return
   endif

   -- Copy Cable
   !successful = !this.copyCable2()

   -- Confirmation message at the end of the copy method
   if (!successful) then
     refresh
     !!alert.message('Copy was successful')
   endif

endmethod

------------------------------------------------------------------------
--
-- Method: copyCable2()
--
-- Description: Copy cable continued...
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyCable2() is BOOLEAN


  if(!this.currentElement.set() and !this.currentElement.badref())then
    !!alert.error('Cable to copy does not exist, please copy a new cable')
    return false
  else
    !!ce = !this.currentElement
  endif

  !!ce = !this.currentElement

  if (!this.numberOfCabCopies.val.lt(1)) then
    !!alert.warning('Number of copies is less than 1.  Please enter a valid value.')
    return false
  elseif (!this.numberOfCabCopies.val.eq(1)) then
        !test = !this.validateOldName(!this.copyElementCab, 'CABLE')
      if (!test.eq (false)) then
        return false
      endif
        !test = !this.validateNewName(!this.cableCopyCableName, 'CABLE')	
      if (!test.eq (false)) then
        return false
      endif
  elseif (!this.numberOfCabCopies.val.gt(1)) then
        !test = !this.validateOldName(!this.copyElementCab, 'CABLE')
      if (!test.eq (false)) then
        return false
      endif
  endif

  if (!this.copyElementCab.val.trim() eq '' or !this.copyElementCab.val.unset()) then
    !!alert.warning('Please select Cable to be copied.')
    return false
  endif

   !count = 0
   !originalCable = !!ce
   !!cableStatus = !!ce.cbsta
   do !i from 1 to !this.numberOfCabCopies.val
      if( !!ce.type.eq('CABLE')) then
        if( !this.copyElementCab.val.substring(1,1).neq('=')) then
           !copyName = '/' & !this.copyElementCab.val
        else
           !copyName = !this.copyElementCab.val
        endif
        !newCableName = '/' & !this.cableCopyCableName.val
        handle(2,754)
          !newCableName = '/'
        endhandle
        if( !newCableName.eq('/')) then
           !newCableName = ''
        endif

        if (!i eq 1 and (not !!cbldflts.cableZoneDefault.badref())) then
          !!ce = !!cbldflts.cableZoneDefault
        endif

        if( !this.numberOfCabCopies.val eq 1) then
           NEW CABLE $!newCableName COPY ATTRIBUTES OF $!copyName
        else
           NEW CABLE COPY ATTRIBUTES OF $!copyName
           !!ce.name = '/' & !!cblAutoName(|CABLE|, !!cblCableCopy.currentElement.owner)
           handle ANY
             !count = !count + 1
           endhandle
        endif

        !copiedCable = !!ce

        feqdes unset
        teqdes unset
        markrf unset
        RoutNd Unset
        Cexes 0 0 0 0
        purp unset
        func unset
        desc unset
        !this.setCableStatus()

      else
       !!alert.message('Be at a Cable to copy.')

       return false
      endif

      if (!this.copyCableSpec.val.not()) then
        SPREF NULREF
      endif
      if (!this.copyStaref.val.not()) then
        STAREF NULREF
      endif
      if (!this.copyEndref.val.not()) then
        ENDREF NULREF
      endif

      -- Copy rpath
      if (!this.cableRpath.val) then

        -- Find index to first EXTGEO or set to 1 if not found or head free route is false
        !rpath       = !!dtbMemberOfType(!originalCable, 'RPATH' , 1)
        !extgeos = !!collectallfor('EXTGEO', '', !rpath)

        if (!extgeos.unset()) then
          new rpath copy $!rpath
        else
          if (!this.head.val) then
            !firstMember = 1
          else
            !firstMember = !extgeos[1].sequ
          endif

          if (!this.tail.val) then
            !lastMember = !rpath.mcount
          else
            !lastMember = !extgeos.last().sequ
          endif

          new rpath copy attributes of $!rpath
          copy members $!firstMember to $!lastMember of $!rpath

        endif

      endif

      !!ce = !copiedCable

   enddo

   -- Just report on any failed naming
   if (!count gt 0) then
     !!alert.message('Unable to name ' & !count.string() & ' copied Cables')
   endif

   -- check fill level with copies
   !exceeded = !!cblFillLevelCheckOnCable(!originalCable)
   if (!exceeded.empty().not()) then
  	!cwbran = object ARRAY()
  	do !element values !exceeded
	 		if (!element.type eq 'CWBRAN') then
	 			!cwbran.append(!element)
	 		endif
 		enddo

  	!extractName = object BLOCK('!cwbran[!Evalindex].name')
		!names = !cwbran.evaluate(!extractName)
		!name = ' '
		do !element values !names
	 			!name = !name & !element & ', '
 		enddo
	  !!alert.warning('Copied cables exceed fill level on:'& !name &' Use undo to remove copies.')
   endif

   !this.cableCopyCableName.val = ''

   !!ce = !originalCable

   return true

endmethod

------------------------------------------------------------------------
--
-- Method: dismiss
--
-- Description: dismiss the cable form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dismiss()

  unmark all
  !this.ceAuto.visible              = true
  !this.cableCopyCableName.visible  = true
  !this.hide()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: validateOldName
--
-- Description: validate an existing (old) cable name and type
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateOldName(!gadget is GADGET, !type is STRING) is BOOLEAN

  !test = !!checkName(!gadget.val, |OLD|)

  if (!test.unset()) then
  	!gadget.val = !test
    return false
  endif

  !element = object DBREF(!test)

  if (!element.type.neq(!type)) then
    !!alert.warning('This is not the correct type of element to copy.  Please enter the name of a $!type Element.')
    return false
  endif

  return true

endmethod

------------------------------------------------------------------------
--
-- Method: validateNewName
--
-- Description: validate a new name to check it is allowed not type specific
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateNewName(!gadget is GADGET, !dummyString is STRING) is BOOLEAN

  !test = !!checkName(!gadget.val, |NEW|)

  if (!test.unset()) then
    !gadget.val = ''
    return false
  endif

  return true

endmethod

------------------------------------------------------------------------
--
-- Method: NumberOfCopies
--
-- Description:  if the number of copies is greater than one, the autoname text gadget and button should be inactive
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .numberOfCopies()

  if( !this.numberOfCabCopies.val gt 1 ) then
     !this.ceAuto.visible              = false
     !this.cableCopyCableName.visible  = false
  else
     !this.ceAuto.visible              = true
     !this.cableCopyCableName.visible  = true
     !this.cableCopiedCableTag.visible = true
  endif

endmethod

-----------------------------------------------------------------------
--
-- Method: getSpref()
--
-- Description: Get the specification to the new cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getSpref(!spec is GADGET, !specCopyToggle is GADGET)

  if (!specCopyToggle.val) then
    !cableElement = !this.currentElement.spref
    if !cableElement.set() then
       !specCopyToggle.active = true
       !spec.val = !cableElement.name
    else
       !specCopyToggle.active = false
       !spec.val    = 'unset'
       return
    endif
  endif

endmethod
-----------------------------------------------------------------------
--
-- Method: getStartReference()
--
-- Description: Get Staref of cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getStartReference()

  if (!this.copyStaref.val) then
    !cableStaref = !this.currentElement.staref
    if (!cableStaref.set()) then
      !this.copyStaref.active = true
      !this.cableStaref.val   = !cableStaref.name
    else
      !this.copyStaref.active = false
      !this.cableStaref.val   = 'unset'
      return
    endif
  endif

endmethod
-----------------------------------------------------------------------
--
-- Method: getEndReference()
--
-- Description: Get Endref of cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getEndReference()

  if (!this.copyEndref.val) then
    !cableEndref = !this.currentElement.endref
    if (!cableEndref.set()) then
      !this.copyEndref.active = true
      !this.cableEndref.val   = !cableEndref.name
    else
      !this.copyEndref.active = false
      !this.cableEndref.val   = 'unset'
      return
    endif
  endif

endmethod
-----------------------------------------------------------------------
--
-- Method: checkRoutingPath()
--
-- Description: Disable correct routing toggles on current Element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .checkRoutingPath()

  !rpath = !!dtbMemberOfType(!this.currentElement, 'RPATH' , 1)

  if (!rpath.unset()) then
    !this.cableRpath.val = false
    !this.cableRpath.active = false
    !this.head.val = false
    !this.tail.val = false
    !this.head.active = false
    !this.tail.active = false
  else
    !extGeo = !!dtbMemberOfType(!rpath, 'EXTGEO' , 1)
    !pointr = !!dtbMemberOfType(!rpath, 'POINTR' , 1)
    if (!extGeo.set()) then
      !this.cableRpath.val = true
      !this.cableRpath.active = true
      !this.head.val = true
      !this.tail.val = true
      !this.head.active = true
      !this.tail.active = true

      if (!pointr.unset()) then
        !this.cableRpath.val = true
        !this.cableRpath.active = true
        !this.head.val = false
        !this.tail.val = false
        !this.head.active = false
        !this.tail.active = false
      endif

    else
        !this.cableRpath.val = true
        !this.cableRpath.active = true
        !this.head.val = false
        !this.tail.val = false
        !this.head.active = false
        !this.tail.active = false
    endif
  endif


endmethod

-----------------------------------------------------------------------
--
-- Method: toggleRouting()
--
-- Description: toggle routing options
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
-----------------------------------------------------------------------
define method .toggleRouting()

  !rpath = !!dtbMemberOfType(!this.currentElement, 'RPATH' , 1)
  !pointr = !!dtbMemberOfType(!rpath, 'POINTR' , 1)
  !extGeo = !!dtbMemberOfType(!rpath, 'EXTGEO' , 1)
  if (!this.cableRpath.val and !extGeo.set()) then
    !this.head.val = true
    !this.tail.val = true
    !this.head.active = true
    !this.tail.active = true
    if (!pointr.unset()) then
      !this.head.val = false
      !this.tail.val = false
      !this.head.active = false
      !this.tail.active = false
    endif
  else
    !this.head.val = false
    !this.tail.val = false
    !this.head.active = false
    !this.tail.active = false
  endif

endmethod
-----------------------------------------------------------------------
--
-- Method: setCableStatus()
--
-- Description: copy cable status depending on which attributes are to be copied
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
-----------------------------------------------------------------------
define method .setCableStatus()

  -- Cable Status
  -- 0 = 'Un-routed'
  -- 1 = 'Routed'
  -- 2 = 'Routing Failed'
  -- 3 = 'Partially Routed'
  -- 4 = 'Partially Failed'
  -- 5 = 'Manually Routed'

  if (!this.copyStaref.val and !this.copyEndref.val) then
    if (!this.cableRpath.val eq false) then
      CBSTA 0
    elseif (!this.cableRpath.val and !this.head.val and !this.tail.val eq false) then
      CBSTA 3
    elseif (!this.cableRpath.val and !this.tail.val and !this.head.val eq false) then
      CBSTA 3
    else
      CBSTA $!!cableStatus
    endif
  elseif (!this.cableRpath.val eq false) then
    CBSTA 0
  else
    CBSTA 3
  endif

endmethod
