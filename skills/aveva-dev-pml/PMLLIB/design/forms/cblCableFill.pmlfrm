------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cblCableFill()                   -
--  dataGridOnPopup(ARRAY)           -
--  dataGridOnPopupActive(BOOLEAN)   -                   Set .net Pop-up Active Control
--  initialise()                     -
--  loadGrid()                       -
--  loadRoutes()                     -
--  routeAfterSelectCallback(ARRAY)  -
--  routeGridAfterSelectCallback(ARRAY) -
--  setCellImage(REAL,REAL,STRING)   -
--
import 'GridControl'
handle any
endhandle


--- form definition
setup form !!cblCableFill dialog docking right

   using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle = 'Cable Fill Data'
  !this.iconTitle = 'Cable Fill'
  !this.initcall  = '!this.initialise()'

   -- define Cable  PML Frame

	button .pmlFill anchor t+l at xmin+.2 tooltip 'Refresh Routes' call '!this.loadRoutes()' pixmap width 16 height 16
 	frame .gridFrame panel anchor all at xmin-.2 ymax height 20 width 40
    -- define PML Container to host the Grid control
		container .cableFrame nobox PMLNetCONTROL 'NET'  DOCK FILL
 	exit

  -- define RouteGrid popup menu
  menu .popupMenu popup
  !this.popupMenu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.routeGrid, ||, |Save As|)', 'EXCEL' )
  !this.popupMenu.add( 'callback', 'Print Preview...', '!this.routeGrid.printpreview()', 'PRINT' )



   --Form Members
   member .routeGrid is NETGRIDCONTROL
   member .cwsegs          is ARRAY
   member .myArrayOfDbrefs is ARRAY
   member .myNewValue is STRING
   !this.myNewValue = 'Test Value'


exit
-- End of form definition


------------------------------------------------------------------------
--
-- Method:   cblCableFill()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblCableFill()

   using namespace 'Aveva.Pdms.Presentation'
	
	-- Load Icons
	!this.pmlFill.addPixmap(!!pml.getPathName('refresh16.png'))
	
   -- create instance of Grid control
   !this.routeGrid = object NETGRIDCONTROL()

   -- add PML event handlers to Grid control
   !this.routeGrid.addeventhandler('OnPopup', !this, 'dataGridOnPopup')
   !this.routeGrid.addeventhandler('AfterSelectChange', !this, 'RouteGridAfterSelectCallback')

   -- add Grid control to PML container
   !this.cableFrame.control = !this.routeGrid.handle()


endmethod
-- End of method definition



------------------------------------------------------------------------
--
-- Method:   initialise()
--
-- Description: initialise method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !this.routeGrid.editableGrid(FALSE)
  !this.routeGrid.columnExcelFilter(TRUE)
  !this.routeGrid.outlookGroupStyle(FALSE)
  !this.routeGrid.fixedHeaders(FALSE)
  !this.routeGrid.fixedRows(FALSE)
  !this.routeGrid.errorIcon(TRUE)
  !this.routeGrid.updates(FALSE)

  !this.loadRoutes()


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   loadRoutes()
--
-- Description: loadRoutes method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadRoutes()

  --Collect Route Paths
  !collCwseg   = object COLLECTION()
  !collCwseg.type('CWSEG')
  !collCwseg.scope(SITE)
  --!express    = object EXPRESSION('mem count gt (0) ')
  --!collCwseg.filter(!express)
  !results = !collCwseg.results()

  !this.cwsegs = !results
  !evalNames = object BLOCK('!this.cwsegs[!evalIndex].ref.string()')
  !cwsegNames = !this.cwsegs.evaluate(!evalNames)

  !rHeadings = ARRAY()
  !rHeadings.append('Name')
  !rHeadings.append('Type')
  !rHeadings.append('Desc')


  !gridRoutes = 'Routes'
  using namespace  'Aveva.Pdms.Presentation'
  !rts = object NETDATASOURCE(!gridRoutes, !rHeadings, !cwsegNames)
  !this.routeGrid.bindToDataSource(!rts)


endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:   loadGrid()
--
-- Description: Update grid method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadGrid()

--$p to be completed

return
  !rows = !this.routeGrid.getRows()

  do !rowindex indices !rows
    do !cols indices !rows[!rowindex]
      if !rows[!rowindex][!cols].eq('Nulref')  then
        !this.setCellImage(!rowindex, !cols, 'ERROR' )
      elseif !rows[!rowindex][!cols].substring(1,1).eq('=')  then
        !this.setCellImage(!rowindex, !cols, 'FAIL' )
      else
        !this.setCellImage(!rowindex, !cols, 'VALID' )

      endif
    enddo
  enddo

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:   setCellImage
--
-- Description:
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCellImage(!row is REAL, !column is REAL , !mode is STRING)

   -- State lookup table
-- Before data processed:
--     VALID     New element - no errors found in input data
--     EXISTS    Existing element - no errors found in input data
--     ERROR     Error found in input data
-- After data processed:
--     SUCCESS   Row processed successfully
--     FAIL      Error occurred during processing
  !stateList[1] = 'VALID'
  !stateList[2] = 'EXISTS'
  !stateList[3] = 'ERROR'
  !stateList[4] = 'SUCCESS'
  !stateList[5] = 'FAIL'
  -- icon lookup table
  !icon[1]      = !!pml.getPathName('accept.png')
  !icon[2]      = !!pml.getPathName('elementmodify12.png')
  !icon[3]      = !!pml.getPathName('createproblem12.png')
  !icon[4]      = !!pml.getPathName('valid.png')
  !icon[5]      = !!pml.getPathName('failed12.png')

  -- set cell image
    !state = !mode
    if( !state.empty().not() ) then
      !iconIndex = !stateList.findfirst(!state)
      !this.routeGrid.setCellImage(!row,!column,!icon[!iconIndex])
    endif
endmethod
-- End of method definition

------------------------------------------------------------------------
define method .routeGridAfterSelectCallback(!a is ARRAY)


   !colour = !!gphsettings.colourdata.highlight.code
   handle ANY
    show !!gphsettings
    hide !!gphsettings
    !colour = !!gphsettings.colourdata.highlight.code
   endhandle

   unenhance all
   AID clear text all

   if !this.routeGrid.getselectedrows().size().eq(1) then
   -- Call back on row selection
     !cwsegRef =  !this.routeGrid.getselectedrows()[1][1].dbref()
     !!ce = !cwsegRef

   endif
endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .routeAfterSelectCallback(!a is ARRAY)
  --$p RouteAftercall
   if !this.routeGrid.getselectedrows().size().eq(1) then
   -- Call back on row selection
     !pathRef =  !this.routeGrid.getselectedrows()[1][1].dbref()
     !!ce = !pathRef
   endif
endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .dataGridOnPopup(!data is ARRAY)	
	
  !this.dataGridOnPopupActive(!this.routeGrid.getRows().size() gt 0)

  -- Show the Pop-up
	!this.cableFrame.popup = !this.popupMenu
  !this.cableFrame.showPopup(!data[0], !data[1])

endmethod
------------------------------------------------------------------------
define method .dataGridOnPopupActive(!active is BOOLEAN)

  !this.popupMenu.setFieldProperty('EXCEL' , 'active', !active)
  !this.popupMenu.setFieldProperty('PRINT' , 'active', !active)

endmethod
------------------------------------------------------------------------
