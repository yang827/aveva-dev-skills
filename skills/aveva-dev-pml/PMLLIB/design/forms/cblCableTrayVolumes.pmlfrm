-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addIclass(GADGET,STRING)         -                   adds the user interference class to gadget
--  cblCableTrayVolumes()            -
--  clearAids()                      -
--  connect(STRING)                  -
--  connectBranchPick()              -
--  connectBranches(ARRAY)           -
--  createModAtt(STRING,STRING)      -
--  createVolume()                   -
--  cwbranGridAfterSelectCallback(ARRAY) -
--  cwbranGridPopupCallback(ARRAY)   -
