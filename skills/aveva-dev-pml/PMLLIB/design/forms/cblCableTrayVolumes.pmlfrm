setup form !!cblCableTrayVolumes size 77 24 dialog docking

  import 'GridControl'
  handle any
    --handle all errors, in case its already been loaded
  endhandle

  using namespace 'Aveva.Pdms.Presentation'

  --Set the form title and the Initialisation Call
  !this.formTitle = 'Cable Tray Volumes'
  !this.initCall = '!this.initialise()'
  !this.quitCall = '!this.clearAids()'
  --Create a pop-up menu object
  !this.newMenu('trayGridPopup')
  !this.trayGridPopup.add('CALLBACK', 'Navigate', '!this.navigateToCETray()','navigatePopupName')
 -- !this.trayGridPopup.add('CALLBACK', 'Create Volumes', '!this.createVolume()')
  !this.trayGridPopup.add( 'CALLBACK', 'Highlight', '!this.highlightElement()' ,'highlighPopupName')
  !this.trayGridPopup.add( 'CALLBACK', 'Unhighlight', '!this.unHighLight()' ,'unhighlightPopupName')
  !this.trayGridPopup.add('CALLBACK', 'Export to Excel...', ' !!exportToExcel(!this.trayGrid, ||, |Save As|)','exportPopupName')
  !this.trayGridPopup.add('CALLBACK', 'Print Preview...', '!this.trayGrid.printPreview()','printPreviewPopupName')
  --Add new menu items here onwards
  -- define cwbran grid popup menu
  !this.newMenu('cwbranGridPopup')
  !this.cwbranGridPopup.add('CALLBACK', 'Navigate', '!this.navigateToCEBran()','navigateGridPopupName')
  !this.cwbranGridPopup.add('CALLBACK', 'Modify Attributes',|!!cblinit('Modify','CWBRAN','!!cblCway')| ,'modifyAttributesGridPopupName')
 -- !this.cwbranGridPopup.add('CALLBACK', 'Connect Branches' , '!!cblconnectbranches()')
  !this.cwbranGridPopup.add( 'CALLBACK', 'Highlight', '!this.highlightElement()','highlighGridPopupName' )
  !this.cwbranGridPopup.add( 'CALLBACK', 'Unhighlight', '!this.unHighLight()'  ,'unhighlightGridPopupName')
  !this.cwbranGridPopup.add('CALLBACK', 'Export to Excel...', ' !!exportToExcel(!this.cwbranGrid, ||, |Save As|)','exportGridPopupName')
  !this.cwbranGridPopup.add('CALLBACK', 'Print Preview...', '!this.cwbranGrid.printPreview()','printPreviewGridPopupName')
  --Main Body
  --button .ceButton 'Load Trays' call '!this.initialise()'

  path down
 --Frame to contain the tabs
  --frame .tabset TABSET 'tabset' at XMIN.CE anchor all
  frame .tabset TABSET 'tabset' at y0.1 anchor all
    -- Tab 1
  frame .trayList  'Cable Tray List' dock fill
    paragraph .message at x0.5 y0.8 width 15 lines 1
    -- specify /world /site / zone level.

    -- Specify the container that will hold the trayGrid control .NET gadget
    container .trayFrame NOBOX PMLNETCONTROL 'trayGrid' anchor all at xmin.message+0.1 ymax.message+0.5 width 75 height 20

   -- frame .zoneFrame panel anchor l  + b  at xmin.trayFrame ymax.trayFrame width 1
      paragraph .zoneSelect               anchor l  + b       at xmin            ymax-.2  text 'Storage Areas' width 12
      line .zoneLine                      anchor l + b        at xmin            ymax - 0.3 horiz width 30 height 0.5
      button .availZones linklabel 'Load Zones'        anchor l + b       at x0.3             ymax + 0.3 callback '!this.loadZones()' width 10
      option    .zoneList                 anchor l + b      at xmax.availZones   ymin.availZones   width 14
      button .branCreate tooltip 'Create Volumes' pixmap anchor l + b at xmin.availZones + 0.3  ymax + 2 callback '!this.createVolume()' width 12 height 18
      path right
      button .volumeCreate linklabel 'Create Volumes' anchor l + b callback '!this.createVolume()'
      button .associcon  tooltip 'Show Association Manager' pixmap anchor l + b at xmin.branCreate ymax + 0.2 callback '!this.showAssoc()' width 16 height 16
      button .assocManager linklabel 'Show Association Manager' anchor l + b at xmin.volumeCreate callback '!this.showAssoc()'

 --   frame .attributes panel anchor l + b + r  at xmax + 0.6 ymin
      paragraph .branchAttributes            anchor l + b + r   at xmax.zoneLine + 1  ymax.zoneSelect - 1  text 'Set Cableway Branch Attributes' width 20
      button .reset linklabel 'Reset Fields' anchor b + r       at xmax + 10            ymin callback |!this.resetField()|     width 8
      line .attLine                          anchor l + b + r   at xmax.zoneLine           ymax.branchAttributes - 0.3 horiz width 43 height 0.5
      paragraph .cwbranDescTag               anchor l + b       at xmin.branchAttributes           ymax +0.3        text  'Description :      '
      text      .cwbranDesc                  anchor l + r + b   at xmax                 ymin     callback ''                   width 18 is STRING
      paragraph .cwbranFuncTag               anchor l + b       at xmin.cwbranDescTag   ymax     text  'Function :         '
      text      .cwbranFunc                  anchor l + r + b   at xmax                 ymin     callback ''                   width 18 is STRING
      paragraph .cwbranPurpTag               anchor l + b       at xmin.cwbranFuncTag   ymax     text  'Purpose :          '
      text      .cwbranPurp                  anchor l + r + b   at xmax                 ymin     callback ''                   width 18 is STRING
      paragraph .cwbranCexsTag               anchor l + b       at xmin.cwbranPurpTag   ymax     text  'Cable Excess (%) : '
      text      .cwbranCexs                  anchor l + r + b   at xmax                 ymin     callback ''                   width 18 is REAL
      paragraph .cwbranMaxfilTag             anchor l + b       at xmin.cwbranCexsTag   ymax     text  'Maximum Fill (%) : '
      text      .cwbranMaxfil                anchor l + r + b   at xmax                 ymin     callback ''                   width 18 is REAL

      paragraph .cwbranHeight             anchor l  + b       at xmin.cwbranMaxfilTag             ymax   text  'Height :           '
      text      .cwbranHei                anchor l + r + b   at xmax         ymin     callback '!!gdgtDatChk(!this.cwbranHei)' width 18 is REAL format !!distanceFmt
  --  exit
        --
      frame .bradFrame  'Bend Radius'     anchor l + b + r    at xmin.cwbranHeight+0.1          ymax-0.1   width 43
      	rtoggle .autoRad                  |Auto|   tagwidth 4 anchor l     at x1   ymax
      	rtoggle .manualRad								|Manual| tagwidth 5 anchor l     at xmax +1   ymin       	
      	text      .brad                   anchor l + r + b    at xmin.cwbranHei         ymin     callback '!!gdgtDatChk(!this.brad)'  width 6 is REAL  format !!distanceFmt
        option .bradType                  anchor r + b    at xmax + 0.2        ymin    width 8.8
      exit
      --
      frame .iclassFrame 'Interference'  anchor l + b + r at xmin+0.1   ymax-0.1 width 43
        rtoggle   .cwbranRllogicalTag       'Cable Route Rule:'anchor l+t       at x1  ymax
        rtoggle   .cwbranIclassTag          'Standard Iclass:' tagwidth 12 anchor l+t       at xmin  ymax
        text      .cwbranRllogical          anchor l+r+b       at xmin.cwbranHei ymin.cwbranRllogicalTag     callback '!this.validateRule()' width 18 is STRING
        combobox  .cwbranIclass             anchor l+r+b       at xmin.cwbranHei         ymin.cwbranIclassTag     callback '!this.addIclass('  width 12
        button    .iclassLoad   linklabel 'Load' anchor r+b  at xmax +0.2          ymin     callback  '!this.loadIclass()' width 4 tooltip 'Load standard Interference codes from Properties DB'
      exit

      line .separator                       anchor l + b       at xmin.branchAttributes -1 ymax.branchAttributes - 1   vertical hei 12.5
      toggle .track 'Track CE' at xmax.trayFrame - size y0.2 anchor t+r
      frame .levelToggle 'Select Level' anchor t + r  at xmin.track -27 ymin.track -0.2 width 4
        rtoggle   .worldLevel       'World' anchor l + t + r       at xmin + 0.5  ymin callback '!this.setLevel(|WORLD|)'
        rtoggle   .siteLevel        'Site'  anchor l + t + r       at xmax + 0.1  ymin callback '!this.setLevel(|SITE|)'
        rtoggle   .zoneLevel        'Zone'  anchor l + t + r       at xmax + 0.1  ymin callback '!this.setLevel(|ZONE|)'
      exit

  exit

  --Tab 2
  frame .branList  'Cableway Branch List' at 0 0 dock fill
    path down
    paragraph .messageBranch at x0 y0 width 20 lines 1
    -- Specify the container that will hold the grid control .NET gadget
    container .branFrame NOBOX PMLNETCONTROL 'cwbranGrid' at xmin.messageBranch +0.1 anchor all width 75 height 22
    -- Draw line below the grid
   -- line .underline at xmin.messageBranch +0.1 anchor b + l + r horiz width 75
    --
    --frame .connTasks panel at xmin ymax anchor l + b  width 1
      para .branConn at xmin ymax anchor l + b pixmap  width 18 height 20
      paragraph .taskCreation at xmax.branConn + 1 ymin.branConn anchor l + b  text 'Branch Connection Tasks..' width 18
      line .underline at xmin.branConn ymin.branConn + 0.8  anchor b + l  horiz wid 24 height 0.5
     -- button .hconn tooltip 'Head Connect' pixmap at xmin  ymin + 0.3 anchor l + b callback '!this.connectHead()' width 16 height 20
      button .hconn1 linklabel 'Extend/Connect Branch Head' at xmin + 0.4 ymin + 0.3 anchor l + b callback '!this.connect(|HEAD|)' width 18

    --  button .tconn tooltip 'Tail Connect' pixmap at xmin.hconn ymax.hconn anchor l + b callback '!this.identifyBran()' width 16 height 20
      button .tconn1 linklabel 'Extend/Connect Branch Tail' at xmin ymin + 1 anchor l + b callback '!this.connect(|TAIL|)' width 18
      --

      button .branConn1 linklabel 'Connect Branches' at xmin ymin + 1 anchor l + b callback '!this.connect(|CONNECT|)' width 16
      --
     -- button .branDisconn tooltip 'Disconnect Branches' pixmap at xmin.branConn ymax.branConn anchor l + b callback !this.connect(|HEAD|) width 18 height 20
      button .branDisconn1 linklabel 'Disconnect Branches' at xmin ymin + 1 anchor l + b callback '!this.connect(|DISCONNECT|)' width 16
      button .showConnTag linklabel at xmin ymin + 1 anchor l + b callback '!this.showHideUnconnected()' width 16
      --

   -- exit
    line .separator2 at xmax.underline   ymin.underline - 1  anchor l + b vertical hei 6.5

   -- frame .modTasks panel at xmax.connTasks + 1 ymin.connTasks anchor l + b width 1
      para .branModAtt  at xmax.underline + 0.1 ymax.underline - 1.3 anchor l + b pixmap  width 16 height 20
      paragraph .taskMod at xmax + 1 ymin  anchor l + b text 'Branch Modification Tasks..' width 20
      line .modUnderLine at xmax.underline -0.1 ymin.underline  anchor b + l  horiz wid 26  height 0.5

      button .branModAtt1 linklabel 'Modify Branch Attributes'              at xmin + 0.4 ymin + 0.3 anchor l + b callback |!this.createModAtt('MODIFY', 'CWBRAN')| width 16
      --
      button .branRpoint  linklabel 'Create/Modify Route Points'            at xmin       ymin + 1   anchor l + b callback |!this.createModAtt('CREATE', 'POINTR')| width 18

      button .branRatta   linklabel 'Create/Modify Route Attachment Points' at xmin       ymin + 1   anchor l + b callback |!this.createModAtt('CREATE', 'RATTA')|  width 24

      button .branRnode   linklabel 'Create/Modify Route Nodes'             at xmin       ymin + 1   anchor l + b callback |!this.createModAtt('CREATE', 'RNODE')|  width 18


   -- exit

    line .spearator3 at xmax.modUnderLine  ymin.modUnderLine - 1 anchor l + b vertical hei 6.5

  --  frame .deleteTasks panel at xmax.modTasks + 1 ymin.modTasks anchor l + b width 1
      para .delCwbran at xmax.modUnderLine + 0.1 ymax.modUnderLine - 1.3 anchor l + b  pixmap width 16 height 20
      paragraph .deleteNote at xmax + 1 ymin anchor l + b text 'Delete Elements..'width 12 lines 1
      line .deleteLine at xmax.modUnderLine - 0.1 ymin.modUnderLine anchor l + b + r horiz wid 25 height 0.5
     button .deleteCwbran linklabel 'Delete Cableway Branch' at xmin + 0.4  ymin + 0.3  anchor l + b callback |!this.delete('CWBRAN')| width 16
     button .deleteCway linklabel 'Delete Owning Cableway' at xmin ymin + 1 anchor l + b callback |!this.delete('CWAY')| width 16
    --exit

    toggle .trackCE 'Track CE'at xmax.branList - size y0 anchor t+r

  exit
  exit

  button .ceButton linklabel 'Refresh Grid' at xmax - size y0 anchor t+r call '!this.initialise()' width 9
  para .ceIcon at xmin - 1.5 * size ymin-0.1 anchor t+r pixmap width 16 height 16
  !this.ceIcon.addPixmap(!!pml.getPathName(|refresh16.png|))
  --button .dismiss at xmax form - size ymax form anchor b+r cancel

  member .cwbranGrid            is NETGRIDCONTROL
  member .trayGrid              is NETGRIDCONTROL
  member .cwbm                  is CABLEWAYMANAGER
  member .elements              is ARRAY
  member .cableTray             is DBREF
  member .pointr                is DBREF
  member .trayArray             is ARRAY
  member .volumeList            is ARRAY
  member .pickedElementPos      is POSITION
  member .pickedelements        is ARRAY
  member .bool                  is BOOLEAN
  member .level                 is STRING
  member .connectionAidNumber   is REAL
  member .clearTag              is BOOLEAN
  member .dinter                is ARRAY
  member .levelcheck            is BOOLEAN
exit
----------------------------------------------------------------------------------------------------
--  CONSTRUCTOR method - runs at the time when the form is first loaded                           --
----------------------------------------------------------------------------------------------------
define method .cblCableTrayVolumes()
  !this.branList.callback = '!this.tabCallback('
  --Specify the namespace before using the .NET Gadget
  using namespace 'Aveva.Pdms.Presentation'
  if undefined(!!cbldflts) then
    pml reload form !!cbldflts
  endif
  -- Create an instance of the control
  !this.trayGrid = object NETGRIDCONTROL()
  !this.trayFrame.control = !this.trayGrid.handle()
  -- CWBRAN GRID INSTANCE
  !this.cwbranGrid = object NETGRIDCONTROL()
  !this.branFrame.control = !this.cwbranGrid.handle()
    -- Add any event handlers here
  !this.trayGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')
  !this.trayGrid.addeventhandler('afterSelectChange', !this, 'trayGridAfterSelectCallback')
  --add cwbran event handlers here
  !this.cwbranGrid.addeventhandler('OnPopup', !this, 'cwbranGridPopupCallback')
  !this.cwbranGrid.addeventhandler('afterSelectChange', !this, 'cwbranGridAfterSelectCallback')
  !this.branModAtt.addPixmap(!!pml.getPathName('cblcwbrmod16.png'))
  !this.branConn.addPixmap(!!pml.getPathName('branchconn16.png'))
  !this.delCwbran.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.branCreate.addPixmap(!!pml.getPathName('create.png'))
  !this.associcon.addPixmap(!!pml.getPathName('assoc16.png'))
  !this.cwbranCexs.val       = !!cbldflts.cwbranCexs
  !this.cwbranMaxfil.val     = !!cbldflts.cwbranMaxfil
  !this.cwbranHei.val        = !!cbldflts.cwbranVHeight
  !this.brad.val             = 0 mm
  !this.message.val = 'Select Cabletray(s)'
  !this.messageBranch.val = 'Select a Cableway Branch'
  !this.branchAttributes.val = 'Set Cableway Branch Attributes'
  !this.zoneLevel.val = TRUE
  !this.level = 'ZONE'
  !this.levelcheck = TRUE
  !this.connectionAidNumber       = !!aidNumbers.add('Connection')
  !this.clearTag = FALSE
  !this.cwbranRllogicalTag.val   = FALSE
  !this.cwbranIclassTag.val      = TRUE
  !this.manualRad.val            = FALSE
  !this.autoRad.val              = TRUE
  !this.showConnTag.tag = 'Show Unconnected'
  !this.dinter = !!cbldflts.cwbranIclass.dtext
  handle (2,751)
    !!alert.error('Cabling System Application not loaded. Please load Cabling System Application')
    return
  endhandle

  !radType[1]           = 'Inner Radius'
  !radType[2]           = 'Centreline Radius'
  !this.bradType.dtext    = !radType

  !radTypeR[1]          = 'IN'
  !radTypeR[2]          = 'CEN'
  !this.bradType.rtext    = !radTypeR
  !this.bradType.val      = 1

  !this.cwbranIclass.dtext = !this.dinter
  !this.cwbranIclass.select('DTEXT',!!cbldflts.cwbranIclass.selection())
  handle ANY
    !this.cwbranIclass.select('DTEXT','unset')
  endhandle

    -- frame callback
  !this.iclassFrame.callback = '!this.updateFrame()'
  !this.bradFrame.callback = |!this.radiusSelect()|
  !this.updateFrame()
  !this.radiusSelect()

endmethod
----------------------------------------------------------------------------------------------------
--  Initialise method - runs every time the form is shown to the user                              --
----------------------------------------------------------------------------------------------------
define method .initialise()

  -- Specify the namespace before using the .NET gadget
  using namespace 'Aveva.Pdms.Presentation'
  !this.loadTrays()
  !this.bool = FALSE
  -- Set trayGrid parameters
  !this.trayGrid.columnExcelFilter(FALSE)
  !this.trayGrid.setNameColumnImage()
  !this.trayGrid.outlookGroupStyle(FALSE)
  !this.trayGrid.fixedHeaders(TRUE)
  !this.trayGrid.fixedRows(FALSE)
  !this.trayGrid.columnSummaries(TRUE)
  !this.trayGrid.autoFitColumns()
  !this.trayGrid.editableGrid(FALSE)
  !this.trayGrid.errorIcon(TRUE)
  !this.trayGrid.displayNulrefAs('Unset')
    -- Set cwbranGrid parameters
  !this.cwbranGrid.columnExcelFilter(TRUE)
  !this.cwbranGrid.setNameColumnImage()
  !this.cwbranGrid.outlookGroupStyle(TRUE)
  !this.cwbranGrid.fixedHeaders(FALSE)
  !this.cwbranGrid.fixedRows(FALSE)
  !this.cwbranGrid.columnSummaries(TRUE)
  !this.cwbranGrid.autoFitColumns()
  !this.cwbranGrid.editableGrid(FALSE)
  !this.cwbranGrid.errorIcon(TRUE)
  !this.cwbranGrid.displayNulrefAs('Unset')
  !this.cwbranGrid.singleRowSelection(TRUE)

  !this.cwbranCexs.val       = !!cbldflts.cwbranCexs
  !this.cwbranMaxfil.val     = !!cbldflts.cwbranMaxfil
  !this.cwbranHei.val        = !!cbldflts.cwbranVHeight


  !this.dinter = !!cbldflts.cwbranIclass.dtext
  handle (2,751)
    !!alert.error('Cabling System Application not loaded. Please load Cabling System Application')
    return
  endhandle
  !this.cwbranIclass.dtext = !this.dinter
  !this.cwbranIclass.select('DTEXT',!!cbldflts.cwbranIclass.selection())
  handle ANY
    !this.cwbranIclass.select('DTEXT','unset')
  endhandle

endmethod
---------------------------------------------------------------------------------------------------
-- method .tabCallback (GADGET, STRING) - event driven method executed when tabs are switched   --
---------------------------------------------------------------------------------------------------
define method .tabCallback (!dummyFrame is GADGET, !event is STRING)

  if (!event eq 'SHOWN') then
    !array = object ARRAY()
    do !volumes values !this.volumeList
      !array.append(!volumes.string())
    enddo
    !headings = 'Name Asscia Hcref Tcref'
    !titles = 'Name Associated-Cabletray Head-Connection Tail-Connection'
    using namespace  'Aveva.Pdms.Presentation'
    !nds = object NETDATASOURCE('Branch Grid', !headings.split(), !titles.split() ,!array)
    !this.cwbranGrid.bindToDataSource(!nds)
    !this.cwbranGrid.autoFitColumns()
   endif

endmethod
---------------------------------------------------------------------------------------------------
-- method .loadTrays() --this method reads the content of file with saved tray and branch data, fetches
--                       new trays and populates a list.
---------------------------------------------------------------------------------------------------
define method .loadTrays()

  !headings = 'Name Pspec Href Tref'
  !titles = 'Name Pipe-Spec Head-Connection Tail-Connection'
  using namespace  'Aveva.Pdms.Presentation'
  !this.trayGrid.resetColumnProperties()
  !bran = object ARRAY()
  if (!this.level.eq('WORLD')) then
   	var !bran collect all BRAN with stext of text1 of pspec EQ 'TRAY'
  else
   	var !bran collect all BRAN with stext of text1 of pspec EQ 'TRAY' for $!this.level
  handle ANY
    !!alert.error('Be at a level on or below $!this.level .')
    return
  endhandle

  endif
  !this.trayArray.clear()
  do !val values !bran
    !this.trayArray.append(!val.dbref())
  enddo
  !nds = object NETDATASOURCE('Volume Prototype', !headings.split(), !titles.split() , !bran)
  !this.trayGrid.bindToDataSource(!nds)
  !this.tabCallback(!this.ceButton , 'SHOWN')
  !this.volumeList.clear()
  !this.setCellImage()


endmethod
---------------------------------------------------------------------------------
-- Method .rightClickGrid(ARRAY) - run when the user right clicks on the trayGrid  --
---------------------------------------------------------------------------------
define method .rightClickGrid(!data is ARRAY)

  if (!this.trayGrid.getRows().size() eq 0 or !this.trayGrid.getSelectedRows().empty()) then
    !this.trayGridPopup.setFieldProperty('navigatePopupName','ACTIVE',FALSE)
    !this.trayGridPopup.setFieldProperty('highlighPopupName','ACTIVE',FALSE)
    !this.trayGridPopup.setFieldProperty('unhighlightPopupName','ACTIVE',FALSE)
    !this.trayGridPopup.setFieldProperty('exportPopupName','ACTIVE',FALSE)
    !this.trayGridPopup.setFieldProperty('printPreviewPopupName','ACTIVE',FALSE)
  else
    !this.trayGridPopup.setFieldProperty('navigatePopupName','ACTIVE',TRUE)
    !this.trayGridPopup.setFieldProperty('highlighPopupName','ACTIVE',TRUE)
    !this.trayGridPopup.setFieldProperty('unhighlightPopupName','ACTIVE',TRUE)
    !this.trayGridPopup.setFieldProperty('exportPopupName','ACTIVE',TRUE)
    !this.trayGridPopup.setFieldProperty('printPreviewPopupName','ACTIVE',TRUE)
  endif

  !this.trayFrame.popup = !this.trayGridPopup
  !this.trayFrame.showPopup(!data[0], !data[1])
  if (!data.size() gt 2) then
    !this.elements = !data[2]
  endif
endmethod
-------------------------------------------------------------------------------
-- Method .cwbranGridPopupCallback(ARRAY) - run when the user right clicks on the branGrid --
---------------------------------------------------------------------------------
define method .cwbranGridPopupCallback(!data is ARRAY)

  if (!this.cwbranGrid.getRows().size() eq 0 or !this.cwbranGrid.getSelectedRows().empty()) then
    !this.cwbranGridPopup.setFieldProperty('navigateGridPopupName','ACTIVE',FALSE)
    !this.cwbranGridPopup.setFieldProperty('modifyAttributesGridPopupName','ACTIVE',FALSE)
    !this.cwbranGridPopup.setFieldProperty('highlighGridPopupName','ACTIVE',FALSE )
    !this.cwbranGridPopup.setFieldProperty('unhighlightGridPopupName','ACTIVE',FALSE)
    !this.cwbranGridPopup.setFieldProperty('exportGridPopupName','ACTIVE',FALSE)
    !this.cwbranGridPopup.setFieldProperty('printPreviewGridPopupName','ACTIVE',FALSE)
  else
    !this.cwbranGridPopup.setFieldProperty('navigateGridPopupName','ACTIVE',TRUE)
    !this.cwbranGridPopup.setFieldProperty('modifyAttributesGridPopupName','ACTIVE',TRUE)
    !this.cwbranGridPopup.setFieldProperty('highlighGridPopupName','ACTIVE',TRUE )
    !this.cwbranGridPopup.setFieldProperty('unhighlightGridPopupName','ACTIVE',TRUE)
    !this.cwbranGridPopup.setFieldProperty('exportGridPopupName','ACTIVE',TRUE)
    !this.cwbranGridPopup.setFieldProperty('printPreviewGridPopupName','ACTIVE',TRUE)
  endif

  !this.branFrame.popup = !this.cwbranGridPopup
  !this.branFrame.showPopup(!data[0], !data[1])
  if (!data.size() gt 2) then
    !this.elements = !data[2]
  endif

endmethod
--------------------------------------------------------------------------------
-- Method .navigateToCETray(ARRAY)- navigate to CE callback for tray grid
--------------------------------------------------------------------------------
define method .navigateToCETray()

  if (!this.trayGrid.getSelectedRows().size().eq(1)) then
    !trayRef = !this.trayGrid.getSelectedRows()[1][1].dbref()
    !!ce = !trayRef

  endif
endmethod
--------------------------------------------------------------------------------
-- Method .navigateToCEBran(ARRAY)- navigate to CE callback for branch grid
--------------------------------------------------------------------------------
define method .navigateToCEBran()

  if (!this.cwbranGrid.getSelectedRows().size().eq(1)) then
    !branRef = !this.cwbranGrid.getSelectedRows()[1][1].dbref()
    !!ce = !branRef

  endif
endmethod
--------------------------------------------------------------------------------
-- Method .trayGridAfterSelectCallback(ARRAY) Tracks CE if the toggle is true
--------------------------------------------------------------------------------
define method .trayGridAfterSelectCallback(!data is ARRAY)

  if (!this.track.val) then
    !this.navigateToCETray()
  endif

endmethod

--------------------------------------------------------------------------------
-- Method .cwbranGridAfterSelectCallback(ARRAY) Tracks CE if the toggle is true
--------------------------------------------------------------------------------
define method .cwbranGridAfterSelectCallback(!data is ARRAY)

  if (!this.trackCE.val) then
    !this.navigateToCEBran()
  endif

endmethod

-----------------------------------------------------------------------------
-- Method .createVolume() - callback for creating cableway volumes
-----------------------------------------------------------------------------
define method .createVolume()
  !assogpLocation = !this.findASSOGP()
  if ( UNSET ( !assogpLocation )) then
     !!alert.error('Cannot find association group to create association. Please create association group with purpose TBAS')
     show !!assbrowser
     return
  endif
  !list = !this.trayGrid.getSelectedRows()

  if (!list.size().gt(0)) then
    --alert to ask user if they want to continue
    !answer = !!alert.confirm('Create Cableway Volumes for Selected Cabletray Branches?')

    if !answer.neq('YES') then
      return
    endif

  -- for each selected tray di the following
    do !value values !list
      -- Mark database
      !bool = FALSE
      !fillbool = FALSE
      !undo = object UNDOABLE()
      !undo.description('Create Branches')
      !undo.add()
      !this.cableTray = !value[1].dbref()
      if (!this.cableTray.assos.set()) then
        !associations = !this.cableTray.assos
        do !asso values !associations
          if (!asso.testev.not())then
            !!alert.warning('Cabletray $!this.cableTray.flnm has association(s) which are invalid, please review associations in Association Manager.')
            break
          endif
        enddo
      endif

      !bool = !this.evaluate(!this.cableTray)

      if (!bool) then
        !!alert.error('Cableway Volume already exists for $!this.cableTray.flnm')
      skip
      endif
      !fcheck = !this.fillCheck(!this.cableTray)
      if (!fcheck) then
     -- WRITE 'Cabletray $!this.cableTray.flnm is not filled. Tray will now be automatically filled and unfilled for conversion to continue.'
      --skip
     -- !fillbool = TRUE
     -- !this.fill(!this.cableTray)
      endif
     !unusedIndex = !this.trayArray.findfirst(!this.cableTray)
      -- navigate to appropriate area for creating cableways
      !text=  !this.zoneList.displayText()
      if (!text eq '' )then
        if !!cbldflts.cwayzonedefault.set() then
          !!ce = !!cbldflts.cwayzonedefault
        else
          !!ce = !this.cableTray.owner
        endif
      else
        $!text
      endif
      --check for any width changes in the tray and use the returned array to create volumes
      !memberList= !this.sortBranches()
      handle (2,766)
        return
      endhandle
      !tempArray = object ARRAY()
      -- Create CWAY and CWAYBRAN elements
      NEW CWAY
      !cway = !!ce
      if (!this.cableTray.isnamed) then
        !cway.name = '/CW'+ !this.cableTray.flnm
      else
        -- the tray branch name contains spaces i.e. branch name is unset.
        -- assign branch dbref as a string
        !dbrefString = !this.cableTray.refno.string()
        !cway.name = '/CW' + !dbrefString
      endif

      -- Volumes for this tray already exist.
      PURP CABL
        -- for each width array of tray width do the following
      do !member indices !memberList
        --Create CWBRAN
        !elementArray = !memberList[!member]
        if (!elementArray.size().eq(0)) then
        	skip
        endif
        NEW CWBRAN
        !cwbran = !!ce
       -- !cwbran.name = '/' & !!cblautoname('CWBRAN', !cway)
        !!autoNameCe(TRUE)
        --!cwbran.name = '/Branch' + '$!member' + '_of_' + !cway.flnm
        --Assign Vheight and maxFill
        !cwbran.desc    = !this.cwbranDesc.val
        !cwbran.func    = !this.cwbranFunc.val
        !cwbran.purp    = !this.cwbranPurp.val
        !cwbran.cexs    = !this.cwbranCexs.val
        !cwbran.maxfil  = !this.cwbranMaxfil.val
        !cwbran.vheight = !this.cwbranHei.val

        if (!this.manualRad.val) then
          !cwbran.brad = !this.brad.val.dbunits().value()
        endif

        -- extract the Vwidth from the leave bore of cableway branch
        if (!elementArray[1].lbore.lt(!elementArray[1].abore) and !elementArray.size().eq(1)) then
          !cwbran.vwidth  = !elementArray[1].lbore.real()
          !cwbran.pos = !elementArray[1].apos.wrt(worl)
        elseif (!elementArray[1].lbore.gt(!elementArray[1].abore) and !elementArray.size().eq(1)) then
          !cwbran.vwidth  = !elementArray[1].abore.real()
          !cwbran.pos = !elementArray[1].apos.wrt(worl)
        else
          !cwbran.vwidth  = !elementArray[1].lbore.real()
          !cwbran.pos = !elementArray[1].apos.wrt(worl)
        endif
        if (!this.cwbranRllogical.val eq |('')|) then
          RLLO unset
        else
          RLLO $!this.cwbranRllogical.val
        endif
        !cwbran.iclass = !this.cwbranIclass.selection()
        !tempArray.append(!cwbran)
        ----------------------------------------------------
        -- Create Associations for each branch and tray
        ----------------------------------------------------

        $!assogpLocation

        --- need to handle this as will need to create a new Assoc group if none is defined
        -- will also need to check if there is a dedicated assocworld available
        --NEW ASSOC copy def /trayBran
        NEW ASSOC
        !assoc = !!ce
        !assoc.name = '/Association' + !cwbran.flnm
        handle (41,12)
          do !i from 1 to 20
            !assoc.name = '/Association' + !cwbran.flnm + '($!i)'
            handle (41,12)
              skip
            elsehandle NONE
            break
            endhandle
          enddo
        endhandle
       !assoc.adefrf = /trayBran

        NEW RESTRIC
        !restric = !!ce
        !restric.lname = '/tray'

        NEW MBRMAP
        !mbrmap1 = !!ce
        !mbrmap1.lname = '/trayRef'
        !mbrmap1.amapnm = '/cableTray'

        NEW MBRMAP
        !mbrmap2 = !!ce
        !mbrmap2.lname = '/cwbranRef'
        !mbrmap2.amapnm = '/cablewaybranch'

        $!assoc
        NEW ASSMBR
        !assmbr1 = !!ce
        !assmbr1.lname = '/cableTray'
        !assmbr1.amemrf = !this.cableTray
        Posxpr ( ATTRIB HPOS of AMEMRF WRT WORLD  )
        Dirxpr ( ATTRIB hdir of AMEMRF WRT WORLD  )

        NEW ASSMBR
        !assmbr2 = !!ce
        !assmbr2.lname = '/cablewaybranch'
        !assmbr2.amemrf = !cwbran
        Posxpr ( ATTRIB HPOS of AMEMRF WRT WORLD  )
        Dirxpr ( ATTRIB hdir of AMEMRF WRT WORLD  )

        $!cwbran
        ---------------------------------------------------
        -- create branch members

        NEW RTFEAT
        NEW RNODE
        !rnode1 = !!ce
        RNTYPE TAKE
        !name = '/' & !!cblautoname('RNODE', !cwbran)
        name $!name
        handle ANY
        endhandle
        NEW RNODE
        !rnode2 = !!ce
        RNTYPE TAKE
        !name = '/' & !!cblautoname('RNODE', !cwbran)
        name $!name
        handle ANY
        endhandle
        $!cwbran
        NEW HATTA
        !unusedHatta = !!ce
        NEW TATTA
        !unusedTatta = !!ce
        NEW RPATH
        !rpath = !!ce
        !ydir = U WRT /*
        -- Assign the open tray direction of the first element to the rpath of the new branch
        ----------------- ADDED ON 09/07/2012-------------------
        if (!elementArray[1].type.eq(|TUBI|)) then
        	!ydir = P30 DIR of $!elementArray[2]
        	handle any
        		!!alert.warning('Cannot assign open direction to $!cwbran.flnn')
        	endhandle
        else
        !ydir = P30 DIR of $!elementArray[1]
        endif
        ---------------------------------------------------------
        !rpath.ydirection = !ydir
        -- assign head pos and tail pos attributes to the branch
        if (!elementArray[1].type inset (|TEE| , |CROS|)) then
        !tee4 = FALSE
          if (!elementArray[1].type.eq('TEE')) then
            if (!elementArray[1].arrive.eq(3)) then
              --Raise a flag
        	    !headPos = !elementArray[1].pos.wrt (worl)
              !tee4= TRUE
            endif	
          endif

          if (!tee4.not()) then
            if (!elementArray[1].leave inset (1 , 2)) then
        	    !headPos = !elementArray[1].apos.wrt (worl)
            else
        	    !headPos = !elementArray[1].pos.wrt (worl)
            endif
          endif
        else
        	!headPos = !elementArray[1].apos.wrt(worl)
        endif

        !tee5 = FALSE
        if (!elementArray[!elementArray.size()].type.eq('TEE')) then
          if (!elementArray[!elementArray.size()].arrive.eq(3)) then
          --Raise a flag
        		!tailPos = !elementArray[!elementArray.size()].pos.wrt (worl)
            !tee5= TRUE
          endif	
        endif
        if (!tee5.not()) then
          if (!elementArray[!elementArray.size()].type inset (|TEE| , |CROS|)) then
        	  if (!elementArray[!elementArray.size()].leave inset (1 , 2)) then
        		  !tailPos = !elementArray[!elementArray.size()].lpos.wrt (worl)
        	  else
        		  !tailPos = !elementArray[!elementArray.size()].pos.wrt (worl)
        	  endif
          else
        	  !tailPos = !elementArray[!elementArray.size()].lpos.wrt(worl)
          endif
        endif
        -------------Added on 09/07/2012
        if (!elementArray[!elementArray.size()].type.eq('TUBI')) then
        	!tailPos = !elementArray[!elementArray.size()].lpos.wrt(worl)
        endif	
        -------------------------

        --if the head or the tail is connected to a TEE or a CROSS
        if (!elementArray[1].type inset('ELBO' , 'BEND')) then
          !bendElement = !elementArray[1]
          !headPos = P30 pos of $!bendElement
        endif
        if (!this.cableTray.href.unset()) then
        else
          if (!this.cableTray.href.type inset('CROS', 'TEE')) then
            if (!member.eq(1)) then
            -- hpos is the position of the TEE or CROSS
              !headPos = !this.cableTray.href.pos
              !cwbran.pos = !headPos
            endif
          endif
        endif
        if (!this.cableTray.tref.unset()) then
        else
          if (!this.cableTray.tref.type inset ('CROS' , 'TEE')) then
            if (!member.eq(!memberList.size())) then
              -- tpos is the position of the TEE or CROSS
              !tailPos = !this.cableTray.tref.pos
            endif
          endif
        endif

        -- create POINTR at head and tail
        NEW POINTR
        !ref = !!ce
        !ref.position = !headPos
        !rnode1.posref = !ref
        !radius = 0
        NEW POINTR
        !!ce.position = !tailPos
        !rnode2.posref = !!ce

       -- Collect all bends in the branch
       -------------Added on 10/07/2012---------
       !bends = object ARRAY()
       do !val values !elementArray

         if (!val.type inset (|ELBO|, |BEND|)) then
         	 !bends.append(!val)
         endif

       enddo

   --Changed 06/09/2012 ------------------------------------------
   -- Define the shape of the RPATH according to the position of the bends
        !!ce = !ref
        do !bend indices !bends
          !bAngle = !bends[!bend].pos.angle(!bends[!bend].apos, !bends[!bend].lpos)
          if (!bAngle.neq(180)) then
            NEW POINTR
            !!ce.position = !bends[!bend].position
            !d1 = !bends[!bend].pdir[30]
            !d2 = !bends[!bend].pdir[31]
            if (!this.autoRad.val) then
              if (!bends[!bend].radius.eq(0)) then
                !line= !bends[!bend].apos.line(!bends[!bend].lpos)
                !length = !line.length()
                !angle =  180 - !bAngle
                !theta = (!angle) / 2
                !radius = ((!length * 0.5) / (SIN (!theta)))
                !!ce.frad = !radius - 1.5mm
              else
                if (!d1.angle(!d2) lt 2 ) then
                  if (!this.bradType.selection().eq('IN')) then
                    !!ce.frad = (!bends[!bend].radius) + (0.5 * (!cwbran.vwidth))
                  elseif(!this.bradType.selection().eq('CEN')) then
                    !!ce.frad = (!bends[!bend].radius)
                  endif
                else
                  !!ce.frad = !bends[!bend].radius
                endif
              endif
            else
              if (!d1.angle(!d2) lt 2) then
                if (!this.bradType.selection().eq('IN')) then
                  !!ce.frad = !this.brad.val + (0.5 * (!cwbran.vwidth))
                elseif(!this.bradType.selection().eq('CEN')) then
                  !!ce.frad = !this.brad.val
                endif
              else
                !!ce.frad = !this.brad.val
              endif
            endif
          endif
        enddo


        -- Collect all tees and crosses in the branch
        !teeColl = object COLLECTION()
        !teeColl.scope(!elementArray)
        !teeColl.addType('TEE')
        !teeColl.addType('CROS')
        !tees = !teeColl.results()
        -- Draw lines between all the POINTRs
        !rpoints = !rpath.members
        !segments = object ARRAY()
        do !i from 1 to !rpoints.size() - 1
          !segments[!i] = object LINE(!rpoints[!i].position,!rpoints[!i + 1].position)
        enddo
        -- Check where the tee/cross fits onto the rpath and what is its zdistance
        do !tee values !tees
        -- Where does the tee sit
          do !i indices !segments
            !refLength = object LINE(!segments[!i].startPosition, !tee.pos)
            if ( !segments[!i].length().gt(0).not()) then
              break
            endif
           if (!segments[!i].onprojected(!tee.pos) and !refLength.length().gt(!segments[!i].length()).not()) then
            !this.cwbm.createattachmentpoint(!cwbran, !tee.pos.wrt(worl))
            break
            endif
          enddo
        enddo
      enddo
      -- !this.connectBranches(!tempArray)
      -- Added 09/09/2010 Functionality to automatically try and connect newly created branches to the existing branches.
      !tarBranList = object ARRAY()
      if (!this.cableTray.href.unset().not()) then
        if ((!this.cableTray.href.type.eq('CROS')) or (!this.cableTray.href.type.eq('TEE'))) then
          !tarBranList.append(!this.cableTray.href.owner)
        else
          -- its connected to the head or tail.
          !tarBranList.append(!this.cableTray.href)
        endif
      endif
      if (!this.cableTray.tref.unset().not()) then
        if ((!this.cableTray.tref.type.eq('CROS')) or (!this.cableTray.tref.type.eq('TEE'))) then
          !tarBranList.append(!this.cableTray.tref.owner)
        else
          -- its connected to the head or tail.
          !tarBranList.append(!this.cableTray.tref)
        endif
      endif
      -- check to see if the branch members are connected to any branch
      !conColl = object COLLECTION()
      !conColl.scope(!this.cableTray)
      !conColl.addType('CROS')
      !conColl.addType('TEE')
      !collectedConnex = !conColl.results()
      do !conns values !collectedConnex
        if !conns.type.eq('CROS') then
          do !connections values !conns.crfarray
            if (!connections.unset().not()) then
              !tarBranList.append(!connections)
            endif
          enddo
        else
          if (!conns.cref.unset().not()) then
            !tarBranList.append(!conns.cref)
          endif
        endif
      enddo
      --check if there are any valid associated cableway branches.
      do !tbran values !tarBranList
        if (!tbran.asscia.unset().not()) then
         -- check if the array has valid reference elements.
          !assoArray = !tbran.asscia
          do !v values !assoArray
            if (!v.badref().not()) then
              !tempArray.append(!v)
            endif
          enddo
        endif
      enddo
      !finalArray = !tempArray.sortUnique()
      !this.connectBranches(!finalArray)
      !this.setCellImage()
      if (!fillbool) then
      	!this.unfill(!this.cableTray)
      endif
      !undo.endUndoable()
    enddo

  endif
  !this.resetField()
endmethod
------------------------------------------------------------------------------------------------------------
--Method .sortBranches() Callback for tray width check, Returns ARRAY of ARRAY of members with similar width
------------------------------------------------------------------------------------------------------------
define method .sortBranches() is ARRAY

 -- !members = !this.cableTray.members
  !branchArray = object ARRAY()
  !memberArray = object ARRAY()
  !col = object COLLECTION()
  !col.scope(!this.cableTray)
  !col.addType('REDU')
	!col.addType('TEE')
	!col.addType('CROS')
	!col.addType('ELBO')
	!col.addType('FTUB')
	!col.addType('BEND')
	!col.addType('TUBI')
	!members = !col.results()
  do !member values !members
  -- check if the member has physical dimensions (this should take care of ATTA's)
    if (!member.type inset (|REDU|, |BEND|, |ELBO|, |TEE|, |CROS|, |TUBI|, |FTUB|)) then
    !tempFlag = FALSE
    !sorted   = FALSE
    !teePresent = FALSE
    !tee3      = FALSE
    if (!member.type.eq(|REDU|)) then
      !line = object LINE()
      !line.startPosition = !member.apos
      !line.endPosition   = !member.lpos
      if (!line.direction().neq(!member.ldir)) then
        -- reducer type is not straight
        if (!memberArray.empty().not()) then
          !branchArray.append(!memberArray)
          !memberArray.clear()
        endif
        !memberArray.append(!member)
        !branchArray.append(!memberArray)
        !memberArray.clear()
        --Raise a flag
        !sorted = TRUE
      endif
    endif

    if (!member.type inset(|CROS| , |TEE|)) then
--changed on 14/12/2011

      if (!member.arrive.gt(4) or (!member.leave.gt(4)) or !member.arrive.lt(1) or !member.leave.lt(1)) then
        !!alert.error('Check Leave and Arrive points for $!member.flnn')
        return
      endif

      if (!member.type.eq('TEE')) then

        if (!member.arrive.gt(3) or (!member.leave.gt(3))) then
          !!alert.error('Check Leave and Arrive points for $!member.flnn')
          return
        endif

        if (!member.arrive.eq(3)) then
      	  !memberArray.append(!member)
        	!branchArray.append(!memberArray)
        	!memberArray.clear()
          --Raise a flag
          !teePresent= TRUE
          !tee3= TRUE
      	endif	
      endif
			if (!member.leave.eq(1) or !member.leave.eq(2) or (!tee3) ) then

      else
      -- branch needs to be cut at this point
    	  !memberArray.append(!member)
        !branchArray.append(!memberArray)
        !memberArray.clear()
        --Raise a flag
        !teePresent= TRUE
    	endif
    endif

    --- if the abore of the component is equal to lbore then add component to array, also if it has already not been sorted.
    if (!sorted.not() or !teePresent) then
      if (!member.abore.eq(!member.lbore)) then
        !memberArray.append(!member)
        -- else if the abore is greater than the lbore then append the branch array to add the elements
      elseif (!member.abore.gt(!member.lbore)) then
				if (!memberArray.empty().not()) then
				  !branchArray.append(!memberArray)
        endif
        !memberArray.clear()
        !memberArray.append(!member)
      else
        !memberArray.append(!member)
        !branchArray.append(!memberArray)
        !memberArray.clear()
        !tempFlag = TRUE
      endif
       -- if this member is the last member of the array then append the member array to branch array
      if (!members.findfirst(!member)eq(!members.size()) and (!tempFlag.not()) ) then
        !branchArray.append(!memberArray)
      endif
    endif
    endif
  enddo
  return !branchArray
endmethod
--------------------------------------------------------------------------------------
--Method .connectBranches(ARRAY) Callback for connecting branches
--------------------------------------------------------------------------------------
define method .connectBranches(!data is ARRAY)

  if (!data.size().gt(1)) then
    do !x indices !data
    -- connection matrix, first check if the branch already has any connections.
      if ((!data[!x].hcref.unset().not()) and (!data[!x].tcref.unset().not())) then
      else
        !firstBranch = !data[!x]
        do !y from 1 to !data.size()
          if (!x.neq(!y)) then
            !secondBranch =!data[!y]
            -- connect branches to each other
            !this.cwbm.connectBranches(!firstBranch, !secondBranch)
            handle any
            endhandle
              !this.cwbm.connectBranches(!secondBranch, !firstBranch)
            handle any
            endhandle
          endif
        enddo
      endif
    enddo
  endif
  !this.cwbranGrid.refreshTable()

endmethod
--------------------------------------------------------------------------------------
--Method .highlightElement(} method for highlighting elements in 3d world
--------------------------------------------------------------------------------------
define method .highlightElement()

  do !i from 1 to (!this.elements.size())
    !ref = object DBREF(!this.elements[!i])
    unenhance $!ref
    !colour = !!gphsettings.colourData.highlight.code
    handle ANY
      -- add magenta colour
    !colour = 16
    endhandle
    enhance $!ref colour $!colour
  enddo

endmethod
--------------------------------------------------------------------------------------
--Method .unHighLight(} method for unHighLighting elements in 3d world
--------------------------------------------------------------------------------------
define method .unHighLight()

  do !i from 1 to (!this.elements.size())
    !ref = object DBREF(!this.elements[!i])
    unEnhance $!ref
  enddo

endmethod
--------------------------------------------------------------------------------------
--Method .connectBranchPick(} method for connecting Branch Head/Tail to another branch
--------------------------------------------------------------------------------------
define method .connectBranchPick()

  !bran = !this.cwbranGrid.getSelectedRows()[1][1].dbref()
  !targetBran = !this.pointr.owner.owner
  if (!bran EQ !targetBran) then
    !!alert.error('Cannot connect Branch to itself')
    return
  endif
  !undo = object UNDOABLE()
  !undo.description('Connect Head/Tail')
  !undo.add()
  !this.cwbm.createattachmentpoint(!targetBran, !this.pickedElementPos)
  if (!this.bool) then
    !this.cwbm.startfromFreePoint(!bran, !this.pickedElementPos)
    !this.bool = FALSE
  else
    !this.cwbm.endfromFreePoint(!bran, !this.pickedElementPos)
  endif
  !this.cwbm.disconnectBranches(!bran, !targetBran)
  !this.cwbm.connectBranches(!bran, !targetBran)
  !this.cwbranGrid.refreshTable()
  !undo.endUndoable()

endmethod
--------------------------------------------------------------------------------------
--Method .identifyBran(} method for initiating EDG pick for branch connection
--------------------------------------------------------------------------------------
define method .identifyBran()

  if (!this.cwbranGrid.getSelectedRows().size().eq(1)) then
    !packet = object EDGPACKET()
    !packet.pickpacket.stdgraphic('Pick on segment from which the branch should connect')
    !packet.pickpacket.picks[1].pick.input[5] = |TYPE EQ 'CWBRAN'|
    !packet.pickpacket.picks[1].pick.input[3] = |TYPE EQ 'CWBRAN'|
    !packet.pickpacket.picks[1].pick.modifiable = FALSE
    !packet.remove = TRUE
    !packet.action = '!!cblCableTrayVolumes.derivePickedPoint(!this.return[1])'
    !packet.continue = '!!cblCableTrayVolumes.connectBranchPick()'
    !!edgcntrl.add(!packet)
  endif

endmethod
---------------------------------------------------------------------------------
-- Method .derivePickedPoint(EDGPICKDATA) derives the picked POINTR from edg pick
---------------------------------------------------------------------------------
define method .derivePickedPoint(!pickData is EDGPICKDATA)

  --  !location  = !this.location
  !element   = !pickData.item
  !centreLineFlag = FALSE
  !facets    = !pickData.facets
  !pointvect = !pickData.pickLine
  !lpos      = !pickData.lines

  if !facets.unset() then
  -- no facets. so pick the line
    !pickLine = object LINE(!lpos[1],!lpos[2])
    !line = !pointvect.line(100)
    !intersect = !pickLine.intersection(!line)
    !centreLineFlag = TRUE
  else
    -- create profile from facets
    !profpos = !facets[1]
     -- get orientation from first two positions of the facets
    !facetLine = object LINE(!facets[1], !facets[2])
    !ydir = !facetLine.direction()
    !profori = object ORIENTATION('Y is $!ydir')
    !prof    = object PROFILE(!profpos, !profori, !facets)
    --close the profile
    !prof.close()

     --make a plane from the profile
    !profPlane = !prof.plane()

     -- create line from point vector
    !line = !pointvect.line(100)

     -- if line is perpendicular to profile, manipulate to intersect at some other point
    if !prof.orientation.zdir().opposite().eq(!line.direction()) or !prof.orientation.zdir().eq(!line.direction()) then
      !intersect = !prof.near(!line.startPosition)
      !centreLineFlag = TRUE
    else
     -- project line on to profile and get position
      !intersects = !prof.intersections(!line)
      !intersect  = !intersects[1]
    endif
  endif

   --construct lines along Route
  !col = object COLLECTION()
  !col.scope(!element)
  !col.type('POINTR')

  !points = !col.results()

  !routeLines = object ARRAY()
  do !i from 1 to (!points.size() - 1)
    !rline = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
    !routeLines.append(!rline)
  enddo
   -- find the nearest line to profile intersection
  !distarray = object ARRAY()
  do !j from 1 to !routeLines.size()
    !dist = !routeLines[!j].distance(!intersect)
    !distarray.append(!dist)
  enddo
    -- sort the distances to get the index of the point
  !sortdist = !distarray.sortedindices()

    -- check if there are more points than 1
 -- !unusedSortdist = !sortdist[2]
  handle ANY
  !inx = 1
  !unusedPointr = !points[!sortdist[1]]
  elsehandle NONE
  -- if the points are in same line, then find the nearest point to intersection
  !inx = 1
  !nearestPoint  =  !points[!sortdist[1]]
  !lineFirst  = object LINE(!intersect, !points[!sortdist[1]].position.wrt(worl))
  do !x from 2 to (!sortdist.size())
    if !distarray[!sortdist[1]].eq(!distarray[!sortdist[!x]]) then
      !lineSecond = object LINE(!intersect, !points[!sortdist[!x]].position.wrt(worl))
        if !lineFirst.length().gt(!lineSecond.length()) then
          !nearestPoint = !points[!sortdist[!x]]
          !lineFirst    = !lineSecond
          !inx = !x
        endif
    endif
  enddo
  !this.pointr  = !nearestPoint
  endhandle
   -- get more accurate point during pick by intersecting with a plane along the centre line
  if !centreLineFlag.not() then
    -- move the profile plane to centre line
    !profPlane.position = !routeLines[!sortdist[!inx]].startPosition

    --project view line to plane
    !projectedLine = !line.projected(!profPlane)   	

    --get the intersection
    !intersect = !routeLines[!sortdist[!inx]].intersection(!projectedLine)
    handle ANY
    	-- lines are parallel
    !intersect = !profPlane.intersection(!line)
    endhandle

  endif

   -- get the position on the segment
  !this.pickedElementPos  = !routeLines[!sortdist[!inx]].near(!intersect)

endmethod
--End of method definition

---------------------------------------------------------------------------
--Method .connect(STRING) method for connecting Head of branch to another branch
---------------------------------------------------------------------------
define method .connect(!task is STRING)

  if (!task.eq('HEAD')) then
    !this.bool = TRUE
    --call branch connection method
    !this.identifyBran()

  elseif (!task.eq('TAIL')) then
    !this.identifyBran()

  elseif (!task.eq('CONNECT')) then
    !!cblconnectbranches()

  elseif (!task.eq('DISCONNECT')) then
    !!cbldisconnectbranches()
  endif

endmethod
