define method .setCellImage()

  !volumePresent = !!pml.getPathName('valid12.png')
  !volumeAbsent  = !!pml.getPathName('failed12.png')
  do !j indices !this.trayArray
    !bool = FALSE
    !bool = !this.evaluate(!this.trayArray[!j])
    !this.trayGrid.setCellImage(!j, 2, !volumeAbsent)
    -- check if the corresponding array element is set i.e. is the volume present
   -- !bool = !this.volumeList[!j].set() AND !this.volumeList[!j].size().gt(0)
   -- handle any
   -- elsehandle NONE
    if (!bool) then
      -- set volumepresent image
      !this.trayGrid.setCellImage(!j, 2, !volumePresent)
    endif
    --endhandle

  enddo

endmethod
------------------------------------------------------------------------------------------
--Method .modifyBranch() method for displaying cableway branch modify form
------------------------------------------------------------------------------------------
define method .createModAtt(!task is STRING, !elementType is STRING)

  if (!this.cwbranGrid.getSelectedRows().size().lt(1)) then
    !!alert.warning('Please select a branch.')
  else
    !!ce = !this.cwbranGrid.getSelectedRows()[1][1].dbref()
    -- Display Cableway branch modify form
    if (!task eq 'MODIFY') then
      !!cblinit('Modify','CWBRAN','!!cblCway')
    elseif (!task eq 'CREATE' and !elementType eq 'POINTR') then
      !!cblinit('Create','POINTR','!!cblCway')
    elseif (!task eq 'CREATE' and !elementType eq 'RATTA') then
      !!cblinit('Create','RATTA','!!cblCway')
    elseif (!task eq 'CREATE' and !elementType eq 'RNODE') then
      !!cblinit('Create','RNODE','!!cblCway')
    endif
  endif

endmethod
-------------------------------------------------------------------------------------------
--Method .deleteBranch() method for deleting cableway branch and/or cableways
-------------------------------------------------------------------------------------------
define method .delete(!element is STRING)

  if (!this.cwbranGrid.getSelectedRows().size().lt(1)) then
    !!alert.warning('Please select an element to delete.')
  else
    !list = !this.cwbranGrid.getSelectedRows()
      !bran = !list[1][1].dbref()
      if (!element eq 'CWAY') then
        !!ce = !bran.owner
        !!deleteCE()
      elseif (!element eq 'CWBRAN') then
        !!ce = !bran
        !!deleteCE()
      endif

    !this.initialise()
  endif

endmethod
---------------------------------------------------------------------------------------------
--Method .loadZones() method for loading all available zones for worl
---------------------------------------------------------------------------------------------
define method .loadZones()

  if (!!ce.type.eq('WORL')) then
    !!alert.warning('Be at a level below World')
    return
  endif
   !site= NAME of SITE
  !answer = !!alert.confirm('Load all Zones for site $!site')
  if (!answer.neq('YES')) then
    return
  endif
  var !zones collect all ZONE for SITE
  var !zoneNames evaluate NAME for ALL from !zones
  !this.zoneList.dtext = !zoneNames

endmethod
