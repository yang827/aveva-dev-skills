define method .showAssoc()

  if undefined(!!associationmanager) then
    loadform !!associationmanager
  endif

  show !!associationmanager
  !!associationmanager.filterBy.select('Rtext', 'Selected Purpose')
  !!associationmanager.purp.active = TRUE
  !!associationmanager.purp.select('Rtext', 'TBAS')
  handle ANY
    !!alert.error('Cannot find association group with purpose TBAS')
  endhandle
  !!associationmanager.showAssocs(!!associationmanager.filterBy , 'SELECT')



endmethod
---------------------------
define method .showHideUnconnected()


  !this.clearAids()
  if (!this.clearTag) then
    !this.clearTag = FALSE
    !this.showConnTag.tag = 'Show Unconnected'
  else
  !array = !this.cwbranGrid.getRows()
  !text = 'Unconnected'
  do !volumes values !array
    if (!volumes[1].dbref().hdref.unset()) then
      !pos = !volumes[1].dbref().hpos.wrt(worl)
      AID TEXT NUMBER $!<this.connectionAidNumber> |$!<text>| at $!pos
    endif

    if (!volumes[1].dbref().tlref.unset()) then
      !pos = !volumes[1].dbref().tpos.wrt(worl)
      AID TEXT NUMBER $!<this.connectionAidNumber> |$!<text>| at $!pos
    endif
  enddo
  !this.clearTag = TRUE
  !this.showConnTag.tag = 'Hide Unconnected'
  endif
endmethod

---------------------------------
define method .clearAids()

    aid clear text $!this.connectionAidNumber
    handle ANY
    endhandle

endmethod
------------------------------------------------------------------------
--
-- Method: validateRule
--
-- Description: Validates the rllo syntax
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateRule()

  if !this.cwbranRllogical.val.substring(1,1).neq(|(|) then
    !!alert.warning(|Enclose the rule in a parenthesis ('')|)
    !this.cwbranRllogical.val = |('')|
    return
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: addIclass
--
-- Description: adds the user interference class to gadget
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addIclass(!gadget is GADGET, !action is STRING)

  if !action.eq('VALIDATE') then

    !newInter = !gadget.displayText()
    --add the value
    !values = !gadget.dtext
    if !values.findfirst(!newInter).set().not() then
      !gadget.add(!newInter)
      !this.dinter.append(!newInter)
    endif

    -- be at the new input value
    !gadget.select('DTEXT', !newInter)
    handle ANY
    endhandle
  endif

 -- change the rule gadget
  if !action.eq('VALIDATE') or !action.eq('SELECT') then
 	  !inter = !gadget.selection()
 	  if !inter.neq('unset') then
 	    !this.cwbranRllogical.val = |(ICLASS EQ '$!inter')|
 	  else
 	    !this.cwbranRllogical.val = |('')|
 	  endif 	
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: loadIclass
--
-- Description: loads the interference class from cable property db
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadIclass()

  var !cabd collect all CABD
  !interference = object ARRAY()
  do !cable values !cabd
   !interference.append(!cable.dbref().dinterference)
  enddo
  !interference.unique()

  -- load values to member
  do !inter values !interference
    !this.dinter.append(!inter)
  enddo

  !this.dinter.unique()

  !selection = !this.cwbranIclass.selection()
  !this.cwbranIclass.dtext = !this.dinter

  -- display original selection
  if !selection.neq('') then
   !this.cwbranIclass.select('DTEXT', !selection)
   handle ANY
   endhandle
  endif

  -- message
  if !interference.set() then
  	!this.iclassLoad.tag = 'Reload'
    !!alert.message('Interference class from properties database loaded')
  else
    !!alert.message('No Interference class available in properties database')
  endif


endmethod

------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      updateFrame
--
-- Description: removes the selected iclass
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFrame()

  if !this.cwbranRllogicalTag.val then
    !this.cwbranRllogical.active = TRUE
    !this.cwbranIclass.active    = FALSE
    !this.iclassLoad.active      = FALSE
  else
    !this.cwbranRllogical.active = FALSE
    !this.cwbranIclass.active    = TRUE
    !this.iclassLoad.active      = true
    !this.addIclass(!this.cwbranIclass, |SELECT|)
  endif

endmethod
--End of method definition

-----------------------------

define method .radiusSelect()
	
	if (!this.autoRad.val) then
		!this.brad.active = FALSE
	else 		
		!this.brad.active = TRUE
	endif

endmethod
-------------------------------
define method .fillCheck(!tray is DBREF) is BOOLEAN

--simple check to confirm if the tray is filled (added 09/02/2011)
  !flag = FALSE
  !col = object COLLECTION()
  !col.scope(!tray)
  !col.addType('TUBI')
	!members = !col.results()
	do !member values !members
		if (!member.itle.gt(0)) then
			!flag = TRUE
			break
		endif
	enddo
  return !flag
endmethod
-----------------------------------------------------------------------------------

define method .findASSOGP() is DBREF

  var !arrayASSOGP collect all ASSOGP with PURP  eq 'TBAS'
  do !element values !arrayASSOGP

    !tempDBREF = !element.dbref()
    if (!tempDBREF.dbwrite )then
      if (not ( !tempDBREF.lock ))then
        return !tempDBREF
      endif
    endif
  enddo
  return NULREF

endmethod
-------------------------------

define method .fill(!tray is DBREF)

VAR !posi REF
VAR !mode MODE
$!tray
!len = stext of text2 of pspec of ce
!length = !len.real()

--VAR USER _CDFILL SELECT 2
-- MAKE SURE THE USER IS FORWARDS MODE
FORWARDS
-- FIND OUT HOW MANY COMPONENTS IN THE BRANCH
VAR !count MEM COUNT
-- if THERE ARE NONE then WORK OUT DIST BETWEEN HEAD AND TAIL
if($!count EQ 0) then
   -- ACTION
   VAR !dist CONS DIST PH to PT
   -- DIVIDE THE DIST BY THE MAX LENGTH OF TRAY
   VAR !num (INT($!dist / $!length))
   -- THIS GIVES THE NUMBER OF MAX LENGTH TRAYS
   -- WORK OUT THE DIST OF THE FINAL VARIABLE LENGTH
   VAR !extra ($!dist - ($!num * $!length))
   -- SPECIAL CASE if NO DISTANCE BETWEEN HEAD AND TAIL STOP THE MACRO
   -- FILL IN WITH AS MANY FIXED LENGTHS AS POSSIBLE AND then
   if($!dist EQ 0) then
   -- RETURN to ORIGINAL POSITION AND MODE
     $!posi
     $!mode
     return
   endif
   do from 1 to $!num
      NEW FTUB SEL
      CONN
      handle (7,3)
         ERROR |Incompatible connection type. Item force connected|
         FCONN
      endhandle
   enddo
   -- FINALLY FILL THE LAST BIT IN WITH A VARIABLE LENGTH
   NEW FTUB SEL WI STYP VL
   HEIG $!extra
   CONN
   handle (7,3)
      ERROR |Incompatible connection type. Item force connected|
      FCONN
   endhandle
else
   -- PLACE PIN 1 AT THE PA OF THE FIRST COMP
   FIRST MEM
   PIN 1 DIR P30
   -- WORK OUT THE DIST BETWEEN THE FIRST COMP AND THE PH
   VAR !dist CONS DIST PA to PH
   -- DIVIDE THE DIST BY THE MAX LENGTH OF TRAY
   VAR !num (INT($!dist / $!length))
   -- THIS GIVES THE NUMBER OF MAX LENGTH TRAYS
   -- WORK OUT THE DIST OF THE FINAL VARIABLE LENGTH
   VAR !extra ($!dist - ($!num * $!length))
   -- FILL IN WITH AS MANY FIXED LENGTHS AS POSSIBLE AND then
   -- GOTO THE HEAD
   VAR !name NAME
   HEAD
   do from 1 to $!num
      NEW FTUB SEL
      CONN AND P30 IS PIN 1
      handle (7,3)
         ERROR |Incompatible connection type. Item force connected|
         FCONN AND P30 IS PIN 1
      endhandle
      PIN 1 DIR P30
   enddo
   -- FINALLY FILL THE LAST BIT IN WITH A VARIABLE LENGTH
   if($!extra NEQ 0) then
      NEW FTUB SEL WI STYP VL
      HEIG $!extra
      CONN AND P30 IS PIN 1
      handle (7,3)
         ERROR |Incompatible connection type. Item force connected|
         FCONN AND P30 IS PIN 1
      endhandle
      PIN 1 DIR P30
   endif
   -- COME BACK to ORIGINAL COMP
   $!name
   if($!count NEQ 1) then
      do from 2 to $!count
         -- PLACE PIN 1 AT THE NEXT COMP
         NEXT
         PIN 1 DIR P30
         -- WORK OUT THE DIST BETWEEN THE COMPONENTS
         VAR !dist CONS DIST PA to PL OF PREV
         -- DIVIDE THE DIST BY THE MAX LENGTH OF TRAY
         VAR !num (INT($!dist / $!length))
         -- THIS GIVES THE NUMBER OF MAX LENGTH TRAYS
         -- WORK OUT THE DIST OF THE FINAL VARIABLE LENGTH
         VAR !extra ($!dist - ($!num * $!length))
         -- FILL IN WITH AS MANY FIXED LENGTHS AS POSSIBLE AND then
         -- GOTO THE PREV
         VAR !name NAME
         PREV
         do from 1 to $!num
            NEW FTUB SEL
            CONN AND P30 IS PIN 1
            handle (7,3)
               ERROR |Incompatible connection type. Item force connected|
               FCONN AND P30 IS PIN 1
            endhandle
            PIN 1 DIR P30
         enddo
         -- FINALLY FILL THE LAST BIT IN WITH A VARIABLE LENGTH
         if($!extra NEQ 0) then
            NEW FTUB SEL WI STYP VL
            HEIG $!extra
            CONN AND P30 IS PIN 1
            handle (7,3)
               ERROR |Incompatible connection type. Item force connected|
               FCONN AND P30 IS PIN 1
            endhandle
            PIN 1 DIR P30
         endif
         -- COME BACK to ORIGINAL COMP
         $!name
      enddo
   endif

   PIN 1 DIR P31
   -- WORK OUT THE DIST BETWEEN THE COMPONENTS
   END
   VAR !dist CONS DIST PT to PL OF LAST MEM
   -- DIVIDE THE DIST BY THE MAX LENGTH OF TRAY
   VAR !num (INT($!dist / $!length))
   -- THIS GIVES THE NUMBER OF MAX LENGTH TRAYS
   -- WORK OUT THE DIST OF THE FINAL VARIABLE LENGTH
   VAR !extra ($!dist - ($!num * $!length))
   -- GOTO THE LAST MEM
   LAST MEM
   do from 1 to $!num
      NEW FTUB SEL
      CONN AND P30 IS PIN 1
      handle (7,3)
         ERROR |Incompatible connection type. Item force connected|
         FCONN AND P30 IS PIN 1
      endhandle
      PIN 1 DIR P30
   enddo
   -- FINALLY FILL THE LAST BIT IN WITH A VARIABLE LENGTH
   if($!extra NEQ 0) then
      NEW FTUB SEL WI STYP VL
      HEIG $!extra
      CONN AND P30 IS PIN 1
      handle (7,3)
         ERROR |Incompatible connection type. Item force connected|
         FCONN AND P30 IS PIN 1
      endhandle
      PIN 1 DIR P30
   endif
   END
--For removing the temporary Pin
PIN 1 OFF
-----
endif
-- RETURN to ORIGINAL POSITION AND MODE
$!posi
$!mode

endmethod

-----------------------------------------------------------------------------------
define method .unfill(!tray is DBREF)

VAR !posi REF
VAR !mode MODE
$!tray
FORWARDS


-- CHECK NUMBER OF FTUBS IN THE BRAN
VAR !numftub MEM FTUB COUNT

do from 1 to $!numftub
   FTUB 1
   DELETE FTUB
enddo

$!mode
$!posi

endmethod
