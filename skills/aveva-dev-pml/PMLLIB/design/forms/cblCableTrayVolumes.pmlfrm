------------------------------------------------------------------------------------------------
define method .resetField()
  if undefined(!!cbldflts) then
    pml reload form !!cbldflts
  endif
  !this.cwbranDesc.val     			 = ''
  !this.cwbranFunc.val     			 = ''
  !this.cwbranPurp.val     			 = ''
  !this.cwbranCexs.val       = !!cbldflts.cwbranCexs
  !this.cwbranMaxfil.val     = !!cbldflts.cwbranMaxfil
  !this.cwbranHei.val        = !!cbldflts.cwbranVHeight

  !this.dinter = !!cbldflts.cwbranIclass.dtext
  handle (2,751)
    !!alert.error('Cabling System Application not loaded. Please load Cabling System Application')
    return
  endhandle
  !this.cwbranIclass.dtext = !this.dinter
  !this.cwbranIclass.select('DTEXT',!!cbldflts.cwbranIclass.selection())
  handle ANY
    !this.cwbranIclass.select('DTEXT','unset')
  endhandle

  !this.brad.val                 = 0 mm
  !this.cwbranRllogicalTag.val   = FALSE
  !this.cwbranIclassTag.val      = TRUE
  !this.manualRad.val            = FALSE
  !this.autoRad.val              = TRUE

  !this.updateFrame()
  !this.radiusSelect()

endmethod
----------------------------------------------------------------------------------------------

define method .evaluate(!tray is DBREF) is BOOLEAN

  var !assogp collect all ASSOGP with PURP EQ 'TBAS'
  !refArray = !assogp.evaluate(object BLOCK(|!assogp[!evalIndex].dbref()|))


  --var !assmbr collect all ASSMBR with AMEMRF EQ 'tray reference'
  !unusedTrial = object ARRAY()
  !bool = FALSE
  !bool1 = FALSE
  !assmbr = object COLLECTION()
  !assmbr.scope (!refArray)
  !assmbr.addType('ASSMBR')
  !list = !assmbr.results()
  !array = object ARRAY()
  do !val values !list
    if (!val.amemrf eq !tray) then
      !array.append(!val)
    endif
  enddo
    do !a values !array
    -- check if the branch exists for each tray by evaluating the associations
    !assoc = !a.owner
    !bool1 = !assoc.testev
    if (!bool1) then
      !branch = object COLLECTION()
      !branch.scope(!assoc)
      !branch.addType('ASSMBR')
      !members = !branch.results()
      do !mem values !members
        if (!mem.amemrf.type eq 'CWBRAN') then
          !this.volumeList.append(!mem.amemrf)
          !bool = TRUE
        endif
      enddo
    endif
  enddo
  !this.volumeList.sortUnique()
  return !bool

endmethod
-------------------------------------------------------------------------------------------------
define method .setLevel(!level is STRING)

  !levelgadget = '!this.' & !this.level & 'level.val'

  if (!level.eq('WORLD')) then

    if (!this.levelcheck) then
      !answer = !!alert.confirm('Load cabletrays for WORLD level?, this may take some time.')

      if (!answer.eq('NO')) then
        !this.worldLevel.val = FALSE
        $!levelgadget = TRUE
        !this.levelcheck = FALSE
        return
      endif

    else
      $!levelgadget = TRUE
      !this.levelcheck = TRUE
      return
    endif

  endif
  !this.levelcheck = TRUE
  !this.level = !level
  !this.initialise()

endmethod
