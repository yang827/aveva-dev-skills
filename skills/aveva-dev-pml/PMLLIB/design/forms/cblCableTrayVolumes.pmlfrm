--  derivePickedPoint(EDGPICKDATA)   -
--  evaluate(DBREF)                  BOOLEAN
--  fill(DBREF)                      -
--  fillCheck(DBREF)                 BOOLEAN
--  findASSOGP()                     DBREF
--  highlightElement()               -
--  identifyBran()                   -
--  initialise()                     -
--  loadIclass()                     -                   loads the interference class from cable property db
--  loadTrays()                      -
--  loadZones()                      -
--  navigateToCEBran()               -
--  navigateToCETray()               -
--  radiusSelect()                   -
--  resetField()                     -
--  rightClickGrid(ARRAY)            -
--  setCellImage()                   -
--  setLevel(STRING)                 -
--  showAssoc()                      -
--  showHideUnconnected()            -
