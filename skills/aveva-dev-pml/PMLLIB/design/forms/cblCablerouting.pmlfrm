--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCable()                       -
--  addConnected()                   -
--  aidText(REAL,STRING,POSITION)    -
--  back()                           -
--  cableGridAfterSelectCallback(ARRAY) -
--  cableGridPopupCallback(ARRAY)    -
--  cablewayGridPopupCallback(ARRAY) -
--  cblCableRouting()                -
--  dismiss()                        -                   dismiss the cable form
--  enhance()                        -
--  exportToExcel()                  -
--  getSelection()                   ARRAY
--  hide()                           -
--  initialise()                     -
--  loadCab()                        -                   loadCables method
--  loadCables()                     -
--  loadEquiZone()                   -                   Load Equipment Zone method
--  loadGrid()                       -
--  loadRoutes()                     -
--  loadUnroutedCables()             -                   load un-routed Cables method
--  loadZones()                      -
--  loadcwayZones()                  -                   LoadZones method
--  navigate()                       -
--  printPreview()                   -
--  removeCable()                    -
--  removeConnected()                -
--  routeAfterSelectCallback(ARRAY)  -
--  routeCable(DBREF,ARRAY)          -                   routeCable method
--  routeCables(STRING)              -                   routeCable method
--  routeGridPopupCallback(ARRAY)    -
--  setCellImage(REAL,REAL,STRING)   -
--  setRLSE(ARRAY)                   BOOLEAN             routeCable method
--  showCblListCables()              -                   Show cblListCables form
--  state(GADGET)                    -
--  unEnhance()                      -
--  unrouteCable(STRING)             -                   un-route cable method
--  zoneGridPopupCallback(ARRAY)     -
--
import 'GridControl'
handle any
endhandle

--- form definition
setup form !!cblCableRouting size 77 20 dialog docking

  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle = 'Cable Data'
  !this.iconTitle = 'Cable Data'
  !this.initCall  = '!this.initialise()'

  path down

  -- define Cable  PML Frame
  --frame .pmlFrame1 FOLDUP 'Cable List' anchor L + R + T at xmin
  --frame .pmlFrame1  'Cable List' anchor L + R + T

  --frame .selectionFrame 'Zone Selection List' anchor t + L + R  at xmin ymax
  frame .selectionFrame 'Zone Selection List' dock fill
    -- define PML Container to host my .Net control
    button .loadZone linklabel 'Reload cable zones' at x0.5 y0.8 call '!this.loadZones()'

    frame .pmlFrameZone 'Zones Containing Cables' at xmin+0.2 ymax anchor all
      container .zoneFrame  PMLNetCONTROL 'NET'  anchor all at xmin+1 ymax width 76 height 15
    exit

    button .pmlFill linklabel 'Load cables for selected zones' anchor l+b call '!this.loadCables()' at x1 ymax.pmlFrameZone
    button .pmlFill1 linklabel 'Load un-routed cables for selected zones' anchor l+b call '!this.loadUnroutedCables()' at x1 ymax
    paragraph .equiZoneTag anchor l+b at xmin.pmlFill1 ymax.pmlFill1  text  'Load Cables by Start/End Ref Equipment Zone:'  width 30
    option .equiZone anchor l+r+b  at xmax.equiZoneTag   ymin.equiZoneTag    callback '!this.loadCab()'  width 16
  exit

  frame .page2 anchor all at xmin.selectionFrame ymin.selectionFrame

    frame .pmlFrame12 'Cable list' at xmin + 0.2 ymax anchor l+t+r+b
      -- define PML Container to host my .Net control
      container .cableFrame PMLNetCONTROL 'NET'  anchor all at xmin + 1 ymax width 76 height 11
    exit
    button .routedPng tooltip 'Route Selected Cable(s)' pixmap anchor l+b at xmin.pmlFrame12 ymax.pmlFrame12 call '!this.routeCables(|SELECTED|)' width 16 height 16
    button .routeCables linklabel 'Route Selected Cable(s)'    anchor l+b at xmax            ymin call '!this.routeCables(|SELECTED|)'
    path right
    button .unroutePng tooltip 'Unroute Selected Cable(s)' pixmap anchor l+b              call '!this.unrouteCable(|SELECT|)' width 16 height 16
    button .unrouteCables linklabel 'Unroute Selected Cable(s)'   anchor l+b at xmax ymin call '!this.unrouteCable(|SELECT|)'
    path right
    toggle .tog1                   at xmax.unrouteCables+1          tagwid 13 |Highlight in 3D View| call |!this.state(!this.tog1)| anchor l+b
    line .separator  anchor l+b+r    at xmin.routedPng ymax.routedPng horiz width 78 height 0.5
    frame .dataTabs TABSET 'tabset' anchor l+r+b at xmin.separator ymax.separator width 77 height 10
      --frame .cwayzonelist 'Cableway Zones' anchor l+r+b  at xmin ymax+1 height 7 width 40
      frame .cwayzonelist 'Cableway Zones' dock fill
        -- define PML Container to host my .Net control
        frame .labelFrame 'Select Cableway Zones for Cable Routing' at 0 0 dock fill
          container .cablewayFrame nobox PMLNetCONTROL 'NET'  DOCK FILL
        exit
      exit
      -- define Routing PML Frame
      frame .pmlFrame2 'Route Information'    at 0 0 dock fill
        --button .pmlFill2 linklabel 'Reload Routes' call '!this.loadRoutes()' at xmin.pmlFrame2 ymax.pmlFrame2
        frame .pmlFrame22 'Route list' at 0 0 dock fill
          -- define PML Container to host my .Net control
          container .routeFrame nobox PMLNetCONTROL 'NET'  dock fill
        exit
      exit
    exit	
  exit

  button .backPng tooltip 'Back' pixmap anchor l+b at xmin.page2 + 0.2  ymax.page2 + 0.5 callback |!this.back()| width 16 height 16
  path right
  button .backButton linklabel 'Back' callback |!this.back()| anchor l+b

   -- define CableGrid popup menu
  menu .routeGridPopup popup
    !this.routeGridPopup.add( 'CALLBACK', 'List of Associated Cables...' , '!this.showCblListCables()')
    !this.routeGridPopup.add( 'CALLBACK', 'Print Preview...' , '!this.printPreview()')
    !this.routeGridPopup.add( 'CALLBACK', 'Export to Excel...' , '!this.exportToExcel()')

   -- define CableGrid popup menu
  menu .cableGridPopup popup
    !this.cableGridPopup.add( 'CALLBACK', 'Highlight in 3D View', '!this.enhance()' )
    !this.cableGridPopup.add( 'CALLBACK', 'Unhighlight in 3D View', '!this.unEnhance()' )
    !this.cableGridPopup.add( 'SEPARATOR')
    !this.cableGridPopup.add( 'MENU', '3D View',                       'PMLPopupSub' )
    !this.cableGridPopup.add( 'SEPARATOR')
    !this.cableGridPopup.add( 'CALLBACK', 'Route Selected Cable', '!this.routeCables(|SELECTED|)' )
    !this.cableGridPopup.add( 'CALLBACK', 'Route All Cables', '!this.routeCables(|ALL|)' )
    !this.cableGridPopup.add( 'CALLBACK', 'Un-route Cable', '!this.unrouteCable(|SELECT|)' )
    !this.cableGridPopup.add( 'CALLBACK', 'Modify Attributes...', |!!cblinit('Modify','CABLE','!!cblcable')|, 'MODIFY' )

  menu .pmlpopupsub
    !this.pmlpopupsub.add( 'CALLBACK', 'Add Cable(s)',                  '!this.addCable()' )
    !this.pmlpopupsub.add( 'CALLBACK', 'Add Connected     ',         '!this.addConnected()' )
    !this.pmlpopupsub.add( 'CALLBACK', 'Remove Cable(s)      ',         '!this.removeCable()' )
    !this.pmlpopupsub.add( 'CALLBACK', 'Remove Connected  ',         '!this.removeConnected()' )

  -- define CableGrid popup menu
  menu .zoneGridPopup popup
    !this.zoneGridPopup.add( 'CALLBACK', 'Load Cables for Selected Zones', '!this.loadCables()' )
    !this.zoneGridPopup.add( 'CALLBACK', 'Load Un-Routed Cables for Selected Zones', '!this.loadUnroutedCables()' )

  -- define cableway grid pop up menu
  menu .cablewayGridPopup popup
    !this.cablewayGridPopup.add( 'CALLBACK', 'Navigate to', '!this.navigate()')

  --Form Members
  member .cableGrid is NETGRIDCONTROL
  member .routeGrid is NETGRIDCONTROL
  member .zoneGrid is NETGRIDCONTROL
  member .cablewayGrid is NETGRIDCONTROL
  member .selectedCablesArray is ARRAY
  member .cwaybranch   is ARRAY
  member .selectedRoutesArray is ARRAY
  member .pos is ARRAY
  member .entryAidNum   is REAL
  member .exitAidNum    is REAL
  member .connectionManager is  MDRCONNECTIONMANAGER
  member .connectionGraph is  MDRCONNECTIONGRAPH
  member .myNewValue is STRING
  member .cableManager is CABLEMANAGER
  member .previousMark is DBREF
  -- list of enhanced elements
  member .enhanced     is COMENHANCE
  -- EDG Description
  member .edgDescription  is STRING

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:   cblCableRouting()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblCableRouting()

   !this.myNewValue = 'Test Value'
   !this.quitcall = |!this.dismiss()|

   using namespace 'Aveva.Pdms.Presentation'

   -- create instance of .Net control
   !this.cableGrid    = object NETGRIDCONTROL()
   !this.routeGrid    = object NETGRIDCONTROL()
   !this.zoneGrid     = object NETGRIDCONTROL()
   !this.cablewayGrid = object NETGRIDCONTROL()

   !this.entryAidNum        = !!aidNumbers.add('Entry Point')
   !this.exitAidNum         = !!aidNumbers.add('Exit Point')

   -- add PML event handlers to .Net control
   !this.cableGrid.addeventhandler('onPopup', !this, 'cableGridpopupCallback')
   !this.cableGrid.addeventhandler('afterSelectChange', !this, 'cableGridAfterSelectCallback')

   -- add PML event handlers to .Net control
   !this.routeGrid.addeventhandler('onPopup', !this, 'routeGridPopupCallback')
   !this.routeGrid.addeventhandler('afterSelectChange', !this, 'routeAfterSelectCallback')

   -- add PML event handlers to .Net control
   !this.zoneGrid.addeventhandler('onPopup', !this, 'zoneGridpopupCallback')

   -- add PML event handlers to .Net control
   !this.cablewayGrid.addeventhandler('onPopup', !this, 'cablewayGridPopupCallback')

   -- add .Net control to PML container
   !this.cableFrame.control = !this.cableGrid.handle()
   !this.routeFrame.control = !this.routeGrid.handle()
   !this.zoneFrame.control  = !this.zoneGrid.handle()
   !this.cablewayFrame.control  = !this.cablewayGrid.handle()
   !this.backPng.addPixmap(!!pml.getPathName('back.png'))
   !this.routedPng.addPixmap(!!pml.getPathName('routedcbl16.png'))
   !this.unroutePng.addPixmap(!!pml.getPathName('unroutedcbl16.png'))
   !this.page2.visible = FALSE
   !this.selectionFrame.visible = TRUE
   !this.backButton.visible = FALSE
   !this.backPng.visible = FALSE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   initialise()
--
-- Description: initialise method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !this.zoneGrid.editableGrid(FALSE)
  !this.zoneGrid.columnExcelFilter(TRUE)
  !this.zoneGrid.outlookGroupStyle(FALSE)
  !this.zoneGrid.fixedHeaders(FALSE)
  !this.zoneGrid.fixedRows(FALSE)
  !this.zoneGrid.errorIcon(TRUE)
  !this.zoneGrid.updates(FALSE)


  !this.cableGrid.editableGrid(FALSE)
  !this.cableGrid.columnExcelFilter(TRUE)
  !this.cableGrid.outlookGroupStyle(FALSE)
  !this.cableGrid.fixedHeaders(FALSE)
  !this.cableGrid.fixedRows(FALSE)
  !this.cableGrid.errorIcon(TRUE)
  !this.cableGrid.updates(FALSE)


  !this.routeGrid.editableGrid(FALSE)
  !this.routeGrid.columnExcelFilter(TRUE)
  !this.routeGrid.outlookGroupStyle(FALSE)
  !this.routeGrid.fixedHeaders(FALSE)
  !this.routeGrid.fixedRows(FALSE)
  !this.routeGrid.errorIcon(TRUE)
  !this.routeGrid.updates(FALSE)
  !this.routeGrid.singleRowSelection(TRUE)

  !this.cablewayGrid.editableGrid(FALSE)
  !this.cablewayGrid.columnExcelFilter(TRUE)
  !this.cablewayGrid.outlookGroupStyle(FALSE)
  !this.cablewayGrid.fixedHeaders(FALSE)
  !this.cablewayGrid.fixedRows(FALSE)
  !this.cablewayGrid.errorIcon(TRUE)
  !this.cablewayGrid.updates(FALSE)

  !this.loadZones()
  !this.loadcwayZones()
  !this.loadEquiZone()
  !this.zoneGrid.selectRow(1)
  --!this.loadCables()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: dismiss
--
-- Description: dismiss the cable form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dismiss()

  !!aidNumbers.hide(!this.entryAidNum)
  !!aidNumbers.hide(!this.exitAidNum)
  !this.enhanced.clear()
  axes off
  !this.hide()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:   loadCables()
--
-- Description: loadCables method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadCables()

 !selection = !this.cableGrid.getSelectedRowTags()
 !zoneArray = ARRAY()
 do !index values !this.zoneGrid.getSelectedRows()
   !zoneArray.append(!index[1].dbref())
 enddo

  -- see if zones are selected
  if !zoneArray.unset() then
    !answer = !!alert.confirm('No zones are selected. Do you want to load all cables in world ?')
    if !answer.neq('YES') then
      return
    endif
  endif

  --!cables = object COLLECTION()
  --!cables.addtype('CABLE')
  --!cables.scope(!zoneArray)
 ---- !cables.scope(site)
  ----!cables.filter(object EXPRESSION(|PURP eq 'CABL'|))
  --!members = !cables.results()
  !members = object ARRAY()
  do !zone values !zoneArray
    var !mem collect all CABLE for $!zone
    --!cablearray = object ARRAY()
    do !cab values !mem
      !cable = !cab.dbref()
      !members.append(!cable)
    enddo
  enddo
  -- Evaluate design members from !colAssmbr
  !cableItems = !members.evaluate(object block ('!members[!evalIndex].string()'))

--var !cableItems collect all CABLE for site

  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('IClass')
  !headings.append('STAREF')
  !headings.append('ENDREF')
  !headings.append('SPREF')
  !headings.append('CBSta')
  --!headings.append('RoutNd')
  !headings.append('Feqdesc')
  !headings.append('Teqdesc')

  !toolTips = ARRAY()
  !toolTips.append('Cable Name')
  --!toolTips.append('Cable Description')
  !toolTips.append('Class Type')
  !toolTips.append('Start Ref')
  --!toolTips.append('Start Connection Point')
  !toolTips.append('End Ref')
  !toolTips.append('Specification')
  !toolTips.append('Status')
  --!toolTips.append('Prelim-Route Point')
  !toolTips.append('Start Ref Desc')
  !toolTips.append('End Ref Desc')
  !gridName = 'Cables'

  !this.cableGrid.clearGrid()
   using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE(!gridName, !headings, !toolTips, !cableItems)
  !this.cableGrid.bindToDataSource(!nds)
	!nds.delete()

 -- !this.cableGrid.setTooltips(!toolTips)
  !this.cableGrid.autoFitColumns()
  !this.loadGrid()
  !this.cableGrid.setSelectedRowTags(!selection)
  !this.hide()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   loadCab()
--
-- Description: loadCables method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadCab()

  !zoneArray = !this.equiZone.selection().dbref()
  handle ANY
    !zoneArray = object DBREF('/' + !this.equiZone.selection())
  endhandle

  !coll = object COLLECTION()
  !coll.scope(!zoneArray)
  !coll.type('EQUI')
  !coll.addtype('ELCONN')
  !equiCable = ARRAY()
  do !i values !coll.results()
    !!ce = !i
    do !j values !i.elcxrf
      !equiCable.append(!j)
    enddo
  enddo
  !equiCable.unique()

  -- Evaluate design members from !colAssmbr
  !cableItems = !equiCable.evaluate(object block ('!equiCable[!evalIndex].string()'))

  --var !cableItems collect all CABLE for site


  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('IClass')
  !headings.append('STAREF')
  !headings.append('ENDREF')
  !headings.append('SPREF')
  !headings.append('CBSta')
 -- !headings.append('RoutNd')
  !headings.append('Feqdesc')
  !headings.append('Teqdesc')

  !toolTips = ARRAY()
  !toolTips.append('Cable Name')
  --!toolTips.append('Cable Description')
  !toolTips.append('Class Type')
  !toolTips.append('Start Ref')
  --!toolTips.append('Start Connection Point')
  !toolTips.append('End Ref')
  !toolTips.append('Specification')
  !toolTips.append('Status')
  --!toolTips.append('Prelim-Route Point')
  !toolTips.append('Start Ref Desc')
  !toolTips.append('End Ref Desc')
  !gridName = 'Cables'

  !this.cableGrid.clearGrid()
  using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE(!gridName, !headings, !toolTips, !cableItems)
  !this.cableGrid.bindToDataSource(!nds)
	!nds.delete()
 --!this.cableGrid.setTooltips(!toolTips)
  !this.cableGrid.autoFitColumns()
  !this.loadGrid()
  !this.cableGrid.selectRow(1)
  !this.hide()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   loadUnroutedCables()
--
-- Description: load un-routed Cables method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadUnroutedCables()

 !zoneArray = ARRAY()
 do !index values !this.zoneGrid.getSelectedRows()
   !zoneArray.append(!index[1].dbref())
 enddo

  -- see if zones are selected
  if !zoneArray.unset() then
    !answer = !!alert.confirm('No zones are selected. Do you want to load all cables in world ?')
    if !answer.neq('YES') then
      return
    endif
  endif

  --!cables = object COLLECTION()
  --!cables.addtype('CABLE')
  --!cables.scope(!zoneArray)
 ---- !cables.scope(site)
  ----!cables.filter(object EXPRESSION(|PURP eq 'CABL'|))
  --!members = !cables.results()
  !members = object ARRAY()
  do !zone values !zoneArray
    var !mem collect all CABLE for $!zone
    --!cablearray = object ARRAY()
    do !cab values !mem
     !cable = !cab.dbref()
     if(!cable.cbsta.eq(0) or !cable.cbsta.eq(-1) or !cable.cbsta.eq(2) or !cable.cbsta.eq(4))then
       !members.append(!cable)
     endif
    enddo
  enddo
  -- Evaluate design members from !colAssmbr
  !cableItems = !members.evaluate(object block ('!members[!evalIndex].string()'))

--var !cableItems collect all CABLE for site

  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('IClass')
  !headings.append('STAREF')
  !headings.append('ENDREF')
  !headings.append('SPREF')
  !headings.append('CBSta')
 -- !headings.append('RoutNd')
  !headings.append('Feqdesc')
  !headings.append('Teqdesc')

  !toolTips = ARRAY()
  !toolTips.append('Cable Name')
  --!toolTips.append('Cable Description')
  !toolTips.append('Class Type')
  !toolTips.append('Start Ref')
  --!toolTips.append('Start Connection Point')
  !toolTips.append('End Ref')
  !toolTips.append('Specification')
  !toolTips.append('Status')
  --!toolTips.append('Prelim-Route Point')
  !toolTips.append('Start Ref Desc')
  !toolTips.append('End Ref Desc')
  !gridName = 'Cables'

  !this.cableGrid.clearGrid()
   using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE(!gridName, !headings, !toolTips, !cableItems)
  !this.cableGrid.bindToDataSource(!nds)
	!nds.delete()
 --!this.cableGrid.setTooltips(!toolTips)
  !this.cableGrid.autoFitColumns()
  !this.loadGrid()
  !this.cableGrid.selectRow(1)
  !this.hide()
endmethod
-- End of method definition



------------------------------------------------------------------------
--
-- Method:   loadZones()
--
-- Description: LoadZones method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadZones()

  -- Collect all association members
  --!zones = object COLLECTION()
  --!zones.addtype('ZONE')
  --!zones.scope(world)
  ----!zones.filter(object EXPRESSION(|PURP eq 'CABL'|))
  --!members = !zones.results()
  var !zones collect all ZONE
  !members = !zones.evaluate(object block ('!zones[!evalIndex].dbref()'))
  -- filter out zones with cables
  !cablezone  = object ARRAY()
  do !zone values !members
    !mem = !zone.members
    do !cab values !mem
      if !cab.type.eq('CABLE') then
        -- found cable. So add the zone to list
        !cablezone.append(!zone)
        skip
      endif
    enddo
  enddo


  !zoneItems = !cablezone.evaluate(object block ('!cablezone[!evalIndex].string()'))

  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Desc')

  !title = object ARRAY()
  !title.append(|Cable Zone Name|)
  !title.append(|Description|)
  !gridName = 'Cable Zones'
  using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE(!gridName, !headings, !title, !zoneItems)
  !this.zoneGrid.bindToDataSource(!nds)
	!nds.delete()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   loadEquiZone()
--
-- Description: Load Equipment Zone method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadEquiZone()

  !coll = object COLLECTION()
  !coll.type('EQUI')
  !coll.addType('ELCONN')
  !zone = ARRAY()

  do !i values !coll.results()
    if (!i.elcxrf.set()) then
      !zone.append(fullname of zone of $!i)
    endif
  enddo

  !zone.unique()

  !this.equiZone.dtext = !zone
  !this.equiZone.rtext = !zone

endmethod
------------------------------------------------------------------------
--
-- Method:   loadcwayZones()
--
-- Description: LoadZones method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadcwayZones()

  !colResult = ARRAY()
  !colZone = object COLLECTION()
  !colZone.type('ZONE')
  !exp = object EXPRESSION('TYPE OF OWNER eq |SITE|')
  !colZone.filter(!exp)
  !colZoneResults = !colZone.results()
  do !i indices !colZoneResults
    !col = object COLLECTION()
    !col.type('CWAY')
    !col.scope(!colZoneResults[!i])
    !colResults = !col.results()
    if(!colResults.set())then
      !colResult.append(!colZoneResults[!i])
    endif

  enddo


  !world[1] = '/*'
  !world[2] = 'World'

  !rows[1] = !world


  do !zone values !colResult
    !row = ARRAY()
    !row.append(!zone.name)
    !row.append(!zone.desc)
    !rows.append(!row)
  enddo

  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Desc')


  !title = object ARRAY()
  !title.append(|Cable Zone Name|)
  !title.append(|Description|)
  !gridName = 'Cable Zones'
  using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE(!gridName, !headings, !title, !rows)
  !this.cablewayGrid.bindToDataSource(!nds)
	!nds.delete()
  if !this.cablewayGrid.getSelectedRows().unset() then
    !this.cablewayGrid.selectRow(1)
  endif



endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   loadRoutes()
--
-- Description: LoadRoutes method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadRoutes()

  -- clear the Grid
  !this.routeGrid.clearGrid()

  -- Collect all association members
  !rpath = object COLLECTION()
  --!rpath.addtype('rpath')
  !rpath.addtype('EXTGEO')
  !rpath.scope( !this.cableGrid.getSelectedRows()[1][1].dbref())

  --!rpath.filter(object EXPRESSION(|type of owner neq 'CABLE'|))
  !this.cwaybranch = !rpath.results()

  if !rpath.results().unset() then
    --cable not routed using extgeo
    return
  endif

  -- Evaluate design members from !colAssmbr
  --!cwayItems = !this.cwaybranch.evaluate(object block ('!this.cwaybranch[!evalIndex].string()'))

  !routes = object ARRAY()
  do !element values !rpath.results()

    -- staRef
    -- get values
    !value = object ARRAY()
    -- names
    --if !element.staRef.type.eq('HATTA') then
    --  !value.append(!element.staRef.flnm.replace('HATTA 1','Head'))
    --elseif !element.staRef.type.eq('TATTA') then
    --  !value.append(!element.staRef.flnm.replace('TATTA 1','Tail'))
    --elseif !element.staRef.type.eq('RATTA') then
    --  !elname = !element.staRef.flnm.replace('RATTA','Route Attachment')
    --  !name = !elname.replace('CONSEQ 1 of','')
    --  !value.append(!name)
    --elseif !element.staRef.type.eq('RNODE') then
    --  !elname = !element.staRef.flnm.replace('RNODE','Route Node')
    --  !name = !elname.replace('RTFEAT 1 of','')
    --  !value.append(!name)
    --else
      !value.append(!element.staRef.flnm)
      handle (2,202)
      	!!alert.error('Cannot populate route list, Please check your data for any invalid references')
      break
      endhandle
    --endif
    -- types
      !value.append(!element.staRef.type)
    -- branch
    if !element.staRef.type.eq('HATTA') or !element.staRef.type.eq('TATTA') then
     !value.append(!element.staRef.owner.name)
    elseif !element.staRef.type.eq('RATTA') or !element.staRef.type.eq('RNODE') then
     !value.append(!element.staRef.owner.owner.name)
    endif
    !routes.append(!value)

    -- endref
    -- get values
    !value = object ARRAY()
    -- names
    --if !element.endRef.type.eq('HATTA') then
    --  !value.append(!element.endRef.flnm.replace('HATTA 1','Head'))
    --elseif !element.endRef.type.eq('TATTA') then
    --  !value.append(!element.endRef.flnm.replace('TATTA 1','Tail'))
    --elseif !element.endRef.type.eq('RATTA') then
    --  !elname = !element.endRef.flnm.replace('RATTA','Route Attachment')
    --  !name = !elname.replace('CONSEQ 1 of','')
    --  !value.append(!name)
    --elseif !element.endRef.type.eq('RNODE') then
    --  !elname = !element.endRef.flnm.replace('RNODE','Route Node')
    --  !name = !elname.replace('RTFEAT 1 of','')
    --  !value.append(!name)
    --else
      !value.append(!element.endRef.flnm)
    --endif
    -- types
      !value.append(!element.endRef.type)
    -- branch
    if !element.endRef.type.eq('HATTA') or !element.endRef.type.eq('TATTA') then
     !value.append(!element.endRef.owner.name)
    elseif !element.endRef.type.eq('RATTA') or !element.endRef.type.eq('RNODE') then
     !value.append(!element.endRef.owner.owner.name)
    endif
    !routes.append(!value)

  enddo

  !rHeadings = ARRAY()
  !rHeadings.append('Route Element')
  --!rHeadings.append('Iclass')
  !rHeadings.append('Type')
  !rHeadings.append('Branch')

  !gridRoutes = 'Routes'
  using namespace  'Aveva.Pdms.Presentation'
  --!rts = object NETDATASOURCE(!gridRoutes, !rHeadings, !cwayItems)
  !rts = object NETDATASOURCE(!gridRoutes, !rHeadings, !routes)
  !this.routeGrid.bindToDataSource(!rts)
	!rts.delete()
  !this.routeGrid.autoFitColumns()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   loadGrid()
--
-- Description: Update grid method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadGrid()

  !rows = !this.cableGrid.getRows()

  do !rowIndex indices !rows
    do !cols indices !rows[!rowIndex]
      if !rows[!rowIndex][!cols].eq('Nulref') then
        !this.setCellImage(!rowIndex, !cols, 'ERROR' )
      elseif !rows[!rowIndex][!cols].substring(1,1).eq('=') then
        --!this.setCellImage(!rowIndex, !cols, 'FAIL' )
        !this.setCellImage(!rowIndex, !cols, 'SUCCESS' )
      else
        !this.setCellImage(!rowIndex, !cols, 'VALID' )
      endif
    enddo
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   setCellImage
--
-- Description:
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCellImage(!row is REAL, !column is REAL , !mode is STRING)

   -- State lookup table
-- Before data processed:
--     VALID     New element - no errors found in input data
--     EXISTS    Existing element - no errors found in input data
--     ERROR     Error found in input data
-- After data processed:
--     SUCCESS   Row processed successfully
--     FAIL      Error occurred during processing
  !stateList[1] = 'VALID'
  !stateList[2] = 'EXISTS'
  !stateList[3] = 'ERROR'
  !stateList[4] = 'SUCCESS'
  !stateList[5] = 'FAIL'
  -- icon lookup table
  !icon[1]      = !!pml.getPathName('accept.png')
  !icon[2]      = !!pml.getPathName('elementmodify12.png')
  !icon[3]      = !!pml.getPathName('createproblem12.png')
  !icon[4]      = !!pml.getPathName('valid12.png')
  !icon[5]      = !!pml.getPathName('failed12.png')

  -- set cell image
  !state = !mode
  if( !state.empty().not() ) then
    !iconIndex = !stateList.findfirst(!state)
    !this.cableGrid.setCellImage(!row,!column,!icon[!iconIndex])
    !this.cableGrid.setAlternateRowColor('Navy Blue')
  endif
  if( !state.empty().not() ) then
    !iconIndex = !stateList.findfirst(!state)
    !this.routeGrid.setCellImage(!row,!column,!icon[!iconIndex])
    !this.routeGrid.setAlternateRowColor('Navy Blue')
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    routeCable
--
-- Description: routeCable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .routeCable(!cable is DBREF, !zoneArray is ARRAY)
  !cables  = object ARRAY()
  !cables.append(!cable)
  !rlseState = !this.setRLSE(!cables)
  if(!rlseState.not())then
    !!alert.warning('Select CWAY Zone to route cable.')
    return
  endif
  --!this.cableManager.setConnectionsGraph(!this.connectionGraph)
  !this.cableManager.routeCable(!cable)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle
  --!!cblRouteCable(!cable, !this.connectionGraph, !zoneArray)
  !this.loadCables()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    setRLSE
--
-- Description: routeCable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setRLSE(!cables is ARRAY) is BOOLEAN

  !zone  = !this.cablewayGrid.getSelectedRows()[1][1]
  if(!zone.unset())then
    return false
  endif
  do !cab values !cables
    !!ce = !cab
  --!!ce = !cable
   if ( !zone.occurs('/*') gt 0 ) then
		  rlse all cwbran
	  else
		  rlse all cwbran for $!zone
		endif
  enddo
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    routeCables
--
-- Description: routeCable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .routeCables(!mode is STRING)

  --P-19202: Method modified to build the connection graph and then route each
  --cable using routeCableWithGraph() instead of routeMultipleCables(), this has
  --been done because using the second function means giving control to core code
  --for too long disabling the GUI. This also, means a progress bar can be incorporated
  --using  !!fmsys.setProgress(REAL)

  --P-19202: Make sure the progress bar is hidden. This also Conveniently stops the menu ghost.

  if (!this.cableGrid.getSelectedRows().empty()) then
      !!alert.warning('No cables selected.')
      return
  endif

   !!fmsys.setProgress(0)

  !connectionManager = object MDRCONNECTIONMANAGER()

  !zoneArray = ARRAY()
  do !index values !this.cablewayGrid.getSelectedRows()
    !zoneArray.append(!index[1].dbref())
  enddo

  if(!this.cablewayGrid.getSelectedRows().size().eq(0))then
    !!alert.message('No zone having cableways selected.')
    return
  endif

   !!fmsys.setProgress(1)
  !this.connectionGraph =  !connectionManager.createConnectionGraphFromBranches(!zoneArray)
  !this.cableManager.setConnectionsGraph(!this.connectionGraph)
   !!fmsys.setProgress(5)

  !selectedCables  = object ARRAY()
  !tempFilchkTrue = object ARRAY()
  if !mode.eq('SELECTED') then
    do !cables values !this.selectedCablesArray
      if ( not !cables.dbref().filchk) then
        !selectedCables.append(!cables.dbref())
      else
        !tempFilchkTrue.append(!cables.dbref())
      endif

    enddo
    !selectedCables.appendArray(!tempFilchkTrue)

  else
    !this.loadCables()
    !cblstat = object ARRAY()
    do !cables values !this.cableGrid.getColumn(1)
      if ( not !cables.dbref().filchk) then
        !selectedCables.append(!cables.dbref())
      else
        !tempFilchkTrue.append(!cables.dbref())
      endif
    enddo
    !selectedCables.appendArray(!tempFilchkTrue)
  endif

   !!fmsys.setProgress(8)

  !cblstat = object ARRAY()
  do !i from 1 to !selectedCables.size()
    if(!selectedCables[!i].cbsta.eq(5) or !selectedCables[!i].cbsta.eq(3))then
      !cblsta = !selectedCables[!i]
      !cblstat.append(!cblsta)
    endif
  enddo

  if(!cblstat.set())then
    !conf = !!alert.confirm('Some Cables are manually or partially routed,Do you want to Auto-route the cables?')
    if(!conf.eq('NO'))then
      return
    endif
  endif

  !rlseState = !this.setRLSE(!selectedCables)
  if(!rlseState.not())then
    !!alert.warning('Select CWAY Zone to route cable.')
    return
  endif

   !!fmsys.setProgress(10)

  --P-19202: Update the progress bar incrementally to update the user with the routing progress.
  !failedArray = object ARRAY()
  !increment = 90 / !selectedCables.size()
  do !index index !selectedCables
    !this.cableManager.routeCableWithGraph(!selectedCables[!index], !this.connectionGraph)
    handle any
      !failedArray.append(!selectedCables[!index])
    endhandle
     !!fmsys.setProgress(10 + (!increment * !index))
  enddo

  --P-19202: If any of the cables fail to route notify the user.
  !string = ''
  if !failedArray.size().gt(0) then
    do !value values !failedArray
      !string = !string + !value.name + ' '
    enddo
    !string = !string + ' .'
    !!alert.warning('Failed to route ' + !failedArray.size().string() + ' cables: ' + !string + $
           ' Try checking the RANEQ attribute and make sure the appropriate cableways are selected.')
  endif

  -- update route list
  !this.loadRoutes()
  !this.loadCables()

   !!fmsys.setProgress(0)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    unrouteCable
--
-- Description: un-route cable method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unrouteCable(!mode is STRING)


  if (!this.cableGrid.getSelectedRows().empty()) then
      !!alert.warning('No cables selected.')
      return
  endif

   --!connectionManager = object MDRCONNECTIONMANAGER()
  !cabManager = object CABLEMANAGER()

   !!fmsys.setProgress(0)

  --!zoneArray = ARRAY()
  -- do !index values !this.cablewayGrid.getSelectedRows()
  --     !zoneArray.append(!index[1].dbref())
  --  enddo
  --
  -- if(!zoneArray.size().eq(0))then
  --    !!alert.message('No zone having cableways selected.')
  --    return
  -- endif
  --
  --!this.connectionGraph =  !connectionManager.createConnectionGraphFromBranches(!zoneArray)

  !noOfCables = !this.selectedCablesArray.size()
  !increment = 100 / !noOfCables
  if !mode.eq('SELECT')then
    do !index index !this.selectedCablesArray
      !cabManager.unrouteCable(!this.selectedCablesArray[!index].dbref())
       !!fmsys.setProgress(!increment * !index)
    enddo
  endif
  !this.loadRoutes()
  !this.loadCables()

   !!fmsys.setProgress(0)

endmethod

------------------------------------------------------------------------

define method .cableGridPopupCallback(!a is ARRAY)

  -- Disable the 'modify attributes' pop up when there is multiple selection
  if( !this.cableGrid.getSelectedRows().size() gt 1) then
    !this.cableGridPopup.setFieldProperty('MODIFY', 'ACTIVE', false)
  elseif (!this.cableGrid.getSelectedRows().size() eq 1) then
    !this.cableGridPopup.setFieldProperty('MODIFY', 'ACTIVE', true)
  endif

  if (defined( !a[2])) then
    !this.cableFrame.popup = !this.cableGridPopup
    !this.cableFrame.showPopup(!a[0], !a[1])
    !this.selectedCablesArray = !a[2]
  endif

endmethod
