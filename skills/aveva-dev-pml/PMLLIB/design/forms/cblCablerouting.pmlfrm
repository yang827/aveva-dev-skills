  !this.cablewayFrame.popup = !this.cablewayGridPopup
  !this.cablewayFrame.showPopup(!a[0], !a[1])

endmethod

------------------------------------------------------------------------
define method .cableGridAfterSelectCallback(!a is ARRAY)

  !this.enhanced.clear()
   --AID clear text all
  !!aidNumbers.hide(!this.entryAidNum)
  !!aidNumbers.hide(!this.exitAidNum)

  if !this.cableGrid.getSelectedRows().size().eq(1) then
  -- Call back on row selection
    !cableRef =  !this.cableGrid.getSelectedRows()[1][1].dbref()
    !!ce = !cableRef
    if (!this.tog1.val) then
     !this.enhanced.addItem(!!ce)
    endif
    if (!this.pmlFrame2.visible) then
      !this.loadRoutes()
    endif
    !startPos = !cableRef.staRef.position.wrt( /* )
    handle ANY
    elsehandle NONE
      !this.aidText(!this.entryAidNum, 'Start', !startPos)
    endhandle
    !endPos = !cableRef.endRef.position.wrt( /* )
    handle ANY
    elsehandle NONE
      !this.aidText(!this.exitAidNum, 'End', !endPos)
    endhandle

    !startItem = !cableRef.staRef
    !endItem = !cableRef.endRef
    if !startItem.unset().not() then
      !this.enhanced.addItem(!startItem)
    endif
    if !endItem.unset().not() then
      !this.enhanced.addItem(!endItem)
    endif

    -- mark the route
    !routeElements   = !cableRef.cbpref
    handle any
      !routeElements = ARRAY()
    endhandle
    !numberPoints    = !routeElements.size()
    -- mark route exept for start and end already marked
    !boxSize         = !cableRef.propre.attribute('OUTDIAMETER')
    handle any
      !boxSize       = object REAL()
    endhandle
    if( !boxSize.unset() ) then
      !boxSize       = 8mm
    else
      !boxSize       = !boxSize.max(8mm)
    endif
    !gBox            = object GMFBOX()
    !gBox.xLength    = !boxSize
    !gBox.yLength    = !boxSize
    do !routeIndex from 2 to !numberPoints
      !line               = object LINE(!routeElements[!routeIndex - 1].position, !routeElements[!routeIndex].position)
      !length             = !line.length()
      if(!length gt 2mm) then
        !boxDir           = !line.direction()
        !orientation      = object ORIENTATION('Z IS $!<boxDir>')
        !gBox.zLength     = !length
        !gBox.position    = !line.proportion(0.5)
        !gBox.orientation = !orientation
        !graphBox         = object GPHBOX(!gBox)
        !graphBox.filled(true)
        !graphBox.draw(!this.entryAidNum, false)
      endif
    enddo
  elseif !this.cableGrid.getSelectedRows().size().geq(1) then
    if (!this.tog1.val) then
      !array = !this.cableGrid.getSelectedRows()
      do !i index !array
        !cbk = !array[!i][1].dbref()
        !!ce = !cbk
        !this.enhanced.addItem(!!ce)
      enddo
    endif
  endif
  !this.selectedCablesArray = !a[0]

  --if !this.cableGrid.getSelectedRows().unset() then
  --!this.cableGrid.selectRow(1)
  --endif
  --!this.loadRoutes()

endmethod

------------------------------------------------------------------------
define method .routeAfterSelectCallback(!a is ARRAY)

  !unmark = !this.previousMark
  unmark $!unmark
  handle ANY
    -- in case unset
  endhandle

  if !this.routeGrid.getSelectedRows().size().eq(1) then
    -- Call back on row selection
    !pathRef =  !this.routeGrid.getSelectedRows()[1][1].dbref()
    !!ce = !pathRef
    mark ce
    !this.previousMark = !!ce
  endif

endmethod

------------------------------------------------------------------------
define method .enhance()

  do !i from 1 to (!this.selectedCablesArray.size())
    !myDbref = object DBREF(!this.selectedCablesArray[!i])
    !this.enhanced.addItem(!myDbref)
  enddo

endmethod


------------------------------------------------------------------------
define method .unEnhance()

  do !i from 1 to (!this.selectedCablesArray.size())
    !myDbref = object DBREF(!this.selectedCablesArray[!i])
    !this.enhanced.removeItem(!myDbref)
  enddo

endmethod
