define method .state(!gadget is GADGET)

	if (!gadget.val) then
		!array = !this.cableGrid.getSelectedRows()
    do !i index !array
    	!cbl = !array[!i][1].dbref()
      !!ce = !cbl
      !this.enhanced.addItem(!!ce)
    enddo
	else
	  !this.enhanced.clear()
	endif

endmethod
