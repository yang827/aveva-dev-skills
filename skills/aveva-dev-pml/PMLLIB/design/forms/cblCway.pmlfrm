  !this.rnodeOwnElement.val      =  'Cableway Branch : ' & !this.cableway.cwbran.flnn
  !this.rnodeCeTag.val            =  'Current Element     : ' & !this.cableway.activeElement.flnn

  if (!formTask eq 'CREATE') then
    !this.createRnodeApply.visible       = TRUE
