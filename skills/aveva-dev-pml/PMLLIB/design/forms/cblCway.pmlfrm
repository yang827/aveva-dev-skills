--
-- File:           cblCway.pmlfrm
-- Type:           Form Definition
-- Group:          Cabling Application
--
-- Keyword:        CABLING
-- Module:         design
-- Replaces:
--
-- Author:         M.Karthikeyan AVEVA DDC
-- Created:        Thu Apr 14 2006
-- Last Modified:  Anand Kalathil
-- Description:
-- Cableway creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addIclass(GADGET,STRING)         -                   adds the user interference class to gadget
--  aid(STRING,POSITION)             -
--  align(STRING)                    -                   align with element
--  autoNameCe(STRING)               -
--  back(STRING)                     -                   Method for changing the ce on applying back button
--  branchGadgets(STRING)            -                   Sets the gadgets required for
--  cablewayGadgets(STRING)          -                   Sets the  gadgets required to create
--  cblCway()                        -
--  changeMode(STRING,STRING)        -                   removes the selected tier
--  checkConnections(DBREF)          -                   checks the connection for a branch
--  checkDirection()                 BOOLEAN             checks the YDIR of rpath with respect to gadget values
--  chooseRnodeSpec()                -                   show the choose form for route node specification
--  clearAids()                      -                   Creation of aid text and lines
--  copyPosValues(STRING,STRING)     -                   copies the values between position gadgets
--  create(STRING)                   -                   create the elements
--  createData(STRING)               -
--  currentElement()                 -
--  curveGadgets(STRING)             -                   Sets the gadgets required to create
--  delete(STRING)                   -                   delete the elements
--  derivePickedPoint(EDGPICKDATA)   -                   derives the picked POINTR from edg pick
--  discard()                        -                   Discard Changes
--  disconnect(STRING)               -                   Disconnect Branch head and tail
--  dismiss()                        -
--  distance(STRING)                 -                   calculates the distance of RATTA position
--  drawBranch()                     -                   Draw the branch using aid lines
--  edgPopulate(STRING,STRING,STRING) -                   Populate the gadgets after getting the values from edg
--  extgeoGadgets(STRING)            -                   Sets the gadgets required to create
--  firstShown()                     -                   first shown call
--  getCurrentFillLevel()            -                   Get current cway branch fill level and return on form para gadget for user.
--  getLength(POSITION,POSITION)     REAL                Calculates the length between two positions
--  getPosFromCntrl(ARRAY)           POSITION            Converts array from position control to position
--  goForDress()                     -                   show the dressing form
--  loadData(STRING)                 -
--  loadIclass()                     -                   loads the interference class from cable property db
--  loadObjectMembers(STRING)        -                   Load the Cableway object members
--  markPoint(BOOLEAN)               -                   marks the route points
--  modify(STRING)                   -                   modify the elements
--  modifyShapeGadgets()             -                   Modifies the shape gadgets
--  modifyStatus(DBREF)              BOOLEAN             Check Whether changes has been made or not
--  moveZdis(STRING,GADGET)          -                   sets the zdistance incremental value
--  nameCheck(STRING)                -
--  offsetActivate(GADGET,STRING)    -                   activates the offset gadgets on route node task
--  offsetDistance(STRING)           BOOLEAN             Distance from start of segment for offset
--  optAction(STRING)                -                   Action carried out with the picked Element
--  pickCnode()                      -                   picks CNODEs from form
--  pickElement(STRING,STRING,STRING,STRING) -
--  pickPoint(STRING)                -
--  pointrAction()                   -
--  pointrGadgets(STRING)            -                   Sets the gadgets required to create
--  posCntrl(STRING,STRING)          -                   Initialise Position Control
--  rattaGadgets(STRING)             -                   Sets the gadgets required to create
--  removeIclass(GADGET)             -                   removes the selected iclass
--  reorderRnodes(DBREF)             -                   reorders and puts the RNODEs in the correct position in hierarchy
--  rnodeGadgets(STRING)             -                   Sets the gadgets required to create
--  rpathGadgets(STRING)             -                   Sets the gadgets required to create
--  rsectGadgets(STRING)             -                   Sets the gadgets required to create
--  setActiveElement()               -
--  setLengthAndDirection(STRING)    -                   Sets Length and direction Gadgets
--  setPointrPositionGadget()        -                   Sets POINTR position Gadgets
--  setRnodeSpec()                   -                   sets the route node specification
--  setSpco(GADGET,GADGET)           -                   Set the different SPCOs based on the spec selected
--  setTask(STRING,STRING)           -
--  showCblListCables()              -                   Show cblListCables form
--  switchMode()                     -                   switches to back or forward mode
--  updateFrame()                    -                   removes the selected iclass
--  validMaxFill(GADGET,STRING)      -                   Validate input to maximum fill gadgets
--  validateBendRadius(GADGET,STRING) -                   Validates the bend radius for CWBRAN
--  validateConnRef()                -                   Validates the connection reference for RNODE
--  validateEntry(GADGET,STRING)     -                   Set unset gadget values to zero
--  validateRule()                   -                   Validates the rllo syntax
--


-- Import DLL
import 'PositionControl'
handle ANY
endhandle

setup form !!cblCway dialog dock right  NoAlign

  frame .cwayFrame        panel               anchor l+t                      at x0 y0

    paragraph .cwayCeTag              anchor l+t       at x0.1       ymax        text  'Current Element : '              width 30
    paragraph .cwayNameTag            anchor l+t       at x0.1       ymax+0.2    text  'Cableway Name:'                  width 12
    text      .cwayName               anchor l+t       at xmax       ymin        callback '!this.nameCheck(|CWAY|)'      width 17 is STRING
    button    .cwayCurrElement 'CE'  linklabel anchor l+t  at xmax   ymin        callback '!this.currentElement()' tooltip 'Select an Element and modify'
    button    .autoName               anchor l+t       at xmax+0.5   ymin        pixmap callback '!this.autoNameCe(|CWAY|)' tooltip 'Autoname Cableway'


    paragraph .cwayAttrib             anchor l+t       at x0.1       ymax+0.1    text  'Attributes'
    line      .cwayLine               anchor l+t       at x0         ymax     horizontal                width 39

    --Element basic data
    paragraph .cwayDescTag            anchor l+t       at xmin                         ymax+0.5                  text     'Description:'
    text      .cwayDesc               anchor l+t       at xmax.cwayDescTag+0.1         ymin.cwayDescTag          callback ''                  width 25 is STRING
    paragraph .cwayFuncTag            anchor l+t       at xmin.cwayDescTag             ymax.cwayDesc+0.1         text     'Function:   '
    text      .cwayFunc               anchor l+t       at xmax.cwayFuncTag+0.1         ymin.cwayFuncTag          callback ''                  width 25 is STRING
    paragraph .cwayPurpTag            anchor l+t       at xmin.cwayFuncTag             ymax.cwayFunc+0.1         text     'Purpose:    '
    text      .cwayPurp               anchor l+t       at xmax.cwayPurpTag+0.1         ymin.cwayPurpTag          callback ''                  width 25 is STRING

    -- Cableway Task Gadgets
    button    .createCwayBranch linklabel 'Cableway Branch Create Tasks'            anchor l+t       at x2            ymax+2       callback '!this.setTask(|CREATE|,|CWBRAN|)'
    paragraph .createCwayIcon         anchor l+t    at x0                     ymax+2       pixmap width 16 height 16
    button    .createCwayApply  linklabel   'Create Cableway'    anchor l+t    at xmax+1       ymin         callback '!this.create(|CWAY|)'
    paragraph .modifyCwayIcon         anchor l+t    at x0                     ymin         pixmap width 16 height 16
    button    .modifyCwayApply  linklabel   'Apply Changes'      anchor l+t    at xmax+1          ymin         callback '!this.modify(|CWAY|)'
    paragraph .discardCwayIcon        anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
    button    .discardCwayApply linklabel   'Discard Changes'    anchor l+t    at xmax+1       ymin         callback '!this.discard()'
    paragraph .deleteCwayIcon                                     anchor l+t    at x0           ymax+0.2       pixmap width 16 height 16
    button    .deleteCway linklabel 'Delete Cableway      ' anchor l+t    at xmax+1       ymin        callback '!this.delete(|CWAY|)'
  exit


  frame .cwbranFrame         panel                   anchor l+t                  at x0 y0

    paragraph .cwbranCeTag              anchor l+t          at x0.1     ymax       text  'Current Element :' width 30
    paragraph .cwbranNameTag            anchor l+t          at x0.1     ymax+0.1   text  'Branch Name :'
    text      .cwbranName               anchor l+t          at xmax     ymin       callback '!this.nameCheck(|CWBRAN|)'  width 22 is STRING
    button    .cwbranCurrElement 'CE' linklabel anchor l+t  at xmax+.5  ymin       callback '!this.currentElement()' tooltip 'Select an Element and modify'

    frame .cwbranAtt FoldUpPanel |Attributes|        anchor l+t         at x0           ymax+0.5            width 39 heig 6
      paragraph .cwbranDescTag            anchor l+t     at x0.1            y1       text  'Description :'         width 18
      text      .cwbranDesc               anchor l+t     at xmax+0.1        ymin     callback ''                   width 18 is STRING
      paragraph .cwbranFuncTag            anchor l+t     at x0.1            ymax+0.1 text  'Function :'            width 18
      text      .cwbranFunc               anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 18 is STRING
      paragraph .cwbranPurpTag            anchor l+t     at x0.1            ymax+0.1 text  'Purpose :'             width 18
      text      .cwbranPurp               anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 18 is STRING
      paragraph .bangleTag                anchor l+t     at x0.1            ymax+0.1 text  'Beta Angle :'          width 18
      text      .bangle                   anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 18 is REAL format !!angleFmt
      paragraph .bradTag                  anchor l+t     at x0.1            ymax+0.1 text  'Bend Radius :'         width 18
      text      .brad                     anchor l+t     at xmin.cwbranDesc ymin     callback '!this.validateBendRadius('  width 18 is REAL  format !!distanceFmt
      paragraph .rpathYdirTag             anchor l+t     at x0.1            ymax+0.1 text  'Open Direction :'      width 18
      text      .rpathYdir                anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 18 is DIRECTION
      paragraph .cwbranJustTag            anchor l+t     at x0.1            ymax+0.1 text  'Justification :'       width 18
      option    .cwbranJust               anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 16
      paragraph .cwbranCexsTag            anchor l+t     at x0.1            ymax+0.1 text  'Cable Excess (%) :'    width 18
      text      .cwbranCexs               anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 18 is REAL format !!realFmt
      paragraph .cwbranMaxfilTag          anchor l+t     at x0.1            ymax+0.1 text  'Maximum Fill (%) :'    width 18
      text      .cwbranMaxfil             anchor l+t     at xmin.cwbranDesc ymin     callback ''                   width 18 is REAL
      paragraph .cwbranCurrentFillTag     anchor l+t     at x0.1            ymax+0.1 text  'Current Fill Level (%) :' width 18
      paragraph .cwbranCurrentFill        anchor l+t     at xmin.cwbranDesc ymin                                   width 18

      frame .iclassFrame  at x0.1 ymax
        paragraph .cwbranInterTag        anchor l+t          at x0.1          ymax+0.1 text  'Interference :    '
        rtoggle   .cwbranRllogicalTag  'Cable Route Rule:' anchor l+t    at x1  ymax                tagwidth 14
        rtoggle   .cwbranIclassTag     'Standard Iclass:'  anchor l+t    at x1  ymax+0.1            tagwidth 14
        text      .cwbranRllogical          anchor l+t       at xmin.cwbranDesc ymin.cwbranRllogicalTag    callback '!this.validateRule()' width 17 is STRING
        combobox  .cwbranIclass             anchor l+t       at xmin.cwbranDesc ymin.cwbranIclassTag       callback '!this.addIclass('  width 10
        button    .iclassLoad   linklabel 'Load' anchor l+t  at xmax            ymin     callback  '!this.loadIclass()' width 4 tooltip 'Load standard Interference codes from Properties DB'
      exit
    exit

    paragraph .cwbranSizeTag        anchor l+t     at x0.1            ymax+0.5   text  'Select Volume Size ...'
    line      .cwbranSizeLine       anchor l+t     at x0              ymax       horizontal                width 39
    paragraph .cwbranVShapeTag                     at x0.1            ymax+0.1   text  'Shape:'                                width 18
    option    .cwbranVShape                        at xmin.cwbranDesc ymin       callback '!this.modifyShapeGadgets()'         width 16
    paragraph .cwbranVWidthTag      anchor l+t     at x0.1            ymax+0.1   text  'Width :'                               width 18
    text      .cwbranVWidth         anchor l+t     at xmin.cwbranDesc ymin       callback '!this.validateBendRadius('          width 18 is REAL   format !!distanceFmt
    paragraph .cwbranVHeightTag     anchor l+t     at x0.1            ymax+0.1   text  'Height :'                              width 18
    text      .cwbranVHeight        anchor l+t     at xmin.cwbranDesc ymin       callback '!!gdgtDatChk(!this.cwbranVHeight)'  width 18 is REAL  format !!distanceFmt
    paragraph .cwbranOptionTag      anchor l+t     at x0.1            ymax+0.5   text  'Connections...'
    line      .cwbranOptionLine     anchor l+t     at x0              ymax       horizontal                width 39

    frame .cwbranHeadPosCntrl FoldUpPanel |Branch Head|          anchor l+t           at x0           ymax+0.4            width 39 heig 6

      paragraph .headTag                                       at x0.2   y1      text  'Connect From : '                width 11
      option    .headOpt                                       at xmax   ymin    callback '!this.optAction(|HEAD|)'     width 14
      button    .copyHeadPos 'Copy Tail' linklabel anchor l+t  at xmax+1 ymin    callback '!this.copyPosValues(|TAIL|, |HEAD|)' width 7
      frame  .headPosFrame panel anchor l+t                     at x0.2   ymax+0.2                                       width 35 hei 5
        container .netCwbranHeadFrame PMLNetCONTROL 'NET' dock fill
      exit
      button    .cwbranPickHeadPos  linklabel 'Pick Head Position...' anchor l+t              at x0.2        ymax+0.5    callback '!this.pickElement(|HEAD|, |HEAD|, |ANY|, |cwbranheadposcontrol|)' width 13
      path right
      button    .disconnectHead linklabel 'Disconnect Head' at xmax+9 ymin width 11
      text      .lengthForHead            anchor l+t               at x0.2 ymin  |Distance:| callback '!this.offsetDistance(|Head|)'  tagwidth 7 width 7  is REAL  format !!distanceFmt
      button    .thruHead    linklabel 'Pick...' anchor l+t              at xmax        ymin    callback '!this.align(|head|)' width 4

    exit

    frame .cwbranTailPosCntrl FoldUpPanel |Branch Tail|          anchor l+t           at x0           ymax+0.4            width 39 heig 6

      paragraph .tailTag             at x0.2          y1    text  'Connect To :   '                              width 11
      option    .tailOpt             at xmax          ymin                callback '!this.optAction(|TAIL|)'     width 14
      button    .copyTailPos  'Copy Head' linklabel anchor l+t        at xmax+1        ymin    callback '!this.copyPosValues(|HEAD|, |TAIL|)' width 7
      frame  .tailPosFrame panel anchor l+t at x0.2 ymax+0.2 width 35 hei 5
        container .netCwbranTailFrame PMLNetCONTROL 'NET' dock fill
      exit
      button    .cwbranPickTailPos  linklabel 'Pick Tail Position...' anchor l+t              at x0.2        ymax+0.5    callback '!this.pickElement(|HEAD|, |HEAD|, |ANY|, |cwbrantailposcontrol|)' width 13
      button    .disconnectTail linklabel 'Disconnect Tail' at xmax+9 ymin width 11
      text      .lengthForTail            anchor l+t               at x0.2 ymin    |Distance:| callback '!this.offsetDistance(|Tail|)' tagwidth 7 width 7 is REAL  format !!distanceFmt
      button    .thruTail    linklabel 'Pick...' anchor l+t              at xmax        ymin    callback '!this.align(|tail|)' width 4

    exit
    button    .cwbranTasks        linklabel 'Branch Tasks'              anchor l+t        at x1   ymax+0.3       callback |!this.setTask(!this.task,'CWBRANTASKS')|
    button    .cwlistCables       linklabel 'List Associated Cables...'     anchor l+t        at xmax+7 ymin         callback |!this.showCblListCables()|  width 15

    toggle    .ortho            anchor l+t       at x1      ymax+0.1       'Create Orthogonal Route'  callback '!this.drawBranch()'
    option    .orthoOpt         at x1          ymax 'Direction Sequence:'                callback '!this.drawBranch()'     width 6
    toggle    .markPointCwbranFrame       anchor l+t       at x1            ymax.ortho     '  Mark Route Points' callback '!this.markPoint(!this.markPointCwbranFrame.val)'
    paragraph .createCwbranIcon                             anchor l+t    at x0                     ymax       pixmap width 16 height 16
    button    .createCwbranApply  linklabel   'Create Cableway Branch'      anchor l+t    at xmax+1       ymin         callback '!this.create(|CWBRAN|)'
    paragraph .modifyCwbranIcon                             anchor l+t    at x0                     ymin         pixmap width 16 height 16
    button    .modifyCwbranApply  linklabel   'Apply Changes'      anchor l+t    at xmax+1          ymin         callback '!this.modify(|CWBRAN|)'
    paragraph .discardCwbranIcon                             anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
    button    .discardCwbranApply  linklabel   'Discard Changes'      anchor l+t    at xmax+1       ymin         callback '!this.discard()'
    paragraph .backCwayIcon                                 anchor l+t    at x0            ymax         pixmap width 16 height 16
    button    .cwbranBack  linklabel 'Back to Cableway Modify Tasks'   anchor l+t    at xmax+1        ymin         callback '!this.setTask(|MODIFY|,|CWAY|)'


  exit


  frame .cwbranSecondFrame         panel                   anchor l+t                  at x0 y0

    paragraph .cwbranSelect           anchor l+t       at x0.1       ymax            text  'Select Branch...'     width 30
    line      .cwbranSelectLine       anchor l+t       at x0         ymax            horizontal width 39
    --Branch list gadgets
    list .branchesTable                     anchor l+t       at x0.5          ymax+0.5           callback '!this.setActiveElement()' columns single width 35 lines 5


    -- Branch Task Gadgets
    button    .createPointr linklabel 'Define Path / Route...'       anchor l+t       at x2       ymax+1   callback '!this.setTask(|CREATE|,|POINTR|)'
    button    .createRnode  linklabel 'Create Route Node...'         anchor l+t       at x2       ymax     callback '!this.setTask(|CREATE|,|RNODE|)'
    button    .createRatta  linklabel 'Create Route Attachment Points...'         anchor l+t       at x2       ymax     callback '!this.setTask(|CREATE|,|RATTA|)'
    button    .deleteBranch linklabel 'Delete Branch      '          anchor l+t       at x2       ymax       callback '!this.delete(|CWBRAN|)'
    button    .disconnect   linklabel 'Disconnect Branch  '          anchor l+t       at x2       ymax       callback '!this.disconnect(|BOTH|)'
    button    .checkConn    linklabel 'Check Connections...  '       anchor l+t       at x2       ymax       callback |!this.checkConnections(!this.cableway.cwbran)|
    button    .cwbranDress  linklabel 'Dressing...  '                anchor l+t       at x2       ymax       callback |!this.goForDress()|

    paragraph .backCwbranIcon                                 anchor l+t    at x1            ymax+1         pixmap width 16 height 16
    button    .cwbranTaskBack  linklabel 'Back to Cableway Branch Modify Tasks'   anchor l+t    at xmax+1        ymin         callback |!this.back('CWBRAN')|

  exit


  --RPATH element selection

  frame .rpathSelectionFrame          panel                  anchor l+t                  at x0 y0

    paragraph .rpathCeTag                anchor l+t       at x0.1         ymax            width 35
    button    .rpathCurrElement 'CE'     linklabel   anchor l+t         at x1       ymax+0.5            callback '!this.currentElement()' tooltip 'Select an Element and modify'
    line      .rpathLine                 anchor l+t       at x0              ymax            horizontal width 39
    paragraph  .rpathElementList  anchor l+t   at x0 ymax+1   text ' Select Element...'

    frame .options 'Options' anchor l+t at x3 ymax+0.2
      rtoggle .selRpoint |Route Point|            anchor l+t     at xmin+1 ymax callback |!this.rpathElement = 'POINTR' !this.rpathNext.tag = 'Create Route Point Tasks'|
      rtoggle .selCurve |Curve|                   anchor l+t     at xmin ymax callback |!this.rpathElement = 'CURVE' !this.rpathNext.tag = 'Create Curve Tasks'|
      rtoggle .selExgeo |External Geometry|       anchor l+t     at xmin ymax callback |!this.rpathElement = 'EXTGEO' !this.rpathNext.tag = 'Create External geometry Tasks'|
      rtoggle .selRsect |Route Section|           anchor l+t     at xmin ymax callback |!this.rpathElement = 'RSECT' !this.rpathNext.tag = 'Create Route Section Tasks'|
    exit

    button .rpathNext  linklabel 'Route Point Create Tasks'  anchor l+t   at x1 ymax+2  callback |!this.setTask('CREATE',!this.rpathElement)|
    paragraph .backCwbranTaskIcon                                 anchor l+t    at x0            ymax         pixmap width 16 height 16
    button .rpathBack  linklabel 'Back to Branch Tasks'  anchor l+t   at xmax+1 ymin  callback |!this.back('CWBRANTASKS')|

  exit

  -- POINTR

  frame .pointrFrame          panel      anchor l+t         at x0 y0
    paragraph .pointrOwnElement           anchor l+t         at x0.1          ymax            text  'Cableway branch : '     width 35
    paragraph .pointrCeTag                anchor l+t         at x0.1          ymax            width 35
    button    .pointrCurrElement 'CE' linklabel  anchor l+t  at x0.1          ymax+0.5        callback '!this.currentElement()' tooltip 'Select an Element and modify'
    line      .pointrLine                 anchor l+t         at x0            ymax            horizontal width 39
    paragraph .directionTag               anchor l+t         at x0            ymax+0.2        text  'Direction from Previous :' width 20
    text      .direction                  anchor l+t         at xmax+1        ymin            callback |!this.setPointrPositionGadget()| width 16 is DIRECTION
    paragraph .lengthTag                  anchor l+t         at x0            ymax+0.2        text  'Distance from Previous : ' width 20
    text      .length                     anchor l+t         at xmax+1        ymin            callback |!this.setPointrPositionGadget()| width 16 is REAL  format !!distanceFmt

    frame .pointrPosCntrl FoldUpPanel |Route Point Position|          anchor l+t           at x0           ymax+0.2            width 39
      frame .pposFrame panel anchor l+t at x0.5 ymax width 37 hei 5
        container .netPointrFrame PMLNetCONTROL 'NET' dock fill
      exit
      button .pointrPos    linklabel 'Pick  Position...' anchor l+t  at x0.5     ymax+0.5    callback '!this.pickElement(|HEAD|, |HEAD|, |ANY|, |pointrposcontrol|)'
      button .pointrPrev   linklabel 'Copy  Previous'    anchor l+t  at x0.5     ymax        callback '!this.copyPosValues(|POINTR|,|PREV|)'
      button .pointrNext   linklabel 'Copy  Next'        anchor l+t  at x0.5     ymax        callback '!this.copyPosValues(|POINTR|,|NEXT|)'
    exit
    text     .fradius       'Fillet Radius :' tagwidth 20    at x0.2      ymax+0.5           callback '!!gdgtDatChk(!this.fradius)' width 16 is REAL  format !!distanceFmt

    paragraph .pointrSelect           anchor l+t       at x0.1       ymax+1            text  'Select Route Point...'     width 30
    line      .pointrSelectLine       anchor l+t       at x0         ymax              horizontal width 39
    list .pointrTable                 anchor l+t       at x1          ymax+0.5         callback '!this.pointrAction()' columns single width 35 lines 8

    frame .pointrMode 'Mode' anchor l+t at x1 ymax+0.2
      rtoggle .pointrCreateMode |Creation|            anchor l+t     at x1 ymax callback |!this.changeMode('CREATE','POINTR')|
      path right
      rtoggle .pointrModifyMode |Modification|            anchor l+t     at xmax+7 ymin callback |!this.changeMode('MODIFY','POINTR')|
    exit

    toggle    .backwardMode               anchor l+t       at x1            ymax     '  Backwards' callback '!this.switchMode()'
    toggle    .markPointPointrFrame       anchor l+t       at x1            ymax     '  Mark Route Points' callback '!this.markPoint(!this.markPointPointrFrame.val)'

    button    .pointrListCables   linklabel 'List Associated Cables...'     anchor l+t        at x0 ymax+1           callback |!this.showCblListCables()| width 15
    paragraph .createPointrIcon                             anchor l+t    at x0                     ymax+0.2       pixmap width 16 height 16
    button    .createPointrApply  linklabel   'Create Route Point'      anchor l+t    at xmax+1       ymin       callback '!this.create(|POINTR|)'
    paragraph .modifyPointrIcon                             anchor l+t    at x0                     ymin         pixmap width 16 height 16
    button    .modifyPointrApply  linklabel   'Apply Changes'      anchor l+t    at xmax+1          ymin         callback '!this.modify(|POINTR|)'
    paragraph .discardPointrIcon                             anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
    button    .discardPointrApply  linklabel   'Discard Changes'      anchor l+t    at xmax+1       ymin         callback '!this.discard()'
    paragraph .pointrBackRpathIcon                                 anchor l+t    at x0            ymax         pixmap width 16 height 16
    button .pointrBack   linklabel 'Back to Branch Tasks'    anchor l+t   at xmax+1 ymin  callback |!this.back('CWBRANTASKS')|

  exit

  -- RNODE

  frame .rnodeFrame          panel                  anchor l+t                  at x0 y0
    paragraph .rnodeOwnElement        anchor l+t       at x0.1             ymax     text  'Cableway Branch : '             width 35
    paragraph .rnodeCeTag             anchor l+t       at x0.1             ymax                                            width 35
    paragraph .rnodeNameTag           anchor l+t       at x0.1             ymax+0.5 text  'Route Node Name:  '             width 16
    text      .rnodeName              anchor l+t       at xmax             ymin     callback '!this.nameCheck(|RNODE|)'    width 14 is STRING
    button    .rnodeCurrElement 'CE' linklabel  anchor l+t  at xmax        ymin     callback '!this.currentElement()' tooltip 'Select an Element and modify'
    button    .rnodeAutoName          anchor l+t       at xmax             ymin     pixmap callback '!this.autoNameCe(|RNODE|)' tooltip 'Autoname Route Node'
    paragraph .rnodeGeneral           anchor l+t       at x0.1             ymax+0.2 text  'General Attributes'    width 30
    line      .rnodeLineone           anchor l+t       at x0               ymax        horizontal                 width 39
    paragraph .rnodeDescTag           anchor l+t       at x0.1             ymax+0.5 text  'Description:      '    width 16
    text      .rnodeDesc              anchor l+t       at xmin.rnodeName   ymin     callback ''                   width 20 is STRING
    paragraph .rnodeFuncTag           anchor l+t       at x0.1             ymax     text  'Function:         '    width 16
    text      .rnodeFunc              anchor l+t       at xmin.rnodeName   ymin     callback ''                   width 20 is STRING
    paragraph .rnodePurpTag           anchor l+t       at x0.1             ymax     text  'Purpose:          '    width 16
    text      .rnodePurp              anchor l+t       at xmin.rnodeName   ymin     callback ''                   width 20 is STRING
    paragraph .rnodeTypeOptTag        anchor l+t       at x0.1             ymax     text  'Route Node Type:  '    width 16
    option    .rnodeTypeOpt           anchor l+t       at xmin.rnodeName   ymin     callback '!this.offsetActivate(' width 18

    paragraph .rnodePosition          anchor l+t       at x0.1             ymax+1   text  'Positioning'     width 30
    line      .rnodeLineTwo           anchor l+t       at x0               ymax     horizontal              width 39

    paragraph .rnodePosnTag           anchor l+t       at x0.1             ymax+0.5 text  'Reference Point:   '                width 16
    option    .rnodePosn              anchor l+t       at xmin.rnodeName   ymin     callback '!this.offsetDistance(|RNODE|)'   width 12
    button    .rnodePosnPick  linklabel 'Pick...' anchor l+t  at xmax      ymin     callback '!this.pickPoint(|RNODE|)'
    paragraph .rnodeZdisTag           anchor l+t       at x0.1             ymax     text  'Offset Distance:   '                width 16
    text      .rnodeZdis              anchor l+t       at xmin.rnodeName   ymin     callback '!this.offsetDistance(|RNODE|)'   width 14 is REAL  format !!distanceFmt
    button    .rnodeZdisPick  linklabel 'Pick...' anchor l+t  at xmax      ymin     callback '!this.align(|RNODE|)'
    paragraph .rnodeMoveTag           anchor l+t       at x0.1             ymax     text  'Move Offset:       '                width 16
    button    .rnodeLeftMove          anchor l+t       at xmin.rnodeName   ymin     pixmap callback '!this.moveZdis(|DECREASE|,!this.rnodeZdis)' tooltip 'Decrease Offset' width 16
    text      .rnodeMoveValue         anchor l+t       at xmax+0.5         ymin     callback ''                                width 11 is REAL  format !!distanceFmt
    button    .rnodeRightMove         anchor l+t       at xmax+0.5         ymin     pixmap callback '!this.moveZdis(|INCREASE|,!this.rnodeZdis)' tooltip 'Increase Offset' width 16

    paragraph .rnodePkdisTag          anchor l+t       at x0.1             ymax     text  'Prop distance:     '                width 16
    text      .rnodePkdis             anchor l+t       at xmin.rnodeName   ymin     callback '!this.offsetDistance(|RNODE|)'   width 20 is REAL  format !!realFmt
    paragraph .rnodeXoffTag           anchor l+t       at x0.1             ymax     text  'X Offset:          '                width 16
    text      .rnodeXoff              anchor l+t       at xmin.rnodeName   ymin     callback '!this.offsetDistance(|RNODE|)'   width 20 is REAL format !!distanceFmt
    paragraph .rnodeZoffTag           anchor l+t       at x0.1             ymax     text  'Z Offset:          '                width 16
    text      .rnodeZoff              anchor l+t       at xmin.rnodeName   ymin     callback '!this.offsetDistance(|RNODE|)'   width 20 is REAL format !!distanceFmt
    paragraph .rnodeYoffTag           anchor l+t       at x0.1             ymax     text  'Gap (Y Offset):    '                width 16
    text      .rnodeYoff              anchor l+t       at xmin.rnodeName   ymin     callback ''                                width 20 is REAL format !!distanceFmt

    paragraph .rnodeReference         anchor l+t       at x0.1             ymax+1   text  'References'                 width 30
    line      .rnodeLineThree         anchor l+t       at x0               ymax     horizontal                         width 39

    paragraph .rnodeCrefTag           anchor l+t       at x0.1             ymax+0.5 text  'Connection:        '        width 16
    text      .rnodeCref              anchor l+t       at xmin.rnodeName   ymin     callback '!this.validateConnRef()' width 14 is STRING
    --combobox  .rnodeCref              anchor l+t       at xmax+0.1         ymin     callback '' width 10
    button    .rnodeCrefpick  linklabel 'Pick...'   anchor l+t   at xmax   ymin     callback 'show !!cblselectcnode'
    paragraph .rnodeSprefTag          anchor l+t       at x0.1             ymax     text  'Specification:     '        width 16
    text      .rnodeSpref             anchor l+t       at xmin.rnodeName   ymin     callback ''                        width 14 is STRING
    button    .rnodeSprefpick linklabel 'Choose...' anchor l+t   at xmax   ymin     callback '!this.chooseRnodeSpec()'

    frame .rnodeMode 'Mode' anchor l+t at x1 ymax+0.2
      rtoggle .rnodeCreateMode |Creation|            anchor l+t     at x1 ymax callback |!this.changeMode('CREATE','RNODE')|
      path right
      rtoggle .rnodeModifyMode |Modification|            anchor l+t     at xmax+7 ymin callback |!this.changeMode('MODIFY','RNODE')|
    exit

    toggle    .markPointRnodeFrame       anchor l+t       at x1            ymax     '  Mark Route Points' callback '!this.markPoint(!this.markPointRnodeFrame.val)'
    button    .rnodeListCables       linklabel 'List Associated Cables...'     anchor l+t        at x0 ymax+2           callback |!this.showCblListCables()| width 15
    paragraph .createRnodeIcon                                     anchor l+t    at x0           ymax+0.2       pixmap width 16 height 16
    button    .createRnodeApply  linklabel   'Create Route Node'   anchor l+t    at xmax+1       ymin       callback '!this.create(|RNODE|)'
    paragraph .modifyRnodeIcon                                     anchor l+t    at x0           ymin         pixmap width 16 height 16
    button    .modifyRnodeApply  linklabel   'Apply Changes'       anchor l+t    at xmax+1       ymin         callback '!this.modify(|RNODE|)'
    paragraph .discardRnodeIcon                                    anchor l+t    at xmax+1       ymin         pixmap width 16 height 16
    button    .discardRnodeApply  linklabel   'Discard Changes'    anchor l+t    at xmax+1       ymin         callback '!this.discard()'
    paragraph .deleteRnodeIcon                                     anchor l+t    at x0           ymax+0.2       pixmap width 16 height 16
    button    .deleteRnode           linklabel 'Delete Route Node' anchor l+t    at xmax+1       ymin        callback '!this.delete(|RNODE|)'
    paragraph .rnodeBackRpathIcon                                  anchor l+t    at x0           ymax        pixmap width 16 height 16
    button .rnodeBack   linklabel 'Back to Branch Tasks'           anchor l+t    at xmax+1       ymin        callback |!this.back('CWBRANTASKS')|

  exit

  -- RATTA

  frame .rattaFrame          panel     anchor l+t       at x0 y0
    paragraph .rattaOwnElement           anchor l+t       at x0.1         ymax          text  'Cableway Branch : '     width 35
    paragraph .rattaCeTag                anchor l+t       at x0.1         ymax          width 35
    button    .rattaCurrElement 'CE' linklabel  anchor l+t  at x0.1       ymax+0.5      callback '!this.currentElement()' tooltip 'Select an Element and modify'

    paragraph .rattaPosition          anchor l+t       at x0.1            ymax+0.5      text  'Positioning'     width 30
    line      .rattaLineone           anchor l+t       at x0              ymax          horizontal width 39

    paragraph .rattaPosnTag           anchor l+t       at x0.1            ymax+0.5   text  'Reference Point:   '               width 16
    option    .rattaPosn                               at xmax            ymin       callback '!this.offsetDistance(|RATTA|)'  width 12
    button    .rattaPosnpick  linklabel 'Pick...'  anchor l+t  at xmax    ymin       callback '!this.pickPoint(|RATTA|)'
    paragraph .rattaZdisTag           anchor l+t       at x0.1            ymax       text  'Offset Distance:   '               width 16
    text      .rattaZdis              anchor l+t       at xmax            ymin       callback '!this.offsetDistance(|RATTA|)'  width 14 is REAL format !!distanceFmt
    button    .rattaZdispick  linklabel 'Pick...'  anchor l+t  at xmax    ymin       callback '!this.align(|RATTA|)'
    paragraph .rattaMoveTag           anchor l+t       at x0.1            ymax       text  'Move Offset:       '               width 16
    button    .rattaLeftMove          anchor l+t       at xmax            ymin       pixmap callback '!this.moveZdis(|DECREASE|,!this.rattaZdis)' tooltip 'Decrease Offset' width 16
    text      .rattaMoveValue         anchor l+t       at xmax+0.5        ymin       callback ''                               width 11 is REAL  format !!distanceFmt
    button    .rattaRightMove         anchor l+t       at xmax+0.5        ymin       pixmap callback '!this.moveZdis(|INCREASE|,!this.rattaZdis)' tooltip 'Increase Offset' width 16
    paragraph .rattaPkdisTag          anchor l+t       at x0.1            ymax       text  'Prop dist (Pkdis): '               width 16
    text      .rattaPkdis             anchor l+t       at xmax            ymin       callback '!this.offsetDistance(|RATTA|)'  width 14 is REAL  format !!realFmt

    frame .rattaMode 'Mode' anchor l+t at x1 ymax+0.2
      rtoggle .rattaCreatemode |Creation|            anchor l+t     at x1 ymax callback |!this.changeMode('CREATE','RATTA')|
      path right
      rtoggle .rattaModifymode |Modification|            anchor l+t     at xmax+7 ymin callback |!this.changeMode('MODIFY','RATTA')|
    exit

    toggle    .markPointRattaFrame       anchor l+t       at x1            ymax     '  Mark Route Points' callback '!this.markPoint(!this.markPointRattaFrame.val)'
    button    .rattaListCables       linklabel 'List Associated Cables...'     anchor l+t        at x1 ymax+2           callback |!this.showCblListCables()| width 15
    paragraph .createRattaIcon                             anchor l+t    at x0                     ymax+0.2       pixmap width 16 height 16
    button    .createRattaApply  linklabel   'Create Route Attachment Point'      anchor l+t    at xmax+1       ymin       callback '!this.create(|RATTA|)'
    paragraph .modifyRattaIcon                             anchor l+t    at x0                     ymin         pixmap width 16 height 16
    button    .modifyRattaApply  linklabel   'Apply Changes'      anchor l+t    at xmax+1          ymin         callback '!this.modify(|RATTA|)'
    paragraph .discardRattaIcon                             anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
    button    .discardRattaApply  linklabel   'Discard Changes'      anchor l+t    at xmax+1       ymin         callback '!this.discard()'
    paragraph .deleteRattaIcon                                     anchor l+t    at x0           ymax+0.2       pixmap width 16 height 16
    button    .deleteRatta        linklabel 'Delete Route Attachment Point' anchor l+t        at xmax+1        ymin    callback '!this.delete(|RATTA|)'
    paragraph .rattaBackRpathIcon                                 anchor l+t    at x0              ymax         pixmap width 16 height 16
    button .rattaBack   linklabel 'Back to Branch Tasks'    anchor l+t   at xmax+1 ymin  callback |!this.back('CWBRANTASKS')|

  exit


  -- Curve

  frame .curveFrame          panel                  anchor l+t                  at x0 y0
    paragraph .curveOwnElement           anchor l+t       at x0.1       ymax            text  'Cwbranch : '     width 20
    button    .curveCurrElement 'Current Element'     linklabel   anchor l+t         at x0.1       ymax            callback '!this.currentElement()' tooltip 'Select an Element and modify'
    paragraph .curveCeTag                anchor l+t       at xmax.curveCurrElement+0.1         ymin            width 20
    line      .curveLine                 anchor l+t       at x0              ymax+0.5            horizontal width 39

    frame .curvePosCntrl FoldUpPanel |Curve Position|          anchor l+t           at x0           ymax+0.2            width 39 heig 6
      container .netCurveFrame PMLNetCONTROL 'NET' dock fill
      button .curvePos    linklabel 'Pick  Position' anchor l+t   at x0.3        ymax+3    callback ''
    exit

    button .curveCreate linklabel 'Create'  anchor l+t   at x1      ymax+2               callback ||
    button .curveModify linklabel 'Modify'  anchor l+t   at x1      ymin               callback ||
    button .curveBack   linklabel 'Back'    anchor l+t   at xmax+10 ymin.curveCreate  callback |!this.back('RPATH')|
  exit

  -- EXTGEO

  frame .extgeoFrame          panel                  anchor l+t                  at x0 y0
    paragraph .extgeoOwnElement           anchor l+t       at x0.1       ymax            text  'Cwbranch : '     width 20
    button    .extgeoCurrElement 'Current Element'     linklabel   anchor l+t         at x0.1       ymax            callback '!this.currentElement()' tooltip 'Select an Element and modify'
    paragraph .extgeoCeTag                anchor l+t       at xmax.extgeoCurrElement+0.1         ymin            width 20
    line      .extgeoLine                 anchor l+t       at x0              ymax+0.5            horizontal width 39
    button .extgeoCreate linklabel 'Create'  anchor l+t   at x1      ymax+2               callback ||
    button .extgeoModify linklabel 'Modify'  anchor l+t   at x1      ymin               callback ||
    button .extgeoBack   linklabel 'Back'    anchor l+t   at xmax+10 ymin.extgeoCreate  callback |!this.back('RPATH')|
  exit

  -- RSECT

  frame .rsectFrame          panel                  anchor l+t                  at x0 y0
    paragraph .rsectOwnElement           anchor l+t       at x0.1       ymax            text  'Cwbranch : '     width 20
    button    .rsectCurrElement 'Current Element'     linklabel   anchor l+t         at x0.1       ymax            callback '!this.currentElement()' tooltip 'Select an Element and modify'
    paragraph .rsectCeTag                anchor l+t       at xmax.rsectCurrElement+0.1         ymin            width 20
    line      .rsectLine                 anchor l+t       at x0              ymax+0.5            horizontal width 39

    frame .rsectPosCntrl FoldUpPanel |Route Section Position|          anchor l+t           at x0           ymax+0.2            width 39 heig 6
      container .netRsectFrame PMLNetCONTROL 'NET' dock fill
      button .rsectPos    linklabel 'Pick  Position' anchor l+t   at x0.3        ymax+3    callback ''
    exit

    button .rsectCreate linklabel 'Create'  anchor l+t   at x1      ymax+2               callback ||
    button .rsectModify linklabel 'Modify'  anchor l+t   at x1      ymin               callback ||
    button .rsectBack   linklabel 'Back'    anchor l+t   at xmax+10 ymin.rsectCreate  callback |!this.back('RPATH')|

  exit


  --Form Members

  --Element Picked by EDG
  member .pickedElementForHead              is DBREF
  member .pickedElementForTail              is DBREF
  member .pickedElementPos                  is POSITION
  member .location                          is STRING
  member .pickedPointForHead                is DBREF
  member .pickedPointForTail                is DBREF
  member .pickedPointForRnode               is DBREF
  member .pickedPointForRatta               is DBREF
  member .pickedPosForAlign                 is POSITION

  member .wrongPick                         is BOOLEAN
  member .dressed                           is BOOLEAN

  --Cabling action object
  member .cableway                           is CABLEWAY

  --List of Component Specifications
  member .specifications                    is ARRAY

  --aid numbers
  member .headAidNumber                     is REAL
  member .tailAidNumber                     is REAL
  member .startPosAidNumber                 is REAL
  member .endPosAidNumber                   is REAL
  member .segStartAidNumber                 is REAL
  member .rnodeAidNumber                    is REAL
  member .rattaAidNumber                    is REAL
  member .branchAidNumber                   is REAL

  member .rnodeBox                          is GPHBOX
  member .rattaSphere                       is GPHPOSITION
  member .task                              is STRING
  member .rpathElement                      is STRING
  member .firstShow                         is BOOLEAN

  --material
  member .material                          is ARRAY

  -- Cache of route node Selection data
  member .tableChooseData                   is STCHOOSEDATA

  --using namespace 'PositionControl'
  using namespace 'Aveva.Pdms.Presentation'

  -- PMLNet Position control
  member .cwbranHeadPosControl              is POSITIONCONTROL
  member .cwbranTailPosControl              is POSITIONCONTROL
  member .pointrPosControl                  is POSITIONCONTROL
  member .curvePosControl                   is POSITIONCONTROL
  member .rsectPosControl                   is POSITIONCONTROL

  -- pkdis ratio
  member  .pkdis                             is REAL

  -- bend radius
  member  .bendRadius                        is REAL

  -- representation of RNODE
  member .rnodeRepre                         is ARRAY

  -- interference class
  member .dinter                             is ARRAY

  member .packetEDG                          is EDGPACKET
  member .cwbranRnodeCreation                is BOOLEAN

  !this.quitCall   = |!this.dismiss()|
  !this.autoScroll = TRUE

exit
--End of form definition

------------------------------------------------------------------------
--
-- Method:   cblCway()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .cblCway()


  --Form and Icon Title
  !this.iconTitle                 = 'Cableway Task'
  --!this.formTitle                 = 'Create CWAY'
  !this.autoScroll                = TRUE
  --!this.initCall                  = '!this.init()'
  --!this.firstShownCall    = '!this.firstShown()'

  -- fold up panel for Attributes
  !this.cwbranAtt.expanded = FALSE

  -- callbacks
  !this.disconnectHead.callback = '!this.disconnect(|HEAD|)'
  !this.disconnectTail.callback = '!this.disconnect(|TAIL|)'

  -- validation calls
  !this.fradius.validateCall        = '!this.validateEntry('
  !this.rnodeZdis.validateCall      = '!this.validateEntry('
  !this.rnodePkdis.validateCall     = '!this.validateEntry('
  !this.rnodeMoveValue.validateCall = '!this.validateEntry('
  !this.rattaZdis.validateCall      = '!this.validateEntry('
  !this.rattaPkdis.validateCall     = '!this.validateEntry('
  !this.rattaMoveValue.validateCall = '!this.validateEntry('
  -- Validation call
  !this.cwbranMaxfil.validateCall   = '!this.validMaxFill('

  --Branch Creation types
  !connect[1]                     = 'Explicit'
  !connect[2]                     = 'Head of Cableway Branch'
  !connect[3]                     = 'Tail of Cableway Branch'
  !connect[4]                     = 'Branch Off'
  !connect[5]                     = 'Route Attachment Point'
  !this.headOpt.dtext             = !connect
  !this.tailOpt.dtext             = !connect

  --justification
  !just[1]                        = 'Bottom - Centre'
  !just[2]                        = 'Bottom - Left'
  !just[3]                        = 'Bottom - Right'
  !just[4]                        = 'Centre - Centre'
  !just[5]                        = 'Centre - Left'
  !just[6]                        = 'Centre - Right'
  !just[7]                        = 'Top - Centre'
  !just[8]                        = 'Top - Left'
  !just[9]                        = 'Top - Right'
  !this.cwbranJust.dtext          = !just

  !justr[1]                       = 'CENT'
  !justr[2]                       = 'LEFT'
  !justr[3]                       = 'RIGH'
  !justr[4]                       = 'CENC'
  !justr[5]                       = 'CENL'
  !justr[6]                       = 'CENR'
  !justr[7]                       = 'TOPC'
  !justr[8]                       = 'TOPL'
  !justr[9]                       = 'TOPR'
  !this.cwbranJust.rtext          = !justr

  --Shapes
  !shape[1]                       = 'Rectangular'
  !shape[2]                       = 'Circular'

  !this.cwbranVShape.dtext        = !shape
  !this.cwbranVShape.rtext        = !shape

  -- route node types
  --dtext
  !rnType[1]                      = 'Takeoff'
  !rnType[2]                      = 'Gap'
  !rnType[3]                      = 'Offset'
  !rnType[4]                      = 'Penetration'
  !rnType[5]                      = 'Report'
  -- Removed these two options as they are not used
  --    !rnType[6]                      = 'Control'
  --    !rnType[7]                      = 'Seam'

  !this.rnodeTypeOpt.dtext        = !rnType
  --dtext
  !rnTyper[1]                      = 'TAKE'
  !rnTyper[2]                      = 'GAP'
  !rnTyper[3]                      = 'OFFS'
  !rnTyper[4]                      = 'PENE'
  !rnTyper[5]                      = 'REPO'
  -- Removed these two options as they are not used
  --    !rnTyper[6]                      = 'CONT'
  --    !rnTyper[7]                      = 'SEAM'
  !this.rnodeTypeOpt.rtext        = !rnTyper

  -- Spref for representation
  !rnodeSprefs = ARRAY()
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.MAIN_TABITE')
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.MAIN_TABITE')
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.MAIN_TABITE')
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.PENE_TABITE')
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.MAIN_TABITE')
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.MAIN_TABITE')
  !rnodeSprefs.append('/CABLEWAY_REPRESENTATION.SEAM_TABITE')
  !this.rnodeRepre = !rnodeSprefs

  !this.cwbranCexs.val       = 0
  !this.cwbranMaxfil.val     = 100
  !this.bangle.val           = 0
  !this.brad.val             = 0
  !this.rpathYdir.val        = U WRT/*

  !autoNameIcon   = !!pml.getPathname('autoname.png')
  !createIcon     = !!pml.getPathname('create.png')
  !modifyIcon     = !!pml.getPathname('accept.png')
  !discardIcon    = !!pml.getPathname('discard.png')
  !backIcon       = !!pml.getPathname('back.png')
  !leftArrow      = !!pml.getPathname('leftarrow16.png')
  !rightArrow     = !!pml.getPathname('rightarrow16.png')
  !deleteIcon     = !!pml.getPathname('deletece16.png')

  !this.autoName.addPixmap(!autoNameIcon)
  !this.rnodeAutoName.addPixmap(!autoNameIcon)
  !this.createCwayIcon.addPixmap(!createIcon)
  !this.modifyCwayIcon.addPixmap(!modifyIcon)
  !this.discardCwayIcon.addPixmap(!discardIcon)
  !this.createCwbranIcon.addPixmap(!createIcon)
  !this.modifyCwbranIcon.addPixmap(!modifyIcon)
  !this.discardCwbranIcon.addPixmap(!discardIcon)
  !this.backCwayIcon.addPixmap(!backIcon)
  !this.backCwbranIcon.addPixmap(!backIcon)
  !this.backCwbranTaskIcon.addPixmap(!backIcon)
  !this.pointrBackRpathIcon.addPixmap(!backIcon)
  !this.createPointrIcon.addPixmap(!createIcon)
  !this.modifyPointrIcon.addPixmap(!modifyIcon)
  !this.discardPointrIcon.addPixmap(!discardIcon)
  !this.createRnodeIcon.addPixmap(!createIcon)
  !this.modifyRnodeIcon.addPixmap(!modifyIcon)
  !this.discardRnodeIcon.addPixmap(!discardIcon)
  !this.rnodeBackRpathIcon.addPixmap(!backIcon)
  !this.createRattaIcon.addPixmap(!createIcon)
  !this.modifyRattaIcon.addPixmap(!modifyIcon)
  !this.discardRattaIcon.addPixmap(!discardIcon)
  !this.rattaBackRpathIcon.addPixmap(!backIcon)
  !this.rnodeLeftMove.addPixmap(!leftArrow)
  !this.rnodeRightMove.addPixmap(!rightArrow)
  !this.rattaLeftMove.addPixmap(!leftArrow)
  !this.rattaRightMove.addPixmap(!rightArrow)
  !this.deleteRnodeIcon.addPixmap(!deleteIcon)
  !this.deleteRattaIcon.addPixmap(!deleteIcon)
  !this.deleteCwayIcon.addPixmap(!deleteIcon)

  !this.selRpoint.val  = TRUE
  !this.rpathElement   = 'POINTR'
  !this.firstShow      = FALSE

  --Register Aid numbers
  !this.headAidNumber     = !!aidNumbers.add('CwbranHead')
  !this.tailAidNumber     = !!aidNumbers.add('CwbranTail')
  !this.startPosAidNumber = !!aidNumbers.add('New Start Position')
  !this.endPosAidNumber   = !!aidNumbers.add('New End Position')
  !this.segStartAidNumber = !!aidNumbers.add('Segment Start')
  !this.rnodeAidNumber    = !!aidNumbers.add('Route Node')
  !this.rattaAidNumber    = !!aidNumbers.add('Route Attachment Point')
  !this.branchAidNumber   = !!aidNumbers.add('Branch')

  --gphBox
  !this.rnodeBox.box.xlength = 100mm
  !this.rnodeBox.box.ylength = 100mm
  !this.rnodeBox.box.zlength = 100mm
  !boxOri   = object ORIENTATION('Y is N and Z is U')
  !this.rnodeBox.box.orientation  = !boxOri
  !this.rnodeBox.box.position  = E0
  !this.rnodeBox.detail  = TRUE

  --gphSphere
  !this.rattaSphere.position  = E0
  !this.rattaSphere.diameter  = 100mm
  !this.rattaSphere.description = '<RATTA>'
  !this.rattaSphere.tag         = TRUE

  --initialise position control gadgets
  !this.posCntrl('netcwbranheadframe', 'cwbranheadposcontrol')
  !this.posCntrl('netcwbrantailframe', 'cwbrantailposcontrol')
  !this.posCntrl('netpointrframe', 'pointrposcontrol')
  !this.posCntrl('netcurveframe', 'curveposcontrol')
  !this.posCntrl('netrsectframe', 'rsectposcontrol')

  -- create Orthogonal
  !this.ortho.val   = TRUE

  --load defaults
  if (undefined(!!cbldflts)) then
    pml reload form !!cbldflts
  endif
  -- Temporary inactivation of gadgets
  --Need to activate when they are implemented
  !this.selCurve.active = false
  !this.selExgeo.active = false
  !this.selRsect.active = FALSE
  !this.cwbranRnodeCreation = !!cbldflts.cwbranRnodeCreation
  --popup for POINTR deletion
  !menu   =   !this.newMenu('deletepointr')
  !menu.add('callback','Delete','!this.delete(|POINTR|)')
  !this.pointrTable.setPopup(!menu)

  --Material
  !this.material = object ARRAY()
  !this.material.append('CTSTRA')
  !this.material.append('CTBEND')
  !this.material.append('CTRISE')
  !this.material.append('CTREDU')
  !this.material.append('CTTEE')
  !this.material.append('CTCROS')

  -- CNODE selection form loading
  if (undefined(!!cblselectcnode)) then
    pml load form !!cblselectcnode
  endif
  !!cblselectcnode.bnApply.callback = '!!cblCway.pickCnode()'
  -- load route node catalogue data
  !this.tableChooseData.cleardata()
  !this.tableChooseData.setTitle('Route Node')
  !this.tableChooseData.setdata('CABLE','REPR')

  -- connection checking form
  -- CNODE selection form loading
  if (undefined(!!cblconnections)) then
    pml load form !!cblconnections
  endif

  -- add longer tag for proportional distance
  !this.rnodePkdisTag.val = 'Proportional Distance:'
  !this.rattaPkdisTag.val = 'Proportional Distance:'

  -- interference class
  --!this.dinter.append('unset')
  !this.dinter = !!cbldflts.cwbranIclass.dtext
  !this.cwbranIclass.dtext = !this.dinter

  --popup for interference class deletion
  !menu   =   !this.newMenu('deleteIclass')
  !menu.add('callback','Remove','!this.removeIclass(!this.cwbranIclass)')
  !this.cwbranIclass.setPopup(!menu)

  -- frame callback
  !this.iclassFrame.callback = '!this.updateFrame()'
  --edg Default
  !this.wrongPick = FALSE
endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:   firstShown()
--
-- Description: first shown call
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .firstShown()

  !this.cwbranAtt.expanded = FALSE

endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method: setTask
--
-- Description: To set the task based on the action to be performed.
--              Switching the gadgets on /off
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!formTask is STRING,!element is STRING )



  -- set the fill level on initialisation of create form to 0%
  if (!formTask.upcase().eq('CREATE')) then
    !this.cwbranCurrentFill.val = '0.00'
  endif

  -- set to forwards mode except POINTR task
  if (!element.upcase().neq('POINTR')) then
    forwards
  endif

  --show the defaults form for user to set
  !this.task   = !formTask.upcase()
  !this.cableway.activeElement = !!ce

  --Change the form title

  if (!formTask.upcase().eq('CREATE')) then
    !title = 'Create'
  elseif (!formTask.upcase().eq('MODIFY')) then
    !title = 'Modify'
  else
    !title = !this.task
  endif

  if (!element.upcase().eq('CWAY')) then
    !titleElement = 'Cableway'
    if (!title.eq('Create')) then
      !this.helpContextID = 'HID_CBLCWAY'
    elseif (!title.eq('Modify')) then
      !this.helpContextID = 'HID_CBLMODCWAY'
    endif
  elseif (!element.upcase().eq('CWBRAN')) then
    !titleElement = 'Cableway Branch'
    if (!title.eq('Create')) then
      !this.helpContextID = 'HID_CBLCWBRAN'
    elseif (!title.eq('Modify')) then
      !this.helpContextID = 'HID_CBLMODCWBRAN'
    endif
  elseif (!element.upcase().eq('RPATH')) then
    !titleElement = 'Route Path'
  elseif (!element.upcase().eq('POINTR')) then
    !titleElement = 'Route Point'
    if (!title.eq('Create')) then
      !this.helpContextID = 'HID_CBLPOINTR'
    elseif (!title.eq('Modify')) then
      !this.helpContextID = 'HID_CBLMODPOINTR'
    endif
  elseif (!element.upcase().eq('RNODE')) then
    !titleElement = 'Route Node'
    if (!title.eq('Create')) then
      !this.helpContextID = 'HID_CBLRNODE'
    elseif (!title.eq('Modify')) then
      !this.helpContextID = 'HID_CBLMODRNODE'
    endif
  elseif (!element.upcase().eq('RATTA')) then
    !titleElement = 'Route Attachment Points'
    if (!title.eq('Create')) then
      !this.helpContextID = 'HID_CBLCWAYRATTA'
    elseif (!title.eq('Modify')) then
      !this.helpContextID = 'HID_CBLCWAYMODRATTA'
    endif
  elseif (!element.upcase().eq('RSECT')) then
    !titleElement = 'Route Section'
  elseif (!element.upcase().eq('EXTGEO')) then
    !titleElement = 'External Geometry'
  elseif (!element.upcase().eq('CURVE')) then
    !titleElement = 'Curve'
  elseif (!element.upcase().eq('CWBRANTASKS')) then
    !titleElement = ''
  endif

  !this.formTitle = !titleElement & | | & !title  & ' Tasks'

  if (!element.eq('RPATH')) then
    !this.formTitle = 'RPATH Elements Selection'
  endif

  if (!element.eq('CWBRANTASKS')) then
    !this.formTitle = 'Branch Tasks'
    !this.helpContextID = 'HID_CBLBRANCHTASKS'
  endif

  if (!element.eq('POINTR')) then
    !this.formTitle = 'Define Path / Route Tasks'
  endif

  --Initialise Variables
  !task             = !formTask.upcase()

  !this.cwayFrame.visible                   = FALSE
  !this.cwbranFrame.visible                 = FALSE
  !this.cwbranSecondFrame.visible           = FALSE
  !this.rpathSelectionFrame.visible         = FALSE
  !this.pointrFrame.visible                 = FALSE
  !this.rnodeFrame.visible                  = FALSE
  !this.rattaFrame.visible                  = FALSE
  !this.curveFrame.visible                  = FALSE
  !this.extgeoFrame.visible                 = FALSE
  !this.rsectFrame.visible                  = FALSE

  !type   = !!ce.type

  -- A ZONE is only valid if creating a CWAY, so if it isn't use previously selected element
  if (!this.task.eq('CREATE').and(!element.eq('CWAY'))) then
    -- create CWAY
    --Ce is bellow zone, this is checked by cblinit function which call this
    --therefore creation of CWAY is allow.
    !this.cableway   = object CABLEWAY(!!ce)
    !!ce = !this.cableway.element
  else
    --  if below a CWBRAN in the hierarchy, use the CWBRAN
    !branchOwner = !!dtbFindOwnerOfType(!!ce,'CWBRAN',false)
    if( !branchOwner.set() ) then
      -- below a CWBRAN
      --!this.cableway   = object CABLEWAY(!branchOwner)
      !this.cableway   = object CABLEWAY(!!ce)
    elseif (!!dtbFindOwnerOfType(!!ce,'CWAY',false).set()) then
      -- below a CWAY but not below a CWBRAN
      !this.cableway   = object CABLEWAY(!!ce)
    else
      -- Use previously selected element if anything outside of the cableway hierarchy is selected
      !!alert.warning('Cannot modify element. This form is only for modifying route points under a cableway branch. Returning to last branch element.')

    endif
  endif

  if (!!ce.type.eq('CWBRAN')) then
    !this.cableway.rpath   = RPATH 1 of ce
    handle ANY
      --No route path created
      !this.cableway.rpath  = object DBREF()
    endhandle
    !this.cableway.pointr  = POINTR 1 of RPATH 1 of CE
    handle ANY
      --No route points created
      !this.cableway.pointr  = object DBREF()
    endhandle
  endif


  --set Task
  if (!element eq 'CWAY') then
    !this.cwayFrame.visible = TRUE
    !this.cablewayGadgets(!task)
  elseif (!element eq 'CWBRAN') then
    !this.cwbranFrame.visible = TRUE
    if(!task eq 'CREATE') then
      !this.branchGadgets(!task)
    elseif(!task eq 'MODIFY') then
      !this.branchGadgets(!task)
    endif
  elseif (!element eq 'CWBRANTASKS') then
    !this.cwbranSecondFrame.visible = TRUE
  elseif (!element eq 'RPATH') then
    !this.rpathSelectionFrame.visible = TRUE
    !this.rpathGadgets(!task)
  elseif (!element eq 'POINTR') then
    !this.pointrFrame.visible = TRUE
    !this.pointrGadgets(!task)
  elseif (!element eq 'RNODE') then
    !this.rnodeFrame.visible = TRUE
    !this.rnodeGadgets(!task)
  elseif (!element eq 'RATTA') then
    !this.rattaFrame.visible = TRUE
    !this.rattaGadgets(!task)
  elseif (!element eq 'CURVE') then
    !this.curveFrame.visible = TRUE
    !this.curveGadgets(!task)
  elseif (!element eq 'EXTGEO') then
    !this.extgeoFrame.visible = TRUE
    !this.extgeoGadgets(!task)
  elseif (!element eq 'RSECT') then
    !this.rsectFrame.visible = TRUE
    !this.rsectGadgets(!task)
  endif

  if(!task eq 'CREATE') then
    !this.createData(!element)
  elseif(!task eq 'MODIFY') then
    !this.loadData(!element)
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: create
--
-- Description: create the elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!elementType is STRING)

  if (!elementType.upcase().eq('CWAY')) then
    !this.loadObjectMembers('CWAY')
    !this.cableway.create('CWAY')
    !this.setTask('CREATE','CWBRAN')
  elseif (!elementType.upcase().eq('CWBRAN')) then
    !this.loadObjectMembers('CWBRAN')
    !this.cableway.changeRadius = FALSE
    -- use zdistance for branch tap off
    !this.cableway.cwbm.setConnectingMode(TRUE)
    !this.cableway.create('CWBRAN')

    -- create RNODEs at head and tail
    !!ce = !this.cableway.cwbran
    !firstPos  = POINTR 1 of RPATH 1 of CE
    !secondPos = POINTR 2 of RPATH 1 of CE
    !firstPos.frad = !this.brad.val
    !secondPos.frad = !this.brad.val
     -- Mark database
    --!undo               = object UNDOABLE()
    --!undo.description('Create Route nodes and orthogonal route')
    --!undo.add()

    -- create RNODE at head
    if ( !this.cwbranRnodeCreation ) then
      NEW RTFEAT
      NEW RNODE
      !!ce.posref  = !firstPos
      RNTYPE TAKE
      !name = '/' & !!cblautoname('RNODE', !this.cableway.cwbran)
      name $!name
      handle ANY
      endhandle

      -- create RNODE at tail
      NEW RNODE
      !!ce.posref  = !secondPos
      RNTYPE TAKE
      !name = '/' & !!cblautoname('RNODE', !this.cableway.cwbran)
      name $!name
      handle ANY
      endhandle
    endif

    !!ce = !this.cableway.cwbran

    --orthogonal routing
    if (!this.ortho.val) then
      !this.cableway.createorthogonal(!this.cableway.cwbran, !this.orthoOpt.selection())
    endif

    -- End undo mark
    --!undo.endUndoable()
    -- clear off orthogonal aids
    aid clear all $!this.branchAidNumber
    handle ANY
    endhandle

    --Update Element Table
    !this.branchesTable.clear()
    !this.deleteBranch.active = TRUE
    !refArray =  !this.cableway.cwbrans
    !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
    handle ANY
      !text[1] = ''
      !this.deleteBranch.active = FALSE
    endhandle
    !this.branchesTable.dtext = !text
    handle ANY
    endhandle
    !this.setTask('CREATE','CWBRANTASKS')

  elseif (!elementType.upcase().eq('POINTR')) then
    !!ce = !this.cableway.pointr
    -- do not allow creation after last point
    if (!this.cableway.pointr.tysequence.eq(!this.cableway.pointr.owner.members.size())) then
      !!alert.warning('Do not explicitly create points after the last point')
      return
    endif

    !lyDir = !!ce.lydirection.wrt(world).string().before('WRT').trim()
    handle (2,779)
      -- problem with tray open direction
    endhandle
    !next  = NEXT
    handle ANY
      !next = object DBREF()
    endhandle

    -- see if the point is dressed
    if (!this.cableway.cwtm.createPointrAllowed(!!ce).not()) then
      !confirm = !!alert.confirm('The segment is already dressed. Remove dressing and create new point?')
      if (!confirm.eq('YES')) then
        !this.cableway.cwtm.undressSegmentWithMaterial(!!ce)
      else
        return
      endif
    endif


    !this.loadObjectMembers('POINTR')
    !this.cableway.create('POINTR')

    !this.setTask(|CREATE|,|POINTR|)

    if(!next.set())then
      !lyDirNext = !next.lydirection.wrt(world).string().before('WRT').trim()
      handle(2,779)
        !!alert.error('Please check the tray open direction. Branch cannot be drawn correctly')
        !this.markPoint(FALSE)
        return
      endhandle
      if(!lyDir neq !lyDirNext)then
        !sequence  = !next.sequence
      endif

      if(defined(!sequence))then
        --Checks LYDirection of all POINTR
        !collection = object COLLECTION()
        !collection.scope(RPATH)
        !collection.type('POINTR')
        !result = !collection.results()
        if (!this.cableway.cwtm.setPosOnPointrAllowed(!next).not()) then
          if(!!alert.confirm('Direction of $!<next.flnn> has been changed. Is it ok to remove the materials after this POINTR?').eq('YES'))then
            do !pointrs from !sequence to !result.size()
              !this.cableway.cwtm.undressSegmentWithMaterial(!result[$!pointrs])
            enddo
          endif
        endif
      endif
    endif

    -- mark Points
    !this.markPoint(FALSE)

  elseif (!elementType.upcase().eq('RNODE')) then
    -- ask for confirmation if the route node is not named
    if (!this.rnodeName.val.eq('')) then
      !confirm = !!alert.confirm('Route Node is not named. Ok to continue?')
      if (!confirm.neq('YES')) then
        return
      endif
    endif
    if (!this.offsetDistance('RNODE').not()) then
      return
    endif
    !this.loadObjectMembers('RNODE')
    !this.cableway.create('RNODE')
    -- reorder
    !this.reorderRnodes(!this.cableway.rnode)

  elseif (!elementType.upcase().eq('RATTA')) then
    if (!this.offsetDistance('RATTA').not()) then
      return
    endif
    !this.loadObjectMembers('RATTA')
    !this.cableway.create('RATTA')
  endif

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: loadObjectMembers
--
-- Description: Load the Cableway object members
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadObjectMembers(!elementType is STRING)

  if (!elementType.upcase().eq('CWAY')) then
    !this.cableway.name        = '/' & !this.cwayName.val
    !this.cableway.description = !this.cwayDesc.val
    !this.cableway.function    = !this.cwayFunc.val
    !this.cableway.purpose     = !this.cwayPurp.val
  elseif (!elementType.upcase().eq('CWBRAN')) then
    !this.cableway.name                  = '/' & !this.cwbranName.val
    !this.cableway.description           = !this.cwbranDesc.val
    !this.cableway.function              = !this.cwbranFunc.val
    !this.cableway.purpose               = !this.cwbranPurp.val
    !this.cableway.rllogical             = !this.cwbranRllogical.val
    !this.cableway.bangle                = !this.bangle.val
    !this.cableway.bradius               = !this.brad.val
    !this.cableway.cexs                  = !this.cwbranCexs.val
    !this.cableway.maxfil                = !this.cwbranMaxfil.val
    !this.cableway.vwidth                = !this.cwbranVWidth.val
    !this.cableway.vheight               = !this.cwbranVHeight.val
    !this.cableway.vshape                = !this.cwbranVShape.val - 1
    !this.cableway.ydir                  = !this.rpathYdir.val
    !this.cableway.jusl                  = !this.cwbranJust.selection()

    if (!this.cwbranRllogicalTag.val) then
      !this.cableway.iclass              = ''
    else
      if (!this.cwbranIclass.selection().eq('unset')) then
        !this.cableway.iclass              = ''
      else
        !this.cableway.iclass              = !this.cwbranIclass.selection()
      endif
    endif

    !this.cableway.start                 = !this.headOpt.val
    !this.cableway.end                   = !this.tailOpt.val
    !this.cableway.branchHeadPosition    = !this.getPosFromCntrl(!this.cwbranHeadPosControl.xyz())
    !this.cableway.branchTailPosition    = !this.getPosFromCntrl(!this.cwbranTailPosControl.xyz())
    !this.cableway.headConnectionBranch  = !this.pickedElementForHead
    !this.cableway.tailConnectionBranch  = !this.pickedElementForTail
    !this.cableway.headBranchingBranch   = !this.pickedPointForHead.own.own
    handle ANY
    endhandle
    !this.cableway.tailBranchingBranch   = !this.pickedPointForTail.own.own
    handle ANY
    endhandle
    !this.cableway.referenceHeadPoint    = !this.pickedPointForHead
    handle ANY
    endhandle
    !this.cableway.referenceTailPoint    = !this.pickedPointForTail
    handle ANY
    endhandle

    if (!this.task.upcase().eq('MODIFY')) then
      !hpos = !this.cableway.cwbran.hpos
      handle (2,220)
        --handle if branches are not connected. Hpos is not set if not connected
        !this.cableway.start = 1
      elsehandle NONE
        --Special case for modify cable way branches, when branch is already connected and position control is set to the same position as head position
        if (!this.getPosFromCntrl(!this.cwbranHeadPosControl.xyz()).eq(!this.cableway.cwbran.hpos) and !this.cableway.cwbran.hdconn.set() and !this.cableway.start.eq(1)) then
          !this.cableway.start = 0
        endif

      endhandle
      !tpos = !this.cableway.cwbran.tpos
      handle (2,220)
        --handle if branches are not connected. Tpos is not set if not connected
        !this.cableway.end = 1
      elsehandle NONE
        --Special case for modify cable way branches, when branch is already connected and position control is set to the same position as tail position
        if (!this.getPosFromCntrl(!this.cwbranTailPosControl.xyz()).eq(!this.cableway.cwbran.tpos) and !this.cableway.cwbran.tlconn.set() and  !this.cableway.end.eq(1)) then
          !this.cableway.end  = 0
        endif
      endhandle
    endif
  elseif (!elementType.upcase().eq('POINTR')) then
    !this.cableway.pointrPos  = !this.getPosFromCntrl(!this.pointrPosControl.xyz())
    !this.cableway.frad       = !this.fradius.val
  elseif (!elementType.upcase().eq('RNODE')) then
    !this.cableway.name        = '/' & !this.rnodeName.val
    !this.cableway.description = !this.rnodeDesc.val
    !this.cableway.function    = !this.rnodeFunc.val
    !this.cableway.purpose     = !this.rnodePurp.val
    !num     = !this.rnodePosn.val
    !cwbran  = !this.cableway.cwbran
    !point   = POINTR $!num of RPATH 1 of $!cwbran
    !this.cableway.posref      = !point
    !this.cableway.zdis        = !this.rnodeZdis.val
    !this.cableway.pkdis       = !this.rnodePkdis.val
    !this.cableway.xoffset     = !this.rnodeXoff.val
    !this.cableway.yoffset     = !this.rnodeYoff.val
    !this.cableway.zoffset     = !this.rnodeZoff.val
    !this.cableway.rnType      = !this.rnodeTypeOpt.selection()
    --convert connection reference from string to DBREF
    !conn   = '/' & !this.rnodeCref.val
    !connRef = object DBREF(!conn)
    handle ANY
      -- try to convert unnamed CNODE
      !connRef = object DBREF(!this.rnodeCref.val)
      handle ANY
        !connRef  = object ARRAY()
      endhandle
    endhandle
    !this.cableway.connRef[1]   = !connRef

    --convert specification Reference from string to DBREF
    !spec   =  '/' & !this.rnodeSpref.val
    !spref = object DBREF(!spec)
    handle ANY
      !spref  = object DBREF()
    endhandle
    !this.cableway.spref   = !spref

    if(!spref.unset())then
      if(!this.rnodeTypeOpt.val.eq(1))then
        -- Set spref for selected type
        !this.cableway.spref = !this.rnodeRepre[$!this.rnodeTypeOpt.val].dbref()
      endif
    endif

  elseif (!elementType.upcase().eq('RATTA')) then
    !num     = !this.rattaPosn.val
    !cwbran  = !this.cableway.cwbran
    !point   = POINTR $!num of RPATH 1 of $!cwbran
    !this.cableway.posref      = !point
    !this.cableway.zdis        = !this.rattaZdis.val
    !this.cableway.pkdis       = !this.rattaPkdis.val

  endif

endmethod

--End of method definition


------------------------------------------------------------------------
--
-- Method: modify
--
-- Description: modify the elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!elementType is STRING)

  !!ce   = !this.cableway.activeElement

  if (!elementType.upcase().eq('CWAY')) then
    !this.loadObjectMembers('CWAY')
    if (!this.cwayName.val.neq('') and !this.cableway.cway.namn.neq(!this.cwayName.val)) then
      !this.cableway.changename(!this.cableway.cway, !this.cwayName.val)
    endif
    !this.cableway.modify('CWAY')
  elseif (!elementType.upcase().eq('CWBRAN')) then
    !this.loadObjectMembers('CWBRAN')
    if !this.cwbranName.val.neq('') and !this.cableway.cwbran.namn.neq(!this.cwbranName.val) then
      !this.cableway.changename(!this.cableway.cwbran, !this.cwbranName.val)
    endif
    if !this.brad.val.neq(!this.bendRadius) then
      !this.cableway.changeRadius = TRUE
    else
      !this.cableway.changeRadius = FALSE
    endif
    !this.cableway.cwbrans = !!ce.own.members

    --Update Element Table
    !this.branchesTable.clear()
    !refArray =  !this.cableway.cwbrans
    !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
    !this.branchesTable.dtext = !text
    !this.deleteBranch.active = TRUE
    !this.cableway.modify('CWBRAN')
    !this.setTask('MODIFY','CWBRAN')
  elseif (!elementType.upcase().eq('POINTR')) then
    !pointr = !this.cableway.pointr
    !modificationStatus = !this.modifyStatus(!pointr)
    if(!modificationStatus.not()) then
      return
    endif

    !message = ''

    if (!pointr.sequence.eq(1)) then
      !confirm = !!alert.confirm(!message & 'Are you sure to modify the Head Point?')
      if (!confirm.neq('YES')) then
        return
      endif
    elseif (!pointr.sequence.eq(!pointr.owner.members.size())) then
      !confirm = !!alert.confirm(!message & 'Are you sure to modify the Tail Point?')
      if (!confirm.neq('YES')) then
        return
      endif
    elseif (!message.neq('')) then
      !confirm = !!alert.confirm(!message & 'Would you like to continue?')
      if (!confirm.neq('YES')) then
        return
      endif
    endif

    !lyDir = !pointr.lydirection.wrt(world).string().before('WRT').trim()
    handle (2,779)
      -- problem with tray open direction
    endhandle
    !ce    = !!ce
    !!ce   = !pointr
    !next  = NEXT
    handle ANY
      !next = object DBREF()
    endhandle
    !!ce   = !ce

    -- see if the point is dressed
    if (!this.cableway.cwtm.setPosOnPointrAllowed(!pointr).not()) then
      !confirm = !!alert.confirm('The segment is already dressed. Remove dressing and modify the point?')
      if (!confirm.eq('YES')) then
        !ce = !!ce
        !!ce = !pointr
        !this.cableway.cwtm.undressSegmentWithMaterial(!!ce)
        if(!!ce.tysequence neq 1)then
          !this.cableway.cwtm.undressSegmentWithMaterial(prev)
        endif
        !!ce = !ce
      else
        return
      endif
    endif

    !this.loadObjectMembers('POINTR')
    !this.cableway.modify('POINTR')

    -- disconnect and reconnect if first or last point
    if (!pointr.sequence.eq(1)) then
      !bran = !this.cableway.cwbran
      !this.cableway.cwbm.disconnectHead(!bran)
      !pos = !pointr.position.wrt(worl)
      !this.cableway.cwbm.startFromFreePoint(!bran, !pos)
    endif

    if (!pointr.sequence.eq(!pointr.owner.members.size())) then
      !bran = !this.cableway.cwbran
      !this.cableway.cwbm.disconnectTail(!bran)
      !pos = !pointr.position.wrt(worl)
      !this.cableway.cwbm.endFromFreePoint(!bran, !pos)
    endif

    !this.setTask(|MODIFY|,|POINTR|)

    if(!next.set())then
      !lyDirNext  = !next.lydirection.wrt(world).string().before('WRT').trim()
      handle(2,779)
        !!alert.error('Please check the tray open direction. Branch cannot be drawn correctly')
        !this.markPoint(FALSE)
        return
      endhandle

      if(!lyDir neq !lyDirNext)then
        !sequence = !next.sequence
      endif
      if(defined(!sequence) and !next.set())then
        --Checks LYDirection of all pointrs
        !collection = object COLLECTION()
        !collection.scope(RPATH)
        !collection.type('POINTR')
        !result = !collection.results()
        if (!this.cableway.cwtm.setPosOnPointrAllowed(!next).not()) then
          if(!!alert.confirm('Direction of $!<next.flnn> has been changed. Is it ok to remove the materials after this POINTR?').eq('YES'))then
            do !pointrs from !sequence to !result.size()
              !this.cableway.cwtm.undressSegmentWithMaterial(!result[$!pointrs])
            enddo
          endif
        endif
      endif
    endif

  elseif (!elementType.upcase().eq('RNODE')) then
    !this.loadObjectMembers('RNODE')
    !this.cableway.modify('RNODE')
    !this.setTask(|MODIFY|,|RNODE|)
  elseif (!elementType.upcase().eq('RATTA')) then
    !this.loadObjectMembers('RATTA')
    !this.cableway.modify('RATTA')
    !this.setTask(|MODIFY|,|RATTA|)
  endif

endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: modifyStatus
--
-- Description: Check Whether changes has been made or not
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyStatus(!element is DBREF) is BOOLEAN

  !position    = !element.position.wrt(world)
  !posCntrlPos = !this.getPosFromCntrl(!this.pointrPosControl.xyz())
  !fradius     = !element.fradius
  !formData    = !this.fradius.val

  if (!fradius.neq(!formData)) then
    return true
  endif

  if (!posCntrlPos.eq(!position)) then
    return false
  else
    return true
  endif
endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: delete
--
-- Description: delete the elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .delete(!elementType is STRING)
  -- Find highlight colour
  !hColour = !!gphColOpt.highlight().code
  -- initialise variable
  !found   = FALSE

  if (!elementType.upcase().eq('CWAY')) then

    -- Highlight all owned CWBRAN to be deleted (using the current highlight colour)
    var !elements coll all CWBRAN for $!this.cableway.cway
    enhance all from !elements col $!hColour
    handle (47,15)
      -- Error occurs in Paragon.
    endhandle

    --find if cables are passing through the Cableway
    !col   = object COLLECTION()
    !col.type('POINTR')
    !col.scope(!this.cableway.cway)

    do !cable values !col.results()
      if (!cable.clist[0].size().gt(0)) then
        -- found cables on the CWAY
        !found = TRUE
        break
      endif
    enddo

    -- ask for confirmation
    !cename = !this.cableway.cway.flnm
    if (!found) then
      !answer = !!alert.confirm('There are cables routed on the cableway. Still delete $!cename ?')
      if (!answer.neq('YES')) then
        unenhance all from !elements
        handle (47,15)
          -- Error occurs in Paragon.
        endhandle
        return
      endif
    else
      !answer = !!alert.confirm('Are you sure to delete $!cename ?')
      if (!answer.neq('YES')) then
        unenhance all from !elements
        handle (47,15)
          -- Error occurs in Paragon.
        endhandle
        return
      endif
    endif
    !!ce = !this.cableway.cway
    !this.cableway.delete('CWAY')
    !this.setTask('CREATE','CWAY')

  elseif (!elementType.upcase().eq('CWBRAN')) then

    if (!!ce.type.eq('CWBRAN').and(!!ce.neq(!this.cableway.cwbran))) then
      !this.cableway = object CABLEWAY(!!ce)
    endif

    -- Highlight CWBRAN to be deleted (using the current highlight colour)
    !element = !this.cableway.cwbran
    enhance $!element col $!hColour
    handle (47,15)
      -- Error occurs in Paragon.
    endhandle

    --find if cables are passing through the Cableway
    !col   = object COLLECTION()
    !col.type('POINTR')
    !col.scope(!this.cableway.cwbran)

    do !cable values !col.results()
      if (!cable.clist[0].size().gt(0)) then
        -- found cables on the CWAY
        !found = TRUE
        break
      else
        !found = FALSE
      endif

    enddo

    -- ask for confirmation
    !cename = !this.cableway.cwbran.flnm
    if (!found) then
      !answer = !!alert.confirm('There are cables routed on the cableway. Still delete $!cename ?')
      if (!answer.neq('YES')) then
        unenhance $!element
        handle (47,15)
          -- Error occurs in Paragon.
        endhandle
        return
      endif
    else
      !answer = !!alert.confirm('Are you sure to delete $!cename ?')
      if (!answer.neq('YES')) then
        unenhance $!element
        handle (47,15)
          -- Error occurs in Paragon.
        endhandle
        return
      endif
    endif

    !!ce = !this.cableway.cwbran

    !this.cableway.delete('CWBRAN')
    --Collect the members to load to the list

    !members = !this.cableway.cway.members

    if (!members.set()) then
      !refArray = !members

      --Update Element Table
      !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
      !this.branchesTable.dtext = !text
      !this.branchesTable.val = !text.size()
      !this.setActiveElement()
      !this.deleteBranch.active = TRUE

    else
      !this.branchesTable.clear()
      --!this.deleteBranch.active = FALSE
      !this.setTask('CREATE','CWBRAN')
    endif
    --clear aids
    aid clear text $!this.headAidNumber
    handle ANY
    endhandle
    aid clear text $!this.tailAidNumber
    handle ANY
    endhandle

  elseif (!elementType.upcase().eq('POINTR')) then

    -- do not allow delete if only two points are there
    if (!!ce.owner.members.size().leq(2)) then
      !!alert.error('Cannot delete point since only two points are available for the branch')
      return
    endif

    -- do not allow to delete head connection point
    if (!!ce.pos.wrt(worl).eq(!this.cableway.cwbran.hpos.wrt(worl)) and !this.cableway.cwbran.hdconn.set()) then
      !!alert.error('Head connection point should not be deleted. Please disconnect head')
      return
    endif

    -- do not allow to delete tail connection point
    if (!!ce.pos.wrt(worl).eq(!this.cableway.cwbran.tpos.wrt(worl)) and !this.cableway.cwbran.tlconn.set()) then
      !!alert.error('Tail connection point should not be deleted. Please disconnect tail')
      return
    endif

    -- check if the material is dressed
    if (!this.cableway.cwtm.deletePointrAllowed(!!ce).not()) then
      !lyDir = !!ce.lydirection.wrt(world).string().before('WRT').trim()
      handle (2,779)
        -- problem with tray open direction
      endhandle
      !next  = NEXT
      handle ANY
        !next = object DBREF()
      endhandle
      !confirm = !!alert.confirm('The segment is already dressed. Remove the dressing and delete?')
      if (!confirm.eq('YES')) then
        !this.cableway.cwtm.undressSegmentWithMaterial(!!ce)
        if(!!ce.tysequence neq 1)then
          !this.cableway.cwtm.undressSegmentWithMaterial(prev)
        endif

      else
        return
      endif
    endif

    -- ask for final confirmation
    !cename = !!ce.flnm
    -- check for passing cables
    if (!!ce.clist[0].set()) then
      !answer = !!alert.confirm('There are cables passing through this point. Still delete?')
      if (!answer.neq('YES')) then
        return
      endif
    else
      !answer = !!alert.confirm('Are you sure to delete $!cename ?')
      if (!answer.neq('YES')) then
        return
      endif
    endif

    -- assign variable for head Connection
    !headConnect = FALSE
    !tailConnect = false
    !routeNodes = object ARRAY()
    -- ask confirmation to delete the first and last point
    if (!!ce.sequence.eq(1)) then
      !confirm = !!alert.confirm('You are deleting the first point. Make next point as branch head ?')
      if (!confirm.eq('NO')) then
        return
      else
        !headConnect = true
        !connectPos  = pos of next wrt /*
        -- get the connected route nodes
        !depref = !!ce.depref
        do !node values !depref
          if (!node.type.eq('RNODE')) then
            !routeNodes.append(!node)
          endif
        enddo
      endif
    endif

    if (!!ce.sequence.eq(!!ce.owner.members.size())) then
      !confirm = !!alert.confirm('You are deleting the last point. Make previous point as branch tail ?')
      if (!confirm.eq('NO')) then
        return
      else
        !tailConnect = true
        !connectPos  = pos of prev wrt /*
        -- get the connected route nodes
        !depref = !!ce.depref
        do !node values !depref
          if (!node.type.eq('RNODE')) then
            !routeNodes.append(!node)
          endif
        enddo
      endif
    endif



    --get the previous POINTR
    !ce = !!ce
    previous
    handle ANY
      --first point
      NEXT
    endhandle
    !pre = !!ce
    !!ce = !ce
    !this.cableway.delete('POINTR')

    -- connect branches if required
    if (!headConnect) then
      !this.cableway.cwbm.startFromFreePoint(!this.cableway.cwbran, !connectPos)
    endif
    if (!tailConnect) then
      !this.cableway.cwbm.endFromFreePoint(!this.cableway.cwbran, !connectPos)
    endif

    !!ce  = !pre
    handle ANY
    endhandle

    -- reconnect route nodes
    if (!routeNodes.set()) then
      do !rnode values !routeNodes
        !rnode.posref = !!ce
      enddo
    endif

    if(defined(!lyDir) and !next.set())then

      !lyDirNext  = !next.lydirection.wrt(world).string().before('WRT').trim()
      handle(2,779)
        !!alert.error('Please check the tray open direction. Branch cannot be drawn correctly')
        !this.markPoint(FALSE)
        return
      endhandle

      if(!lyDir neq !lyDirNext)then
        !sequence  = !next.sequence
      endif
      if(defined(!sequence))then
        --Checks AYDirection of all pointrs
        !collection = object COLLECTION()
        !collection.scope(RPATH)
        !collection.type('POINTR')
        !result = !collection.results()
        if (!this.cableway.cwtm.setPosOnPointrAllowed(!next).not()) then
          if(!!alert.confirm('Direction of $!<next.flnn> has been changed. Is it ok to remove the materials after this POINTR?').eq('YES'))then
            do !pointrs from !sequence to !result.size()
              !this.cableway.cwtm.undressSegmentWithMaterial(!result[$!pointrs])
            enddo
          endif
        endif
      endif

    endif

    !this.currentElement()


  elseif !elementType.upcase().eq('RNODE') then
    if (!this.cableway.rnode eq !!ce) then
      !!deleteCE()

    elseif (!this.cableway.rnode.type.upcase().eq('RNODE')) then
      !tempDB = !this.cableway.rnode.owner
      $!this.cableway.rnode
      !!deleteCE()
      $!tempDB
    endif
    !this.back('CWBRANTASKS')

  elseif (!elementType.upcase().eq('RATTA')) then

    if (!this.cableway.ratta eq !!ce ) then
      !!deleteCE()
    elseif (!this.cableway.ratta.type.upcase().eq('RATTA')) then
      !tempDB = !this.cableway.ratta.owner
      $!this.cableway.ratta
      !!deleteCE()
      $!tempDB
    endif
    !this.back('CWBRANTASKS')
  endif
endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: createData
--
-- Description: generates the data required to create an element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createData(!elementType is STRING)

  axes off

  if (!elementType eq 'CWAY') then
    if (!!cbldflts.cwayzonedefault.set()) then
      !this.cableway.activeElement = !!cbldflts.cwayzonedefault
    endif

    !this.cwayName.val   = ''
    !this.cwayCeTag.val  = 'Current Element:     ' & !this.cableway.activeElement.flnn
    !this.cwayDesc.val   = ''
    !this.cwayFunc.val   = ''
    !this.cwayPurp.val   = ''

  elseif (!elementType eq 'CWBRAN') then

    !this.cwbranCeTag.val = 'Current Element :      ' & !this.cableway.activeElement.flnn
    --This is wrong fix
    --!this.cableway.cway = !this.cableway.activeElement

    !tempIsNamed = !this.cableway.cway.isNamed
    handle Any
      !tempIsNamed = false
    endhandle

    if(!tempIsNamed) then
      !this.autoNameCe(|CWBRAN|)
    else
      !this.cwbranName.val = ''
    endif

    --Populate width and height gadgets from defaults
    !this.cwbranVWidth.val   = !!cbldflts.cwbranVWidth
    !this.cwbranVHeight.val  = !!cbldflts.cwbranVHeight
    --Populate cwbranRnodeCreation member from defaults
    !this.cwbranRnodeCreation = !!cbldflts.cwbranRnodeCreation
    --Populate Cable Excess and Maximum Fill from defaults
    !this.cwbranCexs.val     = !!cbldflts.cwbranCexs
    !this.cwbranMaxfil.val   = !!cbldflts.cwbranMaxfil

    !this.cwbranDesc.val  = ''
    !this.cwbranFunc.val  = ''
    !this.cwbranPurp.val  = ''
    !this.cwbranRllogical.val = |('')|
    --!this.cwbranCexs.val = 0
    --!this.cwbranMaxfil.val = 100
    !this.bangle.val  = 0
    !this.brad.val  = 0
    !this.rpathYdir.val = U WRT/*
    !this.lengthForHead.val = 0
    !this.lengthForTail.val = 0
    !this.cwbranHeadPosControl.forceXYZ(0,0,0)
    !this.cwbranTailPosControl.forceXYZ(0,0,0)
    !this.cwbranVHeightTag.visible = TRUE
    !this.cwbranVHeight.visible    = TRUE
    !this.cwbranVShape.val         = 1
    !this.cwbranVWidthTag.val      = 'Width :'
    !this.cwbranJust.val           = 1

    !this.cwbranIclass.dtext       = !this.dinter
    !this.cwbranIclass.select('DTEXT',!!cbldflts.cwbranIclass.selection())
    handle ANY
      !this.cwbranIclass.select('DTEXT','unset')
    endhandle
    !this.cwbranRllogicalTag.val   = FALSE
    !this.cwbranIclassTag.val      = TRUE
    !this.updateFrame()

    -- orthogonal route options
    !orthoDisplay  = object ARRAY()
    !orthoReplace  = object ARRAY()
    !orthoReplace.append('XYZ')
    !orthoReplace.append('XZY')
    !orthoReplace.append('YXZ')
    !orthoReplace.append('YZX')
    !orthoReplace.append('ZXY')
    !orthoReplace.append('ZYX')

    var !coordinate coordinate
    if (!coordinate.eq('XYZ')) then
      !orthoDisplay.append('X-Y-Z')
      !orthoDisplay.append('X-Z-Y')
      !orthoDisplay.append('Y-X-Z')
      !orthoDisplay.append('Y-Z-X')
      !orthoDisplay.append('Z-X-Y')
      !orthoDisplay.append('Z-Y-X')
    else
      !orthoDisplay.append('E-N-U')
      !orthoDisplay.append('E-U-N')
      !orthoDisplay.append('N-E-U')
      !orthoDisplay.append('N-U-E')
      !orthoDisplay.append('U-E-N')
      !orthoDisplay.append('U-N-E')
    endif

    !this.orthoOpt.dtext = !orthoDisplay
    !this.orthoOpt.rtext = !orthoReplace
    !this.orthoOpt.val   = 1

    --Mark Route Points
    !this.markPoint(FALSE)

  elseif (!elementType eq 'POINTR') then

    !refArray = !this.cableway.rpath.members
    handle ANY
      !rpath = RPATH 1 of $!this.cableway.cwbran
      !refArray = !rpath.members
    endhandle
    --Update Element Table
    !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
    !this.pointrTable.dtext = !text
    !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].ref.string()'))
    !this.pointrTable.rtext = !text
    !this.pointrTable.val = !this.pointrTable.dtext.findfirst(!this.cableway.pointr.flnn)
    handle ANY
      !this.pointrTable.val = 1
    endhandle
    !!ce = !this.pointrTable.selection().dbref()
    !this.cableway.pointr  = !!ce
    !this.cableway.activeElement = !!ce

    !startPos  = !this.pointrTable.selection().dbref().position.wrt(World)
    !this.pointrPosControl.forceXYZ(!startPos.east ,!startPos.north ,!startPos.up)

    !this.setLengthAndDirection('Normal')
    axes at $!this.cableway.pointr
    !this.directionTag.val = 'Direction from Current point :'
    !this.lengthTag.val    = 'Distance from Current point :'
    !this.pointrCeTag.val       =  'Current Element    : ' & !this.cableway.activeElement.flnn
    !this.fradius.val     = 0

  elseif (!elementType eq 'RNODE') then

    !this.rnodeName.val  = ''
    !this.rnodeDesc.val  = ''
    !this.rnodeFunc.val  = ''
    !this.rnodePurp.val  = ''
    !this.rnodeZdis.val  = 0
    !this.rnodePkdis.val = 0
    !this.rnodeXoff.val  = 0
    !this.rnodeYoff.val  = 0
    !this.rnodeZoff.val  = 0
    !this.rnodeCref.val  = ''
    !this.rnodeSpref.val = ''
    !this.rnodeMoveValue.val = 0

    -- grey out unused offset gadgets
    !this.rnodeXoff.active = FALSE
    !this.rnodeYoff.active = FALSE
    !this.rnodeZoff.active = FALSE


    -- collect route points for populating reference gadget
    !col = object COLLECTION()
    !col.scope(!this.cableway.cwbran)
    !col.type('POINTR')
    !text = object ARRAY()
    do !i from 1 to !col.results().size()
      !text.append(!i.string())
    enddo
    !this.rnodePosn.dtext = !text
    !this.rnodePosn.rtext = !text
    !this.cableway.pointr = !col.results()[1]
    --aids
    !this.rnodeBox.box.position  = !this.cableway.cwbran.hpos
    !this.rnodeBox.draw(!this.rnodeAidNumber)

  elseif (!elementType eq 'RATTA') then

    !this.rattaZdis.val  = 0
    !this.rattaPkdis.val = 0
    !this.rattaMoveValue.val = 0
    -- collect route points for populating reference gadget
    !col = object COLLECTION()
    !col.scope(!this.cableway.cwbran)
    !col.type('POINTR')
    !text = object ARRAY()
    do !i from 1 to !col.results().size()
      !text.append(!i.string())
    enddo
    !this.rattaPosn.dtext = !text
    !this.rattaPosn.rtext = !text
    !this.cableway.pointr = !col.results()[1]
    --aids
    !this.rattaSphere.position  = !this.cableway.cwbran.hpos
    !this.rattaSphere.draw(!this.rattaAidNumber)

  elseif (!elementType eq 'RSECT') then
    !this.rsectPosControl.forceXYZ(0,0,0)
  elseif (!elementType eq 'CURVE') then
    !this.curvePosControl.forceXYZ(0,0,0)
  elseif (!elementType eq 'CWBRANTASKS') then
    if (!this.cableway.cway.members.size().gt(0)) then
      !members = !this.cableway.cway.members
      !this.cableway.cwbrans = !members
      handle (2,751)
        !members = !this.cableway.activeElement.own.members
        !this.cableway.cwbrans = !members
      endhandle
      !refArray = !members
      --Update Element Table
      !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
      !this.branchesTable.dtext = !text
      !this.branchesTable.val = !this.branchesTable.dtext.findfirst(!this.cableway.cwbran.namn)
      handle ANY
      endhandle
      !this.deleteBranch.active = TRUE
      if (!this.cableway.cwbran.hcref.unset()  and !!ce.tcref.unset()) then
        !this.disconnect.active = FALSE
      else
        !this.disconnect.active = TRUE
      endif
    else
      !this.branchesTable.clear()
      !this.deleteBranch.active = FALSE
    endif

  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: cablewayGadgets
--
-- Description: Sets the  gadgets required to create
-- cableway
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cablewayGadgets(!formTask is STRING)
  -- clear aids
  !this.clearAids()
  -- clear the point marks
  !this.markPoint(FALSE)

  if (!formTask eq 'CREATE') then
    !this.createCwayApply.visible       = TRUE
    !this.modifyCwayApply.visible       = FALSE
    !this.discardCwayApply.visible      = FALSE
    !this.createCwayIcon.visible        = TRUE
    !this.modifyCwayIcon.visible        = FALSE
    !this.discardCwayIcon.visible       = FALSE
    !this.createCwayBranch.visible      = FALSE
    !this.cwayCurrElement.visible       = FALSE
    !this.deleteCway.visible            = FALSE
    !this.deleteCwayIcon.visible        = FALSE

  elseif (!formTask eq 'MODIFY') then
    !this.modifyCwayApply.visible       = TRUE
    !this.discardCwayApply.visible      = TRUE
    !this.createCwayApply.visible       = FALSE
    !this.modifyCwayIcon.visible        = TRUE
    !this.discardCwayIcon.visible       = TRUE
    !this.createCwayIcon.visible        = FALSE
    !this.createCwayBranch.visible      = TRUE
    !this.cwayCurrElement.visible       = TRUE
    !this.deleteCway.visible            = TRUE
    !this.deleteCwayIcon.visible        = TRUE
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: branchGadgets
--
-- Description: Sets the gadgets required for
-- Branch Tasks
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .branchGadgets(!formTask is STRING)
  -- clear aids
  !this.clearAids()

  if (!formTask eq 'CREATE') then
    !this.createCwbranApply.visible       = TRUE
    !this.modifyCwbranApply.visible       = FALSE
    !this.discardCwbranApply.visible      = FALSE
    !this.createCwbranIcon.visible        = TRUE
    !this.modifyCwbranIcon.visible        = FALSE
    !this.discardCwbranIcon.visible       = FALSE
    !this.cwbranTasks.visible             = FALSE
    !this.cwbranCurrElement.visible       = FALSE
    !this.ortho.visible                   = TRUE
    !this.orthoOpt.visible                = TRUE
    !this.disconnectHead.visible          = FALSE
    !this.disconnectTail.visible          = FALSE
    !this.markPointCwbranFrame.visible    = false
    !this.cwlistCables.visible            = false


  elseif (!formTask eq 'MODIFY') then
    !this.createCwbranApply.visible       = FALSE
    !this.modifyCwbranApply.visible       = TRUE
    !this.discardCwbranApply.visible      = TRUE
    !this.createCwbranIcon.visible        = TRUE
    !this.modifyCwbranIcon.visible        = TRUE
    !this.discardCwbranIcon.visible       = TRUE
    !this.cwbranTasks.visible             = TRUE
    !this.cwbranCurrElement.visible       = TRUE
    !this.ortho.visible                   = FALSE
    !this.orthoOpt.visible                = FALSE
    !this.disconnectHead.visible          = TRUE
    !this.disconnectTail.visible          = TRUE
    !this.markPointCwbranFrame.visible    = true
    !this.cwlistCables.visible             = true

  endif

  !this.headOpt.val   = 1
  !this.tailOpt.val   = 1
  !this.optAction('HEAD')
  !this.optAction('TAIL')

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: modifyShapeGadgets
--
-- Description: Modifies the shape gadgets
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyShapeGadgets()

  if !this.cwbranVShape.val.eq(1) then
    !this.cwbranVHeightTag.visible = TRUE
    !this.cwbranVHeight.visible    = TRUE
    !this.cwbranVWidthTag.val      = 'Width :'
  else
    !this.cwbranVHeightTag.visible = FALSE
    !this.cwbranVHeight.visible    = FALSE
    !this.cwbranVWidthTag.val      = 'Diameter :'

  endif


endmethod
--End of method definition

