    !this.modifyRnodeApply.visible       = FALSE
    !this.discardRnodeApply.visible      = FALSE
    !this.createRnodeIcon.visible        = TRUE
    !this.modifyRnodeIcon.visible        = FALSE
    !this.discardRnodeIcon.visible       = FALSE
    !this.rnodeCurrElement.visible       = FALSE
    !this.rnodeMode.val  =  1
    !this.deleteRnodeIcon.visible        = FALSE

  elseif (!formTask eq 'MODIFY') then

    !this.createRnodeApply.visible       = FALSE
    !this.deleteRnode.visible            = TRUE
    !this.modifyRnodeApply.visible       = TRUE
    !this.discardRnodeApply.visible      = TRUE
    !this.createRnodeIcon.visible        = FALSE
    !this.modifyRnodeIcon.visible        = TRUE
    !this.discardRnodeIcon.visible       = TRUE
    !this.rnodeCurrElement.visible       = TRUE
    !this.rnodeMode.val  =  2
    !this.deleteRnodeIcon.visible        = TRUE
  endif


endmethod
