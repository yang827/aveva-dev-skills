------------------------------------------------------------------------
--
-- Method: nameCheck
--
-- Description: Check the correctness of the name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameCheck(!elementType is STRING)

  --Check name of Element
  !name                   = !!checkName(!this.$!<elementType>Name.val, 'NEW')

  --Update gadget with name
  if(!name.set()) then
    !name               = !name.substring(2)
    !this.$!<elementType>Name.val          = !name
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: optAction
--
-- Description: Action carried out with the picked Element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .optAction(!optLocation is STRING)
  !!edgCntrl.remove(!this.packetEDG)
  !this.lengthFor$!<optLocation>.visible      = FALSE
  !this.thru$!<optLocation>.visible           = FALSE
  if (!this.$!<optLocation>Opt.val.eq(1)) then
    !this.netCwbran$!<optLocation>Frame.active = TRUE
    !this.cwbranPick$!<optLocation>Pos.visible = TRUE
    !this.cwbran$!<optLocation>PosCntrl.active = TRUE
    !this.copy$!<optLocation>Pos.visible       = TRUE
  else
    !this.cwbranPick$!<optLocation>Pos.visible = FALSE
    !this.copy$!<optLocation>Pos.visible       = FALSE
    -- Make position control inactive and unlock any of the coordinates
    !this.netCwbran$!<optLocation>Frame.active = FALSE
    !this.cwbran$!<optLocation>PosControl.unlockall()
  endif

  if (!this.$!<optLocation>Opt.val.eq(2)) then
    if (!optLocation.lowcase().eq('head')) then
      !pickloc = 'head'
    else
      !pickloc = 'tail'
    endif
    !this.pickElement(|head|, !pickloc, |CWBRAN|, |cwbran$!<optLocation>poscontrol|)
  elseif (!this.$!<optLocation>Opt.val.eq(3)) then
    if (!optLocation.lowcase().eq('head')) then
      !pickloc = 'head'
    else
      !pickloc = 'tail'
    endif
    !this.pickElement(|tail|, !pickloc, |CWBRAN|, |cwbran$!<optLocation>poscontrol|)
  elseif (!this.$!<optLocation>Opt.val eq 4) then
    !pickloc  = !optLocation
    !this.pickElement(!optLocation , !pickloc, |CWSEG|, |cwbran$!<optLocation>poscontrol|)
    !this.lengthFor$!<optLocation>.visible = true
    !this.lengthFor$!<optLocation>.active  = false
    !this.thru$!<optLocation>.visible      = true
    !this.thru$!<optLocation>.active      = false
  elseif (!this.$!<optLocation>Opt.val.eq(5)) then
    var !a collect all RATTA from drawlist
    remove all RATTA
    add RATTA from !a
    !pickloc  = !optLocation
    !this.pickElement(!optLocation , !pickloc, |CWSEG|, |cwbran$!<optLocation>poscontrol|)
  endif

endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method: loadData
--
-- Description: Load the data of the element to be modified
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadData(!loadElement is STRING)

  axes off

  if (!loadElement.eq('CWAY')) then
    !this.cwayDesc.val   = !this.cableway.cway.description
    !this.cwayFunc.val   = !this.cableway.cway.function
    !this.cwayPurp.val   = !this.cableway.cway.purpose
    !this.cwayCeTag.val  = 'Current Element:     ' & !this.cableway.activeElement.flnn
    !this.cwayName.val   = !this.cableway.cway.flnn
  elseif (!loadElement.eq('CWBRAN')) then
    !this.cwbranDesc.val      = !this.cableway.cwbran.description
    !this.cwbranFunc.val      = !this.cableway.cwbran.function
    !this.cwbranPurp.val      = !this.cableway.cwbran.purpose
    if (!this.cableway.cwbran.rllogical.unset()) then
      !this.cwbranRllogical.val = |('')|
    else
      !this.cwbranRllogical.val = !this.cableway.cwbran.rllogical
    endif
    !this.bangle.val          = !this.cableway.cwbran.bangle
    !this.cwbranCexs.val      = !this.cableway.cwbran.cexs
    !this.cwbranMaxfil.val    = !this.cableway.cwbran.maxfil
    !this.bendRadius          = !this.cableway.getBendRadius(!this.cableway.cwbran)
    !this.brad.val            = !this.bendRadius
    !this.rpathYdir.val       = !this.cableway.rpath.ydir.wrt(worl)
    handle ANY
      !this.rpathYdir.val      = U wrt /*
    endhandle
    !this.lengthForHead.val  = 0
    !this.lengthForTail.val  = 0
    !this.cwbranVWidth.val     = !this.cableway.cwbran.vwidth
    !this.cwbranVHeight.val    = !this.cableway.cwbran.vheight
    !this.cwbranVShape.val     = !this.cableway.cwbran.vshape + 1

    !this.cwbranJust.val       = !this.cwbranJust.rtext.findfirst(!this.cableway.cwbran.cwjusline)
    handle ANY
      !this.cwbranJust.val     =  1
    endhandle
    !this.cwbranIclass.select('DTEXT',!this.cableway.cwbran.iclass)
    handle ANY
      if (!this.cableway.cwbran.iclass.neq('')) then
        !this.dinter.append(!this.cableway.cwbran.iclass)
        !this.cwbranIclass.dtext = !this.dinter
        !this.cwbranIclass.select('DTEXT',!this.cableway.cwbran.iclass)
      else
        !this.cwbranIclass.select('DTEXT','unset')
      endif
    endhandle

    --Collect the members to load to the list

    !members = !this.cableway.cway.members
    !this.cwbranName.val  = !this.cableway.cwbran.flnn
    !this.cwbranCeTag.val = 'Current Element :      ' & !this.cableway.cwbran.flnn
    if (!members.set()) then
      !refArray = !members

      --Update Element Table
      !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
      !this.branchesTable.dtext = !text
      !this.branchesTable.val = !this.branchesTable.dtext.findfirst(!this.cableway.cwbran.flnn)
      !this.deleteBranch.active = TRUE
      if (!this.cableway.cwbran.hcref.unset()) then
        !this.disconnect.active = FALSE
      else
        !this.disconnect.active = TRUE
      endif
    else
      !this.branchesTable.clear()
      !this.deleteBranch.active = FALSE
    endif

    -- disconnect gadgets on branch panel
    if (!this.cableway.cwbran.hdconn.unset()) then
      !this.disconnectHead.active = FALSE
    else
      !this.disconnectHead.active = TRUE
    endif
    if (!this.cableway.cwbran.tlconn.unset()) then
      !this.disconnectTail.active = FALSE
    else
      !this.disconnectTail.active = TRUE
    endif

    -- shapes
    if (!this.cableway.cwbran.vshape.eq(1)) then
      !this.cwbranVHeightTag.visible = FALSE
      !this.cwbranVHeight.visible    = FALSE
      !this.cwbranVWidthTag.val      = 'Diameter :'
    else
      !this.cwbranVHeightTag.visible = TRUE
      !this.cwbranVHeight.visible    = TRUE
      !this.cwbranVWidthTag.val      = 'Width :'
    endif

    -- Update position Gadgets
    !hpos = !this.cableway.cwbran.hpos.wrt(World)
    --if the branch is not connected then hpos and tpos wont be set
    handle (2,779)
      !hpos = N0
    endhandle

    !tpos = !this.cableway.cwbran.tpos.wrt(World)
    --if the branch is not connected then hpos and tpos wont be set
    handle (2,779)
      !tpos = N0
    endhandle
    !this.cwbranHeadPosControl.xyz(!hpos.east, !hpos.north, !hpos.up)
    !this.cwbranTailPosControl.xyz(!tpos.east, !tpos.north, !tpos.up)
    --aids
    !this.aid('Head', !hpos)
    !this.aid('Tail', !tpos)


  elseif (!loadElement eq 'CWBRANTASKS') then
    --Collect the members to load to the list
    !members = !this.cableway.cway.members

    if (!members.set()) then
      !refArray = !members

      --Update Element Table
      !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
      !this.branchesTable.dtext = !text
      !this.branchesTable.val = !this.branchesTable.dtext.findfirst(!this.cableway.cwbran.flnn)
      if (!this.cableway.cwbran.hcref.unset() and !this.cableway.cwbran.tcref.unset()) then
        !this.disconnect.active = FALSE
      else
        !this.disconnect.active = TRUE
      endif
      !this.deleteBranch.active = TRUE
    else
      !this.branchesTable.clear()
      !this.deleteBranch.active = FALSE
    endif

  elseif (!loadElement eq 'POINTR') then
    !position = !this.cableway.pointr.position.wrt(World)
    handle ANY
      !position = N0
    endhandle
    !this.pointrPosControl.xyz(!position.east, !position.north, !position.up)
    !refArray = !this.cableway.rpath.members

    --Update Element Table
    !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].flnn'))
    !this.pointrTable.dtext = !text
    !text = !refArray.evaluate(object BLOCK('!refArray[!evalindex].ref.string()'))
    !this.pointrTable.rtext = !text
    !this.pointrTable.val = !this.pointrTable.dtext.findfirst(!this.cableway.pointr.flnn)
    handle ANY
      !this.pointrTable.val = 1
    endhandle

    !this.setLengthAndDirection('Normal')
    axes at $!this.cableway.pointr
    !this.directionTag.val = 'Direction from Previous point :'
    !this.lengthTag.val    = 'Distance from Previous point :'
    !this.pointrCeTag.val       =  'Current Element    : ' & !this.cableway.activeElement.flnn
    !this.fradius.val  = !this.cableway.activeElement.fradius

    if (!this.pointrTable.val.eq(1)) then
      !this.length.val = 0
    endif

  elseif (!loadElement eq 'RNODE') then
    !this.rnodeName.val    = !!ce.flnn
    !this.rnodeDesc.val    = !!ce.description
    !this.rnodeFunc.val    = !!ce.function
    !this.rnodePurp.val    = !!ce.purpose
    !this.rnodeZdis.val    = !!ce.zdis
    !this.rnodePkdis.val   = !!ce.pkdis
    !this.rnodeXoff.val    = !!ce.xoffset
    !this.rnodeYoff.val    = !!ce.yoffset
    !this.rnodeZoff.val    = !!ce.zoffset
    !this.rnodeMoveValue.val = 0
    !this.rnodeCref.val    = !!ce.connRef[1].namn
    handle ANY
      !this.rnodeCref.val = ''
    endhandle
    !this.rnodeSpref.val    = !!ce.spref.namn
    handle ANY
      !this.rnodeSpref.val = ''
    endhandle
    !this.rnodeTypeOpt.val = !this.rnodeTypeOpt.rtext.findfirst(!!ce.rnType)
    handle ANY
      !this.rnodeTypeOpt.val = 1
    endhandle
    -- make offset gadgets active dependent on rntype
    if (!!ce.rnType.eq('OFFS')) then
      !this.rnodeXoff.active = TRUE
      !this.rnodeZoff.active = TRUE
    else
      !this.rnodeXoff.active = FALSE
      !this.rnodeZoff.active = FALSE
    endif
    if (!!ce.rnType.eq('GAP') or !!ce.rnType.eq('PENE')) then
      !this.rnodeYoff.active = TRUE
    else
      !this.rnodeYoff.active = FALSE
    endif


    !col = object COLLECTION()
    !col.scope(!!ce.owner.owner)
    !col.type('POINTR')
    !text = object ARRAY()
    do !i from 1 to !col.results().size()
      !text.append(!i.string())
    enddo
    !this.rnodePosn.dtext = !text
    !this.rnodePosn.rtext = !text
    if (!!ce.posref.set()) then
      !number = !col.results().findfirst(!!ce.posref)
    else
      !number = 1
    endif
    !this.rnodePosn.val =  !number
    !this.cableway.pointr = !col.results()[!number]
    --aids
    !this.rnodeBox.box.position  = !!ce.position.wrt(worl)
    if (!!ce.posref.set()) then
      !ydir   = !!ce.posref.pdir[2].wrt(worl).string()
    else
      !ydir   = 'N'
    endif
    !this.rnodeBox.box.orientation  = object ORIENTATION('Y is $!ydir')
    handle ANY
      !this.rnodeBox.box.orientation  = object ORIENTATION('Y is N')
    endhandle
    !this.rnodeBox.draw(!this.rnodeAidNumber)

  elseif (!loadElement eq 'RATTA') then
    !this.rattaZdis.val  = !!ce.zdis
    !this.rattaPkdis.val = !!ce.pkdis
    !this.rattaMoveValue.val = 0

    !col = object COLLECTION()
    !col.scope(!!ce.owner.owner)
    !col.type('POINTR')
    !text = object ARRAY()
    do !i from 1 to !col.results().size()
      !text.append(!i.string())
    enddo
    !this.rattaPosn.dtext = !text
    !this.rattaPosn.rtext = !text
    if (!!ce.posref.set()) then
      !number = !col.results().findfirst(!!ce.posref)
    else
      !number = 1
    endif
    !this.rattaPosn.val =  !number
    !this.cableway.pointr = !col.results()[!number]
    --aids
    !this.rattaSphere.position  = !!ce.position.wrt(worl)
    !this.rattaSphere.draw(!this.rattaAidNumber)

  elseif (!loadElement eq 'RSECT') then

    !position = !!ce.position.wrt(World)
    handle ANY
      !position = N0
    endhandle

    !this.rsectPosControl.xyz(!position.east, !position.north, !position.up)

  elseif (!loadElement eq 'CURVE') then

    !position = !!ce.position.wrt(World)
    handle ANY
      !position = N0
    endhandle

    !this.curvePosControl.xyz(!position.east, !position.north, !position.up)

  elseif (!loadElement eq 'CWBRANTASKS') then
    if (!!ce.hdconn.unset() and !!ce.tlconn.unset()) then
      !this.disconnect.active  = FALSE
    endif

  endif
endmethod
--End of method definition


---------------------------------------------------------------------------
--
-- Method:      PickElement
--
-- Description: EDG to pick element for action
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Option Gadget for connection (Head or Tail)
--  2   R     STRING      Which connection (Head or Tail)
--  3   R     STRING      Type of pick, argument to differentiate between general pick and specific
--  4   R     STRING      Name of the position control gadget
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickElement(!location is STRING, !pickloc is STRING, !type is STRING, !member is STRING)

  if (!type.eq('ANY')) then

    !!cblCway.pickedElementPos  = object POSITION()
    !this.packetEDG.action      = '!!cblCway.pickedElementPos = !this.return[1].position.wrt(worl)'
    !this.packetEDG.defineposition('Pick to define position')
    !this.packetEDG.priority    = 2
    !this.packetEDG.remove      = true
    !this.packetEDG.continue = '!!cblCway.edgPopulate(|$!location|, |$!type|, |$!member| )'
    !!edgCntrl.add(!this.packetEDG)
  else

    if (!this.$!<pickloc>Opt.val.eq(2) or !this.$!<pickloc>Opt.val.eq(3)) then
      !this.packetEDG.elementPick('Pick CWBRAN')
      !this.packetEDG.priority = 2
      !!cblCway.pickedElementPos  = object POSITION()
      !!cblCway.pickedElementFor$!<pickloc>  = object DBREF()
      !this.packetEDG.action = '!!cblCway.pickedElementFor$!<pickloc> = !this.return[1].item'
      !this.packetEDG.remove      = true
      !element = 'TYPE inset (|CWBRAN|, |CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|)'
      !this.packetEDG.pickPacket.picks[1].pick.input[3] = !element
      !this.packetEDG.pickPacket.picks[1].pick.modifiable = FALSE
      !this.packetEDG.pickPacket.picks[1].numberofpicks = 1
      --!this.packetEDG.escape = '!!cblCway.setTask(!!cblCway.task,|CWBRAN|)'
      !this.packetEDG.continue = '!!cblCway.edgPopulate(|$!location|, |$!type|, |$!member| )'
      !!edgCntrl.add(!this.packetEDG)
    endif

    if (!this.$!<pickloc>Opt.val.eq(4)) then
      !this.wrongPick = FALSE
      !this.dressed   = FALSE
      !this.location  = !location
      !this.packetEDG.pickPacket.stdgraphic('Pick on the segment from which the branch should connect')

      !this.packetEDG.priority = 2
      !!cblCway.pickedElementPos  = object POSITION()
      !this.packetEDG.action = '!!cblCway.derivePickedPoint(!this.return[1])'
      !this.packetEDG.remove = true
      !element = 'TYPE inset (|CWBRAN|, |CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|)'
      !this.packetEDG.pickPacket.picks[1].pick.input[3] = !element
      !this.packetEDG.pickPacket.picks[1].pick.modifiable = FALSE
      !this.packetEDG.pickPacket.picks[1].numberofpicks = 1
      --!this.packetEDG.escape = '!!cblCway.setTask(!!cblCway.task,|CWBRAN|)'
      !this.packetEDG.continue = '!!cblCway.edgPopulate(|$!location|, |$!type|, |$!member| )'
      !!edgCntrl.add(!this.packetEDG)
    endif

    if (!this.$!<pickloc>Opt.val.eq(5)) then
      !this.packetEDG.elementPick('Pick RATTA')
      !this.packetEDG.priority = 2
      !element = 'TYPE eq (|RATTA|)'
      !this.packetEDG.remove = true
      !!cblCway.pickedElementPos  = object POSITION()
      !!cblCway.pickedElementFor$!<pickloc>  = object DBREF()
      !this.packetEDG.action = '!!cblCway.pickedElementFor$!<pickloc> = !this.return[1].item'
      !this.packetEDG.pickPacket.picks[1].pick.input[3] = !element
      !this.packetEDG.pickPacket.picks[1].pick.modifiable = FALSE
      !this.packetEDG.pickPacket.picks[1].numberofpicks = 1
      --!this.packetEDG.escape = '!!cblCway.setTask(!!cblCway.task,|CWBRAN|)'
      !this.packetEDG.continue = '!!cblCway.edgPopulate(|$!location|, |$!type|, |$!member| )'
      !!edgCntrl.add(!this.packetEDG)
    endif
  endif

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      pickPoint
--
-- Description: EDG to pick route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPoint(!item is STRING)

  --reinitialise members
  !this.pickedPointFor$!<item>    = object DBREF()

  !this.wrongPick = FALSE
  !this.dressed   = FALSE
  !this.location  = !item
  !packet = object EDGPACKET()
  !packet.priority = 2
  !packet.pickPacket.stdgraphic('Pick on the segment which $!item should be placed')
  !packet.action = '!!cblCway.derivePickedPoint(!this.return[1])'
  !packet.remove = TRUE
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !packet.pickPacket.picks[1].numberofpicks = 1
  !packet.continue = '!!cblCway.edgPopulate(||, |$!item|, ||)'
  !!edgCntrl.add(!packet)

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      derivePickedPoint
--
-- Description: derives the picked POINTR from edg pick
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePickedPoint(!pickData is EDGPICKDATA)

  !location  = !this.location
  !element   = !pickData.item
  !centreLineFlag = FALSE

  !unusedCheck = !element.type
  handle (2,202)
    !this.wrongPick  = TRUE
    return
  endhandle

  -- if material element selected, then select the branch
  if (!this.material.findfirst(!element.type).unset().not()) then
    !this.dressed  = TRUE
    return
  endif

  if (!element.type.neq('CWBRAN')) then
    !this.wrongPick  = TRUE
    return
  endif
  !facets    = !pickData.facets
  !pointVect = !pickData.pickLine
  !lpos      = !pickData.lines

  if (!facets.unset()) then
    -- no facets. so pick the line
    !pickLine = object LINE(!lpos[1],!lpos[2])
    !line = !pointVect.line(100)
    !intersect = !pickLine.intersection(!line)
    !centreLineFlag = TRUE
  else
    -- create profile from facets
    !profPos = !facets[1]
    -- get orientation from first two positions of the facets
    !facetLine = object LINE(!facets[1], !facets[2])
    !ydir = !facetLine.direction()
    !profOri = object ORIENTATION('Y is $!ydir')
    !prof    = object PROFILE(!profPos, !profOri, !facets)
    --close the profile
    !prof.close()

    --make a plane from the profile
    !profPlane = !prof.plane()

    -- create line from point vector
    !line = !pointVect.line(100)

    -- if line is perpendicular to profile, manipulate to intersect at some other point
    if (!prof.orientation.zdir().opposite().eq(!line.direction()) or !prof.orientation.zdir().eq(!line.direction())) then
      !intersect = !prof.near(!line.startposition)
      !centreLineFlag = TRUE
    else
      -- project line on to profile and get position
      !intersects = !prof.intersections(!line)
      !intersect  = !intersects[1]
    endif
  endif

  --construct lines along Route
  !col = object COLLECTION()
  !col.scope(!element)
  !col.type('POINTR')

  !points = !col.results()

  !routeLines = object ARRAY()
  do !i from 1 to (!points.size() - 1)
    !rline = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
    !routeLines.append(!rline)
  enddo
  -- find the nearest line to profile intersection
  !distArray = object ARRAY()
  do !j from 1 to !routeLines.size()
    !dist = !routeLines[!j].distance(!intersect)
    !distArray.append(!dist)
  enddo
  -- sort the distances to get the index of the point
  !sortDist = !distArray.sortedindices()

  -- check if there are more points than 1
  !unusedSortDist = !sortDist[2]
  handle ANY
    !inx = 1
    !pointr = !points[!sortDist[1]]
  elsehandle NONE
    -- if the points are in same line, then find the nearest point to intersection
    !inx = 1
    !nearestPoint  =  !points[!sortDist[1]]
    !lineFirst  = object LINE(!intersect, !points[!sortDist[1]].position.wrt(worl))
    do !x from 2 to (!sortDist.size())
      if (!distArray[!sortDist[1]].eq(!distArray[!sortDist[!x]])) then
        !lineSecond = object LINE(!intersect, !points[!sortDist[!x]].position.wrt(worl))
        if (!lineFirst.length().gt(!lineSecond.length())) then
          !nearestPoint = !points[!sortDist[!x]]
          !lineFirst    = !lineSecond
          !inx = !x
        endif
      endif
    enddo
    !pointr  = !nearestPoint
  endhandle


  -- set the POINTR to form member after re initialising the member
  !this.pickedPointFor$!<location>  = object DBREF()
  !this.pickedPointFor$!<location>  = !pointr
  !this.cableway.pointr             = !pointr

  -- get more accurate point during pick by intersecting with a plane along the centre line
  if (!centreLineFlag.not()) then

    -- move the profile plane to centre line
    !profPlane.position = !routeLines[!sortDist[!inx]].startposition

    --project view line to plane
    !projectedLine = !line.projected(!profPlane)

    --get the intersection
    !intersect = !routeLines[!sortDist[!inx]].intersection(!projectedLine)
    handle ANY
      -- lines are parallel
      !intersect = !profPlane.intersection(!line)
    endhandle

  endif

  -- get the position on the segment
  !this.pickedElementPos  = !routeLines[!sortDist[!inx]].near(!intersect)

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      setSpco
--
-- Description: Set the different SPCOs based on the spec selected
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpco(!gadOne is GADGET, !gadTwo is GADGET)

  if (!gadOne.selection().neq('None')) then

    !col  = object COLLECTION()
    !col.scope(!gadOne.selection().dbref())
    !col.type('SPCO')

    do !inx indices !col.results()
      !spcoString[!inx] = !col.results()[!inx].namn
      !spcoDbref[!inx]  = !col.results()[!inx].refe.string()
    enddo

    !gadTwo.dtext = !spcoString
    !gadTwo.rtext = !spcoDbref
  else
    !non[1] = 'None'
    !nulref[1] = 'Nulref'
    !gadTwo.dtext = !non
    !gadTwo.rtext = !nulref


  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: setActiveElement
--
-- Description: Sets the element selected form list as active element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActiveElement()

  -- form task
  !this.task = 'MODIFY'

  !activeElementString = '/' + !this.branchesTable.selection()
  !activeElement = object DBREF(!activeElementString)
  handle ANY
    !activeElement = object DBREF(!this.branchesTable.selection())
    handle ANY
      !activeElement = !this.cableway.cwbran
    endhandle
  endhandle

  -- mark points
  !this.markPoint(FALSE)

  !this.cableway.activeElement = !activeElement
  !this.cableway.cwbran        = !activeElement
  !!ce = !activeElement
  !this.cableway.cableway(!!ce)
  if (!this.task.upcase().eq('MODIFY')) then
    !this.cableway.rpath   = RPATH 1 of CE
    handle ANY
      --No route path created
    endhandle
    !this.cableway.pointr  = POINTR 1 of RPATH 1 of CE
    handle ANY
      --No route points created
    endhandle
  endif
  if (!this.cableway.cwbran.hdconn.unset()) then
    if (!this.cableway.cwbran.tlconn.unset()) then
      !this.disconnect.active = FALSE
    endif
  else
    !this.disconnect.active = TRUE
  endif

  --update aids

  !this.aid('Head', !activeElement.hpos.wrt(worl))
  handle ANY
    -- hpos not set
  endhandle
  !this.aid('Tail', !activeElement.tpos.wrt(worl))
  handle ANY
    -- tpos not set
  endhandle


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: currentElement
--
-- Description: Loads the data of current Element to form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .currentElement()

  !elemList[1] = 'CWAY'
  !elemList[2] = 'CWBRAN'
  !elemList[3] = 'RPATH'
  !elemList[4] = 'POINTR'
  !elemList[5] = 'CURVE'
  !elemList[6] = 'EXTGEO'
  !elemList[7] = 'RSECT'
  !elemList[8] = 'RNODE'
  !elemList[9] = 'RATTA'

  --Check whether the current element type is in elemList
  !type  = !!ce.type
  !exist = !elemList.findfirst(!type)

  if !exist.set() then
    !this.clearAids()
    !this.markPoint(false)
    !this.setTask(|MODIFY|,!type)
  else
    !!alert.error('This action cannot be performed on the current element')
    return
  endif

  if (!type eq 'CWBRAN') then
    !this.getCurrentFillLevel()
  endif

endmethod
--End of method definition


---------------------------------------------------------------------------
--
-- Method:      edgPopulate
--
-- Description: Populate the gadgets after getting the values from edg
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Which connection (Head or Tail)
--  2   R     STRING      Type of pick, argument to differentiate between general pick and specific
--  3   R     STRING      Name of the position control gadget
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgPopulate(!location is STRING, !type is STRING, !member is STRING)

  if (!type.upcase().eq('ANY')) then
    if(!this.pickedElementPos.unset())then
      return
    endif
    !pos        = !this.pickedElementPos.wrt(world)
    !this.$!<member>.xyz(!pos.east, !pos.north, !pos.up)
    if (!member.lowcase().eq('pointrposcontrol')) then
      !!cblCway.setLengthAndDirection(|Gadget|)
    endif

  elseif (!type.upcase().eq('CWBRAN')) then
    --the pick may be a material element. Find if so and select the branch accordingly

    if (!member.lowcase().eq('cwbranheadposcontrol')) then
      if(!this.pickedElementForHead.unset())then
        return
      endif
      if (!this.material.findfirst(!this.pickedElementForHead.type).unset().not()) then
        !this.pickedElementForHead = !this.pickedElementForHead.owner.owner
      endif
    elseif (!member.lowcase().eq('cwbrantailposcontrol')) then
      if(!this.pickedElementForTail.unset())then
        return
      endif
      if (!this.material.findfirst(!this.pickedElementForTail.type).unset().not()) then
        !this.pickedElementForTail = !this.pickedElementForTail.owner.owner
      endif
    endif

    if (!location.lowcase().eq('head') and !member.lowcase().eq('cwbranheadposcontrol')) then
      -- see if the picked element is on the same branch
      if (!this.task.eq('MODIFY') and !this.pickedElementForHead.eq(!this.cableway.cwbran)) then
        !!alert.error('Picked element is same as current branch')
        return
      else
        !pos    = !this.pickedElementForHead.hpos.wrt(worl)
        handle ANY
          !pos = N0
        endhandle
      endif
    elseif (!location.lowcase().eq('tail') and !member.lowcase().eq('cwbranheadposcontrol')) then
      -- see if the picked element is on the same branch
      if (!this.task.eq('MODIFY') and !this.pickedElementForHead.eq(!this.cableway.cwbran)) then
        !!alert.error('Picked element is same as current branch')
        return
      else
        !pos    = !this.pickedElementForHead.tpos.wrt(worl)
        handle ANY
          !pos = N0
        endhandle
      endif
    elseif (!location.lowcase().eq('head') and !member.lowcase().eq('cwbrantailposcontrol')) then
      -- see if the picked element is on the same branch
      if (!this.task.eq('MODIFY') and !this.pickedElementForTail.eq(!this.cableway.cwbran)) then
        !!alert.error('Picked element is same as current branch')
        return
      else
        !pos    = !this.pickedElementForTail.hpos.wrt(worl)
        handle ANY
          !pos = N0
        endhandle
      endif
    elseif (!location.lowcase().eq('tail') and !member.lowcase().eq('cwbrantailposcontrol')) then
      -- see if the picked element is on the same branch
      if (!this.task.eq('MODIFY') and !this.pickedElementForTail.eq(!this.cableway.cwbran)) then
        !!alert.error('Picked element is same as current branch')
        return
      else
        !pos    = !this.pickedElementForTail.tpos.wrt(worl)
        handle ANY
          !pos = N0
        endhandle
      endif
    endif
    !this.$!<member>.xyz(!pos.east, !pos.north, !pos.up)

  elseif (!type.upcase().eq('RNODE')) then

    if(!this.pickedElementPos.unset())then
      if (!this.wrongPick) then
        !!alert.error('Pick not correct. Please try again')
        !this.wrongPick = FALSE
      endif
      return
    endif

    if (!this.dressed) then
      !!alert.error('Please select a segment which is not dressed')
      !this.dressed  = FALSE
      return
    endif

    if (!this.wrongPick) then
      !!alert.error('Pick not correct. Please try again')
      !this.wrongPick = FALSE
      return
    endif

    -- see if the picked point is on the same branch
    if (!this.task.upcase().eq('MODIFY')) then
      if (!this.pickedPointForRnode.owner.owner.neq(!this.cableway.cwbran)) then
        !!alert.error('Picked element is not on the current branch')
        return
      endif
    endif


    if (!this.pickedPointForRnode.owner.owner.neq(!this.cableway.cwbran)) then
      !confirm = !!alert.confirm('Picked element is not on the current branch. Ok to set the selected branch current?')
      if (!confirm.eq('YES')) then
        !!ce = !this.pickedPointForRnode.owner.owner
        -- Mark Route Points
        !this.markPoint(FALSE)
        !this.setTask('CREATE','RNODE')

      else
        return
      endif
      --!!alert.error('Picked element is not on the current branch')
      --return
    endif
    -- find the point number
    !col = object COLLECTION()
    !col.scope(!this.pickedPointForRnode.owner)
    !col.type('POINTR')
    !number = !col.results().findfirst(!this.pickedPointForRnode)
    !this.rnodePosn.val =  !number
    !this.cableway.pointr  = !this.pickedPointForRnode
    !pos    = !this.pickedElementPos
    !this.rnodeZdis.val = !this.getLength(!this.cableway.pointr.pos.wrt(worl), !pos)
    !this.offsetDistance('RNODE')


  elseif (!type.upcase().eq('RATTA')) then

    if(!this.pickedElementPos.unset())then
      if (!this.wrongPick) then
        !!alert.error('Pick not correct. Please try again')
        !this.wrongPick = FALSE
      endif
      return
    endif
    if (!this.dressed) then
      !!alert.error('Please select a segment which is not dressed')
      !this.dressed  = FALSE
      return
    endif

    if (!this.wrongPick) then
      !!alert.error('Pick not correct. Please try again')
      !this.wrongPick = FALSE
      return
    endif

    -- see if the picked point is on the same branch
    if (!this.pickedPointForRatta.owner.owner.neq(!this.cableway.cwbran)) then
      !!alert.error('Picked element is not on the current branch')
      return
    else
      -- find the point number
      !col = object COLLECTION()
      !col.scope(!this.pickedPointForRatta.owner)
      !col.type('POINTR')
      !number = !col.results().findfirst(!this.pickedPointForRatta)
      !this.rattaPosn.val =  !number
      !this.cableway.pointr  = !this.pickedPointForRatta
      !pos    = !this.pickedElementPos
      !this.rattaZdis.val = !this.getLength(!this.cableway.pointr.pos.wrt(worl), !pos)
      !this.offsetDistance('RATTA')
    endif

  elseif (!type.upcase().eq('CWSEG')) then

    if (!this.$!<location>Opt.val.eq(5)) then
      !this.pickedPointFor$!<location> = !this.pickedElementFor$!<location>.posref
      handle ANY
        return
      endhandle
      !pos = !this.pickedElementFor$!<location>.pos.wrt(worl)
      !this.$!<member>.xyz(!pos.east, !pos.north, !pos.up)
    else
      if(!this.pickedElementPos.unset())then
        if (!this.wrongPick) then
          !!alert.error('Pick not correct. Please try again')
          !this.wrongPick = FALSE
        endif
        return
      endif
      if(!this.pickedPointFor$!<location>.unset())then
        return
      endif
      if (!this.dressed) then
        !!alert.error('Please select a segment which is not dressed')
        !this.dressed  = FALSE
        return
      endif

      if (!this.wrongPick) then
        !!alert.error('Pick not correct. Please try again')
        !this.wrongPick = FALSE
        return
      endif

      if (!member.lowcase().eq('cwbranheadposcontrol')) then

        if (!this.pickedPointForHead.unset()) then
          return
        endif

        -- see if the picked element is on the same branch
        if (!this.task.eq('MODIFY') and !this.pickedPointForHead.owner.owner.eq(!this.cableway.cwbran)) then
          !!alert.error('Picked element is same as current branch')
          return
        else
          --!pos    = !this.pickedPointForHead.pos.wrt(worl)
          !pos    = !this.pickedElementPos
          !this.lengthForHead.val = !this.getLength(!this.cableway.pointr.pos.wrt(worl), !pos)
          !this.lengthForHead.active = true
          !this.thruHead.active      = true
          -- !this.disconnectHead       = TRUE
        endif
      elseif (!member.lowcase().eq('cwbrantailposcontrol')) then

        if (!this.pickedPointForTail.unset()) then
          return
        endif

        -- see if the picked element is on the same branch
        if (!this.task.eq('MODIFY') and !this.pickedPointForTail.owner.owner.eq(!this.cableway.cwbran)) then
          !!alert.error('Picked element is same as current branch')
          return
        else
          --!pos    = !this.pickedPointForTail.pos.wrt(worl)
          !pos    = !this.pickedElementPos
          !this.lengthForTail.val = !this.getLength(!this.cableway.pointr.pos.wrt(worl), !pos)
          !this.lengthForTail.active = true
          !this.thruTail.active      = true
        endif
      endif
      !this.$!<member>.xyz(!pos.east, !pos.north, !pos.up)

    endif
  endif

  --update aids

  if (!member.lowcase().eq('cwbranheadposcontrol')) then
    !this.aid('Head', !this.getPosFromCntrl(!this.cwbranHeadPosControl.xyz()))
  elseif (!member.lowcase().eq('cwbrantailposcontrol')) then
    !this.aid('Tail', !this.getPosFromCntrl(!this.cwbranTailPosControl.xyz()))
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: aid
--
-- Description: Creation of aid text
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aid(!location is STRING , !pos is POSITION)

  !aidPos = !pos
  !aidNumber = 1

  if (!location.upcase().eq('HEAD')) then
    !aidNumber = !this.headAidNumber
    !locString = 'Head'
  elseif (!location.upcase().eq('TAIL')) then
    !aidNumber = !this.tailAidNumber
    !locString = 'Tail'
  elseif (!location.upcase().eq('NEWPOS')) then
    !aidNumberStart = !this.startPosAidNumber
    !aidNumberEnd   = !this.endPosAidNumber
    !locString      = 'New Position'
    aid clear line $!aidNumberStart
    handle (41,6)
    endhandle
    aid clear line $!aidNumberEnd
    handle (41,6)
    endhandle
  elseif (!location.upcase().eq('CONNECTION POS')) then
    !aidNumber = !this.segStartAidNumber
    !locString = 'Connection Position'
  elseif (!location.upcase().eq('ROUTE NODE')) then
    !aidNumber = !this.rnodeAidNumber
    !locString = 'Route Node'
  endif

  aid clear text $!aidNumber
  handle (41,6)
  endhandle

  !loc = '<' & !locString & '>'

  if (!location.upcase().eq('NEWPOS')) then

    if (!this.task.upcase().eq('CREATE')) then
      !firstPos  = !!ce.position.wrt(worl)
      nex
      handle ANY
        return
      endhandle
      !lastPos   = !!ce.position.wrt(worl)
      pre
    else
      pre
      handle ANY
        !firstPos = !aidPos
        nex
        handle ANY
          !lastPos = !aidPos
        elsehandle NONE
          !lastPos   = !!ce.position.wrt(worl)
          pre
        endhandle
      elsehandle NONE
        !firstPos  = !!ce.position.wrt(worl)
        nex
        nex
        handle ANY
          !lastPos = !aidPos
        elsehandle NONE

          !lastPos   = !!ce.position.wrt(worl)
          pre
        endhandle
      endhandle

    endif

    AID LINE NUMBER $!aidNumberStart $!firstPos to $!aidPos  linestyle dashdot
    AID LINE NUMBER $!aidNumberEnd   $!aidPos   to $!lastPos linestyle dashdot
  else
    AID TEXT NUMBER $!aidNumber |$!loc| at $!aidPos
    -- draw branch
    if (!this.task.upcase().eq('CREATE')) then
      !this.drawBranch()
    endif
  endif

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: drawBranch
--
-- Description: Draw the branch using aid lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawBranch()

  -- clear the aids
  aid clear all $!this.branchAidNumber
  handle ANY
  endhandle

  -- get the head and tail positions
  !headPosition = !this.getPosFromCntrl(!this.cwbranHeadPosControl.xyz())
  !tailPosition = !this.getPosFromCntrl(!this.cwbranTailPosControl.xyz())

  --aid number
  !aidNumber = !this.branchAidNumber

  -- get the orthogonal points
  !manager = object CABLEMANAGER()
  !points = !manager.createOrthogonalRoute(!headPosition,!tailPosition, !this.orthoOpt.selection())
  !size = !points.size()
  -- draw the line
  if (!this.ortho.val) then
    !this.orthoOpt.active = TRUE
    do !i from 1 to (!size - 1)
      !first   = !points[!i]
      !second  = !points[!i + 1]
      AID LINE NUMBER $!aidNumber  $!first  to $!second linestyle dashdot
    enddo
    -- see if the branch can be drawn properly with the given route
    if (!this.checkDirection().not()) then
      !!alert.warning('Check the tray open direction with respect to the orthogonal direction sequence. The branch will not be drawn correctly.')
    endif
  else
    !this.orthoOpt.active = FALSE
    AID LINE NUMBER $!aidNumber  $!headPosition  to $!tailPosition linestyle dashdot
  endif


endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: clearAids
--
-- Description: Creation of aid text and lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAids()

  aid clear text $!this.headAidNumber
  handle ANY
  endhandle
  aid clear text $!this.tailAidNumber
  handle ANY
  endhandle
  aid clear line $!this.startPosAidNumber
  handle ANY
  endhandle
  aid clear line $!this.endPosAidNumber
  handle ANY
  endhandle
  aid clear text $!this.segStartAidNumber
  handle ANY
  endhandle
  aid clear all $!this.rnodeAidNumber
  handle ANY
  endhandle
  aid clear all $!this.rattaAidNumber
  handle ANY
  endhandle
  aid clear all $!this.branchAidNumber
  handle ANY
  endhandle

endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: Dismiss
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.clearAids()
  !this.markPoint(FALSE)
  axes off

  !this.hide()

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: autoNameCe
--
-- Description: Autonaming elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------


define method .autoNameCe(!type is STRING)

  if (!type.eq('CWAY')) then
    if (!this.cableway.zone.unset()) then
      !this.cableway.zone = zone
    endif
    !this.cwayName.val = !!cblautoname(!type, !this.cableway.zone)
  elseif (!type.eq('CWBRAN')) then
    if (!this.cableway.cway.unset()) then
      !this.cableway.cway = CWAY
    endif
    !this.cwbranName.val = !!cblautoname(!type, !this.cableway.cway)

  elseif (!type.eq('RNODE')) then
    if (!this.cableway.cwbran.unset()) then
      !this.cableway.cwbran = CWBRAN
    endif
    !this.rnodeName.val = !!cblautoname(!type, !this.cableway.cwbran)
  endif


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: posCntrl
--
-- Description: Initialise Position Control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------


define method .posCntrl(!container is STRING, !posControl is STRING)

  -- Declare namespace where position control exists
  --using namespace 'PositionControl'
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.$!<posControl>        = object POSITIONCONTROL()



  -- Load ship grid data
  !grid                   = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xoffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yoffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zoffset[!i]
    enddo

    -- Set grid data
    !this.$!<posControl>.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialize as grid control and Specify tags
    --!this.$!<posControl>.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.$!<posControl>.heading('World Position')

  else
    !this.$!<posControl>.gridvisible(FALSE)

  endif

  var !coordinate coordinate
  if(!grid.xID.set() and (!coordinate.eq('XYZ'))) then
    !this.$!<posControl>.gridFormat()
  elseif(!coordinate.eq('XYZ')) then
    !this.$!<posControl>.xyzFormat()
  else
    !this.$!<posControl>.enuformat()
  endif

  if (!posControl.lowcase().eq('pointrposcontrol')) then
    !this.pointrPosControl.changeAction('!!cblCway.setLengthAndDirection(|Gadget|)')
  endif

  if (!posControl.lowcase().eq('cwbranheadposcontrol')) then
    !this.cwbranHeadPosControl.changeAction('!!cblCway.aid(|Head|, !!cblCway.getPosFromCntrl(!!cblCway.cwbranHeadPosControl.xyz()))')
  endif

  if (!posControl.lowcase().eq('cwbrantailposcontrol')) then
    !this.cwbranTailPosControl.changeAction('!!cblCway.aid(|Tail|, !!cblCway.getPosFromCntrl(!!cblCway.cwbranTailPosControl.xyz()))')
  endif

  -- Add PMLNet control to PML frame
  !this.$!<container>.control  = !this.$!<posControl>.handle()


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: pointrAction
--
-- Description: Actions performed upon selecting
-- POINTR from form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointrAction()
  !this.cableway.pointr = !this.pointrTable.selection().dbref()
  !!ce         = !this.cableway.pointr
  !this .cableway.activeElement = !!ce
  !this.pointrCeTag.val       =  'Current Element     : ' & !this.cableway.activeElement.flnn
  !this.pointrPosControl.xyz(!!ce.position.wrt(worl).east, !!ce.position.wrt(worl).north, !!ce.position.wrt(worl).up)
  !this.setLengthAndDirection('Normal')
  !this.fradius.val  = !this.cableway.activeElement.fradius
  axes at $!this.cableway.pointr

  --if !this.task.upcase().eq('MODIFY') then
  --  if !this.cableway.pointr.tysequence.eq(!this.cableway.pointr.owner.members.size()) then
  --    !!alert.error('Use modify branch option to modify the last point')
  --  elseif !this.cableway.pointr.tysequence.eq(1) then
  --    !!alert.error('Use modify branch option to modify the first point')
  --  endif
  --endif

  if (!this.task.upcase().eq('MODIFY')) then
    if (!this.cableway.pointr.tysequence.eq(1)) then
      !this.length.val = 0
    endif
  endif

  if (!this.task.upcase().eq('CREATE')) then
    if (!this.cableway.pointr.sequence.eq(!this.cableway.pointr.owner.members.size())) then
      !!alert.warning('Do not explicitly create points after the last point')
    endif
  endif

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: setLengthAndDirection
--
-- Description: Sets Length and direction Gadgets
-- POINTR from form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setLengthAndDirection(!type is STRING)

  !line  = object LINE()

  !!ce  = !this.cableway.pointr
  if (!type.upcase().eq('GADGET')) then
    !line.endposition = !this.getPosFromCntrl(!this.pointrPosControl.xyz())
  else
    !line.endposition = !!ce.position.wrt(worl)
  endif


  if (!this.cableway.pointr.tysequence.neq(1)) then
    pre
    !line.startposition = !!ce.position.wrt(worl)
    nex
  else
    !line.startposition = !!ce.position.wrt(worl)
  endif

  if (!type.upcase().eq('GADGET') and !this.task.upcase().eq('CREATE')) then
    !line.startposition = !!ce.position.wrt(worl)
  endif

  !this.direction.val         = !line.direction()

  handle (2,785)
    --First member
    nex
    handle ANY
      !this.direction.val         = U wrt /*
    elsehandle NONE
      !line.endposition = !!ce.position.wrt(worl)
      pre
      !this.direction.val         = !line.direction()
      handle ANY
        !this.direction.val         = U wrt /*
      endhandle
    endhandle
  endhandle


  --load Length

  if (!type.upcase().eq('GADGET') and !this.task.upcase().eq('CREATE')) then
    !this.length.val            = !line.length()
  elseif (!this.task.upcase().eq('CREATE')) then
    !this.length.val            = 0
  elseif (!this.task.upcase().eq('MODIFY')) then
    !this.length.val            = !line.length()
  endif
  !this.aid('NewPos', !this.getPosFromCntrl(!this.pointrPosControl.xyz()))

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: setPointrPositionGadget
--
-- Description: Sets POINTR position Gadgets
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPointrPositionGadget()

  !!ce  = !this.cableway.pointr

  if (!this.task.upcase().eq('MODIFY')) then

    if (!this.cableway.pointr.tysequence.eq(1)) then
      !startPos = !!ce.owner.owner.hposition.wrt(worl)
      handle ANY
        !startPos = object POSITION('E0')
      endhandle
    else
      !startPos = position of prev wrt /*
    endif

  elseif (!this.task.upcase().eq('CREATE')) then
    !startPos = !!ce.position.wrt(worl)
  endif

  !endPos = !startPos.offset(!this.direction.val, !this.length.val)
  !this.pointrPosControl.xyz(!endPos.east, !endPos.north, !endPos.up)
  !this.aid('NewPos', !this.getPosFromCntrl(!this.pointrPosControl.xyz()))


endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: getPosFromCntrl
--
-- Description: Converts array from position control to position
--              Position control returns position in mm
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPosFromCntrl(!pos is ARRAY) is POSITION

  !mmEast         = !pos[0]
  !mmNorth        = !pos[1]
  !mmUp           = !pos[2]

  !position       = object POSITION('E0 N0 U0')
  !position.east  = !mmEast.currentUnits(!!distanceFmt.units)
  !position.north = !mmNorth.currentUnits(!!distanceFmt.units)
  !position.up    = !mmUp.currentUnits(!!distanceFmt.units)

  return !position

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: discard
--
-- Description: Discard Changes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discard()

  !pointrStatus = !this.markPointPointrFrame.val
  !!ce =  !this.cableway.activeElement
  !this.currentElement()
  !this.markPoint(!pointrStatus)
endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: offsetDistance
--
-- Description: Distance from start of segment for offset
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetDistance(!pos is STRING) is BOOLEAN

  -- reference item

  if (!pos.upcase().eq('RNODE')) then
    !num                   = !this.rnodePosn.val
    !this.cableway.pointr  = POINTR $!num of RPATH 1 of $!this.cableway.cwbran
    !refItem               = !this.cableway.pointr
    if (!this.rnodePkdis.val.gt(1) or !this.rnodePkdis.val.lt(0)) then
      !!alert.error('Please input a value between 0 and 1')
      return FALSE
    endif
  elseif (!pos.upcase().eq('RATTA')) then
    !num                   = !this.rattaPosn.val
    !this.cableway.pointr  = POINTR $!num of RPATH 1 of $!this.cableway.cwbran
    !refItem               = !this.cableway.pointr
    if (!this.rattaPkdis.val.gt(1) or !this.rattaPkdis.val.lt(0)) then
      !!alert.error('Please input a value between 0 and 1')
      return FALSE
    endif
  else
    !refItem = !this.pickedPointFor$!<pos>
    if (!this.task.upcase().eq('MODIFY') and !pos.upcase().eq('RNODE')) then
      !refItem  = !!ce.posref
    endif
    if (!this.task.upcase().eq('MODIFY') and !pos.upcase().eq('RATTA')) then
      !refItem  = !!ce.posref
    endif
  endif

  -- find the position of next POINTR
  !ce = !!ce
  !!ce  = !refItem
  next POINTR
  handle (2,113)
    pre POINTR
  endhandle
  !refItemNext = !!ce
  !!ce = !ce

  -- draw a line to get the direction
  !line = object LINE()
  !line.startposition = !refItem.pos.wrt(worl)
  !line.endposition   = !refItemNext.position.wrt(worl)
  if (!line.length().eq(0)) then
    !!alert.error('The selected reference point and next reference point are in the same position, system cannot position element between those points.')
    return FALSE
  endif
  !bendDistance = !refItem.pos.distance(!refItem.fend)
  !endBendDistance = !refItemNext.pos.distance(!refItemNext.fend)

  !line = !line.extendStart( - !bendDistance)
  !line = !line.extendEnd( - !endBendDistance)
  !newPosition = object POSITION('E0 N0 U0')
  if (!pos.upcase().eq(|RNODE|)) then
    !pkdis  = !line.length() * !this.rnodePkdis.val
    !offset = (!pkdis + !this.rnodeZdis.val)
    !newPosition = !line.startposition.offset(!line.direction(),!offset)
  elseif (!pos.upcase().eq(|RATTA|)) then
    !pkdis  = !line.length() * !this.rattaPkdis.val
    !offset = (!pkdis + !this.rattaZdis.val)
    !newPosition = !line.startposition.offset(!line.direction(),!offset)
  else
    !newPosition = !line.startposition.offset(!line.direction(),!this.lengthFor$!<pos>.val)
  endif

  --populate the gadgets and draw aids
  if (!pos.upcase().eq('CONN')) then
    !this.aid(|Connection Pos| , !newPosition )
    !this.pkdis  = !this.lengthForconn.val / !line.length()

  elseif (!pos.upcase().eq('RNODE')) then
    -- get the positions
    --    !up       = !newPosition.wrt(worl).up
    --    !north    = !newPosition.wrt(worl).north
    --    !east     = !newPosition.wrt(worl).east

    -- add offsets
    !rnodePos       = !newPosition.wrt(worl)
    !ydir   = !this.cableway.pointr.pdir[2].wrt(worl).string()
    !zdir   = !this.cableway.pointr.lyDir.wrt(worl).string()

    !orientationRnode = object ORIENTATION('Y is $!ydir AND Z is $!zdir')
    handle ANY
      !orientationRnode = object ORIENTATION('Y is N')
    endhandle
    !rnodePos = !rnodePos.offset(!orientationRnode.zdir(),!this.rnodeZoff.val )
    !rnodePos = !rnodePos.offset(!orientationRnode.ydir(),!this.rnodeYoff.val )
    !rnodePos = !rnodePos.offset(!orientationRnode.xdir(),!this.rnodeXoff.val )

    !this.rnodeBox.box.position = !rnodePos
    !this.rnodeBox.box.orientation  = !orientationRnode
    !this.rnodeBox.draw(!this.rnodeAidNumber)

  elseif (!pos.upcase().eq('RATTA')) then
    !this.rattaSphere.position = !newPosition
    !this.rattaSphere.draw(!this.rattaAidNumber)
  else
    !this.cwbran$!<pos>PosControl.xyz(!newPosition.east, !newPosition.north, !newPosition.up)
    !this.aid(!pos, !this.getPosFromCntrl(!this.cwbran$!<pos>PosControl.xyz()))
  endif

  if (!pos.upcase().eq('RATTA') or !pos.upcase().eq('RNODE')) then
    if (!offset.gt(!line.length()) or !offset.lt(0) ) then
      !!alert.error('Entered zdis lies outside segment length.')
      return FALSE
    endif

  endif
  return TRUE

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: getLength
--
-- Description: Calculates the length between two positions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getLength(!first is POSITION, !second is POSITION) is REAL

  !line = object LINE()
  !line.startposition = !first
  !line.endposition   = !second

  return !line.length()

endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method: back
--
-- Description: Method for changing the ce on applying back button
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .back(!element is STRING)

  !!ce = !this.cableway.activeElement
  handle (2,822)
  endhandle
  if (!element.upcase().neq('CWBRANTASKS')) then
    $!element
  else
    CWBRAN
    --remove aids
    !this.clearAids()
  endif
  !this.setTask('MODIFY',!element)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: disconnect
--
-- Description: Disconnect Branch head and tail
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .disconnect(!option is STRING)

  !bran  = !this.cableway.cwbran.namn
  if (!option eq 'BOTH' or !option eq 'HEAD') then
    if (!this.cableway.cwbran.hdconn.set()) then
      !answer = !!alert.question('Do you want to disconnect head of $!bran')
      if (!answer.eq('YES')) then
        !this.cableway.disconnect('HEAD')
        !this.disconnectHead.active = FALSE
      endif
    endif
  endif

  if (!option eq 'BOTH' or !option eq 'TAIL') then
    if (!this.cableway.cwbran.tlconn.set()) then
      !answer = !!alert.question('Do you want to disconnect tail of $!bran')
      if (!answer.eq('YES')) then
        !this.cableway.disconnect('TAIL')
        !this.disconnectTail.active = FALSE
      endif
    endif
  endif
  !this.setActiveElement()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: goForDress
--
-- Description: show the dressing form
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .goForDress()

  -- see if the branch has CTMTRL existing
  !!ce = !this.cableway.cwbran
  !exist  = MEM CTMTRL

  if (!exist.set()) then
    !!ce = !exist[1]
    !!cblinit('Modify','CTMTRL','!!cblmtrl')
  else
    !!cblinit('Create','CTMTRL','!!cblmtrl')
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: align
--
-- Description: align with element
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .align(!pos is STRING)

  !packet = object EDGPACKET()
  !packet.action      = '!!cblCway.pickedPosForAlign = !this.return[1].position.wrt(worl)'
  !packet.defineposition('Pick to define position')
  !packet.priority    = 2
  !packet.remove      = TRUE
  !packet.continue = '!!cblCway.distance(|$!pos|)'
  !!edgCntrl.add(!packet)


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: distance
--
-- Description: calculates the distance of RATTA position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distance(!pos is STRING)

  if(!this.pickedPosForAlign.unset())then
    return
  endif

  -- find the position of next POINTR
  !ce = !!ce
  !!ce  = !this.cableway.pointr
  !pointr1 = !!ce
  next POINTR
  !pointr2 = !!ce
  !!ce = !ce

  -- create a line of the current segment
  !line  = object LINE()
  !line.startposition = !pointr1.position.wrt(worl)
  !line.endposition   = !pointr2.position.wrt(worl)

  -- deduct the possible fillet radius
  !bendDistance = !pointr1.pos.distance(!pointr1.fend)
  !endBendDistance = !pointr2.pos.distance(!pointr2.fend)
  !line = !line.extendStart( - !bendDistance)
  !line = !line.extendEnd( - !endBendDistance)

  if (!line.onprojected(!this.pickedPosForAlign).not()) then
    !!alert.error('The picked element does not lie within the current segment')
    return
  endif

  -- calculate the distance along the segment to the projected picked point
  !distance = !line.startposition.distance(!line.near(!this.pickedPosForAlign))

  if (!pos.upcase().eq('HEAD') or !pos.upcase().eq('TAIL')) then
    !this.lengthFor$!<pos>.val = !distance
  else
    !this.$!<pos>Zdis.val = !distance
  endif
  !this.offsetDistance(!pos)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: copyPosValues
--
-- Description: copies the values between position gadgets
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPosValues(!first is STRING, !second is STRING)

  --Branch head tail gadgets
  if (!first.upcase().eq('HEAD') or !first.upcase().eq('TAIL')) then
    !posVal = !this.cwbran$!<first>PosControl.xyz()
    !newPos = !this.getPosFromCntrl(!posVal)
    !this.cwbran$!<second>PosControl.xyz(!newPos.east, !newPos.north, !newPos.up)
    !this.aid('$!<second>', !this.getPosFromCntrl(!this.cwbran$!<second>PosControl.xyz()))
  endif

  if (!first.upcase().eq('POINTR')) then
    if (!second.upcase().eq('PREV')) then
      !ce = !!ce
      PREV
      handle ANY
        !!alert.error('The current point is the first point. Cannot pick previous point')
        return
      endhandle
      !newPos = !!ce.pos.wrt(worl)
      !!ce = !ce
      !this.pointrPosControl.xyz(!newPos.east, !newPos.north, !newPos.up)
    elseif (!second.upcase().eq('NEXT')) then
      !ce = !!ce
      next POINTR
      handle ANY
        !!alert.error('The current point is the last point. Cannot pick next point')
        return
      endhandle
      !newPos = !!ce.pos.wrt(worl)
      !!ce = !ce
      !this.pointrPosControl.xyz(!newPos.east, !newPos.north, !newPos.up)
    endif
    !this.setLengthAndDirection(|Gadget|)
  endif


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: validateRule
--
-- Description: Validates the rllo syntax
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateRule()

  if (!this.cwbranRllogical.val.substring(1,1).neq(|(|)) then
    !!alert.warning(|Enclose the rule in a parenthesis ('')|)
    !this.cwbranRllogical.val = |('')|
    return
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: validateConnRef
--
-- Description: Validates the connection reference for RNODE
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateConnRef()

  !connRef = object DBREF(!this.rnodeCref.val)
  handle ANY
    -- add a '/' and see
    !conn = '/' & !this.rnodeCref.val
    !connRef = object DBREF(!conn)
    handle ANY
      !!alert.error('The entered value for connection reference is not correct')
      return
    endhandle
  endhandle

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: validateBendRadius
--
-- Description: Validates the bend radius for CWBRAN
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateBendRadius(!gadget is GADGET, !action is STRING)
  !!gdgtDatChk(!gadget)
  if (!action.eq('SELECT')) then
    !bradius       = !this.brad.val
    !halfTrayWidth = !this.cwbranVWidth.val / 2

    if (!bradius.neq(0)) then
      if (!bradius.lt(!halfTrayWidth)) then
        !!alert.error('Bend Radius should be greater than or equal to half of branch volume width')
        if (!gadget.eq(!this.brad)) then
          !this.brad.val = 0
        else
          !this.cwbranVWidth.val = !this.brad.val * 2
        endif
        return
      endif
    endif
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: removes the selected tier
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode(!task is STRING, !type is STRING)

  if (!task.upcase().eq('MODIFY')) then
    if (!!ce.type.neq(!type.upcase())) then
      !!ce = !this.cableway.$!<type>
      handle ANY
        !!alert.error('Cannot navigate to $!type')
        return
      endhandle
    endif
    !this.setTask(!task,!type)
  else
    !!cblinit(!task.upcase(),!type.upcase(),'!!cblCway')
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      pickCnode
--
-- Description: picks CNODES from form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickCnode()

  if(!!cblselectcnode.dataGrid.getrows().empty())then
    !!alert.warning('No Control Node is available.')
  else
    !this.rnodeCref.val = !!cblselectcnode.dataGrid.getselectedrows()[1][1]
  endif

  !!cblselectcnode.hide()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      offsetActivate
--
-- Description: activates the offset gadgets on route node task
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetActivate(!gadget is GADGET, !action is STRING)

  if (!action.eq('SELECT')) then
    if (!gadget.rtext[!gadget.val].eq('OFFS')) then
      !this.rnodeXoff.active = TRUE
      !this.rnodeZoff.active = TRUE
    else
      !this.rnodeXoff.active = FALSE
      !this.rnodeZoff.active = FALSE
    endif
    if (!gadget.rtext[!gadget.val].eq('GAP') or !gadget.rtext[!gadget.val].eq('PENE')) then
      !this.rnodeYoff.active = TRUE
    else
      !this.rnodeYoff.active = FALSE
    endif
  endif


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      checkConnections
--
-- Description: checks the connection for a branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkConnections(!branch is DBREF)

  !!ce = !branch
  show !!cblconnections

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      reorderRnodes
--
-- Description: reorders and puts the RNODEs in the correct position in hierarchy
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reorderRnodes(!rnode is DBREF)

  !preRnode = object DBREF()
  !posref = !rnode.posref

  --segment length
  !!ce = !posref
  !spos = !!ce.position.wrt(world)
  next
  handle ANY
    !!ce = !posref
  endhandle
  !lpos = !!ce.position.wrt(world)
  pre
  !line = object LINE(!spos, !lpos)
  !segmentLength = !line.length()

  -- get the actual distance along segment
  !actDistance = (!rnode.pkdis * !segmentLength) + !rnode.zdis

  -- get the last RNODE of current POINTR
  !list = !posref.rnodel.xxx
  -- remove current route node from this list
  !index = !list.findfirst(!rnode)
  !list[!index].delete()

  if (!list.set()) then
    -- get RNODE with zdis less than current route node
    !rnList = object ARRAY()
    do !route values !list
      -- get the actual zdis considering pkdis
      !preZdis = (!route.pkdis * !segmentLength) + !route.zdis
      if (!actDistance.geq(!preZdis)) then
        !rnList.append(!route)
      endif
    enddo

    if (!rnList.set()) then
      !preRnode = !rnList[1]
      !preZdis = (!preRnode.pkdis * !segmentLength) + !preRnode.zdis
      do !rnval values !rnList
        !actZdis = (!rnval.pkdis * !segmentLength) + !rnval.zdis
        if (!actZdis.gt(!preZdis)) then
          !preRnode = !rnval
        endif
      enddo
    else
      --get the last referred route node of previous point
      if (!posref.tysequence.neq(1)) then
        !points = !posref.owner.members
        do !i from 1 to (!posref.tysequence - 1)
          !node = !points[!i].rnodel.xxx
          if (!node.set()) then
            !preRnode = !node[1]
            !actZdis = (!node[1].pkdis * !segmentLength) + !node[1].zdis
            -- find the RNODE with largest ZDIS
            do !value values !node
              !actDis = (!value.pkdis * !segmentLength) + !value.zdis
              if (!actDis.gt(!actZdis)) then
                !preRnode = !value
              endif
            enddo
          endif
        enddo
      endif
    endif


  else
    --get the last referred route node of previous point
    if (!posref.tysequence.neq(1)) then
      !points = !posref.owner.members
      do !i from 1 to (!posref.tysequence - 1)
        !node = !points[!i].rnodel.xxx
        if (!node.set()) then
          !preRnode = !node[1]
          !actZdis = (!node[1].pkdis * !segmentLength) + !node[1].zdis
          -- find the RNODE with largest ZDIS
          do !value values !node
            !actDis = (!value.pkdis * !segmentLength) + !value.zdis
            if (!actDis.gt(!actZdis)) then
              !preRnode = !value
            endif
          enddo
        endif
      enddo
    endif

  endif

  -- reorder
  if (!preRnode.set()) then
    !!ce = !rnode.owner
    reorder $!rnode after $!preRnode
  endif

  !!ce = !rnode

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      chooseRnodeSpec
--
-- Description: show the choose form for route node specification
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chooseRnodeSpec()

  if(!this.tableChooseData.getSelTabs().empty()) then
    !!alert.warning('Cable route node specification not found in this project')
    return
  endif

  if !!stChooseData.purpose.neq('REPR') then
    -- reload route node data to global choose data object
    !!stChooseData = !this.tableChooseData
  endif

  show !!stChoose
  -- change callback
  !!stChoose.disableLocalEdit()
  !!stChoose.bnApply.callback = '!!cblCway.setRnodeSpec()'

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      setRnodeSpec
--
-- Description: sets the route node specification
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRnodeSpec()

  !spec = !!stChoose.getSelection()
  if( !spec.set() ) then
    !this.rnodeSpref.val = !spec.namn
  endif
  !!stChoose.hide()

endmethod
--End of method definition
-----------------------------------------------------------------------
--
-- Method:      moveZdis
--
-- Description: sets the zdistance incremental value
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveZdis(!action is STRING, !gadget is GADGET)
  if (!gadget.eq(!this.rnodeZdis)) then
    !input = !this.rnodeMoveValue.val
  elseif (!gadget.eq(!this.rattaZdis)) then
    !input = !this.rattaMoveValue.val
  endif
  !currentValue = !gadget.val

  if (!action.upcase().eq('DECREASE')) then
    !newValue = !currentValue - !input
  else
    !newValue = !currentValue + !input
  endif

  !gadget.val = !newValue

  if (!gadget.eq(!this.rnodeZdis)) then
    !this.offsetDistance('RNODE')
  elseif (!gadget.eq(!this.rattaZdis)) then
    !this.offsetDistance('RATTA')
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: switchMode
--
-- Description: switches to back or forward mode
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .switchMode()

  if (!this.backwardMode.val) then
    BACKWARDS
  else
    FORWARDS
  endif
  !this.setTask(!this.task.upcase(), 'POINTR')

  -- re-draw any labels for pointr's that may be drawn
  !drawnState = !this.markPointPointrFrame.val
  !this.markPoint(False)
  !this.markPoint(!drawnState)

endmethod

------------------------------------------------------------------------
--
-- Method: markPoint
--
-- Description: marks the route points
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .markPoint(!show is BOOLEAN)

  if (!this.cableway.cwbran.unset()) then
    return
  endif

  -- collect points
  !col = object COLLECTION()
  !col.scope(!this.cableway.cwbran)
  !col.type('POINTR')
  !points = !col.results()

  -- mark or unmark points
  do !point values !points
    if (!show) then
      mark $!point
    else
      unmark $!point
    endif
  enddo

  -- set the gadget toggles
  !this.markPointPointrFrame.val  = !show
  !this.markPointRnodeFrame.val   = !show
  !this.markPointRattaFrame.val   = !show
  !this.markPointCwbranFrame.val  = !show


endmethod

------------------------------------------------------------------------
--
-- Method: .showCblListCables
--
-- Description: Show cblListCables form
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCblListCables()


  if(undefined(!!cblListCables))then
    pml load form !!cblListCables
  endif

  !element = !this.cableway.activeElement
  !!cblListCables.show(!element)

endmethod
------------------------------------------------------------------------
--
-- Method: loadIclass
--
-- Description: loads the interference class from cable property db
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadIclass()

  var !cabd collect all CABD
  !interference = object ARRAY()
  do !cable values !cabd
    !interference.append(!cable.dbref().dinterference)
  enddo
  !interference.unique()

  -- load values to member
  do !inter values !interference
    !this.dinter.append(!inter)
  enddo
  !this.dinter.unique()

  !selection = !this.cwbranIclass.selection()
  !this.cwbranIclass.dtext = !this.dinter

  -- display original selection
  if (!selection.neq('')) then
    !this.cwbranIclass.select('DTEXT', !selection)
    handle ANY
    endhandle
  endif

  -- message
  if (!interference.set()) then
    !this.iclassLoad.tag = 'Reload'
    !!alert.message('Interference class from properties database loaded')
  else
    !!alert.message('No Interference class available in properties database')
  endif


endmethod

------------------------------------------------------------------------
--
-- Method: addIclass
--
-- Description: adds the user interference class to gadget
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addIclass(!gadget is GADGET, !action is STRING)

  if (!action.eq('VALIDATE')) then

    !newInter = !gadget.displayText()
    --add the value
    !values = !gadget.dtext
    if (!values.findfirst(!newInter).set().not()) then
      !gadget.add(!newInter)
      !this.dinter.append(!newInter)
    endif

    -- be at the new input value
    !gadget.select('DTEXT', !newInter)
    handle ANY
    endhandle
  endif

  -- change the rule gadget
  if (!action.eq('VALIDATE') or !action.eq('SELECT')) then
    !inter = !gadget.selection()
    if (!inter.neq('unset')) then
      !this.cwbranRllogical.val = |(ICLASS EQ '$!inter')|
    else
      !this.cwbranRllogical.val = |('')|
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: checkDirection
--
-- Description: checks the YDIR of rpath with respect to gadget values
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkDirection() is BOOLEAN

  -- tray open direction
  !openDirection = !this.rpathYdir.val.wrt(worl)

  -- coordinate
  var !coordinate coordinate

  -- orthogonal option direction
  if (!this.orthoOpt.val.eq(1) or !this.orthoOpt.val.eq(2)) then
    if (!coordinate.eq('ENU')) then
      !checkDirection = object DIRECTION('E')
    else
      !checkDirection = object DIRECTION('X')
    endif
  elseif (!this.orthoOpt.val.eq(3) or !this.orthoOpt.val.eq(4)) then
    if (!coordinate.eq('ENU')) then
      !checkDirection = object DIRECTION('N')
    else
      !checkDirection = object DIRECTION('Y')
    endif
  elseif (!this.orthoOpt.val.eq(5) or !this.orthoOpt.val.eq(6)) then
    if (!coordinate.eq('ENU')) then
      !checkDirection = object DIRECTION('U')
    else
      !checkDirection = object DIRECTION('Z')
    endif
  endif

  -- check
  if (!openDirection.eq(!checkDirection) or !openDirection.opposite().eq(!checkDirection)) then
    return FALSE
  else
    return TRUE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      removeIclass
--
-- Description: removes the selected iclass
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeIclass(!gadget is GADGET)

  !iclass = !gadget.displayText().trim()
  if (!gadget.selection().eq('unset')) then
    !!alert.error('Cannot remove the unset value')
    return
  else
    !gadget.clear(!iclass)
    !this.updateFrame()
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      updateFrame
--
-- Description: removes the selected iclass
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFrame()

  if (!this.cwbranRllogicalTag.val) then
    !this.cwbranRllogical.active = TRUE
    !this.cwbranIclass.active    = FALSE
    !this.iclassLoad.active      = FALSE
  else
    !this.cwbranRllogical.active = FALSE
    !this.cwbranIclass.active    = TRUE
    !this.iclassLoad.active      = true
    !this.addIclass(!this.cwbranIclass, |SELECT|)
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      validateEntry
--
-- Description: Set unset gadget values to zero
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Attribute gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateEntry(!gadget is GADGET, !action is STRING)

  -- Check for unset values and
  if (!gadget.val.unset()) then
    !gadget.val = 0
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      validMaxFill
--
-- Description: Validate input to maximum fill gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    RW     GADGET     Gadget being updated
--    2    R      STRING     Action fired by the gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validMaxFill(!gadget is GADGET, !action is STRING)

  !value = !gadget.val

  if(!value.unset()) then
    return error 1 'Maximum Fill Level must contain a value.'
  endif

  !unitsExist = !value.units().string().neq('')

  if(!value.gt(100)) then
    if(!unitsExist.not()) then
      return error 2 'Maximum Fill Level cannot be greater than one hundred percent.'
    endif
  endif

  if(!unitsExist) then
    return error 3 'Invalid value. Make sure input value does not include units.'
  endif

  if (!value.lt(!this.cableway.activeElement.fLevel)) then
    !!alert.warning('Maximum Fill Level is less than Current Fill Level')
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getCurrentFillLevel()
--
-- Description: Get current cway branch fill level and return on form para gadget for user.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCurrentFillLevel()

  !fill = !this.cableway.cwbran.fLevel

  !level = !fill.string(!!realFmt)
  !this.cwbranCurrentFill.val = !level

  return

endmethod
------------------------------------------------------------------------
