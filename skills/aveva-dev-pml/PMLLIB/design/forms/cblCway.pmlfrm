------------------------------------------------------------------------
--
-- Method: pointrGadgets
--
-- Description: Sets the gadgets required to create
-- POINTR elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointrGadgets(!formTask is STRING)

  -- clear aids
  !this.clearAids()
  !this.pointrOwnElement.val      =  'Cableway Branch : ' & !this.cableway.cwbran.flnn
  !this.pointrCeTag.val           =  'Current Element     : ' & !this.cableway.activeElement.flnn

  if (!formTask eq 'CREATE') then
    !this.createPointrApply.visible       = TRUE
    !this.modifyPointrApply.visible       = FALSE
    !this.discardPointrApply.visible      = FALSE
    !this.createPointrIcon.visible        = TRUE
    !this.modifyPointrIcon.visible        = FALSE
    !this.discardPointrIcon.visible       = FALSE
    !this.pointrCurrElement.visible       = FALSE
    !this.pointrMode.val  =  1

  elseif (!formTask eq 'MODIFY') then
    !this.createPointrApply.visible       = FALSE
    !this.modifyPointrApply.visible       = TRUE
    !this.discardPointrApply.visible      = TRUE
    !this.createPointrIcon.visible        = FALSE
    !this.modifyPointrIcon.visible        = TRUE
    !this.discardPointrIcon.visible       = TRUE
    !this.pointrCurrElement.visible       = TRUE
    !this.pointrMode.val  =  2

  endif

  var !mode mode
  if (!mode.upcase().eq('FORWARDS')) then
    !this.backwardMode.val = FALSE
  else
    !this.backwardMode.val = TRUE
  endif


endmethod
--End of method definition

