--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cblMarkRouteNodes()              -
--  dataGridOnPopup(ARRAY)           -
--  dismiss()                        -
--  forEachRow(ARRAY,STRING)         -
--  initialise()                     -
--  loadGrid(DBREF)                  -
--  markAllRows()                    -
--  markRow(STRING)                  -
--  markSelectedRows()               -
--  onDataGridSelectChange(ARRAY)    -
--  onMarkAllRows()                  -
--  onMarkSelectedRows()             -
--  onUnmarkAllRows()                -
--  onUnmarkSelectedRows()           -
--  setButtons()                     -
--  setData(REAL)                    -
--  unMarkRow(STRING)                -
--  unmarkAllRows()                  -
--  unmarkSelectedRows()             -
--



--  cblMarkRouteNodes()              -
--  dataGridOnPopup(ARRAY)           -
--  dismiss()                        -
--  forEachRow(ARRAY,STRING)         -                   Function iterates through array of rows, and calls method specified in a string passing row name.
--  initialise()                     -
--  loadGrid(DBREF)                  -
--  markAllRows()                    -                   Mark all rows that are present in the grid
--  markRow(STRING)                  -
--  markSelectedRows()               -                   Mark rows that are currently selected in the grid
--  onDataGridSelectChange(ARRAY)    -
--  onMarkAllRows()                  -                   Callback function for the Mark All button.
--  onMarkSelectedRows()             -                   Callback function for the Mark Selected button.
--  onUnmarkAllRows()                -                   Callback function for the Unmark All button.
--  onUnmarkSelectedRows()           -                   Callback function for the Unmark Selected button.
--  setButtons()                     -                   Set the buttons on the form to be enabled/disabled where appropriate
--  setData(REAL)                    -
--  unMarkRow(STRING)                -
--  unmarkAllRows()                  -                   Unmark all rows that are present in the grid
--  unmarkSelectedRows()             -                   Unmark rows that are currently selected in the grid
--

import 'GridControl'



handle any
endhandle

setup form !!cblMarkRouteNodes dialog docking

	using namespace 'Aveva.Pdms.Presentation'
	
  option .loadTypeDropDown    'Select:' anchor l+t at xmax ymin        callback '!this.setData(!this.loadTypeDropDown.val)' width 15

  frame  .routeNodeFrame  panel anchor all at xmin form ymax height 20 width 70
  	container .dataFrame nobox PMLNetCONTROL 'NET'  DOCK FILL
    member .dataGrid is NETGRIDCONTROL
  exit

  path down

	frame .buttonPanel PANEL anchor B+L+R at xmin form ymax width 70
		path right
   	button .markSelectedButton 		'Mark Selected' 	anchor L+B at xmin.buttonPanel 	tooltip 'Mark Selected Elements'
   	button .unmarkSelectedButton 	'Unmark Selected' anchor L+B 											tooltip 'Unmark Selected Elements'
   	button .markAllButton   			'Mark All'				anchor L+B 											tooltip 'Mark All Elements'
   	button .unmarkAllButton 			'Unmark All'			anchor L+B 											tooltip 'Unmark All Elements'
	exit

  menu .popupMenu
  !this.popupMenu.add( 'callback', 'Mark Selected', '!this.onMarkSelectedRows()', 'Mark Selected' )
  !this.popupMenu.add( 'callback', 'Unmark Selected', '!this.onUnmarkSelectedRows()', 'Unmark Selected' )
  !this.popupMenu.add( 'separator' )
  !this.popupMenu.add( 'callback', 'Mark All', '!this.onMarkAllRows()', 'Mark All' )
  !this.popupMenu.add( 'callback', 'Unmark All', '!this.onUnmarkAllRows()', 'Unmark All' )
  !this.popupMenu.add( 'separator' )
  !this.popupMenu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.dataGrid, |MarkRouteNodes.xls|, |Save As|)' )
  !this.popupMenu.add( 'callback', 'Print Preview...', '!this.dataGrid.printpreview()' )

  !this.formTitle = 'Mark Route Nodes'
  !this.quitcall   = |!this.dismiss()|
  !this.callback   = |!this.initialise()|

-- Members ---------------------------------------------------------------------
-- Previous selection row of RNODEs
   member .previousSelection is ARRAY
-- Previous owner selection from COMBO box
   --member .previousOwnerSelection is REAL
-- Previous DB ref owner
   member .previousOwner is DBREF

   member .prevSaveLocation is STRING
exit

---------------------------------------------------------------------------
-- Constructor
---------------------------------------------------------------------------

define method .cblMarkRouteNodes()
   using namespace 'Aveva.Pdms.Presentation'
-- create instance of .Net control
  !this.dataGrid = object NETGRIDCONTROL()

-- add form gadget callbacks
	!this.markSelectedButton.callback = '!this.onMarkSelectedRows()'
	!this.unmarkSelectedButton.callback = '!this.onUnmarkSelectedRows()'
	!this.markAllButton.callback = '!this.onMarkAllRows()'
	!this.unmarkAllButton.callback = '!this.onUnmarkAllRows()'

-- add PML event handlers to .Net control
	!this.dataGrid.addEventHandler('OnPopup', !this, 'dataGridOnPopup')
  !this.dataGrid.addEventHandler('AfterSelectChange', !this, 'onDataGridSelectChange')

-- add .Net control to PML container
  !this.dataFrame.control = !this.dataGrid.handle()

-- configure grid presentation
  !this.dataGrid.fixedHeaders(FALSE)
  !this.dataGrid.outlookGroupStyle(FALSE)
  !this.dataGrid.columnExcelFilter(true)
  !this.dataGrid.headerSort(true)
  !this.dataGrid.columnSummaries(false)
  !this.dataGrid.singleRowSelection(true)
  !this.dataGrid.setAlternateRowColor('WHITE')
  !this.dataGrid.errorIcon(TRUE)

-- options for collection scope
  !scopeDtext = ARRAY()
  !scopeDtext.append('Current Branch')
  !scopeDtext.append('Current Cableway')
  !scopeDtext.append('Current Zone')
  !scopeDtext.append('Current Site')

  !this.loadTypeDropDown.dtext  = !scopeDtext
endmethod

---------------------------------------------------------------------------
-- Initialise & Dismiss
---------------------------------------------------------------------------

define method .initialise()
 !this.dataGrid.cleargrid()
-- see if we can navigate to CWBRAN if at a lower level than CWBRAN
 if !!ce.ahlist.findfirst('CWBRAN').set() then
 	CWBRAN
 endif

-- load the grid with data
 if !!ce.type.eq('CWBRAN') then
   !this.setData(1)
   !this.loadTypeDropDown.val = 1
 elseif !!ce.type.eq('CWAY') then
   !this.setData(2)
   !this.loadTypeDropDown.val = 2
 elseif !!ce.type.eq('ZONE') then
   !this.setData(3)
   !this.loadTypeDropDown.val = 3
 elseif !!ce.type.eq('SITE') then
   !this.setData(4)
   !this.loadTypeDropDown.val = 4 	
 endif

-- Initialise the buttons
	!this.setButtons()

endmethod

define method .dismiss()
   !this.onUnmarkSelectedRows()
endmethod

---------------------------------------------------------------------------
-- Load Grid
---------------------------------------------------------------------------

define method .setData(!value is REAL)

-- Make proper action
   if !value.eq(1) then
      !selection = CWBRAN
   handle ANY
      !!alert.error('Cannot Navigate to Cableway Branch')
      return
      endhandle
   elseif !value.eq(2) then
      !selection = CWAY
      handle ANY
      !!alert.error('Cannot Navigate to Cableway')
      return
      endhandle
  elseif !value.eq(3) then
      !selection = zone
      handle ANY
      !!alert.error('Cannot Navigate to Zone')
      return
      endhandle
  elseif !value.eq(4) then
      !selection = site
      handle ANY
      !!alert.error('Cannot Navigate to Site')
      return
      endhandle
  endif

-- Unmark previous rows
   !this.unmarkAllRows()
-- Load the grid with new owner
   !this.loadGrid(!selection)
-- Mark all rows initially
   !this.markAllRows()
-- Update the selection for combo
   --!this.previousOwnerSelection = !value
-- Initialise Buttons
	!this.setButtons()

endmethod

---------------------------------------------------------------------------
-- Form Events
---------------------------------------------------------------------------

define method .dataGridOnPopup(!data is ARRAY)	
	!this.dataFrame.popup = !this.popupMenu
  !this.dataFrame.showPopup(!data[0], !data[1])
endmethod

define method .onMarkAllRows()
   !this.markAllRows()
endmethod

define method .onUnmarkAllRows()
   !this.unmarkAllRows()
endmethod

define method .onMarkSelectedRows()
  !this.markSelectedRows()
endmethod

define method .onUnmarkSelectedRows()
  !this.unmarkSelectedRows()
endmethod

define method .onDataGridSelectChange(!data is ARRAY)
	!this.setButtons()
endmethod

---------------------------------------------------------------------------
-- Methods
---------------------------------------------------------------------------

define method .markAllRows()
   !this.forEachRow(!this.dataGrid.getRows(), |!this.markRow|)
endmethod

define method .unmarkAllRows()
   !this.forEachRow(!this.dataGrid.getRows(), |!this.unMarkRow|)
endmethod

define method .markSelectedRows()
  !this.forEachRow(!this.dataGrid.getSelectedRows(), |!this.markRow|)
endmethod

define method .unmarkSelectedRows()
  !this.forEachRow(!this.dataGrid.getSelectedRows(), |!this.unMarkRow|)
endmethod

define method .setButtons()

  !gridRowCount = !this.dataGrid.getRows().size()
  !gridRowSelectedCount = !this.dataGrid.getSelectedRows().size()

  if (!gridRowCount eq 0) then
		!this.markAllButton.active = false
		!this.unmarkAllButton.active = false
		!this.popupMenu.setFieldProperty('Mark All', 'ACT', false)
		!this.popupMenu.setFieldProperty('Unmark All', 'ACT', false)
	else
		!this.markAllButton.active = true
		!this.unmarkAllButton.active = true
		!this.popupMenu.setFieldProperty('Mark All', 'ACT', true)
		!this.popupMenu.setFieldProperty('Unmark All', 'ACT', true)
	endif
	
	if (!gridRowSelectedCount eq 0) then
		!this.markSelectedButton.active = false
		!this.unmarkSelectedButton.active = false
		!this.popupMenu.setFieldProperty('Mark Selected', 'ACT', false)
		!this.popupMenu.setFieldProperty('Unmark Selected', 'ACT', false)
	else
		!this.markSelectedButton.active = true
		!this.unmarkSelectedButton.active = true
		!this.popupMenu.setFieldProperty('Mark Selected', 'ACT', true)
		!this.popupMenu.setFieldProperty('Unmark Selected', 'ACT', true)
	endif
	
endmethod

define method .loadGrid(!owner is DBREF)
-- Collect all the RNODEs
   !col  = object COLLECTION()
   !col.scope(!owner)
   !col.addtype('RNODE')
   !rnodes = !col.results()

-- Setup grid heading
   !headings = object ARRAY()
   !headings.append('Name')
   !headings.append('Branch name')
   !headings.append('World position')
--   !headings.append('Grid position')
   !headings.append('Type')

   !data = object ARRAY()
-- Fill out data source
   do !rn values !rnodes
      !row = object ARRAY()
      !row.append(!rn.flnm)
-- A branch
      !row.append(!rn.owner.owner.flnm)
      !row.append(!rn.position.wrt(worl).string())
      !row.append(!rn.rntype)
      !data.append(!row)
   enddo
-- define data source and bind to the grid
   !gridName = 'Data'
   using namespace  'Aveva.Pdms.Presentation'
   !nds = object NETDATASOURCE(!gridName, !headings, !data)
   !this.dataGrid.bindToDataSource(!nds)
endmethod

---------------------------------------------------------------------------
-- Helper Methods
---------------------------------------------------------------------------

define method .markRow(!elName is STRING)
-- The mark row 'closure'
   mark $!elName
endmethod

define method .unMarkRow(!elName is STRING)
-- The mark row 'closure'
   unmark $!elName
endmethod

-- Note: Could put this in a utility class
define method .forEachRow(!rows is ARRAY, !callback is STRING)
-- Generic function, to perform function as string argument for every
-- row, at first column
   do !item value !rows
-- select first row
      !name = !item[1]
-- build expression
      !expr = !callback + |(| + '!name' + |)|
-- create a block and evaluate it
      !block = object BLOCK(!expr)
      !block.evaluate()
   enddo
endmethod
