--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidClear()                       -                   clear aids
--  apply(STRING)                    -
--  associate()                      -                   Set associate rule for element
--  autoname()                       -                   auto name element
--  cblRnod()                        -
--  cblRnod(STRING,DBREF)            -
--  dismiss()                        -
--  format()                         -                   Set positioning format
--  hierarchyCheck()                 -                   check element can be created
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  nameCheck(STRING)                -
--  netAfterSelectChangeCallback(ARRAY) -
--  pickPos()                        -
--  setAids()                        -
--  setPos()                         -
--  setTask(STRING,DBREF)            -
--  updateAssociation()              -
--  updateAssociationGrid()          -
--  updateAttribs()                  -
--  updatePos()                      -
--  updateRnodObj()                  -
