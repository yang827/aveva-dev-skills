import 'PositionControl'
handle ANY
endhandle

import 'GridControl'
handle any
endhandle

using namespace 'Aveva.Pdms.Presentation'

setup form !!cblRnod dialog dock right
     -- Form Members
   !this.autoscroll = TRUE
  frame .mainTaskPane panel                   anchor l+r+t                        at x0                     y0

    --Element Name and Name Tags
   paragraph .attPara                                               anchor left + top             at xmin+.5                           ymin                         text  'Attributes'
   line      .linea                                                 anchor l+r+t                  at xmin                           ymax     horizontal                width 37
 --  paragraph .nameTag                                             anchor left + top             at xmin.linea                     ymax+1                         text  'Name:'
    text      .elementName  'Name:       '                          anchor left + right + top     at xmin.linea+.5                  ymax+.5                  callback '!this.nameCheck(!this.elementName.val)' width 18 is STRING
    button    .ceNavi      linklabel 'CE'                           anchor right + top            at xmax                           ymin.elementName                callback '!this.cblRnod(|MODIFY|,!!ce)'
    button    .ceAuto      'CE'                                     anchor right + top            at xmax.elementName+0.2           ymin.elementName-0.1      tooltip 'AutoNaming'        pixmap callback '!this.autoname()'

    --Element basic data
    text      .rnodDesc     'Description:'                          anchor left + right + top     at xmin.linea+.5                ymax.elementName           callback '!this.updateRnodObj()' width 18 is STRING
    text      .rnodFunc     'Function:   '                          anchor left + right + top     at xmin.linea+.5                ymin.rnodDesc+1                callback '!this.updateRnodObj()' width 18 is STRING
    text      .rnodPurp     'Purpose:    '                          anchor left + right + top     at xmin.linea+.5                ymin.rnodFunc+1                callback '!this.updateRnodObj()' width 18 is STRING

     paragraph .posPara                                            anchor left + top             at xmin                           ymax+.5                           text  'Position'
    line      .lineb                                               anchor l+r+t                  at xmin.linea                    ymax    horizontal                width 37
     -- Create a frame to hold PMLNet Positioning Control
    frame .positionControl2 panel  'Position'                      anchor left + right + top     at xmin.linea+.5                      ymax+0.5                          width 37  height 5
       container .netPositionFrame PMLNetCONTROL 'NET'              dock fill
    exit
    button .pickPos      linklabel 'Pick Position...'                 anchor left + top             at xmin.positionControl2+1         ymax.positionControl2+.5        tooltip 'Identify Element for position'                 callback '!this.pickPos()'


    paragraph .assocPara                                            anchor left + top             at xmin.linea+.5                           ymax+.5                           text  'Associations'
    line      .linec                                               anchor l+r+t                   at xmin.linea                     ymax    horizontal                width 37
    -- Create a frame to hold PMLNet Positioning Control
    frame .pmlFrame12 panel  'Association List'                    anchor T + L + R              at xmin.linea+.5                      ymax+0.5 height 12 width 37
        -- define PML Container to host my .Net control
        container .assocFrame pmlNetCONTROL 'NET'  DOCK FILL
    exit
    text      .assoElement 'Associate To:'                        anchor left + right + top     at xmin.linea+1                     ymax+.5                           callback '' width 8 is STRING
    button    .assoPick  linklabel 'Pick Element...'                  anchor right + top            at xmax+.5                        ymin        tooltip 'Identify Element'                    callback '!this.associate()'
    line      .lined                                               anchor l+r+t                  at xmin.linea                     ymax+0.5    horizontal                width 37

    path down
    halign right

    button .delete      linklabel 'Delete Route Node'      anchor left + top        at xmin+.5 ymax+1          callback '!this.delete()'
--    button .modifyIcon                                     anchor left + top        at xmin ymax form     tooltip 'Apply Changes'  pixmap callback '!this.apply(|MODIFY|)'
    paragraph .modifyIcon                                     anchor left + top        at xmin ymax form     pixmap
    button .modify      linklabel 'Apply Changes'          anchor left + top        at xmax-2 ymin       tooltip 'Apply Changes'   callback '!this.apply(|MODIFY|)'
    paragraph .createIcon                                     anchor left + top        at xmin.modifyIcon ymin.modifyIcon       pixmap
--    button .createIcon                                     anchor left + top        at xmin.modifyIcon ymin.modifyIcon     tooltip 'Create Route Node'  pixmap callback '!this.apply(|CREATE|)'
    button .create      linklabel 'Create Route Node'      anchor left + top        at xmax-2 ymin      tooltip 'Create'  callback '!this.apply(|CREATE|)'
--    button .dismissIcon                                    anchor right + top        at xmax form -21 ymin.modifyIcon     tooltip 'Discard Changes'  pixmap callback '!this.dismiss()'
    paragraph .dismissIcon                                    anchor right + top        at xmax form -21 ymin.modifyIcon     pixmap
    button .dismiss     linklabel 'Discard Changes'        anchor right + top       at xmax-2 ymin  tooltip 'Discard Changes'callback '!this.dismiss()'
  exit

  -- Warning Task Pane
  frame .warningPane panel                    anchor l+r+t                        at x0                     y0

    paragraph .warningHeader                                                    at x0                     ymax                text 'Warning'
    line .warningLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
    paragraph .warningIcon                    anchor left + top                 at x0.5                   ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                        anchor left + right + top         at xmax+2                 ymin                width 26 lines 6
    button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5                   ymax                callback '!this.warningDone()' width 28

  exit

  -- define CableGrid popup menu
  menu .assocGridPopup popup
  !this.assocGridPopup.add( 'CALLBACK', 'Enhance in 3D View', '!this.enhance()' )
  !this.assocGridPopup.add( 'CALLBACK', 'Unenhance in 3D View', '!this.unenhance()' )
  !this.assocGridPopup.add( 'CALLBACK', 'Add to My Data', '!this.addtomydata()' )
  !this.assocGridPopup.add( 'CALLBACK', 'Rem Association', '!this.remAssociation()' )
  !this.assocGridPopup.add( 'separator' )
  !this.assocGridPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.assocGrid, ||, |Save As|)' )
  !this.assocGridPopup.add( 'callback', 'Print Preview...', '!this.assocGrid.printpreview()' )

  --Form Members
  -- PMLNet Position control
  member .posControl    is POSITIONCONTROL
  member .rnod          is RNOD
  member .position      is POSITION
  member .assocGrid     is NETGRIDCONTROL

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  -- Warning action
  member .warningAction   is BLOCK
  member .formMode        is STRING
    -- EDG Description
  member .edgDescription  is STRING
  member .storageArea     is DBREF
  member .assocStorageArea is DBREF

  member .rnodTextAidNum       is REAL
  member .rnodLineAidNum       is REAL
  member .rnodBoxAidNum       is REAL

exit
-- end of form definition

------------------------------------------------------------------------
--
-- Method:   cblRnod()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblRnod()

  using namespace 'Aveva.Pdms.Presentation'

  -- Setup dummy default task
--  !this.currentTask             = object BLOCK('!this.test()')
  !this.rnodTextAidNum          = !!aidNumbers.add('rnodtext')
  !this.rnodLineAidNum          = !!aidNumbers.add('rnodline')
  !this.rnodBoxAidNum           = !!aidNumbers.add('rnodbox')

  -- Initialise task panes
  !this.mainTasks(true)
  !this.warningPane.visible     = false
  !this.quitcall   = |!this.dismiss()|

  --Form and Icon Title
  !this.iconTitle     = 'Rnod Task'
  !this.formTitle     = 'Create Route Node'

  -- Set icons
  !this.ceAuto.addPixmap(!!pml.getPathname('autoname.png'))
  !this.warningIcon.addPixmap(!!pml.getPathname('exclamation-32.png'))
  !this.modifyIcon.addPixmap(!!pml.getPathname('accept.png'))
  !this.createIcon.addPixmap(!!pml.getPathname('create.png'))
  !this.dismissIcon.addPixmap(!!pml.getPathname('discard.png'))

  -------------------- Setup for association grid control ----------------------
   -- create instance of .Net control
   !this.assocGrid = object NETGRIDCONTROL()

   -- add PML event handlers to .Net control
   --!this.assocGrid.addeventhandler('OnPopup', !this, 'NETPopupCallback')
   --!this.assocGrid.addeventhandler('BeforeCellUpdate', !this, 'NETBeforeCellUpdateCallback')
   !this.assocGrid.addeventhandler('AfterSelectChange', !this, 'NETAfterSelectChangeCallback')

   -- add .Net control to PML container
--   !this.assocFrame.control = !this.assocGrid.handle()
  !this.assocGrid.editableGrid(FALSE)
  !this.assocGrid.columnExcelFilter(TRUE)
  !this.assocGrid.outlookGroupStyle(FALSE)
  !this.assocGrid.fixedHeaders(FALSE)
  !this.assocGrid.fixedRows(FALSE)
  !this.assocGrid.errorIcon(TRUE)
  !this.assocGrid.updates(FALSE)

   -- add .Net control to PML container
   !this.assocFrame.control = !this.assocGrid.handle()

  -- Initialise Variables
  if !!ce.type.eq('RNOD') then
    !this.rnod = object RNOD(!!ce)
    !this.elementName.val = !this.rnod.dbref.namn
  endif
  !element = !!ce

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.posControl        = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                   = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')

  else
    !this.posControl.gridvisible(FALSE)
  endif

  -- Assign action to be taken when position is changed
  !this.posControl.changeAction('!!cblRnod.updatePos()')

  -- Initialise Control
  !this.posControl.forceXYZ(0,0,0)

  -- Default position control - if the grid is defined and the COORDINATE
  -- state is XYZ, then we will assume that all positions using the control
  -- are to be displayed using the gridFormat.
  var !coordinate coordinate
  if(!grid.set().and(!coordinate.eq('XYZ'))) then
    !this.posControl.gridFormat()
  else
    !this.posControl.enuFormat()
  endif

  -- Add PMLNet control to PML frame
  !this.netPositionFrame.control  = !this.posControl.handle()

  ----------------- End of set for Position Control --------------------

endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method:      format
--
-- Description: Set positioning format
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .format()

  -- Get selected format
  --!format = 'ENU'
  var !format coordinates
  if(!format.eq('ENU')) then
    !this.posControl.enuFormat()
  elseif (!format.eq('XYZ')) then
    !this.posControl.xyzFormat()
  elseif (!format.eq('GRID')) then
    !this.posControl.gridFormat()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:   cblRnod(!element)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblRnod(!mode is STRING ,!element is DBREF)

  using namespace 'Aveva.Pdms.Presentation'

  --Form and Icon Title
  !this.iconTitle       = 'Rnod Task'
  !this.formTitle       = 'Modify Route Node'
  !this.formMode        = !mode

  if !mode.eq('MODIFY') and !element.type.neq('RNODE') then
     -- Define error message to be displayed
     !type = !element.type
     !name = !element.name
     !message[1] = '$!type $!name is not a RNOD'
     !message[2] = 'Navigate to a valid RNODE and press Done to continue.'
     !this.warning(!message, '!this.mainTasks(true)', 'Done')

  endif

    -- Initialise form gadgets & objects
    if !mode.eq('MODIFY') then
      !this.rnod = object RNOD()
      !this.rnod.rnod(!!ce)
      if !this.rnod.dbref.namn.substring(1,1).eq(|=|) then
        !this.elementName.val = |Unset|
      else
        !this.elementName.val = !this.rnod.dbref.namn
      endif

    else
        -- Initialise the store Rnod object
        !this.rnod = object RNOD()

        !this.hierarchyCheck()
    endif


    -- set storage areas
    if !!cbldflts.rnodezonedefault.unset().not() then
      !this.storageArea = !!cbldflts.rnodezonedefault
      handle ANY
        if !this.rnod.dbref.unset().not() then
          !this.storageArea = !this.rnod.dbref.owner
        else
          !this.storageArea = !element
        endif
      endhandle
    else
      if !this.rnod.dbref.unset().not() then
        !this.storageArea = !this.rnod.dbref.owner
      else
        !this.storageArea = !element
      endif
    endif


--    !this.assocStorageArea = /RNOD-Association-Group
    if !!cbldflts.assocgroupdefault.unset().not() then
      !this.assocStorageArea = !!cbldflts.assocgroupdefault
    else
      --$P error handle for assoc storage area
--      !this.assocStorageArea = /RNOD-Association-Group
    endif


    if !this.rnod.description.neq('') then
       !this.rnodDesc.val    = !this.rnod.description
    else
       !this.rnodDesc.val    = 'Unset'
    endif
    if !this.rnod.function.neq('') then
       !this.rnodFunc.val    = !this.rnod.function
    else
       !this.rnodFunc.val    = 'Unset'
    endif
    if !this.rnod.purpose.neq('') then
      !this.rnodPurp.val    = !this.rnod.purpose
    else
      !this.rnodPurp.val    = 'Unset'
    endif
    -- Get position
    !position = !this.rnod.position
    handle ANY
      !position = N0
    endhandle

    -- Initialise Position control object
    !this.posControl.xyz(!position.east, !position.north, !position.up)
    !this.updateRnodObj()


    -- Initialise Association Grid control object
    using namespace  'Aveva.Pdms.Presentation'
    !headings = ARRAY()
    !headings.append('Name')
    !headings.append('Type')
    !gridName = 'Associations'

    !evassNames = object BLOCK('!this.rnod.assElements[!evalIndex].ref.string()')
    !assNames = !this.rnod.assElements.evaluate(!evassNames)
    handle ANY
      -- No associations defined
    elsehandle NONE
      !this.assocGrid.clearGrid()
      !this.assocGrid.clearGridData()
      !nds = object NETDATASOURCE(!gridName, !headings, !assNames)
      --!assname.append(1)
      --!nds = object NETDATASOURCE(!gridName, !headings, !!assNames)
      !this.assocGrid.bindToDataSource(!nds)
    endhandle

    !this.setTask(!mode, !element)

    !this.aidClear()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: setTask
--
-- Description: To set the task for based on the action to be performed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!formTask is STRING,!element is DBREF )
    if !this.shown().not() then
      show !!cblRnod
    endif

    --Initialise Variables
    !task             = !formTask.upcase()

    --Switch off all the Gadgets

   !this.ceAuto.visible                   = FALSE
   !this.ceNavi.visible                   = FALSE
   !this.create.visible                   = FALSE
   !this.modify.visible                   = FALSE
   !this.modifyIcon.visible               = FALSE
   !this.createIcon.visible               = FALSE
    if !task.eq('MODIFY') then
--$P Modify
      !this.ceNavi.visible                   = TRUE
      !this.modify.visible                   = TRUE
      !this.modifyIcon.visible               = TRUE

    else
--$P create
      !this.ceAuto.visible                   = TRUE
      !this.formTitle                        = 'Create Route Node'
      !this.elementName.val                  = 'Unset'
      !this.create.visible                   = TRUE
      !this.createIcon.visible               = TRUE

    endif
endmethod

------------------------------------------------------------------------
--
-- Method: Apply
--
-- Description: Create/Modify RNODE
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!mode is STRING)

   if !mode.eq('CREATE') then
     !!ce = !this.storageArea
     !test = !this.rnod.create()
     if !test[1].eq(0) then
       -- Define error message to be displayed
       !message[1] = !!error.text
       !message[2] = 'Navigate to a valid Zone and press Done to continue.'
       !this.warning(!message, '!this.mainTasks(true)', 'Done')
     endif
   else


   endif

   -- Update attributes on design element
   !this.updateAttribs()

   -- Create / Update Association
   !this.updateAssociation()


   !this.cblRnod('MODIFY' , !!ce)

endmethod

------------------------------------------------------------------------
--
-- Method: pickPos
--
-- Description: get position for picked element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPos()

  using namespace  'Aveva.Pdms.Presentation'

  !packet = object EDGPACKET()

  !packet.action      = '!!cblRnod.rnod.position = !this.return[1].position.wrt(worl)'

  !packet.defineposition('Pick Element to define RNOD position')
  !packet.priority    = 2
  !packet.remove      = TRUE
  !packet.continue = '!!cblRnod.setPos()'

  !!edgCntrl.add(!packet)


endmethod


------------------------------------------------------------------------
--
-- Method: updatePos
--
-- Description: Update position gadgets with new position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatePos()

  using namespace  'Aveva.Pdms.Presentation'
--get array of positions from positioning control
  !posArray = !this.posControl.xyz()

--set position object with positions, wrt world
  !position = object POSITION()
  !position.east  = !posArray[0]
  !position.north = !posArray[1]
  !position.up    = !posArray[2]
  !origin = '/*'
  !position.origin = !origin.dbref().position.origin

  !this.rnod.position = !position

  !this.setAids()

endmethod

------------------------------------------------------------------------
--
-- Method: setPos
--
-- Description: Update position gadgets with new position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPos()

  using namespace  'Aveva.Pdms.Presentation'
  !position = !!cblRnod.rnod.position
  !this.posControl.xyz(!position.east, !position.north, !position.up)

  !this.setAids()

endmethod
------------------------------------------------------------------------
--
-- Method: updateAttribs
--
-- Description: Update attributes of Rnod from Object
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttribs()

  !test = !this.rnod.update()
  if !test[1].eq(0) then
    !!alert.error(!test[2])
  endif


endmethod


------------------------------------------------------------------------
--
-- Method: updateRnodObj
--
-- Description: Update Rnod Object from form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRnodObj()

  if !this.rnod.name.neq('') or !this.rnod.name.unset().not() then
    !this.rnod.name = ||
  else
    !this.rnod.name        = '/' & !this.elementName.val
  endif
  !this.rnod.description = !this.rnodDesc.val
  !this.rnod.function    = !this.rnodFunc.val
  !this.rnod.purpose     = !this.rnodPurp.val

  if !this.rnod.position.unset() then
    !this.updatePos()
  endif
endmethod
------------------------------------------------------------------------
--
-- Method: warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()
  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

  !this.cblRnod(!this.formMode, !!ce)


endmethod
------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    --!this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')

    -- Change form title to reflect the active pane
    if !this.formMode.eq('CREATE') then
      !this.formTitle           = 'Create Route Node'
    else
      !this.formTitle           = 'Modify Route Node'
    endif
  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      associate
--
-- Description: Set associate rule for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associate()
  using namespace  'Aveva.Pdms.Presentation'

  -- Define EDG Packet
  !packet                 = object EDGPACKET()

  !packet.description     = !this.edgDescription
  !packet.key = 'RnodConn'

  -- When the component has been created successfully
  !packet.priority        = 2
  !packet.action          = '!!pickedItem[1] = !this.return[1].item'
  !packet.elementPick('Associate to:')
  !packet.remove          = TRUE
  !packet.pickpacket.picks[1].pick.input[3]   = |match('RATTA', type ) eq 1|
  !packet.pickpacket.picks[1].pick.modifiable = FALSE
  !packet.pickpacket.picks[1].numberofpicks   = 1

  !packet.escape   = '!!cblRnod.updateAssociationGrid()'
  !packet.continue = '!!cblRnod.updateAssociationGrid()'

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAssociate
--
-- Description: update associate rule for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAssociation()

   !array = ARRAY()
   !array.append(!this.rnod.dbref)
   !associations = !this.assocGrid.getrows()
   do !index indices !associations
     !array.append(!associations[!index][1].dbref())
   enddo

   if !array.size().gt(1) then
       !assos = !this.rnod.assos
     if !assos.unset() then
       !assoc = object AVEVAASSOCIATION()
       if !assoc.existsMulti(!this.assocStorageArea, !array) then
        --$p exists CREATED
         !syntax1 = 'POS'
         !target1 = !array[1]
         !amemrf1 = !array[1]
         !syntax1 = 'POS'
         !target1 = !array[2]
         !amemrf1 = !array[2]
         --if !assoc.coincident(!this.assocStorageArea, !syntax1, !target1, !amemrf1, !syntax2 ,! target2, !amemrf2,) then
         --   --$p coincident CREATED
         --else
         --   -----
         --endif
       else
         -----
       endif
     endif
   endif

   !!ce = !this.rnod.dbref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAssociateGrid
--
-- Description: update associate rule for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAssociationGrid()

  using namespace  'Aveva.Pdms.Presentation'

  -- Update RNOD object
  do !i values !!pickedItem
    if !this.rnod.assElements.findfirst(!i).unset() then
      !this.rnod.assElements.append(!i)
    endif
  enddo

  -- Update Association Grid control object
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !gridName = 'Associations'

  !evassNames = object BLOCK('!this.rnod.assElements[!evalIndex].ref.string()')
  !assNames = !this.rnod.assElements.evaluate(!evassNames)

  !nds = object NETDATASOURCE(!gridName, !headings, !assNames)
  !this.assocGrid.bindToDataSource(!nds)

  --$P To be completed
endmethod
-- End of method


