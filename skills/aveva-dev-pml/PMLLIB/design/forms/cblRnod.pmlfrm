------------------------------------------------------------------------
--
-- Method:      hierarchyCheck
--
-- Description: check element can be created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hierarchyCheck()

  if  !this.storageArea.unset() then
    ZONE
    handle ANY
       -- Define error message to be displayed
       !message[1] = !!error.text
       !message[2] = 'Navigate to a valid Zone and press Done to continue.'
       !this.warning(!message, '!this.mainTasks(true)', 'Done')

--    elsehandle NONE
--        !this.storageArea = !!ce
    endhandle
  endif

endmethod
-- End of method



------------------------------------------------------------------------
--
-- Method:      nameCheck
--
-- Description: name check element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameCheck(!elementName is STRING )


  if( !elementName.substring(1,1) ne '/' ) then
    -- add a / for PDMS name
    !name     =  '/' + !elementName
  endif
  -- Check to see if name converts to a dbref
  --!unusedDbRef      = !name.dbref()
  handle NONE
    -- bad name
    !this.elementName.clear()
   elsehandle any
    -- continue with new name
     !this.rnod.name = !name
     !this.elementName.val = !elementName
  endhandle


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      autoname
--
-- Description: auto name element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoname()

  --!area = !this.storageArea
  !elementName = !!cblAutoName(|RNODE|,!this.storageArea)

  if( !elementName.substring(1,1) ne '/' ) then
    -- add a / for PDMS name
    !elementName     =  '/' + !elementName
  endif
  -- Check to see if name converts to a dbref
  !unusedDbRef      = !elementName.dbref()
  handle NONE
    -- bad name
    !this.elementName.clear()
  elsehandle any
    -- continue with new name
    !this.rnod.name = !elementName
    !this.elementName.val = !elementName
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: Dismiss
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()


  !this.aidClear()

  !this.hide()

endmethod

--End of method definition


------------------------------------------------------------------------
--
-- Method: NETAfterSelectChangeCallback
--
-- Description: all back after grid selection
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChangeCallback(!dummyA is ARRAY)

   !colour =!!gphcolopt.highlight
   !rows = !this.assocGrid.getselectedrowtags()

  !this.aidClear()

  do !index indices !rows
    !assoc   = !rows[!index].dbref()
    enhance $!assoc col $!colour
  enddo

  if !rows.size().eq(1) then
    !assoc   = !rows[1].dbref()
    !aidNum = !this.rnodTextAidNum
    !pos = !rows[1].dbref().position.wrt( /* )
    !type = !rows[1].dbref().type
    AID TEXT NUMBER $!aidNum '$!type' AT $!pos

  endif

  !!ce = !this.rnod.dbref

  show !!assResults
  handle ANY
    --$p show standard association result form
  endhandle

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: aidClear
--
-- Description: clear aids
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidClear()


  unenhance all
  !rnodBoxAidNum  = !this.rnodBoxAidNum
  !rnodLineAidNum = !this.rnodLineAidNum
  !rnodTextAidNum = !this.rnodTextAidNum
  aid clear box $!rnodBoxAidNum
  handle ANY
  endhandle

  aid clear line $!rnodLineAidNum
  handle ANY
  endhandle

  aid clear text $!rnodTextAidNum
  handle ANY
  endhandle

endmethod
--End of method definition



------------------------------------------------------------------------
--
-- Method: set aids
--
-- Description: Set aids
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAids()

  -- clear existing aid used
  !this.aidClear()

  !rnodTextAidNum = !this.rnodTextAidNum
  !rnodBoxAidNum  = !this.rnodBoxAidNum
  !rnodLineAidNum = !this.rnodLineAidNum

  !newPosition = !this.rnod.position.wrt( /* )
  !oldPosition = !this.rnod.dbref.position.wrt( /* )
  handle ANY
    -- must be in create mode old position does not exist
  elsehandle NONE
    aid line num $!rnodLineAidNum $!oldPosition to $!newPosition linestyle dashdot

  endhandle
  !text = 'New Position'

  aid box  num $!rnodBoxAidNum  filled off xlen 60 ylen 60 zlen 60 at $!newPosition
  aid text num $!rnodTextAidNum  '$!text'  at $!newPosition

endmethod
--End of method definition

