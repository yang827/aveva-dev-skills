------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoNameCe()                     -                   Autonaming elements
--  cblcnode()                       -                   Constructor
--  clearaids()                      -                   Creation of aid text and lines
--  create(STRING)                   -                   create the elements
--  createData(STRING)               -                   generates the data required to create an element
--  dismiss()                        -
--  drawaids()                       -                   Draws the aids for cnode position
--  getposfromcntrl(ARRAY)           POSITION            Converts array from position control to position
--  loadData(STRING)                 -                   generates the data required to modify an element
--  modify(STRING)                   -                   modifies the elements
--  nameCheck(STRING)                -                   Check the correctness of the name
--  pickPos()                        -                   get position for picked element
--  poscntrl()                       -                   Initialise Position Control
--  setPos()                         -                   Update position gadgets with new position
--  setTask(STRING,STRING)           -
--  updateData(STRING)               -                   Updates the  data
--

-- Import DLL
import 'PositionControl'
handle ANY
endhandle
setup form !!cblcnode dialog dock right Noalign

   paragraph .cnodeCeTag              anchor l+t       at x0.1       ymax        text  'Current Element : ' width 30
   paragraph .cnodeNameTag            anchor l+t       at x0.1       ymax+0.1    text  'Control Node Name:'
   text      .cnodeName               anchor l+t+r     at xmax       ymin        callback '!this.nameCheck(|CNODE|)'      width 12 is STRING
   button    .cnodecurrElement 'CE'  linklabel   anchor r+t         at xmax       ymin  callback '!this.setTask(|MODIFY|,|CNODE|)' tooltip 'Select an Element and modify'
   button    .autoName                anchor r+t       at xmax+0.5   ymin         pixmap callback '!this.autoNameCe()' tooltip 'Autoname cnode'
   paragraph .cnodeattrib             anchor l+t       at x0.1       ymax+0.1     text  'Attributes'
   line      .cnodeLine               anchor l+t+r     at x0         ymax     horizontal   width 39

   --Element basic data
   paragraph .cnodeDescTag            anchor l+t       at x0.1         ymax+0.5     text  'Description:'
   text      .cnodeDesc               anchor l+t+r     at xmax         ymin         callback ''                             width 25 is STRING
   paragraph .cnodeFuncTag            anchor l+t       at x0.1         ymax         text  'Function:   '
   text      .cnodeFunc               anchor l+t+r     at xmax         ymin         callback ''                             width 25 is STRING
   paragraph .cnodePurpTag            anchor l+t       at x0.1         ymax         text  'Purpose:    '
   text      .cnodePurp               anchor l+t+r     at xmax         ymin         callback ''                             width 25 is STRING
   paragraph .cnodepos                anchor l+t       at x0.1         ymax+0.5     text  'Position'
   line      .cnodeposLine            anchor l+t+r     at x0           ymax     horizontal  width 39

 -- Create a frame to hold PMLNet Positioning Control
  frame .positionControl panel                  at x0.1           ymax+0.5   anchor t+l+r         width 38 heig 4
    container .netPositionFrame PMLNetCONTROL 'NET' dock fill
  exit
  button .pickPos      linklabel 'Pick Position...'   anchor l+t            at x0.1         ymax+0.5    callback '!this.pickPos()'

  paragraph .createCnodeIcon         anchor l+t    at x0                     ymax+2       pixmap width 16 height 16
  button    .createCnodeApply  linklabel   'Create Control Node' anchor l+t    at xmax+1       ymin         callback '!this.create(|CNODE|)'
  paragraph .modifyCnodeIcon         anchor l+t    at x0                     ymin         pixmap width 16 height 16
  button    .modifyCnodeApply  linklabel   'Apply Changes'       anchor l+t    at xmax+1          ymin         callback '!this.modify(|CNODE|)'
  paragraph .discardCnodeIcon        anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
  button    .discardCnodeApply linklabel   'Discard Changes'     anchor l+t    at xmax+1       ymin         callback '!this.setTask(|MODIFY|,|CNODE|)'

  -- Form Members
  using namespace 'Aveva.Pdms.Presentation'

  -- PMLNet Position control
  member .posControl      is POSITIONCONTROL

  member .zone            is DBREF
  member .activeElement   is DBREF
  member .task            is STRING
  member .position        is POSITION

   --aid numbers
  member .cnodeaidnumber  is REAL
  member .cnodebox        is GPHBOX

exit

------------------------------------------------------------------------
--
-- Method:   cblcnode()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblcnode()

  !this.quitcall   = |!this.dismiss()|
  -- initialise position control
 !this.poscntrl()

 -- icons
 !autoNameIcon   = !!pml.getPathname('autoname.png')
 !createIcon     = !!pml.getPathname('create.png')
 !modifyIcon     = !!pml.getPathname('accept.png')
 !discardIcon    = !!pml.getPathname('discard.png')

 !this.autoName.addPixmap(!autoNameIcon)
 !this.createCnodeIcon.addPixmap(!createIcon)
 !this.modifyCnodeIcon.addPixmap(!modifyIcon)
 !this.discardCnodeIcon.addPixmap(!discardIcon)

 --aids
 !this.cnodeaidnumber    = !!aidNumbers.add('Route Node')
 --gphbox
    !this.cnodebox.box.xlength = 100 mm
    !this.cnodebox.box.ylength = 100 mm
    !this.cnodebox.box.zlength = 100 mm
    !boxori   = object ORIENTATION('Y is N and Z is U')
    !this.cnodebox.box.orientation  = !boxori
    !this.cnodebox.box.position  = E0
    --!this.cnodebox.detail        = TRUE
    !this.cnodebox.tag           = TRUE
    !this.cnodebox.description   = 'Cnode Position'

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: poscntrl
--
-- Description: Initialise Position Control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .poscntrl()
 -- Initialise Variables

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.posControl        = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                   = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialize as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')
  else
    !this.posControl.gridvisible(FALSE)

  endif

  -- Assign action to be taken when position is changed
  !this.posControl.changeAction('!!cblcnode.drawaids()')

  -- Initialise Control
  !this.posControl.forceXYZ(0,0,0)

  var !coordinate coordinate
  if(!grid.xID.set() and (!coordinate.eq('XYZ'))) then
   !this.posControl.gridFormat()
  elseif(!coordinate.eq('XYZ')) then
   !this.posControl.xyzFormat()
  else
   !this.posControl.enuformat()
  endif

  -- Add PMLNet control to PML frame
  !this.netPositionFrame.control  = !this.posControl.handle()


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: nameCheck
--
-- Description: Check the correctness of the name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameCheck(!elementType is STRING)

    --Check name of Element
    !name                   = !!checkName(!this.$!<elementType>Name.val, 'NEW')

    --Update gadget with name
    if (!name.set()) then
      !name               = !name.substring(2)
      !this.$!<elementType>Name.val          = !name
    endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: autoNameCe
--
-- Description: Autonaming elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------


define method .autoNameCe()

   !this.cnodeName.val = !!cblautoname('CNODE', !this.zone)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: setTask
--
-- Description: To set the task based on the action to be performed.
--              Switching the gadgets on /off
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!formTask is STRING,!element is STRING )

 --show the defaults form for user to set
   !this.task   = !formTask.upcase()

--Change the form title

  if !formTask.upcase().eq('CREATE') then
    --navigate to zone
   !ce = !!ce
   zone
   handle ANY
   	!!alert.error('Cannot Create CNODE at the current position')
   	return
   elsehandle NONE
   !this.zone  = !!ce
   !!ce = !ce
   !this.activeElement  = !!ce
   endhandle
    !this.formtitle = 'Create Control Node'

  elseif !formTask.upcase().eq('MODIFY') then
    if !!ce.type.neq('CNODE') then
      !!alert.error('Cannot navigate to CNODE')
   	  return
    endif
    !ce  = !!ce
    zone
    !this.zone  = !!ce
    !!ce  = !ce
    !this.activeElement  = !!ce
    !this.formtitle = 'Modify Control Node'
  endif

  if !formTask.upcase().eq('CREATE') then

    !this.createCnodeIcon.visible     = TRUE
    !this.createCnodeApply.visible    = TRUE
    !this.modifyCnodeIcon.visible     = FALSE
    !this.modifyCnodeApply.visible    = FALSE
    !this.discardCnodeIcon.visible    = FALSE
    !this.discardCnodeApply.visible   = FALSE
    !this.cnodecurrElement.visible    = FALSE
    !this.createData(!element)
  elseif !formTask.upcase().eq('MODIFY') then
  	!this.createCnodeIcon.visible     = FALSE
    !this.createCnodeApply.visible    = FALSE
    !this.modifyCnodeIcon.visible     = TRUE
    !this.modifyCnodeApply.visible    = TRUE
    !this.discardCnodeIcon.visible    = TRUE
    !this.discardCnodeApply.visible   = TRUE
    !this.cnodecurrElement.visible    = TRUE
    !this.loadData(!element)
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: createData
--
-- Description: generates the data required to create an element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createData(!elementType is STRING)

    if !elementType eq 'CNODE' then
     !this.cnodeName.val  = ''
     !this.cnodeCeTag.val = 'Current Element  :                   ' & !this.activeElement.flnn
     !this.cnodeDesc.val  = ''
     !this.cnodeFunc.val  = ''
     !this.cnodePurp.val  = ''
     !this.posControl.forceXYZ(0,0,0)
      --aids
       !this.cnodebox.box.position  = !this.getposfromcntrl(!this.posControl.xyz())
       !this.cnodebox.draw(!this.cnodeaidnumber)
    endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: loadData
--
-- Description: generates the data required to modify an element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadData(!elementType is STRING)

    if !elementType eq 'CNODE' then
     !this.cnodeName.val  = !!ce.flnn
     !this.cnodeCeTag.val = 'Current Element  :                   ' & !!ce.flnn
     !this.cnodeDesc.val  = !!ce.description
     !this.cnodeFunc.val  = !!ce.function
     !this.cnodePurp.val  = !!ce.purpose
     !pos = !!ce.pos.wrt(worl)
     !this.posControl.forceXYZ(!pos.east,!pos.north,!pos.up)
     --aids
      !this.cnodebox.box.position  = !!ce.position.wrt(worl)
      !this.cnodebox.draw(!this.cnodeaidnumber)
    endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: create
--
-- Description: create the elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!elementType is STRING)

  -- Mark database
    !undo               = object UNDOABLE()
    !undo.description('Create $!elementType')
    !undo.add()

  if !elementType.upcase().eq('CNODE') then
    !!ce = !this.activeElement
    NEW CNODE
    !this.activeElement  = !!ce
    !this.updateData('CNODE')
    !this.setTask('MODIFY','CNODE')
  endif
  -- End undo mark
    !undo.endUndoable()
 endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: modify
--
-- Description: modifies the elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!elementType is STRING)
  -- Mark database
    !undo               = object UNDOABLE()
    !undo.description('Create $!elementType')
    !undo.add()
  if !elementType.upcase().eq('CNODE') then
    !this.updateData('CNODE')
  endif
  -- End undo mark
    !undo.endUndoable()
 endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: updateData
--
-- Description: Updates the  data
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData(!elementType is STRING)
    !!ce   = !this.activeElement
    !!ce.name         = '/' & !this.cnodeName.val
    handle ANY
    endhandle
    !!ce.description  = !this.cnodeDesc.val
    !!ce.function     = !this.cnodeFunc.val
    !!ce.purpose      = !this.cnodePurp.val
    !!ce.position     = !this.getposfromcntrl(!this.posControl.xyz())

 endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: getposfromcntrl
--
-- Description: Converts array from position control to position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getposfromcntrl(!pos is ARRAY) is POSITION

   !east      = !pos[0]
   !north     = !pos[1]
   !up        = !pos[2]
   !position           = object POSITION('E $!east N $!north U $!up')
   return !position


  endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: pickPos
--
-- Description: get position for picked element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPos()

  !packet = object EDGPACKET()

  !packet.action      = '!!cblcnode.position = !this.return[1].position.wrt(worl)'
  !packet.defineposition('Pick Element to define position')
  !packet.priority    = 2
  !packet.remove      = TRUE
  !packet.continue = '!!cblcnode.setPos()'

  !!edgCntrl.add(!packet)


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: setPos
--
-- Description: Update position gadgets with new position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPos()

  !pos = !this.position
  !this.posControl.xyz(!pos.east,!pos.north,!pos.up)
  !this.drawaids()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: drawaids
--
-- Description: Draws the aids for cnode position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawaids()

 !this.cnodebox.box.position  = !this.getposfromcntrl(!this.posControl.xyz())
 !this.cnodebox.draw(!this.cnodeaidnumber)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: Dismiss
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.clearaids()
  !this.hide()

endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: clearaids
--
-- Description: Creation of aid text and lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearaids()

    aid clear all $!this.cnodeaidnumber
    handle ANY
    endhandle

endmethod

--End of method definition
