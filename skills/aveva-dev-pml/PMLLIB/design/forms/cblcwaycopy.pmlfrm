------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoNameCE(GADGET,STRING,DBREF)  -
--  autoname(STRING,DBREF)           -                   autoname
--  cblCwayCopy()                    -
--  copy()                           -                   Copy
--  copyBranch(DBREF,DBREF)          -                   copyBranch
--  dismiss()                        -                   dismiss the form
--  drawAid()                        -                   Draw Aid to indicate the position of copied branches
--  format()                         -                   Set positioning format
--  init()                           -                   Initialisation
--  move(DBREF,REAL)                 -                   move
--  pickPos()                        -
--  removePenetrations()             -                   deletes the penetration route nodes on newly created CWAY
--  setCE(GADGET,STRING)             -
--  setPos()                         -
--  update()                         -
--  validate(GADGET,STRING)          -                   Validate entry
--  validateNewName(GADGET)          BOOLEAN             validate a new name
--  validateOldName(GADGET,STRING)   BOOLEAN             validate a old name and check the type
--
import 'PositionControl'
handle ANY
endhandle

setup form !!cblCwayCopy dialog dock right Noalign

  using namespace 'Aveva.Pdms.Presentation'

		!this.autoscroll = true

    frame .copyTaskPane panel 															anchor l+t+r   	at x0           y0
			paragraph .optionTag            											anchor l+t      at xmin         ymin +0.2    		text  'Select Options '
   		line      .optionLine           											anchor l+t+r    at xmin         ymax          	horizontal width 35   	  		
    		frame .options                            					anchor l+t+r   	at xmin         ymax +0.3				width 35
     			rtoggle .cwayZoneCopy  'Zone'                     anchor l+t      at xmin +0.7  	ymax +0.1
     			rtoggle .cwayCopy      'Cableway'                 anchor l+t      at xmin			  	ymax +0.1
     			rtoggle .cwayBranCopy  'Cableway Branch'          anchor l+t      at xmin  				ymax +0.1
     			rtoggle .cwayCableCopy 'Cableway with Cables'    	anchor l+t      at xmin  				ymax +0.1
				exit
				
    exit

    paragraph .elementTag            												anchor l+t      at xmin      		ymax +0.5   		text  'Select Elements '
    line      .elementLine           												anchor l+t+r    at xmin         ymax            horizontal width 35
		paragraph .elementOneLabel															anchor l+t      at xmin         ymax +0.5   		text 'Element to Copy:'
		paragraph .copiedOneLabel																anchor l+t      at xmin      		ymax +0.5    		text 'Element to Copy:'
    paragraph .copyoptionTag         												anchor l+t      at xmin   			ymax +0.5      	text  'Copy Options '
    line      .copyoptionLine        												anchor l+t+r    at xmin					ymax            horizontal width 35
    paragraph .numberofcopiesLabel 													anchor l+t      at xmin   			ymax +0.5   		text  'Number of Copies:'
    toggle    .autonametoggle        												anchor l+t      at xmin.elementOneLabel      	  ymax +0.2      ' Auto Name Branches'
    paragraph .offsetTag            												anchor l+t      at xmin         ymax +0.5       text  'Offset'
    line      .offsetLine           												anchor l+t+r    at xmin         ymax            horizontal width 35

    button    .celementOne linklabel ' CE' 									anchor t+r      at xmax.elementOneLabel +15     ymin.elementOneLabel       callback '!this.setCE(!this.elementOne, !this.typeOne)'
    button    .autoNameOne           												anchor t+r      at xmax.elementOneLabel +15     ymin.copiedOneLabel        pixmap callback '!this.autoNameCE(!this.copiedOne, !this.typeOne, !this.ownOne)' tooltip 'Autoname'

    text      .elementOne            												anchor l+t+r    at xmax.elementOneLabel +1      ymin.elementOneLabel       callback ''  width 12 is STRING
    text      .copiedOne             												anchor l+t+r    at xmax.elementOneLabel +1      ymin.copiedOneLabel        callback '!this.validate(!this.copiedOne, !this.typeOne)'  width 12 is STRING
    text      .numberofcopies        												anchor l+t+r    at xmax.elementOneLabel +1      ymin.numberofcopiesLabel   callback '!this.update()'  width 12 is REAL

     -- Create a frame to hold PMLNet Positioning Control
    frame .positionControl2 panel  'Position'               anchor l+t+r    at xmin.offsetLine              ymax.offsetLine +0.2        width 35  height 5
       container .netPositionFrame PMLNetCONTROL 'NET'      dock fill
       button .pickPos         linklabel 'Pick Offset...'   anchor l+t      at xmin.positionControl2 +1     ymax.positionControl2 -1    tooltip 'Identify Element for position'                 callback '!this.pickPos()'
    exit

    paragraph .copyIcon                             				anchor l+t      at xmin.elementOneLabel         ymax +0.2         pixmap width 16 height 16
    button .next 'Copy'     linklabel 											anchor l+t      at xmax +1                      ymin              callback '!this.copy()'

     --members
     member .typeOne      is STRING
     member .typeTwo      is STRING
     member .ownOne       is DBREF
     member .ownTwo       is DBREF

     member .cwbm         is CABLEWAYMANAGER
     member .posControl   is POSITIONCONTROL
     member .position     is POSITION
     member .newPosition  is POSITION
     member .edgDescription  is STRING
     --Array to store penetration atta sequence
     member .peneNodes    is ARRAY

     --what is being copied
     member .copyElement  is DBREF

     -- what is copied
     member .copiedElements is ARRAY
     member .errorState     is BOOLEAN
     member .aidnumber     is REAL
  !this.autoscroll  = TRUE

exit



------------------------------------------------------------------------
--
-- Method:   cblCwayCopy()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .cblCwayCopy()

  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.posControl        = object POSITIONCONTROL()
  !this.posControl.enuFormat()

  !this.formtitle = 'Copy Cableway Elements'
  !this.initcall = '!this.init()'
  !this.quitcall 		= '!this.dismiss()'
  !this.killingcall = '!this.dismiss()'

  -- Validation Calls
  !this.elementOne.callback = '!this.validateOldName(!this.elementOne, !this.typeOne)'
  !this.copiedOne.callback = '!this.validateNewName(!this.copiedOne)'

  !cableExist   = object MDRLICENCEMANAGER()
  if !cableExist.hascablinglicence('CABLES').not() then
  	!this.cwayCableCopy.active = FALSE
  endif

  !this.cwayZoneCopy.val = true
  !autoNameIcon   = !!pml.getPathname('autoname.png')
  !copyIcon   = !!pml.getPathname('accept.png')
  !this.autoNameOne.addPixmap(!autoNameIcon)
  --!this.autoNameTwo.addPixmap(!autoNameIcon)
  !this.copyIcon.addPixmap(!copyIcon)
  !this.options.callback = '!this.update()'
  !this.numberofcopies.val  = 1
  !this.edgDescription  = 'Pick Position'

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'


  -- Load ship grid data
  !grid                   = object SHIPGRID()
  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialize as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')

  else
    !this.posControl.gridvisible(FALSE)
  endif

  -- Assign action to be taken when position is changed
  !this.posControl.changeAction('!!cblCwayCopy.drawAid()')

  -- Initialise Control
  !this.posControl.forceXYZ(0,0,0)


  -- Default position control - if the grid is defined and the COORDINATE
  -- state is XYZ, then we will assume that all positions using the control
  -- are to be displayed using the gridFormat.
  var !coordinate coordinate
  if(!grid.set().and(!coordinate.eq('XYZ'))) then
    !this.posControl.gridFormat()
  else
    !this.posControl.enuFormat()
  endif

  -- Add PMLNet control to PML frame
  !this.netPositionFrame.control  = !this.posControl.handle()

  ----------------- End of set for Position Control --------------------
   !this.aidnumber  = !!aidnumbers.add('PROFILE')
   !this.update()

endmethod

--End of method definition



------------------------------------------------------------------------
--
-- Method:   update()
--
-- Description: Sets appropriate options for copy
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .update()
if (!this.numberofcopies.val lt 0) then
	!!alert.error ('Enter a positive value!')
	!this.numberofcopies.val = 0
	endif
  if !this.numberofcopies.val.unset() then
  	!this.numberofcopies.val = 0
  endif	
  !this.errorState  = false	
  !number = !this.numberofcopies.val
  !this.autonametoggle.val  = FALSE
  if !number.eq(1) then
  	!this.autonametoggle.visible  = FALSE
  	!this.copiedOne.visible       = TRUE
  	!this.autoNameOne.visible     = TRUE
  else
    !this.autonametoggle.visible  = TRUE
    !this.copiedOne.visible       = FALSE
  	!this.autoNameOne.visible     = FALSE	
  endif

-- clear all gadget values
   --!this.elementOne.val  = ''
   !this.copiedOne.val   = ''
   !this.autonametoggle.tag = ' Autoname CWBRAN'

  if !this.options.val.eq(1) then
    !this.elementOneLabel.val    = 'Zone to Copy :'
    !this.copiedOneLabel.val     = 'Name of New Zone :'
    !this.autonametoggle.visible = TRUE
    !this.autonametoggle.tag     = ' Autoname Elements'
    !this.typeOne                = 'ZONE'
    !site                        = site
    !zone                        = zone
    !this.ownOne                 = !site
    !this.copyElement            = !!ce
  elseif  !this.options.val.eq(2) then
    !this.elementOneLabel.val    = 'Cableway to Copy :'
    !this.copiedOneLabel.val     = 'Name of New Cableway :'
    !this.autonametoggle.tag     = ' Autoname Elements'
    !this.typeOne                = 'CWAY'
    !zone                        = zone
    !this.ownOne                 = !zone
   elseif  !this.options.val.eq(3) then
    !this.elementOneLabel.val    = 'Branch to Copy :'
    !this.copiedOneLabel.val     = 'Name of New Branch :'
    !this.autonametoggle.tag     = ' Autoname Elements'
    !this.typeOne                = 'CWBRAN'
    !cway                        = cway
    !this.ownOne                 = !cway
  elseif  !this.options.val.eq(4) then
    !this.elementOneLabel.val    = 'Cableway to Copy :'
    !this.copiedOneLabel.val     = 'Name of New Cableway :'
    !this.autonametoggle.visible = TRUE
    !this.autonametoggle.tag     = ' Autoname Elements'
    !this.typeOne                = 'CWAY'
    !zone                        = zone
    !this.ownOne                 = !zone
    !this.typeTwo                = 'CABLE'
    !this.ownTwo                 = !zone
  elseif  !this.options.val.eq(5) then
    !this.elementOneLabel.val    = 'Cableway to Copy :'
    !this.copiedOneLabel.val     = 'Name of New Cableway :'
    !this.typeOne                = 'CWAY'
    !this.typeTwo                = 'CWAY'
    !zone                        = zone
    !this.ownOne                 = !zone
    !this.ownTwo                 = !zone
  endif

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: AutonameCE
--
-- Description: Autonaming elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------


define method .autoNameCE(!gadget is GADGET , !type is STRING, !owner is DBREF)

 !gadget.val = !!cblautoname(!type, !owner)
   handle ANY
  --!!alert.message('Cannot Autoname Check the hierarchy')
  endhandle

  if !gadget.val.unset() then
    !gadget.val = ''
    !!alert.message('Cannot Autoname')
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:   setCE
--
-- Description:
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCE(!gadget is GADGET, !type is STRING)

  $!type
  handle ANY
    !!alert.error('Cannot Navigate to $!type from the current element')
    return
  endhandle

  --if !!ce.type.neq(!type) then
  -- !!alert.error('Select a $!type')
  -- return
  --endif

  !gadget.val = !!ce.namn
  if !!ce.type.eq('CWBRAN') then
  	!this.position = !!ce.hpos
  else
   !this.position = !!ce.position
  endif

   if !!ce.type.eq('ZONE') then
   -- see if there are any cway elements under the zone
  	 !col = object COLLECTION()
  	 !col.type('CWAY')
  	 !col.scope(!!ce)
  	 if !col.results().unset() then
  	 	!!alert.error('There are no cableways in the selected zone')
  	 	return
  	 endif
  	endif


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: validate
--
-- Description: Validate entry
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validate(!gadget is GADGET, !type is STRING)
   !this.errorState  = false
   --if !gadget.eq(!this.elementOne) or !gadget.eq(!this.elementTwo) then
    if !gadget.eq(!this.elementOne) then
     !value = !gadget.val.trim()

    if !value.substring(1,1).neq('/') then
      !value = '/' & !value
    endif
     !gadget.val = !value.after('/')
     !value.dbref()
    handle ANY
     if !value.eq('/')then
      !gadget.val = ''
     endif
     !!alert.message('Not a valid Name')
     !this.errorState  = true
    elsehandle NONE

     if !value.dbref().type.neq(!type) then
      !!alert.error('$!value is not a $!type')
      !this.errorState = true
     endif

     -- see if there are any cway elements under the zone
  	 if !type.eq('ZONE') then
  	  !col = object COLLECTION()
  	  !col.type('CWAY')
  	  !col.scope(!value.dbref())
  	  if !col.results().unset() then
  	  	!!alert.error('There are no cableways in the selected zone')
  	  	!this.errorState = true
  	  	return
  	  endif
  	 endif
  	
    endhandle

  elseif !gadget.eq(!this.copiedOne) or !gadget.eq(!this.copiedTwo) then
    !ce = !!ce
    !value = !gadget.val.trim()
    --navigate to element
    if !value.substring(1,1).neq('/') then
      !value = '/' & !value
    endif
    $!value
    handle ANY
    elsehandle NONE
      !!ce = !ce
      !!alert.error('Name already exists')
      !gadget.val = ''
    endhandle
    !this.errorState  = true
  endif


endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: copy
--
-- Description: Copy
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copy()

  -- check if element to copy is selected
  if !this.elementOne.val.eq('') then
 	  !!alert.error('Element to copy is not selected')
 	  return
  endif

  -- Validate the data in the text gadgets
  if(!this.numberofcopies.val.lt(1))then
    !!alert.warning('Number of copies is less than 1.  Please enter a valid value.')
   	return
  elseif(!this.numberofcopies.val.geq(1))then
  -- set the type according to the current option
  !optionType = ''
    if !this.options.val.eq(1) then
  		!optionType = 'ZONE'
    elseif !this.options.val.eq(2) then
  		!optionType = 'CWAY'
    elseif !this.options.val.eq(3) then
  		!optionType = 'CWBRAN'
    elseif !this.options.val.eq(4) then
  		!optionType = 'CWAY'
    endif
	  !test = !this.validateOldName(!this.elementOne, !optionType)
    if (!test.eq (false)) then
		  return
    endif	
  endif

  -- Mark database
  !undo               = object UNDOABLE()
  !undo.description('Copy cway elements')
  !undo.add()

  if !this.elementOne.val.substring(1,1).neq('=') then
   !first = '/' & !this.elementOne.val
  else
   !first = !this.elementOne.val
  endif

  if (!this.numberofcopies.val.eq(1)) then
    if (not !this.validateNewName(!this.copiedOne)) then
      -- Warning message already produced via validateNewName method
      -- !!alert.error('Name of a target element is invalid.')
      return
    endif
  endif

    !copyFirst = '/' & !this.copiedOne.val

  if !copyFirst.eq('/') then
    !copyFirst = ''
  endif
  -- reset members
  !this.copyElement  = object DBREF()
  !this.copyElement  = object DBREF(!first)

  !this.copiedElements = object ARRAY()

  -- get the penetration route nodes to delete later
  !this.peneNodes = object ARRAY()
  !col = object COLLECTION()
  !col.scope(object DBREF(!first))
  !col.type('RNODE')
  !express = object EXPRESSION(|RNTYPE eq 'PENE' or RNTYPE eq 'OFFS'|)
  !col.filter(!express)
  !routeNodes = !col.results()

  -- filter out penetration route nodes
  do !node values !routeNodes
    if !node.assos.set() then
      !this.peneNodes.append(!node)
    endif
  enddo

 -- put in a loop for number of copies
  do !i from 1 to !this.numberofcopies.val
    -- copy whole zone
    if !this.options.val.eq(1) then
  	  -- see if there are any cway elements under the zone
  	  !col = object COLLECTION()
  	  !col.type('CWAY')
  	  !col.scope(!first.dbref())
  	  if !col.results().unset() then
  	 	  !!alert.error('There are no cableways in the selected zone')
  	 	  return
  	  endif	
      NEW ZONE $!copyFirst COPY $!first RENAME $!first $!copyFirst
      handle ANY
        NEW ZONE $!copyFirst COPY $!first
      endhandle
      !this.copiedElements.append(!!ce)
      -- autoname
      if !this.autonametoggle.val then
        !this.autoname('CWAY',!!ce)
        !this.autoname('CABLE',!!ce)
      endif
      --!this.copyBranch(!first.dbref(),!!ce)
      !this.move(!!ce, !i)

    -- copy cableway only
    elseif !this.options.val.eq(2) then
      if !!cbldflts.cwayZonedefault.set() then
        !!ce = !!cbldflts.cwayZonedefault
      endif
      NEW CWAY $!copyFirst COPY $!first RENAME $!first $!copyFirst
      handle ANY
        NEW CWAY $!copyFirst COPY $!first
      endhandle
      !this.copiedElements.append(!!ce)
      -- autoname
      if !this.autonametoggle.val then
        !this.autoname('CWAY',!!ce)
      endif
      --!this.copyBranch(!first.dbref(),!!ce)
      !this.move(!!ce, !i)

    -- copy cableway branch
    elseif !this.options.val.eq(3) then
      NEW CWBRAN $!copyFirst COPY $!first RENAME $!first $!copyFirst
      handle ANY
        NEW CWBRAN $!copyFirst COPY $!first
      endhandle
      !this.copiedElements.append(!!ce)
      !this.copyBranch(!first.dbref(),!!ce)
      !this.move(!!ce, !i)
      --disconnect and connect
      if !!ce.hdconn.set() or !!ce.tlconn.set()then
        !connectors = object ARRAY()
        !ce  = !!ce
        do !atta values !!ce.hdconn
          !!ce = !atta
          if !!ce.type.eq('HATTA') or !!ce.type.eq('TATTA') then
            !connectors.append(!!ce.owner)
          elseif !!ce.type.eq('RATTA') or !!ce.type.eq('RNODE') then
        	  !connectors.append(!!ce.owner.owner)
          endif
        enddo
        !!ce = !ce
        !this.cwbm.disconnectBranch(!!ce)
        do !conn values !connectors
          !this.cwbm.connectBranches(!!ce,!conn)
        enddo
      endif

    -- copy cableway with Cable
    elseif !this.options.val.eq(4) then
      -- check if cableway has cables on it and collect it
      !cway   = !first.dbref()
      !col  = object COLLECTION()
      !col.scope(!cway)
      !col.type('POINTR')
      !cables = object ARRAY()
      do !point values !col.results()
        if !point.clist[0].set() then
          do !clist values !point.clist[0]
            !cables.append(!clist)
          enddo
        endif
      enddo
      -- make the array unique
      !cables.sortunique()
      if !cables.size().eq(0) then
        !!alert.error('There are no cables on the selected cableway')
        return	
      endif
      -- move to correct hierarchy if set and create CWAY
      if !!cbldflts.cwayZonedefault.set() then
        !!ce = !!cbldflts.cwayZonedefault
      endif
      NEW CWAY
      NAME $!copyFirst
      handle ANY
      endhandle
      !this.copiedElements.append(!!ce)
      !cway = !!ce
      -- move to correct hierarchy if set and create CABLE
      if !!cbldflts.cablezonedefault.set() then
        !!ce = !!cbldflts.cablezonedefault
      endif
      -- create and store cables in an array
      !ncable = object ARRAY()
        do !j from 1 to !cables.size()
          NEW CABLE
          !ncable[$!j] = !!ce
        enddo
      -- make a string to execute the special copy command. The copy start/end commands do not allow
      -- do loops , handle etc.
      !copyString = ''
      do !k from 1 to !cables.size()
        -- we have to use an enter so that the syntax is correct. That is why we can see a single quote(') in next line
        !copyString = !copyString & 'COPY ALL of $!cables[$!k] to $!ncable[$!k]
  		  '
      enddo
      COPY START
        COPY ALL of $!first to $!cway
        $!copyString
      COPY END
      -- autoname cables
      if !this.autonametoggle.val then
       	do !a from 1 to !ncable.size()
          !this.autoname('CABLE',!ncable[$!a])
        enddo
      endif
      --navigate to cableway and complete actions
      !!ce = !cway
      -- auto name cableway
      if !this.autonametoggle.val and !!ce.namn.substring(1,1).eq('=') then
     	  !this.autoname('CWAY', !!ce)
      endif	
      !this.copyBranch(!first.dbref(),!!ce)
      !this.move(!!ce, !i)
    endif
  enddo
  --remove penetrations
  !this.removePenetrations()
  --Clear Aids
  AID CLEAR ALL $!this.aidnumber
  -- End undo mark
  !undo.endUndoable()
  -- Confirmation message
  !!alert.message('Copy was successful')

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: autoname
--
-- Description: autoname
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoname(!type is STRING, !own is DBREF)

   !col = object COLLECTION()
   !col.type(!type)
   !col.scope(!own)

   do !i indices !col.results()
     !col.results()[$!i].name = '/' & !!cblautoname(!type, !col.results()[$!i].owner)
     handle ANY
     endhandle
   enddo

endmethod

--End of method definition


------------------------------------------------------------------------
--
-- Method: copyBranch
--
-- Description: copyBranch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyBranch(!from is DBREF, !to is DBREF)

   !colFrom = object COLLECTION()
   !colFrom.type('CWBRAN')
   !colFrom.scope(!from)

   !colTo = object COLLECTION()
   !colTo.type('CWBRAN')
   !colTo.scope(!to)

   do !i indices !colFrom.results()
    !this.cwbm.copyBranch(!colFrom.results()[$!i],!colTo.results()[$!i])

    if !this.autonametoggle.val then
     if  !colTo.results()[$!i].name.substring(1,1).eq('=') then
      !colTo.results()[$!i].name = '/' & !!cblautoname('CWBRAN', !colTo.results()[$!i].owner)
      handle ANY
      endhandle
     endif
    endif
   enddo



endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: move
--
-- Description: move
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .move(!element is DBREF, !index is REAL)

     !!ce = !element
     !east  = !this.posControl.xyz()[0].string()
     !north = !this.posControl.xyz()[1].string()
     !up    = !this.posControl.xyz()[2].string()

     by east  ($!east * $!index)
     by north ($!north * $!index)
     by up    ($!up * $!index)

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: init
--
-- Description: init
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()
   if !!ce.type.eq('CWBRAN') then
   	 !this.options.val = 3
   	 !this.position    = !!ce.hpos.wrt( /* )
   elseif !!ce.type.eq('CWAY') then
   	 !this.options.val = 2
   	 !this.position    = !!ce.position.wrt( /* )
   elseif !!ce.type.eq('ZONE') then
   	 !this.options.val = 1
   	 !this.position    = !!ce.position.wrt( /* )
   endif	
   !this.update()
   --!this.typeOne = !!ce.type
   --!this.ownOne = !!ce.owner
   --!this.cwayCopy.val = TRUE
   !this.elementOne.val = !!ce.namn
   !this.copyElement = !!ce
   !this.posControl.xyz(0, 0, 0)
 endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method:      format
--
-- Description: Set positioning format
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .format()

  -- Get selected format
  !format = 'ENU'
  if(!format.eq('ENU')) then
    !this.posControl.enuFormat()
  elseif (!format.eq('XYZ')) then
    !this.posControl.xyzFormat()
  elseif (!format.eq('GRID')) then
    !this.posControl.gridFormat()
  endif

endmethod


------------------------------------------------------------------------
--
-- Method: pickPos
--
-- Description: get position for picked element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPos()

  !!edgCntrl.remove(!this.edgDescription)
  !packet = object EDGPACKET()
  !packet.description  = !this.edgDescription
  !packet.initialisation = '!!cblCwayCopy.newPosition = object POSITION()'
  !packet.action      = '!!cblCwayCopy.newPosition = !this.return[1].position.wrt(worl)'

  !packet.pickPacket.stdPosition('Please pick an Element to define offset')
  !packet.priority    = 2
  !packet.remove      = TRUE
  !packet.continue = '!!cblCwayCopy.setPos()'

  !!edgCntrl.add(!packet)


endmethod


------------------------------------------------------------------------
--
-- Method: setPos
--
-- Description: Update position gadgets with new position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPos()

  if(!this.newPosition.unset())then
  	return
  endif
  !position    = !this.position.wrt(world)
  !newPosition = !this.newPosition.wrt(world)
  -- calculate the offset
  !diste = !newPosition.east  - !position.east
  !distn = !newPosition.north - !position.north
  !distu = !newPosition.up    - !position.up

  !this.posControl.xyz(!diste, !distn, !distu)

  !this.drawAid()

endmethod
------------------------------------------------------------------------
--
-- Method: drawAid
--
-- Description: Draw Aid to indicate the position of copied branches
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawAid()

  AID CLEAR ALL $!this.aidnumber
  -- Getting Offset
  !eastOffset  = !this.posControl.xyz()[0]
  !northOffset = !this.posControl.xyz()[1]
  !upOffset    = !this.posControl.xyz()[2]
  !noOfCopies  = !this.numberofcopies.val
  if(!this.errorState) then
  	return
  endif
  if(!this.elementOne.val.substring(1,1).neq('/') and !this.elementOne.val.substring(1,1).neq('=') ) then
  	!scopeOfCopy  = object DBREF('/' & !this.elementOne.val)
  else
  	!scopeOfCopy = object DBREF(!this.elementOne.val)
  endif

  !collection  = object COLLECTION()
  !collection.type('RPATH')
  !collection.scope(!scopeOfCopy)
  !collection.filter(object EXPRESSION('TYPE OF OWNER EQ |CWBRAN|'))
  !result   = !collection.results()
  !profile  = object ARRAY()
  do !routePath values !result
    !profile.append(object PATH(!routePath))
    handle (2,836)
    endhandle
  enddo

  do !prof values !profile
    do !unusedIndex  from 1 to !noOfCopies
      -- draw centre line of copied CWAY
      !position = !prof.position()
      !position.east  = !prof.position().east  +  !eastOffset
      !position.north = !prof.position().north +  !northOffset
      !position.up    = !prof.position().up    +  !upOffset
      !prof.position(!position)
      !prof.draw(!this.aidnumber,2,5)
    enddo
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method: dismiss
--
-- Description: dismiss the form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  AID CLEAR ALL $!this.aidnumber
  !!edgCntrl.remove(!this.edgDescription)

endmethod
------------------------------------------------------------------------
--
-- Method: removePenetrations
--
-- Description: deletes the penetration route nodes on newly created CWAY
-- This is because penetrations have to be unique and hence should be created separately
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removePenetrations()

  if !this.peneNodes.set() then
	!temp = !!ce
   -- put to forward mode
   var !mode mode
   forwards

   !sequenceArray = object ARRAY()
   do !node values !this.peneNodes
     -- get the owner list
     !ownList = !node.ownlst

     -- get the sequence start
     !seqStart = object REAL()
     if !this.copyElement.type.eq('ZONE') then
       !seqStart = 3
     elseif !this.copyElement.type.eq('CWAY') then
     	 !seqStart = 4
     elseif !this.copyElement.type.eq('CWBRAN') then
     	 !seqStart = 5
     endif

     -- put sequence numbers into ARRAY
     !sequences  = object ARRAY()
     do !i from !seqStart to !ownList.size()
       !sequences.append(!ownList[!i].sequence)
     enddo

    -- add the sequence of the node
    !sequences.append(!node.sequence)
    !sequenceArray.append(!sequences)

   enddo	

  -- go to copied element
   !deleteArray = object ARRAY()
   do !item values !this.copiedElements
    do !j from 1 to !sequenceArray.size()
      !!ce = !item
      do !k from 1 to !sequenceArray[!j].size()
       -- navigate
       $!sequenceArray[$!j][$!k]
      enddo
      !deleteArray.append(!!ce)
    enddo
   enddo

   -- make double sure and delete
   do !del values !deleteArray
     !!ce = !del
     if !del.rntype.eq('PENE') or !del.rntype.eq('OFFS') then
       delete RNODE

     endif
   enddo

   -- reset mode
   $!mode
	!!ce = !temp
	handle ANY
	endhandle
   -- give a warning that penetrations are not copied
   !!alert.warning('The penetrations are not copied. This needs to be investigated')

  endif

endmethod
------------------------------------------------------------------------
--
-- Method: validateOldName
--
-- Description: validate a old name and check the type
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateOldName(!gadget is GADGET, !typeString is STRING) is BOOLEAN

  !test = !!checkName(!gadget.val, |OLD|)
  if (!test.unset()) then
  	-- reset to the original value when entered form
  	!gadget.val = !this.copyElement.namn
    return false
  endif

  !element = object DBREF(!test)
  if (!element.type.neq(!typeString)) then
    !!alert.warning('Wrong Type.  Please select a $!typeString element.')
    return false
  endif

  -- if !typeString is ZONE see if there are any cway elements under the zone
  if !typeString.eq('ZONE') then
    !col = object COLLECTION()
  	!col.type('CWAY')
  	!col.scope(!test.dbref())
    if !col.results().unset() then
  	  !!alert.error('There are no cableways in the selected zone')
  	  return false
    endif
  endif

  return true

endmethod

------------------------------------------------------------------------
--
-- Method: validateNewName
--
-- Description: validate a new name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateNewName(!gadget is GADGET) is BOOLEAN
  !test = !!checkName(!gadget.val, |NEW|)

  --Update gadget with name
  if(!test.set()) then
    !name       = !test.substring(2)
    !gadget.val = !name
  else
  	!gadget.clear()
  	!gadget.setFocus()
    return false
  endif

  return true

endmethod
