-- Description:    Form to show the cableway fill levels
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cblcwayfilllevelcheck()          -                   Constructor
--  clearGrids()                     -                   clear the grids
--  dismiss()                        -                   dismiss the form
--  drawAids()                       -                   Draw graphical aids on branch
--  exportToExcel()                  -                   Saves the Branch Points grid to an excel file
--  fileName()                       STRING              gets the file name to output the grid data
--  getBranches(STRING)              -                   Sets the Branches available in the grid
--  getConnections(ARRAY)            -                   dismiss the form
--  getFillLevel(ARRAY)              -                   Get fill level values for branch
--  highlightSelectedBranch()        -                   Highlight the selected branch
--  initialise()                     -                   Constructor
--  listCables()                     -
--  loadBranchSelectionGrid(DBREF)   -                   Load the branches into grid
--  navigateToBranch()               -                   Navigate to branch
--  navigateToBranchMember()         -                   navigate to cableway branch element
--  navigateToConnection(STRING)     -                   Navigate to connection
--  rightClickBranchGrid(ARRAY)      -                   set up the popup menus for the grid
--  rightClickFillLevelGrid(ARRAY)   -                   set up the popup menus for the grid
--  sortPoints(ARRAY)                ARRAY               Correctly orders and names points along a Cableway Branch
--
import 'GridControl'
handle any
endhandle

layout form !!cblcwayfilllevelcheck dialog docking

  frame .elementFrame 'Load From'  at xmin ymax width 36
    rToggle .siteToggle 'Site'     at xmin ymax
    rToggle .zoneToggle 'Zone'     at xmax ymin
    rToggle .cwayToggle 'Cableway' at xmax ymin
    rtoggle .branToggle 'Cableway Branch'   at xmax ymin
    button  .refreshGrid           at xmax+7 ymin pixmap width 16 height 16
  exit

  frame .currentBranchFrame 'Current Branch' at xmax+1 ymin anchor t+l+r width 75
    para .currentBranch at xmin ymax+.4 text 'None Defined' width 40
  exit

  frame .cablewayBranchesFrame 'Select Cableway Branch' at xmin.elementFrame ymax+.2  width.elementFrame length 10
    container .selectCablewayBranch PMLNetCONTROL 'NET'  DOCK FILL
  exit

  frame .fillLevelFrame 'Branch Points' at xmax+1 ymin  anchor t+l+r width.currentBranchFrame length.cablewayBranchesFrame
    container .branchFillLevels PMLNetCONTROL 'NET' DOCK FILL
  exit

  button .explainFillLevels 'Explain Fill Levels...' at xmin.fillLevelFrame+33 ymax+.2 anchor t+r linklabel

  frame .connectedBranchFrame 'Connections' at xmin.cablewayBranchesFrame ymax  anchor t+b+l+r width 94 length 2
    para   .connected1        at xmin ymin    text 'Connection 1:'
    button .connected1Button  at xmax ymin-.2 'Select Cableway Branch Point' linklabel width 60
    para   .connected2        at xmin.connected1 ymax+.2 text 'Connection 2:'
    button .connected2Button  at xmax ymin-.2 'Select Cableway Branch Point' linklabel width 60
  exit

  using namespace 'Aveva.Pdms.Presentation'

  -- Grids
  member .cablewayBranchGrid is NETGRIDCONTROL
  member .branchFillLevelGrid is NETGRIDCONTROL

  -- Branch Members
  member .members is ARRAY

  -- Element form initialised
  member .element is DBREF

  -- Aids
  member .hattaAidNumber is REAL
  member .rnodeAidNumber is REAL
  member .rattaAidNumber is REAL
  member .tattaAidNumber is REAL

  -- highlighting
  member .enhanced is COMENHANCE

  menu .popMenuBranchSelection
  !this.popMenuBranchSelection.add( 'CALLBACK', 'Navigate to...', '!this.navigateToBranch()')
  !this.popMenuBranchSelection.add( 'TOGGLE', 'Highlight', '!this.highlightSelectedBranch()', 'HIGHLIGHT')

  menu .popMenuFillLevel
  !this.popMenuFillLevel.add( 'CALLBACK', 'Navigate to...', '!this.navigateToBranchMember()' )
  !this.popMenuFillLevel.add( 'CALLBACK', 'List of Cables', '!this.listCables()' )
  !this.popMenuFillLevel.add( 'CALLBACK', 'Export to Excel...', '!this.exportToExcel()' )


exit
------------------------------------------------------------------------
--
-- Method:   cblcwayfilllevelcheck()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblcwayfilllevelcheck()

  !this.formTitle = 'Fill Level Check'
  !this.quitcall   = |!this.dismiss()|
  !this.callback   = |!this.initialise()|
  !this.siteToggle.callback  = '!this.getBranches(|SITE|)'
  !this.zoneToggle.callback  = '!this.getBranches(|ZONE|)'
  !this.cwayToggle.callback  = '!this.getBranches(|CWAY|)'
  !this.branToggle.callback  = '!this.getBranches(|CWBRAN|)'
  !this.explainFillLevels.callback = 'show !!cblcwayfilllevels'
  !this.connected1Button.callback = '!this.navigateToConnection(|CONN1|)'
  !this.connected2Button.callback = '!this.navigateToConnection(|CONN2|)'
  !this.refreshGrid.callback = '!this.initialise()'
  !this.refreshGrid.setTooltip('Refresh Grid')
  !this.refreshGrid.addPixmap(!!pml.getPathName(|refresh16.png|))

  if (undefined(!!cblDflts)) then
    pml load form !!cblDflts
    !!cblDflts.init()
  endif
     !!cblDflts.init()
  using namespace 'Aveva.Pdms.Presentation'

  -- create instance of .Net control
  !this.cablewayBranchGrid  = object NETGRIDCONTROL()
  !this.branchFillLevelGrid = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control
  !this.cablewayBranchGrid.addEventHandler('AfterSelectChange', !this, 'getFillLevel')
  !this.cablewayBranchGrid.addEventHandler('OnPopup', !this, 'rightClickBranchGrid')

  !this.branchFillLevelGrid.addEventHandler('AfterSelectChange', !this, 'getConnections')
  !this.branchFillLevelGrid.addEventHandler('OnPopup', !this, 'rightClickFillLevelGrid')

  -- add .Net control to PML container
  !this.selectCablewayBranch.control = !this.cablewayBranchGrid.handle()
  !this.branchFillLevels.control = !this.branchFillLevelGrid.handle()

  -- configure grid presentation
  -- Cableway Branches Grid
  !this.cablewayBranchGrid.fixedHeaders(false)
  !this.cablewayBranchGrid.outlookGroupStyle(FALSE)
  !this.cablewayBranchGrid.columnExcelFilter(FALSE)
  !this.cablewayBranchGrid.headerSort(true)
  !this.cablewayBranchGrid.columnSummaries(false)
  !this.cablewayBranchGrid.singleRowSelection(true)
  !this.cablewayBranchGrid.setAlternateRowColor('WHITE')
  -- Branch Fill Level Grid
  !this.branchFillLevelGrid.fixedHeaders(false)
  !this.branchFillLevelGrid.outlookGroupStyle(FALSE)
  !this.branchFillLevelGrid.columnExcelFilter(FALSE)
  !this.branchFillLevelGrid.headerSort(true)
  !this.branchFillLevelGrid.columnSummaries(false)
  !this.branchFillLevelGrid.singleRowSelection(true)
  !this.branchFillLevelGrid.setAlternateRowColor('WHITE')

  -- Set aid numbers
  !this.hattaAidNumber = !!aidNumbers.add('HEAD')
  !this.rnodeAidNumber = !!aidNumbers.add('RNODE')
  !this.rattaAidNumber = !!aidNumbers.add('RATTA')
  !this.tattaAidNumber = !!aidNumbers.add('TAIL')

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   initialise()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.members.clear()
  !this.cablewayBranchGrid.clearGrid()
  !this.branchFillLevelGrid.clearGrid()
  !this.connected1Button.active = FALSE
  !this.connected2Button.active = FALSE

  !this.element = !!ce

  -- load the grid with data
  if (!!ce.type eq 'WORL') then
      !!alert.message('Cannot run fill level check at world level.')
  elseif (!!ce.type eq 'SITE') then
    !this.getBranches('SITE')
    !this.siteToggle.val = TRUE
  elseif (!!ce.type eq 'ZONE') then
    !this.getBranches('ZONE')
    !this.zoneToggle.val = TRUE
  elseif (!!ce.type eq 'CWAY')  then
    !this.getBranches('CWAY')
    !this.cwayToggle.val = TRUE
  elseif (!!ce.type eq 'CWBRAN'  or !!ce.owner.type eq 'CWBRAN' or !!ce.owner.owner.type eq 'CWBRAN' or !!ce.owner.owner.owner.type eq 'CWBRAN') then
      !this.getBranches('CWBRAN')
      !this.branToggle.val = TRUE
  else
      !!alert.error('Navigate to site, zone, cableway or element owner of type cable to run fill level check.')
  endif


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getBranches
--
-- Description: Sets the Branches available in the grid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBranches(!value is STRING)

  if (!value eq 'SITE') then
    !selection = SITE
    handle ANY
      !!alert.message('Navigate to a site and refresh the grid.')
      !this.clearGrids()
      return
    endhandle
  elseif (!value eq 'ZONE') then
    !selection = ZONE
    handle ANY
      !!alert.message('Navigate to a zone and refresh the grid')
      !this.clearGrids()
      return
    endhandle
  elseif (!value eq 'CWAY') then
    !selection = CWAY
    handle ANY
      !!alert.message('Navigate to a cableway and refresh the grid')
      !this.clearGrids()
      return
    endhandle
  elseif (!value eq 'CWBRAN') then
      !selection = CWBRAN
      handle any
          !!alert.message('Navigate to a cableway branch and refresh the grid')
          !this.clearGrids()
          return
      endhandle
  endif

  -- load Data
  !this.loadBranchSelectionGrid(!selection)


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   loadBranchSelectionGrid()
--
-- Description: Load the branches into grid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadBranchSelectionGrid(!type is DBREF)

  !col = object COLLECTION()
  !col.scope(!type)
  !col.type('CWBRAN')
  !branches = !col.results()
  !cwayBranches = object ARRAY()
  do !branch values !branches
    !row[1] = !branch.flnm
    !row[2] = !branch.maxfil
    !cwayBranches.append(!row)
  enddo
  !headings = object ARRAY()
  !headings.append('Cableway Branch')
  !headings.append('Max Fill Level')

  -- define data source and bind to the grid
  !gridName = 'Branch'
  using namespace  'Aveva.Pdms.Presentation'

  !nds = object NETDATASOURCE(!gridName, !headings, !cwayBranches)
  !this.cablewayBranchGrid.bindToDataSource(!nds)

  -- Select first row in the list
  !this.cablewayBranchGrid.selectRow(1)
  !this.currentBranch.val = !this.cablewayBranchGrid.getSelectedRows()[1][1]
  handle ANY
  endhandle


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   getFillLevel()
--
-- Description: Get fill level values for branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getFillLevel(!branch is ARRAY)

  !this.connected1Button.tag = 'No Connections Associated'
  !this.connected2Button.tag = 'No Connections Associated'
  !this.connected1Button.active = FALSE
  !this.connected2Button.active = FALSE
  !this.currentBranch.val = !this.cablewayBranchGrid.getSelectedRows()[1][1]
  handle ANY
    return
  endhandle
  !selectedRow = !this.cablewayBranchGrid.getSelectedRows()[1]
  handle ANY
    return
  endhandle

  !element = !selectedRow[1].dbref()
  handle ANY
    return
  endhandle

  !col = object COLLECTION()
  !col.scope(!element)
  !col.type('TATTA')
  !col.addType('HATTA')
  !col.addType('RATTA')
  !col.addType('RNODE')
  !collection = !col.results()
  !this.members = ARRAY()
  !members = !collection
  !list = !this.sortPoints(!members)
  !rows = ARRAY()
  !currentElement = !!ce
  do !i indices !list

    !row = ARRAY()
    !row.append(!list[!i][1])
    !element = !list[!i][2]
    !this.members.append(!element)
    if (!element.type eq 'HATTA') then
      !!ce = !element
      var !fLevel fLevel(0)
      !fL = !fLevel.real()
      !fLevel = !fL.string(!!realFmt)
      !row.append('-')
      !row.append(!fLevel)
      !row.append('-')
      !row.append('-')
      !row.append('-')
      !row.append('-')

    elseif (!element.type eq 'RNODE') then
      !!ce = !element
      var !fLevel  fLevel(0)
      var !fLevel1 fLevel(1)
      var !fLevel2 fLevel(2)
      var !fLevel3 fLevel(3)
      !fL = !fLevel.real()
      !fL1 = !fLevel1.real()
      !fL2 = !fLevel2.real()
      !fL3 = !fLevel3.real()
      !fLevel = !fL.string(!!realFmt)
      !fLevel1 = !fL1.string(!!realFmt)
      !fLevel2 = !fL2.string(!!realFmt)
      !fLevel3 = !fL3.string(!!realFmt)
      !row.append(!element.rnType)
      !row.append(!fLevel)
      !row.append(!fLevel1)
      !row.append(!fLevel2)
      !row.append(!fLevel3)
      !row.append('-')
    elseif (!element.type eq 'RATTA') then
      !!ce = !element
      var !fLevel  fLevel(0)
      var !fLevel1 fLevel(1)
      var !fLevel2 fLevel(2)
      var !fLevel3 fLevel(3)
      !fL = !fLevel.real()
      !fL1 = !fLevel1.real()
      !fL2 = !fLevel2.real()
      !fL3 = !fLevel3.real()
      !fLevel = !fL.string(!!realFmt)
      !fLevel1 = !fL1.string(!!realFmt)
      !fLevel2 = !fL2.string(!!realFmt)
      !fLevel3 = !fL3.string(!!realFmt)
      !row.append('-')
      !row.append(!fLevel)
      !row.append(!fLevel1)
      !row.append(!fLevel2)
      !connection = !element.atconn
      if (!connection.size() leq 1) then
        !row.append(!fLevel3)
        !row.append('-')
      elseif (!connection.size() gt 1) then
        var !fLevel4 fLevel(4)
        !fL4 = !fLevel4.real()
        !fLevel4 = !fL4.string(!!realFmt)
        !row.append(!fLevel3)
        !row.append(!fLevel4)
      endif
    elseif (!element.type eq 'TATTA') then
      !!ce = !element
      var !fLevel fLevel(0)
      !fL = !fLevel.real()
      !fLevel = !fL.string(!!realFmt)
      !row.append('-')
      !row.append(!fLevel)
      !row.append('-')
      !row.append('-')
      !row.append('-')
      !row.append('-')
    endif
    !rows.append(!row)
  enddo

  !!ce = !currentElement

  !headings = object ARRAY()
  !headings.append('NAME')
  !headings.append('TYPE')
  !headings.append('FLEVEL')
  !headings.append('FLEVEL 1')
  !headings.append('FLEVEL 2')
  !headings.append('FLEVEL 3')
  !headings.append('FLEVEL 4')

  -- define data source and bind to the grid
  !gridName = 'Fill'
  using namespace  'Aveva.Pdms.Presentation'

  !nds = object NETDATASOURCE(!gridName, !headings, !rows)
  !this.branchFillLevelGrid.bindToDataSource(!nds)
  !this.branchFillLevelGrid.autoFitColumns()

  !maxFill =  !this.cablewayBranchGrid.getSelectedRows()[1][1].dbref().maxfil.real()

  !dfltsFillCheckAllowance = !!cblDflts.cwbranFillCheckAllowance

  do !rowIndex indices !rows
    do !columnIndex from 3 to !rows[!rowIndex].size()

      if (!rows[!rowIndex][!columnIndex] eq '-') then
          !this.branchFillLevelGrid.setCellColor(!rowIndex , !columnIndex , 'white')
      elseif (!rows[!rowIndex][!columnIndex].real() lt (!maxFill - !dfltsFillCheckAllowance)) then
          !this.branchFillLevelGrid.setCellColor(!rowIndex , !columnIndex , 'greenyellow')
      elseif (!rows[!rowIndex][!columnIndex].real() gt !maxFill) then
          !this.branchFillLevelGrid.setCellColor(!rowIndex , !columnIndex , 'orangered')
      else
          !this.branchFillLevelGrid.setCellColor(!rowIndex , !columnIndex , 'yellow')
      endif

    enddo
  enddo

  if (!this.element.type eq 'HATTA' or !this.element.type eq 'TATTA' or !this.element.type eq 'RNODE' or !this.element.type eq 'RATTA') then
      !rowElement = !this.members.findFirst(!this.element)
      !this.branchFillLevelGrid.selectRow(!rowElement)
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: sortPoints
--
-- Description: Correctly orders and names points along a Cableway Branch
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    RW     ARRAY       DBREFs of the points along the Cableway Branch
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .sortPoints(!points is ARRAY) is ARRAY

  -- Put points in the correct order
  !order = object ARRAY()
  !distance = object ARRAY()
  !hatta = object DBREF()
  !tatta = object DBREF()
  do !node values !points
    if (!node.type.eq('HATTA')) then
      !hatta = !node
    elseif (!node.type.eq('TATTA')) then
      !tatta = !node
    else
      !order.append(!node)
      !distance.append(!node.distfh[1])
    endif
  enddo
  !sort = !distance.sortedindices()
  !order.reindex(!sort)
  if (!hatta.set() and !tatta.set()) then
    !order.insert(1, !hatta)
    !order.append(!tatta)
  endif
  !points = !order

  -- Rename the points
  !linesArray = object ARRAY()
  do !i from 1 to !points.size()
    !pointName = !points[!i].flnn
    !seq = !points[!i].tysequ

    if(!points[!i].isNamed.not()) then

      if(!points[!i].type eq 'TATTA')then
        !pointType = 'TAIL'
      elseif(!points[!i].type eq 'HATTA')then
        !pointType = 'HEAD'
      elseif(!points[!i].type eq 'RATTA')then
        !pointType = 'RATTA $!seq'
      elseif(!points[!i].type eq 'RNODE')then
        !pointType = 'RNODE $!seq'
      endif

      !pointName = !pointName.replace(!pointName, !pointType)

    endif

    !line = ARRAY()
    !line.append(!pointName)
    !line.append(!points[!i])
    !linesArray.append(!line)
  enddo

  -- Return the array
  return !linesArray

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      rightClickBranchGrid
--
-- Description: set up the popup menus for the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rightClickBranchGrid(!a is ARRAY)

  if (!this.cablewayBranchGrid.getSelectedRows().set()) then
    !enhanced = !this.enhanced.getEnhancedElements(!this.cablewayBranchGrid.getSelectedRows()[1][1].dbref())
    !this.popMenuBranchSelection.setFieldProperty('HIGHLIGHT','SELECTED',!enhanced)

    !this.selectCablewayBranch.popup = !this.popMenuBranchSelection
    !this.selectCablewayBranch.showPopup(!a[0], !a[1])
  endif


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      rightClickFillLevelGrid
--
-- Description: set up the popup menus for the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rightClickFillLevelGrid(!a is ARRAY)

  if (!this.branchFillLevelGrid.getSelectedRows().set()) then
    !this.branchFillLevels.popup = !this.popMenuFillLevel
    !this.branchFillLevels.showPopup(!a[0], !a[1])
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   listCables()
--
-- Description: initialise list of cables form on element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .listCables()

  !element = !!ce
  !this.navigateToBranchMember()

  if (defined (!!cbllistcables)) then
      show !!cbllistcables
      !!cbllistcables.init()
  else
      show !!cbllistcables
  endif

  !!ce = !element

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   getConnections()
--
-- Description: dismiss the form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getConnections(!branch is ARRAY)

  -- Set current element to set back later
  !element = !!ce

  !row = !this.branchFillLevelGrid.getSelectedRowTags()[1]
  handle any
    return
  endhandle
  !!ce = !this.members[!row.real()]

  !this.drawAids()

  if (!!ce.type eq 'RATTA' or !!ce.type eq 'TATTA' or !!ce.type eq 'HATTA') then
    !connection = !!ce.conats
    !conn1 = !connection[1].flnm
    handle any
      !conn1 = 'No Connections Associated'
    endhandle
    !conn2 = !connection[2].flnm
    handle any
      !conn2 = 'No Connections Associated'
    endhandle

    if (!conn1 eq 'No Connections Associated') then
        !this.connected1Button.active = FALSE
    else
        !this.connected1Button.active = TRUE
    endif
    if (!conn2 eq 'No Connections Associated') then
        !this.connected2Button.active = FALSE
    else
      !this.connected2Button.active = TRUE
    endif

    !this.connected1Button.tag = !conn1
    !this.connected2Button.tag = !conn2

  elseif (!!ce.type eq 'RNODE') then
    !this.connected1Button.tag = 'No Connections Associated'
    !this.connected2Button.tag = 'No Connections Associated'
    !this.connected1Button.active = FALSE
    !this.connected2Button.active = FALSE

  endif

  !!ce = !element

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   drawAids()
--
-- Description: Draw graphical aids on branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawAids()

  !!aidNumbers.remove(!this.hattaAidNumber)
  !!aidNumbers.remove(!this.rnodeAidNumber)
  !!aidNumbers.remove(!this.rattaAidNumber)
  !!aidNumbers.remove(!this.tattaAidNumber)

  if (!!ce.type eq 'HATTA') then
      !pos = !!ce.pos
      AID TEXT NUMBER $!<this.hattaAidNumber> 'HEAD' AT $!pos

  elseif (!!ce.type eq 'RNODE') then
      !pos = !!ce.pos
    if (!!ce.isNamed) then
          AID TEXT NUMBER $!<this.rnodeAidNumber> '$!!ce.flnn' AT $!pos
      else
          AID TEXT NUMBER $!<this.rnodeAidNumber> 'RNODE $!!ce.tysequ' AT $!pos
      endif

  elseif (!!ce.type eq 'RATTA') then
      !pos = !!ce.pos
    if (!!ce.isNamed) then
          AID TEXT NUMBER $!<this.rattaAidNumber> '$!!ce.flnn' AT $!pos
    else
          AID TEXT NUMBER $!<this.rattaAidNumber> 'RATTA $!!ce.tysequ' AT $!pos
      endif

  elseif (!!ce.type eq 'TATTA') then
      !pos = !!ce.pos
      AID TEXT NUMBER $!<this.tattaAidNumber> 'TAIL' AT $!pos

  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   highlightSelectedBranch()
--
-- Description: Highlight the selected branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightSelectedBranch()

  if (!this.popMenuBranchSelection.selected('HIGHLIGHT')) then
    !this.enhanced.clear()
    !branch = !this.cablewayBranchGrid.getSelectedRows()[1][1].dbref()
    !this.enhanced.addItem(!branch)
  else
      !this.enhanced.clear()
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   navigateToBranch()
--
-- Description: Navigate to branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateToBranch()

  !!ce =  !this.cablewayBranchGrid.getSelectedRows()[1][1].dbref()

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:  navigateToBranchMember
--
-- Description: navigate to cableway branch element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateToBranchMember()

  !row = !this.branchFillLevelGrid.getSelectedRowTags()[1]
  !!ce = !this.members[!row.real()]

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   navigateToConnection()
--
-- Description: Navigate to connection
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateToConnection(!type is STRING)

  if (!type eq 'CONN1') then
      !!ce = !this.connected1Button.tag.dbref()
  elseif (!type eq 'CONN2') then
      !!ce = !this.connected2Button.tag.dbref()
  endif

  !this.initialise()

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   clearGrids()
--
-- Description: clear the grids
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearGrids()

  !this.cablewayBranchGrid.clearGrid()
  !this.branchFillLevelGrid.clearGrid()
  !this.currentBranch.val = 'None Defined'

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:   dismiss()
--
-- Description: dismiss the form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dismiss()

  !this.hide()
  !this.enhanced.clear()
  !!aidNumbers.remove(!this.hattaAidNumber)
  !!aidNumbers.remove(!this.rnodeAidNumber)
  !!aidNumbers.remove(!this.rattaAidNumber)
  !!aidNumbers.remove(!this.tattaAidNumber)

endmethod
---------------------------------------------------------------------------
--
-- Method:      exportToExcel
--
-- Description: Saves the Branch Points grid to an excel file
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exportToExcel()

    !fileName = !this.fileName()
    !!exportToExcel(!this.branchFillLevelGrid, !fileName, 'Save As')

endmethod
--End of method definition .exportToExcel()
---------------------------------------------------------------------------
--
-- Method:      fileName
--
-- Description: gets the file name to output the grid data
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fileName() is STRING

  !clock     = object DATETIME()
  !time      = !clock.string()
  !time      = !time.replace(':','-')
  !fileName  = |$!this.currentBranch.val - Fill Level | & !time & |.xls|

  return !fileName

endmethod
--End of method definition .fileName()
