------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cblcwayfilllevels()              -
--  dismiss()                        -
--

layout form !!cblcwayfilllevels

  frame .rattaFrame 'RATTA' at xmin ymax
    para .ratta at xmin ymax pixmap height 310 width 550
  exit

  frame .rnodeFrame 'RNODE' at xmin ymax
    para .rnode at xmin ymax pixmap height 310 width 550
  exit
exit

------------------------------------------------------------------------
define method .cblcwayfilllevels()

  !this.formTitle = 'Fill Levels'
  !this.quitcall   = |!this.dismiss()|

  !this.ratta.addPixmap(!!pml.getPathName('rattafillcheck.png'))
  !this.rnode.addPixmap(!!pml.getPathName('rnodefillcheck.png'))

endmethod
-------------------------------------------------------------------------
define method .dismiss()

  !this.hide()

endmethod
