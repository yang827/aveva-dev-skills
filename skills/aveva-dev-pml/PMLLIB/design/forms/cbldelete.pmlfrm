-- Replaces:
--
-- Author:         Anand Kalathil
-- Created:        Mon Jun 02 2008
-- Last Modified:
-- Description:
-- cableway elements deletion form
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbldelete()                      -                   Constructor
--  dbDelete()                       -                   deletes the selected element
--  updateArea()                     -                   updates the area selection depending on element selection
--  updateScope()                    -                   updates the scope of selection
--


setup form !!cbldelete dialog dock right

  track    'DESICE'    callback '!this.updateScope()'

  paragraph .selectElement       anchor l+t       at x0.1       ymax      text  'Select Element type to delete...' width 35
  line      .selectElementLine   anchor l+t       at x0         ymax      horizontal  width 35

  frame .elementOptions  at x1 ymax width 33
   rtoggle .ctmtrlSelect  |Material|   anchor l+t     at x1.5 ymax
   rtoggle .cwbranSelect  |Branch|     anchor l+t     at x1.5 ymax
   rtoggle .cwaySelect    |Cableway|   anchor l+t     at x1.5 ymax
   rtoggle .cableSelect   |Cable|      anchor l+t     at x1.5 ymax

  exit

  paragraph .selectArea       anchor l+t       at x0.1       ymax      text  'Delete from current...' width 35
  line      .selectAreaLine   anchor l+t       at x0         ymax      horizontal  width 35

  frame .areaOptions  at x1 ymax width 33
   rtoggle .ceArea      |Element|    anchor l+t     at x1.5 ymax
   rtoggle .cwbranArea  |Branch|     anchor l+t     at x1.5 ymax
   rtoggle .cwayArea    |Cableway|   anchor l+t     at x1.5 ymax
   rtoggle .zoneArea    |Zone|       anchor l+t     at x1.5 ymax
   rtoggle .siteArea    |Site|       anchor l+t     at x1.5 ymax
  exit

  paragraph .deleteButIcon anchor l+t    at x1 ymax+1       pixmap width 16 height 16
  button    .deleteBut       linklabel  'Delete'           anchor l+t    at xmax+1       ymin       callback '!this.dbDelete()'

  -- selected item
  member  .deleteElement     is STRING

  -- selected area
  member  .scope             is DBREF

  !this.formtitle = 'Delete Cabling Elements'


exit

-------------------------------------------------------------------------

-- Method:   cbldelete()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .cbldelete()

 !cableexist   = object MDRLICENCEMANAGER()
  if !cableexist.hascablinglicence('CABLES').not() then
  	!this.cableSelect.active = FALSE
  endif
 !deleteIcon     = !!pml.getPathname('deletece16.png')
 !this.deleteButIcon.addPixmap(!deleteIcon)
 !this.elementOptions.callback = '!this.updateArea()'
 !this.areaOptions.callback   = '!this.updateScope()'
 !this.elementOptions.val  = 1
 !this.updateArea()

endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method:   updateArea()
--
-- Description: updates the area selection depending on element selection
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .updateArea()

  !this.areaOptions.val    = 1

  -- reset active state
  !this.cwbranArea.active   = TRUE
  !this.cwayArea.active     = TRUE
  !this.zoneArea.active     = TRUE
  !this.siteArea.active     = TRUE

  if !this.elementOptions.val.eq(3) then
   !this.cwbranArea.active   = FALSE
  elseif !this.elementOptions.val.eq(4) then
   !this.cwbranArea.active   = FALSE
  !this.cwayArea.active      = FALSE	
  endif

  !this.updateScope()


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:   updateScope()
--
-- Description: updates the scope of selection
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .updateScope()

  -- update element type
  if !this.elementOptions.val.eq(1) then
    !this.deleteElement  = 'CTMTRL'
  elseif !this.elementOptions.val.eq(2) then
    !this.deleteElement  = 'CWBRAN'
  elseif !this.elementOptions.val.eq(3) then
    !this.deleteElement  = 'CWAY'
  elseif !this.elementOptions.val.eq(4) then
    !this.deleteElement  = 'CABLE'
  endif

  --update scope
  if !this.areaOptions.val.eq(1) then
    !scope   = !!ce
  elseif !this.areaOptions.val.eq(2) then
    !scope   = CWBRAN
    handle (2,111)
     !!alert.warning('Cannot select branch from current position. Setting the scope to current element')
     !this.ceArea.val = TRUE
     !scope = !!ce
    endhandle
  elseif !this.areaOptions.val.eq(3) then
    !scope   = CWAY
    handle (2,111)
     !!alert.warning('Cannot select Cableway from current position. Setting the scope to current element')
     !this.ceArea.val = TRUE
     !scope = !!ce
    endhandle
  elseif !this.areaOptions.val.eq(4) then
    !scope   = ZONE
    handle (2,111)
     !!alert.warning('Cannot select zone from current position. Setting the scope to current element')
     !this.ceArea.val = TRUE
     !scope = !!ce
    endhandle
  elseif !this.areaOptions.val.eq(5) then
    !scope   = SITE
    handle (2,111)
     !!alert.warning('Cannot select site from current position. Setting the scope to current element')
     !this.ceArea.val = TRUE
     !scope = !!ce
    endhandle
  endif

  !this.scope = !scope

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:   dbDelete()
--
-- Description: deletes the selected element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .dbDelete()

 -- confirmation flag
 !flag = TRUE

 !col = object COLLECTION()
 !col.type(!this.deleteElement)
 !col.scope(!this.scope)
 !elements = !col.results()

 if !elements.unset() then
  !!alert.error('No $!this.deleteElement available in current scope')
  return
 endif

 -- see if there are cables on the selection
 !cwbranArray = object ARRAY()
 do !item values !elements
   if !item.type.eq('CTMTRL') then
   	!cwbranArray.append(!item.owner)
   elseif !item.type.eq('CWBRAN') then
   	!cwbranArray.append(!item)
   elseif !item.type.eq('CWAY') then
   	!brancol = object COLLECTION()
   	!brancol.type('CWBRAN')
   	!brancol.scope(!item)
   	do !bran values !brancol.results()
   	 !cwbranArray.append(!bran)
   	enddo	
   endif
 enddo

 do !cable values !cwbranArray
   if !cable.clist[0].set() then
    !confirm = !!alert.confirm('There are cables running on $!cable.flnn , Still delete $!this.deleteElement $
                                from $!this.scope.flnm ?. The cable routing status will be set to unrouted')
    if !confirm.eq('NO') then
      return
    else
      !flag = FALSE
      break
    endif
   endif
 enddo

 if !flag.not() then
   -- put cables into an array
   !cableList = object ARRAY()
   do !bran values !cwbranArray
     if !bran.clist[0].set() then
      do !i values !bran.clist[0]
       !cableList.append(!i)
      enddo
     endif
   enddo
   -- see if there is write access
   do !access values !cableList
    if !!dbRefUpdatable(!access).not() then
      !!alert.error('There are cables running in the branch for which there is no access rights. $
                     Aborting delete operation')
      return
    endif
   enddo

 endif


 if !flag then
   !confirm = !!alert.confirm('OK to delete $!this.deleteElement from $!this.scope.flnm ?')
   if !confirm.eq('NO') then
     return
   endif	
 endif

  -- Mark database
 !undo               = object UNDOABLE()
 !undo.description('Delete cabling elements')
 !undo.add()

 do !del values !elements
  !!ce = !del
  !type = !!ce.type
  delete $!type
 enddo
 -- End undo mark
 !undo.endUndoable()


endmethod
--End of method definition
