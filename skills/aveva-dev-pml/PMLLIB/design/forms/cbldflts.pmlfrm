-- Description:
-- Cableway defaults form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addIclass(GADGET,STRING)         -                   adds the user interference class to gadget
--  cblDflts()                       -                   Constructor
--  dismiss()                        -
--  init()                           -                   Dismiss form
--  loadIclass()                     -                   loads the interference class from cable property db
--  readSettings()                   -                   writes default values to file
--  removeIclass(GADGET)             -                   removes the selected iclass
--  setFillCheckAllowance()          -                   set cableway fill check tolerance for fill level check form.
--  setautoRoutingOptions()          -                   set Auto Routing Options
--  setdfltmembers()                 -                   sets the default members
--  setupSpecs()                     -                   Setup Specifications
--  setupStorage()                   -
--  validate(GADGET,STRING,STRING)   -                   Validate entry
--  writeSettings()                  -                   writes default values to file
--


setup form !!cblDflts dialog resizeable

  -- Form details
  !this.formTitle    = 'Cabling Application Defaults'
  !this.icontitle    = ||
  !this.formrevision = | $Revision: 1.0 $ |
  !this.quitcall   = |!this.dismiss()|
  !this.initcall   = |!!cblDflts.init()|

  frame .zonetab 'Storage Areas' anchor l+r+t at x0 ymax
    paragraph .cwayzonepara  anchor l+t    at x1 ymax    text   'CableWay :         '
    option    .cwayzone      anchor l+r+t  at xmax ymin  callback '' width 25

    paragraph .cablezonepara anchor l+t    at x1 ymax    text  'Cable :            '
    option    .cablezone     anchor l+r+t  at xmax ymin  callback '' width 25

  exit
  frame .cbldattab 'Cable Data' anchor l+r+t at x0 ymax

    paragraph .cexesTag                             anchor l+t     at x1          ymax       width 19
    paragraph .cexesTagHead                         anchor l+t     at xmax        ymin      text  'Head'                            width 4
    text      .cexes1                               anchor l+t     at xmax+1      ymin  callback '!!gdgtDatChk(!this.cexes1)'       width 10 is REAL format !!distanceFmt
    text      .cexes2                               anchor l+t     at xmax+1.3    ymin  callback '!!gdgtDatChk(!this.cexes2)'       width 10 is REAL format !!distanceFmt
    paragraph .cexesTagTail                         anchor l+t     at xmin.cexesTagHead ymax+0.1  text  'Tail'                      width 4
    text      .cexes3                               anchor l+t     at xmax+1      ymin  callback '!!gdgtDatChk(!this.cexes3)'       width 10 is REAL format !!distanceFmt
    text      .cexes4                               anchor l+t     at xmax+1.3    ymin  callback '!!gdgtDatChk(!this.cexes4)'       width 10 is REAL format !!distanceFmt
    paragraph .cableProximityTag                    anchor l+t     at x1          ymax                                                      width 13 lines 1
    text      .cableProximity                       anchor l+t     at xmax+6      ymin+0.1 callback '!!gdgtDatChk(!this.cableProximity)'    width 15 is REAL format !!distanceFmt
    option    .cableFillLevel 'Fill Check:       '         anchor l+t     at x1          ymax+0.1  call '' width 25

  exit
  frame .spectab 'Specifications' anchor l+r+t at x0 ymax

    paragraph .cwmtrlspecpara anchor l+t at x1 ymax text 'CableWay Material :'
    option .cwmtrlspec anchor l+r+t at xmax ymin callback '' width 25
    paragraph .cablespecpara anchor l+t at x1 ymax text  'Cable :            '
    option .cablespec anchor l+r+t at xmax ymin callback '' width 25
    option .systemReference 'System Ref:       '   anchor l+t at x1 ymax callback '' width 25

    paragraph .gaps at x1 ymax text 'Gaps :' width 5
    path right
    toggle .useGaps 'Use' tagwidth 3 at xmax+0.1 ymin
    text .firstGap        callback'!!gdgtDatChk(!this.firstGap)'        at xmax+0.5 ymin+0.1 tagwid 4 'First'  width 7 is REAL format !!distanceFmt
    text .intermediateGap callback'!!gdgtDatChk(!this.intermediateGap)' at xmax+0.3 ymin     tagwid 4 'Inter'  width 7 is REAL format !!distanceFmt
    text .lastGap         callback'!!gdgtDatChk(!this.lastGap)'         at xmax+0.3 ymin     tagwid 4 'Last'   width 7 is REAL format !!distanceFmt

    paragraph .minLengthCableTrayStraightTag       anchor l+t       at x1 ymax+0.1  text  'Minimum Length Straight Tray:' width 20
    text      .minLengthCableTrayStraight          anchor l+r+t     at xmax ymin  callback '' width 14 is REAL format !!distanceFmt

  exit
  frame .cwaysize 'Cableway Data' anchor l+r+t at x0 ymax

    paragraph .cwbranwidthTag           anchor l+r+t       at x1          ymax+0.1     text  'Width :            '
    text      .cwbranwidth              anchor l+r+t       at xmax+0.1    ymin         callback '!!gdgtDatChk(!this.cwbranwidth)' width 27 is REAL format !!distanceFmt
    paragraph .cwbranheightTag          anchor l+r+t       at x1          ymax+0.1     text  'Height :           '
    text      .cwbranheight             anchor l+r+t       at xmax+0.1    ymin         callback '!!gdgtDatChk(!this.cwbranheight)' width 27 is REAL format !!distanceFmt
    paragraph .cwbrancexsTag            anchor l+r+t       at x1          ymax+0.1     text  'Cable Excess (%) : '
    text      .cwbrancexss              anchor l+r+t       at xmax+0.1    ymin         callback '!!gdgtDatChk(!this.cwbrancexss)' width 27 is REAL
    paragraph .cwbranmaxfillTag         anchor l+r+t       at x1          ymax+0.1     text  'Maximum Fill (%) : '
    text      .cwbranmaxfill            anchor l+r+t       at xmax+0.1    ymin         callback '!!gdgtDatChk(!this.cwbranmaxfill)' width 27 is REAL
    para      .fillLevelAllowance       anchor l+t         at x1          ymax+.2      text  'Fill Check Utility Allowance:' width 20
    text      .fillCheckAllowance       anchor l+t+r       at xmax-.9     ymin         callback '!this.setFillCheckAllowance()' width 8 is REAL format !!realFmt
    paragraph .cwbranIclassTag          anchor l+t         at x1          ymax+0.1     text  'Interference Class:'
    combobox  .cwbranIclass             anchor l+r+t       at xmin.cwbranmaxfill ymin  callback '!this.addIclass('  width 12
    button    .iclassLoad   linklabel 'Load' anchor r+t    at xmax+1      ymin     callback  '!this.loadIclass()' width 4 tooltip 'Load standard Interference codes from Properties DB'
    paragraph .cwbranRnodeTag          anchor l+t         at x1          ymax+0.1     text  'Create Ends RNODEs:'
    toggle .cwbranRnode '' tagwidth 6 at xmax+0.1 ymin
  exit

  path down

  frame .autoRoutingOptions 'Auto Routing criteria: ' anchor l+r+t at x0 ymax
    path right
    rtoggle .minimiseFreeRoute   'minimise free route' tooltip'This option will route the cable to/from the closest valid entry/exit point, finding the shortest path through the cableway branches'
    rtoggle .minimiseTotalLength 'minimise total length' tooltip'This option will find the shortest possible route between the start and end points, using any of the valid entry/exit points within the RANEQUIP range to minimise the length i.e. not necessarily using the closest points'
  exit

  path down

  button   .apply   '  OK  ' at x0     ymax callback '!this.setdfltmembers()'
  button   .dismiss 'Cancel' anchor r+t at xmax form-size ymin   callback '!this.dismiss()'

   --Default members
   member .cwayzonedefault      is DBREF
   member .cablezonedefault     is DBREF
   member .cablespecdefault     is DBREF
   member .cablesysrefdefault   is DBREF
   member .cwaymatspecdefault   is DBREF
   member .cwbranvwidth         is REAL
   member .cwbranvheight        is REAL
   member .cwbrancexs           is REAL
   member .cwbranmaxfil         is REAL
   member .autoRoutingMode      is BOOLEAN
   member .helpCableTrayManager is CABLETRAYMANAGER
   member .cableManager         is CABLEMANAGER
   member .cwbranRnodeCreation  is BOOLEAN
   member .cwbranfillcheckallowance is REAL
   member .cableFillLevelCheck  is BOOLEAN

   -- first loading
   member .write              is BOOLEAN

   -- interference class
   member .dinter             is ARRAY

exit


------------------------------------------------------------------------
--
-- Method:   cblDflts()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .cblDflts()

    !cableExist   = object MDRLICENCEMANAGER()
    !this.autoRoutingOptions.callback  = |!this.setautoRoutingOptions()|
    if !cableExist.hascablinglicence('CABLES').not() then
     !this.cablezonepara.active = FALSE
     !this.cablezone.active     = FALSE
     !this.cablespecpara.active = FALSE
     !this.cablespec.active     = FALSE
    endif

     -- write member
     !this.write = FALSE

     -- Specifications
     !this.setupSpecs()

     -- Storage Area
     !this.setupStorage()
     !this.useGaps.val         = TRUE
     !this.cexesTag.val       = 'Excess Lengths:    '
     !this.cableProximityTag.val  = 'Proximity Distance:'

     !this.cwbranRnode.val      = FALSE
     !rtext  = object ARRAY()
	   !dtext  = object ARRAY()
     !rtext.append('TRUE')
	  !rtext.append('FALSE')
	  !dtext.append('On')
	  !dtext.append('Off')

	  !this.cableFillLevel.dtext  = !dtext
	  !this.cableFillLevel.rtext  = !rtext

     !this.cableFillLevel.select('rtext','FALSE')

     -- Gaps & Cable Data (Values set based on units set for the project)
   if (!!isImperialLength('DIST').not()) then
     -- Gaps
     !this.firstGap.val         = 0 mm
     !this.intermediateGap.val  = 0 mm
     !this.lastGap.val          = 0 mm
     --Cable Data
     !this.cexes1.val           = 0 mm
     !this.cexes2.val           = 0 mm
     !this.cexes3.val           = 0 mm
     !this.cexes4.val           = 0 mm
     !this.cableProximity.val   = 3500 mm
   else
    -- Gaps
     !this.firstGap.val         = 0 in
     !this.intermediateGap.val  = 0 in
     !this.lastGap.val          = 0 in
     --Cable Data
     !this.cexes1.val           = 0 in
     !this.cexes2.val           = 0 in
     !this.cexes3.val           = 0 in
     !this.cexes4.val           = 0 in
     !this.cableProximity.val   = 144 in
   endif

         -- interference class
   !this.dinter.append('unset')
   !this.dinter.append('POWER')
   !this.dinter.append('COMM')
   !this.dinter.append('SIGNAL')
   !this.dinter.append('CONTROL')
   !this.dinter.append('WIRE')
   !this.cwbranIclass.dtext = !this.dinter

   --popup for interference class deletion
   !menu   =   !this.newMenu('deleteIclass')
   !menu.add('callback','Remove','!this.removeIclass(!this.cwbranIclass)')
   !this.cwbranIclass.setPopup(!menu)

   -- read last session settings
   !this.readSettings()

   -- set up defaults
   !this.setdfltmembers()


endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method:   setdfltmembers
--
-- Description: sets the default members
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setdfltmembers()

   -- cableway default zone

   !name = !this.cwayzone.rtext[!this.cwayzone.val]
   handle ANY
     !this.cwayzonedefault    = object DBREF()
   elsehandle NONE
   -- put a '/ in front of the name if the zone is named
   if !this.cwayzone.rtext[!this.cwayzone.val].occurs(' of ').gt(0) then
   	
     !name = !this.cwayzone.rtext[!this.cwayzone.val]
     !this.cwayzonedefault     = !name.dbref()

    else
     !name = '/' & !this.cwayzone.rtext[!this.cwayzone.val]
     handle ANY
      !this.cwayzonedefault    = object DBREF()
     elsehandle NONE
      if !name.neq('/None') then
        if !name.neq('/None Available') then
       !this.cwayzonedefault     = !name.dbref()
        endif
      else
       !this.cwayzonedefault    = object DBREF()
      endif
     endhandle
    endif
    endhandle

   -- cable default zone
   !name = !this.cablezone.rtext[!this.cablezone.val]
   handle ANY
     !this.cablezonedefault    = object DBREF()
   elsehandle NONE
    -- put a '/ in front of the name if the zone is named
   if !this.cablezone.rtext[!this.cablezone.val].occurs(' of ').gt(0) then
     !name = !this.cablezone.rtext[!this.cablezone.val]
     !this.cablezonedefault     = !name.dbref()
   else
     !name = '/' & !this.cablezone.rtext[!this.cablezone.val]
     handle ANY
      !this.cablezonedefault    = object DBREF()
     elsehandle NONE
      if !name.neq('/None') then
       if !name.neq('/None Available') then
        !this.cablezonedefault     = !name.dbref()
       endif
     else
      !this.cablezonedefault    = object DBREF()
     endif
     endhandle
   endif
   endhandle

   !this.cablespecdefault    = !this.cablespec.rtext[!this.cablespec.val].dbref()
   handle ANY
    !this.cablespecdefault    = object DBREF()
   endhandle
   !this.cwaymatspecdefault  = !this.cwmtrlspec.rtext[!this.cwmtrlspec.val].dbref()
   handle ANY
    !this.cwaymatspecdefault    = object DBREF()
   endhandle

   !this.cablesysrefdefault  = !this.systemReference.rtext[!this.systemReference.val].dbref()
   handle ANY
    !this.cablesysrefdefault    = object DBREF()
   endhandle
  !this.cableFillLevelCheck = !this.cableFillLevel.selection().boolean()

   -- Cableway Branch width and height
   !this.cwbranvheight = !this.cwbranheight.val
   !this.cwbranvwidth  = !this.cwbranwidth.val
   -- The minimum straight length core method requires mm value always
   !mmMinLengthCableTrayStraight = !!comValueConvert(!this.minLengthCableTrayStraight.val,'MM')
   !this.helpCableTrayManager.setMinimumStraightLength(!mmMinLengthCableTrayStraight)

     !this.cableManager.setauotoroutingmode(!this.autoRoutingMode)
   -- Cableway Branch Cable Excess and MaxFil
   !this.cwbrancexs   = !this.cwbrancexss.val
   !this.cwbranmaxfil = !this.cwbranmaxfill.val
   !this.cwbranfillcheckallowance = !this.fillCheckAllowance.val
   !this.cwbranRnodeCreation = !this.cwbranRnode.val

   -- write settings. Not to be written during first loading
   if !this.write then
   	!this.writeSettings()
   --hide the Form
   !this.dismiss()
   else
    !this.write = TRUE
   endif

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      setupSpecs
--
-- Description: Setup Specifications
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupSpecs()


    --Cableway material specs

   var !col collect all TABGRO with (purp eq 'TRAY')

     if !col.unset() then     	
    	 !mDisplay[1]   = 'None Available'
       !mReplace[1]   = ''
     else
       !dtext  = object ARRAY()
       !rtext  = object ARRAY()
       do !spec values !col
         !dtext.append(!spec.dbref().namn)
       enddo
       !mDisplay    = !dtext
       !mReplace    = !col
       !mDisplay.insert(1,'None')
       !mReplace.insert(1,'')
     endif

   !this.cwmtrlspec.dtext     = !mDisplay
   !this.cwmtrlspec.rtext     = !mReplace


    -- Cable specs

     var !col collect all TABGRO with (purp eq 'CABL')

     if !col.unset() then
       !sDisplay[1]   = 'None Available'
       !sReplace[1]   = ''
     else
       !dtext  = object ARRAY()
       !rtext  = object ARRAY()
       do !spec values !col
         !dtext.append(!spec.dbref().namn)
       enddo
       !sDisplay    = !dtext
       !sReplace    = !col
       !sDisplay.insert(1,'None')
       !sReplace.insert(1,'')
     endif

   !this.cablespec.dtext     = !sDisplay
   !this.cablespec.rtext     = !sReplace

  -- Cable Sysref
   !!collectSystemReference('ELEC', !sDisplay, !sReplace)


   !dtext2 = object ARRAY()
   !rtext2 = object ARRAY()

   !!collectSystemReference('ALL', !dtext2, !rtext2)

   !dtext2.removeFirst()
   !rtext2.removeFirst()

   !sDisplay.appendArray(!dtext2)
   !sReplace.appendArray(!rtext2)

   !this.systemReference.dtext = !sDisplay
   !this.systemReference.rtext = !sReplace

   -- Cableway branch width and Height
   if (!!isImperialLength('DIST')) then
    !this.cwbranheight.val = 4 in
    !this.cwbranwidth.val  = 12 in
    !this.minLengthCableTrayStraight.val  = 3/8 in
   else
    !this.cwbranheight.val = 100 mm
    !this.cwbranwidth.val  = 300 mm
    !this.minLengthCableTrayStraight.val  = 10 mm
   endif

    !this.cwbrancexss.val   = 0
    !this.cwbranmaxfill.val = 100

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: Dismiss
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.hide()

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: init
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()


  -- Storage Area
  !this.setupStorage()

  -- default Specifications
  !this.cwayzone.val = !this.cwayzone.dtext.findfirst(!this.cwayzonedefault.flnn)
  handle ANY
    !this.cwayzone.val = 1
  endhandle

  !this.cablezone.val = !this.cablezone.dtext.findfirst(!this.cablezonedefault.flnn)
  handle ANY
    !this.cablezone.val = 1
  endhandle

  !this.cablespec.val = !this.cablespec.dtext.findfirst(!this.cablespecdefault.flnn)
  handle ANY
    !this.cablespec.val = 1
  endhandle
	
	!this.cableFillLevel.select('rtext', !this.cableFillLevelCheck.string())

  !this.cwbranRnode.val  = !this.cwbranRnodeCreation

  !this.systemReference.val = !this.systemReference.rtext.findfirst(!this.cablesysrefdefault.flnm)
  handle ANY
    !this.systemReference.val = 1
  endhandle

  !this.cwmtrlspec.val = !this.cwmtrlspec.dtext.findfirst(!this.cwaymatspecdefault.flnn)
  handle ANY
    !this.cwmtrlspec.val = 1
  endhandle

  !this.autoRoutingMode = !this.cableManager.getauotoroutingmode()
  if (!this.autoRoutingMode) then
    !this.autoRoutingOptions.val = 1
  else
    !this.autoRoutingOptions.val = 2
  endif

  if (!this.cwbranfillcheckallowance.unset()) then
    !this.fillCheckAllowance.val = 5
    !this.cwbranfillcheckallowance = 5
  else
    !this.fillCheckAllowance.val = !this.cwbranfillcheckallowance
  endif

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: validate
--
-- Description: Validate entry
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validate(!gadget is GADGET, !member is STRING, !type is STRING)

   !value = !gadget.val.trim()

   if !value.substring(1,1).neq('/') then
    !value = '/' & !value
    !gadget.val = !value
   endif

    !value.dbref()
    handle ANY
     if !value.eq('/')then
      !gadget.val = ''
      !this.$!<member>  = nulref
     endif
     !!alert.message('Not a valid Name')
    elsehandle NONE

     if !value.dbref().type.neq(!type) then
      !!alert.error('$!value is not a $!type')
     else
     !this.$!<member>  = !value.dbref()
     endif
    endhandle


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: Setup Storage
--
-- Description: Default storage areas
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupStorage()

 -- Zones

   !text = ARRAY()

  var !zones collect all ZONE with ((PURP eq |CABL| or upcase(FUNC) eq |CABLE|) and (DBWRITE))

  if (!zones.size() eq 0) then
    !text.append('None Available')
  else
    do !i indices !zones
      !text.append(!zones[!i].dbref().flnn)
    enddo
    !text.insert(1,'None')
  endif

  !this.cwayzone.dtext      = !text
  !this.cablezone.dtext     = !text

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: writeSettings
--
-- Description: writes default values to file
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .writeSettings()

 -- Get the session information
  !sessionData = CURRENT SESSION
  !project     = CURRENT PROJECT
  !login       = !sessionData.login
  !projName    = !project.code()
  !writeArray  = ARRAY()

   -- Session filename
  !sessFile = object FILE()
  !sessFile.file('%PDMSUSER%/' + 'cbl' + '-defaults-' + !projName + '-' + !login + '.pmldat')


  -- Build array to write
  !writeArray.append(|# Cabling Session Information for user: |& !login & | for project | & !projName)

  -- CWAY zone
  !writeArray.append('CWAYZONE: ' + !this.cwayzonedefault.flnn)
  handle ANY
    !writeArray.append('CWAYZONE: ' + !this.cwayzonedefault.string())
  endhandle

  -- CABLE zone
  !writeArray.append('CABLEZONE: ' + !this.cablezonedefault.flnn)
  handle ANY
    !writeArray.append('CABLEZONE: ' + !this.cablezonedefault.string())
  endhandle

  -- CABLE specification
  !writeArray.append('CABLESPEC: ' + !this.cablespecdefault.flnn)
  handle ANY
    !writeArray.append('CABLESPEC: ' + !this.cablespecdefault.string())
  endhandle

  -- CABLE Sys Ref
  !writeArray.append('CABLESYSREF: ' + !this.cablesysrefdefault.flnn)
  handle ANY
   !writeArray.append('CABLESYSREF: ' + !this.cablesysrefdefault.string())
  endhandle

  !writeArray.append('CABLEFILLCHECK: ' + !this.cableFillLevel.selection().boolean().string())

  -- Material specification
  !writeArray.append('CWAYMATSPEC: ' + !this.cwaymatspecdefault.flnn)
  handle ANY
   !writeArray.append('CWAYMATSPEC: ' + !this.cwaymatspecdefault.string())
  endhandle

  -- CWBRAN width and height
  !writeArray.append('CWBRANWIDTH: ' + !this.cwbranvwidth.queryString())
  !writeArray.append('CWBRANHEIGHT: ' + !this.cwbranvheight.queryString())

  -- CWBRAN width and height
  !writeArray.append('CWBRANCEXS: ' + !this.cwbrancexs.string())
  !writeArray.append('CWBRANMAXFIL: ' + !this.cwbranmaxfil.string())

  -- Gaps
  !writeArray.append('USEGAPS: ' + !this.useGaps.val.string())
  !writeArray.append('FIRSTGAP: ' + !this.firstGap.val.queryString())
  !writeArray.append('INTERGAP: ' + !this.intermediateGap.val.queryString())
  !writeArray.append('LASTGAP: ' + !this.lastGap.val.queryString())


  !writeArray.append('CWBRANRNODE: ' + !this.cwbranRnode.val.string())

   --Auto Routing Mode
  !writeArray.append('AUTOROUTINGMODE: ' + !this.autoRoutingMode.string())

  -- Cable Data
  !writeArray.append('CBLEXCS1: ' + !this.cexes1.val.queryString())
  !writeArray.append('CBLEXCS2: ' + !this.cexes2.val.queryString())
  !writeArray.append('CBLEXCS3: ' + !this.cexes3.val.queryString())
  !writeArray.append('CBLEXCS4: ' + !this.cexes4.val.queryString())
  !writeArray.append('CBLPROX: ' + !this.cableProximity.val.queryString())

  -- interference class
  !iclassValues = !this.cwbranIclass.dtext
  !iclass  = ''
  do !inter values !iclassValues
   !iclass = !iclass + !inter
   !iclass = !iclass + ' '
  enddo
  !writeArray.append('ICLASS: ' + !iclass)

  --default value
  !iclassSelect =  !this.cwbranIclass.selection()
  !writeArray.append('ICLASSSELECT: ' + !iclassSelect)

  -- Write array of session data
  !sessFile.writeFile('OVERWRITE', !writeArray)
  handle any

    -- Unable to write session file for some reason
    !!alert.error(|Could not write session file due to |& !!error.text)

  endhandle

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: readSettings
--
-- Description: writes default values to file
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .readSettings()

 -- Get the session information
  !sessionData = CURRENT SESSION
  !project     = CURRENT PROJECT
  !login       = !sessionData.login
  !projName    = !project.code()
  !writeArray  = ARRAY()
  -- Session filename
  !sessFile = object FILE()
  !sessFile.file('%PDMSUSER%/' + 'cbl' + '-defaults-' + !projName + '-' + !login + '.pmldat')

  -- see if file exists
  if !sessFile.exists().not() then
    return
  endif

  -- read the settings file
  !settings = !sessFile.readFile()
  handle ANY
  	return
  endhandle

  -- loop through and set the gadget values
  do !lines values !settings
    !value = !lines.split(':')
    if !value[1].eq('CWAYZONE') then
      -- CWAY zone
      !this.cwayzone.val = !this.cwayzone.dtext.findfirst(!value[2].trim())
      handle ANY
      endhandle
    elseif !value[1].eq('CABLEZONE') then
      -- CABLE zone
      !this.cablezone.val = !this.cablezone.dtext.findfirst(!value[2].trim())
      handle ANY
      endhandle
    elseif !value[1].eq('CABLESPEC') then
      -- CABLE Specification
      !this.cablespec.val = !this.cablespec.dtext.findfirst(!value[2].trim())
      handle ANY
      endhandle
    elseif !value[1].eq('CABLESYSREF') then
      -- CABLE Specification
      !this.systemReference.val = !this.systemReference.dtext.findfirst(!value[2].trim())
      handle ANY
      endhandle
 		elseif !value[1].eq('CABLEFILLCHECK') then
      -- Cable fill level check
      !this.cableFillLevel.select('rtext', !value[2].trim().boolean())
      handle ANY
      endhandle

    elseif !value[1].eq('CWAYMATSPEC') then
      -- Material Specification
      !this.cwmtrlspec.val = !this.cwmtrlspec.dtext.findfirst(!value[2].trim())
      handle ANY
      endhandle
    elseif !value[1].eq('CWBRANWIDTH') then
      -- CWBRAN Width
      !this.cwbranwidth.val = object REAL(!value[2].trim(), !!distanceFmt)
      handle ANY
      endhandle
    elseif !value[1].eq('CWBRANHEIGHT') then
      -- CWBRAN Height
      !this.cwbranheight.val = object REAL(!value[2].trim(), !!distanceFmt)
      handle ANY
      endhandle
    elseif !value[1].eq('CWBRANCEXS') then
    	-- CWBRAN Cable Excess
    	!this.cwbrancexss.val = object REAL(!value[2].trim())
      handle ANY
      endhandle
    elseif !value[1].eq('CWBRANMAXFIL') then
    	-- CWBRAN Maximum Fill
    	!this.cwbranmaxfill.val = object REAL(!value[2].trim())
      handle ANY
      endhandle
    elseif !value[1].eq('USEGAPS') then
      -- Gaps
      !this.useGaps.val = !value[2].trim().boolean()
      handle ANY
      endhandle
    elseif !value[1].eq('FIRSTGAP') then
      -- First Gap
      !this.firstGap.val = object REAL(!value[2].trim(), !!distanceFmt)
      handle ANY
      endhandle
    elseif !value[1].eq('INTERGAP') then
     -- Intermediate Gap
     !this.intermediateGap.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle
    elseif !value[1].eq('LASTGAP') then
     -- Last Gap
     !this.lastGap.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle
     elseif !value[1].eq('CBLEXCS1') then
     -- Excess 1
     !this.cexes1.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle
      elseif !value[1].eq('CBLEXCS2') then
     -- Excess 2
     !this.cexes2.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle
      elseif !value[1].eq('CBLEXCS3') then
     -- Excess 3
     !this.cexes3.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle
      elseif !value[1].eq('CBLEXCS4') then
     -- Excess 4
     !this.cexes4.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle
      elseif !value[1].eq('CBLPROX') then
     -- Cable Proximity Distance
     !this.cableProximity.val = object REAL(!value[2].trim(), !!distanceFmt)
     handle ANY
     endhandle

     elseif !value[1].eq('CWBRANRNODE') then
      -- Gaps
      !this.cwbranRnode.val = !value[2].trim().boolean()
      handle ANY
      endhandle
     elseif !value[1].eq('AUTOROUTINGMODE') then
       -- Auto Routing Mode
       !this.autoRoutingMode = !value[2].trim().boolean()
       handle ANY
       endhandle
    elseif !value[1].eq('ICLASS') then
     -- iclass
     !class = !value[2].split()
     !iclass = object ARRAY()
     do !inter values !class
       !iclass.append(!inter)
     enddo

     if !iclass.size().gt(1) then
      !this.cwbranIclass.dtext = !iclass
     endif
    elseif !value[1].eq('ICLASSSELECT') then
    	!this.cwbranIclass.select('DTEXT', !value[2].trim())
    	handle ANY
    	endhandle
    endif
  enddo

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: addIclass
--
-- Description: adds the user interference class to gadget
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addIclass(!gadget is GADGET, !action is STRING)

 if !action.eq('VALIDATE') then

  !newInter = !gadget.displayText()
  --add the value
  !values = !gadget.dtext
  if !values.findfirst(!newInter).set().not() then
    !gadget.add(!newInter)
    !this.dinter.append(!newInter)
    -- add to cableway form
    if defined(!!cblcway) then
    	!!cblcway.dinter.append(!newInter)
    endif
  endif

  -- be at the new input value
  !gadget.select('DTEXT', !newInter)
  handle ANY
  endhandle

 endif

endmethod

------------------------------------------------------------------------
--
-- Method:      removeIclass
--
-- Description: removes the selected iclass
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeIclass(!gadget is GADGET)

  !iclass = !gadget.displayText().trim()
  if !gadget.selection().eq('unset') then
    !!alert.error('Cannot remove the unset value')
    return
  else
   !gadget.clear(!iclass)
   -- remove from cableway Form
   if defined(!!cblcway) then
    !index = !!cblcway.dinter.findfirst(!iclass)
    if !index.set() then
     !!cblcway.dinter.remove(!index)
    endif
   endif
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: loadIclass
--
-- Description: loads the interference class from cable property db
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadIclass()

  var !cabd collect all CABD
  !interference = object ARRAY()
  do !cable values !cabd
   !interference.append(!cable.dbref().dinterference)
  enddo
  !interference.unique()

  -- load values to member
  do !inter values !interference
    !this.dinter.append(!inter)
  enddo

  !this.dinter.unique()

  !selection = !this.cwbranIclass.selection()
  !this.cwbranIclass.dtext = !this.dinter

  -- display original selection
  if !selection.neq('') then
   !this.cwbranIclass.select('DTEXT', !selection)
  endif

  -- message
  if !interference.set() then
  	!this.iclassLoad.tag = 'Reload'
    !!alert.message('Interference class from properties database loaded')
  else
    !!alert.message('No Interference class available in properties database')
  endif


endmethod

------------------------------------------------------------------------
--
-- Method: setautoRoutingOptions
--
-- Description: set Auto Routing Options
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setautoRoutingOptions()

  if (!this.autoRoutingOptions.val.eq(1)) then
    !this.autoRoutingMode = true
  else
    !this.autoRoutingMode = false
  endif


endmethod
------------------------------------------------------------------------
--
-- Method: setFillCheckAllowance
--
-- Description: set cableway fill check tolerance for fill level check form.
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFillCheckAllowance()

  if (!this.fillCheckAllowance.val lt 1) then
  	!!alert.message('Value must be greater than 1')
  	!this.fillCheckAllowance.val = 5
  endif

endmethod
