-- File:           cbllistcables.pmlfrm
-- Type:           Form Definition
-- Group:          Cabling Application
--
-- Keyword:        CABLING
-- Module:         design
-- Replaces:
--
-- Author:         Venkatramanan Iyer
-- Created:        Thu Apr 14 2006
-- Description:
-- Form to display cables associated with CWBRAN
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCable()                       -                   add the selected Cable to the view
--  addConnected()                   -                   add the Connected Equipment or ELCONN for the Cable to the view
--  cblListCables()                  -                   Constructor
--  close()                          -                   on closure of form, highlighted elements are unhighlighted
--  currentElement()                 -                   CE
--  exportToExcel()                  -                   Export to Excel
--  getSelection()                   ARRAY               Return selection for currently displayed grid
--  highlight()                      -                   Highlight the selected Cable
--  init()                           -                   initialise the form
--  modifyCable()                    -                   Modify selected cable
--  navigate()                       -                   navigate to the first selected grid member
--  populateArrayWithData (ARRAY,ARRAY) -
--  printPreview()                   -                   Print preview
--  removeCable()                    -                   remove the selected Cable from the view
--  removeConnected()                -                   remove the Connected Equipment or ELCONN for the Cable from the view
--  rightClickGrid(ARRAY)            -                   set up the popup menus for the grid
--  show(DBREF)                      -
--  unhighlight()                    -                   unhighlight the selected Cable
--

-- Import DLL
import 'GridControl'
handle ANY
endhandle

using namespace 'Aveva.Pdms.Presentation'

setup form !!cblListCables dialog dock size 74 20

  member .groupPCableGrid   is NETGRIDCONTROL
  member .groupLACableGrid is NETGRIDCONTROL
  member .groupACableGrid   is NETGRIDCONTROL
  member .element        is DBREF
  member .groupICableGrid   is NETGRIDCONTROL
  member .groupOCableGrid   is NETGRIDCONTROL
  -- highlight object
  member .enhance        is COMENHANCE

  menu .pmlpopupgrid
   !this.pmlpopupgrid.add( 'CALLBACK', 'Navigate',    '!this.navigate()' )
   !this.pmlpopupgrid.add( 'CALLBACK', 'Highlight',   '!this.highlight()' )
   !this.pmlpopupgrid.add( 'CALLBACK', 'Unhighlight', '!this.unhighlight()' )
   !this.pmlpopupgrid.add( 'SEPARATOR')
   !this.pmlpopupgrid.add( 'MENU', '3D View', 'PMLPopupSub' )
   !this.pmlpopupgrid.add( 'separator' )
   !this.pmlpopupgrid.add( 'callback', 'Export to Excel...', '!this.exportToExcel()')
   !this.pmlpopupgrid.add( 'callback', 'Print Preview...', '!this.printPreview()' )
   !this.pmlpopupgrid.add( 'callback', 'Modify Cable...', |!this.modifyCable()|, 'MODIFY')

  menu .pmlpopupsub
   !this.pmlpopupsub.add( 'CALLBACK', 'Add Cable',          '!this.addCable()' )
   !this.pmlpopupsub.add( 'CALLBACK', 'Add Connected     ', '!this.addConnected()' )
   !this.pmlpopupsub.add( 'CALLBACK', 'Remove Cable      ', '!this.removeCable()' )
   !this.pmlpopupsub.add( 'CALLBACK', 'Remove Connected  ', '!this.removeConnected()' )

  button .ce 'CE' linklabel   anchor l+t       at xmin      y0.2   callback '!this.currentElement()'
  para   .currentElement      anchor l+t+r     at xmax+1    ymin      text  '' width 50

  frame .cableList TABSET anchor all at xmin.ce ymax+.2 width 74 height 20


    frame .cableAll 'All Cables' anchor all dock fill
      container .netGroupACableGrid PmlNetControl anchor all width 50 height 20
    exit
    frame .cable 'Passing Cables' anchor all dock fill
      container .netGroupPCableGrid PmlNetControl |List of Cables:| anchor all width 50 height 20
    exit
    frame .cableI 'Incoming Cables' anchor all dock fill
      container .netGroupICableFrame PmlNetControl anchor all width 50 height 20
    exit

    frame .cableO 'Outgoing Cables' anchor all dock fill
      container .netGroupOCableFrame PmlNetControl anchor all width 50 height 20
    exit

    frame .cable2 'Cables Arriving/Leaving' anchor all dock fill
      container .netGroupLACableGrid PmlNetControl anchor all width 50 height 20
    exit


    frame .fillLevel 'Cables Fill level' anchor all dock fill
        para   .fillLevel0      anchor l+t+r     at xmin    ymin      text  'on Passing Cables:' width 20
        para   .fillLevel1      anchor l+t+r     at xmin    ymax+1      text  'on Incoming Cables:' width 20
        para   .fillLevel2      anchor l+t+r     at xmin    ymax+1     text  'on Outgoing Cables:' width 20
        para   .fillLevel3      anchor l+t+r     at xmin    ymax+1     text  'on Arriving/Leaving Cables:' width 20
        para   .fillLevelValue3      anchor l+t+r     at xmax + 3    ymin      text  'd ' width 50
        para   .fillLevelValue2      anchor l+t+r     at xmin    ymax - 3      text  'd ' width 50
        para   .fillLevelValue1      anchor l+t+r     at xmin    ymax - 3      text  'd ' width 50
        para   .fillLevelValue0      anchor l+t+r     at xmin    ymax - 3      text  'd ' width 50
    exit

  exit

exit

--End of form definition
------------------------------------------------------------------------
--
-- Method:      cblListCables
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblListCables()

  using namespace 'Aveva.Pdms.Presentation'

  -- Add instances of .Net control
  !this.groupPCableGrid   = object NETGRIDCONTROL()
  !this.groupLACableGrid = object NETGRIDCONTROL()
  !this.groupACableGrid   = object NETGRIDCONTROL()
  !this.groupICableGrid   = object NETGRIDCONTROL()
  !this.groupOCableGrid   = object NETGRIDCONTROL()
  -- Add .Net controls to PML containers
  !this.netGroupPCableGrid.control   = !this.groupPCableGrid.handle()
  !this.netGroupLACableGrid.control = !this.groupLACableGrid.handle()
  !this.netGroupACableGrid.control   = !this.groupACableGrid.handle()
  !this.netGroupOCableFrame.control = !this.groupOCableGrid.handle()
  !this.netGroupICableFrame.control = !this.groupICableGrid.handle()
  -- add PML event handlers to .Net control
  !this.groupPCableGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')
  !this.groupLACableGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')
  !this.groupACableGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')
  !this.groupICableGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')
  !this.groupOCableGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')

   -- form setup
  !this.formTitle       = 'List of Cables'
  !this.iconTitle       = 'List of Cables'
  !this.initcall        = '!this.init()'
  !this.quitCall        = '!this.close()'
  !this.formRevision    = ' '

  !this.currentElement.val = !!ce.flnn

endmethod
------------------------------------------------------------------------
--
-- Method:     init
--
-- Description: initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  using namespace  'Aveva.Pdms.Presentation'

  -- Set parameters
  !this.groupPCableGrid.columnExcelFilter(false)
  !this.groupPCableGrid.outlookGroupStyle(false)
  !this.groupPCableGrid.fixedHeaders(false)
  !this.groupPCableGrid.fixedRows(TRUE)
  !this.groupPCableGrid.columnSummaries(false)

  !this.groupLACableGrid.columnExcelFilter(false)
  !this.groupLACableGrid.outlookGroupStyle(false)
  !this.groupLACableGrid.fixedHeaders(false)
  !this.groupLACableGrid.fixedRows(TRUE)
  !this.groupLACableGrid.columnSummaries(false)

  !this.groupACableGrid.columnExcelFilter(false)
  !this.groupACableGrid.outlookGroupStyle(false)
  !this.groupACableGrid.fixedHeaders(false)
  !this.groupACableGrid.fixedRows(TRUE)
  !this.groupACableGrid.columnSummaries(false)


  !this.groupICableGrid.columnExcelFilter(false)
  !this.groupICableGrid.outlookGroupStyle(false)
  !this.groupICableGrid.fixedHeaders(false)
  !this.groupICableGrid.fixedRows(TRUE)
  !this.groupICableGrid.columnSummaries(false)


  !this.groupOCableGrid.columnExcelFilter(false)
  !this.groupOCableGrid.outlookGroupStyle(false)
  !this.groupOCableGrid.fixedHeaders(false)
  !this.groupOCableGrid.fixedRows(TRUE)
  !this.groupOCableGrid.columnSummaries(false)

  -- Clear any existing data
  !this.groupPCableGrid.clearGrid()
  !this.groupLACableGrid.clearGrid()
  !this.groupACableGrid.clearGrid()
  !this.groupICableGrid.clearGrid()
  !this.groupOCableGrid.clearGrid()
  using namespace  'Aveva.Pdms.Presentation'

  !this.currentElement.val = !!ce.flnn
  !this.element = !!ce

  -- Set headings
  !headings = ARRAY()
  !headings.append('Cable')
  !headings.append('Class Type')
  !headings.append('Start Ref')
  !headings.append('End Ref')
  !headings.append('Specification')
  !headings.append('Status')
  !headings.append('Total Length')

  !title = 'List of Cables'
  !mainGridElementsA  = object ARRAY()
  !clist     = object ARRAY()
  !qualifiersArray = object ARRAY()
  !qualifiersArray[1] = 0
  !clist = !this.element.attribute('CLIST',!qualifiersArray)
  handle (2,201)
   if(!!ce.ahlist.find('CWBRAN').set())then
     CWBRAN
     !clist  = !this.element.clist[0]
     handle ANY
     endhandle
   endif
  endhandle
  !this.populateArrayWithData(!clist, !mainGridElementsA)

  !nds = object NETDATASOURCE(!title, !headings, !mainGridElementsA)
  !this.groupPCableGrid.bindToDataSource(!nds)
  !this.groupPCableGrid.setNameColumnImage()
  handle any
  endhandle

--grid for incoming cables
  !mainGridElementsI  = object ARRAY()
  !clist1     = object ARRAY()
  !qualifiersArray[1] = 1
  !clist1 = !this.element.attribute('CLIST',!qualifiersArray)
  handle (2,201)
   if(!!ce.ahlist.find('CWBRAN').set())then
     CWBRAN
     !clist1  = !this.element.clist[1]
     handle ANY
     endhandle
   endif
  endhandle
  !this.populateArrayWithData(!clist1, !mainGridElementsI)

  !nds = object NETDATASOURCE(!title, !headings, !mainGridElementsI)
  !this.groupICableGrid.bindToDataSource(!nds)
  !this.groupICableGrid.setNameColumnImage()
  handle any
  endhandle

--grid for outgoing cables
  !mainGridElementsO  = object ARRAY()
  !clist2     = object ARRAY()
  !qualifiersArray[1] = 2
  !clist2 = !this.element.attribute('CLIST',!qualifiersArray)
  handle (2,201)
   if(!!ce.ahlist.find('CWBRAN').set())then
     CWBRAN
     !clist2  = !this.element.clist[2]
     handle ANY
     endhandle
   endif
  endhandle
  !this.populateArrayWithData(!clist2, !mainGridElementsO)

  !nds = object NETDATASOURCE(!title, !headings, !mainGridElementsO)
  !this.groupOCableGrid.bindToDataSource(!nds)
  !this.groupOCableGrid.setNameColumnImage()
  handle any
  endhandle


  -- Grid for cables on arrive/leave
  !mainGridElementsB  = object ARRAY()
  !element = !!ce

  !listB = ARRAY()
  !listB = !element.lalcab
  handle ANY
    -- Element does not have attribute lalcab
  endhandle

  !this.populateArrayWithData(!listB , !mainGridElementsB)


  !nds = object NETDATASOURCE(!title, !headings, !mainGridElementsB)
  !this.groupLACableGrid.bindToDataSource(!nds)
  !this.groupLACableGrid.setNameColumnImage()
  handle any
  endhandle

  -- Grid for both Cable sets. Passing through and arrive/leave
  !mainGridElementsC  = object ARRAY()

  !listB.appendArray(!clist)

  !this.populateArrayWithData(!listB , !mainGridElementsC)

  !nds = object NETDATASOURCE(!title, !headings, !mainGridElementsC)
  !this.groupACableGrid.bindToDataSource(!nds)
  !this.groupACableGrid.setNameColumnImage()
  handle any
  endhandle

  !qualifiersArray[1] = 0
  !temp = !this.element.attribute('FLEVEL',!qualifiersArray)
  handle any
    !temp[1] = 0
    !tempString = 'N/A'
  elsehandle None
    !tempString = !temp[1].string(!!realFmt) &' %'
  endhandle
  !this.fillLevelValue0.val = !tempString

  !qualifiersArray[1] = 1
  !temp = !this.element.attribute('FLEVEL',!qualifiersArray)
  handle any
    !temp[1] = 0
    !tempString = 'N/A'
  elsehandle None
    !tempString = !temp[1].string(!!realFmt) &' %'
  endhandle
  !this.fillLevelValue1.val = !tempString

  !qualifiersArray[1] = 2
  !temp = !this.element.attribute('FLEVEL',!qualifiersArray)
  handle any
    !temp[1] = 0
    !tempString = 'N/A'
  elsehandle None
    !tempString = !temp[1].string(!!realFmt) &' %'
  endhandle
  !this.fillLevelValue2.val = !tempString

  !qualifiersArray[1] = 3
  !temp = !this.element.attribute('FLEVEL',!qualifiersArray)
  handle any
    !temp[1] = 0
    !tempString = 'N/A'
  elsehandle None
    !tempString = !temp[1].string(!!realFmt) &' %'
  endhandle
  !this.fillLevelValue3.val = !tempString

endmethod

-- End of method definition for .populateArrayWithData()

------------------------------------------------------------------------
--
-- Method:      populateArrayWithData
--
-- Description: populate second array With Data from first array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of cables
--    2   RW     ARRAY       Array to populate the grid

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateArrayWithData (!cables is ARRAY, !data is ARRAY)
  !list = !cables.sortUnique()
  do !i indices !list
	  !data[!i][1] = !list[!i].namn
	  !data[!i][2] = !list[!i].iclass
	  !data[!i][3] = !list[!i].staref.namn
	  handle ANY
	  endhandle
	  !data[!i][4] = !list[!i].endref.namn
	  handle ANY
	  endhandle
	  !data[!i][5] = !list[!i].spref.namn
	  handle ANY
	    !data[!i][5] = '-'
	  endhandle
	  !data[!i][6] = !list[!i].cbsta
	  !data[!i][7] = !list[!i].cbtole.string(!!distanceFmt)
		handle Any
		endhandle
  enddo
endmethod
-- End of method definition for .populateArrayWithData()
------------------------------------------------------------------------
--
-- Method:      rightClickGrid
--
-- Description: set up the popup menus for the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rightClickGrid(!data is ARRAY)

  -- Disable the 'modify attributes' pop up when there is multiple selection
   if( !this.groupPCableGrid.getSelectedRows().size() gt 1) then
    !this.pmlpopupgrid.setFieldProperty('MODIFY', 'ACTIVE', false)
   elseif (!this.groupLACableGrid.getSelectedRows().size() gt 1) then
    !this.pmlpopupgrid.setFieldProperty('MODIFY', 'ACTIVE', false)
   elseif (!this.groupACableGrid.getSelectedRows().size() gt 1) then
    !this.pmlpopupgrid.setFieldProperty('MODIFY', 'ACTIVE', false)
   elseif (!this.groupOCableGrid.getSelectedRows().size() gt 1) then
    !this.pmlpopupgrid.setFieldProperty('MODIFY', 'ACTIVE', false)
   elseif (!this.groupICableGrid.getSelectedRows().size() gt 1) then
    !this.pmlpopupgrid.setFieldProperty('MODIFY', 'ACTIVE', false)
   else
    !this.pmlpopupgrid.setFieldProperty('MODIFY', 'ACTIVE', true)
   endif

  if (!this.cable.visible eq true) then
    if( !this.groupPCableGrid.getRows().size() gt 0) then
    !this.netGroupPCableGrid.popup = !this.pmlpopupgrid
    !this.netGroupPCableGrid.showPopup(!data[0], !data[1])
    endif
  elseif (!this.cable2.visible eq true) then
    if ( !this.groupLACableGrid.getRows().size() gt 0) then
    !this.netGroupLACableGrid.popup = !this.pmlpopupgrid
    !this.netGroupLACableGrid.showPopup(!data[0], !data[1])
    endif
  elseif (!this.cableAll.visible eq true) then
    if ( !this.groupACableGrid.getRows().size() gt 0) then
    !this.netGroupACableGrid.popup = !this.pmlpopupgrid
    !this.netGroupACableGrid.showPopup(!data[0], !data[1])
    endif
   elseif (!this.cableO.visible eq true) then
    if ( !this.groupOCableGrid.getRows().size() gt 0) then
    !this.netGroupOCableFrame.popup = !this.pmlpopupgrid
    !this.netGroupOCableFrame.showPopup(!data[0], !data[1])
    endif
   elseif (!this.cableI.visible eq true) then
    if ( !this.groupICableGrid.getRows().size() gt 0) then
    !this.netGroupICableFrame.popup = !this.pmlpopupgrid
    !this.netGroupICableFrame.showPopup(!data[0], !data[1])
    endif
  endif

endmethod

-- End of method definition for .rightClickGrid()
------------------------------------------------------------------------
--
-- Method:      gridSelection
--
-- Description: Return selection for currently displayed grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Selection for currently displayed grid
--
------------------------------------------------------------------------
define method .getSelection() is ARRAY

    if (!this.cable.visible) then
      !gridSelection   = !this.groupPCableGrid.getSelectedRowTags()
      !selectedRows = !this.groupPCableGrid.getSelectedRows()
    elseif (!this.cable2.visible) then
      !gridSelection = !this.groupLACableGrid.getSelectedRowTags()
      !selectedRows = !this.groupLACableGrid.getSelectedRows()
    elseif (!this.cableAll.visible) then
      !gridSelection = !this.groupACableGrid.getSelectedRowTags()
      !selectedRows = !this.groupACableGrid.getSelectedRows()
    elseif (!this.cableO.visible) then
      !gridSelection = !this.groupOCableGrid.getSelectedRowTags()
      !selectedRows = !this.groupOCableGrid.getSelectedRows()
    elseif (!this.cableI.visible) then
      !gridSelection = !this.groupICableGrid.getSelectedRowTags()
      !selectedRows = !this.groupICableGrid.getSelectedRows()
    endif

   !selectedCables  = object ARRAY()
   !selectedIclass  = object ARRAY()
   !selectedStart   = object ARRAY()
   !selectedEnd     = object ARRAY()
   !selectedSpref   = object ARRAY()
   !selectedStatus  = object ARRAY()
   !selectedLength  = object ARRAY()

   do !selectedValues index !gridSelection

     !selectedCables.append(!selectedRows[!selectedValues][1])
     !selectedIclass.append(!selectedRows[!selectedValues][2])
     !selectedStart.append(!selectedRows[!selectedValues][3])
     !selectedEnd.append(!selectedRows[!selectedValues][4])
     !selectedSpref.append(!selectedRows[!selectedValues][5])
     !selectedStatus.append(!selectedRows[!selectedValues][6])
     !selectedLength.append(!selectedRows[!selectedValues][7])

   enddo

  !returnArray    = object ARRAY()
  !returnArray[1] = object ARRAY()
  !returnArray[2] = object ARRAY()
  !returnArray[3] = object ARRAY()
  !returnArray[4] = object ARRAY()
  !returnArray[5] = object ARRAY()
  !returnArray[6] = object ARRAY()
  !returnArray[7] = object ARRAY()

  do !cables  values !selectedCables
    if( !cables.subString(1,1) neq '=' ) then
      !cables = '/' + !cables
    endif
    !returnArray[1].append(!cables)
  enddo
  do !iclass values !selectedIclass
    !returnArray[2].append(!iclass)
  enddo
  do !start  values !selectedStart
    if( !start.subString(1,1) neq '=' ) then
      !start = '/' + !start
    endif
    !returnArray[3].append(!start)
  enddo
  do !end  values !selectedEnd
    if( !end.subString(1,1) neq '=' ) then
      !end = '/' + !end
    endif
    !returnArray[4].append(!end)
  enddo
  do !spref values !selectedSpref
    if( !spref.subString(1,1) neq '=' ) then
      !spref = '/' + !spref
    endif
    !returnArray[5].append(!spref)
  enddo
  do !status values !selectedStatus
    !returnArray[6].append(!status)
  enddo
  do !length values !selectedLength
    !returnArray[7].append(!length)
  enddo
  return !returnArray

endmethod
-- End of method definition for .getSelection() is ARRAY
------------------------------------------------------------------------
--
-- Method:     addCable
--
-- Description: add the selected Cable to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addCable()

  !arrayOfTags = !this.getSelection()[1]

  do !i values !arrayOfTags
    add $!i
  enddo

endmethod
-- End of method definition for .addCable()
------------------------------------------------------------------------
--
-- Method:     addConnected
--
-- Description: add the Connected Equipment or ELCONN for the Cable to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addConnected()

  !arrayOfStart  = !this.getSelection()[3]
  !arrayOfEnd    = !this.getSelection()[4]

  do !i values !arrayOfStart
    add $!i
  enddo

  do !j values !arrayOfEnd
    add $!j
  enddo

endmethod
-- End of method definition for .addConnected()
------------------------------------------------------------------------
--
-- Method:     removeCable
--
-- Description: remove the selected Cable from the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeCable()

  !arrayOfTags = !this.getSelection()[1]
  do !i values !arrayOfTags
    rem $!i
  enddo

endmethod
-- End of method definition for .removeCable()
------------------------------------------------------------------------
--
-- Method:     removeConnected
--
-- Description: remove the Connected Equipment or ELCONN for the Cable from the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeConnected()

  !arrayOfStart = !this.getSelection()[3]
  !arrayOfEnd   = !this.getSelection()[4]

  do !i values !arrayOfStart
    rem $!i
  enddo

  do !j values !arrayOfEnd
    rem $!j
  enddo

endmethod
-- End of method definition for .removeConnected()
------------------------------------------------------------------------
--
-- Method:     navigate
--
-- Description: navigate to the first selected grid member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigate()

  !arrayOfTags = !this.getSelection()[1]
  !!ce = !arrayOfTags[1].dbref()

endmethod
-- End of method definition for .navigate()
------------------------------------------------------------------------
--
-- Method:     highlight
--
-- Description: highlight the selected Cable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight()

  if( !this.cable.visible) then
      !rows   = !this.groupPCableGrid.getSelectedRows()
  elseif( !this.cable2.visible) then
      !rows = !this.groupLACableGrid.getSelectedRows()
  elseif( !this.cableAll.visible) then
      !rows = !this.groupACableGrid.getSelectedRows()
  elseif( !this.cableO.visible) then
      !rows = !this.groupOCableGrid.getSelectedRows()
  elseif( !this.cableI.visible) then
      !rows = !this.groupICableGrid.getSelectedRows()

  endif

  !name = !rows[1][1]

  if(!name.subString(1,1) neq '=') then
    !name = ( '/' + !rows[1][1])
  endif
  !element = !name.dbref()
  add $!element
  !this.enhance.addItem(!element)
  !this.enhance.refresh()


endmethod
-- End of method definition for .enhance()
------------------------------------------------------------------------
--
-- Method:     unhighlight
--
-- Description: unhighlight the selected Cable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unhighlight()

  if( !this.cable.visible) then
      !rows   = !this.groupPCableGrid.getSelectedRows()
  elseif( !this.cable2.visible) then
      !rows = !this.groupLACableGrid.getSelectedRows()
  elseif( !this.cableAll.visible) then
      !rows = !this.groupACableGrid.getSelectedRows()
  elseif( !this.cableO.visible) then
      !rows = !this.groupOCableGrid.getSelectedRows()
  elseif( !this.cableI.visible) then
      !rows = !this.groupICableGrid.getSelectedRows()
  endif
  !name = !rows[1][1]
  if(!name.subString(1,1) neq '=') then
    !name = ( '/' + !rows[1][1])
  endif
  !element = !name.dbref()
  add $!element
  !this.enhance.removeItem(!element)
  !this.enhance.clear()

endmethod

-- End of method definition for .unenhance()
------------------------------------------------------------------------
--
-- Method:     exportToExcel
--
-- Description: Export to Excel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exportToExcel()

  if (!this.cable.visible) then
      !!exportToExcel(!this.groupPCableGrid, ||, |Save As|)
  elseif (!this.cable2.visible) then
      !!exportToExcel(!this.groupLACableGrid, ||, |Save As|)
  elseif (!this.cableAll.visible) then
      !!exportToExcel(!this.groupACableGrid, ||, |Save As|)
  elseif (!this.cableI.visible) then
      !!exportToExcel(!this.groupICableGrid, ||, |Save As|)
  elseif (!this.cableO.visible) then
      !!exportToExcel(!this.groupOCableGrid, ||, |Save As|)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:     printPreview
--
-- Description: Print preview
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printPreview()

  if (!this.cable.visible) then
      !this.groupPCableGrid.printPreview()
  elseif (!this.cable2.visible) then
      !this.groupLACableGrid.printPreview()
  elseif (!this.cableAll.visible) then
      !this.groupACableGrid.printPreview()
  elseif (!this.cableI.visible) then
      !this.groupICableGrid.printPreview()
  elseif (!this.cableO.visible) then
      !this.groupOCableGrid.printPreview()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:     show
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .show(!element is DBREF)

 !this.element = !element

  if(!this.shown())then
    !this.init()
  else
    show !!cblListCables
  endif

endmethod
------------------------------------------------------------------------
-- Method:     currentElement
--
-- Description: CE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------
define method .currentElement()

 !this.element = !!ce
 !this.init()

endmethod
------------------------------------------------------------------------
--
-- Method:     modifyCable
--
-- Description: Modify selected cable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyCable()

  !this.navigate()
  !!cblinit('Modify','CABLE','!!cblcable')

endmethod
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: on closure of form, highlighted elements are unhighlighted
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.enhance.clear()

endmethod
------------------------------------------------------------------------
