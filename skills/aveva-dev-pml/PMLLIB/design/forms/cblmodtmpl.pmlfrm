--
-- Description:
-- Modify cable template
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyChanges()                   -
--  copy(BOOLEAN)                    -                   Copies select type
--  discard()                        -                   Discard Changes
--  dismiss()                        -                   Executes when form is cancelled/quit
--  editProp(STRING)                 -
--  init()                           -                   Initialisation method
--  loadTypes()                      -
--  updateRules()                    -
--  updateType()                     -                   Loads available types from selected zone
--  updateView()                     -                   Loads available types from selected zone
--

setup form !!cblModTmpl dialog dock right

  !this.autoscroll = TRUE
  !this.formtitle = 'Modify Cable Tray Material'

-- Reselect template

  paragraph .tmplAppdataTag   anchor l+t       at x1         ymax            text  'Load from Template Zone:' width 17
  option  .ctmtrlTmpdata          anchor l+t       at xmax   ymin            callback '!this.loadTypes()' width 30
  paragraph .tmplofType           anchor l+t       at x1   ymax+0.5           text  'Select Type:                       ' width 17
  option  .ctmtrlTypes               anchor l+t       at xmax   ymin            callback '!this.updateView()' width 30

  button .updateType linklabel |Update type| at x1          ymax+0.5 callback |!this.updateType()|
  button .usece linklabel |CE| at xmax+5          ymin callback |!this.init()|

-- 3D view
  frame .frView3D '3D view' anchor top + left + right at x1 ymax+0.5 width 51 height 10
    view .vwView3d volume
    exit
  exit

-- Modify attributes

  text .olength 'Overall Length'  tagwidth 14 at x1  ymax+0.5       width 14 is REAL format !!distanceFmt
  text .xoffset 'X Offset           '  tagwidth 14 at x1  ymax+0.5       width 14 is REAL format !!distanceFmt
  text .zoffset 'Z Offset            '  tagwidth 14 at x1  ymax+0.5       width 14 is REAL format !!distanceFmt
  text .betaangle  'Beta Angle      '  tagwidth 14 at x1  ymax+0.5       width 14 is REAL format !!distanceFmt

-- Show properties button

  button .bnProperties1 linklabel 'Properties of cable tray material element...' at x1 ymax+0.5 callback  |!this.editProp('MAT')|
  button .bnProperties2 linklabel 'Properties of cable tray template element...' at x1 ymax+0.1 callback  |!this.editProp('TMPL')|
  button .bnProperties3 linklabel 'Copy with gap' at x1 ymax+0.1 callback  |!this.copy(TRUE)|
  button .bnProperties4 linklabel 'Copy without gap' at x1 ymax+0.1 callback  |!this.copy(FALSE)|

  -- Update rules/repeat rules

  button .updateRules linklabel |Update rules| at x1 ymax+0.1 callback |!this.updateRules()|

-- Modify properties

-- Modify gensec lengths

-- Update rules/repeat rules

  paragraph .applyicon         anchor l+t    at x1      ymax+0.5         pixmap width 16 height 16
  button    .apply  linklabel  'Apply Changes'  anchor l+t at xmax+1 ymin     callback |!this.applyChanges()|
  paragraph .discardIcon        anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
  button    .discard linklabel   'Discard Changes'    anchor l+t    at xmax+1       ymin         callback '!this.discard()'

--Form Members
--Current Element
  member .ce            is DBREF
  member.tmpldata  is ARRAY
-- 3D view
  member .drawlist  is REAL
  member .newtmpl is BOOLEAN

  -- !this.quitcall = |!this.dismiss()|

  !modifyIcon     = !!pml.getPathname('accept.png')
  !discardIcon    = !!pml.getPathname('discard.png')
  !this.applyicon.addPixmap(!modifyIcon)
  !this.discardIcon.addPixmap(!discardIcon)

exit

-- end of form definition

------------------------------------------------------------------------
--
-- Method:   init()
--
-- Description: initialisation
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

-- Make sure form is hidden

  if !this.shown() then
     --hide !!cblModTmpl
  endif

-- Can we access a cable material element that we can write to

  !legalElements = ARRAY()
  !legalElements.append('CTSTRA')
  !legalElements.append('CTBEND')
  !legalElements.append('CTTEE')
  !legalElements.append('CTCROS')
  !legalElements.append('CTREDU')
  !legalElements.append('CTRISE')

-- Access legal element and check if owner if CTMTRL

  do !loop values !legalElements
    $!loop
      handle ANY
      endhandle
  enddo

  if not !!ce.type inset('CTSTRA','CTBEND','CTTEE','CTCROS','CTREDU','CTRISE') then
    !!alert.error('Cannot access a legal cable material component')
    return
  endif

  if !!ce.dbwrite.not() then
      !!alert.error('Unable to modify cable material element as no write access is available')
      return
  endif

--  Store element being modified

  !this.ce = !!ce

-- Initialise gadgets

  if !!ce.type.eq('CTSTRA') then
    !this.olength.val = !!ce.olength
    !this.olength.active = TRUE
  else
    !this.olength.val = 0
    !this.olength.active = FALSE
  endif

  !this.xoffset.val = !!ce.xoffset
  !this.zoffset.val = !!ce.zoffset
  !this.betaangle.val = !!ce.bangle

  !type = type

  !this.formtitle = 'Modify Cable Tray Material - $!type'

-- template data

   var !col collect all APPLDA with (purp eq 'CTMP')
    !dtext        = object ARRAY()
    !this.tmpldata = object ARRAY()
    do !app values !col
      var !zonecol collect all ZONE for $!app
      do !zone values !zonecol
       !dtext.append(!zone.dbref().namn)
       !this.tmpldata.append(!zone.dbref())
      enddo
    enddo
    !this.ctmtrlTmpdata.dtext = !dtext

-- Load types available

    if (!this.drawlist.unset()) then
      !this.drawlist = !!gphDrawlists.createDrawList()
    endif
    !this.loadTypes()

-- 3D view / local drawlist
  !this.vwView3d.shaded = true
  !viewDir[1] = 0.57735
  !viewDir[2] = 0.57735
  !viewDir[3] = -0.57735
  !this.vwView3d.direction = !viewDir

-- Add selected type to drawlist

-- Add view to global view list

   !!gphViews.add(!this.vwView3d)

  !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
  !drawlist.removeAll()
  !selectedType = !this.ctmtrlTypes.dtext[1]
  !!gphViews.limits(!this.vwView3d, !selectedType.dbref())
  !drawlist.add(!selectedType.dbref())

-- Inactivate 3D view
  !this.vwView3d.active = TRUE

-- Update view
  !this.updateView()



--   show !!cblModTmpl

endmethod

------------------------------------------------------------------------
--
-- Method: Update rules
--
-- Description: Executes all rules below cable elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRules()

-- Access template being edited

  !!ce = !this.ce

-- Execute attributes rules

  rule execute all
    handle ANY
        !!alert.error(!!error.text)
    endhandle

-- Execute repeat rules

  rule rexecute
    handle ANY
        !!alert.error(!!error.text)
    endhandle

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: dismiss
--
-- Description: Executes when form is cancelled/quit
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

-- Update rules

  !this.updateRules()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: Update rules
--
-- Description: Executes all rules below cable elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyChanges()

-- Access element being modified

  !!ce = !this.ce

-- Modify attributes

  !!ce.olength = !this.olength.val
  !!ce.xoffset = !this.xoffset.val
  !!ce.zoffset = !this.zoffset.val
  !!ce.bangle = !this.betaangle.val

-- Modify properties

-- Update attribute rules/repeat rules

  !this.updateRules()

endmethod

------------------------------------------------------------------------
--
-- Method: Loadtypes
--
-- Description: Loads available types from selected zone
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadTypes()

-- Get type of element being modified

  !type = !this.ce.type

-- Collect all types

  !zone = !!cblModTmpl.ctmtrlTmpdata.dtext[$!!cblModTmpl.ctmtrlTmpdata.val]
  var !collTypes coll all $!type for /$!zone
  var !namesoftypes eval name for all from !collTypes

-- Add to option list

  !this.ctmtrlTypes.dtext = !namesoftypes

  if !namesoftypes.size().eq(0) then
     !namesoftypes.append('None Available')
     !this.ctmtrlTypes.dtext = !namesoftypes
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: updateView
--
-- Description: Loads available types from selected zone
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateView()

  !drawlist = !this.drawlist
  !!gphDrawlists.drawlists[!drawlist].removeAll()
  !selected = !this.ctmtrlTypes.val
  !selectedType = !this.ctmtrlTypes.dtext[!selected]
  !!gphDrawlists.drawlists[!drawlist].add(!selectedType.dbref())
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3d)
  !!gphViews.limits(!this.vwView3d, !selectedType.dbref())

endmethod

------------------------------------------------------------------------
--
-- Method: updateType
--
-- Description: Loads available types from selected zone
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateType()

-- Check there are types available

  if (!this.ctmtrlTypes.dtext[$!!cblModTmpl.ctmtrlTypes.val] eq 'None Available') then
    !!alert.error('No available types for selected zone')
    return
  endif

-- Confirm that the template is to be modified

  if (!!alert.confirm('Are you sure you want to replace the existing cable tray material element?') eq 'YES') then
    !!ce = !this.ce
    !type = type
    if !type.eq('CTSTRA') then
       !olength = olength
    endif
    !savePosref = !!ce.posref
    var !level Level
    !zdist = Zdistance
    !pkdis = Pkdistance
    !xoff = Xoffset
    !zoff = Zoffset
    !bangle = Bangle
-- It is likely that the element has been locked so unlock it
    unlock all
      handle ANY
      endhandle
    delete $!type mem
    !membertoCopy = !this.ctmtrlTypes.dtext[$!!cblModTmpl.ctmtrlTypes.val]
    copy $!membertoCopy
    !!ce = !this.ce
    if !type.eq('CTSTRA') then
       olength $!olength
    endif
    posref $!savePosref
    level $!level
    zdist $!zdist
    pkdist $!pkdis
    Xoffset $!xoff
    Zoffset $!zoff
    Bangle $!bangle
    !this.updateRules()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method: updateType
--
-- Description: Loads available types from selected zone
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .editProp(!type is STRING)

-- Access correct element

  if !type.eq('MAT') then
     !!ce = !this.ce
  else
     !!ce = !this.ce
     ctfeat 1
       handle ANY
          !!alert.message('Unable to find cable tray material feature')
          return
      elsehandle NONE
        tmpl 1
          handle ANY
            !!alert.message('Unable to find cable tray material feature template')
            return
          elsehandle NONE
          endhandle
      endhandle
  endif

  !!comProp(!!ce, 'EDIT')

endmethod

------------------------------------------------------------------------
--
-- Method: copy
--
-- Description: Copies select type
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copy(!useGap is BOOLEAN)

-- Access correct element
  !!ce = !this.ce

-- Confirm with user

  if (!!alert.confirm('Are you sure you want to copy the existing cable tray material element?') eq 'NO') then
    return
  endif

  !type = type
  new $!type copy prev
  if !type.eq('CTSTRA') then
    !olength = olength
  endif
  if !!ce.seq.eq(1) then
     !gap = fgap of ctmtrl
  else
    !gap = igap of ctmtrl
  endif

  if !useGap.not() then
     !gap = 0
  endif

  if !type.eq('CTSTRA') then
    !move = !olength + !gap
  else
    !move = !gap
  endif

  !zdist = zdist
  !zdist = !zdist + !move
  zdist $!zdist

  !this.init()

endmethod

------------------------------------------------------------------------
--
-- Method: discard
--
-- Description: Discard Changes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discard()
  !!ce =  !this.ce
  !this.init()
 endmethod

--End of method definition


return
