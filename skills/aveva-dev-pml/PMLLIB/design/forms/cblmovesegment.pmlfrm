------------------------------------------------------------------------
--
-- Method:   cblMoveSegment
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblMoveSegment()

!this.quitcall  = |!this.dismiss()|
!this.initcall  = |!this.init()|
!this.formTitle = 'Move Cableway Segment'
!this.txMoveSegment.val = 0
--!this.nuMoveSegment.modifiedEvents = true
!range = object ARRAY()
!range.append(-10000)
!range.append(10000)
!range.append(1)

--!ndp = 0
--!this.nuMoveSegment.setRange(!range,!ndp )

--Material
!this.material = object ARRAY()
!this.material.append('CTSTRA')
!this.material.append('CTBEND')
!this.material.append('CTRISE')
!this.material.append('CTREDU')
!this.material.append('CTTEE')
!this.material.append('CTCROS')

--Register Aid numbers
 !this.segmentLineAidnumber     = !!aidNumbers.add('Segment')
 !this.arriveLineAidnumber      = !!aidNumbers.add('Arrive Segment')
 !this.leaveLineAidnumber       = !!aidNumbers.add('Leave Segment')
 !this.dirArrowAidnumber        = !!aidNumbers.add('Direction Arrow')
 !this.dirTextAidnumber        = !!aidNumbers.add('Direction Text')

 -- icons
 !modifyIcon     = !!pml.getPathname('accept.png')
 !discardIcon    = !!pml.getPathname('discard.png')
 !warningIcon    = !!pml.getPathname('exclamation-16.png')
 !leftArrow      = !!pml.getPathname('downarrow7x6.png')
 !rightArrow     = !!pml.getPathname('uparrow7x6.png')
 !this.issuesIcon.addPixmap(!modifyIcon)
 !this.modifyIcon.addPixmap(!modifyIcon)
 !this.warningIcon.addPixmap(!warningIcon)
 !this.discardChangesIcon.addPixmap(!discardIcon)
 !this.increaseOffset.addPixmap(!leftArrow)
 !this.decreaseOffset.addPixmap(!rightArrow)

 !this.warningMess.val = 'The following items associated with this segment may be affected if you continue the move'

 using namespace 'Aveva.Pdms.Presentation'
   -- create instance of .Net control
  !this.assosDataGrid    = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control
  !this.assosDataGrid.addeventhandler('OnPopup', !this, 'gridRightClick')
  !this.assosDataFrame.control  = !this.assosDataGrid.handle()

   -- configure grid presentation
  !this.assosDataGrid.fixedHeaders(false)
  !this.assosDataGrid.outlookGroupStyle(false)
  !this.assosDataGrid.columnExcelFilter(false)
  !this.assosDataGrid.headerSort(true)
  !this.assosDataGrid.columnSummaries(false)
  !this.assosDataGrid.singleRowSelection(true)
  !this.assosDataGrid.setAlternateRowColor('WHITE')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: Dismiss
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.enhance.clear()
  !this.clearAids()
  !!edgCntrl.remove('Pick Segment')
  !!edgCntrl.remove('Pick Point to align')
  !this.hide()

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method:   init
--
-- Description: initialisation
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

 !dbElement = !!ce
 CWBRAN
 handle ANY
 	-- reset variables
 	!this.pickedPoint  = object DBREF()
 	!this.firstPoint   = object DBREF()
 	!this.secondPoint  = object DBREF()
 	!this.prevPoint    = object DBREF()
 	!this.nextPoint    = object DBREF()
 	
 	!this.currentTag.val = 'No segment selected'
 	-- hide the gadgets
  !this.actionsFrame.visible = false
  !this.issuesApply.active   = false
  -- clear the grid
  !this.assosDataGrid.clearGrid() 	
 	return
 endhandle

 -- get the first point
 !this.pickedPoint = POINTR 1 of RPATH 1 of CE
 !!ce = !dbElement
 !this.edgSegmentActions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   getCables
--
-- Description: gets the reference cables and populate the grid control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCables()

  --reset variables
  !this.cables = object ARRAY()
  !cables      = object ARRAY()

  !nodeList = !this.getBranchNodes('RATTA')
  !nodeList.appendArray(!this.getBranchNodes('RNODE'))

  do !ratta values !nodeList
     !cables.appendArray(!ratta.lalcab)
  enddo

  !clist = !this.firstPoint.clist[0]
  !cables.appendArray(!clist)
  !cables = !cables.sortUnique()

  do  !cable values !cables
   !this.cables.append(!cable)
   !name = object ARRAY()
   !name.append(!cable.name)
   !name.append('Cable')

   -- check access rights
   if (!this.checkRights(!cable, object ARRAY())) then
    !name.append('Rights OK')
   else
    !name.append('Rights not available for auto route')
   endif

   !this.gridElements.append(!name)
  enddo

  do  !ratta values !nodeList

   !name = object ARRAY()
   !name.append(!ratta.fullName)
   if (!ratta.type eq 'RATTA') then
     !name.append('Ratta')
   else
     !name.append('Rnode')

   endif
   !name.append('Rights OK')

   !this.gridElements.append(!name)

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   getBranches
--
-- Description: gets the connected branches and populate the grid control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBranches()

 --reset variables
 !this.connectedBranches = object ARRAY()
 !this.branchOffBranches = object ARRAY()

 -- list of connected RATTA
 !rattaList = !this.getBranchNodes('RATTA')

 do !ratta values !rattaList
  -- list of connections on RATTA
  !connections = !ratta.conats
  do !con value !connections
   if !con.type.eq('HATTA') or !con.type.eq('TATTA') then
     !branch = !con.owner
   elseif !con.type.eq('RATTA') then
     !branch = !con.owner.owner
   else
     !branch = !con
   endif
    !this.connectedBranches.append(!branch.name)
    !this.branchOffBranches.append(!branch.name)
    !name = object ARRAY()
    !name.append(!branch.name)
    !name.append('Branch')
    -- check access rights
    if (!this.checkRights(!branch, object ARRAY())) then
     !name.append('Rights OK')
    else
     !name.append('Rights not available')
     !this.rights  = false
    endif
    !this.gridElements.append(!name)
  enddo
 enddo

 -- head or tail connected branches
 if !this.firstPoint.sequence.eq(1) then
  -- this is head
  !headList = !this.firstPoint.owner.owner.hdconn
  do !head values !headList
    if !head.type.eq('HATTA') or !head.type.eq('TATTA') then
     !branch = !head.owner
   elseif !head.type.eq('RATTA') then
     !branch = !head.owner.owner
   else
     !branch = !head
   endif
   !this.connectedBranches.append(!branch.name)
   !name = object ARRAY()
   !name.append(!branch.name)
   !name.append('Branch')
   -- check access rights
   if (!this.checkRights(!branch, object ARRAY())) then
    !name.append('Rights OK')
   else
    !name.append('Rights not available')
    !this.rights  = false
   endif
   !this.gridElements.append(!name)
  enddo
 endif

 if !this.nextPoint.eq(!this.secondPoint) then
  -- this is tail
  !tailList = !this.firstPoint.owner.owner.tlconn
  do !tail values !tailList
    if !tail.type.eq('HATTA') or !tail.type.eq('TATTA') then
     !branch = !tail.owner
   elseif !tail.type.eq('RATTA') then
     !branch = !tail.owner.owner
   else
     !branch = !tail
   endif
   !this.connectedBranches.append(!branch.name)
   !name = object ARRAY()
   !name.append(!branch.name)
   !name.append('Branch')
   -- check access rights
   if (!this.checkRights(!branch, object ARRAY())) then
    !name.append('Rights OK')
   else
    !name.append('Rights not available')
    !this.rights  = false
   endif
   !this.gridElements.append(!name)
  enddo
 endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   getBranchNodes
--
-- Description: gets branch nodes
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Element type
-- Return:
-- [Data Type] [Description]
--  ARRAY       List of RATTA or RNODE elements in the branch
--
------------------------------------------------------------------------
define method .getBranchNodes(!type is STRING) is ARRAY

 -- list of connected RNODE
 !tempList  = !this.firstPoint.slrbp
 !tempList.appendArray(!this.firstPoint.slrap)
 !tempList.appendArray(!this.secondPoint.slrbp)
 !tempList.appendArray(!this.secondPoint.slrap)
 !nodeList  = object ARRAY()

 do !tempItem values !tempList
  if( !tempItem.type eq !type ) then
    !nodeList.append(!tempItem)
  endif
 enddo

 !nodeList.sortUnique()

 return !nodeList

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   getSegmentNodes
--
-- Description: gets branch nodes for a single segment
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Element type or 'ALL' (RATTA+RNODE)
-- Return:
-- [Data Type] [Description]
--  ARRAY       List of RATTA or RNODE elements between points
--
------------------------------------------------------------------------
define method .getSegmentNodes(!firstPoint is DBREF, !secondPoint is DBREF, !type is STRING) is ARRAY

 -- make sure that points are in the correct order
 !firstPointNumber  = !firstPoint.sequence
 !secondPointNumber = !secondPoint.sequence
 if( !firstPointNumber eq !secondPointNumber ) then
  -- same point - so no points between
   return ARRAY()
 elseif( !firstPointNumber lt !secondPointNumber ) then
   !first  = !firstPoint
   !second = !secondPoint
 else
   !first  = !secondPoint
   !second = !firstPoint
 endif

 -- list of connected RNODE
 !tempList = !first.slrap
 !tempList.appendArray(!second.slrbp)
  !tempList.unique()
 !nodeList = object ARRAY()
 do !tempItem values !tempList
  if( !type eq 'ALL' or !tempItem.type eq !type ) then
    !nodeList.append(!tempItem)
  endif
 enddo

 return !nodeList

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   getPenetrations
--
-- Description: gets the connected penetrations and populate the grid control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPenetrations()

 --reset variables
 !this.penetrations = object ARRAY()

 -- list of connected RNODE
 !rnodeList = !this.getBranchNodes('RNODE')

 do !rnode values !rnodeList
  if !rnode.rntype.eq('PENE') then
  !assos = !rnode.assos
   do !assoc values !assos
     !mem = !assoc.members
     do !item values !mem
       if !item.type.eq('ASSMBR') then
       	if !item.amemrf.badref().not() and !item.amemrf.type.eq('FIXING') then
       	  !this.penetrations.append(!item.amemrf)
       	  !name = object ARRAY()
          !name.append(!item.amemrf.name)
          !name.append('Penetration')
          -- check access rights
          if (!this.checkRights(!item.amemrf, object ARRAY())) then
           !name.append('Rights OK')
          else
           !name.append('Rights not available')
           !this.rights  = false
          endif
          !this.gridElements.append(!name)
       	endif
       endif
     enddo
   enddo
  endif
 enddo


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   checkCableAccess
--
-- Description: checks the cable access and updates the grid control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkCableAccess()

  !failedIcon  = !!pml.getPathname('failed12.png')
  !validIcon  = !!pml.getPathname('valid12.png')

  if !this.routeCable.val then
    if !this.actionsFrame.visible then
    	do !cab values !this.cables
        --if not(!!dbRefUpdatable(!cab)) then
        if not (!this.checkRights(!cab, object ARRAY())) then
         !this.modifyApply.active = false
         !grid = !this.assosDataGrid.getRows()
         do !i from 1 to !grid.size()
          if !grid[!i].findfirst(!cab.name).set() then
            !this.assosDataGrid.setCellValue(!i,3,'No access rights to auto route cable')
            !this.assosDataGrid.setCellImage(!i,3,!failedIcon)
          endif
         enddo
        endif
      enddo
    endif
  else
     !this.modifyApply.active = true
     do !cab values !this.cables
      !grid = !this.assosDataGrid.getRows()
      do !i from 1 to !grid.size()
       if !grid[!i].findfirst(!cab.name).set() then
         !this.assosDataGrid.setCellValue(!i,3,'Rights OK')
         !this.assosDataGrid.setCellImage(!i,3,'')
       endif
      enddo
     enddo
  endif


endmethod
-- End of method definition


