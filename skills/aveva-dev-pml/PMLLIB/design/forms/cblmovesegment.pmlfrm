!this.cablePopup.add( 'CALLBACK', 'Highlight ', '!this.highlight()' )
!this.cablePopup.add( 'CALLBACK', 'Unhighlight', '!this.unhighlight()')
!this.cablePopup.add( 'SEPARATOR' )
!this.cablePopup.add( 'MENU', '3D View', 'cableSubPopup' )
!this.cablePopup.add( 'SEPARATOR' )
!this.cablePopup.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.assosDataGrid, ||, |Save As|)' )
!this.cablePopup.add( 'CALLBACK', 'Print Preview...', '!this.assosDataGrid.printpreview()' )

menu .cableSubPopup
!this.cableSubPopup.add( 'CALLBACK', 'Add Cable',                  '!this.add(|CE|)' )
!this.cableSubPopup.add( 'CALLBACK', 'Add Connected     ',         '!this.addConnected()' )
!this.cableSubPopup.add( 'CALLBACK', 'Remove Cable      ',         '!this.remove(|CE|)' )
!this.cableSubPopup.add( 'CALLBACK', 'Remove Connected  ',         '!this.removeConnected()' )

menu .branchPopup
!this.branchPopup.add( 'CALLBACK', 'Navigate', '!this.navigate()' )
!this.branchPopup.add( 'CALLBACK', 'Highlight ', '!this.highlight()' )
!this.branchPopup.add( 'CALLBACK', 'Unhighlight', '!this.unhighlight()')
!this.branchPopup.add( 'SEPARATOR' )
!this.branchPopup.add( 'MENU', '3D View', 'branchSubPopup' )
!this.branchPopup.add( 'SEPARATOR' )
!this.branchPopup.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.assosDataGrid, ||, |Save As|)' )
!this.branchPopup.add( 'CALLBACK', 'Print Preview...', '!this.assosDataGrid.printpreview()' )

menu .branchSubPopup
!this.branchSubPopup.add( 'CALLBACK', 'Add Branch',                  '!this.add(|CE|)' )
!this.branchSubPopup.add( 'CALLBACK', 'Remove Branch      ',         '!this.remove(|CE|)' )

menu .nodePopup
!this.nodePopup.add( 'CALLBACK', 'Navigate', '!this.navigate()')
!this.nodePopup.add( 'CALLBACK', 'Highlight', '!this.highlight()')
!this.nodePopup.add( 'CALLBACK', 'Unhighlight', '!this.unhighlight()')
