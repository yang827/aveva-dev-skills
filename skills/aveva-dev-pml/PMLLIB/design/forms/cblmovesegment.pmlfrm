------------------------------------------------------------------------
--
-- Method:      move
--
-- Description: modify branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .move()

  -- find RATTA on move segment
  !branchRATTA = !this.getSegmentNodes(!this.firstPoint, !this.secondPoint, 'RATTA')
  !unusedBranchRNODE = !this.getSegmentNodes(!this.firstPoint, !this.secondPoint, 'RNODE')

 -- save connection points to reinstate after the move
 !cableWayBranch = !this.firstPoint.owner.owner
 !rattaList      = !!collectAllFor('RATTA','', !cableWayBranch)
 !rattaOldPos    = ARRAY()
 do !index indices !rattaList
   !rattaOldPos[!index] = !rattaList[!index].pos
 enddo

 !rnodeList      = !!collectAllFor('RNODE','', !cableWayBranch)
 !rnodeOldPos    = ARRAY()
 do !index indices !rnodeList
   !rnodeOldPos[!index] = !rnodeList[!index].pos
 enddo

 -- move segment start and end points to new position which modifies RPATH
 !this.firstPoint.position  = !this.newFirstPosition
 !this.secondPoint.position = !this.newSecondPosition

 -- reset position of RATTA after RPATH change
 !rattaMoved     = ARRAY()
 do !index indices !rattaList
   !result = !this.cableway.repositionAttachmentPoint(!rattaList[!index], !rattaOldPos[!index])
   handle any
     !result = false
   endhandle
   !rattaMoved[!index] = !result
 enddo

 -- reset position of RNODE after RPATH change
 !rnodeMoved     = ARRAY()
 do !index indices !rnodeList
   !result = !this.cableway.repositionRoutNode(!rnodeList[!index], !rnodeOldPos[!index])
   handle any
     !result = false
   endhandle
   !rnodeMoved[!index] = !result
 enddo

 !validIcon   = !!pml.getPathname('valid12.png')
 !failedIcon  = !!pml.getPathname('failed12.png')

 -- move cables
 if !this.routeCable.val then
 	!this.reRouteCable()
 else
  --update grid
  !grid = !this.assosDataGrid.getRows()
  do !i from 1 to !grid.size()
   if !grid[!i].findfirst('Cable').set() then
     !this.assosDataGrid.setCellValue(!i,3,'Moved with segment')
     !this.assosDataGrid.setCellImage(!i,3,!validIcon)
   endif
  enddo
 endif

 -- connected branches
  !grid = !this.assosDataGrid.getRows()
  -- for each branch - check if connection has been resolved or is broken
  do !i from 1 to !grid.size()
   if (!grid[!i].findfirst('Branch').set()) then
     !branchRef = !grid[!i][1].dbRef()
     handle any
       !branchRef = object DBREF()
     endhandle
     -- connection broken if bad reference found
     !broken = badref(!branchRef)
     if( !broken.not() ) then
       !head = !branchRef.hdconn
       !tail = !branchRef.tlconn
       -- check for head connection
       !indexListRATTA = !rattaList.findfirst(!head[1])
       handle any
         !indexListRATTA = object REAL()
       endhandle
       if(!indexListRATTA.set()) then
         -- set broken to false if this RATTA has already moved successfully
         !broken = !rattaMoved[!indexListRATTA].not()
       else
        -- check for tail connection
         !indexListRATTA = !rattaList.findfirst(!tail[1])
         handle any
           !indexListRATTA = object REAL()
         endhandle
         if(!indexListRATTA.set()) then
           -- set broken to false if this RATTA has already moved successfully
           !broken = !rattaMoved[!indexListRATTA].not()
         endif
       endif
     endif
     -- set cell contents for resolved or broken connection
     if(!broken) then
       !this.assosDataGrid.setCellValue(!i,3,'Connection broken. Need correction')
       !this.assosDataGrid.setCellImage(!i,3,!failedIcon)
     else
       !this.assosDataGrid.setCellValue(!i,3,'Connection Moved')
       !this.assosDataGrid.setCellImage(!i,3,!validIcon)
     endif
   endif
  enddo

 -- move branch off branches
 do !branch values !this.branchOffBranches

   !headMove = FALSE
   !tailMove = FALSE

   !dbBranch = !branch.dbRef()
   -- see if move direction is same as leave direction of segment
   !head = !dbBranch.hdconn
   !tail = !dbBranch.tlconn

   if !head.set() then
    -- look for head connected to branch
    !indexBranchRATTA = !branchRATTA.findfirst(!dbBranch.hdconn[1])

    if (!indexBranchRATTA.set()) then
     -- look for this RATTA in the RATTA list
     !indexListRATTA = !rattaList.findfirst(!branchRATTA[!indexBranchRATTA])
     if(!indexListRATTA.set()) then
       -- skip if this RATTA has already moved successfully
       skip if(!rattaMoved[!indexListRATTA])
     endif
     !point = first POINTR of RPATH 1 of $!dbBranch
     !nextPoint = next of first POINTR of RPATH 1 of $!dbBranch
     !dressPoint = !point
     !headMove = TRUE
     !dir = !point.pdir[2].opposite().wrt(worl)
    endif
   endif

   if !tail.set() then
    -- look for tail connected to branch
    !indexBranchRATTA = !branchRATTA.findfirst(!dbBranch.tlconn[1])
    if (!indexBranchRATTA.set()) then
     -- look for this RATTA in the RATTA list
     !indexListRATTA = !rattaList.findfirst(!branchRATTA[!indexBranchRATTA])
     if(!indexListRATTA.set()) then
       -- skip if this RATTA has already moved successfully
       skip if(!rattaMoved[!indexListRATTA])
     endif
     !point = last POINTR of RPATH 1 of $!dbBranch
     !nextPoint = prev of last POINTR of RPATH 1 of $!dbBranch
     !dressPoint = !nextPoint
     !tailMove = TRUE
     !dir = !point.pdir[1].wrt(worl)
    endif
   endif

   skip if(!headMove.not() and !tailMove.not())

   if !this.txMoveSegment.val.lt(0) then
   	!actualMoveDirection = !this.offsetDir.opposite().wrt(worl)
   else
    !actualMoveDirection = !this.offsetDir.wrt(worl)
   endif

   if !actualMoveDirection.eq(!dir) then

     -- reconnect
     if !headMove then
      !pos = !dbBranch.hdconn[1].position
      !this.cableway.startFromPointInBranch(!dbBranch, !this.firstPoint.owner.owner, !pos)
     endif
     if !tailMove then
      !pos = !dbBranch.tlconn[1].position
      !this.cableway.endFromPointInBranch(!dbBranch, !this.firstPoint.owner.owner, !pos)
     endif

     if !this.dressMat.val then
      !this.preDress(!dressPoint)
      !this.finalDress(!dressPoint)
     endif

     -- update grid
     !grid = !this.assosDataGrid.getRows()
     do !i from 1 to !grid.size()
      if !grid[!i].findfirst(!branch).set() then
        !this.assosDataGrid.setCellValue(!i,3,'Branch Reconnected')
        !this.assosDataGrid.setCellImage(!i,3,!validIcon)
      endif
     enddo

   else
     -- get the segment length
     !line = object LINE(!point.position, !nextPoint.position)
     !length = !line.length()
     if !length.set() then
     	 if !length.gt(!this.txMoveSegment.val.abs()) then
     	
     	  -- reconnect
        if !headMove then
         !pos = !dbBranch.hdconn[1].position
         !this.cableway.startFromPointInBranch(!dbBranch, !this.firstPoint.owner.owner, !pos)
        endif
        if !tailMove then
         !pos = !dbBranch.tlconn[1].position
         !this.cableway.endFromPointInBranch(!dbBranch, !this.firstPoint.owner.owner, !pos)
        endif
     	
     	  if !this.dressMat.val then
     	   !this.preDress(!dressPoint)
         !this.finalDress(!dressPoint)
        endif

        -- update grid
        !grid = !this.assosDataGrid.getRows()
        do !i from 1 to !grid.size()
         if !grid[!i].findfirst(!branch).set() then
           !this.assosDataGrid.setCellValue(!i,3,'Branch Reconnected')
           !this.assosDataGrid.setCellImage(!i,3,!validIcon)
         endif
        enddo
     	 endif
     endif	
   endif


 enddo

 -- dress branch
  if !this.dressMat.val then
    -- see if material exists
    !dbElement = !!ce
    !!ce = !this.firstPoint.owner.owner
    CTMTRL 1
    handle ANY
    elsehandle NONE
     !this.loadSpec(!this.firstPoint)
     -- dress first segment
     if !this.prevPoint.neq(!this.firstPoint) then
      !this.preDress(!this.prevPoint)
      !this.finalDress(!this.prevPoint)
     endif

     -- dress second segment
     !this.preDress(!this.secondPoint)
     !this.finalDress(!this.secondPoint)
     --!this.reDress()
    endhandle
  endif


 -- show penetrations form
  !grid = !this.assosDataGrid.getRows()
   do !i from 1 to !grid.size()
    if !grid[!i].findfirst('Penetration').set() then
      !this.assosDataGrid.setCellValue(!i,3,'Needs updating')
      !this.assosDataGrid.setCellImage(!i,3,!failedIcon)
    endif
   enddo

  if !this.holeMan.val then
  	!grid = !this.assosDataGrid.getRows()
    do !i from 1 to !grid.size()
      if !grid[!i].findfirst('Penetration').set() then
        !!ce = !grid[!i][1].dbRef()
        !association = !!ce.assos[1]
        !hole = object HMHOLE(!association)
        if (!hole.fullStatus.unset() or !hole.fullStatus eq 'REJECTED') then
          call !!hmModify()
        else
          -- Bring up the hole management form and populate with the current association
          if (undefined(!!holeManMain)) then
            pml load form !!holeManMain
            !!holeManMain.show()
          elseif(!!holeManMain.shown().not()) then
            !!holeManMain.show()
          endif
          !!holeManMain.showAssocs(!!holeManMain.btnRefresh,'ADD')
          !!holeManMain.returnToAssocs()
        endif
        break
      endif
    enddo
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      discard
--
-- Description: discard changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discard()

 !this.txMoveSegment.val = 0
 !this.update(!this.txMoveSegment, '')
 !this.clearAids()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      moveOffset
--
-- Description: increment values for Offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveOffset(!action is STRING)

 !offsetValue  = !this.txMoveSegment.val
 if !offsetValue.unset() then
 	 !offsetValue  = 0
 endif

 !offsetIncrement  = !this.incrementValue.val
 if !offsetIncrement.unset() then
 	 !!alert.error('Increment value is empty')
 	 return
 endif

 if !action eq 'INCREASE' then
 	!offsetValue  = !offsetValue + !offsetIncrement
 else
  !offsetValue  = !offsetValue - !offsetIncrement
 endif

 !this.txMoveSegment.val = !offsetValue
 !this.update(!this.txMoveSegment, '')

endmethod
-- End of method definition


---------------------------------------------------------------------------
--
-- Method:      pickSegment
--
-- Description: EDG to pick segment route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickSegment(!type is STRING)

 -- clear aids
 !this.clearAids()
 !!edgCntrl.remove('Pick Segment')
 !!edgCntrl.remove('Pick Point to align')
 --reinitialize members
 !this.pickedPoint    = object DBREF()
 !packet = object EDGPACKET()
 !packet.description = 'Pick Segment'
 !packet.pickPacket.stdgraphic('Pick on the segment to be moved')
 !packet.action = '!!cblMoveSegment.derivePickedPoint(!this.return[1])'
 !packet.remove = TRUE
 !packet.pickPacket.picks[1].pick.modifiable = FALSE
 !packet.pickPacket.picks[1].numberofpicks = 1
 !packet.continue = '!!cblMoveSegment.edgSegmentActions()'
 !!edgCntrl.add(!packet)

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      derivePickedPoint
--
-- Description: derives the picked POINTR from edg pick
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePickedPoint(!pickData is EDGPICKDATA)

   !element   = !pickData.item
   if(!element.unset())then
   	 return
   endif

   -- see if it is a RATTA or RNODE or other cableway elements
   if !element.type.neq('CWBRAN') then
    if !element.type.eq('RATTA') or !element.type.eq('RNODE') then
     !this.pickedPoint         = !element.posref
     return
    elseif !this.material.findfirst(!element.type).set() then
     !this.pickedPoint         = !element.posref
     return
    elseif !this.material.findfirst(!element.owner.type).set() then
     !this.pickedPoint         = !element.owner.posref
     return
    else
      !!alert.warning('Picked element is not a cableway Segment')
      return
    endif
   endif

   !facets    = !pickData.facets
   !pointVect = !pickData.pickLine
   !lpos      = !pickData.lines

   if !facets.unset() then
    -- no facets. so pick the line
    !pickLine = object LINE(!lpos[1],!lpos[2])
    !line = !pointVect.line(100)
    !intersect = !pickLine.intersection(!line)
   else
     -- create profile from facets
     !profPos = !facets[1]
     -- get orientation from first two positions of the facets
     !facetLine = object LINE(!facets[1], !facets[2])
     !ydir = !facetLine.direction()
     !profOri = object ORIENTATION('Y is $!ydir')
     !prof    = object PROFILE(!profPos, !profOri, !facets)
     --close the profile
     !prof.close()

     -- create line from point vector
     !line = !pointVect.line(100)

     -- if line is perpendicular to profile, manipulate to intersect at some other point
     if !prof.orientation.zdir().opposite().eq(!line.direction()) or !prof.orientation.zdir().eq(!line.direction()) then
      !intersect = !prof.near(!line.startposition)
     else
     -- project line on to profile and get position
     !intersects = !prof.intersections(!line)
     !intersect  = !intersects[1]
     endif
    endif

   --construct lines along Route
   !col = object COLLECTION()
   !col.scope(!element)
   !col.type('POINTR')

   !points = !col.results()


    !routeLines = object ARRAY()
   do !i from 1 to (!points.size() - 1)
    !rline = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
    !routeLines.append(!rline)
   enddo

   -- find the nearest line to profile intersection
   !distArray = object ARRAY()
   do !j from 1 to !routeLines.size()
    !dist = !routeLines[!j].distance(!intersect)
    !distArray.append(!dist)
   enddo
    -- sort the distances to get the index of the point
    !sortDist = !distArray.sortedIndices()
    -- check if there are more points than 1
    !unusedSortDist = !sortDist[2]
    handle ANY
      !pointr = !points[!sortDist[1]]
    elsehandle NONE
    -- if the points are in same line, then find the nearest point to intersection
     !nearestPoint  =  !points[!sortDist[1]]
     !lineFirst  = object LINE(!intersect, !points[!sortDist[1]].position.wrt(worl))
     do !x from 2 to (!sortDist.size())
       if !distArray[!sortDist[1]].eq(!distArray[!sortDist[!x]]) then
        !lineSecond = object LINE(!intersect, !points[!sortDist[!x]].position.wrt(worl))
        if !lineFirst.length().gt(!lineSecond.length()) then
          !nearestPoint = !points[!sortDist[!x]]
          !lineFirst    = !lineSecond
        endif
       endif
      enddo
       !pointr  = !nearestPoint
    endhandle

   -- set the POINTR to form member after reinitializing the member
   !this.pickedPoint         = object DBREF()
   !this.pickedPoint         = !pointr

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      edgSegmentActions
--
-- Description: EDG to pick segment route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgSegmentActions()

if !this.pickedPoint.unset() then
 --!!alert.error('Segment not picked')
  return
endif

-- get the point sequence to find the segment number
!number = !this.pickedPoint.sequence.string()

-- get the branch
!branch = !this.pickedPoint.owner.owner.flnm

-- rewrite the tag
!this.currentTag.val = 'Segment ' & !number & ' of ' & !branch

--define points
!this.firstPoint    = !this.pickedPoint

!this.secondPoint   = next of $!this.pickedPoint
!this.prevPoint     = prev of $!this.pickedPoint
handle ANY
 !this.prevPoint     = !this.pickedPoint
endhandle
!this.nextPoint     = next of $!this.secondPoint
handle ANY
 !this.nextPoint     = !this.secondPoint
endhandle

-- direction
if !this.prevPoint.eq(!this.firstPoint) then
 !this.offsetDir      = !this.secondPoint.pdir[2]
else
 !this.offsetDir      = !this.pickedPoint.pdir[1]
endif
!dirString = !this.offsetDir.string().before('WRT')

-- see if string is unset
if !dirString.eq(' ') then
 !pointVect = object POINTVECTOR(!this.firstPoint.position, !this.firstPoint.pdir[2])
 !plane = !pointVect.plane()
 !ydir = !plane.orientation.ydir()
 !this.offsetDir = !ydir
 !dirString = !this.offsetDir.string().before('WRT')
endif

--update tag
!this.txMoveSegment.tag = !dirString & 'offset:'

-- positions
!this.newFirstPosition  = !this.firstPoint.position.wrt(worl)
!this.newSecondPosition = !this.secondPoint.position.wrt(worl)

-- see if all 4 points are on same plane. Else move is not possible
if !this.prevPoint.neq(!this.firstPoint) then
 !gmfplane = object GMFPLANE()
 !plane = !gmfplane.through3Points(!this.prevPoint.position.wrt(worl), !this.firstPoint.position.wrt(worl), !this.secondPoint.position.wrt(worl))
 !nearPosition = !plane.near(!this.nextPoint.position.wrt(worl))

 if !nearPosition.distance(!this.nextPoint.position.wrt(worl)) GT 1mm then
  !!alert.error('Cannot move the segment without breaking adjacent segments')
  !this.issuesApply.active 		= false
  !this.actionsFrame.visible 	= false
  return
 endif
 !this.issuesApply.active  	= true
 --!this.actionsFrame.visible = true
endif

-- reset values
!this.txMoveSegment.val = 0

-- get the mid point of picked segment
!segLine = object LINE(!this.firstPoint.position, !this.secondPoint.position)
!midPoint = !segLine.proportion(0.5)

-- aid arrow
!this.aidArrow(!this.dirArrowAidnumber, !midPoint, !this.offsetDir, 500mm)

-- aid text
!this.aidText(!this.dirTextAidnumber, !midPoint, !dirString)

-- gadgets
!this.actionsFrame.visible = false
!this.issuesApply.active   = TRUE

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: aidLine
--
-- Description: Creation of aid lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidLine(!number is REAL , !start is POSITION, !end is POSITION)

--AID LINE NUMBER $!number $!start to $!end  linestyle dashdot
  !line = object LINE(!start, !end)
  !drawLine = object GPHLINE(!line)
  !drawLine.style = 4
  !drawLine.draw(!number)

endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: aidArrow
--
-- Description: Creation of aid arrows
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidArrow(!aidNumber is REAL , !pos is POSITION, !dir is DIRECTION, !height is REAL)

 AID ARROW NUMBER $!<aidNumber> AT $!<pos> DIR $!<dir> HEIGHT $!<height>

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: aidText
--
-- Description: Creation of aid arrows
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidText(!aidNumber is REAL , !pos is POSITION, !text is STRING)

 AID TEXT NUMBER $!<aidNumber> |$!<text>| AT $!<pos>

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: clearAids
--
-- Description: Creation of aid text and lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAids()

  !!aidNumbers.hide(!this.segmentLineAidnumber)
  !!aidNumbers.hide(!this.arriveLineAidnumber)
  !!aidNumbers.hide(!this.leaveLineAidnumber)
  !!aidNumbers.hide(!this.dirArrowAidnumber)
  !!aidNumbers.hide(!this.dirTextAidnumber)

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: update
--
-- Description: update positions and aids
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update(!dummyGadget is GADGET, !dummyAction is STRING)
 if(!this.firstPoint.unset() or !this.secondPoint.unset())then
 	 !!alert.warning('Cableway segment is not picked')
 	 return
 	endif

-- offset positions
 !moveValue = !this.txMoveSegment.val
 !this.newFirstPosition  = !this.firstPoint.position.offset(!this.offsetDir, !moveValue)
handle (2,785)
endhandle
 !this.newSecondPosition = !this.secondPoint.position.offset(!this.offsetDir, !moveValue)
handle (2,785)
endhandle
-- clear aids
!!aidNumbers.hide(!this.segmentLineAidnumber)
!!aidNumbers.hide(!this.arriveLineAidnumber)
!!aidNumbers.hide(!this.leaveLineAidnumber)

-- draw the aids
!this.aidLine(!this.segmentLineAidnumber, !this.newFirstPosition, !this.newSecondPosition)
if( !this.prevPoint neq !this.firstPoint ) then
  !this.aidLine(!this.arriveLineAidnumber, !this.prevPoint.position, !this.newFirstPosition)
endif
if( !this.nextPoint neq !this.secondPoint ) then
  !this.aidLine(!this.leaveLineAidnumber, !this.nextPoint.position, !this.newSecondPosition)
endif

-- hide frame
!this.actionsFrame.visible = FALSE

endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: updateGrid
--
-- Description: find the issues and updates the grid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGrid()

-- initialise array
!this.gridElements = object ARRAY()
!this.rights       = TRUE

--if !this.nuMoveSegment.val.eq(0) then
--  !this.assosDataGrid.clearGrid()
--  !!alert.message('Offset values should not be equal to 0')
--  return
--endif


-- connected branches
!this.getBranches()

--penetrations
!this.getPenetrations()

-- cables
!this.getCables()

-- headings
 !headings = ARRAY()
 !headings.append('Associated Items')
 !headings.append('Type')
 !headings.append('Status')

 -- bind to data
 using namespace 'Aveva.Pdms.Presentation'
 !nds = object NETDATASOURCE('Data', !headings, !this.gridElements)
 !this.assosDataGrid.bindToDataSource(!nds)

 ---- set the pixmap
 --!rows = !this.assosDataGrid.getNumberRows()
 --!icon   = !!pml.getPathname('failed12.png')
 --do !i from 1 to !rows
 --  !this.assosDataGrid.setCellImage(!i,3,!icon)
 --enddo

 --make the grid visible
 !this.actionsFrame.visible = TRUE

 --access rights
 if !this.rights then
   !this.modifyApply.active = TRUE
 else
   !this.modifyApply.active = FALSE
 endif

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method:      gridRightClick
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridRightClick(!data is ARRAY)

  if( !this.assosDataGrid.getSelectedRows()[1][2].upcase() eq 'CABLE') then
    !this.assosDataFrame.popup = !this.cablePopup
  elseif( !this.assosDataGrid.getSelectedRows()[1][2].upcase() eq 'BRANCH') then
    !this.assosDataFrame.popup = !this.branchPopup
  else
    !this.assosDataFrame.popup = !this.nodePopup
  endif

  !this.assosDataFrame.showPopup(!data[0], !data[1])

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: add to drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!type is STRING)

 if !type.eq('CE') then
  !element = !this.assosDataGrid.getSelectedRows()[1][1]
  add $!element
 endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: remove drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!type is STRING)

  if !type.eq('CE') then
  !element = !this.assosDataGrid.getSelectedRows()[1][1]
  remove $!element
  endif

endmethod
-- End of method definition for .removeCable()

------------------------------------------------------------------------
--
-- Method:      addConnected
--
-- Description: add the Connected Equipment or ELCONN for the Cable to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addConnected()

  !element = !this.assosDataGrid.getSelectedRows()[1][1]

  !start  = !element.dbRef().staref
  ADD $!start
  handle any
  endhandle
  !end    = !element.dbRef().endref
  ADD $!end
  handle any
  endhandle

endmethod
-- End of method definition for .addConnected()
------------------------------------------------------------------------
--
-- Method:      removeConnected
--
-- Description: remove the Connected Equipment or ELCONN for the Cable to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeConnected()

  !element = !this.assosDataGrid.getSelectedRows()[1][1]

  !start  = !element.dbRef().staref
  REMOVE $!start
  handle any
  endhandle
  !end    = !element.dbRef().endref
  REMOVE $!end
  handle any
  endhandle

endmethod
-- End of method definition for .removeConnected()


------------------------------------------------------------------------
--
-- Method:      highlight
--
-- Description: highlight element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight()

  !element = !this.assosDataGrid.getSelectedRows()[1][1]
  add $!element
  !this.enhance.addItem(!element.dbRef())
  !this.enhance.refresh()

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      Unhighlight
--
-- Description: Unhighlight element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unhighlight()

  !element = !this.assosDataGrid.getSelectedRows()[1][1]
  add $!element
  !this.enhance.removeItem(!element.dbRef())
  !this.enhance.clear()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: navigates to selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

  !element = !this.assosDataGrid.getSelectedRows()[1][1]
  !!ce = !element.dbRef()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      reRouteCable
--
-- Description: Re route the cable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reRouteCable()

  !validIcon   = !!pml.getPathname('valid12.png')
  !failedIcon  = !!pml.getPathname('failed12.png')

  !manager = object CABLEMANAGER()
  -- auto route cable
  do !cable values !this.cables
    -- route and update grid
    !grid = !this.assosDataGrid.getRows()
    !route = !manager.routeCable(!cable)
    handle ANY
      !!alert.error(!!error.text)
      !route = FALSE
    endhandle

    if (!route) then
      do !i from 1 to !grid.size()
        if (!grid[!i].findfirst(!cable.name).set()) then
          !this.assosDataGrid.setCellValue(!i,3,'Auto Routed')
          !this.assosDataGrid.setCellImage(!i,3,!validIcon)
          break
        endif
      enddo
    else
      do !i from 1 to !grid.size()
        if (!grid[!i].findfirst(!cable.name).set()) then
          !this.assosDataGrid.setCellValue(!i,3,'Could not Auto route')
          !this.assosDataGrid.setCellImage(!i,3,!failedIcon)
          break
        endif
      enddo
    endif
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: align
--
-- Description: align with element
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .align()

   if !this.firstPoint.unset() then
    !!alert.error('Please pick a segment')
    return
   endif

   !!edgCntrl.remove('Pick Segment')
   !!edgCntrl.remove('Pick Point to align')
   !!cblMoveSegment.pickedPosForAlign = object POSITION()

   !packet = object EDGPACKET()
   !packet.description = 'Pick Point to align'
   !packet.action      = '!!cblMoveSegment.pickedPosForAlign = !this.return[1].position.wrt(worl)'
   --!packet.definePosition('Pick to define position')
   !packet.pickPacket.stdposition('Pick to define position')
   !packet.priority    = 2
   !packet.remove      = TRUE
   !packet.continue = '!!cblMoveSegment.distance()'
   !!edgCntrl.add(!packet)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: distance
--
-- Description: calculates the distance of RATTA position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distance()

  if(!this.pickedPosForAlign.unset())then
  	return
  endif

  !pointVect = object POINTVECTOR(!this.firstPoint.position, !this.offsetDir)
  !line = !pointVect.line(1000 mm)

  -- get the distance
  !newline = object LINE()
  !newline.startposition  = !line.startposition
  !newline.endposition    = !line.near(!this.pickedPosForAlign)

  -- get length
  !length = !newline.length()

  if !newline.direction().eq(!this.offsetDir) then
    !this.txMoveSegment.val = !length
  else
    !this.txMoveSegment.val = !length * -1
  endif

  --update graphics
  !this.update(!this.txMoveSegment, '')
endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: loadSpec
--
-- Description: loads the specification data
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadSpec(!point is DBREF)

     --get the spec
   !dbElement = !!ce
   -- navigate to branch
   !!ce = !point.owner.owner
   CTMTRL 1
   handle ANY
   elsehandle NONE
   	!spec = !!ce.ctspe
   	
   	-- load spec values
   	if !spec.set() then
   		if !spec.neq(!this.loadedSpec) then  	
   	    -- units
         !savedUnits = object COMUNITS(true)
         UNITS MM DIST
         UNITS MM BORE

         !valueArray  = !!cbltraydimfromspec(!spec,'CTBEND')
         if !valueArray.set() then
          !this.cableTrayManager.readdefaultdimforctbend(!valueArray)
         endif

         !valueArray  = !!cbltraydimfromspec(!spec,'CTSTRA')
         if !valueArray.set() then
          !this.cableTrayManager.readdefaultdimforctstra(!valueArray)
         endif

         !valueArray  = !!cbltraydimfromspec(!spec,'CTREDU')
         if !valueArray.set() then
          !this.cableTrayManager.readdefaultdimforctredu(!valueArray)
         endif

         !valueArray  = !!cbltraydimfromspec(!spec,'CTTEE')
         if !valueArray.set() then
          !this.cableTrayManager.readdefaultdimforcttee(!valueArray)
         endif

         !valueArray  = !!cbltraydimfromspec(!spec,'CTRISE')
         if !valueArray.set() then
          !this.cableTrayManager.readdefaultdimforctrise(!valueArray)
         endif

         !valueArray  = !!cbltraydimfromspec(!spec,'CTCROS')
         if !valueArray.set() then
          !this.cableTrayManager.readdefaultdimforctcros(!valueArray)
         endif

         -- reset units
         !savedUnits.restoreSavedUnitsByPtype('DIST')
         !savedUnits.restoreSavedUnitsByPtype('BORE')

         --load member
         !this.loadedSpec = !spec
       endif
     endif
   	
   endhandle
   !!ce = !dbElement

endmethod
--End of method definition


------------------------------------------------------------------------
--
-- Method: checkRights
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF       Element to check access
--    1   R     ARRAY       array of attributes to modify
-- Return:
--   [Data Type] [Description]
--    1   R     BOOLEAN       Access rights
------------------------------------------------------------------------

define method .checkRights(!dbElement is DBREF, !attrib is ARRAY) is BOOLEAN

 !rights  = TRUE

 --check db write access
 !write = !dbElement.dbwrite
 if !write.not() then
  return FALSE
 endif

 --lock
 !lock = !dbElement.lock
 if !lock then
  return FALSE
 endif

 -- multiwrite or update
 !multi = !dbElement.dbaccess
 if !multi.eq('MULTIWRITE') then

  -- see if element is claimed
  if !dbElement.lclm then
  	-- see if the current user has claimed it
  	var !user user
  	if !user.neq(!dbElement.userC) then
     return FALSE
    endif
  else
   -- see if element can be claimed
  	!claim = !dbElement.okclaim
  	if !claim.not() then
  	 return FALSE
    endif
  endif

  -- see if DAC allows to claim the element
  !dacClaim = !dbElement.daccla
  if !dacClaim.not() then
   return FALSE
  endif

  -- see if passed attributes can be modified with DAC
  if !attrib.size().gt(0) then
    do !att values !attrib
     !modifiable = !dbElement.modatt.$!<att>
     handle ANY
     	skip
     elsehandle NONE
      if !modifiable.not() then
       return FALSE
      endif
     endhandle
    enddo
  endif

 endif

 -- all fine so return true
 return !rights


endmethod

------------------------------------------------------------------------
--
-- Method: preDress
--
-- Description: preliminary dress the segment
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preDress(!point is DBREF)

  -- find if CTMTRL exists
  !!ce = !point.owner.owner
  CTMTRL 1
  handle ANY
  elsehandle NONE

  -- delete members of segment
  !posref = !point
  !depref = !posref.depref
  do !mat values !depref
    -- see if the DEPREF is a material element
    if !this.material.findfirst(!mat.type).set() then
      !!ce = !mat
      !type = !!ce.type
      delete $!type
    endif
  enddo

  -- do preliminary dressing
  !this.cableTrayManager.setConduct(0)
  !this.cableTrayManager.dresssegment(!point)
 endhandle

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: finalDress
--
-- Description: preliminary dress the segment
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .finalDress(!point is DBREF)

  -- apply Material
  !matElements = object ARRAY()

  !posref = !point
  !depref = !posref.depref
  do !mat values !depref
    -- see if the DEPREF is a material element
    if !this.material.findfirst(!mat.type).set() then
      !matElements.append(!mat)
    endif
  enddo

  if !matElements.set() then

   if undefined(!!cblmtrl) then
     pml load form !!cblmtrl
     hide !!cblmtrl
   endif

   -- set material form member
   !dbElement = !!ce
   !!ce = !point.owner.owner
   CTMTRL 1
   !!cblmtrl.cableway.ctmtrl = !!ce
   !!ce = !dbElement

   -- dress
   do !dress values !matElements
    !!cblmtrl.applyMaterial(!dress)
   enddo
  endif

endmethod
--End of method definition
