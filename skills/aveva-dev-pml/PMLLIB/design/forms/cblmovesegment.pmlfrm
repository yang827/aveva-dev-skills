--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING)                      -                   add to drawlist
--  addConnected()                   -                   add the Connected Equipment or ELCONN for the Cable to the view
--  aidArrow(REAL,POSITION,DIRECTION,REAL) -
--  aidLine(REAL,POSITION,POSITION)  -
--  aidText(REAL,POSITION,STRING)    -
--  align()                          -                   align with element
--  cblMoveSegment()                 -                   Constructor
--  checkCableAccess()               -                   checks the cable access and updates the grid control
--  checkRights(DBREF,ARRAY)         BOOLEAN
--  clearAids()                      -                   Creation of aid text and lines
--  derivePickedPoint(EDGPICKDATA)   -                   derives the picked POINTR from edg pick
--  discard()                        -                   discard changes
--  dismiss()                        -
--  distance()                       -                   calculates the distance of RATTA position
--  edgSegmentActions()              -                   EDG to pick segment route point
--  finalDress(DBREF)                -                   preliminary dress the segment
--  getBranchNodes(STRING)           ARRAY               gets branch nodes
--  getBranches()                    -                   gets the connected branches and populate the grid control
--  getCables()                      -                   gets the reference cables and populate the grid control
--  getPenetrations()                -                   gets the connected penetrations and populate the grid control
--  getSegmentNodes(DBREF,DBREF,STRING) ARRAY               gets branch nodes for a single segment
--  gridRightClick(ARRAY)            -                   Right click options
--  highlight()                      -                   highlight element
--  init()                           -                   initialisation
--  loadSpec(DBREF)                  -                   loads the specification data
--  modifyBranch()                   -                   modify branch
--  modifyCable()                    -                   modify cable
--  modifyPene()                     -                   modify branch
--  move()                           -                   modify branch
--  moveOffset(STRING)               -                   increment values for Offset
--  navigate()                       -                   navigates to selected element
--  pickSegment(STRING)              -                   EDG to pick segment route point
--  preDress(DBREF)                  -                   preliminary dress the segment
--  reRouteCable()                   -                   Re route the cable
--  remove(STRING)                   -                   remove drawlist
--  removeConnected()                -                   remove the Connected Equipment or ELCONN for the Cable to the view
--  unhighlight()                    -
--  update(GADGET,STRING)            -                   update positions and aids
--  updateGrid()                     -                   find the issues and updates the grid
--

-- Import DLL
import 'GridControl'
handle any
endhandle
import 'PositionControl'
handle ANY
endhandle
Import 'pmlfilebrowser'
handle any
endhandle

setup form !!cblMoveSegment dialog dock right Noalign

paragraph .identifyTag   anchor l+t    at x0.1       ymax+0.5    text  'Identify Segment : ' width 15
button    .bnpickSegment linklabel  'Pick...'  anchor l+t    at xmax       ymin         callback '!this.pickSegment(|SEGMENT|)'
paragraph .currentTag    anchor l+t    at xmax.identifyTag       ymax        text  'Current Branch : ' width 30

--numericinput .nuMoveSegment   'Offset:'  anchor l+t at x0.1   ymax+1   tagwidth 11  callback '!this.update('  width 6
text      .txMoveSegment       'Offset: '   anchor l+t       at x0.1        ymax+1        callback  '!this.update('    tagwidth 15  width 10 is REAL format !!distanceFmt
button    .pickAlign linklabel  'Align...'  anchor l+t    at xmax+1       ymin         callback '!this.align()'  width 5
paragraph .increment    anchor l+t    		              	at xmin.txMoveSegment       ymax        text  'Increment:' width 14
text      .incrementValue         anchor l+t       at xmax+1          ymin       callback ''  width 9 is REAL  format !!distanceFmt
button    .decreaseOffset         anchor l+t       at xmax            ymin        pixmap callback '!this.moveOffset(|DECREASE|)' tooltip 'Decrease Offset'  width 7 height 6
button    .increaseOffset        anchor l+t        at xmin            ymax        pixmap callback '!this.moveOffset(|INCREASE|)' tooltip 'Increase Offset'  width 7 height 6


toggle    .routeCable            anchor l+t       at x1      ymax+0.5   'Re-route Cables' callback '!this.checkCableAccess()'
toggle    .dressMat              anchor l+t       at x1      ymax       'Re-dress Materials'
toggle    .holeMan               anchor l+t       at x1      ymax       'Display Hole Manager'

paragraph .issuesIcon         anchor l+t    at x0   ymax+1         pixmap width 16 height 16
button    .issuesApply  linklabel   'Show Issues'      anchor l+t    at xmax+1          ymin         callback '!this.updateGrid()'

-- action frame
frame .actionsFrame panel anchor l+t at x0 ymax
 line      .actionsLine  anchor l+t       at x0            ymax         horizontal width 39
 paragraph .warningIcon  anchor l+t       at x0.1          ymax+0.5    pixmap width 16 height 16
 paragraph .warningTag   anchor l+t       at xmax+1        ymin    text  'Warning' width 15
 paragraph .warningMess  anchor l+t       at x0.1          ymax+0.5    text  '' width 35 lines 2

 paragraph .modifyIcon         anchor l+t    at x0   ymax+1         pixmap width 16 height 16
 button    .modifyApply  linklabel   'Move Segment'      anchor l+t    at xmax+1          ymin         callback '!this.move()'
 paragraph .discardChangesIcon        anchor l+t    at xmax+1                ymin         pixmap width 16 height 16
 button    .discardChangesApply linklabel   'Discard Changes'    anchor l+t    at xmax+1       ymin         callback '!this.discard()'

 frame  .assosFrame  panel    anchor l+t  at x0.1 ymax+0.5  height 12 width 40
    -- define PML Container to host .Net control
    container .assosDataFrame PMLNetCONTROL 'NET'  DOCK FILL
  exit
exit

menu .cablePopup
