--
-- File:           cblmtrl.pmlfrm
-- Type:           Form Definition
-- Group:          Cabling Application
--
-- Keyword:        CABLING
-- Module:         design
-- Replaces:
--
-- Author:         Anand Kalathil
-- Created:        Tue Mar 27 2007
-- Last Modified:
-- Description:
-- Cableway Material creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addTier(GADGET,STRING)           -                   Sets the number of tiers
--  align()                          -                   align with element
--  alignWithGridlines()             -                   align with Gridline
--  applyMaterial(DBREF)             -                   Creates CTRAY and assigns spref
--  autoNameCe(STRING)               -                   Autonaming elements
--  autoNameElements()               -                   sets the levels for material element
--  back()                           -                   method to navigate back to previous task
--  backwards()                      -                   switches to back or forward mode
--  cblmtrl()                        -                   Constructor
--  changeMode(STRING,STRING)        -                   changes the task mode
--  checkLoadedSpec()                ARRAY               check if correct spec or template is loaded
--  chooseMaterial(DBREF)            -                   creates CTRAY and assigns spref
--  clearAids()                      -                   Creation of aid text and lines
--  copy(BOOLEAN)                    -                   Copies select type
--  create(STRING)                   -                   Create Elements
--  createBendAndRiser(DBREF)        -                   creates bends and risers
--  createData(STRING)               -                   Load the element data into create gadgets
--  createTeeAndCross(DBREF)         -                   creates tee and cross
--  ctElementGadgets(STRING,STRING)  -                   Sets the  gadgets for the element type
--  ctmtrlgadgets(STRING)            -                   Sets the  gadgets required to create and modify
--  currentElement()                 -                   Loads the data of current Element to form
--  cutAdjacentStraights(DBREF)      -
--  derivePickedPoint(EDGPICKDATA)   -                   derives the picked POINTR from edg pick
--  deriveRemovePoint(EDGPICKDATA)   -                   derive the reference point of segment
--  dimensionSetup()                 -                   Sets up the dimension defaults
--  discard()                        -                   Discard Changes
--  dismiss()                        -
--  displayElement()                 -                   sets the levels for material element
--  distance()                       -                   calculates the distance of RATTA position
--  distance(EDGPICKDATA)            -                   calculates the distance of RATTA position
--  dressBetweenComponents()         -                   sets the member and calls the method to dress between components
--  dressMultipleSegments()          -                   dress multiple segments in straight line
--  dressPoint()                     -                   Find the nearest point of pick
--  dressRatta()                     -                   dress the RATTA
--  dressSegment(STRING)             -                   method to call the segment dress function
--  dressWithStraights()             -                   sets the member and calls the method to dress between components
--  edgPopulate(STRING)              -                   EDG to pick route point
--  editProp(STRING)                 -                   Edits the properties
--  fillBranch()                     -                   fills the branch
--  fillWithStraights()              -
--  findOffset(REAL,REAL)            REAL
--  findPick(DBREF)                  DBREF
--  findPrevious()                   -                   sets the previous element
--  findSpecification (DBREF)        DBREF
--  firstShownCallback()             -                   callback for first show of form
--  getAngle(DBREF)                  REAL                gets the angle for bends
--  getGap()                         REAL
--  getHeight(DBREF)                 REAL                gets the height of tray
--  getLength(POSITION,POSITION)     REAL                Calculates the length between two positions
--  getNearestWidth(REAL)            REAL                gets the nearest valid width (for imperial units)
--  getTeeSide(DBREF)                STRING              finds if tee is left or right handed
--  getTierHeight(DBREF)             ARRAY               gets the tier heights of tray
--  getWidth(DBREF)                  REAL                gets the width of tray
--  loadAppDimensions()              -                   Loads the application data world dimensions
--  loadAppDimensionsFromFile()      -                   Loads the application data world dimensions
--  loadData(STRING)                 -                   Load the element data into gadgets
--  loadObjectMembers(STRING)        -                   Loads members of cableway object
--  loadSpecDimensions()             -                   Loads the application data world dimensions
--  loadTmplDimensions()             -
--  loadTypes()                      -
--  modify(DBREF)                    -                   modify the elements using preliminary dressing gadget values
--  modify(STRING)                   -                   modify the elements
--  modifyLengthCtray(DBREF)         -
--  moveZdis(STRING,GADGET)          -                   sets the zdistance incremental value
--  nameCheck(STRING)                -                   Check the correctness of the name
--  offsetDistance()                 -                   Distance from start of segment for offset
--  pick()                           -                   pick elements for filling straights in between
--  pick(STRING)                     -                   pick the points and positions from branch
--  pickElement(STRING)              -
--  pickMultiple()                   -                   pick elements for filling multiple segments in line
--  pickPoint(STRING)                -
--  pickRatta(STRING)                -
--  pickSegment(STRING)              -
--  posFromPrev()                    -                   Set gap from prev
--  removeDress(STRING)              -                   deletes CTRAY
--  removeMaterial(DBREF)            -                   deletes CTRAY
--  removeTier(GADGET)               -                   removes the selected tier
--  setMatSpec()                     -                   sets the specification for CTMTRL
--  setPreliminary(DBREF)            -
--  setSpec()                        -                   sets the specification for CTRAY
--  setTask(STRING,STRING)           -
--  showCblListCables()              -                   Show CblListCables form
--  specWidth()                      -
--  switchMode()                     -                   switches to back or forward mode
--  tmplWidth()                      -                   gets the available widths from templates
--  track()                          -
--  updateFrame()                    -                   updates the element creation frame
--  updateRules()                    -
--  updateView()                     -                   Loads available types from selected zone
--  updateZdistance()                -                   updates the zdistance gadget
--  validateHeight()                 -                   Validates the tray height
--  validateWidth(GADGET,STRING)     -                   Validates the tray width
--

setup form !!cblmtrl dialog dock right

   --track    'DESICE'    callback '!this.track()'


   frame .ctmtrlframe panel anchor l+t at x0 y0
     paragraph .cwbranownTag           anchor l+t       at x0.1       ymax            text  '' width 35
     paragraph .cwbranTag              anchor l+t       at x0.1       ymax            text  '' width 35
     paragraph .ctmtrlNameTag          anchor l+t       at x0.1       ymax+0.1        text  'Material Name:' width 11
     text      .ctmtrlName             anchor l+t       at xmax       ymin            callback '!this.nameCheck(|CTMTRL|)'      width 23 is STRING
     button    .autoName               anchor r+t         at xmax+0.5   ymin          pixmap callback '!this.autoNameCe(|CTMTRL|)' tooltip 'Autoname' width 16 height 16
     button    .ctmtrlcurrElement 'CE' linklabel  anchor l+t  at x0.1   ymax+0.4      callback '!this.currentElement()' tooltip 'Select an Element and modify'
     paragraph .ctmtrlattrib           anchor l+t       at x0.1       ymax+0.1        text  'Attributes'
     line      .ctmtrlLine             anchor l+t       at x0         ymax            horizontal                    width 39
     paragraph .ctmtrlspecpara         anchor l+t       at x0.1       ymax+0.5        text  'Specification :   '
     option    .ctmtrlSpec             anchor l+t       at xmax+0.1   ymin            callback '' width 16
     paragraph .ctmtrlDescTag          anchor l+t       at x0.1       ymax            text  'Description:      '
     text      .ctmtrlDesc             anchor l+t       at xmax+0.1   ymin            callback ''                   width 18 is STRING
     paragraph .ctmtrlFuncTag          anchor l+t       at x0.1       ymax            text  'Function:         '
     text      .ctmtrlFunc             anchor l+t       at xmax+0.1   ymin            callback ''                   width 18 is STRING
     paragraph .ctmtrlPurpTag          anchor l+t       at x0.1       ymax            text  'Purpose:          '
     text      .ctmtrlPurp             anchor l+t       at xmax+0.1   ymin            callback ''                   width 18 is STRING
     paragraph .ctmtrlfgapTag          anchor l+t       at x0.1       ymax            text  'First Gap :       '
     text      .ctmtrlfgap             anchor l+t       at xmax+0.1   ymin            callback '!!gdgtDatChk(!this.ctmtrlfgap)'     width 18 is REAL  format !!distanceFmt
     paragraph .ctmtrligapTag          anchor l+t       at x0.1       ymax            text  'Intermediate Gap :'
     text      .ctmtrligap             anchor l+t       at xmax+0.1   ymin            callback '!!gdgtDatChk(!this.ctmtrligap)'                   width 18 is REAL  format !!distanceFmt
     paragraph .ctmtrllgapTag          anchor l+t       at x0.1       ymax            text  'Last Gap :        '
     text      .ctmtrllgap             anchor l+t       at xmax+0.1   ymin            callback '!!gdgtDatChk(!this.ctmtrllgap)'                  width 18 is REAL  format !!distanceFmt
     paragraph .ctmtrlTheiTag          anchor l+t       at x0.1       ymax            text  'Tier Heights :    '
     combobox  .ctmtrlThei             anchor l+t       at xmax+0.1   ymin            callback '!this.addTier(' width 16
     paragraph .ctmtrltraywidthTag     anchor l+t       at x0.1       ymax            text  'Width :           '
     text      .ctmtrltraywidth        anchor l+t       at xmax+0.1   ymin            callback '!this.validateWidth(' width 18 is REAL  format !!distanceFmt
     paragraph .ctmtrltrayheightTag    anchor l+t       at x0.1       ymax            text  'Height :          '
     text      .ctmtrltrayheight       anchor l+t       at xmax+0.1   ymin            callback '!this.validateHeight()' width 18 is REAL  format !!distanceFmt
     button    .autonamemat  linklabel   'Autoname Elements '  anchor l+t    at x0.1       ymax+0.5         callback '!this.autoNameElements()'
     button    .ctmListCables linklabel 'List Associated Cables...' anchor l+t   at x0 ymax+1           callback |!this.showCblListCables()| width 15
     paragraph .creatematIcon                             anchor l+t    at x0           ymax+1       pixmap width 16 height 16
     button    .createmat  linklabel   'Create '          anchor l+t    at xmax+1       ymin         callback '!this.create(|CTMTRL|)'
     paragraph .modifymatIcon                             anchor l+t    at x0           ymin       pixmap width 16 height 16
     button    .modifymat  linklabel   'Apply Changes '   anchor l+t    at xmax+1       ymin         callback '!this.modify(|CTMTRL|)'
     paragraph .discardmatIcon                            anchor l+t    at xmax+1       ymin         pixmap width 16 height 16
     button    .discardmat  linklabel  'Discard Changes ' anchor l+t    at xmax+1       ymin         callback '!this.discard()'

     paragraph .ctmtrldress          anchor l+t       at x0.1       ymax+0.5        text  'Preliminary Dressing'
     line      .ctmtrldressLine      anchor l+t       at x0         ymax            horizontal                    width 39
     button    .ctmtrluserdress       linklabel   'Dimensions defined by user...'             anchor l+t    at x1       ymax             callback '!this.setTask(|MODIFY|,|USERPRELIMINARY|)'
     button    .ctmtrloptidress       linklabel   'Dimensions based on branch fill levels...' anchor l+t    at x1       ymax             callback '!this.setTask(|MODIFY|,|OPTIPRELIMINARY|)'

     paragraph .ctmtrlOptdress          anchor l+t       at x0.1       ymax+0.5        text  'Other Dressing options'
     line      .ctmtrlOptdressLine      anchor l+t       at x0         ymax            horizontal                    width 39
     button    .templatedress         linklabel   'Dress using templates...'                  anchor l+t    at x1       ymax             callback '!this.setTask(|MODIFY|,|TEMPLATE|)'
     button    .elementcreate         linklabel   'Explicit Dressing...'                      anchor l+t    at x1       ymax             callback '!this.setTask(|CREATE|,|CTSTRA|)'
  --   button    .mainReorderCableTray  linklabel   'Sort trays components'              anchor l+t    at x1       ymax         callback '!this.cableway.reorderCableTray(!this.cableway.cwbran)'

     paragraph .mainunfillmatIcon anchor l+t    at x1 ymax+0.5       pixmap width 16 height 16
     paragraph .mainunfillOptTag            anchor l+t       at xmax+1         ymin            text  'Remove Dressing'     width 30
     line      .mainunfillOptLine       anchor l+t       at x0         ymax            horizontal width 39
     button    .mainbranchunfill      linklabel   'From Branch'                        anchor l+t    at x1       ymax         callback '!this.cableway.undress(!this.cableway.cwbran)'
     button    .mainpickedsegunfill   linklabel   'From Segment...'                    anchor l+t    at x1       ymax         callback '!this.pickElement(|SEGMENT|)'
     button    .mainpickedeleunfill   linklabel   'From Point...'                      anchor l+t    at x1       ymax         callback '!this.pickElement(|ELEMENT|)'
     button    .mainstrunfill         linklabel   'All Straights from Branch'          anchor l+t    at x1       ymax         callback '!this.cableway.unfillstraights(!this.cableway.ctmtrl)'
     button    .mainpickedstraunfill  linklabel   'All Straights from Segment...'      anchor l+t    at x1       ymax         callback '!this.pickElement(|STRAIGHT|)'

   exit

   frame .predress panel anchor l+t at x0 y0

    frame .tmplOptFrame FoldupPanel 'Dimension Options'  anchor l+t  at x0.1  y0.5  width 40
     paragraph .tmplAppdataTag          anchor l+t       at x1     ymax            text  '                  '
     option  .ctmtrlTmpdata             anchor l+t       at xmax   ymin            callback '!this.loadTmplDimensions()' width 16
     paragraph .tmploptMessage          anchor l+t       at x1     ymax+0.5            text  '' width 37 lines 3
     toggle  .userLength                anchor l+t       at x1     ymax       'Dress with user defined tray lengths' callback ''
    exit

    frame .dressOptFrame FoldupPanel 'Dimension Options'  anchor l+t  at x0.1  y0.5  width 40
     paragraph .ctmtrlAppdataTag            anchor l+t       at x1         ymax            text  '                  '
     option  .ctmtrlAppdata             anchor l+t       at xmax   ymin            callback '!this.loadAppDimensions()' width 16
     paragraph .ctmtrlSpecdataTag            anchor l+t       at x1         ymax            text  '                  '
     option  .ctmtrlSpecdata            anchor l+t       at xmax   ymin            callback '!this.loadSpecDimensions()' width 16
     button  .loadFiledata     linklabel   'Load from File... '    anchor l+t    at x1       ymax         callback '!this.loadAppDimensionsFromFile()'
     paragraph .optMessage            anchor l+t       at x1         ymax            text  '' width 37 lines 2
    exit

     paragraph .straLengthTag          anchor l+t       at x1       ymax+0.5          text  '                          '
     text      .straLength             anchor l+t       at xmax+0.1   ymin            callback ''  width 12 is REAL format !!distanceFmt

    frame .pdressframe FoldupPanel 'Attributes'  anchor l+t  at x0.1  ymax+0.5  width 40
     paragraph .pdressfgapTag          anchor l+t       at x0.5       ymax            text  'First Gap :       '
     text      .pdressfgap             anchor l+t       at xmax+0.1   ymin            callback ''                   width 18 is REAL  format !!distanceFmt
     paragraph .pdressigapTag          anchor l+t       at x0.5       ymax            text  'Intermediate Gap :'
     text      .pdressigap             anchor l+t       at xmax+0.1   ymin            callback ''                   width 18 is REAL  format !!distanceFmt
     paragraph .pdresslgapTag          anchor l+t       at x0.5       ymax            text  'Last Gap :        '
     text      .pdresslgap             anchor l+t       at xmax+0.1   ymin            callback ''                   width 18 is REAL  format !!distanceFmt
     paragraph .pdresstraywidthTag     anchor l+t       at x0.5       ymax            text  'Width :           '
     option    .pdresstraywidth        anchor l+t       at xmax+0.1   ymin            callback '!this.validateWidth(' width 16
     paragraph .pdresstrayheightTag    anchor l+t       at x0.5       ymax            text  'Height :          '
     text      .pdresstrayheight       anchor l+t       at xmax+0.1   ymin            callback '!this.validateHeight()' width 18 is REAL  format !!distanceFmt
     paragraph .pdressTheiTag          anchor l+t       at x0.5       ymax            text  'Tier Heights :    '
     combobox  .pdressThei             anchor l+t       at xmax+0.1   ymin            callback '!this.addTier(' width 16

     paragraph .pdressmodifymatIcon                             anchor l+t    at x0.1         ymax+0.5       pixmap width 16 height 16
     button    .pdressmodifymat  linklabel   'Apply Changes '   anchor l+t    at xmax+1     ymin         callback '!this.modify(!this.cableway.ctmtrl)'
    exit
     toggle    .backwardWhole               anchor l+t       at x1            ymax+0.5     '  Dress Backwards' callback '!this.backwards()'
     paragraph .dressWholeOptTag            anchor l+t       at x1         ymax            text  'Dress whole branch'     width 30
     line      .dressWholeOptLineline       anchor l+t       at x0         ymax            horizontal width 39
     --toggle  .optimumValue              anchor l+t       at x1      ymax       'Consider Cable Dimensions' callback '!this.dimensionSetup()'
     button    .wholebranchfill     linklabel   'With Cable tray components'     anchor l+t    at x1       ymax         callback '!this.fillBranch()'
     button    .wholestrafill       linklabel   'With only Straights'                 anchor l+t    at x1       ymax         callback '!this.dressWithStraights()'
     toggle    .straightcut         anchor l+t       at xmax      ymin     'Do not cut'
     button    .wholebendfill       linklabel   'With only Bends and Risers'          anchor l+t    at x1       ymax         callback '!this.createBendAndRiser(!this.cableway.cwbran)'
     button    .wholeteefill        linklabel   'With only Tees and Crosses'          anchor l+t    at x1       ymax         callback '!this.createTeeAndCross(!this.cableway.cwbran)'
     button    .wholefillgaps       linklabel   'Fill gaps with Straights'                 anchor l+t    at x1       ymax         callback '!this.fillWithStraights()'
     button    .mainReorderCableTray  linklabel   'Sort trays components'              anchor l+t    at x1       ymax         callback '!this.cableway.reorderCableTray(!this.cableway.cwbran)'

     paragraph .dressPartOptTag            anchor l+t       at x1         ymax+0.5            text  'Dress part of branch'     width 30
     line      .dressPartOptLineline       anchor l+t       at x0         ymax            horizontal width 39
     button    .pointfill      linklabel   'Picked Point...'                         anchor l+t    at x1       ymax         callback '!this.pickPoint(|POINT|)'
     button    .rattafill      linklabel   'Picked Attachment Point...'              anchor l+t    at x1       ymax         callback '!this.pickRatta(|RATTA|)'
     button    .pickforfill    linklabel   'Straights between Picked Components...'  anchor l+t    at x1       ymax         callback '!this.pick()'
     button    .segmentStraight linklabel  'Segment with Straights...'  anchor l+t    at x1       ymax         callback '!this.pickSegment(|SEGMENT|)'
     toggle    .straightsegcut         anchor l+t       at xmax-10      ymin     'Do not cut'
     button    .segmentAll      linklabel  'Segment with all components...'  anchor l+t    at x1       ymax         callback '!this.pickSegment(|ALL|)'
     button    .segmentMulti    linklabel  'Multiple Segments in line...'  anchor l+t    at x1       ymax         callback '!this.pickMultiple()'

     paragraph .unfillmatIcon anchor l+t    at x1 ymax+0.5       pixmap width 16 height 16
     paragraph .unfillOptTag            anchor l+t       at xmax+1         ymin            text  'Remove Dressing'     width 30
     line      .unfillOptLine          anchor l+t       at x0         ymax            horizontal width 39
     button    .branchunfill      linklabel   'From Branch'                       anchor l+t    at x1       ymax         callback '!this.cableway.undress(!this.cableway.cwbran)'
     button    .pickedsegunfill   linklabel   'From Segment...'                   anchor l+t    at x1       ymax         callback '!this.pickElement(|SEGMENT|)'
     button    .pickedeleunfill   linklabel   'From Point...'                     anchor l+t    at x1       ymax         callback '!this.pickElement(|ELEMENT|)'
     button    .strunfill         linklabel   'All Straights from Branch'         anchor l+t    at x1       ymax         callback '!this.cableway.unfillstraights(!this.cableway.ctmtrl)'
     button    .pickedstraunfill  linklabel   'All Straights from Segment...'     anchor l+t    at x1       ymax         callback '!this.pickElement(|STRAIGHT|)'

     paragraph .matOptTag            anchor l+t       at x1         ymax+0.5            text  'Material'     width 30
     line      .matOptLine       anchor l+t       at x0         ymax            horizontal width 39
     paragraph .applymatIcon anchor l+t    at x1 ymax       pixmap width 16 height 16
     button    .applymat       linklabel   'Apply'                            anchor l+t    at xmax+1       ymin       callback '!this.applyMaterial(!this.cableway.ctmtrl)'
     paragraph .removematIcon anchor l+t    at x1 ymax       pixmap width 16 height 16
     button    .removemat       linklabel  'Remove'                           anchor l+t    at xmax+1       ymin       callback '!this.removeMaterial(!this.cableway.ctmtrl)'

     paragraph .predressbackIcon     anchor l+t    at x1            ymax+1         pixmap width 16 height 16
     button    .predressback   linklabel   'Back to CableWay Material Modify Tasks'   anchor l+t    at xmax+1        ymin         callback '!this.back()'

   exit


   frame .elementframe panel anchor l+t at x0 y0

    button    .currElement 'CE'  linklabel   anchor l+t         at x0.5    ymin             callback |!!cblinit('Modify','COMPONENTS','!!cblmtrl')| tooltip 'Select an Element and modify'
     --Element list
    list .elementTable                     anchor l+t       at x0.5          ymax+0.5           callback '!this.updateFrame()' columns single width 37 lines 6

    paragraph .applysinglematIcon                              anchor l+t    at x1           ymax       pixmap width 16 height 16
    button    .applysinglemat    linklabel   'Select Material'  anchor l+t    at xmax+1      ymin       callback '!this.chooseMaterial(!this.trayComponent)'
    paragraph .removesinglematIcon                             anchor l+t    at xmax+1       ymin       pixmap width 16 height 16
    button    .removesinglemat   linklabel   'Remove Material' anchor l+t    at xmax+1       ymin       callback '!this.removeMaterial(!this.trayComponent)'
    paragraph .cutAdjacentCTSTRAIcon                              anchor l+t    at x1           ymax       pixmap width 16 height 16
    button    .cutAdjacentCTSTRA linklabel   'Adjust adjacent straights'   anchor l+t at xmax+1       ymin callback '!this.cutAdjacentStraights(!this.trayComponent)'
    toggle    .backwardMode               anchor l+t       at x1            ymax     '  Dress Backwards' callback '!this.switchMode()'
    paragraph .ctelementPosnTag           anchor l+t       at x1            ymax    text  'Reference Point:   '
    option    .ctelementPosn              at xmax          ymin                callback '!this.offsetDistance()'     width 10
    button    .ctelementPosnpick  linklabel   'Pick'      anchor l+t    at xmax       ymin       callback '!this.pick(!this.elementTable.selection())'

   frame .ctoffsetframe FoldupPanel 'Offsets'  anchor l+t  at x0.1  ymax+0.5  width 40
    --paragraph .ctoffsetTag                anchor l+t       at x1         ymax+1 text  'Offsets'
    --line      .ctoffsetLine               anchor l+t       at x0         ymax      horizontal width 39
    paragraph .ctelementZdisTag           anchor l+t       at x1         ymax+0.2  text  'Along Route (Zdis):'
    text      .ctelementZdis              anchor l+t       at xmax+0.1   ymin      callback '!this.offsetDistance()'  width 15 is REAL format !!distanceFmt
    button    .ctelementZdispick  linklabel   'Pick Position'       anchor l+t at x1      ymax+0.1      callback '!this.align()'               width 8
    button    .ctelementAlignGrid linklabel   'Align with gridline' anchor l+t at xmax+10 ymin          callback '!this.alignWithGridlines()'  width 11
    paragraph .ctelementMoveTag           anchor l+t       at x1         ymax      text  'Move Offset:       '
    button    .ctelementLeftMove          anchor l+t       at xmax       ymin      pixmap callback '!this.moveZdis(|DECREASE|,!this.ctelementZdis)' tooltip 'Decrease Offset' width 16 height 16
    text      .ctelementMoveValue         anchor l+t       at xmax+0.5   ymin      callback ''  width 9 is REAL  format !!distanceFmt
    button    .ctelementRightMove         anchor l+t       at xmax+0.5   ymin      pixmap callback '!this.moveZdis(|INCREASE|,!this.ctelementZdis)' tooltip 'Increase Offset' width 16 height 16
    paragraph .ctelementposFromPrevTag    anchor l+t       at x1         ymax+0.2  text  'Gap:               '
    text      .ctelementposFromPrev       anchor l+t       at xmax+0.1   ymin      callback '!this.updateZdistance()'  width 15 is REAL format !!distanceFmt
    paragraph .ctelementPkdisTag          anchor l+t       at x1         ymax      text  'Proportion (Pkdis):'
    text      .ctelementPkdis             anchor l+t       at xmax+0.1   ymin      callback '!this.offsetDistance()'  width 15 is REAL
    paragraph .ctelementXoffTag           anchor l+t       at x1         ymax      text  'Horizontal (Xoff): '
    text      .ctelementXoff              anchor l+t       at xmax+0.1   ymin      callback ''  width 15 is REAL format !!distanceFmt
    paragraph .ctelementZoffTag           anchor l+t       at x1         ymax      text  'Vertical (Zoff):   '
    text      .ctelementZoff              anchor l+t       at xmax+0.1   ymin      callback ''  width 15 is REAL format !!distanceFmt
   exit

   frame .ctanglesframe FoldupPanel 'Angle attributes'  anchor l+t  at x0.1  ymax+0.5  width 40
    paragraph .ctelementBangTag           anchor l+t       at x1         ymax+0.2 text  'Beta Angle (Bang): '
    text      .ctelementBang              anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementBang)'  width 15 is REAL
    paragraph .ctelementAngleTag          anchor l+t       at x1         ymax     text  'Angle :            '
    text      .ctelementAngle             anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementAngle)'  width 15 is REAL
    paragraph .ctelementRadiusTag         anchor l+t       at x1         ymax     text  'Radius:            '
    text      .ctelementRadius            anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementRadius)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementTypeTag           anchor l+t       at x1         ymin+1   text    'Bend Type :        '
    option    .ctelementType              at xmax          ymin                callback ''     width 13
   exit

   frame .ctdimensionframe FoldupPanel 'Dimensions'  anchor l+t  at x0.1  ymax+0.5  width 40
    paragraph .ctelementALengTag          anchor l+t       at x1         ymax+0.2 text  'Length :           '
    text      .ctelementALeng             anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementALeng)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementLLengTag          anchor l+t       at x1         ymax     text  'Side Length :      '
    text      .ctelementLLeng             anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementLLeng)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementSLengTag          anchor l+t       at x1         ymax     text  'Side Length :      '
    text      .ctelementSLeng             anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementSLeng)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementSSLengTag         anchor l+t       at x1         ymax     text  'Second Side Length:'
    text      .ctelementSSLeng            anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementSSLeng)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementAWidtTag          anchor l+t       at x1         ymax     text  'Width :            '
    text      .ctelementAWidt             anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementAWidt)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementLWidtTag          anchor l+t       at x1         ymax     text  'Leave Width :      '
    text      .ctelementLWidt             anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementLWidt)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementSLWidtTag         anchor l+t       at x1         ymax     text  'Second Leave Width:'
    text      .ctelementSLWidt            anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementSLWidt)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementHeigTag           anchor l+t       at x1         ymax     text  'Height :           '
    text      .ctelementHeig              anchor l+t       at xmax+0.1   ymin     callback '!!gdgtDatChk(!this.ctelementHeig)'  width 15 is REAL  format !!distanceFmt
    paragraph .ctelementTheiTag           anchor l+t       at x1         ymax     text  'Tier Heights :     '
    combobox  .ctelementThei              anchor l+t       at xmax+0.1   ymin     callback '!this.addTier(' width 13
   exit

    frame .cttmpldimensionframe FoldupPanel 'Templates'  anchor l+t  at x0.1  ymax+0.5  width 40
      paragraph .templAppdataTag   anchor l+t       at x1         ymax            text  'Template Zone:' width 17
      option  .ctmtrlTempdata          anchor l+t       at xmax   ymin            callback '!this.loadTypes()' width 17
      paragraph .tmplofType           anchor l+t       at x1   ymax+0.5           text  'Select Type:' width 17
      option  .ctmtrlTypes               anchor l+t       at xmax   ymin            callback '!this.updateView()' width 17

      --3D view
      frame .frView3D '3D view' anchor top + left + right at x1 ymax+0.5 width 35 height 10
        view .vwView3d volume
        exit
      exit
    exit

    toggle    .useTemplate           anchor l+t       at x1         ymax+0.5     'Use Templates' callback ''
    toggle    .ctelementDisplay      anchor l+t       at x1         ymax         'Display Preliminary Dressing' callback '!this.displayElement()'

    frame .ctelementmode 'Mode' anchor l+t at x1 ymax+0.2
       rtoggle .ctelementcreatemode |Creation|            anchor l+t     at x1 ymax callback |!this.changeMode('CREATE',!this.elementTable.selection())|
       path right
       rtoggle .ctelementmodifymode |Modification|            anchor l+t     at xmax+7 ymin callback |!this.changeMode('MODIFY',!!ce.type)|
     exit

    paragraph .createctelementIcon                             anchor l+t    at x1           ymax+1       pixmap width 16 height 16
    button    .createctelement  linklabel 'Create '            anchor l+t    at xmax+1       ymin         callback '!this.create(!this.elementTable.selection())'
    button    .bnProperties1 linklabel    anchor l+t at x1 ymin width 35 callback  |!this.editProp('MAT')|
    button    .bnProperties2 linklabel    anchor l+t at x1 ymax width 35 callback  |!this.editProp('TMPL')|
    button       .copyWithGap      linklabel 'Copy with gap'      anchor l+t    at x1           ymax         callback  |!this.copy(TRUE)|
    numericinput .nuCopies   'Number of Copies:'  anchor l+t at xmax   ymin  tagwidth 14 callback ''  width 4
    button    .copyWithoutGap   linklabel 'Copy without gap'   anchor l+t    at x1           ymax        callback  |!this.copy(FALSE)|

    -- Update rules/repeat rules
    button    .updateRules      linklabel |Update rules|       anchor l+t    at x1           ymax        callback |!this.updateRules()|
    paragraph .modifyctelementIcon                             anchor l+t    at x1           ymax+0.5       pixmap width 16 height 16
    button    .modifyctelement  linklabel   'Apply Changes '   anchor l+t    at xmax+1       ymin         callback '!this.modify(!this.elementTable.selection())'
    paragraph .discardctelementIcon                            anchor l+t    at xmax+1       ymin         pixmap width 16 height 16
    button    .discardctelement  linklabel  'Discard Changes ' anchor l+t    at xmax+1       ymin         callback '!this.discard()'

    paragraph .backctmtrlIcon  anchor l+t    at x1            ymax+0.5        pixmap width 16 height 16
    button    .ctmatback  linklabel 'Back to CableWay Material Tasks'   anchor l+t    at xmax+1        ymin         callback '!this.back()'

    exit


   member .task               is STRING
   member .cableway           is CABLEWAY
   member .pickedPoint        is DBREF
   member .pickedPos          is POSITION
   member .pickedratta        is DBREF
   member .pickedElements     is ARRAY
   member .pickedType         is STRING

   member .wrongpick          is BOOLEAN
   member .location           is STRING
   member .ctsphere           is GPHPOSITION
   member .ctAidNumber        is REAL

    --material
    member .material          is ARRAY

   --application data
   member  .appdata           is ARRAY

    --specification data
   member  .specdata           is ARRAY

   -- template data
   member  .tmpldata          is ARRAY

   -- tray member
   member  .tray              is DBREF
   -- tray component member
   member  .trayComponent     is DBREF

   -- optimum dimensions
   member  .optimum           is BOOLEAN

   -- template dimensions
   member  .template          is BOOLEAN

   --loaded spec data
   member  .loadedSpec        is DBREF

   -- Cache of cable material catalogue Selection data
   member .tableChooseData    is STCHOOSEDATA

    --loaded specdata
   member  .loadedTmpl        is DBREF

   -- previous element
   member  .previous          is DBREF

   -- gap update
   member  .updateGap         is BOOLEAN

   -- gap value
   member  .gapValue          is REAL

   -- track
   member  .track             is BOOLEAN

   -- 3D view
  member .drawlist  is REAL
  member .newtmpl is BOOLEAN

  -- undo member
  member .matUndo             is UNDOABLE


exit
------------------------------------------------------------------------
--
-- Method:   cblmtrl()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .cblmtrl()

 !this.quitcall   = |!this.dismiss()|
 !this.autoscroll = TRUE
-- !this.cancelCall     = |!!gphDrawlists.deleteDrawlist(!this.drawlist) !!gphViews.remove(!this.vwView3d)|
 !this.cancelCall     = |!this.dismiss()|
 !this.firstShownCall = '!this.firstShownCallback()'
 -- icons
 !createIcon     = !!pml.getPathname('create.png')
 !modifyIcon     = !!pml.getPathname('accept.png')
 !discardIcon    = !!pml.getPathname('discard.png')
 !autoNameIcon   = !!pml.getPathname('autoname.png')
 !backIcon       = !!pml.getPathname('back.png')
 !deleteIcon     = !!pml.getPathname('deletece16.png')
 !leftArrow      = !!pml.getPathname('leftarrow16.png')
 !rightArrow     = !!pml.getPathname('rightarrow16.png')

 !this.creatematIcon.addPixmap(!createIcon)
 !this.modifymatIcon.addPixmap(!modifyIcon)
 !this.pdressmodifymatIcon.addPixmap(!modifyIcon)
 !this.discardmatIcon.addPixmap(!discardIcon)
 !this.applymatIcon.addPixmap(!modifyIcon)
 !this.removematIcon.addPixmap(!deleteIcon)
 !this.unfillmatIcon.addPixmap(!deleteIcon)
 !this.mainunfillmatIcon.addPixmap(!deleteIcon)
 !this.applysinglematIcon.addPixmap(!modifyIcon)
 !this.removesinglematIcon.addPixmap(!deleteIcon)
 !this.cutAdjacentCTSTRAIcon.addPixmap(!modifyIcon)


 !this.createctelementIcon.addPixmap(!createIcon)
 !this.modifyctelementIcon.addPixmap(!modifyIcon)
 !this.discardctelementIcon.addPixmap(!discardIcon)

 !this.autoName.addPixmap(!autoNameIcon)
 !this.backctmtrlIcon.addPixmap(!backIcon)
 !this.predressbackIcon.addPixmap(!backIcon)
 !this.ctelementLeftMove.addPixmap(!leftArrow)
 !this.ctelementRightMove.addPixmap(!rightArrow)

 --populate element table
 !elementList = object ARRAY()
 !elementList.append('Straight')
 !elementList.append('Bend')
 !elementList.append('Riser')
 !elementList.append('Reducer')
 !elementList.append('Tee')
 !elementList.append('Cross')

 !elementReplace = object ARRAY()
 !elementReplace.append('CTSTRA')
 !elementReplace.append('CTBEND')
 !elementReplace.append('CTRISE')
 !elementReplace.append('CTREDU')
 !elementReplace.append('CTTEE')
 !elementReplace.append('CTCROS')

 !this.elementTable.dText = !elementList
 !this.elementTable.rText = !elementReplace
 !this.elementTable.setheadings('Select Element')

  --popup for tier deletion
  !menu   =   !this.newMenu('deleteelementtier')
  !menu.add('callback','Remove','!this.removeTier(!this.ctelementThei)')
  !this.ctelementThei.setPopup(!menu)

   --popup for tier deletion
  !menu   =   !this.newMenu('deletectmtrltier')
  !menu.add('callback','Remove','!this.removeTier(!this.ctmtrlThei)')
  !this.ctmtrlThei.setPopup(!menu)

  !menu   =   !this.newMenu('deletepdresstier')
  !menu.add('callback','Remove','!this.removeTier(!this.pdressThei)')
  !this.pdressThei.setPopup(!menu)

-- get the specs

    var !col collect all TABGRO with (purp eq 'TRAY')

     !dText  = object ARRAY()
     !rText  = object ARRAY()
     !this.specdata = object ARRAY()
    do !spec values !col
      !dText.append(!spec.dbref().namn)
      !rText.append(!spec.dbref().string())
      !this.specdata.append(!spec.dbref())
    enddo

    !this.ctmtrlSpecdata.dText = !dText
    !this.ctmtrlSpecdata.rText = !rText

    !dText.insert(1,'None')
    !rText.insert(1,'')
    !this.ctmtrlSpec.dText = !dText
    !this.ctmtrlSpec.rText = !rText

  -- load catalogue data
  !this.tableChooseData.cleardata()
  !this.tableChooseData.setTitle('cable')
  !this.tableChooseData.setdata('CABLE','TRAY')

   --aids
  !this.ctAidNumber    = !!aidNumbers.add('Material Element')
  !this.ctsphere.position  = E0
  !this.ctsphere.diameter  = 100 mm
  !this.ctsphere.description = '<Origin>'
  !this.ctsphere.tag         = TRUE

  --Material
  !this.material = object ARRAY()
  !this.material.append('CTSTRA')
  !this.material.append('CTBEND')
  !this.material.append('CTRISE')
  !this.material.append('CTREDU')
  !this.material.append('CTTEE')
  !this.material.append('CTCROS')

  -- preliminary dressing application data
  var !col collect all APPLDA with (purp eq 'PDRE')
    !dText        = object ARRAY()
    !this.appdata = object ARRAY()
    do !app values !col
      !dText.append(!app.dbref().namn)
      !this.appdata.append(!app.dbref())
    enddo
    !this.ctmtrlAppdata.dText = !dText
!this.straLengthTag.val = 'Tray Length for Dressing with Straights:'

  --rewrite tag
  !this.ctmtrlAppdataTag.val = 'Load From Application Data:'
  !this.ctmtrlSpecdataTag.val = 'Load From Specification:'
  !this.tmplAppdataTag.val   = 'Load From Template Zone:'

  -- template data
   var !col collect all APPLDA with (purp eq 'CTMP')
    !dText        = object ARRAY()
    !this.tmpldata = object ARRAY()
    do !app values !col
      var !zonecol collect all ZONE for $!app
      do !zone values !zonecol
       !dText.append(!zone.dbref().namn)
       !this.tmpldata.append(!zone.dbref())
      enddo
    enddo
    !this.ctmtrlTmpdata.dText = !dText
    !this.ctmtrlTempdata.dText = !dText
    !this.drawlist = !!gphDrawlists.createDRawList()

    -- Load types available

    if !dText.set() then

      -- 3D view / local drawlist
    !this.vwView3d.shaded = true
    !viewDir[1] = 0.57735
    !viewDir[2] = 0.57735
    !viewDir[3] = -0.57735
    !this.vwView3d.direction = !viewDir

--   Add view to global view list

    !!gphViews.add(!this.vwView3d)

-- Inactivate 3D view
    !this.vwView3d.active = TRUE

-- load types
    !this.loadTypes()
   else
   -- inactivate templates option
   !this.useTemplate.active = FALSE

   endif

   --Optimum
   !this.cableway.optimum   = FALSE
   !this.cableway.template  = FALSE

   -- fold up panel for attributes
   !this.pdressframe.expanded   = FALSE
   !this.ctoffsetframe.expanded = FALSE
   !this.ctanglesframe.expanded = FALSE
   !this.cttmpldimensionframe.expanded = TRUE
   !this.ctdimensionframe.expanded = FALSE

   -- change values of paragraph GADGET
--   !this.straLengthTag.val = 'Tray Length for Dressing with Straights:'

   -- change tag of button gadgets
   !this.bnProperties1.tag = 'Properties of cable tray material element...'
   !this.bnProperties2.tag = 'Properties of cable tray template element...'

   --tracking
   !this.track  = TRUE

   -- numeric input gadget
   !range = object ARRAY()
   !range.append(0)
   !range.append(100)
   !range.append(1)
   !ndp = 0
   !this.nuCopies.setRange(!range,!ndp )

   --undo
   !this.matUndo.undoAction('')
   !this.applymat.setUndoable(!this.matUndo)

 endmethod
------------------------------------------------------------------------
--
-- Method:      firstShownCallback
--
-- Description: callback for first show of form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShownCallback()

--  !this.optMessage.background = 3
--  !this.optMessage.val  = 'No data loaded'
--
--  !this.tmploptMessage.background = 3
--  !this.tmploptMessage.val  = 'No data loaded'

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.vwView3D)

  -- Create local drawlist and add to 3D view
  if (!this.drawlist.unset()) then
    !this.drawlist = !!gphDrawlists.createDrawList()
  endif
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3D)

endmethod
------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: tracking on navigation
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

   -- no track for CTTEE modification
   if !this.track.not() then
    !this.track = TRUE
    return
   endif

   if !this.elementframe.visible and !this.task.upcase().eq('MODIFY') then
     !dbElement = !!ce
      -- Navigate to correct Element
     do !mat values !this.material
      if !!ce.ahlist.findfirst(!mat).set() then
       -- Navigate to material
       $!mat
       break
      endif
     enddo

     if !this.material.findfirst(!!ce.type).set() then
       !this.elementTable.val = !this.elementTable.rText.findfirst(!!ce.type)
       !this.setTask('MODIFY', !!ce.type)
     endif
     !!ce = !dbElement
     if !this.ctmtrlTempdata.dText.set() then
       !this.loadTypes()
       !this.updateView()
     endif
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:      setTask
--
-- Description: Set Tasks
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTask(!task is STRING , !element is STRING)

   !this.task   = !task
   if !task.upcase().eq('CREATE') then
    !formTask  = 'Create'
    !this.helpContextID = 'HID_CBLMTRL'
   elseif !task.upcase().eq('MODIFY') then
    !formTask  = 'Modify'
    !this.helpContextID = 'HID_CBLMODMTRL'
   else
    !formTask  = ''
   endif


   --select element table in modify mode
   if !task.upcase().eq('MODIFY') and !this.material.findfirst(!element.upcase()).set()  then
    !this.elementTable.val = !this.elementTable.rText.findfirst(!!ce.type)
    !this.helpContextID = 'HID_CBLMODMTRLELEMENTS'
   endif

   -- Setting the HELPCONTEXTID for Create Elements
   if !task.upcase().eq('CREATE') and !this.material.findfirst(!element.upcase()).set()  then
   	!this.helpContextID = 'HID_CBLMTRLELEMENTS'
   endif

   --Navigate to correct element in case of modification of CTMTRL
   if !task.upcase().eq('MODIFY') and !element.upcase().eq('CTMTRL') then
    CTMTRL 1
   endif

   -- get which element
   if !element.upcase().neq('CTMTRL') then
    !selection = !this.elementTable.dText[!this.elementTable.val]
     -- Navigate to correct Element
     do !mat values !this.material
      if !!ce.ahlist.findfirst(!mat).set() then
       -- Navigate to material
       $!mat
       break
      endif
     enddo
   else
    !selection = 'Material'
   endif
   !formTask  = !formTask & ' ' & !selection

   if !element.upcase().eq('USERPRELIMINARY') then
    !formTask  = 'Preliminary Dressing (User defined Dimensions)'
    !this.helpContextID = 'HID_CBLPREDRESSUDD'
   elseif  !element.upcase().eq('OPTIPRELIMINARY') then
    !formTask  = 'Preliminary Dressing (Considering Branch fill levels)'
    !this.helpContextID = 'HID_CBLPREDRESSFILLLEVELS'
   elseif  !element.upcase().eq('TEMPLATE') then
    !formTask  = 'Dress using Templates'
    !this.helpContextID = 'HID_CBLDRESSTEMPLATES'
   endif
   !this.formtitle = !formTask

   !this.cableway   = object CABLEWAY(!!ce)
   if(!task eq 'CREATE' and !element neq 'CTMTRL')then
     if(!this.cableway.ctmtrl.unset())then
       return error 1 'Navigate to CTMTRL'
     endif
   elseif(!task eq 'MODIFY')then
     if(!this.cableway.ctmtrl.unset())then
       return error 1 'Navigate to CTMTRL'
     endif
   endif
   !this.ctmtrlframe.visible      = FALSE
   !this.elementframe.visible     = FALSE
   if(!task eq 'CREATE' and !element neq 'CTMTRL')then
     if(!this.cableway.ctmtrl.unset())then
       return error 1 'Navigate to CTMTRL'
     endif
   elseif(!task eq 'MODIFY')then
     if(!this.cableway.ctmtrl.unset())then
       return error 1 'Navigate to CTMTRL'
     endif
   endif
   !this.ctmtrlframe.visible      = FALSE
   !this.elementframe.visible     = FALSE
   !this.predress.visible         = false

   if !element.upcase().eq('CTMTRL') then
    !this.ctmtrlframe.visible = TRUE
    !this.ctmtrlgadgets(!task)
    !this.clearAids()
   elseif !element.upcase().eq('USERPRELIMINARY') then
    !this.predress.visible             = TRUE
    !this.pdressTheiTag.visible        = TRUE
    !this.pdressThei.visible           = TRUE
    !this.pdresstraywidthTag.visible   = TRUE
    !this.pdresstraywidth.visible      = TRUE
    !this.pdresstrayheightTag.visible  = TRUE
    !this.pdresstrayheight.visible     = TRUE
    !this.dressOptFrame.visible        = TRUE
    !this.tmplOptFrame.visible         = FALSE
    !this.optimum                      = FALSE
    !this.cableway.optimum             = FALSE
    !this.template                     = FALSE
    !this.cableway.template            = FALSE
    !this.matOptTag.visible            = TRUE
    !this.matOptLine.visible           = TRUE
    !this.applymatIcon.visible         = TRUE
    !this.applymat.visible             = TRUE
    !this.removematIcon.visible        = TRUE
    !this.removemat.visible            = TRUE
    !this.pickforfill.active           = TRUE
    !this.userLength.val               = false
    -- mode
      var !mode mode
      if !mode.upcase().eq('BACKWARDS') then
        !this.backwardMode.val = TRUE
      else
        !this.backwardMode.val = FALSE
      endif
   elseif !element.upcase().eq('OPTIPRELIMINARY') then
    !this.predress.visible             = TRUE
    !this.pdressTheiTag.visible        = FALSE
    !this.pdressThei.visible           = FALSE
    !this.pdresstraywidthTag.visible   = FALSE
    !this.pdresstraywidth.visible      = FALSE
    !this.pdresstrayheightTag.visible  = FALSE
    !this.pdresstrayheight.visible     = FALSE
    !this.dressOptFrame.visible        = TRUE
    !this.tmplOptFrame.visible         = FALSE
    !this.optimum                      = TRUE
    !this.cableway.optimum             = TRUE
    !this.template                     = FALSE
    !this.cableway.template            = FALSE
    !this.matOptTag.visible            = TRUE
    !this.matOptLine.visible           = TRUE
    !this.applymatIcon.visible         = TRUE
    !this.applymat.visible             = TRUE
    !this.removematIcon.visible        = TRUE
    !this.removemat.visible            = TRUE
    !this.pickforfill.active           = TRUE
    !this.userLength.val               = FALSE
   elseif !element.upcase().eq('TEMPLATE') then
    !this.predress.visible             = TRUE
    !this.pdressTheiTag.visible        = FALSE
    !this.pdressThei.visible           = FALSE
    !this.pdresstraywidthTag.visible   = TRUE
    !this.pdresstraywidth.visible      = TRUE
    !this.pdresstrayheightTag.visible  = FALSE
    !this.pdresstrayheight.visible     = FALSE
    !this.dressOptFrame.visible        = FALSE
    !this.tmplOptFrame.visible         = TRUE
    !this.optimum                      = FALSE
    !this.cableway.optimum             = FALSE
    !this.template                     = TRUE
    !this.cableway.template            = TRUE
    !this.matOptTag.visible            = FALSE
    !this.matOptLine.visible           = FALSE
    !this.applymatIcon.visible         = FALSE
    !this.applymat.visible             = FALSE
    !this.removematIcon.visible        = FALSE
    !this.removemat.visible            = FALSE
    !this.pickforfill.active          = false
    -- mode
      var !mode mode
      if !mode.upcase().eq('BACKWARDS') then
        !this.backwardMode.val = TRUE
      else
        !this.backwardMode.val = FALSE
      endif
   else
    !this.elementframe.visible = TRUE
    !this.ctElementGadgets(!task, !element)
   endif

   if !task.upcase().eq('MODIFY') then
    !this.loadData(!element)
   elseif !task.upcase().eq('CREATE') then
    !this.createData(!element)
   endif



 endmethod
------------------------------------------------------------------------
--
-- Method: ctmtrlgadgets
--
-- Description: Sets the  gadgets required to create and modify
-- cableway
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ctmtrlgadgets(!formTask is STRING)

    if !formTask.upcase().eq('CREATE') then
     !this.creatematIcon.visible          = TRUE
     !this.createmat.visible              = TRUE
     !this.modifymatIcon.visible          = FALSE
     !this.modifymat.visible              = FALSE
     !this.discardmatIcon.visible         = FALSE
     !this.discardmat.visible             = FALSE
     !this.wholebendfill.visible          = FALSE
     !this.wholebranchfill.visible        = FALSE
     !this.branchunfill.visible           = FALSE
     !this.elementcreate.visible          = false
     !this.ctmtrldress.visible            = FALSE
     !this.ctmtrldressLine.visible        = FALSE
     !this.ctmtrluserdress.visible        = FALSE
     !this.ctmtrloptidress.visible        = false
     !this.pickforfill.visible            = FALSE
     !this.strunfill.visible              = FALSE
     !this.applymatIcon.visible           = FALSE
     !this.applymat.visible               = FALSE
     !this.mainunfillOptTag.visible       = FALSE
     !this.mainunfillOptLine.visible      = FALSE
     !this.mainbranchunfill.visible       = FALSE
     !this.mainstrunfill.visible          = FALSE
     !this.mainpickedeleunfill.visible    = FALSE
     !this.mainpickedsegunfill.visible    = FALSE
     !this.mainpickedstraunfill.visible   = FALSE
     !this.ctmtrlOptdress.visible         = FALSE
     !this.ctmtrlOptdressLine.visible     = FALSE
     !this.templatedress.visible          = FALSE
     !this.mainunfillmatIcon.visible      = FALSE
     !this.autonamemat.visible            = FALSE

    elseif !formTask.upcase().eq('MODIFY') then
     !this.creatematIcon.visible          = FALSE
     !this.createmat.visible              = FALSE
     !this.modifymatIcon.visible          = TRUE
     !this.modifymat.visible              = TRUE
     !this.discardmatIcon.visible         = TRUE
     !this.discardmat.visible             = TRUE
     !this.wholebendfill.visible          = TRUE
     !this.wholebranchfill.visible        = TRUE
     !this.branchunfill.visible           = TRUE
     !this.elementcreate.visible          = true
     !this.ctmtrldress.visible            = TRUE
     !this.ctmtrldressLine.visible        = TRUE
     !this.ctmtrluserdress.visible        = TRUE
     !this.ctmtrloptidress.visible        = true
     !this.pickforfill.visible            = TRUE
     !this.strunfill.visible              = TRUE
     !this.applymatIcon.visible           = TRUE
     !this.applymat.visible               = TRUE
     !this.mainunfillOptTag.visible       = TRUE
     !this.mainunfillOptLine.visible      = TRUE
     !this.mainbranchunfill.visible       = TRUE
     !this.mainstrunfill.visible          = TRUE
     !this.mainpickedeleunfill.visible    = TRUE
     !this.mainpickedsegunfill.visible    = TRUE
     !this.mainpickedstraunfill.visible   = TRUE
     !this.ctmtrlOptdress.visible         = TRUE
     !this.ctmtrlOptdressLine.visible     = TRUE
     !this.templatedress.visible          = TRUE
     !this.mainunfillmatIcon.visible      = TRUE
     !this.autonamemat.visible            = TRUE
    endif

    !this.cwbranownTag.val    = 'Cableway           : ' & !this.cableway.cway.flnn
    !this.cwbranTag.val       = 'Current Branch  : ' & !this.cableway.cwbran.flnn

endmethod
------------------------------------------------------------------------
--
-- Method: ctElementGadgets
--
-- Description: Sets the  gadgets for the element type
-- cableway
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ctElementGadgets(!formTask is STRING, !element is STRING)

    if !formTask.upcase().eq('CREATE') then
     !this.createctelementIcon.visible    = TRUE
     !this.createctelement.visible        = TRUE
     !this.modifyctelementIcon.visible    = FALSE
     !this.modifyctelement.visible        = FALSE
     !this.discardctelementIcon.visible   = FALSE
     !this.discardctelement.visible       = FALSE
     !this.elementTable.active            = TRUE
     !this.ctelementmode.val              = 1
     !this.applysinglematIcon.visible     = FALSE
     !this.removesinglematIcon.visible    = FALSE
     !this.removesinglemat.visible        = FALSE



     !this.cutAdjacentCTSTRAIcon.visible  = FALSE
     !this.cutAdjacentCTSTRA.visible      = FALSE

     !this.applysinglemat.visible         = FALSE
     !this.copyWithGap.visible            = FALSE
     !this.copyWithoutGap.visible         = FALSE
     !this.updateRules.visible            = FALSE
     !this.bnProperties1.visible          = FALSE
     !this.bnProperties2.visible          = FALSE
     !this.nuCopies.visible               = FALSE

    elseif !formTask.upcase().eq('MODIFY') then
     !this.createctelementIcon.visible    = FALSE
     !this.createctelement.visible        = FALSE
     !this.modifyctelementIcon.visible    = TRUE
     !this.modifyctelement.visible        = TRUE

     !this.cutAdjacentCTSTRAIcon.visible  = TRUE
     !this.cutAdjacentCTSTRA.visible      = TRUE

     !this.discardctelementIcon.visible   = TRUE
     !this.discardctelement.visible       = TRUE
     !this.elementTable.active            = FALSE
     !this.ctelementmode.val              = 2
     !this.applysinglematIcon.visible     = TRUE
     !this.removesinglematIcon.visible    = TRUE
     !this.removesinglemat.visible        = TRUE
     !this.applysinglemat.visible         = TRUE
     !this.copyWithGap.visible            = TRUE
     !this.copyWithoutGap.visible         = TRUE
     !this.updateRules.visible            = TRUE
     !this.bnProperties1.visible          = TRUE
     !this.bnProperties2.visible          = TRUE
     !this.nuCopies.visible               = TRUE
    endif

      --put off uncommon gadgets
     !this.ctelementAngleTag.active      = FALSE
     !this.ctelementAngle.active         = FALSE
     !this.ctelementRadiusTag.active     = FALSE
     !this.ctelementRadius.active        = FALSE
     !this.ctelementTypeTag.active       = FALSE
     !this.ctelementType.active          = FALSE
     !this.ctelementLLengTag.active      = FALSE
     !this.ctelementLLeng.active         = FALSE
     !this.ctelementSLengTag.active      = FALSE
     !this.ctelementSLeng.active         = FALSE
     !this.ctelementLWidtTag.active      = FALSE
     !this.ctelementLWidt.active         = FALSE
     !this.ctelementSSLeng.active        = FALSE
     !this.ctelementSLWidt.active        = FALSE


   --put on relevant gadgets
     if !element.upcase().eq('CTSTRA') then
      !this.ctelementALengTag.val          = 'Length :'
      !this.ctelementAWidtTag.val          = 'Width :'
     elseif !element.upcase().eq('CTBEND') or !element.upcase().eq('CTRISE') then
      !this.ctelementAngleTag.active      = TRUE
      !this.ctelementAngle.active         = TRUE
      !this.ctelementRadiusTag.active     = TRUE
      !this.ctelementRadius.active        = TRUE
      !this.ctelementTypeTag.active       = TRUE
      !this.ctelementType.active          = TRUE
      !this.ctelementLLengTag.active      = TRUE
      !this.ctelementLLeng.active         = TRUE
      !this.ctelementALengTag.val          = 'Arrive Length :'
      !this.ctelementLLengTag.val          = 'Leave Length :'
     elseif !element.upcase().eq('CTREDU') then
      !this.ctelementTypeTag.active       = TRUE
      !this.ctelementType.active          = TRUE
      !this.ctelementLWidtTag.active      = TRUE
      !this.ctelementLWidt.active         = TRUE
      !this.ctelementALengTag.val          = 'Length :'
      !this.ctelementAWidtTag.val          = 'Arrive Width :'
      !this.ctelementLWidtTag.val          = 'Leave Width :'
     elseif !element.upcase().eq('CTTEE') then
      !this.ctelementAngleTag.active      = TRUE
      !this.ctelementAngle.active         = TRUE
      !this.ctelementRadiusTag.active     = TRUE
      !this.ctelementRadius.active        = TRUE
      !this.ctelementTypeTag.active       = TRUE
      !this.ctelementType.active          = TRUE
      !this.ctelementLLengTag.active      = TRUE
      !this.ctelementLLeng.active         = TRUE
      !this.ctelementLWidtTag.active      = TRUE
      !this.ctelementLWidt.active         = TRUE
      !this.ctelementSLengTag.active      = TRUE
      !this.ctelementSLeng.active          = TRUE
      !this.ctelementALengTag.val         = 'Arrive Length :'
      !this.ctelementLLengTag.val         = 'Leave Length :'
     elseif !element.upcase().eq('CTCROS') then
      !this.ctelementAngleTag.active      = TRUE
      !this.ctelementAngle.active         = TRUE
      !this.ctelementRadiusTag.active     = TRUE
      !this.ctelementRadius.active        = TRUE
      !this.ctelementTypeTag.active       = TRUE
      !this.ctelementType.active          = TRUE
      !this.ctelementLLengTag.active      = TRUE
      !this.ctelementLLeng.active         = TRUE
      !this.ctelementLWidtTag.active      = TRUE
      !this.ctelementLWidt.active         = TRUE
      !this.ctelementSLengTag.active      = TRUE
      !this.ctelementSLeng.active         = TRUE
      !this.ctelementSSLeng.active        = TRUE
      !this.ctelementSLWidt.active        = TRUE
      !this.ctelementALengTag.val          = 'Arrive Length :'
      !this.ctelementLLengTag.val          = 'Leave Length :'
     endif

     -- types

      !type  = object ARRAY()
      !rtype  = object ARRAY()
      if !element.upcase().eq('CTBEND') then
       !type.append('Left handed')
       !type.append('Right handed')
       !rtype.append('LEFT')
       !rtype.append('RIGH')
       !this.ctelementType.dText = !type
       !this.ctelementType.rText = !rtype
       !this.ctelementTypeTag.val = 'Bend Type :'
      elseif !element.upcase().eq('CTRISE') then
        !type.append('Inside')
        !type.append('Outside')
        !rtype.append('INSI')
        !rtype.append('OUTS')
        !this.ctelementType.dText = !type
        !this.ctelementType.rText = !rtype
        !this.ctelementTypeTag.val = 'Riser Type :'
      elseif !element.upcase().eq('CTREDU') then
        !type.append('Concentric')
        !type.append('Eccentric Left')
        !type.append('Eccentric Right')
        !rtype.append('CENT')
        !rtype.append('LEFT')
        !rtype.append('RIGH')
        !this.ctelementType.dText = !type
        !this.ctelementType.rText = !rtype
        !this.ctelementTypeTag.val = 'Reducer Type :'
      elseif !element.upcase().eq('CTTEE') or !element.upcase().eq('CTCROS') then
        !type.append('Left')
        !type.append('Right')
        !rtype.append('LEFT')
        !rtype.append('RIGH')
        !this.ctelementType.dText = !type
        !this.ctelementType.rText = !rtype
        !this.ctelementTypeTag.val = 'Leave Side :'
      endif

 -- mode
      var !mode mode
      if !mode.upcase().eq('BACKWARDS') then
        !this.backwardMode.val = TRUE
      else
        !this.backwardMode.val = FALSE
      endif


endmethod
------------------------------------------------------------------------
--
-- Method:      addTier
--
-- Description: Sets the number of tiers
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addTier(!gadget is GADGET, !action is STRING)

  if !action.eq('VALIDATE') then
    !newHei = !gadget.displayText().replace(' ','')
    -- see if value is VALIDATE
    !realNew = object REAL(!newHei, !!distanceFmt)
    handle ANY
      !!alert.error('Enter a real value')
      return
    endhandle
    if !realNew.lt(0) then
      !!alert.error('Enter a valid height')
       return
    endif

    --see if the height already exists
    !values = !gadget.dText

    do !i from 1 to !values.size()
    	!valuesReal = object REAL(!values[!i], !!distanceFmt)
      if !valuesReal.eq(!realNew) then
        !!alert.error('Value already exists!')
        return
      endif
    enddo
    !gadget.add(!newHei)
    --sort the values
    !sortArray = !gadget.dText
    --convert to real
    !newArray = object ARRAY()
    do !i indices !sortArray
     !realValue = object REAL(!sortArray[!i], !!distanceFmt)
     !newArray.append(!realValue.nint())
    enddo
     !newSort = !newArray.sort()
     --convert back to STRING
     !dText = object ARRAY()
     !rText = object ARRAY()
     do !j indices !newSort
      !dText.append(!newSort[!j].string(!!distanceFmt))
      !rText.append(!newSort[!j].string())
     enddo
    !gadget.dText = !dText
    !gadget.rText = !rText
    !gadget.select('DTEXT', !newHei)
    handle ANY
    endhandle

  endif

 endmethod
------------------------------------------------------------------------
--
-- Method:      specWidth
--
-- Description: gets the available widths
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .specWidth()

  !specSelection = !this.ctmtrlSpec.selection().dbref()

  if (!specSelection.unset()) then
    !restFinal = object ARRAY()
    if (!!isImperialLength('DIST').not()) then
      !restFinal.append('50mm')
      !restFinal.append('75mm')
      !restFinal.append('100mm')
      !restFinal.append('125mm')
      !restFinal.append('150mm')
      !restFinal.append('200mm')
      !restFinal.append('250mm')
      !restFinal.append('300mm')
      !restFinal.append('350mm')
      !restFinal.append('400mm')
      !restFinal.append('450mm')
      !restFinal.append('500mm')
      !restFinal.append('600mm')
      !restFinal.append('700mm')
      !restFinal.append('800mm')
      !restFinal.append('900mm')
      !restFinal.append('1000mm')
    else
      !restFinal.append('2in')
      !restFinal.append('3in')
      !restFinal.append('4in')
      !restFinal.append('5in')
      !restFinal.append('6in')
      !restFinal.append('8in')
      !restFinal.append('10in')
      !restFinal.append('12in')
      !restFinal.append('14in')
      !restFinal.append('16in')
      !restFinal.append('18in')
      !restFinal.append('20in')
      !restFinal.append('24in')
      !restFinal.append('28in')
      !restFinal.append('32in')
      !restFinal.append('36in')
      !restFinal.append('40in')
    endif
  else

    !colTab = object COLLECTION()
    !colTab.type('CTABLE')
    !colTab.scope(!specSelection)
    !colTab.filter( object EXPRESSION('PURP EQ |STRA|'))
    !ctable = !colTab.results()[1]
    handle any
      !ctable = !specSelection
    endhandle

    !coll = object COLLECTION()
    !coll.type('tabque')
    !expression = object EXPRESSION('PURP eq |WIDT|')
    !coll.filter(!expression)
    !coll.scope(!ctable)
    !resu = object ARRAY()
    !rest = object ARRAY()
    !restFinal = object ARRAY()
    !results = !coll.results()

    do !val values !results
      !res = !val.tanswer.real().dbunits()
      handle any
      endhandle
        !resu.append(!res)
     enddo

    !resu.unique().sort()

    !restFinal = object ARRAY()
    do !val values !resu
      if (!!isImperialLength('DIST').not()) then
        !restFinal.append(!val.string(!!distanceFmt))
      else
        !valTemp = (!val.value() / 25)
        !restFinal.append(!valTemp.string(!!distanceFmt))
      endif
    enddo

  endif

  !this.pdresstraywidth.dText = !restFinal
  !this.pdresstraywidth.rText = !restFinal

  do !i index !this.pdresstraywidth.dText
    if(!this.pdresstraywidth.dText[!i].real().eq(!this.cableway.ctmtrl.trayw))then
      !this.pdresstraywidth.val  = !i
    endif
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tmplWidth
--
-- Description: gets the available widths from templates
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tmplWidth()

  !bores = object ARRAY()
  if !this.loadedTmpl.set() then
   !col = object COLLECTION()
   !col.type('CTSTRA')
   !col.scope(!this.loadedTmpl)

    do !tray values !col.results()

      if (!!isImperialLength('DIST')) then
       -- units
       !width = !!comValueConvert(!tray.trayw,'MM')
       !gwidth = !width
       --!this.getNearestWidth(!width)
       !gwidth = !gwidth / 25
       !bores.append(!gwidth.string())
      else
       !bores.append(!tray.trayw.string())
      endif
    enddo

    --sort
    !bores.sortunique()

    !this.pdresstraywidth.dText = !bores
    !this.pdresstraywidth.rText = !bores
  else
      if (!!isImperialLength('DIST')) then
       !width = !!comValueConvert(!this.cableway.ctmtrl.trayw,'MM') / 25
       !bores.append(!width.nint().string())
      else
       !bores.append(!this.cableway.ctmtrl.trayw.string())
      endif
    !this.pdresstraywidth.dText = !bores
    !this.pdresstraywidth.rText = !bores
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      removeTier
--
-- Description: removes the selected tier
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeTier(!gadget is GADGET)

  !hei = !gadget.displayText().trim()
  if !gadget.dText.size().eq(1) then
    !!alert.error('Cannot remove the tier height. There should be minimum one tier')
    return
  else
   !gadget.clear(!hei)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create Elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create(!element is STRING)

   !this.loadObjectMembers(!element)
   var !mode mode
   if !element.neq('CTMTRL') then
     if !mode.upcase().eq('FORWARDS') then
      !!ce = !this.previous
      handle ANY
      endhandle
     endif
   endif
   !this.cableway.create(!element)

   if !mode.upcase().eq('BACKWARDS') then
    if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
        !posref = !!ce.posref
        !newPosref = prev of $!posref
        handle (2,113)
         !newPosref = next of $!posref
        endhandle
        -- calculate segment length
        !line = object LINE(!posref.position, !newPosref.position)
        !length = !line.length()
        if !!ce.posref.tysequence.eq(!!ce.posref.owner.members.size()) then
          if !!ce.posref.tysequence.eq(!this.ctelementPosn.val) then
           !length = 0
          endif
        endif
        !overallLength = !!ce.olength
        !!ce.zdistance = !length - !overallLength - !!ce.zdistance
    endif

    if !!ce.type.eq('CTBEND') or !!ce.type.eq('CTRISE') then
      !posref = !!ce.posref
      !newPosref = prev of $!posref
      handle (2,113)
       !newPosref = !posref
      endhandle
      !!ce.posref = !newPosref
    endif
   endif

   if !element.neq('CTMTRL')  then
    if !this.useTemplate.val then
      !elementType = !this.elementTable.selection()
      !!ce = !this.cableway.$!<elementType>
      if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
       !overallLength = olength
      endif
      --change level
      level 0 1
      !savePosref = !!ce.posref
      var !level Level
      !zdist = Zdistance
      !pkdis = Pkdistance
      !xoff = Xoffset
      !zoff = Zoffset
      !bangle = Bangle
      !memberToCopy = !this.ctmtrlTypes.dText[$!this.ctmtrlTypes.val]
      copy $!memberToCopy
      if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
        olength $!overallLength
      endif
      posref $!savePosref
      level $!level
      zdist $!zdist
      pkdist $!pkdis
      Xoffset $!xoff
      Zoffset $!zoff
      Bangle $!bangle
      !this.updateRules()

      --rotate tees if required
      if !!ce.type.eq('CTTEE') then
       if !this.getTeeSide(!this.pickedratta).eq('LEFT') then
        if !!ce.cttype.eq('RIGHT') then
           !!ce.cttype = 'LEFT'
           --rotate
            do !tray values !!ce.members
             if !tray.type.eq('CTRAY') then
              !dbElement = !!ce
              !!ce = !tray
              !pos = !!ce.position
              !rdir = U wrt ce
              ROTATE through $!pos about $!rdir by 180
              !!ce = !dbElement
             endif
            enddo
         endif
       elseif !this.getTeeSide(!this.pickedratta).eq('RIGHT') then
         if !!ce.cttype.eq('LEFT') then
           !!ce.cttype = 'RIGH'
           --rotate
            do !tray values !!ce.members
             if !tray.type.eq('CTRAY') then
              !dbElement = !!ce
              !!ce = !tray
              !pos = !!ce.position
              !rdir = U wrt ce
              ROTATE through $!pos about $!rdir by 180
              !!ce = !dbElement
             endif
            enddo
         endif
       endif
      endif

    endif
   endif

   if !element.eq('CTMTRL') then
    !this.setTask('MODIFY',!element)
   else
    !this.setTask('CREATE',!element)
   endif

 endmethod
------------------------------------------------------------------------
--
-- Method:      loadObjectMembers
--
-- Description: Loads members of cableway object
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadObjectMembers(!element is STRING)


  --load common attributes
  if !this.material.findfirst(!element.upcase()).set() then
    var !mode mode
    !this.cableway.zdis         = !this.ctelementZdis.val
    !this.cableway.pkdis        = !this.ctelementPkdis.val
    !this.cableway.xoffset      = !this.ctelementXoff.val
    !this.cableway.zoffset      = !this.ctelementZoff.val
    !this.cableway.bangle       = !this.ctelementBang.val
    !this.cableway.trayw        = !this.ctelementAWidt.val
    !this.cableway.trayh        = !this.ctelementHeig.val

    !tiers = object ARRAY()

    do !tier values !this.ctelementThei.rText
      !tiers.append(!tier.real())
    enddo

    !this.cableway.tierheight   = !tiers

    !num     = !this.ctelementPosn.val
    if !mode.upcase().eq('BACKWARDS') then
      !num = !num + 1
    endif

    !cwbran  = !this.cableway.cwbran
    !point   = POINTR $!num of RPATH 1 of $!cwbran
    handle ANY
      !num = !num - 1
      !point   = POINTR $!num of RPATH 1 of $!cwbran
    endhandle
    !this.cableway.posref      = !point
    !level = object ARRAY()
    if !this.ctelementDisplay.val then
      !level.append(0)
      !level.append(10)
    else
      !level.append(0)
      !level.append(1)
    endif
    !this.cableway.level      = !level
  endif

  if !element.upcase().eq('CTMTRL') then
    !this.cableway.name         = '/' & !this.ctmtrlName.val
    !this.cableway.description  = !this.ctmtrlDesc.val
    !this.cableway.function     = !this.ctmtrlFunc.val
    !this.cableway.purpose      = !this.ctmtrlPurp.val
    !this.cableway.fgap         = !this.ctmtrlfgap.val
    !this.cableway.igap         = !this.ctmtrligap.val
    !this.cableway.lgap         = !this.ctmtrllgap.val
    !this.cableway.trayw        = !this.ctmtrltraywidth.val
    !this.cableway.trayh        = !this.ctmtrltrayheight.val
    !tiers = object ARRAY()
    do !tier values !this.ctmtrlThei.rText
      !tiers.append(!tier.real())
    enddo
    !this.cableway.tierheight   = !tiers
    !spec = !this.ctmtrlSpec.selection()
    !this.cableway.spref         = !spec.dbref()
    handle ANY
      !this.cableway.spref       = object DBREF()
    endhandle

  elseif !element.upcase().eq('USERPRELIMINARY') then
    !this.cableway.name         = !this.cableway.ctmtrl.name
    !this.cableway.description  = !this.cableway.ctmtrl.description
    !this.cableway.function     = !this.cableway.ctmtrl.function
    !this.cableway.purpose      = !this.cableway.ctmtrl.purpose
    !this.cableway.fgap         = !this.pdressfgap.val
    !this.cableway.igap         = !this.pdressigap.val
    !this.cableway.lgap         = !this.pdresslgap.val
    !this.cableway.trayw        = !this.pdresstraywidth.dText[!this.pdresstraywidth.val].real()

    if !this.template.not() then
    !this.cableway.trayh        = !this.pdresstrayheight.val
    !tiers = object ARRAY()
    do !tier values !this.pdressThei.rText
      !tiers.append(!tier.real())
    enddo
    !this.cableway.tierheight   = !tiers
    !spec = !this.ctmtrlSpec.selection()
    !this.cableway.spref         = !spec.dbref()
    handle ANY
      !this.cableway.spref       = object DBREF()
    endhandle
    else
     !this.cableway.trayh        = !this.cableway.ctmtrl.trayh
     !this.cableway.tierheight   = !this.cableway.ctmtrl.tierheight
     if  !this.cableway.ctmtrl.ctspec.set() then
      !this.cableway.spref        = !this.cableway.ctmtrl.ctspec
     else
      !this.cableway.spref       = object DBREF()
     endif

    endif

  elseif !element.upcase().eq('OPTIPRELIMINARY') then
    !this.cableway.name         = !this.cableway.ctmtrl.name
    !this.cableway.description  = !this.cableway.ctmtrl.description
    !this.cableway.function     = !this.cableway.ctmtrl.function
    !this.cableway.purpose      = !this.cableway.ctmtrl.purpose
    !this.cableway.fgap         = !this.pdressfgap.val
    !this.cableway.igap         = !this.pdressigap.val
    !this.cableway.lgap         = !this.pdresslgap.val
    !this.cableway.trayw        = !this.cableway.ctmtrl.trayw
    !this.cableway.trayh        = !this.cableway.ctmtrl.trayh
    !this.cableway.tierheight   = !this.cableway.ctmtrl.tierheight
    !spec = !this.ctmtrlSpec.selection()
    !this.cableway.spref         = !spec.dbref()
    handle ANY
      !this.cableway.spref       = object DBREF()
    endhandle


  elseif !element.upcase().eq('CTSTRA') then
    !this.cableway.olength      = !this.ctelementALeng.val
  elseif !element.upcase().eq('CTBEND') or !element.upcase().eq('CTRISE') then
    !this.cableway.alength      = !this.ctelementALeng.val
    !this.cableway.llength      = !this.ctelementLLeng.val
    !this.cableway.radius       = !this.ctelementRadius.val
    !this.cableway.angle        = !this.ctelementAngle.val
    !this.cableway.cttype       = !this.ctelementType.rText[!this.ctelementType.val]
  elseif !element.upcase().eq('CTREDU') then
    !this.cableway.olength      = !this.ctelementALeng.val
    !this.cableway.trayrw       = !this.ctelementLWidt.val
    !this.cableway.cttype       = !this.ctelementType.rText[!this.ctelementType.val]
  elseif !element.upcase().eq('CTTEE') or !element.upcase().eq('CTCROS') then
    !this.cableway.alength      = !this.ctelementALeng.val
    !this.cableway.llength      = !this.ctelementLLeng.val
    !this.cableway.slength      = !this.ctelementSLeng.val
    !this.cableway.sslength     = !this.ctelementSSLeng.val
    !this.cableway.traysw       = !this.ctelementLWidt.val
    !this.cableway.trayow       = !this.ctelementSLWidt.val
    !this.cableway.radius       = !this.ctelementRadius.val
    !this.cableway.angle        = !this.ctelementAngle.val
    !this.cableway.cttype       = !this.ctelementType.rText[!this.ctelementType.val]
  endif

 endmethod
------------------------------------------------------------------------
--
-- Method: modify
--
-- Description: modify the elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modify(!element is STRING)

  if !element.eq('PRELIMINARY') then
   !dressElement = 'CTMTRL'
   if !this.optimum then
    !dressLoader  = 'OPTIPRELIMINARY'
   else
    !dressLoader   = 'USERPRELIMINARY'
   endif
  else
   !dressElement = !element
   !dressLoader  = !element
  endif

   !this.loadObjectMembers(!dressLoader)
   !this.cableway.modify(!dressElement)

   -- templates

   if !element.neq('CTMTRL') then
    !elementType = !this.elementTable.selection()
    !!ce = !this.cableway.$!<elementType>
    var !mode mode
     if !mode.upcase().eq('BACKWARDS') then
    if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
     --move the overall Length distance in backward mode
        !posref = !!ce.posref
        !newPosref = next of $!posref
        handle (2,113)
         !newPosref = prev of $!posref
        endhandle
        -- calculate segment length
        !line = object LINE(!posref.position, !newPosref.position)
        !length = !line.length()
        if !!ce.posref.tysequence.eq(!!ce.posref.owner.members.size()) then
          if !!ce.posref.tysequence.eq(!this.ctelementPosn.val) then
           !length = 0
          endif
        endif
        !overallLength = !!ce.olength
        !!ce.zdistance = !length - !overallLength - !!ce.zdistance
      endif
      if !!ce.type.eq('CTBEND') or !!ce.type.eq('CTRISE') then
        !posref = !!ce.posref
        !newPosref = prev of $!posref
        handle (2,113)
         !newPosref = !posref
        endhandle
        !!ce.posref = !newPosref
      endif
      if !!ce.type.eq('CTTEE') or !!ce.type.eq('CTCROS') then
        !posref = !!ce.posref
        !newPosref = prev of $!posref
        handle (2,113)
         !newPosref = !posref
        endhandle
        !!ce.posref = !newPosref
        -- calculate segment length
         !line = object LINE(!posref.position, !newPosref.position)
         !length = !line.length()
         if !!ce.posref.tysequence.eq(!!ce.posref.owner.members.size()) then
           if !!ce.posref.tysequence.eq(!this.ctelementPosn.val) then
            !length = 0
           endif
         endif
         !!ce.zdistance = !length - !!ce.zdistance
     endif
    endif
    if !this.useTemplate.val then
      if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
       !overallLength = olength
      endif
      --change level
      level 0 1
      !savePosref = !!ce.posref
      var !level Level
      !zdist = Zdistance
      !pkdis = Pkdistance
      !xoff = Xoffset
      !zoff = Zoffset
      !bangle = Bangle
      -- It is likely that the element has been locked so unlock it
      unlock all
       handle ANY
       endhandle
       !type = !!ce.type
      delete $!type mem
      !memberToCopy = !this.ctmtrlTypes.dText[$!this.ctmtrlTypes.val]
      copy $!memberToCopy
      if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
        olength $!overallLength
      endif
      posref $!savePosref
      level $!level
      zdist $!zdist
      pkdist $!pkdis
      Xoffset $!xoff
      Zoffset $!zoff
      Bangle $!bangle
      !this.updateRules()

    endif
   endif


   if(!this.optimum.eq(false) and !this.tmplAppdataTag.visible)then
    !dressLoader = 'TEMPLATE'
    !this.setTask('MODIFY',!dressLoader)
   else
    !this.setTask('MODIFY',!dressLoader)
   endif



endmethod
------------------------------------------------------------------------
--
-- Method: modify
--
-- Description: modify the elements using preliminary dressing gadget values
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modify(!element is DBREF)

  !element.fgap  =  !this.pdressfgap.val
  !element.igap  =  !this.pdressigap.val
  !element.lgap  =  !this.pdresslgap.val

  -- standard spec
  if !this.optimum.not() and !this.template.not() then

    !element.trayw  =  !this.pdresstraywidth.selection().real()
    !element.trayh  =  !this.pdresstrayheight.val
    !tiers          =  object ARRAY()

    do !tier values !this.pdressThei.rText
      !tiers.append(!tier.real())
    enddo
    !element.tierheight  =  !tiers
  endif

  -- templates
  if !this.template then
    !element.trayw  =  !this.pdresstraywidth.selection().real()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: loadData
--
-- Description: Load the element data into gadgets
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadData(!element is STRING)



   --mode
   var !mode mode
   -- load all common attributes
   if !this.material.findfirst(!element.upcase()).set() then
    --reference point
    !col = object COLLECTION()
    !col.scope(!!ce.owner.owner)
    !col.type('POINTR')
    !text = object ARRAY()
     do !i from 1 to !col.results().size()
      !text.append(!i.string())
     enddo
     if !text.unset() then
      !text.append('1')
     endif
     !this.ctelementPosn.dText = !text
     if !mode.upcase().eq('BACKWARDS') then
      !results = !col.results().invert()
     else
      !results = !col.results()
     endif
     !number = !results.findfirst(!!ce.posref)
    if !number.unset() then
      !number = 1
    endif
    !this.ctelementPosn.val =  !number
    !this.cableway.pointr = !col.results()[!number]
    if !mode.upcase().eq('BACKWARDS') then
       if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') or !!ce.type.eq('CTTEE') or !!ce.type.eq('CTCROS') then
        !this.ctelementPosn.val =  !number - 1
       endif
    endif
   --setting form member trayComponent
   !this.trayComponent = !!ce


    -- offsets
    !this.ctelementZdis.val   = !!ce.zdistance
    if !mode.upcase().eq('BACKWARDS') then
      !line = object LINE()
      !firstPos = pos of posref
      !secondPos = pos of next of posref
      handle ANY
        !secondPos = pos of prev of posref
      endhandle
      !line.startposition = !firstPos
      !line.endposition   = !secondPos
      !segmentLength = !line.length()
      if !!ce.type.eq('CTSTRA') or !!ce.type.eq('CTREDU') then
        !backDistance = !segmentLength - (!!ce.zdistance + !!ce.olength)
        !this.ctelementZdis.val   = !backDistance
      endif
      if !!ce.type.eq('CTTEE') or !!ce.type.eq('CTCROS') then
        !backDistance = !segmentLength - !!ce.zdistance
        !this.ctelementZdis.val   = !backDistance
      endif
    endif
    !this.ctelementPkdis.val  = !!ce.pkdistance
    !this.ctelementZoff.val   = !!ce.zoffset
    !this.ctelementXoff.val   = !!ce.xoffset
    !this.ctelementBang.val   = !!ce.bangle
    !this.ctelementAWidt.val  = !!ce.trayw
    !this.ctelementHeig.val   = !!ce.trayh
    !this.ctelementMoveValue.val  = 0

    -- set the previous element
    !this.previous = previous
    handle (2,113)
     !this.previous = owner
    endhandle

    -- Set gap value
    !this.ctelementposFromPrev.val = !this.getGap()
    handle ANY
      !this.ctelementposFromPrev.val = 0
    endhandle
    !this.gapValue  = !this.ctelementposFromPrev.val

    --tiers
    !tier    = !!ce.tierheight
    if !tier.unset() then
      !tier = object ARRAY()
      !tier.append(0)
    endif
    !tierText  = object ARRAY()
    !tierRText = object ARRAY()
    do !j from 1 to !tier.size()
     !tierText.append(!tier[!j].string(!!distanceFmt))
     !tierRText.append(!tier[!j].string())
    enddo

    !this.ctelementThei.dText = !tierText
    !this.ctelementThei.rText = !tierRText
    -- level
    !level = object ARRAY()
    !level.append(0)
    !level.append(10)
    if !!ce.level.eq(!level) then
      !this.ctelementDisplay.val = TRUE
    else
      !this.ctelementDisplay.val = FALSE
    endif

    -- templates toggle
    !this.useTemplate.val = false

    -- number of Copies
    !this.nuCopies.val = 1

   endif

   if !element.eq('CTMTRL') then
    !!ce = !this.cableway.ctmtrl
    !this.cableway.activeElement = !!ce
    !this.ctmtrlDesc.val       = !!ce.description
    !this.ctmtrlFunc.val       = !!ce.function
    !this.ctmtrlPurp.val       = !!ce.purpose
    !this.ctmtrlName.val       = !!ce.flnn
    !this.ctmtrlfgap.val       = !!ce.fgap
    !this.ctmtrligap.val       = !!ce.igap
    !this.ctmtrllgap.val       = !!ce.lgap
    !this.ctmtrlThei.dText     = !this.getTierHeight(!!ce)[1]
    !this.ctmtrlThei.rText     = !this.getTierHeight(!!ce)[2]
    !this.ctmtrltraywidth.val  = !!ce.trayw
    !this.ctmtrltrayheight.val = !!ce.trayh
    !this.ctmtrlSpec.val       = !this.ctmtrlSpec.rText.findfirst(!!ce.ctspe.string())
    handle ANY
     !this.ctmtrlSpec.val       = 1
    endhandle
   elseif !element.eq('USERPRELIMINARY') then
    !this.specWidth()
    !this.pdressfgap.val       = !this.cableway.ctmtrl.fgap
    !this.pdressigap.val       = !this.cableway.ctmtrl.igap
    !this.pdresslgap.val       = !this.cableway.ctmtrl.lgap
    !this.pdressThei.dText     = !this.getTierHeight(!this.cableway.ctmtrl)[1]
    !this.pdressThei.rText     = !this.getTierHeight(!this.cableway.ctmtrl)[2]
    do !i from 1 to !this.pdresstraywidth.dText.size()
      if(!this.pdresstraywidth.dText[!i].real().eq(!this.cableway.ctmtrl.trayw))then
        !this.pdresstraywidth.val  = !i
      endif
    enddo
    !this.pdresstrayheight.val = !this.cableway.ctmtrl.trayh
    !this.straLength.val        = 2000 mm
    !this.ctmtrlSpecdata.val    = !this.ctmtrlSpecdata.rText.findfirst(!this.cableway.ctmtrl.ctspe.string())
    handle ANY
     !this.ctmtrlSpecdata.val       = 1
    endhandle
    if !this.cableway.ctmtrl.ctspec.set() and !this.cableway.ctmtrl.ctspec.neq(!this.loadedSpec) then
      !this.loadSpecDimensions()
    endif

    -- mode
      if (!this.cableway.cwtm.getdressingdirection()) then
        !this.backwardWhole.val = FALSE
      else
        !this.backwardWhole.val = TRUE
      endif

   elseif !element.eq('OPTIPRELIMINARY') then

    !this.pdressfgap.val       = !this.cableway.ctmtrl.fgap
    !this.pdressigap.val       = !this.cableway.ctmtrl.igap
    !this.pdresslgap.val       = !this.cableway.ctmtrl.lgap

    !this.straLength.val        = 2000 mm
    !this.ctmtrlSpecdata.val    = !this.ctmtrlSpecdata.rText.findfirst(!this.cableway.ctmtrl.ctspe.string())
    handle ANY
     !this.ctmtrlSpecdata.val       = 1
    endhandle

    if !this.cableway.ctmtrl.ctspec.set() and !this.cableway.ctmtrl.ctspec.neq(!this.loadedSpec) then
      !this.loadSpecDimensions()
    endif

   -- mode
      if (!this.cableway.cwtm.getdressingdirection()) then
        !this.backwardWhole.val = FALSE
      else
        !this.backwardWhole.val = TRUE
      endif

   elseif !element.eq('TEMPLATE') then
    !this.tmplWidth()
    !this.pdressfgap.val       = !this.cableway.ctmtrl.fgap
    !this.pdressigap.val       = !this.cableway.ctmtrl.igap
    !this.pdresslgap.val       = !this.cableway.ctmtrl.lgap
    !this.straLength.val        = 2000 mm
    -- mode
      if (!this.cableway.cwtm.getdressingdirection()) then
        !this.backwardWhole.val = FALSE
      else
        !this.backwardWhole.val = TRUE
      endif
   elseif !element.eq('CTSTRA') then
    !this.ctelementALeng.val      = !!ce.olength
   elseif !element.eq('CTBEND') or !element.eq('CTRISE')then
     !this.ctelementALeng.val      = !!ce.alength
     !this.ctelementLLeng.val      = !!ce.llength
     !this.ctelementRadius.val     = !!ce.radius
     !this.ctelementAngle.val      = !!ce.angle
     !this.ctelementType.val       = !this.ctelementType.rText.findfirst(!!ce.cttype)
     handle ANY
      !this.ctelementType.val      = 1
     endhandle
   elseif !element.eq('CTREDU') then
     !this.ctelementALeng.val      = !!ce.olength
     !this.ctelementLWidt.val      = !!ce.trayrw
     !this.ctelementType.val       = !this.ctelementType.rText.findfirst(!!ce.cttype)
     handle ANY
      !this.ctelementType.val      = 1
     endhandle
   elseif !element.eq('CTTEE')then
    !this.ctelementALeng.val      = !!ce.alength
    !this.ctelementLLeng.val      = !!ce.llength
    !this.ctelementSLeng.val      = !!ce.slength
    !this.ctelementLWidt.val      = !!ce.traysw
    !this.ctelementAngle.val      = !!ce.angle
    !this.ctelementRadius.val     = !!ce.radius
    !this.ctelementType.val       = !this.ctelementType.rText.findfirst(!!ce.cttype)
     handle ANY
      !this.ctelementType.val      = 1
     endhandle
   elseif !element.eq('CTCROS') then
    !this.ctelementALeng.val      = !!ce.alength
    !this.ctelementLLeng.val      = !!ce.llength
    !this.ctelementSLeng.val      = !!ce.slength
    !this.ctelementLWidt.val      = !!ce.traysw
    !this.ctelementAngle.val      = !!ce.angle
    !this.ctelementRadius.val     = !!ce.radius
    !this.ctelementSSLeng.val     = !!ce.sslength
    !this.ctelementSLWidt.val     = !!ce.trayow
    !this.ctelementType.val       = !this.ctelementType.rText.findfirst(!!ce.cttype)
     handle ANY
      !this.ctelementType.val      = 1
     endhandle
   endif

   --aids
   if !!ce.type.neq('CTMTRL') then
    !this.ctsphere.position = !!ce.position
    if !mode.upcase().eq('FORWARDS') then
     !this.ctsphere.description = '<Origin>'
    else
     if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
      -- derive position considering overall length
      !dir = !!ce.posref.pdir[2]
      !overallLength  = !!ce.olength
      !pos = !!ce.position.offset(!dir, !overallLength)
      !this.ctsphere.position = !pos
      if !this.task.upcase().eq('MODIFY') then
       !this.ctsphere.description = '<Leave>'
      else
       !this.ctsphere.description = '<Origin>'
      endif
     else
      !this.ctsphere.description = '<Origin>'
     endif
    endif
    !this.ctsphere.draw(!this.ctAidNumber)
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: createData
--
-- Description: Load the element data into create gadgets
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createData(!element is STRING)

   --load common attributes
   if !element.neq('CTMTRL') then
      --initialise variables
      !this.previous  = object DBREF()
      !this.updateGap = TRUE

      -- gap values
      -- show the gaps only if the element is a CTSTRA or a CTREDU

       if !element.eq('CTSTRA') or !element.eq('CTREDU') then
        var !mode mode
        if !mode.upcase().eq('BACKWARDS') then
          if !!cbldflts.useGaps.val then
            !this.ctelementposFromPrev.val = !!cbldflts.lastGap.val
            !this.gapValue  = !this.ctelementposFromPrev.val
         else
           !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.lgap
           !this.gapValue  = !this.ctelementposFromPrev.val
         endif
        else

         if !!cbldflts.useGaps.val then
            !this.ctelementposFromPrev.val = !!cbldflts.firstGap.val
            !this.gapValue  = !this.ctelementposFromPrev.val
         else
           !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.fgap
           !this.gapValue  = !this.ctelementposFromPrev.val
         endif
        endif
       else
        !this.ctelementposFromPrev.val = 0
        !this.gapValue  = !this.ctelementposFromPrev.val
       endif
     !this.ctelementZdis.val       = !this.ctelementposFromPrev.val
     !this.ctelementMoveValue.val  = 0
     !this.ctelementPkdis.val      = 0
     !this.ctelementXoff.val       = 0
     !this.ctelementZoff.val       = 0
     !this.ctelementBang.val       = 0
     !this.ctelementAWidt.val      = !this.getWidth(CTMTRL)
     handle ANY
      !this.getWidth(!!ce)
     endhandle
     !this.ctelementHeig.val       = !this.getHeight(CTMTRL)
     handle ANY
       !this.getHeight(!!ce)
     endhandle
     !this.ctelementAngle.val      = 90
     !this.ctelementThei.dText     = !this.getTierHeight(!!ce)[1]
     !this.ctelementThei.rText     = !this.getTierHeight(!!ce)[2]

     if !this.ctelementThei.dText.unset() then
      !tier  = object ARRAY()
      !tier.append('0')
      !this.ctelementThei.dText = !tier
      !this.ctelementThei.rText = !tier
     endif
     -- collect route points for populating reference gadget
       !col = object COLLECTION()
       !col.scope(!this.cableway.cwbran)
       !col.type('POINTR')
       !text = object ARRAY()
       do !i from 1 to !col.results().size()
        !text.append(!i.string())
       enddo
       !this.ctelementPosn.dText = !text
       !this.ctelementPosn.rText = !text
       !this.cableway.pointr = !col.results()[1]

        --aids
       !this.offsetDistance()

       --level
       !this.ctelementDisplay.val = TRUE

   else
      !tier  = object ARRAY()
      !tier.append('0')
      !this.ctmtrlThei.dText       = !tier
      !this.ctmtrlThei.rText       = !tier
      !this.ctmtrltraywidth.val    = !this.cableway.cwbran.vwidth
      !this.ctmtrltrayheight.val   = !this.cableway.cwbran.vheight

      -- specs
      if !!cbldflts.cwaymatspecdefault.set() then
        !this.ctmtrlSpec.val = !this.ctmtrlSpec.rText.findfirst(!!cbldflts.cwaymatspecdefault.string())
      else
        !this.ctmtrlSpec.val = 1
      endif

   endif

   if !element.eq('CTSTRA') then
     !this.ctelementALeng.val      = 1000 mm
   elseif !element.eq('CTBEND') or !element.eq('CTRISE')then
     !this.ctelementALeng.val      = 200 mm
     !this.ctelementLLeng.val      = 200 mm
     !this.ctelementRadius.val     = 0
     !this.ctelementAngle.val      = 90
   elseif !element.eq('CTREDU') then
     !this.ctelementALeng.val      = 200 mm
     !this.ctelementLWidt.val      = !this.ctelementAWidt.val - 25 mm
     -- interchange the dimensions in backwards mode
     var !mode mode
     if !mode.upcase().eq('BACKWARDS') then
      !tempValue  = !this.ctelementLWidt.val
      !this.ctelementLWidt.val      = !this.ctelementAWidt.val
      !this.ctelementAWidt.val      = !tempValue
     endif
   elseif !element.eq('CTTEE')  then
    !this.ctelementALeng.val      = 200 mm
    !this.ctelementLLeng.val      = 200 mm
    !this.ctelementSLeng.val      = 200 mm
    !this.ctelementLWidt.val      = 75 mm
    !this.ctelementAngle.val      = 90
    !this.ctelementRadius.val     = 0
   elseif !element.eq('CTCROS') then
    !this.ctelementALeng.val      = 200 mm
    !this.ctelementLLeng.val      = 200 mm
    !this.ctelementSLeng.val      = 100 mm
    !this.ctelementLWidt.val      = 75 mm
    !this.ctelementAngle.val      = 90
    !this.ctelementRadius.val     = 0
    !this.ctelementSSLeng.val     = 100 mm
    !this.ctelementSLWidt.val     = 75 mm
   elseif !element.eq('CTMTRL') then
     !this.ctmtrlDesc.val  = ''
     !this.ctmtrlFunc.val  = ''
     !this.ctmtrlPurp.val  = ''
     !this.ctmtrlName.val  = ''
     if (!!cbldflts.useGaps.val) then
       !this.ctmtrlfgap.val  = !!cbldflts.firstGap.val
       !this.ctmtrligap.val  = !!cbldflts.intermediateGap.val
       !this.ctmtrllgap.val  = !!cbldflts.lastGap.val
     else
       !this.ctmtrlfgap.val  = 0 mm
       !this.ctmtrligap.val  = 0 mm
       !this.ctmtrllgap.val  = 0 mm
     endif
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: nameCheck
--
-- Description: Check the correctness of the name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameCheck(!elementType is STRING)

    --Check name of Element
    !name                   = !!checkName(!this.$!<elementType>Name.val, 'NEW')

    --Update gadget with name
    if(!name.set()) then
        !name               = !name.substring(2)
        !this.$!<elementType>Name.val          = !name
    endif

endmethod
------------------------------------------------------------------------
--
-- Method: autoNameCe
--
-- Description: Autonaming elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoNameCe(!type is STRING)

  !this.ctmtrlName.val = !!cblautoname(!type, !this.cableway.cwbran)

endmethod
------------------------------------------------------------------------
--
-- Method: currentElement
--
-- Description: Loads the data of current Element to form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .currentElement()

    --Check whether the current element type is in elemList
    !type  = !!ce.type
    !exist = !this.material.findfirst(!type)
    if !exist.unset() then
      -- see if it is a CTMTRL
      if !!ce.type.neq('CTMTRL') then
      !!alert.error('This action cannot be performed on the current element')
         return
      else
       !this.setTask(|MODIFY|,!type)
      endif
    else
      !this.setTask(|MODIFY|,!type)
    endif

endmethod
------------------------------------------------------------------------
--
-- Method: discard
--
-- Description: Discard Changes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .discard()

  !!ce =  !this.cableway.activeElement
  !this.currentElement()

endmethod
------------------------------------------------------------------------
--
-- Method: pick
--
-- Description: pick elements for filling straights in between
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick()

  !!edgCntrl.remove('Pick Segment or Point')
 -- define pick elements
 !element = 'TYPE inset (|CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|, |CTRAY|, |RATTA|, |RNODE|, |POINTR|, |HATTA|, |TATTA|)'

 -- define packet
  !firstPacket                = object EDGPACKET()
  !firstPacket.description    = 'Pick Segment or Point'
  !firstPacket.initialisation = '!!cblmtrl.pickedElements  = object ARRAY()'
  !firstPacket.pickPacket.stdElement('Pick First Element')
  !firstPacket.action         = '!!cblmtrl.pickedElements.append(!this.return[1])'
  !firstPacket.pickPacket.picks[1].pick.input[3] = !element
  !firstPacket.pickPacket.picks[1].pick.modifiable = FALSE
  !firstPacket.priority       = 2
  !firstPacket.remove         = TRUE
  !firstPacket.escape         = ''

  !secondPacket               = object EDGPACKET()
  !secondPacket.description   = 'Pick Segment or Point'
  !secondPacket.pickPacket.stdElement('Pick Second Element')
  !secondPacket.action        = '!!cblmtrl.pickedElements.append(!this.return[1])'
  !secondPacket.pickPacket.picks[1].pick.input[3] = !element
  !secondPacket.pickPacket.picks[1].pick.modifiable = FALSE
  !secondPacket.priority      = 3
  !secondPacket.remove        = TRUE
  !secondPacket.continue      = '!!cblmtrl.dressBetweenComponents()'

  !!edgCntrl.add(!secondPacket)
  !!edgCntrl.add(!firstPacket)

endmethod
------------------------------------------------------------------------
--
-- Method: pickMultiple
--
-- Description: pick elements for filling multiple segments in line
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickMultiple()

   !!edgCntrl.remove('Pick Segment or Point')
   !!edgCntrl.remove('Pick Segment or Point')

 -- define packet
  !firstPacket                = object EDGPACKET()
  !firstPacket.description    = 'Pick Segment or Point'
  !firstPacket.initialisation = '!!cblmtrl.pickedElements  = object ARRAY()'
  !firstPacket.pickPacket.stdgraphic('Pick near the first point to be dressed')
  !firstPacket.action         = '!!cblmtrl.derivePickedPoint(!this.return[1]) !!cblmtrl.pickedElements.append(!!cblmtrl.pickedPoint)'
  !firstPacket.pickPacket.picks[1].pick.modifiable = FALSE
  !firstPacket.priority       = 2
  !firstPacket.remove         = TRUE
  !firstPacket.escape         = ''

  !secondPacket               = object EDGPACKET()
  !secondPacket.description    = 'Pick Segment or Point'
  !secondPacket.pickPacket.stdgraphic('Pick near the second point to be dressed')
  !secondPacket.action        = '!!cblmtrl.derivePickedPoint(!this.return[1]) !!cblmtrl.pickedElements.append(!!cblmtrl.pickedPoint)'
  --!secondPacket.pickPacket.picks[1].pick.input[3] = !element
  !secondPacket.pickPacket.picks[1].pick.modifiable = FALSE
  !secondPacket.priority      = 3
  !secondPacket.remove        = TRUE
  !secondPacket.continue      = '!!cblmtrl.dressMultipleSegments()'

  !!edgCntrl.add(!secondPacket)
  !!edgCntrl.add(!firstPacket)


endmethod
------------------------------------------------------------------------
--
-- Method: pickElement
--
-- Description: pick elements for removing dressing
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickElement(!element is STRING)

  !!edgCntrl.remove('Pick Segment or Point')
  !!edgCntrl.remove('Pick Segment or Point')

 -- define pick elements
 !type = 'TYPE inset (|CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|, |CTRAY|, |SCTN|, |GENSEC|, |CWBRAN|)'

 !removeType = !element.lowcase()
 !prompt     = 'Pick $!removeType to remove dressing'
 if !element.eq('STRAIGHT') then
  !prompt = 'Pick on the segment to remove straights'
 endif

 -- define packet
  !packet                = object EDGPACKET()
  !packet.description    = 'Pick Segment or Point'
  !packet.initialisation = '!!cblmtrl.pickedElements  = object ARRAY()'
  !packet.pickPacket.stdgraphic('$!prompt')
  !packet.action         = '!!cblmtrl.deriveRemovePoint(!this.return[1])'
  !packet.pickPacket.picks[1].pick.input[3] = !type
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  --!packet.priority       = 2
  !packet.remove         = TRUE
  !packet.escape         = ''
  !packet.continue      = '!!cblmtrl.removeDress(|$!element|)'

  !!edgCntrl.add(!packet)



endmethod
------------------------------------------------------------------------
--
-- Method: deriveRemovePoint
--
-- Description: derive the reference point of segment
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deriveRemovePoint(!pickData is EDGPICKDATA)

   !element     = !pickData.item
   !unusedTypeCheck = !element.type
   handle (2,202)
    return
   endhandle

   -- add to member the picked element
   !this.pickedElements.append(!element)

   if !element.type.eq('CWBRAN') then
    !facets    = !pickData.facets
    !pointVector = !pickData.pickLine
    !lpos      = !pickData.lines


    if !facets.unset() then
    -- no facets. so pick the line
     !pickLine = object LINE(!lpos[1],!lpos[2])
     !line = !pointVector.line(100)
     !intersect = !pickLine.intersection(!line)
    else
     -- create profile from facets
     !profPos = !facets[1]
     -- get orientation from first two positions of the facets
     !facetLine = object LINE(!facets[1], !facets[2])
     !ydir = !facetLine.direction()
     !profOri = object ORIENTATION('Y is $!ydir')
     !prof    = object PROFILE(!profPos, !profOri, !facets)
     --close the profile
     !prof.close()

     --make a plane from the profile
     !profPlane = !prof.plane()

     -- create line from point vector
     !line = !pointVector.line(100)

     -- if line is perpendicular to profile, manipulate to intersect at some other point
     if !prof.orientation.zdir().opposite().eq(!line.direction()) or !prof.orientation.zdir().eq(!line.direction()) then
      !intersect = !prof.near(!line.startposition)
     else
     -- project line on to profile and get position
     !intersects = !prof.intersections(!line)
     !intersect  = !intersects[1]
     endif
    endif

    --construct lines along Route
    !col = object COLLECTION()
    !col.scope(!element)
    !col.type('POINTR')

    !points = !col.results()


     !routeLines = object ARRAY()
    do !i from 1 to (!points.size() - 1)
     !rline = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
     !routeLines.append(!rline)
    enddo

    -- find the nearest line to profile intersection
    !distArray = object ARRAY()
    do !j from 1 to !routeLines.size()
     !dist = !routeLines[!j].distance(!intersect)
     !distArray.append(!dist)
    enddo
     -- sort the distances to get the index of the point
     !sortDist = !distArray.sortedindices()
     -- check if there are more points than 1
     !unusedSortDistance = !sortDist[2]
     handle ANY
       !inx = 1
       !pointr = !points[!sortDist[1]]
     elsehandle NONE
     -- if the points are in same line, then find the nearest point to intersection
      !inx = 1
      !nearestPoint  =  !points[!sortDist[1]]
      !lineFirst  = object LINE(!intersect, !points[!sortDist[1]].position.wrt(worl))
      do !x from 2 to (!sortDist.size())
        if !distArray[!sortDist[1]].eq(!distArray[!sortDist[!x]]) then
         !lineSecond = object LINE(!intersect, !points[!sortDist[!x]].position.wrt(worl))
         if !lineFirst.length().gt(!lineSecond.length()) then
           !nearestPoint = !points[!sortDist[!x]]
           !lineFirst    = !lineSecond
           !inx = !x
         endif
        endif
       enddo
        !pointr  = !nearestPoint
     endhandle

    -- set the POINTR to form member after reinitialising the member
    !this.pickedPoint         = object DBREF()
    !this.pickedPoint         = !pointr
   endif

endmethod


define method .findPick( !pickedElement is DBREF) is DBREF

 if !pickedElement.type.eq('CTRAY') then
  return !pickedElement.owner
 elseif !pickedElement.type.eq('HATTA') then
  !temp = first RPATH of $!pickedElement.owner
  !temp = first POINTR of $!temp
  return !temp

 elseif !pickedElement.type.eq('TATTA') then
   !temp = first RPATH of $!pickedElement.owner
   !temp = last POINTR of $!temp
   return !temp
 endif

 return !pickedElement

endmethod
------------------------------------------------------------------------
--
-- Method: dressBetweenComponents
--
-- Description: sets the member and calls the method to dress between components
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressBetweenComponents()


 -- Checking whether Picked element is Set
 if(!this.pickedElements.size().lt(2))then
   !!edgCntrl.remove('Pick Segment or Point')
   return
 endif
  -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

 -- change pick to owner if required
  !firstPick = !this.findPick(!this.pickedElements[1].item)

  !secondPick  = !this.findPick(!this.pickedElements[2].item)

 -- see if the picked elements are in current Branch
 if !firstPick.owner.owner.neq(!this.cableway.cwbran) then
  !!alert.error('First picked element is not from current branch')
  return
 endif

 if !secondPick.owner.owner.neq(!this.cableway.cwbran) then
  !!alert.error('Second picked element is not from current branch')
  return
 endif

 -- array to put elements in correct sequence
 !elementArray = object ARRAY()
 !elementArray.append(!firstPick)
 !elementArray.append(!secondPick)

 -- put in correct sequence
 if !firstPick.distfh[1].gt(!secondPick.distfh[1]) then
   !sequenceArray = !elementArray.invert()
 else
   !sequenceArray = !elementArray
 endif

 if  !this.cableway.isOnTheSameSegment(!sequenceArray[1], !sequenceArray[2]) eq false then
   !!alert.error('The picks are not on the same segment')
   return
 endif


 --Fill
 --units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

!this.cableway.dressBetweenComponents(!sequenceArray)

 --reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
------------------------------------------------------------------------
--
-- Method: dressMultipleSegments
--
-- Description: dress multiple segments in straight line
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressMultipleSegments()

  -- Checking whether Picked element is Set
 if(!this.pickedElements.size().lt(2))then
   return
 endif

 -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

 -- see if pick is same point
 if !this.pickedElements[1].eq(!this.pickedElements[2]) then
  !!alert.error('The picks are on the same segment')
  return
 endif

 !firstPick = !this.pickedElements[1]
 !secondPick = next of $!this.pickedElements[2]

 -- see if the picked elements are in current Branch
 if !firstPick.owner.owner.neq(!this.cableway.cwbran) then
  !!alert.error('First picked element is not from current branch')
  return
 endif

 if !secondPick.owner.owner.neq(!this.cableway.cwbran) then
  !!alert.error('Second picked element is not from current branch')
  return
 endif

 !elementArray = object ARRAY()
 !elementArray.append(!firstPick)
 !elementArray.append(!secondPick)

 -- put in correct sequence
 if !firstPick.sequence.gt(!secondPick.sequence) then
  !sequenceArray = !elementArray.invert()
 else
  !sequenceArray = !elementArray
 endif

-- see if points are in straight line
if !sequenceArray[1].pdir[2].neq(!sequenceArray[2].pdir[1]) then
  !!alert.error('Picked segments are not in straight line')
  return
endif


 --Fill
 --units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 !this.cableway.dressMultipleSegments(!firstPick, !secondPick, !this.straLength.val)

 --reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
------------------------------------------------------------------------
--
-- Method: dressWithStraights
--
-- Description: sets the member and calls the method to dress between components
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fillWithStraights()

  !this.cableway.cwtm.fillBranchWithStraights(!this.cableway.cwbran, !this.straLength.val)

endmethod
------------------------------------------------------------------------
--
-- Method: dressWithStraights
--
-- Description: sets the member and calls the method to dress between components
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressWithStraights()

  -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

  if (not(!this.cableway.checkExistingComponents (!this.cableway.cwbran, 'CTSTRA' )))then
    !!alert.message('Dressing abandoned.')
    return
  endif

  --units
  !savedUnits = object COMUNITS(true)
  UNITS MM DIST
  UNITS MM BORE

  !this.cableway.dressbranchwithstraights(!this.cableway.cwbran, !this.straLength.val)


  if !this.straightcut.val then
    !col = object COLLECTION()
    !col.scope(!this.cableway.ctmtrl)
    !col.type('CTSTRA')

    do !stra values !col.results()
     if !stra.olength.neq(!this.straLength.val) then
       !overallLength  = !stra.olength
       !stra.olength = !this.straLength.val
       -- In backward mode change the ZDIS of the last CTSTRA on the segment
       if !this.cableway.cwtm.getdressingdirection().not() then
        !zdis = !stra.zdis
        !stra.zdis = !zdis - (!stra.olength - !overallLength)
       endif
     endif
     if !this.template then
       !!ce = !stra
       RULE REXECUTE
     endif
    enddo

  endif

  --reset units
  !savedUnits.restoreSavedUnitsByPtype('DIST')
  !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
------------------------------------------------------------------------
--
-- Method: createBendAndRiser
--
-- Description: creates bends and risers
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createBendAndRiser(!branch is DBREF)

 -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif
  if (not(!this.cableway.checkExistingComponents (!branch, 'CTBEND') AND !this.cableway.checkExistingComponents (!branch, 'CTRISER')))then
    !!alert.message('Dressing abandoned.')
    return
 endif

!this.cableway.createBendAndRiser(!branch)
handle ANY
  !!alert.error('Material is deleted. Can not do dressing.')
endhandle

endmethod
------------------------------------------------------------------------
--
-- Method: createTeeAndCross
--
-- Description: creates tee and cross
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createTeeAndCross(!branch is DBREF)

 -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif
 if (not(!this.cableway.checkExistingComponents (!branch, 'CTTEE' ) AND !this.cableway.checkExistingComponents (!branch, 'CTCROSS')))then
   !!alert.message('Dressing abandoned.')
   return
 endif

 !this.cableway.createTeeAndCross(!branch)
 handle ANY
 --  !!alert.error('Material is deleted. Can not do dressing.')
 endhandle

endmethod
------------------------------------------------------------------------
--
-- Method: pick
--
-- Description: pick the points and positions from branch
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick(!element is STRING)

 if !element.eq('CTTEE') or !element.eq('CTCROS') then
  !this.pickRatta(!element)
 else
  !this.pickPoint(!element)
 endif



endmethod
---------------------------------------------------------------------------
--
-- Method:      pickPoint
--
-- Description: EDG to pick route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPoint(!item is STRING)

    !!edgCntrl.remove('Pick Segment or Point')
    !!edgCntrl.remove('Pick Segment or Point')

    --reinitialise members
    !this.pickedPoint    = object DBREF()
    !this.pickedType     = object STRING()
    !this.wrongpick = FALSE
    !this.location  = !item
    !packet = object EDGPACKET()
    !packet.description    = 'Pick Segment or Point'
    --!packet.priority = 2
    if !item.eq('POINT') then
      !packet.pickPacket.stdgraphic('Pick near the route point (POINTR) to be dressed')
    else
      !packet.pickPacket.stdgraphic('Pick on the segment which $!item should be placed')
    endif
    !packet.action = '!!cblmtrl.derivePickedPoint(!this.return[1])'
    !packet.remove = TRUE
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.pickPacket.picks[1].numberofpicks = 1
    if !item.eq('POINT') then
      !packet.continue = '!!cblmtrl.dressPoint()'
    else
      !packet.continue = '!!cblmtrl.edgPopulate(|$!item|)'
    endif

    !!edgCntrl.add(!packet)
endmethod
---------------------------------------------------------------------------
--
-- Method:      pickSegment
--
-- Description: EDG to pick segment route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickSegment(!type is STRING)

    !!edgCntrl.remove('Pick Segment or Point')

    --reinitialise members
    !this.pickedPoint    = object DBREF()

    !this.wrongpick = FALSE
    !packet = object EDGPACKET()
    !packet.description    = 'Pick Segment or Point'
    --!packet.priority = 2
    !packet.pickPacket.stdgraphic('Pick near the start of the segment to be dressed')
    !packet.action = '!!cblmtrl.derivePickedPoint(!this.return[1])'
    !packet.remove = TRUE
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.pickPacket.picks[1].numberofpicks = 1
    !packet.continue = '!!cblmtrl.dressSegment(|$!type|)'
    !!edgCntrl.add(!packet)

endmethod
---------------------------------------------------------------------------
--
-- Method:      dressPoint
--
-- Description: Find the nearest point of pick
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressPoint()

  -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

 if !this.pickedPoint.unset() then
  return
 endif

 -- see if the pick is correct
 if !this.pickedPoint.owner.owner.neq(!this.cableway.cwbran) then
  !!alert.error('Picked point is not on the same branch')
  return
 endif

 -- see if RATTA or RNODE is picked
 if !this.pickedType.eq('RATTA') or !this.pickedType.eq('RNODE') then
   !!alert.error('Cannot dress a $!this.pickedType')
   return
 endif


 --get the nearest point
 !ce = !!ce
 !!ce = !this.pickedPoint
 !firstPos = !!ce.position
 next
 !nextPosition = !!ce.position
 if !this.pickedPos.distance(!firstPos).geq(!this.pickedPos.distance(!nextPosition)) then
   !this.pickedPoint = !!ce
 endif
 !!ce = !ce

 -- see if it is first or last point
 if !this.pickedPoint.tysequence.eq(1) then
  !!alert.error('Cannot dress the first point in a branch with bend or riser')
  return
 endif

 if !this.pickedPoint.tysequence.eq(!this.pickedPoint.owner.members.size())  then
   !!alert.error('Cannot dress the last point in a branch with bend or riser')
   return
 endif

 --units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 !this.cableway.dressPoint(!this.pickedPoint)

 --reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
---------------------------------------------------------------------------
--
-- Method:      dressRatta
--
-- Description: dress the RATTA
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressRatta()

  -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

 if !this.pickedratta.unset() then
  return
 endif

 --units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 !this.cableway.dressRatta(!this.pickedratta)

 --reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
--End of method definition
---------------------------------------------------------------------------
--
-- Method:      fillBranch
--
-- Description: fills the branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fillBranch()

 -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

 --units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 if !this.userLength.val then
   !this.cableway.fill(!this.cableway.cwbran, !this.straLength.val)
 else
   !this.cableway.fill(!this.cableway.cwbran)
 endif

 -- reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
---------------------------------------------------------------------------
--
-- Method:      dressSegment
--
-- Description: method to call the segment dress function
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressSegment(!type is STRING)

  -- check loading is correct
 !check      = !this.checkLoadedSpec()
 !loading    = !check[1]
 !loadedType = !check[2]

 if !loading.not() then
  !!alert.error('Please load dimensions from $!loadedType ')
  return
 endif

 if !this.pickedPoint.unset() then
  return
 endif
 -- see if the pick is correct
 if !this.pickedPoint.owner.owner.neq(!this.cableway.cwbran) then
  !!alert.error('Picked point is not on the same branch')
  return
 endif

 -- see if there are material elements referring to the point
 !depref = !this.pickedPoint.depref
 do !reference values !depref
   if !this.material.findfirst(!reference.type).set() then
    !confirm = !!alert.confirm('The segment has got dressing. Remove them and continue?')
    if !confirm.eq('YES') then
      !remove  = TRUE
      break
    else
      return
    endif
   endif
 enddo


 -- delete the elements

 if defined(!remove) then
 	!material = !depref
  -- store current element
  !dbElement = !!ce

  -- remove material
  do !mat values !material
    if !this.material.findfirst(!mat.type).set() then
      !!ce = !mat
      !elementType = !!ce.type
      DELETE $!elementType
    endif
  enddo

  !!ce = !dbElement
  handle ANY
  endhandle
 endif


 -- units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 if !type.eq('SEGMENT') then
  !this.cableway.dressSegment(!this.pickedPoint, !this.straLength.val)
  -- change the lengths if it cannot be cut
  if !this.straightsegcut.val then
    -- collect segments referring to the picked point
    do !mat values !this.pickedPoint.depref
      if !mat.type.eq('CTSTRA') then
        if !mat.olength.neq(!this.straLength.val) then
          !overallLength = !mat.olength
          !mat.olength = !this.straLength.val
          -- In backward mode change the ZDIS of the last CTSTRA on the segment
          if !this.cableway.cwtm.getdressingdirection().not() then
            !zdis = !mat.zdis
            !mat.zdis = !zdis - (!mat.olength - !overallLength)
          endif
          -- execute rules
          if !this.template then
           !!ce = !mat
           RULE REXECUTE
          endif
        endif
      endif
    enddo
  endif

 else
  if !this.userLength.val then
   !this.cableway.dressSegmentAll(!this.pickedPoint, !this.straLength.val)
  else
   !this.cableway.dressSegmentAll(!this.pickedPoint)
  endif
 endif

 --reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
---------------------------------------------------------------------------
--
-- Method:      pickRatta
--
-- Description: EDG to pick route attachment point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickRatta(!item is STRING)

    !!edgCntrl.remove('Pick Segment or Point')
    !!edgCntrl.remove('Pick Segment or Point')

    --reinitialise members
    !this.pickedratta    = object DBREF()

    !this.wrongpick = FALSE
    !this.location  = !item

    !packet = object EDGPACKET()
    !packet.description    = 'Pick Segment or Point'
    if !item.upcase().neq('RATTA') then
     !packet.pickPacket.stdElement('Pick RATTA to place $!item')
    else
     !packet.pickPacket.stdElement('Pick RATTA to dress')
    endif
    --!packet.priority = 2
    !packet.action = '!!cblmtrl.pickedratta = !this.return[1].item'
    !element = 'TYPE eq (|RATTA|)'
    !packet.remove = TRUE
    !packet.pickPacket.picks[1].pick.input[3] = !element
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.pickPacket.picks[1].numberofpicks = 1
    if !item.upcase().neq('RATTA') then
     !packet.continue = '!!cblmtrl.edgPopulate(|$!item|)'
     !this.track  = FALSE
    else
     !packet.continue = '!!cblmtrl.dressRatta()'
    endif
    !!edgCntrl.add(!packet)

endmethod
---------------------------------------------------------------------------
--
-- Method:      derivePickedPoint
--
-- Description: derives the picked POINTR from edg pick
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .derivePickedPoint(!pickData is EDGPICKDATA)

   -- mode
   var !mode mode

   !centreLineFlag = FALSE
   !element   = !pickData.item
   !unusedCheck = !element.type
   handle (2,202)
     !this.wrongpick  = TRUE
     return
   endhandle
   -- see if it is a RATTA or RNODE or other cableway elements
   if !element.type.neq('CWBRAN') then
      if !element.type.eq('RATTA') or !element.type.eq('RNODE') then
        !this.pickedPoint         = !element.posref
        !this.cableway.pointr     = !element.posref
        !this.pickedPos           = !element.position
        !this.pickedType          = !element.type
        return
      elseif !element.type.eq('CTSTRA') or !element.type.eq('CTREDU') then
        !olen = !element.olength
        !this.pickedPoint         = !element.posref
        !this.cableway.pointr     = !element.posref
        !startPos                 = !element.position
        !startDir                 = !element.posref.pdir[2]
        -- add gap values if the create or modify element is CTSTRA or CTREDU
        if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
          -- we should use the intermediate gap
          if !!cbldflts.useGaps.val then
            !this.ctelementposFromPrev.val = !!cbldflts.intermediateGap.val
            !this.gapValue  = !this.ctelementposFromPrev.val
          else
            !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.igap
            !this.gapValue  = !this.ctelementposFromPrev.val
          endif
          if !mode.upcase().eq('BACKWARDS') then
            !olen = !olen - !this.ctelementposFromPrev.val
          else
            !olen = !olen + !this.ctelementposFromPrev.val
          endif
          !this.updateGap  = FALSE
        endif
        -- backward mode
        if !mode.upcase().eq('BACKWARDS') then
          !len = !element.olength
          !olen = !olen - !len
        endif

        --offset and get the end position
        !this.pickedPos           = !startPos.offset(!startDir,!olen)
        return
      elseif !element.owner.type.eq('CTSTRA') or !element.owner.type.eq('CTREDU')then
        !dbElement   = !!ce
        !!ce  = !element
        !p1pos = p1pos
        !p2pos = p2pos
        !line = object LINE(!p1pos,!p2pos)
        !olen = !line.length()
        !!ce = !dbElement
        !this.pickedPoint         = !element.owner.posref
        !this.cableway.pointr     = !element.owner.posref
        !startPos                 = !element.owner.position
        !startDir                 = !element.owner.posref.pdir[2]
        -- add gap values if the create or modify element is CTSTRA or CTREDU
        if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
          -- we should use the intermediate gap
          if !!cbldflts.useGaps.val then
            !this.ctelementposFromPrev.val = !!cbldflts.intermediateGap.val
            !this.gapValue  = !this.ctelementposFromPrev.val
          else
            !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.igap
            !this.gapValue  = !this.ctelementposFromPrev.val
          endif
          if !mode.upcase().eq('BACKWARDS') then
            !olen = !olen - !this.ctelementposFromPrev.val
          else
            !olen = !olen + !this.ctelementposFromPrev.val
          endif
          !this.updateGap  = FALSE
        endif

        -- backward mode
        if !mode.upcase().eq('BACKWARDS') then
          !len = !element.owner.olength
          !olen = !olen - !len
        endif
        --offset and get the end position
        !this.pickedPos           = !startPos.offset(!startDir,!olen)
        return
      elseif !element.type.eq('CTBEND') or !element.type.eq('CTRISE') or !element.type.eq('CTTEE') or !element.type.eq('CTCROS') then
        if !mode.upcase().eq('BACKWARDS') then
          !llen                     = !element.alength
          !point                    = !element.posref
          !prevPoint                = next POINTR of $!point
          !this.pickedPoint         = !prevPoint
          !this.cableway.pointr     = !prevPoint
          !startPos                 = !element.position
          !startDir                 = !prevPoint.pdir[2].opposite()
        else
          !llen = !element.llength
          !this.pickedPoint         = !element.posref
          !this.cableway.pointr     = !element.posref
          !startPos                 = !element.position
          !startDir                 = !element.posref.pdir[2]
        endif

        if !mode.upcase().eq('BACKWARDS') then
          -- add gap values if the create or modify element is CTSTRA or CTREDU
          if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
            -- we should use the first gap
            if !!cbldflts.useGaps.val then
              !this.ctelementposFromPrev.val = !!cbldflts.lastGap.val
              !this.gapValue  = !this.ctelementposFromPrev.val
            else
              !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.lgap
              !this.gapValue  = !this.ctelementposFromPrev.val
            endif
            !llen = !llen + !this.ctelementposFromPrev.val
            !this.updateGap  = FALSE
          endif
        else
          -- add gap values if the create or modify element is CTSTRA or CTREDU
          if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
            -- we should use the first gap
            if !!cbldflts.useGaps.val then
              !this.ctelementposFromPrev.val = !!cbldflts.firstGap.val
              !this.gapValue  = !this.ctelementposFromPrev.val
            else
              !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.fgap
              !this.gapValue  = !this.ctelementposFromPrev.val
            endif
            !llen = !llen + !this.ctelementposFromPrev.val
            !this.updateGap  = FALSE
          endif
        endif
        --offset and get the end position
        !this.pickedPos           = !startPos.offset(!startDir,!llen)
        return
      elseif !element.owner.type.eq('CTBEND') or !element.owner.type.eq('CTRISE') or !element.owner.type.eq('CTTEE') or !element.owner.type.eq('CTCROS') then
        !dbElement   = !!ce
        !!ce  = !element
        !p0pos = p0pos
        if !mode.upcase().eq('BACKWARDS') then
         !p2pos = p1pos
        else
         !p2pos = p2pos
        endif
        !line = object LINE(!p0pos,!p2pos)
        !llen = !line.length()
        !!ce = !dbElement

        if !mode.upcase().eq('BACKWARDS') then
         !point                    = !element.owner.posref
         !prevPoint                = next POINTR of $!point
         !this.pickedPoint         = !prevPoint
         !this.cableway.pointr     = !prevPoint
         !startPos                 = !element.owner.position
         !startDir                 = !prevPoint.pdir[2].opposite()
        else
         !this.pickedPoint         = !element.owner.posref
         !this.cableway.pointr     = !element.owner.posref
         !startPos                 = !element.owner.position
         !startDir                 = !element.owner.posref.pdir[2]
        endif

        if !mode.upcase().eq('BACKWARDS') then
          -- add gap values if the create or modify element is CTSTRA or CTREDU
          if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
            -- we should use the first gap
            if !!cbldflts.useGaps.val then
              !this.ctelementposFromPrev.val = !!cbldflts.lastGap.val
              !this.gapValue  = !this.ctelementposFromPrev.val
            else
              !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.lgap
              !this.gapValue  = !this.ctelementposFromPrev.val
            endif
            !llen = !llen + !this.ctelementposFromPrev.val
            !this.updateGap  = FALSE
          endif
        else
          -- add gap values if the create or modify element is CTSTRA or CTREDU
          if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
            -- we should use the first gap
            if !!cbldflts.useGaps.val then
              !this.ctelementposFromPrev.val = !!cbldflts.firstGap.val
              !this.gapValue  = !this.ctelementposFromPrev.val
            else
              !this.ctelementposFromPrev.val = !this.cableway.ctmtrl.fgap
              !this.gapValue  = !this.ctelementposFromPrev.val
            endif
            !llen = !llen + !this.ctelementposFromPrev.val
            !this.updateGap  = FALSE
          endif
        endif
        --offset and get the end position
        !this.pickedPos           = !startPos.offset(!startDir,!llen)
        return
      else
        !this.wrongpick  = TRUE
        return
      endif

   endif
   !facets    = !pickData.facets
   !pointVector = !pickData.pickLine
   !lpos      = !pickData.lines

   if !facets.unset() then
    -- no facets. so pick the line
    !pickLine = object LINE(!lpos[1],!lpos[2])
    !line = !pointVector.line(100)
    !intersect = !pickLine.intersection(!line)
    !centreLineFlag = TRUE
   else
     -- create profile from facets
     !profPos = !facets[1]
     -- get orientation from first two positions of the facets
     !facetLine = object LINE(!facets[1], !facets[2])
     !ydir = !facetLine.direction()
     !profOri = object ORIENTATION('Y is $!ydir')
     !prof    = object PROFILE(!profPos, !profOri, !facets)
     --close the profile
     !prof.close()

     --make a plane from the profile
     !profPlane = !prof.plane()

     -- create line from point vector
     !line = !pointVector.line(100)

     -- if line is perpendicular to profile, manipulate to intersect at some other point
     if !prof.orientation.zdir().opposite().eq(!line.direction()) or !prof.orientation.zdir().eq(!line.direction()) then
      !intersect = !prof.near(!line.startposition)
      !centreLineFlag = TRUE
     else
     -- project line on to profile and get position
     !intersects = !prof.intersections(!line)
     if(!intersects.unset())then
       !!alert.error('Pick is Not Correct.')
       return
     endif
     !intersect  = !intersects[1]
     endif
    endif

   --construct lines along Route
   !col = object COLLECTION()
   !col.scope(!element)
   !col.type('POINTR')

   !points = !col.results()

    !routeLines = object ARRAY()
   do !i from 1 to (!points.size() - 1)
    !rline = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
    !routeLines.append(!rline)
   enddo

   -- find the nearest line to profile intersection
   !distArray = object ARRAY()
   do !j from 1 to !routeLines.size()
    !dist = !routeLines[!j].distance(!intersect)
    !distArray.append(!dist)
   enddo
    -- sort the distances to get the index of the point
    !sortDist = !distArray.sortedindices()
    -- check if there are more points than 1
    !unusedSortDist = !sortDist[2]
    handle ANY
      !inx = 1
      !pointr = !points[!sortDist[1]]
    elsehandle NONE
    -- if the points are in same line, then find the nearest point to intersection
     !inx = 1
     !nearestPoint  =  !points[!sortDist[1]]
     !lineFirst  = object LINE(!intersect, !points[!sortDist[1]].position.wrt(worl))
     do !x from 2 to (!sortDist.size())
       if !distArray[!sortDist[1]].eq(!distArray[!sortDist[!x]]) then
        !lineSecond = object LINE(!intersect, !points[!sortDist[!x]].position.wrt(worl))
        if !lineFirst.length().gt(!lineSecond.length()) then
          !nearestPoint = !points[!sortDist[!x]]
          !lineFirst    = !lineSecond
          !inx = !x
        endif
       endif
      enddo
       !pointr  = !nearestPoint
    endhandle

   -- set the POINTR to form member after re initialising the member
   !this.pickedPoint         = object DBREF()
   !this.pickedPoint         = !pointr
   !this.cableway.pointr     = !pointr

   -- get more accurate point during pick by intersecting with a plane along the centre line
   if !centreLineFlag.not() then

    -- move the profile plane to centre line
    !profPlane.position = !routeLines[!sortDist[!inx]].startposition

    --project view line to plane
    !projectedLine = !line.projected(!profPlane)

    --get the intersection
    !intersect = !routeLines[!sortDist[!inx]].intersection(!projectedLine)
    handle ANY
      -- lines are parallel
      !intersect = !profPlane.intersection(!line)
    endhandle

   endif

   -- get the position on the segment
   !this.pickedPos  = !routeLines[!sortDist[1]].near(!intersect)

endmethod
---------------------------------------------------------------------------
--
-- Method:      edgPopulate
--
-- Description: EDG to pick route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgPopulate(!item is STRING)

   if !this.wrongpick then
     !!alert.error('Pick not correct. Please try again')
     !this.wrongpick = FALSE
     return
   endif

   -- see if the picked point is on the same branch
   if !item.upcase().eq('CTTEE') or !item.upcase().eq('CTCROS') then
     if !this.pickedratta.unset() then
       return
     else
       !this.pickedPoint  = !this.pickedratta.posref
      endif
   endif

   if !this.pickedPoint.unset() then
     return
   endif

   var !mode mode
   if !mode.upcase().eq('BACKWARDS') then
     if !this.elementTable.selection().neq('CTBEND') then
       if !this.elementTable.selection().neq('CTRISE') then
         !this.pickedPoint  = prev of $!this.pickedPoint
       endif
     endif
   endif

   if !this.pickedPoint.owner.owner.neq(!this.cableway.cwbran) then
     !!alert.error('Picked element is not on the current branch')
     return
   else

     var !mode mode
     if !mode.upcase().eq('FORWARDS') then
       !this.ctsphere.description = '<Origin>'
     else
       if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
         !this.ctsphere.description = '<Leave>'
       else
         !this.ctsphere.description = '<Origin>'
       endif
     endif

     if !item.upcase().eq('CTBEND') or !item.upcase().eq('CTRISE') then

       !firstPos = position of $!this.pickedPoint
       !nextPosition = position of next of $!this.pickedPoint
       if !this.pickedPos.distance(!firstPos).geq(!this.pickedPos.distance(!nextPosition)) then
         !this.pickedPoint = !!ce
       endif

       !this.ctsphere.position = !this.pickedPoint.position
       !this.ctsphere.draw(!this.ctAidNumber)

       -- see if left handed or right handed
       !angle = !this.getAngle(!this.pickedPoint)
       if !angle.leq(91) then
         !this.ctelementType.val  = 2
         !this.ctelementAngle.val = !angle
       else
         !this.ctelementType.val  = 1
         !this.ctelementAngle.val = (!angle - 180)
       endif

     elseif !item.upcase().eq('CTTEE') or !item.upcase().eq('CTCROS') then

       !this.ctelementZdis.val  = !this.pickedratta.zdistance
       !this.ctelementPkdis.val = !this.pickedratta.pkdistance
       !this.ctsphere.position  = !this.pickedratta.position
       !this.ctsphere.draw(!this.ctAidNumber)

       -- get right or left hand tee
       if !this.getTeeSide(!this.pickedratta).eq('LEFT') then
         !this.ctelementType.val = 1
       elseif !this.getTeeSide(!this.pickedratta).eq('RIGHT') then
         !this.ctelementType.val = 2
       endif
     else
       !pos    = !this.pickedPos
       !pointr = !this.cableway.pointr
       !fRadius = !pointr.pos.distance(!pointr.fend)
       !this.ctelementZdis.val = !this.getLength(!this.pickedPoint.pos.wrt(worl), !pos) - !fRadius
       !this.ctsphere.position = !pos
       !this.ctsphere.draw(!this.ctAidNumber)
     endif

     !this.cableway.pointr  = !this.pickedPoint
     -- find the point number
     !col = object COLLECTION()
     !col.scope(!this.pickedPoint.owner)
     !col.type('POINTR')
     var !mode mode
     if !mode.upcase().eq('BACKWARDS') then
       !results = !col.results().invert()
     else
       !results = !col.results()
     endif
     !number = !results.findfirst(!this.pickedPoint)
     !this.ctelementPosn.val =  !number

     if !this.task.upcase().eq('CREATE') then
       -- find the previous item
       !this.findPrevious()
     endif

     if !mode.upcase().eq('BACKWARDS') then
       !this.gapValue = 0
     endif

     --update gap gadget
     if !this.updateGap then
       if !this.previous.type.neq('CTMTRL') then
         if !this.previous.posref.neq(!this.cableway.pointr) then
           !this.ctelementposFromPrev.val = !this.ctelementZdis.val
           !this.gapValue  = !this.ctelementposFromPrev.val
           return
         endif
       endif

       if !this.previous.type.eq('CTSTRA') or !this.previous.type.eq('CTREDU') then
         !length = !this.previous.distfp + !this.previous.olength
       elseif !this.previous.type.eq('CTBEND') or !this.previous.type.eq('CTRISE') then
         !length = !this.previous.distfp + !this.previous.llength
       elseif !this.previous.type.eq('CTTEE') or !this.previous.type.eq('CTCROS') then
         !length = !this.previous.distfp + !this.previous.llength
       else
         !length = 0
       endif
       !gap = !this.ctelementZdis.val - !length
       !this.ctelementposFromPrev.val = !gap
       !this.gapValue  = !this.ctelementposFromPrev.val
     endif

   endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getLength
--
-- Description: Calculates the length between two positions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getLength(!first is POSITION, !second is POSITION) is REAL

 !line = object LINE()
 !line.startposition = !first
 !line.endposition   = !second

 return !line.length()

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getWidth
--
-- Description: gets the width of tray
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getWidth(!element is DBREF) is REAL

 if !element.type.eq('CTREDU') then
  var !mode mode
  if !mode.upcase().eq('BACKWARDS') then
    !width = !element.trayw
  else
   !width = !element.trayrw
  endif
 else
  !width = !element.trayw
 endif

  return !width


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getHeight
--
-- Description: gets the height of tray
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
-----------------------------------------------------------------------
define method .getHeight(!element is DBREF) is REAL

    !height = !element.trayh

  return !height


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getTierHeight
--
-- Description: gets the tier heights of tray
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTierHeight(!element is DBREF) is ARRAY

    !tier = !element.tierheight

 --convert to string
 !newTier = object ARRAY()
 !newTierDText = object ARRAY()
 !newTierRText = object ARRAY()
  if !tier.set() then
   do !i from 1 to !tier.size()
     !newTierDText.append(!tier[!i].string(!!distanceFmt))
     !newTierRText.append(!tier[!i].string())
   enddo
  endif
  !newTier[1] = !newTierDText
  !newTier[2] = !newTierRText
  return !newTier


endmethod
--End of method definition
