-------------------------------------------------------------------------
--
-- Method: validateWidth
--
-- Description: Validates the tray width
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateWidth(!gadget is GADGET, !action is STRING)
!!gdgtDatChk(!gadget)
 if  !action.eq('SELECT') then
  if !gadget.val.gt(!this.cableway.cwbran.vwidt) then
   !!alert.warning('Entered tray width is greater than volume width of branch')
   return
  endif
 endif

endmethod
------------------------------------------------------------------------
--
-- Method: validateHeight
--
-- Description: Validates the tray height
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateHeight()
if (!this.ctmtrltrayheight.val lt 0) then
	!!alert.error('Enter a Positive Value')
	 !this.ctmtrltrayheight.clear()
	 !this.ctmtrltrayheight.setvalue(0,FALSE)
endif

 if !this.ctmtrltrayheight.val.gt(!this.cableway.cwbran.vheig) then
  !!alert.warning('Entered tray width is greater than volume height of branch')
  return
 endif

endmethod
------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: changes the task mode
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeMode(!task is STRING, !type is STRING)

 if !task.upcase().eq('MODIFY') then
   if !this.material.findfirst(!!ce.type).unset() then
    !!ce = !this.cableway.activeElement
   endif
   !this.setTask(!task,!!ce.type)
 else
   !!cblinit(!task.upcase(),'COMPONENTS','!!cblmtrl')
   !this.elementTable.val = 1
   -- update templates
   if !this.ctmtrlTempdata.dText.set() then
    !this.loadTypes()
    !this.updateView()
   endif
 endif

endmethod
------------------------------------------------------------------------
--
-- Method: align
--
-- Description: align with element
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .align()

   !packet = object EDGPACKET()
   !packet.action      = '!!cblmtrl.pickedPos = !this.return[1].position.wrt(worl)'
   !packet.defineposition('Pick to define position')
   !packet.priority    = 2
   !packet.remove      = TRUE
   !packet.continue = '!!cblmtrl.distance()'
   !!edgCntrl.add(!packet)


endmethod
------------------------------------------------------------------------
--
-- Method: alignWithGridlines
--
-- Description: align with Gridline
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .alignWithGridlines()

   !packet = object EDGPACKET()
   !packet.action      = '!!cblmtrl.distance(!this.return[1])'
   !packet.pickPacket.stdgraphic('Pick Grid to define position')
   !packet.priority    = 2
   !packet.remove      = TRUE
   --!packet.continue = '!!cblmtrl.distance()'
   !!edgCntrl.add(!packet)


endmethod
------------------------------------------------------------------------
--
-- Method: distance
--
-- Description: calculates the distance of RATTA position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .distance(!data is EDGPICKDATA)

  var !mode mode

  if(!this.cableway.pointr.unset())then
    return
  endif
  -- find the position of next POINTR
  !ce = !!ce
  !!ce  = !this.cableway.pointr
  !pointr1 = !!ce
  next POINTR
  handle ANY
    !!alert.error('The picked element is not within the current segment')
    return
  endhandle
  !pointr2 = !!ce
  !!ce = !ce

  -- create a line of the current segment
  !line  = object LINE()
  !line.startposition = !pointr1.position.wrt(worl)
  !line.endposition   = !pointr2.position.wrt(worl)

  -- deduct the possible fillet radius
  !bendDistance = !pointr1.pos.distance(!pointr1.fend)
  !endBendDistance = !pointr2.pos.distance(!pointr2.fend)
  !line = !line.extendStart( - !bendDistance)
  !line = !line.extendEnd( - !endBendDistance)

  if(!data.lines.size().lt(2))then
    !!alert.error('The picked element is not within the current segment')
    return
  endif
  !startPos    = !data.lines[1]
  !endPos      = !data.lines[2]

  !gridline  = object LINE(!startPos,!endPos)

  !newPosition  = !gridline.intersection(!line)
  handle ANY
    !!alert.error('Picked grid is parallel to the cableway segment')
    return
  endhandle
  !newPosition.up = !line.startposition.up

  !newline = object LINE()
  !newline.startposition  = !line.startposition
  !newline.endposition    = !newPosition

  -- see if the picked point is on the segment
  !firstCheckLine = object LINE()
  !firstCheckLine.startposition = !line.startposition
  !firstCheckLine.endposition  = !newline.endposition

  !secondCheckLine = object LINE()
  !secondCheckLine.startposition = !newline.endposition
  !secondCheckLine.endposition   = !line.endposition

  if(!firstCheckLine.length().eq(0) or !secondCheckLine.length().eq(0))then
    !this.ctelementZdis.val = !newline.length()
    !this.offsetDistance()
    return
  endif
  !firstDirection  = !line.direction()
  !secondDirection = !firstCheckLine.direction()
  !thirdDirection  = !secondCheckLine.direction()

  !inside = TRUE
  if !firstDirection.neq(!secondDirection) then
    !inside = FALSE
  endif
  if !firstDirection.neq(!thirdDirection) then
    !inside = FALSE
  endif
  if !secondDirection.neq(!thirdDirection) then
    !inside = FALSE
  endif


  if !inside.not() then
    !!alert.error('The picked element is not within the current segment')
    return
  endif

  !this.ctelementZdis.val = !newline.length()
  !this.offsetDistance()


endmethod
------------------------------------------------------------------------
--
-- Method: distance
--
-- Description: calculates the distance of RATTA position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .distance()

  -- find the position of next POINTR
  !ce = !!ce
  !!ce  = !this.cableway.pointr
  !pointr1 = !!ce
  next POINTR
  !pointr2 = !!ce
  !!ce = !ce

  -- create a line of the current segment
  !line  = object LINE()
  !line.startposition = !pointr1.position.wrt(worl)
  !line.endposition   = !pointr2.position.wrt(worl)

  -- deduct the possible fillet radius
  !bendDistance = !pointr1.pos.distance(!pointr1.fend)
  !endBendDistance = !pointr2.pos.distance(!pointr2.fend)
  if !this.elementTable.selection().eq('CTSTRA') then
 		!bendDistance = 0
 		!endBendDistance = 0
 	endif

  !line = !line.extendStart( - !bendDistance)
  !line = !line.extendEnd( - !endBendDistance)

  !newline = object LINE()
  !newline.startposition  = !line.startposition
  !newline.endposition    = !line.near(!this.pickedPos)

  -- see if the picked point is on the segment
  !firstCheckLine = object LINE()
  !firstCheckLine.startposition = !line.startposition
  !firstCheckLine.endposition  = !newline.endposition

  !secondCheckLine = object LINE()
  !secondCheckLine.startposition = !newline.endposition
  !secondCheckLine.endposition   = !line.endposition

  !firstDirection  = !line.direction()
  !secondDirection = !firstCheckLine.direction()
  !thirdDirection  = !secondCheckLine.direction()

  !inside = TRUE
  if !firstDirection.neq(!secondDirection) then
    !inside = FALSE
  endif
  if !firstDirection.neq(!thirdDirection) then
    !inside = FALSE
  endif
  if !secondDirection.neq(!thirdDirection) then
    !inside = FALSE
  endif

  if !inside.not() then
    !!alert.error('The picked element is not within the current segment')
    return
  endif

  !this.ctelementZdis.val = !newline.length()
  !this.offsetDistance()


endmethod
------------------------------------------------------------------------
--
-- Method: offsetDistance
--
-- Description: Distance from start of segment for offset
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
-----------------------------------------------------------------------
define method .offsetDistance()

  -- reference item
  !num                   = !this.ctelementPosn.val
  !this.cableway.pointr  = POINTR $!num of RPATH 1 of $!this.cableway.cwbran
  !refItem               = !this.cableway.pointr
  if !this.ctelementPkdis.val.gt(1) or !this.ctelementPkdis.val.lt(0) then
    !!alert.error('Please input a value between 0 and 1')
    return
  endif

  var !mode mode

  -- find the position of next POINTR
  !ce = !!ce
  !!ce  = !refItem
  next POINTR
  handle (2,113)
    pre POINTR
  endhandle
  !refItemNext = !!ce
  !!ce = !ce

  -- draw a line to get the direction
  !line = object LINE()
  !line.startposition = !refItem.pos.wrt(worl)
  !line.endposition   = !refItemNext.position.wrt(worl)

  -- deduct the possible fillet radius
  !bendDistance = !refItem.pos.distance(!refItem.fend)
  !endBendDistance = !refItemNext.pos.distance(!refItemNext.fend)
 	
 	if !this.elementTable.selection().eq('CTSTRA') then
 		!bendDistance = 0
 		!endBendDistance = 0
 	endif
 	
  !line = !line.extendStart( - !bendDistance)
  !line = !line.extendEnd( - !endBendDistance)

  !newPosition = object POSITION('E0 N0 U0')
  !pkdis  = !line.length() * !this.ctelementPkdis.val
  !offset = (!pkdis + !this.ctelementZdis.val)
  !newPosition = !line.startposition.offset(!line.direction(),!offset)
  if !offset.gt(!line.length()) then
   !!alert.error('Entered zdis is greater than segment length')
   return
  endif

  !this.ctsphere.position = !newPosition
  if !mode.upcase().eq('FORWARDS') then
    !this.ctsphere.description = '<Origin>'
  else
    if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
      !this.ctsphere.description = '<Leave>'
    else
     !this.ctsphere.description = '<Origin>'
    endif
  endif
  !this.ctsphere.draw(!this.ctAidNumber)

  -- update the gap gadget

  if !mode.upcase().eq('FORWARDS') then
   if !this.previous.set() and !this.previous.badref().not() then
    if !this.elementTable.selection().eq('CTSTRA') or !this.elementTable.selection().eq('CTREDU') then
      if !this.previous.type.eq('CTMTRL') then
       !this.ctelementposFromPrev.val = !this.ctelementZdis.val
       !this.gapValue  = !this.ctelementposFromPrev.val
      else
        if !this.cableway.pointr.neq(!this.previous.posref) then
          !this.ctelementposFromPrev.val = !this.ctelementZdis.val
          !this.gapValue  = !this.ctelementposFromPrev.val
        else
         --calculate gap
         !startPos = p2pos of $!this.previous
         !gapLine = object LINE(!startPos,!newPosition)
         !this.ctelementposFromPrev.val = !gapLine.length()
         !this.gapValue  = !this.ctelementposFromPrev.val
        endif
      endif
    endif
   endif
  endif

 endmethod
------------------------------------------------------------------------
--
-- Method: applyMaterial
--
-- Description: Creates CTRAY and assigns spref
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyMaterial(!element is DBREF)

  !applyMaterial  = object CBLAPPLYTRAYMATERIAL(!element)
  !applyMaterial.dressWholeBranch(!element)

 endmethod
------------------------------------------------------------------------
--
-- Method: chooseMaterial
--
-- Description: creates CTRAY and assigns spref
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseMaterial(!element is DBREF)

 --if current element is CTRAY navigate to owner
 if !element.type.eq('CTRAY') then
   !element = !element.owner
 endif
  !this.tray  = !element
 if !this.cableway.ctmtrl.ctspe.unset() then
  !answer = !!alert.question('Spec not set for main material element. Still continue?')
  if !answer.neq('YES') then
    return
  endif
 endif


  !!stChooseData.cleardata()
  !!stChooseData.setTitle('TRAY')
  !!stChooseData.setdata('CTRAY', !this.cableway.ctmtrl.ctspe)
  -- remove view from stack
  if defined(!!stChoose) then
    !!gphViews.remove(!!stChoose.vwView3d)
  endif

  -- load stChoose form
  show !!stChoose
  !tempString = !this.cableway.ctmtrl.ctspe.name & '/' &!element.type
  !tempString = !tempString.replace('/ST/', '/CT/')
  --Pre select the table
  !!stChoose.opSelTypes.select('dtext',!tempString)
  handle (61,567)
  endhandle
  !!stChoose.actions(!!stChoose.opSelTypes,'SELECT')

  !!stChoose.disableLocalEdit()
  !!stChoose.bnApply.callback = '!!cblmtrl.setSpec()'
endmethod
------------------------------------------------------------------------
--
-- Method: removeMaterial
--
-- Description: deletes CTRAY
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeMaterial(!element is DBREF)

 !dbElement  = !element
 !col = object COLLECTION()
 !col.types(!this.material)
 !col.scope(!element)

 do !mat values !col.results()
  !ctraycol = object COLLECTION()
  !ctraycol.type('CTRAY')
  !ctraycol.addtype('CTFEAT')
  !ctraycol.scope(!mat)
  --TODO call access check
  do !tray values !ctraycol.results()
    !!ce = !tray
    if ( !!dbRefUpdatable(!!ce)) then
     delete CTRAY
      handle ANY
       delete CTFEAT
       endhandle
     else
      !stringMessage  = !!error.text
      !!alert.error(!stringMessage )
     endif

  enddo
  !!ce = !mat
  --reset level
  level 0 10
 enddo
  !!ce = !dbElement
  handle ANY
  -- current element is deleted
  endhandle

endmethod
-----------------------------------------------------------------------
--
-- Method: removeDress
--
-- Description: deletes CTRAY
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeDress(!element is STRING)

 if !this.pickedElements.unset() then
  return
 endif

 !dbElement  = !!ce

 if !element.upcase().eq('ELEMENT') then
  !!ce = !this.pickedElements[1]
  if !!ce.type.eq('CTRAY') then
    owner
  endif

  if !!ce.type.eq('CWBRAN') then
    !!alert.message('Please pick on a cable tray element')
    return
  endif

  if !!ce.type.eq('GENSEC') or !!ce.type.eq('SCTN')then
    --see if it is under a CTMTRL
    if !!ce.ahlist.findfirst('CTMTRL').set() then
      !index = !!ce.ahlist.findfirst('CTMTRL') + 1
      !itemList = !!ce.ownlst
      -- navigate
      !!ce = !itemList[!index]
    else
      !!alert.error('Picked section does not belong to cable tray material')
      return
    endif
  endif

  !type = !!ce.type
  delete $!type


 elseif !element.upcase().eq('SEGMENT') then

  if !this.pickedElements[1].type.eq('GENSEC') or !this.pickedElements[1].type.eq('SCTN')then
    --see if it is under a CTMTRL
    if !this.pickedElements[1].ahlist.findfirst('CTMTRL').set() then
      !index = !this.pickedElements[1].ahlist.findfirst('CTMTRL') + 1
      !itemList = !this.pickedElements[1].ownlst
      -- navigate
      !this.pickedElements[1] = !itemList[!index]
    else
      !!alert.error('Picked section does not belong to cable tray material')
      return
    endif
  endif

  if !this.pickedElements[1].type.eq('CWBRAN') then
    !posref = !this.pickedPoint
  else
  !posref = !this.pickedElements[1].posref
  handle (2,201)
   !posref = !this.pickedElements[1].owner.posref
  endhandle
  endif

  !depref = !posref.depref
  do !mat values !depref
    -- see if the depref is a material element
    if !this.material.findfirst(!mat.type).set() then
      !!ce = !mat
      !type = !!ce.type
      delete $!type
    endif
  enddo
 elseif !element.upcase().eq('STRAIGHT') then
   if !this.pickedElements[1].type.eq('CWBRAN') then
    !posref = !this.pickedPoint
   else

   if !this.pickedElements[1].type.eq('CWBRAN') then
    !posref = !this.pickedPoint
   else
    !posref = !this.pickedElements[1].posref
    handle (2,201)
     !posref = !this.pickedElements[1].owner.posref
    endhandle
   endif
   endif
  !depref = !posref.depref
  do !mat values !depref
    -- see if the depref is a material element
    if !mat.type.eq('CTSTRA') then
      !!ce = !mat
      !type = !!ce.type
      delete $!type
    endif
  enddo
 endif
  !!ce = !dbElement

endmethod
------------------------------------------------------------------------
--
-- Method: loadAppDimensions
--
-- Description: Loads the application data world dimensions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadAppDimensions()

  -- reset load spec member
  !this.loadedSpec  = object DBREF()
  !this.loadedTmpl  = object DBREF()

  !index = !this.ctmtrlAppdata.val
  if !index.neq(0) then
   !appdata = !this.appdata[!index]
   !this.cableway.cwtm.readdefaultdimforctbend(!!cbltraydimensions(!appdata,'CTBEND'))
   !this.cableway.cwtm.readdefaultdimforctstra(!!cbltraydimensions(!appdata,'CTSTRA'))
   !this.cableway.cwtm.readdefaultdimforctredu(!!cbltraydimensions(!appdata,'CTREDU'))
   !this.cableway.cwtm.readdefaultdimforcttee(!!cbltraydimensions(!appdata,'CTTEE'))
   !this.cableway.cwtm.readdefaultdimforctrise(!!cbltraydimensions(!appdata,'CTRISE'))
   !this.cableway.cwtm.readdefaultdimforctcros(!!cbltraydimensions(!appdata,'CTCROS'))
   --message
   !name = !appdata.name
   !this.optMessage.val = 'Dimensions loaded from Application Data $!name'
   !this.optMessage.background = 5

  else
    !this.optMessage.val = 'No dimensions loaded'
    !this.optMessage.background = 2
  endif


endmethod
------------------------------------------------------------------------
--
-- Method: loadTmplDimensions
--
-- Description: Loads the application data world dimensions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadTmplDimensions()

  -- reset load spec member
  !this.loadedSpec  = object DBREF()

  !index = !this.ctmtrlTmpdata.val
  if !index.neq(0) then
   !appdata = !this.tmpldata[!index]

  --units
  !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

   -- bends
   !valueArray  = !!cbltraydimensionsfromtemplate(!appdata, 'CTBEND')
   !this.cableway.cwtm.readdefaulttemplatesdimforctbend(!valueArray[1], !valueArray[2])

   -- straights
   !valueArray  = !!cbltraydimensionsfromtemplate(!appdata, 'CTSTRA')
   !this.cableway.cwtm.readdefaulttemplatesdimforctstra(!valueArray[1], !valueArray[2])

   -- reducer
   !valueArray  = !!cbltraydimensionsfromtemplate(!appdata, 'CTREDU')
   !this.cableway.cwtm.readdefaulttemplatesdimforctredu(!valueArray[1], !valueArray[2])

   -- tee
   !valueArray  = !!cbltraydimensionsfromtemplate(!appdata, 'CTTEE')
   !this.cableway.cwtm.readdefaulttemplatesdimforcttee(!valueArray[1], !valueArray[2])

   -- riser
   !valueArray  = !!cbltraydimensionsfromtemplate(!appdata, 'CTRISE')
   !this.cableway.cwtm.readdefaulttemplatesdimforctrise(!valueArray[1], !valueArray[2])

   -- cross
   !valueArray  = !!cbltraydimensionsfromtemplate(!appdata, 'CTCROS')
   !this.cableway.cwtm.readdefaulttemplatesdimforctcros(!valueArray[1], !valueArray[2])

   --reset units
   !savedUnits.restoreSavedUnitsByPtype('DIST')
   !savedUnits.restoreSavedUnitsByPtype('BORE')

   !this.loadedTmpl = !appdata
   !this.tmplWidth()


   --message
   !name = !appdata.name
   !owner = !appdata.owner.name
   !this.tmploptMessage.val = 'Dimensions loaded from zone $!name of Application Data $!owner'
   !this.tmploptMessage.background = 5
   !this.optMessage.val = 'Dimensions loaded from zone $!name of Application Data $!owner'
   !this.optMessage.background = 3
  endif


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: loadSpecDimensions
--
-- Description: Loads the application data world dimensions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadSpecDimensions()

  if !this.cableway.ctmtrl.badref() then
    !!alert.warning('Material Element is deleted. Cannot load the spec.')
    return
  endif
  !this.loadedTmpl  = object DBREF()

  !appdata = !this.ctmtrlSpecdata.selection().dbRef()
  handle any
    return
  endhandle

   -- units
   !savedUnits = object COMUNITS(true)
   UNITS MM DIST
   UNITS MM BORE

   !valueArray  = !!cbltraydimfromspec(!appdata,'CTBEND')
   if !valueArray.set() then
    !this.cableway.cwtm.readdefaultdimforctbend(!valueArray)
   endif

   !valueArray  = !!cbltraydimfromspec(!appdata,'CTSTRA')
   if !valueArray.set() then
    !this.cableway.cwtm.readdefaultdimforctstra(!valueArray)
   endif

   !valueArray  = !!cbltraydimfromspec(!appdata,'CTREDU')
   if !valueArray.set() then
    !this.cableway.cwtm.readdefaultdimforctredu(!valueArray)
   endif

   !valueArray  = !!cbltraydimfromspec(!appdata,'CTTEE')
   if !valueArray.set() then
    !this.cableway.cwtm.readdefaultdimforcttee(!valueArray)
   endif

   !valueArray  = !!cbltraydimfromspec(!appdata,'CTRISE')
   if !valueArray.set() then
    !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
   endif

   !valueArray  = !!cbltraydimfromspec(!appdata,'CTCROS')
   if !valueArray.set() then
    !this.cableway.cwtm.readdefaultdimforctcros(!valueArray)
   endif

   -- reset units
   !savedUnits.restoreSavedUnitsByPtype('DIST')
   !savedUnits.restoreSavedUnitsByPtype('BORE')

   -- set spref
   !this.cableway.ctmtrl.ctspec = !appdata
   !this.loadedSpec             = !appdata

   -- set widths
    !this.ctmtrlSpec.val       = !this.ctmtrlSpec.rText.findfirst(!this.cableway.ctmtrl.ctspe.string())
    handle ANY
     !this.ctmtrlSpec.val       = 1
    endhandle

   !this.specWidth()



   !name = !appdata.flnm

   --message
   !this.optMessage.val = 'Dimensions loaded from Specification $!name'
   !this.optMessage.background = 5
   !this.tmploptMessage.val = 'Dimensions loaded from Specification $!name'
   !this.tmploptMessage.background = 3

   !!alert.message('Dimensions from spec $!name loaded and Spec for material set to $!name')

endmethod
------------------------------------------------------------------------
--
-- Method: loadAppDimensionsFromFile
--
-- Description: Loads the application data world dimensions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadAppDimensionsFromFile()

 -- reset load spec member
  !this.loadedSpec  = object DBREF()
  !this.loadedTmpl  = object DBREF()

 --units
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 if !!cbltraydimfromfile(!this.cableway.cwtm) then
  --message
  !this.optMessage.val = 'Dimensions loaded from File $!!saveTrayData'
  !this.optMessage.background = 5
  !this.tmploptMessage.val = 'Dimensions loaded from File $!!saveTrayData'
   !this.tmploptMessage.background = 3

 else
   --message
  !this.optMessage.val = 'No data loaded from file'
  !this.optMessage.background = 2
 endif

 --reset units
 !savedUnits.restoreSavedUnitsByPtype('DIST')
 !savedUnits.restoreSavedUnitsByPtype('BORE')

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: dimensionSetup
--
-- Description: Sets up the dimension defaults
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensionSetup()

  if !this.optimumValue.val then
    !this.cableway.optimum  = TRUE
  else
    !this.cableway.optimum  = FALSE
  endif


endmethod
------------------------------------------------------------------------
--
-- Method: back
--
-- Description: method to navigate back to previous task
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
-----------------------------------------------------------------------
define method .back()
  if !this.cableway.ctmtrl.badref().not() then
  !!ce = !this.cableway.ctmtrl
  !this.setTask(|MODIFY|,|CTMTRL|)
  else
   !this.setTask(|CREATE|,|CTMTRL|)
  endif


endmethod
------------------------------------------------------------------------
--
-- Method: setMatSpec
--
-- Description: sets the specification for CTMTRL
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMatSpec()

  !spec = !this.ctmtrlspecTable.selection().dbref()
  !this.cableway.ctmtrl.ctspe = !spec
  !this.ctmtrlspecpara.val = 'Current Spec : ' & !spec.namn



endmethod
------------------------------------------------------------------------
define method .findOffset(!angle is REAL, !height is REAL) is REAL

  !x = object REAL()
  !r = object REAL()
  !sinus = object REAL()
  !sinus = sin((180 - !angle) / 2)

  if ( abs(!sinus) gt 0.0000001) then
    !r = (!height) / !sinus
    !x = !r * cos((180 - !angle) / 2)
  else
    !x = 0
  endif

  return !x

endmethod
------------------------------------------------------------------------
--
-- Method: setSpec
--
-- Description: sets the specification for CTRAY
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpec()

  !spec = !!stChoose.getSelection()
  !!ce = !this.tray
  !component = !!ce


  if !!ce.tierheight.size().lt(2) then
    -- see if there are more than 1 CTRAY
    if !!ce.members.size().gt(1) then
     do !i from 2 to !!ce.members.size()
      CTRAY $!i
      delete CTRAY
     enddo
    endif
    CTRAY 1
    handle ANY
      new CTRAY
    endhandle
    !!ce.spref = !spec
    --set height
    if !!ce.owner.type.eq('CTSTRA') then
     !height = !!ce.owner.olength
     !!ce.height = !height
    endif
  else
    -- see if there are more cable trays
    !numberOfCtray = member ctray count
    if !numberOfCtray.gt(!!ce.tierheight.size()) then
     do !i from (!!ce.tierheight.size() + 1) to !!ce.members.size()
      last CTRAY
      delete CTRAY
     enddo
    endif

   -- create one ctray if none exists
   if  !numberOfCtray.eq(0) then
     NEW CTRAY
     !!ce.spref = !spec
     -- navigate to owner
     OWNER
   endif

    -- Save CTRAY orientation and position of p1 p2 p3
    if !!ce.type.eq('CTSTRA') then
        CTRAY 1
        var !savep1 p1 dir wrt /*
        var !savep30 p30 dir wrt /*
        CTSTRA
    endif

    do !j from 1 to !!ce.tierheight.size()
     CTRAY $!j
     handle ANY
      new CTRAY
     endhandle
      -- reset position to 0 0 0
     POSITION E0 N0 U0
     !!ce.spref = !spec
     !upDistance = !component.tierheight[!j]
     by up $!upDistance
     -- move risers
     if !j.gt(1) then
      if !!ce.owner.type.eq('CTRISE') then
       !yOffset = !this.findOffset(!!ce.owner.angle, !upDistance)
       if !!ce.owner.cttype.eq('OUTS') then
         by y $!yOffset
       else
         by y -$!yOffset
       endif
      endif
     endif
     -- reset ori for p1 and p30
     -- Save CTRAY orientation and position of p1 p2 p3
     if !!ce.owner.type.eq('CTSTRA') then
      ori p1 is $!savep1 wrt /* and p30 is $!savep30 wrt /*
      !height = !!ce.owner.olength
      !!ce.height = !height
     endif
    enddo
  endif

 !this.setPreliminary( !!ce)
  -- set level
 if !this.tray.type.eq('CTRISE') then
   !tempObject  = object CBLAPPLYTRAYMATERIAL(!this.cableway.ctmtrl)
   !tabItemForStraight = !tempObject.findSpecificationForStraight(!this.tray.trayw)
   !tempObject.applyMaterialForRiserStraight(!this.tray, !tabItemForStraight)
 endif

  !!ce = !component
  level 0 1

  !!stChoose.hide()

endmethod
--End of method definition

define method .setPreliminary(!ctray is DBREF)

  !posP0 = !ctray.ppos[0]
  !posP1 = !ctray.ppos[1]
  !posP2 = !ctray.ppos[2]
  !posP3 = !ctray.ppos[3]
  !width = !ctray.ppbore[1].real()
  !widthReduced = !ctray.ppbore[2].real()
  handle any
    !widthReduced = REAL()
  endhandle
  !widthSide = !ctray.ppbore[3].real()
  handle any
    !widthSide = REAL()
  endhandle
  !line1 = object LINE(!posP0, !posP1 )
  !line2 = object LINE(!posP0, !posP2 )
  !line3 = object LINE(!posP0, !posP3 )

  !length1 = !line1.length()
  !length2 = !line2.length()
  !length3 = !line3.length()

  !element = !ctray.owner

  if !element.type.eq('CTSTRA') then
    !element.olength =  !length2
    !element.trayw  =  !width
  elseif !element.type.eq('CTBEND') then
    !element.alength =  !length1
    !element.llength =  !length2
    !element.trayw  =  !width

  elseif !element.type.eq('CTRISE') then
    !element.alength =  !length1
    !element.llength =  !length2
    !element.trayw  =  !width

  elseif !element.type.eq('CTTEE') then
    !element.alength = !length1
    !element.llength = !length2
    !element.trayw   = !width
    !element.traysw  = !widthSide
    !element.slength = !length3
  elseif !element.type.eq('CTREDU') then
    !element.olength =  !length2
    !element.trayw  =  !width
    !element.trayrw  =  !widthReduced


  elseif !element.type.eq('CTCROS') then
    !element.alength =  !length1
    !element.llength =  !length2
    !element.slength = !length3
    !element.sslength = !length3
  else
      !!alert.message('Dressing abandoned.')

  endif

endmethod

define method .findSpecification (!element is DBREF) is DBREF

  !col = object COLLECTION()
  !col.scope(!this.cableway.ctmtrl.ctspe)
  !col.type('TABQUE')
  !express = object EXPRESSION('TANSWER EQ |CTSTRA|')
  !col.filter(!express)
  !colResult = !col.results()
  if (!colResult.empty()) then
   return object DBREF()
  endif

  !cableStraights = object ARRAY()
  do !mat values !colResult
    !cableStraights.append(!mat.owner)
  enddo

  !width = !element.trayw
  !gwidth =  !width
  --!this.getNearestWidth(!width)
  !mmWidth = !gwidth & 'mm'

  !tcol = object COLLECTION()
  !tcol.scope(!cableStraights)
  !tcol.type('TABQUE')
  !express = object EXPRESSION('TANSWER EQ |$!mmWidth|')
  !tcol.filter(!express)
  !cableStraightsWidth = !tcol.results()

  if (!cableStraightsWidth.empty()) then
   return object DBREF()
  endif

  !matOptions = object ARRAY()
  do !i values !cableStraightsWidth
    !matOptions.append(!i.owner)
  enddo

  !ftcol = object COLLECTION()
  !ftcol.scope(!matOptions)
  !ftcol.type('TABQUE')
  !express = object EXPRESSION('TANSWER EQ |VL|')
  !ftcol.filter(!express)
  !lastSelection = object ARRAY()
  do !i values !ftcol.results()
    !lastSelection.append(!i.owner)
  enddo

  !specification = !lastSelection[1]
  if (!specification.unset()) then
    !!alert.error('Can not find required variable length straight')
  else
    return !specification
  endif
  return object DBREF()

endmethod


define method .modifyLengthCtray(!element is DBREF)
  --change speck
  !specification = !this.findSpecification (!element)

  !length   = !element.olength
  !cableTray = !element.mem
  do !x values !cableTray
    !x.height =  !length

    if (not !specification.unset() ) then
      !x.spref = !specification
    endif
  enddo
endmethod

define method .cutAdjacentStraights(!element is DBREF)

  if (!element.type.eq('CTRAY')) then
     owner
  endif
  !cableway = !element.owner
  if (!cableway.type.neq('CTMTRL')) then
    !!alert.error('Navigate to tray component')
    return
  endif

  !undo               = object UNDOABLE()
  !undo.description('Create copies')
  !undo.add()

 do
 --  label /Revaluated
  !nextEle = !element.owner
  !prevEle = !element.owner

  !posP0 = !element.ppos[0]
  !posP1 = !element.ppos[1]
  !posP2 = !element.ppos[2]
  --Adjusting next element
  !nextEle = next of $!element
  handle ANY
    !!alert.warning('There is no straight after the modified component to adjust')
  elsehandle none
    if (!nextEle.type.neq('CTSTRA') or (!nextEle.posref.neq(!element.posref)) )then
      !!alert.warning( 'Next element is not a straight or it does not refer to the same POINTR as the modified component. Try sort trays and then try again' )
    else
      !nextEleP1 = !nextEle.ppos[1]
      !lengthOnLeav = !this.getLength(!posP2 , !nextEleP1)

      !lengthP0P2 = !this.getLength(!posP0, !posP2)
      !lengthP0nextEleP1 = !this.getLength(!posP0, !nextEleP1 )
      !lengthOnLeav = !lengthP0P2 - !lengthP0nextEleP1

      !offset = !cableway.igap + !lengthOnLeav

      !nextEle.zdist = !nextEle.zdist + !offset
      !newOLength = !nextEle.olength - !lengthOnLeav - !cableway.igap
      if !newOLength lt 0 then
         !!ce = !nextEle
         delete CTSTRA
         !!ce = !element
         skip
         --golabel /Revaluated
      endif

      if (!nextEle.olength neq !newOLength ) then

        !nextEle.olength = !newOLength
        !this.modifyLengthCtray(!nextEle)
      endif
    endif
  endhandle

  -- Adjusting prev element
  !prevEle = prev of $!element
  handle ANY
    !!alert.warning('There is no straight before the modified component to adjust')
  elsehandle none
    if !element.type.eq('CTBEND') or !element.type.eq('CTRISE') then
      !tempPoint = !element.posref
      !tempPreviousPoint = prev of $!tempPoint
    else
      !tempPreviousPoint = !element.posref
    endif

    if (!prevEle.type.neq('CTSTRA') or (!prevEle.posref.neq(!tempPreviousPoint)) )then
      !!alert.warning( 'Previous element is not a straight or it refers wrong POINTR. Try sort trays and then try again' )
    else
      !prevEleP2 = !prevEle.ppos[2]
      !lengthOnArrive = !this.getLength(!posP1 , !prevEleP2)
      !lengthP0P1 = !this.getLength(!posP0, !posP1)
      !lengthP0prevEleP2 = !this.getLength(!posP0, !prevEleP2 )
      !lengthOnArrive =  !lengthP0prevEleP2 -  !lengthP0P1

      !newOLength = (!prevEle.olength + !lengthOnArrive )- !cableway.igap
      if !newOLength lt 0 then
        !!ce = !prevEle
        delete CTSTRA
        !!ce = !element
        skip
        --golabel /Revaluated
      endif
      if (!prevEle.olength neq !newOLength) then
        !prevEle.olength = !newOLength
        !this.modifyLengthCtray(!prevEle)
      endif
    endif
  endhandle
  break
 enddo

  !undo.endUndoable()

endmethod
------------------------------------------------------------------------
--
-- Method: displayElement
--
-- Description: sets the levels for material element
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayElement()

  if !this.task.upcase().eq('MODIFY') then
   !dbElement  = !!ce
   !type = !this.elementTable.selection()
   !!ce = !this.cableway.$!<type>

   if !this.ctelementDisplay.val then
     level 0 10
   else
     level 0 1
   endif

   !!ce = !dbElement
  endif



endmethod
------------------------------------------------------------------------
--
-- Method: autoNameElements
--
-- Description: sets the levels for material element
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoNameElements()

  !dbElement  = !!ce
  if !this.cableway.ctmtrl.badref() then
    !!alert.warning('Material Element is deleted.')
    return
  endif
  !!ce = !this.cableway.ctmtrl
  !mem = !!ce.members

  if !mem.unset() then
   !!alert.error('No elements to auto name')
   return
  endif

  -- Mark database
  !undo               = object UNDOABLE()
  !undo.description('Dress')
  !undo.add()

  do !element values !mem
    !!ce = !element
    call !!autoNameCe(FALSE)
  enddo

  -- End undo mark
  !undo.endUndoable()

  -- see if all members are named
  do !name values !mem
    if !name.isnamed.not() then
     !!alert.error('Cannot autoname all elements')
     break
    endif
  enddo

  !!ce = !dbElement

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getGap
--
-- Description: gets the gap for a CTSTRA from the prev comp
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getGap() is REAL

  !gap = 0

  !dbElement  = !!ce
  !!ce = !this.cableway.activeElement
  if !!ce.order.eq(1) then
     !gap = distfp
  else
    prev
    if !!ce.posref.neq(!this.cableway.activeElement.posref) then
      next
      !gap = distfp
    else
     !zdistOfPrev = distfp
     !typeOfPrev = type
     nex
     if !typeOfPrev.eq('CTSTRA') or !typeOfPrev.eq('CTREDU') then
       !zdist = distfp
       !overallLength = olength of prev
       !gap = !zdist - !zdistOfPrev - !overallLength
     elseif !typeOfPrev.eq('CTTEE') or !typeOfPrev.eq('CTCROS') then
       !zdist = distfp
       !llength = llength of prev
       !gap = !zdist - !zdistOfPrev - !llength
     else
       !zdist = distfp
       !overallLength = llength of prev
       !gap = !zdist - !overallLength
     endif
   endif
  endif

  !!ce = !dbElement

  return !gap

endmethod
------------------------------------------------------------------------
--
-- Method: posFromPrev
--
-- Description: Set gap from prev
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .posFromPrev()

  !activeElement = !this.cableway.activeElement
  !activeElementOrder = !activeElement.order
  !memberOfActiveElement = !activeElement.owner.members
  !prevOrder =  !activeElementOrder - 1

  if !activeElement.order.eq(1) then
  else
    !prevElement = !memberOfActiveElement[$!prevOrder]
    !typeOfPrev = type of $!prevElement
    if !typeOfPrev.eq('CTSTRA') then
      !zdistOfPrev = zdist of $!prevElement
      !overallLength = olength of $!prevElement
      !gap = !this.ctelementposFromPrev.val
      !zdist =  !zdistOfPrev + !overallLength + !gap
      !this.ctelementZdis.val = !zdistOfPrev + !overallLength + !gap
      !this.cableway.zdis = !this.ctelementZdis.val
    else
    endif
  endif

-- Update position of aid
  !this.offsetDistance()

endmethod
------------------------------------------------------------------------
--
-- Method: loadTypes
--
-- Description: Loads available types from selected zone
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadTypes()

-- Collect all types
  !type = !this.elementTable.selection()
  !zone = !this.ctmtrlTempdata.dText[$!this.ctmtrlTempdata.val]
  var !collTypes coll all $!type for /$!zone
  var !namesOfTypes eval name for all from !collTypes

-- Add to option list

  !this.ctmtrlTypes.dText = !namesOfTypes

  if !namesOfTypes.size().eq(0) then
     !namesOfTypes.append('None Available')
     !this.ctmtrlTypes.dText = !namesOfTypes
  else
   !this.updateView()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: updateView
--
-- Description: Loads available types from selected zone
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateView()

  !drawlist = !this.drawlist
  !!gphDrawlists.drawlists[!drawlist].removeAll()
  !selected = !this.ctmtrlTypes.val
  !selectedType = !this.ctmtrlTypes.dText[!selected]
  !!gphDrawlists.drawlists[!drawlist].add(!selectedType.dbref())
  handle ANY
    -- No elements are available in selection
  elsehandle NONE
--  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3d)
  !!gphViews.limits(!this.vwView3d, !selectedType.dbref())
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method: updateFrame
--
-- Description: updates the element creation frame
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateFrame()

  !this.setTask(!this.task, !this.elementTable.selection())
  if !this.ctmtrlTempdata.dText.set() then
   !this.loadTypes()
   !this.updateView()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: Update rules
--
-- Description: Executes all rules below cable elements
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateRules()

!!ce = !this.cableway.activeElement

-- Execute attributes rules

  rule execute all
    handle ANY
        !!alert.error(!!error.text)
    endhandle

-- Execute repeat rules

  rule rexecute
    handle ANY
        !!alert.error(!!error.text)
    endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      moveZdis
--
-- Description: sets the zdistance incremental value
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveZdis(!action is STRING, !gadget is GADGET)

  !input = !this.ctelementMoveValue.val
  !currentValue = !gadget.val

 if !action.upcase().eq('DECREASE') then
   !newValue = !currentValue - !input
 else
   !newValue = !currentValue + !input
 endif

 !gadget.val = !newValue
 !this.offsetDistance()


endmethod
------------------------------------------------------------------------
--
-- Method:      findPrevious
--
-- Description: sets the previous element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findPrevious()

 -- initialise variables

   !this.previous = object DBREF()

     if !this.cableway.ctmtrl.members.set() then
      !refElements = !this.cableway.pointr.depref
      !trayElements = object ARRAY()
      -- see if there are elements referring to current point
      do !item values !refElements
        if !this.material.findfirst(!item.type).set() then
          !trayElements.append(!item)
        endif
      enddo

      if !trayElements.set() then
        --get the last element
        !trayList = object ARRAY()
        !distance = object ARRAY()
        do !tray values !trayElements
          if !tray.distfp.leq(!this.ctelementZdis.val) then
           !trayList.append(!tray)
           !distance.append(!tray.distfp)
          endif
        enddo
        !sort = !distance.sortedindices()
        !size = !sort.size()

        if !this.elementTable.selection().eq('CTBEND') or !this.elementTable.selection().eq('CTRISE') then
         !dbElement = !!ce
         !!ce = !trayElements[1]
         prev
         handle ANY
         endhandle
         !this.previous = !!ce
         !!ce = !dbElement
        else

         if !size.eq(0) then
           if !trayElements[1].posref.sequence.eq(1) then
             !this.previous = !this.cableway.ctmtrl
           else

            -- see if there are elements in previous point
            -- collect points
            !col = object COLLECTION()
            !col.scope(!this.cableway.cwbran)
            !col.type('POINTR')
            !points = !col.results()

            !sequence = !this.cableway.pointr.sequence
            !start = !sequence - 1

            !prevPoint = object DBREF()
            do !i from !start to 1 by -1
             !refs = !points[!i].depref
             do !trays values !refs
              if !this.material.findfirst(!trays.type).set() then
                -- we have found an element
                !prevPoint = !points[!i]
                break
              endif
             enddo
             if !prevPoint.set() then
               break
             endif
            enddo

            if !prevPoint.set() then
              !depElements = !prevPoint.depref
              !prevElements = object ARRAY()
             -- see if there are elements referring to current point
             do !item values !depElements
               if !this.material.findfirst(!item.type).set() then
                 !prevElements.append(!item)
               endif
             enddo
             --get the last element
             !trayList = object ARRAY()
             !distance = object ARRAY()
             do !tray values !prevElements
               !trayList.append(!tray)
               !distance.append(!tray.distfp)
             enddo
             !sort = !distance.sortedindices()
             !size = !sort.size()

              -- get the index
              !inx = !sort[!size]
              !this.previous = !trayList[!inx]
            else
             !this.previous = !this.cableway.ctmtrl
            endif
           endif
         else
          !inx = !sort[!size]
          !this.previous = !trayList[!inx]
         endif
        endif
      else
       -- see if there are elements in previous point
       -- collect points
       !col = object COLLECTION()
       !col.scope(!this.cableway.cwbran)
       !col.type('POINTR')
       !points = !col.results()

       !sequence = !this.cableway.pointr.sequence
       !start = !sequence - 1

       !prevPoint = object DBREF()
       do !i from !start to 1 by -1
        !refs = !points[!i].depref
        do !trays values !refs
         if !this.material.findfirst(!trays.type).set() then
           -- we have found an element
           !prevPoint = !points[!i]
           break
         endif
        enddo
        if !prevPoint.set() then
          break
        endif
       enddo

       if !prevPoint.set() then
         !depElements = !prevPoint.depref
         !prevElements = object ARRAY()
        -- see if there are elements referring to current point
        do !item values !depElements
          if !this.material.findfirst(!item.type).set() then
            !prevElements.append(!item)
          endif
        enddo
        --get the last element
        !trayList = object ARRAY()
        !distance = object ARRAY()
        do !tray values !prevElements
            !trayList.append(!tray)
            !distance.append(!tray.distfp)
        enddo
        !sort = !distance.sortedindices()
        !size = !sort.size()

         -- get the index
         !inx = !sort[!size]
         !this.previous = !trayList[!inx]
       else
        !this.previous = !this.cableway.ctmtrl
       endif
      endif
     endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: copy
--
-- Description: Copies select type
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copy(!useGap is BOOLEAN)


-- Access correct element
  !!ce = !this.cableway.activeElement

-- Confirm with user

  if (!!alert.confirm('Are you sure you want to copy the existing cable tray material element?') eq 'NO') then
    return
  endif

  !gap = igap of CTMTRL

  if !useGap.not() then
     !gap = 0
  endif

  -- see if we can fit in the straights in the segment
  if !!ce.type.eq('CTSTRA') then
    var !mode mode
    if !mode.upcase().eq('BACKWARDS') then
     !lpos = ppos 1
     !nextPosition = pos of posref
    else
     !lpos = ppos 2
     !nextPosition = pos of next of posref
    endif

    -- construct line
    !line = object LINE(!lpos, !nextPosition)
    !length = !line.length()
    !overallLength = olength

    !totalLength = !this.nuCopies.val * (!overallLength + !gap)
    if !totalLength.gt(!length) then
      !answer = !!alert.confirm('The segments will exceed the segment. Do you wish to continue?')
      if !answer.eq('NO') then
        return
      endif
    endif

  endif

-- Mark database
  !undo               = object UNDOABLE()
  !undo.description('Create copies')
  !undo.add()

  do !i from 1 to !this.nuCopies.val
    !type = type
    new $!type copy prev
    if !type.eq('CTSTRA') then
      !overallLength = olength
    endif


  if !type.eq('CTSTRA') then
    !move = !overallLength + !gap
  else
    !move = !gap
  endif

  !zdist = zdist
  var !mode mode
  if !mode.upcase().eq('BACKWARDS') then
   !zdist = !zdist - !move
  else
   !zdist = !zdist + !move
  endif
  zdist $!zdist
  enddo

  -- End undo mark
  !undo.endUndoable()

  -- navigate to original element
  !!ce = !this.cableway.activeElement
endmethod
------------------------------------------------------------------------
--
-- Method: updateZdistance
--
-- Description: updates the zdistance gadget
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateZdistance()


 !newValue = !this.ctelementposFromPrev.val
 !zdist    = !this.ctelementZdis.val

 var !mode mode
 if !mode.upcase().eq('BACKWARDS') then
  !newZdist = !zdist + !this.gapValue - !newValue
 else
  !newZdist = !zdist - !this.gapValue + !newValue
 endif

 -- update zdis
 !this.ctelementZdis.val  = !newZdist

 --update member
 !this.gapValue  = !newValue

 --update aids
 !this.offsetDistance()

endmethod
------------------------------------------------------------------------
--
-- Method: getAngle
--
-- Description: gets the angle for bends
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAngle(!point is DBREF) is REAL
 !centrePoint = !point.position
 !firstPoint  = !centrePoint.offset(!point.pdir[1].wrt(worl), 1000)
 !secondPoint = !centrePoint.offset(!point.pdir[2].wrt(worl), 1000)
 !parc = object ARC( !centrePoint, z is u, 0 , 90.2 , 1000 , FALSE)
 !parc  = !parc.startposition(!firstPoint)
 !parc  = !parc.endposition(!secondPoint)

  return !parc.angle()

endmethod
------------------------------------------------------------------------
--
-- Method: editProp
--
-- Description: Edits the properties
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editProp(!type is STRING)

-- Access correct element

  if !type.eq('MAT') then
     !!ce = !this.cableway.activeElement
  else
     !!ce = !this.cableway.activeElement
     ctfeat 1
       handle ANY
          !!alert.message('Unable to find cable tray material feature')
          return
      elsehandle NONE
        tmpl 1
          handle ANY
            !!alert.message('Unable to find cable tray material feature template')
            return
          elsehandle NONE
          endhandle
      endhandle
  endif

  !!comProp(!!ce, 'EDIT')

endmethod
------------------------------------------------------------------------
--
-- Method: switchMode
--
-- Description: switches to back or forward mode
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchMode()

 if !this.backwardMode.val then
   BACKWARDS
 else
   FORWARDS
 endif

 !!ce = !this.cableway.activeElement
 handle ANY
  if !this.cableway.ctmtrl.badref() then
    !!alert.warning('Material element is deleted.')
    return
  endif
  !!ce = !this.cableway.ctmtrl
 endhandle
 if !this.material.findfirst(!!ce.type).set() then
  !this.setTask(!this.task.upcase(), !!ce.type)
 elseif !!ce.type.eq('CTMTRL') then
  !this.offsetDistance()
 endif

endmethod
------------------------------------------------------------------------
--
-- Method: backwards
--
-- Description: switches the object to back or forward mode
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .backwards()

 if !this.backwardWhole.val then
   !this.cableway.cwtm.setdressingdirection(false)
 else
   !this.cableway.cwtm.setdressingdirection(true)
 endif

endmethod
------------------------------------------------------------------------
--
-- Method: getTeeSide
--
-- Description: finds if tee is left or right handed
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTeeSide(!element is DBREF) is STRING

  !side = 'LEFT'
  !posref  = !element.posref
  -- first direction
  !firstDir = !posref.pdir[2]
  !firstDir.origin = !posref

  -- find the second direction
  !conats = !element.conats
  if !conats.set() then
    var !mode mode
    -- put in forward mode
    forwards

    if !conats[1].type.eq('HATTA') then
      !secondPoint = first POINTR of RPATH 1 of owner of $!conats[1]
      !secondDir   = !secondPoint.pdir[2]
    else
      !secondPoint = last POINTR of RPATH 1 of owner of $!conats[1]
      !secondDir   = !secondPoint.pdir[1].opposite()
    endif

    -- change origin
    !secondDir.origin = !posref

    -- define a plane to project lines
    !pos = object POSITION('E0')
    !ori = object ORIENTATION('Y is N and Z is U')
    !plane = object PLANE(!pos, !ori)

    -- project directions to PLANE
    !projFirstDir  = !firstDir.projected(!plane)
    handle (2,891)
     !projFirstDir  = !firstDir
    endhandle
    !projSecondDir = !secondDir.projected(!plane)
    handle (2,891)
     !projSecondDir  = !secondDir
    endhandle

    if !projFirstDir.cross(!projSecondDir).string().eq('D WRT /*') or !projFirstDir.cross(!projSecondDir).string().eq('-Z WRT /*')then
      !side = 'RIGHT'
    elseif !projFirstDir.cross(!projSecondDir).string().eq('N WRT /*') or !projFirstDir.cross(!projSecondDir).string().eq('Y WRT /*') then
      !side = 'RIGHT'
    elseif !projFirstDir.cross(!projSecondDir).string().eq('E WRT /*') or !projFirstDir.cross(!projSecondDir).string().eq('X WRT /*')then
      !side = 'RIGHT'
    endif

    --reset mode
    $!mode
  else
   return !side
  endif

  return !side


endmethod
------------------------------------------------------------------------
--
-- Method: getNearestWidth
--
-- Description: gets the nearest valid width (for imperial units)
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getNearestWidth(!value is REAL) is REAL

!result  = object REAL()

if !value.gt(24) and !value.lt(30) then
 !result = 25
elseif !value.gt(49) and !value.lt(55) then
 !result = 50
elseif !value.gt(64) and !value.lt(70) then
 !result = 65
elseif !value.gt(74) and !value.lt(80) then
 !result = 75
elseif !value.gt(99) and !value.lt(105) then
 !result = 100
elseif !value.gt(124) and !value.lt(130) then
 !result = 125
elseif !value.gt(149) and !value.lt(155) then
 !result = 150
elseif !value.gt(199) and !value.lt(205) then
 !result = 200
elseif !value.gt(215) and !value.lt(230) then
 !result = 225
elseif !value.gt(249) and !value.lt(255) then
 !result = 250
elseif !value.gt(299) and !value.lt(310) then
 !result = 300
elseif !value.gt(349) and !value.lt(360) then
 !result = 350
elseif !value.gt(399) and !value.lt(410) then
 !result = 400
elseif !value.gt(449) and !value.lt(460) then
 !result = 450
elseif !value.gt(499) and !value.lt(510) then
 !result = 500
elseif !value.gt(549) and !value.lt(565) then
 !result = 550
elseif !value.gt(599) and !value.lt(615) then
 !result = 600
elseif !value.gt(649) and !value.lt(665) then
 !result = 650
elseif !value.gt(699) and !value.lt(715) then
 !result = 700
elseif !value.gt(749) and !value.lt(765) then
 !result = 750
elseif !value.gt(799) and !value.lt(815) then
 !result = 800
elseif !value.gt(849) and !value.lt(870) then
 !result = 850
elseif !value.gt(899) and !value.lt(920) then
 !result = 900
elseif !value.gt(949) and !value.lt(970) then
 !result = 950
elseif !value.gt(999) and !value.lt(1020) then
 !result = 1000
endif

return !result

endmethod
------------------------------------------------------------------------
--
-- Method: showCblListCables
--
-- Description: Show CblListCables form
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showCblListCables()

 if(undefined(!!cblListCables))then
   pml load form !!cblListCables
 endif

 !cwbran = !this.cableway.cwbran

 !!cblListCables.show(!cwbran)

endmethod
------------------------------------------------------------------------
--
-- Method: checkLoadedSpec
--
-- Description: check if correct spec or template is loaded
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkLoadedSpec() is ARRAY

 !status = object ARRAY()

 if !this.template and !this.loadedSpec.set() then
   !status.append(FALSE)
   !status.append('Template')
 elseif !this.template and !this.loadedTmpl.set().not() then
   !status.append(FALSE)
   !status.append('Template')
 elseif !this.template.not() and !this.loadedTmpl.set() then
   !status.append(FALSE)
   !status.append('Specification')
 elseif !this.template.not() and !this.loadedSpec.set().not() then
   !status.append(FALSE)
   !status.append('Specification')
 else
   !status.append(TRUE)
   !status.append(' ')
   return !status
 endif

 return !status

endmethod
------------------------------------------------------------------------
