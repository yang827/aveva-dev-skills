--  ===========                      ======              ===========
--  cblselectcnode()                 -                   Constructor
--  dataGridOnPopup(ARRAY)           -
--  setup()                          -                   Set up the grid
--

-- Import DLL
import 'GridControl'
handle any
endhandle
setup form !!cblselectcnode dialog resizable
  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'


 -- PML container to host .NET grid control
  container .gridFrame nobox PmlNetControl 'Table items' anchor T+L+B+R at xmin form width 50 height 15

  button .bnApply 'Apply' at xmin form ymax+0.25 anchor B+L width 8 apply
  button .bnCancel 'Dismiss' at xmax form-size ymin.bnApply anchor B+R width 8 cancel

 -- Create Grid Popup Menu
	menu .popupMenu
  !this.popupMenu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.dataGrid, ||, |Save As|)' )
  !this.popupMenu.add( 'callback', 'Print Preview...', '!this.dataGrid.printpreview()' )

  -- Grid control members
  member .dataGrid   is NETGRIDCONTROL

  member .selection        is STRING
exit

------------------------------------------------------------------------
--
-- Method:   cblselectcnode()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblselectcnode()

  !this.formtitle = 'Select CNODE'
  !this.initCall  = '!this.setup()'
  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Create grid control objects
  !this.dataGrid  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  !this.dataGrid.addEventHandler('OnPopup', !this, 'dataGridOnPopup')
  --!this.dataGrid.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')
  -- Set grid properties
  !this.dataGrid.fixedHeaders(false)
  --!this.dataGrid.fixedRows(false)
  !this.dataGrid.outlookGroupStyle(true)
  !this.dataGrid.columnExcelFilter(true)
  !this.dataGrid.headerSort(true)
  !this.dataGrid.columnSummaries(false)
  !this.dataGrid.singleRowSelection(true)
  !this.dataGrid.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.gridFrame.control  = !this.dataGrid.handle()
  --populate Data
  !this.setup()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Set up the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setup()

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

 -- Clear table ready for repopulating
 --!this.dataGrid.clearGrid()

 -- get the cnodes for world
 -- create array for data
 !data = object ARRAY()
 !data.append('CNODE')
 !data.append(/* )
 !data.append('namn')
 !data.append('owner')
 !data.append('purpose')
 !data.append('function')
 !data.append('description')

 !items = !!getattforgrid(!data)

 -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.append('Zone')
  !headings.append('Purpose')
  !headings.append('Function')
  !headings.append('Description')

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !items)
  !this.dataGrid.bindToDataSource(!ndsItems)

  -- Select first row in the list
  !this.dataGrid.selectRow(1)

endmethod
--End of method definition

---------------------------------------------------------------------------
-- Form Events
---------------------------------------------------------------------------

define method .dataGridOnPopup(!data is ARRAY)	
	!this.gridFrame.popup = !this.popupMenu
  !this.gridFrame.showPopup(!data[0], !data[1])
endmethod
