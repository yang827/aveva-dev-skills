------------------------------------------------------------------------
--
-- Method: getposfromcntrl
--
-- Description: Converts array from position control to position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getposfromcntrl(!pos is ARRAY) is POSITION

   !position           = object POSITION('E0 N0 U0')
   !position.east      = !pos[0]
   !position.north     = !pos[1]
   !position.up        = !pos[2]

    return !position


  endmethod

--End of method definition
------------------------------------------------------------------------
--
-- Method: offsetDistance
--
-- Description: Distance from start of segment for offset
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetDistance()
 !dbElement  = !!ce
 !!ce = !this.point
 !firstPos  = !!ce.position.wrt(world)
  next POINTR
 !secondPos = !!ce.position.wrt(world)
 !line = object LINE(!firstPos,!secondPos)
 if !this.offset.val.gt(!line.length()) then
  !!alert.error('Entered value is more than segment length')
  !dbElement  = !!ce
  return
 endif
 !this.pickedElementPos = !line.startposition.offset(!line.direction(),!this.offset.val)
 if(!this.splitOption eq 'POINT')then
 	!this.setPoint()
 else
  !this.alignPlane()
 endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getLength
--
-- Description: Calculates the length between two positions
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getLength(!first is POSITION, !second is POSITION) is REAL

 !line = object LINE()
 !line.startposition = !first
 !line.endposition   = !second

 return !line.length()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: align
--
-- Description: align with element
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .align(!object is STRING)
   !this.splitOption  = !object
   !packet = object EDGPACKET()
   !packet.action      = '!!cblsplitbranch.pickedposForAlign = !this.return[1].position.wrt(worl)'
   !packet.defineposition('Pick to define position')
   !packet.priority    = 2
   !packet.remove      = TRUE
   !packet.continue = '!!cblsplitbranch.distance()'
   !!edgCntrl.add(!packet)


endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: distance
--
-- Description: calculates the distance of RATTA position
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distance()

  if(!this.pickedposForAlign.unset())then
  	return
  endif
  !line  = object LINE()
  !line.startposition = !this.point.position.wrt(worl)
  !!line = !line
  -- find the position of next POINTR
  !ce = !!ce
  !!ce  = !this.point
  next POINTR
  !line.endposition   = !!ce.position.wrt(worl)
  !!ce = !ce
  !newLine = object LINE()
  !newLine.startposition  = !line.startposition
  !newLine.endposition    = !line.near(!this.pickedposForAlign)

  if (!line.direction().neq(!newLine.direction()) or !line.length().lt(!newLine.length())) then
    !!alert.error('The pick is not within the current segment')
    return
  endif

  !this.offset.val = !newLine.length()
  !this.offsetDistance()


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      moveZdis
--
-- Description: sets the zdistance incremental value
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveZdis(!action is STRING, !gadget is GADGET)

  !input = !this.zdisMoveValue.val
  !currentValue = !gadget.val
 if !currentValue.unset() then
	 !!alert.error('Position to split not set')
   return
   endif
 if !action.upcase().eq('DECREASE') then
   !newValue = !currentValue - !input
 else
   !newValue = !currentValue + !input
 endif

 !gadget.val = !newValue
 !this.offsetDistance()

 endmethod
------------------------------------------------------------------------
--
-- Method:     cablePassCheck
--
-- Description: Checks for cables passing through an element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--

------------------------------------------------------------------------

define method .cablePassCheck(!refPoint is DBREF, !elementType  is STRING)is BOOLEAN
	
	!branch = !!ce
	
	!conseqPresent= object BOOLEAN()
	!conseqPresent= FALSE
  !conseq = CONSEQ 1 of $!branch
  handle any
    $!branch
    new CONSEQ
  !conseqPresent = TRUE
  elsehandle none
    $!conseq
  endhandle
    new RATTA
    -- create temp. RATTA
  !refPointPos = !refPoint.pos.wrt(world)
  !line = object LINE(!this.pickedElementPos, !refPointPos)
  !zdis = !line.length()
  Posref $!refPoint
  Zdistance $!zdis
  !cableFound   = FALSE
  if !elementType.upcase().eq('CWBRAN') then
    !a = 'RATTA 1'
    !b= !a.dbref()
    !col   = object COLLECTION()
    !col.type('RATTA')
    !col.scope(!b)
    do !ratta values !col.results()
      if !ratta.clist[0].size().gt(0) then
        -- found cables on the CWAY
        !this.cableArray = !ratta.clist[0]
        !cableFound = TRUE
        break
      else
        !cableFound = FALSE
      endif
    enddo
  endif
  --delete temp. RATTA
  delete RATTA
  if (!conseqPresent) then
    delete CONSEQ
  endif

  $!branch
  return !cableFound
endmethod

------------------------------------------------------------------------
--
-- Method: processNodes
--
-- Description: finds the zdis of nodes on split segment
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processNodes(!branch is DBREF, !pos is POSITION) is DBREF

 -- initialise variables
 !this.nodes          = object ARRAY()
 !this.zdistance      = object ARRAY()

 !pointCollect = object COLLECTION()
 !pointCollect.scope(!branch)
 !pointCollect.type('POINTR')
 !points  = !pointCollect.results()

 -- get the reference point
 !refPoint = object DBREF()
 do !i from 1 to (!points.size() - 1)
   !line = object LINE(!points[!i].position, !points[!i + 1].position)
   if !line.on(!pos) then
     !refPoint = !points[!i]
     break
   endif
 enddo

 if !refPoint.set() then
  --get the route nodes
  !col = object COLLECTION()
  !col.scope(!branch)
  !col.addtype('RNODE')
  !express = object EXPRESSION('POSREF eq $!refPoint')
  !col.filter(!express)
  !elements  = !col.results()

  -- calculate the actual zdistance and add to array
  do !i indices !elements
   !zdis = !elements[!i].distfp
   -- create a line to get the length after Split
   !newLine = object LINE(!pos, !elements[!i].posref.position)
   !newZdis = !zdis - !newLine.length()

   !this.nodes.append(!elements[!i])
   !this.zdistance.append(!newZdis)

  enddo

 endif
 return !refPoint

endmethod

------------------------------------------------------------------------
--
-- Method: changeCableRouteInfo
--
-- Description: Changes the Cable Route Information in the External Geometry
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeCableRouteInfo(!refPoint is DBREF, !originalBranch is DBREF, !newbran is DBREF)
  !reference = !!ce
  if (!this.cableArray.unset()) then
    return
  endif
  !selection = object SELECTION()
  !selection.getAll()
  !gphElements = !selection.getSelection()

  do !i indices !this.cableArray
    !targetElement = !this.cableArray[!i]
    -- find the extgeo that is nearest target ref.point
    !resultPosList  = object ARRAY()
    !resultNameList = object ARRAY()
    !refPos = !refPoint.pos.wrt(WORLD)
    !resultPosList.append(!refPos)
    !resultNameList.append('refPos')
    !ori         = object ORIENTATION('Z is $!this.planeDirection')
    !plane       = object PLANE(!this.pickedElementPos, !ori)
    !nearestExtGeo = object DBREF()
    var !extGeoList coll all EXTGEO for $!targetElement

    do !j indices !extGeoList
      !element   = !extGeoList[!j].dbref()
      !staRefOwner= !element.staref.owner
      if (!element.staref.owner.type EQ 'RTFEAT' OR !element.staref.owner.type EQ 'CONSEQ') then
      	!staRefOwner= !element.staref.owner.owner
      else
      	!staRefOwner= !element.staref.owner
      endif
      if (!element.endref.owner.type EQ 'RTFEAT' OR !element.endref.owner.type EQ 'CONSEQ') then
      	!endRefOwner= !element.endref.owner.owner
      else
      	!endRefOwner= !element.endref.owner
      endif
      if (!staRefOwner NEQ !endRefOwner)then
      	!nearestExtGeo = !extGeoList[!j].dbref()
         break
        endif
        handle any
        skip
      endhandle
    enddo

    if (!nearestExtGeo.unset()) then
      skip
    endif
    if (!nearestExtGeo.staref.owner.type EQ 'RTFEAT' OR !element.staref.owner.type EQ 'CONSEQ') then
    	!staRefOwner= !nearestExtGeo.staref.owner.owner
    else
    	!staRefOwner = !nearestExtGeo.staref.owner
    endif

    if (!staRefOwner EQ !originalBranch) then
    !headElement =!nearestExtGeo.staref
    !tailElement = TATTA 1 of $!originalBranch
    !newTail = !nearestExtGeo.endref
    !newTail.owner $!newbran
    !nearestExtGeo.endref = $!tailElement
    !newHead = HATTA 1 of $!newbran
   elseif (!staRefOwner EQ !newbran)then
    !headElement = !nearestExtGeo.staref
  	!tailElement = HATTA 1 of $!newbran
  	!newHead = TATTA 1 of $!originalBranch
  	!newTail = !nearestExtGeo.endref
    !newTail.owner $!newbran
    !nearestExtGeo.endref = $!tailElement
   endif
    $!nearestExtGeo
    new EXTGEO
    staref $!newHead
    endref $!newTail
    $!targetElement
    if (!gphElements.findfirst(!!ce.ref).unset()) then
      rem ce
    endif
  enddo
    $!reference
endmethod
------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      changeOpenDirection
--
-- Description: sets the ydirection of the new branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeOpenDirection(!originalBranch is DBREF, !newbran is DBREF)
	
$!originalBranch
first RPATH
!refPoint = last POINTR
$!newbran
!target= first RPATH
!target.ydir = !refPoint.lydir
endmethod


define method .crateRnodes(!originalBranch is DBREF,!newbran is DBREF)
  	!temp = !!ce

    if ( not !this.cwbranRnodeCreation ) then
    	return
    endif
    $!originalBranch
    first RPATH
		!refPoint = last POINTR
		!this.createRNODESatPoint(!originalBranch,  !refPoint)
		
		$!newbran
		!target= first RPATH
		$!target
		!refPoint = first POINTR
		!this.createRNODESatPoint(!newbran,  !refPoint)

		$!temp
endmethod

define method .createRNODESatPoint(!bran is DBREF, !point is DBREF)
	
		!temp = !!ce
    -- create RNODE at point

  	$!bran
  	RTFEAT 1
  	handle ANY
  		NEW RTFEAT
    endhandle

    NEW RNODE
    !!ce.posref  = !point
    RNTYPE TAKE
    !name = '/' & !!cblautoname('RNODE', !bran )
    name $!name
    handle ANY
    endhandle


		$!temp
	
endmethod
