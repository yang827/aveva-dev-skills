------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addidbran(DBREF,STRING)          -
--  align(STRING)                    -                   align with element
--  alignPlane()                     -                   creates plane
--  cablePassCheck(DBREF,STRING)     BOOLEAN             Checks for cables passing through an element
--  cblsplitbranch()                 -                   Constructor
--  changeCableRouteInfo(DBREF,DBREF,DBREF) -                   Changes the Cable Route Information in the External Geometry
--  changeOpenDirection(DBREF,DBREF) -                   Sets the ydirection of the new branch
--  clearAids()                      -                   Creation of aid text and lines
--  clearList()                      -                   Remove and unenhance all elements in the list. Clear aids if any
--  crateRnodes(DBREF,DBREF)         -
--  createPlane()                    -                   Creates plane
--  createRNODESatPoint(DBREF,DBREF) -
--  derivePickedPoint(EDGPICKDATA)   -                   Derives the picked POINTR from edg pick
--  dismiss()                        -
--  distance()                       -                   Calculates the distance of RATTA position
--  enhance()                        -                   To enhance the picked elements
--  getLength(POSITION,POSITION)     REAL                Calculates the length between two positions
--  getposfromcntrl(ARRAY)           POSITION            Converts array from position control to position
--  idbran(STRING)                   -
--  initialise()                     -
--  modifyPlane()                    -                   Modifies plane
--  moveZdis(STRING,GADGET)          -                   Sets the zdistance incremental value
--  offsetDistance()                 -                   Distance from start of segment for offset
--  pickPlane()                      -                   EDG to pick route point
--  pickPoint()                      -                   EDG to pick route point
--  poscntrl()                       -                   Initialise Position Control
--  processList(ARRAY)               ARRAY
--  processNodes(DBREF,POSITION)     DBREF               Finds the zdis of nodes on split segment
--  remove()                         -                   Removes the element from list
--  setGadgets()                     -                   Set the visibility of Gadgets
--  setPlane()                       -                   Set the plane definition
--  setPoint()                       -                   Set the point definition
--  setPosition()                    -                   Setting the position to PICKEDELEMENTPOS member
--  setup()                          -
--  split()                          -                   Splits the branches
--  split(STRING)                    -                   Splits the branches
--  validatePosition()               -                   Validates the position control gadget
--

-- Import DLL
import 'PositionControl'
handle ANY
endhandle

setup form !!cblsplitbranch dialog docking right

 frame .elementFrame 'Branches to Split ' anchor left+right+top   at x0  ymax+0.5  width 41
 -- Selected Element list
  list .elemlist ''  anchor left+right+top  at x0.5 tooltip 'Branches in this listed will be split' callback |!this.enhance()| columns multiple width 37 height 5


  -- Add button to Append elements to the list
  button .addce  'Add Ce'           anchor left+top at Xmin ymax   callback '!this.setup(|CE|)'     width 6
  path right hdist 0.3
  button .load  'Add Selected'      anchor left+top      callback '!this.setup(|GRAPHICAL|)'     width 10
  button .id    'ID Selection'      anchor left+top      callback '!this.idbran(|SELECT|)'     width 9
  button .clear 'Clear all'         anchor left+top      callback '!this.clearList()' width 6
 exit

  para   .parasplitType  anchor l+t at x0 ymax+1  text 'Split options:'
  option .splitType    '' anchor l+t at xmax ymin callback |!this.setGadgets()|  width 15

  frame .pointDef 'Point Definition'  anchor left+right+top at x0 ymax+0.5 width 41
    frame  .splitposframe panel anchor l+t at x1 ymax+0.2 width 36 hei 5
      container .netsplitposframe PMLNetCONTROL 'NET' dock fill
    exit
    button .placepoint  'Pick Point'             at x2        ymax+0.1   callback '!this.pickPoint()'          width 8
    button .alignpoint  'Align'                  at xmax+17   ymin       callback '!this.align(|POINT|)'       width 8
    paragraph .offsetTag           anchor l+t    at x0.2      ymax+0.5   text  'Distance from segment start:'  width 19
    text      .offset              anchor l+t    at xmax+0.1  ymin       callback '!this.offsetDistance()'     width 17 is REAL  format !!distanceFmt
    paragraph .zdisMoveTag         anchor l+t    at x0.2      ymax+0.5   text  'Move Offset:'                  width 19
    button    .zdisLeftMove        anchor l+t    at xmax      ymin       pixmap callback '!this.moveZdis(|DECREASE|,!this.offset)' tooltip 'Decrease Offset' width 16
    text      .zdisMoveValue       anchor l+t    at xmax+0.5  ymin       callback ''                           width 11 is REAL  format !!distanceFmt
    button    .zdisRightMove       anchor l+t    at xmax+0.5  ymin       pixmap callback '!this.moveZdis(|INCREASE|,!this.offset)' tooltip 'Increase Offset' width 16
  exit

-- Cutting plane definition frame
  frame .planeDef 'Plane Definition '  anchor left+right+top   at x0  ymax+0.5  width 41

    path down
    halign left
    vdist 0
    path right

    -- Allows the user to view the plane created in the graphical canvas before he goes to split action.
    button .placeplane  'Create plane'        at x1  ymax+0.1   callback '!this.pickPlane()' width 8
    button .alignPlane  'Align'             at xmax+3 ymin   callback '!this.align(|PLANE|)' width 8
    button .modplane    'Modify plane'        at xmax+5  ymin    callback '!this.modifyPlane()' width 8
  exit

  frame .movecomp     'Move down-stream components to '  anchor left+right+top at xmin ymax+0.5 width 41
    vdist 0
    hdist 0
    halign left
    path right
    rToggle .newcway   'New Cableway'             callback ||
    rToggle .newbran   'Existing Cableway'        callback ||

  exit
   toggle    .autonametoggle        anchor l+t       at x1      ymax+1      ' Auto Name'
   button .applysplit  'Split'  anchor left+Top   at x1 ymax  callback |!this.split()| width 8

  -- Stores the list elements
  member .elements              is ARRAY

  --plane
  member .gplane                is GPHPLANE

  -- position
  member .pickedElementPos      is POSITION
  member .pickedposForAlign     is POSITION

  -- direction
  member .planeDirection        is DIRECTION

  --aids
  member .planeaidNumber        is REAL
  member .pointaidnumber        is REAL
  member .pointsphere           is GPHPOSITION

  --list of cableways
  member .selectedCway          is ARRAY
  member .newCreateCway         is ARRAY

  -- position control
    using namespace 'Aveva.Pdms.Presentation'
  member .poscontrol            is POSITIONCONTROL

  -- picked point
  member  .point                is DBREF

  -- picked branch
  member  .pickedBranch         is DBREF

  -- route nodes and attachments in split segment
  member  .nodes                is ARRAY
  member  .zdistance            is ARRAY
  member  .splitOption  				is STRING
  member .cableArray            is ARRAY
 	member .cwbranRnodeCreation   is BOOLEAN
  !this.quitcall   = |!this.dismiss()|
  --!this.callback   = |!this.elemlist.clear()|
  !this.callback   = |!this.initialise()|
exit



------------------------------------------------------------------------
--
-- Method:   cblsplitbranch()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cblsplitbranch()

   !this.formtitle = 'Split Cableway Branch'
  --Register Aid numbers
   !this.planeaidNumber     = !!aidNumbers.add(!this.gplane)
   !this.pointaidnumber     = !!aidNumbers.add('Split Point')

   -- Set the headings for element list
    !headings[1]    =   'Cableway'
    !headings[2]    =   'Branch'
    !this.elemlist.setheadings(!headings)
   -- autoname
   !this.autonametoggle.val = TRUE

   --create where
   !this.movecomp.val = 2

   -- split option
   -- options for collection scope
  !splitDtext = ARRAY()
  !splitDtext.append('Split at Point')
  !splitDtext.append('Split using Plane')

  !this.splitType.dtext  = !splitDtext

  !this.setGadgets()

  --aids
  !this.pointsphere.position  = E0
  !this.pointsphere.diameter  = 100mm
  !this.pointsphere.description = '<Split>'
  !this.pointsphere.tag         = TRUE
  !this.pointsphere.visible     = TRUE
  !this.pointsphere.detail = FALSE

  -- position control
  !this.poscntrl()

  -- pixmap
  !leftArrow      = !!pml.getPathname('leftarrow16.png')
  !rightArrow     = !!pml.getPathname('rightarrow16.png')
  !this.zdisLeftMove.addPixmap(!leftArrow)
  !this.zdisRightMove.addPixmap(!rightArrow)

  !this.zdisMoveValue.val = 0

   -- Check for existence of popup
   if(defined(!this.popupMenu)) then
     !menu = !this.popupMenu
     !menu.clear()
   else
     !menu = !this.newMenu('popupMenu')
   endif

   -- Add right-mouse-click pop-up menu to the list gadget
   !menu.add('callback', 'Remove From List', '!this.remove()' )
   !this.elemlist.setpopup(!this.popupMenu)



endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

 !this.elemlist.clear()
 !this.splitType.val  = 1
 !this.setGadgets()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!mode IS STRING)

  if !mode.eq('GRAPHICAL') then

    -- Get elements
    !selection        = object SELECTION()
    !selection.getCurrent()
    !elements         = !selection.getSelection()

    -- If Selection is empty
    if(!elements.empty()) then
       !!alert.error('No items to add. Please Pick/Window select items in the view and retry.')
       return
    endif

    !this.elements.appendarray(!this.processList(!elements))

  elseif !mode.eq('CE') then
    -- add the ce branch members to the split list
     !list[1] = !!ce
    !this.elements.appendarray(!this.processList(!list))

  else
    -- we are in id pipe mode
    if (defined(!!pickedElement)) then
      if !!pickedElement.unset() then
        return
      endif
    else
      return
    endif

    !!pickedElement
    !this.elements.appendarray(!this.processList(!!pickedElement))

  endif

  !this.elements.unique()

  !refinedElement  = object ARRAY()
  do !element values !this.elements
    if(!element.badref().not())then
     	!refinedElement.append(!element)
    endif
  enddo

  --!this.elements   = object ARRAY()
  !this.elements   = !refinedElement

  !disptext[1]        = ARRAY()
  !disptext[2]        = ARRAY()
  !replace           = ARRAY()
  !this.selectedCway = ARRAY()

  do !i indices !this.elements
     !disptext[1].append(!this.elements[!i].owner.namn)
     !disptext[2].append(!this.elements[!i].namn)
     !this.selectedCway.append(!this.elements[!i].owner)
     !replace.append(!this.elements[!i].string())
     ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
  enddo

  !this.selectedCway.unique()
  !this.elemlist.setcolumns(!disptext)
  !this.elemlist.rtext = !replace

  -- put on the popup gadget
  !this.popupMenu.setactive('Remove From List',  TRUE)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      processList
--
-- Description: gets a list of branches from collection or id
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   elements list
------------------------------------------------------------------------

define method .processList(!objects is ARRAY )is ARRAY

 !return = ARRAY()
 do !a values !objects
    if !a.type.eq('CWBRAN') then
      !return.append(!a)
    elseif !a.ahlist.findfirst('CWBRAN').set() then
      CWBRAN
      !bran = !!ce
      !return.append(!bran)
    elseif !a.type.eq('SITE') or !a.type.eq('ZONE') or !a.type.eq('CWAY') then
    	!col = object COLLECTION()
    	!col.scope(!a)
    	!col.type('CWBRAN')
    	do !bran values !col.results()
    	 !return.append(!bran)
    	enddo
    endif
 enddo

 return !return

endmethod

------------------------------------------------------------------------
--
-- Method:      idPipes
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idbran(!mode is STRING)

  if !mode.eq('PLANE') and !this.plane.unset() then
    !!alert.warning('Plane not defined, please create one')
    return
  endif

  if(defined(!!pickedElement))then
     !!pickedElement.delete()
  endif

    !firstPacket = object EDGPACKET()
    !firstPacket.initialisation = '!!pickedElement = ARRAY()'

  if !mode.eq('SELECT') then
    -- select elements by pick and append them to the list
    !firstPacket.description = 'Pick Branch'
    !firstPacket.key      = 'pickpbran'
    !firstPacket.priority = 3
    !firstPacket.elementPick('Pick a cableway branch (or branches) to split. <esc> to finish selecting')
    !firstPacket.action = '!!cblsplitbranch.addidbran(!this.return[1].item,|STD|)'
    !firstPacket.close = '!!cblsplitbranch.setup(|ID|)'
    !element = 'TYPE inset (|CWBRAN|, |CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|)'
    !firstPacket.pickPacket.picks[1].pick.input[3]   = !element

  endif

  !!edgCntrl.add(!firstPacket)

endmethod

------------------------------------------------------------------------
--
-- Method:      addidbran
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addidbran(!element is DBREF, !mode is STRING )

    if !element.type.eq('CWBRAN') then
      !bran = !element
      !!pickedElement.append(!element)
    elseif !element.ahlist.findfirst('CWBRAN').set() then
      CWBRAN
      !bran = !!ce
      !!pickedElement.append(!bran)
    endif

    if defined(!bran) then
    	enhance $!bran
    endif


endmethod

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: removes the element from list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove( )

  !selected = !this.elemlist.selection()
  -- remove from element list
  do !items values !selected
    !number = !this.elements.findfirst(!items.dbref())
    UNENHANCE $!this.elements[$!number]
    !this.elements.remove(!number)
  enddo

  !disptext[1]        = ARRAY()
  !disptext[2]        = ARRAY()
  !replace           = ARRAY()
  !this.selectedCway = ARRAY()

  do !i indices !this.elements
     !disptext[1].append(!this.elements[!i].owner.namn)
     !disptext[2].append(!this.elements[!i].namn)
     !this.selectedCway.append(!this.elements[!i].owner)
     !replace.append(!this.elements[!i].string())
     ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
  enddo

  !this.selectedCway.unique()
  !this.elemlist.setcolumns(!disptext)
  !this.elemlist.rtext = !replace
  if !this.elements.unset() then
   !this.popupMenu.setactive('Remove From List',  FALSE)
  endif

endmethod

---------------------------------------------------------------------------
--
-- Method:      pickPoint
--
-- Description: EDG to pick route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPoint()

    !packet = object EDGPACKET()
    !packet.priority = 2
    !packet.pickPacket.stdgraphic('Pick on the segment which the branch should be split')
    !packet.action = '!!cblsplitbranch.derivePickedPoint(!this.return[1]) !!cblsplitbranch.poscontrol.xyz(!!cblsplitbranch.pickedElementPos.east,!!cblsplitbranch.pickedElementPos.north,!!cblsplitbranch.pickedElementPos.up) '
    !packet.remove = TRUE
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.pickPacket.picks[1].numberofpicks = 1
    !element = 'TYPE inset (|CWBRAN|, |CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|)'
    !packet.pickPacket.picks[1].pick.input[3] = !element
     !packet.continue = '!!cblsplitbranch.setPoint()'
    !!edgCntrl.add(!packet)

endmethod
--End of method definition
---------------------------------------------------------------------------
--
-- Method:      pickPlane
--
-- Description: EDG to pick route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPlane()

    !packet = object EDGPACKET()
    !packet.priority = 2
    !packet.pickPacket.stdgraphic('Pick on the segment which the branch should be split')
    !packet.action = '!!cblsplitbranch.derivePickedPoint(!this.return[1])'
    !packet.remove = TRUE
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.pickPacket.picks[1].numberofpicks = 1
    !element = 'TYPE inset (|CWBRAN|, |CTSTRA|, |CTREDU|, |CTTEE|, |CTBEND|, |CTRISE|, |CTCROS|)'
    !packet.pickPacket.picks[1].pick.input[3] = !element
    !packet.continue = '!!cblsplitbranch.createPlane()'
    !!edgCntrl.add(!packet)

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      derivePickedPoint
--
-- Description: derives the picked POINTR from edg pick
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePickedPoint(!pickData is EDGPICKDATA)

   if !pickData.item.type.neq('CWBRAN') then
   	!element = !pickData.item.owner.owner
   else
    !element   = !pickData.item
   endif
   !this.pickedBranch = !element
   !facets    = !pickData.facets
   !pointvect = !pickData.pickLine
   !lpos      = !pickData.lines

   if !facets.unset() then
    -- no facets. so pick the line
    !pickLine = object LINE(!lpos[1],!lpos[2])
    !line = !pointvect.line(100)
    !intersect = !pickLine.intersection(!line)
   else
     -- create profile from facets
     !profpos = !facets[1]
     -- get orientation from first two positions of the facets
     !facetLine = object LINE(!facets[1], !facets[2])
     !ydir = !facetLine.direction()
     !profori = object ORIENTATION('Y is $!ydir')
     !prof    = object PROFILE(!profpos, !profori, !facets)
     --close the profile
     !prof.close()

     -- create line from point vector
     !line = !pointvect.line(100)

     -- if line is perpendicular to profile, manipulate to intersect at some other point
     if !prof.orientation.zdir().opposite().eq(!line.direction()) or !prof.orientation.zdir().eq(!line.direction()) then
      !intersect = !prof.near(!line.startposition)
     else
     -- project line on to profile and get position
     !intersects = !prof.intersections(!line)
     !intersect  = !intersects[1]
     endif
    endif

   --construct lines along Route
   !col = object COLLECTION()
   !col.scope(!element)
   !col.type('POINTR')

   !points = !col.results()

   !routeLines = object ARRAY()
   do !i from 1 to (!points.size() - 1)
    !rline = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
    !routeLines.append(!rline)
   enddo
   -- find the nearest line to profile intersection
   !distarray = object ARRAY()
   do !j from 1 to !routeLines.size()
    !dist = !routeLines[!j].distance(!intersect)
    !distarray.append(!dist)
   enddo

   -- sort the distances to get the index of the point
    !sortdist = !distarray.sortedindices()
    --!pointr = !points[!sortdist[1]]
    -- check if there are more points than 1
    !unusedSortdist = !sortdist[2]
    handle ANY
    	!pointr = !points[!sortdist[1]]
    	!inx    = 1
    elsehandle NONE
    -- if the points are in same line, then find the nearest point to intersection
     !nearestPoint  =  !points[!sortdist[1]]
     !inx = 1
     !lineFirst  = object LINE(!intersect, !points[!sortdist[1]].position.wrt(worl))
     do !x from 2 to (!sortdist.size())
       if !distarray[!sortdist[1]].eq(!distarray[!sortdist[!x]]) then
        !lineSecond = object LINE(!intersect, !points[!sortdist[!x]].position.wrt(worl))
        if !lineFirst.length().gt(!lineSecond.length()) then
          !nearestPoint = !points[!sortdist[!x]]
          !lineFirst    = !lineSecond
          !inx = !x
        endif
       endif
      enddo
       !pointr  = !nearestPoint
    endhandle
    !this.point    = !pointr
    !this.planeDirection = !pointr.pdir[2]
   -- get the position on the segment
   !this.pickedElementPos  = !routeLines[!sortdist[!inx]].near(!intersect)
endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      clearList
--
-- Description:
--   Remove and unenhance all elements in the list. Clear aids if any
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    Clear Graphical aids
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearList()

  -- Unenhance elements

  do !i indices !this.elements
     UNENHANCE $!this.elements[$!i]
  enddo

  !this.elements.clear()
  !this.elemlist.clear()
  !this.popupMenu.setactive('Remove From List',  FALSE)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createPlane
--
-- Description: creates plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPlane()

  !ori  = object ORIENTATION('Z is $!this.planeDirection')
  !plane = object PLANE(!this.pickedElementPos, !ori)
  !this.gplane  = object GPHPLANE(!plane)
  !this.gplane.filled(TRUE)
  !this.gplane.detail = TRUE
  !this.gplane.draw(!this.planeaidNumber)


endmethod

------------------------------------------------------------------------
--
-- Method:      alignPlane
--
-- Description: creates plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .alignPlane()

  !plane 								 = !this.gplane.plane
  !plane.position				= !this.pickedElementPos
  !this.gplane.plane  = !plane
   !this.gplane.filled(TRUE)
  !this.gplane.detail = true
  !!aidNumbers.replace(!this.planeaidNumber,!this.gplane)

endmethod



------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: to enhance the picked elements
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhance()
   !listVal  =  !this.elemlist.val

   do !i indices !this.elements
      ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
   enddo

   do !i indices !listVal
      ENHANCE $!this.elements[$!listVal[$!i]] COLOUR DEEPPINK
   enddo

endmethod

------------------------------------------------------------------------
--
-- Method:     modifyPlane
--
-- Description: modifies plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPlane()

  -- load the form
     pml reload form  !!gphPlaneEdit

  -- Redefine ok callback of gphPlaneEdit
     !!gphPlaneEdit.okcall  = '!!cblsplitbranch.setPlane()'

     !!aidNumbers.replace(!this.planeaidNumber,!this.gplane)
     !aidItem   = !!aidNumbers.get(!this.planeaidNumber)
     !aidItem.edit(!this.planeaidNumber)


endmethod

------------------------------------------------------------------------
--
-- Method:      setPlane
--
-- Description: set the plane definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPlane()

  !!gphPlaneEdit.apply()
  !this.gplane         = !!gphPlaneEdit.plane


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPoint
--
-- Description: set the point definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPoint()


 if(!this.pickedElementPos.origin.unset())then
 	 return
 endif
 --initialise variable
 !this.splitOption = 'POINT'

 --populate position control
 --!this.poscontrol.xyz(!this.pickedElementPos.east,!this.pickedElementPos.north,!this.pickedElementPos.up)

 -- draw aids
 !this.pointsphere.position  = !this.pickedElementPos
 !this.pointsphere.draw(!this.pointaidnumber)

 --offset gadget populate
 !pos = !this.pickedElementPos

 if (!this.point.unset())then
 	  !!alert.warning('Please pick CWBRAN and point to split branch.')
 	 return
 endif
 !this.offset.val = !this.getLength(!this.point.pos.wrt(worl), !pos)
 	handle ANY
 	RETURN 	
  endhandle
	
	--update list gadget
  !disptext[1]        = ARRAY()
  !disptext[2]        = ARRAY()
  !replace           = ARRAY()
  !this.selectedCway = ARRAY()
  !this.elements     = ARRAY()
  !this.elemlist.setcolumns(!disptext)
  !this.elemlist.rtext = !replace
  !!ce = !this.pickedBranch
  unenhance all
  !this.setup('CE')


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setGadgets
--
-- Description: set the visibility of Gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadgets()

  !disptext[1]        = ARRAY()
  !disptext[2]        = ARRAY()
  !replace           = ARRAY()
  !this.selectedCway = ARRAY()
  !this.elemlist.setcolumns(!disptext)
  !this.elemlist.rtext = !replace
 if !this.splitType.val.eq(1) then
 	!this.pointDef.active = TRUE
 	!this.planeDef.active = FALSE
 	!this.elementFrame.active = FALSE
 else
  !this.pointDef.active = FALSE
 	!this.planeDef.active = TRUE
 	!this.elementFrame.active = TRUE
 endif

 !this.clearAids()
 !this.pickedElementPos  = object POSITION()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     split
--
-- Description: splits the branches
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .split()
 !undo               = object UNDOABLE()
 !undo.description('Split')
 !undo.add()

 --load defaults
 if undefined(!!cbldflts) then
		pml reload form !!cbldflts
 endif
	!this.cwbranRnodeCreation = !!cbldflts.cwbranRnodeCreation

 if !this.pickedElementPos.unset() then
   !!alert.error('Position to split not set')
   return
 endif

 if !this.splitType.val.eq(1) then
 	!this.split('POINT')
 	
 else
  !this.split('PLANE')
 endif	
 -- End undo mark
 !undo.endUndoable()
endmethod
------------------------------------------------------------------------
--
-- Method:     split
--
-- Description: splits the branches
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .split(!type is STRING)
  !trayManager   = object CABLETRAYMANAGER()

  if !this.elements.unset() then
   !!alert.error('No branches selected for splitting')
   return
  endif

  if(!trayManager.setPosOnPointrAllowed(!this.point).not())then
  	!!alert.warning('The Cable Way branch is dressed. Not able to Split.')
  	return
  endif

  -- rebuild cableway ARRAY
  !this.selectedCway  = ARRAY()
  !this.newCreateCway = ARRAY()
  do !i indices !this.elements
     !this.selectedCway.append(!this.elements[!i].owner)
  enddo
   !this.selectedCway.unique()

  -- create new cableways if required
  if !this.movecomp.val.eq(1) then
    do !i from 1 to !this.selectedCway.size()
      if !!cbldflts.cwayzonedefault.set() then
        !!ce = !!cbldflts.cwayzonedefault
      endif
      NEW CWAY
      if !this.autonametoggle.val then
        !zone = zone
        !name = '/' & !!cblautoname('CWAY', !zone)
        name $!name
        handle ANY
        endhandle
      endif
      !this.newCreateCway.append(!!ce)
    enddo
   endif

  if !type.eq('PLANE') then

    if  !this.gplane.plane.unset() then
  	  !!alert.error('Plane not defined')
      return
    endif

    do !branch values !this.elemlist.rtext
      !splitPoints = object ARRAY()
      -- find the intersection points
      !col = object COLLECTION()
      !col.scope(object DBREF(!branch))
      !col.type('POINTR')
      !points = !col.results()

      -- construct lines
       do !i from 1 to (!points.size() - 1)
         !line = object LINE(!points[!i].position.wrt(worl), !points[!i + 1].position.wrt(worl))
         -- see if line intersects plane
         !intersectPoint = !this.gplane.plane.intersection(!line)
         handle (2,873)
           skip
         endhandle
         if !intersectPoint.unset() or !line.onprojected(!intersectPoint).not() then
           skip
         else
           !splitPoints.append(!intersectPoint)
         endif

       enddo

       if !splitPoints.set() then
       	 !firstBranch = !branch.dbref()
       	 !originalBranch = !firstBranch
         do !split values !splitPoints
         	 !value = FALSE
           if !this.movecomp.val.eq(2) then
             !!ce = !firstBranch
           else
             if !this.newCreateCway.findfirst(!firstBranch.owner).set() then
             	 --!!ce = !this.selectedCway[!this.newCreateCway.findfirst(!firstBranch.owner)]
             	 !!ce = !originalBranch
             else
               !!ce = !this.newCreateCway[!this.selectedCway.findfirst(!firstBranch.owner)]
             endif	
           endif
          if (not !!dbRefUpdatable(!firstBranch))then
						!!alert.error(!!error.text)
						skip
			  	endif
           new CWBRAN
           if !this.autonametoggle.val then
             !cway = CWAY
             !name = '/' & !!cblautoname('CWBRAN', !cway)
             name $!name
             handle ANY
             endhandle
           endif
           !newbran = !!ce
           !refPoint = !this.processNodes(!firstBranch, !split)
           !cableFound = !this.cablePassCheck(!refPoint, 'CWBRAN')
           if !cableFound then
    	     --check for MODATT pseudo attribute.
           do !item indices !this.cableArray
           		!targetCbl = !this.cableArray[!item]
           		$!targetCbl
           		!attr = MODATT
           		if !attr.not() then
           			!!alert.error ('Cannot split branch $!firstBranch.flnm as one or more cables passing on the branch are read-only')
           			!value = TRUE
           			break
           		endif
           enddo
           endif
         	 if !value then
         	 	skip
         	 endif
           !splitManager = object MDRCONNECTIONMANAGER()
           !splitManager.splitbranch(!firstBranch,!split,!newbran)
           !this.changeOpenDirection(!firstBranch,!newbran)
           !this.crateRnodes(!firstBranch,!newbran)
           !firstBranch = !newbran
           if !cableFound then
             !this.changeCableRouteInfo(!refPoint, !originalBranch, !newbran)
             !this.cableArray.clear()
           endif
           !originalBranch = !newbran
         enddo	
      else
        !!alert.warning('Not able to split because plane is not defined within the branch segment.')
        if(!this.movecomp.val.eq(1))then
        	!!ce = !this.newCreateCway[!this.selectedCway.findfirst(!branch.dbref().owner)]
        	DELETE CWAY
        endif
      endif

   enddo

  else
  	!branch = !this.elemlist.rtext[1].dbref()
  	$!branch
  	if (not !!dbRefUpdatable(!branch))then
			!!alert.error(!!error.text)
			return FALSE
		endif
  	!refPoint = !this.processNodes(!!ce, !this.pickedElementPos)
    !cableFound = !this.cablePassCheck(!refPoint, 'CWBRAN')
    if !cableFound then
    	--check for MODATT pseudo attribute.
    	do !item indices !this.cableArray
    		!targetCbl = !this.cableArray[!item]
    		$!targetCbl
    		!attrSet = MODATT
    		if !attrSet.not() then
    			!!alert.error('Cannot split branch $!branch.flnm as one or more cables passing on the branch are read-only')
    			return
    		endif
    	enddo
    endif
     if !this.movecomp.val.eq(1) then
      !!ce = !this.newCreateCway[1]
     else
      !!ce = !branch
     endif
     new CWBRAN
     if !this.autonametoggle.val then
       !cway = CWAY
       !name = '/' & !!cblautoname('CWBRAN', !cway)
       name $!name
       handle ANY
       endhandle
      endif

      !newbran = !!ce
      !splitManager = object MDRCONNECTIONMANAGER()
      !splitManager.splitbranch(!branch,!this.pickedElementPos,!newbran)
      !this.changeOpenDirection(!branch,!newbran)
      !this.crateRnodes(!branch,!newbran)

		  if (!this.cableArray.size() gt 0) then
	      !this.changeCableRouteInfo(!refPoint, !branch, !newbran)
	      !this.cableArray.clear()
    	endif
    handle ANY
    	!!alert.error(!!error.text)
    	if(!this.movecomp.val.eq(1))then
    		CWAY
    	  DELETE CWAY
    	else
    		DELETE CWBRAN
    	endif
    endhandle
    !this.clearAids()
		!this.clearList()
  endif



endmethod

------------------------------------------------------------------------
--
-- Method: Dismiss
--
-- Description: Dismiss form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.clearAids()
  axes off
  !this.clearList()
  !this.hide()

endmethod

--End of method definition

------------------------------------------------------------------------
--
-- Method: clearAids
--
-- Description: Creation of aid text and lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAids()

    aid clear all $!this.planeaidNumber
    handle ANY
    endhandle

    aid clear all $!this.pointaidnumber
     handle ANY
    endhandle

endmethod
------------------------------------------------------------------------
--
-- Method: poscntrl
--
-- Description: Initialise Position Control
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------


define method .poscntrl()

   -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
   !this.poscontrol       = object POSITIONCONTROL()



  -- Load ship grid data
  !grid                   = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xoffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yoffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zoffset[!i]
    enddo

    -- Set grid data
    !this.poscontrol.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialize as grid control and Specify tags
    --!this.poscontrol.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.poscontrol.heading('World Position')

  else
    !this.poscontrol.gridvisible(FALSE)

  endif

 var !coordinate coordinate
  if(!grid.xID.set() and (!coordinate.eq('XYZ'))) then
   !this.poscontrol.gridFormat()
  elseif(!coordinate.eq('XYZ')) then
   !this.poscontrol.xyzFormat()
  else
   !this.poscontrol.enuformat()
  endif

   !this.poscontrol.changeAction('!!cblsplitbranch.setPosition()')

      -- Add PMLNet control to PML frame
  !this.netsplitposframe.control  = !this.poscontrol.handle()


endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: validatePosition
--
-- Description: validates the position control gadget
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validatePosition()

  -- get position from control
  !pos = !this.getposfromcntrl(!this.poscontrol.xyz())

  --get the positions of segment
  !dbElement  = !!ce
  !!ce  = !this.point

  !firstPos = !!ce.position.wrt(worl)
  next
  !secondPos = !!ce.position.wrt(worl)
  !line = object LINE(!firstPos,!secondPos)
  --!!ce = !dbElement
  if !line.on(!pos).not() then
   !!alert.message('The entered position is not within the segment')

   if !this.pickedElementPos.set() then
      !this.setPoint()
   -- !this.poscontrol.forceXYZ(!this.pickedElementPos.east,!this.pickedElementPos.north,!this.pickedElementPos.up)
   endif
   return
  else
   !this.pickedElementPos = !this.getposfromcntrl(!this.poscontrol.xyz())
   !this.setPoint()
  endif


endmethod
