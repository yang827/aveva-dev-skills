--
--
-- Description:
-- Pipe component modification form for spec /Bore
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  chooseoption()                   -
--  getList(DBREF)                   -
--  getSpecComponents(COMPMODITEM)   ARRAY               get the available spec components
--  getSpecs()                       -
--  listData()                       -
--  setColumnData()                  ARRAY
--  setHeaders(ARRAY)                ARRAY
--  setup()                          -                   initialisation method
--  specSelection(COMPMODITEM)       BOOLEAN
--  specSelection(DBREF)             BOOLEAN
--

setup form !!chooseoption  resizeable blockingdialog

    !this.formTitle = 'CHOOSE OPTION'
    !this.callback  = '!this.setup()'

    paragraph .componentName text ' ' width 30
    path down

    option .abore 'Arrive Bore' call '!this.getList(!this.abore.selection().dbref())' width 8

    paragraph .lbore at xmax.abore+1 ymin.abore text ' ' width 20

    path down

    paragraph .currentSpec at xmin form text ' ' width 20


    frame .tabs tabset  anchor left + right + top + bottom   at xmin form  ymax

      -- Component Selection Frame
      frame .componentFrame     'Components'    anchor right + left + top at xmin ymin+1

        list .choices      callback || anchor all  at xmin+1 anchor right+left+top columns  width 40 hei 8

      exit
      -- End of Component Selection Frame

      -- Specification Selection Frame
      frame .specificationFrame 'Specs.'                 anchor right + left + top at xmin ymin

        list  .specList callback '!this.setup()'  at xmin.choices  anchor right+left+top width 40 lines 6

      exit
      -- End of Specification Selection Frame

    exit
    -- End of tab set

    button .ok '  OK  '      callback |!this.apply()| anchor left+bottom  at xmin ymax + 1

    path right

    button .cancel 'Cancel'  anchor right+bottom at xmax form - size ymin  cancel

    -- Form Members

    member .specComponents        is ARRAY
    member .fullDescription       is ARRAY
    member .description           is ARRAY
    member .material              is ARRAY
    member .componentObject       is COMPMODITEM
    member .current               is DBREF
    member .items                 is ARRAY
    member .bores                 is ARRAY
    member .newSpec               is DBREF
    member .heading               is ARRAY

exit
-- End of form definition
----------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseoption()

  -- collect form db and set the piping specs to the spec list
  !this.getSpecs()

  -- load form
  if( undefined(!!selectSpecification) ) then
     pml load form !!selectSpecification
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: initialisation method
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setup()


     !this.specComponents  = ARRAY()
     !this.fullDescription = ARRAY()
     !this.description     = ARRAY()
     !this.material        = ARRAY()

     !index = !!specBoreChange.compListGrid.getSelectedRowTags()
     if !index.unset() or !index.size() neq 1 then
        return error 2 'Select one component from the list'
     endif

     !componentObject = !!specBoreChange.components[!index[1].real()]

     !component       = !componentObject.component
     !this.componentObject = !componentObject

     --Display the current spec of the component
     !currentSpec = 'Current Spec: ' + !!specBoreChange.currentSpec.namn
     !this.currentSpec.val = !currentSpec

     -- Check if spec selection was successful
     if !componentObject.componentType.eq('TUBE').and(!componentObject.tubeLength.lt(2mm)) then
        !status = !this.specSelection(!componentObject)
     else
        !status = !this.specSelection(!component)
        handle ANY
        !status = FALSE
        endhandle
     endif
     -- Return and don't show form
     if (NOT !status) then
        return error noalert
     endif

     !this.componentName.val = !component.flnn
     handle any
       !this.componentName.val = 'The Spec of this component is Unset'
     endhandle

     -- display the abore of the selected element
     !arriveBore = !this.componentObject.abore.string()
     !this.abore.select('dtext', !arriveBore)

     if !this.componentObject.componentType.eq ('TEE') then
       !leaveBore = 'Original PBORE3: ' + !this.componentObject.lbore.string()
       !this.lbore.val = !leaveBore
     elseif !this.componentObject.abore neq !this.componentObject.lbore then
       !leaveBore = 'Original Leave Bore: ' + !this.componentObject.lbore.string()
       !this.lbore.val = !leaveBore
     else
       !leaveBore = ''
       !this.lbore.val = !leaveBore
     endif

     -- get available spco in the spec
     !specComponentRef = !this.getSpecComponents(!componentObject)
     if !specComponentRef.unset() then
        -- p1132 Clear the components gadget
        !this.choices.clear()
        return error 1 'No spec components available'
     endif
     !specCompBlock = object BLOCK('!specComponentRef[!evalIndex].flnm')
     !specComponents = !specComponentRef.evaluate(!specCompBlock)

     !this.specComponents = !specComponents

     !this.listData()

endmethod
-- End of method definition
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      setColumnData
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColumnData() is ARRAY

     !answer = ARRAY()
     do !m indices !this.specComponents

        !spco = !this.specComponents[!m].dbref()
        !ownList = !spco.ownlst
        !ownList.append(!spco)
        !list = !ownList.invert()

        do !n indices !list
            skip if !list[!n].type inset('SPWL','SPEC')
            --skip if !list[!n].owner.question inset ('TYPE')
            if !list[!n].owner.question inset ('PBOR') then
                !tanswer = !list[!n].answer.string()
            else
               !tanswer =   !list[!n].tanswer
               !maxans = STRING()
               if !tanswer eq '' then
                  !tanswer    = !list[!n].answer.string()
                  !maxans     = !list[!n].maxanswer.string()
               endif
               if !maxans.set() then
                !tanswer = !tanswer + ' - ' + !maxans
               endif
            endif
            !answer[!m][!n] = !tanswer
        enddo
       !answer[!m] = !answer[!m].invert()
     enddo

     !this.heading = !this.setHeaders(!ownList)
     return !answer


endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      listData
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .listData()

    !answers = !this.setColumnData()

    if !answers.unset() then
        return error
    endif

    do !m indices !answers

       !columns = !answers[!m]
       !specComponent = !this.specComponents[!m]

       !description   = !specComponent.dbref().dtxr
       handle ANY
           !description = 'unset'
       endhandle
       !this.description[!m] = !description

       !material      = !specComponent.dbref().mtxx
       handle ANY
           !material = 'unset'
       endhandle
       !this.material[!m] = !material

       !this.fullDescription[!m] = !description + ' ' + !material

       !columns.append(!specComponent)
       !columns.append(!description)
       !columns.append(!material)
       !rows[!m] = !columns

     enddo

     !this.choices.setRows(!rows)

    !this.choices.rtext = !this.specComponents

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getSpecComponents
--
-- Description: get the available spec components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpecComponents(!componentObject is COMPMODITEM) is ARRAY

     !boreQuestion = ARRAY()
     !boreAnswer = ARRAY()

     !componentBore = !componentObject.abore
     !index = !componentObject.answers.findFirst(!componentBore)
     handle (2,779)
       !componentBore = !componentObject.lbore
       !index = !componentObject.answers.findFirst(!componentBore)
     endhandle
     !boreQuestion[1] = !componentObject.questions[!index]
     !boreAnswer[1]   = !componentObject.answers[!index]

     if(!boreQuestion[1] eq 'PBOR0') then
        !boreQuestion[1] = 'PBOR1'
     endif

     !selectedSpec = !this.specList.selection()
     !spec = object DBREF('/$!selectedSpec')

     !this.newSpec = !spec

     !type = !componentObject.componentType

     !specification = object SPECIFICATION(!spec)

     if(!type eq 'TUBE') then
        !specification.setSpecification(!spec)
        if undefined(!!selectSpecification) then
           pml load form !!selectSpecification
        endif
        !!selectSpecification.loadTubeComponents(!specification,!spec)
     endif

     !unusedLoaded = !specification.loadTable(!type)

     do !table values !specification.tables
        if(!table.type eq !type) then
           !componentTable = !table
           break
        endif
     enddo

     !specComponents = !componentTable.components(!boreQuestion,!boreAnswer)

     handle ANY
     endhandle

     if(defined(!specComponents) and !specComponents.set()) then
        return !specComponents
     else
        !empty = ARRAY()
        return !empty
     endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

   -- do we want to apply the selected spec component to all other
   -- like instances of the selected component
   !choice = !!specBoreChange.updateallcomps.val

   !likeCompIndices = ARRAY()

   if !choice.eq(TRUE) then
     -- collect all like components
     !spref = !!specBoreChange.components[!!specBoreChange.compListGrid.getSelectedRowTags()[1].real()].spref
     !likeCompIndices.append(!!specBoreChange.compListGrid.getSelectedRowTags())

     -- now append any like references
     -- loop through the specBoreChange components array and identify any that
     -- have the same spref as !spref
     !values = object ARRAY()
     do !i from 1 to !!specBoreChange.components.size()
       if !i.neq(!!specBoreChange.compListGrid.getSelectedRowTags()[1].real()) then
         if !!specBoreChange.components[!i].spref.eq(!spref) then
           !values.clear()
           !values.append(!i.string())
           !likeCompIndices.append(!values)
         endif
       endif
     enddo
   else
     !likeCompIndices.append(!!specBoreChange.compListGrid.getSelectedRowTags())
   endif

   !componentObject = !this.componentObject

   !newSpref = !this.choices.selection()
   !selIndex = !this.choices.val
   !componentObject.newSpref = !newSpref
   !componentObject.newDescription = !this.fullDescription[!selIndex]

   do !i from 1 to !likeCompIndices.size()
     !value = !likeCompIndices[!i]
     !compDbref = !!specBoreChange.components[!value[1].real()].component
     !realCompDBref = !!specBoreChange.components[!value[1].real()].realComponent
     !designElement = !!specBoreChange.components[!value[1].real()].designElement
     !!specBoreChange.components[!value[1].real()] = !componentObject
     !!specBoreChange.components[!value[1].real()].component = !compDbref
     !!specBoreChange.components[!value[1].real()].realComponent = !realCompDBref
     !!specBoreChange.components[!value[1].real()].designElement = !designElement
     handle any
      !!alert.error('please select a row from list')
     endhandle
   enddo

   if !componentObject.tubeLength.eq(0) then
      !!ce = !componentObject.realComponent
   else
      !!ce = !componentObject.component
   endif

   !!specBoreChange.updateListData()

   !this.hide()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setHeaders
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHeaders(!list is ARRAY)is ARRAY
--!questions is ARRAY)

 !trimmedList = !list.invert().removefrom(3)
 !headings = ARRAY()

 do !a values !trimmedList
    !quest = !a.owner.question
    if !quest.match('PBOR').gt(0) then
      !qual = !a.owner.qualifier
      !quest = !quest & ' ' & !qual
    endif
    !headings.append(!quest)
 enddo


 !headings.append('Spec Component' )
 !headings.append('Description' )
 !headings.append('Material' )

 !this.choices.setheadings(!headings)
 return !headings

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getSpecs
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpecs()

     -- collecting available specification
      !pipeSpec = object SPECIFICATIONS()

      -- collect piping spec
      !pipeSpec.piping()
      !names        = !pipeSpec.names
      --!references   = !pipeSpec.references
      --!refStrings   = !pipeSpec.refStrings
      !this.specList.dtext = !names

      !currentSpec = !!specBoreChange.currentSpec.namn
      handle ANY
      elsehandle NONE
        !this.specList.select('DTEXT',!currentSpec)
      endhandle

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      specSelection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .specSelection(!current is DBREF) is BOOLEAN

--CW P-25646 handling limbospec reselection--
 !!ce = !current
 !this.current = !!ce
 !noSpecSet    = FALSE
 !limbospecSet = FALSE

 if !this.current.spref.owner.quest.eq('LIMB') then
 		!limbospecSet = TRUE
 	 !answer = !!alert.question('Component ' & !!ce.flnn & ' is in LIMBOSPEC.Do you wish to reselect from current spec?')
 	
 	 if !answer.eq('YES') then
 	 	--if spec does not contain chosen elements then return warning
 	   choose all
 	   handle (61,162)
 	   !!alert.warning('No spec components available ')
 	   endhandle
 	   return error 1 noalert
 	
 	 else
 	   return error 1 noalert
 	   handle ANY
 	  endhandle
 endif

 	!!specBoreChange.init()  	
 		
 else
     var !choice split choice
     handle ANY
     endhandle
 endif

 !spcom = !current.spref

 -- P-13341: If the has no spref set then set the !noSpecSet flag true
 !noSpecSet = FALSE
 if !spcom.unset().or(!spcom.badref()) then
   !noSpecSet = TRUE
 else
   !!ce = !spcom
 endif

 if !this.current.type.eq('TUBI') then
     !type = 'TUBE'
 else
     !type =  !this.current.type
 endif

if !limbospecSet or !noSpecSet then
	
   if !noSpecSet then
     --P-13341: 1.No Spref Set - Use the pspec of the branch or pipe if branch pspec unset to get the spec
     --of the unset component.
     !!ce = !current.owner.pspec
     handle any
       !!ce = !current.owner.owner.pspec
       handle any
         !!alert.error('Unable to load choose option form for this component')
         return FALSE
       endhandle
     endhandle
   else
     --P-11957: 1.LIMBOSPEC - Use the first part of the name of the spref and then use this to get an
     --effective spec for the component.
     !specName = !!ce.name.split('/')
     if !specName[1].eq('') then
       !specName.removeFirst()
     endif
     !specNameStr = '/' + !specName[1]
     !!ce = !specNameStr.dbref()
   endif

   !tanswer = !this.current.type
   var !bores coll all SELE with TANS eq !tanswer for ce
   handle ANY
     !!alert.message('Unable to load choose option form for this component')
   endhandle
 else
  --Normal operation for components not in LIMBOSPEC or with no spref.
   do
     -- go up one level in the hierarchy
     end

     -- Check that the spec for the component is not in LIMBOSPEC
     if !!ce.question.eq('LIMB') then
         !!alert.error('This item is in LIMBOSPEC and can not be changed by this option')
         return FALSE
     endif

     if !!ce.dDepth.eq(2) then
     -- we have gone too far up the tree and need to break
       !!alert.error('')
       break
     endif

     if !!ce.tanswer.eq(!type).and(!!ce.owner.type.eq('SPEC')) then
       var !bores COLL ALL SELE WITH QUESTION EQ 'PBOR' FOR CE
       break
     endif
   enddo
 endif

 if !bores.empty() then
   !!alert.error('Specification Error No suitable components found')
   return FALSE
 endif

 !!ce = !bores[1].dbref()
 !dDepth = !!ce.dDepth + 1

 var !elements COLL ALL SELE WITH DDEPTH EQ $!dDepth FOR CE

 !bores = ARRAY()
 do !a values !elements
    !bores.append(!a.dbref().answer.string())
 enddo


 !this.abore.dtext = !bores
 !this.abore.rtext = !elements

 return TRUE

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      specSelection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .specSelection(!current is COMPMODITEM) is BOOLEAN

 --Method same as above except for LSTU.

 !!ce = !current.realComponent
 !this.current = !!ce
 if !!ce.type.eq('BRAN') then
   var !choice split choice hstu
   handle any
   endhandle
    !spcom = !current.realComponent.hstu
 else
   var !choice split choice lstu
   handle any
   endhandle
   !spcom = !current.realComponent.lstu
 endif

 !noSpecSet = FALSE
 if !spcom.unset().or(!spcom.badref()) then
   !!alert.error('Cannot find Existing Specification component PSPE is unset or no HSTU')
   --
   !noSpecSet = TRUE
   return FALSE
 else
   !!ce = !spcom
 endif

 !type = 'TUBE'

 --P-11959 and P-13341
 if (!!ce.owner.name.eq('/*LIMBOSPEC') or !noSpecSet) then

   if !noSpecSet then
     --P-11959: LIMBOSPEC components
     !!ce = !current.realComponent.owner.pspec
     handle any
       !!ce = !current.realComponent.owner.owner.pspec
       handle any
         !!alert.error('Unable to load choose option form for this component')
         return FALSE
       endhandle
     endhandle
   else
    --P-13341: Components with no spref
     !specName = !!ce.name.split('/')
     if !specName[1].eq('') then
       !specName.removeFirst()
     endif
     !specNameStr = '/' + !specName[1]
     !!ce = !specNameStr.dbref()
   endif

   !tanswer = !this.current.type
   var !bores coll all SELE with TANS eq !tanswer for ce
   handle ANY
     !!alert.message('Unable to load choose option form for this component')
   endhandle
 else
  --Normal operation for components with spref.
   do
     -- go up one level in the hierarchy
     end

     -- Check that the spec for the component is not in LIMBOSPEC if it has error, but it should never get here.
     if !!ce.question.eq('LIMB') then
         !!alert.error('This item is in LIMBOSPEC and can not be changed by this option')
         return FALSE
     endif

     if !!ce.dDepth.eq(2) then
     -- we have gone too far up the tree and need to break
       !!alert.error('')
       break
     endif

     if !!ce.tanswer.eq(!type) then
       var !bores coll all sele with question eq 'PBOR' for ce
       break
     endif
   enddo
 endif

 !!ce = !bores[1].dbref()
 !dDepth = !!ce.dDepth + 1

 var !elements COLL ALL SELE WITH DDEPTH EQ $!dDepth FOR CE

 !bores = ARRAY()
 do !a values !elements
    !bores.append(!a.dbref().answer.string())
 enddo


 !this.abore.dtext = !bores
 !this.abore.rtext = !elements

 return TRUE

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getList
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getList(!selector is DBREF )

!answer = !selector.answer
!tanswer = !selector.owner.tanswer

!newSpec = !this.newSpec

var !a COLL ALL SELE WITH TANS EQ !tanswer FOR $!newSpec

!aElement = !a[1].dbref()

do !a values !aElement.members
  if (!answer eq !a.answer) then
    !newSelector = !a
    break
  endif
enddo

var !elements coll all spco for $!newSelector
handle any
  !!alert.error('Bore selection unavailable for current spec selection')
  return
endhandle


var !specComponent eval spco for all from !elements

!this.specComponents = !specComponent

!this.listData()

endmethod
-- End of method definition
------------------------------------------------------------------------
