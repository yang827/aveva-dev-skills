--
-- File:            civcreatelevel.pmlfrm
--   Type:          Form Definition
--   Group:         Wall and Floors Application

--     Keyword:     CIVIL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Thu Nov 5 16:23:39 GMT 1998
--
--
-- Description:
-- form to create a level as a stru
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  checkName()                      -                   Tidy form
--  civCreateLevel()                 -                   Constructor
--  dismiss()                        -                   Close form
--  edit(DBREF,DBREF,STRING)         -                   method to invoke the form
--  init()                           -                   initialise
--  preview()                        -                   Preview new elevation
--  tidy()                           -                   Tidy form
--
------------------------------------------------------------------------

setup form !!civCreateLevel

  !this.formTitle     = 'Create Level'
  !this.iconTitle     = 'CrLevl'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.9 $ '

 -- Name Option
  option   .autoName at xmin ymin width 8

 -- Element Name
  text .name at xmax ymin callback '!this.checkName()' width 20 is STRING

 -- Attribute Button
  button .attributes |Attributes...| callback '$m "%PDMSUI%/CLIB/QUERY/XATTFORM" $<_CDCATTDEF$>'
  -- Elevation
  text .elevation 'Elevation ' at xmin.autoName+3 ymax+0.5 callback '!this.preview()' width 14 is REAL format !!distanceFmt


 -- Bottom Line
  button .apply   |  OK  | at xmin form+0 ymax+0.5 callback |!this.apply()| ok
  button .dismiss |Cancel| at xmax form-size ymin  callback |!this.dismiss()| cancel

 -- Elevation plane
  member .plane     is PLANE

  -- Aid Numbers
  member .aidNumber is REAL

  -- store the new structure
  member .item is DBREF

  -- Current level reference
  member .levelRef      is DBREF

  -- wrt
  member .wrt is DBREF
  -- action on apply
  member .action is STRING

-- End of form definition for !!civCreateLevel
exit

-----------------------------------------------------------------------
--
-- Method:      civCreateLevel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .civCreateLevel()

 -- Initialise Variables
  !this.aidNumber  = !!aidNumbers.add('Elevations')

  -- Autoname option gadget

  !dText = ARRAY()
  !rText = ARRAY()


  !display = 'Name Autoname'
  !dText   = !display.split()
  !rText   = !display.split()

  !this.name.val       = 'unset'
  !this.autoName.dText = !dText
  !this.autoName.rText = !rText
  !this.elevation.val  = 0

endmethod
-- End of method definition for .civCreateLevel()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.name.val = 'unset'

    -- navigate to level if not already there.

       !!ce = !this.levelRef

    -- create stru ready for naming

    NEW STRU
    PURP LEVL
    !this.item = !!ce
    !this.plane.position    = !this.item.position.wrt(!this.wrt)
    !this.plane.orientation = !this.item.orientation.wrt(!this.wrt)


    -- Initialise Auto naming button
    !autoName = !!namOpt.auto()
    handle any
      return
    endhandle
    if (!autoName) then
      !this.autoName.val = 2
    else
      !this.autoName.val = 1
    endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: method to invoke the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [dbref to be wrt]
--   [2] [R]    [STRING]    [Action on apply related to the passed form]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!wrt is DBREF, !levelRef is DBREF, !action is STRING)

  !this.wrt       = !wrt
  !this.action    = !action
  !this.levelRef  = !levelRef

  show !!civCreateLevel

endmethod
-- End of method definition for .edit(DBREF, DBREF, STRING)

-----------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- goto item and set position level
     !!ce = !this.item
     AT U $!<this.elevation.val> WRT $!<this.wrt>

  -- name the level

     if(!this.autoName.val.eq(2)) then
        !name = !!namOpt.nameString(!this.item,'Industrial Buildings Structures Name', true ,false)
        !name = !!namToPdmsName(!name)
      else
        !name = !!namToPdmsName(!this.name.val)
      endif
     -- name the item

        NAME $!name
        handle any
          -- if unset don't name
        endhandle


  -- Carry out action
     $!<this.action>

  -- redo the lists on the form

   !this.tidy()

endmethod
-- End of method definition for .apply()
-----------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: dismiss button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !!ce = !this.item
  DELETE STRU
  !this.tidy()

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview new elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preview()

  -- Reference Position
  !this.plane.position.up = !this.elevation.val

  -- Display Axes
  !axes             = object GPHAXES(!this.plane.position, !this.plane.orientation)
  !axes.description = ' New Elevation ' & !this.elevation.val
  !axes.tag         = true
  !axes.detail      = true
  !axes.draw(!this.aidNumber)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName()

  -- set new name

  !name = !!checkName(!this.name.val,'NEW')

  !this.name.val = !name
endmethod
-- End of method definition for .checkName()


------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()
