-- File:            civelevation.pmlfrm
--   Type:          Form Definition
--   Group:         Wall and Floors Application
--     Keyword:     CIVIL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Sep 28 09:20:25 BST 1998
--
--
-- Description:
-- Set civil elevation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  civElevation()                   -                   Constructor
--  close()                          -                   Close form
--  edit(CIVLEVEL,DBREF,STRING)      -                   Show form
--  preview()                        -                   Preview new elevation
--  setElevation(EDGPICKDATA)        -                   Set elevation
--  tidy()                           -                   Tidy form
--
------------------------------------------------------------------------

setup form !!civElevation

  !!civElevation.formTitle     = 'Elevation'
  !!civElevation.iconTitle     = ''
  !!civElevation.callback      = ''
  !!civElevation.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Elevation
  text .elevation 'Elevation ' at xmin ymax callback '!this.preview()' width 14 is REAL format !!distanceFmt

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin      callback '!this.close()' cancel


  -- Form members

  -- Aid Numbers
  member .aidNumber is REAL

  -- Level element
  member .level     is CIVLEVEL

  -- Frame of reference for elevations
  member .wrt       is DBREF

  -- Action on completion
  member .action    is STRING

  -- Elevation plane
  member .plane     is PLANE


exit
-- End of form definition for !!civElevation

------------------------------------------------------------------------
--
-- Method:      civElevation
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .civElevation()

  -- Initialise Variables
  !this.aidNumber  = !!aidNumbers.add('Elevations')

endmethod
-- End of method definition for .civElevation()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables

  -- Put elevation in terms of elevation "up" wrt to levels owner
  !position  = !this.plane.position.wrt(!this.level.level().owner)
  !elevation = !position.up

  -- Assign new elevation to level
  !this.level.elevation(!elevation)

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  -- Close form
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables


  -- Remove event
  !!edgCntrl.remove('Civils Elevation')

  -- Hide aid graphics
  !this.tidy()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview new elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preview()

  -- Reference Position
  if (!this.elevation.val.unset() ) then
      !this.elevation.val = 0
  endif
  !this.plane.position.up = !this.elevation.val

  -- Display Axes
  !axes             = object GPHAXES(!this.plane.position, !this.plane.orientation)
  !axes.description = | New Elevation | & !this.elevation.val.string(!!distanceFmt)
  !axes.tag         = true
  !axes.detail      = true
  !axes.draw(!this.aidNumber)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setElevation
--
-- Description: Set elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Event pick to be converted into elevation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElevation(!pickData is EDGPICKDATA)

  -- Initialise Variables

  -- Derive point from vertices
  if(!pickData.vertexCount gt 0) then
    !position = !pickData.vertices[1]

  elseif (!pickData.lineCount gt 0) then
    !line     = object LINE(!pickData.lines[1], !pickData.lines[2])
    !position = !line.intersection(!pickData.pickLine)

  elseif (!pickData.facetCount gt 0) then
    -- Derived plane from picked plane
    !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
    -- Try 4th facet
    handle any
      !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
    endhandle

    !position = !plane.intersection(!pickData.pickLine)
  endif

  -- Set elevation
  !this.elevation.val     = !position.wrt(!this.wrt).up

  -- Display mew position
  !this.preview()

endmethod
-- End of method definition for .setElevation(EDGPICKDATA)


------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Show form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!level is CIVLEVEL, !wrt is DBREF, !action is STRING)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.definePosition('Define Elevation')
  !packet.action         = '!!civElevation.setElevation(!this.return[1])'
  !packet.close          = '!!civElevation.tidy()'
  !packet.key            = 'civElevation'
  !packet.description    = 'Civils Elevation'
  !packet.form           = !!civElevation
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'dbModify'
  !packet.pickPacket.stdAny('Pick graphics to derive elevation')
  !packet.pickPacket.picks[1].prompt         = STRING()
  !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
  !packet.pickPacket.picks[1].pick.stdGraphics()
  !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
  !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
  !packet.pickPacket.picks[1].pick.input[10] = /*
  !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'

  -- Add into EDG packet
  if(!!edgCntrl.add(!packet)) then
    !this.level          = !level
    !this.wrt            = !wrt
    !this.action         = !action
    !this.plane          = !this.level.plane(!this.wrt)
    !this.elevation.val  = !this.level.elevation(!this.wrt)
  endif

endmethod
-- End of method definition for .edit(CIVLEVEL, DBREF, STRING)
