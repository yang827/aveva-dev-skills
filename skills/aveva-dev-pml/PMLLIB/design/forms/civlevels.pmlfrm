--   Type:          Form Definition
--   Group:         Wall and Floors Application
--     Keyword:     CIVIL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Sep 25 14:26:22 BST 1998
--
--
-- Description:
-- Building "Structure" level creation form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addLevel(DBREF)                  -                   Add passed structure into the level list
--  areStoreSet()                    BOOLEAN             Tag current level
--  civLevels()                      -                   Constructor
--  close()                          -                   Close form
--  createLevel()                    -                   Create a new level (Stru) for civils
--  deleteLevel()                    -                   Give no message about the list being refreshed
--  elevation()                      -                   Modify Elevation
--  initialise()                     -                   Initialisation for form
--  level()                          CIVLEVEL            Return current level object
--  levels()                         ARRAY               Get all levels for current zone
--  makeLevel()                      -                   Flag current structure (within the relevant hierarchy) as a level
--  offset()                         -                   Offset from level
--  offset(REAL)                     -                   Offset from level
--  offsetUpdate()                   -                   Updates all relevant gadgets with current level offset data
--  refreshList()                    -                   Refresh list
--  refreshList(BOOLEAN)             -                   Refresh list
--  selectLevel()                    -                   Select level
--  setStore()                       -                   Modify Elevation
--  setWrt(STRING)                   -                   Setup with respect to
--  setup()                          -                   Setup form
--  setupForm()                      -                   Setup form
--  sort()                           -                   Sorts level list into elevation order, re-sets .level to new position in the sorted list
--  tag()                            -                   Tag current level
--  tidy()                           -                   Tidy form
--  unmakeLevel()                    -                   Un-Flag current structure as a level
--  updateElevation()                -                   Modify Elevation
--  updateList()                     -                   Update list
--  updateList(REAL)                 -                   Update list to passed index
--  wrt(STRING)                      -                   Setup with respect to
--
------------------------------------------------------------------------

setup form !!civLevels

  !!civLevels.formTitle     = 'Building Levels'
  !!civLevels.iconTitle     = 'Levels'
  !!civLevels.callback      = '!this.initialise()'
  !!civLevels.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

  -- Bar menu
  bar
  exit

  -- List of available levels
  list .levels 'Elevation    Level             ' at xmin ymax callback '!this.selectLevel()' width 42 lines 6
  path down
  vdist 0

  -- List setting
  list   .list 'Storage Areas' callback '!this.setStore()' width 42 length 4

  -- Offset applied to current level
  path   down
  halign right
  text .offset 'Offset ' callback '!this.offset()' width 14 is REAL format !!distanceFmt

  -- Form Members
  member .zone         is DBREF

  -- Array of levels for zone
  member .levelList    is ARRAY

  -- Current level pointer
  member .level        is REAL

    -- Current level reference
  member .levelRef     is DBREF

  -- Frame of reference for elevations
  member .wrt          is DBREF
  member .wrtType      is STRING

  -- Aid number
  member .aidNumber    is REAL

  -- Reference Plane
  member .plane        is PLANE

exit
-- End of form definition for !!civLevels

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .civLevels()

  -- Define Bar Menu
  !bar = !this.bar
  !bar.add('Control',  'controlMenu')
  !bar.add('Settings', 'settingsMenu')
  !bar.add('Create',   'createMenu')
  !bar.add('Modify',   'modifyMenu')
  !bar.add('Delete',   'deleteMenu')

  -- File menu
  !menu = !this.newMenu('controlMenu')
     !menu.add('callback', 'CE',            '!this.setup()')
     !menu.add('separator' )
     !menu.add('callback', 'Refresh List',  '!this.refreshList()')
     !menu.add('callback', 'Close',         '!this.close()')

  -- Create Menu
  !menu = !this.newMenu('settingsMenu')
    !menu.add('toggle', 'Unset storage area', '')
    !menu.add('MENU',   'Wrt',                'wrtMenu')

    -- Wrt menu
    !menu = !this.newMenu('wrtMenu')
       !menu.add('toggle', 'World',           '!this.wrt(''World'')')
       !menu.add('toggle', 'Site',            '!this.wrt(''Site'')')
       !menu.add('toggle', 'Zone',            '!this.wrt(''Zone'')')

  -- Settings Menu
  !menu = !this.newMenu('createMenu')
    !menu.add('callback', 'Level...',      '!this.createLevel()')

  -- Modify Menu
  !menu = !this.newMenu('modifyMenu')
    !menu.add('callback', 'Elevation...',  '!this.elevation()')
    !menu.add('separator' )
    !menu.add('menu', 'Purpose', 'purposeMenu')

  -- Delete Menu
  !menu = !this.newMenu('deleteMenu')
    !menu.add('callback', 'Level...',  '!this.deleteLevel()')

    -- Level Flag Menu
    !menu = !this.newMenu('purposeMenu')
      !menu.add('callback', 'Level', '!this.makeLevel()')
      !menu.add('callback', 'Unset', '!this.unmakeLevel()')

  -- Distance
  !menu = !this.newMenu('offsetMenu')
  !this.offset.setPopup(!this.offsetMenu)

  -- Callback on cancel
  !this.cancelCall = '!!civLevels.close()'

  -- Initialise Variables
  !this.aidNumber  = !!aidNumbers.add('Civil Elevations')
  !this.wrtType    = 'ZONE'
  !this.offset(0)

endmethod
-- End of method definition for .civLevels()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Check to see if there is already a zone set.
  if(!this.zone.unset() or badref(!this.zone)) then
    !this.setup()
  else
    -- Refresh the list in case units have changed
    !this.refreshList()
  endif

  -- Setup form
  !this.setupForm()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Tidy form
  !this.tidy()

  -- Remove form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove Aid Lines
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Get "ZONE"
  !zone = ZONE OF CE
  handle any
    !!alert.warning('Unable to access a ZONE, navigate to a zone.')
    return
  endhandle

  -- If zone is same as the current zone, then check if we want to reload the data
  if(!zone EQ !this.zone) then
    if(!!alert.confirm('Reload zone (' & !this.zone.flnn & ') levels?').boolean().not()) then
      return
    endif
  endif

  -- Initialise Variables
  !this.zone  = !zone
  !this.wrt   = object DBREF()

  -- Check if we can create/modify zone
  if(!!dbRefUpdatable(!this.zone)) then
    !this.bar.setActive('Create',true)
    !this.bar.setActive('Modify',true)
  else
    !this.bar.setActive('Create',false)
    !this.bar.setActive('Modify',false)
  endif

  -- Set wrt
  !this.setWrt(!this.wrtType)

  -- Update List level
  !this.updateList()

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupForm()

  -- Initialise Variables
  !this.levelRef = object DBREF()

  -- Defined Levels
  if(!this.levelList.empty()) then
    !this.level      = 0
    !active          = false

  else
    if(!this.level eq 0 or !this.level gt !this.levelList.size()) then
      !this.level    = 1
    endif
    !active          = true

    if (!this.levels.dText.size() ge !this.level) then
      !this.levels.val = !this.level
    endif
  endif

  -- Grey in/out gadgets
  !this.modifyMenu.setActive('Elevation...', !active)
  !this.modifyMenu.setActive('Purpose',      true)
  !this.settingsMenu.setActive('Wrt',        !active)
  !this.offset.active       = !active

  -- Tag position
  if(!active) then
    !this.selectLevel()
    !this.levelRef   = !this.levelList[!this.level].level()

  -- Hide Tag
  else
    !this.tidy()
  endif


endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      wrt
--
-- Description: Setup with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      With respect to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wrt(!wrt is STRING)

  -- Set with respect to
  !this.setWrt(!wrt)

  -- Update list
  !this.refreshList()

endmethod
-- End of method definition for .wrt(STRING)

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Setup with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      With respect to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt(!wrt is STRING)

  -- Set with respect to
  !this.wrt    = $!<wrt> of $!<this.zone>
  !this.wrtType = !this.wrt.fullType

  -- Handle toggles
  if(!this.wrtType eq 'SITE') then
    !this.wrtMenu.select('World', false)
    !this.wrtMenu.select('Site',  true)
    !this.wrtMenu.select('Zone',  false)
  elseif (!this.wrtType eq 'ZONE') then
    !this.wrtMenu.select('World', false)
    !this.wrtMenu.select('Site',  false)
    !this.wrtMenu.select('Zone',  true)
  else
    !this.wrtMenu.select('World', true)
    !this.wrtMenu.select('Site',  false)
    !this.wrtMenu.select('Zone',  false)
  endif

endmethod
-- End of method definition for .setWrt(STRING)

------------------------------------------------------------------------
--
-- Method:      updateList
--
-- Description: Update list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateList()

  -- Update to first item in the list
  !this.updateList(0)

endmethod
-- End of method definition for .updateList()

------------------------------------------------------------------------
--
-- Method:      updateList
--
-- Description: Update list to passed index
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index to set level to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateList(!index is REAL)

  -- Empty current level list
  !this.levelList.clear()

  -- Get Available Levels for current zone
  !this.levelList = !this.levels()

  -- Current selected level
  !this.level     = !index

  -- Refresh List
  !this.refreshList()

endmethod
-- End of method definition for .updateList(REAL)

------------------------------------------------------------------------
--
-- Method:      refreshList
--
-- Description: Refresh list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      BOOLEAN     Is a message required?
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshList(!message is BOOLEAN)

  -- Initialise Variables
  !this.levels.clear()

  -- Return if there are no levels
  if(!this.levelList.empty().not()) then

    -- Loop through level list
    do !i indices !this.levelList

      !elevations[!i] = !this.levelList[!i].elevation(!this.wrt).string(!!distanceFmt)
      handle any
        -- level stru could have been deleted since
        skip
      endhandle
      !names[!i]      = !this.levelList[!i].level().flnn

    enddo

    -- Max width (bit to satisfy CSI)
    !width           = !elevations.width()
    if(!width.lt(9)) then
      !width = 9
    endif

    -- Loop through levels
    do !i indices !elevations
      var !dprt COMPOSE  |$!elevations[$!i]| WIDTH $!width R SPACE 5 |$!names[$!i]|
      !dText[!i] = !dprt[1]
      !rText[!i] = !i.string()
    enddo

    -- Populate Gadget
    !this.levels.dText = !dText
    !this.levels.rText = !rText

    -- realign title (CSI picking faults)
    var !tag COMPOSE 'Elevation' WIDTH $!width SPACE 6 'Level'
    !this.levels.tag = '$!tag[1]'

  endif

  -- Setup form
  !this.setupForm()

  -- Give message or not
  if (!message) then
    !!alert.message(|The 'Level List' has been refreshed because the chosen Level had been deleted.|)
  endif

endmethod
-- End of method definition for .refreshList(BOOLEAN)
------------------------------------------------------------------------
--
-- Method:      refreshList
--
-- Description: Give no message about the list being refreshed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshList()

  !this.refreshList(false)

endmethod
-- End of method definition for .refreshList()
------------------------------------------------------------------------
--
-- Method:      deleteLevel
--
-- Description: Give no message about the list being refreshed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteLevel()

  -- Record current element
  !memory = !!ce

  -- Check to see if element exists
  !!ce = !this.levelList[!this.levels.val].level
  handle any
    !this.levelList.remove(!this.level)
    !this.list.clear()
    !this.refreshList(true)
    return
  endhandle

  -- Delete it if we can
  if (!!dbRefUpdate(!!ce)) then
    if (!!alert.confirm('Ok to delete ' & !!ce.flnm ) eq 'YES') then
      -- Maintain the civil levels lists by removing this one
      !this.unmakeLevel()
      UNLOCK ALL
      !this.list.clear()
      DELETE STRU
    endif
  else
    -- Why could we not update this element
    !!alert.warning(!!error.text)
  endif

  -- Navigate back to initial element
  !!ce = !memory
  handle any
    -- could have been the one we have just deleted
  endhandle

  !this.refreshList(false)

endmethod
-- End of method definition for .deleteLevel()

------------------------------------------------------------------------
--
-- Method:      levels
--
-- Description: Get all levels for current zone
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of structures flagged as "levels"
--
------------------------------------------------------------------------

define method .levels() is ARRAY

  -- Initialise Variables
  !return     = ARRAY()
  !elevations = ARRAY()

  -- Define default civil level object
  !level = object CIVLEVEL()
  !level.storeGroup('WANDF')

  -- Collect all Structures flagged as a level beneath zone
  -- Using collection, as it will allow up to scan from difference places
  -- within the hierarchy if required.
  var !structures COLLECT ALL STRU WITH (PURPOSE eq 'LEVL') FOR $!<this.zone>

  -- Loop through all zone members
  do !i indices !structures

    -- Use default level object
    !newLevel  = !level
    !newLevel.level(!structures[!i].dbRef())

    -- Append to return array
    !elevations.append(!newLevel.level.position.up)
    !return.append(!newLevel)

  enddo

  -- Sort elevations into order
  !sort = !elevations.sortedIndices()
  !return.reIndex(!sort)

  -- Return
  return !return

endmethod
-- End of method definition for .levels() ARRAY

------------------------------------------------------------------------
--
-- Method:      selectLevel
--
-- Description: Select level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectLevel()

  -- Initialise Variables
  !level         = !this.levels.selection().real()

  -- If level is same as current level, don't do anything
  if(!level eq !this.level and !this.levelRef.set()) then
    !!ce         = !this.levelRef
    handle any
      !this.levelList.remove(!this.level)
      !this.refreshList(true)
      return
    endhandle
    return
  endif

  -- Set level pointer
  !this.level    = !level

  -- Handle unset or zero level selection
  if(!this.level.unset()) then
    !this.level = 0
    return

  -- Check there is a "level" defined
  elseif (!this.level eq 0) then
    return
  endif

  -- Set level reference
  !this.levelRef = !this.level().level()

  -- Check for invalid level reference
  if(!this.levelRef.badRef()) then
    !this.levelList.remove(!this.level)
    !this.refreshList(true)
    return
  endif

  -- Check if we can modify level
  if(!!dbRefUpdatable(!this.levelRef)) then
    !this.bar.setActive('Modify', true)
  else
    !this.bar.setActive('Modify', false)
  endif

  -- Navigate to
  !!ce          = !this.levelRef

  -- Set storage areas
  !this.levelList[!this.levels.selection().real()].setStorageAreas()

  -- Load displayed storage areas
  !this.levelList[!this.levels.selection().real()].storeDisplay(!this.list)

  -- Set offset
  !this.offset(!this.level().offset)



endmethod
-- End of method definition for .selectLevel()

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset from level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset()

   if (!this.offset.val.unset() ) then
       !this.offset.val = 0
   endif
  -- Offset plane
  if(!this.levelList[!this.level].offset(!this.offset.val)) then

    -- Set plane to level plane
    !this.plane = !this.levelList[!this.level].plane()

    -- Update currently defined plane with the new elevation
    if(!!edgPosCntrl.planeDefined()) then

      -- Get working plane
      !plane         = !!edgPosCntrl.getPlane()

      -- Redefine plane position onto new plane
      !planePosition = !plane.position()
      !position      = !this.plane.near(!planePosition)

      !plane.position(!position)

    -- Define a basic plane
    else
      !plane = object GPHPLANE(!this.plane)
    endif

    --Make defined working plane/grid active
    !!edgPosCntrl.activePlane(!plane)

    -- Update offset list with level offsets
    !this.offsetUpdate()

  endif

endmethod
-- End of method definition for .offset()

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset from level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset distance
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!offset is REAL)

  -- Set offset
  !this.offset.val = !offset

  -- Update graphics, etc
  if(!this.level.set()) then
    !this.offset()
  endif

endmethod
-- End of method definition for .offset(REAL)

------------------------------------------------------------------------
--
-- Method:      offsetUpdate
--
-- Description: Updates all relevant gadgets with current level offset data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetUpdate()

  -- Initialise Variables
  -- Maintain offset list
  !this.offsetMenu.clear()

  -- Write current offset to offset gadget
  !this.offset.val = !this.levelList[!this.level].offset()

  -- Offset data
  !offsets         = !this.levelList[!this.level].offsets()

  -- Build offset menu
  do !i indices !offsets
    !this.offsetMenu.add('CALLBACK', !offsets[!i].string(!!distanceFmt),  '!!civLevels.offset(' & !offsets[!i] & ')')
  enddo

  -- Tag current level
  !this.tag()

endmethod
-- End of method definition for .offsetUpdate()

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag current level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tag()

  -- Display Axes
  !axes             = object GPHAXES(!this.plane.position, !this.plane.orientation)
  !axes.description = ' ' & !this.plane.position.wrt(!this.wrt).up.string(!!distanceFmt)
  !axes.tag         = true
  !axes.detail      = true
  !axes.draw(!this.aidNumber)

endmethod
-- End of method definition for .tag()

------------------------------------------------------------------------
--
-- Method:      areStoreSet
--
-- Description: Tag current level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [BOOLEAN]   [Return true any of the storage areas are set.]
--
------------------------------------------------------------------------

define method .areStoreSet() is BOOLEAN

  !levelList = !this.levelList

  do !index values !levelList
    if(!index.stores.unset().not()) then
      return true
    else
      return false
    endif
  enddo

  return false

endmethod
-- End of method definition for .areStoreSet() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Modify Elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation()

  -- Check elevation form exists
  if(undefined(!!civElevation)) then
    pml load form !!civElevation
  endif

  -- Check to see if element exists
  !!ce = !this.levelList[!this.levels.val].level
  handle any
    !this.levelList.remove(!this.level)
    !this.refreshList(true)
    return
  endhandle

  -- Show form
  !!civElevation.edit(!this.levelList[!this.level], !this.wrt, '!!civLevels.updateElevation()')

endmethod
-- End of method definition for .elevation()

------------------------------------------------------------------------
--
-- Method:      updateElevation
--
-- Description: Modify Elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElevation()

  -- Sort list
  !this.sort()
  !this.refreshList()

endmethod
-- End of method definition for .updateElevation()

------------------------------------------------------------------------
--
-- Method:      setStore
--
-- Description: Modify Elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStore()

  -- get level from level list
  !store      = !!ce
  !storeIndex = !this.list.selection().real()
  !setArea    = !this.settingsMenu.selected('Unset storage area').not()

  -- get owners of selected CE
  !owners     = !store.ownLst

  -- check whether CE is owned by current level
  if(!setArea) then
    if(!owners.findFirst(!this.levelRef).unset()) then
      !!alert.warning('The current element should be a FRMW or SBFR owned by the selected level')
      return
    endif
    -- Restricted storage using compound floors screeds walls - 1 2 3
    if (!store.type eq 'CWALL' and !storeIndex neq 3) then
      !!alert.warning('A compound wall cannot be a storage area for floors or screeds.')
      return
    elseif (!store.type eq 'CFLOOR' and !storeIndex eq 3) then
      !!alert.warning('A compound floor cannot be a storage area for walls.')
      return
    elseif (!store.type eq 'CSCREE' and !storeIndex neq 2) then
      !!alert.warning('A compound screed cannot be a storage area for walls or floors.')
      return
    endif
  endif

  -- Set current selected storage area
  if (!this.levelList.unset()) then
    --!!alert.warning('There are no Building Levels')
    return
  endif
  !this.levelList[!this.level].setStore(!storeIndex, !setArea, !!ce)

  -- Load displayed storage areas
  !this.levelList[!this.levels.selection().real()].storeDisplay(!this.list)

  -- Re-select the store
  !this.list.select('RTEXT', !storeIndex.string())

endmethod
-- End of method definition for .setStore()

------------------------------------------------------------------------
--
-- Method:      createLevel
--
-- Description: Create a new level (Stru) for civils
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createLevel()

  -- Initialise Variables
  !reference = !!ce

  -- Build civil elevation form if it has not already been built
  if(undefined(!!civCreateLevel)) then
    pml load form !!civCreateLevel
  endif

  -- It there is no zone defined, then initialise form
  if(!this.zone.unset() or !this.zone.badRef()) then
    !this.setup()
  endif

  if(!this.zone.set()) then
    -- Check we have read/write access to the zone
    if(!!dbRefUpdate(!this.zone).not()) then
      !!alert.warning(!!error.text)
      return
    endif

    -- Move to zone
    !!ce = !this.zone

    -- Define action on apply of level creation form
    !action = '!!civLevels.addLevel(!!ce)'

    -- Show form
    !!civCreateLevel.edit(!this.wrt, !this.zone, !action)
  endif

endmethod
-- End of method definition for .createLevel()

------------------------------------------------------------------------
--
-- Method:      addLevel
--
-- Description: Add passed structure into the level list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Add structure to list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addLevel(!structure is DBREF)

  -- Initialise Variables

  -- Add new entry to list
  !newLevel       = object CIVLEVEL(!structure)
  !newLevel.storeGroup('WANDF')

  !this.levelList.append(!newLevel)

  -- Point to new level
  !this.level     = !this.levelList.size()
  !this.levelRef  = !newLevel.level()

  -- Sort into elevations
  !this.sort()

  -- Update
  !this.refreshList()

endmethod
-- End of method definition for .addLevel(DBREF)

------------------------------------------------------------------------
--
-- Method:      makeLevel
--
-- Description: Flag current structure (within the relevant hierarchy) as a level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .makeLevel()

  -- Initialise Variables
  !reference = !!ce

  -- Get owning structure
  !structure = STRUCTURE
  handle any
    !!alert.warning('Unable to access a structure from this level.')
    return
  endhandle

  -- Check that owner of zone is the current zone
  if(!structure.owner ne !this.zone) then
    !!alert.warning('Current element is not owned by the current level zone (' & !this.zone.flnn & ').')
    return
  endif

  -- Check if the structure is already flagged as a level
  if(!structure.purpose eq 'LEVL') then
    !!alert.warning('Structure (' & !structure.flnn & ') is already flagged as a level.')
    return
  endif

  -- Check if purpose has already been set to something else
  if(!structure.purpose.set() and !structure.purpose.empty().not()) then
    if(!!alert.confirm('Structure (' & !structure.flnn & ') has the purpose set to "' & !structure.purpose & '", OK to replace?').boolean().not()) then
      return
    endif
  endif

  -- Set purpose
  !!ce = !structure
  PURPOSE LEVL

  -- Add current structure into the list
  !this.addLevel(!structure)

  -- Return to original item
  !!ce = !reference

endmethod
-- End of method definition for .makeLevel()

------------------------------------------------------------------------
--
-- Method:      unmakeLevel
--
-- Description: Un-Flag current structure as a level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unmakeLevel()

  -- Initialise Variables
  !reference = !!ce

  -- Current Level
  !structure = !this.levelList[!this.level].level

  !!ce       = !structure
  handle any
    !this.levelList.remove(!this.level)
    !this.refreshList(true)
    return
  endhandle

  PURPOSE UNSET
  handle any
  elsehandle none

    -- Remove level
    !this.levelList.remove(!this.level)
    !this.level    = 1
    if (!this.levelList.size() gt 0) then
      !this.levelRef = !this.levelList[!this.level].level()
    endif

    !this.refreshList()
  endhandle

  -- Return to original item
  !!ce = !reference

endmethod
-- End of method definition for .unmakeLevel()

------------------------------------------------------------------------
--
-- Method:      level
--
-- Description: Return current level object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .level() is CIVLEVEL

  return !this.levelList[!this.levels.selection().real()]

endmethod
-- End of method definition for .level() CIVLEVEL

------------------------------------------------------------------------
--
-- Method:      sort
--
-- Description: Sorts level list into elevation order, re-sets .level to new position in the sorted list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sort()

  -- Initialise Variables
  !level      = !this.level

  -- Determine the best place to insert in the list
  do !i indices !this.levelList
    !elevations[!i] = !this.levelList[!i].elevation(World)
     handle any
       -- level stru could have been deleted since
       skip
     endhandle
  enddo

  -- Sort elevations into order
  !sort       = !elevations.sortedIndices()
  !this.levelList.reIndex(!sort)

  -- Get new entries position in the list
  !this.level = !sort.findFirst(!level)

endmethod
-- End of method definition for .sort()
