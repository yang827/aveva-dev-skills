-- Define form
setup form !!civStorageAreas

  !!civStorageAreas.formTitle     = 'Storage Areas'
  !!civStorageAreas.iconTitle     = 'Storage Areas'
  !!civStorageAreas.callback      = ''
  !!civStorageAreas.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  path down

  -- List setting
  list   .list 'Storage Areas' width 50 length 4

exit

-- End of form definition for !!civStorageAreas

if (undefined(!!storageAreas)) then
  pml load form !!storageAreas
endif

-- Link gadgets to group storage
call !!storageForGroup(!!civStorageAreas.list, 'WANDF','NOCHECK')

-- Load gadgets
call !!storageAreasDisp()
