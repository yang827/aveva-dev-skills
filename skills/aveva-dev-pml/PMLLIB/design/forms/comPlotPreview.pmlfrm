--    Module:        design
--  Author:          Daniel(Jaehun.Choi)
--  Created:         23 July 2010
--
--  Description:     preview plot file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comPlotPreview()                 -                   constructor
--  showPlot(STRING)                 -                   show plot file
--

------------------------------------------------------------------------
-- define form
setup form !!comPlotPreview document
  !this.formTitle     = 'Plot Preview'

  -- define popup
  menu .viewPopup
    add |Background Colour...| |!!colourSelectLoad('!!comPlotPreview.plot.background = !!colourSelectGet()', 'Background Colour', !!comPlotPreview.plot.background)|
  exit

  -- define plot view
  view .plot at x0 ymax+0.2 plot
    height 14
    borders on
  exit
exit
-- End of form definition for !!comPlotPreview

------------------------------------------------------------------------
--
-- Method:      comPlotPreview
--
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comPlotPreview()
  !this.plot.setPopup(!this.viewPopup)
  !this.plot.background = 'black'
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: show plot file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     plot file path
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPlot(!plotFile is STRING)
  !this.plot.clear()
  !this.plot.add(!plotFile)
  handle any
  endhandle
endmethod
-- End of method
