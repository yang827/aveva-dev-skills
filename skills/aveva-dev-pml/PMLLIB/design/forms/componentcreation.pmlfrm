-- File:            componentcreation.pmlfrm
--   Type:          Form Definition
--   Group:         Piping Application
--
--     Keyword:     PIPING
--   Module:        design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Fri Sept 26 12:00:00 GMT 2003
--
--
-- Description:
-- Pipe component creation form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjacent()                       -                   Set the adjacent elements for the component
--  adjacent(DBREF,BOOLEAN)          ARRAY               Set the adjacent elements for the component
--  adjacentBores(DBREF,BOOLEAN)     ARRAY               Returns the adjacent bores to the passed component, dependent
--  adjacentClear()                  -                   Clear the adjacent component list
--  adjacentDirection(DBREF,BOOLEAN) DIRECTION           Returns the adjacent direction to the passed component
--  adjacentPosition(DBREF,BOOLEAN)  POSITION            Returns the adjacent position to the passed component
--  adjacentSelect()                 -                   Select different specRef for component type in adjacent created components
--  adjacentType()                   -                   Setup form for selected type
--  angleGadgets(STRING)             ARRAY               Returns the angle used for setting the radius of the passed
--  arriveLeave(REAL,REAL)           -                   Switch Tee Arrive/Leave
--  arriveLeaveGadgets(STRING)       ARRAY               Returns the gadget used for setting the arrive/leave of
--  arriveLeaveSetup(STRING)         -                   The Arrive/Leave information for the current component
--  assemblyVisibility(BOOLEAN)      -                   Sets component attributes to from specification
--  boreGadget(STRING)               GADGET              Returns the gadget used for setting the bore of the passed
--  boreIndices(STRING)              ARRAY               Returns the current component types bore indices
--  calculateRadius(REAL)            -                   Calculates radius of a bend using N*OD option
--  changeAngle()                    -                   Change angle for Component
--  checkAlignment(LINE,POSITION)    REAL                test to see if a given position lies on a line between two positions
--  checkComponents()                BOOLEAN             check to see if items have different arrive and leavebores
--  choices(BORE)                    ARRAY               Get the choices for the current selection
--  close()                          -                   Close form
--  componentColumns(ARRAY)          ARRAY               Returns list component information columns for the choice list
--  componentCreation()              -                   Constructor
--  componentDirection(DBREF,BOOLEAN) DIRECTION           Returns the direction to the passed component
--  componentGadgets(BOOLEAN)        -                   Shows/Hides the gadgets associated with the create task
--  componentIndex(STRING)           REAL                Return component index for passed type
--  componentObject(STRING)          ANY                 Return component object for passed type
--  componentPosition(DBREF,BOOLEAN) POSITION            Returns the position of the passed component
--  componentRadius()                -                   Return radius for component
--  connect(ARRAY)                   BOOLEAN             Connects the passed components to the previous item
--  connect(ARRAY,BOOLEAN)           BOOLEAN             Connects the passed components to the from up or down stream item
--  connect(DBREF)                   BOOLEAN             Tries to connect passed component to previous item,
--  connect(DBREF,ARRAY)             BOOLEAN             Connects the passed components about the passed component
--  connectAdjacent(DBREF,ARRAY,DBREF) ARRAY               Creates and connects adjacent components for both side
--  connectionChoices(DBREF,DBREF,BOOLEAN) ARRAY
--  control(STRING)                  -                   Control
--  create(BOOLEAN)                  BOOLEAN             Create component
--  create3DPosition()               -                   Instigate an EDG event to position the components
--  create3DPosition(ARRAY)          -                   instigate creation based on a passed 3D pick
--  createAdjacent(DBREF,ARRAY,DBREF) ARRAY               Creates the adjacent items on both sides of the passed item
--  createAdjacent(DBREF,ARRAY,DBREF,BOOLEAN) ARRAY               Creates the first adjacent item to the passed component
--  createAtPosition()               -                   Instigate an EDG event to position the components
--  createAtPosition(ANY,BOOLEAN)    -                   Create component
--  createConnected(DBREF,STRING,DBREF,BOOLEAN) DBREF               Creates the passed element type and connects to the passed
--  createFirstConnected(DBREF,STRING,DBREF,BOOLEAN) DBREF               Creates the first adjacent item to the passed component
--  defaultSettings()                -                   Default Settings
--  displayAssembly()                -                   Sets component attributes to from specification
--  displayChoices()                 -                   Display the currently available components
--  displayMinTubeLength()           -                   Set the minimum tube length gadget from current data
--  displayOption(STRING)            -                   Set display option
--  displaySnapDistance()            -                   Set the snap distance gadget from current data
--  displayTubes(DBREF)              -                   Called to display the lstu gadget and call functions
--  exitModifyMode()                 -                   Exit modify mode and return to creation mode
--  filterComponents()               -                   Filter components using current filter settings
--  filterSubType(STRING)            -                   Select sType for Components
--  findNearest(ARRAY)               -                   find the nearest component to the atta position and reorder it
--  findWallVal(BORE,DBREF)          -
--  flip()                           -                   Flip current created components
--  flow(BOOLEAN)                    -                   Set creation flow for component (forwards/backwards)
--  frameIndex(STRING)               REAL                Return frame index for passed type
--  getAlternateWall(DBREF)          REAL                gets the arrive or leave tube wall thickness for PTAPS
--  getBranch(DBREF)                 DBREF               Returns branch from passed element
--  getMinTubeLengthDataCon()        -                   Set the minimum tube length for the component creation from the datacon tolerances
--  getMinTubeLengthForBore(DBREF,BOOLEAN) REAL                Get the minimum tube length required from the bore of the component set from the datacon tolerances
--  getPickedPosition(DBREF,POSITION,REAL,ANY) -                   sets !this.pickedPosition
--  getSpecomWall(DBREF)             -
--  getVectorPositions(DBREF)        POINTVECTOR         gets the position and direction of the next point
--  graphicSelection()               -                   Define graphic selection of current components
--  initialiseCreation()             -                   Initialise the relevant variables, gadgets, etc. for creation
--  initialiseFrame(STRING)          BOOLEAN             Initialise for Frame for a component
--  isValidBranch(ARRAY)             BOOLEAN             Check validity of branch before we continue
--  limits(DBREF)                    -
--  loadChoices()                    -                   Load the choices for the current selection
--  loadComponents()                 -                   Load component choice
--  loadTubes(GADGET,BORE,DBREF)     REAL
--  machineTest(DBREF)               REAL
--  minTubeLength()                  -                   Set the minimum tube length for the component creation
--  minTubeLength(DBREF)             REAL                Set the minimum tube length for the component creation
--  minTubeLength(DBREF,BOOLEAN)     REAL                Set the minimum tube length for the component creation
--  minTubeLength(DBREF,BOOLEAN,STRING) REAL                Set the minimum tube length for the component creation
--  modifyGadgets(BOOLEAN)           -                   Shows/Hides the gadgets associated with the modify task
--  modifyMode()                     -                   Reinstates the model editor mode if was previously active
--  objectIndex(STRING)              REAL                Return object index for passed type
--  optionGadgets(BOOLEAN)           -                   Shows/Hides the gadgets associated with the set option task
--  orderComponents(ARRAY)           ARRAY               Orders the passed components into their hierarchy sequence
--  pipeSpecification()              -                   Revert to pipe specification
--  processMultiple(ARRAY)           -                   reorder multiple attas after a component
--  radiusGadgets(STRING)            ARRAY               Returns the gadget used for setting the radius of the passed
--  readOptions()                    -                   Write options to users file
--  registerAngle(STRING,GADGET,GADGET,GADGET) -                   Setup angle gadgets for passed element type
--  registerArriveLeave(STRING,REAL,REAL,GADGET) -                   Setup arrive and leave gadgets for passed element type.
--  registerBore(STRING,GADGET)      -                   Setup bore gadgets for passed element type
--  registerComponent(STRING,GADGET,ANY) REAL                Register Data Frame
--  registerRadius(STRING,GADGET,GADGET) -                   Setup radius gadgets for passed element type
--  reorder(DBREF,DBREF)             -
--  reselectAdjacent()               BOOLEAN             Setup form for reselection of adjacent
--  resumeTask()                     -                   Revert to current task after a warning
--  reviseTube(DBREF,BORE,DBREF)     DBREF
--  selectAlternativeSpec()          -                   Select alternative specification
--  selectAlternativeSpec(DBREF)     -                   Select alternative specification
--  selectBore(GADGET,STRING)        -                   Select a check bore for the component type
--  selectChoice()                   -                   Select the current choice and setup other gadgets
--  selectRadius()                   -                   Select radius option
--  selectRadius(STRING)             -                   Select radius option for supplied type
--  setAlternativeSpec()             -                   Use alternative specification
--  setBendGadgetExtra(STRING)       -
--  setBranch(DBREF)                 -                   Setup form for current branch
--  setCheckBore()                   -                   Sets the check bore for the current component type
--  setFlangeAllowance(DBREF)        -                   Called to test if a radius can be machine defined
--  setFlow(BOOLEAN)                 -                   Set creation flow
--  setOffLineFlag(DBREF)            -
--  setOption(STRING)                -                   Set creation of adjacent components
--  setSpecAttributes(DBREF)         -                   Sets component attributes to from specification
--  setSpecification()               -                   Set the active specification
--  setTask(STRING)                  -                   Switch the relevant panels in and out for passed task
--  setup()                          -                   Setup form on show for current element
--  setupOptions()                   -                   Setup options frame to current settings
--  setupSpecifications()            -                   Setup Specifications
--  showEDG()                        -                   called as the continuation to the 3D position pick packet
--  skipConnected()                  -                   Set skip connected flag
--  snapDistance()                   -                   Set the snap distance
--  snapDistance(DBREF)              REAL                Set the snap distance for the component creation
--  sortAttas(ARRAY,ARRAY,ARRAY)     -                   given a set of inline attas we need to work out which ones are in order
--  specGadgets(BOOLEAN)             -                   Shows/Hides the gadgets associated with the spec task
--  specificationIndex(DBREF)        REAL                Returns the specification index of the form for the
--  systemDefaults()                 -                   Revert to system defaults
--  tag()                            -                   Tag current position
--  tagChanges()                     -                   Tag change components
--  testBendRadius(DBREF,ARRAY,ARRAY) REAL                Test the bend radius against machines and the spec
--  tidy()                           -                   Tidy reference data
--  tidyAtta()                       -
--  track()                          -                   Track Current Element
--  track(DBREF)                     -                   Track with respect to passed element
--  tubeChoice(STRING)               -                   Called to display the lstu gadget and call functions
--  typeGadgets(BOOLEAN)             -                   Shows/Hides the gadgets associated with the select type task
--  warning(ARRAY,BOOLEAN)           -                   Set warning task and message
--  warning(STRING,BOOLEAN)          -                   Set warning task and message
--  warningGadgets(BOOLEAN)          -                   Shows/Hides the gadgets associated with the spec task
--  writeOptions()                   -                   Write options to user's file
--
------------------------------------------------------------------------

--setup form !!componentCreation resize
setup form !!componentCreation dialog dock right varchars

  !this.iconTitle     = 'Component Creation'
  !this.formTitle     = 'Component Creation'
  !this.callback      = '!this.setup()'
  !this.formRevision  = ' $Revision: 1.14 $ '
  track 'DBCHANGED' call '!this.track()'
  track 'DESICE'    call '!this.track()'
   -- Set form to autoScroll
  !this.autoScroll    = TRUE

  -- Branch information
  paragraph .branchTag  text 'Branch :'                 width 6
  paragraph .branchName   anchor left + right + top     width 16 lines 1
  line .bLine anchor top + left + right                     at x0   ymax   horizontal width 32


  -- Specification information
  paragraph .specTag      anchor left + top                 at x1                 ymax              text 'Spec :' width 5
  paragraph .currentSpec  anchor left + right + top         at xmax               ymin              text '<spec of branch>'
  paragraph .boreTag      anchor left + top                 at x1.2               ymax-0.2          text 'Bore :' width 5
  paragraph .currentBore  anchor left + right + top         at xmin.currentSpec   ymin              width 18
  toggle    .outSpec  'Use Alternative Spec.'               at x0.5               ymax              callback '!this.setAlternativeSpec()'         tooltip 'Select out of spec.'

  -- Select alternative specification
  paragraph .outSpecName                                    at x2                 ymax              text '<alternative spec>'
  button    .setSpec      'Select...'   anchor right + top  at xmax.bLine-size    ymin.outSpecName  callback '!this.setTask(|setSpecification|)'  tooltip 'Select component specification'

  -- Set branch
  button    .selectBranch 'Set Branch'  anchor right + top  at xmax.bLine-size    ymax.bLine        callback '!this.setBranch(!!ce)'              tooltip 'Set working branch'

  ------------------ Component Types Selection
  paragraph .typeTag         anchor left + top              at x0.5               ymax.setSpec      text 'Component Types:'
  line .tLine               anchor top + left + right  at x0   ymax   horizontal width to max.bLine

  list .componentList        anchor top + left + right                     at x0.5               ymax.tLine+0.2    callback '!this.setTask(|selectComponent|)' single zeroSelection  width to max.bLine lines 25

  ------------------ Current component type
  -- Component types selection
  paragraph .typeSelectTag   anchor left + top              at x0.5               ymax.setSpec      text 'Create Component:'
  line .cLine                               anchor top + left + right  at x0   ymax   horizontal width to max.bLine


  paragraph .componentType   anchor left + right + top      at x2                 ymax.cLine+0.1    width 18 lines 1
  button    .chooseType 'Choose...' anchor top + right      at xmax.cLine-size    ymin              callback '!this.setTask(|selectType|)'      tooltip 'Select component type'

  ------------------ Component selection
  paragraph .filterTag       anchor left + top              at x0.5               ymax              text 'Sub-Type:'


  line .fFline     anchor top + left + right  at x0   ymax   horizontal width to max.bLine

  frame .fLine   panel            anchor left + top + right     at x0                 ymax.filterTag-0.2  width to max.bLine


    -- Available sTypes
    option .sTypes 'Filter By' anchor left + top + right     at x2                 ymax+0.2          callback '!this.filterSubType(|comp|)'        tooltip 'Available sub-types for component' width 15

    -- List of available elements (similar to choose)
    -- list .choices              anchor all                     at x0.5               ymax+0.1          callback '!this.selectChoice()' columns single width to max.bLine lines 7
    list .choices            anchor  left + top + right                 at x0.5               ymax+0.1          callback '!this.selectChoice()' columns single width to max.bLine lines 8
  exit

  ------------------ Bend Data
  frame .componentBendFrame 'Bend Information'    anchor right + left + top  at xmin.choices   ymax.choices+0.2                        width to max.bLine

    -- Radius
    option .bendRadiusOption 'Radius'                     at x1    ymax                           callback '!this.selectRadius()'         width 8
    path down
    halign right
    text   .bendRadius                                                                            callback '!this.selectRadius()'         width 10 is REAL format !!distanceFmt

  exit
  ------------------ End of Bend Data

  ------------------ Elbow Data
  frame .componentElbowFrame 'Elbow Information'    anchor right + left + top  at xmin.choices   ymax.choices+0.2   width to max.bLine

    -- Angle
    path right
    paragraph .angleLabel text 'Angle'                 width 8
    text .angle  callback '!this.changeAngle()'        width 8 is REAL format !!angleFmt
    paragraph .minAngleLabel at x1 ymax text 'Min'     width 8
    text .minAngle  at xmin.angle ymin                 width 8 is REAL format !!angleFmt
    paragraph .maxAngleLabel at x1 ymax text 'Max'     width 8
    text .maxAngle at xmin .angle ymin                 width 8 is REAL format !!angleFmt
  exit
  ------------------ End of Elbow Data

  -- Reducer Data
  frame .componentReduFrame 'Reducer Information' anchor right + left + top  at xmin.choices   ymax.choices+0.2     width to max.bLine

    -- Leave Bore
    option .reduBore 'Leave Bore'                         at x1   ymax                            callback '!this.selectBore(!this.reduBore, ||)'            tooltip 'Permissible Leave Bores'   width 10
    path down
    halign right
    button .reduA2L1 toggle pixmap height 24 width 24                                             callback '!this.arriveLeave(2,1)'       tooltip 'Arrive minor bore, leave major bore'
    path left
    hdistance 0
    button .reduA1L2 toggle pixmap height 24 width 24                                             callback '!this.arriveLeave(1,2)'       tooltip 'Arrive major bore, leave minor bore'
    valign centre
    paragraph .reduArrive     text 'Config.'

  exit
  -- End of Reducer Data

  -- Tee Data
  frame .componentTeeFrame 'Connection Information' anchor right + left + top  at xmin.choices   ymax.choices+0.2                      width to max.bLine

    -- Connection Bore
    option .teeBore  'Conn. Bore'                         at x1   ymax                            callback '!this.selectBore(!this.teeBore, ||)'            tooltip 'Permissible Connection Bores'  width 10
    path down
    halign right
    button .teeA3L2 toggle pixmap height 24 width 24                                              callback '!this.arriveLeave(3,2)'       tooltip 'Arrive by connection'
    path left
    hdistance 0
    button .teeA1L3 toggle pixmap height 24 width 24                                              callback '!this.arriveLeave(1,3)'       tooltip 'Leave by connection'
    button .teeA1L2 toggle pixmap height 24 width 24                                              callback '!this.arriveLeave(1,2)'       tooltip 'Flow through tee'
    valign centre
    paragraph .teeArrive      text 'Config.'
  exit
  -- End of Tee Data



  ------------------ Modification Frame
  paragraph .modifyTag            anchor left + top         at x0.5               ymax.setSpec      text 'Modify Components:'
  line .mLine                               anchor top + left + right  at x0   ymax   horizontal width to max.bLine

  list .adjacentType   'Components with Alternatives' anchor right + left + top at x0.5 ymax+0.2    callback '!this.adjacentType()'           width to max.bLine lines 6
  list .adjacentSelect 'Available Alternatives' anchor right + left + top at xmin ymax              callback '!this.adjacentSelect()'  columns single width to max.bLine lines 8
  path down
  halign right
  button .modifyDone    '  Done  '    anchor right + top                                            callback '!this.setTask(|selectComponent|)'
  ------------------ End of Modification Frame

  ------------------ Specification Selection Frame
  --list .specList 'Alternative Specifications'   anchor all  at x0.5               ymax.setSpec      callback '!this.selectAlternativeSpec()'  single zeroSelection width to max.bLine height to max form
  list .specList  anchor left + top + right  at x0.5               ymax.setSpec      callback '!this.selectAlternativeSpec()'  single zeroSelection width to max.bLine height to max form
  halign right
  path down

  -- Insulation
  option .insulation      'Insulation'      anchor right + top      at ymax form                                                           width 10
  option .tracing         'Tracing  '       anchor right + top                                                                             width 10

  -- Completed specification selection
  button .specDone        '  Done  '  anchor right + top           callback '!this.setTask(|selectType|)' tooltip 'Apply alternative specification'

  ------------------ End of Specification Selection Frame

  -- Options Setting Frame
  frame .optionsFrame   'Options' anchor right + left + top at x0.5 y6

    -- Snap distance for picking
    text   .snapDist        'Snap Dist.'               at x3     ymax+0.5  callback '!this.setOption(|snapDistance|)' tooltip 'Snap distance <distance> or <val> * OD'        width 10 is STRING

    -- Minimum Tube Length
    path down
    halign right
    text   .minTubeLength   'Min. Tube'                                  callback '!this.setOption(|minTubeLength|)' tooltip 'Minimum tube length <distance> or <val> * OD'  width 10 is STRING

    toggle .align           ' Auto align'                 at x2     ymax      callback '!this.setOption(|align|)'

    button .resetSettings   'System Defaults' anchor right  + top at xmax.snapDist-size ymax+1 callback '!this.systemDefaults()' tooltip 'Reset to system default'

  exit
  -- End of Setting Frame

  -------------------- Warning pane
  paragraph .warningTag   anchor left + top                 at x0.5               ymin.boreTag+1      text 'Warning:'
  line .wLine             anchor top + left + right         at x0                 ymax   horizontal width to max.bLine

  paragraph .warningIcon                                    at x0.5               ymax+0.1            pixmap width 30 heigh 32
  paragraph .warning      anchor left + right + top         at xmax+2             ymin+0.2            width 22 lines 6
  button    .warningDone  '  Done  '   anchor right + top   at xmax.wLine-size    ymax+0.5            callback '!this.resumeTask()'


  frame .assemblyFrame panel anchor left + top + right    at x0    ymax.filterTag-0.2  width to max.bLine
    hdist 0
    -- Available sTypes
    path down
    vdist 0
    option .assemblyTypes anchor left + right + top callback '!this.filterSubType(|ASSY|)'   tooltip 'Available sub-types for component' width to max.assemblyFrame
    frame .listframe panel anchor left + top + right width.assemblyTypes
      -- List of available elements (similar to choose)
      --  list .choices         anchor all  at xmin callback '!this.selectChoice()' columns single width.assemblyTypes lines 7
      list .assemblychoices  dock fill   callback '!this.selectChoice()' columns single lines 7
    exit
    ------------------ View Data For assemblies
    frame .vframe panel indent anchor left + right + top width.assemblyTypes

      view .localview at xmin.vframe GIvol  height 9
        -- Input Modes
        -- Navigate
        inmode create _navi       type |DES_NAVIGATE|
        -- Standard Element Pick
        inmode create _pick       type |DES_PICK|
        -- Pick Any (Element, Ppoint, Pline)
        inmode create _pAny       type |DES_PICK_ANY|
        -- Plines
        inmode create _pLine      type |DES_PICK_PLINE|
        -- Ppoints
        inmode create _point      type |DES_PICK_POINT|
        -- Screen Position
        inmode create _screen     type |DES_3D_LINE|
        -- Laser Model rays
        inmode create _pickxgeom  type |DES_PICK_XGEOM|
        -- Default (Navigation)
        inmode create _pickDetail type |DES_PICK_DETAIL|
        -- Default (Navigation)
        inmode create _default    type |DES_NAVIGATE|
      exit
    exit
  exit
  ------------------ Creation Options
  paragraph .createTag    anchor right + left + top at x0.5               ymax             width 29 lines 1
  line .nLine                               anchor top + left + right  at x0   ymax.createTag   horizontal width to max.bLine

  option .lstu 'Leave Tube:' anchor left+right+top     at xmin               ymax.nLine+0.2      callback '!this.tubeChoice(!this.lstu.selection(|rText|))' tooltip 'Leave Tube Specification' width 17

  -- Creation Flow Head-Tail or Tail-Head
  button    .toTail     toggle anchor left + top         at x1                 ymax.lstu+0.2    pixmap height 16 width 16 callback '!this.setFlow(true)'
  paragraph .toTailTag         anchor left + top         at xmax+0.2           ymin              text 'With Flow'
  button    .toHead     toggle anchor left + top         at xmax           ymin.toTail       pixmap height 16 width 16 callback '!this.setFlow(false)'
  paragraph .toHeadTag         anchor left + top         at xmax+0.2           ymin              text 'Against Flow'

  toggle .createAdjacent  ' Auto. Create Adjacent' anchor left + top at x2     ymax           callback '!this.setOption(|createAdjacent|)'
  toggle .adjacentSpec    ' Use Alternative Spec.' anchor left + top at x4     ymax         callback '!this.setOption(|adjacentSpec|)'
  toggle .skipConn        ' Skip Connected Comps.' anchor left + top at x2     ymax           callback '!this.setOption(|skipConnected|)'

  -- Component Creation
  button .create      'Connect'        anchor left + top    at x0     ymax              callback '!this.create(TRUE)'             tooltip 'Create component adjacent'
  button .createPick  'Place in line'  anchor left + top    at xmax +2 ymin          callback '!this.createAtPosition()'   tooltip 'Create component at picked position'
  button .create3d    'Place 3D' anchor left + top at    xmax+2 ymin                 callback '!this.create3DPosition()'   tooltip 'Create component at EDG position'

  --button .mod         '<Modify>'  anchor left + top      at xmax               ymin              callback '!this.modifyMode()'
  button .flip 'Flip Components'  anchor right + top at xmin.create   ymax              callback '!this.flip()'               tooltip 'Flip orientation of new components'

  ------------------ End of Creation Options

  -- Set Defaults for Modes
  !this.localview.navi.cursor     = 'Pointer'
  !this.localview.navi.prompt     = 'Navigate : '

  !this.localview.pick.cursor     = 'Pointer'
  !this.localview.pick.prompt     = 'Pick Element : '

  !this.localview.pAny.cursor     = 'Pointer'
  !this.localview.pAny.prompt     = 'Pick Any : '

  !this.localview.pLine.cursor    = 'Pointer'
  !this.localview.pLine.prompt    = 'Pick Pline : '

  !this.localview.point.cursor    = 'Pick'
  !this.localview.point.prompt    = 'Point Ppoint : '

  !this.localview.screen.cursor   = 'Crosshair'
  !this.localview.screen.prompt   = 'Pick 3D Position : '

  !this.localview.default.cursor  = 'Pointer'
  !this.localview.default.prompt  = 'Navigate : '


  ------------------ End of Bend Data

  -- Form Members

  -- Current Active Branch
  member .branch                is DBREF
  member .component             is DBREF
  member .componentPosition     is POSITION

  -- Is branch valid
  member .isValid               is BOOLEAN

  -- Created Components
  member .newComponent          is DBREF
  member .newComponents         is ARRAY

  -- Multi choice (bucket for holding items created with their multiple choices)
  member .multipleSelect        is ARRAY

  -- Next and Previous Components
  member .next                  is DBREF
  member .previous              is DBREF

  -- Check bore for component, could be P3 of a Tee or P2 of a reducer, etc.
  member .checkBore             is BORE

  -- Arrive/Leave for new component (not to be confused with arrive/leave of current component)
  member .arriveBore            is BORE
  member .leaveBore             is BORE
  member .tubeOD                is REAL
  member .wallTH                is REAL

  -- Creation direction (Forward flow is TRUE)
  member .flow                  is BOOLEAN

  -- Available Specifications
  member .pipingSpecs           is SPECIFICATIONS
  member .insulationSpecs       is SPECIFICATIONS
  member .tracingSpecs          is SPECIFICATIONS

  -- List of accessed Component Specifications
  member .specifications        is ARRAY

  -- List of specifications within the system
  member .specificationIndices  is ARRAY

  -- Branch specification
  member .branchSpecification   is DBREF

  -- Active specification index (quick access to information)
  member .activeSpecIndex       is REAL

  -- Specification to create component with
  member .currentSpecification  is DBREF

  -- Active specification components are created using
  member .activeSpecification   is DBREF

  -- Alternative specification
  member .alternativeSpec       is DBREF

  -- Current Selected component in spec
  member .currentComponentIndex is REAL

  -- Current task
  member .currentTask           is STRING

  -- Warning task active
  member .warningTask           is BOOLEAN

  -- Currently Active Component
  member .activeDataFrame       is GADGET

  -- Currently Active Frame
  member .currentFrameIndex     is REAL

  -- Register of components requiring Tab Frames
  member .componentRegister     is ARRAY

  -- Description for frame
  member .componentFrames       is ARRAY

  -- Actual Frame for components
  member .frameRegister         is ARRAY

  -- Special Attribute Registers (index is the same as the frame register)
  -- Radius Gadgets
  member .radiusRegister      is ARRAY
  -- Bore Gadgets
  member .boreRegister        is ARRAY
  -- Angle Gadgets
  member .angleRegister        is ARRAY
  -- Arrive Leave Gadgets??
  member .arriveLeaveRegister is ARRAY

  -- Object for registered components
  member .componentObjects      is ARRAY

  -- Default component object
  member .defaultComponent      is COMPONENTDEFAULT

  -- Available Components
  member .availableComponents   is ARRAY

  -- Aid Graphics
  member .tagID                 is REAL
  member .branchTagID           is REAL
  member .tagChanges            is REAL

  -- EDG Description
  member .edgDescription        is STRING

  -- Picked Position
  member .pickedPosition        is POSITION

  -- Active filters
  member .sTypeFilter           is BOOLEAN

  -- Display options (2 dimensional array [1] Key, [2] Description)
  member .detailText            is ARRAY

  -- Utility Option Settings
  member .tagPoint              is POINTVECTOR
  member .componentDetail       is REAL
  member .skipConnected         is BOOLEAN
  member .autoCreate            is BOOLEAN
  member .autoCreateSpec        is BOOLEAN
  member .autoAlign             is BOOLEAN
  member .snapDistanceExp       is STRING
  member .snapDistanceVal       is REAL

  -- Sets the expression used to generate the minimum tube length - This is set in the component_creation user file
  member .minTubeLengthExp      is STRING
  -- Sets the value used as the minimum tube length. This takes precedence over the expression - This is set in the component_creation user file
  member .minTubeLengthVal      is REAL
  -- If the minimum tube value and expression are unset, or the expression is invalid - Get the minimum tube lengths from the data consistency checker tube ranges form !!CDDATUOPT
  member .minTubeLengthDataCon  is ARRAY

  -- Option File information
  member .optionFileData        is ARRAY

  -- Current Model Edit state
  member .modifyMode            is BOOLEAN
  member .state                 is STATE

  member .assemblies            is PIPINGASSEMBLYMGR
  member .assembly              is PIPEASSEMBLY

  -- Current element can actively be modified, should be set to false
  -- on manual tracking and selection exiting modify tasks
  member .modifyActive          is BOOLEAN

  -- Undo for creation
  member .undo                  is UNDOABLE
  -- add a drawlist for the local view
  member .drawlist              is DRAWLIST

  --Number of Leave tube specs available
  member .noLstuSpecs           is REAL
  --Lstu Selection
  member .lstuSelection         is DBREF

  --multiBore boolean to tell if a selectable component is multiBore
  member .multiBore             is BOOLEAN
  -- multiBore has been used for reducing components and three way components
  -- need to know which type this is for COMPONENTDEFAULT base class
  -- .reducingComponent added for case where p1 bore is different from P2 bore
  member .reducingComponent     is BOOLEAN
  --member to set whether available item is a reducing flange
  member .redFlange             is BOOLEAN
  --member to check for snap distance after the components are created.
  member .checkForSnapDist      is BOOLEAN
  member .oriComp               is DBREF
  --member to check the type of selections for creation
  member .connectValue          is BOOLEAN
  member .placeInLine           is BOOLEAN
  member .place3d               is BOOLEAN

  -- Register from
  !!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      componentCreation
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentCreation()

  -- Initialise Variables
  !this.activeSpecIndex       = 0
  !this.currentComponentIndex = 0
  !this.currentFrameIndex     = 0
  !this.isValid               = false
  !this.checkForSnapDist      = true

  !this.noLstuSpecs = 1

  !this.connectValue = true
  !this.placeInLine  = false
  !this.place3d      = false

  -- Temp settings
  !this.optionsFrame.visible  = false
  !this.modifyActive           = FALSE
  !this.assemblyFrame.visible  = FALSE

  !warningIcon                = !!pml.getPathname('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)
  !this.warningTask           = false

  -- EDG Description
  !this.edgDescription        = 'Pipe Component Creation'

  -- Aid graphic numbers
  !this.tagID                 = !!aidNumbers.add('Pipe Component Creation Tag')
  !this.branchTagID           = !!aidNumbers.add('Pipe Component Creation Branch')
  !this.tagChanges            = !!aidNumbers.add('Pipe Component Creation Changes')

  -- Set cancel callback
  !this.cancelCall            = '!this.close()'

  -- Configuration Info, options are DTXR = rText, DTXS = Stext, DTXT = tText, CATTEX = rText + Material Text
  !menu = !this.newMenu('displayOptions')

  -- Define menu
  !this.detailText            = ARRAY()
  !detailText[1]              = 'Full Description'
  !detailText[2]              = 'CATTEX'
  !this.detailText.append(!detailText)
  !detailText[1]              = 'R Text'
  !detailText[2]              = 'DTXR'
  !this.detailText.append(!detailText)
  !detailText[1]              = 'S Text'
  !detailText[2]              = 'DTXS'
  !this.detailText.append(!detailText)
  !detailText[1]              = 'T Text'
  !detailText[2]              = 'DTXT'
  !this.detailText.append(!detailText)
  !detailText[1]              = 'Catalogue Ref.'
  !detailText[2]              = 'CATR'
  !this.detailText.append(!detailText)

  do !i indices !this.detailText
    !menu.add('toggle', !this.detailText[!i][1],'!this.displayOption(|' & !this.detailText[!i][2] & '|)')
  enddo

  -- Initialise first option
  !this.componentDetail       = 1
  !menu.select(!this.detailText[1][1], true)
  -- initialise multi-bore and reducing component flags
  !this.multiBore             = false
  !this.reducingComponent     = false
  -- Filter settings
  !this.sTypeFilter           = false

  -- Apply popup to form
  !this.choices.setPopup(!menu)

  -- Setup task panels
  !this.setTask('Initialise')

  -- Flow creation
  !icon             = !!pml.getPathname('againstflow16.png')
  !this.toHead.addPixmap(!icon)
  !icon             = !!pml.getPathname('withflow16.png')
  !this.toTail.addPixmap(!icon)
  !this.flow        = true
  !this.toHead.val  = false
  !this.toTail.val  = true

  -- Default Settings
  !this.defaultSettings()
  !this.readOptions()

  -- Component Default Information
  -- ## Bends
  !index = !this.registerComponent('BEND', !this.componentBendFrame, object COMPONENTBEND())

  -- Define radius gadgets for bend component, get info from component object to populate gadget
  !this.registerRadius('BEND', !this.bendRadiusOption, !this.bendRadius)

  -- ## Elbow
  !index = !this.registerComponent('ELBO', !this.componentElbowFrame, object COMPONENTELBOW())
  !this.registerAngle('ELBO', !this.angle, !this.minAngle, !this.maxAngle)

  !this.minAngle.active = false
  !this.maxAngle.active = false

  -- ## Reducer
  !index = !this.registerComponent('REDU', !this.componentReduFrame, object COMPONENTREDUCER())

  --CW
  -- ## Coupling
  !index = !this.registerComponent('COUP', !this.componentReduFrame, object COMPONENTDEFAULT())
  --CW
  -- ## Flange
  !index = !this.registerComponent('FLAN', !this.componentReduFrame, object COMPONENTFLANGE())

  -- Define bore gadget for Reducer component
  !this.registerBore('REDU', !this.reduBore)
  --CW
  !this.registerBore('COUP', !this.reduBore)
  !this.registerBore('FLAN', !this.reduBore)

  -- Define gadgets and associates for Reducer component
  !this.registerArriveLeave('REDU', 1, 2, !this.reduA1L2)
  !this.registerArriveLeave('REDU', 2, 1, !this.reduA2L1)
  --CW
  !this.registerArriveLeave('COUP', 1, 2, !this.reduA1L2)
  !this.registerArriveLeave('COUP', 2, 1, !this.reduA2L1)

  --CW
  !this.registerArriveLeave('FLAN', 1, 2, !this.reduA1L2)
  !this.registerArriveLeave('FLAN', 2, 1, !this.reduA2L1)

  -- Icons
  !icon = !!pml.getPathname('reducer12-24.png')
  !this.reduA1L2.addPixmap(!icon)

  !icon = !!pml.getPathname('reducer21-24.png')
  !this.reduA2L1.addPixmap(!icon)

  -- ## Tee & Olet
  !index = !this.registerComponent('OLET', !this.componentTeeFrame, object COMPONENTTEE())
  !index = !this.registerComponent('TEE',  !this.componentTeeFrame, object COMPONENTTEE())

  -- Define bore gadget for Olet and Tee component
  !this.registerBore('OLET', !this.teeBore)
  !this.registerBore('TEE', !this.teeBore)

  -- Define gadgets and associates for Reducer component
  !this.registerArriveLeave('TEE', 1, 2, !this.teeA1L2)
  !this.registerArriveLeave('TEE', 1, 3, !this.teeA1L3)
  !this.registerArriveLeave('TEE', 3, 2, !this.teeA3L2)

  -- Icons
  !icon   = !!pml.getPathname('tee12-24.png')
  !this.teeA1L2.addPixmap(!icon)

  !icon   = !!pml.getPathname('tee13-24.png')
  !this.teeA1L3.addPixmap(!icon)

  !icon   = !!pml.getPathname('tee32-24.png')
  !this.teeA3L2.addPixmap(!icon)

  -- ## Valves
  !index  = !this.registerComponent('VALV', object GADGET(), object COMPONENTVALVE())
  !index  = !this.registerComponent('VTWA', object GADGET(), object COMPONENTVTWA())
  !index  = !this.registerComponent('FILT', object GADGET(), object COMPONENTFILTER())

  -- ## Instruments
  !index  = !this.registerComponent('INST', object GADGET(), object COMPONENTINSTRUMENT())

  -- ## pcom's
  !index  = !this.registerComponent('PCOM', object GADGET(), object COMPONENTINSTRUMENT())

  -- ## Flange
  !index  = !this.registerComponent('FLAN', object GADGET(), object COMPONENTFLANGE())

  -- ## End of component registration

  -- Load Specifications
  -- Define headings
  --!a[1] = 'Component Types'
  --!this.componentList.setHeadings(!a)

  !a[1] = 'Alternative Specifications'
  !this.specList.setHeadings(!a)

  !this.setupSpecifications()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      defaultSettings
--
-- Description: Default Settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultSettings()

  -- Option Settings
  !this.skipConnected       = true
  !this.autoCreate          = true
  !this.autoCreateSpec      = false
  !this.componentDetail     = 1
  !this.autoAlign           = true

  -- Snap distance
  !this.snapDistanceExp     = '2 * OD'
  !this.snapDistanceVal     = REAL()

  !this.getMinTubeLengthDataCon()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      systemDefaults
--
-- Description: Revert to system defaults
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemDefaults()

  -- Initialise Variables
  !this.defaultSettings()

  -- Setup form for defaults
  !this.setupOptions()

  -- Write User's options to file
  !this.writeOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupOptions
--
-- Description: Setup options frame to current settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupOptions()

  -- Set up adjacent spec creation option
  !this.adjacentSpec.val = !this.autoCreateSpec

  -- Setup detail text
  --!this.detailText.select('rText', !this.componentDetail)

  !this.skipConn.val        = !this.skipConnected
  !this.createAdjacent.val  = !this.autoCreate
  !this.align.val           = !this.autoAlign

  -- Set snap length
  !this.displaySnapDistance()

  -- Set tube length
  !this.displayMinTubeLength()

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      setOption
--
-- Description: Set creation of adjacent components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option setting
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOption(!option is STRING)

  -- Initialise Variables

  -- Gadget Settings
  if(!option eq 'DETAILTEXT') then
    !this.displayChoices()
  elseif (!option eq 'skipConnected') then
    !this.skipConnected()
  elseif (!option eq 'createAdjacent') then
    !this.autoCreate     = !this.createAdjacent.val
  elseif (!option eq 'adjacentSpec') then
    !this.autoCreateSpec = !this.adjacentSpec.val
  elseif (!option eq 'SNAPDIST') then
    --!this.snapDistance()
  elseif (!option eq 'MINTUBELENGTH') then
    --!this.minTubeLength()
  elseif (!option eq 'ALIGN') then
    !this.autoAlign = !this.align.val
  endif

  -- Write User's options to file
  !this.writeOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayOption
--
-- Description: Set display option
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Display option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayOption(!option is STRING)

  -- Initialise Variables

  -- No action if current detail is same as selected
  if(!option eq !this.detailText[!this.componentDetail][2]) then
    !this.displayOptions.select(!this.detailText[!this.componentDetail][1], true)
    return
  endif

  -- Get new index
  do !i indices !this.detailText
    if(!this.detailText[!i][2] eq !option) then
      !index  = !i
      break
    endif
  enddo

  -- Unset current detail
  !this.displayOptions.select(!this.detailText[!this.componentDetail][1], false)

  -- Set new detail
  !this.componentDetail = !index
  !this.displayOptions.select(!this.detailText[!this.componentDetail][1], true)

  -- Empty choice list
  !this.choices.clear()

  -- Display Components
  !this.displayChoices()

  -- Write User's options to file
  !this.writeOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      writeOptions
--
-- Description: Write options to user's file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .writeOptions()

  -- Initialise Variables
  -- File Data
  var !user login
  !date           = object DATETIME()
  !records        = ARRAY()
  !records.append('## Pipe Component Creation defaults for user: ' & !user)
  !records.append('## Created: ' & !date.string())
  !records.append('skipConnected\'      & !this.skipConnected.string())
  !records.append('autoCreate\'         & !this.autoCreate.string())
  !records.append('autoCreateSpec\'     & !this.autoCreateSpec.string())
  !records.append('componentDetail\'    & !this.componentDetail)
  !records.append('autoAlign\'          & !this.autoAlign.string())
  if(!this.snapDistanceExp.set()) then
    !records.append('snapDistanceExp\'  & !this.snapDistanceExp)
  else
    !records.append('snapDistanceVal\'  & !this.snapDistanceVal.string())
  endif
  if(!this.minTubeLengthExp.set()) then
    !records.append('minTubeLengthExp\' & !this.minTubeLengthExp)
  else
    !records.append('minTubeLengthVal\' & !this.minTubeLengthVal.string())
  endif

  -- Write to users configuration file
  !file = object FILE('%PDMSUSER%/component_creation_' & !user)
  !file.writeFile('OVERWRITE',!records)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      readOptions
--
-- Description: Write options to users file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readOptions()

  -------------------------------------------------------
  ------TEMP MUST BE REMOVED AND PUT INTO PRODUCT STARTUP
  -------------------------------------------------------
  if (undefined (!!pipingSettings)) then
    !!pipingSettings = object PIPINGSETTINGS()
  endif
  -------------------------------------------------------
  ------TEMP MUST BE REMOVED AND PUT INTO PRODUCT STARTUP
  -------------------------------------------------------

  --Boolean settings
  !this.skipConnected     = !!pipingSettings.skipConnected
  !this.autoCreate        = !!pipingSettings.autoCreate
  !this.autoCreateSpec    = !!pipingSettings.useAlternateSpec
  !this.autoAlign         = !!pipingSettings.autoAlign

  !snap  = !!pipingSettings.snapDist

  if !snap.eq('Datacon') then
     !this.snapDistanceExp   = STRING()
     !this.snapDistanceVal   = REAL()
     -- if both values are unset its using datacon
  else
     !this.snapDistanceVal  = !snap.real(!!distanceFmt)
     handle any

       !this.snapDistanceExp = !snap
     endhandle
  endif

  !minTube = !!pipingSettings.minTube
  if !minTube.eq('Datacon') then
     !this.minTubeLengthExp  = STRING()
     !this.minTubeLengthVal  = REAL()
     -- if both values are unset its using datacon
  else
     !this.minTubeLengthVal = !minTube.real(!!distanceFmt)
     handle any
       !this.minTubeLengthExp = !minTube
     endhandle
  endif

  -- calls to the old defaults system
  --!this.snapDistance()
  --!this.minTubeLength()

  --display options
  !textDesc = !!pipingSettings.descriptions
  do !i from 1 to !this.detailText.size()
    if (!textDesc.eq(!this.detailText[!i][2])) then
      !this.componentDetail   = !i
      break
    endif
  enddo
  !this.displayChoices('create')
  handle ANY
  endhandle
  !this.displayChoices('edit')
  handle ANY
  endhandle

  -- Setup form for defaults
  !this.setupOptions()

endmethod
$(
------------------------------------------------------------------------
--
-- Method:      readOptions
--
-- Description: Write options to users file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .readOptions()

  -- Initialise Variables
  var !user login
  !file     = object FILE('%PDMSUSER%/component_creation_' & !user)

  -- If there is no file, then return
  if(!file.exists().not()) then
    return
  endif

  -- Get file records
  !records  = !file.readFile()

  -- Original Option on building the form
  !this.optionFileData = !records

  -- Loop through file
  do !record value !records
    skip if(!record.subString(1,1) eq '#')
    !data = !record.split('\')

    -- Set options
    if(!data[1] eq 'skipConnected') then
      !this.skipConnected     = !data[2].boolean()
    elseif (!data[1] eq 'autoCreate') then
      !this.autoCreate        = !data[2].boolean()
    elseif (!data[1] eq 'autoCreateSpec') then
      !this.autoCreateSpec    = !data[2].boolean()
    elseif (!data[1] eq 'componentDetail') then
      --!this.componentDetail   = !data[2]
    elseif (!data[1] eq 'autoAlign') then
      !this.autoAlign         = !data[2].boolean()
    elseif (!data[1] eq 'snapDistanceExp') then
      !this.snapDistanceExp   = !data[2]
      !this.snapDistanceVal   = REAL()
    elseif (!data[1] eq 'snapDistanceVal') then
      !this.snapDistanceExp   = STRING()
      !this.snapDistanceVal   = !data[2].real()
    elseif (!data[1] eq 'minTubeLengthExp') then
      !this.minTubeLengthExp  = !data[2]
      !this.minTubeLengthVal.string()
    elseif (!data[1] eq 'minTubeLengthVal') then
      !this.minTubeLengthExp  = STRING()
      !this.minTubeLengthVal  = !data[2].real()
    endif
  enddo

  -- Setup form for defaults
  !this.setupOptions()

endmethod
-- End of method definition
$)

------------------------------------------------------------------------
--
-- Method:      registerComponent
--
-- Description: Register Data Frame
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type (PDMS Type, BEND, TEE, etc.)
-- Return:
--   [Data Type] [Description]
--    REAL        Index of array component has been added at
--
------------------------------------------------------------------------

define method .registerComponent(!componentType is STRING, !componentFrame is GADGET, !object is ANY) is REAL

  -- Initialise Variables

  -- Get description of component
  var !nounDef NOUNDEF $!<componentType> RPTX
  !description    = !nounDef[1].subString(1,1) & !nounDef[1].subString(2).lowcase()

  -- Set Information
  !this.componentRegister.append(!componentType)
  !this.componentFrames.append(!description)
  !this.frameRegister.append(!componentFrame)
  !this.componentObjects.append(!object)

  -- Default, hide frame
  if(!componentFrame.set()) then
    !componentFrame.visible = false
  endif

  -- Return Size of Register
  return !this.componentRegister.size()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerArriveLeave
--
-- Description: Setup arrive and leave gadgets for passed element type.
--              Unlike the other register methods this is accumulative
--              so we add to any existing options in the register. Also
--              the assumption is that the arrive and leave information
--              has not been defined before.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      REAL        Arrive ppoint number
--    3   R      REAL        Leave ppoint number
--    4   R      GADGET      Button gadget for setting arrive/leave
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerArriveLeave(!type is STRING, !arrive is REAL, !leave is REAL, !button is GADGET)

  -- Initialise Variables
  !index                            = !this.frameIndex(!type)

  -- Check if entry is defined
  if(undefined(!this.arriveLeaveRegister[!index])) then
    !this.arriveLeaveRegister[!index] = ARRAY()
  endif

  -- Define type information
  !data[1]  = !arrive
  !data[2]  = !leave
  !data[3]  = !button

  !this.arriveLeaveRegister[!index].append(!data)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerRadius
--
-- Description: Setup radius gadgets for passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      GADGET      Option gadget radius
--    3   R      GADGET      Input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerRadius(!type is STRING, !options is GADGET, !input is GADGET)

  -- Initialise Variables
  !index                          = !this.frameIndex(!type)
  !this.radiusRegister[!index][1] = !options
  !this.radiusRegister[!index][2] = !input

  -- Set Radius
  !input.val = 0

  !display = ARRAY()
  !replace = ARRAY()

  --Check if option is set to limit radius options, this is set in DEFAULTS
  if (defined(!!limitRadiusOptions)) then
    if (!!limitRadiusOptions.not()) then
      -- Permissible Bend Radii
      !radiiOD = !this.componentObjects[!index].permissibleRadiiOD
      do !i indices !radiiOD
        !display[!i]  = !radiiOD[!i] & ' * OD'
        !replace[!i]  = !radiiOD[!i].string()
      enddo
    endif
  endif

  !display.append('Define')
  !replace.append('')


  !options.dText  = !display
  !options.rText  = !replace

  -- Get any details from Bend Object
  !radius         = !this.componentObjects[!index].defaultRadiusOD
  !options.select('rText', !radius.string())
  handle ANY
  endhandle

  -- Select Type
  !this.selectRadius(!type)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerBore
--
-- Description: Setup bore gadgets for passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      GADGET      Option gadget bore
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerBore(!type is STRING, !options is GADGET)
  !index                     = !this.frameIndex(!type)
  !this.boreRegister[!index] = !options
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerAngle
--
-- Description: Setup bore gadgets for passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      GADGET      Option gadget bore
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerAngle(!type is STRING, !input is GADGET, !minValue is GADGET,  !maxValue is GADGET)
  !index                     = !this.frameIndex(!type)
  !this.angleRegister[!index][1] = !input
  !this.angleRegister[!index][2] = !minValue
  !this.angleRegister[!index][3] = !maxValue

  !input.val = !this.componentObjects[!index].angle
  !minValue.val = !this.componentObjects[!index].angle
  !maxValue.val = !this.componentObjects[!index].angle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentIndex
--
-- Description: Return component index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    REAL        Frame index
--
------------------------------------------------------------------------

define method .componentIndex(!componentType is STRING) is REAL
  !index      = !this.componentRegister.findFirst(!componentType.upCase())
  if(!index.unset()) then
    !index    = 0
  endif
  return !index
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      frameIndex
--
-- Description: Return frame index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    REAL        Frame index
--
------------------------------------------------------------------------

define method .frameIndex(!componentType is STRING) is REAL

  -- Get Index
  !index      = !this.componentIndex(!componentType)

  -- Component registered, but there isn't a frame for it
  if(!index gt 0) then
    if(!this.frameRegister[!index].unset()) then
      !index = -1 * !index
    endif
  endif

  --CW
  if (!componentType.eq('COUP')) then
    !this.componentReduFrame.tag = 'Reducing Coupling Information'

  elseif (!componentType.eq('FLAN')) then
    !this.componentReduFrame.tag = 'Reducing Flange Information'

  else
    !this.componentReduFrame.tag = 'Reducer Information'
  endif
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      objectIndex
--
-- Description: Return object index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    REAL        Frame index
--
------------------------------------------------------------------------

define method .objectIndex(!componentType is STRING) is REAL

  -- Get Index
  !index      = !this.componentRegister.findFirst(!componentType)
  if(!index.unset()) then
    !index    = 0
  else
    -- Component registered, but there isn't a object for it
    if(!this.componentObjects[!index].unset()) then
      !index = -1 * !index
    endif
  endif
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentObject
--
-- Description: Return component object for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    ANY        Component object for passed component type
--
------------------------------------------------------------------------

define method .componentObject(!componentType is STRING) is ANY

  -- Get Index
  !index      = !this.componentRegister.findFirst(!componentType)
  if(!index.unset()) then
    !object   = !this.defaultComponent
  else
    -- Component registered, but there isn't a frame for it
    if(!this.componentObjects[!index].unset()) then
      !object = !this.defaultComponent
    else
      !object = !this.componentObjects[!index]
    endif
  endif

  -- Return component object
  return !object

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.newComponent  = object DBREF()
  !this.branch        = object DBREF()

  -- Clear lists
  !this.newComponents.clear()
  !this.multipleSelect.clear()

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

  -- Hide all Aid graphics for utility
  !!aidNumbers.hide(!this.tagID)
  !!aidNumbers.hide(!this.branchTagID)
  !!aidNumbers.hide(!this.tagChanges)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy reference data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Check if new component(s) have been deleted
  if(badref(!this.newComponent)) then

    -- Remove new component from list
    !this.newComponent = object DBREF()

    -- Clear lists
    !this.newComponents.clear()

    -- Stop flip from happening
    !this.flip.visible = false

    -- Setup reselection of adjacent components
    !this.adjacentClear()

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag current position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tag()

  -- Initialise Variables
  !!aidNumbers.hide(!this.tagID)

  -- Display bore
  if(!this.flow) then
    !this.currentBore.val = !this.arriveBore.string(!!boreFmt)
  else
    !this.currentBore.val = !this.arriveBore.string(!!boreFmt)
  endif

  -- Tag Current Position
  !this.createTag.val = 'Creation from ' & !this.component.flnn

  -- Proportion
  !proportion   = 0.4

  -- Offset Arrow parallel to route
  !offset       = !this.arriveBore.real() * 1
  !orthDir      = !this.tagPoint.direction.orthogonal(U)
  handle ANY
    !orthDir    = !this.tagPoint.direction.orthogonal(N)
  endhandle
  !offsetDir    = !orthDir.orthogonal(!this.tagPoint.direction)
  !tagPosition  = !this.tagPoint.position.offset(!offsetDir, !offset)
  !height       = !this.arriveBore.real()
  !oHeight      = !offset * 2
  !cHeight      = !height
  !cPosition    = !tagPosition.offset(!this.tagPoint.direction, !cHeight / 2)
  AID CYLINDER NUMBER $!<this.tagID>  AT $!<cPosition>   ORI Z IS $!<this.tagPoint.direction>  HEIGH $!<cHeight> DIAM 4mm FILLED ON
  AID CYLINDER NUMBER $!<this.tagID>  AT $!<this.tagPoint.position> ORI Z IS $!<offsetDir>     HEIGH $!<oHeight> DIAM 4mm FILLED ON
  AID ARROW    NUMBER $!<this.tagID>  AT $!<tagPosition> DIRECTION $!<this.tagPoint.direction> HEIGH $!<height> PROPORTION $!<proportion>

  -- Current element pointer
  if(!this.skipConnected.not()) then
    !direction  = !offsetDir.opposite()
    !nHeight    = (!oHeight - !this.arriveBore.real() - 10mm) / 2
    AID ARROW  NUMBER $!<this.tagID>  AT $!<tagPosition> DIRECTION $!<direction> HEIGH $!<nHeight> PROPORTION 0.75
  endif

  -- Show current component type
  !fullType     = !this.component.fullType
  !type         = !fullType.subString(1,1) & !fullType.subString(2).lowcase()
  AID TEXT    NUMBER $!<this.tagID> '$!<type>' AT $!<tagPosition>

  -- Refresh Alternate changes
  if(!this.currentTask.eq('MODIFY')) then
    !this.tagChanges()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tagChanges
--
-- Description: Tag change components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagChanges()

  -- Initialise Variables
  !!aidNumbers.hide(!this.tagChanges)

  -- Mark all the components to be changed
  !detail = !this.adjacentType.selection('DTEXT')
  !type   = !this.adjacentType.selection('RTEXT').dbref().type
  handle ANY
    return
  endhandle

  do !component values !this.newComponents
    skip if(!component.type ne !type)

    -- Offset Arrow parallel to route
    !offset       = !component.aBore.real() * 1.5
    !orthDir      = !component.aDirection.orthogonal(D)
    handle ANY
      !orthDir    = !component.aDirection.orthogonal(S)
    endhandle
    !offsetDir    = !orthDir.orthogonal(!component.aDirection)
    !tagPosition  = !component.position.offset(!offsetDir, !offset)
    !offsetDir    = !offsetDir.opposite()
    !message      = 'Alternate ' & !detail.lowcase() & ' available'
    AID TEXT  NUMBER $!<this.tagChanges> '$!message' AT $!<tagPosition>
    AID ARROW NUMBER $!<this.tagChanges> AT $!<tagPosition> DIRECTION $!<offsetDir> HEIGHT $!<offset>

  enddo

endmethod
-- End of method definition
$( Remove
------------------------------------------------------------------------
--
-- Method:      orderComponents
--
-- Description: Orders the passed components into their hierarchy sequence
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of database elements
-- Return:
--   [Data Type] [Description]
--    ARRAY       Hierarchical orders sequence of components
--
------------------------------------------------------------------------

define method .orderComponents(!componentList is ARRAY) is ARRAY

  -- Initialise Variables
  !components     = !componentList
  do !i indices !components
    !sequence[!i] = !components[!i].sequence
  enddo

  -- Sort into order
  !indices = !sequence.sortedIndices()
  !components.reIndex(!indices)

  -- Return ordered list
  return !components

endmethod
End Remove$)
------------------------------------------------------------------------
--
-- Method:      adjacent
--
-- Description: Set the adjacent elements for the component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .adjacent()

  -- Get Next and Previous items
  !adjacent       = !this.adjacent(!this.component, !this.flow)
  !this.next      = !adjacent[1]
  !this.previous  = !adjacent[2]

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      adjacent
--
-- Description: Set the adjacent elements for the component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to get adjacent from
--    2   R      BOOLEAN     Flow direction, true for forwards
-- Return:
--   [Data Type] [Description]
--    ARRAY       2 element array, previous and next elements
--
------------------------------------------------------------------------

define method .adjacent(!component is DBREF, !flow is BOOLEAN) is ARRAY

  -- Current component is a Branch
  if(!component.type eq 'BRAN') then

    -- If there are no components
    if(!component.mCount eq 0) then
      !adjacent[1]    = !component
      !adjacent[2]    = !component

      -- Only single component exists
    elseif (!component.mCount eq 1) then
      !adjacent[1]    = !component
      !adjacent[2]    = !component.member[1]

      -- More than one component
    else
      if(!flow) then
        !adjacent[1]  = !component
        !adjacent[2]  = !component.members.first()
      else
        !adjacent[1]  = !component
        !adjacent[2]  = !component.members.last()
      endif
    endif

    -- Component
  else


    -- Previous Component
    var !previousPP split PREVPP of $!<component>
    !previous   = !previousPP[3].dbref()
    -- P30435 if the previous or next component is a spkbrk false atta it is not picked up in tube.
    do
      if (!previous.type.eq('ATTA')) then
        if (!previous.spkbrk.not()) then
          var !previousPP split PREVPP of $!<previous>
          !previous  = !previousPP[3].dbref()
        else
          break
        endif
      else
        break
      endif
    enddo

    -- Next Component
    var !nextPP split NEXTPP of $!<component>
    !next       = !nextPP[3].dbref()
    do
      if (!next.type.eq('ATTA')) then
        if (!next.spkbrk.not()) then
          var !nextPP split NEXTPP of $!<next>
          !next   = !nextPP[3].dbref()
        else
          break
        endif
      else
        break
      endif
    enddo


    -- If the flow if reverse, then flip the previous and next
    if(!flow) then
      !adjacent[1]  = !previous
      !adjacent[2]  = !next
    else
      !adjacent[1]  = !next
      !adjacent[2]  = !previous
    endif

  endif

  -- Return
  return !adjacent

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      skipConnected
--
-- Description: Set skip connected flag
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .skipConnected()

  -- Set State
  !this.skipConnected = !this.skipConn.val

  -- Track to element
  !this.track(!this.component)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      flip
--
-- Description: Flip current created components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flip()

  -- Initialise Variables
  var !mode MODE
  !components = !this.newComponents
  !first      = !components.first()
  !last       = !components.last()

  -- Always work from head - tail
  !this.flow(true)
  -- Start of component group
  !sPosition  = !first.aPosition.wrt(World)
  !sDirection = !first.aDirection.wrt(World)
  !ePosition  = !last.lPosition.wrt(World)
  !eDirection = !last.lDirection.wrt(World)

  -- Determine the offset from the start to the end of the group
  !offset       = N0
  !offset.east  = !sPosition.east   - !ePosition.east
  !offset.north = !sPosition.north  - !ePosition.north
  !offset.up    = !sPosition.up     - !ePosition.up

  -- Re-order the components in the list
  !!ce  = !this.branch

  !item = !first

  !compList = !components
  !compList.compress()
  do !i from 2 to !compList.size()
    !component  = !compList[!i]
    REORDER $!<component> BEFORE $!<item>
    !item       = !component
  enddo

  -- Parallel Arrive/Leave
  if(!sDirection.isParallel(!eDirection)) then
    if(!sDirection.isParallel(!first.orientation.xDir()).not()) then
      !direction  = !sDirection.orthogonal(!first.orientation.xDir())
    elseif (!sDirection.isParallel(!first.orientation.yDir()).not()) then
      !direction  = !sDirection.orthogonal(!first.orientation.yDir())
    else
      !direction  = !sDirection.orthogonal(!first.orientation.zDir())
    endif
    !angle        = 180

    -- Non-parallel Arrive/Leave
  else
    -- Bisect direction between the start and end
    !direction    = !sDirection.bisect(!eDirection)
    !angle        = !sDirection.angle(!eDirection) * 2
  endif

  -- Loop through items, rotate and offset
  do !i indices !components
    !!ce = !components[!i]
    FLIP
    BY $!<offset>
    ROTATE THROUGH $!<sPosition> ABOUT $!<direction> BY $!<angle>
  enddo

  -- Save inverted list to new components
  !components.invert()
  !this.newComponents = !components

  -- Track current component
  --!this.track(!this.component)
  !this.tag()

  -- Revert to original mode
  $!<mode>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      displayMinTubeLength
--
-- Description: Set the minimum tube length gadget from current data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayMinTubeLength()
  if(!this.minTubeLengthExp.set()) then
    !this.minTubeLength.val = !this.minTubeLengthExp
  else
    !this.minTubeLength.val = !this.minTubeLengthVal.string(!!distanceFmt)
  endif
endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      getMinTubeLengthDataCon
--
-- Description: Set the minimum tube length for the component creation from the datacon tolerances
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getMinTubeLengthDataCon()

  -- Get the tolerances from the datacon checks
  VAR !minTubeLength TOLERANCE TUBE
  -- If there's more than one value returned, split them in to an array.
  !tubeBores = !minTubeLength.split()
  -- Reset the array before we get the new values
  !this.minTubeLengthDataCon = ARRAY()
  -- Append the default tube length to the array. (This is used if the bore doesn't fit into any of the ranges defined
  !this.minTubeLengthDataCon.append(!tubeBores.first())
  do !i from 2 to !tubeBores.size() by 3
    -- Create a string to store each bore range
    -- !i = tolerance, !i + 1 = minimum bore, !i + 2 = maximum bore
    !tempTol = !tubeBores[!i] + ' ' + !tubeBores[!i + 1] + ' ' + !tubeBores[!i + 2]
    -- Append the range to the array to be used later
    !this.minTubeLengthDataCon.append(!tempTol)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      getMinTubeLengthForBore
--
-- Description: Get the minimum tube length required from the bore of the component set from the datacon tolerances
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to determine minimum tube length from
-- Return:
--   [Data Type] [Description]
--    REAL        Minimum Tube length
--
------------------------------------------------------------------------
define method .getMinTubeLengthForBore(!component is DBREF, !flow is BOOLEAN) is REAL

  !first = true
  do !boreCheck values !this.minTubeLengthDataCon
    if (!first) then
      -- Set the return value to the default tolerance in case the bore doesnt fit into the defined ranges
      !value = !boreCheck.real()
      !first = false
      skip
    endif
    -- Split the bore check
    !values = !boreCheck.split()
    !min = !values[2].real()
    !max = !values[3].real()
    -- Check whether the bore fits within the range of the tolerance. If it does, then return the tolerance.
    if (!flow) then
      !checkBore = !component.aBore.real()
    else
      !checkBore = !component.lBore.real()
    endif

    if (!checkBore ge !min AND !checkBore le !max) then
      !value = !values[1].real()
      break
    endif
  enddo

  return !value

endmethod


------------------------------------------------------------------------
--
-- Method:      minTubeLength
--
-- Description: Set the minimum tube length for the component creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to determine minimum tube length from
-- Return:
--   [Data Type] [Description]
--    REAL        Minimum Tube length
--
------------------------------------------------------------------------

define method .minTubeLength(!component is DBREF) is REAL

  -- Get current flow
  var !mode MODE
  if(!mode.upCase() eq 'FORWARDS') then
    !flow = true
  else
    !flow = false
  endif

  -- Return min tube length
  return !this.minTubeLength(!component, !flow)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      minTubeLength
--
-- Description: Set the minimum tube length for the component creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to determine minimum tube length from
--    2   R      BOOLEAN     Flow direction
-- Return:
--   [Data Type] [Description]
--    REAL        Minimum Tube length
--
------------------------------------------------------------------------

define method .minTubeLength(!component is DBREF, !flow is BOOLEAN) is REAL

  -- Update the bore range tolerances from the data con checker
  !this.getMinTubeLengthDataCon()

  if (!this.minTubeLengthVal.set()) then
    -- If we have a value set in the component creation user file, use this as a minimum tube length
    !this.minTubeLengthVal = !!pipingSettings.minTube.real()
    return !this.minTubeLengthVal.real()
  elseif (!this.minTubeLengthExp.set()) then
    -- If we have an expression set in the component creation user file, use this to generate a minimum tube length
    !value = !this.minTubeLength(!component, !flow, !this.minTubeLengthExp)
  else
    -- Otherwise use the tolerance bore ranges from the data con checker to generate a minimum tube length
    !value = !this.getMinTubeLengthForBore(!component, !flow)
  endif

  return !value

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      minTubeLength
--
-- Description: Set the minimum tube length for the component creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to determine minimum tube length from
--    2   R      BOOLEAN     Flow direction
--    3   R      STRING      Tube length value/formula
-- Return:
--   [Data Type] [Description]
--    REAL        Minimum Tube length
--
------------------------------------------------------------------------

define method .minTubeLength(!component is DBREF, !flow is BOOLEAN, !tubeLengthData is STRING) is REAL

  -- Initialise Variables
  -- Replacement
  if(!component.type eq 'BRAN') then
    !replacement  = '!component.hstu.catr.para[2]'
  else
    if(!flow) then
      !replacement  = '!component.aod'
    else
      !replacement  = '!component.lod'
    endif
  endif

  -- Replace OD from expression with !this.arriveBore
  !expression = !tubeLengthData
  !expression = !expression.replace('OD',!replacement)

  -- Evaluate the expression
  !value = $!<expression>
  handle ANY
    -- Expression has failed so check if there are any bore specific tube lengths
    !value = !this.getMinTubeLengthForBore(!component, !flow)
  endhandle

  -- Return
  return !value

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      minTubeLength No longer used
--
-- Description: Set the minimum tube length for the component creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .minTubeLength()

  -- Initialise Variables
  !data   = !this.minTubeLength.val.upCase().trim()
  !inputs = !data.split()

  -- More than a single value
  if(!inputs.size() gt 1) then

    -- Get MinTubLength
    !tubeLength     = !this.minTubeLength(!this.component, true, !data)
    if(!tubeLength.unset()) then
      !!alert.warning('Invalid expression.')
      return
    endif

    !this.minTubeLengthExp  = !data
    !this.minTubeLengthVal  = REAL()
    -- Try for a distance
  else

    -- Can we convert this into a real
    !real = !data.real()
    handle ANY
      !!alert.warning('Minimum tube length should be set as a distance or as an expression in terms of OD of pipe, i.e. 2 * OD.')
      return
      -- Valid distance given
    elsehandle NONE
      !this.minTubeLengthExp  = STRING()
      !this.minTubeLengthVal  = !real
    endhandle
  endif

  -- Set gadget
  !this.displayMinTubeLength()

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      displaySnapDistance
--
-- Description: Set the snap distance gadget from current data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displaySnapDistance()
  if(!this.snapDistanceExp.set()) then
    !this.snapDist.val = !this.snapDistanceExp
  else
    !this.snapDist.val = !this.snapDistanceVal.string(!!distanceFmt)
  endif
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      snapDistance
--
-- Description: Set the snap distance for the component creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to determine minimum snap distance from
-- Return:
--   [Data Type] [Description]
--    REAL       Snap distance
--
------------------------------------------------------------------------

define method .snapDistance(!component is DBREF) is REAL

  -- Numeric value for tube length
  if(!this.snapDistanceVal.set()) then
    !value = !this.snapDistanceVal
  elseif !this.snapDistanceExp.set() then
    !value = !this.minTubeLength(!component, true, !this.snapDistanceExp)
  else
    !value = !this.getMinTubeLengthForBore(!component, true)
  endif

  -- Return
  return !value

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      snapDistance Not currently used
--
-- Description: Set the snap distance
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .snapDistance()

  -- Initialise Variables
  !data   = !this.snapDist.val.upCase().trim()
  !inputs = !data.split()

  -- More than a single value
  if(!inputs.size() gt 1) then

    -- Get Snap Distance
    !snapDistance     = !this.minTubeLength(!this.component, !data)
    if(!snapDistance.unset()) then
      !!alert.warning('Invalid expression.')
      return
    endif

    !this.snapDistanceExp  = !data
    !this.snapDistanceVal  = REAL()

    -- Try for a distance
  else

    -- Can we convert this into a real
    !real = !data.real()
    handle ANY
      !!alert.warning('Snap distance should be set as a distance or as an expression in terms of OD of pipe, i.e. 2 * OD.')
      return
      -- Valid distance given
    elsehandle NONE
      !this.snapDistanceExp  = STRING()
      !this.snapDistanceVal  = !real
    endhandle
  endif

  -- Set gadget
  !this.displaySnapDistance()

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      setFlow
--
-- Description: Set creation flow
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for forwards, False for backwards
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFlow(!forwards is BOOLEAN)

  -- Initialise Variables
  !this.flow          = !forwards

  -- Head to Tail
  if(!forwards) then
    !this.toHead.val  = false
    !this.toTail.val  = true
  else
    !this.toHead.val  = true
    !this.toTail.val  = false
  endif

  -- Set current component
  !this.track(!this.component)

  -- we have created a component at this point and we need to set its radius
  -- we have some options but at the moment the radius is set based on the form gadget setting.
  -- Calculates radius of a bend using N*OD option
  if (!this.componentType.val.upCase().eq('BEND')) then
    !radiusMultiplier = !this.bendRadiusOption.selection().real()
    handle ANY
      !radiusMultiplier = object REAL()
    endhandle
    if (!radiusMultiplier.set()) then
      !this.calculateRadius(!radiusMultiplier)
    endif

    -- [daniel : SI-46314 Unable to recognize bending machine radius for two bore sizes on the same pipe]
    !this.selectRadius()
  endif
  -- No need to do anything if there is a selector so long as !radiusMultiplier is unset
  -- need something in the code at the time it populates the list to reset the radius option gadget.
  --

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Track Current Element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  if (defined (!!inassembly)) then
    return
  endif

  --P-13733: Pipe Router Syntax Error
  var !a banner
  if (!a.upCase().occurs('ROUTER').gt(0)) then
    return
  endif
  --EndFix

  -- Check for deleted element
  if(badref(!this.component)) then
    !this.component = object DBREF()
  endif

  -- Don't do anything if passed element is same as current component
  if(!!ce eq !this.component) then

    if(!this.component.type eq 'BRAN') then
      if(!this.flow) then
        !position             = !this.component.hPosition
      else
        !position             = !this.component.tPosition
      endif
    else
      !position               = !this.component.position
    endif

    -- Check if the component has been modified
    if(!position ne !this.componentPosition) then
      !this.componentPosition = !position

      -- Tag information
      !arrivePosition         = !this.componentPosition(!this.component, !this.flow)
      !arriveDirection        = !this.componentDirection(!this.component, !this.flow)
      !this.tagPoint          = object POINTVECTOR(!arrivePosition, !arriveDirection)
      !this.tag()
    endif

    return
  endif

  -- Track to current element

  !this.track(!!ce)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Track with respect to passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to track form to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track(!passedElement is DBREF)

  -- Initialise Variables
  !element    = !passedElement

  -- Handle deleted elements
  if(badref(!element)) then
    !element  = !this.branch
  endif

  if !element.type.eq('PIPCA') then
    return
  endif

  -- Check if valid branch is set
  if(!this.isValid.not()) then
    return
  endif

  -- Tidy reference data
  !this.tidy()

  -- If type is TUBI, then get the element it relates to
  if(!element.type eq 'TUBI') then
    !element  = !element.string().after('OF').dbref()
  endif

  -- Determine we are at a branch or below
  !branch   = !this.getBranch(!element)

  if(!branch.unset()) then
    !this.selectBranch.active = false
    return
  else
    if( !element.owner.type eq 'BRAN') then
      if( badref(!element.spref) ) then
        -- unset spref on component
        return
      endif
    endif
    !this.selectBranch.active = true
  endif

  -- Get Arrive and Leave information for new component and tag point
  if(!branch eq !this.branch) then

    -- Retain old bores
    !oldArriveBore  = !this.arriveBore
    !oldLeaveBore   = !this.leaveBore

    -- Skip connected items
    if(!this.skipConnected and !element.type ne 'BRAN') then

      -- Get connected components
      !connected    = !element.brConnect
      handle(2,201)
        !connected = ARRAY()
      endhandle
      -- TM attas with spkbrk false always have 0 atlen and ltlen so brcon identifies adjacent components
      if (!element.type.eq('ATTA')) then
        if (!element.spkbrk.not()) then
          !connected = ARRAY()
        endif
      endif
      if(!connected.set()) then

        -- Add element to list
        !connected.append(!element)
        !components = !!componentOrder(!connected)

        if(!this.flow) then
          !element  = !components.last()
        else
          !element  = !components.first()
        endif
      endif
    endif

    -- Assign element to component
    !this.component             = !element

    -- Component is a branch
    if(!this.component.type eq 'BRAN') then
      if(!this.flow) then
        !this.componentPosition = !element.hPosition
        !this.tubeOD = !element.phod
        handle ANY
          !this.tubeOD = 0
        endhandle
        !this.wallTH = !element.hwallt
        handle ANY
          !this.wallTH = 0
          !this.getSpecomWall(!this.component.hstube)
          handle ANY
          endhandle
        endhandle
      else
        !this.componentPosition = !element.tPosition

        -- [ daniel : SI-46314 Unable to recognize bending machine radius for two bore sizes on the same pipe ]
        -- if phod equal with ptod, it need to update tube od to calculate bending radius properly
        if (!this.component.phod eq !this.component.ptod) then
          !this.tubeOD = !element.ptod
          !index = !this.specifications[!this.activeSpecIndex].bores.findFirst(!this.component.tBore)
          !sele = !this.specifications[!this.activeSpecIndex].tubing.members[!index]
          handle any
          endhandle

          !spco = !!collectAllFor('SPCO', '', !sele)[1]
          handle any
          elsehandle none
            !this.tubeOD = !spco.para[2]
            handle any
            endhandle
          endhandle
          ------------------------
        else
          !this.tubeOD = !element.ptod
          handle ANY
            !this.tubeOD = 0
          endhandle
        endif

        !this.wallTH = !element.twallt
        handle ANY
          !this.wallTH = 0
          !this.getSpecomWall(!this.component.hstube,!this.arriveBore)
          handle ANY
          endhandle
        endhandle
      endif
    else
      !this.componentPosition   = !element.position
      if (!this.flow) then
        !this.tubeOD = !element.lod
        handle ANY
          !this.tubeOD = 0
        endhandle
        !this.wallTH = !element.lwallt
        handle ANY
          if !element.type.eq('PTAP') then
            !this.wallTH = !this.getAlternateWall(!element)
          else
            !this.wallTH = 0
          endif
        endhandle
      else
        !this.tubeOD = !element.aod
        handle ANY
          !this.tubeOD = 0
        endhandle

        !this.wallTH = !element.awallt
        handle ANY
          if !element.type.eq('PTAP') then
            !this.wallTH = !this.getAlternateWall(!element)
          else
            !this.wallTH = 0
          endif
        endhandle
      endif
    endif


    -- Get the adjacent components
    !this.adjacent()

    -- Determine arrive bore for new component
    !bores            = !this.adjacentBores(!this.component, !this.flow)
    !this.arriveBore  = !bores[1]
    !arrivePosition   = !this.componentPosition(!this.component, !this.flow)
    !arriveDirection  = !this.componentDirection(!this.component, !this.flow)
    !this.leaveBore   = !bores[2]

    -- Define the tag point
    !this.tagPoint    = object POINTVECTOR(!arrivePosition, !arriveDirection)
    handle (2,785)
      -- error where an unset item is passed to track
      -- often caused by undo deleing the current element
      return
    endhandle
    -- If the bore changes, then we need to re-evaluate the selected components
    if(!oldArriveBore.neq(!this.arriveBore).or(!oldLeaveBore.neq(!this.leaveBore))) then
      !this.filterComponents()
    endif

    -- Show Current Bore
    !this.currentBore.val = !this.arriveBore.string(!!boreFmt)


    -- Tag Position
    !this.tag()

    --Lstu Tube available selections
    !this.displayTubes(!element)

    -- [ daniel : SI-46314 Unable to recognize bending machine radius for two bore sizes on the same pipe ]
    if (!this.componentType.val.upCase().eq('BEND')) then
      !this.selectRadius()
    endif

    -- [ daniel : SI-46314 Unable to recognize bending machine radius for two bore sizes on the same pipe ]
    if (!this.componentType.val.upCase().eq('BEND')) then
      !this.selectRadius()
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     .getAlternateWall
--
-- Description: gets the arrive or leave tube wall thickness for PTAPS
--
-----------------------------------------------------------------------
define method .getAlternateWall(!element is DBREF) is REAL

   if (!this.flow) then
      -- try the leave tube
      !return = !element.ltwall
      handle any
        !return = !element.atwall
        handle any
          return 0
        endhandle
      endhandle
   else
      !return = !element.atwall
      handle any
        !return = !element.ltwall
        handle any
          return 0
        endhandle
      endhandle
   endif

   return !return

  endmethod

------------------------------------------------------------------------
--
-- Method:      adjacentBores
--
-- Description: Returns the adjacent bores to the passed component, dependent
--              on the passed flow
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Passed element
--    2   R      BOOLEAN     Current creation flow direction.
-- Return:
--   [Data Type] [Description]
--    ARRAY      2 element array, [1] Arrive bore, [2] Leave bore
--
------------------------------------------------------------------------

define method .adjacentBores(!component is DBREF, !defaultFlow is BOOLEAN) is ARRAY

  -- Initialise Variables
  !bores        = ARRAY()
  !bore         = object BORE()

  !adjacent     = !this.adjacent(!component, !defaultFlow)

  -- Flows
  !flows[1]     = !defaultFlow
  !flows[2]     = !defaultFlow.not()
  !elements[1]  = !component
  !elements[2]  = !adjacent[2]

  -- Get arrive/leave bore
  do !i from 1 to 2
    !flow       = !flows[!i]
    !element    = !elements[!i]

    -- Branch
    if(!element.type eq 'BRAN') then
      if(!flow) then
        !bore   = !element.phBore
      else
        !bore   = !element.ptBore
      endif

      -- Component
    else

      -- Component with a specification reference
      if(!element.spref.set()) then

        if(!flow) then
          !bore = !element.lBore
        else
          !bore = !element.aBore
        endif

        -- Component with no specification reference
      else

        -- Determine the bore from the upstream component
        if(!flow) then

          -- Component is first in the list
          if(!element.sequence eq 1) then
            !bore = !element.owner.hBore

            -- Roll back along the tube until we have an lBore
          else
            !from = !element.sequence - 1
            do !j from !from to 1 by -1
              if(!element.owner.members[!j].spref.set()) then
                !bore = !element.owner.members[!j].lBore
                break
              endif

            enddo
            if(!bore.unset()) then
              !bore = !element.owner.hBore
            endif

          endif

          -- Determine the bore form the down stream component
        else

          -- Component is last in the list
          if(!element.sequence eq !element.owner.mCount) then
            !bore = !element.owner.tBore

          else

            do !j from !element.sequence + 1 to !component.owner.mCount
              if(!element.owner.members[!j].spref.set()) then
                !bore = !element.owner.members[!j].aBore
                break
              endif

            enddo
            if(!bore.unset()) then
              !bore = !element.owner.tBore
            endif

          endif

        endif

      endif

      -- End of component
    endif

    -- Set arrive bore
    !bores[!i] = !bore

  enddo

  -- Return
  return !bores

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentPosition
--
-- Description: Returns the position of the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Passed element
--    2   R      BOOLEAN     Current creation flow direction.
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .componentPosition(!component is DBREF, !flow is BOOLEAN) is POSITION

  -- Initialise Variables
  !position     = object POSITION()

  -- Branch
  if(!component.type eq 'BRAN') then
    if(!flow) then
      !position = !component.hPosition
    else
      !position = !component.tPosition
    endif

    -- Component
  else

    !position = object POSITION()
    if(!flow) then
      !position = !component.lPosition
      handle(2,201)
      endhandle
    else
      !position = !component.aPosition
      handle(2,201)
      endhandle
    endif

    -- End of component
  endif

  -- Return
  return !position

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      adjacentPosition
--
-- Description: Returns the adjacent position to the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Passed element
--    2   R      BOOLEAN     Current creation flow direction.
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------

define method .adjacentPosition(!component is DBREF, !flow is BOOLEAN) is POSITION

  -- Initialise Variables
  !position       = object POSITION()

  -- Branch
  if(!component.type eq 'BRAN') then
    if(!flow) then
      !position   = !component.hPosition.wrt(world)
    else
      !position   = !component.tPosition.wrt(world)
    endif

    -- Component
  else

    if(!flow) then
      var !previousStr PREVPP of $!<component>
      !previous   = !previousStr.part(3).dbref()
      if(!previous.type eq 'BRAN') then
        !position = !previous.hPosition.wrt(world)
      else
        !position = !previous.lPosition.wrt(world)
      endif
    else
      var !nextStr NEXTPP of $!<component>
      !next       = !nextStr.part(3).dbref()
      if(!next.type eq 'BRAN') then
        !position = !next.tPosition.wrt(world)
      else
        !position = !next.aPosition.wrt(world)
      endif
    endif

    -- End of component
  endif

  -- Return
  return !position

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentDirection
--
-- Description: Returns the direction to the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Passed element
--    2   R      BOOLEAN     Current creation flow direction.
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction
--
------------------------------------------------------------------------

define method .componentDirection(!component is DBREF, !flow is BOOLEAN) is DIRECTION

  -- Initialise Variables
  !direction      = object DIRECTION()

  -- Branch
  if(!component.type eq 'BRAN') then
    if(!flow) then
      !direction  = !component.hDirection
    else
      !direction  = !component.tDirection
    endif

    -- Component
  else

    if(!flow) then
      !direction  = !component.lDirection
    else
      !direction  = !component.aDirection
      handle (2,201)
        -- occurs when spref unset. try opposite to leave
        !direction  = !component.lDirection.opposite()
        handle any
          -- this direction may not be correct, but must fall back to some direction
          !direction = !component.owner.tDirection
        endhandle
      endhandle
    endif

    -- End of component
  endif

  -- Return
  return !direction

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      adjacentDirection
--
-- Description: Returns the adjacent direction to the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Passed element
--    2   R      BOOLEAN     Current creation flow direction.
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction
--
------------------------------------------------------------------------

define method .adjacentDirection(!component is DBREF, !flow is BOOLEAN) is DIRECTION

  -- Initialise Variables
  !direction        = object DIRECTION()

  -- Branch
  if(!component.type eq 'BRAN') then
    if(!flow) then
      !direction    = !component.hDirection.wrt(world)
    else
      !direction    = !component.tDirection.wrt(world)
    endif

    -- Component
  else

    if(!flow) then
      var !previousStr PREVPP of $!<component>
      !previous     = !previousStr.part(3).dbref()
      if(!previous.type eq 'BRAN') then
        !direction  = !previous.hDirection.wrt(world)
      else
        !direction  = !previous.lDirection.wrt(world)
      endif
    else
      var !nextStr PREVPP of $!<component>
      !next         = !nextStr.part(3).dbref()
      if(!next.type eq 'BRAN') then
        !direction  = !next.tDirection.wrt(world)
      else
        !direction  = !next.aDirection.wrt(world)
      endif
    endif

    -- End of component
  endif

  -- Return
  return !direction

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getBranch
--
-- Description: Returns branch from passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Passed element
-- Return:
--   [Data Type] [Description]
--    DBREF       Branch
--
------------------------------------------------------------------------

define method .getBranch(!element is DBREF) is DBREF

  -- Get owning types
  !pTypes   = !element.ahlist
  !pTypes.append(!element.type)
  !index    = !pTypes.findFirst('BRAN')

  -- No branch above current element
  if(!index.unset()) then
    return object DBREF()
  else
    !parents  = !element.ownlst
    !parents.append(!element)
    return !parents[!index]
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form on show for current element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()


  -- Initialise Variables
  !this.arriveBore      = object BORE()
  !this.newComponent    = object DBREF()
  !this.newComponents.clear()
  !this.multipleSelect.clear()
  !this.assemblyFrame.visible = FALSE

  -- Get Branch
  !branch                 = !this.getBranch(!!ce)

  -- Check that we have a branch
  if(!branch.unset()) then

    -- Initialise information
    !this.branchName.val  = 'unset'
    !this.currentSpec.val = ''
    !this.currentBore.val = ''
    !message              = ARRAY()
    !message.append('This command can only be used at a Branch or piping component.')
    !message.append('Navigate to a branch or component and use the "Set Branch" button.')

    -- Push into an error panel
    !this.warning(!message, false)

    return

  endif

  -- Setup form to passed element
  !this.setBranch(!!ce)

  -- reset the assembly list every time the form is shown
  !this.assemblies = object PIPINGASSEMBLYMGR(TRUE)

  -- Calculates radius of a bend using N*OD option
  !radiusMultiplier = !this.bendRadiusOption.selection().real()
  handle ANY
    !radiusMultiplier = object REAL()
  endhandle
  if (!radiusMultiplier.set()) then
    !this.calculateRadius(!radiusMultiplier)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isValidBranch
--
-- Description: Check validity of branch before we continue
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       Message array when invalid
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if branch is valid
--
------------------------------------------------------------------------

define method .isValidBranch(!message is ARRAY) is BOOLEAN

  -- Check Specification is Set
  if(!this.branch.pspec.unset() or badref(!this.branch.pspec)) then
    !message  = ARRAY()
    !message.append('Unable to create component, branch does not have a valid pipe')
    !message.append('specification. Please set specification before creating components.')
    return false
  endif

  -- Check bores are set
  if(!this.branch.hBore.unset() or !this.branch.tBore.unset()) then
    if(!this.branch.hBore.unset() and !this.branch.tBore.unset()) then
      !text     = 'as both the head and tail bores are unset'
      !boreText = 'bores'
    elseif (!this.branch.hBore.unset()) then
      !text     = 'as the head bore is unset'
      !boreText = 'the head bore'
    else
      !text     = 'as the tail bore is unset'
      !boreText = 'the tail bore'
    endif
    !message  = ARRAY()
    !message.append('Unable to create component, ' & !text & '.')
    !message.append('Please set ' & !boreText & ' before creating components.')
    return false
  endif

  -- Check that head/tail have been defined
  if(!this.branch.lHead.not() or !this.branch.lTail.not()) then
    if(!this.branch.lHead.not() and !this.branch.lTail.not()) then
      !text     = 'as both the head and tail are not defined fully'
      !boreText = 'both the head and tail'
    elseif (!this.branch.lHead.not()) then
      !text     = 'as the head has not been fully defined'
      !boreText = 'the head'
    else
      !text     = 'as the tail has not been fully defined'
      !boreText = 'the tail'
    endif
    !message  = ARRAY()
    !message.append('Unable to create component, ' & !text & '.')
    !message.append('Please define ' & !boreText & ' before creating components.')
    return false
  endif

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setBranch
--
-- Description: Setup form for current branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to set up form with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setBranch(!passedElement is DBREF)

  -- Initialise Variables
  !element    = !passedElement
  !this.component = object DBREF()

  if(badref(!element)) then
    !element  = !!ce
  endif

  -- Get Branch
  !branch     = !this.getBranch(!element)

  -- If branch is same as the current branch, then we won't do anything
  if(!branch.unset()) then
    return
  endif

  -- Have we got creat access
  if(!!dbrefUpdatable(!branch).not()) then
    !message  = ARRAY()
    !message.append('Unable to modify branch, check access to modify and resolve')
    !message.append('or navigate to a branch with write access and press "Set Branch".')
    !this.warning(!message, false)
    return
  endif

  -- Initialise Variables
  !this.branch        = !branch
  !this.arriveBore    = object BORE()
  !this.newComponent  = object DBREF()
  !this.newComponents.clear()
  !this.multipleSelect.clear()

  -- Verify Branch
  !message            = ARRAY()
  !this.isValid       = !this.isValidBranch(!message)
  if(!this.isValid.not()) then
    !this.warning(!message, false)
    return
  endif

  -- Clear adjacent information
  !this.adjacentClear()

  -- Setup with current options
  !this.setupOptions()

  -- Current bore of component
  !this.currentBore.val       = !this.branch.hBore.string(!!boreFmt)

  -- Setup current specification to branch spec
  !this.branchSpecification   = !this.branch.pspec
  !this.currentSpecification  = !this.branchSpecification

  -- Set Branch Information
  !this.branchName.val        = !this.branch.flnn
  !this.currentSpec.val       = !this.branchSpecification.flnn

  -- Set alternative
  !this.selectAlternativeSpec(!this.branchSpecification)

  --Lstu Tube available selections at branch level
  !this.displayTubes(!this.branch)

  -- Setup default task (select component type)
  !this.setTask('selectType')

  -- Setup spec for current branch specification
  !this.pipeSpecification()

  -- Track current element
  !this.toHead.val  = !this.flow.not()
  !this.toTail.val  = !this.flow

  !this.track(!!ce)

  -- Mark head and tail of branch
  !!aidNumbers.hide(!this.branchTagID)
  if(!this.branch.lHead) then
    !tagPosition = !this.branch.hPosition
    AID TEXT NUMBER $!<this.branchTagID> 'Head' AT $!<tagPosition>
  endif
  if(!this.branch.lTail) then
    !tagPosition = !this.branch.tPosition
    AID TEXT NUMBER $!<this.branchTagID> 'Tail' AT $!<tagPosition>
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupSpecifications
--
-- Description: Setup Specifications
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupSpecifications()

  -- Populate lists
  -- Pipe Specs
  if(!this.pipingSpecs.piping()) then
    !pDisplay                 = !this.pipingSpecs.descriptions
    !pReplace                 = !this.pipingSpecs.refStrings
  else
    !pDisplay[1]              = 'None Available'
    !pReplace[1]              = ''
  endif
  !this.specList.dText        = !pDisplay
  !this.specList.rText        = !pReplace
  !this.specificationIndices  = !this.pipingSpecs.references

  -- Insulation Specs
  if(!this.insulationSpecs.insulation()) then
    !iDisplay[1]              = 'None'
    !iReplace[1]              = ''
    !iDisplay.appendArray(!this.insulationSpecs.descriptions)
    !iReplace.appendArray(!this.insulationSpecs.refStrings)
    !this.insulation.active   = true
  else
    !iDisplay[1]              = 'None Available'
    !iReplace[1]              = ''
    !this.insulation.active   = false
  endif
  !this.insulation.dText      = !iDisplay
  !this.insulation.rText      = !iReplace

  -- Tracing Specs
  if(!this.tracingSpecs.tracing()) then
    !tDisplay[1]              = 'None'
    !tReplace[1]              = ''
    !tDisplay.appendArray(!this.tracingSpecs.descriptions)
    !tReplace.appendArray(!this.tracingSpecs.refStrings)
    !this.tracing.active      = true
  else
    !tDisplay[1]              = 'None Available'
    !tReplace[1]              = ''
    !this.tracing.active      = false
  endif
  !this.tracing.dText         = !tDisplay
  !this.tracing.rText         = !tReplace

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      control
--
-- Description: Control
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .control(!type is STRING)

  -- Initialise Variables
  -- Select Components
  if(!type eq 'component') then
    !this.componentFrame.visible      = true
    !this.specificationFrame.visible  = false
    !this.optionsFrame.visible        = false

    !switch                           = true

    -- Select Specification
  elseif (!type eq 'specification') then
    !this.componentFrame.visible      = false
    !this.specificationFrame.visible  = true
    !this.optionsFrame.visible        = false

    !switch                           = true

    -- Set Options
  elseif (!type eq 'options') then
    !this.componentFrame.visible      = false
    !this.specificationFrame.visible  = false
    !this.optionsFrame.visible        = true

    !switch                           = true

    -- No Branch Selected
  else
    !this.componentFrame.visible      = false
    !this.specificationFrame.visible  = false
    !this.optionsFrame.visible        = FALSE
    !this.assemblyFrame.visible       = FALSE
    !switch                           = false

  endif

  -- Allow Switching
  !this.setComponent.active           = !switch
  !this.setSpecification.active       = !switch
  !this.setOption.active              = !switch

  -- Toggle buttons
  !this.setComponent.val              = !this.componentFrame.visible
  !this.setSpecification .val         = !this.specificationFrame.visible
  !this.setOption.val                 = !this.optionsFrame.visible

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pipeSpecification
--
-- Description: Revert to pipe specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeSpecification()

  -- Insulation Specification
  !insulationSpec = !this.branch.iSpec
  if(!insulationSpec.unset()) then
    !this.insulation.select('rText','')
  else
    !this.insulation.select('rText', !insulationSpec.refNo.string())
  endif

  -- Tracing Specification
  !tracingSpec    = !this.branch.tSpec
  if(!tracingSpec.unset()) then
    !this.tracing.select('rText','')
  else
    !this.tracing.select('rText', !tracingSpec.refNo.string())
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Warning message
--    2   R      BOOLEAN     True if Done button is allowed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is STRING, !allowDone is BOOLEAN)
  !messageArray[1] = !message
  !this.warning(!messageArray, !allowDone)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      BOOLEAN     True if Done button is allowed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !allowDone is BOOLEAN)

  -- Initialise Variables
  !display  = ''

  !this.setTask('warning')
  do !i indices !message
    !display = !display & ' ' & !message[!i]
  enddo

  !this.setTask('warning')
  !this.warning.val               = !display.trim()
  !this.warningDone.callback      = '!this.resumeTask()'
  !this.warningDone.active        = !allowDone

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      resumeTask
--
-- Description: Revert to current task after a warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resumeTask()
  !this.setTask(!this.currentTask)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setTask
--
-- Description: Switch the relevant panels in and out for passed task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!formTask is STRING)

  -- Initialise Variables
  !activeTask       = !this.currentTask
  !task             = !formTask.upCase()
  !this.currentTask = !task

  -- Initialise all task gadgets
  if(!task eq 'INITIALISE') then
    !this.warningGadgets(false)
    !this.typeGadgets(false)
    !this.componentGadgets(false)
    !this.modifyGadgets(false)
    !this.specGadgets(false)
    !this.optionGadgets(false)
    return
  endif

  -- Stop alternative spec being turned on
  if(!task ne 'SELECTTYPE') then
    !this.outSpec.active      = false
  endif

  ------- Remove existing task gadgets
  -- Remove warning task
  if(!this.warningTask) then
    !this.warningGadgets(false)

    -- Remove currently active task
  else

    -- Remove component selection task
    if(!activeTask eq 'SETSPECIFICATION') then
      !this.specGadgets(false)

      -- Remove create task
    elseif (!activeTask eq 'SELECTCOMPONENT') then
      !this.componentGadgets(false)

      -- Remove modify task
    elseif (!activeTask eq 'MODIFY') then
      !this.undo.endUndoable()
      !this.modifyGadgets(false)

      -- Remove option task
    elseif (!activeTask eq 'OPTIONS') then
      !this.optionGadgets(false)

      -- Remove Select component type task
    elseif (!activeTask eq 'SELECTTYPE') then
      !this.typeGadgets(false)
      !this.checkBore = object BORE()
    endif

  endif

  ------------ Show alternative specification selection gadgets
  if(!task eq 'SETSPECIFICATION') then

    -- Modification inactive
    !this.modifyActive  = false

    -- Select current alternative specification
    if(!this.alternativeSpec.unset()) then
      !this.specList.clearSelection()
    else

      !this.specList.select('rText',!this.alternativeSpec.string())
      handle ANY
      endhandle
    endif

    !this.outSpec.active = !this.alternativeSpec.set() and !this.alternativeSpec ne !this.branchSpecification

    -- Display gadgets
    !this.specGadgets(true)

    ------------ Show component selection and creation gadgets
  elseif (!task eq 'SELECTCOMPONENT') then
    !!aidNumbers.hide(!this.tagChanges)

    -- Modification inactive
    !this.modifyActive  = false

    -- Display gadgets
    !this.componentGadgets(true)

    -- Check if there are any associated components
    !componentType              = !this.componentList.selection()
    !componentObject            = !this.componentObject(!componentType)

    !this.createAdjacent.active = !componentObject.adjacentComponents().set()
    !this.adjacentSpec.active   = !this.outSpec.val and !this.createAdjacent.active and !this.alternativeSpec.set() and !this.alternativeSpec ne !this.branchSpecification

    if(!this.outSpec.val.not()) then
      !this.adjacentSpec.val    = false
    endif

    -- Maintain Component Data Frame
    !this.initialiseFrame(!componentType)

    -- Set component type
    !this.loadComponents()

    -- click on the first item
    !this.selectChoice()

    ------------ Show component modification gadgets
  elseif (!task eq 'MODIFY') then

    -- Display Gadgets
    !this.modifyGadgets(true)

    ------------ Show option gadgets
  elseif (!task eq 'OPTIONS') then

    -- Display Gadgets
    !this.optionGadgets(true)

    ------------ Show component type selection gadgets
  elseif (!task eq 'SELECTTYPE') then

    -- Modification inactive
    !this.modifyActive  = false

    -- Make out of spec active
    !this.outSpec.active = !this.alternativeSpec.set() and !this.alternativeSpec ne !this.branchSpecification

    -- Set Creation Specification
    !this.setAlternativeSpec()

    -- Unselect component type selected
    !this.componentList.clearSelection()
    --CW
    !this.loadComponents()

    -- Show gadgets
    !this.typeGadgets(true)

    ------------ Show warning gadgets
  elseif (!task eq 'WARNING') then
    !this.warningGadgets(true)

    -- Remember previous task
    !this.currentTask = !activeTask

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningGadgets
--
-- Description: Shows/Hides the gadgets associated with the spec task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for show, false for hide
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningGadgets(!show is BOOLEAN)

  -- Initialise Variables
  !this.warningTask           = !show

  !this.warningIcon.visible   = !show
  !this.warningTag.visible    = !show
  !this.wLine.visible         = !show
  !this.warning.visible       = !show
  !this.warningDone.visible   = !show

  !this.outSpec.visible       = !show.not()
  !this.outSpecName.visible   = !show.not()
  !this.setSpec.visible       = !show.not()
  if(!show) then
    !this.warningDone.setFocus()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      specGadgets
--
-- Description: Shows/Hides the gadgets associated with the spec task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for show, false for hide
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specGadgets(!show is BOOLEAN)

  -- Initialise Variables
  !this.specList.visible    = !show
  !this.insulation.visible  = !show
  !this.tracing.visible     = !show
  !this.specDone.visible    = !show
  if(!show) then
    !this.specDone.setFocus()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentGadgets
--
-- Description: Shows/Hides the gadgets associated with the create task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for show, false for hide
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentGadgets(!show is BOOLEAN)

  -- Initialise Variables
  !this.componentType.visible       = !show
  !this.chooseType.visible          = !show
  !this.filterTag.visible           = !show
  !this.fLine.visible               = !show
  !this.fFline.visible              = !show
  !this.sTypes.visible              = !show
  !this.typeSelectTag.visible       = !show
  !this.cLine.visible               = !show
  !this.choices.visible             = !show
  !this.componentBendFrame.visible  = !show
  !this.createTag.visible           = !show
  !this.nLine.visible               = !show

  if (!this.noLstuSpecs.gt(1)) then
    !this.lstu.visible = !show
  else
    !this.lstu.visible = FALSE
  endif

  !this.toTail.visible              = !show
  !this.toTailTag.visible           = !show
  !this.toHead.visible              = !show
  !this.toHeadTag.visible           = !show
  !this.createAdjacent.visible      = !show
  !this.adjacentSpec.visible        = !show
  !this.skipConn.visible            = !show
  !this.create.visible              = !show
  !this.createPick.visible          = !show
  !this.create3D.visible            = !show
  !this.flip.visible                = FALSE


  -- Hide component specific panes
  !this.componentElbowFrame.visible = false
  !this.componentBendFrame.visible  = false
  !this.componentReduFrame.visible  = false
  !this.componentTeeFrame.visible   = FALSE
  --!this.assemblyFrame.visible = FALSE

  if(!show) then
    !this.choices.setFocus()
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      modifyGadgets
--
-- Description: Shows/Hides the gadgets associated with the modify task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for show, false for hide
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGadgets(!show is BOOLEAN)

  -- Initialise Variables
  !this.modifyTag.visible       = !show
  !this.mLine.visible           = !show
  !this.adjacentType.visible    = !show
  !this.adjacentSelect.visible  = !show
