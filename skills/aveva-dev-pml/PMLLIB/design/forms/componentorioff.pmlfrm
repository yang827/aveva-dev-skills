-- File:            componentorioff.pmlfrm
--   Type  :        Form Definition
--   Group :        Piping Application
--
--   Keyword :      PIPING
--   Module  :      design
--   Replaces:
--
-- Author:          Tony Martin
-- Created:         13/04/2011 09:13:54
--
--
-- Description:
-- orientates p3 of a tee including nomDir
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  checkDirection(STRING)           -                   validate what was entered into the direction gadget
--  getNomDir(STRING)                STRING
--  init()                           -                   set the form up depending on which slope type is used
--  undo()                           -                   called by the reset button
--
setup form !!componentOriOff
title |Orientate Component Offset|
init |!this.init()|
button .ceInit | CE | at 0 0 call |!this.init()|
para .n at xmax ymin text |name |
path right
hdist 1
para .dbref width 20 lines 1
path down
vdist 0.5
text .dir |Direction | at xmin.ceInit ymax+0.5 call |!this.checkDirection(!this.dir.val)| width 18 string
vdist 1

button .apply | Apply | call |!this.apply()|
path right
hdist 1
button .reset   | Reset | call |!this.undo()| reset
button .dismiss |Dismiss| call |axes delete| cancel

member .ce      is DBREF
member .undo    is UNDOABLE
member .ceOri is ORIENTATION
member .leaveDirection is DIRECTION
member .correctedLeaveDirection is STRING
member .arriveDirection is DIRECTION
member .correctedArriveDirection is STRING
member .ceIsWobbly is BOOLEAN
member .ceMaxOffset is REAL
member .ceWobblyPPoint is REAL
member .cenomDir is DIRECTION
member .nomDir is DIRECTION
member .currentppoint is REAL
member .sloRef is DBREF
member .format is FORMAT

exit


------------------------------------------------------------------------
--
-- Method:    init
--
-- Description: set the form up depending on which slope type is used
--
--
------------------------------------------------------------------------
define method .init()

-- check that we are firstly at a piping component
!this.ce = !!ce

end

handle (2,112)
   -- illegal end command
   return error 1 |not at a component|
endhandle
var !type type

same
if (|$!type| neq |BRAN| and |$!type| neq |HANG|) then
   return error 1 |not at a component|
endif

-- ok can we change it let pdms do error handling

by e 0

-- is it a component with a p3

var !unusedP3Test p3
handle any
   return error 2 |component does not have an offset|
endhandle


!this.ceOri = !!ce.orientation

!this.dbref.val = !!ce.flnm
-- put the current 3 direction in

!direction = !!ce.pdir[3]
!this.dir.val = !direction.string().before(' WRT')
axes at p3

!this.validateComponent(!!ce)
endmethod

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: perform the orientation
--
--
------------------------------------------------------------------------
define method .apply()

  !this.undo.add()
!!ce = !this.ce
!this.validateComponent(!!ce)
var !arr arr
var !lea lea
var !mode mode

if (|$!mode| eq |Forwards| and $!arr eq 3) then
   back
   ori and p3 is $_dir
   handle (61,7)
      error |unable to orientate offset $_dir|
      var _dir dir p3
      forw
      return
   endhandle
   forw
elseif (|$!mode| eq |Backwards| and $!lea eq 3) then
   forw
   ori and p3 is $_dir
   handle (61,7)
      error |unable to orientate offset $_dir|
      var _dir dir p3
      back
      return
   endhandle
   back
else
   ori and p3 is $_dir
   handle (61,7)
      error |unable to orientate offset $_dir|
      var _dir dir p3
      return
   endhandle
endif

!nomDir = object STRING()
nomdir unset
if !this.ceIsWobbly then
     !nomDir = !this.getNomDir(!this.dir.val.trim())
endif

axes at p3
var _dir dir p3
if !nomDir.set() then
  nomDir $!nomDir
  handle ANY
    endhandle
  else
    nomDir unset
    handle ANY
    endhandle
  endif

  !this.init()
  !this.undo.endundoable()

endmethod
------------------------------------------------------------------------
--
-- Method:    getNomDir
--
-- Description: get the current p3 direction
--
--
------------------------------------------------------------------------
define method .getNomDir(!dir is STRING) is STRING
  !currentP3Dir = !!ce.pDirection[3].wrt(/* )
  !angle = !currentP3Dir.angle(!this.dir.val.direction())

--check inputted angle doesnt exceed offtol on component --

 if !angle.gt(!this.ceMaxOffset) then
 	  !!alert.error('angle between p3 and required offset( $!angle )leave is greater than the maximum allowed ($!this.ceMaxOffset)')
 	  return object STRING()
  handle ANY
    endhandle
 	
  elseif !currentP3Dir.string().before(' WRT').neq(!dir) then
    return !dir
  else
    return object STRING()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      undo
--
-- Description: called by the reset button
--
--
------------------------------------------------------------------------
define method .undo()

  UNDODB
  handle ANY
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      validateComponent
--
-- Description: finds if we have a wobbly ppoint and which end it is
--
--
------------------------------------------------------------------------
 define method .validateComponent(!component is DBREF)

  !test = !!componentslope(!component)
  if !test[1] then
    !this.ceIsWobbly = TRUE
    !this.ceWobblyPPoint = !test[2]
    !this.ceMaxOffset = !test[3].real()
    if defined(!test[4]) then
      !this.sloRef = !test[4]
    endif
  else
    !this.ceIsWobbly     = FALSE
    !this.ceWobblyPPoint = -1
    !this.ceMaxOffset    = -1
    !this.sloRef = object DBREF()
  endif

 endmethod

------------------------------------------------------------------------
--
-- Method:      checkDirection
--
-- Description: validate what was entered into the direction gadget
--
--
------------------------------------------------------------------------
define method .checkDirection(!direction is STRING)

  !dir = !direction.direction()
  handle ANY
    !!alert.error('invalid direction $!direction')
    !this.init()
  endhandle

endmethod
