--
-- Description:
-- Pipe component selection form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angleGadgets(STRING)             ARRAY               Returns the gadgets used for setting the angle of the passed
--  applyLstu()                      -
--  arriveLeave(REAL,REAL)           -                   Switch Tee Arrive/Leave
--  arriveLeaveGadgets(STRING)       ARRAY               Returns the gadget used for setting the arrive/leave of
--  arriveLeaveSetup(ANY)            -                   The Arrive/Leave information for the current component
--  boreGadget(STRING)               GADGET              Returns the gadget used for setting the bore of the passed
--  changeAngle()                    -                   Change angle value for supplied type
--  changeComponentType()            -                   Change Component Type
--  checkComponents()                -
--  choices(ANY)                     ARRAY               Get the choices for the current selection
--  close()                          -                   Close form
--  componentIndex(STRING)           REAL                Return component index for passed type
--  componentListText(ARRAY)         ARRAY               Returns list text (display & replacement) for passed components
--  componentObject(STRING)          ANY                 Return component object for passed type
--  componentSelection()             -                   Constructor
--  componentSpecification()         -                   Setup using components specification
--  componentSpecification(DBREF)    DBREF               Get component specification
--  defaultSettings()                -                   Default Settings
--  displayBores()                   -                   Display the currently available bores
--  displayChoices()                 -                   Display the currently available components
--  displayStypes()                  -                   Display the currently available stypes
--  displayTubes()                   -
--  errors()                         -                   Check for errors
--  filterChoices()                  -                   Filter available components by stype and current settings
--  filterChoices(ANY)               ARRAY               Filter available components by stype and current settings
--  frameIndex(STRING)               REAL                Return frame index for passed type
--  initialiseFrame(ANY)             BOOLEAN             Initialise for Frame for a component
--  insulationSpecification()        -                   Set insulation spec of component
--  loadChangeTypes()                -                   Determines the possible change types for the current component
--  loadTubes(GADGET,BORE,DBREF)     REAL
--  objectIndex(STRING)              REAL                Return object index for passed type
--  pipeSpecification()              -                   Revert to pipe specification
--  questionsAndAnswers(ANY)         ARRAY               Returns a 2D array of questions and answers for the passed
--  radiusGadgets(STRING)            ARRAY               Returns the gadget used for setting the radius of the passed
--  readOptions()                    -                   Write options to users file
--  reconnect(BOOLEAN)               -                   Re-establish connections of adjacent components
--  registerAngle(STRING,GADGET,GADGET,GADGET) -                   Setup angle gadgets for passed element type
--  registerArriveLeave(STRING,REAL,REAL,GADGET) -                   Setup arrive and leave gadgets for passed element type.
--  registerBore(STRING,GADGET)      -                   Setup bore gadgets for passed element type
--  registerComponent(STRING,GADGET,ANY) REAL                Register Data Frame
--  registerRadius(STRING,GADGET,GADGET) -                   Setup radius gadgets for passed element type
--  selectChoice()                   -                   Select the current choice and setup other gadgets
--  selectComponentType()            -                   Select Component Type
--  selectCurrentComponent()         -                   Select Current Component Information
--  selectOptions()                  -                   Select Stype and Bore options for selected component
--  selectRadius()                   -                   Select radius by OD or allow explicit definition
--  selectRadius(STRING)             -                   Select radius option for supplied type
--  selectSpecification()            -                   Select Specification
--  selectSpecification(DBREF)       -                   Select Specification
--  setBendRadius(DBREF)             -
--  setFlangeAllowance(DBREF)        -                   Called to test if a radius can be machine defined
--  setOffLineFlag(DBREF)            -
--  setOption(GADGET,STRING)         -                   Sets passed option and writes information to users configuration file
--  setRadius()                      -                   Select radius option for supplied type
--  setSpecAttributes(DBREF)         -                   Sets component attributes to from specification
--  setSpecifications(DBREF,DBREF,DBREF) -
--  setup()                          -                   Setup form on being shown
--  setupOptions()                   -                   Setup options frame to current settings
--  setupSpecifications()            -                   Setup Specifications
--  systemDefaults()                 -                   Revert to system defaults
--  tag()                            -                   Tag current position
--  tidy()                           -                   Tidy reference data
--  tracingSpecification()           -                   Set insulation spec of component
--  track()                          -                   Track Current Element
--  track(DBREF)                     -                   Track with respect to passed element
--  updateComponent()                -                   Update components, modified by external means
--  writeOptions()                   -                   Write options to user's file
--
------------------------------------------------------------------------

setup form !!componentSelection dialog dock right

  !this.iconTitle     = 'Component Selection'
  !this.formTitle     = 'Component Selection'
  !this.callback      = '!this.setup()'
  !this.formRevision  = ' $Revision: 1.9 $ '
  track 'DESICE'    call '!this.track()'
--  track 'DBCHANGED' call '!this.track()'

  -- Body of form definition

  -- Current Component
  toggle    .trackCE                                                    at xmin                     ymax            callback '!this.track()' tooltip 'No tracking'
  valign centre
  paragraph .componentName  anchor left + right + top                   at xmax                                     width 27 lines 1

  -- Tab set for main components of form
  frame .tabs tabset        anchor left + right + top + bottom          at xmin form                ymax

    -- Component Selection Frame
    frame .componentFrame     'Components'    anchor right + left + top at xmin ymin+1

      -- Component/branch specification
      paragraph .currentSpec at x0.5 y0.2                                                                           width 24 lines 1
      paragraph .boreTag      anchor left + top                 at x0.5               ymax-0.2          text 'Bore :' width 5
      paragraph .currentBore           at xmin 5 ymin            width 18
      -- List of possible change types for component
      option .componentList 'Type'                                      at x0.5                     ymax            callback '!this.changeComponentType()' width 17

      -- Available sTypes
      option .sTypes 'Sub-Types'        anchor left + top              at xmax.componentList-size  ymax            callback '!this.filterChoices()'  tooltip 'Available Sub-Types for component' width 8

      -- List of available elements (similar to choose)
      list   .choices                       anchor all                  at xmin.componentList       ymax            callback '!this.selectChoice()' single zeroSelection width 24 lines 7

      option .lstu 'Leave Tube:' anchor left+right+bottom    at xmin                ymax+0.2                       callback '!this.applyLstu()' tooltip 'Leave Tube Specification' width 11

      -- Bend Data
      frame .componentBendFrame 'Bend Information'  anchor right + left + bottom at xmin.choices    ymax.lstu+0.2    width 26

        -- Radius
        option .bendRadiusOption 'Radius'                               at x1                       ymax            callback '!this.selectRadius()'  width 6
        path down
        halign right
        text   .bendRadius                                                                                          callback '!this.setRadius()'  width 10 is REAL format !!distanceFmt

      exit
      -- End of Bend Data

      ------------------ Elbow Data
      frame .componentElbowFrame 'Elbow Information'  anchor right + left + bottom at xmin.choices    ymax.lstu+0.2    width 26

        -- Angle
        path right
        paragraph .angleLabel text 'Angle'                  width 8
        text .angle at xmax    y1                           callback '!this.changeAngle()'         width 8 is REAL format !!angleFmt
        paragraph .minAngleLabel at x1 ymax text 'Min'                 width 8
        text .minAngle at xmax    y2                        width 8 is REAL format !!angleFmt
        paragraph .maxAngleLabel at x1 ymax text 'Max'                 width 8
        text .maxAngle at xmax    y3                        width 8 is REAL format !!angleFmt
      exit
      ------------------ End of Elbow Data

      -- Reducer Data
      frame .componentReduFrame 'Reducer Information' anchor right + left + bottom at xmin.choices  ymax.lstu+0.2    width 26

        -- Leave Bore
        option .reduBore 'Leave Bore'                                   at x1                       ymax            callback '!this.filterChoices()' tooltip 'Permissible Leave Bores' width 10
        path down
        halign right
        button .reduA2L1 toggle pixmap height 24 width 24                                                           callback '!this.arriveLeave(2,1)' tooltip 'Arrive major bore, leave minor bore'
        path left
        hdistance 0
        button .reduA1L2 toggle pixmap height 24 width 24                                                           callback '!this.arriveLeave(1,2)' tooltip 'Arrive minor bore, leave major bore'
        valign centre
        paragraph .reduArrive text 'Config.'

      exit
      -- End of Reducer Data

      -- Tee Data
      frame .componentTeeFrame 'Tee Information' anchor right + left + bottom at xmin.choices       ymax.lstu+0.2    width 26

        -- Connection Bore
        option .teeBore  'Conn. Bore'                                   at x1                       ymax            callback '!this.filterChoices()' tooltip 'Permissible Connection Bores' width 10
        path down
        halign right
      exit
      -- End of Tee Data

      -- Re-establish connected components
      button .reconnect 'Reconnection'       anchor right + bottom      at xmax.choices-size        ymax form       callback '!this.reconnect(true)' tooltip 'Re-establish adjacent connections'

    exit
    -- End of Component Selection Frame

    -- Specification Selection Frame
    frame .specificationFrame 'Specs.'                 anchor right + left + top at xmin ymin

      list  .specList callback '!this.selectSpecification()'  at xmin+1 y1.6 anchor all width 24 lines 40
      halign right
      button .bSSpec     'Branch Spec'                  anchor right + top at xmax-size ymin-1 tooltip 'Revert to pipe specification' callback '!this.pipeSpecification()'

      -- Insulation
      --option .insulation 'Insulation'                   anchor right + top at xmax.specList-size ymax.specList  callback '!this.insulationSpecification()'  width 10
      option .insulation 'Insulation'                   anchor right + bottom at xmax.specList-size ymax.specList  callback '!this.insulationSpecification()'  width 10
      path down
      halign right
      --option .tracing    '   Tracing'                   anchor right + top                                      callback '!this.tracingSpecification()'     width 10
      option .tracing    '   Tracing'                   anchor right + bottom                                      callback '!this.tracingSpecification()'     width 10
    exit
    -- End of Specification Selection Frame

    -- Error Frame
    frame .errorsFrame   'Errors'                       anchor right + left + top at xmin ymin
      list    .errorList     anchor all at xmin.componentList  ymax          width 24 lines 12
      button  .errors    'Refresh'      at xmax-size ymax anchor right + bottom callback '!this.errors()'

    exit
    -- End of Specification Selection Frame

    -- Options Setting Frame
    frame .optionsFrame   'Options'                     anchor right + left + top at xmin ymin

      -- Display Test
      option .detailText      'Descriptions'                  at x1     ymax      callback '!this.setOption(' width 8
      toggle .tagArrive       ' Tag component'                at x2     ymax      callback '!this.setOption('
      toggle .tagFixed        ' Tag constraints'              at x2     ymax      callback '!this.setOption('

      frame .constraintFrame 'Constraints'              anchor right + left + top at x0.5 ymax+0.25  width 26
        toggle .autoConn        ' Auto reconnect'             at x1.5   y0.75     callback '!this.setOption('
        toggle .connFree     ' Reconn. free ends'             at x1.5   ymax      callback '!this.setOption('
        toggle .ignorePos    ' Ignore positioned'             at x1.5   ymax      callback '!this.setOption('
      exit

      button .resetSettings   'System Defaults' anchor right  + top at xmax.detailText-size ymax+1 callback '!this.systemDefaults()' tooltip 'Reset to system default'

    exit
    -- End of Setting Frame

  exit
  -- End of tab set

  -- Form Members

  -- Current Component
  member .component             is DBREF
  member .componentType         is STRING
  member .componentPosition     is POSITION

  -- Check for modification
  member .lastModified          is DATETIME

  -- Check bore for component, could be P3 of a Tee or P2 of a reducer, etc.
  member .checkBore             is BORE

  -- Arrive/Leave for new component (not to be confused with arrive/leave of current component)
  member .arriveBore            is BORE
  member .leaveBore             is BORE

  -- Information about component
  member .specReference         is DBREF
  member .answers               is ARRAY
  member .questions             is ARRAY
  member .sType                 is STRING
  member .originalComponent     is ARRAY

  -- Connection information
  member .connections           is ARRAY
  member .connected             is COMPONENTRECONNECT

  member .reconnectAvailable    is BOOLEAN

  -- Branch for component
  member .branch                is DBREF

  -- Available Specifications
  member .pipingSpecs           is SPECIFICATIONS
  member .insulationSpecs       is SPECIFICATIONS
  member .tracingSpecs          is SPECIFICATIONS

  -- List of Component Specifications
  member .specifications        is ARRAY

  -- Current Selected piping specification
  member .currentSpecIndex      is REAL

  -- Current Selected component in spec
  member .currentComponentIndex is REAL

  -- Currently Active Component
  member .activeDataFrame       is GADGET

  -- Currently Active Frame
  member .currentFrameIndex     is REAL

  -- Register of components requiring Tab Frames
 member .componentRegister     is ARRAY

  -- Description for frame
  member .componentFrames       is ARRAY

  -- Actual Frame for components
  member .frameRegister         is ARRAY

  -- Special Attribute Registers (index is the same as the frame register)
    -- Radius Gadgets
    member .radiusRegister      is ARRAY
    -- Angl Gadgets
    member .angleRegister      is ARRAY
    -- Bore Gadgets
    member .boreRegister        is ARRAY
    -- Arrive Leave Gadgets??
    member .arriveLeaveRegister is ARRAY

  -- Active component object (use an array as it can be heterogeneous)
  member .activeComponent       is ARRAY

  -- Object for registered components
  member .componentObjects      is ARRAY

  -- Default component object
  member .defaultComponent      is COMPONENTDEFAULT

  -- Available Components
  member .availableComponents   is ARRAY

  -- Aid Graphics
  member .tagID                 is REAL

  -- Utility Option Settings
  member .tag                   is BOOLEAN
  member .tagConstraints        is BOOLEAN
  member .connectFreeEnds       is BOOLEAN
  member .autoConnection        is BOOLEAN
  member .ignorePositioned      is BOOLEAN
  member .tagPoint              is POINTVECTOR
  member .componentDetail       is STRING

  -- Option File information
  member .optionFileData        is ARRAY

  -- Undo for creation
  member .undo                  is UNDOABLE

  --Number of Leave tube specs available
  member .noLstuSpecs           is REAL
--CW
  --multiBore boolean to tell if a selectable component is multiBore
  member .multiBore             is BOOLEAN
  -- list of component Dbrefs
  member .components            is ARRAY
  --list of items to check for multiBores
  member .checkItems            is ARRAY

  -- Register from
  !!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      componentSelection
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentSelection()

  -- Initialise Variables
  !this.trackCE.val           = true
  !this.currentSpecIndex      = 0
  !this.currentComponentIndex = 0
  !this.currentFrameIndex     = 0

  !this.noLstuSpecs = 1

  -- Aid graphic numbers
  !this.tagID                 = !!aidNumbers.add('Pipe Component Creation')

  -- Set cancel callback
  !this.cancelCall            = '!this.close()'

  -- Configuration Info, options are DTXR = Rtext, DTXS = Stext, DTXT = Ttext, CATTEX = Rtext + Material Text
  !display  = ARRAY()
  !replace  = ARRAY()
  !display.append('Full')
  !replace.append('CATTEX')
  !display.append('R Text')
  !replace.append('DTXR')
  !display.append('S Text')
  !replace.append('DTXS')
  !display.append('T Text')
  !replace.append('DTXT')
  !display.append('Cat-Ref')
  !replace.append('CATR')
  !this.detailText.dtext  = !display
  !this.detailText.rtext  = !replace

  -- Default Settings
  !this.defaultSettings()
  !this.readOptions()
--CW
 !this.multiBore = false

  -- Component Default Information
  -- ## Bends
  !index = !this.registerComponent('BEND', !this.componentBendFrame, object COMPONENTBEND())

    -- Define radius gadgets for bend component
    !this.registerRadius('BEND', !this.bendRadiusOption, !this.bendRadius)

  -- ## Elbows
  !index = !this.registerComponent('ELBO', !this.componentElbowFrame, object COMPONENTELBOW())

    -- Define angle gadgets for elbo component
  !this.registerAngle('ELBO', !this.angle, !this.minAngle, !this.maxAngle)

  !this.minAngle.active = false
  !this.maxAngle.active = false

  -- ## Reducer
  !index = !this.registerComponent('REDU', !this.componentReduFrame, object COMPONENTREDUCER())

    -- Define bore gadget for Reducer component
    !this.registerBore('REDU', !this.reduBore)

    -- Define gadgets and associates for Reducer component
    !this.registerArriveLeave('REDU', 1, 2, !this.reduA1L2)
    !this.registerArriveLeave('REDU', 2, 1, !this.reduA2L1)

    -- Icons
    !icon = !!pml.getPathname('reducer12-24.png')
    !this.reduA1L2.addPixmap(!icon)

    !icon = !!pml.getPathname('reducer21-24.png')
    !this.reduA2L1.addPixmap(!icon)

  -- ## Tee & Olet
  !index = !this.registerComponent('OLET', !this.componentTeeFrame, object COMPONENTTEE())
  !index = !this.registerComponent('TEE',  !this.componentTeeFrame, object COMPONENTTEE())

    -- Define bore gadget for Olet and Tee component
    !this.registerBore('OLET', !this.teeBore)
    !this.registerBore('TEE', !this.teeBore)

  -- ## Valves
  !index  = !this.registerComponent('VALV', object GADGET(), object COMPONENTVALVE())

  -- ## Instruments
  !index  = !this.registerComponent('INST', object GADGET(), object COMPONENTINSTRUMENT())

  -- ## Flange
  !index  = !this.registerComponent('FLAN', object GADGET(), object COMPONENTFLANGE())

  -- ## Elbow
  !index = !this.registerComponent('ELBO', object GADGET(), object COMPONENTBEND())

  -- ## End of component registration

  -- Load Specifications
  !this.setupSpecifications()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      defaultSettings
--
-- Description: Default Settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultSettings()

  -- Option Settings
  !this.tag                 = true
  !this.tagConstraints      = true
  !this.connectFreeEnds     = false
  !this.autoConnection      = false
  !this.ignorePositioned    = false
  !this.componentDetail     = !this.detailText.rtext[1]

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      systemDefaults
--
-- Description: Revert to system defaults
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemDefaults()

  -- Initialise Variables
  !this.defaultSettings()

  -- Setup form for defaults
  !this.setupOptions()

  -- Write User's options to file
  !this.writeOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupOptions
--
-- Description: Setup options frame to current settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupOptions()

  -- Setup detail text
  !this.detailText.select('RTEXT', !this.componentDetail)
  !this.connFree.val        = !this.connectFreeEnds
  !this.autoConn.val        = !this.autoConnection
  !this.ignorePos.val       = !this.ignorePositioned
  !this.tagArrive.val       = !this.tag
  !this.tagFixed.val        = !this.tagConstraints

  -- Set values
  !this.connected.reconnectEnds(!this.connectFreeEnds)
  !this.connected.ignorePositioned(!this.ignorePositioned)
  !this.connected.tag(!this.tagConstraints)

--CW - set current element arrive bore

  if !!ce.type.eq('WORL') then
   	return
   endif

  if !!ce.owner.type.neq('BRAN') then
   	return
   endif

  if !!ce.owner.type.eq('BRAN') then
    !a = !!ce.arrive
    !this.currentBore.val = !!ce.ppbor[!a].string()
  endif
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setOption
--
-- Description: Sets passed option and writes information to users configuration file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOption(!gadget is GADGET, !dummySelect is STRING)

  -- Initialise Variables

  -- Gadget Settings
  if(!gadget.name() eq 'DETAILTEXT') then
    !this.displayChoices()
    !this.selectCurrentComponent()

  elseif (!gadget.name() eq 'TAGARRIVE') then
    !this.tag               = !this.tagArrive.val
    !this.tag()

  elseif (!gadget.name() eq 'TAGFIXED') then
    !this.tagConstraints    = !this.tagFixed.val
    !this.connected.tag(!this.tagConstraints)

  elseif (!gadget.name() eq 'CONNFREE') then
    !this.connectFreeEnds   = !this.connFree.val
    !this.connected.reconnectEnds(!this.connectFreeEnds)

  elseif (!gadget.name() eq 'IGNOREPOS') then
    !this.ignorePositioned  = !this.ignorePos.val
    !this.connected.ignorePositioned(!this.ignorePositioned)

  elseif (!gadget.name() eq 'AUTOCONN') then
    !this.autoConnection    = !this.autoConn.val

    -- Make reconnection button active if required
    if(!this.autoConnection.not()) then
      !this.reconnect.active    = !this.connected.isReconnectRequired()
      !this.reconnectAvailable  = !this.reconnect.active
    endif
  endif

  -- Write User's options to file
  !this.writeOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      writeOptions
--
-- Description: Write options to user's file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .writeOptions()

  -- Initialise Variables
  -- File Data
  var !user login
  !date           = object DATETIME()
  !records        = ARRAY()
  !records.append('## Pipe Component Selection defaults for user: ' & !user)
  !records.append('## Created: ' & !date.string())
  !records.append('tag\'                & !this.tag.string())
  !records.append('tagConstraints\'     & !this.tagConstraints.string())
  !records.append('connectFreeEnds\'    & !this.connectFreeEnds.string())
  !records.append('autoConnection\'     & !this.autoConnection.string())
  !records.append('ignorePositioned\'   & !this.ignorePositioned.string())
  !records.append('componentDetail\'    & !this.componentDetail)

  -- Write to users configuration file
  !file = object FILE('%PDMSUSER%/component_selection_' & !user)
  !file.writeFile('OVERWRITE',!records)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      readOptions
--
-- Description: Write options to users file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .readOptions()

  -- Initialise Variables
  var !user login
  !file     = object FILE('%PDMSUSER%/component_selection_' & !user)

  -- If there is no file, then return
  if(!file.exists().not()) then
    return
  endif

  -- Get file records
  !records  = !file.readFile()

  -- Original Option on building the form
  !this.optionFileData = !records

  -- Loop through file
  do !record value !records
    skip if(!record.subString(1,1) eq '#')
    !data = !record.split('\')
    -- Set options
    if(!data[1] eq 'tag') then
      !this.tag               = !data[2].boolean()
    elseif (!data[1] eq 'tagConstraints') then
      !this.tagConstraints    = !data[2].boolean()
    elseif (!data[1] eq 'connectFreeEnds') then
      !this.connectFreeEnds   = !data[2].boolean()
    elseif (!data[1] eq 'autoConnection') then
      !this.autoConnection    = !data[2].boolean()
    elseif (!data[1] eq 'ignorePositioned') then
      !this.ignorePositioned  = !data[2].boolean()
    elseif (!data[1] eq 'componentDetail') then
      !this.componentDetail   = !data[2]
    endif
  enddo

  -- Setup form for defaults
  !this.setupOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerComponent
--
-- Description: Register Data Frame
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type (PDMS Type, BEND, TEE, etc.)
-- Return:
--   [Data Type] [Description]
--    REAL        Index of array component has been added at
--
------------------------------------------------------------------------

define method .registerComponent(!componentType is STRING, !componentFrame is GADGET, !object is ANY) is REAL

  -- Initialise Variables

  -- Get description of component
  var !nounDef NOUNDEF $!<componentType> RPTX
  !description    = !nounDef[1].subString(1,1) & !nounDef[1].subString(2).lowcase()

  -- Set Information
  !this.componentRegister.append(!componentType)
  !this.componentFrames.append(!description)
  !this.frameRegister.append(!componentFrame)
  !this.componentObjects.append(!object)

  -- Default, hide frame
  if(!componentFrame.set()) then
    !componentFrame.visible = false
  endif

  -- Return Size of Register
  return !this.componentRegister.size()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerArriveLeave
--
-- Description: Setup arrive and leave gadgets for passed element type.
--              Unlike the other register methods this is accumulative
--              so we add to any existing options in the register. Also
--              the assumption is that the arrive and leave information
--              has not been defined before.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      REAL        Arrive ppoint number
--    3   R      REAL        Leave ppoint number
--    4   R      GADGET      Button gadget for setting arrive/leave
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerArriveLeave(!type is STRING, !arrive is REAL, !leave is REAL, !button is GADGET)

  -- Initialise Variables
  !index                            = !this.frameIndex(!type)

  -- Check if entry is defined
  if(undefined(!this.arriveLeaveRegister[!index])) then
    !this.arriveLeaveRegister[!index] = ARRAY()
  endif

  -- Define type information
  !data[1]  = !arrive
  !data[2]  = !leave
  !data[3]  = !button

  !this.arriveLeaveRegister[!index].append(!data)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerRadius
--
-- Description: Setup radius gadgets for passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      GADGET      Option gadget radius
--    3   R      GADGET      Input gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerRadius(!type is STRING, !options is GADGET, !input is GADGET)

  -- Initialise Variables
  !index                          = !this.frameIndex(!type)
  !this.radiusRegister[!index][1] = !options
  !this.radiusRegister[!index][2] = !input

  -- Set Radius
  !input.val = 0

  !display = ARRAY()
  !replace = ARRAY()

  --Check if option is set to limit radius options, this is set in pdmsdflts des
  if (defined(!!limitRadiusOptions)) then
    if !!limitRadiusOptions.not() then
      -- Permissible Bend Radii
      !radiiOD = !this.componentObjects[!index].permissibleRadiiOD
      do !i indices !radiiOD
        !display[!i]  = !radiiOD[!i] & ' * OD'
        !replace[!i]  = !radiiOD[!i].string()
      enddo
    endif
  endif

  !display.append('Define')
  !replace.append('')

  !options.dtext  = !display
  !options.rtext  = !replace

  -- Get any details from Bend Object
  !radius         = !this.componentObjects[!index].defaultRadiusOD
  !options.select('RTEXT', !radius.string())
  handle ANY
  endhandle

  -- Select Type
  !this.selectRadius(!type)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      registerAngle
--
-- Description: Setup bore gadgets for passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      GADGET      Option gadget bore
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerAngle(!type is STRING, !input is GADGET, !minValue is GADGET,  !maxValue is GADGET)
  !index                     = !this.frameIndex(!type)
  !this.angleRegister[!index][1] = !input
  !this.angleRegister[!index][2] = !minValue
  !this.angleRegister[!index][3] = !maxValue

  !input.val = !this.componentObjects[!index].angle
  !minValue.val = !this.componentObjects[!index].angle
  !maxValue.val = !this.componentObjects[!index].angle

endmethod
-- End of method definition

------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      registerBore
--
-- Description: Setup bore gadgets for passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      GADGET      Option gadget bore
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .registerBore(!type is STRING, !options is GADGET)
  !index                     = !this.frameIndex(!type)
  !this.boreRegister[!index] = !options
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentIndex
--
-- Description: Return component index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    REAL        Frame index
--
------------------------------------------------------------------------

define method .componentIndex(!componentType is STRING) is REAL
  !index      = !this.componentRegister.findFirst(!componentType)
  if(!index.unset()) then
    !index    = 0
  endif
  return !index
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      frameIndex
--
-- Description: Return frame index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    REAL        Frame index
--
------------------------------------------------------------------------

define method .frameIndex(!componentType is STRING) is REAL

  -- Get Index
  !index      = !this.componentIndex(!componentType)

  -- Component registered, but there isn't a frame for it
  if(!index gt 0) then
    if(!this.frameRegister[!index].unset()) then
      !index = -1 * !index
    endif
  endif
--CW multiBore items
  if !this.multiBore  then
 	  if(!index leq 0) then
 	    !index = 3
 	    return !index
    endif
  endif
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      objectIndex
--
-- Description: Return object index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    REAL        Frame index
--
------------------------------------------------------------------------

define method .objectIndex(!componentType is STRING) is REAL

  -- Get Index
  !index      = !this.componentRegister.findFirst(!componentType)
  if(!index.unset()) then
    !index    = 0
  else
    -- Component registered, but there isn't a object for it
    if(!this.componentObjects[!index].unset()) then
      !index = -1 * !index
    endif
  endif
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentObject
--
-- Description: Return component object for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      TYPE        Element type
-- Return:
--   [Data Type] [Description]
--    ANY        Component object for passed component type
--
------------------------------------------------------------------------

define method .componentObject(!componentType is STRING) is ANY

  -- Get Index
  !index      = !this.componentRegister.findFirst(!componentType)
  if(!index.unset()) then
    !object   = !this.defaultComponent
  else
    -- Component registered, but there isn't a frame for it
    if(!this.componentObjects[!index].unset()) then
      !object = !this.defaultComponent
    else
      !object = !this.componentObjects[!index]
    endif
  endif

  -- Set type
  !object.type(!componentType)

  -- Return component object
  return !object

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Tidy reference data
  !this.tidy()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy reference data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.tagID>

  -- Remove connected tags
  !this.connected.untag()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form on being shown
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.trackCE.val = true

  -- Setup with current options
  !this.setupOptions()

  -- Show component selection tab
  !this.componentFrame.visible = true

  -- Track element
  !this.track(!!ce)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateComponent
--
-- Description: Update components, modified by external means
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateComponent()

  -- Get active components information
  !this.activeComponent[1].component(!this.component)
  handle ANY
  endhandle

  -- Set current position
  !this.componentPosition = !this.component.position

  -- Tag component
  !this.tag()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Track Current Element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  -- This is run when either the CE has changed or there has been a DB
  -- change. Therefore, we need to handle these correctly so as not to
  -- re-initialise the form when the connectivity model has been broken
  -- or there has been change external to the utility.

--CW
  !this.checkComponents()

--CW - check where we are in hierarchy then set current element arrive bore

  if !!ce.type.eq('WORL') then
   	return
  endif

  if !!ce.owner.type.eq('BRAN') then
     !a = !!ce.arrive
     !this.currentBore.val = !!ce.ppbor[!a].string()
  endif
  -- Same component
  if(!this.component.eq(!!ce)) then
    !this.setActive(true)
    !this.updateComponent()
  endif

  -- Different element from current component and tracking mode
  if (!this.trackCE.val) then
    if(!!ce.owner.badref().not()) then
    -- Element is not a piping component
      if(!!ce.type.eq('WORL') or !!ce.owner.type.neq('BRAN')) then
      !this.setActive(false)
        return
      endif
      -- However it could still be an HVAC branch component
      if (!!ce.owner.owner.type.neq('PIPE')) then
        !this.setActive(false)
        return
      endif
    else
      -- The World
      !this.setActive(false)
      return
    endif

    -- Element is a piping component
  !this.track(!!ce)

  !this.component = !!ce

  endif

return

  -- We need to check if component has been modified
  if(!this.component.set()) then

    -- If we are at the same component, do we need to refresh
    if(!this.component.eq(!!ce)) then

      -- Check if the component has been modified
      !repositioned = !this.component.position.neq(!this.componentPosition)

      -- Date Time last modified
      var !lastModified LASTM of $!<this.component>
      !dtm  = object DATETIME(!lastModified)
      !this.setActive(true)

      -- If the last modified data is different from the stored last modified
      -- (both greater and less than, should handle undo/redo/modified)
      if(!dtm.neq(!this.lastModified)) then

        -- If reconnection is available, don't update
        if(!this.reconnectAvailable) then
          if(!repositioned) then
            !this.updateComponent()
          endif
          return
        endif

      -- Element not modified
      else
        if(!repositioned) then
          !this.updateComponent()
        endif
        return
      endif

    -- Component and current element are not the same
    else

      -- If not tracking, then we don't want to do anything
      if(!this.trackCE.val.not()) then
        return
      endif

    endif

  endif

  -- Track to current element
  !this.track(!!ce)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Track with respect to passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to track form to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track(!passedElement is DBREF)

  -- Initialise Variables
  !element    = !passedElement

  -- Check we have a piping component
  if(!!ce.owner.badref().not()) then
    -- Element is not a piping component
    if(!!ce.owner.type.neq('BRAN')) then
      !this.setActive(false)
      return
    endif
    -- However it could still be an HVAC branch component
    if (!!ce.owner.owner.type.neq('PIPE')) then
      !this.setActive(false)
      return
    endif
  else
    -- The World
    !this.setActive(false)
    return
  endif

  --P-17089: If the TUBI's are shown on the design explorer then this little routine
  -- sets the !element variable to be the component that has the leave tube.
  if !element.type.eq('TUBI') then
    !elementName = !element.string()
    !elementName = '=' + !elementName.after('=')
    !element = !elementName.dbref()
    --If the TUBI element was the hstu the we set active false and return.
    if(!element.type.eq('BRAN')) then
      !this.setActive(false)
      return
    endif
  endif

  -- Check if we have access to modify the component
  if(!!dbrefUpdate(!element).not()) then
    !!alert.warning('Unable to modify ' & !element.flnn & '.')
    !this.setActive(false)
    return
  endif
  !this.setActive(true)

  -- Get errors for current component
  !this.errorList.clear()
  !errors = !this.connected.checkComponent(!element)
  if(!errors.set()) then
    !records  = ARRAY()
    !records.append('Component : ' & !element.flnn)

    do !i indices !errors
      !records.append('    ' & !errors[!i])
    enddo
    !records.append('')

    !this.errorList.dtext = !records
  endif

  -- Tidy reference data
  !this.tidy()

  ------------------ Get Current Component Information ------------------

  -- Make passed component the current component
  !this.component             = !element
  !this.branch                = !element.owner
  !this.componentType         = !element.type
  !this.connected.clear()
  !this.componentPosition     = !this.component.position
  !this.arriveBore            = object BORE()
  !this.leaveBore             = object BORE()

  -- Set last modified time
  var !lastModified LASTM of $!<element>
  !this.lastModified          = object DATETIME(!lastModified)

  -- Get bore of previous and next element/branch
  !sequence                   = !this.component.sequence + 1
  !hboreString = !this.branch.hBore.string(!!boreFmt)
  !tboreString = !this.branch.tBore.string(!!boreFmt)

  var !aBores evaluate (ABORE) for members of $!<this.branch> ignore ANY ''
  !aBores.insert(1,!hboreString)
  !aBores.append(!tboreString)
  var !lBores evaluate (LBORE) for members of $!<this.branch> ignore ANY ''
  !lBores.insert(1,!hboreString)
  !lBores.append(!tboreString)

  -- Get arrive bore
  do !i from !sequence - 1 to 1 by -1
    skip if(!lBores[!i].eq(''))
    !this.arriveBore  = !lBores[!i].bore()
    break
  enddo

  -- Get leave bore
  do !i from !sequence + 1 to !aBores.size()
    skip if(!aBores[!i].eq(''))
    !this.leaveBore   = !aBores[!i].bore()
    break
  enddo

  -- Check if both bore are unset
  if(!this.arriveBore.unset().and(!this.leaveBore.unset())) then
    !!alert.warning('Unable to derive arrive or leave bore of component.')
    return

  elseif (!this.arriveBore.unset().or(!this.leaveBore.unset())) then
    if(!this.arriveBore.unset()) then
      !this.arriveBore        = !this.leaveBore
    else
      !this.leaveBore         = !this.arriveBore
    endif
  endif

  -- Setup currently active component object
  !this.activeComponent.clear()
  !this.activeComponent[1]    = !this.componentObject(!this.component.type)
  !this.activeComponent[1].component(!this.component)
  handle any
  endhandle

  -- Get bore indices
  !checkBoreIndex   = !this.activeComponent[1].checkBoreIndex()
  if(!checkBoreIndex gt 0) then
    !this.checkBore = !this.component.ppBore[!checkBoreIndex]
    handle any
      !this.checkBore = object BORE()
    endhandle
  else
    !this.checkBore = object BORE()
  endif

  -- Remember the original component object definition
  !this.originalComponent.clear()
  !this.originalComponent     = !this.activeComponent

  -- Get component information
  if(!this.component.spref.unset()) then
    !this.specReference       = object DBREF()
    !this.sType               = STRING()
  else
    !this.specReference       = !this.component.spref
    !this.sType               = !this.component.sType
    handle ANY
      !this.sType             = STRING()
    endhandle
  endif

  -- Allow Reconnections
  !this.connections           = !this.component.brConnect
  handle any
  -- P-13343: If component has no spref brConnect does not exist so try and build the connections array manually.
    !currentElement = !!ce
    !!ce = !this.component
    prev
    handle any
    elsehandle NONE
      !this.connections.append(!!ce)
    endhandle
    !!ce = !this.component
    next
    handle any
    elsehandle none
      !this.connections.append(!!ce)
    endhandle
    !!ce = !currentElement
  endhandle

  !this.reconnect.active      = false
  !this.reconnectAvailable    = !this.reconnect.active

  -- Define connection list
  !connectionList             = !this.component.brConnect
  handle any
    -- P-13343: If component has no spref brConnect does not exist so try and build the connectionList array manually.
    !connectionList = object ARRAY()
    !currentElement = !!ce
    !!ce = !this.component
    prev
    handle any
    elsehandle NONE
      !connectionList.append(!!ce)
    endhandle
    !!ce = !this.component
    next
    handle any
    elsehandle none
      !connectionList.append(!!ce)
    endhandle
    !!ce = !currentElement
  endhandle

  !connectionList.append(!this.component)

  -- Define reconnection object
  !this.connected.ignorePositioned(!this.ignorePositioned)
  !this.connected.componentReconnect(!this.component, !connectionList)
  handle any
    -- P-13343: If component has no spref this function may fail so handle any error and carry on.
  endhandle

  -------------------- Load Specification Information -------------------

  -- Setup spec for components specification
  !this.componentSpecification()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag current position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tag()

  -------------------- Display Component Information --------------------

  -- Get information for current component
  !component                  = !this.activeComponent[1].component()
  !componentType              = !this.activeComponent[1].type()
  !specIndex                  = !this.pipingSpecs.specIndex(!this.componentSpecification(!component))

  if (!component.spref.unset() or !component.spref.badref()) then
    -- P-13343: If component has no spref then do not bother to tag it as it does not have the required attributes.
    return
  endif

  -- Component not in a piping specification
  if(!specIndex.unset()) then
    !this.choices.clearSelection()
    return
  endif

  !componentIndex             = !this.specifications[!specIndex].typeIndex(!componentType)
  !detail                     = !this.specifications[!specIndex].descriptions[!componentIndex]

  if(!this.component.isName) then
    !displayString            = !detail & ' - ' & !this.component.flnn
  else
    !displayString            = !detail & '(' & !this.component.tysequence & ') of ' & !this.component.owner.flnn
  endif
  !this.componentName.val     = !displayString.subString(1,27)

  -- Show component and branch spec
  !spec                       = !this.componentSpecification(!this.component)
  !pSpec                      = !this.branch.pSpec

  !defectDisplaySpecName= !this.specList.selection().dbref().name
  !defectDisplaySpecNameLength = !defectDisplaySpecName.length()
  !displayString              = 'Spec.: ' & !defectDisplaySpecName.subString(2,!defectDisplaySpecNameLength)


  if(!pSpec ne !spec) then
    !displayString            = !displayString & ' (' & !pSpec.flnn & ')'
  endif
  !this.currentSpec.val       = !displayString.subString(1,22)

  -- Remove aid graphics
  AID CLEAR ALL $!<this.tagID>

  -- Tag Current Position
  if(!this.tag) then

    -- Proportion
    !proportion   = 0.5

    -- Define tag point
    !arriveBore   = !this.arriveBore
    !aDirection   = !component.aDirection
    !aPosition    = !this.activeComponent[1].baseClass().alignmentPosition
    --!aPosition    = !this.component.position
    !tagPoint     = object POINTVECTOR(!aPosition, !aDirection.opposite())
    handle any
    endhandle

    -- P-13343: If a component with no spref gets through to here as a fail safe handle the errors that are caused and carry on.
    -- Directions
    !orthDir      = !tagPoint.direction.orthogonal(U)
    handle ANY
      !orthDir    = !tagPoint.direction.orthogonal(N)
      handle any
      endhandle
    endhandle
    !offsetDir    = !orthDir.orthogonal(!tagPoint.direction)
    handle any
    endhandle

    -- Define dimensions
    !od           = !component.aod
    handle any
    elsehandle NONE
    !oHeight      = !od * 2
    !aHeight      = !od * 1

    -- Positions
    !tagPosition  = !tagPoint.position.offset(!offsetDir, !od)
    !arPosition   = !tagPosition.offset(!aDirection, !aHeight)
    !cPosition    = !tagPosition.offset(!aDirection, !aHeight * 0.5)

    -- Graphics
    AID CYLINDER NUMBER $!<this.tagID>  AT $!<cPosition>  ORI Z IS $!<aDirection>   HEIGH $!<aHeight> DIAM 4mm FILLED ON
    AID CYLINDER NUMBER $!<this.tagID>  AT $!<aPosition>  ORI Z IS $!<offsetDir>    HEIGH $!<oHeight> DIAM 4mm FILLED ON
    AID ARROW    NUMBER $!<this.tagID>  AT $!<arPosition> DIRECTION $!<tagPoint.direction> HEIGH $!<aHeight> PROPORTION $!<proportion>

    -- Show current component type
    !type     = !detail & '(' & !component.tysequ & ')'
    AID TEXT    NUMBER $!<this.tagID> '$!<type>' AT $!<tagPosition>
    endhandle

  endif

  -- Display connected constraints
  !this.connected.tag()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      insulationSpecification
--
-- Description: Set insulation spec of component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insulationSpecification()

  -- Set insulation
  !insulation   = !this.insulation.selection()

  if(!insulation.empty().not()) then
    !this.component.iSpec = !insulation.dbref()
  else
    !reference  = !!ce
    !!ce        = !this.component
    ispec nulref
    !!ce        = !this.component
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tracingSpecification
--
-- Description: Set insulation spec of component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tracingSpecification()

  -- Set insulation
  !trace   = !this.tracing.selection()

  if(!trace.empty().not()) then
    !this.component.tSpec = !trace.dbref()
  else
    !reference  = !!ce
    !!ce        = !this.component
    tspec nulref
    !!ce        = !this.component
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupSpecifications
--
-- Description: Setup Specifications
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupSpecifications()

  -- Populate lists
  -- Pipe Specs
  if(!this.pipingSpecs.piping()) then
    !pDisplay                 = !this.pipingSpecs.descriptions
    !pReplace                 = !this.pipingSpecs.refStrings
  else
    !pDisplay[1]              = 'None Available'
    !pReplace[1]              = ''
  endif
  !this.specList.dtext        = !pDisplay
  !this.specList.rtext        = !pReplace

  -- Insulation Specs
  if(!this.insulationSpecs.insulation()) then
    !iDisplay[1]              = 'None'
    !iReplace[1]              = ''
    !iDisplay.appendArray(!this.insulationSpecs.descriptions)
    !iReplace.appendArray(!this.insulationSpecs.refStrings)
    !this.insulation.active   = true
  else
    !iDisplay[1]              = 'None Available'
    !iReplace[1]              = ''
    !this.insulation.active   = false
  endif
  !this.insulation.dtext      = !iDisplay
  !this.insulation.rtext      = !iReplace

  -- Tracing Specs
  if(!this.tracingSpecs.tracing()) then
    !tDisplay[1]              = 'None'
    !tReplace[1]              = ''
    !tDisplay.appendArray(!this.tracingSpecs.descriptions)
    !tReplace.appendArray(!this.tracingSpecs.refStrings)
    !this.tracing.active      = true
  else
    !tDisplay[1]              = 'None Available'
    !tReplace[1]              = ''
    !this.tracing.active      = false
  endif
  !this.tracing.dtext         = !tDisplay
  !this.tracing.rtext         = !tReplace

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pipeSpecification
--
-- Description: Revert to pipe specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeSpecification()
  !this.setSpecifications(!this.branch.pSpec, !this.branch.iSpec, !this.branch.tSpec)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentSpecification
--
-- Description: Setup using components specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentSpecification()
  !this.setSpecifications(!this.componentSpecification(!this.component), !this.component.iSpec, !this.component.tSpec)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentSpecification
--
-- Description: Get component specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    DBREF       Component specification
--
------------------------------------------------------------------------

define method .componentSpecification(!component is DBREF) is DBREF

  -- Handle unset specRef of components
  if(!component.spref.unset()) then
    !spec = !component.owner.pSpec
  else
    !spec = !component.spow
  endif

  -- Return spec
  return !spec

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Setup using components specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Piping specification
--    2   R      DBREF       Insulation specification
--    3   R      DBREF       Tracing specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpecifications(!piping is DBREF, !insulation is DBREF, !tracing is DBREF)

  -- Insulation Specification
  if(!insulation.unset()) then
    !this.insulation.select('RTEXT','')
  else
    !this.insulation.select('RTEXT', !insulation.refNo.string())
  endif
  !this.insulationSpecification()

  -- Tracing Specification  !tracingSpec    = !element.tSpec
  if(!tracing.unset()) then
    !this.tracing.select('RTEXT','')
  else
    !this.tracing.select('RTEXT', !tracing.refNo.string())
  endif
  !this.tracingSpecification()

  -- Select Current Piping Specification
  !this.selectSpecification(!piping)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectSpecification
--
-- Description: Select Specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectSpecification()
  !this.selectSpecification(!this.pipingSpecs.references[!this.specList.val])
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectSpecification
--
-- Description: Select Specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification to select
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectSpecification(!passedSpec is DBREF)

  -- Initialise Variables
  !spec       = !passedSpec

  -- Select Passed Specification
  if(!spec.set()) then
    !specName = !spec.refNo.string()
    !this.specList.select('RTEXT', !specName)
    handle any
    elsehandle none
      !defectDisplaySpecName= !this.specList.selection().dbref().name
      !displayString              = 'Spec.:' & !defectDisplaySpecName
    endhandle
  endif

  -- Get specification index
  !specIndex  = !this.pipingSpecs.specIndex(!spec)

  -- If specIndex is unset, then the specification has not been identified
  -- and loaded as a valid piping specification (e.g. it could be a limbo spec)
  if(!specIndex.unset()) then

    -- We'll use the branch specification if spec index is unset
    !spec       = !this.branch.pSpec
    !specIndex  = !this.pipingSpecs.specIndex(!spec)

  endif

  -- Check current component spec against selected spec
  if(!specIndex.neq(!this.currentSpecIndex)) then

   -- Check if specification list has spec in it
    if(undefined(!this.specifications[!specIndex])) then

      -- Adds the specification to the list
      !this.specifications[!specIndex]  = object SPECIFICATION(!spec)

      -- Load change types for component types in specification
      !this.specifications[!specIndex].deriveChangeTypes()

    endif

    -- Set Component Spec
    !this.currentSpecIndex  = !specIndex


  endif

  -- Determine if "Branch Spec" buttons need to be active
  !branchSpec         = !this.branch.pSpec.eq(!this.specifications[!specIndex].dbElement).not()
  --!this.bCSpec.active = !branchSpec
  !this.bSSpec.active = !branchSpec

  --  Select Component Type
  !this.selectComponentType()

  -- Select current components options
  !this.selectOptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadChangeTypes
--
-- Description: Determines the possible change types for the current component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadChangeTypes()

  -- Initialise Variables
  !componentType              = !this.activeComponent[1].type()
  !permissibleChangeTypes     = !this.specifications[!this.currentSpecIndex].changeTypes(!componentType)

  -- Load change type gadget with available types
  if(!permissibleChangeTypes.set()) then
    !this.componentList.dtext   = !permissibleChangeTypes[1]
    !this.componentList.rtext   = !permissibleChangeTypes[2]

    -- Grey out if there are no change types
    !this.componentList.active  = !permissibleChangeTypes[1].size() gt 1
  else
    !this.componentList.active  = false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeComponentType
--
-- Description: Change Component Type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeComponentType()

  -- Initialise Variables
  !componentType              = !this.componentList.selection('RTEXT')

  -- If component Type is empty, we must be setting up the form, so no action
  if(!componentType.empty()) then
    return
  endif

  -- Get new component object
  !changeTypeObject           = !this.componentObject(!componentType)

  -- Copy the relevant information from the active component object into the new one
  !changeTypeObject.copy(!this.activeComponent[1])

  -- Copy change component to new type
  !this.activeComponent.clear()
  !this.activeComponent[1]    = !changeTypeObject

  --  Select Component Type
  !this.selectComponentType()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectComponentType
--
-- Description: Select Component Type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectComponentType()

  -- Define Component Table
  !this.specifications[!this.currentSpecIndex].loadTable(!this.activeComponent[1].type())

  -- Setup change types (the first type should be the same as the component)
  !this.loadChangeTypes()

  -- Maintain Component Data Frame
  !this.initialiseFrame(!this.activeComponent[1])

  -- Load Available Components
  !this.availableComponents   = !this.choices(!this.activeComponent[1])

  -- Display available stypes
  !this.displayStypes()

  -- Display available bores
  !this.displayBores()

  -- Display available choices
  !this.displayChoices()

  -- Select Current Component
  !this.selectCurrentComponent()

  --Display the available leave tubes if there is more than 1
  !this.displayTubes()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectCurrentComponent
--
-- Description: Select Current Component Information
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectCurrentComponent()

  -- Initialise Variables
  !componentType  = !this.activeComponent[1].type()
  !component      = !this.activeComponent[1].component()

  -- Select the current specRef
  !this.choices.select('RTEXT', !this.specReference.string())
  handle ANY
  endhandle

  -- Determine the radius
  !radiusGadgets  = !this.radiusGadgets(!componentType)
  if(!radiusGadgets.set()) then

    !radius               = !this.activeComponent[1].radius
    if(!radius.unset()) then
      !radius = !this.activeComponent[1].component().owner.phBore.real()
    endif
    !radiusGadgets[2].val = !radius
    !ratio                = !radius / !component.aod

    -- Check if option gadget has valid setting
    !radiusGadgets[1].select('RTEXT', !ratio.string())
    handle ANY
      !radiusGadgets[1].select('RTEXT','')
      !radiusGadgets[2].active  = true
    elsehandle NONE
      !radiusGadgets[2].active  = false
    endhandle

  endif

  -- Determine the angle
  !angleGadgets  = !this.angleGadgets(!componentType)
  if(!angleGadgets.set()) then
    !componentFrameIndex    = !this.frameIndex(!componentType)
    !this.currentFrameIndex = !componentFrameIndex

    -- Show Component Data Frame
    if(!componentFrameIndex gt 0) then
      !dataFrame            = !this.frameRegister[!componentFrameIndex]

      if (!this.activeComponent[1].isRangeDefined) then
        !dataFrame.visible = true

        !this.activeComponent[1].component(!this.component)

        !angleGadgets[1].val = !this.activeComponent[1].angle
        !angleGadgets[2].val = !this.activeComponent[1].minAngle
        !angleGadgets[3].val = !this.activeComponent[1].maxAngle

        !angleGadgets[1].active = (!this.activeComponent[1].maxAngle gt !this.activeComponent[1].minAngle)
      else
        !dataFrame.visible = false
      endif
    endif
  endif

  -- Tag Position
  !this.tag()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectOptions
--
-- Description: Select Stype and Bore options for selected component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectOptions()

  -- Initialise Variables
  !componentType  = !this.activeComponent[1].type()
  !component      = !this.activeComponent[1].component()

  -- Select sub-type
  !sType          = !component.sType
  handle ANY
  elsehandle NONE
    !this.sTypes.select('RTEXT', !sType)
    handle ANY
      !this.sTypes.val = 1
      handle ANY
      endhandle
    endhandle
  endhandle

  -- Select Bore
  -- Determine the Bore information
  !boreGadget     = !this.boreGadget(!componentType)
  if(!boreGadget.set()) then

    -- Get bore indices
    !boreIndices  = !this.activeComponent[1].arriveLeave()

    -- Get Controlling bore for component
    !boreString   = !component.ppBore[!boreIndices[3]].string(!!boreFmt)
    handle any
      !boreString = object STRING()
    endhandle
    !boreGadget.select('RTEXT', !boreString)
    handle ANY
      !boreGadget.val = 1
      handle ANY
      endhandle
    endhandle

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      filterChoices
--
-- Description: Filter available components by stype and current settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filterChoices()

  -- Initialise Variables
  !this.availableComponents   = !this.filterChoices(!this.activeComponent[1])

  -- Display available choices
  !this.displayChoices()

  -- Select Current Component
  !this.selectCurrentComponent()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      filterChoices
--
-- Description: Filter available components by stype and current settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Component object to derive choices from
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of available components
--
------------------------------------------------------------------------

define method .filterChoices(!componentObject is ANY) is ARRAY

  !componentType  = !componentObject.type()

  -- Get question and answers
  !qa             = !this.questionsAndAnswers(!componentObject)

  -- Handle no question and answers
  if(!qa.unset()) then
    return ARRAY()
  endif

  !questions      = !qa[1]
  !answers        = !qa[2]

  !sType = !this.sTypes.selection()
  if(!sType.empty().not()) then
    !questions.append('STYP')
    !answers.append(!sType)
  endif

  !arriveLeave = !this.activeComponent[1].arriveLeave()
  -- If check bore is set
  if(!arriveLeave[3] gt 0) then

    -- Get Bore Gadget
    !boreGadget   = !this.boreGadget(!componentType)
    if(!boreGadget.set()) then
      !selection  = !boreGadget.selection()
      if(!selection.empty().not()) then
        !bore     = object BORE(!selection)
        !questions.append('PBOR' & !arriveLeave[3])
        !answers.append(!bore)
      endif
    endif
  endif

  -- Return Available Components
  return !this.specifications[!this.currentSpecIndex].components(!componentType, !questions, !answers)

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      choices
--
-- Description: Get the choices for the current selection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Component object to derive choices from
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of available components
--
------------------------------------------------------------------------

define method .choices(!componentObject is ANY) is ARRAY

  -- Initialise Variables
  !componentType  = !componentObject.type()

  -- Get question and answers
  !qa             = !this.questionsAndAnswers(!componentObject)

  -- Handle no question and answers
  if(!qa.unset()) then
    return ARRAY()
  endif

  -- Return Available Components
--CW
  !this.checkItems = !this.specifications[!this.currentSpecIndex].components(!componentType, !qa[1], !qa[2])
  !this.checkComponents()
  return !this.specifications[!this.currentSpecIndex].components(!componentType, !qa[1], !qa[2])

 endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      questionsAndAnswers
--
-- Description: Returns a 2D array of questions and answers for the passed
--              component object type. The arrive bore is always assumed to
--              be that of the original component.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Component object to derive choices from
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D array [1] Questions [2] Answers
--
------------------------------------------------------------------------

define method .questionsAndAnswers(!componentObject is ANY) is ARRAY

  -- Initialise Variables
  !arriveLeave    = !componentObject.arriveLeave()
  !component      = !componentObject.component()
  !componentType  = !componentObject.type()
  !questions      = ARRAY()
  !answers        = ARRAY()
  !results        = ARRAY()

  -- If there is no check bore given, then we'll always assume PBORE-1
  !boreIndices    = !componentObject.arriveLeave()
  if(!boreIndices[3] lt 0) then
    !questions.append('PBOR1')
  else
    !questions.append('PBOR' & !arriveLeave[1])
  endif

  -- Primary Question is the Bore
  !answers.append(!this.arriveBore)
  !results[1]     = !questions
  !results[2]     = !answers

  -- Return Questions and Answers
  return !results

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectChoice
--
-- Description: Select the current choice and setup other gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectChoice()

  -- Initialise Variables
  !reference            = !!ce

  -- Handle null selection
  !selection             = !this.choices.selection()
  if(!selection.unset()) then
    return
  endif

  -- Convert to DBREF
  !specReference        = !selection.dbref()
  handle ANY
    return
  endhandle
  if(!specReference.unset()) then

    return
  endif

  -- Check that the spec component has as catref
  if(!specReference.catref.unset()) then
    !!alert.warning('Unable to use component as it has no catalogue definition assigned to it.')
    return
  endif

--CW fix P-39135 --  Check if the component is an elbow and if so what the angle is --

if !reference.type eq ('ELBO') or !reference.type eq ('BEND')then
	!elbAngle = !reference.angle
endif
	

   -- before we change check to see if we have a flange allowance
   !type = !this.component.catref.compType
   handle (2,754)
     !type = ''
   endhandle
   !oldType = !type.match('ALL')

  --Check if we have to change type
  !type                 = !this.activeComponent[1].type()
  if(!this.component.type ne !type) then

    -- Mark the database
    !this.undo.description('Component type changed to ' & !type)
    !this.undo.add()
    !reference          = !!ce
    !!ce                = !this.component
    CHANGETYPE TO $!<type>
    handle (2,707)
    endhandle
    !!ce                = !reference

  else
    -- Mark the database
    !this.undo.description('Component reselected')
    !this.undo.add()

  endif

  -- Set Spec Reference
  !oldSpecRef = !this.component.spref
  !this.specReference   = !specReference
  !this.component.spref = !this.specReference

  !type = !this.component.catref.compType
  if !type.match('ALL').gt(0) then
    !this.component.allow = !this.component.flallow
    !this.component.loose = TRUE
  elseif !this.component.type.eq('BEND') then
    !this.setBendRadius(!oldSpecRef)

  else
    if !oldType.neq(0) then
       -- the previous flange was an allowance flange so reset to standard
      !this.component.allow = 0
      !this.component.loose = FALSE
    endif
  endif

  -- Set attributes from spec
  !this.setSpecAttributes(!this.component)
  handle ANY
  endhandle

  !reference          = !!ce
  !!ce                = !this.component
  SELECT LSTU
  handle ANY
  endhandle

  -- set the flange offset if it is available


  -- Change the rlock if it is 2 to -1, so we know it has been changed
  -- explicitly by the user
  if(!this.component.rlock eq 2) then
    !this.component.rlock = -1
  endif

  -- Reposition component based on its original information
  !this.activeComponent[1].realign()
  handle ANY
  endhandle

  -- Select Current Component
  !this.selectCurrentComponent()

  -- Select Options
  !this.selectOptions()

  --CW fix P-39135 -- if component is an elbow then set its angle to original value

  if !reference.type eq ('ELBO') or !reference.type eq ('BEND') then
  	!reference.angle = !elbAngle
-- Angle not in specification range
  	  handle (61,86) (61,87)
  	    !!alert.warning('Component (' + !reference.type + ') selected is out of range for current design angle of ' + !reference.angle.string() + '. Setting angle to maximum range angle.')
  	    !this.angle.val = !this.maxAngle.val
  	    !reference.angle = !this.maxAngle.val
  	  elsehandle none
  	    !this.angle.val = !elbAngle
  	  endhandle
  endif	
  -- Determine if we need to perform a reconnect
  !reconnect                  = !this.connected.isReconnectRequired()
  handle any
    !reconnect = true
  endhandle

  if(!this.autoConnection and !reconnect) then
    !this.reconnect(false)
    !this.undo.endUndoable()
  else
    !this.undo.endUndoable()
    !this.reconnect.active    = !reconnect
    !this.reconnectAvailable  = !this.reconnect.active
  endif

-- Make sure we reselect the lstu after we have reconnected to get the correct pl bore

  sel lstu
    handle any
    endhandle


  -- Return to original element
  !!ce = !reference

endmethod
-- End of method definition



------------------------------------------------------------------------
--
-- Method:     setBendRadius
--
-- Description: set the bend radius testing against machines and spec
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBendRadius(!oldSpecRef is DBREF )

    --always look for a radius from the spec.
    -- Radius setting can be RADI or RAD
    !oldRadius = !this.component.radius
    var !choice choice
    !rad = !choice.after('RAD').after(' ').before(' ').real()
    if !rad.set() then
      -- let the spec take care of it
      !this.component.radius = !rad
      return
    endif

    if !this.component.compType.eq('FIX') then
         -- if its a zero radius bend compType should be set to FIX or not set at all
        !this.component.radius = 0
        -- we can't go round resetting bends which do not use compType so leave all other bends alone
    endif
    -- test to see if we can get a radius from a bending machine
    !rad = !!ce.dfbrad
    handle ANY
      if !this.component.compType.eq('VAR') then
        -- its a variable radius bend
        -- has it got a bending machine set?
        -- if it has go and get the radius
        !!alert.error('Unable to Set Bend Radius from Bending Machine - Please Select a Radius')
        !this.component.radius =   !this.bendRadius.val
        handle ANY
           !this.component.radius = 0
        endhandle
        return
      endif
    elsehandle NONE
      -- DFBRAD is set so we need to set the component radius
      if !oldRadius.neq(!rad) then
         !answer = !!alert.question('Bend Radius is ' & !oldRadius.string(!!distanceFmt) & ' - Do You want to change the Bend Radius to ' & !rad.string(!!distanceFmt) & ' - Machine Defined')
         if !answer.eq('YES') then
           !this.component.radius = !rad
         elseif !answer.eq('CANCEL') then
           undodb
         else $* the answer is no
           --!this.component.spref = !oldSpecRef
           --!this.component.radius = !oldRadius
         endif
         !this.track()
         return
      else
        !this.component.radius = !rad
      endif
      return
    endhandle

      -- we should set the radius to the radius gadget
     !this.component.radius =   !this.bendRadius.val
     handle ANY
      !this.component.radius = 0
     endhandle

endmethod


------------------------------------------------------------------------
--
-- Method:      initialiseFrame
--
-- Description: Initialise for Frame for a component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY        Component Object Definition
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if component type data frame exists
--
------------------------------------------------------------------------

define method .initialiseFrame(!componentObject is ANY) is BOOLEAN

  -- Initialise Variables
  !componentType          = !componentObject.type()
  !componentFrameIndex    = !this.frameIndex(!componentType)
  !this.currentFrameIndex = !componentFrameIndex

  -- Show Component Data Frame
  if(!componentFrameIndex gt 0) then
    !dataFrame            = !this.frameRegister[!componentFrameIndex]

    -- Hide previous data frame
    if(!this.activeDataFrame.set()) then
      !this.activeDataFrame.visible = false
    endif

    !this.activeDataFrame           = !dataFrame
    !this.activeDataFrame.visible   = true

  -- No Component Data Frame
  else

    -- Hide previous data frame
    if(!this.activeDataFrame.set()) then
      !this.activeDataFrame.visible = false
    endif

  endif

  -- Special Case Data Frame Code
  !this.arriveLeaveSetup(!componentObject)

  return true

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeaveGadgets
--
-- Description: Returns the gadget used for setting the arrive/leave of
--              the passed type an unset return means there is no gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D array of related gadgets for arrive and leave
------------------------------------------------------------------------

define method .arriveLeaveGadgets(!componentType is STRING) is ARRAY

  -- Initialise Variables
  !result       = ARRAY()
  !index        = !this.frameIndex(!componentType)

  if(!index gt 0) then
    if(defined(!this.arriveLeaveRegister[!index])) then
      !result   = !this.arriveLeaveRegister[!index]
    endif
  endif

  -- Return gadgets
  return !result

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      radiusGadgets
--
-- Description: Returns the gadget used for setting the radius of the passed
--              type an unset return means there is no gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--    ARRAY       2 element array of gadget. [1] Option gadget, [2] input
------------------------------------------------------------------------

define method .radiusGadgets(!componentType is STRING) is ARRAY

  -- Initialise Variables
  !result       = ARRAY()
  !index        = !this.frameIndex(!componentType)

  if(!index gt 0) then
    if(defined(!this.radiusRegister[!index])) then
      !result[1]  = !this.radiusRegister[!index][1]
      !result[2]  = !this.radiusRegister[!index][2]
    endif
  endif

  -- Return gadgets
  return !result

 endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      angleGadgets
--
-- Description: Returns the gadgets used for setting the angle of the passed
--              type, an unset return means there is no gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--    ARRAY       2 element array of gadget. [1] Option gadget, [2] input
------------------------------------------------------------------------

define method .angleGadgets(!componentType is STRING) is ARRAY

  -- Initialise Variables
  !result       = ARRAY()
  !index        = !this.frameIndex(!componentType)

  if(!index gt 0) then
    if(defined(!this.angleRegister[!index])) then
      !result[1]  = !this.angleRegister[!index][1]
      !result[2]  = !this.angleRegister[!index][2]
      !result[3]  = !this.angleRegister[!index][3]
    endif
  endif

  -- Return gadgets
  return !result

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      boreGadget
--
-- Description: Returns the gadget used for setting the bore of the passed
--              type, an unset return means there is no gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--    GADGET      Gadget
------------------------------------------------------------------------

define method .boreGadget(!componentType is STRING) is GADGET

  -- Initialise Variables
  !result       = object GADGET()
  !index        = !this.frameIndex(!componentType)

  if(!index gt 0) then
    if(defined(!this.boreRegister[!index])) then
      !result   = !this.boreRegister[!index]
    endif
  endif

  -- Return gadgets
  return !result

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setRadius
--
-- Description: Select radius option for supplied type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRadius()

  -- Radius gadgets
  !gadgets  = !this.radiusGadgets(!this.activeComponent[1].type())
  !option   = !gadgets[1]
  !input    = !gadgets[2]

  -- Mark database
  !this.undo.description('Component radius changed to ' & !input.val)
  !this.undo.add()

  -- Change Radius
  !this.activeComponent[1].radius(!input.val)
  !this.activeComponent[1].modify()

  -- Mark end of change
  !this.undo.endUndoable()

  -- Set last modified time
  var !lastModified LASTM of $!<this.component>
  !this.lastModified  = object DATETIME(!lastModified)

  -- Update Tag
  !this.tag()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectRadius
--
-- Description: Select radius by OD or allow explicit definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRadius()

  -- Radius gadgets
  !gadgets  = !this.radiusGadgets(!this.activeComponent[1].type())
  !option   = !gadgets[1]
  !input    = !gadgets[2]

  -- Explicit Radius
  if(!option.selection().empty()) then
    !input.active = true

  -- OD Ratio Radius
  else

    !input.active = false
    !this.activeComponent[1].radiusOD(!option.selection().real())

    -- Mark database
    !this.undo.description('Component radius changed to ' & !option.selection('DTEXT'))
    !this.undo.add()

    -- Change Radius
    !this.activeComponent[1].modify()
    !input.val    = !this.component.radius

    -- Mark end of change
    !this.undo.endUndoable()

    -- Set last modified time
    var !lastModified LASTM of $!<this.component>
    !this.lastModified  = object DATETIME(!lastModified)

    -- Tag
    !this.tag()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectRadius
--
-- Description: Select radius option for supplied type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRadius(!type is STRING)

  -- Initialise Variables
  !index  = !this.frameIndex(!type)

  if(!index gt 0) then

    -- Radius gadgets
    !gadgets = !this.radiusGadgets(!type)

    -- Check Option
    if(!gadgets[1].selection().empty()) then
      !gadgets[2].active = true
    else
      !gadgets[2].active = false
    endif

    -- Set component objects radius data
    !index  = !this.objectIndex(!type)

    -- Bit messy, but sets the object members directly, on the assumption
    -- that the object has the members
    if(!index gt 0) then
      !radiusOD = !gadgets[1].selection()
      if(!radiusOD.empty()) then
        !timesOD  = REAL()
        !radius   = !gadgets[2].val
      else
        !timesOD  = !radiusOD.real()
        !radius   = REAL()
      endif
      !this.componentObjects[!index].radius   = !radius
      !this.componentObjects[!index].radiusOD = !timesOD

    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeAngle
--
-- Description: Select radius option for supplied type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeAngle()

  !type = !this.componentList.selection()

  !gadgets = !this.angleGadgets(!type)

  -- Mark database
  !this.undo.description('Component angle changed to ' & !gadgets[1].val)
  !this.undo.add()

  if(!gadgets.set()) then
    !value = !gadgets[1].val
    !minValue = !gadgets[2].val
    !maxValue = !gadgets[3].val
  endif

  !index  = !this.frameIndex(!type)
  !this.activeComponent[1].angle =!gadgets[1].val
  !this.activeComponent[1].modify()
  handle ANY
    !!alert.warning('Angle ' + string(!value, !!angleFmt) + ' is outside the specified range (expected range ' + string(!minValue, !!angleFmt) + ' to ' +  string(!maxValue, !!angleFmt))
  endhandle

  -- Mark end of change
  !this.undo.endUndoable()

  -- Set last modified time
  var !lastModified LASTM of $!<this.component>
  !this.lastModified  = object DATETIME(!lastModified)

  -- Update Tag
  !this.tag()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Switch Tee Arrive/Leave
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Arrive Point
--    2   R      REAL        Leave Point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arriveLeave(!arrive is REAL, !leave is REAL)

  -- Object Index
  !index  = !this.frameIndex(!this.activeComponent[1].type())
  if(!index le 0) then
    return
  endif

  -- Update Tee Object with Current Arrive and Leave Data
  !this.activeComponent[1].arriveLeave(!arrive, !leave)

  -- Setup Arrive Gadgets
  !this.arriveLeaveSetup(!this.activeComponent[1])

  -- Display available bores
  !this.displayBores()

  -- Get available choices for the current arrive bore
  !this.availableComponents = !this.choices(!this.activeComponent[1])

  -- Display available choices
  !this.displayChoices()

  -- Get available LSTU elements from the spec
  !this.displayTubes()

  -- Select the current specRef
  !this.choices.select('RTEXT', !this.specReference.string())
  handle ANY
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeaveSetup
--
-- Description: The Arrive/Leave information for the current component
--              and the appropriate gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY        Component Object Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arriveLeaveSetup(!componentObject is ANY)

  -- Initialise Variables
  !componentType  = !componentObject.type()
  !index          = !this.frameIndex(!componentType)
  if(!index.unset()) then
    return
  endif

  -- Get Object Arrive and Leave is extracted from
  !arriveLeave    = !componentObject.arriveLeave()
  handle ANY
    return
  endhandle
  !arrive         = !arriveLeave[1]
  !leave          = !arriveLeave[2]

  -- Get gadget information
  !gadgetData     = !this.arriveLeaveGadgets(!componentType)
  do !i indices !gadgetData
    !active       = (!gadgetData[!i][1] eq !arrive and !gadgetData[!i][2] eq !leave)
    !gadgetData[!i][3].val = !active
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      displayStypes
--
-- Description: Display the currently available stypes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayStypes()

  -- Initialise Variables
  !componentType  = !this.activeComponent[1].type()
  !component      = !this.activeComponent[1].component()

  -- Get bore indices
  !boreIndices    = !this.activeComponent[1].arriveLeave()
  if(!boreIndices[3] lt 0) then
    !pBore        = 1
  else
    !pBore        = !boreIndices[3]
  endif

  --!arriveBore     = !component.ppBore[!pBore]
  !arriveBore     = !this.arriveBore

  -- Get Available sTypes for current active Component
  !sTypes = !this.specifications[!this.currentSpecIndex].subTypes(!componentType, !pBore, !arriveBore)

  -- Handle No Stype
  if(!sTypes.unset()) then
    if(!this.sTypes.visible) then
      !this.sTypes.visible = false
    endif
  else
    if(!this.sTypes.visible.not()) then
      !this.sTypes.visible = true
    endif

    -- Define Stype display and replacement
    !display          = ARRAY()
    !replace          = ARRAY()
    if(!sTypes.size() gt 1) then
      !display[1]       = 'unset'
      !replace[1]       = ''
    endif
    !display.appendArray(!sTypes)
    !replace.appendArray(!sTypes)

    -- Set gadget
    !this.sTypes.dtext  = !display
    !this.sTypes.rtext  = !replace
    !this.sTypes.active = !sTypes.size().gt(1)

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      displayBores
--
-- Description: Display the currently available bores
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayBores()

  -- Initialise Variables
  !componentType  = !this.activeComponent[1].type()
  !component      = !this.activeComponent[1].component()

  -- Determine the Bore information
  !boreGadget     = !this.boreGadget(!componentType)
  if(!boreGadget.set()) then

    -- Get bore indices
    !boreIndices    = !this.activeComponent[1].arriveLeave()

    -- Get Bore information
    !questions[1] = 'PBOR' & !boreIndices[1]
    !answers[1]   = !this.arriveBore

    -- Get Bores
    !question         = 'PBOR' & !boreIndices[3]
    !bores            = !this.specifications[!this.currentSpecIndex].componentData(!componentType, !question, !questions, !answers)

    if(!bores.empty()) then
      !boreGadget.active  = false
      return
    endif

    !bores.sort()
    do !i indices !bores
      !boreString[!i] = !bores[!i].string(!!boreFmt)
    enddo
    if(!boreGadget.active.not()) then
      !boreGadget.active  = true
    endif

    -- Define Bore display and replacement
   !display          = ARRAY()
    !replace          = ARRAY()
    if(!boreString.size() gt 1) then
      !display[1]     = 'unset'
      !replace[1]     = ''
    endif
    !display.appendArray(!boreString)
    !replace.appendArray(!boreString)

    -- Set gadget
    !boreGadget.dtext = !display
    !boreGadget.rtext = !replace

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      displayChoices
--
-- Description: Display the currently available components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayChoices()

  -- Initialise Variables
  !this.componentDetail = !this.detailText.selection()

  -- Get list of choices
  !texts                =!this.componentListText(!this.availableComponents)

  -- Populate list gadgets
  if(!texts.set()) then
    !this.choices.dtext = !texts[1]
    !this.choices.rtext = !texts[2]
  else
    !this.choices.clear()
  endif

--CW set heading on gadget
  if !this.componentType.eq('COUP') then
    !this.componentReduFrame.tag = 'Reducing Coupling Information'
    elseif !this.componentType.eq('FLAN') then
     	!this.componentReduFrame.tag = 'Reducing Flange Information'
    else
   	 !this.componentReduFrame.tag = 'Reducer Information'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentListText
--
-- Description: Returns list text (display & replacement) for passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of components
-- Return:
--   [Data Type] [Description]
--    ARRAY       2 element array, [1] Display Text
--                                 [2] Replacement Text
--
------------------------------------------------------------------------

define method .componentListText(!components is ARRAY) is ARRAY

  -- Initialise Variables
  !texts        = ARRAY()
  !display      = ARRAY()
  !replace      = ARRAY()
  !bores        = ARRAY()
  !boresString  = ARRAY()
  !dspBore      = false

  -- if there are no components, then return an empty array
  if(!components.unset()) then
    return ARRAY()
  endif

  -- Get component type (use first components gtype from catalogue definition,
  -- Hopefully this is always set to the correct type)
  !componentType  = !components[1].catref.gtype
  handle ANY
    return ARRAY()
  endhandle

  -- Determine if we need to show a check bore
  !boreIndices = !this.activeComponent[1].arriveLeave()

--CW need to set boreindex for multiBores to show bore size in list

   !a = !boreIndices[3]
   if !this.multiBore then
   	!a = 1
   endif	

  if (!a gt 0) then
    -- Get the index for the answer
    !questions  = !this.specifications[!this.currentSpecIndex].questions(!componentType)
       !boreIndex  = !questions.findFirst('PBOR' & !a)
    if(!boreIndex.set()) then
      !dspBore  = true
    endif
  endif

  -- Loop through components
  do !i indices !components

    -- If component doesn't have a CATR for some reason, then highlight it
    if(!components[!i].catref.unset()) then
      !description = !components[!i].flnn & ' - Component has no catalogue reference'
    else

      if(!this.componentDetail eq 'CATR') then
        !description = !components[!i].catref.flnn
      else
        !description = !components[!i].attribute(!this.componentDetail)
        handle ANY
          -- Loop through other available options
          do !j indices !this.detailText.dtext
            -- Don't bother to test the one we failed on
            skip if(!this.detailText.val eq !j)
            !description    = !components[!i].attribute(!this.detailText.rtext[!j])
            handle ANY
              !description  = !components[!i].catr.flnn
            endhandle
          enddo
        endhandle

        -- Handle Unset entries
        if(!description.trim().empty()) then
          !description = !components[!i].catref.flnn
        endif
      endif
    endif

    -- Add bore to list
    if(!dspBore) then
--CW set the boreindex for leave bore when going down in size for reducing items
  if !this.reduA1L2.val then
  !boreIndex = 2
  endif
      !answers    = !this.specifications[!this.currentSpecIndex].answers(!componentType, !components[!i])
      !bores.append(!answers[!boreIndex])
      !boresString.append(!answers[!boreIndex].string(!!boreFmt))
    endif

    !display.append(!description)
    !replace.append(!components[!i].string())
  enddo

  -- Sort bore is requires
  if(!dspBore) then
    !indices  = !bores.sortedIndices()
    !boresString.reIndex(!indices)
    !display.reIndex(!indices)
    !replace.reIndex(!indices)
    !width    = !boresString.width() * -1

    do !i indices !bores
      !display[!i] = substring('             ' & !boresString[!i], -1, !width) & '   ' & !display[!i]
    enddo

  endif

  -- Return
  !texts[1] = !display
  !texts[2] = !replace
  return !texts

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      reconnect
--
-- Description: Re-establish connections of adjacent components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Mark database
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reconnect(!mark is BOOLEAN)

  -- Initialise Variables
  !component      = !this.component

  -- Perform reconnection
  !unusedReconnected    = !this.connected.reconnect(!mark)

  -- Display any errors
  !this.errors()

  -- Set reconnection button
  !this.reconnect.active = !this.errorsFrame.visible

  -- Removed as DBCHANGED should be sort this out.
  -- Setup for reconnected components
  --if(!reconnected) then
  --  !this.track(!!ce)
  --endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      errors
--
-- Description: Check for errors
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .errors()

  -- Initialise Variables
  !this.errorList.clear()

  -- Check for errors
  !this.connected.checkErrors()

  -- get errors
  !errors     = !this.connected.errors()

  -- Populate error list
  if(!errors.set()) then
    !records  = ARRAY()
    do !i indices !errors

      !records.append('Component : ' & !errors[!i][1].flnn)

      do !j indices !errors[!i][2]
        !records.append('    ' & !errors[!i][2][!j])
      enddo
      !records.append('')

    enddo

    -- Display errors
    !this.errorList.dtext     = !records
    !this.errorsFrame.visible = true
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setSpecAttributes
--
-- Description: Sets component attributes to from specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpecAttributes(!component is DBREF)

  -- Initialise Variables
  !reference  = !!ce
  !!ce        = !component

  -- collect all attributes for a design element
  !attributes = ARRAY()

  !attributes[1] = 'ANGL'
  !attributes[2] = 'RADI'
  !attributes[3] = 'HEIG'
  !attributes[4] = 'SHOP'

  !questions = ARRAY()
  !answers = ARRAY()
  !maxAnswers  = ARRAY()

  -- P-30777 change to choices mechanism to eliminate spaces in styp problem
  var !choices choice number
  do !a from 1 to !choices.real()
    var !question Choice question $!a
    !questions.append(!question)
    var !answer Choice answer $!a
    !answers.append(!answer)
    var !maxans Choice maxans $!a
    !maxAnswers.append(!maxans)
  enddo

  do !i from 1 to !questions.size()
    !index = !attributes.findFirst(!questions[!i])
    if (!index.set()) then
      !answer = !answers[!i]
      !maxAnswer = !maxAnswers[!i]
      if(!attributes[!index] eq 'SHOP') then
        -- SHOP / SITE can be shop / true or site / false
        if(!answer.eq('TRUE') or !answer.eq('SHOP')) then
         !component.shop = TRUE
        elseif(!answer inset('FALS','FALSE','SITE')) then
          !component.shop = FALSE
        endif
      else
  -- we have real attribute
        -- we are going to use a greater value
        if(REAL(!answer) gt REAL(!maxAnswer)) then
          !maxAnswer = !answer
        endif
        !value = !component.$!attributes[$!index]

        -- set attribute to a proper value
        if(!value lt REAL(!answer) or !value gt REAL(!maxAnswer)) then
          !component.$!attributes[$!index] = REAL(!maxAnswer)
          handle ANY
          endhandle
        endif

      endif
    endif
  enddo

  -- go and test the loffline flag
  !this.setOffLineFlag(!reference)

  -- Return to original component
  !!ce        = !reference

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      displayTubes
--
-- Description: Displays the available Leave tube if there is
-- more than 1.
--
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayTubes()

  -- Initialise Variables
  !componentType  = !this.activeComponent[1].type()
  !component      = !this.activeComponent[1].component()

  -- Get Components Questions and Answers
  !questions      = !this.specifications[!this.currentSpecIndex].questions(!componentType)
  !answers        = !this.specifications[!this.currentSpecIndex].answers(!componentType, !component.spref)

  !boreIndices    = !this.activeComponent[1].arriveLeave()

  if !answers.set() then
    !bore = !answers[!questions.findFirst('PBOR' & !boreIndices[2])]
    handle any
      !this.lstu.visible = FALSE
      return
    endhandle
    !this.noLstuSpecs = !this.loadTubes(!this.lstu, !bore, !this.branch.pSpec)
    if !this.noLstuSpecs.gt(1) then
      !this.lstu.visible = TRUE
    else
      !this.lstu.visible = FALSE
    endif
  else
    !this.lstu.visible = FALSE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      loadTubes
--
-- Description: Loads the available leave tube into !gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
-- REAL The number of LSTU elements available for bore and spec
--
------------------------------------------------------------------------

define method .loadTubes(!gadget is GADGET, !bore is BORE, !specification is DBREF) is REAL

  !dtext = object ARRAY()
  !rtext = object ARRAY()

  if (!!isImperialLength('BORE')) then
    !tubes = !!getSpecComponents(!specification.name, 'TUBE', !!comValueConvert(!bore.real(),'MM').string())
  else
    !tubes = !!getSpecComponents(!specification.name, 'TUBE', !!comValueConvert(!bore.real(),'INCH').string())
  endif

  !dtxr = object STRING()
  !mtxx = object STRING()

  do !tube values !tubes
    !dtxr = !tube.dtxr
    handle any
      !dtxr = ''
    endhandle

    !mtxx = !tube.mtxx
    handle any
      !mtxx = ''
    endhandle

    !outerValue = !tube.catref.para[2].real()
    handle any
      !outer = '--'
    elsehandle NONE
      -- if imperial units
      !outerMetric = !!comValueConvert(!outerValue,'MM')
      if ( !!isImperialLength('DIST')) then
        -- first convert parameter value to MM. If parameter is undimensioned
        -- then assume that it is in MM, otherwise convert the dimensioned value
        -- to INCH
        !outer     = !!comUnitsConvert(!outerMetric,'MM','INCH').string('D3')
      else
        !outer = !outerMetric.string('D1')
      endif
    endhandle

    !wall = !tube.pwallt[1].string('D2')
    handle any
      !wall = '--'
    endhandle

    !dtext.append(!outer + ' OD x ' + !wall + ' Thk, ' + !dtxr + ' ' + !mtxx )
    !rtext.append(!tube.string())
  enddo

  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

  !gadget.select('Rtext', !this.component.lstu.string())
  handle any
    !gadget.select('Rtext', !this.component.hstu.string())
    handle any
      !gadget.select('Rtext', !gadget.rtext[1])
      handle ANY
      endhandle
    endhandle
  endhandle

  return !tubes.size()

endmethod

------------------------------------------------------------------------
--
-- Method:      applyLstu
--
-- Description: Apply the changes to selected Lstu
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyLstu()

  !this.component.lstube = !this.lstu.selection('Rtext').dbref()
   -- set the flange allowance
   if !this.component.type.eq('FLAN') then
      !this.setFlangeAllowance(!this.component)
   endif

endmethod

------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      setFlangeAllowance
--
-- Description: Called to test if a radius can be machine defined
--
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFlangeAllowance(!flange is DBREF)

 !type = !flange.catref.compType
 !flanType = !type.match('ALL')
 if !flanType.gt(0) then
   !flange.allow = !flange.flallow
   handle ANY
     -- in case the flange allowance is unset
     !!alert.error('Selected flange is an allowance flange but no allowance value is defined')
     !flange.allow = 0
     !flange.loose = FALSE
     return
   endhandle
   !flange.loose = TRUE
 else
   !flange.allow = 0
   !flange.loose = FALSE
 endif

endmethod
--------------------------------------------------------------------------
----
---- Method:     checkComponents
----
---- Description: check to see if items have different arrive and leave bores
----
----
--------------------------------------------------------------------------
define method .checkComponents()

!this.multiBore = FALSE

-- on opening pdms no need to check the current element
 if !!ce.type.eq('WORL') then
 	return
 endif

--check current element to see if multiBore
  if !!ce.owner.type.neq('BRAN') then
  	return
     else
      !a = !!ce
     if !a.ppbor[1].neq(!a.ppbor[2]) then
   	  !this.multiBore = TRUE
     endif	
  endif
 --loop through displayed choices and find if items in list have differing arrive/leave bores
 !items = !this.checkItems

  do !n index !items
   if !items[!n].ppbor[1].neq(!items[!n].ppbor[2]) then
   !this.multiBore = TRUE
   endif
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:     testForOffLine
--
-- Description: test to se if there is an offline flag set in the spec
-- and set the value
--
--
------------------------------------------------------------------------
define method .setOffLineFlag(!element is DBREF)

!!ce = !element

!index = !element.attlist.findfirst('LOFF')
if !index.unset() then
  return
endif

-- if we get here we have a loff attribute
var !s choice loff
handle ANY
  -- no loff or loff not set
  return
endhandle
if !s.set() then
  !loff = !s.boolean()
  handle ANY
  return
  elsehandle NONE
    !!ce.loff  = !loff
  endhandle
endif

endmethod
