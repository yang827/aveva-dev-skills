--
-- Description:
-- Change the Elevation of an Element
-- (Similar to AT form but with only the Z coordinate)
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!cvElevation

  !!cvElevation.formTitle     = 'Change Elevation'
  !!cvElevation.iconTitle     = 'ELEVATION'
  !!cvElevation.callback      = '!!cvElevationInit()'
  !!cvElevation.formRevision  = ' $Revision: 1.5 $ '

member .mode is STRING
  -- Body of form definition

path right
vdist 0.5

button _ce |CE| call |!!cvElevationCe(!!ce)|

button _owner |Owner| at xmax + 10 ymin call |!!cvElevationOwner()|

button _list |List| at xmax + 10 ymin call |!!cvElevationList()|

para _name  at x 0 ymax+0.5  TEXT |Element| width 15

text _element call |!!cvElevationElem()| width 30 string

path down

text _z |Elevation       | at x 0 ymax+0.5 call |!!cvElevationValue()|  width 16 isou

text _datum |Relative to     | call |!!cvElevationWrt()| width 30 string

 rgroup _radio
      add tag |Define Elevation| call |!!cvElevationElev('DEFAULT')|
      add tag |Define Bottom| call |!!cvElevationElev('BOTTOM')|
      add tag |Define Top| call |!!cvElevationElev('TOP')|
      add tag |Pick Element| call |!!cvElevationPick()|
      add tag |Navigate| call |!!cvElevationNavi()|
  exit

-- Bottom Line
 path right
  button _apply |Apply| at x 0 ymax+0.5 call '!!cvElevationApply()'

  button _cancel |Dismiss| at xmax form - size ymin  call '!!cvElevationDism()'  ok

exit
-- End of form definition for !!cvElevation
