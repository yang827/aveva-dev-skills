-- File:            cvlslopescreed.pmlfrm
--   Type:          Form Definition
--   Group:         Wall and Floors Application

--     Keyword:     CIVIL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Apr 28 8:52:10 BST 1999
--
--
-- Description:
-- Set the slope on a screed.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angle()                          -                   Set angle
--  apply()                          -                   Apply form
--  close()                          -                   Close form and tidy
--  cvlSlopeScreed()                 -                   Constructor
--  direction()                      -                   Set direction of slope from input value
--  direction(DIRECTION)             -                   Set direction of slope, from passed direction
--  pick()                           -                   Pick element to update
--  setDirection(STRING)             -                   Setup to direction of offset
--  setup(DBREF)                     -                   Setup form with passed screed
--  setupGadgets()                   -                   Setup input gadgets
--  slopeEdge()                      -                   Set edg event for a slope origin position
--  slopeEdge(LINE)                  -                   Derive a low position of slope
--  slopeEdges()                     -                   Set edg event for a slope origin position
--  slopeEdges(EDGPOSITIONDATA,EDGPOSITIONDATA) -                   Derive a low position of slope
--  slopeOrigin()                    -                   Set edg position event for a slope origin position
--  slopeOrigin(POSITION)            -                   Derive a low position of slope
--  slopeType()                      -                   Set slope type
--  through()                        -                   Set edg position event for a through position
--  through(POSITION)                -                   Derive a through position
--  tidy()                           -                   Tidy form data
--  towards(POSITION)                -                   Set direction from the origin towards the passed position
--
------------------------------------------------------------------------

setup form !!cvlSlopeScreed

  !this.formTitle     = 'Screed Slope'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  -- Bar
  bar
  exit

  -- Current element
  text   .ceName               at xmin ymax tooltip 'Screed'    width 40 is STRING

  -- Slope Settings
  frame .slopeFrame 'Settings' at xmin ymax width 40

    -- Slope type
    option .type     'Type'    at x1  ymax  callback '!this.slopeType()' tooltip 'Type of screed slope' width 8

    -- Angle of slope
    text   .angle     'Slope'  at x22 y1    callback '!this.angle()'     tooltip 'Angle from screed plane' width  8 is REAL format !!realFmt

    path down
    halign right

    -- Direction
    text   .direction 'Direction'           callback '!this.direction()' tooltip 'Direction of screed'     width 24 is STRING

    -- Lock
    toggle .lock at xmax ymin               callback '!this.direction.active = !this.lock.val.not()' tooltip 'Lock screed direction' states 'false' 'true'

  exit

  -- Apply/Dismiss
  button .apply     'Apply'   at xmin form-0    ymax+0.25 callback '!this.apply()'
  button .dismiss   'Dismiss' at xmax form-size ymin      callback '!this.close()'

  -- Form Variables
  -- Screed being modified
  member .screed         is DBREF

  -- Screed Slope data
  member .slope          is CVLSCREEDSLOPE

  -- Event Description
  member .edgDescription is STRING

exit
-- End of form definition !!cvlSlopeScreed

----------------------------------------------------------------------
--
-- Method:      cvlSlopeScreed
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cvlSlopeScreed()

  -- Initialise Variables
  !this.cancelCall     = '!this.close()'

  -- Edg Description
  !this.edgDescription = 'Slope Screed'

  -- Stop ceName being typed in
  !this.ceName.setEditable(false)

  -- Bar
  !bar = !this.bar
  !bar.add('Select',   'menuSelect')
  !bar.add('Position', 'menuPosition')
  !bar.add('Slope',    'menuSlope')

  -- Select Menu
  !menu = !this.newMenu('menuSelect')
    !menu.add('callback', 'CE',           '!this.setup(!!ce)')
    !menu.add('separator')
    !menu.add('callback', 'Pick',         '!this.pick()')

  -- Derive Menu
  !menu = !this.newMenu('menuPosition')
    !menu.add('callback', 'Origin...',    '!this.slopeOrigin()')
    !menu.add('callback', 'Through...',   '!this.through()')

  -- Derive Menu
  !menu = !this.newMenu('menuSlope')
    !menu.add('callback', 'About edge',   '!this.slopeEdge()')
    !menu.add('callback', 'About edges',  '!this.slopeEdges()')

  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Toward',       '!this.setDirection(''TOWARDS'')')
    !menu.add('CALLBACK', 'Pick',         '!this.setDirection(''PICK'')')
    !menu.add('CALLBACK', 'X Direction',  '!this.setDirection(''X'')')
    !menu.add('CALLBACK', 'Y Direction',  '!this.setDirection(''Y'')')
    !menu.add('CALLBACK', 'Z Direction',  '!this.setDirection(''Z'')')
    !menu.add('CALLBACK', 'Opposite',     '!this.setDirection(''OPPOSITE'')')
  !this.direction.setPopup(!this.directionMenu)

  -- Slope type
  !dtext[1]        = 'Straight'
  !rtext[1]        = 'STRAIGHT'
  !dtext[2]        = 'Conical'
  !rtext[2]        = 'CONICAL'
  !this.type.dtext = !dtext
  !this.type.rtext = !rtext

endmethod
-- End of method for .cvlSlopeScreed()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Unenhance
  UNENHANCE $!<this.screed>
  ENHANCE   $!<this.screed> TRANSLUCENCY 0

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.edgDescription)

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Tidy up graphics
  !this.slope.tidy()

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Define slope
  !this.slope.define()

  -- Need to do this for some reason, changing the NXTR unsets the translucency
  REFRESH
  UNENHANCE $!<this.screed>
  ENHANCE   $!<this.screed> TRANSLUCENCY 0
  ENHANCE   $!<this.screed> COLOUR RED
  ENHANCE   $!<this.screed> TRANSLUCENCY 75

endmethod
-- End of method definition for .apply()

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed screed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Screed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!passedScreed is DBREF)

  -- Check we are at a screed element or can navigate to one.
  if(!passedScreed.type ne 'SCREED') then

    -- Get owning elements
    !ownerList = !passedScreed.ownLst
    !ownerList.append(!passedScreed)

    -- Invert list and work up until we find a screed.
    !ownerList.invert()

    do !i indices !ownerList
      skip if(!ownerList[!i].type ne 'SCREED')
      !screed = !ownerList[!i]
      break
    enddo

    if(undefined(!screed)) then
      !!alert.warning('Can only use this utility on a screed element.')
      return
    endif
  else
    !screed = !passedScreed
  endif

  -- Check we have access to modify element
  if(!!dbRefUpdate(!screed).not()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- Unenhance
  if(!this.screed.set()) then
    UNENHANCE $!<this.screed>
    ENHANCE   $!<this.screed> TRANSLUCENCY 0
  endif

  -- Enhance in translucency red
  ENHANCE $!<screed> COLOUR RED
  ENHANCE $!<screed> TRANSLUCENCY 75

  -- Setup slope object
  if(!this.slope.setup(!screed)) then

    -- Initialise form data
    !this.screed             = !screed
    !this.ceName.val         = !this.screed.flnn
    !this.ceName.setTooltip(!this.screed.flnn)

    -- Set angle
    !this.angle.val          = !this.slope.slope()

    -- Update direction
    !this.direction.val      = !this.slope.direction().string().before('WRT').trim()

    -- Select Type
    !this.type.select('RTEXT',!this.slope.type)

    -- Setup input gadgets
    !this.setupGadgets()

    !this.show()

  -- Unable to modify screed
  else
    !!alert.warning(!!error.text)
    return
  endif

endmethod
-- End of method for .setup(DBREF)

----------------------------------------------------------------------
--
-- Method:      setupGadgets
--
-- Description: Setup input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupGadgets()

  -- Straight sloping screed
  if(!this.type.selection() eq 'STRAIGHT') then

    !this.bar.setActive('Slope',true)
    -- Grey-in/out direction
    if(!this.slope.rotationType eq 'POINT') then
      !this.direction.active = true
      !this.lock.active      = true
      !this.lock.val         = false
      !this.angle.active     = true
    elseif (!this.slope.rotationType eq 'EDGE') then
      !this.direction.active = false
      !this.lock.active      = false
      !this.lock.val         = true
      !this.angle.active     = true
    endif

  -- Conical slope
  else
    !this.bar.setActive('Slope',false)
    !this.direction.active = false
    !this.lock.active      = false
    !this.lock.val         = false
    !this.angle.active     = true

  endif

endmethod
-- End of method for .setupGadgets()

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Pick element to update
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick()

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick screed')
  !packet.action         = '!!cvlSlopeScreed.setup(!this.return[1].item)'
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE eq |SCREED|'
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.key            = 'slopeScreed'
  !packet.description    = !this.edgDescription
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'civils'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick()

------------------------------------------------------------------------
--
-- Method:      slopeType
--
-- Description: Set slope type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .slopeType()

  -- Initialise Variables

  -- Set slope type
  !this.slope.type(!this.type.selection())

  -- Setup form gadgets
  !this.setupGadgets()

endmethod
-- End of method definition for .slopeType()

----------------------------------------------------------------------
--
-- Method:      angle
--
-- Description: Set angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .angle()

  -- Initialise Variables

  if(!this.angle.val.between(-89, 89).not()) then
    !!alert.warning('Slope angle can only be between -89 and 89.')
    !this.angle.val = !this.slope.angle
    return
  endif

  !this.slope.slope(!this.angle.val)

endmethod
-- End of method for .angle()

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description: Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!option is STRING)

  -- Initialise Variables

  -- Measure
  if(!option eq 'PICK') then
    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.defineDirection('')
    !packet.description = !this.edgDescription
    !packet.action      = '!!cvlSlopeScreed.direction(!this.return[1])'
    !!edgCntrl.add(!packet)

  -- Direction
  elseif (!option eq 'TOWARDS') then

    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.definePosition('Point to which direction if to point')
    !packet.description = !this.edgDescription
    !packet.remove      = true
    !packet.action      = '!!cvlSlopeScreed.towards(!this.return[1].position)'
    !!edgCntrl.add(!packet)

  -- Direction
  elseif (!option eq 'OPPOSITE') then
    !this.direction(!this.slope.direction().opposite())

  -- Get elements XYZ direction
  else

    -- Check we have an orientation
    !orientation = !!ce.orientation

    if(!orientation.alpha.unset()) then
      !!messageFile.warning(151,2, !!ce.flnn)
      return
    endif

    -- Extract the direction
    if(!option.match('X').boolean()) then
      !direction = !orientation.xDir()
    elseif (!option.match('Y').boolean()) then
      !direction = !orientation.yDir()
    else
      !direction = !orientation.zDir()
    endif
    !this.direction(!direction)

  endif

endmethod
-- End of method definition for .setDirection(STRING)

------------------------------------------------------------------------
--
-- Method:      towards
--
-- Description: Set direction from the origin towards the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position direction is to be derived from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .towards(!position is POSITION)

  -- Direct slope screed plane to position
  !this.slope.towards(!position)

  -- Update direction
  !this.direction.val = !this.slope.direction().string().before('WRT').trim()

endmethod
-- End of method definition for .towards(POSITION)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction of slope from input value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction()

  -- Initialise Variables

  -- Define direction
  !direction = object DIRECTION(!this.direction.val)
  handle any
    !!alert.warning(!!error.text)
    !this.direction.val = !this.slope.direction().string().before('WRT').trim()
    return
  endhandle

  -- Direct slope screed plane to position
  !this.slope.direction(!direction)

endmethod
-- End of method definition for .direction()

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction of slope, from passed direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   New direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Direct slope screed plane to position
  !this.slope.direction(!direction)

  -- Update direction
  !this.direction.val = !this.slope.direction().string().before('WRT').trim()

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Set edg position event for a through position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .through()

  -- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- Get position of last item
  !position   = !this.slope.through()

  -- Show standard basic position definition
  !!pos3D.edit('!!cvlSlopeScreed.through(!this.position())', !position, 'Define slope through point', 'New through', true, !this.edgDescription)

endmethod
-- End of method definition for .through()

------------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Derive a through position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Point to pass through
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .through(!position is POSITION)

  -- Initialise Variables
  !this.slope.through(!position, !this.lock.val)

  -- Update Gadgets
  !this.direction.val = !this.slope.direction().string().before('WRT').trim()
  !this.angle.val     = !this.slope.slope()

endmethod
-- End of method definition for .through(POSITION)

------------------------------------------------------------------------
--
-- Method:      slopeOrigin
--
-- Description: Set edg position event for a slope origin position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slopeOrigin()

  -- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- Get position of last item
  !position   = !this.slope.position()

  -- If there is no position, then use E0N0U0
  if(!position.unset()) then
    !position = N0
  endif

  -- Show standard basic position definition
  !!pos3D.edit('!!cvlSlopeScreed.slopeOrigin(!this.position())', !position, 'Define slope origin point', 'Origin', true, !this.edgDescription)

endmethod
-- End of method definition for .slopeOrigin()

------------------------------------------------------------------------
--
-- Method:      slopeOrigin
--
-- Description: Derive a low position of slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Point to pass through
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slopeOrigin(!position is POSITION)

  -- Initialise Variables
  !this.slope.position(!position)

  -- Update Gadgets
  !this.direction.val    = !this.slope.direction().string().before('WRT').trim()
  !this.angle.val        = !this.slope.slope()

  -- Setup gadgets
  !this.setupGadgets()

endmethod
-- End of method definition for .slopeOrigin(POSITION)

------------------------------------------------------------------------
--
-- Method:      slopeEdge
--
-- Description: Set edg event for a slope origin position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slopeEdge()

  -- Position
  !packet                                   = object EDGPACKET()
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt                 = 'Pick edge to slope from'
  !packet.pickPacket.picks[1].pick.input[6] = 'edge'
  !packet.description                       = !this.edgDescription
  !packet.action                            = '!!cvlSlopeScreed.slopeEdge(!this.return[1])'
  !packet.priority                          = 2
  !packet.remove                            = true
  !packet.type                              = 'civils'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .slopeEdge()

------------------------------------------------------------------------
--
-- Method:      slopeEdge
--
-- Description: Derive a low position of slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Edge to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slopeEdge(!line is LINE)

  -- Initialise Variables
  !this.slope.edge(!line)

  -- Update Gadgets
  !this.direction.val    = !this.slope.direction().string().before('WRT').trim()
  !this.angle.val        = !this.slope.slope()

  -- Setup gadgets
  !this.setupGadgets()

endmethod
-- End of method definition for .slopeEdge(LINE)

------------------------------------------------------------------------
--
-- Method:      slopeEdges
--
-- Description: Set edg event for a slope origin position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slopeEdges()

  -- Position
  !packet                        = object EDGPACKET()
  !packet.description            = !this.edgDescription
  !packet.action                 = '!!cvlSlopeScreed.slopeEdges(!this.return[1][1], !this.return[1][2])'
  !packet.priority               = 2
  !packet.remove                 = true
  !packet.type                   = 'civils'

  !packet.pickPacket.key         = 'lineDerive'
  !packet.pickPacket.description = 'Derive a line from a db Element'
  !packet.pickPacket.prompt      = 'Slope edge line'

  !packet.pickPacket.picks.clear()
  !packet.pickPacket.picks[1]               = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].dbLine(', first')
  !packet.pickPacket.picks[1].pick.cursor   = 'doublecross'
  !packet.pickPacket.picks[1].pick.input[6] = 'edge'
  !packet.pickPacket.picks[2]               = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].dbLine(', second')
  !packet.pickPacket.picks[2].pick.cursor   = 'doublecross'
  !packet.pickPacket.picks[2].pick.input[6] = 'edge'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .slopeEdges()

------------------------------------------------------------------------
--
-- Method:      slopeEdges
--
-- Description: Derive a low position of slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Edges to slop along
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slopeEdges(!firstPick is EDGPOSITIONDATA, !secondPick is EDGPOSITIONDATA)

  -- Initialise Variables
  !maxOffset    = 1mm
  !!firstPick   = !firstPick
  !!secondPick  = !secondPick

  !firstLine    = !firstPick.line
  !secondLine   = !secondPick.line

  -- Check if lines are parallel
  if(!firstLine.direction().isParallel(!secondLine.direction())) then

    --


  -- Lines are not parallel
  else

    -- Distance between the intersection of the lines
    !distance   = !firstLine.distance(!secondLine)

    -- If the intersection distance > maximum offset, then we can't create a slope between the lines
    if(!distance gt !maxOffset) then
      !!alert.warning('Distance between intersection of edges is to great (maximum is ' & !maxOffset.string(!!distanceFmt) & ').')
      return
    endif

    -- Get intersection point of both lines
    !positionA  = !firstLine.intersection(!secondLine)
    !positionB  = !secondLine.intersection(!firstLine)

    -- Picked point on line
    !pointA     = !firstLine.intersection(!firstPick.pointVector)
    !pointB     = !secondLine.intersection(!secondPick.pointVector)

    -- Lines
    !firstLine  = !positionA.line(!pointA)
    !secondLine = !positionB.line(!pointB)

  endif

  !this.slope.edge(!firstLine)
  !this.slope.through(!secondLine.endPosition)

  -- Update Gadgets
  !this.direction.val    = !this.slope.direction().string().before('WRT').trim()
  !this.angle.val        = !this.slope.slope()

  -- Setup gadgets
  !this.setupGadgets()

endmethod
-- End of method definition for .slopeEdges(EDGPOSITIONDATA, EDGPOSITIONDATA)
