-- Description:
-- Form with parameters for creating slopes in top of panels
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!cvPanelSlope

  !!cvPanelSlope.formTitle     = 'Create Slope In Panel'
  !!cvPanelSlope.iconTitle     = 'SLOPE'
  !!cvPanelSlope.callback      = '!!cvPanelSlopeInit()'
  !!cvPanelSlope.formRevision  = ' $Revision: 1.5 $ '

member .lowPoint is POSITION

  -- Body of form definition
path down

toggle _confirm |Confirm|

text _thick |Minimum Thickness|  at x 1 y 1 width 10 is REAL Format !!distanceFmt


text _slope |Slope : 1/| at xmin_thick ymax call |!!cvPanelSlopePcnt()| width 10 is REAL
path right
text _percent |or |  call |!!cvPanelSlopeSlp()| width 10 is REAL
para _symbol text |%|
path down
 rgroup _radio at xmin_slope ymax
      add tag |Define Lowest Point| call |!!cvPanelSlopeLow()|
      add tag |Slope Floor From Edge| call |!!cvPanelSlopeEdge()|
      add tag |Navigate| call |!!cvPanelSlopeNavi()|
  exit

 -- Bottom Line
  button _cancel |Dismiss|  call '!!cvPanelSlopeDism()'  ok

exit
-- End of form definition for !!cvPanelSlope
