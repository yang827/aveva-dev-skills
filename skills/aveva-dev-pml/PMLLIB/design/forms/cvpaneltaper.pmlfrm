-- Description:
-- Form with parameters for creating tapered edges in bottom of panels
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!cvPanelTaper

  !!cvPanelTaper.formTitle     = 'Panel Taper Parameters'
  !!cvPanelTaper.iconTitle     = 'TAPER'
  !!cvPanelTaper.callback      = '!!cvPanelTaperInit()'
  !!cvPanelTaper.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
path down

toggle _confirm |Confirm|

text _thick |Edge Thickness| at x 1 y 1 width 16 is REAL Format !!distanceFmt

text _slope |Slope : 1/| at xmin_thick ymax call |!!cvPanelTaperPcnt()| width 10 is REAL
path right
text _percent |or |  call |!!cvPanelTaperSlp()| width 10 is REAL
para _symbol text |%|

path down
rgroup _radio at xmin_slope ymax
      add tag |Taper Floor From Edge| call |!!cvPanelTaperEdge()|
      add tag |Navigate| call |!!cvPanelTaperNavi()|
  exit

 -- Bottom Line

  button _cancel |Dismiss| call '!!cvPanelTaperDism()'  ok

exit
-- End of form definition for !!cvPanelTaper
