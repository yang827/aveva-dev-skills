setup form !!cvToolBar toolbar

  !!cvToolBar.formTitle     = 'Walls & Floors Toolbar'
  !!cvToolBar.iconTitle     = 'ToolBar'
  !!cvToolBar.callback      = ''
  !!cvToolBar.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
path right
hdist 0.1
 -- General
  button _break at x 0.2 y 0.2 tooltip 'Break Template'  pixmap width 24 height 24 call |!!genDemolishTmpl(!!ce)|
  button _level tooltip 'Change Elevation' pixmap  width 24 height 24 call |!!cvElevationShow()|
  button _prop  tooltip 'Modify Properties' pixmap width 24 height 24 call |!!genPropertyShow(!!ce.spref, 'MODIFY', 'Change Properties', '!!genChangeProp(!!ce)', '' ) |

  -- Walls
  button _str   at xmax+4 ymin tooltip 'Create Straight Wall' pixmap width 24 height 24 call |!!cvCreateStWall()|
  button _curv  tooltip 'Create Curved Wall' pixmap width 24 height 24 call |!!cvCreateSbWall()|
  button _spltw tooltip 'Split Wall' pixmap width 24 height 24 form _CDSSPLIT
  button _specw  tooltip 'Modify Wall Spec' pixmap width 24 height 24 call |!!cvWallSpecShow('CE')|
  button _justw  tooltip 'Modify Wall Justification' pixmap width 24 height 24 call |CALLSTL XSETPLINE $<Wall Justification$> JUSL WALL WALL  NULL|
  button _tracew tooltip 'Trace Floor with Wall' pixmap width 24 height 24 call |!!cvTraceFloorWall()|
  button _end   tooltip 'Modify Wall End' pixmap width 24 height 24 call |CALLSTL XJOINSPEC|
  button _fittw  tooltip 'Create Wall Fitting' pixmap width 24 height 24 call |!!strFittSpecShow('NEW','FITT')|
  button _trime tooltip 'Trim Wall End' pixmap width 24 height 24 call |CALLSTL MTRIM2PL|
  button _trimc tooltip 'Trim Connected Walls' pixmap width 24 height 24 call |CALLSTL MTRIM2PL false true|
  button _listw  tooltip 'Create List for Wall' pixmap width 24 height 24 call |CALLCIV UOWNERLIST 'WALL'|

  -- Floors
  button _newf   at xmax+4 ymin  tooltip 'Create Floor Panel' pixmap width 24 height 24 call |!!cvCreatePanel('')|
  button _panel  tooltip 'Edit Floor Panel' pixmap width 24 height 24 call |!!cvEditPanel()|
  button _spltf  tooltip 'Split Panel' pixmap width 24 height 24 call |CALLPLT MPSPLIT|
  button _specf   tooltip 'Modify Floor Spec' pixmap width 24 height 24 call |CALLCIV XFLOORSPEC STD|
  button _justf   tooltip 'Modify Floor Justification' pixmap width 24 height 24 call |CALLPLT XSETSJUS|
  button _tracef  tooltip 'Trace Wall with Floor' pixmap width 24 height 24 call |!!cvTraceWallShow()|
  button _seco   tooltip 'Trace Floor with Screed' pixmap width 24 height 24 call |!!cvTraceFloorScre()|
  button _nfall  tooltip 'Slope Panel' pixmap width 24 height 24 call |!!cvPanelSlopeShow()|
  button _ntaper tooltip 'Taper Panel' pixmap width 24 height 24 form !!cvPanelTaper
  button _fittf   tooltip 'Create Floor Fitting' pixmap width 24 height 24 call |!!strFittSpecShow('NEW', 'PFIT')|
  button _trimf  tooltip 'Trim Panel' pixmap width 24 height 24 call |CALLPLT MPANETRIM|
  button _listf   tooltip 'Create List for Floor' pixmap width 24 height 24 call |CALLCIV UOWNERLIST 'FLOOR' 'SCREED'|

-- set icons
!!cvToolBar.newf.addPixmap(!!pml.getPathName('createfloor24.png'))
!!cvToolBar.panel.addPixmap(!!pml.getPathName('createpanel24.png'))
!!cvToolBar.spltf.addPixmap(!!pml.getPathName('panelsplit24.png'))
!!cvToolBar.specf.addPixmap(!!pml.getPathName('floorspecs24.png'))
!!cvToolBar.level.addPixmap(!!pml.getPathName('elevation24.png'))
!!cvToolBar.justf.addPixmap(!!pml.getPathName('justifysurfaceh24.png'))
!!cvToolBar.tracef.addPixmap(!!pml.getPathName('walltrace24.png'))
!!cvToolBar.seco.addPixmap(!!pml.getPathName('tracefloor24.png'))
!!cvToolBar.nfall.addPixmap(!!pml.getPathName('taperscreed24.png'))
!!cvToolBar.ntaper.addPixmap(!!pml.getPathName('floortaper24.png'))
!!cvToolBar.break.addPixmap(!!pml.getPathName('decompose24.png'))
!!cvToolBar.fittf.addPixmap(!!pml.getPathName('floorfittings24.png'))
!!cvToolBar.listf.addPixmap(!!pml.getPathName('list24.png'))
!!cvToolBar.trimf.addPixmap(!!pml.getPathName('trimpanel24.png'))
!!cvToolBar.str.addPixmap(!!pml.getPathName('straightwall24.png'))
!!cvToolBar.curv.addPixmap(!!pml.getPathName('curvewall24.png'))
!!cvToolBar.spltw.addPixmap(!!pml.getPathName('wallsplit24.png'))
!!cvToolBar.specw.addPixmap(!!pml.getPathName('wallspecs24.png'))
!!cvToolBar.prop.addPixmap(!!pml.getPathName('properties24.png'))
!!cvToolBar.justw.addPixmap(!!pml.getPathName('justifysurfacev24.png'))
!!cvToolBar.tracew.addPixmap(!!pml.getPathName('floortrace24.png'))
!!cvToolBar.end.addPixmap(!!pml.getPathName('sectionjoints24.png'))
!!cvToolBar.fittw.addPixmap(!!pml.getPathName('wallfittings24.png'))
!!cvToolBar.listw.addPixmap(!!pml.getPathName('list24.png'))
!!cvToolBar.trime.addPixmap(!!pml.getPathName('trimwall24.png'))
!!cvToolBar.trimc.addPixmap(!!pml.getPathName('trimwalls24.png'))


exit
-- End of form definition for !!cvToolBar
