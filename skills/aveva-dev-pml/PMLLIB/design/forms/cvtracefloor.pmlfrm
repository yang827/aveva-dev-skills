-- Define form
setup form !!cvTraceFloor

  !!cvTraceFloor.formTitle     = 'Trace Floor'
  !!cvTraceFloor.iconTitle     = 'TRACE'
  !!cvTraceFloor.callback      = ''
  !!cvTraceFloor.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

path down
  rgroup _radio
      add tag |With Walls| call |!!cvTraceFloorWall()|
      add tag |With Screed| call |!!cvTraceFloorScre()|
      add tag |Navigate| call |!!cvTraceFloorNavi()|
  exit


 -- Bottom Line
  button _cancel |Dismiss| call '!!edgCntrl.remove(|Trace Floor|)' ok

exit
-- End of form definition for !!cvTraceFloor
