--
-- Description:
-- Form to control tracing wall with floor
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!cvTraceWall

  !!cvTraceWall.formTitle     = 'Trace Wall'
  !!cvTraceWall.iconTitle     = 'TRACE'
  !!cvTraceWall.callback      = '!!cvTraceWallInit()'
  !!cvTraceWall.formRevision  = ' $Revision: 1.5 $ '

member .sense is BOOLEAN
member .direction is BOOLEAN
member .points is ARRAY
member .walls is ARRAY

  -- Body of form definition

path down
  rgroup _radio
      add tag |With Floor| call |!!cvTraceWallPick()|
      add tag |Navigate| call '!!cvTraceWallNavi()'
  exit

  button _reverse |Reverse| call |!!cvTraceWallRever()|
  button _accept |Accept| call |!!cvTraceWallApply()|

 -- Bottom Line
  button _cancel |Dismiss| call '!!cvTraceWallDism()' ok


exit
-- End of form definition for !!cvTraceWall

