-- Define form
setup form !!cvWallSpec

  !!cvWallSpec.formTitle     = |Wall Specification|
  !!cvWallSpec.iconTitle     = |WallSpec|
  !!cvWallSpec.callback      = |call !!cvWallSpecInit()|
  !!cvWallSpec.formRevision  = | $Revision: 1.6 $ |

  -- Body of form definition

 -- Members

  member .material is DBREF
  member .default is SCTNSPEC
  member .current is SCTNSPEC
  member .mode is STRING
  member .element is DBREF
  member .listName is STRING

  -- Define Option Button
  option .ce at xmin y0.5 call |!!cvWallSpecSetCe(!this.ce.selection())| width 7
  !dText[1] = 'CE'
  !dText[2] = 'List'
  !dText[3] = 'Pick'
  _ce.dText = !dText

--   rgroup _Radio
--       add tag |CE| call |!!cvWallSpecCe()|
--       add tag |List| call |!!cvWallSpecColl()|
--       add tag |Pick| call |!!cvWallSpecPick()|
--       add tag |Default| call |!!cvWallSpecDflt()|
--   exit

 -- Display CE Name
  para _ceName at xmax+1 ymin width 30 height 1
  _ceName.val = ||

 -- Spec selection
  frame _sframe at x0.5 ymax+0.2 |Specification Data|

   -- Available Specs
    button _load |Specification| at x1 y0.9 call |call !!cvWallSpecInit()|
    option _spec | | at xmax+1 ymin  call |call !!cvWallSpecGtyp( _spec.selection('RTEXT').dbRef() )| width 20

   -- Available Sections Types
    path down
    halign right
    option _gtyp |Generic Type |  call |call !!cvWallSpecList( _gtyp.selection('RTEXT').dbRef() )| width 20

   -- Available Sections
    list _spre call |call !!cvWallSpecSpre ( _spre.selection('RTEXT').dbRef() ) | width 37 length 10

  exit

 -- Pline Settings
  frame _pframe at x0.5 ymax_sframe+0.2 |Pline Settings|

 -- Justification of Section
    option _just |Justification | at xmin+4 ymax call | !!cvWallSpec.current.just = !!cvWallSpec.just.selection('DTEXT')  | width 20

   -- Member Line of Section
    option _meml |Member line | call | !!cvWallSpec.current.meml = !!cvWallSpec.meml.selection('DTEXT')  | width 20

   -- Joint Line of section
    option _jLin |Joint line |  call | !!cvWallSpec.current.jLin = !!cvWallSpec.jLin.selection('DTEXT')  | width 20

  exit

 -- Options
  frame _oframe at x0.5 ymax_pframe+0.2 |Options|

   -- Retrim Attached
    toggle _wflg | Re-trim all attached walls.| at xmin+1 ymax+0.2 states |false| |true|

    -- Retrim Attached
    toggle _fflg | Re-trim all attached floors.| at xmin ymax+0.2 states |false| |true|

    toggle _dflt | Use as default profile.| at xmin ymax+0.2

    -- Display plot file
    button _plot |Plotfile...| at xmax+1 ymin call |call !!sctlDisplayPlot(_spre.selection('RTEXT').dbRef(), true, true )|

  exit

 -- Bottom Line
  button _dismiss |Dismiss| at xmax form+1-size ymax+0.5  call |!!cvWallSpecCancel()| ok
  button _apply   |Apply|   at xmin form-0     ymin    call |call !!cvWallSpecApply()|

exit
-- End of form definition for !!cvWallSpec
