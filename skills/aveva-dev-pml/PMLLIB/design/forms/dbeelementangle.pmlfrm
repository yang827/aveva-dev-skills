--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Apr 12 10:54:15 BST 1999
--
--
-- Description:
-- Change angle of element.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angle()                          -                   Set new angle
--  apply()                          -                   Apply form
--  close()                          -                   Close form and tidy
--  dbeElementAngle()                -                   Constructor
--  locks()                          -                   Maintain the gadget locking
--  measureAngle(MENU,STRING)        -                   Setup to measure of angle
--  measureAngle(POSITION)           -                   Update angle, derive angle from locked end to point picked when mapped on the plane
--  measureAngle(REAL)               -                   Update angle
--  pick()                           -                   Pick element to update
--  preview()                        -                   Preview axes
--  setup(DBREF)                     -                   Setup form for passed element
--  through(POSITION)                -                   Move end through the passed point
--  through(STRING)                  -                   Set edg event for moving start/end through a position
--  tidy()                           -                   Tidy form data
--
------------------------------------------------------------------------

setup form !!dbeElementAngle

  !this.formTitle     = 'Element Angle'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  -- Bar
  bar
  exit

  -- Current element
  text .ceName     at xmin ymax tooltip 'Element being modified' width 25 is STRING
  path down
  halign left

  -- Locks
  rgroup .locks 'Lock' callback '!this.locks()' frame horizontal
    add tag 'Start' select 'START'
    add tag 'End'   select 'END'
    add tag 'Angle' select 'ANGLE'
  exit
  halign right

  -- Angle
  text   .angle     'Angle ' callback '!this.angle()' width 9 is REAL format !!realFmt

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin form-0    ymax+0.2 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin     callback '!this.close()'

  -- Form Variables
  member .element        is DBREF
  member .currentAngle   is REAL
  member .maxAngle       is REAL

  -- Origin
  member .position       is POSITION

  -- Reference Plane
  member .plane          is PLANE
  member .arc            is ARC

  -- Translate orientation from plane (revolutions)
  member .translate      is BOOLEAN

  -- Special for revolutions build on the -Y of the rotation line
  member .flip           is BOOLEAN

  -- Line of rotation
  member .rotationLine   is LINE

  -- Line for start and end angle
  member .startLine      is LINE
  member .endLine        is LINE

  -- End to be moved
  member .end            is STRING

  -- Event Description
  member .edgDescription is STRING

  -- Aid Graphics
  member .aidNumber      is REAL
  member .aidAxes        is REAL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeElementAngle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeElementAngle()

  -- Initialise Variables
  !this.cancelCall     = '!this.close()'
  -- Aid Number
  !this.aidNumber      = !!aidNumbers.add('Orientation')
  !this.aidAxes        = !!aidNumbers.add('Orientation')

  -- Edg Description
  !this.edgDescription = 'Orientate Element'

  -- Stop ceName being typed in
  !this.ceName.setEditable(false)

  -- Bar
  !bar = !this.bar
  !bar.add('Select',   'menuSelect')
  !bar.add('Derive',   'menuDerive')

  -- Select Menu
  !menu = !this.newMenu('menuSelect')
    !menu.add('callback', 'CE',               '!this.setup(!!ce)')
    !menu.add('separator')
    !menu.add('callback', 'Pick',             '!this.pick()')

  -- Select Menu
  !menu = !this.newMenu('menuDerive')
    !menu.add('callback', 'Start through', '!this.through(''START'')')
    !menu.add('callback', 'End through',   '!this.through(''END'')')

  -- Angle Measure
  !menu = !this.newMenu('angleMenu')
    !menu.add('callback', 'Angle between three points', '!this.measureAngle(')
    !menu.add('callback', 'Angle between two lines',    '!this.measureAngle(')
    !menu.add('callback', 'Angle through a point',      '!this.measureAngle(')
  !this.angle.setPopup(!this.angleMenu)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.edgDescription)

  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Grid
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise Variables
  !reference = !!ce

  -- Move to element
  !!ce       = !this.element

  ANGLE $!<this.currentAngle>

  -- Orientate
  if(!this.translate) then
    if(!this.flip) then
      !orientation = object ORIENTATION('X is ' & !this.plane.direction() & ' and Y is ' & !this.plane.orientation.xDir().opposite())
    else
      !orientation = object ORIENTATION('X is ' & !this.plane.direction() & ' and Y is ' & !this.plane.orientation.xDir())
    endif
  else
    !orientation = !this.plane.orientation
  endif

  ORI $!<orientation>

  -- Return to original element
  !!ce       = !reference

  -- Reinitialise form
  !this.setup(!this.element)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Initialise Variables
  !this.tidy()

  -- Mid Point
  !midPoint = !this.rotationLine.proportion(0.5)

  -- Rotation Line
  AID LINE NUMBER $!<this.aidAxes>   $!<this.rotationLine.startPosition> TO  $!<this.rotationLine.endPosition> LINEST DASHDOT
  AID TEXT NUMBER $!<this.aidNumber> 'Rotation Line' AT $!<midPoint>

  -- Create an arc of half radius
  !arc        = !this.arc
  !arc.radius = !arc.radius / 2
  if(!this.currentAngle le 180) then
    !segments   = 12
  else
    !segments   = 24
  endif

  -- Get number of segments
  !angle      = !this.currentAngle / !segments

  if(!angle gt 0) then

    -- Start position of first line
    !from       = !arc.anglePosition(0)

    -- Generate each segment
    do !i from 1 to !segments

      -- Get end of line for segment
      !to   = !arc.anglePosition(!angle * !i)
      AID LINE NUMBER $!<this.aidNumber> $!<from> TO $!<to>

      -- End of segment eq to start of next segment
      !from = !to
    enddo

    !midPoint = !arc.anglePosition(!arc.angle() / 2)

  else
    !midPoint = !this.startLine.proportion(0.5)
  endif

  -- Re define the start line and end line
  !this.startLine = !this.startLine.towards(!arc.anglePosition(!arc.startAngle))
  !this.endLine = !this.endLine.towards(!arc.anglePosition(!arc.endAngle))

  -- Start Line
  AID LINE NUMBER $!<this.aidNumber> $!<this.startLine.startPosition>    TO  $!<this.startLine.endPosition>
  AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<this.startLine.endPosition>

  -- End Line
  AID LINE NUMBER $!<this.aidNumber> $!<this.endLine.startPosition>      TO  $!<this.endLine.endPosition>
  AID TEXT NUMBER $!<this.aidNumber> 'End'   AT $!<this.endLine.endPosition>

  -- Tag the angle
  AID TEXT NUMBER $!<this.aidNumber> '$!this.currentAngle'   AT $!<midPoint>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to setup form with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!passedElement is DBREF)

  -- Initialise Variables

  -- Get element with angle attribute
  !element = !!dtbWithAttribute(!passedElement, 'angle')

  -- If element is unset, the return
  if(!element.unset()) then
    !!alert.warning('Element (' & !passedElement.flnn & ') or a parent does not have an angle attribute.')
    return
  endif

  -- Check we have access to modify element
  if(!!dbRefUpdate(!element).not()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- Return for element with angle, but the utility does not handle
  if(not !element.type inset('RTOR', 'CTOR', 'NRTO', 'NCTO', 'REVO', 'NREV')) then
    !!alert.warning('Unable to modify angle of element (' & !element.flnn & ') using this utility.')
    return
  endif

  -- Get local volume of item
  !localVolume     = object LOCALVOLUME(!element, !element)

  -- Determine the axes of angle
  -- Circular and Rectangular torii
  if(!element.type inset('RTOR', 'CTOR', 'NRTO', 'NCTO')) then

    -- Use Z components of local volume
    !distance        = !localVolume.to.up - !localVolume.from.up
    !pointVector     = object POINTVECTOR(!localVolume.from, !element.orientation.zDir())
    !rotationLine    = !pointVector.line(!distance).parallel(!element.position)

    !startLine       = object LINE(!element.position, !element.pPosition[2])
    if (!startLine.length().eq(0)) then
       !position = !element.position
       !position.east = !position.east + !this.rotationLine.length()
       !startLine       = object LINE(!element.position, !position)
    endif
    !startLine       = !startLine.parallel(!element.position)
    !endLine         = object LINE(!element.position, !element.pPosition[1])
    if (!endLine.length().eq(0)) then
       !position = !element.position
       !position.north = !position.north + !this.rotationLine.length()
       !endLine       = object LINE(!element.position, !position)
    endif
    !endLine         = !endLine.parallel(!element.position)

    !length          = !element.rOutside * 1.1
    if (!length.eq(0)) then
      !length = !this.rotationLine.length()
    endif
    !startLine       = !startLine.setLengthEnd(!length)
    !endLine         = !endLine.setLengthEnd(!length)

    !maxAngle        = 180

    -- Plane rotation (Z is rotation axes)
    !plane           = object PLANE(!element.position, !element.orientation)

    -- Translate orientation
    !translate       = false
    !flip            = false

  -- Position and Negative revolutions
  elseif (!element.type inset('REVO', 'NREV')) then

    -- Use X components of local volume
    if (!localVolume.unset()) then
      !!alert.message('Revolution element has no geometry. Unable to modify angle.')
      return
    endif
    !distance        = !localVolume.to.east - !localVolume.from.east
    !pointVector     = object POINTVECTOR(!localVolume.from, !element.orientation.xDir())
    !rotationLine    = !pointVector.line(!distance).parallel(!element.position)

    -- Get greatest Y point
    var !collection COLLECT ALL VERT FOR LOOP 1 OF $!<element>
    !block           = object BLOCK('!collection[!evalIndex].dbref().position.north')
    !positions       = !collection.evaluate(!block)
    !sort            = !positions.sortedIndices()
    !sort.invert()

    !point           = !collection[!sort[1]].dbref()
    !startLine       = object LINE(!rotationLine.near(!point.pPosition[1]), !point.pPosition[1])
    !startLine       = !startLine.parallel(!element.position)
    !endLine         = object LINE(!rotationLine.near(!point.pPosition[3]), !point.pPosition[3])
    !endLine         = !endLine.parallel(!element.position)

    !length          = !startLine.length() * 1.1
    !startLine       = !startLine.setLengthEnd(!length)
    !endLine         = !endLine.setLengthEnd(!length)

    !maxAngle        = 360

    -- Plane rotation (Z is rotation axes, therefore we need to re-orientate the plane from the revolutions orientation)
    !plane           = object PLANE(!element.position, object ORIENTATION('Z is ' & !element.orientation.xDir() & ' and X is '  & !startLine.direction()))

    -- Translate orientation
    !translate       = true
    if(!element.orientation.yDir() eq !startLine.direction()) then
      !flip          = false
    else
      !flip          = true
    endif
  endif

  -- Initialise Form data
  !this.element      = !element
  !this.ceName.val   = !this.element.flnn
  !this.ceName.setTooltip(!this.element.flnn)
  !this.position     = !this.element.position

  -- Set plane
  !this.plane        = !plane
  !this.translate    = !translate
  !this.flip         = !flip

  -- Rotation Line
  !defaultLength     = !rotationLine.length()
  !newLength         = !defaultLength * 1.2
  !length            = !newLength.max(1000mm)
  !rotationLine      = !rotationLine.setLengthEnd((!length - !defaultLength) / 2 + !defaultLength)
  !rotationLine      = !rotationLine.setLengthStart(!length)
  !this.rotationLine = !rotationLine
  !this.startLine    = !startLine
  !this.endLine      = !endLine

  -- Set Angle
  !this.angle.val    = !this.element.angle
  !this.currentAngle = !this.element.angle
  !this.maxAngle     = !maxAngle

  -- Arc
  !this.arc          = object ARC(!this.plane.position, !this.plane.orientation, 0, !this.currentAngle, !this.startLine.length(), true)

  -- Set locks
  !this.locks()

  -- Preview
  !this.preview()

  -- Show form
  !this.show()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Pick element to update
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick()

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick item to be modified')
  !packet.action         = '!!dbeElementAngle.setup(!this.return[1].item)'

  !packet.key            = 'angle Element'
  !packet.description    = !this.edgDescription
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      angle
--
-- Description: Set new angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .angle()

  -- Initialise Variables

  -- If angle is same as current angle, don't do anything
  if(!this.angle.val eq !this.currentAngle) then
    return
  endif

  -- Check we have not passed the maximum angle
  if(!this.angle.val gt !this.maxAngle or !this.angle.val le 0) then
    !!alert.warning('Angle for element type "' & !this.element.fulltype & '", must be greater than 0 and less or equal to ' & !this.maxAngle & '.')
    !this.angle.val = !this.currentAngle
    return
  endif

  -- Move End
  if(!this.end eq 'END') then

    -- Recalculate end line
    !xyOffset                   = object XYPOSITION(!this.angle.val.cosine() * !this.arc.radius, !this.angle.val.sine() * !this.arc.radius)
    !this.endLine.endPosition   = !this.plane.threeDPosition(!xyOffset)

  -- Move Start
  else

    !angle                      = !this.currentAngle - !this.angle.val
    !xyOffset                   = object XYPOSITION(!angle.cosine() * !this.arc.radius, !angle.sine() * !this.arc.radius)
    !this.startLine.endPosition = !this.plane.threeDPosition(!xyOffset)

    -- Re-orientate the plane
    !this.plane.orientation     = object ORIENTATION('Z is ' & !this.plane.direction() & ' and X is ' & !this.startLine.direction())
    !this.arc.orientation       = !this.plane.orientation

  endif

  -- Reset current
  !this.currentAngle = !this.angle.val
  !this.arc.endAngle = !this.currentAngle

  -- Preview
  !this.preview()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      locks
--
-- Description: Maintain the gadget locking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .locks()

  -- Initialise Variables

  -- Lock End
  if(!this.locks.selection() eq 'START') then
    !this.angle.active = true
    !this.menuDerive.setActive('Start through', false)
    !this.menuDerive.setActive('End through',   true)
    !this.end          = 'END'

  -- Lock Start
  elseif (!this.locks.selection() eq 'END') then
    !this.angle.active = true
    !this.menuDerive.setActive('Start through', true)
    !this.menuDerive.setActive('End through',   false)
    !this.end          = 'START'

  -- Lock Angle
  else
    !this.angle.active = false
    !this.menuDerive.setActive('Start through', true)
    !this.menuDerive.setActive('End through',   true)
     !this.end          = STRING()

  endif

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Set edg event for moving start/end through a position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .through(!end is STRING)

  -- Initialise Variables
  !packet = object EDGPACKET()

  -- Start Move
  if(!end.upcase() eq 'START') then
    !prompt  = 'Point Start is to pass through'
    !moveEnd = 'START'
  else
    !prompt  = 'Point End is to pass through'
    !moveEnd = 'END'
  endif

  !packet.definePosition(!prompt)
  !packet.action      = '!!dbeElementAngle.through(!this.return[1].position)'
  !packet.close       = '!!dbeElementAngle.setActive(true)'
  !packet.remove      = true
  !packet.description = !this.edgDescription

  -- Add to edg system
  if(!!edgCntrl.add(!packet)) then
    !this.end = !moveEnd
    !this.setActive(false)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Move end through the passed point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .through(!position is POSITION)

  -- Initialise variables
  !lock = !this.locks.selection()

  -- Modify angle
  if(!lock ne 'ANGLE') then
    !this.measureAngle(!position)

  -- Re-orientate
  else

    -- Map position onto plane
    !planePosition       = !this.plane.near(!position)

    -- Move start through the passed point
    if(!this.end eq 'START') then

      -- Change orientation
      !plane             = !this.plane
      !orientation       = object ORIENTATION('Z is ' & !plane.direction() & ' and X is ' & !plane.position.direction(!planePosition))
      !plane.orientation = !orientation

    -- Move end through the passed point
    else

      -- initially change orientation, so the X goes through the point
      !plane             = !this.plane
      !orientation       = object ORIENTATION('Z is ' & !plane.direction() & ' and X is ' & !plane.position.direction(!planePosition))
      !plane.orientation = !orientation

      -- Get the new position for the X to go through
      !angle             = !this.currentAngle * -1
      !xyOffset          = object XYPOSITION(!angle.cosine() * !this.arc.radius, !angle.sine() * !this.arc.radius)
      !planePosition     = !plane.threeDPosition(!xyOffset)
      !orientation       = object ORIENTATION('Z is ' & !plane.direction() & ' and X is ' & !plane.position.direction(!planePosition))
      !plane.orientation = !orientation

    endif

    -- Derive the new start and end line position
    !startEnd            = object XYPOSITION(!this.arc.radius, 0)
    !endEnd              = object XYPOSITION(!this.currentAngle.cosine() * !this.arc.radius,   !this.currentAngle.sine() * !this.arc.radius)

    -- Change Lines
    !this.plane                 = !plane
    !this.startLine.endPosition = !this.plane.threeDPosition(!startEnd)
    !this.endLine.endPosition   = !this.plane.threeDPosition(!endEnd)
    !this.arc.orientation       = !this.plane.orientation
    !this.arc.position          = !this.plane.position

    -- Update graphics
    !this.preview()
  endif

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Setup to measure of angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureAngle(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'ANGLE BETWEEN THREE POINTS') then
    !packet.defineMeasure('angle')
    !packet.action    = '!!dbeElementAngle.measureAngle(!this.return[1].angle())'

  -- Measure parallel
  elseif (!option eq 'ANGLE BETWEEN TWO LINES') then
    !packet.defineMeasure('lineangle')
    !packet.action    = '!!dbeElementAngle.measureAngle(!this.return[1])'

  -- Measure parallel
  elseif (!option eq 'ANGLE THROUGH A POINT') then
    !packet.definePosition('Point through which angle passes')
    !packet.action    = '!!dbeElementAngle.measureAngle(!this.return[1].position)'
  endif

  !packet.close       = '!!dbeElementAngle.setActive(true)'
  !packet.remove      = true
  !packet.description = !this.edgDescription

  -- Add to edg system
  if(!!edgCntrl.add(!packet)) then
    !this.setActive(false)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Update angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .measureAngle(!angle is REAL)

  -- Set angle
  !this.angle.val = !angle

  -- Update
  !this.angle()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Update angle, derive angle from locked end to point picked when mapped on the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .measureAngle(!position is POSITION)

  -- Map position onto plane
  !planePosition = !this.plane.near(!position)

  -- Define arc
  !arc           = !this.arc

  -- Start/End angle
  if(!this.end eq 'START') then
    !arc = !arc.startPosition(!planePosition)
  else
    !arc = !arc.endPosition(!planePosition)
  endif

  -- Set angle
  !this.angle.val = !arc.angle()

  -- Preview
  !this.angle()

endmethod
-- End of method definition
