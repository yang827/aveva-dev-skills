-- Created:         Tue Aug 11 14:17:42 BST 1998
--
--
-- Description:
-- Extrusion Creation form
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   Apply form
--  arc(ARC)                         -                   Create points using passed arc definition
--  build()                          -                   Build Extrusion/loop from current data
--  cancel()                         -                   Apply form
--  close()                          -                   Close form
--  dbeExtrusion()                   -                   Constructor
--  define3Points()                  -                   Setup EDG mode to define arc passing through three points
--  defineExplicit()                 -                   Setup EDG mode to define points explicitly
--  defineFRadTan()                  -                   Setup EDG mode to define arc of fixed radius passing through 2 points
--  defineFillet()                   -                   Setup EDG mode to define point using fillet method
--  defineOffset()                   -                   Setup EDG mode to define with relative offset from previous
--  definePoints()                   -                   Setup EDG mode for defining by graphic picks
--  defineTrace()                    -                   Setup to define edge by tracing another Extrusion/extrusion
--  initialise()                     -                   Initialise the form
--  modifyLoop()                     -                   Modify the loop of the extrusion using the profile editor
--  modifyMode(DBREF)                -                   Switch to the form's modify mode
--  modifyProf()                     -
--  position(POSITION)               -                   Create point using passed position
--  removeLast()                     -                   Remove last vertices point
--  representation()                 -                   Set representation data to selection
--  thickness()                      -                   Set thickness
--  tidy()                           -                   Tidy up graphics
--  updateForm()                     -                   Update form information
--
------------------------------------------------------------------------

setup form !!dbeExtrusion Varchars

  !!dbeExtrusion.formTitle     = 'Create Extrusion'
  !!dbeExtrusion.iconTitle     = 'CrtExtru'
  !!dbeExtrusion.callback      = '!this.initialise()'
  !!dbeExtrusion.formRevision  = ' $Revision: 1.16 $ '

  path right
  hdist 2
  -- Name Option
  para     .nameTag  at x0.5 y0.5 width 8 lines 1
  option   .autoName at xmin.nameTag ymin.nameTag width 8

  -- Element Name
  text     .name ' ' callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 36 is STRING

  -- Thickness
  path down
  text     .thickness 'Thickness' callback '!this.thickness()' width 14 is REAL format !!distanceFmt

 -- Obst and Level Data
  frame .repFrame 'Representation' at xmin.autoname width 50
    option   .perDefinedObs tagwid 10 'Predefined'   at x1  callback '!this.representation() ' width 30
    text     .fromLevel     tagwid 10 'Levels'         width 2  scroll 3 is REAL
    path right
    text     .toLevel                                  width 2  scroll 3 is REAL
    option   .obstruction   'Obstruction' at xmax+10   width 4
  exit

  -- Create Methods
  path down
  frame .crtFrame 'Create Methods' at xmin.repFrame width.repframe

    -- Type of creation
    button .defPoints at x0.5 ymax pix unsel $!!cdpmPoints width 24 heig 24 tooltip 'Derive points from graphic picks'           callback '!this.definePoints()'
    path right
    hdist 0
--    button .defTrace               pix unsel $!!cdpmEdge    width 24 heig 24 tooltip 'Trace boundary of another extrusion/Extrusion'  callback '!this.defineTrace()'
    button .defExplicit            pix                      width 24 heig 24 tooltip 'Explicitly defined position'                callback '!this.defineExplicit()'
    button .defOffset              pix                      width 24 heig 24 tooltip 'Point offset from previous'                 callback '!this.defineOffset()'
    button .defFillet              pix                      width 24 heig 24 tooltip 'Define arc fillet'                          callback '!this.defineFillet()'
    button .def3Points             pix                      width 24 heig 24 tooltip 'Derived arc passing through three points'   callback '!this.define3Points()'
    button .defFRadTan2            pix                      width 24 heig 24 tooltip 'Fixed radius arc, passing through 2 points' callback '!this.defineFRadTan()'

    path down
    para   .detail  at x1 width 45 lines 1
    -- Number of vertices created
    button .remove 'Remove Last Definition' at xmin ymax callback '!this.removeLast()'

  exit

  -- Modify Methods (overlaid on Create Methods)
  path down
  frame .modFrame 'Modify Shape' at xmin.crtFrame ymin.crtFrame width.repframe
    paragraph .iconLoopEdit                         at x1         ymax+0.2      pixmap width 16 height 16
    button    .loopEdit  linklabel 'Loop editor'    at xmax+2     ymin          callback '!this.modifyLoop()'
  exit

 -- Bottom Line
  path right
  button .apply            '  OK  ' at xmin form  ymax form     callback '!this.apply(|CREATE|)'
  toggle .displayModify    'Display modification form' states 'false' 'true'
  button .dismiss          'Cancel' at xmax form-size callback '!this.cancel()'

 -- User Data

  -- Form members
  -- Current Active extrusion
  member .extrusion       is DBREF
  -- Loop Name
  member .loop            is DBREF
  -- Extrusion plane
  member .plane           is PLANE

  -- Vertex definitions

  -- Created (i.e. after three points, we can create a Extrusion)
  member .created         is BOOLEAN

  -- Vertices Data
  member .positions       is ARRAY
  member .radii           is ARRAY

  -- Aid number information
  member .aidNumbers      is ARRAY
  member .aidNumber       is REAL
  member .aidTag          is REAL
  member .aidAxes         is REAL

  -- Storage Areas
  member .owner           is DBREF

  -- Last number of definition points
  member .lastDefCount    is ARRAY
  member .lastDefType     is ARRAY

exit
  -- To exit EDG when closing form
  !!dbeExtrusion.cancelCall = '!!dbeExtrusion.cancel()'


-- End of form definition for !!dbeExtrusion

------------------------------------------------------------------------
--
-- Method:      dbeExtrusion
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeExtrusion()

  -- Naming method
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Name')
  !rText.append('false')
  !dText.append('Autoname')
  !rText.append('true')
  !this.autoName.dText      = !dText
  !this.autoName.rText      = !rText

  -- Obstruction
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Hard')
  !rText.append('2')
  !dText.append('Soft')
  !rText.append('1')
  !dText.append('None')
  !rText.append('0')
  !this.obstruction.dText = !dText
  !this.obstruction.rText = !rText

  -- Default thickness
  !this.thickness.val     = 0

  -- Define Icons
  !this.defExplicit.addPixmap(!!pml.getPathName('xyz24.png'))
  !this.defOffset.addPixmap(!!pml.getPathName('distancedirection24.png'))
  !this.defFillet.addPixmap(!!pml.getPathName('circlefillet24.png'))
  !this.def3Points.addPixmap(!!pml.getPathName('circle3pnt24.png'))
  !this.defFRadTan2.addPixmap(!!pml.getPathName('circlefrad2pnttan24.png'))
  !this.iconLoopEdit.addPixmap(!!pml.getPathName('createpanel24.png'))

  -- Aid number
  !this.aidTag    = !!aidNumbers.add('Extrusion Creation')
  !this.aidNumber = !!aidNumbers.add('Extrusion Creation')
  !this.aidAxes   = !!aidNumbers.add('Extrusion Creation')

  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP" $<!!dbeExtrusion.perDefinedObs$>

 !this.perDefinedObs.val = 2
 !this.representation()

endmethod
-- End of method definition for .dbeExtrusion()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Clear aid tags
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidTag)
  !this.name.val        = STRING()
  !this.created         = false
  !this.extrusion       = object DBREF()
  !this.loop            = object DBREF()
  !this.plane           = object PLANE()
  !this.lastDefCount.clear()
  !this.lastDefType.clear()
  !this.positions.clear()
  !this.radii.clear()
  !this.aidNumbers.clear()
  !this.updateForm()
  !this.nameTag.visible = false

  -- Get the parent we are to store beneath
  !owner = !!dtbOwnerOfType(!!ce, 'EXTR')

  -- If there is no owner, then give an error
  if(!owner.unset()) then
    !!alert.warning('Unable to create an extrusion within this hierarchy structure. Move to an element that can own one.')
    return error 1 noalert
  endif

  -- Set owner we want to create extrusion beneath
  !this.owner = !owner

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!state is STRING)

  -- Check if loop exists if in create state
  if (!state.eq(|CREATE|)) then
  -- If there is no Extrusion created, then give a warning
  if(!this.loop.unset()) then
    !!alert.message('Unable to create Extrusion with less than three vertices defined.')
    return
  endif
  endif

  -- Initialise Variables
  !reference = !!ce

  -- Apply data to Extrusion
  !!ce = !this.extrusion

  !obstruction = !this.obstruction.selection()
  OBST  $!obstruction
  if(!this.fromLevel.val le !this.toLevel.val) then
    LEVEL $!this.fromLevel.val $!this.toLevel.val
  else
    LEVEL $!this.toLevel.val $!this.fromLevel.val
  endif

  -- Autoname
  if(!!dbeExtrusion.autoName.selection().boolean()) then
    !name = !!namOpt.nameString(!!ce, '', false, false)

  -- Use specified
  else
    !name = !this.name.val
  endif

  -- Name
  if(!name.set()) then
    NAME $!<name>
  endif

  -- Thickness
  if (!state.eq(|MODIFY|)) then
    HEIGHT $!<this.thickness.val>
  endif

  -- OLD CODE and CALL TO PMDSUI
  if(!this.displayModify.val) then
    --call !!dbeLoopEdit(!this.extrusion, !this.extrusion.type)
    !this.modifyMode(!this.extrusion)
    return
  endif

  -- After create, if not entering modify mode, go to create
  if (!state.eq(|CREATE|)) then
  -- Close
  !this.close()
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  -- If there is no Extrusion created, then give a warning
  if(!this.loop.set()) then
    if (!!dbeExtrusion.formTitle.eq(|Modify Extrusion|)) then
    else
      if(!!alert.confirm(' Created Extrusion during the definition, do you want to retain the defined Extrusion?..').boolean().not()) then
        !!ce = !this.extrusion
        DELETE EXTR
      endif
    endif
  endif

  -- Display create gadgets
  !this.crtFrame.visible      = true
  !this.displayModify.visible = true
  !this.autoName.visible      = true
  !this.autoName.active       = true

  -- Hide modify gadgets
  !this.modFrame.visible      = false
  !!dbeExtrusion.formTitle    = 'Create Extrusion'
  !this.nameTag.visible       = false

  -- Set text on buttons
  !this.apply.tag             = '  OK  '
  !this.dismiss.tag           = 'Cancel'

  -- Set callbacks on buttons
  !this.apply.callback        = '!this.apply(|CREATE|)'

  -- Clear any values remaining in gadgets
  !this.name.val = ''
  !this.obstruction.select(|RTEXT|,'2')
  !this.thickness.val.unset()
  !this.perDefinedObs.val = 1

  -- Unset current extrusion
  !this.extrusion.unset()
  !this.loop.unset()

  -- Close
  !this.close()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Tidy
  !this.tidy()

  -- Hide form
  !this.hide()

  -- Remove EDG
  !!edgCntrl.remove('Extrusion Creation')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid elements
  do !i indices !this.aidNumbers
    !!aidNumbers.remove(!this.aidNumbers[!i])
  enddo
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      updateForm
--
-- Description: Update form information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateForm()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidTag)

  -- No vertices defined
  if(!this.loop.unset() and !this.positions.size() eq 0) then
    !this.detail.val      = 'No vertices currently defined'
    !this.remove.active   = false
    !this.tidy()

  -- No Extrusion created, but vertices defined
  elseif (!this.loop.unset() and !this.positions.size() gt 0) then
    !this.detail.val      = !this.positions.size().string() & ' Vertices defined (no Extrusion created)'
    !this.remove.active   = true

    -- Tag the origin
    AID TEXT NUMBER $!<this.aidTag> 'Origin' AT $!<this.positions[1]>

    -- Tag the last point
    if(!this.positions.size() gt 1) then
      !last = !this.positions.size()
      AID TEXT NUMBER $!<this.aidTag> 'Last Vertex' AT $!<this.positions[$!<last>]>
    endif

  -- More than 3 vertices
  elseif (!this.loop.set()) then
    !this.detail.val      = !this.positions.size() + !this.loop.mCount & ' Vertices defined (Extrusion created)'

    -- See how many vertices are in the loop
    !last         = !this.loop.mCount

    -- No vertices, only tag Extrusion origin
    if(!last eq 0) then
      !this.remove.active   = false

      !position = !this.extrusion.position
      AID TEXT NUMBER $!<this.aidTag> 'Extrusion Origin' AT $!<position>

    -- Tag start of loop
    elseif (!last gt 0) then
      !this.remove.active   = true

      !position = !this.loop.members[1].position
      AID TEXT NUMBER $!<this.aidTag> 'Origin' AT $!<position>
      if(!last gt 1) then
        !position = !this.loop.members[!last].position
        AID TEXT NUMBER $!<this.aidTag> 'Last Vertex' AT $!<position>
      endif
    endif
  endif

endmethod
-- End of method definition for .updateForm()

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Set representation data to selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .representation()

  -- Initialise Variables
  !key = !this.perDefinedObs.selection()

  -- Get representation from system
  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP-DAT" $<KEY$> $<$!key$>
  if(defined(!!cdinRtn))then
    !this.obstruction.select('RTEXT',!!cdinRtn)
    !this.fromLevel.val  = !!cdiaRtn[1].real()
    !this.toLevel.val    = !!cdiaRtn[2].real()
  endif

endmethod
-- End of method definition for .representation()

------------------------------------------------------------------------
--
-- Method:      thickness
--
-- Description: Set thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thickness()

  -- Return if there is no loop
  if(!this.loop.unset()) then
    return
  endif

  -- Initialise Variables
  !reference = !!ce

  -- Move to loop and set thickness
  !!ce = !this.extrusion
  HEIGHT $!<this.thickness.val>
  !!ce = !reference

endmethod
-- End of method definition for .thickness()

------------------------------------------------------------------------
--
-- Method:      removeLast
--
-- Description: Remove last vertices point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeLast()

  -- Initialise Variables
  !removed        = false

  -- Get number of points that were last defined
  !last           = !this.lastDefCount.size()
  !lastDefCount   = !this.lastDefCount[!last]
  !lastDefType    = !this.lastDefType[!last]

  -- If there is no loop created, then we are looking at the .positions/.radii members
  if(!this.loop.unset()) then

    -- Get the last point in the list
    !lastPoint = !this.positions.size()

    -- If there are more than the last definition, remove them
    if(!lastPoint gt 0 and !lastPoint ge !lastDefCount) then

      !beginLast  = !lastPoint - !lastDefCount + 1
      !this.positions.removeFrom(!beginLast, !lastDefCount)
      !this.radii.removeFrom(!beginLast, !lastDefCount)
      !removed    = true

    endif

  -- Loop Defined
  else

    -- Get the last point in the list
    !lastPoint = !this.loop.mCount

    -- If there are more than the last definition, remove them
    if(!lastPoint gt 0 and !lastPoint ge !lastDefCount) then

      -- Current element
      !reference  = !!ce
      !!ce        = !this.loop

      !beginLast  = !lastPoint - !lastDefCount + 1

      DELETE LOOP MEMB $!<beginLast> TO $!<lastPoint>

      !!ce        = REFERENCE
      !removed    = true

    endif

  endif

  -- If anything removed
  if(!removed) then

    -- Remove last definition
    !this.lastDefCount.remove(!last)
    !this.lastDefType.remove(!last)

    -- Update form
    !this.updateForm()

    -- Previous
    !previous = !last - 1

    -- Previous Definition now becomes the last definition
    if(!previous gt 0) then

      !prevDefType    = !this.lastDefType[!previous].upcase()


       -- Get the last aid item in the list
      !aidIndex       = !this.aidNumbers.size()

      -- If there is an aid item, then we'll remove it, unless its was a trace
      if(!aidIndex gt 0 and !lastDefType ne 'TRACE') then

        -- Remove aid from system and index list of the form
        !!aidNumbers.remove(!this.aidNumbers[!aidIndex])
        !this.aidNumbers.remove(!aidIndex)

        -- If the previous definition type was a point, then also remove it
        if(!aidIndex gt 1 and !prevDefType eq 'POINT' and !lastDefType eq 'ARC') then
          !!aidNumbers.remove(!this.aidNumbers[!aidIndex - 1])
          !this.aidNumbers.remove(!aidIndex - 1)
        endif

      endif
      !this.remove.tag = 'Remove Previous ' & !this.lastDefType[!previous]

    -- No previous definition
    else
      !this.remove.tag = 'Nothing to remove'
    endif

  endif

endmethod
-- End of method definition for .removeLast()

------------------------------------------------------------------------
--
-- Method:      definePoints
--
-- Description: Setup EDG mode for defining by graphic picks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePoints()

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition('Define vertex')
  !packet.action         = '!!dbeExtrusion.position(!this.return[1].position)'
  !packet.key            = 'POS3D'
  !packet.description    = 'Extrusion Creation'
  !packet.type           = 'pos3D'
  !packet.priority       = 1
  !packet.remove         = false

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .definePoints()

------------------------------------------------------------------------
--
-- Method:      defineTrace
--
-- Description: Setup to define edge by tracing another Extrusion/extrusion
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineTrace()

  -- Get data
  $m "%PDMSUI%/DES/CLIB/RGETVERT"
  if($!!cdRtnStatus neq 0) then
    return
  endif

  -- Get position & radii of vertices
  var !xyz EVALUATE (POSI WRT WORLD ) FOR ALL FROM !!cdpaRtn
  var !rad EVALUATE (FRAD WRT WORLD ) FOR ALL FROM !!cdpaRtn

  -- Add data to vertices members
  do !i indices !!cdpaRtn
    !this.positions.append(!xyz[!i].position())
    !this.radii.append(!rad[!i])
  enddo

  -- Current Definition
  !this.lastDefCount.append(!!cdpaRtn.size())
  !this.lastDefType.append('Trace')
  !this.remove.tag = 'Remove Previous Trace'

  -- Build
  !this.build()

endmethod
-- End of method definition for .defineTrace()

------------------------------------------------------------------------
--
-- Method:      defineExplicit
--
-- Description: Setup EDG mode to define points explicitly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineExplicit()

  -- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- Get position of last loop element
  if(!this.loop.set() and !this.loop.mCount gt 0) then
    !position = !this.loop.members[!this.loop.mCount].position

  -- Get last vertex position
  elseif (!this.positions.size() eq 0) then
    !position = N0

  -- Use last positions position
  else
    !position = !this.positions[!this.positions.size()]
  endif

  -- Show standard basic position definition
  !!pos3D.edit('!!dbeExtrusion.position(!this.position())', !position, 'Define vertex', 'Vertex position', true, 'Extrusion Creation')

endmethod
-- End of method definition for .defineExplicit()

------------------------------------------------------------------------
--
-- Method:      defineOffset
--
-- Description: Setup EDG mode to define with relative offset from previous
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineOffset()

  -- Load associated form, if not loaded
  if(undefined(!!pos3DOffset)) then
    pml reload form !!pos3DOffset
  endif

  -- Get position of last loop element
  if(!this.loop.set() and !this.loop.mCount gt 0) then
    !position = !this.loop.members[!this.loop.mCount].position

  -- Get last vertex position
  elseif (!this.positions.size() eq 0) then
    !position = N0

  -- Use last positions position
  else
    !position = !this.positions[!this.positions.size()]
  endif

  -- Show standard basic position definition
  !!pos3DOffset.edit('!!dbeExtrusion.position(!this.position())', !position, !position, 'Define vertex', 'Vertex position', true, 'Extrusion Creation')

endmethod
-- End of method definition for .defineOffset()

------------------------------------------------------------------------
--
-- Method:      defineFillet
--
-- Description: Setup EDG mode to define point using fillet method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineFillet()

  -- Initialise Variables
  !packet                   = object EDGPACKET()
  !packet.defineCircle('fillet')
  !packet.description       = 'Extrusion Creation'
  !packet.action            = '!!dbeExtrusion.arc(!this.return[1])'
  !packet.type              = 'pos3D'
  !packet.priority          = 1
  !packet.remove            = false
  !packet.pickPacket.prompt = 'Extrusion arc (fillet)'

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .defineFillet()

------------------------------------------------------------------------
--
-- Method:      define3Points
--
-- Description: Setup EDG mode to define arc passing through three points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .define3Points()

  -- Initialise Variables
  !packet                   = object EDGPACKET()
  !packet.defineCircle('3pnt')
  !packet.description       = 'Extrusion Creation'
  !packet.action            = '!!dbeExtrusion.arc(!this.return[1])'
  !packet.type              = 'pos3D'
  !packet.priority          = 1
  !packet.remove            = false
  !packet.pickPacket.prompt = 'Extrusion arc (three points)'

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .define3Points()

------------------------------------------------------------------------
--
-- Method:      defineFRadTan
--
-- Description: Setup EDG mode to define arc of fixed radius passing through 2 points
--
-- Method Type: Function/Procedure
