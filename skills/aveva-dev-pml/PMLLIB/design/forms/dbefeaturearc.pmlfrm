-- File:            dbefeaturearc.pmlfrm
--   Type:          Form Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 17 16:57:08 "GMT 2000
--
--
-- Description:
-- Standard feature arc.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Add circle to list
--  dbeFeatureArc()                  -                   Constructor
--  setup()                          -                   Default setup for feature circle
--  setup(STRING,PLANE,POSITION,BOOLEAN) -                   Setup for form
--

setup form !!dbeFeatureArc

  !this.formTitle     = 'Arc'
  !this.iconTitle     = 'Arc'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition
  text .radius 'Radius' width 14 is REAL format !!distanceFmt
  path down
  halign right
  text .angle   'Angle' width 14 is REAL format !!angleFmt

  -- Type of segment
  rgroup .segmentType 'Type' frame horizontal
    add tag 'Chord'   select 'CHORD'
    add tag 'Segment' select 'CHEESE'
  exit

  -- Buttons
  button .apply   'Apply'    at xmin form-0    ymax+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss'  at xmax form-size ymin      ok

  -- Form members

  -- Action on apply
  member .action       is STRING

  -- Reference plane
  member .plane        is PLANE

  -- Centre position of arc
  member .position     is POSITION

  -- Apply/Dismiss form (true) OK/Cancel (false)
  member .applyDismiss is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeFeatureArc
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFeatureArc()

  -- Initialise Variables
  !this.radius.val = 0
  !this.angle.val  = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Default setup for feature circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.setup('!!dbeFeatureEdit.add(!feature)', object PLANE(), N0, true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on apply
--    2   R      PLANE       Return plane for profile
--    3   R      POSITION    Centre of arc
--    4   R      BOOLEAN     Apply/Dismiss form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !plane is PLANE, !position is POSITION, !applyDismiss is BOOLEAN)

  -- Initialise Variables
  !this.action        = !action
  !this.applyDismiss  = !applyDismiss

  if(!applyDismiss) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

  -- Unset plane
  if(!plane.unset()) then
    !this.plane  = object PLANE(N0, Y is N)
  else
    !this.plane  = !plane
  endif

  -- Centre
  !this.position = !this.plane.near(!position)

  -- Show form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Add circle to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables

  -- Handle zero radius
  if(!this.radius.val.unset() or !this.radius.val le 0) then
    !!alert.warning('Radius must be supplied.')
    return
  endif

  -- Handle zero angle
  if(!this.angle.val.unset() or !this.angle.val le 0) then
    !!alert.warning('Angle must be supplied.')
    return
  endif

  -- Handle big angle
  if(!this.angle.val gt 360) then
    !!alert.warning('Angle must be 360 or less.')
    return
  endif

  -- Define full circle
  if(!this.angle.val eq 360) then
    !edges[1]          = object ARC(!this.position, !this.plane.orientation, 0, 360, !this.radius.val, true)
  else
    !edges[1]            = object ARC(!this.position, !this.plane.orientation, 90 - !this.angle.val / 2, 90 + !this.angle.val / 2, !this.radius.val, true)

    -- Chord type
    if(!this.segmentType.selection() eq 'CHORD') then
      !edges.append(object LINE(!edges[1].anglePosition(!edges[1].endAngle), !edges[1].anglePosition(!edges[1].startAngle)))
    else
      !edges.append(object LINE(!edges[1].anglePosition(!edges[1].endAngle), !this.position))
      !edges.append(object LINE(!this.position, !edges[1].anglePosition(!edges[1].startAngle))  )
    endif
  endif

  -- Define feature
  !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !edges)
  !profile.close()

  !feature = object DBELOOPFEATURE(!profile)
  !feature.description = 'Circle segment - radius ' & !this.radius.val.string(!!distanceFmt) & ' angle ' & !this.angle.val.string(!!angleFmt)

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  if(!this.applyDismiss.not()) then
    !this.hide()
  endif

endmethod
-- End of method
