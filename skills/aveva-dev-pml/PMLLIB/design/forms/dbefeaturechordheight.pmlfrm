--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 17 16:57:08 "GMT 2000
--
--
-- Description:
-- Standard feature circle.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Add circle to list
--  dbeFeatureChordHeight()          -                   Constructor
--  setup()                          -                   Default setup for feature circle
--  setup(STRING,PLANE,POSITION,BOOLEAN) -                   Setup for form
--

setup form !!dbeFeatureChordHeight

  !this.formTitle     = 'Circle'
  !this.iconTitle     = 'Circle'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition
  text .radius 'Radius' width 14 is REAL format !!distanceFmt
  path down
  halign right
  text .height 'Height' width 14 is REAL format !!distanceFmt

  -- Buttons
  button .apply   'Apply'    at xmin form-0    ymax callback '!this.apply()'
  button .dismiss 'Dismiss'  at xmax form-size ymin ok

  -- Form members

  -- Action on apply
  member .action       is STRING

  -- Reference plane
  member .plane        is PLANE

  -- Centre position of arc
  member .position     is POSITION

  -- Apply/Dismiss form (true) OK/Cancel (false)
  member .applyDismiss is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeFeatureChordHeight
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFeatureChordHeight()

  -- Initialise Variables
  !this.radius.val = 0
  !this.height.val = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Default setup for feature circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.setup('!!dbeFeatureEdit.add(!feature)', object PLANE(), N0, true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on apply
--    2   R      PLANE       Return plane for profile
--    3   R      POSITION    Centre of arc
--    4   R      BOOLEAN     Apply/Dismiss form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !plane is PLANE, !position is POSITION, !applyDismiss is BOOLEAN)

  -- Initialise Variables
  !this.action        = !action
  !this.applyDismiss  = !applyDismiss

  if(!applyDismiss) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

  -- Unset plane
  if(!plane.unset()) then
    !this.plane  = object PLANE(N0, Y is N)
  else
    !this.plane  = !plane
  endif

  -- Centre
  !this.position = !this.plane.near(!position)

  -- Show form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Add circle to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables

  -- Handle zero radius
  if(!this.radius.val.unset() or !this.radius.val le 0) then
    !!alert.warning('Radius must be supplied.')
    return
  endif

  -- Handle zero height
  if(!this.height.val.unset() or !this.height.val le 0) then
    !!alert.warning('Chord height must be supplied.')
    return
  endif

  -- Handle heights greater than the radius
  if(!this.height.val gt !this.radius.val) then
    !!alert.warning('Chord height must be less than the radius.')
    return
  endif

  -- Define arc
  !edges[1]            = object ARC(!this.position, !this.plane.orientation, 0, 180, !this.radius.val, true)

  !edges[1]            = !edges[1].chordHeight(!this.height.val)

  -- Modify start/end angle
  !angle               = !edges[1].angle() / 2
  !edges[1].startAngle = 90 - !angle
  !edges[1].endAngle   = 90 + !angle

  -- Offset arc
  !edges[1].position   = !edges[1].position.offset(!this.plane.orientation.yDir().opposite(), !this.radius.val - !this.height.val)
  !edges[2]            = object LINE(!edges[1].anglePosition(!edges[1].endAngle), !edges[1].anglePosition(!edges[1].startAngle))
  -- Define feature
  !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !edges)
  !profile.close()

  !feature = object DBELOOPFEATURE(!profile)
  !feature.description = 'Chord height - radius ' & !this.radius.val.string(!!distanceFmt) & ' height ' & !this.height.val.string(!!distanceFmt)

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  if(!this.applyDismiss.not()) then
    !this.hide()
  endif

endmethod
-- End of method
