--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 10 8:50:50 "GMT 2000
--
--
-- Description:
-- Editor for loop features.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(ARRAY,STRING)                -                   Add passed array of profile to list
--  add(DBELOOPFEATURE)              -                   Add passed feature to list
--  add(PROFILE,STRING)              -                   Add passed profile to list
--  apply()                          -                   Apply form
--  close()                          -                   Close for down
--  dbeFeatureEdit()                 -                   Constructor
--  derive()                         -                   Pick a feature
--  derive(DBREF)                    -                   Define feature from passed element
--  draw()                           -                   Draw feature
--  drawFence()                      -                   Draw defined fence
--  drawReference()                  -                   Draw defined reference profile
--  fence()                          -                   Define feature from fence and reference profile
--  fence(PROFILE)                   -                   Set reference profile and define fence
--  fence(PROFILE,BOOLEAN)           -                   Set reference profile and define fence
--  fence(PROFILE,BOOLEAN,BOOLEAN)   -                   Set reference profile and define fence
--  fenceDefine(POSITION)            -                   Cache picked points of defining fence
--  fenceDefine(STRING,STRING)       -                   Define packet for defining a "fence"
--  isFeatureFile(FILE)              BOOLEAN             Check if passed file is a feature file
--  load()                           -                   Load feature file
--  mirror(STRING)                   -                   Mirror about axes
--  pickArc()                        -                   Define a standard shape
--  remove()                         -                   Remove select from list
--  removeAll()                      -                   Remove all features from list
--  replace(DBELOOPFEATURE)          -                   replaces the passed feature, if found, in the system
--  rotate(REAL)                     -                   Rotate about origin by passed value
--  save()                           -                   Save current features to file
--  select()                         -                   Select current feature
--  select(DBREF)                    -                   Add passed element into the systemDefine selection of a feature
--  select(DBREF,BOOLEAN)            -                   Add passed element into the system
--  select(REAL)                     -                   Select feature
--  select(STRING)                   -                   Define selection of a feature
--  select(STRING,BOOLEAN)           -                   Define selection of a feature
--  setup(DBELOOPFEATURE,STRING)     -                   Setup form with passed action
--  standardShape(STRING)            -                   Show standard shape form
--  tidy()                           -                   Tidy up graphics
--  updateList()                     -                   Update the list of features
--  useArc(ARC)                      -                   Use passed arc as a feature
--
------------------------------------------------------------------------

setup form !!dbeFeatureEdit
Import 'pmlfilebrowser'
handle any
endhandle

  !this.formTitle     = 'Feature Definition'
  !this.iconTitle     = 'Feature Edit'
  !this.callback      = ''
  !this.cancelCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  -- Bar Menu
  bar
  exit

  -- List of currently defined features
  list .list callback '!this.select()' width 40 length 4

  -- View of feature
  view .view at xmin ymax volume
    width 43 aspect 1
  exit

  -- Manipulation
  frame .modifyFrame 'Modify' at xmin ymax
    frame .mirrorFrame 'Mirror'
      button .mirrorX 'about X' callback '!this.mirror(|X|)'
      path right
      button .mirrorY 'about Y' callback '!this.mirror(|Y|)'
    exit
    valign centre
    text .rotate 'Rotate' callback '!this.rotate(!this.rotate.val)' width 6 is REAL format !!angleFmt
  exit

  -- Form Variables

  -- Reference plane (panel being modified)
  member .plane                    is PLANE

  -- Reference profile
  member .referenceProfile         is PROFILE
  member .referenceItem            is DBREF

  -- Fence operation
  member .fencePoints              is ARRAY

  -- Fence
  member .fence                    is PROFILE

  -- Fence side
  member .fencePositive            is BOOLEAN

  -- List of features
  member .features                 is ARRAY

  -- Aid Numbers
  member .aidProfile               is REAL
  member .aidProfileLineStyle      is REAL
  member .aidProfileColour         is REAL

  member .aidOrigin                is REAL
  member .aidOriginLineStyle       is REAL
  member .aidOriginColour          is REAL

  member .aidFence                 is REAL
  member .aidFenceLineStyle        is REAL
  member .aidFenceColour           is REAL

  member .aidReference             is REAL
  member .aidReferenceLineStyle    is REAL
  member .aidReferenceColour       is REAL

  -- Event Description
  member .edgDescription           is STRING

  -- Action on completion
  member .action                   is STRING
  member .autoApply                is BOOLEAN

exit
-- End of form definition for !!dbeFeatureEdit

------------------------------------------------------------------------
--
-- Method:      dbeFeatureEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFeatureEdit()

  -- Initialise Variables

  -- EDG Description
  !this.edgDescription = 'Feature Editor'

  -- Auto Apply
  !this.autoApply      = false

  -- Aid Numbers

  -- Bar Menu Definition
  !bar = !this.bar
  !bar.add('Control',  'menuControl')
  !bar.add('Create',   'menuAdd')
  !bar.add('Delete',   'menuRemove')

  -- Control Menu
  !menu = !this.newMenu('menuControl')
    !menu.add('CALLBACK', 'Save As...', '!this.save()')
    !menu.add('CALLBACK', 'Load From...', |call !!fileBrowser('%PDMSUSER%', '*.pmlmac', 'Load Features', true,  '!!dbeFeatureEdit.load()')|)
    !menu.add('separator')
    !menu.add('callback', 'Use',                '!this.apply()')
    !menu.add('callback', 'Close',              '!this.close()')

  -- Select Feature Menu
  !menu = !this.newMenu('menuAdd')
    !menu.add('callback', 'from CE',                     '!this.select(|ce|)')
    !menu.add('callback', 'from picked',                 '!this.select(|picked|)')
    !menu.add('callback', 'from positive portion of CE', '!this.select(|portion ce positive|)')
    !menu.add('callback', 'from negative portion of CE', '!this.select(|portion ce negative|)')
    !menu.add('separator')
    !menu.add('menu', 'Circle',                 'menuStandardCircle')
    !menu.add('callback', 'Rectangle...',       '!this.standardShape(|rectangle|)')
    !menu.add('callback', 'Polygon...',         '!this.standardShape(|polygon|)')

    -- Modify Feature Menu
    !menu = !this.newMenu('menuStandardCircle')
      !menu.add('callback', 'Full...',          '!this.standardShape(|circle|)')
      !menu.add('callback', 'Chord height...',  '!this.standardShape(|chord height|)')
      !menu.add('callback', 'Segment...',       '!this.standardShape(|arc|)')
      !menu.add('callback', 'Pick',             '!this.pickArc()')

  -- Select Feature Menu
  !menu = !this.newMenu('menuRemove')
    !menu.add('callback', 'Selected',           '!this.remove()')
    !menu.add('callback', 'All',                '!this.removeAll()')

  -- Aid lines
  !this.aidProfile            = !!aidNumbers.add(!this.edgDescription & ' - Profile')
  !this.aidProfileLineStyle   = 1
  !this.aidProfileColour      = 4

  !this.aidOrigin             = !!aidNumbers.add(!this.edgDescription & ' - Origin')
  !this.aidOriginLineStyle    = 4
  !this.aidOriginColour       = 5

  !this.aidFence              = !!aidNumbers.add(!this.edgDescription & ' - Fence')
  !this.aidFenceLineStyle     = !!dbeProfileEdit.aidFenceLineStyle
  !this.aidFenceColour        = !!dbeProfileEdit.aidFenceColour

  !this.aidReference          = !!aidNumbers.add(!this.edgDescription & ' - Reference')
  !this.aidReferenceLineStyle = !!dbeProfileEdit.aidReferenceLineStyle
  !this.aidReferenceColour    = !!dbeProfileEdit.aidReferenceColour

  -- Set background to default
  !this.view.background       = !!gphViewOpt.background.name

  -- Set default a zoom
  !this.view.mouseMode        = 'Zoom'

  -- Set angle
  !this.rotate.val            = 0

endmethod
-- End of method definition for .dbeFeatureEdit()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close for down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables

  -- Remove event from the system
  !!edgCntrl.remove(!this.edgDescription)

  -- Tidy up graphics
  !this.tidy()

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Hide graphic lines
  !!aidNumbers.hide(!this.aidProfile)
  !!aidNumbers.hide(!this.aidOrigin)
  !!aidNumbers.hide(!this.aidFence)
  !!aidNumbers.hide(!this.aidReference)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      drawFence
--
-- Description: Draw defined fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawFence()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidFence)

  if(!this.fence.unset()) then
    return
  endif

  -- Draw fence
  !this.fence.draw(!this.aidFence, !this.aidFenceLineStyle, !this.aidFenceColour)

endmethod
-- End of method definition for .drawFence()

------------------------------------------------------------------------
--
-- Method:      drawReference
--
-- Description: Draw defined reference profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawReference()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidReference)

  if(!this.referenceProfile.unset()) then
    return
  endif

  -- Draw fence
  !this.referenceProfile.draw(!this.aidReference, !this.aidReferenceLineStyle, !this.aidReferenceColour)

endmethod
-- End of method definition for .drawReference()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOPFEATURE Feature item to set form up with
--    2   R      STRING         Action carried out on apply/use
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!feature is DBELOOPFEATURE, !action is STRING)

  -- Initialise Variables
  !this.action = !action

  -- Setup line styles and colours
  !this.aidFenceLineStyle     = !!dbeProfileEdit.aidFenceLineStyle
  !this.aidFenceColour        = !!dbeProfileEdit.aidFenceColour
  !this.aidReferenceLineStyle = !!dbeProfileEdit.aidReferenceLineStyle
  !this.aidReferenceColour    = !!dbeProfileEdit.aidReferenceColour

  -- Show form
  !this.show()

  -- Setup to passed feature
  !this.replace(!feature)

endmethod
-- End of method definition for .setup(DBELOOPFEATURE, STRING)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !index   = !this.list.selection().real()

  -- Handle unset feature
  if(!index.unset()) then
    !feature = object DBELOOPFEATURE()
  else
    !feature = object DBELOOPFEATURE(!this.features[!index])
  endif

  -- Action commend
  if(!this.action.set() and !this.action.trim().empty().not()) then
    $!<this.action>
    handle any
    endhandle
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save current features to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()
  Using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')

  -- Initialise Variables
  !records     = ARRAY()
  !browser.show('%PDMSUSER%', '*.pmlmac', 'Save Features', false, 'PML Macro Files (*.pmlmac)|*.pmlmac',1)
  !file = !!file(!browser.file())

  if(!file.set()) then
    -- Check there are feature to build the definition from
    if(!this.features.empty().not()) then

      -- Check of file already exists and is a feature file
      if(!file.exists()) then
        if(!this.isFeatureFile(!file).not()) then
          !!alert.warning(!!error.text)
          return
        endif
      endif

      -- Information
      !date    = object DATETIME()
      !session = CURRENT SESSION

      -- Define header
      !records.append('-- Feature definition file')
      !records.append('--   Created by   : ' & !session.name)
      !records.append('--   Created date : ' & !date)

      -- Build definition
      do !i indices !this.features
        !records.append('')
        !records.append('-- Feature definition : ' & !this.features[!i].description)

        -- Define the profile
        !definition = !this.features[!i].profile.edges()
        !records.append('!edges = ARRAY()')

        do !j indices !definition
          if(!definition[!j].objectType() eq 'LINE') then
            !line = !definition[!j]
            !records.append('!edges.append(object LINE(' & !line.startPosition & ' , ' & !line.endPosition & ' ))')
          elseif (!definition[!j].objectType() eq 'ARC') then
            !arc  = !definition[!j]
            !records.append('!edges.append(object ARC(' & !arc.position & ' , ' & !arc.orientation & ' , ' & !arc.startAngle & ' , ' & !arc.endAngle & ' , ' & !arc.radius & ' , ' & !arc.sense & '))')
          endif

        enddo

        -- Define profile
        !records.append('!profile  = object PROFILE(' & !this.features[!i].profile.position & ' , '  & !this.features[!i].profile.orientation & ' , !edges)')

        -- Define the feature
        !records.append('!feature = object DBELOOPFEATURE(!profile)')

        -- Add description
        if(!this.features[!i].description.set()) then
          !records.append('!feature.description = |' & !this.features[!i].description & '|')
        endif

        -- Define the addition of the feature into the system
        !records.append('!!dbeFeatureEdit.add(!feature)')

      enddo

      -- If file already exists, then do we want to overwrite the file?
      if(!file.exists()) then

        -- Write to file, if OK to overwrite
        if(!!alert.confirm('OK to overwrites existing file?').boolean()) then
          !file.writeFile('overwrite', !records)
        endif

      else
        !file.writeFile('write', !records)
      endif

    -- No features to save
    else
      !!alert.warning('No features to save to file.')
    endif
  endif

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load feature file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

  -- Initialise Variables
  !file     = !!fileBrowser.file

  -- Check file is feature file
  if(!this.isFeatureFile(!file).not()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- Load file
  if(!file.exists()) then
    !filename = !file.fullname()
    $m "$!filename"
  endif

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      isFeatureFile
--
-- Description: Check if passed file is a feature file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isFeatureFile(!file is FILE) is BOOLEAN

  -- Initialise Variables

  -- Check for passed file
  if(!file.exists().not()) then
    !!error.text = 'File "' & !file & '" does not exist.'
    return false
  endif

  -- Check file is a feature file
  !records  = !file.readFile()
  handle ANY
  endhandle

  -- Check head record
  if(!records[1] ne '-- Feature definition file') then
    !!error.text = 'File "' & !file.fullname() & '" is not a feature definition file.'
    return false
  endif

  -- Return
  return true

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      updateList
--
-- Description: Update the list of features
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateList()

  -- Handle empty list
  !active = !this.features.empty().not()
  !this.bar.setActive('Delete', !active)

  !this.rotate.active  = !active
  !this.mirrorX.active = !active
  !this.mirrorY.active = !active

  -- If there are no feature, remove the aids
  if(!active.not()) then
    !this.tidy()
    !this.list.clear()
    return
  endif

  -- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  do !i indices !this.features
    !dtext[!i] = !this.features[!i].description
    !rtext[!i] = !i.string()
  enddo

  !this.list.dtext = !dtext
  !this.list.rtext = !rtext

endmethod
-- End of method definition for .updateList()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select current feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Check there are entries in the system
  if(!this.features.empty()) then
    return
  endif

  -- Select entry
  !this.select(!this.list.selection().real())

endmethod
-- End of method definition for .select()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!index is REAL)

  -- Check we have a valid number
  if(!index le 0) then
    return
  endif

  -- Select entry
  !this.list.val    = !index

  -- Draw Profile
  !this.draw()

  -- Auto apply (this only happens once, then has to be reset)
  if(!this.autoApply) then
    !this.apply()
    !this.autoApply = false
  endif

endmethod
-- End of method definition for .select(REAL)

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Initialise Variables
  !index = !this.list.selection().real()
  !!aidNumbers.hide(!this.aidProfile)
  !!aidNumbers.hide(!this.aidOrigin)

  if(!this.shown().not()) then
    return
  endif

  -- Get profile
  !profile             = object PROFILE(!this.features[!index].profile)
  !profile.position    = N250000 E200000 D200000
  !profile.orientation = Y IS N
  !plane               = !profile.plane()

  -- Draw Profile
  !profile.draw(!this.aidProfile,1,5)

  -- Set view limits
  !from   = !plane.threeDPosition(!this.features[!index].limits[1])
  !to     = !plane.threeDPosition(!this.features[!index].limits[2])

  -- Draw Line
  !x         = 250mm
  !xline     = object LINE(!plane.position, !plane.threeDPosition(object XYPOSITION(!x, 0)))
  !xline.draw(!this.aidOrigin, !this.aidOriginLineStyle , !this.aidOriginColour)
  !y         = 250mm
  !yline     = object LINE(!plane.position, !plane.threeDPosition(object XYPOSITION(0, !y)))
  !yline.draw(!this.aidOrigin, !this.aidOriginLineStyle , !this.aidOriginColour)
  AID TEXT NUMBER $!<this.aidOrigin> 'X'      AT $!<xline.endPosition>
  AID TEXT NUMBER $!<this.aidOrigin> 'Y'      AT $!<yline.endPosition>
  AID TEXT NUMBER $!<this.aidOrigin> 'Origin' AT $!<plane.position>

  -- Set view direction
  !!gphViews.look(!this.view, N)
  !!gphViews.look(!this.view, D)
  !volume = object VOLUME(!from, !to)
  !!gphViews.limits(!this.view, !volume)

endmethod
-- End of method definition for .draw()

------------------------------------------------------------------------
--
-- Method:      derive
--
-- Description: Pick a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derive()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'pickProfile'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.pickPacket.stdElement('Pick element to derive feature from')
  !packet.action          = '!!dbeFeatureEdit.derive(!this.return[1].item)'
  !packet.remove          = true

  -- Add event to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .derive()

------------------------------------------------------------------------
--
-- Method:      derive
--
-- Description: Define feature from passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derive(!element is DBREF)

  -- Initialise Variables
  !feature    = object DBELOOPFEATURE()

  -- Get profiles found for element
  !features   = !feature.features(!element)

  -- Handle no profiles returned
  if(!features.empty()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- If there is more than one profile, then select the relevant one
  if(!features.size() gt 1) then
    !!dbeFeatureSelect.setup(!features, '!!dbeFeatureEdit.add(!feature)')

  -- Use first profile
  else
    !this.add(!features[1])

  endif

endmethod
-- End of method definition for .derive(DBREF)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add passed profile to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile
--    2   R      STRING      Description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!profile is PROFILE, !description is STRING)

  -- Initialise Variables
  !this.features.append(object DBELOOPFEATURE(!profile, !description))

  -- Update feature list
  !this.updateList()

  -- Select
  !this.select(!this.features.size())

endmethod
-- End of method definition for .add(PROFILE, STRING)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add passed array of profile to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Profile array
--    2   R      STRING      Description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!profiles is ARRAY, !description is STRING)

  -- Initialise Variables
  do !i indices !profiles
    !this.features.append(object DBELOOPFEATURE(!profiles[!i], !description))
  enddo

  -- Update feature list
  !this.updateList()

  -- Select
  !this.select(!this.features.size())

endmethod
-- End of method definition for .add(ARRAY, STRING)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add passed feature to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOPFEATURE  Feature
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!feature is DBELOOPFEATURE)

  -- Initialise Variables

  -- Add to list
  if(!feature.profile.set()) then
    !this.features.append(object DBELOOPFEATURE(!feature))
  endif

  -- Update feature list
  !this.updateList()

  -- Select
  !this.select(!this.features.size())

endmethod
-- End of method definition for .add(DBELOOPFEATURE)

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: replaces the passed feature, if found, in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOPFEATURE  Feature
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace(!feature is DBELOOPFEATURE)

  -- Initialise Variables

  -- Check that feature is not already within the system
  do !i indices !this.features
    if(!this.features[!i].description eq !feature.description) then
      !index = !i
      break
    endif
  enddo

  -- Add feature in not already in the system
  if(undefined(!index)) then
    !this.add(!feature)

  -- Replace feature
  else

    -- Add to list
    !this.features[!index] = object DBELOOPFEATURE(!feature)

    -- Select
    !this.select(!index)

  endif

endmethod
-- End of method definition for .replace(DBELOOPFEATURE)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove select from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove()

  -- Initialise Variables
  !index   = !this.list.selection().real()
  !maximum = !this.features.size()

  -- Remove feature from list
  !this.features.remove(!index)

  -- Update feature list
  !this.updateList()

  -- Get next index
  if(!index ge !maximum) then
    !index = !maximum - 1
  endif

  -- Select
  !this.select(!index)

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      removeAll
--
-- Description: Remove all features from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeAll()

  -- Remove feature from list
  !this.features.clear()

  -- Update feature list
  !this.updateList()

endmethod
-- End of method definition for .removeAll()

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror about axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Axes to mirror about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror(!axes is STRING)

  -- Initialise Variables
  !index = !this.list.selection().real()

  -- Mirror Line
  !this.features[!index].mirror(!axes)

  -- Draw
  !this.draw()

endmethod
-- End of method definition for .mirror(STRING)

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate about origin by passed value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL)

  -- Initialise Variables
  !index = !this.list.selection().real()

  -- Check for valid angle
  if(!angle.unset()) then
    !!alert.warning('Angle must be supplied.')
    return
  endif

  -- Zero angle
  if(!angle eq 0) then
    return
  endif

  -- Mirror Line
  !this.features[!index].rotate(!angle)

  -- Draw
  !this.draw()

endmethod
-- End of method definition for .rotate(REAL)

------------------------------------------------------------------------
--
-- Method:      pickArc
--
-- Description: Define a standard shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickArc()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.circleDerive()
  !packet.pickPacket.prompt = 'Pick arc'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'pickArc'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!dbeFeatureEdit.useArc(!this.return[1])'
  !packet.remove            = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickArc()

------------------------------------------------------------------------
--
-- Method:      useArc
--
-- Description: Use passed arc as a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Picked arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useArc(!arc is ARC)

  -- Initialise Variables
  !array[1] = !arc

  -- Append closing line
  !angle   = !arc.angle()
  if(!angle lt 360) then
    !array[1].startAngle = 90 - !angle / 2
    !array[1].endAngle   = 90 + !angle / 2
    !array[2]            = object LINE(!array[1].anglePosition(!array[1].endAngle), !array[1].anglePosition(!array[1].startAngle))
  endif

  !profile = object PROFILE(!arc.position, !arc.orientation, !array)
  !feature = object DBELOOPFEATURE(!profile)
  !feature.description = 'Picked - radius ' & !arc.radius.string(!!distanceFmt) & ' angle ' & !angle.string(!!angleFmt)

  -- Add circle to list
  !this.add(!feature)

endmethod
-- End of method definition for .useArc(ARC)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Define selection of a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!option is STRING)
  !this.select(!option, false)
endmethod
-- End of method definition for .select(STRING)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Define selection of a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
--    2   R      BOOLEAN     Apply on selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!option is STRING, !apply is BOOLEAN)

  -- Initialise Variables
  !method         = !option.lowcase()
  !this.autoApply = !apply

  -- Select current element
  if(!method eq 'ce') then
    !this.select(!!ce, !apply)

  -- Select picked element
  elseif (!method eq 'picked') then

    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.key             = 'pickFeature'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.pickPacket.stdElement('Pick element to define feature from')
    !packet.action          = '!!dbeFeatureEdit.select(!this.return[1].item, $!apply)'
    !packet.remove          = true

    -- Add event to EDG system
    !!edgCntrl.add(!packet)

  -- Select portion of Current DB element
  elseif (!method.match('portion') gt 0) then

    -- Current element
    if(!option.match('ce') gt 0) then
      !feature            = object DBELOOPFEATURE()
      !features           = !feature.features(!!ce)
      !this.referenceItem = !!ce
    endif

    -- Positive portion
    if(!method.match('positive') gt 0) then
      !this.fencePositive = true
    else
      !this.fencePositive = false
    endif

    -- No feature for item
    if(!features.empty()) then
      !!alert.warning(!!error.text)
      return
    endif

    -- If there are more than one feature, then choose
    if(!features.size() gt 1) then
      !!dbeFeatureSelect.setup(!features, '!!dbeFeatureEdit.fence(!profile, ' & !apply & ')')
      return
    endif

    -- Define feature fence
    !this.fence(!features[1].profile, !this.fencePositive, !apply)

  endif

endmethod
-- End of method definition for .select(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Add passed element into the systemDefine selection of a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!element is DBREF)
  !this.select(!element, false)
endmethod
-- End of method definition for .select(DBREF)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Add passed element into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element
--    2   R      BOOLEAN     Apply on selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!element is DBREF, !apply is BOOLEAN)

  -- Initialise Variables
  !feature        = object DBELOOPFEATURE()
  !this.autoApply = !apply

  -- Get profiles found for element
  !features       = !feature.features(!element)

  -- Handle no profiles returned
  if(!features.empty()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- If there is more than one feature, then select the relevant one
  if(!features.size() gt 1) then
    !!dbeFeatureSelect.setup(!features, '!!dbeFeatureEdit.add(!feature)')

  -- Use first profile
  else
    !feature = object DBELOOPFEATURE(!features[1])
    !this.add(!feature)
  endif

endmethod
-- End of method definition for .select(DBREF, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Set reference profile and define fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to define fence about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence(!profile is PROFILE)

  -- Initialise Variables
  !this.fence(!profile, true, false)

endmethod
-- End of method definition for .fence(PROFILE)

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Set reference profile and define fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to define fence about
--    2   R      BOOLEAN     Apply on selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence(!profile is PROFILE, !apply is BOOLEAN)

  -- Initialise Variables
  !this.fence(!profile, true, !apply)

endmethod
-- End of method definition for .fence(PROFILE, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Set reference profile and define fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to define fence about
--    2   R      BOOLEAN     True if positive is to be used
--                           False if negative is to be used
--    3   R      BOOLEAN     Apply on selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence(!profile is PROFILE, !positive is BOOLEAN, !apply is BOOLEAN)

  -- Initialise Variables
  !this.referenceProfile = object PROFILE(!profile)
  !this.fencePositive    = !positive
  !this.autoApply        = !apply
  !this.drawReference()

  -- Define fence
  !this.fenceDefine('Define portion of profile', '!!dbeFeatureEdit.fence()')

endmethod
-- End of method definition for .fence(PROFILE, BOOLEAN, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Define feature from fence and reference profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidFence)
  !!aidNumbers.hide(!this.aidReference)

  -- Intersection of reference and fence profiles
  if(!this.fencePositive) then
    !text     = 'Positive'
    !profiles = !this.referenceProfile.intersect(!this.fence)
  else
    !text     = 'Negative'
    !profiles = !this.fence.difference(!this.referenceProfile)
  endif

  -- If there are no profile
  if(!profiles.empty()) then
    !!alert.warning('There is no intersection between the reference profile and the defined fence.')
    return
  endif

  -- If there is more than one profile, then inform the user
  if(!profiles.size() gt 1) then
    !!alert.message('More than one profile has been derived, including all into the system.')
  endif

  -- Description
  if(!this.referenceItem.unset()) then
    !description = !text & ' portion of profile'
  else
    !description = !text & ' portion of profile ' & !this.referenceItem.flnn
  endif

  -- All all profiles to the system
  do !i indices !profiles
    !this.add(!profiles[!i], !description)
  enddo

endmethod
-- End of method definition for .fence()

-----------------------------------------------------------------------
--
-- Method:      fenceDefine
--
-- Description: Define packet for defining a "fence"
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Description
--    2   R      STRING      Action on completion
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fenceDefine(!description is STRING, !action is STRING)

  -- Initialise Variables
  !this.fencePoints.clear()
  --!this.fence             = object PROFILE()
  !this.drawFence()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Define fence')
  !packet.key             = !description
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeFeatureEdit.fenceDefine(!this.return[1].position)'
  !packet.remove          = false
  !packet.escape          = !action

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .fenceDefine(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      fenceDefine
--
-- Description: Cache picked points of defining fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Screen pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fenceDefine(!passedPosition is POSITION)

  -- Map position onto plane
  !plane    = !this.referenceProfile.plane()
  !position = !plane.near(!passedPosition)

  -- Add position to fence point list
  !this.fencePoints.append(!position)

  -- If we have more than one point, then we can draw the fence
  if(!this.fencePoints.size() gt 1) then
    !this.fence = object PROFILE(!plane.position, !plane.orientation, !this.fencePoints)
    !this.fence.close()
    !this.drawFence()
  else
    AID TEXT NUMBER $!<this.aidFence> 'Start' AT $!<position>
  endif

endmethod
-- End of method definition for .fenceDefine(POSITION)

------------------------------------------------------------------------
--
-- Method:      standardShape
--
-- Description: Show standard shape form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Shape
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .standardShape(!shape is STRING)

  -- Initialise Variables
  !option = !shape.lowcase()

  -- Rectangles
  if(!option eq 'rectangle') then
    if(undefined(!!dbeFeatureRectangle)) then
      pml reload form !!dbeFeatureRectangle
    endif
    !!dbeFeatureRectangle.setup()

  -- Polygon
  elseif (!option eq 'polygon') then
    if(undefined(!!dbeFeaturePolygon)) then
      pml reload form !!dbeFeaturePolygon
    endif
    !!dbeFeaturePolygon.setup()

  -- Circle
  elseif (!option eq 'circle') then
    if(undefined(!!dbeFeatureCircle)) then
      pml reload form !!dbeFeatureCircle
    endif
    !!dbeFeatureCircle.setup()

  -- Chord Height
  elseif (!option eq 'chord height') then
    if(undefined(!!dbeFeatureChordHeight)) then
      pml reload form !!dbeFeatureChordHeight
    endif
    !!dbeFeatureChordHeight.setup()

  -- Arc
  elseif (!option eq 'arc') then
    if(undefined(!!dbeFeatureArc)) then
      pml reload form !!dbeFeatureArc
    endif
    !!dbeFeatureArc.setup()

  endif

endmethod
-- End of method definition for .standardShape(STRING)
