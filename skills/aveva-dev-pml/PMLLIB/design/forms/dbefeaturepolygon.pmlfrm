--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 17 16:57:08 "GMT 2000
--
--
-- Description:
-- Standard feature polygon of equal side lengths.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Add rectangle to list
--  dbeFeaturePolygon()              -                   Constructor
--  dimensionType(REAL)              -                   Set number of sides and permissible dimension type
--  setup()                          -                   Default setup for feature circle
--  setup(STRING,PLANE,POSITION,BOOLEAN) -                   Setup for form
--

setup form !!dbeFeaturePolygon

  !this.formTitle     = 'Polygon'
  !this.iconTitle     = 'Polygon'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition
  text .sides    'No of Sides' callback '!this.dimensionType(!this.sides.val)' width 2 is REAL format !!integerFmt
  path down
  option .dimensionType width 23

  text .distance '' at xmax ymin   width 14 is REAL format !!distanceFmt

  -- Buttons
  button .apply   'Apply'    at xmin form-0    ymax callback '!this.apply()'
  button .dismiss 'Dismiss'  at xmax form-size ymin ok

  -- Form members

  -- Action on apply
  member .action       is STRING

  -- Reference plane
  member .plane        is PLANE

  -- Centre position of arc
  member .position     is POSITION

  -- Apply/Dismiss form (true) OK/Cancel (false)
  member .applyDismiss is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeFeaturePolygon
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFeaturePolygon()

  -- Initialise Variables
  !this.sides.val    = 6
  !this.distance.val = 0
  !this.dimensionType(6)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Default setup for feature circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.setup('!!dbeFeatureEdit.add(!feature)', object PLANE(), N0, true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on apply
--    2   R      PLANE       Return plane for profile
--    3   R      POSITION    Centre of arc
--    4   R      BOOLEAN     Apply/Dismiss form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !plane is PLANE, !position is POSITION, !applyDismiss is BOOLEAN)

  -- Initialise Variables
  !this.action        = !action
  !this.applyDismiss  = !applyDismiss

  if(!applyDismiss) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

  -- Unset plane
  if(!plane.unset()) then
    !this.plane  = object PLANE(N0, Y is N)
  else
    !this.plane  = !plane
  endif

  -- Centre
  !this.position = !this.plane.near(!position)

  -- Show form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dimensionType
--
-- Description: Set number of sides and permissible dimension type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Number of sides
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dimensionType(!passedSides is REAL)

  -- Initialise Variables
  !sides            = !passedSides

  -- Don't allow values less than 3
  if(!sides.unset() or !sides le 2) then
    !!alert.warning('Number of edges must be greater than 2.')
    !this.sides.val = 3
    !sides          = 3
  endif

  -- Even number
  !even      = (!sides / 2 - int(!sides / 2)) eq 0

  -- Odd/even
  if(!even) then
    !dtext[1] = 'Distance across faces'
    !rtext[1] = 'faces'
    !dtext[2] = 'Distance across corners'
    !rtext[2] = 'corners'
    !dtext[3] = 'Length of edges'
    !rtext[3] = 'edges'
  else
    !dtext[1] = 'Distance across corners'
    !rtext[1] = 'corners'
    !dtext[2] = 'Length of edges'
    !rtext[2] = 'edges'
  endif

  -- Determine if we need to build the list
  if(!this.dimensionType.dtext.size() eq !dtext.size()) then
    return
  endif

  -- Current selection
  !selection = !this.dimensionType.selection()
  if(!selection.empty()) then
    !selection = !dtext[1]
  endif

  -- Define options
  !this.dimensionType.dtext = !dtext
  !this.dimensionType.rtext = !rtext

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Add rectangle to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !dimensionType     = !this.dimensionType.selection('RTEXT')
  !dimensionTypeText = !this.dimensionType.selection('DTEXT')

  -- Handle invalid number of sides
  if(!this.sides.val.unset() or !this.sides.val le 2) then
    !!alert.warning('Number of sides must be greater than 3.')
    return
  endif

  -- Handle zero distance
  if(!this.distance.val.unset() or !this.distance.val le 2) then
    !this.dimensionType.selection()
    !!alert.warning(!this.dimensionType.selection() & ' value must be set.')
    return
  endif

  -- Angles
  !increment = 360 / !this.sides.val

  if(!this.dimensionType.active) then
    !angle   = !increment / 2
  else
    !angle   = 90
  endif

  -- Define arc
  if(!dimensionType eq 'corners') then
    !radius  = !this.distance.val / 2
  elseif (!dimensionType eq 'faces') then
    !radius  = !this.distance.val / cos(!angle) / 2
  else
    !radius  = !this.distance.val / sine(!angle) / 2
  endif

  -- Arc
  !arc          = object ARC(!this.position, !this.plane.orientation, 0, 360, !radius, true)

  -- Define positions
  do !i from 1 to !this.sides.val
    !positions[!i] = !arc.anglePosition(!angle)
    !angle         = !angle + !increment
  enddo

  -- Define feature
  !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !positions)
  !profile.close()
  !feature = object DBELOOPFEATURE(!profile)
  !feature.description = !this.sides.val & ' sided polygon - ' & !this.distance.val.string(!!distanceFmt) & ' ' & !dimensionTypeText

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  if(!this.applyDismiss.not()) then
    !this.hide()
  endif

endmethod
-- End of method
