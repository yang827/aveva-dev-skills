-- File:            dbefeaturerectangle.pmlfrm
--   Type:          Form Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 17 16:57:08 "GMT 2000
--
--
-- Description:
-- Standard feature rectangle.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Add rectangle to list
--  dbeFeatureRectangle()            -                   Constructor
--  setup()                          -                   Default setup for feature circle
--  setup(STRING,PLANE,POSITION,BOOLEAN) -                   Setup for form
--

setup form !!dbeFeatureRectangle

  !this.formTitle     = 'Rectangle'
  !this.iconTitle     = 'Rectangle'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition
  text .x 'X'  width 14 is REAL format !!distanceFmt
  path down
  halign right
  text .y 'Y'  width 14 is REAL format !!distanceFmt

  -- Buttons
  button .apply   'Apply'    at xmin form-0    ymax callback '!this.apply()'
  button .dismiss 'Dismiss'  at xmax form-size ymin ok

  -- Form members

  -- Action on apply
  member .action       is STRING

  -- Reference plane
  member .plane        is PLANE

  -- Centre position of arc
  member .position     is POSITION

  -- Apply/Dismiss form (true) OK/Cancel (false)
  member .applyDismiss is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeFeatureRectangle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFeatureRectangle()

  -- Initialise Variables
  !this.x.val = 0
  !this.y.val = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Default setup for feature circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.setup('!!dbeFeatureEdit.add(!feature)', object PLANE(), N0, true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on apply
--    2   R      PLANE       Return plane for profile
--    3   R      POSITION    Centre of arc
--    4   R      BOOLEAN     Apply/Dismiss form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !plane is PLANE, !position is POSITION, !applyDismiss is BOOLEAN)

  -- Initialise Variables
  !this.action        = !action
  !this.applyDismiss  = !applyDismiss

  if(!applyDismiss) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

  -- Unset plane
  if(!plane.unset()) then
    !this.plane  = object PLANE(N0, Y is N)
  else
    !this.plane  = !plane
  endif

  -- Centre
  !this.position = !this.plane.near(!position)

  -- Show form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Add rectangle to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables

  -- Handle zero radius
  if(!this.x.val.unset() or !this.x.val eq 0 or !this.x.val.unset() or !this.x.val eq 0) then
    !!alert.warning('X and Y must be greater than zero.')
    return
  endif

  -- Get position on plane
  !xy           = !this.plane.xyOffset(!this.position)

  -- Define array of positions
  !x            = !this.x.val / 2
  !y            = !this.y.val / 2
  !positions[1] = !this.plane.threeDPosition(object XYPOSITION(!xy.x + !x,      !xy.y + !y * -1))
  !positions[2] = !this.plane.threeDPosition(object XYPOSITION(!xy.x + !x,      !xy.y + !y))
  !positions[3] = !this.plane.threeDPosition(object XYPOSITION(!xy.x + !x * -1, !xy.y + !y))
  !positions[4] = !this.plane.threeDPosition(object XYPOSITION(!xy.x + !x * -1, !xy.y + !y * -1))

  -- Define feature
  !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !positions)
  !profile.close()
  !feature = object DBELOOPFEATURE(!profile)
  !feature.description = 'Rectangle - x' & !this.x.val.string(!!distanceFmt) & ' y' & !this.y.val.string(!!distanceFmt)

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  if(!this.applyDismiss.not()) then
    !this.hide()
  endif

endmethod
-- End of method
