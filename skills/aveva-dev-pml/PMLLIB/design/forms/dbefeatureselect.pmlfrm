--
-- File:            dbefeatureselect.pmlfrm
--   Type:          Form Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 10 10:37:21 "GMT 2000
--
--
-- Description:
-- Select feature from passed array of features.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  dbeFeatureSelect()               -                   Constructor
--  select()                         -                   Select current profile
--  setup(ARRAY,STRING)              -                   Setup form
--  tidy()                           -                   Tidy form
--
------------------------------------------------------------------------

setup form !!dbeFeatureSelect

  !this.formTitle     = 'Select Feature'
  !this.iconTitle     = 'FeatureSel'
  !this.callback      = ''
  !this.cancelCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- List of feature (numbers)
  list .list callback '!this.select()' width 30 length 5

  view .view at xmin ymax volume
    width 33 aspect 1
  exit

  path down
  halign right
  button .cancel 'Cancel' cancel
  button .apply  'OK'     at xmin form-0 ymin callback '!this.apply()' ok

  -- Form Members
  member .features   is ARRAY

  -- Action
  member .action     is STRING

  -- Aid Number
  member .aidNumber  is REAL

exit
-- End of form definition for !!dbeFeatureSelect

------------------------------------------------------------------------
--
-- Method:      dbeFeatureSelect
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFeatureSelect()

  -- Initialise Variables

  -- Set background to default
  !this.view.background  = !!gphViewOpt.background.name

  -- Set default a zoom
  !this.view.mouseMode   = 'Zoom'

  -- Aid Number
  !this.aidNumber        = !!aidNumbers.add('Feature Select')

endmethod
-- End of method definition for .dbeFeatureSelect()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !index   = !this.list.selection().real()
  !feature = object DBELOOPFEATURE()
  !feature = object DBELOOPFEATURE(!this.features[!index])
  !profile = object PROFILE(!this.features[!index].profile)

  -- Tidy Form
  !this.tidy()

  -- Action commend
  if(!this.action.set() and !this.action.trim().empty().not()) then
    $!<this.action>
    handle any
    endhandle
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of features
--    2   R      STRING      Action on apply
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!features is ARRAY, !action is STRING)

  -- Initialise Variables
  !dtext           = ARRAY()
  !rtext           = ARRAY()
  !this.action     = !action
  !this.features.clear()

  -- As the feature contains PROFILE's, we need to "copy" the profile
  do !i indices !features
    !this.features[!i] = object DBELOOPFEATURE(!features[!i])
  enddo

  -- Build selection list
  do !i indices !this.features
    !dtext[!i] = !this.features[!i].description
    !rtext[!i] = !i.string()
  enddo

  !this.list.dtext = !dtext
  !this.list.rtext = !rtext

  -- Show form
  !this.show()

  -- Select
  !this.select()

endmethod
-- End of method definition for .setup(ARRAY, STRING)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select current profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Initialise Variables
  !index               = !this.list.selection().real()
  !profile             = object PROFILE(!this.features[!index].profile)
  !profile.position    = N200000 E200000 D200000
  !profile.orientation = Y IS N
  !plane               = !profile.plane()

  -- Draw Profile
  !!aidNumbers.hide(!this.aidNumber)
  !profile.draw(!this.aidNumber,1,5)

  -- Set view direction
  !!gphViews.look(!this.view, N)
  !!gphViews.look(!this.view, D)

  -- Set view limits
  !from   = !plane.threeDPosition(!this.features[!index].limits[1])
  !to     = !plane.threeDPosition(!this.features[!index].limits[2])

  !volume = object VOLUME(!from, !to)
  !!gphViews.limits(!this.view, !volume)

endmethod
-- End of method definition for .select()
