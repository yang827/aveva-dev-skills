--
-- Description:
--   Database loop arc edit
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  bestFit()                        -                   Set best fit mode
--  close()                          -                   Close form and tidy
--  create()                         -                   Create a new "arc", i.e. a vertex
--  dbeLoopArc()                     -                   Constructor
--  deriveArc()                      -                   Derive arc from pick
--  deriveArc(ARC)                   -                   Setup definition with arc definition
--  display()                        -                   Display form
--  edit()                           -                   Edit existing "arc", i.e. a vertex
--  flipPolarPoint()                 -                   Flip polar position
--  flipPolarPoint(ARC,POSITION)     POSITION            Flip passed arc and polar position
--  flipTangents()                   -                   Flip tangent points
--  lines(ARC)                       BOOLEAN             Calculate adjacent lines and new polar position
--  lines(ARC,POSITION)              BOOLEAN             Calculate adjacent lines and new polar position
--  measureRadius(LINE)              -                   Write measurement to radius gadget
--  measureRadius(MENU,STRING)       -                   Measure radius
--  position()                       -                   Position data
--  position(POSITION)               -                   Position data
--  positionActive(BOOLEAN)          -                   Set position active gadgets
--  positionType()                   -                   Set positionType
--  preview()                        -                   Preview the plane
--  radius()                         -                   Set radius
--  setup()                          -                   Setup form
--  tidy()                           -                   Tidy form data
--
------------------------------------------------------------------------

setup form !!dbeLoopArc

  !!dbeLoopArc.formTitle     = 'Loop Arc'
  !!dbeLoopArc.iconTitle     = 'LoopArc'
  !!dbeLoopArc.callback      = ''
  !!dbeLoopArc.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  bar
  exit

  -- Radius
  text .radius      'Radius ' at xmin y0.5 callback '!this.radius()'       width 14 is REAL format !!distanceFmt

  -- Positioning Gadgets
  frame .positionFrame 'Position' at xmin.radius ymax width 22

    -- Positioning
    option .positionType at x0.5   y1.25 callback '!this.positionType()' width 12
    text   .x        'X' at xmin+3 ymax                                  width 14 is REAL format !!distanceFmt
    path   down
    halign right
    text   .y        'Y'                                                 width 14 is REAL format !!distanceFmt

    -- Lock toggles
    toggle .xLock at xmax.x+1 ymin.x states 'false' 'true'
    toggle .yLock at xmax.y+1 ymin.y states 'false' 'true'

    paragraph .lock at xmax.x ymin.x-0.75 text 'Lock'

  exit

  -- Flip tangent points
  path   down
  halign right
  button .flip    'Flip Tangents'  tooltip 'Flip tangents to opposite side'            callback '!this.flipTangents()'

  -- Apply/Dismiss
  button .apply   ' Apply'   at xmin form-0   ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()'

  -- Form Members

  -- Main controlling form (dbeLoopEdit)
  member .master       is FORM

  -- Mode
  member .create       is BOOLEAN
  member .vertex       is DBREF

  -- Associated vertices
  member .previous     is DBREF
  member .previousArc  is ARC
  member .previousLine is LINE
  member .next         is DBREF
  member .nextArc      is ARC
  member .nextLine     is LINE

  -- Circle definition
  member .arc          is ARC
  member .polarPoint   is POSITION

  -- Aid number being modified
  member .aidCircle    is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL
  member .aidPrevious  is REAL
  member .aidNext      is REAL

  -- Form Control Members
  member .xyPosition   is XYPOSITIONLINK

  -- Best fit mode
  member .bestFit      is BOOLEAN

exit
-- End of form definition for !!dbeLoopArc

------------------------------------------------------------------------
--
-- Method:      dbeLoopArc
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeLoopArc()

  -- build menu bar
  !bar = !this.bar
  !bar.add('Settings',    'settingMenu')

  -- Settings menu
  !menu = !this.newMenu('settingMenu')
    !menu.add('CALLBACK', 'Derive', '!this.deriveArc()')
    !menu.add('TOGGLE', 'Best fit', '!this.bestFit()')

  -- Distance
  !menu = !this.newMenu('radiusMenu')
    !menu.add('CALLBACK', 'Measure',                    '!this.measureRadius(')
    !menu.add('CALLBACK', 'Measure Shortest',           '!this.measureRadius(')
  !this.radius.setPopup(!this.radiusMenu)

  -- Link xy position
  !this.xyPosition.linkInput('!!dbeLoopArc.xyPosition',!this.x, !this.y)
  !this.xyPosition.linkLock('!!dbeLoopArc.xyPosition',!this.xLock, !this.yLock)

  !this.xyPosition.setAction('!!dbeLoopArc.position()')

  -- Set callback
  !this.cancelCall         = '!this.close()'

  -- Master form
  !this.master             = !!dbeLoopEdit

  -- Define position types that can be modified
  !dText[1]                = 'Origin'
  !rText[1]                = 'ORIGIN'
  !dText[2]                = 'Radius'
  !rText[2]                = 'RADIUS'
  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- Set best fit
  !this.bestFit            =  !this.settingMenu.selected('Best fit')
  !this.positionActive(!this.bestFit.not())

  -- set icons
  !this.aidNumber          = !!aidNumbers.add('Loop circle')
  !this.aidPrevious        = !!aidNumbers.add('Loop circle')
  !this.aidNext            = !!aidNumbers.add('Loop circle')

endmethod
-- End of method definition for .dbeLoopArc()

----------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit existing "arc", i.e. a vertex
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .edit()

  -- Initialise Variables
  !this.create = false

  -- Setup from
  !this.setup()

  -- Show form
  !this.display()

endmethod
-- End of method definition for .edit()

----------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create a new "arc", i.e. a vertex
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .create()

  -- Initialise Variables
  !this.create = true

  -- Setup from
  !this.setup()

  -- Show form
  !this.display()

endmethod
-- End of method definition for .create()

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup()

  -- Initialise Variables

  -- Unlock all inputs
  !this.xyPosition.unlockAll()

  -- Create Mode
  if(!this.create) then

    !this.formTitle            = 'Create Arc'

    !this.previous             = !this.master.vertex
    !sequence                  = !this.previous.sequence
    !last                      = !this.previous.owner.mCount
    !pPoint                    = object DBEPPOINT(!this.previous)
    !this.previousArc          = !pPoint.arc()
    !this.previousArc.position = !this.master.plane.near(!this.previousArc.position)

    -- next vertex data
    if(!sequence eq !last) then
      !this.next               = !this.master.vertex.owner.members[1]
    else
      !this.next               = !this.master.vertex.owner.members[!sequence + 1]
    endif
    !pPoint                    = object DBEPPOINT(!this.next)
    !this.nextArc              = !pPoint.arc()
    !this.nextArc.position     = !this.master.plane.near(!this.nextArc.position)

    -- Mark arc at mid point along the lines
    !this.arc.position         = !this.master.plane.threeDPosition(!this.master.xyPosition.xyPosition())
    !this.arc.orientation      = !this.master.plane.orientation
    !this.arc.startAngle       = 0
    !this.arc.endAngle         = 90
    !this.arc.sense            = true
    !this.arc.radius           = 0
    !this.polarPoint           = !this.arc.position

  -- Modify
  else

    !this.formTitle            = 'Modify Arc'

    -- Current vertex data
    !this.vertex               = !this.master.vertex
    !sequence                  = !this.vertex.sequence
    !last                      = !this.vertex.owner.mCount
    !pPoint                    = object DBEPPOINT(!this.vertex)
    !this.arc                  = !pPoint.arc()
    !this.arc.position         = !this.master.plane.near(!this.arc.position)
    !this.polarPoint           = !this.master.plane.near(!this.vertex.position)

    -- If arc angle eq 0, then make it 90, so we don't an unset object
    if(!this.arc.startAngle eq !this.arc.endAngle) then
      !this.arc.endAngle = !this.arc.startAngle + 90
    endif

    -- Previous vertex data
    if(!sequence eq 1) then
      !this.previous           = !this.vertex.owner.members[!last]
    else
      !this.previous           = !this.vertex.owner.members[!sequence - 1]
    endif
    !pPoint                    = object DBEPPOINT(!this.previous)
    !this.previousArc          = !pPoint.arc()
    !this.previousArc.position = !this.master.plane.near(!this.previousArc.position)

    -- next vertex data
    if(!sequence eq !last) then
      !this.next               = !this.vertex.owner.members[1]
    else
      !this.next               = !this.vertex.owner.members[!sequence + 1]
    endif
    !pPoint                    = object DBEPPOINT(!this.next)
    !this.nextArc              = !pPoint.arc()
    !this.nextArc.position     = !this.master.plane.near(!this.nextArc.position)

  endif

  -- Draw previous and next arc
  if(!this.previousArc.radius ne 0) then
    !gpa        = object GPHCIRCLE(!this.previousArc)
    !gpa.detail = false
    !!aidNumbers.replace(!this.aidPrevious, !gpa)
    !!aidNumbers.draw(!this.aidPrevious)
  endif

  if(!this.nextArc.radius ne 0) then
    !gpb        = object GPHCIRCLE(!this.nextArc)
    !gpb.detail = false
    !!aidNumbers.replace(!this.aidNext, !gpb)
    !!aidNumbers.draw(!this.aidNext)
  endif

  -- Position mapped onto working plane
  !xyPosition  = !this.master.plane.xyOffset(!this.arc.position)

  -- Update position gadgets
  !this.radius.val     = !this.arc.radius
  !this.xyPosition.xyPosition(!xyPosition, false, false)

  !this.settingMenu.select('Best fit', false)
  !this.bestFit()

  -- Update arrive/leave lines
  if (  !this.lines(!this.arc) ) then

  -- Draw item
    !this.preview()

  endif

endmethod
-- End of method definition for .setup()

---------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Display form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display()

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.definePosition('Modify vertex')
  !packet.action         = '!!dbeLoopArc.position(!this.return[1].position)'
  !packet.close          = '!!dbeLoopArc.tidy()'
  !packet.key            = 'loopDefinition'
  !packet.description    = !this.master.edgDescription
  !packet.form           = !!dbeLoopArc
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'dbModify'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)


endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise Variables
  !reference   = !!ce
  !previousArc = !this.previousArc
  !nextArc     = !this.nextArc

  -- Calculate bot previous & next position, before we move them
  if(!previousArc.radius ne 0) then
    !previousArc.endAngle   = !previousArc.near(!this.previousLine.endPosition)
    !previousPosition       = !previousArc.pole()
    handle any
      !!alert.warning('Unable to resolve previous vertex position.')
      return
    endhandle
  endif

  -- Update next vertex if its an arc
  if(!nextArc.radius ne 0) then
    !nextArc.startAngle       = !nextArc.near(!this.nextLine.endPosition)
    !nextPosition           = !nextArc.pole()
     handle any
      !!alert.warning('Unable to resolve next vertex position.')
      return
    endhandle
  endif

  -- Set data
  !this.previousArc = !previousArc
  !this.nextArc     = !nextArc

  -- Move previous and next element if required
  if(!previousArc.radius ne 0) then
    !xyPosition             = !this.master.plane.xyOffset(!previousPosition)
    !!ce                    = !this.previous
    AT X$!<xyPosition.x> Y$!<xyPosition.y>
  endif
  if(!nextArc.radius ne 0) then
    !xyPosition             = !this.master.plane.xyOffset(!nextPosition)
    !!ce                    = !this.next
    AT X$!<xyPosition.x> Y$!<xyPosition.y>
  endif

  -- Update vertex
  if(!this.create.not()) then

    !this.master.distance.val = !this.radius.val
    !xyPosition = !this.master.plane.xyOffset(!this.polarPoint)
    !this.master.xyPosition.xyPosition(!xyPosition,false, true)
    !this.master.modifyVertex()

    -- Setup
    !this.master.boundary()

    -- Close on best fit
    if(!this.bestFit) then
      !this.close()
      return
    endif

    -- Update form
    !this.setup()

  else

    !this.master.distance.val = !this.radius.val
    !xyPosition = !this.master.plane.xyOffset(!this.polarPoint)
    !this.master.xyPosition.xyPosition(!xyPosition,false, true)
    !this.master.createVertex()

    !this.master.updateLoop()
    !this.master.boundary()
    !this.master.select(!this.master.vertexNumber)

    -- Close on best fit
    if(!this.bestFit) then
      !this.close()
      return
    endif

    -- Update form
    !this.setup()

  endif

  !!ce = !reference

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove(!this.master.edgDescription)

endmethod
-- End of method definition for .close()

--------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidPrevious)
  !!aidNumbers.hide(!this.aidNext)
  !this.master.setActive(true)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position()

  -- Initialise Variables
  !type       = !this.positionType.selection()
  !xyPosition = !this.xyPosition.xyPosition()
  !position   = !this.master.plane.threeDPosition(!xyPosition)
  !arc        = !this.arc
  !polarPoint = !this.polarPoint

  -- Origin position
  if(!type eq 'ORIGIN') then

    -- Radius eq zero
    if(!arc.radius eq 0) then
      !polarPoint  = !arc.position

    -- Radius not equal to zero
    else
      !direction   = !arc.position.direction(!polarPoint)
      !distance    = !arc.position.distance(!polarPoint)
      !polarPoint  = !position.offset(!direction, !distance)
    endif

    -- Set new arc position
    !arc.position = !position

    -- Re-calculate lines
    if(!this.lines(!arc, !polarPoint)) then
      !this.preview()
    else
      !this.xyPosition.xyPosition(!this.master.plane.xyOffset(!this.arc.position), false, true)
    endif

  -- Radius position
  elseif (!type eq 'RADIUS') then
    -- Calculate distance from centre to new position
    !this.radius.val = !arc.position.distance(!position)

    !this.radius()

  endif


endmethod
-- End of method definition for .position()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Initialise Variables

  -- Don't do anything when doing "best fit"
  if(!this.bestFit) then
    !!alert.warning('This has no meaning when "fitting" an arc between two points.')
    return
  endif

  -- Position mapped onto working plane
  !xyPosition  = !this.master.plane.xyOffset(!position)

  -- Update position gadgets
  !this.xyPosition.xyPosition(!xyPosition, false, false)

  -- Update position
  !this.position()

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Set positionType
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'ORIGIN') then
    !xyPosition = !this.master.plane.xyOffset(!this.arc.position)

  -- Radius position
  elseif (!type eq 'RADIUS') then

    -- Check for
    if(!this.arc.radius eq 0) then
      !xyPosition = !this.master.plane.xyOffset(!this.arc.position)
    else
      !xyPosition = !this.master.plane.xyOffset(!this.arc.anglePosition(!this.arc.startAngle))
    endif

  endif

  -- Set position
  !this.xyPosition.xyPosition(!xyPosition, false, true)

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:  Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !gArc        = object GPHCIRCLE(!this.arc)
  !gArc.detail = false
  !!aidNumbers.replace(!this.aidNumber, !gArc)

  -- Draw lines
  AID LINE NUMBER $!<this.aidNumber> $!<this.previousLine.startPosition> TO  $!<this.previousLine.endPosition>
  AID LINE NUMBER $!<this.aidNumber> $!<this.nextLine.startPosition>     TO  $!<this.nextLine.endPosition>

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      lines
--
-- Description:  Calculate adjacent lines and new polar position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         New arc to test
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is we can modify arc
--
------------------------------------------------------------------------

-- Define method
define method .lines(!arc is ARC) is BOOLEAN

  return !this.lines(!arc, !this.polarPoint)

endmethod
-- End of method definition for .lines(ARC) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      lines
--
-- Description:  Calculate adjacent lines and new polar position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         New arc to test
--    2   R      POSITION    Test polar position
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is we can modify arc
--
------------------------------------------------------------------------

-- Define method
define method .lines(!arc is ARC, !passedPoint is POSITION) is BOOLEAN

  -- Initialise Variables
  !polarPoint          = !passedPoint

  -- All radii are zero (i.e. the point and the adjacent arcs are only points)
  if(!arc.radius eq 0 and !this.previousArc.radius eq 0 and !this.nextArc.radius eq 0) then

    -- Check if we need to resolve the lines
    if(!this.bestFit) then
      if(!this.previousArc.position.distance(!this.nextArc.position) lt !arc.radius * 2) then
        !this.arc          = !arc
        !this.polarPoint   = !polarPoint
        !this.previousLine = object LINE(!this.previousArc.position, !this.previousArc.position)
        !this.nextLine     = object LINE(!this.nextArc.position,     !this.nextArc.position)
         return true
      endif
    endif

    !this.previousLine = object LINE(!arc.position, !this.previousArc.position)
    !this.nextLine     = object LINE(!arc.position, !this.nextArc.position)
    !this.polarPoint   = !arc.position
    !this.arc          = !arc
    return true

  -- Adjacent radii are zero and point is an arc
  elseif (!arc.radius ne 0 and !this.previousArc.radius eq 0 and !this.nextArc.radius eq 0) then

    -- Check if we need to resolve the lines
    if(!this.bestFit) then
      if(!this.previousArc.position.distance(!this.nextArc.position) lt !arc.radius * 2) then
        !this.arc          = !arc
        !this.polarPoint   = !polarPoint
        !this.previousLine = object LINE(!this.previousArc.position, !this.previousArc.position)
        !this.nextLine     = object LINE(!this.nextArc.position,     !this.nextArc.position)
        return true
      endif
    endif

    -- If polar point is on the line between the next and previous arc, offset it normal
    if(!polarPoint.distance(object LINE(!this.previousArc.position, !this.nextArc.position)) eq 0) then
      !polarPoint      = !polarPoint.offset(!this.previousArc.position.direction(!this.nextArc.position).orthogonal(!this.master.plane.orientation.zDir()), 1000mm)
    endif

    !previousLine      = !!appMathLib.gmfLine.pntTan(!this.previousArc.position, !arc, !polarPoint).reverseSense()
    handle any
      return false
    endhandle
    !nextLine          = !!appMathLib.gmfLine.pntTan(!this.nextArc.position, !arc, !polarPoint).reverseSense()
    handle any
      return false
    endhandle
    !polarPoint        = !previousLine.intersection(!nextLine)
    handle any
      return false
    endhandle
    -- If lines intersect within their length, then move polar point to other side and try again
    if(!previousLine.onProjected(!polarPoint) and !nextLine.onProjected(!polarPoint)) then
      !polarPoint      = !this.flipPolarPoint(!arc, !polarPoint)
      !previousLine    = !!appMathLib.gmfLine.pntTan(!this.previousArc.position, !arc, !polarPoint).reverseSense()
      handle any
        return false
      endhandle
      !nextLine        = !!appMathLib.gmfLine.pntTan(!this.nextArc.position, !arc, !polarPoint).reverseSense()
      handle any
        return false
      endhandle
      !polarPoint      = !previousLine.intersection(!nextLine)
    endif

    -- Set data
    !this.previousLine = !previousLine
    !this.nextLine     = !nextLine
    !this.polarPoint   = !polarPoint
    !this.arc          = !arc
    return true

  -- Adjacent radii are set and point radius is zero
  elseif (!arc.radius eq 0 and !this.previousArc.radius ne 0 and !this.nextArc.radius ne 0) then

    -- Check if we need to resolve the lines
    if(!this.bestFit) then
      if(!this.previousArc.position.distance(!this.nextArc.position) lt !arc.radius * 2) then
        !this.arc          = !arc
        !this.polarPoint   = !polarPoint
        !previousPoint     = !this.arc.anglePosition(!this.arc.startAngle)
        !this.previousLine = object LINE(!previousPoint, !previousPoint)
        !nextPoint         = !this.arc.anglePosition(!this.arc.endAngle)
        !this.nextLine     = object LINE(!nextPoint, !nextPoint)
         return true
      endif
    endif

    !previousLine = !!appMathLib.gmfLine.pntTan(!arc.position, !this.previousArc, !this.previous.position)
    handle any
      return false
    endhandle
    !nextLine     = !!appMathLib.gmfLine.pntTan(!arc.position, !this.nextArc, !this.next.position)
    handle any
      return false
    endhandle

    -- Set data
    !this.previousLine = !previousLine
    !this.nextLine     = !nextLine
    !this.polarPoint   = !arc.position
    !this.arc          = !arc
    return true

  -- One of the adjacent radii is set and point radius is zero
  elseif (!arc.radius eq 0 and (!this.previousArc.radius ne 0 or !this.nextArc.radius ne 0)) then

    -- Check if we need to resolve the lines
    if(!this.bestFit) then
      if(!this.previousArc.position.distance(!this.nextArc.position) lt !arc.radius * 2) then
        !this.arc          = !arc
        !this.polarPoint   = !polarPoint
        if(!this.previousArc.radius ne 0) then
          !previousPoint   = !this.arc.anglePosition(!this.arc.startAngle)
        else
          !previousPoint   = !this.previousArc.position
        endif
        !this.previousLine = object LINE(!previousPoint, !previousPoint)
        if(!this.previousArc.radius ne 0) then
          !nextPoint       = !this.arc.anglePosition(!this.arc.endAngle)
        else
          !nextPoint       = !this.nextArc.position
        endif
        !this.nextLine     = object LINE(!nextPoint, !nextPoint)
         return true
      endif
    endif

    -- Preceding arc with no radius
    if(!this.previousArc.radius eq 0) then
      !previousLine = object LINE(!arc.position, !this.previousArc.position)

    -- Preceding arc with radius
    else
      !previousLine = !!appMathLib.gmfLine.pntTan(!arc.position, !this.previousArc, !this.previous.position)
      handle any
        return false
      endhandle
    endif

    -- Next arc with no radius
    if(!this.nextArc.radius eq 0) then
      !nextLine     = object LINE(!arc.position, !this.nextArc.position)

    -- next arc with radius
    else
      !nextLine     = !!appMathLib.gmfLine.pntTan(!arc.position, !this.nextArc, !this.next.position)
      handle any
        return false
      endhandle
    endif

    !polarPoint     = !previousLine.intersection(!nextLine)

    -- If lines intersect within their length, then move polar point to other side and try again
    if(!previousLine.onProjected(!polarPoint) and !nextLine.onProjected(!polarPoint)) then
      !polarPoint      = !this.flipPolarPoint(!arc, !polarPoint)

      -- Preceding arc with no radius
      if(!this.previousArc.radius eq 0) then
        !previousLine = object LINE(!arc.position, !this.previousArc.position)

      -- Preceding arc with radius
      else
        !previousLine = !!appMathLib.gmfLine.pntTan(!arc.position, !this.previousArc, !this.previous.position)
        handle any
          return false
        endhandle
      endif

      -- Next arc with no radius
      if(!this.nextArc.radius eq 0) then
        !nextLine     = object LINE(!arc.position, !this.nextArc.position)

      -- next arc with radius
      else
        !nextLine     = !!appMathLib.gmfLine.pntTan(!arc.position, !this.nextArc, !this.next.position)
        handle any
          return false
        endhandle
      endif

      !polarPoint     = !previousLine.intersection(!nextLine)
    endif

    -- Set data
    !this.previousLine = !previousLine
    !this.nextLine     = !nextLine
    !this.polarPoint   = !polarPoint
    !this.arc          = !arc
    return true

  -- Adjacent radii are set and point radius is set
  elseif (!arc.radius ne 0 and (!this.previousArc.radius ne 0 or !this.nextArc.radius ne 0)) then

    -- Check if we need to resolve the lines
    if(!this.bestFit) then
      if(!this.previousArc.position.distance(!this.nextArc.position) lt !arc.radius * 2) then
        !this.arc          = !arc
        !this.polarPoint   = !polarPoint
        if(!this.previousArc.radius ne 0) then
          !previousPoint   = !this.arc.anglePosition(!this.arc.startAngle)
        else
          !previousPoint   = !this.previousArc.position
        endif
        !this.previousLine = object LINE(!previousPoint, !previousPoint)
        if(!this.previousArc.radius ne 0) then
          !nextPoint       = !this.arc.anglePosition(!this.arc.endAngle)
        else
          !nextPoint       = !this.nextArc.position
        endif
        !this.nextLine     = object LINE(!nextPoint, !nextPoint)
         return true
      endif
    endif

    -- Preceding arc with no radius
    if(!this.previousArc.radius eq 0) then
      !previousLine = !!appMathLib.gmfLine.pntTan(!this.previousArc.position, !this.arc, !polarPoint)
      handle any
        return false
      endhandle

    -- Preceding point with radius
    else
      !previousLine = !!appMathLib.gmfLine.tanTan(!arc, !polarPoint, !this.previousArc, !this.previous.position)
      handle any
        return false
      endhandle
    endif

    -- Preceding arc with no radius
    if(!this.nextArc.radius eq 0) then
      !nextLine     = !!appMathLib.gmfLine.pntTan(!this.nextArc.position, !arc, !polarPoint)
      handle any
        return false
      endhandle

    -- Preceding point with radius
    else
      !nextLine     = !!appMathLib.gmfLine.tanTan(!arc, !polarPoint, !this.nextArc, !this.next.position)
      handle any
        return false
      endhandle
    endif

    !polarPoint     = !previousLine.intersection(!nextLine)

    -- If lines intersect within their length, then move polar point to other side and try again
    if(!previousLine.onProjected(!polarPoint) and !nextLine.onProjected(!polarPoint)) then
      !polarPoint      = !this.flipPolarPoint(!arc, !polarPoint)

      -- Preceding arc with no radius
      if(!this.previousArc.radius eq 0) then
        !previousLine = !!appMathLib.gmfLine.pntTan(!this.previousArc.position, !arc, !polarPoint)
        handle any
          return false
        endhandle

      -- Preceding point with radius
      else
        !previousLine = !!appMathLib.gmfLine.tanTan(!arc, !polarPoint, !this.previousArc, !this.previous.position)
        handle any
          return false
        endhandle
      endif

      -- Preceding arc with no radius
      if(!this.nextArc.radius eq 0) then
        !nextLine     = !!appMathLib.gmfLine.pntTan(!this.nextArc.position, !arc, !polarPoint)
        handle any
          return false
        endhandle

      -- Preceding point with radius
      else
        !nextLine     = !!appMathLib.gmfLine.tanTan(!arc, !polarPoint, !this.nextArc, !this.next.position)
        handle any
          return false
        endhandle
      endif

      !polarPoint     = !previousLine.intersection(!nextLine)
    endif

    -- Set data
    !this.previousLine = !previousLine
    !this.nextLine     = !nextLine
    !this.polarPoint   = !polarPoint
    !this.arc          = !arc
    return true

  endif

  return false

endmethod
-- End of method definition for .lines(ARC, POSITION) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      flipPolarPoint
--
-- Description:  Flip polar position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .flipPolarPoint()

  !this.polarPoint = !this.flipPolarPoint(!this.arc, !this.polarPoint)

endmethod
-- End of method definition for .flipPolarPoint()

------------------------------------------------------------------------
--
-- Method:      flipPolarPoint
--
-- Description:  Flip passed arc and polar position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc polar position if to be flipped from
--    2   R      POSITION    polar point
-- Return:
--   [Data Type] [Description]
--    POSITION    flipped polar point
--
------------------------------------------------------------------------

-- Define method
define method .flipPolarPoint(!arc is ARC, !polarPoint is POSITION) is POSITION

  -- Initialise Variables
  !distance  = !arc.position.distance(!polarPoint)
  !direction = !arc.position.direction(!polarPoint).opposite()
  handle any
    return !polarPoint
  endhandle
  return !arc.position.offset(!direction, !distance)

endmethod
-- End of method definition for .flipPolarPoint(ARC, POSITION) POSITION
------------------------------------------------------------------------
--
-- Method:      flipTangents
--
-- Description:  Flip tangent points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .flipTangents()

  -- Initialise Variables
  !arc = !this.arc

  -- Recalculate polar position
  if(!this.bestFit) then

    -- Handle none zero radius arc
    if(!arc.radius gt 0) then

      -- Best fit between two points
      if(!this.previousArc.radius eq 0 and !this.nextArc.radius eq 0) then
        !midPoint       = !this.previousArc.position.midPoint(!this.nextArc.position)
        !centre         = !midPoint.distance(!arc.position)
        !polarDistance  = !midPoint.distance(!this.polarPoint)
        !direction      = !midPoint.direction(!this.polarPoint)

        -- Arc less then the distance between the points
        if(!centre eq 0) then
          !polarPoint   = !midPoint.offset(!direction.opposite(), !polarDistance)

        -- Arc greater than distance between points
        else
          !polarPoint   = !midPoint.offset(!direction.opposite(), !polarDistance)
          !arc.position = !midPoint.offset(!direction, !centre)
        endif

      -- Best fit between arc & arc or arc & point
      else
        !previousPosition = !arc.anglePosition(!arc.startAngle)
        !nextPosition     = !arc.anglePosition(!arc.endAngle)
        !midPoint         = !previousPosition.midPoint(!nextPosition)
        !centre           = !midPoint.distance(!arc.position)
        !direction        = !midPoint.direction(!arc.position)
        !arc.position     = !midPoint.offset(!direction.opposite(), !centre)
        PIN1 AT $!arc.position
        !arc              = !!appMathLib.gmfArc.tanTan(!arc.radius, !this.previousArc, !previousPosition, !this.nextArc, !nextPosition, !arc.position)
        !polarPoint       = !arc.pole()

      endif

      !isOK = !this.lines(!arc, !polarPoint)

    endif

  -- Flip polar points using the arc
  else
    !this.flipPolarPoint()
    !isOK = !this.lines(!arc)
  endif

  if (!isOK) then
      !this.preview()
  endif

endmethod
-- End of method definition for .flipTangents()

------------------------------------------------------------------------
--
-- Method:      bestFit
--
-- Description:  Set best fit mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .bestFit()

  -- Initialise Variables
  !this.bestFit = !this.settingMenu.selected('Best fit')

  -- Set position active gadgets
  !this.positionActive(!this.bestFit.not())

  -- Determine the best fit
  if(!this.bestFit) then

    -- Set tag on buttons
    !this.apply.tag   = '  OK  '
    !this.dismiss.tag = ' Cancel'

    -- Previous points are zero (arc fitted through two points
    if(!this.previousArc.radius eq 0 and !this.nextArc.radius eq 0) then

      -- If distance between previous and next is > radius / 2 then place centre in the middle
      if(!this.previousArc.position.distance(!this.nextArc.position) gt !this.radius.val * 2) then
        !this.arc.position = !this.previousArc.position.midPoint(!this.nextArc.position)
      endif

    -- Next/Previous arc have radii
    else

      -- Check for minimum
      !minimum = !this.previousArc.position.distance(!this.nextArc.position) - !this.previousArc.radius - !this.nextArc.radius
      if(!this.arc.radius lt !minimum) then
        !!alert.warning('A best fit radius between adjacent arcs can not be less then (' & !minimum & '), using twice this value.')
        !this.arc.radius = !minimum * 2
        !this.radius.val = !this.arc.radius
      endif
      !previousPosition  = !this.master.plane.near(!this.previous.position)
      !nextPosition      = !this.master.plane.near(!this.next.position)
      !line              = !previousPosition.line(!nextPosition)
      !previousPosition  = !line.near(!this.previousArc.position)
      !nextPosition      = !line.near(!this.nextArc.position)
      !arc               = !!appMathLib.gmfArc.tanTan(!this.arc.radius, !this.previousArc, !previousPosition, !this.nextArc, !nextPosition, !this.arc.position)
      !this.arc          = !arc
      !this.polarPoint   = !arc.pole()

    endif
    -- View circle
    if ( !this.lines(!this.arc, !this.polarPoint) ) then
        !this.preview()
    endif

  else

    -- Set tag on buttons
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  endif

  -- Update position
  !this.positionType()

endmethod
-- End of method definition for .bestFit()

------------------------------------------------------------------------
--
-- Method:      positionActive
--
-- Description: Set position active gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Active
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionActive(!active is BOOLEAN)

  -- Initialise Variables
  !this.positionType.active = !active
  !this.xyPosition.active(!active)

endmethod
-- End of method definition for .positionActive(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      measureRadius
--
-- Description: Measure radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureRadius(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then
    !packet.defineMeasure('distance')

  -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then
    !packet.defineMeasure('shortest')
  endif

  !packet.description = !this.master.edgDescription
  !packet.action      = '!!dbeLoopArc.measureRadius(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .measureRadius(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measureRadius
--
-- Description: Write measurement to radius gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measureRadius(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.radius.val = 0
  else
    !this.radius.val = !line.length()
  endif

  !this.radius()

endmethod
-- End of method definition for .measureRadius(LINE)

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description:  Set radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .radius()

  -- Initialise Variables
  !arc        = !this.arc
  !arc.radius = !this.radius.val
  !polarPoint = !this.polarPoint

  -- Best fit curve
  if(!this.bestFit) then

    -- Previous points are zero (arc fitted through two points
    if(!this.previousArc.radius eq 0 and !this.nextArc.radius eq 0) then

      -- If distance between previous and next is > radius / 2 then place centre in the middle
      if(!this.previousArc.position.distance(!this.nextArc.position) gt !this.radius.val * 2) then
        !arc.position = !this.previousArc.position.midPoint(!this.nextArc.position)
      else

        -- If polar point is on the line between the next and previous arc, offset it normal
        if(!polarPoint.distance(object LINE(!this.previousArc.position, !this.nextArc.position)) eq 0) then
         !polarPoint      = !polarPoint.offset(!this.previousArc.position.direction(!this.nextArc.position).orthogonal(!this.master.plane.orientation.zDir()), 1000mm)
        endif

        !arc          = !!appMathLib.gmfArc.fradPntPnt(!this.radius.val,!this.previousArc.position, !this.nextArc.position, !polarPoint)
        !polarPoint   = !arc.pole()
      endif

        -- Next/Previous arc have radii
    else

      -- Check for minimum
      !minimum = !this.previousArc.position.distance(!this.nextArc.position) - !this.previousArc.radius - !this.nextArc.radius
      if(!arc.radius lt !minimum) then
        !!alert.warning('A best fit radius between adjacent arcs can not be less then (' & !minimum & '), using previous value (' & !this.arc.radius & ').')
        !this.radius.val = !this.arc.radius
        !arc.radius      = !this.radius.val
      endif

      !previousPosition  = !this.master.plane.near(!this.previous.position)
      !nextPosition      = !this.master.plane.near(!this.next.position)
      !line              = !previousPosition.line(!nextPosition)
      !previousPosition  = !line.near(!this.previousArc.position)
      !nextPosition      = !line.near(!this.nextArc.position)
      !arc               = !!appMathLib.gmfArc.tanTan(!arc.radius, !this.previousArc, !previousPosition, !this.nextArc, !nextPosition, !this.arc.position)
      !polarPoint        = !arc.pole()

    endif

    -- Recalculate lines
    if(!this.lines(!arc, !polarPoint)) then
      !this.preview()

    else
      !this.radius.val  = !this.arc.radius
    endif

  -- Set Radius
  else

    -- If previous radius was zero, then we need to assume some angles and a new polar direction
    if(!this.arc.radius eq 0) then

      -- If distance between arc and previous or next arc, then we can set the radius
      if(!arc.position.distance(!this.previousArc.position) eq 0 or !arc.position.distance(!this.nextArc.position) eq 0) then
        !!alert.warning('An arc can not have a radius and be coincident with either of the adjacent points.')
        !this.radius.val   = !this.arc.radius
        return
      endif

      !arc.startAngle   = 0
      !arc.endAngle     = 90
      !oppositePrevious = !this.previousLine
      !oppositeNext     = !this.nextLine
      !startDirection   = !oppositePrevious.direction()
      !endDirection     = !oppositeNext.direction()
      if (!startDirection.isParallel(!endDirection)eq true) then
      	 !!alert.message('Directions from chosen point to previous and next points are parallel. Choose another point to continue')
      	  !this.close()
      	  return
      else
      !direction        = !startDirection.bisect(!endDirection)
    	endif
      !angle            = !startDirection.angle(!direction)
      !distance         = !this.radius.val / !angle.cosine()

    -- Recalculate polar position
    else
      !direction        = !arc.position.direction(!polarPoint)
      !distance         = !arc.position.distance(!polarPoint)
    endif

    -- Derive new polar position
    !polarPoint         = !arc.position.offset(!direction, !distance)

    -- Recalculate lines
    if(!this.lines(!arc, !polarPoint)) then
      !this.preview()

    else
      !this.radius.val  = !this.arc.radius
    endif
  endif

endmethod
-- End of method definition for .radius()

------------------------------------------------------------------------
--
-- Method:      deriveArc
--
-- Description: Derive arc from pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveArc()

  -- Initialise Variables
  !packet                   = object EDGPACKET()
  !packet.defineCircle('derive')
  !packet.key               = 'Copy Arc'
  !packet.description       = !this.master.edgDescription
  !packet.type              = 'Copy Arc'
  !packet.priority          = 3
  !packet.action            = '!!dbeLoopArc.deriveArc(!this.return[1])'
  !packet.pickPacket.prompt = 'Select arc to derive from'

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .deriveArc()

------------------------------------------------------------------------
--
-- Method:      deriveArc
--
-- Description: Setup definition with arc definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveArc(!arc is ARC)

  -- Initialise Variables
  if( !arc.unset() ) then
    return
  endif

  -- Select "ORIGIN" for centre positioning
  !this.positionType.select('RTEXT','ORIGIN')

  -- Position mapped onto working plane
  !xyPosition  = !this.master.plane.xyOffset(!arc.position)

  -- Update position gadgets
  !this.xyPosition.xyPosition(!xyPosition, false, false)

  -- Update arc
  !this.position()

  -- Get radius
  !this.radius.val = !arc.radius

  -- Update arc
  !this.radius()

endmethod
-- End of method definition for .deriveArc(ARC)
