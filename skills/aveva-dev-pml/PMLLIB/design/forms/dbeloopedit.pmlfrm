--   Module:        design
--   Replaces:
--
-- Author:          G.Kent
-- Created:         Thurs 20th August 1998
--
--
--
-- Description:
-- Form for modifying loop (Panel, Extrusion) vertices.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  boundary()                       -                   Display the boundary of the pane
--  boundary(MENU,STRING)            -                   Display the boundary of the pane
--  calcAidSizes(BOOLEAN,REAL)       -                   calculate the sizes to be used for the aid graphics
--  close(BOOLEAN)                   -                   Close form
--  confirm()                        -                   Set confirm status
--  createPoints()                   -                   Create points
--  createVertex()                   -                   Create vertex
--  dbeLoopEdit()                    -                   Constructor
--  displayAxes()                    -                   Toggle axes on/off
--  distance()                       -                   Set radius/length of edge
--  edit(DBREF)                      -                   Setup form for editing a loop definition
--  explicitArc()                    -                   Define arc explicitly
--  extend(BOOLEAN)                  -                   Extend start/end of line
--  extend(BOOLEAN,EDGPICKDATA)      -                   Extend start/end of line dependent on
--  groupInsert()                    -                   Insert group after current vertex
--  groupReplace()                   -                   Replace current group vertices at new positions
--  groupShift(BOOLEAN)              -                   Move groups definition clock-wise/anti-clock-wise
--  initialise()                     -                   Initialisation of form
--  measureAngle(MENU,STRING)        -                   Setup to measure of angle
--  measureAngle(REAL)               -                   Update angle
--  measureDistance(LINE)            -                   Write measurement to distance gadget
--  measureDistance(MENU,STRING)     -                   Measure distance/radius
--  measureOffset(LINE)              -                   Write measurement to distance gadget
--  measureOffset(MENU,STRING)       -                   Measure distance/radius
--  mirror()                         -                   Define edg for picking mirror line
--  mirror(LINE)                     -                   Mirror about passed line
--  modifyVertex()                   -                   Modify vertex
--  offsetEdges(BOOLEAN)             -                   Offset edges
--  parallel()                       -                   Make line parallel with an other item, about start/end
--  parallel(EDGPICKDATA)            -                   Make edge parallel to another edge
--  position()                       -                   Set position
--  position(EDGPOSITIONDATA)        -                   Picked position
--  positionLine()                   -                   Set position of line
--  positionType()                   -                   Select positioning mode and set prompt
--  remove()                         -                   Remove current active element
--  removeCoincident()               -                   Remove coincident
--  reverse()                        -                   Reverse the order of the group
--  rotate(BOOLEAN)                  -                   Rotate
--  select()                         -                   Select a vertex by picking it
--  select(REAL)                     -                   Select a vertex (depending on the mode we are in will determine if we also select it form movement)
--  select(STRING)                   -                   Select a vertex or vertices from the graphics
--  selectEdge(DBREF)                -                   Selects edge from passed data
--  selectGroup(DBELOOPGROUP)        -                   Define group using passed polygon
--  selectVertex(DBREF)              -                   Selects point from passed data
--  setEditButtonState()             -                   Update the activation states of the various controls
--  setGadgets()                     -                   Update gadgets
--  setMode(STRING,STRING)           -                   Set mode
--  setup(DBREF)                     BOOLEAN             Setup form with passed loop
--  tagEdge()                        -                   Tag Edge
--  tagNewPosition()                 -                   Tag New position of vertex
--  tagNewVertex()                   -                   Tag New position of vertex
--  tagVertex()                      -                   Tag current vertex
--  tidy()                           -                   Tidy graphics
--  updateLoop()                     -                   Update Loop definition of extrusion (i.e. all the polygon definitions)
--
------------------------------------------------------------------------

-- Define form

setup form !!dbeLoopEdit noAlign varChars

  !!dbeLoopEdit.formTitle     = 'Loop Vertex Editor'
  !!dbeLoopEdit.iconTitle     = 'VERTEX'
--  !!dbeLoopEdit.callback      = '!this.initialise()'
  !!dbeLoopEdit.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definitions
  -- Bar menu
  bar
  exit

  -- Current element
  paragraph .ceElement at xmin ymin width 35 height 1

  path right
  hdist 1

  frame .selectFrame 'Mode Selection' at x0.5 ymax
    hdist 0
    button .defineWhole              toggle pixmap  height 16 width 16 tooltip 'Select all'     callback '!this.select(''ALL'')'
    path right
    button .defineGroup              toggle pixmap height 16 width 16 tooltip 'Select group to modify'   callback '!this.select(''GROUP'')'
    button .defineEdge               toggle pixmap height 16 width 16 tooltip 'Select edge to modify'    callback '!this.select(''EDGE'')'
    button .definePoint              toggle pixmap height 16 width 16 tooltip 'Select point to modify'   callback '!this.select(''POINT'')'
    button .createPoints             toggle pixmap height 16 width 16 tooltip 'Create points'            callback '!this.select(''CREATE'')'
  exit

  -- Loop positioning
  frame .navigateFrame 'Vertex'
    path right
    hdist 0
    button .pick        pixmap height 16 width 16 tooltip 'Select vertex/edge'           callback '!this.select()'
    valign centre
    text   .sequence                              tooltip 'Loop vertex/edge number'      callback '!this.select(!this.sequence.val)'     width 3 is REAL
    valign top
    button .next        at xmax ycen.sequence-size pixmap height 6  width 7  tooltip 'Move to next vertex/edge'     callback '!this.select(!this.vertexNumber + 1)'
    button .previous    at xmin ymax          pixmap height 6  width 7  tooltip 'Move to previous vertex/edge' callback '!this.select(!this.vertexNumber - 1)'
  exit

  -- Modification of group
  frame .groupFrame   'Group'    at xmin.selectFrame ymax

    -- Definition
    frame .defFrame   'Definition' at x0.5 y0.5 height 2.2
      path right
      button .groupReverse    tooltip 'Reverse group definition'      pixmap height 16 width 16  callback '!this.reverse()'
      button .groupShiftLeft  tooltip 'Move start forwards'           pixmap height 16 width 16  callback '!this.groupShift(true)'
      button .groupShiftRight tooltip 'Move start backwards'          pixmap height 16 width 16  callback '!this.groupShift(false)'
    exit

    -- Expand/Contract
    frame .scaleFrame 'Expand/Contract' at height.defFrame
      text   .groupDistance                                                                      callback '' width 12 is REAL format !!distanceFmt
      path right
      button .groupExpand     tooltip 'Expand group'                  pixmap height 16 width 16  callback '!this.offsetEdges(true)'
      button .groupContract   tooltip 'Contract group'                pixmap height 16 width 16  callback '!this.offsetEdges(false)'
    exit

  exit

  -- Line specific actions
  frame .lineFrame   'Line'   at xmin ymax height 2.2
    button .extendStart     tooltip 'Extend start of line'            pixmap height 16 width 16  callback '!this.extend(true)'
    button .extendEnd       tooltip 'Extend end of line'              pixmap height 16 width 16  callback '!this.extend(false)'
    button .parallel        tooltip 'Make line parallel'              pixmap height 16 width 16  callback '!this.parallel()'
  exit

  -- Angle
  frame .rotateFrame 'Rotate'  height.lineFrame
    text   .groupAngle    'Angle'                                                                callback '' width 7 is REAL
    path right
    button .groupLeft       tooltip 'Rotate group anti-clock-wise'    pixmap height 16 width 16  callback '!this.rotate(false)'
    button .groupRight      tooltip 'Rotate group clock-wise'         pixmap height 16 width 16  callback '!this.rotate(true)'
  exit

  -- Action
  frame .actionFrame 'Action' at xmin.lineFrame ymax height 2.2
    path right
    button .groupInsert     tooltip 'Insert selected'                 pixmap height 16 width 16 callback '!this.groupInsert()'
    button .mirror          tooltip 'Mirror'                          pixmap height 16 width 16 callback '!this.mirror()'
    button .remove          tooltip 'Delete selection'                pixmap height 16 width 16 callback '!this.remove()'
    button .cirExplicit     tooltip 'Define/Modify arc'               pixmap height 16 width 16 callback '!this.explicitArc()'
  exit

  frame .aidFrame 'Aid diameter' at xmax.actionFrame ymin.actionFrame
    text   .aidSize        tooltip 'Aid sphere diameter'      callback '!this.calcAidSizes(true, 0)'     width 8 is REAL format !!distanceFmt
    button .aidNext        at xmax.aidSize ymin.aidSize  pixmap height 6  width 7  tooltip 'Increase diameter' callback '!this.calcAidSizes(true, 1)'
    button .aidPrevious    at xmax.aidSize ymax.aidNext  pixmap height 6  width 7  tooltip 'Decrease diameter' callback '!this.calcAidSizes(true, -1)'

  exit
  -- Group command
  frame .positionFrame 'Position' at xmin.actionFrame ymax

    -- Origin/Position option
    option .positionType at x0.5   y1.25 callback '!this.positionType()' width 8
    text   .x        'X' at xmax+1 ymin                                  width 14 is REAL format !!distanceFmt
    path   down
    halign right
    text   .y        'Y'                                                 width 14 is REAL format !!distanceFmt
    text   .distance 'Length'            callback '!this.distance()'     width 14 is REAL format !!distanceFmt

    button .accept 'Create' at xmax ymin callback ''

    -- Lock toggles
    toggle .xLock at xmax.x+1 ymin.x states 'false' 'true'
    toggle .yLock at xmax.y+1 ymin.y states 'false' 'true'

    paragraph .lock at xmax.x ymin.x-0.75 text 'Lock'

  exit



  -- Form members

  -- Event Description
  member .edgDescription   is STRING

  -- Extrusion
  member .extrusion        is DBREF

  -- Loop Name
  member .loop             is DBREF

  -- Extrusions plane (reference plane of panel)
  member .plane            is PLANE

  -- Extrusion in terms of a polygon
  member .polygon          is GMFPOLYGON

  -- Extrusion in terms of a dbePanel
  member .genericExtrusion is DBEGEXTRUSION

  -- Current selection (position of inclusion/modification)
  member .vertex           is DBREF
  member .vertexNumber     is REAL

  -- Vertices of extrusion
  member .vertices         is ARRAY
  member .verticesList     is ARRAY

  -- Mode Data
    -- Active mode (current mode form is in)
    member .mode           is STRING

    -- Mode type (group, edge or vertex mode)
    member .modeType       is STRING

  -- Settings
  member .freeRotation     is BOOLEAN
  member .tagEdges         is BOOLEAN

  -- Current vertices being manipulated
  member .group            is DBELOOPGROUP

  -- Edge selection
  member .edgeLine         is LINE
  member .edge             is DBREF

  -- xyPosition
  member .xyPosition       is XYPOSITIONLINK

  -- Aid Numbers
  member .aidAxes          is REAL
  member .aidNumber        is REAL
  member .aidGroup         is REAL
  member .aidTag           is REAL
  member .aidNew           is REAL

  -- Aid graphics dimensions
  member .aidVertexSize    is REAL
  member .aidOriginSize    is REAL
  member .aidCircleSize    is REAL
  --whether to display the aid axes or not
  member .dispAxes         is BOOLEAN

  --currently selected button
  member .editButtonMode   is STRING

  -- undo member
  member .loopUndo             is UNDOABLE

exit

--------------------------------------------------------------------------
--
-- Method: dbeLoopEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------
define method .dbeLoopEdit()

  -- build menu bar
  !bar = !this.bar
  !bar.add('Control',     'controlMenu')
  !bar.add('Settings',    'settingMenu')
  !bar.add('Utilities',   'utilityMenu')

  -- File menu
  !menu = !this.newMenu('controlMenu')
    !menu.add('callback', 'CE',        |!!dbeLoopEdit(!!ce, 'PANE FLOOR SCREED NXTR REVO NREV')|)
    --!menu.add('callback', 'CE',        '!this.setup(!!ce)')
    --!menu.add('callback', 'Pick',      '!this.pickExtrusion()')
    !menu.add('separator')
    !menu.add('callback', 'Close',     '!this.close(FALSE)')

  -- Settings menu
  !menu = !this.newMenu('settingMenu')
    !menu.add('toggle', 'Confirm',     '!this.confirm()')
    !menu.add('toggle', 'Confirm on delete',     '')
    !menu.add('separator')
    !menu.add('toggle', 'Tag edges',   '!this.boundary(')
    !menu.add('toggle', 'Display axes', '!this.displayAxes()')
    !menu.add('separator')
    !menu.add('toggle', 'Free rotate', '')

  -- Settings menu
  !menu = !this.newMenu('utilityMenu')
    !menu.add('callback', 'Remove coincident',     '!this.removeCoincident()')

  -- Pop-up menus

    -- Set current vertex to EDGE
    !menu = !this.newMenu('edgeMenu')
      !menu.add('CALLBACK', 'Current Edge',   '!this.selectEdge(!this.vertex)')
    !this.defineEdge.setPopup(!this.edgeMenu)

     -- Set current vertex to EDGE
    !menu = !this.newMenu('pointMenu')
      !menu.add('CALLBACK', 'Current Point',  '!this.selectVertex(!this.vertex)')
    !this.definePoint.setPopup(!this.pointMenu)

    -- Angle Measure
    !menu = !this.newMenu('angleMenu')
      !menu.add('CALLBACK', 'Angle between three points', '!this.measureAngle(')
      !menu.add('CALLBACK', 'Angle between two lines',    '!this.measureAngle(')
    !this.groupAngle.setPopup(!this.angleMenu)

    -- Distance
    !menu = !this.newMenu('distanceMenu')
      !menu.add('CALLBACK', 'Measure',                    '!this.measureDistance(')
      !menu.add('CALLBACK', 'Measure Shortest',           '!this.measureDistance(')
    !this.distance.setPopup(!this.distanceMenu)

    -- Distance
    !menu = !this.newMenu('offsetMenu')
      !menu.add('CALLBACK', 'Measure',                    '!this.measureOffset(')
      !menu.add('CALLBACK', 'Measure Shortest',           '!this.measureOffset(')
    !this.groupDistance.setPopup(!this.offsetMenu)

  -- Link xy position
  !this.xyPosition.linkInput('!!dbeLoopEdit.xyPosition',!this.x, !this.y)
  !this.xyPosition.linkLock('!!dbeLoopEdit.xyPosition',!this.xLock, !this.yLock)

  !this.xyPosition.setAction('!!dbeLoopEdit.position()')

  -- Set keyboard focus
  !this.keyboardFocus = !this.x

  -- Default settings
  !this.x.val              = 0
  !this.y.val              = 0
  !this.distance.val       = 0
  !this.groupAngle.val     = 0
  !this.groupDistance.val  = 0
  !this.sequence.val       = 0

  -- EDG Description used for secondary packets
  !this.edgDescription     = 'LOOPEDIT'

  -- Mode information
  !this.mode               = 'POSITION'

  -- Set default settings
  !this.freeRotation       = false
  !this.tagEdges           = false
  !this.dispAxes           = true
  !this.settingMenu.select('Free rotate',       !this.freeRotation)
  !this.settingMenu.select('Tag edges',         !this.tagEdges)
  !this.settingMenu.select('Display axes',      !this.dispAxes)
  !this.settingMenu.select('Confirm',           true)
  !this.settingMenu.select('Confirm on delete', true)

  -- Icon definition
  !this.remove.addPixmap(!!pml.getPathName('deletece16.png'))

  !this.defineGroup.addPixmap(!!pml.getPathName('definegroup16.png'))
  !this.defineWhole.addPixmap(!!pml.getPathName('definewhole16.png'))
  !this.defineEdge.addPixmap(!!pml.getPathName('defineline16.png'))
  !this.definePoint.addPixmap(!!pml.getPathName('definepoint16.png'))

  !this.groupLeft.addPixmap(!!pml.getPathName('grouprotateleft16.png'))
  !this.groupRight.addPixmap(!!pml.getPathName('grouprotateright16.png'))

  !this.groupExpand.addPixmap(!!pml.getPathName('groupexpand16.png'))
  !this.groupContract.addPixmap(!!pml.getPathName('groupcontract16.png'))


  !this.mirror.addPixmap(!!pml.getPathName('mirror16.png'))
  !this.groupReverse.addPixmap(!!pml.getPathName('groupreverse16.png'))
  !this.groupShiftLeft.addPixmap(!!pml.getPathName('groupshiftleft16.png'))
  !this.groupShiftRight.addPixmap(!!pml.getPathName('groupshiftright16.png'))
  !this.groupInsert.addPixmap(!!pml.getPathName('groupinsert16.png'))
  !this.createPoints.addPixmap(!!pml.getPathName('definepoints16.png'))

  !this.pick.addPixmap(!!pml.getPathName('navigate16.png'))
  !this.previous.addPixmap(!!pml.getPathName('downarrow7x6.png'))
  !this.next.addPixmap(!!pml.getPathName('uparrow7x6.png'))

  !this.aidNext.addPixmap(!!pml.getPathName('uparrow7x6.png'))
  !this.aidPrevious.addPixmap(!!pml.getPathName('downarrow7x6.png'))

  !this.extendStart.addPixmap(!!pml.getPathName('extendstart16.png'))
  !this.extendEnd.addPixmap(!!pml.getPathName('extendend16.png'))
  !this.parallel.addPixmap(!!pml.getPathName('parallel16.png'))

  !this.cirExplicit.addPixmap(!!pml.getPathName('explicitarc16.png'))

  -- Allocate Aid Number for form
  !this.aidAxes   = !!aidNumbers.add('Edit Loop')
  !this.aidNumber = !!aidNumbers.add('Edit loop')
  !this.aidGroup  = !!aidNumbers.add('Edit Loop')
  !this.aidTag    = !!aidNumbers.add('Edit Loop')
  !this.aidNew    = !!aidNumbers.add('Edit Loop')

  -- Set the cancel call
  !this.cancelCall = '!this.close(TRUE)'

  --undo
  !this.loopUndo.undoAction('!!dbeLoopEdit.tidy()')
  !this.loopUndo.redoAction('!!dbeLoopEdit.tidy()')
  !this.loopUndo.description('Loop Vertex Editor')

endmethod
-- End of method definition for .dbeLoopEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

 -- Define Aid Axes
-- !gphAxes = object GPHAXES(!this.plane.position, !this.plane.orientation)
-- !!aidNumbers.replace(!this.aidAxes, !gphAxes)
  unusedX = 1mm
endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      displayAxes
--
-- Description: toggle the aid graphics axes on/off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayAxes()
  !this.dispAxes= !this.dispAxes.not()
  if (!this.dispAxes) then
    !gphAxes               = object GPHAXES(!this.extrusion)
    !gphAxes.draw(!this.aidAxes, !this.dispAxes)
  else
    !!aidNumbers.hide(!this.aidAxes)
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed loop
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       "Loop" to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop can be modified
--
------------------------------------------------------------------------
define method .setup(!element is DBREF) is BOOLEAN

  -- Set generic extrusion
  !extrusion = object DBEGEXTRUSION(!element)

  -- Not at a extrusion element
  if(!extrusion.unset()) then
    !!alert.warning('Element can not contain a loop.')

    return FALSE
  -- No loop defined
  elseif (!extrusion.loop.unset()) then
    !!alert.warning('Element does not contain a loop definition.')

    return FALSE
  endif

  -- Check access to element
  if(!!dbRefUpdate(!extrusion.extrusion).not()) then
    !!alert.warning(!!error.text)

    return false
  endif

  -- Tidy previous definitions
  !this.tidy()

  -- Current extrusion element
  !this.extrusion        = !extrusion.extrusion
  !this.genericExtrusion = !extrusion
  !this.genericExtrusion.aidSphereSize = 100mm
  !this.genericExtrusion.aidTranslucency = 60

  -- Define reference plane
  !this.plane            = !extrusion.plane

  -- Name of extrusion being modified
  !this.loop             = !extrusion.loop
  !this.polygon          = !extrusion.polygon
  !this.ceElement.val    = !this.extrusion.flnn
  !this.group            = object DBELOOPGROUP()

  -- Draw Axes
  !gphAxes               = object GPHAXES(!this.extrusion)
  !this.settingMenu.select('Display axes',      !this.dispAxes)
  !gphAxes.draw(!this.aidAxes, !this.dispAxes)
  if (!this.dispAxes eq false) then
  	!!aidNumbers.hide(!this.aidAxes)
  endif
  !this.calcAidSizes(false, 0)
  !this.aidSize.val = !this.aidVertexSize

  -- Set U, V or X, Y
  if (!!coords.isxyz() ) then
    if(!gphAxes.xyz ) then
      !this.x.tag = 'U'
      !this.y.tag = 'V'
    else
      !this.x.tag = 'X'
      !this.y.tag = 'Y'
    endif
  else
    !this.x.tag = 'X'
    !this.y.tag = 'Y'
  endif


  -- Select vertex
  if (!this.genericExtrusion.loop.members.size() eq 0) then
    !this.select(-1)
    !this.editButtonMode = 'CREATE'
    !this.setMode('CREATE', 'POINT')

    !this.setEditButtonState()
  else
    !this.select(1)
    !this.editButtonMode = 'POINT'
    !this.setEditButtonState()

    -- Tag
    !this.boundary()
    !this.tagVertex()

    -- Set default mode
    !this.setMode('MODIFY', 'POINT')
  endif

  -- Return
  return true


endmethod
-- End of method definition for .setup(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      calcAidSizes
--
-- Description: calculate the sizes to be used for the aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calcAidSizes(!override is BOOLEAN, !delta is REAL)
  if (!override) then
    if (!delta eq 0) then
  	  --take value directly from number	
  	  if (!this.aidSize.val le 0) then
  	  	!this.aidSize.val = 1mm
  	  endif
  	  !this.aidVertexSize = !this.aidSize.val
    elseif (!delta eq 1) then
    	-- increment blob size then copy it
  	  !this.aidSize.val = !this.aidSize.val + 5mm
   	  !this.aidVertexSize = !this.aidSize.val
    else
      if ((!this.aidSize.val - 5mm ) gt 0) then
     	  !this.aidSize.val = !this.aidSize.val - 5mm
      endif
   	  !this.aidVertexSize = !this.aidSize.val
  	
    endif
    !this.aidOriginSize = !this.aidVertexSize * 1.2	
    !this.aidCircleSize = !this.aidVertexSize * 1.25
    !this.genericExtrusion.aidSphereSize = !this.aidVertexSize
    if (!this.group.vertices.size() gt 0) then
      !this.group.draw(!this.aidGroup)
    endif

  else
  	--attempt to pick a reasonable size based on the edge lengths of the extrusion
    !size = !this.genericExtrusion.loop.members.size()
    if (!size le 1) then
      --just use defaults
      !this.aidVertexSize = 100mm
    else
    	--find the min distance of any vertex from the first vertex
  	  !minDist = 1000mm
      !start           = !this.genericExtrusion.polygon.plane.threeDPosition(!this.genericExtrusion.polygon.positions.first())
      do !i from 2 to !size
        !next = !this.genericExtrusion.polygon.plane.threeDPosition(!this.genericExtrusion.polygon.positions[!i])
        !dist = !start.distance(!next)
        handle any
        elsehandle none
	        if (!dist lt !minDist) then
	        	!minDist = !dist
	        endif
        endhandle
      enddo
      !this.aidVertexSize = !minDist * 0.1
    endif
    !this.aidOriginSize = !this.aidVertexSize * 1.2	
    !this.aidCircleSize = !this.aidVertexSize * 1.25

    !this.genericExtrusion.aidSphereSize = !this.aidVertexSize	
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Setup form for editing a loop definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       "Loop" to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!element is DBREF)

  -- Initialise Variables

  -- Setup form
  if(!this.setup(!element)) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()
    !packet.definePosition('Modify vertex')
    !packet.action         = '!!dbeLoopEdit.position(!this.return[1])'
    !packet.close          = '!!dbeLoopEdit.tidy()'
    !packet.key            = 'loopDefinition'
    !packet.description    = 'Loop Definition'
    !packet.form           = !!dbeLoopEdit
    !packet.priority       = 0
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .edit(DBREF)

------------------------------------------------------------------------
--
-- Method:      close(BOOLEAN)
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close(!closedFromX is BOOLEAN)

  -- Check to see if there is a volume for this extrusion
if(!closedFromX.not() and !this.extrusion.hardtype.upcase().neq('NXTR') and !this.extrusion.hardtype.upcase().neq('BPOPEN')) then
  !volume = !this.extrusion.gvolume
  handle any
    !volume = 0
  endhandle
  if (!volume le 0) then
    if (!!alert.confirm('DB element has no volume! Are you sure you want to close this form?').upcase() eq 'NO') then
      return
    endif
  endif
endif
  -- Remove any EDG state for form
  !!edgCntrl.remove('Loop Definition')
  !!edgCntrl.remove('LOOPEDIT')

  -- Position Link unlock all
  !this.xyPosition.unlockAll()

  -- Tidy graphics
  !this.tidy()

  -- Hide the form
  !this.hide()

endmethod
-- End of method definition for .close(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()

  -- Remove
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)
  !!aidNumbers.hide(!this.aidGroup)
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidNew)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setMode
--
-- Description: Set mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode      : MODIFY - Modify position
--                                       CREATE - Create at position
--                                       ORIGIN - Redefine origin
--
--    2   R      STRING      Mode type : GROUP  - Acting on group
--                                       EDGE   - Acting on "vertex" edge
--                                       POINT  - Acting on current vertex
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMode(!mode is STRING, !modeType is STRING)

  -- Initialise Variables

  -- Set Mode
  !this.mode     = !mode
  !this.modeType = !modeType

  -- Grey in/out relevant gadgets
  !this.setGadgets()

endmethod
-- End of method definition for .setMode(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      setGadgets
--
-- Description: Update gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadgets()

  -- Initialise Variables
  !dText = ARRAY()
  !rText = ARRAY()
  -- Point mode
  if(!this.modeType eq 'POINT') then

    -- Grey out group commands
    !this.groupReverse.active    = false
    !this.groupShiftLeft.active  = false
    !this.groupShiftRight.active = false
    !this.groupDistance.active   = false
    !this.groupExpand.active     = false
    !this.groupContract.active   = false
    !this.groupInsert.active     = false

    -- Edge Specific
    !this.extendStart.active     = false
    !this.extendEnd.active       = false
    !this.parallel.active        = false

    -- Radius/Length
    !this.distance.tag           = 'Radius'
    !this.distance.active        = true

    -- Rotate
    !this.groupAngle.active      = false
    !this.groupLeft.active       = false
    !this.groupRight.active      = false

    -- Populate Group position type
    !this.positionFrame.tag      = '  Vertex  '
    !this.navigateFrame.tag      = 'Vertex'
    !dText.append('Position')
    !rText.append('POSITION')
    !this.positionType.dText     = !dText
    !this.positionType.rText     = !rText
    !this.positionType.active    = false

  -- Point mode
  elseif (!this.modeType eq 'EDGE') then

    -- Grey out group commands
    !this.groupReverse.active    = false
    !this.groupShiftLeft.active  = false
    !this.groupShiftRight.active = false
    !this.groupDistance.active   = false
    !this.groupExpand.active     = false
    !this.groupContract.active   = false
    !this.groupInsert.active     = false

    -- Edge Specific
    !this.extendStart.active     = true
    !this.extendEnd.active       = true
    !this.parallel.active        = true

    -- Radius/Length
    !this.distance.tag           = 'Length'
    !this.distance.active        = true

    -- Rotate
    !this.groupAngle.active      = true
    !this.groupLeft.active       = true
    !this.groupRight.active      = true

    -- Populate Group position type
    !this.positionFrame.tag      = '  Edge  '
    !this.navigateFrame.tag      = ' Edge '
    !dText.append('Start')
    !rText.append('START')
    !dText.append('End')
    !rText.append('END')
    !dText.append('Aligned')
    !rText.append('PARALLEL')
    !dText.append('Extend Start')
    !rText.append('EXTEND START')
    !dText.append('Extend End')
    !rText.append('EXTEND END')
    !this.positionType.dText     = !dText
    !this.positionType.rText     = !rText
    !this.positionType.active    = true

  -- Group based mode
  else

    -- Grey in group commands
    !this.groupReverse.active    = true
    !this.groupShiftLeft.active  = true
    !this.groupShiftRight.active = true
    !this.groupDistance.active   = true
    !this.groupExpand.active     = true
    !this.groupContract.active   = true
    !this.groupInsert.active     = true

    -- Edge Specific
    !this.extendStart.active     = false
    !this.extendEnd.active       = false
    !this.parallel.active        = false

     -- Radius/Length
    !this.distance.tag           = ''
    !this.distance.active        = false

    -- Rotate
    !this.groupAngle.active      = true
    !this.groupLeft.active       = true
    !this.groupRight.active      = true

    -- Populate Group position type
    !this.positionFrame.tag      = '  Group  '
    !this.navigateFrame.tag      = 'Vertex'
    !dText.append('Position')
    !rText.append('POSITION')
    !dText.append('Origin')
    !rText.append('ORIGIN')
    !this.positionType.dText     = !dText
    !this.positionType.rText     = !rText
    !this.positionType.active    = true

  endif


  -- Mode specifics
  if(!this.mode eq 'CREATE') then
    !this.actionFrame.tag = 'Create'
    !this.mirror.active   = false
    !this.editButtonMode = !this.mode
    -- Accept button
    !this.accept.tag      = 'Create'
    !this.accept.callback = '!this.createVertex()'

  -- Create items
  elseif (!this.mode eq 'MODIFY') then
    !this.actionFrame.tag = 'Modify'
    !this.mirror.active   = true

    -- Accept button
    !this.accept.tag      = 'Modify'

    if(!this.modeType eq 'GROUP') then
      !this.accept.callback = '!this.groupReplace()'
    elseif (!this.modeType eq 'EDGE') then
      !this.accept.callback = '!this.positionLine()'

    elseif (!this.modeType eq 'POINT') then
      !this.accept.callback = '!this.modifyVertex()'
    endif

  endif
  !this.accept.setUndoable(!this.loopUndo)
  --mode selection button states
  !this.setEditButtonState()
  -- Accept Button state
  !this.confirm()

endmethod
-- End of method definition for .setGadgets()

------------------------------------------------------------------------
--
-- Method:      confirm
--
-- Description: Set confirm status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirm()

  -- If confirm mode or we are creating a point, then un-grey the accept button
  if(!this.settingMenu.selected('Confirm') or (!this.mode eq 'CREATE' and !this.modeType eq 'POINT') or (!this.mode eq 'MODIFY' and !this.modeType eq 'GROUP')) then
    !this.accept.active = true

  -- Grey out accept button
  else
    !this.accept.active = false
  endif

endmethod
-- End of method definition for .confirm()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select a vertex (depending on the mode we are in will determine if we also select it form movement)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Sequence
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!newSequence is REAL)

  !vNum = !newSequence
  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNew)

  if (!newSequence eq -1) then
  	!!aidNumbers.hide(!this.aidTag)
   	!!aidNumbers.hide(!this.aidGroup)
   	!!aidNumbers.hide(!this.aidNumber)
  	
  	return
  endif
  if (!newSequence eq 0) then
    !vNum = !this.genericExtrusion.loop.members.size()
  endif
  !vertex       = !this.genericExtrusion.point(!vNum)
  !vertexNumber = !vertex.sequence
  !sequence     = !vertexNumber

  -- Modify mode
  if(!this.mode eq 'MODIFY') then

    -- Move to vertex
    if(!this.modeType eq 'POINT') then

      -- If sequence =< the use last
      !this.vertex       = !vertex
      !this.vertexNumber = !vertexNumber
      !this.sequence.val = !sequence

      -- Tag vertex
      !this.tagVertex()

      -- Setup position gadgets
      !this.positionType()

    -- Move to edge
    elseif(!this.modeType eq 'EDGE') then

      -- Get distance
      !edgeLine = !this.genericExtrusion.edge(!vertexNumber)
      !distance = !edgeLine.startPosition.distance(!edgeLine.endPosition)
      if(!distance eq 0 or UNSET(!distance)) then
        !!alert.warning('Edge [' & !sequence & '] is zero length, unable to handle it as a edge.')
        return
      endif

      -- If sequence =< the use last
      !this.vertex       = !vertex
      !this.vertexNumber = !vertexNumber
      !this.sequence.val = !sequence

      -- Set data
      !this.edge         = !this.vertex
      !this.edgeLine     = !edgeLine
      !this.distance.val = !distance

      -- Tag vertex
      !this.tagEdge()

      -- Setup position gadgets
      !this.positionType()
    elseif (!this.modeType eq 'GROUP') then

      -- If sequence =< the use last
      !this.vertex       = !vertex
      !this.vertexNumber = !vertexNumber
      !this.sequence.val = !sequence

      -- Tag vertex
      !this.tagVertex()

    endif


  -- Create
  else

    -- If sequence =< the use last
    !this.vertex       = !vertex
    !this.vertexNumber = !vertexNumber
    !this.sequence.val = !sequence

    -- Create Vertex
    if(!this.modeType eq 'POINT') then
      !this.distance.val = !this.vertex.fRadius
      !this.xyPosition.xyPosition(!this.polygon.positions[!this.vertexNumber], false, false)

      -- Tag new vertex position
      !this.tagNewVertex()

      -- Tag vertex
      !this.tagVertex()
      !this.positionType()
    endif
  endif

endmethod
-- End of method definition for .select(REAL)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select a vertex by picking it
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Initialise Variables
  if(!this.modeType eq 'EDGE') then
    !this.genericExtrusion.selectEdge('!!dbeLoopEdit.select(!return.sequence)', 'LOOPEDIT')
  else
    !this.genericExtrusion.selectPoint('!!dbeLoopEdit.select(!return.sequence)', 'LOOPEDIT')
  endif

endmethod
-- End of method definition for .select()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select a vertex or vertices from the graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Selection type : ALL    - Select whole extrusion as a group
--                                            GROUP  - Select vertices in graphic polygon
--                                            EDGE   - Select edge
--                                            POINT  - Select vertex
--                                            CREATE - Create vertex
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!option is STRING)

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNew)
  !!aidNumbers.hide(!this.aidGroup)

  -- Select a group
  if(!option eq 'GROUP') then
    !this.genericExtrusion.selectPoints('!!dbeLoopEdit.selectGroup(!return)', 'LOOPEDIT')
    !this.editButtonMode = 'GROUP'

  -- Select all panel
  elseif (!option eq 'ALL') then

    !!edgCntrl.remove('LOOPEDIT')
    !this.group.dbeLoopGroup(!this.loop)
    !this.group.draw(!this.aidGroup)

    -- Set mode to group modify
    !this.setMode('MODIFY', 'GROUP')

    !this.positionType()

    -- Tag vertex
    !this.tagVertex()
    !this.editButtonMode = 'ALL'

  -- Select an edge
  elseif (!option eq 'EDGE') then
     !this.genericExtrusion.selectEdge('!!dbeLoopEdit.selectEdge(!return)', 'LOOPEDIT')
    !this.setMode('MODIFY', 'EDGE')
    !this.editButtonMode = 'EDGE'

  -- Select a vertex
  elseif (!option eq 'POINT') then
    !this.genericExtrusion.selectPoint('!!dbeLoopEdit.selectVertex(!return)', 'LOOPEDIT')
    !this.setMode('MODIFY', 'POINT')
    !this.editButtonMode = 'POINT'

  -- create a vertex
  elseif (!option eq 'CREATE') then
    !this.tagNewVertex()
    if (!!edgCntrl.active('LOOPEDIT')) then
    	!!edgCntrl.escape()
    endif
    !this.createPoints()
    !this.editButtonMode = 'CREATE'
    !this.setEditButtonState()
    return

  endif
  !this.select(!this.vertexNumber)

  !this.setEditButtonState()

endmethod
-- End of method definition for .select(STRING)

------------------------------------------------------------------------
--
-- Method:      setEditButtonState
--
-- Description: set the pixmaps of the edit mode buttons appropriately
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setEditButtonState()
  --set the mode button states

  --if there are no vertices defined only possible operation is to create new ones
  if (!this.genericExtrusion.loop.members.size() eq 0) then
    if (!this.editButtonMode ne  'CREATE') then
      !this.editButtonMode = 'CREATE'
      !this.setMode('CREATE', 'POINT')
    endif
    !this.defineWhole.active = FALSE
    !this.defineGroup.active = FALSE
    !this.defineEdge.active = FALSE
    !this.definePoint.active = FALSE
    !this.createPoints.active =TRUE

    --also going to inactivate some of the other gadgets on the form
    !this.pick.active = FALSE
    !this.sequence.active = FALSE
    !this.next.active = FALSE
    !this.previous.active = FALSE
    !this.sequence.val.unset()

  elseif (!this.genericExtrusion.loop.members.size() eq 1) then
  -- cannot perform edge picking if only 1 point is defined
    if (!this.editButtonMode eq 'EDGE') then
      !this.editButtonMode = 'CREATE'
      !this.setMode('CREATE', 'POINT')
    endif
    !this.defineWhole.active = FALSE
    !this.defineGroup.active = FALSE
    !this.defineEdge.active = FALSE
    !this.definePoint.active = TRUE
    !this.createPoints.active =TRUE


    !this.pick.active = FALSE
    !this.sequence.active = FALSE
    !this.sequence.val = 1
    !this.next.active = FALSE
    !this.previous.active = FALSE

  else
  	--everything can be active
    !this.defineWhole.active = TRUE
    !this.defineGroup.active = TRUE
    !this.defineEdge.active = TRUE
    !this.definePoint.active = TRUE
    !this.createPoints.active =TRUE

    !this.pick.active = TRUE
    !this.sequence.active = TRUE
    !this.next.active = TRUE
    !this.previous.active = TRUE

	endif
  !this.defineWhole.val = (!this.editButtonMode eq 'ALL')
  !this.defineGroup.val = (!this.editButtonMode eq 'GROUP')
  !this.defineEdge.val = (!this.editButtonMode eq 'EDGE')
  !this.definePoint.val = (!this.editButtonMode eq 'POINT')
  !this.createPoints.val = (!this.editButtonMode eq 'CREATE')
  return
endmethod
------------------------------------------------------------------------
--
-- Method:      selectGroup
--
-- Description: Define group using passed polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOPGROUP Group definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectGroup(!group is DBELOOPGROUP)

  -- Initialise Variables

  -- If there is only one vertex, then define a point
  if(!group.vertices.size() eq 1) then
    !this.selectVertex(!group.vertices[1])

   -- Define Group
  !this.group = !group

  -- Tag group
  !this.group.draw(!this.aidGroup)

    return
  endif

   -- Define Group
  !this.group = !group

  -- Tag group
  !this.group.draw(!this.aidGroup)

  -- Set mode to group modify
  !this.setMode('MODIFY', 'GROUP')
  !this.positionType()

  -- Tag vertex
  !this.tagVertex()

endmethod
-- End of method definition for .selectGroup(DBELOOPGROUP)

------------------------------------------------------------------------
--
-- Method:      selectEdge
--
-- Description: Selects edge from passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Vertex at beginning of edge
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectEdge(!edge is DBREF)
  if (!edge.unset()) then
    return
  endif

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidGroup)
  !this.group = object DBELOOPGROUP()

  -- Set mode to group modify
  !this.setMode('MODIFY', 'EDGE')
  -- Navigate to point
  !this.select(!edge.sequence)
endmethod
-- End of method definition for .selectEdge(DBREF)

------------------------------------------------------------------------
--
-- Method:      selectVertex
--
-- Description: Selects point from passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Vertex
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectVertex(!vertex is DBREF)

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidGroup)

  !this.group = object DBELOOPGROUP()

  -- Set mode to group modify
  !this.setMode('MODIFY', 'POINT')

  -- Navigate to point
  !this.select(!vertex.sequence)

endmethod
-- End of method definition for .selectVertex(DBREF)

------------------------------------------------------------------------
--
-- Method:      createPoints
--
-- Description: Create points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPoints()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidGroup)

  !this.group = object DBELOOPGROUP()

  -- Set mode to group modify
  !this.setMode('CREATE', 'POINT')

  -- Set position
  !this.positionType()

endmethod
-- End of method definition for .createPoints()

------------------------------------------------------------------------
--
-- Method:      tagVertex
--
-- Description: Tag current vertex
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]

------------------------------------------------------------------------

define method .tagVertex()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidTag)

  -- Get position
  !start  = !this.plane.threeDPosition(object XYPOSITION(!this.vertex.position.east, !this.vertex.position.north))

  -- Get next vertex
  if(!this.vertex.sequence eq !this.loop.members.size()) then
    !next = !this.loop.members[1]
  else
    !next = !this.loop.members[!this.vertex.sequence + 1]
  endif
  !end    = !this.plane.threeDPosition(object XYPOSITION(!next.position.east, !next.position.north))

  -- Arrow size
  !size      = !start.distance(!end) * 0.25
  !size      = !size.max(200mm)
  !direction = !start.direction(!end)
  handle any
    !direction = object DIRECTION()
  endhandle

  -- Translate XY position into model co-ordinates
  AID TEXT  NUMBER $!<this.aidTag> '<$!this.vertex.sequence>' AT $!<start>
  if (!direction.unset()) then
    AID CYLINDER NUMBER $!<this.aidTag> ORI $!<this.plane.orientation> AT $!<start> DIAMETER $!<this.aidCircleSize> HEIGHT 0
  else
    AID ARROW NUMBER $!<this.aidTag> AT $!<start> DIRECTION $!<direction> HEIGHT $!<size>
  endif
endmethod
-- End of method definition for .tagVertex()

------------------------------------------------------------------------
--
-- Method:      tagEdge
--
-- Description: Tag Edge
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagEdge()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidTag)

  -- Get line definition
  !gphLine             = object GPHLINE(!this.edgeLine)
  !gphLine.detail      = true
  -- End

  if(!this.positionType.selection().match('START') gt 0) then
    !gphLine.detailType  = 'START'
  elseif(!this.positionType.selection().match('END') gt 0) then
    !gphLine.detailType  = 'END'
  else
    !gphLine.detailType  = 'BOTH'
  endif

  !gphLine.description = '[' & !this.edge.sequence & ']'
  !gphLine.draw(!this.aidGroup)

endmethod
-- End of method definition for .tagEdge()

------------------------------------------------------------------------
--
-- Method:      tagNewVertex
--
-- Description: Tag New position of vertex
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagNewVertex()

  -- Initialise Variables
  !position = !this.plane.threeDPosition(!this.xyPosition.xyPosition())
  !!aidNumbers.hide(!this.aidNew)
  AID TEXT NUMBER $!<this.aidNew> 'New vertex'   AT $!<position>

  -- Get next & previous edge

  !line = !this.genericExtrusion.edge(!this.vertexNumber)
  handle any
    return
  endhandle
  -- Draw line from start to end through new point
  AID LINE NUMBER $!<this.aidNew> $!<line.startPosition>  TO $!<position>
  AID LINE NUMBER $!<this.aidNew> $!<position>            TO  $!<line.endPosition>

endmethod
-- End of method definition for .tagNewVertex()

------------------------------------------------------------------------
--
-- Method:      tagNewPosition
--
-- Description: Tag New position of vertex
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagNewPosition()

  -- Initialise Variables
  !position = !this.plane.threeDPosition(!this.xyPosition.xyPosition())
  !!aidNumbers.hide(!this.aidNew)
  AID TEXT NUMBER $!<this.aidNew> 'New position'   AT $!<position>

  -- Get next & previous edge
  !line         = !this.genericExtrusion.edge(!this.vertexNumber)
  !previousLine = !this.genericExtrusion.edge(!this.vertexNumber - 1)

  -- Draw line from start to end through new point
  AID LINE NUMBER $!<this.aidNew> $!<previousLine.startPosition>  TO $!<position>
  AID LINE NUMBER $!<this.aidNew> $!<position>                    TO  $!<line.endPosition>

endmethod
-- End of method definition for .tagNewPosition()

------------------------------------------------------------------------
--
-- Method:      boundary
--
-- Description: Display the boundary of the pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundary()

  -- Tag edges
  !volume = !this.loop.owner.gvolume
  handle any
    !volume = 0
  endhandle

  if(!this.tagEdges or !volume eq 0) then
    !gphPolygon     = object GPHPOLYGON(!this.polygon)
    !gphPolygon.sphereSize = !this.aidVertexSize
    !gphPolygon.sphereTranslucency = 60
    !gphPolygon.tag = true
    !gphPolygon.draw(!this.aidNumber)
  else
    !!aidNumbers.hide(!this.aidNumber)
  endif

endmethod
-- End of method definition for .boundary()

------------------------------------------------------------------------
--
-- Method:      boundary
--
-- Description: Display the boundary of the pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Select string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundary(!menu is MENU, !select is STRING)

  -- Initialise Variables
  if(!select eq 'SELECT') then
    !this.tagEdges = true
  else
    !this.tagEdges = false
  endif

  !this.boundary()

endmethod
-- End of method definition for .boundary(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      updateLoop
--
-- Description: Update Loop definition of extrusion (i.e. all the polygon definitions)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLoop()

  -- Initialise Variables
  !this.polygon                  = object GMFPOLYGON(!this.loop)
  !this.genericExtrusion.polygon = !this.polygon

endmethod
-- End of method definition for .updateLoop()

------------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Setup to measure of angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureAngle(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'ANGLE BETWEEN THREE POINTS') then
    !packet.defineMeasure('angle')
    !packet.action    = '!!dbeLoopEdit.measureAngle(!this.return[1].angle())'

    -- Measure parallel
  elseif (!option eq 'ANGLE BETWEEN TWO LINES') then
    !packet.defineMeasure('lineangle')
    !packet.action    = '!!dbeLoopEdit.measureAngle(!this.return[1])'
  endif

  !packet.description = !this.edgDescription
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .measureAngle(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Update angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .measureAngle(!angle is REAL)

  !this.groupAngle.val  = !angle

endmethod
-- End of method definition for .measureAngle(REAL)

------------------------------------------------------------------------
--
-- Method:      measureDistance
--
-- Description: Measure distance/radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureDistance(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then
    !packet.defineMeasure('distance')

  -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then
    !packet.defineMeasure('shortest')
  endif

  !packet.description = !this.edgDescription
  !packet.action      = '!!dbeLoopEdit.measureDistance(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .measureDistance(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description: Write measurement to distance gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measureDistance(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distance.val = 0
  else
    !this.distance.val = !line.length()
  endif
  !this.distance()

endmethod
-- End of method definition for .measureDistance(LINE)

------------------------------------------------------------------------
--
-- Method:      measureOffset
--
-- Description: Measure distance/radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureOffset(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
  endif

  !packet.description = !this.edgDescription
  !packet.action      = '!!dbeLoopEdit.measureOffset(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .measureOffset(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measureOffset
--
-- Description: Write measurement to distance gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measureOffset(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.groupDistance.val = 0
  else
    !this.groupDistance.val = !line.length()
  endif

endmethod
-- End of method definition for .measureOffset(LINE)

--#######################################################################################################################

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove()

  -- Initialise Variables
  !reference = !!ce

  -- Delete Point
  if(!this.modeType eq 'POINT') then
   if (!this.genericExtrusion.loop.members.size() eq 0) then
             !!alert.warning('There is no vertex to delete.')
             return
   endif



   if (!this.genericExtrusion.loop.members.size() eq 1) then
      if(!!alert.confirm('OK to delete last vertex ?').boolean().not()) then
       return
      endif
      -- Delete Vertex
    !!ce = !this.vertex
    DELETE $!<this.genericExtrusion.vertexType>
    !this.select('CREATE')
    !this.setMode('CREATE','POINT')
    !this.select(-1)
    return


   endif

    -- Alert delete point
    if(!this.settingMenu.selected('Confirm on delete')) then
      if(!!alert.confirm('OK to delete vertex <' & !this.vertexNumber & '> ?').boolean().not()) then
        return
      endif
    endif

    -- Delete Vertex
    !!ce = !this.vertex
    DELETE $!<this.genericExtrusion.vertexType>

    -- Select vertex
    !this.select(!this.vertexNumber)

  -- Delete Edge
  elseif (!this.modeType eq 'EDGE') then

    -- Alert delete edge
    if(!this.settingMenu.selected('Confirm on delete')) then
      if(!!alert.confirm('OK to delete edge [' & !this.edge.sequence & '] ?').boolean().not()) then
        return
      endif
    endif

    !!ce = !this.edge
    NEXT
    handle any
      FIRST
    endhandle
    !next = !!ce
    NEXT
    handle any
      FIRST
    endhandle
    !newEdge = !!ce

    !!ce = !this.edge
    DELETE $!<this.genericExtrusion.vertexType>
    !!ce = !next
    DELETE $!<this.genericExtrusion.vertexType>
    if (!this.genericExtrusion.loop.members.size() eq 1) then
      !this.select('POINT')
      !this.setMode('MODIFY', 'POINT')
      !this.select(-1)
      !this.select(1)
      return
    elseif (!this.genericExtrusion.loop.members.size() eq 0) then
      !this.select('CREATE')
       !this.setMode('CREATE', 'POINT')
     !this.select(-1)
      return
    endif

    !this.selectEdge(!newEdge)

  -- Delete group definition
  elseif (!this.modeType eq 'GROUP') then

    -- Alert delete group
    if(!this.settingMenu.selected('Confirm on delete')) then
      if(!!alert.confirm('OK to delete points used to define group?').boolean().not()) then
        return
      endif
    endif

    do !i indices !this.group.vertices
     !!ce = !this.group.vertices[!i]
      DELETE $!<this.genericExtrusion.vertexType>
    enddo

    !!aidNumbers.hide(!this.aidGroup)
    if (!this.genericExtrusion.loop.members.size() eq 0) then
      !this.select('CREATE')
      !this.setMode('CREATE', 'POINT')
      !this.select(-1)
      return
    elseif (!this.genericExtrusion.loop.members.size() eq 1) then
      !this.select('POINT')
      !this.setMode('MODIFY', 'POINT')
      !this.select(-1)
      !this.select(1)
      return
    endif
     !this.select('POINT')
    !this.setMode('MODIFY','POINT')
    !this.select(1)
  endif

  -- Update definition
  !this.updateLoop()
  !this.boundary()

  -- Move back to reference element
  !!ce = !reference
  handle any
  endhandle

endmethod
-- End of method definition for .remove()

--#######################################################################################################################
--#######################################################################################################################

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!clockwise is BOOLEAN)

  -- Initialise Variables
  !modeType = !this.modeType

  -- Don't do anything if rotate angle is zero
  if(!this.groupAngle.val eq 0) then
    return
  endif

  -- Angle
  if(!clockwise) then
    !angle  = !this.groupAngle.val.abs() * -1
  else
    !angle  = !this.groupAngle.val.abs()
  endif

  -- Rotate group
  if(!modeType eq 'GROUP') then
    !this.group.rotate(!angle)

    -- Re-draw group
    !this.group.draw(!this.aidGroup)

  -- Rotate Edge
  elseif (!modeType eq 'EDGE') then

    -- Determine the "end" of rotation
    if(!this.positionType.selection() inset('START','EXTEND START')) then
      !plane         = object PLANE(!this.edgeLine.startPosition, !this.plane.orientation)
    else
      !plane         = object PLANE(!this.edgeLine.endPosition, !this.plane.orientation)
    endif
    !xyStart       = !plane.xyOffset(!this.edgeLine.startPosition)
    !xyEnd         = !plane.xyOffset(!this.edgeLine.endPosition)
    !plane.orientation.gamma = !plane.orientation.gamma + !angle
    !start         = !plane.threeDPosition(!xyStart)
    !end           = !plane.threeDPosition(!xyEnd)

    !this.edgeLine = object LINE(!start, !end)
    if(!this.settingMenu.selected('Confirm')) then
      !this.tagEdge()
    else
      !this.positionLine()
    endif
  endif

  -- Reset angle
  !this.groupAngle.val = !angle.abs()

endmethod
-- End of method definition for .rotate(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      offsetEdges
--
-- Description: Offset edges
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for expand, false for contract
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetEdges(!expand is BOOLEAN)

  -- Initialise Variables

  -- If the offset distance is zero, don't do anything
  if(!this.groupDistance.val eq 0) then
    return
  endif

  if (!this.group.vertices.size() le 1) then
    return
  endif
  if(!this.genericExtrusion.findCoincident().empty().not()) then
    !!alert.warning('Unable to offset edges as there are coincident points within the loop definition.')
    return
  endif

  -- Angle
  if(!expand) then
    !distance = !this.groupDistance.val.abs()
  else
    !distance = !this.groupDistance.val.abs() * -1
  endif
  !this.group.offsetEdges(!distance)

  -- Reset distance
  !this.groupDistance.val = !distance.abs()

  -- Re-draw group
  !this.group.draw(!this.aidGroup)

endmethod
-- End of method definition for .offsetEdges(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      distance
--
-- Description: Set radius/length of edge
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distance()

  -- Initialise Variables
  !reference = !!ce
  if (!this.distance.val.unset() ) then
      !this.distance.val = 0
  endif
  -- Modify
  if(!this.mode eq 'MODIFY') then

    -- Modify Point
    if(!this.modeType eq 'POINT') then

      -- If distance and radius are the same, don't do anything
      if(!this.distance.val eq !this.vertex.fRadius) then
        return
      endif

      if(!this.settingMenu.selected('Confirm').not()) then
        !!ce       = !this.vertex
        FRADIUS $!<this.distance.val>
        !!ce       = !reference

        -- Tag Edges
        !this.updateLoop()
        !this.boundary()
        !this.tagVertex()
      endif

    -- Modify Edge
    elseif (!this.modeType eq 'EDGE') then

      -- Check we haven't typed in zero length
      if(!this.distance.val eq 0) then
        !!alert.warning('You can not define an edge of zero length.')
        !this.distance.val = !this.edgeLine.length()
        return
      endif

      -- If distance and radius are the same, don't do anything
      if(!this.distance.val eq !this.edgeLine.length()) then
        return
      endif

      -- Change length, retaining start position
      if(!this.positionType.selection() eq 'START') then
        !line = !this.edgeLine.setLengthEnd(!this.distance.val)

      -- Change length retaining end
      else
        !line = !this.edgeLine.setLengthStart(!this.distance.val)
      endif

      -- Update edge
      !this.edgeLine  = !line
      if(!this.settingMenu.selected('Confirm')) then
        !this.tagEdge()
      else
        !this.positionLine()
      endif

    endif
  endif

endmethod
-- End of method definition for .distance()

------------------------------------------------------------------------
--
-- Method:      extend
--
-- Description: Extend start/end of line
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if start is to be extended
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extend(!start is BOOLEAN)

  -- Initialise Variables
  if(!start) then
    !end = 'start'
  else
    !end = 'end'
  endif

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'extend edge'
  !packet.description     = !this.edgDescription
  !packet.type            = 'extend edge'
  !packet.priority        = 3
  !packet.action          = '!!dbeLoopEdit.extend(' & !start & ',!this.return[1])'
  !packet.pickPacket.stdGraphic('Pick point ' & !end & ' is to be projected through')
  !packet.remove          = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .extend(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      extend
--
-- Description: Extend start/end of line dependent on
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if start is to be extended
--    2   R      EDGPICKDATA Picked element to extend through
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extend(!start is BOOLEAN, !pickData is EDGPICKDATA)

  -- Initialise Variables
  !positionData = !pickData.positionData()
  !line         = !this.edgeLine
  !direction    = !line.direction()
  !length       = !line.length()

  -- Point Picked
  if(!positionData.position.set()) then
    if(!start) then
      !line     = !line.extendStart(object PLANE(!positionData.position, object ORIENTATION('Z is ' & !direction)))
      !position = !line.startPosition
    else
      !line     = !line.extendEnd(object PLANE(!positionData.position, object ORIENTATION('Z is ' & !direction)))
      !position = !line.endPosition
    endif

  -- Line Picked
  elseif (!positionData.line.set()) then
    if( !line.direction().isParallel(!positionData.line.direction()) ) then
      !!alert.error('Selected lines are parallel')
      return
    endif
    !position = !line.intersection(!positionData.line)
    if(!start) then
      !line.startPosition = !position
    else
      !line.endPosition   = !position
    endif

  -- Plane Picked
  elseif (!positionData.plane.set()) then
    !position = !positionData.plane.intersection(!line)
    handle any
      !!alert.warning(!!error.text)
      return
    endhandle
    if(!start) then
      !line.startPosition = !position
    else
      !line.endPosition   = !position
    endif

  endif

  -- Update Line
  !this.edgeLine  = !line
  if(!this.settingMenu.selected('Confirm')) then
    !this.tagEdge()
  else
    !this.positionLine()
  endif

endmethod
-- End of method definition for .extend(BOOLEAN, EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      parallel
--
-- Description: Make line parallel with an other item, about start/end
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .parallel()

  -- Initialise Variables
  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'parallel edge'
  !packet.description     = !this.edgDescription
  !packet.type            = 'extend edge'
  !packet.priority        = 3
  !packet.action          = '!!dbeLoopEdit.parallel(!this.return[1])'
  !packet.pickPacket.stdGraphic('Pick line to be made parallel with')
  !packet.pickPacket.picks[1].pick.input[6] = 'EDGE'
  !packet.remove          = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .parallel()

------------------------------------------------------------------------
--
-- Method:      parallel
--
-- Description: Make edge parallel to another edge
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .parallel(!pickData is EDGPICKDATA)

  -- Initialise Variables
  !positionData = !pickData.positionData()
  !refLine      = !positionData.line

  -- Determine the "end" of rotation
  if(!this.positionType.selection() inset('START','EXTEND START')) then
    !newLine    = object GMFLINE(!this.edgeLine)
    !line       = !newLine.parallel(!refLine)
  else
    !newLine    = object GMFLINE(!this.edgeLine.reverseSense())
    !line       = !newLine.parallel(!refLine).reverseSense()
  endif

  -- Update line
  !this.edgeLine = !line
  if(!this.settingMenu.selected('Confirm')) then
    !this.tagEdge()
  else
    !this.positionLine()
  endif

endmethod
-- End of method definition for .parallel(EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Define edg for picking mirror line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror()

  -- Initialise Variables
  !packet                        = object EDGPACKET()
  !packet.key                    = 'defineLine'
  !packet.type                   = 'construct'
  !packet.priority               = 2
  !packet.remove                 = true
  !packet.description            = !this.edgDescription
  !packet.action                 = '!!dbeLoopEdit.mirror(!this.return[1].line)'

  !packet.pickPacket.key         = 'direction'
  !packet.pickPacket.description = 'Pick mirror line'
  !packet.pickPacket.prompt      = 'Pick line to mirror about'
  !packet.pickPacket.action      = '!this.return[1].positionData()'
  !packet.pickPacket.picks.clear()
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdGraphics('')

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .mirror()

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror about passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror(!line is LINE)

  -- Initialise Variables
  if( !line.unset() ) then
    !!alert.error('Please pick a mirror line')
    return
  endif

  -- Only mirror on modify
  if(!this.mode eq 'MODIFY') then

    -- Map line onto current plane
    !newLine = !line.projected(!this.plane)

    -- Mirror group
    if(!this.modeType eq 'GROUP') then
      !this.group.mirror(!newLine)
      !this.group.draw(!this.aidGroup)

    -- Mirror line
    elseif (!this.modeType eq 'EDGE') then
      !plane             = object PLANE(!newLine.startPosition, object ORIENTATION('Y is ' & !newLine.direction() & ' and Z is ' & !this.plane.orientation.zDir()))
      !xyStart           = !plane.xyOffset(!this.edgeLine.startPosition)
      !xyEnd             = !plane.xyOffset(!this.edgeLine.endPosition)
      !plane.orientation = object ORIENTATION('Y is ' & !plane.orientation.yDir() & ' and Z is ' & !plane.orientation.zDir().opposite())
      !this.edgeLine     = object LINE(!plane.threeDPosition(!xyStart), !plane.threeDPosition(!xyEnd))
      !this.positionType()

      -- Update Line
      if(!this.settingMenu.selected('Confirm')) then
        !this.tagEdge()
      else
        !this.positionLine()
      endif

    -- Mirror point
    elseif (!this.modeType eq 'POINT') then
      !plane             = object PLANE(!newLine.startPosition, object ORIENTATION('Y is ' & !newLine.direction() & ' and Z is ' & !this.plane.orientation.zDir()))
      !xyPosition        = !plane.xyOffset(!this.vertex.position)
      !plane.orientation = object ORIENTATION('Y is ' & !plane.orientation.yDir() & ' and Z is ' & !plane.orientation.zDir().opposite())
      !xyPosition        = !this.plane.xyOffset(!plane.threeDPosition(!xyPosition))

      -- Update input gadgets
      !this.xyPosition.xyPosition(!xyPosition)

    endif

  endif


endmethod
-- End of method definition for .mirror(LINE)

------------------------------------------------------------------------
--
-- Method:      reverse
--
-- Description: Reverse the order of the group
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reverse()

  -- Initialise Variables
  !this.group.reverse()
  !this.group.draw(!this.aidGroup)

  !this.positionType()

endmethod
-- End of method definition for .reverse()

-------------------------------------------------------------------------
--
-- Method:      groupShift
--
-- Description: Move groups definition clock-wise/anti-clock-wise
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True, move aclock-wise
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .groupShift(!clockwise is BOOLEAN)

  -- Initialise Variables
  !this.group.move(!clockwise)

   -- Re-draw group
  !this.group.draw(!this.aidGroup)

  !this.positionType()

endmethod
-- End of method definition for .groupShift(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      groupInsert
--
-- Description: Insert group after current vertex
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .groupInsert()

  -- Initialise Variables
  !this.group.insert(!this.vertex)

  -- Update loop
  !this.updateLoop()

  -- Re-assign current vertex to the one after the last created in the insert method
  !this.select(!this.group.vertices.last().sequence + 1)

   -- Re-draw group
  !this.group.draw(!this.aidGroup)

  -- Tag
  !this.boundary()

endmethod
-- End of method definition for .groupInsert()

------------------------------------------------------------------------
--
-- Method:      groupReplace
--
-- Description: Replace current group vertices at new positions
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .groupReplace()

  -- Initialise Variables
  !this.group.replace()

   -- Re-draw group
  !this.group.draw(!this.aidGroup)

  -- Tag
  !this.updateLoop()
  !this.boundary()
  !this.tagVertex()

endmethod
-- End of method definition for .groupReplace()

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Select positioning mode and set prompt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Initialise Variables
  !positionType = !this.positionType.selection()

  -- Modify Mode
  if(!this.mode eq 'MODIFY') then

    -- Edge Type Mode
    if(!this.modeType eq 'EDGE') then

      !xyPosition = !this.plane.xyOffset(!this.edgeLine.startPosition)

      -- Modify start position
      if(!positionType eq 'START') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Modify edge start position')
        !xyPosition = !this.plane.xyOffset(!this.edgeLine.startPosition)

      -- Modify End position
      elseif (!positionType eq 'END') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Modify edge end position')
        !xyPosition = !this.plane.xyOffset(!this.edgeLine.endPosition)

      -- Modify End position
      elseif (!positionType eq 'PARALLEL') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Define parallel position point')

      -- Modify End position
      elseif (!positionType eq 'EXTEND START') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Extend start through derived position')
        !xyPosition = !this.plane.xyOffset(!this.edgeLine.startPosition)

      -- Modify End position
      elseif (!positionType eq 'EXTEND END') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Extend end through derived position')
        !xyPosition = !this.plane.xyOffset(!this.edgeLine.endPosition)

      endif
      !this.distance.val = !this.edgeLine.length()
      !this.xyPosition.xyPosition(!xyPosition, false, true)
      !this.tagEdge()

    -- Group Type Mode
    elseif (!this.modeType eq 'GROUP') then

      -- Define origin position
      if(!positionType eq 'ORIGIN') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Define group origin')

      -- Define position of group
      elseif (!positionType eq 'POSITION') then
        !!edgCntrl.setStackPrompt('Loop Definition', 'Define group position')
      endif
      !this.xyPosition.xyPosition(!this.group.origin, false, true)

    -- Point Type Mode
    elseif (!this.modeType eq 'POINT') then
      !!edgCntrl.setStackPrompt('Loop Definition', 'Modify vertex position')
      !this.distance.val = !this.vertex.fRadius
      !xyPosition        = !this.plane.xyOffset(!this.vertex.position)
      !this.xyPosition.xyPosition(!xyPosition, false, true)
    endif

  -- Create Mode
  else

    -- Point Mode Type
    if(!this.modeType eq 'POINT') then
      !!edgCntrl.setStackPrompt('Loop Definition', 'Create new vertex')
      !this.distance.val = 0
    endif

  endif

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position()

  -- Initialise Variables

  -- Initialise Variables
  !reference = !!ce

  -- Modify point mode
  if(!this.mode eq 'MODIFY') then

    -- Position Type
    !positionType = !this.positionType.selection()
    !xyPosition   = !this.xyPosition.xyPosition()

    -- Position point
    if(!this.modeType eq 'POINT') then
      if(!this.settingMenu.selected('Confirm')) then
        !this.tagNewPosition()
      else
        !this.modifyVertex()
      endif

    -- Position Edge
    elseif(!this.modeType eq 'EDGE') then

      -- Construct Line of edge
      !line         = !this.edgeLine
      !direction    = !line.direction()
      !length       = !line.length()

      -- Get position
      !position     = !this.plane.threeDPosition(!xyPosition)

      -- Move line parallel through the given position
      if(!positionType eq 'PARALLEL') then
        !line      = !line.parallel(!position)

      -- Move start to position
      elseif (!positionType eq 'START') then
        !line = object LINE(!position, !position.offset(!direction, !length))

      -- Move end to position
      elseif (!positionType eq 'END') then
        !line = object LINE(!position, !position.offset(!direction.opposite(), !length))
        !line = !line.reverseSense()

      -- Extend start through position
      elseif (!positionType eq 'EXTEND START') then
        !line = !line.extendStart(object PLANE(!position, object ORIENTATION('Z is ' & !direction)))

      -- Extend start through position
      elseif (!positionType eq 'EXTEND END') then
        !line = !line.extendEnd(object PLANE(!position, object ORIENTATION('Z is ' & !direction)))

      endif

      !this.edgeLine     = !line
      !this.distance.val = !line.length()
      if(!this.settingMenu.selected('Confirm')) then
        !this.tagEdge()
      else
        !this.positionLine()
      endif

    -- Position Edge
    elseif(!this.modeType eq 'GROUP') then

      -- Position Origin
      if(!positionType eq 'ORIGIN') then
       !this.group.origin(!xyPosition)

      -- Position group
      elseif (!positionType eq 'POSITION') then
        !this.group.position(!xyPosition)

      endif
      !this.group.draw(!this.aidGroup)

    endif

    !!ce       = !reference

  -- Create vertices for creating a vertex
  elseif(!this.mode eq 'CREATE') then

    -- Create a new point
    if(!this.modeType eq 'POINT') then
      !this.tagNewVertex()
    endif

  endif

endmethod
-- End of method definition for .position()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Picked position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA    Position Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!positionData is EDGPOSITIONDATA)

  -- Initialise Variables

  -- Derive position on current plane
  !xyPosition    = !this.plane.xyOffset(!this.plane.near(!positionData.position).wrt(!this.extrusion))

  -- Special case when picking a line in group mode
  -- Do we try and re-orientate the group
  if(!this.settingMenu.selected('Free rotate') and !this.mode eq 'MODIFY' and !this.modeType eq 'GROUP' and !positionData.line.set() and !this.positionType.selection() eq 'POSITION') then

    -- Get direction of line picked
    !lineDirection   = !positionData.line.direction().projected(!this.plane).wrt(!this.extrusion).opposite()

    -- Get arrive direction of group
    !arriveDirection = !this.group.arrivePath.direction.wrt(!this.extrusion)

    -- If the directions are no parallel, then rotate thr group
    if(!lineDirection.isParallel(!arriveDirection).not()) then

      -- We have to get the angle in real terms, not just a relative angle
      !arc   = object ARC(!positionData.line.startPosition, object ORIENTATION('X is ' & !arriveDirection & ' and Z is ' & !this.extrusion.orientation.zDir()), 1000, 0, 90, true)
      !angle = !arc.near(!arc.position.offset(!lineDirection, 1000))
      !this.group.rotate(!angle)

    endif

  endif

  if(!this.mode eq 'CREATE') then

    -- Create a new point
    if(!this.modeType eq 'POINT') then

      !this.xyPosition.xyPosition(!xyPosition, false, false)
      if(!this.settingMenu.selected('Confirm')) then
        !this.position()
      else
        !this.createVertex()
      endif
    endif

  else
    -- Update input gadgets
    !this.xyPosition.xyPosition(!xyPosition)

  endif

endmethod
-- End of method definition for .position(EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      positionLine
--
-- Description: Set position of line
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionLine()

  -- Initialise Variables
  !reference = !!ce

  -- Draw line
  !gphLine        = object GPHLINE(!this.edgeLine)
  !gphLine.detail = true
  !gphLine.draw(!this.aidGroup)

  -- Move edge
  !!ce = !this.edge
  AT $!<this.edgeLine.startPosition>
  NEXT
  handle any
    FIRST
  endhandle
  AT $!<this.edgeLine.endPosition>
  !!ce       = !reference

  -- Tag Edges
  !this.updateLoop()
  !this.boundary()
  !this.tagVertex()

  -- Update input field
  !this.positionType()

endmethod
-- End of method definition for .positionLine()

------------------------------------------------------------------------
--
-- Method:      createVertex
--
-- Description: Create vertex
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createVertex()

  -- Initialise Variables
  !reference = !!ce

  !!ce       = !this.vertex
  handle any
    !!alert.warning('A vertex has been unexpectedly deleted. Unable to create new vertex')
    return
  endhandle
  NEW $!<this.genericExtrusion.vertexType>
  AT X$!<this.x.val> Y$!<this.y.val> FRADIUS $!<this.distance.val>


  -- Tag
  !this.updateLoop()
  !this.boundary()
  !this.select(!!ce.sequence)
  !!aidNumbers.hide(!this.aidNew)

  !!ce       = !reference
  !this.setEditButtonState()
endmethod
-- End of method definition for .createVertex()

------------------------------------------------------------------------
--
-- Method:      modifyVertex
--
-- Description: Modify vertex
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyVertex()

  -- Initialise Variables
  !reference = !!ce

  !!ce       = !this.vertex

  if(!this.vertex.position.east ne !this.x.val or !this.vertex.position.north ne !this.y.val) then
    AT X$!<this.x.val> Y$!<this.y.val>
  endif
  if(!this.vertex.fRadius ne !this.distance.val) then
    FRADIUS $!<this.distance.val>
  endif

  -- Tag Edges
  !this.updateLoop()
  !this.boundary()
  !this.tagVertex()

  !!aidNumbers.hide(!this.aidNew)

  !!ce       = !reference

endmethod
-- End of method definition for .modifyVertex()

------------------------------------------------------------------------
--
-- Method:      explicitArc
--
-- Description: Define arc explicitly
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .explicitArc()

  -- Initialise Variables

  -- Build loop arc form
  if(undefined(!!dbeLoopArc)) then
    pml reload form !!dbeLoopArc
  endif

  -- Create new arc
  if(!this.mode eq 'CREATE') then

    !this.tagNewVertex()
    !this.createPoints()

    !!dbeLoopArc.create()

  -- Modify existing arc
  else
    !this.selectVertex(!this.vertex)

    !!dbeLoopArc.edit()
  endif

  -- Hide aid elements
  !!aidNumbers.hide(!this.aidNew)
  !!aidNumbers.hide(!this.aidNumber)

  -- Show Arc loop edit form
  !this.setActive(false)

endmethod
-- End of method definition for .explicitArc()

------------------------------------------------------------------------
--
-- Method:      removeCoincident
--
-- Description: Remove coincident
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeCoincident()

  -- Initialise Variables

  -- Remove any coincident points
  if(!this.genericExtrusion.removeCoincident()) then

    -- Update definition
    !this.updateLoop()
    !this.boundary()
    !this.select(!this.sequence.val)

  endif

endmethod
-- End of method definition for .removeCoincident()
