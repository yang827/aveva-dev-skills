  if(undefined(!!pos3DOffset)) then
    pml reload form !!pos3DOffset
  endif

  -- Get position of last loop element
  if(!this.loop.set() and !this.loop.mCount gt 0) then
    !position = !this.loop.members[!this.loop.mCount].position

  -- Get last vertex position
  elseif (!this.positions.size() eq 0) then
    !position = N0

  -- Use last positions position
  else
    !position = !this.positions[!this.positions.size()]
  endif

  -- Show standard basic position definition
  !!pos3DOffset.edit('!!dbeNExtrusion.position(!this.position())', !position, !position, 'Define vertex', 'Vertex position', true, 'Extrusion Creation')

endmethod
-- End of method definition for .defineOffset()

