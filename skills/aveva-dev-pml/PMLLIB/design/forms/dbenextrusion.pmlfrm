-- Created:         Tue Aug 11 14:17:42 BST 1998
--
--
-- Description:
-- Extrusion Creation form
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   Apply form
--  arc(ARC)                         -                   Create points using passed arc definition
--  axes()                           -                   Display current axes
--  build()                          -                   Build Extrusion/loop from current data
--  cancel()                         -                   Apply form
--  close()                          -                   Close form
--  dbeNExtrusion()                  -                   Constructor
--  define3Points()                  -                   Setup EDG mode to define arc passing through three points
--  defineExplicit()                 -                   Setup EDG mode to define points explicitly
--  defineFRadTan()                  -                   Setup EDG mode to define arc of fixed radius passing through 2 points
--  defineFillet()                   -                   Setup EDG mode to define point using fillet method
--  defineOffset()                   -                   Setup EDG mode to define with relative offset from previous
--  definePoints()                   -                   Setup EDG mode for defining by graphic picks
--  defineTrace()                    -                   Setup to define edge by tracing another Extrusion/extrusion
--  getPath(DBREF)                   DBREF               Initialises the current RPATH
--  initialise()                     -                   Initialise the form
--  modifyLoop()                     -                   Modify the loop of the extrusion using the profile editor
--  modifyMode(DBREF)                -                   Switch to the form's modify mode
--  modifyProf()                     -
--  position(POSITION)               -                   Create point using passed position
--  removeLast()                     -                   Remove last vertices point
--  representation()                 -                   Set representation data to selection
--  setSurface(EDGPICKDATA)          -                   Set Surface
--  surface()                        -                   Set surface
--  thickness()                      -                   Set thickness
--  tidy()                           -                   Tidy up graphics
--  updateForm()                     -                   Update form information
--
------------------------------------------------------------------------

setup form !!dbeNExtrusion

  !!dbeNExtrusion.formTitle     = 'Create Negative Extrusion'
  !!dbeNExtrusion.iconTitle     = 'CrtExtru'
  !!dbeNExtrusion.callback      = '!this.initialise()'
  !!dbeNExtrusion.formRevision  = ' $Revision: 1.17 $ '

  -- Name Option
  para     .nameTag  at x0.5 y0.5 width 8 lines 1
  option   .autoName at xmin.nameTag ymin.nameTag width 8

  -- Element Name
  text     .name ' ' at xmax ymin callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 32 is STRING


 -- Obst and Level Data
  frame .repFrame 'Representation' at xmin.autoName ymax width 50
    option   .perDefinedObs 'Predefined'   at x1       ymax callback '!this.representation() ' width 30
    text     .fromLevel     'Levels'       at xmin+4   ymax                                    width 2  scroll 3 is REAL
    text     .toLevel                      at xmax+1   ymin                                    width 2  scroll 3 is REAL
    option   .obstruction   'Obstruction ' at xmax+2.5 ymin                                    width 4
  exit

  -- Settings
  frame .oriFrame 'Settings'    at xmin.repFrame ymax.repFrame width 50

    -- Surface
    button    .surface 'Surface ' at x1     y1   tooltip 'Pick surface hole is projected from' callback '!this.surface()'
    paragraph .surfaceText        at xmax+1 ymin width 30 lines 1

    -- Thickness
    text   .thickness 'Hole depth '  at xmin.surface  ymax callback '!this.thickness()'    width 14 is REAL format !!distanceFmt

  exit

  -- Create Methods
  frame .crtFrame 'Create Methods' at xmin.oriFrame ymax.oriFrame width 50

    -- Type of creation
    button .defPoints at x0.5 ymax pix unsel $!!cdpmPoints width 24 heig 24 tooltip 'Derive points from graphic picks'           callback '!this.definePoints()'
    path right
    hdist 0
--    button .defTrace               pix unsel $!!cdpmEdge   width 24 heig 24 tooltip 'Trace boundary of another extrusion/Extrusion'  callback '!this.defineTrace()'
    button .defExplicit            pix                      width 24 heig 24 tooltip 'Explicitly defined position'                callback '!this.defineExplicit()'
    button .defOffset              pix                      width 24 heig 24 tooltip 'Point offset from previous'                 callback '!this.defineOffset()'
    button .defFillet              pix                      width 24 heig 24 tooltip 'Define arc fillet'                          callback '!this.defineFillet()'
    button .def3Points             pix                      width 24 heig 24 tooltip 'Derived arc passing through three points'   callback '!this.define3Points()'
    button .defFRadTan2            pix                      width 24 heig 24 tooltip 'Fixed radius arc, passing through 2 points' callback '!this.defineFRadTan()'

    para   .detail  at x1 ymax+0.2 width 45 lines 1
    -- Number of vertices created
    button .remove 'Remove Last Definition' at xmin ymax callback '!this.removeLast()'

  exit

  -- Modify Methods
  frame .modFrame 'Modify Shape' at xmin.oriFrame ymax.oriFrame+1 width 50
    paragraph .iconLoopEdit                         anchor left + top   at x1         ymax+0.2      pixmap width 16 height 16
    button    .loopEdit  linklabel 'Loop editor'    anchor left + top   at xmax+2     ymin+0.2          callback '!this.modifyLoop()'
  exit

 -- Bottom Line
  button .dismiss          'Cancel' at xmax form-size ymax.crtFrame+0.5 callback '!this.cancel()'
  button .apply            '  OK  ' at xmin form+0    ymin     callback '!this.apply(|CREATE|)'

  toggle .displayModify    'Display modification form' at xmax+1 ymin states 'false' 'true'

 -- User Data

  -- Form members
  -- Owning Element
  member .owner           is DBREF
  -- Current Active extrusion
  member .extrusion       is DBREF
  -- Loop Name
  member .loop            is DBREF

  -- Surface plane
  member .surfacePlane    is PLANE

  -- Vertex definitions

  -- Created (i.e. after three points, we can create a Extrusion)
  member .created         is BOOLEAN

  -- Vertices Data
  member .positions       is ARRAY
  member .radii           is ARRAY

  -- Aid number information
  member .aidNumbers      is ARRAY
  member .aidNumber       is REAL
  member .aidTag          is REAL
  member .aidAxes         is REAL


  -- Last number of definition points
  member .lastDefCount    is ARRAY
  member .lastDefType     is ARRAY

exit

--  To exit EDG when closing the form
 !!dbeNExtrusion.cancelCall = '!!dbeNExtrusion.cancel()'


-- End of form definition for !!dbeNExtrusion

------------------------------------------------------------------------
--
-- Method:      dbeNExtrusion
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeNExtrusion()

  -- Naming method
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Name')
  !rText.append('false')
  !dText.append('Autoname')
  !rText.append('true')
  !this.autoName.dText      = !dText
  !this.autoName.rText      = !rText

  -- Obstruction
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Hard')
  !rText.append('2')
  !dText.append('Soft')
  !rText.append('1')
  !dText.append('None')
  !rText.append('0')
  !this.obstruction.dText = !dText
  !this.obstruction.rText = !rText

  -- Default thickness
  !this.thickness.val     = 0

  -- Define Icons
  !this.defExplicit.addPixmap(!!pml.getPathName('xyz24.png'))
  !this.defOffset.addPixmap(!!pml.getPathName('distancedirection24.png'))
  !this.defFillet.addPixmap(!!pml.getPathName('circlefillet24.png'))
  !this.def3Points.addPixmap(!!pml.getPathName('circle3pnt24.png'))
  !this.defFRadTan2.addPixmap(!!pml.getPathName('circlefrad2pnttan24.png'))
  !this.iconLoopEdit.addPixmap(!!pml.getPathName('createpanel24.png'))

  -- Aid number
  !this.aidTag    = !!aidNumbers.add('Extrusion Creation')
  !this.aidNumber = !!aidNumbers.add('Extrusion Creation')
  !this.aidAxes   = !!aidNumbers.add('Extrusion Creation')

  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP" $<!!dbeNExtrusion.perDefinedObs$>

 !this.perDefinedObs.val = 2
 !this.representation()

 !this.nameTag.visible = false

endmethod
-- End of method definition for .dbeNExtrusion()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Clear aid tags
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidTag)
  !this.name.val        = STRING()
  !this.created         = false
  !this.extrusion       = object DBREF()
  !this.loop            = object DBREF()
  !this.surfacePlane    = object PLANE()
  !this.lastDefCount.clear()
  !this.lastDefType.clear()
  !this.positions.clear()
  !this.radii.clear()
  !this.aidNumbers.clear()
  !this.updateForm()

  -- Get the parent we are to store beneath
  !owner = !!dtbOwnerOfType(!!ce, 'NXTR')

  -- If there is no owner, then give an error
  if(!owner.unset() or !owner.type inset('STRU','EQUI','SUBE','SUBS')) then
  -- Look for bent plate
  	!owner = !!dtbOwnerOfType(!!ce, 'BPFEAT')
  	if(!owner.unset()) then
      !!alert.warning('Unable to create a negative extrusion within this hierarchy structure. Move to an element that can own one.')
      return error 1 noalert
    endif
  endif

  -- Check type of CE
  if (!!ce.hardType.eq('SCTN') or !!ce.hardType.eq('GENSEC')) then
    !!alert.warning('Unable to create a negative extrusion within this hierarchy structure. Move to an element that can own one.')
    return error 1 noalert
  endif

  -- Set owner we want to create extrusion beneath
  !this.owner = !owner

  -- Surface
  !this.surfaceText.val   = 'Parents origin'
  !this.surfacePlane      = object PLANE(!this.owner.position, !this.owner.orientation)
  !this.axes()
  !this.surface.active    = true

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!state is STRING)

  -- Check if loop exists if in create state
  if (!state.eq(|CREATE|)) then
    -- If there is no Extrusion created, then give a warning
    if(!this.loop.unset()) then
      !!alert.message('Unable to create Extrusion with less than three vertices defined.')
      return
    endif
  endif

  -- Initialise Variables
  !reference = !!ce

  -- Apply data to Extrusion
  !!ce       = !this.extrusion

  if (!this.extrusion.type.eq('NXTR')) then
    !obstruction = !this.obstruction.selection()
    OBST  $!obstruction
    if(!this.fromLevel.val le !this.toLevel.val) then
      LEVEL $!this.fromLevel.val $!this.toLevel.val
    else
      LEVEL $!this.toLevel.val $!this.fromLevel.val
    endif
  endif

  -- Autoname
  if(!!dbeNExtrusion.autoName.selection().boolean()) then
    !name = !!namOpt.nameString(!!ce, '', false, false)
  -- Use specified
  else
    !name = !this.name.val
  endif

  -- Name
  if(!name.set()) then
    -- Consider a blank name
    if (!name.trim() eq '') then
      !name = STRING()
    endif
    NAME /$!<name>
    handle ANY
      -- You never know! User could have just created something with this name elsewhere before pressing Apply
    endhandle
  endif

  -- Modify only calls
  if (!!dbeNExtrusion.formTitle.eq(|Modify Negative Extrusion|)) then

    -- Set the position of the NXTR
    !position = !this.surfacePlane.near(!this.extrusion.position).offset(!this.surfacePlane.orientation.zDir().opposite(), !this.thickness.val)
    POSITION $!<position>

    -- Set the orientation of the NXTR
    ORI $!<this.surfacePlane.orientation>

    -- Set the thickness of the NXTR
    !height   = !this.thickness.val
    HEIGHT   $!<height>

  endif

  -- Create only check
  if(!this.displayModify.val) then
    if (!!appcntrl.currentApp() eq 'EQUI') then
      !this.modifyMode(!this.extrusion)
    else
    	if(!this.extrusion.type.eq('BPOPEN'))then
    	  !!dbeLoopEdit(!this.extrusion, 'BPOPEN')
    	else
        !!dbeLoopEdit(!this.extrusion, 'NXTR')
      endif
      !this.close()
    endif
    return
  endif

  -- After create, if not entering modify mode, go to create
  if (!state.eq(|CREATE|)) then
    -- Close
    !this.close()
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  -- If there is no Extrusion created, then give a warning
  if(!this.loop.set()) then
    if (!!dbeNExtrusion.formTitle.eq(|Modify Negative Extrusion|)) then
    else
      if(!!alert.confirm(' Created Extrusion during the definition, do you want to retain the defined Extrusion?..').boolean().not()) then
        !!ce = !this.extrusion

		    if(!!ce.type.eq('BPOPEN')) then
		    	DELETE BPOPEN
		    else
          DELETE NXTR
        endif
      endif
    endif
  endif

  -- Display create gadgets
  !this.crtFrame.visible      = true
  !this.displayModify.visible = true
  !this.autoName.visible      = true
  !this.autoName.active       = true

  -- Hide modify gadgets
  !this.modFrame.visible      = false
  !!dbeNExtrusion.formTitle    = 'Create Negative Extrusion'
  !this.nameTag.visible       = false

  -- Set text on buttons
  !this.apply.tag             = '  OK  '
  !this.dismiss.tag           = 'Cancel'

  -- Set callbacks on buttons
  !this.apply.callback        = '!this.apply(|CREATE|)'

  -- Clear any values remaining in gadgets
  !this.name.val = ''
  !this.obstruction.select(|RTEXT|,'2')
  !this.thickness.val.unset()
  !this.perDefinedObs.val = 1

  -- Unset current extrusion
  !this.extrusion.unset()
  !this.loop.unset()

  -- Close
  !this.close()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Tidy
  !this.tidy()

  -- Hide form
  !this.hide()

  -- Remove EDG
  !!edgCntrl.remove('Extrusion Creation')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid elements
  do !i indices !this.aidNumbers
    !!aidNumbers.remove(!this.aidNumbers[!i])
  enddo
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      updateForm
--
-- Description: Update form information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateForm()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidTag)

  -- No vertices defined
  if(!this.loop.unset() and !this.positions.size() eq 0) then
    !this.detail.val      = 'No vertices currently defined'
    !this.remove.active   = false
    !this.tidy()

  -- No Extrusion created, but vertices defined
  elseif (!this.loop.unset() and !this.positions.size() gt 0) then
    !this.detail.val      = !this.positions.size().string() & ' Vertices defined (no Extrusion created)'
    !this.remove.active   = true

    -- Tag the origin
    !position = !this.surfacePlane.near(!this.positions[1])
    AID TEXT NUMBER $!<this.aidTag> 'Origin' AT $!<position>

    -- Tag the last point
    if(!this.positions.size() gt 1) then
      !last     = !this.positions.size()
      !position = !this.surfacePlane.near(!this.positions[!last])
      AID TEXT NUMBER $!<this.aidTag> 'Last Vertex' AT $!<position>
    endif

  -- More than 3 vertices
  elseif (!this.loop.set()) then
    !this.detail.val      = !this.positions.size() + !this.loop.mCount & ' Vertices defined (Extrusion created)'

    -- See how many vertices are in the loop
    !last         = !this.loop.mCount

    -- No vertices, only tag Extrusion origin
    if(!last eq 0) then
      !this.remove.active   = false

      !position = !this.surfacePlane.near(!this.extrusion.position)
      AID TEXT NUMBER $!<this.aidTag> 'Extrusion Origin' AT $!<position>

    -- Tag start of loop
    elseif (!last gt 0) then
      !this.remove.active   = true

      !position = !this.surfacePlane.near(!this.loop.members[1].position)
      AID TEXT NUMBER $!<this.aidTag> 'Origin' AT $!<position>
      if(!last gt 1) then
        !position = !this.surfacePlane.near(!this.loop.members[!last].position)
        AID TEXT NUMBER $!<this.aidTag> 'Last Vertex' AT $!<position>
      endif
    endif
  endif

endmethod
-- End of method definition for .updateForm()

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Set representation data to selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .representation()

  -- Initialise Variables
  !key = !this.perDefinedObs.selection()

  -- Get representation from system
  -- OLD CODE with BACKWARDS CALLS

  $m "%PDMSUI%/CLIB/FILES/RDREP-DAT" $<KEY$> $<$!key$>
  if(defined(!!cdinRtn))then
    !this.obstruction.select('RTEXT',!!cdinRtn)
    !this.fromLevel.val  = !!cdiaRtn[1].real()
    !this.toLevel.val    = !!cdiaRtn[2].real()
  endif

endmethod
-- End of method definition for .representation()

------------------------------------------------------------------------
--
-- Method:      thickness
--
-- Description: Set thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thickness()

  -- Initialise Variable

  -- Make height > than specified so we don't get co-planer surfaces
  !height = !this.thickness.val

  -- Draw a line to show the new depth
  !line    = object LINE(!this.surfacePlane.position, !this.surfacePlane.position.offset(!this.surfacePlane.orientation.zDir().opposite(), !this.thickness.val))
  !gphLine = object GPHLINE(!line)
  !!aidNumbers.replace(!this.aidNumber, !gphLine)

  -- Hole depth
  if(!line.startPosition.distance(!line.endPosition) gt 0) then
    !position = !line.proportion(0.5)
    -- format the display text to handle Imperial units
    !thkAidText = !this.thickness.val.string(!!distanceFmt)
    AID TEXT NUMBER $!<this.aidNumber> |$!<thkAidText>| AT $!<position>
  endif

  -- Return if there is no loop
  if(!this.loop.unset()) then
    return
  endif

  -- If element height and new height are the same, don't do anything
  if(!this.extrusion.height eq !height) then
    return
  endif

  -- Initialise Variables
  !reference = !!ce

  -- Move to loop and set thickness
  !!ce       = !this.extrusion

  -- Map position onto the surface plane
  if (!!dbeNExtrusion.formTitle.eq(|Create Negative Extrusion|)) then
    !position  = !this.surfacePlane.near(!this.extrusion.position).offset(!this.surfacePlane.orientation.zDir().opposite(), !this.thickness.val)
    POSITION $!<position>
    HEIGHT   $!<height>
  endif
  !!ce       = !reference

endmethod
-- End of method definition for .thickness()

------------------------------------------------------------------------
--
-- Method:      surface
--
-- Description: Set surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .surface()

  -- Initialise Variables

  -- Set EDG mode for picking the surface
  !packet                = object EDGPACKET()
  !packet.description    = 'Extrusion Creation'
  !packet.action         = '!!dbeNExtrusion.setSurface(!this.return[1])'
  !packet.remove         = true
  !packet.pickPacket.stdAny('Pick surface to be used as datum')
  !packet.pickPacket.picks[1].prompt         = STRING()
  !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
  !packet.pickPacket.picks[1].pick.stdGraphics()
  !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
  !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
  !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
  !packet.pickPacket.picks[1].pick.input[10] = /*
  !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'

  -- Set Common Data
  !packet.key            = 'definePlane'
  !packet.priority       = 2
  !packet.type           = 'edgPlane'

  -- Add Packet to edg system
  !!edgCntrl.add(!packet)
endmethod
-- End of method definition for .surface()

------------------------------------------------------------------------
--
-- Method:      setSurface
--
-- Description: Set Surface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Plane Definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSurface(!pickData is EDGPICKDATA)

  -- Initialise Variables

  -- Check if a design aid can be interpreted as a plane
  if(!pickData.type eq 'DESIGNAID') then
    if(!!aidNumbers.numbers[!pickData.point].objectType() inset('GPHPLANE','GPHLINEARGRID','GPHPLANTGRID','GPHRADIALGRID')) then
       !aid   = !!aidNumbers.numbers[!pickData.point]
       !plane = object PLANE(!aid.position, !aid.orientation)

    else
      !!alert.error('Unable to derive plane from picked element.')
      return
    endif

  -- Use "plane" picked
  else

    -- If there are no facets, then we can't derive a plane
    if(!pickData.facetCount gt 0) then

      -- Derived plane from picked plane
      !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
      -- Try 4th facet
      handle any
        !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
      endhandle

      !plane.position = !plane.intersection(!pickData.pickLine)

      -- check for panel or extrusion and use the orientation of the owner
      if(!pickData.type eq 'ELEMENT') then

        if(!this.owner.hardType inset('PANE','EXTR')) then

          -- check for user creating a negative in the plane of the owner
          !panelNormal = !this.owner.orientation.zDir()
          if( !panelNormal.isParallel(!plane.pointVector().direction) ) then
            -- now check for pick on under-side of panel
            if( !panelNormal.angle(!plane.pointVector().direction) eq 0 ) then
              -- modify orientation to match the owning panel
              !plane.orientation = object ORIENTATION( 'Z IS Z WRT ' + !this.owner.string() + ' AND X IS X WRT ' + !this.owner.string())
            else
              -- modify orientation to match the owning panel
              !plane.orientation = object ORIENTATION( 'Z IS -Z WRT ' + !this.owner.string() + ' AND X IS X WRT ' + !this.owner.string())
            endif
          endif
        endif

      endif

    -- Unable to derive plane
    else
      !!alert.error('Unable to derive plane from picked element.')
      return
    endif
  endif

  -- Set the surface plane
  !this.surfacePlane = !plane

  -- Display Surface direction
  !this.surfaceText.val   = !this.surfacePlane.orientation.zDir().string()

  -- Display plane
  !this.axes()

endmethod
-- End of method definition for .setSurface(EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      axes
--
-- Description: Display current axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .axes()

  -- Initialise Variables

  -- If there is no surface plane set, then don't do anything
  if(!this.surfacePlane.unset()) then
    return
  endif

  -- Generate the aid axes
  !gphAxes             = object GPHAXES(!this.surfacePlane.position, !this.surfacePlane.orientation)
  !gphAxes.description = 'Origin'
  !gphAxes.tag         = false
  !gphAxes.detail      = false
  !gphAxes.height      = 100mm
  !!aidNumbers.replace(!this.aidAxes, !gphAxes)

  -- Display the thickness
  !this.thickness()

endmethod
-- End of method definition for .axes()

------------------------------------------------------------------------
--
-- Method:      removeLast
--
-- Description: Remove last vertices point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeLast()

  -- Initialise Variables
  !removed        = false

  -- Get number of points that were last defined
  !last           = !this.lastDefCount.size()
  !lastDefCount   = !this.lastDefCount[!last]
  !lastDefType    = !this.lastDefType[!last]

  -- If there is no loop created, then we are looking at the .positions/.radii members
  if(!this.loop.unset()) then

    -- Get the last point in the list
    !lastPoint = !this.positions.size()

    -- If there are more than the last definition, remove them
    if(!lastPoint gt 0 and !lastPoint ge !lastDefCount) then

      !beginLast  = !lastPoint - !lastDefCount + 1
      !this.positions.removeFrom(!beginLast, !lastDefCount)
      !this.radii.removeFrom(!beginLast, !lastDefCount)
      !removed    = true

    endif

  -- Loop Defined
  else

    -- Get the last point in the list
    !lastPoint = !this.loop.mCount

    -- If there are more than the last definition, remove them
    if(!lastPoint gt 0 and !lastPoint ge !lastDefCount) then

      -- Current element
      !reference  = !!ce
      !!ce        = !this.loop

      !beginLast  = !lastPoint - !lastDefCount + 1

      if( !this.loop.type.eq('RPATH')) then
      	DELETE RPATH MEMB $!<beginLast> TO $!<lastPoint>
      else
        DELETE LOOP MEMB $!<beginLast> TO $!<lastPoint>
      endif

      !!ce        = REFERENCE
      !removed    = true

    endif

  endif

  -- If anything removed
  if(!removed) then

    -- Remove last definition
    !this.lastDefCount.remove(!last)
    !this.lastDefType.remove(!last)

    -- Update form
    !this.updateForm()

    -- Previous
    !previous = !last - 1

    -- Previous Definition now becomes the last definition
    if(!previous gt 0) then

      !prevDefType    = !this.lastDefType[!previous].upcase()


       -- Get the last aid item in the list
      !aidIndex       = !this.aidNumbers.size()

      -- If there is an aid item, then we'll remove it, unless its was a trace
      if(!aidIndex gt 0 and !lastDefType ne 'TRACE') then

        -- Remove aid from system and index list of the form
        !!aidNumbers.remove(!this.aidNumbers[!aidIndex])
        !this.aidNumbers.remove(!aidIndex)

        -- If the previous definition type was a point, then also remove it
        if(!aidIndex gt 1 and !prevDefType eq 'POINT' and !lastDefType eq 'ARC') then
          !!aidNumbers.remove(!this.aidNumbers[!aidIndex - 1])
          !this.aidNumbers.remove(!aidIndex - 1)
        endif

      endif
      !this.remove.tag = 'Remove Previous ' & !this.lastDefType[!previous]

    -- No previous definition
    else
      !this.remove.tag = 'Nothing to remove'
    endif

  endif

endmethod
-- End of method definition for .removeLast()

------------------------------------------------------------------------
--
-- Method:      definePoints
--
-- Description: Setup EDG mode for defining by graphic picks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePoints()

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition('Define vertex')
  !packet.action         = '!!dbeNExtrusion.position(!this.return[1].position)'
  !packet.key            = 'POS3D'
  !packet.description    = 'Extrusion Creation'
  !packet.type           = 'pos3D'
  !packet.priority       = 1
  !packet.remove         = false

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .definePoints()

------------------------------------------------------------------------
--
-- Method:      defineTrace
--
-- Description: Setup to define edge by tracing another Extrusion/extrusion
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineTrace()

  -- Get data
  $m "%PDMSUI%/DES/CLIB/RGETVERT"
  if($!!cdRtnStatus neq 0) then
    return
  endif

  -- Get position & radii of vertices
  var !xyz EVALUATE (POSI WRT WORLD ) FOR ALL FROM !!cdpaRtn
  var !rad EVALUATE (FRAD WRT WORLD ) FOR ALL FROM !!cdpaRtn

  -- Add data to vertices members
  do !i indices !!cdpaRtn
    !this.positions.append(!xyz[!i].position())
    !this.radii.append(!rad[!i])
  enddo

  -- Current Definition
  !this.lastDefCount.append(!!cdpaRtn.size())
  !this.lastDefType.append('Trace')
  !this.remove.tag = 'Remove Previous Trace'

  -- Build
  !this.build()

endmethod
-- End of method definition for .defineTrace()

------------------------------------------------------------------------
--
-- Method:      defineExplicit
--
-- Description: Setup EDG mode to define points explicitly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineExplicit()

  -- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- Get position of last loop element
  if(!this.loop.set() and !this.loop.mCount gt 0) then
    !position = !this.loop.members[!this.loop.mCount].position

  -- Get last vertex position
  elseif (!this.positions.size() eq 0) then
    !position = N0

  -- Use last positions position
  else
    !position = !this.positions[!this.positions.size()]
  endif

  -- Show standard basic position definition
  !!pos3D.edit('!!dbeNExtrusion.position(!this.position())', !position, 'Define vertex', 'Vertex position', true, 'Extrusion Creation')

endmethod
-- End of method definition for .defineExplicit()

------------------------------------------------------------------------
--
-- Method:      defineOffset
--
