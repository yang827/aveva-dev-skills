------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Create point using passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!passedPosition is POSITION)

  -- Map position onto surface plane
  !position = !this.surfacePlane.near(!passedPosition)

  -- If there is a loop defined, then map position onto the plane
  if(!this.loop.set()) then
    !this.positions.append(!this.surfacePlane.near(!position))
  else
    !this.positions.append(!position)
  endif

  -- Append radius to list
  !this.radii.append(0)

  -- No Extrusion created, but vertices defined
  if(!this.loop.unset() and !this.positions.size() gt 0) then
    -- Tag the last point
    if(!this.positions.size() gt 1) then
      !last = !this.positions.size()
      !line = object GPHLINE(object LINE(!this.positions[!last - 1], !this.positions[!last]))
      !this.aidNumbers.append(!!aidNumbers.add(!line))
    endif
  -- Adding to a loop
  elseif (!this.loop.set() and !this.loop.mCount gt 0) then
    !prevPosition = !this.loop.members[!this.loop.mCount].position
    !line = object GPHLINE(object LINE(!prevPosition, !this.positions[!this.positions.size()]))
    !this.aidNumbers.append(!!aidNumbers.add(!line))
  endif

  -- Last definition
  !this.lastDefCount.append(1)
  !this.lastDefType.append('Point')
  !this.remove.tag = 'Remove Previous Point'

  -- Build/Create
  !this.build()
  handle (2,851)
    -- Handle error on creating the NXTR
    !!alert.warning('Cannot create an NXTR at this level.')
    !this.removeLast()
    !!pos3DOffset.position = !!pos3DOffset.reference
  endhandle

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Create points using passed arc definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arc(!arc is ARC)

  -- Initialise Variables


  -- Get last point
  -- From list
  if(!this.loop.unset()) then
    if(!this.positions.size() gt 0) then
      !lastPosition = !this.positions[!this.positions.size()]
    endif

    -- From created points
  elseif (!this.loop.unset() and !this.loop.mCount gt 0) then
    !lastPosition = !this.loop.members[!this.loop.mCount].position
  endif

  -- Draw a line
  if(defined(!lastPosition)) then
    !line = object GPHLINE(object LINE(!arc.anglePosition(!arc.startAngle), !lastPosition))
    !this.aidNumbers.append(!!aidNumbers.add(!line))
  endif

  -- Add first vertex
  !this.positions.append(!arc.anglePosition(!arc.startAngle))
  !this.radii.append(0)

  -- Arc angle <= 90 degrees, only create one fillet point
  if(!arc.endAngle le 90) then
    !split = 1
  -- Arc angles > 90 and < 180
  elseif (!arc.endAngle.between(90, 180)) then
    !split = 2
  -- Arc angles > 180 and < 270
  elseif (!arc.endAngle.between(180, 270)) then
    !split = 3
  -- Arc angles > 270 and < 360
  else
    !split = 4
  endif

  -- Copy arc and get angle for each segment
  !newArc = !arc
  !angle  = !arc.endAngle / !split

  -- Populate vertices members
  do !i from 1 to !split
    !newArc.startAngle = !angle * (!i - 1)
    !newArc.endAngle   = !angle * !i
    !this.positions.append(!newArc.pole())
    !this.radii.append(!arc.radius)
  enddo

  -- Add Last vertex
  !this.positions.append(!arc.anglePosition(!arc.endAngle))
  !this.radii.append(0)

  -- Draw the arc
  !gphArc    = object GPHCIRCLE(!arc)
  !aidNumber = !!aidNumbers.add(!gphArc)
  !this.aidNumbers.append(!aidNumber)

  -- Last definition
  !this.lastDefCount.append(!split + 2)
  !this.lastDefType.append('Arc')
  !this.remove.tag = 'Remove Previous Arc'

  -- Build/Create
  !this.build()

endmethod
-- End of method definition for .arc(ARC)

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: Build Extrusion/loop from current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build()

  -- Initialise Variables
  !newVertices = !this.positions.size()
  !reference   = !!ce

  -- Stop surface being changed
  !this.surface.active = false

  -- No Extrusion, not enough points, do nothing other than tag the points
  if(!this.extrusion.unset() and !newVertices lt 3) then

    -- Update form
    !this.updateForm()

    return

  -- Create a new Extrusion
  elseif (!this.extrusion.unset() and !newVertices ge 3) then

     -- Move to the store
	   !!ce = !this.owner
	
    if( !this.owner.type.eq('BPANEL')) then
    	-- Build BPOPEN
    	
      !plane = object PLANE()
      !plane.position = !this.owner.position.wrt(World)
      !plane.orientation = !this.owner.orientation.wrt(World)

    	!actualPosition = !this.positions[1].wrt(World)
    	!path = !this.getPath( !!ce)
    	!position = !plane.near(!actualPosition)
    	if !position.unset() then
        return
      endif
      !rPath = object RPATHPOSITIONING(!path)
    	!rPath.setPositionNear(!position, FALSE)
    	
      !vDistance = !position.distance(!actualPosition )
    	
    	!collect = object COLLECTION()
      !collect.scope(!this.owner)
      !collect.type('BPFEAT')
      if (!collect.results().size() gt 0) then
  	    !bpFeat = !collect.results()[1]
  		  !!ce = !bpFeat
  		else
  			!!ce = !this.owner
  		  NEW BPFEAT
      endif

      NEW BPOPEN
  		!newOpening = !!ce
  		!newOpening.wJusLine  = !this.owner.wJusLine
      !newOpening.zDistance = !rPath.zDistance
      !newOpening.vDistance = !vDistance
      !newOpening.posRef    = !rPath.referencePoint
      -- Set reference to extrusion
	    !this.extrusion = !!ce
	
      NEW RPATH
    	-- Set reference to loop
	    !this.loop      = !!ce
    	
    else
      -- Build NXTR
	    NEW NXTR
	    -- Map position onto the surface plane
	    !position  = !this.surfacePlane.near(!this.positions[1]).offset(!this.surfacePlane.orientation.zDir().opposite(), !this.thickness.val)
	    POSITION $!<position>
	    ORI $!<this.surfacePlane.orientation>
	    HEIGHT $!<this.thickness.val>
	
	    -- Set reference to extrusion
	    !this.extrusion = !!ce
	
	    -- Create the loop
	    NEW LOOP
	
	     -- Set reference to loop
	    !this.loop      = !!ce

    endif

  endif

  -- Move to the last element of the loop
  if(!this.loop.mCount gt 0) then
    !!ce = !this.loop.members[!this.loop.mCount]
  else
    !!ce = !this.loop
  endif

  if( !this.owner.type.eq('BPANEL')) then
  	do !i indices !this.positions
  	  NEW POINTR
  	  AT      $!<this.positions[$!<i>]>
      FRADIUS $!<this.radii[$!<i>]>
  	enddo
  	--!path = !this.getPath( !this.owner)
  	--!profile = object PROFILE(!!ce)
  else
  -- Define points
    do !i indices !this.positions
      NEW VERT
      AT      $!<this.positions[$!<i>]>
      FRADIUS $!<this.radii[$!<i>]>
    enddo
  endif

  -- Return to reference
  !!ce = !reference

  -- Re-initialise Variables
  !this.positions.clear()
  !this.radii.clear()

  -- Update form
  !this.updateForm()

endmethod
-- End of method definition for .build()

------------------------------------------------------------------------
--
-- Method:      modifyMode
--
-- Description: Switch to the form's modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF     Negative extrusion to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyMode(!extr is DBREF)

  -- Hide create gadgets
  !this.crtFrame.visible      = false
  !this.displayModify.visible = false
  !this.autoName.select(|DTEXT|, |Name|)
  !this.autoName.visible       = false

  -- Display modify gadgets
  !this.modFrame.visible      = true
  !this.apply.visible         = true
  !this.dismiss.visible       = true
  !!dbeNExtrusion.formTitle   = 'Modify Negative Extrusion'
  !this.surface.active        = true
  !this.nameTag.visible       = true
  !this.nameTag.val           = 'Name:   '

  -- Set text on buttons
  !this.apply.tag             = 'Apply'
  !this.dismiss.tag           = 'Dismiss'

  -- Set callbacks on buttons
  !this.apply.callback        = '!this.apply(|MODIFY|)'

  -- Load extrusion attributes into form gadgets
  if (!extr.isNamed) then
    !this.name.val = !extr.name
  else
    !this.name.val = STRING()
  endif

  !this.obstruction.select(|RTEXT|,!extr.obstruction.string())
  !this.thickness.val = !extr.height

  -- Try to choose description for ce
  !this.perDefinedObs.val = 1
  !levels = !extr.level
  !this.fromLevel.val     = !levels[1]
  !this.toLevel.val       = !levels[2]
  !obstructionType        = !extr.obst
  !this.obstruction.select('RTEXT',!obstructionType.string())

  -- OLD CODE with BACKWARDS CALLS to find matching description
  !levelLow  = !levels[1]
  !levelHigh = !levels[2]
  $m/%PDMSUI%/CLIB/FILES/RDREP-DAT DATA $!<obstructionType> $!<levelLow> $!<levelHigh>
  if( defined(!!cdcnrtn) ) then
    !this.perDefinedObs.select('DTEXT',!!cdcnrtn)
  endif

  -- Set current extrusion
  !this.extrusion = !extr
  !!ce = !this.extrusion
  LOOP 1
  !this.loop = !!ce
  !!ce = !this.extrusion

  -- Load the surface plane the negative extrusion was created on
  !spOrientation = !this.extrusion.orientation
  !spPosition = !this.extrusion.position.offset(!spOrientation.zDir(), !this.thickness.val)
  !this.surfacePlane = object PLANE(!spPosition, !spOrientation)
  !this.surfaceText.val   = !this.surfacePlane.orientation.zDir().string()

  -- Draw the axes
  !this.axes()

endmethod
-- End of method definition for .modifyMode()

------------------------------------------------------------------------
--
-- Method:      modifyLoop
--
-- Description: Modify the loop of the extrusion using the loop editor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyLoop()

  -- Modify the loop of the current extrusion
  !!dbeLoopEdit(!this.extrusion, 'EXTR NXTR')

endmethod
-- End of method definition for .modifyLoop()

------------------------------------------------------------------------
--
-- Method:      modifyLoop
--
-- Description: Modify the loop of the extrusion using the profile editor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyProf()

  -- Modify the loop of the current extrusion as a profile
  show !!dbeProfileEdit
  !!dbeProfileEdit.setup(!this.extrusion)

endmethod
-- End of method definition for .modifyProf()

-----------------------------------------------------------------------
--
-- Method:      getPath
--
-- Description: Initialises the current RPATH
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPath(!plate is DBREF) is DBREF

 !path  = RPATH 1 of $!plate
  handle ANY
    !!alert.error('Cannot find a suitable RPATH for selected bent plate')
    !path = DBREF()
  endhandle

  return !path
endmethod
