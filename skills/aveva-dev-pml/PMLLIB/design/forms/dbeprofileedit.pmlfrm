  !packet.priority          = 1
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to mirror on'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.action            = '!!dbeProfileEdit.boundaryMirror(!this.return[1])'
  !packet.remove            = true

  -- Add event to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryMirror
--
-- Description: Mirror profile on passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line to mirrored about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryMirror(!line is LINE)

  -- Initialise Variables
  !profile    = object PROFILE(!this.loop.profile)
  !mirrorLine = !line.projected(!this.plane)

  -- Mirror
  !profile    = !profile.mirror(!mirrorLine)

  -- Solution
  !this.featureSolution(!profile, 'Mirror about line')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offsetThrough
--
-- Description:  Define packet for offsetting through a position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetThrough()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Position to offset through')
  !packet.key             = 'pickEdge'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.offsetThrough(!this.return[1])'
  !packet.remove          = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offsetThrough
--
-- Description: Offset Edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA Positional pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetThrough(!positionData is EDGPOSITIONDATA)

  -- Initialise Variables
  !position = !this.loop.plane.near(!positionData.position)

  -- Edge definition
  !edge     = !this.loop.profile.edge(!this.edge.val)
  !edge     = !edge.parallel(!position)

  -- Resolve Edge
  !this.resolveEdge(!edge, 'Offset through position')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offsetTangential
--
-- Description: Define packet for  for .offsetTangential(....)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetTangential()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'pickEdge'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.offsetTangential(!this.return[1])'
  !packet.pickPacket.stdScreen('Pick arc')
  !packet.pickPacket.picks[1].prompt          = ''
  !packet.pickPacket.picks[1].pick.cursor     = 'pick'
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.remove          = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offsetTangential
--
-- Description: Offset Edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Pick Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetTangential(!pickData is POINTVECTOR)

  -- Initialise Variables
  !iPosition      = !this.loop.plane.intersection(!pickData)
  !edgeNumbers    = !this.loop.profile.nearEdges(!iPosition)
  !arc            = !this.loop.profile.edge(!edgeNumbers[1])

  if(!arc.objectType() ne 'ARC') then
    !!alert.warning('An arc must be picked.')
    return
  endif

  -- Edge definition
  !edge           = !this.loop.profile.edge(!this.edge.val)

  -- Offset directions
  !direction[1]   = !edge.direction().orthogonal(!arc.orientation.zDir())
  !direction[2]   = !direction[1].opposite()

  -- Derived edge lines
  !line[1]        = !edge.parallel(!arc.position).offset(!direction[1], !arc.radius)
  !line[2]        = !edge.parallel(!arc.position).offset(!direction[2], !arc.radius)

  !distance[1]    = !line[1].distance(!iPosition)
  !distance[2]    = !line[2].distance(!iPosition)

  -- Determine the edge line nearest to the picked point
  if(!distance[1] le !distance[2]) then
    !edge         = !line[1]
  else
    !edge         = !line[2]
  endif

  -- Resolve Edge
  !this.resolveEdge(!edge, 'Offset tangentially through arc')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset Edge by passed distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset distance
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!distance is REAL)

  -- Initialise Variables
  !edge = !this.loop.edge(!this.edge.val)

  if(!edge.objectType() eq 'ARC') then
    !!alert.warning('Unable to offset curved edge.')
    return
  endif

  -- Offset direction
  !offsetDirection = !edge.direction().orthogonal(!this.plane.direction())

  -- If the sense is clock-wise, then make the offset direction opposite
  if(!this.loop.profile.sense().not()) then
    !offsetDirection = !offsetDirection.opposite()
  endif

  !edge = !edge.offset(!offsetDirection, !distance)

  -- Resolve Edge
  !this.resolveEdge(!edge, 'Offset edge ' & !distance.string(!!distanceFmt))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangential
--
-- Description: Make edge tangential to adjacent
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tangential()

  -- Initialise Variables
  !this.solution()
  !edge     = !this.loop.edge(!this.edge.val)

  -- Resolve edge
  !from     = !this.loop.previous(!this.edge.val)
  !to       = !this.loop.next(!this.edge.val)
  !solution = !this.loop.tangentialLineEdge(!from, !to)

  -- Define solution
  if(!solution.set()) then
    !solution.description = 'Tangential edge'
    !this.solution(!solution)
  else
    !!alert.warning(!!error.text)
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: Modify radius of edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius(!radius is REAL)

  -- Initialise Variables
  !this.solution()

  -- Redefine radius
  if(!this.edgeIsFillet) then
    !this.fillet('redefine')

  else
    !description   = 'Change radius to ' & !this.distance.val.string(!!distanceFmt)
    !edge          = !this.loop.profile.edges()[!this.edge.val]
    !edge.radius   = !radius

    -- Resolve Edge
    !this.resolveEdge(!edge, !description)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      arcType
--
-- Description: Change arc type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if minor arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arcType(!minor is BOOLEAN)

  -- Initialise Variables
  if(!minor) then
    !type  = 'minor'
  else
    !type  = 'major'
  endif
  !edge    = !this.edgeArc

  -- Set major/minor flag
  !isMinor = !edge.angle().gt(180).not()
  !this.menuModifyArc.select('Major', !isMinor.not())
  !this.menuModifyArc.select('Minor', !isMinor)

  -- Check setting
  if(!isMinor.eq(!minor)) then
    !!alert.warning('Edge is already a ' & !type & ' arc.')
    return
  endif

  -- Mirror edge
  !edge.sense         = !edge.sense.not()
  !solution           = object DBELOOPSOLUTION()
  !solution.edgeNumbers.append(!this.edge.val)
  !solution.edgeIndex = 1
  !solution.edges.append(!edge)

  -- Define solution
  if(!solution.set()) then
    !solution.description = 'Switch arc type (' & !type & ')'
    !this.solution(!solution)
  else
    !!alert.warning(!!error.text)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateParallel
--
-- Description: Define packet for .parallel(....)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateParallel(!rotateEnd is STRING)

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'pickEdge'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.rotateParallel(!this.return[1], |' & !rotateEnd & '|)'
  !packet.remove          = true
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt          = 'Pick line to made parallel with, rotate about' & !rotateEnd
  !packet.pickPacket.picks[1].prompt = ''

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateParallel
--
-- Description: Rotate edge so that it is parallel to picked edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Pick line
--    2   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateParallel(!line is LINE, !rotateEnd is STRING)

  -- Edge definition
  !edge           = !this.edgeLine

  -- Define rotation end
  if(!rotateEnd.lowcase() eq 'start') then
    !end           = 'start'
    !planePosition = !edge.startPosition
    !oppositeEnd   = 'end'
  else
    !end           = 'end'
    !planePosition = !edge.endPosition
    !oppositeEnd   = 'start'
  endif

  -- Map line onto plane
  !line           = !line.projected(!this.loop.plane())

  -- To get the lines in the same direction, we project the edge onto
  -- the picked line
  !referenceLine  = object LINE(!line.near(!edge.startPosition), !line.near(!edge.endPosition))

  -- Determine if we have a positive or negative offset
  !plane          = object PLANE(!planePosition, object ORIENTATION('X is ' & !referenceLine.direction() & ' and Z is ' & !this.loop.plane().direction()))

  -- Determine the rotation angle and pass to rotation method
  !xyPosition     = !plane.xyOffset(!edge.attribute(!oppositeEnd & 'Position'))
  !angle          = atan(!xyPosition.y / !xyPosition.x) * -1

  -- Rotate line
  !this.rotate(!angle, !end)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateNormal
--
-- Description: Define packet for .normal(....)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateNormal(!rotateEnd is STRING)

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'pickEdge'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.rotateNormal(!this.return[1], |' & !rotateEnd & '|)'
  !packet.remove          = true
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt          = 'Pick line to made normal with, rotate about' & !rotateEnd
  !packet.pickPacket.picks[1].prompt = ''

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateNormal
--
-- Description: Rotate edge so that it is parallel to picked edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Pick line
--    2   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateNormal(!line is LINE, !rotateEnd is STRING)

  -- Edge definition
  !edge           = !this.edgeLine

  -- Define rotation end
  if(!rotateEnd.lowcase() eq 'start') then
    !end           = 'start'
    !planePosition = !edge.startPosition
    !oppositeEnd   = 'end'
  else
    !end           = 'end'
    !planePosition = !edge.endPosition
    !oppositeEnd   = 'start'
  endif

  -- Map line onto plane
  !line           = !line.projected(!this.loop.plane())

  -- To get the lines in the same direction, we project the edge onto
  -- the picked line
  !referenceLine  = object LINE(!line.near(!edge.startPosition), !line.near(!edge.endPosition))

  -- Determine if we have a positive or negative offset
  !plane          = object PLANE(!planePosition, object ORIENTATION('X is ' & !referenceLine.direction() & ' and Z is ' & !this.loop.plane().direction()))

  -- Determine the rotation angle and pass to rotation method
  !xyPosition     = !plane.xyOffset(!edge.attribute(!oppositeEnd & 'Position'))
  !angle          = 90 + (atan(!xyPosition.y / !xyPosition.x) * -1)

  -- If angle > 90, the negate from 180
  if(!angle gt 90) then
    !angle = !angle - 180
  endif

  -- Rotate line
  !this.rotate(!angle, !end)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateTowards
--
-- Description: Define packet for .rotate towards/through a position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateTowards(!rotateEnd is STRING)

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Rotate towards about' & !rotateEnd)
  !packet.key             = 'rotateTowards'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.rotateTowards(!this.return[1].position, |' & !rotateEnd & '|)'
  !packet.remove          = false

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateTowards
--
-- Description: Rotate edge so that it is parallel to picked edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to rotate
--    2   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateTowards(!passedPosition is POSITION, !rotateEnd is STRING)

  -- Edge definition
  !edge           = !this.edgeLine

  -- Define rotation end
  if(!rotateEnd.lowcase() eq 'start') then
    !end           = 'start'
    !planePosition = !edge.startPosition
    !oppositeEnd   = 'end'
  else
    !end           = 'end'
    !planePosition = !edge.endPosition
    !oppositeEnd   = 'start'
  endif

  -- Map line onto plane
  !position        = !this.plane.near(!passedPosition)
  !rotationPoint   = !this.loop.rotationPoint(!this.edge.val, !end)

  -- Line
  !line            = object LINE(!rotationPoint, !position)

  -- Resolve Edge
  !this.resolveEdge(!line, 'Rotate edge through')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate Edge about an end
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL, !end is STRING)

  -- Return on zero angle
  if(!angle eq 0) then
    return
  endif

  -- Initialise Variables
  !edge = !this.edgeLine

  -- If edge is arc, then the rotation point is its origin.
  if(!edge.objectType() eq 'ARC') then
    !!alert.warning('Can only rotate line edges.')
    return
  endif

  -- Get position
  !position = !this.loop.rotationPoint(!this.edge.val, !end)

  -- Rotate edge
  !this.rotate(!angle, !position)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate Edge about a position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to rotate about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL, !position is POSITION)

  -- Return on zero angle
  if(!angle eq 0) then
    return
  endif

  -- Initialise Variables
  !edge = !this.loop.edge(!this.edge.val)

  if(!edge.objectType() eq 'ARC') then
    !!alert.warning('Unable to rotate curved edge.')
    return
  endif

  -- Ignore rotations of zero
  if(!angle.between(-0.001, 0.001)) then
    !!alert.warning('Ignoring rotation of zero degrees.')
    return
  endif

  -- Define plane
  !orientation = object ORIENTATION('Y is ' & !edge.direction() & ' and Z is ' & !this.loop.profile.orientation.zDir())
  !plane       = object PLANE(!position, !orientation)
  !xyStart     = !plane.xyOffset(!edge.startPosition)
  !xyEnd       = !plane.xyOffset(!edge.endPosition)

  !xDirection  = !plane.position.direction(!plane.threeDPosition(object XYPOSITION(100mm * cos(!angle), 100mm * sin(!angle))))

  -- Rotate plane about the z axes by new angle
  !orientation       = object ORIENTATION('X is ' & !xDirection & ' and Z is ' & !plane.direction())
  !plane.orientation = !orientation

  !edge        = object LINE(!plane.threeDPosition(!xyStart), !plane.threeDPosition(!xyEnd))

  -- Resolve Edge
  !this.resolveEdge(!edge, 'Rotate edge ' & !angle)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Fillet
--
-- Description: Define/Redefine fillet radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fillet(!option is STRING)

  -- Initialise Variables
  !insert = !option.upcase()
  !this.solution()

  -- Check a valid radius had been supplied
  if(!this.distance.val le 0) then
    !!alert.warning('Fillet radius must be greater than zero.')
    return
  endif

  -- Fillet start
  if(!insert inset('START', 'END')) then

    -- Check if current edge is already a fillet
    if(!insert eq 'START') then
      !from     = !this.loop.previous(!this.edge.val)
      !to       = !this.edge.val
      !adjacent = !from
      !text     = 'previous'
    elseif (!insert eq 'END') then
      !from     = !this.edge.val
      !to       = !this.loop.next(!this.edge.val)
      !adjacent = !to
      !text     = 'next'
    endif

    if(!this.loop.isFillet(!adjacent)) then
      !!alert.warning('Unable to fillet between the edges, ' & !text & ' is already a fillet.')
      return
    endif
  else
    !from     = !this.loop.previous(!this.edge.val)
    !to       = !this.loop.next(!this.edge.val)
  endif

  -- Resolve edge
  !solution = !this.loop.fillet(!this.distance.val, !from, !to)

  -- Define solution
  if(!solution.set()) then
    !solution.description = 'Fillet corner - ' & !this.distance.val.string(!!distanceFmt)
    !this.solution(!solution)
  else
    !!alert.warning(!!error.text)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertArc
--
-- Description: Insert concaved/concaved edge arc into edge line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for concaved arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertArc(!concaved is BOOLEAN)

  -- Initialise Variables
  !this.solution()
  !edge     = !this.loop.edge(!this.edge.val)

  -- Resolve edge
  !from     = !this.loop.previous(!this.edge.val)
  !to       = !this.loop.next(!this.edge.val)
  !solution = !this.loop.fitArcBetween(!this.distance.val, !from, !to, !concaved)

  -- Define solution
  if(!solution.set()) then
    !solution.description = 'Fit arc edge radius (' & !this.distance.val.string(!!distanceFmt) & ')'
    !this.solution(!solution)

    if(!this.distance.val eq 0) then
      !this.distance.val = !solution.edges[1].radius
    endif

  else
    !!alert.warning(!!error.text)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertPoint
--
-- Description: Create insert point event packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertPoint()

  -- Explicit position
  if(!this.explicitForm) then

    -- Check we are at a corner
    if(undefined(!!pos2D)) then
      pml reload form !!pos2D
    endif

    -- Get position
    !xyPosition = !this.plane.xyOffset(!this.edgeLine.startPosition)

    !!pos2D.setup('!!dbeProfileEdit.insertPoint(!position)', !this.plane, !xyPosition, 'Insert point', 'Point', true, !this.edgDescription)
  else

    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.definePosition('Define point')
    !packet.key             = 'insertPoint'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.action          = '!!dbeProfileEdit.insertPoint(!this.return[1].position)'
    !packet.remove          = false

    !!edgCntrl.add(!packet)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertPoint
--
-- Description: Insert a point within a line edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertPoint(!position is POSITION)

  -- Remove previous solutions
  !this.solution()

  -- Resolve edge
  !positions[1] = !position
  !solution     = !this.loop.insertPoints(!this.edge.val, !positions)

  -- Define solution
  if(!solution.set()) then
    !solution.description = 'Insert point.'
    !this.solution(!solution)
  else
    !!alert.warning(!!error.text)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertPath
--
-- Description: Create insert path event packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertPath()

  -- Initialise Variables
  !edge      = !this.loop.edge(!this.edge.val)

  -- Initialise path data
  !this.path.clear()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Define path')
  !packet.key             = 'insertPath'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.insertPath(!this.return[1].position)'
  !packet.remove          = false

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertPath
--
-- Description: Insert a point within a line edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertPath(!position is POSITION)

  -- Remove previous solutions
  !this.solution()

  -- Resolve edge
  !this.path.append(!position)
  !solution = !this.loop.insertPoints(!this.edge.val, !this.path)

  -- Define solution
  if(!solution.set()) then
    !solution.description = 'Insert path.'
    !this.solution(!solution)
  else
    !!alert.warning(!!error.text)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      movePoint
--
-- Description: Define move point event packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End of edge or centre of arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .movePoint(!end is STRING)

  -- Check we are at a corner
  if(!end.lowcase() ne 'centre') then
    if(!this.loop.isCorner(!this.edge.val, !end).not()) then
      !!alert.warning('Can only move points at the intersection of two lines.')
      return
    endif
    !position = !this.edgeLine.attribute(!end & 'Position')
  else
    !position = !this.edgeArc.position
  endif

  if(!this.explicitForm) then

    -- Check we are at a corner
    if(undefined(!!pos2D)) then
      pml reload form !!pos2D
    endif

    -- Get position
    !xyPosition = !this.plane.xyOffset(!position)

    !!pos2D.setup('!!dbeProfileEdit.movePoint(|' & !end & '|, !position)', !this.plane, !xyPosition, 'Move ' & !end & ' point', !end, true, !this.edgDescription)

    else
    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.definePosition('Move ' & !end & ' point')
    !packet.key             = 'movePoint'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.action          = '!!dbeProfileEdit.movePoint(|' & !end & '|, !this.return[1].position)'
    !packet.remove          = false

    !!edgCntrl.add(!packet)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      movePoint
--
-- Description: Move a point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .movePoint(!end is STRING, !position is POSITION)

  -- Remove previous solutions
  !this.solution()

  -- Resolve position change of point
  if(!end.lowcase() ne 'centre') then
    !solution = !this.loop.movePoint(!this.edge.val, !end, !position)

    -- Define solution
    if(!solution.set()) then
      !solution.description = 'Move ' & !end & 'position.'
      !this.solution(!solution)
    else
      !!alert.warning(!!error.text)
    endif

  -- Move centre of arc
  else
    !description   = 'Move centre of arc.'
    !edge          = !this.edgeArc
    !edge.position = !this.plane.near(!position)

    -- Resolve Edge
    !this.resolveEdge(!edge, !description)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertLine
--
-- Description: Define packet for inserting a line into profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertLine()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to insert'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'insertLine'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!dbeProfileEdit.insertLine(!this.return[1])'
  !packet.remove            = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertLine
--
-- Description: Inserts a line into the boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line to be inserted
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertLine(!line is LINE)

  -- Initialise Variables
  !this.solution()
  !edge          = !line
  !positions     = ARRAY()
  !!line = !line

  -- Check if ends are wholly within or without the profile
  !startWithin   = !this.loop.profile.isWithin(!edge.startPosition)
  !endWithin     = !this.loop.profile.isWithin(!edge.endPosition)

  -- Get intersections
  !intersections = !this.loop.profile.intersections(!edge)

  -- Get the intersection with the boundary
  if(!intersections.empty().not()) then

    -- Determine if the intersections lie within the line
    do !i indices !intersections
      skip if(!line.onProjected(!intersections[!i]).not())
      !positions.append(!intersections[!i])
    enddo

  endif

  -- If there are no intersection that lie within the line and the
  -- ends are wholly within or wholly without then we have a simple notch!
  if(!positions.empty()) then

    -- Derive end lines normal to the line and determine the best edge
    !direction          = !this.plane.direction().orthogonal(!edge.direction())
    !startNormal        = object LINE(!edge.startPosition, !edge.startPosition.offset(!direction, 100mm))
    !endNormal          = object LINE(!edge.endPosition,   !edge.endPosition.offset(!direction, 100mm))

    -- Intersect the normal lines with the profile
    !startIntersections = !this.loop.profile.intersections(!startNormal)
    !endIntersections   = !this.loop.profile.intersections(!endNormal)

    -- Unable to get a sensible result from appending normal to the end
    if(!startIntersections.empty() or !endIntersections.empty()) then
      !!alert.warning('Unable to project line onto profile, to derive a solution.')
      return
    endif

    -- Get the nearest points to the start/end
    !startPosition      = !this.nearestPosition(!edge.startPosition, !startIntersections)
    !endPosition        = !this.nearestPosition(!edge.endPosition, !endIntersections)

    -- Define the point
    !positions[1]       = !startPosition
    !positions[2]       = !edge.startPosition
    !positions[3]       = !edge.endPosition
    !positions[4]       = !endPosition

    -- If both ends are within the profile, then we have a "remove"
    if(!startWithin and !endWithin) then
      !this.removeEdges(!positions)
    else
      !this.addEdges(!positions)
    endif

  -- Two physical intersections with the line
  elseif (!positions.size() eq 2) then

    -- Determine if it an add/remove
    if(!this.loop.profile.isWithin(!positions[1].midPoint(!positions[2]))) then
      !this.removeEdges(!positions)
    else
      !this.addEdges(!positions)
    endif

  -- Don't know what to do
  else
    !!alert.warning('Unable to derive a solution from the picked line.')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      trace
--
-- Description: Setup for tracing of lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      STRING         Action when item has been traced ADD/REMOVE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .trace(!action is STRING)

  -- Initialise Variables
  !this.fencePoints.clear()
  !!aidNumbers.hide(!this.aidFence)
  !!aidNumbers.hide(!this.aidReference)

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to trace'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'traceLines'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!dbeProfileEdit.traceLines(!this.return[1])'
  !packet.remove            = false
  !packet.escape            = '!!dbeProfileEdit.traceLines(|' & !action & '|)'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      traceLines
--
-- Description: Cache picked lines for tracing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line picked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .traceLines(!line is LINE)

  -- Project line
  !projectedLine = !line.projected(!this.plane)

  -- Check we still have a line, if its a point, then we will use it position only
  if(!projectedLine.length() eq 0) then
    !this.fencePoints.append(!projectedLine.startPosition)
  else
    !this.fencePoints.append(!projectedLine)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      traceLines
--
-- Description: Determine the boundary from the picked lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING         Action when item has been traced ADD/REMOVE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .traceLines(!action is STRING)

  -- Initialise Variables
  !this.solution()
  !!aidNumbers.hide(!this.aidFence)

  -- No lines passed
  if(!this.fencePoints.size() lt 1) then
    return

  -- If there is only once fence point, the we will try and interpret what
  -- to do with it
  elseif (!this.fencePoints.size() lt 1) then
    !this.insertLine(!this.fencePoints[1])
    return
  endif

  -- Define path
  !previous  = !this.fencePoints.first()
  do !i from 2 to !this.fencePoints.size()
    !iPositions[!i] = !previous.intersection(!this.fencePoints[!i])
    !previous       = !this.fencePoints[!i]
  enddo

  -- Determine the nearest point to the boundary at the start
  !firstPosition  = !this.onBoundary(!this.fencePoints.first(), !iPositions.first())

  -- Handle no intersection
  if(!firstPosition.unset()) then
    !!alert.warning('First line does not intersect the profile boundary.')
    return
  endif

  -- Determine the nearest point to the boundary at the start
  !lastPosition   = !this.onBoundary(!this.fencePoints.last(), !iPositions.last())

  -- Handle no intersection
  if(!lastPosition.unset()) then
    !!alert.warning('Last line does not intersect the profile boundary.')
    return
  endif

  -- Load position to pass to add/remove array
  !positions[1] = !firstPosition
  !positions.appendArray(!iPositions)
  !positions.append(!lastPosition)

  -- Add edge
  if(!action.upcase() eq 'ADD') then
    !this.addEdges(!positions)
  else
    !this.removeEdges(!positions)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edgeProfile
--
-- Description: Derive profile from passed edge data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      edges       Edges
-- Return:
--   [Data Type] [Description]
--    PROFILE     Derived profile
--
------------------------------------------------------------------------

define method .edgeProfile(!edges is ARRAY) is PROFILE

  -- Initialise Variables
  !firstEdge     = !edges.first()
  !firstEdgeType = !firstEdge.objectType()
  !lastEdge      = !edges.last()
  !lastEdgeType  = !lastEdge.objectType()

  -- Get first/last points on boundary
  if(!firstEdgeType eq 'LINE') then
    !firstPosition = !firstEdge.startPosition
  elseif (!firstEdgeType eq 'ARC') then
    !firstPosition = !firstEdge.anglePosition(!firstEdge.anglePosition)
  elseif (!firstEdgeType eq 'POSITION') then
    !firstPosition = !firstEdge
  endif

   if(!lastEdgeType eq 'LINE') then
    !lastPosition  = !lastEdge.startPosition
  elseif (!lastEdgeType eq 'ARC') then
    !lastPosition  = !lastEdge.anglePosition(!lastEdge.anglePosition)
  elseif (!lastEdgeType eq 'POSITION') then
    !lastPosition  = !lastEdge
  endif

  -- Get edges nearest to the first and last point
  !firstEdgeIndex  = !this.loop.profile.nearEdges(!firstPosition)[1]
  !lastEdgeIndex   = !this.loop.profile.nearEdges(!lastPosition)[1]

  -- Get edge between the start and end
  !profileEdges = ARRAY()
  if(!firstEdgeIndex ge !lastEdgeIndex) then
    !step = -1
  else
    !step = 1
  endif

  do !i from !firstEdgeIndex to !lastEdgeIndex by !step
    !profileEdges.append(!this.loop.profile.edge(!i))
  enddo

  -- Invert order point if the start is greater than the end edge
  if(!firstEdgeIndex ge !lastEdgeIndex) then
    !first = 'end'
    !last  = 'start'
  else
    !edges.invert()
    !first = 'start'
    !last  = 'end'
  endif

  -- Modify the start/end edges to the first and last positions
  if(!profileEdges[1].objectType() eq 'LINE') then
    !profileEdges[1].attribute(!first & 'Position')     = !firstPosition
  else
    !profileEdges[1].attribute(!first & 'Angle')        = !profileEdges[1].near(!firstPosition)
  endif

  !index = !profileEdges.size()
  if(!profileEdges[!index].objectType() eq 'LINE') then
    !profileEdges[!index].attribute(!last & 'Position') = !lastPosition
  else
    !profileEdges[!index].attribute(!last & 'Angle')    = !profileEdges[!index].near(!lastPosition)
  endif

  -- Append position to edges
  !profileEdges.appendArray(!edges)
  !profileEdges.compress()
  !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !profileEdges)
  !profile.mergePoints(0.1mm)
  !profile.mergeArcs(350, 1mm)
  !profile.close()

  return !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addEdges
--
-- Description: Add edges to the boundary, uses start of the first and end of the last edges to determine the insertion point.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      edges       Edges
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addEdges(!edges is ARRAY)

  -- Get profile from edge and boundary
  !profile    = !this.edgeProfile(!edges)

  -- Handle unset profiles
  if(!profile.unset()) then
     !!alert.warning('Unable to derive profile to add to edges.')
    return
  endif

  -- Get the union of the profile and edges
  !union      = !this.loop.profile.union(!profile)
  !profile    = object PROFILE(!union[1])

  -- If union is unset, then we have not result
  if(undefined(!union)) then
    !!alert.warning('No intersection between profiles.')
    return
  endif

  -- Define solution
  !profile.mergeArcs(350, 1mm)

  -- Define solution
  !this.featureSolution(!profile, 'Include around edge(s)')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeEdges
--
-- Description: Remove edges to the boundary, uses start of the first and end of the last edges to determine the insertion point.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      edges       Edges
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeEdges(!edges is ARRAY)

  -- Get profile from edge and boundary
  !profile    = !this.edgeProfile(!edges)

  -- Handle unset profiles
  if(!profile.unset()) then
     !!alert.warning('Unable to derive profile to remove to edges.')
    return
  endif

  -- Get the union of the profile and edges
  !difference = !this.loop.profile.difference(!profile)
  !profile    = object PROFILE(!difference[1])

  -- If union is unset, then we have not result
  if(undefined(!difference)) then
    !!alert.warning('No intersection between profiles.')
    return
  endif

  -- Define solution
  !profile.mergeArcs(350, 1mm)

  -- Define solution
  !this.featureSolution(!profile, 'Removed around edge(s)')


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nearestPosition
--
-- Description: Get the nearest position from the passed array to the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Reference position
--    2   R      ARRAY       Array of position
-- Return:
--   [Data Type] [Description]
--    POSITION    Nearest position
--
------------------------------------------------------------------------

define method .nearestPosition(!position is POSITION, !positions is ARRAY) is POSITION

  -- Initialise Variables
  do !i indices !positions
    !distances[!i] = !positions[!i].distance(!position)
  enddo
  !sort = !distances.sortedIndices()
  return !positions[!sort[1]]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      onBoundary
--
-- Description: Get the nearest point on the boundary for the passed line, using the reference position used to drive the best point on boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line
--    2   R      POSITION    Reference position
-- Return:
--   [Data Type] [Description]
--    POSITION    Nearest position
--
------------------------------------------------------------------------

define method .onBoundary(!line is LINE, !position is POSITION) is POSITION

  -- Initialise Variables
  !positions  = ARRAY()

  -- Get intersections of the line on the boundary
  !iPositions = !this.loop.profile.intersections(!line)

  -- Check if line actually intersects the boundary
  do !i indices !iPositions
    skip if(!line.onProjected(!iPositions[!i]).not())
    !positions.append(!iPositions[!i])
  enddo

  -- If there are no intersections, then use the point to the nearest passed intersection position
  if(!positions.empty()) then
    !positions = !iPositions
  endif

  -- Return
  return !this.nearestPosition(!position, !positions)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      onBoundary
--
-- Description: Get the nearest point on the boundary for the passed item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc
-- Return:
--   [Data Type] [Description]
--    POSITION    Nearest position
--
------------------------------------------------------------------------

define method .onBoundary(!arc is ARC, !position is POSITION) is POSITION

  -- Initialise Variables

  -- Return
  return object POSITION()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileSelect
--
-- Description: Define selection of a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSelect(!option is STRING, !action is STRING)

  -- Initialise Variables
  !method      = !option.lowcase()

  -- Action
  !this.action = !action.lowcase()

  -- Select current element
  if(!method eq 'ce') then
    !this.profileSelect(!!ce)

  -- Select picked element
  elseif (!method eq 'picked') then

    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.key             = 'pickFeature'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.pickPacket.stdElement('Pick element')
    !packet.action          = '!!dbeProfileEdit.profileSelect(!this.return[1].item)'
    !packet.remove          = true

    -- Add event to EDG system
    !!edgCntrl.add(!packet)

  -- Select picked arc
  elseif (!method eq 'picked arc') then

    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.key             = 'pickFeature'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.pickPacket.circleDerive()
    !packet.action          = '!!dbeProfileEdit.profileSelect(!this.return[1])'
    !packet.remove          = true

    -- Add event to EDG system
    !!edgCntrl.add(!packet)

  -- Select portion of Current DB element
  elseif (!method.match('portion') gt 0) then

    -- Current element
    if(!option.match('ce') gt 0) then
      !feature            = object DBELOOPFEATURE()
      !features           = !feature.features(!!ce)
    endif

    -- Positive portion
    if(!method.match('positive') gt 0) then
      !this.fencePositive = true
    else
      !this.fencePositive = false
    endif

    -- No feature for item
    if(!features.empty()) then
      !!alert.warning(!!error.text)
      return
    endif

    -- If there are more than one feature, then choose
    if(!features.size() gt 1) then
      !!dbeFeatureSelect.setup(!features, '!!dbeProfileEdit.fence(!profile)')
      return
    endif

    -- Define feature fence
    !this.fence(!features[1].profile, !this.fencePositive)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileSelect
--
-- Description: Add passed element into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSelect(!element is DBREF)

  -- Initialise Variables
  !feature    = object DBELOOPFEATURE()

  -- Get profiles found for element
  !features   = !feature.features(!element)

  -- Handle no profiles returned
  if(!features.empty()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- If there is more than one feature, then select the relevant one
  if(!features.size() gt 1) then
    !!dbeFeatureSelect.setup(!features, '!!dbeProfileEdit.profileApply(!profile)')

  -- Use first profile
  else
    !this.profileApply(!features[1].profile)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileSelect
--
-- Description: Add passed arc into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSelect(!arc is ARC)

  -- Unset arc
  if(!arc.unset()) then
    !!alert.warning('No arc has been derived.')
    return
  endif

  -- Initialise Variables

  -- Define profile
  !array[1]    = !arc
  !profile     = object PROFILE(!arc.position, !arc.orientation, !array)
  !profile.close()

  -- Get profiles found for element
  !feature     = object DBELOOPFEATURE(!profile, 'Copied arc')
  !features[1] = !feature

  -- If there is more than one feature, then select the relevant one
  if(!features.size() gt 1) then
    !!dbeFeatureSelect.setup(!features, '!!dbeProfileEdit.profileApply(!profile)')

  -- Use first profile
  else
    !this.profileApply(!features[1].profile)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileApply
--
-- Description: Apply the profile to using the current action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   RW     profile        Profile
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileApply(!profile is PROFILE)

  -- Initialise Variables
  !sense       = !this.loop.profile.sense()
  !feature     = object DBELOOPFEATURE(!profile)

  -- Project profile onto plane
  if(!this.outProjected) then
    !feature.project(!this.plane)
  else
    !feature.intersect(!this.plane)
  endif

  -- Add/Remove Feature to profile
  if(!this.action inset('add', 'remove', 'intersect')) then

    -- Check that profiles intersect
    if(!feature.profile.isIntersecting(!this.loop.profile).not()) then
      !!alert.warning('Feature and profile do not overlap.')
      return
    endif

    -- Add feature to boundary
    if(!this.action eq 'add') then
      !newProfiles = !this.loop.profile.union(!feature.profile)
      !description = 'Insert stand out'

    -- Remove feature from boundary
    elseif (!this.action eq 'remove') then
      !newProfiles = !this.loop.profile.difference(!feature.profile)
      !description = 'Insert cutout'

    -- Intersect feature from boundary
    else
      !newProfiles = !this.loop.profile.intersect(!feature.profile)
      !description = 'Use intersection'

    endif

    -- Select first profile (but we need to ask where there is more than one)
    do !i indices !newProfiles

      -- Merge arcs
      !newProfiles[!i].mergeArcs(350, 1mm)

    enddo

    -- If there is more than 1 profile, then select the one
    if(!newProfiles.size() gt 1) then
      !!dbeProfileSelect.setup(!this.loop.profile, !newProfiles, '!!dbeProfileEdit.featureSolution(!profile, |' & !description & '|)', '!!dbeFeatureEdit.add(!profiles, |Excess "' & !description & '"|)' )

    -- Only a single profile
    else
      !this.profileSolution(!newProfiles[1], !description)
    endif

  -- Replace with feature
  elseif (!this.action eq 'replace') then
    !this.profileSolution(!feature.profile, 'Replace profile')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileSolution
--
-- Description: Add profile solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      PROFILE        Profile
--    2   R      STRING         Description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSolution(!profile is PROFILE, !description is STRING)

  -- Define solution
  !solution             = object DBELOOPSOLUTION()
  !solution.description = !description
  !solution.profile     = !profile
  !solution.edgeIndex   = !this.edge.val
  !solution.edgeNumbers.append(!this.edge.val)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Set reference profile and define fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to define fence about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence(!profile is PROFILE)

  -- Initialise Variables
  !this.fence(!profile, true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Set reference profile and define fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to define fence about
--    2   R      BOOLEAN     True if positive is to be used
--                           False if negative is to be used
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence(!profile is PROFILE, !positive is BOOLEAN)

  -- Initialise Variables
  !this.referenceProfile = object PROFILE(!profile)
  !this.fencePositive    = !positive
  !this.drawReference()

  -- Define fence
  !this.fenceDefine('Define portion of profile', '!!dbeProfileEdit.fence()')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fence
--
-- Description: Define feature from fence and reference profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fence()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidFence)
  !!aidNumbers.hide(!this.aidReference)

  -- Intersection of reference and fence profiles
  if(!this.fencePositive) then
    !text     = 'Positive'
    !profiles = !this.referenceProfile.intersect(!this.fence)
  else
    !text     = 'Negative'
    !profiles = !this.fence.difference(!this.referenceProfile)
  endif

  -- If there are no profile
  if(!profiles.empty()) then
    !!alert.warning('There is no intersection between the reference profile and the defined fence.')
    return
  endif

  -- If there is more than one profile, then inform the user
  if(!profiles.size() gt 1) then
    !!alert.message('More than one profile has been derived, including all into the system.')
  endif

  -- All all profiles to the system
  do !i indices !profiles
    !this.profileApply(!profiles[!i])
  enddo

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      fenceDefine
--
-- Description: Define packet for defining a "fence"
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Description
--    2   R      STRING      Action on completion
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fenceDefine(!description is STRING, !action is STRING)

  -- Initialise Variables
  !this.fencePoints.clear()
  !this.fence             = object PROFILE()
  !this.drawFence()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Define fence')
  !packet.key             = !description
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.fenceDefine(!this.return[1].position)'
  !packet.remove          = false
  !packet.escape          = !action

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fenceDefine
--
-- Description: Cache picked points of defining fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Screen pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fenceDefine(!passedPosition is POSITION)

  -- Map position onto plane
  !position = !this.plane.near(!passedPosition)

  -- Add position to fence point list
  !this.fencePoints.append(!position)

  -- If we have more than one point, then we can draw the fence
  if(!this.fencePoints.size() gt 1) then
    !this.fence = object PROFILE(!this.plane.position, !this.plane.orientation, !this.fencePoints)
    !this.fence.close()
    !this.drawFence()
  else
    AID TEXT NUMBER $!<this.aidFence> 'Start' AT $!<position>
  endif

endmethod
-- End of method
