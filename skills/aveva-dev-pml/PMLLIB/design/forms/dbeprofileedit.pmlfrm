--
-- File:            dbeprofileedit.pmlfrm
--   Type:          Form Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Dec 16 10:32:09 "GMT 1999
--
--
-- Description:
-- Profile editor for "profile" based elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addEdges(ARRAY)                  -                   Add edges to the boundary, uses start of the first and end of the last edges to determine the insertion point.
--  arcType(BOOLEAN)                 -                   Change arc type
--  boundaryMirror()                 -                   Mirror loop about line
--  boundaryMirror(LINE)             -                   Mirror profile on passed line
--  boundaryMove()                   -                   Move all profile with an offset
--  boundaryMove(XYPOSITION)         -                   Move all profile with an offset
--  boundaryOrigin()                 -                   Move origin of profile, without moving its physical position
--  boundaryOrigin(POSITION)         -                   Move or reposition features origin
--  boundaryRotate()                 -                   Rotate about origin
--  boundaryTrim()                   -                   Trim panel to picked line
--  boundaryTrim(LINE)               -                   Trim profile on passed line
--  close()                          -                   Close for down
--  dbeProfileEdit()                 -                   Constructor
--  deleteBetween()                  -
--  deleteBetween(ARRAY)             -                   Determine the edges to delete between
--  deleteBetween(REAL,REAL)         -                   Delete the passed edges
--  deleteCoincident()               -                   Delete all coincident points
--  deleteColinear()                 -                   Delete all co-linear edges
--  deleteEdge()                     -                   Define packet for deleting between edges
--  deleteRadii()                    -                   Delete all radii edges
--  draw()                           -                   Draw boundary
--  drawFeature()                    -                   Draw feature
--  drawFence()                      -                   Draw defined fence
--  drawPlane()                      -                   Draw origin plane
--  drawReference()                  -                   Draw defined reference profile
--  drawSolution()                   -                   Draw solution
--  edgeProfile(ARRAY)               PROFILE             Derive profile from passed edge data
--  featureAlign(LINE,STRING)        -                   Align feature with item
--  featureAlign(STRING)             -                   Align feature with item
--  featureApply(DBELOOPFEATURE,STRING) -                   Apply passed feature to the profile
--  featureClear()                   -
--  featureDefine()                  -                   Pick a feature
--  featureFlip(STRING)              -                   Flip feature about axes
--  featurePosition(POSITION,STRING) -                   Move or reposition features origin
--  featurePosition(STRING)          -                   Move or reposition features origin
--  featureRepeat(POSITION,STRING)   -                   Defines packet for positioning and repeat feature inclusion
--  featureRepeat(STRING)            -                   Defines packet for positioning and repeat feature inclusion
--  featureReplace(DBELOOPFEATURE)   -                   Replace current feature with passed feature
--  featureRotate(POSITION,STRING)   -                   Rotate passed axes towards position (mapped onto plane)
--  featureRotate(REAL)              -                   Rotate feature about its origin
--  featureRotate(STRING)            -                   Rotate passed axes towards a given point
--  featureSelect(STRING)            -                   Define selection of a feature
--  featureSolution(PROFILE,STRING)  -                   Add feature solution
--  featureUpdate()                  -                   Pick a feature
--  fence()                          -                   Define feature from fence and reference profile
--  fence(PROFILE)                   -                   Set reference profile and define fence
--  fence(PROFILE,BOOLEAN)           -                   Set reference profile and define fence
--  fenceDefine(POSITION)            -                   Cache picked points of defining fence
--  fenceDefine(STRING,STRING)       -                   Define packet for defining a "fence"
--  fillet(STRING)                   -
--  insertArc(BOOLEAN)               -                   Insert concaved/concaved edge arc into edge line
--  insertLine()                     -                   Define packet for inserting a line into profile
--  insertLine(LINE)                 -                   Inserts a line into the boundary
--  insertPath()                     -                   Create insert path event packet
--  insertPath(POSITION)             -                   Insert a point within a line edge
--  insertPoint()                    -                   Create insert point event packet
--  insertPoint(POSITION)            -                   Insert a point within a line edge
--  mergeArcs()                      -                   Merge adjacent arcs
--  movePoint(STRING)                -                   Define move point event packet
--  movePoint(STRING,POSITION)       -                   Move a point
--  nearestPosition(POSITION,ARRAY)  POSITION            Get the nearest position from the passed array to the passed position
--  offset(REAL)                     -                   Offset Edge by passed distance
--  offsetTangential()               -                   Define packet for  for .offsetTangential(....)
--  offsetTangential(POINTVECTOR)    -                   Offset Edge
--  offsetThrough()                  -                   Define packet for offsetting through a position
--  offsetThrough(EDGPOSITIONDATA)   -                   Offset Edge
--  onBoundary(ARC,POSITION)         POSITION            Get the nearest point on the boundary for the passed item
--  onBoundary(LINE,POSITION)        POSITION            Get the nearest point on the boundary for the passed line, using the reference position used to drive the best point on boundary
--  pick()                           -                   Pick element to update
--  pickEdge()                       -                   Pick edge
--  pickEdge(ANY)                    -                   Pick edge
--  profileApply(PROFILE)            -                   Apply the profile to using the current action
--  profileSelect(ARC)               -                   Add passed arc into the system
--  profileSelect(DBREF)             -                   Add passed element into the system
--  profileSelect(STRING,STRING)     -                   Define selection of a feature
--  profileSolution(PROFILE,STRING)  -                   Add profile solution
--  radius(REAL)                     -                   Modify radius of edge
--  removeEdges(ARRAY)               -                   Remove edges to the boundary, uses start of the first and end of the last edges to determine the insertion point.
--  resolveEdge(ANY,STRING)          -                   Resolve the edge with the passed new edge
--  rotate(REAL,POSITION)            -                   Rotate Edge about a position
--  rotate(REAL,STRING)              -                   Rotate Edge about an end
--  rotateNormal(LINE,STRING)        -                   Rotate edge so that it is parallel to picked edge
--  rotateNormal(STRING)             -                   Define packet for .normal(....)
--  rotateParallel(LINE,STRING)      -                   Rotate edge so that it is parallel to picked edge
--  rotateParallel(STRING)           -                   Define packet for .parallel(....)
--  rotateTowards(POSITION,STRING)   -                   Rotate edge so that it is parallel to picked edge
--  rotateTowards(STRING)            -                   Define packet for .rotate towards/through a position
--  save()                           -                   Save profile to database
--  selectEdge(REAL)                 -                   Move to edge
--  setup()                          -                   Setup for current element
--  setup(DBREF)                     -                   Setup for passed element
--  setup(DBREF,PROFILE)             BOOLEAN             Setup for creating loop in passed element, using passed profile as a starting point
--  setup(DBREF,STRING)              -                   Setup for form with passed element and application action
--  setupGadgets()                   -                   Setup gadgets
--  solution()                       -                   Initialise the current solution
--  solution(DBELOOPSOLUTION)        -                   Replace current solutions with passed single solution
--  solutionGadgets()                -                   Setup solution gadgets
--  solutionRedo()                   -                   Reinstate the last undo
--  solutionUndo()                   -                   Reinstate the last definition
--  tangential()                     -                   Make edge tangential to adjacent
--  tidy()                           -                   Tidy up graphics
--  trace(STRING)                    -                   Setup for tracing of lines
--  traceLines(LINE)                 -                   Cache picked lines for tracing
--  traceLines(STRING)               -                   Determine the boundary from the picked lines
--  useSolution()                    -                   Update definition with current solution
--

setup form !!dbeProfileEdit size 55 2

  !this.formTitle     = 'Profile Editor'
  !this.iconTitle     = 'Profile Edit'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.2 $ '

  -- Body of form definition

  -- Bar Menu
  bar
  exit

  -- Edge movement
  frame .edgeFrame 'Edge'         at xmin           ymin
    path right
    button .pickEdge                                pixmap height 16 width 16 tooltip 'Select edge'           callback '!this.pickEdge()'
    button .previousEdge          at xmax      ymin pixmap height 12 width 9  tooltip 'Move to previous edge' callback '!this.selectEdge(!this.edge.val - 1)'
    text   .edge                  at xmax+0.25 ymin                           tooltip 'Edge of loop'          callback '!this.selectEdge(!this.edge.val)' width 4 is REAL format !!integerFmt
    button .nextEdge              at xmax ymin      pixmap height 12 width 9  tooltip 'Move to next edge'     callback '!this.selectEdge(!this.edge.val + 1)'
  exit

  -- Angle actions
  frame .rotateFrame 'Rotate'     at xmax+0.5          ymin
    path right
    hdist 0
    text .angle                                       tooltip 'Angle value'             width  6 is REAL format !!angleFmt
    button .rotateStart     pixmap height 16 width 16 tooltip 'Rotate edge about start'          callback '!this.rotate(!this.angle.val, |start|)'
    button .rotateEnd       pixmap height 16 width 16 tooltip 'Rotate edge about end'            callback '!this.rotate(!this.angle.val, |end|)'
    button .rotateFeature   pixmap height 16 width 16 tooltip 'Rotate feature about its origin'  callback '!this.featureRotate(!this.angle.val)'
  exit

  -- Movement
  frame .moveFrame 'Position'     at xmax+0.5          ymin
    button .moveStart       pixmap height 16 width 16 tooltip 'Move start of line'               callback '!this.movePoint(|start|)'
    button .moveEnd         pixmap height 16 width 16 tooltip 'Move end of line'                 callback '!this.movePoint(|end|)'
    button .edgeThrough     pixmap height 16 width 16 tooltip 'Move edge through a point'        callback '!this.offsetThrough()'
  exit

  -- Distance actions
  frame .distanceFrame 'Distances' at xmin.rotateFrame ymax
    text .distance                                    tooltip 'Distance value'        width 14 is REAL format !!distanceFmt
    button .radiusApply     pixmap height 16 width 16 tooltip 'Apply radius to edge'             callback '!this.radius(!this.distance.val)'
    button .offset          pixmap height 16 width 16 tooltip 'Offset edge'                      callback '!this.offset(!this.distance.val)'
    button .filletStart     pixmap height 16 width 16 tooltip 'Define fillet at start of line'   callback '!this.fillet(|start|)'
    button .filletEnd       pixmap height 16 width 16 tooltip 'Define fillet at end of line'     callback '!this.fillet(|end|)'
  exit

  -- Apply current solution
  button .use 'Apply'             at xmin form-0    ymax form-size  callback '!this.useSolution()'

  -- Form members

  -- Panel/Extrusion name
  member .profileName          is STRING

  -- Owner of loop
  member .owner                is DBREF

  -- Loop type
  member .type                 is STRING

  -- Loop Definition
  member .loop                 is DBELOOP

  -- Reference plane of loop
  member .plane                is PLANE

  -- Edge Type
  member .edgeIsLine           is BOOLEAN

  -- Profile is complete circle
  member .isCircle             is BOOLEAN

  -- Current edge data
  member .edgeArc              is ARC
  member .edgeLine             is LINE
  member .edgeIsFillet         is BOOLEAN

  -- Undo/Redo Lists
  member .undoList             is ARRAY
  member .redoList             is ARRAY

  -- Fence operation
  member .fencePoints          is ARRAY

  -- Fence
  member .fence                is PROFILE

  -- Fence side
  member .fencePositive        is BOOLEAN

  -- Path definition
  member .path                 is ARRAY

  -- Reference item (profile)
  member .referenceProfile     is PROFILE

  -- Feature Definition
  member .feature              is DBELOOPFEATURE

  -- Solution
  member .solution             is DBELOOPSOLUTION

  -- Action
  member .action               is STRING

  -- Subsequent action on save (this is external to the form and
  -- should be managed by the relevant applications using the editor)
  member .applicationAction    is BLOCK

  -- Event Description
  member .edgDescription       is STRING

  -- Aid Data
  -- Edge tag
  member .aidEdgeTag           is REAL

  -- Outer boundary definition
  member .aidProfile           is REAL
  member .aidProfileLineStyle  is REAL
  member .aidProfileColour     is REAL

  -- Plane definition
  member .aidPlane             is REAL
  member .aidPlaneLineStyle    is REAL
  member .aidPlaneColour       is REAL

  -- Feature definition
  member .aidFeature           is REAL
  member .aidFeatureLineStyle  is REAL
  member .aidFeatureColour     is REAL

  -- Feature origin definition
  member .aidFeatureOrigin     is REAL

  -- Feature definition
  member .aidSolution          is REAL
  member .aidSolutionLineStyle is REAL
  member .aidSolutionColour    is REAL

  -- Feature definition
  member .aidFence             is REAL
  member .aidFenceLineStyle    is REAL
  member .aidFenceColour       is REAL

  -- Reference definition
  member .aidReference           is REAL
  member .aidReferenceLineStyle  is REAL
  member .aidReferenceColour     is REAL

  -- Edited
  member .edited               is BOOLEAN

  -- Toggles
  member .outProjected         is BOOLEAN
  member .repeatFeatures       is BOOLEAN
  member .resolveDeletions     is BOOLEAN
  member .dynamicUpdate        is BOOLEAN
  member .explicitForm         is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeProfileEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeProfileEdit()

  -- Initialise Variables

  -- Make sure feature editor is defined
  if(undefined(!!dbeFeatureEdit)) then
    pml reload form !!dbeFeatureEdit
  endif
  if(undefined(!!dbeFeatureSelect)) then
    pml reload form !!dbeFeatureSelect
  endif
  if(undefined(!!dbeProfileSelect)) then
    pml reload form !!dbeProfileSelect
  endif

  -- Cancel Callback
  !this.cancelCall     = '!this.close()'

  -- EDG Description
  !this.edgDescription = 'Profile Editor'

  -- Edited
  !this.edited         = false

  -- Bar Menu Definition
  !bar = !this.bar
  !bar.add('Control',  'menuControl')
  !bar.add('Boundary', 'menuBoundary')
  !bar.add('Feature',  'menuFeature')
  !bar.add('Create',   'menuCreate')
  !bar.add('Modify',   'menuModify')
  !bar.add('Delete',   'menuDelete')

  -- Control Menu
  !menu = !this.newMenu('menuControl')
    !menu.add('callback', 'Undo',                 '!this.solutionUndo()')
    !menu.add('callback', 'Redo',                 '!this.solutionRedo()')
    !menu.add('separator')
    !menu.add('callback', 'Settings...',          'show !!dbeProfileSettings')
    !menu.add('separator')
    !menu.add('menu',     'Select',               'menuSelect')
    !menu.add('callback', 'Save to DB',           '!this.save()')
    !menu.add('separator')
    !menu.add('callback', 'Close',                '!this.close()')

    -- Select Menu
    !menu = !this.newMenu('menuSelect')
      !menu.add('callback', 'CE',                 '!this.setup()')
      !menu.add('callback', 'Pick',               '!this.pick()')

  -- Boundary Menu
  !menu = !this.newMenu('menuBoundary')
    !menu.add('callback', 'Origin...',            '!this.boundaryOrigin()')
    !menu.add('callback', 'Move...',              '!this.boundaryMove()')
    !menu.add('callback', 'Rotate',               '!this.boundaryRotate()')
    !menu.add('separator')
    !menu.add('callback', 'Mirror',               '!this.boundaryMirror()')
    !menu.add('callback', 'Trim',                 '!this.boundaryTrim()')

  -- Feature Menu
  !menu = !this.newMenu('menuFeature')
    !menu.add('menu',     'Select',               'menuFeatureSelect')
    !menu.add('callback', 'Definition...',        '!this.featureDefine()')
    !menu.add('callback', 'Clear',                '!this.featureClear()')
    !menu.add('separator')
    !menu.add('menu',     'Position',             'menuFeaturePosition')
    !menu.add('menu',     'Rotate',               'menuFeatureRotate')
    !menu.add('menu',     'Flip',                 'menuFeatureFlip')
    !menu.add('separator')
    !menu.add('callback', 'Stand out',            '!this.featureRepeat(|add|)')
    !menu.add('callback', 'Cutout',               '!this.featureRepeat(|remove|)')
    !menu.add('callback', 'Patch',                '!this.featureRepeat(|patch|)')
    !menu.add('callback', 'Overlap',              '!this.featureRepeat(|intersect|)')
    !menu.add('callback', 'Replace',              '!this.featureRepeat(|replace|)')

    -- Select Feature Menu
    !menu = !this.newMenu('menuFeatureSelect')
      !menu.add('callback', 'CE',                          '!this.featureSelect(|ce|)')
      !menu.add('callback', 'Pick',                        '!this.featureSelect(|pick|)')
      !menu.add('callback', 'Positive Portion of Profile', '!this.featureSelect(|positive|)')
      !menu.add('callback', 'Negative Portion of Profile', '!this.featureSelect(|negative|)')

    -- Modify Feature Menu
    !menu = !this.newMenu('menuFeaturePosition')
      !menu.add('callback', 'Move',               '!this.featurePosition(|move|)')
      !menu.add('callback', 'Origin',             '!this.featurePosition(|origin|)')

    -- Rotate Feature Menu
    !menu = !this.newMenu('menuFeatureRotate')
      !menu.add('callback', 'X Align',            '!this.featureAlign(|X|)')
      !menu.add('callback', 'Y Align',            '!this.featureAlign(|Y|)')
      !menu.add('separator')
      !menu.add('callback', 'X Towards',          '!this.featureRotate(|X|)')
      !menu.add('callback', 'Y Towards',          '!this.featureRotate(|Y|)')

    -- Flip Feature Menu
    !menu = !this.newMenu('menuFeatureFlip')
      !menu.add('callback', 'about X',            '!this.featureFlip(|X|)')
      !menu.add('callback', 'about Y',            '!this.featureFlip(|Y|)')

  -- menuCreate Menu
  !menu = !this.newMenu('menuCreate')
    !menu.add('callback', 'Point',                '!this.insertPoint()')
    !menu.add('callback', 'Path',                 '!this.insertPath()')
    !menu.add('callback', 'Edge',                 '!this.insertLine()')
    !menu.add('separator')
    !menu.add('menu', 'Insert Arc',               'menuCreateArc')
    !menu.add('menu', 'Fillet',                   'menuCreateFillet')
    !menu.add('separator')
    !menu.add('menu', 'Stand out',                'menuCreateAdd')
    !menu.add('menu', 'Cutout',                   'menuCreateRemove')
    !menu.add('menu', 'Overlap',                  'menuCreateOverlap')
    !menu.add('menu', 'Replace',                  'menuCreateReplace')

    -- Arc Menu
    !menu = !this.newMenu('menuCreateArc')
      !menu.add('callback', 'Concaved',           '!this.insertArc(true)')
      !menu.add('callback', 'Convexed',           '!this.insertArc(false)')

    -- Fillet Menu
    !menu = !this.newMenu('menuCreateFillet')
      !menu.add('callback', 'at Start',           '!this.fillet(|start|)')
      !menu.add('callback', 'at End',             '!this.fillet(|end|)')
      !menu.add('callback', 'Redefine',           '!this.fillet(|redefine|)')

    -- Add Menu
    !menu = !this.newMenu('menuCreateAdd')
      !menu.add('callback', 'using CE',                     '!this.profileSelect(|ce|,                  |add|)')
      !menu.add('callback', 'using picked',                 '!this.profileSelect(|picked|,              |add|)')
      !menu.add('callback', 'using picked arc',             '!this.profileSelect(|picked arc|,           |add|)')
      !menu.add('callback', 'using positive portion of CE', '!this.profileSelect(|portion ce positive|, |add|)')
      !menu.add('callback', 'using negative portion of CE', '!this.profileSelect(|portion ce negative|, |add|)')
      !menu.add('callback', 'using trace lines',            '!this.trace(|add|)')

    -- Remove Menu
    !menu = !this.newMenu('menuCreateRemove')
      !menu.add('callback', 'using CE',                     '!this.profileSelect(|ce|,                  |remove|)')
      !menu.add('callback', 'using picked',                 '!this.profileSelect(|picked|,              |remove|)')
      !menu.add('callback', 'using picked arc',             '!this.profileSelect(|picked arc|,           |remove|)')
      !menu.add('callback', 'using positive portion of CE', '!this.profileSelect(|portion ce positive|, |remove|)')
      !menu.add('callback', 'using negative portion of CE', '!this.profileSelect(|portion ce negative|, |remove|)')
      !menu.add('callback', 'using trace lines',            '!this.trace(|remove|)')

    -- Intersect Menu
    !menu = !this.newMenu('menuCreateOverlap')
      !menu.add('callback', 'using CE',                     '!this.profileSelect(|ce|,                  |intersect|)')
      !menu.add('callback', 'using picked',                 '!this.profileSelect(|picked|,              |intersect|)')
      !menu.add('callback', 'using picked arc',             '!this.profileSelect(|picked arc|,           |intersect|)')

    -- Replace Menu
    !menu = !this.newMenu('menuCreateReplace')
      !menu.add('callback', 'using CE',                     '!this.profileSelect(|ce|,                  |replace|)')
      !menu.add('callback', 'using picked',                 '!this.profileSelect(|picked|,              |replace|)')
      !menu.add('callback', 'using picked arc',             '!this.profileSelect(|picked arc|,           |replace|)')

  -- Modify Menu
  !menu = !this.newMenu('menuModify')
    !menu.add('Menu',     'Arc',                    'menuModifyArc')
    !menu.add('Menu',     'Point',                  'menuModifyPoint')
    !menu.add('separator')
    !menu.add('callback', 'Tangential',             '!this.tangential()')
    !menu.add('Menu',     'Offset',                 'menuModifyOffset')
    !menu.add('Menu',     'Rotate',                 'menuModifyRotate')

    -- Modify Arc Menu
    !menu = !this.newMenu('menuModifyArc')
      !menu.add('callback', 'Centre',               '!this.movePoint(|centre|)')
      !menu.add('separator')
      !menu.add('toggle', 'Major',                  '!this.arcType(false)')
      !menu.add('toggle', 'Minor',                  '!this.arcType(true)')

    -- Modify Point Menu
    !menu = !this.newMenu('menuModifyPoint')
      !menu.add('callback', 'at Start',             '!this.movePoint(|start|)')
      !menu.add('callback', 'at End',               '!this.movePoint(|end|)')

    -- Offset Edges Menu
    !menu = !this.newMenu('menuModifyOffset')
      !menu.add('callback', 'Through',              '!this.offsetThrough()')
      !menu.add('callback', 'Tangential',           '!this.offsetTangential()')

    -- Rotate Edges Menu
    !menu = !this.newMenu('menuModifyRotate')
      !menu.add('callback', 'Parallel about start', '!this.rotateParallel(|start|)')
      !menu.add('callback', 'Parallel about end',   '!this.rotateParallel(|end|)')
      !menu.add('separator')
      !menu.add('callback', 'Normal about start',   '!this.rotateNormal(|start|)')
      !menu.add('callback', 'Normal about end',     '!this.rotateNormal(|end|)')
      !menu.add('separator')
      !menu.add('callback', 'about start Towards',  '!this.rotateTowards(|start|)')
      !menu.add('callback', 'about end Towards',    '!this.rotateTowards(|end|)')

  -- Delete Menu
  !menu = !this.newMenu('menuDelete')
    !menu.add('callback', 'Edge',                 '!this.deleteEdge()')
    !menu.add('callback', 'Edges',                '!this.deleteBetween()')
    !menu.add('separator')
    !menu.add('callback', 'Co-linear Edges',      '!this.deleteColinear()')
    !menu.add('callback', 'Coincident Points',    '!this.deleteCoincident()')
    !menu.add('callback', 'Merge Arcs',           '!this.mergeArcs()')
    !menu.add('callback', 'Radii',                '!this.deleteRadii()')

  -- Icons
  !this.nextEdge.addPixmap(!!pml.getPathName('rightarrow9x12.png'))
  !this.previousEdge.addPixmap(!!pml.getPathName('leftarrow9x12.png'))
  !this.pickEdge.addPixmap(!!pml.getPathName('navigate16.png'), !!pml.getPathName('navigate16.png'), !!pml.getPathName('unknownicon16.png'))

  !this.rotateStart.addPixmap(!!pml.getPathName('linerotateright16.png'), !!pml.getPathName('linerotateright16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.rotateEnd.addPixmap(!!pml.getPathName('linerotateleft16.png'), !!pml.getPathName('linerotateleft16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.rotateFeature.addPixmap(!!pml.getPathName('grouprotateright16.png'), !!pml.getPathName('grouprotateright16.png'), !!pml.getPathName('unknownicon16.png'))

  !this.radiusApply.addPixmap(!!pml.getPathName('radius16.png'), !!pml.getPathName('radius16.png'),!!pml.getPathName('unknownicon16.png'))
  !this.offset.addPixmap(!!pml.getPathName('offset16.png'), !!pml.getPathName('offset16.png'),!!pml.getPathName('unknownicon16.png'))
  !this.filletStart.addPixmap(!!pml.getPathName('filletleft16.png'), !!pml.getPathName('filletleft16.png'),!!pml.getPathName('unknownicon16.png'))
  !this.filletEnd.addPixmap(!!pml.getPathName('filletright16.png'), !!pml.getPathName('filletright16.png'),!!pml.getPathName('unknownicon16.png'))

  !this.moveStart.addPixmap(!!pml.getPathName('linemoveright16.png'), !!pml.getPathName('linemoveright16.png'),!!pml.getPathName('unknownicon16.png'))
  !this.moveEnd.addPixmap(!!pml.getPathName('linemoveleft16.png'), !!pml.getPathName('linemoveleft16.png'),!!pml.getPathName('unknownicon16.png'))
  !this.edgeThrough.addPixmap(!!pml.getPathName('offsetthrough16.png'), !!pml.getPathName('offsetthrough16.png'),!!pml.getPathName('unknownicon16.png'))

  -- Aid definitions
  !this.aidEdgeTag            = !!aidNumbers.add(!this.edgDescription & ' - Edge Tag')

  !this.aidProfile            = !!aidNumbers.add(!this.edgDescription & ' - Profile')
  !this.aidProfileLineStyle   = 1
  !this.aidProfileColour      = 4

  !this.aidPlane              = !!aidNumbers.add(!this.edgDescription & ' - Plane')
  !this.aidPlaneLineStyle     = 4
  !this.aidPlaneColour        = 5

  !this.aidSolution           = !!aidNumbers.add(!this.edgDescription & ' - Solution')
  !this.aidSolutionLineStyle  = 1
  !this.aidSolutionColour     = 2

  !this.aidFeature            = !!aidNumbers.add(!this.edgDescription & ' - Feature')
  !this.aidFeatureOrigin      = !!aidNumbers.add(!this.edgDescription & ' - Feature Origin')
  !this.aidFeatureLineStyle   = 2
  !this.aidFeatureColour      = 6

  !this.aidFence              = !!aidNumbers.add(!this.edgDescription & ' - Fence')
  !this.aidFenceLineStyle     = 2
  !this.aidFenceColour        = 7

  !this.aidReference          = !!aidNumbers.add(!this.edgDescription & ' - Reference')
  !this.aidReferenceLineStyle = 2
  !this.aidReferenceColour    = 1

  -- Initialise Input
  !this.distance.val          = 0
  !this.angle.val             = 0

  -- Default settings
  !this.outProjected          = true
  !this.repeatFeatures        = false
  !this.resolveDeletions      = false
  !this.dynamicUpdate         = false
  !this.explicitForm          = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save profile to database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()

  -- Initialise Variables
  !reference = !!ce

  -- Check we don't have a self intersecting loop
  if(!this.loop.profile.isValidClosed().not()) then
    if(!!alert.confirm('The profile definition is invalid and will not draw, OK to save to DB?').boolean().not()) then
      return
    endif
  endif

  -- If there is no loop define, then we will have to define it
  if(!this.loop.loop.unset()) then
    !!ce = !this.owner
    NEW $!<this.type>
    !this.loop.loop = !!ce
    !!ce            = !reference

    -- Forcibly set edit
    !this.edited    = true
  endif

  -- Save loop to db
  if(!this.edited) then
    !this.loop.save()
    handle any
      -- read only
      !!alert.error( !!ce.moderr.pos )
      return false
    endhandle
  endif

  -- Secondary/Application action
  if(!this.applicationAction.set()) then

    -- Exposed Information passed to application action
    !loop           = !this.loop

    -- Execute application action
    !this.applicationAction.evaluate()

  endif

  -- Edited
  !this.edited = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close for down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  -- Is there any changes to apply
  if(!this.edited) then
    if(!!alert.confirm('OK to save changes?').boolean()) then
      !this.save()
    endif
  endif

  -- Reset edited flag
  !this.edited = false

  -- Remove event from the system
  !!edgCntrl.remove(!this.edgDescription)

  -- Tidy up graphics
  !this.tidy()

  -- Hide form
  !this.hide()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Hide graphic lines
  !!aidNumbers.hide(!this.aidEdgeTag)
  !!aidNumbers.hide(!this.aidProfile)
  !!aidNumbers.hide(!this.aidPlane)
  !!aidNumbers.hide(!this.aidSolution)
  !!aidNumbers.hide(!this.aidFeature)
  !!aidNumbers.hide(!this.aidFeatureOrigin)
  !!aidNumbers.hide(!this.aidFence)
  !!aidNumbers.hide(!this.aidReference)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupGadgets
--
-- Description: Setup gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupGadgets()

  -- Initialise Variables

  -- Line gadgets
  if(!this.edgeIsLine) then

    -- Menu entries
    !this.menuCreate.setActive('Point', true)
    !this.menuCreate.setActive('Path', true)

    !this.menuCreate.setActive('Insert Arc', true)

    !this.menuModify.setActive('Arc', false)
    !this.menuModify.setActive('Point', true)
    !this.menuModify.setActive('Offset', true)
    !this.menuModify.setActive('Rotate', true)

    !this.menuCreate.setActive('Fillet', true)

    -- Buttons
    -- Distance
    !this.radiusApply.active     = false
    !this.offset.active          = true
    !this.filletStart.active     = true
    !this.filletEnd.active       = true

    -- Angle
    !this.rotateStart.active     = true
    !this.rotateEnd.active       = true

    -- Movement
    !this.moveStart.active       = true
    !this.moveEnd.active         = true
    !this.edgeThrough.active     = true

  -- Arc gadgets
  else
    !this.menuCreate.setActive('Point', false)
    !this.menuCreate.setActive('Path', false)

    !this.menuCreate.setActive('Insert Arc', false)

    !this.menuModify.setActive('Arc', true)
    !this.menuModify.setActive('Point', false)
    !this.menuModify.setActive('Offset', false)
    !this.menuModify.setActive('Rotate', false)

    -- Fillet
    if(!this.edgeIsFillet) then
      !this.menuCreate.setActive('Fillet', false)
      !this.menuModify.setActive('Arc', false)

    -- None Fillet Edge
    else

      -- Suppress command not permissible for complete circles
      if(!this.isCircle) then
        !this.menuCreate.setActive('Fillet', false)
        !this.menuModifyArc.setActive('Major', false)
        !this.menuModifyArc.setActive('Minor', false)
      else
        !this.menuCreate.setActive('Fillet', true)
        !this.menuModify.setActive('Arc', true)
        !this.menuModifyArc.setActive('Major', true)
        !this.menuModifyArc.setActive('Minor', true)
      endif
    endif

    -- Buttons
    -- Distance
    !this.radiusApply.active     = true
    !this.offset.active          = false
    !this.filletStart.active     = false
    !this.filletEnd.active       = false

    -- Angle
    !this.rotateStart.active     = false
    !this.rotateEnd.active       = false

    -- Movement
    !this.moveStart.active       = false
    !this.moveEnd.active         = false
    !this.edgeThrough.active     = false

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.setup(!!ce)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for form with passed element and application action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop to edit
--    2   R      STRING      Action to carry out on completion
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!element is DBREF, !appAction is STRING)

  -- Initialise Variables
  !this.applicationAction = object BLOCK(!appAction)
  !this.setup(!element)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!element is DBREF)

  -- Is there any changes to apply
  if(!this.edited) then
    if(!!alert.confirm('OK to save changes?').boolean()) then
      !this.loop.save()
    endif
  endif

  -- Is the current element a loop
  if(!element.hardtype inset('PLOO','LOOP')) then
    !loop = !element

  -- Check if we can access a loop element, either directly below the
  -- passed element or if there is one above
  else

    -- Build list of elements
    !ownerList = !element.ownLst
    !ownerList.invert()
    !members   = !element.members
    !members.appendArray(!ownerList)

    do !member values !members

      -- If the member is a loop, then we will use it
      if(!member.hardtype inset('PLOO','LOOP')) then
        !loop = !member
        break
      endif
    enddo

    -- Check if there is a loop
    if(undefined(!loop)) then
      !!alert.warning('No loop element found.')
      return
    endif

  endif

  -- Setup form members
  !this.owner       = !loop.owner
  !this.type        = object STRING()
  !this.loop        = object DBELOOP(!loop)
  !this.plane       = !this.loop.plane()

  -- Setup form gadgets
  !this.profileName = !loop.owner.flnn

  -- Form title
  !this.formTitle   = 'Profile Editor - ' & !this.profileName

  -- Empty undo/redo lists
  !this.undoList.clear()
  !this.redoList.clear()

  -- Draw boundary
  !this.draw()

  -- Draw origin plane
  !this.drawPlane()

  -- Set Edge
  !this.selectEdge(1)

  -- If a feature is set, then map onto the form
  if(!this.feature.set()) then
    !this.feature.profile.position    = !this.plane.position
    !this.feature.profile.orientation = !this.plane.orientation
    !this.drawFeature()
  endif

  -- Setup features gadgets
  !this.featureUpdate()

  -- Show Form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for creating loop in passed element, using passed profile as a starting point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element that can own a loop/ploop
--    2   R      PROFILE     PROFILE
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can setup ok
--
------------------------------------------------------------------------

define method .setup(!element is DBREF, !profile is PROFILE) is BOOLEAN

  -- Is there any changes to apply
  if(!this.edited) then
    if(!!alert.confirm('OK to save changes?').boolean()) then
      !this.loop.save()
    endif
  endif

  -- Check if element can own a loop
  !offSpringTypes = !element.list
  if(!offSpringTypes.findFirst('PLOO').unset()) then
    if(!offSpringTypes.findFirst('LOOP').unset()) then
      !!alert.warning('Unable to create profile beneath the passed element.')
      return false
    else
      !this.type    = 'LOOP'
    endif
  else
    !this.type      = 'PLOOP'
  endif

  -- Owner
  !this.owner       = !element

  -- Setup form members
  !this.loop        = object DBELOOP(!profile)
  !this.plane       = !this.loop.plane()

  -- Setup form gadgets
  !this.profileName = !this.owner.flnn

  -- Form title
  !this.formTitle   = 'Profile Editor - ' & !this.profileName

  -- Empty undo/redo lists
  !this.undoList.clear()
  !this.redoList.clear()

  -- Draw boundary
  !this.draw()

  -- Draw origin plane
  !this.drawPlane()

  -- Set Edge
  !this.selectEdge(1)

  -- If a feature is set, then map onto the form
  if(!this.feature.set()) then
    !this.feature.profile.position    = !this.plane.position
    !this.feature.profile.orientation = !this.plane.orientation
    !this.drawFeature()
  endif

  -- Setup features gadgets
  !this.featureUpdate()

  -- Show Form
  !this.show()

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Pick element to update
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick()

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick item to be modified')
  !packet.action         = '!!dbeProfileEdit.setup(!this.return[1].item)'

  !packet.key            = 'Profile Edit'
  !packet.description    = !this.edgDescription
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickEdge
--
-- Description: Pick edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickEdge()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'pickEdge'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.pickEdge(!this.return[1])'
  !packet.pickPacket.stdAid('Pick edge')
  !packet.pickPacket.stdScreen('Pick edge')
  !packet.pickPacket.picks[1].prompt          = ''
  !packet.pickPacket.picks[1].pick.cursor     = 'pick'
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.remove          = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickEdge
--
-- Description: Pick edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Pickdata
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickEdge(!pickData is ANY)

  -- Initialise Variables
  !iPosition    = !this.loop.plane.intersection(!pickData)
  !edgeNumbers  = !this.loop.profile.nearEdges(!iPosition)
  !this.selectEdge(!edgeNumbers[1])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectEdge
--
-- Description: Move to edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectEdge(!index is REAL)

  -- Initialise Variables
  !this.solution()
  !!aidNumbers.hide(!this.aidEdgeTag)
  !edgeNumber      = !index
  !edges           = !this.loop.profile.edges()
  !numberEdges     = !edges.size()

  if(!index gt !numberEdges) then
    !edgeNumber    = 1
  elseif (!index lt 1) then
    !edgeNumber    = !numberEdges
  endif

  -- Redefine edge
  !this.edge.val   = !edgeNumber

  -- Edge
  !edge            = !edges[!edgeNumber]

  -- Is profile full circle
  !this.isCircle   = !this.loop.profile.isCircle()

 -- Tag Edge
  if(!edge.objectType() eq 'LINE') then
    !this.edgeIsLine   = true
    !this.edgeLine     = !edge

    -- Tag Line Edges
    -- Zero length edges
    if(!edge.length() eq 0) then
      !midPoint        = !edge.startPosition
    else
      !midPoint        = !edge.proportion(0.5)
    endif
    !start             = !edge.startPosition
    !end               = !edge.endPosition

  -- Arcs
  else
    !this.edgeIsLine   = false
    !this.edgeArc      = !edge
    !this.distance.val = !this.edgeArc.radius
    !this.edgeIsFillet = !this.loop.profile.isFillet(!this.edge.val)

    -- Set major/minor flag
    !isMinor           = !edge.angle().gt(180).not()
    !this.menuModifyArc.select('Major', !isMinor.not())
    !this.menuModifyArc.select('Minor', !isMinor)

    -- Tag Arc Edges
    -- Handle sense of arc
    if(!edge.sense) then
      !angle           = !edge.angle() / 2 + !edge.startAngle
    else
      !angle           = !edge.angle() / 2 + !edge.endAngle
    endif
    !midPoint          = !edge.anglePosition(!angle)
    !start             = !edge.anglePosition(!edge.startAngle)
    !end               = !edge.anglePosition(!edge.endAngle)
    if(!this.edgeIsFillet) then
      AID TEXT  NUMBER $!<this.aidEdgeTag> 'Fillet' AT $!<edge.position>
    else
      AID TEXT  NUMBER $!<this.aidEdgeTag> 'Centre' AT $!<edge.position>
    endif

    !centreLine        = object LINE(!edge.position, !edge.position.offset(!this.plane.direction(),100mm))
    !centreLine.draw(!this.aidEdgeTag, !this.aidPlaneLineStyle, !this.aidPlaneColour)

  endif

  -- Tag edge
  AID TEXT NUMBER $!<this.aidEdgeTag> '[$!this.edge.val]' AT $!<midPoint>
  AID TEXT NUMBER $!<this.aidEdgeTag> 'Start' AT $!<start>
  AID TEXT NUMBER $!<this.aidEdgeTag> 'End'   AT $!<end>

  -- Setup gadgets
  !this.setupGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawFence
--
-- Description: Draw defined fence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawFence()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidFence)

  if(!this.fence.unset()) then
    return
  endif

  -- Draw fence
  !this.fence.draw(!this.aidFence, !this.aidFenceLineStyle, !this.aidFenceColour)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawReference
--
-- Description: Draw defined reference profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawReference()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidReference)

  if(!this.referenceProfile.unset()) then
    return
  endif

  -- Draw fence
  !this.referenceProfile.draw(!this.aidReference, !this.aidReferenceLineStyle, !this.aidReferenceColour)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawPlane
--
-- Description: Draw origin plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPlane()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidPlane)
  -- Axes of plane
  !plane     = !this.plane
  !xPositive = !plane.position.offset(!plane.orientation.xDir(), 500mm)
  !xNegative = !plane.position.offset(!plane.orientation.xDir().opposite(), 100mm)
  !yPositive = !plane.position.offset(!plane.orientation.yDir(), 500mm)
  !yNegative = !plane.position.offset(!plane.orientation.yDir().opposite(), 100mm)

  !xLine     = object LINE(!xPositive, !xNegative)
  !xLine.draw(!this.aidPlane, !this.aidPlaneLineStyle , !this.aidPlaneColour)
  !yLine     = object LINE(!yPositive, !yNegative)
  !yLine.draw(!this.aidPlane, !this.aidPlaneLineStyle , !this.aidPlaneColour)

  AID TEXT NUMBER $!<this.aidPlane> 'X' AT $!<xPositive>
  AID TEXT NUMBER $!<this.aidPlane> 'Y' AT $!<yPositive>
  AID TEXT NUMBER $!<this.aidPlane> 'Origin' AT $!<plane.position>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawFeature
--
-- Description: Draw feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawFeature()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidFeature)
  !!aidNumbers.hide(!this.aidFeatureOrigin)

  -- Check there is a feature
  if(!this.feature.profile.position.unset()) then
    return
  endif

  -- Axes of plane
  !plane     = !this.feature.profile.plane()
  !xPositive = !plane.position.offset(!plane.orientation.xDir(), 250mm)
  !xNegative = !plane.position.offset(!plane.orientation.xDir().opposite(), 50mm)
  !yPositive = !plane.position.offset(!plane.orientation.yDir(), 250mm)
  !yNegative = !plane.position.offset(!plane.orientation.yDir().opposite(), 50mm)

  !xLine     = object LINE(!xPositive, !xNegative)
  !xLine.draw(!this.aidFeatureOrigin, !this.aidPlaneLineStyle , !this.aidFeatureColour)
  !yLine     = object LINE(!yPositive, !yNegative)
  !yLine.draw(!this.aidFeatureOrigin, !this.aidPlaneLineStyle , !this.aidFeatureColour)

  AID TEXT NUMBER $!<this.aidFeature> 'X' AT $!<xPositive>
  AID TEXT NUMBER $!<this.aidFeature> 'Y' AT $!<yPositive>

  -- Draw the feature
  !this.feature.profile.draw(!this.aidFeature, !this.aidFeatureLineStyle , !this.aidFeatureColour)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawSolution
--
-- Description: Draw solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawSolution()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidSolution)

  -- Check there is a feature
  if(!this.solution.unset()) then
    return
  endif

  -- Draw solution (profile if set)
  if(!this.solution.profile.position.set()) then
    !this.solution.profile.draw(!this.aidSolution, !this.aidSolutionLineStyle , !this.aidSolutionColour)

  -- Draw solution (edges)
  else
    !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !this.solution.edges)
    !profile.draw(!this.aidSolution, !this.aidSolutionLineStyle , !this.aidSolutionColour)
  endif

endmethod
-- End of method of .draw()

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidProfile)

  -- Draw the outer boundary
  !this.loop.profile.draw(!this.aidProfile, !this.aidProfileLineStyle , !this.aidProfileColour)

endmethod
-- End of method of .draw()

------------------------------------------------------------------------
--
-- Method:      deleteEdge
--
-- Description: Delete an edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteEdge()

   -- Initialise Variables
  !from       = !this.loop.previous(!this.edge.val)
  !to         = !this.loop.next(!this.edge.val)

  -- If edge is a line, then there is no need to do this
  if(!this.loop.edge(!this.edge.val).objectType() eq 'LINE' and !this.resolveDeletions.not()) then
    !!alert.warning('Removing a line edge will have no effect, set "Resolve edge(s)" on the "Profile Settings" form.')
    return
  endif

  -- Delete between edges
  !this.deleteBetween(!from, !to)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteEdge
--
-- Description: Define packet for deleting between edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteBetween()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'pickDeleteBetween'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.deleteBetween(!this.return[1])'
  !packet.remove          = true

    -- Set Data
  !packet.pickPacket.key          = 'pickDeleteBetween'
  !packet.pickPacket.description  = 'Pick edges to delete between'
  !packet.pickPacket.prompt       = 'Delete'
  !packet.pickPacket.picks[1]             = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdScreen('between (1)')
  !packet.pickPacket.picks[1].pick.cursor = 'pick'
  !packet.pickPacket.picks[2]             = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdScreen('between (2)')
  !packet.pickPacket.picks[2].pick.cursor = 'pick'
  !packet.pickPacket.picks[3]             = object EDGPICKTYPE()
  !packet.pickPacket.picks[3].stdScreen('through')
  !packet.pickPacket.picks[3].pick.cursor = 'pick'

  -- Add event to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteBetween
--
-- Description: Determine the edges to delete between
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of point vectors
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteBetween(!pointVectors is ARRAY)

  -- Check that we have 3 elements
  if(!pointVectors.size() ne 3) then
    !!alert.warning('Invalid number of points passed to derive edges to remove.')
    return
  endif

  -- Loop through the points and get edges
  do !i indices !pointVectors
    !position = !this.plane.intersection(!pointVectors[!i])
    !edge[!i] = !this.loop.profile.nearEdges(!position)[1]
  enddo

  -- Check for silly data
  if(!edge[1] eq !edge[2]) then
    !!alert.warning('The "start" and "end" picks MUST be different.')
    return
  endif

  -- Define and sort range
  !range[1] = !edge[1]
  !range[2] = !edge[2]
  !range.sort()

  !from = !edge[1]
  !to   = !edge[2]

  -- Swap from to values
  if((!edge[1] lt !edge[2] and !edge[3].between(!range[1], !range[2]).not()) or (!edge[1] gt !edge[2] and !edge[3].between(!range[1], !range[2]))) then
    !from = !edge[2]
    !to   = !edge[1]
  endif

  -- Delete between edges (exclusive)
  !this.deleteBetween(!from, !to)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteBetween
--
-- Description: Delete the passed edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        From edge
--    2   R      REAL        End edge
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteBetween(!from is REAL, !to is REAL)

  -- Resolve adjacent edges
  if(!this.resolveDeletions) then
    !solution = !this.loop.resolveCorner(!from, !to)
  else

    !solution = !this.loop.removeBetween(!from, !to)
  endif

  if(!solution.set()) then
    !solution.description = 'Delete edge'
    !this.solution(!solution)
  else
    !!alert.warning('Unable to resolve the deletion of the edge.')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteColinear
--
-- Description: Delete all co-linear edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteColinear()

  -- Initialise Variables
  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Remove co-linear edges'

  -- Define packet
  !solution.profile     = object PROFILE(!this.loop.profile)
  !solution.profile.mergeLines()

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteRadii
--
-- Description: Delete all radii edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteRadii()

  -- Initialise Variables
  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Remove arcs'

  -- Define packet
  !solution.profile     = object PROFILE(!this.loop.profile)
  !solution.profile.projectArcs(0.1)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeArcs
--
-- Description: Merge adjacent arcs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mergeArcs()

  -- Initialise Variables
  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Merge arcs'

  -- Define packet
  !solution.profile     = object PROFILE(!this.loop.profile)
  !solution.profile.mergeArcs(350, 1mm)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteCoincident
--
-- Description: Delete all coincident points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCoincident()

  -- Initialise Variables
  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Remove coincident points'

  -- Define packet
  !solution.profile     = object PROFILE(!this.loop.profile)
  !solution.profile.mergePoints(0.01)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolveEdge
--
-- Description: Resolve the edge with the passed new edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Edge definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resolveEdge(!edge is ANY, !description is STRING)

  -- Initialise Variables
  !this.solution()

  -- Resolve edge
  !solution = !this.loop.resolveEdge(!this.edge.val, !edge)

  -- Define solution
  if(!solution.set()) then
    !solution.description = !description
    !this.solution(!solution)
  else
    !!alert.warning(!!error.text)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      solution
--
-- Description: Initialise the current solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .solution()

  -- Initialise Variables
  !this.solution   = object DBELOOPSOLUTION()
  !this.solutionGadgets()
  !!aidNumbers.hide(!this.aidSolution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      solution
--
-- Description: Replace current solutions with passed single solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      DBELOOPSOLUTION Solution
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .solution(!solution is DBELOOPSOLUTION)

  -- Only allow define solutions to be passed
  if(!solution.set()) then

    -- Set solution
    !this.solution = !solution
    !this.use.setTooltip(!this.solution.description)

    -- If Dynamic solution applied, then do it
    if(!this.dynamicUpdate) then
      !this.useSolution()

     -- Retain and display solution
    else

      -- Setup gadgets
      !this.solutionGadgets()

      -- Draw
      !this.drawSolution()
    endif

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useSolution
--
-- Description: Update definition with current solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useSolution()

  -- Initialise Variables
  !solution         = !this.solution

  -- Save last definition
  !this.redoList.clear()
--   !this.redo.active = false
  !undo[1]          = !this.edge.val
  !undo[2]          = !this.loop.profile
  !undo[3]          = !solution.description
  !this.undoList.insert(1, !undo)

--   !this.undo.active = true
--   !this.undo.setTooltip('Undo - ' & !solution.description)

  -- Handle complete replacement, i.e. .profile of solution has been passed
  if(!solution.profile.position.set()) then
    !this.plane = !solution.profile.plane()
    !this.loop.replace(!solution.profile)
    !this.drawPlane()

  -- Insert edges into boundary
  else

    -- Sort and invert the edges to be removed/modified
    !solution.edgeNumbers.sort().invert()

    -- Get definition
    !definition = !this.loop.definition()

    -- Remove elements in reverse order (this is so we don't have a problem
    -- of a changing indices)
    do !index values !solution.edgeNumbers
      !definition[!index].delete()
      handle any
      endhandle
    enddo

    -- Insert new edges (solution[2]) from last (first numerically) into the
    -- edge array
    !definition.insertArray(!solution.edgeNumbers.last(), !solution.edges)

    -- Update loop with new definition
    !this.loop.replace(!definition)

  endif

  -- Update gadgets
  !this.solutionGadgets()

  -- Redraw boundary
  !this.draw()

  -- Re select the current index
  if(!solution.edgeNumbers.empty().not()) then
    !index = !solution.edgeNumbers.last() + !solution.edgeIndex - 1
  else
    !index = !this.edge.val
    if(!this.loop.profile.numberEdges() lt !index) then
      !index = !this.loop.profile.numberEdges()
    endif
  endif
  !this.selectEdge(!index)

  -- Empty solution
  !this.solution()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      solutionUndo
--
-- Description: Reinstate the last definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .solutionUndo()

  -- Get the first definition from the undo list
  !undo             = !this.undoList.remove(1)

  -- Retain current definition in the redo list
  !redo[1]          = !this.edge.val
  !redo[2]          = !this.loop.profile
  !redo[3]          = !undo[3]
  !this.redoList.insert(1, !redo)

  -- Update gadgets
  !this.solutionGadgets()

--   !this.redo.active = true
--   !this.redo.setTooltip('Redo - ' & !redo[3])

--   -- Grey in/out undo button
--   if(!this.undoList.empty().not()) then
--     !this.undo.setTooltip('Undo - ' & !this.undoList.first()[3])
--   endif

  -- Update loop with new definition
  !this.loop.replace(!undo[2])
  !this.draw()
  !this.selectEdge(!undo[1])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      solutionRedo
--
-- Description: Reinstate the last undo
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .solutionRedo()

  -- Get the first definition from the redo list
  !redo             = !this.redoList.remove(1)

  -- Retain current definition in the undo list
  !undo[1]          = !this.edge.val
  !undo[2]          = !this.loop.profile
  !undo[3]          = !redo[3]
  !this.undoList.insert(1, !undo)

  -- Update gadgets
  !this.solutionGadgets()

--   !this.undo.active = true
--   !this.undo.setTooltip('Undo - ' & !redo[3])
--
--   -- Grey in/out redo button
--   if(!this.redoList.empty().not()) then
--     !this.redo.active = true
--     !this.redo.setTooltip('Redo - ' & !this.redoList.first()[3])
--   else
--     !this.redo.active = false
--   endif

  -- Update loop with new definition
  !this.loop.replace(!redo[2])
  !this.draw()
  !this.selectEdge(!redo[1])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      solutionGadgets
--
-- Description: Setup solution gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .solutionGadgets()

  -- If there is no solution, grey all gadgets out
 !this.use.active  = !this.solution.description.set()
  !this.menuControl.setActive('Undo', !this.undoList.empty().not())
  !this.menuControl.setActive('Redo', !this.redoList.empty().not())

  -- Profile has been modified, i.e there are changes in the undo list
  !this.edited      = !this.undoList.empty().not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureUpdate
--
-- Description: Pick a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureUpdate()

  -- Initialise Variables
  !features = !this.feature.profile.set()

  -- Set menu up
  !this.menuFeature.setActive('Position',  !features)
  !this.menuFeature.setActive('Rotate',    !features)
  !this.menuFeature.setActive('Flip',      !features)

  !this.menuFeature.setActive('Stand out', !features)
  !this.menuFeature.setActive('Cutout',    !features)
  !this.menuFeature.setActive('Patch',     !features)
  !this.menuFeature.setActive('Overlap',   !features)
  !this.menuFeature.setActive('Replace',   !features)

  !this.rotateFeature.active = !features

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureDefine
--
-- Description: Pick a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureDefine()

  -- Initialise Variables
  !!dbeFeatureEdit.setup(!this.feature, '!!dbeProfileEdit.featureReplace(!feature)')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureDefine
--
-- Description: Pick a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureClear()

  -- Initialise Variables
  !this.feature = object DBELOOPFEATURE()
  !this.drawFeature()
  !this.featureUpdate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureReplace
--
-- Description: Replace current feature with passed feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOPFEATURE New feature
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureReplace(!feature is DBELOOPFEATURE)

  -- Initialise Variables

  -- Handle unset profiles
  if(!feature.profile.unset()) then
    !this.feature  = object DBELOOPFEATURE()
  else
    -- If there is already a feature set, then use it position and orientation
    if(!this.feature.profile.set()) then
      !position    = !this.feature.profile.position
      !orientation = !this.feature.profile.orientation
    else
      !position    = !this.loop.profile.position
      !orientation = !this.loop.profile.orientation
    endif

    -- Set the current feature
    !this.feature                     = object DBELOOPFEATURE(!feature)
    !this.feature.profile.position    = !position
    !this.feature.profile.orientation = !orientation

  endif

  -- Update feature menus
  !this.featureUpdate()

  -- Draw feature
  !this.drawFeature()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureSelect
--
-- Description: Define selection of a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Option      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureSelect(!option is STRING)

  -- Initialise Variables
  !method = !option.lowcase()

  -- Select current element
  if(!method eq 'ce') then
    !!dbeFeatureEdit.select(!!ce, true)

  -- Select picked element
  elseif (!method eq 'pick') then

    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.key             = 'pickFeature'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.pickPacket.stdElement('Pick element to define feature from')
    !packet.action          = '!!dbeFeatureEdit.select(!this.return[1].item, true)'
    !packet.remove          = true

    -- Add event to EDG system
    !!edgCntrl.add(!packet)

  -- Positive/Negative portion of current profile
  else
    if(!method eq 'positive') then
      !positive = true
    else
      !positive = false
    endif
    !!dbeFeatureEdit.fence(!this.loop.profile, !positive, true)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureRepeat
--
-- Description: Defines packet for positioning and repeat feature inclusion
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      STRING         Feature picked options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureRepeat(!option is STRING)

  -- Initialise Variables
  if(!this.repeatFeatures and not !option.upcase() inset('INTERSECT', 'REPLACE')) then

    -- Explicit position
    if(!this.explicitForm) then

      -- Check we are at a corner
      if(undefined(!!pos2D)) then
        pml reload form !!pos2D
      endif

      !prompt     = 'Derive position for ' & !option.lowcase()

      -- Get position
      !xyPosition = !this.plane.xyOffset(!this.feature.profile.position)

      !!pos2D.setup('!!dbeProfileEdit.featureRepeat(!position, |' & !option & '|)', !this.plane, !xyPosition, !prompt, 'Position', true, !this.edgDescription)

    else

      !prompt = 'Position to ' & !option.lowcase() & ' feature'

      -- Packet definition
      !packet                 = object EDGPACKET()
      !packet.definePosition(!prompt)
      !packet.key             = 'featureRepeat'
      !packet.description     = !this.edgDescription
      !packet.priority        = 1
      !packet.action          = '!!dbeProfileEdit.featureRepeat(!this.return[1].position, |' & !option & '|)'
      !packet.remove          = false
      !packet.close           = '!!dbeProfileEdit.drawFeature()'

      !!edgCntrl.add(!packet)

    endif

  -- Feature
  else
    !this.featureApply(!this.feature, !option)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureRepeat
--
-- Description: Defines packet for positioning and repeat feature inclusion
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      POSITION       New position
--    2   R      STRING         Feature picked options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureRepeat(!position is POSITION, !option is STRING)

  -- Initialise Variables
  !this.feature.position(!position)
  !this.featureApply(!this.feature, !option)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureApply
--
-- Description: Apply passed feature to the profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   RW     DBELOOPFEATURE Feature
--    2   R      STRING         Feature picked options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureApply(!feature is DBELOOPFEATURE, !option is STRING)

  -- Initialise Variables
  !method      = !option.lowcase()
  !sense       = !this.loop.profile.sense()

  -- Add/Remove Feature to profile
  if(!method inset('add', 'remove', 'patch', 'intersect')) then

    -- Check that profiles intersect
    if(!feature.profile.isIntersecting(!this.loop.profile).not()) then
      !!alert.warning('Feature and profile do not overlap.')
      return
    endif

    -- Add feature to boundary
    if(!method eq 'add') then
      !description  = 'Stand out feature'
      !newProfiles  = !this.loop.profile.union(!feature.profile)

    -- Remove feature from boundary
    elseif (!method eq 'remove') then
      !description  = 'Cutout feature'
      !newProfiles  = !this.loop.profile.difference(!feature.profile)

    -- Intersect feature from boundary
    elseif (!method eq 'intersect') then
      !description  = 'Overlap feature'
      !newProfiles  = !this.loop.profile.intersect(!feature.profile)

    -- Patch a feature in, i.e. remove then add the feature
    else
      !description  = 'Patched feature'

      -- Intersection between the feature and the loop (this is the blank we want
      -- to take out of the profile)
      !intersection = !this.loop.profile.intersect(!feature.profile)

      -- If there is no intersections, then we'll assume an add
      if(!intersection.empty()) then
        !newProfiles  = !this.loop.profile.union(!feature.profile)

      else

        -- Remove the blank from the profile
        !differences  = !this.loop.profile.difference(!intersection[1])

        -- Union the feature profile with the difference
        !union        = !feature.profile.union(!differences[1])

        -- Define new profile
        if(!union.size() eq 1) then
          !newProfiles[1] = !union[1]

        -- Handle multiple results
        else
          !!alert.warning('Unable to patch feature into the profile, the feature may fragment the profile. Define a simpler feature to patch.')
          return
          -- Patch into the segment with the
          do !i from 2 to !differences.size()
            write('Need something here')
          enddo
        endif

      endif

    endif

    -- Select first profile (but we need to ask where there is more than one)
    do !i indices !newProfiles

      -- Merge arcs
      !newProfiles[!i].mergeArcs(350, 1mm)

    enddo

    -- If there is more than 1 profile, then select the one
    if(!newProfiles.size() gt 1) then
      !!dbeProfileSelect.setup(!this.loop.profile, !newProfiles, '!!dbeProfileEdit.featureSolution(!profile, |' & !description & '|)', '!!dbeFeatureEdit.add(!profiles, |Excess "' & !description & '"|)' )

    -- Only a single profile
    else
      !this.featureSolution(!newProfiles[1], !description)
    endif

  -- Replace with feature
  elseif (!method eq 'replace') then
    !this.featureSolution(!this.feature.profile, 'Replace with feature')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureSolution
--
-- Description: Add feature solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      PROFILE        Profile
--    2   R      STRING         Description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureSolution(!profile is PROFILE, !description is STRING)

  -- Define solution
  !solution             = object DBELOOPSOLUTION()
  !solution.description = !description
  !solution.profile     = !profile
  !solution.edgeIndex   = !this.edge.val
  !solution.edgeNumbers.append(!this.edge.val)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featurePosition
--
-- Description: Move or reposition features origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      STRING         Feature picked options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featurePosition(!option is STRING)

  -- Initialise Variables
  if(!option.upcase() eq 'MOVE') then
    !prompt = 'Derive feature position'
    !tag    = 'New position'
  else
    !prompt = 'Derive feature origin'
    !tag    = 'New origin'
  endif

  -- Explicit position
  if(!this.explicitForm) then

    -- Check we are at a corner
    if(undefined(!!pos2D)) then
      pml reload form !!pos2D
    endif

    -- Get position
    !xyPosition = !this.plane.xyOffset(!this.feature.profile.position)

    !!pos2D.setup('!!dbeProfileEdit.featurePosition(!position, |' & !option & '|)', !this.plane, !xyPosition, !prompt, !tag, true, !this.edgDescription)

  else

    -- Packet definition
    !packet                 = object EDGPACKET()
    !packet.definePosition(!prompt)
    !packet.key             = 'featurePosition'
    !packet.description     = !this.edgDescription
    !packet.priority        = 1
    !packet.action          = '!!dbeProfileEdit.featurePosition(!this.return[1].position, |' & !option & '|)'
    !packet.remove          = true

    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featurePosition
--
-- Description: Move or reposition features origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      POSITION       Position
--    2   R      STRING         Feature picked options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featurePosition(!position is POSITION, !option is STRING)

  -- Move feature
  if(!option.upcase() eq 'MOVE') then
    !this.feature.position(!position)

  -- Move origin of feature
  else
    !this.feature.origin(!position)

    -- Replace the feature in the system
    !!dbeFeatureEdit.replace(!this.feature)
  endif


  -- Draw feature
  !this.drawFeature()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureAlign
--
-- Description: Align feature with item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      STRING         Axes to align with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureAlign(!axes is STRING)

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'featureAlign'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.featureAlign(!this.return[1],|' & !axes & '|)'
  !packet.remove          = true
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt          = 'Pick line to align with'
  !packet.pickPacket.picks[1].prompt = ''

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureAlign
--
-- Description: Align feature with item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      LINE           Pick line
--    2   R      STRING         Axes to align with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureAlign(!line is LINE, !axes is STRING)

  -- Map line onto plane
  !referenceLine                    = !line.projected(!this.plane)

  -- Check if reference line is > zero
  if(!referenceLine.length() le 0) then
    !!alert.warning('Unable to derive direction from projected line.')
    return
  endif

  -- Get Directions
  !direction                        = !referenceLine.direction()
  !zDirection                       = !this.feature.profile.orientation.zDir()

  -- Re-orientate feature
  !this.feature.profile.orientation = object ORIENTATION('Z is ' & !zDirection & ' and ' & !axes & ' is ' & !direction)

  -- Draw feature
  !this.drawFeature()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureFlip
--
-- Description: Flip feature about axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      STRING         Axes to flip about
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureFlip(!axes is STRING)


  -- Get Directions
  if(!axes.upcase() eq 'X') then
    !direction                      = !this.feature.profile.orientation.xDir()
  else
    !direction                      = !this.feature.profile.orientation.yDir()
  endif
  !zDirection                       = !this.feature.profile.orientation.zDir().opposite()

  -- Re-orientate feature
  !this.feature.profile.orientation = object ORIENTATION('Z is ' & !zDirection & ' and ' & !axes & ' is ' & !direction)

  -- Draw feature
  !this.drawFeature()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureRotate
--
-- Description: Rotate passed axes towards a given point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      STRING         Rotate axes
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureRotate(!axes is STRING)

  -- Initialise Variables

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Pick position to direct ' & !axes.upcase() & ' to')
  !packet.key             = 'featureRotate'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeProfileEdit.featureRotate(!this.return[1].position, |' & !axes & '|)'
  !packet.remove          = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureRotate
--
-- Description: Rotate passed axes towards position (mapped onto plane)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      POSITION       Position
--    2   R      STRING         Feature picked options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureRotate(!position is POSITION, !axes is STRING)

  -- Get direction
  !direction = !this.plane.near(!this.feature.profile.position).direction(!this.plane.near(!position))

  -- Re orientate feature
  !this.feature.profile.orientation = object ORIENTATION('Z is ' & !this.feature.profile.plane().direction() & ' and ' & !axes & ' is ' & !direction)

  -- Draw feature
  !this.drawFeature()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      featureRotate
--
-- Description: Rotate feature about its origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .featureRotate(!angle is REAL)

  -- Return on zero angle
  if(!angle eq 0) then
    return
  endif

  -- Derive the direction
  !plane     = !this.feature.profile.plane()
  !direction = !plane.position.direction(!plane.threeDPosition(object XYPOSITION(cos(!angle) * 1000, sin(!angle) * 1000)))

  -- Re orientate feature
  !this.feature.profile.orientation = object ORIENTATION('Z is ' & !this.feature.profile.plane().direction() & ' and X is ' & !direction)

  -- Draw feature
  !this.drawFeature()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryMove
--
-- Description: Move all profile with an offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryMove()

  -- Initialise Variables
  -- Check we are at a corner
  if(undefined(!!pos2DRelative)) then
    pml reload form !!pos2DRelative
  endif

  -- Get position
  !!pos2DRelative.setup('!!dbeProfileEdit.boundaryMove(!xyPosition)', !this.loop.profile, 'Move', 'Origin', true, !this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryMove
--
-- Description: Move all profile with an offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      XYPOSITION     Relative offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryMove(!xyPosition is XYPOSITION)

  -- Initialise Variables
  !profile              = object PROFILE(!this.loop.profile)
  !profile.translate(!xyPosition.x, !xyPosition.y)

  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Move boundary by X' & !xyPosition.x.string(!!distanceFmt) & ' Y' &!xyPosition.y.string(!!distanceFmt)
  !solution.profile     = !profile
  !solution.edgeIndex   = !this.edge.val
  !solution.edgeNumbers.append(!this.edge.val)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryOrigin
--
-- Description: Move origin of profile, without moving its physical position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryOrigin()

  -- Initialise Variables
  -- Check we are at a corner
  if(undefined(!!pos2D)) then
    pml reload form !!pos2D
  endif

  -- Get position
  !xyPosition = object XYPOSITION(0,0)

  !!pos2D.setup('!!dbeProfileEdit.boundaryOrigin(!position)', !this.plane, !xyPosition, 'Reposition origin', 'Origin', false, !this.edgDescription)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      boundaryOrigin
--
-- Description: Move or reposition features origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      POSITION       Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryOrigin(!position is POSITION)

  -- Initialise Variables
  -- Map position onto plane
  !originPosition       = !this.plane.near(!position)

  -- Ignore zero offsets
  if(!this.plane.position.near(!originPosition, 0.1mm)) then
    return
  endif

  -- Get the offset
  !xyOffset             = !this.plane.xyOffset(!originPosition)

  -- Invert the XY offset for a by
  !xyOffset.x           = !xyOffset.x * -1
  !xyOffset.y           = !xyOffset.y * -1

  -- Reposition profile and planes
  !profile              = object PROFILE(!this.loop.profile)
  !profile.translate(!xyOffset.x, !xyOffset.y)
  !profile.position     = !originPosition


  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Reposition origin'
  !solution.profile     = !profile
  !solution.edgeIndex   = !this.edge.val
  !solution.edgeNumbers.append(!this.edge.val)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryRotate
--
-- Description: Rotate about origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryRotate()

  -- Initialise Variables
  -- Ignore zero rotation
  if(!this.angle.val eq 0) then
    return
  endif

  -- Rotate profile
  !profile              = object PROFILE(!this.loop.profile)
  !profile.rotate(!this.angle.val, !this.plane.position)

  !solution             = object DBELOOPSOLUTION()
  !solution.description = 'Rotate about origin by ' & !this.angle.val.string(!!angleFmt) & ' degrees'
  !solution.profile     = !profile
  !solution.edgeIndex   = !this.edge.val
  !solution.edgeNumbers.append(!this.edge.val)

  !this.solution(!solution)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryTrim
--
-- Description: Trim panel to picked line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryTrim()

  -- Packet definition
  !packet                   = object EDGPACKET()
  !packet.key               = 'trimProfile'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to trim on'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.action            = '!!dbeProfileEdit.boundaryTrim(!this.return[1])'
  !packet.remove            = true

  -- Add event to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryTrim
--
-- Description: Trim profile on passed line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line to time on
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryTrim(!line is LINE)

  -- Initialise Variables
  !splitLine   = !line.projected(!this.plane)

  -- Get split
  !newProfiles = !this.loop.profile.split(!splitLine)

  -- Merge arcs
  do !i indices !newProfiles
    !newProfiles[!i].mergeArcs(350, 1mm)
  enddo

  -- If there is more than 1 profile, then select the one
  if(!newProfiles.size() gt 1) then
    !!dbeProfileSelect.setup(!this.loop.profile, !newProfiles, '!!dbeProfileEdit.featureSolution(!profile, |Trim on line|)', '!!dbeFeatureEdit.add(!profiles, |Removed by trim|)' )

  -- Only a single profile
  else
    !this.featureSolution(!newProfiles[1], 'Trim on line')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryMirror
--
-- Description: Mirror loop about line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
