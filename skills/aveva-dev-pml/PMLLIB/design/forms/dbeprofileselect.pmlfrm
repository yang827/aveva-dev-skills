--
-- File:            dbeprofileselect.pmlfrm
--   Type:          Form Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 10 10:37:21 "GMT 2000
--
--
-- Description:
-- Select profile from passed array of profiles.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  dbeProfileSelect()               -                   Constructor
--  select()                         -                   Select current profile
--  setup(PROFILE,ARRAY,STRING)      -                   Setup form
--  setup(PROFILE,ARRAY,STRING,STRING) -                   Setup form
--  tidy()                           -                   Tidy form
--
------------------------------------------------------------------------

setup form !!dbeProfileSelect

  !this.formTitle     = 'Select Profile'
  !this.iconTitle     = 'Profile'
  !this.callback      = ''
  !this.cancelCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.2 $ '

  -- Body of form definition

  -- List of feature (numbers)
  list .list callback '!this.select()' width 3 length 5

  view .view at xmax ymin volume
    width 33 aspect 1
  exit

  path down
  halign right
  button .cancel 'Cancel' cancel
  button .apply  'OK'     at xmin form-0 ymin callback '!this.apply()' ok

  -- Form Members
  member .rootProfile is DBELOOPFEATURE
  member .profiles    is ARRAY

  -- Action for selected profile
  member .selected    is STRING

  -- Action for remainder of profiles
  member .unselected  is STRING

  -- Aid Number
  member .aidNumber   is REAL
  member .aidProfile  is REAL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeProfileSelect
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeProfileSelect()

  -- Initialise Variables

  -- Set background to default
  !this.view.background  = !!gphViewOpt.background.name

  -- Set default a zoom
  !this.view.mouseMode   = 'Zoom'

  -- Aid Number
  !this.aidNumber        = !!aidNumbers.add('Profile Select')
  !this.aidProfile       = !!aidNumbers.add('Profile Select')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !index   = !this.list.selection().real()

  -- Tidy Form
  !this.tidy()

  -- Action for selected profile
  if(!this.selected.set() and !this.selected.trim().empty().not()) then

    -- Get selected profile
    !profile = object PROFILE(!this.profiles[!index])

    $!<this.selected>
    handle ANY
      QUERY VAR !!error
    endhandle
  endif

  -- Action for unselected profile
  if(!this.unselected.set() and !this.unselected.trim().empty().not()) then

    -- Remove selected from array
    !this.profiles.remove(!index)

    do !i indices !this.profiles
      !profiles[!i] = object PROFILE(!this.profiles[!i])
    enddo

    $!<this.unselected>
    handle ANY
      QUERY VAR !!error
    endhandle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidProfile)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Root profile
--    1   R      ARRAY       List of profiles
--    2   R      STRING      Action on apply
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!rootProfile is PROFILE, !profiles is ARRAY, !action is STRING)
  !this.setup(!rootProfile, !profiles, !action, STRING())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Root profile
--    2   R      ARRAY       List of profiles
--    3   R      STRING      Action on apply
--    4   R      STRING      Action for unselected profiles
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!rootProfile is PROFILE, !profiles is ARRAY, !selectAction is STRING, !unselectAction is STRING)

  -- Initialise Variables
  !dtext               = ARRAY()
  !this.selected       = !selectAction
  !this.unselected     = !unselectAction
  !this.rootProfile    = object DBELOOPFEATURE(!rootProfile)
  !this.profiles       = !profiles

  -- Root profile in correct offset position
  !profile             = object PROFILE(!rootProfile)
  !profile.position    = n200000 e200000 d200000
  !profile.orientation = Y is N
  !plane               = !profile.plane()

  -- Build selection list
  do !i indices !this.profiles
    !dtext[!i] = !i.string()
  enddo

  !this.list.dtext = !dtext

  -- Show form
  !this.show()

  -- Set view limits
  !from   = !plane.threeDPosition(!this.rootProfile.limits[1])
  !to     = !plane.threeDPosition(!this.rootProfile.limits[2])

  !volume = object VOLUME(!from, !to)
  !!gphViews.limits(!this.view, !volume)

  -- Set view direction
  !!gphViews.look(!this.view, N)
  !!gphViews.look(!this.view, D)

  -- Draw root profile
  !!aidNumbers.hide(!this.aidProfile)
  !profile.draw(!this.aidProfile,3,4)

  -- Select
  !this.select()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select current profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Initialise Variables
  !index               = !this.list.selection().real()
  !profile             = object PROFILE(!this.profiles[!index])
  !profile.position    = n200000 e200000 d200000
  !profile.orientation = Y is N
  !plane               = !profile.plane()

  -- Draw Profile
  !!aidNumbers.hide(!this.aidNumber)
  !profile.draw(!this.aidNumber,1,5)

endmethod
-- End of method
