--
-- File:            dbeprofilesettings.pmlfrm
--   Type:          Form Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Jan 20 15:44:20 "GMT 2000
--
--
-- Description:
-- Settings form for profile editor.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply data
--  dbeProfileSettings()             -                   Constructor
--  initialise()                     -                   Initialise form
--  setColour(STRING)                -                   Set selected colour
--  updateColour(STRING)             -                   Set selected colour
--

setup form !!dbeProfileSettings

  !this.formTitle     = 'Profile Settings'
  !this.iconTitle     = ''
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.2 $ '

  -- Body of form definition
  path down
  halign left

  -- Frame
  frame .settingsFrame 'Settings'

    -- Repeat feature
    toggle .dynamicUpdate 'Dynamic update after changes' at x1 ymax    callback '!!dbeProfileEdit.dynamicUpdate    = !this.dynamicUpdate.val' states 'false' 'true'

    -- Deletion resolve
    rgroup .resolveDeletions  'Deletion' at x0.75 ymax+0.25            callback '!!dbeProfileEdit.resolveDeletions = !this.resolveDeletions.selection().boolean()' frame vertical
      add tag ' Resolve edge(s)'           select 'TRUE'
      add tag ' Replace edge(s) with line' select 'FALSE'
    exit

    -- Standout/Cutout projection
    rgroup .outProjected 'Cutout/Standout Projection'                  callback '!!dbeProfileEdit.outProjected     = !this.outProjected.selection().boolean()' frame horizontal
      add tag ' Projected'    select 'TRUE'
      add tag ' Intersected'  select 'FALSE'
    exit

    -- Cursor/Explicit
    rgroup .explicitForm 'Positioning'                                 callback '!!dbeProfileEdit.explicitForm     = !this.explicitForm.selection().boolean()' frame horizontal
      add tag ' Explicit '    select 'TRUE'
      add tag ' Graphical  '  select 'FALSE'
    exit

    -- Repeat feature
    toggle .repeatFeatures   'Repeat feature inclusion' at x1 ymax+0.5 callback '!!dbeProfileEdit.repeatFeatures   = !this.repeatFeatures.val' states 'false' 'true'

  exit

  -- Colours
  frame .colourFrame 'Representation' width.settingsFrame
    paragraph .profile                             text 'Profile   '
    path right
    button    .profileColour    '  ' tooltip 'Default colour' callback '!!colourSelectLoad(|!!dbeProfileSettings.setColour(''profileColour'')|, |Profile colour|, !!dbeProfileSettings.profileColour.background)'
    option    .profileLine      callback '!!dbeProfileSettings.updateColour(''profile'')' width 7

    paragraph .plane            at xmin.profile ymax text 'Origin    '
    button    .planeColour      '  ' tooltip 'Default colour' callback '!!colourSelectLoad(|!!dbeProfileSettings.setColour(''planeColour'')|, |Origin colour|, !!dbeProfileSettings.planeColour.background)'
    option    .planeLine        callback '!!dbeProfileSettings.updateColour(''plane'')' width 7

    paragraph .feature          at xmin.profile ymax text 'Feature   '
    button    .featureColour    '  ' tooltip 'Default colour' callback '!!colourSelectLoad(|!!dbeProfileSettings.setColour(''featureColour'')|, |Feature colour|, !!dbeProfileSettings.featureColour.background)'
    option    .featureLine      callback '!!dbeProfileSettings.updateColour(''feature'')' width 7

    paragraph .solution         at xmin.profile ymax text 'Solution  '
    button    .solutionColour   '  ' tooltip 'Default colour' callback '!!colourSelectLoad(|!!dbeProfileSettings.setColour(''solutionColour'')|, |Solution colour|, !!dbeProfileSettings.solutionColour.background)'
    option    .solutionLine     callback '!!dbeProfileSettings.updateColour(''solution'')' width 7

    paragraph .fence            at xmin.profile ymax text 'Fence     '
    button    .fenceColour      '  ' tooltip 'Default colour' callback '!!colourSelectLoad(|!!dbeProfileSettings.setColour(''fenceColour'')|, |Fence colour|, !!dbeProfileSettings.fenceColour.background)'
    option    .fenceLine        callback '!!dbeProfileSettings.updateColour(''fence'')' width 7

    paragraph .reference        at xmin.profile ymax text 'Reference '
    button    .referenceColour  '  ' tooltip 'Default colour' callback '!!colourSelectLoad(|!!dbeProfileSettings.setColour(''referenceColour'')|, |Reference colour|, !!dbeProfileSettings.referenceColour.background)'
    option    .referenceLine    callback '!!dbeProfileSettings.updateColour(''reference'')' width 7

  exit

   -- Apply
    button .apply   'Apply'   at xmax form-18 ymax+.25 width 8 callback '!this.apply()' tooltip 'Apply'
    button .dismiss 'Dismiss' at xmax+.2      ymin     width 8 cancel   tooltip 'Dismiss'



exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeProfileSettings
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeProfileSettings()

  -- Initialise Variables
  !dtext[1] = 'Solid'
  !dtext[2] = 'Dashed'
  !dtext[3] = 'Dotted'
  !dtext[4] = 'DashDot'
  !rtext[1] = '1'
  !rtext[2] = '2'
  !rtext[3] = '3'
  !rtext[4] = '4'
  !this.profileLine.dtext    = !dtext
  !this.profileLine.rtext    = !rtext

  !this.planeLine.dtext      = !dtext
  !this.planeLine.rtext      = !rtext

  !this.featureLine.dtext    = !dtext
  !this.featureLine.rtext    = !rtext

  !this.solutionLine.dtext   = !dtext
  !this.solutionLine.rtext   = !rtext

  !this.fenceLine.dtext      = !dtext
  !this.fenceLine.rtext      = !rtext

  !this.referenceLine.dtext  = !dtext
  !this.referenceLine.rtext  = !rtext

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Set selected colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setColour(!gadgetName is STRING)

  !colour = object COLOUR(!!colourSelectGet())
  !this.attribute(!gadgetName).background = !colour.code
  !this.attribute(!gadgetName).setTooltip(!colour.name)

  -- Update
  !this.updateColour(!gadgetName)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateColour
--
-- Description: Set selected colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateColour(!gadgetName is STRING)

  -- Update aid graphics
  !update = !gadgetName.lowcase()

  -- Redraw
  if(!update eq 'profile') then
    !!dbeProfileEdit.aidProfileColour       = !this.profileColour.background
    !!dbeProfileEdit.aidProfileLineStyle    = !this.profileLine.selection().real()
    !!dbeProfileEdit.draw()

  elseif (!update eq 'plane') then
    !!dbeProfileEdit.aidPlaneColour         = !this.planeColour.background
    !!dbeProfileEdit.aidPlaneLineStyle      = !this.planeLine.selection().real()
    !!dbeProfileEdit.drawPlane()

  elseif (!update eq 'feature') then
    !!dbeProfileEdit.aidFeatureColour       = !this.featureColour.background
    !!dbeProfileEdit.aidFeatureLineStyle    = !this.featureLine.selection().real()
    !!dbeProfileEdit.drawFeature()

  elseif (!update eq 'solution') then
    !!dbeProfileEdit.aidSolutionColour      = !this.solutionColour.background
    !!dbeProfileEdit.aidSolutionLineStyle   = !this.solutionLine.selection().real()
    !!dbeProfileEdit.drawSolution()

  elseif (!update eq 'fence') then
    !!dbeProfileEdit.aidFenceColour         = !this.fenceColour.background
    !!dbeProfileEdit.aidFenceLineStyle      = !this.fenceLine.selection().real()
    !!dbeProfileEdit.drawFence()

  elseif (!update eq 'reference') then
    !!dbeProfileEdit.aidReferenceColour     = !this.referenceColour.background
    !!dbeProfileEdit.aidReferenceLineStyle  = !this.referenceLine.selection().real()
    !!dbeProfileEdit.drawReference()

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !!dbeProfileEdit.dynamicUpdate          = !this.dynamicUpdate.val
  !!dbeProfileEdit.repeatFeatures         = !this.repeatFeatures.val

  !!dbeProfileEdit.resolveDeletions       = !this.resolveDeletions.selection().boolean()
  !!dbeProfileEdit.outProjected           = !this.outProjected.selection().boolean()
  !!dbeProfileEdit.explicitForm           = !this.explicitForm.selection().boolean()

  -- Set colour/line styles
  !!dbeProfileEdit.aidProfileColour       = !this.profileColour.background
  !!dbeProfileEdit.aidProfileLineStyle    = !this.profileLine.selection().real()

  !!dbeProfileEdit.aidPlaneColour         = !this.planeColour.background
  !!dbeProfileEdit.aidPlaneLineStyle      = !this.planeLine.selection().real()

  !!dbeProfileEdit.aidFeatureColour       = !this.featureColour.background
  !!dbeProfileEdit.aidFeatureLineStyle    = !this.featureLine.selection().real()

  !!dbeProfileEdit.aidSolutionColour      = !this.solutionColour.background
  !!dbeProfileEdit.aidSolutionLineStyle   = !this.solutionLine.selection().real()

  !!dbeProfileEdit.aidFenceColour         = !this.fenceColour.background
  !!dbeProfileEdit.aidFenceLineStyle      = !this.fenceLine.selection().real()

  !!dbeProfileEdit.aidReferenceColour     = !this.referenceColour.background
  !!dbeProfileEdit.aidReferenceLineStyle  = !this.referenceLine.selection().real()

  -- Redraw
  !!dbeProfileEdit.drawPlane()
  !!dbeProfileEdit.drawFence()
  !!dbeProfileEdit.drawReference()
  !!dbeProfileEdit.drawFeature()
  !!dbeProfileEdit.drawSolution()
  !!dbeProfileEdit.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Setup colours/line styles
  !colour = object COLOUR(!!dbeProfileEdit.aidProfileColour)
  !this.profileColour.background = !colour.code
  !this.profileColour.setTooltip(!colour.name)
  !this.profileLine.select('RTEXT',!!dbeProfileEdit.aidProfileLineStyle.string())

  !colour = object COLOUR(!!dbeProfileEdit.aidPlaneColour)
  !this.planeColour.background = !colour.code
  !this.planeColour.setTooltip(!colour.name)
  !this.planeLine.select('RTEXT',!!dbeProfileEdit.aidPlaneLineStyle.string())

  !colour = object COLOUR(!!dbeProfileEdit.aidFeatureColour)
  !this.featureColour.background = !colour.code
  !this.featureColour.setTooltip(!colour.name)
  !this.featureLine.select('RTEXT',!!dbeProfileEdit.aidFeatureLineStyle.string())

  !colour = object COLOUR(!!dbeProfileEdit.aidSolutionColour)
  !this.solutionColour.background = !colour.code
  !this.solutionColour.setTooltip(!colour.name)
  !this.solutionLine.select('RTEXT',!!dbeProfileEdit.aidSolutionLineStyle.string())

  !colour = object COLOUR(!!dbeProfileEdit.aidFenceColour)
  !this.fenceColour.background = !colour.code
  !this.fenceColour.setTooltip(!colour.name)
  !this.fenceLine.select('RTEXT',!!dbeProfileEdit.aidFenceLineStyle.string())

  !colour = object COLOUR(!!dbeProfileEdit.aidReferenceColour)
  !this.referenceColour.background = !colour.code
  !this.referenceColour.setTooltip(!colour.name)
  !this.referenceLine.select('RTEXT',!!dbeProfileEdit.aidReferenceLineStyle.string())

  -- Initialise Variables
  !this.dynamicUpdate.val  = !!dbeProfileEdit.dynamicUpdate
  !this.repeatFeatures.val = !!dbeProfileEdit.repeatFeatures

  !this.resolveDeletions.select(!!dbeProfileEdit.resolveDeletions.string())
  !this.outProjected.select(!!dbeProfileEdit.outProjected.string())
  !this.explicitForm.select(!!dbeProfileEdit.explicitForm.string())

endmethod
-- End of method
