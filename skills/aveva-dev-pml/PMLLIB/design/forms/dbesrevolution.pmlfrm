-- Created:         Tue Mar 23 18:38:24 "GMT 1999
--
--
-- Description:
-- Solid of revolution.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   Apply data
--  arcSelect()                      -                   Use picked arc to define profile
--  axesPoint()                      -                   Packet for defining point which axes of profile to go through
--  axesPoint(POSITION)              -                   Set point through which axes goes
--  close()                          -                   Close form
--  create(BOOLEAN)                  -                   Create element
--  createNegative()                 -                   Create negative solid of revolution
--  createPositive()                 -                   Create positive solid of revolution
--  dbeSRevolution()                 -                   Constructor
--  definePlanes()                   BOOLEAN             Define plane
--  draw()                           -                   Draw
--  drawPoints()                     -                   Draw current points
--  flip()                           -                   Flip rotation line
--  lineDerive()                     -                   Determine the boundary from the picked lines
--  lineSelect()                     -                   Setup packet for tracing of lines
--  lineSelect(LINE)                 -                   Cache picked lines for tracing
--  measureAngle(MENU,STRING)        -                   Setup to measure of angle
--  measureAngle(POSITION)           -                   Update angle, calculate angle between plane and passed position
--  measureAngle(REAL)               -                   Update angle
--  modifyLoop()                     -
--  modifyMode(DBREF)                -
--  modifyProf()                     -
--  pointEdit(STRING)                -                   Modify a point definition
--  pointEditGadgets()               -                   Modify a point definition
--  pointsDerive()                   -                   Define points
--  pointsSelect()                   -                   Use picked position to define profile
--  pointsSelect(POSITION)           -                   Use profile of element
--  profile(PROFILE)                 -                   Use passed profile
--  profileApply(PROFILE,STRING)     -                   Apply the profile to using the current action
--  profileSelect()                  -                   Use profile of element
--  profileSelect(DBREF)             -                   Use profile of element
--  representation()                 -                   Set representation attributes
--  rotationLine()                   -                   Packet for picking rotation line
--  rotationLine(LINE)               -                   Define rotation line
--  setupCreateGadgets(GADGET,BOOLEAN) -                   Setup create gadgets
--  setupGadgets()                   -                   Setup gadgets
--  standardShape(STRING)            -                   Show standard shape form
--  tidy()                           -                   Tidy graphics
--  useArc(ARC)                      -                   Use passed arc as a feature
--
------------------------------------------------------------------------

setup form !!dbeSRevolution

  !this.formTitle     = 'Revolution'
  !this.formTitle     = ''
  !this.callback      = ''
  !this.cancelCall    = '!this.close()'
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

  -- Define rotation line
  frame .orientationFrame 'Axes' width 23
    button .rotation  'Rotation Line'                       tooltip 'Pick rotation line'                callback '!this.rotationLine()'
    path down
    button .xPoint    'Point on Plane'                      tooltip 'Pick start through point'          callback '!this.axesPoint()'

    button .flip      'Flip' at xmax.rotation ymin.rotation tooltip 'Flip rotation line definition'     callback '!this.flip()'
  exit

  -- Settings
  frame .settingsFrame 'Settings' at xmin ymax width 23

    -- Angle
    path down
    halign right
    text   .angle      'Angle'   at x3 ymax tooltip 'Angle of sweep >'              callback '!this.draw()' width 9 is REAL FORMAT !!angleFmt

    -- Representation
    button .repr 'Representation...'        tooltip 'Set representation attributes' callback '!this.representation()'

  exit

  -- Creation mode
  frame .createFrame 'Create' at xmin ymax width 23
    hdist 0
    path right
    button .selectPoints  at x0.5               ymax      pixmap width 16 height 16 tooltip 'Pick points >'                 callback '!this.pointsSelect()'
    button .selectLines                                   pixmap width 16 height 16 tooltip 'Pick lines'                    callback '!this.lineSelect()'
    button .polygon       at xmin.selectPoints  ymax      pixmap width 16 height 16 tooltip 'Define a polygon'              callback '!this.standardShape(|polygon|)'
    button .rectangle                                     pixmap width 16 height 16 tooltip 'Define a rectangle'            callback '!this.standardShape(|rectangle|)'
    button .circle                                        pixmap width 16 height 16 tooltip 'Define a circle'               callback '!this.standardShape(|circle|)'
    button .arc                                           pixmap width 16 height 16 tooltip 'Define an arc'                 callback '!this.standardShape(|arc|)'
    button .chordHeight                                   pixmap width 16 height 16 tooltip 'Define an arc by chord height' callback '!this.standardShape(|chord height|)'

    button .selectProfile at xmin.selectPoints  ymax+0.25 pixmap width 16 height 16 tooltip 'Pick a profile to copy'        callback '!this.profileSelect()'
    vdist 0
    path down
    button .selectArc                                     pixmap width 16 height 16 tooltip 'Derive arc'                    callback '!this.arcSelect()'

    -- Standout/Cutout projection
    rgroup .outProjected 'Projection' at xmax+0.5 ymin.selectProfile-0.25 frame vertical
      add tag ' Project'    select 'TRUE'
      add tag ' Intersect'  select 'FALSE'
    exit

  exit

  -- Modify mode
  frame .modifyFrame 'Modify Profile' at xmin.createFrame ymin.createFrame width 23

    paragraph .iconLoopEdit                         anchor left + top   at x0         ymax+0.2      pixmap width 14 height 14
    button    .loopEdit  linklabel 'Loop editor'    anchor left + top   at xmax+2     ymin          callback '!this.modifyLoop()'

    rgroup .modProjected 'Projection' at xmin+3 ymax frame vertical
      add tag ' Project' select 'TRUE'
      add tag ' Intersect' select 'FALSE'
    exit

  exit

  -- Display modify form after creation
  path down
  vdist 0.5
  halign right
  toggle .displayModify    'Modification' tooltip 'Show modification form after creation' states 'false' 'true'

  -- Apply/Dismiss
  button .apply   ' OK '   at x0.5           ymax+0.25 callback '!this.apply(|CREATE|)'
  button .dismiss 'Cancel' at xmax form-size ymin      callback '!this.close()' cancel

  -- Form Members

  -- Default owner
  member .owner           is DBREF

  -- Axes of rotation
  member .rotationLine    is LINE
  member .rotationPlane   is PLANE
  member .axesPoint       is POSITION

  -- Definition Plane
  member .profilePlane    is PLANE

  -- Profile definition
  member .profile         is PROFILE
  -- Existing elements for modification
  member .modRevo         is DBREF
  member .refLoop         is DBREF

  -- Point
  member .definition      is ARRAY
  member .definitionIndex is REAL

  -- Type of Revo
  member .type            is STRING
  member .typeString      is STRING

  -- EDG Description
  member .edgDescription  is STRING

  -- Representation
  member .representation  is GPHREPDEFINITION

  -- Aid numbers
  member .aidNumber       is REAL
  member .aidRotation     is REAL
  member .aidStart        is REAL
  member .aidEnd          is REAL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      dbeSRevolution
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeSRevolution()

  -- Initialise Variables
  !this.edgDescription = 'Solid of Revolution'
  !this.angle.val      = 90

  -- Default element Type
  !this.type           = 'REVO'

  -- Icons
  !this.selectProfile.addPixmap(!!pml.getPathName('definewhole16.png'), !!pml.getPathName('definewhole16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.selectPoints.addPixmap(!!pml.getPathName('definepoints16.png'), !!pml.getPathName('definepoints16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.selectLines.addPixmap(!!pml.getPathName('linecopy16.png'), !!pml.getPathName('linecopy16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.selectArc.addPixmap(!!pml.getPathName('circlecopy16.png'), !!pml.getPathName('circlecopy16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.polygon.addPixmap(!!pml.getPathName('hexagon16.png'), !!pml.getPathName('hexagon16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.rectangle.addPixmap(!!pml.getPathName('rectangle16.png'), !!pml.getPathName('rectangle16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.circle.addPixmap(!!pml.getPathName('circle16.png'), !!pml.getPathName('circle16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.arc.addPixmap(!!pml.getPathName('arc16.png'), !!pml.getPathName('arc16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.chordHeight.addPixmap(!!pml.getPathName('chord16.png'), !!pml.getPathName('chord16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.iconLoopEdit.addPixmap(!!pml.getPathName('createpanel24.png'))

  -- Angle Measure
  !menu = !this.newMenu('angleMenu')
    !menu.add('CALLBACK', 'Angle between three points', '!this.measureAngle(')
    !menu.add('CALLBACK', 'Angle between two lines',    '!this.measureAngle(')
    !menu.add('CALLBACK', 'Angle through a point',      '!this.measureAngle(')
  !this.angle.setPopup(!this.angleMenu)

  -- Point options
  !menu = !this.newMenu('pointMenu')
    !menu.add('callback', 'Previous',     '!this.pointEdit(|previous|)')
    !menu.add('callback', 'Next',         '!this.pointEdit(|next|)')
    !menu.add('separator')
    !menu.add('callback', 'Remove',       '!this.pointEdit(|remove|)')
    !menu.add('callback', 'Remove all',   '!this.pointEdit(|remove all|)')
  !this.selectPoints.setPopup(!this.pointMenu)

  -- Arc options
  !menu = !this.newMenu('arcMenu')
    !menu.add('toggle', 'Arc',         '!this.arcMenu.select(|Full circle|, false)')
    !menu.add('toggle', 'Full circle', '!this.arcMenu.select(|Arc|, false)')
  !this.selectArc.setPopup(!this.arcMenu)
  !this.arcMenu.select('Arc', true)


  -- Aid numbers
  !this.aidNumber     = !!aidNumbers.add('Solid of Revolution')
  !this.aidRotation   = !!aidNumbers.add('Solid of Revolution - Line')
  !this.aidStart      = !!aidNumbers.add('Solid of Revolution - Start')
  !this.aidEnd        = !!aidNumbers.add('Solid of Revolution - End')

  -- Load Predefined representations into gadget
  if(undefined(!!gphRepLst)) then
    call !!comDefineGlobal(object GPHREPLST())
  endif

  -- If representation definition is unset, then use default
  if(!this.representation.unset()) then
    !this.representation = !!gphRepLst.key('DEFAULT')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Hide graphics
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidRotation)
  !!aidNumbers.hide(!this.aidStart)
  !!aidNumbers.hide(!this.aidEnd)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!mode is STRING)

  -- No Definitions loaded
  if(!this.profile.edges().empty()) then
    !!alert.warning('Unable to create ' & !this.typeString & ' of revolution, no boundary defined.')
    return
  endif

  -- Actions on modify
  if (!mode.eq(|MODIFY|)) then

    !!ce = !this.modRevo
    !feature    = object DBELOOPFEATURE()

    -- Get profiles found for element
    !features   = !feature.features(!this.modRevo)

    !tempPos = !this.profile.position
    !tempOri = !this.profile.orientation

    !this.profile = !this.profile.profile(!features[1].profile)

    !this.profile.position = !tempPos
    !this.profile.orientation = !tempOri

    !this.representation.applyTo(!this.modRevo)
    ANGLE $!<this.angle.val>

    !this.profileApply(!this.profile, |MODIFY|)

    -- Overwrite old profile definition to the existing loop element
    !this.profile.dbWrite(!this.refLoop)
    if(!this.refLoop.members.first().position.near(!this.refLoop.members.last().position, 0.5mm)) then
      !!ce  = !this.refLoop.members.last()
      !type = !!ce.type
      DELETE $!<type>
    endif

    !!ce = !this.modRevo

elseif (!mode.eq(|CREATE|)) then

  -- Get owner
  !owner = !!dtbOwnerOfType(!this.owner, !this.type)

  -- If there is no owner, give warning
  if(!owner.unset()) then

    -- Try the element we originally showed the form at, if different from the current element
    if(!this.owner ne !!ce) then
      !owner = !!dtbOwnerOfType(!!ce, !this.type)
      if(!owner.unset()) then
        !!alert.warning('Unable to create ' & !this.typeString & ' of revolution, move to an appropriate element and try again.')
        return
      endif
    else
      !!alert.warning('Unable to create ' & !this.typeString & ' of revolution, move to an appropriate element and try again.')
      return
    endif
  endif

  -- Do we have access to create the item
  if(!!dbRefUpdate(!owner).not()) then
    !!alert.warning(!!error.text)
    return
  endif

  --Move to owner
  !!ce       = !owner

  -- Build Solid of Revolution
  NEW   $!<this.type>
  ANGLE $!<this.angle.val>
  !reference = !!ce

  -- Set representation
  !this.representation.applyTo(!reference)

  -- Create loop
  NEW LOOP
  !loop = !!ce
  !this.profile.dbWrite(!loop)
  if(!loop.members.first().position.near(!loop.members.last().position, 0.5mm)) then
    !!ce  = !loop.members.last()
    !type = !!ce.type
    DELETE $!<type>
  endif

  -- Move item and set representation
  !!ce = !reference
  !this.representation.applyTo(!!ce)

  -- Show modify form
  if(!this.displayModify.val) then
    --call !!dbeLoopEdit(!reference, !this.type)
    !this.modifyMode(!reference)
  else
    !this.close()
    !this.hide()
  endif
endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise variables

  -- Remove aid numbers
  !this.tidy()

  -- Remove edg event
  !!edgCntrl.remove(!this.edgDescription)
  -- Initialise variables
  !this.rotationLine  = object LINE()
  !this.axesPoint     = object POSITION()
  !this.profilePlane  = object PLANE()
  !this.rotationPlane = object PLANE()
  !this.profile       = object PROFILE()
  !this.modRevo = object DBREF()

  -- If positive revolution
    !this.type       = 'REVO'
    !this.typeString = 'Positive'
    !type            = '+ve'

  -- Empty definition
  !this.definition.clear()
  !this.definitionIndex = 0

  -- Set form title
  !this.formTitle    = '+ve Revolution'

    -- Hide modify gadgets and change frame titles
  !this.createFrame.visible   = TRUE
  !this.modifyFrame.visible   = FALSE
  !this.displayModify.visible = TRUE
  !this.apply.callback        = '!this.apply(|CREATE|)'
  !this.apply.tag             = ' OK '
  !this.dismiss.tag           = 'Cancel'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupGadgets
--
-- Description: Setup gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupGadgets()

  !rotationLineSet           = !this.rotationLine.set()
  !this.xPoint.active        = !rotationLineSet
  !this.flip.active          = !rotationLineSet

  !planeSet                  = !this.profilePlane.set()
  !this.setupCreateGadgets(object GADGET(), !planeSet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupCreateGadgets
--
-- Description: Setup create gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to force to active (unset will leave all as passed)
--    2   R      BOOLEAN     Active state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupCreateGadgets(!gadget is GADGET, !flag is BOOLEAN)

  -- Initialise variables

  !this.selectProfile.active = !flag
  !this.selectPoints.active  = !flag
  !this.selectLines.active   = !flag
  !this.selectArc.active     = !flag
  !this.polygon.active       = !flag
  !this.rectangle.active     = !flag
  !this.circle.active        = !flag
  !this.arc.active           = !flag
  !this.chordHeight.active   = !flag

  -- Turn on passed gadget
  if(!gadget.set()) then
    !gadget.active = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Positive element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!positive is BOOLEAN)

  -- Initialise variables
  !this.rotationLine  = object LINE()
  !this.axesPoint     = object POSITION()
  !this.profilePlane  = object PLANE()
  !this.rotationPlane = object PLANE()
  !this.profile       = object PROFILE()

  -- If positive revolution
  if(!positive) then
    !this.type       = 'REVO'
    !this.typeString = 'Positive'
    !type            = '+ve'
  else
    !this.type       = 'NREV'
    !this.typeString = 'Negative'
    !type            = '-ve'
  endif

  -- Empty definition
  !this.definition.clear()
  !this.definitionIndex = 0

  -- Set form title
  !this.formTitle    = !type & ' Revolution'

  -- Owning element
  !this.owner        = !!ce

  -- Setup gadgets
  !this.setupGadgets()

  -- Setup point edge gadgets
  !this.pointEditGadgets()

  -- Show form
  !this.show('FREE')

  -- Pick rotation line
  !this.rotationLine()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createPositive
--
-- Description: Create positive solid of revolution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPositive()

  -- Create
  !this.create(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createNegative
--
-- Description: Create negative solid of revolution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createNegative()

  -- Create
  !this.create(false)

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Setup to measure of angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureAngle(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'ANGLE BETWEEN THREE POINTS') then
    !packet.defineMeasure('angle')
    !packet.action    = '!!dbeSRevolution.measureAngle(!this.return[1].angle())'

  -- Measure parallel
  elseif (!option eq 'ANGLE BETWEEN TWO LINES') then
    !packet.defineMeasure('lineangle')
    !packet.action    = '!!dbeSRevolution.measureAngle(!this.return[1])'

  -- Measure parallel
  elseif (!option eq 'ANGLE THROUGH A POINT') then
    !packet.definePosition('Point through which angle passes')
    !packet.action    = '!!dbeSRevolution.measureAngle(!this.return[1].position)'
  endif

  !packet.remove      = true
  !packet.description = !this.edgDescription
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Update angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .measureAngle(!angle is REAL)

  -- Set angle
  !this.angle.val = !angle

  -- Update
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      measureAngle
--
-- Description: Update angle, calculate angle between plane and passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .measureAngle(!position is POSITION)

  -- Initialise Variables

  -- Map position onto plane
  !planePosition  = !this.profilePlane.near(!position)

  -- X axes of plane as a line
  !xLine          = object LINE(!this.profilePlane.position, !this.profilePlane.position.offset(!this.profilePlane.orientation.xDir(), 1000mm))

  -- Project position onto line
  !linePosition   = !xLine.near(!position)

  -- Angle between three points
  !angle          = !linePosition.angle(!planePosition, !position)

  -- Set angle
  !this.angle.val = !angle

  -- Update
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Initialise Variables

  -- Never allow zero (assume it to be 360)
  if(!this.angle.val le 0 or !this.angle.val gt 360) then
    !this.angle.val = 360
  endif

  -- If modify mode, make sure latest profile is drawn
  if (!this.modRevo.set()) then
    !feature    = object DBELOOPFEATURE()

    -- Get profiles found for element
    !features   = !feature.features(!this.modRevo)

    !tempPos = !this.profile.position
    !tempOri = !this.profile.orientation

    !this.profile = !this.profile.profile(!features[1].profile)

    !this.profile.position = !tempPos
    !this.profile.orientation = !tempOri
  endif

  -- Tidy graphics
  !this.tidy()

  -- Draw rotation line
  if(!this.rotationLine.set()) then
    !this.rotationLine.draw(!this.aidRotation, 4, 5)
    --!midPoint = !this.rotationLine.proportion(0.5)
    --AID TEXT NUMBER $!<this.aidRotation> 'Rotation Line' AT $!<midPoint>

    -- If axes point is set
    if(!this.axesPoint.set()) then

      -- Plane is not defined
      if(!this.profilePlane.unset()) then
        !line         = !this.profilePlane.position.line(!this.axesPoint)
        !line.draw(!this.aidRotation, 4, 5)

      -- Plane is defined
      else
        AID TEXT NUMBER $!<this.aidNumber> 'Origin' AT $!<this.profilePlane.position>

        -- Edges of profile
        !edges        = !this.profile.edges()

        if(!edges.empty()) then
          !position   = !this.axesPoint
          !line       = !this.profilePlane.position.line(!this.axesPoint)
        else
          !localVolume    = object LOCALVOLUME(!this.modRevo,!this.modRevo)
          handle any
            !position     = !this.axesPoint
          elsehandle none
            !lineLength   = !localVolume.box().xLength * 0.5
            !pointVector  = object POINTVECTOR(!this.profilePlane.position,!this.profilePlane.orientation.yDir())
            !pointVector  = !pointVector.offset(!lineLength)
            !position     = !pointVector.position
          endhandle
          !line           = !this.profilePlane.position.line(!position)
        endif
        !radius         = max(100mm, !line.length() / 2)

        -- Draw base line
        !line.draw(!this.aidRotation, 4, 5)

        -- Draw angle
        !xyPosition   = !this.rotationPlane.xyOffset(!line.endPosition)
        !xyPosition.x = !radius * cos(!this.angle.val) * 1.2
        !xyPosition.y = !radius * sin(!this.angle.val) * 1.2

        -- Draw arc line
        !aLine        = !this.profilePlane.position.line(!this.rotationPlane.threeDPosition(!xyPosition))
        !aLine        = !aLine.parallel(!this.profilePlane.position)
        !aLine.draw(!this.aidRotation, 4, 5)

        -- Define arc
        !arc          = object ARC(!this.profilePlane.position, !this.rotationPlane.orientation, 0, !this.angle.val, !radius, true)
        !arc.draw(!this.aidNumber, 1, 4)
        !midPoint     = !arc.anglePosition(!arc.angle() / 2)
        AID TEXT NUMBER $!<this.aidNumber> '$!this.angle.val' AT $!<midPoint>

        -- Draw profile
        if(!edges.empty().not()) then
          !this.profile.draw(!this.aidNumber, 1, 4)
          !endProfile             = !this.profile
          !endProfile.orientation = object ORIENTATION('X is ' & !this.rotationLine.direction() & ' and Y is ' & !aLine.direction())
          handle any
            -- do not draw end profile for 360degree angle - or any other orientation error
          elsehandle none
            !endProfile.draw(!this.aidNumber, 1, 4)
          endhandle
        endif
      endif
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Set representation attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .representation()

  -- Check representation defaults form has been build
  if(undefined(!!gphRepDflts)) then
    pml reload form !!gphRepDflts
  endif

  -- Setup and show representation form
  !representation = !this.representation
  !!gphRepDflts.setup(!this.representation, '!!dbeSRevolution.representation = !representation', true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationLine
--
-- Description: Packet for picking rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationLine()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to rotate about'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'rotationLine'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!dbeSRevolution.rotationLine(!this.return[1])'
  !packet.remove            = false
  !packet.escape            = '!!dbeSRevolution.setupGadgets()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationLine
--
-- Description: Define rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationLine(!line is LINE)

  -- Check for line
  if(!line.unset()) then
    return
  endif

  -- Initialise Variables
  !this.rotationLine = !line

  -- Setup gadgets
  !this.setupGadgets()

  -- Define plane
  !this.definePlanes()

  -- Draw
  !this.draw()

  -- Remove event
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      axesPoint
--
-- Description: Packet for defining point which axes of profile to go through
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .axesPoint()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Define axes point')
  !packet.key             = 'axesPoint'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeSRevolution.axesPoint(!this.return[1].position)'
  !packet.remove          = false
  !packet.escape          = '!!dbeSRevolution.setupGadgets()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      axesPoint
--
-- Description: Set point through which axes goes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .axesPoint(!position is POSITION)

  -- Initialise Variables
  !this.axesPoint = !position

  -- Define plane
  if(!this.definePlanes().not()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- Setup gadgets
  !this.setupGadgets()

  -- Draw
  !this.draw()

  -- Remove edg event
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      definePlanes
--
-- Description: Define plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if plane has been defined fully
--
------------------------------------------------------------------------

define method .definePlanes() is BOOLEAN

  -- Initialise Variables
  !this.profilePlane        = object PLANE()
  !this.rotationPlane       = object PLANE()

  -- Set plane
  if(!this.rotationLine.set() and !this.axesPoint.set()) then

    -- Profile plane
    !originLine               = !this.rotationLine.near(!this.axesPoint).line(!this.axesPoint)

    -- Handle axes point on rotation line
    if(!originLine.length() eq 0) then
      !!error.text            = 'Axes point lies on the rotation line. A point off the rotation line must be defined.'
      return false
    endif

    !direction                = !originLine.direction()
    !this.profilePlane        = object PLANE(!originLine.startPosition, object ORIENTATION('X is ' & !this.rotationLine.direction() & ' and Y is ' & !direction))

    -- Rotation plane
    !this.rotationPlane       = object PLANE(!originLine.startPosition, object ORIENTATION('Z is ' & !this.rotationLine.direction() & ' and X is ' & !direction))

    -- Define profile plane
    !this.profile.position    = !this.profilePlane.position
    !this.profile.orientation = !this.profilePlane.orientation
    return true

  -- Unset planes
  elseif (!this.rotationLine.unset() and !this.axesPoint.unset()) then
    !!error.text              = 'Unable to derive planes, no rotation line and no axes point defined.'
  elseif (!this.rotationLine.unset()) then
    !!error.text              = 'Unable to derive planes, no rotation line defined.'
  elseif (!this.axesPoint.unset()) then
    !!error.text              = 'Unable to derive planes, no axes point defined.'
  endif

  return false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileSelect
--
-- Description: Use profile of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSelect()

  -- Check that feature selector is loaded
  if(undefined(!!dbeFeatureSelect)) then
    pml reload form !!dbeFeatureSelect
  endif

  -- Check if there is already a profile defined
  if(!this.profile.edges().empty().not()) then
    if(!!alert.confirm('Profile already defined, OK to replace it?').boolean().not()) then
      return
    endif
  endif

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.key             = 'profileSelect'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.pickPacket.stdElement('Pick element to copy')
  !packet.action          = '!!dbeSRevolution.profileSelect(!this.return[1].item)'
  !packet.remove          = false
  !packet.escape          = '!!dbeSRevolution.setupGadgets()'

  -- Add event to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileSelect
--
-- Description: Use profile of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to derive profile from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSelect(!element is DBREF)

  -- Initialise Variables
  !feature    = object DBELOOPFEATURE()

  -- Get profiles found for element
  !features   = !feature.features(!element)

  -- Handle no profiles returned
  if(!features.empty()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- If there is more than one feature, then select the relevant one
  if(!features.size() gt 1) then
    !!dbeFeatureSelect.setup(!features, '!!dbeSRevolution.profileApply(!profile, |CREATE|)')

  -- Use first profile
  else
    !this.profileApply(!features[1].profile, |CREATE|)
  endif

  -- Remove event
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileApply
--
-- Description: Apply the profile to using the current action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   RW     profile        Profile
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileApply(!profile is PROFILE, !mode is STRING)

  -- Initialise Variables
  !feature     = object DBELOOPFEATURE(!profile)

  -- Project profile onto plane
  if (!mode.eq(|CREATE|)) then
  if(!this.outProjected.selection().boolean()) then
    !feature.project(!this.profilePlane)
  else
    !feature.intersect(!this.profilePlane)
  endif
elseif (!mode.eq(|MODIFY|)) then
  if(!this.modProjected.selection().boolean()) then
    !feature.project(!this.profilePlane)
  else
    --!bool = !feature.profile.orientation.eq(!this.profilePlane.orientation)
    !feature.intersect(!this.profilePlane)
  endif
 endif

  -- Project profile onto plane
  !edges           = !feature.profile.edges()
  !this.profile    = object PROFILE(!this.profilePlane.position, !this.profilePlane.orientation, !edges)

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flip
--
-- Description: Flip rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flip()

  -- Initialise Variables
  if(!this.rotationLine.unset()) then
    return
  endif

  !this.rotationLine = !this.rotationLine.reverseSense()

  -- Get original profile (as edges)
  !edges = !this.profile.edges()
  handle any
    return
  endhandle

  -- Change planes
  !this.definePlanes()

  -- Redefine
  if(!edges.empty().not()) then
    !line = !this.profile.position.line(!this.profile.position.offset(!this.profile.orientation.yDir(),1000mm))
    !this.profile.mirror(!line)
  endif

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lineSelect
--
-- Description: Setup packet for tracing of lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lineSelect()

  -- Check if there is already a profile defined
  if(!this.profile.edges().empty().not()) then
    if(!!alert.confirm('Profile already defined, OK to replace it?').boolean().not()) then
      return
    endif
  endif

  -- Remove previous definitions
  !this.definition.clear()

  -- Setup gadgets
  !this.setupCreateGadgets(!this.selectLines, false)

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.lineDerive()
  !packet.pickPacket.prompt = 'Pick line to trace'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'traceLines'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!dbeSRevolution.lineSelect(!this.return[1])'
  !packet.remove            = false
  !packet.escape            = '!!dbeSRevolution.lineDerive()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lineSelect
--
-- Description: Cache picked lines for tracing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line picked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lineSelect(!line is LINE)

  -- Project line
  !projectedLine = !line.projected(!this.profilePlane)

  -- Check we still have a line, if its a point, then we will use it position only
  if(!projectedLine.length() eq 0) then
    !!alert.warning('Unable to project line onto the profile plane.')
    return
  endif

  -- Add line to definitions
  !this.definition.append(!projectedLine)
  !position = !projectedLine.proportion(0.5)

  -- Draw and tag line
  !index = !this.definition.size()
  !projectedLine.draw(!this.aidNumber,2,1)
  AID TEXT NUMBER $!<this.aidNumber> '$!index' AT $!<position>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lineSelect
--
-- Description: Determine the boundary from the picked lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lineDerive()

  -- Initialise Variables
  !lineCount =  !this.definition.size()

  -- Setup gadgets
  !this.setupGadgets()

  -- No line in the
  if(!lineCount lt 2) then
    !!alert.warning('Unable to derive a profile, more than 1 line has to been picked.')
    return

    -- Special case for 2 lines picked
  elseif (!lineCount eq 2) then


    return
  endif

  -- Define path
  !previous         = !this.definition.last()
  do !i from 1 to !this.definition.size()
    !iPositions[!i] = !previous.intersection(!this.definition[!i])
    !previous       = !this.definition[!i]
  enddo

  !this.profile = object PROFILE(!this.profilePlane.position, !this.profilePlane.orientation, !iPositions)
  !this.profile.close()

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pointsSelect
--
-- Description: Use picked position to define profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointsSelect()

  -- Initialise Variables
  !positions = ARRAY()
  !arcFound  = false

  -- If there is already a profile defined, then populate the
  -- definition with the points (this is only valid where no
  -- arcs are in the profile
  !edges     = !this.profile.edges()

  -- Check for arcs
  if(!edges.empty().not()) then

    -- Loop through edges checking for arcs
    do !i indices !edges
      if(!edges[!i].objectType() eq 'ARC') then
        !arcFound = true
        break
      endif
      !positions.append(!edges[!i].startPosition)
    enddo

  endif

  -- If there are no positions or an arc has been
  if(!positions.empty() or !arcFound) then
    !this.definition.clear()
    !this.definition[1]     = !this.axesPoint
    !this.definitionIndex   = 1

  -- Use positions
  else
    !this.definition      = !positions
    !this.definitionIndex = !positions.size()
  endif

  -- Draw points
  !this.drawPoints()

  -- Setup gadgets
  !this.setupCreateGadgets(!this.selectPoints, false)

  -- Setup point edge gadgets
  !this.pointEditGadgets()

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.definePosition('Define points')
  !packet.key             = 'pointsSelect'
  !packet.description     = !this.edgDescription
  !packet.priority        = 1
  !packet.action          = '!!dbeSRevolution.pointsSelect(!this.return[1].position)'
  !packet.remove          = false
  !packet.escape          = '!!dbeSRevolution.pointsDerive()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pointsSelect
--
-- Description: Use profile of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to derive profile from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointsSelect(!passedPosition is POSITION)

  -- Map position onto plane
  !position = !this.profilePlane.near(!passedPosition)

  -- Add position to fence point list
  !this.definitionIndex = !this.definitionIndex + 1
  !this.definition.insert(!this.definitionIndex, !position)

  -- Draw Definition
  !this.drawPoints()

  -- Setup point edge gadgets
  !this.pointEditGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pointsDerive
--
-- Description: Define points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointsDerive()

  -- Setup gadgets
  !this.setupGadgets()

  -- Draw profile
  !this.draw()

  -- Empty definition
  !this.definition.clear()
  !this.definitionIndex = 0

  -- Setup point edge gadgets
  !this.pointEditGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pointEdit
--
-- Description: Modify a point definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointEdit(!option is STRING)

  -- Initialise Variables

  -- Remove a point
  if(!option eq 'remove') then

    -- Remove current point
    !this.definition.remove(!this.definitionIndex)

    -- Check if definition is empty
    if(!this.definition.empty()) then
      !this.definitionIndex = 0

    -- Set index to previous on
    else
      !index = !this.definitionIndex - 1
      if(!index eq 0) then
        !this.definitionIndex = !this.definition.size()
      else
        !this.definitionIndex = !index
      endif
    endif

  -- Remove all points
  elseif (!option eq 'remove all') then
    !this.definition.clear()
    !this.definitionIndex = 0

  -- Move to the next point
  elseif (!option eq 'next') then

    !index = !this.definitionIndex + 1

    -- Check we have gone passed the end
    if(!index gt !this.definition.size()) then
      !this.definitionIndex = 1
    else
      !this.definitionIndex = !index
    endif

  -- Move to the previous point
  elseif (!option eq 'previous') then

    !index = !this.definitionIndex - 1

    -- Check we have gone passed the end
    if(!index le 0) then
      !this.definitionIndex = !this.definition.size()
    else
      !this.definitionIndex = !index
    endif
  endif

  -- Draw Definition
  !this.drawPoints()

  -- Setup point edge gadgets
  !this.pointEditGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pointEditGadgets
--
-- Description: Modify a point definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointEditGadgets()

  -- Initialise Variables
  !flag = !this.definition.empty().not()
  !this.pointMenu.setActive('Next', !flag)
  !this.pointMenu.setActive('Previous', !flag)
  !this.pointMenu.setActive('Remove', !flag)
  !this.pointMenu.setActive('Remove all', !flag)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawPoints
--
-- Description: Draw current points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPoints()

  -- Initialise Variables
  !size = !this.definition.size()

  -- Hide definition
  !!aidNumbers.hide(!this.aidNumber)

  -- If we have more than one point, then we can draw the fence
  if(!size gt 1) then
    !this.profile = object PROFILE(!this.profilePlane.position, !this.profilePlane.orientation, !this.definition)
    !this.profile.close()
    !this.profile.draw(!this.aidNumber, 1, 4)
    AID TEXT NUMBER $!<this.aidNumber> '[$!this.definitionIndex]' AT $!<this.definition[$!<this.definitionIndex>]>
  elseif (!size eq 1) then
    AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<this.definition[$!<this.definitionIndex>]>
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      arcSelect
--
-- Description: Use picked arc to define profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arcSelect()

  -- Check if there is already a profile defined
  if(!this.profile.edges().empty().not()) then
    if(!!alert.confirm('Profile already defined, OK to replace it?').boolean().not()) then
      return
    endif
  endif

  -- Packet definition
  !packet                 = object EDGPACKET()
  !packet.pickPacket.circleDerive()
  !packet.pickPacket.prompt = 'Pick arc'
  !packet.pickPacket.picks[1].prompt = ''
  !packet.key               = 'pickArc'
  !packet.description       = !this.edgDescription
  !packet.priority          = 1
  !packet.action            = '!!dbeSRevolution.useArc(!this.return[1])'
  !packet.remove            = false
  !packet.escape            = '!!dbeSRevolution.setupGadgets()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useArc
--
-- Description: Use passed arc as a feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Picked arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useArc(!arc is ARC)

  -- Check if arc is set
  if(!arc.unset()) then
    return
  endif

  -- Initialise Variables
  !edges[1]    = !arc

  -- Check for full circle
  if(!this.arcMenu.selected('Full circle')) then
    !edges[1].startAngle = 0
    !edges[1].endAngle   = 360
    !edges[1].sense      = true
  endif

  !profile     = object PROFILE(!arc.position, !arc.orientation, !edges)
  !profile.close()

  !this.profileApply(!profile, |CREATE|)

  -- Remove event
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      standardShape
--
-- Description: Show standard shape form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Shape
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .standardShape(!shape is STRING)

  -- Initialise Variables
  !option = !shape.lowcase()

  -- Check if there is already a profile defined
  if(!this.profile.edges().empty().not()) then
    if(!!alert.confirm('Profile already defined, OK to replace it?').boolean().not()) then
      return
    endif
  endif

  -- Rectangles
  if(!option eq 'rectangle') then
    if(undefined(!!dbeFeatureRectangle)) then
      pml reload form !!dbeFeatureRectangle
    endif
    !!dbeFeatureRectangle.setup('!!dbeSRevolution.profile(!profile)', !this.profilePlane, !this.axesPoint, false)

  -- Polygon
  elseif (!option eq 'polygon') then
     if(undefined(!!dbeFeaturePolygon)) then
      pml reload form !!dbeFeaturePolygon
    endif
    !!dbeFeaturePolygon.setup('!!dbeSRevolution.profile(!profile)', !this.profilePlane, !this.axesPoint, false)

  -- Circle
  elseif (!option eq 'circle') then
    if(undefined(!!dbeFeatureCircle)) then
      pml reload form !!dbeFeatureCircle
    endif
    !!dbeFeatureCircle.setup('!!dbeSRevolution.profile(!profile)', !this.profilePlane, !this.axesPoint, false)

  -- Chord Height
  elseif (!option eq 'chord height') then
    if(undefined(!!dbeFeatureChordHeight)) then
      pml reload form !!dbeFeatureChordHeight
    endif
    !!dbeFeatureChordHeight.setup('!!dbeSRevolution.profile(!profile)', !this.profilePlane, !this.axesPoint, false)

  -- Arc
  elseif (!option eq 'arc') then
    if(undefined(!!dbeFeatureArc)) then
      pml reload form !!dbeFeatureArc
    endif
    !!dbeFeatureArc.setup('!!dbeSRevolution.profile(!profile)', !this.profilePlane, !this.axesPoint, false)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profile
--
-- Description: Use passed profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profile(!profile is PROFILE)

  -- Initialise Variables
  !this.profile = object PROFILE(!profile)
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyMode
--
-- Description: Set up to modify REVO
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       REVO element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyMode(!revo is DBREF)

  -- Get loop from REVO
  !!ce            = !revo
  !this.modRevo   = !revo
  !this.angle.val = !revo.angle
  !edges          = ARRAY()
  !this.flip.active = false

  !level          = !revo.level
  !obst           = !revo.obst
  !levelLow       = !level[1]
  !levelHigh      = !level[2]

  -- Search for matching representation from levels and obstruction
  $m/%PDMSUI%/CLIB/FILES/RDREP-DAT DATA $!<obst> $!<levelLow> $!<levelHigh>
  if( defined(!!cdcnrtn) ) then
    !repKey = ''
    -- Search for description of representation
    do !d indices !!gphRepLst.description
      if (!!gphRepLst.description[!d].eq(!!cdcnrtn.upcase())) then
        !repKey = !!gphRepLst.key[!d]
        break
      endif
    enddo
    -- Use defined key to set representation
    !this.representation = !!gphRepLst.key(!repKey)
  endif

  -- Attain profile definition from existing loop elements
  LOOP 1
  handle ANY
    !!alert.warning('No loop defined. This shape must be deleted and redefined.')
    !this.close()
    !this.hide()
    return
  elsehandle NONE
    !this.refLoop   = !!ce
    !!ce            = !revo

    -- Load profile data from chosen REVO
    !this.profile   = !this.profile.profile(!this.refLoop)
    handle any
      !!alert.error('Revolution cross section shape badly defined. Use profile editor to redefine the cross section shape.')
      !this.modifyLoop()
      !this.close()
      !this.hide()
      return
    endhandle
    !this.profilePlane  = !this.profile.plane()

    -- Plane of profile
    !rotatePlaneOri     = object ORIENTATION('Z IS ' & !revo.orientation.xDir() & ' AND X IS ' & !revo.orientation.yDir())
    !this.rotationPlane = object PLANE(!revo.position, !rotatePlaneOri)

    -- Point and rotation line
    !this.axesPoint     = !this.profile.position
    !localVolume        = object LOCALVOLUME(!revo,!revo)
    handle any
      !this.rotationLine.unset()
    elsehandle none
      !axisLineLength   = !localVolume.box().zLength + 500mm
      !pointVector      = !this.rotationPlane.pointVector()
      !pointVector      = !pointVector.offset(!axisLineLength * -0.5)
      !this.rotationLine = !pointVector.line(!axisLineLength)
    endhandle

  endhandle

  -- Hide create gadgets and change frame titles
  !this.createFrame.visible   = FALSE
  !this.modifyFrame.visible   = TRUE
  !this.displayModify.visible = FALSE
  !this.apply.callback = '!this.apply(|MODIFY|)'
  !this.apply.tag      = ' Apply '
  !this.dismiss.tag    = 'Dismiss'
  if (!this.modRevo.type eq 'REVO') then
    !this.formTitle = 'Modify +ve REVO'
  elseif (!this.modRevo.type eq 'NREV') then
    !this.formTitle = 'Modify -ve REVO'
  endif
  !this.draw()

endmethod
-- End of method definition for modifyMode(!revo is DBREF)

------------------------------------------------------------------------
--
-- Method:      modifyLoop
--
-- Description: Set up to modify REVO loop
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyLoop()

  -- Modify the loop of the current Revolution
  !!dbeLoopEdit(!this.modRevo, 'REVO NREV')

endmethod
-- End of method definition for modifyLoop()

------------------------------------------------------------------------
--
-- Method:      modifyProf
--
-- Description: Set up to modify REVO profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyProf()

  -- Modify the loop of the current Revolution as a profile
  show !!dbeProfileEdit
  !!dbeProfileEdit.setup(!this.modRevo)

endmethod
-- End of method definition for modifyProf()
