-- Created:         Mon Feb 27 14:00:00 "GMT 2006
--
--
-- Description:
-- Define a volume to collect elements within volume
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearAids()                      -                   Clear and close the form
--  close()                          -                   Clear and close the form
--  collect()                        -                   Collects the elements within defined volume
--  defineVolume()                   -                   Constructor
--  drawVolume()                     -                   draw box for the defined volume
--  initialise()                     -                   Initialise form position
--  pickPosition(STRING)             -
--  setForm(FORM)                    -
--  setFromPosition(POSITION)        -
--  setToPosition(POSITION)          -
--
import 'PositionControl'
handle ANY
endhandle

setup form !!defineVolume resize

  !this.formTitle     = 'Define Volume'
  !this.iconTitle     = ''
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.close()'
  !this.quitCall    = '!this.close()'
  !this.formRevision  = ' $Revision$ '

  para   .volumeTypePara  text 'Select Volume '   width 10 lines 1
  path right hdist 0.5
  option .volumeType      width 15
  path down

  frame .outerFrame at xmin form anchor t+l+r

     -- From Position Frame
     button .frmText linklabel 'From Position ' at xmin+1 ymax+.2 callback |!this.pickPosition('FROM')|

     frame .fromPositionFrame  PANEL  at xmin ymax.frmText+0.1 anchor t+l+r width 35 height 5
        container .fromPositionContainer PMLNetCONTROL 'NET' dock fill
     exit

     -- To Position Frame
     button .toText linklabel 'To Position ' at xmin.frmText ymax+.2 callback |!this.pickPosition('TO')|

     frame .toPositionFrame  PANEL at xmin.fromPositionFrame ymax+.1 anchor t+l+r width 35 height 5
       container .toPositionContainer PMLNetCONTROL 'NET' dock fill
     exit

     path down

     button .collect 'Collect'  anchor b+l at xmin.fromPositionFrame ymax+1 callback '!this.collect()' width 8 height 1

  exit

  -- Form Members
  using namespace 'Aveva.Pdms.Presentation'

  -- PMLNet Position control
  member .fromPosControl  is POSITIONCONTROL
  member .toPosControl    is POSITIONCONTROL

  -- Current position
  member .fromPosition  is POSITION
  member .toPosition    is POSITION

  -- Members to control picked position
  member .form          is FORM

  -- Encapsulating box of element
  member .box       is GMFBOX
  member .gphBox    is GPHBOX

  -- Aid Number
  member .aidVolume1    is REAL
  member .aidVolume2    is REAL
  member .aidBoxNumber  is REAL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      defineVolume
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--

------------------------------------------------------------------------
define method .defineVolume()

  -- options for collection type
  !volumeTypeDtext[1]  = 'Completely within'
  !volumeTypeDtext[2]  = 'Partially within '
  !this.volumeType.dtext = !volumeTypeDtext

  !volumeTypeRtext[1]  = 'COMPLETE'
  !volumeTypeRtext[2]  = 'PARTIAL'
  !this.volumeType.rtext = !volumeTypeRtext

  -- Setup for position control
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.fromPosControl   = object POSITIONCONTROL()
  !this.toPosControl     = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                   = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  --if( !grid.set() ) then
  if(!grid.set() and !grid.gridElement.set() ) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.fromPosControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.toPosControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    !this.fromPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.toPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.fromPosControl.heading('World Position')
    !this.toPosControl.heading('World Position')

  endif

  -- Assign action to be taken when position is changed
  !this.fromPosControl.changeAction('!!defineVolume.drawVolume()')
  !this.toPosControl.changeAction('!!defineVolume.drawVolume()')

  -- Initialise Control
  !this.fromPosControl.forceXYZ(0,0,0)
  !this.toPosControl.forceXYZ(0,0,0)

  -- Default position control - if the grid is defined and the COORDINATE
  -- state is XYZ, then we will assume that all positions using the control
  -- are to be displayed using the gridFormat.
  var !coordinate coordinate
  if(!grid.set().and(!coordinate.eq('XYZ'))) then
    !this.fromPosControl.gridFormat()
    !this.toPosControl.gridFormat()
  else
    !this.fromPosControl.enuFormat()
    !this.toPosControl.enuFormat()
  endif

  -- Add PMLNet control to PML frame
  !this.fromPositionContainer.control   = !this.fromPosControl.handle()
  !this.toPositionContainer.control     = !this.toPosControl.handle()

  !this.aidVolume1    = !!aidNumbers.add('Limits From')
  !this.aidVolume2    = !!aidNumbers.add('Limits To')
  !this.aidBoxNumber  = !!aidNumbers.add('Limits Box')

endmethod
-- End of constructor method .defineVolume()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get position
  !fromPosition = !!ce.position.wrt(World)
  handle ANY
    !fromPosition = N0
  endhandle
  !toPosition = !fromPosition

  !this.fromPosition  = !fromPosition
  !this.toPosition    = !toPosition

  !this.fromPosControl.xyz(!fromPosition.east, !fromPosition.north, !fromPosition.up)
  !this.toPosControl.xyz(!toPosition.east, !toPosition.north, !toPosition.up)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setForm
--
-- Description: Sets the calling form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     FORM         Calling form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setForm(!form is FORM )

  -- set the form from where this is called
  !this.form  = !form

endmethod
-- End of method .setForm()
------------------------------------------------------------------------
--
-- Method:      drawVolume
--
-- Description: draw box for the defined volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawVolume()

  using namespace 'Aveva.Pdms.Presentation'
  !this = !!defineVolume

  -- Get volume of element
  !fromPositionArray = !this.fromPosControl.xyz()

  !this.fromPosition.east  = !fromPositionArray[0]
  !this.fromPosition.north = !fromPositionArray[1]
  !this.fromPosition.up    = !fromPositionArray[2]
  !this.fromPosition.origin = object DBREF('World')

  -- Get volume of element
  !toPositionArray = !this.toPosControl.xyz()

  !this.toPosition.east  = !toPositionArray[0]
  !this.toPosition.north = !toPositionArray[1]
  !this.toPosition.up    = !toPositionArray[2]
  !this.toPosition.origin = object DBREF('World')

  !this.clearAids()

  aid text number $!<this.aidVolume1> 'From Pos' at $!<this.fromPosition>
  aid text number $!<this.aidVolume2> 'To Pos'   at $!<this.toPosition>

  !volume               = object VOLUME(!this.fromPosition,!this.toPosition)
  !this.box             = !volume.box()
  handle ANY
    !this.fromPosControl.xyz(0,0,0)
    !this.toPosControl.xyz(0,0,0)
    !volume               = object VOLUME(!this.fromPosition,!this.toPosition)
    !this.box             = !volume.box()
  endhandle

  !this.gphBox  = object GPHBOX(!this.box)
  !this.gphBox.filled(false)
  !this.gphBox.draw(!this.aidBoxNumber)

endmethod
-- End of method .drawVolume()

------------------------------------------------------------------------
--
-- Method:      clearAids
--
-- Description: Clear and close the form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAids()

  -- Clear graphics
  AID CLEAR ALL $!<this.aidVolume1>
  AID CLEAR ALL $!<this.aidVolume2>

  !!aidNumbers.remove(!this.aidVolume1)
  !!aidNumbers.remove(!this.aidVolume2)
  !!aidNumbers.remove(!this.aidBoxNumber)

endmethod
-- End of method definition .clearAids()

------------------------------------------------------------------------
-- Method:      collect
--
-- Description: Collects the elements within defined volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collect()

  !fromPosition  = !this.fromPosition
  !toPosition    = !this.toPosition

  !within = 'WITHIN'
  if(!this.volumeType.selection() eq 'COMPLETE') then
    !within = 'EXCLUSIVE WITHIN'
  endif

  var !volumeCollection collect all $!within $!fromPosition to $!toPosition

  if(!volumeCollection.unset()) then
    !!alert.error('No elements in the defined volume')
    return
  endif

  if(!this.form.set()) then
    !this.form.collectionArray = !volumeCollection
    !this.form.collectElements('VOLUME')
  endif

endmethod
-- End of method .collect()

------------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition(!positionRef is STRING )

  -- edg pick
  !packet = object EDGPACKET()
  !packet.key         = 'stdPosPick'
  !packet.action = '!!pickedPos = !this.return[1]'
  !packet.remove = true
  if(!positionRef.upcase() eq 'FROM') then
    !packet.pickPacket.stdPosition('Pick From Position ')
    !packet.continue = '!!defineVolume.setFromPosition(!!pickedPos.position)'
  else
    !packet.pickPacket.stdPosition('Pick To Position')
    !packet.continue = '!!defineVolume.setToPosition(!!pickedPos.position)'
  endif
  !packet.escape  = ''
  !!edgcntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setFromPosition
--
-- Description: sets the from position in the position control
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFromPosition(!fromPosition is POSITION )

  !this.fromPosition  = !fromPosition.wrt(world)
  !this.fromPosControl.xyz(!this.fromPosition.east, !this.fromPosition.north, !this.fromPosition.up)

  -- re-define the volume box
  !this.drawVolume()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setToPosition
--
-- Description: sets the to position in the position control
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setToPosition(!toPosition is POSITION )

  !this.toPosition    = !toPosition.wrt(world)
  !this.toPosControl.xyz(!this.toPosition.east, !this.toPosition.north, !this.toPosition.up)

  -- re-define the volume box
  !this.drawVolume()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: clear aids and re-initialise the form members
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- clear aids
  !this.clearAids()

  -- re-initialise the form members
  !this.initialise()

endmethod
-- End of method definition

------------------------------------------------------------------------
