--
--  Description:     -- Move by distance--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  badElement()                     BOOLEAN             returns true if the !this.element is not set correctly
--  clearanceFrameEvent(GADGET,STRING) -                   Open callback for tab selection
--  close()                          -                   close form.
--  desDragMove()                    -                   Constructor
--  distanceFrameEvent(GADGET,STRING) -                   Open callback for tab selection
--  init()                           -                   Initialise form
--  isWritable(DBREF)                STRING              Check if element can be modified
--  onCleApplyButtonClicked()        -                   Callback for APPLY button on clearance tab
--  onDisApplyButtonClicked()        -                   Callback for APPLY button on distance tab
--  onThrApplyButtonClicked()        -                   Callback for APPLY button on through tab
--  onTowApplyButtonClicked()        -                   Callback for APPLY button on towards tab
--  savePosition()                   -                   Save selected element position for undo
--  setCE()                          -                   Set selected element to CE
--  setDrag(BOOLEAN)                 -                   Set drag mode on or off  CALLED EXTERNALLY
--  setElement()                     -                   Initialise tab for selected element
--  setFormTitle()                   -                   set form title for current context
--  setInternalMode(STRING)          -                   set internal mode which controls options available to user
--  setMode(STRING)                  -                   set external mode which controls options available to user
--  throughFrameEvent(GADGET,STRING) -                   Open callback for tab selection
--  tidy()                           -                   Clear EDG and aids
--  towardsFrameEvent(GADGET,STRING) -                   Open callback for tab selection
--  undoEvent()                      -                   Undo or redo event. Re-initialise form if this element has
--
----------------------------------------------------------------------

setup form !!desDragMove dialog dock varchars

  frame .moveElementFrame 'Element to Move' anchor t+l+r at xmin form ymax
    button .ceButton pixmap width 16 height 16
    para   .ceLabel  anchor t+l+r text '[No Element Selected]' width 27
  exit

  frame .tabsetFrame TABSET anchor all at xmin.moveElementFrame ymax+.25

    --------------------------------
    -- DISTANCE
    --------------------------------
    frame .distanceFrame 'Distance' anchor all at xmin.moveElementFrame ymax
      frame .disParametersFrame 'Parameters'  anchor t+l+r at xmin.moveElementFrame+0.2 ymax width 31
        option .disOriginOption 'Origin:'     tagwid 8 anchor t+l+r at xmin.ceButton ymax width 17
        text   .disDistanceText 'Distance:'   tagwid 8 anchor t+l+r at xmin.ceButton ymax+0.2 width 19 is REAL format !!distanceFmt
        path down
        vdis 0.2
        text   .disDirectionText 'Direction:' tagwid 8 anchor t+l+r width.disDistanceText STRING
        text   .disWrtText       'WRT:'       tagwid 8 anchor t+l+r width.disDistanceText STRING
        button .disWrtCeButton    anchor t+r at xmax.disWrtText-10.3 ymax+.1 pixmap width 16.5 height 16
        button .disWrtOwnerButton anchor t+r at xmax ymin pixmap width 16.5 height 16
        button .disWrtWorldButton anchor t+r at xmax ymin pixmap width 16.5 height 16
        button .disWrtPickButton  anchor t+r at xmax ymin pixmap width 16.5 height 16
      exit
      frame .disTargetFrame       'Target'  anchor t+l+r at xmin.disParametersFrame ymax width.disParametersFrame
        option .disRelativeOption 'Relative To:' tagwid 8 anchor t+l+r at xmin.disWrtText ymax+0.2 width 17
        frame  .disAdditionalFrame panel    anchor t+l+r at xmin.disParametersFrame+0.1 ymax
          toggle .disPlaneToggle  ' Plane Through Target' anchor t+l tagwidth 16 at x9 ymax-0.2
          text   .disPlaneDirText 'Plane:'  tagwid 8 anchor t+l+r at xmin.disRelativeOption ymax+0.1 width.disDistanceText STRING
          option .disSelectOption 'Select:' tagwid 8 anchor t+l+r at xmin.disRelativeOption ymax+0.25 width 17
          text   .disNameText     'Name:'   tagwid 8 anchor t+l+r at xmin.disSelectOption ymax.disSelectOption+0.2 width 16 STRING
          button .disNamePickButton         anchor t+r   at xmax+0.2 ymin    pixmap width 16.5 height 16
          button .disPickPosButton          anchor t+r   at xmin     ymin    pixmap width 16.5 height 16
        exit
      exit
      button .disApplyButton 'Apply'         anchor t+r   at xmax.disTargetFrame-9 ymax.disTargetFrame+0.2 width 8 APPLY
    exit

    --------------------------------
    -- THROUGH
    --------------------------------
     frame .throughFrame 'Through'
       frame .thrParametersFrame 'Parameters' anchor t+l+r at xmin.moveElementFrame+0.2 ymax width 31
         path down
         vdis 0.2
         option .thrOriginOption  'Origin:'    tagwid 8 anchor t+l+r at xmin.ceButton ymax     width 17
         text   .thrDirectionText 'Direction:' tagwid 8 anchor t+l+r at xmin.ceButton ymax+0.2 width 19 STRING
         text   .thrWrtText 'WRT:'             tagwid 8 anchor t+l+r width 19 STRING
         button .thrWrtCeButton           anchor t+r at xmax.thrWrtText-10.3 ymax+.1 pixmap width 16.5 height 16
         button .thrWrtOwnerButton        anchor t+r at xmax ymin pixmap width 16.5 height 16
         button .thrWrtWorldButton        anchor t+r at xmax ymin pixmap width 16.5 height 16
         button .thrWrtPickButton         anchor t+r at xmax ymin pixmap width 16.5 height 16
       exit
       frame .thrAdditionalFrame 'Target'    anchor t+l+r at xmin.thrParametersFrame ymax width.thrParametersFrame
         toggle .thrPlaneToggle  ' Plane Through Target' anchor t+l tagwidth 16 at x9 ymax-0.2
         text   .thrPlaneDirText 'Plane:'   tagwid 8 anchor t+l+r at xmin.thrOriginOption ymax+0.1 width.thrDirectionText STRING
         option .thrSelectOption 'Through:' tagwid 8 anchor t+l+r at xmin.thrOriginOption ymax+0.2 width 17
         text   .thrNameText     'Name:'    tagwid 8 anchor t+l+r at xmin.thrSelectOption ymax.thrSelectOption+.2 width 16 STRING
         button .thrNamePickButton          anchor t+r   at xmax+0.2 ymin    pixmap width 16.5 height 16
         button .thrPickPosButton           anchor t+r   at xmin     ymin    pixmap width 16.5 height 16
       exit
       button .thrApplyButton 'Apply'   anchor t+r at xmax.thrAdditionalFrame-9 ymax+1 width 8 APPLY
    exit

    --------------------------------
    -- CLEARANCE
    --------------------------------
    frame .clearanceFrame 'Clearance'
      frame .cleParametersFrame  'Parameters' anchor t+l+r at xmin.moveElementFrame+0.2 ymax width 31
        option .cleOriginOption  'Origin:'    tagwid 8 anchor t+l+r at xmin.ceButton ymax width 17
        text   .cleDistanceText  'Clearance:' tagwid 8 anchor t+l+r at xmin.ceButton ymax+0.2 width 19 is REAL format !!distanceFmt
        path down
        vdis 0.2
        text   .cleDirectionText 'Direction:' tagwid 8 anchor t+l+r width 19 STRING
        text   .cleWrtText 'WRT:'             tagwid 8 anchor t+l+r width 19 STRING
        button .cleWrtCeButton     anchor t+r at xmax.cleWrtText-10.3 ymax+.1 pixmap width 16.5 height 16
        button .cleWrtOwnerButton  anchor t+r at xmax ymin pixmap width 16.5 height 16
        button .cleWrtWorldButton  anchor t+r at xmax ymin pixmap width 16.5 height 16
        button .cleWrtPickButton   anchor t+r at xmax ymin pixmap width 16.5 height 16
      exit
      frame .cleTargetFrame 'Target'     anchor t+l+r at xmin.cleParametersFrame ymax width.cleParametersFrame
        option .cleRelativeOption 'Relative To:' tagwid 8 anchor t+l+r at xmin.cleWrtText ymax+0.2 width 17
        frame  .cleAdditionalFrame panel anchor t+l+r at xmin.cleParametersFrame+0.1 ymax
          toggle .clePlaneToggle  ' Plane Through Target' anchor t+l tagwidth 16 at x9 ymax-0.2
          text   .clePlaneDirText 'Plane:'  tagwid 8  anchor t+l+r at xmin.cleRelativeOption ymax+0.1 width.cleDistanceText STRING
          option .cleSelectOption 'Select:' tagwid 8  anchor t+l+r at xmin.cleRelativeOption ymax+0.25 width 17
          text   .cleNameText 'Name:'       tagwid 8  anchor t+l+r at xmin.cleSelectOption ymax.cleSelectOption+0.2 width 16 STRING
          button .cleNamePickButton      anchor t+r   at xmax+0.2 ymin    pixmap width 16.5 height 16
          button .clePickPosButton       anchor t+r   at xmin     ymin    pixmap width 16.5 height 16
        exit
      exit
      button  .cleApplyButton 'Apply'  anchor t+r at xmax.cleTargetFrame-9 ymax.cleTargetFrame+0.2 width 8 APPLY
    exit

    --------------------------------
    -- TOWARDS
    --------------------------------
     frame .towardsFrame 'Towards'
      frame .towParametersFrame  'Parameters' anchor t+l+r at xmin.moveElementFrame+0.2 ymax width 31
        option .towOriginOption  'Origin:'    tagwid 8 anchor t+l+r at xmin.ceButton ymax width 17
        text   .towDistanceText  'Distance:'  tagwid 8 anchor t+l+r at xmin.ceButton ymax+0.2 width 19 is REAL format !!distanceFmt
      exit
      frame .towTargetFrame 'Target'     anchor t+l+r at xmin.towParametersFrame ymax width.towParametersFrame
        frame  .towAdditionalFrame panel anchor t+l+r at xmin.towParametersFrame+0.1 ymax
          option .towSelectOption 'Towards:'     tagwid 8 anchor t+l+r at xmin.towDistanceText ymax width 17
          text   .towNameText 'Name:'            tagwid 8 anchor t+l+r at xmin.towSelectOption ymax.towSelectOption+0.2 width 16 STRING
          button .towNamePickButton      anchor t+r   at xmax+0.2 ymin    pixmap width 16.5 height 16
          button .towPickPosButton       anchor t+r   at xmin     ymin    pixmap width 16.5 height 16
        exit
      exit
      button .towApplyButton 'Apply' anchor t+r at xmax.towParametersFrame-9 ymax+1 width 8 APPLY
    exit

  exit

  -- Members
  member .element            is DBREF
  member .savedPosition      is POSITION

  member .mDistance          is DESMOVEDISTANCETAB
  member .mThrough           is DESMOVETHROUGHTAB
  member .mClearance         is DESMOVECLEARANCETAB
  member .mTowards           is DESMOVETOWARDSTAB

  -- MOVE command wrapper object
  member .moveCommandObject  is DESMOVECOMMAND
  -- Undo
  member .undo               is UNDOABLE

  -- Coordinates
  member .targetPosition     is POSITION
  member .coordOptionValues  is ARRAY
  -- aids
  member .aidNumber          is REAL
  member .aidTarget          is REAL

  -- operation modes
  member .drag               is BOOLEAN
  -- internal mode setting
  member .mode               is STRING
  -- external mode - set by calling function
  member .commandMode        is STRING

  -- remember current tab
  member .tabNumber          is REAL

exit

------------------------------------------------------------------------
-- Method:      .desDragMove()
-- Description: Constructor
------------------------------------------------------------------------

define method .desDragMove()

  -- Aids
  !this.aidNumber  = !!aidNumbers.add('DesignMoveForm')
  !this.aidTarget  = !!aidNumbers.add('DesignMoveTarget')

  !this.formTitle  = 'Move'
  !this.iconTitle  = 'Move'
  !this.callback   = '!this.init()'
  !this.cancelCall = '!this.close()'

  -- Base Tooltips, Callbacks, Icons
  !this.ceButton.setTooltip('Select Current Element')

  !this.ceButton.callback = '!this.setCE()'
  !this.ceButton.addPixmap(!!pml.getPathName('ce16.png'))

  -- initial tab in Move
  !this.tabNumber   = 1
  !this.drag        = false
  !this.mode        = ''
  !this.commandMode = ''

  -- Move Distance
  !this.mDistance.initialiseTab(!this)
  !this.mDistance.setAids(!this.aidNumber, !this.aidTarget)
  !this.distanceFrame.callback = '!this.distanceFrameEvent('

  -- Move Through
  !this.mThrough.initialiseTab(!this)
  !this.mThrough.setAids(!this.aidNumber, !this.aidTarget)
  !this.throughFrame.callback = '!this.throughFrameEvent('

  -- Move Clearance
  !this.mClearance.initialiseTab(!this)
  !this.mClearance.setAids(!this.aidNumber, !this.aidTarget)
  !this.clearanceFrame.callback = '!this.clearanceFrameEvent('

  -- Move Towards
  !this.mTowards.initialiseTab(!this)
  !this.mTowards.setAids(!this.aidNumber, !this.aidTarget)
  !this.towardsFrame.callback = '!this.towardsFrameEvent('

  -- Initialise undo
  !this.undo.description('Move Relative')
  !this.undo.undoAction('!!desDragMove.undoEvent()')
  !this.undo.redoAction('!!desDragMove.undoEvent()')
  !this.disApplyButton.setUndoable(!this.undo)
  !this.cleApplyButton.setUndoable(!this.undo)
  !this.thrApplyButton.setUndoable(!this.undo)
  !this.towApplyButton.setUndoable(!this.undo)

endmethod

------------------------------------------------------------------------
-- Method:      .init()
-- Description: Initialise form
------------------------------------------------------------------------

define method .init()

  !this.setFormTitle()

  if( !this.tabNumber eq 2 ) then
    ------------------------------------------------------
    -- Initialise Move Through
    ------------------------------------------------------
    !this.mThrough.showTab()

  elseif( !this.tabNumber eq 3 ) then
    ------------------------------------------------------
    -- Initialise Move Clearance
    ------------------------------------------------------
    !this.mClearance.showTab()

  elseif( !this.tabNumber eq 4 ) then
    ------------------------------------------------------
    -- Initialise Move Towards
    ------------------------------------------------------
    !this.mTowards.showTab()

  else
    ------------------------------------------------------
    -- Initialise Move Distance
    ------------------------------------------------------
    !this.mDistance.showTab()

  endif

  ------------------------------------------------------
  -- Set the form to the Current Element
  ------------------------------------------------------
  !this.setCE()

endmethod

------------------------------------------------------------------------
-- Method:      close()
-- Description: close form.
------------------------------------------------------------------------

define method .close()

  if( !this.tabNumber eq 2 ) then
    ------------------------------------------------------
    -- Close Move Through
    ------------------------------------------------------
    !this.mThrough.closeTab()

  elseif( !this.tabNumber eq 3 ) then
    ------------------------------------------------------
    -- Close Move Clearance
    ------------------------------------------------------
    !this.mClearance.closeTab()

  elseif( !this.tabNumber eq 4 ) then
    ------------------------------------------------------
    -- Close Move Towards
    ------------------------------------------------------
    !this.mTowards.closeTab()

  else
    ------------------------------------------------------
    -- Close Move Distance
    ------------------------------------------------------
    !this.mDistance.closeTab()

  endif

  -- Remove applications events from system
  !this.tidy()

endmethod

------------------------------------------------------------------------
-- Method:      tidy()
-- Description: Clear EDG and aids
------------------------------------------------------------------------

define method .tidy()

  -- Remove applications events from system
  !!edgCntrl.remove('Pick Target Element')
  !!edgCntrl.remove('Pick Target Position')
  -- clear aids
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidTarget)

endmethod

------------------------------------------------------------------------
--
-- Method:      setDrag()
--
-- Description: Set drag mode on or off  CALLED EXTERNALLY
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for drag move, false for move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDrag(!drag is BOOLEAN)

  -- Set drag mode on all tabs
  !this.mDistance.setDrag(!drag)
  !this.mThrough.setDrag(!drag)
  !this.mClearance.setDrag(!drag)
  !this.mTowards.setDrag(!drag)
  !this.drag = !drag

endmethod

------------------------------------------------------------------------
--
-- Method:      setMode()
--
-- Description: set external mode which controls options available to user
--              and command used  CALLED EXTERNALLY
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode is 'BRANCH' or ''
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMode(!mode is STRING)

  !this.commandMode     = !mode
  !this.setInternalMode(!mode)

endmethod

------------------------------------------------------------------------
--
-- Method:      setInternalMode()
--
-- Description: set internal mode which controls options available to user
--              and command used
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode is 'BRANCH' or ''
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setInternalMode(!mode is STRING)

  -- Set mode on all tabs
  !this.mDistance.setMode(!mode)
  !this.mThrough.setMode(!mode)
  !this.mClearance.setMode(!mode)
  !this.mTowards.setMode(!mode)
  !this.mode = !mode

endmethod

------------------------------------------------------------------------
-- Method:      setFormTitle()
-- Description: set form title for current context
------------------------------------------------------------------------

define method .setFormTitle()

  if( !this.drag ) then
    !title = 'Drag'
  else
    !title = ''
  endif

  !title = !title + ' Move '

  if( !this.mode.upcase() eq 'BRANCH' ) then
    !title = !title + 'Branch'
  endif

  !this.formTitle = !title

endmethod

------------------------------------------------------------------------
-- Form Events
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Methods
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Method:      setCE()
-- Description: Set selected element to CE
------------------------------------------------------------------------
define method .setCE()

  -- test to make sure we are not at world level
  !unusedOwnerType  = !!ce.owner.type
  handle(2,754)
     !!alert.error('Current element "$!!ce.type" is unsuitable for this operation')
     return
  endhandle

  -- handle special pipe head, pipe tail case
  if( !this.commandMode eq 'BRANCH' ) then
    -- navigate to branch
    BRANCH
    handle any
      !!alert.error('Cannot find Branch element. Please navigate to a Branch.')
      !this.setMode('')
    elsehandle none
      !this.setMode('BRANCH')
    endhandle
  else
    !this.setMode('')
  endif


  -- check if change is allowed - if not just show previous element
  if( !!dbRefUpdate(!!ce).not() ) then
    !!alert.error(!!error)
    handle ANY
       !!alert.error('Current element "$!!ce.type" is unsuitable for this operation')
    endhandle
    return
  else
    if( !!ce.type eq 'BRAN' ) then
      -- safe to switch CE
      !this.element   = !!ce
      !this.setInternalMode('BRANCH')
    else
      -- check for POS attribute
      !error = !this.isWritable(!!ce)
      if( !error.empty().not() ) then
        !!alert.error(!error)
        return
      else
        -- safe to switch CE
        -- test for items with no position
        !unusedPos = !!ce.position
        handle (2,201)
          !!alert.error('Current element "$!!ce.type" is unsuitable for this operation')
          return
        endhandle
        !this.element = !!ce
      endif
    endif
  endif

  !name             = !this.element.flnn
  !this.ceLabel.val = !name
  !this.setFormTitle()

  !this.setElement()

endmethod

------------------------------------------------------------------------
-- Method:      setElement()
-- Description: Initialise tab for selected element
------------------------------------------------------------------------
define method .setElement()

  -- save position for undo
  !this.savePosition()

  if( !this.tabNumber eq 2 ) then
    ------------------------------------------------------
    -- Initialise Move Through
    ------------------------------------------------------
    !this.mThrough.setElement(!this.element)

  elseif( !this.tabNumber eq 3 ) then
    ------------------------------------------------------
    -- Initialise Move Clearance
    ------------------------------------------------------
    !this.mClearance.setElement(!this.element)

  elseif( !this.tabNumber eq 4 ) then
    ------------------------------------------------------
    -- Initialise Move Towards
    ------------------------------------------------------
    !this.mTowards.setElement(!this.element)

  else
    ------------------------------------------------------
    -- Initialise Move Distance
    ------------------------------------------------------
    !this.mDistance.setElement(!this.element)

  endif

endmethod

------------------------------------------------------------------------
-- *********************************************************************
-- * General Methods
-- *********************************************************************
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      isWritable()
--
-- Description: Check if element can be modified
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--    STRING      Error message or empty string if OK
--
------------------------------------------------------------------------
define method .isWritable(!element is DBREF) is STRING

  -- Ensure the item is moveable
  !unusedPosition = !element.pos
  handle (2,201)
    -- this element does not have POS
    return 'The current element does not have a position.'
  endhandle

  if( !element.dbWrite.not() or !element.modErr.attribute('POS').empty().not() ) then
    -- no write access to this element
    return 'You do not have permission to modify the current element.'
  endif

  return ''

endmethod

------------------------------------------------------------------------
-- Method:      savePosition()
-- Description: Save selected element position for undo
------------------------------------------------------------------------
define method .savePosition()

  -- save position for undo
  !this.savedPosition   = !this.element.position
  handle any
    !this.savedPosition = object POSITION()
  endhandle

endmethod

------------------------------------------------------------------------
-- *********************************************************************
-- * Tab Events
-- *********************************************************************
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Method:      distanceFrameEvent()
-- Description: Open callback for tab selection
------------------------------------------------------------------------

define method .distanceFrameEvent(!dummyGadget is GADGET, !action is STRING)

  if(!action eq 'HIDDEN') then
    !this.mDistance.closeTab()
  else
    !this.tabNumber = 1
    !this.mDistance.showTab()
    !this.mDistance.setElement(!this.element)
    handle ANY
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      throughFrameEvent()
-- Description: Open callback for tab selection
------------------------------------------------------------------------

define method .throughFrameEvent(!dummyGadget is GADGET, !action is STRING)

  if(!action eq 'HIDDEN') then
    !this.mThrough.closeTab()
  else
    !this.tabNumber = 2
    !this.mThrough.showTab()
    !this.mThrough.setElement(!this.element)
    handle ANY
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      clearanceFrameEvent()
-- Description: Open callback for tab selection
------------------------------------------------------------------------

define method .clearanceFrameEvent(!dummyGadget is GADGET, !action is STRING)

  if(!action eq 'HIDDEN') then
    !this.mClearance.closeTab()
  else
    !this.tabNumber = 3
    !this.mClearance.showTab()
    !this.mClearance.setElement(!this.element)
    handle ANY
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      towardsFrameEvent()
-- Description: Open callback for tab selection
------------------------------------------------------------------------

define method .towardsFrameEvent(!dummyGadget is GADGET, !action is STRING)

  if(!action eq 'HIDDEN') then
    !this.mTowards.closeTab()
  else
    !this.tabNumber = 4
    !this.mTowards.showTab()
    !this.mTowards.setElement(!this.element)
    handle ANY
    endhandle
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      onDisApplyButtonClicked
--
-- Description: Callback for APPLY button on distance tab
--
------------------------------------------------------------------------
define method .onDisApplyButtonClicked()

  -- abort if the forms main element is unset
  if !this.badElement() then
     return
  endif
  !this.mDistance.applyButtonClicked()
  -- save new position for undo
  !this.savePosition()

endmethod

------------------------------------------------------------------------
--
-- Method:      onThrApplyButtonClicked
--
-- Description: Callback for APPLY button on through tab
--
------------------------------------------------------------------------
define method .onThrApplyButtonClicked()

  -- abort if the forms main element is unset
  if !this.badElement() then
     return
  endif
  !this.mThrough.applyButtonClicked()
  -- save new position for undo
  !this.savePosition()

endmethod

------------------------------------------------------------------------
--
-- Method:      onCleApplyButtonClicked
--
-- Description: Callback for APPLY button on clearance tab
--
------------------------------------------------------------------------
define method .onCleApplyButtonClicked()

  -- abort if the forms main element is unset
  if !this.badElement() then
     return
  endif
  !this.mClearance.applyButtonClicked()
  -- save new position for undo
  !this.savePosition()

endmethod

------------------------------------------------------------------------
--
-- Method:      onTowApplyButtonClicked
--
-- Description: Callback for APPLY button on towards tab
--
------------------------------------------------------------------------
define method .onTowApplyButtonClicked()

  -- abort if the forms main element is unset
  if !this.badElement() then
     return
  endif
  !this.mTowards.applyButtonClicked()
  -- save new position for undo
  !this.savePosition()

endmethod

------------------------------------------------------------------------
-- Method:      undoEvent()
-- Description: Undo or redo event. Re-initialise form if this element has
--              changed
------------------------------------------------------------------------

define method .undoEvent()

  if(!this.shown()) then
    if( badref(!this.element) ) then
      return
    endif
    if( !this.savedPosition.unset() ) then
      return
    endif
    if( !this.element.position neq !this.savedPosition ) then
      -- if the current element position has changed, then undo has probably changed it
      !this.setElement()
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      badElement
-- Description: returns true if the !this.element is not set correctly
--
------------------------------------------------------------------------
define method .badElement()is BOOLEAN
!!ce = !this.element
handle ANY
  !!alert.error('Element to be moved is unset - Please select an element')
  return TRUE
elsehandle NONE
  SAME
  return FALSE
endhandle

endmethod
