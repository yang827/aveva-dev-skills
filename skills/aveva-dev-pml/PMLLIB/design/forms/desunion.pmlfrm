--
--
-- Description:
-- Change union attribute for current element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayView()                    -                   Displays View
--  go()                             -                   Change dunion attributes for given element and offspring
--  init()                           -                   Show dunion attribute setting for current element
--  updateView()                     -
--  useDefault()                     -                   Use Default Value For Current Element
--
------------------------------------------------------------------------

-- Define form
setup form !!desUnion

  !!desUnion.formTitle     = 'Modify Draft Edge Drawing'
  !!desUnion.iconTitle     = 'EDGE'
  !!desUnion.callback      = '!!desUnion.init()'
  !!desUnion.formRevision  = ' $Revision: 1.11 $ '

  -- member definitions
  member .element is DBREF
  member .data is DRADUNION

  -- Body of form definition

  button .ce |CE| call |!this.init()|

  paragraph .celement at xmax_ce+1 ymin width 36 height 2

  -- frame - Edge Drawing Values
  path down
  rgroup .radio at xmin form ymax 'Common Surface Edges' vertical callback |!this.updateView()|
    add tag |Always Shown |
    add tag |Not Shown Between Members |
    add tag |Not Shown Between Members And Peers  |
  exit

  button .useDef 'Use default' callback |!this.useDefault()|

  -- Cascade option - commented out - see method Go()
  -- toggle .cascade |Cascade to all offspring| at x1 ymax+0.2

  -- help plot view
  view .helpview at xmin form PLOT
    width 42 aspect 1.414
    borders off
    cursortype pointer
  exit


-- Bottom Line
  path down
  button .apply   | Apply | at xmax form-10-size call |!!desUnion.go()|
  path right
  button .cancel  |Dismiss| at xmax form-size ymin cancel

exit
-- End of form definition for !!desUnion


------------------------------------------------------------------------
--
-- Method:      .init
--
-- Description: Show dunion attribute setting for current element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()



 !dunionAtt = !!dtbWithAttribute(!!ce, 'DUNION')
  if (!dunionAtt.unset() eq FALSE ) then
      !this.element = !!ce
    else
      !!alert.error('You must be at an element that owns a Dunion (Edge Drawing) attribute e.g. ZONE.')
    return
  endif

!value = !!ce.dUnion.int()
handle any
elsehandle none
    if (!value lt 1) then
         !this.radio.val = 1
    elseif (!value gt 1) then
         !this.radio.val = 3
    else
         !this.radio.val = 2
    endif
endhandle

!this.celement.val = !!ce.fullName
!this.displayView()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .updateView
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateView()


!this.displayView()

endmethod
-- End of method definition for .updateView()

---------------------------------------------------------------------------
