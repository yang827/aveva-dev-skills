-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .go()

!dUnionValue = !this.radio.val - 1

-- Cascade toggle button commented out
-- if (!this.cascade.val) then

--     !elementString = !this.element.string()
-- OLD SYNTAX
--     var !collect COLLECT ALL (ZONE STRU SUBS FRMW SBFR FLOOR WALL SCREED) FOR $!elementString

--     if (!collect.size() gt 0) then
--          enhance all from !collect col 2

--          !answer = !!alert.confirm('OK to modify highlighted items?')
--          unenhance all
--          if (!answer eq 'YES') then

--               do !index from 1 to !collect.size()
--                   !!ce = !collect[!index].dbRef()
--                    DUNION $!dUnionValue
--               enddo
--               !!ce = !refe
--           endif
--      endif
-- else
  !this.element.dUnion = !dUnionValue
  handle any
  endhandle
-- endif

endmethod
-- End of method definition for .go()
--------------------------------------------------------------------------
--
-- Method:      displayView
--
-- Description: Displays View
--
-- Method Type: Function
--
------------------------------------------------------------------------

-- Define method

define method .displayView()

  edit !!desUnion.helpview plot
    if (!this.radio.val.string() eq '1') then

       add "%PDMSPLOTS%/WALLS/DUNION0.PLT"
        handle any
              !!alert.error('Check environment variable PDMSPLOTS is set up correctly')
            endhandle

      elseif (!this.radio.val.string() eq '2') then

        add "%PDMSPLOTS%/WALLS/DUNION1.PLT"
         handle any
              !!alert.error('Check environment variable PDMSPLOTS is set up correctly')
            endhandle

      elseif (!this.radio.val.string() eq '3') then

        add "%PDMSPLOTS%/WALLS/DUNION2.PLT"
         handle any
              !!alert.error('Check environment variable PDMSPLOTS is set up correctly')
            endhandle

    endif
  exit
endmethod
-- End of method definition for .displayView()
--------------------------------------------------------------------------

-- Method:      useDefault
--
-- Description: Use Default Value For Current Element
--
-- Method Type: Function
--
------------------------------------------------------------------------

-- Define method

define method .useDefault()

  !useDef = !!draDunion.getValue(!this.element.type)
  if(unset(!useDef)) then
    !!alert.error('Default value is unset!')
    return
  else
    !this.radio.val = !useDef + 1
    !this.displayView()
  endif

endmethod
-- End of method definition for .useDefault()
--------------------------------------------------------------------------
