--
-- File:            desuniondflt.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Thu Nov 20 15:52:20 1997
--
--
-- Description:
-- Form for changing default dunion attributes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  as()                             -                   Save As specified file name
--  from()                           -
--  go()                             -                   Save current settings to global variable
--  init()                           -
--  load(STRING)                     -                   Load from given file
--  save(STRING)                     -                   Save given defaults to a file
--
------------------------------------------------------------------------

-- Define form
setup form !!desUnionDflt
Import 'pmlfilebrowser'
handle any
endhandle

  !!desUnionDflt.formTitle     = 'Common Edge Drawing Defaults'
  !!desUnionDflt.iconTitle     = 'EDGE'
  !!desUnionDflt.callback      = '!!desUnionDflt.init()'
  !!desUnionDflt.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

bar
exit

-- Zones
path right
hdist 0.5
para .zoneText at x 1 ymax+0.5  Text |ZONE  |
rgroup .zone
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .struText at  x 1 ymax+0.5  Text |STRU  |
rgroup .stru
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .subsText  at  x 1 ymax+0.5  Text |SUBS  |
rgroup .subs
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .frmwText at  x 1 ymax+0.5   Text |FRMW  |
rgroup .frmw
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .sbfrText  at  x 1 ymax+0.5  Text |SBFR  |
rgroup .sbfr
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .floorText  at  x 1 ymax+0.5  Text |FLOOR |
rgroup .floor
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .screedText  at  x 1 ymax+0.5 Text |SCREED|
rgroup .screed
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit
para .wallText  at  x 1 ymax+0.5  Text |WALL  |
rgroup .wall
     add tag |Always              |
     add tag |Not Members         |
     add tag |Not Peers or Members|
exit

-- Bottom Line
  button .ok   | OK |   at xmin form-0 ymax form+0.25 call |!!desUnionDflt.go()| ok
  button .cancel |Cancel| at xmax form-size ymin cancel

exit

!bar = !!desUnionDflt.bar
   !bar.add( 'Load' , 'Load' )
   !bar.add( 'Save' , 'Save' )
!menu = !!desUnionDflt.newMenu('Load')
   !menu.add( 'CALLBACK', 'Load', '!!desUnionDflt.load(|des-dunion.pmldat|)')
   !menu.add( 'CALLBACK', 'Load From...', '!!desUnionDflt.from()')
!menu = !!desUnionDflt.newMenu('Save')
   !menu.add( 'CALLBACK', 'Save', '!!desUnionDflt.save(|des-dunion.pmldat|)')
   !menu.add( 'CALLBACK', 'Save As...', '!!desUnionDflt.as()')

-- End of form definition for !!desUnionDflt
------------------------------------------------------------------------
--
-- Method:      go
--
-- Description:  Save current settings to global variable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .go()

!value = !this.zone.val - 1
!!desUnionValue.set('ZONE',!value)
!value = !this.stru.val - 1
!!desUnionValue.set('STRU',!value)
!value = !this.subs.val - 1
!!desUnionValue.set('SUBS',!value)
!value = !this.frmw.val - 1
!!desUnionValue.set('FRMW',!value)
!value = !this.sbfr.val - 1
!!desUnionValue.set('SBFR',!value)
!value = !this.floor.val - 1
!!desUnionValue.set('FLOOR',!value)
!value = !this.screed.val - 1
!!desUnionValue.set('SCREED',!value)
!value = !this.wall.val - 1
!!desUnionValue.set('WALL',!value)

endmethod
-- End of method definition for .go()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

ONERROR CONTINUE
!this.zone.val = !!desUnionValue.get('ZONE') + 1
!this.stru.val = !!desUnionValue.get('STRU') + 1
!this.subs.val = !!desUnionValue.get('SUBS') + 1
!this.frmw.val = !!desUnionValue.get('FRMW') + 1
!this.sbfr.val = !!desUnionValue.get('SBFR') + 1
!this.floor.val = !!desUnionValue.get('FLOOR') + 1
!this.screed.val = !!desUnionValue.get('SCREED') + 1
!this.wall.val = !!desUnionValue.get('WALL') + 1
ONERROR RETURN

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load from given file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .load(!filename is STRING)

!!desUnionValue = object DUNION()

!!desUnionValue.load(!filename)
!this.init()

endmethod
-- End of method definition for .load(STRING)
-------------------------------------------------------------------
--
-- Method:      from
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .from()

call !!fileBrowser('"%PDMSUSER%"', 'des-dunion.pmldat' ,'Load Common Line Drawing Defaults', true, '!!desUnionDflt.load(!!fileBrowser.file.fullName()) ' )

endmethod
-- End of method definition for .from()

------------------------------------------------------------------------
--
-- Method:      save
-- Description: Save given defaults to a file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .save(!filename is STRING)

!saveList = object DUNION()

!value =  !this.zone.val - 1
!saveList.set('ZONE', !value)
!value =  !this.stru.val - 1
!saveList.set('STRU', !value)
!value =  !this.subs.val - 1
!saveList.set('SUBS', !value)
!value =  !this.frmw.val - 1
!saveList.set('FRMW', !value)
!value =  !this.sbfr.val - 1
!saveList.set('SBFR', !value)
!value =  !this.floor.val  - 1
!saveList.set('FLOOR', !value)
!value =  !this.screed.val - 1
!saveList.set('SCREED', !value)
!value =  !this.wall.val  - 1
!saveList.set('WALL', !value)

!saveList.save(!filename)

endmethod
-- End of method definition for .save(STRING)

------------------------------------------------------------------------
--
-- Method:      as
--
-- Description: Save As specified file name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .as()

call !!fileBrowser('"%PDMSUSER%"', 'des-dunion.pmldat' ,'Save Common Line Drawing Defaults', false, '!!desUnionDflt.save(!!fileBrowser.file.name()) ' )

endmethod
-- End of method definition for .as()
