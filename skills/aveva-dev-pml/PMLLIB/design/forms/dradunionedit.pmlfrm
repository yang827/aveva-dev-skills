--
--
--
-- Description:
-- Form for changing default dunion attribute
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   Display Dunion Object Data on Form
--  displayValue()                   -                   Returns Dunion Value
--  displayView()                    -                   Displays View
--  draDunionEdit()                  -                   Constructor
--  init()                           -                   Form Initialisation
--  load()                           -                   Load Saved Defaults
--  resetForm()                      -                   Resets Form
--  updateValue()                    -                   Updates Dunion Value
--
------------------------------------------------------------------------

-- Define form

setup form !!draDunionEdit

  !!draDunionEdit.formTitle     = 'Draft Edge Drawing Defaults'
  !!draDunionEdit.iconTitle     = 'EDGE'
  !!draDunionEdit.callback      = '!!draDunionEdit.init()'
  !!draDunionEdit.formRevision  = ' $Revision: 1.5 $ '

  -- member definitions
  member .data is DRADUNION

  -- gadget definitions

  -- menu bar definition
  bar
  add 'File' .fileMenu
  exit

  -- List definition
  list .elements 'Elements       Edges' at xmin ymax width 38 length 7



  -- Radio group
  rgroup .choice 'Common Surface Edges' at xmin ymax FRAME VERTICAL
     add tag 'Always Shown' select '0'
     add tag 'Not Shown Between Members' select '1'
     add tag 'Not Shown Between Members And Peers' select '2'

  exit

  -- help plot view
   view .helpview at xmin ymax_choice+1 PLOT
   width 42 aspect 1.414
    borders off
    cursortype pointer

   exit

  -- Bottom Line
  button .ok   | OK |   at xmin form-0 ymax form+0.25  ok
  button .reset |Reset| at xmax_ok+11 ymin reset
  button .cancel |Cancel| at xmax form-size ymin cancel

exit
-- End of form definition for !!draDunionEdit

------------------------------------------------------------------------
--
-- Method: draDunionEdit
--
-- Description: Constructor
--
-- Method Type: Procedure
--
-----------------------------------------------------------------------
define method .draDunionEdit()

  -- build menu bar

  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save', '!this.data.save()')
  !this.fileMenu.add('callback', 'Load', '!this.load()')


  -- define gadget callbacks
  !this.elements.callback = '!this.displayValue()'
  !this.choice.callback   = '!this.updateValue()'
  !this.ok.callback       = '!this.data.copyToGlobal()'
  !this.reset.callback    = '!this.resetForm()'
  !this.displayView()
endmethod
-- End of method definition for .draDunionEdit()


------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Form Initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  !this.data = !!draDunion

  !this.elements.val = 1
  handle (61,620)
    -- list is empty, no action required
  endhandle

  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      display()
--
-- Description: Display Dunion Object Data on Form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .display()

  !listPos = !this.elements.val

  !values  = !this.data.display()
  !this.elements.dText = !values[1]
  !this.elements.rText = !values[2]


    if (!listPos eq 0) then
      !this.elements.val = 1
    else
      !this.elements.val = !listPos
    endif
    !this.displayValue()

endmethod
-- End of method definition for .display()

--------------------------------------------------------------------------
--
-- Method:      displayValue
--
-- Description: Returns Dunion Value
--
-- Method Type: Function
--
------------------------------------------------------------------------

-- Define method

define method .displayValue()

  !v = !this.data.getValue(!this.elements.selection())
  !this.choice.select(!v.string())
  !this.displayView()

endmethod
-- End of method definition for .displayValue()
--
--------------------------------------------------------------------------
--
-- Method:      updateValue
--
-- Description: Updates Dunion Value
--
-- Method Type: Function
--
------------------------------------------------------------------------

-- Define method

define method .updateValue()

  !this.data.setValue(!this.elements.selection(), !this.choice.selection().real())
  !this.display()

endmethod
-- End of method definition for .updateValue()
--------------------------------------------------------------------------
--
-- Method:      displayView
--
-- Description: Displays View
--
-- Method Type: Function
--
------------------------------------------------------------------------

-- Define method

define method .displayView()

  edit !!draDunionEdit.helpview plot
    if (!this.choice.selection() eq '0') then

           add "%PDMSPLOTS%/WALLS/DUNION0.PLT"
            handle any
              !!alert.error('Check environment variable PDMSPLOTS is set up correctly')
            endhandle

        elseif (!this.choice.selection() eq '1') then

             add "%PDMSPLOTS%/WALLS/DUNION1.PLT"
               handle any
                 !!alert.error('Check environment variable PDMSPLOTS is set up correctly')
               endhandle

        elseif (!this.choice.selection() eq '2') then

            add "%PDMSPLOTS%/WALLS/DUNION2.PLT"
              handle any
                !!alert.error('Check environment variable PDMSPLOTS is set up correctly')
              endhandle

    endif
  exit
endmethod
-- End of method definition for .displayView()
--------------------------------------------------------------------------
--
-- Method:      resetForm
--
-- Description: Resets Form
--
-- Method Type:
--
------------------------------------------------------------------------
define method .resetForm()

  !this.init()

endmethod
-- End of method definition for .resetForm()
--------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load Saved Defaults
--
-- Method Type:
--
------------------------------------------------------------------------
define method .load()

  !this.data.load()
  !this.display()


endmethod
-- End of method definition for .load()
