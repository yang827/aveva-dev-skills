--
--
-- Description:
-- display ddse's for repeat item
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -
--  initialise()                     -
--  loadUp()                         -
--  replace()                        -
--
------------------------------------------------------------------------

-- Define form
setup form !!dtsReptDisp

  !!dtsReptDisp.formTitle     = 'Repeat Item Properties'
  !!dtsReptDisp.iconTitle     = 'RepProp'
  !!dtsReptDisp.callback      = '!!dtsReptDisp.initialise()'
  !!dtsReptDisp.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition

-- bar
  bar
    add |Control|    _CNTRL
  exit

   -- Control Menu
    menu _CNTRL
      add |Close| |!!dtsReptDisp.close()|
    exit


--  Heading
  path down

  para .repeatItem  width 50 lines 1
  -- set it
  _repeatItem.val = 'Repeat Item   :'
  halign right
-- Description (DTIT)

  para    .description  width 50 lines 1
  -- set it
  _description.val = 'Description   :'
-- Data type

  para    .dataType    width 50 lines 1
  -- set it
  _dataType.val =   'Data Type     :'
-- Property

 text    .property  at xmin ymax  |Property      :| width 30 scroll 60 string

-- Default

 text    .default at xmin ymax    |Default Value :| width 30 scroll 60 string


  button  .replace at xmin+15.5 ymax    |Replace| call |!!dtsReptDisp.replace()|

  list    .elements at xmin.repeatItem ymax |Current Properties| call |!!dtsReptDisp.loadUp()|  width 50 length 10

-- Global for setting ddat values

member .whichDdat is DBREF

exit
-- End of form definition for !!dtsReptDisp

------------------------------------------------------------------------
--
-- Method:      <initialise>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()
!dText = ARRAY()
!rText = ARRAY()
!item = !!ce
!fullName = !item.flnn
!listPos  = !this.elements.val
-- display item name
!this.repeatItem.val = 'Repeat Item   : ' & !fullName

-- COLLECT ALL DDAT's for DDSE (assume there is only 1)
   var !dataRecords COLLECT ALL DDAT FOR DDSE 1 OF $!item

-- EVALUATE attributes for dataRecords

   var !dtit EVALUATE DTIT FOR ALL FROM !dataRecords IGNORE ANY
   var !dKey EVALUATE DKEY FOR ALL FROM !dataRecords IGNORE ANY
   var !temp EVALUATE DDPR FOR ALL FROM !dataRecords IGNORE ANY
-- take brackets out
   var !ddpr EVALUATE (TRIM(TRIM(TRIM(VTEXT(!temp,VVAL(!en)),'L',|(|),|R|,|)|))) INDICES !temp COUNT !en

   var !temp EVALUATE DDDF FOR ALL FROM !dataRecords IGNORE ANY
-- take brackets out
   var !dddf EVALUATE (TRIM(TRIM(TRIM(VTEXT(!temp,VVAL(!en)),'L',|(|),|R|,|)|))) INDICES !temp COUNT !en
-- Display Information

   !dSiz = !dtit.width().max(35)
   !pSiz = !ddpr.width().max(35)
   !xSiz = !dddf.width().max(10)

 var !dprt COMPOSE SPACE 1 |Key| WIDTH 4 SPACE 2 |Description| WIDTH $!pSiz C SPACE 2 |Property| WIDTH $!dSiz C SPACE 2 |Default| WIDTH $!xSiz C

-- load list with ddats
   !dText[1] = '$!dprt[1]'
   !rText[1] = ''

   do !i indices !dataRecords
    var !dprt COMPOSE  SPACE 1 |$!dKey[$!i]| WIDTH 4 SPACE 2 |$!dtit[$!i]| WIDTH $!pSiz C SPACE 2 |$!ddpr[$!i]| WIDTH $!dSiz SPACE 2 |$!dddf[$!i]| WIDTH $!xSiz C
    !dText.append(!dprt[1])
    !rText.append(!dataRecords[!i].string())
   enddo

   !this.elements.dText = !dText
   !this.elements.rText = !rText
   !this.elements.val = !listPos
endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      <replace>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .replace()

!refe = !!ce

!prop  = !this.property.val
!dflt  = !this.default.val

-- goto ddat and set attributes
   !!ce = !this.whichDdat

   DDPR $!prop
   DDDF $!dflt


-- Go Back to original position in hierarchy
   !!ce = !refe
-- load new values into list
   !this.initialise()

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      <loadUp>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .loadUp()

!dataRecord = !this.elements.selection('RTEXT').dbRef()


  if(!dataRecord.unset()) then
    -- do nothing if header is picked
    return
  endif

-- set global for modifying
   !this.whichDdat = !dataRecord

-- Load Property and Default into gadgets
   !this.description.val = 'Description   : ' & !dataRecord.dtit
   !this.dataType.val    = 'Data Type     : ' & !dataRecord.pTYP
   !this.property.val    = !dataRecord.ddpr.string().trim('L','(').trim('R',')').trim()
   !this.default.val     = !dataRecord.dddf.string().trim('L','(').trim('R',')').trim()

endmethod
-- End of method definition for .loadUp()

------------------------------------------------------------------------
--
-- Method:      <close>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  hide !!dtsReptDisp

endmethod
-- End of method definition for .close()
