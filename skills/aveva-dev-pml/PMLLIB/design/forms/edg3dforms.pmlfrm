-- File:            edg3dforms.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     EDG
--   Module:        DESIGN
--   Application:   EDG
--   Replaces:      F3DFORMS    (DES/GRAPHICS)
--
-- Author:          P.Mooney
-- Created:         Tue Mar 4 14:25:06 GMT 1997
--
--
-- Description:
-- Graphical View creation form. Will be replaced by an object...
-- Stores inmode etc..
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!edg3DForms

  !!edg3DForms.formTitle  =  '3D Forms (New)'

  -- Current Mode
  text _imod |Input Mode| at xmin+5 ymin width 20 string
  path down
  halign right
  text _appl |Application| width 24 string

  -----------------------------------------------------------------------
  -- This can be deleted - !!view3DCntrl.active now hold all active views
  -----------------------------------------------------------------------
  list _form |Current 3D Forms| width 30 length 10

  path down
  halign right

  button _dismiss |  OK  | ok

exit
-- End of form definition for !!edg3DForms
