--
-- Author:          P.Mooney
-- Created:         Mon Jun 30 11:38:20 BST 1997
--
--
-- Description:
-- Simple prompt form used in picking elements form a view.
-- See !!edg3DPick() and !!edg3DPicks() for more details.
--
------------------------------------------------------------------------

setup form !!edg3DPickFrm

  !!edg3DPickFrm.formTitle     = 'Pick'
  !!edg3DPickFrm.iconTitle     = 'Pick'
  !!edg3DPickFrm.callback      = ''
  !!edg3DPickFrm.formRevision  = ' $Revision: 1.4 $ '

  ---------------------------
  -- Body of form definition
  ---------------------------

  para   .text   at xmin+0.5 ymax+0.5 width 30 lines 3

  button .ok     |  OK  | at xmin ymax  call |call !!edg3DPickCB('OK')|
  button .cancel |Cancel| at x26  ymin  call |call !!edg3DPickCB('CANCEL')|

  ---------------------------------------------------------------
  -- Stack stores the callbacks for each user function calling
  -- EDG3DPick(s)
  ---------------------------------------------------------------

  member .currentView    is GADGET
  member .stack          is ARRAY

exit
-- End of form definition for !!edg3DPickFrm

  -- default text for form is for multiple picks
  !!edg3DPickFrm.text.val = 'When you have finished picking elements, click the Ok button'
