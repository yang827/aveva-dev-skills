--  File:            edg3dposoffset.pmlfrm
--    Type:          Form Definition
--    Group:         Common
--      Keyword:     Common
--    Module:        design
--  Author:          Daniel(Jaehun.Choi)
--  Created:         23 July 2010
--
--  Description:     get 3d position offset by edg
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply offset position
--  close()                          -                   close this form
--  edg3dposoffset()                 -                   constructor
--  initialise()                     -                   initialise gadgets
--
-----------------------------------------------------------------------

layout form !!edg3dposoffset

  frame .frmOffset 'Offset' at x0.5 y0 width 20
    para .parLock           at xmax-1 y0 text 'Lock'

    text .txtX 'X' tagwid 2 at x1 ymax      width 14 is REAL format !!distanceFmt
    text .txtY 'Y' tagwid 2 at x1 ymax+0.25 width 14 is REAL format !!distanceFmt
    text .txtZ 'Z' tagwid 2 at x1 ymax+0.25 width 14 is REAL format !!distanceFmt

    toggle .tglXLock at xmax+1.25 ymin.txtX
    toggle .tglYLock at xmin ymin.txtY
    toggle .tglZLock at xmin ymin.txtZ
  exit

  toggle .tglAddPos 'Add Point' at x1 ymax+0.25

  button .btnApply   'Apply'   at xmin form    ymax form+0.25 callback '!this.apply()' width 8
  button .btnDismiss 'Dismiss' at xmax form-size ymin         callback '!this.close()' width 8

  member .position   is POSITIONLINK
  member .sourcePos  is POSITION
  member .sourceForm is FORM
exit

------------------------------------------------------------------------
--
-- Method:      edg3dposoffset
--
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edg3dposoffset()

  !this.formTitle = 'Input Offset'
  !this.callback  = '!this.initialise()'

  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!edg3dposoffset.position', !this.txtX, !this.txtY, !this.txtZ)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!edg3dposoffset.position', !this.tglXLock, !this.tglYLock, !this.tglZLock)

  -- Set Position Action
  !this.position.setAction('')
endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialise gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  var !coord coord

  if (!coord ne 'XYZ') then
    !this.txtX.tag = 'E'
    !this.txtY.tag = 'N'
    !this.txtZ.tag = 'U'
  else
    !this.txtX.tag = 'X'
    !this.txtY.tag = 'Y'
    !this.txtZ.tag = 'Z'
  endif

  !this.txtX.val = 0
  !this.txtY.val = 0
  !this.txtZ.val = 0

  !this.position.initialise()
endmethod

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply offset position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()
  -- Handle unset values
  if(!this.txtX.val.unset()) then
    !this.txtX.val = 0
  endif

  if(!this.txtY.val.unset()) then
    !this.txtY.val = 0
  endif

  if(!this.txtZ.val.unset()) then
    !this.txtZ.val = 0
  endif

  -- Define Position
  !position = !this.position.get()

  !this.sourcePos.east = !this.sourcePos.east + !position.east
  !this.sourcePos.north = !this.sourcePos.north + !position.north
  !this.sourcePos.up = !this.sourcePos.up + !position.up


  if (!this.tglAddPos.val) then
    !!edgCntrl.explicitposition(!this.sourcePos)
  else
    !this.sourceForm.derivePositionByOffset(!this.sourcePos)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()
  !this.hide()
endmethod
