--
-- File:            edggeomtbar.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:      _cdGeomTBar
--
-- Author:          P.Mooney
-- Created:         Wed Jul 9 18:11:01 BST 1997
--
--
-- Description:
-- PML2 version of the old _cdGeomTBar.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgGeomTBar()                    -                   constructor
--  elementFilter()                  -                   method to show element filter selection form
--  init()                           -                   form initialisation
--  pLineFilter()                    -                   method to show element filter selection form
--  pointFilter()                    -                   method to show element filter selection form
--
------------------------------------------------------------------------

setup form  !!edgGeomTBar at xr 0.2 yr 0

  !!edgGeomTBar.formTitle     = 'Pick'
  !!edgGeomTBar.iconTitle     = 'Pick'
  !!edgGeomTBar.callback      = '!!edgGeomTBar.init()'
  !!edgGeomTBar.formRevision  = ' $Revision: 1.9 $ '

  -----------------------------------------------------------
  -- MEMBERS
  --   LastGadget   button pressed last time (buttons above)
  --   wpShown      Is Working Points form shown?
  --   isShown      Is Intermediate Snap form shown?
  -----------------------------------------------------------

  member .lastGadget is GADGET
  member .wpShown    is BOOLEAN
  member .isShown    is BOOLEAN
  member .shownBefore is BOOLEAN
  member .elementFilter is STRING
  member .pLineFilter is STRING
  member .pointFilter is STRING

  bar
    add |Settings| _MSET
    add |Filters|  _MFILT
  exit

   -- Settings
    menu _MSET
      add |Intermediate Snaps...| form _cdGeomSnap
      add sep
      add |Tubing Start/End...|   form _cdGeomTube
      add |Section Start/End...|  form _cdGeomSctn
      add |Panel/Extrusions...|   form _cdGeomExtr
      add |Points...|             form _cdGeomPpnt
      add |3D Line...|            form _cdGeomLine
      add sep
      add |Working Points...|        |!!edgSetWP()|
    exit

   -- Filters
    menu _MFILT
      add |Elements...| |!!edgGeomTBar.elementFilter()|
      add |Plines...|   |!!edgGeomTBar.pLineFilter()|
      add |Points...|   |!!edgGeomTBar.pointFilter()|
    exit

  ----------------------------------------------------
  -- Pick Type
  ----------------------------------------------------

  option   _ptyp |Pick Type| at xmin ymax call |CALLGEOM DGEOMHDLR $$_PTYP| width 10
  var list _ptyp pairs |Element| |PICK|
                       |Pline|   |PPLINE|
                       |Point|   |POINT|
                       |3D Line| |SCREEN|
                       |Any|     |PANY|
  exit

  -- Snap On/Off
  toggle _sflg |Intermediate Snap| at xmin+2 ymax+0.2  call |var _cdGeomData_sFlg '$$_SFLG' | states |false| |true|

  path down

  -- Pick Options
  para _ptxt  at x0 ymax text |Pick Options:|

--  frame _popt |Pick Options| at xmin form-0 ymax+0.25

    ------------- Insert available options ----------

    do !i from 2

      !data = !!edgData.list.rText[!i]
      handle any
        break
      endhandle

      var !val  (PART(VTEXT(!data),3,|\|))
      var !vtyp (PART(VTEXT(!data),4,|\|))
      var !desc (PART(VTEXT(!data),7,|\|))

      var !dprt COMPOSE (TRIM(|$!desc|)) WIDTH 14 C

      button .a$!i$nB |$!dprt[1]| at x0 ymax call |call !!edgSetViews($!i, !!edgGeomTBar.a$!i$nB)|

      if(upcase(|$!val|) eq |ASK|) then
        text .a$!i call |call !!edgSetViews($!i, !!edgGeomTBar.a$!i$nB)| at xmax ymin width 10 $!vtyp
      endif

    enddo

    button .n  |   Navigate   | at xmin form-0 ymax+0.25 call |call !!edgSetViews(1, !!edgGeomTBar.n)|


exit
-- End of form definition for !!edgGeomTBar

------------------------------------------------------------------------
--
-- Method:      !edgGeomTBar()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .edgGeomTBar()

  !this.wpShown = FALSE
  !this.isShown = FALSE
  !this.elementFilter = 'No Rule'
  !this.pLineFilter = 'No Rule'
  !this.pointFilter = 'No Rule'

endmethod
-- End of method definition for .edgGeomTBar()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- run the constructor if this is the first time the form has been shown
  if (!this.shownBefore.unset() or !this.shownBefore.not()) then
    !this.edgGeomTBar()
    !this.shownBefore = true
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !elementFilter()
--
-- Description: method to show element filter selection form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .elementFilter()

  -- show the rule selection form
  show !!comElementRlSel

  -- set the additional ok callback
  !!comElementRlSel.function = '!!edgGeomTBar.elementFilter = !!comElementRlSel.list.selection()'

  -- use the filter
  !!edgGeomFilt()

endmethod
-- End of method definition for .elementFilter()

------------------------------------------------------------------------
--
-- Method:      !pLineFilter()
--
-- Description: method to show element filter selection form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .pLineFilter()

  -- show the rule selection form
  show !!comPlineRlSel

  -- set the additional ok callback
  !!comPlineRlSel.function = '!!edgGeomTBar.pLineFilter = !!comPlineRlSel.list.selection()'

  -- use the filter
  !!edgGeomFilt()

endmethod
-- End of method definition for .pLineFilter()

------------------------------------------------------------------------
--
-- Method:      !pointFilter()
--
-- Description: method to show element filter selection form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .pointFilter()

  -- show the rule selection form
  show !!comPointRlSel

  -- set the additional ok callback
  !!comPointRlSel.function = '!!edgGeomTBar.pointFilter = !!comPointRlSel.list.selection()'

  -- use the filter
  !!edgGeomFilt()

endmethod
-- End of method definition for .pointFilter()
