--
--
-- Description:
-- Defines form for creating working points, graphical aids in space, so they
-- can be picked later.
--
------------------------------------------------------------------------

setup form !!edgWorkPoint

  !!edgWorkPoint.formTitle     = 'Working Points'
  !!edgWorkPoint.iconTitle     = 'W Points'
  !!edgWorkPoint.callback      = ''
  !!edgWorkPoint.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  path down
  halign left
  !frameWidth = 25
  !listWidth  = !frameWidth - 3

--  frame .typeFrame at x0 y0 'Element Type' width $!frameWidth
--    rgroup .type  callback '!!edgWorkQual()' VERTICAL
--      add tag 'Sctn'  select 'SCTN'
--      add tag 'Panel' select 'PANE'
--    exit
--  exit

  frame .posFrame at xmin+0.3 ymax+0.3 'Position' width $!frameWidth
    text .east   'East   ' width 10 is REAL
    text .north  'North  ' width 10 is REAL
    text .up     'Up     ' width 10 is REAL
    text .offset 'Off-Set' width 10 is REAL
  exit

  toggle .aidText |Show Aid Numbers| at xmin ymax+0.5 call |call !!edgWorkPoints('AIDTEXT')|

  button .add     | Add |    at xmin ymax+0.5 call |call !!edgWorkPoints('ADD')|
  button .modify  |Modify|   at xmax ymin     call |call !!edgWorkPoints('MODIFY')|
  button .remove  |Remove|   at xmax ymin     call |call !!edgWorkPoints('REMOVE')|

  list .list 'Points:' at xmin_posFrame ymax+0.3 width $!listWidth height 5

--  button .APPLY   |Apply|   at xmin form-0 ymax form+0.3 call |call !!edgWorkPoints('APPLY')|   apply
  button .dismiss |Dismiss| at xmax form-size ymax       call |call !!edgWorkPoints('DISMISS')|

  -----------------------------------------------------------------
  -- MEMBERS - working data for sphere that maybe added
  --           to the .list above
  -- Aid      - Last sphere displayed. May not be Added to list yet
  -- AidArray - Array of EDGAID objects to reflect what is
  --            displayed on above list.
  -----------------------------------------------------------------

  member .aid       is EDGAID
  member .aidArray  is ARRAY

exit
-- End of form definition for !!edgWorkPoint

!!edgWorkPoint.offset.val = 0
