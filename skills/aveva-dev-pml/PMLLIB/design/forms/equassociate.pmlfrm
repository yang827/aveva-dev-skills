-- Description:
--  Equipment Association creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeAssociation()              -                   Modify Association callback
--  changeAssociationPartner(DBREF,DBREF) BOOLEAN             Change Association partner
--  changePartner(EDGPICKDATA)       -                   pick replacement partner element callback
--  changeUndo()                     -                   Undo last association action
--  checkName(STRING)                STRING              Validate name field
--  clearAllPanes()                  -                   Make front page visible
--  close()                          -                   Close form handler
--  constraintTypeCallback()         -                   Callback for change in constraint selection
--  createAssociation()              -                   Create Association callback
--  createUndo()                     -                   Undo last association action
--  dbChanged()                      -                   Event handler for database change. Allows for current
--  deleteAssociation()              -                   Delete association callback
--  equAssociate()                   -                   Constructor
--  getPartner(DBREF)                DBREF               Get SINGLE partner for this element in the given association
--  initSelectAssociationElement()   -                   Set form up to ask for primary association element
--  initialise()                     -                   Initialise create mode
--  measure()                        -                   Returns true if debug mode switched on (!!assocDebug = true)
--  member(EDGPICKDATA)              -                   pick primary member element callback
--  modifyAssociation()              -                   Modify Association callback
--  modifyAssociation(DBREF)         BOOLEAN             Modify Association callback
--  myPickReferencePlane()           -                   Callback to pick a reference plane on me
--  myReferencePlane()               -                   Callback for standard reference plane selection
--  navigateAssoc()                  -                   Popup menu callback- Navigate to selected element
--  navigatePartner()                -                   Popup menu callback- Navigate to selected element
--  newAssociation(DBREF)            -                   Create a new association with the given partner
--  next()                           -                   Tidy up after completed operation and initialise for next
--  partner(EDGPICKDATA)             -                   pick partner element callback
--  partnerPickReferencePlane()      -                   Callback to pick a reference plane on partner
--  partnerReferencePlane()          -                   Callback for standard partner reference plane selection
--  pick(REAL)                       -                   set up pick for association member element
--  refreshAssociations()            -                   refresh the list of associations
--  reportAssoc(GADGET)              -                   Popup menu callback- Test the selected Association
--  selectAssociation(GADGET,STRING) -
--  setAttribute(GADGET,STRING)      -                   Set REAL attribute data
--  setParameterField()              -                   Set up parameter input fields
--  setup(DBREF)                     -                   Setup form with passed element
--  setupDefinitionPage(STRING)      -                   Setup detail definition page - after association builder object
--  showAssociations(BOOLEAN,BOOLEAN,BOOLEAN,GADGET) -                   Show a table of associations
--  showAssociations(BOOLEAN,BOOLEAN,BOOLEAN,GADGET,DBREF) -                   Show a table of associations between this element and a given partner element
--  testAssoc()                      -                   Popup menu callback- Test the selected Association
--  testAssociation(DBREF)           -                   test the given association and show result
--  tidy()                           -                   Tidy up aid graphics
--  validateName(GADGET,STRING)      -                   Validate name field
--
------------------------------------------------------------------------

setup form !!equAssociate dialog dock right

  !this.iconTitle     = 'EquiAssoc'
  !this.formTitle     = 'Equipment Associations'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.12 $ '

------------------------------------------------------------------------------------------------------
-- Equipment Association front page

  frame .frTasks   panel  anchor all       at x0 y0

    paragraph .ceName          anchor left + top            at x1 ymax-0.2    width 28
    button    .butSelect    'Select Association Item...'    linklabel anchor left + top  callback '!this.pick(1)'  at xmin ymax-0.2
    line      .nameLine        anchor left + right + top    at x0 ymax  horiz width 34 heigh 0.3
    paragraph .parNewAssoc     anchor left + top            at x1 ymax-0.2    width 28
    frame  .frConstraint panel anchor left + top + right    at x0 ymax-0.2    width 31
      path down
      rtoggle .togMate       'Mate'             anchor left + top
      rtoggle .togAlign      'Align'            anchor left + top at xmin ymax-0.1
      rtoggle .togParallel   'Parallel'         anchor left + top at xmin ymax-0.1
      rtoggle .togCoaxial    'Parallel Offset'  anchor left + top at xmin ymax-0.1 tagwidth 12
      rtoggle .togCoincident 'True Distance'    anchor left + top at xmin ymax-0.1 tagwidth 12
      rtoggle .togElevation  'Elevation'        anchor left + top at xmin ymax-0.1
      rtoggle .togHorizDist  'Horizontal Dist'  anchor left + top at xmin ymax-0.1
      rtoggle .togAboveLine  'Point above line' anchor left + top at xmin ymax-0.1
      frame .frPic panel  anchor top + left + right   at xmax.togCoaxial ymin.togMate height 5 width 17
        paragraph .alignPic                           at xmin ymin pixmap
      exit
    exit

    line    .selPartnerLine      anchor left + right + top          at x0 ymax  horiz width 33 heigh 0.3
    button  .butPartner    'Select new Association partner...'  linklabel anchor left + top  callback '!this.pick(2)' at x1 ymax width 28

    line   .partnerListLine  anchor left + right + top          at x0 ymax  horiz width 33 heigh 0.3
    frame  .frontPageTasks   panel   anchor all  at x0 ymax-0.2
      paragraph .parAssoc    anchor left + top                  at x1 ymax-0.2    width 25
      list   .partnerList    anchor all   callback '!this.selectAssociation(' single zeroSelection  width 30 lines 12
      button .butModify   'Modify Association...' linklabel anchor left + bottom  callback '!this.modifyAssociation()'
      button .butChangePartner  'Change Association partner...' linklabel anchor left + bottom  callback '!this.pick(3)'
      button .butDelete   'Delete Association'    linklabel anchor left + bottom at xmin ymax+1 callback '!this.deleteAssociation()'
    exit

  exit

------------------------------------------------------------------------------------------------------
-- Association detail definition page

  frame .frDefinePage panel anchor all  at x0      y0
    -------------------- Association definition panes

    paragraph .assDefTag anchor left + right + top  at xmin ymin+0.2  width 28

    line .myLine         anchor left + right + top  at x0  ymax     horiz width 33 heigh 0.3

    -- My reference plane
    paragraph .myRefTag          anchor left + right + top   at xmin ymax  text  'My data'     width 30
    option .optMyRefPlane       'Use reference Plane'               anchor left + top callback '!this.myReferencePlane()'       tagwidth 18 width 7
    button .butMyPickPlane      'Pick reference Plane...' linklabel anchor left + top callback '!this.myPickReferencePlane()'

    line .partnerLine   anchor left + right + top   at x0  ymax     horiz width 33 heigh 0.3

    -- Partner reference plane
    paragraph .partnerRefTag     anchor left + right + top    at xmin ymax text  'Partner data' width 30
    option .optPartnerRefPlane  'Use reference Plane'               anchor left + top  callback '!this.partnerReferencePlane()' tagwidth 18 width 7
    button .butPartnerPickPlane 'Pick reference Plane...' linklabel anchor left + top  callback '!this.partnerPickReferencePlane()'

    line .cpLine        anchor left + right + top   at x0  ymax     horiz  width 33 heigh 0.3

    -- Parameters
    frame .frParameters panel               anchor left + right + top at x0  ymax.cpLine-0.2 width 32
      toggle .measure 'Measure Association'  anchor left + top  at xmin   ymax  callback '!this.measure()' states 'false' 'true'
        -- association element name
      text   .assocName 'Association Name'         anchor left + right + top at xmin   ymax      tagwidth 12 width 19 is STRING
      option .optSeparationOperation  'Separation' anchor left + top         at xmin   ymax+0.2  tagwidth 12 width 4
      text   .param1                               anchor left + right + top at xmax+1 ymin      callback '!this.setAttribute(' width 11 is REAL format !!distanceFmt
    exit

    button .butCreate  'Create Association' anchor right + top at xmax.assocName-size ymax  callback '!this.createAssociation()'  width 18
    button .butChange  ' Apply Changes '    anchor right + top at xmin             ymin  callback '!this.changeAssociation()'  width 18

    line .resultLine    anchor left + right + top   at x0  ymax+0.2 horiz width 33 heigh 0.3

    -- Results panel
    paragraph .result        anchor left + top  at xmin ymin+0.2  text   'Associations between these objects'
    list   .assocDefnList    anchor all         at xmin ymax      single zeroSelection  width 30 lines 10

    frame .finalFrame panel    anchor left + right + bottom   at x0 ymax width 32
      line .acLine             anchor left + right + bottom   at x0 ymax   horiz  width 33 heigh 0.3

    -- Action Buttons - overlaid: Next is end of create, refresh refreshes the list, dismiss is end of edit
      button .next       ' Back '    anchor left + bottom  at x1          ymax+0.2  callback '!this.next()'                width 8
      button .refresh ' Refresh ' anchor right + bottom at xmax.assocName-size  ymin  callback '!this.refreshAssociations()' width 8
  --  button .dismiss 'Dismiss'  anchor right + bottom  at xmin.next         ymin.next  callback '!this.close()'  width 8

    exit

  exit

  -- Form Members

  -- Association data
  member .element               is DBREF
  member .partnerElement        is DBREF
  member .association           is DBREF

  -- Selected My Mating Face
  member .myAssMember           is EQUASSMEMBER

  -- Selected Partner Mating Face
  member .partnerAssMember      is EQUASSMEMBER

  -- Selected Partner Mating Face
  member .pickedAssMember       is EQUASSMEMBER

  -- Association builder object
  member .assocBuilder          is EQUASSBUILDER

  -- List of valid primitive types
  member .partners              is ARRAY
  member .restrictions          is ARRAY
  -- look-up array containing names of association and separation types
  -- must correspond to EQUASSBUILDER types as association type + separation type
  member .associationTypes      is ARRAY
  member .separationTypes       is ARRAY
  -- look-up array containing names of png files corresponding to association types
  member .associationIcons      is ARRAY
  -- look-up array indicating if input parameters are required corresponding to association types
  member .needsDistance         is ARRAY

  -- Aid number being modified
  member .aidDimension          is REAL

  -- Aid numbers for position & axes
  member .myAidNumber           is REAL
  member .partnerAidNumber      is REAL

  -- EDG Description
  member .packet                is EDGPACKET
  member .edgDescription        is STRING

  -- Undo event handlers
  member .undoCreate            is UNDOABLE
  member .undoChange            is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      equAssociate
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .equAssociate()

  -- Register form to show in any application, but not on start up
  !!appFormCntrl.registerForm(!this,ARRAY(),ARRAY(),false,false)

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'
--  !this.killingCall       = '!this.kill()'
  !this.element           = object DBREF()

--  -- Define EDG positional pick
  !this.edgDescription        = 'Pick Partner'

  -- Initialise create button undo
  !this.undoCreate.description('Create Equipment Association')
  !this.undoCreate.undoAction('!!equAssociate.createUndo()')
  !this.undoCreate.redoAction('!!equAssociate.createUndo()')
  !this.butCreate.setUndoable(!this.undoCreate)

--  -- Initialise change undo
  !this.undoChange.description('Change Equipment Association')
  !this.undoChange.undoAction('!!equAssociate.changeUndo()')
  !this.undoChange.redoAction('!!equAssociate.changeUndo()')
  !this.butChange.setUndoable(!this.undoChange)

  -- initialise feedback
  !this.parAssoc.val           = 'Participates in associations'
  !this.parNewAssoc.val        = 'Make a new association'

  -- Constraint type radio group
  !this.frConstraint.callback  = |!this.constraintTypeCallback()|
  !this.frConstraint.val       = 1
  !this.alignPic.val           = !!pml.getPathname('mateconst116.png')
--  !this.frSeparation.val       = 1

--  !this.assocName.callback     = '!this.nameAssoc('
  !this.assocName.validateCall = '!this.validateName('

  -- Set separation options
  !dText[1] = 'Max'
  !dText[2] = 'Min'
  !dText[3] = 'Equal'
  !rText[1] = 'LE'
  !rText[2] = 'GE'
  !rText[3] = 'EQ'
  !this.optSeparationOperation.dText = !dText
  !this.optSeparationOperation.rText = !rText
  !this.optSeparationOperation.val   = 1

  -- deactivate modify and delete
  !this.butModify.active  = false
  !this.butChangePartner.active  = false
  !this.butDelete.active  = false
  !this.butCreate.visible = true
  !this.butChange.visible = false

  -- Popup Menu
  !menu = !this.newMenu('partnerListPopup')
  !menu.add('callback', 'Navigate To', '!this.navigatePartner()','navigate')
  !menu.add('callback', 'Association Details...', '!this.reportAssoc(!this.partnerList)','details')
  !menu.add('callback', 'Modify...',   '!this.modifyAssociation()','modify')
  !menu.add('separator')
  !menu.add('callback', 'Delete',      '!this.deleteAssociation()','delete')
  !this.partnerList.popup = !menu

  -- Popup Menu
  !menu = !this.newMenu('assListPopup')
  !menu.add('callback', 'Navigate To',  '!this.navigateAssoc()','navigate')
  !menu.add('callback', 'Test this Association', '!this.testAssoc()','test')
  !menu.add('callback', 'Association Details...', '!this.reportAssoc(!this.assocDefnList)','details')
  !this.assocDefnList.popup = !menu

  -- Association descriptions - must correspond to association type radio group index
  !this.associationTypes[1] = 'STDMATE'
  !this.associationTypes[2] = 'STDALIGN'
  !this.associationTypes[3] = 'STDPARALLEL'
  !this.associationTypes[4] = 'STDPARALLELOFFSET'
  !this.associationTypes[5] = 'STDDISTANCE'
  !this.associationTypes[6] = 'STDELEVATION'
  !this.associationTypes[7] = 'STDHORIZDIST'
  !this.associationTypes[8] = 'STDABOVELINE'
  -- Separation types - must correspond to separation type radio group index
  !this.separationTypes[1]  = 'LE'
  !this.separationTypes[2]  = 'GE'
  !this.separationTypes[3]  = 'EQ'
  -- Table column indicating need for separation distance input
  !this.needsDistance[1]    = true
  !this.needsDistance[2]    = false
  !this.needsDistance[3]    = false
  !this.needsDistance[4]    = true
  !this.needsDistance[5]    = true
  !this.needsDistance[6]    = true
  !this.needsDistance[7]    = true
  !this.needsDistance[8]    = true
  -- Table of Icons for each type
  !this.associationIcons[1] = 'mateconst116.png'
  !this.associationIcons[2] = 'alignconst116.png'
  !this.associationIcons[3] = 'parallel116.png'
  !this.associationIcons[4] = 'paralleloffset116.png'
  !this.associationIcons[5] = 'truedist116.png'
  !this.associationIcons[6] = 'elevation116.png'
  !this.associationIcons[7] = 'horizdist116.png'
  !this.associationIcons[8] = 'aboveline116.png'

  -- Allocate aid number
  !this.aidDimension = !!aidNumbers.add('AssMeasure')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise create mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.clearAllPanes()
  !this.tidy()
  !this.setup(!!ce)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clearAllPanes
--
-- Description: Make front page visible
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAllPanes()

  !this.frDefinePage.visible         = false
  !this.frTasks.visible              = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be associated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!passedElement is DBREF)

  -- Initialise Variables
  if( badref(!passedElement) ) then
    !!alert.error('Cannot create an association with the current element')
  endif

  -- check that standard association definitions are installed
  -- make a temporary definition object to check
  !temp = object EQUASSDEFINITION()
  if( !temp.installed().not() ) then
    !!alert.error('Standard Association Definitions are not available in this project. These must be installed in order to use this utility')
    !this.hide()
  endif

  -- Create association member object for this element
  !this.myAssMember = object EQUASSMEMBER()
  !this.myAidNumber = !this.myAssMember.setAidNumber('myFacePlane')
  !assMbrRef        = !this.myAssMember.initialise(!passedElement)

  -- check for invalid element
  if( !assMbrRef.unset() ) then
    -- put form into a mode where the user is required to select member 1
    !this.initSelectAssociationElement()
    return
  endif

  -- save the picked member for a change partner operation
  !this.pickedAssMember = !this.myAssMember

  -- set up front page gadgets
  !this.ceName.visible         = true
  !this.butSelect.visible      = true
  !this.frConstraint.active    = true
  !this.frontPageTasks.visible = true
  !this.butPartner.active      = true

  -- deactivate modify and delete
  !this.butModify.active       = false
  !this.butChangePartner.active  = false
  !this.butDelete.active       = false

  -- Get significant element from object
  !this.element = !this.myAssMember.element

  -- clear partner if set
  !this.partnerAssMember = object EQUASSMEMBER()
  !this.partnerAidNumber = !this.partnerAssMember.setAidNumber('partnerFacePlane')
  -- Get significant element from object
  !this.partnerElement   = object DBREF()

  -- Display element being modified
  !this.ceName.val       = !this.element.flnn

  -- show graphical box and mating plane feedback
  !this.myAssMember.showBox()
  !this.myAssMember.showFaces()

  -- show a list of all associations for this element
  !this.showAssociations(false, true, true, !this.partnerList)

  if(!this.partnerList.dText.size() eq 0)then
  	!this.partnerListPopup.setFieldProperty('navigate','active' , false)
  	!this.partnerListPopup.setFieldProperty('details','active' , false)
  	!this.partnerListPopup.setFieldProperty('modify','active', false)
  	!this.partnerListPopup.setFieldProperty('delete','active',false)
  else
    !this.partnerListPopup.setFieldProperty('navigate','active' , true)
  	!this.partnerListPopup.setFieldProperty('details','active' , true)
  	!this.partnerListPopup.setFieldProperty('modify','active', true)
  	!this.partnerListPopup.setFieldProperty('delete','active',true)
  endif

  if(!this.assocDefnList.dText.size() eq 0)then
  	!this.assListPopup.setFieldProperty('navigate','active' , false)
  	!this.assListPopup.setFieldProperty('details','active' , false)
  	!this.assListPopup.setFieldProperty('test','active', false)
  else
    !this.assListPopup.setFieldProperty('navigate','active' , true)
  	!this.assListPopup.setFieldProperty('details','active' , true)
  	!this.assListPopup.setFieldProperty('test','active', true)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initSelectAssociationElement
--
-- Description: Set form up to ask for primary association element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSelectAssociationElement()

  !this.clearAllPanes()
  !this.ceName.visible         = false
  !this.butSelect.visible      = true
  !this.frConstraint.active    = false
  !this.frontPageTasks.visible = false
  !this.butPartner.active      = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: Set REAL attribute data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectAssociation(!gadget is GADGET, !action is STRING)


  -- return if not a SELECT action
  if ( !action.upcase() ne 'SELECT' ) then
    return
  endif

  !this.butModify.active = false
  !this.butChangePartner.active  = false
  !this.butDelete.active = false

  -- get the assoc element
  !assoc = !gadget.selection().dbref()
  handle any
    -- something wrong with selection - don't allow modification
    -- deactivate modify and delete
    return
  endhandle

  -- activate modify and delete
  !canBeModified = !!dbrefUpdate(!assoc)
  !this.butModify.active = !canBeModified
  !this.butChangePartner.active  = !canBeModified
  !this.butDelete.active = !canBeModified

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: Set REAL attribute data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttribute(!gadget is GADGET, !action is STRING)

  -- return if not a MODIFY action
  if ( !action.upcase() ne 'SELECT' ) then
    return
  endif

  -- Set the attribute
  !parameter = !gadget.val

  if( !parameter.unset() ) then
    -- use default value
    !parameterArray = !this.assocBuilder.getParameterDefn()
    -- do nothing if no parameter expected (this should not occur
    if( !parameterArray.empty().not() ) then
      !default = !parameterArray[1].default
      !gadget.val = !default
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showAssociations
--
-- Description: Show a table of associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if associations should be tested and pass/fail shown
--    2   R      BOOLEAN     True if partner name column shown
--    3   R      GADGET      List gadget that will receive the resulting table
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAssociations(!showTestResults is BOOLEAN, !showPartner is BOOLEAN, !showDesc is BOOLEAN, !table is GADGET)

  !this.showAssociations(!showTestResults, !showPartner, !showDesc, !table, object DBREF())

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showAssociations
--
-- Description: Show a table of associations between this element and a given partner element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if associations should be tested and pass/fail shown
--    2   R      BOOLEAN     True if partner name column shown
--    3   R      GADGET      List gadget that will receive the resulting table
--    4   R      DBREF       DBREF of partner element (All partners if unset object)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAssociations(!showTestResults is BOOLEAN, !showPartner is BOOLEAN, !showDesc is BOOLEAN, !table is GADGET, !filter is DBREF)

  !associations = ARRAY()

  -- get association list if element has not been deleted - empty list otherwise
  if( not badref(!this.element) ) then
    !element      = !this.element
    -- get direct associations
    !associations = !element.dassos
    -- Also look for associations where this element is referenced by the ASSTAR
    do !associationMember values !element.astmbs
      -- add the association that owns this member
      !associations.append(!associationMember.owner)
    enddo
    !associations.unique()
  endif

  !rows  = ARRAY()
  !rText = ARRAY()
  -- loop through associations to tabulate associations with this element
  do !assoc values !associations
    !row   = ARRAY()
    -- check purpose to see if this is a standard equipment association
    -- which can be handled by this form
    !purpose = !assoc.adefrf.purpose
    handle any
      -- can't be a standard association if this doesn't work
      skip
    endhandle
    skip if( !purpose.trim().upcase() neq 'ASEQ' )
    -- get description or name of association
    !name = !assoc.namn
    !row[1] = !name
    -- get partner in the association
    !partner = !this.getPartner(!assoc)
    -- if filter is set skip if partner is not this object
    if( !filter.set() ) then
      skip if( !filter neq !partner )
    endif
    if( !showPartner ) then
      -- get partner name
      if( !partner.unset() ) then
        !row[2] = '------'
      else
        if( badref(!partner) ) then
          !row[2] = 'Invalid'
        else
        !row[2] = !partner.namn
      endif
    endif
    endif
    -- add a test result column if required
    if(!showTestResults) then
      !result = !assoc.testev
      handle any
        !result = false
      endhandle
      if(!result.unset()) then
        !result = false
      endif
      if(!result) then
        !row.append('Passed')
      else
        !row.append('Failed')
      endif
    endif
    if(!showDesc) then
      !row.append(!assoc.description)
    endif
    -- add new row to the table
    !rows.append(!row)
    !rText.append(!assoc.string())
  enddo

  -- populate the list table gadget
  !headings[1]   = 'Association'
  if( !showPartner ) then
    !headings[2]   = 'Partner'
  endif
  if(!showTestResults) then
    !headings.append('Test')
  endif
  if(!showDesc) then
    !headings.append('Type')
  endif
  !table.setHeadings(!headings)
  !table.setRows(!rows)
  !table.rText = !rText

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      testAssociation
--
-- Description: test the given association and show result
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of Association
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testAssociation(!assoc is DBREF)

  !rows = ARRAY()
   -- get description or name of association
  !desc = !assoc.namn
  -- if this is a dbref, use the description
  if( !desc.subString(1,1) eq '=' ) then
    !desc   = !assoc.description
  endif
  !rText[1] = !assoc.string()
  !row[1]   = !desc
  -- add a test result column
  !result   = !assoc.testev
  handle any
    !result = false
  endhandle
  if(!result.unset()) then
    !result = false
  endif
  if(!result) then
    !row.append('Passed')
  else
    !row.append('Failed')
  endif
  -- add new row to the table
  !rows.append(!row)

  -- populate the list table gadget
  !headings[1]   = 'Association'
  !headings[2]   = 'Test Result'
  !this.assocDefnList.setHeadings(!headings)
  !this.assocDefnList.setRows(!rows)
  !this.assocDefnList.rText =!rText

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getPartner
--
-- Description: Get SINGLE partner for this element in the given association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association instance (ASSOC) element
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of partner in the association or unset DBREF if none
--
------------------------------------------------------------------------

define method .getPartner(!association is DBREF) is DBREF

  !element = !this.element
  VAR !assmbr coll all assmbr with ( amemrf ne $!<this.element> ) for $!<association>
  !partner = !assmbr[1].dbref().amemrf
  handle any
    !partner = object DBREF()
  endhandle
  return !partner

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      newAssociation
--
-- Description: Create a new association with the given partner
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Partner element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newAssociation(!partner is DBREF)

  -- Create association member object for this element
  !partnerMember = !this.partnerAssMember.initialise(!partner)
  -- get user to try again if this is not a valid element
  if( !partnerMember.unset() ) then
    !!alert.error('Cannot create an Association with selected element ' + !partner.fullname)
    return
  endif

  -- Get significant element from object
  !this.partnerElement       = !this.partnerAssMember.element

  -- create object that manages construction of the equipment association
  !this.assocBuilder = object EQUASSBUILDER()

  !constraintType    = !this.frConstraint.val
  !assType           = !this.associationTypes[!constraintType]
  !success           = !this.assocBuilder.stdAssociationDefinition(!assType)
  if(!success.not()) then
    !!alert.error('Association ' + !assType + ' not found')
  endif

  -- setup association detail definition page
  !this.setupDefinitionPage('NEW')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateName
--
-- Description: Validate name field
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateName(!gadget is GADGET, !action is STRING)

  -- return if not a VALIDATE action
  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  -- nothing to do if empty
  if( !gadget.val.trim().empty() ) then
    return
  endif

  !name = !this.checkName( !gadget.val.trim() )
  if ( !name.unset() ) then
    return error 1 noalert
  else
    !gadget.val = !name
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Validate name field
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!assocName is STRING) is STRING

  if( badref( !this.association ) ) then

    -- check for new name
    !name  = !!checkName(!assocName, 'NEW')

  else

    -- check old name
    !newName = !assocName.trim()
    !oldName = !this.association.name
    if( !newName eq !oldName ) then
      !name = !oldName
    else
      if( ( '/' + !newName ) eq !oldName ) then
        !name = !oldName
      else
        -- name has changed - test it as a new name
        !name  = !!checkName(!newName, 'NEW')
      endif
    endif

  endif

  return !name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      myReferencePlane
--
-- Description: Callback for standard reference plane selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .myReferencePlane()

  -- Get reference plane option gadget selection
  !refPlaneIndex = !this.optMyRefPlane.selection().real()
  if( !refPlaneIndex lt 1 ) then
    return
  endif

  -- Set selected reference plane
  !this.myAssMember.setReferencePlane(!refPlaneIndex)
  -- Show only feedback for the selected plane
  !this.myAssMember.showFace()

endmethod
-- End of method definition

-----------------------------------------------------------------
--
-- Method:      partnerReferencePlane
--
-- Description: Callback for standard partner reference plane selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .partnerReferencePlane()

  !refPlaneIndex = !this.optPartnerRefPlane.selection().real()
  if( !refPlaneIndex lt 1 ) then
    return
  endif

  -- Set selected reference plane
  !this.partnerAssMember.setReferencePlane(!refPlaneIndex)
  -- Show only feedback for the selected plane
  !this.partnerAssMember.showFace()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteAssociation
--
-- Description: Delete association callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteAssociation()

  -- get the assoc element
  !assoc = !this.partnerList.selection().dbref()

  if(!assoc.unset())then
  	!!alert.error('Select partner element from the list to delete')
  	return
  endif

  handle any
    -- something wrong with selection - don't allow modification
    !!alert.error('Cannot delete the selected Association: ' + !!error.text )
    return
  endhandle

  !saveRef = !!ce
  !!ce     = !assoc
  !!deleteCe()
  !!ce     = !saveRef
  handle any
    -- handle error where !saveRef is the deleted element
  endhandle

  -- update table of associations
  !this.showAssociations(false, true, true, !this.partnerList)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyAssociation
--
-- Description: Modify Association callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyAssociation()

  -- get the assoc element
  !assoc = !this.partnerList.selection().dbref()
  if(!assoc.unset())then
  	!!alert.error('Select partner element from the list to modify')
  	return
  endif
  handle any
    -- something wrong with selection - don't allow modification
    !!alert.error('Cannot modify the selected Association: ' + !!error.text )
    !this.tidy()
    return
  endhandle

  if( badref(!this.element) ) then
    -- current primary element has been deleted
    !!alert.error('The primary Association member has been deleted. This form will be refreshed')
    !this.initSelectAssociationElement()
    !this.tidy()
    return
  endif


  -- set up the modification page
  if( !this.modifyAssociation(!assoc).not() ) then
    -- failed to load this association - offer to delete it
    !answer = !!alert.confirm('A member of this Association is invalid. Do you want to delete this Association?')
    if( !answer eq 'YES' ) then
      !saveCE = !!ce
      !!ce = !assoc
      !file = object FILE('%PDMSUI%/CLIB/FILES/MDELCE')
      !!runMacro(!file.fullname() , 'CE FALSE FALSE FALSE FALSE')
      !!ce = !saveCE
      handle any
      endhandle
    endif

    -- update table of associations
    !this.showAssociations(false, true, true, !this.partnerList)

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyAssociation
--
-- Description: Modify Association callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     false if problem found with data. true if OK
--
------------------------------------------------------------------------

define method .modifyAssociation(!assoc is DBREF) is BOOLEAN

  -- tidy up any existing graphics
  !this.tidy()

  -- create object that manages construction of the equipment association
  !this.assocBuilder = object EQUASSBUILDER(!assoc)
  !this.association  = !assoc

  -- get association members
  -- tidy aid graphics on existing object before replacing it
  !this.myAssMember.tidy()
  -- Create association member object for this element
  !this.myAssMember      = object EQUASSMEMBER()
  !this.myAidNumber      = !this.myAssMember.setAidNumber('myFacePlane')
  !this.element          = !this.myAssMember.initialise(!this.assocBuilder.assMembers[1])
  !this.partnerAssMember =  object EQUASSMEMBER()
  !this.partnerAidNumber = !this.partnerAssMember.setAidNumber('partnerFacePlane')
  !this.partnerElement   = !this.partnerAssMember.initialise(!this.assocBuilder.assMembers[2])
  if( badref(!this.element) or badref(!this.partnerElement) ) then
    -- Association has invalid members - it should be deleted
    return false
  endif

  -- set up the association definition page
  !this.setupDefinitionPage('MODIFY')

  -- set name field if name set
  !assocName = !this.assocBuilder.assocName
  if( !assocName.empty().not() ) then
    if( !assocName.subString(1,1) eq '=' ) then
      !assocName = ''
    endif
  endif
  !this.assocName.val = !assocName

  -- show result of selected association
  !this.testAssociation(!assoc)

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeAssociationPartner
--
-- Description: Change Association partner
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     false if problem found with data. true if OK
--
------------------------------------------------------------------------

define method .changeAssociationPartner(!assoc is DBREF, !partner is DBREF) is BOOLEAN

  -- tidy up any existing graphics
  !this.tidy()

  -- create object that manages construction of the equipment association
  !this.assocBuilder = object EQUASSBUILDER(!assoc)
  !this.association  = !assoc

  -- get association members
  -- tidy aid graphics on existing object before replacing it
  !this.myAssMember.tidy()
  -- this is the primary selected element (that might not be the primary element in the selected association)
  !pickedElement         = !this.pickedAssMember.element
  -- Find the new partner
  !tempAssMember         = object EQUASSMEMBER()
  !unusedTempAidNumber   = !tempAssMember.setAidNumber('tempFacePlane')
  !unusedNewPartner      = !tempAssMember.initialise(!partner)
  -- initialise members
  !this.myAssMember      = object EQUASSMEMBER()
  !this.myAidNumber      = !this.myAssMember.setAidNumber('myFacePlane')
  !this.partnerAssMember = object EQUASSMEMBER()
  !this.partnerAidNumber = !this.partnerAssMember.setAidNumber('partnerFacePlane')

  -- find out which member of the original association is being modified
  !member1               = !this.assocBuilder.assMembers[1].getReference()
  handle any
    !member1             = object DBREF()
  endhandle
  !member2               = !this.assocBuilder.assMembers[2].getReference()
  handle any
    !member2             = object DBREF()
  endhandle

  -- set up members in the correct order for this association
  if( !pickedElement eq !member1 ) then
    !this.element        = !this.myAssMember.initialise(!member1)
  !this.partnerElement   = !this.partnerAssMember.initialise(!partner)
  elseif( !pickedElement eq !member2 ) then
    !this.element        = !this.myAssMember.initialise(!partner)
    !this.partnerElement = !this.partnerAssMember.initialise(!member2)
  else
    -- this case should not occur unless user has changed something while the form is shown
    !!alert.error( 'Picked element is not a member of this Association' )
    return false
  endif

  if( badref(!this.element) or badref(!this.partnerElement) ) then
    -- Association has invalid members - it should be deleted
    return false
  endif

  -- set up the association definition page
  !this.setupDefinitionPage('MODIFY')

  -- set name field if name set
  !assocName = !this.assocBuilder.assocName
  if( !assocName.empty().not() ) then
    if( !assocName.subString(1,1) eq '=' ) then
      !assocName = ''
    endif
  endif
  !this.assocName.val = !assocName

  -- show result of selected association
  !this.testAssociation(!assoc)

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      kill
--
-- Description: Kill form handler
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

--define method .kill()
--
--  -- Initialise Variables
--  !this.tidy()
--
--  -- Remove applications events from system
--  !!edgCntrl.remove(!this.edgDescription)
--
--endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form handler
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.tidy()

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createUndo
--
-- Description: Undo last association action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createUndo()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif

  -- go back to front page
  !this.next()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeUndo
--
-- Description: Undo last association action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeUndo()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif

  -- reset the modify page if shown
  if( !this.frDefinePage.visible ) then
    !assoc = !this.association
    !this.modifyAssociation(!assoc)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      next
--
-- Description: Tidy up after completed operation and initialise for next
--              operation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .next()

  -- return to definition page
  !this.frDefinePage.visible = false
  !this.frTasks.visible      = true

  -- clear up feedback for fresh start
  !this.tidy()

  -- reinitialise for current element
  if( not badref(!this.element) ) then
    !element = !this.element
    !this.setup(!element)
  else
    !this.initialise()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      refreshAssociations

--
-- Description: refresh the list of associations
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshAssociations()

  do !d to !this.assocDefnList.count
     !strRef = !this.assocDefnList.rText[!d]
     !ref = !strRef.dbref()
     handle (2,107)
       -- reference no longer exists
       !!alert.error('One or more associations are no longer valid')
       !this.next()
    endhandle
  enddo
endmethod
-- End of method definition------------------------------------------------------------------------


--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !this.myAssMember.tidy()
  !this.partnerAssMember.tidy()
  !!aidNumbers.hide(!this.aidDimension)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      dbChanged
--
-- Description: Event handler for database change. Allows for current
-- primitive to be tested
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbChanged()

  -- check that form is shown
  if( !this.shown().not() ) then
    return
  endif

 -- Check for current edit element
  if(!this.element.unset()) then
    return
  endif

  -- If the edit primitive deleted, then reinitialise the form
  if(!this.element.badref()) then
    !!alert.warning('Association element has been deleted')
    !this.hide()
    return
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      myPickReferencePlane
--
-- Description: Callback to pick a reference plane on me
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .myPickReferencePlane()

  -- ask my association member object to pick a reference plane
  !this.myAssMember.pickReferencePlane('!!equAssociate.myAssMember')

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      partnerPickReferencePlane
--
-- Description: Callback to pick a reference plane on partner
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .partnerPickReferencePlane()

  -- ask my association member object to pick a reference plane
  !this.partnerAssMember.pickReferencePlane('!!equAssociate.partnerAssMember')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .pick()
--
-- Description: set up pick for association member element
--              arg = 1 for first member, 2 for partner, 3 for change partner
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick(!memberNumber is REAL)

  -- Define the EDG packet
  !packet = object EDGPACKET()
  !packet.anyPick('Pick an Element to associate with')
  !packet.key         = 'equAssPick'
  !packet.description = !this.edgDescription
  !packet.priority    = 2
  if( !memberNumber eq 1 ) then
    !packet.action    = '!!equAssociate.member(!this.return[1])'
    !this.myAssMember.tidy()
    !this.ceName.visible         = false
    !this.frConstraint.active    = false
    !this.frontPageTasks.visible = false
  elseif( !memberNumber eq 2 ) then
    -- check that first member has not been delete while form shown
    if( badref(!this.element) ) then
      !!alert.warning('The primary Association member has been deleted. This form will be refreshed')
      !this.initSelectAssociationElement()
      !this.tidy()
      return
    endif
    !packet.action    = '!!equAssociate.partner(!this.return[1])'
--    !packet.pickPacket.picks[1].pick.input[3]   = 'ref of PRMOWN neq ' & !this.element.refe
    !packet.pickPacket.picks[1].pick.modifiable = false
  else
    -- check that first member has not been delete while form shown
    if( badref(!this.element) ) then
      !!alert.warning('The primary Association member has been deleted. This form will be refreshed')
      !this.initSelectAssociationElement()
      !this.tidy()
      return
    endif
    !packet.action    = '!!equAssociate.changePartner(!this.return[1])'
--    !packet.pickPacket.picks[1].pick.input[3]   = 'ref of PRMOWN neq ' & !this.element.refe
    !packet.pickPacket.picks[1].pick.modifiable = false
  endif
  !packet.remove      = true

  !!edgCntrl.add(!packet)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .member
--
-- Description: pick primary member element callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .member(!arg is EDGPICKDATA)

  !item = !arg.item
  !this.setup(!item)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .partner
--
-- Description: pick partner element callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .partner(!arg is EDGPICKDATA)

  !item = !arg.item
  !this.newAssociation(!item)
  handle any
--    q var !!error
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .changePartner
--
-- Description: pick replacement partner element callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changePartner(!arg is EDGPICKDATA)

  !item = !arg.item

  -- get the assoc element
  !assoc = !this.partnerList.selection().dbref()
  handle any
    -- something wrong with selection - don't allow modification
    !!alert.error('Cannot modify the selected Association: ' + !!error.text )
    !this.tidy()
    return
  endhandle

  if( badref(!this.element) ) then
    -- current primary element has been deleted
    !!alert.error('The primary Association member has been deleted. This form will be refreshed')
    !this.initSelectAssociationElement()
    !this.tidy()
    return
  endif

  -- set up the modification page
  if( !this.changeAssociationPartner(!assoc, !item).not() ) then
    -- failed to load this association - offer to delete it
    !answer = !!alert.confirm('A member of this Association is invalid. Do you want to delete this Association?')
    if( !answer eq 'YES' ) then
      !saveCE = !!ce
      !!ce = !assoc
      !file = object FILE('%PDMSUI%/CLIB/FILES/MDELCE')
      !!runMacro(!file.fullname() , 'CE FALSE FALSE FALSE FALSE')
      !!ce = !saveCE
      handle any
      endhandle
    endif

    -- update table of associations
    !this.showAssociations(false, true, true, !this.partnerList)

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .constraintTypeCallback
--
-- Description: Callback for change in constraint selection
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .constraintTypeCallback()

  -- concatenate the textpane contents
  !constraintType           = !this.frConstraint.val
  !this.alignPic.val        = !!pml.getPathname(!this.associationIcons[!constraintType])
--  !this.frSeparation.active = !this.needsDistance[!constraintType]

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .setupDefinitionPage
--
-- Description: Setup detail definition page - after association builder object
--              and member object are instantiated
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setupDefinitionPage(!action is STRING)

  -- manage visibility of form frames
  !this.frDefinePage.visible = true
  !this.frTasks.visible      = false
  !this.butCreate.visible    = !action.trim().upcase().eq('NEW')
  !this.butChange.visible    = !this.butCreate.visible.not()
  -- show summary of associations between this element and the selected partner
  !this.showAssociations(true, false, true, !this.assocDefnList, !this.partnerElement)

  -- populate face option gadgets with current options
  !this.myAssMember.setFaceOption( !this.optMyRefPlane )
  !this.partnerAssMember.setFaceOption( !this.optPartnerRefPlane )

  if(!action.trim().upcase().eq('NEW')) then
    -- pre select ZDIR faces
    !this.optMyRefPlane.select('dText','ZDIR')
    handle ANY
      -- No ZDIR - try the first real option
      if( !this.optMyRefPlane.dText.size() gt 1 ) then
        !this.optMyRefPlane.val = 2
        !this.myReferencePlane()
      endif
    elsehandle none
      !this.myReferencePlane()
    endhandle
    !this.optPartnerRefPlane.select('dText','ZDIR')
    handle ANY
      -- No ZDIR - try the first real option
      if( !this.optPartnerRefPlane.dText.size() gt 1 ) then
        !this.optPartnerRefPlane.val = 2
        !this.partnerReferencePlane()
      endif
    elsehandle none
      !this.partnerReferencePlane()
    endhandle
    -- clear any old name
    !this.assocName.clear()
  endif
  -- show graphical mating plane feedback
  !this.myAssMember.showFace()
  !this.partnerAssMember.showFace()

  -- update paragraph headings
  !myName              = !this.element.name
  if( !myName.subString(1,1) eq '/' ) then
    !this.myRefTag.val = 'My data ' + !myName
  else
    !this.myRefTag.val = 'My data'
  endif

  !partnerName              = !this.partnerElement.name
  if( !partnerName.subString(1,1) eq '/' ) then
    !this.partnerRefTag.val = 'Partner data ' + !partnerName
  else
    !this.partnerRefTag.val = 'Partner data'
  endif

  -- set description of association
  !this.assDefTag.val       = !this.assocBuilder.assDefinition.assTypeDesc

  -- Set parameter fields
  !this.setParameterField()

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      setParameterField
--
-- Description: Set up parameter input fields
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setParameterField()

  -- initialise fields
  !this.param1.active                 = false
  !this.optSeparationOperation.active = false

  -- get array of EQUASSPARAMETER objects - 1 for each parameter
  !parameterArray = !this.assocBuilder.getParameterDefn()

  -- skip if null parameter
  if( !parameterArray.empty() ) then
    return
  endif
  if( !parameterArray[1].name.trim().empty() ) then
    return
  endif

  -- get actual parameters from association
  !parameters = !this.assocBuilder.getParameters()

  -- first element is the operation
  if( defined(!parameters[1]) ) then
    !this.optSeparationOperation.active = true
    if( !parameters[1].set() ) then
      !this.optSeparationOperation.select('rText', !parameters[1])
    endif
  endif
  if( defined(!parameters[2]) ) then
    !this.param1.active = true
    if(!parameters[2].empty().not() ) then
      !this.param1.val    = !parameters[2][1]
    else
      -- use default value if no actual value
      !this.param1.val    = !parameterArray[1].default
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .createAssociation
--
-- Description: Create Association callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createAssociation()

  -- check the name before create
  !tempName = !this.assocName.val
  if( !tempName.unset() ) then
    !tempName = ''
  endif
  if( !tempName.trim().empty() ) then
    -- unset name
    !this.assocBuilder.setName('')
  else
    !name = !this.checkName(!tempName)
    if( !name.unset() ) then
      return
    endif
    !this.assocBuilder.setName(!name)
  endif

  -- check that mating faces have been defined
  if( !this.myAssMember.matingFaceSet().not() ) then
    !!alert.error( 'Mating face has not been defined - Association not created' )
    return
  endif
  if( !this.partnerAssMember.matingFaceSet().not() ) then
    !!alert.error( 'Partner mating face has not been defined - Association not created' )
    return
  endif

  -- store the operation to be performed and any parameters
  if( !this.optSeparationOperation.active ) then
    !operation = !this.separationTypes[!this.optSeparationOperation.val]
  else
    !operation = ''
  endif
  if( !this.param1.active ) then
    !localParam[1] = !this.param1.val
  else
    !localParam = ARRAY()
  endif
  !this.assocBuilder.setParameters(!operation, !localParam)

  -- make the association element
  !assoc = !this.assocBuilder.instance()
  if( !assoc.unset() ) then
    !!alert.error('Association storage area not found. This MDB does not have an Association Group that you have permission to modify')
    return
  endif
  if( !assoc.owner.purpose neq 'ASEQ' ) then
    !!alert.warning('Equipment association storage area not found. This association will be created in ' + !assoc.owner.fullname)
  endif

  -- save ASSMBR settings is the members
  !this.myAssMember.matingFace.save(!this.assocBuilder.assMbrElement[1])
  !this.partnerAssMember.matingFace.save(!this.assocBuilder.assMbrElement[2])

  -- show test result of association just built
  !this.testAssociation(!assoc)

  -- record the new association element
  !this.association       = !assoc

  -- change this page from create to modify
  !this.butCreate.visible = false
  !this.butChange.visible = true
  !this.assListPopup.setFieldProperty('navigate','active' , true)
  !this.assListPopup.setFieldProperty('details','active' , true)
  !this.assListPopup.setFieldProperty('test','active', true)

  -- tidy aid graphics on existing object before replacing it
  !this.myAssMember.tidy()

  -- show graphical mating plane feedback
  !this.myAssMember.showFace()
  !this.partnerAssMember.showFace()


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .changeAssociation
--
-- Description: Modify Association callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeAssociation()

  -- check the name before create
  !tempName = !this.assocName.val
  if( !tempName.unset() ) then
    !tempName = ''
  endif
  if( !tempName.trim().empty() ) then
    -- unset name
    !this.assocBuilder.setName('')
  else
    !name = !this.checkName(!tempName)
    if( !name.unset() ) then
      -- abort if name check failed
      return
    endif
    !this.assocBuilder.setName(!name)
  endif

  -- check that mating faces have been defined
  if( !this.myAssMember.matingFaceSet().not() ) then
    !!alert.error( 'Mating face has not been defined - Association not created' )
    return
  endif
  if( !this.partnerAssMember.matingFaceSet().not() ) then
    !!alert.error( 'Partner mating face has not been defined - Association not created' )
    return
  endif

  -- Set design parameters
  -- store the operation to be performed and any parameters
  if( !this.optSeparationOperation.active ) then
    !operation = !this.separationTypes[!this.optSeparationOperation.val]
  else
    !operation = ''
  endif
  if( !this.param1.active ) then
    !localParam[1] = !this.param1.val
  else
    !localParam = ARRAY()
  endif
  !this.assocBuilder.setParameters(!operation, !localParam)

  !assoc = !this.assocBuilder.update()
  !this.myAssMember.matingFace.save(!this.assocBuilder.assMbrElement[1])
  !this.partnerAssMember.matingFace.save(!this.assocBuilder.assMbrElement[2])

  !this.testAssociation(!assoc)

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      navigatePartner
--
-- Description: Popup menu callback- Navigate to selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigatePartner()

  !selectedElement = !this.partnerList.selection()
  if(!selectedElement.trim() eq '')then
  	!!alert.error('Select partner element from the list to navigate')
  	return
  endif
  !ref = !selectedElement.dbref()
  handle any
    return
  endhandle
  !!ce = !ref

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      navigateAssoc
--
-- Description: Popup menu callback- Navigate to selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigateAssoc()

  !selectedElement = !this.assocDefnList.selection()
  if(!selectedElement.trim() eq '')then
  	!!alert.error('Select associate element from the list to navigate')
  	return
  endif

  !ref = !selectedElement.dbref()
  handle any
    return
  endhandle
  !!ce = !ref

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      testAssoc
--
-- Description: Popup menu callback- Test the selected Association
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testAssoc()

  !selectedElement = !this.assocDefnList.selection()

  if(!selectedElement.trim() eq '')then
  	!!alert.error('Select associate element from the list to test')
  	return
  endif

  !ref = !selectedElement.dbref()
  handle any
    return
  endhandle
  !this.testAssociation(!ref)

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      reportAssoc
--
-- Description: Popup menu callback- Test the selected Association
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reportAssoc(!menu is GADGET)

  -- get selected Association
  !selectedElement = !menu.selection()
  if(!selectedElement.trim() eq '')then
  	!!alert.error('Select element from the list to get association details')
  	return
  endif

  !ref = !selectedElement.dbref()
  handle any
    return
  endhandle

  -- show the Association details form for the selected Association
  show !!equAssQuery
  !!equAssQuery.setup(!ref)

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      measure
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .measure()

  if( !this.measure.val.not() ) then
    !!aidNumbers.hide(!this.aidDimension)
    return
  endif

  -- test that data can be found
  !from = !this.myAssMember.matingFace.posEv
  !to   = !this.partnerAssMember.matingFace.posEv
  if( !from.unset() or !to.unset() ) then
    !!alert.warning('Association positions not set for dimension')
    return
  endif

  -- Set form data
  !dimension         = object GPHDIMENSION(!from, !to)
  !dimension.tag     = false
  !dimension.detail  = false
  !dimension.draw(!this.aidDimension, true)

endmethod
-- End of function definition
