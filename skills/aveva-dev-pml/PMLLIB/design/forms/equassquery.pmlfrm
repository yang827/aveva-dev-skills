--
--
-- Description:
--  View details of an Equipment Association
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!equAssQuery dialog dock right

  !this.iconTitle     = 'QEquiAss'
  !this.formTitle     = 'Association Detail'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.12 $ '

------------------------------------------------------------------------------------------------------

  paragraph .assocName         anchor left + top          at x1 ymax-0.2    width 28
  line      .nameLine          anchor left + right + top  at x0 ymax  horiz width 33 heigh 0.3
  path down
  list      .lstRestrict       anchor all                 single zeroSelection  width 30 lines 12
  button    .dismiss 'Dismiss' anchor right + bottom      at xmax form-size ymax+0.2 callback '!this.close()'  width 8

  -- Form Members

  -- Association element
  member .association           is DBREF

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      equAssQuery
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .equAssQuery()

  -- Register form to show in any application, but not on start up
  !!appFormCntrl.registerForm(!this,ARRAY(),ARRAY(),false,false)

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise create mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.tidy()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be associated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!passedElement is DBREF)

  -- Initialise Variables
  if( badref(!passedElement) ) then
    !!alert.error('Association not found')
  endif

  -- set name field if name set
  !assocName = !passedElement.name
  if( !assocName.empty().not() ) then
    if( !assocName.subString(1,1) eq '=' ) then
      !assocName = ''
    endif
  endif
  !this.assocName.val = !assocName
  !this.association   = !passedElement

  -- show a list of all associations for this element
  !this.showRestrictions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showRestrictions
--
-- Description: Show a table of association restrictions for the given association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showRestrictions()

  !association = !this.association

  -- find restrictions for this association
  VAR !restrictions COLLECT ALL RESTRI FOR $!<association>

  !rows  = ARRAY()
--  !rText = ARRAY()
  !row   = ARRAY()

  -- First get Association data
  !associationName = !association.flnn
  !associationDesc = !association.desc

  -- build Association rows
  !row[1]  = 'ASSOCIATION'
  !row[2]  = !associationName
  !rows[1] = !row
  !row[1]  = '  Test Result'
  !row[2]  = !this.testResult(!association)
  !rows[2] = !row
  !row[1]  = '  Description'
  !row[2]  = !associationDesc
  !rows[3] = !row
  -- get association parameters
  !desp = !association.desp
  if( defined( !desp[1] ) ) then
    -- Operator parameter
    !operator = !association.wdesp[1]
    !row[1] = '  Operation'
    if( !operator eq 'LE' ) then
      !opString = 'MAX'
    elseif( !operator eq 'GE' ) then
      !opString = 'MIN'
    elseif( !operator eq 'EQ' ) then
      !opString = 'EQUAL'
    else
      !opString = !operator
    endif
    !row[2] = !opString
    !rows.append(!row)
  endif
  if( defined( !desp[2] ) ) then
    -- Value parameter
    !row[1] = '  Separation Value'
    !row[2] = !association.desp[2].string()
    !rows.append(!row)
  endif

  -- loop through restrictions to tabulate results
  do !index indices !restrictions
    !restriction     = !restrictions[!index].dbref()
    !row[1]  = 'RESTRICTION'
    !row[2]  = !index.string()
    !rows.append(!row)
    -- get definition of this restriction
    !restrictionDefn = !restriction.assdfs[1]
    handle any
       -- get restriction name
      !row[1]  = '  Restriction Definition'
      !row[2]  = 'DEFINITION NOT FOUND!'
      !rows.append(!row)
      skip
   endhandle
    -- get restriction description
    !row[1]  = '  Restriction Type'
    !row[2]  = !restrictionDefn.desc
    !rows.append(!row)
    -- get restriction name
    !row[1]  = '  Restriction Definition'
    !row[2]  = !restrictionDefn.namn
    !rows.append(!row)
    -- test result
    !row[1]  = '  Test Result'
    !row[2]  = !this.testResult(!restriction)

    !rows.append(!row)
  enddo

  -- Member information
  VAR !members COLLECT ALL ASSMBR FOR $!<association>
  do !index indices !members
    !member     = !members[!index].dbref()
    !assMember  = OBJECT ASSMEMBER(!member)
    -- Add member details to the table
    !row[1]  = 'MEMBER'
    !row[2]  = !index.string()
    !rows.append(!row)
    -- amemrf element
   !row[1]  = '  Element'
    !row[2]  = !assMember.amemrf.name
    handle any
      !row[2]  = 'Bad Reference'
      !rows.append(!row)
      skip
    endhandle
    !rows.append(!row)
    -- secondary element if set
    if( !assMember.tarf.set() ) then
      !row[1]  = '  Secondary Element'
      !row[2]  = !assMember.tarf.name
      handle any
        !row[2]  = 'Bad Reference'
      endhandle
      !rows.append(!row)
    endif

    -- Position
    !row[1]  = '  Position'
    !row[2]  = !assMember.posEv.wrt( /* ).string()
    handle any
      !row[2] = 'Unable to calculate position'
    endhandle
    !rows.append(!row)
    -- Direction
    !row[1]  = '  Direction'
    !row[2]  = !assMember.direv.wrt( /* ).string()
    handle any
      !row[2] = 'Unable to calculate direction'
    endhandle
    !rows.append(!row)
  enddo

  !headings[1] = 'Property'
  !headings[2] = 'Value'
  !this.lstRestrict.setHeadings(!headings)
  !this.lstRestrict.setRows(!rows)
--  !table.rText = !rText

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      testResult
--
-- Description: Convert result of test into string
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Assoc or Resti element to be tested
-- Return:
--   [Data Type] [Description]
--    STRING      Test result as 'Passed' or 'Failed'
--
------------------------------------------------------------------------

define method .testResult( !element is DBREF ) is STRING

  -- Initialise Variables
  !result = !element.testev
  handle any
    !result = false
  endhandle
  if(!result.unset()) then
    !result = false
  endif
  if(!result) then
    !return = 'Passed'
  else
    !return = 'Failed'
  endif

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form handler
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.tidy()
  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up form data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !this.association = object DBREF()

endmethod
-- End of method definition
