----------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
--  File:            equimportmanager.pmlfrm
--    Type:          Form Definition
--    Group:         Equipment
--      Keyword:     MCAD
--    Module:        Design
--  Author:          M.Barlow
--  Created:         Wed Apr  1 14:18:24 2009
--
--  Description:     Manage ImPLANT-MCAD import model storage
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addTo3DView(DBREF)               -                   Add element to 3D view
--  applyAttributes()                -                   Save changes to attributes
--  browse()                         -                   Display folder browser to select import model folder
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  clearElement()                   -                   If the root element is either a EQUI or VOLM element
--  clearVolumeDraw()                -
--  createAppArea()                  -                   Create Model Import area (APPDAR)
--  createAppGroup()                 -                   Create Model Import group (APPLDA)
--  createAppWorld()                 -                   Create Model Import world
--  createPrimitives()               -                   Create primitives from the selected items
--  deleteAppWorld()                 -                   Perform delete action for selected world element
--  deleteItem()                     -                   Perform delete action for selected element
--  dispose()                        -                   Clean up
--  equImportManager()               -                   Constructor
--  explorerPopUp(ARRAY)             -                   Explorer context menu callback
--  explorerSelect(ARRAY)            -                   Explorer select event handler
--  findElements()                   -                   Find elements to populate modify grid
--  findElementsBeneath()            -                   Find elements beneath current element
--  findElementsWithinVolume()       -                   Find elements within volume
--  highlight(ARRAY)                 -                   Highlight elements
--  highlight(DBREF)                 -                   Highlight element
--  importIntoElement()              -                   Import model into current element
--  includeVolumeDraw()              -                   Draw current volume
--  includeVolumeRefresh(VOLUME)     -                   Refresh Volume
--  initialise()                     -                   Initialise form
--  loadAppGroups()                  -                   Load Model Import Groups for the current world
--  loadAppGroups(DBREF)             -                   Load Model Import Groups for the given world
--  loadAppWorlds()                  -                   Initialise Model Import worlds list
--  loadAttributesToModify(DBREF)    -                   Show model import hierarchy attributes
--  modifyAttributes()               -                   Callback for modify Association group attributes
--  modifyWorldAttributes()          -                   Modify Model Import world attributes
--  navigate(DBREF)                  -                   Navigate to element selected
--  netGridPopupCallback(ARRAY)      -                   Set/Display the popup menu for the modify grid
--  populateModifyGrid(ARRAY)        -                   Populate modify grid with elements
--  popupMenus()                     -                   Setup popup menus
--  reloadAppGroups(DBREF)           -                   Reset model hierarchy and select the given element
--  reloadModifyGrid()               -                   Reload modify grid
--  removeFrom3DView()               -                   Remove selected element from view
--  selectWorld()                    -                   Callback for select Model Import world
--  setCurrentElement()              -                   Set the current element to import into
--  setImportButton()                -                   Set the "Import" button state depending on current settings.
--  setModifyCurrentElement(GADGET,STRING) -                   Set the current element to modify
--  setRepresentation()              -                   Set the display level and obstruction value
--  showElectricalComps()            -                   Show the standard create nozzle form
--  sliderCallback()                 -                   parameter change callback
--  switchFrameLocation(REAL)        -                   Show panel to import a model into an element
--  switchModifyTree(STRING)         -                   Switches between tree tasks
--  toggleSelectionChanged(GADGET,STRING) -                   Toggle selection changed event
--  toggleSubeLevelOption(BOOLEAN)   -                   Set the "Create SUBE level" state depending on import type.
--  toggleTessCacheOption(BOOLEAN)   -                   Set the "Tolerance" state depending on current settings.
--  toleranceTag()                   STRING              Initialise tolerance tag depending on current units
--  treeSelect(DBREF)                -                   Action for selection of APPLDA and APPDAR
--  unHighlight(ARRAY)               -                   Unhighlight elements
--  unHighlight(DBREF)               -                   Unhighlight element
--  undoRedoAction()                 -                   Callback invoked when the undo redo action are invoked
--  validateCurrentElement()         BOOLEAN             Validate current element textbox
--  validateFilePath(GADGET,STRING)  -                   Validate import file path
--  validateModifyCurrentElement(GADGET,STRING) -                   Validate modify current element textbox
--  validateTolerance(GADGET,STRING) -                   Validate tolerance text gadget, value should be no greater than 20mm
--
------------------------------------------------------------------------
--

setup form !!equImportManager dialog docking

  -- Import PMLNet controls
  using namespace 'Aveva.Pdms.Presentation'

  import 'ExplorerAddin'
  handle any
  endhandle

  import 'GridControl'
  handle any
  endhandle

  -- Form members and events
  !this.formTitle     = 'Mechanical Equipment Interface'
  !this.iconTitle     = 'Mechanical Equipment'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.dispose()'
  !this.killingCall   = '!this.dispose()'
  !this.autoscroll    = true

  -- Constant width values for gadgets
  !frameWidth         = 55
  !innerFrameWidth    = !frameWidth - 3
  !listWidth          = !innerFrameWidth - 1
  !resultWidth        = 12
  !sliderWidth        = 8

  -- Form definition

  frame .tabset TABSET  'tabset' anchor l+t+r

    -- Import Tab
    frame .page1 'Import' dock fill

      frame .frameLocation          'Import location'                  anchor left+top+right         at x1.0                       y0.5                  width $!frameWidth
        path right
        rtoggle .toggleElement      'Import beneath current element'   anchor left+top tagwidth 20   at x2.0
        rtoggle .toggleWorld        'Import into storage world'        anchor left+top tagwidth 18
      exit

      -- Element Import Panel
      frame .frameImportToElement panel                                anchor left+top+right         at xmin.frameLocation         ymax.frameLocation

        frame .frameElement         'Select element'                   anchor left+top+right         at xmin                       ymax+0.5              width $!frameWidth
          paragraph .message                                           anchor left+top               at xmin+1.5                   ymax                  text 'Please select a Site, Zone, Equipment or Volume to import into' width 43
          text    .textSetCurrentElement                               anchor left+right+top         at xmin                       ymax                  callback '!this.validateCurrentElement()' width 46 is STRING
          path right
          button .bntCE2            'CE'                               anchor right+top                                                                  callback '!this.setCurrentElement()'
        exit

        frame .browseForFilesFrame1 'Import file'                      anchor left+top+right         at xmin                       ymax+0.5              width $!frameWidth
          path right
          text   .txtFiles1                                            anchor left+right+top         at xmin+1.5                                         callback '!this.validateFilePath(' width 39  is STRING
          button .butBrowse1        'Browse...'                        anchor right+top                                                                  callback '!this.browse()' width 10

          frame .frameSettings1     'Settings'                         anchor left+top+right         at x1.5                       ymax+0.5              width $!innerFrameWidth
            path down
            option .optImportType1  'Import model as:'                 anchor left+top tagWidth 11   at xmin+1.5                   ymax                  callback '!this.toggleSubeLevelOption(true)' width 12
            toggle .togSubeLevel1   'Create SUBE level'                anchor left+top               at xmin+1.5                   ymax+0.5              callback '!this.togSubeLevel.val = !this.togSubeLevel1.val'
            toggle .togNozzles1     'Save existing nozzles on import'  anchor left+top               at xmin                       ymax+0.5              callback '!this.togNozzles.val = !this.togNozzles1.val'
          exit

          frame .frameOptions1      'Options'                          anchor left+top+right         at x1.5                       ymax+0.5              width $!innerFrameWidth
            path down
            toggle .togTessCache1   'Save Facet Data'                anchor left+top               at xmin+1.5                   ymax                  callback '!this.toggleTessCacheOption(true)'
            text .txtTessTol1       ''                                 anchor right+top tagwidth 20  at xmax.frameOptions1-size    ymin                  callback '!this.validateTolerance('  width 7 is REAL format !!distanceFmt
          exit

          button .butGroupImport1   'Import'                           anchor right+top              at xmax.frameSettings1-size   ymax+0.5              callback '!this.importIntoElement()' width 10

        exit
        -- End of browseForFilesFrame1

      exit
      -- End of frameImportToElement


      frame .frameImportToAppWorld panel                               anchor all                    at xmin.frameLocation         ymax.frameLocation

        frame .frameGrids             'Select storage world'           anchor all                    at xmin                       ymax0.5
          list   .lstAppWorlds                                         anchor top+right+left         at x1.0                       ymax                  call |!this.selectWorld()| width $!listWidth length 7
          paragraph .paraCreateIcon                                    anchor left+top               at xmin+0.5                   ymax+0.2              pixmap  width 16 height 16
          path right
          button .butWorldCreate   linkLabel  'Create New World '      anchor left+top                                                                   callback '!this.createAppWorld()'   width 13
          paragraph .paraModifyIcon                                    anchor left+top                                                                   pixmap  width 16 height 16
          button .butWorldModify   linkLabel  'Modify World Attributes' anchor left+top                                                                  callback '!this.modifyWorldAttributes()' width 14
          paragraph .paraDeleteIcon                                    anchor left+top                                                                   pixmap  width 16 height 16
          button .butWorldDelete   linkLabel  'Delete World'           anchor left+top                                                                   callback '!this.deleteAppWorld()'   width 10
          Container .explorerFrame PMLnetcontrol 'NET'                 anchor all                    at x1.0                       ymax+0.8              width $!listWidth height 11
          button .butModifyHierarchy  linkLabel  'Modify Hierarchy'    anchor left+bottom            at xmin                       ymax                  callback '!this.switchModifyTree(''tasks'')'
        exit

        -- Panels for managing functionality related to the tree views
        frame .browseForFilesFrame  'Import file'                      anchor left+bottom+right      at xmin                       ymax+0.5              width $!frameWidth
          path right
          text   .txtFiles                                             anchor left+right+top         at xmin+1.5                                         callback '!this.validateFilePath(' width 39  is STRING
          button .butBrowse         'Browse...'                        anchor right+top                                                                  callback '!this.browse()' width 10

          frame .frameSettings      'Settings'                         anchor left+top+right         at x1.5                       ymax+0.5              width $!innerFrameWidth
            path down
            option .optImportType   'Import model as:'                 anchor left+top tagWidth 11   at xmin+1.5                   ymax                  callback '!this.toggleSubeLevelOption(false)' width 12
            toggle .togSubeLevel    'Create SUBE level'                anchor left+top               at xmin+1.5                   ymax+0.5              callback '!this.togSubeLevel1.val = !this.togSubeLevel.val'
            toggle .togNozzles      'Save existing nozzles on import'  anchor left+top               at xmin                       ymax+0.5              callback '!this.togNozzles1.val = !this.togNozzles.val'
          exit

          frame .frameOptions       'Options'                          anchor left+top+right         at x1.5                       ymax+0.5              width $!innerFrameWidth
            path down
            toggle .togTessCache    'Save Facet Data'                  anchor left+top               at xmin+1.5                   ymax                  callback '!this.toggleTessCacheOption(false)'
            text .txtTessTol        ''                                 anchor right+top tagwidth 20  at xmax.frameOptions-size     ymin                  callback '!this.validateTolerance(' width 7 is REAL format !!distanceFmt
          exit

          button .butGroupImport    'Import'                           anchor right+top              at xmax.frameSettings-size    ymax+0.5              callback '!this.importIntoElement()' width 10

        exit
        -- End of browseForFilesFrame

        -- Modify hierarchy
        frame .frameModifyHierarchy     'Modify hierarchy'             anchor left+bottom+right      at xmin.browseForFilesFrame   ymin.browseForFilesFrame  width $!frameWidth
          paragraph .paraCreateIcon2                                   anchor left                   at x1.0                       ymax+0.5              pixmap  width 16 height 16
          button .butAreaCreate linkLabel   'Create Model Import Area' anchor left                   at xmax0.5                    ymin                  callback '!this.createAppArea()'
          paragraph .paraCreateIcon3                                   anchor left                   at x1.0                       ymax+0.5              pixmap  width 16 height 16
          button .butGroupCreate linkLabel  'Create Model Import Group' anchor left                  at xmax0.5                    ymin+0.1              callback '!this.createAppGroup()'
          paragraph .paraModifyIcon2                                   anchor left                   at x1.0                       ymax+0.5              pixmap  width 16 height 16
          button .butGroupModify  linkLabel 'Modify Attributes'        anchor left                   at xmax0.5                    ymin                  callback '!this.modifyAttributes()'
          paragraph .paraDeleteIcon2                                   anchor left                   at x1.0                       ymax+0.5              pixmap  width 16 height 16
          button .butGroupDelete  linkLabel 'Delete Item'              anchor left                   at xmax0.5                    ymin                  callback '!this.deleteItem()'
          button .groupBack2                'Back'                     anchor right                  at xmax.butGroupImport-size   ymax+0.5              callback '!this.switchModifyTree(''import'')'
        exit

        -- Modify attributes of selected item
        frame .modifyHierarchyAttr         'Modify attributes'             anchor left+bottom+right                    at xmin.browseForFilesFrame    ymin.browseForFilesFrame  width $!frameWidth
          text   .txtAttributeName         'Name:'            tagwidth 12  anchor left+bottom+right      at x1.5                        ymax+0.5              callback |!this.checkName(!this.txtAttributeName,!this.savedName)| width 39 is STRING
          text   .txtAttributeDescription  'Description:'     tagwidth 12  anchor left+bottom+right      at xmin                        ymax+0.5              width 39  is STRING
          text   .txtAttributeFunction     'Function:'        tagwidth 12  anchor left+bottom+right      at xmin                        ymax+0.5              width 39  is STRING
          button .butModAttrApply          'Apply'                         anchor bottom + right         at xmax.butGroupImport-size    ymax+0.5              callback '!this.applyAttributes()'
          path left
          button .butModAttrBack           'Back'                          anchor right+bottom                                                                callback '!this.switchModifyTree(''tasks'')'
        exit

      exit
      -- End of frameImportToAppWorld

    exit
    -- End of Page1

    -- Modify Tab
    frame .page2 'Modify' dock fill at xmin.page1 ymin.page1

      frame .frameFind              'Find elements to modify:'        anchor left+right+top         at x1.0                       y0.2                  width $!frameWidth

        rtoggle .togInVolume        ''                                anchor left+top               at x1.5                       ymax                  callback'!this.toggleSelectionChanged('
        path right
        text    .textCurrentElement 'In volume: '   tagwidth 12       anchor left+top+right                                                       callback '!this.validateModifyCurrentElement(' width 31 is STRING
        button .btnCE               'CE'                              anchor top+right                                                            callback '!this.setModifyCurrentElement('

        -- Volume centre
        frame .positionSliderFrame  'Centre'                          anchor left+top               at x1.0                       ymax0.2
          text   .xPosition         'E'                                                                                                                 width $!resultWidth is REAL format !!distanceFmt
          path right
          slider .xPositionSlider horizontal                                                                                                            callback '!this.sliderCallback('        range -5000 +5000 step 100 val 0 width $!sliderWidth
          path down
          text   .yPosition         'N'                                                             at xmin.xPosition                                   width $!resultWidth is REAL format !!distanceFmt
          path right
          slider .yPositionSlider horizontal                                                                                                            callback '!this.sliderCallback('        range -5000 +5000 step 100 val 0 width $!sliderWidth
          path down
          text   .zPosition         'U'                                                             at xmin.yPosition                                   width $!resultWidth is REAL format !!distanceFmt
          path right
          slider .zPositionSlider horizontal                                                                                                            callback '!this.sliderCallback('        range -5000 +5000 step 100 val 0 width $!sliderWidth
        exit

        -- Volume size
        frame .extentSliderFrame    'Extent'                          anchor left+top               at xmax+1.0                   ymin
          path down
          text   .xLength           'X'                                                                                                                 width $!resultWidth is REAL format !!distanceFmt
          path right
          slider .xLengthSlider horizontal                                                                                                              callback '!this.sliderCallback('        range -5000 +5000 step 100 val 0 width $!sliderWidth
          path down
          text   .yLength           'Y'                                                             at xmin.xLength                                     width $!resultWidth is REAL format !!distanceFmt
          path right
          slider .yLengthSlider horizontal                                                                                                              callback '!this.sliderCallback('        range -5000 +5000 step 100 val 0 width $!sliderWidth
          path down
          text   .zLength           'Z'                                                             at xmin.xLength                                     width $!resultWidth is REAL format !!distanceFmt
          path right
          slider .zLengthSlider horizontal                                                                                                              callback '!this.sliderCallback('        range -5000 +5000 step 100 val 0 width $!sliderWidth
        exit

        path down
        rtoggle .togBeneathElement  ''                                anchor left+top         at x1.5                       ymax1.0              callback'!this.toggleSelectionChanged('
        path right
        text    .textBeneathElement 'Beneath element: '  tagwidth 12  anchor left+top+right                                                       callback '!this.validateModifyCurrentElement(' width 31 is STRING
        button .butCE               'CE'                              anchor top+right                                                            callback '!this.setModifyCurrentElement('

        path down
        button .butFind             'Find'                            anchor right+top              at xmax.btnCE-size            ymax0.5               callback '!this.findElements()' width 10


      exit
      -- End of frameFind

      path down
      container .conModifyGrid NOBOX PmlNetControl 'Selected items'  anchor left+right+top         at xmin.frameFind             ymax0.2               width $!frameWidth height 10
      button  .butSelectAll         'Select All'                      anchor left+top                                                                   callback '!this.netModifyGrid.selectAllRows()'    width 10
      path right
      button  .butDeselectAll       'Deselect All'                    anchor left+top                                                                   callback '!this.netModifyGrid.clearRowSelection()'  width 10

      -- Representation Frame
      frame .representationFrame    'Representation'                  anchor left+right+top         at xmin.conModifyGrid        ymax0.2               width $!frameWidth
        path right
        numeric .numLowerLevel      'Display level:'                  anchor left+top tagwidth 9    at x1.0                                             width 5
        numeric .numUpperLevel                                        anchor left+top               at xmax+1.4                   ymin                  width 5
        option .optObstructionLevel 'Obstruction:'                    anchor left+right+top tagWidth 9    at xmin.numLowerLevel         ymax0.2               width 13
        path right
        button .butApplyRepresentation 'Apply'                        anchor right+top              at xmax.btnCE-size                                  callback '!this.setRepresentation()'  width 10
      exit

      -- Create Primitives Frame
      frame .primitiveFrame 'Create primitives from selected elements' anchor left+right+top        at xmin.representationFrame   ymax0.2               width $!frameWidth
        option .optPrimitive  'Primitive:'                            anchor left+right+top tagWidth 9                                                        width 13
        path right
        hdist 6
        button .butCreatePrimitive  'Create '                         anchor right+top              at xmax.btnCE-size                                  callback '!this.createPrimitives()' width 10
        path down
      exit

      -- Connections Frame
      frame .connectionFrame        'Create connections'                         at xmin                       ymax0.2                       anchor left+right+top                 width $!frameWidth
        button .butNozzle linkLabel       'Create Nozzles...'                    at xmin.optPrimitive          ymax+0.2                      anchor left+top     callback |CALLE XNOZZ NEW $<CALLE MNOZZ NEW$>| width 20
        button .butElectrical linkLabel   'Create Electrical Components...'      at xmin                       ymax                          anchor left+top     callback |!this.showElectricalComps()|         width 20
        button .butCreateNozzle linklabel 'Create Nozzle at Selected Element...' at xmax+2                     ymin.butNozzle                anchor left+top     callback |Show !!equmeicreatenozzle|           width 25
        button .butCreatePoint  linklabel  'Create Design Points...'             at xmin                       ymax+0.2                      anchor left+top     callback |Show !!equmeicreatepoint|            width 20
       exit
    exit
    --End of modify tab
  exit
  -- End of tabset

  -- This line sets the form size and if re-sized smaller will scroll, to avoid nasty overlapping gadgets
  line .lineBottom  at x0 y0 horizontal width 57

  -- Popup menu for modify grid
   menu .modifyGridPopup popup
    !this.modifyGridPopup.add( 'CALLBACK', 'Highlight','!this.highlight(!this.netModifyGrid.getSelectedRows())' , 'highlight' )
    !this.modifyGridPopup.add( 'CALLBACK', 'Unhighlight','!this.unHighlight(!this.netModifyGrid.getSelectedRows())', 'unHighlight')
    !this.modifyGridPopup.add( 'SEPARATOR','separatorLine')
    !this.modifyGridPopup.add( 'CALLBACK', 'Navigate To','!this.navigate(!this.netModifyGrid.getSelectedRows()[1][2].dbRef())' , 'navigateTo' )
    !this.modifyGridPopup.add( 'separator' )
    !this.modifyGridPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.netModifyGrid, ||, |Save As|)' )
    !this.modifyGridPopup.add( 'callback', 'Print Preview...', '!this.netModifyGrid.printpreview()' )


  -- Form members

  -- Grid control
  member .netModifyGrid          is NETGRIDCONTROL
  -- Model import hierarchy explorer control
  member .modelImportExplorer     is PMLEXPLORERCONTROL

  -- Current active elements
  member .currentElement          is DBREF
  member .currentAppWorldElement  is DBREF
  member .explorerSelected        is DBREF
  member .apdWorld                is DBREF
  member .apdGroup                is DBREF
  member .apdArea                 is DBREF

  -- Current modify element
  member .currentModifyElement    is DBREF

  -- Import File
  member .importFile              is FILE

  -- Model Import world data
  member .apdWorldCollection      is COLLECTION
  member .apdWorldAttributes      is ARRAY

  -- Aid text
  member .aidNumber               is REAL

  -- Save name of element to restore if illegal name entered
  member .savedName               is STRING

  -- Save what elements were loaded into the modify grid
  member .savedElementsToModify is ARRAY

  -- Model import home folder
  member .homeDirectory           is STRING

  -- Undo event handlers
  member .undoImport              is UNDOABLE

  member .includeVolume           is VOLUME
  member .aidVolume               is REAL
  member .startValue              is REAL

  -- New EQUI or VOLM to import model into if user does not want to overwrite existing
  member .newElement              is DBREF
  -- New EQUI or VOLM flag
  member .importToNewElement      is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      equImportManager
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .equImportManager()

  -- Tooltips
  !this.bntCE2.setTooltip('Select Current Element')
  !this.butBrowse1.setTooltip('Browse Folders...')
  !this.butGroupImport1.setTooltip('Import File')
  !this.butWorldDelete.setTooltip('Delete Selected World')
  !this.butBrowse.setTooltip('Browse Folders...')
  !this.butGroupImport.setTooltip('Import File')
  !this.butGroupDelete.setTooltip('Delete Selected Item')
  !this.groupBack2.setTooltip('Back')
  !this.butModAttrApply.setTooltip('Apply')
  !this.butModAttrBack.setTooltip('Back')
  !this.btnCE.setTooltip('Select Current Element')
  !this.butCE.setTooltip('Select Current Element')
  !this.butFind.setTooltip('Find Elements')
  !this.butSelectAll.setTooltip('Select All Items')
  !this.butDeselectAll.setTooltip('Deselect All Items')
  !this.butApplyRepresentation.setTooltip('Apply')
  !this.butCreatePrimitive.setTooltip('Create Primitives from Selected Elements')
  !this.butCreateNozzle.setTooltip('Position and create nozzles from graphical picks')
  !this.butCreatePoint.setTooltip('Create design points from graphical picks')
  !this.butNozzle.setTooltip('Create nozzles')
  !this.butElectrical.setTooltip('Create electrical connection')

  -- initialise input file name
  !folderUser                     = object FILE('%PDMSUSER%')
  !this.homeDirectory             = !folderUser.fullname()

  -- Setup for location
  !this.frameLocation.callback    = '!this.switchFrameLocation(!this.frameLocation.val)'
  !this.switchFrameLocation(1)

  -- Setup default for import files, rather than modify tree
  !this.switchModifyTree('import')

  -- Make "Import" active
  !this.butGroupImport1.active    = !this.currentElement.set().and(!this.importFile.set())
  !this.butGroupImport.active     = !this.importFile.set()

  -- Attributes
  !attributes = ARRAY()
  !attributes.append('Name')
  !attributes.append('Description')
  !attributes.append('Function')
  !attributes.append('Database')

  -- Collection definitions
  !this.apdWorldCollection        = object COLLECTION()
  !this.apdWorldCollection.addType('APPLDW')
  !this.apdWorldCollection.filter(object EXPRESSION('PURP eq |MIMP|'))
  !this.apdWorldAttributes        = !attributes

  !this.savedName                 = ''
  !this.explorerSelected          = object DBREF()

  -- Create instance of explorer control
  using namespace 'Aveva.Pdms.Presentation'
  !this.modelImportExplorer       = object PMLEXPLORERCONTROL()
  !this.explorerFrame.control     = !this.modelImportExplorer.handle()

  --Add event handlers
  !this.modelImportExplorer.addEventHandler('OnSelectionChanged',!this, 'explorerSelect')
  !this.modelImportExplorer.addEventHandler('OnPopUp', !this, 'explorerPopUp')
  !this.modelImportExplorer.initialise('DESI', '/*')

  -- Setup popup-menus
  !this.popupMenus()

  -- Import type option
  !dText[1] = 'Equipment'
  !dText[2] = 'Volume Model'
  !dText[3] = 'Subequipment'
  !rText[1] = 'EQUI'
  !rText[2] = 'VOLM'
  !rText[3] = 'SUBE'
  !this.optImportType.dText       = !dText
  !this.optImportType.rText       = !rText
  !this.optImportType1.dText      = !dText
  !this.optImportType1.rText      = !rText

  !this.togSubeLevel.val      = false
  !this.togSubeLevel1.val     = false
  !this.togSubeLevel.active   = !this.optImportType.selection() eq 'EQUI'
  !this.togSubeLevel1.active  = !this.optImportType1.selection() eq 'EQUI'

  -- Set "Save Nozzles on import" to true to default
  !this.togNozzles1.val = true

  -- Set "Enable tesselation cache" to false to default
  !this.togTessCache1.val = false
  !this.togTessCache.val  = false

  -- Set default tesselation cache tolerance to arc tolerance
  -- Init tag depending on current units
  var !arctol REPRE DARCTOL
  !this.txtTessTol1.active = !this.togTessCache1.val
  !this.txtTessTol.active  = !this.togTessCache.val
  !this.txtTessTol1.tag = !this.toleranceTag()
  !this.txtTessTol.tag = !this.toleranceTag()
  !this.txtTessTol1.val = !arctol.real(!!distanceFmt)
  !this.txtTessTol.val  = !arctol.real(!!distanceFmt)

  -- Initialise undo's
  !this.undoImport.description('Model Import')
  !this.undoImport.undoAction('!!equImportManager.undoRedoAction()')
  !this.undoImport.redoAction('!!equImportManager.undoRedoAction()')
  -- Undo Import
  !this.butGroupImport.setUndoable(!this.undoImport)
  !this.butGroupImport1.setUndoable(!this.undoImport)
  -- Undo Create Application Data World, Area and Item
  !this.butWorldCreate.setUndoable(!this.undoImport)
  !this.butAreaCreate.setUndoable(!this.undoImport)
  !this.butGroupCreate.setUndoable(!this.undoImport)
  -- Undo delete world and item
  !this.butWorldDelete.setUndoable(!this.undoImport)
  !this.butGroupDelete.setUndoable(!this.undoImport)

  -- Get and set icons
  !createIcon = !!pml.getPathName('create.png')
  !this.paraCreateIcon.addPixmap(!createIcon)
  !this.paraCreateIcon2.addPixmap(!createIcon)
  !this.paraCreateIcon3.addPixmap(!createIcon)

  !modifyIcon = !!pml.getPathName('modify16.png')
  !this.paraModifyIcon.addPixmap(!modifyIcon)
  !this.paraModifyIcon2.addPixmap(!modifyIcon)

  !deleteIcon = !!pml.getPathName('deletece16.png')
  !this.paraDeleteIcon.addPixmap(!deleteIcon)
  !this.paraDeleteIcon2.addPixmap(!deleteIcon)

  -- Set the "In volume" toggle on the modify tab to true by default
  !this.togInVolume.val = true
  !this.toggleSelectionChanged(!this.togInVolume, 'SELECT')

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'
  -- Create grid control objects
  !this.netModifyGrid  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  !this.netModifyGrid.addEventHandler('OnPopup', !this, 'netGridPopupCallback')
  -- Set grid properties
  !this.netModifyGrid.fixedHeaders(false)
  !this.netModifyGrid.fixedRows(false)
  !this.netModifyGrid.outlookGroupStyle(true)
  !this.netModifyGrid.columnExcelFilter(true)
  !this.netModifyGrid.headerSort(true)
  !this.netModifyGrid.columnSummaries(false)
  !this.netModifyGrid.singleRowSelection(false)
  !this.netModifyGrid.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.conModifyGrid.control    = !this.netModifyGrid.handle()

  -- Load encapsulating element types
  !primitive                            = object ARRAY()
  !primitiveDisplay                     = object ARRAY()

  !primitive.append('0')
  !primitiveDisplay.append('Box')
  !primitive.append('1')
  !primitiveDisplay.append('Cylinder')

  !this.optPrimitive.dText              = !primitiveDisplay
  !this.optPrimitive.rText              = !primitive

  -- Load representation gadgets
  !obstruction                         = object ARRAY()
  !obstructionDisplay                  = object ARRAY()

  !obstruction.append('0')
  !obstructionDisplay.append('None')
  !obstruction.append('1')
  !obstructionDisplay.append('Soft')
  !obstruction.append('2')
  !obstructionDisplay.append('Hard')

  !this.optObstructionLevel.dText      = !obstructionDisplay
  !this.optObstructionLevel.rText      = !obstruction

  -- Set default value for obstruction
  !this.optObstructionLevel.select('dText','Hard')

  -- Set default values for display level
  !this.numLowerLevel.val = 0
  !this.numUpperLevel.val = 10

  -- Parameter change callback on the extents
  !this.xPosition.validateCall         = '!this.sliderCallback('
  !this.yPosition.validateCall         = '!this.sliderCallback('
  !this.zPosition.validateCall         = '!this.sliderCallback('

  !this.xLength.validateCall           = '!this.sliderCallback('
  !this.yLength.validateCall           = '!this.sliderCallback('
  !this.zLength.validateCall           = '!this.sliderCallback('

   -- Check the coordinate settings and label textboxes appropriately
   var !coord coord
   if (!coord.eq('ENU'))then
     !this.xPosition.tag = 'E'
     !this.yPosition.tag = 'N'
     !this.zPosition.tag = 'U'
   else
     !this.xPosition.tag = 'X'
     !this.yPosition.tag = 'Y'
     !this.zPosition.tag = 'Z'
   endif

   -- Setup aid number
  !this.aidVolume                 = !!aidNumbers.add('AVEVA General include volume')

  -- Import PML file browser (only done once)
  import 'pmlFileBrowser'
  handle (1000,0)
    -- This handle will capture an exception that occurs
    -- if a file browser object has already been loaded
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupMenus
--
-- Description: Setup popup menus
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupMenus()

  -- Define popup menus for tree-view
  !popup = !this.newMenu('treePopupWorld')
  !popup.add('callback', 'Create Model Import Area',       '!this.createAppArea()',   'APPDARCreate')
  !popup.add('callback', 'Navigate To',                    '!this.navigate(!this.explorerSelected)',        'eAPPDWLNavigate')

  !popup = !this.newMenu('treePopupArea')
  !popup.add('callback', 'Create Model Import Area',       '!this.createAppArea()',   'APPDARCreate')
  !popup.add('callback', 'Create Model Import Group',      '!this.createAppGroup()',  'APPLDACreate')
  !popup.add('callback', 'Navigate To',                    '!this.navigate(!this.explorerSelected)',        'eAPPDARNavigate')

  !popup = !this.newMenu('treePopupGroup')
  !popup.add('callback', 'Create Model Import Group',      '!this.createAppGroup()',  'APPLDACreate')
  !popup.add('callback', 'Navigate To',                    '!this.navigate(!this.explorerSelected)',        'eAPPLDANavigate')

  !popup = !this.newMenu('treePopupEqui')
  !popup.add('callback', 'Add to 3D View',                 '!this.addTo3DView(!this.explorerSelected)',     'addToView')
  !popup.add('callback', 'Remove from 3D View',            '!this.removeFrom3DView()','removeFormView')
  !popup.add('separator', 'line1')
  !popup.add('callback', 'Highlight',                      '!this.highlight(!this.explorerSelected)',       'highlight')
  !popup.add('callback', 'Unhighlight',                    '!this.unHighlight(!this.explorerSelected)',     'unHighlight')
  !popup.add('separator', 'line2')
  !popup.add('callback', 'Navigate To',                    '!this.navigate(!this.explorerSelected)',        'Navigate')

  !popup = !this.newMenu('worldPopup')
  !popup.add('callback', 'Modify Attributes',              '!this.modifyWorldAttributes()',                 'APPDDWModify')
  !popup.add('callback', 'Delete',                         '!this.deleteAppWorld()',                        'APPDDWDelete')
  !popup.add('callback', 'Navigate To',                    '!this.navigate(!this.apdWorld)',                'gAPPDWLNavigate')

  !popup = !this.newMenu('treePopupItem')
  !popup.add('callback', 'Highlight',                      '!this.highlight(!this.explorerSelected)',       'highlight')
  !popup.add('callback', 'Unhighlight',                    '!this.unHighlight(!this.explorerSelected)',     'unHighlight')
  !popup.add('separator', 'line2')
  !popup.add('callback', 'Navigate To',                    '!this.navigate(!this.explorerSelected)',        'Navigate')

  !this.lstAppWorlds.popup = !popup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      netGridPopupCallback()
--
-- Description: Set/Display the popup menu for the modify grid
--              arrData[0] = X
--              arrData[1] = Y
--              arrData[2] = Array of row numbers selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netGridPopupCallback(!arrData is ARRAY)

  -- Check that some rows are selected before showing the menu
  if (!arrData[2].set()) then
    !this.conModifyGrid.popup = !this.modifyGridPopup
    -- Only show "Navigate To" if there is one item selected
    if (!this.netModifyGrid.getSelectedRows().size().neq(1)) then
      !this.modifyGridPopup.setFieldProperty('navigateTo','visible',false)
    else
      !this.modifyGridPopup.setFieldProperty('navigateTo','visible',true)
    endif
    -- Show the popup menu as configured
    !this.conModifyGrid.showPopup(!arrData[0], !arrData[1])
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      explorerPopUp
--
-- Description: Explorer context menu callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference of selected element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .explorerPopUp(!data is ARRAY)

  !element     = !data[2].dbRef()
  !elementType = !element.type
  if (!elementType eq 'APPLDW') then
    !this.explorerFrame.popup = !this.treePopupWorld
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!elementType eq 'APPDAR') then
    !this.explorerFrame.popup = !this.treePopupArea
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!elementType eq 'APPLDA') then
    !this.explorerFrame.popup = !this.treePopupGroup
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!elementType inset('EQUI','VOLM','ZONE')) then
    !this.explorerFrame.popup = !this.treePopupEqui
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!elementType inset('GENPRI','GENCUR')) then
    !this.explorerFrame.popup = !this.treePopupItem
    !this.explorerFrame.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Show Application Data Worlds frame
  !this.loadAppWorlds()

  -- Select world
  !this.selectWorld()

  !this.frameLocation.val = 1
  !this.switchFrameLocation(!this.frameLocation.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      toleranceTag
--
-- Description: Initialise tolerance tag depending on current units
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .toleranceTag() is STRING

  if( !!isImperialLength('DIST')) then
    return 'Tolerance (0.004 .. 0.787inch)'
  else
    return 'Tolerance (0.1 .. 20mm)'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearAidGraphics
--
-- Description: Clean up
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearVolumeDraw()
   -- Clear aid lines
   AID CLEAR ALL $!this.aidVolume
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dispose
--
-- Description: Clean up
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dispose()
   -- Clear aid lines
  !this.clearVolumeDraw()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAppWorlds
--
-- Description: Initialise Model Import worlds list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAppWorlds()

  -- Initialise Variables

  -- Modify World link label and icon
  !this.butWorldModify.active     = true
  !this.paraModifyIcon.active     = true
  -- Delete world link label and icon
  !this.butWorldDelete.active     = true
  !this.paraDeleteIcon.active     = true

  -- Get all Model Import Application Data Area Worlds
  !myCollection                   = !this.apdWorldCollection.results()

  -- Clear grid
  !this.lstAppWorlds.clear()

  -- Load grid
  !this.lstAppWorlds.setHeadings(!this.apdWorldAttributes)
  !rows  = ARRAY()
  !rText = ARRAY()

  do  !worlds values !myCollection
    !rText.append(!worlds.string())
    !row[1] = !worlds.fullname
    !row[2] = !worlds.description
    !row[3] = !worlds.function
    !row[4] = !worlds.dbName
    !rows.append(!row)
  enddo

  -- If there are no worlds, then disable "modify" and "delete" world functionality
  if( !myCollection.empty() ) then
    !this.apdWorld              = object DBREF()
    !this.butWorldModify.active = false
    !this.paraModifyIcon.active = false
    !this.butWorldDelete.active = false
    !this.paraDeleteIcon.active = false
    return
  endif

  -- Load the grid
  !this.lstAppWorlds.setRows(!rows)
  !this.lstAppWorlds.rText = !rText

  -- Handle empty list
  if(!this.lstAppWorlds.rText.empty()) then
    !this.apdWorld         = object DBREF()
    return
  endif

  -- Select current Application Data World or first if it is empty
  if( badref(!this.apdWorld) ) then
    !this.apdWorld          = object DBREF()
    !this.lstAppWorlds.val  = 1
  else
    !index = !this.lstAppWorlds.rText.findFirst(!this.apdWorld.string())
    if( !index.unset() ) then
      !index                = 1
    endif
    !this.lstAppWorlds.val  = !index
  endif

  -- Refresh world list gadget
  !this.lstAppWorlds.refresh()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectWorld
--
-- Description: Callback for select Model Import world
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       ASSOWL element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectWorld()

  -- Set Application Data World to current selection
  !selection  = !this.lstAppWorlds.selection().dbRef()
  handle ANY
    -- Handle invalid DBREF
    !this.loadAppWorlds()
    return
  elsehandle NONE
  endhandle

  -- Set Application Data World to selected entry
  !this.apdWorld = !selection

  -- Load groups
  !this.loadAppGroups()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAppGroups
--
-- Description: Load Model Import Groups for the current world
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAppGroups()

  !this.loadAppGroups(!this.apdWorld)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAppGroups
--
-- Description: Load Model Import Groups for the given world
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       APPLDW element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAppGroups(!appDataWorld is DBREF)

  -- If there are no Application Data World defined, then go no further
  if(!this.apdWorld.unset()) then
    return
  endif

  -- Set root of tree to the selected world
  !this.modelImportExplorer.resetRoot(!this.apdWorld.string())

  -- Go to last selected item if in this world
  if( not badref(!this.explorerSelected)) then
    if( !this.explorerSelected.ownlst.findFirst(!appDataWorld).set() ) then
      !this.treeSelect(!this.explorerSelected)
      !this.modelImportExplorer.selectElement(!this.explorerSelected.string())
    else
      !this.treeSelect(!appDataWorld)
      !this.modelImportExplorer.selectElement(!appDataWorld.string())
    endif
  else
    !this.treeSelect(!appDataWorld)
    !this.modelImportExplorer.selectElement(!appDataWorld.string())
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      switchFrameLocation
--
-- Description: Show panel to import a model into an element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchFrameLocation(!value is REAL)

  -- Set radio toggle
  !this.frameLocation.val              = !value
  !flag = !value.eq(1)

  -- Swap frames
  !this.frameImportToElement.visible   = !flag
  !this.frameImportToAppWorld.visible  = !flag.not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      switchModifyTree
--
-- Description: Switches between tree tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Task description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchModifyTree(!task is STRING)

  -- Initialise
  !this.browseForFilesFrame.visible     = false
  !this.frameModifyHierarchy.visible    = false
  !this.modifyHierarchyAttr.visible     = false

  -- Show panel for hierarchy tasks
  if(!task.eq('tasks')) then
    !this.frameModifyHierarchy.visible  = true
    !this.butAreaCreate.active = false
    !this.butGroupCreate.active = false
    !this.butGroupModify.active = false
    !this.butGroupDelete.active = false
    if (!this.apdWorld.set()) then
      !this.modelImportExplorer.resetRoot(!this.apdWorld.name)
      !this.modelImportExplorer.selectElement(!this.apdWorld.name)
    endif
    -- Show panel for modifying attributes
  elseif(!task.eq('attributes')) then
    !this.modifyHierarchyAttr.visible   = true
    !this.loadAttributesToModify(!this.explorerSelected)
  -- Show panel for selecting import file
  else
    !this.browseForFilesFrame.visible   = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCurrentElement
--
-- Description: Set the current element to import into
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrentElement()
  !this.textSetCurrentElement.val = !!ce.name
  !this.validateCurrentElement()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validateCurrentElement
--
-- Description: Validate current element textbox
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Returns true if element is valid
--
------------------------------------------------------------------------
define method .validateCurrentElement() is BOOLEAN

  -- Initialise Variables
  !this.butGroupImport1.active  = false
  !this.butGroupImport.active   = false
  !this.currentElement          = object DBREF()

  -- Get value from gadget
  !name                         = !!checkName(!this.textSetCurrentElement.val, 'OLD')

  if(!name.unset()) then
    return false
  endif

  -- Element
  !element                      = !name.dbRef()

  -- Check the element is of the right type
  if(!element.type inset('SITE','ZONE','EQUI','VOLM')) then
    !this.currentElement        = !element
    !this.textSetCurrentElement.val = !this.currentElement.name

  -- Invalid type
  else
    !!alert.error('Invalid element type, please select a Site, Zone, Equipment or Volume element.')
    !this.textSetCurrentElement.val = ''
    return false

  endif

  -- Make "Import" active
  !this.setImportButton()

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setModifyCurrentElement
--
-- Description: Set the current element to modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setModifyCurrentElement(!gadget is GADGET, !dummy is STRING)

  if(!gadget eq !this.btnCE) then
    if( !!ce.type eq 'ARCHIV' ) then
      -- navigate to GENPRI
      OWNER
    endif
    !this.textCurrentElement.val  = !!ce.name
    !this.validateModifyCurrentElement( !this.textCurrentElement, '')
  elseif(!gadget eq !this.butCE)then
    !this.textBeneathElement.val  = !!ce.name
    !this.validateModifyCurrentElement( !this.textBeneathElement, '')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validateModifyCurrentElement
--
-- Description: Validate modify current element textbox
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateModifyCurrentElement(!gadget is GADGET, !dummyString is STRING)

  -- Initialise Variables
  !this.currentModifyElement    = object DBREF()

  -- Get value from gadget
  !name                         = !!checkName(!gadget.val, 'OLD')

  if(!name.unset()) then
    return
  endif

  -- Element
  !element  = !name.dbRef()

  if(!gadget eq  !this.textCurrentElement) then

    -- Check if the element is ok
    if (NOT badref(!element)) then
      -- Display the current element's name in  the adjacent textbox
      !includeVolume                = object VOLUME(!element)
      if( !includeVolume.unset() ) then
        !!alert.error('The element selected does not have a volume.')
      endif
      !this.includeVolume           = !includeVolume
      !gadget.val  = !name
      !this.currentModifyElement    = !element
      !this.includeVolumeRefresh(!this.includeVolume)
    else
      !this.includeVolume           = object VOLUME()
    endif

  elseif(!gadget eq !this.textBeneathElement) then
      !gadget.val  = !name
      !this.currentModifyElement    = !element
  endif


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:   browse
--
-- Description: Display file browser to select import model file
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browse()

  -- Use the namespace of the file browser
  using namespace 'Aveva.Pdms.Presentation'

  -- Setup and display a file browser to import a model file
  !fileBrowser        = object PMLFILEBROWSER()
  !directory          = '!this.homeDirectory'
  !seedFile           = ' '
  !title              = 'Select file to import'
  !extensionString    = 'Step files (*.stp)|*.stp|All files (*.*)|*.*'
  !fileBrowser.show(!directory, !seedFile, !title, true ,!extensionString , 1)
  !importFile         = !fileBrowser.file()

  -- Load gadget with file name
  !this.txtFiles1.val = !importFile

  -- Validate pathname
  !this.validateFilePath(!this.txtFiles1, 'BROWSER')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validateFilePath
--
-- Description: Validate import file path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateFilePath(!gadget is GADGET, !dummyString is STRING)

  -- Initialise Variables
  !this.butGroupImport1.active  = false
  !this.butGroupImport.active   = false
  !this.importFile              = object FILE()

  -- Get passed filename from gadget
  !importFile = object FILE(!gadget.val)

  -- Handle null entry cleanly without annoying the user
  if(!importFile.unset()) then
    return
  endif

  -- Check that file exists
  if(NOT !importFile.exists()) then
    !!alert.warning('File not found -Please select a valid file to import')
    return
  endif

  -- Update the adjacent textbox to show the selected file does both gadgets
  --  so we can flip between the storage areas without losing the filename
  !this.importFile    = !importFile
  !this.txtFiles1.val = !importFile.fullname()
  !this.txtFiles.val  = !importFile.fullname()

  -- Make "Import" active
  !this.setImportButton()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setImportButton
--
-- Description: Set the "Import" button state depending on current settings.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setImportButton()

  -- Make "Import" active
  !this.butGroupImport1.active  = !this.currentElement.set().and(!this.importFile.set())
  !this.butGroupImport.active   = !this.importFile.set().and(!this.apdGroup.set())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      toggleSubeLevelOption
--
-- Description: Set the "Create SUBE level" state depending on import type.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleSubeLevelOption( !isFirst is BOOLEAN)

  !isEqui = false
  if( !isFirst) then
    !isEqui = !this.optImportType1.selection() eq 'EQUI'
    !this.optImportType.val    = !this.optImportType1.val
    !this.togSubeLevel1.active = !isEqui
    !this.togSubeLevel.active  = !this.togSubeLevel1.active
  else
    !isEqui = !this.optImportType.selection() eq 'EQUI'
    !this.optImportType1.val   = !this.optImportType.val
    !this.togSubeLevel.active  = !isEqui
    !this.togSubeLevel1.active = !this.togSubeLevel.active
  endif
  if( not !isEqui) then
    !this.togSubeLevel.val   = false
    !this.togSubeLevel1.val  = false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      toggleTessCacheOption
--
-- Description: Set the "Tolerance" state depending on current settings.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleTessCacheOption( !isFirst is BOOLEAN)

  if( !isFirst) then
    !this.togTessCache.val = !this.togTessCache1.val
    !this.txtTessTol1.active  = !this.togTessCache1.val
    !this.txtTessTol.active   = !this.txtTessTol1.active
  else
    !this.togTessCache1.val = !this.togTessCache.val
    !this.txtTessTol.active  = !this.togTessCache.val
    !this.txtTessTol1.active   = !this.txtTessTol.active
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:   importIntoElement
--
-- Description: Import model into current element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .importIntoElement()

  -- Element to import into
  !importElement    = object DBREF()

  -- Model file to import
  !importFile       = !this.importFile

  -- Import Type
  !importType       = !this.optImportType.selection()

  -- Import into current element (Importing from first panel)
  if(!this.toggleElement.val) then
    !importElement  = !this.currentElement
  -- Import into Application Data World (Importing from second panel)
  else
    !importElement  = !this.apdGroup
  endif

  -- Import SUBEs beneath EQUI
  !importSubes = !this.togSubeLevel.val

  -- SUBEs cannot be created beneath existing VOLM, stop here
  if( (!importElement.type eq 'VOLM') and ( (!importType eq 'SUBE') or !importSubes ) ) then
    !!alert.warning('Current element and import type incompatible.')
    return
  endif
  -- Take into account whether or not to save nozzles and
  -- check if overwriting element, if so check if the users wishes to continue
  if (not !this.clearElement(!importElement, !this.togNozzles1.val)) then
     return
  endif

  -- Setup log file path
  !logFile          = object FILE('%PDMSUSER%/'& !importFile.entry().before('.') & '.txt')

  -- Tesselation cache tolerance
  !importTessTol    = object REAL()
  !importTessTol    = 0.0
  if( !this.togTessCache.val) then
    if( !this.txtTessTol.val.string().length() le 0) then
      !this.txtTessTol.val = 5.0mm
      !this.txtTessTol1.val = 5.0mm
    endif
    !importTessTol = !this.txtTessTol.val.dbunits().value()
    if( !importTessTol lt 0.1) then
      !importTessTol = 0.1
    endif
    if( !importTessTol gt 20) then
      !importTessTol = 20
    endif
  endif

  -- Import command
  if( !importSubes) then
    !importSubeString = 'SUB'
    if (!this.importToNewElement) then
      IMP "$!<importFile>" TO $!<this.newElement> AS $!<importType> $!<importSubeString> LOG "$!<logFile>" CTOL $!<importTessTol>
      handle (61,200)
        -- Only warn user if licence expiring
        !!alert.warning(!!error.text)
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
    else
      IMP "$!<importFile>" TO $!<importElement> AS $!<importType> $!<importSubeString> LOG "$!<logFile>" CTOL $!<importTessTol>
      handle (61,200)
        -- Only warn user if licence expiring
        !!alert.warning(!!error.text)
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
    endif
  else
    if (!this.importToNewElement) then
      IMP "$!<importFile>" TO $!<this.newElement> AS $!<importType> LOG "$!<logFile>" CTOL $!<importTessTol>
      handle (61,200)
        -- Only warn user if licence expiring
        !!alert.warning(!!error.text)
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
    else
      IMP "$!<importFile>" TO $!<importElement> AS $!<importType> LOG "$!<logFile>" CTOL $!<importTessTol>
      handle (61,200)
        -- Only warn user if licence expiring
        !!alert.warning(!!error.text)
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      explorerSelect
--
-- Description: Explorer select event handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Explorer select data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .explorerSelect(!data is ARRAY)

  !element      = object DBREF(!data[0])
  !this.treeSelect(!element)

endmethod

-----------------------------------------------------------------------
--
-- Method:      treeSelect
--
-- Description: Action for selection of APPLDA and APPDAR
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element selected in the tree-view
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .treeSelect(!element is DBREF)

  !type[1]       = 'APPLDA'
  !this.apdGroup = !!dtbOwnerOfTypes(!element,!type)
  !type[1]       = 'APPDAR'
  !this.apdArea  = !!dtbOwnerOfTypes(!element,!type)

  -- Record actual selection
  !this.explorerSelected        = !element

  -- Enable and disable "modify hierarchy" link labels depending
  -- on what is selected in the tree view
  !this.butAreaCreate.active    = !this.apdWorld.set().or(!this.apdArea.set()).or(!this.apdGroup.set())
  !this.paraCreateIcon2.active  = !this.apdWorld.set().or(!this.apdArea.set()).or(!this.apdGroup.set())
  !this.butGroupCreate.active   = !this.apdArea.set()
  !this.paraCreateIcon3.active  = !this.apdArea.set()
  !this.butGroupDelete.active   = !this.apdArea.set()
  !this.paraDeleteIcon2.active  = !this.apdArea.set()
  !this.paraModifyIcon2.active  = !this.apdArea.set().or(!this.apdGroup.set())
  !this.butGroupModify.active   = !this.apdArea.set().or(!this.apdGroup.set())

  -- Make "Import" active
  !this.setImportButton()

  -- Update attribute modification frame if it is being shown
  if (!this.modifyHierarchyAttr.visible) then
    !this.loadAttributesToModify(!this.explorerSelected)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:   navigate
--
