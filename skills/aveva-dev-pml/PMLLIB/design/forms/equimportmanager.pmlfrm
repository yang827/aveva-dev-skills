------------------------------------------------------------------------
--
-- Method:      highlight
--
-- Description: Highlight element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        Reference of element to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight(!elementToHighlight is DBREF)

  if( badref(!elementToHighlight) ) then
    return
  endif

  -- Highlight element
  ENHANCE $!<elementToHighlight>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      highlight
--
-- Description: Highlight elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      ARRAY      Collection of elements to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight(!elementsToHighlight is ARRAY)

  do !item values !elementsToHighlight
    !element = !item[2].dbRef()
    -- Highlight element
    !this.highlight(!element)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unHighlight
--
-- Description: Unhighlight element
--
-- Method Type: Function/Procedure
