-- End of method

------------------------------------------------------------------------
--
-- Method:      createAppArea
--
-- Description: Create Model Import area (APPDAR)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createAppArea()

  -- Check if the current application data world is ok
  if( badref( !this.apdWorld ) ) then
    !!alert.error('Application Data World not found')
    return
  endif

  -- Save a reference to the current element
  !saveRef = !!ce

  -- Create new Area under an existing area
  if( badref( !this.apdArea ) ) then
    -- Create as first element under the current World
    !!ce     = !this.apdWorld
    NEW APPDAR
    handle any
      !!alert.error( !!error.text )
      !!ce = !saveRef
      return
    endhandle
  else
    -- Create under current area
    !!ce = !this.apdArea
    NEW APPDAR
    handle any
      !!alert.error( !!error.text )
      !!ce = !saveRef
      return
    endhandle
  endif

  -- Make the new application data area the current element
  !this.apdArea   = !!ce
  -- Select the new element in the tree
  !this.treeSelect(!!ce)

  -- Restore the current element
  !!ce = !saveRef

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createAppGroup
--
-- Description: Create Model Import group (APPLDA)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createAppGroup()

  -- Check if the current application data area is ok, as this will be the owner
  if( badref( !this.apdArea ) ) then
    !!alert.error('Application Data Area not found')
    return
  endif

  -- Save a reference to the current element
  !saveRef = !!ce

  -- Create as first element under the current application data area
  !!ce = !this.apdArea
  NEW APPLDA
  handle any
    !!alert.error( !!error.text )
    !!ce = !saveRef
    return
  endhandle

  -- Make the new application data item the current element
  !this.apdGroup = !!ce
  -- Select the new element in the tree
  !this.treeSelect(!!ce)

  -- Restore the current element
  !!ce = !saveRef

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyAttributes
--
-- Description: Modify attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyAttributes()

  -- Show attribute panel
  !this.switchModifyTree('attributes')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteItem
--
-- Description: Perform delete action for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteItem()

  -- Check that the currently selected element is the tree is ok
  if( badref(!this.explorerSelected) ) then
    !!alert.error('Selected element not found')
    return
  endif

  -- Save the owner of item to delete
  !owner   = !this.explorerSelected.owner
  -- Save a reference to the current element
  !saveRef = !!ce

  -- Delete current element
  !!ce     = !this.explorerSelected
  !selected = !!ce
  !!deleteCe()

  -- Restore the current element
  !!ce=!saveRef
  handle any
    -- Handle as it may have been deleted
  endhandle

  if (!selected.badref()) then
   -- Select the owner of the deleted item in the tree
   !this.modelImportExplorer.selectElement(!owner.name)
   !this.treeSelect(!owner)
  else
   !this.modelImportExplorer.selectElement(!selected.name)
   !this.treeSelect(!selected)
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      clearElement
--
-- Description: If the root element is either a EQUI or VOLM element
-- deletes all its members optionally keeping any nozzle elements.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Element to delete underneath
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearElement(!rootElement         is DBREF, $
                            !keepNozzles         is BOOLEAN) is BOOLEAN

  -- Set import to new element flag to false as default
  !this.importToNewElement = false

  -- If the point of import is an Application Data Group or Zone
  -- we need to check if there is an equipment or volume element
  -- that exists with the same name of the file that we are importing
  !selType = !this.optImportType.selection()

  if(!rootElement.type inset('APPLDA','ZONE')) then
    -- Check if there is anything under the root element
    if(!rootElement.members.size() gt 0) then
      if( !selType ne 'SUBE') then
        -- Get the selected import type from the option gadget, either EQUI or VOLM
        !importType = object ARRAY()
        !importType.append(!selType)

        -- Find all members of the root element of the selected import type
        !findMembers = object COLLECTION()
        !findMembers.types(!importType)
        !findMembers.scope(!rootElement)
        !members = !findMembers.results()

        -- Get the name of the file to be imported to check against the names
        -- of the items that exist below the root element
        !fileName = !this.importFile.entry().before('.')

        -- Loop round each member found to see if any names match
        do !item values !members
          -- Name could be in the form  '\transformer' or '\transformer__00'
          !name  = !item.name.after('/')
          !name2 = !name.before('__')
          if (!fileName eq !name or !fileName eq !name2) then
            -- A match is found so set the root element to EQUI or VOLM element
            -- with the matching name.

            !rootElement = !item
          endif
        enddo
      endif
    else
      -- No elements under the root element, so return true
      return true
    endif
  endif


  -- If the point of import is not a EQUI of VOLM then we are not
  -- overwriting in which case do nothing
  if ((!rootElement.type ne 'EQUI') and (!rootElement.type ne 'VOLM')) then
     return true
  endif

  -- Get list of rootelements members
  !nozzles      = !!collectAllFor('NOZZ', '', $!rootElement)
  !subEquipment = !!collectAllFor('SUBE', '', $!rootElement)

  -- If keep nozzles and create sub-equipment
  if (!keepNozzles and !this.togSubeLevel.val) then
    -- If nozzles exist and sub-equipment exists
    if (!nozzles.size() gt 0 and !subEquipment.size() gt 0) then
      !message = 'Overwrite ' + !rootElement.name + ' saving existing nozzles?'
    -- If nozzles exist and no sub-equipment exists
    elseif (!nozzles.size() gt 0 and !subEquipment.size() eq 0) then
      !message = 'Overwrite ' + !rootElement.name + '. Import into new sub-equipment for ' + !rootElement.name + ' saving existing nozzles?'
    -- If no nozzles exist and sub-equipment exists
    elseif (!nozzles.size() eq 0 and !subEquipment.size() gt 0) then
      !message = 'Overwrite existing sub-equipment for ' + !rootElement.name + '?'
    -- if no nozzles exist and no sub-equipment exists
    elseif (!nozzles.size() eq 0 and !subEquipment.size() eq 0) then
      !message = 'Overwrite ' + !rootElement.name + '. Import into new sub-equipment for ' + !rootElement.name + '?'
    endif
  -- If keep nozzles but not create sub-equipment
  elseif (!keepNozzles and !this.togSubeLevel.val.not()) then
    -- If nozzles exist
    if (!nozzles.size() gt 0) then
      !message = 'Overwrite ' + !rootElement.name + ' saving existing nozzles?'
    -- If nozzles dont exist
    elseif (!nozzles.size() eq 0) then
      !message = 'No nozzles exist, Overwrite ' + !rootElement.name + '?'
    endif
  -- if create sub-equipment but not keep nozzles
  elseif (!this.togSubeLevel.val and !keepNozzles.not()) then
    -- If sub-equipment exists
    if (!subEquipment.size() gt 0) then
      !message = 'Overwrite existing sub-equipment for ' + !rootElement.name + '?'
    -- If sub-equipment dont exist
    elseif (!subEquipment.size() eq 0) then
      !message = 'Overwrite ' + !rootElement.name + '. Import into new sub-equipment for ' + !rootElement.name + '?'
    endif
  -- if not keep nozzles and not create sub-equipment
  elseif (!keepNozzles.not() and !this.togSubeLevel.val.not()) then
        !message = 'Overwrite ' + !rootElement.name + '?'
  endif

  -- Check that members of root element can be deleted
  !members = !rootElement.mem
  !deletionList = ARRAY()
  do !item values !members
    if (!!dbrefDelete(!item, '')) then
      -- Add to deletion list
      !deletionList.append(!item)
    endif
  enddo

  -- If user wants to overwrite existing EQUI then delete existing members - dependant on if keep nozzles and if create sub-equipment
  if (!!alert.confirm(!message) eq 'YES') then
    do !item values !deletionList
      !!ce = !item
      !type = !!ce.type
      if (!type eq 'NOZZ' and !keepNozzles) then
        skip
      elseif (!type eq 'SUBE' and !keepNozzles) then
            !sub = !!ce
            !members = !!collectMembersOf(!!ce, '')
            do !mem values !members
              !!ce = !mem
              if (!mem.type eq 'NOZZ') then
                skip
              else
                DELETE $!mem.type
              endif
                !memb = !!collectMembersOf(!sub, '')
              if (!memb.size() eq 0) then
                !!ce = !sub
                DELETE $!!ce.type
              endif
            enddo
      else
          DELETE $!type
        endif
      enddo
  else
    if (!this.optImportType1.selection(|RTEXT|) eq 'EQUI') then
      -- If user does not want to overwrite existing EQUI, give them the option to create new EQUI and import model into new EQUI element
      !newEqui = !!alert.confirm('Create EQUI for imported model?')
      if (!newEqui eq 'YES') then
        !fileName = !this.importFile.entry().before('.')
        !fileName = '/' + !fileName + '-MEI-IMPORT'
        !indexString = ''
        NEW EQUI
        do !index from 1 to 1000
          !!ce.name = !fileName + !indexString
          handle none
            break
          elsehandle any
            !indexString = !index.string()
          endhandle
        enddo
        !this.newElement = !!ce
        !this.importToNewElement = true
      else
        return false
      endif
    elseif (!this.optImportType1.selection(|RTEXT|) eq 'VOLM') then
          -- if user does not want to overwrite existing VOLM, give them the option to create new VOLM and import model into new VOLM element
          !newVolm = !!alert.confirm('Create VOLM for imported model?')
          if (!newVolm eq 'YES') then
            !fileName = !this.importFile.entry().before('.')
            !fileName = '/' + !fileName + '-MEI-IMPORT'
            !indexString = ''
            NEW VOLM
            do !index from 1 to 1000
              !!ce.name = !fileName + !indexString
              handle none
                break
              elsehandle any
                !indexString = !index.string()
              endhandle
            enddo
            !this.newElement = !!ce
            !this.importToNewElement = true
          else
            return false
          endif
    endif
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadAppGroups
--
-- Description: Reset model hierarchy and select the given element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       APPDAR or APPLDA element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadAppGroups(!element is DBREF)

  -- Set application data area (APPDAR) and data item (APPLDA)
  if(!element.hardType.eq('APPDAR')) then
    !this.apdArea   = !element
    !this.apdGroup  = object DBREF()
  elseif(!element.hardType.eq('APPLDA')) then
    !this.apdArea   = !element.owner
    !this.apdGroup  = !element
  endif

  -- Select given element
  !this.modelImportExplorer.selectElement(!element.string())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyWorldAttributes
--
-- Description: Modify Model Import world attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyWorldAttributes()

  -- Select the application data world in the tree
  !this.modelImportExplorer.selectElement(!this.apdWorld.string())
  -- Show attribute panel
  !this.switchModifyTree('attributes')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createAppWorld
--
-- Description: Create Model Import world
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createAppWorld()

  -- Save a reference to the current element so it can
  -- be restored at the end of if there is a problem
  !saveRef = !!ce

  -- Create a new Application Data World
  NEW APPLDW
  handle any
    !!alert.error( !!error.text )
    !!ce = !saveRef
    return
  endhandle

  --Set the purpose to "Mechanical Import"
  PURP MIMP

  -- Set the Application Data World member to the current element
  !this.apdWorld = !!ce

  -- Check that the Application Data World is ok before proceeding
  -- to create the rest of the hierarchy
  if( badref( !this.apdWorld ) ) then
    !!alert.error('Application Data World not found')
    !this.initialise()
    return
  endif

  -- Create an Application Data Area beneath the Application Data World
  NEW APPDAR
  handle any
    !!alert.error( !!error.text )
    !!ce = !saveRef
    return
  endhandle

  -- Set the Application Data Area member to the current element
  !this.apdArea   = !!ce

  -- Check the Application Data Area is ok before proceeding
  if( badref( !this.apdArea ) ) then
    !!alert.error('Application Data Area not found')
    !this.loadAppGroups()
    return
  endif

  -- Create an Application Data Item beneath the Application Data Area
  NEW APPLDA
  handle any
    !!alert.error( !!error.text )
    !!ce = !saveRef
    return
  endhandle

   -- Set the Application Data Item to the current element
  !this.apdGroup   = !!ce

   -- Load Application Data World list
  !this.loadAppWorlds()
  -- Select current world
  !this.selectWorld()
  -- Select the Application Data Item in the tree, so it is selected
  -- ready to import into
  !this.treeSelect(!!ce)
  !this.modelImportExplorer.selectElement(!this.apdGroup.string())

   -- Restore the current element
  !!ce = !saveRef

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteAppWorld
--
-- Description: Perform delete action for selected world element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteAppWorld()

  -- Delete current element
  !saveRef = !!ce
  !!ce = !this.apdWorld
  handle any
    !!alert.warning('No Model Import World selected')
    return
  endhandle

  !!deleteCe()
  if( badref(!this.apdWorld) ) then
    -- Delete was successful - refresh
    !this.apdWorld = object DBREF()
    -- Reload Application Data Worlds
    !this.loadAppWorlds()
    -- Select world
    !this.selectWorld()
  endif
  !!ce=!saveRef
  handle any
  endhandle

  -- Set gadgets state
  !active = (!this.lstAppWorlds.val ne 0)
  !this.butAreaCreate.active  = !active
  !this.butGroupCreate.active = !active
  !this.butGroupModify.active = !active
  !this.butGroupDelete.active = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAttributesToModify
--
-- Description: Load attributes into gadgets to modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Reference of element to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAttributesToModify(!element is DBREF)

 -- Check if element is ok
 if( badref(!element) ) then
    return
 else
   -- Display elements name in gadget
   if( !element.isNamed ) then
     !this.txtAttributeName.val    = !element.namn
   else
     !this.txtAttributeName.val        = ''
   endif

   !this.savedName              = !element.namn

   -- Display description and function in gadgets
   if( !element.type inset('ARCHIV','BOX','CYLI','GENCUR','GENPRI')) then
      !this.txtAttributeDescription.visible  = false
      !this.txtAttributeFunction.visible     = false
    else
      -- Description
      !this.txtAttributeDescription.visible  = true
      !this.txtAttributeDescription.val      = !element.description
      -- Function
      !this.txtAttributeFunction.visible     = true
      !this.txtAttributeFunction.val         = !element.function
    endif

  endif

  endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      applyAttributes
--
-- Description: Save changes to attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyAttributes()

  -- Add undo mark
  !undo = object UNDOABLE()
  !undo.description('Apply attribute changes')
  !undo.undoAction('!!equImportManager.undoRedoAction()')
  !undo.redoAction('!!equImportManager.undoRedoAction()')
  !undo.add()

  -- Check that user can update this element
  if( not !!dbRefUpdatable(!this.explorerSelected) ) then
     !!alert.error ('Unable to modify attribute: ' + !!error.text)
    return
  endif

  !success = true
  if( !this.txtAttributeName.val.unset() ) then
    !name = ''
  else
    !name = !this.txtAttributeName.val.trim()
  endif
  if( !name.empty() ) then
    -- Have to unname the element
    !saveRef = !!ce
    !!ce     = !this.explorerSelected
    UNNAME
    handle any
    endhandle
    !!ce = !saveRef
  else
    !name = '/' + !name
    !this.explorerSelected.name      = !name
    handle any
      !!alert.error(!!error.text)
      !success = false
    endhandle
  endif

  if( NOT !this.explorerSelected.type inset('ARCHIV','BOX','CYLI','GENCUR','GENPRI')) then
    !this.explorerSelected.description = !this.txtAttributeDescription.val
    handle any
      !!alert.error('Description: ' + !!error.text)
      !success = false
    endhandle
    !this.explorerSelected.function    = !this.txtAttributeFunction.val
    handle any
      !!alert.error('Function: ' + !!error.text)
      !success = false
    endhandle
  endif

  if( !success ) then
    -- Reload application data worlds
    !this.loadAppWorlds()
    -- Select world
    !this.selectWorld()
    -- Reload tree
    !this.reloadAppGroups(!this.explorerSelected)
    --Reload modify grid in case any elements being displayed have had their names changed
    !this.populateModifyGrid(!this.savedElementsToModify)
  endif

   -- End of undo
  !undo.endUndoable()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget being checked
--    2   R      STRING      Original name to be restored if necessary
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val eq !originalName) then
    return
  endif
  if('/' + !gadget.val eq !originalName) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      sliderCallback
--
-- Description: parameter change callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      ANY         Slider gadget that raised the event
--    2    R      STRING      Action required
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sliderCallback(!gadget        is ANY, $
                              !action        is STRING)


   -- Check if  volume is set, fall out if not
   if (!this.includeVolume.unset()) then
      return
   endif

   -- Stopped moving the slider reset
   if (!action eq 'STOP') then
      !gadget.val      = 0
      !this.startValue = object REAL()
   endif

   -- Which slider is being dragged
   if (!gadget eq !this.xLengthSlider) then
      if (!action eq 'START') then
         !this.startValue = !this.xLength.val
      elseif (!action eq 'MOVE' and !this.startValue.set()) then
         !this.xLength.val   = !this.startValue + !gadget.val
         !this.xLength.refresh()
      endif

   elseif (!gadget eq !this.yLengthSlider) then
      if (!action eq 'START') then
         !this.startValue = !this.yLength.val
      elseif (!action eq 'MOVE' and !this.startValue.set()) then
         !this.yLength.val   = !this.startValue + !gadget.val
         !this.yLength.refresh()
      endif


   elseif (!gadget eq !this.zLengthSlider) then
      if (!action eq 'START') then
         !this.startValue = !this.zLength.val
      elseif (!action eq 'MOVE' and !this.startValue.set()) then
         !this.zLength.val   = !this.startValue + !gadget.val
         !this.zLength.refresh()
      endif


   elseif (!gadget eq !this.xPositionSlider) then
      if (!action eq 'START') then
         !this.startValue = !this.xPosition.val
      elseif (!action eq 'MOVE' and !this.startValue.set()) then
         !this.xPosition.val = !this.startValue + !gadget.val
         !this.xPosition.refresh()
      endif


   elseif (!gadget eq !this.yPositionSlider) then
      if (!action eq 'START') then
         !this.startValue = !this.yPosition.val
      elseif (!action eq 'MOVE' and !this.startValue.set()) then
         !this.yPosition.val = !this.startValue + !gadget.val
         !this.yPosition.refresh()
      endif


   elseif (!gadget eq !this.zPositionSlider) then
      if (!action eq 'START') then
         !this.startValue = !this.zPosition.val
      elseif (!action eq 'MOVE' and !this.startValue.set()) then
         !this.zPosition.val = !this.startValue + !gadget.val
         !this.zPosition.refresh()
      endif

   endif

   -- Recalculate the boundary
   !this.includeVolume.from.east  = !this.xPosition.val -(!this.xLength.val / 2)
   !this.includeVolume.to.east    = !this.xPosition.val +(!this.xLength.val / 2)

   !this.includeVolume.from.north = !this.yPosition.val -(!this.yLength.val / 2)
   !this.includeVolume.to.north   = !this.yPosition.val +(!this.yLength.val / 2)

   !this.includeVolume.from.up    = !this.zPosition.val -(!this.zLength.val / 2)
   !this.includeVolume.to.up      = !this.zPosition.val +(!this.zLength.val / 2)

   !this.includeVolumeRefresh(!this.includeVolume)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      includeVolumeRefresh
--
-- Description: Refresh Volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .includeVolumeRefresh(!volume is VOLUME)

   if(!volume.unset()) then
     return
   endif
   -- Get positions
   !this.xPosition.val = !volume.box().position.east
   !this.yPosition.val = !volume.box().position.north
   !this.zPosition.val = !volume.box().position.up

   !this.xLength.val   = !volume.box().xLength
   !this.yLength.val   = !volume.box().yLength
   !this.zLength.val   = !volume.box().zLength

   -- Draw volume
   !this.includeVolumeDraw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      includeVolumeDraw
--
-- Description: Draw current volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .includeVolumeDraw()

   -- Initialise Variables
   !box  = !this.includeVolume.box()
   handle ANY
      !box = object BOX()
   endhandle

   -- Draw volume
   if (not !box.unset()) then
      !gBox = object GPHBOX(!box)
      !gBox.draw(!this.aidVolume)
   endif

   !!gph3ddesign1.view.refresh()
   handle ANY
   endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      toggleSelectionChanged
--
-- Description: Toggle selection changed event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Gadget that raised the event
--    2    R     STRING      Type of event
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .toggleSelectionChanged(!toggle is GADGET, !event is STRING)

  if(!toggle eq !this.togInVolume) then
    if(!event eq 'SELECT') then
      !this.textCurrentElement.active  = true
      !this.btnCE.active               = true
      !this.positionSliderFrame.active = true
      !this.extentSliderFrame.active   = true
      -- Grey out inactive gadgets
      !this.textBeneathElement.active  = false
      !this.butCE.active               = false

    endif

  elseif(!toggle eq !this.togBeneathElement)then
     if(!event eq 'SELECT') then
      !this.textBeneathElement.active  = true
      !this.butCE.active               = true
       -- Grey out inactive gadgets
      !this.textCurrentElement.active  = false
      !this.btnCE.active               = false
      !this.positionSliderFrame.active = false
      !this.extentSliderFrame.active   = false
      -- Clear aid graphics
       !this.clearVolumeDraw()
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      findElements
--
-- Description: Find elements to populate modify grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findElements()

  if(!this.togInVolume.val eq true) then
    !this.findElementsWithinVolume()
  elseif(!this.togBeneathElement.val eq true) then
    !this.findElementsBeneath()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      findElementsWithinVolume
--
-- Description: Find elements within volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findElementsWithinVolume()

  -- Check current element is ok
  if(!this.currentModifyElement.unset()) then
    return
  endif

  -- Get the current element from the text gadget
  !name  = !this.textCurrentElement.val
  !currentElement = !name.dbRef()

  if (!this.includeVolume.unset()) then
   !collect = ARRAY()
  else
  -- Collect all listed element types within the chosen volume
    var !collect COLLECT ALL (BOX CYLI EQUI GENCUR GENPRI NOZZ SUBE) EXCLUSIVE WITHIN $!this.includeVolume.from TO $!this.includeVolume.to FOR $!currentElement
  endif

  -- Let user know if no items are found
  if(!collect.unset()) then
    !!alert.message('No items found!')
  endif

  -- Populate grid with results
  !this.populateModifyGrid(!collect)

 endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      findElementsBeneath
--
-- Description: Find elements beneath current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findElementsBeneath()

   -- Check current element is ok
  !this.validateModifyCurrentElement(!this.textBeneathElement,'')
  if(!this.currentModifyElement.unset()) then
    return
  endif

  -- Get elements members
  !members = !this.currentModifyElement.members

  -- List of elements found
  !collect = object ARRAY()

  -- Loop round members of the current element and only add if they are the right type
  do !item values !members
    if(!item.type inset('BOX','CYLI','EQUI','GENCUR','GENPRI','NOZZ','SUBE')) then
      !collect.append(!item.string())
    endif
  enddo

  if(!this.currentModifyElement.type.eq('GENPRI')) then
    !collect.append(!this.currentModifyElement.string())
  endif

   -- Let user know if no items are found
  if(!collect.unset()) then
    !!alert.message('No items found!')
  endif

  -- Populate grid with results
  !this.populateModifyGrid(!collect)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      .populateModifyGrid()
--
-- Description: Populate modify grid with elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateModifyGrid(!elements is ARRAY)


  !index = 1
  -- Rows to add to the grid
  !rows = object ARRAY()

  -- Save a copy of what is in the grid
  !this.savedElementsToModify = !elements

  do !item values !elements

    !element = !item.dbRef()
    !volume  = object LOCALVOLUME(!element, !element)
    !box     = !volume.box()

    -- Add rows
    !row = object ARRAY()
    !row.append(!index.string(!!integerFMT))
    !row.append(!element.name)
    !row.append(!element.type)
    !row.append(!box.xLength.string(!!distanceFmt))
    !row.append(!box.yLength.string(!!distanceFmt))
    !row.append(!box.zLength.string(!!distanceFmt))

    -- Not all elements have obstruction and display level attributes
    if(!element.type inset('BOX','CYLI','GENCUR','GENPRI')) then

      if(!element.obstruction EQ 0) then
        !obstruction = 'None'
      elseif (!element.obstruction EQ 1) then
        !obstruction = 'Soft'
      else
        !obstruction = 'Hard'
      endif

      !row.append(!obstruction)
      !row.append(!element.level[1].string() + ' ' +!element.level[2].string())
    else
      !row.append('')
      !row.append('')
    endif

    !rows.append(!row)
    !index = !index + 1

  enddo

   -- Headings for table
  !headings = object ARRAY()
  !headings.append('No.')
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('X Length')
  !headings.append('Y Length')
  !headings.append('Z Length')
  !headings.append('Obstruction')
  !headings.append('Display Level')

  -- Table name
  !tableName = 'MEI import items'

  using namespace 'Aveva.Pdms.Presentation'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!tableName, !headings, !rows)
  !this.netModifyGrid.bindToDataSource(!ndsItems)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .reloadModifyGrid()
--
-- Description: Reload modify grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reloadModifyGrid()

  -- List of elements to update
  !elementsToUpdate = object ARRAY()

  !rows = !this.netModifyGrid.getRows()
  -- Loop round each row and get what elements to be updated
  do !element values !rows
    !elementsToUpdate.append(!element[2])
  enddo
  -- Populate modify grid
  !this.populateModifyGrid(!elementsToUpdate)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRepresentation
--
-- Description: Set the display level and obstruction value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRepresentation()

  -- Add undo mark
  !undo = object UNDOABLE()
  !undo.description('Set representation')
  !undo.undoAction('!!equImportManager.reloadModifyGrid()')
  !undo.redoAction('!!equImportManager.reloadModifyGrid()')
  !undo.add()

  -- Get the selected display level from the numerical input gadget
  !lowerLevel = !this.numLowerLevel.val
  !upperLevel = !this.numUpperLevel.val

   -- Get the selected obstruction value from the option gadget
  !obstruction = !this.optObstructionLevel.selection()

  -- Get the selected items in the grid
  !selectedItems = !this.netModifyGrid.getSelectedRowTags()

  -- Loop round all selected items in the grid
  do !element values !this.netModifyGrid.getSelectedRows()
    -- Check the element selected has the 'Level' attribute
    !elementType = !element[2].dbRef().type
    if(!elementType inset('BOX','CYLI','GENCUR','GENPRI')) then
      -- Apply the new display level value to the selected element
      !element[2].dbRef().level[1]  = !lowerLevel.real()
      !element[2].dbRef().level[2]  = !upperLevel.real()
       -- Apply the new obstruction value to the selected element
      !element[2].dbRef().obstruction  = !obstruction.real()
    endif
  enddo

  -- Refresh grid data
  !this.reloadModifyGrid()

  -- Re-select items, so user can carry out further actions with the same collection
  !this.netModifyGrid.setSelectedRowTags(!selectedItems)

  -- End of  undo
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createPrimitives
--
-- Description: Create primitives from the selected items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPrimitives()

  -- Add undo mark
  !undo = object UNDOABLE()
  !undo.description('Create Primitives')
  !undo.add()

  -- Get the primitive type from the option gadget
  !primitiveType = !this.optPrimitive.selection().real()

  -- Loop round all selected items in the grid
  do !item values !this.netModifyGrid.getSelectedRows()
    !element = !item[2].dbRef()
    !volume = object LOCALVOLUME(!element,!element)
    !box = !volume.box()
    -- Create cylinder
    if (!primitiveType eq 1) then
       !orientation         = 'Y is N and Z is U'
       !height              = !box.zLength
       !diameter            = !box.xLength

       !dimensions          = object ARRAY()
       !dimensions[1]       = !box.xLength
       !dimensions[2]       = !box.yLength
       !dimensions[3]       = !box.zLength

       -- Assume the smallest value to be the diameter unless the
       -- other two values are within 5% in which case take the RMS
       -- value of these.
       !differences         = object ARRAY()
       if (!dimensions[1] gt 0.0) then
       !differences[1]      = abs( 100 * (!dimensions[1] - !dimensions[2]) / !dimensions[1] )
       endif
       if (!dimensions[2] gt 0.0) then
       !differences[2]      = abs( 100 * (!dimensions[2] - !dimensions[3]) / !dimensions[2] )
       endif
       if (!dimensions[3] gt 0.0) then
       !differences[3]      = abs( 100 * (!dimensions[3] - !dimensions[1]) / !dimensions[3] )
       endif

       !minimumIndex        = !differences.sortedIndices()[1]

       if (!differences[!minimumIndex] lt 10.0) then
          -- If it is the X,Y are the diameter
          if     (!minimumIndex eq 1) then
             !orientation   = 'Y is N and Z is U'
             !height        = !box.zLength
             !diameter      = sqrt(((!box.xLength * !box.xLength) + (!box.yLength * !box.yLength)) / 2)

          -- If it is the Y,Z are the diameter
          elseif (!minimumIndex eq 2) then
             !orientation   = 'Y is N and X is U'
             !height        = !box.xLength
             !diameter      = sqrt(((!box.yLength * !box.yLength) + (!box.zLength * !box.zLength)) / 2)

          -- If it is the X,Z are the diameter
          else
             !orientation   = 'X is E and Y is U'
             !height        = !box.yLength
             !diameter      = sqrt(((!box.xLength * !box.xLength) + (!box.zLength * !box.zLength)) / 2)
          endif

       else
          !minimumDimension = !dimensions.sortedIndices()[1]
          !maximumDimension = !dimensions.sortedIndices()[3]

          !height           = !dimensions[!maximumDimension]
          !diameter         = !dimensions[!minimumDimension]
          if     (!minimumDimension eq 1) then
             !orientation   = 'X is E'

          elseif (!minimumDimension eq 2) then
             !orientation   = 'Y is E'

          else
             !orientation   = 'Z is E'

          endif

          if     (!maximumDimension eq 1) then
             !orientation   = !orientation & ' and X is U'

          elseif (!maximumDimension eq 2) then
             !orientation   = !orientation & ' and Y is U'

          else
             !orientation   = !orientation & ' and Z is U'
          endif
       endif

       NEW CYLI
          if (!element.isNamed) then
             !name          = !element.name +'.cylinder'
             NAME     $!name
             handle ANY
               -- Abort if the new element can't be named,
               -- this could be because it is too long.
             endhandle
          endif

          POSITION    $!box.position
          ORIENTATION $!orientation
          DIAMETER    $!diameter
          HEIGHT      $!height
       END
    else

       NEW BOX
          if (!element.isNamed) then
             !name          = !element.name +'.box'
             NAME     $!name
             handle ANY
               -- Abort if the new element can't be named,
               -- this could be because it is too long
             endhandle
          endif

          POSITION    $!box.position
          XLENGTH     $!box.xLength
          YLENGTH     $!box.yLength
          ZLENGTH     $!box.zLength
          ORI         $!box.orientation
       END
    endif
  enddo


  -- End of undo
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showElectricalComps
--
-- Description: Show the standard create nozzle form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showElectricalComps()
  show !!equelecchoose
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undoRedoAction
--
-- Description: Callback invoked when the undo redo action are invoked
-- to refresh the interface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoRedoAction()

   -- Check if the form is visible if not do nothing as when the form is
   -- opened it will re-initialise.  This should ensure there are no
   -- performance issues updating hidden forms
   if (!this.shown()) then
     -- Show Application Data Worlds frame
    !this.loadAppWorlds()
    -- Select world
    !this.selectWorld()
    -- Show selected frame
    !this.switchFrameLocation(!this.frameLocation.val)
   endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      validateTolerance()
--
-- Description: Validate tolerance text gadget, value should be no greater than 20mm
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateTolerance(!gadget is GADGET, !dummyString is STRING)

  !error = 'Tolerance range should be between 0.1mm and 20mm'
  if (!gadget.val gt 20mm) then
    !!alert.error(!error)
    !gadget.val = 20mm
  elseif (!gadget.val lt 0.1mm) then
    !!alert.error(!error)
    !gadget.val = 0.1mm
  elseif (!gadget.val lt 10mm) then
    !!alert.warning('Value entered is less than default, processing time will take longer.')
  endif

  if (!gadget eq !this.txtTessTol1) then
    !this.txtTessTol.val = !this.txtTessTol1.val
  elseif (!gadget eq !this.txtTessTol) then
    !this.txtTessTol1.val = !this.txtTessTol.val
  endif

endmethod
