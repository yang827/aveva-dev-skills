--
--  Description:     Manage Convert genpri elements into nozzles
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidManager(ARC)                  -                   manages the aids shown in 3D view, with Plane added
--  aidManager(BOOLEAN)              -                   manages the aids shown in 3D view
--  close()                          -                   form closing call
--  collection(STRING,DBREF,EXPRESSION) ARRAY
--  createNozz()                     -                   creates a new nozzle
--  derivePosition(ARRAY)            -                   derives the required nozzle position from the pick data
--  equMeiCreateNozzle()             -                   Constructor
--  evaluate(ARRAY,STRING)           ARRAY               generic evaluate method
--  flipDir()                        -                   flips the current nozzle direction
--  getNozzleBores(DBREF)            -
--  getNozzleTypes(DBREF)            -                   finds the available nozzle types for a spec
--  init()                           -                   Initialisation routine
--  nameCheck()                      -                   Checks the entered name is valid
--  pick()                           -                   setup for EDG
--  pickProcess(ANY)                 -                   extracts the required information from the edg packet data
--  pressCheck()                     -                   checks for unset pressure value
--  redoCreateNozz()                 -                   redo for a create nozzle
--  setNozzleSpecRef(DBREF)          -                   sets the currently selected nozzle catref
--  showPlot()                       -                   Callback when user hits parameter button
--  tempCheck()                      -                   checks for unset temperature value
--  undoCreateNozz()                 -                   undo for a create nozzle
--
------------------------------------------------------------------------
--

setup form !!equMeiCreateNozzle dialog dock right

  !this.formtitle = 'MEI Create Nozzle'

  -- Form Definition
  -----------------------------------------------------------------------

  para     .parNozzI         at xmin              ymax         anchor     L + T   pixmap    width 16          height 16
  para     .parNozzT         at xmax+1            ymin         anchor R + L + T   text      |Nozzle|          width 10
  button   .butParam         |Parameters|                      at x18             ymax+0.1  anchor R + T      width 10
  line     .lineTop                                            at xmin.parNozzI   ymax+0.4  anchor R + L + T  horizontal width 30

  text     .txtName          |Name:|              tagwidth 10  at xmin.parNozzI+1 ymax+0.2  anchor R + L + T  width 17  is STRING
  option   .optSpec          |Specification:|     tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 14.8
  option   .optType          |Generic Type:|      tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 14.8
  option   .optBore          |Bore:|              tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 14.8
  text     .txtHeight        |Height:|            tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 17  is REAL format !!distanceFmt
  text     .txtTemp          |Temperature:|       tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 17  is REAL format !!temperatureFmt
  text     .txtDuty          |Duty:|              tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 17  is STRING
  text     .txtPress         |Pressure:|          tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 17  is REAL format !!pressureFmt
  text     .txtDesc          |Description:|       tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 17  is STRING
  text     .txtPurp          |Purpose:|           tagwidth 10  at xmin            ymax+0.2  anchor R + L + T  width 17  is STRING
  para    .parApproxBore                                       at xmin            ymax+0.5  anchor R + L + T  width 25

  line    .lineMiddle                                          at xmin.parNozzI   ymax+0.2  anchor R + L + T  horizontal width 30
  line    .lineMiddle2                                         at x29             ymin                        horizontal width 1
  button  .butPositionI                           pixmap       at xmin.lineMiddle ymax+0.2  anchor     L + T  width 16   height 16
  button  .butPosition      |Position Nozzle|     linklabel    at xmax+1          ymin      anchor R + L + T
  button  .butFlipDirI                            pixmap       at x16             ymin      anchor     L + T  width 16   height 16
  button  .butFlipDir       |Flip Direction|      linklabel    at xmax            ymin      anchor R + L + T  width 11
  button  .butCreateI                             pixmap       at xmin.parNozzI   ymax+0.2  anchor     L + T  width 16   height 16
  button  .butCreate        |Create Nozzle|       linklabel    at xmax+1          ymin      anchor R + L + T
  line    .lineBottom                                          at xmin.parNozzI   ymax+0.5  anchor R + L + T  horizontal width 30
  para    .parHelp                                             at xmin.parNozzI   ymax+0.5  width 17   height 4
  para    .parHelpI                                            at x18  ymin.lineBottom+0.2  pixmap     width 80   height 80

  -- Form members
  ----------------------------------

  -- Nozzle specification reference
  member .nozzSpecRef     is DBREF
  -- Nozzle name
  member .nozzName        is STRING
  -- Nozzle height
  member .nozzHeight      is REAL
  -- Nozzle centre position
  member .nozzCentPos     is POSITION
  -- Nozzle direction
  member .nozzDir         is DIRECTION
  -- Plane on the face of the nozzle
  member .nozzPlane       is PLANE
  -- Approximate measured bore
  member .nozzApproxBore  is REAL
  -- Arc defined from EDG picks
  member .nozzArc         is ARC
  -- Item picked with EDG
  member .pickedItem      is DBREF
  -- Undo object for create method
  member .undoCreate      is UNDOABLE
  -- Registered number for aid graphics
  member .aidNumber       is REAL

exit
-- End of form definition
------------------------------------------------------------------------
--
-- Method:      equMeiCreateNozzle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equMeiCreateNozzle()

  -- Set form callbacks
  !this.initCall      =  |!this.init()|
  !this.cancelCall    =  |!this.close()|
  !this.killingCall   =  |!this.close()|

  -- Set the gadget icons
  !this.parNozzI.addPixmap(!!pml.getPathName(|nozzle-16.png|))
  !this.butPositionI.addPixmap(!!pml.getPathName(|connect-16.png|))
  !this.butFlipDirI.addPixmap(!!pml.getPathName(|nozzleflip-16.png|))
  !this.butCreateI.addPixmap(!!pml.getPathName(|nozzlecreate-16.png|))
  !this.parHelpI.addPixmap(!!pml.getPathName(|nozzlepickposition.png|))

  -- Set button tooltips
  !this.butParam.setTooltip('Display plotfile of nozzle parameters')
  !this.butPositionI.setTooltip('Position nozzle with 2 edge picks')
  !this.butPosition.setTooltip('Position nozzle with 2 edge picks')
  !this.butFlipDirI.setTooltip('Reverse nozzle direction')
  !this.butFlipDir.setTooltip('Reverse nozzle direction')
  !this.butCreateI.setTooltip('Create nozzle')
  !this.butCreate.setTooltip('Create nozzle')

  -- Set initial gadget states
  !this.butCreate.active    =  False
  !this.butCreateI.active   =  False
  !this.butFlipDir.active   =  False
  !this.butFlipDirI.active  =  False

  -- Set gadget callbacks
  !this.butParam.callback      =  |!this.showPlot()|
  !this.optSpec.callback       =  |!this.getNozzleTypes(!this.optSpec.selection().dbref())|
  !this.optType.callback       =  |!this.getNozzleBores(!this.optType.selection().dbref())|
  !this.optBore.callback       =  |!this.setNozzleSpecRef(!this.optBore.selection().dbref())|
  !this.butPosition.callback   =  |!this.pick()|
  !this.butCreate.callback     =  |!this.createNozz()|
  !this.butFlipDir.callback    =  |!this.flipDir()|
  !this.butPositionI.callback  =  |!this.pick()|
  !this.butCreateI.callback    =  |!this.createNozz()|
  !this.butFlipDirI.callback   =  |!this.flipDir()|
  !this.txtName.validateCall   =  |!this.nameCheck()|
  !this.txtTemp.validateCall   =  |!this.tempCheck()|
  !this.txtPress.validateCall  =  |!this.pressCheck()|

  -- Initialise create button undo
  !this.undoCreate.description('Create Nozzle')
  !this.undoCreate.undoAction(|!!equMeiCreateNozzle.undoCreateNozz()|)
  !this.undoCreate.redoAction(|!!equMeiCreateNozzle.redoCreateNozz()|)
  !this.butCreate.setUndoable(!this.undoCreate)

endmethod
-- End of Method Definition
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation routine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Collect the nozzle specifications in the MDB
  !specExpression     =  object EXPRESSION(|PURP EQ 'NOZZ' AND PURP OF SPWL EQ 'EQUI'|)
  !nozzScope          =  object DBREF()
  !nozzSpecs          =  !this.collection('SPEC',!nozzScope,!specExpression)
  -- Evaluate the Description for those specifications
  !nozzSpecsDesc      =  !this.evaluate(!nozzSpecs, 'description')
  !nozzSpecsRefNo     =  !this.evaluate(!nozzSpecs, 'refno.string()')

  -- Set the form gadgets
  !this.optSpec.dtext  =  !nozzSpecsDesc
  !this.optSpec.rtext  =  !nozzSpecsRefNo
  !this.optSpec.val    =  1
  !this.getNozzleTypes(!this.optSpec.selection().dbref())
  !this.optType.val    =  1
  !this.getNozzleBores(!this.optType.selection().dbref())
  !this.optBore.val    =  1
  !this.setNozzleSpecRef(!this.optBore.selection().dbref())
  !this.txtHeight.val  =  0.00
  !this.txtTemp.val    =  0
  !this.txtDuty.val    =  ''
  !this.txtPress.val   =  0
  !this.txtDesc.val    =  ''
  !this.txtPurp.val    =  ''

  !this.aidManager(False)

  !this.parHelp.val       =  'To find nozzle centre. Pick two points on the circumference of nozzle face.'
  !this.parHelp.visible   =  False
  !this.parHelpI.visible  =  False

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: generic collection method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Element type to collect
--    2    R     DBREF       Element to search under
--    3    R     EXPRESSION  Expression to filter results with
-- Return:
--   [Data Type] [Description]
--     ARRAY      Collected items
------------------------------------------------------------------------
define method .collection(!type is STRING,!scope is DBREF,!expression is EXPRESSION ) is ARRAY

  !collection  =  object COLLECTION()
  !results     =  object ARRAY()

  !collection.type(!type)

  if(!scope.set()) then
    !collection.scope(!scope)
  endif

  !collection.filter(!expression)
  !results  =  !collection.results()

  return !results

endmethod
-- End of method description
------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: generic evaluate method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Data to evaluate
--    2    R     STRING      Attribute to evaluate
-- Return:
--   [Data Type] [Description]
--    ARRAY       Evaluation results
------------------------------------------------------------------------
define method .evaluate(!rawData is ARRAY, !attribute is STRING) is ARRAY

  !processedData  =  object ARRAY()

  do !i index !rawData
    !processedData.append(!rawData[!i].$!attribute)
  enddo

  return !processedData

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      getNozzleTypes
--
-- Description: finds the available nozzle types for a spec
--              callback for spec option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Selected nozzle specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getNozzleTypes(!spec is DBREF)

  -- Collect all the Nozzle types available
  !typesExpression     =  object EXPRESSION(| TYPE EQ 'SELE'|)
  !nozzTypes           =  !this.collection('SELE',!spec,!typesExpression)

  -- Evaluate the Description for those specifications
  !nozzTypesDesc       =  !this.evaluate(!nozzTypes,'description')
  !nozzTypesRefNo      =  !this.evaluate(!nozzTypes,'refno.string()')

  -- Set the form gadgets
  !this.optType.dtext  =  !nozzTypesDesc
  !this.optType.rtext  =  !nozzTypesRefNo

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getBores
--
-- Description: finds the available nozzle bores for a sele
--              callback for type option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Selected nozzle type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getNozzleBores(!type is DBREF)

  -- Collect all the Nozzle types available
  !boreExpression      =  object EXPRESSION(| TYPE EQ 'SPCO'|)
  !nozzBores           =  !this.collection('SPCO',!type,!boreExpression)

  -- Evaluate the answer of the SPCO for the type
  !nozzBoresAns        =  !this.evaluate(!nozzBores, 'answer.string()')
  !nozzBoresSpecRef    =  !this.evaluate(!nozzBores, 'name.string()')

  -- Set the form gadgets
  !this.optBore.dtext  =  !nozzBoresAns
  !this.optBore.rtext  =  !nozzBoresSpecRef

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setNozzleSpecRef
--
-- Description: sets the currently selected nozzle catref
--              callback for bore option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Selected nozzle specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNozzleSpecRef(!specRef is DBREF)

  !this.nozzSpecRef  =  !specRef

  -- If the nozzle specification and position are set activate creation
  if(!this.nozzCentPos.set() and !this.nozzDir.set()) then
    !this.butCreate.active   =  True
    !this.butCreateI.active  =  True
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: setup for EDG
--              callback for position button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick()

  !this.parHelp.visible   =  True
  !this.parHelpI.visible  =  True

  !this.aidManager(False)

  -- Remove any other active events
  !!edgCntrl.remove(|Edge Pick|)

  -- Setup the packet object
  !packet  =  object EDGPACKET()
  !packet.elementPick(|Identify edge of GENPRI for nozzle face:|)

  -- The pick will consist of two graphical picks
  !packet.pickPacket.picks[1]  =  object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdGraphics(|First point|)
  !packet.pickPacket.picks[1].pick.input[6]  =  |EDGE|
  !packet.pickPacket.picks[2]  =  object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdGraphics(|Second Point|)
  !packet.pickPacket.picks[2].pick.input[6]  =  |EDGE|

  -- Set the actions on the pick events
  !packet.action  =  |!!equMeiCreateNozzle.pickProcess(!this.return[1])|

  -- Update the remaining properties
  !packet.remove       =  TRUE
  !packet.priority     =  1
  !packet.description  =  |Edge Pick|

  -- Add the pick to the global object
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      pickProcess
--
-- Description: extracts the required information from the edg packet data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ANY         Data returned from EDG pick event
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickProcess(!data is ANY)

  !requiredData  =  object ARRAY()
  !requiredData.append(!data[1].lines[1])
  !requiredData.append(!data[1].lines[2])
  !requiredData.append(!data[2].lines[1])
  !requiredData.append(!data[2].lines[2])
  !requiredData.append(!data[1].item)

  !this.derivePosition(!requiredData)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      derivePosition
--
-- Description: derives the required nozzle position from the pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY       Data extracted from the EDG pick event data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .derivePosition(!pickData is ARRAY)

  -- extract the information from the pick data
  !pointA  =  !pickData[1]
  !pointB  =  !pickData[2]
  !pointC  =  !pickData[3]
  !pointD  =  !pickData[4]
  !genpri  =  !pickData[5]

  -- Find the centre from the two picked edge data
  if(!pointC.eq(!pointA).not() and !pointC.eq(!pointB).not()) then

    !plane      =  !pointA.plane(!pointB, !pointC)
    !direction  =  !plane.orientation.zdir().wrt(!genpri)
    !arc        =  !pointA.arcThru(!pointB,!pointC,!direction)

  elseif(!pointC.eq(!pointA) or !pointC.eq(!pointB)) then

    !plane      =  !pointA.plane(!pointB, !pointD)
    !direction  =  !plane.orientation.zdir().wrt(!genpri)
    !arc        =  !pointA.arcThru(!pointB, !pointD, !direction)

  endif

  -- Centre position is the centre position of the derived arc
  !nozzCentrePos        =  !arc.position
  !approxBore           =  ( !arc.radius * 2 )
  !this.nozzApproxBore  =  !approxBore.nint()

  -- Set the required form members
  !this.nozzPlane    =  !plane
  !this.nozzArc      =  !arc
  !this.nozzCentPos  =  !nozzCentrePos
  !this.nozzDir      =  !direction
  !this.aidManager(!arc)
  !!ce               =  !genpri
  !this.pickedItem   =  !genpri

  -- Activate buttons if spec is already set
  if(!this.nozzSpecRef.set()) then
    !this.butCreate.active   =  True
    !this.butCreateI.active  =  True
  endif
  !this.butFlipDir.active   =  True
  !this.butFlipDirI.active  =  True

  -- Turn off the picking help
  !this.parHelp.visible   =  False
  !this.parHelpI.visible  =  False

  -- Get the name from the Genpri if name not already set
  if(!genpri.name.set()) then
    if(!this.txtName.val.eq('')) then
      !name  =  !genpri.name + '.nozzle'
      !name.dbref()
      handle (2,109) (2,813)
        !this.txtName.val  =  !name
        return
      endhandle
      !name  =  !genpri.owner.name + !name
      !name.dbref()
      handle (2,109)
        !this.txtName.val  =  !name
      endhandle
    endif
  endif

endmethod

-- End of method definition
------------------------------------------------------------------------
--
-- Method:      aidManager
--
-- Description: manages the aids shown in 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     State as to whether method should construct or clear aids
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aidManager(!state is BOOLEAN)

  -- Draws just point aids if required
  if(!state) then
    AID ARROW  NUM $!this.aidNumber AT $!this.nozzCentPos DIR $!this.nozzDir HEIGHT ($!this.nozzApproxBore) PROP 0.2
    AID SPHERE NUM $!this.adiNumber $!this.nozzCentPos DIAM ($!this.nozzApproxBore / 6 )

    !this.parApproxBore.val  =  'Measured Diameter:  ' + !this.nozzApproxBore.string()

  else
    -- Clears the all aids generated
    !!aidNumbers.remove(!this.aidNumber)
    !this.parApproxBore.val  =  ''
  endif

endmethod
-- end of method definition
------------------------------------------------------------------------
--
-- Method:      aidManager
--
-- Description: manages the aids shown in 3D view, with Plane added
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARC         Required arc definition for circle aid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aidManager(!arc is ARC)

  -- Generate a new aid number
  !this.aidNumber  =  !!aidNumbers.add('Nozzle')

  -- Draw point aids
  AID ARROW  NUM $!this.aidNumber AT $!this.nozzCentPos DIR $!this.nozzDir HEIGHT ($!this.nozzApproxBore) PROP 0.2
  AID SPHERE NUM $!this.aidNumber $!this.nozzCentPos DIAM ($!this.nozzApproxBore / 6 )

  -- Display the measured bore value
  !this.parApproxBore.val  =  'Measured Diameter:  ' + !this.nozzApproxBore.string()

  !xlength  =  (!this.nozzApproxBore / 5 * 3.5)
  !ylength  =  (!this.nozzApproxBore / 5 * 3.5)

  -- draw plane aids
  AID BOX NUMBER $!this.aidNumber AT $!this.nozzCentPos ORIENTATION $!this.nozzPlane.orientation XLENGTH $!xlength YLENGTH $!ylength ZLENGTH 1mm FILLED ON
  !arc.circle().draw(!this.aidNumber,1,5)

endmethod
-- end of method definition
------------------------------------------------------------------------
--
-- Method:      flipDir
--
-- Description: flips the current nozzle direction
--              callback for the flip button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .flipDir()

  !this.aidManager(False)
  !direction     =  !this.nozzDir
  !newDirection  =  !direction.opposite()
  !this.nozzDir  =  !newDirection
  !this.aidManager(!this.nozzArc)

endmethod
------------------------------------------------------------------------
--
-- Method:      createNozz
--
-- Description: creates a new nozzle
--              callback for the create button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNozz()

  -- Create the new nozzle
  NEW NOZZ
  handle (41,8)
    !!alert.error( |Cannot create nozzle at this level| )
    return
  endhandle
  !!ce.catref  =  !this.nozzSpecRef
  !!ce.name    =  !this.txtName.val
  handle any
  endhandle
  !!ce.height       =  !this.txtHeight.val
  !!ce.pos          =  !this.nozzCentPos
  !!ce.temperature  =  !this.txtTemp.val
  !!ce.duty         =  !this.txtDuty.val
  !!ce.pressure     =  !this.txtPress.val

  if (!this.txtDesc.val.trim().empty()) then
    !description = !!getDescFromSpref(!!ce)
    if (!description.trim().empty().not()) then
      !!ce.description = !description
    endif
  else
    !!ce.description  =  !this.txtDesc.val
  endif

  !!ce.purpose      =  !this.txtPurp.val
  ori $!!ce.pdir[1] is $!this.nozzDir

  -- Reset the form ready for the next pick
  !this.txtName.val         =  ''
  !this.txtName.refresh()
  !this.butCreate.active    =  False
  !this.butCreateI.active   =  False
  !this.butFlipDir.active   =  False
  !this.butFlipDirI.active  =  False
  !this.aidManager(False)
endmethod

-- End method definition
------------------------------------------------------------------------
--
-- Method:      undoCreateNozz
--
-- Description: undo for a create nozzle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoCreateNozz()

  if(!this.shown().not()) then
    return
  endif

  !this.butCreate.active   =  True
  !this.butCreateI.active  =  True
  !this.butFlipDir.active  =  True
  !this.butFlipDir.active  =  True
  !this.aidManager(!this.nozzArc)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      redoCreateNozz
--
-- Description: redo for a create nozzle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .redoCreateNozz()

  if(!this.shown().not()) then
    return
  endif

  !this.butCreate.active   =  False
  !this.butCreateI.active  =  False
  !this.butFlipDir.active  =  False
  !this.butFlipDir.active  =  False
  !this.aidManager(False)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: Callback when user hits parameter button
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPlot()

  -- Initialise Variables
  if( not defined(!!primitivePlot) ) then
    pml reload form !!primitivePlot
  endif

  -- If the plot is shown then kill it
  if(!!primitivePlot.shown()) then
    kill !!primitivePlot
    return
  endif

  show !!primitivePlot
  !!primitivePlot.showPlot('PNOZZ')

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      nameCheck
--
-- Description: Checks the entered name is valid
--              Validate callback for name textbox
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameCheck()

  !name   = !this.txtName.val.trim()
  !slash  = !name.substring(1,1)

  if(!name.eq('')) then
    !this.txtName.val  =  ''
    !this.txtName.refresh()
    return
  endif

  if(!slash.occurs('/').eq(0)) then
    !name              = '/' + !name
    !this.txtName.val  = !name
  endif

  !name.dbref()
  handle  (2,109)
    !this.txtName.val  =  !name
    !this.txtName.refresh()
    return
  endhandle

  !!alert.error( |Name $!name already used| )
  !this.txtName.val  =  ''
  !this.txtName.refresh()
  !this.txtName.setFocus()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: form closing call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.aidManager(False)
  !!edgCntrl.remove(|Edge Pick|)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      tempCheck
--
-- Description: checks for unset temperature value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tempCheck()

  if(!this.txtTemp.val.unset()) then
    !this.txtTemp.val  =  0
    !this.txtTemp.refresh()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      pressCheck
--
-- Description: checks for unset pressure value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pressCheck()

  if(!this.txtPress.val.unset()) then
    !this.txtPress.val  =  0
    !this.txtPress.refresh()
  endif

endmethod
-- end of method definition
