--
--  Description:     Create design points within a genpri model
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidClear(BOOLEAN)                -                   Tidy's aids created by this form
--  bore()                           -
--  centrePick()                     -                   Sets EDG for a centre pick event
--  close()                          -                   Close and kill method
--  connection()                     -                   Populates connection option gadget
--  createPoint()                    -                   creates a point based on set values
--  derivePosition(ARRAY)            -                   Derives the required position from the pick data
--  dirFlip()                        -                   Flips the current direction
--  directionCheck()                 -                   Checks that the entered direction is valid
--  doublePickProcess(ANY)           -                   Extracts required information from EDG data for double pick
--  drawPoint(REAL,POSITION,DIRECTION) -                   Draws point aids based on passed information
--  endCondition()                   -                   Populates end condition option gadget
--  equMeiCreatePoint()              -                   Constructor
--  init()                           -                   Initialisation
--  lockForm(BOOLEAN)                -                   Locks the gadgets on the form when required
--  numCheck()                       -                   callback for number text box
--  optSelect(GADGET,STRING)         -                   callback for option box selection
--  pointCheck()                     -                   Sets form element focus and checks for any existing points
--  redoCreatePoint()                -                   Draws point aids based on passed information
--  singlePick()                     -                   Sets EDG for a single pick event
--  singlePickProcess(ANY)           -                   processes the data from a single pick
--  undoCreatePoint()                -                   Draws point aids based on passed information
--  uniqueNumber()                   -                   Finds the first available point number
--
------------------------------------------------------------------------
--

setup form !!equMeiCreatePoint dialog dock right

  !this.formtitle = 'Create Design Point'

  -- Form Definition
  -----------------------------------------------------------------------

  para     .parPointI         at xmin             ymax+0.1     anchor     L + T       pixmap    width 16         height 16
  para     .parPoint          at xmax+2           y0.1         anchor L + T           text      |Design Point|   width 6
  button   .butUpdate         |CE|                linklabel    at xmax+1              ymin      anchor  L + T    width 2
  para     .parCE             at xmax             y0.1         anchor R + L + T       width 16
  line     .lineTop                                            at xmin.parPointI      ymax+0.4  anchor R + L + T horizontal width 30

  text     .txtNumber        |Number:|            tagwidth 10  at xmin.parPointI+0.3  ymax+0.2  anchor R + L + T  width 5  is REAL
  button   .butUniq          |Next Available|     linklabel    at xmax+2              ymin      anchor R + T      width 10
  text     .txtDesc          |Description:|       tagwidth 10  at xmin.parPointI+0.3  ymax+0.2  anchor R + L + T  width 17  is STRING
  text     .txtFunc          |Function:|          tagwidth 10  at xmin                ymax+0.2  anchor R + L + T  width 17  is STRING
  text     .txtPurp          |Purpose:|           tagwidth 10  at xmin                ymax+0.2  anchor R + L + T  width 17  is STRING
  text     .txtDir           |Z Direction:|       tagwidth 10  at xmin                ymax+0.2  anchor R + L + T  width 13  is STRING
  button   .butFlip          |Flip|               linklabel    at xmax+0.5            ymin      anchor R + T      width 3
  frame    .frmPipeAts       foldup               |Piping Attributes|                 at x0     ymax+0.3   anchor R + L + T width 30
    option   .optConn        |Connection:|        tagwidth 10  at xmin.txtPurp        ymax+0.2  anchor R + L + T  width 14.8
    option   .optEnd         |End Condition:|     tagwidth 10  at xmin                ymax+0.2  anchor R + L + T  width 14.8
    option   .optBore        |Bore:|              tagwidth 10  at xmin                ymax+0.2  anchor R + L + T  width 14.8
  exit

  line    .lineMiddle                                          at xmin.parPointI  ymax+0.4  anchor R + L + T  horizontal width 30
  line    .lineMiddle2                                         at xmin            ymin                        horizontal width 29
  button  .butVPositionI                          pixmap       at xmin            ymax+0.2  anchor     L + T  width 16   height 16
  button  .butVPosition      |Position Point|     linklabel    at xmax+1          ymin      anchor R + L + T
  button  .butCPositionI                          pixmap       at x15             ymin      anchor     L + T  width 16   height 16
  button  .butCPosition      |Centre Position|    linklabel    at xmax+1          ymin      anchor R + L + T  width 10
  button  .butCreateI                             pixmap   at xmin.parPointI+0.5  ymax+0.2  anchor     L + T  width 16   height 16
  button  .butCreate         |Create Point|       linklabel    at xmax+0.5        ymin      anchor R + L + T
  line    .lineBottom                                          at xmin.parPointI  ymax+0.5  anchor R + L + T  horizontal width 30
  para    .parHelp                                             at xmin            ymax+0.5  anchor R + L + T  width 17   height 4
  para    .parHelpI                                            at x18  ymin.lineBottom+0.2  anchor R + L + T  pixmap     width 80  height 80

  -- Form members
  ----------------------------------

  -- Current point connection type
  member .pointConn       is STRING
  -- Current point end connection
  member .pointEnd        is STRING
  -- Current point bore
  member .pointBore       is BORE
  -- Current point number
  member .pointNo         is REAL
  -- Current point position
  member .pointPos        is POSITION
  -- Current point direction
  member .pointDir        is DIRECTION
  -- Current point set
  member .pointSet        is DBREF
  -- Array of used numbers in current point set
  member .pointNum        is ARRAY
  -- Current form element focus, should be equi
  member .element         is DBREF
  -- Registered aid numbers for points
  member .aidNumbers      is ARRAY
  -- Registered number for temporary point aid
  member .aidTemp         is REAL
  -- Create undo member
  member .undoCreate      is UNDOABLE

exit
-- End of form definition
------------------------------------------------------------------------
--
-- Method:      equMeiCreatePoint
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equMeiCreatePoint()

  -- Set form callbacks
  !this.initCall     =  |!this.init()|
  !this.cancelCall   =  |!this.close()|
  !this.killingCall  =  |!this.close()|

  -- Set the icons
  !this.parPointI.addPixmap(!!pml.getPathName(|dpca-16.png|))
  !this.butVPositionI.addPixmap(!!pml.getPathName(|pnt24.png|))
  !this.butCPositionI.addPixmap(!!pml.getPathName(|centrepick-16.png|))
  !this.butCreateI.addPixmap(!!pml.getPathName(|createdpca-16.png|))
  !this.parHelpI.addPixmap(!!pml.getPathName(|pointpickposition.png|))

  -- Set button tooltips
  !this.butVPositionI.setTooltip('Pick point position')
  !this.butVPosition.setTooltip('Pick point position')
  !this.butCPositionI.setTooltip('Define a centre position for point from 2 edge picks')
  !this.butCPosition.setTooltip('Define a centre position for point from 2 edge picks')
  !this.butCreateI.setTooltip('Create Point')
  !this.butCreate.setTooltip('Create Point')

  -- Set initial gadget states
  !this.butCreate.active     =  False
  !this.butCreateI.active    =  False
  !this.frmPipeAts.expanded  =  False

  -- Set gadget callbacks
  !this.butUpdate.callback      =  |!this.pointCheck()|
  !this.butUniq.callback        =  |!this.uniqueNumber()|
  !this.txtNumber.callback      =  |!this.numCheck()|
  !this.txtDir.callback         =  |!this.directionCheck()|
  !this.butFlip.callback        =  |!this.dirFlip()|
  !this.optBore.callback        =  |!this.optSelect(!this.optBore,'BORE')|
  !this.optConn.callback        =  |!this.optSelect(!this.optConn,'CONN')|
  !this.optEnd.callback         =  |!this.optSelect(!this.optEnd,'END')|
  !this.butVPosition.callback   =  |!this.singlePick()|
  !this.butCPosition.callback   =  |!this.centrePick()|
  !this.butCreate.callback      =  |!this.createPoint()|
  !this.butVPositionI.callback  =  |!this.singlePick()|
  !this.butCPositionI.callback  =  |!this.centrePick()|
  !this.butCreateI.callback     =  |!this.createPoint()|

  -- Initialise create button undo
  !this.undoCreate.description('Create Point')
  !this.undoCreate.undoAction(|!!equMeiCreatePoint.undoCreatePoint()|)
  !this.undoCreate.redoAction(|!!equMeiCreatePoint.redoCreatePoint()|)
  !this.butCreate.setUndoable(!this.undoCreate)

  --Set centre pick help information
  !this.parHelp.val  =  'Select two edges on a circumference or box to pick the centre position'

endmethod
-- End of Method Definition
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Generate aid number for positioning aid
  !this.aidTemp  =  !!aidNumbers.add( 'Point 100')

  -- Initialise form gadgets
  !this.pointCheck()
  !this.endCondition()
  !this.connection()
  !this.bore()

  -- Set the default point direction
  !this.txtDir.val       =  'U'
  !this.pointDir         =  !this.txtDir.val.direction()
  !this.pointDir.origin  =  !this.element

  -- Centre pick help information should start invisible
  !this.parHelp.visible   =  False
  !this.parHelpI.visible  =  False

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      endCondition
--
-- Description: Populates end condition option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .endCondition()

  -- Build arrays of end connections and set these to the option gadget
  -- Hard coding of values may need to be changed in the future
  !endConditions = object ARRAY()
  !endConditions.append('Unset')
  !endConditions.append('Butt Weld')
  !endConditions.append('Compression')
  !endConditions.append('Flange')
  !endConditions.append('Screwed')
  !endConditions.append('Socket Weld')
  !endConditions.append('Plain')

  !endConditionsR = object ARRAY()
  !endConditionsR.append('Unset')
  !endConditionsR.append('BW')
  !endConditionsR.append('CP')
  !endConditionsR.append('FL')
  !endConditionsR.append('SC')
  !endConditionsR.append('SW')
  !endConditionsR.append('PL')

  !this.optEnd.dtext  =  !endConditions
  !this.optEnd.rtext  =  !endConditionsR

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      connection
--
-- Description: Populates connection option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .connection()

  -- Collect all of the coco values
  var !conn collect all COCO

  -- Split coco's into their two connection values
  var !i evaluate CTYP[1] for all from !conn
  var !j evaluate CTYP[2] for all from !conn

  -- Merge together the two arrays and remove duplicates
  !i.append(!j)
  !i.unique()

  -- remove last value as this is another array
  !size        =  !i.size()
  !size        =  !size - 1
  !connection  =  object ARRAY()
  do !index to !size
    !connection.append(!i[!index])
  enddo

  -- Set the connection option box with the values
  !this.optConn.dtext  =  !connection

endmethod
------------------------------------------------------------------------
--
-- Method:      bores
--
-- Description: Populates bore option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .bore()

  !boreArray  =  object ARRAY()

  -- Create a measure object to find the current units
  !boreUnits  =  object MEASURE('Bore')

  -- Query the system bore table based on whether the units are imperial or metric
  if(!boreUnits.currentunits().ismetric()) then
    var !boreValues nombmm bores
  elseif(!boreUnits.currentunits().isimperial()) then
    var !boreValues nombin bores
  endif

  -- Turn the returned bores from a single string into an array of strings
  !boreArrayString  =  !boreValues.split()
  do !i index !boreArrayString
    !boreArray.append(!boreArrayString[!i].bore().string())
  enddo

  -- Set the bore gadget to the required values
  !this.optBore.dtext  =  !boreArray

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      optSelect
--
-- Description: callback for option box selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget selection is made from
--    2   R      STRING      Determines the member selection should be assigned to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .optSelect(!optBox is GADGET,!opt is STRING)

  -- Get the selection of the passed gadget
  !currentSelection  =  !optBox.selection()

  -- Assign the selection to the appropriate form member
  if(!opt.eq('BORE')) then
    !this.pointBore  =  !currentSelection.bore()
  elseif(!opt.eq('END')) then
    !this.pointEnd   =  !currentSelection
  elseif(!opt.eq('CONN')) then
    !this.pointConn  =  !currentSelection
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      numCheck
--
-- Description: callback for number text box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .numCheck()

  !number  =  !this.txtNumber.val

  -- Check points exist, otherwise any number greater than 0 is valid
  if(!this.pointSet.set()) then
    !usedNumbers  =  !this.pointNum

    if(!usedNumbers.findFirst(!number).set()) then
      !!alert.warning(|Entered number already used, using first available number|)
      -- If number used select first available number
      !this.uniqueNumber()
      return
    endif

    -- Check that the number is gt 0 otherwise select first available
    if(!number.gt(0)) then
      return
    elseif(!number.leq(0)) then
      !this.uniqueNumber()
    endif
  else

    if(!number.gt(0)) then
      return
    elseif(!number.leq(0)) then
      !this.uniqueNumber()
    endif

  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      pointCheck
--
-- Description: Sets form element focus and checks for any existing points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pointCheck()

  -- Clear the current aids
  !this.aidClear(True)

  !this.pointNum  =  object ARRAY()

  -- Check that the element is an equi or is owned by an equi
  var !current equi
  handle (2,111)
    !!alert.error( |Please navigate to Equipment|)
    !this.parCE.val  =  'Select Equipment'
    !this.lockForm(False)
    return
  endhandle

  !this.lockForm(True)

  -- Set form focus to selected equipment
  !!ce             =  !current.dbref()
  !this.element    =  !current.dbref()
  !this.parCE.val  =  !current

  -- Check to see if a point set exists
  next dpse
  handle (2,113)
    !this.pointSet  =  object DBREF()
    return
  endhandle

  -- Save the pointset to form member
  !pointSet       =  !!ce
  !this.pointSet  =  !pointSet

  -- Find any existing points in the pointset
  !points  =  !this.pointSet.members

  do !i index !points
   !numString  =  !points[!i].number.string()
   !number     =  !points[!i].number
   !position   =  !points[!i].position
   !direction  =  !points[!i].orientation.zdir()
   !this.pointNum.append(!number)

  -- Draw aids for any existing points, unless number is 0
  if(!number.gt(0)) then
    !this.drawPoint(!number,!position,!direction)
  endif
  enddo

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      uniqueNumber
--
-- Description: Finds the first available point number
--              Will not use a 0 for point number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .uniqueNumber()

  !usedNumbers  =  object ARRAY()

  -- Checks that points exist otherwise first number is 1
  if(!this.pointSet.set()) then
    !usedNumbers  =  !this.pointNum

    !usedNumbers.sort()
    -- Count up until a number is found which is not used
    do !j
      if(!usedNumbers.findFirst(!j).unset()) then
        !this.txtNumber.val  =  !j
        !this.txtNumber.refresh()
        return
      endif
    enddo
  else
  !this.txtNumber.val  =  1
  !this.txtNumber.refresh()
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      singlePick
--
-- Description: Sets EDG for a single pick event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .singlePick()

  !this.aidClear(False)

  -- Remove any conflicting EDG events
  !!edgCntrl.remove(|Edge Pick|)
  !!edgCntrl.remove(|Genpri Pick|)

  -- Set the variables for the pick
  !desc      =  |Genpri Pick|
  !priority  =  1

  -- Declare the object, and initial set-up as a standard element pick
  !packet  =  object EDGPACKET()

  -- Set up a std position pick to activate the positioning control toolbar
  !packet.pickPacket.picks[1]  =  object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('Pick point')
  !packet.pickPacket.picks[1].pick.modifiable  =  false

  -- Apply methods to the events on the pick
  !packet.action  =  |!!equMeiCreatePoint.singlePickProcess(!this.return[1])|

  -- Update the description and priority
  !packet.priority     =  !priority
  !packet.description  =  !desc
  !packet.remove       =  TRUE

  -- Add the EDG pick to the global object
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      singlePickProcess
--
-- Description: processes the data from a single pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Returned EDG pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .singlePickProcess(!data is ANY)

  -- Clear any existing positioning aid arrows
  !this.aidClear(False)

  --Check if the pick returned a line or a plane and if so extract the direction
  if(!data.line.set()) then
    !direction  =  !data.line.direction()
  elseif(!data.plane.set()) then
    !direction  =  !data.plane.orientation.zdir()
  else
    !direction  =  !this.pointDir
  endif

  -- Extract the position
  !pos            =  !data.position
  !this.pointPos  =  !pos

  -- Activate the creation buttons now we have all the information needed
  !this.butCreate.active   =  True
  !this.butCreateI.active  =  True

  -- Set the direction text box with the picked direction
  !this.pointDir  =  !direction
  !this.dirFlip()

  -- Draw an aid for the new point position
  !this.drawPoint(100,!pos,!this.pointDir)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      createPoint
--
-- Description: creates a point based on set values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createPoint()

  !this.pointCheck()

  -- Clear the positioning aid arrows
  !this.aidClear(False)

  -- Set the CE to the form focus element
  !!ce  =  !this.element

  -- Check if a point set exists and create one if not
  if(!this.pointSet.unset()) then
    NEW DPSE
    !this.pointSet  =  !!ce
    !!ce            =  !this.element
  endif

  -- Navigate to the pointset
  NEXT DPSE
  handle (2,113)
    NEW DPSE
    !this.pointSet  =  !!ce
    !!ce            =  !this.element
    NEXT DPSE
  endhandle

  -- Create a new point
  NEW DPCA
  handle any
    -- Failure at this point is likely to be a lack of write access
    !!alert.error( |Point creation has failed, please check write access|)
    return
  endhandle

  -- Check if the user has entered a number and get one if not
  if(!this.txtNumber.val.unset()) then
    !this.uniqueNumber()
  endif

  -- Populate the point attributes
  !number           =  !this.txtNumber.val
  -- Add the number to the used number array
  !this.pointNum.append(!number)
  !!ce.number       =  !number
  !!ce.position     =  !this.pointPos
  !!ce.bore         =  !this.optBore.selection().bore()
  !!ce.dconnect     =  !this.optConn.selection()
  !!ce.pskey        =  !this.optEnd.selection()
  !!ce.description  =  !this.txtDesc.val
  !!ce.function     =  !this.txtFunc.val
  !!ce.purpose      =  !this.txtPurp.val
  !direction        =  !this.pointDir
  ori Z is $!direction

  -- Populate the number text box with the next available number
  !this.uniqueNumber()
  !numString  =  !number.string()

  -- Redraw all aids including for new point, helps keep the view updated if points are deleted
  !this.pointCheck()

  -- Turn the create button off until a new position is selected
  !this.butCreate.active   =  False
  !this.butCreateI.active  =  False

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      centrePick
--
-- Description: Sets EDG for a centre pick event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .centrePick()

  !this.aidClear(False)

  -- Show the centre pick help information
  !this.parHelp.visible   =  True
  !this.parHelpI.visible  =  True

  -- Remove any other active events
  !!edgCntrl.remove(|Genpri Pick|)
  !!edgCntrl.remove(|Edge Pick|)

  -- Setup the packet object
  !packet = object EDGPACKET()
  !packet.elementPick(|Identify edge of GENPRI for nozzle face:|)

  -- The pick will consist of two graphical edge picks
  !packet.pickPacket.picks[1]  =  object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdGraphics(|First point|)
  !packet.pickPacket.picks[1].pick.input[6]  =  |EDGE|
  !packet.pickPacket.picks[2] = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdGraphics(|Second Point|)
  !packet.pickPacket.picks[2].pick.input[6]  =  |EDGE|

  -- Set the actions on the pick events
  !packet.action  =  |!!equMeiCreatePoint.doublePickProcess(!this.return[1])|

  -- Update the remaining properties
  !packet.remove       =  TRUE
  !packet.priority     = 1
  !packet.description  = |Edge Pick|

  -- Add the pick to the global object
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close and kill method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Clear all aids from the screen
  !this.aidClear(True)
  !!aidNumbers.remove(!this.aidTemp)

  -- Tidy up any remaining edg packets
  !!edgCntrl.remove(|Genpri Pick|)
  !!edgCntrl.remove(|Edge Pick|)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      doublePickProcess
--
-- Description: Extracts required information from EDG data for double pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Returned EDG data packet
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .doublePickProcess(!data is ANY)

  -- Hide the centre pick help information after pick
  !this.parHelp.visible   =  False
  !this.parHelpI.visible  =  False

  -- Extract the required data into an array
  !requiredData  =  object ARRAY()
  !requiredData.append(!data[1].lines[1])
  !requiredData.append(!data[1].lines[2])
  !requiredData.append(!data[2].lines[1])
  !requiredData.append(!data[2].lines[2])
  !requiredData.append(!data[1].item)

  -- Call the data processing method for centre pick
  !this.derivePosition(!requiredData)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      derivePosition
--
-- Description: Derives the required position from the pick data
--              Processes data returned from 2 pick edg event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY       Data extracted from the EDG pick event data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .derivePosition(!pickData is ARRAY)

  -- Clear current positioning aids
  !this.aidClear(False)

  -- extract the information from the pick data
  !pointA  =  !pickData[1]
  !pointB  =  !pickData[2]
  !pointC  =  !pickData[3]
  !pointD  =  !pickData[4]
  !genpri  =  !pickData[5]

  -- Find the centre from the two picked edge data
  if(!pointC.eq(!pointA).not() and !pointC.eq(!pointB).not()) then

    !plane      =  !pointA.plane(!pointB,!pointC)
    !direction  =  !plane.orientation.zdir().wrt(!genpri)
    !arc        =  !pointA.arcThru(!pointB,!pointC,!direction)

  elseif(!pointC.eq(!pointA) or !pointC.eq(!pointB)) then

    !plane      =  !pointA.plane(!pointB,!pointD)
    !direction  =  !plane.orientation.zdir().wrt(!genpri)
    !arc        =  !pointA.arcThru(!pointB,!pointD,!direction)

  endif

  -- Centre position is the centre position of the derived arc
  !centrePos      =  !arc.position
  !this.pointPos  =  !centrePos

  -- Once positioned, activate the create buttons
  !this.butCreate.active   =  True
  !this.butCreateI.active  =  True

  -- Set the point direction member
  !this.pointDir  =  !direction
  !this.dirFlip()

  -- Draw a new aid at the current position
  !this.drawPoint(100,!centrePos,!this.pointDir)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      directionCheck
--
-- Description:  Checks that the entered direction is valid
--               Callback for direction textbox
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .directionCheck()

  -- Extract the direction entry and check it is a valid direction
  !direction  =  !this.txtDir.val.trim().direction()
  handle any
    !!alert.error(|Not a valid direction|)
    !this.txtDir.val  =  'U'
    return
  endhandle

  -- Strip the WRT entry from the direction for display purposes
  !dirString        =  !direction.string()
  !i = !dirString.match('WRT')
  !this.txtDir.val  =  !dirString.substring(0,!i).trim()

  -- Set the form direction member to the entered value
  !this.pointDir   =  !direction

  -- Redraws the aid with the entered direction if it exists
  AID CLEAR ARROW $!this.aidTemp
  handle any
    return
  endhandle

  !this.drawPoint(100,!this.pointPos,!this.pointDir)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      dirFlip
--
-- Description: Flips the current direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dirFlip()

  -- Flips the current direction
  !direction        =  !this.pointDir
  !newDirection     =  !direction.opposite()
  !this.pointDir    =  !newDirection
  -- Store the direction in the form textbox and call textbox callback
  !this.txtDir.val  =  !newDirection.string()
  !this.directionCheck()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      drawPoint()
--
-- Description: Draws point aids based on passed information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number required
--    2   R      POSITION    Point position
--    3   R      DIRECTION   Point Z direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawPoint(!number is REAL,!position is POSITION,!direction is DIRECTION)

  !numString  =  !number.string()

  -- Generate new aid numbers for the points
  -- 100 relates to the position aid. This has its own unique aid number so don't generate a new number for this
  if(!number.eq(100)) then
    !aidNum  =  !this.aidTemp
  else
    !aidNum  =  !!aidNumbers.add( 'Point' + !numString)
    !this.aidNumbers.append(!aidNum)
  endif

  -- Draw a new aid point
  AID SPHERE NUM $!aidNum $!position DIAM 50mm
  AID ARROW  NUM $!aidNum AT $!position DIR $!direction HEIGHT 300mm PROP 0.2

  -- Aid number 100 is used for the non-created positioning aid, we don't need a number label for this
  if(!number.neq(100)) then
    AID TEXT NUM $!aidNum '$!numString' AT $!position
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      undoCreatePoint()
--
-- Description: Draws point aids based on passed information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number required
--    2   R      POSITION    Point position
--    3   R      DIRECTION   Point Z direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoCreatePoint()

  if(!this.shown().not()) then
    return
  endif

  !this.butCreate.active   =  True
  !this.butCreateI.active  =  True
  !this.pointCheck()
  !this.drawPoint(100,!this.pointPos,!this.pointDir)
  !this.uniqueNumber()

endmethod
------------------------------------------------------------------------
--
-- Method:      redoCreatePoint()
--
-- Description: Draws point aids based on passed information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number required
--    2   R      POSITION    Point position
--    3   R      DIRECTION   Point Z direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .redoCreatePoint()

  if(!this.shown().not()) then
    return
  endif

  !this.butCreate.active   =  False
  !this.butCreateI.active  =  False
  !this.pointCheck()
  !this.uniqueNumber()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      aidClear()
--
-- Description: Tidy's aids created by this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Decides what to remove, True = All, False = 100 num aids
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aidClear(!case is BOOLEAN)

  -- If case is True we want to remove all aids if false just the current position aid
  if(!case) then
    -- Hide point positioning aid
    !!aidNumbers.hide(!this.aidTemp)
    -- Loop through all used point numbers and clear its aids
    do !num values !this.aidNumbers
      !!aidNumbers.remove(!num)
    enddo
  elseif(!case.not()) then
    -- Hides just the positioning aids
    !!aidNumbers.hide(!this.aidTemp)
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      formLock()
--
-- Description: Locks the forms gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     State required for the form gadgets
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lockForm(!state is BOOLEAN)

  !this.txtNumber.active      =  !state
  !this.butUniq.active        =  !state
  !this.txtDesc.active        =  !state
  !this.txtFunc.active        =  !state
  !this.txtPurp.active        =  !state
  !this.txtDir.active         =  !state
  !this.butFlip.active        =  !state
  !this.frmPipeAts.active     =  !state
  !this.butVPositionI.active  =  !state
  !this.butVPosition.active   =  !state
  !this.butCPositionI.active  =  !state
  !this.butCPosition.active   =  !state
  !this.butCreateI.active     =  !state
  !this.butCreate.active      =  !state

endmethod
-- End of method definition
