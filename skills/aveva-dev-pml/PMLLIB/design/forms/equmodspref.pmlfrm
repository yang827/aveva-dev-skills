--
-- Description:
-- Query form for properties object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actions(GADGET,STRING)           -                   Gadget actions for main form
--  choose(DBREF,BOOLEAN)            -                   Choose matching table items from selection table
--  clearSelection()                 -                   Reinitialise selection gadgets
--  clearView()                      -                   Clear the 3D view
--  close()                          -                   Close form down
--  dataGridOnPopup(ARRAY)           -
--  enableSpecificationTable(BOOLEAN) -                   Enable Specification Table selection
--  equModSpref()                    -                   Constructor
--  firstShown()                     -                   Actions when form is shown for the first time.
--  init(DBREF)                      -                   Initialise Form with given SPEC or SPCO DBREF
--  init(STRING,STRING)              -                   Initialise Form with given spec type
--  initSelTableList()               -                   Initialise selection table option list
--  initSelTypeList()                -                   Initialise selection type option list
--  initTable(BOOLEAN)               -                   Initialise the selection table
--  initialiseForm(DBREF)            -                   Actions when form is shown for the first time.
--  initialiseProperties(DBREF)      -                   After select event
--  initialiseTables()               -                   Form initialisation
--  loadFromXml()                    -                   Call when form is shown.
--  madeSelection(DBREF)             -                   After select event
--  netAfterSelect(ARRAY)            -                   After select event for .net control
--  saveToXml()                      -                   Save selection grid state to xml for reloading
--  selectTableItem()                -                   Initialise the selected Type
--  selectionDone()                  BOOLEAN             check to see if selection is complete (spec ref to SPCO)
--  specApply()                      -                   OK callback sends selected spec to calling form
--  specCallback()                   -
--  specSelect()                     -                   called when spec selected
--  specTypeCallback()               -                   Enable Specification Table selection
--  tableApply()                     -                   Set spref of design element to selected table item.
--  tableSelect(ARRAY)               -
--
import 'GridControl'
handle any
endhandle

-- Define form
setup form !!equModSpref dialog docking size 50 32

  --------------------------------- SPEC -----------------------------
  -- Link to spec system
  member .specLink       is SPCLINK
  -- specification search criteria
  member .specSearch     is SPCSEARCH
  -- what was the old Userdata (define members)
  member .specData       is SPECDATA
  member .dflts          is SPECDFLTS
  member .savedSort      is REAL

  -------------------------------- TABLES ----------------------------

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Grid control members
  member .netSelTabItems   is NETGRIDCONTROL

  -- Other members
  member .newItemName      is STRING
  member .selTables        is ARRAY
  member .selectedSelTab   is SELECTIONTABLE
  member .tableChooseData  is STCHOOSEDATA
  member .pdmsuser         is STRING

  -- Questions and answers
  member .choices          is ARRAY
  member .selectedItem     is DBREF

  -------------------------------- Shared ----------------------------
  member .template is COMPROP
  member .equipment is DBREF

  -- 3D view
  member .drawlist         is REAL

---------------------------------- FORM ------------------------------

  -- Element Name
  button .ce  anchor left + top 'CE'    at xmin ymin
  para .name  anchor left + top + right at xmax+1 ymin width 40 height 1

  frame  .frSpecType panel anchor left + top + right    at x0 ymax    width 34

    path down
    rtoggle .togTable  'Selection Table'         anchor left + top                     tagwidth 11
    rtoggle .togSpec   'Specification'           anchor left + top at xmin ymax+0.2    tagwidth 11

    -- Selection groups and tables
    option .opSelTables     anchor left + right + top at xmax.togTable ymin.togTable width 30

    -- Permissible Spec
    option .specifications  anchor left + top + right at xmax.togSpec  ymin.togSpec  width 30
    option .sortSpecs     'Sort Specification' at xmin.togSpec-.2 ymax+.25 tagwid 13 width 12

  exit
  line .cpLine        anchor left + right + top   at x0      ymax    horiz  width 50 heigh 0.5


  -- Spec selection
  frame .sFrame panel anchor left + top + right    at x0 ymax+0.2 width 50 height 16

    -- Default Select mode
    toggle .autoSelect      anchor left + top     'Auto Select'    at x1 ymin

    -- Available Types
    list .selected  anchor left + top + right 'Current Selection'  at x1   ymax+0.2 width 45 length 7
    para .question  anchor left + top + right                      at xmin ymax width 45 lines  1
    list .perms     anchor all                                     at xmin ymax width 45 length 7

  exit

  -- Table selection
  frame .tFrame  panel  anchor left + top + right  at xmin.sFrame ymin.sFrame width 50 height 16
    option .opSelTypes tagwid 14 'Type' anchor left + right + top at x1 ymin width 30
    toggle .tgDefault  tagwid 6 'Default' at xmin ymax

    -- PML container to host .NET grid control
    container .conSelTabItems nobox PmlNetControl 'Table items' anchor top + left + right at x0 ymax-0.2 width 50 height 15

  exit

  line .btLine        anchor left + right + top   at x0      ymax    horiz  width 50 heigh 0.5

  path down

  -- 3D view
  frame .frView3D panel anchor all at x0 ymax width 38 height 10
    view .vwView3D volume
    exit
  exit

  halign right
  button .properties  anchor top + right 'Properties...' at xmax form-size ymin.frView3D+0.25 width 12

    -- Display plot file
  button .plotfile   anchor top + right 'Plotfile...'    at xmax form-size ymax+0.5        width 12

  -- Bottom Line
  --button .cancel  anchor bottom + right 'Dismiss' at xmax form-size ymax.frView3D-1.5    width 9 callback '!this.close()'
  button .ok      anchor bottom + right ' Apply ' at xmax form-size ymax.frView3D-1.7      width 12

	menu .popupMenu
  !this.popupMenu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.netSelTabItems, ||, |Save As|)' )
  !this.popupMenu.add( 'callback', 'Print Preview...', '!this.netSelTabItems.printpreview()' )

-- End of form definition for !!equModSpref
exit

------------------------------------------------------------------------
--
-- Method:      .equModSpref()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .equModSpref()

  !this.callback  = |!this.initialiseForm(!!ce)|
  !this.formTitle = |Modify Equipment Specification|
  !this.iconTitle = |Modify Equipment Specification|
  !this.quitCall  = |!this.close()|

  !this.plotfile.callback =  |!this.template.displayPlot()|
  !this.properties.callback = |!this.template.editProperties()|
  !this.ce.callback         = |!this.initialiseForm(!!ce)|
  !this.ok.callback         = |!this.specApply()|
  !this.cancelCall          = |!this.saveToXml()|
  !this.frSpecType.val      = 1

  !this.template.link()
  !this.template.editMode('STORE')

  -- SPECIFICATION setup
  !this.specSearch          = object SPCSEARCH()
  !this.specSearch.spwlType = 'EQUI'
  !this.specSearch.type     = 'EQUI'
  !this.specSearch.search()

  !dText = ARRAY()
  !rText = ARRAY()
  !dText[1] = 'Database Order'
  !rText[1] = 'DB'
  !dText[2] = 'Name'
  !rText[2] = 'NAME'
  !this.sortSpecs.dText = !dText
  !this.sortSpecs.rText = !rText

  -- Generate links
  -- link specification display gadget with the spec search data
  !this.specLink.specification(!this.specifications, !this.specSearch)
  -- Link specification sort gadget
  !this.specLink.sort(!this.sortSpecs)
  -- link current selected spec item gadget
  !this.specLink.selection(!this.selected)
  -- link permissible selection gadget
  !this.specLink.permissible(!this.perms)
  -- link question gadget
  !this.specLink.question(!this.question)
  -- link default gadget
--  !this.specLink.default(!this.default)
  -- link auto select gadget
  !this.specLink.autoSelect(!this.autoSelect)
  -- set action for selection which sets parameters
  !this.specLink.setAction('!!equModSpref.specCallback()')

  -- Initialise overlaid panes
  !this.sFrame.visible = true
  !this.tFrame.visible = false

-------------------------------------------------------------
  -- TABLE setup
  !this.firstShownCall  = '!this.firstShown()'

  -- Set auto-scroll
  !this.autoScroll = true

  -- Used for storing grid layout XML file
  !pdmsuser = !!evarSplit('PDMSUSER')
  !this.pdmsuser = !pdmsuser[1]

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Create grid control objects
  !this.netSelTabItems  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  !this.netSelTabItems.addEventHandler('OnPopup', !this, 'dataGridOnPopup')
  !this.netSelTabItems.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')
  -- Set grid properties
  !this.netSelTabItems.fixedHeaders(false)
  --!this.netSelTabItems.fixedRows(false)
  !this.netSelTabItems.outlookGroupStyle(true)
  !this.netSelTabItems.columnExcelFilter(true)
  !this.netSelTabItems.headerSort(true)
  !this.netSelTabItems.columnSummaries(false)
  !this.netSelTabItems.singleRowSelection(true)
  !this.netSelTabItems.fixedRows(false)
  !this.netSelTabItems.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.conSelTabItems.control  = !this.netSelTabItems.handle()

  -- Callbacks
  !this.opSelTables.callback = |!this.actions(|
  !this.opSelTypes.callback = |!this.actions(|

  -- 3D view / local drawlist
  !this.vwView3D.shaded = true
  !viewDir[1] = 0.57735
  !viewDir[2] = 0.57735
  !viewDir[3] = -0.57735
  !this.vwView3D.direction = !viewDir
  !this.drawlist = !!gphDrawlists.createDrawList()

  -- initialise type of spec to be used
  !this.frSpecType.callback  = |!this.specTypeCallback()|
  !this.enableSpecificationTable(true)

  -- configure specification table gadgets
  !this.tableChooseData.clearData()
  !this.tableChooseData.setTitle(|Equipment Specification|)
  -- Element type to create
  !this.tableChooseData.setData(!!ce,|EQUI|,|EQUI|)
  !this.initialiseTables()

endmethod
-- End of method definition for .equModSpref()
----------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Actions when form is shown for the first time.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.vwView3D)

  -- Create local drawlist and add to 3D view
  if (!this.drawlist.unset()) then
    !this.drawlist = !!gphDrawlists.createDrawList()
  endif
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3D)

endmethod
-- End of method definition for .firstShown()

------------------------------------------------------------------------
--
-- Method:      initialiseForm
--
-- Description: Callback when form shown or new CE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of element being modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseForm(!element is DBREF)

  -- Initialise common parts of the form
  -- Inactive 3D view
  !this.vwView3D.active   = false
  -- Make properties and plotfile buttons inactive
  !this.ok.active         = false
  !this.plotfile.active   = false
  !this.properties.active = false

  !equi = !element

  if (!this.savedSort.set()) then
  	!this.sortSpecs.val = !this.savedSort
  endif

  if(!equi.hardType ne 'EQUI') then
    -- find an equipment element
    !types[1] = 'EQUI'
    !tempDbRef = !!dtbOwnerOfTypes(!equi, !types)
    if (!tempDbRef.unset()) then
      return error 1 'Unable to navigate to an equipment element'
    else
      !equi = !tempDbRef
    endif
  endif

  !this.equipment = !equi
  !!ce = !this.equipment

  !this.name.val = !this.equipment.flnn

  !spec = !this.equipment.spref
  if (badRef(!spec)) then
    -- Initialise SPEC part of form
    !this.init(|EQUI|,|EQUI|)

    -- Initialise Table part of the form
--    !this.tableChooseData.setData(|EQUI|,|EQUI|)
    !this.tableChooseData.setData(!equi,|EQUI|,|EQUI|)
    !this.initialiseTables()
    !this.initTable(false)
    return
-- P-3059
  else
      !this.template = object COMPROP(!equi)
  endif

  if( !spec.hardType eq 'SPCO' ) then
    -- initialise for SPEC EQUI
    !this.frSpecType.val = 2
    !this.enableSpecificationTable(false)
    !this.clearSelection()
    !this.init(!spec)
  elseif( !spec.hardType eq 'TABITE' ) then
    -- Initialise for Table EQUI
    !this.tableChooseData.setData(!element,|EQUI|,|EQUI|)
    !designItem = !this.tableChooseData.getDesignItem()
    -- Set forms current element
    if (!designItem.badRef()) then
      return error 1 |Unknown equipment database reference - equipment may have been deleted. Close form and try again|
    endif
    !this.name.val       = !designItem.fullname
    !this.equipment      = !designItem
    !this.initialiseTables()
    !this.frSpecType.val = 1
    !this.enableSpecificationTable(true)
    -- pre-select this element in the table
    !this.selectTableItem()
  else
    -- direct pointer to GPART
    -- Initialise for Table EQUI
    !this.tableChooseData.setData(!element, object DBREF())
    !designItem = !this.tableChooseData.getDesignItem()
    -- Set forms current element
    if (!designItem.badRef()) then
      return error 1 |Unknown equipment database reference - equipment may have been deleted. Close form and try again|
    endif
    !this.equipment      = !designItem
    !this.name.val       = !designItem.fullname
    !this.initialiseTables()
    !this.initTable(false)
    !this.frSpecType.val = 1
    !this.enableSpecificationTable(true)
  endif

endmethod
-- End of method definition for .initialiseForm()

------------------------------------------------------------------------
--
-- Method:      enableSpecificationTable
--
-- Description: Enable Specification Table selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Selection Table. False for Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enableSpecificationTable(!enabled is BOOLEAN)

  if(!enabled) then
    !this.ok.callback = '!this.tableApply()'
  else
    !this.ok.callback = '!this.specApply()'
  endif

  !noUpdateDisplay = ( !this.tFrame.visible and !enabled ) or ( !this.sFrame.visible and !enabled.not() )

  if( !noUpdateDisplay ) then
    -- Nothing to do - avoids multiple refresh of form
    return
  endif

  -- Select toggle and grey out Specifications
  !this.opSelTables.active    = !enabled
  !this.specifications.active = !enabled.not()
  !this.sortSpecs.active    = !enabled.not()

  !this.sFrame.visible = !enabled.not()
  !this.tFrame.visible = !enabled

  if(!this.sFrame.visible) then
    -- check for spec item already selected
    !this.specSelect()
  else
    -- check for table item already selected
    !this.tableSelect(!this.netSelTabItems.getSelectedRowTags())
  endif

endmethod
-- End of method definition for .enableSpecificationTable()

------------------------------------------------------------------------
--
-- Method:      specSelect
--
-- Description: called when spec selected
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .specSelect()

  if (!this.selectionDone()) then

    -- Initialise Variables
    !selectedSpre = !this.specLink.selection()

    -- return an error if the templates catalogue pointers are not there
    !element = object DBREF()
    if(!selectedSpre.tmpr.badRef().not()) then
      if(!!tmpCheckValidity(!selectedSpre.tmpr, !element).not()) then
        !message[1]  = 'The selected template has invalid catalogue references.'
        !message[2]  = 'Element $!element.type $!element has an invalid SPREF.'
        !message[3]  = 'It is likely that the following'
        !message[4]  = 'databases are not present in the current MDB :- '
        !message[5]  = '     MASTER/PIPEOLD '
        !message[6]  = '     MASTER/PIPECATA '
        !message[7]  = '     MASTER/EQUICATA '
        !message[8]  = '     MASTER/ASLCATA '
        !message[9]  = '     MASTER/STLCATA '
        !message[10] = 'Contact your system administrator to include these databases'
        !message[11] = 'from the MAS000 project.'
        -- set the message on the error form
        !!comErrorMessage.message = !message
        handle ANY
         pml load form !!comErrorMessage
          !!comErrorMessage.message = !message
        endhandle
         show !!comErrorMessage
         handle ANY
          !!alert.error('The selected template has elements with invalid catalogue references. See project administrator to include MAS000.')
         endhandle
         return
      endif
    endif

    !this.madeSelection(!selectedSpre.tmpr)

    -- initialise properties object
    !this.initialiseProperties(!selectedSpre)

  else

    !this.clearSelection()

  endif

endmethod
-- End of method definition for .specSelect()

-----------------------------------------------------------------------
--
-- Method:      specTypeCallback
--
-- Description: Enable Specification Table selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .specTypeCallback()

  -- clear selection if made with other type
  !this.clearSelection()
  -- Select toggle and grey out Specifications
  !this.enableSpecificationTable( ( !this.frSpecType.val eq 1 ) )

endmethod
-- End of method definition for .specTypeCallback()

------------------------------------------------------------------------
--
-- Method:      .init(STRING, STRING)
--
-- Description: Initialise Form with given spec type
--
-- Method Type: Function/Procedure
-- Arguments:
--    1   R      STRING      Spec world type (PURP)
--    2   R      STRING      Spec type (PURP)
--
------------------------------------------------------------------------
define method .init(!spwlType is STRING, !specType is STRING)

  -- check for change to current spec
  if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
    -- spec changed, reset form
    !this.specSearch.spwlType = !spwlType
    !this.specSearch.type     = !specType
    !this.specSearch.search()
    !this.specLink.specification(!this.specifications, !this.specSearch)
    !this.specLink.sort(!this.sortSpecs)
    -- re-link auto select gadget with current setting
    !this.specLink.autoSelect(!this.autoSelect)
  endif
  !this.specLink.setup( object SPCSPECIFICATION() )

  !this.specCallback()

endmethod
-- End of method definition for .init(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .init(DBREF)
--
-- Description: Initialise Form with given SPEC or SPCO DBREF
--
-- Method Type: Function/Procedure
-- Arguments:
--    1   R      DBREF       DBREF of SPCO used to initialise this form
--
------------------------------------------------------------------------
define method .init(!spec is DBREF)

  -- get type of SPEC
  !specEl   = SPEC OF $!<spec>
  !specType = !specEl.purp
  !spwlEl   = SPWL OF $!<spec>
  !spwlType = !spwlEl.purp

  -- check that form is initialised for this type of object
  if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
    !this.specSearch.spwlType = !spwlType
    !this.specSearch.type     = !specType
    !this.specSearch.search()
    !this.specLink.specification(!this.specifications, !this.specSearch)
    !this.specLink.sort(!this.sortSpecs)
  endif

  -- set form to existing spec
  !this.specLink.specData.selector(!spec)
  !this.specLink.setup(!this.specLink.specData)
-- P-3059  !this.specLink.specification(!this.specifications, !this.specSearch)

  -- re-link auto select gadget with current setting
  !this.specLink.autoSelect(!this.autoSelect)

  !this.specCallback()

endmethod
-- End of method definition for .init(DBREF)
------------------------------------------------------------------------
--
-- Method:      initialiseTables
--
-- Description: Initialisation selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseTables()

  -- Set form title and list tags
  !this.formTitle       = |Modify | & !this.tableChooseData.formTitle
  !this.opSelTables.tag = !this.tableChooseData.tableTag
  !this.opSelTypes.tag  = !this.tableChooseData.typeTag

  -- Set selection tables
  !this.selTables = !this.tableChooseData.getSelTabs()

  -- Populate the table list
  !this.initSelTableList()

  -- Populate the type list
  !this.initSelTypeList()

endmethod
-- End of method definition for .initialiseTables()

-----------------------------------------------------------------------
--
-- Method:      initSelTableList
--
-- Description: Initialise selection table option list (TABGROUP)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTableList()

  if (!this.selTables.size() gt 0) then
    if( !this.opSelTables.val eq 0 or !this.opSelTables.val gt !this.selTables.size() ) then
      !selectionTableIndex = 1
    else
      !selectionTableIndex = !this.opSelTables.val
    endif
    -- Populate table group option list
    !dText = !this.selTables.evaluate(object BLOCK(|!this.selTables[!evalIndex].name|))
    !this.opSelTables.dText = !dText
    !this.opSelTables.val   = !selectionTableIndex
    -- Set selected table
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!selectionTableIndex])
  else
    -- Set list for none
    !dText[1] = 'None'
    !this.opSelTables.dText = !dText
    -- Unset selected table group
    !this.selectedSelTab = object SELECTIONTABLE()
  endif

endmethod
-- End of method definition for .initSelTableList()
------------------------------------------------------------------------
--
-- Method:      initSelTypeList
--
-- Description: Initialise selection type option list (CTABLE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTypeList()

  if (!this.selTables.size() gt 0) then

    -- Get types for selected table
    !types = !this.selectedSelTab.getTypes()

    -- Populate type list
    if (!types.set()) then
      !this.opSelTypes.dText = !types

      -- Select specified table type
      if (!this.tableChooseData.tableType.set()) then
        -- Get type index for specified type
        !typeIndex = REAL()
        do !ind indices !types
          if (!types[!ind].trim().upcase() eq !this.tableChooseData.tableType) then
            !typeIndex = !ind
            break
          endif
        enddo
        -- Select table type in option list and selection table object
        if (!typeIndex.set()) then
          !this.opSelTypes.val = !typeIndex
        else
          !!alert.warning(|Invalid table type specified in !!stChooseData global object. The first type in the table will be selected!|)
        endif
      endif

    else
      !dText[1] = 'None'
      !this.opSelTypes.dText = !dText
    endif

  -- Set list for none
  else
    !dText[1] = 'None'
    !this.opSelTypes.dText = !dText
  endif

endmethod
-- End of method definition for .initSelTypeList()

------------------------------------------------------------------------
--
-- Method:      initTable
--
-- Description: Initialise the selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Pre-select current design item if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTable(!preSelect is BOOLEAN)

  -- Clear 3D view
  !this.clearView()

  -- Show choose list
  if (!this.opSelTypes.selection() ne 'None')then
    !this.selectedSelTab.setType(!this.opSelTypes.val)
    !this.choose(!this.equipment, !preSelect)
  else
    -- Clear choose list - note causes selection callback
    !this.netSelTabItems.clearGrid()
  endif

endmethod
-- End of method definition for .initTable()

------------------------------------------------------------------------
--
-- Method:      clearView
--
-- Description: Clear the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearView()

  -- Clear 3D view
  if (!this.drawlist.set()) then
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    !this.vwView3D.active = false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectTableItem
--
-- Description: Initialise the selected Type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectTableItem()

  -- find current selection table
  !cTable       = !this.tableChooseData.getItemSelectionTable()
  if( !cTable.unset() ) then
    return
  endif
  !typeName     = !cTable.description
  !tableGroup   = !cTable.owner
  !tableName    = !tableGroup.name

  -- select table from table list
  !this.opSelTables.select('RTEXT',!tableName)
  handle any
    return
  endhandle
  !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
  !this.initSelTypeList()

  -- select type from type list
  !this.opSelTypes.select('RTEXT',!typeName)
  handle any
    return
  endhandle

  -- initialise table and pre-select for current design item
  !this.initTable(true)

endmethod
-- End of method definition for .selectTableItem()

------------------------------------------------------------------------
--
-- Method:      actions
--
-- Description: Gadget actions for main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actions(!object is GADGET, !action is STRING)

  -- Table group option list
  if (!object eq !this.opSelTables and !action eq |SELECT|) then
    -- P-3655
    if( not defined(!this.selTables[!this.opSelTables.val]) ) then
      return
    endif
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
    !this.initSelTypeList()
    !this.saveToXml()
    !this.initTable(true)
    !this.loadFromXml()

  -- Selection table option list
  elseif (!object eq !this.opSelTypes and !action eq |SELECT|) then
    !this.saveToXml()
    !this.initTable(true)
    !this.loadFromXml()

  else

    return

  endif

endmethod
-- End of method definition for .actions()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design item DBREF
--    2   R      BOOLEAN     Pre-select item if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choose(!designItem is DBREF, !preSelect is BOOLEAN)

  -- set up pre-select if required
  if( badref(!designItem) ) then
    return error 1 |Invalid design element|
  endif

  -- set reference of TABITEM if pre-selection required
  if( !preSelect ) then
    !selectItem   = !designItem.spref
  else
    !selectItem   = object DBREF()
  endif

  -- get user defined element type of this element
  !userType       = !designItem.actType
  if( !userType.subString(1,1) eq ':' ) then
    !userType     = !userType.subString(2)
  endif
  !questions      = ARRAY()
  !answers        = ARRAY()
  !questions[1]   = 'TYPE'
  !answers[1]     = !userType

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  !choiceItems = !this.selectedSelTab.choose(!designItem, !questions, !answers, |TEXT|, !this.tgDefault.val)

  -- Save choices
  !this.choices.clear()
  do !ind indices !choiceItems
    !this.choices.append(!choiceItems[!ind].removeFirst())
  enddo

  -- find pre-select item
  if( badref( !selectItem ) ) then
    !matchItemIndex = 0
  else
    !matchItemIndex = !this.choices.findFirst(!selectItem)
    if( !matchItemIndex.unset() ) then
      -- make sure that item is not filtered out by UDET
      !questions      = ARRAY()
      !answers        = ARRAY()
      -- Get choice from selection table (answer data types converted to text)
      !extraItems = !this.selectedSelTab.choose(!designItem, !questions, !answers, |TEXT|, !this.tgDefault.val)
      -- extract choices from results
      !extraChoice    = ARRAY()
      -- get array of chosen items
      do !ind indices !extraItems
        !extraChoice.append(!extraItems[!ind].removeFirst())
      enddo
      !matchItemIndex = !extraChoice.findFirst(!selectItem)
      if( !matchItemIndex.unset() ) then
        -- item still not found in this table
        !matchItemIndex = 0
      else
        -- item found - must be different type
        !choiceItems.insert(1, !extraItems[!matchItemIndex])
        !this.choices.insert(1, !selectItem)
        !matchItemIndex = 1
      endif
    endif
  endif

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()
  !this.netSelTabItems.resetColumnProperties()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)

  -- Select matching item in the list
  if( !matchItemIndex gt 0 ) then
    !this.netSelTabItems.selectRow(!matchItemIndex)
  endif

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .close()

  !this.template.deleteObject(true)
  !this.savedSort = !this.sortSpecs.val
  !this.hide()

  -- Saves the forms layout when shut down, if user has messed with layout.
  !file = !this.pdmsuser & '\equimodsprefstate.xml'
  !this.netSelTabItems.saveLayoutToXml(!file)
  handle any
  endhandle

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .loadFromXml()
--
-- Description: Restore saved state of grid control
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .loadFromXml()

-- P-18668
-- This method is disabled temporarily because it causes problems when the
-- number of headings and the column properties change for the same grid
-- gadget. The minimum needed here is to be able to cache headings etc.
-- and only restore the grid properties if grid layout is identical
return

-- Sets up the form to be same as when shut down, if user has messed with layout.
  !file = object FILE(!this.pdmsuser & '\equimodsprefstate.xml')

  if (!file.exists()) then
    !this.netSelTabItems.loadGridFromXml(!file.fullname())
    handle any
    endhandle
  endif

endmethod
-- End of method definition for .loadFromXml()
------------------------------------------------------------------------
--
-- Method:      .saveToXml()
--
-- Description: Save selection grid state to xml for reloading
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .saveToXml()

-- Saves the forms layout when shut down, if user has messed with layout.
    --!file = !this.pdmsuser & '\equimodsprefstate.xml'
    --!this.netSelTabItems.saveLayoutToXml(!file)
    -- handle any
    --endhandle

endmethod
-- End of method definition for .saveToXml()

------------------------------------------------------------------------
--
-- Method:      .specApply()
--
-- Description: OK callback changes SPREF of Equipment
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .specApply()

  -- Initialise Variables
  !selectedSpre = !this.specLink.selection()

  -- error if selection not complete - must be a SPCO
  if( !selectedSpre.type.upcase() ne 'SPCO' ) then
    !!alert.error( 'Specification selection not complete' )
    return
  endif

  -- initialise undo
  !undoModify = object UNDOABLE()
  !undoModify.description('Modify Equipment Spec.')
  !undoModify.add()
  !this.template.designElement(!this.equipment)
  !this.template.setProperties()
  !this.template.unsetDesiElement()
  !undoModify.endUndoable()


endmethod
-- End of method definition for .specApply()

------------------------------------------------------------------------
--
-- Method:      tableApply
--
-- Description: Set spref of design element to selected table item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tableApply()

  if (!this.selectedItem.badRef().not()) then
    !designItem = !this.equipment
    !undoModify = object UNDOABLE()
    !undoModify.description('Modify Equipment Table Select')
    !undoModify.add()
    !this.template.designElement(!designItem)
    !this.template.setProperties()
    !this.template.unsetDesiElement()

    -- Set any attributes specified in selection table
    !attribs = !this.selectedSelTab.getDesAttributes(!this.selectedItem)
    do !ind indices !attribs
      !designItem.attribute(!attribs[!ind][1]) = !attribs[!ind][2]
      handle any
        -- q var !!error.text
      endhandle
    enddo
    !undoModify.endUndoable()

  else
    !!alert.warning(|Bad selection table item definition, spref will not be modified!|)
  endif

endmethod
-- End of method definition for .tableApply()

------------------------------------------------------------------------
--
-- Method:      selectionDone
--
-- Description: check to see if selection is complete (spec ref to SPCO)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     true if SPCO selected, false otherwise
------------------------------------------------------------------------
define method .selectionDone() is BOOLEAN

  -- Initialise Variables
  !result       = false
  !selectedSpre = !this.specLink.selection()

  if(!selectedSpre.badRef().not()) then
    if(!selectedSpre.type.upcase() eq 'SPCO' and !selectedSpre.tmpr.badRef().not()) then
    -- error if selection not complete - must be a SPCO
     !result = (!selectedSpre.type.upcase() eq 'SPCO')
    endif
  endif

  return !result

endmethod
-- End of method definition for .selectionDone() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      specCallBack
--
-- Description: called when spec selected
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .specCallback()

  if (!this.selectionDone()) then
    !this.ok.active       = true

    -- Initialise Variables
    !selectedSpre = !this.specLink.selection()

    -- initialise properties object
    if (!selectedSpre eq !this.equipment.spref) then
      !this.template.initialise(!this.equipment)
      !this.template.editMode('STORE')
    else
      !this.template.initialise(!selectedSpre)
    endif
    !this.template.editFormBlockOwn(true)

    -- set the properties button active, check for properties on spco
    !this.properties.active = true

    -- set the plotfile callback
    if (!this.template.checkPlot()) then
      !this.plotfile.active = true
    else
      !this.plotfile.active = false
    endif

    !this.madeSelection(!selectedSpre.tmpr)

  else

    !this.clearSelection()

  endif

endmethod

-- End of method definition for .specCallback()

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!a is ARRAY)

  -- Item is selected
  if (!a[0].set()) then

    -- Selected table item
    !this.tableSelect(!a[0])

  else

    -- Item is not selected
    -- Deactivate buttons
    !this.clearSelection()

  endif

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After selection from Selection Table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tableSelect(!rowID is ARRAY)

  -- Item is selected
  !chosenItem = !rowID[1].real()
  handle any
    -- invalid selection
    -- Deactivate buttons
    !this.clearSelection()
    return
  endhandle

  -- Selected table item
  !this.selectedItem = !this.choices[!chosenItem]

  -- Show in 3D view
  if( !this.selectedItem.hardType eq 'TABITE' ) then
    -- points to a table item
    !gPart = !this.selectedItem.prtref
  else
    -- points directly to a GPART
    !gPart = !this.selectedItem
  endif

  if (not badref(!gPart)) then
     -- Get local drawlist
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    if( badref(!gPart.tmpref)) then
      -- Equi must have a valid template reference to be selectable
      !this.clearSelection()
      !!alert.error('The selected item does not have a valid Design Template reference in the catalogue. Please inform your catalogue administrator.')
      return
    else
      !this.madeSelection(!gPart.tmpref)
    endif
  endif

  -- Initialise properties for existing item
  !this.initialiseProperties(!this.selectedItem)

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      clearSelection
--
-- Description: Reinitialise selection gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearSelection()

  !this.ok.active         = false
  !this.plotfile.active   = false
  !this.properties.active = false
  -- Clear 3D view

  -- Get local drawlist
  if (!this.drawlist.set()) then
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
   endif
  !this.vwView3D.active   = false

endmethod
-- End of method definition for .clearSelection()

------------------------------------------------------------------------
--
-- Method:      madeSelection
--
-- Description: Update 3D display after selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selected Catalogue or Template item
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .madeSelection(!selectedItem is DBREF)

  !this.ok.active         = true

  -- show selection in 3D view
  !!gphViews.limits(!this.vwView3D, !selectedItem)
  !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
  !drawlist.add(!selectedItem)
  !this.vwView3D.active = true

endmethod
-- End of method definition for .madeSelection()

------------------------------------------------------------------------
--
-- Method:      initialiseProperties
--
-- Description: Initialise properties for selected item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selected Catalogue or Template item
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseProperties(!selectedItem is DBREF)

  !this.template.initialise(!selectedItem)
  handle any
    !this.properties.active = false
    !this.plotfile.active   = false
  elsehandle none
    !this.template.editFormBlockOwn(true)
    !this.template.autoCacheValues(true)
    !this.properties.active = true
    !this.plotfile.active   =!this.template.checkPlot()
  endhandle

endmethod
-- End of method definition for .initialiseProperties()

---------------------------------------------------------------------------
-- Form Events
---------------------------------------------------------------------------

define method .dataGridOnPopup(!data is ARRAY)	
	!this.conSelTabItems.popup = !this.popupMenu
  !this.conSelTabItems.showPopup(!data[0], !data[1])
endmethod
