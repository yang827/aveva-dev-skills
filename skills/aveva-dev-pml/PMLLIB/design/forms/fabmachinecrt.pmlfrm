------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkCopyName()                  BOOLEAN             Called to check that the name of the element in the copy field is appropriate
--  create()                         -
--  init()                           -
--  modify()                         -
--
------------------------------------------------------------------------
setup form !!fabMachineCrt dialog

title    |Create|
init     |!this.init()|

text .name |Name:       | at x1 ymax+0.5 callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 32 name
!this.name.val = |$_CDSYSNAM_NAME|

path down
halign left
text   .desc |Description:|  width 32 STRING

toggle .copy  '' at x6 ymax+0.5 callback '!this.copyName.active = !this.copy.val'
text .copyName |Copy:| at xmax ymin callback '!this.checkCopyName()' width 32 name

button .apply   | Apply | at x1 ymax+0.5 call |!this.create()|
button .dismiss |Dismiss| at xmax form-size ymin  cancel

-----Member Variables-----
--Creation mode flag
member .mode       is STRING
--Create type
member .type       is STRING
-- Item to Modify/place to create
member .current    is DBREF
-- Undoable member
member .undo       is UNDOABLE

exit
-------------------------------------------------------------------------------------
-- Method: .init
--
-- Description:
-- Called when the form is called. Initialises the gadgets on the form.
-------------------------------------------------------------------------------------
define method .init()

   -- Undoable
   !this.undo.description('')
   !this.undo.undoAction('')
   !this.undo.redoAction('')
   !this.apply.setUndoable(!!fabMachineCrt.undo)

   if !this.mode.eq('new') then
      !this.apply.callback  = '!this.create()'
      !this.copy.active     = true
      !this.copy.val        = false
      !this.copyName.active = false
   elseif !this.mode.eq('modify') then
      !this.apply.callback = '!this.modify()'

      !this.name.val = !this.current.name
      !this.desc.val = !this.current.desc
      !this.copy.active     = false
      !this.copy.val        = false
      !this.copyName.active = false
   endif

endmethod
-------------------------------------------------------------------------------------
-- Method: .create
--
-- Description:
-- Called when the Create button is pressed when the form is in new mode.
-- Creates the required element with the attributes defined by the user in the form.
-------------------------------------------------------------------------------------
define method .create()

   !!ce = !this.current

   --check that the name gadget is populated
   if !this.name.val.eq('unset').or(!this.name.val.eq('')) then
      !!alert.message('Please enter a name for the new fabrication machine')
      return
   elseif !this.desc.val.eq('')then
      !!alert.message('Please enter a description for the fabrication machine')
      return
   endif

   -- Clear Aids
   AID CLEAR ALL

   -- Create new elements
   if (!this.copy.val eq true and !this.checkCopyName()) then
   	 new $!this.type $!this.name.val copy $!this.copyName.val rename $!this.copyName.val $!this.name.val
   else  	
   	 new  $!this.type
     name $!this.name
   endif
   desc '$!this.desc'
   if !this.type.eq('FMWL') then
      !this.owner().getWorld('World')
   elseif !this.type.eq('FMGRP') then
      !this.owner().getWorld('Group')
   elseif !this.type.eq('FMWELD') then
      !this.owner().getWorld('BendWeld')
      !this.owner().selectcurrent(!!ce)
   elseif !this.type.eq('FMBEND') then
      !this.owner().getWorld('BendWeld')
      !this.owner().selectcurrent(!!ce)
   endif

endmethod
-------------------------------------------------------------------------------------
-- Method: .modify
--
-- Description:
-- Called when the Modify button is pressed when the form is in modify mode.
-- Sets the attributes for the selected container.
-------------------------------------------------------------------------------------
define method .modify()

   !!ce = !this.current

   --check that the name gadget is populated
   if !this.name.val.eq('unset').or(!this.name.val.eq('')) then
      !!alert.message('Please enter a name for the new fabrication machine')
      return
   elseif !this.desc.val.eq('')then
      !!alert.message('Please enter a description for the fabrication machine')
      return
   endif

   name $!this.name
   desc '$!this.desc'
   if !this.type.eq('FMWL') then
      !this.owner().getWorld('World')
   elseif !this.type.eq('FMGRP') then
      !this.owner().getWorld('Group')
   elseif !this.type.eq('FMWELD') then
      !this.owner().getWorld('BendWeld')
      !this.owner().selectcurrent(!!ce)
   elseif !this.type.eq('FMBEND') then
      !this.owner().getWorld('BendWeld')
      !this.owner().selectcurrent(!!ce)
   endif

endmethod

-------------------------------------------------------------------------------------
-- Method: .checkCopyName
--
-- Description:
-- Called to check that the name of the element in the copy field is appropriate
-------------------------------------------------------------------------------------
define method .checkCopyName() is BOOLEAN

   -- Check for initial /
   if (!this.copyName.val.match('/') eq 1) then
   	 !name = !this.copyName.val
   else
   	 !name = '/' & !this.copyName.val
   	 if (!name.trim().length() eq 1) then
   	   return FALSE
   	 else
   	   !this.copyName.val = !name
   	 endif
     !test = object DBREF(!name)
     handle ANY
       -- Invalid name
       !!alert.error('Bad copy name')
       return FALSE
     elsehandle NONE
       if (!test.type eq !this.type) then
       	 -- OK
       else
         -- Invalid name
         !!alert.error('Copy element not of the correct type')
         return FALSE
       endif
     endhandle
   endif

   -- Valid name
   return TRUE

endmethod
