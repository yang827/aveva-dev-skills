--
-- Macro Generic Type: Form Definitions
--
--  Description:     Used to create Fabrication Machine data and called by FABMACHINEMGR
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  calculate()                      -                   Calculates bend Radius in paragraph gadget
--  convert()                        -                   Converts a distance bend radius to the bend Radius gadget (1D 2D etc.)
--  create()                         -
--  init()                           -
--  modify()                         -
--  validateMaterial(GADGET,STRING)  -                   Validate input to material gadgets
--
------------------------------------------------------------------------
setup form !!fabMachineDat dialog

title    |Create|
init     |!this.init()|

path down
paragraph .macNoPara anchor T+L+R at xmin+0.5 ymin+0.5 text || width 10

frame .crtFMBDIM at x0 ymax.macNoPara
   text .odDim        'Outer Diameter:' at xmin+0.5 ymin+0.5 width 18 is REAL format !!fabMachineMgrOdWallFmt
   text .wThickDim    'Wall Thickness:' at xmin ymax+0.2 width 18 is REAL format !!fabMachineMgrOdWallFmt
   text .gripDim      '          Grip:' at xmin ymax+0.2 width 18 is REAL format !!distanceFmt
   text .mleFlangeDim '     MLEFlange:' at xmin ymax+0.2 width 18 is REAL format !!distanceFmt
   text .mliFlangeDim '     MLIFlange:' at xmin ymax+0.2 width 18 is REAL format !!distanceFmt
   text .fcMeasureDim '     FCMeasure:' at xmin ymax+0.2 width 18 is REAL format !!distanceFmt
   text .bendRadDim   '       BRadius:' at xmin ymax+0.2 callback '!this.calculate()' width 18 is REAL format !!fabMachineMgrPropRealFmt
   paragraph .bendRadNote at xmin ymax text |Bend Radius converts to (BRadius x OD)| width 35
   text .bRadConvert  'Measuring...   ' at xmin ymax callback '!this.convert()' width 18 is REAL format !!distanceFmt
   toggle .awdFlnDim  'Auto-Weld Flanges' at xmin ymax+0.2
exit

frame .crtFMBPLN at x0 ymax.macNoPara
   frame .minPos |Minimum Plane Position| at xmin+0.5 ymin+0.5
      text .xmin '   x position:' at xmin+0.5 ymin+1 width 18 is REAL format !!distanceFmt
      text .ymin '   y position:' at xmin ymax+0.4 width 18 is REAL format !!distanceFmt
      text .zmin '   z position:' at xmin ymax+0.4 width 18 is REAL format !!distanceFmt
   exit

   frame .maxPos |Maximum Plane Position|
      text .xmax '   x position:' at xmin+0.5 ymin+1 width 18 is REAL format !!distanceFmt
      text .ymax '   y position:' at xmin ymax+0.4 width 18 is REAL format !!distanceFmt
      text .zmax '   z position:' at xmin ymax+0.4 width 18 is REAL format !!distanceFmt
   exit
exit

frame .crtFMBSST at x0 ymax.macNoPara width 38
   text .odSST        '    Outer Diameter:' at xmin+0.5 ymin+0.5 width 14 is REAL format !!fabMachineMgrOdWallFmt
   text .wThickSST    '    Wall Thickness:' at xmin ymax+0.2 width 14 is REAL format !!fabMachineMgrOdWallFmt
   text .matRefSST    'Material Reference:' at xmin ymax+0.2 width 12 is STRING
   button .bnCompEditMatxtS at xmax+0.2 ymin pixmap width 1


   frame .springback |Springback| at x0.5 ymax
      text .angSPASST    '   At Angle 20:' at xmin+0.5 ymin+0.6 width 14 is REAL format !!angleFmt
      text .angSPBSST    '  At Angle 120:' at xmin ymax+0.2 width 14 is REAL format !!angleFmt
   exit

   frame .stretch |Stretch Factor|
      text .stfPropSST   '  Proportional:' at xmin+0.5 ymin+0.6 width 14 is REAL format !!fabMachineMgrPropRealFmt
      text .stfConstSST  '      Constant:' at xmin ymax+0.2 width 14 is REAL format !!fabMachineMgrPropRealFmt
   exit
exit

frame .crtFMWSK at x1 ymax.macNoPara
   text .sKey     'Skey' at x1 y1 width 20 is STRING
exit

button .apply   | Apply | at x0.3 ymax.crtFMBDIM+1 call |!this.create()|
button .dismiss |Dismiss| at xmax form-size ymax.crtFMBDIM+1 cancel

-----Member Variables-----
--Creation mode flag
member .mode       is STRING
--Create type
member .type       is STRING
-- Item to Modify/place to create
member .current    is DBREF
-- Relevant to FMBDIM FMBPLN and FMBSST to specify the attribute number.
member .macNo      is REAL
-- Undoable member
member .undo       is UNDOABLE

-- temporary storage
member .tempSTFC is REAL
member .tempSTFP is REAL

exit
-------------------------------------------------------------------------------------
-- Method: .init
--
-- Description: Called when the form is called. Initialises the gadgets on the form.
-------------------------------------------------------------------------------------
define method .init()

   !searchIcon    = !!pml.getpathname('ng_zoomtoselection.png')

   -- Validate call on the Matref
   !this.matRefSST.validateCall = '!this.validateMaterial('

   -- Undoable
   !this.undo.description('')
   !this.undo.undoAction('')
   !this.undo.redoAction('')
   !this.apply.setUndoable(!!fabMachineDat.undo)

   if !this.type.eq('FMBDIM') then
      if !this.mode.eq('new') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.create()'

         !this.odDim.val = 0
         !this.wThickDim.val = 0
         !this.gripDim.val = 0
         !this.mleFlangeDim.val = 0
         !this.mliFlangeDim.val = 0
         !this.fcMeasureDim.val = 0
         !this.bendRadDim.val = 0
         !this.bRadConvert.clear()
         !this.awdFlnDim.val = TRUE
      elseif !this.mode.eq('modify') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.modify()'

         !this.odDim.val = !this.current.od
         !this.wThickDim.val = !this.current.wThickness
         !this.gripDim.val = !this.current.grip
         !this.mleFlangeDim.val = !this.current.mleFlange
         !this.mliFlangeDim.val = !this.current.mliFlange
         !this.fcMeasureDim.val = !this.current.fcMeasure
         !this.bendRadDim.val = !this.current.bRadius
         !this.bRadConvert.clear()
         !this.awdFlnDim.val = !this.current.awdFln
      endif


      !this.gripDim.setTooltip('Minimum distance between bends')
      !this.mleFlangeDim.setTooltip('Minimum length excluding flange')
      !this.mliFlangeDim.setTooltip('Minimum length including flange')
      !this.fcMeasureDim.setTooltip('Flange correction measure')
      !this.awdFlnDim.setTooltip('Bending machine accepts auto-welded flanges')
      !this.crtFMBDIM.visible = TRUE
      !this.crtFMBPLN.visible = FALSE
      !this.crtFMBSST.visible = FALSE
      !this.crtFMWSK.visible  = FALSE

      -- Display the Bend Radius
      !this.calculate()

   elseif !this.type.eq('FMBPLN') then
      if !this.mode.eq('new') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.create()'

         !this.xmin.val = 0
         !this.ymin.val = 0
         !this.zmin.val = 0
         !this.xmax.val = 0
         !this.ymax.val = 0
         !this.zmax.val = 0
      elseif !this.mode.eq('modify') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.modify()'

         !this.xmin.val = !this.current.minPlnPosition.east
         !this.ymin.val = !this.current.minPlnPosition.north
         !this.zmin.val = !this.current.minPlnPosition.up
         !this.xmax.val = !this.current.maxPlnPosition.east
         !this.ymax.val = !this.current.maxPlnPosition.north
         !this.zmax.val = !this.current.maxPlnPosition.up
      endif

      !this.crtFMBDIM.visible = FALSE
      !this.crtFMBPLN.visible = TRUE
      !this.crtFMBSST.visible = FALSE
      !this.crtFMWSK.visible  = FALSE
   elseif !this.type.eq('FMBSST') then
      if !this.mode.eq('new') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.create()'

         !this.odSST.val = 0
         !this.wThickSST.val = 0
         !this.matRefSST.clear()
         !this.angSPASST.val = 20.0
         !this.angSPBSST.val = 120.0
         !this.tempSTFP = 0.0
         !this.tempSTFC = 1.0
         !this.stfPropSST.val  = !this.tempSTFP
         !this.stfConstSST.val = !this.tempSTFC
      elseif !this.mode.eq('modify') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.modify()'

         !this.odSST.val = !this.current.od
         !this.wThickSST.val = !this.current.wThickness
         !this.matRefSST.val = !this.current.matRef.attribute('Name')
         handle ANY
            !this.matRefSST.clear()
         endhandle
         !this.angSPASST.val = !this.current.angSPA
         !this.angSPBSST.val = !this.current.angSPB
         !this.stfPropSST.val = !this.current.stfProportional
         !this.tempSTFP = !this.current.stfProportional
         !this.stfConstSST.val = !this.current.stfConstant
         !this.tempSTFC = !this.current.stfConstant
      endif

      !this.matRefSST.setTooltip('Material Reference')
      !this.angSPASST.setTooltip('Springback angle at 20 degrees')
      !this.angSPBSST.setTooltip('Springback angle at 120 degrees')
      !this.stfPropSST.setTooltip('Proportional Stretch Factor')
      !this.stfConstSST.setTooltip('Constant Stretch Factor')
      !this.crtFMBDIM.visible = FALSE
      !this.crtFMBPLN.visible = FALSE
      !this.crtFMBSST.visible = TRUE
      !this.crtFMWSK.visible  = FALSE
      !this.bnCompEditMatxtS.callback    = 'show !!fabSelectMaterial'
      !this.bnCompEditMatxtS.setTooltip('Search for:
SMTE in Cata db
or
SOLI in Prop db')
      !this.bnCompEditMatxtS.addPixmap(!searchIcon)


   elseif !this.type.eq('FMWSK') then
      if !this.mode.eq('new') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.create()'

         !this.sKey.val = ''
      elseif !this.mode.eq('modify') then
         !this.macNoPara.val = 'No: ' + !this.macNo.string()
         !this.apply.callback = '!this.modify()'

         -- Display sKey
         if(!this.current.sKey.set() and !this.current.sKey.length().gt(0) ) then
           !this.sKey.val = !this.current.sKey
         else
           !this.sKey.val = ''
         endif
      endif

      !this.sKey.setTooltip('Valid sKey for Weldable Flange')
      !this.crtFMBDIM.visible = FALSE
      !this.crtFMBPLN.visible = FALSE
      !this.crtFMBSST.visible = FALSE
      !this.crtFMWSK.visible  = TRUE
   endif

endmethod
-------------------------------------------------------------------------------------
-- Method: .create
--
-- Description: Called when the Create button is pressed by the user when the form is in new mode.
-- Creates the required element with the attributes defined by the user in the form.
-------------------------------------------------------------------------------------
define method .create()

   -- Some input validation for new parameter sets
   if !this.type.eq('FMBSST') then
      !val = !!fabMachineCheckParams(!this.stfConstSST.val.real(), !this.stfPropSST.val.real(), TRUE)
      if(!val GT 0) then
         return error 1 'The combination of Proportional and Constant is invalid'
      elseif(!val LT 0) then
         !!alert.message('The combination of Proportional and Constant is potentially invalid')
      endif
      if(!this.odSST.val LE 0) then
         return error 1 'Invalid Outer Diameter'
      endif
      if((!this.wThickSST.val LT 0) OR ((!this.wThickSST.val * 2) GE !this.odSST.val)) then
         return error 1 'Invalid Wall Thickness'
      endif
   elseif !this.type.eq('FMBDIM') then
      if(!this.odDim.val LE 0) then
         return error 1 'Invalid Outer Diameter'
      endif
      if((!this.wThickDim.val LT 0) OR ((!this.wThickDim.val * 2) GE !this.odDim.val)) then
         return error 1 'Invalid Wall Thickness'
      endif
   endif

   !!ce = !this.current
   do !a values !this.current.mem
     !!ce = !a
   enddo

   new  $!this.type

   if !this.type.eq('FMBDIM') then
      !!ce.od = !this.odDim.val
      !!ce.wThickness = !this.wThickDim.val
      !!ce.grip = !this.gripDim.val
      !!ce.mleFlange = !this.mleFlangeDim.val
      !!ce.mliFlange = !this.mliFlangeDim.val
      !!ce.fcMeasure = !this.fcMeasureDim.val
      !!ce.bRadius = !this.bendRadDim.val
      !!ce.awdFln = !this.awdFlnDim.val
   elseif !this.type.eq('FMBPLN') then
      MINPLN E$!this.xmin.val N$!this.ymin.val U$!this.zmin.val
      MAXPLN E$!this.xmax.val N$!this.ymax.val U$!this.zmax.val
   elseif !this.type.eq('FMBSST') then
      !!ce.od = !this.odSST.val
      !!ce.wThickness = !this.wThickSST.val
      !!ce.matRef = !this.matRefSST.val.dbref()
      handle ANY
         matref unset
      endhandle
      !!ce.angSPA = !this.angSPASST.val
      !!ce.angSPB = !this.angSPBSST.val
      !!ce.stfProportional = !this.stfPropSST.val
      !!ce.stfConstant = !this.stfConstSST.val
      !this.tempSTFP = !this.stfPropSST.val.real()
      !this.tempSTFC = !this.stfConstSST.val.real()
   elseif !this.type.eq('FMWSK') then
      !!ce.sKey = !this.sKey.val
   endif

   !this.owner().getWorld('')
   !this.owner().selectcurrent(!!ce)

   hide !!fabMachineDat

endmethod
-------------------------------------------------------------------------------------
-- Method: .modify
--
-- Description: Called when the Apply button is pressed when the form is in modify mode.
-- Sets the attributes for the selected datum.
-------------------------------------------------------------------------------------
define method .modify()

  !!ce = !this.current
  -- If user picked modify, then Add to create new
  if (!this.current.type eq !this.type) then
    -- OK
  else
    !this.create()
    return
  endif

   if !this.type.eq('FMBDIM') then
      !!ce.od = !this.odDim.val
      !!ce.wThickness = !this.wThickDim.val
      !!ce.grip = !this.gripDim.val
      !!ce.mleFlange = !this.mleFlangeDim.val
      !!ce.mliFlange = !this.mliFlangeDim.val
      !!ce.fcMeasure = !this.fcMeasureDim.val
      !!ce.bRadius = !this.bendRadDim.val
      !!ce.awdFln = !this.awdFlnDim.val
      !this.owner().dimGrid.setCellValue(!this.macNo, 'OD', !this.odDim.val.string(!!fabMachineMgrOdWallFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'WThickness', !this.wThickDim.val.string(!!fabMachineMgrOdWallFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'Grip', !this.gripDim.val.string(!!distanceFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'MLEFlange', !this.mleFlangeDim.val.string(!!distanceFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'MLIFlange', !this.mliFlangeDim.val.string(!!distanceFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'FCMeasure', !this.fcMeasureDim.val.string(!!distanceFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'BRadius', !this.bendRadDim.val.string(!!fabMachineMgrPropRealFmt))
      !this.owner().dimGrid.setCellValue(!this.macNo, 'AwdFln', !this.awdFlnDim.val.string())
   elseif !this.type.eq('FMBPLN') then
      if (!this.xmin.val.GT(!this.xmax.val)) then
         return error 1 'X Min > X Max'
      endif
      if (!this.ymin.val.GT(!this.ymax.val)) then
         return error 1 'Y Min > Y Max'
      endif
      if (!this.zmin.val.GT(!this.zmax.val)) then
         return error 1 'Z Min > Z Max'
      endif
      MINPLN E$!this.xmin.val N$!this.ymin.val U$!this.zmin.val
      MAXPLN E$!this.xmax.val N$!this.ymax.val U$!this.zmax.val
      !this.owner().collGrid.setCellValue(!this.macNo, 2, !this.xmin.val.string(!!distanceFmt))
      !this.owner().collGrid.setCellValue(!this.macNo, 3, !this.ymin.val.string(!!distanceFmt))
      !this.owner().collGrid.setCellValue(!this.macNo, 4, !this.zmin.val.string(!!distanceFmt))
      !this.owner().collGrid.setCellValue(!this.macNo, 5, !this.xmax.val.string(!!distanceFmt))
      !this.owner().collGrid.setCellValue(!this.macNo, 6, !this.ymax.val.string(!!distanceFmt))
      !this.owner().collGrid.setCellValue(!this.macNo, 7, !this.zmax.val.string(!!distanceFmt))
      -- Refresh the plane visual
      !this.owner().loadCollisionPlanes()
   elseif (!this.type.eq('FMBSST')) then
      !val = !!fabMachineCheckParams(!this.stfConstSST.val.real(), !this.stfPropSST.val.real(), TRUE)
      if(!val GT 0) then
        return error 1 'The combination of Proportional and Constant is invalid'
      elseif(!val LT 0) then
        !!alert.message('The combination of Proportional and Constant is potentially invalid')
      endif
      !!ce.od = !this.odSST.val
      !!ce.wThickness = !this.wThickSST.val
      !!ce.matRef = !this.matRefSST.val.dbref()
      handle ANY
         matref unset
      endhandle
      !!ce.angSPA = !this.angSPASST.val
      !!ce.angSPB = !this.angSPBSST.val
      !!ce.stfProportional = !this.stfPropSST.val
      !!ce.stfConstant = !this.stfConstSST.val
      !this.owner().sstGrid.setCellValue(!this.macNo, 2, !this.odSST.val.string(!!fabMachineMgrOdWallFmt))
      !this.owner().sstGrid.setCellValue(!this.macNo, 3, !this.wThickSST.val.string(!!fabMachineMgrOdWallFmt))
      if (!this.matRefSST.val.set() and !this.matRefSST.val.trim().length().gt(0)) then
        !this.owner().sstGrid.setCellValue(!this.macNo, 4, !this.matRefSST.val)
      else
        !this.owner().sstGrid.setCellValue(!this.macNo, 4, 'Unset')
      endif
      !this.owner().sstGrid.setCellValue(!this.macNo, 5, !this.angSPASST.val.string(!!angleFmt))
      !this.owner().sstGrid.setCellValue(!this.macNo, 6, !this.angSPBSST.val.string(!!angleFmt))
      !this.owner().sstGrid.setCellValue(!this.macNo, 7, !this.stfPropSST.val.string(!!fabMachineMgrPropRealFmt))
      !this.owner().sstGrid.setCellValue(!this.macNo, 8, !this.stfConstSST.val.string(!!fabMachineMgrPropRealFmt))
   elseif !this.type.eq('FMWSK') then
      !!ce.sKey = !this.sKey.val
      !this.owner().sKeyGrid.setCellValue(!this.macNo, 2, !this.sKey.val)
   endif

endmethod
-------------------------------------------------------------------------------------
-- Method: .calculate
--
-- Description: Calculates bend Radius in paragraph gadget
-------------------------------------------------------------------------------------
define method .calculate()

  !value = !this.odDim.val * !this.bendRadDim.val
  !this.bendRadNote.val = |Bend Radius is (OD x BRadius)|
  !this.bRadConvert.val = !value

endmethod
-------------------------------------------------------------------------------------
-- Method: .convert
--
-- Description:
-- Converts a distance bend radius to the bend Radius gadget (1D 2D etc.)
-------------------------------------------------------------------------------------
define method .convert()

  !this.bendRadDim.val = !this.bRadConvert.val / !this.odDim.val
  handle ANY
    return
  endhandle
  !this.calculate()

endmethod
------------------------------------------------------------------------
--
-- Method:      validateMaterial
--
-- Description: Validate input to material gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateMaterial(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.unset()) then
    -- This is not an error
    return
  endif
  !name = !gadget.val.string().trim()
  if (!name.length().eq(0)) then
    -- This is not an error
    return
  endif

  !test = !name.dbref()
  handle ANY
    !name = '/' & !name
    !test = !name.dbref()
    handle ANY
      return error 1 'Database element SOLI or SMTE name required'
    endhandle
    !gadget.val = !name
  endhandle

  if (!test.type inset('SMTE','SOLI')) then
    -- OK
  else
    return error 1 'Database element SOLI or SMTE name required'
  endif

endmethod
-- End of method definition for .validateMaterial()
