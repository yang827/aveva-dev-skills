----------------------------------------------------------------------------
-- Method: .delete
--
-- Description:
--   Called when the user selects delete from the pop up menu displayed when
-- the user right clicks on either the Fabrication World, Group or Bending,
-- Welding Machine. Deletes the selected container and all its members.
----------------------------------------------------------------------------
define method .delete(!gadget is GADGET)

if !gadget.dtext[1].eq('None Found') then
   !!alert.error('No fabrication machine selected')
else
   !selection = !gadget.selection()
   !!ce = !selection.dbref()
   !!deleteCE()

   if !gadget.eq(!this.world) then
      !this.getWorld('World')
   elseif !gadget.eq(!this.group) then
      !this.getWorld('Group')
   else
      !this.getWorld('BendWeld')
   endif
endif

endmethod
----------------------------------------------------------------------------
-- Method: .deleteDat
--
-- Description:
--   Called when the user selects Delete on the pop up menu shown when the
-- user right clicks on any of the 3 Bending Machine Text gadgets. Deletes the
-- selected datum and all its members.
----------------------------------------------------------------------------
define method .deleteDat(!gadget is ANY)

  -- Initialise variables
  !rows = ARRAY()

  if !gadget.eq('dimGrid') then
     var !sele coll all FMBDIM for $!this.bend
    do !i indices !this.dimGrid.getSelectedRows()
      !rows.append(!this.dimGrid.getSelectedRows()[!i][1].real())
    enddo
  elseif !gadget.eq('collGrid') then
     var !sele coll all FMBPLN for $!this.bend
    do !i indices !this.collGrid.getSelectedRows()
      !rows.append(!this.collGrid.getSelectedRows()[!i][1].real())
    enddo
  elseif !gadget.eq('sstGrid') then
     var !sele coll all FMBSST for $!this.bend
    do !i indices !this.sstGrid.getSelectedRows()
      !rows.append(!this.sstGrid.getSelectedRows()[!i][1].real())
    enddo
  elseif !gadget.eq('skeyGrid') then
     var !sele coll all FMWSK for $!this.fweld
    do !i indices !this.skeyGrid.getSelectedRows()
      !rows.append(!this.skeyGrid.getSelectedRows()[!i][1].real())
    enddo
  endif

  if (!rows.size() eq 0) then
    return
  endif

  -- Get the numbers highest first so as to delete bottom up
  !rows.sort().invert()

  do !i indices !rows
    !!ce = !sele[!rows[!i]].dbref()
    handle ANY
      skip
    endhandle
    !!deleteCE()
  enddo

  !this.getWorld('')

endmethod
----------------------------------------------------------------------------
-- Method: .applyAttChanges
--
-- Description:
-- Called when the user clicks the Apply button for a Bending or Welding
-- Machine. Sets the data for the FMBEND or FMWELD depending on the option
-- selected.
----------------------------------------------------------------------------
define method .applyAttChanges(!type is STRING)
--$p applyAttChanges

   if !type.eq('FMBEND') then
       if !this.bend.dtext[1].neq('None Found') then
          !!ce = !this.bend.selection().dbref()
          !!ce.stfProportional = !this.stfProportional.val
          !!ce.stfConstant = !this.stfConstant.val
          !this.tempSTFP = !this.stfProportional.val.real()
          !this.tempSTFC = !this.stfConstant.val.real()
          !!ce.maxLP = !this.maxLP.val
          !!ce.compensate = !this.compensate.val
          !!ce.awdFln = !this.awdFln.val
          !!ce.bmCloc = !this.bendDir.val
       endif
   elseif !type.eq('FMWELD') then
       if !this.fweld.dtext[1].neq('None Found') then
          !!ce = !this.fweld.selection().dbref()
          !!ce.minOD = !this.minODfweld.val
          !!ce.maxOD = !this.maxODfweld.val
          !!ce.minLP = !this.minLPfweld.val
          !!ce.maxLP = !this.maxLPfweld.val
       endif
   endif

endmethod
----------------------------------------------------------------------------
-- Method: .getWorld
--
-- Description:
-- Restores the data presented in the gadgets of the form using the level
-- flag to define at which level the gadgets should be refreshed at. i.e. If
-- !level = world then world, group and either bend or weld gadgets are all
-- refreshed. If !level = group then group and below are refreshed and so on.
----------------------------------------------------------------------------
define method .getWorld(!level is STRING)

   if !level.eq('World') then
      !this.getGroup(!this.world, 'FMWL', '/*')
      !this.getGroup(!this.group, 'FMGRP', '$!this.world')
      if (!this.machineTypeOption.selection() eq 'BENDING') then
         !this.getGroup(!this.bend, 'FMBEND', '$!this.group')
      elseif (!this.machineTypeOption.selection() eq 'WELDING') then
         !this.getGroup(!this.fweld, 'FMWELD', '$!this.group')
      endif
   elseif !level.eq('Group') then
      !this.getGroup(!this.group, 'FMGRP', '$!this.world')
      if (!this.machineTypeOption.selection() eq 'BENDING') then
         !this.getGroup(!this.bend, 'FMBEND', '$!this.group')
      elseif (!this.machineTypeOption.selection() eq 'WELDING') then
         !this.getGroup(!this.fweld, 'FMWELD', '$!this.group')
      endif
   elseif !level.eq('BendWeld') then
      if (!this.machineTypeOption.selection() eq 'BENDING') then
         !this.getGroup(!this.bend, 'FMBEND', '$!this.group')
      elseif (!this.machineTypeOption.selection() eq 'WELDING') then
         !this.getGroup(!this.fweld, 'FMWELD', '$!this.group')
      endif
   endif

   if (!this.machineTypeOption.selection() eq 'BENDING') then
      if !this.bend.dtext[1].neq('None Found') then
         !this.dimData.active = TRUE
         !this.collData.active = TRUE
         !this.sstData.active = TRUE
         !this.stfProportional.active = TRUE
         !this.stfConstant.active = TRUE
         !this.maxLP.active = TRUE
         !this.compensate.active = TRUE
         !this.awdFln.active = TRUE
         !this.bendDir.active = TRUE

         !!ce = !this.bend.selection().dbref()
         !this.stfProportional.val = !!ce.stfProportional
         !this.stfConstant.val = !!ce.stfConstant
         !this.tempSTFP = !!ce.stfProportional.real()
         !this.tempSTFC = !!ce.stfConstant.real()
         !this.maxLP.val = !!ce.maxLP
         !this.compensate.val = !!ce.compensate
         !this.awdFln.val = !!ce.awdFln
         !this.bendDir.val = !!ce.bmCloc
      else
         !this.dimData.active = FALSE
         !this.collData.active = FALSE
         !this.sstData.active = FALSE
         !this.stfProportional.active = FALSE
         !this.stfConstant.active = FALSE
         !this.maxLP.active = FALSE
         !this.compensate.active = FALSE
         !this.awdFln.active = FALSE
         !this.bendDir.active = FALSE
      endif
      !this.getBendingData(!this.dimHeadings, 'FMBDIM', '$!this.bend')
      !this.getBendingData(!this.collHeadings, 'FMBPLN', '$!this.bend')
      !this.getBendingData(!this.sstHeadings, 'FMBSST', '$!this.bend')
      !!ce = !this.bend.selection().dbref()
      handle ANY
         return
      endhandle
   elseif (!this.machineTypeOption.selection() eq 'WELDING') then
      if !this.fweld.dtext[1].neq('None Found') then
         !this.skeyData.active = TRUE
         !this.minODfweld.active = TRUE
         !this.maxODfweld.active = TRUE
         !this.minLPfweld.active = TRUE
         !this.maxLPfweld.active = TRUE

         !!ce = !this.fweld.selection().dbref()
         !this.minODfweld.val = !!ce.minOD
         !this.maxODfweld.val = !!ce.maxOD
         !this.minLPfweld.val = !!ce.minLP
         !this.maxLPfweld.val = !!ce.maxLP
      else
         !this.skeyData.active = FALSE
         !this.minODfweld.active = FALSE
         !this.maxODfweld.active = FALSE
         !this.minLPfweld.active = FALSE
         !this.maxLPfweld.active = FALSE
      endif
      !this.getWeldingData(!this.skeyHeadings, 'FMWSK', '$!this.fweld')
      !!ce = !this.fweld.selection().dbref()
      handle ANY
         return
      endhandle
   endif

endmethod
----------------------------------------------------------------------------
-- Method: .getGroup
--
-- Description:
--   Collects all the elements of type !searchItem for !source and appends
-- these items to the !gadget. Used to refresh the contents of the Fabrication World,
-- Group or Bending/Welding Machine option gadgets.
----------------------------------------------------------------------------
define method .getGroup(!gadget is GADGET, !searchItem is STRING, !source is STRING)

   if !source.eq('/*') then
      var !a coll all $!searchItem
      handle ANY
         !a = ARRAY()
      endhandle
   else
      var !a coll all $!searchItem for $!source
      handle ANY
         !a = ARRAY()
      endhandle
   endif

   if !a.size().eq(0) then
      !dtext[1] = 'None Found'
      !a[1]     = 'NONE Found'
   else
      if !this.name.val then
         var !dtext eval name for all from !a
      else
         var !dtext eval desc for all from !a
      endif
   endif

   !gadget.dtext = !dtext
   !gadget.rtext = !a

endmethod
----------------------------------------------------------------------------
-- Method: .getBendingData
--
-- Description:
--   Collects all the elements of type !searchItem for !source and appends
-- these elements to !gadget. Used to refresh the data in any of the 3 Bending
-- Machine Text Gadgets.
----------------------------------------------------------------------------
define method .getBendingData(!headings is ARRAY, !searchItem is STRING, !source is STRING)

  using namespace 'Aveva.Pdms.Presentation'

  AID CLEAR ALL

  var !a coll all $!searchItem for $!source
  handle ANY
  endhandle

  !bendData = ARRAY()
  !bendTotalData = ARRAY()
  !bendTotalData.clear()
  if !searchItem eq 'FMBDIM' then
     !this.dimGrid.clearGrid()
     do !b index !a
        !bendData.clear()
        !bendData[1] = !b.string()
        !bendData[2] = !a[!b].dbref().od.string(!!fabMachineMgrOdWallFmt)
        !bendData[3] = !a[!b].dbref().wThickness.string(!!fabMachineMgrOdWallFmt)
        !bendData[4] = !a[!b].dbref().grip.string(!!distanceFmt)
        !bendData[5] = !a[!b].dbref().mleFlange.string(!!distanceFmt)
        !bendData[6] = !a[!b].dbref().mliFlange.string(!!distanceFmt)
        !bendData[7] = !a[!b].dbref().fcMeasure.string(!!distanceFmt)
        !bendData[8] = !a[!b].dbref().bRadius.string(!!fabMachineMgrPropRealFmt)
        !bendData[9] = !a[!b].dbref().awdFln.string()
        !bendTotalData[!b] = !bendData
     enddo
     !toolTip = 'Bending Machine Dimension Data'
     !title = 'Dimension Data'
     if !bendTotalData.unset() and !this.bend.dtext[1].neq('None Found') then
       do !b from 1 to 9
         !bendData[!b] = ''
       enddo
       !bendTotalData[1] = !bendData
     endif
  elseif !searchItem eq 'FMBPLN' then
     !this.collGrid.clearGrid()
     do !b index !a
        !bendData.clear()
        !bendData[1] = !b.string()
        !bendData[2] = !a[!b].dbref().minPlnPosition.east.string(!!distanceFmt)
        !bendData[3] = !a[!b].dbref().minPlnPosition.north.string(!!distanceFmt)
        !bendData[4] = !a[!b].dbref().minPlnPosition.up.string(!!distanceFmt)
        !bendData[5] = !a[!b].dbref().maxPlnPosition.east.string(!!distanceFmt)
        !bendData[6] = !a[!b].dbref().maxPlnPosition.north.string(!!distanceFmt)
        !bendData[7] = !a[!b].dbref().maxPlnPosition.up.string(!!distanceFmt)
        !bendTotalData[!b] = !bendData
--      Validation and warning. No error exit
        if (!a[!b].dbref().minPlnPosition.east.GT(!a[!b].dbref().maxPlnPosition.east)) then
           !!alert.message('Invalid plane: X Min > X Max')
        endif
        if (!a[!b].dbref().minPlnPosition.north.GT(!a[!b].dbref().maxPlnPosition.north)) then
           !!alert.message('Invalid plane: Y Min > Y Max')
        endif
        if (!a[!b].dbref().minPlnPosition.up.GT(!a[!b].dbref().maxPlnPosition.up)) then
           !!alert.message('Invalid plane: Z Min > Z Max')
        endif
     enddo
     !toolTip = 'Bending Machine Collision Planes Data'
     !title = 'Collision Planes'
     if !bendTotalData.unset() and !this.bend.dtext[1].neq('None Found') then
       do !b from 1 to 7
         !bendData[!b] = ''
       enddo
       !bendTotalData[1] = !bendData
     endif
  elseif !searchItem eq 'FMBSST' then
     !this.sstGrid.clearGrid()
     do !b index !a
        !bendData.clear()
        !bendData[1] = !b.string()
        !bendData[2] = !a[!b].dbref().od.string(!!fabMachineMgrOdWallFmt)
        !bendData[3] = !a[!b].dbref().wThickness.string(!!fabMachineMgrOdWallFmt)
        !bendData[4] = !a[!b].dbref().matRef.attribute('Name')
        handle ANY
        !bendData[4] = !a[!b].dbref().matRef.string()
        endhandle
        !bendData[5] = !a[!b].dbref().angSPA.string(!!angleFmt)
        !bendData[6] = !a[!b].dbref().angSPB.string(!!angleFmt)
        !bendData[7] = !a[!b].dbref().stfProportional.string(!!fabMachineMgrPropRealFmt)
        !bendData[8] = !a[!b].dbref().stfConstant.string(!!fabMachineMgrPropRealFmt)
        !bendTotalData[!b] = !bendData
     enddo
     !toolTip = 'Bending Machine Springback and Stretch Factor Data'
     !title = 'Springback and Stretch Factors'
     if !bendTotalData.unset() and !this.bend.dtext[1].neq('None Found') then
       do !b from 1 to 8
         !bendData[!b] = ''
       enddo
       !bendTotalData[1] = !bendData
     endif
  endif

  !data = object NETDATASOURCE(!title, !headings, !bendTotalData)
  !data.toolTipText(!toolTip)
  if !searchItem eq 'FMBDIM' then
    !this.dimGrid.BindToDataSource(!data)
    !this.dimGrid.GridLayout().setEditableColumn('No.', FALSE)
    !this.dimGrid.GridLayout().setNumericTextComparer('No.')
    !this.dimGrid.GridLayout().setNumericTextComparer('OD')
    !this.dimGrid.GridLayout().setNumericTextComparer('WThickness')
    !this.dimGrid.GridLayout().setNumericTextComparer('Grip')
    !this.dimGrid.GridLayout().setNumericTextComparer('MLEFlange')
    !this.dimGrid.GridLayout().setNumericTextComparer('MLIFlange')
    !this.dimGrid.GridLayout().setNumericTextComparer('FCMeasure')
    !this.dimGrid.GridLayout().setNumericTextComparer('BRadius')
  elseif !searchItem eq 'FMBPLN' then
    !this.collGrid.bindToDataSource(!data)
    !this.collGrid.setEditableColumn(1, FALSE)
  elseif !searchItem eq 'FMBSST' then
    !this.sstGrid.bindToDataSource(!data)
    !this.sstGrid.setEditableColumn(1, FALSE)
  endif

endmethod
----------------------------------------------------------------------------
-- Method: .getWeldingData
--
-- Description:
--   Collects all the elements of type !searchItem for !source and appends
-- these elements to !gadget. Used to refresh the data the Welding
-- Machine Text Gadgets.
----------------------------------------------------------------------------
define method .getWeldingData(!headings is ARRAY, !searchItem is STRING, !source is STRING)

  using namespace 'Aveva.Pdms.Presentation'

  AID CLEAR ALL

  var !a coll all $!searchItem for $!source
  handle ANY
    !a = object ARRAY()
  endhandle

  !skeyData = ARRAY()
  !skeyTotalData = ARRAY()
  !skeyTotalData.clear()
  if !searchItem eq 'FMWSK' then
     !this.skeyGrid.clearGrid()
     do !b index !a
        !skeyData.clear()
        !skeyData[1] = !b.string()
        !skeyData[2] = !a[!b].dbref().skey.string()
        !skeyTotalData[!b] = !skeyData
     enddo
     !toolTip = 'Welding Machine Weldable Flange Data'
     !title = 'Weldable Flange Data'
     if !skeyTotalData.unset() and !this.fweld.dtext[1].neq('None Found') then
       do !b from 1 to 2
         !skeyData[!b] = ''
       enddo
       !skeyTotalData[1] = !skeyData
     endif
  endif

  !data = object NETDATASOURCE(!title, !headings, !skeyTotalData)
  !data.toolTipText(!toolTip)

  if !searchItem eq 'FMWSK' then
    !this.skeyGrid.bindToDataSource(!data)
    !this.skeyGrid.setEditableColumn(1, FALSE)
  endif

endmethod
----------------------------------------------------------------------------
-- Method: .deleteDat
--
-- Description:
--   Called when the user selects the CE button. Makes the current element if
-- it is either a FMBEND or FMWELD the active element of the !!fbmachinemgr form
-- and refreshes the gadgets as necessary.
----------------------------------------------------------------------------
define method .selectCurrent(!element is DBREF)

   !this.bendflag = TRUE

   !!ce = !element
   FMBEND
   handle ANY
      !this.bendflag = FALSE
      FMWELD
      handle ANY
         !!alert.error('Not a Fabrication Machine')
         return
      endhandle
   endhandle

   !this.getGroup(!this.world, 'FMWL', '/*')
   !this.world.select('rtext', !!ce.owner.owner.string())
   !this.getGroup(!this.group, 'FMGRP', '$!this.world')
   !this.group.select('rtext', !!ce.owner.string())

   if !this.bendflag then
      !this.machineTypeOption.select('RText', 'BENDING')

      !this.getGroup(!this.bend, 'FMBEND', '$!this.group')
      !this.bend.select('rtext', !!ce.string())

      !this.getBendingData(!this.dimHeadings, 'FMBDIM', '$!this.bend')
      !this.getBendingData(!this.collHeadings, 'FMBPLN', '$!this.bend')
      !this.getBendingData(!this.sstHeadings, 'FMBSST', '$!this.bend')

      !this.fweldMachine.visible = FALSE
      !this.bendMachine.visible = TRUE
      !this.bendDir.val = !!ce.bmCloc
   else
      !this.machineTypeOption.select('RText', 'WELDING')

      !this.getGroup(!this.fweld, 'FMWELD', '$!this.group')
      !this.fweld.select('rtext', !!ce.string())

      !this.getWeldingData(!this.skeyHeadings, 'FMWSK', '$!this.fweld')

      !this.bendMachine.visible = FALSE
      !this.fweldMachine.visible = TRUE
   endif

endmethod
----------------------------------------------------------------------------
-- Method: .killCall
--
-- Description:
--   Called when the form is destroyed but currently unused.
----------------------------------------------------------------------------
define method .killCall()

  AID CLEAR ALL

  -- Remove local drawlist from drawlist system
  !!gphDrawlists.detachAllViews(!this.drawlist)

  -- Remove form from view system (this kills the form)
  !!gphViews.remove(!this.view)

endmethod
----------------------------------------------------------------------------
-- Method: .loadCollisionPlanes()
--
-- Description:
--   Load the drawlist for the graphical view on the collision planes frame.
----------------------------------------------------------------------------
define method .loadCollisionPlanes()

  --Initialise variables
  !minEast  = -1000mm
  !minNorth = -1000mm
  !minUp    = -1000mm
  !maxEast  =  1000mm
  !maxNorth =  1000mm
  !maxUp    =  1000mm

  !this.view.active = true

  !count = 0

  -- If none selected do them all
  if (!this.collGrid.getSelectedRows().size() eq 0) then
    !values = !this.collGrid.getRows()
  else
    !values = !this.collGrid.getSelectedRows()
  endif

  do !a values !values

    !count = !count + 1

    --Position calculations for the plane
    !xMin = $!a[2]
    !yMin = $!a[3]
    !zMin = $!a[4]
    !xMax = $!a[5]
    !yMax = $!a[6]
    !zMax = $!a[7]
    !positionString = |E | & !xMin.string() & | N | & !yMin.string() & | U | & !zMin.string() & | WRT /* |
    !minPosition = object POSITION(!positionString)
    !positionString = |E | & !xMax.string() & | N | & !yMax.string() & | U | & !zMax.string() & | WRT /* |
    !maxPosition = object POSITION(!positionString)

    if (!count eq 1) then
    	!hidePreviousAids = true
    else
    	!hidePreviousAids = false
    endif

    -- Start at red if only 1 selected
    !colour = $!a[1] + 1
    !this.showPlane(!a[1].string(), !minPosition, !maxPosition, !hidePreviousAids, !colour)

    --Keep a track of maximum and minimum eastings etc for view limits
    !minEast  = (MIN($!minEast,  $!a[2], $!a[5]))
    !minNorth = (MIN($!minNorth, $!a[3], $!a[6]))
    !minUp    = (MIN($!minUp,    $!a[4], $!a[7]))
    !maxEast  = (MAX($!maxEast,  $!a[5], $!a[2]))
    !maxNorth = (MAX($!maxNorth, $!a[6], $!a[3]))
    !maxUp    = (MAX($!maxUp,    $!a[7], $!a[4]))
  enddo

  -- Edit the view limits
  !volume = |E | & !minEast & | N | & !minNorth & | U | & !minUp & | WRT /* TO E | & !maxEast & | N | & !maxNorth & | U | & !maxUp & | WRT /* |
  edit _fabMachineMgr_view volume
    limit local
    limit local $!volume
  exit

endmethod
