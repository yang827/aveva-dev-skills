--
--   File:      fabmachinemgr.pmlfrm
--   Type:      Form Definition
--   Group:     Piping Applications
--   Keyword:
--   Module:    design
--   Replaces:
--
-- Author:  Karl Martin-Chambers
-- Created: 25/09/2008 13:00
--
--
-- Description:
--   The Fabrication Machine Manager Form manages all present Fabrication
-- Machine data and allows the user to create modify and delete this data.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyAttChanges(STRING)          -
--  assocCollActive(BOOLEAN)         -                   Set .net pop-up active control
--  assocDimActive(BOOLEAN)          -                   Set .net pop-up active control
--  assocRightClickColl(ARRAY)       -
--  assocRightClickDim(ARRAY)        -
--  assocRightClickSKEY(ARRAY)       -                   Brings up the editWeldSKEY menu on a right click on the
--  assocRightClickSST(ARRAY)        -
--  assocSKEYActive(BOOLEAN)         -                   Set .net pop-up active control
--  assocSSTActive(BOOLEAN)          -                   Set .net pop-up active control
--  copyDGCData(ANY,STRING)          -                   Called when the clicks Copy for the Bending Dimension data.
--  copyData(ANY,STRING)             -                   Called when the clicks Copy for either Collision Plane, SST or Welding SKEY data.
--  create(STRING)                   -
--  createDat(STRING)                -                   Called when the clicks Add for either Bending Dimension, Collision Plane or SST data.
--  delete(GADGET)                   -                   Called when the user selects delete from the pop up menu displayed when
--  deleteDat(ANY)                   -
--  fabMachineMgr()                  -
--  getBendingData(ARRAY,STRING,STRING) -
--  getGroup(GADGET,STRING,STRING)   -
--  getWeldingData(ARRAY,STRING,STRING) -                   Collects all the elements of type !searchItem for !source and appends
--  getWorld(STRING)                 -
--  init()                           -
--  killCall()                       -                   Called when the form is destroyed but currently unused.
--  loadCollisionPlanes()            -
--  machineGadgets(STRING)           -                   Called when the user selects Bend Machine or Weld Machine on the
--  modify(GADGET,STRING)            -
--  modifyDGCData(ANY,STRING)        -                   Called when the user selects Modify on the pop up menu shown when the
--  modifyData(ANY,STRING)           -                   Called when the user selects Modify on the pop up menu shown when the
--  nameDescription()                -
--  netAfterSelect(ARRAY)            -                   After select event for .net control
--  onMachineTypeChanged()           -                   Handle the Machine Type drop down changed event
--  saveReport(STRING)               -                   Write a Fabrication Machine report
--  selectCurrent(DBREF)             -
--  showPlane(STRING,POSITION,POSITION,BOOLEAN,ANY) -                   Show the BM Plane Aid
--  validateSTFC(GADGET,STRING)      -                   Validate input to material gadgets
--  validateSTFP(GADGET,STRING)      -                   Validate input to material gadgets
--
---------------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle
import 'Aveva.Pdms.Presentation.DataGrid'
handle any
endhandle
Import 'PMLFILEBROWSER'
handle any
endhandle

setup form !!fabMachineMgr dialog dock right varchars

  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.Presentation.DataGrid'

  !this.autoScroll    = TRUE
  !this.icontitle     = 'Fabrications'
  !this.formtitle     = 'Fabrication Machine Manager'
  !this.formrevision  = ' $Revision: 0.0 $ '
  !this.initcall      = '!this.init()'
  !this.cancelcall    = |!this.killCall()|

	frame .optionsFrame 'Options' anchor T+L+R
		button .ce  'CE' tooltip 'Select Current Element' callback |!this.selectCurrent(!!ce)| width 8
		toggle .name 'Display Name/Description' at xmin.ce+13 ymin call '!this.nameDescription()'
		
		path down
	  option .world 'Fabrication World:  '  at xmin.ce ymax  anchor T+L+R tagwid 13 call '!this.getWorld(|Group|)' tooltip 'Select an existing Fabrication Machine World' width 25	

		path right
		button .crWorld  anchor t+r pixmap callback |!this.create('FMWL')| width 16 height 16
		
		path down
		
		option .group 'Fabrication Group:  '  at xmin.world ymax+0.2 anchor T+L+R tagwid 13 call '!this.getWorld(|BendWeld|)' tooltip 'Select an existing Fabrication Machine Group' width 25
		path right
		button .crGroup anchor T+R pixmap callback |!this.create('FMGRP')| width 16 height 16
		
		option .machineTypeOption 'Machine Type:' tagwid 13 anchor t+l+r at xmin.world ymax+0.2 callback '!this.onMachineTypeChanged()' tooltip 'Fabrication machine type Bending/Welding' width 25
	exit

	frame .bendMachine 'Bending Machine' anchor all at xmin.optionsFrame ymax.optionsFrame width.optionsFrame
	
	   option .bend 'Bending Machine:   ' at xmin+1 ymax+0.1 anchor T+L+R tagwid 13 call '!this.getWorld(||)' tooltip 'Current machine selection' width 25
	   path right
	   button .crBendM anchor T+R pixmap callback |!this.create('FMBEND')| width 16 height 16
	
	   --Bending Machine Parameters
	   path down
	   text .stfProportional   'STF Proportional:' at xmin.bend+0.2 ymax+0.4 tagwid 13 callback '!this.applyAttChanges(|FMBEND|)' width 10 is REAL format !!fabMachineMgrPropRealFmt
	   text .stfConstant       'STF Constant:' at xmin ymax+0.1 tagwid 13 callback '!this.applyAttChanges(|FMBEND|)' width 10 is REAL format !!fabMachineMgrPropRealFmt
	   path down
	   text .maxLP             'Max Pipe Length:' at xmin.stfConstant ymax+0.1 tagwid 13 callback '!this.applyAttChanges(|FMBEND|)' width 10 is REAL format !!distanceFmt
	   toggle .compensate  'Compensate' at xmax.stfProportional+1 ymin.stfProportional callback '!this.applyAttChanges(|FMBEND|)'
	   toggle .awdFln      'AutoWeld Flanges' at xmin.compensate ymin.stfConstant callback '!this.applyAttChanges(|FMBEND|)'
	   toggle .bendDir     'Bends clockwise' at xmin.awdFln ymin.maxLP callback '!this.applyAttChanges(|FMBEND|)'
	
	   frame .bendingTabs tabset anchor all at xmin.bend ymax.maxLP+.5 width 44.5 height 8
	     --Bending Dimension Objects
	     frame .bendingDimensions panel  'Bending Dimensions' anchor l+t+r+b   at xmin.bend  ymax+0.3     width 30 heig 6
	       -- PML container to host .NET grid control
	       container .dimData nobox PmlNetControl 'Table items' anchor top + left + bottom + right  width 32 hei 9
	     exit
	
	     --Collision Plane Objects
	     frame .collisionPlaneData  'Collision Planes' anchor l+t+r+b   at xmin  ymax+0.5     width 30 heig 20
	       -- PML container to host .NET grid control
	       container .collData nobox PmlNetControl 'Table items' anchor top + left + right  width 32 hei 8
	       frame .vView panel at xmin ymax anchor all height 12 width 32
	         view .view volume
	         exit
	       exit
	     exit
	
	     --Springback and Stretch Factor Objects
	     frame .ssFactorData  'Springback and Stretch Factors' anchor l+t+b+r width 30 heig 6
	       -- PML container to host .NET grid control
	       container .sstData nobox PmlNetControl 'Table items' anchor top + left + bottom + right width 32 hei 9
	     exit
	   exit
	   button .reportBendM   'Save Report...' linklabel at xmin.bend ymax+0.35 anchor B+L callback |!this.saveReport('FMBEND')| tooltip 'Save Report'
	exit
	
	frame .fweldMachine 'Welding Machine' anchor t+l+r at xmin.optionsFrame ymax.optionsFrame width.optionsFrame
	
	   option .fweld 'Welding Machine:   ' at xmin+1 ymax+0.1 anchor T+L+R tagwid 13 call '!this.getWorld(||)' width 25
	   path right
	   button .crFWeldM anchor T+R pixmap callback |!this.create('FMWELD')| width 16 height 16 tooltip 'Create Flange Welding Machine'
	
	   --Flange Welding Machine Parameters
	   path down
	   frame .odfweld 'Outer Diameter' anchor T+L at xmin.fweld+0.5 ymax+0.2 width 20
	      text .minODfweld 'Minimum:' tagwid 7 at xmin+0.5 ymin+0.7 callback '!this.applyAttChanges(|FMWELD|)' width 10 is REAL format !!fabMachineMgrOdWallFmt
	      text .maxODfweld 'Maximum:' tagwid 7 at xmin ymax+0.2 callback '!this.applyAttChanges(|FMWELD|)' width 10 is REAL format !!fabMachineMgrOdWallFmt
	   exit
	   path right
	   frame .lpFweld 'Length of Pipe' anchor T+L at xmax.odfweld+0.7 ymin.odfweld width 20
	      text .minLPfweld 'Minimum:' tagwid 7 at xmin+0.5 ymin+0.7 callback '!this.applyAttChanges(|FMWELD|)' width 10 is REAL format !!distanceFmt
	      text .maxLPfweld 'Maximum:' tagwid 7 at xmin ymax+0.2 callback '!this.applyAttChanges(|FMWELD|)' width 10 is REAL format !!distanceFmt
	   exit
	   frame .weldingTabs tabset anchor all at xmin.bend ymax+.5 width 44.5
	     -- Weldable Flanges
	     frame .flanges panel  'Weldable Flanges ' anchor all   at xmin.bend  ymax+0.3     width 42 heig 6
	       -- PML container to host .NET grid control
	       container .skeyData nobox PmlNetControl 'Table items' anchor all  width 42 hei 9
	     exit
	   exit
	
	   button .reportWeldM linklabel  'Save Report...'  at xmin.bend ymax+0.35 anchor B+L callback |!this.saveReport('FMWELD')| tooltip 'Save Report'
	
	exit

menu .editWorld
   !this.editWorld.add('callback','Modify World' ,'!this.modify(!this.world,|FMWL|)')
   !this.editWorld.add('callback','Delete World' ,'!this.delete(!this.world)')
   !this.world.setpopup(!this.editWorld)

menu .editGroup
   !this.editGroup.add('callback','Modify Group' ,'!this.modify(!this.group,|FMGRP|)')
   !this.editGroup.add('callback','Delete Group' ,'!this.delete(!this.group)')
   !this.group.setpopup(!this.editGroup)

menu .editBend
   !this.editBend.add('callback','Modify Bending Machine' ,'!this.modify(!this.bend,|FMBEND|)')
   !this.editBend.add('callback','Delete Bending Machine' ,'!this.delete(!this.bend)')
   !this.bend.setpopup(!this.editBend)

menu .editWeld
   !this.editWeld.add('callback','Modify Flange Welding Machine' ,'!this.modify(!this.fweld,|FMWELD|)')
   !this.editWeld.add('callback','Delete Flange Welding Machine' ,'!this.delete(!this.fweld)')
   !this.fweld.setpopup(!this.editWeld)

menu .editBendDim
   !this.editBendDim.add('callback','Create Bending Dimension...' ,'!this.createDat(|FMBDIM|)'               , 'CREATE')
   !this.editBendDim.add('callback','Copy Bending Dimension...'   ,'!this.copyDGCData(!this.dimGrid,|FMBDIM|)'  , 'COPY')
   !this.editBendDim.add('callback','Modify Bending Dimension...' ,'!this.modifyData(!this.dimGrid,|FMBDIM|)', 'MODIFY')
   !this.editBendDim.add('callback','Delete Bending Dimension...' ,'!this.deleteDat(|dimGrid|)'              , 'DELETE')
   !this.editBendDim.add('separator')
   !this.editBendDim.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.dimGrid, ||, |Save As|)', 'EXCEL' )
   !this.editBendDim.add( 'callback', 'Print Preview...', '!this.dimGrid.printpreview()', 'PRINT' )

menu .editBendPLN
   !this.editBendPLN.add('callback','Create Collision Plane...' ,'!this.createDat(|FMBPLN|)'                , 'CREATE')
   !this.editBendPLN.add('callback','Copy Collision Plane...' ,'!this.copyData(!this.collGrid,|FMBPLN|)'  , 'COPY')
   !this.editBendPLN.add('callback','Modify Collision Plane...' ,'!this.modifyData(!this.collGrid,|FMBPLN|)', 'MODIFY')
   !this.editBendPLN.add('callback','Delete Collision Plane...' ,'!this.deleteDat(|collGrid|)'              , 'DELETE')
   !this.editBendPLN.add('separator')
   !this.editBendPLN.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.collGrid, ||, |Save As|)', 'EXCEL' )
   !this.editBendPLN.add( 'callback', 'Print Preview...', '!this.collGrid.printpreview()', 'PRINT' )

menu .editBendSST
   !this.editBendSST.add('callback','Create Springback and Stretch Factor...' ,'!this.createDat(|FMBSST|)'               , 'CREATE')
   !this.editBendSST.add('callback','Copy Springback and Stretch Factor...'   ,'!this.copyData(!this.sstGrid,|FMBSST|)'  , 'COPY')
   !this.editBendSST.add('callback','Modify Springback and Stretch Factor...' ,'!this.modifyData(!this.sstGrid,|FMBSST|)', 'MODIFY')
   !this.editBendSST.add('callback','Delete Springback and Stretch Factor...' ,'!this.deleteDat(|sstGrid|)'              , 'DELETE')
   !this.editBendSST.add('separator')
   !this.editBendSST.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.sstGrid, ||, |Save As|)', 'EXCEL' )
   !this.editBendSST.add( 'callback', 'Print Preview...', '!this.sstGrid.printpreview()', 'PRINT' )

menu .editWeldSKEY
   !this.editWeldSKEY.add('callback','Create Weldable Flange...' ,'!this.createDat(|FMWSK|)'                , 'CREATE')
   !this.editWeldSKEY.add('callback','Copy Weldable Flange...'   ,'!this.copyData(!this.skeyGrid,|FMWSK|)'  , 'COPY')
   !this.editWeldSKEY.add('callback','Modify Weldable Flange...' ,'!this.modifyData(!this.skeyGrid,|FMWSK|)', 'MODIFY')
   !this.editWeldSKEY.add('callback','Delete Weldable Flange...' ,'!this.deleteDat(|skeyGrid|)'             , 'DELETE')
   !this.editWeldSKEY.add('separator')
   !this.editWeldSKEY.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.skeyGrid, ||, |Save As|)', 'EXCEL' )
   !this.editWeldSKEY.add( 'callback', 'Print Preview...', '!this.skeyGrid.printpreview()', 'PRINT' )

-----Member Variables-----
--Bend or Weld flag
member .bendflag is BOOLEAN
--Local View Drawlist
member .drawlist is REAL
--Fallback storage
member .tempSTFP is REAL
member .tempSTFC is REAL

--Graphical Plane Array
member .planes   is ARRAY
-- Grid control members
member .dimGrid  is PMLDataGridControl
member .collGrid is NETGRIDCONTROL
member .sstGrid  is NETGRIDCONTROL
member .skeyGrid is NETGRIDCONTROL
--Table Headings
member .dimHeadings   is ARRAY
member .collHeadings  is ARRAY
member .sstHeadings   is ARRAY
member .skeyHeadings  is ARRAY

exit
----------------------------------------------------------------------------
-- Method: .fabMachineMgr
--
-- Description:
-- Called when form is loaded but currently unused.
----------------------------------------------------------------------------
define method .fabMachineMgr()

  -- Set up a special formats with specific decimal places
  if (not(defined(!!fabMachineMgrOdWallFmt))) then
    !!fabMachineMgrOdWallFmt = !!realFmt
    !!fabMachineMgrOdWallFmt.label = 'UNITS'
    !!fabMachineMgrOdWallFmt.dimension = 'L'
    if (!!isImperialLength('DIST')) then
      -- Used for imperial OD and Wall Thickness
      !!fabMachineMgrOdWallFmt.dp = 3
      !!fabMachineMgrOdWallFmt.units = 'INCH'
    else
      -- Used for metric OD and Wall Thickness
      !!fabMachineMgrOdWallFmt.dp = 2
      !!fabMachineMgrOdWallFmt.units = 'MM'
    endif
  endif
  -- Used for Proportion reals only
  if (not(defined(!!fabMachineMgrPropRealFmt))) then
    !!fabMachineMgrPropRealFmt = !!realFmt
    !!fabMachineMgrPropRealFmt.dp = 5
  endif

  -- Default to element name as description often unset
  !this.name.val = true

  -- Define Machine Type drop down list
  !this.machineTypeOption.add('Bending Machine', 'BENDING')
  !this.machineTypeOption.add('Welding Machine', 'WELDING')

  -- Pixmaps
  !this.crWorld.addPixmap(!!pml.getPathName('ad_t_002.png'))
  !this.crGroup.addPixmap(!!pml.getPathName('ad_t_002.png'))
  !this.crBendM.addPixmap(!!pml.getPathName('ad_t_002.png'))
  !this.crFWeldM.addPixmap(!!pml.getPathName('ad_t_002.png'))

   -- Set auto-scroll
  !this.autoScroll = true

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.Presentation.DataGrid'

  !this.dimData.popup = !this.editBendDim
  !this.collData.popup = !this.editBendPLN
  !this.sstData.popup = !this.editBendSST
  !this.skeyData.popup = !this.editWeldSKEY

  --Create Grid Controls
  !this.dimGrid  = object PMLDATAGRIDCONTROL()
  !this.collGrid  = object NETGRIDCONTROL()
  !this.sstGrid  = object NETGRIDCONTROL()
  !this.skeyGrid  = object NETGRIDCONTROL()

  --Make the associations to call the functions to pop-up the menus.
  !this.dimGrid.GridEvents().addEventHandler('OnPopup', !this, 'assocRightClickDim')
  !this.collGrid.addEventHandler('OnPopup', !this, 'assocRightClickColl')
  !this.sstGrid.addEventHandler('OnPopup', !this, 'assocRightClickSST')
  !this.skeyGrid.addEventHandler('OnPopup', !this, 'assocRightClickSKEY')

  --Define Grid Options
  !dimGridLayout = !this.dimGrid.GridLayout()
  !dimGridLayout.FixedRows(TRUE)
  !dimGridLayout.ColumnExcelFilter(FALSE)
  !dimGridLayout.OutlookGroupStyle(FALSE)
  !dimGridLayout.singleRowSelection(TRUE)
  !dimGridLayout.setAlternateRowColor('WHITE')
  !dimGridLayout.EnableColumnSorting()
  !dimGridLayout.ExtendLastColumn(TRUE)
  !dimGridLayout.AutoFitColumns()
  !dimGridLayout.PinOn(FALSE)
  !dimGridLayout.WholeRowSelection(TRUE)
  -- Disable the inbuilt menus, so that we only see the ones we define
  !this.dimGrid.DisableContextMenus(TRUE)

  !this.collGrid.fixedHeaders(FALSE)
  !this.collGrid.fixedRows(TRUE)
  !this.collGrid.columnExcelFilter(FALSE)
  !this.collGrid.outlookGroupStyle(FALSE)
  --!this.collGrid.editableGrid(TRUE)
  !this.collGrid.singleRowSelection(FALSE)
  !this.collGrid.setAlternateRowColor('WHITE')
  !this.collGrid.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')

  !this.sstGrid.fixedHeaders(FALSE)
  !this.sstGrid.fixedRows(TRUE)
  !this.sstGrid.columnExcelFilter(FALSE)
  !this.sstGrid.outlookGroupStyle(FALSE)
  --!this.sstGrid.editableGrid(TRUE)
  !this.sstGrid.singleRowSelection(TRUE)
  !this.sstGrid.setAlternateRowColor('WHITE')

  !this.skeyGrid.fixedHeaders(FALSE)
  !this.skeyGrid.fixedRows(TRUE)
  !this.skeyGrid.columnExcelFilter(FALSE)
  !this.skeyGrid.outlookGroupStyle(FALSE)
  --!this.skeyGrid.editableGrid(TRUE)
  !this.skeyGrid.singleRowSelection(TRUE)
  !this.skeyGrid.setAlternateRowColor('WHITE')

  --Add the grid controls to their containers.
  !this.dimData.control  = !this.dimGrid.handle()
  !this.collData.control  = !this.collGrid.handle()
  !this.sstData.control  = !this.sstGrid.handle()
  !this.skeyData.control  = !this.skeyGrid.handle()

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.view)

   -- 3D view / local drawlist
  !!gphMinimumMenus(!this)
  !this.view.background = 15
  !viewDir[1] = 0.57735
  !viewDir[2] = 0.57735
  !viewDir[3] = -0.57735
  !this.view.direction = !viewDir
  !this.drawlist = !!gphDrawlists.createDrawList()
  !!gphDrawlists.attachView(!this.drawlist, !this.view)

  -- Tooltips
  !this.ce.setTooltip('Select Current Element')
  !this.crWorld.setTooltip('Create Fabrication World')
  !this.crGroup.setTooltip('Create Fabrication Group')
  !this.crBendM.setTooltip('Create Bending Machine')

endmethod
----------------------------------------------------------------------------
-- Method: .init
--
-- Description:
-- Called when form is loaded, with the purpose of initialising all the
-- gadgets on the form. As a default bending machine gadgets are displayed
-- on initialisation over welding machine gadgets.
----------------------------------------------------------------------------
define method .init()

   -- Define grid control namespace
   using namespace 'Aveva.Pdms.Presentation'
   using namespace 'Aveva.Pdms.Presentation.DataGrid'

   -- Clear 3D view
   if (!this.drawlist.set()) then
     !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
     !drawlist.removeAll()
     !this.view.active = false
   endif

   !this.bendflag = TRUE

   !this.bendMachine.visible = TRUE
   !this.fweldMachine.visible = FALSE

    !this.dimGrid.clearGrid()
   !this.dimHeadings[1] = 'No.'
   !this.dimHeadings[2] = 'OD'
   !this.dimHeadings[3] = 'WThickness'
   !this.dimHeadings[4] = 'Grip'
   !this.dimHeadings[5] = 'MLEFlange'
   !this.dimHeadings[6] = 'MLIFlange'
   !this.dimHeadings[7] = 'FCMeasure'
   !this.dimHeadings[8] = 'BRadius'
   !this.dimHeadings[9] = 'AwdFln'

   !this.collGrid.clearGrid()
   !this.collHeadings[1] = 'No.'
   !this.collHeadings[2] = 'X Min'
   !this.collHeadings[3] = 'Y Min'
   !this.collHeadings[4] = 'Z Min'
   !this.collHeadings[5] = 'X Max'
   !this.collHeadings[6] = 'Y Max'
   !this.collHeadings[7] = 'Z Max'

   !this.sstGrid.clearGrid()
   !this.sstHeadings[1] = 'No.'
   !this.sstHeadings[2] = 'OD'
   !this.sstHeadings[3] = 'WThickness'
   !this.sstHeadings[4] = 'Matref'
   !this.sstHeadings[5] = 'ANGSPA'
   !this.sstHeadings[6] = 'ANGSPB'
   !this.sstHeadings[7] = 'STFProportional'
   !this.sstHeadings[8] = 'STFConstant'

   !this.skeyGrid.clearGrid()
   !this.skeyHeadings[1] = 'No.'
   !this.skeyHeadings[2] = 'SKEY'

   !this.stfProportional.setTooltip('Proportional Stress Factor')
   !this.stfConstant.setTooltip('Constant Stress Factor')

   !this.stfConstant.validateCall = '!this.validateSTFC('
   !this.stfProportional.validateCall = '!this.validateSTFP('

   !this.maxLP.setTooltip('Maximum length of pipe')
   !this.compensate.setTooltip('Compensate bending activities for Springback')
   !this.awdFln.setTooltip('Bending machine accepts autoWelded flanges')
   !this.bendDir.setTooltip('Bending machine bends in clockwise direction')

   !this.getWorld(|World|)

endmethod

----------------------------------------------------------------------------
-- Method: .onMachineTypeChanged
--
-- Description:
-- Handle the Machine Type drop down changed event
----------------------------------------------------------------------------

define method .onMachineTypeChanged()
  if (!this.machineTypeOption.selection() eq 'BENDING') then
    !this.machineGadgets(|BENDING|)
  else
    !this.machineGadgets(|WELDING|)
  endif
endmethod

----------------------------------------------------------------------------
-- Method: .machineGadgets
--
-- Description:
-- Called when the user selects Bend Machine or Weld Machine on the
-- Fabrication Machine rgroup. Loads and switches between Bend Machine Gadgets
-- and Weld Machine Gadgets.
----------------------------------------------------------------------------
define method .machineGadgets(!operation is STRING)

   if !operation eq |BENDING| then
      !this.fweldMachine.visible = FALSE
      !this.getWorld(|BendWeld|)
      !this.bendMachine.visible = TRUE
   elseif !operation eq |WELDING| then
      !this.bendMachine.visible = FALSE
      !this.getWorld(|BendWeld|)
      !this.fweldMachine.visible = TRUE
   endif

endmethod
----------------------------------------------------------------------------
-- Method: .create
--
-- Description:
-- Called when the clicks Create World, Group or Bend/Weld. Sets up and shows
-- !!fabmachinecrt form.
----------------------------------------------------------------------------
define method .create(!type is STRING)
--$p create ($!type)
   !!fabmachinecrt.type = !type
   handle any
      pml load form !!fabmachinecrt
      !!fabmachinecrt.type = !type
   endhandle
   !!fabmachinecrt.mode = 'new'

   if !type.eq('FMWL') then
      !!ce = !this.world.selection().dbref()
      handle ANY
         !!ce = /*
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Create Fabrication World'
   elseif !type.eq('FMGRP') then
      !!ce = !this.group.selection().dbref()
      handle ANY
         !!ce = !this.world.selection().dbref()
         handle ANY
            !!alert.error('A Fabrication World must be created before a Fabrication Group')
            return
         endhandle
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Create Fabrication Group'
   elseif !type.eq('FMBEND') then
      !!ce = !this.bend.selection().dbref()
      handle ANY
         !!ce = !this.group.selection().dbref()
         handle ANY
            !!alert.error('A Fabrication Group must be created before a Bending Machine')
            return
         endhandle
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Create Bending Machine'
   elseif !type.eq('FMWELD') then
      !!ce = !this.fweld.selection().dbref()
      handle ANY
         !!ce = !this.group.selection().dbref()
         handle ANY
            !!alert.error('A Fabrication Group must be created before a Flange Welding Machine')
            return
         endhandle
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Create Flange Welding Machine'
   endif

   show !!fabmachinecrt

endmethod
----------------------------------------------------------------------------
-- Method: .modify
--
-- Description:
-- Called when the user selects modify from the pop up menu displayed when
-- the user right clicks on either the Fabrication World, Group or Bending,
-- Welding Machine. Sets up the !!fabmachinecrt form in modify mode using the
-- !!fabmachinecrt.type flag and then shows the form.
----------------------------------------------------------------------------
define method .modify(!gadget is GADGET, !type is STRING)

   !!fabmachinecrt.type = !type
   handle any
      pml load form !!fabmachinecrt
      !!fabmachinecrt.type = !type
   endhandle
   !!fabmachinecrt.mode = 'modify'

   if !type.eq('FMWL') then
      !!ce = !this.world.selection().dbref()
      handle ANY
         !!alert.error('Could not get the selected FMWL')
         return
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Modify Fabrication World'
   elseif !type.eq('FMGRP') then
      !!ce = !this.group.selection().dbref()
      handle ANY
         !!alert.error('Could not get the selected FMGRP')
         return
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Modify Fabrication Group'
   elseif !type.eq('FMBEND') then
      !!ce = !this.bend.selection().dbref()
      handle ANY
         !!alert.error('Could not get the selected FMBEND')
         return
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Modify Bending Machine'
   elseif !type.eq('FMWELD') then
      !!ce = !this.fweld.selection().dbref()
      handle ANY
         !!alert.error('Could not get the selected FMWELD')
         return
      endhandle
      !!fabmachinecrt.current = !!ce
      !!fabmachinecrt.formtitle = 'Modify Flange Welding Machine'
   endif

   show !!fabmachinecrt

endmethod
----------------------------------------------------------------------------
-- Method: .createDat
--
-- Description:
-- Called when the clicks Add for either Bending Dimension, Collision Plane, SST or Welding SKEY data.
-- Sets up and shows the !!fabmachinedat form.
----------------------------------------------------------------------------
define method .createDat(!type is STRING)
--$p createDat($!type)
   !!fabmachinedat.type = !type
   handle ANY
      pml load form !!fabmachinedat
      !!fabmachinedat.type = !type
   endhandle
   !!fabmachinedat.mode = 'new'

   if !type.eq('FMBDIM') then
      var !a coll all FMBDIM for $!this.bend
      !!fabmachinedat.macNo = !a.size() + 1

      !!ce = !this.bend.selection().dbref()
      handle ANY
         !!alert.error('Bend Dimension Data can only be created at FMBEND level or below')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Create Dimension Data'
   elseif !type.eq('FMBPLN') then
      var !a coll all FMBPLN for $!this.bend
      !!fabmachinedat.macNo = !a.size() + 1

      !!ce = !this.bend.selection().dbref()
      handle ANY
         !!alert.error('Bend Collision Plane can only be created at FMBEND level or below')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Create Collision Plane'
   elseif !type.eq('FMBSST') then
      var !a coll all FMBSST for $!this.bend
      !!fabmachinedat.macNo = !a.size() + 1

      !!ce = !this.bend.selection().dbref()
      handle ANY
         !!alert.error('Bend Springback and Stretch Data can only be created at FMBEND level or below')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Create Springback and Stretch Data'
   elseif !type.eq('FMWSK') then
      var !a coll all FMWSK for $!this.fweld
      !!fabmachinedat.macNo = !a.size() + 1

      !!ce = !this.fweld.selection().dbref()
      handle ANY
         !!alert.error('Weldable Flange SKEY Data can only be created at FMWELD level or below')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Create Weldable Flange Data'
   endif

   show !!fabmachinedat

endmethod
----------------------------------------------------------------------------
-- Method: .copyData
--
-- Description:
-- Called when the clicks Copy for either Collision Plane, SST or Welding SKEY data.
-- Copies the current line
----------------------------------------------------------------------------
define method .copyData(!gadget is ANY, !type is STRING)

   -- Return if no entries
   if !gadget.getSelectedRows()[1][1].eq('') then
     return
   endif

   -- Bending or Welding machine
   if (!type inset('FMBPLN','FMBSST')) then
     var !sele coll all $!type for $!this.bend
   elseif (!type inset('FMWSK')) then
     var !sele coll all $!type for $!this.fweld
   else
     return
   endif

   -- Get the line entry to make a copy of
   !selectedRow = !gadget.getSelectedRows()[1][1].real()
   !!ce = !sele[!selectedRow].dbref()
   handle ANY
      !!alert.error('Could not get the selected FMBDIM')
      return
   endhandle
   !newRow = !selectedRow + 1
   -- Create a copy and handle any error
   NEW $!type COPY PREV
   handle ANY
     !!alert.error(!!error.text)
     return
   endhandle
   -- Refresh the list
   !this.getWorld('bendweld')
   -- Select the new copy
   !gadget.selectRow(!newRow)
   -- Modify the new copy
   !this.modifyData(!gadget, !type)

endmethod
----------------------------------------------------------------------------
-- Method: .copyDGCData
--
-- Description:
-- Called when the clicks Copy for the Bending Dimension data.
-- Copies the current line
----------------------------------------------------------------------------
define method .copyDGCData(!gadget is ANY, !type is STRING)

   -- Return if no entries
   if not !gadget.HasSelectedRows() then
     return
   endif

   -- Bending or Welding machine
   if (!type inset('FMBDIM')) then
     var !sele coll all $!type for $!this.bend
   else
     return
   endif

   -- Get the line entry to make a copy of
   !selectedRow = !gadget.getSelectedRows()[1][1].real()
   !!ce = !sele[!selectedRow].dbref()
   handle ANY
      !!alert.error('Could not get the selected FMBDIM')
      return
   endhandle
   !newRow = !selectedRow + 1
   -- Create a copy and handle any error
   NEW $!type COPY PREV
   handle ANY
     !!alert.error(!!error.text)
     return
   endhandle
   -- Refresh the list
   !this.getWorld('bendweld')
   -- Select the new copy
   !gadget.selectRow(!newRow)
   -- Modify the new copy
   !this.modifyDGCData(!gadget, !type)

endmethod
----------------------------------------------------------------------------
-- Method: .modifyData
--
-- Description:
-- Called when the user selects Modify on the pop up menu shown when the
-- user right clicks on any of the 3 Bending Machine Text gadgets. Sets up the
-- !!fabmachinedat form in modify mode and then shows this form.
----------------------------------------------------------------------------
define method .modifyData(!gadget is ANY, !type is STRING)

      if (!gadget.getSelectedRows().unset()) then
     return
   endif

   !!fabmachinedat.type = !type
   handle ANY
      pml load form !!fabmachinedat
      !!fabmachinedat.type = !type
   endhandle
   !!fabmachinedat.mode = 'modify'

   if !type.eq('FMBDIM') then
      !!fabmachinedat.macNo = !gadget.getSelectedRows()[1][1].real()
      var !sele coll all FMBDIM for $!this.bend

      !!ce = !sele[!gadget.getSelectedRows()[1][1].real()].dbref()
      handle ANY
         !!alert.error('Could not get the selected FMBDIM')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Modify Dimension Data'
   elseif !type.eq('FMBPLN') then
      !!fabmachinedat.macNo = !gadget.getSelectedRows()[1][1].real()
      var !sele coll all FMBPLN for $!this.bend

      !!ce = !sele[!gadget.getSelectedRows()[1][1].real()].dbref()
      handle ANY
         !!alert.error('Could not get the selected FMBPLN')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Modify Collision Plane'
   elseif !type.eq('FMBSST') then
      !!fabmachinedat.macNo = !gadget.getSelectedRows()[1][1].real()
      var !sele coll all FMBSST for $!this.bend

      !!ce = !sele[!gadget.getSelectedRows()[1][1].real()].dbref()
      handle ANY
         !!alert.error('Could not get the selected FMBSST')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Modify Springback and Stretch Data'
   elseif !type.eq('FMWSK') then
      !!fabmachinedat.macNo = !gadget.getSelectedRows()[1][1].real()
      var !sele coll all FMWSK for $!this.fweld

      !!ce = !sele[!gadget.getSelectedRows()[1][1].real()].dbref()
      handle ANY
         !!alert.error('Could not get the selected FMWSK')
         return
      endhandle
      !!fabmachinedat.current = !!ce
      !!fabmachinedat.formtitle = 'Modify Weldable Flange Data'
   endif
   if (!!fabmachinedat.shown()) then
   	 hide !!fabmachinedat
   endif
   show !!fabmachinedat

endmethod
