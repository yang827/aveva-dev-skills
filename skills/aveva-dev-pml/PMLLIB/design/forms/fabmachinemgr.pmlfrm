----------------------------------------------------------------------------
-- Method: .nameDescription()
--
-- Description:
--    Function to alter between name and the description of a fabrication
--  machine element while maintaining the current selection.
----------------------------------------------------------------------------
define method .nameDescription()

  !world = !this.world.selection()
  !group = !this.group.selection()
  if !this.machineTypeOption.selection() eq |BENDING| then
    !bend = !this.bend.selection()
  elseif !this.machineTypeOption.selection() eq |WELDING| then
    !weld = !this.fweld.selection()
  endif

  !this.getWorld('World')

  !this.world.select('RTEXT', !world)
  !this.group.select('RTEXT', !group)
  handle any
    !this.getWorld('Group')
  endhandle
  if !this.machineTypeOption.selection() eq |BENDING| then
    !this.bend.select('RTEXT', !bend)
    handle any
      !this.getWorld('BendWeld')
    elsehandle NONE
      !this.getWorld('')
    endhandle
  elseif !this.machineTypeOption.selection() eq |WELDING| then
    !this.fweld.select('RTEXT', !weld)
    handle any
      !this.getWorld('BendWeld')
    elsehandle NONE
      !this.getWorld('')
    endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      showPlane
--
-- Description:
--   Show the BM Plane Aid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING    Plane Name
--    2    R      POSITION  Min XYZ position
--    3    R      POSITION  Max XYZ position
--    4    R      BOOLEAN   Hide previous aids
--    5    R      ANY       String or Real colour name or code number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPlane(!name is STRING, !posMin is POSITION, !posMax is POSITION, !hidePreviousAids is BOOLEAN, !colour is ANY)

  !colourObject = object COLOUR(!colour)
  !colourCode = !colourObject.code

  -- Get the middle position of the combined
  !xPos = ((!posMax.east + !posMin.east) / 2)
  !yPos = ((!posMax.north + !posMin.north) / 2)
  !zPos = ((!posMax.up + !posMin.up) / 2)
  !middlePosition = !posMin
  !middlePosition.east   = !xPos
  !middlePosition.north  = !yPos
  !middlePosition.up     = !zPos
  !middlePosition.origin = /*

  -- Create a default plane
  !p = object PLANE()
  !p.position = !middlePosition
  !p.orientation = object ORIENTATION('z is U and x is E')
  !pos = !middlePosition
  -- Get the plane size
  !xSize = (!posMax.east - !posMin.east)
  !ySize = (!posMax.north - !posMin.north)
  if (!xSize eq 0) then
    !pos.east = 0
  elseif (!ySize eq 0) then
    !pos.north = 0
  else
    !pos.up = 0
  endif
  !newPlane = !p.towards(!pos)

  -- Define and draw the plane using plane generated from a !position.plane(!posMin, !posMax)
  !position = !posMin
  !xLine = object LINE()
  !yLine = object LINE()
  -- If the Z values are equal we have a horizontal plane
  if ((!posMax.up eq !posMin.up)) then
  	!position.north = !posMax.north
  else
  	!position.up = !posMax.up
  endif
  !xLine.startPosition = !position
  !xLine.endPosition = !posMin
  !xSize = !xLine.length()
  !yLine.startPosition = !position
  !yLine.endPosition = !posMax
  !ySize = !yLine.length()
  !newPlane = object PLANE()
  !newPlane = !position.plane(!posMin, !posMax)
  handle ANY
    -- invalid plane?
    !!alert.error('Invalid Plane! Check the dimensions')
    aid clear all
    return
  endhandle
  !newPlane.position = !middlePosition

  -- Display positions
  if (!hidePreviousAids) then
    Aid clear all
  endif

  -- Axes definition
  !thisAxes = object GPHAXES()
  -- Aid numbers for axes
  !thisAxesNumber = REAL()
  -- Aid Plane definition
  !thisPlane  = object GPHPLANE(!newPlane)
  -- Aid numbers for plane
  !thisPlaneNumber = object REAL()

  -- Allocate Aid numbers
  !thisAxesNumber   = !!aidNumbers.add('BM Plane Axes')
  !thisPlaneNumber = !!aidNumbers.add('BM Plane')

  -- Define axes
  !thisAxes             = object GPHAXES()
  !thisAxes.xyz         = true
  !thisAxes.tag         = false
  !thisAxes.detail      = false
  !thisAxes.position    = object POSITION('E0N0U0 wrt /* ')
  !thisAxes.orientation = object ORIENTATION('X is X wrt /* ')
  !thisAxes.draw(!thisAxesNumber)

  -- Draw a graphical plane to indicate the fitting position
  !thisPlane.description = 'Plane $!name'
  !thisPlane.tag      = true
  !thisPlane.x = !xSize
  !thisPlane.y = !ySize

  -- Colour does not work if fill is on, because a plane has no independent colour method
  !thisPlane.draw(!thisPlaneNumber, true, !colourCode)

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!a is ARRAY)

  !this.loadCollisionPlanes()
  handle ANY
    -- There may be nothing in the row
  endhandle

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      saveReport
--
-- Description:
--   Write a Fabrication Machine report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      FMWELD or FMBEND
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveReport(!machine is STRING)

  -- Initialise variables
  !dimensions = ARRAY()
  !planes = ARRAY()
  !springs = ARRAY()
  !fileWriteRecord = ARRAY()

  -- Check Machine Type
  if (!machine eq 'FMBEND') then
  	!element = object DBREF(!this.bend.selection())
  	!!ce = !element
  	var !dimensions collect all FMBDIM for CE
  	var !planes collect all FMBPLN for CE
  	var !springs collect all FMBSST for CE

  	!dimensionsArray = !this.dimGrid.getRowsX()
  	!planesArray = !this.collGrid.getRows()
  	!springsArray = !this.sstGrid.getRows()
  	
  	-- Add headings to the dimGrid
  	!headings = ARRAY()
  	!headings.append('No.')
  	!headings.append('OD')
  	!headings.append('WThickness')
  	!headings.append('Grip')
  	!headings.append('MLEFlange')
  	!headings.append('MLIFlange')
  	!headings.append('FCMeasure')
  	!headings.append('BRadius')
  	!headings.append('AwdFln')
  	!dimensionsArray.insert(1, !headings)
  	
  	-- Add headings to the collGrid
  	!headings = ARRAY()
  	!headings.append('No.')
  	!headings.append('X Min')
  	!headings.append('Y Min')
  	!headings.append('Z Min')
  	!headings.append('X Max')
  	!headings.append('Y Max')
  	!headings.append('Z Max')
  	!planesArray.insert(1, !headings)
  	
  	-- Add headings to the sstGrid
  	!headings = ARRAY()
  	!headings.append('No.')
  	!headings.append('OD')
  	!headings.append('WThickness')
  	!headings.append('Matref')
  	!headings.append('ANGSPA')
  	!headings.append('ANSPB')
  	!headings.append('STFProportional')
  	!headings.append('STFConstant')
  	!springsArray.insert(1, !headings)
  	
  elseif (!machine eq 'FMWELD') then
  	!element = object DBREF(!this.fweld.selection())
  	!!ce = !element
  	var !dimensions collect all FMWSK for CE

  	!skeyArray = !this.skeyGrid.getRows()
  	
  	-- Add headings to the dimGrid
  	!headings = ARRAY()
  	!headings.append('No.')
  	!headings.append('SKEY')
  	!skeyArray.insert(1, !headings)
  	
  else
  	!!alert.error('Invalid argument')
  	return
  endif

  Using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')
  !fileName = !element.name.replace('/', '') & '.txt'
  !browser.show(|%PDMSUSER%|, !fileName, 'Save Report', false, 'Text File (*.txt)|*.txt', 1)
  -- Initialise Variables
  !file     = !!file(!browser.file())

  if(!file.unset()) then
    return
  endif

  -- Time and User information
  !dateTime = object DATETIME()
  !session  = CURRENT SESSION

  if (!machine eq 'FMBEND') then
    -- File header
    !fileWriteRecord.append('Bending Machine Report File')
    !fileWriteRecord.append('~~~~~~~~~~~~~~~~~~~~~~~~~~~')
    !fileWriteRecord.append('')
    !fileWriteRecord.append('  Created By : ' & !session.name)
    !fileWriteRecord.append('        Date : ' & !dateTime)
    !fileWriteRecord.append('')

    -- General Table
    !fileWriteRecord.append('General Data')
    !fileWriteRecord.append('~~~~~~~~~~~~')
    !fileWriteRecord.append('   Bending Machine name                         : ' & !element.name )
    !fileWriteRecord.append('   Description                                  : ' & !element.description )
    !fileWriteRecord.append('   Proportional Stretch Factor                  : ' & !element.stfProportional.string(!!fabMachineMgrPropRealFmt) )
    !fileWriteRecord.append('   Constant Stretch Factor                      : ' & !element.stfConstant.string(!!fabMachineMgrPropRealFmt) )
    !fileWriteRecord.append('   Maximum Length of Pipe                       : ' & !element.maxLP.string(!!distanceFmt) )
    !fileWriteRecord.append('   Compensate bending activities for Springback : ' & !element.compensate.string() )
    !fileWriteRecord.append('   Bending machine accepts autoWelded flanges   : ' & !element.awdFln.string() )
    !fileWriteRecord.append('   Bending machine bends in clockwise direction : ' & !element.bendDir.string() )

    !fileWriteRecord.append('')

    -- Dimensions Table
    !fileWriteRecord.append('Dimension Table')
    !fileWriteRecord.append('~~~~~~~~~~~~~~~')

    -- Initial column widths
    !col1 = 3
    !col2 = 3
    !col3 = 3
    !col4 = 3
    !col5 = 3
    !col6 = 3
    !col7 = 3
    !col8 = 3
    !col9 = 3
    -- Loop through dimensions
    do !i indices !dimensionsArray
      -- Get 9 column widths (includes header)
      !col1 = (MAX(!col1, !dimensionsArray[!i][1].length()))
      !col2 = (MAX(!col2, !dimensionsArray[!i][2].length()))
      !col3 = (MAX(!col3, !dimensionsArray[!i][3].length()))
      !col4 = (MAX(!col4, !dimensionsArray[!i][4].length()))
      !col5 = (MAX(!col5, !dimensionsArray[!i][5].length()))
      !col6 = (MAX(!col6, !dimensionsArray[!i][6].length()))
      !col7 = (MAX(!col7, !dimensionsArray[!i][7].length()))
      !col8 = (MAX(!col8, !dimensionsArray[!i][8].length()))
      !col9 = (MAX(!col9, !dimensionsArray[!i][9].length()))
    enddo
    -- Loop through planes again
    do !i indices !dimensionsArray

      var !nextLines COMPOSE |$!dimensionsArray[$!i][1]| width $!col1 L spaces 2 $
      |$!dimensionsArray[$!i][2]| width $!col2 L spaces 2 $
      |$!dimensionsArray[$!i][3]| width $!col3 L spaces 2 $
      |$!dimensionsArray[$!i][4]| width $!col4 L spaces 2 $
      |$!dimensionsArray[$!i][5]| width $!col5 L spaces 2 $
      |$!dimensionsArray[$!i][6]| width $!col6 L spaces 2 $
      |$!dimensionsArray[$!i][7]| width $!col7 L spaces 2 $
      |$!dimensionsArray[$!i][8]| width $!col8 L spaces 2 $
      |$!dimensionsArray[$!i][9]| width $!col9 L

      !fileWriteRecord.appendArray(!nextLines)
    enddo

    !fileWriteRecord.append('')

    -- Planes Table
    !fileWriteRecord.append('Collision Plane Table')
    !fileWriteRecord.append('~~~~~~~~~~~~~~~~~~~~~')

    -- Initial column widths
    !col1 = 3
    !col2 = 3
    !col3 = 3
    !col4 = 3
    !col5 = 3
    !col6 = 3
    !col7 = 3
    -- Loop through planes
    do !i indices !planesArray
      -- Get 7 column widths (includes header)
      !col1 = (MAX(!col1, !planesArray[!i][1].length()))
      !col2 = (MAX(!col2, !planesArray[!i][2].length()))
      !col3 = (MAX(!col3, !planesArray[!i][3].length()))
      !col4 = (MAX(!col4, !planesArray[!i][4].length()))
      !col5 = (MAX(!col5, !planesArray[!i][5].length()))
      !col6 = (MAX(!col6, !planesArray[!i][6].length()))
      !col7 = (MAX(!col7, !planesArray[!i][7].length()))
    enddo
    -- Loop through planes again
    do !i indices !planesArray

      var !nextLines COMPOSE |$!planesArray[$!i][1]| width $!col1 L spaces 2 $
      |$!planesArray[$!i][2]| width $!col2 L spaces 2 $
      |$!planesArray[$!i][3]| width $!col3 L spaces 2 $
      |$!planesArray[$!i][4]| width $!col4 L spaces 2 $
      |$!planesArray[$!i][5]| width $!col5 L spaces 2 $
      |$!planesArray[$!i][6]| width $!col6 L spaces 2 $
      |$!planesArray[$!i][7]| width $!col7 L

      !fileWriteRecord.appendArray(!nextLines)
    enddo

    !fileWriteRecord.append('')

    -- Springback Table
    !fileWriteRecord.append('Bending Springback and Stretch Table')
    !fileWriteRecord.append('~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~')

    -- Initial column widths
    !col1 = 3
    !col2 = 3
    !col3 = 3
    !col4 = 3
    !col5 = 3
    !col6 = 3
    !col7 = 3
    !col8 = 3
    -- Loop through Spring and stretch
    do !i indices !springsArray
      -- Get 8 column widths (includes header)
      !col1 = (MAX(!col1, !springsArray[!i][1].length()))
      !col2 = (MAX(!col2, !springsArray[!i][2].length()))
      !col3 = (MAX(!col3, !springsArray[!i][3].length()))
      !col4 = (MAX(!col4, !springsArray[!i][4].length()))
      !col5 = (MAX(!col5, !springsArray[!i][5].length()))
      !col6 = (MAX(!col6, !springsArray[!i][6].length()))
      !col7 = (MAX(!col7, !springsArray[!i][7].length()))
      !col8 = (MAX(!col8, !springsArray[!i][8].length()))
    enddo
    -- Loop through Spring and stretch again
    do !i indices !springsArray

      var !nextLines COMPOSE |$!springsArray[$!i][1]| width $!col1 L spaces 2 $
      |$!springsArray[$!i][2]| width $!col2 L spaces 2 $
      |$!springsArray[$!i][3]| width $!col3 L spaces 2 $
      |$!springsArray[$!i][4]| width $!col4 L spaces 2 $
      |$!springsArray[$!i][5]| width $!col5 L spaces 2 $
      |$!springsArray[$!i][6]| width $!col6 L spaces 2 $
      |$!springsArray[$!i][7]| width $!col7 L spaces 2 $
      |$!springsArray[$!i][8]| width $!col8 L

      !fileWriteRecord.appendArray(!nextLines)
    enddo

  else

    -- File header
    !fileWriteRecord.append('Welding Machine Report File')
    !fileWriteRecord.append('~~~~~~~~~~~~~~~~~~~~~~~~~~~')
    !fileWriteRecord.append('')
    !fileWriteRecord.append('  Created By : ' & !session.name)
    !fileWriteRecord.append('        Date : ' & !dateTime)
    !fileWriteRecord.append('')

    -- General Table
    !fileWriteRecord.append('General Data')
    !fileWriteRecord.append('~~~~~~~~~~~~')
    !fileWriteRecord.append('   Welding Machine name     : ' & !element.name )
    !fileWriteRecord.append('   Description              : ' & !element.description )
    !fileWriteRecord.append('   Minimum Outer Diameter   : ' & !element.minOD.string(!!fabMachineMgrOdWallFmt) )
    !fileWriteRecord.append('   Maximum Outer Diameter   : ' & !element.maxOD.string(!!fabMachineMgrOdWallFmt) )
    !fileWriteRecord.append('   Minimum Length of Pipe   : ' & !element.minLP.string(!!distanceFmt) )
    !fileWriteRecord.append('   Maximum Length of Pipe   : ' & !element.maxLP.string(!!distanceFmt) )
    !fileWriteRecord.append('')

    -- SKEY Table
    !fileWriteRecord.append('Weldable SKEY Table')
    !fileWriteRecord.append('~~~~~~~~~~~~~~~~~~~')

    -- Initial column widths
    !col1 = 3
    !col2 = 3
    -- Loop through skeys
    do !i indices !skeyArray
      -- Get 2 column widths (includes header)
      !col1 = (MAX(!col1, !skeyArray[!i][1].length()))
      !col2 = (MAX(!col2, !skeyArray[!i][2].length()))
    enddo
    -- Loop through planes again
    do !i indices !skeyArray

      var !nextLines COMPOSE |$!skeyArray[$!i][1]| width $!col1 L spaces 2 $
      |$!skeyArray[$!i][2]| width $!col2 L

      !fileWriteRecord.appendArray(!nextLines)
    enddo

    !fileWriteRecord.append('')
  endif

  -- Footer
  !fileWriteRecord.append('')
  !fileWriteRecord.append('End of Fabrication Machine Report File')

  -- Close the file
  !file.writefile('overwrite',!fileWriteRecord)
  !file.close()

endmethod


------------------------------------------------------------------------
--
-- Method:      validateSTFC
--
-- Description: Validate input to material gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateSTFC(!gadget is GADGET, !dummyString is STRING)
--$p validateSTFC 1
  if (!gadget.val.unset()) then
--      $p validateSTFC 2
      !gadget.val = !this.tempSTFC
      !gadget.refresh()
      return error 1 'A value must be provided for STF C'
  endif
  !value = !gadget.val.real()
  !minValue = 0.0000011
-- uncomment the next line for testing core handling of STFC = 0
--  !minValue = -1.0

--  $p $!minValue

  if(!value LT !minValue) then
--      $p validateSTFC 3
      !gadget.val = !this.tempSTFC
      !gadget.refresh()
      return error 1 'STFC too small'
  endif

  !val = !!fabMachineCheckParams(!this.stfConstant.val.real(), !this.stfProportional.val.real(), FALSE)
--  $p result = $!val
  if(!val GT 0) then
--      $p validateSTFC 4.1
      return error 1 'The combination of Proportional and Constant is invalid'
  elseif(!val LT 0) then
--      $p validateSTFC 4.2
      !!alert.message('The combination of Proportional and Constant is potentially invalid')
  endif
  !this.tempSTFC = !gadget.val.real()
--  $p $!this.tempSTFC

--  $p validateSTFC 5


endmethod


------------------------------------------------------------------------
--
-- Method:      validateSTFP
--
-- Description: Validate input to material gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   !gadget is GADGET - the control that is being validated
--   !dummyString is STRING - unused
-- Return:
--   void
--
------------------------------------------------------------------------
define method .validateSTFP(!gadget is GADGET, !dummyString is STRING)
--$p validateSTFP 1
  if (!gadget.val.unset()) then
--      $p validateSTFP 2
      !gadget.val = !this.tempSTFP
      !gadget.refresh()

      return error 1 'A value must be provided for STF P'
  endif

  !val = !!fabMachineCheckParams(!this.stfConstant.val.real(), !this.stfProportional.val.real(), FALSE)
--  $p result = $!val
  if(!val GT 0) then
--      $p validateSTFP 3.1
      return error 1 'The combination of Proportional and Constant is invalid'
  elseif(!val LT 0) then
--      $p validateSTFP 3.2
      !!alert.message('The combination of Proportional and Constant is potentially invalid')
  endif
  !this.tempSTFP = !gadget.val.real()

--      $p validateSTFP 4

endmethod
