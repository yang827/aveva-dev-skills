--
--  Description:     Search for and select material form for Fabrication Machine
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applySearch()                    -                   Apply action for Search panel
--  fabSelectMaterial()              -                   Constructor
--  init()                           -                   Initialise
--  initSearch()                     -                   Initialise Search panel
--  killCall()                       -                   tidy up method
--  netResultsSelected(FORM,ARRAY)   -                   Select the specified rows on the specified form
--  specResultsSelected(ARRAY)       -                   Process selection in search control for related form
--
import 'PMLDBSearch'
handle any
endhandle

setup form !!fabSelectMaterial dialog docking noalign

  !this.formTitle   = |Select Material|
  !this.iconTitle   = |Fab Matl|
  !this.initcall    = |!this.init()|
  !this.quitcall    = |!this.killCall()|
  !this.killingcall = |!this.killCall()|

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

  -- .net controls
  member .searchControl      is PMLDBSEARCHCTRL

  member .searchDbType       is STRING
  member .searchScope        is ARRAY
  member .searchEleTypes     is ARRAY
  member .searchFilters      is ARRAY
  member .searchMultiSel     is BOOLEAN
  member .searchColumns      is ARRAY
  member .searchResults      is ARRAY

  -- Search definition panel
  path down
  frame .frSearch 'Search'              anchor all at x0.5 ymin width 79 height 11
    container .conSearch nobox PmlNetControl 'Search' dock fill width 78 height 10
    path left
    button .bnSearchBack 'Dismiss'      anchor b+r at xmax.frSearch-10 ymax.frSearch-1.25 width 8
    button .bnSearchNew  'New Search'   anchor b+r width 8
    button .bnSearchAdd  'Use Selected' anchor b+r width 12
  exit

exit
------------------------------------------------------------------------
--
-- Method:      fabSelectMaterial
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fabSelectMaterial()

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

  -- Add instance of .net search control
  !this.searchControl         = object PMLDBSEARCHCTRL()
  !this.searchControl.addEventHandler('ResultsSelectedEvent', !this, 'specResultsSelected')
  !this.conSearch.control     = !this.searchControl.handle()

  -- Search definition panel
  !this.bnSearchAdd.callback  = |!this.applySearch()|
  !this.bnSearchNew.callback  = |!this.initSearch()|
  !this.bnSearchBack.callback = |!this.killCall()|

endmethod
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

    !this.searchDbType           = |CATA|
    !this.searchScope.clear()
    !this.searchScope[1]         = |/*|
    !this.searchEleTypes.clear()
    !this.searchEleTypes[1]      = |SMTE|
    !this.searchFilters.clear()
    --!this.searchFilters[1]       = |NAME like *|
    !this.searchMultiSel         = false
    !this.searchColumns.clear()
    !this.searchColumns[1]       = |XTEXT Xtext|
    !this.searchColumns[2]       = |NAME Name|
    !this.searchColumns[3]       = |YTEXT Ytext|
    !this.searchColumns[4]       = |ZTEXT Ztext|
    !this.searchColumns[5]       = |OWNER.NAME Owner|
    !this.searchColumns[6]       = |DBNAME Database|

  -- Populate the search fields
  !this.initSearch()

endmethod
------------------------------------------------------------------------
--
-- Method:      initSearch
--
-- Description: Initialise Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSearch()

  !this.searchResults.clear()
  !this.bnSearchAdd.active = false

  -- Initialise search control
  !displayResults = false
  !this.searchControl.initiateSearch(!displayResults, |Search|, !this.searchDbType,$
     !this.searchScope, !this.searchEleTypes, !this.searchFilters, !this.searchColumns)

endmethod
-- End of method definition for .initSearch()
------------------------------------------------------------------------
--
-- Method:      applySearch
--
-- Description: Apply action for Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySearch()

  !memory = !!fabMachineDat.matRefSST.val
  !!fabMachineDat.matRefSST.val = !this.searchResults[1].name
  !!fabMachineDat.validateMaterial(!!fabMachineDat.matRefSST, '')
  handle ANY
    !!alert.error(!!error.text)
    !!fabMachineDat.matRefSST.val = !memory
    handle ANY
      !!fabMachineDat.matRefSST.val = ''
    endhandle
  endhandle

endmethod
-- End of method definition for .applySearch()
------------------------------------------------------------------------
--
-- Method:      specResultsSelected
--
-- Description: Process selection in search control for related form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Search results data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .specResultsSelected(!data is ARRAY)

  -- Pass select event to controlling object
  !this.netResultsSelected(!this, !data)

endmethod
-- End of method definition for .specResultsSelected(ARRAY)
------------------------------------------------------------------------
--
-- Method:      netResultsSelected
--
-- Description: Select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form
--    2   R      ARRAY       Rows
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netResultsSelected(!form is FORM, !rows is ARRAY)

  -- Save search results as dbref's
  !dbrefNos = ARRAY()
  do !val values !rows
    !dbrefNos.append(!val)
  enddo
  !form.searchResults = !dbrefNos.evaluate(object BLOCK(|!dbrefNos[!evalIndex].dbref()|))

  if (!form.searchResults.empty()) then
    !form.bnSearchAdd.active = false
  else
    !form.bnSearchAdd.active = true
  endif

endmethod
-- End of method definition for .netResultsSelected(FORM, ARRAY)
--------------------------------------------------------
--
-- Method:      killCall
--
-- Description: tidy up method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Element to add
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .killCall()

  !this.hide()

endmethod
