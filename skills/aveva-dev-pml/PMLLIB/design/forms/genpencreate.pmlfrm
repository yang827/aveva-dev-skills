------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Invoke the hole manager with selected items
--  close()                          -                   Close form actions
--  edgPickPenetrated()              -                   Set EDG to pick penetrated items
--  genPenCreate()                   -                   Constructor
--  initialiseForm()                 -                   Actions when form is shown
--  pickPenetrated(EDGPICKDATA)      -                   EDG callback for penetrated items pick
--  tidy()                           -                   Tidy up state of this form
--
------------------------------------------------------------------------

-- Define form
layout form !!genPenCreate dialog resize
--setup form !!genPenCreate dialog resize

  --------------------------------- MEMBERS -----------------------------
  member .penetratedControl      is HMPENETRATEDCONTROL
--  member .penetratedRaw          is ARRAY
  -- List of penetrated items
--  member .penetrated             is ARRAY
  -- List of elements highlighted in this form
--  member .enhancePenetrated      is ARRAY

  -- Penetrated EDG packet
  member .penetratedPacketDesc   is STRING
--  member .penetratedPosition     is POSITION
--  member .panelPosition          is POSITION
--  member .plateThickness         is REAL
--  member .penetratedDirection    is DIRECTION
--  member .plane                  is PLANE
--  member .pickedItem             is DBREF

  -- Database item where the fixing will be created
  member .fixingLocation         is DBREF
  member .gParts                 is REAL

  --------------------------------  FORM  ------------------------------

  path down
  frame .framePenetrated panel anchor left + top + right
    button .butPickPenetrated    anchor left + top         'Pick Item for Hole'
    list   .listPenetrated       anchor all  width 34 length 3
  exit

  line  .lineSeparator at xmin.listPenetrated anchor left + top + right horiz width to max.listPenetrated heigh 0.5

  frame .framePenetrating  panel at xmin.framePenetrated anchor all
    list   .listPenetrating  anchor all width.listPenetrated length 8
    -- Define headings
    !a[1] = |Hole Type|
    !this.listPenetrating.setHeadings(!a)
  exit

  -- Bottom Line
  button .ok      anchor bottom + left  'OK'     width 9 OK
  button .cancel  anchor bottom + right 'Cancel' at xmax form-size ymin  width.OK callback '!this.close()'

-- End of form definition
exit

------------------------------------------------------------------------
--
-- Method:      .genPenCreate()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .genPenCreate()

  -- form properties
  !this.callback         = |!this.initialiseForm()|
  !this.formTitle        = 'Create Hole'
  !this.iconTitle        = 'Create Hole'
  !this.autoScroll       = true

  -- gadget properties
  !this.ok.callback      = '!this.apply()'
  !this.cancel.callback  = '!this.close()'

  -- EDG
  !this.penetratedPacketDesc        = 'Pick Item for Hole'
  !this.butPickPenetrated.callback  = '!this.edgPickPenetrated()'

-- Locate all SPCO in HOLE specs (uses PML1 as PML2 cant collect CATA data from DESI dbs)
-- Locate all GPARTS with PURP hole and type FIXING (uses PML1 as PML2 cant collect CATA data from DESI dbs)
  !gParts = ARRAY()
  var !gPartList collect all GPART with PURP  eq 'HOLE' and PRITYPE eq 'FIXING'
  do !elem values !gPartList
    !gParts.append(!elem.dbref() )
  enddo

  do !loop index !gParts
    !this.listPenetrating.add(!gParts[!loop].detref.rText, !gParts[!loop].string())
  enddo
  !this.listPenetrating.add('User Defined','TMPL')
  !this.gParts = !gParts.size()

endmethod

------------------------------------------------------------------------
--
-- Method:      initialiseForm
--
-- Description: Actions when form is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseForm()

  if (defined(!!hmFreeHole) and !!hmFreeHole.shown()) then
    return error 1 'Free hole definition form already shown. Please complete previous action first'
  endif
  if (!!hmassogpexists().not()) then
    return error 1 |Unable to locate ASSOGP to work in (PURP=HOLE)|
  endif

  -- Initialise common parts of the form
  -- Make properties and plotfile buttons inactive
  !this.ok.active         = false

  !finder = object COLLECTION()
  !finder.addtype(|STRU|)
  !finder.filter(object EXPRESSION(|PURP eq 'HOLE' and dbwrite|))
  !insertPoint = !finder.results()
  if (!insertPoint.size().lt(1) ) then
    return error 1 |Unable to locate ZONE to work in (PURP=HOLE)|
  endif

  !this.fixingLocation = !insertPoint[1]

  -- initialise penetrated pick control
  !this.penetratedControl.initialise(!this.listPenetrated)

endmethod

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close form actions
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .close()

  !this.tidy()
  !this.hide()

endmethod

------------------------------------------------------------------------
--
-- Method:      .tidy()
--
-- Description: Tidy up state of this form
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .tidy()

  !this.penetratedControl.tidy()
  !!edgCntrl.remove('Pick Item for Hole')

endmethod

------------------------------------------------------------------------
--
-- Method:      .edgPickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgPickPenetrated()

  -- Define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick a face on the penetrated object')
  !packet.description    = !this.penetratedPacketDesc
  !packet.priority       = 3
  !packet.action         = '!!genPenCreate.pickPenetrated(!this.return[1])'
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|PANE|,|HPLATE|,|CPLATE|)'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

----------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetrated(!data is EDGPICKDATA)

  !positionData          = !data.positionData()

  -- get pick position and plane
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
    !plane    = object PLANE()
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
    !plane    = !positionData.plane
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
    !plane    = object PLANE()
  endif

  !this.penetratedControl.setPenetrated(!data.item, !position, !plane)
  !this.ok.active = !this.penetratedControl.isSet()


endmethod

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Invoke the hole manager with selected items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .apply()

  !penetratedPosition  = !this.penetratedControl.penetratedPosition
  !penetratedDirection = !this.penetratedControl.penetratedDirection
  !plateThickness      = !this.penetratedControl.plateThickness
  !pickedItem          = !this.penetratedControl.pickedItem
  !plane               = !this.penetratedControl.plane
  !penetratedRaw       = !this.penetratedControl.penetratedRaw
  !penetratedOrientation = !this.penetratedControl.planarPenetratedOrientation()
  !saveCE = !!ce
  !!ce = !this.fixingLocation
  NEW FRMW
  NEW FIXING
  CALL !!autonamece(false)
  handle any
  endhandle
  if( !penetratedOrientation.set() ) then
    -- align penetration with owning panel if possible
    !!ce.orientation = !penetratedOrientation
  endif
  !fixing = !!ce
  if (!this.listPenetrating.selection() eq 'TMPL') then
    -- free hole - user defined boundary
    NEW TMPL
    NEW EXTR
    NEW LOOP
    NEW VERT
    AT X -100mm Y 100mm
    NEW VERT
    AT X 100mm Y 100mm
    NEW VERT
    AT X 100mm Y -100mm
    NEW VERT
    AT X -100mm Y -100mm
    FIXING
    !!ce.pos  = !penetratedPosition
  else
    -- Catalogue standard hole
    !!ce.spre = !this.listPenetrating.selection().dbref()
    !!ce.pos  = !penetratedPosition
    !distance = (!plateThickness / -2 )
    MOVE $!<penetratedDirection> DISTANCE $!<distance>
    !penetratedPosition = !!ce.pos.wrt(worl)
  endif
  !!ce = !saveCE

  show !!hmFreeHole
  !!hmFreeHole.initialise(!pickedItem, !penetratedRaw[1], !fixing, !penetratedPosition, !penetratedDirection, !plateThickness , !plane, 'CREATE')
  !this.close()

endmethod
