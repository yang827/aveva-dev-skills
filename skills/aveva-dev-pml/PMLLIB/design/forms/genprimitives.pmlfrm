------------------------------------------------------------------------
--
-- Method:      showCone
--
-- Description: Show task panes for cone primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCone()

  -- Initialise Variables
  !this.clearAllPanes()
  !this.showCreatePane()

  -- test for unset attribute field - indicates first time shown - set all gadgets
  if ( !this.topDiameterCone.val.unset() ) then
    !this.topDiameterCone.val    = 0
    !this.bottomDiameterCone.val = 0
    !this.heightCone.val         = 0
  endif

  !this.attrCone.visible = true
  if ( !this.negativeMode ) then
    !this.setPrimitiveHeader('NCON')
  else
    !this.setPrimitiveHeader('CONE')
  endif

  !this.initialisePlot('PCONE')

  !this.primitiveType = 'CONE'

endmethod
-- End of method definition

