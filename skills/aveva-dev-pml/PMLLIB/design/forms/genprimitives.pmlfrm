  -- test for unset attribute field - indicates first time shown - set all gadgets
  if ( !this.diameterDish.val.unset() ) then
    !this.diameterDish.val = 0
    !this.radiusDish.val   = 0
    !this.heightDish.val   = 0
  endif

  !this.attrDish.visible = true
  if ( !this.negativeMode ) then
    !this.setPrimitiveHeader('NDIS')
