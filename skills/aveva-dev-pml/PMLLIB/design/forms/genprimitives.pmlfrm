--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   DBREF       DBREF of created element
--
------------------------------------------------------------------------

define method .createBox() is DBREF

  -- Initialise variables
  !createSuccess = true
  if ( !this.negativeMode ) then
    !createSuccess = !this.createPrimitive('NBOX')
  else
    !createSuccess = !this.createPrimitive('BOX')
  endif

  if( !createSuccess.not() ) then
    return object DBREF()
  endif

  !!ce.xLength = !this.xLengthBox.val
  !!ce.yLength = !this.yLengthBox.val
  !!ce.zLength = !this.zLengthBox.val

  return !!ce

endmethod
