------------------------------------------------------------------------
--
-- Method:      switchNegativePrimitives
--
-- Description: Switch to negative create mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .switchNegativePrimitives()

  if ( !this.negativeMode ) then
    -- switching to +ve primitive creation
    !this.negativeMode = false
    !this.createInfo.val = 'Create Primitive Elements'
    !this.formTitle      = 'Create Primitive'
    !this.switchNegatives.tag = 'Switch to Negative Primitives'
    !this.setIcons(true)
  else
    -- switching to -ve primitive creation
    if ( !this.canCreateNegative(!!ce) ) then
      !this.negativeMode = true
      !this.createInfo.val = 'Create Negative Primitives'
      !this.formTitle      = 'Create Negative Primitive'
      !this.switchNegatives.tag = 'Switch to Normal Primitives'
      !this.setIcons(false)
    else
      !!alert.warning('The current element cannot contain a negative primitive')
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise create mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.clearAllPanes()
  !this.createTasks.visible = true
  !this.createInfo.val  = 'Create Primitive Elements'
  !this.createMode      = true
  !this.formTitle       = 'Create Primitive'
  !this.editElement     = object DBREF()
  !this.next.visible    = false
  !this.dismiss.visible = false
  !this.finalFrame.visible = false
  !this.ceButton.active = true
  !this.tidy()
   -- Link Position Option Gadgets to Objects
  var !coord coord
  !this.position.linkOption('!!genPrimitives.position', !this.ew, !this.ns, !this.ud, !coord)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate()

  -- Initialise Variables
  !rotateDirection = !this.rotateDirection.selection()
  !angle       = !this.rotateAngle.val
  !through     = !this.editElement.position.offset( !this.offsetDirection, !this.offsetDistance )
  !saveElement = !!ce
  !!ce         = !this.editElement
  ROTATE BY $!angle THROUGH $!through ABOUT $!rotateDirection WRT CE
  handle any
    !!alert.warning('Invalid Rotation')
  endhandle
  !!ce = !saveElement
  !this.feedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      feedback
--
-- Description: Draw rotation axes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .feedback()

  !element = !this.editElement
  -- Define Graphic Object
  !volume              = object LOCALVOLUME(!element, !element)
  handle any
    !volume            = object LOCALVOLUME()
  endhandle

  -- If volume then use the origin of the item (expanded)
  if(!volume.unset()) then
    !volume            = object LOCALVOLUME()
    !volume.wrt        = !element
    !volume.from       = !element.position
    !volume.from.east  = !volume.from.east  - 353.5mm
    !volume.from.north = !volume.from.north - 353.5mm
    !volume.from.up    = !volume.from.up    - 353.5mm

    !volume.to         = !element.position
    !volume.to.east    = !volume.to.east    + 353.5mm
    !volume.to.north   = !volume.to.north   + 353.5mm
    !volume.to.up      = !volume.to.up      + 353.5mm
  endif

  !box                 = !volume.box()
  !gphBox              = object GPHBOX(!box)

  -- Display graphical feedback - except for box because feedback sits on box edges and causes wireline picking problems
  if( !element.hardtype neq 'BOX' ) then
    !!aidNumbers.replace(!this.aidBox, !gphBox)
  endif

  -- Draw axes at the orientation
  !gAxes = object GPHAXES(!this.editElement.position.offset( !this.offsetDirection, !this.offsetDistance ), !this.editElement.orientation)
  !gAxes.height = 1.25 * max( !gphBox.box.xLength, !gphBox.box.yLength, !gphBox.box.zLength, 500mm )
  !gAxes.draw(!this.aidAxes)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialisePlot
--
-- Description: Set current plotfile, and show it if plot view
--              already shown
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Plotfile name (not pathname)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialisePlot(!plotName is STRING)

  !this.primitivePlot = !plotName
  if(defined(!!primitivePlot)) then
    if(!!primitivePlot.shown()) then
      !!primitivePlot.showPlot(!plotName)
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: Callback when user hits parameter button
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPlot()

  -- Initialise Variables
  if( not defined(!!primitivePlot) ) then
    pml reload form !!primitivePlot
  endif

  show !!primitivePlot
  !!primitivePlot.showPlot(!this.primitivePlot)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showCommonPanes
--
-- Description: Control visibility of common task panes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCommonPanes()

  -- Initialise Variables
  !this.intro.visible            = true
  !this.repFrame.visible         = true
  !this.datumFrame.visible        = true
  !this.positionFrame.visible     = true
  !this.orientationFrame.visible = true
  !this.connectionFrame.visible   = true
  !this.positionFrame.expanded    = true
  !this.orientationFrame.expanded = false
  !this.connectionFrame.expanded  = false

  !this.cpLine.visible = true
  !this.rLine.visible  = true
  !this.pLine.visible  = true

  !this.createFrame.visible = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showCreatePane
--
-- Description: Control visibility of create task panes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCreatePane()

  -- Initialise Variables
  !this.intro.visible            = true
  !this.repFrame.visible         = true
  !this.positionFrame.visible    = false
  !this.orientationFrame.visible = false
  !this.connectionFrame.visible  = false

  !this.cpLine.visible = true
  !this.rLine.visible  = true
  !this.pLine.visible  = true

  !this.createFrame.visible = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showBox
--
-- Description: Show task panes for box primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showBox()

  -- Initialise Variables
  !this.clearAllPanes()
  !this.showCreatePane()

  -- test for unset attribute field - indicates first time shown - set all gadgets
  if ( !this.xLengthBox.val.unset() ) then
    !this.xLengthBox.val = 0
    !this.yLengthBox.val = 0
    !this.zLengthBox.val = 0
  endif

  !this.attrBox.visible = true
  if ( !this.negativeMode ) then
    !this.setPrimitiveHeader('NBOX')
  else
    !this.setPrimitiveHeader('BOX')
  endif

  !this.initialisePlot('PBOX')

  !this.primitiveType = 'BOX'

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showCylinder
--
-- Description: Show task panes for cylinder primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCylinder()

  -- Initialise Variables
  !this.clearAllPanes()
  !this.showCreatePane()

  -- test for unset attribute field - indicates first time shown - set all gadgets
  if ( !this.heightCylinder.val.unset() ) then
    !this.heightCylinder.val   = 0
    !this.diameterCylinder.val = 0
  endif

  !this.attrCylinder.visible = true

  if ( !this.negativeMode ) then
    !this.setPrimitiveHeader('NCYL')
  else
    !this.setPrimitiveHeader('CYLI')
  endif

  !this.initialisePlot('PCYLI')

  !this.primitiveType = 'CYLI'

endmethod
-- End of method definition

