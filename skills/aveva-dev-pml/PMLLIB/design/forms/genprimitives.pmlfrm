------------------------------------------------------------------------
--
-- Method:      showExtrusion
--
-- Description: Show form for extrusion primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showExtrusion()

  -- Initialise Variables
  if ( !this.negativeMode ) then
    if ( not defined( !!dbeNExtrusion ) ) then
      pml reload form !!dbeNExtrusion
    endif
    if (!!dbeNExtrusion.shown()) then
      !!dbeNExtrusion.cancel()
    endif
    show !!dbeNExtrusion
  else
    if ( not defined( !!dbeExtrusion ) ) then
      pml reload form !!dbeExtrusion
    endif
    if (!!dbeExtrusion.shown()) then
      !!dbeExtrusion.cancel()
    endif
    show !!dbeExtrusion
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showRevolution
--
-- Description: Show form for solid of revolution primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showRevolution()

  -- Initialise Variables
  if ( not defined( !!dbeSRevolution ) ) then
    pml reload form !!dbeSRevolution
  endif

  if (!!dbeSRevolution.shown()) then
    !!dbeSRevolution.close()
  endif

  if ( !this.negativeMode ) then
    !!dbeSRevolution.createNegative()
  else
    !!dbeSRevolution.createPositive()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPrimitiveHeader
--
-- Description: Show form for solid of revolution primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Primitive type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPrimitiveHeader(!primitiveType is STRING)

  -- Look up primitive type
  !posPrimIndex = !this.primitiveTypeList.findFirst(!primitiveType)
  if(!posPrimIndex.set()) then
    -- get tag and icon
    !tag  = !this.primitiveTypeName[!posPrimIndex]
    !icon = !this.primitiveTypeIcon[!posPrimIndex]
  else
    -- look for negative primitives
    !negPrimIndex = !this.negPrimitiveTypeList.findFirst(!primitiveType)
    if(!negPrimIndex.set()) then
       -- get tag and icon
      !tag  = !this.negPrimitiveTypeName[!negPrimIndex]
      !icon = !this.negPrimitiveTypeIcon[!negPrimIndex]
    else
       -- should not get here - set default for bad argument
      !tag  = !primitiveType
      !icon = !!pml.getPathname('exclamation16x16.png')
    endif
  endif

  !this.cpTag.val = !tag
  !this.cpIcon.addPixmap(!icon)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clearAllPanes
--
-- Description: Make invisible all panes on this form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAllPanes()

  -- Initialise Variables
  !this.attrBox.visible      = false
  !this.attrCylinder.visible = false
  !this.attrCone.visible     = false
  !this.attrDish.visible     = false
  !this.attrPyramid.visible  = false
  !this.attrSnout.visible    = false
  !this.attrSCyli.visible    = false
  !this.attrCTorus.visible   = false
  !this.attrRTorus.visible   = false
  !this.attrPyramid.visible  = false

  !this.repFrame.visible         = false
  !this.datumFrame.visible       = false
  !this.positionFrame.visible    = false
  !this.orientationFrame.visible = false
  !this.connectionFrame.visible  = false
  !this.intro.visible            = false
  !this.createTasks.visible      = false

  !this.cpLine.visible = false
  !this.rLine.visible  = false
  !this.pLine.visible  = false

  !this.createFrame.visible = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      dbChanged
--
-- Description: Event handler for database change. Allows for current
-- primitive to be tested
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbChanged()

  -- check that form is shown
  if( !this.shown().not() ) then
    return
  endif

 -- Check for current edit element
  if(!this.editElement.unset()) then
    return
  endif

  -- If the edit primitive deleted, then re-initialise the form
  if(!this.editElement.badref()) then
    !!alert.warning('Current primitive has been deleted')
    !this.initialise()
    return
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Event handler for CE change. Control availability of
--              commands
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  -- check that form is shown
  if( !this.shown().not() ) then
    return
  endif

 -- Check for current edit element
  if(badref(!this.editElement)) then
    return
  endif

  -- Check is current element can be edited on this form
  if(!this.finalFrame.visible) then
    if( !this.editElement eq !!ce ) then
      !this.ceButton.active = false
    elseif( !this.isPrimitive(!!ce) ) then
      !this.ceButton.active = true
    elseif( !this.isNegativePrimitive(!!ce) ) then
      !this.ceButton.active = true
    else
      !this.ceButton.active = false
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isPrimitive
--
-- Description: Returns true is element is a Design Solid primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      True if element is a solid primitive
--
------------------------------------------------------------------------

define method .isPrimitive(!primitiveElement is DBREF) is BOOLEAN

  !type = !primitiveElement.hardtype.upcase()
  !index = !this.primitiveTypeList.findFirst(!type)
  return !index.set()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isNegativePrimitive
--
-- Description: Returns true is element is a negative primitive
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      True if element is a negative primitive
--
------------------------------------------------------------------------

define method .isNegativePrimitive(!primitiveElement is DBREF) is BOOLEAN

  !type = !primitiveElement.hardtype.upcase()
  !index = !this.negPrimitiveTypeList.findFirst(!type)
  return !index.set()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      canCreateNegativePrimitive
--
-- Description: Test if given element can own negative primitives
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element being tested
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      True if a negative can be created under the given element
--
------------------------------------------------------------------------

define method .canCreateNegative(!element is DBREF) is BOOLEAN

  -- look for NBOX to indicate that negatives can be owned
  !index = !element.list.findFirst('NBOX')
  if ( !index.set() ) then
    return true
  else
    -- If passed element is a negative primitive, then a new
    -- negative primitive can be created as a sibling
    return !this.isNegativePrimitive(!element)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickPpoint
--
-- Description: Define edg event that picks a P-point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on completion
--    2   R      STRING      Packet description to be added into EDG system with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPpoint()

  -- Initialise Variables

  -- Packet definition
  !packet                 = object EDGPACKET()

  -- Pick P-points only
  !packet.pickPacket.stdPpoint('Pick P-point to align with')
  -- filter out picks to the current primitive
  !packet.pickPacket.picks[1].pick.input[3]   = 'refe ne ' & !this.editElement.refe
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!genPrimitives.connectPpoint(!this.return[1])'
  !packet.priority        = 3
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectConnectPpoint
--
-- Description: Derive point nearest to point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Pick Data
--    2   R      STRING      Action to be carried out
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .connectPpoint(!pickData is EDGPICKDATA)

  -- Initialise Variables
  !toElement   = !pickData.item
  !toPpoint    = !pickData.point
  !fromElement = !this.editElement
  !fromPpoint  = !this.datumPpoint
  !saveCE      = !!ce
  !!ce         = !fromElement
  -- OLD SYNTAX  - connect P-points
  if( !toElement.hardtype eq 'TMPL' ) then
    -- Connect to Design Point
    CONNECT P$!<fromPpoint> OF $!<fromElement> TO DP$!<toPpoint> OF OWNER OF $!<toElement>
  else
    -- Connect to P-Point
    CONNECT P$!<fromPpoint> OF $!<fromElement> TO P$!<toPpoint> OF $!<toElement>
  endif
  !this.position.unLockAll()
  !this.datum()
  !!ce         = !saveCE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickDatum
--
-- Description: Define edg event that picks a P-point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on completion
--    2   R      STRING      Packet description to be added into EDG system with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickDatum()

  -- Initialise Variables

  -- Packet definition
  !packet                 = object EDGPACKET()

  -- Pick P-points only
  !packet.pickPacket.stdPpoint('Pick Datum P-point')
  -- filter out picks to the current primitive
  !packet.pickPacket.picks[1].pick.input[3]   = 'refe eq ' & !this.editElement.refe
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!genPrimitives.setDatum(!this.return[1])'
  !packet.priority        = 3
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setDatum
--
-- Description: Derive point nearest to point vector
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Pick Data
--    2   R      STRING      Action to be carried out
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .setDatum(!pickData is EDGPICKDATA)

  -- Initialise Variables
  !pPoint    = !pickData.point.string()
  !this.refDatum.select('Rtext',!pPoint)

  !this.datum()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createPrimitive
--
-- Description: Create primitive and handle errors
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Primitive type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True for success, false otherwise
--
------------------------------------------------------------------------

define method .createPrimitive(!primitiveType is STRING) is BOOLEAN

  -- Initialise Variables
  !createSuccess = true
  NEW $!<primitiveType>
  handle (41,8)
    !this.errorMessage = !!error.text
    !createSuccess = false
  elsehandle (2,502)
    -- handle any dacs errors
    !this.errorMessage = !!error.text
    !createSuccess = false
  elsehandle ANY
    !this.errorMessage = !!error.text
    !createSuccess = false
  endhandle
  return !createSuccess

endmethod
-- End of method definition
