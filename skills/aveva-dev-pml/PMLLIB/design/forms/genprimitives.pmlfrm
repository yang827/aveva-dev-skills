-- Method:      createCTorus
--
-- Description: create CTorus element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   DBREF       DBREF of created element
--
------------------------------------------------------------------------

define method .createCTorus() is DBREF

  -- Initialise variables
  !createSuccess = true
  if (!this.inRadiusCTorus.val gt !this.outRadiusCTorus.val ) then
    !this.errorMessage = 'Inner radius is greater than outer radius'
    return object DBREF()
  endif

  if ( !this.negativeMode ) then
    !createSuccess = !this.createPrimitive('NCTO')
  else
    !createSuccess = !this.createPrimitive('CTOR')
  endif

  if( !createSuccess.not() ) then
    return object DBREF()
  endif

  !!ce.rInside  = !this.inRadiusCTorus.val
  !!ce.rOutside = !this.outRadiusCTorus.val
  !!ce.angle    = !this.angleCTorus.val

  return !!ce

endmethod
