---
--
-- Description:
--  Primitive creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply changes to the model after creation
--  attributeRedo()                  -                   Refresh form if attribute is changed
--  attributeUndo()                  -                   Refresh form if attribute is changed
--  canCreateNegative(DBREF)         BOOLEAN
--  clearAllPanes()                  -                   Make invisible all panes on this form
--  close()                          -                   Close form
--  connectPpoint(EDGPICKDATA)       -
--  createBox()                      DBREF               Create Box element
--  createCTorus()                   DBREF               create CTorus element
--  createCone()                     DBREF               create Cone element
--  createCylinder()                 DBREF               create Cylinder element
--  createDish()                     DBREF               create Dish element
--  createPrimitive(STRING)          BOOLEAN             Create primitive and handle errors
--  createPyramid()                  DBREF               create Pyramid element
--  createRTorus()                   DBREF               create RTorus element
--  createRedo()                     -                   Go to create page if CREATE redone
--  createSlopedCylinder()           DBREF               create Sloped Cylinder element
--  createSnout()                    DBREF               create Snout element
--  createUndo()                     -                   Go back to create page if CREATE undone
--  datum()                          -                   Set position at selected datum
--  dbChanged()                      -                   Event handler for database change. Allows for current
--  edgTidy()                        -                   Tidy up aid graphics
--  edit(DBREF)                      -                   Public: Called to show this form to modify an existing
--  feedback()                       -                   Draw rotation axes
--  genPrimitives()                  -                   Constructor
--  initRepresentation()             -                   Initialise representation data to edit primitive
--  initialise()                     -                   Initialise create mode
--  initialisePlot(STRING)           -                   Set current plotfile, and show it if plot view
--  isNegativePrimitive(DBREF)       BOOLEAN             Returns true is element is a negative primitive
--  isPrimitive(DBREF)               BOOLEAN             Returns true is element is a Design Solid primitive
--  kill()                           -                   Close form
--  measure(GADGET,STRING)           -                   Handle measure callback
--  modify(DBREF)                    -                   Set form from passed element
--  next()                           -                   Tidy up after completed create operation
--  packetClose()                    -                   Tidy up after EDG close
--  packetEscape()                   -                   Tidy up after EDG close
--  pasteMeasure(GADGET,LINE)        -                   Paste measure result into gadget
--  pickDatum()                      -                   Define edg event that picks a P-point
--  pickPpoint()                     -                   Define edg event that picks a P-point
--  representation(GADGET,STRING)    -                   Set representation data to selection
--  rotate()                         -                   Rotate primitive
--  setAttribute(GADGET,STRING)      -                   Set REAL attribute data if in edit mode
--  setDatum()                       -                   Set position datum gadget
--  setDatum(EDGPICKDATA)            -                   Derive point nearest to point vector
--  setDatumOffset(POSITION)         -                   Set position at selected datum
--  setIcons(BOOLEAN)                -                   Set Button Icons
--  setPosition()                    -                   Set position data
--  setPosition(POSITION)            -                   Set position data
--  setPredefinedObstruction()       -                   Set predefined representation data to selection
--  setPrimitiveHeader(STRING)       -                   Show form for solid of revolution primitive
--  setRepresentation(DBREF)         -                   Set primitive representation levels
--  setWrt()                         -                   Set up with new wrt item
--  setupAfterCreate(DBREF)          -                   Set form for modification task after creation
--  setupModifyBox()                 -                   Set form to modify a Box element
--  setupModifyCTorus()              -                   Set form to modify a CTorus element
--  setupModifyCone()                -                   Set form to modify a Cone element
--  setupModifyCylinder()            -                   Set form to modify a Cylinder element
--  setupModifyDish()                -                   Set form to modify a Dish element
--  setupModifyPyramid()             -                   Set form to modify a Pyramid element
--  setupModifyRTorus()              -                   Set form to modify a RTorus element
--  setupModifySlopedCylinder()      -                   Set form to modify a Sloped Cylinder element
--  setupModifySnout()               -                   Set form to modify a Snout element
--  showBox()                        -                   Show task panes for box primitive
--  showCTorus()                     -                   Show task panes for circular torus primitive
--  showCommonPanes()                -                   Control visibility of common task panes
--  showCone()                       -                   Show task panes for cone primitive
--  showCreatePane()                 -                   Control visibility of create task panes
--  showCylinder()                   -                   Show task panes for cylinder primitive
--  showDish()                       -                   Show task panes for dish primitive
--  showExtrusion()                  -                   Show form for extrusion primitive
--  showPlot()                       -                   Callback when user hits parameter button
--  showPyramid()                    -                   Show task panes for pyramid primitive
--  showRTorus()                     -                   Show task panes for rectangular torus primitive
--  showRevolution()                 -                   Show form for solid of revolution primitive
--  showSlopedCylinder()             -                   Show task panes for sloped end cylinder primitive
--  showSnout()                      -                   Show task panes for snout primitive
--  switchNegativePrimitives()       -                   Switch to negative create mode
--  tidy()                           -                   Tidy up aid graphics
--  track()                          -                   Event handler for CE change. Control availability of
--  validateAngle(GADGET,STRING)     -
--  validateDistance(GADGET,STRING)  -                   Check REAL distance attribute data input
--  validateShear(GADGET,STRING)     -                   Check REAL shear value is within range
--
------------------------------------------------------------------------

setup form !!genPrimitives dialog dock right

  !this.iconTitle     = 'Primitives'
  !this.formTitle     = 'Create Primitive'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.close()'
  !this.formRevision  = ' $Revision: 1.12 $ '
  track 'DBCHANGED' call '!this.dbChanged()'
  track 'DESICE'    call '!this.track()'
  -------------------- Primitive Creation front page

  frame .createTasks panel  anchor left + right + top     at x0 y0   width 29
    paragraph .createInfo   anchor left + top             at x1 ymax-0.2 width 25
    line .cpeLine      anchor left + right + top  at x0 ymax  horiz width 28 heigh 0.5
    button .iconCreateBox   pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showBox()'
    path right
    valign centre halign left
    button .createBox   'Box'     linklabel anchor left + top           callback '!this.showBox()'
    button .iconCreateCyli  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showCylinder()'
    button .createCyli  'Cylinder'         linklabel anchor left + top  callback '!this.showCylinder()'
    button .iconCreateCone  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showCone()'
    button .createCone  'Cone'             linklabel anchor left + top  callback '!this.showCone()'
    button .iconCreateSnou  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showSnout()'
    button .createSnou  'Snout'            linklabel anchor left + top  callback '!this.showSnout()'
    button .iconCreatePyra  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showPyramid()'
    button .createPyra  'Pyramid'          linklabel anchor left + top  callback '!this.showPyramid()'
    button .iconCreateCtor  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showCTorus()'
    button .createCtor  'Circular Torus'   linklabel anchor left + top  callback '!this.showCTorus()'
    button .iconCreateRtor  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showRTorus()'
    button .createRtor  'Rectangular Torus' linklabel anchor left + top  callback '!this.showRTorus()'
    button .iconCreateDish  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showDish()'
    button .createDish  'Dish'             linklabel anchor left + top  callback '!this.showDish()'
    button .iconCreateSlcy  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showSlopedCylinder()'
    button .createSlcy  'Sloped Cylinder'  linklabel anchor left + top  callback '!this.showSlopedCylinder()'
    button .iconCreateExtr  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showExtrusion()'
    button .createExtr  'Extrusion'        linklabel anchor left + top  callback '!this.showExtrusion()'
    button .iconCreateRevo  pixmap width 16 height 16   anchor left + top  at x1 ymax+0.2 callback '!this.showRevolution()'
    button .createRevo  'Solid of Revolution'  linklabel anchor left + top  callback '!this.showRevolution()'
    line   .negativeLine   at x0 ymax+0.2   anchor left + right + top    horiz  width 28 heigh 0.5
    button .switchNegatives  at x1 ymax+0.2 anchor left + top  callback '!this.switchNegativePrimitives()' width 25
  exit

  -------------------- Primitive Creation attributes panes

  frame .intro panel   anchor left + right + top   at x0      y0        width 29
    paragraph .cpIcon  anchor left + top           at xmin    ymin      pixmap width 16 height 16
    paragraph .cpTag   anchor left + top           at x3      ymin      width 22
    button    .plotForm  'Parameters...'  anchor right + top  at x17   ymax   callback '!this.showPlot()' width 10
  exit

  line .cpLine        anchor left + right + top   at x0      ymax    horiz  width 29 heigh 0.3

  -- Box Attributes
  frame .attrBox panel           anchor left + right + top    at x0  ymax.cpLine-0.2 width 29
    text  .xLengthBox 'X Length' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .yLengthBox 'Y Length' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .zLengthBox 'Z Length' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    button .xLengthBoxMeasure    tooltip 'Measure' anchor t+r at xmax.xLengthBox+0.5 ymin.xLengthBox pixmap width 16 height 16
    button .yLengthBoxMeasure    tooltip 'Measure' anchor t+r at xmax.yLengthBox+0.5 ymin.yLengthBox pixmap width 16 height 16
    button .zLengthBoxMeasure    tooltip 'Measure' anchor t+r at xmax.zLengthBox+0.5 ymin.zLengthBox pixmap width 16 height 16
  exit

  -- Cylinder Attributes
  frame .attrCylinder panel            anchor left + right + top    at x0  ymax.cpLine   width 29
    text  .heightCylinder   'Height'   anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .diameterCylinder 'Diameter' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    button .heightCylinderMeasure      tooltip 'Measure' anchor t+r at xmax.heightCylinder+0.5   ymin.heightCylinder   pixmap width 16 height 16
    button .diameterCylinderMeasure    tooltip 'Measure' anchor t+r at xmax.diameterCylinder+0.5 ymin.diameterCylinder pixmap width 16 height 16
  exit

  -- Cone Attributes
  frame .attrCone panel                         anchor left + right + top    at x0  ymax.cpLine   width 29
    text  .topDiameterCone    'Top Diameter'    anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!distanceFmt
    text  .bottomDiameterCone 'Bottom Diameter' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!distanceFmt
    text  .heightCone         'Height'          anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!distanceFmt
    button .topDiameterConeMeasure    tooltip 'Measure' anchor t+r at xmax.topDiameterCone+0.5    ymin.topDiameterCone    pixmap width 16 height 16
    button .bottomDiameterConeMeasure tooltip 'Measure' anchor t+r at xmax.bottomDiameterCone+0.5 ymin.bottomDiameterCone pixmap width 16 height 16
    button .heightConeMeasure         tooltip 'Measure' anchor t+r at xmax.heightCone+0.5         ymin.heightCone         pixmap width 16 height 16
  exit

  -- Dish Attributes
  frame .attrDish panel              anchor left + right + top     at x0  ymax.cpLine   width 29
    text  .diameterDish   'Diameter' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .radiusDish     'Radius'   anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .heightDish     'Height'   anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    button .diameterDishMeasure      tooltip 'Measure' anchor t+r at xmax.diameterDish+0.5  ymin.diameterDish pixmap width 16 height 16
    button .radiusDishMeasure        tooltip 'Measure' anchor t+r at xmax.radiusDish+0.5    ymin.radiusDish   pixmap width 16 height 16
    button .heightDishMeasure        tooltip 'Measure' anchor t+r at xmax.heightDish+0.5    ymin.heightDish   pixmap width 16 height 16
  exit

  -- Pyramid Attributes
  frame .attrPyramid panel            anchor left + right + top    at x0  ymax.cpLine   width 29
    text  .topXPyramid     'X Top'    anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .topYPyramid     'Y Top'    anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .bottomXPyramid  'X Bottom' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .bottomYPyramid  'Y Bottom' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .offsetXPyramid  'X Offset' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .offsetYPyramid  'Y Offset' anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    text  .heightPyramid   'Height'   anchor left + right + bottom at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 7 width 16 is REAL format !!distanceFmt
    button .topXPyramidMeasure        tooltip 'Measure' anchor t+r at xmax.topXPyramid+0.5    ymin.topXPyramid      pixmap width 16 height 16
    button .topYPyramidMeasure        tooltip 'Measure' anchor t+r at xmax.topYPyramid+0.5    ymin.topYPyramid      pixmap width 16 height 16
    button .bottomXPyramidMeasure     tooltip 'Measure' anchor t+r at xmax.bottomXPyramid+0.5 ymin.bottomXPyramid   pixmap width 16 height 16
    button .bottomYPyramidMeasure     tooltip 'Measure' anchor t+r at xmax.bottomYPyramid+0.5 ymin.bottomYPyramid   pixmap width 16 height 16
    button .offsetXPyramidMeasure     tooltip 'Measure' anchor t+r at xmax.offsetXPyramid+0.5 ymin.offsetXPyramid   pixmap width 16 height 16
    button .offsetYPyramidMeasure     tooltip 'Measure' anchor t+r at xmax.offsetYPyramid+0.5 ymin.offsetYPyramid   pixmap width 16 height 16
    button .heightPyramidMeasure      tooltip 'Measure' anchor t+r at xmax.heightPyramid+0.5  ymin.heightPyramid    pixmap width 16 height 16
  exit

  -- Snout Attributes
  frame .attrSnout panel                anchor left + right + top     at x0    ymax.cpLine    width 29
    text  .topDiameterSnout 'Top Diameter'    anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 10 width 14 is REAL format !!distanceFmt
    text  .bottomDiameterSnout 'Bottom Diam.' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 10 width 14 is REAL format !!distanceFmt
    text  .offsetXSnout     'X Offset'        anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 10 width 14 is REAL format !!distanceFmt
    text  .offsetYSnout     'Y Offset'        anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 10 width 14 is REAL format !!distanceFmt
    text  .heightSnout      'Height'          anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 10 width 14 is REAL format !!distanceFmt
    button .topDiameterSnoutMeasure           tooltip 'Measure' anchor t+r at xmax.topDiameterSnout+0.5    ymin.topDiameterSnout     pixmap width 16 height 16
    button .bottomDiameterSnoutMeasure        tooltip 'Measure' anchor t+r at xmax.bottomDiameterSnout+0.5 ymin.bottomDiameterSnout  pixmap width 16 height 16
    button .offsetXSnoutMeasure               tooltip 'Measure' anchor t+r at xmax.offsetXSnout+0.5        ymin.offsetXSnout         pixmap width 16 height 16
    button .offsetYSnoutMeasure               tooltip 'Measure' anchor t+r at xmax.offsetYSnout+0.5        ymin.offsetYSnout         pixmap width 16 height 16
    button .heightSnoutMeasure                tooltip 'Measure' anchor t+r at xmax.heightSnout+0.5         ymin.heightSnout          pixmap width 16 height 16
  exit

  -- Sloped Cylinder Attributes
  frame .attrSCyli panel                  anchor left + right + top     at x0  ymax.cpLine   width 29
    text  .diameterSCyli 'Diameter'       anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!distanceFmt
    text  .heightSCyli   'Height'         anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!distanceFmt
    text  .topXSCyli     'Top X Shear'    anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!angleFmt
    text  .topYSCyli     'Top Y Shear'    anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!angleFmt
    text  .bottomXSCyli  'Bottom X Shear' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!angleFmt
    text  .bottomYSCyli  'Bottom Y Shear' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 12 width 12 is REAL format !!angleFmt
    button .diameterSCyliMeasure          tooltip 'Measure' anchor t+r at xmax.diameterSCyli+0.5  ymin.diameterSCyli  pixmap width 16 height 16
    button .heightSCyliMeasure            tooltip 'Measure' anchor t+r at xmax.heightSCyli+0.5    ymin.heightSCyli    pixmap width 16 height 16
  exit

  -- Circular Torus Attributes
  frame .attrCTorus panel                    anchor left + right + top     at x0  ymax.cpLine   width 29
    text  .inRadiusCTorus   'Inside radius ' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!distanceFmt
    text  .outRadiusCTorus  'Outside Radius' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!distanceFmt
    text  .angleCTorus      'Angle'          anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!realFmt
    button .inRadiusCTorusMeasure            tooltip 'Measure' anchor t+r at xmax.inRadiusCTorus+0.5   ymin.inRadiusCTorus    pixmap width 16 height 16
    button .outRadiusCTorusMeasure           tooltip 'Measure' anchor t+r at xmax.outRadiusCTorus+0.5  ymin.outRadiusCTorus   pixmap width 16 height 16
  exit

  -- Rectangular Torus Attributes
  frame .attrRTorus panel                    anchor left + right + top     at x0  ymax.cpLine   width 29
    text  .inRadiusRTorus   'Inside radius'  anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!distanceFmt
    text  .outRadiusRTorus  'Outside Radius' anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!distanceFmt
    text  .heightRTorus     'Height'         anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!distanceFmt
    text  .angleRTorus      'Angle'          anchor left + right + bottom  at x0.5  ymax+0.1  callback '!this.setAttribute('  tagwidth 11 width 13 is REAL format !!realFmt
    button .inRadiusRTorusMeasure            tooltip 'Measure' anchor t+r at xmax.inRadiusRTorus+0.5    ymin.inRadiusRTorus   pixmap width 16 height 16
    button .outRadiusRTorusMeasure           tooltip 'Measure' anchor t+r at xmax.outRadiusRTorus+0.5   ymin.outRadiusRTorus  pixmap width 16 height 16
    button .heightRTorusMeasure              tooltip 'Measure' anchor t+r at xmax.heightRTorus+0.5      ymin.heightRTorus     pixmap width 16 height 16
  exit

  line .rLine   anchor left + right + top    at x0  ymax.attrPyramid horiz width 29 heigh 0.5

  -------------------- Common frames shared between primitives

  -- Obstruction and Level Data
  frame .repFrame panel                anchor left + right + top     at x0  ymax.rLine width 29
    option   .predefinedObs 'Used for' anchor left + right + bottom  at x1  ymax-0.2   callback '!this.representation(' width 15
    text     .fromLevel     'Levels  ' anchor left + bottom          at x1  ymax+0.2   callback '!this.representation(' width 3 is REAL
    path right
    text     .toLevel                  anchor left + bottom  callback '!this.representation('  width 3 is REAL
    option   .obstruction              anchor left+ bottom   callback '!this.representation('  width 4
  exit

  line .pLine                          anchor left + right + top     at x0  ymax  horiz  width 29 heigh 0.5

  frame .createFrame panel        anchor left + right + top  at x0 ymax.pLine+0.2 width 29
    button .createButton 'Create' anchor right + top         at x21 ymax callback '!this.apply()' width 7
    path left
    button .cancelData ' Back  '  anchor right + top         callback '!this.initialise()' tooltip 'Cancel changes' reset
  exit

  frame .datumFrame panel         anchor left + right + top  at x0 ymax.pLine width 29
    option .refDatum 'Datum   '   anchor left + top  at x1  ymax-0.2 callback '!this.datum()' width 8
    path right
    button .iconDatum  pixmap  width 16 height 16   anchor left + top callback '!this.pickDatum()'
  exit

  -- Positioning Gadgets
  frame .positionFrame foldUp 'Position'      anchor left + right + top  at x0  ymax width 29

    halign left
    option .ew    anchor left + bottom at x1 ymax+0.5 width 5
    path down
    option .ns    anchor left + bottom  width 5
    option .ud    anchor left + bottom  width 5
    text   .x     anchor left + right + bottom at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     anchor left + right + bottom at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     anchor left + right + bottom at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag anchor right + bottom        at xmax+1 ymin.ew
    toggle .yFlag anchor right + bottom        at xmin   ymin.ns
    toggle .zFlag anchor right + bottom        at xmin   ymin.ud
    para   .lock  anchor right + bottom        at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    --  Reference (wrt)
    text .wrt 'wrt' anchor left + right + bottom  at x1  ymax.ud+0.2  callback '!this.setWrt()' width 20 string

  exit

  -- Orientation Gadgets and Setting
  frame .orientationFrame foldUp 'Rotate' anchor left + right + top  at x0  ymax.positionFrame  width 29

    -- Set orientation
    path right
    text   .rotateAngle      'Angle    '   anchor left + right + bottom at x1   ymax-0.2 width 14 is REAL
    option .rotateDirection  'Direction'   anchor left + right + bottom at xmin ymax+0.1 width 11.75
    button .applyRotate   'Apply Rotation'  anchor right + top  at xmax.pLine-size  ymax+0.2   callback '!this.rotate()'

  exit

  -- Connect Gadgets and Setting
  frame .connectionFrame foldUp 'Align with P-Point' anchor left + right + top  at x0  ymax.orientationFrame  width 29

    -- Set orientation
    button .connectTo        'Pick P-point' anchor right + top at x15 ymax-0.2 callback '!this.pickPpoint()'

  exit

  frame .finalFrame panel      anchor left + right + top  at x0 ymax width 29
    line .acLine               anchor left + right + top  at x0   ymax   horiz  width 29 heigh 0.5

    button .ceButton  linkLabel 'Modify Current Element '   anchor left + bottom   at xmin   ymax  callback '!this.edit(!!ce)'

  -- Action Buttons - overlaid: Next is end of create, dismiss is end of edit
    button .next    'Next'     anchor right + top  at xmax.acLine-size  ymax       callback '!this.next()'   width 8
    button .dismiss 'Dismiss'  anchor right + top  at xmin.next         ymin.next  callback '!this.close()'  width 8 cancel

  exit

  -- Form Members

  -- Primitive this form is editing
  member .editElement           is DBREF
  member .offsetDirection       is DIRECTION
  member .offsetDistance        is REAL
  member .datumPpoint           is REAL

  -- True if collecting parameters to create an element
  -- No element attached
  member .createMode            is BOOLEAN

  -- True if edit following create. False if user initiated edit
  member .editAfterCreate       is BOOLEAN

  -- true if negative primitive to be created
  member .negativeMode          is BOOLEAN

  -- List of valid primitive types
  member .primitiveTypeList     is ARRAY
  member .negPrimitiveTypeList  is ARRAY
  -- Look-up table of primitive type icons
  member .primitiveTypeIcon     is ARRAY
  member .negPrimitiveTypeIcon  is ARRAY
  -- Look-up table of primitive type names
  member .primitiveTypeName     is ARRAY
  member .negPrimitiveTypeName  is ARRAY

  -- Lookup table of gadgets against attribute names
  member .attributegadgetName   is ARRAY
  member .attributeName         is ARRAY

  -- Primitive type and plot filename
  member .primitiveType         is STRING
  member .primitivePlot         is STRING
  -- Used to pass error message
  member .errorMessage          is STRING

  -- Form Control Members
  -- Position
  member .position              is POSITIONLINK

  -- Aid numbers for position & axes
  member .aidAxes               is REAL
  member .aidBox                is REAL

  -- EDG Description
  member .packet                is EDGPACKET
  member .edgDescription        is STRING

  -- Undo event handlers
  member .undoCreate            is UNDOABLE
  member .undoSetAttribute      is UNDOABLE
  member .undoPosition          is UNDOABLE
  member .undoRotate            is UNDOABLE
  member .undoConnect           is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      genPrimitives
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .genPrimitives()

  -- Register form to show in any application, but not on start up
  !!appFormCntrl.registerForm(!this,ARRAY(),ARRAY(),false,false)

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'
  !this.killingCall       = '!this.kill()'
  !this.autoScroll        = true
  !this.editAfterCreate   = true
  !this.createMode        = true
  !this.editElement       = object DBREF()
  !this.offsetDistance    = 0
  var !coord coord
  if(!coord.eq('ENU'))then
    !this.offsetDirection   = object DIRECTION('U')
  else
    !this.offsetDirection   = object DIRECTION('Z')
  endif
  !this.datumPpoint       = 0

  -- set up valid primitive element lists
  !this.primitiveTypeList[1]     = 'BOX'
  !this.primitiveTypeList[2]     = 'CYLI'
  !this.primitiveTypeList[3]     = 'SLCY'
  !this.primitiveTypeList[4]     = 'SNOU'
  !this.primitiveTypeList[5]     = 'DISH'
  !this.primitiveTypeList[6]     = 'CONE'
  !this.primitiveTypeList[7]     = 'PYRA'
  !this.primitiveTypeList[8]     = 'CTOR'
  !this.primitiveTypeList[9]     = 'RTOR'
  !this.primitiveTypeList[10]    = 'EXTR'
  !this.primitiveTypeList[11]    = 'REVO'
--  !this.primitiveTypeList[12]    = 'POLYHE'
  !this.negPrimitiveTypeList[1]  = 'NBOX'
  !this.negPrimitiveTypeList[2]  = 'NCYL'
  !this.negPrimitiveTypeList[3]  = 'NSLC'
  !this.negPrimitiveTypeList[4]  = 'NSNO'
  !this.negPrimitiveTypeList[5]  = 'NDIS'
  !this.negPrimitiveTypeList[6]  = 'NCON'
  !this.negPrimitiveTypeList[7]  = 'NPYR'
  !this.negPrimitiveTypeList[8]  = 'NCTO'
  !this.negPrimitiveTypeList[9]  = 'NRTO'
  !this.negPrimitiveTypeList[10] = 'NXTR'
  !this.negPrimitiveTypeList[11] = 'NREV'
--  !this.negPrimitiveTypeList[12] = 'NPOLYH'

  -- Look-up table of primitive ICON's, indexed by type lists
  !this.primitiveTypeIcon[1]     = !!pml.getPathname('box.png')
  !this.primitiveTypeIcon[2]     = !!pml.getPathname('cyli.png')
  !this.primitiveTypeIcon[3]     = !!pml.getPathname('slcy.png')
  !this.primitiveTypeIcon[4]     = !!pml.getPathname('snou.png')
  !this.primitiveTypeIcon[5]     = !!pml.getPathname('dish.png')
  !this.primitiveTypeIcon[6]     = !!pml.getPathname('cone.png')
  !this.primitiveTypeIcon[7]     = !!pml.getPathname('pyra.png')
  !this.primitiveTypeIcon[8]     = !!pml.getPathname('ctor.png')
  !this.primitiveTypeIcon[9]     = !!pml.getPathname('rtor.png')
  !this.primitiveTypeIcon[10]    = !!pml.getPathname('extr.png')
  !this.primitiveTypeIcon[11]    = !!pml.getPathname('revo.png')
--  !this.primitiveTypeIcon[12]    = !!pml.getPathname('pyra.png')
  !this.negPrimitiveTypeIcon[1]  = !!pml.getPathname('nbox.png')
  !this.negPrimitiveTypeIcon[2]  = !!pml.getPathname('ncyl.png')
  !this.negPrimitiveTypeIcon[3]  = !!pml.getPathname('nslc.png')
  !this.negPrimitiveTypeIcon[4]  = !!pml.getPathname('nsno.png')
  !this.negPrimitiveTypeIcon[5]  = !!pml.getPathname('ndis.png')
  !this.negPrimitiveTypeIcon[6]  = !!pml.getPathname('ncon.png')
  !this.negPrimitiveTypeIcon[7]  = !!pml.getPathname('npyr.png')
  !this.negPrimitiveTypeIcon[8]  = !!pml.getPathname('ncto.png')
  !this.negPrimitiveTypeIcon[9]  = !!pml.getPathname('nrto.png')
  !this.negPrimitiveTypeIcon[10] = !!pml.getPathname('nxtr16.png')
  !this.negPrimitiveTypeIcon[11] = !!pml.getPathname('nrev.png')
--  !this.negPrimitiveTypeIcon[12] = !!pml.getPathname('npyr.png')

  -- Look-up table of full element type tags, indexed by type lists
  !this.primitiveTypeName[1]     = 'Box'
  !this.primitiveTypeName[2]     = 'Cylinder'
  !this.primitiveTypeName[3]     = 'Sloped Cylinder'
  !this.primitiveTypeName[4]     = 'Snout'
  !this.primitiveTypeName[5]     = 'Dish'
  !this.primitiveTypeName[6]     = 'Cone'
  !this.primitiveTypeName[7]     = 'Pyramid'
  !this.primitiveTypeName[8]     = 'Circular torus'
  !this.primitiveTypeName[9]     = 'Rectangular torus'
  !this.primitiveTypeName[10]    = 'Extrusion'
  !this.primitiveTypeName[11]    = 'Revolution'
--  !this.primitiveTypeName[12]    = 'Polyhedron'
  !this.negPrimitiveTypeName[1]  = 'Negative box'
  !this.negPrimitiveTypeName[2]  = 'Negative cylinder'
  !this.negPrimitiveTypeName[3]  = 'Negative sloped cylinder'
  !this.negPrimitiveTypeName[4]  = 'Negative snout'
  !this.negPrimitiveTypeName[5]  = 'Negative dish'
  !this.negPrimitiveTypeName[6]  = 'Negative cone'
  !this.negPrimitiveTypeName[7]  = 'Negative pyramid'
  !this.negPrimitiveTypeName[8]  = 'Negative circular torus'
  !this.negPrimitiveTypeName[9]  = 'Negative rectangular torus'
  !this.negPrimitiveTypeName[10] = 'Negative extrusion'
  !this.negPrimitiveTypeName[11] = 'Negative revolution'
--  !this.negPrimitiveTypeName[12] = 'Negative polyhedron'

  -- Setup lookup table of attribute gadgets versus attribute names
  !this.attributegadgetName = ARRAY()
  !this.attributeName       = ARRAY()

  !this.attributegadgetName.append(!this.xLengthBox.name())
  !this.attributeName.append('xLength')
  !this.xLengthBox.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.yLengthBox.name())
  !this.attributeName.append('yLength')
  !this.yLengthBox.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.zLengthBox.name())
  !this.attributeName.append('zLength')
  !this.zLengthBox.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.heightCylinder.name())
  !this.attributeName.append('height')
  !this.heightCylinder.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.diameterCylinder.name())
  !this.attributeName.append('diameter')
  !this.diameterCylinder.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.topDiameterCone.name())
  !this.attributeName.append('dTop')
  !this.topDiameterCone.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.bottomDiameterCone.name())
  !this.attributeName.append('dBottom')
  !this.bottomDiameterCone.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.heightCone.name())
  !this.attributeName.append('height')
  !this.heightCone.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.topDiameterSnout.name())
  !this.attributeName.append('dTop')
  !this.topDiameterSnout.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.bottomDiameterSnout.name())
  !this.attributeName.append('dBottom')
  !this.bottomDiameterSnout.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.offsetXSnout.name())
  !this.attributeName.append('xOffset')
  !this.offsetXSnout.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.offsetYSnout.name())
  !this.attributeName.append('yOffset')
  !this.offsetYSnout.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.heightSnout.name())
  !this.attributeName.append('height')
  !this.heightSnout.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.topXPyramid.name())
  !this.attributeName.append('xTop')
  !this.topXPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.topYPyramid.name())
  !this.attributeName.append('yTop')
  !this.topYPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.bottomXPyramid.name())
  !this.attributeName.append('xBottom')
  !this.bottomXPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.bottomYPyramid.name())
  !this.attributeName.append('yBottom')
  !this.bottomYPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.offsetXPyramid.name())
  !this.attributeName.append('xOffset')
  !this.offsetXPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.offsetYPyramid.name())
  !this.attributeName.append('yOffset')
  !this.offsetYPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.heightPyramid.name())
  !this.attributeName.append('height')
  !this.heightPyramid.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.diameterDish.name())
  !this.attributeName.append('diameter')
  !this.diameterDish.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.radiusDish.name())
  !this.attributeName.append('radius')
  !this.radiusDish.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.heightDish.name())
  !this.attributeName.append('height')
  !this.heightDish.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.inRadiusCTorus.name())
  !this.attributeName.append('rInside')
  !this.inRadiusCTorus.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.outRadiusCTorus.name())
  !this.attributeName.append('rOutside')
  !this.outRadiusCTorus.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.angleCTorus.name())
  !this.attributeName.append('angle')
  !this.angleCTorus.validateCall = '!this.validateAngle('
  !this.attributegadgetName.append(!this.inRadiusRTorus.name())
  !this.attributeName.append('rInside')
  !this.inRadiusRTorus.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.outRadiusRTorus.name())
  !this.attributeName.append('rOutside')
  !this.outRadiusRTorus.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.angleRTorus.name())
  !this.attributeName.append('angle')
  !this.angleRTorus.validateCall = '!this.validateAngle('
  !this.attributegadgetName.append(!this.heightRTorus.name())
  !this.attributeName.append('height')
  !this.heightRTorus.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.topXSCyli.name())
  !this.attributeName.append('xTShear')
  !this.topXSCyli.validateCall = '!this.validateShear('
  !this.attributegadgetName.append(!this.topYSCyli.name())
  !this.attributeName.append('yTShear')
  !this.topYSCyli.validateCall = '!this.validateShear('
  !this.attributegadgetName.append(!this.bottomXSCyli.name())
  !this.attributeName.append('xBShear')
  !this.bottomXSCyli.validateCall = '!this.validateShear('
  !this.attributegadgetName.append(!this.bottomYSCyli.name())
  !this.attributeName.append('yBShear')
  !this.bottomYSCyli.validateCall = '!this.validateShear('
  !this.attributegadgetName.append(!this.diameterSCyli.name())
  !this.attributeName.append('diameter')
  !this.diameterSCyli.validateCall = '!this.validateDistance('
  !this.attributegadgetName.append(!this.heightSCyli.name())
  !this.attributeName.append('height')
  !this.heightSCyli.validateCall = '!this.validateDistance('

  -- measure callbacks
  !this.xLengthBoxMeasure.callback = '!this.measure('
  !this.yLengthBoxMeasure.callback = '!this.measure('
  !this.zLengthBoxMeasure.callback = '!this.measure('
  !this.heightCylinderMeasure.callback = '!this.measure('
  !this.diameterCylinderMeasure.callback = '!this.measure('
  !this.topDiameterConeMeasure.callback = '!this.measure('
  !this.bottomDiameterConeMeasure.callback = '!this.measure('
  !this.heightConeMeasure.callback = '!this.measure('
  !this.diameterDishMeasure.callback = '!this.measure('
  !this.radiusDishMeasure.callback = '!this.measure('
  !this.heightDishMeasure.callback = '!this.measure('
  !this.topXPyramidMeasure.callback = '!this.measure('
  !this.topYPyramidMeasure.callback = '!this.measure('
  !this.bottomXPyramidMeasure.callback = '!this.measure('
  !this.bottomYPyramidMeasure.callback = '!this.measure('
  !this.offsetXPyramidMeasure.callback = '!this.measure('
  !this.offsetYPyramidMeasure.callback = '!this.measure('
  !this.heightPyramidMeasure.callback = '!this.measure('
  !this.topDiameterSnoutMeasure.callback = '!this.measure('
  !this.bottomDiameterSnoutMeasure.callback = '!this.measure('
  !this.offsetXSnoutMeasure.callback = '!this.measure('
  !this.offsetYSnoutMeasure.callback = '!this.measure('
  !this.heightSnoutMeasure.callback = '!this.measure('
  !this.diameterSCyliMeasure.callback = '!this.measure('
  !this.heightSCyliMeasure.callback = '!this.measure('
  !this.inRadiusCTorusMeasure.callback = '!this.measure('
  !this.outRadiusCTorusMeasure.callback = '!this.measure('
  !this.inRadiusRTorusMeasure.callback = '!this.measure('
  !this.outRadiusRTorusMeasure.callback = '!this.measure('
  !this.heightRTorusMeasure.callback = '!this.measure('

  -- initialise for positive and negative primitives
  !this.negativeMode = false
  !this.switchNegatives.tag = 'Switch to Negative Primitives'

  -- set icons
  !this.setIcons(true)
  !this.iconDatum.addPixmap(!!pml.getPathname('pnt24.png'))
  !this.iconDatum.setTooltip('Select Datum P-Point')
  -- initialise type icon to stop error message
  !this.cpIcon.addPixmap(!!pml.getPathname('exclamation16x16.png'))
  !measureIcon  = !!pml.getPathName('measure16.png')
  !this.xLengthBoxMeasure.addPixmap(!measureIcon)
  !this.yLengthBoxMeasure.addPixmap(!measureIcon)
  !this.zLengthBoxMeasure.addPixmap(!measureIcon)
  !this.heightCylinderMeasure.addPixmap(!measureIcon)
  !this.diameterCylinderMeasure.addPixmap(!measureIcon)
  !this.topDiameterConeMeasure.addPixmap(!measureIcon)
  !this.bottomDiameterConeMeasure.addPixmap(!measureIcon)
  !this.heightConeMeasure.addPixmap(!measureIcon)
  !this.diameterDishMeasure.addPixmap(!measureIcon)
  !this.radiusDishMeasure.addPixmap(!measureIcon)
  !this.heightDishMeasure.addPixmap(!measureIcon)
  !this.topXPyramidMeasure.addPixmap(!measureIcon)
  !this.topYPyramidMeasure.addPixmap(!measureIcon)
  !this.bottomXPyramidMeasure.addPixmap(!measureIcon)
  !this.bottomYPyramidMeasure.addPixmap(!measureIcon)
  !this.offsetXPyramidMeasure.addPixmap(!measureIcon)
  !this.offsetYPyramidMeasure.addPixmap(!measureIcon)
  !this.heightPyramidMeasure.addPixmap(!measureIcon)
  !this.topDiameterSnoutMeasure.addPixmap(!measureIcon)
  !this.bottomDiameterSnoutMeasure.addPixmap(!measureIcon)
  !this.offsetXSnoutMeasure.addPixmap(!measureIcon)
  !this.offsetYSnoutMeasure.addPixmap(!measureIcon)
  !this.heightSnoutMeasure.addPixmap(!measureIcon)
  !this.diameterSCyliMeasure.addPixmap(!measureIcon)
  !this.heightSCyliMeasure.addPixmap(!measureIcon)
  !this.inRadiusCTorusMeasure.addPixmap(!measureIcon)
  !this.outRadiusCTorusMeasure.addPixmap(!measureIcon)
  !this.inRadiusRTorusMeasure.addPixmap(!measureIcon)
  !this.outRadiusRTorusMeasure.addPixmap(!measureIcon)
  !this.heightRTorusMeasure.addPixmap(!measureIcon)

  -- Obstruction
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Hard')
  !rText.append('2')
  !dText.append('Soft')
  !rText.append('1')
  !dText.append('None')
  !rText.append('0')
  !this.obstruction.dText = !dText
  !this.obstruction.rText = !rText

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!genPrimitives.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!genPrimitives.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coord coord
  !this.position.linkOption('!!genPrimitives.position', !this.ew, !this.ns, !this.ud, !coord)

  -- Set Position Action
  !this.position.setAction('!!genPrimitives.setPosition()')

  !this.rotateAngle.val     = 0
  !rotateDText = ARRAY()
  !rotateRText = ARRAY()
  if (!coord eq 'ENU') then
    !rotateDText[1] = 'About X'
    !rotateDText[2] = 'About Y'
    !rotateDText[3] = 'About Z'
  else
    !rotateDText[1] = 'About U'
    !rotateDText[2] = 'About V'
    !rotateDText[3] = 'About W'
  endif
  !rotateRText[1] = 'X'
  !rotateRText[2] = 'Y'
  !rotateRText[3] = 'Z'
  !this.rotateDirection.dText = !rotateDText
  !this.rotateDirection.rText = !rotateRText
  !this.rotateDirection.val = 3

  -- Define EDG positional pick
  !this.edgDescription        = 'Place Primitive'
  !this.packet                = object EDGPACKET()
  !this.packet.positionLink('!!genPrimitives.position', 'Primitive')
  !this.packet.close          = '!!genPrimitives.packetClose()'
  !this.packet.escape         = '!!genPrimitives.packetEscape()'
  !this.packet.key            = 'Primitives'
  !this.packet.description    = !this.edgDescription
  --!this.packet.form           = !!genPrimitives
  !this.packet.priority       = 1
  !this.packet.remove         = false
  !this.packet.type           = 'dbModify'

  -- Define drawing & obstruction levels
  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP" $<!!genPrimitives.predefinedObs$>

  !this.predefinedObs.select('RTEXT','DEFAULT')
  handle any
    !this.predefinedObs.val = 1
  endhandle
  !this.setPredefinedObstruction()
  !this.fromLevel.val     = 0
  !this.toLevel.val       = 10

  -- Initialise Panels
--  !this.initialise()

  -- Initialise create button undo
  !this.undoCreate.description('Create Primitive')
  !this.undoCreate.undoAction('!!genPrimitives.createUndo()')
  !this.undoCreate.redoAction('!!genPrimitives.createRedo()')
  !this.createButton.setUndoable(!this.undoCreate)

  -- Initialise attribute change undo
  !this.undoSetAttribute.description('Change Attribute')
  !this.undoSetAttribute.undoAction('!!genPrimitives.attributeUndo()')
  !this.undoSetAttribute.redoAction('!!genPrimitives.attributeRedo()')

  -- Initialise position change undo
  !this.undoPosition.description('Position Primitive')
  !this.undoPosition.undoAction('!!genPrimitives.attributeUndo()')
  !this.undoPosition.redoAction('!!genPrimitives.attributeRedo()')

  -- Initialise rotate change undo
  !this.undoRotate.description('Rotate Primitive')
  !this.undoRotate.undoAction('!!genPrimitives.attributeUndo()')
  !this.undoRotate.redoAction('!!genPrimitives.attributeRedo()')
  !this.applyRotate.setUndoable(!this.undoRotate)

  !this.undoConnect.description('Align Primitive')
  !this.undoConnect.undoAction('!!genPrimitives.attributeUndo()')
  !this.undoConnect.redoAction('!!genPrimitives.attributeRedo()')
  !this.connectTo.setUndoable(!this.undoConnect)

  -- Aid Number
  !this.aidAxes   = !!aidNumbers.add('RotatePrimitive')
  !this.aidBox    = !!aidNumbers.add('BoxPrimitive')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setIcons
--
-- Description: Set Button Icons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setIcons(!positive is BOOLEAN)

  if( !positive ) then
    -- set ICONS for positive volume
    !this.iconCreateBox.addPixmap(!!pml.getPathname('box.png'))
    !this.iconCreateCyli.addPixmap(!!pml.getPathname('cyli.png'))
    !this.iconCreateCone.addPixmap(!!pml.getPathname('cone.png'))
    !this.iconCreatePyra.addPixmap(!!pml.getPathname('pyra.png'))
    !this.iconCreateDish.addPixmap(!!pml.getPathname('dish.png'))
    !this.iconCreateCtor.addPixmap(!!pml.getPathname('ctor.png'))
    !this.iconCreateRtor.addPixmap(!!pml.getPathname('rtor.png'))
    !this.iconCreateSlcy.addPixmap(!!pml.getPathname('slcy.png'))
    !this.iconCreateSnou.addPixmap(!!pml.getPathname('snou.png'))
    !this.iconCreateExtr.addPixmap(!!pml.getPathname('extr.png'))
    !this.iconCreateRevo.addPixmap(!!pml.getPathname('revo.png'))
  else
    -- set ICONS for negative volume
    !this.iconCreateBox.addPixmap(!!pml.getPathname('nbox.png'))
    !this.iconCreateCyli.addPixmap(!!pml.getPathname('ncyl.png'))
    !this.iconCreateCone.addPixmap(!!pml.getPathname('ncon.png'))
    !this.iconCreatePyra.addPixmap(!!pml.getPathname('npyr.png'))
    !this.iconCreateDish.addPixmap(!!pml.getPathname('ndis.png'))
    !this.iconCreateCtor.addPixmap(!!pml.getPathname('ncto.png'))
    !this.iconCreateRtor.addPixmap(!!pml.getPathname('nrto.png'))
    !this.iconCreateSlcy.addPixmap(!!pml.getPathname('nslc.png'))
    !this.iconCreateSnou.addPixmap(!!pml.getPathname('nsno.png'))
    !this.iconCreateExtr.addPixmap(!!pml.getPathname('nxtr16.png'))
    !this.iconCreateRevo.addPixmap(!!pml.getPathname('nrev.png'))
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use owner
  if(!wrtItem.unset()) then
    !wrtItem = !!ce.owner
    handle any
      !wrtItem = object DBREF('WORLD')
    endhandle
  endif

  -- Set tagging method
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  !this.undoPosition.add()
  !this.editElement.position = !position.offset( !this.offsetDirection.opposite(), !this.offsetDistance )
  -- make sure that CE is in correct place for undo
  !!ce = !this.editElement
  !this.undoPosition.endUndoable()
  !this.feedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setDatum
--
-- Description: Set position datum gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDatum()

  !dText = ARRAY()
  !rText = ARRAY()

  !dText.append('Origin')
  !rText.append('0')

  -- find p-points on primitive
  do !i
    !pnumber = !this.editElement.pPosition[!i]
    handle any
      break
    endhandle
    break if(!pnumber.up.unset())
    !dText.append( 'Ppoint ' + !i.string() )
    !rText.append( !i.string() )
  enddo

  -- Define datum option
  !this.refDatum.dText = !dText
  !this.refDatum.rText = !rText

  var !coord coord
  if(!coord.eq('ENU'))then
    !this.offsetDirection   = object DIRECTION('U')
  else
    !this.offsetDirection   = object DIRECTION('Z')
  endif

  !this.offsetDistance  = 0

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      datum
--
-- Description: Set position at selected datum
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .datum()

  !this.datumPpoint = !this.refDatum.selection().real()
  !this.setDatumOffset(!this.editElement.ppos[!this.datumPpoint])

  -- Set position to correspond to the P-point
  !this.position.setPositionNoAct(!this.editElement.ppos[!this.datumPpoint])
  !this.feedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setDatumOffset
--
-- Description: Set position at selected datum
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDatumOffset(!offsetPosition is POSITION)

  !this.offsetDistance  = !this.editElement.position.distance(!offsetPosition)
  if ( !this.offsetDistance.abs() lt 0.0001mm ) then
      var !coord coord
      if(!coord.eq('ENU'))then
        !this.offsetDirection   = object DIRECTION('U')
      else
        !this.offsetDirection   = object DIRECTION('Z')
      endif
  else
    !this.offsetDirection = !this.editElement.position.direction(!offsetPosition).wrt(!!ce)
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: Set REAL attribute data if in edit mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttribute(!gadget is GADGET, !action is STRING)

  -- return if not a MODIFY action
  if ( !action.upcase() ne 'SELECT' ) then
    return
  endif

  -- Data not recorded to the DB in create mode
  if (!this.createMode) then
    return
  endif

  if (!this.editElement.unset()) then
    return
  endif

  -- look up gadget in table to find corresponding attribute
  !index = !this.attributegadgetName.findFirst(!gadget.name())
  if ( !index.unset() ) then
    return
  endif

  -- Set the attribute
  !attributeName = !this.attributeName[!index]
  !this.undoSetAttribute.add()
  !this.editElement.attribute(!attributeName) = !gadget.val
  -- adjust position so that the selected datum stays in its current position
  !this.setDatumOffset(!this.editElement.ppos[!this.datumPpoint])
  !this.editElement.position = !this.position.get().offset( !this.offsetDirection.opposite(), !this.offsetDistance )
  !this.feedback()

  -- make sure that CE is in correct place for undo
  !!ce = !this.editElement
  !this.undoSetAttribute.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description: Handle measure callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measure(!gadget is GADGET, !unusedAction is STRING)

  !packet = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.description       = 'Measure Primitive Property'
  !packet.pickPacket.prompt = 'Measure Primitive Dimension'
  -- Set action to fill associated text field - BEWARE THAT MEASURE BUTTON NAME MUST BE FIELD NAME + 'MEASURE'
  !packet.action            = '!!genPrimitives.pasteMeasure(' + !gadget.fullName().before('MEASURE') + ', !this.return[1])'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pasteMeasure
--
-- Description: Paste measure result into gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pasteMeasure(!gadget is GADGET, !return is LINE)

  -- paste value into gadget
  !gadget.val = !return.length()
  -- fire callback for this gadget
  !this.setAttribute(!gadget, 'SELECT')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateDistance
--
-- Description: Check REAL distance attribute data input
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDistance(!gadget is GADGET, !action is STRING)

  -- return if not a VALIDATE action
  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  -- Check for unset values
  if( !gadget.val.unset())then
    !gadget.val = 0
  endif

  -- look up gadget in table to find corresponding attribute
  !index = !this.attributegadgetName.findFirst(!gadget.name())
  if ( !gadget.val lt 0 ) then

    if ( !index.unset() ) then
      !attributeName = 'distance'
    else
      !attributeName = !this.attributeName[!index]
    endif

    if (!attributeName inset ('xOffset', 'yOffset')) then
    else
      !warning = 'Please enter a positive value for ' +  !attributeName
      return error 1 |$!warning|
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateAngle
--
-- Description: Check REAL angle value is within range
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateAngle(!gadget is GADGET, !action is STRING)

  -- return if not a VALIDATE action
  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  -- Check for unset values
  if( !gadget.val.unset())then
    !gadget.val = 0
  endif

  -- look up gadget in table to find corresponding attribute
  !index = !this.attributegadgetName.findFirst(!gadget.name())

  if ( !gadget.val lt 0 or !gadget.val gt 180 ) then
    if ( !index.unset() ) then
      !attributeName = 'torus'
    else
      !attributeName = !this.attributeName[!index]
    endif
    !warning = 'Angle must be in range 0 to 180 degrees for ' +  !attributeName
    return error 1 |$!warning|
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateShear
--
-- Description: Check REAL shear value is within range
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateShear(!gadget is GADGET, !action is STRING)

  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  -- Check for unset values
  if ( !gadget.val.unset()) then
    !gadget.val = 0
  endif

  -- look up gadget in table to find corresponding attribute
  !index = !this.attributegadgetName.findFirst(!gadget.name())
  if ( !gadget.val lt -89 or !gadget.val gt 89 ) then

    if ( !index.unset() ) then
      !attributeName = 'shear'
    else
      !attributeName = !this.attributeName[!index]
    endif
    !warning = 'Shear must be in range -89 to 89 for ' + !attributeName
    return error 1 |$!warning|
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      kill
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .kill()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidBox)
  !!aidNumbers.hide(!this.aidAxes)

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.tidy()

  -- Remove applications events from system
  !this.edgTidy()

  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createUndo
--
-- Description: Go back to create page if CREATE undone
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createUndo()

  -- Go back to create page
  !this.next()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createRedo
--
-- Description: Go to create page if CREATE redone
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createRedo()

  -- edit the reinstated element
  !this.attributeRedo()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      attributeUndo
--
-- Description: Refresh form if attribute is changed
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .attributeUndo()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif
  -- Nothing to do if not in an edit mode
  if(!this.createMode) then
    return
  endif
  -- reset for undone element change
  !this.tidy()
  handle any
  endhandle
  -- Remove applications events from system
  !this.edgTidy()
  -- Rely on ce at primitive being saved for this undoable action
  !this.editElement = !!ce
  !this.modify(!this.editElement)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      attributeRedo
--
-- Description: Refresh form if attribute is changed
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .attributeRedo()

  -- reset for redone element change
  --!this.modify(!this.editElement)
  !this.attributeUndo()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      next
--
-- Description: Tidy up after completed create operation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .next()

  -- prepare for next create page
  !this.tidy()
  -- Remove applications events from system
  !this.edgTidy()
  !this.initialise()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      packetClose
--
-- Description: Tidy up after EDG close
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .packetClose()

  return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      packetEscape
--
-- Description: Tidy up after EDG close
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .packetEscape()

  -- If user presses escape in a user edit mode then form should close
  if ( !this.editAfterCreate ) then
    !this.next()
  else
    !this.close()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      edgTidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgTidy()

  -- Remove pending EDG picks
  !!edgCntrl.remove(!this.edgDescription)
  handle any
  endhandle
  !!edgCntrl.remove('Measure Primitive Property')
  handle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidBox)
  !!aidNumbers.hide(!this.aidAxes)
  !this.position.unLockAll()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply changes to the model after creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Apply changes

  if ( !this.primitiveType eq 'BOX' or !this.primitiveType eq 'NBOX') then
    !element = !this.createBox()
  elseif ( !this.primitiveType eq 'CYLI' or !this.primitiveType eq 'NCYL' ) then
    !element = !this.createCylinder()
  elseif ( !this.primitiveType eq 'CONE' or !this.primitiveType eq 'NCON' ) then
    !element = !this.createCone()
  elseif ( !this.primitiveType eq 'DISH' or !this.primitiveType eq 'NDIS' ) then
    !element = !this.createDish()
  elseif ( !this.primitiveType eq 'PYRA' or !this.primitiveType eq 'NPYR' ) then
    !element = !this.createPyramid()
  elseif ( !this.primitiveType eq 'SNOU' or !this.primitiveType eq 'NSNO' ) then
    !element = !this.createSnout()
  elseif ( !this.primitiveType eq 'CTOR' or !this.primitiveType eq 'NCTO' ) then
    !element = !this.createCTorus()
  elseif ( !this.primitiveType eq 'RTOR' or !this.primitiveType eq 'NRTO' ) then
    !element = !this.createRTorus()
  elseif ( !this.primitiveType eq 'SLCY' or !this.primitiveType eq 'NSLC' ) then
    !element = !this.createSlopedCylinder()
  endif

  if( !element.unset() ) then
    -- Note: need better error recovery than this
    -- However this error should not happen because of earlier checks
    if( !this.errorMessage.empty() ) then
      !this.errorMessage = 'Cannot create a primitive at this location in the database. Please navigate to an element that can contain 3D primitives'
    endif
    !!alert.warning(!this.errorMessage)
    !this.initialise()
    !this.errorMessage = ''
    return
  endif

  !this.setRepresentation(!element)

  !this.setupAfterCreate(!element)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupAfterCreate
--
-- Description: Set form for modification task after creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element just created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupAfterCreate(!element is DBREF)

  -- Apply changes
  !this.editAfterCreate = true
  !this.next.visible    = true
  !this.dismiss.visible = false
  !this.finalFrame.visible = true
  !this.track()

   var !coord coord
  !this.position.linkOption('!!genPrimitives.position', !this.ew, !this.ns, !this.ud, !coord)

  !this.modify(!element)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Public: Called to show this form to modify an existing
-- primitive element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!primitive is DBREF)

  -- check validity of passed element
  if( badref(!primitive) ) then
    !!alert.warning('Unknown element')
    return
  endif

  -- check for member of an extrusion or revolution passed
  if( !primitive.hardtype eq 'LOOP' ) then
    !element = !primitive.owner
  elseif( !primitive.hardtype eq 'VERT' ) then
    !element = !primitive.owner.owner
  else
    !element = !primitive
  endif

  -- check that passed element is correct type
  !this.negativeMode =!this.isNegativePrimitive(!element)
  if(!this.negativeMode.not()) then
    -- check for primitive
    !isPrimitive =!this.isPrimitive(!element)
    if( !isPrimitive.not() ) then
      !!alert.warning(!element.name + ' is not a primitive. Please navigate to a 3D primitive element to use this utility')
      hide !!genPrimitives
      return
    else
      !this.negativeMode = false
    endif
  endif

  -- check that this element can be updated
  if( !!dbrefUpdate(!element).not() ) then
    !!alert.warning('Access denied to modify ' + !element.name)
    return
  endif

  -- record that this is a user edit - not an edit following create
  !this.editAfterCreate = false
  !this.next.visible    = false
  !this.dismiss.visible = true
  !this.finalFrame.visible = true

  -- clear up any feedback
  !this.tidy()

  !this.modify(!element)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Set form from passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Gensec to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if form was successfully set up
--
------------------------------------------------------------------------

define method .modify(!element is DBREF)

   -- Link Position Option Gadgets to Objects
  var !coord coord
  !this.position.linkOption('!!genPrimitives.position', !this.ew, !this.ns, !this.ud, !coord)

  -- Add into EDG packet for position pick
  !!edgCntrl.add(!this.packet)

  !this.createMode  = false
  !this.editElement = !element

  -- Initialise Variable
  !this.primitiveType = !element.hardtype
  !this.negativeMode = !this.isNegativePrimitive(!element)
  if( !this.negativeMode ) then
    !negativeTitle   = ' negative '
  else
    !negativeTitle   = ' '
  endif
  !this.formTitle    = 'Modify' + !negativeTitle + 'Primitive'

  -- Apply changes
  if ( !this.primitiveType eq 'BOX' or !this.primitiveType eq 'NBOX' ) then
    !this.setupModifyBox()
  elseif ( !this.primitiveType eq 'CYLI' or !this.primitiveType eq  'NCYL' ) then
    !this.setupModifyCylinder()
  elseif ( !this.primitiveType eq 'CONE' or !this.primitiveType eq 'NCON' ) then
    !this.setupModifyCone()
  elseif ( !this.primitiveType eq 'DISH' or !this.primitiveType eq 'NDIS' ) then
    !this.setupModifyDish()
  elseif ( !this.primitiveType eq 'PYRA' or !this.primitiveType eq  'NPYR' ) then
    !this.setupModifyPyramid()
  elseif ( !this.primitiveType eq 'SNOU' or !this.primitiveType eq  'NSNO' ) then
    !this.setupModifySnout()
  elseif ( !this.primitiveType eq 'CTOR' or !this.primitiveType eq  'NCTO' ) then
    !this.setupModifyCTorus()
  elseif ( !this.primitiveType eq 'RTOR' or !this.primitiveType eq  'NRTO' ) then
    !this.setupModifyRTorus()
  elseif ( !this.primitiveType eq 'SLCY' or !this.primitiveType eq  'NSLC' ) then
    !this.setupModifySlopedCylinder()
  elseif ( !this.primitiveType eq 'EXTR') then
    !this.close()
    show !!dbeExtrusion
    !!dbeExtrusion.modifyMode(!element)
  elseif ( !this.primitiveType eq 'NXTR') then
    !this.close()
    show !!dbeNExtrusion
    !!dbeNExtrusion.modifyMode(!element)
  elseif ( !this.primitiveType eq 'REVO' or !this.primitiveType eq  'NREV' ) then
    !this.close()
    show !!dbeSRevolution
    !!dbeSRevolution.modifyMode(!element)
  else
    -- not a primitive edited by this tool
    !this.initialise()
    return
  endif

  if ( not !this.primitiveType inset('REVO', 'NREV', 'EXTR', 'NXTR' ) ) then
    -- Re-initialise the form
    !this.showCommonPanes()
    -- set up modify CE button
    !this.track()

    -- set representation
    !this.initRepresentation()

    -- set position
    !this.position.setPositionNoAct(!this.editElement.position)
    !this.position.setWrt(!this.editElement.position.origin)
    !this.datumPpoint = 0

    -- Set gadget with name of item
    !this.wrt.val = !this.editElement.position.origin.name

    !this.setDatum()

    !this.feedback()
  endif
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Set representation data to selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .representation(!object is GADGET, !action is STRING)

  if(!action eq 'SELECT') then

    if(!object eq !this.predefinedObs) then
      -- Predefined option selected
      !this.setPredefinedObstruction()
    endif

    -- value changed directly
    if( !this.editElement.set() ) then
      !this.setRepresentation(!this.editElement)
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPredefinedObstruction
--
-- Description: Set predefined representation data to selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPredefinedObstruction()

  -- Predefined option selected
  !key = !this.predefinedObs.selection()

  -- Get representation from system
  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP-DAT" $<KEY$> $<$!key$>
  if( defined(!!cdcnrtn) ) then
    !this.obstruction.select('RTEXT',!!cdinRtn)
    !this.fromLevel.val  = !!cdiaRtn[1].real()
    !this.toLevel.val    = !!cdiaRtn[2].real()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initRepresentation
--
-- Description: Initialise representation data to edit primitive
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initRepresentation()

  -- Try to choose description for ce
  !this.predefinedObs.val = 1
  !levels = !this.editElement.level
  !this.fromLevel.val     = !levels[1]
  !this.toLevel.val       = !levels[2]
  !obstructionType        = !this.editElement.obst
  !this.obstruction.select('RTEXT',!obstructionType.string())

  -- OLD CODE with BACKWARDS CALLS to find matching description
  !levelLow  = !levels[1]
  !levelHigh = !levels[2]
  $m/%PDMSUI%/CLIB/FILES/RDREP-DAT DATA $!<obstructionType> $!<levelLow> $!<levelHigh>
  if( defined(!!cdcnrtn) ) then
    !this.predefinedObs.select('DTEXT',!!cdcnrtn)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setRepresentation
--
-- Description: Set primitive representation levels
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRepresentation(!element is DBREF)

  if(!this.fromLevel.val.unset() or !this.toLevel.unset()) then
    return
  endif

  -- get levels
  if(!this.fromLevel.val le !this.toLevel.val) then
    !level[1] = !this.fromLevel.val
    !level[2] = !this.toLevel.val
  else
    !level[1] = !this.toLevel.val
    !level[2] = !this.fromLevel.val
  endif

  !element.level = !level

  !obstructionLevel = !this.obstruction.selection().real()
  handle any
    return
  endhandle
  !element.obstruction = !obstructionLevel

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createBox
