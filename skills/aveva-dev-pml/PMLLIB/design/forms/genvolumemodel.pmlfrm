--
-- Description:
--  Volume Model creation form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  chkName()                        -                   Name callback. Check name of element
--  close()                          -                   Close form
--  create()                         -                   OK button callback - creates element
--  genVolumeModel()                 -                   Constructor
--  initialise()                     -                   Initialise form
--  initialise(STRING)               -                   Initialise form for given element type
--  positionFeedback()               -                   Draws graphical feedback for Position link
--  setPosition()                    -                   Position link callback
--  setPosition(DBREF)               -                   Set position of given element
--  setPosition(POSITION)            -                   Position link set to given position
--  setWrt()                         -                   Set wrt item
--  tidy()                           -                   Tidy up aid graphics
--
------------------------------------------------------------------------

setup form !!genVolumeModel dialog

  !this.iconTitle     = 'VolMoldel'
  !this.formTitle     = 'Volume Model'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.12 $ '

  -------------------- Primitive Creation front page

  frame .createTasks panel  anchor left + right + top   at x0    y0    width 29
    text  .volName     'Name'   anchor left + right + top   at xmin  ymax  callback '!this.chkName()' width 18 is STRING
  exit

  -- Positioning Gadgets
  frame .positionFrame panel      anchor left + right + top  at x0  ymax.createTasks-0.2 width 29
    paragraph .posTag             anchor left + top          at x1  ymax-0.2    text 'Position'

    halign left
    option .ew    anchor left + bottom at x1 ymax width 5
    path down
    option .ns    anchor left + bottom  width 5
    option .ud    anchor left + bottom  width 5
    text   .x     anchor left + right + bottom at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     anchor left + right + bottom at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     anchor left + right + bottom at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag anchor right + bottom        at xmax+1 ymin.ew
    toggle .yFlag anchor right + bottom        at xmin   ymin.ns
    toggle .zFlag anchor right + bottom        at xmin   ymin.ud
    para   .lock  anchor right + bottom        at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    --  Reference (wrt)
    text .wrt 'wrt' anchor left + right + bottom  at x1  ymax.ud+0.2  callback '!this.setWrt()' width 20 string
  exit

  frame .createFrame panel        anchor left + right + top  at x0 ymax.positionFrame width 29
    button .cancelCreate 'Cancel' anchor right + top         at x21 ymax callback '!this.close()' width 7
    path left
    button .createButton '  OK  ' anchor right + top                     callback '!this.create()' width 7 OK
  exit

  -- Form Members

  -- Name of element
  member .volModelName          is STRING
  member .elementType           is STRING
  member .volModelType          is STRING
  member .subVolModelType       is STRING

  -- Form Control Members
  -- Position
  member .position              is POSITIONLINK

  -- Aid numbers for position & axes
  member .aidAxes               is REAL

  -- EDG Description
  member .edgDescription        is STRING

  -- Undo event handlers
  member .undoCreate            is UNDOABLE
  member .undoPosition          is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      genVolumeModel
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .genVolumeModel()

  -- Register form to show in any application, but not on start up
  !!appFormCntrl.registerForm(!this,ARRAY(),ARRAY(),false,false)

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'
  !this.elementType       = 'VOLM'
  !this.volModelType      = 'VOLM'
  !this.subVolModelType   = 'SUBM'

  -- Aid Number
  !this.aidAxes   = !!aidNumbers.add('volModOrigin')

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!genVolumeModel.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!genVolumeModel.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!genVolumeModel.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!genVolumeModel.setPosition()')

  -- Define EDG positional pick
  !this.edgDescription        = 'Place Volume Model'

  -- Initialise create button undo
  !this.undoCreate.description('Create Volume Model')
--  !this.undoCreate.undoAction('!this.createUndo()')
--  !this.undoCreate.redoAction('!this.createRedo()')
--  !this.createButton.setUndoable('!this.undoCreate')

  -- Initialise position change undo
  !this.undoPosition.description('Position Volume Model')
  !this.undoPosition.undoAction('!this.attributeUndo()')
  !this.undoPosition.redoAction('!this.attributeRedo()')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      chkName
--
-- Description: Name callback. Check name of element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chkName()

  -- Check name
  !name                         = !!checkName(!this.volName.val, 'NEW')

  -- Update gadget with name
  if(!name.set()) then
    !name                       = !name.substring(2)
    !this.volName.val           = !name
    !this.volModelName          = '/' + !name
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use owner
  if(!wrtItem.unset()) then
    !wrtItem = !!ce.owner
    handle any
      !wrtItem = object DBREF('WORLD')
    endhandle
  endif

  -- Set tagging method
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())
  !this.positionFeedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position on given element from position link
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!element is DBREF)

  -- Use form position
  !position = !this.position.get()
  !element.position = !position

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position link data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  -- set position
  !this.position.setPositionNoAct(!position)
  !this.position.setWrt(!position.origin)

  -- Set gadget with name of item
  !this.wrt.val = !position.origin.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.tidy()

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createUndo
--
-- Description: Reinitialise form if create undone
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

--define method .createUndo()

  -- Go back to create page
--  !this.close()

--endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Apply changes to the model after creation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()

  -- Apply changes
  if( !this.elementType eq !this.subVolModelType ) then
    NEW SVOLM
    handle (41,8)
      !!alert.error('cannot create sub volume model at current position in hierarchy')
      !this.close()
      return
    endhandle
  else
    NEW VOLMODEL
    handle (41,8)
      !!alert.error('cannot create volume model at current position in hierarchy')
      !this.close()
      return
    endhandle
  endif

  if ( !this.volModelName.set() ) then
    if( !this.volModelName.empty().not() ) then
      !!ce.name = !this.volModelName
    endif
  endif

  -- set element position from position link
  !this.setPosition(!!ce)

  -- tidy up and close
  !this.close()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise create mode for VOLM
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !this.initialise(!this.volModelType)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise create mode for given type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type - VOLM or SUBV
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!type is STRING)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!genVolumeModel.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Initialise variables
  !this.elementType = !type

  -- Find a suitable wrt for this element - choice is the lowest significant element to ce
  -- If element is a SUBV then set initial origin to its owner


  if( !type eq !this.subVolModelType ) then
    if(!!ce.type neq 'VOLM')then
    	VOLM
    	handle(2,111)
    		!!alert.error('Cannot create sub volume model in this level.Navigate to any volume model in the hierarchy')
    		return
      endhandle
    endif
    !wrt = !!ce.prmown
    -- creating SUBV
    if( !wrt.hardtype eq !this.subVolModelType ) then
      -- set wrt to VOLM
      !wrt = !wrt.owner
    endif
  elseif( !type eq !this.volModelType ) then
    !wrt = zone
    handle(2,111)
     !!alert.error('Cannot create volume model in this level.Navigate to any Zone or below in the hierarchy')
     return
    endhandle
  endif

  -- initialise position link
  !tempPos = object POSITION('N0 wrt $!wrt')
  !this.setPosition(!tempPos)
  !this.position.setWrt(!wrt)

  -- set form title
  if( !this.elementType eq !this.subVolModelType ) then
    !this.formTitle = 'Sub Volume Model'
  else
    !this.formTitle = 'Volume Model'
  endif

  -- clear name
  !this.volName.clear()
  !this.volModelName = ''

  -- set up edg position pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!genVolumeModel.position', 'VolumeModel')
  !packet.key            = 'VolumeModel'
  !packet.description    = !this.edgDescription
  !packet.close      = '!!genVolumeModel.tidy()'
  !packet.form           = !!genVolumeModel
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'dbModify'

  -- Add into EDG packet for position pick
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      positionFeedback
--
-- Description: Draw position axes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionFeedback()

  -- Draw axes at the orientation
  !gAxes = object GPHAXES(!this.position.get(), !this.position.get().origin.orientation)
  !gAxes.draw(!this.aidAxes)

endmethod
-- End of method definition
