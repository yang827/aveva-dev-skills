-- File:            hmcwaydefinition.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          Martin Ward
--  Created:        <date/time>
--
--
-- Description:
--   GUI for creation of "marker" holes in Hole Management system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply the previewed hole and create the associations
--  applyCreate()                    -                   apply the previewed hole and create the associations
--  applyModify()                    -                   apply the previewed hole and create the associations
--  changeHoleType()                 -                   change the hole configuration between single and merged penetrations
--  classSelected()                  -                   Triggered by selection of hole class from dropdown list
--  cleanUp()                        -                   cleanUp any created items when the form is dismissed
--  clear()                          -                   Clears penetration data from the form. Called when modifying
--  configureParameters()            -                   configure parameter fields for selected type
--  createMergedHoles()              -                   create the required fixing structure for single holes
--  createSingleHoles()              -                   create the required fixing structure for single holes
--  drawHole()                       -                   draw a hole from a defined shape in the menu. we should be able to manipulate
--  editProfile()                    -                   callback to edit the template profile
--  editProperties()                 -                   Callback to show parameters input form
--  evaluateSelectors()              -                   Choose valid items based on selectors
--  hmCWayDefinition()               -
--  initialise()                     -                   Initialisation - executed each time the form is shown
--  initialise(HMHOLE)               -                   Initialisation - executed when we are modifying a hole
--  initialiseCommon()               -                   Initialisation code common to create and modify mode
--  initialiseProperties(DBREF)      -                   Initialise properties for selected catalogue item
--  initialiseSelectors()            -                   Initialise selectors for the current hole table
--  modifyMergedHoles()              -                   Modify the required fixing structure for single holes
--  modifySingleHoles()              -                   Modify the required fixing structure for single holes
--  orderComponents(ARRAY)           BOOLEAN             orders a list of association components so this form can display them properly
--  orientateHole()                  -                   Pick the graphics to orientate the hole (only if penetrated item
--  orientation(GADGET,STRING)       -                   apply the meta event data to the oriang gadget so that the
--  penetrationSelector(GADGET,STRING) -                   Callback for hole component selection
--  penetrationTableSelect()         -                   Make a hole component selection
--  pickReturn(EDGPICKDATA)          -
--  presetSelectors()                -                   Set selectors for current selected hole type
--  processPenetrationData()         -                   Process data stored in the penetrationData array
--  readConfigurationFile()          -
--  resetHierarchy()                 -                   resets the penetration hierarchy so that you can switch between single and merged hole types
--  resetPosition(DBREF)             -                   resets the position of the penetration to its previous configuration after an undo operation has been carried out
--  selectStandard()                 -
--  selector(GADGET,STRING)          -                   Selection made
--  setPenetrationData(ARRAY)        -                   Create penetrations based on selected data
--  typeSelected()                   -                   Triggered by selection of hole type from dropdown list
--
------------------------------------------------------------------------

--- form definition
setup form !!hmCWayDefinition size 35 18 dialog dock left

-- Define member for currently loaded appware
  member .direction         is DIRECTION
  member .penetrated        is DBREF
  member .penetrating       is ARRAY
  member .debug             is BOOLEAN
  member .maxdespars        is REAL
  member .mode              is STRING
  member .undopoint1        is UNDOABLE
  member .edgDescription    is STRING
  -- true if this is a catalogue hole - false for a free hole
  member .catalogueHole     is BOOLEAN
  member .loop              is ARRAY
  member .fixingArea        is DBREF
  member .coaming           is BOOLEAN
  member .coamingArea       is DBREF
  member .coamingFixing     is DBREF
  -- true if running in marine environment
  member .marine            is BOOLEAN
  -- initialStatus stores the status of a hole being modified before the modifications are applied
  -- this will be checked against the status of the hole when changes are being applied to make sure
  -- that no harmful changes to status have occurred when the user was modifying.
  member .initialStatus     is STRING
  -- managedHole stores the managed hole that is being modified
  member .managedHole       is HMHOLE

  -- Array of penetration data objects. One for each penetration being processed on this form.
  member .multiPenetrationData  is ARRAY
  -- Array of PENETRATIONDATA type objects containing raw penetration data
  -- This is an array of different types of penetration objects all supporting the same interface
  member .penetrationData       is ARRAY
  -- Array of merged hole objects each containing their hole management penetration data objects
  member .mergedHoles           is ARRAY
  -- true if this is a merge hole, false for single
  member .merged                is BOOLEAN
  -- stores references of created virtual hole frameworks so we can modify ones already created during dynamic preview
  member .holeRef               is ARRAY
  -- Key to selected hole class
  member .holeClassKey          is STRING
  -- Standard hole GPART data
  member .gPartData             is HMHOLETYPE
  -- Hole type selection controller
  member .holeTypeController    is HMHOLETYPEMANAGER
  -- Properties data object
  member .comProp               is COMPROP
  -- aid number for aid graphics
  member .aidAxes               is REAL

  -- list of applications whose penetrations are managed by this form
  member .applications          is ARRAY
  -- list of Selection table purposes corresponding to the .applications list
  member .applicationPurpose    is ARRAY

  !!hmCWayDefinitionFormat = object FORMAT()
  !!hmCWayDefinitionFormat.dimension   = 'L'
  if (!!isImperialLength('DIST')) then
    !!hmCWayDefinitionFormat.units       = 'INCH'
    !!hmCWayDefinitionFormat.fraction    = TRUE
    !!hmCWayDefinitionFormat.denominator = 32
    !!hmCWayDefinitionFormat.zeros       = FALSE
  else
    !!hmCWayDefinitionFormat.units       = 'MM'
    !!hmCWayDefinitionFormat.dp          = 0
  endif
  !!hmCWayDefinitionFormat.label         = 'UNITS'

  hdist 0.5
  halign left
  vdist 0.3

  path down

-- Framing for type selection
  frame .frmType 'Hole type' anchor l+r+t  at x0 y0.2 width 35
    option .holeClass anchor l+r+t tagwidth 5 'Class' callback |!this.classSelected()|        width 22
    option .holeType  anchor l+r+t tagwidth 5 'Type'  callback |!this.typeSelected()|         width 22
  exit

  path down

-- Framing for design parameter input
  frame .frmDespar 'Hole shape parameters' anchor l+r+t at xmin form ymax + 0.2 width 35
    text .despar1 '1: ' anchor l+r+t tagwidth 15 callback |!this.drawHole()| width 9 is REAL format !!distanceFmt
    text .despar2 '2: ' anchor l+r+t tagwidth 15 callback |!this.drawHole()| width 9 is REAL format !!distanceFmt
    text .despar3 '3: ' anchor l+r+t tagwidth 15 callback |!this.drawHole()| width 9 is REAL format !!distanceFmt
    text .despar4 '4: ' anchor l+r+t tagwidth 15 callback |!this.drawHole()| width 9 is REAL format !!distanceFmt
    text .despar5 '5: ' anchor l+r+t tagwidth 15 callback |!this.drawHole()| width 9 is REAL format !!distanceFmt
    text .despar6 '6: ' anchor l+r+t tagwidth 15 callback |!this.drawHole()| width 9 is REAL format !!distanceFmt
  exit

-- Framing for type selection
  frame .frmTypeSelect 'Hole shape selection' anchor l+r+t at xmin form ymin.frmDespar width 35
    option .select1  anchor l+r+t tagwidth 10 'Type ' callback |!this.selector(|   width 18
    option .select2  anchor l+r+t tagwidth 10 'Type ' callback |!this.selector(|   width 18
    option .select3  anchor l+r+t tagwidth 10 'Type ' callback |!this.selector(|   width 18
    option .select4  anchor l+r+t tagwidth 10 'Type ' callback |!this.selector(|   width 18
    option .select5  anchor l+r+t tagwidth 10 'Type ' callback |!this.selector(|   width 18
    option .select6  anchor l+r+t tagwidth 10 'Type ' callback |!this.selector(|   width 18
    option .penetrationSelect  anchor l+r+t tagwidth 10 'Penetration' callback |!this.penetrationSelector(|   width 18
    button .bnProperties       anchor l+t               'Properties...'                                       width 12
  exit

-- Framing for positioning and orientation options
  frame .frmOri 'Positioning'     anchor l+r+t at xmin form ymax + 0.2 width 35
    text    .yOffset 'Open Offset'    anchor l+r+t tagwidth 9 callback |!this.drawHole()| width 9 is REAL format !!hmCWayDefinitionFormat
    text    .xOffset 'Width Offset'   anchor l+r+t tagwidth 9 callback |!this.drawHole()| width 9 is REAL format !!hmCWayDefinitionFormat
    text    .gap     'Gap'            anchor l+r+t tagwidth 9 callback |!this.drawHole()| width 9 is REAL format !!hmCWayDefinitionFormat
    numeric .oriang  'Rotation'       anchor l+t   tagwidth 9 callback '!this.orientation(' range -180 180 step 1 ndp 0 value 0 width 3
    option  .side    'Panel side'     anchor l+t   tagwidth 9 callback '!this.drawHole()' width 9
    button  .oriHole 'Orientate Hole' anchor r+t              callback |!this.orientateHole()| width 11 at xmax.oriang + 4 ymin.oriang
  exit

  button    .addItem 'Add Penetrating' at x15 ymax + 0.2

-- Frame showing current hole definition information
  frame .frmPredefined   anchor l+r+t 'Information' at xmin form ymax + 0.2 width 35
    text      .appCalled 'Purpose'    anchor l+t  tagwidth 7 at xmin + 0.2 ymax width 15 is STRING
    paragraph .loading                anchor l+r+t           at xmin       ymax width 25
  exit

-- Overall form buttons
  button .btnApply   'OK'     callback |!this.apply()|   anchor b+l at x0             ymax + 0.5    width 8 OK
  button .btnDismiss 'Cancel' callback |!this.cleanUp()| anchor b+r at xmax form-size ymin.btnApply width 8 CANCEL

-- End of FORM definition
exit


------------------------------------------------------------------------
-- Method:      hmCWayDefinition
-- Description: Constructor - executed once on form load up
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .hmCWayDefinition()

  -- Define titles and initialisation call
  !this.formtitle = 'Cable Hole Management Definition'
  !this.icontitle = 'Hole Management'
  !this.initcall  = '!this.initialise()'

  -- Initialise EDG picking
  !this.edgDescription     = 'Pick'

  -- Control output of additional messages to command window for debugging
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

  -- Maximum number of despar fields - matches number of text gadgets
  !this.maxdespars  = 6
  !this.loading.val = ' '

  -- initialise the hole management types
  !this.holeTypeController = object HMHOLETYPEMANAGER()
  !this.holeTypeController.loadFromCatalogue()

  -- Initialise application list and corresponding Selection Table purposes
  !this.applications[1]       = 'CABLINGSYSTEM'
  !this.applicationPurpose[1] = 'CPEN'

  -- initialise callback for user defined properties button
  !this.bnProperties.callback = |!this.editProperties()|
  !this.bnProperties.active   = false

  -- Seems the holeManMain form needs loading and initialising
  !this.readConfigurationFile()

  -- Find out if there is an area set up to create the fixing
  !finder     = object COLLECTION()
  !finder.type(|STRU|)
  !finder.filter(object EXPRESSION(|PURP eq 'HOLE' and dbwrite|))
  !fixingArea = !finder.results()
  if (!fixingArea.size() eq 0 ) then
    return error 1 |Unable to find Hole Management storage area: STRU with PURP=HOLE|
  else
    !this.fixingArea = !fixingArea[1]
  endif

  -- If this is a Marine project we need an area for holding the coaming
  !mm = object AVEVAMODULEMANAGER()
  !this.marine = (!mm.currentProductName().upcase().eq('HULL & OUTFITTING'))
  if (!this.marine) then
    -- Find out if there is an area set up to create the coaming
    !finder = object COLLECTION()
    !finder.type(|STRU|)
    !finder.filter(object EXPRESSION(|PURP eq 'HMCM' and dbwrite|))
    !coamingArea = !finder.results()
    if (!coamingArea.empty() ) then
      !!alert.error(|Unable to find Coaming storage area: STRU with PURP=HMCM. Coaming will not be created|)
    else
      !this.coamingArea = !coamingArea[1]
    endif
  endif

  !setSideDtext[1] = 'Front Face'
  !setSideDtext[2] = 'Back  Face'

  !setSideRtext[1] = 'front'
  !setSideRtext[2] = 'back'

  !this.side.dText = !setSideDtext
  !this.side.rText = !setSideRtext

  -- make information fields not editable
  !this.appCalled.setEditable(FALSE)

  -- allocate aid number
  !this.aidAxes    = !!aidNumbers.add('hmCWayDefinition-Axes')

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      initialise
-- Description: Initialisation - executed each time the form is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .initialise()

  if( !!isThisHmProj().not() ) then
    return
  endif

  -- Initialise hole class for this application
  !currentApplication      = !!appcntrl.currentapp
  !applicationIndex        = !this.applications.findFirst(!currentApplication)
  if( !applicationIndex.unset() ) then
    return error 2 |Current application $!<currentApplication> is not in the application list|
  endif

  -- initialise hole class selection
  !dText[1] = 'Standard Types'
  !rText[1] = 'STANDARD'
  !dText.appendArray(!this.holeTypeController.getHoleClassDescriptions(!this.applicationPurpose[!applicationIndex]))
  !rText.appendArray(!this.holeTypeController.getHoleClassReferences(!this.applicationPurpose[!applicationIndex]))
  !this.holeClass.dText = !dText
  !this.holeClass.rText = !rText

  --Find the fixing area if unset
  if (!this.fixingArea.unset()) then
    -- Find out if there is an area set up to create the fixing
    !finder     = object COLLECTION()
    !finder.type(|STRU|)
    !finder.filter(object EXPRESSION(|PURP eq 'HOLE' and dbwrite|))
    !fixingArea = !finder.results()
    if (!fixingArea.size() eq 0 ) then
      return error 1 |Unable to locate STRU to work in (PURP=HOLE)|
    else
      !this.fixingArea = !fixingArea[1]
    endif
  endif

  if (!this.marine and !this.coamingArea.unset()) then
    -- Find out if there is an area set up to create the coaming
    !finder      = object COLLECTION()
    !finder.type(|STRU|)
    !finder.filter(object EXPRESSION(|PURP eq 'HMCM' and dbwrite|))
    !coamingArea = !finder.results()
    if (!coamingArea.size() neq 0 ) then
      !this.coamingArea = !coamingArea[1]
    endif
  endif

  !this.addItem.active = FALSE

  !this.coamingFixing  = object DBREF()
  !this.coaming        = false

  !this.addItem.callback = 'show !!cwBranPenAdd'

  -- set the creation mode
  !this.mode = 'CREATE'

  if(!this.multiPenetrationData.empty())then
    -- initialise has been called from hmModify and we are in modify mode
    -- we will now return to hmModify where the initialise(type,components)
    -- method will be called
    return
  endif

  -- clear the created items array on initialise
  !this.holeRef.clear()
  !this.mergedHoles.clear()
  !this.managedHole = object HMHOLE()


  -- common gadget initialisation
  !this.initialiseCommon()

  if (!this.holeTypeController.loaded().not() ) then
    !this.cleanUp()
    return error 1 'Hole management catalogue not found. Hole management functions cannot be used. Please contact your system administrator.'
  endif

  -- pre-select hole type
  !this.holeClass.val = 1
  !this.classSelected()
  !selectIndex        = 1
  -- Process all holes in the list to create the first set of penetration fixings for preview
  do !index indices !this.holeType.dText
    skip if( !this.holeType.dText[!index].matchWild('*Type HR*').not() )
    !selectIndex = !index
    break
  enddo
  !this.holeType.val  = !selectIndex
  !this.typeSelected()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      initialise()
-- Description: Initialisation - executed when we are modifying a hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      HMHOLE      Object describing hole to be modified
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .initialise(!objHole is HMHOLE)

  if( !!isThisHmProj().not() ) then
    return
  endif

  -- initialise variables
  !this.clear()
  !this.managedHole   = !objHole
  !holeAssociation    = !objHole.getAssociation()
  !this.initialStatus = !objHole.getFullStatus()

  -- Get data from association members
  !components = ARRAY()
  do !assMember values !holeAssociation.members
    skip if( !assMember.hardType neq 'ASSMBR' )
    if (!assMember.asstar.set()) then
      !components.append(!assMember.asstar)
    else
      !components.append(!assMember.amemrf)
    endif
  enddo

  -- mark the database
  !this.undopoint1.add()

  -- set the creation mode
  !this.mode = 'MODIFY'

  -- Create penetration data for each component in the components array
  !ok = !this.orderComponents(!components)
  if( !ok.not() ) then
    return
  endif

  !this.initialiseCommon()

  if (!this.holeTypeController.loaded().not() ) then
    !!alert.error('Catalogue of Hole Types not found')
    return
  endif

  -- get hole details
  if( !this.mergedHoles.empty() ) then
    -- single hole
    !owningFixing    = !this.multiPenetrationData[1].getVirtualHole()
    !virtualSpref    = !this.multiPenetrationData[1].getVirtualSpref()
    !penetratingType = !this.multiPenetrationData[1].penetratingType
    !this.multiPenetrationData[1].drawAxes(!this.aidAxes)
    -- can only be one hole so merge is not a valid option
  else
    -- merged hole
    !owningFixing    = !this.mergedHoles[1].getVirtualHole()
    !virtualSpref    = !this.mergedHoles[1].getVirtualSpref()
    !penetratingType = !this.mergedHoles[1].masterPenetrationData.penetratingType
    !this.mergedHoles[1].drawAxes(!this.aidAxes)
    !this.frmDespar.visible     = false
    !this.frmTypeSelect.visible = false
    !this.catalogueHole         = false
    -- this is merged so could be split
  endif

  if( !virtualSpref.unset() ) then
    !foundHoleGPart = false
  else
    -- Standard GPART or table hole
    !foundHoleGPart = !this.holeTypeController.select(!virtualSpref)
     -- initialise hole class selection
    !dText[1] = 'Standard Types'
    !rText[1] = 'STANDARD'
    !penetratingPurpose = 'CPEN'
    if( !penetratingPurpose.empty() ) then
      !dText.appendArray(!this.holeTypeController.getHoleClassDescriptions())
      !rText.appendArray(!this.holeTypeController.getHoleClassReferences())
    else
      !dText.appendArray(!this.holeTypeController.getHoleClassDescriptions(!penetratingPurpose))
      !rText.appendArray(!this.holeTypeController.getHoleClassReferences(!penetratingPurpose))
    endif
    !this.holeClass.dText = !dText
    !this.holeClass.rText = !rText
  endif

  -- catalogue hole
  !this.catalogueHole   = true
  !holeType             = !this.holeTypeController.selected()
  -- Standard or Table item selection - set form gadgets
  !this.holeClassKey    = !this.holeTypeController.getSelectedHoleClass()
  !this.holeClass.select('RTEXT',!this.holeClassKey)
  -- Standard & user hole selection table
  !this.holeType.active = true
  !this.holeType.dText  = !this.holeTypeController.getDisplayText()
  !this.holeType.rText  = !this.holeTypeController.getReplacementText()
  if(!this.holeClassKey eq 'STANDARD') then
    !this.frmDespar.visible     = true
    !this.frmTypeSelect.visible = false
    !this.holeType.select('RTEXT',!holeType.getReplacementText())
    !this.holeTypeController.setLastParameterValue(!this.multiPenetrationData[1].getVirtualDesignParameters())
    !this.selectStandard()
  else
    -- select appropriate hole type for this fixing
    !this.frmDespar.visible     = false
    !this.frmTypeSelect.visible = true
    !selectedHoleType           = !this.holeTypeController.getSelectedHoleType()
    !this.holeType.select('RTEXT',!selectedHoleType)
    !this.initialiseSelectors()
    !this.presetSelectors()
    !this.evaluateSelectors()
    !this.penetrationSelect.select('RTEXT',!holeType.getReplacementText())
    !this.penetrationTableSelect()
  endif

  -- clear the created items array on initialise
  !this.holeRef.clear()

  -- Set hole reference to virtual fixing framework
  !this.holeRef.append(!owningFixing.owner)

  -- reset the offset positions on the form
  !this.resetPosition(!owningFixing)

  !this.addItem.active = TRUE

  if (!this.managedHole.coaming.set()) then
    !this.coamingFixing = !this.managedHole.coaming.amemrf
    if( not badref(!this.coamingFixing) ) then
      -- coaming area is the area owning any existing coaming
      !this.coamingArea = !this.coamingFixing.owner.owner
    endif
  endif

  -- Check the current thickness to see if it has changed, if so re-draw the hole
  !!ce = !objHole.element
  lnID /HoleOwner
  !storedThickness = !!ce.realEv
  !currentThickness = !this.multiPenetrationData[1].thickness
  if (!storedThickness.neq(!currentThickness)) then
    !this.drawHole()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      .initialiseCommon()
-- Description: Initialisation code common to create and modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .initialiseCommon()

  !this.appCalled.val         = !!appcntrl.currentapp
  !this.cancelcall            = |!this.cleanUp()|

  !this.oriang.modifiedevents = true
  !this.frmType.visible       = true
  !this.frmDespar.visible     = false
  !this.btnApply.active       = true

  -- Check for penetrated item that requires interactive orientation because
  -- orientation cannot be determined from the penetrated element
  !this.oriHole.visible       = FALSE
  do !penetrated values !this.multiPenetrationData
    !penetratedElement        = !penetrated.getPenetrated()
    !penetratedType           = !penetratedElement.type
    if (!penetratedType eq 'HPLATE') then
      if (!penetratedElement.knuckl) then
        !this.oriHole.visible = TRUE
        break
      endif
    elseif (!penetratedType inset ('CPLATE','CTWALL','SCTN','GENSEC','STWALL','WALL','BPANEL')) then
      !this.oriHole.visible   = TRUE
      break
    endif
  enddo

  -- Initialise form gadgets
  !this.xOffset.val   = 0
  !this.yOffset.val   = 0
  !branch             = !this.multiPenetrationData[1].getPenetrating()
  !this.yOffset.val   = ( !branch.vHeight / 2 )
  !justification      = !branch.cwjusl.upcase()
  if (!justification eq '' or !justification eq 'CENT') then
    !this.xOffset.val = 0
  elseif (!justification eq 'RIGH') then
    !this.xOffset.val = ( !branch.vWidth / -2 )
  elseif (!justification eq 'LEFT') then
    !this.xOffset.val = ( !branch.vWidth / 2 )
  else
    !this.xOffset.val = 0
  endif

  -- initialise gap from thickness of first penetrated
  !this.gap.val                   = !this.multiPenetrationData[1].getPenetratedThickness()
--  !this.clearance.val             = 0
  !this.oriang.val                = 0
  !this.addItem.active            = FALSE

  -- Clear user defined profile in case it is left over from last use of form
  !this.holeClass.clear('User Defined Profile')
  handle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      .clear()
-- Description: Clears penetration data from the form. Called when modifying
--              a hole so the .initialise() method does not attempt
--              to create a new hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .clear()

  !this.multiPenetrationData.clear()
  !this.mergedHoles.clear()
  !this.holeRef.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      .orderComponents()
-- Description: orders a list of association components so this form can display them properly
--              Input array must contain grouped items 1 penetrating : 1 marker : 1 sub-fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole type
--    2   R      ARRAY       Input array must contain grouped items
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if data gathered OK
------------------------------------------------------------------------
define method .orderComponents(!components is ARRAY) is BOOLEAN

  -- loop through the passed components array create penetration data for each component

  -- Separate the different types of components into different arrays
  !penetrating       = ARRAY()
  !penetrationMarker = ARRAY()
  !penetrationMarkerOffset = ARRAY()
  !virtualHole       = object DBREF()
  !subFixings        = ARRAY()
  !panel             = object DBREF()
  do !component values !components

    skip if( badref(!component) )
    !componentType   = !component.hardType
    if ( !componentType inset('PANE', 'HPLATE', 'CPLATE', 'HPANEL', 'CPANEL', 'CTWALL', 'BPANEL','GENSEC','SCTN') ) then
      -- Penetrated item
      !panel = !component
    elseif ( !componentType eq 'CWBRAN' ) then
      -- penetrating item
      !penetrating.append(!component)
    elseif ( !componentType eq 'RNODE' ) then
      if( !component.rnType eq 'PENE' ) then
        -- Penetration marker
        !penetrationMarker.append(!component)
      elseif( !component.rnType eq 'OFFS' ) then
        -- Penetration marker offset
        !penetrationMarkerOffset.append(!component)
      endif
    elseif (!componentType eq 'DPCA') then
      !item = !component.owner.owner
      if( !item.hardType eq 'FIXING' ) then
        -- This must be a penetration sub-fixing
        if( !virtualHole.unset() ) then
          !virtualHole = !item
        else
          if( !virtualHole neq !item ) then
            -- more than one virtual hole should not be passed to this function
            !this.hide()
            !!alert.error('Hole incorrectly setup. Please validate the hole using the Hole Management form')
            return false
          endif
        endif
        !subFixings.append(!component)
      endif
    endif

  enddo

  -- check that minimum data requirements have been met
  if ( !panel.unset() or !penetrating.empty() or !penetrationMarker.empty() or !penetrationMarkerOffset.empty()  or !subFixings.empty() ) then
    !this.hide()
    !!alert.error('Hole incorrectly setup. Please validate the hole using the Hole Management form')
    return false
  endif

  -- check that we have a consistent set of penetrating, marker and sub-fixing
  if ( !penetrating.size() neq !penetrationMarker.size() or !penetrationMarkerOffset.size() neq !penetrationMarker.size() or !penetrating.size() neq !subFixings.size() ) then
    !this.hide()
    !!alert.error('Hole incorrectly setup. Please validate the hole using the Hole Management form')
    return false
  endif

  -- save the multi-penetration data
  do !count from 1 to !subFixings.size()
    !penetrationDataObject = object HMPENETRATIONDATA(!penetrating[!count], !penetrationMarker[!count], !panel )
    !penetrationDataObject.setVirtualHole(!virtualHole)
    !penetrationDataObject.setVirtualPenetration(!subFixings[!count])
    !penetrationDataObject.setOffsetPenetratingMarker(!penetrationMarkerOffset[!count])
    !this.multiPenetrationData.append(!penetrationDataObject)
  enddo

  if (!this.managedHole.coaming.set()) then
    !this.coamingFixing  = !this.managedHole.coaming.amemrf
    !this.multiPenetrationData[1].setCoaming(!this.coamingFixing)
  endif

  !this.merged = ( !subFixings.size() gt 1 )

  if( !this.merged ) then
    -- create a merged penetration object
    !this.mergedHoles[1] = object HMMERGEDPENETRATION()
    -- cable way offset is from the master penetrating item
    !this.multiPenetrationData[1].usePenetratingMarkerPosition()
    !this.mergedHoles[1].setMasterPenetration(!this.multiPenetrationData[1])
    !this.mergedHoles[1].centredPosition(false)
    do !index from 2 to !this.multiPenetrationData.size()
      -- subsequent penetrations are added as secondary penetrations
      !this.mergedHoles[1].addPenetration(!this.multiPenetrationData[!index])
    enddo
    -- tell the merged hole that the penetration data added to this object has already been processed
    !this.mergedHoles[1].setCreated(true)
  endif

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      classSelected()
-- Description: Triggered by selection of hole class from dropdown list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .classSelected()

  !this.holeClassKey      = !this.holeClass.selection()
  !this.holeTypeController.selectHoleClass(!this.holeClassKey)

  if( !this.holeClassKey.upcase() eq 'STANDARD' ) then
    !this.frmDespar.visible     = true
    !this.frmTypeSelect.visible = false
    !this.catalogueHole         = true
  else
    !this.frmDespar.visible     = false
    !this.frmTypeSelect.visible = true
    !this.catalogueHole         = true
  endif

  -- Standard & user hole selection table
  !this.holeType.active = true
  !this.holeType.dText  = !this.holeTypeController.getDisplayText()
  !this.holeType.rText  = !this.holeTypeController.getReplacementText()
  if( !this.holeType.dText.empty() ) then
    -- no catalogues loaded
    !this.cleanUp()
    return error 1 'Hole management catalogue not found. Hole management cannot be used. Please contact your system administrator.'
  endif
  !this.holeType.val    = 1

  -- initialise type selection
  !this.typeSelected()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      typeSelected()
-- Description: Triggered by selection of hole type from dropdown list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .typeSelected()

  -- get current hole type selection and get data from hole type manager
  if( !this.holeClassKey.upcase() eq 'STANDARD' ) then
    -- Type option selects a standard hole type
    !this.selectStandard()
    !this.drawHole()
  else
    -- Type option selects a selection table (CTABLE)
    !choice = !this.holeType.selection()
    !this.loading.val = 'Loading Catalogue - Please Wait...'
    !this.loading.refresh()
    !this.holeTypeController.selectHoleType(!choice)
    !this.initialiseSelectors()
    !this.evaluateSelectors()
    !this.loading.val = ' '
    !this.drawHole()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialiseSelectors
--
-- Description: Initialise selectors for the current hole table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Pre-select current design item if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseSelectors()

  -- clear all selector gadgets and make them invisible
  do !index from 1 to 6
    !option = !this.select$!<index>
    !option.visible = false
  enddo

  !this.penetrationSelect.clear()

  -- get question definitions for this hole type
  !questions                = !this.holeTypeController.getQuestions()

  -- set up the question gadgets
  do !questionNumber indices !questions
    !answers        = ARRAY()
    !answers[1]     = 'Select...'
    !question       = !questions[!questionNumber]
    !questionType   = !question[6]
    if( !questionType eq 'BOOL' ) then
      !answers[2]   = 'YES'
      !answers[3]   = 'NO'
    else
      !answers.appendArray(!this.holeTypeController.getUniqueAnswers(!questionNumber))
    endif
    !option         = !this.select$!<questionNumber>
    !option.tag     = !question[2]
    !option.visible = true
    !option.dText   = !answers
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      selector()
-- Description: Selection made
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .selector(!optionGadget is GADGET, !action is STRING)

  if( !action eq 'SELECT' ) then
    !this.evaluateSelectors()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      evaluateSelectors()
-- Description: Choose valid items based on selectors
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .evaluateSelectors()

  !chooseQuestions = ARRAY()
  !chooseAnswers   = ARRAY()
  -- get all questions for the current selected hole type
  !questions = !this.holeTypeController.getQuestions()
  -- get the selection option gadgets current values
  do !questionNumber from 1 to !questions.size()
    !option  = !this.select$!<questionNumber>
    !answer  = !option.selection()
    skip if(!answer eq 'Select...')
    !chooseQuestions.append(!questions[!questionNumber][1])
    if( !questions[!questionNumber][6] eq 'BOOL' ) then
      !chooseAnswers.append( !answer eq 'YES' )
    else
      !chooseAnswers.append(!answer)
    endif
  enddo
  -- choose remaining valid items for selection based on current questions and answers
  !this.holeTypeController.choose(!chooseQuestions, !chooseAnswers)
  -- get replacement text for remaining items and set penetration component selector
  !remainingItems                = !this.holeTypeController.getChooseRText()
  !dText = ARRAY()
  !rText = ARRAY()
  if( !remainingItems.empty() ) then
    !dText[1] = 'No items match selection'
    !rText[1] = 'UNSET'
    !this.penetrationSelect.active = false
  else
    !dText[1] = 'Select...'
    !rText[1] = 'UNSET'
    !dText.appendArray(!this.holeTypeController.getChooseDText())
    !rText.appendArray(!remainingItems)
    !this.penetrationSelect.active = true
  endif
  !this.bnProperties.active      = false
  !this.penetrationSelect.dText  = !dText
  !this.penetrationSelect.rText  = !rText

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      presetSelectors()
-- Description: Set selectors for current selected hole type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .presetSelectors()

  !chooseQuestions = ARRAY()
  !chooseAnswers   = ARRAY()
  !holeType        = !this.holeTypeController.selected()
  !questions       = !holeType.getQuestions()
  do !questionNumber from 1 to !questions.size()
    !option        = !this.select$!<questionNumber>
    !answer        = !holeType.getAnswer(!questionNumber)
    if( !questions[!questionNumber][6] eq 'BOOL' ) then
      if( !answer eq 'TRUE' ) then
        !answer    = 'YES'
      else
        !answer    = 'NO'
      endif
    endif
    if(!answer.empty()) then
      !option.select('DTEXT','Select...')
    else
      !option.select('DTEXT',!answer)
      handle any
        !option.select('DTEXT','Select...')
      endhandle
    endif
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      penetrationSelector()
-- Description: Callback for hole component selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .penetrationSelector(!optionGadget is GADGET, !action is STRING)

  if( !action eq 'SELECT' ) then
    !selection = !optionGadget.selection()
    if( !selection.upcase() neq 'UNSET') then
      -- select the item
      !this.holeTypeController.select(!selection)
      -- get the part definition
      !this.penetrationTableSelect()
      !this.drawHole()
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      penetrationTableSelect()
-- Description: Make a hole component selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .penetrationTableSelect()

  -- get the part definition
  !this.gPartData        = !this.holeTypeController.selected()
  !this.catalogueHole    = TRUE
  !this.xOffset.active   = TRUE
  !this.yOffset.active   = TRUE
  !this.gap.active       = TRUE
  !this.oriang.active    = TRUE
  if (!this.gPartData.hasCoaming()) then
    if (!this.marine and !this.coamingArea.unset()) then
      !this.side.visible = FALSE
      !this.coaming      = FALSE
      !!alert.error('A Fixing with additional coaming has been chosen but there is no STRU to work in (PURP=HMCM). Coaming will not be created')
    else
      !this.coaming      = TRUE
      !this.side.visible = TRUE
    endif
  else
    !this.coaming        = FALSE
    !this.side.visible   = FALSE
  endif

  -- Initialise properties for new item
  !this.initialiseProperties(!this.gPartData.specification())

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialiseProperties
--
-- Description: Initialise properties for selected catalogue item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selected item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseProperties(!selectedItem is DBREF)

  -- Initialise properties
  !this.comProp = object COMPROP()
  !this.comProp.initialise(!selectedItem)
  handle any
    !this.bnProperties.active = false
  elsehandle none
    !this.bnProperties.active = !this.holeTypeController.getUserParameters().empty().not()
    !this.comProp.editFormBlockOwn(true)
    !this.comProp.autoCacheValues(true)
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      selectedStandard()
-- Description: Triggered by selection of hole type from dropdown list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .selectStandard()

  -- get current hole type selection and get data from hole type manager
  !choice                = !this.holeType.selection()
  !this.holeTypeController.select(!choice)

  !this.gPartData        = !this.holeTypeController.selected()

  -- Catalogue hole
  -- Depending on choice sort out input fields for DesPar values
  -- configure parameter fields for selected type
  !this.configureParameters()
  !this.catalogueHole    = TRUE
  !this.xOffset.active   = TRUE
  !this.yOffset.active   = TRUE
  !this.gap.active       = TRUE
  !this.oriang.active    = TRUE
  if (!this.gPartData.hasCoaming()) then
    if (!this.marine and !this.coamingArea.unset()) then
      !this.side.visible = FALSE
      !this.coaming      = FALSE
      !!alert.error('A Fixing with additional coaming has been chosen but there is no STRU to work in (PURP=HMCM). Coaming will not be created')
    else
      !this.coaming      = TRUE
      !this.side.visible = TRUE
    endif
  else
    !this.coaming        = FALSE
    !this.side.visible   = FALSE
  endif

  -- Display the frame for user input
  !this.frmDespar.visible     = true
  !this.frmTypeSelect.visible = false

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      configureParameters()
-- Description: configure parameter fields for selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .configureParameters()

  -- hide parameter fields
  do !loop to !this.maxdespars
    !this.despar$!loop$n.active  = FALSE
    !this.despar$!loop$n.visible = FALSE
    !this.despar$!loop$n.val     = 0
  enddo

  if( !this.holeClassKey.upcase() eq 'STANDARD' ) then

    -- configure user parameter fields for selected type
    !parameterKeys = !this.gPartData.getUserParameters()
    do !loop indices !parameterKeys
      !parameterKey = !parameterKeys[!loop]
      !this.despar$!loop$n.tag     = !this.gPartData.getParameterTitle(!parameterKey)
      -- if we have previously set up despars for this hole type then use the stored values
      -- to prevent having to re-input values
      !this.despar$!loop$n.val     = !this.gPartData.getLastParameterValue(!parameterKey)
      !this.despar$!loop$n.active  = TRUE
      !this.despar$!loop$n.visible = TRUE
    enddo

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      apply()
-- Description: apply the previewed hole and create the associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .apply()

  if !this.mode.eq('CREATE') then
    !this.applyCreate()
  else
    -- modify mode
    !this.applyModify()
  endif

  !this.holeRef.clear()

  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      applyCreate()
-- Description: apply the previewed hole and create the associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .applyCreate()

  -- create an array of penetrated items so we can see how many stru/fixing hierarchies we need to create
  if( !this.merged.not()  ) then

    -- Single penetrations
    -- we need to apply single hole penetrations
    !interface = object HMINTERFACE()

    do !j from 1 to !this.multiPenetrationData.size()

      if(!this.marine and !this.coaming and !this.coamingArea.set()) then
        -- Coaming only applied if the penetrated item is a hull plate
        !coamingFixing = !this.multiPenetrationData[!j].createCoaming(!this.coamingArea)
      endif

      -- get list of elements in this penetration in an array format suitable for HMCONTROL
      !itemList = !this.multiPenetrationData[!j].getItemList()
      !result = !interface.createCWayHole(!itemList.unique(), !this.multiPenetrationData[!j].getPosition())
      if (!result.not()) then
        !!alert.error('Failed to create HM hole - ' + !!error.text)
      endif

      -- Get the thickness and then store it on the hole owner association member
      !thick = !this.multiPenetrationData[!j].thickness
      !fixi = !this.multiPenetrationData[!j].virtualHoleRef
      !assos = !fixi.assos[1]
      !!ce = !assos
      LnID /HoleOwner
      realXpr $!thick

    enddo

    -- set CE to virtual hole so that user can modify immediately
    !!ce = !this.multiPenetrationData[1].getVirtualHole()
    handle any
    endhandle

  else

    -- Merged hole penetration
    !interface = object HMINTERFACE()

    do !j from 1 to !this.mergedHoles.size()

      if(!this.marine and !this.coaming and !this.coamingArea.set()) then
        -- Coaming only applied if the penetrated item is a hull plate
        !coamingFixing = !this.mergedHoles[!j].createCoaming(!this.coamingArea)
      endif

      -- get list of elements in this penetration in an array format suitable for HMCONTROL
      !itemList    = !this.mergedHoles[!j].getItemList()
      !result = !interface.createCWayHole(!itemList.unique(), !this.mergedHoles[!j].getPosition())

      if (!result.not()) then
          !!alert.error('Failed to create HM hole - ' + !!error.text)
      endif

      -- Store the thickness as a real expression on the penetrated item association reference
      !thick = !this.mergedHoles[!j].multiPenetrationData[1].thickness
      !fixi = !this.mergedHoles[!j].virtualHoleRef
      !assos = !fixi.assos[1]
      !!ce = !assos
      LnID /HoleOwner
      realXpr $!thick

    enddo

    -- set CE to virtual hole so that user can modify immediately
    !!ce = !this.mergedHoles[1].getVirtualHole()
    handle any
    endhandle

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      applyModify()
-- Description: apply the previewed hole and create the associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .applyModify()

  !hmControl = object HMCONTROL()
  !hole = object HMHOLE(!this.managedHole.element)

  if (!this.marine and !this.coamingArea.set()) then
    if (!this.coaming) then
      -- Add the coaming item if the hole did not originally have any coaming or coaming is changed
      !addCoaming = !this.coamingFixing.unset()
      if (badref(!this.coamingFixing)) then
        -- Add the coaming item if the coaming has changed
        !hmControl.deleteInvalidRefs(!hole)
        !addCoaming = true
      endif
      if( !addCoaming ) then
        if( !this.mergedHoles.empty() ) then
          -- single hole
          !coamingFixing   = !this.multiPenetrationData[1].createCoaming(!this.coamingArea)
        else
          -- merged hole
          !coamingFixing   = !this.mergedHoles[1].createCoaming(!this.coamingArea)
        endif
        if( !coamingFixing.set() ) then
          !items = ARRAY()
          !items.append(!coamingFixing)
          !hmControl.addToHole(!hole, !items)
        endif
      endif
    else
      -- Coaming not required - Delete the hole association member if the hole originally had coaming
      if (badref(!this.coamingFixing)) then
        !hmControl.deleteInvalidRefs(!hole)
      endif
    endif
  endif
  -- Reset the stored thickness on the penetrated association member
  !!ce = !hole.element
  lnId /HoleOwner
  realxpr $!this.multiPenetrationData[1].thickness

  --update the hole data
  !hmControl.modifyHole(!hole)

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      drawHole()
-- Description: draw a hole from a defined shape in the menu. we should be able to manipulate
--              the appware so that this shape is redrawn in real time to allow the designer to
--              see what they want to create before they apply it.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .drawHole()

  !!aidNumbers.hide(!this.aidAxes)

  -- Do not allow OK on form if current selection is not valid
  !this.btnApply.active = !this.holeTypeController.isSelected()

  if(!this.merged.not()) then
    -- Single holes
    if( !this.holeRef.size() eq 0 ) then
      !this.createSingleHoles()
    else
      !this.modifySingleHoles()
    endif
    do !index to !this.multiPenetrationData.size()
      !this.multiPenetrationData[!index].drawAxes(!this.aidAxes)
    enddo
  else
    -- merged holes
    if( !this.holeRef.size() eq 0 ) then
      !this.createMergedHoles()
    else
      !this.modifyMergedHoles()
    endif
    do !index to !this.mergedHoles.size()
      !this.mergedHoles[!index].drawAxes(!this.aidAxes)
    enddo
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      orientation()
-- Description: apply the meta event data to the oriang gadget so that the
--              drawHole method will work when using the value up and down buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .orientation(!dummyObject is GADGET, !dummySelect is STRING)

--  !this.oriang.val = !this.oriang.val
  !this.drawHole()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      createSingleHoles()
-- Description: create the required fixing structure for single holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .createSingleHoles()

  -- clear any existing holes in the holeRef array (holes created but not applied)
  !this.holeRef.clear()
  !this.mergedHoles.clear()

  -- create the virtual fixings for each penetration
  do !i from 1 to !this.multiPenetrationData.size()

    -- Clean up the position data from clasher if multi-penetration and on the edge of an HPLATE by using penetrating marker position
    !this.multiPenetrationData[!i].usePenetratingMarkerPosition()

    -- set offset
    !this.multiPenetrationData[!i].setOffset(!this.xOffset.val, !this.yOffset.val)
    -- set gap
    !this.multiPenetrationData[!i].setGap(!this.gap.val)
    -- set angle
    !this.multiPenetrationData[!i].setAngle(!this.oriang.val)
    -- set justification of coaming - BACK or FRONT
    if( !this.coaming ) then
      !this.multiPenetrationData[!i].setCoamingJustification(!this.side.selection())
    endif

    if (!this.catalogueHole) then

      -- update the current gPartData to the current selected hole type
      !this.gPartData = !this.holeTypeController.selected()

      -- set the virtual fixing Design Parameters
      !this.multiPenetrationData[!i].setHoleType(!this.gPartData)

      -- create virtual hole fixing and sub-fixing
      !virtualFramework = !this.multiPenetrationData[!i].createVirtualFixing(!this.fixingArea)

      -- get the despars for the penetrating sub-fixing and store as latest parameters for the selected hole type
      !this.holeTypeController.setLastParameterValue(!this.multiPenetrationData[!i].getVirtualDesignParameters())

      !this.configureParameters()

      -- record new holes created (FRMW level)
      !this.holeRef.append(!virtualFramework)

    endif

    -- update coaming if required
    if(!this.marine and !this.mode eq 'MODIFY') then
      !this.multiPenetrationData[!i].updateCoaming()
    endif

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      modifySingleHoles()
-- Description: Modify the required fixing structure for single holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .modifySingleHoles()

  if( !this.holeClassKey.upcase() eq 'STANDARD' ) then
    -- standard hole
    -- get design parameters from gadgets
    !despars = ARRAY()
    do !loop to !this.maxdespars
      if (!this.despar$!<loop>.active ) then
        !despars.append(!this.despar$!<loop>.val)
      endif
    enddo
    -- input the form values into gPartData so it can be recalled for this hole type
    !this.holeTypeController.setLastParameterValue(!despars)
    !this.gPartData = !this.holeTypeController.selected()
  else
    !this.holeTypeController.setLastParameterValue(!this.gPartData)
    !this.gPartData = !this.holeTypeController.selected()
  endif

  -- modify the virtual fixings for each penetration
  do !i from 1 to !this.multiPenetrationData.size()

    -- Clean up the position data from clasher if multi-penetration and on the edge of an HPLATE by using penetrating marker position
    !this.multiPenetrationData[!i].usePenetratingMarkerPosition()
    -- set clearance value
--    !this.multiPenetrationData[!i].setClearance(!this.clearance.val)
    -- set offset
    !this.multiPenetrationData[!i].setOffset(!this.xOffset.val, !this.yOffset.val)
    -- set gap
    !this.multiPenetrationData[!i].setGap(!this.gap.val)
    -- set angle
    !this.multiPenetrationData[!i].setAngle(!this.oriang.val)
    -- set justification of coaming - BACK or FRONT
    if( !this.coaming ) then
      !this.multiPenetrationData[!i].setCoamingJustification(!this.side.selection())
    endif

    if (!this.catalogueHole) then
      -- set the virtual fixing Design Parameters
      !this.multiPenetrationData[!i].setHoleType(!this.gPartData)
      -- modify virtual hole fixing and sub-fixing
      !virtualFixing = !this.multiPenetrationData[!i].modifyVirtualFixing()
    endif

    -- update coaming if required
    if(!this.marine and !this.mode eq 'MODIFY') then
      !this.multiPenetrationData[!i].updateCoaming()
    endif

  enddo

  -- Set the parameters on the form to values gathered from the first penetrating item
  -- Note that the parameters may have been adjusted in .modifyVirtualFixing to allow for clearance
  if( defined( !this.multiPenetrationData[1] ) ) then

    -- get the despars for the penetrating sub-fixing and store as latest parameters for the selected hole type
    !this.holeTypeController.setLastParameterValue(!this.multiPenetrationData[1].getVirtualDesignParameters())
    -- update the current gPartData
    !this.gPartData = !this.holeTypeController.selected()
    !this.configureParameters()

  endif


endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      createMergedHoles()
-- Description: create the required fixing structure for single holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .createMergedHoles()

  -- clear any existing holes in the holeRef array (holes created but not applied)
  !this.holeRef.clear()

  -- group penetrations by penetrated object
  -- Only items with common penetrated can be merged
  !penetratedList      = ARRAY()
  !this.mergedHoles.clear()
  do !index to !this.multiPenetrationData.size()

    -- process each HMPENETRATIONDATA before adding to merged penetration object
    -- set clearance value

    if (!this.catalogueHole) then
      -- set the virtual fixing Design Parameters
      !this.multiPenetrationData[!index].setHoleType(!this.gPartData)
    endif

    -- add HMPENETRATIONDATA to list organised by penetrated object
    !penetratedObject  = !this.multiPenetrationData[!index].getPenetratedObject()
    !penetratedIndex   = !penetratedList.findFirst(!penetratedObject)
    if( !penetratedIndex.unset() ) then
      -- first one for this penetrated object - make it the master
      !penetratedList.append(!penetratedObject)
      !penetratedIndex = !penetratedList.maxIndex()
      !this.mergedHoles[!penetratedIndex] = object HMMERGEDPENETRATION()
      !this.mergedHoles[!penetratedIndex].setMasterPenetration(!this.multiPenetrationData[!index])
      -- we do not want cable way penetrations to be centred on all penetrating items
      !this.mergedHoles[!penetratedIndex].centredPosition(false)
    else
      -- subsequent penetrations are added as secondary penetrations
      !this.mergedHoles[!penetratedIndex].addPenetration(!this.multiPenetrationData[!index])
    endif

  enddo

  -- loop through merged hole groups and create new virtual hole for each merge penetration group
  do !index to !this.mergedHoles.size()

    -- set offset
    !this.mergedHoles[!index].setOffset(!this.xOffset.val, !this.yOffset.val)
    -- set gap
    !this.mergedHoles[!index].setGap(!this.gap.val)
    -- set angle
    !this.mergedHoles[!index].setAngle(!this.oriang.val)
    -- set justification of coaming - BACK or FRONT
    if( !this.coaming ) then
      !this.mergedHoles[!index].setCoamingJustification(!this.side.selection())
    endif
    -- create the framework and fixings for the penetration
    !virtualFramework = !this.mergedHoles[!index].createVirtualFixing(!this.fixingArea)
    -- update coaming if required
    if(!this.marine and !this.mode eq 'MODIFY') then
      !this.mergedHoles[!index].updateCoaming()
    endif
    -- record new holes created (FRMW level)
    !this.holeRef.append(!virtualFramework)
    -- get the despars for the penetrating sub-fixing and store as latest parameters for the selected hole type
    !this.holeTypeController.setLastParameterValue(!this.mergedHoles[!index].getVirtualDesignParameters())
    -- update the current gPartData
    !this.gPartData = !this.holeTypeController.selected()
    -- set parameters on the form
    !this.configureParameters()

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      modifyMergedHoles()
-- Description: Modify the required fixing structure for merged holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .modifyMergedHoles()

  if (!this.catalogueHole) then

    if( !this.holeTypeController.isSelected() ) then
    -- standard hole
      !despars = ARRAY()
      do !loop to !this.maxdespars
        if (!this.despar$!loop$n.active ) then
          !despars.append(!this.despar$!loop$n.val)
        endif
      enddo
      -- input the form values into gPartData so it can be recalled for this hole type
      !this.holeTypeController.setLastParameterValue(!despars)
      !this.gPartData = !this.holeTypeController.selected()
    else
      !this.holeTypeController.setLastParameterValue(!this.gPartData)
      !this.gPartData = !this.holeTypeController.selected()
    endif

  endif

  -- modify the virtual fixings for each merged penetration
  do !i from 1 to !this.mergedHoles.size()

    -- set offset
    !this.mergedHoles[!i].setOffset(!this.xOffset.val, !this.yOffset.val)
    -- set gap
    !this.mergedHoles[!i].setGap(!this.gap.val)
    -- set angle
    !this.mergedHoles[!i].setAngle(!this.oriang.val)
    -- set justification of coaming - BACK or FRONT
    if( !this.coaming ) then
      !this.mergedHoles[!i].setCoamingJustification(!this.side.selection())
    endif

    -- set the virtual fixing Design Parameters
    !this.mergedHoles[!i].setHoleType(!this.gPartData)

    -- modify virtual hole fixing and sub-fixings
    !virtualFixing = !this.mergedHoles[!i].modifyVirtualFixing()

    -- update coaming if required
    if(!this.marine and !this.mode eq 'MODIFY') then
      !this.mergedHoles[!i].updateCoaming()
    endif

    if (!this.catalogueHole) then
      -- get the despars for the penetrating sub-fixing and store as latest parameters for the selected hole type
      !this.holeTypeController.setLastParameterValue(!this.mergedHoles[!i].getVirtualDesignParameters())
      -- update the current gPartData
      !this.gPartData = !this.holeTypeController.selected()
      !this.configureParameters()
    endif

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      cleanUp()
-- Description: cleanUp any created items when the form is dismissed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .cleanUp()

  -- loop through the newly created holes and delete the frameworks they belong to
  if !this.mode.eq('CREATE') then
    do !i from 1 to !this.holeRef.size()
      !!ce = !this.holeRef[!i]
      handle ANY
        skip
      endhandle
      !type = !!ce.type
      DELETE $!<type>
      handle ANY
      endhandle
    enddo

    -- now loop though the penetration hole data and delete the RNODE elements
    do !i from 1 to !this.multiPenetrationData.size()
      !!ce = !this.multiPenetrationData[!i].getPenetratingMarker()
      handle ANY
        skip
      endhandle
      !type = !!ce.type
      DELETE $!<type>
      handle ANY
      endhandle
      !!ce = !this.multiPenetrationData[!i].getOffsetPenetratingMarker()
      handle ANY
        skip
      endhandle
      !type = !!ce.type
      DELETE $!<type>
      handle ANY
      endhandle
    enddo

  else
    -- undo all db operations
    !this.undopoint1.endundoable()
    undodb

  endif

  !this.holeRef.clear()

  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      changeHoleType()
-- Description: change the hole configuration between single and merged penetrations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .changeHoleType()

  -- reset the hierarchy
  !this.resetHierarchy()

  -- run the drawHole method to reset the new configuration
  !this.drawHole()

  !hmControl = object HMCONTROL()

  -- update the hole with the new fixing References
  !result = !hmControl.updateAssmbrRef(!this.managedHole, !this.mergedHoles[1].getVirtualHole(), 4 )
  if (!result.not()) then
    !!alert.error(!hmControl.error)
--    !this.cleanUp()
    return
  endif
  !result = !hmControl.updateAssmbrRef(!this.managedHole, !this.mergedHoles[1].masterPenetrationData.getVirtualPenetration(), 5 )
  if (!result.not()) then
    !!alert.error(!hmControl.error)
--    !this.cleanUp()
    return
  endif

  -- Delete any unknown references as the FRMW hierarchy has changed
  !hmControl.deleteInvalidRefs(!this.managedHole)

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      resetHierarchy()
-- Description: resets the penetration hierarchy so that you can switch between single and merged hole types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .resetHierarchy()

  -- delete the existing hierarchy
  -- loop through the newly created holes and delete the frameworks they belong to
  do !i from 1 to !this.holeRef.size()
    !!ce = !this.holeRef[!i]
    handle ANY
      skip
    endhandle
    !type = !!ce.type
    DELETE $!<type>
    handle ANY
    endhandle
  enddo

  -- reset the hole variables
  !this.holeRef.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      resetPosition()
-- Description: resets the offset of the penetration to its previous configuration
--              for modification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Virtual hole fixing element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .resetPosition(!owningFixing is DBREF)

--  !this.clearance.val = !owningFixing.excess
  !this.oriang.val    = 0
  -- find offset of first (master) penetration from penetration RNODE in frame of reference of the fixing
  !xOffDir            = !this.multiPenetrationData[1].xDir()
  !zOffDir            = !this.multiPenetrationData[1].zDir()
  !yOffDir            = !zOffDir.orthogonal(!xOffDir)
  !orientation        = object ORIENTATION('X IS $!<xOffDir> AND Y IS $!<yOffDir>')
  !plane              = object PLANE(!this.multiPenetrationData[1].getPenetratingMarker().position, !orientation)
  !offsetXY           = !plane.xyOffset(!owningFixing.position)
  !this.xOffset.val   = !offsetXY.x
  !this.yOffset.val   = !offsetXY.y
  !this.gap.val       = !this.multiPenetrationData[1].getPenetratingMarker().yOffset

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      ReadConfigurationFile
--
-- Description: Read system configuration file (if it exists) and store settings
--              (%PDMSDFLTS%\des-holemgt-config)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readConfigurationFile()

  if(not defined(!!holeManagementConfiguration)) then
    !tempConfig = object HMCONFIG()
    if(!tempConfig.loadConfigurationFile().not()) then
      !this.cleanUp()
      return error 1 'Error in configuration file. Please Contact your systems administrator'
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      orientateHole
--
-- Description: Pick the graphics to orientate the hole (only if penetrated item
--              is a knuckle plate or curved plate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .orientateHole()

   -- Define the graphics pick
  !packet = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick a face on the current penetrated object')
  !packet.priority    = 3
  !packet.action      = '!!hmCWayDefinition.pickReturn(!this.return[1])'
  !packet.remove      = true
  !packet.description = !this.edgDescription
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .queryPick()
--
-- Description: callback from graphical pick
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pickReturn(!return is EDGPICKDATA)

  -- derive position data from the pick
  !positionData = !return.positionData()

  !elementName  = !positionData.item
  handle any
    !elementName  = ''
  endhandle

  !sameObject = FALSE

  !hierarchy = !elementName.ownlst
  !hierarchy.append(!elementName)
  do !index indices !this.multiPenetrationData
    !found = !hierarchy.findFirst(!this.multiPenetrationData[!index].getPenetrated())
    if(!found.set()) then
      !sameObject = TRUE
      break
    endif
  enddo

  if (!sameObject.not()) then
    !!alert.error('Please Pick a facet on the penetrated item')
    return
  endif

  if(!positionData.plane.set()) then
    -- force set penetration plane
    do !index to !this.multiPenetrationData.size()
      !this.multiPenetrationData[!index].setPlane(!positionData.plane)
    enddo
    do !index to !this.mergedHoles.size()
      !this.mergedHoles[!index].setPlane(!positionData.plane)
    enddo
    !this.drawHole()
  else
    !!alert.error('Please Pick a facet')
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .editProfile()
--
-- Description: callback to edit the template profile
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .editProfile()

  -- find loop for this penetration
  if( !this.mergedHoles[1].editProfile().not() ) then
    !!alert.error('No free hole profile to edit')
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .setPenetrationData()
--
-- Description: Create penetrations based on selected data
-- NOTE THAT THE INPUT ARRAY MAY CONTAIN DIFFERENT TYPES OF PENETRATION
-- DATA OBJECT ALL SUPPORTING THE SAME INTERFACE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of PENETRATIONDATA objects
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPenetrationData(!penetrationData is ARRAY)

  !this.penetrationData = !penetrationData

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .processPenetrationData()
--
-- Description: Process data stored in the penetrationData array
-- NOTE THAT ALL PENETRATIONDATA OBJECTS MUST SUPPORT THE INTERFACE
-- USED HERE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .processPenetrationData()

  !originalItemList = ARRAY()
  !newItemList      = ARRAY()
  !addedItems       = ARRAY()

  if( !this.penetrationData.empty() ) then
    return
  endif

  !addNewPenetrating = (!this.shown() and !this.mode eq 'MODIFY')
  if (!addNewPenetrating) then
    if (!this.marine and !this.coamingArea.set() and!this.coamingFixing.set()) then
      !ce  = !!ce
      !!ce = !this.coamingFixing.owner
      handle any
      elsehandle none
        DELETE FRMW
      endhandle
      !!ce = !ce
      handle any
      endhandle
      !this.coamingFixing = object DBREF()
    endif
    if( !this.mergedHoles.empty() ) then
      -- if original was a single hole - first make a merged hole to add to
      !this.changeHoleType()
    endif
    !originalItemList = !this.mergedHoles[1].getItemList()
  else
    -- force to single penetrations
    !this.multiPenetrationData.clear()
    !this.mergedHoles.clear()
  endif

  -- loop through the list of penetrations and process each one to create virtual hole
  do !penetrationData values !this.penetrationData
    -- NOTE THAT ALL PENETRATIONDATA OBJECTS MUST SUPPORT THE INTERFACE USED HERE
    !result = !penetrationData.processData()
    if (!result.not()) then
      !this.cleanUp()
      return error 1 'Unable to select the chosen penetration marker'
    endif
    !data           = !penetrationData.getHoleData()
    !newPenetration = object HMPENETRATIONDATA(!data[2], !data[4], !data[1])
    !newPenetration.setOffsetPenetratingMarker(!data[5])
    !newPenetration.setVirtualHoleType(!penetrationData.getHoleType())
    !this.multiPenetrationData.append(!newPenetration)
    if (!addNewPenetrating) then
      -- add new penetrating items to existing penetration
      if( defined(!this.mergedHoles[1]) ) then
        !this.mergedHoles[1].addPenetration(!newPenetration)
      endif
    endif

  enddo

  if (!addNewPenetrating) then
    !this.drawHole()
    !newItemList = !this.mergedHoles[1].getItemList()
    !addedItems = !newItemList.difference(!originalItemList)
    !hmControl = object HMCONTROL()
    !return = !hmControl.addToHole(!this.managedHole, !addedItems)
    if (!return.not()) then
      !!alert.error(!!hmControl.error)
      return
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      editProperties
--
-- Description: Callback to show parameters input form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editProperties()

  !this.gPartData.comProp.editFormBlocking(true)
  !this.gPartData.comProp.editProperties()
  !this.gPartData.comProp.okCall('!!hmCWayDefinition.drawHole()')

endmethod
-- End of method definition
