--
-- File:            hmfitthole.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          R.Martin
--  Created:        02/11/2007
--
--
-- Description:
--   GUI for creation of "marker" holes in Hole Management system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actions(GADGET,STRING)           -                   Gadget actions for main form
--  addAssocItem(EDGPICKDATA)        -                   add an item to the association list to be created in hole management
--  aidLines()                       -                   draw aid lines for the current hole
--  apply()                          -
--  choose()                         -                   Choose matching table items from selection table
--  chooseEdit(DBREF,BOOLEAN)        -                   Choose matching table items from selection table
--  cleanUp()                        -
--  createFixing()                   -                   Create virtual penetration and FIXING
--  createFixingPenetration(POSITION,DIRECTION) DBREF               Create virtual penetration and FIXING
--  createHole()                     BOOLEAN
--  edgFirstPickPenetrated()         -                   Set EDG to pick penetrated items
--  edgPickAssociated()              -                   Set EDG to pick associated items
--  edgPickPenetrated()              -                   Set EDG to pick penetrated items
--  findCurvedPanelPosition(DBREF,POINTVECTOR) POSITION            Find penetration position on a curved panel given CPLATE
--  firstPickPenetrated(EDGPICKDATA) -                   EDG callback for penetrated items pick
--  firstShown()                     -                   Actions when form is shown for the first time.
--  hitOnSection(DBREF,POINTVECTOR)  ARRAY               Find planes for hit on SCTN or GENSEC
--  hmFittHole()                     -
--  initSelTableList()               -                   Initialise selection table option list
--  initSelTypeList()                -                   Initialise selection type option list
--  initTable()                      -                   Initialise the selected Type
--  initTable(BOOLEAN)               -                   Initialise the selected Type
--  initialise(DBREF,DBREF,DBREF,POSITION,DIRECTION,REAL,PLANE,STRING) -
--  initialiseForm()                 -                   Actions when form is shown
--  initialiseTables()               -                   Form initialisation
--  isPlanarPanel(DBREF)             BOOLEAN             Returns true if the target panel is planar
--  madeSelection(DBREF)             -                   After select event
--  moveFixing()                     -
--  netAfterSelect(ARRAY)            -                   After select event for .net control
--  offset(POSITION)                 -                   offset the element in the current direction through the supplied position
--  orientation(GADGET,STRING)       -
--  pickPenetrated(EDGPICKDATA)      -                   EDG callback for penetrated items pick
--  populateModifyBoxes()            -                   update the boxes that allow parameter modification
--  popupCallback(ARRAY)             -                   Pop-up callback
--  posAlign(STRING)                 -                   get picks to allow positional offsetting in !direction
--  readConfigurationFile()          -
--  remAssocItem()                   -                   remove the selected item from the association list
--  setPenetrated(DBREF,POSITION,PLANE) -                   Process data from penetrated items pick
--  setSide()                        -                   Set the side of the panel that the origin of the fitting is positioned at
--  setSpecification()               -                   Show properties form for selected item.
--  showPlot()                       -                   Show plot form for selected item.
--  showProps()                      -                   Show properties form for selected item.
--  tabs(GADGET,STRING)              -                   Select tab
--  tidy()                           -                   tidy up any aid lines that are not required anymore
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

--- form definition
setup form !!hmFittHole dialog dock right

  using namespace 'Aveva.Pdms.Presentation'

  -- define member for currently loaded appware
  member .origin            is POSITION
  member .direction         is DIRECTION
  member .penetrated        is DBREF
  member .debug             is BOOLEAN
  member .elements          is ARRAY
  member .mode              is STRING
  member .type              is STRING
  member .thickness         is REAL
  member .plane             is PLANE
  -- alternate plane on other side of plate
  member .altPlane          is PLANE
  member .extrusion         is DBREF
  member .undopoint1        is UNDOABLE
  -- initialStatus stores the status of a hole being modified before the modifications are applied
  -- this will be checked against the status of the hole when changes are being applied to make sure
  -- that no harmful changes to status have occurred when the user was modifying.
  member .initialstatus     is STRING

  -- dbref of panel
  member .panel is DBREF
  member .pickedItem is DBREF

  member .fixing is DBREF
  member .fixiType is STRING

  -- position of hole in panel
  member .holePosition is POSITION

  -- this member stores the reference to the created hole fixing so we can modify ones that have already been created during dynamic preview
  member .holeRef is DBREF

  -- secondary panels holds references to any additional panels that may have a hole passing through
  -- them as well as the primary panel that is stored in the .panel member
  member .secondaryPanels is ARRAY

  -- Associated holds references to any additional members chosen by the user that are associated
  -- with the hole (for example a piece of equipment)
  member .associated is ARRAY

  -- member to hold offset direction when using the align in x or y buttons
  member .dirXOrY is STRING

  -- member to hold the hole information in modify mode
  member .hmHole is HMHOLE

  -- Aid number information
  member .aidTag          is REAL
  member .aidAxes         is REAL

  -- Associated EDG packet
  member .associatedPacketDesc   is STRING
  member .pickPacketDescription  is STRING

  -- Penetration geometry
  member .penetratedPosition     is POSITION
  member .panelPosition          is POSITION
  member .plateThickness         is REAL
  member .penetratedDirection    is DIRECTION

  -- Penetrated EDG packet
  member .penetratedPacketDesc   is STRING

  -- Database item where the fixing will be created
  member .fixingLocation         is DBREF

  -- Grid control members
  member .netSelTabItems   is NETGRIDCONTROL

  -- Other members
  member .newItemName      is STRING
  member .selTables        is ARRAY
  member .selectedSelTab   is SELECTIONTABLE
  member .tableChooseData  is STCHOOSEDATA
  member .comProp          is COMPROP

  -- Questions and answers
  member .choices          is ARRAY
  member .selectedItem     is DBREF
  -- current specification
  member .currentTable     is STRING

  -- 3D view
  member .drawlist         is REAL

  -- define titles and initialisation call
  !this.formTitle = 'Hole Management - Fixing Definition'
  !this.iconTitle = 'Hole Management'

  hdist 0.5
  halign left
  vdist 0.2
  path down

  frame .holePanel tabset anchor top+left+right  at x0.5 y0.5 width 49 height 5
    -- Framing for type selection
    frame .holePanelTab panel anchor top+left+right  at x0.5 y0.5 'Fitting Definition' width 48
      frame .frmType panel anchor top+left+right at x1 y0 width 47 height 9
        -- Selection groups and tables
        option .opSelTables at x1 y0.5 tagwid 6 '' anchor left + right + top width 35
        option .opSelTypes tagwid 6 '' anchor left + right + top width 35
        toggle .tgDefault tagwid 6 'Default' at x7 ymax

        -- PML container to host .NET grid control
        container .conSelTabItems nobox PmlNetControl 'Table items' anchor top + left + right at xmin form width 50 height 10
      exit

      -- 3D view
      frame .frView3D panel anchor top+left width 35 height 9
          view .vwView3D volume
          exit
        exit

      button .bnProperties 'Properties...' anchor top + right 'Properties...' at xmax form-size    ymin.frView3D+1 width 11
      button .bnPlotfile   'PlotFile...'   anchor top + right 'Plotfile...'   at xmin.bnProperties ymax+0.5        width 11

    line .cpLine        anchor left + right + top   at x1      ymax.frView3D    horiz  width 50 heigh 0.2

    button .butPickPenetrated    anchor left + top         'Pick Penetrated Item'  at x1 ymax+0.2

      -- Framing for positioning and orientation options
    frame .frmOri 'Hole Position and Orientation' anchor top+left+right at x1 ymax+0.2 width 47
      text   .xOffset 'X Offset'  tagwidth 8 callback |!this.moveFixing()| width 9 is REAL format !!distanceFmt
      button .xalign 'Align in X' at xmax.xOffset+0.5 ymin.xOffset callback |!this.posAlign('X')|
      text   .yOffset 'Y Offset'  tagwidth 8 at xmin.xOffset callback |!this.moveFixing()| width 9 is REAL format !!distanceFmt
      button .yalign 'Align in Y' at xmax.yOffset+0.5 ymin.yOffset callback |!this.posAlign('Y')|
--      numeric .oriang  'Rotation:' tagwidth 8 at xmin.xOffset callback '!this.orientation(' range -180 180 step 5 ndp 0 width 3
      text .oriang  'Rotation:' tagwidth 8 at xmin.xOffset callback '!this.orientation(' width 9 is REAL
      button .holePick pixmap height 16 width 16 tooltip 'Pick Hole Position' callback '!this.edgPickPenetrated()' at xmax.xalign+2 ymin.xalign+0.5
    exit
      frame .oriFrame anchor top+left+right 'Adjust fitting orientation' width 47
        path down
        option .side     'Panel side' tagwid 13 callback '!this.setSide()' width 12

      exit

  exit

    frame .assocTab panel anchor top+left+right  at x1 y1 'Associated elements' width 48

      frame .assocListFrm anchor top+left+right at x1 y1 'Current association items' width 47
        list .assocList anchor top+left+right at x1 ymin COLUMNS width 43 height 10
      exit

      frame .assocModify anchor top+left+right at xmin.assocListFrm ymax.assocListFrm+0.5 'Modify associated items' width 47
        button .addAssoc 'Pick items' at x1 ymax callback |!this.edgPickAssociated()|
        button .remAssoc 'Remove selected item' at x1 ymax.addAssoc+0.5 callback |!this.remAssocItem()|
      exit
    line .lpLine        anchor left + right + top   at x1      ymax    horiz  width 50 heigh 0.5

    exit
  exit

-- Overall form buttons
  button .btnApply   'OK'     callback |!this.apply()|   anchor top + left  at x1 ymax width 8 OK
  button .btnDismiss 'Cancel' callback |!this.cleanUp()| anchor top + right at xmax form-size ymin.btnApply width 8 CANCEL

-- End of FORM definition
exit


------------------------------------------------------------------------
-- Method:      hmFittHole
--              Constructor - executed once on form load up
------------------------------------------------------------------------
define method .hmFittHole()

-- Control output of additional messages to command window for debugging
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

  !finder = object COLLECTION()
  !finder.addtype(|STRU|)
  !finder.filter(object EXPRESSION(|PURP eq 'HOLE' and dbwrite|))
  !insertPoint = !finder.results()
  if (!insertPoint.size().lt(1) ) then
    return error 1 |Unable to locate ZONE to work in (PURP=HOLE)|
  endif

  !this.fixingLocation = !insertPoint[1]

  !this.type = ''
  !this.fixiType = 'FREE'

  !this.callback         = |!this.initialiseForm()|
  !this.firstShownCall  = '!this.firstShown()'

  !this.cancelcall = |!this.cleanUp()|
  !this.holePick.addPixmap(!!pml.getPathName('xyz16.png'))
  !this.frmOri.active          = false
  !this.butPickPenetrated.active = false
  !this.side.active = false
  !this.assocTab.active        = false

  -- setup the open callback for the fittings tab page
  !this.holePanelTab.callback  = |!this.tabs(|
  !this.assocTab.callback  = |!this.tabs(|

  -- EDG
  !this.associatedPacketDesc        = 'Pick associated item'
  !this.pickPacketDescription       = 'Pick hole position'
  -- EDG
  !this.penetratedPacketDesc        = 'Pick Penetrated'
  !this.butPickPenetrated.callback  = '!this.edgFirstPickPenetrated()'


  -- define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Create grid control objects
  !this.netSelTabItems  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  !this.netSelTabItems.addEventHandler('OnPopup', !this, 'popupCallback')
  !this.netSelTabItems.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')
  -- Set grid properties
  !this.netSelTabItems.fixedHeaders(FALSE)
  --!this.netSelTabItems.fixedRows(false)
  !this.netSelTabItems.outlookGroupStyle(FALSE)
  !this.netSelTabItems.columnExcelFilter(FALSE)
  !this.netSelTabItems.headerSort(FALSE)
  !this.netSelTabItems.columnSummaries(FALSE)
  !this.netSelTabItems.singleRowSelection(true)
  !this.netSelTabItems.fixedRows(false)
  !this.netSelTabItems.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.conSelTabItems.control  = !this.netSelTabItems.handle()
  -- Callbacks
  !this.opSelTables.callback = |!this.actions(|
  !this.opSelTypes.callback = |!this.actions(|
  !this.bnProperties.callback = |!this.showProps()|
  !this.bnPlotfile.callback = |!this.showPlot()|

  -- 3D view / local drawlist
  !this.vwView3D.shaded = true
  !viewDir[1] = 0.57735
  !viewDir[2] = 0.57735
  !viewDir[3] = -0.57735
  !this.vwView3D.direction = !viewDir
  !this.drawlist = !!gphDrawlists.createDrawList()

  -- configure specification table gadgets
  !this.currentTable = ''
  !this.setSpecification()

  -- Load configuration
  !this.readConfigurationFile()

  !this.xOffset.val = 0
  !this.yOffset.val = 0

  !setSideDtext[1] = 'Front Face'
  !setSideDtext[2] = 'Back  Face'

  !setSideRtext[1] = 'front'
  !setSideRtext[2] = 'back'

  !this.side.dtext = !setSideDtext
  !this.side.rtext = !setSideRtext

  -- define pop-up for Design Template list
  !menu = !this.newMenu('hmFittholeMenu')
  !menu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.netSelTabItems, ||, |Save As|)' )
  !menu.add( 'callback', 'Print Preview...', '!this.netSelTabItems.printpreview()' )
  !this.conSelTabItems.popup = !menu

  -- Tooltips
  !this.bnProperties.setTooltip('Modify Properties')
  !this.bnPlotfile.setTooltip('View Plotfile')
  !this.addAssoc.setTooltip('Pick Elements')
  !this.remAssoc.setTooltip('Remove Selected Element')
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      popupCallback
--
-- Description: Pop-up callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupCallback(!passedArray is ARRAY)

  -- show menu
  !this.conSelTabItems.showPopup(!passedArray[0], !passedArray[1])

endmethod

------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Actions when form is shown for the first time.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.vwView3D)

  -- Attach view to local drawlist
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3D)
  !this.autoscroll = TRUE

  -- clear associated elements list
  !this.associated.clear()

endmethod
-- End of method definition for .firstShown()

------------------------------------------------------------------------
--
-- Method:      initialiseForm
--
-- Description: Actions when form is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseForm()

  -- Initialise common parts of the form
  !this.setSpecification()
  -- Make properties and plotfile buttons inactive
  !this.btnApply.active         = false
  !this.holePanelTab.visible = TRUE
  !this.assocTab.active = FALSE
  !this.penetrated       = object DBREF()
  !this.holeRef = object DBREF()
  !this.fixing = object DBREF()
  !this.hmHole = object HMHOLE()

  if (!this.netSelTabItems.getSelectedRows().size() eq 0 ) then
    !this.butPickPenetrated.active = FALSE
  else
    !this.butPickPenetrated.active = TRUE
  endif

  -- Deactivate 3D view
  !this.vwView3D.active = false

  -- Make properties and plotfile buttons inactive
  !this.bnProperties.active = false
  !this.bnPlotfile.active = false
  !this.btnApply.active = false
  !this.side.active = FALSE
  !this.xOffset.val    = 0
  !this.yOffset.val    = 0
  !this.xOffset.active = false
  !this.yOffset.active = false
  !this.xalign.active  = false
  !this.yalign.active  = false
  !this.oriang.val = 0
  !this.oriang.active = FALSE
  !this.mode = 'CREATE'
  !this.side.val = 1
  !this.associated.clear()
  !this.assocList.clear()

endmethod
------------------------------------------------------------------------
--
-- Method:      initialiseTables
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseTables()

  -- Set form title and list tags
  if( !this.mode eq 'MODIFY' ) then
    !initTitle = |Modify |
  else
    !initTitle = |Create |
  endif
  !this.formTitle       = !initTitle + !this.tableChooseData.formTitle
  !this.opSelTables.tag = !this.tableChooseData.tableTag
  !this.opSelTypes.tag  = !this.tableChooseData.typeTag

  -- Set selection tables
  !this.selTables = !this.tableChooseData.getSelTabs()

  -- Populate the table list
  !this.initSelTableList()

  -- Populate the type list
  !this.initSelTypeList()

  -- Initialise the selected type
  !this.initTable()

endmethod
-- End of method definition for .initialiseTables()

------------------------------------------------------------------------
-- Method:      initialise
--              Initialisation - executed each time the form is shown
------------------------------------------------------------------------
define method .initialise(!picked is DBREF, !panel is DBREF, !fixingElement is DBREF, !position is POSITION , !direction is DIRECTION , !thickness is REAL, !plane is PLANE, !mode is STRING)

  !fixing = !fixingElement

  -- set the creation mode
  if (!mode neq 'UPDATE') then
    !this.mode = !mode
  endif

  if (!mode eq 'MODIFY') then
    -- mark the database
    !this.undopoint1.add()
    !this.btnApply.active = TRUE
  elseif( !mode eq 'CREATE' ) then
    -- mark the database
    !this.undopoint1.add()
    !fixing = !this.createFixingPenetration(!position, !direction)
    if ( !fixing.unset() ) then
      !this.cleanUp()
      return
    endif
  endif

  -- clear the created items array on initialise
  !this.panel      = !panel
  !this.penetrated = !panel
  !this.pickedItem = !picked
  !this.holeRef    = !fixing
  !this.thickness  = !thickness
  !this.direction  = !direction
  !this.plane      = !plane
  !altDirection    = !this.direction.opposite().wrt(world)
  !yDirection      = !plane.orientation.yDir()
  !altOrientation  = object ORIENTATION( |Z IS | + !altDirection.string() + | AND Y IS | + !yDirection.string() )
  !altPosition     = !plane.pointVector().offset( !thickness * -1 ).position
  !this.altPlane   = object PLANE( !altPosition, !altOrientation )

  !this.origin = !position
  !this.holePosition = !this.origin
  !this.direction = !direction

  !this.oriang.val = 0
  !this.oriang.active = true
  if( !this.isPlanarPanel(!picked) or !picked.hardType eq 'SCTN' ) then
    !xyOffset = !plane.xyOffset(!position)
    !this.xOffset.val    = !xyOffset.x
    !this.yOffset.val    = !xyOffset.y
    !this.xOffset.active = true
    !this.yOffset.active = true
    !this.xalign.active  = true
    !this.yalign.active  = true
  else
    !this.xOffset.val    = 0
    !this.yOffset.val    = 0
    !this.xOffset.active = false
    !this.yOffset.active = false
    !this.xalign.active  = false
    !this.yalign.active  = false
  endif

  if (!this.mode eq 'MODIFY') then
    -- find the existing fixing spref and select it
    !this.chooseEdit( !fixing, true )
    -- set properties object
    !this.comProp.initialise(!fixing)

    -- Add any associated items to the member
    !assos = !fixing.assos
    !holeAssociation = object DBREF()
    do !association values !assos
      -- avoid MDS and other associations
      skip if( !association.type neq 'ASSOC' )
      skip if( !association.owner.purpose neq 'HOLE' )
      !holeAssociation = !association
      break
    enddo
    if (not badref(!holeAssociation)) then
      !hmHole = object HMHOLE(!holeAssociation)
      !this.hmHole = !hmHole
      -- Set up the existing associations
      !this.associated.clear()
      do !element values !hmHole.secondaryElements
        skip if (!element.lname eq '/HoleOwner' or !element.lname eq '/primaryElement' or !element.lname eq '/virtualHole')
        !this.associated.append(!element.amemrf)
      enddo
    endif

    -- We do not want the user to be able to pick penetrated
    !this.butPickPenetrated.active = FALSE

    -- set penetrated item
    !this.penetrated = !this.panel

    -- Set the fixing member
    !this.fixing = !fixing

    -- Find out which side of the panel the fixing is on
    !fittingDir = !fixing.ori.zdir().wrt(worl)
    !this.side.active = TRUE
    if (!fittingDir eq !direction) then
      !this.side.select('RTEXT','front')
    else
      !this.side.select('RTEXT','back')
    endif

  endif

  -- Aid number
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidAxes)
  !this.aidTag    = !!aidNumbers.add('fitting axes tag')
  !this.aidAxes   = !!aidNumbers.add('fitting axes arrows')

--  !this.oriang.modifiedEvents = TRUE
  !this.aidLines()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .createFixing()
--
-- Description: Create virtual penetration and FIXING
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .createFixing()

  !penetratedPosition  = !this.penetratedPosition
  !penetratedDirection = !this.penetratedDirection
  !plateThickness      = !this.plateThickness
  !pickedItem          = !this.pickedItem
  !plane               = !this.plane

  !this.initialise(!pickedItem, !pickedItem, object DBREF(), !penetratedPosition, !penetratedDirection, !plateThickness , !plane, 'CREATE')

endmethod

------------------------------------------------------------------------
--
-- Method:      .createFixingPenetration()
--
-- Description: Create virtual penetration and FIXING
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .createFixingPenetration(!penetratedPosition is POSITION, !penetratedDirection is DIRECTION) is DBREF

  !saveCE = !!ce

  -- if the current element is a fixing move up to the
  -- owner because we do not want a fixing owned by a fixing
  if( !!ce.hardType eq 'FIXING' ) then
    !!ce = !!ce.owner
  endif

  -- if the current element is a FRMW, make sure that it is not a
  -- hole storage area because management of the data becomes impossible
  -- if the real hole and the approved hole are in the same hierarchy
  if( !!ce.hardType eq 'FRMW' and !!ce.owner.purpose eq 'HOLE' ) then
    !this.side.active = FALSE
    !this.butPickPenetrated.active = TRUE
    !!alert.error('You cannot create a Fixing in the hole management virtual hole storage area')
    return object DBREF()
  endif

  NEW FIXING
  handle ANY
    !this.side.active = FALSE
    !this.butPickPenetrated.active = TRUE
    !!alert.error('You cannot create a Fixing at this level in the database')
    return object DBREF()
  endhandle
  !this.comProp.setProperties(!!ce)
  !this.comProp.unsetDesiElement()
  !fixing       = !!ce
  !this.fixing  = !!ce
  !!ce.position = !penetratedPosition
  -- If template based unlock the TMPL
  if (!!ce.mcount('TMPL') neq 0 ) then
    !template = TRUE
  else
    !template = FALSE
  endif
  if (!template) then
    UNLOCK ALL
    ORI Z is $!<penetratedDirection>
  else
    ORI P1 is $!<penetratedDirection>
  endif
  MOVE $!<penetratedDirection> THROUGH $!<this.panelPosition>
  !this.origin = !!ce.pos.wrt(worl)
  !penetratedPosition = !this.origin
  !!ce = !saveCE

  return !fixing

endmethod

------------------------------------------------------------------------
-- Method:      apply()
--              apply the previewed hole and create the associations
------------------------------------------------------------------------
define method .apply()

  !pickedItem = !this.pickedItem
  !this.panel = !pickedItem
  -- adjust fitting position
  !this.setSide()

  -- create or modify virtual hole
  !created = !this.createHole()
  if (!created.not()) then
    return
  endif

  -- create and populate the holeElemColl object and pass it to hole management
  -- minimum required elements are the panel and the hole fixing reference
  !holeElemColl = object HOLEELEMCOLL()

  if (!pickedItem.set()) then
    !holeElemColl.panel = !pickedItem
  else
    !!alert.message('No plate has been defined for the current hole')
    return
  endif

  if (!this.holeRef.set()) then
    !holeElemColl.holeFixing = !this.holeRef
  else
    !!alert.message('No hole has been defined for the current plate')
    return
  endif

  if (!this.fixing.set()) then
    !holeElemColl.fitting = !this.fixing
  else
    !!alert.message('No hole has been defined for the current plate')
    return
  endif

  if (!this.associated.set()) then
    !holeElemColl.associated = !this.associated
  endif

  if (!this.secondaryPanels.set()) then
    !holeElemColl.secondaryPanels = !this.secondaryPanels
  endif

  -- Create the associations
  !interface = object HMCONTROL()
  if (!this.mode eq 'CREATE') then
    !result = !interface.createFittHole(!holeElemColl, !this.origin, 'Free', '', 'FITT')
    if (!result.not()) then
      !!alert.error('Unable to create the Managed Hole Association')
    endif
    !thick  = !this.plateThickness
  else
    !result = !interface.modifyFittHole(!holeElemColl, !this.hmHole, !this.origin)
    if (!result.not()) then
      !!alert.error('Unable to modify the Association')
    endif
    !thick = !this.hmHole.plateThickness
  endif

  -- record thickness of penetrated item when hole is created or modified
  if( !result ) then
    !saveCE = !!ce
    !assos  = !this.fixing.assos[1]
    !!ce    = !assos
    LnID /HoleOwner
    realXpr $!thick
    !!ce    = !saveCE
  endif

  -- close undo for successful exit
  !this.undopoint1.endundoable()

  !this.tidy()

  -- leave user at the element in the model - not at the virtual fixing
  !!ce = !this.fixing

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      orientation()
--              apply the meta event data to the oriang gadget so that the createHole method will work when using the value up and down buttons
------------------------------------------------------------------------
define method .orientation(!dummyObject is GADGET, !dummySelect is STRING)

--  !this.oriang.val = !this.oriang.val
  !this.moveFixing()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      createHole()
--              create the required fixing structure for single holes
------------------------------------------------------------------------
define method .createHole() is BOOLEAN

  -- Get the profile for the virtual hole
  !profile = !!hmFindHoleProfile(!this.fixing)
  if (!profile.unset()) then
    !!alert.error('The chosen FITTING does not contain a profile to define the hole. Please contact your systems administrator. The FIXING will not be created')
    !this.cleanUp()
    return FALSE
  endif

  -- Find centre plane on penetrated object
  !pv                = !this.plane.pointVector()
  !pos               = !pv.offset( -1 * !this.thickness  / 2 ).position
  !midPlane          = !this.plane
  !midPlane.position = !pos

  !safeCE = !!ce
  !!ce = !this.fixingLocation

  -- Create elements
  if (!this.mode eq 'CREATE') then
    NEW FRMW
    NEW FIXING
    !!ce.orientation = !this.fixing.orientation
    !!ce.position    = !midPlane.near(!this.fixing.position)
    -- Execute any naming rules that have been defined
    CALL !!autonamece(false)
    handle any
    endhandle
    !this.holeRef = !!ce
    NEW TMPL
    NEW EXTR
    !!ce.heig = (!this.thickness * 2 )
    NEW LOOP
  else
    -- Find the loop of the virtual hole profile
    !find = object COLLECTION()
    !find.type('LOOP')
    !find.scope(!this.hmHole.virtualHole)
    !loop = !find.results()
    if (!loop.size() eq 0 ) then
      !this.cleanUp()
      !!ce = !safeCE
      return error 1 'Unable to modify the virtual hole'
    else
      !!ce = !loop[1]
      DELETE LOOP MEM
    endif
  endif
  !profile.dbwrite(!!ce)
  EXTR
  -- reset thickness
  !!ce.heig = (!this.thickness * 2 )

  -- move centre of extrusion to centre of penetrated
  MOVE  P2 OF VERTEX 1 OF LOOP 1 $!<this.direction> THROUGH $!<pos>

  -- make current element the new fixing so that the current element
  -- filter can be used on the hole management form can
  !!ce = !!ce.owner.owner

  return TRUE

endmethod


------------------------------------------------------------------------
-- Method:      cleanUp()
--              clean up any created items when the form is dismissed
------------------------------------------------------------------------
define method .cleanUp()
  -- loop through the newly created holes and delete the frameworks they belong to
  if (!this.mode eq 'CREATE') then
    if (!this.fixing.set()) then
      !!ce = !this.fixing
      handle ANY
      elsehandle NONE
        !type = hardType
        delete $!type
        handle ANY
        endhandle
      endhandle
    endif
  else
    -- undo all db operations
    !this.undopoint1.endundoable()
    undodb
  endif

  !this.tidy()

endmethod

------------------------------------------------------------------------
--
-- Method:      ReadConfigurationFile
--
-- Description: Read system configuration file (if it exists) and store settings
--              (%PDMSDFLTS%\des-holemgt-config)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readConfigurationFile()

  if(not defined(!!holeManagementConfiguration)) then
    !tempConfig = object HMCONFIG()
    if(!tempConfig.loadConfigurationFile().not()) then
      !this.cleanUp()
      return error 1 'Error in configuration file. Please Contact your systems administrator'
    endif
  endif

endmethod
-- End of method definition for .readConfigurationFile()

------------------------------------------------------------------------
--
-- Method:      populateModifyBoxes
--
-- Description: update the boxes that allow parameter modification
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateModifyBoxes()

  !desc = object STRING()
  do !i from 1 to (!!hmFittHole.coamingDesp.selection('rtext').split().size().real()) - 1
    !desc = !desc + !this.coamingDesp.selection('rtext').split()[!i]
    handle ANY
      !desc = !this.coamingDesp.selection('rtext').split()[!i]
    endhandle
  enddo
  !number = !this.fixiDesp.split().size()
  if (!this.coamingDesp.val leq !number) then
    !this.modVal.active = FALSE
  else
    !this.modVal.active = TRUE
  endif

  !this.modDesc.val = !desc
  !this.modVal.val = !this.coamingDesp.selection('rtext').split()[!!hmFittHole.coamingDesp.selection('rtext').split().size()]

endmethod
-- End of method definition for .populateModifyBoxes()

------------------------------------------------------------------------
--
-- Method:      tabs
--
-- Description:
--   Select tab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tabs(!gadget is GADGET, !action is STRING)

  if !gadget.eq(!this.holePanelTab) then

  elseif !gadget.eq(!this.assocTab) then
    -- No action on |HIDDEN|
    if (!action eq |SHOWN| and !this.assocTab.active ) then
      !this.populateAssocList()
    endif
  endif

endmethod

-- End of method definition for .tabs()

------------------------------------------------------------------------
--
-- Method:      addAssocItem
--
-- Description: add an item to the association list to be created in hole management
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addAssocItem(!data is EDGPICKDATA)

  -- primary owner specific for members of CPANEL elements
  if (!data.item.owner.hardType inset( 'CPROTR', 'CSURPX'  )) then
    !element = !data.item.hrdprx[1]
    handle any
      !!alert.error('Selected curved plate does not have a curved hull panel. Only curved hull panels can be penetrated')
      return
    endhandle
  else
    -- set the element picked to its primary owner
    !element = !data.item.prmown
  endif

    -- check that the item does not currently exist in our lists
  if (!element eq !this.holeRef or !element eq !this.panel or !element eq !this.hmHole.virtualHole ) then
    !!alert.message('Selected item is already associated with this hole')
    return
  else
    !number = !this.associated.findFirst(!element)
    if (!number.set()) then
      !this.associated.remove(!number)
    else
      -- if the item is a fixing make sure it doesn't already have a hole associations
      if (!element.hardType eq 'FIXING') then
        !associations = !element.assos
        do !assoc values !associations
          skip if(!assoc.type neq 'ASSOC')
          if (!assoc.owner.purp eq 'HOLE') then
            !!alert.message('The item picked already has HOLE associations')
            return
          endif
        enddo
      endif
      !this.associated.append(!element)
     endif
   endif

   !this.populateAssocList()

endmethod
-- End of method definition for .addAssocItem()

------------------------------------------------------------------------
--
-- Method:      remAssocItem
--
-- Description: remove the selected item from the association list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remAssocItem()

  !selection = !this.assocList.selection('dtext').upcase()

  if (!selection.matchWild('PRIMARY PANEL*') or !selection.matchWild('HOLE REFERENCE*') or !selection.matchWild('VIRTUAL HOLE*')) then
    !!alert.message('Cannot remove this item. It is required to create the hole')
    return
  endif

  !number = !this.associated.findFirst(!this.assocList.selection().dbref())
  if (!number.set()) then
    -- do not allow the removal of the virtual hole fixing
    !item = !this.associated[!number]
    if (!item.hardType eq 'FIXING') then
      !associations = !item.assos
      do !assoc values !associations
        if (!assoc eq !this.hmHole.element) then
          !!alert.message('Cannot remove this item. It is required to create the hole')
          return
        endif
      enddo
    endif
    !this.associated.remove(!number)
  endif

  !this.populateAssocList()

endmethod
-- End of method definition for .remAssocItem()

------------------------------------------------------------------------
--
-- Method:      populateAssocList
--
-- Description: populate the association list with selected items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

 define method .populateAssocList()

  -- collect all the associated members and pass them to hole management in a holeElemColl object
  -- first collect the panel reference
  !panel = !this.panel

  -- now get the hole fixing
  !holeFixing = !this.holeRef

  -- secondary panels are included in case the hole goes through more than 1 layer of a
  -- multi layer panel (in the case of room design)
  !secondaryPanels = !this.secondaryPanels

  -- now collect any other items that have been associated with the hole
  !associated = !this.associated

  !list = object ARRAY()
  !rtext = object ARRAY()

  !this.assocList.clear()

  !listValues = object ARRAY()
  if !panel.set() then
    !listValues.append('Primary Panel')
    !listValues.append(!panel.fullname)
    !rtext.append(!panel.name)
  else
    !listValues.append('Primary Panel')
    !listValues.append('unset')
    !rtext.append('')
  endif
  !list.append(!listValues)

  !listValues = object ARRAY()
  if !holeFixing.set() then
    !listValues.append('Hole Reference')
    !listValues.append(!holeFixing.fullname)
    !rtext.append(!holeFixing.name)
  else
    !listValues.append('Hole Reference')
    !listValues.append('unset')
    !rtext.append('')
  endif
  !list.append(!listValues)

  !listValues = object ARRAY()
  if !this.hmHole.virtualHole.set() then
    !listValues.append('Virtual Hole')
    !listValues.append(!this.hmHole.virtualHole.fullname)
    !rtext.append(!this.hmHole.virtualHole.name)
  else
    !listValues.append('Virtual Hole')
    !listValues.append('unset')
    !rtext.append('')
  endif
  !list.append(!listValues)

  do !i from 1 to !secondaryPanels.size()
    !listValues = object ARRAY()
    !listValues.append('Secondary Panel')
    !listValues.append(!secondaryPanels[!i].namn)
    !list.append(!listValues)
    !rtext.append(!secondaryPanels[!i].name)
  enddo

  do !i from 1 to !associated.size()
    !listValues = object ARRAY()
    !listValues.append(!associated[!i].type)
    !listValues.append(!associated[!i].fullname)
    !list.append(!listValues)
    !rtext.append(!associated[!i].name)
  enddo

  !this.assocList.setrows(!list)
  !this.assocList.rtext = !rtext

endmethod
-- End of method definition for .populateAssocList()

------------------------------------------------------------------------
--
-- Method:      aidLines
--
-- Description: draw aid lines for the current hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidLines()

  !pickedItem          = !this.pickedItem
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidAxes)

  !fixingPos = !this.holeRef.position.wrt( /* )
  if( !this.isPlanarPanel(!pickedItem).not() ) then
    if( !this.pickedItem.hardType neq 'SCTN' ) then
      !axes = object GPHAXES(!fixingPos, !this.holeRef.orientation.wrt( /* ))
      !axes.draw(!this.aidAxes, FALSE)
      return
    endif
  endif

  !panelPos  = !this.plane.position
  !midPoint  = !panelPos

  !fixingPlane = object PLANE(!fixingPos,!this.plane.orientation)
  !xoffDir = !this.plane.orientation.xDir().wrt( /* )
  !yoffDir = !this.plane.orientation.yDir().wrt( /* )

  !endPos = !panelPos.offset(!xoffDir, !this.xOffset.val)
  !line1 = object LINE(!panelPos,!endPos)
  !startPos = !endPos

  !endPos = !startPos.offset(!yoffDir, !this.yOffset.val)
  !line2 = object LINE(!startPos,!endPos)
  !aidSize = 850mm
  if (!this.xOffset.val lt 0 ) then
    !aidXOffset = -1 * !aidSize
  else
    !aidXOffset = !aidSize
  endif
  if (!this.yOffset.val lt 0 ) then
    !aidYOffset = -1 * !aidSize
  else
    !aidYOffset = !aidSize
  endif
  !fixEndPos = !fixingPlane.near(!endPos)
  !aid1EndPos = !fixEndPos.offset(!xoffDir, !aidXOffset)
  !aidLine1 = object LINE(!fixEndPos ,!aid1EndPos)

  !aid2EndPos = !fixEndPos.offset(!yoffDir, !aidYOffset)
  !aidLine2 = object LINE(!fixEndPos ,!aid2EndPos)

  !fixingZDir = !this.direction

  -- get offset values as formatted strings
  !xOffsetString = !this.xOffset.val.string(!!distanceFmt)
  !yOffsetString = !this.yOffset.val.string(!!distanceFmt)

  !boxSize       = 10mm
  !length        = !line1.length()
  -- for each line show an aid box
  do !f from 1 to 2
    !gBox            = object GMFBOX()
    !gBox.xLength    = !boxSize
    !gBox.yLength    = (!this.thickness * 0.2 )
    if (!this.xOffset.val eq 0 ) then
      !boxDir        = !xoffDir
    else
      !midPoint        = !line1.proportion(0.5)
      if (!f eq 1) then
        !midPoint      = !midPoint.offset(!fixingZDir.opposite(), !this.thickness )
      endif
      !boxDir          = !line1.direction()
      !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
      !gBox.zLength    = !length
      !gBox.position   = !midPoint
      !gBox.orientation = !orientation
      !graphBox         = object GPHBOX(!gBox)
      !graphBox.filled(true)
      !graphBox.draw(!this.aidTag, FALSE)
    endif
  enddo
  aid text num $!this.aidTag |$!<xOffsetString>| at $!<midPoint>
  !arrowHeight = 1000mm
  !prop = 0.15
  if (!gBox.yLength gt 150mm) then
    --make sure arrow is at least as wide as the aid-boxes
    !arrowHeight = !aidSize + !gBox.yLength
    !prop = !gBox.yLength / !arrowHeight
  endif
  aid arrow num $!<this.aidAxes> at $!fixEndPos dir $!boxDir hei $!arrowHeight prop $!prop

  !length          = !aidLine1.length()
  if( !length gt 0.1mm ) then
    !midPoint        = !aidLine1.proportion(0.5)
     !boxDir          = !aidLine1.direction()
    !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
    !gBox.zLength    = !length
    !gBox.position   = !midPoint
    !gBox.orientation = !orientation
    !graphBox         = object GPHBOX(!gBox)
    !graphBox.filled(true)
    !graphBox.draw(!this.aidTag, FALSE)
  endif


  do !f from 1 to 2
    if (!this.yOffset.val eq 0 ) then
      !boxDir = !yoffDir
    else
      !length          = !line2.length()

      !midPoint        = !line2.proportion(0.5)
      if (!f eq 1) then
        !midPoint = !midPoint.offset(!fixingZDir.opposite(), !this.thickness )
      endif
      !boxDir          = !line2.direction()
      !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
      !gBox.zLength    = !length
      !gBox.position   = !midPoint
      !gBox.orientation = !orientation
      !graphBox         = object GPHBOX(!gBox)
      !graphBox.filled(true)
      !graphBox.draw(!this.aidTag, FALSE)
    endif
  enddo
  aid text num $!<this.aidTag> |$!<yOffsetString>| at $!<midPoint>
  aid arrow num $!<this.aidAxes> at $!fixEndPos dir $!<boxDir> hei $!arrowHeight prop $!prop

  !length          = !aidLine2.length()
  if( !length gt 0.1mm ) then
    !midPoint        = !aidLine2.proportion(0.5)
    !boxDir          = !aidLine2.direction()
    !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
    !gBox.zLength    = !length
    !gBox.position   = !midPoint
    !gBox.orientation = !orientation
    !graphBox         = object GPHBOX(!gBox)
    !graphBox.filled(true)
    !graphBox.draw(!this.aidTag, FALSE)
  endif

  aid text num $!<this.aidTag> 'HOLE X' at $!<aid1EndPos>
  aid text num $!<this.aidTag> 'HOLE Y' at $!<aid2EndPos>


endmethod
-- End of method definition for .aidLines()

------------------------------------------------------------------------
--
-- Method:      tidy()
--
-- Description: tidy up any aid lines that are not required anymore
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidAxes)
  !!edgCntrl.remove('Pick associated item')
  !!edgCntrl.remove('Pick hole position')

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      posAlign
--
-- Description:
--   get picks to allow positional offsetting in !direction
--   uses the edg toolkit frame within !!appDesMain
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posAlign(!dirXOrY is STRING)

  !this.dirXOrY = !dirXOrY

  -- define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.definePosition('Align Hole to picked position')
  !packet.key            = 'alignPos'
  !packet.description    = 'Align Position'
  !packet.action         = '!!hmFittHole.offset(!this.return[1].position)'
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .posAlign(DIRECTION, DBREF)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description:  offset the element in the current direction through the supplied position
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!position is POSITION)

  !offDir = !this.dirXOrY
  -- first get the offset direction
  if !offDir.upcase().eq('X') then
    !direction = !this.plane.orientation.xDir().wrt( /* )
  else
    !direction = !this.plane.orientation.yDir().wrt( /* )
  endif

  -- now the hole position
  !holePos = !this.holeRef.position.wrt( /* )

  -- create a point vector from the fitting position in the direction of the offset direction
  !holePv = object POINTVECTOR(!holePos, !direction)

  -- offset the hole position through the selected point
  !newPoint = !holePv.through(!position)

  -- move the hole to the new point
  !this.holeRef.position = !newPoint.position

  -- update the offset gadgets
  !plane = !this.plane
  !xyOffset = !plane.xyOffset(!newPoint.position)
  !this.xOffset.val = !xyOffset.x
  !this.yOffset.val = !xyOffset.y

  !this.origin = !this.holeRef.position
  -- re-draw the aids
  !this.aidLines()

endmethod
-- End of method definition for .offset(DIRECTION, POSITION)

------------------------------------------------------------------------
--
-- Method:      .edgPickAssociated()
--
-- Description: Set EDG to pick associated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgPickAssociated()

  !!edgCntrl.remove('Pick Associated Item')
  -- define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick associated item')
  !packet.description    = !this.associatedPacketDesc
  !packet.priority       = 3
  !packet.action         = '!!hmFittHole.addAssocItem(!this.return[1])'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      isPlanarPanel()
--
-- Description: Returns true if the target panel is planar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isPlanarPanel(!element is DBREF) is BOOLEAN

  if( !element.hardType inset('CPLATE','CPANEL','SCTN','GENSEC') ) then
    return false
  endif
  if( !element.hardType eq 'HPLATE' ) then
    return !element.knuckl.not()
  endif
  return true

endmethod
-- End of method definition for .isPlanarPanel()

------------------------------------------------------------------------
--
-- Method:      .edgPickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgPickPenetrated()

  -- define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick a face on the penetrated object')
  !packet.description    = !this.pickPacketDescription
  !packet.priority       = 3
  !packet.action         = '!!hmFittHole.pickPenetrated(!this.return[1])'
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|PANE|,|HPLATE|,|CPLATE|,|SCTN|,|GENSEC|)'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

----------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetrated(!data is EDGPICKDATA)

  !positionData          = !data.positionData()

  -- get pick position and plane
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
    !plane    = object PLANE()
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
    !plane    = !positionData.plane
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
    !plane    = object PLANE()
  endif

  if (!data.item.hardType eq 'HPLATE') then
    if (!data.item.owner neq !this.pickedItem.owner) then
      !!alert.error('The picked item must be in the same hull panel')
      return
    endif
  elseif (!data.item.hardType eq 'CPLATE') then
    if (!data.item.hrdprx[1] neq !this.pickedItem.hrdprx[1]) then
      !!alert.error('The picked item must be in the same curved panel')
      return
    endif
  elseif (!data.item.hardType eq 'PANE') then
    if (!data.item neq !this.pickedItem) then
      !!alert.error('The picked item must be in the same panel')
      return
    endif
  elseif(!data.item.hardType inset('SCTN','GENSEC')) then
    if (!data.item neq !this.pickedItem) then
      !!alert.error('The picked item must be in the same section')
      return
    endif
    -- find plane at point of intersection of pick with object
    !planes   = !this.hitOnSection(!data.item, !data.pickLine)
    if( !planes.empty() ) then
      !plane  = object PLANE()
    else
      !plane  = !planes[1]
    endif
  endif

  !this.setPenetrated(!data.item, !position, !plane)
  !penetratedPosition  = !this.penetratedPosition
  !penetratedDirection = !this.penetratedDirection
  !plateThickness      = !this.plateThickness
  !pickedItem          = !this.pickedItem
  !plane               = !this.plane

  !safeCE = !!ce
  !!ce = !this.fixing
  !!ce.position = !penetratedPosition
  MOVE $!<penetratedDirection> THROUGH $!<this.panelPosition>
  if( !!ce.orientation.zdir().angle(!this.plane.orientation.zdir()) gt 0.5 ) then
    -- plane has changed so reset orientation
    !!ce.orientation = !this.plane.orientation
  endif
  !!ce = !safeCE

  !this.initialise(!pickedItem, !pickedItem, !this.fixing, !penetratedPosition, !penetratedDirection, !plateThickness , !plane, 'UPDATE')

endmethod

----------------------------------------------------------------------
--
-- Method:      .setPenetrated()
--
-- Description: Process data from penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .setPenetrated(!item is DBREF, !position is POSITION, !plane is PLANE)

  !this.pickedItem       = !item
  !this.penetrated       = object DBREF()

  -- set penetrating data for each type of penetrated object
  if( !item.hardType eq 'HPLATE' ) then
    !this.plateThickness = !item.thickness
    if (!item.knuckl) then
      -- knuckled panel - must have a picked face
      if(!plane.unset()) then
        !!alert.error('Please Pick a facet')
        return
      endif
      !this.penetratedDirection = !plane.direction()
      !this.panelPosition       = !plane.position
    else
      -- planar hull panel
      !this.panelPosition       = !item.position.wrt(worl)
      !plane                    = object PLANE(!this.panelPosition, !item.orientation.wrt(worl))
      !this.penetratedDirection = !item.ori.zdir().wrt(worl)
    endif
    -- add the HPANEL
    !this.penetrated          = !item.owner
  elseif( !item.hardType eq 'CPLATE' ) then
    -- curved plate
    if(!plane.unset()) then
      !!alert.error('Please Pick a facet')
      return
    endif
    !this.plateThickness      = !item.thickness
    !this.panelPosition       = !this.findCurvedPanelPosition(!item, !plane.pointVector())
    !this.penetratedDirection = !plane.direction()
    -- add the CPANEL
    !this.penetrated          = !item.hrdprx[1]
  elseif( !item.hardType inset('SCTN','GENSEC') ) then
    -- SCTN and GENSEC
    if(!plane.unset()) then
      !!alert.error('Please Pick a facet')
      return
    endif
    -- find other side of material to determine thickness
    !direction  = !plane.orientation.zdir().opposite()
    !pv         = object POINTVECTOR(!plane.position, !direction)
    -- find plane at point of intersection of pick with object
    !planes     = !this.hitOnSection(!item, !pv)
    if( defined(!planes[2]) ) then
      !this.plateThickness = !plane.position.distance(!planes[2].position)
    else
      !this.plateThickness = 0mm
    endif
    !this.penetratedDirection = !plane.direction()
    !this.panelPosition       = !plane.near(!item.poss)
    !plane.position           = !this.panelPosition
    !this.penetrated          = !item
  else
    -- outfitting panel
    !this.plateThickness      = !item.lohe
    -- put plane on top face, allowing for loop justification
    !vertex                   = object DBREF('PAVE 1 OF PLOOP 1 OF $!<item>')
    !this.panelPosition       = !vertex.ppos[3].wrt(worl)
    !plane                    = object PLANE(!this.panelPosition, !item.orientation.wrt(worl))
    !this.penetratedDirection = !item.ori.zdir().wrt(worl)
    !this.penetrated          = !item
  endif

  -- store the penetrated position and plane of penetrated item
  !this.penetratedPosition    = !position
  !this.plane                 = !plane
  !altDirection               = !this.penetratedDirection.opposite().wrt(world)
  !yDirection                 = !plane.orientation.yDir()
  !altOrientation             = object ORIENTATION( |Z IS | + !altDirection.string() + | AND Y IS | + !yDirection.string() )
  !altPosition                = !plane.pointVector().offset( !this.plateThickness * -1 ).position
  !this.altPlane              = object PLANE( !altPosition, !altOrientation )

endmethod

----------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .moveFixing()

  !pickedItem          = !this.pickedItem
  !plane               = !this.plane
    -- get the hole position for the single fixings which represents the hole
    !position = !plane.position
    -- get the orientation of the penetrated item so we can establish offset directions
    !xoffDir = !plane.orientation.xDir().wrt( /* )
    !yoffDir = !plane.orientation.yDir().wrt( /* )

    !position = !position.offset(!xoffDir, !this.xOffset.val)
    !position = !position.offset(!yoffDir, !this.yOffset.val)
    !direction = !plane.orientation.zdir()

  if( !this.isPlanarPanel(!pickedItem) or !pickedItem.hardType eq 'SCTN' ) then
    -- move the hole to the new point
    !xyOffset  = !plane.xyOffset(!position)
    !holePlane = !plane
    !holePlane.position  = !this.fixing.position
    !this.fixing.position = !holePlane.near(!position)
    !this.xOffset.val    = !xyOffset.x
    !this.yOffset.val    = !xyOffset.y
    !this.xOffset.active = true
    !this.yOffset.active = true
    !this.xalign.active  = true
    !this.yalign.active  = true
    !this.origin         = !this.fixing.position
    !this.holePosition   = !this.origin
  else
    -- curved or knuckled panel
    if( !direction.set() ) then
      !this.direction = !direction
    else
      !!alert.warning('Please Pick a planar facet')
      return
    endif
    !this.xOffset.val    = 0
    !this.yOffset.val    = 0
    !this.xOffset.active = false
    !this.yOffset.active = false
    !this.xalign.active  = false
    !this.yalign.active  = false
    -- move the hole to the new point
    !this.fixing.position = !position
  endif
    !saveCE = !!ce
    !!ce    = !this.fixing
    if (!this.mode eq 'CREATE') then
      ORI Z IS $!<this.direction>
    endif
    !angle = (!this.oriang.val * -1 )
    ROTATE ABOUT P0 BY $!<angle>
    !!ce = !saveCE
    !this.origin       = !this.fixing.position
    !this.holePosition = !this.origin
  -- re-draw the aids
  !this.setSide()
endmethod

------------------------------------------------------------------------
--
-- Method:      .edgFirstPickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgFirstPickPenetrated()

  -- define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick a face on the penetrated object')
  !packet.description    = !this.penetratedPacketDesc
  !packet.priority       = 3
  !packet.action         = '!!hmFittHole.firstPickPenetrated(!this.return[1])'
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|PANE|,|HPLATE|,|CPLATE|,|SCTN|,|GENSEC|)'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

----------------------------------------------------------------------
--
-- Method:      .firstPickPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .firstPickPenetrated(!data is EDGPICKDATA)

  !positionData          = !data.positionData()

  -- get pick position and plane
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
    !plane    = object PLANE()
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
    !plane    = !positionData.plane
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
    !plane    = object PLANE()
  endif

  if(!data.item.hardType inset('SCTN','GENSEC')) then
    -- find plane at point of intersection of pick with object
    !planes   = !this.hitOnSection(!data.item, !data.pickLine)
    if( !planes.empty() ) then
      !plane  = object PLANE()
    else
      !plane  = !planes[1]
    endif
  endif

  !this.setPenetrated(!data.item, !position, !plane)
  !active = !this.penetrated.set()
  !this.btnApply.active = !active
  !this.frmOri.active = !active
  !this.side.active = !active
  !this.assocTab.active = TRUE
  !this.butPickPenetrated.active = !active.not()
  if( !active ) then
    !this.createFixing()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      initSelTableList
--
-- Description: Initialise selection table option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTableList()

  if (!this.selTables.size() gt 0) then
    -- get current selection if any
    !currentSelection   = !this.opSelTables.selection()
    handle any
      !currentSelection = ''
    endhandle

    -- Populate table group option list
    !dtext = !this.selTables.evaluate(object BLOCK(|!this.selTables[!evalIndex].name|))
    !this.opSelTables.dtext = !dtext
    !selectionNumber        = !dtext.findFirst(!currentSelection)
    if( !selectionNumber.unset() ) then
      !selectionNumber      = 1
    endif
    !this.opSelTables.val   = !selectionNumber
    -- Set selected table
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!selectionNumber])
  else
    -- Set list for none
    !dtext[1] = 'None'
    !this.opSelTables.dtext = !dtext
    -- Unset selected table group
    !this.selectedSelTab = object SELECTIONTABLE()
  endif

endmethod
-- End of method definition for .initSelTableList()
------------------------------------------------------------------------
--
-- Method:      initSelTypeList
--
-- Description: Initialise selection type option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTypeList()

  if (!this.selTables.size() gt 0) then

    -- Get types for selected table
    !types = !this.selectedSelTab.getTypes()

    -- Populate type list
    if (!types.set()) then
      !this.opSelTypes.dtext = !types

      -- Select specified table type
      if (!this.tableChooseData.tableType.set()) then
        -- Get type index for specified type
        !typeIndex = REAL()
        do !ind indices !types
          if (!types[!ind].trim().upcase() eq !this.tableChooseData.tableType) then
            !typeIndex = !ind
            break
          endif
        enddo
        -- Select table type in option list and selection table object
        if (!typeIndex.set()) then
          !this.opSelTypes.val = !typeIndex
        else
          !!alert.warning(|Invalid table type specified in !this.tableChooseData global object. The first type in the table will be selected!|)
        endif
      endif

    else
      !dtext[1] = 'None'
      !this.opSelTypes.dtext = !dtext
    endif

  -- Set list for none
  else
    !dtext[1] = 'None'
    !this.opSelTypes.dtext = !dtext
  endif

endmethod
-- End of method definition for .initSelTypeList()

------------------------------------------------------------------------
--
-- Method:      initTable
--
-- Description: Initialise the selected Type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTable()

  -- initialise table without pre-selection
  !this.initTable(false)

endmethod
-- End of method definition for .initTable()

------------------------------------------------------------------------
--
-- Method:      initTable
--
-- Description: Initialise the selected Type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTable(!preSelect is BOOLEAN)

  -- Clear 3D view
  if (!this.drawlist.set()) then
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    !this.vwView3D.active = false
  endif

  -- Clear choose list
  !this.netSelTabItems.clearGrid()

  -- Show choose list
  if (!this.opSelTypes.selection() ne 'None')then
    !this.selectedSelTab.setType(!this.opSelTypes.val)
    !this.choose()
  endif

endmethod
-- End of method definition for .initTable()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choose()

  -- define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  !questions = !this.tableChooseData.questions
  !answers = !this.tableChooseData.answers
  if (!questions.unset() or !questions.empty()) then
    !choiceItems = !this.selectedSelTab.choose(!this.tableChooseData.desItem, |TEXT|, !this.tgDefault.val)
  else
    !choiceItems = !this.selectedSelTab.choose(!this.tableChooseData.desItem, !questions, !answers, |TEXT|, !this.tgDefault.val)
  endif

  -- Save choices
  !this.choices.clear()
  do !ind indices !choiceItems
    !this.choices.append(!choiceItems[!ind].removeFirst())
  enddo

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)
  -- Select first row in the list
  !this.netSelTabItems.selectRow(0)

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      chooseEdit
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design item DBREF
--    2   R      BOOLEAN     Pre-select item if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseEdit(!designItem is DBREF, !preSelect is BOOLEAN)

  -- set up pre-select if required
  if( badref(!designItem) ) then
    return error 1 |Invalid design element|
  endif

  -- set reference of TABITEM if pre-selection required
  if( !preSelect ) then
    !selectItem   = !designItem.spref
  else
    !selectItem   = object DBREF()
  endif

  !questions      = ARRAY()
  !answers        = ARRAY()

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  if( !preSelect ) then
    !this.tableChooseData.setData(!designItem,|FLOO|)
    !cTable       = !this.tableChooseData.getItemSelectionTable()
    if( !cTable.set() ) then
      !tableGroup   = !cTable.owner
      !tableName    = !tableGroup.name
      -- select table from table list
      !this.opSelTables.select('RTEXT',!tableName)
      handle any
        return
      endhandle
      !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
      !this.initSelTypeList()
    else
      !this.setSpecification(!this.panel.type)
    endif
  else
    !this.setSpecification(!this.panel.type)
  endif
  !choiceItems = !this.selectedSelTab.choose(!designItem, !questions, !answers, |TEXT|, true)

  -- Save choices and find a match with the selecte item
  !this.choices.clear()
  !matchItemIndex = 0
  do !index indices !choiceItems
    !choice = !choiceItems[!index].removeFirst()
    !this.choices.append(!choice)
    skip if( badref(!selectItem) or !matchItemIndex gt 0 )
    if( !selectItem.type eq 'GPART' ) then
      -- bug in old code left fittings pointing at the GPART instead of the TABITEM
      !gPart = !choice.prtref
      skip if( badref(!gPart) )
      if( !gPart eq !selectItem ) then
        !choice = !gPart
      endif
    endif
    if( !choice eq !selectItem ) then
      -- match found with selected item
      !matchItemIndex = !index
    endif
  enddo

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()
  !this.netSelTabItems.resetColumnProperties()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)

  -- Select matching item in the list
  if( !matchItemIndex gt 0 ) then
    !this.netSelTabItems.selectRow(!matchItemIndex)
  endif

  -- reset current table for modify
  !this.currentTable = ''

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      actions
--
-- Description: Gadget actions for main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actions(!object is GADGET, !action is STRING)

  -- Table group option list
  if (!object eq !this.opSelTables and !action eq |SELECT|) then
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
    handle any
      return
    endhandle
    !this.initSelTypeList()
    !this.initTable()

  -- Selection table option list
  elseif (!object eq !this.opSelTypes and !action eq |SELECT|) then
    !this.initTable()

  endif

endmethod
-- End of method definition for .actions()
------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!a is ARRAY)

  -- Item is selected
  if (!a[0].set()) then
    -- Selected table item
    !this.selectedItem = !this.choices[!a[0][1].real()]

    -- Show in 3D view
    !gPart = !this.selectedItem.prtref
    if (!gPart.badref().not()) then
      -- Get local drawlist
      !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
      !drawlist.removeAll()
      if (!gPart.tmpref.badref().not()) then
        !this.madeSelection(!gPart.tmpref)
      elseif (!gPart.catref.badref().not()) then
        !this.madeSelection(!gPart.catref)
      else
        !this.vwView3D.active = false
      endif
    endif

    -- Activate apply button
    !this.btnApply.active = not badref(!this.penetrated)
    !this.assocTab.active = TRUE

    -- Initialise properties for new hole type selection
    !this.comProp.initialise(!this.selectedItem)
    handle any
      !this.bnProperties.active = false
      !this.bnPlotfile.active   = false
    elsehandle none
      !this.bnProperties.active = true
      if (!this.comProp.checkPlot()) then
        !this.bnPlotfile.active = true
      else
        !this.bnPlotfile.active = false
      endif
      !this.comProp.autoCacheValues(true)
    endhandle

    if (!this.fixing.set()) then
      -- use SPREF of existing virtual fixing if set (modify mode)
      !this.comProp.setProperties(!this.fixing)
      !this.comProp.unsetDesiElement()
      !this.comProp.initialise(!this.fixing)
      handle any
        !this.bnProperties.active = false
        !this.bnPlotfile.active   = false
      elsehandle none
        !this.bnProperties.active = true
        if (!this.comProp.checkPlot()) then
          !this.bnPlotfile.active = true
        else
          !this.bnPlotfile.active = false
        endif
        !this.comProp.autoCacheValues(true)
      endhandle
    endif
  -- Item is not selected
  else
    -- Deactivate buttons
    !this.bnProperties.active  = false
    !this.bnPlotfile.active    = false
    !this.btnApply.active      = false
    -- Clear 3D view
    if (defined(!drawlist)) then
      !drawlist.removeAll()
    endif
    !this.vwView3D.active      = false

  endif

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      madeSelection
--
-- Description: After select event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .madeSelection(!selectedItem is DBREF)

  !this.frmOri.active          = TRUE
  if (!this.mode eq 'CREATE') then
    !this.butPickPenetrated.active = TRUE
  else
    !this.butPickPenetrated.active = FALSE
  endif

  -- show selection in 3D view
  !!gphViews.limits(!this.vwView3D, !selectedItem)
  !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
  !drawlist.add(!selectedItem)
  !this.vwView3D.active = true

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: Show plot form for selected item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPlot()

  !this.comProp.displayPlot()

endmethod
-- End of method definition for .showProps()
------------------------------------------------------------------------
--
-- Method:      showProps
--
-- Description: Show properties form for selected item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showProps()

  !this.comProp.editProperties()

endmethod
-- End of method definition for .showProps()

------------------------------------------------------------------------
--
-- Method:      setSide
--
-- Description: Set the side of the panel that the origin of the fitting is positioned at
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSide()

  if (!this.fixing.set()) then
    !yDir = !this.fixing.orientation.yDir()
    !this.fixing.pos = !this.origin
    if (!this.side.selection() eq 'front') then
      !direction = !this.direction
      !this.fixing.pos   = !this.plane.near(!this.fixing.pos)
    else
      !direction = !this.direction.opposite()
      !this.fixing.pos   = !this.altPlane.near(!this.fixing.pos)
    endif

    -- set orientation of the fixing to the selected side of the panel
    !this.fixing.orientation   = object ORIENTATION('Z IS ' + !direction.string() + ' and Y is ' + !yDir.string())
    handle any
      -- if there is an error, such as y direction parallel to z direction, use fixing z direction instead of penetrated direction
      !zdir = !this.fixing.orientation.zdir().opposite()
      !this.fixing.orientation = object ORIENTATION('Z IS ' + !zdir.string() + ' and Y is ' + !yDir.string())
    endhandle
    !this.aidLines()
  endif

endmethod
-- End of method definition for .setSide()

------------------------------------------------------------------------
--
-- Method:      .findCurvedPanelPosition()
--
-- Description: Find penetration position on a curved panel given CPLATE
--              clash target and hit vector(clash position, hole plane normal)
--              Position adjusted to be in the middle of CPLATE material
--
-- Method Type: Function/Procedure
--
-- Return Position of penetration
--
------------------------------------------------------------------------
define method .findCurvedPanelPosition(!clashTarget is DBREF, !hitVector is POINTVECTOR) is POSITION

  !temp          = ARRAY()
  !clashPosition = !hitVector.position
  !temp[1]       = !clashPosition
  ---------------------------------------------------------------------
  -- conversion to string and back to direction should not be necessary
  -- but SURNOR sometimes gives the wrong answer unless this is done
  -- DO NOT CHANGE
  !temp[2]  = !hitVector.direction.wrt(world).string().direction()
  ---------------------------------------------------------------------
  !panel = !clashTarget.hrdprx[1]
  -- fall back to clash position if surface hit not found
  !useClashPosition = false
  !panelHit   = !panel.attribute('SURPNT', !temp).wrt(world)
  handle (2,754)
    !temp[2]  = !temp[2].opposite()
    !panelHit = !panel.attribute('SURPNT', !temp).wrt(world)
    handle any
      !useClashPosition = true
    endhandle
  elsehandle any
    !useClashPosition   = true
  endhandle

  if( !useClashPosition ) then
    !holePosition = !clashPosition
  else
    -- move back half plate thickness from mould plane
    !temp[1]         = !panelHit
    !panelNormal     = !panel.attribute('SURNOR',!temp).wrt(world)
    handle any
      !holePosition  = !panelHit
    elsehandle none
      !offsetNormal  = object POINTVECTOR(!panelHit, !panelNormal)
      !middle        = ( !clashTarget.dist[1] + !clashTarget.dist[2] ) / 2
      handle any
        !middle      = !clashTarget.thickn * -0.5
      endhandle
      !offsetNormal  = !offsetNormal.offset(!middle)
      !holePosition  = !offsetNormal.plane().intersection(!hitVector )
    endhandle
  endif

  return !holePosition

endmethod

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Set specification for the current application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpecification()

  !currentApplication = !!appCntrl.currentApp()
  if( !currentApplication eq 'CIVIL' ) then
    !this.setSpecification('FLOOR')
  else
    !this.setSpecification('PANEL')
  endif

endmethod
-- End of method definition for .setSpecification()

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Show properties form for selected item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpecification(!type IS STRING)

  -- selection table purpose
  if( !type eq 'FLOOR' ) then
    !table = 'FLOOR'
  else
    !table = 'FIXING'
  endif

  -- do not reset the table if discipline has not changed
  if( !this.currentTable eq !table ) then
    return
  endif

  -- configure specification table gadgets
  !this.tableChooseData.clearData()
  !this.tableChooseData.setTitle(|Hole Fittings|)

  -- Element type to create
  !this.tableChooseData.setData(|FIXING|,!table)
  !this.initialiseTables()

endmethod
-- End of method definition for .setSpecification()

------------------------------------------------------------------------
--
-- Method:      hitOnSection
--
-- Description: Find planes for hit on SCTN or GENSEC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       SCTN or GENSEC
--    2   R      POINTVECTOR EDG pick vector
-- Return:
--   [Data Type] [Description]
--    ARRAY       two planes at hit of SCTN or GENSEC and opposite side
------------------------------------------------------------------------
define method .hitOnSection(!element is DBREF, !pickVector is POINTVECTOR) is ARRAY

  !planes = ARRAY()
  !localPickVector = !pickVector
  !position = !localPickVector.position.wrt(world)
  !localPickVector.position = !position
  !hits = !localPickVector.intersections(!element, true)
  if( !hits.empty().not() ) then
    !planes[1]  = !hits[1].plane()
    -- find other side
    !direction  = !hits[1].direction.opposite()
    !pv         = object POINTVECTOR(!hits[1].position, !direction)
    !normalHits = !pv.intersections(!element, true)
    if(defined(!normalHits[2])) then
      !planes[2]  = !normalHits[2].plane()
    endif
  endif

  return !planes

endmethod
-- End of method definition for .hitOnSection()
