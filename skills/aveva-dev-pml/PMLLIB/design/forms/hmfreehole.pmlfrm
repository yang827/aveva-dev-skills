--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            hmfreehole.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          R.Martin
--  Created:        02/11/2007
--
--
-- Description:
--   GUI for creation of "marker" holes in Hole Management system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAssocItem(EDGPICKDATA)        -                   add an item to the association list to be created in hole management
--  aidLines()                       -                   draw aid lines for the current hole
--  apply()                          -
--  applyCoaming()                   -
--  autoSetupHole()                  -                   if we are inserting a fitting and the fitting references geometry with a the name /HOLE then this is used
--  cleanUp()                        -
--  createHole()                     -
--  edgPickAssociated()              -                   Set EDG to pick associated items
--  edgPickPenetrated()              -                   Set EDG to pick penetrated items
--  hmFreeHole()                     -
--  initialise(DBREF,DBREF,DBREF,POSITION,DIRECTION,REAL,PLANE,STRING) -
--  isPlanarPanel()                  BOOLEAN             Returns true if the target panel is planar
--  modifyDespars()                  -                   sets the visibility of the modify frame if modify toggle is set
--  offset(POSITION)                 -                   offset the element in the current direction through the supplied position
--  orientation(GADGET,STRING)       -
--  pickPenetrated(EDGPICKDATA)      -                   EDG callback for penetrated items pick
--  populateModifyBoxes()            -                   update the boxes that allow parameter modification
--  posAlign(STRING)                 -                   get picks to allow positional offsetting in !direction
--  readConfigurationFile()          -
--  readDespars(REAL)                -                   read the despars of a current fixing that has a fitting spref
--  remAssocItem()                   -                   remove the selected item from the association list
--  setClass()                       -                   sets up the class of the fitting to be used i.e. defined hatches
--  setSide()                        -                   Set the side of the panel that the origin of the fitting is positioned at
--  tabs(GADGET,STRING)              -                   Select tab
--  tidy()                           -                   tidy up any aid lines that are not required anymore
--  typeSelected()                   -
--  updateDespars()                  -                   update the fixing despars following a change in the modVal box
--
------------------------------------------------------------------------

--- form definition
setup form !!hmFreeHole dialog dock right

  using namespace 'Aveva.Pdms.Presentation'

  -- Define member for currently loaded appware
  member .origin            is POSITION
  member .direction         is DIRECTION
  member .penetrated        is DBREF
  member .gPartData         is ARRAY
  member .coamingGpartData  is ARRAY
  member .debug             is BOOLEAN
  member .maxdespars        is REAL
  member .fixiType          is STRING
  member .fixiDesp          is STRING
  member .elements          is ARRAY
  member .mode              is STRING
  member .type              is STRING
  member .coamingArea       is DBREF
  member .thickness         is REAL
  member .plane             is PLANE
  member .extrusion         is DBREF
  member .undopoint1        is UNDOABLE
  member .fixingOri         is DIRECTION
  member .coamingOri        is DIRECTION
  member .fixingOriPpoint   is ARRAY
  member .coamingOriPpoint  is ARRAY
  -- initialStatus stores the status of a hole being modified before the modifications are applied
  -- this will be checked against the status of the hole when changes are being applied to make sure
  -- that no harmful changes to status have occurred when the user was modifying.
  member .initialstatus     is STRING

  -- managedHole stores the managed hole that is being modified
  member .managedHole       is HMHOLE

  -- dbref of panel
  member .panel is DBREF
  member .pickedItem is DBREF

  -- position of hole in panel
  member .holePosition is POSITION

  -- dbref of fixing that represents the coaming geometry
  member .coamingFixing is DBREF

  -- this member stores the reference to the created hole fixing so we can modify ones that have already been created during dynamic preview
  member .holeRef is DBREF

  -- secondary panels holds references to any additional panels that may have a hole passing through
  -- them as well as the primary panel that is stored in the .panel member
  member .secondaryPanels is ARRAY

  -- Associated holds references to any additional members chosen by the user that are associated
  -- with the hole (for example a piece of equipment)
  member .associated is ARRAY

  -- holds the design parameters of the catalogue hole types
  member .despars is ARRAY

  -- member to hold offset direction when using the align in x or y buttons
  member .dirXorY is STRING

  -- member to hold the hole information in modify mode
  member .hmHole is HMHOLE

  -- Aid number information
  member .aidTag          is REAL
  member .aidAxes         is REAL

  -- Associated EDG packet
  member .associatedPacketDesc   is STRING
  member .pickPacketDescription  is STRING

  hdist 0.5
  halign left
  vdist 0.3
  path down

  --Unfortunately there is a requirement in PDMS that the coaming tab should not be displayed
  --This means that there are going to be a lot of lines that will have to test for the existence
  --of the coaming tab before continuing.
  !mm = object AVEVAMODULEMANAGER()
  !marine = (!mm.currentProductName().upcase().eq('HULL & OUTFITTING'))

  --frame .holePanel tabset anchor all  at x0 ymax.frmPredefined + 0.5
  frame .holePanel tabset anchor top+left+right  at x0 y1 width 49 height 5
    -- Framing for type selection
    frame .holePanelTab panel anchor top+left+right  at x1 y1 'Hole Definition' width 48
      frame .frmType 'hole type' anchor top+left+right at x1 ymin + 0.5 width 47 height 9
        list .holeType anchor top+left+right callback |!this.typeSelected()|   width 43
      exit

      -- Framing for design parameter input
      frame .frmDespar 'Hole shape parameters' anchor top+left+right at x1 ymax.frmType + 0.5 width 47
        text .despar1 '1: ' tagwidth 15 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        text .despar2 '2: ' tagwidth 15 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        text .despar3 '3: ' tagwidth 15 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        text .despar4 '4: ' tagwidth 15 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        text .despar5 '5: ' tagwidth 15 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        text .despar6 '6: ' tagwidth 15 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
      exit

      -- Framing for positioning and orientation options
      frame .frmOri 'Hole Position and Orientation' anchor top+left+right at x1 ymax + 0.5 width 47
        text .xoffset 'X Offset ' tagwidth 8 callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        button .xalign 'Align in X' at xmax.xoffset+0.5 ymin.xoffset callback |!this.posAlign('X')|
        text .yoffset 'Y Offset ' tagwidth 8 at xmin.xoffset callback |!this.createHole()| width 9 is REAL format !!distanceFmt
        button .yalign 'Align in Y' at xmax.yoffset+0.5 ymin.yoffset callback |!this.posAlign('Y')|
        numeric .oriang  '   Rotation: ' tagwidth 8 at xmin.xoffset callback '!this.orientation(' range -180 180 step 5 ndp 0 width 3
        button .holePick pixmap height 16 width 16 tooltip 'Pick Hole Position' callback '!this.edgPickPenetrated()' at xmax.xalign+2 ymin.xalign+0.5
      exit
    exit
    if (!marine) then
      frame .coamingPanelTab panel anchor top+left+right  at x1 y1 'Coaming' width 48
        frame .coamingSetup anchor top+left+right 'Coaming Selection' width 47
          option .class   'Coaming Class:'anchor top+left+right tagwid 10 callback |!this.setClass()| at x1 y1 width 31
          list .coamingDesp 'Coaming parameters: ' anchor top+left+right callback |!this.populateModifyBoxes()| at x1 ymax.class+0.5 COLUMNS width 43 height 7

          toggle .modifyOn 'Modify Values' anchor top+left callback |!this.modifyDespars()| at x1 ymax.coamingDesp+0.2
        exit

        frame .modify anchor top+left+right at ymax.coamingSetup+0.5 'modify selection' width 47
          text .modDesc 'Description' anchor top+left+right tagwidth 10 at x1 ymax+0.2 width 34 is STRING
          text .modVal 'Value' anchor top+left+right callback |!this.updateDespars()| tagwidth 10 at x1 ymax+0.2 width 34 is STRING
        exit

        frame .oriFrame anchor top+left+right 'Adjust coaming orientation' width 47
          path down
          option .side     'Panel side         ' tagwid 13 callback '!this.setSide()' width 12

        exit
      exit
    endif
    frame .assocTab panel anchor top+left+right  at x1 y1 'Associated elements' width 48

      frame .assocListFrm anchor top+left+right at y1 'Current association items' width 47
        list .assocList anchor top+left+right at x1 ymin.assocListFrm+1 COLUMNS width 43 height 10
      exit

      frame .assocModify anchor top+left+right at ymax.assocListFrm+0.5 'Modify associated items' width 47
        button .addAssoc 'Pick items' at x1 callback |!this.edgPickAssociated()|
        button .remAssoc 'Remove selected item' at x1 ymax.addAssoc+0.5 callback |!this.remAssocItem()|
      exit

    exit
  exit

-- Overall form buttons
  button .btnApply   'OK'     callback |!this.apply()| anchor top + left at x1 width 8 OK
  button .btnDismiss 'Cancel' callback |!this.cleanUp()| anchor top + right at xmax form-size ymin.btnApply width 8 CANCEL

-- End of FORM definition
exit


------------------------------------------------------------------------
-- Method:      hmFreeHole
--              Constructor - executed once on form load up
------------------------------------------------------------------------
define method .hmFreeHole()

-- Control output of additional messages to command window for debugging
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif
  !coaming = FALSE

  -- Define titles and initialisation call
  !this.formtitle = 'Hole Management - Free Hole Definition'
  !this.icontitle = 'Hole Management'

-- Maximum number of despar fields - matches no of text gadgets in frmDespar (above)
  !this.maxdespars = 6

-- Locate all SPCO in HOLE specs (uses PML1 as PML2 cant collect CATA data from DESI dbs)
-- Locate all GPARTS with PURP hole and type FIXING (uses PML1 as PML2 cant collect CATA data from DESI dbs)
  !gParts = ARRAY()
  var !gPartList collect all GPART with PURP  eq 'HOLE' and PRITYPE eq 'FIXING'
  do !elem values !gPartList
    !gParts.append(!elem.dbref() )
  enddo
  if (!this.debug) then
     !sum = !gParts.size()
     write 'Initialising HOLE TYPES - found $!sum GPARTs'
  endif

  !this.cancelcall = |!this.cleanUp()|
  !this.holePick.addPixmap(!!pml.getPathName('xyz16.png'))

  -- setup the open callback for the fittings tab page
  !this.holePanelTab.callback  = |!this.tabs(|
  if (defined(!this.coamingPanelTab)) then
    !this.coamingPanelTab.callback  = |!this.tabs(|
  endif
  !this.assocTab.callback  = |!this.tabs(|

  !this.holeType.clear()
  !this.gPartData = ARRAY()

  if (defined(!this.coamingPanelTab)) then
    !setSideDtext[1] = 'Front Face'
    !setSideDtext[2] = 'Back  Face'

    !setSideRtext[1] = 'front'
    !setSideRtext[2] = 'back'

    !this.side.dtext = !setSideDtext
    !this.side.rtext = !setSideRtext
  endif

  -- EDG
  !this.associatedPacketDesc        = 'Pick associated item'
  !this.pickPacketDescription       = 'Pick hole position'

  !ppointTypes = ARRAY()
  !ppointTypes.append('PTCA')
  !ppointTypes.append('PTAX')
  !ppointTypes.append('PTMI')
  !ppointTypes.append('PTPOS')
  !find = object COLLECTION()
  !find.types(!ppointTypes)
  !find.filter(object EXPRESSION('PURP eq |HMOR|'))

-- Separate index variable needed to allow skipping of invalid entries
  !idx = 0
  do !loop index !gParts

-- Validate catalogue data found
    if ( !gParts[!loop].catref.unset() OR BADREF(!gParts[!loop].catref.dtref) ) then
      if (!this.debug) then
        !refText = !gParts[!loop].detref.rtext
        write 'Skipping $!refText - no DTREF'
      endif
      skip
    endif

    !idx = !idx + 1
-- Store information for later use
    !this.gPartData[!idx][1] = !gParts[!loop]
    !this.gPartData[!idx][2] = !gParts[!loop].detref.rtext

-- Find out the fixing ppoint ori number
   !pointSet = !gParts[!loop].catref.ptre

   !find.scope(!pointSet)
   if (!find.results().size() eq 0 ) then
     -- try P9
     !find.filter(object EXPRESSION('NUMBER eq 9 '))
     if (!find.results().size() eq 0 ) then
       return error 1 'Unable to use Hole management as the catalogue needs updating. Please contact the Systems Administrator'
     endif
   endif
   !pNumber = !find.results()[1].number.string()
   !this.fixingOriPpoint.append('P' & !pNumber)

-- Process number of parameters from DTSET in catalogue
    do !numb to !gParts[!loop].catref.dtref.mCount
      !key = !gParts[!loop].catref.dtref.member[!numb].dkey
      !this.gPartData[!idx][3][!numb] = !gParts[!loop].prTitle.attribute(!key)
      !this.gPartData[!idx][4][!numb] = !gParts[!loop].rProp.attribute(!key)
      !this.gPartData[!idx][5][!numb] = !key
    enddo

-- Update dropdown list for hole types
    if (!this.debug) then
      !data = !gParts[!loop].detref.rtext
      write 'Initialising HOLE TYPES - adding $!data'
    endif

    !this.holeType.add(!gParts[!loop].detref.rtext, !gParts[!loop].string())
  enddo
  !this.holeType.add('User Defined','TMPL')

-- Locate all SPCO in HOLE specs (uses PML1 as PML2 cant collect CATA data from DESI dbs)
-- Locate all GPARTS with PURP hole and type COAMING (uses PML1 as PML2 cant collect CATA data from DESI dbs)
  !coamingGparts = ARRAY()
  var !gPartList collect all GPART with PURP  eq 'HOLE' and PRITYPE eq 'COAMING'
  do !elem values !gPartList
    !coamingGparts.append(!elem.dbref() )
  enddo


  !find.filter(object EXPRESSION('PURP eq |HMOR|'))
  !this.coamingGpartData = ARRAY()

-- Separate index variable needed to allow skipping of invalid entries
  !idx = 0
  do !loop index !coamingGparts

-- Validate catalogue data found
    if ( !coamingGparts[!loop].catref.unset() OR BADREF(!coamingGparts[!loop].catref.dtref) ) then
      skip
    endif

    !idx = !idx + 1
-- Store information for later use
    !this.coamingGpartData[!idx][1] = !coamingGparts[!loop]
    !this.coamingGpartData[!idx][2] = !coamingGparts[!loop].secType

-- Find out the fixing ppoint ori number
   !pointSet = !coamingGparts[!loop].catref.ptre

   !find.scope(!pointSet)
   !coaming = TRUE
   if (!find.results().size() eq 0 ) then
     -- try P9
     !find.filter(object EXPRESSION('NUMBER eq 9 '))
     if (!find.results().size() eq 0 ) then
       !coaming = FALSE
     endif
   endif
   if (!coaming) then
     !pNumber = !find.results()[1].number.string()
     !this.coamingOriPpoint.append('P' & !pNumber)
   else
     -- overwrite the secType so that coaming can't be applied
     !this.coamingGpartData[!idx][2] = 'No Orientation Ppoint in the Catalogue'
   endif
-- Process number of parameters from DTSET in catalogue
    do !numb to !coamingGparts[!loop].catref.dtref.mCount
      !key = !coamingGparts[!loop].catref.dtref.member[!numb].dkey
      !this.coamingGpartData[!idx][3][!numb] = !coamingGparts[!loop].prTitle.attribute(!key)
      !this.coamingGpartData[!idx][4][!numb] = !coamingGparts[!loop].rProp.attribute(!key)
      !this.coamingGpartData[!idx][5][!numb] = !key
    enddo
  enddo

  if (!coaming and defined(!this.coamingPanelTab)) then

    -- Find out if there is an area set up to create the coaming
    !finder = object COLLECTION()
    !finder.type(|STRU|)
    !finder.filter(object EXPRESSION(|PURP eq 'HMCM' and dbwrite|))
    !coamingArea = !finder.results()
    if (!coamingArea.size().lt(1) ) then
      !!alert.error(|Unable to locate STRU to work in (PURP=HMCM). Coaming not available|)
    else
      if (!this.coamingGpartData.size() gt 0 ) then
        !this.coamingArea = !coamingArea[1]
      endif
    endif
  endif

  -- Seems the holeManMain form needs loading and initialising
  !this.readConfigurationFile()
endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      initialise
--              Initialisation - executed each time the form is shown
------------------------------------------------------------------------
define method .initialise(!picked is DBREF, !panel is DBREF, !fixing is DBREF, !position is POSITION , !direction is DIRECTION , !thickness is REAL, !plane is PLANE, !mode is STRING)

  !this.autoscroll = TRUE

  !this.holePanelTab.visible = TRUE

  !this.associated.clear()

  -- set the creation mode
  !this.mode = !mode
  -- clear the created items array on initialise
  !this.panel      = !panel
  !this.pickedItem = !picked
  !this.holeRef    = !fixing
  !this.thickness  = !thickness
  !this.direction  = !direction
  !this.plane      = !plane

   -- initialise specific types in the class box
  if (defined(!this.coamingPanelTab)) then
    !classList[1]    = 'None'
    !classList[2]    = 'Coaming'
    !this.class.dtext = !classList
  endif
  if (!fixing.spre.set()) then
    !this.holeType.select('RTEXT',!fixing.spre.refno.string())
    !choice = !this.holeType.val
    !pNumb = !this.fixingOriPpoint[!choice].after('P').real()
    !this.fixingOri = !fixing.pdir[!pNumb].wrt(worl)
    handle ANY
      !this.cleanUp()
      hide !!hmFreeHole
      return error 1 'P-point $!pNumb of the hole fixing is not correctly configured in the catalogue'
    endhandle
  else
    !this.holeType.select('RTEXT','TMPL')
    if (defined(!this.coamingPanelTab)) then
      !this.class.select('RTEXT','None')
    endif
    !this.fixingOri = object DIRECTION()
  endif

  -- clear the gPart data array [!choice][6] as this stores values from the previously created
  -- hole
  if (defined(!this.gPartData)) then
    do !i from 1 to !this.gPartData.size()
      !this.gPartData[!i].remove(6)
      handle ANY
      endhandle
    enddo
  endif

  if (defined(!this.coamingGpartData)) then
    do !i from 1 to !this.coamingGpartData.size()
      !this.coamingGpartData[!i].remove(6)
      handle ANY
      endhandle
    enddo
  endif

  if (!this.mode eq 'MODIFY') then
    !assos = !fixing.assos
    !holeAssociation = object DBREF()
    do !association values !assos
      -- avoid MDS and other associations
      skip if( !association.type neq 'ASSOC' )
      skip if( !association.owner.purpose neq 'HOLE' )
      !holeAssociation = !association
      break
    enddo
    if( badref(!holeAssociation) ) then
      return error 2 'Cannot find link to hole management Association'
    endif
    !hmHole = object HMHOLE(!holeAssociation)
    !this.hmHole = !hmHole
    if (!this.holeType.selection() neq 'TMPL') then
      !choice = !this.holeType.val
      !fixiDesp = !hmHole.fixiDesp.split()
      do !index index !fixiDesp
        !this.gPartData[!choice][6][!index] = !fixiDesp[!index].real()
        !this.despar$!index$n.val = !index
      enddo
      -- find out of the item has coaming
      !coaming = FALSE
      do !element values !hmHole.secondaryElements
        if (not badref(!element.amemrf)) then
          if (!element.amemrf.type eq 'FIXING' and !element.amemrf.purp eq 'COAM') then
            !this.coamingFixing = !element.amemrf
            !coaming = TRUE
            break
          endif
        endif
      enddo
    else
      !coaming = FALSE
    endif
    if (defined(!this.coamingPanelTab)) then
      -- Setup the coaming gPart data if coaming applied
      if (!coaming) then
        !coamingDesp = !this.coamingFixing.ddesp
        do !index index !coamingDesp
          !this.coamingGpartData[!choice][6][!index] = !coamingDesp[!index]
        enddo
        !this.class.select('dtext','Coaming')
        -- Find out if the direction is on the front or back face
        !coamingDirection = !this.coamingFixing.pdir[1].wrt(worl)
        if (!coamingDirection eq !this.direction) then
          !this.side.select('rtext','front')
        else
          !coamingDirection = !coamingDirection.opposite()
          if (!coamingDirection eq !this.direction) then
            !this.side.select('rtext','back')
          else
            !this.side.select('rtext','front')
          endif
        endif

      else
        !this.coamingFixing = object DBREF()
        !this.class.select('dtext','None')
        !this.coamingDesp.dtext = object ARRAY()
        !this.coamingDesp.rtext = object ARRAY()
        !this.modDesc.val = ''
        !this.modVal.val = ''
      endif
    endif
    !this.oriang.val = 0
    -- mark the database
    !this.undopoint1.add()
    -- Set up the existing associations
    !this.associated.clear()
    do !element values !hmHole.secondaryElements
      skip if (!element.lname eq '/HoleOwner' or !element.lname eq '/primaryElement' or !element.lname eq '/coaming')
      !this.associated.append(!element.amemrf)
    enddo
  elseif (defined(!this.coamingPanelTab)) then
    !this.coamingFixing = object DBREF()
    !this.class.select('dtext','None')
    !this.coamingDesp.dtext = object ARRAY()
    !this.coamingDesp.rtext = object ARRAY()
    !this.modDesc.val = ''
    !this.modVal.val = ''
    !this.oriang.val = 0
    !this.side.select('rtext','front')
  endif

  if (defined(!this.coamingPanelTab)) then
    if (!this.coamingArea.set() and !this.isPlanarPanel()) then
      !this.coamingPanelTab.active = TRUE
    elseif (defined(!this.coamingPanelTab)) then
      !this.coamingPanelTab.visible = FALSE
      !this.coamingPanelTab.active = FALSE
    endif
  endif
  !this.frmType.visible = true
  !this.frmDespar.visible = false

  !this.origin = !position
  !this.holePosition = !this.origin
  !this.direction = !direction

  if( !this.isPlanarPanel() ) then
    !xyOffset = !plane.xyOffset(!position)
    !this.xoffset.val    = !xyOffset.x
    !this.yoffset.val    = !xyOffset.y
    !this.xoffset.active = true
    !this.yoffset.active = true
    !this.xalign.active  = true
    !this.yalign.active  = true
  else
    !this.xoffset.val    = 0
    !this.yoffset.val    = 0
    !this.xoffset.active = false
    !this.yoffset.active = false
    !this.xalign.active  = false
    !this.yalign.active  = false
  endif

  if (!this.gPartData.unset() ) then
    !!alert.error('No valid SPCO found for hole type')
  else
    !this.typeSelected()
  endif

  -- setup the headings for the fitting parameter list box
  if (defined(!this.coamingPanelTab)) then
    !names = object ARRAY()
    !names.append('Parameter')
    !names.append('Value')
    !this.coamingDesp.setheadings(!names)
  endif

  -- set modify frame visibility
  !this.modifyDespars()

  -- Aid number
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidAxes)
  !this.aidTag    = !!aidNumbers.add('fitting axes tag')
  !this.aidAxes   = !!aidNumbers.add('fitting axes arrows')

  !this.oriang.modifiedEvents = TRUE
  !this.aidLines()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      typeSelected()
--              Triggered by selection of hole type from dropdown list
------------------------------------------------------------------------
define method .typeSelected()

-- Depending on choice sort out input fields for DesPar values
  !choice = !this.holeType.val
  if (!this.holeType.selection() eq 'TMPL') then
    !this.frmDespar.active = FALSE
    !this.oriang.active    = FALSE
    !!ce = !this.holeRef
    -- unset the dbref
    SPRE =0/0
    -- if the tmpl does not exist re-create the hierarchy
    !tmpl = !!ce.mCount('tmpl')
    if (!tmpl eq 0) then
      NEW TMPL
      NEW EXTR
      NEW LOOP
      NEW VERT
      AT X -100mm Y 100mm
      NEW VERT
      AT X 100mm Y 100mm
      NEW VERT
      AT X 100mm Y -100mm
      NEW VERT
      AT X -100mm Y -100mm
      EXTR
      !this.extrusion = !!ce
      FIXING
    else
      !find = object COLLECTION()
      !find.scope(!!ce)
      !find.type('EXTR')
      !extr = !find.results()
      !this.extrusion = !extr[1]
    endif
    -- If the previous element had coaming then remove it
    if (defined(!this.coamingPanelTab) and !this.coamingFixing.set()) then
      !!ce = !this.coamingFixing.owner
      DELETE FRMW
      !this.coamingFixing = object DBREF()
      !this.class.select('dtext','None')
      !this.coamingDesp.dtext = object ARRAY()
      !this.coamingDesp.rtext = object ARRAY()
      !this.modDesc.val = ''
      !this.modVal.val = ''
    endif
  else
    !!ce = !this.holeRef
    -- if the tmpl does exist delete it
    !tmpl = !!ce.mCount('tmpl')
    if (!tmpl eq 1) then
      TMPL 1
      DELETE TMPL
      if (!!dbeLoopEdit.shown()) then
        !!dbeLoopEdit.close(TRUE)
      endif
    endif

    !this.frmDespar.active = TRUE
    !this.oriang.active    = TRUE
    do !loop to !this.maxdespars
      if (defined(!this.gPartData[!choice][3][!loop]) ) then
        !this.despar$!loop$n.tag = !this.gPartData[!choice][3][!loop]
        -- if we have previously set up despars for this hole type then use the stored values
        -- to prevent having to re-input values
        if (undefined(!this.gPartData[!choice][6])) then
          !this.despar$!loop$n.val = !this.gPartData[!choice][4][!loop]
        else
          !this.despar$!loop$n.val = !this.gPartData[!choice][6][!loop]
          handle (2,752)
            !this.despar$!loop$n.active = FALSE
            !this.despar$!loop$n.visible = FALSE
          endhandle
        endif
        if (!this.gPartData[!choice][5][!loop].substring(1,1) eq 'F' or !this.gPartData[!choice][5][!loop].substring(1,2) eq 'PF') then
          !this.despar$!loop$n.active = TRUE
         !this.despar$!loop$n.visible = TRUE
        else
          !this.despar$!loop$n.active = FALSE
          !this.despar$!loop$n.visible = FALSE
        endif
      else
        !this.despar$!loop$n.visible = FALSE
        !this.despar$!loop$n.active = FALSE
      endif
    enddo
  endif

  -- Check the selected hole type has a compatible coaming
  if (!this.coamingArea.set() and !this.holeType.selection() neq 'TMPL') then
    !secType = !this.holeType.selection().dbref().secType
    !typeFound = FALSE
    do !types values !this.coamingGpartData
      if (!secType eq !types[2]) then
        !typeFound = TRUE
        break
      endif
    enddo
    if (defined(!this.coamingPanelTab)) then
      if (!typeFound.not()) then
        !this.coamingPanelTab.visible = FALSE
        !this.coamingPanelTab.active = FALSE
        !this.class.select('RTEXT','None')
        !this.setClass()
      else
        !this.coamingPanelTab.active = TRUE
      endif
    endif
  elseif (defined(!this.coamingPanelTab)) then
    !this.coamingPanelTab.visible = FALSE
    !this.coamingPanelTab.active = FALSE
  endif

-- Display the frame for user input
  !this.frmDespar.visible = true
  !this.createHole()
  if defined(!this.coamingPanelTab) and (!this.coamingPanelTab.active) and $
    (!this.class.selection().upcase().eq('COAMING')) then
    !this.applyCoaming()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      apply()
--              apply the previewed hole and create the associations
------------------------------------------------------------------------
define method .apply()

  -- create and populate the holeElemColl object and pass it to hole management
  -- minimum required elements are the panel and the hole fixing reference
  !holeElemColl = object HOLEELEMCOLL()

  if (!this.pickedItem.set()) then
    !holeElemColl.panel = !this.pickedItem
  else
    !!alert.message('No plate has been defined for the current hole')
    return
  endif

  if (!this.holeRef.set()) then
    !holeElemColl.holeFixing = !this.holeRef
  else
    !!alert.message('No hole has been defined for the current plate')
    return
  endif

  if (!this.coamingFixing.set()) then
    !holeElemColl.coamingFixing = !this.coamingFixing
  endif

  if (!this.associated.set()) then
    !holeElemColl.associated = !this.associated
  endif

  if (!this.secondaryPanels.set()) then
    !holeElemColl.secondaryPanels = !this.secondaryPanels
  endif

  !this.tidy()

  -- Create the associations
  !interface = object HMCONTROL()
  if (!this.mode eq 'CREATE') then
    !result = !interface.createGenHole(!holeElemColl, !this.origin, !this.fixiType, !this.fixiDesp, 'GEN')
    if (!result.not()) then
      !!alert.error('Unable to create the Managed Hole Association')
    endif
  else
    !result = !interface.modifyGenHole(!holeElemColl, !this.hmHole, !this.origin, !this.fixiType, !this.fixiDesp, 'GEN')
    if (!result.not()) then
      !!alert.error('Unable to modify the Association')
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      orientation()
--              apply the meta event data to the oriang gadget so that the createHole method will work when using the value up and down buttons
------------------------------------------------------------------------
define method .orientation(!dummyObject is GADGET, !dummySelect is STRING)

  !this.oriang.val = !this.oriang.val
  !this.createHole()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      createHole()
--              create the required fixing structure for single holes
------------------------------------------------------------------------
define method .createHole()

  !choice = !this.holeType.val
  if (!choice.eq(0) ) then
    if (!this.gPartData.unset() ) then
      !!alert.error('No valid SPCO found for hole type')
      return
    else
      !!alert.error('Hole type has not been selected')
      return
    endif
  endif

  if( !this.isPlanarPanel() ) then
    -- get the hole position for the single fixings which represents the hole
    !position = !this.plane.position

    -- get the orientation of the penetrated item so we can establish offset directions
    !xoffDir = !this.plane.orientation.xdir().wrt( /* )
    !yoffDir = !this.plane.orientation.ydir().wrt( /* )

    !position = !position.offset(!xoffDir, !this.xoffset.val)
    !position = !position.offset(!yoffDir, !this.yoffset.val)

  else
    -- On knuckle or curve plate
    !position = !this.origin
  endif

  if (!this.holeType.selection() eq 'TMPL') then
    !this.fixiDesp = ''
    !this.fixiType = 'Free'
    !!ce = !this.holeRef
    -- offset the hole position by the x and y values in the form
    !!ce.pos = !position
    !!ce = !this.extrusion
    !!ce.heig = (!this.thickness * 2 )
    !!ce = !this.holeRef
    ORI Z IS $!<this.direction>
    !distance        = (!this.thickness * -1.5 )
    MOVE $!<this.direction> dist $!<distance>
    !!dbeLoopEdit(!this.extrusion,'EXTR')
  else

    !spref = !this.gPartData[!choice][1]
    !pPointOriNumber = !this.fixingOriPpoint[!choice]

    !despars = ARRAY()
    do !loop to !this.maxdespars
      if (!this.despar$!loop$n.active ) then
        !despars.append(!this.despar$!loop$n.val)
      endif
    enddo

    -- input the form values into the gPartData array so it can be recalled for this hole type
    !this.gPartData[!choice][6].clear()
    handle ANY
      -- in case the array index has not yet been created
      !this.gPartData[!choice].append(!despars)
    elsehandle NONE
      do !i from 1 to !despars.size()
        !this.gPartData[!choice][6].append(!despars[!i])
      enddo
    endhandle

    !!ce = !this.holeRef
    -- create the hole from the available despars and orientate it as requested
    !fixiDesp = ''
    !thickness = ( !this.thickness * 2 )
    !plateThickness = !this.thickness

    !gpart = !this.gPartData[!choice][1]

    do !loop to !this.gPartData[!choice][4].size()
      !dkey  = !this.gPartData[!choice][5][!loop]
      if (!dkey.eq('HTHK')) then
        DDESP N$!loop $!thickness
      elseif (!dkey.eq('HPTH')) then
        DDESP N$!loop $!plateThickness
      elseif (!dkey.substring(1,1).eq('F')) then
        DDESP N$!loop $!this.gPartData[$!choice][6][$!loop]
        !fixiDesp = !fixiDesp & !this.gPartData[!choice][6][!loop] & ' '
      elseif (!dkey.substring(1,2).eq('PF')) then
        DDESP N$!loop $!this.gPartData[$!choice][6][$!loop]
       -- Extra check added to deal with units issues, attempting to set an angle parameter as a distance
       -- P-43630
      elseif (!gpart.fprde.attribute(!dkey).dimension().ptype().eq('DIST')) then
        DDESP N$!loop $!this.gPartData[$!choice][4][$!loop]
      else
        DESP N$!loop $!this.gPartData[$!choice][4][$!loop]
      endif
    enddo

    !this.fixiDesp = !fixiDesp
    !!ce.spre = !spref
    if (!this.fixingOri.unset()) then
      !pNumb = !pPointOriNumber.after('P').real()
      !this.fixingOri = !this.holeRef.pdir[!pNumb].wrt(worl)
      handle ANY
        !this.cleanUp()
        hide !!hmFreeHole
        return error 1 'P-point $!pNumb of the hole fixing is not correctly configured in the catalogue'
      endhandle
    endif

    !this.fixiType = !!ce.spref.sectyp

    -- offset the hole position by the x and y values in the form
    !!ce.pos = !position
    ORI P1 is $!<this.direction> and $!<pPointOriNumber> is $!<this.fixingOri>
    handle (61,7)
      -- on creation just ori the p1
      ORI P1 is $!<this.direction>
    endhandle
    !angle = (!this.oriang.val * -1 )
    ROTATE ABOUT P1 BY $!<angle>
    !this.coamingOri = !!ce.pdir[9].wrt(worl)
    if( !this.isPlanarPanel() ) then
      !distance        = (!this.thickness / -2 )
      MOVE $!<this.direction> dist $!<distance>
    endif
  endif

  !this.origin = !!ce.pos.wrt(worl)

  -- if the coaming is set then apply the same positioning and orientation commands

  if (defined(!this.coamingPanelTab) and (!this.coamingPanelTab.active) and !this.coamingFixing.set()) then
    !this.applyCoaming()
  endif
  !!ce = !this.holeRef
  !this.aidLines()
  handle ANY
  endhandle

endmethod

------------------------------------------------------------------------
-- Method:      cleanUp()
--              clean up any created items when the form is dismissed
------------------------------------------------------------------------
define method .cleanUp()
  -- loop through the newly created holes and delete the frameworks they belong to
  if (!this.mode eq 'CREATE') then
    !!ce = !this.holeRef.own
    handle ANY
    elsehandle NONE
      var !type type
      delete $!type
      handle ANY
      endhandle
    endhandle
    !this.type = ''
    if (!this.coamingFixing.set()) then
      !!ce = !this.coamingFixing.owner
      handle ANY
      elsehandle NONE
        var !type type
        delete $!type
        handle ANY
        endhandle
      endhandle
    endif
  else
    -- undo all db operations
    !this.undopoint1.endundoable()
    undodb

  endif

  !this.tidy()
  --handle ANY
  --endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      ReadConfigurationFile
--
-- Description: Read system configuration file (if it exists) and store settings
--              (%PDMSDFLTS%\des-holemgt-config)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readConfigurationFile()

  if(not defined(!!holeManagementConfiguration)) then
    !tempConfig = object HMCONFIG()
    if(!tempConfig.loadConfigurationFile().not()) then
      !this.cleanUp()
      return error 1 'Error in configuration file. Please Contact your systems administrator'
    endif
  endif

endmethod
-- End of method definition for .readConfigurationFile()

------------------------------------------------------------------------
--
-- Method:      applyCoaming
--
-- Description: apply coaming to a hole
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCoaming()
  if (not(defined(!this.coamingPanelTab))) then
    return
  endif

  if (!this.coamingFixing.unset()) then
    !!ce = !this.coamingArea
    NEW FRMW
    NEW FIXING
    CALL !!autonamece(false)
    handle any
    endhandle
    PURP COAM
    !this.coamingFixing = !!ce
 endif

  -- find the chosen hole
  !secType = !this.holeRef.spref.secType
  -- set the spref of the compatible coaming
  do !index index !this.coamingGpartData
    if (!this.coamingGpartData[!index][2] eq !secType) then
      !coamingSpref = !this.coamingGpartData[!index][1]
      if (defined(!this.coamingGpartData[!index][6])) then
        !coamingDesp  = !this.coamingGpartData[!index][6]
      else
        !coamingDesp  = !this.coamingGpartData[!index][4]
      endif
      !chosenHole = !index
      break
    endif
  enddo

  -- Find the hole design parameters and then tag on the defaults on the end
  !holeDesp          = !this.holeRef.ddesp
  !numberHoleDesp    = !this.fixiDesp.split().size()
  !numberCoamingDesp = !coamingDesp.size()

  !this.coamingFixing.spre = !coamingSpref
  !!ce = !this.coamingFixing

  do !index from 1 to !numberHoleDesp
    DDESP N$!index $!holeDesp[$!index]
    !this.coamingGpartData[!chosenHole][6][!index] = !holeDesp[!index]
  enddo
  !from = (!numberHoleDesp + 1)
  do !index from !from to !numberCoamingDesp
    DDESP N$!index $!coamingDesp[$!index]
    !this.coamingGpartData[!chosenHole][6][!index] = !coamingDesp[!index]
  enddo
  !this.readDespars(!chosenHole)

  -- orientate the fitting
  !!ce.pos     = !this.origin
  !!ce.number  = !this.oriang.val
  !!ce.pos     = !this.origin
  !distance    = (!this.thickness / 2 )
  !this.setSide()

endmethod
-- End of method definition for .applyCoaming()

------------------------------------------------------------------------
--
-- Method:      populateModifyBoxes
--
-- Description: update the boxes that allow parameter modification
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateModifyBoxes()
  if (not(defined(!this.coamingPanelTab))) then
    return
  endif

  !desc = object STRING()
  do !i from 1 to (!!hmFreeHole.coamingDesp.selection('rtext').split().size().real()) - 1
    !desc = !desc + !this.coamingDesp.selection('rtext').split()[!i]
    handle ANY
      !desc = !this.coamingDesp.selection('rtext').split()[!i]
    endhandle
  enddo
  !number = !this.fixiDesp.split().size()
  if (!this.coamingDesp.val leq !number) then
    !this.modVal.active = FALSE
  else
    !this.modVal.active = TRUE
  endif

  !this.modDesc.val = !desc
  !this.modVal.val = !this.coamingDesp.selection('rtext').split()[!!hmFreeHole.coamingDesp.selection('rtext').split().size()]

endmethod
-- End of method definition for .populateModifyBoxes()

------------------------------------------------------------------------
--
-- Method:      updateDespars
--
-- Description: update the fixing despars following a change in the modVal box
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateDespars()
  if (not(defined(!this.coamingPanelTab))) then
    return
  endif
  -- first update the list gadget

  !pos = !!ce
  !dtext = !this.coamingDesp.dtext
  !field = !this.coamingDesp.val

  !dtextArray = object ARRAY()
  !desparsArray = object ARRAY()
  do !j from 1 to !dtext.size()

    if !j.eq(!field) then
      !desc = !this.modDesc.val
      !val = !this.modVal.val
      !this.coamingGpartData[!this.holeType.val][6][!field] = !val.real()
    else
      !desc = object STRING()
      do !i from 1 to (!dtext[!j].split().size().real()) - 1
        !desc = !desc + !dtext[!j].split()[!i]
        handle ANY
          !desc = !dtext[!j].split()[!i]
        endhandle
      enddo
      !val = !dtext[!j].split()[!dtext[!j].split().size()]
    endif

    -- capture the despar values
    !desparsArray.append(!val.real())

    !thisLine = object ARRAY()
    !thisLine.append(!desc)
    !thisLine.append(!val)
    !dtextArray.append(!thisLine)
  enddo
  if (defined(!this.coamingPanelTab)) then
    !this.coamingDesp.setrows(!dtextArray)
    !this.coamingDesp.val = !field
  endif
  -- update the coaming stored data
  --------- now update the fixing despars ------------
  !this.coamingFixing.desp = !desparsArray

  !!ce = !pos

endmethod
-- End of method definition for .updateDespars()

------------------------------------------------------------------------
--
-- Method:      readDespars
--
-- Description: read the despars of a current fixing that has a fitting spref
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readDespars(!number is REAL)

  if (defined(!this.coamingGpartData[!number][6])) then
    !desp = !this.coamingGpartData[!number][6]
  else
    !desp = !this.coamingGpartData[!number][4]
    !this.coamingGpartData[!number][6] = !this.coamingGpartData[!number][4]
  endif

  !desc = !this.coamingGpartData[!number][3]

  !list = object ARRAY()
  do !index index !desp
    !listValues = object ARRAY()
    !listValues.append(!desc[!index])
    !listValues.append(!desp[!index].string())
    !list.append(!listValues)
  enddo
  if (defined(!this.coamingPanelTab)) then
    !this.coamingDesp.setrows(!list)
  endif
  !this.despars = !list

endmethod
-- End of method definition for .readDespars()

------------------------------------------------------------------------
--
-- Method:      tabs
--
-- Description:
--   Select tab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tabs(!gadget is GADGET, !action is STRING)

  if (defined(!this.coamingPanelTab) and !gadget.eq(!this.coamingPanelTab)) then
    -- No action on |HIDDEN|
    if (!action eq |SHOWN|) then
      -- set the class
      !this.setClass()

      -- set the type
      !class = !this.class.selection('DTEXT')
      if !class.upcase().neq('NONE') and !class.upcase().neq('COAMING') then
        -- get the spref of the coamingFixing
        !spref = !this.coamingFixing.spref
      endif
      !this.modifyDespars()
    endif
  elseif !gadget.eq(!this.holePanelTab) then
    if (defined(!this.coamingPanelTab)) then
      !class = !this.class.selection('DTEXT')
    endif
    if defined(!class) and !class.upcase().neq('NONE') and !class.upcase().neq('COAMING') then
      !this.frmDespar.active = FALSE
      !this.frmType.active = FALSE
    else
      !this.frmDespar.active = TRUE
      !this.frmType.active = TRUE
    endif
  elseif !gadget.eq(!this.assocTab) then
    -- No action on |HIDDEN|
    if (!action eq |SHOWN|) then
      !this.populateAssocList()
    endif
  endif

endmethod

-- End of method definition for .tabs()


------------------------------------------------------------------------
--
-- Method:      setClass
--
-- Description: sets up the class of the fitting to be used i.e. defined hatches
--   Select tab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setClass()
  if (not(defined(!this.coamingPanelTab))) then
    return
  endif
  if (!this.holeType.selection() eq 'TMPL')  then
    !this.coamingPanelTab.visible = FALSE
    !this.coamingPanelTab.active = FALSE
    !this.holePanelTab.active    = TRUE
    return
  endif
  !class = !this.class.selection('DTEXT')
  if !class.upcase().eq('NONE') then
    -- empty and freeze all lists and remove any geometry
    !this.coamingDesp.clear()
    !this.coamingDesp.active = FALSE
    if (!this.coamingFixing.set()) then
      !!ce = !this.coamingFixing.owner
      handle ANY
        -- no coamingFixing defined so no reason to do anything
      elsehandle NONE
        DELETE FRMW
        !this.coamingFixing = object DBREF()
        !this.class.select('dtext','None')
        !this.coamingDesp.dtext = object ARRAY()
        !this.coamingDesp.rtext = object ARRAY()
        !this.modDesc.val = ''
        !this.modVal.val = ''
      endhandle
    endif

    -- reset the modify despars gadgets
    !this.modDesc.val = ''
    !this.modVal.val = ''
    !this.modVal.active = FALSE

    -- reset the spref of the hole fixing
    !this.holeRef.spref = !this.gPartData[!this.holeType.val][1]

    !this.aidLines()
    handle ANY
    endhandle

  elseif !class.upcase().eq('COAMING') then
    -- get the appropriate coaming for the hole size and shape selected and freeze the type list
    !this.coamingDesp.active = TRUE

    -- reset the spref of the hole fixing
    !this.holeRef.spref = !this.gPartData[!this.holeType.val][1]

    !fixi = !this.coamingFixing
    if !fixi.unset().not() then
      if !fixi.purpose.eq('COAM') then
        -- do nothing
      else
        !this.applyCoaming()
        !this.populateModifyBoxes()
      endif
    else
      !this.applyCoaming()
      !this.populateModifyBoxes()
    endif
    !this.modVal.active = TRUE


    !this.aidLines()
    handle ANY
    endhandle

  endif

endmethod

-- End of method definition for .setClass()

------------------------------------------------------------------------
--
-- Method:      modifyDespars
--
-- Description: sets the visibility of the modify frame if modify toggle is set
--   Select tab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyDespars()
  if not(defined(!this.coamingPanelTab)) then
    return
  endif
  if (!this.modifyOn.val) then
    !this.modify.active = TRUE
    !number = !this.fixiDesp.split().size()

    if (!this.coamingDesp.val leq !number) then
      !this.modVal.active = FALSE
    else
      !this.modVal.active = TRUE
    endif
  else
    !this.modify.active = FALSE
  endif
  !this.modDesc.active = FALSE

endmethod

-- End of method definition for .modifyDespars()

-----------------------------------------------------------------------
--
-- Method:      autoSetupHole()
--
-- Description: if we are inserting a fitting and the fitting references geometry with a the name /HOLE then this is used
-- to define the hole size and shape to be used to penetrate the plate.
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoSetupHole()

  -- get the spref of the fitting fixing
  !spref = !this.coamingFixing.spref

  -- now get the gmref as the first item should be holding the hole shape and size for the fitting
  var !geom mem 1 of gmref of $!spref
  !holeDefinition = object ARRAY()
  if !geom.dbref().type.eq('SEXT') then
    !holeDefinition.append(!geom.dbref())
  endif

  if !holeDefinition.unset().not() then
    !profile = object PROFILE(!holeDefinition[1].member[1],!this.coamingFixing)
    !!ce = !this.holeRef
    tmpl 1
    handle ANY
      new tmpl
      new extr
      !thickness = (!this.panel.lohe * 1.25)
      hei $!thickness
      new loop
    elsehandle NONE
      extr 1
      loop 1
      delete loop mem
    endhandle
    !profile.dbwrite(!!ce)
    handle ANY
      return
    elsehandle NONE
      -- unset the hole fixing spref because the representation of the hole is in the tmpl now
      !!ce = !this.holeRef
      spref unset
    endhandle

    !this.aidLines()
    handle ANY
    endhandle
  else
    !this.tidy()
    -- if there are any tmpl elements then remove them
    !!ce = !this.holeRef
    tmpl 1
    handle ANY
      -- do nothing
    elsehandle NONE
      delete tmpl
    endhandle

    -- set the top level fitting spref to whatever is in the hole type selection from the hole pane
    !this.holeRef.spref = !this.gPartData[!this.holeType.val][1]
    !this.aidLines()
    handle ANY
    endhandle
    return
  endif
endmethod

-- End of method definition for .autoSetupHole()

------------------------------------------------------------------------
--
-- Method:      setSide
--
-- Description: Set the side of the panel that the origin of the fitting is positioned at
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSide()

  -- Pick up the ori ppoint number
  !choice = !this.holeType.val
  !pPointOriNumber = !this.coamingOriPpoint[!choice]

  if (!this.coamingFixing.set()) then
    !!ce = !this.coamingFixing
    if (!this.side.selection() eq 'front') then
      !direction = !this.direction
    else
      !direction = !this.direction.opposite()
    endif
    !!ce.pos = !this.origin
    !distance = (!this.thickness / 2 )
    MOVE $!direction DISTANCE $!distance
    ORI P1 IS $!<direction> and $!<pPointOriNumber> is $!<this.coamingOri>
  endif
  !this.aidLines()
endmethod
-- End of method definition for .setSide()


------------------------------------------------------------------------
--
-- Method:      addAssocItem
--
-- Description: add an item to the association list to be created in hole management
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addAssocItem(!data is EDGPICKDATA)

  -- primary owner specific for members of CPANEL elements
  if (!data.item.owner.hardType inset( 'CPROTR', 'CSURPX'  )) then
    !element = !data.item.hrdprx[1]
    handle any
      !!alert.error('Selected curved plate does not have a curved hull panel. Only curved hull panels can be penetrated')
      return
    endhandle
  else
    if( !data.item.owner.hardType eq 'BRAN' ) then
      !element = !data.item
    else
      -- set the element picked to its primary owner
      !element = !data.item.prmown
    endif
  endif

    -- check that the item does not currently exist in our lists
  if (!element eq !this.holeRef or !element eq !this.panel) then
    !!alert.message('Selected item is already associated with this hole')
    return
  else
    if (!this.coamingFixing.set()) then
      if (!element eq !this.coamingFixing) then
        !!alert.message('Selected item is already associated with this hole')
        return
      endif
    endif
    !number = !this.associated.findFirst(!element)
    if (!number.set()) then
      !this.associated.remove(!number)
    else
      -- if the item is a fixing make sure it doesn't already have a hole associations
      if (!element.hardType eq 'FIXING') then
        !associations = !element.assos
        do !assoc values !associations
          if (!assoc.owner.purp eq 'HOLE') then
            !!alert.message('The item picked already has HOLE associations')
            return
          endif
        enddo
      endif
      !this.associated.append(!element)
     endif
   endif

   !this.populateAssocList()

endmethod
-- End of method definition for .addAssocItem()

------------------------------------------------------------------------
--
-- Method:      remAssocItem
--
-- Description: remove the selected item from the association list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remAssocItem()

  !selection = !this.assocList.selection('dtext').upcase()

  if (!selection.matchWild('PRIMARY PANEL*') or !selection.matchWild('HOLE REFERENCE*') or !selection.matchWild('COAMING REFERENCE*')) then
    !!alert.message('Cannot remove this item, it is required to create the hole')
    return
  endif

  !number = !this.associated.findFirst(!this.assocList.selection().dbref())
  if (!number.set()) then
    !this.associated.remove(!number)
  endif

  !this.populateAssocList()

endmethod
-- End of method definition for .remAssocItem()

------------------------------------------------------------------------
--
-- Method:      populateAssocList
--
-- Description: populate the association list with selected items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

 define method .populateAssocList()

  -- collect all the associated members and pass them to hole management in a holeElemColl object
  -- first collect the panel reference
  !panel = !this.panel

  -- now get the hole fixing
  !holeFixing = !this.holeRef

  -- secondary panels are included in case the hole goes through more than 1 layer of a
  -- multi layer panel (in the case of room design)
  !secondaryPanels = !this.secondaryPanels

  -- now collect any other items that have been associated with the hole
  !associated = !this.associated

  !list = object ARRAY()
  !rtext = object ARRAY()

  !this.assocList.clear()

  !listValues = object ARRAY()
  if !panel.unset().not() then
    !listValues.append('Primary Panel')
    !listValues.append(!panel.namn)
    !rtext.append(!panel.name)
  else
    !listValues.append('Primary Panel')
    !listValues.append('unset')
    !rtext.append('')
  endif
  !list.append(!listValues)

  !listValues = object ARRAY()
  if !holeFixing.unset().not() then
    !listValues.append('Hole Reference')
    !listValues.append(!holeFixing.namn)
    !rtext.append(!holeFixing.name)
  else
    !listValues.append('Hole Reference')
    !listValues.append('unset')
    !rtext.append('')
  endif
  !list.append(!listValues)

  !listValues = object ARRAY()
  if (!this.coamingFixing.set()) then
    !listValues.append('Coaming Reference')
    !listValues.append(!this.coamingFixing.namn)
    !rtext.append(!this.coamingFixing.name)
    !list.append(!listValues)
  endif

  do !i from 1 to !secondaryPanels.size()
    !listValues = object ARRAY()
    !listValues.append('Secondary Panel')
    !listValues.append(!secondaryPanels[!i].namn)
    !list.append(!listValues)
    !rtext.append(!secondaryPanels[!i].name)
  enddo

  do !i from 1 to !associated.size()
    !listValues = object ARRAY()
    !listValues.append(!associated[!i].type)
    !listValues.append(!associated[!i].namn)
    !list.append(!listValues)
    !rtext.append(!associated[!i].name)
  enddo

  !this.assocList.setrows(!list)
  !this.assocList.rtext = !rtext

endmethod
-- End of method definition for .populateAssocList()

------------------------------------------------------------------------
--
-- Method:      aidLines
--
-- Description: draw aid lines for the current hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidLines()

  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidAxes)

  !fixingPos = !this.holeRef.position.wrt( /* )
  if( !this.isPlanarPanel().not() ) then
    !axes = object GPHAXES(!fixingPos, !this.holeRef.orientation.wrt( /* ))
    !axes.draw(!this.aidAxes, FALSE)
    return
  endif
  !panelPos  = !this.plane.position
  !fixingPlane = object PLANE(!this.plane.position,!this.plane.orientation)
  if (defined(!this.coamingPanelTab)) then
    if (!this.side.selection() eq 'back') then
      !p = !this.plane.position
      !p = !p.offset( !this.direction.opposite(), !this.thickness)
      !fixingPlane.position = !p
    endif
  endif
  !xoffDir = !this.plane.orientation.xdir().wrt( /* )
  !yoffDir = !this.plane.orientation.ydir().wrt( /* )

  !endPos = !panelPos.offset(!xoffDir, !this.xoffset.val)
  !line1 = object LINE(!panelPos,!endPos)
  !startPos = !endPos

  !endPos = !startPos.offset(!yoffDir, !this.yoffset.val)
  !line2 = object LINE(!startPos,!endPos)
  if (!this.xoffset.val lt 0 ) then
    !aidXOffset = -850mm
  else
    !aidXOffset = 850
  endif
  if (!this.yoffset.val lt 0 ) then
    !aidYOffset = -850
  else
    !aidYOffset = 850
  endif
  !fixEndPos = !fixingPlane.near(!endPos)
  !aid1EndPos = !fixEndPos.offset(!xoffDir, !aidXOffset)
  !aidLine1 = object LINE(!fixEndPos ,!aid1EndPos)

  !aid2EndPos = !fixEndPos.offset(!yoffDir, !aidYOffset)
  !aidLine2 = object LINE(!fixEndPos ,!aid2EndPos)

  !fixingZDir = !this.direction

  -- get offset values as formatted strings
  !xOffsetString = !this.xoffset.val.string(!!distanceFmt)
  !yOffsetString = !this.yoffset.val.string(!!distanceFmt)

  !boxSize     = 10mm
  !gBox            = object GMFBOX()
  !gBox.xLength    = !boxSize
  !gBox.yLength    = (!this.thickness * 0.2 )
  !gBox.zLength    = 0mm
  if (!this.xoffset.val eq 0 ) then
    !boxDir = !xoffDir
  else
    -- for each line show an aid box
    do !f from 1 to 2
      !length          = !line1.length()
      !midPoint        = !line1.proportion(0.5)
      if (!f eq 1) then
        !midPoint = !midPoint.offset(!fixingZDir.opposite(), !this.thickness )
      endif
      !boxDir          = !line1.direction()
      !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
      !gBox.zLength    = !length
      !gBox.position   = !midPoint
      !gBox.orientation = !orientation
      !graphBox         = object GPHBOX(!gBox)
      !graphBox.filled(true)
      !graphBox.draw(!this.aidTag, FALSE)
    enddo
    aid text num $!this.aidTag |$!<xOffsetString>| at $!<midPoint>
  endif
  !arrowHeight = 1000mm
  !prop = 0.15
  if (!gBox.yLength gt 150mm) then
    --make sure arrow is at least as wide as the aid-boxes
    !arrowHeight = 850mm + !gBox.yLength
    !prop = !gBox.yLength / !arrowHeight
  endif
  aid arrow num $!this.aidAxes at $!fixEndPos dir $!boxDir hei $!arrowHeight prop $!prop

  !length          = !aidLine1.length()
  if( !length gt 0.1mm ) then
    !midPoint        = !aidLine1.proportion(0.5)
     !boxDir          = !aidLine1.direction()
    !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
    !gBox.zLength    = !length
    !gBox.position   = !midPoint
    !gBox.orientation = !orientation
    !graphBox         = object GPHBOX(!gBox)
    !graphBox.filled(true)
    !graphBox.draw(!this.aidTag, FALSE)
  endif


  if (!this.yoffset.val eq 0 ) then
    !boxDir = !yoffDir
  else
    do !f from 1 to 2
      !length          = !line2.length()
      !midPoint        = !line2.proportion(0.5)
      if (!f eq 1) then
        !midPoint = !midPoint.offset(!fixingZDir.opposite(), !this.thickness )
      endif
      !boxDir          = !line2.direction()
      !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
      !gBox.zLength    = !length
      !gBox.position   = !midPoint
      !gBox.orientation = !orientation
      !graphBox         = object GPHBOX(!gBox)
      !graphBox.filled(true)
      !graphBox.draw(!this.aidTag, FALSE)
    enddo
    aid text num $!<this.aidTag> |$!<yOffsetString>| at $!<midPoint>
  endif
  aid arrow num $!<this.aidAxes> at $!fixEndPos dir $!<boxDir> hei $!arrowHeight prop $!prop

  !length          = !aidLine2.length()
  if( !length gt 0.1mm ) then
    !midPoint        = !aidLine2.proportion(0.5)
    !boxDir          = !aidLine2.direction()
    !orientation     = object ORIENTATION('Y IS $!<fixingZDir> AND Z IS $!<boxDir>')
    !gBox.zLength    = !length
    !gBox.position   = !midPoint
    !gBox.orientation = !orientation
    !graphBox         = object GPHBOX(!gBox)
    !graphBox.filled(true)
    !graphBox.draw(!this.aidTag, FALSE)
  endif

  aid text num $!<this.aidTag> 'HOLE X' at $!<aid1EndPos>
  aid text num $!<this.aidTag> 'HOLE Y' at $!<aid2EndPos>
endmethod
-- End of method definition for .aidLines()

------------------------------------------------------------------------
--
-- Method:      tidy()
--
-- Description: tidy up any aid lines that are not required anymore
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidAxes)
  if (defined(!!dbeLoopEdit)) then
    if (!!dbeLoopEdit.shown()) then
      !!dbeLoopEdit.close(TRUE)
    endif
  endif
  !!edgCntrl.remove('Pick associated item')
  !!edgCntrl.remove('Pick hole position')

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      posAlign
--
-- Description:
--   get picks to allow positional offsetting in !direction
--   uses the edg toolkit frame within !!appDesMain
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posAlign(!dirXorY is STRING)

  !this.dirXorY = !dirXorY

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.definePosition('Align Hole to picked position')
  !packet.key            = 'alignpos'
  !packet.description    = 'Align Position'
  !packet.action         = '!!hmFreeHole.offset(!this.return[1].position)'
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add into EDG packet
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .posAlign(DIRECTION, DBREF)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description:  offset the element in the current direction through the supplied position
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!position is POSITION)

  !offDir = !this.dirXorY
  -- first get the offset direction
  if !offDir.upcase().eq('X') then
    !direction = !this.plane.orientation.xdir().wrt( /* )
  else
    !direction = !this.plane.orientation.ydir().wrt( /* )
  endif

  -- now the hole position
  !holePos = !this.holeRef.position.wrt( /* )

  -- create a point vector from the fitting position in the direction of the offset direction
  !holePv = object POINTVECTOR(!holePos, !direction)

  -- offset the hole position through the selected point
  !newPoint = !holePv.through(!position)

  -- move the hole to the new point
  !this.holeRef.position = !newPoint.position

  -- update the offset gadgets
  !plane = !this.plane
  !xyOffset = !plane.xyOffset(!newPoint.position)
  !this.xoffset.val = !xyOffset.x
  !this.yoffset.val = !xyOffset.y

  !this.origin = !this.holeRef.position
  if (defined(!this.coamingPanelTab)) and (!this.coamingPanelTab.active) and (!this.coamingFixing.set()) then
    !this.applyCoaming()
  endif
  -- re-draw the aids
  !this.aidLines()

endmethod
-- End of method definition for .offset(DIRECTION, POSITION)

------------------------------------------------------------------------
--
-- Method:      .edgPickAssociated()
--
-- Description: Set EDG to pick associated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgPickAssociated()

  !!edgCntrl.remove('Pick Associated Item')
  -- Define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick associated item')
  !packet.description    = !this.associatedPacketDesc
  !packet.priority       = 3
  !packet.action         = '!!hmFreeHole.addAssocItem(!this.return[1])'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      isPlanarPanel()
--
-- Description: Returns true if the target panel is planar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isPlanarPanel() is BOOLEAN

  if( !this.panel.hardType inset('CPLATE','CPANEL') ) then
    return false
  endif
  if( !this.panel.hardType eq 'HPLATE' ) then
    return !this.panel.knuckl.not()
  endif
  return true

endmethod
-- End of method definition for .isPlanarPanel()

------------------------------------------------------------------------
--
-- Method:      .edgPickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgPickPenetrated()

  -- Define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick a face on the penetrated object')
  !packet.description    = !this.pickPacketDescription
  !packet.priority       = 3
--  !packet.close          = '!!genPenCreate.setPenetrated(FALSE)'
  !packet.action         = '!!hmFreeHole.pickPenetrated(!this.return[1])'
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|PANE|,|HPLATE|,|CPLATE|)'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

----------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetrated(!data is EDGPICKDATA)

  !positionData = !data.positionData()
  if(!positionData.line.set()) then
    !position   = !positionData.line.intersection(!positionData.pointVector)
    !direction  = object DIRECTION()
  elseif (!positionData.plane.set()) then
    !position   = !positionData.pointVector.intersection(!positionData.plane)
    !direction  = !positionData.plane.direction()
  elseif (!positionData.position.set()) then
    !position   = !positionData.position.wrt( /* )
    !direction  = object DIRECTION()
  endif

  if (!data.item.hardType eq 'HPLATE') then
    if (!data.item.owner neq !this.pickedItem.owner) then
      !!alert.error('The picked item must be in the same PANEL')
      return
    endif
  elseif (!data.item.hardType eq 'CPLATE') then
    if (!data.item.hrdprx[1] neq !this.pickedItem.hrdprx[1]) then
      !!alert.error('The picked item must be in the same PANEL')
      return
    endif
  elseif (!data.item.hardType eq 'PANE') then
    if (!data.item neq !this.pickedItem) then
      !!alert.error('The picked item must be in the same PANEL')
      return
    endif
  endif

  -- Pick up the ori ppoint number
  if (!this.holeType.selection() neq 'TMPL') then
    !choice = !this.holeType.val
    !pPointOriNumber = !this.fixingOriPpoint[!choice]
  endif

  if( !this.isPlanarPanel() ) then
    -- move the hole to the new point
    !xyOffset  = !this.plane.xyOffset(!position)
    !holePlane = !this.plane
    !holePlane.position  = !this.holeRef.position
    !this.holeRef.position = !holePlane.near(!position)
    !this.xoffset.val    = !xyOffset.x
    !this.yoffset.val    = !xyOffset.y
    !this.xoffset.active = true
    !this.yoffset.active = true
    !this.xalign.active  = true
    !this.yalign.active  = true
    !this.origin       = !this.holeRef.position
    !this.holePosition = !this.origin
    if (defined(!this.coamingPanelTab)) and (!this.coamingPanelTab.active) and (!this.coamingFixing.set()) then
      !this.applyCoaming()
    endif
  else
    -- curved or knuckled panel
    if( !direction.set() ) then
      !this.direction = !direction
    else
      !!alert.warning('Please Pick a planar facet')
      return
    endif
    !this.xoffset.val    = 0
    !this.yoffset.val    = 0
    !this.xoffset.active = false
    !this.yoffset.active = false
    !this.xalign.active  = false
    !this.yalign.active  = false
    -- move the hole to the new point
    !this.holeRef.position = !position
    !saveCE = !!ce
    !!ce    = !this.holeRef
    if( !this.fixiType.upcase() eq 'FREE' ) then
      ORI Z IS $!<this.direction>
    else
      ORI P1 is $!<this.direction> and $!<pPointOriNumber> is $!<this.fixingOri>
      handle (61,7)
        -- on creation just ori the p1
        ORI P1 is $!<this.direction>
      endhandle
    endif
    !angle = (!this.oriang.val * -1 )
    ROTATE ABOUT P1 BY $!<angle>
    !!ce = !saveCE
    !this.origin       = !this.holeRef.position
    !this.holePosition = !this.origin
  endif
  -- re-draw the aids
  !this.aidLines()

endmethod
