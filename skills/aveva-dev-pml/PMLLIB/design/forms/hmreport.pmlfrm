------------------------------------------------------------------------
--
-- Method:      testEval
--
-- Description: Perform test evaluation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .testEval(!association is STRING) is STRING

 !testev = !association.dbref().testev
  handle any
    !status = 'Invalid'
  elsehandle none
    if (!testev) then
      !status = 'Passed'
    else
      !status = 'Failed'
    endif
  endhandle

  return !status

endmethod

------------------------------------------------------------------------
--
-- Method:      readConfigurationFile
--
-- Description: Read system configuration file (if it exists) and store settings
--              (%PDMSDFLTS%\des-holemgt-config)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readConfigurationFile()

  if(not defined(!!holeManagementConfiguration)) then
    !tempConfig = object HMCONFIG()
    if(!tempConfig.loadConfigurationFile().not()) then
      return error 1 'Error in configuration file. Please Contact your systems administrator'
    endif
  endif

endmethod
-- End of method definition for .readConfigurationFile()

------------------------------------------------------------------------
--
-- Method:      updateGraphics()
--
-- Description: Update graphical view to focus on specified items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGraphics(!itemList is ARRAY, !mode is STRING)

  -- If standard view is set then update it otherwise gracefully ignore this
  if ( !!gphViews.views.set() ) then
    AUTOCOLOUR ON
    UNENHANCE ALL
    --  Add items in !itemList to 3D view
    if(!mode.eq('ADD')) then
      do !i values !!gphDrawLists.drawLists
        !i.addMembers(!itemList)
      enddo
      do !element values !itemList
        do !i values !!gphDrawLists.drawLists
          !i.add(!element)
          if (!element.type eq 'FIXING') then
            !i.colour(!element,6)
          endif
        enddo
      enddo

    --  Remove items in !itemList from 3D view
    elseif(!mode.eq('REM')) then
      do !i values !!gphDrawLists.drawLists
        !i.removeMembers(!itemList)
      enddo
    endif

  endif

  return

endmethod
-- End of method definition for .updateGraphics()

------------------------------------------------------------------------
--
-- Method:      .saveToXLS()
--
-- Description: Save the displayed grid data to a user-selected MS Excel File
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/Rw] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToXLS()

  using Namespace 'Aveva.Pdms.Presentation'
  !browser   = object PMLFILEBROWSER('save')

  -- Default to first location from PDMSUSER evar
  !pdmsUser  = !!evarSplit('PDMSUSER')
  !directory = !pdmsUser[1]

  !seedFile  = 'HoleAssociations'
  !title     = 'Save Report As'

  !existFlag = False
  !filter = 'Microsoft Office Excel Files (*.xls)|*.xls'
  !filterIndex = 1

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

  -- Set Selected File
  !saveFile = object FILE( !browser.file() )
  if ( !saveFile.set() ) then
    !this.assocMemGrid.saveGridToExcel(!saveFile.string())
    !!alert.message('File saved: ' + !saveFile.string() )
  endif

endmethod
-- End Of Method Definition For .saveToXLS()


------------------------------------------------------------------------
--
-- Method:      .printList()
--
-- Description: Preview for printing the grid data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printList()

  if (!this.assocMemGrid.getNumberRows().neq(0)) then
     !this.assocMemGrid.printPreview()
  else
     !!alert.error('The report is empty')
  endif

endmethod
-- End of method definition for .printList()

------------------------------------------------------------------------
--
-- Method:      .collectDrawlistItems()
--
-- Description: Collect an array of items that need to be added/removed from
--              the drawlist based on the current selection in the hole list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       Items to be added/removed in the drawlist
------------------------------------------------------------------------
define method .collectDrawlistItems(!rows is ARRAY ) is ARRAY

  -- Array of items to be added/removed in the drawlist
  !viewList = ARRAY()

  -- Get all selected rows
  do !row values !rows

    -- Create a new HMHOLE object given a DBREF
    !hmHole = object HMHOLE(!row[1].dbref())

    -- Check if PrimaryElement exists
    if (!hmHole.primaryElement.set()) then
      if (NOT BADREF(!hmHole.primaryElement.amemrf) ) then
        !viewList.append(!hmHole.primaryElement.amemrf)
      endif
    endif

    -- Process each of the secondaryElements
    do !index index !hmHole.secondaryElements
      if (NOT BADREF(!hmHole.secondaryElements[$!index].amemrf) ) then
        !viewList.append(!hmHole.secondaryElements[!index].amemrf)
      endif
    enddo

    -- Destroy hole object
    !hmHole.delete()

  enddo

  -- Return array of items to be added/removed from drawlist
  return !viewList

endmethod

------------------------------------------------------------------------
--
-- Method:      .returnToAssocs()
--
-- Description: Show Hole Association panel and refresh items in case any
--              have been deleted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .returnToAssocs()

  !this.updateAssocs()
  !this.highlightAssocMemGrid()

endmethod

------------------------------------------------------------------------
--
-- Method:      .focusOnHole()
--
-- Description: focus the current view on the hole
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .focusOnHole(!rows is ARRAY)

  -- Find the selected hole
  !hmHole = object HMHOLE(!rows[1][1].dbref())
  !position = !hmHole.origin
  if( !position.unset() ) then
    !!alert.warning('Cannot focus on this hole. Hole position data is not set')
    return
  endif
  !virtualHole  = !hmHole.virtualHole
  if( not badref(!virtualHole) ) then
    !volume = object VOLUME(!virtualHole)
    -- expand by 500mm
    !viewRadius = !volume.from.distance(!volume.to) + 500mm
  else
    !viewRadius = 500mm
  endif

  --Build the positions
  !limits[1]  =  object POSITION('E ' & (!position.east - (!viewRadius / 2)) & ' N ' & (!position.north - (!viewRadius / 2)) & ' U ' & (!position.up - (!viewRadius / 2)) & ' WRT WORLD')
  !limits[2]  =  object POSITION('E ' & (!position.east + (!viewRadius / 2)) & ' N ' & (!position.north + (!viewRadius / 2)) & ' U ' & (!position.up + (!viewRadius / 2)) & ' WRT WORLD')
  --Create a volume object
  !volume     = object VOLUME(!limits[1],!limits[2])

  -- find the current selected view
  !systemInfo = object FMSYS()
  !form       = !systemInfo.currentDocument()

  if (!form.view.clipping) then
    --Clip the volume
    !!gphViews.clipboxElement(!form.view,!volume)
  endif

  --Set the limits
  !!gphViews.limits(!form.view,!volume)

endmethod

------------------------------------------------------------------------
--
-- Method:      .updateAssocs()
--
-- Description: update the current association list when
--              returning from the hole management task
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateAssocs()

  using namespace  'Aveva.Pdms.Presentation'

  -- Update the association with the latest status
  !row = 1
  !deletedRows = ARRAY()
  !selectedRow = !this.assocMemGrid.getSelectedRowTags()
  do !association values !this.assocMemGrid.getSelectedRows()
    !hole = object HMHOLE(!association[1].dbref())
    handle ANY
      -- Association has been deleted
      !deletedRows.append(!selectedRow[!row].real())
    elsehandle NONE
      !status = !hole.status
      !this.assocMemGrid.setCellValue(!selectedRow[!row].real(), 3, !status)
      !valid = !this.testEval(!association[1])
      !this.assocMemGrid.setCellValue(!selectedRow[!row].real(), 4, !valid)
      if (!hole.element.dbexno gt 1) then
        !claimed1 = !hole.element.exclto
        !claimed2 = !hole.element.exclhi.empty().not()
        if (!claimed1 or !claimed2) then
          !claimed = TRUE
        else
          !claimed = FALSE
        endif
      else
        !claimed = !hole.element.lclmh
      endif
      if (!claimed) then
        !claimedStr = 'YES'
      else
        !claimedStr = 'NO'
      endif
      !this.assocMemGrid.setCellValue(!selectedRow[!row].real(), 5, !claimedStr)
    endhandle
    !row = (!row + 1 )
  enddo
  if (!deletedRows.size() gt 0 ) then
    !this.assocMemGrid.deleteRows(!deletedRows)
  endif
  !this.highlightAssocMemGrid()

endmethod

------------------------------------------------------------------------
--
-- Method:      .applyFilter()
--
-- Description: filter the current association list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .applyFilter()

  using namespace  'Aveva.Pdms.Presentation'

  -- Clear any existing data
  !this.assocMemGrid.clearGrid()

  !selection = !this.filterModeSelected
  !discipline = !this.filterDiscipline.selection()
  !filterStatus = !this.filterStatus.selection()
  if (!filterStatus EQ 'Unset') then
    !filterStatus = ''	
  endif

  !this.getHoleData()

  return

endmethod

-----------------------------------------------------------------------
--
-- Method:      .highlightAssocMemGrid()
--
-- Description: highlight failed and invalid associations on the main grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .highlightAssocMemGrid()

  !errorReported = false
  -- Highlight any FAILED or Invalid validations with RED cell background
  do !column from 1 to !this.assocMemGrid.getnumberColumns()
    do !row from 1 to !this.assocMemGrid.getNumberRows()
      !cellValue = !this.assocMemGrid.getCell(!row, !column)
      if ( !cellValue inset('Invalid', 'Failed') ) then
        !this.assocMemGrid.setCellColor(!row, !column, 'salmon')
        !iconFile = !!pml.getpathname('exclamation-16.png')
        handle ANY
        -- Icon file does not exist
        elsehandle NONE
          !this.assocMemGrid.setCellImage(!row, !column, !iconFile)
          handle any
            if( !errorReported.not() ) then
              !!alert.error(|Error setting cell icon - | + !!error.text)
              !errorReported = true
            endif
          endhandle
        endhandle
      elseif (!cellValue eq 'Passed') then
        !this.assocMemGrid.setCellColor(!row, !column, 'springgreen')
      endif
    enddo
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      showProgress
--
-- Description: Update progress bar
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showProgress(!percent is REAL)

  if (!percent lt 0) then
    !!fmsys.setProgress(0)
  else
    !!fmsys.setProgress(!percent)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getHolesFor
--
-- Description: Get holes for the given element
--              BEWARE THIS IS CALLED RECURSIVELY
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference of item
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of hole Association References
--
------------------------------------------------------------------------
define method .getHolesFor(!item is DBREF) is ARRAY

  !assocHole   = ARRAY()
  -- Find associations for this element
  !assocList   = !item.assos
  handle any
    !assocList = ARRAY()
  endhandle
  do !assoc values !assocList
    skip if(!assoc.type neq 'ASSOC')
    skip if(!assoc.owner.purp neq 'HOLE')
    !assocHole.append(!assoc)
  enddo

  if( !assocHole.empty() ) then
    -- climb to owner if referenced for some types
    !owner = !item.owner
    if (!owner.hardType inset( 'CPROTR', 'CSURPX'  )) then
      !owner = !item.hrdprx[1]
    endif
    if( !owner.hardType inset('HPANEL', 'CPANEL', 'BRAN') ) then
      -- BEWARE THIS IS CALLED RECURSIVELY
      !assocHole = !this.getHolesFor( !owner )
    endif
  endif

  if( !assocHole.empty() ) then
    -- see if the element is an ASSOC
    !types[1] = 'ASSOC'
    !assocRef = !!dtbOwnerOfTypes( !item, !types )
    if( not badref( !assocRef ) ) then
      if( !assocRef.owner.purp eq 'HOLE' ) then
        !assocHole[1] = !assocRef
      endif
    endif
  endif

  return !assocHole

endmethod

------------------------------------------------------------------------
--
-- Method:      getAllHoles
--
-- Description: Get all managed holes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of hole Association References
--
------------------------------------------------------------------------
define method .getAllHoles() is ARRAY

  -- get groups first to improve performance
  VAR !allAssocGroups COLLECT ALL ASSOGP WITH (PURP eq 'HOLE')
  !allAssoc = ARRAY()
  do !assocGroup values !allAssocGroups
    !allAssoc.appendArray(!assocGroup.dbref().members)
  enddo

  return !allAssoc

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getCurrentSelection
--
-- Description: Get current graphical selection as list of DBREFs
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of DBREFs obtained from current selection
--
------------------------------------------------------------------------
define method .getCurrentSelection() is ARRAY

   -- Initialise Variables
   !selection              = object SELECTION()
   !selection.getCurrent()

   -- Selection list
   !selectionList          = !selection.getSelection()
   !list                   = !selectionList

   return !list

endmethod

------------------------------------------------------------------------
--
-- Method:      setHeadings
--
-- Description: Provides current selection as list of DBREFs.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHeadings(!switch is BOOLEAN)

  -- hole
  !this.headDiscipline.val  = !switch
  !this.headStatus.val      = !switch
  !this.headValid.val       = !switch
  !this.headHoleType.val    = !switch
  !this.headSize.val        = !switch
  !this.headPosition.val    = !switch
  !this.headUser.val        = !switch
  !this.headDate.val        = !switch

  -- penetrated
  !this.headBlock.val       = !switch
  !this.headPenetrated.val  = !switch
  !this.headThickness.val   = !switch
  !this.headQuality.val     = !switch

  -- penetrating
  !this.headPenetrating.val = !switch
  !this.headBranch.val      = !switch
  !this.headSite.val        = !switch
  !this.headBore.val        = !switch
  !this.headRating.val      = !switch
  !this.headSystem.val      = !switch

endmethod
