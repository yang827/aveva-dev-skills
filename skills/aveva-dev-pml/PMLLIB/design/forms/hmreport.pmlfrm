--
--  Description:     Report on Manage Holes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyFilter()                    -                   filter the current association list
--  assocRightClick(ARRAY)           -                   Right click options
--  back()                           -                   return from preview page to report page
--  collectDrawlistItems(ARRAY)      ARRAY
--  filterChanged(BOOLEAN)           -                   rtoggle buttons have been clicked. Optionally apply filter
--  focusOnHole(ARRAY)               -                   focus the current view on the hole
--  getAllHoles()                    ARRAY               Get all managed holes
--  getCurrentSelection()            ARRAY               Get current graphical selection as list of DBREFs
--  getHoleData()                    -                   Get hole data
--  getHolesFor(DBREF)               ARRAY               Get holes for the given element
--  getReportHeadings()              ARRAY               Update report grid
--  highlightAssocMemGrid()          -                   highlight failed and invalid associations on the main grid
--  hmReport()                       -                   Constructor
--  initialise()                     -                   Handle form shown event
--  initialiseReportGadgets()        -                   Initialise Gadgets
--  navAssoc()                       -                   Navigate to the association
--  navAssocItem1()                  -                   Navigate to the association member1
--  navAssocItem2()                  -                   Navigate to the association member2
--  preview()                        -                   Show preview pane
--  printList()                      -                   Preview for printing the grid data
--  readConfigurationFile()          -                   Read system configuration file (if it exists) and store settings
--  returnToAssocs()                 -                   Show Hole Association panel and refresh items in case any
--  saveToXLS()                      -                   Save the displayed grid data to a user-selected MS Excel File
--  setHeadings(BOOLEAN)             -                   Provides current selection as list of DBREFs.
--  showProgress(REAL)               -                   Update progress bar
--  testEval(STRING)                 STRING              Perform test evaluation
--  updateAssocs()                   -                   update the current association list when
--  updateGraphics(ARRAY,STRING)     -                   Update graphical view to focus on specified items
--  updateReportGrid()               -                   Update report grid
--
-- Description:
-- Report on Manage Holes
------------------------------------------------------------------------
--

  import 'pmlfilebrowser'
  handle (1000,0)
  endhandle

  import 'GridControl'
  handle (1000,0)
  endhandle


setup form !!hmReport dialog docking right

  using namespace 'Aveva.Pdms.Presentation'

  -- Hole Association Manager
  frame .holeAssocPane panel      anchor l+r+t  at x0 y0
    frame .filterFrame            anchor t+l+r |Hole Association Filter|   width 62
      rtoggle   .rtogCE           anchor t+l 'Current Element'
      path right
      rtoggle   .rtogList         anchor t+l 'Graphical Selection'
      rtoggle   .rtogAll          anchor t+l 'All Managed Holes'

      option    .filterDiscipline anchor t+l tagwid 7 'Discipline:' at xmin.rtogCE  ymax+0.2 width 5
      option    .filterStatus     anchor t+l tagwid 5 'Status:'     at xmax+3 width 4
      option    .filterValid      anchor t+l tagwid 4 'Valid:'      at xmax+3 width 9

      paragraph .displayLabel     at xmin_filterDiscipline  ymax+0.2 text 'Display:' width 6
      toggle    .invalidToggle    tagwid 10 'Invalid'               at xmax+1 ymin
      toggle    .panelToggle      tagwid 10 'Outfitting Panels'     at xmax+1 ymin
      toggle    .hPlateToggle     tagwid 10 'Hull Plates'           at xmax+1 ymin
--      button    .filterButton linkLabel 'Apply filter'              at xmax+2 ymin width 6

      paragraph .progressMessage  anchor t+l+r  at xmin.displayLabel ymax+0.5 width 50 lines 1

    exit

    frame .headingFrame |Report Headings| anchor t+l+r at xmin.filterFrame ymax.filterFrame+0.5 width 62

      path down
      frame .holeFrame |Hole| anchor T+B+L width 20 height 11
        toggle    .headDiscipline  tagwid 10 'Discipline'
        toggle    .headStatus      tagwid 10 'Status'
        toggle    .headValid       tagwid 10 'Valid'
        toggle    .headHoleType    tagwid 10 'Hole Type'
        toggle    .headSize        tagwid 10 'Hole Size'
        toggle    .headPosition    tagwid 10 'Position'
        toggle    .headUser        tagwid 10 'User'
        toggle    .headDate        tagwid 10 'Date'
      exit
      frame .penetratedframe |Penetrated|   at xmax.holeFrame+1 ymin.holeFrame anchor T+B+L+R width 20 height 11
        toggle    .headBlock       tagwid 10 'Block/Site'
        toggle    .headPenetrated  tagwid 10 'Penetrated Item'
        toggle    .headThickness   tagwid 10 'Thickness'
        toggle    .headQuality     tagwid 10 'Quality'
      exit
      frame .penetratingFrame |Penetrating| at xmax.penetratedframe+1 ymin.holeFrame anchor T+B+R width 18 height 11
        toggle    .headPenetrating tagwid 10 'Penetrating Item'
        toggle    .headBranch      tagwid 10 'Branch Name'
        toggle    .headSite        tagwid 10 'Penetrating Site'
        toggle    .headBore        tagwid 10 'Size'
        toggle    .headRating      tagwid 10 'Rating'
        toggle    .headSystem      tagwid 10 'System'
      exit
      button      .btnAllHeading   linkLabel 'Select All Headings'  at xmin.holeFrame ymax.holeFrame+0.5
      button      .btnClearHeading linkLabel 'Clear Headings'       at xmax+2 ymin

    exit

    button    .btnPreview 'Run Report' at xmin ymax+0.5

  exit

  frame .previewFrame panel at x0 y0 anchor all
    frame .assocsFrame |Hole Associations| at x0 y0 anchor all  width 64 height 16
      container .netAssocFrame nobox PmlNetControl |Associations| dock fill width 62 height 16
    exit
    paragraph .backIcon             anchor b + left   at xmin ymax+1  pixmap width 16 height 16
    button    .btnBack   linkLabel  'Back'            at xmax+1 ymin  anchor b+l
    button    .btnExport linkLabel  'Export to Excel' at xmax+4 ymin  anchor b+l
    button    .btnPrint  linkLabel  'Print Preview'   at xmax+4 ymin  anchor b+l
  exit

  -- Line added to allow scrolling when the form is re-sized smaller
  line .expandLine  at x0 y0 horizontal width 62

  --line to force scrollbars if resized too small
--  line .scrollLine    at x65      y20    horiz  width 0.1 heigh 0.1

  -- Form members
  -- Hole Association Manager Panel
  member .assocMemGrid        is NETGRIDCONTROL
  member .assocs              is ARRAY
  member .assoc               is DBREF
  -- Current headings list
  member .headings            is ARRAY
  -- current report data
  member .holeData            is ARRAY
  -- Hole Manager Panel
  member .listHeadings        is ARRAY
  -- Marine or plant project
  member .marine              is BOOLEAN
  --which filter is selected. FALSE = all
  member .filterModeSelected  is REAL
  -- aid number for aid graphics
  member .aidAxes             is REAL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      hmReport
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmReport()

  if( !!isThisHmProj().not() ) then
    return
  endif

  !mm = object AVEVAMODULEMANAGER()
  !this.marine                 = !mm.currentProductName().upcase().eq('HULL & OUTFITTING')
  if (!this.marine) then
--    import 'marAPI'
--    handle any
--    endhandle
    !this.panelToggle.visible  = true
    !this.panelToggle.val      = true
    !this.hPlateToggle.visible = true
  else
    -- no need to select type of structure in PDMS
    !this.panelToggle.visible  = false
    !this.hPlateToggle.visible = false
  endif

  -- pop-up menus
  !assocPopupNavigate = !this.newMenu('assocPopupNavigate')
  !assocPopupNavigate.add( 'CALLBACK', 'Association', '!this.navAssoc()' )
  !assocPopupNavigate.add( 'CALLBACK', 'Penetrated Item', '!this.navAssocItem1()' , 'navAssoc1' )
  !assocPopupNavigate.add( 'CALLBACK', 'Penetrating Item', '!this.navAssocItem2()' , 'navAssoc2' )
  !assocPopup = !this.newMenu('popupHMReport')
  !assocPopup.add( 'MENU', 'Navigate To', 'assocPopupNavigate' )
  !assocPopup.add( 'CALLBACK', 'Add to 3D view','!this.updateGraphics(!this.collectDrawlistItems(!this.assocMemGrid.getSelectedRows()),|ADD|)')
  !assocPopup.add( 'CALLBACK', 'Remove from 3D view','!this.updateGraphics(!this.collectDrawlistItems(!this.assocMemGrid.getSelectedRows()),|REM|)')
  !assocPopup.add( 'CALLBACK', 'Focus on Hole','!this.focusOnHole(!this.assocMemGrid.getSelectedRows())' , 'focus')
  !assocPopup.add( 'SEPARATOR')
  !assocPopup.add( 'CALLBACK', 'Export list to Excel', |!this.saveToXLS()| )
  !assocPopup.add( 'CALLBACK', 'Print list',|!this.printList()| )
  !this.netAssocFrame.popup = !assocPopup

  -- Set "Back" icon to swap pages
  !backIcon        = !!pml.getpathname('back.png')
  !this.backIcon.addpixmap(!backIcon)

  -- Enable scrollbars
  !this.autoscroll = TRUE

   -- Load configuration settings
  !this.readConfigurationFile()
  handle any
    -- handle error so that constructor completes even if config file is bad
    !!alert.error(!!error.text)
  endhandle

  -- Panel Initialisation
  !this.initialiseReportGadgets()
  !this.filterChanged(FALSE)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialiseReportGadgets
--
-- Description: Initialise Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseReportGadgets()

  using namespace 'Aveva.Pdms.Presentation'

  -- Add instances of .Net control
  !this.assocMemGrid          = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netAssocFrame.control = !this.assocMemGrid.handle()

  !this.assocMemGrid.addeventhandler('OnPopup', !this, 'assocRightClick')

  -- Define titles and initialisation call
  !this.formtitle                 = 'Managed Hole Reports'
  !this.icontitle                 = 'HMREP'

  -- set up callbacks
  !this.initcall                  = |!this.initialise()|

  !this.rtogCE.callback           = |!this.filterChanged(FALSE)|
  !this.rtogList.callback         = |!this.filterChanged(FALSE)|
  !this.rtogAll.callback          = |!this.filterChanged(FALSE)|
--  !this.filterButton.callback     = |!this.applyFilter()|
  !this.btnPreview.callback       = |!this.preview()|
  !this.btnBack.callback          = |!this.back()|
  !this.btnExport.callback        = |!this.saveToXLS()|
  !this.btnPrint.callback         = |!this.printList()|
  !this.btnAllHeading.callback    = |!this.setHeadings(true)|
  !this.btnClearHeading.callback  = |!this.setHeadings(false)|

  !this.filterDiscipline.setToolTip('Filter by Discipline')
  !this.filterStatus.setToolTip('Filter by Status')
  !this.filterValid.setToolTip('Filter by Association Validity. Note that the filtering process will take longer with this option enabled')

    -- Set parameters
  !this.assocMemGrid.columnExcelFilter(FALSE)
  !this.assocMemGrid.outlookGroupStyle(TRUE)
  !this.assocMemGrid.fixedHeaders(TRUE)
  !this.assocMemGrid.fixedRows(FALSE)
  !this.assocMemGrid.columnSummaries(FALSE)
  !this.assocMemGrid.editableGrid(FALSE)
  !this.assocMemGrid.singleRowSelection(FALSE)
  !this.assocMemGrid.setalternaterowcolor('lightgray')
  !dtext = ARRAY()

  -- initialise disciplines
  !dtext.clear()
  !dtext.append('All')
  !dtext.append('Piping')
  !dtext.append('Cableway')
  !dtext.append('Equipment')
  !dtext.append('HVAC')
  !dtext.append('Structural')
  !dtext.append('Other')
  !this.filterDiscipline.dtext = !dtext
  !rtext = ARRAY()
  !rtext.append('All')
  !rtext.append('PIPE')
  !rtext.append('CWAY')
  !rtext.append('EQUI')
  !rtext.append('DUCT')
  !rtext.append('STRU')
  !rtext.append('GEN')
  !this.filterDiscipline.rtext = !rtext

  -- initialise status
  !dtext.clear()
  !dtext.append('All')
  !dtext.append('Unset')
  !dtext.append('Requested')
  !dtext.append('Approved')
  !dtext.append('Redundant')
  !dtext.append('Rejected')
  !dtext.append('Withdrawn')
  !dtext.append('Not Approved')
  !this.filterStatus.dtext = !dtext
  !rtext.clear()
  !rtext.append('All')
  !rtext.append('Unset')
  !rtext.append('REQU')
  !rtext.append('APPR')
  !rtext.append('REDU')
  !rtext.append('REJE')
  !rtext.append('WITH')
  !rtext.append('NAPP')
  !this.filterStatus.rtext = !rtext

  -- initialise validity check
  !dtext.clear()
  !dtext.append('Not Checked')
  !dtext.append('All')
  !dtext.append('Passed')
  !dtext.append('Failed')
  !this.filterValid.dtext  = !dtext

  -- Setup controls for PML containers
  !this.filterModeSelected = 1
  !this.rtogCE.val         = true
  !this.rtogList.val       = false
  !this.rtogAll.val        = false
  !this.filterFrame.val    = 1

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Handle form shown event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.back()

endmethod

------------------------------------------------------------------------
--
-- Method:      filterChanged
--
-- Description: rtoggle buttons have been clicked. Optionally apply filter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true to do filtered search
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .filterChanged(!update is BOOLEAN)

  if (!this.rtogCE.val) then
  	!this.filterModeSelected   = 1
    !this.panelToggle.active   = false
    !this.hPlateToggle.active  = false
    !this.invalidToggle.active = false
  elseif (!this.rtogList.val) then
  	!this.filterModeSelected   = 2
    !this.panelToggle.active   = true
    !this.hPlateToggle.active  = true
    !this.invalidToggle.active = true
  else
  	!this.filterModeSelected   = 3
    !this.panelToggle.active   = true
    !this.hPlateToggle.active  = true
    !this.invalidToggle.active = true
  endif

  if (!update) then
    !this.applyFilter()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Show preview pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .preview()

  !this.applyFilter()
  !this.holeAssocPane.visible = false
  !this.previewFrame.visible  = true
  -- update the report
  !this.updateReportGrid()

endmethod

------------------------------------------------------------------------
--
-- Method:      back
--
-- Description: return from preview page to report page
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .back()

  !this.holeAssocPane.visible = true
  !this.previewFrame.visible  = false

endmethod

------------------------------------------------------------------------
--
-- Method:      getHoleData
--
-- Description: Get hole data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getHoleData()

  -- hole
  !headDiscipline  = !this.headDiscipline.val
  !headStatus      = !this.headStatus.val
  !headValid       = !this.headValid.val
  !headHoleType    = !this.headHoleType.val
  !headSize        = !this.headSize.val
  !headPosition    = !this.headPosition.val
  !headUser        = !this.headUser.val
  !headDate        = !this.headDate.val

      -- penetrated
  !headBlock       = !this.headBlock.val
  !headPenetrated  = !this.headPenetrated.val
  !headThickness   = !this.headThickness.val
  !headQuality     = !this.headQuality.val

      -- penetrating
  !headPenetrating = !this.headPenetrating.val
  !headBranch      = !this.headBranch.val
  !headSite        = !this.headSite.val
  !headBore        = !this.headBore.val
  !headRating      = !this.headRating.val
  !headSystem      = !this.headSystem.val

  -- get validity test filter and set progress message accordingly
  !filterValid     = !this.filterValid.selection()
  if (!filterValid eq 'Not Checked') then
    !progressMessage = 'Finding managed holes. Please wait...'
  else
    !progressMessage = 'Finding holes and running validation tests. Please wait...'
  endif
  !this.progressMessage.val = !progressMessage
  !this.progressMessage.refresh()

  -- Clear any existing data
  !this.assocMemGrid.clearGrid()
  !this.assocs.clear()

  !allAssoc         = ARRAY()
  !selection        = !this.filterModeSelected
  !filterDiscipline = !this.filterDiscipline.selection()
  !filterStatus     = !this.filterStatus.selection()
  if (!filterStatus eq 'Unset') then
    !filterStatus   = ''	
  endif
  !current          = !!ce
  -- if current element is selected then
  -- for each element get a list of ancestors. Check remaining element list
  -- and only add element to list if none of its ancestors are present.
  -- If All Managed Holes is selected or current element is world then just add
  -- world to the list of elements to check
  !elementList      = ARRAY()
  if (!selection eq 1 and !current.name neq '/*') then
    -- current element
  	!elementList[1] = !!ce
  elseif (!selection eq 2  ) then
  	-- graphical selection
  	!elementList    = !this.getCurrentSelection()
  	-- use CE if no graphical selection
  	if( !elementList.empty() ) then
      if (!!ce.name neq '/*') then
  	    !elementList[1] = !!ce
  	  endif
  	endif
    	    	
  endif

  -- search for selected holes
  if (!elementList.empty()) then
    -- No selection - Collect all associations
    !allAssoc = !this.getAllHoles()
 	else
    -- get holes for selection
    !allAssoc = ARRAY()
    do !element values !elementList
      if (!element.name EQ '/*') then
        !allAssoc = !this.getAllHoles()
        break
      elseif (!element.hardType inset ('ASSOGP','ASSOWL')) then
        -- special for if located at ASSOGP
        !allAssoc.appendArray(!!collectAllFor('ASSOC', |PURP OF OWNER EQ 'HOLE'|, !element))
      else
        !allAssoc = !this.getHolesFor(!element)
      endif
    enddo
  endif
  !allAssoc.unique()

  -- Array to hold PANELS/HPLATES with Holes
  !this.assocs = ARRAY()
  !assocInfo   = ARRAY()

  -- initialise progress bar feedback
  !showProgress        = FALSE
  !progressMax         = !allAssoc.size()
  if (!filterValid neq 'Not Checked' or !allAssoc.size() gt 20) then
    --initialise progress bar
    if (!progressMax le 0) then
      !progressMax     = 1
    endif
    !progressIncrement = 100 / !progressMax
    !progress          = 0
    !this.showProgress(0)
    !showProgress      = TRUE
  endif

  -- Loop round all associations applying filters and recording output
  !count = 0
  do !association values !allAssoc

    ----------------
    -- apply filters
    ----------------
    !hole             = object HMHOLE(!association)
    !penetrated       = !hole.getHoleOwner()
    !penetratingAssoc = !hole.getPrimaryElement()
    if( badref(!penetratingAssoc) ) then
      -- primary ASSOC is bad
      !penetrating    = object DBREF()
    else
      !penetrating    = !penetratingAssoc.amemrf
    endif
    if( badref(!penetrated) or badref(!penetrating) ) then
      -- if hole owner element missing - add to invalid
      skip if (!this.invalidToggle.val.not())
    else
      !continue = false
      if (!this.panelToggle.val) then
        if (!penetrated.hardType inset('PANE','CTWALL','SCTN','GENSEC','BPANEL')) then
          !continue = true
        endif
      endif
      if (!this.hPlateToggle.val and !continue.not()) then
        skip if (not !penetrated.type inset('HPLATE','CPLATE','HPANEL','CPANEL'))
      endif
    endif
    -- filter on discipline
    !discipline = !hole.holeType
    if( !filterDiscipline neq 'All' ) then
      if( !filterDiscipline eq 'GEN' ) then
        skip if(not !discipline inset ('GEN', 'FITT'))
      else
        skip if(!filterDiscipline neq !discipline)
      endif
    endif
    -- filter on status
    !status  = !hole.status
    if( !filterStatus neq 'All' ) then
      if( !filterStatus eq 'NAPP' ) then
        -- not approved
        skip if(!status eq 'APPR')
      else
        skip if(!filterStatus neq !status)
      endif
    endif
    -- filter on valid
    !valid = 'Not Checked'
    if (!filterValid neq 'Not Checked') then
      -- only do validation tests last and if absolutely needed as they take a long time
      !valid = !this.testEval(!association.string())
      if( !filterValid neq 'All' ) then
        skip if(!filterValid neq !valid)
      endif
    endif

    --------------------
    -- get report output
    --------------------
    !info= ARRAY()
    -- always have hole name
    !info.append(!association.fullname)
    if( !headDiscipline ) then
      !info.append(!discipline)
    endif
    if( !headStatus ) then
      !info.append(!hole.getFullStatus())
    endif
    if( !headValid ) then
      !info.append(!valid)
    endif
    -- find out the assmbr elements
    if (badref(!penetrated)) then
      !penetratedName = 'Invalid'
      -- and for top level owner
      !blockName      = 'Invalid'
      -- thickness unset
      !plateThickness = '--'
      -- quality unset
      !plateQuality   = '--'
    else
      !penetratedName = !penetrated.fullname
      !ownerList      = !penetrated.ownlst
      -- add top level element below world
      !blockName      = !ownerList[1].fullname
      -- thickness
      !plateThickness = !hole.plateThickness.string(!!distanceFmt)
      -- Quality (Hull only)
      !plateQuality   = !hole.hullPlate.quaTxt
      handle any
        !plateQuality = '--'
      endhandle
    endif
    if( !headBlock ) then
      !info.append(!blockName)
    endif
    if( !headPenetrated ) then
      !info.append(!penetratedName)
    endif
    if( !headThickness ) then
      !info.append(!plateThickness)
    endif
    if( !headQuality ) then
      !info.append(!plateQuality)
    endif
    if( !headPenetrating ) then
      if (badref(!penetrating)) then
        !info.append('Invalid')
      else
        !info.append(!penetrating.owner.fullname)
      endif
    endif
    if( !headBranch ) then
      if (badref(!penetrating)) then
        !info.append('Invalid')
      else
        !info.append(!penetrating.fullname)
      endif
    endif
    if( !headSite ) then
      if (badref(!penetrating)) then
        !info.append('Invalid')
      else
        !ownerTypes      = ARRAY()
        !ownerTypes[1]   = 'SITE'
        !penetratingSite =!!dtbOwnerOfTypes(!penetrating,!ownerTypes)
        if( !penetratingSite.set() ) then
          !info.append(!penetratingSite.fullname)
        else
          !info.append('Invalid')
        endif
      endif
    endif
    if( !headHoleType ) then
      !info.append(!hole.getType())
    endif
    if( !headSize ) then
      !info.append(!hole.getDesp())
    endif
    if( !headBore ) then
      if( !discipline eq 'PIPE' ) then
        !info.append(!hole.getNomBore())
      elseif( !discipline eq 'DUCT' ) then
        !hvacSize = '--'
        -- find penetrating ATTA and get duct size from DUCT property that should be present
        !secondaryElements = !hole.getSecondaryElements()
        do !secondaryItem values !secondaryElements
          skip if( badref(!secondaryItem.amemrf) )
          skip if( !secondaryItem.amemrf.type neq 'ATTA' )
          !hvacSize = !secondaryItem.amemrf.prop.attribute('DUCT')
          handle any
            !hvacSize = '--'
            break
          endhandle
          break
        enddo
        !info.append(!hvacSize)
      else
        !info.append('--')
      endif
    endif
    if( !headRating ) then
      if( !discipline eq 'PIPE' ) then
        !info.append(!hole.getRating())
      else
        !info.append('--')
      endif
    endif
    if( !headSystem ) then
      if( badref(!penetrating.primsy) ) then
        !info.append('--')
      else
        !info.append(!penetrating.primsy.fullname)
      endif
    endif
    if(!headPosition ) then
      -- hole position with offset
      !pos = !hole.getVirtualHole().position
      handle any
        !pos = object POSITION()
      endhandle
      if (!pos.unset() ) then
        if( !this.marine ) then
          !info.append('unset')
        endif
        !info.append('unset')
      else
        if( !this.marine ) then
          !refGridObject  = object REFGRID()
          !unusedRefGrid  = !refGridObject.gridSy
          handle any
            !info.append('unset')
          elsehandle none
            !shipGrid = object SHIPGRIDPOSITION(!pos, !refGridObject)
            if( !shipGrid.xOffset lt 0 ) then
              !sign   = '-'
            else
              !sign   = '+'
            endif
            !shipX    = !shipGrid.xPrefix + !shipGrid.xGridLine.string() + !sign + !shipGrid.xOffset.abs().string(!!distanceFmt)
            if( !shipGrid.yOffset lt 0 ) then
              !sign   = '-'
            else
              !sign   = '+'
            endif
            !shipY    = !shipGrid.yPrefix + !shipGrid.yGridLine.string() + !sign + !shipGrid.yOffset.abs().string(!!distanceFmt)
            if( !shipGrid.zOffset lt 0 ) then
              !sign   = '-'
            else
              !sign   = '+'
            endif
            !shipZ    = !shipGrid.zPrefix + !shipGrid.zGridLine.string() + !sign + !shipGrid.zOffset.abs().string(!!distanceFmt)
            !info.append( !shipX + ' ' + !shipY + ' ' + !shipZ )
          endhandle
        endif
        if( !this.marine ) then
          -- have to avoid core bug in FORMAT object when in COORD XYZ - shows position with ENU coordinates
          !worldPos       = !pos.wrt(WORLD)
          !positionString = 'X' + !worldPos.east.string(!!distanceFmt) + ' Y' + !worldPos.north.string(!!distanceFmt) + ' Z' + !worldPos.up.string(!!distanceFmt)
          !info.append(!positionString)
        else
          !info.append(!pos.wrt(WORLD).string(!!distanceFmt).before('WRT'))
        endif
      endif
    endif

    if( !headUser or !headDate ) then
      !statusHistory = !hole.getStatusHistory()
      if (!statusHistory.size().gt(0) ) then
        !lastStatus = !statusHistory.last().split('|')
      else
        !lastStatus    = ARRAY()
        !lastStatus[1] = '--'
        !lastStatus[2] = '--'
      endif
      !holeDate = !lastStatus[1]
      !holeUser = !lastStatus[2]
      if( !headUser ) then
        !info.append(!holeUser)
      endif
      if( !headDate ) then
        if( !holeDate neq '--' ) then
          !year     = !holeDate.substring(1,4)
          !month    = !holeDate.substring(5,2)
          !day      = !holeDate.substring(7,2)
          !hour     = !holeDate.substring(9,2)
          !minute   = !holeDate.substring(11,2)
          !dateTime = object DATETIME(!year.real(),!month.real(),!day.real(),!hour.real(),!minute.real())
          handle any
            !info.append('--')
          elsehandle none
            !info.append(!dateTime.string())
          endhandle
        else
          !info.append('--')
        endif
      endif
    endif

    -- add to table
    !this.assocs.append(!association)
    !assocInfo.append(!info)

    -- update progress
    if (!showProgress) then
      !progress = !progress + !progressIncrement
      !this.showProgress(!progress)
      !count    = !count + 1
      !this.progressMessage.val = '[' + !count.string() + ' of ' + !progressMax.string() + '] ' + !progressMessage
      !this.progressMessage.refresh()
    endif

  enddo

  !this.headings = !this.getReportHeadings()
  !this.holeData = !assocInfo

  -- search complete - clear progress feedback
  !this.showProgress(0)
  !this.progressMessage.val = 'Report contains ' + !assocInfo.size().string() + ' managed holes'
  !this.progressMessage.refresh()

endmethod

------------------------------------------------------------------------
--
-- Method:      getReportHeadings
--
-- Description: Update report grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Headings for this report
--
------------------------------------------------------------------------
define method .getReportHeadings() is ARRAY

  !headings    = ARRAY()
  -- initialise headings for the report
  !headings[1] = 'Hole Name'
  if( !this.headDiscipline.val ) then
    !headings.append('Discipline')
  endif
  if( !this.headStatus.val ) then
    !headings.append('Status')
  endif
  if( !this.headValid.val ) then
    !headings.append('Valid')
  endif
 if( !this.headBlock.val ) then
    if( !this.marine ) then
      !headings.append('Block/Site')
    else
      !headings.append('Site')
    endif
  endif
  if( !this.headPenetrated.val ) then
    !headings.append('Penetrated Item')
  endif
  if( !this.headThickness.val ) then
    !headings.append('Thickness')
  endif
  if( !this.headQuality.val ) then
    !headings.append('Quality')
  endif
  if( !this.headPenetrating.val ) then
    !headings.append('Penetrating Item')
  endif
  if( !this.headBranch.val ) then
    !headings.append('Branch Name')
  endif
  if( !this.headSite.val ) then
    !headings.append('Penetrating Site')
  endif
  if( !this.headHoleType.val ) then
    !headings.append('Hole Type')
  endif
  if( !this.headSize.val ) then
    !headings.append('Hole Size')
  endif
  if( !this.headBore.val ) then
    !headings.append('Size')
  endif
  if( !this.headRating.val ) then
    !headings.append('Rating')
  endif
  if( !this.headSystem.val ) then
    !headings.append('System')
  endif
  if( !this.headPosition.val ) then
    if( !this.marine ) then
      !headings.append('Ship Position')
    endif
    !headings.append('Position')
  endif
  if( !this.headUser.val ) then
    !headings.append('User')
  endif
  if( !this.headDate.val ) then
    !headings.append('Date')
  endif

  return !headings

endmethod

------------------------------------------------------------------------
--
-- Method:      updateReportGrid
--
-- Description: Update report grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateReportGrid()

  using namespace  'Aveva.Pdms.Presentation'

  !nds = object NETDATASOURCE('Associations', !this.headings, !this.holeData )
  !this.assocMemGrid.bindToDataSource(!nds)

  !this.highlightAssocMemGrid()

  --Select first row
  !this.assocMemGrid.selectRow(1)

endmethod

------------------------------------------------------------------------
--
-- Method:      assocRightClick
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assocRightClick(!data is ARRAY)

  if (!this.assocMemGrid.getSelectedRows().size() eq 1 ) then
    !row = !this.assocMemGrid.getSelectedRows()[1]
    !assoc = !row[1].dbref()
    !hmHole = object HMHOLE(!assoc)
    !allowAddPen = FALSE
    if (!hmHole.holeOwner.badref().not()) then
      if (!hmHole.holeOwner.type inset('CPLATE', 'HPANEL', 'HPLATE')) then
    	  !allowAddPen = TRUE
      endif
    endif
    !hmHole.delete()

    !this.netAssocFrame.popup.setFieldProperty('focus','VISIBLE',TRUE)
  else
    !this.netAssocFrame.popup.setFieldProperty('focus','VISIBLE',FALSE)
  endif

  !this.netAssocFrame.showPopup(!data[0], !data[1])
  !this.assoc = !this.assocs[!data[2][1].real()]

endmethod

