--
--  Description:     Form to deal with selection of elements for adding to HM system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  AddToHM()                        -                   Carry out actions needed to add selected items as new entry in HM system
--  AddToView()                      -                   Add selected item to the graphical display
--  GenerateDisplayData(ARRAY)       ARRAY               Generate the data array for the DTEXT to be displayed
--  HMselect()                       -                   Constructor
--  Initialise()                     -                   Initialise the form each time its displayed
--  LoadFromHole(HMHOLE)             -                   Preload the displayed grid with members from passed HMHOLE object
--  PickElements()                   -                   Graphically pick elements for inclusion on the form
--  RemoveFromList()                 -                   Remove selected item from the displayed list
--  ReplaceWithOwner()               -                   Replace the selected entry with the owning item
--  UpdateDisplayedList(ARRAY)       -                   Update the displayed data with the supplied array
--
------------------------------------------------------------------------
-- Form:      HMselect
------------------------------------------------------------------------

--- form definition
setup form !!HMselect dialog docking size 30 12

-- Define titles and initialisation call
  !this.formTitle = 'Hole Management - Select items'
  !this.iconTitle = 'Hole Management'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path down
  vdist 0.5

  button .btnPick        ' Select Items '                                    callback |!this.pickelements()|

-- Framing for gadget showing all HOLES selected
  frame .frmSelectedHoles FOLDUP 'Selected elements' at xmin form ymax + 0.5 width 32 height 8
    path down
     list .lstSelected zeroSel noReselect width 32 length 8 tooltip 'List of selected model items'
  exit

  path down
  button .btnOK      'Update Hole Management'   callback |!this.AddToHM()| at xmin form + 1 ymax + 0.5
  path right
  hdist 2
  button .btnCANCEL  'Cancel'  CANCEL


-- define PML popup menu
  menu .mnuPopup popup
  !this.mnuPopup.add( 'CALLBACK', 'Add to 3D view','!this.addToView()' )
  !this.mnuPopup.add( 'CALLBACK', 'Replace with owner','!this.replaceWithOwner()' )
  !this.mnuPopup.add( 'CALLBACK', 'Remove from list','!this.removeFromList()')

-- End of FORM definition

  member .Headings      is ARRAY
  member .ClearOnSelect is BOOLEAN
exit

------------------------------------------------------------------------
-- Method:      HMselect
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .HMselect()

  !this.lstSelected.setpopup(!this.mnupopup)

  !this.Headings.append('TYPE')
  !this.Headings.append('NAME')
  !this.Headings.append('OWNER')


endmethod
-- End of method HMselect()


------------------------------------------------------------------------
-- Method:      Initialise
--
-- Description: Initialise form settings each time it is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Initialise()

  !this.autoscroll = true
  !this.lstSelected.clear()

  !this.ClearOnSelect = TRUE
endmethod
-- End of method Initialise()


------------------------------------------------------------------------
-- Method:      LoadFromHole()
--
-- Description: Preload the displayed grid with members from passed HMHOLE object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .LoadFromHole(!myHole is HMHOLE)

  !this.ClearOnSelect = FALSE

  !elems = object ARRAY()
  !elems.append(!myHole.PrimaryElement)
  !elems.appendarray(!myHole.SecondaryElements)

  !items = object ARRAY()
  do !idx index !elems
    !items.append( !elems[$!idx].amemrf )
  enddo
  !displayData = !this.GenerateDisplayData(!items)

  !this.UpdateDisplayedList(!displayData)
endmethod
-- End of method LoadFromHole()


------------------------------------------------------------------------
-- Method:      PickElements
--
-- Description: Graphically pick elements for inclusion on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .PickElements()

--   !!hmMain.EdgCallback()
   !selected = array()
   do
     id EQUI BRAN PANE SCTN @
     handle (61,528)
       break
     endhandle
     !selected.append(!!ce)
   enddo
   !selected.Unique()

-- Generate the array of data for DTEXT
   !rowdata = !this.GenerateDisplayData(!selected)

-- Clear displayed list before update if not based on HMHOLE data
   if (!this.ClearOnSelect) then
     !this.lstSelected.clear()
   endif

-- Update the displayed data
   !this.UpdateDisplayedList(!rowdata)

 endmethod
-- End of method PickElements()


------------------------------------------------------------------------
-- Method:      AddToView
--
-- Description: Add selected item to the graphical display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .AddToView()

  !elem = !this.lstSelected.rtext[!this.lstSelected.pickedfield].split()[2].dbref()
  ADD $!elem
  handle any
    !!alert.error(|Error adding | + !elem.type + | | + !elem.name + | - | + !!ERROR.TEXT)
  endhandle

endmethod
-- End of method AddToView()


------------------------------------------------------------------------
-- Method:      RemoveFromList
--
-- Description: Remove selected item from the displayed list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .RemoveFromList()

  !oldListDT = !this.lstSelected.dtext
  !oldListRT = !this.lstSelected.rtext

  !oldListDT[!this.lstSelected.pickedfield].delete()
  !oldListRT[!this.lstSelected.pickedfield].delete()

  !this.lstselected.clear()
  do !loop index !oldListDT
    !this.lstSelected.add(!oldListDT[$!loop], !oldListRT[$!loop])
  enddo

endmethod
-- End of method RemoveFromList()



------------------------------------------------------------------------
-- Method:      ReplaceWithOwner
--
-- Description: Replace the selected entry with the owning item
--              NOTE:
--              Need to add a check in case owner applies to more than one item in list
--              e.g. 2 branches listed but one selected for "replace with owner"
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ReplaceWithOwner()

  !oldListDT = !this.lstSelected.dtext
  !oldListRT = !this.lstSelected.rtext

  !choice = !this.lstSelected.pickedfield

  !this.lstselected.clear()
  !Elements = array()
  do !loop index !oldListDT
    !rowdata = ARRAY()
    if (!loop.eq(!choice) ) then
      !rowdata[1] = !oldListRT[$!loop].dbref().owner.type
      !rowdata[2] = !oldListRT[$!loop].dbref().owner.name
      !rowdata[3] = !oldListRT[$!loop].dbref().owner.owner.name
    else
      !rowdata[1] = !oldListRT[$!loop].split()[1]
      !rowdata[2] = !oldListRT[$!loop].split()[2]
      !rowdata[3] = !oldListRT[$!loop].split()[3]
    endif

-- Check that owner of this item is not already listed as main element
    !myOwner = !oldListRT[$!loop].dbref().owner.name
    !found = FALSE
    do !test values !Elements
      if (!test[2].eq(!myOwner)) then
        !found = TRUE
        break
      endif
    enddo

-- Check that this item is not already listed as owner of earlier element
    !myName = !oldListRT[$!loop].dbref().owner.name
    !scan = !Elements
    do !idx index !scan
      if (!scan[$!idx][3].eq(!myName)) then
        !Elements[$!idx].delete()
      endif
    enddo

    if (NOT !found) then
      !Elements.append(!rowdata)
    endif
  enddo

  !this.lstSelected.SetRows(!Elements)

endmethod
-- End of method ReplaceWithOwner()


------------------------------------------------------------------------
-- Method:      AddToHM
--
-- Description: Carry out actions needed to add selected items as new entry in HM system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .AddToHM()

  !elements = !this.lstSelected.rtext
  !elemlist = array()
  do !data values !elements
    !type = !data.split()[1]
    !name = !data.split()[2]
    !elemlist.append( !name.dbref() )
  enddo

  !hmcont = object HMControl()
  if (NOT  !hmcont.CreateVirtualHole(!elemlist) ) then
    !!alert.error(!!error.text)
  else
    !this.lstselected.clear()
  endif

endmethod
-- End of method AddToHM()


------------------------------------------------------------------------
-- Method:      GenerateDisplayData
--
-- Description: Generate the data array for the DTEXT to be displayed
--              using the supplied array of DBREF items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateDisplayData(!arrSelected is ARRAY) is ARRAY

  !arrReturn = object ARRAY()

-- Generate array of Row Data for display in the grid
  do !item values !arrSelected
    !rowdata = ARRAY()
    !rowdata[1] = !item.type
    !rowdata[2] = !item.name
    !rowdata[3] = !item.owner.name
    !arrReturn.append(!rowdata)
  enddo

  return !arrReturn

endmethod
-- End of method GenerateDisplayData()


------------------------------------------------------------------------
-- Method:      UpdateDisplayedList
--
-- Description: Update the displayed data with the supplied array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateDisplayedList(!arrData is ARRAY)

   !this.lstSelected.SetHeadings(!this.Headings)
   !this.lstSelected.SetRows(!arrData)

endmethod
-- End of method UpdateDisplayedList()
