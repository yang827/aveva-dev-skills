     -- Conform the user wants to proceed with status change
    !answer = !!alert.confirm('Do you really want to change the status to REDUNDANT?')
    if(!answer.eq('YES')) then
       !hmControl = object HMCONTROL()

       -- Work on each HOLE selected
       do !rowTag values !this.ngcHoleList.getSelectedRowTags()
         !row = !this.ngcHoleList.getRow( !rowTag.real() )
         !hmHole = object HMHOLE( !row[1].dbref() )
         if ( !hmControl.redundantRequest(!hmHole) ) then
           if (!this.ngcHoleList.getColumnKey(3).eq('STATUS') ) then
             !this.updateGridCell(!rowTag.real(), 3, !hmHole.getFullStatus() )
           endif
         endif
       enddo
       -- Refresh Originator and Reviewer access of current hole
      !this.updateUserAccess(!hmHole)
      -- Update hole history
      !this.showHoleHistory()
    endif
  endif

endmethod
-- End of method definition for .redundantRequest()


------------------------------------------------------------------------
--
-- Method:      .cancelRequest()
--
-- Description: For each selected hole, revert status to unset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancelRequest()

  if (!this.gridSelectedCheck()) then
    -- Conform the user wants to proceed with status change
   !answer = !!alert.confirm('Do you really want to cancel the request?')
   if(!answer.eq('YES')) then
     !hmControl = object HMCONTROL()
     -- Work on each HOLE selected
     do !rowTag values !this.ngcHoleList.getSelectedRowTags()
       !row = !this.ngcHoleList.getRow( !rowTag.real() )
       !hmHole = object HMHOLE( !row[1].dbref() )
       if ( !hmControl.cancelRequest(!hmHole) ) then
         if (!this.ngcHoleList.getColumnKey(3).eq('STATUS') ) then
          !this.updateGridCell(!rowTag.real(), 3, !hmHole.getFullStatus() )
         endif
       endif
     enddo
     -- Refresh Originator and Reviewer access of current hole
    !this.updateUserAccess(!hmHole)
    -- Update hole history
    !this.showHoleHistory()
   endif
  endif

endmethod
-- End of method definition for .cancelRequest()


------------------------------------------------------------------------
--
-- Method:      .removeManagedHole()
--
-- Description: Remove an entry from the HM system (delete the ASSOC)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeManagedHole()


  if (!this.gridSelectedCheck()) then

    -- Prompt for confirmation (but return true to indicate correct operation of this method)
    !answ = !!alert.confirm('Remove selected managed hole - are you sure?')
    if ( NOT !answ.boolean() ) then
      return
    endif

    !hmControl = object HMCONTROL()
    -- Work on each HOLE selected
    !count = 1
    !gridData     = !this.ngcHoleList.getRows()
    !allHoles     = ARRAY()
    do !holeRow values !gridData
      !holeRef    = !holeRow[1].dbref()
      handle any
        skip
      endhandle
      !allHoles.append(!holeRef)
    enddo
    !selectedData = !this.ngcHoleList.getSelectedRowTags()
    !selectedRows = !this.ngcHoleList.getSelectedRows()
    !selectedHoles = ARRAY()

    do !index indices !selectedRows
      !selectedHoles[!index] = !selectedRows[!index][1].dbref()
    enddo

    if (!this.isGlobal) then
      !owners = ARRAY()
    endif

    -- delete selected holes
    !deletedHoles = ARRAY()
    do !hole values !selectedHoles
      !hmHole = object HMHOLE( !hole )
      !owner  = !hole.owner
      if (!hmControl.removeManagedHole(!hmHole)) then
        !rowNum = !selectedData[!count]
        !gridData[!rowNum.real()].delete()
        if (!this.isGlobal) then
          !owners.append(!owner)
        endif
        !deletedHoles.append(!hole)
      else
        !!alert.error('Cannot delete ' + !hole.fullname + ' because access to delete one or more hole elements is denied')
      endif
      !count = !count + 1
    enddo

    if (!this.isGlobal) then
      !owners.unique()
    endif

    -- If in global we need to issue the ASSOCGP of any deleted ASSOCS
    if (!this.isGlobal and !owners.empty().not()) then
      !answer = !!alert.confirm('You have deleted associations. Do you want to issue the deletions')
      if (!answer.boolean()) then
        !!runMacro('/%PDMSUI%/DES/GEN/MSAVEW','')
        do !group values !owners
          EXTRACT ISSUE $!<group> HIER
        enddo
      else
        !!alert.warning('To ensure other users see your deleted associations, the owning ASSOGP must be issued using the extract control form')
      endif
    endif

    if (!gridData.empty()) then
      !this.returnToAssocs()
    else
      -- update grid for the remaining holes
      !remainingHoles = !allHoles.difference(!deletedHoles)
      -- Hole deleted, reset grids and fields
      !this.ngcHoleData.clearGrid()
      !this.ngcValidation.clearGrid()
      !this.ngcHistory.clearGrid()
      !nullObject = object HMHOLE()
      !this.enableOriginator(FALSE, !nullObject )
      !this.enableReviewer(FALSE, !nullObject )
      !this.populateHoleList(!remainingHoles)
    endif

  endif

endmethod
-- End of method definition for .removeManagedHole()


------------------------------------------------------------------------
--
-- Method:      .approveRequest()
--
-- Description: For each selected hole, update status to be APPROVED
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .approveRequest()

  if (!this.gridSelectedCheck()) then
    !hmControl = object HMCONTROL()
     -- Conform the user wants to proceed with status change
    !answer = !!alert.confirm('Do you really want to change the status to APPROVED?')
    if(!answer.eq('YES')) then
      -- Work on each HOLE selected
      do !rowTag values !this.ngcHoleList.getSelectedRowTags()
        !row = !this.ngcHoleList.getRow( !rowTag.real() )
        !hmHole = object HMHOLE( !row[1].dbref() )
          if ( !hmControl.approveRequest(!hmHole) ) then
            if (!this.ngcHoleList.getColumnKey(3).eq('STATUS') ) then
              !this.updateGridCell(!rowTag.real(), 3, !hmHole.getFullStatus() )
            endif
          endif
      enddo
      -- Refresh Originator and Reviewer access of current hole
     !this.updateUserAccess(!hmHole)
     -- Update hole history
     !this.showHoleHistory()
     -- Update hole data
     !this.showSelectedHoleData()
   endif
  endif

endmethod
-- End of method definition for .approveRequest()


------------------------------------------------------------------------
--
-- Method:      .rejectRequest()
