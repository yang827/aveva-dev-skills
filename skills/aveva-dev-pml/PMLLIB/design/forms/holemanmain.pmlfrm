--
--
-- Description:
-- Manage Holes
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addElement()                     -                   add another element to be managed and update if asked
--  addPenetrated()                  -                   add another penetrated item
--  applyCellChanges(ARRAY)          -                   Check the changes made to editable cell and save if permitted
--  applyFilter()                    -                   filter the current association list
--  approveRedundantRequest()        -                   For each selected hole, update status following REDUNDANT request
--  approveRequest()                 -                   For each selected hole, update status to be APPROVED
--  assocRightClick(ARRAY)           -                   Right click options
--  cancelRequest()                  -                   For each selected hole, revert status to unset
--  cleanUp()                        -                   Form close callback
--  collectDrawlistItems(ARRAY)      ARRAY
--  displayResults()                 -                   display validation results in results window
--  drawAxes(DBREF,STRING)           -                   Draw aid lines showing axes for this penetration
--  edgPickPenetrated(STRING)        -                   Set EDG to pick penetrated items
--  enableOriginator(BOOLEAN,HMHOLE) -                   Switch Originator fields on/off
--  enableReviewer(BOOLEAN,HMHOLE)   -                   Switch Reviewer fields on/off
--  extraColumns(DBREF)              ARRAY               Process extra columns if specified in the configuration file
--  filterChanged(BOOLEAN)           -                   rtoggle buttons have been clicked
--  firstTaskPane(BOOLEAN)           -                   Setup Hole Manager Panel
--  fixHole()                        -                   Try to fix the hole
--  fixPenetrated()                  -                   Try to fix the penetrated item
--  focusOnHole(ARRAY)               -                   focus the current view on the hole
--  generateDisplayData(HMHOLE)      ARRAY               Generate array of column data to be displayed for the supplied HMHOLE element
--  getChanges()                     -                   if in global get all changes from others extracts
--  getHolesFor(DBREF)               ARRAY               Get holes for the given element
--  getSelectedHoleData()            ARRAY               Get selected hole data item
--  gridSelectedCheck()              BOOLEAN             Check whether any rows are currently selected on grid
--  highlightAssocMemGrid()          -                   highlight failed and invalid associations on the main grid
--  hmMain()                         -                   Constructor for Hole Management panel
--  holeAssocManager()               -                   Constructor for Hole Association Management panel
--  holeManMain()                    -                   Constructor
--  mainTasks(BOOLEAN)               -                   Setup Hole Association Manager Panel
--  modifyHole(ARRAY)                -                   Modify the selected hole
--  navAssoc()                       -                   Navigate to the association
--  navAssocItem1()                  -                   Navigate to the association member1
--  navAssocItem2()                  -                   Navigate to the association member2
--  navigateToHole()                 -                   Navigate to selected item in the hole list
--  navigateToHoleData()             -                   Navigate to selected hole data item
--  pickAddPenetrated(EDGPICKDATA)   -                   EDG callback for penetrated items pick
--  pickPenetrated(EDGPICKDATA)      -                   EDG callback for penetrated items pick
--  populateHoleList(ARRAY)          -                   Gather all Managed Holes for selected items and display in HOLELIST grid control
--  popupDataCallback(ARRAY)         -                   Set/Display the popup menu for the HOLEDATA Grid Control
--  popupHistCallback(ARRAY)         -                   Set/Display the popup menu for the Validation Results Grid Control
--  popupListCallback(ARRAY)         -                   Set/Display the popup menu for the HOLELIST Grid Control
--  popupValidCallback(ARRAY)        -                   Set/Display the popup menu for the Validation Results Grid Control
--  readConfigurationFile()          -                   Read system configuration file (if it exists) and store settings
--  redundantRequest()               -                   For each selected hole, update status to be REDUNDANT
--  rejectRequest()                  -                   For each selected hole, update status to be REJECTED
--  removeElement()                  -                   remove an element(s) from the list of elements to be managed
--  removeManagedHole()              -                   Remove an entry from the HM system (delete the ASSOC)
--  removePenetrated()               -                   Try to remove any additional penetrated objects from the association the no longer intersect the virtual hole
--  resetElements()                  -                   resets the list of elements to be managed to the CE
--  resetTranslucency()              -                   reset translucent panels to solid
--  returnToAssocs()                 -                   Show Hole Association Pane and refresh items in case any have been deleted
--  saveComment()                    -                   For every hole selected, update the COMMENT using form input
--  saveUnclaim(ARRAY)               -                   Savework and then unclaim the holes
--  selectElements(ARRAY)            -                   specify list of elements to be managed
--  selectedHoleAids()               -
--  selectedHoleChanged(ARRAY)       -                   Refresh hole data
--  selectedHoleMainAids()           -                   Refresh hole aids
--  selectedHoleMainChanged(ARRAY)   -                   Refresh hole data
--  setFilter(STRING,STRING,STRING,STRING,STRING) -                   specify list of elements to be managed
--  setPenetrated(BOOLEAN)           -                   Set to True if currently in a penetrated EDG pick cycle
--  showAssocs(GADGET,STRING)        -                   display association info
--  showHoleHistory()                -                   Show hole history
--  showPenetratedTranslucent()      -                   Make selected penetrated translucent
--  showProgress(REAL)               -                   Update progress bar
--  showSelectedHoleAids(DBREF)      -                   Show aid graphics for each of the selected Managed Holes
--  showSelectedHoleData()           -                   Show data for each of the selected Managed Holes
--  showValidationResults()          -                   Show validation results
--  submitRequest()                  -                   For each selected hole, update status to be REQUESTED
--  testEval(STRING)                 STRING              Perform test evaluation
--  updateAssocs()                   -                   update the current association list when
--  updateGraphics(ARRAY,STRING)     -                   Update graphical view to focus on specified items
--  updateGridCell(REAL,REAL,STRING) -                   Update a single grid cell (rather than refresh entire grid)
--  updateGridFull(ARRAY)            -                   Update the entire hole data grid using the supplied row data
--  updateSelectedList()             -                   Update the list of elements selected to be managed
--  updateUserAccess(HMHOLE)         -                   Check Originator and Reviewer access of currently selected hole
--  validateAssocs()                 -                   update the selected association list with the
--
------------------------------------------------------------------------


import 'pmlfilebrowser'
handle (1000,0)
endhandle


import 'GridControl'
handle (1000,0)
endhandle

!mm = object AVEVAMODULEMANAGER()
if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
  import 'marAPI'
  handle any
  endhandle
  !evar = 'YES'
else
  !evar = 'NO'
endif


setup form !!holeManMain dialog docking right

using namespace 'Aveva.Pdms.Presentation'

  -- Hole Association Manager
  frame .holeAssocPane panel anchor all  at x0 y0
    frame .filterFrame anchor t+l+r |Hole Association Filter| at xmax ymax width 72
       rtoggle   .rtogCE anchor t+l 'Current Element'
       path right
       rtoggle   .rtogList anchor t+l 'List of elements' at xmax_rtogCE+2
       rtoggle   .rtogAll anchor t+l 'All Managed Holes' at xmax_rtogList+2

       option    .filterDiscipline anchor t+l tagwid 7 'Discipline:' at xmin_rtogCE  ymax+0.2 width 5
       option    .filterStatus anchor t+l tagwid 5 'Status:' at xmax_filterDiscipline+1 width 4
       option    .filterClaimed anchor t+l tagwid 6 'Claimed:' at xmax_filterStatus+1 width 4
       option    .filterValid anchor t+l tagwid 4 'Valid:' at xmax_filterClaimed+1 width 9

       paragraph .displayLabel  at xmin_filterDiscipline  ymax+0.2 text 'Display:' width 6
       toggle    .panelToggle  tagwid 10 'Outfitting Panels' at xmax_displayLabel+0.9 ymin
       toggle    .hPlateToggle tagwid 9 'Hull Plates' at xmax_panelToggle+1.2
       if (!evar.upcase() eq 'YES') then
         toggle    .invalidToggle tagwid 10 'Invalid'at xmax_hPlateToggle+0.3
       else
         toggle    .invalidToggle tagwid 10 'Invalid'at xmax_displayLabel+0.9
       endif
       button    .getChanges   linkLabel 'Get all changes'  at xmax_invalidToggle-1 ymin_invalidToggle width 11
       button    .filterButton linkLabel 'Apply filter'  at xmax_filterValid-7 ymin_invalidToggle width 6

     exit
     frame .assocsFrame |Hole Associations| at xmin_filterFrame ymax_panelToggle+0.5 anchor all
       container .netAssocFrame nobox PmlNetControl |Associations| dock fill width 70 height 50
     exit

     path down
     toggle    .assocAidsToggle anchor left + bottom  tagwid 9 'Show Tags' at xmin+1 ymax+0.2
     toggle    .translucentToggle anchor left + bottom  tagwid 20 'Translucent Penetrated' at xmax+1 ymin
     paragraph .progressMessage   anchor left + bottom   at xmin_filterFrame ymax+0.5   width 45 lines 1

     button .firstTaskSel  linkLabel 'Manage Selected Holes' anchor b+l width 16 callback '!this.firstTaskPane(true)'
     path right
     list .filterElements anchor b+r |Elements to manage| at xmax_netAssocFrame-25.5 ymin_firstTaskSel-0.5 MULTIPLE width 24 height 5
     button .btnAdd  linkLabel anchor b+r 'Add Current Element' at xmin_filterElements-15 ymax_firstTaskSel width 13
     button .btnResetCur linkLabel anchor b+r 'Reset' at xmax_btnAdd-5 ymax_btnAdd width 4
     button .btnRefresh  linkLabel 'Refresh'  anchor b+r callback |!this.showAssocs(| at xmax_btnResetCur-6 ymax_btnResetCur width 5
     path right

   exit
   --line to force scrollbars if resized too small
   line .scrollLine    at x65      y20    horiz  width 0.1 heigh 0.1

menu .assocPopup popup
  !this.assocPopup.add( 'MENU', 'Navigate To', 'assocPopupNavigate' )
  !this.assocPopup.add( 'CALLBACK', 'Validate','!this.validateAssocs()')
  !this.assocPopup.add( 'CALLBACK', 'Add to 3D view','!this.updateGraphics(!this.collectDrawlistItems(!this.assocMemGrid.getSelectedRows()),|ADD|)')
  !this.assocPopup.add( 'CALLBACK', 'Remove from 3D view','!this.updateGraphics(!this.collectDrawlistItems(!this.assocMemGrid.getSelectedRows()),|REM|)')
  !this.assocPopup.add( 'CALLBACK', 'Focus on Hole','!this.focusOnHole(!this.assocMemGrid.getSelectedRows())' , 'focus')
  !this.assocPopup.add( 'CALLBACK', 'Modify Definition','!this.modifyHole(!this.assocMemGrid.getSelectedRows())','modifyHole')
  !this.assocPopup.add( 'CALLBACK', 'Add Penetrated','!this.edgPickPenetrated(|ADD|)','addPenetrated')
  !this.assocPopup.add( 'CALLBACK', 'Remove Penetrated','!this.removePenetrated()','removePenetrated')
  !this.assocPopup.add( 'CALLBACK', 'Fix Penetrated','!this.edgPickPenetrated(|FIX|)','fixPenetrated')
  !this.assocPopup.add( 'CALLBACK', 'Save/Unclaim','!this.saveUnclaim(!this.assocMemGrid.getSelectedRows())','saveUnclaim')
  !this.assocPopup.add( 'SEPARATOR')
  !this.assocPopup.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.assocMemGrid, |HoleAssociations.xls|, |Save Hole Association List As|)' )
  !this.assocPopup.add( 'CALLBACK', 'Print Preview...','!this.assocMemGrid.printpreview()' )

menu .assocPopupNavigate popup
  !this.assocPopupNavigate.add( 'CALLBACK', 'Association', '!this.navAssoc()' )
  !this.assocPopupNavigate.add( 'CALLBACK', 'Penetrated Item', '!this.navAssocItem1()' , 'navAssoc1' )
  !this.assocPopupNavigate.add( 'CALLBACK', 'Penetrating Item', '!this.navAssocItem2()' , 'navAssoc2' )


  -- Hole Management
  frame .firstTaskPane panel    anchor t+l+r   at x0  y0

     hdist 1
     halign centre
     path right
     vdist 0.5
     toggle    .holeAidsToggle  tagwid 9 'Show Tags' at x2 y0.1
      -- Framing for PMLNETControl object listing all HOLES
     frame .frmHoleList  'List of holes' at x0.5    ymax+0.1 anchor t+l+r
       container .conHoleListGrid nobox PMLNetCONTROL 'NET' dock fill width 70   height 12
     exit

    -- Internal framing for HOLES PMLNETControl object listing data for selected hole
    frame .frmHoleDataGrid foldUpPanel 'Selected hole data:' at xmin   ymax.frmHoleList + 0.5 anchor t+l+r
      container .conHoleDataGrid nobox PMLNetCONTROL 'NET'  dock  fill width 70 height 8
    exit

    -- Framing for PMLNETControl object listing validation results for selected hole
    frame .fraValidation foldUpPanel 'Hole validation results:' at xmin  ymax.frmHoleDataGrid + 0.5  anchor t+l+r
      container .conValidation nobox PMLNetCONTROL 'Container' dock  fill width 70 height 7
    exit

    -- Framing for PMLNETControl object listing history for selected hole
    frame .fraHistory foldUpPanel 'Hole History:' at xmin  ymax.fraValidation + 0.5  anchor t+l+r
      container .conHistory nobox PMLNetCONTROL 'Container' dock  fill width 70 height 7
    exit

    -- Save comment
    text .comment  tagwidth 10 'Hole Comment' at xmin   ymax.fraHistory + 0.5 anchor t+l+r  width 50 is STRING
    button .commentOK  ' Save ' at xmax.comment + 1 ymin.comment anchor t+r callback '!this.saveComment()'


    -- Originator Tasks
    paragraph .origPara                               at xmin_frmHoleList       ymax+0.5   anchor t+l  text 'Originator Tasks'
    line .origLine                                    at xmin       ymax                   anchor t+l  horizontal width 20
    button .request   linkLabel   'Request'           at xmin + 1   ymin + 0.5   width 12  anchor t+l callback '!this.submitRequest()'
    button .redundant linkLabel   'Redundant'         at xmin       ymax         width 12  anchor t+l callback '!this.redundantRequest()'
    button .cancel    linkLabel   'Cancel Request '   at xmin       ymax         width 12  anchor t+l callback '!this.cancelRequest()'
    button .deleteV   linkLabel   'Delete Entry '     at xmin       ymax         width 12  anchor t+l callback '!this.removeManagedHole()'


    -- Reviewer Tasks
    paragraph .revPara                                  at xmax.origPara + 8    ymin.origPara           anchor t+l  text 'Reviewer Tasks'
    line      .revLine                                  at xmax.origPara + 8    ymax                    anchor t+l horizontal width 20
    button    .approve    linkLabel   'Approve'         at xmin + 1             ymin + 0.5   width 12   anchor t+l callback '!this.approveRequest()'
    button    .reject     linkLabel   'Reject'          at xmin                 ymax         width 12   anchor t+l callback '!this.rejectRequest()'
    button    .deleteR    linkLabel   'Agree Redundant' at xmin                 ymax         width 12   anchor t+l callback '!this.approveRedundantRequest()'

    -- Back icon and link
    paragraph .backIcon             anchor top + left                at x0      ymax.deleteV +1  anchor t+l      pixmap width 16 height 16
    button    .returnBtn linkLabel     'Return to Hole Associations'   at xmax+1  ymin             anchor t+l      callback '!this.returnToAssocs()'
    button    .globalStatus  linkLabel 'Global Status'    at xmin.deleteR  ymin anchor t+l width 16                callback 'show !!glbTransactions'


  exit

  menu .filterSelPopup popup
    !this.filterSelPopup.add( 'CALLBACK', 'Remove element', '!this.removeElement()', 'removeElement')

  !this.filterElements.setPopup(!this.filterSelPopup)

  menu .holeListPopup popup
    !this.holeListPopup.add( 'CALLBACK', 'Navigate To','!this.navigateToHole()' , 'navigateToHole' )
    !this.holeListPopup.add( 'CALLBACK', 'Add to 3D view','!this.updateGraphics(!this.collectDrawlistItems(!this.ngcHoleList.getSelectedRows()),|ADD|)')
    !this.holeListPopup.add( 'CALLBACK', 'Remove from 3D view','!this.updateGraphics(!this.collectDrawlistItems(!this.ngcHoleList.getSelectedRows()),|REM|)')
    !this.holeListPopup.add( 'CALLBACK', 'Focus on Hole','!this.focusOnHole(!this.ngcHoleList.getSelectedRows())' , 'focus')
    !this.holeListPopup.add( 'CALLBACK', 'Add Penetrated','!this.edgPickPenetrated(|ADD|)','addPenetrated')
    !this.holeListPopup.add( 'CALLBACK', 'Remove Penetrated','!this.removePenetrated()','removePenetrated')
    !this.holeListPopup.add( 'CALLBACK', 'Fix Penetrated','!this.edgPickPenetrated(|FIX|)','fixPenetrated')
    !this.holeListPopup.add( 'CALLBACK', 'Fix Hole','!this.fixHole()','fixHole')
    !this.holeListPopup.add( 'CALLBACK', 'Save/Unclaim','!this.saveUnclaim(!this.ngcHoleList.getSelectedRows())','saveUnclaim')
    !this.holeListPopup.add( 'SEPARATOR')
    !this.holeListPopup.add( 'CALLBACK', 'Refresh List',|!this.firstTaskPane(TRUE)| )
    !this.holeListPopup.add( 'SEPARATOR')
    !this.holeListPopup.add( 'CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.ngcHoleList, |HoleList.xls|, |Save Hole List As|)' )
    !this.holeListPopup.add( 'CALLBACK', 'Print Preview...','!this.ngcHoleList.printpreview()' )

  menu .dataPopup popup
    !this.dataPopup.add( 'CALLBACK', 'Navigate To','!this.navigateToHoleData()' , 'navigateToHoleData' )
    !this.dataPopup.add( 'CALLBACK', 'Add to 3D view','!this.updateGraphics(!this.getSelectedHoleData(),|ADD|)')
    !this.dataPopup.add( 'CALLBACK', 'Remove from 3D view','!this.updateGraphics(!this.getSelectedHoleData(),|REM|)')
    !this.dataPopup.add( 'SEPARATOR')
    !this.dataPopup.add('CALLBACK', 'Export to Excel...','!!exportToExcel(!this.ngcHoleData, |HoleData.xls|, |Save Hole Data As|)' )
    !this.dataPopup.add('CALLBACK', 'Print Preview...','!this.ngcHoleData.printpreview()' )

 menu .validationPopup popup
    !this.validationPopup.add( 'CALLBACK', 'Display Results',|!this.displayResults()| )
    !this.validationPopup.add( 'SEPARATOR')
    !this.validationPopup.add( 'CALLBACK', 'Export to Excel...','!!exportToExcel(!this.ngcValidation, |ValidationResults.xls|, |Save Validation Results As|)' )
    !this.validationPopup.add( 'CALLBACK', 'Print Preview...','!this.ngcValidation.printpreview()' )

 menu .historyPopup popup
    !this.historyPopup.add( 'CALLBACK', 'Export to Excel...','!!exportToExcel(!this.ngcHistory, |HoleHistory.xls|, |Save Hole History As|)' )
    !this.historyPopup.add( 'CALLBACK', 'Print Preview...','!this.ngcHistory.printpreview()' )

   -- Form members
   -- Hole Association Manager Panel
   member .assocMemGrid is NETGRIDCONTROL
   member .restriMemGrid is NETGRIDCONTROL
   member .assocs    is ARRAY
   member .restrics  is ARRAY
   member .assoc     is DBREF
   member .graphView is BOOLEAN
   member .form      is FORM
   member .token     is REAL
   -- Hole Manager Panel
   member .ngcHoleList     is  NETGRIDCONTROL
   member .ngcHoleData     is  NETGRIDCONTROL
   member .ngcValidation   is  NETGRIDCONTROL
   member .ngcHistory      is  NETGRIDCONTROL
   member .listHeadings    is  ARRAY
   -- Current Task Pane within Form
   member .currentPane     is GADGET
   member .currentTask     is BLOCK
   -- Marine or plant project
   member .marine          is BOOLEAN
  -- Penetrated EDG packet
  member .penetratedPacketDesc   is STRING
  -- Is penetrated pick
  member .isPenetratedPick       is BOOLEAN
  -- List of penetrated items
  member .penetrated             is DBREF
  member .penetratedRaw          is DBREF
  --which filter is selected. FALSE = all
  member .filterModeSelected         is REAL
  member .selectedElements       is ARRAY
  member .isGlobal is BOOLEAN
  -- results of last validation (array of array or strings)
  member .validationResults      is ARRAY
  -- aid number for aid graphics
  member .aidAxes                is REAL
  -- list of elements made translucent
  member .translucentList        is ARRAY
    -- Undo event handlers
  member .undoDelete             is UNDOABLE


exit

-- End of form definition

------------------------------------------------------------------------
--
-- Method:      holeManMain
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .holeManMain()

  if( !!isThisHmProj().not() ) then
    return
  endif

  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    !this.panelToggle.visible = TRUE
    !this.panelToggle.val = TRUE
    !this.hPlateToggle.visible = TRUE
    !this.marine = TRUE
  else
    !this.panelToggle.visible = FALSE
    !this.hPlateToggle.visible = FALSE
    !this.marine = FALSE
  endif

  -- Is this a global project
  !project         = CURRENT PROJECT
  !this.isGlobal     = !project.isGlobal()
  if (!this.isGlobal) then
    !this.globalStatus.visible = TRUE
    !this.getChanges.visible   = TRUE
  else
    !this.globalStatus.visible = FALSE
    -- Locate the correct hierarchy point for creation
    !assogpList = object COLLECTION()
    !assogpList.addtype(|ASSOGP|)
    !assogpList.filter(object EXPRESSION(|PURP eq 'HOLE' and dbwrite|))
    !elemList = !assogpList.results()
    -- If the assoc group is in an extract DB then make the get changes button visible
    if (!elemList.empty().not()) then
      !extract = !elemList[1].dbexno.gt(1)
      if (!extract) then
        !this.getChanges.visible   = TRUE
      else
        !this.getChanges.visible   = FALSE
      endif
    else
      -- Not sure currently where the associations will be built so assume not in an extract db
      !this.getChanges.visible   = FALSE
    endif
  endif

  !this.progressMessage.val  = ''
  -- Initialise progress bar
  !this.showProgress(-1)
  -- Enable scrollbars
  !this.autoscroll = TRUE

  -- Setup dummy default task
  !this.currentTask = object BLOCK('$$p')

  -- Initialise visibility of panels
  !this.mainTasks(true)
  !this.firstTaskPane(false)

  -- Set "Back" icon
  !backIcon  = !!pml.getpathname('back.png')
  !this.backIcon.addpixmap(!backIcon)

  -- Panel Initialisation
  !this.holeAssocManager()
  !this.hmMain()

  -- allocate aid number
  !this.aidAxes    = !!aidNumbers.add('holeManMain-Axes')
  !this.cancelcall = |!this.cleanUp()|

  -- Initialise delete button undo
  !this.undoDelete.description('Delete Managed Hole')
  !this.deleteV.setUndoable(!this.undoDelete)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Setup Hole Association Manager Panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--               BOOLEAN    Status of Hole Association Panel
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then
    -- Set current pane
    !this.currentPane = !this.holeAssocPane
    -- Run action for current pane
    !this.currentTask.evaluate()
    -- Defined action to be carried out on closing pane
    !this.currentTask = object BLOCK('!this.mainTasks(false)')
    -- Change form title to reflect the active pane
    !this.formTitle = 'Hole Association Manager'
    -- Set fold up panels to folded except for validation panel
    !this.frmHoleDataGrid.expanded = FALSE
    !this.fraValidation.expanded   = TRUE
    !this.fraHistory.expanded      = FALSE
  endif

  -- Show/hide task pane
  !this.holeAssocPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      firstTaskPane
--
-- Description: Setup Hole Manager Panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--               BOOLEAN    Status of Hole Management Panel
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .firstTaskPane(!active is BOOLEAN)


  -- Make task pane active
  if(!active) then
    -- Set current pane
    !this.currentPane  = !this.firstTaskPane
     -- Run action for current pane
    !this.currentTask.evaluate()
    -- Defined action to be carried out on closing pane
    !this.currentTask  = object BLOCK('!this.firstTaskPane(false)')
    -- Change form title to reflect the active pane
    !this.formTitle  = 'Hole Management'
  endif

  -- Show/hide task pane
  !this.firstTaskPane.visible = !active

  if(!active)then
    !assocArray = ARRAY()
    do !row values !this.assocMemGrid.getSelectedRows()
      --Get all selected associations
      !holeAssociationRef = !row[1].dbref()
      handle any
        -- handle case where the association has been deleted while form is shown
        skip
      endhandle
      !assocArray.append(!holeAssociationRef)
    enddo
    !this.populateHoleList(!assocArray)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      holeAssocManager
--
-- Description: Initialise Hole Association Panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .holeAssocManager()

  using namespace 'Aveva.Pdms.Presentation'


  -- Add instances of .Net control
  !this.assocMemGrid = object NETGRIDCONTROL()
  !this.restriMemGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netAssocFrame.control = !this.assocMemGrid.handle()

  !this.assocMemGrid.addeventhandler('OnPopup', !this, 'assocRightClick')
  !this.assocMemGrid.addeventhandler('AfterSelectChange', !this, 'selectedHoleMainChanged')
  !this.initcall  = '!this.returnToAssocs()'
  !this.assocAidsToggle.callback = |!this.selectedHoleMainAids()|
  !this.translucentToggle.callback = |!this.showPenetratedTranslucent()|
  !this.holeAidsToggle.callback  = |!this.selectedHoleAids()|
  !this.rtogCE.callback = |!this.filterChanged(FALSE)|
  !this.rtogList.callback = |!this.filterChanged(FALSE)|
  !this.rtogAll.callback = |!this.filterChanged(FALSE)|
  !this.btnAdd.callback  =|!this.addElement()|
  !this.btnResetCur.callback = |!this.resetElements(FALSE)|
  !this.firstshowncall = |!this.resetElements(FALSE)|
  !this.filterButton.callback = |!this.applyFilter()|
  !this.getChanges.callback = |!this.getChanges()|

  !this.filterDiscipline.setToolTip('Filter by Discipline')
  !this.filterStatus.setToolTip('Filter by Status')
  !this.filterClaimed.setToolTip('Filter by Claimed')
  !this.filterValid.setToolTip('Filter by Association Validity. Note that the filtering process will take longer with this option enabled')
  !this.getChanges.setToolTip('Get any changes from other extracts')

  !this.filterElements.setToolTip('List of all elements to manage')
  !this.btnAdd.setToolTip('Add currently selected element to list of elements to manage')
  !this.btnResetCur.setToolTip('Reset list of elements to manage to just the currently selected element')
  !this.btnRefresh.setToolTip('Refresh the list of elements to manage. Note that this will run the filter')

    -- Set parameters
  !this.assocMemGrid.columnExcelFilter(FALSE)
  !this.assocMemGrid.outlookGroupStyle(TRUE)
  !this.assocMemGrid.fixedHeaders(TRUE)
  !this.assocMemGrid.fixedRows(FALSE)
  !this.assocMemGrid.columnSummaries(FALSE)
  !this.assocMemGrid.editableGrid(FALSE)
  !this.assocMemGrid.singleRowSelection(FALSE)
  !this.assocMemGrid.setalternaterowcolor('lightgray')
  !dtext = ARRAY()


  !dtext.clear()
  !dtext.append('All')
  !dtext.append('Piping')
  !dtext.append('Cableway')
  !dtext.append('Equipment')
  !dtext.append('HVAC')
  !dtext.append('Structural')
  !dtext.append('Cable Tray')
  !dtext.append('Other')
  !this.filterDiscipline.dtext = !dtext
  !rtext = ARRAY()
  !rtext.append('All')
  !rtext.append('PIPE')
  !rtext.append('CWAY')
  !rtext.append('EQUI')
  !rtext.append('DUCT')
  !rtext.append('STRU')
  !rtext.append('TRAY')
  !rtext.append('GEN')
  !this.filterDiscipline.rtext = !rtext


  !dtext.clear()
  !dtext.append('All')
  !dtext.append('Unset')
  !dtext.append('Requested')
  !dtext.append('Approved')
  !dtext.append('Redundant')
  !dtext.append('Rejected')
  !dtext.append('Withdrawn')
  !dtext.append('Not Approved')
  !this.filterStatus.dtext = !dtext
  !rtext.clear()
  !rtext.append('All')
  !rtext.append('Unset')
  !rtext.append('REQU')
  !rtext.append('APPR')
  !rtext.append('REDU')
  !rtext.append('REJE')
  !rtext.append('WITH')
  !rtext.append('NAPP')
  !this.filterStatus.rtext = !rtext

  !dtext.clear()
  !dtext.append('Not Checked')
  !dtext.append('All')
  !dtext.append('Passed')
  !dtext.append('Failed')
  !this.filterValid.dtext = !dtext

  !dtext.clear()
  !dtext.append('All')
  !dtext.append('No')
  !dtext.append('Yes')
  !this.filterClaimed.dtext = !dtext
  !rtext.clear()
  !rtext.append('All')
  !rtext.append('NO')
  !rtext.append('YES')
  !this.filterClaimed.rtext = !rtext


  !this.firstTaskSel.active = FALSE
endmethod

-- End of method definition for .associationManager()

------------------------------------------------------------------------
--
-- Method:      selectElements
--
-- Description: specify list of elements to be managed
--              CALLED EXTERNALLY
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectElements(!elements is ARRAY)

  !this.selectedElements = ARRAY()
  do !index indices !elements
    if( !elements[!index].objectType() eq 'DBREF' ) then
      !this.selectedElements.append(!elements[!index])
    elseif( !elements[!index].objectType() eq 'HMHOLE' ) then
      !this.selectedElements.append(!elements[!index].getAssociation())
    endif
  enddo
  !this.selectedElements.unique()
  !this.updateSelectedList()

endmethod

------------------------------------------------------------------------
--
-- Method:      setFilter
--
-- Description: specify list of elements to be managed
--              CALLED EXTERNALLY
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFilter(!scope is STRING, !discipline is STRING, !status is STRING, !claimed is STRING, !valid is STRING)

  -- set scope of search
  if( !scope.upcase() eq 'LIST' ) then
    !this.filterFrame.val   = 2
  elseif( !scope.upcase() eq 'ALL' ) then
    !this.filterFrame.val   = 3
  elseif( !scope.upcase() eq 'CE' ) then
    !this.filterFrame.val   = 1
  endif
  -- set search filters
  if( !discipline.empty().not() ) then
    !this.filterDiscipline.select('rtext', !discipline)
    handle any
      !this.filterDiscipline.select('rtext', 'All')
    endhandle
  endif
  if( !status.empty().not() ) then
    !this.filterStatus.select('rtext', !status)
    handle any
      !this.filterStatus.select('rtext', 'All')
    endhandle
  endif
  if( !claimed.empty().not() ) then
    !this.filterClaimed.select('rtext', !claimed)
    handle any
      !this.filterClaimed.select('rtext', 'All')
    endhandle
  endif
  if( !valid.empty().not() ) then
    !this.filterValid.select('rtext', !valid)
    handle any
      !this.filterValid.select('rtext', 'Not Checked')
    endhandle
  endif

  -- make sure that form is on filter page
  !this.mainTasks(TRUE)
  -- apply filter
  !this.filterChanged(true)

endmethod

------------------------------------------------------------------------
--
-- Method:      addElement
--
-- Description: add an element to the list of elements to be managed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addElement()
  !this.selectedElements.append(!!ce)
  !this.selectedElements.unique()
  !this.updateSelectedList()
endmethod

------------------------------------------------------------------------
--
-- Method:      removeElement
--
-- Description: remove an element(s) from the list of elements to be managed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeElement()

  if( !this.selectedElements.size() lt 2 ) then
    !reply = !!alert.confirm( 'There must be at least one element in the Managed Element list. Do you want to replace the selected element with the Current Element?' )
    if(!reply eq 'NO') then
      return
    endif
  endif

  !remove = !this.filterElements.val

  do !i value !remove
    !this.selectedElements.deleteFrom(!i,1)
  enddo
  !this.selectedElements.compress()
  if (!this.selectedElements.empty()) then
    !this.selectedElements.append(!!ce)
  endif
  !this.updateSelectedList()

endmethod

------------------------------------------------------------------------
--
-- Method:      resetElements
--
-- Description: resets the list of elements to be managed to the CE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .resetElements(!update IS BOOLEAN)
  !this.selectedElements.clear()
  !this.addElement()
  !this.hPlateToggle.val = true
  !this.panelToggle.val = TRUE
  if (!update EQ TRUE) then
    !this.filterChanged(TRUE)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      updateSelectedList
--
-- Description: update the list of elements to be managed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateSelectedList()
  !dtext = ARRAY()
  !deleted = FALSE
  do !ele index !this.selectedElements
    if (!this.selectedElements[!ele].badref()) then
       --should remove any bad refs from the list
       !this.selectedElements.deleteFrom(!ele,1)
       !deleted = TRUE
       skip
    endif
    !dtext.append(!this.selectedElements[!ele].name)
  enddo
  if (!deleted) then
    !this.selectedElements.compress()
  endif
  !this.filterElements.dtext = !dtext

endmethod
------------------------------------------------------------------------
--
-- Method:      filterChanged
--
-- Description: rtoggle buttons have been clicked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filterChanged(!update is BOOLEAN)
  --if CE selected disable/enable relevant gadgets

  !frame = !this.filterFrame
  !index = !frame.val
  if (!this.rtogCE.val EQ TRUE) then
    !this.filterModeSelected = 1
    !this.panelToggle.active = FALSE
    !this.hPlateToggle.active = FALSE
    !this.invalidToggle.active = FALSE
    !this.filterElements.active = FALSE
    !this.btnAdd.active = FALSE
    !this.btnResetCur.active = FALSE
    !this.btnRefresh.active = FALSE
  elseif (!this.rtogList.val EQ TRUE) then
    !this.filterModeSelected = 2
    !this.panelToggle.active = TRUE
    !this.hPlateToggle.active = TRUE
    !this.invalidToggle.active = TRUE
    !this.filterElements.active = TRUE
    !this.btnAdd.active = TRUE
    !this.btnResetCur.active = TRUE
    !this.btnRefresh.active = TRUE
  else
    !this.filterModeSelected = 3
    !this.panelToggle.active = TRUE
    !this.hPlateToggle.active = TRUE
    !this.invalidToggle.active = TRUE
    !this.filterElements.active = FALSE
    !this.btnAdd.active = FALSE
    !this.btnResetCur.active = FALSE
    !this.btnRefresh.active = FALSE

  endif
  if (!update) then
    !this.applyFilter()
  endif
endmethod
------------------------------------------------------------------------
--
-- Method:      showAssocs
--
-- Description: display association info
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAssocs(!dummyGadget is GADGET, !option is STRING)
  !this.updateSelectedList()

  using namespace  'Aveva.Pdms.Presentation'

  !filterValid = !this.filterValid.selection()
  if (!filterValid eq 'Not Checked') then
    !this.progressMessage.val = 'Finding associations. Please wait...'
  else
    !this.progressMessage.val = 'Finding associations and performing validation tests. Please wait...'
  endif

  !this.progressMessage.refresh()

  -- Clear any existing data
  !this.assocMemGrid.clearGrid()
  !this.assocs.clear()

  !allAssoc = ARRAY()

  !selection = !this.filterModeSelected
  !filterDiscipline = !this.filterDiscipline.selection()
  !filterStatus = !this.filterStatus.selection()
  if (!filterStatus EQ 'Unset') then
    !filterStatus = ''
  endif
  !filterClaimed = !this.filterClaimed.selection()
  !current  = !!ce
  --if current element(s) is selected then
  -- for each element get a list of its' ancestors. Check remaining element list
  --and only add element to list if none of its' ancestors are present.
  --If All Managed Holes is selected or current element is world then just add
  --world to the list of elements to check
  !elementList = ARRAY()
  if (!selection EQ 1 and !current.name NE '/*') then
    !elementList.append(!!ce)
  elseif (!selection EQ 2  ) then
    !count = 0
    !deleted = FALSE

    do !ele values !this.selectedElements
      --do a quick check to see if there are any worlds in the list
      if (!ele.type eq 'WORL') then
        !worldFound = TRUE
        break
      endif
    enddo

    if (undefined(!worldFound)) then
    do !ele values !this.selectedElements
      !owners = ARRAY()

      --The ownlst pseudo-att doesn't appear to return the info we're interested in
      --!owners = !ele.ownlst
      --so do it manually...
      !own = !ele
      do
        !own = !own.owner
        if (!own.set()) then
          !owners.append(!own)
        else
          break
        endif
      enddo

      if (!owners.empty()) then
        --if nothing in owners list then element must be world do don't
        --need to do anything else apart from adding
        --world to the list of elements to examine
        !elementList.clear()
        !elementList.append(!ele)
        break
      endif

      --Run through owners list and see if any owners are present in the main list
      do !test values !owners
        !found = !this.selectedElements.findFirst(!test)
        if (!found.unset()) then
          -- if found then element is NOT ok to add to list to be processed
          break
        endif
      enddo
      if (!found.unset()) then
        --if found is unset by the time it gets here then element is ok to add to list
        !elementList.append(!ele)
      endif
    enddo
    endif

  endif
  -- Collect all associations
  if (!elementList.empty()) then
    var !allAssoc coll all assoc with (purp of owner eq 'HOLE')
  else

    do !element values !elementList
      if (!element.name EQ '/*') then
        var !allAssoc coll all assoc with (purp of owner eq 'HOLE')
        break
      elseif (!element.hardType inset ('ASSOGP','ASSOWL')) then
        -- special for if located at ASSOGP
        var !theseAssoc coll all assoc with (purp of owner eq 'HOLE') for $!element
      else
       !theseAssoc = !this.getHolesFor(!element)
      endif
      if (!theseAssoc.size() NE 0) then
        !allAssoc.appendArray(!theseAssoc)
      endif

    enddo
  endif
--Now apply 1st level of filtering.

  -- Array to hold PANELS/HPLATES with Holes
  !selectedAssocs = ARRAY()

  -- Loop round all associations
  -- a more efficient mechanism applying both filters at once probably exists
  -- Something to figure out later!
  if (!selection EQ 3) then
    do !association values !allAssoc
      VAR !assoMember LNID /HoleOwner OF $!<association>
      handle any
        -- hole owner element missing - add to invalid
        if (!this.invalidToggle.val) then
          !selectedAssocs.append(!association)
        endif
        skip
      endhandle
      !holeOwner = !assoMember.dbref().amemrf
      if (badref(!holeOwner)) then
        if (!this.invalidToggle.val) then
          !selectedAssocs.append(!association)
        endif
      else
        if (!this.panelToggle.val or !this.marine.not()) then
          if (!holeOwner.hardType inset('PANE',|CTWALL|,'SCTN','GENSEC')) then
            !selectedAssocs.append(!association)
          endif
        endif
        if (!this.hPlateToggle.val) then
          if (!holeOwner.type inset('HPLATE','CPLATE','HPANEL','CPANEL')) then
            !selectedAssocs.append(!association)
          endif
        endif
      endif

    enddo
  else
    !selectedAssocs.appendArray(!allAssoc)
  endif

  !count = 1
  !assocInfo = ARRAY()

  !selectedAssocs.unique()

  --if user has specified to test for valid states then run the validity routines
  !showProgress = FALSE
  if (!filterValid ne 'Not Checked') then
    --initialise progress bar
    !progressMax = !selectedAssocs.size()
    if (!progressMax le 0) then
      !progressMax = 1
    endif
    !progressIncrement = 100 / !progressMax
    !progress          = 0
    !this.showProgress(0)
    !showProgress = TRUE
  endif
  do !i values !selectedAssocs

    !info= ARRAY()
    !info.append(!i.dbref().fullname)
    !hole = object HMHOLE(!i.dbref())
    !discipline = !hole.holeType
    !info.append(!discipline)
    !status = !hole.status
    !info.append(!status)
    --if a validation test IS needed, do it later when the number of possible holes
    --has been reduced by applying the other filters
    !valid = 'Not Checked'
    !info.append(!valid)
    if (!i.dbref().dbexno gt 1) then
      -- If association is in an extract
      !claimed1 = !i.dbref().exclto
      !claimed2 = !i.dbref().exclhi.empty().not()
      if (!claimed1 or !claimed2) then
        !claimed = TRUE
      else
        !claimed = FALSE
      endif
    else
      !claimed = !i.dbref().lclmh
    endif
    if (!claimed) then
      !info.append('YES')
      !claimedStr = 'YES'
    else
      !info.append('NO')
      !claimedStr = 'NO'
    endif
    -- find out the assmbr elements
    !penetrated = !hole.holeOwner
    !invalidRef = FALSE
    if (badref(!penetrated) or !penetrated.unset()) then
      !info.append('Invalid')
      !invalidRef = TRUE
      if (!this.marine) then
        !info.append('Invalid')
      endif
    else
      !info.append(!penetrated.fullname)
      if (!this.marine) then
        if (!penetrated.hardType eq 'HPANEL' or !penetrated.hardType eq 'CPANEL') then
          !info.append(!penetrated.owner.fullname)
        else
          !info.append('')
        endif
      endif
    endif
    if (badref(!hole.primaryElement)) then
      !info.append('Invalid')
      !invalidRef = TRUE
    else
      !penetrating = !hole.primaryElement.amemrf
      if (badref(!penetrating) or !penetrating.unset()) then
        !info.append('Invalid')
        !invalidRef = TRUE
      else
        !info.append(!penetrating.fullname)
      endif
    endif

    -- match status with filter, including not approved filter
    !matchStatusFilter = ( !filterStatus inset('$!status', 'All' ) OR ( !filterStatus eq 'NAPP' AND !status neq 'APPR' ) )
    -- match filters
    if   ((( !filterDiscipline inset('$!discipline', 'All' ) OR $
          (( !filterDiscipline eq 'GEN') AND (!discipline inset ('GEN', 'FITT'))))) AND $
          !matchStatusFilter AND !filterClaimed inset ('$!claimedStr', 'All')) then
      if ((!filterValid ne 'Not Checked') ) then
        --only do validation tests if absolutely needed as they take a long time
        !valid = !this.testEval(!i)
        !info[4] =!valid
      endif
      if (!filterValid inset ('$!valid', 'All')) then
        !this.assocs.append(!i.dbref())
        !assocInfo[!count] = ARRAY()
        !assocInfo[!count] = !info
        !count = !count + 1
      endif
    endif
    if (!showProgress eq TRUE) then
      !progress = !progress + !progressIncrement
      !this.showProgress(!progress)
    endif

  enddo
  !headings = ARRAY()
  !headings.append('Association')
  !headings.append('Discipline')
  !headings.append('Status')
  !headings.append('Valid')
  !headings.append('Claimed')
  !headings.append('Penetrated Item')
  if (!this.marine) then
    !headings.append('Block')
  endif
  !headings.append('Penetrating Item')

  !nds = object NETDATASOURCE('Associations', !headings, !assocInfo )
  !this.assocMemGrid.bindToDataSource(!nds)

  !this.highlightAssocMemGrid()
   if(!selectedAssocs.size() GT 0 )then
    -- Activate "Manage Selected Holes" link
    !this.firstTaskSel.active = TRUE
  else
    !this.firstTaskSel.active = FALSE
  endif

  --Select first row
  !this.assocMemGrid.selectRow(1)
  !this.showProgress(0)

  !this.progressMessage.val = ''
  !this.progressMessage.refresh()
endmethod


------------------------------------------------------------------------
--
-- Method:      assocRightClick
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assocRightClick(!data is ARRAY)

  -- If there are no rows just return
  if (!this.assocMemGrid.getSelectedRows().size() eq 0) then
    return
  endif

  if (!this.assocMemGrid.getSelectedRows()[1][3] EQ 'Invalid' OR !this.assocMemGrid.getSelectedRows()[1][3] EQ 'None') then
    !this.assocPopupNavigate.setFieldProperty('navAssoc1','VISIBLE',FALSE)
  else
    !this.assocPopupNavigate.setFieldProperty('navAssoc1','VISIBLE',TRUE)
  endif
  if (!this.assocMemGrid.getSelectedRows()[1][4] EQ 'Invalid' OR !this.assocMemGrid.getSelectedRows()[1][4] EQ 'None') then
    !this.assocPopupNavigate.setFieldProperty('navAssoc2','VISIBLE',FALSE)
  else
    !this.assocPopupNavigate.setFieldProperty('navAssoc2','VISIBLE',TRUE)
  endif

  !this.assocPopup.setFieldProperty('saveUnclaim','VISIBLE',FALSE)
  do !holes values !this.assocMemGrid.getSelectedRows()
    if (!holes[5] eq 'YES') then
     !this.assocPopup.setFieldProperty('saveUnclaim','VISIBLE',TRUE)
     break
    endif
  enddo
  if (!this.assocMemGrid.getSelectedRows().size() eq 1 ) then
    !setPopup = true
    !row = !this.assocMemGrid.getSelectedRows()[1]
    !assoc = !row[1].dbref()
    handle any
      !setPopup = false
    endhandle
  else
    !setPopup = false
  endif

  if( !setPopup ) then
    !hmHole = object HMHOLE(!assoc)
    !allowAddPen = FALSE
    if (!hmHole.holeOwner.badref().not()) then
      if (!hmHole.holeOwner.type inset('CPLATE', 'HPANEL', 'HPLATE')) then
        !allowAddPen = TRUE
      endif
    endif
    !hmHole.delete()

    !this.assocPopup.setFieldProperty('focus','VISIBLE',TRUE)
    !mod = !!module()
    !this.assocPopup.setFieldProperty('modifyHole','VISIBLE', ( !mod.appkey.upcase() neq 'MARHDES' ) )
    if (!row[6] eq 'Invalid' and !this.marine ) then
      !this.assocPopup.setFieldProperty('fixPenetrated','VISIBLE',TRUE)
    else
      !this.assocPopup.setFieldProperty('fixPenetrated','VISIBLE',FALSE)
    endif
    if ( (!row[3] eq '' or !row[3] eq 'REQU' or !row[3] eq 'REJE') and !mod.appkey.upcase() eq 'DES' and !this.marine and !allowAddPen) then
      !this.assocPopup.setFieldProperty('addPenetrated','VISIBLE',TRUE)
    elseif ((!this.assocMemGrid.getSelectedRows()[1][3] eq 'APPR' or !this.assocMemGrid.getSelectedRows()[1][3] eq 'REQU') and !mod.appkey.upcase() eq 'MARHDES' and !this.marine and !allowAddPen) then
      !this.assocPopup.setFieldProperty('addPenetrated','VISIBLE',TRUE)
    else
      !this.assocPopup.setFieldProperty('addPenetrated','VISIBLE',FALSE)
    endif
    if ((!row[3] eq '' or !row[3] eq 'REJE') and !mod.appkey.upcase() eq 'DES' and !this.marine) then
      if (!row[4] eq 'Failed') then
        !association = !row[1].dbref()
        -- check that it has additional hole owners and if it has maybe this can be fixed by removing them from the association
        !find = object COLLECTION()
        !find.type('ASSMBR')
        !find.scope(!association)
        !find.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner?')|))
        !test = !find.results()
        if (!test.empty()) then
          !this.assocPopup.setFieldProperty('removePenetrated','VISIBLE',FALSE)
        else
          !this.assocPopup.setFieldProperty('removePenetrated','VISIBLE',TRUE)
        endif
      else
        !this.assocPopup.setFieldProperty('removePenetrated','VISIBLE',FALSE)
      endif
    else
      !this.assocPopup.setFieldProperty('removePenetrated','VISIBLE',FALSE)
    endif
  else
    !this.assocPopup.setFieldProperty('focus','VISIBLE',FALSE)
    !this.assocPopup.setFieldProperty('modifyHole','VISIBLE',FALSE)
    !this.assocPopup.setFieldProperty('fixPenetrated','VISIBLE',FALSE)
    !this.assocPopup.setFieldProperty('addPenetrated','VISIBLE',FALSE)
    !this.assocPopup.setFieldProperty('removePenetrated','VISIBLE',FALSE)
  endif

  !this.netAssocFrame.popup = !this.assocPopup
  !this.netAssocFrame.showPopup(!data[0], !data[1])
  !this.assoc = !this.assocs[!data[2][1].real()]

endmethod



------------------------------------------------------------------------
--
-- Method:      navAssoc
--
-- Description: Navigate to the association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navAssoc()

  !!ce=!this.assoc
  handle any
    !!alert.error('This Hole association has been deleted. Please refresh the list of holes')
  endhandle

endmethod


------------------------------------------------------------------------
--
-- Method:      navAssocItem1
--
-- Description: Navigate to the association member1
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navAssocItem1()

  !!ce=!this.assoc
  handle any
    !!alert.error('This Hole association has been deleted. Please refresh the list of holes')
    return
  endhandle
  assmbr 1
  goto amemrf
  handle any
    !!alert.error('Unable to navigate to the selected item')
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      navAssocItem2
--
-- Description: Navigate to the association member2
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navAssocItem2()

  !!ce=!this.assoc
  assmbr 2
  handle any
    !!alert.error('Unable to navigate to the selected item')
    return
  endhandle
  goto amemrf
  handle any
    !!alert.error('Unable to navigate to the selected item')
  endhandle

endmethod


------------------------------------------------------------------------
--
-- Method:      testEval
--
-- Description: Perform test evaluation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testEval(!association is STRING) is STRING

 !testev = !association.dbref().testev
  handle any
    !status = 'Invalid'
  elsehandle none
    if (!testev) then
      !status = 'Passed'
    else
      !status = 'Failed'
    endif
  endhandle

  return !status

endmethod

------------------------------------------------------------------------
--
-- Method:      hmMain
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmMain()


  -- Setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net controls to PML containers
  !this.ngcHoleList = object NETGRIDCONTROL()
  !this.conHoleListGrid.control = !this.ngcHoleList.handle()
  !this.ngcHoleData = object NETGRIDCONTROL()
  !this.conHoleDataGrid.control = !this.ngcHoleData.handle()
  !this.ngcValidation = object NETGRIDCONTROL()
  !this.conValidation.control = !this.ngcValidation.handle()
  !this.ngcHistory = object NETGRIDCONTROL()
  !this.conHistory.control = !this.ngcHistory.handle()

  -- Add PML event handlers to .Net control
  !this.ngcHoleList.addeventhandler('AfterSelectChange', !this, 'selectedHoleChanged')
  !this.ngcHoleList.addeventhandler('OnPopup', !this, 'PopupListCallback')
  !this.ngcHoleList.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcHoleData.addeventhandler('OnPopup', !this, 'PopupDataCallback')
  !this.ngcValidation.addeventhandler('OnPopup', !this, 'popupValidCallback')
  !this.ngcHistory.addeventhandler('OnPopup', !this, 'popupHistCallback')

  -- Disable Originator and Reviewer options when form first loads
  !this.approve.active   = FALSE
  !this.reject.active    = FALSE
  !this.deleteR.active   = FALSE
  !this.request.active   = FALSE
  !this.redundant.active = FALSE
  !this.cancel.active    = FALSE
  !this.deleteV.active   = FALSE
  !this.comment.active   = FALSE
  !this.commentOK.active = FALSE

  -- Setup the display grid headings
  !this.listHeadings[1]  = 'HOLE NAME'
  !this.listHeadings[2]  = 'HOLEOWNER'
  !this.listHeadings[3]  = 'STATUS'
  !this.listHeadings[4]  = 'VALID'
  !this.listHeadings[5]  = 'PURPOSE'
  !this.listHeadings[6]  = 'HOLE TYPE'
  !this.listHeadings[7]  = 'SIZE'
  !this.listHeadings[8]  = 'N.B'
  !this.listHeadings[9]  = 'RATING'
  !this.listHeadings[10] = 'POSITION'

  -- Basic settings for HOLELIST grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcHoleList.columnExcelFilter(FALSE)
  !this.ngcHoleList.outlookGroupStyle(TRUE)
  !this.ngcHoleList.fixedHeaders(FALSE)
  !this.ngcHoleList.fixedRows(FALSE)
  !this.ngcHoleList.editableGrid(FALSE)
  !this.ngcHoleList.columnSummaries(FALSE)
  !this.ngcHoleList.setalternaterowcolor('lightgray')
  !this.ngcHoleList.singleRowSelection(FALSE)

  -- Setup the HOLEDATA grid
  !this.ngcHoleData.columnExcelFilter(FALSE)
  !this.ngcHoleData.outlookGroupStyle(FALSE)
  !this.ngcHoleData.fixedHeaders(FALSE)
  !this.ngcHoleData.fixedRows(FALSE)
  !this.ngcHoleData.editableGrid(FALSE)
  !this.ngcHoleData.setalternaterowcolor('lightgray')
  !this.ngcHoleData.singleRowSelection(FALSE)

  -- Setup the validation results grid
  !this.ngcValidation.columnExcelFilter(FALSE)
  !this.ngcValidation.outlookGroupStyle(FALSE)
  !this.ngcValidation.fixedHeaders(FALSE)
  !this.ngcValidation.fixedRows(FALSE)
  !this.ngcValidation.editableGrid(FALSE)
  !this.ngcValidation.singleRowSelection(TRUE)

   -- Setup the hole history grid
  !this.ngcHistory.columnExcelFilter(FALSE)
  !this.ngcHistory.outlookGroupStyle(FALSE)
  !this.ngcHistory.fixedHeaders(FALSE)
  !this.ngcHistory.fixedRows(FALSE)
  !this.ngcHistory.editableGrid(FALSE)
  !this.ngcHistory.singleRowSelection(TRUE)
  !this.filterModeSelected = 1
  !this.rtogCE.val = TRUE
  !this.rtogList.val = FALSE
  !this.rtogAll.val = FALSE
  !this.filterFrame.val = 1

   -- Load configuration settings
  !this.readConfigurationFile()
  handle any
    -- handle error so that constructor completes even if config file is bad
    !!alert.error(!!error.text)
  endhandle
  !this.filterChanged(FALSE)

endmethod
-- End of method definition for .hmMain()


------------------------------------------------------------------------
--
-- Method:      readConfigurationFile
--
-- Description: Read system configuration file (if it exists) and store settings
--              (%PDMSDFLTS%\des-holemgt-config)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readConfigurationFile()

  if(not defined(!!holeManagementConfiguration)) then
    !tempConfig = object HMCONFIG()
    if(!tempConfig.loadConfigurationFile().not()) then
      return error 1 'Error in configuration file. Please Contact your systems administrator'
    endif
  endif

endmethod
-- End of method definition for .readConfigurationFile()


------------------------------------------------------------------------
--
-- Method:      popupListCallback()
--
-- Description: Set/Display the popup menu for the HOLELIST Grid Control
--              arrData[0] = X
--              arrData[1] = Y
--              arrData[2] = Array of row numbers selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupListCallback(!arrData is ARRAY)

  -- Check that some rows are selected before showing the menu
  if (!arrData[2].set()) then

    !this.conHoleListGrid.popup = !this.holeListPopup
    if (!this.ngcHoleList.getSelectedRows().size().neq(1)) then
      !this.holeListPopup.setFieldProperty('navigateToHole','VISIBLE',FALSE)
      !this.holeListPopup.setFieldProperty('focus','VISIBLE',FALSE)
      !this.holeListPopup.setFieldProperty('fixHole','VISIBLE', FALSE )
      !this.holeListPopup.setFieldProperty('addPenetrated','VISIBLE', FALSE )
      !this.holeListPopup.setFieldProperty('fixPenetrated','VISIBLE', FALSE )
      !this.holeListPopup.setFieldProperty('removePenetrated','VISIBLE', FALSE )
    else
      !this.holeListPopup.setFieldProperty('navigateToHole','VISIBLE',TRUE)
      !this.holeListPopup.setFieldProperty('focus','VISIBLE',TRUE)
      !mod = !!module()
      if (!mod.appkey.upcase() neq 'MARHDES' ) then
        !this.holeListPopup.setFieldProperty('fixHole','VISIBLE', FALSE )
      else
        !row = !this.ngcHoleList.getSelectedRows()
        !association = !row[1][1].dbref()
        !hmHole = object HMHOLE(!association)
        !allowAddPen = FALSE
        if (!hmHole.holeOwner.badref().not()) then
          if (!hmHole.holeOwner.type inset('CPLATE', 'HPLATE')) then
            !allowAddPen = TRUE
          endif
        endif
        !hmHole.delete()

        !status      = !row[1][3]
        !valid       = !row[1][4].boolean()
        if (!status neq 'APPROVED' or !valid) then
          !this.holeListPopup.setFieldProperty('fixHole','VISIBLE',FALSE)
        else
          -- is it the hole that has a badref
          !find = object COLLECTION()
          !find.type('ASSMBR')
          !find.scope(!association)
          !find.filter(object EXPRESSION(|lname eq '/PrimaryHole' and badref(amemrf)|))
          !invalidAssMember = !find.results()[1]
          handle (2,752)
            !this.holeListPopup.setFieldProperty('fixHole','VISIBLE',FALSE)
          elsehandle NONE
            !this.holeListPopup.setFieldProperty('fixHole','VISIBLE',TRUE)
          endhandle
        endif
      endif

      !row = !this.ngcHoleList.getSelectedRows()
      !association = !row[1][1].dbref()
      !find = object COLLECTION()
      !find.type('ASSMBR')
      !find.scope(!association)
      !find.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner*') and badref(amemrf)|))
      !invalidAssMembers = !find.results()
      !hmHole = object HMHOLE(!association)
      !allowAddPen = FALSE
      if (!hmHole.holeOwner.badref().not()) then
        if (!hmHole.holeOwner.type inset('CPLATE', 'HPLATE')) then
          !allowAddPen = TRUE
        endif
      endif
      !hmHole.delete()
      if ((!row[1][3] eq '' or !row[1][3] eq 'REQUESTED' or !row[1][3] eq 'REJECTED') and !mod.appkey.upcase() eq 'DES' and !this.marine and !allowAddPen) then
        !this.holeListPopup.setFieldProperty('addPenetrated','VISIBLE',TRUE)
        -- Does the association contain an invalid Hole Owner references
        if (!invalidAssMembers.size() neq 0 ) then
          !this.holeListPopup.setFieldProperty('fixPenetrated','VISIBLE',TRUE)
        else
          !this.holeListPopup.setFieldProperty('fixPenetrated','VISIBLE',FALSE)
        endif
      elseif ((!row[1][3] eq 'APPROVED' or !row[1][3] eq 'REQUESTED' ) and !mod.appkey.upcase() eq 'MARHDES' and !this.marine and !allowAddPen) then
        !this.holeListPopup.setFieldProperty('addPenetrated','VISIBLE',TRUE)
        -- Does the association contain an invalid Hole Owner references
      elseif ((!row[1][3] eq 'APPROVED' or !row[1][3] eq 'REQUESTED' ) and !mod.appkey.upcase() eq 'MARHDES' and !this.marine) then
        if (!invalidAssMembers.size() neq 0 ) then
          !this.holeListPopup.setFieldProperty('fixPenetrated','VISIBLE',TRUE)
          !this.holeListPopup.setFieldProperty('fixHole','VISIBLE',FALSE)
        else
          !this.holeListPopup.setFieldProperty('fixPenetrated','VISIBLE',FALSE)
        endif
      else
        !this.holeListPopup.setFieldProperty('addPenetrated','VISIBLE',FALSE)
        !this.holeListPopup.setFieldProperty('fixPenetrated','VISIBLE',FALSE)
      endif
      if ((!row[1][3] eq '' or !row[1][3] eq 'REJECTED') and !mod.appkey.upcase() eq 'DES' and !this.marine) then
        if (!row[1][4] eq 'FALSE') then
          !association = !row[1][1].dbref()
          -- check that it has additional hole owners and if it has maybe this can be fixed by removing them from the association
          !find = object COLLECTION()
          !find.type('ASSMBR')
          !find.scope(!association)
          !find.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner?')|))
          !test = !find.results()
          if (!test.empty()) then
            !this.holeListPopup.setFieldProperty('removePenetrated','VISIBLE',FALSE)
          else
            !this.holeListPopup.setFieldProperty('removePenetrated','VISIBLE',TRUE)
          endif
        else
          !this.holeListPopup.setFieldProperty('removePenetrated','VISIBLE',FALSE)
        endif
      endif
    endif
    !this.holeListPopup.setFieldProperty('saveUnclaim','VISIBLE',FALSE)
    do !holes values !this.ngcHoleList.getSelectedRows()
      if (!holes[1].dbref().dbexno gt 1) then
        !claimed1 = !holes[1].dbref().exclto
        !claimed2 = !holes[1].dbref().exclhi.empty().not()
        if (!claimed1 or !claimed2) then
          !this.holeListPopup.setFieldProperty('saveUnclaim','VISIBLE',TRUE)
          break
        endif
      else
        if (!holes[1].dbref().lclmh) then
          !this.holeListPopup.setFieldProperty('saveUnclaim','VISIBLE',TRUE)
          break
        endif
      endif
    enddo

   -- Show the popup menu as configured
   !this.conHoleListGrid.showPopup(!arrData[0], !arrData[1])
  endif

endmethod
-- End of method definition for .popupListCallback()

------------------------------------------------------------------------
--
-- Method:      popupDataCallback()
--
-- Description: Set/Display the popup menu for the HOLELIST Grid Control
--              arrData[0] = X
--              arrData[1] = Y
--              arrData[2] = Array of row numbers selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupDataCallback(!arrData is ARRAY)

  -- Check that some rows are selected before showing the menu
  if (defined(!arrData[2]) and !arrData[2].set()) then
    !this.conHoleDataGrid.popup = !this.dataPopup
    if (!this.ngcHoleList.getSelectedRows().size().neq(1)) then
      !this.dataPopup.setFieldProperty('navigateToHoleData','VISIBLE',FALSE)
    else
      !this.dataPopup.setFieldProperty('navigateToHoleData','VISIBLE',TRUE)
    endif
    -- Show the popup menu as configured
    !this.conHoleDataGrid.showPopup(!arrData[0], !arrData[1])
  endif

endmethod
-- End of method definition for .popupDataCallback()

------------------------------------------------------------------------
--
-- Method:      popupValidCallback()
--
-- Description: Set/Display the popup menu for the Validation Results Grid Control
--              arrData[0] = X
--              arrData[1] = Y
--              arrData[2] = Array of row numbers selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupValidCallback(!arrData is ARRAY)

  -- Check that some rows are selected before showing the menu
  if (defined(!arrData[2]) and !arrData[2].set()) then
      !this.conValidation.popup = !this.validationPopup
      -- Show the popup menu as configured
      !this.conValidation.showPopup(!arrData[0], !arrData[1])
  endif

endmethod
-- End of method definition for .popupValidCallback()


------------------------------------------------------------------------
--
-- Method:      popupHistCallback()
--
-- Description: Set/Display the popup menu for the Validation Results Grid Control
--              arrData[0] = X
--              arrData[1] = Y
--              arrData[2] = Array of row numbers selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupHistCallback(!arrData is ARRAY)

  -- Check that some rows are selected before showing the menu
  if (defined(!arrData[2]) and !arrData[2].set()) then
      !this.conHistory.popup = !this.historyPopup
      -- Show the popup menu as configured
      !this.conHistory.showPopup(!arrData[0], !arrData[1])
  endif

endmethod
-- End of method definition for .popupHistCallback()

------------------------------------------------------------------------
--
-- Method:      populateHoleList()
--
-- Description: Gather all Managed Holes for selected items and display in HOLELIST grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateHoleList(!allAssocList is ARRAY)
  -- Clear the HOLE DATA (lower) grid control
  !this.ngcHoleData.clearGrid()
   if (!allAssocList.size().eq(0) OR !allAssocList[1].objectType().neq('DBREF') ) then
     !this.ngcHoleList.clearGrid()
     return
   endif

   -- Clear existing data
   !this.ngcHoleList.clearGrid()
   !arrGridRowData = ARRAY()

   -- Empty the COMMENT field
   !this.comment.val = ''

  -- Process each ASSOC found to generate data for display
   do !assoc values !allAssocList
     !hmHole = object HMHOLE(!assoc)
     !rowData = !this.generateDisplayData(!hmHole)
     !arrGridRowData.append(!rowData)
     !hmHole.delete()
   enddo

   -- Prevent duplication in the grid
   !pkey = ARRAY()
   !checkData = !arrGridRowData
   do !idx index !checkData
     if ( !pkey.findFirst(!checkData[$!idx][1]).set() ) then
       !arrGridRowData[!idx].delete()
       skip
     else
       !pkey.append(!checkData[$!idx][1])
     endif
   enddo

   !this.updateGridFull(!arrGridRowData)

   -- Select first row in the list of holes, this will invoke AfterSelectChange
   -- and the hole data will be updated
   !this.ngcHoleList.selectRow(1)

endmethod
-- End of method definition for .populateHoleList()


------------------------------------------------------------------------
--
-- Method:      UpdateGridFull()
--
-- Description: Load array into grid control and update visually as needed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGridFull(!data is ARRAY)

  using namespace  'Aveva.Pdms.Presentation'

  !arrGridData = !data
  !arrGridData.compress()

   -- Populate using data generated via PML (not mapped to DB items)
   !this.ngcHoleList.clearGrid()
   !nds = object NETDATASOURCE('Holes identified', !this.listHeadings, !arrGridData)
   !this.ngcHoleList.bindToDataSource(!nds)

  -- Highlight any FAILED validations with RED cell background
  if (!this.ngcHoleList.getColumnKey(4).eq('VALID') ) then
    do !row from 1 to !this.ngcHoleList.getNumberRows()
      if (NOT !this.ngcHoleList.getCell(!row, 4).boolean() ) then
        !this.ngcHoleList.setCellColor(!row, 4, 'salmon')
        !iconFile = !!pml.getpathname('exclamation-16.png')
        handle ANY
        -- Icon file does not exist
        elsehandle NONE
          !this.ngcHoleList.setCellImage(!row, 4, !iconFile)
          handle any
          endhandle
        endhandle
      endif

    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      GenerateDisplayData()
--
-- Description: Generate array of column data to be displayed for the supplied HMHOLE element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateDisplayData(!item is HMHOLE) is ARRAY


  !arrReturn = ARRAY()

  !arrReturn[1] = !item.element.fullname
  if (!item.primaryElement.unset()) then
    !arrReturn[2] = 'unset'
  else
    !arrReturn[2] = !item.getHoleOwner().fullname
    handle (2,202)
      -- Invalid reference
      !arrReturn[2] = 'Invalid'
    endhandle
  endif

  !arrReturn[3] = !item.fullStatus
  !arrReturn[4] = !item.validation().string().upcase()
  !arrReturn[5] = !item.holeType

  -- does not define at this time
  !arrReturn[6] = !item.getType()
  !arrReturn[7] = !item.getDesp()
  !arrReturn[8] = !item.getNomBore()
  !arrReturn[9] = !item.getRating()

  !pos = !item.getVirtualHole().position.wrt(world).string().before('WRT')
  handle any
    !pos = object POSITION()
  endhandle
  if (!pos.unset() ) then
    !arrReturn[10] = 'unset'
  else
    !arrReturn[10] = !pos
  endif

  -- Check for additional columns specified in HMCONFIG
  if ( !!holeManagementConfiguration.columns.set() ) then
    !tempArray = !this.extraColumns(!item.element)
    !arrReturn.appendArray(!tempArray[2])
    !this.listHeadings.appendArray(!tempArray[1])
  endif

  return !arrReturn
endmethod
-- End of method definition for .generateDisplayData()

------------------------------------------------------------------------
--
-- Method:      selectedHoleMainChanged()
--
-- Description: Refresh hole data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectedHoleMainChanged(!data is ARRAY)

  if (unset(!data)) then
    return
  endif

  !this.selectedHoleMainAids()
  !this.resetTranslucency()
  !this.showPenetratedTranslucent()

endmethod

------------------------------------------------------------------------
--
-- Method:      selectedHoleMainAids()
--
-- Description: Refresh hole aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectedHoleMainAids()

  !!aidNumbers.hide(!this.aidAxes)
  if( !this.assocAidsToggle.val.not() ) then
    return
  endif
  do !row values !this.assocMemGrid.getSelectedRows()
    !holeRef = !row[1].dbref()
    handle any
      skip
    endhandle
    !this.showSelectedHoleAids(!holeRef)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      selectedHoleChanged()
--
-- Description: Refresh hole data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectedHoleChanged(!data is ARRAY)

  if (unset(!data)) then
    return
  endif

  -- draw hole tags
  !this.selectedHoleAids()

  if (!this.ngcHoleList.getSelectedRows().size() gt 1 ) then
    !this.ngcHoleData.clearGrid()
    !this.ngcValidation.clearGrid()
    !this.ngcHistory.clearGrid()
    !this.showSelectedHoleData()
  else
    !this.showSelectedHoleData()
    !this.showValidationResults()
    !this.showHoleHistory()
  endif

endmethod


------------------------------------------------------------------------
--
-- Method:      selectedHoleMainAids()
--
-- Description: Refresh hole aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectedHoleAids()

  !!aidNumbers.hide(!this.aidAxes)
  if( !this.holeAidsToggle.val.not() ) then
    return
  endif
  do !row values !this.ngcHoleList.getSelectedRows()
    !holeRef = !row[1].dbref()
    handle any
      skip
    endhandle
    !this.showSelectedHoleAids(!holeRef)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      showSelectedHoleAids()
--
-- Description: Show aid graphics for each of the selected Managed Holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSelectedHoleAids(!holeRef is DBREF)

  -- get HMHOLE object for each selected hole
  !holeData    = object HMHOLE(!holeRef)
  !virtualHole = !holeData.getVirtualHole()
  !association = !holeData.getAssociation()
  if( !association.isNamed ) then
    !name = !association.namn
  else
    !name = ''
  endif
  !this.drawAxes(!virtualHole,!name)

endmethod
-- End of method definition for .showSelectedHoleData()

------------------------------------------------------------------------
--
-- Method:      drawAxes
--
-- Description: Draw aid lines showing axes for this penetration
--              The calling function must manage the aid lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number for this aid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawAxes(!virtualHole is DBREF, !tag is STRING)

  if( badref(!virtualHole) ) then
    return
  endif
  !vol             = object LOCALVOLUME(!virtualHole, !virtualHole)
  -- We want XYZ labels in Plant and Marine
  !aidBox          = object GPHBOX(!vol.box())
  if( !tag.empty().not() ) then
    !aidBox.description = !tag
    !aidBox.tag         = true
  endif
  !aidBox.draw(!this.aidAxes,false)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showPenetratedTranslucent
--
-- Description: Make selected penetrated translucent
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number for this aid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPenetratedTranslucent()

  !translucent   = !this.translucentToggle.val

  -- switch back to solid
  if( !translucent.not() ) then
    !this.resetTranslucency()
    return
  endif

  -- get selected elements from table
  !penetrated    = ARRAY()
  do !row values !this.assocMemGrid.getSelectedRows()
    !holeRef     = !row[1].dbref()
    handle any
      skip
    endhandle
    -- get HMHOLE object for each selected hole
    !holeData    = object HMHOLE(!holeRef)
    !holeOwner   = !holeData.getHoleOwner()
    skip if( badref(!holeOwner) )
    !penetrated.append(!holeOwner)
  enddo

  !penetrated.unique()

  -- get global drawlist
  !dl             = object DRAWLIST()
  !globalDrawlist = !dl.globalDrawlist()
  !this.translucentList = ARRAY()
  -- make panel translucent if not already translucent
  do  !panel values !penetrated
    if(!globalDrawlist.translucency(!panel) eq 0) then
      !this.translucentList.append(!panel)
    endif
  enddo

  !globalDrawlist.translucency(!this.translucentList,40)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      resetTranslucency
--
-- Description: reset translucent panels to solid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number for this aid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .resetTranslucency()

  !dl = object DRAWLIST()
  !dl.globalDrawlist().translucency(!this.translucentList,0)
  handle any
  endhandle
  !this.translucentList.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showSelectedHoleData()
--
-- Description: Show data for each of the selected Managed Holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSelectedHoleData()

  !this.comment.val = ''
  -- Generate array of Row Data for display in the grid
  !arrGridRowData = ARRAY()
--  !arrGridColHeading[1] = 'HOLE NAME'
  !arrGridColHeading[1] = 'TYPE'
  !arrGridColHeading[2] = 'ASSOCIATED ITEMS'
  !arrGridColHeading[3] = 'PRIMARY MEMBER'

  !penetratingWrite = ARRAY()
  !penetratedWrite  = ARRAY()
  !holeStatus       = ARRAY()

  -- get HMHOLE object for each selected hole
  !selectedHoleList = ARRAY()
  do !row values !this.ngcHoleList.getSelectedRows()
    !holeRef          = !row[1].dbref()
    handle any
      skip
    endhandle
    !selectedHoleList.append(object HMHOLE(!holeRef))
  enddo

  do !selectedHole values !selectedHoleList

    !hmHole = !selectedHole
    !storedHole = !hmHole
    !rowData = ARRAY()

    -- if PrimaryElement exists
    if (!hmHole.primaryElement.set()) then
      if (NOT BADREF(!hmHole.primaryElement.amemrf) ) then
        !rowData[1] = !hmHole.primaryElement.amemrf.type
        !rowData[2] = !hmHole.primaryElement.amemrf.fullname
        !penetratedWrite.append(!hmHole.primaryElement.amemrf.dbWrite)
      else
        !rowData[1] = '*error*'
        !rowData[2] = '*error*'
        !penetratedWrite.append('error')
      endif
      !rowData[3] = !hmHole.primaryElement.primem.string()
      !arrGridRowData.append(!rowData)
    endif
    -- if Hole Owner exists
    if (!hmHole.holeOwner.set()) then
      if (NOT BADREF(!hmHole.holeOwner)) then
        !penetratingWrite.append(!hmHole.holeOwner.dbWrite)
      else
        !penetratingWrite.append('Invalid')
      endif
    endif
    !holeStatus.append(!hmHole.status)
    -- Process each of the secondaryElements
    do !index index !hmHole.secondaryElements
--      !rowData[1] = !hmHole.element.fullname
      if (NOT BADREF(!hmHole.secondaryElements[$!index].amemrf) ) then
        !rowData[1] = !hmHole.secondaryElements[!index].amemrf.type
        !rowData[2] = !hmHole.secondaryElements[!index].amemrf.fullname
      else
        !rowData[1] = '*error*'
        !rowData[2] = '*error*'
      endif
      !rowData[3] = !hmHole.secondaryElements[!index].primem.string()
      !arrGridRowData.append(!rowData)
    enddo

    !this.comment.val = !hmHole.comment

    !hmHole.delete()
  enddo
    -- Check Originator and Reviewer access of currently selected holes
    -- If they all have the same access and status then update the access otherwise
    -- grey out all the tasks
    !penetratingWrite.unique()
    !penetratedWrite.unique()
    !holeStatus.unique()
    if (!penetratingWrite.size() neq 1 or !penetratedWrite.size() neq 1 or !holeStatus.size() neq 1 ) then
      !this.request.active    = FALSE
      !this.redundant.active  = FALSE
      !this.cancel.active     = FALSE
      !this.deleteV.active    = FALSE
      !this.approve.active    = FALSE
      !this.reject.active     = FALSE
      !this.deleteR.active    = FALSE
    else
      !this.updateUserAccess(!storedHole)
    endif

  if (!this.ngcHoleList.getSelectedRows().size() eq 1 ) then

    using namespace  'Aveva.Pdms.Presentation'
    !this.ngcHoleData.clearGrid()
    !total = !this.ngcHoleList.getSelectedRows().size()
    !displayText = !total.string() + ' hole selected'
    if (!total.gt(1) ) then
      !displayText = !total.string() + ' holes selected'
      !this.comment.val = ''
    endif

    !nds = object NETDATASOURCE(!displayText, !arrGridColHeading, !arrGridRowData)
    !this.ngcHoleData.bindToDataSource(!nds)
  endif
  return

endmethod
-- End of method definition for .showSelectedHoleData()

------------------------------------------------------------------------
--
-- Method:      showValidationResults()
--
-- Description: Show validation results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showValidationResults()

  using namespace 'Aveva.Pdms.Presentation'

  !this.ngcValidation.clearGrid()

   -- Define column headings
  !headings = ARRAY()
  !headings.append('Test carried out')
  !headings.append('Result')

  !dataRows = ARRAY()
  if( defined(!!restrictionerrors) ) then
    -- reset error logging
    !!restrictionerrors.initialise()
  endif
  if (defined(!!debug)) then
    --kept in as an example of how to set up the restriction error logging
    !!setRestrictionLogging(TRUE, FALSE)
  endif
  !restrictList = ARRAY()
  do !selected values !this.ngcHoleList.getSelectedRows()

    -- handle delete penetration
    !holeRef = !selected[1].dbref()
    handle any
      skip
    endhandle

     -- create HMHOLE object for current ASSOC element
    !hmHole = object HMHOLE(!holeRef)

    -- Grab a list of all RESTRI elements
    !restrictList = !hmHole.findMemberElement(|RESTRI|, object EXPRESSION(|TRUE|) )
    do !restrictElem values !restrictList
      !answ = object ARRAY()
      !answ[1] = 'unset'
      if (NOT !restrictElem.description.empty() ) then
        !answ[1] = !restrictElem.description
      endif

      !answ[2] = !this.testEval(!restrictElem.string())
      !dataRows.append(!answ)
    enddo
  enddo
  if (defined(!!debug)) then
    !!setRestrictionLogging(FALSE, FALSE)
  endif
  -- Bind data to the control and display it
  !nds = object NETDATASOURCE('Hole validation results', !headings, !dataRows)
  !this.ngcValidation.bindToDataSource(!nds)

  -- Set the tooltips to display the results of the validation
  -- Highlight any FAILED validations with RED cell background (before GROUPing!)
  do !row from 1 to !this.ngcValidation.getNumberRows()
    if ( !this.ngcValidation.getCell(!row, 2) inset ('Failed','Invalid') ) then
      !this.ngcValidation.setCellColor(!row, 2, 'salmon')
      !iconFile = !!pml.getpathname('exclamation-16.png')
      handle ANY
        -- Icon file does not exist
      elsehandle NONE
          !this.ngcValidation.setCellImage(!row, 2, !iconFile)
      endhandle
    else
      !this.ngcValidation.setCellImage(!row, 2, '')
      !this.ngcValidation.setCellColor(!row, 2, 'springgreen')
    endif
    --return the cached restriction error
    !errorStr = !!getRestrictionError(!restrictList[!row], !row)
    !this.ngcValidation.setCellTooltip(!row, 2, !errorStr)
    !dataRows[!row].append(!errorStr)
  enddo
  !this.validationResults = !dataRows

endmethod
-- End of method definition for .showValidationResults()

------------------------------------------------------------------------
--
-- Method:      showHoleHistory()
--
-- Description: Show hole history
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showHoleHistory()

  using namespace 'Aveva.Pdms.Presentation'

  !this.ngcHistory.clearGrid()

  -- define column headings
  !headings = ARRAY()
  !headings.append('DATE')
  !headings.append('USER')
  !headings.append('STATUS')
  !headings.append('DESCRIPTION')

  !arrGridRowData = object ARRAY()

  !indexTotal = 1

  do !rowTag values !this.ngcHoleList.getSelectedRowTags()
    !rows = !this.ngcHoleList.getRow( !rowTag.real() )

     -- set assoc element
    !itemDbRef = !rows[1].dbref()

    -- create HMHOLE object with assoc element
    !hmHole = object HMHOLE(!itemDbRef)

    -- query of history
    !statusHistory = object ARRAY()
    !statusHistory = !hmHole.getstatusHistory()

    !indexHistory = 1
    do !data values !statusHistory
      !arrGridRowData[$!indexTotal] = object ARRAY()

      -- Generate more user-friendly date format
      !fields = !data.split('|')
      !arrGridRowData[$!indexTotal].append(!fields[1].substring(1,4) + '-' + !fields[1].substring(5,2) + '-' + !fields[1].substring(7,2) + ' ' + !fields[1].substring(9,2) + ':' + !fields[1].substring(11,2) )

      -- Add remaining data fields
      !arrGridRowData[$!indexTotal].append(!fields[2])
      if (!fields[3].eq('') ) then
        !arrGridRowData[$!indexTotal].append(!hmHole.translateStatus(object STRING()) )
      else
        !arrGridRowData[$!indexTotal].append(!hmHole.translateStatus(!fields[3]) )
      endif
      !arrGridRowData[$!indexTotal].append(!fields[4])
      !indexTotal = !indexTotal + 1
      !indexHistory = !indexHistory + 1
    enddo
    !hmHole.delete()

  enddo

  -- Populate using data generated via PML (not mapped to DB items)
  !nds = object NETDATASOURCE('Hole status history', !headings, !arrGridRowData)
  !this.ngcHistory.bindToDataSource(!nds)

endmethod
-- End of method definition for .showValidationResults()

------------------------------------------------------------------------
--
-- Method:      updateGraphics()
--
-- Description: Update graphical view to focus on specified items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGraphics(!itemList is ARRAY, !mode is STRING)


  -- If standard view is set then update it otherwise gracefully ignore this
  if ( !!gphViews.views.set() ) then
    AUTOCOLOUR ON
    UNENHANCE ALL
    --  Add items in !itemList to 3D view
    if(!mode.eq('ADD')) then
      do !i values !!gphDrawLists.drawLists
        !i.addMembers(!itemList)
      enddo
      do !element values !itemList
        do !i values !!gphDrawLists.drawLists
          !i.add(!element)
          if (!element.type eq 'FIXING') then
            !i.colour(!element,6)
          endif
        enddo
      enddo

    --  Remove items in !itemList from 3D view
    elseif(!mode.eq('REM')) then
      do !i values !!gphDrawLists.drawLists
        !i.removeMembers(!itemList)
      enddo
    endif

  endif

  return

endmethod
-- End of method definition for .updateGraphics()


------------------------------------------------------------------------
--
-- Method:      .gridSelectedCheck()
--
-- Description: Check whether any rows are currently selected on grid
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gridSelectedCheck() is BOOLEAN

  if (NOT !this.ngcHoleList.getSelectedRows().set()) then
    !!alert.error('No managed holes have been selected')
    return FALSE
  endif

  return TRUE

endmethod
-- End of method definition for .gridSelectedCheck()


------------------------------------------------------------------------
--
-- Method:      .submitRequest()
--
-- Description: For each selected hole, update status to be REQUESTED
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .submitRequest()

  if (!this.gridSelectedCheck()) then
     -- Conform the user wants to proceed with status change
     !answer = !!alert.confirm('Do you really want to change the status to REQUESTED?')
     if(!answer.eq('YES')) then
       !hmControl = object HMCONTROL()
       -- Work on each HOLE selected
       do !rowTag values !this.ngcHoleList.getSelectedRowTags()
         !row = !this.ngcHoleList.getRow( !rowTag.real() )
         !hmHole = object HMHOLE( !row[1].dbref() )
         if ( !hmControl.submitRequest(!hmHole) ) then
           if (!this.ngcHoleList.getColumnKey(3).eq('STATUS') ) then
             !this.updateGridCell(!rowTag.real(), 3, !hmHole.getFullStatus() )
           endif
         endif
       enddo
      -- Refresh Originator and Reviewer access of current hole
      !this.updateUserAccess(!hmHole)
      -- Update hole history
      !this.showHoleHistory()
    endif
  endif

endmethod
-- End of method definition for .submitRequest()


------------------------------------------------------------------------
--
-- Method:      .redundantRequest()
--
-- Description: For each selected hole, update status to be REDUNDANT
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
