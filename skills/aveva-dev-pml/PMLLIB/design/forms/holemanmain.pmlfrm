    !hmControl = object HMCONTROL()
     -- Conform the user wants to proceed with status change
    !answer = !!alert.confirm('Do you really want to change the status to REJECTED?')
    if(!answer.eq('YES')) then
      -- Work on each HOLE selected
      do !rowTag values !this.ngcHoleList.getSelectedRowTags()
        !row = !this.ngcHoleList.getRow( !rowTag.real() )
        !hmHole = object HMHOLE( !row[1].dbref() )
        if ( !hmControl.rejectRequest(!hmHole) ) then
          if (!this.ngcHoleList.getColumnKey(3).eq('STATUS') ) then
            !this.updateGridCell(!rowTag.real(), 3, !hmHole.getFullStatus() )
          endif
        endif
      enddo
      -- Refresh Originator and Reviewer access of current hole
     !this.updateUserAccess(!hmHole)
     -- Update hole history
     !this.showHoleHistory()
     -- Update hole data
     !this.showSelectedHoleData()
    endif
  endif

endmethod
-- End of method definition for .rejectRequest()


------------------------------------------------------------------------
--
-- Method:      .approveRedundantRequest()
--
-- Description: For each selected hole, update status following REDUNDANT request
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .approveRedundantRequest()

  if (!this.gridSelectedCheck()) then

     -- Conform the user wants to proceed with status change
    !answer = !!alert.confirm('Do you really want to change the status to WITHDRAWN?')
    if(!answer.eq('YES')) then

       !hmControl = object HMCONTROL()

       -- Work on each HOLE selected
       do !rowTag values !this.ngcHoleList.getSelectedRowTags()

         !row = !this.ngcHoleList.getRow( !rowTag.real() )
         !hmHole = object HMHOLE( !row[1].dbref() )

         if ( !hmControl.withdrawRequest(!hmHole) ) then
           if (!this.ngcHoleList.getColumnKey(3).eq('STATUS') ) then
             !this.updateGridCell(!rowTag.real(), 3, !hmHole.getFullStatus() )
           endif
         endif

       enddo

       -- Refresh Originator and Reviewer access of current hole
      !this.updateUserAccess(!hmHole)
      -- Update hole history
      !this.showHoleHistory()
      -- Update hole data
      !this.showSelectedHoleData()
    endif
  endif

endmethod
-- End of method definition for .approveRedundantRequest()

------------------------------------------------------------------------
--
-- Method:      .saveComment()
--
-- Description: For every hole selected, update the COMMENT using form input
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveComment()

  -- Check if any rows have been selected
  if (NOT !this.gridSelectedCheck() ) then
    !this.comment.val = ''
    return
  endif

  if ( !this.ngcHoleList.getSelectedRows().size().eq(1) ) then
    do !idx index !this.ngcHoleList.getSelectedRows()
      !myHole = object HMHOLE( !this.ngcHoleList.getSelectedRows()[$!idx][1].dbref() )
      !myHole.setComment(!this.comment.val)
    enddo
  else
    !!alert.warning('Comment functionality disabled for multi-hole selections')
  endif

endmethod
-- End of method definition for .saveComment()

------------------------------------------------------------------------
--
-- Method:      .applyCellChanges()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCellChanges(!data is ARRAY)

$(  q var !data
<ARRAY>
   [0]  <STRING> '1234'
   [1]  <STRING> '1'
   [2]  <STRING> 'Example1'
   [3]  <BOOLEAN> TRUE
   $)

  !safeCE = !!ce

-- Find the column in the CONFIG data
  !configColumns = !!holeManagementConfiguration.columns
  do !idx index !configColumns

    if ( !configColumns[!idx].match(!data[2]).gt(0) ) then
      !attrib = !configColumns[!idx].split('#')[2]

      !row = !data[1].real() - 1
      !tmpHole = object HMHOLE( !this.ngcHoleList.getCell(!row, 1).dbref() )
      handle any
        !data[3] = FALSE
        !!alert.error('Update failed - ' + !!error.text)
        return
      endhandle
      !!ce = !tmpHole.element
      !checkType = !!ce.attribute(!attrib)
      if (!checkType.objectType().eq('STRING') ) then
        !update = '$!attrib |$!data[0]| '
      elseif (!checkType.objectType().eq('REAL') ) then
        !update = |$!attrib | + !data[0].real().string()
        handle (2,441)
          !data[3] = FALSE
          !!alert.error('Update failed - ' + !!error.text)
          return
        endhandle
      else
         !update = |$!attrib $!data[0]|
      endif
      $!update
      handle any
        !data[3] = FALSE
        !!alert.error('Update failed - ' + !!error.text)
      elsehandle none
      endhandle
      break
    endif
  enddo

  !!ce = !safeCE
endmethod
-- End of method definition for .applyCellChanges()


------------------------------------------------------------------------
--
-- Method:      .updateGridCell()
--
-- Description: Update a single grid cell (rather than refresh entire grid)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGridCell(!row is REAL, !col is REAL, !value is STRING)

  !this.ngcHoleList.setCellValue(!row, !col, !value)

endmethod


------------------------------------------------------------------------
--
-- Method:      .enableReviewer()
--
-- Description: Switch Reviewer fields on/off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1         BOOLEAN      True if user has reviewer access
--                           Activate/deactivate reviewer options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enableReviewer(!enable is BOOLEAN, !hmHole is HMHOLE)

  if (!enable) then

    !status = !hmHole.getStatus()

    if(!status.eq('') OR !status.unset() OR !status.eq('REJE') OR !status.eq('WITH')) then
       !this.approve.active = FALSE
       !this.reject.active  = FALSE
       !this.deleteR.active = FALSE
    elseif(!status.eq('REQU')) then
       !this.approve.active = TRUE
       !this.reject.active  = TRUE
       !this.deleteR.active = FALSE
    elseif(!status.eq('APPR')) then
       !this.approve.active = FALSE
       !this.reject.active  = TRUE
       !this.deleteR.active = FALSE
    elseif(!status.eq('REDU') ) then
       !this.approve.active = FALSE
       !this.reject.active  = FALSE
       !this.deleteR.active = TRUE
    endif
  else
   !this.approve.active = FALSE
   !this.reject.active  = FALSE
   !this.deleteR.active = FALSE
  endif

-- If in Marine, the reviewer has no access in outfitting
  !mod = !!module()
  !hmHoleRef = !hmHole.getHoleOwner()
  if( badref(!hmHoleRef) and !mod.appkey eq 'marhdes') then
    -- don't allow any change if ref is bad (should not happen)
    !this.approve.active = FALSE
    !this.reject.active  = TRUE
    !this.deleteR.active = FALSE
    return
  elseif( badref(!hmHoleRef) and !mod.appkey eq 'des') then
    -- don't allow any change if ref is bad (should not happen)
    !this.approve.active = FALSE
    !this.reject.active  = FALSE
    !this.deleteR.active = FALSE
    return
  endif

  !isHullElement = !hmHoleRef.hullPr or !hmHoleRef.hullDe

  if (!mod.appkey eq 'des' and !isHullElement or !mod.appkey eq 'marhdes' and !isHullElement.not() ) then
    -- wrong module for owning element type
    !this.approve.active = FALSE
    !this.reject.active  = FALSE
    !this.deleteR.active = FALSE
  endif


endmethod


------------------------------------------------------------------------
--
-- Method:      .enableOriginator()
--
-- Description: Switch Originator fields on/off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1         BOOLEAN      True if user has originator access
--                           Activate/deactivate originator options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enableOriginator(!enable is BOOLEAN, !hmHole is HMHOLE)

 if (!enable) then

    !status = !hmHole.getStatus()

    if(!status.eq('') OR !status.unset()) then
       !this.request.active    = TRUE
       !this.redundant.active  = FALSE
       !this.cancel.active     = FALSE
       !this.deleteV.active    = TRUE
    elseif(!status.eq('REQU')) then
       !this.request.active    = FALSE
       !this.redundant.active  = FALSE
       !this.cancel.active     = TRUE
       !this.deleteV.active    = TRUE
    elseif(!status.eq('REJE')) then
       !this.request.active    = TRUE
       !this.redundant.active  = FALSE
       !this.cancel.active     = TRUE
       !this.deleteV.active    = TRUE
    elseif(!status.eq('APPR')) then
       !this.request.active    = FALSE
       !this.redundant.active  = TRUE
       !this.cancel.active     = FALSE
       !this.deleteV.active    = FALSE
    elseif(!status.eq('REDU') ) then
       !this.request.active    = FALSE
       !this.redundant.active  = FALSE
       !this.cancel.active     = FALSE
       !this.deleteV.active    = FALSE
    elseif(!status.eq('WITH') ) then
       !this.request.active    = FALSE
       !this.redundant.active  = FALSE
       !this.cancel.active     = FALSE
       !this.deleteV.active    = TRUE
    endif
    if (!hmHole.valid.not()) then
      !this.deleteV.active    = TRUE
    endif

 else
    !this.request.active    = FALSE
    !this.redundant.active  = FALSE
    !this.cancel.active     = FALSE
    !this.deleteV.active    = FALSE
 endif

 -- If in Marine, the originator has no access in hull design
 !mm = object AVEVAMODULEMANAGER()
 if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then

   !mod = !!module()
   if (!mod.appkey eq 'marhdes') then
     !this.request.active    = FALSE
     !this.redundant.active  = FALSE
     !this.cancel.active     = FALSE
     !this.deleteV.active    = FALSE
   endif
 endif


endmethod

------------------------------------------------------------------------
--
-- Method:      updateUserAccess()
--
-- Description: Check Originator and Reviewer access of currently selected hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1          HMHOLE      Hole object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateUserAccess(!hmHole is HMHOLE)

     if (!hmHole.valid) then
       -- Reviewer options are enabled if the user has
       -- write access to the hole owner e.g. the PANEL
       if (!hmHole.holeOwner.dbWrite) then
          !this.enableReviewer(TRUE,!hmHole)
       else
          !this.enableReviewer(FALSE,!hmHole)
       endif
     endif

    -- Add the option of enabling the reviewer options if the penetrated item has lost its
    -- reference
    if(badref(!hmHole.holeOwner) ) then
      !this.enableReviewer(TRUE,!hmHole)
    endif

    -- Originator options are enabled if the user has write access
    -- to the association member's reference e.g. the PIPE
    if (badref(!hmHole.primaryElement.amemrf)) then
       !this.enableOriginator(TRUE,!hmHole)
    elseif (!hmHole.primaryElement.amemrf.dbWrite) then
       !this.enableOriginator(TRUE,!hmHole)
    else
       !this.enableOriginator(FALSE,!hmHole)
    endif

    -- Enable comments to be written if the user has Reviewer or Originator access
    if ((!hmHole.holeOwner.dbWrite) OR (!hmHole.primaryElement.amemrf.dbWrite)) then
      !this.comment.active = TRUE
      !this.commentOK.active = TRUE
    else
      !this.comment.active = FALSE
      !this.commentOK.active = FALSE
    endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .navigateToHole()
--
-- Description: Navigate to selected item in the hole list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateToHole()

  --Get the selected item
  !selectedItem = !this.ngcHoleList.getSelectedRows()
  !!ce = !selectedItem[1][1].dbref()

endmethod

------------------------------------------------------------------------
--
-- Method:      .navigateToHoleData()
--
-- Description: Navigate to selected hole data item
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateToHoleData()

  -- Only navigate to selection if one item is selected
  if(!this.getSelectedHoleData().size().eq(1)) then
     -- Get the DBREF of selected item
    !holeDataRef = !this.getSelectedHoleData()
    if(!holeDataRef.set()) then
      !navigateElement = !holeDataRef [1]
      --Navigate to element
      if (!navigateElement.set()) then
        !!ce = !navigateElement
      endif
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .getSelectedHoleData()
--
-- Description: Get selected hole data item
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       Selected Hole Data's DBREF
------------------------------------------------------------------------
define method .getSelectedHoleData() is ARRAY

  !holeDataRef = ARRAY()
  do !item values !this.ngcHoleData.getSelectedRows()
    --Get the selected item
    -- Get the DBREF of selected item
    !holeDataRef.append(!item[2].dbref())
     handle (47,50) $* Invalid Reference
     endhandle
    -- Return selected Hole Data's DBREF
  enddo
  return !holeDataRef

endmethod


------------------------------------------------------------------------
--
-- Method:      .collectDrawlistItems()
--
-- Description: Collect an array of items that need to be added/removed from
--              the drawlist based on the current selection in the hole list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       Items to be added/removed in the drawlist
------------------------------------------------------------------------
define method .collectDrawlistItems(!rows is ARRAY ) is ARRAY

  -- Array of items to be added/removed in the drawlist
  !viewList = ARRAY()

  -- Get all selected rows
  do !row values !rows

    !holeRef = !row[1].dbref()
    handle any
      skip
    endhandle

    -- Create a new HMHOLE object given a DBREF
    !hmHole = object HMHOLE(!holeRef)

    -- Check if PrimaryElement exists
    if (!hmHole.primaryElement.set()) then
      if (NOT BADREF(!hmHole.primaryElement.amemrf) ) then
        !viewList.append(!hmHole.primaryElement.amemrf)
      endif
    endif

    -- Process each of the secondaryElements
    do !index index !hmHole.secondaryElements
      if (NOT BADREF(!hmHole.secondaryElements[$!index].amemrf) ) then
        !viewList.append(!hmHole.secondaryElements[!index].amemrf)
      endif
    enddo

    -- Destroy hole object
    !hmHole.delete()

  enddo

  -- Return array of items to be added/removed from drawlist
  return !viewList

endmethod

------------------------------------------------------------------------
--
-- Method:      .returnToAssocs()
--
-- Description: Show Hole Association Pane and refresh items in case any
--              have been deleted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .returnToAssocs()
  !this.mainTasks(TRUE)
  !this.updateAssocs()
  !this.highlightAssocMemGrid()
  !this.selectedHoleMainAids()
  !this.resetTranslucency()
  !this.showPenetratedTranslucent()

endmethod

------------------------------------------------------------------------
--
-- Method:      .saveUnclaim()
--
-- Description: Savework and then unclaim the holes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .saveUnclaim(!rows is ARRAY)

!!runMacro('/%PDMSUI%/DES/GEN/MSAVEW','')
if (!!answer.boolean()) then
  do !holes values !rows
    !assoc = !holes[1].dbref()
    -- If the association is in an extract then issue it
    if (!assoc.dbexno gt 1) then
      !hole = object HMHOLE(!assoc)
      !hole.issueHole()
    elseif (!holes[1].dbref().lclmh) then
      !hole = object HMHOLE(!assoc)
      !hole.unclaimHole()
    endif
  enddo
endif

!this.showAssocs(!this.btnRefresh,'')

endmethod

------------------------------------------------------------------------
--
-- Method:      .focusOnHole()
--
-- Description: focus the current view on the hole
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .focusOnHole(!rows is ARRAY)

 -- Find the selected hole
 !hmHole = object HMHOLE(!rows[1][1].dbref())
 -- !position = !hmHole.origin
 !position = !hmHole.getVirtualHole().position
 handle any
   !position = !hmHole.origin
 endhandle
 if( !position.unset() ) then
   !!alert.warning('Cannot focus on this hole. Hole position data is not set')
   return
 endif
 -- Set through array using MM values
 !through[1]       = !!comValueConvert(!position.east,'MM')
 !through[2]       = !!comValueConvert(!position.north,'MM')
 !through[3]       = !!comValueConvert(!position.up,'MM')
 -- calculate volume for view
 !virtualHole = !hmHole.virtualHole
  if( not badref(!virtualHole) ) then
    !volume = object VOLUME(!virtualHole)
    -- expand by 500mm
    !viewRadius = !volume.from.distance(!volume.to) + 500mm
  else
    !viewRadius = 500mm
 endif

  --Build the positions
  !limits[1] =  object POSITION('E ' & (!position.east - (!viewRadius / 2)) & ' N ' & (!position.north - (!viewRadius / 2)) & ' U ' & (!position.up - (!viewRadius / 2)) & ' WRT WORLD')
  !limits[2] =  object POSITION('E ' & (!position.east + (!viewRadius / 2)) & ' N ' & (!position.north + (!viewRadius / 2)) & ' U ' & (!position.up + (!viewRadius / 2)) & ' WRT WORLD')
  --Create a volume object
  !volume = object VOLUME(!limits[1],!limits[2])

 -- find the current selected view
 !fmsys = object FMSYS()
 !form  = !fmsys.currentDocument()
 !form.view.through = !through
 !form.view.radius  = !!comValueConvert(!viewRadius,'MM')

  if (!form.view.clipping) then
    --Clip the volume
    !!gphViews.clipboxElement(!form.view,!volume)
  endif

  --Set the limits
  !!gphViews.limits(!form.view,!volume)

endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyHole()
--
-- Description: Modify the selected hole
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .modifyHole(!rows is ARRAY)

  !mod = !!module()
  if( !mod.appkey.upcase() eq 'MARHDES' ) then
    !!alert.error( 'Holes must be modified in the outfitting module')
    return
  endif

  !saveCE = !!ce
  !!ce = !this.assoc
  !!hmModify()
  !!ce    = !saveCE
  handle any
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      .updateAssocs()
--
-- Description: update the current association list when
--              returning from the hole management task
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateAssocs()

  using namespace  'Aveva.Pdms.Presentation'

  -- Update the association with the latest status
  !row = 1
  !deletedRows = ARRAY()
  !selectedRow = !this.assocMemGrid.getSelectedRowTags()

  do !association values !this.assocMemGrid.getSelectedRows()
    !hole = object HMHOLE(!association[1].dbref())
    handle ANY
      -- Association has been deleted
      !deletedRows.append(!selectedRow[!row].real())
    elsehandle NONE
      !status = !hole.status
      !this.assocMemGrid.setCellValue(!selectedRow[!row].real(), 3, !status)
      !valid = !this.testEval(!association[1])
      !this.assocMemGrid.setCellValue(!selectedRow[!row].real(), 4, !valid)
      if (!hole.element.dbexno gt 1) then
        !claimed1 = !hole.element.exclto
        !claimed2 = !hole.element.exclhi.empty().not()
        if (!claimed1 or !claimed2) then
          !claimed = TRUE
        else
          !claimed = FALSE
        endif
      else
        !claimed = !hole.element.lclmh
      endif
      if (!claimed) then
        !claimedStr = 'YES'
      else
        !claimedStr = 'NO'
      endif
      !this.assocMemGrid.setCellValue(!selectedRow[!row].real(), 5, !claimedStr)
    endhandle
    !row = (!row + 1 )
  enddo
  if (!deletedRows.size() gt 0 ) then
    !this.assocMemGrid.deleteRows(!deletedRows)
    handle any
    endhandle
  endif
  !this.highlightAssocMemGrid()
  !this.updateSelectedList()

endmethod
------------------------------------------------------------------------
--
-- Method:      .applyFilter()
--
-- Description: filter the current association list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .applyFilter()

  using namespace  'Aveva.Pdms.Presentation'

  !grid = ARRAY()
  !selection = !this.filterModeSelected
  !discipline = !this.filterDiscipline.selection()
  !filterStatus = !this.filterStatus.selection()
  if (!filterStatus EQ 'Unset') then
    !filterStatus = ''
  endif
  !filterClaimed = !this.filterClaimed.selection()
  if (!selection lt 3) then
    !this.showAssocs(!this.returnBtn,'')
    return
  else
    !this.showAssocs(!this.btnRefresh,'')
    return
  endif
  -- Clear any existing data
  !this.assocMemGrid.clearGrid()

  !headings = ARRAY()
  !headings.append('Association')
  !headings.append('Discipline')
  !headings.append('Status')
  !headings.append('Valid')
  !headings.append('Claimed')
  !headings.append('Penetrated Item')
  !headings.append('Penetrating Item')

  !nds = object NETDATASOURCE('Associations', !headings, !grid )
  !this.assocMemGrid.bindToDataSource(!nds)

  !this.highlightAssocMemGrid()

  --Select first row
  !this.assocMemGrid.selectRow(1)

endmethod
------------------------------------------------------------------------
--
-- Method:      .validateAssocs()
--
-- Description: update the selected association list with the
--              validation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .validateAssocs()

  using namespace  'Aveva.Pdms.Presentation'


    -- Update the association with the latest status
  !row = 1
  !selectedRow = !this.assocMemGrid.getRows()

    -- Show the progress
  !progressMax = !this.assocMemGrid.getSelectedRows().size()
  if (!progressMax le 0) then
    !progressMax = 1
  endif
  if (!progressMax eq 0 ) then
    return
  endif
  !this.progressMessage.val = 'Validating Hole Associations - Please Wait'
  !this.progressMessage.refresh()
  !progressIncrement = 100 / !progressMax
  !progress          = 0
  !this.showProgress(0)
  do !association values !this.assocMemGrid.getSelectedRows()
    !valid = !this.testEval(!association[1])
    do !count index !selectedRow
      if (!selectedRow[!count][1] eq !association[1]) then
        !this.assocMemGrid.setCellValue(!count.real(), 4, !valid)

      endif
    enddo
    !row = (!row + 1 )
    !progress = !progress + !progressIncrement
    !this.showProgress(!progress)

  enddo

  !this.highlightAssocMemGrid()
  !this.showProgress(0)
  !this.progressMessage.val = ''
  !this.progressMessage.refresh()
endmethod
------------------------------------------------------------------------
--
-- Method:      .highlightAssocMemGrid()
--
-- Description: highlight failed and invalid associations on the main grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .highlightAssocMemGrid()

  !numberOfRows = !this.assocMemGrid.getNumberRows()
  if( !numberOfRows eq 0 ) then
    return
  endif
  -- Highlight any FAILED or Invalid validations with RED cell background
  do !column from 1 to !this.assocMemGrid.getnumberColumns()
    do !row from 1 to !numberOfRows
      !this.assocMemGrid.setCellImage(!row, !column, '')
      if (!this.assocMemGrid.getCell(!row, !column) EQ 'Invalid' OR !this.assocMemGrid.getCell(!row, !column) EQ 'Failed' ) then
        !this.assocMemGrid.setCellColor(!row, !column, 'salmon')
        !iconFile = !!pml.getpathname('exclamation-16.png')
        handle ANY
        -- Icon file does not exist
        elsehandle NONE
          !this.assocMemGrid.setCellImage(!row, !column, !iconFile)
          handle any
            !!alert.error(|Error setting cell icon - | + !!error.text)
          endhandle
        endhandle
      elseif (!this.assocMemGrid.getCell(!row, !column) EQ 'Passed') then
        !this.assocMemGrid.setCellColor(!row, !column, 'springgreen')
      endif

    enddo
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      showProgress
--
-- Description: Update progress bar
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showProgress(!percent is REAL)

  if (!percent lt 0) then
    !!fmsys.setProgress(0)
  else
    !!fmsys.setProgress(!percent)
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getHolesFor
--
-- Description: Get holes for the given element
--              BEWARE THIS IS CALLED RECURSIVELY
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference of item
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of string hole Assoc References
--
------------------------------------------------------------------------

define method .getHolesFor(!item is DBREF) is ARRAY

  !assocHole = ARRAY()
  -- Find associations for this element
  !assocList = !item.assos
  handle any
    !assocList = ARRAY()
  endhandle
  do !assoc values !assocList
    -- avoid MDS RESTRI element
    skip if( !assoc.type neq 'ASSOC' )
    !purpose = !assoc.owner.purp
    handle any
      skip
    endhandle
    skip if(!purpose neq  'HOLE')
    !assocHole.append(!assoc.string())
  enddo

  if( !assocHole.empty() ) then
    -- climb to owner if referenced for some types
    !owner = !item.owner
    if (!owner.hardType inset( 'CPROTR', 'CSURPX'  )) then
      !owner = !item.hrdprx[1]
    endif
    if( !owner.hardType inset('HPANEL', 'CPANEL', 'BRAN') ) then
      -- BEWARE THIS IS CALLED RECURSIVELY
      !assocHole = !this.getHolesFor( !owner )
    endif
  endif

  if( !assocHole.empty() ) then
    -- see if the element is an ASSOC
    !types[1] = 'ASSOC'
    !assocRef = !!dtbOwnerOfTypes( !item, !types )
    if( not badref( !assocRef ) ) then
      if( !assocRef.owner.purp eq 'HOLE' ) then
        !assocHole[1] = !assocRef.string()
      endif
    endif
  endif

  return !assocHole

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .edgPickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .edgPickPenetrated(!option is STRING)

  !!edgCntrl.remove('Pick Penetrated object')
  -- Define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick item in which a hole will be created')
  !packet.description    = !this.penetratedPacketDesc
  !packet.priority       = 3
  !packet.close          = '!!holeManMain.setPenetrated(FALSE)'
  if (!option eq 'FIX') then
    !packet.action         = '!!holeManMain.pickPenetrated(!this.return[1])'
  elseif (!option eq 'ADD') then
    !packet.action         = '!!holeManMain.pickAddPenetrated(!this.return[1])'
  endif
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|HPLATE|,|CPLATE|)'
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !packet.remove = TRUE

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
--
-- Method:      .setPenetrated()
--
-- Description: Set to True if currently in a penetrated EDG pick cycle
--              False otherwise
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .setPenetrated(!state is BOOLEAN)

  !this.isPenetratedPick = !state

endmethod

------------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetrated(!data is EDGPICKDATA)

  !item = !data.item
  !this.penetratedRaw = !item
  if( !item.hardType eq 'HPLATE' ) then
    -- add the HPANEL
    !item = !item.owner
  elseif( !item.hardType eq 'CPLATE' ) then
    -- add the CPANEL
    !item = !item.hrdprx[1]
    handle any
      !!alert.error('Selected curved plate does not have a curved hull panel. Only curved hull panels can be penetrated')
      return
    endhandle
  endif

  !this.penetrated = !item
  !this.fixPenetrated()

endmethod
------------------------------------------------------------------------
--
-- Method:      .pickAddPenetrated()
--
-- Description: EDG callback for penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickAddPenetrated(!data is EDGPICKDATA)

  !item = !data.item
  !this.penetratedRaw = !item
  if( !item.hardType eq 'HPLATE' ) then
    -- add the HPANEL
    !item = !item.owner
  elseif( !item.hardType eq 'CPLATE' ) then
    -- add the CPANEL
    !item = !item.hrdprx[1]
    handle any
      !!alert.error('Selected curved plate does not have a curved hull panel. Only curved hull panels can be penetrated')
      return
    endhandle
  endif

  !this.penetrated = !item
  !this.addPenetrated()

endmethod
------------------------------------------------------------------------
--
-- Method:      fixPenetrated
--
-- Description: Try to fix the penetrated item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fixPenetrated()

  !mod = !!module()
  -- Try and fix the references of the penetrated item
  if (!this.assocsFrame.visible) then
    !association = !this.assocMemGrid.getSelectedRows()[1][1].dbref()
    !fixAdded = FALSE
  elseif (!this.frmHoleList.visible) then
    !association = !this.ngcHoleList.getSelectedRows()[1][1].dbref()
    !fixAdded = TRUE
  endif
  !hole = object HMHOLE(!association)
  -- If the hole is already approved the user trying to fix it must have write access to the penetrated item.
  if (!hole.status eq 'APPR' and !this.penetrated.dbWrite.not()) then
    !!alert.error('You must have write access to the penetrated object if the penetration is already approved')
    return
  elseif (!hole.status eq 'APPR' and !mod.appkey.upcase() neq 'MARHDES') then
    !!alert.error('You must be in hull design if the penetration is already approved')
    return
  endif

  if (!fixAdded) then
    -- Ensure the hole is not already penetrating the picked panel.
    !findHoleOwners = object COLLECTION()
    !findHoleOwners.type('ASSMBR')
    !findHoleOwners.scope(!association)
    !findHoleOwners.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner*') and not badref(amemrf)|))
    !holeOwners = !findHoleOwners.results()
    do !holeOwner values !holeOwners
      if (!holeOwner.amemrf eq !this.penetrated) then
        !!alert.error('The picked panel is already included in the penetration association')
        return
      endif
    enddo
  endif
  -- Find the profile of the penetrated object and the virtual hole and make sure they intersect
  !penetratedProfile = object PROFILE(!this.penetrated)
  handle (2,836) $* Knuckled or curved plate
    -- Check if the virtual hole clashes with the plate
    -- Save Clash Data
    !!runSynonym(|CALLSTL DCLADAT SET|)
    -- Set Obstructions
    DESCLASH
    REMOVE OBST ALL
    if( !this.penetrated.hardType eq 'HPANEL' ) then
      do !panelMember values !this.penetrated.members
        OBST $!<panelMember>
      enddo
    elseif( !this.penetrated.hardType eq 'CPANEL' ) then
      do !panelMember values !this.penetrated.smembers
        OBST $!<panelMember>
      enddo
    endif
    EXIT
    DESCLASH CHECK $!<hole.virtualHole> EXIT
    var !ccnt           clash count all
    var !ccnt           ($!ccnt A A A )
    !clashCount = !ccnt.real()
    if (!clashCount eq 0 ) then
      !!alert.error('The picked penetrated object does not intersect with the virtual hole. Unable to add to the penetration')
      -- Restore Clash Data
      !!runSynonym(|CALLSTL DCLADAT LOAD|)
      return
     endif
    -- Restore Clash Data
    !!runSynonym(|CALLSTL DCLADAT LOAD|)
  elsehandle NONE
    !penetratedProfile.mergePoints()
    !penetratedProfile.mergeLines()
    if (!hole.fixiType eq 'Free') then
      !findLoop = object COLLECTION()
      !findLoop.type('LOOP')
      !findLoop.scope(!hole.virtualHole)
      !loop = !findLoop.results()[1]
      !virtualProfile = object PROFILE(!loop)
    else
      !virtualProfile = !!hmFindHoleProfile(!hole.virtualHole)
    endif
    !test = !penetratedProfile.isWithout(!virtualProfile)
    handle (2,830)
      !!alert.error('The picked penetrated object does not intersect with the virtual hole. Unable to fix the penetration')
      return
    elsehandle NONE
      if (!test) then
        !!alert.error('The picked penetrated object does not intersect with the virtual hole. Unable to fix the penetration')
        return
      else
        -- Now check that the items are in the same plane
        -- Create a plane of the penetrated panel
        !plane = object PLANE()
        !plane.position    = !this.penetrated.pos.wrt(worl)
        !plane.orientation = !this.penetrated.ori.wrt(worl)
        -- Create a point vector from the virtual hole
        !position  = !hole.virtualHole.pos.wrt(worl)
        !direction = !hole.virtualHole.ori.zdir().wrt(worl)
        !pointVector = object POINTVECTOR()
        !pointVector.direction = !direction
        !pointVector.position  = !position
        -- find the intersection position with the plane
        !intersectPosition = !pointVector.intersection(!plane)
        -- create a line between the two points
        !line = object LINE()
        !line.startPosition = !position
        !line.endPosition   = !intersectPosition
        !distance = !line.length()
        if (!distance gt !this.penetratedRaw.thickness) then
          !!alert.error('The picked penetrated object is not in the same plane as the virtual hole. Unable to fix to the penetration')
          return
        endif
      endif
    endhandle
  endhandle

  -- Find the hole owner association member
  !find = object COLLECTION()
  !find.type('ASSMBR')
  !find.scope(!association)
  if (!fixAdded) then
    !find.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner*') and badref(amemrf)|))
  else
    !find.filter(object EXPRESSION(|lname eq '/HoleOwner' and badref(amemrf)|))
  endif
  !invalidAssMember = !find.results()[1]
  handle (2,752)
    !!alert.error('Unable to locate the broken association member. Unable to fix the association')
    return
  endhandle
  -- Try to fix the association
  !invalidAssMember.amemrf = !this.penetrated
  !invalidAssMember.asstar = !this.penetratedRaw

  -- If the hole has already been approved we need to try and reset the reference to
  -- the hole (if it exists) or recreate the hole.
  if (!hole.status eq 'APPR') then
    if (!fixAdded) then
      !find.filter(object EXPRESSION(|matchwild(lname,'/ExtraHole?') and badref(amemrf)|))
    else
      !find.filter(object EXPRESSION(|lname eq '/PrimaryHole' and badref(amemrf)|))
    endif
    !invalidAssMember = !find.results()[1]
    handle (2,752)
      !!alert.error('Unable to locate the broken hole association member. Unable to fix the hole association')
      return
    endhandle

    -- find out if any holes exist in the current item that match the position of the virtual hole
    !findHoles = object COLLECTION()
    !findHoles.scope(!this.penetrated)
    if (!this.penetrated.hardType eq 'HPANEL') then
      !findHoles.type('HHOLE')
    elseif (!this.penetrated.hardType eq 'CPANEL') then
      !findHoles.type('CHOLE')
    endif
    !holes = !findHoles.results()

    -- Defect in profile union when in imperial. So if in imperial temporarily change to metric
    -- check if any of the holes match the virtual hole
    !holeFound = FALSE

    do !h values !holes
      !holeProfile = object PROFILE(!h)
      !newProfile = !holeProfile.union(!virtualProfile)
      skip if (!newProfile.size() gt 1)
      !difference = ((!newProfile[1].area() - !virtualProfile.area()) / !virtualProfile.area())
      !diffString = !difference.string('d4')
      !difference = !diffString.real()
      if (!difference eq 0 ) then
        !holeFound = TRUE
        !existingHole = !h
        break
      endif
    enddo

    if (!holeFound) then
      -- fix the reference of the hole
      !invalidAssMember.amemrf = !existingHole
    else
      -- delete the invalid association member and create a new hole
      !ce = !!ce
      !!ce =  !invalidAssMember
      DELETE ASSMBR
      !!ce = !ce
      handle ANY
      endhandle
      !control = object HMCONTROL()
      !hole = object HMHOLE(!association)
      if (!fixAdded) then
        !result = !control.createExtraHole(!hole,!this.penetrated)
      else
        !result = !control.createHole(!hole)
      endif
      if (!result.not()) then
        !!alert.error('Unable to re-create the hole')
      endif
    endif
  endif
  if (!fixAdded) then
    !this.firstTaskPane(TRUE)
  else
    !this.showAssocs(!this.btnRefresh,'')
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      addPenetrated
--
-- Description: add another penetrated item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addPenetrated()

  !mod = !!module()
  -- Try and add references of another penetrated item
  if (!this.assocsFrame.visible) then
    !association = !this.assocMemGrid.getSelectedRows()[1][1].dbref()
  elseif (!this.frmHoleList.visible) then
    !association = !this.ngcHoleList.getSelectedRows()[1][1].dbref()
  endif
  !hole = object HMHOLE(!association)
  -- If the hole is already approved the user trying to add another penetrated item must have write access to the penetrated item.
  if (!hole.status eq 'APPR' and !this.penetrated.dbWrite.not()) then
    !!alert.error('You must have write access to the penetrated object if the penetration is already approved')
    return
  elseif (!hole.status eq 'APPR' and !mod.appkey.upcase() neq 'MARHDES') then
    !!alert.error('You must be in hull design if the penetration is already approved')
    return
  endif

  -- Find the profile of the penetrated object and the virtual hole and make sure they intersect
  !penetratedProfile = object PROFILE(!this.penetrated)
  handle (2,836) $* Knuckled or curved plate
    -- Check if the virtual hole clashes with the plate
    -- Save Clash Data
    !!runSynonym(|CALLSTL DCLADAT SET|)
    -- Set Obstructions
    DESCLASH
    REMOVE OBST ALL
    if( !this.penetrated.hardType eq 'HPANEL' ) then
      do !panelMember values !this.penetrated.members
        OBST $!<panelMember>
      enddo
    elseif( !this.penetrated.hardType eq 'CPANEL' ) then
      do !panelMember values !this.penetrated.smembers
        OBST $!<panelMember>
      enddo
    endif
    EXIT
    DESCLASH CHECK $!<hole.virtualHole> EXIT
    var !ccnt           clash count all
    var !ccnt           ($!ccnt A A A )
    !clashCount = !ccnt.real()
    if (!clashCount eq 0 ) then
      !!alert.error('The picked penetrated object does not intersect with the virtual hole. Unable to add to the penetration')
      -- Restore Clash Data
      !!runSynonym(|CALLSTL DCLADAT LOAD|)
      return
     endif
    -- Restore Clash Data
    !!runSynonym(|CALLSTL DCLADAT LOAD|)

  elsehandle NONE
    !penetratedProfile.mergePoints()
    !penetratedProfile.mergeLines()
    if (!hole.fixiType eq 'Free') then
      !findLoop = object COLLECTION()
      !findLoop.type('LOOP')
      !findLoop.scope(!hole.virtualHole)
      !loop = !findLoop.results()[1]
      !virtualProfile = object PROFILE(!loop)
    else
      !virtualProfile = !!hmFindHoleProfile(!hole.virtualHole)
    endif
    !test = !penetratedProfile.isWithout(!virtualProfile)
    handle (2,830)
      !!alert.error('The picked penetrated object does not intersect with the virtual hole. Unable to add to the penetration')
      return
    elsehandle NONE
      if (!test) then
        !!alert.error('The picked penetrated object does not intersect with the virtual hole. Unable to add to the penetration')
        return
      else
        -- Now check that the items are in the same plane
        -- Create a plane of the penetrated panel
        !plane = object PLANE()
        !plane.position    = !this.penetrated.pos.wrt(worl)
        !plane.orientation = !this.penetrated.ori.wrt(worl)
        -- Create a point vector from the virtual hole
        !position  = !hole.virtualHole.pos.wrt(worl)
        !direction = !hole.virtualHole.ori.zdir().wrt(worl)
        !pointVector = object POINTVECTOR()
        !pointVector.direction = !direction
        !pointVector.position  = !position
        -- find the intersection position with the plane
        !intersectPosition = !pointVector.intersection(!plane)
        -- create a line between the two points
        !line = object LINE()
        !line.startPosition = !position
        !line.endPosition   = !intersectPosition
        !distance = !line.length()
        if (!distance gt !hole.plateThickness) then
          !!alert.error('The picked penetrated object is not in the same plane as the virtual hole. Unable to add to the penetration')
          return
        endif
      endif
    endhandle
  endhandle

  -- Ensure the hole is not already penetrating the picked panel.
  !findHoleOwners = object COLLECTION()
  !findHoleOwners.type('ASSMBR')
  !findHoleOwners.scope(!association)
  !findHoleOwners.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner*') and not badref(amemrf)|))
  !holeOwners = !findHoleOwners.results()
  do !holeOwner values !holeOwners
    if (!holeOwner.amemrf eq !this.penetrated) then
      !!alert.error('The picked panel is already included in the penetration association')
      return
    endif
  enddo

  -- add the new hole owner to the association
  !number = (!holeOwners.size() + 1 )
  !localName = '/HoleOwner' & !number.string()
  !ce = !!ce
  !!ce = !association
  LAST ASSMBR
  NEW ASSMBR
  lname $!localName
  !!ce.amemrf = !this.penetrated
  !!ce.asstar = !this.penetratedRaw
  -- If in MARHDES then we also need to create the hole and the association member
  if (!this.marine and !hole.status eq 'APPR') then
    !hole = object HMHOLE(!association)
    !control = object HMCONTROL()
    !result = !control.createExtraHole(!hole,!this.penetrated)
    if (!result.not()) then
      !!alert.error('Unable to create the extra hole')
      !!ce = !association
      LAST ASSMBR
      DELETE ASSMBR
    endif
  endif
  !!ce = !ce

  if (!this.frmHoleList.visible) then
    !this.firstTaskPane(TRUE)
  endif



endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      fixHole
--
-- Description: Try to fix the hole
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fixHole()

  !mod = !!module()
  -- Try and fix the references of the penetrated item
  !association = !this.ngcHoleList.getSelectedRows()[1][1].dbref()
  !panel       = !this.ngcHoleList.getSelectedRows()[1][2].dbref()
  !hole = object HMHOLE(!association)
  -- If the hole is already approved the user trying to fix it must have write access to the penetrated item.
  if (!panel.dbWrite.not()) then
    !!alert.error('You must have write access to the panel that owns the hole')
    return
  endif

  !find = object COLLECTION()
  !find.type('ASSMBR')
  !find.scope(!association)
  !find.filter(object EXPRESSION(|lname eq '/PrimaryHole' and badref(amemrf)|))
  !invalidAssMember = !find.results()[1]
  handle (2,752)
    !!alert.error('Unable to locate the broken hole association member. Unable to fix the hole association')
    return
  endhandle

  -- find out if any holes exist in the current item that match the position of the virtual hole
  !findHoles = object COLLECTION()
  !findHoles.scope(!panel)
  if (!panel.hardType eq 'HPANEL') then
    !findHoles.type('HHOLE')
  elseif (!panel.hardType eq 'CPANEL') then
    !findHoles.type('CHOLE')
  endif

  !holes = !findHoles.results()
    if (!hole.fixiType eq 'Free') then
    !findLoop = object COLLECTION()
    !findLoop.type('LOOP')
    !findLoop.scope(!hole.virtualHole)
    !loop = !findLoop.results()[1]
    !virtualProfile = object PROFILE(!loop)
  else
    !virtualProfile = !!hmFindHoleProfile(!hole.virtualHole)
  endif

  -- Defect in profile union when in imperial. So if in imperial temporarily change to metric
  -- check if any of the holes match the virtual hole
  !holeFound = FALSE

  do !h values !holes
    !holeProfile = object PROFILE(!h)
    !newProfile = !holeProfile.union(!virtualProfile)
    skip if (!newProfile.size() gt 1)
    !difference = ((!newProfile[1].area() - !virtualProfile.area()) / !virtualProfile.area())
    !diffString = !difference.string('d4')
    !difference = !diffString.real()
    if (!difference eq 0 ) then
      !holeFound = TRUE
      !existingHole = !h
      break
    endif
  enddo

  if (!holeFound) then
    -- fix the reference of the hole
    !invalidAssMember.amemrf = !existingHole
  else
    -- delete the invalid association member and create a new hole
    !ce = !!ce
    !!ce =  !invalidAssMember
    DELETE ASSMBR
    !!ce = !ce
    handle ANY
    endhandle
    !control = object HMCONTROL()
    !hole = object HMHOLE(!association)
    !result = !control.createHole(!hole)
    if (!result.not()) then
      !!alert.error('Unable to re-create the hole')
    endif
  endif
  !this.firstTaskPane(TRUE)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      removePenetrated
--
-- Description: Try to remove any additional penetrated objects from the association the no longer intersect the virtual hole
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removePenetrated()

  -- Try and remove references of another penetrated item
  if (!this.assocsFrame.visible) then
    !association = !this.assocMemGrid.getSelectedRows()[1][1].dbref()
  elseif (!this.frmHoleList.visible) then
    !association = !this.ngcHoleList.getSelectedRows()[1][1].dbref()
  endif
 !removed = FALSE
 !hole = object HMHOLE(!association)
  -- Find out any additional penetrated objects that are no longer intersect with the virtual hole
  if (!hole.holeOwners.empty().not()) then
    !find = object COLLECTION()
    !find.type('ASSMBR')
    !find.scope(!association)
    !find.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner?')|))
    !holeOwners = !find.results()
    if (!hole.fixiType eq 'Free') then
      !findLoop = object COLLECTION()
      !findLoop.type('LOOP')
      !findLoop.scope(!hole.virtualHole)
      !loop = !findLoop.results()[1]
      !virtualProfile = object PROFILE(!loop)
    else
      !virtualProfile = !!hmFindHoleProfile(!hole.virtualHole)
    endif
    !removed = FALSE
    do !panel values !holeOwners
      -- Can not check CPANEL
      skip if (!panel.amemrf.hardType eq 'CPANEL')
      !penetratedProfile = object PROFILE(!panel.amemrf)
      handle ANY
        !removed = FALSE
      elsehandle NONE
        !penetratedProfile.mergePoints()
        !penetratedProfile.mergeLines()
        if (!penetratedProfile.isWithout(!virtualProfile)) then
          -- Delete the relevant association member
          !ce = !!ce
          !!ce = !panel
          DELETE ASSMBR
          !!ce = !ce
          handle (2,822)
            -- if the current element has been deleted
          endhandle
          !removed = TRUE
        endif
      endhandle
    enddo
  endif

  if (!removed) then
    if (!this.assocsFrame.visible) then
      !this.showAssocs(!this.btnRefresh,'')
    else
      !this.firstTaskPane(TRUE)
    endif
  else
    !!alert.error('Unable to remove the penetrated object')
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      extraColumns
--
-- Description: Process extra columns if specified in the configuration file
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       HMHOLE .element
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two element array where first element is array of headings and
--                second element is array of columns
--
------------------------------------------------------------------------

define method .extraColumns(!holeRef is DBREF) is ARRAY

  !extraHead = ARRAY()
  !extraCols = ARRAY()
  !columnConfig = !!holeManagementConfiguration.columns
  do !idx index !columnConfig
    !heading = !columnConfig[!idx].split('#')[1]
    !colData = !columnConfig[!idx].split('#')[2]
    !expr = object EXPRESSION( !colData )
    handle (2,849)
      -- Invalid expression string
      !!alert.error('Removed invalid expression for $!heading in configuration [ ' + !!error.text + ' ]')
      !!holeManagementConfiguration.columns[!idx].delete()
      skip
    endhandle
    !tempValue = !expr.evaluate(!holeRef)
    handle any
      !!alert.error('Removed invalid extra column $!heading in configuration [ ' + !!error.text + ' ]')
      !!holeManagementConfiguration.columns[!idx].delete()
      skip
    endhandle
    !extraCols.append(!tempValue)
    !extraHead.append(!heading)
    -- delete value in case type changes
    !tempValue.delete()
  enddo
  !return = ARRAY()
  !return[1] = !extraHead
  !return[2] = !extraCols
  return !return

endmethod
------------------------------------------------------------------------
--
-- Method:      getChanges
--
-- Description: if in global get all changes from others extracts
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getChanges()

  EXTRACT REFRESH ALL
  handle (43,384) (43,387)
    !answer = !!alert.confirm('There are outstanding updates in your extract. Do you want to do a SAVEWORK?')
    if (!answer.boolean()) then
      !!runMacro('/%PDMSUI%/DES/GEN/MSAVEW','')
      EXTRACT REFRESH ALL
    endif
  endhandle

  GETWORK
  !this.applyFilter()

endmethod
------------------------------------------------------------------------
--
-- Method:      displayResults
--
-- Description: display validation results in results window
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayResults()

  if( !this.validationResults.empty() ) then
    return
  endif

  if( not defined( !!comErrorMessage ) ) then
    pml load form !!comErrorMessage
  endif

  !!comErrorMessage.message = !this.validationResults
  show !!comErrorMessage

endmethod
------------------------------------------------------------------------
--
-- Method:      cleanUp
--
-- Description: Form close callback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cleanUp()

  !!aidNumbers.hide(!this.aidAxes)
  !this.resetTranslucency()

endmethod
