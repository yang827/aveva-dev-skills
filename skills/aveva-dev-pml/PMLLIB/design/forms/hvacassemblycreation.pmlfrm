setup form !!hvacAssemblyCreation resizeable

--  !this.formTitle     = 'HVAC Assembly Creation'
  !this.initcall      = '!this.init()'
  !this.quitcall      = |!this.killcall()|
  !this.killingcall   = |!this.killcall()|

  toggle .name 'Display Name/Description' call '!this.getworld(1)'

  option .world     'Assembly World:' at x0 ymax anchor t+l call '!this.getworld(2)' width 15

  option .area      'Assembly Area: ' at x0 ymax anchor t+l call '!this.getworld(3)' width 15

  list .assemblyOpt 'Assemblies:       ' at x0 ymax anchor t+l+r call '!this.selectassy()' width 33 height 10

  -- Component Creation
  button .create     linklabel 'Create connected to picked element' anchor l+t  at x0 ymax callback |!this.create('Connected')|
  button .createPick linklabel 'Create at position in implied tube'     anchor l+t  at x0 ymax callback |!this.create('InTube')|
  button .createHere linklabel 'Create connected to current element' anchor l+t  at x0 ymax callback |!this.create('ConnectToCurrent')|
--  button .createPick linklabel 'Create at picked position'   anchor l+t  at x0 ymax callback |!this.create('AtPosition')|

  --frame .secondtaskpane panel  anchor b+r+l at xmin ymax
  line .ftpl12  anchor t+l+r  at x0   ymax   horizontal width 34

  frame  .localViewFrame PANEL at xmin ymax anchor all width 24
    para .prompt at xmin .ftpl12 ymax .ftpl12 width 34 lines 1

    view .localview at xmin ymax prompt .prompt givolume

      -- Input Modes
      -- Navigate
      inmode create _navi       type |DES_NAVIGATE|
      -- Standard Element Pick
      inmode create _pick       type |DES_PICK|
      -- Pick Any (Element, Ppoint, Pline)
      inmode create _pAny       type |DES_PICK_ANY|
      -- Plines
      inmode create _pLine      type |DES_PICK_PLINE|
      -- Ppoints
      inmode create _point      type |DES_PICK_POINT|
      -- Screen Position
      inmode create _screen     type |DES_3D_LINE|
      -- Laser Model rays
      inmode create _pickxgeom  type |DES_PICK_XGEOM|
      -- Default (Navigation)
      inmode create _pickDetail type |DES_PICK_DETAIL|
      -- Default (Navigation)
      inmode create _default    type |DES_NAVIGATE|

      height 7 width 20

    exit
  exit

  -- Set Defaults for Modes
  !this.localview.navi.cursor     = 'Pointer'
  !this.localview.navi.prompt     = 'Navigate : '

  !this.localview.pick.cursor     = 'Pointer'
  !this.localview.pick.prompt     = 'Pick Element : '

  !this.localview.pAny.cursor     = 'Pointer'
  !this.localview.pAny.prompt     = 'Pick Any : '

  !this.localview.pLine.cursor    = 'Pointer'
  !this.localview.pLine.prompt    = 'Pick Pline : '

  !this.localview.point.cursor    = 'Pick'
  !this.localview.point.prompt    = 'Point Ppoint : '

  !this.localview.screen.cursor   = 'Crosshair'
  !this.localview.screen.prompt   = 'Pick 3D Position : '

  !this.localview.default.cursor  = 'Pointer'
  !this.localview.default.prompt  = 'Navigate : '

  member .assembly              is HVACASSEMBLY
  member .currentcomp           is HVACASSEMBLYCOMPONENT
   -- Current Task Pane within Form
  member .drawlist              is DRAWLIST
  member .explorerselected      is DBREF
  member .newComponents         is ARRAY
  member .fromSplitForm         is BOOLEAN
  member .currentElement        is DBREF

  !this.firstshowncall  = '!this.firstShown()'

  -- Add alternative gadgets for use with splitting form
  button .selectSplitAssembly linklabel 'Select as the Splitting Assembly' anchor l+t  at xmin.create ymin.create callback |!this.create('Split')|

exit
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .firstShown()

  !background = !!gphviews.views.first().background
  handle any
    !background = 15
  endhandle
  !this.drawlist = object DRAWLIST()
  !this.localview.background = !background
  !this.localview.shaded     = TRUE
  !this.drawlist.attachview(!this.localview)
  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)
  handle any
  endhandle
   -- add the local view
  !!edgcntrl.addview(!this.localview)

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------

-- Initialisation method run every time form is shown
-----------------------------------------------------------------------------
define method .init()

  -- find the available template worlds
  !this.getworld(1)

  -- Always set gadgets in Create mode
  !this.shownFromSplit(false)

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getworld(!level is REAL)

  if !level.eq(1) then
   !this.getarea(!this.world, 'APPLDW', '/*')
   !this.getarea(!this.area, 'APPDAR', '$!this.world')
  elseif !level.eq(2) then
   !this.getarea(!this.area, 'APPDAR', '$!this.world')
  endif
  !this.getarea(!this.assemblyOpt, 'APPLDA', '$!this.area')

  if !this.assemblyOpt.dtext[1].eq('None Found') then
    !this.selectassy()
  endif

  !!ce = !this.assemblyOpt.selection().dbref()
  handle any
    return
  elsehandle NONE
    !this.selectassy()
  endhandle

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- gets all the data for the appworld apparea an appdata option gadgets
define method .getarea(!gadget is GADGET,!searchitem is STRING, !source is STRING)

  if !source.eq('/*') then
    var !a coll all $!searchitem with purp eq 'HASY'
    handle any
           !a = ARRAY()
    endhandle
  else
    var !a coll all $!searchitem with purp eq 'HASY' for $!source
    handle any
       !a = ARRAY()
    endhandle
  endif
  if !a.size().eq(0) then
    !dtext[1] = 'None Found'
    !a[1]     = 'NONE Found'
    !this.localview.visible = FALSE
  else
    if !this.name.val then
      var !dtext eval name for all from !a
    else
      var !dtext eval desc for all from !a
    endif
  endif

  !gadget.dtext = !dtext
  !gadget.rtext = !a

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .selectassy()

  !!ce = !this.assemblyOpt.selection().dbref()
  handle any
     --!this.componentlist.clear()
       !this.assembly = object HVACASSEMBLY()
     return
  endhandle

  !this.assembly = object HVACASSEMBLY(!this.assemblyOpt.selection().dbref())

  !this.selectcomponent(!!ce.string())
  !this.explorerselected = !!ce

  !this.addtodisplay()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to auto the current hvac and add it to the view
define method .addtodisplay()

  !selected = !this.assemblyOpt.selection().dbref()
  handle any
      !!alert.error('No Assembly selected')
      return
  endhandle
  if !!ce.neq(!selected) then
    return
  endif

  -- Get information about the hvac (i.e. volume)
  var !unusedVolumeTest VOL CE
  handle ANY
    --!!alert.confirm (|No Graphical Elements in this Assembly|)
    !this.localview.visible = FALSE
    return
  elsehandle NONE
    !this.localview.visible = TRUE
  endhandle

  !background = !!gphviews.views.first().background
  handle any
    !background = 15
  endhandle

  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)

  !dira[1]  = -0.57735
  !dira[2]  = 0.57735
  !dira[3]  = -0.57735

  !this.localview.direction = !dira
   -- mark all the relevant elements in the local view
  !this.assembly.markelements()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to set the limits of the local view
define method .limits(!element is DBREF)

  -- Initialise Variables
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Get volume of item
  !volume      = object VOLUME(!element)
  !volume.from = !volume.from.string(!format).position()
  !volume.to   = !volume.to.string(!format).position()

  -- Load view limits with Volume
  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  -- Set view Limits
  !this.localview.limits = !array

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- this method takes the currently selected element in the components list and
-- displays the relevant attributes and special commands for that element
define method .selectcomponent(!item is STRING)

  if !!ce.neq(!item.dbref()) then
    !!ce = !item.dbref()
  endif

  !selection = !item.dbref()
  !component = object HVACASSEMBLYCOMPONENT(!selection)
  !this.currentcomp = !component

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- tidy up method
define method .killcall()

  aid clear text all
  !this.hide()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .create(!option is STRING)

  -- Expected options:
  -- 'InTube'    - Random pick positions in Tube
  -- 'Connected' - Connect to previous
  -- 'Split'     - For when form is called by HVAC splitting form

  -- We are dealing with an assembly
  !this.assembly.varid = 'hvacAssemblyCreation.assembly'

  -- Quick check for 'NONE Found'
  if (!this.assemblyOpt.selection('rtext') eq 'NONE Found') then
    !!alert.error('No Assembly found')
    return
  endif

  if (!option.lowcase() eq 'split') then
    -- First check that this assembly does not have more than 1 branch because we cannot use it on splitting
    if (!this.assembly.branchCount.set() and !this.assembly.branchCount.gt(1)) then
      !!alert.error('This Assembly is not allowed because an assembly can only have 1 branch for use in HVAC Splitting.')
      return
    endif
    !!hvacSplitting.selectedAssemblyName.val = !this.assemblyOpt.selection('dtext')
    !colour = object COLOUR('White')
    !!hvacSplitting.selectedAssemblyName.background = !colour.code
    !!hvacSplitting.assembly = !this.assembly
    return
  else
    -- Build a new assembly
    !this.currentElement = !!ce
    !this.assembly.buildnewassembly(!option.lowcase())
    !this.newComponents = !this.assembly.builtitems
    return
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .shownFromSplit(!split is BOOLEAN)

  !this.selectSplitAssembly.visible = !split
  !this.create.visible              = !split.not()
  !this.createPick.visible          = !split.not()
  !this.createHere.visible          = !split.not()

  if (!split) then
    !this.formTitle     = 'Select HVAC Assembly'
  else
    !this.formTitle     = 'HVAC Assembly Creation'
  endif

endmethod
------------------------------------------------------------------------------
