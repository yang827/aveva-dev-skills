setup form !!hvacassemblymgr dialog dock right

  import 'ExplorerAddin'
  handle any
  endhandle

  using namespace 'Aveva.Pdms.Presentation'

  !this.icontitle     = 'Assemblies'
  !this.formTitle     = 'HVAC Assembly Manager'
  !this.initcall      = '!this.init()'
  !this.quitcall      = |!this.killcall()|
  !this.killingcall   =  |!this.killcall()|
  track 'DESICE'    call '!this.track()'

  --frame .mainframe panel anchor all at x0 y0

  button .ce  ' CE '  callback |!this.selectcurrent(!!ce)|
  toggle .name 'Display Name/Description' call '!this.getworld(1)'

  path down

  option .world              'Assembly World' anchor t+r+l at xmin.ce ymax  call '!this.getworld(2)' width 15
  path right
  button .crworld  linkLabel 'New World'  anchor t+r callback |!this.create('APPLDW')|

  option .area               'Assembly Area ' anchor t+r+l  at xmin.world ymax  call '!this.getworld(3)' width 15
  path right
  button .crarea  linkLabel  'New Area'  anchor t+r callback |!this.create('APPDAR')|

  option .assemblyopt        'Assembly      ' anchor t+r+l at xmin.world ymax  call '!this.selectassy()' width 15
  path right
  button .crapdata  linkLabel 'New Assembly' anchor t+r callback |!this.create('APPLDA')|

  path down

  -- button .display 'Display' at xmin.world ymax call '!this.addtodisplay()'
  button .copy  linklabel  'Copy Design' at xmin.world ymax   call '!this.copydesign()'
  para   .readonly  at xmax+7 ymin width 12 lines 1

  Container .explorerframe PMLnetcontrol 'NET' anchor t+r+l  at xmin.world ymax  width 48 hei 9
  -- zone and hvac created automatically

  frame .secondtaskpane panel anchor all $* at xmin.world ymax.explorerframe

    list .actionlist 'Component Rules' anchor t+r+l at x0y0 width 45 hei 13
    path down
    button .createstype              'New'  call |!this.newrule()|
    button .editstype  at xmax ymin  'Edit' call |!this.editrule()|
    button .deletestype at xmax ymin 'Delete' call |!this.deleterule()|

    line .ftpl12 anchor t+r+l  at x0   ymax   horizontal width 47

    frame  .localViewFrame PANEL at xmin ymax anchor all width 44
      para .prompt at xmin .ftpl12 ymax .ftpl12 width 47 lines 1

      view .localview at xmin.world ymax.prompt prompt .prompt givolume

        -- Input Modes
        -- Navigate
        inmode create _navi       type |DES_NAVIGATE|
        -- Standard Element Pick
        inmode create _pick       type |DES_PICK|
        -- Pick Any (Element, Ppoint, Pline)
        inmode create _pAny       type |DES_PICK_ANY|
        -- Plines
        inmode create _pLine      type |DES_PICK_PLINE|
        -- Ppoints
        inmode create _point      type |DES_PICK_POINT|
        -- Screen Position
        inmode create _screen     type |DES_3D_LINE|
        -- Laser Model rays
        inmode create _pickxgeom  type |DES_PICK_XGEOM|
        -- Default (Navigation)
        inmode create _pickDetail type |DES_PICK_DETAIL|
        -- Default (Navigation)
        inmode create _default    type |DES_NAVIGATE|

        height 10 width 10

      exit
    exit

      -- Set Defaults for Modes
    !this.localview.navi.cursor     = 'Pointer'
    !this.localview.navi.prompt     = 'Navigate : '

    !this.localview.pick.cursor     = 'Pointer'
    !this.localview.pick.prompt     = 'Pick Element : '

    !this.localview.pAny.cursor     = 'Pointer'
    !this.localview.pAny.prompt     = 'Pick Any : '

    !this.localview.pLine.cursor    = 'Pointer'
    !this.localview.pLine.prompt    = 'Pick Pline : '

    !this.localview.point.cursor    = 'Pick'
    !this.localview.point.prompt    = 'Point Ppoint : '

    !this.localview.screen.cursor   = 'Crosshair'
    !this.localview.screen.prompt   = 'Pick 3D Position : '

    !this.localview.default.cursor  = 'Pointer'
    !this.localview.default.prompt  = 'Navigate : '

  exit

  menu .editworld
   !this.editworld.add('callback','Modify World' ,'!this.modify(!this.world)')
   !this.editworld.add('callback','Delete World' ,'!this.deleteitem(!this.world)')
   !this.world.setpopup(!this.editworld)

  menu .editarea
   !this.editarea.add('callback','Modify Area' ,'!this.modify(!this.area)')
   !this.editarea.add('callback','Delete Area' ,'!this.deleteitem(!this.area)')
   !this.area.setpopup(!this.editarea)

  menu .editassembly
   !this.editassembly.add('callback','Modify Assembly' ,'!this.modify(!this.assemblyopt)')
   !this.editassembly.add('callback','Delete Assembly' ,'!this.deleteitem(!this.assemblyopt)')
   !this.assemblyopt.setpopup(!this.editassembly)

  member .appdworld             is DBREF
  member .appdarea              is DBREF
  member .appdata               is DBREF
  member .zone                  is DBREF
  member .hvac                  is DBREF
  member .branches              is ARRAY
  member .owners                is ARRAY
  member .lines                 is ARRAY
  member .savedata              is ARRAY
  member .components            is ARRAY
  member .deletedcomps          is ARRAY
  member .newcomps              is ARRAY
  member .assembly              is HVACASSEMBLY
  member .currentcomp           is HVACASSEMBLYCOMPONENT
   -- Current Task Pane within Form
  member .currentPane           is GADGET
  member .currentTask           is BLOCK
  member .currentbuild          is STRING
  member .currentpanel          is STRING
  member .systemexplorer        is PMLEXPLORERCONTROL
  member .drawlist              is DRAWLIST
  member .explorerselected      is DBREF


  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  !!appFormCntrl.registerForm(!this)
  !this.firstshowncall  = '!this.firstShown()'

exit
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .hvacassemblymgr()

  -- find the available template worlds
  !this.getworld(1)
  !this.secondtaskpane.visible = TRUE

  using namespace 'Aveva.Pdms.Presentation'
  !this.systemexplorer = object PMLEXPLORERCONTROL()
  -- !this.systemexplorer.initialise('/*', 'HVAC')
  -- P-26479 fix for change in explorer view
  !this.systemexplorer.initialise('DESI','/*')
  !this.explorerframe.control = !this.systemexplorer.handle()

  --Add event handlers
  !this.systemexplorer.addeventhandler('OnSelectionChanged',!this, 'explorerSelect')
  !this.systemexplorer.addeventhandler('Onpopup', !this, 'ExplorerPopUp')

   -- Undoable
   !this.copy.setUndoable(!!hvacControl.standardUndoable)

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .firstShown()

  !background = !!gphviews.views.first().background
  handle any
    !background = 15
  endhandle
  !this.drawlist = object DRAWLIST()
  !this.localview.background = !background
  !this.localview.shaded     = TRUE
  !this.drawlist.attachview(!this.localview)
  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)
  handle any
  endhandle
   -- add the local view
  !!edgcntrl.addview(!this.localview)

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .modify(!item is GADGET)

  if !item.dtext[1].eq('None Found') then
    !!alert.error('No assembly selected')

  else
    !selection = !item.selection()
    pml load form !!pipeasscrt

    if !item.eq(!this.world) then
      !type = 'APPLDW'
      !formTitle = 'Modify Assembly World'
    elseif !item.eq(!this.area) then
      !type = 'APPDAR'
      !formTitle = 'Modify Assembly Area'
    else
      !type = 'APPLDA'
      !formTitle = 'Modify Assembly'
      !!pipeasscrt.assemblyname = !selection.dbref().name
    endif

    !!pipeasscrt.formTitle = !formTitle
    !!pipeasscrt.type = !type
    handle any
      pml load form !!pipeasscrt
      !!pipeasscrt.type = !type
    endhandle

    !!pipeasscrt.mode = 'modify'
    !!pipeasscrt.name.val = !selection.dbref().name
    !!pipeasscrt.desc.val = !selection.dbref().desc
    !!pipeasscrt.current = !selection.dbref()

    show !!pipeasscrt
  endif

 endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .deleteitem(!item is GADGET)

  if !item.dtext[1].eq('None Found') then
    !!alert.error('No assembly selected')
  else
    !selection = !item.selection()
    !!ce = !selection.dbref()
    !!deleteCE()

    if !item.eq(!this.world) then
      !this.getworld(1)
    elseif !item.eq(!this.area) then
      !this.getworld(2)
    else
      !this.getworld(3)
    endif
  endif

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .explorerpopup(!data is ARRAY)

   !!element = object DBREF(!data[2])
   !this.explorerframe.showpopup(!data[0], !data[1])

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .explorerselect(!data is ARRAY)

  !element = object DBREF(!data[0])
  !!ce = !element
  !this.setruleslistheading(!!ce)
  !this.selectcomponent(!!ce.string())
  !this.explorerselected = !!ce
  !this.addtodisplay()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .refreshassembly(!dummyAssembly is DBREF)

  !this.setruleslistheading(!!ce)
  !this.selectcomponent(!!ce.string())
  !this.explorerselected = !!ce
  !this.addtodisplay()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .setruleslistheading(!element is DBREF )

  if !element.type.eq('APPLDA') then
    !this.actionlist.tag = 'Assembly Rules'
  else
    if !element.ddepth.gt(5)then
      !this.actionlist.tag = 'Component Rules'
    endif
  endif

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .selectelement(!ele is STRING)

  !this.systemexplorer.selectelement(!ele)

endmethod
----------------------------------------------------------------------------

-- constructor method to build the basics
-----------------------------------------------------------------------------
define method .init()

  -- find the available template worlds
  !this.getworld(1)
  !this.secondtaskpane.visible = TRUE

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .track()

  if !this.shown().not() then
    return
  else
    var !a applda
    handle any
      return
    elsehandle NONE
      !this.systemexplorer.selectelement(!!ce.string())
      handle any
        return
      endhandle
    endhandle
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getworld(!level is REAL)

  if !level.eq(1) then
    !this.getarea(!this.world, 'APPLDW', '/*')
    !this.getarea(!this.area, 'APPDAR', '$!this.world')
  elseif !level.eq(2) then
    !this.getarea(!this.area, 'APPDAR', '$!this.world')
  endif
  !this.getarea(!this.assemblyopt, 'APPLDA', '$!this.area')

  !this.selectassy()

  !!ce = !this.assemblyopt.selection().dbref()
  handle any
    return
  elsehandle NONE
    !this.selectassy()
  endhandle

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- When at APPLDA level get the correct world and area gadgets
define method .selectcurrent(!element is DBREF)

  !!ce = !element
  APPLDA
  handle any
    !!alert.error('Not At an HVAC Assembly')
    return
  endhandle

  -- Check for a valid HVAC Assembly
  if (!!ce.purpose.upcase() neq 'HASY') then
    !!alert.error('Not At an HVAC Assembly')
    return
  endif

  !this.getarea(!this.world, 'APPLDW', '/*' )
  !this.world.select('rtext', !!ce.owner.owner.string())
  !this.getarea(!this.area, 'APPDAR', '$!this.world')
  !this.area.select('rtext', !!ce.owner.string())
  !this.getarea(!this.assemblyopt, 'APPLDA', '$!this.area')
  !this.assemblyopt.select('rtext', !!ce.string())

  !this.selectassy()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- gets all the data for the appworld apparea an appdata option gadgets
define method .getarea(!gadget is GADGET,!searchitem is STRING, !source is STRING)

  if !source.eq('/*') then
      var !a coll all $!searchitem with purp eq 'HASY'
      handle any
        !a = ARRAY()
      endhandle
  else
     var !a coll all $!searchitem with purp eq 'HASY' for $!source
     handle any
       !a = ARRAY()
     endhandle
  endif
  if !a.size().eq(0) then
    !dtext[1] = 'None Found'
    !a[1]     = 'NONE Found'
    !this.actionlist.clear()
    !this.localview.visible = FALSE
  else
    if !this.name.val then
      var !dtext eval name for all from !a
    else
      var !dtext eval desc for all from !a
    endif
  endif

  !gadget.dtext = !dtext
  !gadget.rtext = !a

 endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .selectassy()

  !this.systemexplorer.resetroot(!this.assemblyopt.selection())
  handle any
  endhandle
  !!ce = !this.assemblyopt.selection().dbref()
  handle any
    --!this.componentlist.clear()
    !this.assembly = object HVACASSEMBLY()
    return
  endhandle

  !this.assembly = object HVACASSEMBLY(!this.assemblyopt.selection().dbref())

  if !this.assembly.readonly then
    !this.readonly.val = |(Read Only)|
  elseif !this.assembly.locked then
    !this.readonly.val = |(Locked)|
  else
    !this.readonly.val = ||
  endif

  !this.setruleslistheading(!!ce)
  !this.selectcomponent(!!ce.string())
  !this.explorerselected = !!ce

  !this.addtodisplay()

  if !this.assemblyopt.dtext[1].eq('None Found') then
    !this.explorerframe.active = FALSE
  else
    !this.explorerframe.active = TRUE
  endif


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .create(!type is STRING)

  !!pipeasscrt.type = !type
  handle any
    pml load form !!pipeasscrt
    !!pipeasscrt.type = !type
  endhandle
  !!pipeasscrt.mode = 'new'

  if !type.eq('APPLDW') then
    !!pipeasscrt.current = !!ce
    !!pipeasscrt.formTitle = 'Create Assembly World'
  elseif !type.eq('APPDAR') then
    !!pipeasscrt.current = !this.world.selection().dbref()
    handle any
      !!alert.error('Not at an Assembly World')
      return
    endhandle
    !!pipeasscrt.formTitle = 'Create Assembly Area'
  else
    !!pipeasscrt.current =  !this.area.selection().dbref()
    handle any
      !!alert.error('Not at an Assembly Area')
      return
    endhandle
          !!pipeasscrt.formTitle = 'Create Assembly'
  endif

  show !!pipeasscrt

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .setorigin()

 !result = true

  -- Define EDG packet
  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdany('Identify PPOINT For Origin')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!hvacassemblymgr.moveorigin(!this.return[1])'
  !packet.remove  = true
  !return = !!edgcntrl.add(!packet)

  -- Return
  return !result

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to build an assembly from a graphical selection
define method .copydesign()

  var !all coll all bran for $!this.assembly.appldata
  if !all.size().gt(0) then
     !!alert.error('Assembly already has members - Copy Aborted')
     return
  endif

  !selection = object SELECTION()
  !selection.getCurrent()
  !this.components = !selection.getselection()
  !owners = ARRAY()
  !branches = ARRAY()
  -- loop through the selected items and see if there are any branches
  -- if there is only one branch then we don't need to identify a branch
  do !a values !this.components
    skip if(!a.type eq 'TUBI')
    if !a.type.eq('BRAN') then
      -- !branches.append(!a)
    else
      !owners.append(!a.owner)
    endif
  enddo

  !this.branches = !branches
  -- check to see how many branches are involved
  !owners.appendarray(!branches)
  !owners.unique()
  !this.owners = !owners
  if !owners.size().eq(1) then
    -- we don't need to pick a main branch
     !this.assembly.buildfromselection(!this.assembly.hvac, !this.components, !owners[1], !branches, !owners)
    !!alert.message('Copy Complete')
    !this.selectcurrent(!!ce)
    return
  endif
  --!this.selection = !selection

  !result = true

  -- Define EDG packet
  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdany('Identify a Component in the Main branch of the Assembly Selection')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq |BRAN| and TYPE of OWNER of OWNER eq |HVAC|'
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq |BRAN| and TYPE of OWNER of OWNER eq |HVAC|'
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!hvacassemblymgr.buildassembly(!this.return[1])'
  !packet.remove  = true
  !return = !!edgcntrl.add(!packet)

  -- Return
  return !result

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .buildassembly(!pick is EDGPICKDATA)

  -- this method picks the main branch
  !assemblybranch = object DBREF()
   if !pick.item.type.neq('BRAN') then
     !bran = !pick.item.owner
   else
     !bran = !pick.item
   endif
  if !this.components.findfirst(!pick.item).unset() then
    do !a values !this.components
      skip if(!a.type eq 'TUBI' or !a.owner.type ne 'BRAN')
      if !a.owner.eq(!bran) then
        !assemblybranch = !bran
        break
      endif
    enddo
  else
    !assemblybranch = !bran
  endif
  if !assemblybranch.unset() then
    !!alert.error('Identified component is not found')
    return
  endif

  !this.assembly.buildfromselection(!this.assembly.hvac, !this.components, !assemblybranch, !this.branches, !this.owners)
  !!alert.message('Copy Complete')

  !this.selectcurrent(!!ce)

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to auto the current hvac and add it to the view
define method .addtodisplay()

  !selected = !this.assemblyopt.selection().dbref()
  handle any
      !!alert.error('No Assembly selected')
      return
  endhandle
  if !!ce.neq(!selected) then
    return
  endif

  -- Get information about the HVAC (i.e. volume)
  var !unusedTestVolume VOL CE
  handle ANY
    --!!alert.confirm (|No Graphical Elements in this Assembly|)
    !this.localview.visible = FALSE
    return
  elsehandle NONE
    !this.localview.visible = TRUE
  endhandle

  !background = !!gphviews.views.first().background
  handle any
    !background = 15
  endhandle

  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)

  !dira[1]  = -0.57735
  !dira[2]  = 0.57735
  !dira[3]  = -0.57735

  !this.localview.direction = !dira
  -- mark all the relevant elements in the local view
  !this.assembly.markelements()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to set the limits of the local view
define method .limits(!element is DBREF)

  -- Initialise Variables
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Get volume of item
  !volume      = object VOLUME(!element)
  !volume.from = !volume.from.string(!format).position()
  !volume.to   = !volume.to.string(!format).position()

  -- Load view limits with Volume
  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  -- Set view Limits
  !this.localview.limits = !array

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to move the passed position and everything else to n0u0e0
-- the user has selected a ppoint and returned it to the form for checking
define method .moveorigin(!pick is EDGPICKDATA )

  !element  = !pick.item
  !point    = !pick.point

  -- first check to see if the element picked is in line.
  if !element.owner.order.neq(1) then
    !!alert.error('Assembly Origin must be in the first Branch')
    return
  endif

  -- could check to see if it is in line, but it should not matter.

  -- go to the design data set and create a new key element
  var !coll coll all ddat with (dkey eq 'ORIG') for $!this.assembly.dataset
  if !coll.size().eq(0) then
    !!ce = !this.assembly.dataset
    !name = !!ce.name & '-ORIG'
    new ddat
    name $!name
    dkey orig
    ddprop $!element
    number $!point
  else
    !!ce = !coll[1].dbref()
    !existing = !this.assembly.dataset.lfdp.orig
    if !existing.eq($!element) then
      if !point.eq(!!ce.number) then
        !!alert.error('Origin Point is already set to this Point')
         return
      endif
      !!ce.number = !point
    else
      !!ce = !coll[1].dbref()
      if !!alert.confirm('Ok to change Origin Point?').eq('YES') then
        ddprop $!element
        number $!point
      endif
    endif
  endif

  !this.addtodisplay()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- this method takes the currently selected element in the components list and
-- displays the relevant attributes and special commands for that element
define method .selectcomponent(!item is STRING)

  if !item.match('IL').gt(0) then
    !this.actionlist.clear()
    return
  endif

  if !!ce.neq(!item.dbref()) then
    !!ce = !item.dbref()
  endif

  !selection = !item.dbref()
  !component = object HVACASSEMBLYCOMPONENT(!selection)
  !this.currentcomp = !component
  if (!selection.owner.type eq 'BRAN') then
    -- its a branch member
    !this.getcomponentrules(!item)
    -- Activate Rule gadgets
    !this.actionlist.active  = true
    !this.createstype.active = true
    !this.editstype.active   = true
    !this.deletestype.active = true
  else
    -- its a branch hvac zone or APPLDA
    if (!selection.type eq 'APPLDA') then
      !this.getassemblyrules(!item)
      -- Activate Rule gadgets
      !this.actionlist.active  = true
      !this.createstype.active = true
      !this.editstype.active   = true
      !this.deletestype.active = true
    else
      !this.actionlist.clear()
      -- Inactivate Rule gadgets
      !this.actionlist.active  = false
      !this.createstype.active = false
      !this.editstype.active   = false
      !this.deletestype.active = false
      return
    endif
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getcomponentrules(!item is STRING)

  !component = !this.currentcomp

  !dtext = ARRAY()
  !col1  = ARRAY()
  !col2  = ARRAY()
  !rtext = ARRAY()

  -- now go and compile the list
  !heading[1] = 'Rule'
  !heading[2] = 'Type'
  !heading[3] = 'Value'
  !col[1] = ARRAY()
  !col[2] = ARRAY()
  !col[3] = ARRAY()

  !col[1].append('Position')
  !col[2].append('')
  !col[3].append('')

  !rtext.append('POSI')
  do !a values !component.posrules
    !col[1].append('')
    !col[2].append(!a.split(',')[1])
    !col[3].append(!a.split(',')[2])
    !rtext.append(!a.split(',')[3])
  enddo
  !col[1].append('Orientation')
  !col[2].append('')
  !col[3].append('')
  !rtext.append('ORIE')
  do !a values !component.orirules
    !col[1].append('')
    !col[2].append(!a.split(',')[1])
    !col[3].append(!a.split(',')[2])
    !rtext.append(!a.split(',')[3])
  enddo

  !this.actionlist.setheadings( !heading )
  !this.actionlist.setcolumns( !col )
  !this.actionlist.rtext = !rtext
  !this.selectelement(!item)

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getassemblyrules(!item is STRING)

  !component = !this.currentcomp

  !dtext = ARRAY()
  !col1  = ARRAY()
  !col2  = ARRAY()
  !rtext = ARRAY()

  -- now go and compile the list
  !heading[1] = 'Rule'
  !heading[2] = 'Type'
  !heading[3] = 'Value'
  !col[1] = ARRAY()
  !col[2] = ARRAY()
  !col[3] = ARRAY()
  !col[1].append('Form')
  !col[2].append('')
  !col[3].append('')
  !rtext.append('FORM')
  do !a values !component.formrules
    !col[1].append('')
    !col[2].append(!a.split(',')[1])
    !col[3].append(!a.split(',')[2])
    !rtext.append(!a.split(',')[3])
  enddo
  !col[1].append('Function')
  !col[2].append('')
  !col[3].append('')
  !rtext.append('FUNC')
  do !a values !component.funcrules
    !col[1].append('')
    !col[2].append(!a.split(',')[1])
    !col[3].append(!a.split(',')[2])
    !rtext.append(!a.split(',')[3])
  enddo
  !col[1].append('Primary Origin')
  !col[2].append('')
  !col[3].append('')
  !rtext.append('ORIP')
  do !a values !component.primaryrules
    !col[1].append('')
    !col[2].append(!a.split(',')[1])
    !col[3].append('P ' & !a.split(',')[2])
    !rtext.append(!a.split(',')[3])
  enddo
--  !col[1].append('Secondary Origin')
--  !col[2].append('')
--  !col[3].append('')
--  !rtext.append('ORIS')
--  do !a values !component.secondaryrules
--    !col[1].append('')
--    !col[2].append(!a.split(',')[1])
--    !col[3].append('P ' & !a.split(',')[2])
--    !rtext.append(!a.split(',')[3])
--  enddo

  !this.actionlist.setheadings( !heading )
  !this.actionlist.setcolumns( !col )
  !this.actionlist.rtext = !rtext

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for editing the current rule
define method .editrule()

  -- !element can be a text like STYP POSI or the reference of a validvalue
  !element = !this.actionlist.selection().dbref()
  handle any
    -- we have not picked a validvalue - we've picked a heading
    !!alert.error('No Rule selected')
    return
  endhandle

  !!hvacassemblyrules.current = !element
  handle any
    pml load form !!hvacassemblyrules
    !!hvacassemblyrules.current = !element
  endhandle
  if !element.unset() then
    !!alert.error('No Valid Elements!')
    return
  endif

  !!hvacassemblyrules.designcomponent = !this.explorerselected
  handle any
  endhandle

  if !element.type.eq('DDAT') then
    !type = !element.dkey
  else
    !type = !element.owner.dkey
  endif
  !!hvacassemblyrules.purp = !type
  !!hvacassemblyrules.mode = 'Edit'

  show !!hvacassemblyrules

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for inserting a rule into the assembly definition
define method .newrule()

  !!hvacassemblyrules.mode = 'New'
  handle any
    pml load form !!hvacassemblyrules
    !!hvacassemblyrules.mode = 'New'
  endhandle
  !!hvacassemblyrules.designcomponent = !this.explorerselected
  -- if the rtext is pointing to an element then we go to that
  !element = !this.actionlist.selection().dbref()
  handle any
    !type = !this.actionlist.selection()
    -- its coming out as stype
    !!hvacassemblyrules.purp = !type
    !!hvacassemblyrules.current = !this.assembly.dataset
    !!hvacassemblyrules.designcomponent = !this.explorerselected
    !!hvacassemblyrules.settagtext()
  elsehandle NONE
    if !element.unset() then
      !!alert.error('No Valid Elements!')
      return
    endif
    -- we have a dbref defined
    !dkey = !element.owner.dkey
    !!hvacassemblyrules.purp = !dkey
    !!hvacassemblyrules.current = !element
  endhandle

  show !!hvacassemblyrules

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .deleterule()

 !element = !this.actionlist.selection().dbref()
  handle any
    !!alert.error('No Rule to Delete')
    return
  endhandle
  if !element.unset() then
    !!alert.error('No Valid Elements!')
    return
  endif
  !!ce = !element

  if !!ce.type.eq('VVALUE') then
    if !!alert.confirm('Ok To Delete Value').eq('YES') then
      Delete VVALUE
      -- if there are no members for the ddat then get rid of it.
      if !!ce.members.size().eq(0) then
         delete ddat
      endif
    endif
  elseif !!ce.type.eq('DDAT') then
    if !!alert.confirm('Ok To Delete Value').eq('YES') then
      Delete DDAT
    endif
  endif

  -- Navigate to APPLDA element
  APPLDA
  -- problem here#
  !xx = !this.explorerselected
  !this.systemexplorer.selectelement(!!ce.owner.string())
  !this.systemexplorer.selectelement(!xx.string())

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- tidy up method
define method .killcall()

  aid clear text all
  !this.hide()

endmethod
