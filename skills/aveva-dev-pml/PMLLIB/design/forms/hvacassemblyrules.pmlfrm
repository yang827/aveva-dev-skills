-- Define form
setup form !!hvacassemblyrules at xr 0 yr 0

  title    |HVAC Assembly Rules|
  init     |!this.init()|

 -- Template Name
  para .name   width 32 lines 1

 -- Data
  path down

  frame  .purpframe |                               |
    text   .desc    |Specification:|   width 32 STRING
    text   .func    |Stype:        |   width 32 string
    path right
    button .pick 'Pick' at xmin.func  ymin call |!this.pickorigin()|
  exit
  -- Bottom Line
  button .apply   |  OK  | at xmin form+0 ymax+0.5 call |!this.ok()|
  button .dismiss |Cancel| at xmax form-size ymin  cancel

  -- Members
  member .mode                  is STRING
  -- Creation mode flag
  member .type                  is STRING
  -- Create type
  member .rule                  is STRING
  -- value of the expression being used
  member .current               is DBREF
  -- Item to Modify/place to create
  member .designcomponent       is DBREF
  member .purp                  is STRING
  member .purpcode              is STRING
  member .dataset               is DBREF
  member .assembly              is DBREF
  member .copycomp              is DBREF
  member .designpoint           is REAL

-- End of form definition
exit
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .settagtext()

  !this.desc.visible      = TRUE
  !this.func.visible      = TRUE
  !this.func.active       = TRUE

  !this.pick.visible      = FALSE

  if !this.purp.eq('FORM') then
    !this.purpframe.tag = 'Build by Form'
    !this.desc.tag = |Form Name:    |
    !this.func.tag = |              |
    !this.func.visible = FALSE
    !this.func.active = FALSE
    !this.desc.settooltip('Enter Form name without !! and () ')
  elseif !this.purp.eq('FUNC') then
    !this.purpframe.tag = 'Build by Function:'
    !this.desc.tag = |Function Name:|
    !this.func.tag = |              |
    !this.func.active = FALSE
    !this.func.visible = FALSE
  elseif !this.purp.eq('ORIP') then
    !this.purpframe.tag = 'Primary Origin Element:'
    !this.desc.tag = |Element:        |
    !this.func.tag = |PPOINT:         |
    !this.func.visible = TRUE
    !this.func.active = TRUE
    !this.pick.visible = TRUE
  elseif !this.purp.eq('ORIS') then
    !this.purpframe.tag = 'Secondary Origin Element:'
    !this.desc.tag = |Element:        |
    !this.func.tag = |PPOINT :        |
    !this.func.visible = TRUE
    !this.func.active = TRUE
    !this.pick.visible = TRUE
  elseif  !this.purp.eq('POSI') then
    !this.purpframe.tag = 'Positioning Command'
    !this.desc.tag = |DIST,THRO etc:|
    !this.func.visible = FALSE
    !this.func.active = FALSE
  elseif  !this.purp.eq('ORIE') then
    !this.purpframe.tag = 'Orientation Command'
    !this.desc.tag = |Orientation:  |
    !this.func.visible = FALSE
    !this.func.active = FALSE
  else
    -- its a name
    !this.purpframe.tag = 'Name Command'
    !this.desc.tag = |Name:         |
    !this.func.tag = |text:         |
    !this.func.visible = FALSE
    !this.func.active = FALSE
  endif

  !this.name.val = 'Name: ' & !this.getautoname()

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .init()

  -- !!ce = !this.current
  !!ce = !this.designcomponent
  APPLDA
  !this.assembly = !!ce
  ddse 1
  handle any
    !!alert.error('Assembly has no dataset')
    return
  endhandle
  !this.dataset = !!ce
  !!ce = !this.designcomponent
  if !this.mode.eq('Edit') then
    !rule = !this.current
    !this.getattributes()
  elseif !this.mode.eq('Delete') then
    !!ce = !this.current
    !type = !!ce.type
    if !!alert.confirm('Ok to delete $!type').eq('YES') then
      delete $!type
      applda
      !!hvacassemblymgr.selectcomponent(!!ce.string())
    endif
  else
    -- it must be new
    !this.desc.val = ''
    !this.func.val = ''
  endif

  !this.settagtext()

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .getautoname() is STRING

  !applda = APPLDA
  !seedname = !applda.name & '-DDSE-'
  if !this.purp.eq('FORM') then
    !name = !seedname & 'FORM'
  elseif !this.purp.eq('FUNC') then
    !name = !seedname & 'FUNC'
  elseif !this.purp.eq('ORIP') then
    !name = !seedname & 'ORIP'
  elseif !this.purp.eq('ORIS') then
    !name = !seedname & 'ORIS'
  elseif  !this.purp.eq('POSI') then
    !name = !seedname & !this.designcomponent.name & '-POSI'
  elseif  !this.purp.eq('ORIE') then
    !name = !seedname & !this.designcomponent.name & '-ORI'
  else
    -- its a name
    !name = !seedname & !this.designcomponent.name & '-NAME'
  endif

  return !name

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .getattributes()

  !save = !!ce
  -- assuming we are at a valid value

  !item = !this.current
  if !item.type.eq('DDAT') then
    !dkey = !item.dkey
  else
    !dkey = !item.owner.dkey
  endif

  !this.settagtext()
  if !dkey inset('ORI','NAME') then
    -- it is a set of validvalues
    !this.setgadgets(!item, 2)
  elseif !dkey inset('FUNC','FORM','POSI','ORIE') then
    !this.setgadgets(!item, 3)
  elseif !dkey inset('ORIP') then
    !this.setgadgets(!item, 5)
  elseif !dkey inset('ORIS') then
    !this.setgadgets(!item, 6)
  else
     !!alert.error('Badly defined Data Element in Design Dataset')
  endif

  !!ce = !save

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
-- method to set the form gadgets based on the form type.
define method .setgadgets(!rule is DBREF, !ntexts is REAL)

  if !ntexts.eq(2) then
    !text = !rule.validvalue
    !spec  = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
    !stype = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
    !this.desc.val = !spec
    !this.func.val = !stype
  elseif !ntexts.eq(3) then
    !text = !rule.validvalue
    !spec  = !text.replace(|'|,||).replace(|(|,||,1).replace(|)|,||,-1)
    !this.desc.val = !spec
    !this.func.val = ''
  elseif !ntexts.eq(5) then
    !text = !rule.cfdp.orip.string()
    !number  = !rule.number
    !this.desc.val = !text
    !this.func.val = '$!number'
  elseif  !ntexts.eq(6) then
    !text = !rule.cfdp.oris.string()
    !number  = !rule.number
    !this.desc.val = !text
    !this.func.val = '$!number'
  endif

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .ok()

  if !this.mode.eq('Edit') then
    !this.setvalues()
  else
    !this.createnew()
  endif

  if !this.purp inset('ORIP','ORIS') then
    APPLDA
    !!hvacassemblymgr.selectcomponent(!!ce.string())
  else
    !!hvacassemblymgr.selectcomponent(!this.designcomponent.string())
  endif

  !this.hide()

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
-- method for creating and editing
define method .createnew()

  !!ce = !this.dataset

  !name = !!ce.name & '-' &  !this.designcomponent.string()  & '-' & !this.purp
  -- there is no current ddat
  $!name
  handle any
    new ddat $!name
    handle any
      !!alert.error('Name Already Defined')
    endhandle
    dkey $!this.purp
  elsehandle NONE
    dkey $!this.purp
  endhandle
  !!ce.ddproperty = !this.designcomponent.flnm.string()

  -- don't bother to name valid values
  if !this.purp inset('ORIP','ORIS') then
    dkey $!this.purp
    number $!this.func.val
  else
    new vvalue
    !this.current = !!ce
    !this.setvalues()
  endif

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
-- method for setting the vvalue values
define method .setvalues()

  !!ce = !this.current

  if !this.purp inset('ORIP','ORIS') then
    dkey $!this.purp
    number $!this.func.val
    return
  endif

  if !this.func.active.not() then
    !string = '( |' & !this.desc.val & '|)'
  else
    !string = '( |' & !this.desc.val & '%' & !this.func.val & '|)'
  endif

  !!ce.validvalue = !string
  !!ce.valrule = !this.designcomponent.flnm.string()

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .pickorigin()

 -- Define edg packet
  !packet             = object EDGPACKET()
  !packet.key         = 'HVAC'
  !packet.type        = 'HVAC'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = 'HVAC'
  !packet.action = '!!hvacassemblyrules.pickorigin(!this.return[1])'
  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPpoint('Pick a point')

  !!edgcntrl.add(!packet)

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .pickorigin(!action is EDGPICKDATA)

  !!ce = !action.item
  applda
  handle any
    !!alert.error('Identified Component is not part of the Current Assembly')
    return
  endhandle
  if !!ce.neq(!this.assembly) then
    !!alert.error('Identified Component is not part of the Current Assembly')
    return
  endif

  !this.designcomponent = !action.item
  !this.desc.val = !action.item.string()
  !this.func.val = !action.point.string()

endmethod
