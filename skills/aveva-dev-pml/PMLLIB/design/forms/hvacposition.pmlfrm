-- Description:     HVAC Positioning form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyCallBack()                  POSITION            Apply button callback
--  changeShape()                    -                   Change Shape
--  close()                          -                   Close form
--  coordinateSettings()             -                   Setting the format of positional gadgets according to present coordinate system.
--  displayPosition(POSITION)        -                   Display the passed position in posControl gadgets.
--  hvacPosition()                   -                   Constructor
--  init()                           -                   Initialising the posControl gadgets for new position or current position
--  pickPositionMethod()             -                   EDG pick position.
--  posControl()                     -                   Method called every time the posControl gadgets change via the .changeAction
--  tag(POSITION)                    -                   Tag position
--  tidy()                           -                   Tidy up aid graphics
--  transposeSizes()                 -                   Transpose Sizes
--
------------------------------------------------------------------------

--Import DLL
import 'PositionControl'
handle ANY
endhandle
!hvacPositionShowAttributes = true
!hvacPositionShowAttributes = !!hvacPositionShowAttributes
handle ANY
endhandle

setup form !!hvacPosition dialog resizeable
  !this.iconTitle = 'Position'
  !this.formTitle = 'Position'

 if (!hvacPositionShowAttributes) then
    frame .attributesFrame |Attributes|  anchor left + right + top at x0 ymax+0.2 width 34 height 5
      option .shape        |Tail Shape    |    at x0 ymin call |!this.changeShape()| width 14
      text   .inputA       |Tail Duct 'A' |    at x0 ymax width 16 is real format !!distanceFmt
      button .transpose    |Transpose 'A/B'|   at xmax-size ymax call |!this.transposeSizes()|
      text   .inputBore    |Tail Bore     |    at x0 ymin.transpose width 16 is real format !!distanceFmt
      text   .inputB       |Tail Duct 'B' |    at x0 ymax width 16 is real format !!distanceFmt
      text   .direction    |Tail Direction|    at x0 ymax width 16 is direction
    exit
  endif

  frame .newPositionControl 'Tail Position'  anchor left + right + top at x0 ymax+0.2 width 34 height 5
    container .netPositionContainer nobox PMLNetCONTROL 'NET' dock fill
  exit

  button .pickPosition 'Pick Position' at x0 ymax+0.5 anchor left + top callback '!this.pickPositionMethod()'
  button .applyButton  'OK' at xmax form-size ymax anchor right + top callback '!this.applyCallBack()'

  -- Form Members
  -- Store Position
  member .storedPosition   is POSITION

  -- Attributes shown
  member .showAttributes   is BOOLEAN

  -- Branch Element
  member .element          is DBREF

  -- Head or Tail
  member .headOrTail       is STRING

  -- New or Old
  member .newOrOld         is STRING

  -- store or return
  member .action           is STRING

  -- Aid Graphics
  member .tag              is REAL

  -- EDG Description
  member .edgDescription   is STRING

  using namespace 'Aveva.Pdms.Presentation'
  member .posControl       is POSITIONCONTROL

  -- Form to return to
  member .callingForm       is STRING

  -- Form member to return to
  member .callingMember     is STRING

exit
!this.showAttributes = !hvacPositionShowAttributes

-- End of form definition

------------------------------------------------------------------------
--
-- Method:      hvacPosition
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hvacPosition()

  -- Initialise Variables
  !this.storedPosition = object POSITION('E0')
  !this.headOrTail = 'Head'
  !this.newOrOld   = 'New'

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.posControl        = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                   = object SHIPGRID()
  !gridDefined            = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')
  endif

  !this.coordinateSettings()

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'

  -- EDG Description
  !this.edgDescription        = 'Position'

  -- Aid graphic numbers
  !this.tag            = !!aidNumbers.add('HVAC Position')

  -- Error handle?
  !this.netPositionContainer.control = !this.posControl.handle()

  -- Whenever the posControl gadget changes
  !this.posControl.changeAction('!!hvacPosition.posControl()')

  -- Whatever happens on the Apply will be undoable
  !this.applyButton.setUndoable(!!hvacControl.standardUndoable)

  -- *** Only if Attributes Shown ***
  if (!this.showAttributes) then
    !shapeDetailText = ARRAY()
    !shapeDetailText.append('RECT')
    !shapeDetailText.append('CIRC')
    !shapeDetailText.append('OVAL')
    !this.shape.dtext = !shapeDetailText
    !this.shape.rtext = !shapeDetailText

    !this.inputBore.visible = false
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialising the posControl gadgets for new position or current position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Navigate and validate
  if (!this.newOrOld eq 'Old') then
    BRAN
    handle ANY
      !!alert.error('Not an HVAC branch')
      return
    elsehandle NONE
      if (TYPE of OWNER eq 'HVAC') then
        -- OK
      else
        -- Tidy aids
        !this.tidy()
        !!alert.error('Not an HVAC branch')
      endif
    endhandle
  endif
  !this.element = !!ce

  -- Specific actions for new or old, head or tail
  if (!this.headOrTail eq 'Head' and !this.newOrOld eq 'Old') then
    !position = !!ce.hpos.wrt(world)
    -- *** Only if Attributes Shown ***
    if (!this.showAttributes) then
      !this.inputA.val    = :hxysize[1]
      handle ANY
        !this.inputA.val    = 0mm
      endhandle
      !this.inputB.val    = :hxysize[2]
      handle ANY
        !this.inputB.val    = 0mm
      endhandle
      !this.inputBore.val = !!ce.hbore.real()
      !this.direction.val = !!ce.hdir
      !shape = !!ce.hconn
      handle ANY
        !shape = 'RECT'
      endhandle
    endif
  elseif (!this.headOrTail eq 'Tail' and !this.newOrOld eq 'Old') then
    !position = !!ce.tpos.wrt(world)
    -- *** Only if Attributes Shown ***
    if (!this.showAttributes) then
      !this.inputA.val    = :txysize[1]
      handle ANY
        !this.inputA.val    = 0mm
      endhandle
      !this.inputB.val    = :txysize[2]
      handle ANY
        !this.inputB.val    = 0mm
      endhandle
      !this.inputBore.val = !!ce.tbor.real()
      !this.direction.val = !!ce.tdir
      !shape = !!ce.tconn
      handle ANY
        !shape = 'RECT'
      endhandle
    endif
  elseif (!this.headOrTail eq 'Head' and !this.newOrOld eq 'New') then
    !position = !this.storedPosition
  elseif (!this.headOrTail eq 'Tail' and !this.newOrOld eq 'New') then
    !position = !this.storedPosition
  endif

  !this.formTitle     = | Explicit Branch | &  !this.headOrTail
  !this.newPositionControl.tag     = !this.headOrTail & | Position|
  -- *** Only if Attributes Shown ***
  if (!this.showAttributes) then
    !this.shape.tag     = !this.headOrTail & | Shape    |
    !this.inputA.tag    = !this.headOrTail & | Duct 'A' |
    !this.inputB.tag    = !this.headOrTail & | Duct 'B' |
    !this.direction.tag = !this.headOrTail & | Direction|
    if (!shape eq 'MAIN') then
      !shape = 'RECT'
    endif
    !this.shape.select('rtext', !shape)
    if (!this.inputB.val eq 0 and !this.inputA.val gt 0) then
      !this.shape.select('rtext', 'CIRC')
    endif
    !this.changeShape()
  endif

  -- Display in the position gadget
  !this.posControl.xyz(!position.east, !position.north, !position.up)
  !this.displayPosition(!position.wrt(worl))

endmethod
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Initialise Variables
  !this.tidy()

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

  -- Hide this form
  !this.hide()

endmethod
------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.tag>

endmethod
------------------------------------------------------------------------
--
-- Method:      applyCallBack
--
-- Description: Apply button callback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Position
--
------------------------------------------------------------------------
define method .applyCallBack() is POSITION

  -- Initialise Variables
  !!ce = !this.element
  !this.storedPosition         = object POSITION()

  -- Position
  !this.storedPosition       =  N0
  !newPos  = !this.posControl.xyz()
  !this.storedPosition.east  = !newPos[0]
  !this.storedPosition.north = !newPos[1]
  !this.storedPosition.up    = !newPos[2]

  -- Different actions depending on what is requested
  if (!this.action eq 'Store') then
    -- Storing result in form member only

    -- Close the form
    !this.close()

    -- Store result on the calling form
    !member = !this.callingForm & !this.callingMember
    $!member = !this.storedPosition
    handle ANY
    endhandle

    -- Return
    return !this.storedPosition
  else
    -- Applying the result if we can

    -- Navigate and validate
    BRAN
    handle ANY
      !!alert.error('Not an HVAC branch')
      return !this.storedPosition
    elsehandle NONE
      if (TYPE of OWNER eq 'HVAC') then
        -- OK
      else
        -- Tidy aids
        !this.tidy()

        !!alert.error('Not an HVAC branch')
        -- Return
        return !this.storedPosition
      endif
    endhandle

    if (!this.headOrTail eq 'Head') then
      HPOS $!this.storedPosition
      handle ANY
        !!alert.error(!!error.text)
      elsehandle NONE
        HREF Nulref
        handle ANY
        endhandle
      endhandle
      if (!this.showAttributes) then
        !ductA  = !this.inputA.val
        !ductB  = !this.inputB.val
        !bore   = !this.inputBore.val
        !boreAB = !ductA + !ductB
        !direction = !this.direction.val
        !shape = !this.shape.selection('rtext')
        !!ce.hconn = !shape
        if (!shape eq 'CIRC') then
          hbore $!bore
          !!ce.hdir  = !direction
          :hxysize $!ductA 0mm
        else
          hbore $!boreAB
          !!ce.hdir  = !direction
          :hxysize $!ductA $!ductB
        endif
      endif
    elseif (!this.headOrTail eq 'Tail') then
      TPOS $!this.storedPosition
      handle ANY
        !!alert.error(!!error.text)
      elsehandle NONE
        TREF Nulref
        handle ANY
        endhandle
      endhandle
      if (!this.showAttributes) then
        !ductA  = !this.inputA.val
        !ductB  = !this.inputB.val
        !bore   = !this.inputBore.val
        !boreAB = !ductA + !ductB
        !direction = !this.direction.val
        !shape = !this.shape.selection('rtext')
        !!ce.tconn = !shape
        if (!shape eq 'CIRC') then
          tbore $!bore
          !!ce.tdir  = !direction
          :txysize $!ductA 0mm
        else
          tbore $!boreAB
          !!ce.tdir  = !direction
          :txysize $!ductA $!ductB
        endif
      endif
    endif

    -- Close the form
    !this.close()

    -- Return
    return !this.storedPosition
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Position to tag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tag(!position is POSITION)

  -- Initialise Variables
  AID CLEAR ALL $!<this.tag>

  -- Text description
  !endText      = 'Explicit ' & !this.headOrTail & ' Position'

  -- Aid info
  AID TEXT NUMBER $!<this.tag> '$!endText' AT $!<position>

endmethod
------------------------------------------------------------------------
--
-- Method:      coordinateSettings
--
-- Description: Setting the format of positional gadgets according to present coordinate system.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .coordinateSettings()

   -- Check if a ship grid system is defined
   !grid            = object SHIPGRID()
   !gridDefined     = !grid.position.set()
   if(!gridDefined)then
     !this.posControl.gridvisible(true)
     !this.posControl.gridFormat()
   else
      !this.posControl.gridvisible(false)
      var !coord coord
      if (!coord.eq('ENU'))then
        !this.posControl.enuFormat()
      else
        !this.posControl.xyzFormat()
      endif
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:      pickPositionMethod
--
-- Description: EDG pick position.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPositionMethod()

  !packet = object EDGPACKET()
  !packet.definePosition('Pick ' & !this.headOrTail & ' position')
  !packet.priority    = 2
  !packet.remove      = true
  !packet.action = '!!hvacPosition.displayPosition(!this.return[1].position.wrt(worl))'
  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
--
-- Method:      displayPosition()
--
-- Description: Display the passed position in posControl gadgets.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Passed position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPosition(!position is POSITION)

  -- Display the passed position in the position control gadget
  !this.posControl.xyz(!position.east, !position.north, !position.up)

  -- Tag the new position
  !this.tag(!position)

endmethod
------------------------------------------------------------------------
--
-- Method:      posControl()
--
-- Description: Method called every time the posControl gadgets change via the .changeAction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .posControl()

  -- Get the Position
  !position       =  object POSITION()
  !newPos  = !this.posControl.xyz()
  !position.east  = !newPos[0]
  !position.north = !newPos[1]
  !position.up    = !newPos[2]
  !position.origin = /*

  -- Tag the new position
  !this.tag(!position)

endmethod
------------------------------------------------------------------------
--
-- Method:      transposeSizes()
--
-- Description: Transpose Sizes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .transposeSizes()

  !hold = !this.inputB.val
  !this.inputB.val = !this.inputA.val
  !this.inputA.val = !hold

endmethod
------------------------------------------------------------------------
--
-- Method:      changeShape()
--
-- Description: Change Shape
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeShape()

  !circular = (!this.shape.selection() eq 'CIRC')
  !notCircular = !circular.not()
  !this.inputBore.visible = !circular
  !this.inputA.visible    = !notCircular
  !this.inputB.visible    = !notCircular
  !this.transpose.visible = !notCircular

endmethod
