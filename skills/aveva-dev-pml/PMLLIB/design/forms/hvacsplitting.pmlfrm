--
--
-- Description:
-- HVAC, Branch and HVAC component splitting form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addElement(STRING)               -                   Adds elements to the Branches List
--  close()                          -                   closes ths form after tidy
--  dbPlane(DBREF)                   -                   Creates plane from picked db planar element
--  definePlane()                    -                   Defines a plane to create split markers
--  displaySplit(MENU,STRING)        -
--  displaySplits(BOOLEAN)           -                   Display current splits for selected branches
--  enhance()                        -                   Highlights the branches selected in the list
--  explicitPlane()                  -                   Creates plane explicitly
--  flipHeadTube()                   -                   On creation the Head tube may need flipping
--  gridPlane(DBREF)                 -                   Creates plane using a reference grid element
--  highlightToggle(MENU,STRING)     -                   Sets element highlight selection state
--  hvacSplitting()                  -                   Constructor
--  initialise()                     -                   Initialisation
--  modifyCallback(STRING)           -                   Redefine the plane definition based on gphPlaneEdit plane
--  modifyPlane(STRING)              -                   Modifies the defined plane position & orientation
--  modifyPlanePosition()            -                   Reassign the modified plane to the defined plane
--  placeMarker()                    -                   Creates split atta at the intersection points
--  planeDisplaySettings()           -                   Sets/Modifies the plane display settings
--  radioCallback()                  -                   Callback for the Marker or Assembly radio gadget
--  removeElement(STRING)            -                   Removes selected element(Branch) from the list
--  removePlane()                    -                   Removes the previously defined plane
--  repositionMarker()               -                   Positions the split marker(split Atta)
--  selectAssembly()                 -                   Callback for the select Assembly button
--  setGadgetVisibility()            -                   Sets active state of text gadget for existing HVAC system name
--  splitHvac()                      -                   Splits HVAC elements based on the options selected
--  stdPlinePlane(EDGPICKDATA)       -                   Creates plane using picked pline
--  stdPointPlane(EDGPICKDATA)       -                   Creates plane using picked p-point
--  tidy()                           -                   Cleans up graphical aids on quit call
--  unenhance()                      -                   Un-highlights the elements in the Branches list
--  updateBranchList()               -                   Updates the branches list
--  updatePlanePos(DBREF)            -                   update the position and orientation of the plane when using edg picks in explicit mode
--  updatePopupMenu()                -                   Sets the active state of Branch list pop-up menu
--  validateElement(DBREF)           -                   Checks if passed element is a valid HVAC element
--  validateText()                   BOOLEAN             Checks if entered text is the name of existing HVAC system
--
------------------------------------------------------------------------
setup form !!hvacSplitting dialog dock right

  !this.iconTitle     = 'HVAC Splitting'
  !this.formTitle     = 'Split HVAC'
  !this.formRevision  = ' $Revision: 0.0 $ '
  !this.initcall      = '!this.initialise()'
  !this.quitcall      = '!this.close()'

  -- Selected Branch list
  list .branchList 'Branches to Split '           at xmin                      anchor L+R+T+B columns multiple          width 38 height 5  tooltip 'Branches to be split'

  path down  vdist 0

  -- Options for selecting elements/branches to be added to the list
  option .addOptions                              at xmin.branchList           anchor L+B                                                  tooltip 'Select an option and press Add button' width 15

  path right

  -- Add button to Append elements to the list
  button .load  '   Add   '                       at xmax.branchList-size      anchor R+B                                                  tooltip 'Select an option and then press Add button' width 6

  path down
  -- Split Marker frame
  frame .splitMarker 'Details'                   at xmin.branchList           anchor L+R+B                             width 38

    -- Plane definition frame
    frame .planeDefinition  'Plane definition '  at xmin.splitMarker+1        anchor L+R+B
      halign left
      vdist 0
      -- Plane size
      text .planeSize 'Plane Size  '             at xmin.planeDefinition+1    anchor L+R+B                             width 8 is REAL format !!distanceFmt

      path right
      -- Plane fill
      toggle .planeFill | Fill|                  at xmax.planeSize+4.0        anchor R+B     states |off| |on|

      path down

      -- Allows the user to define the plane created in the graphical canvas
      para .planeOptPara                         at xmin.planeSize            anchor L+B    text 'Define Plane using'  width 12
      option .planeOption                        at xmax+1 ymin.planeOptPara  anchor L+R+B                             width 14 tooltip 'Options for defining a plane to split'

      -- Allows the user to modify the plane
      para .modifyPlane                          at xmin.planeOptPara         anchor L+B    text 'Modify Plane '       width 12
      option .modifyPlaneOption                  at xmax+1 ymin.modifyPlane   anchor L+R+B                             width 14 tooltip 'Options for modifying the plane'

    exit
    -- end of plane definition frame

    -- Radio Frame to select Marker or Assembly
    frame .rg1 |Insert|
      path down
      rToggle .rad1 tagwid 7 |Marker|   States '' 'Marker'
      path right
      valign centre
      rToggle .rad2 tagwid 7 |Assembly| States '' 'Assembly'
    exit

    frame .markerTaskPanel panel anchor all at xmin ymax.rg1
      -- Creates the marker (Split Atta) at the split point
      button .placeMarker linklabel 'Create Marker'          at xmin.planeDefinition      anchor L+B width 11
      path down
      para .repositionMarkerText                                                  anchor L+B text 'Reposition Marker ' width 12
      path right
      option .repositionMarker                       at xmin.planeOption          anchor L+R+B  width 14  tooltip 'Options to reposition marker(split atta)'
    exit

    frame .assemblyTaskPanel panel anchor all at xmin ymax.rg1
      -- Creates the marker (Split Atta) at the split point
      button .placeAssembly linklabel 'Select Assembly...'   at xmin.planeDefinition anchor L+B width 20
      path down
      para .selectedAssemblyText anchor L+B  at xmin ymax  text  'Selected Assembly:-'  width 20
      para .selectedAssemblyName anchor R+L+B  at xmin ymax  text  'unset'              width 37
    exit

  exit
  -- end of split marker frame

  path down
  -- split hierarchy option frame
  frame .split 'Split Branches and Move elements into ' at xmin.branchList      anchor L+R+B  width 22
    halign left
    vdist 0

    rToggle .current   'Current HVAC '  at xmin+1      states '' 'CURRENT'
    vdist 0
    rToggle .auto      'New HVAC '                     states '' 'AUTO'
    rToggle .other     'Existing HVAC'                 states '' 'OTHER'

    text .existingHvac                  at xmin.planeOption ymin                anchor L+R+B                             width 23 is STRING
  exit
  -- end of split hierarchy option frame

  path down
  -- splits the branches list element at marker positions
  button .applySplit  'Apply'         at                  ymax+0.2            anchor L+B
  button .flipHead linklabel   'Flip Head Tube'  at         xmax+5 ymin         anchor L+B

  -- Pop up Menu for Branches list
  menu .listMenu popup

  !this.listMenu.add('callback',  'Add CE',               '!this.addElement(|CE|)')
  !this.listMenu.add('callback',  'Add from list',        '!this.addElement(|LIST|)')
  !this.listMenu.add('callback',  'Add Graphical Pick',   '!this.addElement(|GPHPICK|)')
  !this.listMenu.add('callback',  'Add Window Selection', '!this.addElement(|GPHSEL|)')
  !this.listMenu.add('SEPARATOR', 'removeOptions')
  !this.listMenu.add('callback',  'Remove Selected',      '!this.removeElement(|REMSEL|)',  'removeSel')
  !this.listMenu.add('callback',  'Remove All',           '!this.removeElement(|REMALL|)',  'removeAll')
  !this.listMenu.add('SEPARATOR')
  !this.listMenu.add('toggle',    'Highlight Selection',  '!this.highlightToggle(','highLight')
  !this.listMenu.add('toggle',    'Display existing splits',  '!this.displaySplit(','displaySplit')

  !this.branchList.setPopup(!this.listMenu)

  -- Form Members

  -- Option Task for Split HVAC
  member .splitOption           is STRING

  -- Option for hierarchy in which new branch will be created
  member .hierarchyOption       is STRING
  -- AUTO requires new name
  -- CURRENT should be current HVAC name
  -- OTHER requires existing HVAC name

  -- Name of HVAC where split elements will be created
  member .hvacName              is STRING

  -- Stores the list elements dbref
  member .elements              is ARRAY

  -- stores the names of branches and its owners
  member .branches              is ARRAY
  member .owners                is ARRAY

  -- HVAC split manager object
  member .splitManager          is HVACSPLITMANAGER

  -- Graphical plane
  member .plane                 is GPHPLANE

  -- Stores the aid number registered for the GPHPLANE
  member .planeNumber           is REAL

  -- sets if selected branch in the list is to be highlighted
  member .highlightSelection    is BOOLEAN

  -- undo object
  member .undo                  is UNDOABLE

  -- sets true if ship grid is defined
  member  .gridDefined          is BOOLEAN

  -- Stores the aid planes used to display splits
  member .aidPlanesSplitDisplay is ARRAY

  -- For assembly insertion
  member .assembly              is HVACASSEMBLY

  -- Register form
  !!appFormCntrl.registerForm(!this)

exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      hvacSplitting
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hvacSplitting()

  -- callbacks
  !this.branchList.callback         = '!this.enhance()'
  !this.load.callback               = '!this.addElement( !this.addOptions.selection() )'
  !this.planeSize.callback          = '!this.modifyPlane( |SIZE| )'
  !this.planeFill.callback          = '!this.modifyPlane( |FILL| )'
  !this.planeOption.callback        = '!this.definePlane()'
  !this.modifyPlaneOption.callback  = '!this.modifyPlane( !this.modifyPlaneOption.selection() )'
  !this.placeMarker.callback        = '!this.placeMarker()'
  !this.repositionMarker.callback   = '!this.repositionMarker()'
  !this.split.callback              = '!this.setGadgetVisibility()'
  !this.existingHvac.callback       = '!this.validateText()'
  !this.applySplit.callback         = '!this.splitHvac()'
  !this.flipHead.callback           = '!this.flipHeadTube()'

  -- Column Headings for Branches list
  !headings[1]    =   'Owner'
  !headings[2]    =   'Name'
  !this.branchList.setHeadings(!headings)

  -- Option list for adding elements to the Branches list
  !addListDtext[1] = 'CE'
  !addListDtext[2] = 'List'
  !addListDtext[3] = 'Graphical Pick'
  !addListDtext[4] = 'Window Selection'
  !this.addOptions.dtext = !addListDtext

  !addListRtext[1] = 'CE'
  !addListRtext[2] = 'LIST'
  !addListRtext[3] = 'GPHPICK'
  !addListRtext[4] = 'GPHSEL'
  !this.addOptions.rtext = !addListRtext

  -- Option for Plane definition
  !planeDef[1]  = 'DB Planer Element'
  !planeDef[2]  = 'Element'
  !planeDef[3]  = 'Ppoints'
  !planeDef[4]  = 'Pline'
  !planeDef[5]  = 'Reference Grid'
  !planeDef[6]  = 'Explicitly...'
  !this.planeOption.dtext  = !planeDef

  !planeDefRtext[1]  = 'PLANARELEM'
  !planeDefRtext[2]  = 'STDELEM'
  !planeDefRtext[3]  = 'PPOINT'
  !planeDefRtext[4]  = 'PLINE'
  !planeDefRtext[5]  = 'REFGRID'
  !planeDefRtext[6]  = 'EXPLICIT'
  !this.planeOption.rtext  = !planeDefRtext

  -- Option for Modifying the defined Plane
  !modifyPlane[1]  = 'Definition...'
  !modifyPlane[2]  = 'Position'
  !this.modifyPlaneOption.dtext  = !modifyPlane

  !modifyPlaneRtext[1]  = 'MODIFYDEF'
  !modifyPlaneRtext[2]  = 'MODIFYPOS'
  !this.modifyPlaneOption.rtext  = !modifyPlaneRtext

  -- Option for Marker positioning
  !repositionMarker[1]  = 'Explicitly At...'
  !repositionMarker[2]  = 'Relatively By...'

  !repositionMarkerRtext[1]  = 'AT'
  !repositionMarkerRtext[2]  = 'BY'

  -- Load ship grid data
  !grid                   = object SHIPGRID()
  !this.gridDefined       = !grid.position.set()

  if(!this.gridDefined) then
    !repositionMarker[3]       = 'Using Ship References...'
    !repositionMarkerRtext[3]  = 'SHIPREF'
  endif

  !this.repositionMarker.dtext  = !repositionMarker
  !this.repositionMarker.rtext  = !repositionMarkerRtext

  -- Marker/Assembly frame visibility
  !this.markerTaskPanel.visible = true
  !this.assemblyTaskPanel.visible = false
  !this.placeAssembly.callback = '!this.selectAssembly()'

  -- Marker/Assembly radio gadget
  !this.rg1.val = 1
  !this.rg1.callback = '!this.radioCallback()'

  -- Load aid constructors, if they haven't already been loaded
  if(undefined(!!aidConstructors)) then
    !aidConstructors = object AIDCONSTRUCTORS()
    !aidConstructors.globalInstance()
  endif

endmethod
-- End of Method definition
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Initialise the Plane size and plane fill option
  !this.planeSize.val = 1500mm

  -- set the split hierarchy option AUTO as default
  !this.split.val         =   1

  -- set the text gadget for existing hvac system name as inactive
  !this.existingHvac.active = false

  -- set the active state of Branch list pop-up menu
  !this.updatePopupMenu()

  -- set the highlight toggle default as true
  !this.listMenu.setFieldProperty('highLight','selected',true)
  !this.highlightSelection  = true

  !this.setGadgetVisibility()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: Highlights the branches selected in the list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhance()

   -- unenhance all elements in the list
   !this.unenhance()

   -- highlight the selected elements
   if(!this.highlightSelection) then
      !selection  =  !this.branchList.val
      do !j indices !selection
         enhance $!this.elements[$!selection[$!j]] colour $!!gphcolopt.highlight.code
      enddo
   endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      unenhance
--
-- Description: Un-highlights the elements in the Branches list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unenhance()

   do !i indices !this.elements
      unenhance $!this.elements[$!i]
   enddo

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      placeMarker
--
-- Description: Creates split atta at the intersection points
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .placeMarker()

   if(!this.elements.unset())then
      !!alert.error('No elements for splitting. Add elements to the list and retry.')
      return
   else
      -- set the branchesToSplit member of HVAC split manager object
      !this.splitManager.setBranches(!this.elements)
   endif

   if(!this.plane.plane.unset())then
      !!alert.error('Plane not defined. Define a Plane to create split markers.')
      return
   else
      !this.plane   =   !!aidNumbers.numbers[!this.planeNumber]
      -- set the plane member of HVAC split manager object
      !this.splitManager.setPlane(!this.plane)
   endif

   -- create split ATTAs at the plane intersection points
   !this.splitManager.createSplitMarkers()

   -- clear graphical aids
   !this.tidy()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      splitHvac
--
-- Description: Splits HVAC elements based on the options selected
--              AUTO    - Split elements stored in the New HVAC system created
--              CURRENT - Split elements stored in the same HVAC system
--              OTHER   - Split elements stored in an Existing HVAC system
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .splitHvac()

    -- If we are creating assemblies we want to create temporary split markers
    -- then we want to do the splitting immediately
    if (!this.assemblyTaskPanel.visible) then
     !this.placeMarker()
    endif
    -- End of immediate split marker creation

    if(!this.elements.unset())then
       !!alert.error('No Branches in the list to split')
       return
    else
       -- set the branchesToSplit member of HVAC split manager object
       !this.splitManager.setBranches(!this.elements)
    endif

    -- set the object's storageOption - AUTO, CURRENT, or OTHER
    !this.splitManager.storageOption    = !this.hierarchyOption

    if(!this.hierarchyOption  eq 'OTHER') then

       -- validate the text entered for the name of hvac
       !validText = !this.validateText()
       if (!validText.not()) then
         return
       endif

       -- set the object's member to the HVAC name entered in the text box
       !this.splitManager.setHvacName(!this.existingHvac.val)
    endif

    !this.splitManager.split()

    -- If we are creating assemblies we want to now build an assembly at the head of each new branch
    if (!this.assemblyTaskPanel.visible and !this.assembly.set()) then
    	-- Quick test to see if we have an assembly
    	if (!this.assembly.appldata.unset()) then
    		-- !!alert.message('No Assembly selected')    		
    		return
      endif
      if (!this.assembly.primaryOrigin.set()) then
        !origin = 1
      else
        !origin = 0
      endif
      do !branch values !this.splitManager.newBranches
        -- May be 0 or 1 related to primary origin
        !this.assembly.buildinTube(!branch.hpos, !branch, !origin, false )
        -- if we have used 1 for origin above then we need to sort out branch heads
        !!ce = !branch
        !href = href
        conn ph to pa of 1
        href $!href
        !headTailPosition = !!ce.hpos
        -- And the connected branch
        !!ce = !href
        tref $!branch
        tpos $!headTailPosition
      enddo
    endif
    -- End of build an assembly at the head of each new branch

    -- clear graphical aids
    !this.tidy()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      addElement
--
-- Description: Adds elements to the Branches List
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      option by which a branch is added to the list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addElement(!addOption is STRING)

  if(!addOption eq 'CE') then
     !this.validateElement(!!ce)

  elseif(!addOption eq 'LIST') then
     !form = !!cdcList
     !numb = !form.name
     !block = object BLOCK('!!cdlist' & !numb)
     if(!block.string().lowcase() eq '!!cdlist0' )  then
        !!alert.error('No List defined')
        return
     elseif(undefined(!block.evaluate())) then
        !!alert.error('Current List is empty')
        return
     endif

     !listElements  = !block.evaluate()
     do !i indices !listElements
        !this.validateElement(!listElements[!i].dbref())
     enddo

  elseif(!addOption eq 'GPHPICK') then

    !packet = object EDGPACKET()
    !packet.initialisation  = '!!pickedElement = object DBREF()'
    !packet.action = '!!pickedElement = !this.return[1].item'
    !packet.elementPick('Pick an HVAC component')
    !packet.description = 'Pick an HVAC Component'
    !packet.key      = 'pickHvac'
    !packet.remove = TRUE
    !packet.pickPacket.picks[1].pick.input[3]   = |(type of own) eq 'BRAN' and (type of own of own) eq 'HVAC'|
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.escape  = ''
    !packet.continue = '!!hvacSplitting.validateElement(!!pickedElement)'

    !!edgCntrl.add(!packet)

  elseif(!addOption eq 'GPHSEL') then

      -- Get elements
      !selection        = object SELECTION()
      !selection.getCurrent()
      !elements         = !selection.getSelection()

      -- If Selection is empty
      if(!elements.empty()) then
         !!alert.error('No items to add. Please Pick/Window select items in the view and retry.')
         return
      endif

      -- Collect relevant types
      !collection      = object COLLECTION()
      !collection.scope(!elements)

      !expression = object EXPRESSION()
      !hvacExpressionText = '(type of owner) eq |BRAN| and (type of owner of owner) eq |HVAC|'
      !expression.expression(!hvacExpressionText)

      !collection.filter(!expression)
      !results = !collection.results()

      !resultOwner = !results.evaluate(object BLOCK('!results[!evalIndex].owner'))

      !this.elements.appendArray(!resultOwner)

      !this.updateBranchList()
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      removeElement
--
-- Description: Removes selected element(Branch) from the list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      option whether to remove only selected or
--                            all elements from the list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeElement(!removeOption is STRING)

  -- Unenhance elements
  do !i indices !this.elements
     UNENHANCE $!this.elements[$!i]
  enddo

  if(!removeOption eq 'REMALL') then
     !this.branchList.dtext = ARRAY()
     !this.elements.clear()

  elseif(!removeOption eq 'REMSEL') then
    !selectedIndices  = !this.branchList.val
    if(!selectedIndices.unset()) then
      !!alert.message('Select element(s) in the list to remove')
      return
    endif

    do !index values !selectedIndices.invert()
       !this.elements.remove(!index)
    enddo
    !this.elements.compress()
  endif

  !this.updateBranchList()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      validateElement
--
-- Description: Checks if passed element is a valid HVAC element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       element to be checked whether it is a valid
--                            HVAC System - Main or branch or component
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateElement(!element is DBREF)

     if (!element.unset()) then
       return
     endif

     if(!this.addOptions.selection() eq 'GPHPICK') then
       if(defined(!!pickedElement) and !!pickedElement.unset()) then
          return
       endif
     endif

     if(!element.type eq 'HVAC') then
        !branches = !element.members
        !this.elements.appendArray(!branches)

     elseif(!element.type eq 'BRAN' and !element.owner.type eq 'HVAC') then
        !this.elements.append(!element)

     else
        !types[1] = 'HVAC'
        -- check if passed element is a valid HVAC element
        !hvacElement  = !!dtbOwnerOfTypes(!element,!types)
        if(!hvacElement.set()) then
           -- append the element's owner (branch) to the elements array
           !this.elements.append(!element.owner)
        else
          var !branches collect all (BRAN) with (TYPE OF OWNER eq 'HVAC') for $!element
          !branch = ARRAY()
          do !i indices !branches
            !branch[!i] = !branches[!i].dbref()
          enddo
          if (!branch.size() gt 0) then
            !this.elements.appendArray(!branch)
          else
          	!!alert.message('No HVAC Branch to add')
          	return
          endif
        endif
     endif

    !this.updateBranchList()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updatePopupMenu
--
-- Description: Sets the active state of Branch list pop-up menu
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updatePopupMenu()

  if(unset(!this.branchList.dtext)) then
     !this.listMenu.setFieldProperty('removeSel','active',false)
     !this.listMenu.setFieldProperty('removeAll','active',false)
     !this.listMenu.setFieldProperty('highLight','active',false)
  else
     !this.listMenu.setFieldProperty('removeSel','active',true)
     !this.listMenu.setFieldProperty('removeAll','active',true)
     !this.listMenu.setFieldProperty('highLight','active',true)
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setGadgetVisibility
--
-- Description: set active state of the text gadget for existing HVAC system name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadgetVisibility()

  -- set the text gadget for existing hvac system name active/inactive
  !index  = !this.split.val
  !state  = !this.split.rtoggle(!index)

  if(!state.onValue eq 'OTHER') then
     !this.existingHvac.active = true
  else
     !this.existingHvac.active = false
  endif

  -- set the value of the form member with the option selected
  !this.hierarchyOption = !state.onValue

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      repositionMarker
--
-- Description: Repositions the split marker(split Atta)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .repositionMarker()

  if(!!ce.type neq 'ATTA' or !!ce.atty neq 'SPLI') then
     !!alert.error('Not a valid Split Marker element')
     return
  endif

  -- Mark the database to Undo the marker re-positioning
  !undoMove = object UNDOABLE()
  !undoMove.description('Move Position marker')
  !undoMove.add()

  !positionOption = !this.repositionMarker.selection()
  if(!positionOption eq 'AT') then
     -- Reposition marker(atta) Explicitly At
     !!pos3dExplicit()

  elseif(!positionOption eq 'BY') then
     -- Reposition marker(atta) Relatively At
     !!pos3dRelative()

  elseif(!positionOption eq 'SHIPREF') then
     -- Reposition marker(atta) using Ship Reference Positioning
     show !!shipReferencePosition
  endif

  !undoMove.endUndoable()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updateBranchList
--
-- Description: Updates the branches list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateBranchList()

  !this.elements.unique()
  !this.branches.clear()
  !this.owners.clear()
  UNENHANCE ALL

  do !i indices !this.elements

     !this.branches.append(!this.elements[!i].namn)
     handle (2,202)(2,759)
       !elementsToRemove[!i] = !this.elements[!i]
       skip
     endhandle
     !branch = !this.elements[!i]
     if (!this.highlightSelection) then
       ENHANCE $!branch COLOUR $!!gphcolopt.highlight.code
     endif
     !this.owners.append(!this.elements[!i].owner.namn)
  enddo

  if(defined(!elementsToRemove) and !elementsToRemove.set()) then
    !newArray = !this.elements.difference(!elementsToRemove)
    !this.elements  = !newArray
  endif

  !columns[1] = !this.owners
  !columns[2] = !this.branches

  !this.branchList.setColumns(!columns)
  !this.branchList.rtext  = !columns[2]

  !this.updatePopupMenu()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      validateText
--
-- Description: Checks if entered text is the name of existing HVAC system
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true or false to stop calling function
--
------------------------------------------------------------------------
define method .validateText() is BOOLEAN

  !enteredName  = !this.existingHvac.val
  !this.existingHvac.val  = STRING()

  if(!enteredName.unset() or !enteredName.trim().empty()) then
     !!alert.error('Enter the name of an existing HVAC to store the split members')
     return false

  elseif(!enteredName.upcase() eq 'CE') then
     !types[1] = 'HVAC'
     -- check if passed element is a valid HVAC element
     !hvacElement  = !!dtbOwnerOfTypes(!!ce,!types)
     if(!hvacElement.set()) then
        !name  = !hvacElement.name
     else
        !!alert.error('CE is not a valid HVAC element')
        return false
     endif

  else
     !name  = !!checkName(!enteredName,'old')
     if(!name.set() and !name.dbref().type.neq('HVAC')) then
        !!alert.error('Entered name "$!enteredName" is not an HVAC element')
        return false
     endif
  endif

  if(!name.unset()) then
     !this.existingHvac.val = ''
  else
     !this.existingHvac.val = !name
  endif

  return true

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:    highlightToggle
--
-- Description: Sets element highlight selection state
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        menu object from which the callback is executed
--    2   R      STRING      meta-event occurred on the menu and the
--                             action to be carried out by the method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightToggle(!dummyMenu is MENU, !action is STRING)

  if(!action eq 'SELECT') then
    !this.listMenu.setFieldProperty('highLight','selected',true)
    !this.highlightSelection  = true
    !this.enhance()
  else
    !this.listMenu.setFieldProperty('highLight','selected',false)
    !this.highlightSelection  = false
    !this.unenhance()
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:    displaySplit
--
-- Description: Toggle display of current splits
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        menu object from which the callback is executed
--    2   R      STRING      meta-event occurred on the menu and the
--                             action to be carried out by the method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySplit(!dummyMenu is MENU, !action is STRING)

  if(!action eq 'SELECT') then
    !this.listMenu.setFieldProperty('displaySplit','selected',true)
    !this.displaySplits(true)
  else
    !this.listMenu.setFieldProperty('displaySplit','selected',false)
    !this.displaySplits(false)
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      displaySplits
--
-- Description: Display current splits for selected branches
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN    Display or remove display
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySplits(!switch is BOOLEAN)

  -- Get the selected elements
  !selection  =  !this.branchList.val
  !resBranch = ARRAY()
  do !j indices !selection
    !resBranch.append(!this.elements[!selection[!j]])
  enddo

  if (!switch.not()) then

    -- Let is unhighlight everything
      UNENHANCE ALL
      -- Then also remove the aid planes
      AID CLEAR ALL
      do !i indices !this.aidPlanesSplitDisplay
        !!aidNumbers.remove(!this.aidPlanesSplitDisplay[!i])
      enddo

  else

    UNENHANCE ALL
    do !i indices !resBranch
      if(!this.highlightSelection) then
        ENHANCE $!resBranch[$!i] COLOUR $!!gphcolopt.highlight.code
      endif

      -- Get the last member if there is one
      !member = !resBranch[!i].mem.size()

      if(!resBranch[!i].tref.set())then
        !gphPlane = object GPHPLANE()
        if (!member gt 0) then
          !gphPlane.orientation( object ORIENTATION('Z is ' & !resBranch[!i].mem[!member].ldir.string() & ' and Y is ' & !resBranch[!i].mem[!member].ori.ydir().string() ))
        else
          !gphPlane.orientation( object ORIENTATION('Z is ' & !resBranch[!i].tdir.string() ))
        endif
        !gphPlane.position(!resBranch[!i].tpos)
        !gphPlane.plane()
        !gphPlane.x = !this.planeSize.val
        !gphPlane.y = !this.planeSize.val
        !gphPlane.filled(!this.planeFill.val)
        !this.aidPlanesSplitDisplay.append(!!aidNumbers.add('Split Branch[$!i] - (Tail)'))
        !gphPlane.draw(!i, false)
      else
        write 'Message - Tail of Branch $!resBranch[$!i].flnn is not connected'
      endif
      if(!resBranch[!i].href.set())then
        !gphPlane1 = object GPHPLANE()
        if (!member gt 0) then
          !gphPlane1.orientation(!resBranch[!i].mem[1].ori)
        else
          !gphPlane1.orientation( object ORIENTATION('Z is ' & !resBranch[!i].hdir.string() ))
        endif
        !gphPlane1.position(!resBranch[$!i].hpos)
        !gphPlane1.plane()
        !gphPlane1.x = !this.planeSize.val
        !gphPlane1.y = !this.planeSize.val
        !gphPlane1.filled(!this.planeFill.val)
        !this.aidPlanesSplitDisplay.append(!!aidNumbers.add('Split Branch[$!i] - (Head)'))
        !gphPlane1.draw(!i, false)
      else
        write 'Message - Head of Branch $!resBranch[$!i].flnn is not connected'
      endif
    enddo

  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      definePlane()
--
-- Description: Defines a plane to create split markers
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .definePlane()

  -- remove any previously defined plane
  !this.removePlane()

  if(!this.planeOption.selection() eq 'PLANARELEM') then
     !packet = object EDGPACKET()
     !packet.description = 'DB Planar element pick'
     !packet.key         = 'derivePlane'
     !packet.action      = '!!pickedElement = !this.return[1].item'
     !packet.pickPacket.stdElement('Pick a DB element that can be translated in to a plane')
     !packet.remove = TRUE
     !elementFilter = |type inset('PANE','FLOO','SCREE','HPLATE','HBRCKT')|
     !packet.pickPacket.picks[1].pick.input[3]   =  !elementFilter
     !packet.pickPacket.picks[1].pick.modifiable = FALSE
     !packet.escape  = ''
     !packet.continue = '!!hvacSplitting.dbPlane(!!pickedElement)'

     !!edgCntrl.add(!packet)

  elseif(!this.planeOption.selection() eq 'STDELEM') then
     !packet = object EDGPACKET()
     !packet.description = 'Standard element pick'
     !packet.action      = '!!pickedElement = !this.return[1].item'
     !packet.pickPacket.stdElement('Pick an element to convert into a plane')
     !packet.remove = TRUE
     !packet.pickPacket.picks[1].pick.modifiable = FALSE
     !packet.escape  = ''
     !packet.continue = '!!hvacSplitting.dbPlane(!!pickedElement)'

     !!edgCntrl.add(!packet)

  elseif(!this.planeOption.selection() eq 'PPOINT') then
     !packet = object EDGPACKET()
     !packet.description = 'P-point pick'
     !packet.pickPacket.stdPpoint('Pick a P-point that can be translated in to a plane')
     !packet.action      = '!!pickData = !this.return[1]'
     !packet.remove = TRUE
     !packet.escape  = ''
     !packet.continue = '!!hvacSplitting.stdPointPlane(!!pickData)'

     !!edgCntrl.add(!packet)

  elseif(!this.planeOption.selection() eq 'PLINE') then
     !packet = object EDGPACKET()
     !packet.description = 'P-line pick'
     !packet.pickPacket.stdPline('Pick a P-line that can be translated in to a plane')
     !packet.action      = '!!pickData = !this.return[1]'
     !packet.remove = TRUE
     !packet.escape  = ''
     !packet.continue = '!!hvacSplitting.stdPlinePlane(!!pickData)'

     !!edgCntrl.add(!packet)

  elseif(!this.planeOption.selection() eq 'REFGRID') then
     if(!this.gridDefined) then
        -- Ship Reference Grid
        show !!shipReferencePosition

     else
        -- Standard PDMS Reference grid
        !packet = object EDGPACKET()
        !packet.initialisation  = '!!pickedElement  = object DBREF()'
        !packet.pickPacket.stdElement('Pick a Reference Grid')
        !packet.description = 'Reference Grid pick'
        !packet.action      = '!!pickedElement = !this.return[1].item'
        !packet.remove = TRUE
        !elementFilter = |type eq 'SCTN' and match(gtype,'GRD') gt 0|
        !packet.pickPacket.picks[1].pick.input[3]   = !elementFilter
        !packet.pickPacket.picks[1].pick.modifiable = FALSE
        !packet.escape  = ''
        !packet.continue = '!!hvacSplitting.gridPlane(!!pickedElement)'

        !!edgCntrl.add(!packet)
     endif

  elseif(!this.planeOption.selection() eq 'EXPLICIT') then

     -- load the form
     pml reload form  !!gphPlaneEdit

     -- Define EDG positional pick
     !packet                = object EDGPACKET()
     !packet.key            = 'editPlane'
     !packet.elementPick('pick a HVAC element to position plane')
     !rule = 'TYPE OF OWNER INSET (|BRAN|)'
     !packet.pickPacket.picks[1].pick.input[3] = !rule
     !packet.pickPacket.picks[1].pick.modifiable = FALSE
     !packet.action         = '!!hvacSplitting.updatePlanePos(!this.return[1].item)'
     !packet.description    = !!gphPlaneEdit.plane.description
     !packet.form           = !!gphPlaneEdit
     !packet.close          = '!!gphPlaneEdit.tidy()'
     !packet.priority       = 2
     !packet.remove         = false
     !packet.type           = 'aidConstructors'

     -- Add into EDG packet
     !!edgCntrl.add(!packet)

     -- Redefine ok callback of gphPlaneEdit
     !!gphPlaneEdit.okcall  = '!!hvacSplitting.explicitPlane()'

  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      dbPlane
--
-- Description: Creates plane from picked db planar element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       picked db planar element to create a plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbPlane(!pickedElement is DBREF)

  if(!pickedElement.unset()) then
     return
  endif
  !plane       = object PLANE(!pickedElement.pos,!pickedElement.ori)
  !this.plane  = object GPHPLANE(!plane)

  !this.planeDisplaySettings()

  !this.planeNumber = !!aidNumbers.add(!this.plane)

endmethod
------------------------------------------------------------------------
--
-- Method:      stdPointPlane
--
-- Description: Creates plane using picked p-point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     EDGPICKDATA  pick data returned from the edg pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stdPointPlane(!pickData is EDGPICKDATA)

  if(!pickData.unset()) then
     return
  endif

  !pickedElement  = !pickData.item
  !pickedPoint    = !pickData.point
  !planePos       = !pickedElement.ppos[!pickedPoint]
  !planeDir       = !pickedElement.pdir[!pickedPoint]
  !planeOri       = Z is $!planeDir
  !plane          = object PLANE(!planePos,!planeOri)

  !this.plane  = object GPHPLANE(!plane)

  !this.planeDisplaySettings()

  !this.planeNumber = !!aidNumbers.add(!this.plane)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      stdPlinePlane
--
-- Description: Creates plane using picked pline
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     EDGPICKDATA  pick data returned from the edg pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stdPlinePlane(!pickData is EDGPICKDATA)

  if(!pickData.unset()) then
     return
  endif

  !pickedElement  = !pickData.item
  !pickedPline    = !pickData.pline

  !startPos       = !pickedElement.plst.attribute(!pickedPline)
  !endPos         = !pickedElement.plen.attribute(!pickedPline)
  !planePos       = !startPos.midPoint(!endPos)

  !planeOri       = !pickedElement.plOri.attribute(!pickedPline)

  !plane          = object PLANE(!planePos,!planeOri)
  !this.plane     = object GPHPLANE(!plane)

  !this.planeDisplaySettings()

  !this.planeNumber = !!aidNumbers.add(!this.plane)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      gridPlane
--
-- Description: Creates plane using a reference grid element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       picked grid element to create a plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gridPlane(!pickedElement is DBREF)

  if(!pickedElement.unset()) then
     return
  endif

  !startPos  = !pickedElement.poss
  !endPos    = !pickedElement.pose
  !pos       = !startPos.midPoint(!endPos)

  !xdir      = !pickedElement.ori.xdir().wrt(world)
  !zdir      = !pickedElement.ori.zdir().wrt(world)

  !ori       = Z is $!xdir and X is $!zdir

  !plane      = object PLANE(!pos,!ori)
  !this.plane = object GPHPLANE(!plane)

  !this.planeDisplaySettings()

  !this.planeNumber  = !!aidNumbers.add(!this.plane)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      modifyPlane
--
-- Description: Modifies the defined plane position & orientation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Option to modify the plane definition
--                          MODIFYDEF - modify plane definition
--                          MODIFYPOS - modify plane position
--                          SIZE/FILL - modify plane size & fill
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyPlane(!modifyOption is STRING)

  if(!modifyOption eq 'MODIFYDEF') then

     if(!this.planeNumber.unset())then
        !!alert.error('No split plane defined.')
        return
     endif

     !aidItem   = !!aidNumbers.get(!this.planeNumber)

     -- Edit aid element
     !aidItem.edit(!this.planeNumber)
     handle (2,765)
     elsehandle ANY
       !!alert.error('Unable to find edit method for "' & !!aidNumbers.numbers[!this.planeNumber].objectType() & '"')
     endhandle

     !!gphPlaneEdit.okcall      =   '!!hvacSplitting.modifyCallback(|OK|)'
     !!gphPlaneEdit.cancelcall  =   '!!hvacSplitting.modifyCallback(|CANCEL|)'

  elseif(!modifyOption eq 'MODIFYPOS') then

     !packet                = object EDGPACKET()
     !packet.defineAid('Re-position Aid -')
     !packet.pickPacket.picks[1].prompt        = 'pick aid element'
     -- Defines extract pick for position
     !packet.pickPacket.picks[2] = object EDGPICKTYPE()
     !packet.pickPacket.picks[2].stdPosition('new position')
     !packet.action         = '!!aidConstructors.position(!this.return)'
     !packet.continue       = '!!hvacSplitting.modifyPlanePosition()'
     !packet.priority       = 2
     !packet.type           = 'aidConstructors'

     !!edgCntrl.add(!packet)

  else

    if(!modifyOption eq 'SIZE') then
      if(!this.planeSize.val.unset()) then
        !!alert.error('Plane Size cannot be unset')
        !this.planeSize.val  = 1500mm
      elseif(!this.planeSize.val lt 0) then
        !!alert.error('Plane Size cannot be a negative value')
        !this.planeSize.val  = abs(!this.planeSize.val)
        !this.planeSize.val  = 1500mm
      elseif(!this.planeSize.val eq 0) then
        !!alert.error('Plane Size cannot be zero')
        !this.planeSize.val  = 1500mm
      endif
    endif

    if(!this.plane.plane.set()) then
       !this.planeDisplaySettings()
       !!aidNumbers.replace(!this.planeNumber,!this.plane)
    endif

  endif

endmethod
-- End of method definition .modifyPlane(!modifyOption)
------------------------------------------------------------------------
--
-- Method:      removePlane
--
-- Description: Removes the previously defined plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removePlane()

   -- remove the previously defined plane
   if(!this.plane.plane.set()) then
      !!aidNumbers.remove(!this.planeNumber)
      !this.plane = object GPHPLANE()
      !this.planeNumber = object REAL()
   endif

   !!pickedElement  = object DBREF()
   !!pickData       = object EDGPICKDATA()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Cleans up graphical aids on quit call
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()

  !this.removePlane()

  -- Unenhance elements in the list
  !this.unenhance()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      explicitPlane
--
-- Description: Creates plane explicitly
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .explicitPlane()

  !!gphPlaneEdit.apply()

  !this.plane       = !!gphPlaneEdit.plane
  !this.planeNumber = !!gphPlaneEdit.aidNumber

  -- replace the gphPlaneEdit plane with the form plane member
  !!aidNumbers.replace(!!gphPlaneEdit.aidNumber,!this.plane)

  kill !!gphPlaneEdit

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      planeDisplaySettings
--
-- Description: Sets/Modifies the plane display settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .planeDisplaySettings()

  -- set the fill status of the graphical plane
  if(!this.planeFill.val )then
     !this.plane.filled(true)
  else
     !this.plane.filled(false)
  endif

  -- define the size of the graphical plane
  !size = !this.planeSize.val

  !this.plane.x = !size
  !this.plane.y = !size

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      modifyCallback
--
-- Description: Redefine the plane definition based on gphPlaneEdit plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      type of callback (OK / CANCEL)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyCallback(!callbackType is STRING)

   !!gphPlaneEdit.close()

   if(!callbackType eq 'OK')then

     -- assign the plane and its size from gphPlaneEdit to hvacSplitting form
     !this.planeSize.val = !!gphPlaneEdit.xSize.val
     !this.planeFill.val = !!gphPlaneEdit.filled.val

     !!gphPlaneEdit.plane.position(!!gphPlaneEdit.position.get())
     !!gphPlaneEdit.plane.orientation(!!gphPlaneEdit.orientation.get())
     !!gphPlaneEdit.plane.y  =  !!gphPlaneEdit.plane.x

     !!aidNumbers.replace(!!gphPlaneEdit.aidPlane,!!gphPlaneEdit.plane)

     !this.plane  =  !!gphPlaneEdit.plane

   endif

   !!aidNumbers.remove(!!gphPlaneEdit.aidNumber)

   kill !!gphPlaneEdit

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      modifyPlanePosition
--
-- Description: Reassign the modified plane to the defined plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyPlanePosition()

  -- Assign the modified plane to the defined plane
  if(!this.plane.plane.set()) then
    !this.plane  = !!aidNumbers.numbers[!this.planeNumber]
  endif

endmethod
-- End of method definition .modifyPlanePosition()
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: closes ths form after tidy
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- clear the aid plane and unenhance elements
  !this.tidy()

  -- clear the arrays
  !this.elements.clear()
  !this.branches.clear()
  !this.owners.clear()

  -- clear the branch list
  !this.branchList.dtext  = object ARRAY()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updatePlanePos
--
-- Description: update the position and orientation of the plane when using edg picks in explicit mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref      selected hvac element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updatePlanePos(!element is DBREF)

  !!ce = !element
  if !element.type.eq('BRAN') then
    var !pos hpos of $!element wrt /*
  else
    var !pos pos pa of $!element wrt /*
  endif

  !position = !pos.position()

  !!gphPlaneEdit.position.setAction('!!gphPlaneEdit.preview()')
  !!gphPlaneEdit.position.position(!position)

  !arriveDir = !element.adir
  handle ANY
    !arriveDir = !element.hdir
  endhandle
  !pointVector = object POINTVECTOR(!position, !arriveDir)
  !plane = !pointVector.plane()
  !!gphPlaneEdit.orientation.setAction('!!gphPlaneEdit.preview()')
  !!gphPlaneEdit.orientation.orientation(!plane.orientation)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      flipHeadTube
--
-- Description: On creation the Head tube may need flipping
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .flipHeadTube()

  prompt off
  do
    prompt load escape |Pick branch tubes to flip |
    ID BRAN @
    handle (61,528)
      -- handle the escape from sub-mode
      prompt dismiss
      prompt on
      break
    endhandle
    if (hstube eq /$:AVEVAHVACSPEC$:/HRTUBEA ) then
      hstube /$:AVEVAHVACSPEC$:/HRTUBEB
    elseif (hstube eq /$:AVEVAHVACSPEC$:/HRTUBEB ) then
      hstube /$:AVEVAHVACSPEC$:/HRTUBEA
    elseif (hstube eq /$:AVEVAHVACSPEC$:/HFOTUBEA ) then
      hstube /$:AVEVAHVACSPEC$:/HFOTUBEB
    elseif (hstube eq /$:AVEVAHVACSPEC$:/HFOTUBEB ) then
      hstube /$:AVEVAHVACSPEC$:/HFOTUBEA
      handle ANY
        -- This is a recent addition to the catalogue
      endhandle
    endif
    refresh
  enddo

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      radioCallback
--
-- Description: Callback for the Marker or Assembly radio gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .radioCallback()

  if (!this.rg1.val eq 1) then
    !this.assemblyTaskPanel.visible = false
    !this.markerTaskPanel.visible = true
  else
    !this.markerTaskPanel.visible = false
    !this.assemblyTaskPanel.visible = true
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectAssembly
--
-- Description: Callback for the select Assembly button
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAssembly()

  --Test that we have some Assemblies
  var !assemblies coll all APPLDA with purp eq 'HASY'
  if (!assemblies.size().gt(0)) then
    show !!hvacAssemblyCreation
    !!hvacAssemblyCreation.shownFromSplit(true)
  else
    !!alert.message('No Assemblies exist, you need to create one or Split by Marker')
    !this.rad1.val = true
    !this.radioCallback()
  endif

endmethod
-- End of method definition
