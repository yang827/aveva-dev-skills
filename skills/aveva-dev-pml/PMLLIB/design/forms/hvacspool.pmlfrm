------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addElementsInSameBranch(ARRAY,ARRAY) -
--  addLastSpool(DBREF)              -
--  addSelected()                    -
--  addSpool()                       -                   Add picked elements to the selected spool
--  addSpool(ARRAY)                  -                   Add picked elements to the selected spool
--  addToSpoolFromOtherBranch(ARRAY,ARRAY) -                   Add picked elements to the selected spool
--  approve(DBREF,BOOLEAN)           -                   Approve spool (or not)
--  approve(STRING,BOOLEAN)          -                   Approves (or not) the HVAC spools
--  autoNameSpools()                 -                   Task for auto name toggle
--  checkUpdateStatus(DBREF,STRING)  BOOLEAN
--  clear()                          -                   On error of creating spools, unenhance elements and clear the aids
--  closeForm()                      -                   closes the form
--  deleteSpools()                   -                   Removes all the spools from the current HVAC
--  enhance()                        -                   Enhance colour to selected spool
--  enhancePick(DBREF)               -
--  generateSpools(STRING)           -                   Generates spools for the Current HVAC
--  hvacSpool()                      -                   Constructor
--  initialise()                     -                   Initialisation
--  listSelection(GADGET,STRING)     -
--  listSpools()                     -                   List the generated spools in the form
--  modifySpool(STRING)              -                   Modify the spool
--  nameCheck(STRING)                STRING
--  nameGeneratedSpools()            -                   Names the generated HVAC list and spools
--  nameRegeneratedSpools()          -                   Names the generated HVAC list and spools
--  nameSelectedSpool()              -                   Renames the spool selected in the spool list
--  nameWithFirstAvailableData()     -
--  nameWithNewData()                -
--  regenerateSpools()               -                   regenerate the spools
--  removeFromSpool()                -                   Remove picked elements from the selected spool
--  removeFromSpool(ARRAY)           -                   Remove picked elements from the selected spool
--  renameSpools()                   -                   renames all spools
--  setAction(STRING)                -                   Undo DB changes
--  setTask(STRING)                  -                   To set the task based on the action to be performed
--  splNamingOption(STRING)          -
--  tidyGraphicalFeedback()          -
--  track(DBREF)                     -                   Modifies the form definition based on the db changes
--  unNameSpools(STRING)             -                   un name spools
--  undoRedoAction()                 -
--  unenhance(ARRAY)                 -                   Un enhances the selected spools
--  unenhancePick(DBREF)             -
--  updateActiveElements()           -                   Navigate to the selected spool from list
--  updateEnhance()                  -                   Update the enhanced spool
--  validateListName()               -                   Validates entered name for HVAC Spool List
--  validateSpoolPrefixName()        -                   Validates entered name for HVAC Spool List
--  verify(STRING)                   -                   Verifies the HVAC spools
--
------------------------------------------------------------------------
var !c collect all UDA with (UDNA eq 'HSVLD')
!testExistUDA = !c[1].dbref()
handle ANY
  !existUDA = false
elsehandle NONE
  !existUDA = true
endhandle

setup form !!hvacSpool dialog dock right

  !this.formTitle     = 'HVAC Spool Manager'
  !this.callback      = '!this.initialise()'
  !this.quitCall      = '!this.closeForm()'
  !this.killingCall   = '!this.closeForm()'

  para   .ceHvac                                                anchor L+T     at x0   y0                     text 'HVAC: <none>'                              width 52 lines 1

  button .setHvac       linklabel |Set HVAC|                    anchor R+T     at x45  y0                     callback '!this.track(!!ce)'                     width 6

  line   .tagLine                                               anchor L+T+R     at x0   ymax-0.1               horizontal                                       width 52 height 1

  para   .noHvacTag                                             anchor L+T+R     at x0   ymax+0.2                                                                width 45  lines 3

  -- Frame panel for generating and naming spools
  frame .frNamingOptions   panel                                anchor L+T+R     at x0   ymin.noHvacTag

    -- Spool Naming options
    para   .namingOptionsTag                                    anchor L+T+R     at x0   ymin                   text 'HVAC Spool Naming Options'                 width 20

    path down
    halign left
    vdist 0

    rToggle .rtAutoName       'Auto Name '                                     at x1                          callback '!this.splNamingOption(''AUTO'')'
    vdist 0.2
    rToggle .rtUserDefName    'User Defined Name '                                                            callback '!this.splNamingOption(''USER'')'

    -- frame panel for spool naming options
    frame .splNaming                                            anchor L+T+R     at x1   ymax+0.2                                                                width 50 hei 5

      text   .listName   tagwidth 15   'HVAC Spool List Name'   anchor L+T+R     at x1   y0                     callback '!this.validateListName()'              width 30 is STRING

      text   .splPrefix  tagwidth 15   'Spool Prefix'           anchor L+T+R     at x1   ymax+0.2               callback '!this.validateSpoolPrefixName()'       width 30 is STRING

      path down
      halign left
      vdist 0.2

      rToggle .rtNewData     'Generate New Data'
      vdist 0
      rToggle .rtFirstData   'Use First available data'                        at x1   ymax+0.2

    exit

    toggle .renameRemovedElements |Rename spools generated by 'Remove Spool Elements'|  at x1   ymax+1

    -- end of spool naming options panel

    button .done          linklabel 'Spool Tasks'               anchor L+T     at x0   ymax+0.5                 callback '!this.setTask(|LISTSPOOLS|)'           width 8

    button .generate      linklabel 'Generate Spools'           anchor R+T     at x40  ymin                   callback '!this.setAction(|GENERATE|)'           width 10

  exit
  -- end of frame panel for generating and naming spools

  -- Main panel to display spools list and the user action on spools
  frame    .frMainPanel   panel                                 anchor ALL     at x0   ymin.noHvacTag

    para   .spoolTag                                            anchor L+T+R     at x0   ymin                   text 'HVAC Spools'                               width 10 lines 1

    button .namOpt        linklabel 'Naming Options'            anchor R+T     at x41  ymin                   callback '!this.setTask(|GENERATE|)'             width 10

    list   .spoolsList                                          anchor ALL   at x0   ymax               callback '!this.listSelection(' columns MULTI    width 50 lines 12

    button .deleteSpools  linklabel 'Delete Spools'             anchor L+B     at x0   ymax+0.2               callback '!this.setAction(|DELETE|)'             width 8
    button .reGenerate    linklabel 'Regenerate'                anchor R+B     at x44  ymin                   callback '!this.setAction(|REGENERATE|)'         width 7

    -- Frame panel for verification and modification
    frame  .framePanel    panel                                 anchor L+R+B     at x0   ymax+0.2

      -- Verification tags and gadgets
      para   .verifyTag                                         anchor L+B     at x0   y0                     text 'Verification:'
      line   .verifyLine                                        anchor L+R+B   at x0   ymax-0.6     horizontal                                       width 52 height 1

      button .verifyHvac   linklabel |Verify HVAC  |            anchor L+B     at x0   ymax        callback '!this.verify(|HVAC|)'
      button .verifySpool  linklabel |Verify HVAC Spool|        anchor L+B     at x0   ymax    callback '!this.verify(|SPOOL|)'
      -- end of verification tags

      -- Modification tags and gadgets
      para   .modifyTag                                         anchor L+B     at x0   ymax+0.2   text 'Modification:'
      line   .modifyLine                                        anchor L+R+B   at x0   ymax-0.6     horizontal                                       width 52 height 1

      button .addElement    linklabel |Add Spool Elements|      anchor L+B     at x0   ymax        callback '!this.modifySpool(|ADD|)'
      button .addElements   linklabel |Add Spool Elements (by picking last only)|      anchor L+B     at x0   ymax        callback '!this.modifySpool(|ADDLAST|)'
      button .addSelected   linklabel |Combine Spools selected in 'HVAC Spools' list|      anchor L+B     at x0   ymax        callback '!this.addSelected()'
      button .remElements   linklabel |Remove Spool Elements|   anchor L+B     at x0   ymax   callback '!this.modifySpool(|REMOVE|)'
      -- end of modification tags

      if (!existUDA) then
        -- Approval tags and gadgets
        para   .approvalTag                                         anchor L+B    at x0 ymax+0.2   text 'Approval:'
        line   .approvalLine                                        anchor L+R+B  at x0 ymax-0.6     horizontal                                       width 52 height 1

        button .approveHvac     linklabel |Approve HVAC      |  anchor L+B    at x0 ymax    callback '!this.approve(|HVAC|, true)'
        button .unApproveHvac   linklabel |Un-Approve HVAC      |  anchor L+B    at xmax ymin  callback '!this.approve(|HVAC|, false)'
        button .approveSpool    linklabel |Approve HVAC Spool|  anchor L+B    at x0 ymax    callback '!this.approve(|SPOOL|, true)'
        button .unApproveSpool  linklabel |Un-Approve HVAC Spool|  anchor L+B    at xmax ymin  callback '!this.approve(|SPOOL|, false)'


        -- end of approval tags
      endif

    exit
    -- end of frame panel for verification and modification

    -- Frame panel for displaying verification status
    frame .resultFramePanel  panel                              anchor L+R+B     at x0   ymax.framePanel

      para   .resultTag                                         anchor L+B     at x0   y0                                    width 50 lines 1

      line   .resultTagLine                                     anchor L+R+B   at x0   ymax.resultTag-0.6     horizontal     width 52 height 1

      para   .resultMessage                                     anchor L+B     at x0   ymax+0.2                              width 50 lines 3

    exit
    -- end of frame panel for verification status

  exit
  -- end of main panel (frMainPanel)

  -- Pop up Menu for HVAC Spools list
  menu .splListMenu popup

  !this.splListMenu.add('callback',  'Rename Spool',            '!this.nameSelectedSpool()','rename')
  !this.splListMenu.add('callback',  'Rename All Spools',       '!this.renameSpools()','renameAll')
  !this.splListMenu.add('callback',  'Un-name Selected Spools', '!this.unNameSpools(|SELECTED|)','unnameSel')
  !this.splListMenu.add('callback',  'Un-name All Spools',      '!this.unNameSpools(|ALL|)','unnameAll')

  !this.spoolsList.setPopup(!this.splListMenu)

  -- Form members
  member .hvacSpoolManager is HVACSPOOLMANAGER

  -- Current HVAC
  member .hvac             is DBREF

  -- Active Elements selected in the list
  member .activeElements   is ARRAY

  -- Spools array (dbref)
  member .spools     is ARRAY

  -- Name as displayed in form
  member .spoolName        is ARRAY

  member .isAutoName       is BOOLEAN

  -- member to store aid numbers for graphical text
  member  .aidNumbers      is ARRAY

  -- Enhance object
  member  .enhanceSpool  is COMENHANCE

  -- Remember the rows
  member .spoolListRows    is ARRAY

  -- EDG picked Elements
  member .pickedElements is ARRAY

  -- Use Approval mechanism
  member .useApproval    is BOOLEAN

  -- Register form
  !!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      hvacSpool
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hvacSpool()

  var !c collect all UDA with (UDNA eq 'HSVLD')
  !testExistUDA = !c[1].dbref()
  handle ANY
    !this.useApproval = false
  elsehandle NONE
    !this.useApproval = true
  endhandle

  !this.noHvacTag.val = 'Select HVAC or an element below HVAC.'

  !this.rtAutoName.val    = true
  !this.splNaming.active  = false
  !this.listName.active   = false

  !this.rtFirstData.val   = true

  --  Heading For list gadget
  !listHead = ARRAY()
  !listHead.append('Spools')
  !listHead.append('Verification status')
  !listHead.append('Failure Details')
  if (!this.useApproval) then
    !listHead.append('Approved')
  endif

  !this.spoolsList.setHeadings(!listHead)

  !this.renameRemovedElements.val = true

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- initialise the spools array
  !this.spools  = ARRAY()

  -- set the spool naming frame status
  -- for some reasons (may be core) the first toggle is selected
  if(!this.rtAutoName.val) then
    !this.splNamingOption('AUTO')
  else
    !this.splNamingOption('USER')
  endif

  -- Track Current HVAC
  !this.track(!!ce)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      autoNameSpools
--
-- Description: Task for auto name toggle
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoNameSpools()

    !oldCe  = !!ce

    -- Unname the spools for auto naming
    do !n indices !this.spools
      if(!this.checkUpdateStatus(!this.spools[!n],'NAME').not()) then
        return
      endif

      !!ce  = !this.spools[!n]
      UNNAME CE
    enddo

    -- Navigate to the Spool List and unname it
    !!ce  = !this.spools[1].owner
    if(!this.checkUpdateStatus(!!ce,'NAME').not()) then
      return
    endif

    UNNAME CE

    -- call autoname function to name spool list and spools
    call !!autoNameCe(true)

    -- navigate back to the old ce
    !!ce  = !oldCe
    handle ANY
      -- if old ce is deleted then navigate to the HVAC
      !!ce  = !this.hvac
    endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setTask
--
-- Description: To set the task based on the action to be performed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for task(NOHVAC, GENERATE, LISTSPOOLS and DISPLAYRESULTS)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!task is STRING)

  -- Unenhance the spools
  !this.unenhance(!this.spools)

  -- Set All gadgets visibility to FALSE
  !this.noHvacTag.visible       = false

  !this.frNamingOptions.visible = false

  !this.frMainPanel.visible     = false

  -- When the current element is not a HVAC element
  if(!task eq 'NOHVAC') then
    !this.noHvacTag.visible     = true

  -- Display for generating spools
  elseif(!task eq 'GENERATE') then

    !this.frNamingOptions.visible  = true
    if(!this.spools.set() ) then
      !this.done.active     = true
      !this.generate.active = false
    else
      !this.done.active     = false
      !this.generate.active = true
    endif

  -- List all generated spools
  elseif(!task eq 'LISTSPOOLS') then

    if(!this.spools.set() ) then
      !this.frMainPanel.visible       = true
      !this.resultFramePanel.visible  = false

      -- populate the spool list
      !this.listSpools()
      -- Let us validate the spools
      !this.verify('HVAC')
      handle ANY
        return
      endhandle

      -- make the Generate button inactive
      !this.generate.active = false

    else
      -- go to generate and name spool frame if HVAC has no spools
      !this.setTask('GENERATE')
    endif

  -- Display results
  elseif(!task eq 'DISPLAYRESULTS') then
    !this.frMainPanel.visible      = true
    !this.resultFramePanel.visible = true

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Modifies the form definition based on the db changes
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       Current Element
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track(!element is DBREF)

   -- unenhance the spools if set
   if (!this.spools.set()) then
     !this.unenhance(!this.spools)
   endif

   -- clear the graphical text display
   !this.tidyGraphicalFeedback()

   -- Check if passed element is a valid HVAC element
   !types[1]      = 'HVAC'
   !hvacElement   = !!dtbOwnerOfTypes(!element,!types)
   if(!hvacElement.set()) then
      !this.hvac = !hvacElement
   else
      !this.hvac = object DBREF()
   endif

   !this.splListMenu.setFieldProperty('rename','visible',false)
   !this.splListMenu.setFieldProperty('unnameSel','visible',false)

   if(!this.hvac.unset()) then
     -- Set name as None for elements other than HVAC
     !this.ceHvac.val     = 'HVAC: <none>'
     !this.noHvacTag.val  = 'Selected element is not an HVAC element'
     !this.setTask('NOHVAC')

   else

     !isUpdatable = !!dbrefUpdatable(!this.hvac)
     if(!isUpdatable.not()) then
       !this.setTask('NOHVAC')
       !this.noHvacTag.val = 'Selected HVAC $!!error.text'
       !!alert.error(!!error.text)
       return
     endif

     !this.ceHvac.val = 'HVAC: ' + !this.hvac.name

     -- Collect HVAC spools and check whether the HVAC element is spooled
     !spoolColl = object COLLECTION()
     !spoolColl.scope(!this.hvac)
     !spoolColl.type('HSPOOL')
     !this.spools = !spoolColl.results()

     if(!this.spools.set()) then
       if(!this.spools[1].owner.isnamed) then
        !this.listName.val  = !this.spools[1].owner.namn
        !this.splPrefix.val = !this.spools[1].owner.namn & '/HS'
       else
        !this.listName.val  = !this.hvac.namn & '-Spools'
        !this.splPrefix.val = !this.hvac.namn & '-Spools/HS'
       endif

       -- navigate to the main spool tasks panel
       !this.setTask('LISTSPOOLS')

     else
        !hvacName = !this.hvac.namn
        -- check name for hvac list
        !validName  = !this.nameCheck(!hvacName & '-Spools')
        if(!validName.unset() or !validName.empty()) then
          !this.listName.val  = ''
          !this.splPrefix.val = !this.hvac.namn & '-Spools/HS'
        else
          !this.listName.val  = !validName.substring(2)
          !this.splPrefix.val = !this.listName.val & '/HS'
        endif

        -- navigate to the generate and naming spools panel
        !this.setTask('GENERATE')
     endif

   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      generateSpools
--
-- Description: Generates spools for the Current HVAC
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for task(GENERATE, REGENERATE)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .generateSpools(!type is STRING)

  if( !type.eq('REGENERATE') ) then

    !listColl = object COLLECTION()
    !listColl.scope(!this.hvac)
    !listColl.type('HSLIST')
    if(!listColl.results().set())then
      !spoolList = !listColl.results()[1]
    endif

    if(!this.checkUpdateStatus(!spoolList, 'NAME').not() ) then
      return
    endif

    if(!this.spools.set()) then
      do !spool values !this.spools
        if(!this.checkUpdateStatus(!spool, 'NAME').not() ) then
          return
        endif

        !this.approve(!spool, false)

      enddo
    endif

  endif

  -- Generate HVAC spools
  !this.hvacSpoolManager.generateHvacSpools(!this.hvac)

  !spoolColl = object COLLECTION()
  !spoolColl.scope(!this.hvac)
  !spoolColl.type('HSPOOL')
  !this.spools = !spoolColl.results()

  if(!this.spools.unset())then
    return
  endif

  -- Auto name spools if auto name is on
  if(!this.rtAutoName.val) then
    !this.autoNameSpools()

  else
    if !type eq 'GENERATE' then
      !this.nameGeneratedSpools()
    else
      !this.nameRegeneratedSpools()
    endif
  endif

  -- update the list
  !this.setTask('LISTSPOOLS')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      regenerateSpools
--
-- Description: regenerate the spools
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .regenerateSpools()

  !this.unenhance(!this.spools)

  -- check update status of the spool to which the passed elements belong
  do !spool values  !this.spools

    -- check update status of the elements
    if(!this.checkUpdateStatus(!spool,'').not()) then
      return
    endif

    !spoolElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
    !spoolElementsRef = !spoolElements.evaluate(object BLOCK('!spoolElements[!evalIndex].refNo'))
    do !n indices !spoolElementsRef
      if(!this.checkUpdateStatus(!spoolElementsRef[!n],'').not()) then
        return
      endif
    enddo

    !this.approve(!spool, false)

  enddo

  -- Generate HVAC spools
  !this.hvacSpoolManager.generateHvacSpools(!this.hvac)

  !listColl = object COLLECTION()
  !listColl.scope(!this.hvac)
  !listColl.type('HSLIST')
  if(!listColl.results().unset())then
    return
  endif

  !spoolColl = object COLLECTION()
  !spoolColl.scope(!this.hvac)
  !spoolColl.type('HSPOOL')
  !this.spools = !spoolColl.results()

  if(!this.spools.unset())then
    return
  endif

  -- update the list
  !this.setTask('LISTSPOOLS')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: listSpools
--
-- Description: List the generated spools in the form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listSpools()

  -- initialise the list
  !this.spoolsList.dtext =  ARRAY()
  !this.spoolsList.rtext =  ARRAY()

  if(!this.spools.unset()) then
    !!alert.message('No Spools generated for the HVAC.')
    return
  endif

  -- Get the names of spools
  !spoolsFullName = !this.spools.evaluate(object BLOCK('!this.spools[!evalIndex].flnn'))
  handle ANY
    !!alert.error('Spool is corrupt')
    return
  endhandle

  -- Compose the names for display
  !this.spoolName = !spoolsFullName.evaluate(object BLOCK('!spoolsFullName[!evalIndex].before(| of|) '))

  -- compose the array for display text
  do !t indices !this.spoolName
     !row[!t][1]        = !this.spoolName[!t]
  enddo

  !this.spoolsList.setRows(!row)

  -- compose the array for return text
  !spoolsRtext = !this.spools.evaluate(object BLOCK('!this.spools[!evalIndex].string()'))
  !this.spoolsList.rtext = !spoolsRtext

  -- initialise the active elements array
  !this.activeElements  = ARRAY()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameSelectedSpool
--
-- Description: Renames the spool selected in the spool list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameSelectedSpool()

  !selectedSpools = !this.spoolsList.selection().reindex(!this.spoolsList.val.sortedIndices())
  if(!selectedSpools.size() gt 1) then
    !!alert.message('Select a single Spool to rename')
    return
  elseif(!this.spoolsList.val.unset()) then
    !!alert.message('Select a Spool from the list to rename')
    return
  endif

  --!dtextArray = !this.spoolsList.dtext
  --!rtextArray = !this.spoolsList.rtext

  --!selectedIndex  = !this.spoolsList.val.first()

  -- check if the selected spool is named
  -- throws error (for missing '/') if it is named
  !spool  = object DBREF(!selectedSpools[1])
  handle (2,813)
    !spool  = object DBREF('/' & !selectedSpools[1])
  elsehandle ANY
    return
  endhandle

  -- check if selected spool is updatable element
  if(!this.checkUpdateStatus(!spool,'NAME').not()) then
     return
  endif

  if(!spool.isnamed) then
    !oldNameStr  = !spool.namn
  else
    !oldNameStr = !spool.type & ' ' & !spool.tyseq
  endif

  do !n
    -- user input for renaming the spool
    !nameStr  = !!alert.input('Rename the Spool',!oldNameStr)
    -- check the input name
    if(!nameStr.trim().eq(!oldNameStr)) then
      !!alert.message('Please give a different name')
      return
    endif

    !name = !!checkName(!nameStr,'new')
    break if(!name.set())

  enddo

  --!selectedText = !this.spoolsList.dtext[!selectedIndex]
  --!replaceText = !selectedText.replace(!oldNameStr,!name.substring(2))

  !undoName = object UNDOABLE()
  !undoName.undoAction('!!hvacSpool.undoRedoAction()')
  !undoName.redoAction('!!hvacSpool.undoRedoAction()')
  !undoName.add()

  -- set the validated name
  !spool.name = !name

  !undoName.endUndoable()

  !this.setTask('LISTSPOOLS')

  --!dtextArray[!selectedIndex] = !replaceText
  --!rtextArray[!selectedIndex] = !spool.flnn
  --
  --!this.spoolsList.dtext = !dtextArray
  --!this.spoolsList.rtext = !rtextArray

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameGeneratedSpools
--
-- Description: Names the generated HVAC list and spools
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameGeneratedSpools()

  !hvacSpoolList = !this.spools[1].owner
  if(!this.checkUpdateStatus(!hvacSpoolList,'NAME').not()) then
     return
  endif

  if(!this.listName.val.set() and !this.listName.val.empty().not()) then
    !hvacSpoolList.name = '/' + !this.listName.val
  endif

  do !n indices !this.spools

    if(!this.checkUpdateStatus(!this.spools[!n],'NAME').not()) then
       return
    endif

    !splName = !this.splPrefix.val & !n.string()

    !validName = !this.nameCheck(!splName)

    skip if(!validName.unset() or !validName.empty())

    !this.spools[!n].name = !validName

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameRegeneratedSpools
--
-- Description: Names the generated HVAC list and spools
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameRegeneratedSpools()

  !hvacSpoolList = !this.spools[1].owner
  if(!this.checkUpdateStatus(!hvacSpoolList,'NAME').not()) then
     return
  endif

  if(!this.listName.val.set() and !this.listName.val.empty().not()) then
    !hvacSpoolList.name = '/' + !this.listName.val
  endif

  if(!this.splNaming.val eq 1) then
    -- Generate New Data
    !this.nameWithNewData()
  elseif(!this.splNaming.val eq 2) then
    --Use First available data
    !this.nameWithFirstAvailableData()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameWithFirstAvailableData
--
-- Description: Names with the first available data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameWithFirstAvailableData()

  !stdPrefixName  = !this.splPrefix.val

  !index  = ARRAY()
  do !i indices !this.spools

    if(!this.spools[!i].isnamed ) then
      !spoolIndexStr = !this.spools[!i].namn.after(!stdPrefixName).trim()

      skip if(!spoolIndexStr.empty())
      !index[!i]  = !spoolIndexStr.real()
      handle ANY
        !index[!i]  = 0
        skip
      endhandle
    else
      if(!this.checkUpdateStatus(!this.spools[!i],'NAME').not()) then
        return
      endif
    endif

  enddo

  if(!index.set()) then
    !lastCount  = !index.sort().last() + 1
  else
    !lastCount  = 1
  endif

  do !n indices !this.spools

    skip if(!this.spools[!n].isnamed )

    !newName  =   !stdPrefixName & !lastCount.string()

    -- check the names
    !validName  = !this.nameCheck(!newName)
    if(!validName.unset() or !validName.empty()) then
      skip
    else
      !this.spools[!n].name = !validName
      !lastCount  = !lastCount + 1
    endif

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameWithNewData
--
-- Description: Names with new data after un-naming existing named spools
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameWithNewData()

  !stdPrefixName  = !this.splPrefix.val

  -- Unname spools
  !oldCe  = !!ce
  do !i indices !this.spools
     if(!this.checkUpdateStatus(!this.spools[!i],'NAME').not()) then
       return
     endif
     !!ce  = !this.spools[!i]
     UNNAME CE
  enddo
  -- navigate back to the old ce
  !!ce  = !oldCe
  handle ANY
  endhandle

  do !n indices !this.spools

    !newName  =   !stdPrefixName & !n.string()

    -- check the names
    !validName  = !this.nameCheck(!newName)
    if(!validName.unset() or !validName.empty()) then
      skip
    else
      !this.spools[!n].name = !validName
    endif

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        renameSpools
--
-- Description:   renames all spools
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .renameSpools()

  !undoRenameAll = object UNDOABLE()
  !undoRenameAll.description('Rename all spools')
  !undoRenameAll.undoAction('!!hvacSpool.undoRedoAction()')
  !undoRenameAll.redoAction('!!hvacSpool.undoRedoAction()')
  !undoRenameAll.add()

  -- Auto name spools if auto name is on
  if(!this.rtAutoName.val) then
    !this.autoNameSpools()

  elseif(!this.splNaming.val eq 1) then
    -- Generate New Data
    !this.nameWithNewData()
  elseif(!this.splNaming.val eq 2) then
    --Use First available data
    !this.nameWithFirstAvailableData()
  endif

  !this.setTask('LISTSPOOLS')

  !undoRenameAll.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      unNameSpools
--
-- Description: un name selected or all spools
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING      scope (SELECTED / ALL) for which un name to be done
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unNameSpools(!scope is STRING)

  !undoUnname = object UNDOABLE()
  !undoUnname.description('Un-name all spools')
  !undoUnname.undoAction('!!hvacSpool.undoRedoAction()')
  !undoUnname.redoAction('!!hvacSpool.undoRedoAction()')
  !undoUnname.add()

  !oldCe  = !!ce

  if(!scope.eq('ALL')) then
    !spools = !this.spools
  elseif(!scope.eq('SELECTED')) then
    !spools  = !this.activeElements
  endif

  do !spool values !spools
    !!ce  = !spool
    if(!this.checkUpdateStatus(!!ce,'NAME').not() ) then
      return
    endif
    UNNAME CE
  enddo

  !this.setTask('LISTSPOOLS')

  !!ce  = !oldCe
  handle ANY
  endhandle

  !undoUnname.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:       listSelection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listSelection(!dummyGadget is GADGET, !action is STRING)

  if(!action.eq('SELECT')) then
    !this.splListMenu.setFieldProperty('rename','visible',true)
    !this.splListMenu.setFieldProperty('unnameSel','visible',true)
    -- update and enhance selected spool elements
    !this.updateActiveElements()

  elseif(!action.eq('UNSELECT')) then
    !this.splListMenu.setFieldProperty('rename','visible',false)
    !this.splListMenu.setFieldProperty('unnameSel','visible',false)

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateActiveElements
--
-- Description: Navigate to the selected spool from list
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateActiveElements()

  -- unenhance the current active elements before updating
  !this.unenhance(!this.activeElements)

  -- clear the graphical text display
  !this.tidyGraphicalFeedback()

  -- initialise the active elements array before updating it
  !this.activeElements  = ARRAY()

  !selectedSpools       = !this.spoolsList.selection().reindex(!this.spoolsList.val.sortedIndices())

  -- set visible status of right-click menu - Rename and Un-name selected spools
  !this.splListMenu.setFieldProperty('rename','visible',!selectedSpools.set())
  !this.splListMenu.setFieldProperty('unnameSel','visible',!selectedSpools.set())

  -- set visible status of 'rename' menu as false if more than one spool is selected
  if(!selectedSpools.size().gt(1)) then
    !this.splListMenu.setFieldProperty('rename','visible',false)
  endif

  do !i indices !selectedSpools

    !spoolDbRef = !selectedSpools[!i].dbref()
    handle ANY
      !spoolDbRef = object DBREF('/' + !selectedSpools[!i])
      handle ANY
        -- Protection against user deletion
        !!alert.error('Spool has been deleted')
        return
      endhandle
    endhandle

    !this.activeElements.append(!spoolDbRef)

  enddo

  -- Enhance the selected spool
  !this.enhance()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: Enhance colour to selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhance()

  do !n indices !this.activeElements
     !mtoList = !this.hvacSpoolManager.getMtoElementsForSpool(!this.activeElements[!n])

     -- Enhance colour
     do !i indices !mtoList
        enhance $!mtoList[$!i] colour $!!gphColOpt.highlight.code
     enddo
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    unenhance
--
-- Description: Un enhances the selected spools
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     ARRAY       elements to be unenhanced
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unenhance(!elements is ARRAY)

  do !n indices !elements
     !mtoList = !this.hvacSpoolManager.getMtoElementsForSpool(!elements[!n])
     -- Unenhance colour
     do !i indices !mtoList
        unenhance $!mtoList[$!i]
     enddo
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteSpools
--
-- Description: Deletes all the spools from the current HVAC
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteSpools()

  -- Confirm deletion
  !result = !!alert.confirm('Are you sure you want to delete all HVAC spools?')

  if(!result eq 'YES') then

     -- Store current element
     !oldCe = !!ce

      -- check update status - LOCK, DBWRITE, CLAIM - for HSLIST
      if(!this.checkUpdateStatus(!this.spools[1].owner,'').not() ) then
        return
      endif

      -- check DAC status to delete HSLIST
      if(!this.spools[1].owner.dacdel.not()) then
        !hvacListName = !this.spools[1].owner.flnm
        !!alert.message('User is not allowed to delete the element $!<hvacListName>')
        return
      endif

      do !spool values !this.spools

        -- check update status - LOCK, DBWRITE, CLAIM - for HSPOOL
        if(!this.checkUpdateStatus(!spool,'').not()) then
          return

        -- check DAC status to delete HSPOOL
        elseif(!spool.dacdel.not()) then
          !!alert.message('User is not allowed to delete the element $!<spool.flnm>')
          return
        endif

      enddo

     !this.unenhance(!this.spools)

     -- Remove spools
     !this.hvacSpoolManager.deleteHvacSpools(!this.hvac)

     !this.spools         = ARRAY()
     !this.activeElements = ARRAY()

     -- --Update Changes in the form
     !this.setTask('GENERATE')

     -- Restore current element
     !!ce = !oldCe
     handle (2,107)(2,822) ANY
        --Current element may be deleted. navigate to the HVAC
        !!ce  = !this.hvac
     endhandle

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateListName
--
-- Description: Validates entered name for HVAC Spool List
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateListName()

  !validName  = !this.nameCheck(!this.listName.val)
  if(!validName.unset() or !validName.empty()) then
    !this.listName.val  = !this.hvac.namn & '-Spools'
    !this.splPrefix.val = !this.hvac.namn & '-Spools/HS'
  else
    !this.listName.val  = !validName.substring(2)
    !this.splPrefix.val = !this.listName.val & '/HS'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateSpoolPrefixName
--
-- Description: Validates entered name for HVAC Spool List
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateSpoolPrefixName()

  !validName  = !this.nameCheck(!this.splPrefix.val)
  if(!validName.unset() or !validName.empty()) then
    if(!this.listName.val.unset() or !this.listName.val.empty()) then
      !this.splPrefix.val = !this.hvac.namn & '-Spools/HS'
    else
      !this.splPrefix.val = !this.listName.val & '/HS'
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameCheck
--
-- Description: Check the correctness of the name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameCheck(!passedName is STRING ) is STRING

    !returnName = STRING()

    -- Check name for any unaccepted characters ($)
    if(!passedName.occurs('$$') gt 0) then
      !!alert.message('$ cannot be used in the name')
      return !returnName

    elseif(!passedName.length() gt 49) then
      !!alert.message('Name cannot have more than 49 characters. Truncating the name.')
      !truncatedName  = !passedName.substring(1,49)
    else
      !truncatedName  = !passedName
    endif

    --Check name for element
    !name                   = !!checkName(!truncatedName, 'NEW')

    --Update gadget with name
    if(!name.set()) then
      !returnName               = !name
    endif

    return !returnName

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      verify
--
-- Description: Verifies the HVAC spools
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for type(HVAC and SPOOL )
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .verify(!type is STRING)

  ---- add undo action for refreshing the form
  --!undoVerify = object UNDOABLE()
  --!undoVerify.description('Verify HVAC spools')
  --!undoVerify.undoAction('!!hvacSpool.setTask(|LISTSPOOLS|)')
  --!undoVerify.redoAction('!!hvacSpool.setTask(|LISTSPOOLS|)')
  --!undoVerify.add()

  -- Initial test
  !listDtext    = !this.spoolsList.dtext
  !listRtext    = !this.spoolsList.rtext

  do !m indices !listDtext
    !elementRef = !listRtext[!m].dbref()
    handle ANY
      !!alert.error('Can not verify corrupt Spool')
      return
    endhandle
  enddo

  -- Set results Tag
  !this.resultTag.val = 'Results Summary'
  !typeSequence = object ARRAY()

  -- Verify
  if(!type eq 'HVAC') then
     !row = ARRAY()
     !results     = !this.hvacSpoolManager.verifyHvacSpools(!this.hvac)
     if(!results.set()) then
        --Set Verification Status
        --All Success
        do !s indices !listRtext
           !row[!s][1] = !this.spoolName[!s]
           !row[!s][2] = 'Successful'
           !row[!s][3] = ''
           if (!this.useApproval) then
             !row[!s][4] = !listRtext[!s].dbref().attribute(':HSVLD').string()
           endif
        enddo
        --Display reason for failure
        do !r indices !results
           !resElement[!r] = !results[!r].split(':')
           !element = !resElement[!r][1].dbref()
           !message = !resElement[!r][2]

           if(!element.type neq 'HSLIST') then
              !index = !element.tyseq
              !typeSequence.append(!index)
              !row[!index][3] = !message.trim()
           else
              !this.resultMessage.val = !message.trim()
           endif
        enddo
        !typeSequence.unique()

        --Failed for those which failed
        do !x indices !typeSequence
           !row[!typeSequence[!x]][2] = 'Failed'
        enddo

     else
        !this.resultMessage.val = 'HVAC Spool List Verified'
        --Set Verification Status
        --All Success
        do !d indices !listRtext
           !row[!d][1] = !this.spoolName[!d]
           !row[!d][2] = 'Successful'
           !row[!d][3] = ''
           if (!this.useApproval) then
             !row[!d][4] = !listRtext[!d].dbref().attribute(':HSVLD').string()
           endif
        enddo
     endif

     --Display result for the list
     !this.setTask('DISPLAYRESULTS')

     -- Modify Result Tag
     !this.resultTag.val = 'Results Summary'

  elseif(!type eq 'SPOOL') then

     !this.updateActiveElements()

     if(!this.activeElements.unset()) then
        !!alert.message('No spool selected for verification.')
        return
     endif

     !result       = object STRING()
     !row = !this.spoolListRows

     do !m indices !listDtext

        !elementRef = !listRtext[!m].dbref()
        handle ANY
          !!alert.error('Can not verify corrupt Spool')
          return
        endhandle
        if(!this.activeElements.findFirst(!elementRef).set()) then
          !result                 = !this.hvacSpoolManager.verifySpool(!elementRef)
          !resultSplit            = !result.split(':')
          !this.resultMessage.val = 'Selected Spools Verified'

          !row[!m][1] = !this.spoolName[!m]
          if (!resultSplit[2].trim().eq('Successful')) then
            !row[!m][2] = 'Successful'
            !row[!m][3] = ''
            if (!this.useApproval) then
              !row[!m][4] = !listRtext[!m].dbref().attribute(':HSVLD').string()
            endif
          else
            !row[!m][2] = 'Failed'
            if(defined (!resultSplit[2]) )then
              !row[!m][3] = !resultSplit[2].trim()
            else
              !row[!m][3] = ''
            endif
            if (!this.useApproval) then
              !row[!m][4] = !listRtext[!m].dbref().attribute(':HSVLD').string()
            endif
          endif

        else

           !row[!m][1] = !this.spoolListRows[!m][1]
           !row[!m][2] = !this.spoolListRows[!m][2]
           !row[!m][3] = !this.spoolListRows[!m][3]
           if (!this.useApproval) then
             !row[!m][4] = !listRtext[!m].dbref().attribute(':HSVLD').string()
           endif
        endif

     enddo

     --Display result in the list
     !this.setTask('DISPLAYRESULTS')

  endif

  -- Set Rows
  if !row.set() then
     !this.spoolsList.setRows(!row)
     !this.spoolListRows = !row
  endif

  -- Set Rtext for List
  !spoolsRtext = !this.spools.evaluate(object BLOCK('!this.spools[!evalIndex].string()'))
  !this.spoolsList.rtext = !spoolsRtext

  --!undoVerify.endUndoable()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      approve
--
-- Description: Approve spool (or not)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--  1   R     DBREF        DBREF of Spool
--  2   R     BOOLEAN     Approve = true or false
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .approve(!spool is DBREF, !approve is BOOLEAN)

  --Set for approval Data
  if (!this.useApproval) then
    !spool.:HSVLD = !approve
    handle ANY
    endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      approve
--
-- Description: Approves (or not) the HVAC spools
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for type(HVAC and SPOOL )
--  2   R     BOOLEAN     Approve = true or false
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .approve(!type is STRING, !approve is BOOLEAN)

  !undo = object UNDOABLE()
  !undo.description('HVAC Spool Approval')
  !undo.undoAction('!!hvacSpool.undoRedoAction()')
  !undo.redoAction('!!hvacSpool.undoRedoAction()')
  !undo.add()

  if(!type eq 'HVAC') then
    !listRtext    = !this.spoolsList.rtext
  elseif(!type eq 'SPOOL') then
    !listRtext    = !this.spoolsList.selection('rtext')
  endif

  do !i indices !listRtext
    !listRtext[!i].dbref().:HSVLD = !approve
  enddo

  !this.verify(!type)

  !undo.endUndoable()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      setAction
--
-- Description: sets action to be taken on the current HVAC
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for action(GENERATE,REGENERATE and DELETE )
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAction(!action is STRING )

   !undoSetAction = object UNDOABLE()
   !undoSetAction.undoAction('!!hvacSpool.undoRedoAction()')
   !undoSetAction.redoAction('!!hvacSpool.undoRedoAction()')
   !undoSetAction.add()

   -- clear the graphical text display
   !this.tidyGraphicalFeedback()

   if(!action.eq('GENERATE'))then
     -- generate and name the spools
     !this.generateSpools('GENERATE')

   elseif(!action.eq('REGENERATE'))then
     -- regenerate and name the spools
     !this.generateSpools('REGENERATE')

   elseif(!action.eq('DELETE'))then
     !this.deleteSpools()
     handle ANY
       !!alert.error('Could not delete all Spools')
     endhandle
   endif

   !undoSetAction.endUndoable()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      modifySpool
--
-- Description: Adds / Removes elements from the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for type(ADD. ADDLAST or REMOVE)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifySpool(!option is STRING)

  -- clear the graphical text display
  !this.tidyGraphicalFeedback()

  !spools = !this.spoolsList.selection().reindex(!this.spoolsList.val.sortedIndices())
  if(!spools.unset()) then
     !!alert.message('Select a spool from the list to modify')
     return
  elseif(!spools.size() gt 1) then
     !!alert.message('Select only one spool to modify')
     return
  endif

  !spoolName  = '/' & !spools[1]
  !spool      = object DBREF(!spoolName)
  handle (2,109)
    !spool   = object DBREF(!spools[1])
    handle ANY
      !!alert.message('Selected spool is not valid')
      return
    endhandle
  elsehandle ANY
    !!alert.message('Selected spool is not valid')
    return
  endhandle

  -- check update status of the selected spool
  if(!this.checkUpdateStatus(!spool.owner,'').not() or !this.checkUpdateStatus(!spool,'').not()) then
    return
  endif

  !mtoElements   = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
  if(!mtoElements.unset()) then
     !!alert.message('Selected spool does not contain any elements.')
     return
  elseif(!option eq 'REMOVE' and !mtoElements.size() eq 1) then
     !!alert.message('Selected spool contains only one element. It cannot be removed.')
     return
  else
    do !x indices !mtoElements
      -- check update status of the selected spool
      if(!this.checkUpdateStatus(!mtoElements[!x],'').not()) then
        return
      endif
    enddo
  endif

  -- edg packet to get the picked element
  !packet                  =  object EDGPACKET()
  !packet.initialisation   =  '!!hvacSpool.updateEnhance()'

  if(!option eq 'ADD') then
     !packet.elementPick('Pick HVAC components to add to the selected spool or <escape> to complete')
     !elementFilter = | (owner of owner eq $!<this.hvac>) and (WDESP[50] neq 'BOP')|
     !packet.pickPacket.picks[1].pick.input[3]   = !elementFilter
     !packet.pickPacket.picks[1].pick.modifiable = false
     !packet.pickPacket.picks[1].action     =  '!!hvacSpool.enhancePick(!this.return[1].item)'
     !packet.escape            =  '!!hvacSpool.addSpool()'

  elseif(!option eq 'ADDLAST') then
     !packet.description      = 'Pick Last Spool Element'
     !packet.elementPick('Pick Last HVAC component to add to the selected spool (all intermediate elements will also be added)')
     !elementFilter = | (owner of owner eq $!<this.hvac>) and (WDESP[50] neq 'BOP')|
     !packet.pickPacket.picks[1].pick.input[3]   = !elementFilter
     !packet.pickPacket.picks[1].pick.modifiable = false
     !packet.pickPacket.picks[1].action     =  '!!hvacSpool.addLastSpool(!this.return[1].item)'
     !packet.remove      = true
     !packet.escape            =  ''

  elseif(!option eq 'REMOVE') then
     !packet.elementPick('Pick HVAC elements to remove from selected spool or <escape> to complete')
     !elementFilter = | (owner of owner eq $!<this.hvac>) and (WDESP[50] neq 'BOP') |
     !packet.pickPacket.picks[1].pick.input[3]   = !elementFilter
     !packet.pickPacket.picks[1].pick.modifiable = false
     !packet.pickPacket.picks[1].action     = '!!hvacSpool.enhancePick(!this.return[1].item)'
     !packet.escape           =  '!!hvacSpool.removeFromSpool()'
  endif

  !!edgCntrl.add(!packet)

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      addSpool
--
-- Description: Add picked elements to the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addSpool()

  !this.addSpool(!!hvacSpool.pickedElements)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.pickedElements = ARRAY()

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      addSpool
--
-- Description: Add picked elements to the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     ARRAY       Picked elements to be added to the selected spool
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addSpool(!pickedElements is ARRAY)

  if(!pickedElements.unset()) then
    !this.updateActiveElements()
    return
  endif

  -- collect the mto elements of the active spool (selected in the list)
  !mtoElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!this.activeElements[1])
  !mtoElementsRef = !mtoElements.evaluate(object BLOCK('!mtoElements[!evalIndex].refNo'))

  -- mark the picked elements
--  do !n indices !pickedElements
--
--    !name         = !pickedElements[!n].flnm
--    --!textPosition = !pickedElements[!n].pos
--    !midPointDist = 0.5 * ( !pickedElements[!n].apos.distance(!pickedElements[!n].lpos) )
--    !textPosition = !pickedElements[!n].apos.offset(!pickedElements[!n].adir.opposite(), !midPointDist)
--
--    -- add aid number
--    !aidNumber  = !!aidNumbers.add('Picked HVAC Element')
--    !this.aidNumbers[!n]  = !aidNumber
--
--    AID text NUMBER $!<aidNumber> '$!<name>' at $!<textPosition>
--
--  enddo

  -- group the spool mto elements and the picked elements in a new array
  !union = !mtoElementsRef.union(!pickedElements)
  -- passed elements derived from picked elements
  !passedElements = !union.difference(!mtoElementsRef)
  do !i indices !passedElements
    -- check update status of the elements
    if(!this.checkUpdateStatus(!passedElements[!i],'').not()) then
      return
    endif

    -- check update status of the spool to which the passed elements belong
    do !spool values  !this.spools
      !spoolElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
      !spoolElementsRef = !spoolElements.evaluate(object BLOCK('!spoolElements[!evalIndex].refNo'))
      if(!spoolElementsRef.findFirst(!passedElements[!i]).set()) then
        if(!this.checkUpdateStatus(!spool,'').not()) then
          return
        endif
      endif

      !this.approve(!spool, false)

    enddo

  enddo

  -- get branches of new spool elements
  !branches       = !union.evaluate(object BLOCK('!union[!evalIndex].owner'))
  !branchesUnique = !branches

  !undoAddSpool = object UNDOABLE()
  !undoAddSpool.description('Add Spools')
  !undoAddSpool.undoAction('!!hvacSpool.undoRedoAction()')
  !undoAddSpool.redoAction('!!hvacSpool.undoRedoAction()')
  !undoAddSpool.add()

  -- if new spool elements are from the same branch then use the old method of adding elements to spool
  if(!branchesUnique.sortUnique().size().eq(1)) then
    !this.addElementsInSameBranch(!mtoElementsRef, !union)
  else
    !this.addToSpoolFromOtherBranch(!branches, !union)
  endif

  !undoAddSpool.endUndoable()

  !this.updateActiveElements()
  handle ANY
  endhandle

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      closeForm
--
-- Description: closes the form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closeForm()

  -- Unenhance everything
  !this.unenhance(!this.spools)

   -- clear the graphical text display
  !this.tidyGraphicalFeedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      splNamingOption
--
-- Description: sets the active status of the spool naming option frame
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splNamingOption(!selection is STRING)

  -- set the text gadget for existing hvac system name active/inactive
  if(!selection eq 'AUTO') then
    !this.splNaming.active  = false
    !this.listName.active   = false
    !this.isAutoName        = true
  elseif(!selection eq 'USER') then
    -- display the user defined naming options
    !this.splNaming.active  = true
    !this.listName.active   = true
    !this.isAutoName        = false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      checkUpdateStatus
--
-- Description: check the update status of the passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if element is updatable, false otherwise
------------------------------------------------------------------------

define method .checkUpdateStatus(!element is DBREF, !attribute is STRING) is BOOLEAN

    !isUpdatable  = true

    -- Protection against user spool deletion
    if (!element.badref()) then
      return !isUpdatable
    endif

    -- check if spool is updatable element
    !isUpdatable  = !!dbrefUpdatable(!element)
    if(!isUpdatable.not()) then
      !!alert.message(!!error.text)
    endif

    if(!attribute.empty().not()) then
      !isNameModifiable     = !element.dacmod.attribute(!attribute)
      if(!isNameModifiable.not()) then
        var !user user
        !!alert.message('User $!user is not allowed to change the attribute $!attribute for element $!<element.flnn>.')
        return !isNameModifiable
      endif
    endif

  return !isUpdatable

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addElementsInSameBranch
--
-- Description: add elements in the same branch to the selected spool
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addElementsInSameBranch(!mtoElementsRef is ARRAY, !newSpoolElements is ARRAY)

  -- store current element to navigate later
  !ref  = !!ce
  var !mode mode
  FORWARDS

  -- get the sequence of the new spool elements
  !elementSeq = !newSpoolElements.evaluate(object BLOCK('!newSpoolElements[!evalIndex].sequence'))

  -- sort the new spool elements array using the elements sequence
  !sortIndex  = !elementSeq.sortedIndices()
  !newSpoolElements.reindex(!sortIndex)

  -- check if elements are in sequence
  do !k from 1 to !newSpoolElements.size() - 1

     if( (!newSpoolElements[!k].seq + 1) eq (!newSpoolElements[!k + 1].seq) ) then
       !elementsInSequence = true
     else
       !elementsInSequence = false
     endif

     if (!elementsInSequence.not()) then
       !!alert.message('Elements are not in sequence')
       !this.clear()
       return
     endif

  enddo

   !!ce  = !newSpoolElements[1]
   DESP N36 false

   do !m from 2 to !newSpoolElements.size()
     !!ce  = !newSpoolElements[!m]
     DESP N36 true
   enddo

   -- check if the last element is branch connector
   if(!newSpoolElements[!m].type.eq('BRCO')) then
    if(!newSpoolElements[!m].cref.set() and !newSpoolElements[!m].cend.eq('HEAD') ) then
      !ref  = !!ce

      !!ce  = !newSpoolElements[!m].cref.members[1]
      handle ANY
       -- if branch has no members
      elsehandle none
        DESP N 36 false
      endhandle

      !!ce  = !ref
    endif
   endif

   next
   handle (2,113)
     if(!newSpoolElements[!m].owner.tref.set()) then
       if(!newSpoolElements[!m].owner.tref.type.eq('BRAN')) then
         !!ce  = !newSpoolElements[!m].owner.tref.members[1]
         handle ANY
           -- if branch has no members
         elsehandle none
           DESP N 36 false
         endhandle
       endif
     endif
   elsehandle NONE
     DESP N 36 false
   endhandle

  !!ce  = !ref
  handle ANY
  endhandle

  -- change back to the previous mode
  $!mode

  -- regenerate the spools
  !this.regenerateSpools()

  -- enhance the spool selected in the list
  !firstElement = !newSpoolElements[1]

  do !spool values !this.spools
    !mtoElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
    !mtoElementsRef = !mtoElements.evaluate(object BLOCK('!mtoElements[!evalIndex].refNo'))

    if(!mtoElementsRef.findFirst(!firstElement).set()) then
      !this.activeElements[1] = !spool
      break
    endif
  enddo

  !this.enhance()

  !this.spoolsList.select('RTEXT', !this.activeElements[1].string())
  !this.splListMenu.setFieldProperty('rename','visible',true)
  !this.splListMenu.setFieldProperty('unnameSel','visible',true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:         removeFromSpool
--
-- Description: Remove picked elements from the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeFromSpool()

  !this.removeFromSpool(!!hvacSpool.pickedElements)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.pickedElements = ARRAY()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:         removeFromSpool
--
-- Description: Remove picked elements from the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     ARRAY       Picked elements to be removed from selected spool
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeFromSpool(!pickedElements is ARRAY)

  if(!pickedElements.unset()) then
    !this.updateActiveElements()
    return
  endif

  -- store current element to navigate later and current mode to restore later
  !ref  = !!ce
  var !mode mode
  -- change to forwards mode
  FORWARDS

  -- collect the mto elements of the active spool (selected in the list)
  !mtoElementsRef   = !this.hvacSpoolManager.getMtoElementsForSpool(!this.activeElements[1])
  !mtoElements      = !mtoElementsRef.evaluate(object BLOCK('!mtoElementsRef[!evalIndex].refNo'))

  -- mark the picked elements
--  do !n indices !pickedElements
--
--    !name         = !pickedElements[!n].flnm
--    --!textPosition = !pickedElements[!n].pos
--    !midPointDist = 0.5 * ( !pickedElements[!n].apos.distance(!pickedElements[!n].lpos) )
--    !textPosition = !pickedElements[!n].apos.offset(!pickedElements[!n].adir.opposite(), !midPointDist)
--
--    -- add aid number
--    !aidNumber  = !!aidNumbers.add('Picked HVAC Element')
--    !this.aidNumbers[!n]  = !aidNumber
--
--    AID text NUMBER $!<aidNumber> '$!<name>' at $!<textPosition>
--
--  enddo

  -- group the spool mto elements and the picked elements in a new array
  !elementsToRemove = !mtoElements.intersect(!pickedElements)
  if(!elementsToRemove.unset() ) then
     !!alert.message('Select elements present in the spool to remove')
     return
  elseif(!mtoElements.size() eq 1) then
    -- this is a redundant check
    !!alert.message('Only one element is added to the selected spool. Cannot remove it.')
    return
  endif

  do !x indices !elementsToRemove
    -- check update status of the elements
    if(!this.checkUpdateStatus(!elementsToRemove[!x],'').not()) then
      return
    endif
  enddo

  -- get the first and last element in the spool mto elements list
  --!firstMtoElement   = !mtoElements.first()
  !lastMtoElement    = !mtoElements.last()

  !undoRemoveElem = object UNDOABLE()
  !undoRemoveElem.description('Remove Elements')
  !undoRemoveElem.undoAction('!!hvacSpool.undoRedoAction()')
  !undoRemoveElem.redoAction('!!hvacSpool.undoRedoAction()')
  !undoRemoveElem.add()

  do !i indices !elementsToRemove

    if(!elementsToRemove[!i] eq !lastMtoElement) then
       !!ce  = !lastMtoElement
       DESP N 36 false

    else
       !!ce  = !elementsToRemove[!i]
       DESP N 36 false

       -- check if the element is branch connector
       if(!elementsToRemove[!i].type.eq('BRCO')) then
        if(!elementsToRemove[!i].cref.set() and !elementsToRemove[!i].cend.eq('HEAD') ) then
          !ref  = !!ce

          !!ce  = !elementsToRemove[!i].cref.members[1]
          handle ANY
           -- if branch has no members
          elsehandle none
            DESP N 36 false
          endhandle

          !ref  = !!ce
        endif
       endif

       next
       handle (2,113)
         -- no element to navigate
         if(!elementsToRemove[!i].owner.tref.set()) then
           if(!elementsToRemove[!i].owner.tref.type.eq('BRAN')) then
             !!ce  = !elementsToRemove[!i].owner.tref.members[1]
             handle ANY
              -- if branch has no members
             elsehandle none
               DESP N 36 false
             endhandle
           endif
         endif
       elsehandle none
         DESP N 36 false
       endhandle
    endif

  enddo

  -- restore the stored CE and mode
  !!ce  = !ref
  handle ANY
  endhandle

  -- change back to the previous mode
  $!mode

  !selectedSpool  = !this.activeElements[1]

  -- regenerate the spools
  !this.regenerateSpools()
  if (!this.renameRemovedElements.val) then
    !this.renameSpools()
  endif

  !undoRemoveElem.endUndoable()

  !this.activeElements[1]  = !selectedSpool
  !this.spoolsList.select('RTEXT', !selectedSpool.string())

  !this.enhance()

  !this.splListMenu.setFieldProperty('rename','visible',true)
  !this.splListMenu.setFieldProperty('unnameSel','visible',true)

  !this.updateActiveElements()
  handle ANY
  endhandle

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      addToSpoolFromOtherBranch
--
-- Description: Add picked elements to the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     ARRAY       Picked elements to be added to the selected spool
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToSpoolFromOtherBranch(!branches is ARRAY, !union is ARRAY)

  !branchesUnique = !branches
  -- get the unique values for branches
  !branchesUnique.unique()

  -- sort the elements with sequence within branches
  do !n indices !branchesUnique

    -- array storing the branch seq and elements in that branch
    !newArray[!n] = ARRAY()
    !indices      = !branches.find(!branchesUnique[!n])
    do !indx values !indices
      !newArray[!n].append(!union[!indx])
    enddo

    !elements       = !newArray[!n]
    !elementsSeq    = !elements.evaluate(object BLOCK('!elements[!evalIndex].seq'))
    !sortedIndices  = !elementsSeq.sortedIndices()
    !elements.reindex(!sortedIndices)
    !newArray[!n]   = !elements

  enddo

  -- check if branches are connected
  do !i indices !branchesUnique

    !reference[!i]      = object DBREF()
    !branchesConnected  = false

    if( !branches.findFirst(!branchesUnique[!i].href).set() ) then
      !reference[!i]      = !branchesUnique[!i].href
      !referenceType[!i]  = 'HEADTOBRANCH'
      !branchesConnected  = true

    elseif( !branchesUnique[!i].href.set() and !branches.findFirst(!branchesUnique[!i].href.owner).set() ) then
      !reference[!i]      = !branchesUnique[!i].href.owner
      !referenceType[!i]  = 'HEADTOBRCON'
      !branchesConnected  = true

    elseif( !branches.findFirst(!branchesUnique[!i].tref).set() ) then
      !reference[!i]      = !branchesUnique[!i].tref
      !referenceType[!i]  = 'TAILTOBRANCH'
      !branchesConnected  = true

    elseif( !branchesUnique[!i].tref.set() and !branches.findFirst(!branchesUnique[!i].tref.owner).set() ) then
      -- ### NOT A VALID CASE
      !reference[!i]      = !branchesUnique[!i].tref.owner
      !referenceType[!i]  = 'TAILTOBRCON'
      !branchesConnected  = true

    else
      !connRef = !newArray[!i].evaluate(object BLOCK('!newArray[!i][!evalIndex].cref'))
      if( !branches.intersect(!connRef).set() ) then
        !reference[!i]      = !branches.intersect(!connRef)[1]
        !referenceType[!i]  = 'CREF'
        !branchesConnected  = true
      else
        !reference[!i]      = object DBREF()
        !referenceType[!i]  = ''
        !branchesConnected  = false
      endif

    endif

    if(!branchesConnected.not()) then
      !!alert.message('Picked elements to be added to the spool are not in the network.')
      !this.clear()
      return
    endif

  enddo

  -- validate the elements sequence in the branches
  do !j indices !newArray
    !elements = !newArray[!j]
    do !k from 1 to !elements.size() - 1
      if( (!elements[!k].seq + 1) eq (!elements[!k + 1].seq) ) then
        !elementsInSequence = true
      else
        !elementsInSequence = false
        --if(type of next of !elements[!k] eq 'BRCO' ) then
        --  !elementsInSequence = true
        --else
        --  !elementsInSequence = false
        --endif
      endif

      if(!elementsInSequence.not()) then
        !!alert.message('Elements are not in sequence')
        !this.clear()
        return
      endif
    enddo
  enddo

  -- temporary array to store and arrange branches
  !tempBranches   = !branchesUnique
  -- array to store the sorted branch
  !newBranchList  = ARRAY()
  -- find and store the first branch
  do !indx indices !tempBranches
    if(!tempBranches[!indx].href.unset()                                   or    $
       !tempBranches.findFirst(!tempBranches[!indx].href).unset()          or    $
       !branchesUnique.findFirst(!tempBranches[!indx].href.owner).unset() )  then
       !removedBranch     = !tempBranches.remove(!indx)
       !newBranchList[1]  = !removedBranch
       break
    endif
  enddo

  !tempBranches.compress()

-- store other branches
  do !p indices !tempBranches

    -- If the HREF is skip
    if (!tempBranches[!p].href.unset()) then
      skip
    endif

    if(!newBranchList.findFirst(!tempBranches[!p].href.owner).set() or !newBranchList.findFirst(!tempBranches[!p].href).set()) then
       !newBranchList.append(!tempBranches[!p])
       skip
    endif

  enddo

  -- validate (again) the elements sequence in the branches
  do !s indices !newBranchList

    !y = !branchesUnique.findFirst(!newBranchList[!s])

    if( !referenceType[!y].eq('HEADTOBRANCH') ) then
      if( !newArray[!y].first().seq neq 1 ) then
        !!alert.message('Picked and selected Spool Elements are not in sequence. Cannot create spool.')
        !this.clear()
        return
      endif

    elseif( !referenceType[!y].eq('HEADTOBRCON') ) then
      if( !newArray[!y].first().seq neq 1 or !union.findFirst(!newBranchList[!s].href).unset() ) then
        !!alert.message('Picked and selected Spool Elements are not in sequence. Cannot create spool.')
        !this.clear()
        return
      endif

    elseif( !referenceType[!y].eq('TAILTOBRANCH')  ) then
      if( !newArray[!y].last().seq neq !branchesUnique[!y].members.size() ) then
        !!alert.message('Picked and selected Spool Elements are not in sequence. Cannot create spool.')
        !this.clear()
        return
      endif

    -- TODO ** THIS CHECK SHOULD BE REMOVED
    elseif( !referenceType[!y].eq('TAILTOBRCON') ) then
      if( !newArray[!y].last().seq neq !branchesUnique[!y].members.size() or $
          !union.findFirst(!newBranchList[!s].tref).unset() )             then

        !!alert.message('Picked and selected Spool Elements are not in sequence. Cannot create spool.')
        !this.clear()
        return
      endif

    endif

  enddo

  !newElementsList  = ARRAY()
  do !a indices !newArray
    do !b indices !newArray[!a]
      !newElementsList.append(!newArray[!a][!b])
    enddo
  enddo

  -- store the old ce for setting it again
  !oldCe  = !!ce

  -- set the desp values for the elements. first element should be set as false
  !!ce  = !newElementsList[1]
  DESP N 36 false

  do !index from 2 to !newElementsList.size()
    !!ce  = !newElementsList[!index]
    DESP N 36 true
  enddo

   next
   handle ANY

     if(!newElementsList[!index].owner.tref.set()) then
       if(!newElementsList[!index].owner.tref.type.eq('BRAN')) then
         !!ce  = !newElementsList[!index].owner.tref.members[1]
         handle ANY
           -- if branch has no members
         elsehandle none
           -- Only unset the %WKSF property if the href points back to the tref
           if (!!ce.owner.href eq !newElementsList[!index].owner) then
             DESP N 36 false
           endif
         endhandle
       endif
     endif
   elsehandle none
     DESP N 36 false
   endhandle

  !!ce  = !oldCe
  handle ANY
    -- in case if it has been deleted
  endhandle

  -- regenerate the spools
  !this.regenerateSpools()

  -- enhance the spool selected in the list
  !firstElement = !newElementsList[1]

  do !spool values !this.spools
    !mtoElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
    !mtoElementsRef = !mtoElements.evaluate(object BLOCK('!mtoElements[!evalIndex].refNo'))

    if(!mtoElementsRef.findFirst(!firstElement).set()) then
      !this.activeElements[1] = !spool
      break
    endif
  enddo

  !this.enhance()

  !this.spoolsList.select('RTEXT', !this.activeElements[1].string())
  !this.splListMenu.setFieldProperty('rename','visible',true)
  !this.splListMenu.setFieldProperty('unnameSel','visible',true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        tidyGraphicalAids
--
-- Description:   tidy the graphical feedback for picked elements
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyGraphicalFeedback()

 do !aidNumber values !this.aidNumbers
   !!aidNumbers.remove(!aidNumber)
 enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      undoRedoAction
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undoRedoAction()

  -- collect spools
  !spoolColl = object COLLECTION()
  !spoolColl.scope(!this.hvac)
  !spoolColl.type('HSPOOL')
  !this.spools = !spoolColl.results()

  -- set task to list spools
  !this.setTask('LISTSPOOLS')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      enhanceSpool
--
-- Description: Enhance selected Spool Element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhancePick(!data is DBREF)

  if (!!hvacSpool.pickedElements.size().gt(0)) then
    do !i indices !this.pickedElements
      if (!this.pickedElements[!i].string() eq !data.string()) then
        !this.pickedElements.remove(!i)
        !this.enhanceSpool.removeItem(!data)
        -- If the element is in the spool mto originally maintain highlight colour
        do !n indices !this.activeElements
          !mtoList = !this.hvacSpoolManager.getMtoElementsForSpool(!this.activeElements[!n])
          do !j indices !mtoList
            if (!mtoList[!j].string() eq !data.string()) then
              enhance $!data colour $!!gphColOpt.highlight.code
            endif
          enddo
        enddo
        return
      endif
    enddo
  endif

  -- Colour 11 is Pink
  !this.enhanceSpool.setColour(11)
  !this.enhanceSpool.addItem(!data)
  !!hvacSpool.pickedElements.append(!data)

endmethod
------------------------------------------------------------------------
--
-- Method:      UnenhanceSpool
--
-- Description: Unenhance selected Spool Element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unenhancePick(!data is DBREF)

  !this.enhanceSpool.removeItem(!data)
  !!hvacSpool.pickedElements.append(!data)

endmethod
------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: On error of creating spools, unenhance elements and clear the aids
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.enhanceSpool.clear()

  do !n values !this.aidNumbers
    AID CLEAR TEXT $!n
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      updateEnhance
--
-- Description: Update the enhanced spool
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateEnhance()

  !!hvacSpool.pickedElements  =  ARRAY()
  !this.enhanceSpool.clear()
  !this.enhance()

endmethod
------------------------------------------------------------------------
--
-- Method:      AddLastSpool
--
-- Description: Add all elements from the initial first to the passed last (if they are in the same branch)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Last element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addLastSpool(!data is DBREF)

  !owner    = !data.owner
  !sequence = !data.sequence

  -- Checks
  !selectedSpools = !this.spoolsList.selection().reindex(!this.spoolsList.val.sortedIndices())
  if(!selectedSpools.size() gt 1) then
    !!alert.message('Select a single Spool')
    !!edgCntrl.escape()
    return
  elseif(!this.spoolsList.val.unset()) then
    !!alert.message('Select a Spool from the list')
    !!edgCntrl.escape()
    return
  endif

  !spool  = object DBREF(!selectedSpools[1])
  handle (2,813)
    !spool  = object DBREF('/' & !selectedSpools[1])
  elsehandle ANY
    !!edgCntrl.escape()
    return
  endhandle

  -- Get this spool information
  !spoolElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
  !spoolElementsRef = !spoolElements.evaluate(object BLOCK('!spoolElements[!evalIndex].refNo'))

  -- The above are current elements of spool. Use the first.
  !firstElement = !spoolElementsRef[1]
  !firstOwner = !firstElement.owner
  !firstSequence = !firstElement.sequence
  if (!owner.string() neq !firstOwner.string()) then
    !!alert.message('To use this facility; Picked Element must be in the same branch as the First Element of the Spool')
    !!edgCntrl.escape()
    return
  endif
  if (!sequence le !firstSequence) then
    !!alert.message('To use this facility; Picked Element must follow the First Element of the Spool')
    !!edgCntrl.escape()
    return
  endif

  -- Add all elements from first in spool to picked last
  !elementsToAdd = ARRAY()
  do !i from !firstSequence to !sequence
    skip if (!i.eq(!firstSequence) or !i.eq(!sequence))
    !elementsToAdd.append(!owner.members[!i])
  enddo
  !elementsToAdd.append(!data)

  -- Add element to Spool
  !this.addSpool(!elementsToAdd)

  -- Remove the EDG packet
  !!edgCntrl.escape()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      AddSelected
--
-- Description: Add all elements from the initial first to the last selected in the list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSelected()

  -- Initial test
  !listDtext    = !this.spoolsList.dtext
  !listRtext    = !this.spoolsList.rtext

  do !m indices !listDtext
    !elementRef = !listRtext[!m].dbref()
    handle ANY
      !!alert.error('Can not modify corrupt Spool')
      return
    endhandle
  enddo

  -- Checks
  !selectedSpools = !this.spoolsList.selection().reindex(!this.spoolsList.val.sortedIndices())
  if(!this.spoolsList.val.unset() or !selectedSpools.size() lt 2) then
    !!alert.message('Select multiple Spools to combine')
    return
  endif
  !selectedSpoolindices = !this.spoolsList.val
  !sortedSpoolindices = !selectedSpoolindices.sort()

  -- Go through the sorted values and they must be in sequence
  !first = !sortedSpoolindices[1]
  !numberOff = !sortedSpoolindices.size()
  !last = !sortedSpoolindices[!numberOff]
  if ((!last - !first) gt (!numberOff - 1)) then
    -- not a basic sequence like 5, 6, 7
    !!alert.message('The selected Spools must be in sequence')
    return
  endif

  -- Go to each element of every spool and add to array (except first element of first spool)
  !elementsToAdd = ARRAY()
  do !i from !first to !last
    -- skip the first
    skip if (!i eq !first)

    !spool  = object DBREF(!this.spoolsList.rtext[!i])
    -- Get this spool information
    !spoolElements    = !this.hvacSpoolManager.getMtoElementsForSpool(!spool)
    !elementsToAdd.appendArray(!spoolElements)
  enddo

  -- Add element to Spool
  !this.addSpool(!elementsToAdd)

return


endmethod
------------------------------------------------------------------------
