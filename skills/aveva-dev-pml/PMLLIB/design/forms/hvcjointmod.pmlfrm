--
--
--  Description:     -- Form for tracing floors or screeds with walls--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the form
--  doIt()                           -                   Apply the form
--  init()                           -                   Initialise Form
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            hvcJointMod.pmlfrm
--   Type:          Form Definition
--   Group:         Joints
--     Keyword:     HVAC
--   Module:        design
--
-- Author:          S.Bentley
--
-- Description:
-- Form for tracing floors or screeds with walls
--
------------------------------------------------------------------------
--
  VAR !!CDCRRENTFNAM |HVCJOINTMOD|

  setup form _HVCJOINTMOD at XR 0  YR 0.16
    title    |Modify Joints (User Defined Components)|
    init     |!this.init()|

    para _ARRJPRT        at x 0  y0 TEXT |Arrive Joint|
    text _ARRJINP        at x 18 y0  width 14 string

    para _LEAJPRT        at x 0  y1 TEXT |Leave Joint|
    text _LEAJINP        at x 18 y1  width 14 string

    button _CHOOSEJNT   at x 9 y 1 |Choose| call |!!runMacro('%PDMSUI%/DES/HVACADV/FNCHOOJT', '')|

    para _BRJNTPRT       at x 0  y2 TEXT |Branch Joint|
    text _BRJNTINP       at x 18 y2 width 14 string

    button _APPLY   at  x 2  y 3      |   OK     | call |!this.doIt()|ok
    button _DISMISS at  x 20 y 3      |  Cancel  | cancel

    member .element is DBREF

  exit
-- End of form definition for !!hvcJointMod
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:  Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Unset element member
  !this.element = !!ce

  if (type neq 'WORL' and (type of owner eq 'BRAN' and type of owner of owner eq 'HVAC')) then
    -- ok
  else
    !!alert.error('This form can only be used for HVAC components')
    return
  endif

  -- Arrive Joints
  var !testa (WDESP[58])
  var !testb (DESP[68])
  if (!testa eq 'unset') then
    var _ARRJINP    |RE|
  else
    if (!testb eq '0') then
      var _ARRJINP    |$!testa|
    else
      var _ARRJINP    |$!testa$n$!testb|
    endif
  endif

  -- Leave Joints
  var !testa (WDESP[59])
  var !testb (DESP[69])
  if (!testa eq 'unset') then
    var _LEAJINP    |RE|
  else
    if (!testb eq '0') then
      var _LEAJINP    |$!testa|
    else
      var _LEAJINP    |$!testa$n$!testb|
    endif
  endif

  -- Branch Joints
  var !testa (WDESP[60])
  var !testb (DESP[70])
  if (!testa eq 'unset') then
    var _BRJNTINP    |RE|
  else
    if (!testb eq '0') then
      var _BRJNTINP    |$!testa|
    else
      var _BRJNTINP    |$!testa$n$!testb|
    endif
  endif

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      doIt
--
-- Description: Apply the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .doIt()

  -- Call the apply method and handle any errors
  !this.apply()
  handle ANY
    !!alert.error('An error has been caused by one of the Joint Values')
    return
  endhandle

endmethod
-- End of method definition for .doIt()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  if (type neq 'WORL' and (type of owner eq 'BRAN' and type of owner of owner eq 'HVAC')) then
    -- ok
  else
    !!alert.error('This form can only be used for HVAC components')
    return
  endif

   var !!XSECAAINP    DESP[2]
   var !!XSECABINP    DESP[3]
   var !!XSECLAINP    DESP[4]
   var !!XSECLBINP    DESP[5]
   var !!XSECSAINP    DESP[41]
   var !!XSECSBINP    DESP[42]
   var !!ARRJINP      |$_HVCJOINTMOD_ARRJINP|
   var !!LEAJINP      |$_HVCJOINTMOD_LEAJINP|
   var !!BRJNTINP     |$_HVCJOINTMOD_BRJNTINP|

  !!runMacro('%PDMSUI%/DES/HVACADV/MRARRJTS', '')
  !!runMacro('%PDMSUI%/DES/HVACADV/MRLEAJTS', '')
  !!runMacro('%PDMSUI%/DES/HVACADV/MRBRJNTS', '')

  DESP N58 $!!ARRJINP
  DESP N68 $!!AVALINP
  DESP N21 $!!AJAINP
  DESP N22 $!!AJBINP
  DESP N23 $!!AJCINP

  DESP N59 $!!LEAJINP
  DESP N69 $!!LVALINP
  DESP N24 $!!LJAINP
  DESP N25 $!!LJBINP
  DESP N26 $!!LJCINP

  if (type inset('BRCO','THRE','TEE')) then
    DESP N60 $!!BRJNTINP
    DESP N70 $!!BVALINP
    DESP N27 $!!BJAINP
    DESP N28 $!!BJBINP
    DESP N29 $!!BJCINP
  endif

  -- Store element name so we know the settings referred to this
  !this.element = !!ce

endmethod
-- End of method definition for .apply()
