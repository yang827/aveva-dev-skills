setup form !!isdPreviewMessages at xr 0 yr 0

  !this.formTitle     = 'Preview Isometric Messages'
  !this.iconTitle     = 'IsoMess'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.1 $ '

  -- Body of form definition

  list .message at x0.3 y0.3 width 50 height 20

  -- currently displayed message file
  member .messageFile        is STRING

exit
-- End of form definition for !!isdPreviewMessages
