------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dismiss()                        -
--  highlight()                      -                   Highlighting Head and tail
--  initialise()                     -                   Initialisation method
--  listingequi()                    -
--  selectEqui()                     -                   Callback after selecting the Equipment in the list
--  selectEquip()                    -
--
----------------------------------------------------------------------------
setup form !!listingequi resizeable

   option  .listoptionequi anchor l+t  callback '!this.selectEquip()'  width 16
   text    .equiattrib    ' Rule'   anchor l+r+t  at xmax+1 ymin   callback '!this.selectEquip()' width 16 is STRING
   list    .listingEquip   anchor l+r+t+b  at x1  ymax+0.2  callback '!this.highlight()' single columns width 41 height 6
   button  .elconnSelectionApply   'Apply'   anchor l+b  at xmin.listingEquip ymax+0.2 callback '!this.selectEqui()'
   button  .elconnSelectDismiss    'Dismiss' anchor r+b  at xmax+27 ymin callback '!this.dismiss()'

   -- form Members
   member .mode        is STRING
   member .startRef    is DBREF
   member .endRef      is DBREF

exit

------------------------------------------------------------------------
--
-- Method:   listingequi
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listingequi()

   !this.equiattrib.visible = FALSE
   !this.formtitle = 'List of Equipments'
   !this.callback  = '!this.initialise()'
   !this.listingEquip.clear()
   !equioption[1]                      = 'Zone'
   !equioption[2]                      = 'Rule for Collection'
   !this.listoptionequi.dtext          = !equioption
   !this.listoptionequi.val = 1
    !headings = object ARRAY()
   !headings.append('List Equipment for Selection')
   !this.listingEquip.setHeadings(!headings)

endmethod

------------------------------------------------------------------------
--
-- Method:   initialise
--
-- Description: Initialisation method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

   !startRef = !!cblCable.cableStartRefData.val.trim()
   if(!startRef.substring(1,1) neq '/')then
     !startRef = '/' & !!cblCable.cableStartRefData.val.trim()
   endif
   !endRef = !!cblCable.cableEndRefData.val.trim()
   if(!endRef.substring(1,1) neq '/')then
     !endRef = '/' & !!cblCable.cableEndRefData.val.trim()
   endif
   !this.startRef  = !startRef.dbref()
   handle ANY
     !this.startRef = object DBREF()
   endhandle
   !this.endRef   = !endRef.dbref()
   handle ANY
     !this.endRef   = object DBREF()
   endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:   selectEquip
--
-- Description: Callback of option to list the equipments
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectEquip()

 if(!this.listoptionequi.val.eq(1))then
   !this.equiattrib.visible = false
   !this.listingEquip.clear()
   !equip = object ARRAY()
   !equicol = object COLLECTION()
   !equicol.type('EQUI')
   if(!!ce.type.eq('ZONE'))then
    !equicol.scope(!!ce)
   else
    !!alert.message('Be at a Zone to collect the Equipments')
    return
   endif
   !colResult = !equicol.results()
   if(!colResult.size().eq(0))then
    !!alert.message('No Equipment under Zone')
    return
   endif
   do !j values !colResult
    !equip.append(!j.flnn)
   enddo
   !this.listingEquip.dtext = !equip

 elseif(!this.listoptionequi.val.eq(2))then

   !this.equiattrib.visible = true
   !this.listingEquip.clear()
   if(!this.equiattrib.val.neq(''))then

    !equip = object ARRAY()
    var !coll collect all equi with ( $!this.equiattrib.val )
    handle ANY
      !!alert.error('Enter any valid expression for this field.')
      return
    endhandle

    do !j from 1 to !coll.size()
      !equip.append(!coll[!j].dbref().flnn)
    enddo
    !this.listingEquip.dtext = !equip
   endif
 endif
endmethod

------------------------------------------------------------------------
--
-- Method:   highlight
--
-- Description: Highlighting Head and tail
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight()

  unenhance all

  if(!this.mode.eq('HEAD'))then
    aid clear text $!!cblCable.startAidNum
    handle ANY
    endhandle
   !!cblCable.startAidNum = !!aidNumbers.add('CableStart')

    do !i from 1 to !this.listingEquip.rtext.size()
      !routePointStart  = object DBREF(!this.listingEquip.rtext[!this.listingEquip.val])
      handle ANY
        !routePointStart  = object DBREF('/' + !this.listingEquip.rtext[!this.listingEquip.val])
      endhandle
    enddo
    if(!this.listingEquip.rtext.unset())then
      !!alert.message('Please define a rule for collection of equipment')
      return
    endif
    enhance all for $!routePointStart colour green
    handle ANY
    endhandle
    if(!routePointStart.set())then
      !pos = !routePointStart.position.wrt( /* )
      aid text num $!!cblCable.startAidNum '<Start>' at $!pos
    endif

  elseif(!this.mode.eq('TAIL'))then

    aid clear text $!!cblCable.endAidNum
    handle ANY
    endhandle
    !!cblCable.endAidNum = !!aidNumbers.add('CableEnd')

    do !i from 1 to !this.listingEquip.rtext.size()
      !routePointEnd  = object DBREF(!this.listingEquip.rtext[!this.listingEquip.val])
      handle ANY
        !routePointEnd  = object DBREF('/' + !this.listingEquip.rtext[!this.listingEquip.val])
      endhandle
    enddo
    if(!this.listingEquip.rtext.unset())then
      !!alert.message('Please define a rule for collection of equipment')
      return
    endif
    enhance all for $!routePointEnd colour green
    handle ANY
    endhandle
    if(!routePointEnd.set())then
      !pos = !routePointEnd.position.wrt( /* )
      aid text num $!!cblCable.endAidNum '<End>' at $!pos
    endif
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:   selectEqui()
--
-- Description: Callback after selecting the Equipment in the list
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectEqui()

  if(!this.listingEquip.rtext.empty())then
    !!alert.warning('No Equipment is selected.')
    return
  endif
  if(!this.mode.eq('HEAD'))then

    do !i from 1 to !this.listingEquip.rtext.size()
      !routePointStart  = object DBREF(!this.listingEquip.rtext[!this.listingEquip.val])
      handle ANY
        !routePointStart  = object DBREF('/' + !this.listingEquip.rtext[!this.listingEquip.val])
      endhandle
    enddo
    !this.startRef = !routePointStart
   if (!this.startRef.type.eq('EQUI'))then
    	 !col = object COLLECTION()
       !col.type('ELCONN')
       !col.scope(!this.startRef)
       !colResult = !col.results()
       if(!colResult.unset())then
       	if(!!cblCable.shown())then
      !!cblCable.cableStartRefData.val = !routePointStart.flnn
      !!cblCable.cableStartRefDesc.val = !routePointStart.desc
   endif
   elseif(!colResult.size().eq(1))then
        !!alert.message('Cable will connect to the only elconn under the Equipment')
        !routePointStart = !colResult[1]
   if(!!cblCable.shown())then
      !!cblCable.cableStartRefData.val = !colResult[1].flnn
      !!cblCable.cableStartRefDesc.val = !colResult[1].desc
     --  return
   endif
   elseif(!colResult.size().gt(1))then
         !elconn = object ARRAY()
         show !!liststartelconn
         do !j from 1 to !colResult.size()
          !elconn.append(!colResult[!j].flnn)
         enddo
         !!liststartelconn.listElconn.dtext = !elconn
         !!liststartelconn.elconnStartSelectApply.visible = TRUE
         !!liststartelconn.elconnEndSelectApply.visible = FALSE
         return
   endif
  endif
    if(!this.listingEquip.rtext.unset())then
      !!alert.message('Please define a rule for collection of equipment')
      return
    endif
    if !!cblCable.validateSelectedReference(!routePointStart).not() then
    	 !this.startRef  = object DBREF()
    	 aid clear text $!!cblCable.startAidNum
  		 handle ANY
  		 endhandle
    	 return
    endif
    aid clear text $!!cblCable.startAidNum
    handle ANY
    endhandle
    if(!routePointStart.set())then
      !pos = !routePointStart.position.wrt( /* )
      aid text num $!!cblCable.startAidNum '<Start>' at $!pos
    endif

  elseif(!this.mode.eq('TAIL'))then

    do !i from 1 to !this.listingEquip.rtext.size()
      !routePointEnd  = object DBREF(!this.listingEquip.rtext[!this.listingEquip.val])
      handle ANY
        !routePointEnd  = object DBREF('/' + !this.listingEquip.rtext[!this.listingEquip.val])
      endhandle
    enddo
    !this.endRef   = !routePointEnd
    if (!this.endRef.type.eq('EQUI'))then
    	 !col = object COLLECTION()
       !col.type('ELCONN')
       !col.scope(!this.endRef)
       !colResult = !col.results()
       if(!colResult.unset())then
       	if(!!cblCable.shown())then
       !!cblCable.cableEndRefData.val = !routePointEnd.flnn
       !!cblCable.cableEndRefDesc.val = !routePointEnd.desc
   endif
   elseif(!colResult.size().eq(1))then
        !!alert.message('Cable will connect to the only elconn under the Equipment')
        !routePointEnd = !colResult[1]
   if(!!cblCable.shown())then
      !!cblCable.cableEndRefData.val = !colResult[1].flnn
      !!cblCable.cableEndRefDesc.val = !colResult[1].desc

   endif
   elseif(!colResult.size().gt(1))then
         !elconn = object ARRAY()
         show !!liststartelconn
         do !j from 1 to !colResult.size()
          !elconn.append(!colResult[!j].flnn)
         enddo
         !!liststartelconn.listElconn.dtext = !elconn
         !!liststartelconn.elconnStartSelectApply.visible = FALSE
         !!liststartelconn.elconnEndSelectApply.visible = TRUE
         return
        endif

   endif
    if(!this.listingEquip.rtext.unset())then
      !!alert.message('Please define a rule for collection of equipment')
      return
    endif
    if !!cblCable.validateSelectedReference(!routePointEnd).not() then
    	!this.endRef  = object DBREF()
  		aid clear text $!!cblCable.endAidNum
  		handle ANY
  		endhandle
      return
    endif
    aid clear text $!!cblCable.endAidNum
    handle ANY
    endhandle

    if(!routePointEnd.set())then
      !pos = !routePointEnd.position.wrt( /* )
      aid text num $!!cblCable.endAidNum '<End>' at $!pos
    endif

  endif
  !this.dismiss()

endmethod

------------------------------------------------------------------------
--
-- Method:   dismiss
--
-- Description: Dismiss the form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()


  aid clear text $!!cblCable.startAidNum
  handle ANY
  endhandle

  aid clear text $!!cblCable.endAidNum
  handle ANY
  endhandle

  if(!this.startRef.set())then
    !pos = !this.startRef.position
     aid text num $!!cblCable.startAidNum '<Start>' at $!pos
  endif

  if(!this.endRef.set())then
    !pos = !this.endRef.position
     aid text num $!!cblCable.endAidNum '<End>' at $!pos
  endif

 !this.hide()
endmethod
