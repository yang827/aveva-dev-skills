--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  liststartelconn()                -
--  selectElconn(STRING)             -
--
setup form !!liststartelconn
   list    .listElconn    anchor l+t  at x1  ymax+1  callback '' single columns  width 40 height 8
   !headings = object ARRAY()
   !headings.append('Select Elconn')
   !this.listElconn.setHeadings(!headings)

   button  .elconnStartSelectApply linklabel  'Apply'  anchor l+t  at xmin+0.1 ymax callback '!this.selectElconn(|HEAD|)'
   button  .elconnEndSelectApply   linklabel  'Apply'  anchor l+t  at xmin+0.1 ymin callback '!this.selectElconn(|TAIL|)'
   button  .elconnSelectDismiss    linklabel  'Dismiss' anchor l+t  at xmax form-6 ymin callback '!this.hide()'
exit

define method .liststartelconn()
 !this.formtitle = 'List of Elconns'
endmethod

define method .selectElconn(!mode is STRING)
  if(!mode.eq('HEAD'))then
  	do !i from 1 to !this.listElconn.rtext.size()
  	  !routePointStart  = !this.listElconn.rtext[!this.listElconn.val].dbref()
      handle ANY
        !routePointStart  = object DBREF('/' + !this.listElconn.rtext[!this.listElconn.val])
      endhandle
    enddo
    if !!cblcable.validateSelectedReference(!routePointStart).not() then
    	return
    endif
    !!cblcable.cableStartRefData.val = !routePointStart.flnn
  	--!!cblcable.cableStartRefData.val = !this.listElconn.dtext[!this.listElconn.val]
  elseif(!mode.eq('TAIL'))then
  	do !i from 1 to !this.listElconn.rtext.size()
  	  !routePointEnd  = !this.listElconn.rtext[!this.listElconn.val].dbref()
      handle ANY
        !routePointEnd  = object DBREF('/' + !this.listElconn.rtext[!this.listElconn.val])
      endhandle
    enddo
    if !!cblcable.validateSelectedReference(!routePointEnd).not() then
    	return
    endif

    !!cblcable.cableEndRefData.val = !routePointEnd.flnn
  	--!!cblcable.cableEndRefData.val = !this.listElconn.dtext[!this.listElconn.val]
  endif
  !this.hide()
endmethod
