------------------------------------------------------------------------
--
-- Method:      withRespectTo
--
-- Description: CofG position wrt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING      DB element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .withRespectTo(!name is STRING)

--  if (!this.shipPositions.val) then
--    return
--  endif

  var !coord COORD
  !localDistanceFmt = !!distanceFmt
  !localDistanceFmt.enu = (!coord eq 'ENU')

  -- see if it is a dbref
  !test = object DBREF(!name)
  handle ANY
    !this.textWRT.val = '/*'
    return
  elsehandle NONE
    !this.textWRT.val = !test.name
  endhandle

  -- Make a position object to reflect the totalled CofG
  !finalCofG = object POSITION(!this.finalPosition)

   -- Use the WRT gadget
  !finalCofG = !finalCofG.wrt(!this.textWRT.val.dbref())
  handle ANY
    -- Form just shown with no position in gadget
    return
  endhandle

  -- Use the WRT gadget
  !finalString = !finalCofG.string(!localDistanceFmt)

  !this.txtFinalCofG.val    = !finalString

endmethod
-- End of method definition for .withRespectTo()

------------------------------------------------------------------------
--
-- Method:      getShipPosition
--
-- Description: CofG position as ship Position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    BOOLEAN      Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getShipPosition(!pos is POSITION) is STRING

  !return = '---'

  -- Add Ship reference column
  if( !this.marine ) then
    !refGridObject  = object REFGRID()
    !unusedRefGrid  = !refGridObject.gridSy
    handle any
      !return = '---'
    elsehandle none
      !shipGrid = object SHIPGRIDPOSITION(!pos, !refGridObject)
      if( !shipGrid.xOffset lt 0 ) then
        !sign   = '-'
      else
        !sign   = '+'
      endif
      !shipX    = !shipGrid.xPrefix + !shipGrid.xGridLine.string() + !sign + !shipGrid.xOffset.abs().string(!!distanceFmt)
      if( !shipGrid.yOffset lt 0 ) then
        !sign   = '-'
      else
        !sign   = '+'
      endif
      !shipY    = !shipGrid.yPrefix + !shipGrid.yGridLine.string() + !sign + !shipGrid.yOffset.abs().string(!!distanceFmt)
      if( !shipGrid.zOffset lt 0 ) then
        !sign   = '-'
      else
        !sign   = '+'
      endif
      !shipZ    = !shipGrid.zPrefix + !shipGrid.zGridLine.string() + !sign + !shipGrid.zOffset.abs().string(!!distanceFmt)
      !return = !shipX + ' ' + !shipY + ' ' + !shipZ
    endhandle
  endif

  return !return

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      useShipPosition
--
-- Description: CofG position as ship Position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .useShipPosition()

  if (!this.shipPositions.val) then
    !this.txtFinalCofG.val    = !this.finalShipPosition
    handle ANY
      !this.finalPosition
    endhandle
  else
    !this.txtFinalCofG.val    = !this.finalPosition
  endif
  !this.dataGrid.setColumnVisibility(5,!this.shipPositions.val.not())
  !this.dataGrid.setColumnVisibility(7,!this.shipPositions.val)
  !this.textWRT.active = !this.shipPositions.val.not()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      colourUserWeights
--
-- Description: Colour USRWEI elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .colourUserWeights()

  !count = 0
  do !i indices !this.mainGridElements
    if (!this.dataGrid.getCell(!i, 9).eq('true')) then
      !this.dataGrid.setCellColor(!i, 3, 'Orange')
      !this.dataGrid.setCellTooltip(!i, 3, 'Warning - User Weight (USRWEI) has been set ')
    endif
    if (!this.dataGrid.getCell(!i, 3).eq('-1')) then
      !this.dataGrid.setCellColor(!i, 3, 'Red')
      !this.dataGrid.setCellTooltip(!i, 3, 'Error - Unable to derive a weight for this item ')
      !count = !count + 1
    endif
  enddo

  if (!count.gt(0)) then
    !this.validation.visible = true
    !this.validation.tag = !count & ' Invalid'
  else
    !this.validation.visible = false
    !this.validation.tag = '  0 Invalid  '
  endif

endmethod
-- End of method definition
