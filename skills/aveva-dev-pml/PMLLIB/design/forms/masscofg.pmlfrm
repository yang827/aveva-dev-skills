-- Description:
--    Calculates Weight and Centre of Gravity of Elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateSelectedElementsContextMenu(BOOLEAN) -
--  areaNameCheck(GADGET,STRING)     -                   Validate input to area name gadgets
--  calculate(STRING)                -                   calculates the Weight and CofG
--  callCollect(STRING,BOOLEAN)      -                   Sets and Calls the collect method to add elements to grid
--  clearMainGrid()                  -                   Clear the Main grid and initialise the members
--  clearRow()                       -                   clear row selection
--  close()                          -                   Clear the member variables and remove the AID
--  collectElements(STRING)          -                   collects elements based on the collection scope
--  colourUserWeights()              -                   Colour USRWEI elements
--  enhanceColour()                  -                   Enhance the colour for collected elements
--  enhancePicked(DBREF)             -
--  exportToExcel()                  -                   Saves the main grid to an excel file
--  fileName()                       STRING              gets the file name to output the grid data
--  getShipPosition(POSITION)        STRING              CofG position as ship Position
--  getValues(ARRAY)                 ARRAY               gets the grid values
--  initialise()                     -                   Initialise the form
--  loadItems(STRING)                -                   Load Grid with default columns before calculation
--  massCofG()                       -                   Constructor
--  netMainCallback(ARRAY)           -                   main grid callback
--  netPopupMainCallback(ARRAY)      -                   main grid popup callback
--  pickAction()                     -                   pick element action
--  pickElements(STRING)             -                   EDG to pick element for action
--  setMassLevel(STRING)             -                   Set the mass level
--  unenhance(ARRAY)                 -                   Un-enhance the colour
--  useShipPosition()                -                   CofG position as ship Position
--  validMassLevelInput(GADGET,STRING) -                   Validate input to mass level gadgets
--  withRespectTo(STRING)            -                   CofG position wrt
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

-- Icons
!refreshIcon = !!pml.getPathName('refresh16.png')
-- !pickIcon    = !!pml.getPathName('navigate16.png')

layout form !!massCofG dialog dock R
--setup form !!massCofG varchars dialog dock R

  !this.formTitle     = 'Weight and Centre of Gravity (CofG)'
  !this.callback      = '!!massCofG.initialise()'
  !this.quitCall      = '!!massCofG.close()'
  !this.cancelCall    = '!!massCofG.close()'

  -- Start of net grid frame
  hdist 0
  vdist 0
  frame .addFrame 'Add Elements' anchor t+l+r width 35
    option .loadType    '' anchor l+r+t width 20.8
    button .butloadType  'Add' tooltip 'Add Selected Elements' anchor t+r at xmax.loadType+.5 ymin width 8
    text .textName 'Named Element:'  tagwid 11 anchor l+r+t at xmin.loadType ymax+.2 width 11.5 is STRING
    button .addNamedElementButton 'Add' tooltip 'Add Named Element' anchor t+r at xmin.butloadType ymin width 8
  exit
  -- Start of net grid frame
  frame .selectFrame 'Selected Elements' at xmin ymax anchor all width.addFrame hei 1
    container .netFrame NOBOX PMLNetControl 'NET' dock fill
  exit
  -- End of net grid frame

  -- Start of Settings frame
  frame .settingsFrame       'Settings'  at xmin ymax anchor l+r+b width.addFrame
    -- Wet / Dry
    option .wetDry           'Wet/Dry:'   tagwid 10 anchor l+r+t width 20
    -- Net / Gross / Rough
    option .netGross         'Negatives:' at xmin ymax+.1 tagwid 10 anchor l+r+t width 20
    -- Include members weight or report weight of item ONLY
    option .membersOrOnly    'Weight Of:' at xmin ymax+.1 tagwid 10 anchor l+r+t width 20
    -- Mass representation level
    text .massRepresentation 'Representation Level:' tagwid 21 anchor l+r+t at xmin ymax+.1           width 9 is STRING
    button .refresh at xmax ymin anchor t+r pixmap "$!<refreshIcon>"                       width 16 height 16
    text .textWRT            'CofG WRT:' tagwid 10 anchor l+r+t at x0.5 ymax+.2 tagwid 10 width 22 is STRING
    toggle .shipPositions 'Ship Positions'    at xmin ymax
  exit
  -- End of settings frame

--  -- Start of Inside/Outside frame
--  frame .withinAreaFrame  'Within Area' at xmin ymax                  anchor l+r+b           width.selectFrame
--    -- Toggle to activate the within option
--    toggle .activeWithin 'Use Within Area' anchor l+b at x 11
--    text .textAreaElement 'Area:'   at x1 ymax                  anchor l+r+t tagwid 10 width 20 is STRING
--    button .pickArea                at xmax ymin                  anchor r+t   pixmap "$!<pickIcon>"  width 16 height 16
--    option .insideOutside 'Option:' at x1 ymax+.2               anchor l+r+t tagwid 10 width 20
--  exit
--  -- End of Inside/Outside frame

  frame .calculateFrame 'Calculate Weight and Centre of Gravity (CofG)' at xmin ymax anchor l+r+b width.addFrame
    -- Result Gadget
    text .txtTotalWeight  'Total Weight:' tagwid 10 anchor l+r+b width 22 is STRING
    text .txtFinalCofG    'CofG:' tagwid 10 anchor l+r+b at xmin.txtTotalWeight ymax+.2 width 22 is STRING
    button .validation '  0 Invalid  '  at xmin ymax+.2 anchor l+b width 13
    button .butCalculate 'Apply' tooltip 'Calculate Weight and Centre of Gravity' at xmax.txtFinalCofG-9 ymin anchor r+b width 8
  exit

   menu .popmenumain
    !this.popmenumain.add( 'callback', 'Remove Selected Element(s)', '!this.clearRow()', 'REM' )
    !this.popmenumain.add( 'callback', 'Remove All Elements', '!this.initialise()', 'REMALL' )
    !this.popmenumain.add( 'separator' )
    !this.popmenumain.add( 'CALLBACK', 'Enhance in 3D View', '!this.enhanceColour()', 'HIGHALL')
    !this.popmenumain.add( 'CALLBACK', 'Unenhance in 3D View', '!this.unenhance(!!massCofG.elementsArray)', 'UNHIGHALL' )
    !this.popmenumain.add( 'toggle',   'Navigate To', '', 'NAVIGATE' )
    !this.popmenumain.add( 'separator' )
    !this.popmenumain.add( 'callback', 'Export to Excel...', '!this.exportToExcel()', 'EXCEL' )
    !this.popmenumain.add( 'callback', 'Print Preview...', '!this.dataGrid.printpreview()', 'PRINT' )

  -- Form Members

  using namespace 'Aveva.Pdms.Presentation'

  -- .Net control object
  member .dataGrid is NETGRIDCONTROL

  -- Elements listed in the Grid
  member .elementsArray       is ARRAY

  member .mainGridElements  is ARRAY

  -- Elements collected in current list
  member .collectionArray     is ARRAY

  -- Area element that is identified
  member .areaElement         is ARRAY

  -- Grid details
  member .gridName            is STRING
  member .headings            is ARRAY
  member .rowElements         is ARRAY

  -- Axes definition
  member .axes                is GPHAXES

  -- Aid number
  member .aidNumber           is REAL
  member .aidNumberPosition   is REAL

  --EDG pick Elements
  member .pickedElements      is ARRAY

  -- Valid element types list
  member .types               is ARRAY

  --Append data to the grid
  member .append              is BOOLEAN

  -- Picked area element via EDG
  member .pickedAreaElement   is DBREF

  -- Store the save location of the Save As dialog
  member .prevSaveLocation is STRING

  -- Marine Project
  member .marine is BOOLEAN

  -- Final Position as XYZ Position
  member .finalPosition is STRING
  -- Final Position as Ship Position
  member .finalShipPosition is STRING

  member .hideWarnings is BOOLEAN

exit
------------------------------------------------------------------------
--
-- Method:      massCofG
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .massCofG()

  !mm = object AVEVAMODULEMANAGER()
  !this.marine = !mm.currentProductName().upcase().eq('HULL & OUTFITTING')
  --Test Only
--  !this.marine = false
  !this.shipPositions.visible = !this.marine
  !this.shipPositions.val     = !this.marine
  !this.textWRT.active        = !this.marine.not()
  !this.shipPositions.callback = '!this.useShipPosition()'

  -- Callbacks
  !this.refresh.callback      = |!this.setMassLevel('current')|
--  !this.pickArea.callback     = |!this.callPickArea()|
  !this.butCalculate.callback = '!this.calculate(|MAIN|)'

  -- Tooltips
  !this.refresh.setTooltip('Refresh with Current Value')
--  !this.pickArea.setTooltip('Pick an Area Definition Element')

  -- Set the cancel call
  !this.cancelCall = '!this.close()'
  !this.autoscroll   = true

  !this.butloadType.callback   = '!this.callCollect(!this.loadType.selection(),TRUE)'

  -- Name gadget
  !this.textName.val = 'unset'
  !this.addNamedElementButton.callback = '!this.collectElements(|NAME|)'

  -- WRT gadget
  !this.textWRT.val = '/*'
  !this.textWRT.callback = '!this.withRespectTo(!this.textWRT.val)'
  !this.textWRT.validateCall = '!this.areaNameCheck('

  -- Make the Total Weight and CofG result gadget not editable
  !this.txtTotalWeight.setEditable(false)
  !this.txtFinalCofG.setEditable(false)

  -- Append values
  !this.append  = false

  -- Options for collection scope
  !scopeDtext = ARRAY()
  !scopeDtext.append('Current Element')
  !scopeDtext.append('Element Members')
  !scopeDtext.append('Members with Tubing')
  !scopeDtext.append('Current List')
  !scopeDtext.append('Graphical Pick')
  !scopeDtext.append('Graphical Selection')
  !scopeDtext.append('Within Area')
  !scopeDtext.append('Within Volume of CE')
  !this.loadType.dtext  = !scopeDtext
  -- Options for collection scope
  !scopeRtext = ARRAY()
  !scopeRtext.append('CE')
  !scopeRtext.append('CEMEM')
  !scopeRtext.append('CEBRANMEM')
  !scopeRtext.append('LIST')
  !scopeRtext.append('GPHPICK')
  !scopeRtext.append('GPHSEL')
  !scopeRtext.append('AREA')
  !scopeRtext.append('VOLUME')
  !this.loadType.rtext  = !scopeRtext

  -- Options for wet/dry
  !wetDryDtext = ARRAY()
  !wetDryDtext.append('Dry Weight')
  !wetDryDtext.append('Wet Weight')
  !this.wetDry.dtext  = !wetDryDtext
  -- Options for wet/dry
  !wetDryRtext = ARRAY()
  !wetDryRtext.append('DRY')
  !wetDryRtext.append('WET')
  !this.wetDry.rtext  = !wetDryRtext

  -- Options for net/Gross
  !netGrossDtext = ARRAY()
  !netGrossDtext.append('Consider (Net)')
  !netGrossDtext.append('Ignore (Gross)')
  !netGrossDtext.append('Ignore (Rough)')
  !this.netGross.dtext  = !netGrossDtext
  -- Options for net/Gross
  !netGrossRtext = ARRAY()
  !netGrossRtext.append('NET')
  !netGrossRtext.append('GROSS')
  !netGrossRtext.append('ROUGH')
  !this.netGross.rtext  = !netGrossRtext

  -- Options for members or only
  !membersOrOnlyDtext = ARRAY()
  !membersOrOnlyDtext.append('All Members')
  !membersOrOnlyDtext.append('Element Only')
  !this.membersOrOnly.dtext  = !membersOrOnlyDtext
  -- Options for members or only
  !membersOrOnlyRtext = ARRAY()
  !membersOrOnlyRtext.append('ALL')
  !membersOrOnlyRtext.append('ONLY')
  !this.membersOrOnly.rtext  = !membersOrOnlyRtext

  -- Mass representation level
  var !massLevel REPRE MASS
  !this.massRepresentation.val = !massLevel
  !this.massRepresentation.validateCall = '!this.validMassLevelInput('
  !this.massRepresentation.callback = |!this.setMassLevel('gadget')|

  -- Toggle for usage of Within frame
--  !this.activeWithin.callback = '!this.setWithinAreaActive(!this.activeWithin.val)'
--  !this.activeWithin.val = false
--  !this.setWithinAreaActive(!this.activeWithin.val)

  -- Area Definition gadget
--  !this.textAreaElement.val = 'unset'
--  !this.textAreaElement.validateCall = '!this.areaNameCheck('

  -- Options for net/Gross
--  !insideOutsideDtext = ARRAY()
--  !insideOutsideDtext.append('Weight Inside')
--  !insideOutsideDtext.append('Weight Outside')
--  !this.insideOutside.dtext  = !insideOutsideDtext
  -- Options for net/Gross
--  !insideOutsideRtext = ARRAY()
--  !insideOutsideRtext.append('INSIDE')
--  !insideOutsideRtext.append('OUTSIDE')
--  !this.insideOutside.rtext  = !insideOutsideRtext

  --  Heading For list gadget
  !this.headings = ARRAY()
  !this.headings.append('Type')
  !this.headings.append('Name')
  !this.headings.append('Weight')
  !this.headings.append('Weight Source')
  !this.headings.append('CofG')
  !this.headings.append('CofG Source')
  !this.headings.append('Ship CofG')
  !this.headings.append('Description')
  !this.headings.append('USRWEI')

  -- Allocate aid numbers
  !this.aidNumber         = !!aidNumbers.add('CofG Axes')
  !this.aidNumberPosition = !!aidNumbers.add('Individual CofG Position')

  -- Grid name
  !this.gridName = ' '

  using namespace  'Aveva.Pdms.Presentation'

  -- create instance of .Net control
  !this.dataGrid = object NETGRIDCONTROL()

  !this.mainGridElements  = object ARRAY()
  !netMainDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !this.mainGridElements, false)
  !this.dataGrid.bindToDataSource(!netMainDataSource)

  !this.dataGrid.addEventHandler('OnPopup',           !this, 'netPopupMainCallback')
  !this.dataGrid.addEventHandler('AfterSelectChange', !this, 'netMainCallback')

  -- Validation button
  !redObject = object COLOUR('Brightred')
  !this.validation.background = !redObject.code
  !this.validation.active = false

  !this.hideWarnings = false

endmethod
-- End of method definition for .massCofG()

-- define method .setWithinAreaActive(!active is BOOLEAN)
--   !this.textAreaElement.active = !active
--   !this.pickArea.active = !active
--   !this.insideOutside.active = !active
-- endmethod
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- clear the main and member grid
  !this.clearMainGrid()
  -- Clear validation Gadget too
  !this.validation.visible = false

endmethod
-- End of method .initialise()
------------------------------------------------------------------------
--
-- Method:      callCollect
--
-- Description: Sets and Calls the collect method to add elements to grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     collection scope
--    2   R      BOOLEAN    Load or Append mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .callCollect(!collectionScope is STRING, !append is BOOLEAN)

  -- Clear validation Gadget too
  !this.validation.visible = false

  -- clear grid
  !this.append  = !append
  if(!this.append.not()) then
    !this.clearMainGrid()
  endif

  if(!collectionScope eq 'CE') then
      if (!!ce.type eq 'WORL') then
          !!alert.error('Cannot use from world level.')
          return
      elseif (!!ce.type inset('SITE','BLOCK')) then
          !answer = !!alert.confirm('Are you sure you want to add ' & !!ce.type & '?')
          if (!answer eq 'NO') then
            return
          endif
      endif
      -- load CE object
      !this.collectElements(!collectionScope)
  elseif(!collectionScope eq 'CEMEM' or !collectionScope eq 'CEBRANMEM' ) then
      if (!!ce.type eq 'WORL') then
          !answer = !!alert.confirm('Are you sure you want to add from World level?')
          if (!answer eq 'NO') then
            return
          endif
      endif
      -- load CE members object
      !this.collectElements(!collectionScope)
  elseif(!collectionScope eq 'LIST') then
      !form = !!cdcList
      !numb = !form.name.val
      !block = object BLOCK('!!cdlist' & !numb)
      if(!block.string().lowcase() eq '!!cdlist0' )  then
         !!alert.error('There is no List defined.')
         return
      elseif(undefined(!block.evaluate())) then
         !!alert.error('The current List is empty.')
         return
      endif

      !collectionArray = !block.evaluate()
      !this.collectionArray = !collectionArray.evaluate(object BLOCK('!collectionArray[!evalIndex].dbref()'))
      !this.collectElements(!collectionScope)

  elseif(!collectionScope eq 'NAME') then

      -- load named object
      !this.collectElements(!collectionScope)

  elseif(!collectionScope eq 'GPHPICK') then
      -- Pick from graphics
      !this.pickElements('ALL')

  elseif(!collectionScope eq 'GPHSEL') then
      -- Collect elements from Window selection
      !selectionArray = object SELECTION()
      -- Get current selection
      !selectionArray.getCurrent()
      !this.collectionArray = !selectionArray.getSelection()
      if(!this.collectionArray.set())then
      !this.collectElements('SELECTION')
      else
         !!alert.error('Select Elements from Graphics.')
         return
      endif

  elseif(!collectionScope eq 'AREA') then
      !this.pickElements('AREADEF')

  elseif(!collectionScope eq 'VOLUME') then
      if (!!ce.type eq 'WORL') then
          !!alert.error('Unable to add within volume of type World.')
          return
      elseif (!!ce.type inset('SITE','BLOCK')) then
          !answer = !!alert.confirm('Are you sure you want to add elements in volume of ' & !!ce.type & '?')
          if (!answer eq 'NO') then
            return
          endif
      endif
      -- load CE object
      !this.collectElements(!collectionScope)

  endif

endmethod
-- End of method .callCollect()
------------------------------------------------------------------------
--
-- Method:      loadItems
--
-- Description: Load Grid with default columns before calculation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Grid Type (MAIN/MEMBERS)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadItems(!gridType is STRING)

  using namespace  'Aveva.Pdms.Presentation'

  -- suppress grid events
  !this.dataGrid.allGridEvents(false)

  if(!gridType.eq('MAIN')) then
     !this.mainGridElements  = object ARRAY()
     if(!this.elementsArray.set()) then
        do !i indices !this.elementsArray
           !this.mainGridElements[!i][1] = !this.elementsArray[!i].dbref().type
           if (!this.elementsArray[!i].dbref().isnamed) then
             !this.mainGridElements[!i][2] = !this.elementsArray[!i].dbref().name
           else
             !this.mainGridElements[!i][2] = !this.elementsArray[!i].dbref().parnam
             handle ANY
               !this.mainGridElements[!i][2] = !this.elementsArray[!i].dbref().name
             elsehandle NONE
               if (!this.mainGridElements[!i][2].unset() or !this.mainGridElements[!i][2].length().eq(0)) then
                 !this.mainGridElements[!i][2] = !this.elementsArray[!i].dbref().name
               else
                 !unsedTest = !this.mainGridElements[!i][2].dbref()
                 handle ANY
                   !this.mainGridElements[!i][2] = !this.elementsArray[!i].dbref().name
                 endhandle
               endif
             endhandle
           endif
           !this.mainGridElements[!i][3] = ''
           !this.mainGridElements[!i][4] = ''
           !this.mainGridElements[!i][5] = ''
           !this.mainGridElements[!i][6] = ''
           !this.mainGridElements[!i][7] = ''
           !this.mainGridElements[!i][8] = !this.elementsArray[!i].dbref().description
           handle ANY
             !this.mainGridElements[!i][8] = ''
           endhandle
           !this.mainGridElements[!i][9] = ''
        enddo
     endif

     !this.dataGrid = object NETGRIDCONTROL()
     !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !this.mainGridElements, false)
     !this.dataGrid.bindToDataSource(!netDataSource)

  endif

  -- Enable the grid events
  !this.dataGrid.allGridEvents(true)

  -- Make mass columns invisible
  !this.dataGrid.setColumnVisibility(3,FALSE)
  !this.dataGrid.setColumnVisibility(4,FALSE)
  !this.dataGrid.setColumnVisibility(5,FALSE)
  !this.dataGrid.setColumnVisibility(6,FALSE)
  !this.dataGrid.setColumnVisibility(7,FALSE)
  !this.dataGrid.setColumnVisibility(8,FALSE)
  !this.dataGrid.setColumnVisibility(9,FALSE)

endmethod
-- End of method definition .loadItems()
------------------------------------------------------------------------
--
-- Method:      clearMainGrid
--
-- Description: Clear the Main grid and initialise the members
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearMainGrid()

  -- disable the grid events so that clearGrid method works fine
  !this.dataGrid.allGridEvents(false)

  -- clear the grid
  !this.dataGrid.clearGrid()

  using namespace  'Aveva.Pdms.Presentation'

  -- create instance of .Net control
  !this.dataGrid = object NETGRIDCONTROL()

  !this.mainGridElements = object ARRAY()

  !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !this.mainGridElements, false)
  !this.dataGrid.bindToDataSource(!netDataSource)

  !this.netFrame.control = !this.dataGrid.handle()

  !this.dataGrid.columnExcelFilter(true)
  !this.dataGrid.outlookGroupStyle(false)
  !this.dataGrid.fixedHeaders(true)
  !this.dataGrid.fixedRows(false)
  !this.dataGrid.gridHeight(100.0)
  !this.dataGrid.singleRowSelection(false)

  -- Clear the result gadgets
  !this.txtTotalWeight.val = ''
  !this.txtFinalCofG.val   = ''

  -- Unenhance the elements in the list
  if(!this.elementsArray.set()) then
    do !i indices !this.elementsArray
       unenhance $!this.elementsArray[$!i]
       handle ANY
         -- In case that elements have been deleted from under our feet
       endhandle
    enddo
  endif

  -- Make mass columns invisible
  !this.dataGrid.setColumnVisibility(3,FALSE)
  !this.dataGrid.setColumnVisibility(4,FALSE)
  !this.dataGrid.setColumnVisibility(5,FALSE)
  !this.dataGrid.setColumnVisibility(6,FALSE)
  !this.dataGrid.setColumnVisibility(7,FALSE)
  !this.dataGrid.setColumnVisibility(8,FALSE)
  !this.dataGrid.setColumnVisibility(9,FALSE)

  !this.close()

endmethod
-- End of method definition .clearMainGrid()
------------------------------------------------------------------------
--
-- Method:      collectElements
--
-- Description: collects elements based on the collection scope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING      Collection Scope(CE,LIST,Graphics,Volume,AREA element)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .collectElements(!collectFrom is STRING)

  -- Clear validation Gadget too
  !this.validation.visible = false

  -- Initialise Variables
  !collectedElements = ARRAY()
  !listCollection    = ARRAY()

  -- Collect relevant types
  !collection = object COLLECTION()

  !expression = object EXPRESSION()
  !expression.expression('NOT(TYPE eq |TUBI| and ITLE lt 1)' )

  !collection.filter(!expression)

  -- collect for current element
  if(!collectFrom eq 'CE') then
    !collectedElements[1] = !!ce.string()

  elseif(!collectFrom eq 'VOLUME') then
     var !results collect all within volume ce
     !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].dbref().string()'))


  elseif(!collectFrom eq 'CEBRANMEM') then
    if ( !!ce.type eq 'BRAN' ) then
      var !results collect all bran mem for ce
     !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].dbref().string()'))
    else
     !results = !!ce.members
     !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].string()'))
    endif

  elseif(!collectFrom eq 'CEMEM') then
    if (!!ce.type eq 'ASMBLY') then
      !results = !!ce.sMembers
    else
      !results = !!ce.members
    endif
    !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].string()'))

  elseif(!collectFrom eq 'NAME') then
    !results = ARRAY()
    !element = !this.textName.val.dbref()
    handle ANY
      !!alert.error('The specified element does not exist.')
      return
    endhandle
    if (!element.badref()) then
      return
    endif
    if (!element.type eq 'WORL') then
        !!alert.error('An element of type World is not allowed.')
        return
    elseif (!element.type inset('SITE','BLOCK')) then
        !answer = !!alert.confirm('Are you sure you want to add ' & !element.type & '?')
        if (!answer eq 'NO') then
          return
        endif
    endif
    !results[1] = !element
    !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].string()'))

  elseif(!collectFrom eq 'LIST' or !collectFrom eq 'SELECTION') then

    !memory = !!ce
    do !elem values !this.collectionArray
      if(!elem.acttype.eq('TUBI') and !elem.itle.lt(1)) then
        skip
      endif
      !listCollection.append(!elem)
    enddo

    !collectedElements  = !listCollection.evaluate(object BLOCK('!listCollection[!evalIndex].string()'))
    !!ce = !memory

  elseif(!collectFrom eq 'AREADEF') then

     if(!!massCofG.pickedAreaElement.unset()) then
       !!alert.error('Pick an Area element')
       return
     endif

     if(!!massCofG.pickedAreaElement.type eq 'AREADE') then
       !areaDefElement  = !!massCofG.pickedAreaElement
     elseif(!!massCofG.pickedAreaElement.owner.type eq 'AREADE') then
       !areaDefElement  = !!massCofG.pickedAreaElement.owner
     endif

     var !areaCollection collect ALL with (type neq 'AREADE') EXCL within volume $!areaDefElement
     !collectedElements = !areaCollection.evaluate(object BLOCK('!areaCollection[!evalIndex].dbref().string()'))
  endif

  --Make the collection unique
  !collectedElements.unique()

  if(!this.append and !this.elementsArray.set()) then
    !this.elementsArray.appendArray(!collectedElements)
  else
    !this.elementsArray  = !collectedElements
  endif

  -- remove if owner is present in the list
  !removeIndices = object ARRAY()
  do !n indices !this.elementsArray.unique()
     !ownerList = !this.elementsArray[!n].dbref().ownlst
     handle ANY
       !removeIndices.append(!n)
       skip
     endhandle
     !ownerNames = !ownerList.evaluate(object BLOCK('!ownerList[!evalIndex].string()'))
     do !owner values !ownerNames
       if(!this.elementsArray.findFirst(!owner).set()) then
        !removeIndices.append(!n)
        break
        endif
     enddo
  enddo

  !removeIndices  = !removeIndices.invert()
  do !indx values !removeIndices
     !this.elementsArray.remove(!indx)
  enddo
  !this.elementsArray.compress()

  -- Highlight collected Element
  !this.enhanceColour()

  -- load elements in the main grid
  !this.loadItems('MAIN')

endmethod
-- End of method definition .collectElements()
------------------------------------------------------------------------
--
-- Method:      enhanceColour
--
-- Description: Enhance the colour for collected elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhanceColour()

  -- Highlight collected Element
  do !n indices !this.elementsArray
    enhance $!this.elementsArray[$!n] col $!!gphColOpt.highlight.code
  enddo

endmethod
-- End of method definition .enhanceColour()
--------------------------------------------------------------------------
--
-- Method:     unenhance
--
-- Description: Un-enhance the colour
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unenhance(!elements is ARRAY)

  do !n indices !elements
    unenhance $!elements[$!n]
    handle ANY
      -- In case that elements have been deleted from under our feet
    endhandle
  enddo

  -- Remove the Axes
  if(!this.aidNumber.set()) then
    !!aidNumbers.remove(!this.aidNumber)
    !!aidNumbers.remove(!this.aidNumberPosition)
  endif

endmethod
-- End of method definition .unenhance()
------------------------------------------------------------------------
--
-- Method:      close()
--
-- Description: Clear the member variables and remove the AID
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Unenhance all
  !this.unenhance(!this.elementsArray)

  !this.elementsArray    = object ARRAY()
  !this.collectionArray  = object ARRAY()
  !this.mainGridElements = object ARRAY()

endmethod
-- End of method definition .close()
------------------------------------------------------------------------
--
-- Method:  netPopupMainCallback
--
-- Description: main grid popup callback
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupMainCallback(!a is ARRAY)

  !this.activateSelectedElementsContextMenu(!this.dataGrid.getRows().size() gt 0)

  !this.netFrame.popup = !this.popmenumain
  !this.netFrame.showPopup(!a[0], !a[1])

endmethod
--End of method definition .netPopupMainCallback()

define method .activateSelectedElementsContextMenu(!active is BOOLEAN)
  !this.popmenumain.setFieldProperty('REM', 'active', !active )
  !this.popmenumain.setFieldProperty('REMALL', 'active', !active )
  !this.popmenumain.setFieldProperty('HIGHALL', 'active', !active )
  !this.popmenumain.setFieldProperty('UNHIGHALL', 'active', !active )
  !this.popmenumain.setFieldProperty('NAVIGATE', 'active', !active )
  !this.popmenumain.setFieldProperty('EXCEL', 'active', !active )
  !this.popmenumain.setFieldProperty('PRINT', 'active', !active )
endmethod

------------------------------------------------------------------------
--
-- Method:  netMainCallback
--
-- Description: main grid callback
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netMainCallback(!a is ARRAY)

  !selectedRowNumber = !this.dataGrid.getSelectedRowTags()[1].real()
  handle ANY
    return
  endhandle
  !row = !this.dataGrid.getSelectedRows()
  !element = !this.elementsArray[!selectedRowNumber].dbref()
  handle ANY
    return
  endhandle
  --Navigate if flagged
  !test = !this.netFrame.popup.selected('Navigate To')
  handle ANY
  elsehandle NONE
    if (!test.set() and !test) then
      !!ce = !element
    endif
  endhandle

  -- Tag the selected element with its CofG
  !aidNumber = !this.aidNumberPosition
  if (!this.shipPositions.val) then
    !text = !row[1][7]
    !textPos = !row[1][5]
  else
    !text = !row[1][5]
    !textPos = !row[1][5]
  endif
  aid clear text $!aidNumber
  handle ANY
  endhandle
  aid text number $!aidNumber '$!text' at $!textPos
  handle ANY
  endhandle

endmethod
--End of method definition .netMainCallback()
---------------------------------------------------------------------------
--
-- Method:      pickElements
--
-- Description: EDG to pick element for action
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING       Element type (AREADE/ALL)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickElements(!pickElementType is STRING)

    if(!pickElementType eq 'ALL') then

      !packet = object EDGPACKET()
      !packet.initialisation  = '!!massCofG.collectionArray = object ARRAY()'
      !packet.action = '!!massCofG.enhancePicked(!this.return[1].item)'
      !packet.elementPick('Pick elements and <Esc>')
      !packet.key      = 'Pick Elements'
      !packet.remove = false
      --!packet.pickPacket.picks[1].pick.input[3] = |'NOT (TYPE eq |TUBI| and ITLE lt 2)'|
      !packet.pickPacket.picks[1].pick.modifiable = FALSE

      !packet.close = '!!massCofG.pickAction()'

      !!edgCntrl.add(!packet)

    elseif(!pickElementType eq 'AREADEF') then

      !packet = object EDGPACKET()
      !packet.initialisation  = '!!massCofG.pickedAreaElement = object DBREF()'
      !packet.action = '!!massCofG.pickedAreaElement = !this.return[1].item'
      !packet.elementPick('Pick an Area element')
      !packet.description = 'Pick an Area element'
      !packet.key      = 'Pick AREADEF'
      !packet.remove = true
      !packet.pickPacket.picks[1].pick.input[3]   = | type eq 'AREADE' or (type of own) eq 'AREADE' |
      !packet.pickPacket.picks[1].pick.modifiable = FALSE
      !packet.escape  = ''
      !packet.continue = '!!massCofG.collectElements(|AREADEF|)'

      !!edgCntrl.add(!packet)
    endif

endmethod
--End of method definition .pickElements()
---------------------------------------------------------------------------
--
-- Method:      pickAction
--
-- Description:pick element action
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickAction()

 -- Collect picked elements
 !this.collectElements(|LIST|)

endmethod
--End of method definition .pickAction()
---------------------------------------------------------------------------
--
-- Method:      clearRow
--
-- Description: clear row selection
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearRow()

  -- Clear validation Gadget too
  !this.validation.visible = false

  !this.txtTotalWeight.val  = ''
  !this.txtFinalCofG.val    = ''

  !selectedRow  = !this.dataGrid.getSelectedRowTags()
  do !j indices !selectedRow
    unenhance $!this.elementsArray[$!selectedRow[$!j]]
    handle ANY
      -- In case that elements have been deleted from under our feet
    endhandle
    !this.elementsArray.deleteFrom(!selectedRow[!j].real(), 1)
  enddo
  --Reindex the elements Array
  !this.elementsArray.compress()

  !this.loadItems('MAIN')

  -- Remove the Axes
  if(!this.aidNumber.set()) then
    !!aidNumbers.remove(!this.aidNumber)
    !!aidNumbers.remove(!this.aidNumberPosition)
  endif

endmethod
--End of method definition .clearRow()
---------------------------------------------------------------------------
--
-- Method:      exportToExcel
--
-- Description: Saves the main grid to an excel file
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exportToExcel()

  !fileName = !this.fileName()
  !!exportToExcel(!this.dataGrid, !fileName, 'Save Weight & Centre of Gravity Data As')

endmethod
--End of method definition .exportToExcel()
---------------------------------------------------------------------------
--
-- Method:      fileName
--
-- Description: gets the file name to output the grid data
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fileName() is STRING

 !pdmsUser = !!evarSplit('PDMSUSER')

 !clock     = object DATETIME()
 !time      = !clock.string()
 !time      = !time.replace(':','-')
 !fileName  = !pdmsUser[1] & |\| & |Weight -| & !time & |.xls|

 return !fileName

endmethod
--End of method definition .fileName()
---------------------------------------------------------------------------
--
-- Method:      getValues
--
-- Description: gets the grid values
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     ARRAY        Elements List Array
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getValues(!elementsArray is ARRAY) is ARRAY

  -- Initialise Variables
  !return           = object ARRAY()

  --Get all  collected element for calculation
  if(!elementsArray.unset()) then
     return !return
  endif

  !elements = object ARRAY()

   -- Loop through all elements and get their surface from the relevant setting
  do !i indices !elementsArray
     !elements[!i]  = !elementsArray[!i].dbref()
  enddo

  !unique   = !elements.unique()

  do !i indices !unique
     !return[!i][1] = !unique[!i].type
    if (!unique[!i].isnamed) then
      !return[!i][2] = !unique[!i].name
    else
      !return[!i][2] = !unique[!i].parnam
      handle ANY
        !return[!i][2] = !unique[!i].name
      elsehandle NONE
        if (!return[!i][2].unset() or !return[!i][2].length().eq(0)) then
          !return[!i][2] = !unique[!i].name
        else
          !unsedTest = !return[!i][2].dbref()
          handle ANY
            !return[!i][2] = !unique[!i].name
          endhandle
        endif
      endhandle
    endif
     !return[!i][3] = ''
     !return[!i][4] = ''
     !return[!i][5] = ''
     !return[!i][6] = ''
     !return[!i][7] = ''
     !return[!i][8] = !unique[!i].description
     handle ANY
      !return[!i][8] = ''
     endhandle
     !return[!i][9] = ''
  enddo

  !this.append = false

  return !return

endmethod
--End of method definition .getValues()
---------------------------------------------------------------------------
--
-- Method:      calculate
--
-- Description: calculates the Weight and CofG
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING       grid type (MAIN/MEMBER)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculate(!gridType is STRING)

  -- Initial variable
  !errors = 0
  !warnings = 0
  var !coord COORD
  !localDistanceFmt = !!distanceFmt
  !localDistanceFmt.enu = (!coord eq 'ENU')

  -- Mass Representation level
  !this.setMassLevel('gadget')

  !memory = !!ce
  !this.dataGrid.allGridEvents(false)

  using namespace  'Aveva.Pdms.Presentation'

  if(!gridType eq 'MAIN' ) then

    if(!this.elementsArray.unset()) then
      !!alert.error('There are no elements in the list to calculate.')
      return
    endif

    !row = !this.dataGrid.getRows().size()

    !type = !this.dataGrid.getColumn(1)
    !name = !this.dataGrid.getColumn(2)
    !desc = !this.dataGrid.getColumn(8)

    !totalWeight = 0kg
    !eastTotal   = 0mm
    !northTotal  = 0mm
    !upTotal     = 0mm
    !netGross = !this.netGross.selection()

    -- Test that the AREADE is set
--    if (!this.activeWithin.val) then
--      !areaElementType = !this.textAreaElement.val.dbref().type
--      handle ANY
--        !!alert.error('The Area element is not defined')
--        return
--      elsehandle NONE
--        if (!areaElementType neq 'AREADE') then
--          !!alert.error('The Area element is not defined')
--          return
--        endif
--      endhandle
--      -- Get the inside, outside, free option  and Wet/Dry
--      !insideOutsideOption = !this.insideOutside.selection()
--      !wetDryOption = !this.wetDry.selection()
--      !membersOrOnlyOption = !this.membersOrOnly.selection()
--      -- Get the AREA element
--      !areaElement = !this.textAreaElement.val.dbref()
--      !arguments=object array()
--      !arguments[1]=!insideOutsideOption
--      !arguments[2]=!areaElement
--      !arguments[3]=!wetDryOption
--      !arguments[4]=!membersOrOnlyOption
--    else
      -- Get the inside, outside, free option  and Wet/Dry
      !wetDryOption = !this.wetDry.selection()
      !membersOrOnlyOption = !this.membersOrOnly.selection()
      !arguments=object array()
      !arguments[1]=!wetDryOption
      !arguments[2]=!membersOrOnlyOption
--    endif

    do !i from 1 to !row
      !progress = (!i / !row) * 100
      !!fmsys.setProgress(!progress)
      !weight[!i] = 0
      !cofg[!i] = object POSITION()
      !!ce = !this.dataGrid.getColumn(2)[!i].dbref()
      handle ANY
        !!alert.error('Could not Calculate! (Element has be deleted)')
        return
      endhandle
      -- This is to find any Real() input weights by user to colour orange to warn that User has input this value.
      !unusedTestUserWeight[!i] = !!ce.usrwei.before(' )').after('( ').real()
      handle ANY
        !user[!i] = ''
      elsehandle NONE
        if (!!ce.usrwei.set()) then
          !user[!i] = 'true'
        endif
      endhandle
      if (!netGross eq 'NET') then
        !weightInArray = !!ce.attribute('nwei',!arguments)
        handle NONE
          !weight[!i] = !weightInArray[1]
        elsehandle ANY
          !weight[!i] = -1
        endhandle
        !cofgPosition = !!ce.attribute('ncofg',!arguments).wrt( !this.textWRT.val.dbref() )
        handle NONE
          !cofg[!i]    = !cofgPosition
        elsehandle ANY
          !cofg[!i]   = object POSITION('E0')
        endhandle
      elseif (!netGross eq 'GROSS') then
        !weightInArray = !!ce.attribute('gwei',!arguments)
        handle NONE
          !weight[!i] = !weightInArray[1]
        elsehandle ANY
          !weight[!i] = -1
        endhandle
        !cofgPosition = !!ce.attribute('gcofg',!arguments).wrt( !this.textWRT.val.dbref() )
        handle NONE
          !cofg[!i]    = !cofgPosition
        elsehandle ANY
          !cofg[!i]   = object POSITION('E0')
        endhandle
      else
        !weightInArray = !!ce.attribute('rwei',!arguments)
        handle NONE
          !weight[!i] = !weightInArray[1]
        elsehandle ANY
          !weight[!i] = -1
        endhandle
        !cofgPosition = !!ce.attribute('rcofg',!arguments).wrt( !this.textWRT.val.dbref() )
        handle NONE
          !cofg[!i]    = !cofgPosition
        elsehandle ANY
          !cofg[!i]   = object POSITION('E0')
        endhandle
      endif

      -- Integrate the next CofG into totals for final position
      !newWeight = !weight[!i]
      !newCofG   = !cofg[!i]

      if (!newCofG.unset() or !newWeight.lt(0)) then
        !errors = !errors + 1
        if (!errors eq 1) then
          !element = !!ce
        endif
      elseif (!newWeight.eq(0) and !!ce.gvol.gt(0)) then
        !warnings = !warnings + 1
        if (!errors eq 0 and !warnings eq 1) then
          !element = !!ce
        endif
      else
        !eastTotal  = ((!eastTotal  * !totalWeight + !newCofG.east  * !weight[!i]) / (!totalWeight + !weight[!i]))
        handle ANY
          -- It could be division by zero if user is asking, for example Weight of an empty branch
        endhandle
        !northTotal = ((!northTotal * !totalWeight + !newCofG.north * !weight[!i]) / (!totalWeight + !weight[!i]))
        handle ANY
          -- It could be division by zero if user is asking, for example Weight of an empty branch
        endhandle
        !upTotal    = ((!upTotal    * !totalWeight + !newCofG.up    * !weight[!i]) / (!totalWeight + !weight[!i]))
        handle ANY
          -- It could be division by zero if user is asking, for example Weight of an empty branch
        endhandle
      endif

      -- Get the weight in a format for the form
      !weightString[!i] = !weight[!i].string(!!massFmt)
      -- Get the cofg in a format for the form
      !cofgString[!i] = !cofg[!i].string(!localDistanceFmt)
      !shipCofgString[!i] = !this.getShipPosition(!cofg[!i])
      -- Total up the new total weight
      !totalWeight = !totalWeight + !weight[!i]

    enddo

    if (!errors eq 1) then
       !!alert.error('The total Weight/CofG is unreliable because ' & !element.type & ' ' & !element.name & ' did not return a good Weight or CofG')
    elseif (!errors gt 1) then
      !!alert.error('The total Weight/CofG is unreliable because ' & !errors.string() & ' elements did not return a good Weight or CofG')
    elseif (!warnings ge 1) then
      if (!warnings eq 1) then
        !message = 'The total Weight/Cofg is unreliable because '  & !element.type & ' ' & !element.name & ' has geometric volume but no weight can be determined'
      elseif (!warnings gt 1) then
        !message = 'The total Weight/CofG is unreliable because ' & !errors.string() & ' has geometric volume but no weight can be determined'
      endif
      !formType = 'warning'
      !answer= true
      !!comAlertOnce(!message, !answer, '!!massCofG.hideWarnings', !formType)
    endif

    !!fmsys.setProgress(0)
    !listArray = object ARRAY()
    !realTest = 20kg
    !unitQualifier = !realTest.units().unitQualifier()
    do !j from 1 to !row
      !listArray[!j][1] = !type[!j]
      !listArray[!j][2] = !name[!j]
      !listArray[!j][3] = !weightString[!j].before(!unitQualifier)
      !listArray[!j][4] = '---'
      !listArray[!j][5] = !cofgString[!j]
      !listArray[!j][6] = '---'
      !listArray[!j][7] = !shipCofgString[!j]
      !listArray[!j][8] = !desc[!j]
      !listArray[!j][9] = !user[!j]
    enddo
    !this.headings[3] = 'Weight (' & !unitQualifier & ')'

    !this.dataGrid = object NETGRIDCONTROL()

    !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !listArray, false)
    !this.dataGrid.bindToDataSource(!netDataSource)

    -- Is it kilograms ?
    !this.txtTotalWeight.val  = !totalWeight.string(!!massFmt)

    !this.dataGrid.setColumnVisibility(3,TRUE)
  endif

  -- Make a position object to reflect the totalled CofG
  !finalCofG = object POSITION()
  !finalCofG.origin = !this.textWRT.val.dbref()
  !finalCofG.east   = !eastTotal
  !finalCofG.north  = !northTotal
  !finalCofG.up     = !upTotal

  -- Use the WRT gadget
  !finalCofG = !finalCofG.wrt(!this.textWRT.val.dbref())

  if (!this.shipPositions.val) then
    !finalString = !this.getShipPosition(!finalCofG)
  else
    !finalString = !finalCofG.string(!localDistanceFmt)
  endif
  !this.finalPosition = !finalCofG.string(!localDistanceFmt)
  !this.finalShipPosition = !this.getShipPosition(!finalCofG)

  !this.txtFinalCofG.val    = !finalString

  -- Navigate back to original location
  !!ce = !memory
  !this.dataGrid.allGridEvents(TRUE)

  -- Make mass columns visible
  !this.dataGrid.setColumnVisibility(3,true)
  !this.dataGrid.setColumnVisibility(4,FALSE)
  !this.dataGrid.setColumnVisibility(5,!this.shipPositions.val.not())
  !this.dataGrid.setColumnVisibility(6,FALSE)
  !this.dataGrid.setColumnVisibility(7,!this.shipPositions.val)
  !this.dataGrid.setColumnVisibility(8,TRUE)
  !this.dataGrid.setColumnVisibility(9,FALSE)

  --Draw Aid Axes at CoFG position
  !this.axes.position     = !finalCofG
  !this.axes.orientation  = Y is N wrt $!this.textWRT.val and Z is U wrt $!this.textWRT.val
  !this.axes.tag          = true
  !this.axes.description  = 'Centre of Gravity'
  !this.axes.detail       = true
  !this.axes.draw(!this.aidNumber)

  !!aidNumbers.remove(!this.aidNumberPosition)

  -- Colour the weight field
  !this.colourUserWeights()

  -- Align the array with Data Grid
  !this.elementsArray = ARRAY()
  !values = !this.dataGrid.getColumn(2)
  do !i indices !values
    !this.elementsArray[!i] = !values[!i].dbref().string()
  enddo

endmethod
--End of method definition  .calculate()
---------------------------------------------------------------------------
--
-- Method:      Enhance picked
--
-- Description: Enhance the elements picked via EDG
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhancePicked(!element is DBREF)

  -- If we have picked a primitive element navigate to higher level
  !addElement = !!dtbGetOwnerType(!element, 'EQUI')
  if (!addElement.unset()) then
    !addElement = !element
  endif

  !test = !!massCofG.collectionArray.findFirst(!addElement)
  if (!test.unset()) then
    !!massCofG.collectionArray.append(!addElement)
    enhance $!addElement colour $!!gphColOpt.highlight.code
  else
    !!massCofG.collectionArray.remove(!test)
    unenhance $!addElement
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      setMassLevel
--
-- Description:
--   Set the mass level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Keyword 'gadget' or 'current'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMassLevel(!option is STRING)

  if (!option.lowcase() eq 'current') then
    -- Use current representation mass level
  else
    -- Use the gadget setting
    !newLevel = (NINT($!this.massRepresentation.val))
    REPRE MASS $!newLevel
  endif
  var !level REPRE MASS
  !this.massRepresentation.val = !level

endmethod
-- End of method definition for .setMassLevel()
------------------------------------------------------------------------
--
-- Method:      validMassLevelInput
--
-- Description:
--   Validate input to mass level gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validMassLevelInput(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  endif
  !test = !gadget.val.real()
  handle ANY
    return error 1 'A valid number is required.'
  endhandle

  if (!gadget.val.real().gt(0) and !gadget.val.real().lt(100000)) then
    -- OK
  else
    return error 1 'A valid number is required.'
  endif

endmethod
-- End of method definition for .validMassLevelInput()
------------------------------------------------------------------------
--
-- Method:      areaNameCheck
--
-- Description: Validate input to area name gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .areaNameCheck(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.unset()) then
    -- This is not an error
    return
  endif
  !aName = !gadget.val.string().trim()
  if (!aName.length().eq(0)) then
    -- This is not an error
    return
  endif

  !test = !aName.dbref()
  handle ANY
    !aName = '/' & !aName
    !test = !aName.dbref()
     handle ANY
       return error 1 'The specified element does not exist.'
     endhandle
     !gadget.val = !aName
   endhandle

endmethod
-- End of method definition for .areaNameCheck()
