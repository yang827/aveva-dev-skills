--
-- Description:
--  Calculates Mass Property - Surface
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateSelectedElementsContextMenu(BOOLEAN) -
--  addAreaGadget()                  -                   Add Picked AREA element to string gadget by name
--  areaNameCheck(GADGET,STRING)     -                   Validate input to area name gadgets
--  calculate(STRING)                -                   Calculates the Surface
--  callCollect(STRING,BOOLEAN)      -                   Calls collect method to store elements to list
--  callPickArea()                   -                   Pick AREA element
--  clearGrid()                      -                   Clear the .Net grid
--  clearRow()                       -                   Clear row selection
--  close()                          -                   Close the form
--  collectElements(STRING)          -                   Collects elements for the argument supplied
--  enhanceColour()                  -                   Enhance the colour for collected elements
--  enhancePicked(DBREF)             -
--  fileName()                       STRING              Gets the file name
--  getValues(ARRAY)                 ARRAY               Gets the grid values
--  initialise()                     -                   Initialise the form
--  loadItems(STRING)                -                   Load elements into grid
--  massSurface()                    -                   Constructor
--  netMainCallback(ARRAY)           -                   main grid callback
--  netPopupMainCallback(ARRAY)      -                   Popup callback
--  pickAction()                     -                   Pick element action
--  pickElements(STRING)             -                   EDG to pick element for action
--  saveMain()                       -                   Saves the main grid
--  setMassLevel(STRING)             -                   Set the mass level
--  setWithinAreaActive(BOOLEAN)     -
--  unenhance(ARRAY)                 -                   Unenhance the elements
--  validMassLevelInput(GADGET,STRING) -                   Validate input to mass level gadgets
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

-- Icons
!refreshIcon = !!pml.getPathName('refresh16.png')
!pickIcon    = !!pml.getPathName('navigate16.png')

layout form !!massSurface dialog dock R
--setup form !!massSurface varchars dialog dock R

   using namespace 'Aveva.Pdms.Presentation'

   -- .Net control object
   member .dataGrid is NETGRIDCONTROL

  !this.formTitle     = 'Surface'
  !this.callback      = '!!massSurface.initialise()'
  !this.quitcall      = '!!massSurface.close()'
    hdist 0
    vdist 0
  frame .addFrame 'Add Elements' anchor t+l+r width 35
    option .loadType    '' anchor l+r+t width 20.8
    button .butloadType  'Add' tooltip 'Add Selected Elements' anchor t+r at xmax.loadType+.5 ymin width 8
    text .textName 'Named Element:' tagwid 11 anchor l+r+t at xmin.loadType ymax+.2 width 11.5 is STRING
    button .addNamedElementButton 'Add' tooltip 'Add Named Element' anchor t+r at xmin.butloadType ymin width 8
  exit

  -- Start of net grid frame
  frame .netGridFrame 'Selected Elements' at xmin form ymax anchor all width.addFrame height 1
    -- define PML Container to host my .Net control
    container .netFrame NOBOX PMLNetControl 'NET' dock fill
  exit
  -- End of net grid frame

  frame .settingsFrame 'Settings' at xmin ymax anchor l+r+b width.addFrame
    -- Net / Gross / Rough
    option .netGross       'Negatives:' anchor l+r+t  tagwid 10 width 20
    -- Include members weight or report weight of item ONLY
    option .membersOrOnly  'Surface Of:' anchor l+r+t at xmin ymax+.2 tagwid 10 width 20
    -- Mass representation level
    text .massRepresentation 'Representation Level:' tagwid 21 anchor l+r+t at xmin ymax+.1           width 9 is STRING
    button .refresh at xmax ymin pixmap "$!<refreshIcon>" anchor t+r width 16 height 16
    option .unitsOption  'Units:' tagwid 10 anchor l+r+t at xmin.massRepresentation ymax+.2 width 20
  exit

  -- Start of Inside/Outside frame
  frame .withinAreaFrame  'Within Area' at xmin ymax                  anchor l+r+b           width.addFrame
    -- Toggle to activate the within option
    toggle .activeWithin 'Use Within Area' anchor l+b at x11
    text .textAreaElement 'Area:'   at x1 ymax                  anchor l+r+t tagwid 10 width 20 is STRING
    button .pickArea                at xmax ymin                  anchor r+t   pixmap "$!<pickIcon>"  width 16 height 16
    option .insideOutside 'Option:' at x1 ymax+.2               anchor l+r+t tagwid 10 width 20
  exit
  -- End of Inside/Outside frame

  frame .calculateFrame 'Calculate Surface' at xmin ymax anchor l+r+b width.addFrame
    text .totalSurface 'Total Surface:' anchor l+r+b at xmin.insideOutside ymax  tagwid 10 width 22 is STRING
    button .butCalculate 'Apply' tooltip 'Calculate Surface' at xmax.totalSurface-9 ymax+.2 anchor r+b width 8
  exit

   menu .popmenumain
   !this.popmenumain.add( 'CALLBACK', 'Remove Selected Element(s)', '!this.clearRow()', 'REM' )
   !this.popmenumain.add( 'callback', 'Remove All Elements', '!this.clearGrid()', 'REMALL' )
   !this.popmenumain.add( 'SEPARATOR' )
   !this.popmenumain.add( 'CALLBACK', 'Enhance in 3D View', '!this.enhanceColour()', 'HIGHALL' )
   !this.popmenumain.add( 'CALLBACK', 'Unenhance in 3D View', '!this.unenhance(!!massSurface.elementsArray)', 'UNHIGHALL' )
   !this.popmenumain.add( 'toggle',   'Navigate To', '', 'NAVIGATE' )
   !this.popmenumain.add( 'SEPARATOR' )
   !this.popmenumain.add( 'CALLBACK', 'Export to Excel...', '!this.saveMain()', 'EXCEL' )
   !this.popmenumain.add( 'CALLBACK', 'Print Preview...', '!this.dataGrid.printpreview()', 'PRINT' )

  -- Form Members

  -- Elements listed in the Grid
  member .elementsArray       is ARRAY

  -- Elements collected in current list
  member .collectionArray     is ARRAY

  -- Area element that is identified
  member .areaElement         is ARRAY

  -- Grid details
  member .gridName            is STRING
  member .headings            is ARRAY
  member .rowElements         is ARRAY

  -- Axes definition
  member .axes                is GPHAXES

  -- Aid number being modified
  member .aidNumber           is REAL

  --edg pick Elements
  member .pickedElements      is ARRAY

  -- total surface
  member .totalSurfaceString  is STRING

  --append data or not
  member .append              is BOOLEAN

  -- Picked area element via EDG
  member .pickedAreaElement   is DBREF

exit
------------------------------------------------------------------------
--
-- Method:      massSurface
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .massSurface()

  -- Callbacks
  !this.refresh.callback      = |!this.setMassLevel('current')|
  !this.pickArea.callback     = |!this.callPickArea()|
  !this.butCalculate.callback = '!this.calculate(|MAIN|)'

  -- Tooltips
  !this.refresh.setTooltip('Refresh with Current Value')
  !this.pickArea.setTooltip('Pick an Area Definition Element')

  -- Set the cancel call and auto-scroll
  !this.cancelCall = '!this.close()'
  !this.autoscroll   = true

  !this.butloadType.callback   = '!this.callCollect(!this.loadType.selection(),TRUE)'

  -- Name gadget
  !this.textName.val = 'unset'
  !this.addNamedElementButton.callback = '!this.collectElements(|NAME|)'

  -- Make the Total Surface Area result gadget not editable
  !this.totalSurface.setEditable(FALSE)

  -- options for collection scope
  !scopeDtext = ARRAY()
  !scopeDtext.append('Current Element')
  !scopeDtext.append('Element Members')
  !scopeDtext.append('Members with Tubing')
  !scopeDtext.append('Current List')
  !scopeDtext.append('Graphical Pick')
  !scopeDtext.append('Graphical Selection')
  !scopeDtext.append('Within Area')
  !scopeDtext.append('Within Volume of CE')
  !this.loadType.dtext  = !scopeDtext

  -- options for collection scope
  !scopeRtext = ARRAY()
  !scopeRtext.append('CE')
  !scopeRtext.append('CEMEM')
  !scopeRtext.append('CEBRANMEM')
  !scopeRtext.append('LIST')
  !scopeRtext.append('GPHPICK')
  !scopeRtext.append('GPHSEL')
  !scopeRtext.append('AREA')
  !scopeRtext.append('VOLUME')
  !this.loadType.rtext  = !scopeRtext

  -- Options for net/Gross
  !netGrossDtext = ARRAY()
  !netGrossDtext.append('Consider (Net)')
  !netGrossDtext.append('Ignore (Gross)')
  !netGrossDtext.append('Ignore (Rough)')
  !this.netGross.dtext  = !netGrossDtext
  -- Options for net/Gross
  !netGrossRtext = ARRAY()
  !netGrossRtext.append('NET')
  !netGrossRtext.append('GROSS')
  !netGrossRtext.append('ROUGH')
  !this.netGross.rtext  = !netGrossRtext

  -- Options for members or only
  !membersOrOnlyDtext = ARRAY()
  !membersOrOnlyDtext.append('All Members')
  !membersOrOnlyDtext.append('Element Only')
  !this.membersOrOnly.dtext  = !membersOrOnlyDtext
  -- Options for members or only
  !membersOrOnlyRtext = ARRAY()
  !membersOrOnlyRtext.append('ALL')
  !membersOrOnlyRtext.append('ONLY')
  !this.membersOrOnly.rtext  = !membersOrOnlyRtext

  -- Mass representation level
  var !massLevel REPRE MASS
  !this.massRepresentation.val = !massLevel
  !this.massRepresentation.validatecall = '!this.validMassLevelInput('
  !this.massRepresentation.callback = |!this.setMassLevel('gadget')|

  -- Toggle for usage of Within frame
  !this.activeWithin.callback = '!this.setWithinAreaActive(!this.activeWithin.val)'
  !this.activeWithin.val = false
  !this.setWithinAreaActive(!this.activeWithin.val)

  -- Area Definition gadget
  !this.textAreaElement.val = 'unset'
  !this.textAreaElement.validatecall = '!this.areaNameCheck('

  -- Options for net/Gross
  !insideOutsideDtext = ARRAY()
  !insideOutsideDtext.append('Surface Inside')
  !insideOutsideDtext.append('Surface Outside')
  !this.insideOutside.dtext  = !insideOutsideDtext
  -- Options for net/Gross
  !insideOutsideRtext = ARRAY()
  !insideOutsideRtext.append('INSIDE')
  !insideOutsideRtext.append('OUTSIDE')
  !this.insideOutside.rtext  = !insideOutsideRtext
  -- Options for Units
  !unitsDtext = ARRAY()
  !unitsDtext.append('mm2')
  !unitsDtext.append('cm2')
  !unitsDtext.append('metre2')
  !unitsDtext.append('inch2')
  !unitsDtext.append('foot2')
  !this.unitsOption.dtext  = !unitsDtext
  -- Options for Units
  !unitsRtext = ARRAY()
  !unitsRtext.append('mm2')
  !unitsRtext.append('cm2')
  !unitsRtext.append('metre2')
  !unitsRtext.append('inch2')
  !unitsRtext.append('foot2')
  !this.unitsOption.rtext  = !unitsRtext

  -- Grid name
  !this.gridName = ' '

  --row Elements
  !this.rowElements = object ARRAY()

  -- append values
  !this.append  = true

  -- Clear all aid Elements
  AID CLEAR ALL

  -- Heading For list gadget
  !this.headings = ARRAY()
  !this.headings.append('Type')
  !this.headings.append('Name')
  !this.headings.append('Surface')
  !this.headings.append('Description')

  !this.aidNumber         = !!aidNumbers.add('Mass Surface')

  using namespace  'Aveva.Pdms.Presentation'
  -- create instance of .Net control
  !this.dataGrid = object NETGRIDCONTROL()

  !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !this.rowElements)
  !this.dataGrid.bindToDataSource(!netDataSource)

  !this.dataGrid.addEventHandler('OnPopup', !this, 'netPopupMainCallback')
  !this.dataGrid.addEventHandler('AfterSelectChange', !this, 'netMainCallback')

endmethod
-- End of method definition for .massSurface()

define method .setWithinAreaActive(!active is BOOLEAN)
  !this.textAreaElement.active = !active
  !this.pickArea.active = !active
  !this.insideOutside.active = !active
endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.clearGrid()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      callCollect
--
-- Description: Calls collect method to store elements to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .callCollect(!type is STRING, !add is BOOLEAN)

  --clear grid
  if !add.not() then
   !this.clearGrid()
  endif

  if(!type eq 'CE') then
      if (!!ce.type eq 'WORL') then
          !!alert.error('Cannot use from world level')
          return
      elseif (!!ce.type inset('SITE','BLOCK')) then
          !answer = !!alert.confirm('Are you sure you want to add ' & !!ce.type & '?')
          if (!answer eq 'NO') then
            return
          endif
      endif
      -- load CE object
      !this.collectElements(!type)
  elseif(!type eq 'CEMEM' or !type eq 'CEBRANMEM' ) then
      if (!!ce.type eq 'WORL') then
          !answer = !!alert.confirm('Are you sure you want to add from World level?')
          if (!answer eq 'NO') then
            return
          endif
      endif
      -- load CE members object
      !this.collectElements(!type)

  elseif(!type eq 'NAME') then

      -- load named object
      !this.collectElements(!type)

  elseif(!type eq 'LIST') then
      !form = !!cdcList
      !numb = !form.name.val
      !block = object BLOCK('!!cdlist' & !numb)
      if(!block.string().lowcase() eq '!!cdlist0' )  then
         !!alert.error('There is no List defined.')
         return
      elseif(undefined(!block.evaluate())) then
         !!alert.error('The current List is empty.')
         return
      endif

      !this.collectionArray = !block.evaluate()
      !this.collectionArray = !this.collectionArray.evaluate(object BLOCK('!this.collectionArray[!evalIndex].dbref()'))
      !this.collectElements(!type)

  elseif(!type eq 'GPHPICK') then
      -- Pick from graphics
      !this.pickElements('ALL')

  elseif(!type eq 'GPHSEL') then
      -- Collect elements from graphical selection
      !selectionArray = object SELECTION()
      -- Get current selection
      !selectionArray.getCurrent()
      !this.collectionArray = !selectionArray.getSelection()
      if(!this.collectionArray.set())then
      !this.collectElements('SELECTION')
      else
          !!alert.error('Select Elements from Graphics')
          return
      endif

  elseif(!type eq 'AREA') then
      !this.pickElements('AREADEF')

  elseif(!type eq 'VOLUME') then
      if (!!ce.type eq 'WORL') then
          !!alert.error('Unable to add within volume of type World.')
          return
      elseif (!!ce.type inset('SITE','BLOCK')) then
          !answer = !!alert.confirm('Are you sure you want to add elements in volume of ' & !!ce.type & '?')
          if (!answer eq 'NO') then
            return
          endif
      endif
      -- load CE object
      !this.collectElements(!type)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      loadItems
--
-- Description: Load elements into grid
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadItems(!grid is STRING)

   using namespace  'Aveva.Pdms.Presentation'
  !listArray  = object ARRAY()
  !memory = !!ce
  if(!this.elementsArray.set()) then
    !this.rowElements = !this.getValues(!this.elementsArray)
    !!ce = !memory
  else
    !this.rowElements = ARRAY()
  endif

  -- suppress grid events
  !this.dataGrid.allgridevents(FALSE)

  if !grid.eq('MAIN') then

   !this.dataGrid = object NETGRIDCONTROL()
   !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !this.rowElements)
   !this.dataGrid.bindToDataSource(!netDataSource)

   -- Initialise with zero
   !surface = 0 sq mm
   !this.totalSurface.val = !surface.queryString()

  endif

  --bring back grid events
  !this.dataGrid.allgridevents(TRUE)

  -- hide columns
  !this.dataGrid.setColumnVisibility(3,FALSE)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      clearGrid
--
-- Description: Clear the .Net grid
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearGrid()

  --disable the grid events so that clearGrid method works fine
  !this.dataGrid.allgridevents(FALSE)

  --clear the grid
  !this.dataGrid.clearGrid()

  --initialise row elements
  !this.rowElements = object ARRAY()

  using namespace  'Aveva.Pdms.Presentation'

  -- create instance of .Net control
  !this.dataGrid = object NETGRIDCONTROL()

  !elements  = ARRAY()
  !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !elements)
  !this.dataGrid.bindToDataSource(!netDataSource)

  !this.netFrame.control = !this.dataGrid.handle()

  !this.dataGrid.columnExcelFilter(true)
  !this.dataGrid.outlookGroupStyle(false)
  !this.dataGrid.fixedHeaders(true)
  !this.dataGrid.fixedRows(false)
  !this.dataGrid.gridHeight(100.0)
  !this.dataGrid.singleRowSelection(false)

  -- member List
  !elements  = ARRAY()

   -- Clear the result gadgets
   !this.totalSurface.val = ''

   -- Unenhance the elements in the list
   if(!this.elementsArray.set()) then
     do !i indices !this.elementsArray
       unenhance $!this.elementsArray[$!i]
       handle ANY
         -- In case that elements have been deleted from under our feet
       endhandle
     enddo
   endif

   -- Clear the elementsArray
   !this.elementsArray.clear()

   -- Remove the Axes
   if(!this.aidNumber.set()) then
      !!aidNumbers.remove(!this.aidNumber)
   endif

   --set back the grid events
   !this.dataGrid.allgridevents(TRUE)

   -- Make 3rd column invisible
   !this.dataGrid.setColumnVisibility(3,FALSE)

endmethod
-- End of method definition .clearGrid()
------------------------------------------------------------------------
--
-- Method:      collectElements
--
-- Description: Collects elements for the argument supplied
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .collectElements(!collectFrom is STRING)

  -- Initialise Variables
  !collectedElements = ARRAY()
  !listCollection    = ARRAY()

  -- Collect relevant types
  !collection = object COLLECTION()

  !expression = object EXPRESSION()
  !expression.expression('NOT(TYPE eq |TUBI| and ITLE lt 1)' )

  !collection.filter(!expression)

  -- collect for current element
  if(!collectFrom eq 'CE') then
    !collectedElements[1] = !!ce.string()

  elseif(!collectFrom eq 'VOLUME') then
     var !results collect all within volume ce
     !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].dbref().string()'))

  elseif(!collectFrom eq 'CEBRANMEM') then
    if ( !!ce.type eq 'BRAN' ) then
     var !results collect all bran mem for ce
     !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].dbref().string()'))
    else
     !results = !!ce.members
     !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].string()'))
    endif

  elseif(!collectFrom eq 'CEMEM') then
    if (!!ce.type eq 'ASMBLY') then
      !results = !!ce.sMembers
    else
      !results = !!ce.members
    endif
    !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].string()'))

  elseif(!collectFrom eq 'NAME') then
    !results = ARRAY()
    !element = !this.textName.val.dbref()
    handle ANY
      !!alert.error('The specified element does not exist.')
      return
    endhandle
    if (!element.badref()) then
      return
    endif
    if (!element.type eq 'WORL') then
        !!alert.error('An element of type World is not allowed.')
        return
    elseif (!element.type inset('SITE','BLOCK')) then
        !answer = !!alert.confirm('Are you sure you want to add ' & !element.type & '?')
        if (!answer eq 'NO') then
          return
        endif
    endif
    !results[1] = !element
    !collectedElements  = !results.evaluate(object BLOCK('!results[!evalIndex].string()'))

  elseif(!collectFrom eq 'LIST' or !collectFrom eq 'SELECTION') then

    !ce = !!ce
    do !col values !this.collectionArray
      if(!col.acttype.eq('TUBI') and !col.itle.lt(1)) then
        skip
      endif
      !listCollection.append(!col)
    enddo
    !collectedElements  = !listCollection.evaluate(object BLOCK('!listCollection[!evalIndex].string()'))
    !!ce = !ce

  elseif(!collectFrom.trim() eq 'AREADEF') then

     if(!!pickedAreaElement.unset()) then
       !!alert.error('Pick an Area element')
       return
     endif

     if(!!pickedAreaElement.type eq 'AREADE') then
       !areaDefElement  = !!pickedAreaElement
     elseif(!!pickedAreaElement.owner.type eq 'AREADE') then
       !areaDefElement  = !!pickedAreaElement.owner
     endif

     var !areaCollection collect ALL with (type neq 'AREADE') EXCL within volume $!areaDefElement
     !collectedElements = !areaCollection.evaluate(object BLOCK('!areaCollection[!evalIndex].dbref().string()'))
  endif

  -- The elements member may be empty or already have members
  -- So we always must add them
  !collectedElements.appendArray(!this.elementsArray)

  --Make the collection unique
  !collectedElements.unique()

  -- remove if owner is present in the list
  !removeIndices = object ARRAY()
  do !n indices !collectedElements
     !ownerList = !collectedElements[!n].dbref().ownlst
     handle ANY
       !removeIndices.append(!n)
       skip
     endhandle
     !ownerNames = !ownerList.evaluate(object BLOCK('!ownerList[!evalIndex].string()'))
     do !owner values !ownerNames
       if(!collectedElements.findFirst(!owner).set()) then
        !removeIndices.append(!n)
        break
        endif
     enddo
  enddo

  !removeIndices  = !removeIndices.invert()
  do !indx values !removeIndices
     !collectedElements.remove(!indx)
  enddo

  -- Make sure indexing is correct
  !this.elementsArray = !collectedElements.compress()

  -- Highlight collected Element
  !this.enhanceColour()

  !this.loadItems('MAIN')

endmethod
-- End of method definition .collectElements()
------------------------------------------------------------------------
--
-- Method:      enhanceColour
--
-- Description: Enhance the colour for collected elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhanceColour()

  -- Highlight collected Element
  do !n indices !this.elementsArray
    enhance $!this.elementsArray[$!n] col $!!gphColOpt.highlight.code
  enddo

endmethod
-- End of method definition .enhanceColour()
--------------------------------------------------------------------------
--
-- Method:      unenhance()
--
-- Description: Unenhance the elements
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unenhance(!elements is ARRAY)

  do !n indices !elements
    unenhance $!elements[$!n]
    handle ANY
      -- In case that elements have been deleted from under our feet
    endhandle
  enddo

  -- Remove the Axes
  if(!this.aidNumber.set()) then
     !!aidNumbers.remove(!this.aidNumber)
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------

-- Method:      close()
--
-- Description: Close the form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Unenhance all
  !this.unenhance(!this.elementsArray)

  !this.elementsArray   = object ARRAY()
  !this.collectionArray = object ARRAY()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:  netPopupMainCallback
--
-- Description: Popup callback
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupMainCallback(!a is ARRAY)

  !this.activateSelectedElementsContextMenu(!this.dataGrid.getRows().size() gt 0)

  !this.netFrame.popup = !this.popmenumain
  !this.netFrame.showPopup(!a[0], !a[1])

endmethod
--End of method definition

define method .activateSelectedElementsContextMenu(!active is BOOLEAN)
  !this.popmenumain.setFieldProperty('REM', 'active', !active )
  !this.popmenumain.setFieldProperty('REMALL', 'active', !active )
  !this.popmenumain.setFieldProperty('HIGHALL', 'active', !active )
  !this.popmenumain.setFieldProperty('UNHIGHALL', 'active', !active )
  !this.popmenumain.setFieldProperty('NAVIGATE', 'active', !active )
  !this.popmenumain.setFieldProperty('EXCEL', 'active', !active )
  !this.popmenumain.setFieldProperty('PRINT', 'active', !active )
endmethod

------------------------------------------------------------------------
--
-- Method:  netMainCallback
--
-- Description: main grid callback
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netMainCallback(!a is ARRAY)

  !row = !this.dataGrid.getSelectedRows()
  !element = !row[1][2].dbref()
  handle ANY
    return
  endhandle
  --Navigate if flagged
  !test = !this.netFrame.popup.selected('Navigate To')
  handle ANY
  elsehandle NONE
    if (!test.set() and !test) then
      !!ce = !element
    endif
  endhandle

  -- Tag the selected element with its Surface
  !aidNumber = !this.aidNumber
  !text = !row[1][3]
  if (!text.eq('0')) then
    !text = ''
  endif
  !text = !row[1][1] & ' ' & !text
  aid clear text $!aidNumber
  handle ANY
  endhandle
  !position = !element.position
  handle ANY
  endhandle
  aid text number $!aidNumber '$!text' at $!position
  handle ANY
  endhandle

endmethod
--End of method definition .netMainCallback()
---------------------------------------------------------------------------
--
-- Method:      pickElements
--
-- Description: EDG to pick element for action
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickElements(!pickElementType is STRING)

    --!this.collectionArray = object ARRAY()

    if(!pickElementType eq 'ALL') then

      !packet = object EDGPACKET()
      !packet.initialisation  = '!!massSurface.collectionArray = object ARRAY()'
      !packet.action = '!!massSurface.enhancePicked(!this.return[1].item)'
      !packet.elementPick('Pick elements and <Esc>')
      !packet.key      = 'Pick Elements'
      !packet.remove = false
      --!packet.pickPacket.picks[1].pick.input[3] = |'NOT (TYPE eq |TUBI| and ITLE lt 2)'|
      !packet.pickPacket.picks[1].pick.modifiable = FALSE

      !packet.close = '!!massSurface.pickAction()'

      !!edgCntrl.add(!packet)

    elseif(!pickElementType eq 'AREADEF') then

      !packet = object EDGPACKET()
      !packet.initialisation  = '!!pickedAreaElement = object DBREF()'
      !packet.action = '!!pickedAreaElement = !this.return[1].item'
      !packet.elementPick('Pick an Area element')
      !packet.description = 'Pick an Area element'
      !packet.key      = 'Pick Area Def'
      !packet.remove = true
      !packet.pickPacket.picks[1].pick.input[3]   = | type eq 'AREADE' or (type of own) eq 'AREADE' |
      !packet.pickPacket.picks[1].pick.modifiable = FALSE
      !packet.escape  = ''
      !packet.continue = '!!massSurface.collectElements(|AREADEF|)'

      !!edgCntrl.add(!packet)
    endif

endmethod
--End of method definition .pickElements()
---------------------------------------------------------------------------
--
-- Method:      pickAction
--
-- Description: Pick element action
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickAction()

 !this.collectElements(|LIST|)

endmethod
--End of method definition .pickAction()
---------------------------------------------------------------------------
--
-- Method:      clearRow
--
-- Description: Clear row selection
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearRow()

  !selectedRow  = !this.dataGrid.getSelectedRowTags()
  do !j indices !selectedRow
    unenhance $!this.elementsArray[$!selectedRow[$!j]]
    handle ANY
      -- In case that elements have been deleted from under our feet
    endhandle
    !this.elementsArray.deleteFrom(!selectedRow[!j].real(), 1)
  enddo
  --Reindex the elements Array
  !this.elementsArray.compress()

  !this.loadItems('MAIN')

  -- Remove the Axes
  if(!this.aidNumber.set()) then
    !!aidNumbers.remove(!this.aidNumber)
  endif

endmethod
--End of method definition .clearRow()
---------------------------------------------------------------------------
--
-- Method:      saveMain
--
-- Description: Saves the main grid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveMain()

 !fileName = !this.fileName()
 !!exportToExcel(!this.dataGrid, !fileName, |Save Surface Data As|)

 endmethod
--End of method definition
---------------------------------------------------------------------------
--
-- Method:      fileName
--
-- Description: Gets the file name
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fileName() is STRING

 !pdmsUser = !!evarSplit('PDMSUSER')
 !clock = object DATETIME()
 !time = !clock.string()
 !time = !time.replace(':','-')
 !fileName = !pdmsUser[1] & |\| & |Surface -| & !time & |.xls|
 return !fileName

endmethod
--End of method definition
---------------------------------------------------------------------------
--
-- Method:      getValues
--
-- Description: Gets the grid values
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getValues(!elementsArray is ARRAY) is ARRAY

  -- Initialise Variables
  !return           = object ARRAY()

  --Get all  collected element for calculation
  if(!elementsArray.unset()) then
     return !return
  endif

   -- Loop through all elements and get their surface from the relevant setting
  do !i indices !elementsArray
    !surfaceElement[!i] = !elementsArray[!i].dbref()
  enddo

  !unique   = !surfaceElement.unique()

  do !i indices !unique
    -- Record the weighed element
    -- Write all these values to an Array
    !return[!i][1] = !unique[!i].type
    if (!unique[!i].isnamed) then
      !return[!i][2] = !unique[!i].name
    else
      !return[!i][2] = !unique[!i].parnam
      handle ANY
        !return[!i][2] = !unique[!i].name
      elsehandle NONE
        if (!return[!i][2].unset() or !return[!i][2].length().eq(0)) then
          !return[!i][2] = !unique[!i].name
        else
          !unsedTest = !return[!i][2].dbref()
          handle ANY
            !return[!i][2] = !unique[!i].name
          endhandle
        endif
      endhandle
    endif
    !return[!i][3] = '0'
    !return[!i][4] = !unique[!i].description
    handle ANY
      !return[!i][4] = ''
    endhandle
  enddo

  return !return

endmethod
--End of method definition
---------------------------------------------------------------------------
--
-- Method:      calculate
--
-- Description: Calculates the Surface
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculate(!grid is STRING)

  !outputUnits  = !this.unitsOption.selection('rtext')
  if (!outputUnits eq 'inch2') then
    !temporaryUnits = 'inch'
  elseif (!outputUnits eq 'foot2') then
    !temporaryUnits = 'foot'
  elseif (!outputUnits eq 'mm2') then
    !temporaryUnits = 'mm'
  elseif (!outputUnits eq 'cm2') then
    !temporaryUnits = 'cm'
  else
    -- Must be Metres
    !temporaryUnits = 'metre'
  endif

  -- Mass Representation level
  !this.setMassLevel('gadget')

  !ce = !!ce
  !this.dataGrid.allgridevents(FALSE)

  using namespace  'Aveva.Pdms.Presentation'
  -- create instance of .Net control
  if !grid.eq('MAIN') then

    if(!this.elementsArray.unset()) then
      !!alert.error('There are no elements in the list to calculate.')
      return
    endif

    !row = !this.dataGrid.getRows().size()

    !type = !this.dataGrid.getColumn(1)
    !name = !this.dataGrid.getColumn(2)
    !desc = !this.dataGrid.getColumn(4)

    !total = 0
    !netGross = !this.netGross.selection()
    -- Test that the AREADE is set
    if (!this.activeWithin.val) then
      !areaElementType = !this.textAreaElement.val.dbref().type
      handle ANY
        !!alert.error('The Area element is not defined.')
        return
      elsehandle NONE
        if (!areaElementType neq 'AREADE') then
          !!alert.error('The Area element is not defined')
          return
        endif
      endhandle
      -- Get the inside, outside, free option
      !insideOutsideOption = !this.insideOutside.selection()
      !membersOrOnlyOption = !this.membersOrOnly.selection()
      -- Get the AREA element
      !areaElement = !this.textAreaElement.val.dbref()
      !arguments=object array()
      !arguments[1]=!insideOutsideOption
      !arguments[2]=!areaElement
      !arguments[3]=!membersOrOnlyOption
    else
      -- Get the inside, outside, free option  and Wet/Dry
      !membersOrOnlyOption = !this.membersOrOnly.selection()
      !arguments=object array()
      !arguments[1]=!membersOrOnlyOption
    endif

    do !i from 1 to !row
      !progress = (!i / !row) * 100
      !!fmsys.setProgress(!progress)
      !surface[!i] = 0
      !!ce = !this.dataGrid.getColumn(2)[!i].dbref()
      handle ANY
        !!alert.error('Could not Calculate! (Element has be deleted)')
        return
      endhandle
      if (!netGross eq 'NET') then
        !surfaceInArray = !!ce.attribute('nsrf',!arguments)
      elseif (!netGross eq 'GROSS') then
        !surfaceInArray = !!ce.attribute('gsrf',!arguments)
      else
        !surfaceInArray = !!ce.attribute('rsrf',!arguments)
      endif
      !surface[!i] = !surfaceInArray[1]
      handle ANY
        -- Why?
        !surface[!i] = 0
      endhandle

      !total = !total + !surface[!i]
    enddo
    !!fmsys.setProgress(0)
    !listArray = object ARRAY()

    -- Replace this code with FORMAT object when area format
    -- can be created with output units different to current distance units
    !localAreaFmt         = !!areaFmt
    !localAreaFmt.units   = !temporaryUnits
    if (!temporaryUnits eq 'mm') then
      !localAreaFmt.dp    = 0
      !localAreaFmt.label = ' sq mm'
    elseif (!temporaryUnits eq 'cm') then
      !localAreaFmt.dp    = 2
      !localAreaFmt.label = ' sq cm'
    elseif (!temporaryUnits eq 'metre') then
      !localAreaFmt.dp    = 3
      !localAreaFmt.label = ' sq metre'
    elseif (!temporaryUnits eq 'inch') then
      !localAreaFmt.dp    = 0
      !localAreaFmt.label = ' sq inch'
    elseif (!temporaryUnits eq 'foot') then
      !localAreaFmt.dp    = 2
      !localAreaFmt.label = ' sq feet'
    else
      -- should not get to here, but default to mm
      !localAreaFmt.dp    = 0
      !localAreaFmt.label = ' sq mm'
      !localAreaFmt.units = 'mm'
    endif

    do !j from 1 to !row
      !listArray[!j][1] = !type[!j]
      !listArray[!j][2] = !name[!j]
      !listArray[!j][3] = !surface[!j].string(!localAreaFmt)
      !listArray[!j][4] = !desc[!j]
    enddo

    !this.dataGrid = object NETGRIDCONTROL()

    !netDataSource = object NETDATASOURCE(!this.gridName, !this.headings, !listArray)
    !this.dataGrid.bindToDataSource(!netDataSource)
    !this.totalSurface.val  = !total.string(!localAreaFmt)
    !this.dataGrid.setColumnVisibility(3,TRUE)
  endif

  !!ce = !ce
  !this.dataGrid.allgridevents(TRUE)

  -- Align the array with Data Grid
  !this.elementsArray = ARRAY()
  !values = !this.dataGrid.getColumn(2)
  do !i indices !values
    !this.elementsArray[!i] = !values[!i].dbref().string()
  enddo

endmethod
--End of method definition
---------------------------------------------------------------------------
--
-- Method:      Enhance picked
--
-- Description: Enhance the elements picked via EDG
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhancePicked(!element is DBREF)

  -- If we have picked a primitive element navigate to higher level
  !addElement = !!dtbGetOwnerType(!element, 'EQUI STRU')
  if (!addElement.unset()) then
    !addElement = !element
  endif

  !test = !!massSurface.collectionArray.findFirst(!addElement)
  if (!test.unset()) then
    !!massSurface.collectionArray.append(!addElement)
    enhance $!addElement colour $!!gphColOpt.highlight.code
  else
    !!massSurface.collectionArray.remove(!test)
    unenhance $!addElement
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method:      setMassLevel
--
-- Description: Set the mass level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Keyword 'gadget' or 'current'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMassLevel(!option is STRING)

  if (!option.lowcase() eq 'current') then
    -- Use current representation mass level
  else
    -- Use the gadget setting
    !newLevel = (NINT($!this.massRepresentation.val))
    REPRE MASS $!newLevel
  endif
  var !level REPRE MASS
  !this.massRepresentation.val = !level

endmethod
-- End of method definition for .setMassLevel()
------------------------------------------------------------------------
--
-- Method:      validMassLevelInput
--
-- Description: Validate input to mass level gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validMassLevelInput(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  endif
  !test = !gadget.val.real()
  handle ANY
    return error 1 'A valid number is required.'
  endhandle

  if (!gadget.val.real().gt(0) and !gadget.val.real().lt(100000)) then
    -- OK
  else
    return error 1 'A valid number is required.'
  endif

endmethod
-- End of method definition for .validMassLevelInput()
------------------------------------------------------------------------
--
-- Method:      areaNameCheck
--
-- Description: Validate input to area name gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .areaNameCheck(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.unset()) then
    -- This is not an error
    return
  endif
  if (!gadget.val.string().trim().length().eq(0)) then
    -- This is not an error
    return
  endif

  !test = !gadget.val.dbref()
  handle ANY
    return error 1 'The specified element does not exist.'
  endhandle

  -- This bit is only for the Area gadget
  if (!gadget eq !this.textAreaElement) then
    if (!gadget.val.dbref().type eq 'AREADE') then
      -- OK
    else
      return error 1 'Database AREADE element name required.'
    endif
  endif

endmethod
-- End of method definition for .areaNameCheck()
------------------------------------------------------------------------
--
-- Method:      callPickArea
--
-- Description: Pick AREA element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .callPickArea()

  !packet = object EDGPACKET()
  !packet.initialisation  = '!!massSurface.pickedAreaElement = object DBREF()'
  !packet.action = '!!massSurface.pickedAreaElement = !!dtbGetOwnerType(!this.return[1].item , |AREADE|)'
  !packet.elementPick('Pick an Area element')
  !packet.description = 'Pick an Area element'
  !packet.key      = 'Pick Area element'
  !packet.remove = true
  !packet.pickPacket.picks[1].pick.input[3]   = |type eq 'AREADE' or (type of owner) eq 'AREADE'|
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !packet.escape  = ''
  !packet.continue = '!!massSurface.addAreaGadget()'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .callPickArea()
------------------------------------------------------------------------
--
-- Method:      addAreaGadget
--
-- Description: Add Picked AREA element to string gadget by name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addAreaGadget()

  !this.textAreaElement.val = !this.pickedAreaElement.flnm
  handle ANY
    -- in case replacing EDG gives error
  endhandle

endmethod
-- End of method definition for .addAreaGadget()
