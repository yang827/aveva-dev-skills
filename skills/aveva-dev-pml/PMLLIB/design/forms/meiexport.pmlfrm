-- Created:         Mon Feb 06.12.2011
--
-- Description: Output to STEP. By Element or by search result
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  browser()                        -                   Browse method
--  cancel()                         -                   cancel callback
--  clearList()                      -                   clear list
--  drawlist()                       -                   get drawlist
--  goto()                           -                   navigate to selected element
--  graphicalSelection()             -                   Get current graphical selection
--  highlight(BOOLEAN)               -                   Control highlight of selected items
--  highlight(BOOLEAN,ARRAY)         -                   Control highlight of given items
--  init()                           -                   Init method
--  list()                           -                   Select List
--  meiExport()                      -                   Constructor
--  ok()                             -                   OK callback outputs Step file
--  populateList()                   -                   update element list
--  removeSelected()                 -                   Remove selected from list
--  selectCurrentElement()           -                   Select current element
--  selectCurrentElementMembers()    -                   Select current elements members
--  zoom()                           -                   zoom to selected item
--
layout form !!meiExport dialog docking

  -- Selection from User
  frame .frameList 'Element List' at xmin ymin anchor all
    button .ce        'CE'               at x1           ymax      width 10
    path right
    hdist 0.25
    button .mem       'CE MEM'           width 10
    button .dList     'Drawlist'         width 10
    button .sele      'Selection'        width 10
    button .list      'List'             width 12
    list   .eleList                      at x1           ymax+.2   anchor all  multiple columns width 64 height 13
    button .clear     'Clear All'        at xmin.eleList ymax+.2   anchor b+l width 12
    button .rem       'Clear Selection'                            anchor b+l width 12
    text   .listCount 'Element Count:'   at xmax.rem+22  ymin      anchor b+r tagwidth 11  width 6 is REAL
  exit

  -- Output options
  frame .frameOutput 'Output' at xmin.frameList ymax.frameList anchor b+l+r width.frameList
    text   .outfile           at x1          ymax        anchor b+l+r width 62 is STRING
    button .browse  'Browse'  at xmax+.5     ymin pixmap anchor b+r   width 16 height 16
  exit

  -- OK and cancel
  button .ok         'OK'     at xmax form-18 ymax.frameOutput+.2 anchor b+r width 8 ok
  button .cancel     'Cancel' at xmax.ok+.25  ymin                anchor b+r width 8 cancel

   member .elements       is ARRAY
   -- manage enhanced item list
   member .enhanced       is COMENHANCE

exit
------------------------------------------------------------------------
--
-- Method:      .meiExport()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .meiExport()

  !this.formtitle  = 'MEI Export'
  !this.initcall   = '!this.init()'
  !this.okcall     = '!this.ok()'
  !this.cancelcall = '!this.cancel()'

  -- Callbacks
  !this.clear.callback  = '!this.clearList()'
  !this.rem.callback    = '!this.removeSelected()'
  !this.ce.callback     = '!this.selectCurrentElement()'
  !this.mem.callback    = '!this.selectCurrentElementMembers()'
  !this.list.callback   = '!this.list()'
  !this.sele.callback   = '!this.graphicalSelection()'
  !this.dList.callback  = '!this.drawlist()'
  !this.browse.callback = '!this.browser()'
  !this.ok.callback     = '!this.ok()'

  -- Tooltips
  !this.clear.setToolTip('Clear the list')
  !this.rem.setToolTip('Remove selected element')
  !this.ce.setToolTip('Add current element')
  !this.mem.setToolTip('Add current elements members')
  !this.list.setToolTip('Add current list')
  !this.sele.setToolTip('Add graphically selected elements')
  !this.dList.setToolTip('Add drawlist')
  !this.browse.setToolTip('Browse...')

  -- Pixmap
  !this.browse.addPixmap(!!pml.getPathName('ad_t_012.png'))

  -- Set text field inactive
  !this.listCount.active    = FALSE

  -- List heading
  !header = ARRAY()
  !header.append('TYPE')
  !header.append('NAME')
  !this.eleList.setheadings(!header)

  -- Right click in List
  !menu   =   !this.newMenu('displayOptions')
  !menu.add('callback','Navigate to','!this.goto()')
  !menu.add('callback','Zoom to','!this.zoom()')
  !menu.add('callback','Highlight','!this.highlight(true)')
  !menu.add('callback','Clear highlight','!this.highlight(false)')
  !this.eleList.setPopup(!menu)

  -- default step file
  !folders = !!evarSplit('PDMSUSER')
  !this.outfile.val = !folders[1] + '\ExportedModels\meioutput.stp'

endmethod
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Init method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !this.clearList()

endmethod
------------------------------------------------------------------------
--
-- Method:      .browser()
--
-- Description: Browse method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser()

  -- File select
  !folders = !!evarSplit('PDMSUSER')
  !!filebrowser(!folders[1],'*.stp','Select File',false,'')

  -- Filename in Form
  !this.outfile.val = !!filebrowser.file.string()

endmethod
------------------------------------------------------------------------
--
-- Method:      .selectCurrentElement()
--
-- Description: Select current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectCurrentElement()

  !this.elements.append(!!ce)
  !this.populateList()

endmethod
------------------------------------------------------------------------
--
-- Method:      .selectCurrentElementMembers()
--
-- Description: Select current elements members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectCurrentElementMembers()

  !this.elements.appendArray(!!ce.members)
  !this.populateList()

endmethod
------------------------------------------------------------------------
--
-- Method:      .list()
--
-- Description: Select List
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .list()

  !list = !!lstCurrentList()
  if (!list.empty()) then
    !!alert.message('No current list selected')
  else
    do !item values !list
      !itemRef = !item.dbref()
      handle any
        skip
      endhandle
      !this.elements.append(!itemRef)
    enddo
    !this.populateList()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .graphicalSelection()
--
-- Description: Get current graphical selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphicalSelection()

  !selection = object SELECTION()
  !selection.getCurrent()
    -- Populate list from graphical selection
  !list      = !selection.getSelection()

  if (!list.empty()) then
    return
  else
    !this.elements.appendArray(!list)
    !this.populateList()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .drawlist()
--
-- Description: get drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawlist()

  -- get drawlist for current view
  !fmSystem   = object FMSYS()
  !form      = !fmSystem.currentDocument()
  !drawlist  = !!gphDrawlists.drawlist(!form.view)
  !list      = !drawlist.members()

  -- append drawlist string references
  if (!list.empty()) then
    return
  else
    !this.elements.appendArray(!list)
    !this.populateList()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .removeSelected()
--
-- Description: Remove selected from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeSelected()

  !seleList = !this.eleList.selection()

  do !x val !seleList
    !index  = !this.elements.findFirst(!x.dbref())
    skip if(!index.unset())
    !this.elements.remove(!index)
  enddo

  !this.highlight(false,!seleList)

  !this.populateList()

endmethod
------------------------------------------------------------------------
--
-- Method:      .clearList()
--
-- Description: clear list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearList()

  !this.elements.clear()
  !this.eleList.clear()
  !this.enhanced.clear()

  !this.listCount.val = 0

endmethod
------------------------------------------------------------------------
--
-- Method:      .populateList()
--
-- Description: update element list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateList()

  !dtext = ARRAY()
  !rtext = ARRAY()

  -- delete duplicate elements
  !this.elements.unique()

  do !i indices !this.elements
     !dtext[!i][1] = !this.elements[!i].type
     !dtext[!i][2] = !this.elements[!i].fullname
     !rtext[!i]    = !this.elements[!i].string()
  enddo

  !this.eleList.setrows(!dtext)
  !this.eleList.rtext = !rtext

  !this.listCount.val = !this.eleList.count

endmethod
------------------------------------------------------------------------
--
-- Method:      .goto()
--
-- Description: navigate to selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goto()

  !goto    = !this.eleList.rtext[!this.eleList.pickedfield]
  handle any
    return
  endhandle
  !gotoRef = !goto.dbref()
  handle any
    return
  endhandle
  !!ce = !gotoRef

endmethod
------------------------------------------------------------------------
--
-- Method:      .zoom()
--
-- Description: zoom to selected item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .zoom()

  !zoom    = !this.eleList.rtext[!this.eleList.pickedfield]
  handle any
    return
  endhandle
  !zoomRef = !zoom.dbref()
  handle any
    return
  endhandle

  --Set the limits
  !fmSystem = object FMSYS()
  !form     = !fmSystem.currentDocument()
  !!gphViews.limits(!form.view,!zoomRef)
  !drawlist = !!gphDrawlists.drawlist(!form.view)
  !drawlist.add(!zoomRef)
  handle any
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      .highlight()
--
-- Description: Control highlight of selected items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true to highlight - false to unhighlight
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight(!on is BOOLEAN)

  !selection = !this.eleList.selection()
  !this.highlight(!on, !selection)

endmethod
------------------------------------------------------------------------
--
-- Method:      .highlight()
--
-- Description: Control highlight of given items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true to highlight - false to unhighlight
--    2   R      ARRAY       array of string references
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight(!on is BOOLEAN, !list is ARRAY)

  if( !list.empty() ) then
    return
  endif

  do !item values !list
    !itemRef = !item.dbref()
    handle any
      skip
    endhandle
    if( !on ) then
      !this.enhanced.addItem(!itemRef)
    else
      !this.enhanced.removeItem(!itemRef)
    endif
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: OK callback outputs Step file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ok()

  if (!this.outfile.val eq '') then
    !!alert.error(|Output is empty|)
    return
  endif

  -- get holes setting
  !localRepresentation = !!gphRepOpt.localCopy()
  !holes               = !localRepresentation.holes()
  if( !holes ) then
    !holeSetting = 'on'
  else
    !holeSetting = 'off'
  endif
  !holeCommand   = 'export holes ' + !holeSetting

  !exportCommands = ARRAY()

  -- write the file content
  !exportCommands.append('export system /explantmcad')
  !exportCommands.append('export file "' + '$!this.outfile.val"' + ' over')
  !exportCommands.append(!holeCommand)
  do !x indices !this.elements
     !exportCommands.append('export ' + !this.elements[!x].string())
  enddo
  !exportCommands.append('export finish')

  do !command values !exportCommands
    !!command(!command)
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: cancel callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  !this.enhanced.clear()

endmethod
