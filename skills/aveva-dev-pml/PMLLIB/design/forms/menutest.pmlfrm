--
--
-- Description:
-- Display position in grid system coords
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addEntry(STRING,STRING)          -                   Store menu entry and command
--  initialise()                     -                   Initialise form
--  menutest()                       -                   Constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!menutest resize

  !!menutest.formTitle     = 'Menutest'
  !!menutest.iconTitle     = 'Menutest'
  !!menutest.formRevision  = ' $Revision: 1.0 $ '

  bar
  exit

  -- List of callbacks
  list .menuComms anchor all width 64 height 24

  -- Buttons
  button .close 'Close' anchor bottom+right at xmax form-size ymax+0.2 ok

  -- Members
  member .entries  is ARRAY
  member .commands is ARRAY

exit
-- End of form definition for !!menutest

------------------------------------------------------------------------
--
-- Method:      menutest
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .menutest()

  -- Populate menu strings
  !this.initialise()

  -- Bar menu
  !this.bar.add(|Test|, |testMenu|)
  !menu = !this.newMenu(|testMenu|)
  do !i indices !this.entries
    !menu.add(|CALLBACK|, !this.entries[!i], !this.commands[!i])
  enddo

  -- Columns
  !headings = ARRAY()
  !headings[1] = 'Menu Entry'
  !headings[2] = 'Menu Command'
  !this.menuComms.setHeadings(!headings)

endmethod
-- End of method definition for .menutest()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set up commands
  !this.entries.clear()
  !this.commands.clear()

  !this.addEntry('Save Work',                               |CALLG MSAVEW|)
  !this.addEntry('Get Work',                                |GETWORK|)
  !this.addEntry('Extract Control...',                      |call !!admExtractCntrl()|)
  !this.addEntry('Session Comment...',                      |show !!msgsavework|)
  !this.addEntry('Modules Monitor...',                      |$m "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<Monitor$> $<$> $<TRUE$>|)
  !this.addEntry('Modules Spooler Restore Views...',        |$m "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<Spooler$> $<TRUE$> $<TRUE$>|)
  !this.addEntry('Modules Spooler Default...',              |$m "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<Spooler$> $<FALSE$> $<TRUE$>|)
  !this.addEntry('Exit',                                    |CALLIB XEXIT|)
  !this.addEntry('Graphical View',                          |!!gphViews.addDesign()|)
  !this.addEntry('View Control...',                         |show !!gphControl|)
  !this.addEntry('Plot View...',                            |show !!plotView|)
  !this.addEntry('Design Explorer (core toggle)',           ||)
  !this.addEntry('Draw List (core toggle)',                 ||)
  !this.addEntry('My Data (core toggle)',                   ||)
  !this.addEntry('Reference List (core toggle)',            ||)
  !this.addEntry('Members...',                              |CALLIB UFORMS MEMB _CDCMEMBER FREE|)
  !this.addEntry('Advanced Members...',                     |CALLIB UFORMS MEMB _CDCADVMEMBER FREE|)
  !this.addEntry('Command Window...',                       |show _cadcBth free|)
  !this.addEntry('Query General...',                        |CALLIBQ XATTFORM _CDGENQ FREE|)
  !this.addEntry('Query Attributes...',                     |!!attributesTracking()|)
  !this.addEntry('Query Properties...',                     |!!comProp(!!ce, 'QUERY')|)
  !this.addEntry('Query Project...',                        |show !!qryProject|)
  !this.addEntry('Query User Status...',                    |show !!userStatus|)
  !this.addEntry('Query Data Access Control...',            |show !!qrydac|)
  !this.addEntry('Query DB Changes...',                     |call !!displayOutput('Change')|)
  !this.addEntry('Query Axes...',                           |!!gphViews.tag('AXES')|)
  !this.addEntry('Settings Graphics...',                    |show !!gphsettings free|)
  !this.addEntry('Settings Clasher Auto Clash (toggle)',    |CALLCL XMENUAUTO|)
  !this.addEntry('Settings Clasher Defaults...',            |show !!cdcladef|)
  !this.addEntry('Settings Clasher Obstruction List...',    |CALLIB UFORMS MEMB _CDCLAOBS|)
  !this.addEntry('Settings Clasher Obstruction Limits...',  |show !!cdclalim|)
  !this.addEntry('Settings Properties...',                  |!!comPropOpt.edit()|)
  !this.addEntry('Settings Explorer...',                    ||)
  !this.addEntry('Settings Reset Window Layout',            ||)
  !this.addEntry('Utilities Clashes...',                    |CALLCL MSHOWCLA|)
  !this.addEntry('Utilities Ship Reference Grids...',       |show !!shipReferenceGrids|)
  !this.addEntry('Utilities Aid CE Arrow...',               |show !!aidCeArrow|)
  !this.addEntry('Utilities Lists...',                      |CALLIB SHOWFORM _CDCLIST|)
  !this.addEntry('Utilities Claimlists...',                 |show !!lstClaim|)
  !this.addEntry('Utilities DB Listing...',                 |call !!displayOutput('Datal')|)
  !this.addEntry('Utilities Transactions...',               |show !!glbTransactions|)
  !this.addEntry('Modify Attributes...',                    |CALLIBQ INIT
  show _CDCATTDEF|)
  !this.addEntry('Modify Attributes Global...',             |CALLIBQ INIT
  show _CDCATTGLOB|)
  !this.addEntry('Delete CE',    |!!deleteCE()|)

  -- Rows
  !rows = ARRAY()
  do !i indices !this.entries
    !rows[!i] = ARRAY()
    !rows[!i][1] = !this.entries[!i]
    !rows[!i][2] = !this.commands[!i]
  enddo
  !this.menuComms.setRows(!rows)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      addEntry
--
-- Description: Store menu entry and command
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addEntry(!entry is STRING, !command is STRING)

  -- Store data
  !this.entries.append(!entry)
  !this.commands.append(!command)

endmethod
-- End of method definition for .addEntry()
