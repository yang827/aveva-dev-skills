------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  InitForm()                       -
--  callFunc()                       -
--  onCall()                         -
--  onMethodSelChanged(GADGET,STRING) -
--  onObjectUpdate()                 -
--  parseFuncProto(STRING)           -
--  populateList(gadget)             -
--  setParamCtrlType(real,STRING)    -
--  showParamCtrls(real,real,BOOLEAN) -
--  updateParam(REAL,GADGET)         -
--  updateParamCtrls()               -
--  updateParamsList()               -
--
setup form !!objectstest dialog

  path right
  !!objectstest.formTitle  =  'Cableway branch manager object test'
  !!objectstest.Initcall   =  '!this.InitForm()'


  path right
  frame .frame1 at XMIN FORM
  path right
  button .ce1 callback '!this.updateParam(1,!this.ce1Text)' |CE|
  text   .ce1Text ' ' width 8 is STRING
  exit


  frame .frame2
  path right
  button .ce2 callback '!this.updateParam(1,!this.ce2Text)' |CE|
  text   .ce2Text ' ' width 8 is STRING
  exit

  frame .frame3
  path right
  button .ce3 callback '!this.updateParam(1,!this.ce3Text)' |CE|
  text   .ce3Text ' ' width 8 is STRING
  exit

  frame .frame4
  path right
  button .ce4 callback '!this.updateParam(1,!this.ce4Text)' |CE|
  text   .ce4Text ' ' width 8 is STRING
  exit

  frame .frame5
  path right
  button .ce5 callback '!this.updateParam(1,!this.ce5Text)' |CE|
  text   .ce5Text ' ' width 8 is STRING
  exit

  path down

  list   .availMethods at XMIN .ce1 YMAX .frame1 'Methods' callback '!this.onMethodSelChanged(' columns width 95 length 30

  button .callButton callback '!this.onCall()' |Call!|
  path right
  text            .objectName 'Object name: ' width 20 is STRING
  button          .objectUpdate      callback '!this.onObjectUpdate()' |Update|

  path down
  button .dismiss at XMIN .callButton |  OK  | ok

  member .params      is ARRAY
  member .paramsType  is ARRAY
  member .funcName    is STRING

  member .paramCtrls      is ARRAY
  member .paramCEButtons  is ARRAY
  --member .numParam is REAL

exit

define method .updateParam(!index is REAL, !text is GADGET)
  !this.params[!index] = object STRING(!!ce.RefNo)
  !text.val = !!ce.RefNo.String()
endmethod

define method .updateParamsList()
  !this.params.clear()
  do !i indices !this.paramsType
    !cmd = '!!objectstest.params.Append(!!objectstest.ce' + !i.String() + 'Text.Val)'
    !cmd.Block().Evaluate()

    --!this.params[!i] = !val
  enddo
endmethod

define method .InitForm()

  --!this.manager = object CABLEWAYBRANCHMANAGER()
  !this.paramCtrls.Clear()
  !this.paramCtrls[1] = !this.frame1
  !this.paramCtrls[2] = !this.frame2
  !this.paramCtrls[3] = !this.frame3
  !this.paramCtrls[4] = !this.frame4
  !this.paramCtrls[5] = !this.frame5

  !this.paramCEButtons.Clear()
  !this.paramCEButtons[1] = !this.ce1
  !this.paramCEButtons[2] = !this.ce2
  !this.paramCEButtons[3] = !this.ce3
  !this.paramCEButtons[4] = !this.ce4
  !this.paramCEButtons[5] = !this.ce5

  !this.showParamCtrls(1,5, FALSE)
  !this.objectName.Val = 'CABLEWAYBRANCHMANAGER'
  !this.onObjectUpdate()
endmethod

define method .showParamCtrls(!s is real, !c is real, !show is BOOLEAN)
  do !i indices !this.paramCtrls
  if !i ge !s and !i lt !s + !c then
    !this.paramCtrls[!i].Visible = !show
  endif
  enddo
endmethod

define method .setParamCtrlType(!index is real, !type is STRING)
  if !type.Match('DBREF') neq 0 then
    !this.paramCEButtons[!index].Visible = TRUE
  elseif !type.Match('POSITION') neq 0 then
    !this.paramCEButtons[!index].Visible = FALSE
  elseif !type.Match('REAL') neq 0 then
    !this.paramCEButtons[!index].Visible = FALSE
  endif
endmethod

define method .updateParamCtrls()
  !this.showParamCtrls(1, !this.paramCtrls.Size(), FALSE)
  !this.showParamCtrls(1, !this.paramsType.size(), TRUE)
  do !i indices !this.paramsType
      !this.setParamCtrlType(!i, !this.paramsType[!i])
  enddo
endmethod

endmethod
define method .parseFuncProto(!proto is STRING)
   !del = '()'
  !this.funcName = !proto.Part(1, !del)
  !str = !proto.Part(2, !del)
  !this.paramsType = !str.Split(',)')

  !tmp = !this.paramsType[!this.paramsType.size()]

  !this.paramsType[!this.paramsType.size()] =  !tmp.Substring(0, !tmp.Length() )
   --q var !this.paramsType

--  do !p values !params
  --  !this.paramsType.Append(!p)
 --  enddo

endmethod

define method .populateList(!list is gadget)
--, !obj is object)
  !list.Clear()
  !cmd = 'object ' + !this.objectName.Val + '()'

  !obj = !cmd.Block().Evaluate()
  !a = !obj.methods()
  do !item values !a
    !list.Add(!item)
  enddo
endmethod

define method .onCall()
  !this.parseFuncProto(!this.availMethods.Selection())
  !this.updateParamsList()
  !this.callFunc()
endmethod

define method .callFunc()
--callFunc(name is STRING, !dbrefs is ARRAY)
  !cmd = 'object ' + !this.objectName.Val + '()'
  !obj = !cmd.Block().Evaluate()
  !cmd = '!obj.' + !this.funcName + '('

    !i = 1
    do
      break if !i gt !this.params.Size()

      if !this.params.Indices().Find(!i).Size() eq 0 then
        !!alert.Error('Please specify the parameter.' + STRING(!i))
        return
      endif

      if !this.paramsType[!i].Match('DBREF') neq 0 then
        !cmd = !cmd + !this.params[!i]

      elseif !this.paramsType[!i].Match('POSITION') neq 0 then
        !cmd = !cmd + !this.params[!i]
       elseif !this.paramsType[!i].Match('REAL') neq 0 then
        !cmd = !cmd + !this.params[!i]
      endif

      --E 20 S 30 U 40


      if !i neq !this.params.Size() then
        !cmd = !cmd + ','
      else
        !cmd = !cmd + ')'
      endif
    !i = !i + 1
    enddo
    q var !cmd.Block().Evaluate()

endmethod

define method .onMethodSelChanged(!g is GADGET, !action is STRING)
  if(!action eq |SELECT|) then
    !this.parseFuncProto(!this.availMethods.Selection())
    !this.updateParamCtrls()
  endif
endmethod

define method .onObjectUpdate()
  !this.populateList(!this.availMethods)
endmethod
