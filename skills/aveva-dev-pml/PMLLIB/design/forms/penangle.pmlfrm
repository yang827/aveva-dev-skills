--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Mar 23 19:25:13 WAT 1998
--
--
-- Description:
-- Angle a penetration.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  dismiss()                        -
--  draw()                           -
--  initialise()                     -
--  setAngle()                       -
--  setAngle(STRING)                 -
--
------------------------------------------------------------------------

setup form !!penAngle

  !!penAngle.formTitle     = 'Set Angled'
  !!penAngle.iconTitle     = 'AngPen'
  !!penAngle.callback      = ''
  !!penAngle.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

  button .ce 'CE'  callback '!this.initialise()'
  para .ceName at xmax+1 ymin  width 20 lines 1

  -- Set angle
  rgroup .setAngle 'Direction' at xmin_ce ymax callback '!this.setAngle()' frame vertical
    add tag ' Normal to surface'    select 'NORMAL'
    add tag ' Align with attached'  select 'ALIGN'
    add tag ' Specify direction'    select 'SPECIFIED'
  exit

  -- Direction
  path down
  halign right
  text .direction 'Direction ' callback '!this.setAngle()' width 12 is DIRECTION

  -- Apply/Dismiss
  button .apply   'Apply'    at xmin form-0    ymax form+0.25 callback '!this.apply()' apply
  button .dismiss 'Dismiss' at xmax form-size ymin callback '!this.dismiss()' OK

  -- Members
  member .aidNumber      is REAL

  -- Current direction/position
  member .pointVector    is POINTVECTOR

  -- Penetration item
  member .item           is DBREF

  -- Panel Direction
  member .panelDirection is DIRECTION

exit
-- End of form definition for !!penAngle

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Make sure we are at a sub fitting
  -- (AK) the CE is not what should be used here, but the penetration in the list
  !penForm = !!cdMpene
  if(!penForm.shown()) then
    !pen = !penForm.list.selection().dbRef()
    handle any
      !pen = !!ce
    endhandle
  else
    !!alert.error('You can only orientate a Penetration when the Penetration list is shown')
    return
  endif
  -- remove previous axes
  !!aidNumbers.remove(!this.aidNumber)

  if(not (!pen.hardType inset('SBFI','FIXING'))) then
    return error 1 'You must be at a Sub Fitting or a Fixing for this operation.'
  endif

  -- Set item to CE
  !this.item           = !pen
  -- set ce on form to Current fixing (use refe if flnn is too long)
  if(!pen.name.subString(1,1).eq('=')) then
    !ceName = !pen.ref.string()
  else
    !ceName = !pen.flnn
  endif

  !this.ceName.val     = !ceName
  -- Set panel direction
  if(!this.item.owner.owner.hardType.eq('PANE')) then
    !this.panelDirection = !this.item.owner.owner.orientation.zDir()
  else
    ---------------------------angle penetrations to work for sctns------------
    -- for sctns and wall etc.
    !owner = !!penGetOwningType(!pen)

    !pLine = POSL OF CMFI
     handle any
       -- gensec attributes
         !!ce   = !pen
         !pLine = POSL OF PLDAT
      -- goto PLDAT and get direction
         if(!pLine.eq('')) then
            !pLine = 'NA'
         endif
        PLDAT
        !pLineDir = !!ce.orientation.zDir().wrt(worl)

        !this.panelDirection = !pLineDir.wrt(worl)
      elsehandle none
       -- goto section type element and get pline direction
         !!ce = !owner
          if(!pLine.eq('')) then
             !pLine = 'NA'
          endif

        var !pLineDir  PPLINE  $!pLine DIR WRT WORLD

        !this.panelDirection = !pLineDir.direction().wrt(worl)
      endhandle

    !!ce = !pen


   -----------------------------------------------------------------------------
  endif
  -- Get direction of item
  PIN9 AT CE
  var !pos PIN9 POSITION WRT WORLD
  PIN9 OFF
  !this.pointVector.position  = object POSITION(!pos)
  !this.pointVector.direction = !this.item.orientation.zDir()

  -- Write direction to form
  !this.direction.val    = !this.pointVector.direction.wrt(World)

  -- Grab next aid number
  !this.aidNumber = !!aidNumbers.add(!this.pointVector)

  -- Select specified direction
  !this.setAngle('SPECIFIED')

  -- Draw direction
  !this.draw()

  -- Show the form
  if (!this.shown().not()) then
    !this.show()
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setAngle
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAngle()

  !this.setAngle(!this.setAngle.selection())

endmethod
-- End of method definition for .setAngle()

------------------------------------------------------------------------
--
-- Method:      setAngle
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAngle(!option is STRING)

  -- Select passed type
  !this.setAngle.select(!option)

  -- Specified
  if(!option eq 'SPECIFIED') then
    !this.direction.active = true
    !this.pointVector.direction = !this.direction.val

  -- Align with attached
  elseif (!option eq 'ALIGN') then
    !this.direction.active = false

    -- Get direction of attached item
    if(!this.item.cref.unset()) then
      !!alert.error('Unable to calculate Sub-fitting direction, as it not attached to another item.')

      -- Write direction to form
      !this.direction.val    = !this.pointVector.direction.wrt(World)
      !this.setAngle('SPECIFIED')
      return
    endif

    -- Get direction of attached item
    !newDirection = !this.item.cref.lDirection
    handle any
      -- might be a sctn
      !newDirection = !this.item.cref.orientation.yDir().wrt(worl)
    endhandle

    -- Calculate angle between item and panel
    !angle = !newDirection.angle(!this.pointVector.direction)

    -- If angle > 90, then invert direction of the panel
    if(!angle gt 90) then
      !this.pointVector.direction = !newDirection.opposite()
    else
      !this.pointVector.direction = !newDirection
    endif

  -- Normal to surface
  else
    !this.direction.active = false

    -- Calculate angle between item and panel
    !angle = !this.panelDirection.angle(!this.pointVector.direction)

    -- If angle > 90, then invert direction of the panel
    if(!angle gt 90) then
      !this.pointVector.direction = !this.panelDirection.opposite()
    else
      !this.pointVector.direction = !this.panelDirection
    endif

  endif

  -- Draw direction
  !this.draw()

endmethod
-- End of method definition for .setAngle(STRING)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !ref = !!ce

  -- Set zdirection of sbfi
  -- (AK) the CE is not what should be used here, but the penetration in the list
  !penForm = !!cdMpene
  if(!penForm.shown()) then
    !pen = !penForm.list.selection().dbRef()
    handle any
      !pen = !!ce
    endhandle
  endif

  if(!this.item.neq(!pen)) then
    !this.item = !pen
  endif

    !!ce = !this.item

  ZDIR $!this.pointVector.direction
  handle any
    ORI Z IS  $!this.pointVector.direction AND Y IS U
    handle any
       ORI Z IS  $!this.pointVector.direction
     endhandle
  endhandle

  -- Remove Aid number
  !!aidNumbers.remove(!this.aidNumber)

  -- Return to where we came from
  !!ce = !ref

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  -- Remove Aid number
  !!aidNumbers.remove(!this.aidNumber)

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()
-- (AK) the CE is not what should be used here, but the penetration in the list
  !penForm = !!cdMpene
  if(!penForm.shown()) then
    !pen = !penForm.list.selection().dbRef()
    handle any
      !pen = !!ce
    endhandle
  endif

  if(!this.item.neq(!pen)) then
    !this.item = !pen
  endif
  -- Remove arrow
  AID CLEAR ARROW $!this.aidNumber
  handle any
  endhandle

  -- Draw Arrow
  AID ARROW NUMBER $!this.aidNumber AT $!this.pointVector.position DIRECTION $!this.pointVector.direction HEIGHT 1000mm PROP 0.25


endmethod
-- End of method definition for .draw()
