-- File:            pendfltangle.pmlfrm
--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Mar 23 19:25:49 WAT 1998
--
--
-- Description:
-- Angled penetration default settings.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Constructor
--  initialise()                     -                   Constructor
--  penDfltAngle()                   -                   Constructor
--
------------------------------------------------------------------------

setup form !!penDfltAngle

  !this.formTitle     = 'Angle Defaults'
  !this.iconTitle     = 'AngDflts'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  frame .angle 'Maximum angles'
    -- Piping Angle
    text .pipes    'Pipes   ' width 10 is REAL
    path down
    text .sections 'Sections' width 10 is REAL
  exit

  -- Apply/Dismiss
  path down
  button .apply   '  OK  ' at xmax form-9-size callback '!this.apply()' ok
  path right
  button .dismiss 'Cancel' cancel

  -- Settings (used be application itself)
  member .pipeAngle    is REAL
  member .sectionAngle is REAL

exit
-- End of form definition for !!penDfltAngle

------------------------------------------------------------------------
--
-- Method:      penDfltAngle
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .penDfltAngle()

  !this.pipeAngle    = 15
  !this.sectionAngle = 10

endmethod
-- End of method definition for .penDfltAngle()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !this.pipes.val     = !this.pipeAngle
  !this.sections.val  = !this.sectionAngle

endmethod
-- End of method definition for .initialise()

-----------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  !this.pipeAngle    = !this.pipes.val
  !this.sectionAngle = !this.sections.val

endmethod
-- End of method definition for .apply()
