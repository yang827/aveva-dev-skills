--Define form
setup form !!pipeasscrt at xr 0 yr 0

  title    |Create|
  init     |!this.init()|

 -- Template Name
  text .name |Name| at xmin+8 ymax callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 32 name
  !this.name.val = |$_CDSYSNAM_NAME|

 -- Data
  path down
  halign right
  option .purp |Purpose|     width 30
  text   .desc |Description| width 32 string

 -- Bottom Line
  button .apply   |  OK  | at xmin form+0 ymax+0.5 call |!this.create()|
  button .dismiss |Cancel| at xmax form-size ymin  cancel

 -- Userdata
  -- Creation mode flag
  member .mode    is STRING
  -- Create type
  member .type    is STRING
  -- Item to Modify/place to create
  member .current is DBREF
  -- Assembly name to be modified
  member .assemblyname is STRING
  -- Discipline - PIPE or HVAC
  member .pipeOrHVAC   is STRING

-- End of form definition
exit
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .init()

  -- Select based on Piping or HVAC
  if (!!appCntrl.currentApp eq 'HVACADV') then
    !purp[1] = 'HVAC Assembly'
    !text[1] = 'HASY'
    !this.pipeOrHVAC = 'HVAC'
  else
    !purp[1] = 'Piping Assembly'
    !text[1] = 'PASY'
    !this.pipeOrHVAC = 'PIPE'
  endif

  !this.purp.dtext = !purp
  !this.purp.rtext = !text

  -- Clear Name and Description
  !this.name.val = ''
  !this.desc.val = ''

  !!ce = !this.current

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .create()

  !!ce = !this.current
  --check that the name gadget is populated
  if !this.name.val.eq('unset').or(!this.name.val.eq('')) then
    !!alert.message('Please enter a name for the new assembly')
    return
  elseif !this.desc.val.eq('')then
    !!alert.message('Please enter a description for the assembly')
    return
  endif

  if !this.mode.eq('modify') then
    !!ce = !this.current
    name $!this.name
    purp $!this.purp
    desc '$!this.desc'
    if !this.type.eq('APPLDW') then
      !this.owner().getworld(1)
    elseif  !this.type.eq('APPDAR') then
      !this.owner().getworld(2)
    elseif !this.type.eq('APPLDA') then
      DDSE $!this.assemblyname-DDSE
      name $!this.name-DDSE
      purp $!this.purp
      zone $!this.assemblyname-ZONE
      name $!this.name-ZONE
      purp $!this.purp
      $!this.pipeOrHVAC $!this.assemblyname-$!this.pipeOrHVAC
      name $!this.name-$!this.pipeOrHVAC
      purp $!this.purp
      !this.owner().selectcurrent(!!ce)
    endif

  else
    !!ce = !this.current

    new  $!this.type
    name $!this.name
    purp $!this.purp
    desc '$!this.desc'
    if !this.type.eq('APPLDW') then
      !this.owner().getworld(1)
    elseif  !this.type.eq('APPDAR') then
      !this.owner().getworld(2)
    elseif !this.type.eq('APPLDA') then
      -- create a dataset
      new DDSE  $!this.name-DDSE
      purp $!this.purp
      new zone  $!this.name-ZONE
      purp $!this.purp
      new $!this.pipeOrHVAC  $!this.name-$!this.pipeOrHVAC
      purp $!this.purp
      !this.owner().selectcurrent(!!ce)
      !this.owner().getworld(3)
    endif
  endif

  hide !!pipeasscrt

endmethod
