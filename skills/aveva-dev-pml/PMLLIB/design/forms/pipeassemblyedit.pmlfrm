------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addtodisplay()                   -
--  buildassembly()                  -
--  copydesign()                     -
--  create(STRING)                   -
--  getarea(REAL)                    -
--  getassy(REAL)                    -
--  getitems()                       -
--  getworld()                       -
--  init()                           -
--  insertcopy()                     -
--  moveorigin()                     -
--  moveorigin(EDGPICKDATA)          -
--  selectassy()                     -
--  setorigin()                      -
--


setup form !!pipeassemblyedit dialog dock right


  !this.icontitle     = 'Assemblies'
  !this.formtitle     = 'Edit Assemblies'
  !this.formrevision  = ' $Revision: 0.0 $ '
  !this.initcall      = '!this.init()'
  !this.quitcall      = ||


toggle .name 'Display Name/Description' call '!this.getworld()'
path down
option .world      'Site     ' call '!this.getarea(1)' width 16
path right
button .crworld    'New...' call |!this.create('SITE')|

option .area       'Zone     '   at xmin.world ymax    call '!this.getassy(1)' width 16
button .crarea     'New...' call |!this.create('ZONE')|

option .assembly   'PIPE     ' at xmin.world ymax call '!this.selectassy()'  width 16
button .crtmpl    'New...' call |!this.create('PIPE')|

list .componentlist at xmin.world ymax width 40 hei 8
path down


button .display 'Display' call '!this.addtodisplay()'

 frame .buildframe 'Build Assembly'
    button .copy    'Copy Design'   call '!this.copydesign()'
    button .origin 'Assembly Origin' at xmax ymin call '!this.setorigin()'
   --  button .delete 'Delete selected'
 exit

  member .site                  is DBREF
  member .zone                  is DBREF
  member .pipe                  is DBREF
  member .branches              is ARRAY
  member .lines                 is ARRAY
  member .savedata              is ARRAY
  member .components            is ARRAY
  member .deletedcomps          is ARRAY
  member .newcomps              is ARRAY
  member .assemblies            is ARRAY

exit
----------------------------------------------------------------------------

------------------------------------------------------------------------------
-- constructor method to build the basics
define method .init()

-- find the available template worlds
!this.getworld()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .buildassembly()

  !!ce = $!this.area
  handle any
    !!alert.error('Area Not defined')
    return
  endhandle

  -- loop through the components and create a copy
  new tmpl $!this.name
  handle any
    --$P $!!error.text
    return
  endhandle

  if(undefined(!!pipingActions)) then
    !!pipingActions = object PIPINGACTIONS('pipingActions')
  endif

  -- Determine if there is a valid selection or component
  !selection        = object SELECTION()
  !selection.getCurrent()
  !selected         = !selection.getSelection()

  -- If there is a single selection, check to see if its a piping component
  if(!selected.set()) then
    if(!selected.first().owner.type eq 'BRAN') then
      !!pipingActions.copySelection(!selection)
    endif
  else
    return
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getworld()

  var !a coll all Site with purp eq 'PASY'
  if !a.size().eq(0) then
     !dtext[1] = 'None Found'
     !a[1]     = 'NONE Found'
  else
    if !this.name.val then
       var !dtext eval name for all from !a
    else
       var !dtext eval desc for all from !a
    endif
  endif

  !this.world.dtext = !dtext
  !this.world.rtext = !a

  -- populate the list of available areas
  !this.getarea(1)



endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getarea(!mode is REAL)

  if !mode eq 1 then
     var !a coll all zone with purp eq 'PASY' for $!this.world
     handle any
        !a = ARRAY()
     endhandle
  else
     var !a coll all zone with purp eq 'PASY'
     handle any
        !a = ARRAY()
     endhandle
  endif

  if !a.size().eq(0) then
     !dtext[1] = 'None Found'
     !a[1]     = 'NONE Found'
  else
     if !this.name.val then
       var !dtext eval name for all from !a
    else
       var !dtext eval desc for all from !a
    endif
  endif
  if !mode eq 1 then
     !this.area.dtext = !dtext
     !this.area.rtext = !a
     -- populate the assembly list
     !this.getassy(!mode)
  else
     !this.categories.dtext = !dtext
     !this.categories.rtext = !a
     -- populate the assembly list
     !this.getassy(!mode)
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getassy(!mode is REAL)

  if !mode eq 1 then
    var !a coll all pipe for $!this.area
    handle any
     !a = ARRAY()
     !this.pipe = object DBREF()
    endhandle
  else
    var !a coll all pipe for $!this.categories
    handle any
     !a = ARRAY()
     !this.pipe = object DBREF()
    endhandle
  endif

  if !a.size().eq(0) then
     !dtext[1] = 'None Found'
     !a[1]     = 'NONE Found'
  else
    if !this.name.val then
       var !dtext eval name for all from !a
    else
       var !dtext eval desc for all from !a
    endif
  endif

  if !mode eq 1 then
    !this.assembly.dtext = !dtext
    !this.assembly.rtext = !a
    !this.selectassy()
  else
    !this.assemblylist.dtext = !dtext
    !this.assemblylist.rtext = !a
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .selectassy()

   !!ce = !this.assembly.selection().dbref()
   handle any
      !this.componentlist.clear()
      return
   endhandle
   !this.pipe = !this.assembly.selection().dbref()
   !this.getitems()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .create(!type is STRING)

  !!pipeasscrt.type = !type
  handle any
    pml load form !!pipeasscrt
    !!pipeasscrt.type = !type
  endhandle
  !!pipeasscrt.mode = 'new'

  if !type.eq('SITE') then
          !!pipeasscrt.current = /*
  elseif !type.eq('ZONE') then
          !!pipeasscrt.current = !this.world.selection().dbref()
  else
          !!pipeasscrt.current =  !this.area.selection().dbref()
  endif

  show !!pipeasscrt

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getitems()

  !!ce = !this.assembly.selection().dbref()
  handle any
      !this.componentlist.clear()
      return
  elsehandle NONE
      branch 1
      handle any
         !this.componentlist.clear()
         return
      endhandle
  endhandle
  var !all coll all for ce

  !this.components = !all

  !type   = ARRAY()
  !name   = ARRAY()
  !spref  = ARRAY()
  !catref = ARRAY()
  !stype  = ARRAY()

  do !a index !this.components
    if !this.components[!a].dbref().type.string().eq('TMPL') then
          skip
    endif
    !type[!a]   = !this.components[!a].dbref().type.string()
    !name[!a]   = !this.components[!a].dbref().refno.string()
    handle any
       !name[!a] = 'IL Tube'
    endhandle
    !spref[!a]  = !this.components[!a].dbref().spref.string()
    handle any
       !spref[!a]  = !this.components[!a].dbref().pspe.string()
    endhandle
    !catref[!a] = !this.components[!a].dbref().catref.string()
    handle any
       !catref[!a] = !this.components[!a].dbref().hstu.string()
    endhandle
      !stype[!a]  = !this.components[!a].dbref().stype.string()
    handle any
       !stype[!a] = ''
    endhandle

  enddo

  !heading[1] = 'Type'
  !heading[2] = 'Name'
  !heading[3] = 'Spec Ref'
  !heading[4] = 'catref'
  !heading[5] = 'stype'

  !cols = ARRAY()


    !cols.append(!type.compress())
    !cols.append(!name.compress())
    !cols.append(!spref.compress())
    !cols.append(!catref.compress())
    !cols.append(!stype.compress())

  !this.componentlist.setheadings( !heading )
  !this.componentlist.setcolumns( !cols )
  rem all add ce
  --!this.componentlist.rtext = !name
  !object = object PIPINGASSEMBLY(!this.pipe)


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .setorigin()

 !result = true

  -- Define EDG packet
    -- Define Packet
  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdany('Identify type in insert selection')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!pipeassemblyedit.moveorigin(!this.return[1])'
  !packet.remove  = true
  !return = !!edgcntrl.add(!packet)

  -- Return
  return !result

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .copydesign()

!object = object PIPINGASSEMBLY(!this.pipe)
!object.buildfromselection(!this.pipe)
rem all add ce

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to auto the current pipe and add it to the view
define method .addtodisplay()

  !!ce = !this.assembly.selection().dbref()
  handle any
      !!alert.error('No pipe selected')
      return
  endhandle

   var !vol VOL CE  $* Get information about the pipe (ie volume)

  handle ANY
    return error 1 |Unable to get volume of selected pipe.|
  endhandle

   if(!!gphviews.views.empty()) then
     return error 1 |No graphical views are available to display the pipe.|
   endif

   do !i indices !!gphviews.views  $* Loop through views and get relevant data
     !!gphviews.limits(!!gphviews.views[!i], !!ce)
   enddo

   -- Empty drawlist and included pipe
   REMOVE ALL
   ADD ce

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to move the head of the first branch to n0u0e0
define method .moveorigin()


  !!ce = !this.assembly.selection().dbref()
  bran 1
  handle any
      return
  endhandle
  !wpos = n0 wrt /*

  !position   = !!ce.hpos.wrt(/* )

  !offset     = !position.distance(!wpos)

  !direction  = !position.direction(!wpos)

  !!ce = !this.assembly.selection().dbref()
  var !bran coll all bran for ce
  do !a values !bran
    $!a

     --q var !offset
    !dir = !direction.string().before('WRT')
    by $!dir $!offset
    --pos $!element.ppoi[$!point] at n0 wrt /*
    -- of $!element by $!direction  $!offset
  enddo
  !this.addtodisplay()



endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to move the passed position and everything else to n0u0e0
define method .moveorigin(!pick is EDGPICKDATA )


  !element  = !pick.item
  !point    = !pick.point
  !wpos = n0 wrt /*

  !position   = !element.ppos[!point].wrt(/* )

  !offset     = !position.distance(!wpos)

  !direction  = !position.direction(!wpos)

  !!ce = !this.assembly.selection().dbref()
  var !bran coll all bran for ce
  do !a values !bran
    $!a
    !dir = !direction.string().before('WRT')
    by $!dir $!offset
  enddo
  !this.addtodisplay()



endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to take the existing group and copy it into a pipe
define method .insertcopy()

-- this is probably not used.

  !pipe =  !!pipeassemblyedit.assemblylist.selection().dbref()
  handle any
    !!alert.error('No pipe defined')
    return
  endhandle

  !group = object PIPINGASSEMBLY(!this.pipe)

  -- now insert the code to insert the item
    !!pipecopy = object PIPINGACTIONS('Pipecopy')
    !!pipecopy.assemblyselection(!group.designitems)

endmethod
------------------------------------------------------------------------------
