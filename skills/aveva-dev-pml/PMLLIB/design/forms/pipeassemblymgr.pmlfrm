setup form !!pipeassemblymgr dialog dock right

import 'ExplorerAddin'
handle any
endhandle

using namespace 'Aveva.Pdms.Presentation'

  !this.icontitle     = 'Assemblies'
  !this.formtitle     = 'Pipe Assembly Manager'
  !this.formrevision  = ' $Revision: 0.0 $ '
  !this.initcall      = '!this.init()'
  !this.quitcall      = |!this.killcall()|
  !this.killingcall   =  |!this.killcall()|
  !this.firstshowncall = '!this.firstShown()'
  track 'DESICE'    call '!this.track()'

--frame .mainframe panel anchor all at x0 y0

button .ce  ' CE '  callback |!this.selectcurrent(!!ce)|
toggle .name 'Display Name/Description' call '!this.getworld(1)'


path down

option .world              'Application World:' anchor t+r+l at xmin.ce ymax  call '!this.getworld(2)' width 12
path right
button .crworld  linkLabel 'Create World' anchor t+r  callback |!this.create('APPLDW')|

option .area               'Application Area: ' anchor t+r+l at xmin.world ymax  call '!this.getworld(3)' width 12
path right
button .crarea  linkLabel  'Create Area' anchor t+r  callback |!this.create('APPDAR')|


option .assemblyopt        'Assemblies:       '  anchor t+r+l  at xmin.world ymax  call '!this.selectassy()' width 12
path right
button .crapdata  linkLabel 'Create Assembly' anchor t+r  callback |!this.create('APPLDA')|

--list .componentlist 'Assembly Components' anchor top + left  at xmin.world ymax call '!this.selectcomponent(!this.componentlist.selection())' width 47 hei 11
path down

-- button .display 'Display' at xmin.world ymax call '!this.addtodisplay()'
button .copy    'Copy Design' at xmin.world ymax   call '!this.copydesign()'
para   .readonly  at xmax+7 ymin width 12 lines 1

Container .explorerframe PMLnetcontrol 'NET' anchor t+r+l  at xmin.world ymax  width 49 hei 9
-- zone and pipe created automatically

  frame .secondtaskpane panel                  anchor all                        at xmin.world      ymax.explorerframe

    para .compdata at x18 y-0.3 width 30 lines1
    list .actionlist 'Component Rules' anchor t+r+l at x0y0 width 47 hei 13
    path down
    button .createstype              'New'  call |!this.newrule()|
    button .editstype  at xmax ymin  'Edit' call |!this.editrule()|
    button .deletestype at xmax ymin 'Delete' call |!this.deleterule()|

    line .ftpl12                               anchor top + left + right  at x0   ymax   horizontal width 49

    frame  .localViewFrame PANEL at xmin ymax anchor all width 44
      para .prompt at xmin .ftpl12 ymax .ftpl12 width 49 lines 1

      view .localview at xmin.world ymax.prompt prompt .prompt givolume
      --view .localview at xmin.world ymax  givolume

       -- Input Modes
          -- Navigate
          inmode create _navi       type |DES_NAVIGATE|
          -- Standard Element Pick
          inmode create _pick       type |DES_PICK|
          -- Pick Any (Element, Ppoint, Pline)
          inmode create _pAny       type |DES_PICK_ANY|
          -- Plines
          inmode create _pLine      type |DES_PICK_PLINE|
          -- Ppoints
          inmode create _point      type |DES_PICK_POINT|
          -- Screen Position
          inmode create _screen     type |DES_3D_LINE|
          -- Laser Model rays
          inmode create _pickxgeom  type |DES_PICK_XGEOM|
          -- Default (Navigation)
          inmode create _pickDetail type |DES_PICK_DETAIL|
          -- Default (Navigation)
          inmode create _default    type |DES_NAVIGATE|

      height 10 width 40

      exit
    exit
      -- Set Defaults for Modes
    !this.localview.navi.cursor     = 'Pointer'
    !this.localview.navi.prompt     = 'Navigate : '

    !this.localview.pick.cursor     = 'Pointer'
    !this.localview.pick.prompt     = 'Pick Element : '

    !this.localview.pAny.cursor     = 'Pointer'
    !this.localview.pAny.prompt     = 'Pick Any : '

    !this.localview.pLine.cursor    = 'Pointer'
    !this.localview.pLine.prompt    = 'Pick Pline : '

    !this.localview.point.cursor    = 'Pick'
    !this.localview.point.prompt    = 'Point Ppoint : '

    !this.localview.screen.cursor   = 'Crosshair'
    !this.localview.screen.prompt   = 'Pick 3D Position : '

    !this.localview.default.cursor  = 'Pointer'
    !this.localview.default.prompt  = 'Navigate : '


  exit

  menu .editworld
   !this.editworld.add('callback','Modify World' ,'!this.modify(!this.world)')
   !this.editworld.add('callback','Delete World' ,'!this.deleteitem(!this.world)')
   !this.world.setpopup(!this.editworld)

  menu .editarea
   !this.editarea.add('callback','Modify Area' ,'!this.modify(!this.area)')
   !this.editarea.add('callback','Delete Area' ,'!this.deleteitem(!this.area)')
   !this.area.setpopup(!this.editarea)

  menu .editassembly
   !this.editassembly.add('callback','Modify Assembly' ,'!this.modify(!this.assemblyopt)')
   !this.editassembly.add('callback','Delete Assembly' ,'!this.deleteitem(!this.assemblyopt)')
   !this.assemblyopt.setpopup(!this.editassembly)

  menu .pmlpopupworl
  !this.pmlpopupworl.add( 'CALLBACK', 'Set Key Element', '!this.setkey(1)' )
  !this.pmlpopupworl.add( 'CALLBACK', 'Remove Key Element', '!this.setkey(2)' )
  --!this.pmlpopupworl.add( 'CALLBACK', 'Set Assembly Origin', '!this.setorigin()' )


  member .appdworld             is DBREF
  member .appdarea              is DBREF
  member .appdata               is DBREF
  member .zone                  is DBREF
  member .pipe                  is DBREF
  member .branches              is ARRAY
  member .owners                is ARRAY
  member .lines                 is ARRAY
  member .saveData              is ARRAY
  member .components            is ARRAY
  member .deletedcomps          is ARRAY
  member .newcomps              is ARRAY
  member .assembly              is PIPEASSEMBLY
  member .currentcomp           is PIPEASSEMBLYCOMPONENT
   -- Current Task Pane within Form
  member .currentPane           is GADGET
  member .currentTask           is BLOCK
  member .currentbuild          is STRING
  member .currentpanel          is STRING
  member .systemexplorer        is PMLEXPLORERCONTROL
  member .drawlist              is DRAWLIST
  member .explorerselected      is DBREF


  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  !!appFormCntrl.registerForm(!this)
 -- !!edgcntrl.addview(!this.localview)

exit
