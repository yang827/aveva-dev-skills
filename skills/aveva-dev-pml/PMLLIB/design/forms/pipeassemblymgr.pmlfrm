------------------------------------------------------------------------------
define method .deleterule()

 !element = !this.actionlist.selection().dbref()
  handle any
    !!alert.error('No Rule to Delete')
    return
  endhandle
  if !element.unset() then
        !!alert.error('No Valid Elements!')
        return
  endif
  !!ce = !element

  if !!ce.type.eq('VVALUE') then
    if !!alert.confirm('Ok To Delete Value').eq('YES') then
       Delete VVALUE
       -- if there are no members for the ddat then get rid of it.
       if !!ce.members.size().eq(0) then
          delete ddat
       endif
    endif
  elseif !!ce.type.eq('DDAT') then
    if !!alert.confirm('Ok To Delete Value').eq('YES') then
      Delete DDAT
    endif
  endif
-- P-3992 refresh list after delete
  -- refreshes the table after delete
  END
  -- problem here#
  !!xx = !this.explorerselected
  !this.systemexplorer.selectelement(!!ce.owner.string())
  !this.systemexplorer.selectelement(!!xx.string())

--!this.selectcomponent(!!ce.string())

endmethod
