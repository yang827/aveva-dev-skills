----------------------------------------------------------------------------
define method .pipeassemblymgr()

  --!drawlist = object drawlist()
  --!drawlist.attachview(!this.localview)
  --!this.drawlist = !drawlist

  -- find the available template worlds
  !this.getworld(1)
  --!this.firstTaskPane.visible  = FALSE
  !this.secondtaskpane.visible = TRUE


using namespace 'Aveva.Pdms.Presentation'
!this.systemexplorer = object PMLEXPLORERCONTROL()
--!this.systemexplorer.initialise('/*', 'Piping')
-- P-26479 change to the initialise method for the explorer addin
!this.systemexplorer.initialise('DESI','/*')
!this.explorerframe.control = !this.systemexplorer.handle()

--Add event handlers
!this.systemexplorer.addeventhandler('OnSelectionChanged',!this, 'explorerSelect')
!this.systemexplorer.addeventhandler('Onpopup', !this, 'ExplorerPopUp')

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .firstShown()

  !background = !!gphviews.views.first().background
  handle any
    !background = 15
  endhandle
  !this.drawlist = object DRAWLIST()
  !this.localview.background = !background
  !this.localview.shaded     = TRUE
  !this.drawlist.attachview(!this.localview)
  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)
  handle any

  endhandle
   -- add the localview
  !!edgcntrl.addview(!this.localview)

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .modify(!item is GADGET)

  if !item.dtext[1].eq('None Found') then
    !!alert.error('No assembly selected')

  else
    !selection = !item.selection()
    pml load form !!pipeasscrt

    if !item.eq(!this.world) then
      !type = 'APPLDW'
      !formtitle = 'Modify Assembly World'
    elseif !item.eq(!this.area) then
      !type = 'APPDAR'
      !formtitle = 'Modify Assembly Area'
    else
      !type = 'APPLDA'
      !formtitle = 'Modify Assembly'
      !!pipeasscrt.assemblyname = !selection.dbref().name
    endif

    !!pipeasscrt.formtitle = !formtitle
    !!pipeasscrt.type = !type
    handle any
      pml load form !!pipeasscrt
      !!pipeasscrt.type = !type
    endhandle

    !!pipeasscrt.mode = 'modify'
    !!pipeasscrt.name.val = !selection.dbref().name
    !!pipeasscrt.desc.val = !selection.dbref().desc
    !!pipeasscrt.current = !selection.dbref()

    show !!pipeasscrt
  endif

 endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .deleteitem(!item is GADGET)

  if !item.dtext[1].eq('None Found') then
    !!alert.error('No assembly selected')

  else
    !selection = !item.selection()
    !!ce = !selection.dbref()
    !!deleteCE()

    if !item.eq(!this.world) then
      !this.getworld(1)
    elseif !item.eq(!this.area) then
      !this.getworld(2)
    else
      !this.getworld(3)
    endif
  endif

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .explorerpopup(!data is ARRAY)

   !!element = object DBREF(!data[2])
   !this.explorerframe.popup = !this.pmlpopupworl
   !this.explorerframe.showpopup(!data[0], !data[1])

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .setkey(!action is REAL )

 -- The selected element is to become a key element-
 -- This means that it will replace an existing element in the design and
 -- build the assembly around it
  -- how do we make a key element
 -- this is called by the explorer gadget

 -- only allows a key element to be set below branch level.
 -- P-7225 error on key element being set to a non piping component
  if !!ce.owner.type.neq('BRAN') then
    !!alert.error('Key Element must be in the Main Branch')
    return
  endif

 -- go to the design data set and creat a new key element
  var !coll coll all ddat with (dkey eq 'KEY') for $!this.assembly.dataset
  if !action.eq(2) then
    -- its a delete
    if !coll.size().gt(0) then
      do !a values !coll
         $!a
         delete ddat
      enddo
      return
    endif
  else
    if !coll.size().eq(0) then
      !!ce = !this.assembly.dataset
      !name = !!ce.name & '-KEY'
      new ddat
      name $!name
      dkey key
      ddprop $!!element
    else
      !existing = !this.assembly.dataset.lfdp.key
      if !existing.eq(!!element) then
        !!alert.error('Key Element is already set to this item')
        return
      else
        !!ce = !coll[1].dbref()
        !flnn = !existing.flnn
        handle (2,754)
           ddprop $!!element
        elsehandle NONE
          if !!alert.confirm('Ok to change Key element from $!flnn to This element?').eq('YES') then
            ddprop $!!element
          endif
        endhandle
      endif
    endif
  endif

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .explorerselect(!data is ARRAY)

!element = object DBREF(!data[0])
!!ce = !element
!this.setruleslistheading(!!ce)
!this.selectcomponent(!!ce.string())
!this.explorerselected = !!ce
!this.addtodisplay()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .refreshassembly(!assembly is DBREF)

!this.setruleslistheading(!assembly)
!this.selectcomponent(!assembly.string())
!this.explorerselected = !assembly
!this.addtodisplay()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .setruleslistheading(!element is DBREF )

if !element.type.eq('APPLDA') then
    !this.actionlist.tag = 'Assembly Rules'
    !this.compdata.val = ''
else
    if !element.ddepth.gt(5)then
      !this.actionlist.tag = 'Component Rules'
      !this.compdata.val = !this.cedetails(!element)
    endif
endif

!this.compdata.refresh()

endmethod
----------------------------------------------------------------------------
-- method to set the little text bit above th component list gadget
-- not all values used so needs to be trimmed
define method .cedetails(!element is DBREF)is STRING

    !type   = !element.type.string()
    !name  = !element.refe.string()
    handle any
       !name = 'IL Tube'
       return ''
    endhandle
    !spref  = !element.spref.name
    handle any
       !spref  = !element.pspe.name
       handle any
         !spref  = 'unset'
       endhandle
    endhandle
    !catref = !element.catref.name
    handle any
       !catref = !element.hstu.string()
       handle any
         !catref = 'unset'
       endhandle
    endhandle
      !stype  = !element.stype.string()
    handle any
       !stype = 'unset'
    endhandle

    !return = 'Specification' & !spref & ' Stype ' & !stype

    return !return

endmethod


----------------------------------------------------------------------------
define method .selectelement(!ele is STRING)

--$P in selectelement
    !this.systemexplorer.selectelement(!ele)


endmethod
----------------------------------------------------------------------------

-- constructor method to build the basics
-----------------------------------------------------------------------------
define method .init()

  -- find the available template worlds
  !this.getworld(1)
  !this.secondtaskpane.visible = TRUE

  --Restore from serialisation
  !data = !!appFormCntrl.getformdata(!this)
  if !data.set() then
    !!ce = !data[1].dbref()
    handle any
      --!data[1] does not exist
    elsehandle none
      !this.selectcurrent(!!ce)
    endhandle
  endif

endmethod
