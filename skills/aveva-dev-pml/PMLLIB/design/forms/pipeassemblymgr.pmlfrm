------------------------------------------------------------------------------
define method .track()

if !this.shown().not() then
  return
else
   var !a applda
   handle any
     return
   elsehandle NONE
     !this.systemexplorer.selectelement(!!ce.string())
     handle any
        return
     endhandle
   endhandle
endif


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getworld(!level is REAL)

  if !level.eq(1) then
   !this.getarea(!this.world, 'APPLDW', '/*')
   !this.getarea(!this.area, 'APPDAR', '$!this.world')
  elseif !level.eq(2) then
   !this.getarea(!this.area, 'APPDAR', '$!this.world')
  endif
  !this.getarea(!this.assemblyopt, 'APPLDA', '$!this.area')

  if !this.assemblyopt.dtext[1].eq('None Found') then
    !this.selectassy()
    !this.explorerframe.active = FALSE
  else
    !this.selectassy()
    !this.explorerframe.active = TRUE
  endif

  !!ce = !this.assemblyopt.selection().dbref()
  handle any
    return
  elsehandle NONE
    !this.selectassy()
  endhandle

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- When at APPLDA level get the correct world and area gadgets
define method .selectcurrent(!element is DBREF)

    !!ce = !element
    APPLDA
    handle any
         !!alert.error('Not At an Assembly')
         return
    endhandle

    --!area = !!ce.owner

    !this.getarea(!this.world, 'APPLDW', '/*' )
    !this.world.select('rtext', !!ce.owner.owner.string())
    !this.getarea(!this.area, 'APPDAR', '$!this.world')
    !this.area.select('rtext', !!ce.owner.string())
    !this.getarea(!this.assemblyopt, 'APPLDA', '$!this.area')
    !this.assemblyopt.select('rtext', !!ce.string())

    !this.selectassy()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- gets all the data for the appworld apparea an appdata option gadgets
define method .getarea(!gadget is GADGET,!searchitem is STRING, !source is STRING)

   if !source.eq('/*') then
        var !a coll all $!searchitem with purp eq 'PASY'
        handle any
               !a = ARRAY()
        endhandle
   else
       var !a coll all $!searchitem with purp eq 'PASY' for $!source
       handle any
          !a = ARRAY()
       endhandle
   endif
   if !a.size().eq(0) then
      !dtext[1] = 'None Found'
      !a[1]     = 'NONE Found'
      !this.actionlist.clear()
      !this.localview.visible = FALSE
   else
      if !this.name.val then
        var !dtext eval name for all from !a
     else
        var !dtext eval desc for all from !a
     endif
   endif

   !gadget.dtext = !dtext
   !gadget.rtext = !a


 endmethod

------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .selectassy()

   !this.systemexplorer.resetroot(!this.assemblyopt.selection())
   handle any
   endhandle
   !!ce = !this.assemblyopt.selection().dbref()
   handle any
      --!this.componentlist.clear()
        !this.assembly = object PIPEASSEMBLY()
      return
   elsehandle NONE
        -- find the first branch in the assembly and open the hierarchy to it
        var !bran coll all bran for ce
        if  !bran.empty().not() then
            !this.systemexplorer.selectelement('$!bran[1]')
            handle ANY
            endhandle
        endif
   endhandle


   !this.assembly = object PIPEASSEMBLY(!this.assemblyopt.selection().dbref())


   if !this.assembly.readonly then
    !this.readonly.val = |(Read Only)|
   elseif !this.assembly.locked then
      !this.readonly.val = |(Locked)|
   else
       !this.readonly.val = ||
   endif


   !this.setruleslistheading(!!ce)
   !this.selectcomponent(!!ce.string())
   !this.explorerselected = !!ce

   !this.addtodisplay()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .create(!type is STRING)

  !!pipeasscrt.type = !type
  handle any
    pml load form !!pipeasscrt
    !!pipeasscrt.type = !type
  endhandle
  !!pipeasscrt.mode = 'new'
  --$P type is $!type
  if !type.eq('APPLDW') then
          !!pipeasscrt.current = !!ce
          !!pipeasscrt.formtitle = 'Create Assembly World'
  elseif !type.eq('APPDAR') then
          !!pipeasscrt.current = !this.world.selection().dbref()
          handle any
             !!alert.error('Not at an Assembly World')
             return
          endhandle
          !!pipeasscrt.formtitle = 'Create Assembly Area'
  else
          !!pipeasscrt.current =  !this.area.selection().dbref()
          handle any
             !!alert.error('Not at an Assembly Area')
             return
          endhandle
          !!pipeasscrt.formtitle = 'Create Assembly'
  endif

  show !!pipeasscrt

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .setorigin()

 !result = true

  -- Define EDG packet
    -- Define Packet

  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdany('Identify PPOINT For Origin')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!pipeassemblymgr.moveorigin(!this.return[1])'
  !packet.remove  = true
  !return = !!edgcntrl.add(!packet)

  -- Return
  return !result

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to build an assembly from a graphical selection
define method .copydesign()

 var !all coll all bran for $!this.assembly.appldata
 if !all.size().gt(0) then
    !!alert.error('Assembly already has members - Copy Aborted')
    return
 endif

 !selection = object SELECTION()
 !selection.getCurrent()
 !this.components = !selection.getselection()

 --P-4502: FIX-If no components selected before copy pressed then error and return.
 if !this.components.unset() then
    !!alert.error('No components selected.')
    return
 endif
 --End Fix

 !owners = ARRAY()
 !branches = ARRAY()
 -- loop through the selected items and see if there are any branches
 -- if there is only one branch then we don't need to identify a branch
 do !a values !this.components
   skip if(!a.type eq 'TUBI')
   if !a.type.eq('BRAN') then
      !branches.append(!a)
   else
      !owners.append(!a.owner)
   endif
 enddo

  !this.branches = !branches
 -- check to see how many branches are involved
 !owners.appendarray(!branches)
 !owners.unique()
 !this.owners = !owners
 if !owners.size().eq(1) then
   -- we don't need to pick a main branch
    !this.assembly.buildfromselection(!this.assembly.pipe, !this.components, !owners[1], !branches, !owners)
   !!alert.message('Copy Complete')
   !this.selectcurrent(!!ce)
   return
 endif
 --!this.selection = !selection

 !result = true

  -- Define EDG packet
    -- Define Packet
  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdany('Identify a Component in the Main branch of Assembly Selection')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!pipeassemblymgr.buildassembly(!this.return[1])'
  !packet.remove  = true
  !return = !!edgcntrl.add(!packet)

  -- Return
  return !result

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .buildassembly(!pick is EDGPICKDATA)


    -- this method picks the main branch
    !assemblybranch = object DBREF()
     if !pick.item.type.neq('BRAN') then
        !bran = !pick.item.owner
      else
         !bran = !pick.item
      endif
    if !this.components.findfirst(!pick.item).unset() then
      do !a values !this.components
            skip if(!a.type eq 'TUBI' or !a.owner.type ne 'BRAN')
            if !a.owner.eq(!bran) then
              !assemblybranch = !bran
              break
            endif
      enddo
    else
       !assemblybranch = !bran
    endif
    if !assemblybranch.unset() then
          !!alert.error('Identified component is not found')
          return
    else
      --$P branch is $!assemblybranch
    endif

  !this.assembly.buildfromselection(!this.assembly.pipe, !this.components, !assemblybranch, !this.branches, !this.owners)
  !!alert.message('Copy Complete')
  --Refreshes pipeassemblymgr once copy complete.
  !this.selectcurrent(!!ce)

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to auto the current pipe and add it to the view
define method .addtodisplay()

  !selected = !this.assemblyopt.selection().dbref()
  handle any
      !!alert.error('No Assembly selected')
      return
  endhandle
  if !!ce.neq(!selected) then
    return
  endif

  -- Get information about the pipe (ie volume)
  var !unusedTestVolume VOL CE
  handle ANY
    --!!alert.confirm (|No Graphical Elements in this Assembly|)
    !this.localview.visible = FALSE
    return
  elsehandle NONE
    !this.localview.visible = TRUE
  endhandle

  !background = !!gphviews.views.first().background
  handle any
    !background = 15
  endhandle

  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)

  var !a coll all bran for ce
  do !b values !a
     mark $!b
  enddo

 !dira[1]  = -0.57735
 !dira[2]  = 0.57735
 !dira[3]  = -0.57735


 !this.localview.direction = !dira
  -- mark all the relevant elements in the local view
 !this.assembly.markelements()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to set the limits of the localview
define method .limits(!element is DBREF)

  -- Initialise Variables
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Get volume of item
  !volume      = object VOLUME(!element)
  !volume.from = !volume.from.string(!format).position()
  !volume.to   = !volume.to.string(!format).position()

  -- Load view limits with Volume
  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  -- Set view Limits
  !this.localview.limits = !array

  Handle (61,620)
    !answer =  !!Alert.error ( 'Selected component must have 3D geometry!' )
--navigate to BRAN level the delete branch
    !a = !!ce.members[2].members[1].members[1]
   	!!ce = !a
   	!!deleteCE()
    return
  endhandle


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to move the passed position and everything else to n0u0e0
-- the user has selected a ppoint and returned it to the form for checking
define method .moveorigin(!pick is EDGPICKDATA )

  !element  = !pick.item
  !point    = !pick.point

  -- first check to see if the element picked is in line.
  if !element.owner.order.neq(1) then
    !!alert.error('Assembly Origin must be in the first Branch')
    return
  endif

  -- could check to see if its in line, but it shouldn't matter.

   -- go to the design data set and creat a new key element
  var !coll coll all ddat with (dkey eq 'ORIG') for $!this.assembly.dataset
  if !coll.size().eq(0) then
    !!ce = !this.assembly.dataset
    !name = !!ce.name & '-ORIG'
    new ddat
    name $!name
    dkey orig
    ddprop $!element
    number $!point
  else
    !!ce = !coll[1].dbref()
    !existing = !this.assembly.dataset.lfdp.orig
    if !existing.eq($!element) then
      if !point.eq(!!ce.number) then
         !!alert.error('Origin Point is already set to this Point')
          return
      endif
      !!ce.number = !point
    else
      !!ce = !coll[1].dbref()
      if !!alert.confirm('Ok to change Origin Point?').eq('YES') then
        ddprop $!element
        number $!point
      endif
    endif
  endif


  !this.addtodisplay()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- this method takes the currently selected element in the components list and
-- displays the relevant attributes and special commands for that element
define method .selectcomponent(!item is STRING)

if !item.match('IL').gt(0) then
  !this.actionlist.clear()
  return
endif

if !!ce.neq(!item.dbref()) then
  !!ce = !item.dbref()
endif

!selection = !item.dbref()
!component = object PIPEASSEMBLYCOMPONENT(!selection)
!this.currentcomp = !component
if !selection.ddepth.eq(7) then
  -- its a branch member
  !this.getcomponentrules(!item)
else
 -- its a branch pipe zone or APPLDA
     if !selection.type inset('BRAN','PIPE','ZONE') then
       !this.actionlist.clear()
       return
     else
        !this.getassemblyrules(!item)
     endif
endif

endmethod



------------------------------------------------------------------------------
define method .getcomponentrules(!item is STRING)

!component = !this.currentcomp

!dtext = ARRAY()
!col1  = ARRAY()
!col2  = ARRAY()
!rtext = ARRAY()
-- now go and compile the list

!heading[1] = 'Rule'
!heading[2] = 'Type'
!heading[3] = 'Value'
!col[1] = ARRAY()
!col[2] = ARRAY()
!col[3] = ARRAY()
!col[1].append('Stype')
!col[2].append('')
!col[3].append('')
!rtext.append('STYP')
do !a values !component.styperules

   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2] & ' (' & !a.split(',')[3] & ')' )
   handle any
     !col[3].append(!a.split(',')[2] )
     !rtext.append(!a.split(',')[3])
   elsehandle NONE
     !rtext.append(!a.split(',')[4])
   endhandle
enddo
$(
!col[1].append('Selection')
!col[2].append('')
!col[3].append('')

!rtext.append('SELE')
do !a values !component.Selectionrules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
$)
!col[1].append('Position')
!col[2].append('')
!col[3].append('')

!rtext.append('POSI')
do !a values !component.posrules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
!col[1].append('Orientation')
!col[2].append('')
!col[3].append('')
!rtext.append('ORIE')
do !a values !component.orirules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
!col[1].append('Bore Selection')
!col[2].append('')
!col[3].append('')
!rtext.append('LBOR')
do !a values !component.lborerules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !element = !a.split(',')[3].dbref()
   !value = !element.valrule
   !newrule = $!value
   !col[3].append(!a.split(',')[2] & ' OF ' & !newrule.flnm)
   !rtext.append(!a.split(',')[3])
enddo
$(
!col[1].append('Naming')
!col[2].append('')
!col[3].append('')
!rtext.append('NAME')
do !a values !component.namerules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
$)

  !this.actionlist.setheadings( !heading )
  !this.actionlist.setcolumns( !col )
  !this.actionlist.rtext = !rtext
  !this.selectelement(!item)

endmethod
