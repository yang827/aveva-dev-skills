------------------------------------------------------------------------------
define method .getassemblyrules(!item is STRING)

!component = !this.currentcomp

!dtext = ARRAY()
!col1  = ARRAY()
!col2  = ARRAY()
!rtext = ARRAY()
-- now go and compile the list

!heading[1] = 'Rule'
!heading[2] = 'Type'
!heading[3] = 'Value'
!col[1] = ARRAY()
!col[2] = ARRAY()
!col[3] = ARRAY()
!col[1].append('Form')
!col[2].append('')
!col[3].append('')
!rtext.append('FORM')
do !a values !component.formrules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
!col[1].append('Function')
!col[2].append('')
!col[3].append('')
!rtext.append('FUNC')
do !a values !component.funcrules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
!col[1].append('Primary Origin')
!col[2].append('')
!col[3].append('')
!rtext.append('ORIP')
do !a values !component.primaryrules

   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append('P ' & !a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
!col[1].append('Secondary Origin')
!col[2].append('')
!col[3].append('')
!rtext.append('ORIS')
do !a values !component.secondaryrules
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append('P ' & !a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo

$(
!col[1].append('Bore Exclusions')
!col[2].append('')
!col[3].append('')
!rtext.append('BORE')
do !a values !component.borerestrictions
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
!col[1].append('Specifications')
!col[2].append('')
!col[3].append('')

!rtext.append('SPEC')
do !a values !component.specrestrictions
   !col[1].append('')
   !col[2].append(!a.split(',')[1])
   !col[3].append(!a.split(',')[2])
   !rtext.append(!a.split(',')[3])
enddo
$)

!this.actionlist.setheadings( !heading )
!this.actionlist.setcolumns( !col )
!this.actionlist.rtext = !rtext

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method for editing the current rule
define method .editrule()

  -- !element can be a text like STYP POSI or the reference of a validvalue
  !element = !this.actionlist.selection().dbref()
  handle any
    -- we have not picked a validvalue - we've picked a heading
    !!alert.error('No Rule selected')
    return
  endhandle

  !!pipeassemblyrules.current = !element
  handle any
    pml load form !!pipeassemblyrules
    !!pipeassemblyrules.current = !element
  endhandle
  if !element.unset() then
        !!alert.error('No Valid Elements!')
        return
  endif

  !!pipeassemblyrules.designcomponent = !this.explorerselected
  handle any
  endhandle

  if !element.type.eq('DDAT') then
    !type = !element.dkey
  else
    !type = !element.owner.dkey
  endif
  !!pipeassemblyrules.purp = !type
  !!pipeassemblyrules.mode = 'Edit'

  show !!pipeassemblyrules

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for inserting a rule into the assembly definition
define method .newrule()

   !!pipeassemblyrules.mode = 'New'
   handle any
    pml load form !!pipeassemblyrules
    !!pipeassemblyrules.mode = 'New'
  endhandle
  !!pipeassemblyrules.designcomponent = !this.explorerselected
  -- !!pipeassemblyrules.designcomponent = !!ce
  -- if the rtext is pointing to an element then we go to that
  !element = !this.actionlist.selection().dbref()
  handle any
     !type = !this.actionlist.selection()
     -- its coming out as stype
     !!pipeassemblyrules.purp = !type
     !!pipeassemblyrules.current = !this.assembly.dataset
     !!pipeassemblyrules.designcomponent = !this.explorerselected
     !!pipeassemblyrules.settagtext()
  elsehandle NONE
    if !element.unset() then
        !!alert.error('No Valid Elements!')
        return
    endif
    -- we have a dbref defined
     !dkey = !element.owner.dkey
     !!pipeassemblyrules.purp = !dkey
     !!pipeassemblyrules.current = !element
  endhandle

  show !!pipeassemblyrules

endmethod
