--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkSimilar()                   -
--  collect()                        -
--  createNew()                      -
--  getAttributes()                  -
--  getAutoname()                    STRING
--  init()                           -
--  ok()                             -
--  pickOrigin()                     -
--  pickOrigin(EDGPICKDATA)          -
--  pickPoint(EDGPICKDATA)           -
--  pipeAssemblyRules()              -
--  setGadgets(DBREF,REAL)           -
--  setTagText()                     -
--  setValues()                      -
--  validate(GADGET)                 -
--
------------------------------------------------------------------------
-- Define form
setup form !!pipeAssemblyRules at xr 0 yr 0

  title    |Pipe Assembly Rules|
  init     |!this.init()|
  iconti   |ASSY Rule|

 -- Template Name
  --text .NAME   |Name:         | at xmin ymax callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 32 name
  para .name   width 32 lines 1


 -- Data
  path down

  frame  .purpframe |                               |
    text   .desc    |Specification:| call '!this.validate(!this.desc)'  width 32 STRING
    option .boreopt |Bore Type:    | at xmin.desc ymin.desc width 30
    text   .func    |Stype:        |   width 32 string
    toggle .setAll  |Apply to Similar Items|
    path right
    toggle .exclusive |Force this SPEC/STYPE|
    button .pick at xmin.func  ymin call |!this.pickOrigin()|
  exit
  -- Bottom Line
  button .apply   |  OK  | at xmin form+0 ymax+0.5 call |!this.ok()|
  button .dismiss |Cancel| at xmax form-size ymin  cancel

 !a[1] = 'Leave Point '
 !a[2] = 'Arrive Point'
 !a[3] = 'PPoint 3    '
 !a[4] = 'PPoint 4    '
 !this.boreopt.dtext = !a

 !a[1] = 'LEAV'
 !a[2] = 'ARRI'
 !a[3] = 'PP3'
 !a[4] = 'PP4'
 !this.boreopt.rtext = !a

 -- Userdata

 member .mode                  is STRING
 -- Creation mode flag
 member .type                  is STRING
 -- Create type
 member .rule                  is STRING
 -- value of the expression being used
 member .current               is DBREF
 -- Item to Modify/place to create
 member .designComponent       is DBREF
 member .purp                  is STRING
 member .purpcode              is STRING
 member .dataset               is DBREF
 member .assembly              is DBREF
 member .copyComp              is DBREF
 member .designPoint           is REAL
 member .formtype              is REAL
 member .comps                 is ARRAY

-- End of form definition
exit
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .pipeAssemblyRules()

!this.formtype = 1

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .setTagText()
   !this.desc.visible      = TRUE
   !this.desc.settooltip(' ')
   !this.func.visible      = TRUE
   !this.func.active       = TRUE
    !this.func.settooltip(' ')
   !this.setAll.visible    = FALSE

   !this.exclusive.visible = FALSE
   !this.boreopt.visible   = FALSE
   !this.pick.visible      = FALSE
   !this.checkSimilar()
   if !this.purp.eq('FORM') then
      !this.purpframe.tag = 'Build by Form'
      !this.desc.tag = |Form Name:    |
      !this.func.tag = |              |
      !this.func.visible = FALSE
      !this.func.active = FALSE
      !this.desc.settooltip('Enter Form name without !! and () ')
   elseif !this.purp.eq('FUNC') then
      !this.purpframe.tag = 'Build by Function:'
      !this.desc.tag = |Function Name:|
      !this.func.tag = |              |
      !this.func.active = FALSE
      !this.func.visible = FALSE
      !this.desc.settooltip('Enter pml Function name without !! and () ')
   elseif !this.purp.eq('ORIP') then
      !this.purpframe.tag = 'Primary Origin Element:'
      !this.formtype = 1
      !this.desc.tag = |Element:        |
      !this.func.tag = |PPOINT:         |
      !this.func.visible = TRUE
      !this.func.active = TRUE
      !this.pick.visible = TRUE
      !this.desc.settooltip('Select a component within the current assembly')
      !this.func.settooltip('Enter the ppoint number on the selected element')
   elseif !this.purp.eq('ORIS') then
      !this.formtype = 1
      !this.purpframe.tag = 'Secondary Origin Element:'
      !this.desc.tag = |Element:        |
      !this.func.tag = |PPOINT :        |
      !this.func.visible = TRUE
      !this.func.active = TRUE
      !this.pick.visible = TRUE
      !this.desc.settooltip('Select a component within the current assembly')
      !this.func.settooltip('Enter the ppoint number on the selected element')
   elseif !this.purp.eq('BORE') then
      !this.purpframe.tag = 'Excluded Bore sizes'
      !this.desc.tag = |Bore:         |
      !this.func.tag = |              |
      !this.func.visible = FALSE
      !this.func.active = FALSE
   elseif !this.purp.eq('LBOR') then
      !this.formtype = 2
      !this.purpframe.tag = 'Bore Size'
      !this.desc.tag = |Current Point:|
      !this.func.tag = |Copy From:    |
      !this.desc.visible = FALSE
      !this.func.visible = TRUE
      !this.func.active  = TRUE
      !this.boreopt.visible = TRUE
      !this.pick.visible = TRUE
      !this.func.settooltip('Pick a ppoint in the current assembly')
   elseif !this.purp.eq('SPEC') then
      !this.purpframe.tag = 'Excluded Specification'
      !this.desc.tag = |Specification:|
      !this.func.tag = |      |
      !this.func.visible = FALSE
      !this.func.active = FALSE
      !this.desc.settooltip('Enter a piping Specification Name - including "/" ')
   elseif !this.purp.eq('STYP') then
      !this.purpframe.tag = 'Alternative STYPE'
      !this.desc.tag = |Specification:|
      !this.func.tag = |Stype:        |
      !this.setAll.visible = TRUE
      !this.exclusive.visible = TRUE
      !this.exclusive.settooltip('Use this SPEC/STYP combination on all pipes')
      !this.desc.settooltip('Enter a piping Specification Name - including "/" ')
   elseif  !this.purp.eq('SELE') then
      !this.purpframe.tag = 'Specific Selection Rule'
      !this.desc.tag = |Arrive/leave: |
      !this.func.tag = |Bore:         |
      !this.desc.settooltip('Enter a selection command - SEL WI STYP RF')
      !this.setAll.visible = TRUE
   elseif  !this.purp.eq('POSI') then
      !this.purpframe.tag = 'Positioning Command'
      !this.desc.tag = |DIST,THRO etc:|
      !this.func.visible = FALSE
      !this.func.active = FALSE
      !this.desc.settooltip('Enter a positioning command like - DIST 250 ')
   elseif  !this.purp.eq('ORIE') then
      !this.purpframe.tag = 'Orientation Command'
      !this.desc.tag = |Orientation:  |
      !this.func.visible = FALSE
      !this.func.active = FALSE
      !this.desc.settooltip('Enter an orientation command like - ORI AND P3 IS N WRT PREV')
   else
   -- its a name
      !this.purpframe.tag = 'Name Command'
      !this.desc.tag = |Name:         |
      !this.func.tag = |text:         |
      !this.func.visible = FALSE
      !this.func.active = FALSE
   endif


!this.name.val = 'Name: ' & !this.getAutoname()

endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
define method .init()

  -- !!ce = !this.current
  !!ce = !this.designComponent
  APPLDA
  !this.assembly = !!ce
  ddse 1
  handle any
    !!alert.error('Assembly has no dataset')
    return
  endhandle
  !this.dataset = !!ce
   !!ce = !this.designComponent
  if !this.mode.eq('Edit') then
    !rule = !this.current
    !this.getAttributes()
  elseif !this.mode.eq('Delete') then
    !!ce = !this.current
    !type = !!ce.type
    if !!alert.confirm('Ok to delete $!type').eq('YES') then
      delete $!type
      applda
      !!pipeassemblymgr.selectcomponent(!!ce.string())
    endif
  else
  -- it must be new
    !this.desc.val = ''
    !this.func.val = ''
    !this.exclusive.val = false
  endif


  !this.setTagText()

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .getAutoname() is STRING


  !applda = APPLDA
  !seedName = !applda.name & '-DDSE-'
  if !this.purp.eq('FORM') then
     !name = !seedName & 'FORM'
  elseif !this.purp.eq('FUNC') then
     !name = !seedName & 'FUNC'
  elseif !this.purp.eq('ORIP') then
     !name = !seedName & 'ORIP'
  elseif !this.purp.eq('ORIS') then
     !name = !seedName & 'ORIS'
  elseif !this.purp.eq('SPEC') then
     !name = !seedName & 'SPEC'
  elseif !this.purp.eq('STYP') then
     !name = !seedName & !this.designComponent.name & '-STYP'
  elseif  !this.purp.eq('SELE') then
     !name = !seedName & !this.designComponent.name & '-SELE'
  elseif  !this.purp.eq('POSI') then
     !name = !seedName & !this.designComponent.name & '-POSI'
  elseif  !this.purp.eq('ORIE') then
     !name = !seedName & !this.designComponent.name & '-ORI'
  elseif !this.purp.eq('LBOR') then
     !name = !seedName & !this.designComponent.name & '-LBOR'
  else
  -- its a name
     !name = !seedName & !this.designComponent.name & '-NAME'
  endif

  return !name


endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
define method .getAttributes()

!save = !!ce
-- assuming we are at a valid value

   !item = !this.current
   if !item.type.eq('DDAT') then
      !dkey = !item.dkey
   else
      !dkey = !item.owner.dkey
   endif
 -- !this.purp.select('rtext',!dkey)
   !this.setTagText()
   if !dkey inset('ORI','NAME','SELE') then
     -- its a set of valid values for spec and stype
       !this.setGadgets(!item, 2)
   elseif !dkey inset('FUNC','FORM','POSI','ORIE') then
      !this.setGadgets(!item, 3)
   elseif !dkey inset('SPEC') then
    !this.setGadgets(!item, 1)
   elseif !dkey inset('STYP') then
      !this.setGadgets(!item, 4)
   elseif !dkey inset('ORIP') then
      !this.setGadgets(!item, 5)
   elseif !dkey inset('ORIS') then
      !this.setGadgets(!item, 6)
   elseif !dkey inset('LBOR') then
      !this.setGadgets(!item, 7)
   else
      !!alert.error('Badly defined Data Element in Design Dataset')
   endif

!!ce = !save

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
-- method to set the form gadgets based on the form type.
define method .setGadgets(!rule is DBREF, !nTexts is REAL)

  if !nTexts.eq(1) then
     !text = !rule.validvalue
     !spec  = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||)
     !this.desc.val = !spec
     !this.func.val = ''
  elseif !nTexts.eq(2) then
     !text = !rule.validvalue
     !spec  = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
     !stype = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
     !this.desc.val = !spec
     !this.func.val = !stype
  elseif !nTexts.eq(3) then
     !text = !rule.validvalue
     !spec  = !text.replace(|'|,||).replace(|(|,||,1).replace(|)|,||,-1)
     !this.desc.val = !spec
     !this.func.val = ''
  elseif !nTexts.eq(4) then
     !text = !rule.validvalue
     !spec  = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
     !stype = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
     !opti  = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[3]
     handle any
       !opti = FALSE
     endhandle
     !this.desc.val = !spec.trim('l')
     !this.func.val = !stype.trim('l')
     !this.exclusive.val = $!opti
  elseif !nTexts.eq(5) then
     !text = !rule.cfdp.orip.string()
     !number  = !rule.number
     !this.desc.val = !text
     !this.func.val = '$!number'
  elseif  !nTexts.eq(6) then
     !text = !rule.cfdp.oris.string()
     !number  = !rule.number
     !this.desc.val = !text
     !this.func.val = '$!number'
   else
   -- its a LBOR
     !text = !rule.validvalue
     !elementRule = !rule.valrule
     !this.copyComp = $!elementRule
     !boreType  = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1].trim()
     !stype    = !text.replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
     !final = !stype & ' OF ' & !this.copyComp.flnm
     !this.boreopt.select('RTEXT',!boreType)
     handle any
     endhandle
     !this.func.val = !final
  endif


endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
define method .ok()

     !currentElement = !!ce
     if !this.mode.eq('Edit') then
     --!this.collect()
--CW if we are in Edit mode we need to be able to change rules for similar items
     if !this.setAll.val then
 --run a method to collect components
     !this.collect()

--navigate to applda
    applda
    !applda = !!ce
    !!ce = !applda
    1
    !d = !!ce.members

 --CW we need to run a a method to check if a similar item has a rule set
 --Get the ddprops of all rules

    !ddprop = ARRAY()
    do !n index !d
     !ddprop.append(!d[!n].ddprop)
    enddo

--now get the names/refnos of the similar items
      !name = ARRAY()
      do !b index !this.comps
        !name.append(!this.comps[!b].string())
      enddo

--now check if the refno exists in the array of ddprops

 !newlist = ARRAY()
  do !c index !ddprop
    do !w index !name
      if !ddprop[!c].occurs(!name[!w]).gt(0) then
      !newlist.append(!name[!w])
      break
      endif
    enddo
  enddo
!notlist = !name.difference(!newlist)

 --navigate to items without rules and create new rule

 do !create index !notlist
 !!ce = !notlist[!create].dbref()
 !this.designComponent = !!ce
 !this.createNew()

 enddo




--check components and set validvalue for rule
   do !a index !d
      do !b index !this.comps
        !g = !this.comps[!b].string()


          if !d[!a].name.occurs(!g).gt(0) then
            if !this.func.active.not() then
              !string = '( |' & !this.desc.val & '|)'
            else
              !string = '( |' & !this.desc.val & '%' & !this.func.val & '|)'
            endif

            if !this.exclusive.visible then
               !string = '( |' & !this.desc.val & '%' & !this.func.val & '%' & !this.exclusive.val & '|)'
            endif
       !d[!a].members[1].validvalue = !string

       endif
      enddo
    enddo
  else

   !this.setValues()
  endif

 !!ce = !currentElement

--CW  to edit similar - set values for ddats of similar items

  if !this.mode.eq('Edit') then
   if !this.setAll.val then
     !similar = !this.comps
     do !a values !similar
       !this.setValues()
     enddo
     Handle ANY
     endhandle
     !!ce = !currentElement
     if !this.comps.size().gt(1) then
       !x = !this.comps
        do !a values !x
         !this.designComponent = !a
        enddo
     endif
    endif
   endif
  endif

   if !this.purp inset('ORIP','ORIS') then
       APPLDA
       !!pipeassemblymgr.selectcomponent(!!ce.string())
    -- elseif !this.purp inset( 'LBOR') then
    else
      !!pipeassemblymgr.selectcomponent(!this.designComponent.string())
    endif

   if !this.mode.eq('New') then
      if !this.setAll.val then
        if !this.comps.size().gt(1) then
          !x = !this.comps
           do !a values !x
           !this.designComponent = !a
           !this.createNew()
           enddo
        endif
       else
           !this.createNew()
     endif
   endif

    --CW update main form display with new rule
       !q =  ARRAY()
       !q[0] = !this.designComponent.string()
       !!pipeassemblymgr.EXPLORERSELECT(!q)
       !!ce = !this.designComponent

   !!ce = !currentElement

  !this.hide()


endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
-- method for creating and editing
define method .createNew()
     !!ce = !this.dataset

     !name = !!ce.name & '-' &  !this.designComponent.string()  & '-' & !this.purp
     -- there is no current ddat
     $!name
     handle any
       new ddat $!name
       handle any
          !!alert.error('Name Already Defined')
       endhandle
       dkey $!this.purp
     elsehandle NONE
       dkey $!this.purp
     endhandle
     !!ce.ddproperty = !this.designComponent.name.string()
     --!!ce.ddproperty = !this.designComponent.string()
    --!name = !!ce.owner.name & '-' &  !this.designComponent.string()  & '-' & !this.purp
    -- don't bother to name valid values
    if !this.purp inset('ORIP','ORIS') then
       dkey $!this.purp
       number $!this.func.val
    else
       new vvalue
       !this.current = !!ce
       !this.setValues()

   --CW update main form display with new rule
       !q =  ARRAY()
       !q[0] = !this.designComponent.string()
       !!pipeassemblymgr.EXPLORERSELECT(!q)
       !!ce = !this.designComponent
    endif
endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
-- method for setting the vvalue values
define method .setValues()
   !!ce = !this.current

   if !this.purp inset('ORIP','ORIS') then
       dkey $!this.purp
       number $!this.func.val
       return
   endif


   if !this.purp inset('LBOR') then
       if !this.designPoint.eq(!this.copyComp.arrive) then
           !desPoint = 'ABORE'
       elseif !this.designPoint.eq(!this.copyComp.leave)  then
           !desPoint = 'LBORE'
       else
           !desPoint = 'PBORE['  &  !this.designPoint  & ']'
       endif
       !string = '( |' & !this.boreopt.selection() & '%' & !desPoint & '|)'
       !!ce.validvalue = !string
       !!ce.valrule = !this.copyComp.name.string()
       return
   endif


   if !this.func.active.not() then
       !string = '( |' & !this.desc.val & '|)'
   else
       !string = '( |' & !this.desc.val & '%' & !this.func.val & '|)'
   endif


   if !this.exclusive.visible then
      !string = '( |' & !this.desc.val & '%' & !this.func.val & '%' & !this.exclusive.val & '|)'
   endif
   !!ce.validvalue = !string
   !!ce.valrule = !this.designComponent.name.string()
endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .pickOrigin()


 -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'Piping'
  !packet.type        = 'Piping'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = 'Piping'
  if !this.formtype eq 1 then
     !packet.action = '!!pipeAssemblyRules.pickOrigin(!this.return[1])'
  else
     !packet.action = '!!pipeAssemblyRules.pickPoint(!this.return[1])'
  endif
  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPpoint('Pick a point')

  !!edgcntrl.add(!packet)


endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
-- method to sect a point on the assembly to be used to copy a bore size
define method .pickPoint(!action is EDGPICKDATA)

!!ce = !action.item
applda
handle any
   !!alert.error('Identified Component is not part of the Current Assembly')
   return
endhandle
if !!ce.neq(!this.assembly) then
   !!alert.error('Identified Component is not part of the Current Assembly')
   return
endif


!this.copyComp     = !action.item
!this.designPoint  = !action.point

!text = !this.copyComp.flnm
if !this.designPoint.eq(!this.copyComp.arrive) then
    !desPoint = 'ABORE'
elseif !this.designPoint.eq(!this.copyComp.leave)  then
    !desPoint = 'LBORE'
else
    !desPoint = 'PBORE['  &  !this.designPoint & ']'
endif

!this.func.val =  !desPoint & ' OF ' & !text

endmethod
-------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------
define method .pickOrigin(!action is EDGPICKDATA)

!!ce = !action.item
applda
handle any
   !!alert.error('Identified Component is not part of the Current Assembly')
   return
endhandle
if !!ce.neq(!this.assembly) then
   !!alert.error('Identified Component is not part of the Current Assembly')
   return
endif

!this.designComponent = !action.item
!this.desc.val = !action.item.string()
!this.func.val = !action.point.string()

endmethod
-------------------------------------------------------------------------------------

define method .validate(!gadget is GADGET)
-- method to validate the input to the .desc gadget
-- this method may be used later to perform further validations
-- the input type varies according to the form purpose which may be:
-- purp 'FORM' tag = 'Build by Form' gadget tag = |Form Name:    |
-- purp 'FUNC' tag = 'Build by Function' gadget tag = |Function Name:|
-- purp 'ORIP' tag = 'Primary Origin Element: gadget tag = |Element:        |
-- purp 'ORIS' tag = 'Secondary Origin Element:'  gadget tag = |Element:        |
-- purp 'BORE' tag = 'Excluded Bore sizes' gadget tag = |Bore:         |
-- purp 'LBOR' tag = 'Bore Size' gadget tag = |Current Point:|
-- purp 'SPEC' tag = 'Excluded Specification' tag = |Specification:|
-- purp 'STYP' tag = 'Alternative STYPE' gadget tag = |Specification:| func.tag = |Stype:|
-- purp 'SELE' tag = 'Specific Selection Rule' gadget tag = |Arrive/leave: | func.tag = |Bore:|
-- purp 'POSI' tag = 'Positioning Command' tag = |DIST,THRO etc:|
-- purp 'ORIE' tag = 'Orientation Command' gadget tag = |Orientation:  |
-- purp 'NAME' tag = 'Name Command' gadget tag = |Name: | func.tag = |text:|

if !gadget.eq(!this.desc) then
  if !this.purp.eq('STYP').or(!this.purp.eq('SPEC'))then
   -- we are checking a spec name
   !this.desc.val = !!checkName(!gadget.val,'SPEC')
  endif
endif

endmethod
-------------------------------------------------------------------------------------

define method .collect()
   !comps = ARRAY()
  if !this.designComponent.type inset('APPLDA','DDSE') then
  	return
  endif
  	
   !type  = !this.designComponent.type
   !stype = !this.designComponent.stype
   !spec  = !this.designComponent.spown
   !pipe  = !this.designComponent.owner.owner
   var !all coll all $!type for $!pipe
   var !specs eval spown for all from !all
   var !stypes eval stype for all from !all
   do !a index !all
     if !specs[!a].dbref().eq(!spec).and(!stypes[!a].eq(!stype)) then
         !comps.append(!all[!a].dbref())

     endif
   enddo
   !this.comps = !comps
endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------

define method .checkSimilar()

--check for similar items within the assembly and enable apply to similar as required

!currentElement = !!ce

 --run a method to collect components
     !this.collect()

     !d = ARRAY()
     !similar = !this.comps
  	 !this.setAll.active = true
     !this.setAll.val = false


     if !similar.size().lt(2) then
  	    !this.setAll.val = false
  	    !this.setAll.active = false
  	 endif

 !!ce = !currentElement



endmethod
