  -------------------- Branch Specification
  paragraph .sbTag        anchor left + right + top         at x0.5               ymax.branchName+0.2 text 'Select Branch Specification:'
  line .sbLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  list .branSpecList      anchor all                        at x0.5               ymax.sbLine+0.2     callback '' single zeroSelection width to max.cpLine lines 8

  -------------------- Basic Process Information
  paragraph .pbTag        anchor left + right + bottom      at x0.5               ymax                text 'Basic Process Data'
  line .pbLine            anchor left + right + bottom at x0 ymax-0.2   horiz     width.cpLine  hei 0
  !tagw = 12
  -- Insulation
  option .branInsulation tagwid $!tagw 'Insulation:' anchor left + right + bottom at x2        ymax+0.1            width 10

  -- Tracing
  option .branTracing tagwid $!tagw   'Tracing:' anchor left + right + bottom at x2        ymax+0.1            width 10

  -- Basic Branch information
  text   .branTemperature tagwid $!tagw 'Temperature:' anchor left + right + bottom at x2        ymax+0.1            width 10 is REAL format !!temperatureFmt
  text   .branPressure tagwid $!tagw    'Pressure:' anchor left + right + bottom at x2        ymax+0.1            width 10 is REAL  format !!pressureFmt
  option .branSlopeList tagwid $!tagw   'Slope Ref:' anchor left + right + bottom at x2   ymax+0.1      width 14


  -- Modify Branch Data Buttons
  button .cancelBranData  '  Back '   anchor right + bottom at xmax.pbLine-size   ymax+0.1            callback '!this.setTask(|editBranch|)' tooltip 'Cancel changes'
  path left
  button .applyBranData   ' Apply '   anchor right + bottom                                           callback '!this.modifyBranch()'        tooltip 'Apply changes to branch'

  -------------------- Pipe Specification
  paragraph .spTag        anchor left + right + top                at xmin.namesystemReference+0.5  ymax.namesystemReference+0.2   text 'Select Pipe Specification:'
  line .spLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  list .pipeSpecList      anchor all                        at x0.5               ymax.spLine+0.2     callback '!this.selectPipeSpecification()' single zeroSelection width to max.cpLine lines 22

  -------------------- Basic Process Information
  paragraph .ppTag        anchor left + bottom              at x0.5               ymax                text 'Basic Pipe Process Data'
  line .ppLine            anchor left + right + bottom at x0 ymax-0.2   horiz     width.cpLine  hei 0
  !tagw = 12
  -- Available Bore
  option .pipeBore tagwid $!tagw       'Bore:'       anchor left + right + bottom at x2              ymax+0.1      callback '' tooltip 'Default nominal bore'  width 10

