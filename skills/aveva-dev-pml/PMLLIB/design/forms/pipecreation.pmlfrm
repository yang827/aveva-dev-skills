-- Description:
--  Pipe creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  branchDataGadgets(BOOLEAN)       -                   Shows/Hides the gadgets associated with branch data
--  branchName(PIPEBRANCH)           STRING              Select pipe specification
--  branchTableGadgets(BOOLEAN)      -                   Shows/Hides the gadgets associated with the branch table
--  changeEnd()                      -                   Modify end connection data
--  changeName(DBREF,STRING)         -                   Change elements name
--  close()                          -                   Close form
--  collectSlopes()                  ARRAY               gets a list of slope elements for display and sets up the
--  connectEnd()                     -                   Name of connection item
--  connectEndGadgets(BOOLEAN)       -                   Shows/Hides the gadgets associated with connecting the end
--  connectionData(DBREF)            ARRAY               Get component connection data, returns information via
--  connectionElement(DBREF)         DBREF               Returns the relevant element type for connection
--  connectionName()                 -                   Get connection info from name gadget
--  connectionName(DBREF)            -                   Get connection info from passed element
--  connectionPick()                 -                   Pick item to connect to
--  connectionPick(EDGPICKDATA)      -                   Pick item to connect to
--  connectivityData()               -                   Generate and display connectivity information
--  coordinateSettings()             -                   Setting the format of positional gadgets according to present coordinate system.
--  copyEnd(STRING)                  -                   copy the current branch end to the opposite branch end
--  create(DBREF)                    BOOLEAN             Create pipe
--  createBranch()                   -                   Create a new branch
--  createBranch(BOOLEAN)            -                   Create a new branch
--  createPipe()                     -                   Create a new pipe
--  createPipeGadgets(BOOLEAN)       -                   Shows/Hides the gadgets associated with creating pipe
--  dbChanged()                      -                   Database has been modified
--  direction(GADGET,STRING)         -                   Check direction
--  disconnect()                     -                   Disconnect branch head/tail
--  editBranchGadgets(BOOLEAN)       -                   Shows/Hides the gadgets associated with the edit branch
--  editEndRefGadgets(BOOLEAN)       -                   Shows/Hides the gadgets associated with the branch head ref
--  editHeadGadgets(BOOLEAN)         -                   Shows/Hides the gadgets associated with the branch head
--  editTailGadgets(BOOLEAN)         -                   Shows/Hides the gadgets associated with the branch tail
--  endBore(STRING)                  BORE                Get current end bore
--  endConnection(STRING)            STRING              Get current end connection
--  endDirection(STRING)             DIRECTION           Get current end direction
--  endPosition(STRING)              POSITION            Get current end position
--  getPositionControlPos(ARRAY)     POSITION            returns the position in appropriate unit from POSITIONCONTROL gadget
--  hPos(EDGPOSITIONDATA)            -
--  loadBores(GADGET,BORE,DBREF)     -                   Load bore gadget with available bore
--  loadBranchEnd()                  -                   Generate and display branch end information
--  loadBranchEndRef()               -                   Generate and display branch end ref information
--  loadCocos()                      -                   Load cocos
--  loadTubes(GADGET,BORE,DBREF)     REAL
--  modify(DBREF)                    BOOLEAN             Modify pipe
--  modifyBranch()                   -                   Modify branch
--  modifyBranchDataGadgets(BOOLEAN) -                   Shows/Hides the gadgets associated with modifying branch data
--  modifyBranchEnd()                -                   Modify branch end
--  modifyPipe()                     -                   Modify pipe
--  modifyPipeDataGadgets(BOOLEAN)   -                   Shows/Hides the gadgets associated with modifying pipe data
--  modifyPipeGadgets(BOOLEAN)       -                   Shows/Hides the gadgets associated with creating pipe
--  nameBranch()                     -                   Check name of branch
--  namePipe()                       -                   Check name of pipe
--  pickposH()                       -
--  pickposT()                       -
--  pipeCreation()                   -                   Constructor
--  pipeDataGadgets(BOOLEAN)         -                   Shows/Hides the gadgets associated with pipe data
--  posControl()                     -                   Initialising the posControl gadgets.
--  reconnect()                      -                   Reconnect branch head/tail
--  resumeTask()                     -                   Revert to current task after a warning
--  selectBranch()                   -                   Select pipe specification
--  selectConnection()               -                   Name of connection item
--  selectPipeSpecification()        -                   Select pipe specification
--  setHeadTailPosition(EDGPOSITIONDATA,STRING) -
--  setTask(STRING)                  -                   Switch the relevant panels in and out for passed task
--  setupBranchData()                -                   Setup branch data
--  setupPipeData()                  -                   Setup pipe data
--  setupSpecifications()            -                   Setup Specifications
--  setupSystemReference()           -                   setup System Reference
--  state()                          -                   Handles state of form when serialisation
--  tPos(EDGPOSITIONDATA)            -
--  tagBranch(DBREF)                 -                   Tag branch selected in the branch list
--  tagConnection()                  -                   Tag potential connection
--  tagEnd()                         -                   Tag branch end being changed
--  tidy()                           -                   Tidy up aid graphics
--  updateBranchData()               -                   Setup Branch Data
--  updatePipeData()                 -                   Setup Pipe Data
--  warning(ARRAY,BOOLEAN)           -                   Set warning task and message
--  warning(ARRAY,STRING)            -                   Set warning task and message
--  warningGadgets(BOOLEAN)          -                   Shows/Hides the gadgets associated with the spec task
--
------------------------------------------------------------------------
  --Import DLL
  import 'PositionControl'
  handle ANY
  endhandle

layout form !!pipeCreation dialog dock right AutoAlign
--setup form !!pipeCreation dialog dock right varchars

  !this.iconTitle     = 'Pipe Creation'
  !this.formTitle     = 'Pipe Creation'
  !this.callback      = '!this.state()'
  !this.formRevision  = ' $Revision: 1.12 $ '
  track 'DBCHANGED' call '!this.dbChanged()'

  -------------------- Pipe Creation
  paragraph .cpTag         anchor left + top                           text 'Create New Pipe:'
  paragraph .mpTag         anchor left + top         at xmin  ymin     width 4  line 1
  paragraph .pipeNameTag   anchor left + right + top                   width 22 line 1
   -- Set branch P-25681 create pipe form should have an option to change current pipe
  button    .selectBranch 'Set Pipe'  anchor right+top  at x 24            callback '!this.modify(!!ce)'  tooltip 'Set working pipe'

  line .cpLine            anchor left + right + top at x0 ymax   horiz     width to max.selectBranch  hei 0
  -- Pipe Name
  --text  .pipeName 'Pipe Name' anchor left + right + top     at xmin.cpTag  ymax+0.2            callback '!this.namePipe()' width 22 is STRING
   text  .pipeName 'Pipe Name' anchor left + right + top     at xmin.cpTag  ymax+0.2            callback '!this.namePipe()' width to max.cpLine is STRING
  ------------------

  paragraph .namesystemReference    anchor l+t     at xmin.pipeName     ymax.pipeName  text  'Primary System:'  width 11
  option    .systemReference        anchor left + right + top  at xmax  ymin width to max.pipeName

  -- Pipe Specification
  paragraph .pipeSpecTag      anchor left + top             at x1                 ymax.cpLine+0.1     text 'Spec:'
  paragraph .pipeSpec         anchor left + right + top     at xmax               ymin                width 20 lines 1

  -- Modify pipe attributes
  button .changePipeData 'Change Detail' anchor right + top at xmax.pipeName-size ymin                callback '!this.setTask(|modifyPipeData|)' tooltip 'Change pipe detail'

  -------------------- Connectivity Information
  -- Connectivity information
  paragraph .cTag         anchor left + top                 at x0.5               ymax.changePipeData text 'Connectivity:'
  line .cLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  list .connectionTable   anchor left + right + top         at x0.5               ymax.cLine+0.2      callback '!this.selectBranch()' columns single zeroSelection  width to max.cpLine lines 6

  -- Create new branch
  button .newBranch 'New Branch' anchor left + top          at xmin               ymax+0.2            callback '!this.createBranch()'  tooltip 'Create a new branch'

  -------------------- Edit selected branch
  -------------------- Branch Information
  paragraph .mbTag          anchor left + top               at x0.5               ymax.newBranch      width 6
  paragraph .branchNameTag  anchor left + right + top       at xmax               ymin                width 22 line 1
  line .mbLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  -- Pipe Name
  text  .branchName 'Branch Name' anchor left + right + top at xmin.mbLine        ymax.mbLine+0.2     callback '!this.nameBranch()' width 16 is STRING
  -- Pipe Specification

  paragraph .branchSpecTag  anchor left + top               at x1                 ymax.mbLine+0.1     text 'Spec:'
  paragraph .branchSpec     anchor left + right + top       at xmax               ymin                width 20 lines 1

  -- Modify BRANCH attributes
  button .changeBranchData 'Change Detail' anchor right + top at xmax.mbLine-size ymin                callback '!this.setTask(|modifyBranchData|)' tooltip 'Change branch detail'

  -- Branch Head Detail
  paragraph .branHeadTag  anchor left + top                 at x0.5               ymax+0.2            text 'Head Detail:'
  line .bhLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0

  paragraph .headBore     anchor left + top                 at x0.5               ymax                width 10 lines 1
  paragraph .headConn     anchor left + right + top         at x11                ymin                width 16 lines 1
  paragraph .headDir      anchor left + right + top         at x0.5               ymax-0.3            width 28 lines 1
  paragraph .headPosE     anchor left + right + top         at xmin               ymax-0.3            width 28 lines 1
  paragraph .headPosN     anchor left + right + top         at xmin               ymax-0.3            width 28 lines 1
  paragraph .headPosU     anchor left + right + top         at xmin               ymax-0.3            width 28 lines 1
  button .editHead  ' Change ' anchor right + top           at xmax.bhLine-size   ymin.headPosU       callback '!this.setTask(|editHead|)' tooltip 'Modify branch head'

  paragraph .branHCTag    anchor left + top                 at x0.5               ymax+0.2            text 'Head Connection:'
  line .bHCLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  paragraph .headRef      anchor left + right + top         at x0.5               ymax                width 28 lines 1
  button .editHeadRef ' Change ' anchor right + top         at xmax.bHCLine-size  ymax-0.2            callback '!this.setTask(|editHeadRef|)' tooltip 'Modify branch head connection'

  -- Branch Tail Detail
  paragraph .branTailTag  anchor left + top                 at x0.5               ymax.headRef+0.8    text 'Tail Detail:'
  line .btLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0

  paragraph .tailBore     anchor left + top                 at x0.5               ymax                width 10 lines 1
  paragraph .tailConn     anchor left + right + top         at x11                ymin                width 16 lines 1
  paragraph .tailDir      anchor left + right + top         at x0.5               ymax-0.3            width 28 lines 1
  paragraph .tailPosE     anchor left + right + top         at xmin               ymax-0.3            width 28 lines 1
  paragraph .tailPosN     anchor left + right + top         at xmin               ymax-0.3            width 28 lines 1
  paragraph .tailPosU     anchor left + right + top         at xmin               ymax-0.3            width 28 lines 1
  button .editTail  ' Change ' anchor right + top           at xmax.btLine-size   ymin.tailPosU       callback '!this.setTask(|editTail|)' tooltip 'Modify branch tail'

  paragraph .branTCTag    anchor left + top                 at x0.5               ymax+0.2            text 'Tail Connection:'
  line .bTCLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  paragraph .tailRef      anchor left + right + top         at xmin               ymax                width 28 lines 1
  button .editTailRef ' Change ' anchor right + top         at xmax.bTCLine-size  ymax-0.2            callback '!this.setTask(|editTailRef|)' tooltip 'Modify branch tail connection'

  -------------------- Edit Branch Head
  !tagw = 10
  paragraph .hTag         anchor left + top                 at x0.5               ymax.newBranch    text 'Modify Branch Head:'
  line .hLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  option .hBore tagwid $!tagw 'Bore:' anchor left + right + top    at x0.5               ymax+0.2            callback '!this.changeEnd()' tooltip 'Nominal bore'     width 17
  option .hConn tagwid $!tagw 'Connection:' anchor left + right + top    at xmin               ymax+0.1            callback '!this.changeEnd()' tooltip 'Connection type'  width.hBore

  -- Head direction
  text   .hDir tagwid $!tagw 'Direction:' anchor left + right + top    at xmin               ymax+0.05           callback '!this.direction(!this.hDir, |head|)' tooltip 'Direction into pipe' width.hBore is STRING

  -- Head Position
  paragraph .hPosTag           anchor left + top            at x0.5               ymax+0.2            text 'Position wrt World:'
  button    .hPosPick          linklabel       at xmax +1                 ymin              'Pick Position'      callback '!this.pickposH()'      width 8
  line .hPosLine            anchor left + right + top at x0 ymax   horiz     width.cpLine  hei 0
  frame .headPositionControl panel  anchor left + right + top at x0 ymax+0.2 width.cpLine hei 5
    container .netheadPositionFrame PMLNetCONTROL 'NET' dock fill
  exit

  option .hHstu 'Head Tube:' anchor left+right+top        at xmin               ymax+0.2             tooltip 'HsTube Selection' width 17

  -- Modify Branch Data Buttons
  hdist 0
  button .applyHeadData   'Apply'  at x0.5 ymax                    callback '!this.modifyBranchEnd()'  tooltip 'Apply changes to branch head'
  button .copyheadData    'Copy To Tail' at xmax+0.5 ymin anchor left + top                          callback '!this.copyEnd(|Tail|)' tooltip 'Copy Head Details To tail'
  button .cancelHeadData  'Back'  at xmax form-size ymin anchor right + top         callback '!this.setTask(|editBranch|)'    tooltip 'Cancel changes'

  path left
  -------------------- Edit Branch Head
  paragraph .tTag         anchor left + top                 at x0.5               ymax.newBranch      text 'Modify Branch Tail:'
  line .tLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  !tagw = 10
  option .tBore tagwid $!tagw 'Bore:' anchor left + right + top    at x0.5               ymax+0.2            callback '!this.changeEnd()' tooltip 'Nominal bore'     width 17
  option .tConn tagwid $!tagw 'Connection:' anchor left + right + top    at xmin               ymax+0.1            callback '!this.changeEnd()' tooltip 'Connection type'  width 17

  -- Head direction
  text   .tDir tagwid $!tagw 'Direction:' anchor left + right + top    at xmin               ymax+0.05           callback '!this.direction(!this.tDir, |tail|)' tooltip 'Direction into pipe' width 19 is STRING

  -- Head Position
  paragraph .tPosTag           anchor left + top            at x0.5               ymax+0.2            text 'Position wrt World:'
  button    .tPosPick          linklabel       at xmax+1                 ymin         'Pick Position'      callback '!this.pickposT()'      width 8
  line .tPosLine            anchor left + right + top at x0 ymax   horiz     width.cpLine  hei 0

  frame .tailPositionControl panel  anchor left + right + top at x0 ymax+0.2 width.cpLine hei 5
    container .nettailPositionFrame PMLNetCONTROL 'NET' dock fill
  exit

  -- Modify Branch Data Buttons
  button .applyTailData   'Apply'  at x0.5 ymax                                              callback '!this.modifyBranchEnd()'  tooltip 'Apply changes to branch tail'
  button .copyTailData    'Copy To Head' at xmax+0.5 ymin anchor left + top                                      callback '!this.copyEnd(|Head|)' tooltip 'Copy Tail Details To Head'
  button .cancelTailData  'Back'  at xmax form-size ymin anchor right + top          callback '!this.setTask(|editBranch|)'    tooltip 'Cancel changes'
  path left
  -- Connection information
  paragraph .refTag            anchor left + top            at x0.5               ymin.hTag           text 'Modify Head Connected:'
  line .refLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  paragraph .refData           anchor left + right + top    at x1                 ymax                width 28 lines 2

  -- Re-establish connection
  button .reconnect     'Reconnect'  anchor right + top     at xmax.refLine-size  ymax-0.2            callback '!this.reconnect()'  tooltip 'Reconnect to reference'
  path left
  hdist 0.3
  button .unconnect     'Disconnect' anchor right + top                                               callback '!this.disconnect()' tooltip 'Disconnect from element'
  button .cancelConnect '  Back '    anchor right + top     at xmax.reconnect-size ymax+0.2            callback '!this.setTask(|editBranch|)'  tooltip 'Cancel connection'

  -- Connection information
  paragraph .endTag           anchor left + top             at x0.5                ymin.hTag          width 27
  !this.endTag.val = 'Define End Connection:'
  line .endLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  text .connectName 'Name:'      anchor left + right + top  at x0.5                ymax+0.5            callback '!this.connectionName()' tooltip 'Specify name of item to connect to' width 15 is STRING
  button .connectPick 'Pick'     anchor right+ top          at xmax+1              ymin                callback '!this.connectionPick()' tooltip 'Identify item to connect to.'

  -- Connection Table
  list .connectTable 'List of connections:' anchor left + right + top at x0.5     ymax+0.5            callback '!this.selectConnection()' columns single zeroSelection width.cpLine lines 8

  -- Connect Table
  button .cancelEndTable  '  Back '   anchor right + top at xmax.connectTable-size ymax+0.1            callback '!this.setTask(|editBranch|)' tooltip 'Cancel connection'
  path left
  button .connectEndTable 'Connect'   anchor right + top                                              callback '!this.connectEnd()' tooltip 'Connect end to selected item.'

  -- Single connection
