-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPipeGadgets(!show is BOOLEAN)

  -- Display pipe being modified
  if(!this.pipe.set() and not badref(!this.pipe)) then
    !this.pipeNameTag.val         = !this.pipe.flnn

    -- Show current spec
    if(!this.pipe.pspec.unset()) then
      !this.pipeSpec.val            = 'unset'
    else
    !this.pipeSpec.val              = !this.pipe.pspec.flnn
    endif
  endif

  !this.pipeNameTag.visible       = !show
  !this.changePipeData.visible    = !show
  !this.pipeSpecTag.visible       = !show
  !this.pipeSpec.visible          = !show
  !this.cTag.visible              = !show
  !this.cLine.visible             = !show
  if(!show) then
    !this.changePipeData.setFocus()
  endif

