------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Check direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget
--    2   R      STRING      Select string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!gadget is GADGET, !end is STRING)

  -- Initialise Variables

  -- Convert input into direction
  !direction                    = object DIRECTION(!gadget.val)
  handle ANY
    !!alert.warning('Invalid direction given.')
    return
  endhandle

  -- Set temporary end connection data
  !this.endConnection.direction = !direction
  !gadget.val                   = !direction.string().before('WRT').trim()

  -- Redisplay tag
  !this.tagEnd()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      reconnect
--
-- Description: Reconnect branch head/tail
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reconnect()

  -- Initialise Variables
  !end        = !this.endConnection.end
  !reference  = !!ce

  -- Move to branch
  !!ce        = !this.branch

  -- Reconnect branch head
  if(!end.upcase() eq 'HEAD') then
    if !!ce.hend.set() then
    	if !!ce.hend.length().gt(0) then
  	    !hend = !!ce.hend
  	    if !hend.eq('TAIL') then
  	      CONNECT PH TO PT of HREF
  	    else
  		    CONNECT PH TO PH of HREF
  	    endif
      else
        CONNECT PH TO HREF
      endif
    else
      CONNECT PH TO HREF
    endif
  -- Reconnect branch tail
  else
  	if !!ce.tend.set() then
  		if !!ce.tend.length().gt(0) then
  	    !tend = !!ce.tend
  	    if !tend.eq('TAIL') then
  	      CONNECT PT TO PT of TREF
  	    else
  	      CONNECT PT TO PH of TREF	
  	    endif
  	  else
  	  	CONNECT PT TO TREF
  	  endif
  	else
      CONNECT PT TO TREF
    endif
  endif

  -- Update Table
  !this.connectivityData()

  !this.endConnection = !this.branches[!this.branchIndex].attribute(!end.upcase())

  -- Update Gadgets
  !this.loadBranchEndRef()

  -- Tag End
  !this.tagEnd()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      disconnect
--
-- Description: Disconnect branch head/tail
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .disconnect()

  -- Initialise Variables
  !end        = !this.endConnection.end
  !reference  = !!ce

  -- Move to branch
  !!ce        = !this.branch

  -- Reconnect branch head
  if(!end.upcase() eq 'HEAD') then
    HREF nulref

  -- Reconnect branch tail
  else
    TREF nulref
  endif

  -- Update Table
  !this.connectivityData()

  -- Update Gadgets
  !this.loadBranchEndRef()

  -- Connect end
  !this.setTask(|connectEnd|)

  -- Tag End
  !this.tagEnd()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectionElement
--
-- Description: Returns the relevant element type for connection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    DBREF       Element to get connections from
--
------------------------------------------------------------------------

define method .connectionElement(!passedElement is DBREF) is DBREF

  -- Initialise Variables
  !element          = object DBREF()
  !type             = !passedElement.type
  !oType            = !passedElement.owner.type

  -- Tubing
  if(!type eq 'TUBI') then
    !element        = !passedElement.owner

  -- Branch
  elseif (!type eq 'BRAN') then
    !element        = !passedElement

  -- Piping Component
  elseif (!oType eq 'BRAN') then
    !component      = !passedElement
    !element        = !component.owner

    -- Component has SPRE
    if(!component.spref.set()) then

      -- Check if there is a P3 with a valid connection
      !pointList      = !component.pplst

      if(!pointList.findFirst(3).set()) then
        !attributes   = !component.attributes()

        -- Check pPoint connection type
        !connection   = !component.ppConnection[3]
        if(!connection.set() and !connection ne 'NULL') then

          -- Cref
          if(!attributes.findFirst('Cref').set() or !attributes.findFirst('Crfarray').set()) then
            !element    = !component
          endif
        endif

      endif

    endif

  -- Nozzle
  elseif (!type eq 'NOZZ') then
    !element        = !passedElement

  -- Check to see if we are part of an equipment
  else
    !owningTypes    = !passedElement.ahList
    !owningTypes.append(!type)
    !equipIndex     = !owningTypes.findFirst('EQUI')
    if(!equipIndex.set()) then
      !owningList   = !passedElement.ownLst
      !owningList.append(!passedElement)
      !element      = !owningList[!equipIndex]
    endif

  endif

  -- Return
  return !element

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectionName
--
-- Description: Get connection info from name gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectionName()

  -- Initialise Variables

  -- Check name
  !name       = !!checkName(!this.connectName.val, 'OLD')

  -- Valid name defined
  if(!name.set()) then
    !element  = !name.dbref()
    !this.connectionName(!element)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectionName
--
-- Description: Get connection info from passed element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectionName(!passedElement is DBREF)

  -- Initialise Variables
  -- Replacement text format = dbref\connection point\connected
  !replace                        = ARRAY()
  !names                          = ARRAY()
  !bores                          = ARRAY()
  !connType                       = ARRAY()
  !connected                      = ARRAY()
  !end                            = !this.endConnection.end

  -- Hide connect table
  !this.connectTable.visible      = false
  !this.cancelEndTable.visible    = false
  !this.connectEndTable.visible   = false
  !this.endConnData.visible       = false
  !this.cancelEnd.visible         = false
  !this.connectEnd.visible        = false

  -- Get element
  !element                        = !this.connectionElement(!passedElement)

  -- Unset element
  if(!element.unset()) then
    !this.cancelEnd.visible       = true
    return
  endif

  -- Re-display name
  if(!element.isNamed) then
    !this.connectName.val         = !element.namn
  else
    !this.connectName.val         = !element.string()
  endif

  -- Special case handling for current branch with unconnected end and component
  -- with which to position end at
  if(!this.endConnection.reference.unset() and (!this.endConnection.branch.eq(!element) or !this.endConnection.branch.eq(!element.owner))) then

    -- Show single item connection
    !this.cancelEnd.visible       = true
    !this.endConnData.visible     = true

    -- No components to connect to
    if(!this.endConnection.branch.mCount eq 0) then
      !this.connectEnd.visible    = false
      !this.endConnData.val       = 'No components within branch to connect ' & !this.endConnection.end & ' to.'
      return
    else
      !this.connectEnd.visible    = true
    endif

    if(!this.endConnection.end.upcase() eq 'HEAD') then
      !connectionText             = 'Connect branch head to first component?'
      !this.selectedEnd[1]        = !this.endConnection.branch.members.first().string()
      !this.selectedEnd[2]        = 'FIRST'
      !this.selectedEnd[3]        = ''
      !this.selectedEnd[4]        = 'FALSE'
    else
      !connectionText             = 'Connect branch tail to last component?'
      !this.selectedEnd[1]        = !this.endConnection.branch.members.last().string()
      !this.selectedEnd[2]        = 'LAST'
      !this.selectedEnd[3]        = ''
      !this.selectedEnd[4]        = 'FALSE'
    endif

    !this.endConnData.val         = !connectionText

    -- Tag Connection
    !this.tagConnection()

  -- General case for all other items
  else

    -- Get possible connection information
    !information                  = !this.connectionData(!element)
    -- If returned unset after selecting element with an unknown cref
    if (!information[1][1].eq(|unknown|)) then
      !this.endConnData.visible = true
      !this.connectEnd.visible = true
      !this.cancelEnd.visible = true
      !this.connectEnd.active = false
      !this.endConnData.val = 'Unknown connection reference, does connected element exist?'
      return
    endif

    do !j indices !information
      !names.append(!information[!j][1])
      !bores.append(!information[!j][2])
      !connType.append(!information[!j][3])
      !connected.append(!information[!j][4])
      !replace.append(!information[!j][5])
    enddo

  -- End of General case for all other items
  endif

  -- Display table
  if(!names.set()) then
    !replace.compress()
    !names.compress()
    !bores.compress()
    !connType.compress()
    !connected.compress()

    -- Single connection available
    if(!names.size() eq 1) then
      !this.selectedEnd             = !replace[1].split('\')
      !element                      = !this.selectedEnd[1].dbref()

      -- Show single item connection
      !this.endConnData.visible     = true
      !this.connectEnd.visible      = true
      !this.cancelEnd.visible       = true

      -- Set connect button
      !this.connectEnd.active       = !this.selectedEnd[4].boolean().not()

      -- Display connection information
      if(!this.selectedEnd[4].boolean()) then
        !this.endConnData.val       = 'Element is already connected, you can only connect to unconnected elements.'
      else
        !pPoint                     = !this.selectedEnd[2].substring(2).real()
        handle ANY
          !pPoint                   = 1
        endhandle
        !bore                       = !element.ppBore[!pPoint]
        !connection                 = !element.ppConnection[!pPoint]
        !this.endConnData.val       = 'Bore: ' & !bore.string(!!boreFmt) & '  Connection: ' & !connection
      endif


    -- Multiple connections available
    else
      !this.selectedEnd.clear()
      !headings[1]                  = 'ID'
      !headings[2]                  = 'Bore'
      !headings[3]                  = 'Type'
      !headings[4]                  = 'Connection'

      -- Display form
      !this.connectTable.visible    = true
      !this.connectEndTable.visible = true
      !this.cancelEndTable.visible  = true
      !this.connectEndTable.active  = false
      !this.connectTable.setHeadings(!headings)
      !columns[1]       = !names
      !columns[2]       = !bores
      !columns[3]       = !connType
      !columns[4]       = !connected
      !this.connectTable.setColumns(!columns)
      !this.connectTable.rtext = !replace

    endif

    -- Tag Connection
    !this.tagConnection()

  -- Handle connection to first/last component in the current branch
  else
    !this.connectEnd.active = true
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectionPick
--
-- Description: Pick item to connect to
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectionPick()

  -- Initialise Variables

  -- Define EDG Packet
  !packet                 = object EDGPACKET()
  !packet.elementPick('Identify element to connect to:')
  !packet.description     = !this.edgDescription

  -- When the component has been created successfully
  !packet.remove          = true
  !packet.priority        = 2
  !packet.action          = '!!pipeCreation.connectionPick(!this.return[1])'

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectionPick
--
-- Description: Pick item to connect to
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     EDGPICKDATA  Data returned from the pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectionPick(!data is  EDGPICKDATA)

  -- Initialise Variables
  !edgType    = !data.type
  !type       = !data.item.type

  -- Handle Implied tube (use branch)
  if(!edgType eq 'TUBING') then
    !element  = IL TUB of $!<data.item>

  -- Elements
  elseif (!edgType eq 'ELEMENT') then
    !element  = !data.item

  endif

  -- Process element
  if(defined(!element)) then
    !this.connectionName(!element)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectionData
--
-- Description: Get component connection data, returns information via
--              2D array, the first element, repeated for each connection
--                        of the of the element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to extract data from
-- Return:
--   [Data Type] [Description]
--    ARRAY       Component connection data in 2 dimensional array:
--                 [1]  names
--                 [2]  bores
--                 [3]  connection Type
--                 [4]  connected
--                 [5]  replacement text
--
--
------------------------------------------------------------------------

define method .connectionData(!element is DBREF) is ARRAY

  -- Initialise Variables
  !information                = ARRAY()

  -- Get branch head/tail information
  if(!element.type eq 'BRAN') then

    !information[1][1]        = 'Head'
    !information[1][2]        = !element.hBore.string(!!boreFmt)
    !information[1][3]        = !element.hConnect
    if(!element.href.set()) then
      !string                 = !element.href.flnn
      if(!element.hend.set()) then
        !string               = !element.hend & ' of ' & !element.href.flnn
      endif
      !information[1][4]      = !string
      !connection             = true
    else
      !information[1][4]      = 'unset'
      !connection             = false
    endif
    !information[1][5]        = !element.string() & '\HEAD\' & !element.hBore.string(!!boreFmt) & '\' & !connection.string()

    -- Collect all components with a P3 which has a connection
    var !components collect all with (PPCOUNT ge 3 and PPCONN 3 ne 'unset' and PPCONN 3 ne 'NULL') for $!<element>

    do !i indices !components
      !component              = !components[!i].dbref()
      !data                   = !this.connectionData(!component)
      if(!data.set()) then
        !information.appendArray(!data)
      endif
    enddo

    !index                    = !information.size() + 1

    -- Tail
    !information[!index][1]   = 'Tail'
    !information[!index][2]   = !element.tBore.string(!!boreFmt)
    !information[!index][3]   = !element.tConnect
    if(!element.tref.set()) then
      !string                 = !element.tref.flnn
      if(!element.tend.set()) then
        !string               = !element.tend & ' of ' & !element.tref.flnn
      endif
      !information[!index][4] = !string
      !connection             = true
    else
      !information[!index][4] = 'unset'
      !connection             = false
    endif
    !information[!index][5]   = !element.string() & '\TAIL\' & !element.tBore.string(!!boreFmt) & '\' & !connection.string()

  -- Get all nozzles for equipment
  elseif(!element.type eq 'EQUI') then

    -- Collect all nozzles for equipment
    var !nozzles collect all NOZZ for $!<element>

    -- Name of equipment
    !equipName                = !element.name
    !isNamed                  = !element.isNamed
    !length                   = !equipName.length()

    do !i indices !nozzles
      !nozzle                 = !nozzles[!i].dbref()
      !name                   = !nozzle.namn
      if(!isNamed) then
        !index                = !nozzle.name.match(!equipName)
        if(!index.set()) then
          !name               = !nozzle.name.substring(!index + !length + 1)
        endif
      endif
      if (!nozzle.isNamed.not()) then
        !name = !nozzle.flnn
      endif
      !data                   = !this.connectionData(!nozzle)
      !info[1]                = !name
      !info[2]                = !data[1][2]
      !info[3]                = !data[1][3]
      !info[4]                = !data[1][4]
      !info[5]                = !data[1][5]
      !information.append(!info)
    enddo

  -- Element
  else
    if(!element.isNamed) then
      !name                   = !element.namn
    else
      !type                   = !element.fullType.substring(1,1) & !element.fullType.substring(2).lowcase()
      !name                   = !type & ' ' & !element.tysequ.string()
    endif

    -- Check for unset and unknown connection references
    --CW fix for P36785 - Picking multiways on branch heads and tails --
    !unusedTestForCref = !element.cref
    handle none
      if (!element.cref.unset()) then
      else
        if (!element.cref.badref()) then
          !information[1][1] = 'unknown'
          return !information
        endif
      endif
    elsehandle any
    endhandle
    --end of fix for P-36785--

    -- Single connections (CREF)
    if(!element.attributes().findFirst('Cref').set()) then
      !information[1][1]      = !name
      if(!element.type eq 'NOZZ') then
        !pPoint               = 1
      else
        !pPoint               = 6 - (!element.arrive + !element.leave)
      endif
      !information[1][2]      = !element.ppBore[!pPoint].string(!!boreFmt)
      !information[1][3]      = !element.ppConn[!pPoint]
      if(!element.cref.set()) then
        !information[1][4]    = !element.cend & ' of ' & !element.cref.flnn
        !connection           = true
      else
        !information[1][4]    = 'unset'
        !connection           = false
      endif
      !information[1][5]      = !element.string() & '\P' & !pPoint.string() & '\' & !element.ppBore[!pPoint].real() & '\' & !connection.string()

    -- Assume multiple connections (CRFA)
    elseif (!element.attributes().findFirst('Crfarray').set()) then
      -- Loop through pPoints and get connection points
      !index                      = 0
      do !i indices !element.pplst
        skip if(!element.ppConnect[!i].unset() or !element.ppConnect[!i] eq 'NULL')
        skip if(!element.arrive eq !i or !element.leave eq !i)
        !index                    = !index + 1
        !information[!index][1]   = !name & ' [P' & !i .string() & ']'
        !information[!index][2]   = !element.ppBore[!i].string(!!boreFmt)
        !information[!index][3]   = !element.ppConn[!i]
        if(!element.crfa[!i].set() and defined(!element.crfa[!i])) then
          !information[!index][4] = !element.crfa[!i].flnn
          !connection             = true
        else
          !information[!index][4] = 'unset'
          !connection             = false
        endif
        !information[!index][5]   = !element.string() & '\P' & !i.string() & '\' & !element.ppBore[!i].real() & '\' & !connection.string()
      enddo
    -- No connections
    else
    endif
  endif

  -- Return information
  return !information

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectConnection
--
-- Description: Name of connection item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectConnection()

  -- Initialise Variables
  !this.selectedEnd             = !this.connectTable.selection('RTEXT').split('\')

  -- Check connection
  !connection                   = !this.selectedEnd[4].boolean()

  !this.connectEnd.active       = !this.connectTable.visible.not() and !connection.not()
  !this.connectEndTable.active  = !this.connectTable.visible and !connection.not()

  -- Tag Connection
  !this.tagConnection()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectEnd
--
-- Description: Name of connection item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectEnd()

  -- Initialise Variables
  !selectedConnection           = !this.selectedEnd
  !element                      = !selectedConnection[1].dbref()
  !connectionPoint              = !selectedConnection[2]

  -- Connect end
  !this.endConnection.connect(!element, !connectionPoint)

   -- Update Table
  !this.connectivityData()

  -- Update Gadgets
  !this.loadBranchEndRef()
  -- Tag End
  !this.tagEnd()
  -- Set task
  !this.setTask('editBranch')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      endPosition
--
-- Description: Get current end position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to tag
-- Return:
--   [Data Type] [Description]
--    POSITION    Position of end
--
------------------------------------------------------------------------

define method .endPosition(!end is STRING) is POSITION

  -- Initialise Variables
  !position         = object POSITION()

  -- Head
  if(!end.upcase() eq 'HEAD') then
    !position       =  N0
    !headPos  = !this.headposControl.xyz()
    !position.east  = !headPos[0]
    !position.north = !headPos[1]
    !position.up    = !headPos[2]
  -- Tail
  else
    !tailPos  = !this.tailposControl.xyz()
    !position       = N0
    !position.east  = !tailPos[0]
    !position.north = !tailPos[1]
    !position.up    = !tailPos[2]

  endif

  -- Return
  return !position

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      endDirection
--
-- Description: Get current end direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to tag
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction of end
--
------------------------------------------------------------------------

define method .endDirection(!end is STRING) is DIRECTION

  -- Initialise Variables
  !direction    = object DIRECTION()

  -- Head
  if(!end.upcase() eq 'HEAD') then
    !direction  = !this.hDir.val.direction()
  -- Tail
  else
    !direction  = !this.tDir.val.direction()
  endif

  -- Return
  return !direction

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      endBore
--
-- Description: Get current end bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to tag
-- Return:
--   [Data Type] [Description]
--    BORE        Bore of end
--
------------------------------------------------------------------------

define method .endBore(!end is STRING) is BORE

  -- Initialise Variables
  !bore   = object BORE()

  -- Head
  if(!end.upcase() eq 'HEAD') then
    !bore = !this.hBore.selection('RTEXT').real().bore()
  -- Tail
  else
    !bore = !this.tBore.selection('RTEXT').real().bore()
  endif

  -- Return
  return !bore

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      endConnection
--
-- Description: Get current end connection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End to tag
-- Return:
--   [Data Type] [Description]
--    STRING      Connection of end
--
------------------------------------------------------------------------

define method .endConnection(!end is STRING) is STRING

  -- Initialise Variables
  !connection = STRING()

  -- Head
  if(!end.upcase() eq 'HEAD') then
    !connection = !this.hConn.selection('RTEXT')
  -- Tail
  else
    !connection = !this.tConn.selection('RTEXT')
  endif

  -- Return
  return !connection

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeEnd
--
-- Description: Modify end connection data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Connection of end
--
------------------------------------------------------------------------

define method .changeEnd()

  -- Initialise Variables
  !end                            = !this.endConnection.end
  !this.endConnection.position    = !this.endPosition(!end)
  !this.endConnection.direction   = !this.endDirection(!end)
  !this.endConnection.connection  = !this.endConnection(!end)
  !this.endConnection.bore        = !this.endBore(!end)

  if !end eq 'Head' then
    !this.noHstuSpecs = !this.loadTubes(!this.hHstu, !this.endConnection.bore, !this.branch.pspec)
  endif

  -- Tag End
  !this.tagEnd()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tagEnd
--
-- Description: Tag branch end being changed
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagEnd()

  -- Initialise Variables
  AID CLEAR ALL $!<this.tagEnd>

  -- End information
  !endText      = !this.endConnection.end

  -- Position
  !position     = !this.endConnection.position.wrt(World)

  -- Direction
  !direction    = !this.endConnection.direction.wrt(World)

  -- Bore
  !bore         = !this.endConnection.bore
  if(!bore.unset()) then
    !height     = 100mm
  else
    !height     = !bore.real() * 2
  endif

  -- Aid info
  !arrowPosition    = !position.offset(!direction.opposite(), !height)
  AID ARROW NUMBER $!<this.tagEnd> AT $!<arrowPosition> DIRECTION $!<direction> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<this.tagEnd> '$!endText' AT $!<arrowPosition>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tagBranch
--
-- Description: Tag branch selected in the branch list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagBranch(!branch is DBREF)

  -- Initialise Variables
  AID CLEAR ALL $!<this.tagHead>
  AID CLEAR ALL $!<this.tagTail>

  -- End information
  !headText      = 'Head'
  !tailText      = 'Tail'

  -- Position
  !hPosition     = !branch.hPosition.wrt(World)
  !tPosition     = !branch.tPosition.wrt(World)
  -- Direction
  !hDirection    = !branch.hDirection.wrt(World)
  !tDirection    = !branch.tDirection.wrt(World)

  -- hBore
  !hBore         = !branch.hBore
  if(!hBore.unset()) then
    !height     = 100mm
  else
    !height     = !hBore.real() * 2
   -- tBore
  endif
  !tBore         = !branch.tBore
  if(!tBore.unset()) then
    !height     = 100mm
  else
    !height     = !tBore.real() * 2
  endif

  -- Aid headInformation
  !arrowPosition    = !hPosition.offset(!hDirection.opposite(), !height)
  AID ARROW NUMBER $!<this.tagHead> AT $!<arrowPosition> DIRECTION $!<hDirection> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<this.tagHead> '$!headText' AT $!<arrowPosition>
 -- Aid tailInformation
  !arrowPosition    = !tPosition.offset(!tDirection.opposite(), !height)
  AID ARROW NUMBER $!<this.tagTail> AT $!<arrowPosition> DIRECTION $!<tDirection> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<this.tagTail> '$!tailText' AT $!<arrowPosition>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tagConnection
--
-- Description: Tag potential connection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagConnection()

  -- Initialise Variables
  AID CLEAR ALL $!<this.tagConnection>

  -- Get selected connection
  !connectionData   = !this.selectedEnd

  -- Return if there is no connection data
  if(!connectionData.unset()) then
    return
  endif

  -- Element
  !element          = !connectionData[1].dbref()
  !connectionPoint  = !connectionData[2]

  -- Get connection point
  if(!connectionPoint eq 'HEAD') then
    !position       = !element.hPosition.wrt(World)
    !direction      = !element.hDirection.wrt(World)
    !bore           = !element.hBore
    !connectionText = 'Connect to Head'

  elseif (!connectionPoint eq 'TAIL') then
    !position       = !element.tPosition.wrt(World)
    !direction      = !element.tDirection.wrt(World)
    !bore           = !element.tBore
    !connectionText = 'Connect to Tail'

  elseif (!connectionPoint.substring(1,1) eq 'P') then
    !point          = !connectionPoint.substring(2).real()
    !position       = !element.pposition[!point].wrt(World)
    !direction      = !element.pdirection[!point].wrt(World)
    !bore           = !element.ppBore[!point]
    !connectionText = 'Connect to P' & !point

  else
    return
  endif

  -- Tag information
  if(!bore.unset()) then
    !height         = 100mm
  else
    !height         = !bore.real() * 3
  endif

  -- Aid info
  !arrowPosition    = !position.offset(!direction, !height)
  !direction        = !direction.opposite()

  AID ARROW NUMBER $!<this.tagConnection> AT $!<arrowPosition> DIRECTION $!<direction> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<this.tagConnection> '$!connectionText' AT $!<arrowPosition>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      dbChanged
--
-- Description: Database has been modified
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbChanged()

  -- New pipe not created
  if(!this.pipe.unset()) then
    return
  endif

  -- make sure that we are not in Router mode by testing the banner
  VAR !banner BANNER
  if( !banner.match('Pipe Router') neq 0 ) then
    return
  endif

  -- If the pipe is no longer, then we'll need to initialise the form
  if(!this.pipe.badref()) then
    !message[1] = 'Pipe being modified has been deleted, if the pipe is'
    !message[2] = 'required use "UNDO" or "REDO" or navigate to another'
    !message[3] = 'pipe and press "Done".'
    !this.warning(!message, '!this.modify(!!ce)')
    return
  endif

  -- Check if items been modified
  var !lastModified LASTM
  !dtm    = object DATETIME(!lastModified)
  if(!dtm.eq(!this.lastModified)) then
    return
  endif

  -- If the last task was a warning, then resume from where we were
  if(!this.warningTask) then
    !this.resumeTask()

  else

    -- We'll update the connection table in case we've delete a branch
    !this.connectivityData()

  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      posControl()
--
-- Description: Initialising the posControl gadgets.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posControl()
  !selectedBranch   = !this.connectionTable.selection().dbref()
  !headPosition     = !selectedBranch.hPos.wrt(world)
  !tailPosition     = !selectedBranch.tPos.wrt(world)
  --P-16651: <pos>.north.string('D6').real() to eradicate scientific numbers i.e 1.5e-12 which
  --              is too precise and causes an error on the position control.
  !this.headposControl.xyz(!headPosition.east.string('D6').real(), !headPosition.north.string('D6').real(), !headPosition.up.string('D6').real())
  !this.tailposControl.xyz(!tailPosition.east.string('D6').real() ,!tailPosition.north.string('D6').real(), !tailPosition.up.string('D6').real())
endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      coordinateSettings
--
-- Description: Setting the format of positional gadgets according to present coordinate system.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coordinateSettings()

   !grid            = object SHIPGRID()
   !gridDefined     = !grid.position.set()
   if(!gridDefined)then
     !this.headposControl.gridvisible(true)
     !this.tailposControl.gridvisible(true)
     !this.headposControl.gridFormat()
     !this.tailposControl.gridFormat()
   else
      !this.headposControl.gridvisible(false)
      !this.tailposControl.gridvisible(false)
      var !coord coord
      if (!coord.eq('ENU'))then
        !this.headposControl.enuFormat()
        !this.tailposControl.enuFormat()
      else
        !this.headposControl.xyzFormat()
        !this.tailposControl.xyzFormat()
      endif
   endif

 endmethod
------------------------------------------------------------------------
--
-- Method:      loadTube
--
-- Description: Loads the available head tube into !gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL  The number of Hstubes available for bore and spec
--
------------------------------------------------------------------------

define method .loadTubes(!gadget is GADGET, !bore is BORE, !specification is DBREF) is REAL

  if !bore.string().eq('Unset') then
    return 0
  endif

  !dtext = object ARRAY()
  !rtext = object ARRAY()

  !tubes = !!getSpecComponents(!specification.name, 'TUBE', !bore.string())

  !dtxr = object STRING()
  !mtxx = object STRING()

  do !tube values !tubes
    !dtxr = !tube.dtxr
    handle any
      !dtxr = ''
    endhandle

    !mtxx = !tube.mtxx
    handle any
      !mtxx = ''
    endhandle

    !outerValue = !tube.catref.para[2].real()
    handle any
      !outer = '--'
    elsehandle NONE
      -- if imperial units
      !outerMetric = !!comValueConvert(!outerValue,'MM')
      if ( !!isImperialLength('DIST')) then
        -- first convert parameter value to MM. If parameter is undimensioned
        -- then assume that it is in MM, otherwise convert the dimensioned value
        -- to INCH
        !outer     = !!comUnitsConvert(!outerMetric,'MM','INCH').string('D3')
      else
        !outer = !outerMetric.string('D1')
      endif
    endhandle

    !wall = !tube.pwallt[1].string('D2')
    handle any
      !wall = '--'
    endhandle

    !dtext.append(!outer + ' OD x ' + !wall + ' Thk, ' + !dtxr + ' ' + !mtxx )
    !rtext.append(!tube.string())
  enddo

  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

  if (!this.branch.hstu.set()) and (!this.branch.hBore eq !bore) then
    !gadget.select('Rtext', !this.branch.hstu.string())
    handle any
      !gadget.select('Rtext', !gadget.rtext[1].string())
      handle ANY
      endhandle
    endhandle
  endif

  return !tubes.size()

endmethod
------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      HPos
--
-- Description: Set Lower working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hPos(!data is EDGPOSITIONDATA)

  -- Update position control gadget with the picked position
  !pickedPosition = !data.position.wrt(World)

  !this.headposControl.xyz(!pickedPosition.east, !pickedPosition.north, !pickedPosition.up)

  !evaluatedPosition   = !this.getPositionControlPos(!this.headposControl.xyz())

  -- store the picked position data derived from the form
  !data.position        = !evaluatedPosition
  !this.pickedHeadPosData  = !data



endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      TPos
--
-- Description: Set Lower working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tPos(!data is EDGPOSITIONDATA)

  -- Update position control gadget with the picked position
  !pickedPosition = !data.position.wrt(World)

  !this.tailposControl.xyz(!pickedPosition.east, !pickedPosition.north, !pickedPosition.up)

  !evaluatedPosition   = !this.getPositionControlPos(!this.tailposControl.xyz())

  -- store the picked position data derived from the form
  !data.position        = !evaluatedPosition
  !this.pickedTailPosData  = !data



endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pickposH
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickposH()

  -- define packet
  !prompt                = 'Modify Pipe - Select Head Position'
  !packet                = object EDGPACKET()
  !packet.initialisation = '!!pipeCreation.pickedHeadPosData  = object EDGPOSITIONDATA()'
  !packet.definePosition(!prompt)
  !packet.description    = 'Branch Head'
  !packet.remove         = TRUE
  !packet.action = '!!pipeCreation.setHeadTailPosition(!this.return[1],|Head| ) '

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      pickposT
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickposT()

  -- define packet
  !prompt                = 'Modify Pipe - Select Tail Position'
  !packet                = object EDGPACKET()
  !packet.initialisation = '!!pipeCreation.pickedTailPosData  = object EDGPOSITIONDATA()'
  !packet.definePosition(!prompt)
  !packet.description    = 'Branch Tail'
  !packet.remove         = true
  !packet.action         = |!!pipeCreation.setHeadTailPosition(!this.return[1],'Tail' )|

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getPositionControlPos
--
-- Description: returns the position in appropriate unit from POSITIONCONTROL gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPositionControlPos(!posValues is ARRAY) is POSITION

    !east  = !posValues[0].string()
    !north = !posValues[1].string()
    !up    = !posValues[2].string()

    !position   = object POSITION(' E  $!east  N  $!north  U $!up ' )

    return !position

endmethod

------------------------------------------------------------------------
--
-- Method:      setHeadTailPosition
-- P-28017 added the ability to copy the head and tail position to its opposite end
--
-- Description: sets the head and tail positions after a pick and tags the new point
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .setHeadTailPosition(!pos is EDGPOSITIONDATA,!end is STRING )

   if !end.eq('Head') then
     !this.hPos(!pos)
     !text = 'FIRST'
   else
     !this.tPos(!pos)
     !text = 'LAST'
   endif
   !this.endConnection.end = !end
   if !pos.item.type inset('NOZZ','TEE','OLET','CROS','SHU','PCOM','INST','VTWA','VFWA') and(!pos.type.eq('PPOINT')) then
    !point = !pos.pPoint
    handle ANY
     !point = 0
    endhandle
    if !!alert.confirm('You have selected P$!point of $!pos.item.type $!pos.item.flnn - Do you want to connect to it?').eq('YES') then
      -- Initialise variables
      !this.selectedEnd[1]        = !pos.item.string()
      !this.selectedEnd[2]        = 'P' & !pos.pPoint
      !this.selectedEnd[3]        = ''
      !this.selectedEnd[4]        = 'FALSE'
      !this.connectEnd()
     endif
   endif
--CW - P-40423 - fix to indicate position of modified tail/head position using pick position --
!this.changeEnd()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:  collectSlopes
--
-- Description: gets a list of slope elements for display and sets up the
-- selection options
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .collectSlopes() is ARRAY

  var !slopes coll all sloele

 if !slopes.unset() then
    !slopes[1] = 'none'
    !names[1]  = 'none'
 else

  var !names eval name for all from !slopes
  !index = !names.sortedindices()
  !slopes.reindex(!index)
  !names.reindex(!index)
  !slopes.insert(1,'none')
  !names.insert(1,'none')

 endif

  !return[1] = !names
  !return[2] = !slopes

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
