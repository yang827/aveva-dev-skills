  -- Basic Pipe information
  text  .pipeTemperature tagwid $!tagw 'Temperature:' anchor left + right + bottom at xmin.pipeBore   ymax+0.1      width 14 is REAL format !!temperatureFmt
  text  .pipePressure tagwid $!tagw    'Pressure:'   anchor left + right + bottom at xmin.pipeBore   ymax+0.1      width 14 is REAL format !!pressureFmt
  option .pipeSlopeList tagwid $!tagw 'Slope Ref:'    anchor left + right + bottom at xmin.pipeBore   ymax+0.1      width 14


  -- Modify Pipe Data Buttons
  button .cancelPipeData '  Back '   anchor right + bottom at xmax.ppLine-size          ymax+0.5      callback '!this.setTask(|modifyPipe|)' tooltip 'Cancel changes'
  path left
  button .applyPipeData  ' Apply '   anchor right + bottom                                            callback '!this.modifyPipe()'          tooltip 'Apply changes to pipe'
  button .cancelPipe     'Cancel '   anchor right + bottom at xmin.cancelPipeData ymin.cancelPipeData callback '!this.hide()'       tooltip 'Cancel pipe creation'
  path left
  button .createPipe     ' Apply '   anchor right + bottom                                            callback '!this.createPipe()' tooltip 'Create pipe'


  -------------------- Warning pane
  paragraph .warningTag   anchor left + top                 at x0.5               ymin.mpTag+1        text 'Warning:'
  line .wLine            anchor left + right + top at x0 ymax-0.2   horiz     width.cpLine  hei 0
  paragraph .warningIcon                                    at x0.5               ymax                pixmap width 32 heigh 32
  paragraph .warning      anchor left + right + top         at xmax+2             ymin                width 22 lines 6
  button    .warningDone  '  Done  '   anchor right + top   at xmax.warning-size  ymax+0.5            callback '!this.resumeTask()'

  -- Form Members

  -- Pipe Name
  member .pipe                  is DBREF

  -- Last modified
  member .lastModified          is DATETIME

  -- Pipe Process Information
  member .processData           is PIPINGPROCESSDATA

  -- List of branches (Array of PIPEBRANCH's)
  member .branches              is ARRAY

  -- Active branch
  member .branch                is DBREF
  member .branchIndex           is REAL

  -- Temporary end connection
  member .endConnection         is BRANCHCONNECTION

  -- Current connection end selected
  member .selectedEnd           is ARRAY

  -- Mode
  member .createMode            is BOOLEAN

  -- Current task
  member .currentTask           is STRING

  -- Warning task active
  member .warningTask           is BOOLEAN

  -- Currently Active Component
  member .activeDataFrame       is GADGET

  -- Available Specifications
  member .pipingSpecs           is SPECIFICATIONS
  member .insulationSpecs       is SPECIFICATIONS
  member .tracingSpecs          is SPECIFICATIONS

  -- List of Component Specifications
  member .specifications        is ARRAY
  member .slopeElements         is ARRAY

  -- Spec being modified (pipe or branch)
  member .editType              is STRING

  -- Connection Table Options (should be somewhere else)
  member .cocos                 is ARRAY

  -- Aid Graphics
  member .tagEnd                is REAL
  member .tagConnection         is REAL
  member .tagHead               is REAL
  member .tagTail               is REAL

  -- EDG Description
  member .edgDescription        is STRING

  -- Undo for creation
  member .undo                  is UNDOABLE

  --Number of hstu specs available
  member .noHstuSpecs           is REAL
  -- Head Work Point data
  member .pickedHeadPosData        is EDGPOSITIONDATA
  member .pickedTailPosData        is EDGPOSITIONDATA

  using namespace 'Aveva.Pdms.Presentation'
  member .headposControl is POSITIONCONTROL
  member .tailposControl is POSITIONCONTROL
  -- Register from
  !!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      pipeCreation
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeCreation()

  -- Initialise Variables

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.headposControl        = object POSITIONCONTROL()
  !this.tailposControl        = object POSITIONCONTROL()
  -- Load ship grid data
  !grid                   = object SHIPGRID()
  !gridDefined            = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.headposControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.tailposControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    !this.headposControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.tailposControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.headposControl.heading('World Position')
    !this.tailposControl.heading('World Position')
  endif

  !this.coordinateSettings()

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'
  !this.warningTask       = false

  -- EDG Description
  !this.edgDescription        = 'Pipe Creation'

  -- Aid graphic numbers
  !this.tagEnd            = !!aidNumbers.add('Pipe Creation')
  !this.tagConnection     = !!aidNumbers.add('Pipe Creation')
  !this.tagHead           = !!aidNumbers.add('Pipe Creation')
  !this.tagTail           = !!aidNumbers.add('Pipe Creation')

  -- Tags
  !this.mpTag.val         = 'Pipe:'
  !this.mbTag.val         = 'Branch:'


  -- Heading for connectivity table
  !header[1]              = 'Branch'
  !header[2]              = 'Head'
  !header[3]              = 'Tail'
  !this.connectionTable.setHeadings(!header)

  -- Load cocos
  !this.loadCocos()

  !warningIcon            = !!pml.getPathname('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  !this.noHstuSpecs = 1

  -- Position options
  !offset[1]              = '1'
  !offset[2]              = '-1'

  -- Initialise Panels
  !this.setTask('Initialise')


  -- Load Specifications
  !this.setupSpecifications()
  !this.setupSystemReference()
  using namespace 'Aveva.Pdms.Presentation'
  !this.headposControl  = object POSITIONCONTROL()
  !this.tailposControl  = object POSITIONCONTROL()
  !this.headposControl.gridFormat()
  !this.tailposControl.gridFormat()
  !this.netheadPositionFrame.control = !this.headposControl.handle()
  !this.nettailPositionFrame.control = !this.tailposControl.handle()

  !this.headposControl.changeAction('!!pipeCreation.changeEnd()')
  !this.tailposControl.changeAction('!!pipeCreation.changeEnd()')

  !slopes = !this.collectSlopes()
  !this.pipeSlopeList.dtext = !slopes[1]
  !this.pipeSlopeList.rtext = !slopes[2]
  !this.branSlopeList.dtext = !slopes[1]
  !this.branSlopeList.rtext = !slopes[2]


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadCocos
--
-- Description: Load cocos
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadCocos()

  -- Get all connections
  var !cocos collect all COCO
  !list = ARRAY()
  do !coco values !cocos
    !list.appendArray(!coco.dbref().ctype)
  enddo

  -- Remove duplications
  !list.unique()

  -- Sort alphabetically
  !list.sort()

  -- Populate the form member and relevant gadgets
  !list.insert(1,'')
  !display          = !list
  !display[1]       = 'unset'
  !this.cocos       = !list
  !this.hConn.dtext = !display
  !this.hConn.rtext = !this.cocos
  !this.tConn.dtext = !display
  !this.tConn.rtext = !this.cocos

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      state
--
-- Description: Handles state of form when serialisation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .state()

  !this.coordinateSettings()


  -- If create mode is unset, then the we are most probably showing the form
  -- from serialisation. Therefore, we need to load the form.
  if(!this.createMode.unset()) then

    -- If we are at a pipe or below, then we'll assume we are modifying
    -- the pipe/branch
    !owningTypes  = !!ce.ahList
    !owningTypes.append(!!ce.type)

    -- Check for pipe or branch
    !types[1]     = 'PIPE'
    !types[2]     = 'BRAN'

    -- Check types against owning types
    !matches      = !owningTypes.intersect(!types)

    -- If there are any matches, then will use the lowest item
    if(!matches.set()) then
      !owners     = !!ce.ownLst
      !owners.append(!!ce)

      --  Get type of last item in matching list
      !useType    = !matches.last()
      !index      = !owningTypes.findFirst(!useType)
      !element    = !owners[!index]
      !this.modify(!element)

    -- No matches, we'll assume we are creating a pipe
    else
      !this.create(!!ce)
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.tidy()

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

  -- Unenhance current branch
  UNENHANCE $!<this.pipe>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.tagEnd>
  AID CLEAR ALL $!<this.tagConnection>
  AID CLEAR ALL $!<this.tagHead>
  AID clear all $!<this.tagTail>

  -- Unenhance current branch
  UNENHANCE $!<this.branch>
  handle ANY
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create pipe
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element where to create pipe
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can create pipe
--
------------------------------------------------------------------------

define method .create(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.createMode  = true
  !this.formTitle   = 'Create Pipe'

  -- If there is a pipe set, then we'll clear the information first
  if(!this.pipe.set()) then
    !this.close()
  endif

  -- Initialise Values
  !this.pipeTemperature.val = -100000 Celsius
  !this.pipePressure.val    = 0

  -- Initialise Panels
  !this.setTask('Initialise')

  -- Setup for pipe creation
  !this.setTask('createPipe')

  -- Use old default if set (this should be removed at some stage)
  if(defined(!!appDesMain.pipeSpec)) then
    !this.pipeSpecList.select('DTEXT', !!appDesMain.pipeSpec.val)
    handle ANY
    elsehandle NONE
      !this.selectPipeSpecification()
    endhandle
  endif

  -- Show form
  !this.show()
  handle ANY
  endhandle

  -- Remove aid text
  !this.tidy()

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify pipe
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Modify pipe
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can create pipe
--
------------------------------------------------------------------------

define method .modify(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.createMode  = false
  !this.formTitle   = 'Modify Pipe'
  !message          =  ARRAY()

  -- If there is a pipe set, then we'll clear the information first
  if(!this.pipe.set()) then
    !this.close()
  endif

  -- Check if element is a pipe or one of its parents is a pipe
  !ownerTypes       = !element.ahList
  !ownerTypes.append(!element.type)

  -- Check for branch
  !index            = !ownerTypes.findFirst('PIPE')

  -- Get owning pipe
  if(!index.set()) then
    !owners         = !element.ownLst
    !owners.append(!element)
    !pipe           = !owners[!index]

  -- Give warning
  else
    !message.append('No pipe to modify, navigate to an appropriate')
    !message.append('element and press "Done".')
    !this.warning(!message, '!this.modify(!!ce)')
    -- Show form
    !this.show()
    return false
  endif

  -- Have we got creat access
  if(!!dbrefUpdatable(!pipe).not()) then
    !message.append('Unable to modify pipe, check access to modify and resolve')
    !message.append('or navigate to a pipe with write access and press "Done".')
    !this.warning(!message, '!this.modify(!!ce)')
    -- Show form
    !this.show()
    return false
  endif

  -- Pipe Information
  !this.pipe        = !pipe

  -- If element is a branch, then we will use it
  if(!element.type eq 'BRAN') then
    !this.branch    = !element
  elseif (!element.owner.type eq 'BRAN') then
    !this.branch    = !element.owner
  else
    -- Use first branch of pipe
    !this.branch    = BRANCH 1 OF $!<this.pipe>
    handle ANY
      !this.branch  = object DBREF()
    endhandle
  endif

  -- Process Information
  !this.processData = object PIPINGPROCESSDATA(!this.pipe)

  -- Branch Information
  !this.connectivityData()

  -- Initialise Panels
  !this.setTask('Initialise')

  -- Setup for pipe creation
  if(!this.branch.set()) then
    !this.connectionTable.val = !this.branch.tysequ
    !this.selectBranch()
  else
    !this.setTask('modifyPipe')
  endif

  -- Show form
  !this.show()
  handle ANY
  endhandle

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      namePipe
--
-- Description: Check name of pipe
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .namePipe()

  -- Check name of pipe
  !name                         = !!checkName(!this.pipeName.val, 'NEW')

  -- Update gadget with name
  if(!name.set()) then
    !name                       = !name.substring(2)
    !this.pipeName.val          = !name
    !this.applyPipeData.active  = true
  else
    !this.applyPipeData.active  = false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      nameBranch
--
-- Description: Check name of branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameBranch()

  -- Initialise Variables
  -- Check name of pipe
  !name                         = !!checkName(!this.branchName.val, 'NEW')

  -- Update gadget with name
  if(!name.set()) then
    !name                       = !name.substring(2)
    !this.branchName.val        = !name
    !this.applyBranData.active  = true
  else
    !this.applyBranData.active  = false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createPipe
--
-- Description: Create a new pipe
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPipe()

  -- Initialise Variables
  !message          = ARRAY()

  -- Can we create a pipe at this position in this hierarchy
  !owningTypes      = !!ce.ahList
  !owningTypes.append(!!ce.type)
  !owningTypes.appendArray(!!ce.list)

  -- Have we got creat access
  if(!!ce.dbWrite.not()) then
    !message.append('Unable to create pipe in this database. Navigate')
    !message.append('to database with the right access and press "Done".')

  -- Can we create a pipe within the leg of the hierarchy
  elseif  (!owningTypes.findFirst('PIPE').unset()) then
    !message.append('Unable to create pipe at this point within the')
    !message.append('hierarchy. Navigate to the appropriate place ')
    !message.append('within database and press "Done".')

  endif

  -- Generate a warning
  if(!message.set()) then
    !this.warning(!message, '!this.createPipe()')
    return
  endif

  -- Define UNDO Information
  if(!this.pipeName.val.empty()) then
    !this.undo.description('Created pipe')
  else
    !this.undo.description('Created pipe ' & !this.pipeName.val)
  endif
  !this.undo.add()

  NEW PIPE
  handle ANY
    !error  = !!error.text.after(')').trim()
    !message.append('Unable to create pipe:')
    !message.append('    "' & !error & '"')
    !this.warning(!message, '!this.createPipe()')
    return
  endhandle

  -- Initialise Variables
  !this.pipe        = !!ce
  !this.processData = object PIPINGPROCESSDATA(!this.pipe)
  !this.branch      = object DBREF()
  !this.branches    = ARRAY()

  -- Update Pipe Data
  !this.updatePipeData()

  -- Create Branch (without marking the DB)
  !this.createBranch(false)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Set last modified time
  --var !lastModified LASTM of $!<this.pipe>
  --!this.lastModified          = object DATETIME(!lastModified)
  !this.modify(!this.branch)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyPipe
--
-- Description: Modify pipe
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPipe()

  -- Update Pipe Data
  !this.updatePipeData()

  -- Put form into modify pipe mode
  !this.setTask(|modifyPipe|)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyBranch
--
-- Description: Modify branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyBranch()

  -- Update Pipe Data
  !this.updateBranchData()

  -- Put form into modify branch mode
  !this.setTask(|editBranch|)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyBranchEnd
--
-- Description: Modify branch end
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyBranchEnd()

  -- Initialise variables
  !end                            = !this.endConnection.end
  !this.endConnection.position    = !this.endPosition(!end)
  !this.endConnection.direction   = !this.endDirection(!end)
  !this.endConnection.connection  = !this.endConnection(!end)
  !this.endConnection.bore        = !this.endBore(!end)

  -- Update end information
  !this.endConnection.updateElement()

  -- Update branch end
  !this.branches[!this.branchIndex].attribute(!end.upcase()) = !this.endConnection

  if !end eq 'Head' then
    !this.branches[!this.branchIndex].branch.hstu = !this.hHstu.selection('RTEXT').dbref()
    handle ANY
      select hstu
     handle ANY
      -- in case the pipe spec has not been set or there is no tube
     endhandle
    endhandle
  endif

   -- Update Table
  !this.connectivityData()

  -- Update Gadgets
  !this.loadBranchEndRef()

  -- Tag End
  !this.tagEnd()

  -- Return to editing branch
  !this.setTask('editBranch')

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      copyEnd
--
-- Description: copy the current branch end to the opposite branch end
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyEnd(!end is STRING)

  -- first of all save the current end values
  !this.modifyBranchEnd()
  !branch = !this.branches[!this.branchIndex].branch
  !this.endConnection.end = !end
  if !end.eq('Tail') then
    !branch.tPos  = !branch.hPos
    !branch.tBore = !branch.hBore
    !branch.tcon  = !branch.hcon
  else
    !branch.hPos  = !branch.tPos
    !branch.hBore = !branch.tBore
    !branch.hcon  = !branch.tcon
  endif

  !this.endConnection.updateElement()
  --!this.modifyBranchEnd()
  if !end.eq('Tail') then
    !this.setTask('EDITTAIL')
  else
    !this.setTask('EDITHEAD')
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updatePipeData
--
-- Description: Setup Pipe Data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatePipeData()

  -- Initialise Variables

  -- Change name
  !this.changeName(!this.pipe, !this.pipeName.val)

  -- Process Data
  !this.processData.specification(!this.pipeSpecList.selection('RTEXT'))
  !this.processData.insulation(!this.pipeInsulation.selection('RTEXT'))
  !this.processData.tracing(!this.pipeTracing.selection('RTEXT'))
  !this.processData.bore(!this.pipeBore.selection('RTEXT'))
  !this.processData.systemReference(!this.systemReference.selection('RTEXT'))
  !this.processData.temperature(!this.pipeTemperature.val)
  !this.processData.pressure(!this.pipePressure.val)
  !sloRef = !this.pipeSlopeList.selection('RTEXT')
  if !sloRef.eq('none') then
     !dbElement = object DBREF()
  else
     !dbElement = !sloRef.dbref()
  endif
  !this.processData.sloRef(!dbElement)

  -- Update database element with process data
  !this.processData.updateElement()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateBranchData
--
-- Description: Setup Branch Data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBranchData()

  -- Initialise Variables

  -- Change name
  !this.changeName(!this.branch, !this.branchName.val)

  -- Update branch information
  !this.branches[!this.branchIndex].processData.specification(!this.branSpecList.selection('RTEXT'))
  !this.branches[!this.branchIndex].processData.insulation(!this.branInsulation.selection('RTEXT'))
  !this.branches[!this.branchIndex].processData.tracing(!this.branTracing.selection('RTEXT'))
  !this.branches[!this.branchIndex].processData.temperature(!this.branTemperature.val)
  !this.branches[!this.branchIndex].processData.pressure(!this.branPressure.val)
  !sloRef = !this.branSlopeList.selection()
  if !sloRef.eq('none') then
     !dbElement = object DBREF()
  else
     !dbElement = !sloRef.dbref()
  endif
  !this.branches[!this.branchIndex].processData.sloRef(!dbElement)

  -- Update database element with process data
  !this.branches[!this.branchIndex].updateprocessData()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeName
--
-- Description: Change elements name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeName(!element is DBREF, !name is STRING)

  -- Initialise Variables
  !reference        = !!ce

  -- Set name
  if(!name.empty().not()) then

    -- Change name
    if(!name ne !element.flnn) then
      !!ce          = !element
      !newName      = '/' & !name

      -- Old name
      !oldName      = !element.name
      !matchName    = !element.name & '*'

      -- Collect all items with the old name
      var !elements collect all with (MATCHWILD(NAME, '$!matchName')) for $!<element>

      do !i indices !elements
        !component  = !elements[!i].dbref()
        !replace    = !component.name.replace(!oldName, !newName)
        !!ce        = !component
        NAME $!<replace>
        handle ANY
        endhandle

      enddo

      !!ce          = !reference

      -- Update connectivity table
      !this.connectivityData()
    endif

  -- Unname everything
  else

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createBranch
--
-- Description: Create a new branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createBranch()
  !this.createBranch(true)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createBranch
--
-- Description: Create a new branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if we need to mark the DB
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createBranch(!mark is BOOLEAN)

  -- Initialise Variables
  !reference    = !!ce

  -- Move to pipe
  !!ce          = !this.pipe

  -- Create new branch
  if(!this.pipe.mCount gt 0) then
    var !mode MODE
    FORWARDS
    !!ce        = !this.pipe.members.last()
    $!<mode>
  endif

  -- Define UNDO Information
  if(!mark) then
    !this.undo.description('Created branch')
    !this.undo.add()
  endif

  NEW BRANCH
  !this.branch  = !!ce

  -- If the pipe has a bore set then use it
  if(!this.pipe.bore.set()) then
    !this.branch.hBore      = !this.pipe.bore
    !this.branch.tBore      = !this.pipe.bore
  endif

  -- If there are no branches defined, then define a temporary pipe branch
  -- object to derive the name
  !newBranch    = object PIPEBRANCH(!this.branch)
  if(!this.branches.size() ge 1) then
    !lastBranch = !this.branches.last()
    !newBranch.idRule       = !lastBranch.idRule
    !newBranch.idSeparator  = !lastBranch.idSeparator
  endif
  !this.branches.append(!newBranch)

  -- Name branch
  !branchName = !this.branchName(!this.branches.last())
  if(!branchName.set()) then
    NAME $!<branchName>
  endif

  -- Update Connectivity table
  !this.connectivityData()

  -- Select last branch
  !this.connectionTable.val = !this.pipe.mCount('BRAN')

  -- Set edit task
  !this.selectBranch()

  select hstube
  handle ANY
  endhandle

  -- Return to original item
  !!ce          = !reference

  -- End UNDO Information
  if(!mark) then
    !this.undo.endUndoable()
  endif

  -- Set last modified time
  var !lastModified LASTM of $!<this.pipe>
  !this.lastModified          = object DATETIME(!lastModified)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      branchName
--
-- Description: Select pipe specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PIPEBRANCH  Pipe branch data
-- Return:
--   [Data Type] [Description]
--    STRING      Name of branch
--
------------------------------------------------------------------------

define method .branchName(!branchData is PIPEBRANCH) is STRING

  -- Initialise Variables
  !name       = STRING()
  !separator  = !branchData.idSeparator
  !rule       = !branchData.idRule

  -- If pipe is named
  if(!branchData.branch.owner.isNamed) then
    !nameRoot = !branchData.branch.owner.name

    do !index from 1 to !branchData.branch.owner.mCount + 1
      !name   = !nameRoot & !separator & $!<rule>

      -- Check to see if names exists
      !unusedX = (ID $!<name> )
      handle ANY
        break
      endhandle

    enddo

  endif

  return !name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectBranch
--
-- Description: Select pipe specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectBranch()

  -- Create new branch
  if(!this.connectionTable.selection('RTEXT').empty()) then
    !this.createBranch()
  endif

  -- Unenhance current branch
  UNENHANCE $!<this.branch>
  handle ANY
  endhandle

  -- Set branch
  !this.branch      = !this.branches[!this.connectionTable.val].branch
  !this.branchIndex = !this.connectionTable.val

  -- Check if we have access to modify branch
  if(!!dbrefUpdatable(!this.branch).not()) then
    !message[1]     = 'Unable to modify branch, check access to modify and resolve'
    !message[2]     = '"Done" will return you to the modify pipe level.'
    !this.warning(!message, '!this.setTask(|MODIFYPIPE|)')

  -- Select branch
  else
    !this.setTask('editBranch')
  endif

  !this.tidy()
  !this.tagBranch(!this.branch)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupSpecifications
--
-- Description: Setup Specifications
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupSpecifications()

  -- Populate lists
  -- Pipe Specs
  if(!this.pipingSpecs.piping()) then
    !pDisplay                   = !this.pipingSpecs.descriptions
    !pReplace                   = !this.pipingSpecs.refStrings

    -- Load specifications into list of specs
    !this.specifications.clear()
    do !i indices !this.pipingSpecs.references
      !this.specifications[!i]  = object SPECIFICATION()
      !this.specifications[!i].setSpecification(!this.pipingSpecs.references[!i])
    enddo

  else
    !pDisplay[1]                = 'None Available'
    !pReplace[1]                = ''
  endif
  !this.pipeSpecList.dtext      = !pDisplay
  !this.pipeSpecList.rtext      = !pReplace
  !this.branSpecList.dtext      = !pDisplay
  !this.branSpecList.rtext      = !pReplace

  -- Insulation Specs
  if(!this.insulationSpecs.insulation()) then
    !iDisplay[1]                = 'None'
    !iReplace[1]                = ''
    !iDisplay.appendArray(!this.insulationSpecs.descriptions)
    !iReplace.appendArray(!this.insulationSpecs.refStrings)
    !this.pipeInsulation.active = true
    !this.branInsulation.active = true
  else
    !iDisplay[1]                = 'None Available'
    !iReplace[1]                = ''
    !this.pipeInsulation.active = false
    !this.branInsulation.active = false
  endif
  !this.pipeInsulation.dtext    = !iDisplay
  !this.pipeInsulation.rtext    = !iReplace
  !this.branInsulation.dtext    = !iDisplay
  !this.branInsulation.rtext    = !iReplace

  -- Tracing Specs
  if(!this.tracingSpecs.tracing()) then
    !tDisplay[1]                = 'None'
    !tReplace[1]                = ''
    !tDisplay.appendArray(!this.tracingSpecs.descriptions)
    !tReplace.appendArray(!this.tracingSpecs.refStrings)
    !this.pipeTracing.active    = true
    !this.branTracing.active    = true
  else
    !tDisplay[1]                = 'None Available'
    !tReplace[1]                = ''
    !this.pipeTracing.active    = false
    !this.branTracing.active    = false
  endif
  !this.pipeTracing.dtext       = !tDisplay
  !this.pipeTracing.rtext       = !tReplace
  !this.branTracing.dtext       = !tDisplay
  !this.branTracing.rtext       = !tReplace

  -- Make pipe apply
  !this.createPipe.active       = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupSystemReference
--
-- Description: setup System Reference
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupSystemReference()


  !rtext  = object ARRAY()
  !dtext  = object ARRAY()

  !dtext.clear()
  !rtext.clear()
  !!collectSystemReference('PIPE', !dtext, !rtext)

  !dtext2 = object ARRAY()
  !rtext2 = object ARRAY()

  !!collectSystemReference('ALL', !dtext2, !rtext2)

  !dtext2.removeFirst()
  !rtext2.removeFirst()

  !dtext.appendArray(!dtext2)
  !rtext.appendArray(!rtext2)

  !this.systemReference.dtext = !dtext
  !this.systemReference.rtext = !rtext

endmethod

------------------------------------------------------------------------
--
-- Method:      selectPipeSpecification
--
-- Description: Select pipe specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectPipeSpecification()

  -- Initialise Variables
  !specification            = !this.pipeSpecList.selection('RTEXT').dbref()

  -- Make apply gadget active
  if(!this.createPipe.active.not()) then
    !this.createPipe.active = true
  endif

  -- Bore
  if(!this.pipe.set()) then
    !bore                   = !this.pipe.bore
  else
    !boreReal               = !this.pipeBore.selection('RTEXT').real()
    if(!boreReal.unset()) then
      !bore                 = object BORE()
    else
      !bore                 = !boreReal.bore()
    endif
  endif

  -- Load pipe bores
  !this.loadBores(!this.pipeBore, !bore, !specification)

  -- find out if the selected specification has a sloref set
  if !specification.sloRef.set() then
     !this.pipeSlopeList.select( 'RTEXT',  !specification.sloRef.string() )
  else
     !this.pipeSlopeList.val  = 1
  endif


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupPipeData
--
-- Description: Setup pipe data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupPipeData()

  -- Pipe Name
  if(!this.pipe.isNamed) then
    !this.pipeName.val = !this.pipe.flnn
  endif

  -- Get specification from list of piping specs
  !sIndex                     = !this.pipingSpecs.references.findFirst(!this.pipe.pspec)

  -- Select spec and bore
  if(!sIndex.set()) then
    !specification            = !this.specifications[!sIndex].dbElement
    !this.pipeSpecList.select('RTEXT', !specification.string())
    !this.selectPipeSpecification()
  else
    !this.pipeSpecList.clearSelection()
  endif

  -- Get specification from list of insulation specs
  !sIndex                     = !this.insulationSpecs.references.findFirst(!this.pipe.ispec)

  -- Select Insulation
  if(!sIndex.set()) then
    !this.pipeInsulation.select('RTEXT', !this.pipe.ispec.string())
  else
    !this.pipeInsulation.val  = 1
  endif

  -- Get system ref
  if (!this.pipe.mdsysf.set()) then
    !this.systemReference.select('rtext',!this.pipe.mdsysf[1].name)
    handle ANY
      !tempelement = !this.pipe.mdsysf[1]
  -- P-30975 handle a deleted system
      !!alert.error('Can not find current system ' & !tempelement & ' in Piping System Table')
      !this.systemReference.val  = 1
    endhandle
  else
    !this.systemReference.val  = 1
  endif
  -- Get specification from list of tracing specs
  !sIndex                     = !this.tracingSpecs.references.findFirst(!this.pipe.tspec)

  -- Select Tracing
  if(!sIndex.set()) then
    !this.pipeTracing.select('RTEXT', !this.pipe.tspec.string())
  else
    !this.pipeTracing.val  = 1
  endif

  -- Temperature
  !this.pipeTemperature.val = !this.pipe.temperature

  -- Pressure
  !this.pipePressure.val    = !this.pipe.pressure

   -- Get sloperef index
  if !this.pipe.sloRef.set() then
    !this.branSlopeList.select('RTEXT', !this.pipe.sloRef.string())
  -- find out if the selected specification has a sloref set
  elseif !specification.sloRef.set() then
     !this.branSlopeList.select( 'RTEXT',  !specification.sloRef.string() )
  else
    !this.branSlopeList.val  = 1
  endif


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupBranchData
--
-- Description: Setup branch data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupBranchData()

  -- Branch Name
  if(!this.branch.isNamed) then
    !this.branchName.val      = !this.branch.flnn
  endif

  -- Get specification from list of piping specs
  !sIndex                     = !this.pipingSpecs.references.findFirst(!this.branch.pspec)

  -- Select spec and bore
  if(!sIndex.set()) then
    !specification            = !this.specifications[!sIndex].dbElement
    !this.branSpecList.select('RTEXT', !specification.string())
  else
    !this.branSpecList.clearSelection()
  endif

  -- Get specification from list of insulation specs
  !sIndex                     = !this.insulationSpecs.references.findFirst(!this.branch.ispec)

  -- Select Insulation
  if(!sIndex.set()) then
    !this.branInsulation.select('RTEXT', !this.branch.ispec.string())
  else
    !this.branInsulation.val  = 1
  endif

  -- Get specification from list of tracing specs
  !sIndex                     = !this.tracingSpecs.references.findFirst(!this.branch.tspec)

  -- Select Tracing
  if(!sIndex.set()) then
    !this.branTracing.select('RTEXT', !this.branch.tspec.string())
  else
    !this.branTracing.val     = 1
  endif

  -- Temperature
  !this.branTemperature.val   = !this.branch.temperature

  -- Pressure
  !this.branPressure.val      = !this.branch.pressure

   -- Get sloperef index
  if !this.branch.sloRef.set() then
    !this.branSlopeList.select('RTEXT', !this.branch.sloRef.string())
  else
    !this.branSlopeList.val  = 1
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadBores
--
-- Description: Load bore gadget with available bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to update
--    2   R      BORE        Initialise bore
--    3   R      DBREF       Specification to get bore data from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBores(!gadget is GADGET, !bore is BORE, !specification is DBREF)

  -- Initialise Variables
  !dtext[1]         = 'unset'
  !rtext[1]         = ''

  -- Get specification from list of piping specs
  !sIndex           = !this.pipingSpecs.references.findFirst(!specification)

  if(!sIndex.set()) then

    -- Get bore of spec
    !boreList       = !this.specifications[!sIndex].bores()
    do !i indices !boreList
      -- Format object removed to fix bore size list errors
      !dtext.append(!boreList[!i].string(!!boreFmt))
      !rtext.append(!boreList[!i].string().replace('mm', '').replace('in', ''))
    enddo

    !gadget.dtext   = !dtext
    !gadget.rtext   = !rtext

    -- Select passed bore
    if(!bore.set()) then
      !bIndex = !rtext.findFirst(!bore.string().replace('mm', '').replace('in', ''))
      if(!bIndex.set()) then
        !gadget.val = !bIndex
      endif
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadBranchEnd
--
-- Description: Generate and display branch end information
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBranchEnd()

  -- Initialise Variables
  !end                  = !this.endConnection.end
  !endData              = !this.branches[!this.branchIndex].attribute(!end.upcase())

  -- Bore
  !bore                 = !endData.bore

  -- Connection Type
  !connection           = !endData.connection
  !connectionIndex      = !this.cocos.findFirst(!connection)

  -- Direction
  !direction            = !endData.direction.wrt(World).string().before('WRT').trim()

  -- Position

  -- Head Information
  if(!end.upcase() eq 'HEAD') then

    -- Load pipe bores
    !this.loadBores(!this.hBore, !bore, !this.branch.pspec)

    -- Select connection
    if(!connectionIndex.set()) then
    !this.hConn.val       = !connectionIndex
    else
      !!alert.warning('Connection type "' & !connection & '" does not exist in the available connection table (COCO).')
      !this.hConn.val       = 1
    endif

    -- Direction
    !this.hDir.val        = !direction

    !this.noHstuSpecs = !this.loadTubes(!this.hHstu, !bore, !this.branch.pspec)

  -- Tail
  else

    -- Load pipe bores
    !this.loadBores(!this.tBore, !bore, !this.branch.pspec)

    -- Select connection
    if(!connectionIndex.set()) then
    !this.tConn.val       = !connectionIndex
    else
      !!alert.warning('Connection type "' & !connection & '" does not exist in the available connection table (COCO).')
      !this.tConn.val       = 1
    endif

    -- Direction
    !this.tDir.val        = !direction

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadBranchEndRef
--
-- Description: Generate and display branch end ref information
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBranchEndRef()

  -- Initialise Variables
  !end                  = !this.endConnection.end
  !endData              = !this.branches[!this.branchIndex].attribute(!end.upcase())

  -- Connection Reference
  !reference            = !endData.reference
  if(!reference.set()) then

    -- Check for a bad reference
    if(badref(!reference)) then
      !referenceText    = 'End has a reference to either a deleted or element in a deferred database.'

    -- Construct the output string
    else
      !fullType         = !reference.fullType
      !type             = !fullType.substring(1,1) & !fullType.substring(2).lowcase()

      if(!reference.isNamed) then
        !referenceText  = !type & ' ' & !reference.flnm
      else
        !referenceText  = !reference.flnm
      endif

      -- Check end
      if(!endData.referenceEnd.empty().not()) then
        !referenceText  = !endData.referenceEnd & ' of ' & !referenceText

      endif

    endif

  else
    !referenceText      = 'End is unconnected'
  endif

  -- Action buttons for end
  !badEnd               = false

  -- Display Reference
  -- Head
  if(!end.upcase() eq 'HEAD') then

    if(!this.branch.lHead) then
      !this.refData.val       = !referenceText

      -- Check bore (problem with pQBore[val]
      CHECK $!<this.branch> !elements !errors
      if(!elements.set()) then
        if(!this.branch.string() eq !elements.first()) then
          !errorCodes         = !errors.first().split()
          do !i indices !errorCodes
            !code             = !errorCodes[!i].real()
            if(!code eq 70 or !code eq 71) then
              !badEnd         = true
              break
            endif
          enddo
        endif
      endif
    endif

  -- Tail
  else
    if(!this.branch.lTail) then
      !this.refData.val       = !referenceText

      -- Check bore (problem with pQBore[val]
      CHECK $!<this.branch> !elements !errors
      if(!elements.set()) then
        if(!this.branch.string() eq !elements.first()) then
          !errorCodes         = !errors.first().split()
          do !i indices !errorCodes
            !code             = !errorCodes[!i].real()
            if(!code eq 70 or !code eq 71) then
              !badEnd         = true
              break
            endif
          enddo
        endif
      endif
    endif

  endif

  !this.reconnect.active  = !badEnd
  !this.unconnect.active  = !reference.set()
  --!this.connect.active    = !reference.unset()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      connectivityData
--
-- Description: Generate and display connectivity information
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectivityData()

  -- Initialise Variables
  !this.branches.clear()
  !id       = ARRAY()
  !head     = ARRAY()
  !tail     = ARRAY()
  !branches = ARRAY()

  -- Get branch information for active pipe
  if(!this.pipe.members.empty().not()) then

    -- Loop through pipe members
    do !element values !this.pipe.members

      skip if(!element.type ne 'BRAN')

      -- Branch
      !branch = object PIPEBRANCH(!element)

      -- Add branch to list of branches
      if(!branch.set()) then
        !this.branches.append(!branch)
      endif

    enddo

    -- Define display list
    do !i indices !this.branches

      -- Branch
      !branches.append(!this.branches[!i].branch.string())

      -- Get branch identifier
      !identifier   = !this.branches[!i].identifier
      -- Use component sequence number
      if(!identifier.unset()) then
        !identifier = '[' & !this.branches[!i].branch.sequence & ']'
      endif
      !id.append(!identifier)

      -- Get branch head information
      !head.append(!this.branches[!i].briefDescription('head'))

      -- Get branch tail information
      !tail.append(!this.branches[!i].briefDescription('tail'))

    enddo

  endif

  -- Define connection table
  !columns[1]     = !id
  !columns[2]     = !head
  !columns[3]     = !tail
  !this.connectionTable.setColumns(!columns)
  !this.connectionTable.rtext = !branches

  -- If a branch selected, then re-select in the list
  if(!this.branch.set()) then
    !this.connectionTable.select('RTEXT', !this.branch.string())
    handle ANY
      if(!this.currentTask eq 'EDITBRANCH') then
        !this.setTask('modifyPipe')
      endif
    endhandle
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setTask
--
-- Description: Switch the relevant panels in and out for passed task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTask(!formTask is STRING)

  -- Initialise Variables
  !activeTask       = !this.currentTask
  !task             = !formTask.upcase()
  !this.currentTask = !task

  !this.coordinateSettings()


  -- Initialise all task gadgets
  if(!task eq 'INITIALISE') then
    !this.warningGadgets(false)
    !this.createPipeGadgets(false)
    !this.modifyPipeGadgets(false)
    !this.modifyPipeDataGadgets(false)
    !this.pipeDataGadgets(false)
    !this.editBranchGadgets(false)
    !this.editHeadGadgets(false)
    !this.editTailGadgets(false)
    !this.editEndRefGadgets(false)
    !this.branchTableGadgets(false)
    !this.modifyBranchDataGadgets(false)
    !this.branchDataGadgets(false)
    !this.connectEndGadgets(false)
    return
  endif

  ------- Remove existing task gadgets
  -- Remove warning task
  if(!this.warningTask) then
    !this.warningGadgets(false)

    -- Remove currently active task, if its not the sane
  elseif (!activeTask ne !task) then

    -- Remove specification selection task
    if(!activeTask eq 'CREATEPIPE') then
      !this.createPipeGadgets(false)
      !this.pipeDataGadgets(false)

    -- Remove select branch gadgets
    elseif (!activeTask eq 'MODIFYPIPE') then
      !this.branchTableGadgets(false)
      !this.modifyPipeGadgets(false)

    -- Remove select gadgets after editing branch
    elseif (!activeTask eq 'EDITBRANCH') then
      !this.branchTableGadgets(false)
      !this.modifyPipeGadgets(false)
      !this.editBranchGadgets(false)

    -- Remove edit branch gadgets
    elseif (!activeTask eq 'MODIFYPIPEDATA') then
      !this.modifyPipeDataGadgets(false)
      !this.pipeDataGadgets(false)

    -- Remove edit branch gadgets
    elseif (!activeTask eq 'MODIFYBRANCHDATA') then
      !this.branchTableGadgets(false)
      !this.modifyPipeGadgets(false)
      !this.modifyBranchDataGadgets(false)
      !this.branchDataGadgets(false)

    -- Remove edit branch gadgets
    elseif (!activeTask eq 'EDITBRANCH') then
      !this.editBranchGadgets(false)

    -- Remove edit branch head gadgets
    elseif (!activeTask eq 'EDITHEAD') then
      !this.tidy()
      !this.editHeadGadgets(false)
      !this.branchTableGadgets(false)
      !this.modifyPipeGadgets(false)

    -- Remove edit branch head reference gadgets
    elseif (!activeTask eq 'EDITHEADREF') then
      !this.tidy()
      !this.editEndRefGadgets(false)
      !this.modifyPipeGadgets(false)
      !this.branchTableGadgets(false)

    -- Remove edit branch tail gadgets
    elseif (!activeTask eq 'EDITTAIL') then
      !this.tidy()
      !this.endConnection = !this.branches[!this.branchIndex].tail
      !this.editTailGadgets(false)
      !this.branchTableGadgets(false)
      !this.modifyPipeGadgets(false)

    -- Remove edit branch tail reference gadgets
    elseif (!activeTask eq 'EDITTAILREF') then
      !this.tidy()
      !this.editEndRefGadgets(false)
      !this.modifyPipeGadgets(false)
      !this.branchTableGadgets(false)

    -- Remove connect end gadgets
    elseif (!activeTask eq 'CONNECTEND') then
      !this.tidy()
      !this.connectEndGadgets(false)
      !this.modifyPipeGadgets(false)
      !this.branchTableGadgets(false)

    endif

  endif

  ------------ Show alternative specification selection gadgets
  if(!task eq 'CREATEPIPE') then

    -- Initialise Variables
    !this.pipe          = object DBREF()
    !this.branch        = object DBREF()
    !this.branches.clear()
    !this.pipeName.val  = ''

    -- Display Gadgets
    !this.pipeDataGadgets(true)
    !this.createPipeGadgets(true)

  ------------ Show select branch gadgets
  elseif (!task eq 'MODIFYPIPE') then

    !selectedBranch     = !this.connectionTable.selection()

    -- Show branch information if branch is selected
    if(!selectedBranch.empty().not()) then
      !branch           = !selectedBranch.dbref()
      handle ANY
      elsehandle NONE
        !this.setTask('editBranch')
        return
      endhandle
    endif

    -- Display Gadgets
    !this.branchTableGadgets(true)
    !this.modifyPipeGadgets(true)

  ------------ Show edit branch gadgets
  elseif (!task eq 'MODIFYPIPEDATA') then

    -- Set current process information
    !this.setupPipeData()

    -- Display Gadgets
    !this.pipeDataGadgets(true)
    !this.modifyPipeDataGadgets(true)

  ------------ Show edit branch gadgets
  elseif (!task eq 'MODIFYBRANCHDATA') then

    -- Set current process information
    !this.setupBranchData()

    -- Display Gadgets
    !this.branchTableGadgets(true)
    !this.modifyPipeGadgets(true)
    !this.branchDataGadgets(true)
    !this.modifyBranchDataGadgets(true)

  ------------ Show edit branch gadgets
  elseif (!task eq 'EDITBRANCH') then

    -- Display pipe being modified
    !index                  = !this.branchIndex
    !this.branch            = !this.branches[!index].branch
    !identifier             = !this.branches[!index].identifier
    if(!identifier.unset()) then
      !identifier           = '[' & !this.branch.sequence & ']'
    endif

    -- Enhance branch
    ENHANCE $!<this.branch> COLOUR RED

    if(!this.branch.isNamed) then
      !this.branchNameTag.val = !this.branch.flnn
    else
      !this.branchNameTag.val = !identifier

    endif

    !specification          = !this.branches[!index].processData.specification
    if(!specification.unset()) then
      !this.branchSpec.val  = 'unset'
    else
      !this.branchSpec.val  = !specification.flnn
    endif

    -- Head Information
    !headDetail             = !this.branches[!this.branchIndex].detailDescription('head')
    !this.headBore.val      = !headDetail[1]
    !this.headConn.val      = !headDetail[2]
    !this.headRef.val       = !headDetail[3]
    !this.headDir.val       = !headDetail[4]
    !this.headPosE.val      = !headDetail[5]
    !this.headPosN.val      = !headDetail[6]
    !this.headPosU.val      = !headDetail[7]

    -- Tail Information
    !tailDetail             = !this.branches[!this.branchIndex].detailDescription('tail')
    !this.tailBore.val      = !tailDetail[1]
    !this.tailConn.val      = !tailDetail[2]
    !this.tailRef.val       = !tailDetail[3]
    !this.tailDir.val       = !tailDetail[4]
    !this.tailPosE.val      = !tailDetail[5]
    !this.tailPosN.val      = !tailDetail[6]
    !this.tailPosU.val      = !tailDetail[7]


    -- Display Gadgets
    !this.modifyPipeGadgets(true)
    !this.branchTableGadgets(true)
    !this.editBranchGadgets(true)

  ------------ Show edit branch head gadgets
  elseif (!task eq 'EDITHEAD') then
    !this.endConnection = !this.branches[!this.branchIndex].head

    -- Load head information
    !this.loadBranchEnd()

    -- Display Marker
    !this.tagEnd()

    -- Display Gadgets
    !this.branchTableGadgets(true)
    !this.modifyPipeGadgets(true)
    !this.editHeadGadgets(true)
    !this.posControl()

  ------------ Show edit branch head reference gadgets
  elseif (!task eq 'EDITHEADREF') then
    !this.refTag.val    = 'Modify Head Connection:'
    !this.endConnection = !this.branches[!this.branchIndex].head

    -- Load head information
    !this.loadBranchEndRef()

    -- If we only have a connection, then set task to connect end
    if(!this.reconnect.active.not() and !this.unconnect.active.not()) then
      !this.setTask(|connectEnd|)
    else

      -- Display Marker
      !this.tagEnd()

      -- Display Gadgets
      !this.editEndRefGadgets(true)
      !this.branchTableGadgets(true)
      !this.modifyPipeGadgets(true)

    endif

  ------------ Show edit branch head gadgets
  elseif (!task eq 'EDITTAIL') then
    !this.endConnection = !this.branches[!this.branchIndex].tail

    -- Load tail information
    !this.loadBranchEnd()

    -- Display Marker
    !this.tagEnd()

    -- Display Gadgets
    !this.branchTableGadgets(true)
    !this.modifyPipeGadgets(true)
    !this.editTailGadgets(true)
    !this.posControl()

  ------------ Show edit branch tail reference gadgets
  elseif (!task eq 'EDITTAILREF') then
    !this.refTag.val    = 'Modify Tail Connection:'
    !this.endConnection = !this.branches[!this.branchIndex].tail

    -- Load head information
    !this.loadBranchEndRef()

    -- If we only have a connection, then set task to connect end
    if(!this.reconnect.active.not() and !this.unconnect.active.not()) then
      !this.setTask(|connectEnd|)

    else
      -- Display Marker
      !this.tagEnd()

      -- Display Gadgets
      !this.editEndRefGadgets(true)
      !this.branchTableGadgets(true)
      !this.modifyPipeGadgets(true)

    endif

  ------------ Show end connection gadgets
  elseif (!task eq 'CONNECTEND') then

    -- Display end being connected
    !this.endTag.val              = 'Connect Branch ' & !this.endConnection.end & ' to:'
    !this.branchTableGadgets(true)
    !this.modifyPipeGadgets(true)
    !this.connectEndGadgets(true)

    -- Display Marker
    !this.tagEnd()

    !this.connectName.val   = !!ce.namn
    !this.connectionName()

  ------------ Show warning gadgets
  elseif (!task eq 'WARNING') then

    -- Display Gadgets
    !this.warningGadgets(true)

    -- Remember previous task
    !this.currentTask = !activeTask

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Done"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING)

  -- Initialise Variables
  !display  = ''

  !this.setTask('warning')
  do !i indices !message
    !display = !display & ' ' & !message[!i]
  enddo
  !this.warning.val           = !display
  !this.warningDone.callback  = !action
  !this.warningDone.active    = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      BOOLEAN     True if Done button is allowed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !allowDone is BOOLEAN)

  -- Initialise Variables
  !display  = ''

  !this.setTask('warning')
  do !i indices !message
    !display = !display & ' ' & !message[!i]
  enddo

  !this.setTask('warning')
  !this.warning.val               = !display
  !this.warningDone.callback      = '!this.resumeTask()'
  !this.warningDone.active        = !allowDone

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      resumeTask
--
-- Description: Revert to current task after a warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resumeTask()
  !this.setTask(!this.currentTask)
endmethod
-- End of method definition

