-- End of method

------------------------------------------------------------------------
--
-- Method:      checkConnectStatus
--
-- Description: check connecting status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF      checking about picked element be connected with another element.
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    It'll be return true if picked element already connected with another element.
------------------------------------------------------------------------
define method .checkConnectStatus(!element is DBREF) is BOOLEAN
  if (!element.type eq 'NOZZ') then
    if (!element.cref.badref().not()) then
      !!alert.error('Element is already connected, you can only connect to unconnected elements')
      return false
    endif
  elseif (!element.ahlist.findFirst('PIPE').unset()) then
     return false
  endif

  if (!this.pickedElements.findFirst(!element).unset()) then
    !this.pickedElements.append(!element)
    !this.pickedElements.unique()
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      connectRefElement
--
-- Description: connect reference element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]

------------------------------------------------------------------------
define method .connectRefElement()
  if (!this.pickedElements.unset()) then
    return
  endif

  -- get head and tail reference
  !headRefElement = !this.pickedElements[1]
  !tailRefElement = object DBREF()

  if (!this.pickedElements.size() gt 1) then
    !tailRefElement = !this.pickedElements.last()
  endif

  -- check head and tail reference
  if (!headRefElement.badref().not() and !tailRefElement.badref().not()) then
    if (!headRefElement.ahlist.findFirst('PIPE').set() and !tailRefElement.ahlist.findFirst('PIPE').set()) then
      if (!headRefElement.owner eq !tailRefElement.owner) then
        !tailRefElement = object DBREF()
      endif
    endif
  endif

  -- get head reference if picked element is component of one pipe
  if (!headRefElement.ahlist.findFirst('PIPE').set()) then
    !headRefElement = !headRefElement.owner
    !this.pipeSimpleEditor.connHeadType = !this.getBranchPickPos(!headRefElement, 'HEAD')
    if (!this.pipeSimpleEditor.connHeadType eq 'PH') then
      !this.pointList[1] = !headRefElement.hpos.wrt( /* )
    else
      !this.pointList[1] = !headRefElement.tpos.wrt( /* )
    endif
  else
    !this.pipeSimpleEditor.connHeadType = ''
  endif

  -- get tail reference if picked element is component of one pipe
  if (!tailRefElement.badref().not()) then
    if (!tailRefElement.ahlist.findFirst('PIPE').set()) then
      !tailRefElement = !tailRefElement.owner
      !this.pipeSimpleEditor.connTailType = !this.getBranchPickPos(!tailRefElement, 'TAIL')

      if (!this.pipeSimpleEditor.connTailType eq 'PH') then
        !this.pointList[!this.pointList.size()] = !tailRefElement.hpos.wrt( /* )
      else
         !this.pointList[!this.pointList.size()] = !tailRefElement.tpos.wrt( /* )
      endif

    else
      !this.pipeSimpleEditor.connTailType = ''
    endif
  endif

  !this.pipeSimpleEditor.branHeadRef = !headRefElement
  !this.pipeSimpleEditor.branTailRef = !tailRefElement

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getBranchPickPos
--
-- Description: get branch pick position ( PH or PT )
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1     R    DBREF            picked element
--    2     R    STRING           compare type between head or tail
-- Return:
--   [Data Type] [Description]
--    1     R    STRING           return nearest branch part between 'PH' or 'PT' from picked pos
--
------------------------------------------------------------------------
define method .getBranchPickPos(!branRef is DBREF, !partType is STRING) is STRING
  if (!branRef.ahlist.findFirst('PIPE').unset()) then
    return ''
  endif

  !branHpos = !this.modifyPosition(!branRef.hpos.wrt( /* ))
  !branTpos = !this.modifyPosition(!branRef.tpos.wrt( /* ))

  !firstPickPos = !this.modifyPosition(!this.pointList[1])
  !lastPickPos  = !this.modifyPosition(!this.pointList.last())

  if (!partType eq 'HEAD') then
    !headDist = abs(!firstPickPos.distance(!branHpos))
    !tailDist = abs(!firstPickPos.distance(!branTpos))

  else
    !headDist = abs(!lastPickPos.distance(!branHpos))
    !tailDist = abs(!lastPickPos.distance(!branTpos))
  endif

  if (!headDist gt !tailDist) then
    return 'PT'
  else
    return 'PH'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyPosition
--
-- Description: modifyPosition
-- It'll be difference between edg picking position if there are many picking position
-- So, picking position will be modified it to avoid this.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1     R    POSITION         picking position
-- Return:
--   [Data Type] [Description]
--    1     R    POSITION         modified position
--
------------------------------------------------------------------------
define method .modifyPosition(!inputPos is POSITION) is POSITION
  !modifiedPosStr = 'E ' & !inputPos.east.string(!!realFMT) & ' N ' & !inputPos.north.string(!!realFMT) & 'U ' & !inputPos.up.string(!!realFMT)
  !result = object POSITION(!modifiedPosStr)

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createAidLine
--
-- Description: Create Aid Line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1     R    EDGPOSITIONDATA   create aid line using by picking position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createAidLine(!data is EDGPOSITIONDATA)
  -- in exactly pos type, picking position is correct.
  -- others case, it need to modify position.
  !exactlyPosType = 'ELEMENT PPOINT GRAPHICS'

  if (!exactlyPosType.split().findFirst(!data.type).set()) then
    !toPos   = !data.position.wrt( /* )
    !enhanceCol = !!gphColOpt.aids()
    ENHANCE $!data.item COLOUR $!<enhanceCol.code>

    -- mark the selected element
    MARK $!data.item
  else
    !toPos   = !this.modifyPosition(!data.position.wrt( /* ))
  endif

  -- skip to create point if a element which was connected with other item
  if (!data.item.badref().not()) then
    if (!this.checkConnectStatus(!data.item).not()) then
      return
    endif
  endif

  -- skip if there is already same picked position
  if (!this.pointList.findFirst(!toPos).set()) then
    return
  endif

  -- get orthogonal position
  if (!this.tglOrthogonal.val AND !this.pointList.size() gt 0) then
    !this.getOrthogonalPos(!toPos)
  endif

  if (!this.optOffset.val) then
    !this.applyOffsetValue(!toPos)
  endif

  !this.position = !toPos
  !this.posControl.xyz(!this.position.east, !this.position.north, !this.position.up)
  !toPos = !this.getPosFromCntrl(!this.posControl.xyz())

  !this.pointList.append(!toPos)

  -- display aid line
  !this.showAidLine(!toPos)
  !this.cboPointList.select('DTEXT', !this.cboPointList.dtext[!this.cboPointList.dtext.size()])

  -- auto route mode will be enabled if there are two different position at least.
--  !this.setAutoRouteMode()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showAidLine
--
-- Description: show aid text / line / axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION   show aid line using by picked positions
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showAidLine(!position is POSITION)
  if (!this.pointList.unset()) then
    return
  endif

  !this.aidLineList.clear()

  !dtextList = object ARRAY()

  -- display aid line
  do !i indices !this.pointList
    !fromPos = !this.pointList[!i]

    -- display aid text for picked point number
    !!drawAidText(!i.string(), !fromPos, !this.aidLineNumber)
    !dtextList.append(!i.string())

    if (!i lt !this.pointList.size()) then
      !toPos   = !this.pointList[!i + 1]

      -- draw aid line
      !!aidLine(!this.aidLineNumber, !fromPos, !toPos )
      !this.aidLineList.append(object LINE(!fromPos, !toPos))
    endif
  enddo

  -- update point list gadget
  !this.cboPointList.dtext = !dtextList

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertAidPoint
--
-- Description: insert aid point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1     R    EDGPOSITIONDATA   insert aid point using by picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertAidPoint(!data is EDGPOSITIONDATA)
  !pickPos = !this.modifyPosition(!data.position.wrt( /* ))
  !index   = !this.cboPointList.selection()

  -- skip if current point list is empty or there is same position already.
  if (!index eq '' or !this.pointList.findFirst(!pickPos).set()) then
    return
  endif

  -- skip to create point if a element which was connected with other item
  if (!data.item.badref().not()) then
    if (!this.checkConnectStatus(!data.item).not()) then
      return
    endif
  endif

  -- get orthogonal position
  if (!this.tglOrthogonal.val AND !this.pointList.size() gt 0) then
    !this.getOrthogonalPos(!pickPos)
  endif

  if (!this.optOffset.val) then
    !this.applyOffsetValue(!pickPos)
  endif

  -- update point list
  !this.position = !pickPos
  !this.posControl.xyz(!this.position.east, !this.position.north, !this.position.up)
  !toPos = !this.getPosFromCntrl(!this.posControl.xyz())

  !this.pointList.insert(!index.real() + 1, !toPos)

  -- auto route mode will be enabled if there are two different position at least.
--  !this.setAutoRouteMode()

  if (!this.optOffset.val.not()) then
   !this.tidy()
  endif

  !this.showAidLine(!toPos)

  !tmpIndex = !index.real() + 1
  !this.cboPointList.select('DTEXT', !this.cboPointList.dtext[$!tmpIndex])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteAidLine
--
-- Description: delete Aid Point using selected index from point list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    BOOLEAN    delete aid line all or selected aid part
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteAidLine(!deleteAllFlag is BOOLEAN)
  if (!deleteAllFlag) then
    !this.cboPointList.clear()
    !this.pointList.clear()
    !this.pickedElements.clear()
    !this.tidy()
    return
  endif

  !index = !this.cboPointList.selection()

  if (!index eq '') then
    return
  endif

  !this.pointList.remove($!index)

  -- auto route mode will be enabled if there are two different position at least.
--  !this.setAutoRouteMode()

  if (!this.pointList.unset()) then
    !this.tidy()
    !this.cboPointList.clear()
    return
  endif

  !tempPosition = object POSITION()
  !tmpIndex  = 1

  if (!index.real() gt 1) then
    !tmpIndex = !index.real() - 1
    !tempPosition = !this.pointList[!tmpIndex]
  else
    !tempPosition = !this.pointList[1]
  endif

  !this.posControl.forceXYZ(!tempPosition.east, !tempPosition.north, !tempPosition.up)

  !this.tidy()

  !this.showAidLine(!tempPosition)

  !this.cboPointList.select('DTEXT', !this.cboPointList.dtext[!tmpIndex])
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: getPosFromCntrl
--
-- Description: Converts position array on position control to position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY    array for position on position control
-- Return:
-- [Data Type] [Description]
--  POSITION    return actual position
------------------------------------------------------------------------
define method .getPosFromCntrl(!pos is ARRAY) is POSITION
  !position = object POSITION('E0 N0 U0')
  !east  = !pos[0].string()
  !north = !pos[1].string()
  !up    = !pos[2].string()
  !position = object POSITION('E $!east N $!north U $!up')

  return !position

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      applyOffsetValue
--
-- Description: apply Offset values on specified position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION    picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyOffsetValue(!position is POSITION)
  if (undefined(!!edg3dposoffset)) then
    pml reload form !!edg3dposoffset
  endif

  !!edg3dposoffset.sourcePos = !position
  !!edg3dposoffset.sourceForm = !this
  !!edg3dposoffset.show()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOrthogonalPos
--
-- Description: get Orthogonal Position from last aid point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION    picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getOrthogonalPos(!position is POSITION)
  --coord XYZ
  !directionArray     = !!fmSys.currentdocument().view.direction

  !direction          = object DIRECTION('N')
  !direction.east     = !directionArray[1]
  !direction.north    = !directionArray[2]
  !direction.up       = !directionArray[3]

  !currentViewDir     = !direction.string().before('WRT').trim()

  !xDir = ''
  !yDir = ''
  !zDir = ''

  -- Get the right position point depending on which direction you are seeing in the 3D view.
  if (!currentViewDir inset ('X', '-X')) then
    !xDir = 'north'
    !yDir = 'up'
    !position.east =  !this.posControl.xyz()[0]
  elseif (!currentViewDir inset ('Y', '-Y')) then
    !xDir = 'east'
    !yDir = 'up'
    !position.north =  !this.posControl.xyz()[1]
  elseif (!currentViewDir inset ('Z', '-Z')) then
    !xDir = 'east'
    !yDir = 'north'
    !position.up =  !this.posControl.xyz()[2]
  endif

  !lastPos = !this.pointList[!this.pointList.size()]

  if (!xDir eq '' and !yDir eq '' and !zDir eq '') then
    !diff[1] = abs(!position.east  - !lastPos.east)
    !diff[2] = abs(!position.north - !lastPos.north)
    !diff[3] = abs(!position.up    - !lastPos.up)

    !sortedIndices = !diff.sortedIndices()
    if (!sortedIndices.last() eq 1) then
      !position.north = !this.pointList[!this.pointList.size()].north
      !position.up    = !this.pointList[!this.pointList.size()].up
    elseif (!sortedIndices.last() eq 2) then
      !position.east    = !this.pointList[!this.pointList.size()].east
      !position.up    = !this.pointList[!this.pointList.size()].up
    else
      !position.east    = !this.pointList[!this.pointList.size()].east
      !position.north = !this.pointList[!this.pointList.size()].north
    endif
  else
    !xDiff   = abs(!position.$!xDir - !lastPos.$!xDir)
    !yDiff   = abs(!position.$!yDir - !lastPos.$!yDir)

    if (!xDiff gt !yDiff) then
      !position.$!yDir = !this.pointList[!this.pointList.size()].$!yDir
    else
      !position.$!xDir = !this.pointList[!this.pointList.size()].$!xDir
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSelectedElements
--
-- Description: get selected pipe elements on 3d view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       Return selected pipe elements on 3d View
--
------------------------------------------------------------------------
define method .getSelectedElements() is ARRAY
  !selection = object SELECTION()
  !selection.getCurrent()

  !result = object ARRAY()

  !members = !selection.getSelection()
  if !this.checkForBranch(!members) then
     !this.copyBranch = !members[1]
  else
     !this.copyBranch = object DBREF()
  endif

  if (!members.set()) then
    !members.unique()

    do !entry values !members

      --skip if (!entry.type ne 'TUBI')
      skip if (!entry.ahlist.findFirst('PIPE').unset())

      !ownerElement = !entry.ownlst[!entry.ahlist.find('PIPE')[1]]
      skip if (!ownerElement.type eq 'HVAC')

      !result.append(!entry)
    enddo
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSelectedElementsToMirror
--
-- Description: get selected pipe elements on 3d view to be mirrored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--   ARRAY       Return selected pipe elements on 3d View
--
------------------------------------------------------------------------

define method .getSelectedElementsToMirror() is ARRAY

  !selection = object SELECTION()
  !selection.getCurrent()

  !result = !selection.getSelection()
  do !c indices !result
    !entry = !result[!c]
    if !entry.owner.type.neq('BRAN') then
      !result[!c].delete()
      skip
    endif
    if !entry.owner.owner.type.eq('HVAC') then
      !result[!c].delete()
      skip
    endif
    if !entry.type.eq('TUBI') then
      if !entry.mtbe.type.eq('BRAN').or(!entry.mten.type.eq('BRAN')).not() then
        !result[!c].delete()
        skip
      endif
    endif
  enddo

  if !result.unset() then
    return error 1 'No pipe elements selected. Please select elements.'
  endif

  !result.compress()

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getIntersectionInformation
--
-- Description: get selected tube and intersection position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY        return intersection information
--                it consists of two array include selected tube element and array of intersection position.
--   ex.)
--   1.return[1] = selected tube element (ex.)<DBREF> IL TUB OF =24170/563
--   2.return[2] = array of intersection position (ex) <ARRAY> 2 Elements

------------------------------------------------------------------------
define method .getIntersectionInformation() is ARRAY
  !!edgCntrl.escape()

  --get selected pipe elements on 3d View
  !selection = !this.getSelectedElements()
  if (!selection.unset()) then
    return error 1 'No pipe elements selected'
  endif

  -- check that points have been defined
  if( !this.pointList.empty() ) then
    return error 2 'Cannot find intersection. No points specified'
  endif

  !result    = object ARRAY()
  !firstAidLineIndex = -1
  !intersectedTubeRef = object DBREF()

  do !entry values !selection

    skip if (!entry.type neq 'TUBI')

    !line = object LINE(!entry.apos.wrt( /* ), !entry.lpos.wrt( /* ))
    !dir  = !line.direction()

    !nearestRefLine = object LINE(!line.near(!this.pointList[1]),!line.near(!this.pointList[!this.pointList.size()]))

    !intersections = object ARRAY()
    if (!nearestRefLine.startPosition eq !nearestRefLine.endPosition) then

      --need to check that the intersection point lies between the start and end point of the line as this doesn't seem to happen using the core functions
      --if it does then its a valid intersection so add it
      !pointInLineSegment = !this.pointInLineSegment(!line, !nearestRefLine.startPosition)
      if !pointInLineSegment.not() then
        skip
      endif

      !intersections.append(!nearestRefLine.startPosition)
      !intersectedTubeRef = !entry

    else
      !nearestRefLineDir = !nearestRefLine.direction()

      do !i indices !this.aidLineList
        !tmpAidLine = !this.aidLineList[!i]

        skip if (!dir.isparallel(!tmpAidLine.direction()))

        -- skip if there is no intersection point
        !tmpIntersection = !line.intersection(!tmpAidLine)
        handle any
          skip
        endhandle

        !arriveCheckLine = object LINE(!entry.apos.wrt( /* ), !tmpIntersection)
        !leaveCheckLine  = object LINE(!entry.lpos.wrt( /* ), !tmpIntersection)

        !isInvalidDir = !arriveCheckLine.direction() eq !leaveCheckLine.direction()

        skip if (!tmpIntersection.unset() OR !line.onProjected(!tmpIntersection).not() OR !isInvalidDir)

        --need to check that the intersection point lies between the start and end point of the line as this doesn't seem to happen using the core functions
        --if it does then its a valid intersection so add it
        !pointInLineSegment = !this.pointInLineSegment(!line, !tmpIntersection)
        if !pointInLineSegment.not() then
          skip
        endif

        !intersectedTubeRef = !entry

        if (!firstAidLineIndex eq -1) then
          !firstAidLineIndex = !i
        endif
        !intersections.append(!tmpIntersection)
      enddo
    endif

    skip if (!intersections.unset())

    if (!intersections.size() gt 1) then
      -- sorting intersection position
      !tmpLengthList = object ARRAY()
      do !i indices !intersections
        !tmpLengthList.append(!entry.apos.wrt( /* ).distance(!intersections[!i]))
      enddo

      !sortIndices = !tmpLengthList.sortedIndices()
      !intersections.reindex(!sortIndices)
    endif

    !table[1] = !intersectedTubeRef
    !table[2] = !intersections

    !result.append(!table)
  enddo

  -- aid line list will be reversed if first intersection position and end of first aid line is near than start of first aid line
  !reverseFlag = false
  if (!this.insertBranchMode and !result.set()) then
    !nearIntersectionPosOnAidLine = !this.aidLineList[1].near(!result[1][2][1])
    !fromDistance = !this.aidLineList[1].startPosition.distance(!nearIntersectionPosOnAidLine)
    !toDistance   = !this.aidLineList[1].endPosition.distance(!nearIntersectionPosOnAidLine)

    if (!fromDistance gt !toDistance) then
      !reverseFlag = true
    endif
  endif

  if (!reverseFlag) then
    !tmpReverseList = object ARRAY()
    do !i from !this.aidLineList.size() to 1 by -1
      !tmpReverseList.append(object LINE(!this.aidLineList[!i].endPosition, !this.aidLineList[!i].startPosition))
    enddo

    !this.aidLineList = !tmpReverseList
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkAidLineList
--
-- Description: checking whether aid line exist or not.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      Returns true if aid line exist
------------------------------------------------------------------------
define method .checkAidLineList() is BOOLEAN
  if (!this.aidLineList.unset()) then
    !this.tidy()
    !!alert.error(|Please specify points required by this function|)
    return false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkDbWrite
--
-- Description: check write access of current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return db write status
--
------------------------------------------------------------------------
define method .checkDbWrite() is BOOLEAN
  if(!!ce.dbWrite.not()) then
    !!alert.error('Unable to create element. You do not have write access to this element')
    return false
  else
    return true
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkClaimStatus
--
-- Description: check claim status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return db claim status
--
------------------------------------------------------------------------
define method .checkClaimStatus(!element is DBREF) is BOOLEAN
  if (not !element.okClaim and not !element.lclm) then
    if (!element.userC.empty()) then
      !userClaim = !element.owner.userC
    else
      !userClaim = !element.userC
    endif

    !!alert.error('Cannot modify: Claimed by ' + !userClaim)
    return false
  elseif (!element.lock) then
    !!alert.error('Cannot modify: Locked ' & !element.type & ' ' & !element.fullname)
    return false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createBranch
--
-- Description: create new branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createBranch()
  -- checking whether aid line exist or not.
  if (!this.checkAidLineList().not()) then
    return
  endif

  -- check right of write on db
  if (!this.checkDbWrite().not()) then
    unenhance all
    return
  endif

  !!edgCntrl.escape()

  -- get source branch if there is no selected pipe element
  !checkEntry = !this.getSourceBran()
  if (!checkEntry.not()) then
    !!alert.error('Please select source pipe branch on View or Design Explorer')
    return
  endif

  !saveCE = !!ce

  -- highlight selected element
  !!highlightSelection()

  -- get selected pipe elements on 3d View
  !selectedPipeMembers = !this.getSelectedElements()

  -- get selected tube and intersection position
  !intersectionInfo = object ARRAY()

  -- vertex point and direction list for reference when create branch
  !vertexPointList  = object ARRAY()
  !vertexDirections = object ARRAY()

  if (!selectedPipeMembers.set()) then
    !this.insertBranchMode = true
    !intersectionInfo = !this.getIntersectionInformation()
  endif

  !vertexPointList[1] = !this.aidLineList[1].startPosition

  do !entry values !this.aidLineList
    !vertexPointList.append(!entry.endPosition)
    !vertexDirections.append(!entry.direction())
  enddo

  !vertexDirections.append(!vertexDirections[!vertexDirections.size()].opposite())

  !vertexList[1] = !vertexPointList
  !vertexList[2] = !vertexDirections

  -- insertBranch flag will be true if there is intersection point.
  if (!intersectionInfo.set()) then
    !insertBranchFlag = true

    -- base tube : selected tube element which has intersection points with aid lines
    !baseTube      = !intersectionInfo[1][1]
    !this.branchData = object PIPEBRANCH(!baseTube.owner)

    !ceBore = p2 bore of $!saveCE
    if !ceBore.neq(!baseTube.lbore) then
       !!alert.error(|The bore size of the branch being created does not match with the bore size of the branch selected in the view. Please check the current element.|)
       return
    endif

  else
    !insertBranchFlag = false
  endif

  if (!insertBranchFlag) then
    if (!this.checkClaimStatus(!this.branchData.branch).not()) then
      return
    endif
  endif

  if (!this.updateBranchData(!vertexList).not()) then
    return
  endif

  -- start position of branch will be first intersection position if insertBranchFlag is true
  if (!insertBranchFlag) then
    --!this.pipeSimpleEditor.branStartPos = !intersectionInfo[1][2][1]

    -- input offset value
    do
      !input  = !!alert.input('Input branch Offset length (0 : using aid line)', '0')
      handle any
      elsehandle NONE
         -- get current units
        !fmt = !!distanceFMT
        !offset = !input.real(!fmt)
        handle ANY
          !offset = 0
        endhandle
        if !offset.lt(0) then
          !!alert.error('Offset must be positive')
        else
          break
        endif
      endhandle
    enddo



    if (!offset gt 0) then
      -- prevPos and newPosList is the position of the branch intersection
      !prevPos = !intersectionInfo[1][2][1]
      !newPosList[1] = !intersectionInfo[1][2][1]
      -- loop through the vertex list not directly in line with the main tube
      do !i from 2 to !vertexPointList.size()
        if (!i gt 2) then
          !offset = !vertexPointList[!i - 1].distance(!vertexPointList[!i])
        endif
        !newPos  = !prevPos.offset(!vertexDirections[!i - 1],!offset)
        !newPosList.append(!newPos)
      enddo
      !vertexList[1] = !newPosList
    endif
  endif


--  -- check element which will be connected with new branch
--  !this.connectRefElement()

  -- Define UNDO Information
  !this.undo.description('drawBranch')
  !this.undo.add()

  !this.pipeSimpleEditor.drawBranch(!vertexList, !insertBranchFlag,!this.dirchange.val)

  -- Mark end of Undo
  !this.undo.endUndoable()

  !!ce = !saveCE

  -- unenhance all
  unenhance all
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertFlangeSet
--
-- Description: insert flange set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING      assemble type
--                           1. FLANGE SET. : FLANGE + GASKET + FLANGE
--                           2. VAVLE SET.  : FLANGE + GASKET + VALVE + GASKET + FLANGE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertFittingSet(!assemblyType is STRING)
  !this.insertBranchMode = false

  -- get selected tube and intersection position
  !intersectionInfo = !this.getIntersectionInformation()

  -- checking whether aid line exist or not.
  if (!this.checkAidLineList().not()) then
    return
  endif

  !!edgCntrl.escape()

  -- check right of write on db
  if (!this.checkDbWrite().not()) then
    return
  endif

  -- check claim status
  !branchRef = !intersectionInfo[1][1].owner
  handle any
    return
  endhandle

  if (!this.checkClaimStatus(!branchRef).not()) then
    return
  endif

  -- highlight selected element
  !!highlightSelection()

  -- it'll be used to be checked if there is same component already with same position
  !existPos = object ARRAY()

  -- Define UNDO Information
  !this.undo.description('insertFittingSet')
  !this.pipeSimpleEditor.setDefault()

  do !i indices !intersectionInfo
    !entry = !intersectionInfo[!i][1]

    $!entry
    handle any
      skip
    endhandle

    do !insertPos values !intersectionInfo[!i][2]

      -- check position if there is same position or not.
      !checkPos = !this.modifyPosition(!insertPos)
      skip if (!existPos.findFirst(!checkPos).set())

      !existPos.append(!checkPos)

      if (!assemblyType eq 'FLG_SET') then
        !this.pipeSimpleEditor.insertFittingSet(!insertPos, !assemblyType)
      else
        !this.pipeSimpleEditor.insertFittingSet(!insertPos, !assemblyType)
      endif

      !this.undo.add()
    enddo
  enddo

  -- Mark end of Undo
  !this.undo.endUndoable()
  -- unenhance all
  unenhance all

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertExpansion
--
-- Description: insert expansion loop
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertExpansion(!insertByPass is BOOLEAN)
  !this.insertBranchMode = false

  !!edgCntrl.escape()

  -- [ getIntersectionInformation ]
  -- 1.intersectionInfo[1] = selected tube element
  -- 2.intersectionInfo[2] = array of intersection position
  -- ex. [1]  <DBREF> IL TUB OF =24170/563
  --     [2]  <ARRAY> 2 Elements
  !intersectionInfo = !this.getIntersectionInformation()
  if (!intersectionInfo.unset()) then
    return
  endif

  -- check right of write on db
  if (!this.checkDbWrite().not()) then
    return
  endif

  !branchRef = !intersectionInfo[1][1].owner
  handle any
    return
  endhandle

  if (!this.checkClaimStatus(!branchRef).not()) then
    return
  endif

  if (!this.aidLineList.unset() OR !this.aidLineList.size() lt 3) then
    !this.tidy()
    !!alert.error(|Please specify points required by this function|)
    return
  endif

  if (!insertByPass) then
    if (!intersectionInfo[1][2].size() ne 2) then
      !!alert.error('You can only create a bypass in a continuous piece of tube')
      return
--      if (!!alert.confirm('Do you want to create expansion loop with by-pass line?') eq 'YES') then
      !insertByPassFlag = true
    endif
  else
    !insertByPassFlag = false
  endif

  -- highlight selected element
  !!highlightSelection()

  -- base tube : selected tube element which has intersection points with aid lines
  !baseTube      = !intersectionInfo[1][1]
  !baseStartPos  = !intersectionInfo[1][2][1]

  !this.pipeSimpleEditor.branchData   = object PIPEBRANCH(!baseTube.owner)

  !baseTubeLine      = object LINE(!baseTube.apos.wrt( /* ), !baseTube.lpos.wrt( /* ))
  !baseTubeDir       = !baseTubeLine.direction()
  !nearestRefLine    = object LINE(!baseTubeLine.near(!this.pointList[1]),!baseTubeLine.near(!this.pointList[!this.pointList.size()]))
  !nearestRefLineDir = !nearestRefLine.direction()

  -- vertexList : the point set which used to be created expansion loop.
  -- vertexDirs : the direction set which used to be created expansion loop.
  -- it needs point and direction to create expansion loop.
  !vertexPointList = object ARRAY()
  !vertexDirs = object ARRAY()


  if (!nearestRefLineDir ne !baseTubeDir) then
    !vertexPointList    = !this.pointList.invert()

    !tmpReverseList = object ARRAY()
    do !i from !this.aidLineList.size() to 1 by -1
      !tmpReverseList.append(object LINE(!this.aidLineList[!i].endPosition, !this.aidLineList[!i].startPosition))
    enddo

    !this.aidLineList = !tmpReverseList
  else
    !vertexPointList    = !this.pointList
  endif

  !vertexPointList[1] = !baseStartPos
  !vertexDirs[1] = !baseTubeLine.direction().string().before('WRT')

  -- the last vertex point will be last intersection point between base tube and aid line
  !vertexPointList[!vertexPointList.size()] = !intersectionInfo[1][2][!intersectionInfo[1][2].size()]

  -- get vertex position / direction set
  do !entry values !this.aidLineList
    !lineDir = !entry.direction()
    !lineLen = !baseStartPos.distance(!entry.endPosition)

    skip if (!baseTubeLine.direction().isparallel(!lineDir))

    !vertexPos = !baseStartPos.offset(!lineDir, !lineLen)
    !vertexDirs.insert(!vertexDirs.size(), !lineDir.string().before('WRT'))

    !baseTubeLine = !entry
    !baseStartPos = !vertexPos
  enddo


--  if (!intersectionInfo[1][2].size() eq 2) then
--    if (!!alert.confirm('Do you want to create expansion loop with by-pass line?') eq 'YES') then
--      !insertByPassFlag = true
--    else
--      !insertByPassFlag = false
--    endif
--
--  else
--    !insertByPassFlag = false
--  endif

  -- Define UNDO Information
  !this.undo.description('insertExpansion')
  !this.undo.add()

  -- insert expansion
  !this.pipeSimpleEditor.insertExpansion(!vertexPointList, !vertexDirs, !insertByPass,!this.dirchange.val)

  -- Mark end of Undo
  !this.undo.endUndoable()
  -- unenhance all
  unenhance all
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSourceElementForInsertingSelection
--
-- Description: set source element for inserting selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1     R    EDGPICKDATA     picked position
-- Return:
--   [Data Type] [Description]
--    1     R    EDGPICKDATA     picked position
--
------------------------------------------------------------------------
define method .setSourceElementForInsertingSelection(!data is  EDGPICKDATA) is EDGPICKDATA
  !enhanceCol = !!gphColOpt.aids()
  ENHANCE $!data.item COLOUR $!<enhanceCol.code>

  !pickPos = !data.item.pos.wrt( /* )

  AID CLEAR ALL $!<this.aidLineNumber>
  AID TEXT  NUMBER $!<this.aidLineNumber> 'FROM' AT $!<pickPos>

  return !data
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayFlowDir
--
-- Description: display flow direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1     R    DBREF           source element that be shown flow direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayFlowDir(!element is DBREF)

  -- show element direction
  !leaveDir  = !element.ldir.wrt( /* )
  !leavePos  = !element.lpos.wrt( /* )
  !aidHeight = !element.lod * 2

  !pointVector = object POINTVECTOR(!leavePos, !leaveDir)

  !orthogonalDir   = !pointVector.direction.orthogonal(U)
  handle ANY
    !orthogonalDir = !pointVector.direction.orthogonal(N)
  endhandle

  !offsetDir = !orthogonalDir.orthogonal(!pointVector.direction)
  !aidPos    = !pointVector.position.offset(!offsetDir, !aidHeight  * 0.5)
  !centrePos = !aidPos.offset(!leaveDir, !aidHeight * 0.05)

  AID CLEAR ALL $!<this.aidLineNumber>
  -- show aid line
  AID CYLINDER NUMBER $!<this.aidLineNumber>  AT $!<centrePos>  ORI Z IS $!<leaveDir>   HEIGH $!<aidHeight> DIAM 8mm FILLED ON
  AID ARROW    NUMBER $!<this.aidLineNumber>  AT $!<centrePos> DIRECTION $!<pointVector.direction> HEIGH $!<aidHeight> PROPORTION 0.5

  -- Show aid text
  AID TEXT    NUMBER $!<this.aidLineNumber> 'Dir' AT $!<aidPos>
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertSelection
--
-- Description: insert selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1     R    EDGPICKDATA     source position which used to be inserted selecting.
--    2     R    EDGPICKDATA     target position which used to be inserted selecting.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertSelection(!firstPick is EDGPICKDATA, !secondPick is EDGPICKDATA)

  -- first and second elements are dbRefs
  !firstElement   = !firstPick.item
  !secondElement  = !secondPick.item
  -- TM new bit
  if !secondPick.type.neq('TUBING') then
     -- we need an offset
    !offsetRequired = TRUE
    !offsetPosition = !secondElement.position.wrt(/* )
    !offsetVector   = object POINTVECTOR()
    !offsetVector.position = !offsetPosition
    !offsetVector.direction = !secondElement.ldir.wrt(/* )
    -- the insertElement is the second pick
    !this.insertElement = !secondElement
  else
    -- find the position of the pick point in the tube
    -- no offset is required
    !tubing         = object EDGTUBING()
    !secondStartPos = !tubing.exact(!secondPick.item, !secondPick.pickLine)
    !offsetRequired = FALSE
    !input = 0
    !this.insertElement = !secondElement
    !this.insertPosition = !secondStartPos
  endif

  -- if we pick a valve and set an offset we need to work out the leave direction and the offset from the picked component

   if !offsetRequired then
     !this.displayFlowDir(!secondElement)
      -- input offset value
     do
       !input  = !!alert.input('Input offset', '0')
       handle any
       elsehandle NONE
        !fmt = !!distanceFMT
        !offset = !input.real(!fmt)
         break
       endhandle
     enddo
    !offsetVector   = object POINTVECTOR()
    !offsetVector.position = !offsetPosition

    if !offset.lt(0) then
      !offsetVector.direction = !secondElement.adir.wrt(/* )
      !offset = abs(!offset)
    else
      !offsetVector.direction = !secondElement.ldir.wrt(/* )
    endif
    !this.insertPosition = !offsetVector.offset(!offset).position
     -- go and find the insertElement
     !this.getInsertElement(!secondElement)
     !this.tidy()
   endif
  -- Initialise Variables

  if !this.insertElement.unset() then
    !this.insertElement = !secondElement
  endif

  -- TM end of new bit
  !pipeRef = !secondElement.owner.owner
  if (!this.checkClaimStatus(!pipeRef).not()) then
    unenhance all
    return
  endif

  -- check right of write on db
  if (!this.checkDbWrite().not()) then
    return
  endif

  -- highlight selected element
  !!highlightSelection()

  !fromPos  = !firstElement .position.wrt(/* )
  !toPos    = !this.insertPosition

  if (!fromPos eq !toPos) then
    !!alert.error('Destination Position is same as from position.')
    return
  endif

  !line     = object LINE(!fromPos, !toPos)
  !moveDir  = !line.direction().string().before('WRT')
  !moveDist = !fromPos.distance(!toPos)

  -- get selected element with origin sequence
  !selectedElements = !this.getElementWithSequence(!this.getSelectedElements())
  !selectedElements.sort()

  do !entry values !selectedElements
    !branRef = !entry.part(1).dbRef()

    if (!secondElement.owner eq !branRef) then
      !branRef = !secondElement.owner
      if (!this.checkClaimStatus(!branRef).not()) then
        unenhance all
        return
      endif

      break
    endif
  enddo

  -- Define UNDO Information
  !this.undo.description('insertSelection')
  !this.undo.add()

  !!ce = !this.insertElement

  if !this.copyBranch.set() then
    !this.pipeSimpleEditor.copyBranch(!this.copyBranch,!this.insertElement, !moveDir, !moveDist)
    !this.pipeSimpleEditor.insertSelection(!selectedElements, !!ce, !moveDir, !moveDist)
  else
    !this.pipeSimpleEditor.insertSelection(!selectedElements, !this.insertElement, !moveDir, !moveDist)
  endif

  !this.tidy()
  -- Mark end of Undo
  !this.undo.endUndoable()
  -- unenhance all
  unenhance all
  unmark all

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getInsertElement
--
-- Description: return the insert element using the offset
--
--
------------------------------------------------------------------------
define method .getInsertElement(!element is DBREF)

-- get all the tube lengths as lines
!tubes = ARRAY()
!tubes[1] = !this.line(!element.owner)
!this.insertElement = object DBREF()

do !a values !element.owner.members
  !tubes.append(!this.line(!a))
enddo

do !line index !tubes
   skip if !tubes[!line].length().eq(0)
   skip if !tubes[!line].unset()
   if !tubes[!line].on(!this.insertPosition) then
     if (!tubes[!line].startPosition.distance(!this.insertPosition) + !tubes[!line].endPosition.distance(!this.insertPosition)) eq !tubes[!line].length() then
       if !line.eq(1) then
         !this.insertElement = !element.owner
       else
         !this.insertElement = !element.owner.members[!line - 1]
       endif
       return
   endif
  endif
enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return tube definition as a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database Element
-- Return:
--   [Data Type] [Description]
--    LINE        Tubing as a line
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF) is LINE

  -- Initialise Variables

  -- If branch passed, used HEAD tube
  if(!dbRef.type eq 'BRAN') then
    return !this.line(!dbRef, 'HEAD')

  -- Return leave tube of component
  else
    return !this.line(!dbRef, 'LEAVE')
  endif

endmethod
-- End of method definition for .line(dbRef) LINE

------------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Return tube definition as a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database Element
--    2   R      STRING      Tube end (HEAD, LEAVE)
-- Return:
--   [Data Type] [Description]
--    LINE        Tubing as a line
--
------------------------------------------------------------------------

define method .line(!dbRef is DBREF, !end is STRING) is LINE

  -- Initialise Variables
  !line = object LINE()
  !vector = object POINTVECTOR()

  -- Head type identified
  if(!end.upcase() eq 'HEAD') then
    !vector.position = !dbRef.hPosition.wrt(/* )
    !vector.direction = !dbRef.hdir.wrt(/* )
    !atlen = !dbRef.ltlen
    !line = !vector.line(!atlen)
  -- Leave tube identified
  else
    !vector.position =  !dbRef.lPosition.wrt(/* )
    !vector.direction = !dbRef.ldir.wrt(/* )
    !atlen = !dbRef.ltlen
    !line  = !vector.line(!atlen)
  endif
  -- Return a line object
  return !line

endmethod
-- End of method definition for .line(dbRef, STRING) LINE


------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: mirror selected element(s)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mirror()
  -- get selected element with origin sequence
  !selectedElements = !this.getSelectedElementsToMirror()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !branchList = object ARRAY()
  do !entry values !selectedElements
    !branchList.append(!entry.owner)
  enddo
  !branchList.unique()

  do !branchRef values !branchList
    -- check claim status
    if (!this.checkClaimStatus(!branchRef).not()) then
      unenhance all
      return
    endif
  enddo

  !this.fraMirrorSelection.visible = true
  !this.fraCommands.visible = false
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorSelection
--
-- Description: mirror selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mirrorSelection()
  if (!this.txtMirrorDirection.val eq '') then
    !!alert.error('Please specify mirror direction')
    return
  endif

  -- get selected element with origin sequence
  !selectedElements = !this.getSelectedElementsToMirror()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- check right of write on db
  if (!this.checkDbWrite().not()) then
    return
  endif


  -- Define UNDO Information
  !this.undo.description('mirrorSelection')
  !this.undo.add()

  !this.pipeSimpleEditor.selectionMirror(!selectedElements, !this.mirrorDirection, !this.position)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  -- Mark end of Undo
  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMirrorPlane
--
-- Description: set mirror plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1     R    EDGPICKDATA   picked data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMirrorPlane(!pick is EDGPICKDATA)
  !pickItem = !pick.item

  -- define mirror line
  if (!pick.tubing neq ' ') then
    !tube = il tube of $!pickItem
    !mirrorLine = object LINE(!tube.apos.wrt( /* ), !tube.lpos.wrt( /* ))
  else
    !mirrorLine = object LINE(!pickItem.apos.wrt( /* ), !pickItem.lpos.wrt( /* ))
  endif

  !this.position = !pickItem.position.wrt( /* )
  !this.posControl.xyz(!this.position.east, !this.position.north, !this.position.up)
  !this.position = !this.getPosFromCntrl(!this.posControl.xyz())

  !this.mirrorOrientation      = !mirrorLine.plane().orientation
  !this.txtMirrorDirection.val = !mirrorLine.direction().string().before('WRT')

  !this.showMirrorPlane(!this.txtMirrorDirection.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMirrorPosition
--
-- Description: set Mirror Position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1     R    EDGPOSITIONDATA   picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMirrorPosition(!data is EDGPOSITIONDATA)
  !this.position = !data.position.wrt( /* )
  !this.showMirrorPlane(!this.txtMirrorDirection.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showMirrorPlane
--
-- Description: show mirror plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     direction of mirror
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showMirrorPlane(!mirrorDir is STRING)
  !plane  = object PLANE(!this.position, !this.mirrorOrientation)

  -- define aid plane for mirror
  !this.mirrorPlane = object GPHPLANE(!plane)
  !this.mirrorPlane.filled(true)
  !this.mirrorPlane.x = 1000mm
  !this.mirrorPlane.y = 1000mm

  !planeDir = ''
  if (!mirrorDir eq '') then
--    !planeDir = !this.txtMirrorDirection.val
--
--    if (!this.txtMirrorDirection.val neq '' and !this.txtMirrorDirection.val.set()) then
--      !direction       = object DIRECTION(!this.txtMirrorDirection.val)
--    else
      !direction       = !this.mirrorPlane.plane.direction().opposite()
      !this.txtMirrorDirection.val = !direction.string().before('WRT')
--    endif
  else
    !direction       = object DIRECTION(!mirrorDir)
    handle any
      !!alert.error(|Check Mirror Direction, please|)
      return
    endhandle
    !planeDir        = !mirrorDir
  endif

  if (!planeDir eq '') then
    !this.mirrorPlane.plane.orientation = !this.mirrorOrientation
  else
    !this.mirrorPlane.plane.orientation = object ORIENTATION('Z is $!planeDir')
  endif

  !this.tidy()

  !this.mirrorDirection = !planeDir
  !this.mirrorPlane.draw(!this.aidLineNumber)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      changeMirrorDirection
--
-- Description: change Mirror direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeMirrorDirection()
  !this.showMirrorPlane(!this.txtMirrorDirection.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      simpleAutoRoute
--
-- Description: simple auto route
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .simpleAutoRoute()
  -- checking whether aid line exist or not.
  if (!this.checkAidLineList().not()) then
    return
  endif

  !!edgCntrl.escape()

  !mem = !!ce

  -- get source branch if there is no selected pipe element
  !checkEntry = !this.getSourceBran()
  if (!checkEntry.not()) then
    !!alert.error('Please select source pipe branch')
    return
  endif

  -- check right of write on db
  if (!this.checkDbWrite().not()) then
    return
  endif

  -- check claim status
  !pipeRef = !this.branchData.branch.owner

  if (!this.checkClaimStatus(!pipeRef).not()) then
    unenhance all
    return
  endif

  if (!this.updateBranchData(!this.aidLineList).not()) then
    return
  endif

  -- check element which will be connected with new branch
  !this.connectRefElement()

  -- Define UNDO Information
  !this.undo.description('mirrorSelection')
  !this.undo.add()

  !this.pipeSimpleEditor.autoRoute(!this.pointList)

  -- Mark end of Undo
  !this.undo.endUndoable()
  !this.tidy()

  $!mem
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBranchData
--
-- Description:
-- update branch data using by reference point list
-- the point list used to be define start and end position of branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      reference positio list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateBranchData(!refPositionList is ARRAY) is BOOLEAN
  if (!refPositionList[1].objectType() eq 'ARRAY') then
    !this.pipeSimpleEditor.branStartPos = !refPositionList[1][1]
    !this.pipeSimpleEditor.branEndPos   = !refPositionList[1][!refPositionList[1].size()]

    !this.pipeSimpleEditor.branHeadDir  = !refPositionList[2][1]
    !this.pipeSimpleEditor.branTailDir  = !refPositionList[2][!refPositionList[2].size()]
  else
    !this.pipeSimpleEditor.branStartPos = !this.aidLineList[1].startPosition
    !this.pipeSimpleEditor.branEndPos   = !this.aidLineList[!this.aidLineList.size()].endPosition

    !this.pipeSimpleEditor.branHeadDir  = !this.aidLineList[1].direction()
    !this.pipeSimpleEditor.branTailDir  = !this.aidLineList[!this.aidLineList.size()].direction().opposite()
  endif

  -- check pipe branch data
  !processData = !this.branchData.processData
  !branchName  = !this.branchData.branch.fullname

  if (!processData.specification.unset()) then
    !!alert.error(|Please define specification of source branch : $!branchName|)
    return false
  endif

  if (!this.branchData.head.bore.unset()) then
    !!alert.error(|Please define head bore of source branch : $!branchName|)
    return false
  endif

  if (!this.branchData.tail.bore.unset()) then
    !!alert.error(|Please define tail bore of source branch : $!branchName|)
    return false
  endif

  !mem = !!ce

  !!ce = !this.branchData.branch
  !unusedHeadBore = select hstu
  handle any
    !!alert.error(!!error.text)
    !!ce = !mem
    return false
  endhandle

  !!ce = !mem

  !this.pipeSimpleEditor.branchData   = !this.branchData

  if (!this.tglQuickPipeRouter.val) then
    !this.pipeSimpleEditor.isQuickRoute = true
  else
    !this.pipeSimpleEditor.isQuickRoute = false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .checkForBranch
--
-- Description:
--  Input
--    1     R     ARRAY   selected element list
------------------------------------------------------------------------
define method .checkForBranch(!selectedElements is ARRAY) is BOOLEAN

if !selectedElements.size().gt(1) then
  if !selectedElements[1].string().match('IL TUB').gt(0).or(!selectedElements[1].string().match('IL TUB').gt(0)) then
    return FALSE
  endif
  if !selectedElements[1].eq(!selectedElements[2]).and(!selectedElements[1].type.eq('BRAN')) then
     return TRUE
  endif
endif

return FALSE

endmethod

------------------------------------------------------------------------
--
-- Method:      getElementWithSequence
--
-- Description:
--  get elements with sequence using by element sequence.
--  because select object not return always element with hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     ARRAY    picked position
-- Return:
--   [Data Type] [Description]
--    1     R     ARRAY    return selected element with origin sequence
------------------------------------------------------------------------
define method .getElementWithSequence(!selectedElements is ARRAY) is ARRAY
  if (!selectedElements.unset()) then
    return error 1 'No pipe elements selected. Please select elements'
  endif

  !result = object ARRAY()

  do !entry values !selectedElements
    skip if (!entry.type inset ('TUBI', 'BRAN') OR !entry.ahlist.findFirst('PIPE').unset())

    !ownerElement = !entry.ownlst[!entry.ahlist.find('PIPE')[1]]
    skip if (!ownerElement.type eq 'HVAC')

    !sequence  = substring('0000' + !entry.sequ.string(), -4, 4)
    !insertStr = !entry.owner.name + ' ' + !sequence + ' ' + !entry.name
    !result.append(!insertStr)
  enddo

  !result.sort()

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSourceBran
--
-- Description:
-- used to be get source branch if there is no selected pipe element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      return true if it was success to get source branch
--
------------------------------------------------------------------------
define method .getSourceBran() is BOOLEAN
  !element  = !!ce

  if (!element.ahlist.findFirst('PIPE').unset()) then
    return false
  endif

  !ownerElement = !element.ownlst[!element.ahlist.find('PIPE')[1]]
  if (!ownerElement.type eq 'HVAC') then
    return false
  endif

  if(!element.type eq 'BRAN') then
    !branch = !element
  elseif (!element.owner.type eq 'BRAN' ) then
    !branch = !element.owner
  else
    -- Use first branch of pipe
    pipe
    handle any
      return false
    endhandle

    !pipe = !!ce
    same

    !branch    = BRANCH 1 OF $!<pipe>
    handle ANY
      !!alert.error('Please select source branch')
      return false
    endhandle
  endif

  !this.branchData = object PIPEBRANCH(!branch)

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()
  !!edgCntrl.escape()
  AID CLEAR ALL $!<this.aidLineNumber>
  handle any
  endhandle

  unenhance all
  unmark all

  if (defined(!!edg3dposoffset)) then
    !!edg3dposoffset.hide()
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pointInLineSegment
--
-- Description: figure out if a point lies between the boundaries of a line segment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--     BOOL       if the point passed lies between the start and end point of the passed line then return true
--                this is required because the core line object doesn't seem to be checking this when dealing with intersections
------------------------------------------------------------------------
define method .pointInLineSegment(!line is LINE, !point is POSITION) is BOOLEAN

  --first define a POINTVECTOR from start to end of the passed line
  !startPos = !line.startPosition
  !endPos = !line.endPosition
  !startToEndDir = !startPos.direction(!endPos)
  !startToEndPV = object POINTVECTOR(!startPos, !startToEndDir)

  --now move the pv through the passed point
  !pointPV = !startToEndPV.through(!point)

  --create a PV at the start point looking towards the pointPV
  !startToPointDir = !startPos.direction(!pointPV.position)
  !startToPointPV = object POINTVECTOR(!startPos, !startToPointDir)

  --get a dot product and determine if the point is in between start and end (should be near 1 if it is)
  !dotP = !startToEndPV.direction.dot(!startToPointPV.direction)

  --if we pass the dot product test then we need to check that the distance to the point from the start is less than or equal to the distance from start to end of the passed line
  if !dotP.gt(0.9999) then
    !startToEndDist = !line.length()
    !startToPointDist = !startToEndPV.position.distance(!pointPV.position)

    if !startToPointDist.leq(!startToEndDist) then
      return TRUE
    else
      return FALSE
    endif
  else
    return FALSE
  endif

endmethod
