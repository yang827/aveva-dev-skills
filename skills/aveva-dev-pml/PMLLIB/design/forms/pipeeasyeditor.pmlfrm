------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyOffsetValue(POSITION)       -                   apply Offset values on specified position
--  backToMainTask()                 -                   back to main task
--  changeMirrorDirection()          -                   change Mirror direction
--  checkAidLineList()               BOOLEAN             checking whether aid line exist or not
--  checkClaimStatus(DBREF)          BOOLEAN             check claim status
--  checkConnectStatus(DBREF)        BOOLEAN             check connecting status
--  checkDbWrite()                   BOOLEAN             check right access of current db write
--  checkForBranch(ARRAY)            BOOLEAN             Input
--  connectRefElement()              -                   connect reference element
--  createAidLine(EDGPOSITIONDATA)   -                   Create Aid Line
--  createBranch()                   -                   create new branch
--  deleteAidLine(BOOLEAN)           -                   delete Aid Point using selected index from point list
--  derivePosition()                 -                   update current position with picked position
--  derivePositionByOffset(POSITION) -                   derive position by offset
--  displayFlowDir(DBREF)            -                   display flow direction
--  getBranchPickPos(DBREF,STRING)   STRING              get branch pick position ( PH or PT )
--  getElementWithSequence(ARRAY)    ARRAY               get elements with sequence using by element sequence
--  getInsertElement(DBREF)          -
--  getIntersectionInformation()     ARRAY               get selected tube and intersection position
--  getOrthogonalPos(POSITION)       -                   get Orthogonal Position from last aid point
--  getPosFromCntrl(ARRAY)           POSITION            Converts position array on position controller to position
--  getSelectedElements()            ARRAY               get selected pipe elements on 3d view
--  getSelectedElementsToMirror()    ARRAY               get selected pipe elements on 3d view to be mirrored
--  getSourceBran()                  BOOLEAN             used to be get source branch if there is no selected pipe element
--  initPosCntl()                    -                   initialize position control
--  initialise()                     -                   initialize gadget
--  insertAidPoint(EDGPOSITIONDATA)  -                   insert aid point
--  insertExpansion(BOOLEAN)         -                   insert expansion loop
--  insertFittingSet(STRING)         -                   insert flange set
--  insertSelection(EDGPICKDATA,EDGPICKDATA) -                   insert selection
--  line(DBREF)                      LINE                Return tube definition as a line
--  line(DBREF,STRING)               LINE                Return tube definition as a line
--  mirror()                         -                   mirror selected element(s)
--  mirrorSelection()                -                   mirror selection
--  modifyPosition(POSITION)         POSITION            modify Position to improve precision.
--  pickStart(STRING)                -                   picking point(s) or tube element
--  pipeEasyEditor()                 -                   constructor
--  pointInLineSegment(LINE,POSITION) BOOLEAN             figure out if a point lies between the boundaries of a line segment
--  selectPointList()                -                   current point number will be shown whenever changing point on the point list gadget
--  setMirrorPlane(EDGPICKDATA)      -                   set mirror plane
--  setMirrorPosition(EDGPOSITIONDATA) -                   setMirrorPosition
--  setSourceElementForInsertingSelection(EDGPICKDATA) EDGPICKDATA         set source element for inserting selection
--  showAidLine(POSITION)            -                   show aid text / line / axes
--  showMirrorPlane(STRING)          -                   show mirror plane
--  simpleAutoRoute()                -                   simple auto route
--  tidy()                           -                   tidy aid graphics
--  updateBranchData(ARRAY)          BOOLEAN             update branch data using by reference point list
--
-----------------------------------------------------------------------
-- Import DLL for positioning
import 'PositionControl'
handle ANY
endhandle

-- Define form
setup form !!pipeEasyEditor dialog
  -- add / insert / delete pick points
  button .pickPoints                                            at x1       ymax0.5   tooltip 'Create Point'          pixmap width 18 height 18 call |!this.pickStart('DRAW_AID_LINE')|
  button .insertAidLine                                         at xmax0.5  ymin      tooltip 'Add(Insert) Point'     pixmap width 18 height 18 call |!this.pickStart('INS_AID_POINT')|
  button .deleteAidLine                                         at xmax0.5  ymin      tooltip 'Delete'                pixmap width 18 height 18 call |!this.deleteAidLine(false)|
  button .deleteAllAidLine                                      at xmax0.5  ymin      tooltip 'Delete All Aid Point'  pixmap width 18 height 18 call |!this.deleteAidLine(true)|

  -- list of picked positions
  combo  .cboPointList   'Points'     tagwid 5                  at xmax1    ymin      callback  '!this.selectPointList()' width 2

  -- option for picking with orthogonal direction
  toggle .tglOrthogonal  'orth'       tagwid 3                  at xmax0.5  ymin

  -- option for picking with offset
  toggle .optOffset      'offset'     tagwid 5                  at xmax0.5  ymin

  -- position control
  frame .fraPositionControl panel                               at x1       ymax0.3   width 35 hei 4
    container .netPositionFrame PMLNetCONTROL 'NET' dock fill
  exit

  -- define command buttons
  frame .fraCommands        panel                               at x0       ymax      width 35 hei 1
    button  .btncreateBranch                                    at x1       ymin0.5   tooltip 'Create Branch'                     callback |!this.createBranch()|                 pixmap width 20 height 20
    button  .btnInsertFlgSet                                    at xmax1.5  ymin      tooltip 'Insert Flange Set'                 callback |!this.insertFittingSet('FLG_SET')|    pixmap width 20 height 20
    button  .btnInsertValveSet                                  at xmax1.5  ymin      tooltip 'Insert Valve Set'                  callback |!this.insertFittingSet('VALVE_SET')|  pixmap width 20 height 20
    button  .btnInsertExpansion                                 at xmax1.5  ymin      tooltip 'Insert Expansion Loop'             callback |!this.insertExpansion(false)|         pixmap width 20 height 20
    button  .btnInsertExpansionWithBypass                       at xmax1.5  ymin      tooltip 'Insert ByPass'                     callback |!this.insertExpansion(true)|          pixmap width 20 height 20
    button  .btnCopySelection                                   at xmax1.5  ymin      tooltip 'Copy Selection'                    callback |!this.pickStart('INS_SELECTION')|     pixmap width 20 height 20
    button  .btnMirrorSelection                                 at xmax1.5  ymin      tooltip 'Mirror Selection'                  callback |!this.mirror()|                       pixmap width 20 height 20
--    button  .btnAutoRoute                                       at xmax1.5  ymin      tooltip 'Auto Route'                        callback |!this.simpleAutoRoute()|              pixmap width 20 height 20

    toggle  .tglQuickPipeRouter 'Quick Pipe Router'             at x1       ymax0.5
    toggle  .dirchange 'Use Bends' at xmax ymin
  exit

  -- mirror with selected pipe elements
  frame .fraMirrorSelection panel                               at x1       ymin      width 35  height 1
    text      .txtMirrorDirection 'Mirror Dir' tagwid 7         at xmin0.5  ymin0.8             callback '!this.changeMirrorDirection()' width 6 is STRING
    button    .btnMirror          'Mirror'                      at xmax1    ymin      width 7   callback |!this.mirrorSelection()|

    button    .btnMirrorPickDir                                 at xmax1    ymin      tooltip 'Pick Mirror Direction'     callback |!this.pickStart('PICK_MIRROR_DIR')| pixmap width 16 height 16
    button    .btnMirrorPickPos                                 at xmax1.5  ymin      tooltip 'Pick Mirror Position'      callback |!this.pickStart('PICK_MIRROR_POS')| pixmap width 16 height 16

    paragraph .pgBackToMainTasks                                   at x0.1  ymax1     pixmap    width 16 height 16
    button    .btnBackToMainTasks  linkLabel 'Back to Main Tasks'  at xmax1 ymin      width 20  callback |!this.backToMainTask()|

  exit

    -- aid number for aid line
  member .aidLineNumber     is REAL

  -- picked position list
  member .pointList         is ARRAY

  -- aid line list based on picked position
  member .aidLineList       is ARRAY

  -- current picked position
  member .position          is POSITION

  -- the element where the component is going to be inserted
  member .insertElement     is DBREF

  -- the actual position of the insert element
  member .insertPosition    is POSITION

  -- orientation for mirror
  member .mirrorOrientation is ORIENTATION

  -- aid plane for mirror
  member .mirrorPlane       is GPHPLANE

  -- direction for mirror
  member .mirrorDirection   is STRING

  -- array of selected pipe elements
  member .selectedElements  is ARRAY

  -- name of branch to be copied
  member .copyBranch        is DBREF

  -- offset list
  member .offsetList        is ARRAY

  -- picked elements
  member .pickedElements    is ARRAY

  -- flag about insert or new branch
  member .insertBranchMode  is BOOLEAN

  -- Pipe Process Information
  member .branchData        is PIPEBRANCH

  -- object for piping simple editing
  member .pipeSimpleEditor  is PIPESIMPLEEDITOR

  -- PMLNet Position control
  using namespace 'Aveva.Pdms.Presentation'
  member .posControl        is POSITIONCONTROL

  -- undo event handler
  member .undo              is UNDOABLE
exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      pipeeasyeditor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pipeEasyEditor()
  -- set form title
  !this.formtitle = '2D Pipe Sketching'

  -- set background icons
  !this.pickPoints.addPixmap(!!pml.getPathName('addaidline.png'))
  !this.insertAidLine.addPixmap(!!pml.getPathName('insertaidpoint.png'))
  !this.deleteAidLine.addPixmap(!!pml.getPathName('deleteaidpoint.png'))
  !this.deleteAllAidLine.addPixmap(!!pml.getPathName('deleteallaidpoint.png'))

  !this.btncreateBranch.addPixmap(!!pml.getPathName('inserbranch.png'))
  !this.btnInsertFlgSet.addPixmap(!!pml.getPathName('insertflgset.png'))
  !this.btnInsertValveSet.addPixmap(!!pml.getPathName('includefieldson24.png'))
  !this.btnInsertExpansion.addPixmap(!!pml.getPathName('insertexploop.png'))
  !this.btnInsertExpansionWithBypass.addPixmap(!!pml.getPathName('insertbypassline.png'))
  !this.btnCopySelection.addPixmap(!!pml.getPathName('spldrgadd24.png'))
  !this.btnMirrorSelection.addPixmap(!!pml.getPathName('mirrorbranch.png'))

  !this.btnMirrorPickDir.addPixmap(!!pml.getPathName('pickmirrordir.png'))
  !this.btnMirrorPickPos.addPixmap(!!pml.getPathName('pickmirrorpos.png'))

  !this.pgBackToMainTasks.addPixmap(!!pml.getPathName('tick.png'))

  -- define aid line number
  !this.aidLineNumber = !!aidNumbers.add('pipeEasyEditor')

  -- initialize position and orientation of mirror
  !this.position          = object POSITION('E 0 N 0 U 0')
  !this.mirrorOrientation = object ORIENTATION('Z is Z')

  !this.initcall   = |!this.initialise()|
  !this.quitcall   = |!this.tidy()|
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialise gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  -- frame for commands will be shown
  !this.fraCommands.visible = true

  -- It'll be activated if there are two more aid points.
--  !this.btnAutoRoute.active = false

  -- It'll be shown if mirror button is click
  !this.fraMirrorSelection.visible = false

  !this.tidy()

  -- initialise position control
  !this.initPosCntl()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initPosCntl
--
-- Description: initialize position control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initPosCntl()
  -- declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- create new instance of position control
  !this.posControl        = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                   = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then
    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialize as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')
  else
    !this.posControl.gridvisible(FALSE)
  endif

  -- Initialise Control
  --!this.posControl.forceXYZ(!this.position.east, !this.position.north, !this.position.up)
  !this.posControl.changeAction('!!' & !this.name() & '.derivePosition()')

  var !coordinate coordinate
  -- change format of position control
  if(!grid.xID.set() and (!coordinate.eq('XYZ'))) then
   !this.posControl.gridFormat()
  elseif(!coordinate.eq('XYZ')) then
   !this.posControl.xyzFormat()
  else
   !this.posControl.enuformat()
  endif

  -- Add PMLNet control to PML frame
  !this.netPositionFrame.control  = !this.posControl.handle()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      derivePosition
--
-- Description: update current position with picked position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .derivePosition()
  !posArray  = !this.posControl.xyz()
  !east      = !posArray[0].string()
  !north     = !posArray[1].string()
  !up        = !posArray[2].string()

  -- get position from position control
  !position = object POSITION('E $!east N $!north U $!up wrt /* ')

  -- Mirror plane will be shown if mirrorPlane is set
  if (!this.mirrorPlane.set()) then
    !this.position = !position
    !this.showMirrorPlane(!this.txtMirrorDirection.val)
    handle any
    endhandle
  endif

  !index = !this.cboPointList.selection()
  if (!index eq '') then
    return
  endif

  !this.pointList[$!index] = !position

  !this.tidy()

  -- show aid line
  !this.showAidLine(!position)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      derivePositionByOffset
--
-- Description: derive position by offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION    offset position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .derivePositionByOffset(!position is POSITION)
  !index = !this.cboPointList.selection()
  if (!index eq '') then
    return
  endif

  !this.position = !position
  !this.posControl.xyz(!this.position.east, !this.position.north, !this.position.up)
  !toPos = !this.getPosFromCntrl(!this.posControl.xyz())
  !this.pointList[$!index] = !toPos

  AID CLEAR ALL $!<this.aidLineNumber>

  -- show aid line
  !this.showAidLine(!position)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectPointList
--
-- Description:
-- current point number will be shown whenever changing point on the point list gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectPointList()
  if (!this.pointList.unset()) then
    return
  endif

  !index     = !this.cboPointList.selection()
  !selectedPos = !this.pointList[$!index]
  !this.posControl.forceXYZ(!selectedPos.east, !selectedPos.north, !selectedPos.up)

  !this.tidy()
  !this.showAidLine(!selectedPos)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      backToMainTask
--
-- Description: back to main task
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .backToMainTask()
  !this.fraMirrorSelection.visible = false
  !this.fraCommands.visible = true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickStart
--
-- Description: picking point(s) or tube element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     picking position as picking mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickStart(!mode is STRING)
  -- Define event packet
  !packet           = object EDGPACKET()
  !packet.priority  = 3
  !packet.remove    = true

  !!highlightSelection()

  if (!mode eq 'DRAW_AID_LINE') then
    !this.pointList.clear()
    !this.pickedElements.clear()
    !this.tidy()

    !prompt        = 'Pick Point, <esc> to exit'
    !packet.remove = false
    !packet.action = '!!' & !this.name() & '.createAidLine(!this.return[1])'
    !packet.pickPacket.stdPosition(!prompt)

  elseif (!mode eq 'INS_AID_POINT') then
    !prompt        = 'Pick Point <esc> to exit'

    if (!this.optOffset.val) then
      !packet.remove    = false
    endif

    !packet.action = '!!' & !this.name() & '.insertAidPoint(!this.return[1])'
    !packet.pickPacket.stdPosition(!prompt)

  elseif (!mode eq 'INS_SELECTION') then


    --get selected pipe elements on 3d View
    !selection = !this.getSelectedElements()
    if (!selection.unset()) then
      !!alert.error('No pipe elements selected')
      return
    endif

    !packet.pickPacket.picks[1] = object EDGPICKTYPE()
    !packet.pickPacket.picks[1].stdElement('Pick source pipe component')
    !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
    !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
    !packet.pickPacket.picks[1].pick.modifiable = FALSE
    !packet.pickPacket.picks[1].action          = '!!' & !this.name() & '.setSourceElementForInsertingSelection(!this.return[1])'

    !packet.pickPacket.picks[2] = object EDGPICKTYPE()
    !packet.pickPacket.picks[2].stdElement('Pick target pipe component')
    !packet.pickPacket.picks[2].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
    !packet.pickPacket.picks[2].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
    !packet.pickPacket.picks[2].pick.modifiable = FALSE

    !packet.action = '!!' & !this.name() & '.insertSelection(!this.return[1][1],!this.return[1][2])'

  elseif (!mode eq 'PICK_MIRROR_DIR') then
    !prompt        = 'Pick Element For Mirroring'
    !packet.action = '!!' & !this.name() & '.setMirrorPlane(!this.return[1])'
    !packet.pickPacket.stdGraphic(!prompt)

  elseif (!mode eq 'PICK_MIRROR_POS') then
    !prompt        = 'Pick Position For Mirroring'
    !packet.action = '!!' & !this.name() & '.setMirrorPosition(!this.return[1])'
    !packet.pickPacket.stdPosition(!prompt)

  endif

  -- Add event to system
  !!edgCntrl.add(!packet)
endmethod
-- End of method

