-- File:           pipeSlopeForm.pmlfrm
-- Type:           Form Definition
-- Group:          Piping Application
--
-- Keyword:        PIPING
-- Module:         design
-- Replaces:
--
-- Author:         S.Bailey
-- Created:        24/05/2010 12:40:21
-- Last Modified:
-- Description:
-- Form to apply a slope to a pipe.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyRedo()                      -                   Handles redo - simply recalculates the pipe
--  applyUndo()                      -                   Handles undo - simply recalculates the pipe
--  displayPipe(DBREF,BOOLEAN)       -                   Displays a pipe
--  displaySlope()                   -                   Updates the form's slope controls
--  drawBranches()                   -                   Draws AID lines on the branches to show how the components
--  initialise()                     -                   Initialise the form each time it is displayed
--  kill()                           -                   Clean up routine called when the form is destroyed
--  labelCurrentBranchLeg()          -                   Add labels to the specified branch leg
--  onAnchorButton(REAL)             -                   Called when one of the anchor buttons is pressed
--  onAnchorType(GADGET)             -                   Called when a selection is made in an anchor type gadget
--  onAngle()                        -                   Sets the slope angle
--  onApplyButton()                  -                   Called when the apply button is pressed. Applies changes to the pipe
--  onBackButton()                   -                   Called when the back button is pressed
--  onBranchLegSelected()            -                   Handle selections in the branch leg list
--  onFirstShown()                   -                   Sets up the local view when the form is first shown
--  onForwardsButton()               -                   Called when the forwards button is pressed
--  onHorizontalLegSlopeLeg()        -                   Called when the HorizontalLegSlopeLegToggle is pressed
--  onLegAnchorPoint(GADGET)         -                   Called when an anchor point radio button is pressed
--  onLegComponent(GADGET)           -                   Called when a selection is made in an anchor component gadget
--  onLegDistance()                  -                   Handles changes to the leg distance field
--  onLegFrom(GADGET)                -                   Handles changes to the anchor from option box
--  onLegOffset(GADGET)              -                   Called when then leg offset is changed
--  onPickElement()                  -                   Called when the pick element button is pressed. Sets up EDG
--  onPickPosition()                 -                   Called when the pick position button is pressed. Sets up EDG
--  onSetBranchLegAngle()            -                   Set slope angle for branch
--  onSetBranchLegSlope()            -                   Changes the angle of a leg
--  onSlope()                        -                   Sets the slope value
--  onSlopeDirection()               -                   Called when the forwards button is pressed
--  pipeSlopeForm()                  -                   Constructor
--  processEscape()                  -                   EDG escape handler
--  processPickElement(EDGPICKDATA)  -                   EDG callback used when an element is picked
--  processPickPosition(EDGPOSITIONDATA) -                   EDG callback used when an element is picked
--  quit()                           -                   Clean up routine called when the form is closed
--  setCurrentPipe(DBREF)            -                   Sets the current pipe and displays it
--  setDisplayLimits(DBREF)          -                   Set the display limits
--  showHorizontalLegAttributes(BOOLEAN) -                   Display attributes for horizontal leg
--  showVerticalLegAttributes(BOOLEAN) -                   Display attributes for vertical leg
--  track()                          -                   Updates the form when the CE changes
--  updateAttributePanels()          -                   Updates the attribute panels
--  updateBranchLegList()            -                   Fills the branch leg list
--  updateBranches()                 -                   Updates the whole pipe and the form when a branch leg is changed
--  updateForm(BOOLEAN)              -                   Updates the entire form
--
------------------------------------------------------------------------

setup form !!pipeSlopeForm dialog dock size 40 27 noalign

  valign centre

  -- Form controls
  button .currentPipe linklabel 'Current pipe' anchor left + top at x0.1 ymin width 12.5
  paragraph .currentPipeTag anchor left + top at x 16  width 27

  path down
  text .slopeVal tagwidth 16 at xmin.currentPipe is STRING
  path right
  option .slopeDirection at xmax.slopeVal + 12 width 5
  path down

  text .slopeAngle tagwidth 16 'Nominal angle' at xmin.currentPipe is REAL format !!angleFmt

  toggle .forwards at xmin.currentPipe 'Forwards' tagwidth 14
  path right
  button .showMessages linklabel 'Show messages' at xmin.currentPipeTag
  path down

  paragraph .branchLegs at xmin.currentPipe text 'Branch legs'
  list .branchLegList at xmin.currentPipe + 0.4 anchor top + left width 40 lines 7.5

  !tagWidth = 'tagWidth 12'
  !width = 'width 12'

  vdist 0.75
  frame .horizontalLegAttributeFrame 'Horizontal' at xmin.branchLegList width 42 height 12
    vdist 0.15

    toggle .horizontalLegSlopeLeg 'Slope leg' tagWidth 8
    path right
    text   .horizontalLegSlope tagwidth 8 '1 in:' is STRING
    option .horizontalLegSlopeDirection at xmax.horizontalLegSlope + 12 width 5

    path down
    text    .horizontalLegAngle 'Angle' at xmin.horizontalLegSlope tagwidth 8 width .horizontalLegSlope  is REAL format !!angleFmt
    rtoggle .horizontalLegFirstAnchor 'First anchor' tagWidth 8 at xmin.horizontalLegSlopeLeg
    path right
    rtoggle .horizontalLegSecondAnchor 'Second anchor' at xmin.horizontalLegAngle
    path down

    option .horizontalLegAnchorType 'Anchor type' $!tagWidth at xmin.horizontalLegSlopeLeg $!width
    option .horizontalLegComponent 'Component' $!tagWidth  $!width
    text   .horizontalLegDistance 'Distance' at ymin.horizontalLegComponent $!tagWidth  $!width is REAL format !!distanceFmt
    path right
    button .horizontalLegPickPosition linklabel 'Pick position' at xmax.horizontalLegDistance + 3 width 8
    path down
    option .horizontalLegAnchorPoint 'Anchor point' at xmin.horizontalLegDistance $!tagWidth  $!width
    path down
    text   .horizontalLegOffset 'Offset' $!tagWidth  $!width is REAL format !!distanceFmt
    option .horizontalLegFrom 'From' $!tagWidth  $!width
    text   .horizontalLegOf 'Of' $!tagWidth  $!width is STRING

    path right
    button .horizontalLegPickElement linklabel 'Pick element' at xmax.horizontalLegOf + 3 width 8
    path down

  exit

  frame .verticalLegAttributeFrame 'Vertical' at xmin.branchLegList ymin.horizontalLegAttributeFrame width 42 height 12
    vdist 0.15

    rtoggle .verticalLegFirstAnchor 'First anchor' tagWidth 8 at xmin.horizontalLegSlopeLeg
    path right
    rtoggle .verticalLegSecondAnchor 'Second anchor' at xmin.horizontalLegAngle
    path down

    option .verticalLegAnchorType 'Anchor type' $!tagWidth at xmin.horizontalLegSlopeLeg $!width
    option .verticalLegComponent 'Component' $!tagWidth  $!width
    option .verticalLegAnchorPoint 'Anchor point' $!tagWidth  $!width
    text   .verticalLegOffset 'Offset' $!tagWidth  $!width is REAL
    option .verticalLegFrom 'From' $!tagWidth  $!width
    text   .verticalLegOf 'Of' $!tagWidth  $!width is STRING

    path right
    button .verticalLegPickElement linklabel 'Pick element' at xmax.verticalLegOf + 3 width 8
    path down

  exit

  frame .vframe panel at xmax .currentPipeTag  ymin.currentPipeTag anchor left + top + right + bottom

      para .prompt at ymin.vframe text 'Navigate' width 60 lines 1

      valign bottom

      view .localView at xmin.vframe + 0.75 ymin.vframe call '!!edgCntrl.canvasPick(' prompt .prompt GIVol height 25.5 width 70
      isometric 3

      -- Specify the view inmode - Needed for EDG
     inmode create _navi       type |DES_NAVIGATE|
     inmode create _pick       type |DES_PICK|
     inmode create _pAny       type |DES_PICK_ANY|
     inmode create _pLine      type |DES_PICK_PLINE|
     inmode create _point      type |DES_PICK_POINT|
     inmode create _screen     type |DES_3D_LINE|
     inmode create _pickXGeom  type |DES_PICK_XGEOM|
     inmode create _pickDetail type |DES_PICK_DETAIL|
     inmode create _default    type |DES_NAVIGATE|
     exit
  exit
  path right
  button .backButton 'Back'  width 8 at xmax.verticalLegAttributeFrame-size ymax.vframe-0.75-size
  path left
  button .applyButton 'Apply' width 8

  track |DESICE| call |!this.track()|

  -- Form members
  member .drawlist              is REAL
  member .allowTracking         is BOOLEAN
  member .pipeSlopePresenter    is PIPESLOPEPRESENTER
  member .aidTextNumber         is REAL
  member .aidValidLineNumber    is REAL
  member .aidInvalidLineNumber  is REAL
  member .aidArrowNumber        is REAL
  member .undoApply             is UNDOABLE
  member .anchorInfo            is PIPESLOPEANCHORINFO
exit
--End of form definition

------------------------------------------------------------------------
--
-- Method:   pipeSlopeForm
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .pipeSlopeForm()

  -- Form and icon titles
  !this.iconTitle              = 'Slope Pipe'
  !this.formTitle              = 'Slope Pipe'
  !this.autoScroll             = TRUE
  !this.helpContextID          = 'HID_PIPESLOPEFORM'

  -- Set form callbacks
  !this.firstShownCall         = |!this.onFirstShown()|
  !this.initCall               = |!this.initialise()|
  !this.quitCall               = |!this.quit()|
  !this.killingCall            = |!this.kill()|

  -- Set main form gadget callbacks
  !this.currentPipe.callback   = |!this.setCurrentPipe(!!ce)|
  !this.forwards.callback      = |!this.onForwardsButton()|
  !this.showMessages.callback  = |show !!pipeSlopeMessageForm|
  !this.slopeDirection.callback= |!this.onSlopeDirection()|
  !this.branchLegList.callback = |!this.onBranchLegSelected()|
  !this.applyButton.callback   = |!this.onApplyButton()|
  !this.backButton.callback    = |!this.onBackButton()|
  !this.slopeVal.callback      = |!this.onSlope()|
  !this.slopeAngle.callback    = |!this.onAngle()|

  -- Set gadget callbacks for horizontal leg panel
  !this.horizontalLegSlopeLeg.callback = |!this.onHorizontalLegSlopeLeg()|

  !this.horizontalLegSlope.callback = |!this.onSetBranchLegSlope()|
  !this.horizontalLegAngle.callback = |!this.onSetBranchLegAngle()|
  !this.horizontalLegSlopeDirection.callback = |!this.onSetBranchLegAngle()|
  !this.horizontalLegFirstAnchor.callback = |!this.onAnchorButton(1)|
  !this.horizontalLegSecondAnchor.callback = |!this.onAnchorButton(2)|

  !this.horizontalLegAnchorType.callback = |!this.onAnchorType(!this.horizontalLegAnchorType)|
  !this.horizontalLegComponent.callback = |!this.onLegComponent(!this.horizontalLegComponent)|
  !this.horizontalLegDistance.callback = |!this.onLegDistance()|
  !this.horizontalLegPickPosition.callback = |!this.onPickPosition()|
  !this.horizontalLegAnchorPoint.callback = |!this.onLegAnchorPoint(!this.horizontalLegAnchorPoint)|
  !this.horizontalLegOffset.callback = |!this.onLegOffset(!this.horizontalLegOffset)|
  !this.horizontalLegFrom.callback = |!this.onLegFrom(!this.horizontalLegFrom)|
  !this.horizontalLegPickElement.callback = |!this.onPickElement()|

  -- Set gadget callbacks for vertical leg panel
  !this.verticalLegFirstAnchor.callback = |!this.onAnchorButton(1)|
  !this.verticalLegSecondAnchor.callback = |!this.onAnchorButton(2)|
  !this.verticalLegAnchorType.callback  = |!this.onAnchorType(!this.verticalLegAnchorType)|

  !this.verticalLegComponent.callback = |!this.onLegComponent(!this.verticalLegComponent)|
  !this.verticalLegAnchorPoint.callback = |!this.onLegAnchorPoint(!this.verticalLegAnchorPoint)|
  !this.verticalLegOffset.callback = |!this.onLegOffset(!this.verticalLegOffset)|
  !this.verticalLegFrom.callback = |!this.onLegFrom(!this.vertialLegFrom)|
  !this.verticalLegPickElement.callback = |!this.onPickElement()|

  !this.localView.callback    = |'!!edgCntrl.canvasPick('|

  -- Setup the direction gadgets
  !directions  = ARRAY()
  !directions.append('Up')
  !directions.append('Down')
  !this.slopeDirection.dtext = !directions

  -- Setup the branch leg list
  !headings = ARRAY()
  !headings.append('Leg')
  !headings.append('Start')
  !headings.append('Finish')
  !headings.append('Drop')
  !headings.append('Length')
  !this.branchLegList.setHeadings(!headings)

  -- Disable the back button
  !this.backButton.active = false

  -- Setup option gadgets in the horizontal leg frame
  !this.horizontalLegSlopeDirection.dtext = !directions

  !dtext = ARRAY()
  !rtext = ARRAY()
  !this.anchorInfo.getHorizontalTypeList(!dtext, !rtext)
  !this.horizontalLegAnchorType.dtext = !dtext
  !this.horizontalLegAnchorType.rtext = !rtext

  !this.horizontalLegAnchorPoint.dtext = !this.anchorInfo.getMethodList()
  !this.horizontalLegFrom.dtext = !this.anchorInfo.getMethodList()

  -- Setup option gadgets in the vertical leg frame
  !this.anchorInfo.getVerticalTypeList(!dtext, !rtext)
  !this.verticalLegAnchorType.dtext = !dtext
  !this.verticalLegAnchorType.rtext = !rtext

  !this.verticalLegAnchorPoint.dtext = !this.anchorInfo.getMethodList()
  !this.verticalLegFrom.dtext = !this.anchorInfo.getMethodList()

  !this.localView.prompt = !this.prompt
  !this.drawlist = !!gphDrawlists.createDrawList()

  !this.undoApply.description('Apply Pipe Slope')
  !this.undoApply.undoAction('!!pipeSlopeForm.applyUndo()')
  !this.undoApply.redoAction('!!pipeSlopeForm.applyRedo()')
  !this.applyButton.setUndoable(!this.undoApply)

  -- Load the pipe slope message form

  if (undefined(!!pipeSlopeMessageForm)) then
    pml load form !!pipeSlopeMessageForm
  endif

endmethod
-- End of method .pipeSlopeForm

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .initialise()

  !this.prompt.visible = false
  !this.localView.active = TRUE
  !this.allowTracking = true

  -- AID numbers used in drawing
  !this.aidTextNumber   = !!aidNumbers.add('pipeSlopeForm Text')
  !this.aidValidLineNumber  = !!aidNumbers.add('pipeSlopeForm Valid Line')
  !this.aidInvalidLineNumber  = !!aidNumbers.add('pipeSlopeForm Invalid Line')
  !this.aidArrowNumber = !!aidNumbers.add('pipeSlopeForm Arrows')

  !this.setCurrentPipe(!!ce)

endmethod
-- End of method .initialise

------------------------------------------------------------------------
--
-- Method:      .onFirstShown()
--
-- Description: Sets up the local view when the form is first shown
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onFirstShown()

  !this.prompt.visible = false

   -- Set up display
  !this.localView.showaxes = FALSE

  !this.localView.background = !!gphViews.views.first().background
  handle any
    !this.localView.background = 15
  endhandle

  -- Create local drawlist within the global object

  !this.localView.visible = TRUE

  -- Add 3D view to view system
  !!gphViews.add(!this.localView)
  !!edgCntrl.addView(!this.localView)

  -- Add local drawlist add to 3D view
  !!gphDrawlists.attachView(!this.drawlist, !this.localView)

  !this.localView.shaded = TRUE

endmethod
-- end of method .onFirstShown


------------------------------------------------------------------------
--
-- Method:      .setCurrentPipe
--
-- Description: Sets the current pipe and displays it
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setCurrentPipe(!element is DBREF)

  !previousPipe = !this.pipeSlopePresenter.getCurrentPipe()
  !errorMessage = !this.pipeSlopePresenter.setCurrentPipe(!element)
  !this.updateForm(!this.pipeSlopePresenter.getCurrentPipe() ne !previousPipe)

  -- Display any error message
  if (!errorMessage.set()) then
    !!alert.error(!errorMessage)
  endif
endmethod
-- End of method setCurrentPipe(DBREF)

------------------------------------------------------------------------
--
-- Method:      displayPipe
--
-- Description: Displays a pipe
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       Pipe to draw
--  2   R      BOOLEAN     Whether to reset the view limits and drawlist
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayPipe(!pipe is DBREF, !resetView is BOOLEAN)

  !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
  if (!resetView) then
    !drawlist.removeAll()
    !this.setDisplayLimits(!pipe)
    !drawlist.add(!pipe)
  endif

  !this.localView.refresh()

  -- Make branches translucent so the AID lines can be seen more clearly
  do !branch values !this.pipeSlopePresenter.getBranches()
   !drawlist.translucency(!branch.getBranch(), 50) $* Arbitrary number 50
  enddo

  !this.drawBranches()

endmethod
-- End of method .displayPipe


------------------------------------------------------------------------
--
-- Method:      drawBranches
--
-- Description: Draws AID lines on the branches to show how the components
--              will be moved
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .drawBranches()
  -- Clear the current aid graphics
  AID CLEAR LINE $!<this.aidValidLineNumber>
  handle (41, 6)
    -- Ignore 'Non-existent element error'
  endhandle

  AID CLEAR LINE $!<this.aidInvalidLineNumber>
  handle (41, 6)
    -- Ignore 'Non-existent element error'
  endhandle

  AID CLEAR ARROW $!<this.aidArrowNumber>
  handle (41, 6)
    -- Ignore 'Non-existent element error'
  endhandle

  AID CLEAR CYLINDER $!<this.aidArrowNumber>
  handle (41, 6)
    -- Ignore 'Non-existent element error'
  endhandle

  !lineStyle = 1  $* Solid
  !line = object LINE()

  -- Draw assorted AID lines and arrows to mark the new leg positions and slope directions
  !branches = !this.pipeSlopePresenter.getBranches()
  do !branch values !branches

    !legIndex = 1
    !branchLegs = !branch.getBranchLegs()
    do !branchLeg values !branchLegs
      if (!branch.isBranchLegValid(!legIndex)) then
        !aidLineNumber = !this.aidValidLineNumber
        !lineColour = 5 $* Default AIDs colour
      else
        !aidLineNumber = !this.aidInvalidLineNumber
        !lineColour = 2 $* Red
      endif

      !newStartPosition = !branchLeg.getAdjustedStartPosition()
      !newFinishPosition = !branchLeg.getAdjustedFinishPosition()
      !oldFinishPosition = !newFinishPosition
      !oldFinishPosition.up = !newStartPosition.up

      -- Draw triangle to represent sloped pipe
      !line.startPosition = !newStartPosition
      !line.endPosition = !newFinishPosition
      !line.draw(!aidLineNumber, !lineStyle, !lineColour)
      handle (2, 785) $* Start and end are coincident
      endhandle

      !line.startPosition = !newFinishPosition
      !line.endPosition = !oldFinishPosition
      !line.draw(!aidLineNumber, !lineStyle, !lineColour)
      handle (2, 785)
      endhandle

      !line.startPosition = !oldFinishPosition
      !line.endPosition = !newStartPosition
      !line.draw(!aidLineNumber, !lineStyle, !lineColour)
      handle (2, 785)
      endhandle

      -- Arrow to indicate slope
      !arrowRatio = 1
      !arrowLength = 100mm
      if (!newStartPosition ne !newFinishPosition) then
        !arrowPosition = !newStartPosition.midPoint(!newFinishPosition)
        !arrowDirection = !newStartPosition.direction(!newFinishPosition)
        if (!this.pipeSlopePresenter.getAngle() lt 0) then
          !arrowDirection = !arrowDirection.opposite()
        endif

        if (!branchLeg.isLegVertical.not() and !branchLeg.getAdjustedAngle().abs() gt !!pipeSlopeUtilities.angleTolerance) then
          AID ARROW NUMBER $!<this.aidArrowNumber> AT $!<arrowPosition> DIR $!<arrowDirection> HEIGHT $!<arrowLength> PROP $!<arrowRatio>
        endif
      endif

      !legIndex = !legIndex + 1
    enddo
  enddo

  -- If the current leg has a fixed position, draw a thin cylinder to represent it
  !currentBranchLeg = !this.pipeSlopePresenter.getCurrentBranchLeg()
  if (!currentBranchLeg.isLegValid() and !currentBranchLeg.isLegHorizontal()) then

   !anchorPoint =!this.pipeSlopePresenter.getCurrentAnchorPoint()
    if (!anchorPoint.getAnchorType() eq !this.anchorInfo.typePosition) then
      -- Make the disc diameter larger than the branch bore
      !branch = !currentBranchLeg.getBranch()
      if (!branch.hbore.set()) then
        !diameter = !branch.hbore.real()
      elseif (!branch.tbore.set()) then
        !diameter = !branch.tbore.real()
      else
        !diameter = 100mm
      endif
      !diameter = !diameter * 1.5

      !startPosition = !currentBranchLeg.getStartPosition()
      !finishPosition = !currentBranchLeg.getFinishPosition()
      !line = object LINE(!startPosition, !finishPosition)
      !position = !line.proportion(!anchorPoint.distance / !currentBranchLeg.getLength())

      !horzPlane = object PLANE(!startPosition, Z is UP)
      !zDirection = !line.projected(!horzPlane).direction()
      !orientation = Z is $!<zDirection>

      AID CYLINDER NUMBER $!<this.aidArrowNumber> DIAMETER $!<diameter> HEIGHT 1mm AT $!<position> ORI $!<orientation> FILL ON

    endif
  endif

  -- Mark the flow direction
  !components = !!collectAllFor('TUBI', '', !this.pipeSlopePresenter.getCurrentPipe())
  do !tube values !components
    !arrowPosition = !tube.itpos
    !arrowLength = !tube.lbore.real()
    !arrowDirection = !arrowPosition.direction(!tube.lpos)
    handle (2, 891) $* Invalid zero direction
    elsehandle none
      AID ARROW NUMBER $!<this.aidArrowNumber> AT $!<arrowPosition> DIR $!<arrowDirection> HEIGHT $!<arrowLength> PROP $!<arrowRatio>
    endhandle
  enddo

 !this.labelCurrentBranchLeg()

endmethod
-- End of method .drawBranches

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Updates the form when the CE changes
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  if (!this.allowTracking) then
    !branchLegIndex = !this.pipeSlopePresenter.findBranchLegIndex(!!ce)
    if (!branchLegIndex gt 0 and !branchLegIndex ne !this.pipeSlopePresenter.getCurrentLegIndex()) then
      !this.branchLegList.val = !branchLegIndex
      !this.onBranchLegSelected()
    endif
  endif

endmethod
-- End of method .track

------------------------------------------------------------------------
--
-- Method:     setDisplayLimits
--
-- Description: Set the display limits
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDisplayLimits(!element is DBREF)

  -- Setup format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Get volume of item
  !volume      = object VOLUME(!element)
  !volume.from = !volume.from.string(!format).position()
  !volume.to   = !volume.to.string(!format).position()

  -- Load view limits with Volume
  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  -- Set view Limits
  !this.localView.limits = !array
  handle (61, 620)
endhandle
endmethod
-- End of method .setDisplayLimits

------------------------------------------------------------------------
--
-- Method:      onBranchLegSelected
--
-- Description: Handle selections in the branch leg list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onBranchLegSelected()

  !currentLegIndex = !this.branchLegList.val
  !this.pipeSlopePresenter.setCurrentLegIndex(!currentLegIndex)

  !this.updateAttributePanels()

  -- Redraw branches - necessary because the AID graphics sometimes
  -- erases the AID lines as well as the text labels.
  !this.drawBranches()
  !this.labelCurrentBranchLeg()

endmethod
-- End of method .onBranchLegSelected

------------------------------------------------------------------------
--
-- Method:      showVerticalLegAttributes
--
-- Description:
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .showVerticalLegAttributes(!show is BOOLEAN)

  if (!show) then
    !title = 'Branch leg ' & !this.pipeSlopePresenter.getCurrentLegIndex().string() & '   [Vertical]'
    !this.verticalLegAttributeFrame.tag = !title

    if (!this.pipeSlopePresenter.getAnchorNumber() eq 1) then
      !this.verticalLegFirstAnchor.val = true
      !searchText = 'Leg finish'
      !replaceText = 'Leg start'
    else
      !this.verticalLegSecondAnchor.val = true
      !searchText = 'Leg start'
      !replaceText = 'Leg finish'
    endif

    !dtext = !this.verticalLegAnchorType.dtext
    !index = !dtext.findFirst(!searchText)
    if (!index.set()) then
      !rtext = !this.verticalLegAnchorType.rtext
      !dtext[!index] = !replaceText
      !this.verticalLegAnchorType.dtext = !dtext
      !this.verticalLegAnchorType.rtext = !rtext
    endif

    !anchorPoint =!this.pipeSlopePresenter.getCurrentAnchorPoint()
    !anchorType = !anchorPoint.getAnchorType()

    !this.verticalLegAnchorType.select('RTEXT', !anchorType)

    -- Show or hide controls according to the anchor type
    if (!anchorType eq !this.anchorInfo.typeNone or !anchorType eq !this.anchorInfo.typeEnd) then
      !this.verticalLegComponent.visible = false
      !this.verticalLegAnchorPoint.visible = false
      !this.verticalLegOffset.visible = false
      !this.verticalLegFrom.visible = false
      !this.verticalLegOf.visible = false
      !this.verticalLegPickElement.visible = false
   else
      if (!anchorType eq !this.anchorInfo.typeComponent) then
        !names = ARRAY()
        !componentIndices = ARRAY()
        !this.pipeSlopePresenter.getCurrentLegAnchorComponents(!names, !componentIndices)
        !this.verticalLegComponent.dtext = !names
        !this.verticalLegComponent.rtext = !componentIndices
        !anchorComponentName = !this.pipeSlopePresenter.getComponentName(!anchorPoint.getComponent().dbRef())
        !this.verticalLegComponent.select('DTEXT', !anchorComponentName)
        handle (61, 567)
          -- Anchor component name not found - component is probably the branch
        endhandle
        !this.verticalLegComponent.visible = true
      else
        return error 1 'Unknown anchor type'
      endif

      !this.verticalLegOffset.val = !anchorPoint.getOffset()
      !this.verticalLegOf.val = !this.pipeSlopePresenter.getElementName(!anchorPoint.getFromElement())
      !this.verticalLegAnchorPoint.select('DTEXT', !anchorPoint.getAnchorMethod())
      !this.verticalLegFrom.select('DTEXT', !anchorPoint.getFromMethod())

      !this.verticalLegAnchorPoint.visible = true
      !this.verticalLegOffset.visible = true
      !this.verticalLegFrom.visible = true
      !this.verticalLegOf.visible = true
      !this.verticalLegPickElement.visible = true

      if (!anchorPoint.getFromElement().set()) then
        !this.verticalLegAnchorPoint.active = true
        !this.verticalLegFrom.active = true
      else
        !this.verticalLegAnchorPoint.active = false
        !this.verticalLegFrom.active = false
      endif
    endif
  endif

  !this.verticalLegAttributeFrame.visible = !show

endmethod
-- End of method .showVerticalLegAttributes

------------------------------------------------------------------------
--
-- Method:      showHorizontalLegAttributes
--
-- Description:
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .showHorizontalLegAttributes(!show is BOOLEAN)

  -- Setup the horizontal leg panel

  if (!show) then
    -- Display panel title
    !title = 'Branch leg ' & !this.pipeSlopePresenter.getCurrentLegIndex().string() & '   [Horizontal]'
    !this.horizontalLegAttributeFrame.tag = !title

    !branchLeg = !this.pipeSlopePresenter.getCurrentBranchLeg()

    -- Display angle and slope

    !canSlopeBranchLeg = !this.pipeSlopePresenter.canSlopeCurrentBranchLeg()
    !this.horizontalLegSlopeLeg.active = !canSlopeBranchLeg
    !this.horizontalLegSlopeLeg.val = !branchLeg.isFixedHorizontal().not()
    !enableAngleAndSlope = (!branchLeg.isFixedHorizontal() or (!branchLeg.isStartPositionFixed() and !branchLeg.isFinishPositionFixed()))
    !enableAngleAndSlope = !enableAngleAndSlope.not() and !canSlopeBranchLeg
    !this.horizontalLegSlope.active = !enableAngleAndSlope
    !this.horizontalLegSlopeDirection.active = !enableAngleAndSlope
    !this.horizontalLegAngle.active = !enableAngleAndSlope

    !angle = !this.pipeSlopePresenter.getCurrentBranchLegAngle()
    !this.horizontalLegAngle.val = !angle.abs()
    !this.horizontalLegSlope.val = !this.pipeSlopePresenter.getCurrentBranchLegSlope()

    -- Set slope direction
    if (!angle ge 0) then
      !this.horizontalLegSlopeDirection.select('DTEXT', 'Down')
    else
      !this.horizontalLegSlopeDirection.select('DTEXT', 'Up')
    endif

    -- Update the anchor number buttons
    if (!this.pipeSlopePresenter.getAnchorNumber() eq 1) then
      !this.horizontalLegFirstAnchor.val = true
      !searchText = 'Leg finish'
      !replaceText = 'Leg start'
    else
      !this.horizontalLegSecondAnchor.val = true
      !searchText = 'Leg start'
      !replaceText = 'Leg finish'
    endif

    -- Update the 'anchor type' gadget according to the active anchor number
    !this.horizontalLegAnchorType.active = !canSlopeBranchLeg
    !dtext = !this.horizontalLegAnchorType.dtext
    !index = !dtext.findFirst(!searchText)
    if (!index.set()) then
      !rtext = !this.horizontalLegAnchorType.rtext
      !dtext[!index] = !replaceText
      !this.horizontalLegAnchorType.dtext = !dtext
      !this.horizontalLegAnchorType.rtext = !rtext
    endif
    !anchorPoint =!this.pipeSlopePresenter.getCurrentAnchorPoint()
    !anchorType = !anchorPoint.getAnchorType()

    !this.horizontalLegAnchorType.select('RTEXT', !anchorType)

    -- Update and show/hide controls according to the anchor type
    !this.anchorInfo = object PIPESLOPEANCHORINFO()
    if (!anchorType eq !this.anchorInfo.typeNone or !anchorType eq !this.anchorInfo.typeEnd) then
      !this.horizontalLegDistance.visible = false
      !this.horizontalLegPickPosition.visible = false
      !this.horizontalLegComponent.visible = false
      !this.horizontalLegAnchorPoint.visible = false
      !this.horizontalLegOffset.visible = false
      !this.horizontalLegFrom.visible = false
      !this.horizontalLegOf.visible = false
      !this.horizontalLegPickElement.visible = false
    else
      if (!anchorType eq !this.anchorInfo.typeComponent) then
        !names = ARRAY()
        !componentIndices = ARRAY()
        !this.pipeSlopePresenter.getCurrentLegAnchorComponents(!names, !componentIndices)
        !this.horizontalLegComponent.dtext = !names
        !this.horizontalLegComponent.rtext = !componentIndices
        !anchorComponentName = !this.pipeSlopePresenter.getComponentName(!anchorPoint.getComponent().dbRef)
        !this.horizontalLegComponent.select('DTEXT', !anchorComponentName)
        handle (61, 567)
          -- Anchor component name not found - component is probably the branch
        endhandle
        !this.horizontalLegDistance.visible = false
        !this.horizontalLegPickPosition.visible = false
        !this.horizontalLegComponent.visible = true
      elseif (!anchorType eq !this.anchorInfo.typePosition) then
        !this.horizontalLegDistance.val = !anchorPoint.getDistance()
        !this.horizontalLegDistance.visible = true
        !this.horizontalLegPickPosition.visible = true
        !this.horizontalLegComponent.visible = false
      else
        return error 1 'Unknown anchor type'
      endif

      !this.horizontalLegOffset.val = -!anchorPoint.getOffset()
      !this.horizontalLegOf.val = !this.pipeSlopePresenter.getElementName(!anchorPoint.getFromElement())
      !this.horizontalLegAnchorPoint.select('DTEXT', !anchorPoint.getAnchorMethod())
      !this.horizontalLegFrom.select('DTEXT', !anchorPoint.getFromMethod())

      !this.horizontalLegAnchorPoint.visible = true
      !this.horizontalLegOffset.visible = true
      !this.horizontalLegFrom.visible = true
      !this.horizontalLegOf.visible = true
      !this.horizontalLegPickElement.visible = true

      if (!anchorPoint.getFromElement().set()) then
        !this.horizontalLegAnchorPoint.active = true
        !this.horizontalLegFrom.active = true
      else
        !this.horizontalLegAnchorPoint.active = false
        !this.horizontalLegFrom.active = false
      endif
    endif
  endif
  !this.horizontalLegAttributeFrame.visible = !show

endmethod
-- End of method .showHorizontalLegAttributes

------------------------------------------------------------------------
--
-- Method:      labelCurrentBranchLeg
--
-- Description: Add labels to the specified branch leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .labelCurrentBranchLeg()

  !currentBranchLeg = !this.pipeSlopePresenter.getCurrentBranchLeg()

  if (!currentBranchLeg.isLegValid()) then
    AID CLEAR TEXT $!<this.aidTextNumber>
    handle (41, 6)
      -- Ignore 'Non-existent element error' (no AID text to clear)
    endhandle

    !position = !currentBranchLeg.getStartPosition()

    -- This if statement protects against an error when the form is opened.
    -- Rearranging the code call sequence would make this unnecessary
    if (!position.set()) then
      AID TEXT NUMBER $!<this.aidTextNumber> 'Start' at $!position

      !position = !currentBranchLeg.getFinishPosition()
      AID TEXT NUMBER $!<this.aidTextNumber> 'Finish' at $!position
    endif
  endif
endmethod
-- End of method .labelCurrentBranchLeg

------------------------------------------------------------------------
--
-- Method:      updateBranchLegList
--
-- Description: Fills the branch leg list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .updateBranchLegList()

  !text = ARRAY()
  !index = 1

  -- Temporarily remove distance format label
  !label = !!distanceFmt.label
  !!distanceFmt.label = ''

  do !branchLeg values !this.pipeSlopePresenter.getBranchLegs()
    !row = ARRAY()
    !row.append(!index.string())

    !row.append(!this.pipeSlopePresenter.getComponentName(!branchLeg.getStartComponent().dbRef()))
    !row.append(!this.pipeSlopePresenter.getComponentName(!branchLeg.getFinishComponent().dbRef()))
    !row.append(!branchLeg.getAdjustedDrop().string(!!distanceFmt))
    if (!branchLeg.isLegVertical()) then
      !row.append(!branchLeg.getLength().string(!!distanceFmt))
    else
      !row.append(!branchLeg.getHorizontalLength().string(!!distanceFmt))
    endif

    !text.append(!row)
    !index = !index + 1
  enddo

  !this.branchLegList.setRows(!text)

  -- Restore distance format label
  !!distanceFmt.label = !label
endmethod
-- End of method .updateBranchLegList

------------------------------------------------------------------------
--
-- Method:      .quit
--
-- Description: Clean up routine called when the form is closed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .quit()

  !!aidNumbers.remove(!this.aidTextNumber)
  !!aidNumbers.remove(!this.aidValidLineNumber)
  !!aidNumbers.remove(!this.aidInvalidLineNumber)
  !!aidNumbers.remove(!this.aidArrowNumber)

  !this.hide()

  !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
  !drawlist.removeAll()
  !this.pipeSlopePresenter.quit()

endmethod
-- End of method .quit

------------------------------------------------------------------------
--
-- Method:      .kill
--
-- Description: Clean up routine called when the form is destroyed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .kill()

  !this.quit()

  !undoable = object UNDOABLE()
  !this.applyButton.setUndoable(!undoable)

  !!gphDrawlists.detachView(!this.localView)
  !!edgCntrl.removeView(!this.localView)
  !!gphDrawlists.deleteDrawlist(!this.drawlist)

endmethod
-- End of method .kill

------------------------------------------------------------------------
--
-- Method:      .onAngle
--
-- Description: Sets the slope angle
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onAngle()

  !this.pipeSlopePresenter.setAngle(!this.slopeAngle.val, !this.slopeDirection.selection() eq 'Up')

  -- Update slope immediately
  !this.displaySlope()
  !this.slopeAngle.refresh()
  -- Recalculate pipe
  !this.setCurrentPipe(!this.pipeSlopePresenter.getCurrentPipe())

endmethod
-- End of method .onAngle

------------------------------------------------------------------------
--
-- Method:      .onSlope
--
-- Description: Sets the slope value
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onSlope()

  !slope = !this.slopeVal.val.trim()
  !errorMessage = !this.pipeSlopePresenter.setSlope(!slope, !this.slopeDirection.selection() eq 'Up')

  -- Update slope before recalculating the pipe or display
  !this.displaySlope()
  !this.slopeAngle.refresh()

  if (!errorMessage.empty()) then
    !this.setCurrentPipe(!this.pipeSlopePresenter.getCurrentPipe())
  else
    !!alert.error(!errorMessage)
  endif

endmethod
-- End of method .onSlope

------------------------------------------------------------------------
--
-- Method:      displaySlope
--
-- Description: Updates the form's slope controls
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .displaySlope()

  !this.slopeVal.val = !this.pipeSlopePresenter.getSlopeAsString()

  if (!this.pipeSlopePresenter.isSlopeHorizontal()) then
    !this.slopeVal.tag = 'Nominal Slope'
  else
    !this.slopeVal.tag = 'Nominal slope         1 in:'
  endif

  !angle = !this.pipeSlopePresenter.getAngle()
  !this.slopeAngle.val = !angle.abs()

  if (!angle ge 0) then
    !this.slopeDirection.select('DTEXT', 'Down')
  else
    !this.slopeDirection.select('DTEXT', 'Up')
  endif

endmethod
-- End method .displaySlope


------------------------------------------------------------------------
--
-- Method:      .onApplyButton
--
-- Description: Called when the apply button is pressed. Applies changes to the pipe
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onApplyButton()

  !this.pipeSlopePresenter.applySlopes()
  !this.updateForm(false)

endmethod
-- End of method .onApplyButton

------------------------------------------------------------------------
--
-- Method:      .onBackButton
--
-- Description: Called when the back button is pressed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onBackButton()

  !this.pipeSlopePresenter.back()
  !this.updateForm(false)

endmethod
-- End of method .onBackButton

------------------------------------------------------------------------
--
-- Method:      .onForwardsButton
--
-- Description: Called when the forwards button is pressed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onForwardsButton()

  !this.pipeSlopePresenter.setForwardsMode(!this.forwards.val)
  !this.setCurrentPipe(!this.pipeSlopePresenter.getCurrentPipe())

endmethod
-- End of method .onForwardsButton

------------------------------------------------------------------------
--
-- Method:      .onSlopeDirection
--
-- Description: Called when the forwards button is pressed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onSlopeDirection()

  !angle =!this.pipeSlopePresenter.getAngle()
  !this.pipeSlopePresenter.setAngle(!angle, !this.slopeDirection.selection() eq 'Up')
  !this.setCurrentPipe(!this.pipeSlopePresenter.getCurrentPipe())

endmethod
-- End of method .onSlopeDirection

------------------------------------------------------------------------
--
-- Method:      .updateBranches
--
-- Description: Updates the whole pipe and the form when a branch leg is changed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .updateBranches()

  !this.pipeSlopePresenter.updateBranches()
  !this.updateBranchLegList()
  !this.updateAttributePanels()
  !this.branchLegList.select(1, !this.pipeSlopePresenter.getCurrentLegIndex().string())
  !this.drawBranches()
  !this.backButton.active = !this.pipeSlopePresenter.canGoBack()
  !!pipeSlopeMessageForm.update()

endmethod
-- End of method .updateBranches

------------------------------------------------------------------------
--
-- Method:      .updateForm
--
-- Description: Updates the entire form
-- Arguments:
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      BOOLEAN     Whether to reset the view drawlist and limits
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateForm(!resetView is BOOLEAN)

  !pipe = !this.pipeSlopePresenter.getCurrentPipe()

  if (!pipe.badref()) then
    -- There is no valid pipe so disable controls
    !this.currentPipeTag.val = 'Not set'
    !this.horizontalLegAttributeFrame.visible = false
    !this.verticalLegAttributeFrame.visible = false
    !this.branchLegList.clear()
    !this.displaySlope()
    !this.applyButton.active = false
  else
    !this.currentPipeTag.val = !this.pipeSlopePresenter.getCurrentPipeName()
    !this.forwards.val = !this.pipeSlopePresenter.getForwardsMode()

    !this.displayPipe(!this.pipeSlopePresenter.getCurrentPipe(), !resetView)
    !this.updateBranchLegList()
    !this.displaySlope()
    !currentLegIndex = !this.pipeSlopePresenter.getCurrentLegIndex()
    if (!currentLegIndex gt 0) then
      !this.branchLegList.select(1, !currentLegIndex.string())
    endif
    !this.onBranchLegSelected()
    !this.applyButton.active = !this.pipeSlopePresenter.canApply()
  endif

  !this.backButton.active = !this.pipeSlopePresenter.canGoBack()
  !this.showMessages.active = !!pipeSlopeMessages.messageCount().boolean()
  !!pipeSlopeMessageForm.update()

endmethod
-- End of method .updateForm

------------------------------------------------------------------------
--
-- Method:      .updateAttributePanels
--
-- Description: Updates the attribute panels
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .updateAttributePanels()

  !currentBranchLeg = !this.pipeSlopePresenter.getCurrentBranchLeg()
  !this.showVerticalLegAttributes(!currentBranchLeg.isLegValid() and !currentBranchLeg.isLegVertical())
  !this.showHorizontalLegAttributes(!currentBranchLeg.isLegValid() and !currentBranchLeg.isLegVertical().not())

endmethod
-- End of method .updateAttributePanels

------------------------------------------------------------------------
--
-- Method:      .onHorizontalLegSlopeLeg
--
-- Description: Called when the HorizontalLegSlopeLegToggle is pressed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onHorizontalLegSlopeLeg()

  !this.pipeSlopePresenter.setCurrentLegFixedHorizontal(!this.horizontalLegSlopeLeg.val.not())
  !this.updateBranches()

endmethod
-- End of method .onHorizontalLegSlopeLeg


------------------------------------------------------------------------
--
-- Method:      .setBranchLegAngle
--
-- Description: Changes the angle of a leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onSetBranchLegAngle()

  !this.pipeSlopePresenter.setCurrentBranchLegAngle(!this.horizontalLegAngle.val, !this.horizontalLegSlopeDirection.selection() eq 'Up')
  !this.updateBranches()

endmethod
-- End of method .onSetBranchLegAngle

------------------------------------------------------------------------
--
-- Method:      .onSetBranchLegSlope
--
-- Description: Changes the angle of a leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onSetBranchLegSlope()

  !slope = !this.horizontalLegSlope.val.trim()
  !errorMessage = !this.pipeSlopePresenter.setCurrentBranchLegSlope(!slope, !this.horizontalLegSlopeDirection.selection() eq 'Up')

  if (!errorMessage.empty()) then
    !this.updateBranches()
  else
    !!alert.error(!errorMessage)
  endif

endmethod
-- End of method .onSetBranchLegSlope

------------------------------------------------------------------------
--
-- Method:      .onAnchorType
--
-- Description: Called when a selection is made in an anchor type gadget
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      GADGET      The gadget in which the selection was made
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .onAnchorType(!anchorType is GADGET)
  !this.pipeSlopePresenter.setCurrentBranchLegAnchorType(!anchorType.selection())
  !this.updateBranches()
endmethod
-- End of method .onAnchorType

------------------------------------------------------------------------
--
-- Method:      .onLegComponent
--
-- Description: Called when a selection is made in an anchor component gadget
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      GADGET      The gadget in which the selection was made
-- Return:
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onLegComponent(!anchorComponent is GADGET)

  !componentIndex = !anchorComponent.selection('RTEXT').real()
  !this.pipeSlopePresenter.setCurrentBranchLegAnchorComponent(!componentIndex)
  !this.updateBranches()

endmethod
-- End of method .onLegComponent

------------------------------------------------------------------------
--
-- Method:      .onAnchorButton
--
-- Description: Called when one of the anchor buttons is pressed
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Number of the pressed button
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .onAnchorButton(!buttonNumber is REAL)

  !this.pipeSlopePresenter.setAnchorNumber(!buttonNumber)
  !this.updateAttributePanels()
  !this.drawBranches()

endmethod
-- End of method .onAnchorButton


------------------------------------------------------------------------
--
-- Method:      .onPickElement
--
-- Description:  Called when the pick element button is pressed. Sets up EDG
--               to pick an element graphically
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .onPickElement()

  !packet = object EDGPACKET()
  !packet.elementPick(|Pick an element|)

  -- Apply the action to the pick event
  !packet.action = |!!pipeSlopeForm.processPickElement(!this.return[1])|
  !packet.description = |Pipe slope element pick|
  !packet.escape = |!!pipeSlopeForm.processEscape()|
  !!edgCntrl.add(!packet)
  !this.allowTracking = false
  !this.setActive(false)

endmethod
-- End of method .onPickElement

------------------------------------------------------------------------
--
-- Method:      .onPickPosition
--
-- Description:  Called when the pick position button is pressed. Sets up EDG
--               to graphically pick a position along a branch
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onPickPosition()

  !packet = object EDGPACKET()
  !packet.definePosition(|Pick position along branch leg|)

  -- Apply the action to the pick event
  !packet.action = |!!pipeSlopeForm.processPickPosition(!this.return[1])|
  !packet.description = |Pipe slope position pick|

  !packet.escape = |!!pipeSlopeForm.processEscape()|
  !packet.pickPacket.picks[1].positionLinear(||)
  !!edgCntrl.add(!packet)
  !this.allowTracking = false
  !this.setActive(false)

endmethod
-- End of method .onPickPosition

------------------------------------------------------------------------
--
-- Method:      .processPickPosition
--
-- Description: EDG callback used when an element is picked
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]       [Description]
--  1   R      EDGPOSITIONDATA   Information on the EDG pick
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .processPickPosition(!data is EDGPOSITIONDATA)

  -- Create line along branch leg
  !branchLeg = !this.pipeSlopePresenter.getCurrentBranchLeg()
  !line = object LINE(!branchLeg.getStartPosition(), !branchLeg.getFinishPosition())

  -- Check if picked position can be projected onto the line
  if (!line.onProjected(!data.position)) then
    !nearestPosition = !line.near(!data.position)
    !distance = !branchLeg.getStartPosition().distance(!nearestPosition)
    !this.horizontalLegDistance.val = !distance

    !!edgCntrl.remove(|Pipe slope position pick|)
    !this.allowTracking = true
    !this.setActive(true)
    !this.onLegDistance()
  endif

endmethod
-- End of method .processPickPosition(!data is EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      .processPickElement
--
-- Description: EDG callback used when an element is picked
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]   [Description]
--  1   R      EDGPICKDATA   Information on the element picked
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .processPickElement(!data is EDGPICKDATA)

  !this.pipeSlopePresenter.setCurrentBranchLegAnchorFromElement(!data.item)
  !name = !this.pipeSlopePresenter.getComponentName(!data.item)
  !this.horizontalLegOf.val = !name
  !!edgCntrl.remove(|Pipe slope element pick|)
  !this.allowTracking = true
  !this.setActive(true)
  !this.updateBranches()

endmethod
-- End of method .processPickElement

------------------------------------------------------------------------
--
-- Method:      .processEscape
--
-- Description: EDG escape handler
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .processEscape()

  !this.allowTracking = true
  !this.setActive(true)
  !!edgCntrl.remove(|Pipe slope element pick|)
  !!edgCntrl.remove(|Pipe slope position pick|)

endmethod
-- End of method .processEscape

------------------------------------------------------------------------
--
-- Method:      .onLegDistance
--
-- Description: Handles changes to the leg distance field
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .onLegDistance()

  !this.pipeSlopePresenter.setCurrentBranchLegAnchorDistance(!this.horizontalLegDistance.val)
  !this.updateBranches()

endmethod
-- End of method .onLegDistance

------------------------------------------------------------------------
--
-- Method:      .onLegOffset
--
-- Description: Called when then leg offset is changed
-- Arguments:
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      GADGET      The gadget in which the selection was made
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .onLegOffset(!legOffset is GADGET)

  !this.pipeSlopePresenter.setCurrentBranchLegAnchorOffset(-!legOffset.val)
  !this.updateBranches()

endmethod
-- End of method .onLegOffset

------------------------------------------------------------------------
--
-- Method:      .onLegAnchorPoint
--
-- Description: Called when an anchor point radio button is pressed
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      GADGET      The anchor point radio button
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .onLegAnchorPoint(!anchorPoint is GADGET)

  !this.pipeSlopePresenter.setCurrentBranchLegAnchorPoint(!anchorPoint.selection())
  !this.updateBranches()

endmethod
-- End of method .onLegAnchorPoint

------------------------------------------------------------------------
--
-- Method:      .onLegFrom
--
-- Description: Handles changes to the anchor from option box
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      GADGET      The gadget in which the selection was made
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .onLegFrom(!anchorFrom is GADGET)

  !this.pipeSlopePresenter.setCurrentBranchLegAnchorFromMethod(!anchorFrom.selection())
  !this.updateBranches()

endmethod
-- End of method .onLegFrom

------------------------------------------------------------------------
--
-- Method:      .applyUndo
--
-- Description: Handles undo - simply recalculates the pipe
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .applyUndo()

 if (!this.shown()) then
    !pipe = !this.pipeSlopePresenter.getCurrentPipe()
    !this.setCurrentPipe(!pipe)
 endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .applyRedo
--
-- Description: Handles redo - simply recalculates the pipe
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .applyRedo()

  if (!this.shown()) then
    !pipe = !this.pipeSlopePresenter.getCurrentPipe()
    !this.setCurrentPipe(!pipe)
  endif

endmethod
