-- Last Modified:
-- Description:
-- Form to display errors and messages from the pipeSlopeMessage object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   Empty the list and also the global message list
--  pipeSlopeMessageForm()           -                   Constructor
--  update()                         -                   Updates the this
--

------------------------------------------------------------------------
--
------------------------------------------------------------------------


setup form !!pipeSlopeMessageForm dialog resizable noalign

  list .listBox multiple width 60 height 20
  path down
  button .dismiss  'Dismiss' at xmax.listBox - size callback |!this.hide()|
  path left
  button .clear 'Clear' callback |!this.clear()|

exit
--End of form definition

------------------------------------------------------------------------
--
-- Method:   pipeSlopeMessageForm
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .pipeSlopeMessageForm()

  -- Form and icon titles
  !this.iconTitle              = 'Slope Pipe Messages'
  !this.formTitle              = 'Slope Pipe Messages'
  !this.autoScroll             = TRUE

  -- Ensure the message object exists
  if (undefined(!!pipeSlopeMessages)) then
    !!pipeSlopeMessages = object PIPESLOPEMESSAGES()
  endif

  -- Set form headings
  !headings = ARRAY()
  !headings.append(' Type')
  !headings.append('Message')
  !this.listBox.setHeadings(!headings)

endmethod
-- End of method .pipeSlopeMessageForm

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Empty the list and also the global message list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clear()
  !!pipeSlopeMessages.clear()
  !this.update()
endmethod
-- End of method .clear

------------------------------------------------------------------------
--
-- Method:      .update
--
-- Description: Updates the this
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .update()

  !messages = ARRAY()
  !!pipeSlopeMessages.getMessages(!messages)
  !this.listBox.setRows(!messages)

endmethod
-- End of method .update
