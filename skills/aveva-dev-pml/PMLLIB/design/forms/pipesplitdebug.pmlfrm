--
-- Description:
-- Pipe, Branch and Pipe component splitting debug form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  enhance(GADGET,STRING)           -
--  initialise()                     -
--  tidy()                           -
--

setup form !!pipesplitdebug dialog dock right

  !this.iconTitle       = |Pipe Splitting|
  !this.formTitle       = |Split Pipe debug|
  !this.formRevision    = |$Revision: 0.0 $ |
  !this.initcall        = |!this.initialise()|
  !this.quitcall        = |!this.tidy()|


  -- Selected Element list
  list .elemlist 'Split values '  anchor left+right+top+bottom  at xmin tooltip 'Pipes in this listed will be split' callback |!this.enhance(| columns multiple width 100 height 15

  member .positions  is ARRAY
  member .buildlist  is ARRAY


exit

------------------------------------------------------------------------
define method .initialise()

!rows = ARRAY()
!heading = ARRAY()
!heading.append('Insert item')
!heading.append('3-D Position')
!heading.append('Start End inc min tube')
!heading.append('Start End relative')
!heading.append('Origin Distance')
!heading.append('Secondary Distance')
!heading.append('Something')



do !a index !this.positions
  !column = ARRAY()
  !column.append(!this.buildlist[!a][1].string())
  !column.append(!this.buildlist[!a][2].string())
  !column.append(!this.positions[!a][1].string().split()[6] & ' ' & !this.positions[!a][1].string().split()[15] )
  !column.append(!this.positions[!a][2].string().split()[6] & ' ' & !this.positions[!a][1].string().split()[15] )
  !column.append(!this.positions[!a][3].string())
  !column.append(!this.positions[!a][4].string())
  --!column.append(!this.positions[!a][5].string())
  !column.append(!this.positions[!a][6].string())
  --!column.append(!this.positions[!a][7].string())
  !rows.append(!column)
enddo

!this.elemlist.setrows(!rows)

!this.elemlist.setheadings(!heading)
!this.elemlist.setrows(!rows)

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .tidy()


do !a values !this.elemlist.val
   !aidnumber = '2222' & !a
   AID CLEAR SPHERE $!aidnumber
   AID CLEAR TEXT   $!aidnumber !a
enddo

!this.elemlist.clearselection()
--!this.hide()


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .enhance(!gadget is GADGET, !selected is STRING)

if !selected.eq('STOP') then
  return
endif
!number  = !gadget.pickedfield
!boreelement = !this.buildlist[!number][1]
!aidnumber     = '2222' & !number
!spheredia   =  !boreelement.lbore.real().distance().real() + 100mm
!position    = !this.positions[!number][7].string()

if !selected.eq('SELECT') then
  --enhance something
    !number  = !gadget.pickedfield
    !boreelement = !this.buildlist[!number][1]
    --!element = !this.buildlist[!number][1].string().replace('/','') & !number
      !spheredia   =  !boreelement.lbore.real().distance().real() + 100mm
      AID SPHERE NUM $!aidnumber $!position DIA $!spheredia
      AID TEXT NUM $!aidnumber '<split>' AT $!position
elseif !selected.eq('UNSELECT') then
  --unenhance something
      AID CLEAR SPHERE $!aidnumber
      AID CLEAR TEXT   $!aidnumber
endif

endmethod
------------------------------------------------------------------------
