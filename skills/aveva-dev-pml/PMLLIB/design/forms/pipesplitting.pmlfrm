------------------------------------------------------------------------
-- method to joint two branches together and form one branch
define method .joinBranch(!branch1 is DBREF , !branch2 is DBREF )

-- not yet implemented
!!alert.error(' not implemented')
return
-- find the nearest ends of branch1 and branch 2
!head1 = !branch1.hpos
!tail1 = !branch1.tpos
!head2 = !branch2.hpos
!tail2 = !branch2.tpos
if !head1.distance(!tail1).lt(2) then
   connect head to tail
elseif !head2.distance(!tail2).lt(2) then
   connect the other way
else
   --do something else
endif

-- now we need to go and get all of the tee positions in case the branches are connected by tee

endmethod
