-- Define method
define method .joinPipe( )


  var !a pick branch
  var !b pick branch
  !bran1 = !a[1].dbref()
  !bran2 = !b[1].dbref()

  if !bran1.order.gt(!bran2.order) then
     !!ce = !bran2
     !target = !bran1
  else
     !!ce = !bran1
     !target = !bran2
  endif

endmethod
