--
-- Description:
-- Pipe, Branch and Pipe component splitting form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addIdPipes(DBREF,STRING)         -                   -
--  checkPick(EDGPICKDATA,REAL)      -                   checks whether or not the user wants to pick the branch head or tail to split between
--  clearList()                      -                   Remove and unenhance all elements in the list. Clear aids if any
--  coordinateSettings()             -                   Setting the format of positional gadgets according to present coordinate system.
--  copyPlane()                      -
--  createPlane()                    -
--  displayAssembly()                -                   Sets component attributes to from specification
--  drawPlane(BOOLEAN)               -
--  enhance()                        -                   to clean up graphical aids on dismiss
--  fillPlane()                      -                   Called when the fill radial button is pressed. Decides
--  filterComponents()               -                   Filter components using current filter settings
--  filterSubType()                  -                   Select Stype for Components
--  findBuildOrigin(POSITION,DBREF)  REAL                -
--  getBranchElement(DBREF)          DBREF               get branch element
--  getPositionControlPos(ARRAY)     POSITION            returns the position in appropriate unit from POSITIONCONTROL gadget
--  idPipes(STRING)                  -
--  initialise()                     -                   Initialisation
--  insertAssembly(REAL)             -
--  insertSplitAssembly(DBREF,POSITION) -
--  isItConnected()                  ARRAY
--  joinBranch(DBREF,DBREF)          -
--  joinPipe()                       -
--  limits(DBREF)                    -
--  loadComponents()                 -
--  markSplitPoint(DBREF,POSITION)   -
--  measure()                        -
--  merge(EDGPICKDATA,EDGPICKDATA)   -                   merge elements on pipe / branch level
--  mergeTwoBranches(DBREF,DBREF)    -                   merges !sourceBran into !targetBran
--  modifyPlane()                    -
--  modifyPlaneDirection(STRING)     -
--  modifyPlanePosition()            -                   This method sets the plane position from the position control
--  moveComponents()                 -
--  movePlane(STRING,REAL)           -
--  pickElement()                    -
--  pickSecondElementForMerge()      -                   checks whether or not the user wants to pick the branch head or tail to split between
--  pipeSplitting()                  -                   Constructor
--  planeSplit(DBREF)                -
--  positionPlane()                  -                   this method takes out the plane definition picks from the
--  processBranches()                -
--  processList(ARRAY)               ARRAY
--  refreshElementSplitList()        -
--  removeElement()                  -
--  selectChoice()                   -                   Select the current choice and setup other gadgets
--  setOri(REAL)                     -                   sets the assembly build origin
--  setPlaneDir ()                   -
--  setPlanePosition(EDGPOSITIONDATA) -
--  setSegSplitGadgets(BOOLEAN)      -                   sets up the split gadgets for feature/segment splitting
--  setVisibility(STRING)            -
--  setup()                          -
--  showAssembly()                   -                   first shown method
--  showSplitPoint(DBREF)            -
--  splitOptionGadgets(STRING)       -
--  splitPipe(DBREF,STRING,REAL)     -                   Splits the Pipe/Branch passed - DDC
--  splitPipe(STRING)                -                   Split Pipe based on the options selected
--  splitSegment()                   -
--  tag(DBREF)                       -                   display graphical aids for flow direction
--  tagRefresh()                     -                   called when aid is pressed. calls tag()
--  tidy(STRING)                     -                   to clean up graphical aids on dismiss
--  tidyPlanes()                     -
--

------------------------------------------------------------------------
  --Import DLL
  import 'PositionControl'
  handle ANY
  endhandle

setup form !!pipeSplitting dialog dock right

  !this.iconTitle       = |Pipe Splitting|
  !this.formTitle       = |Split Pipe|
  !this.formRevision    = |$Revision: 0.0 $ |
  !this.initcall        = |!this.initialise()|
  !this.quitcall      = |!this.tidy('dismiss')|
  !this.firstshowncall  = |!this.showAssembly()|

  frame .mainFrame tabset anchor all at x0 y0 width 40 height 2
    frame .split anchor all 'Split / Merge' at x0 ymax width 40
      -- Split options
      frame .splitOptions panel 'Split Pipe Options'    anchor left+right+top   at x1 ymin width 38
--        para .paraPipeSplit                                    at xmin     ymin0.5      text 'Split Options'
--        line .linePipeSplit                                    at xmin     ymax0.1   horizontal width 38
--
--        halign left
--        path down  vdist 0

        rToggle .planeSplit     'Split Pipes on a Plane'  at x1 ymax tooltip 'Assembly will be inserted'     callback |!this.splitOptionGadgets('PLANE')|
        rToggle .segment        'Split Pipes into Segments' at xmin ymax tooltip 'Split pipes into segments' at xmin.planeSplit   callback |!this.setSegSplitGadgets(TRUE)|
        option  .segmentopt     'Split By' tagwidth 6 at xmin ymax tooltip 'Type of Segment Split by Option' at xmin.planeSplit + 2     callback |!this.setSegSplitGadgets(TRUE)| widt 20
        !a[1] =  'Component picks'
        !a[2] =  'Feature pick'
        !b[1] = 'COMP'
        !b[2] = 'FEAT'
      !this.segmentopt.dtext = !a
      !this.segmentopt.rtext = !b

        rToggle .moveComponents 'Split pipe by moving Component'  at xmin ymax tooltip 'Assembly will not be inserted' at xmin.planeSplit callback |!this.splitOptionGadgets('MOVECOMP')|
        rToggle .mergeComponents 'Merge branch / pipe '  at xmin ymax  tooltip 'Assembly will not be inserted' at xmin.planeSplit callback |!this.splitOptionGadgets('MERGE')|

      exit

      -- Components after split to be moved/not moved to a new Branch/Pipe.
      -- Select 'Existing' for no move.
      frame .moveComp   'Move down-stream components to '  anchor left+right+top at xmin1 ymax width 37   height 1.5
        rtoggle .noMove    tagwidth 8 'Existing'  at xmin+1 ymin1
        rToggle .newpipe   tagwidth 8 'New Pipe'  at xmax1  ymin
        rToggle .newbran   tagwidth 8 'New Bran'  at xmax1  ymin
      exit

      frame .frmPerformCommands panel anchor left+right+top   at x1 ymax0.5 width 38
        para .paraPerformCommands                             at xmin     ymin      text 'Perform Commands'
        line .linePerformCommands                                    at xmin     ymax0.1   horizontal width 38

        button .applySplit  'Split'       anchor left+Top       at x1     ymax0.3   callback |!this.splitPipe(!this.splitOption)| width 5
        button .idSplit     'ID Split'    anchor left+top       at xmax1  ymin      callback '!this.idPipes(|PLANE|)' width 6
        button .tagRefresh  'Flow'        anchor left+Top     at xmax1  ymin      tooltip 'Show the current element flow direction'  callback |!this.tagRefresh()| width 6
        button .undoSplit   'Undo'        anchor right+top      at xmax1  ymin      callback |!this.tidy('undo')| width 6
        button .dismiss     'Dismiss'     anchor right+top      at xmax1  ymin      callback |!this.tidy('dismiss')| width 6  CANCEL
      exit

      frame .frmDetailOptions panel                    anchor left+right+top   at x1 ymax width 38
        para .paraDetailOptions                                    at xmin     ymax   text 'Detail Options'
        line .lineDetailOptions                                    at xmin     ymax0.1   horizontal width 38

        frame .elementList panel                    anchor left+right+top   at xmin ymin.frmDetailOptions+1.5 width 38
          -- Selected Element list
          list .elemList 'Branches to Split '   anchor left+right+top   at xmin1 tooltip 'Pipes in this listed will be split' callback |!this.enhance()| columns multiple width 36 height 5

          -- Add button to Append elements to the list
          button .addCe   'Add Ce'            anchor left+top at xmin ymax0.3   callback '!this.setup(|CE|)'     width 6
          button .load    'Add Selected'      anchor left+top at xmax0.5 ymin     callback '!this.setup(|GRAPHICAL|)'     width 10
          button .id      'ID Selection'      anchor left+top at xmax0.5 ymin     callback '!this.idPipes(|SELECT|)'     width 9
          button .clear   'Clear all'         anchor left+top at xmax0.5 ymin     callback '!this.clearList()' width 6
        exit

        -- Cutting plane definition frame
        frame .planeDef 'Plane definition '  anchor left+right+top   at xmin1  ymax0.3  width 38

         -- Allows the user to view the plane created in the graphical canvas before he goes to split action.
          button .placePlane  'Define Plane'  linklabel at x1 ymax  callback '!this.positionPlane()' width 8
          para .nudge at xmax+4 ymin text 'Nudge'
          !pixmap = !!pml.getPathName('leftarrow16.png')
          button .nudgeLeft at xmax ymin pixmap "$!<pixmap>" width 16 height 16  call |!this.movePlane('L',!this.splitDist.val )|
          text .splitDist       at xmax ymin  callback || width 8 is REAL format !!distanceFmt
          !pixmap = !!pml.getPathName('rightarrow16.png')
          button .nudgeRight at xmax ymin pixmap "$!<pixmap>" width 16 height 16 call |!this.movePlane('R',!this.splitDist.val)|
          frame .planePositionControl panel |Plane Position|   anchor left + right + top at x0 ymax+0.2 width 34 hei 5
             container .netPositionFrame PMLNetCONTROL 'NET'  at x1 dock fill
             vdist 0
             text .planeDirection at xmin y4  'Plane Direction' tagwid 10 call '!this.modifyPlaneDirection(!this.planeDirection.val)'width 16 is STRING
          exit
          text .planeSize |Plane Size|      at xmin1 ymax+0.3 tagwid 8 callback |!this.modifyPlane()| width 8 is REAL format !!distanceFmt
          -- Plane fill
          toggle .pfill tagwid 4 | Fill| at xmax +3 ymin callback |!this.fillPlane()| states |off| |on|
          toggle .pShow tagwid 4 |on/off| at xmax  ymin callback |!this.drawPlane(!this.pShow.val)| states |off| |on|
        exit

        -- Define length between split points in straight segments (single leg)
        frame .splitLength  'Split Pipe Length' anchor left+right+top   at Xmin.moveComp  ymin.frmDetailOptions+2 width 38

          vdist 0
          -- Straight pipes split length option
          option .lengthOption at xmin.splitLength+1  width 15
          path right
          text .length at xmax+6 width 8 is REAL format !!distanceFmt

          -- Minimum final straight tube length
          para .minlenpara at xmin.lengthOption ymax+0.2 text 'Minimum Final Tube Length'
          text .minTubeLen at xmin.length width 8 is REAL format !!distanceFmt

        exit
      exit


    exit


  frame .assemblyFrame 'Assembly' anchor t+l+r at x0 y0 width 40
  -- assemblies
  option .assemblyTypes 'Filter Assemblies By' tagwid 15 anchor left + top at x0 ymax callback '!this.filterSubType()'        tooltip 'Available sub-types for component' width 16
  list .assemblyList       anchor top+left+right  at xmin ymax+0.1 tooltip 'Select an assembly from the list' callback '!this.selectChoice()' single columns width 36 height 6

      ------------------ View Data For assemblies
    frame .vFrame panel anchor top+left+right at xmin ymax.assemblyList width 38.5
      --valign bottom
    view .localView  at x0   ymax GIvol

        -- Input Modes
        -- Navigate
        inmode create _navi       type |DES_NAVIGATE|
        -- Standard Element Pick
        inmode create _pick       type |DES_PICK|
        -- Pick Any (Element, pPoint, Pline)
        inmode create _pAny       type |DES_PICK_ANY|
        -- Plines
        inmode create _pline      type |DES_PICK_PLINE|
        -- pPoints
        inmode create _point      type |DES_PICK_POINT|
        -- Screen Position
        inmode create _screen     type |DES_3D_LINE|
        -- Laser Model rays
        inmode create _pickxgeom  type |DES_PICK_XGEOM|
        -- Default (Navigation)
        inmode create _pickDetail type |DES_PICK_DETAIL|
        -- Default (Navigation)
        inmode create _default    type |DES_NAVIGATE|

      height 9 width 37
      exit
    exit

    -- build origin
    frame .buildOriFrame 'Assembly build origin'  anchor left+right+top at xmin ymax width 38

      vdist 0
      hdist 0
      halign left
      option .buildOri callback |!this.setOri(!this.buildOri.val)| width 20
     !a[1] = 'Build to primary origin'
     !a[2] = 'Build to secondary origin'
     !this.buildOri.dtext = !a

    exit
  exit
 exit

  -- Form Members
  -- Option Task for Split Pipe
  member .splitOption           is STRING
  member .splitPick             is STRING

  -- Stores the list elements
  member .elements              is ARRAY

  -- Current Active Branch
  member .branch                is DBREF
  member .component             is DBREF
  member .componentPosition     is POSITION

  -- Created Components
  member .newComponent          is DBREF
  member .newComponents         is ARRAY

  -- Multi choice (bucket for holding items created with their multiple choices)
  member .multipleSelect        is ARRAY
  member .positionData          is EDGPOSITIONDATA

  -- Next and Previous Components
  member .next                  is DBREF
  member .previous              is DBREF

  member .posi                  is POSITION

  member .plane                 is PLANE

  -- branch selections for segment split
  member .branchPick            is ARRAY

  member .assemblies            is PIPINGASSEMBLYMGR
  member .assembly              is PIPEASSEMBLY
  member .assblyori             is REAL


  -- add a drawList for the local view
  member .drawList              is DRAWLIST

  -- tag identifier
  member .tagId                 is REAL
  member .planeTagId            is REAL
  member .splitSphere           is REAL
  member .ceTag                 is REAL

  -- UNDOABLE OBJECT
  member .undoObject            is UNDOABLE

  --Flag to say if a plane has been derived.
  member .planeDerived          is BOOLEAN

  member .pickedPosData        is EDGPOSITIONDATA

  member .noAssemblies         is BOOLEAN
  using namespace 'Aveva.Pdms.Presentation'
  member .posControl is POSITIONCONTROL


  -- Register form
  !!appFormCntrl.registerForm(!this)

exit

-- End of form definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- !this.killingCall     = |!this.tidy('dismiss')|
  !this.planeDef.visible     =   TRUE
  !this.splitLength.visible  =   FALSE
  !this.assemblyList.visible =   TRUE
  !this.pfill.val            =   TRUE
  !this.splitPick            =   'COMP'
  !this.splitOptions.val     =   1
  !this.moveComp.val         =   1
  !this.assblyori            =   1
  !this.buildOri.val         =   1
  !this.noMove.active        =   TRUE
  !this.applySplit.active    =   TRUE


  !this.splitOption          =   'PLANE'
  if !!isImperialLength('DIST') then
     !this.planeSize.val        =   40in
     !this.length.val           =   0in
     !this.splitDist.val        =   4in
     !this.minTubeLen.val       =   4in
  else
     !this.planeSize.val        =   1000mm
     !this.length.val           =   0mm
     !this.splitDist.val        =   100mm
     !this.minTubeLen.val       =   100mm
  endif

  !this.plane = object PLANE()
  !this.plane.position  = n0
  !this.plane.orientation = z is n wrt /*

  !this.copyPlane()
  !this.planeDerived         =   FALSE

  -- reset the assembly list every time the form is shown
  !this.assemblies = object PIPINGASSEMBLYMGR(TRUE)

  !this.noAssemblies = FALSE

  -- handle the problem of no assemblies being present
  if !this.assemblies.assemblies.size().eq(0) then
     !this.noAssemblies = TRUE
  endif

  -- set the form defaults
  !this.setSegSplitGadgets(FALSE)

  if !this.noAssemblies.not() then
  -- go and get some pipe assemblies
    !this.loadComponents()
    !this.selectChoice()
    --!this.displayAssembly()
  endif

  -- set up the undoable object
  !this.undoObject = object UNDOABLE()
  !this.undoObject.description('PIPESPLITTING UNDO')

  -- fixed for P-16555:  Pipe Splitting Form
  if !this.noAssemblies then
    !this.moveComponents.val = TRUE
	  !this.splitOptionGadgets('MOVECOMP')
    !this.assemblyFrame.active = F
    !this.localView.visible = FALSE

    !this.assemblyList.clear()
    !this.assemblyTypes.clear()
    !this.buildOri.val = 1

    !this.planeSplit.active = FALSE
    !this.segment.active = FALSE
    !this.segmentopt.active = FALSE
    !this.buildOri.active = FALSE
  else
    !this.assemblyList.select('dtext', !this.assemblies.assemblies[1].description)
  endif

 -- clear the Branch list
  !this.clearList()

  !this.coordinateSettings()

if !this.noAssemblies then
	!this.moveComponents.val = TRUE
	!this.splitOptionGadgets('MOVECOMP')
else
  !this.splitOptionGadgets('PLANE')
endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      showAssembly
--
-- Description: first shown method
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAssembly()
  if !this.assemblies.assemblies.size().neq(0) then
    !this.displayAssembly()
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      pipeSplitting
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeSplitting()


 -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.posControl        = object POSITIONCONTROL()
  !this.coordinateSettings()
  -- Load ship grid data
  !grid                   = object SHIPGRID()
  !gridDefined            = !grid.position.set()
  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.posControl.xyz(0, 0, 0)

    !this.posControl.gridvisible(TRUE)
    -- Set position column heading
    !this.posControl.heading('World Position')
  else
    !this.posControl.enuFormat()
  endif

  --!this.posControl.gridFormat()
  !this.netPositionFrame.control = !this.posControl.handle()
  !this.posControl.changeAction('!!pipeSplitting.modifyPlanePosition()')


  -- Visibility settings
  !this.planeDef.visible       =   false
  !this.splitLength.visible    =   false
  !this.assemblyList.visible        =   false

  -- Set the headings for element list
  !headings[1]    =   'Owner'
  !headings[2]    =   'Name'
  !this.elemList.setHeadings(!headings)

  -- Initialise Assembly list
  !assemblyObj = object PIPINGASSEMBLYMGR(true)
  !assemblies = !assemblyObj.assemblies

  -- loop through the assemblies list and get data to put into the form list gadget
  !linesArray = object ARRAY()
  !rtextArray = object ARRAY()

  do !i from 1 to !assemblies.size()
    !lineText = object ARRAY()
    !lineText.append(!assemblies[!i].appldata.namn)
    !lineText.append(!assemblies[!i].appldata.description)
    !linesArray.append(!lineText)
    !rtextArray.append(!assemblies[!i].appldata.name.dbref().string())
  enddo

  !headings = object ARRAY()
  --!headings.append('Assembly')
  !headings.append('Description')
  !this.assemblyList.setHeadings(!headings)
  !this.assemblyList.setrows(!linesArray)
  !this.assemblyList.rtext = !rtextArray

  -- Initialisation for Plane Definition
  if (!!isImperialLength('DIST')) then
      !this.planeSize.val =  4inch
  else
      !this.planeSize.val =  1000mm
  endif

  -- Selected Element list
  -- Pop up Menu for the list
  !menu   =   !this.newMenu('displayOptions')
  !menu.add('callback','Remove from list','!this.removeElement()')
  !this.elemList.setPopup(!menu)


  -- Initialise Option list for Split length DTEXT
  !lengthOption[1] = 'Segment Length '
  !lengthOption[2] = 'Cut-pipe Length'
  !this.lengthOption.dtext = !lengthOption

  -- Initialise Option list for Split length RTEXT
  !lengthOptionRtext[1] = 'SEGLEN'
  !lengthOptionRtext[2] = 'CUTLEN'
  !this.lengthOption.rtext = !lengthOptionRtext

  -- Default value for the Min Tube Length
  !this.minTubeLen.val  = 100mm

  -- Aid graphic numbers
  !this.tagId            = !!aidNumbers.add('splitFlowTag')
  !this.planeTagId       = !!aidNumbers.add('splitPlaneTag')
  !this.splitSphere      = !!aidNumbers.add('splitSphereTag')
  !this.ceTag            = !!aidNumbers.add('FlowArrowTag')

endmethod
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!mode IS STRING)

  if !mode.eq('GRAPHICAL') then

    -- Get elements
    !selection        = object SELECTION()
    !selection.getCurrent()
    !elements         = !selection.getSelection()

    -- If Selection is empty
    if(!elements.empty()) then
       !!alert.error('No items to add. Please Pick/Window select items in the view and retry.')
       return
    endif

    !this.elements.appendarray(!this.processList(!elements))

  elseif !mode.eq('CE') then
   -- add the ce branch members to the split list
    --P-4897 : Fix allows all branches of a pipe to be added by press Add CE when on Pipe.
    if (!!ce.type.eq('PIPE')) then
      do !a from 1 to !!ce.mCount
        if !!ce.members[!a].type.neq('BRAN') then
          skip
        else
          !list[!a] = !!ce.members[!a]
        endif
      enddo
    else
      !list[1] = !!ce
    endif
   -- End fix

       -- P-4896
     if !this.processList(!list).size().eq(0) then
        !!alert.error('Not at a Branch')
        return
     else
       !this.elements.appendarray(!this.processList(!list))
     endif
   -- End fix
  else
    -- we are in id pipe mode
    if (defined(!!pickedElement)) then
      if !!pickedElement.unset() then
        return
      endif
    else
      return
    endif

    !!pickedElement
    !this.elements.appendarray(!this.processList(!!pickedElement))

  endif

  !this.elements.unique()

  -- P-4896
  if !this.elements.size().eq(0) then
     !!alert.error('Not at a Branch')
     return
  endif

  !dispText[1]        = ARRAY()
  !dispText[2]        = ARRAY()

  do !i indices !this.elements
     !dispText[1].append(!this.elements[!i].owner.namn)
     !dispText[2].append(!this.elements[!i].namn)
     ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
  enddo

  !this.elemList.setcolumns(!dispText)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      processList
--
-- Description: gets a list of branches from collection or id
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   elements list
------------------------------------------------------------------------

define method .processList(!objects is ARRAY )is ARRAY

!specs = object SPECIFICATIONS('PIPE')
!return = ARRAY()

do !a values !objects
   if   !a.owner.unset() then

     !blankArray = ARRAY()
     return !blankArray

   elseif !specs.isItAPipe(!a) then

    if  !a.owner.type.eq('BRAN') then
        !return.append(!a.owner)
    else
        !return.append(!a)
    endif

   endif
enddo

return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      createPlane
--
-- Description: Create the cutting plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPlane()

 if !this.plane.unset() then
   return
 else
   !this.drawPlane(TRUE)
 endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      createPlane
--
-- Description: Create the cutting plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPlane()

    if !this.positionData.plane.unset() then
       !this.positionData.plane()
       -- if the plane was unset prior to this then it probably has the wrong direction
       -- to get the direction we need to work out which plane direction is nearest to the point vector direction
       !this.setPlaneDir ()
    else
       !this.plane = !this.positionData.plane
    endif

    !planeDrn     =   !this.plane.orientation.zDir()
    if(!this.splitDist.val.unset())then
       !offsetDist  =   0
    else
-- This form method does not exist anymore and is not needed.
-- Removed from if loop
     -- if(!this.splitPoint.val eq 1)then
       --!offsetDist     =    !this.splitDist.val.real()
     --else
       !offsetDist     =   -1 * !this.splitDist.val.real()
     --endif
    endif
      !originPos  =   !this.positionData.position
      !planePos   =   !originPos.offset(!planeDrn,!offsetDist)
      !planeOri   =   z is $!planeDrn

      -- Define the cutting plane
      !this.plane      =   object PLANE(!planePos,!planeOri)

   !psize      =   !this.planeSize.val.real()

   if(!psize.unset())then
      !psize   =   1000mm
   endif

   --AID SPHERE NUM $!this.splitSphere $!originPos DIA 100mm
   --AID TEXT NUM $!this.splitSphere 'Plane Origin' AT $!originPos

   !this.drawPlane(TRUE)
   !this.planeDerived = TRUE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      planeSplit
--
-- Description: method to orientate the plane according to the pick direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPlaneDir ()


  -- this is the angle into the screen
  !pv1 = !this.positionData.pointVector
  -- this is the angle of the plane
  !pv2 = !this.positionData.plane.pointVector()

  !this.plane = !this.positionData.plane

  if !pv1.direction.angle(!pv2.direction).lt(90) then
      !pv2.direction = !pv2.direction.opposite()
      !this.plane = !pv2.plane()
      !this.positionData.plane = !this.plane
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      planeSplit
--
-- Description: method to orientate the plane according to the pick direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPlane(!mode is BOOLEAN)

  if !this.plane.unset() then
    return
  endif

  !this.tidy('PLANE')

  !testPlane = object PLANE()
  !testPlane.position  = n0
  !testPlane.orientation = z is n wrt /*
  if !this.plane.eq(!testPlane) then
     return
  endif

  -- draw the new plane if necessary
  if !mode then
       -- get the size of the plane
       !psize      =   !this.planeSize.val.real()
       if(!psize.unset())then
          !psize   =   1000mm
       endif
       !planePos = !this.plane.position
       !planeDrn  = !this.plane.orientation.zDir()
       -- draw the plane box
       aid translucency 35
       $M "%PDMSUI%\des\clib\gplane" $!psize $<plane $!planeDrn through $!planePos$> $<$> true $<$> $<$> $<$!this.planeTagId$> $<$!this.pfill$>
       -- AID TEXT NUM $!this.planeTagId 'Plane Origin' AT $!planePos
       aid translucency 0
       !this.pShow.val = TRUE
   endif


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      planeSplit
--
-- Description: Split based on a plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .planeSplit(!element is DBREF)

   if !element.unset() then
     if(!this.elements.unset())then
        !!alert.error('No pipes found for splitting. Add pipes to the Branches to Split list and retry.')
        !this.tidyPlanes()
        return
     endif
   else
      if !element.ostype.eq('BRAN') then
         !this.elements[1] = !element.owner
      elseif !element.type.eq('BRAN') then
         !this.elements[1] = !element
      else
         !!alert.error('Picked Element is not suitable for splitting. Add pipes to the list in the form and retry.')
         return
      endif
   endif

   if(!this.plane.unset())then
      !!alert.error('Plane not defined. Please create one.')
      return
   endif
   -- Start marking from here onwards for 'undo'
   !this.undoObject.add()

   -- Initialise variables to collect the tubes and intersection points.
   !tubiForSplit    =   ARRAY()
   !intersectionArray    =   ARRAY()

   do !i indices !this.elements

      -- Collect all tubes for the branch
      var !collTubi coll all TUBI for $!this.elements[$!i]

      skip if(!collTubi.unset())

      -- Loop through the tubes to find out the intersection points
      do !j indices !collTubi
         !tubi    =  !collTubi[!j].dbref()
         !tubeLen =  !tubi.itle

         !currentComp = !collTubi[!j].after('IL TUB OF ')
         !tubiStComp = !currentComp.dbref()

         if(!tubiStComp.type eq 'BRAN')then
               !tubiStPos  =  !tubiStComp.hpos
               !tubiDir    =  !tubiStComp.hdir
         else
               !tubiStPos  =  !tubiStComp.lpos
               !tubiDir    =  !tubiStComp.ldir
         endif

         !tubiEndPos    =  !tubiStPos.offset(!tubiDir,!tubeLen)

         -- Replace the tubi with a line object
         !line       =   object LINE(!tubiStPos,!tubiEndPos)

         -- Take out the intersection point of the plane and the line
         !intersectionPoint  =   !this.plane.intersection(!line)
         handle (2,873)
               skip
         endhandle

         -- Check if the intersection point is set / actually lies on the implied tube
         skip if(!intersectionPoint.unset() OR !line.onProjected(!intersectionPoint).not())

         !tubiForSplit.append(!tubi)
         !intersectionArray.append(!intersectionPoint)
      enddo
   enddo

   -- If no intersection points are obtained stop proceeding.
   if(!intersectionArray.unset())then
      !!alert.error('No split points have been found.' )
      --!this.tidy('dismiss')
      return
   endif

   -- Graphically represent of the split point
   do !i indices !intersectionArray
    !this.markSplitPoint(!tubiForSplit[!i],!intersectionArray[!i] )
   enddo

   -- Ask user for confirmation

   !confirmSplit   =   !!alert.confirm('Continue splitting at these points?')

   AID CLEAR ALL $!this.splitSphere
   handle ANY
   endhandle

   if(!confirmSplit eq 'NO')then
       !this.applySplit.active = TRUE
      return
   endif

   -- Insert the assembly in each tubi
   do !i indices !tubiForSplit
      !this.insertSplitAssembly(!tubiForSplit[!i],!intersectionArray[!i])
   enddo

   !this.tidyPlanes()
   !this.undoObject.endUndoable()


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      insertSplitAssembly
--
-- Description: This actually inserts the assembly at the given points
--
-- Method Type: Procedure
--   [Data Type] [Description]
--   DBREF       The tube to be inserted into
--   POSITION    The position for the split
------------------------------------------------------------------------
define method .insertSplitAssembly(!tube is DBREF ,!splitPosition is POSITION)

      -- get the assembly selection from the form
      !assembly = !this.assemblyList.selection().dbref()

      !assemblyObj = object PIPINGASSEMBLYMGR(true)
      !assemblies = !assemblyObj.assemblies

      do !j indices !assemblies
        if !assemblies[!j].appldata.name.dbref().eq(!assembly) then
          !thisAssembly = !assemblies[!j]
          break
        endif
      enddo

      !buildOrigin = !this.findBuildOrigin( !splitPosition, !tube)

      !thisAssembly.buildInTube(!splitPosition, !tube, !buildOrigin, FALSE)
      -- If the user has opted for moving the down-stream components to new pipe/branch.
      if(!this.moveComp.val neq 1) then
         if(!this.moveComp.val eq 2)then
            !splitType = 'PIPE'
         elseif(!this.moveComp.val eq 3)then
            !splitType = 'BRANCH'
         endif

--CW fix P-38174 --
--Modify to split pipe assembly at last gasket--

           if  !thisAssembly.builtItems.size() gt 1 then
              if  !thisAssembly.builtItems[!thisAssembly.builtItems.size() - 1].type.eq ('GASK') then
          		!!ce =  !thisAssembly.builtItems[!thisAssembly.builtItems.size() - 1]
              endif
           endif
--CW end of fix --

         !this.splitPipe(!!ce,!splitType,1)
      endif

endmethod
------------------------------------------------------------------------
--
-- Method:      findBuildOrigin
--
-- Description: find the current direction for the build origin
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   position    The position for the split
--   element     the tube to be inserted into
------------------------------------------------------------------------

define method .findBuildOrigin(!position is POSITION, !element is DBREF)is REAL

  if !element.type.neq('TUBI') then
      return !this.assblyori
  endif
  !buildDir = !element.string().split()[4].dbref().ldir.wrt(/* )
  handle any
      return !this.assblyori
  endhandle

  !planeDir = !this.plane.orientation.zDir()
  if !planeDir.angle(!buildDir).gt(90) then
      !flow = FALSE
  else
      !flow = TRUE
  endif

  if !flow then
    return !this.assblyori
  else
    if !this.assblyori.eq(1) then
      return 2
    else
      return 1
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      moveComponents
--
-- Description: Move selected piping components to a new Branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveComponents()
   -- Mark from here onwards for 'undo' purpose

   !this.undoObject.add()
   if(!this.moveComp.val neq 1) then
      !!ce   =  !!pickedElement
      if(!this.moveComp.val eq 2)then
         !splitType = 'PIPE'
      elseif(!this.moveComp.val eq 3)then
         !splitType = 'BRANCH'
      endif

      !this.splitPipe(!!pickedElement,!splitType,1)
   endif
   !this.undoObject.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- method:      splitOptionGadgets
--
-- Description: Control the visibility of split data for selected option
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Split option - PLANE/SEGMENT/moveComp
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitOptionGadgets(!task is STRING)

    !this.splitOption = !task
    !this.frmDetailOptions.visible = true

    if (!task eq 'MERGE') then
      !this.moveComp.tag   = 'Merge Unit'
      !this.newpipe.tag    = 'One Pipe'
      !this.newbran.tag    = 'One Bran'
      !this.applySplit.tag = 'Merge'
      !this.frmDetailOptions.visible = false
      !this.idSplit.visible      = false
      !this.noMove.active = false
      !this.segmentopt.val = 1
      !this.splitPick = !this.segmentopt.selection()
      !this.segmentopt.active = false

      if (!this.moveComp.val eq 1) then
        !this.moveComp.val = 3
      endif

    else
      !this.moveComp.tag   = 'Move down-stream components to '
      !this.newpipe.tag    = 'New Pipe'
      !this.newbran.tag    = 'New Bran'
      !this.applySplit.tag = 'Split'
      !this.applySplit.settooltip('Apply selected split method')
      !this.frmDetailOptions.visible = true
      !this.idSplit.visible      = true
      !this.noMove.active =true
    endif

    if(!task eq 'PLANE')then
       !this.setSegSplitGadgets(FALSE)
        !this.setVisibility(!task)
        if !this.positionData.plane.set()   then
          !this.createPlane()
        endif
        return
    elseif (!task eq 'MOVECOMP') then
       !this.setSegSplitGadgets(FALSE)
       !this.frmDetailOptions.visible = false
       !this.tidy('')
    else
       !this.tidy('')

    endif

    !this.setVisibility(!task)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      splitPipe
--
-- Description: Split Pipe based on the options selected
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitPipe(!task is STRING)


    -- this is wrong because we are only checking the current element which could be anything ?????????
    if(!!ce.lock)then
      !!alert.error('Unable to split - the current element is locked.')
      return
    endif

    --P-14620: If split then undo causes an error as branch not selected so
    -- check this function does no cause an error.
    !!dbrefUpdate(!!ce).not()
    handle any
      --If it does make the !!ce the owner of the current !!ce.
      !!ce = !!ce.owner
    endhandle

    if(!!dbrefUpdate(!!ce).not())then
      !!alert.error('You do not have write access to the current database element')
      return
    endif

    if(!task eq '') then
       !!alert.error('Select an option to Split')
       return

    elseif(!task eq 'PLANE') then
       !this.planeSplit(object DBREF())
    elseif !task.eq('SEGMENT').and(!this.splitPick.eq('COMP'))  then
       -- this is the main segment split option
       --clear any aid text in case it was not cleared by the main app
       AID CLEAR TEXT $!this.tagId
       handle ANY
       endhandle

       -- P-13367 fix for imperial minimum lengths
       if   !this.length.val.unset() or !this.minTubeLen.val.unset() or !this.length.val.lt(50mm)or !this.minTubeLen.val.lt(50mm) then
            !!alert.error('You must enter valid values for segment length and minimum tube length')
            return
       endif
       if(!this.length.val.real() lt !this.minTubeLen.val.real() OR !this.length.val.unset()) then
          !lengthOptVal  = !this.lengthOption.val
          !lengthOptDtxt = !this.lengthOption.dtext[!lengthOptVal]
          !!alert.error('$!lengthOptDtxt should not be less than $!this.minTubeLen or unset.')
          return
       endif
     --!this.pickElement()

      !assembly = !!pipeSplitting.assemblyList.selection().dbref()
      !pipeAssembly = object PIPEASSEMBLY(!assembly)

      -- checks to see if pipe can be split by checking assembly origins and number of branches

    if !pipeAssembly.branchcount neq 1 then
       !!alert.error('Cannot split pipe, selected assembly not valid - too many branches')
       return
      if !pipeAssembly.branchcount eq 0 then
         !!alert.error ('Cannot split pipe, selected assembly not valid - no branches')
         return
      endif
    endif

    if !pipeAssembly.primaryorigin.unset() then
         !!alert.error('Can not split pipe, please set primary origin on pipe assembly')
         return
    endif
     -- old method of doing this using piping actions
     -- calls a segment splitting object via a piping actions object
     !!segmentActions = object PIPINGACTIONS('segmentActions')
     -- pick the start and finish components for the split. These are generally expected to be flanges but can be other things
     !!segmentActions.rangeselect()
     -- after selecting the range, !!segmentActions is passed as a constructor method to a splitSegment object

    elseif  !task.eq('SEGMENT').and(!this.splitPick.eq('FEAT')) then
       --clear any aid text in case it was not cleared by the main app
       AID CLEAR TEXT $!this.tagId
       handle ANY
       endhandle


       if(!this.length.val.real() lt !this.minTubeLen.val.real() OR !this.length.val.unset() ) then
          !lengthOptVal  = !this.lengthOption.val
          !lengthOptDtxt = !this.lengthOption.dtext[!lengthOptVal]
          !!alert.error('$!lengthOptDtxt should not be less than $!this.minTubeLen or unset.')
          return
       endif
       !this.pickElement()
    elseif(!task eq 'MOVECOMP') then
       !this.pickElement()

    elseif(!task eq 'MERGE') then
       !this.pickElement()
    endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      removeElement
--
-- Description: Remove selected element(Branch) from the list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeElement()

  -- Unenhance elements
  do !i indices !this.elements
     UNENHANCE $!this.elements[$!i]
  enddo

  !currentList = !this.elemList.dtext
  !selections  = !this.elemList.selection()
  !newList     = !currentList.difference(!selections)
  !this.elemList.dtext = !newList

  !this.elements.clear()

  -- update the elements array also
  do !i indices !this.elemList.dtext
     !this.elements[!i] =   !this.elemList.dtext[!i].split()[2].dbref()
     handle any
        !elemTxt            =   '/' + !this.elemList.dtext[!i].split()[2]
        !this.elements[!i]  =   !elemTxt.dbref()
     endhandle
     ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clearList
--
-- Description:
--   Remove and unenhance all elements in the list. Clear aids if any
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    Clear Graphical aids
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearList()

  -- Unenhance elements

  do !i indices !this.elements
     UNENHANCE $!this.elements[$!i]
  enddo

  !this.elements.clear()

  !this.elemList.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     setVisibility
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Split option task
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setVisibility(!task is STRING)

    if(!task eq 'PLANE') then
      !this.planeDef.visible      = TRUE
      !this.elementList.visible   = true
      !this.splitLength.visible   = FALSE

      !this.assemblyFrame.active = true
      --!this.assemblyList.visible      = TRUE
      --!this.assemblyTypes.visible = TRUE
      --!this.vFrame.visible = TRUE

      !this.elemList.active       = TRUE
      !this.load.active          = TRUE
      !this.addCe.active         = TRUE
      !this.id.active            = TRUE
      !this.clear.active         = TRUE
      !this.idSplit.visible      = TRUE

      !this.noMove.active         = TRUE
      !this.moveComp.val          = 1
       !this.drawPlane(TRUE)

    elseif(!task eq 'SEGMENT') then

      !this.planeDef.visible      = FALSE
      !this.elementList.visible   = false
      !this.splitLength.visible   = TRUE
      !this.assemblyFrame.active = true
--      !this.assemblyList.visible       = TRUE
--      !this.assemblyTypes.visible = TRUE
--      !this.vFrame.visible        = TRUE
      !this.elemList.active       = FALSE
      !this.load.active           = FALSE
      !this.addCe.active          = FALSE
      !this.id.active             = FALSE
      !this.clear.active          = FALSE
      !this.idSplit.visible       = FALSE
      !this.noMove.active         = TRUE
      !this.moveComp.val          = 1
      !this.drawPlane(FALSE)

    elseif(!task eq 'MOVECOMP') then
      !this.planeDef.visible      = FALSE
      !this.elementList.visible   = false
      !this.splitLength.visible   = FALSE
      !this.assemblyFrame.active = false
--      !this.assemblyList.visible      = FALSE
--      !this.assemblyTypes.visible = FALSE
--      !this.vFrame.visible = FALSE
      !this.elemList.active       = FALSE
      !this.load.active          = FALSE
      !this.addCe.active         = FALSE
      !this.id.active            = FALSE
      !this.clear.active         = FALSE
      !this.idSplit.visible      = FALSE

      !this.noMove.active         = FALSE
      if(!this.moveComp.val eq 1)then
         !this.moveComp.val         = 2
      endif
       !this.drawPlane(FALSE)
    endif
endmethod
------------------------------------------------------------------------
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      splitSegment()
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitSegment()



  !this.undoObject.add()
   var !mode mode
   if !mode.upcase().eq('BACKWARDS') then
      forwards
   endif

  if(!!pickedElement.unset().not()) then
     !startComp = !!pickedElement[1]
     if(!!pickedElement.size() eq 2)then
        !endComp = !!pickedElement[2]
        --return
     else
        -- the user has hit escape because there is no picked element 2
        -- the user could have hit escape because he dos not want to continue so maybe we should prompt
        -- to ask
        $!!pickedElement[1]
        -- $P picked is $!!pickedElement[1]
        !startComp = !!ce
       if !startComp.owner.type.eq('BRAN') then
           !componentsInBranch = !startComp.owner.members
           if !startComp.order.gt(!componentsInBranch.size()) then
             !componentsInBranch.invert()
             -- $P inverted
           endif
        else
           !componentsInBranch = !startComp.members
        endif
        !startComp  = !componentsInBranch[1]
        !endComp    = !componentsInBranch[!componentsInBranch.size()]
     endif
  endif



  !lengthOption   =  !this.lengthOption.selection()
  !segmentLen  =  !this.length.val.real()
  !minFinLen   =  !this.minTubeLen.val.real()

   -- this is the bit which does normal segment splitting
  !!splitObject = object SPLITSEGMENT(!startComp, !endComp, !segmentLen, !minFinLen )

  -- this is the old way of doing the splits and this object is still in place
  -- at some time it probably needs to be deleted.
  --!splitObject.segmentSplit(!startComp,!endComp,!segmentLen,!minFinLen,!segmentType)
  !collGaskets = !!splitObject.collGaskets

   -- its a segment split
  AID CLEAR TEXT $!this.tagId
  handle ANY
  endhandle
  AID CLEAR cylinder $!this.tagId
  handle ANY
  endhandle
  AID CLEAR arrow $!this.tagId
  handle ANY
  endhandle

  if(!this.moveComp.val neq 1)then
     if(!this.moveComp.val eq 2)then
        !splitType = 'PIPE'
     else
        !splitType = 'BRANCH'
     endif

     do !i indices !collGaskets
        !this.splitPipe(!collGaskets[!i], !splitType,!i)
     enddo
  endif

  $!mode
  !this.undoObject.endUndoable()

endmethod
------------------------------------------------------------------------
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      positionPlane
--
-- Description: this method takes out the plane definition picks from the
-- original pickElement method because it became too complicated.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL type of plane pick required.
------------------------------------------------------------------------
define method .positionPlane()

  --!splitPointOpt[1] = 'Position plane in Tube'
  --!splitPointOpt[2] = 'Position Plane on Component'
  --!splitPointOpt[3] = 'Position Plane on a pPoint'

  -- define packet
  !prompt                = 'Pick A Position'
  !packet                = object EDGPACKET()
  !packet.initialisation = '!!pipeSplitting.pickedPosData  = object EDGPOSITIONDATA()'
  !packet.definePosition(!prompt)
  !packet.description    = 'Plane Position'
  !packet.remove         = TRUE
  !packet.action = '!!pipeSplitting.setPlanePosition(!this.return[1] ) '

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      SetPosition
--
-- Description: this method defines the pick position and direction of the plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL type of plane pick required.
------------------------------------------------------------------------
define method .setPlanePosition(!pos is EDGPOSITIONDATA )

    !this.positionData = !pos

    if !pos.item.type inset('PNOD','SNOD') then
      !!alert.error('Unable to derive a Plane from the selected element ($!pos.item.type) - Please reselect')
      return
    endif
    -- Initialise variables
    !pv = object POINTVECTOR()


   if !pos.type.eq('PPOINT') then

      !pv.position = !pos.item.ppos[!pos.pPoint].wrt(/* )
      !pv.direction = !pos.item.pdir[!pos.pPoint].wrt(/* )
      !this.plane = !pv.plane()

   elseif !pos.item.ostype.eq('BRAN').or(!pos.item.type.eq('BRAN')).and(!pos.type.eq('TUBING')) then

      -- Initialise Variables
      !tubing         = object EDGTUBING()
      !position       = !tubing.exact(!pos.item, !pos.pointVector)

      !pv = object POINTVECTOR()
      !pv.position = !position
      if !pos.tubing.eq('LEAVE') then
          !pv.direction = !pos.item.ldir.wrt(/* )
      else
          !pv.direction = !pos.item.hdir.wrt(/* )
      endif

      !this.plane = !pv.plane()

   else
      -- pipe intersection is used to get a graphics intersection anywhere
      !int = object PIPEINTERSECTION()
      !pv = !int.intersection(!pos.item, !pos.pointVector)
      !this.plane = !pv.plane()
   endif

   !this.copyPlane()
   !this.drawPlane(TRUE)


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copyPlanePlane
--
-- Description: This method sets the plane position and direction from the
-- current plane definition
--
--
------------------------------------------------------------------------
define method .copyPlane()

!this.posControl.xyz(!this.plane.position.east,!this.plane.position.north, !this.plane.position.up)
!this.planeDirection.val = !this.plane.orientation.zDir().string()

endmethod

------------------------------------------------------------------------
--
-- Method:      modifyPlanePosition
--
-- Description: This method sets the plane position from the position control
--
--
------------------------------------------------------------------------
define method .modifyPlanePosition()

   !this.plane.position = !this.getPositionControlPos(!this.posControl.xyz())
   !this.drawPlane(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      movePlane
--
-- Description: This method moves the plane position using the nudge buttons
--
--
------------------------------------------------------------------------
define method .movePlane(!dir is STRING ,!dist is REAL)

    !pv = !this.plane.pointVector()
    if !dir.eq('R') then
      !pvNew = !pv.offset(!dist)
    else
       !pvNew = !pv.offset(-!dist)
    endif
    !this.plane = !pvNew.plane()
    !this.copyPlane()
    !this.drawPlane(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      modifyPlaneDirection
--
-- Description: This method sets the plane direction as a result of the
-- direction gadget changing
--
--
------------------------------------------------------------------------
define method .modifyPlaneDirection(!dir is STRING )

      !direction = !dir.direction()
      handle ANY
        !!alert.error('Cannot convert string $!dir to Direction')
        return
      endhandle

      !pv = object POINTVECTOR()
      !pv.position = !this.plane.position.wrt(/* )
      !pv.direction = !direction
      !this.plane = !pv.plane()
      !this.drawPlane(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      getPositionControlPos
--
-- Description: returns the position in appropriate unit from POSITIONCONTROL gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPositionControlPos(!posValues is ARRAY) is POSITION

    !east  = !posValues[0].string()
    !north = !posValues[1].string()
    !up    = !posValues[2].string()

    !position   = object POSITION(' E  $!east  N  $!north  U $!up ' )

    return !position

endmethod


------------------------------------------------------------------------
--
-- Method:      pickElement
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickElement()


  -- this method is called by anything which needs to pick from the graphics.
  -- because of the numerous options which rely on picking this needs to be split
  -- up into an option based set of statements

  -- First of all, get rid of the current picked element
  if(defined(!!pickedElement))then
     !!pickedElement.delete()
  endif

  -- define the basic pick packet
  !firstPacket = object EDGPACKET()
  !firstPacket.description = 'Pick Piping Component'
  !firstPacket.key      = 'pickPcom'
  !firstPacket.priority = 3
  !firstPacket.action = '!!pickedElement = !this.return[1].item'

  if !this.moveComponents.val then
    -- we are splitting by moving components into a new pipe or branch
    !firstPacket.elementPick('Pick a Piping component')
    !firstPacket.continue  = '!!pipeSplitting.moveComponents()'
  endif

  -- fix to stop this getting called when segment splitting is off
  if (!this.splitPick eq 'FEAT')then
       !!pickedElement = ARRAY()
       label /PICKAGAIN

       prompt off

       prompt load escape 'identify branch to split'

       id bran @
       handle (61,528)
         --P-13251: handle user exits sub mode error and return to enable escape key to be used to exit process.
         return

       elsehandle ANY

         golabel /PICKAGAIN

       elsehandle NONE
         !this.branch = !!ce
         !!pickedElement.delete()
         prompt dismiss
       endhandle
       !firstPacket.anyPick('Pick a feature to split to')
  else
       !firstPacket.elementPick('Pick a Piping component')
       --!firstPacket.continue  = '!!pipeSplitting.moveComponents()'
  endif


     !firstPacket.remove = TRUE
     !firstPacket.pickPacket.picks[1].pick.input[3]   = |match('BRAN',(TYPE OF OWN)) eq 1|
     !firstPacket.pickPacket.picks[1].pick.modifiable = FALSE

     !firstPacket.escape = ''


  if(!this.splitOption eq 'SEGMENT')then
     !firstPacket.initialisation = '!!pickedElement = ARRAY()'
     --!firstPacket.action = '!!pickedElement.append(!this.return[1])'
     !firstPacket.action = '!!pipeSplitting.checkPick(!this.return[1], 1)'
     !firstPacket.pickPacket.prompt = 'Pick the ending component or <esc> to split  branch'
     !firstPacket.pickPacket.picks[1].pick.modifiable = TRUE

     !secondPacket = !firstPacket
     !secondPacket.action = '!!pipeSplitting.checkPick(!this.return[1], 2)'
     !secondPacket.description = 'Pick second piping Component'
     !secondPacket.key      = 'picksecpcom'
     !secondPacket.priority = 2
     !secondPacket.continue = '!!pipeSplitting.splitSegment()'
     !secondPacket.escape   = '!!pipeSplitting.splitSegment()'

     !firstPacket.pickPacket.prompt = 'Pick the starting component'

     !!edgCntrl.add(!secondPacket)
   elseif(!this.splitPick eq 'FEAT')then

     --!firstPacket.action = '!!pickedElement.append(!this.return[1].item)'
     !firstPacket.action = '!!pipeSplitting.checkPick(!this.return[1], 1)'
     !firstPacket.pickPacket.prompt = 'Pick the ending component/feature or <esc> to end of branch'
     !firstPacket.pickPacket.picks[1].pick.modifiable = TRUE

     !secondPacket = !firstPacket
     !secondPacket.action = '!!pipeSplitting.checkPick(!this.return[1], 2)'
     !secondPacket.description = 'Pick second piping Component'
     !secondPacket.key      = 'picksecpcom'
     !secondPacket.priority = 2
     !secondPacket.continue = '!!pipeSplitting.splitSegment()'
     !secondPacket.escape   = '!!pipeSplitting.splitSegment()'

     !firstPacket.pickPacket.prompt = 'Pick the starting component/feature'

     !!edgCntrl.add(!secondPacket)

  elseif(!this.splitOption eq 'PLANE')then
     !this.tidy('')
-- This form method does not exist anymore and is not needed.
-- Removed from if loop
--  if(!this.splitPoint.val ne 3)then
--    !firstPacket.pickPacket.picks[1].pick.input[3] = |match('TUBI',TYPE) eq 1|
--    !firstPacket.pickPacket.prompt = 'Pick any pipe leg to place a cutting plane orthogonally'
--    !firstPacket.escape = |!!edgCntrl.remove('Basic Position')|
--    !secondPacket = object EDGPACKET()
--    !secondPacket.action   = '!!pipeSplitting.positionData = !this.return[1]'
--    !secondPacket.definePosition('Pick to position the cutting plane')
--    !secondPacket.priority    = 2
--    !secondPacket.remove      = TRUE
--    !secondPacket.continue    = '!!pipeSplitting.createPlane()'
--    !!edgCntrl.add(!secondPacket)
-- else
     !firstPacket.pickPacket.plane3Pnts()
     !firstPacket.action = '!!pickedElement = !this.return[1]'
     !firstPacket.remove = TRUE
     !firstPacket.continue  = '!!pipeSplitting.createPlane(!this.return[1])'
-- endif

  elseif (!this.splitOption eq 'MERGE')then
    !firstPacket.initialisation = '!!pickedElement = ARRAY()'
    !firstPacket.action   = '!!pickedElement.append(!this.return[1])'
    !firstPacket.pickPacket.picks[1] = object EDGPICKTYPE()
    !firstPacket.pickPacket.picks[1].pick.input[3] = |match('BRAN',(TYPE OF OWN)) eq 1|
    !firstPacket.pickPacket.picks[1].stdElement('- source element')
    !firstPacket.continue = |!!pipeSplitting.pickSecondElementForMerge()|

  else
     if defined(!!pickedElement) then
     !firstPacket.continue  = '!!pipeSplitting.moveComponents()'
  endif

  endif

  !!edgCntrl.add(!firstPacket)

endmethod
------------------------------------------------------------------------
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      pickSecondElementForMerge
--
-- Description: checks whether or not the user wants to pick the branch head or tail to split between
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickSecondElementForMerge()
  !firstPickElement  = !!pickedElement[1].item.owner
  !highlightColour   = !!gphColOpt.highlight().code
  ENHANCE $!<firstPickElement> COLOUR $!<highlightColour>
  handle any
    unenhance all
  endhandle

  !secondPacket = object EDGPACKET()
  !secondPacket.description = 'Pick Piping Component'

  !secondPacket.priority = 3
  !secondPacket.remove = true

  !secondPacket.pickPacket.picks[1] = object EDGPICKTYPE()
  !secondPacket.pickPacket.picks[1].pick.input[3]   = |match('BRAN',(TYPE OF OWN)) eq 1|
  !secondPacket.pickPacket.picks[1].stdElement('Pick Piping Component - target element')
  !secondPacket.pickPacket.picks[1].pick.modifiable = FALSE

  !secondPacket.action = '!!pipeSplitting.merge(!!pickedElement[1],!this.return[1])'
  !!edgCntrl.add(!secondPacket)

endmethod

------------------------------------------------------------------------
--
-- Method:      checkPick
--
-- Description: checks whether or not the user wants to pick the branch head or tail to split between
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkPick(!pickData is EDGPICKDATA, !pickNum is REAL)

  !element = !pickData.item

  var !mode mode

  if !this.splitPick.eq('FEAT') then
    -- check to see if the picked component is on another branch to the picked branch to split
    if !element.owner.neq(!this.branch) and !element.neq(!this.branch) then
      !splitMode = 'FEAT'
    else
      !splitMode = 'COMP'
    endif
  else
    !splitMode = 'COMP'
  endif

  if !splitMode.eq('FEAT') then

    for

    -- we need to put in an assembly at the required point that is defined by plane
    -- and then use this as either the start or end component.

    -- pick the leg of the branch you need to start splitting in
    -- if we don't do this then we don't know what direction to use for the plane.
    label /PICKCOMPAGAIN

    prompt off

    prompt load escape 'identify section of branch where split will intersect'
    id @
    handle ANY

      golabel /PICKCOMPAGAIN

    elsehandle NONE
      prompt dismiss
      !comp = !!ce
      if !comp.owner.neq(!this.branch) and !comp.neq(!this.branch) then
        golabel /PICKCOMPAGAIN
      endif

      -- get the direction of the picked leg component and create a point vector at the picked element off the branch
      if !comp.type.eq('BRAN') then
        if !mode.upcase().eq('FORWARDS') then
          var !planeDir hdir of $!comp
          var !point hpos of $!comp wrt /*
        else
          var !planeDir tdir of $!comp
          var !point tpos of $!comp wrt /*
        endif
      else
        var !planeDir dir pl of $!comp
        var !point pos pl of $!comp wrt /*
      endif
    endhandle

    if !pickData.type.eq('PLINE') then
      !pline = !pickData.pline
      var !elementPos pos ppli $!pline start of $!element wrt /*
    else
      !pPoint = !pickData.point
      var !elementPos pos p$!pPoint of $!element wrt /*
    endif

    !elementPv = object POINTVECTOR(!elementPos.position(), !planeDir.direction())

    !legPv = object POINTVECTOR(!point.position(), !planeDir.direction())

    !intersection = !legPv.intersection(!elementPv.plane())

    -- now put in an assembly at this intersection

   -- get the assembly selection from the form
   !assembly = !this.assemblyList.selection().dbref()

   !assemblyObj = object PIPINGASSEMBLYMGR(true)
   !assemblies = !assemblyObj.assemblies

   do !i indices !assemblies
     if !assemblies[!i].appldata.name.dbref().eq(!assembly) then
       !thisAssembly = !assemblies[!i]
       break
     endif
   enddo

   -- now we need to find the prev component for the insert assembly method

   -- run the insert assembly method
   !thisAssembly.buildInTube(!intersection,!comp,!this.assblyori,FALSE)

   if !pickNum.eq(1) then
     if !thisAssembly.builtItems.set() then
       !!pickedElement[!pickNum] = !thisAssembly.builtItems[1]
     else
       !!pickedElement[!pickNum] = !!ce
     endif
   else
     $!comp
     next
     !!pickedElement[!pickNum] = !!ce
   endif
  else

    -- force the mode into forward until we finish checking picks
    FOR

    !response = 'NO'

    if !element.type.eq('BRAN') then

      -- collect the branch member list so we can check if we need to set the head or tail pos for the pick
      var !components collect bran mem

      --if !pickNum.eq(2) and !!pickedElement[1].eq(!element) and !components.unset().not() then
        -- if we are picking the same component or tubi as last time automatically choose the other possible component or branch
        !response = 'NO'
      --elseif !pickNum.eq(2) and !!pickedElement[1].neq(!element) and !components.unset().not() then
        -- if we have picked a branch element and our picked element is not a branch then we must need to choose the branch this time
      --  !response = 'YES'
      if !pickNum.eq(2) and !components.unset() then
      --elseif !pickNum.eq(2) and !components.unset() then
        -- if we have picked a branch element and our picked element is not a branch then we must need to choose the branch this time
        if !this.branchPick[1].eq('HPOS') then
          !this.branchPick[!pickNum] = 'TPOS'
          !!pickedElement[!pickNum] = !element
          !position = !element.tpos.wrt( /* )
          handle ANY
            return
          endhandle


          if !pickNum.eq(1) then
            aid text num $!this.tagId 'START' at $!position
            !this.tag(!!pickedElement[!pickNum])
          else
            aid text num $!this.tagId 'END' at $!position
          endif

          return
        else
          !this.branchPick[!pickNum] = 'HPOS'
          !!pickedElement[!pickNum] = !element
          !position = !element.hpos.wrt( /* )
          handle ANY
            return
          endhandle

          if !pickNum.eq(1) then
            aid text num $!this.tagId 'START' at $!position
            !this.tag(!!pickedElement[!pickNum])
          else
            aid text num $!this.tagId 'END' at $!position
          endif

          return
        endif
      else
        -- check to see if there are any components in the line
        if !components.unset().not() then
          --!response = !!alert.confirm('Do you wish to start splitting at the end of the pipe?')
           !response = 'YES'
        else
          !response = !!alert.confirm('No components in line, do you want to choose the branch head? (<no> for branch tail)')
          if !response.eq('YES') then
            !!pickedElement[1] = !element
            !this.branchPick[!pickNum] = 'HPOS'
            !position = !element.hpos.wrt( /* )
            handle ANY
              return
            endhandle


            if !pickNum.eq(1) then
              aid text num $!this.tagId 'START' at $!position
              !this.tag(!!pickedElement[!pickNum])
            else
              aid text num $!this.tagId 'END' at $!position
            endif

            return
          else
            !!pickedElement[1] = !element
            !this.branchPick[!pickNum] = 'TPOS'
            !position = !element.tpos.wrt( /* )
            handle ANY
              return
            endhandle


            if !pickNum.eq(1) then
              aid text num $!this.tagId 'START' at $!position
              !this.tag(!!pickedElement[!pickNum])
            else
              aid text num $!this.tagId 'END' at $!position
            endif

            return
          endif
        endif
      endif

      if !response.eq('YES') then
        !!pickedElement[!pickNum] = !element
        !this.branchPick[!pickNum] = 'HPOS'
        !position = !element.hpos.wrt( /* )
        handle ANY
          return
        endhandle
      else
        !!pickedElement[!pickNum] = !element.member[1]
        !element = !element.member[1]
        !position = !element.apos.wrt( /* )
        handle ANY
          return
        endhandle
      endif

    else

      -- we do not have a branch so make sure that the form member for the branch pick is not set
      --!branchPick[!pickNum] = ''

      -- CHECK THAT THE PICKED ELEMENT IS NOT IN THE MIDDLE OF A COMPONENT GROUP
      !atPipeEnd = 0

      -- run through the members list from the current element in both directions
      -- if we have a component (other than an atta) either side of the current element then
      -- we know we are not going to pick up a problem with the end or tail position of the branch
      $!element
      NEX
      handle (2,113)
        !atPipeEnd = !atPipeEnd + 1
      elsehandle NONE
        if !!ce.type.eq('ATTA') then
          do
            nex
            handle (2,113)
              !atPipeEnd = !atPipeEnd + 1
              break
            elsehandle NONE
              if !!ce.type.eq('ATTA') then
                nex
                handle (2,113)
                  !atPipeEnd = !atPipeEnd + 1
                  break
                endhandle
              else
                break
              endif
            endhandle
          enddo
        else
          -- do nothing
        endif
      endhandle

      -- if we are not are in the middle of a component group then return the picked element
      if !atPipeEnd.eq(0) then
        !!pickedElement[!pickNum] = !element
        !position = !element.lpos.wrt( /* )
      else
        -- if not then we either give a choice to use the branch head/tail or we use the component next to it
        --if !pickNum.eq(2) and !!pickedElement[1].type.eq('BRAN') then
          -- check if we are at the opposite end to the first pick

        --  !response= 'NO'

        --elseif !pickNum.eq(2) and !!pickedElement[1].eq(!element) then

         !response = 'YES'

        --else

          --- !response = !!alert.confirm('Do you wish to start splitting at the end of the pipe?')

        --endif

        if !response.eq('YES') then
          !!pickedElement[!pickNum] = !element.own
          !this.branchPick[!pickNum] = 'TPOS'
          !element = !element.own
          !position = !element.tpos.wrt( /* )
        else
          !!pickedElement[!pickNum] = !element
          !position = !element.lpos.wrt( /* )
        endif
      endif
    endif


    if !pickNum.eq(1) then
      aid text num $!this.tagId 'START' at $!position
      !this.tag(!!pickedElement[!pickNum])
    else
      aid text num $!this.tagId 'END' at $!position
    endif

    $!mode
  endif
endmethod
------------------------------------------------------------------------
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      insertAssembly
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertAssembly(!splitLength is REAL)


  !tubeLength = !!pickedElement.ltle
  if(!tubeLength leq !splitLength.real()) then
    return error 2 'Murali: Think of what should be done here'
  endif
  !this.insertAssembly(!splitLength.real())

endmethod
------------------------------------------------------------------------
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: to clean up graphical aids on dismiss
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy(!task is STRING)

   if !task.eq('PLANE') then

       AID CLEAR ALL $!this.planeTagId
       handle ANY
       endhandle
       return

   endif

       AID CLEAR ALL $!this.splitSphere
       handle ANY
       endhandle

       AID CLEAR ALL $!this.tagId
       handle ANY
       endhandle

       AID CLEAR ALL $!this.ceTag
       handle ANY
       endhandle


   if(!task eq 'dismiss')then
      !!pickedElement.delete()
      handle ANY
      endhandle
      !!planePosition.delete()
      handle ANY
      endhandle

      -- Unenhance elements
      do !i indices !this.elements
         UNENHANCE $!this.elements[$!i]
      enddo

-- When the form is dismissed clear out the stored edg data for
-- the plane position and direction so its not redisplayed.
      !this.positionData = object EDGPOSITIONDATA()
   elseif(!task eq 'undo')then
      !this.undoObject.endUndoable()
      UNDODB
      handle ANY
      endhandle
      -- make sure we are at a valid element
      -- p-7448 move away from the deleted element
      zone
      handle ANY
      endhandle
      return
   endif

    AID CLEAR ALL $!this.planeTagId
    handle ANY
    endhandle

endmethod
------------------------------------------------------------------------
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: to clean up graphical aids on dismiss
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhance()

   do !i indices !this.elements
      ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
   enddo

   !listVal  =  !this.elemList.val
   if !listVal.size().eq(0) then
      return
   endif

   do !i indices !listVal
      ENHANCE $!this.elements[$!listVal[$!i]] COLOUR DEEPPINK
   enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      idPipes
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idPipes(!mode is STRING)

  if !mode.eq('PLANE') and !this.plane.unset() then
    !!alert.warning('Plane not defined, please create one')
    return
  endif

  if(defined(!!pickedElement))then
     !!pickedElement.delete()
  endif

    !firstPacket = object EDGPACKET()
    !firstPacket.initialisation = '!!pickedElement = ARRAY()'

  if !mode.eq('SELECT') then
    -- select elements by pick and append them to the list box
    !firstPacket.description = 'Pick Piping Component'
    !firstPacket.key      = 'pickPcom'
    !firstPacket.priority = 3
    !firstPacket.elementPick('Pick a pipe branch (or branches) to split. <esc> to finish selecting')
    !firstPacket.action = '!!pipeSplitting.addIdPipes(!this.return[1].item,|STD|)'
    !firstPacket.close = '!!pipeSplitting.setup(|ID|)'
    !firstPacket.pickPacket.picks[1].pick.input[3]   = |(match('BRAN',(TYPE OF OWN)) eq 1) or (match('Head', TYPE) eq 1|

  elseif !mode.eq('JOIN') then
    -- select elements by pick and append them to the list box
    !firstPacket.description = 'Pick Piping Component'
    !firstPacket.key      = 'pickPcom'
    !firstPacket.priority = 3
    !firstPacket.elementPick('Pick a pipe branch (or branches) to split. <esc> to finish selecting')
    !firstPacket.action = '!!pipeSplitting.addIdPipes(!this.return[1].item,|BRAN|)'
    !firstPacket.close = '!!pipeSplitting.processBranches()'
    !firstPacket.pickPacket.picks[1].pick.input[3]   = |(match('BRAN',(TYPE OF OWN)) eq 1) or (match('Head', TYPE) eq 1|

  elseif !mode.eq('PLANE') then
    !this.elements.clear()
    !!pipeSplitting.applySplit.active = FALSE
    -- select elements by pick and split them at the intersection of a pre-defined plane
    !firstPacket.description = 'Pick Piping Component'
    !firstPacket.key      = 'pickPcom'
    !firstPacket.priority = 3
    !firstPacket.elementPick('Pick a pipe branch (or branches) to split. <esc> to finish selecting')
    --!firstPacket.action = '!!pipeSplitting.addIdPipes(!this.return[1].item,|PLANE|)'
    !firstPacket.action = '!!pipeSplitting.showSplitPoint(!this.return[1].item)'
    !firstPacket.close = '!!pipeSplitting.planeSplit(object DBREF())'
    --!firstPacket.close = '!!pipeSplitting.tidyPlanes()'
    !firstPacket.pickPacket.picks[1].pick.input[3]   = |match('BRAN',(TYPE OF OWN)) eq 1|

  endif

  !!edgCntrl.add(!firstPacket)

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      tidyPlanes
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]!this.tidy('dismiss')
--
------------------------------------------------------------------------

------------------------------------------------------------------------

define method .tidyPlanes()

  !this.applySplit.active = true

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      showSplitPoint
--
-- Description: Adds a split point to the graphics for each pick.
--
--
------------------------------------------------------------------------

define method .showSplitPoint(!element is DBREF )

    if !element.owner.type.eq('BRAN') then
      !selected = !element.owner
    else
      !selected = !element
    endif

   if(!this.plane.unset())then
      !!alert.error('Plane not defined. Please create one.')
      return
   endif

   -- Initialise variables to collect the tubes and intersection points.
   !tubiForSplit    =   ARRAY()
   !intersectionArray    =   ARRAY()

   var !collTubi coll all TUBI for $!selected

      -- Loop through the tubes to find out the intersection points
      do !j indices !collTubi
         !tubi    =  !collTubi[!j].dbref()
         !tubeLen =  !tubi.itle

         !currentComp = !collTubi[!j].after('IL TUB OF ')
         !tubiStComp = !currentComp.dbref()

         if(!tubiStComp.type eq 'BRAN')then
            !tubiStPos  =  !tubiStComp.hpos
            !tubiDir    =  !tubiStComp.hdir
         else
            !tubiStPos  =  !tubiStComp.lpos
            !tubiDir    =  !tubiStComp.ldir
         endif

         !tubiEndPos    =  !tubiStPos.offset(!tubiDir,!tubeLen)

         -- Replace the tubi with a line object
         !line       =   object LINE(!tubiStPos,!tubiEndPos)

         -- Take out the intersection point of the plane and the line
         !intersectionPoint  =   !this.plane.intersection(!line)
         handle (2,873)
               skip
         endhandle


         -- Check if the intersection point is set / actually lies on the implied tube
         skip if(!intersectionPoint.unset() OR !line.onProjected(!intersectionPoint).not())

         !tubiForSplit.append(!tubi)
         !intersectionArray.append(!intersectionPoint)
         !this.elements.append(!selected)
         -- Graphically represent of the split point
         !this.markSplitPoint(!tubi,!intersectionPoint)

      enddo


   -- If no intersection points are obtained stop proceeding.
   if(!intersectionArray.unset())then
      !!alert.error('No split points have been found.' )
      --!this.tidy('dismiss')
      return
   endif

   !this.refreshElementSplitList()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      Add an Element to the split list
--
-- Description: draws an aid cylinder at the defined split point
--
--
------------------------------------------------------------------------
define method .refreshElementSplitList()

 !this.elements.unique()

 !dispText[1]        = ARRAY()
 !dispText[2]        = ARRAY()

 do !i indices !this.elements
    !dispText[1].append(!this.elements[!i].owner.namn)
    !dispText[2].append(!this.elements[!i].namn)
    ENHANCE $!this.elements[$!i] COLOUR TURQUOISE
 enddo

 !this.elemList.setcolumns(!dispText)

endmethod

------------------------------------------------------------------------
--
-- Method:      markSplitPoints
--
-- Description: draws an aid cylinder at the defined split point
--
--
------------------------------------------------------------------------
define method .markSplitPoint(!tube is DBREF,!splitPosition is POSITION )

      !sphereDia   =  !tube.lbore.real().distance().real() + 100mm
      AID SPHERE NUM $!this.splitSphere  $!splitPosition DIA $!sphereDia
      AID TEXT NUM $!this.splitSphere '<split>' AT $!splitPosition

endmethod



------------------------------------------------------------------------
--
-- Method:      addIdPipes
--
-- Description:
--
--
------------------------------------------------------------------------

define method .addIdPipes(!element is DBREF, !mode is STRING )
  -- if the picked element has been picked before then unenhance it and remove it from the
  -- element list otherwise add and enhance it

  --if  !mode.eq('STD') then
    -- we only want branches
    if !element.owner.type.eq('BRAN') then
      !selected = !element.owner
    else
      !selected = !element
    endif
  --endif
  if !!pickedElement.unset().not() then
    if !!pickedElement.findfirst(!selected).unset().not() then
      !!pickedElement.remove(!!pickedElement.findfirst(!selected))
      if !mode.eq('STD') then
        !save = !!ce
        !!ce = !selected
        -- we are doing a branch
          unenhance $!selected members
          do !a values !selected.members
              unenhance il tube of $!a
              handle any
              endhandle
          enddo
          unmark $!selected
          rem bran add bran
        !!ce = !save
      else
          unenhance $!selected
          unenhance il tube of $!selected
          handle any
          endhandle
       endif
    elseif !mode.eq('PLANE') then
      !this.elements.append(!selected)
    else
      !!pickedElement.append(!selected)
      if !mode.neq('STD') then
        -- we are doing a branch
          enhance $!selected members
          mark $!selected
          do !a values !selected.members
              enhance il tube of $!a
              handle any
              endhandle
          enddo
      else
        enhance $!selected
        enhance il tube of $!selected
        handle any
        endhandle
      endif
    endif
  else
    !!pickedElement.append(!selected)
    enhance $!selected
    enhance il tube of $!selected
    handle any
    endhandle
  endif

endmethod
