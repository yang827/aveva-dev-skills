------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: display graphical aids for flow direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tag(!ref is DBREF)

  !ce = !!ce
  $!ref

  if !!ce.type.eq('BRAN') then
    !component = !!ce
  else
    prev
    handle ANY
      $!ref.owner
    elsehandle NONE
      if !!ce.type.eq('BRAN') then
        -- we must have already been at branch level and moved to the previous branch
        -- in this case just use the original ref
        $!ref
      endif
    endhandle
    !component = !!ce
  endif

  !!ce = !ce

  -- Remove aid graphics
  AID CLEAR ALL $!<this.ceTag>

  -- Proportion
  !proportion   = 0.5

  -- Define tag point
  if !ref.type.eq('BRAN') then
    !aDirection   = !ref.hdir.wrt( /* )
    !od = !ref.phod
    !pos = !ref.hpos
  else
    !aDirection   = !ref.ldir.wrt( /* )
    !od = !ref.lod
    !owner = !ref.owner
    var !a p2 of $!ref POSITION

    !a = !a + ' ' + 'WRT' + ' ' + !owner.string()

    !pos = !a.position()

  endif

  !aPosition = !pos

  !tagPoint     = object POINTVECTOR(!aPosition, !aDirection)

  -- Directions
  !orthogonalDir      = !tagPoint.direction.orthogonal(U)
  handle ANY
    !orthogonalDir    = !tagPoint.direction.orthogonal(N)
  endhandle
  !offsetDir    = !orthogonalDir.orthogonal(!tagPoint.direction)

  -- Define dimensions
  --!oHeight      = !od * 4
  !aHeight      = !od * 2
  -- Positions
  !tagPosition  = !tagPoint.position.offset(!offsetDir, !aHeight * 0.5)
  --!arPosition   = !tagPosition.offset(!aDirection, !aHeight)
  !cPosition    = !tagPosition.offset(!aDirection, !aHeight * 0.05)
  --!c2position   = !aPosition.offset(!offsetDir, !aHeight * 0.5)

  -- Graphics
  AID CYLINDER NUMBER $!<this.ceTag>  AT $!<cPosition>  ORI Z IS $!<aDirection>   HEIGH $!<aHeight> DIAM 8mm FILLED ON
  AID ARROW    NUMBER $!<this.ceTag>  AT $!<cPosition> DIRECTION $!<tagPoint.direction> HEIGH $!<aHeight> PROPORTION $!<proportion>


  -- Show aid text
  AID TEXT    NUMBER $!<this.ceTag> 'FLOW' AT $!<tagPosition>

endmethod
