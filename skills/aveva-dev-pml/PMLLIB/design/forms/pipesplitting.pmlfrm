------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: merge elements on pipe / branch level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .merge(!firstPick is EDGPICKDATA, !secondPick is EDGPICKDATA)

  var !mode mode
  -- in case we are in backwards
  Forwards

  unenhance all

  !firstElement   = !firstPick.item
  !secondElement  = !secondPick.item

  !sourceBran = !this.getBranchElement(!firstElement)
  !targetBran = !this.getBranchElement(!secondElement)

  if (!sourceBran eq !targetBran) then
    !!alert.error('source and target branch is same')
    return
  endif

--  if (!!dbrefUpdate(!sourceBran)) then
--    !!alert.error('You do not have write access to the source branch')
--    return
--  endif

  if (!sourceBran.type neq 'BRAN' OR !targetBran.type neq 'BRAN') then
    !!alert.error('Selected element types cannot be merged')
    return
  endif

  if (!this.moveComp.val eq 2) then
    -- merging into a single pipe
    if (!sourceBran.owner eq !targetBran.owner) then
      !!alert.error('PIPEs cannot be merged. Source and target pipe is same')
      return
    endif
  endif

  if (!this.moveComp.val eq 3) then
    -- merge into a single branch from two pipes
    if (!sourceBran.owner ne !targetBran.owner) then
      !!alert.error('Branch cannot be merged. Owner of source and target is different')
      return
    endif
  endif

  -- swap the order if the branches so that the hpos of bran 2 is the tpos of bran 1
  if (!sourceBran.hpos.wrt( /* ) eq !targetBran.tpos.wrt( /* )) then
    !sourceBranch = !sourceBran
    !targetBranch = !targetBran
  elseif (!sourceBran.tpos.wrt( /* ) eq !targetBran.hpos.wrt( /* )) then
    !sourceBranch = !targetBran
    !targetBranch = !sourceBran
  else
    !!alert.error('Branches cannot be merged. Please check position of branches')
    return
  endif

  -- now we are in a position to actually merge the branches
  !this.mergeTwoBranches(!sourceBranch, !targetBranch)

  $!mode

endmethod

------------------------------------------------------------------------
--
-- Method:      .mergeTwoBranches
--
-- Description: merges !sourceBran into !targetBran
-- (branches are now in the correct sequence heat to tail)
--
--
------------------------------------------------------------------------
define method .mergeTwoBranches(!sourceBran is DBREF, !targetBran is DBREF)

  !fromIndex = 1
  !toIndex   = !sourceBran.mCount
  !baseLoc   = 'after last mem'
  !step      = 1

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Merged Pipe Branches')
  !undo.undoAction('')
  !undo.redoAction('')
  !undo.add()

  $!targetBran
  !sourceMembers = !sourceBran.members
  !override = FALSE

   do !i from $!fromIndex to $!toIndex by $!step
    include $!sourceMembers[$!i] $!baseLoc
    handle (2,852) $* Cannot include because it is in another DB
    if !override.not() then
       if (!!alert.confirm('The branch ' & !sourceBran.name & ' is in a different database to the target. You must have full R/W access to all data involved in this operation. Do you wish to continue?') eq 'NO') then
         return
       endif
    endif
    !override = TRUE
    include acrossdb $!sourceMembers[$!i]
     handle ANY
       !!alert.error('Unable to include branch ' & !sourceBran.name & ' into $!targetBran because : ' + !!error.text)
       return
     endhandle
     reorder 1 $!baseLoc
  elsehandle ANY
    !!alert.error('Unable to include branch ' & !sourceBran.name & ' into $!targetBran because : ' + !!error.text)
    return
  endhandle
  enddo

  !!ce = !targetBran
  !tref = !sourceBran.tref
  if !tref.badref().not() then
    conn pt to $!tref
    handle any
      !!alert.error(!!error.text)
    endhandle
  else
   !!ce.tpos  = !sourceBran.tpos
   !!ce.tconn = !sourceBran.tconn
   !!ce.tdir  = !sourceBran.tdir
   !!ce.tbor  = !sourceBran.tbor
  endif

  -- delete the empty branch
  !!ce = !sourceBran
  delete bran

  --CW Fix to accommodate Source pipe with multiple branches

  if (!this.moveComp.val eq 2) then
  	
      if !!ce.mCount('BRAN')gt 0 then
         !!alert.warning('Source Pipe still contains existing Branches!')
         $!!ce
         rem ce add ce colour brightred
       else
           !answer = !!alert.confirm('Do you wish to delete Source Pipe?')
        if !answer.eq('YES') then
            delete PIPE
        else
            return
        endif
      endif
   endif

  handle any
  endhandle

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      getBranchElement
--
-- Description: get branch element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBranchElement(!element is DBREF) is DBREF
  !result = object DBREF()
  if (!element.type NEQ 'BRAN') then
    !result = !element.owner
  else
    !result = !element
  endif

  return !result

endmethod

------------------------------------------------------------------------
--
-- Method:      coordinateSettings
--
-- Description: Setting the format of positional gadgets according to present coordinate system.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coordinateSettings()

   !grid            = object SHIPGRID()
   !gridDefined     = !grid.position.set()
   if(!gridDefined)then
     -- add the ship grid menu option
     !this.posControl.gridvisible(TRUE)
     !this.posControl.gridFormat()
   else
      -- remove the ship grid menu option
      !this.posControl.gridvisible(FALSE)
      var !coord coord
      if (!coord.eq('ENU'))then
        !this.posControl.enuFormat()
      else
        !this.posControl.xyzFormat()
      endif
   endif

 endmethod

-- End of method
-- End of form definition for pipesplitting
