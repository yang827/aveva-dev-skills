------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description: method to measure the distance between flanges (internal method only)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

------------------------------------------------------------------------

define method .measure()

var !a pick flange
var !b pick flan
!flan1 = !a[1].dbref()
!flan2 = !b[1].dbref()

if !flan1.order.gt(!flan2.order) then
   !!ce = !flan2
   !target = !flan1
else
   !!ce = !flan1
   !target = !flan2
endif

!length = 0
do
  !length = !length + !!ce.fitlength + !!ce.ltlen
  next
  if !!ce eq !target then
    !length = !length + !!ce.fitlength
    break
  endif
enddo

!!alert.message('Spool length is $!length')


endmethod
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Method:            splitPipe
--
-- Description:
--    Splits the Pipe/Branch passed - DDC
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF        Picked piping component
--    2   R     STRING       Hierarchy to which the downstream components after
--                            picked component to be moved
--    3   R     REAL         Number used in the Pipe/Branch name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitPipe(!component is DBREF, !moveTo is STRING, !number is REAL)

  if(!component.owner.type ne 'BRAN')then
     !!alert.error('Piping components should be passed')
     return
  endif
  !newNumber  = !number
  !branch     = !component.owner
  !insulation = !component.ispe
  !tailRef    = !branch.tref
  !tailPos    = !branch.tpos
  !pipe       = !branch.owner
  !members    = !branch.members

  --check if the component is the first/last in the list REVISIT THIS **JAIDEEP
  if(!component.sequence eq 1 AND !component.atle eq 0)then
     --!!alert.error('Cannot split at this component')
     return
  endif

  !findComp  = !members.findfirst(!component)

  --if(!component.sequence neq 1 )then
  --   !newLastComp  = !members[!findComp - 1]
  --endif

  !newBranchMem = ARRAY()

  do !i from !members.size() to !findComp by -1
     !newBranchMem.append(!members[!i])
  enddo

  !pipeName   = !pipe.namn

  if(!moveTo eq 'PIPE')then

     if(!pipeName.match( '-Split(' ) gt 0)then
        !pipeName = !pipeName.before('-Split(' )
     endif

     !pipeName   = !pipeName + '-Split($!newNumber)'

     NEW PIPE COPY ATT OF $!pipe
     ispec $!insulation

     -- remove the label command.
     label /rename

     NAME /$!pipeName
     handle (41,12)
        if(!pipeName.match( '-Split(' ) gt 0)then
           !pipeName   = !pipeName.before('-Split(' )
           !newNumber  = !newNumber + 1
           !pipeName   = !pipeName + '-Split($!newNumber)'
           golabel /rename
        else
           !!alert.error('User should rename the newly created pipe $!!ce')
        endif
     endhandle

     !branchName= !pipeName + '/B1'

  elseif(!moveTo eq 'BRANCH')then

     !newBranchNum = !pipe.mCount('BRAN') + 1
     !branchName   = !pipeName + '/B$!newBranchNum'
  else
     return
  endif

  --Autonaming should be done
  NEW BRANCH COPY ATT OF $!branch
  ispec $!insulation
  NAME /$!branchName
  handle ANY
     !!alert.error('User should rename the newly created branch $!!ce')
  endhandle

  !newBranch    = !!ce
  do !i from !newBranchMem.size() to 1 by -1
     INCLUDE $!newBranchMem[$!i]
  enddo
  $!newBranch
  CONN PH TO FIRST MEM
  tref $!tailRef
  tpos $!tailPos
  !hconn = !!ce.hcon

  $!branch
  CONN PT TO LAST MEM
  handle ANY
  elsehandle NONE
    !!ce.tpos = !newBranch.hpos
    handle ANY
    endhandle
  endhandle
  !tconn = !!ce.tcon
  CONN PT TO PH OF $!newBranch
  -- if its a flanged connection we need to sort out the connection return reference
  -- Resolve the flange connection types
  tconn $!hconn
  $!newBranch
  hconn $!tconn
  same


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .processBranches()

  -- sort the branches into order
  if !!pickedElement.size().lt(2) then
     !!alert.error('Not enough branches selected to combine')
  else
     !refs = ARRAY()
     do !a values !!pickedElement
        !refs.append(!a.href)
        !refs.append(!a.tref)
     enddo
     -- check to see that we only have one spare href and one spare tref
     -- otherwise the branches do not continue
     do !a values !!pickedElement
     !found = ARRAY()
       if !refs.find(!a).set() then
          !s = !refs.find(!a)
          do !c values !s
             !found.append(!refs[!c])
          enddo
       endif
     enddo
     --!startFin = !refs.difference(!found)
   endif

endmethod
