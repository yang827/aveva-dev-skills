--
-- Description: sets up the split gadgets for feature/segment splitting
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setSegSplitGadgets(!set is BOOLEAN)

  if !set then
    !this.segment.val = TRUE
    !this.segmentopt.active = TRUE
    !this.splitOptionGadgets('SEGMENT')
    !this.applySplit.active = TRUE
    !this.splitPick = !this.segmentopt.selection()
  else
  	if !this.noAssemblies then
      !this.segment.active = FALSE
    else
  	  !this.segment.active = TRUE
  	endif
    !this.segmentopt.active = FALSE
  endif

endmethod

