--
-- Description:     Form for managing special stub in tees
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  checkSpref()                     BOOLEAN             enables/disables the connect button
--  clearAids()                      -
--  connectionPick(EDGPICKDATA)      -                   Pick item to connect to
--  connectionPick(STRING)           -
--  defaultGadgets(BOOLEAN)          -                   set the form status when shown
--  detailGadgets(BOOLEAN)           -                   set the form status when shown
--  dismiss()                        -                   form dismiss button callback
--  findConnections()                BOOLEAN             find any head and tail connections and delete them
--  fixNewBranch()                   -                   Method to create the new connection and return to edit mode
--  getBranchList()                  -                   Get a list of existing branches
--  getParameters(STRING)            -                   this is the method which is called from the change bore size gadget
--  getStandardBranchConnection(DBREF) BOOLEAN             returns true if it has found a connection
--  getTappingsFromSpec(BOOLEAN)     -
--  getTeeTypes()                    -                   When the user selects the stub in branch we need to
--  getTubeBores(STRING)             -                   get the available tube sizes from the stub in spec
--  getTubePosition(POSITION,DBREF)  PLANE
--  getVectors(DBREF)                ARRAY
--  highlight(DBREF,BOOLEAN)         -
--  init()                           -                   initialisation
--  initialiseVariables()            -                   method to get all the variables from the current connection object
--  initialiseVariables(BOOLEAN)     -                   method to get all the variables from the current connection object
--  pickIntersectionPoint()          -                   Setup EDG mode to pick branch for connecting
--  pickMainBranch(DBREF)            -                   pick the main branch to be connected
--  pickNewBranchPosition(EDGPICKDATA) -                   This is the new method to derive a surface pick going away
--  pickNewBranchPosition(EDGPOSITIONDATA) -
--  pickNewConnectionPoint()         -
--  pickPoint()                      -
--  pickStubInBranch(DBREF,BOOLEAN)  -
--  pipeTappings()                   -
--  resetBranchVariables()           -                   sets the branch connection part of the form
--  runBasicTests(DBREF)             BOOLEAN
--  selectCoupling(REAL)             -                   Method to get the relevant bores passed parameter
--  setBranchBores(DBREF,REAL)       -
--  setConnectedOrNot()              -                   sets the head and tail connection text on the form
--  setConstructionStage(REAL)       -                   manages the gadgets during the progressive build
--  setHeadTailDtext(BOOLEAN)        -
--  setInsert(REAL,STRING)           -                   method called to work out the insert depth for each fitting
--  setNote(STRING)                  -                   method called to set note (description) on PIPCA
--  setOption(BOOLEAN)               -
--  showBranchUpdateForm()           -
--  swapHeadTail()                   -                   method to convert between the connected branch head and tail
--  swapHeadTail(BOOLEAN)            -                   method to convert between the connected branch head and tail
--  swapInsert()                     -                   toggle between the actual insert and the default one.
--  tagBranch(DBREF,STRING)          -                   Tag branch selected in the branch list
--  testForComponents()              -                   method to make sure we have the right components in the database
--  tidy()                           -                   cleanUp any created items when the form is dismissed
--  tidyFromNewBranch()              -                   method to realign the branch connection gadgets after
--  updateCoupling()                 -
--

--
------------------------------------------------------------------------

setup form !!pipeTappings VarChars NoAlign

   !!pipeTappings.formTitle     = 'Non-standard Branch Connections'
   !!pipeTappings.iconTitle     = 'Tappings'
   !!pipeTappings.callback      = '!!pipeTappings.init()'
   !!pipeTappings.formRevision  = ' $Revision: 1.0 $ '
   !this.cancelcall   = '!this.dismiss()'

   -- store the current pipe to be able to add branches to it
   member .pipe is DBREF
   --Hold branch to be connected into
   member .mainBranch is DBREF
   -- Hold a list of branches
   member .branches is ARRAY
   -- Hold new branch details
   member .newBranch is DBREF
   --Hold Branch to be connected
   member .connectedBranch is DBREF
   --Hold end to be connected head or tail (true False)
   member .connectedEnd is STRING
   -- hold end to be picked
   member .edgSelection is STRING
   -- the spec from which the tees are derived.
   -- currently this is the spec of the main branch
   member .teeSpec is DBREF
   member .couplingComponents is COUPLINGLIST

   member .headComponent     is PIPETAPPINGCONNECTION
   member .tailComponent     is PIPETAPPINGCONNECTION
   member .currentConnection is PIPETAPPINGCONNECTION
   -- not used?
   -- member .surfacePick       is PIPEINTERSECTION

   -- tagging numbers
   member .tagStubHead                  is REAL
   member .tagStubTail                  is REAL
   member .tagMainHead                  is REAL
   member .tagMainTail                  is REAL
   member .branchCylinder               is REAL
   member .objectTags                   is REAL

   member .hcomp is DBREF
   member .tcomp is DBREF

   -- description of current active EDG operation
   member .edgDescription      is STRING
   member .undo                is UNDOABLE
   member .tempUndo            is UNDOABLE

   member .couplingSelected is BOOLEAN

   member .availableTypes   is TAPPINGLISTSELECTOR

   frame .mainBranchFrame 'Main Branch' at xMin yMin
      path down
      halign left
      vdist 0
      hdist 0

      button .pickMain linklabel  'Select' callback  '!this.connectionPick(|Main Branch|)' width 6
      valign centre
      path right
      paragraph .mainName   width 50
      paragraph .mainBore at xmin .pickMain ymax+0.2  width 14
      paragraph .wallThickness  width 25
   exit

   button .warningButton at xmax.mainBranchFrame+2 ymin.mainBranchFrame+1 pixmap "StandardIcons>ID_WARNING>16" tooltip 'Warning' callback |!!alert.warning('The insertion depths calculated by this application are for centre line intersections in tube - All other intersections should be checked by the user')|

   path down
   toggle .newOld 'Connect Existing Branch' at xmin.pickMain callback         '!this.setOption(true)'
   path right
   toggle .oldNew 'Create New Branch'  at xmax ymin  callback '!this.setOption(false)'

   frame .stubInBranchFrame 'Select Branch' at xmin.mainBranchFrame ymax.oldNew
      path down
      halign left
      vdist 0
      hdist 0
      button .pickStubIn linklabel 'Select'  at xmin ymax callback '!this.connectionPick(|Stub in Branch|)'
      path right
      valign centre
      paragraph .stubInName   at xmax.pickStubIn  width 50
      paragraph .branchBore   at xmax.stubInName  width 10
      path down

      frame .connections 'Current connection details' at xmin .pickStubIn ymax .pickStubIn
        vdist 0.2
        paragraph .headConnectedOrNot at xmin.connections width 65
        paragraph .tailConnectedOrNot width 65
        vdist 0.2
      exit
   exit

   frame .newBranchframe  'Create New Branch' at xmin.mainBranchFrame ymax.oldNew width to max.stubInBranchFrame

      text .branchName 'Branch Name' tagwidth 11  callback |!!nameGadget(!!pipeTappings.branchName, 'NEW')| width 53 is STRING
      button .pickPoint  'Pick connection Point ' callback '!this.pickNewConnectionPoint()'
      path right
      button .adjust  'Adjust position...'   callback 'show !!specialBranchDirection'
      button .done 'Done..'  callback '!this.fixNewBranch()'
   exit

   frame .branchDetails 'Connection Details'  at xmin.stubInBranchFrame ymax.stubInBranchFrame width to max.stubInBranchFrame
      option .boreSize 'Bore Size '  at xmin.pickStubIn ymax tagwidth 11 call |!this.getParameters(!this.boreSize.selection('dtext'))| width 14
      path right
      text   .branchInsert 'Insert Depth (Default)' tagwidth 15 callback '!this.setInsert(!this.branchInsert.val,|Insert Depth (User)| )' width 14 is REAL format !!distanceFmt
      button .toggleInsert 'Default'   callback '!this.swapInsert()'

      option .stubInType 'Branch Type ' at xmin.pickStubIn ymax tagwidth 11 call '!this.getTubeBores(!this.stubInType.selection())' width 21
      path right
      option .connectedEndOption 'Connected End' tagwidth 11 callback '!this.swapHeadTail()' width 15
      path down
      option .couplingType 'Tapping Type' at xmin.stubInType  tagwidth 11 call |!this.selectCoupling(!this.couplingType.val)| width 51
      path down
      text   .connectionNote 'Note'  tagwidth 11 callback '!this.setNote(!this.connectionNote.val)' width 53 is STRING

   exit

   button .apply ' Apply ' at Xmin.stubInBranchFrame Ymax callback '!this.apply()'
   button .dismiss ' Dismiss ' at xmax form - size ymin callback '!this.dismiss()'

exit
-- End of form definition for !!pipeTappings
------------------------------------------------------------------------
--
-- Method:      !pipeTappings()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pipeTappings()

-- Aid graphic numbers

  !this.tagStubHead       = !!aidNumbers.add('Branch Tagging')
  !this.tagStubTail       = !!aidNumbers.add('Branch Tagging')
  !this.tagMainHead       = !!aidNumbers.add('Branch Tagging')
  !this.tagMainTail       = !!aidNumbers.add('Branch Tagging')
  !this.branchCylinder    = !!aidNumbers.add('Branch cylinder')
  -- Aid Tags
  !this.objectTags        = !!aidNumbers.add('Branch Manipulation')


  !this.couplingSelected = FALSE
 -- !bore[1] = 'unset'
  --!this.boreSize.dtext = !bore

endmethod
-- End of method definition for .pipeTappings()
------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
------------------------------------------------------------------------
define method .init()

     -- test to see if we have the right database components
     !this.testForComponents()

     -- remove any aid graphics
     !this.clearAids()

     -- clear the display texts
     !this.mainBranch = object DBREF()
     !this.mainName.val = ''
     !this.pickMain.tag = 'Select  '
     !this.mainBore.val = ''
     !this.wallThickness.val = ''

     -- initialise
     !this.resetBranchVariables()

     -- set the basic dtext
     !this.availableTypes = object TAPPINGLISTSELECTOR(!this.stubInType,!this.boreSize,!this.couplingType )

     -- set the form up for connecting an existing branch
     !this.setOption(true)

     !this.currentConnection = object PIPETAPPINGCONNECTION()

endmethod
-- End of method definition for .init()


------------------------------------------------------------------------
--
-- Method:      .resetBranchVariables()
--
-- Description: sets the branch connection part of the form
--
------------------------------------------------------------------------
define method .resetBranchVariables()

 -- reset the branch variables
     !this.branchBore.val = ''
    !this.pickStubIn.tag = 'Select  '
    !this.currentConnection.connectedBranch = object DBREF()
    !this.stubInName.val = ''
    !this.headConnectedOrNot.val = ''
    !this.headConnectedOrNot.val = ''
    !this.connectedEndOption.dtext = ARRAY()
    -- reset the form variables
    !this.defaultGadgets(FALSE)
    !this.detailGadgets(FALSE)

endmethod

------------------------------------------------------------------------
--
-- Method:      .setOption(!mode is BOOLEAN  )
--
-- Description: set the form status when shown - new option to allow new branch
-- connections from the main branch outwards.
-- If mode is true it sets the form up in existing connection mode
-- if false it sets up a new branch and sets the branch name
--
------------------------------------------------------------------------
define method .setOption(!mode is BOOLEAN  )

  -- stubIn branch frame is the standard insert frame
  !this.stubInBranchFrame.visible = !mode
  -- new branch frame is the frame for setting the branch name
  -- and showing the pick position and adjustment buttons
  !this.newBranchframe.visible = !mode.not()
  -- reset the toggles
  !this.newOld.val = !mode
  !this.oldNew.val = !mode.not()
  -- mode.not() means its a new branch so create a basic pipe tapping - unconnected.
  if !mode.not() then
    !this.detailGadgets(FALSE )
    !this.boreSize.active = TRUE
    !this.currentConnection = object PIPETAPPINGCONNECTION(!this.mainBranch,!this.stubInType.selection('rtext'),!this.boreSize.selection('dtext'))
    !this.branchName.val = !this.currentConnection.newBranchname
    !this.couplingType.active = FALSE
    !this.boreSize.active = TRUE
    !this.setHeadTailDtext(FALSE)
    !this.setConstructionStage(1)
    return
  endif

  if  !this.stubInType.val.lt(5) then
      !this.couplingType.active = FALSE
      --!this.boreSize.active = FALSE
  else
      !this.couplingType.active = TRUE
      --!this.boreSize.active = FALSE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .setConstructionStage(!stage is REAL)
--
-- Description: manages the gadgets during the progressive build
--
--
------------------------------------------------------------------------
define method .setConstructionStage(!stage is REAL)

if !stage.eq(1) then
  -- we have a basic branch but there is no head and tail
  -- aborting from this should remove the branch
   !this.pickPoint.active = TRUE
   !this.adjust.active = FALSE
   !this.done.tag = 'Back'
elseif !stage.eq(2) then
  -- we have a branch because we have picked a position
  -- aborting from here should delete the existing branch
   --!this.pickPoint.active = FALSE
   !this.adjust.active = TRUE
   !this.done.tag = 'Done'
elseif !stage.eq(3) then
  -- we have a branch and we have shown the adjust form
  -- at this point we should no longer be able to adjust the pick
   !this.pickPoint.active = FALSE
   !this.adjust.active = TRUE
   !this.done.tag = 'Done'
else
   -- its stage 4
   -- We have pressed dismiss
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .defaultGadgets()
--
-- Description: set the form status when shown with only one gadget active
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .defaultGadgets(!action is BOOLEAN)

    --!this.stubInBranchFrame.active = !action
    --!this.componentSelection.active = !action
    !this.newOld.active = !action
    !this.oldNew.active = !action
    !this.pickStubIn.active = !action
    !this.apply.active = !action
    !this.branchInsert.val = 0
    !this.stubInName.val = ''
    !this.connectionNote.val = ''
    !this.headConnectedOrNot.val = ''
    !this.tailConnectedOrNot.val = ''
    !this.pickStubIn.tag = 'Select  '
    !this.connectedEndOption.dtext = ARRAY()
    !this.stubInType.val = 1
    handle ANY
    endhandle

    if !action then
     !this.couplingComponents = object COUPLINGLIST(!this.mainBranch.pspe, !this )
     handle any
     endhandle
    endif

endmethod
-- End of method definition for defaultGadgets()

------------------------------------------------------------------------
--
-- Method:      .detailGadgets()
--
-- Description: activate/deactivate the branch detail gadgets
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .detailGadgets(!action is BOOLEAN)

   !this.branchInsert.active        = !action
   !this.connectedEndOption.active  = !action
   !this.stubInType.active          = !action
   !this.couplingType.active        = !action
   !this.boreSize.active            = !action
   --!this.toggleInsert.active        = !action
   !this.connectionNote.active      = !action
   !this.apply.active             = !action


endmethod
-- End of method definition for detailGadgets()
------------------------------------------------------------------------
--
-- Method:      checkSpref()
--
-- Description: enables/disables the connect button
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .checkSpref() is BOOLEAN

  !this.apply.active = TRUE
  return TRUE

  --if !this.currentConnection.teeSpref.unset() then
    -- we can't make a connection at this size so disable the connect button
    --!!alert.error('Branch $!this.currentConnection.headOrTail cannot be connected using this type of component')
    --!this.branchInsert.val = 0
    --!this.apply.active = FALSE
    --return FALSE
  --else
    --!this.apply.active = TRUE
    --return TRUE
  --endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .clearAids()
--
-- Description: remove the graphical aids
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clearAids()

    AID CLEAR ALL $!<this.tagMainHead>
    handle any
    endhandle
    AID CLEAR ALL $!<this.tagMainTail>
    handle any
    endhandle
    AID CLEAR ALL $!<this.tagStubHead>
    handle any
    endhandle
    AID CLEAR ALL $!<this.tagStubTail>
    handle any
    endhandle
    AID CLEAR ALL $!<this.branchCylinder>
    handle any
    endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      !connect()
--
-- Description: callback for the connect/reconnect button
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .apply()

if !this.stubInType.val.eq(5) then
	!loopTo = 2
else
	!loopTo = 1
endif

do from 1 to !loopTo

 if !this.currentConnection.set() then
    !this.undo.description('Start of Connect')
    !this.undo.add()
    !this.currentConnection.insertDepth = !this.branchInsert.val

    if !this.couplingSelected.not() then
      !this.currentConnection.setInsert(!this.branchInsert.val)
    endif

    !this.currentConnection.connect()
    forwards
    !this.undo.endUndoable()
     !this.currentConnection.drawFitting(TRUE,!this.branchCylinder,!this.branchInsert.val.real())
    !this.tagBranch(!this.currentConnection.connectedBranch,'STUB')
 endif

 if !this.oldNew.val then
   -- We have created a new branch
   !this.setOption(TRUE)
 endif
 forwards
 if !this.connectedBranch.badref() then
   !!alert.error('Please select a branch to connect')
   return
 endif
 !this.pickStubInBranch(!this.connectedBranch,TRUE )

 !this.couplingSelected = FALSE

enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      pickStubInBranch()
--
-- Description: pick the stub in branch to be connected
-- override skips the basic tests
--
--
------------------------------------------------------------------------
define method .pickStubInBranch(!pickedBranch is DBREF,!override is BOOLEAN )

 !bore = !pickedBranch.hBore
 !this.branchBore.val = 'Bore $!bore'

 if !override.not() then

    if !this.runBasicTests(!pickedBranch).not() then
      -- initialise all of the objects and check for obvious errors
      -- at this point none of the three PIPETAPPINGCONNECTION objects are initialised
      return
    endif

endif

-- fires in a ray line which intersects tube or a component
   !this.currentConnection.connectedBranch = !pickedBranch

   !this.connectedBranch = !pickedBranch

   !this.stubInName.val = !pickedBranch.flnm

   --!this.setHeadTailVisibility(TRUE)
   handle ANY
     !this.mainName.val = ''
     !this.pickMain.tag = 'Select  '
   endhandle
   !this.pickStubIn.tag = 'Reselect'
   !this.tagBranch(!pickedBranch,'stub')

   -- if the branch is not already connected then do the
     -- standard intersection an positioning tests
   if !this.getStandardBranchConnection(!pickedBranch).not() then
     !!alert.error('Could not find a suitable connection point for branch $!this.stubInName')
     !this.stubInName.val = ''
     return
   endif

   -- this code should not be needed if the main constructor was updated to test connections

   -- go and see if either end has been connected this method returns true or false but this not required now
   if !this.findConnections() then
     --  we have an existing connection we need to deal with it here
     !this.availableTypes.getavailableTypes(!this.currentConnection.mainBore,!this.currentConnection.p3Bore)
     !this.stubInType.select('RTEXT',!this.currentConnection.componentType)
     handle ANY
       !!alert.error('Current Component Type $!this.currentConnection.componentType is not allowed in this Specification')
       !this.stubInType.val = 1
       handle ANY
       endhandle
     endhandle

   endif

   -- go and set the dtext of the head tail option - this relates to head and tailComponent objects being set.
   !this.setHeadTailDtext(TRUE)

   -- go and set the form up
   !this.initialiseVariables()

   !this.detailGadgets(TRUE)

  if  !this.stubInType.selection().eq('TAP')then
      !this.couplingType.active = TRUE
      !this.couplingComponents = object COUPLINGLIST(!this.connectedBranch.pspe, !!pipeTappings, !this.currentConnection.p3bore )
      !this.couplingComponents.populatecomponents()
      if !this.currentConnection.couplingspref.set() then
        !this.couplingType.select('rtext',!this.currentConnection.couplingspref.string())
          handle ANY
            !!alert.error('Cannot find the current type in the list of available connections. Please reselect from the current list')
          endhandle
        endif
  else
      !this.couplingType.active = FALSE
  endif

   !this.setConnectedOrNot()
   !this.wallThickness.val = 'Wall Thickness ' & !this.currentConnection.wallThickness.string()
   --!this.boreSize.active = FALSE
   !bore = !this.currentConnection.mainBore
   !this.mainBore.val = 'Bore $!bore'
    handle ANY
    endhandle

  refresh

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .getStandardBranchConnection(dbref)
--
-- Description: returns true if it has found a connection
--
--
------------------------------------------------------------------------
define method .getStandardBranchConnection(!pickedBranch is DBREF) is BOOLEAN


   -- new method for finding if the picked branch intersects the main branch
   -- first work out the vector for the head and tail
   !vectors = !this.getVectors(!pickedBranch)
   -- !vectors always returns two vectors 1 is the head and 2 is the tail
   -- there might be a problem if the heads and tails are not set
   !return = FALSE
   !headVector = !vectors[1]
   !tailVector = !vectors[2]

   !comp = object PIPETAPPINGCONNECTION()
   !comp.mainBranch = !this.mainBranch
   !headArray = !comp.getInsertComponentAndPosition(!headVector )

   if !headArray.set() then
     !vector = !headArray[1][4]
     !vector.direction = !headVector.direction.opposite()
     !this.headComponent = object PIPETAPPINGCONNECTION(!this.mainBranch,!headArray[1][3],!headArray[1][1],'HEAD',!vector,!pickedBranch,!this.stubInType.selection())
     -- the returned pointvector gives the position and direction of the intersection point
     !return = TRUE
   endif
   !tailArray = !comp.getInsertComponentAndPosition(!tailVector )
   if !tailArray.set() then
     !vector = !tailArray[1][4]
     !vector.direction = !tailVector.direction.opposite()
     !this.tailComponent = object PIPETAPPINGCONNECTION(!this.mainBranch,!tailArray[1][3],!tailArray[1][1],'TAIL',!vector,!pickedBranch,!this.stubInType.selection())
     -- the returned pointvector gives the position and direction of the intersection point
     !return = TRUE
   endif

   return !return

endmethod

------------------------------------------------------------------------
--
-- Method:      pickMainBranch()
--
-- Description: pick the main branch to be connected
--
--
------------------------------------------------------------------------
define method .pickMainBranch(!pickedBranch is DBREF)

    !wall = !pickedBranch.hwallt
    handle ANY
      !wall = 'unset'
    endhandle
    !this.wallThickness.val = 'Wall Thickness ' & !wall.string()

    if !this.mainBranch.set() then
      !this.highlight(!this.mainBranch,FALSE)
    endif

    if !pickedBranch.eq(!this.mainBranch) then
       !!alert.error('this branch is already selected')
    else
        -- check if the branch can be written to
        if !!dbRefUpdatable(!pickedBranch).not() then
          !!alert.error('You are unable to modify this branch - $!!error.text')
          !this.defaultGadgets(FALSE)
          !this.detailGadgets(FALSE)
          return
        endif
    endif

    -- P-34080 added to warn of unset hstu
    if !pickedBranch.hstu.unset().or(!pickedBranch.hstu.badref()) then
        !!alert.error('Branch has unset Head Tube(HSTU) - Please set this and try again')
        !this.defaultGadgets(FALSE)
        !this.detailGadgets(FALSE)
        !this.mainName.val = ''
        !this.pickMain.tag =  'Select   '
    endif

    !this.mainBranch = !pickedBranch
    !this.mainName.val = !pickedBranch.flnm
    handle ANY
     !this.mainName.val = ''
     !this.pickMain.tag =  'Select   '
    endhandle

    !this.pickMain.tag = 'Reselect'
    --!this.tag(!pickedBranch)
    !this.tagBranch(!pickedBranch,'main')

    if !this.mainBranch.pspe.badref() then
      !!alert.error('Selected branch has no pipe spec - please set this and try again.')
      return
    endif
    !this.teeSpec = !pickedBranch.pspec

    -- if there are any errors getting default tees then we need to
    -- issue an error here and stop the gadgets being activated.

    -- later

    -- activate the remaining form gadgets now that we have a main branch
    !this.defaultGadgets(TRUE)

    !this.availableTypes.setBranchTable(!this.mainBranch)
    handle ANY
      !this.init()
      return
    endhandle

    -- set up the bores and component diameters
    --!this.boreSize.dtext = !this.availableTypes.findBoreSizes(!this.mainBranch)
    !this.boreSize.dtext = !this.availableTypes.getLowerBores()

    !bore = !this.availableTypes.maxBore
    !this.mainBore.val = 'Bore $!bore'
    handle ANY
     !this.mainBore.val = 'unset'
    endhandle

      -- go and look at the spec to see if there are any tees of the right type
    !this.getTeeTypes()

    !this.highlight(!this.mainBranch,TRUE)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      findConnections()
--
-- Description: find any head and tail connections and delete them
--
--
------------------------------------------------------------------------
define method .findConnections() is BOOLEAN

    !return = FALSE
    if !this.connectedBranch.tref.set() then
        if !this.connectedBranch.tref.type inset('PIPCA','PTAP') then
            if !this.connectedBranch.tref.owner.eq(!this.mainBranch) or !this.connectedBranch.tref.owner.owner.eq(!this.mainBranch) then
                -- the branch tail is already set
                !this.tailComponent = object PIPETAPPINGCONNECTION(!this.connectedBranch.tref,!this.connectedBranch)
                !return = TRUE
                !this.currentConnection = !this.tailComponent
            endif
        endif
    endif

    if  !this.connectedBranch.href.set() then
        -- the branch tail is already set
       if !this.connectedBranch.href.type inset('PIPCA','PTAP') then
            if !this.connectedBranch.href.owner.eq(!this.mainBranch) or !this.connectedBranch.href.owner.owner.eq(!this.mainBranch) then
                !this.headComponent = object PIPETAPPINGCONNECTION(!this.connectedBranch.href,!this.connectedBranch)
                !this.currentConnection = !this.headComponent
                !return = TRUE
            endif
        endif
    endif


   return !return

endmethod
------------------------------------------------------------------------
--
-- Method:      connectionPick
--
-- Description: Pick item to connect to
--
--
------------------------------------------------------------------------
define method .connectionPick( !pickBranch is STRING )

  !this.detailGadgets(FALSE)
  !this.edgSelection = !pickBranch
  --'Stub in Branch'
  -- Initialise Variables

  -- Define EDG Packet
  !packet                 = object EDGPACKET()
  !packet.elementPick('Identify $!pickBranch:')
  !packet.description     = !pickBranch

  -- When the component has been created successfully
  !packet.remove          = true
  !packet.priority        = 2
  !packet.action          = '!!pipeTappings.connectionPick(!this.return[1])'

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      connectionPick
--
-- Description: pick either the main branch or the sub branch
--
--
------------------------------------------------------------------------
define method .connectionPick(!data is  EDGPICKDATA)

  -- Initialise Variables
  --!edgType    = !data.type
  !type       = !data.item.type
  if !type.eq('BRAN') then
     !element  = !data.item

  else
     !element  = !data.item.owner
  endif


   -- Process element
  if(undefined(!element)) then
    !element = object DBREF()
  endif

 if !this.edgSelection.eq('Stub in Branch') then
      !this.pickStubInBranch(!element,FALSE)
 else
      !this.pickMainBranch(!element)
 endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      tagBranch
--
-- Description: Tag passed branch head main or sub branch
--
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagBranch(!branch is DBREF,!branchType is STRING)

  -- Initialise Variables
  if !branchType .eq('main') then
    AID CLEAR ALL $!<this.tagMainHead>
    !tagHead = !this.tagMainHead
    AID CLEAR ALL $!<this.tagMainTail>
    !tagTail = !this.tagMainTail
  else
    AID CLEAR ALL $!<this.tagStubHead>
    !tagHead = !this.tagStubHead
    AID CLEAR ALL $!<this.tagStubTail>
    !tagTail =!this.tagStubTail
  endif
  -- End information
  !headText      = 'Head'
  !tailText      = 'Tail'

  -- Position
  !hPosition     = !branch.hPosition.wrt(World)
  !tPosition     = !branch.tPosition.wrt(World)
  -- Direction
  !hDirection    = !branch.hDirection.wrt(World)
  !tDirection    = !branch.tDirection.wrt(World)

  -- hBore
  !hBore         = !branch.hBore
  if(!hBore.unset()) then
    !height     = 100mm
  else
    !height     = !hBore.real() * 2
   -- tBore
  endif
  !tBore         = !branch.tBore
  if(!tBore.unset()) then
    !height     = 100mm
  else
    !height     = !tBore.real() * 2
  endif

  -- Aid headInformation
  !arrowPosition    = !hPosition.offset(!hDirection.opposite(), !height)
  AID ARROW NUMBER $!<tagHead> AT $!<arrowPosition> DIRECTION $!<hDirection> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<tagHead> '$!headText' AT $!<arrowPosition>
 -- Aid tailInformation
  !arrowPosition    = !tPosition.offset(!tDirection.opposite(), !height)
  AID ARROW NUMBER $!<tagTail> AT $!<arrowPosition> DIRECTION $!<tDirection> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<tagTail> '$!tailText' AT $!<arrowPosition>

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      connectionPick
--
-- Description: Pick item to connect to for stub in branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPoint( )

  --'Stub in Branch'

  -- Initialise Variables
  -- Define EDG Packet
  !packet                 = object EDGPACKET()
  !packet.elementPick('Pick intersection point')
  !packet.description     = 'pick a point'
  !packet.pickPacket.picks[1].pick.stdGraphics()

  -- When the component has been created successfully
  !packet.remove          = true
  !packet.priority        = 2
  !packet.action          = '!!pipeTappings.pickPoint(!this.return[1])'

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      method .getTubePosition
--
-- Description: method to orientate the plane according to the pick direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTubePosition(!pickPosition is POSITION, !element is DBREF) is PLANE

   !finalPlane = object PLANE()
   -- need to handle branch tube
   if !element .type.eq('BRAN') then
      !lpos = !element.hpos.wrt( /* )
      !ldir = !element.hdir.wrt( /* )
   else
      !lpos = !element.lpos.wrt( /* )
      !ldir = !element.ldir.wrt( /* )
   endif
   !leavePV = object POINTVECTOR()
   !leavePV.position = !lpos
   !leavePV.direction = !ldir
   !centreLinePV = !leavePV.through(!pickPosition)
   !finalPlane = !centreLinePV.plane()

   return !finalPlane

endmethod
------------------------------------------------------------------------
--
-- Method:      .getTubeBores
--
-- Description: get the available tube sizes from the stubIn spec
-- and populate the bore gadget on the form stubIn type can be:
--             !dtext[1] = 'Insert Connection'
-- 'STU' 'SSU' 'SSA' 'SEX' 'TAP'
-- if its a tapping it needs to go and look for some couplings
-- this is called from selecting the current coupling type
--
------------------------------------------------------------------------
define method .getTubeBores(!stubInType is STRING)

  if !this.currentConnection.connectedBranch.unset() then
    --branch is unset
    return
  endif

  if !this.currentConnection.componentortube.eq('TUBE') and !!pipingsettings.nonstandardbranchnotube then
     if !this.stubInType.selection().eq('TAP') then
        !!alert.error('Boss Connections are not allowed in tube - resetting to Insert Connection')
        !this.stubInType.val = 1
        !this.getTubeBores(!this.stubInType.selection('rtext'))
     endif
     return
  endif

  !this.currentConnection.componentType = !stubInType

  if !stubInType.eq('TAP') then
    -- at this point we need to populate the list of available components
    !this.couplingComponents = object COUPLINGLIST(!this.connectedBranch.pspe, !!pipeTappings, !this.currentConnection.p3bore )
    !this.couplingComponents.populatecomponents()
   --!this.availableTypes.gettappings(!this.boreSize.selection().bore(),!this.connectedBranch.pspe)
    !this.couplingType.active = TRUE
    if !this.couplingType.dtext.size().eq(1) then
        !!alert.error('Cannot find any Boss Connection Couplings for specification ' & !this.connectedBranch.pspe.name & ' - resetting to insert connection')
        !this.stubInType.val = 1
        !this.getTubeBores(!this.stubInType.selection('rtext'))
        return
     endif
     --!this.boreSize.dtext = !this.availableTypes.findBoreSizes(!this.mainBranch)
    -- handle ANY
    -- endhandle

    -- !this.boreSize.active = TRUE

     --!this.boreSize.select('dtext',!this.currentConnection.p3bore.string())
     --handle ANY
       --!this.boreSize.active = FALSE
     --endhandle

     !this.currentConnection.updateParameters(!stubInType, TRUE )
     handle ANY
       !this.branchInsert.val = 0
     endhandle

     !this.branchInsert.val = !this.currentConnection.insertDepth

     if !this.couplingType.dtext.size().gt(1) then

     	  if !this.currentConnection.coupling.set() then
     	
     	    !index = !this.couplingType.rtext.findfirst(!this.currentConnection.coupling.catref.own.string())
     	    if !index.set() then
     	      !this.couplingType.val = !index
     	    else
            !this.couplingType.val = 2

          endif

        else
      	  !this.couplingType.val = 2
      	endif
        -----------------------------------------------------------------------
        -- this is where we need to get the proper coupling if there is one
        -----------------------------------------------------------------------

        --own of catref match to rtext of gadget to select

        !this.couplingComponents.fillBores(!this.couplingType.val)
     endif

     !this.boreSize.select('dtext',!this.currentConnection.p3bore.string())

  else
     -- its a normal tube type
     -- find the boreSizes associated possible from the main branch
     !this.boreSize.dtext = !this.availableTypes.findBoreSizes(!this.mainBranch)
     handle ANY
     endhandle
     -- select the current branch size
     !this.boreSize.select('dtext',!this.currentConnection.p3bore.string())
     handle ANY
     endhandle
     -- prompt to delete the existing coupling
     if !this.currentConnection.coupling.badref().not() then
       if !!alert.confirm('Do you Want to delete the existing coupling?').eq('YES') then
          !!ce = !this.currentConnection.coupling
          delete coupling
          !this.currentConnection.coupling = object DBREF()
       else
         !this.stubInType.val = 5
         return
       endif
     endif

     -- set the coupling list to none
     --!this.couplingType.val = 1
     !this.couplingType.active = FALSE
     --!this.boreSize.active = FALSE
     !this.currentConnection.chei = 150mm
     !this.currentConnection.cdia = !this.currentConnection.stubInTubeOD
     !this.currentConnection.flen = 0
  endif

  -- because we have changed the type of the connection we need to reset the
  -- insert depth to suit the

   -- this resets the insert depth to default but it makes it work otherwise

  !this.currentConnection.getDefaultPositions()
  !this.branchInsert.val = !this.currentConnection.defaultInsertDepth
  !this.toggleInsert.tag = 'Default'
  !this.toggleInsert.active = FALSE

  if !this.currentConnection.coupling.set() then
    !this.currentConnection.getConnectionProperties(!this.currentConnection.coupling,FALSE)
  endif

  !this.currentConnection.drawFitting(TRUE,!this.branchCylinder,!this.branchInsert.val.real())

endmethod
------------------------------------------------------------------------
--
-- Method:      .updateCoupling()
--
-- Description: When the user selects the stub in branch we need to
-- get all of the tee types available in that spec.
-- the tee types need to have a compType of 'STUB','BOSS' or 'TAPI'
-- we may need to add new tee types in future. This is where they will be added.

--
------------------------------------------------------------------------
define method .updateCoupling()

  !this.boreSize.select('dtext',!this.currentConnection.p3bore.string())
  handle ANY
         !this.boreSize.active = FALSE
  endhandle
  -- now get the CDIA, CHEI and FLEN (fitting length p1 to p2)
  !parameters = !this.couplingComponents.getParameters(!this.boreSize.selection('rtext'))
  !this.currentConnection.chei = !parameters[1]
  !this.currentConnection.cdia = !parameters[2]
  !this.currentConnection.flen = !parameters[3]
  !this.currentConnection.getDefaultPositions()
  !this.currentConnection.drawFitting(TRUE,!this.branchCylinder,!this.branchInsert.val.real())


endmethod
------------------------------------------------------------------------
--
-- Method:      .getTeeTypes()
--
-- Description: When the user selects the stub in branch we need to
-- get all of the tee types available in that spec.
-- the tee types need to have a compType of 'STUB','BOSS' or 'TAPI'
-- we may need to add new tee types in future. This is where they will be added.

--
------------------------------------------------------------------------
define method .getTeeTypes()

   if !this.teeSpec.unset() then
      --teeSpec is not set
      return
   endif

   -- now we need to work out if we have restrictions on the tapping types
   --!this.availableTypes = object TAPPINGLISTSELECTOR(!this.mainBranch,!this.stubInType)

endmethod

------------------------------------------------------------------------
--
-- Method:      .getTappingsFromSpec
--
-- Description: coll all of the couplings with a COMPTYPE eq 'TAPP'
--
------------------------------------------------------------------------
define method .getTappingsFromSpec(!test is BOOLEAN )

if !test.not() then
  return
endif

--this doesn't do anything

var !a coll all spco with COMPTYPE of catref eq 'TAPP' for $!this.teeSpec
var !b eval dtxr for all from !a
!b.unique()
!b.insert(1,'None')
!this.couplingType.dtext = !b
var !c evaluate p1 bore for all from !a
!c.unique()

--!this.boreSize.dtext = !c

endmethod
------------------------------------------------------------------------
--
-- Method:      pickIntersectionPoint()
--
-- Description: Setup EDG mode to pick branch for connecting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickIntersectionPoint()

  -- Define EDG packet for picking elements
  !packet = object EDGPACKET()
  !packet.elementPick('Pick penetrated item')
  !this.edgDescription = 'Pick penetrated item'
  !packet.description  = !this.edgDescription

   -- Add filter for Pick
  !packet.pickPacket.picks[1].pick.input[3]   = |OWNER eq & !this.mainBranch|
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !packet.action          = '!!pipeTappings.intersectionCheck(!this.return[1])'
  !packet.escape          = '!!pipeTappings.tidy()'
  !packet.priority        = 1
  !packet.remove          = false

  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
-- Method:      tidy()
-- Description: cleanUp any created items when the form is dismissed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .tidy()

  if( !this.edgDescription.empty().not() ) then
    !!edgCntrl.remove(!this.edgDescription)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      .setInsert()
-- Description: method called to work out the insert depth for each fitting
-- This is called from manually setting the insert but needs to be called
-- as part of the component selection process
--
--
--
------------------------------------------------------------------------
define method .setInsert(!value is REAL,!text is STRING)

-- this is a method for setting the insert but needs completing
-- the passed value is the setting for the modified insert depth
-- and we need to modify the appropriate position values and redraw the
-- component

  if !value.unset() then
    !!alert.error('Please enter an insert value')
    return
  endif
  -- modify the object
  !this.currentConnection.setInsert(!value)
  -- if we have a coupling we need to draw it
  if !this.checkSpref() then
     -- now we need to draw something
     !this.currentConnection.drawFitting(TRUE,!this.branchCylinder,!this.branchInsert.val.real())
  endif
  !num = !this.currentConnection.defaultInsertDepth
  handle ANY
    !num = 0
  endhandle

  -- we have now set the insert value so now e need to mange the form
 -- !this.toggleInsert.tag   = 'Default'
  !this.branchInsert.tag = !text
  !this.toggleInsert.setToolTip('Use the insert default value of $!num')
  !this.toggleInsert.active = TRUE

endmethod

------------------------------------------------------------------------
-- Method:      .getVectors()
-- Description: return an array of POINTVECTORs based on the head and tails of the passed branch
--
------------------------------------------------------------------------
define method .getVectors(!branch is DBREF)is ARRAY

  !vectors = ARRAY()
  -- if the head an tails have position and direction, use their vectors to derive a position
  if !branch.members.size().gt(0) then
    !comp1Vector = object POINTVECTOR()
    !comp1Vector.direction = !branch.members[1].adir.wrt(/* )
    !comp1Vector.position  = !branch.members[1].apos.wrt(/* )
    !vectors.append(!comp1Vector)
    !compNVector = object POINTVECTOR()
    !compNVector.position  = !branch.members[!branch.members.size()].lpos.wrt(/* )
    !compNVector.direction = !branch.members[!branch.members.size()].ldir.wrt(/* )
    !vectors.append(!compNVector)
  else
    !headVector = object POINTVECTOR()
    !headVector.position = !branch.hpos.wrt(/* )
    !headVector.direction = !branch.hdir.wrt(/* ).opposite()
    !vectors.append(!headVector)
    !tailVector = object POINTVECTOR()
    !tailVector.position = !branch.tpos.wrt(/* )
    !tailVector.direction = !branch.tdir.wrt(/* ).opposite()
    !vectors.append(!tailVector)
  endif

return !vectors

endmethod

------------------------------------------------------------------------
-- Method:      .dismiss
-- Description: form dismiss button callback
--
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .dismiss()

  -- kill the new branch if not required
  !this.fixNewBranch()

  -- remove all the aid graphics
  !this.clearAids()
  if defined (!!specialBranchDirection) then
     if !!specialBranchDirection.shown() then
      !!specialBranchDirection.dismiss()
     endif
  endif
  if !this.mainBranch.unset().or(!this.connectedBranch.unset()) then
    !this.hide()
    return
  endif

  -- hide the form
  !this.hide()
  -- may need to be more specific at some point
  unenhance all

endmethod
------------------------------------------------------------------------
-- Method:      .swapHeadTail()
-- Description: method to convert between the connected branch head and
-- updates the values and resets the graphics
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------

define method .swapHeadTail()
  !this.swapHeadTail(TRUE)
endmethod
------------------------------------------------------------------------
-- Method:      .swapHeadTail()
-- Description: method to convert between the connected branch head and tail
-- updates the values and resets the graphics
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .swapHeadTail(!runInitialise is BOOLEAN)

  if !this.currentConnection.built.set() then
    if !this.currentConnection.built.not() then
       -- its a new connection yet to be completed so we only want the text to be set.
      !this.currentConnection.headOrTail = !this.connectedEndOption.selection('rtext')
       return
    endif
  endif
  !this.connectedEnd = !this.connectedEndOption.selection('rtext')
  if !this.connectedEnd.eq('HEAD') then
  	if !runInitialise then
      !this.currentConnection = !this.headComponent

    endif
  elseif !this.connectedEnd.eq('TAIL') then
    if !runInitialise then
      !this.currentConnection = !this.tailComponent
    endif
     --!this.currentConnection = object PIPETAPPINGCONNECTION(!this.mainBranch,!this.stubInType.selection('rtext'),!this.boreSize.selection('dtext'))
  else
    !this.currentConnection = object PIPETAPPINGCONNECTION()
  endif

  --  !this.currentConnection.updateParameters(!this.stubInType.selection(),FALSE)
  --  handle ANY
  --  endhandle
  if !runInitialise then
    !this.initialiseVariables(FALSE)
  else
    !this.currentConnection.drawFitting(TRUE,!this.branchCylinder,!this.branchInsert.val.real())
  endif

endmethod
------------------------------------------------------------------------
-- Method:      .swapHeadTailDtext()
-- Description: method to convert between the connected branch head and tail
-- !option true is used by the conventional set option method
-- False just forces head and tail regardless
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .setHeadTailDtext(!option is BOOLEAN)

  -- TODO need to rationalise the upper/lower case head/tail text
  !dtext = ARRAY()
  if !option.not() then
     !dtext[1] = 'Head'
     !dtext[2] = 'Tail'
     !rtext[1] = 'HEAD'
     !rtext[2] = 'TAIL'
     !this.connectedEndOption.dtext = !dtext
     !this.connectedEndOption.rtext = !rtext
     !this.connectedEndOption.val = 1
     !this.currentConnection.headOrTail = 'HEAD'
     !this.connectedEndOption.active = TRUE
     return
  endif

  -- call the old select branch option
  if !this.tailComponent.set().and(!this.headComponent.set()) then
       !dtext[1] = 'Head'
       !dtext[2] = 'Tail'
       !rtext[1] = 'HEAD'
       !rtext[2] = 'TAIL'
       if !this.currentConnection.headOrTail.eq('TAIL') then
         !this.currentConnection = !this.tailComponent
       else
       !this.currentConnection = !this.headComponent
       endif
  elseif !this.tailComponent.set() then
       !dtext[1] = 'Tail'
       !rtext[1] = 'TAIL'
       !this.currentConnection = !this.tailComponent
  elseif !this.headComponent.set() then
       !dtext[1] = 'Head'
       !rtext[1] = 'HEAD'
       !this.currentConnection = !this.headComponent
  else
     !dtext[1] = 'unset'
     !rtext[1] = 'unset'
      --reset currentConnection
     !this.currentConnection = object PIPETAPPINGCONNECTION()
  endif

  !this.connectedEndOption.dtext = !dtext
  !this.connectedEndOption.rtext = !rtext
  !this.connectedEndOption.val = 1

endmethod

------------------------------------------------------------------------
-- Method:      .initialiseVariables()
-- Description: method to get all the variables from the current connection object
--
--
------------------------------------------------------------------------
define method .initialiseVariables()
  !this.initialiseVariables(TRUE)
endmethod

------------------------------------------------------------------------
-- Method:      .initialiseVariables()
-- Description: method to get all the variables from the current connection object
--
--
------------------------------------------------------------------------

define method .initialiseVariables(!runEndCheck is BOOLEAN)

  if !this.currentConnection.mainBore.unset() then
    !!alert.error('Incompatible Bores - Cannot connect these sizes ')
    !this.setOption(true)
    return
endif

-- get the appropriate types
!this.availableTypes.getavailableTypes(!this.currentConnection.mainBore,!this.currentConnection.p3Bore)
handle 111
  return
endhandle

!this.stubInType.select('RTEXT',!this.currentConnection.componentType)
handle ANY
  !this.stubInType.val = 1
endhandle

-- this did get the appropriate tube bores and it did something with tappingtypes
-- !this.getTubeBores(!this.stubInType.selection('rtext'))
if !this.currentConnection.mode.eq('UPDATE') then
  -- using actual insert
   !this.branchInsert.val = !this.currentConnection.actualInsertDepth
   !this.branchInsert.tag = 'Insert Depth (actual)'
   !this.toggleInsert.tag = 'Default'
   !this.toggleInsert.active = TRUE
else
  -- using default insert
   !this.branchInsert.val = !this.currentConnection.defaultInsertDepth
   !this.branchInsert.tag = 'Insert Depth (Default)'
endif

!this.connectionNote.val = !this.currentConnection.connectionNote
-- draw the cylinder
!this.currentConnection.drawFitting(TRUE,!this.branchCylinder,!this.branchInsert.val.real())

if !runEndCheck then

  if !this.tailComponent.surfacePosition.set() AND !this.headComponent.surfacePosition.set() AND !this.connectedBranch.set() then

    if !this.tailComponent.surfacePosition.distance(!this.connectedBranch.tpos).gt(!this.headComponent.surfacePosition.distance(!this.connectedBranch.hpos)) then
    	--head
    	--if gadget not head, flip
    	if !this.connectedEndOption.selection('rtext').eq('HEAD') then
    		-- head, no change required
    	else
    	  -- head, gadget set to tail so swap
    	  !this.connectedEndOption.val = 1
    	  !this.swapHeadTail(FALSE)
    	endif

    else
    	--tail
    	if !this.connectedEndOption.selection('rtext').eq('TAIL') then
    		-- tail, no change required
    	else
    	  -- tail, gadget set to head so swap
    	  !this.connectedEndOption.val = 2
    	  !this.swapHeadTail(TRUE)

    	endif
    endif
  endif
endif

-- added to ensure that the right connection bore is selected
!this.boreSize.select('RTEXT',!this.currentConnection.p3Bore.string())
handle any
  --q var !!error
endhandle

endmethod

------------------------------------------------------------------------
-- Method:      .testForComponents()
-- Description: method to make sure we have the right components in the database
--
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .testForComponents()

!unusedTest = object DBREF( '/General-Tappings' )
handle (2,109)
  !!appdesmain.createStubin.active = FALSE
  handle ANY
  endhandle
  return error  4 'Cannot find the PTAPPING specification /General-Tappings which is required for this application - Please contact your System Administrator'
endhandle

return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:      PickNewConnectionPoint
--
-- Description: Pick surface item to connect to
--
--
------------------------------------------------------------------------
define method .pickNewConnectionPoint()

  --!this.detailGadgets(FALSE)
  !this.edgSelection = 'pick branch'
  --'Stub in Branch'
  -- Initialise Variables

  -- Define EDG Packet
  !packet                 = object EDGPACKET()
  !packet.elementPick('Pick a surface Position to locate initial branch position:')
  !packet.description     = 'pick branch'

  -- When the component has been created successfully
  !packet.remove          = true
  !packet.priority        = 2
  !packet.action          = '!!pipeTappings.pickNewBranchPosition(!this.return[1])'

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition


-------------------------------------------------------------------------
--
-- Method .pickNewBranchPosition()
--
-- Description: dummy method to stop users from picking ppoints
--
-----------------------------------------------------------------
define method .pickNewBranchPosition(!data is  EDGPOSITIONDATA)

!!alert.error('Please pick a surface position')

endmethod
----------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      .pickNewBranchPosition
--
-- Description: This is the new method to derive a surface pick going away
-- from the main branch
--
------------------------------------------------------------------------
define method .pickNewBranchPosition(!data is  EDGPICKDATA)

  -- the first time this is called the current connection object has only a name
  if !this.currentConnection.mode.eq('NEW') then
    -- we need to create the branch
    !this.currentConnection.createNewBranch()
    -- at this point we should have a branch with no head or tail
  -- elseif !this.currentConnection.mode.eq('PICKED') then
    -- reposition
    -- this method is called as result of picking a position so new or not it needs to be updated
  endif

  ------------- |------Stub in Branch|
  -- this method is called as result of picking a position so new or not it needs to be updated
  !this.currentConnection.updatebranch(!data)
$(
  -- restriction to prevent ptaps in tube - now removed
  if !this.currentConnection.componentortube.eq('TUBE').and(!!pipingsettings.nonStandardBranchNoTube) then
  !!alert.error('Non Standard Branch Connections are not allowed in Tube - Please use a TEE or OLET')
  !!ce = !this.currentConnection.newBranch
  delete bran
  !this.tidyFromNewBranch()
  !!pipeTappings.defaultGadgets(true)
  return
endif
$)

  if !!pipingsettings.nonStandardBranchTable.eq('3').not() then
    -- update the available list of tapping types
    !this.availableTypes.getBoreStrings(!this.currentConnection.mainBore.real(),!this.boreSize.selection().real())
  endif

  if !this.currentConnection.headOrTail.eq( 'HEAD' )then
    !this.headComponent = !this.currentConnection
  else
    !this.tailComponent = !this.currentConnection
  endif

  if !this.currentConnection.mode.eq('NEW') then
    !!pipeTappings.adjust.active = FALSE
  else
    !!pipeTappings.adjust.active = TRUE
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .getParameters(!bore is STRING)
--
-- Description: this is the method which is called from the change bore size gadget
-- if the branch built flag is not set then its a new branch yet to be applied
-- in this case it needs to reset the branch bore and insert depth
--
------------------------------------------------------------------------
define method .getParameters(!bore is STRING)

-- now we know the bore we can repopulate the list of tapping types
 !this.availableTypes.getavailableTypes(!this.currentConnection.mainBore,!bore.bore())

if !this.currentConnection.mode.eq('NEW') then
  !this.currentConnection.p3bore = object BORE(!bore)
  return
endif
if !this.currentConnection.built.not() then
	!this.currentConnection.p3bore = object BORE(!bore)
  !this.setBranchBores(!this.currentConnection.connectedBranch,0)
  --!this.getTubeBores(!this.stubInType.selection())
elseif !this.currentConnection.built.and(!this.currentConnection.p3Bore.neq(!bore.bore())) then
  -- new condition when its been built and the passed bore is different. Calls the bore change routine
  -- but needs to update the current connection object as well ongoing
  !oldBore = !this.currentConnection.p3bore
  !componentCount = !this.currentConnection.connectedBranch.members.size()
   if !componentCount.gt(0) then
    !!alert.error('This function cannot change the bore of branches with components')
    !this.boreSize.select('RTEXT',!oldBore.string())
    handle ANY
    endhandle
    return
  endif
  !this.currentConnection.p3bore = object BORE(!bore)
  !this.setBranchBores(!this.currentConnection.connectedBranch,0)
  !this.pickStubInBranch(!this.currentConnection.connectedBranch,TRUE)
  !this.currentConnection.defaultInsertDepth = !this.currentConnection.actualInsertDepth
elseif !this.currentConnection.built then
  return
else
   --!this.getTubeBores(!this.stubInType.selection())
   !this.updateCoupling()
endif
   --!this.getTubeBores(!this.stubInType.selection())

endmethod

------------------------------------------------------------------------
--
-- Method:      .setBranchBores
--
-- Description: set the passed branch hbor/tBore or both
--
--
------------------------------------------------------------------------
define method .setBranchBores(!branch is DBREF ,!option is REAL )

-- if !option = 0 set both head and tail
-- if !option = 1 set the head
-- if !option = 2 set the tail

!save = !!ce
!!ce = !branch

!boreFromGadget =  !this.boreSize.selection('dtext')
 --!bore = object BORE($!this.boreSize.selection('dtext'))
!bore = object BORE(!boreFromGadget)
 handle ANY
   !bore = object BORE(15mm)
 endhandle

 -- If the pipe has a bore set then use it
 if(!option inset (0,1)) then
   !branch.hBore      = !bore
   sel hstu
 endif
 if !option inset (0,2) then
   !branch.tBore      = !bore
 endif

 !!ce = !save

endmethod

------------------------------------------------------------------------
--
-- Method:      getBranchList
--
-- Description: Get a list of existing branches
--
--
------------------------------------------------------------------------
define method .getBranchList()

 -- Get branch information for active pipe
  if(!this.pipe.members.empty().not()) then

    -- Loop through pipe members
    do !element values !this.pipe.members

      skip if(!element.type ne 'BRAN')

      -- Branch
      !branch = object PIPEBRANCH(!element)

      -- Add branch to list of branches
      if(!branch.set()) then
        !this.branches.append(!branch)
      endif

    enddo

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .runBasicTests()
--
-- Description: test for all of the invalid entries from the pick stubIn
-- methods
--
--
------------------------------------------------------------------------
define method .runBasicTests(!pickedBranch is DBREF ) is BOOLEAN

-- initialise the basic objects
   !this.headComponent     = object PIPETAPPINGCONNECTION()
   !this.tailComponent     = object PIPETAPPINGCONNECTION()
   !this.currentConnection = object PIPETAPPINGCONNECTION()
   !this.connectedBranch = object DBREF()

   if !pickedBranch.eq(!this.currentConnection.connectedBranch) then
       !!alert.error('This branch is already selected')
       return FALSE
   endif

   if !pickedBranch.eq(!this.mainBranch) then
      !!alert.error('You have selected the main Branch. - You cannot connect a branch to itself')
      return FALSE
   endif

   -- set up the available bores by examining the branch spec
   !spec = !pickedBranch.pspec
   if !spec.unset() then
      !!alert.error('Connected branch Piping Spec is Unset - Please set the spec')
      return FALSE
   endif

   if !pickedBranch.hBore.unset().or(!pickedBranch.tBore.unset()) then
     !!alert.error('Connected Branch hBore or tBore is unset - Please set these before continuing')
     return FALSE
   endif

   -- check if the branch can be written to
   if !!dbRefUpdatable(!pickedBranch).not() then
     !!alert.error('You are unable to modify this branch - $!!error.text')
     !this.stubInName.val = ''
     !this.currentConnection.connectedBranch = object DBREF()
     return FALSE
   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      .swapInsert()
--
-- Description: toggle between the actual insert and the default one.
-- if the branch is not yet connected and only the default is available
-- the gadget is greyed out. This methods is only called when the button
-- is active
--
--
------------------------------------------------------------------------
define method .swapInsert()

  if !this.toggleInsert.tag.eq('Default') then
      !text = 'Insert Depth (Default)'
     -- !this.toggleInsert.tag    = 'Actual'
      !this.branchInsert.val    = !this.currentConnection.defaultInsertDepth
      if !this.currentConnection.actualInsertDepth.set() then
         !this.toggleInsert.tag    = 'Actual'
         !num = !this.currentConnection.actualInsertDepth
         !this.toggleInsert.setToolTip('Use the actual insert value of $!num')
      else
         !this.toggleInsert.active = FALSE
      endif
  else
      -- the tag is actual
      !this.toggleInsert.tag    = 'Default'
      !this.branchInsert.val    = !this.currentConnection.actualInsertDepth
      !num = !this.currentConnection.defaultInsertDepth
      !this.toggleInsert.setToolTip('Use the insert default value of $!num')
      !text = 'Insert Depth (Actual)'
      !this.toggleInsert.active = TRUE
  endif

  !this.setInsert(!this.branchInsert.val,!text)

endmethod
------------------------------------------------------------------------
--
-- Method:      setConnectedOrNot()
--
-- Description: sets the head and tail connection text on the form
--
--
--
------------------------------------------------------------------------
define method .setConnectedOrNot()

if !this.stubInName.val.eq('') then
    !this.headConnectedOrNot.val = ''
    !this.tailConnectedOrNot.val = ''
  return
endif

  if !this.currentConnection.href.set() then
     !headText = 'Head: ' & !this.currentConnection.href.flnn
  else
     !headText = 'Head: not connected'
  endif
  if !this.currentConnection.tref.set() then
     !tailText = 'Tail: ' & !this.currentConnection.tref.flnn
  else
     !tailText = 'Tail: not connected'
  endif

   -- head comes first
   !this.headConnectedOrNot.val = !headText
   !this.tailConnectedOrNot.val = !tailText

endmethod
------------------------------------------------------------------------------
--
-- Method:      setConnectedOrNot()
--
-- Description: sets/unset main branch highlighting.
--
--
------------------------------------------------------------------------
-- method for adding/removing highlights to the passed element
define method .highlight(!item is DBREF,!addRem is BOOLEAN)

  if !item.badref() then
     return
  endif

  rem $!item
  add $!item
  if !addRem then
     if !item.type.eq('BRAN') or !item.type.eq('EQUI') then
       enhance $!item colour red
     else
       enhance owner of $!item colour red
     endif
  else
     if !item.type.eq('BRAN') or !item.type.eq('EQUI') then
       unenhance $!item
     else
       unenhance owner of $!item
     endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .selectCoupling()
--
-- Description: Method to get the relevant bores passed parameter
-- is the list selection
--
--
------------------------------------------------------------------------
define method .selectCoupling(!listNumber is REAL)

!this.couplingSelected = TRUE
!this.couplingComponents.fillBores(!listNumber)
--updating coupling
!this.updateCoupling()



if !this.couplingType.selection('dtext').eq('none') then
  !this.apply.active = FALSE
else
	!this.apply.active = TRUE
endif

-- now we need to update the insertDepths

endmethod
------------------------------------------------------------------------
--
-- Method:      .fixNewBranch()
--
-- Description: Method to create the new connection and return to edit mode
--
--
------------------------------------------------------------------------
define method .fixNewBranch()

if !this.currentConnection.newBranch.unset() then
  !this.tidyFromNewBranch()
  return
else
  !name =  !this.currentConnection.newBranch.namn
  handle ANY
    -- the branch has been deleted
    !this.currentConnection = object PIPETAPPINGCONNECTION()
    !this.setOption(TRUE)
    return
  elsehandle NONE
     !answer = !!alert.confirm('Do you wish keep new branch $!name')
     if !answer.eq('NO') then
        !!ce = !this.currentConnection.newBranch
        delete bran
        !this.tidyFromNewBranch()
        return
     endif
  endhandle
endif

!this.pickStubInBranch(!this.currentConnection.newBranch,TRUE)

-- this next line actually makes the connection an prevents the resizing and re-positioning
--!this.currentConnection.connect()
!this.setOption(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      .tidyFromNewBranch()
--
-- Description: method to realign the branch connection gadgets after
-- and aborted branch creation exercise
--
------------------------------------------------------------------------
define method .tidyFromNewBranch()

    !!pipeTappings.resetBranchVariables()
    !this.currentConnection = object PIPETAPPINGCONNECTION()
     !this.setOption(TRUE)
     !temp = !this.mainBranch
     !this.mainBranch = object DBREF()
     if !temp.badref().not() then
       !this.pickMainBranch(!temp)
     endif
     !this.detailGadgets(FALSE)
     !this.clearAids()

endmethod

------------------------------------------------------------------------
--
-- Method:      .showBranchUpdateForm()
--
-- Description: method to show the branch position modification form
--
------------------------------------------------------------------------
define method .showBranchUpdateForm()

if undefined(!!specialBranchDirection) then
  pml load form !!specialBranchDirection
endif

!!specialBranchDirection.currentConnection = !this.currentConnection

show !!specialBranchDirection

endmethod

------------------------------------------------------------------------
--
-- Method:      .setNote()
--
-- Description: method called to set note (description) on PIPCA
--
------------------------------------------------------------------------
define method .setNote(!value is STRING)

-- this is a method for setting the insert but needs completing
-- the passed value is the setting for the modified insert depth
-- and we need to modify the appropriate position values and redraw the
-- component
  if !value.unset().not() then
    !this.currentConnection.setNote(!value)
  endif

endmethod

