--
-- File:        pipingdefaults.pmlfrm
--   Type:      Form Definition
--   Group:     piping
--   Keyword:   Default
--   Module:    Design
--   Replaces:
--
-- Author:    Tony Martin
-- Created:  23/04/2012 09:24:27
--
--
-- Description:
-- Form Definition for Editing Pipe default values.
-- Includes component creation and component selections values
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  componentCreationRefreshActions() -
--  componentSelectionRefreshActions() -
--  getTableList(GADGET)             -
--  init()                           -
--  minTube()                        STRING
--  pipingDefaults()                 -                   Constructor
--  saveSettingsObject()             -
--  setComponentEditFrameGadgets()   -
--  setFormDefaults()                -
--  updateComponentCreation()        -
--  updateNSBC(GADGET,STRING)        -
--  updateSettingsObject()           -
--  updateTubeDist(GADGET,STRING)    -
--  updatesnapDist(GADGET,STRING)    -
--  validateTextGadgets(GADGET,STRING) -
--
------------------------------------------------------------------------------------------------
-- Define Form
layout form !!pipingDefaults at xr0.6 yr0.07 VarChars dialog

  !!pipingDefaults.formtitle    = |Piping Settings|
  !!pipingDefaults.initcall     = |!this.init()|

  frame .componentEditorFormFrame 'Piping Application Options'
    path down
    -- Options Setting Frame
    frame .createOptionsFrame   'Component creation' height 9.4
      -- Snap distance for picking
      text   .snapDist      'Snap Dist' tagwidth 10 callback '!this.updateSettingsObject()' tooltip 'Snap distance <distance> or <val> * OD' width 10 is STRING
      toggle .autoSnap      'Default Source'  at xmax .snapDist ymin callback '!this.updatesnapDist(' tooltip 'Use Datacon or Gadget Values for Snap Distance'

      -- Minimum Tube Length
      path down
      text   .minTubeLength at xmin.snapDist ymax   'Min. Tube'  tagwidth 10    callback '!this.updateSettingsObject()' tooltip 'Minimum tube length <distance> or <val> * OD'  width 10 is STRING
      toggle .autoDatacon   'Default Source'  at xmax .minTubeLength ymin         callback '!this.updateTubeDist(' tooltip 'Use Datacon or Gadget Values for tube lengths'
      option .detailText      'Descriptions' tagwidth 10 at xmin.snapDist ymax   callback '!this.updateSettingsObject()' width 8
      toggle .align   at  xmin.snapDist ymax       'Auto align'            callback '!this.updateSettingsObject()'
      toggle .createAdjacent  'Auto. Create'          callback '!this.updateSettingsObject()'
      toggle .adjacentSpec    'Select Adjacent Out of Spec'  at xmin.align ymax     callback '!this.updateSettingsObject()'
      toggle .skipConn        'Skip Connected Comps.'      callback '!this.updateSettingsObject()'

      frame .nsbcFrame 'Non Standard Branch Connections'
        option .table  callback '!this.updateNSBC(' width 29
        toggle .nonStandardBranchNotube 'Boss connections not allowed in Tube'  callback '!this.updateNSBC('
      exit

    exit

  exit

  --button .cancel 'Cancel' at xmax form-.25-size ymax+.25 width 8 cancel

exit

------------------------------------------------------------------------
-- Method:      .pipingDefaults()
-- Description: Constructor
--
------------------------------------------------------------------------
--- default load method
define method .pipingDefaults()

  -- Configuration Info, options are DTXR = rText, DTXS = Stext, DTXT = Ttext, CATTEX = rText + Material Text
  !display  = ARRAY()
  !replace  = ARRAY()
  !display.append('Full')
  !replace.append('CATTEX')
  !display.append('R Text')
  !replace.append('DTXR')
  !display.append('S Text')
  !replace.append('DTXS')
  !display.append('T Text')
  !replace.append('DTXT')
  !display.append('Cat-Ref')
  !replace.append('CATR')
  !this.detailText.dText  = !display
  !this.detailText.rText  = !replace

  !this.snapDist.validateCall = |!this.validateTextGadgets(|
  !this.minTubeLength.validateCall = |!this.validateTextGadgets(|

  -- get a list of available tapping tables to populate the tapping tables list
  !this.getTableList(!this.table)

  !this.setFormDefaults()


endmethod


--update the session defaults stored in the global settings object (these can be saved)
define method .updateSettingsObject()

  --update the specific defaults for each application form (initially this is componenteditor only)
  !this.updateComponentCreation()


  --save the changes to the !!pipingSettings object
  !this.saveSettingsObject()

  --run any post update actions on the forms
  !this.componentCreationRefreshActions()

endmethod

--set the form gadget values
define method .setFormDefaults()

  !this.setComponentEditFrameGadgets()

endmethod

--save the current user defaults to their personal defaults file
define method .saveSettingsObject()

  !!pipingSettings.saveDefaults()

endmethod

define method .init()

  -- Set toggles to default values
  !this.setFormDefaults()

endmethod

define method .validateTextGadgets(!gadget is GADGET, !dummyString is STRING)

  --this value can either be a real or an expression of the form 2 * OD
  --so first check whether or not we can convert the string in the gadget to a real value
  !unusedTestReal = !gadget.val.real()
  handle (2,441)

    --if we are here then the supplied string cannot be converted to a real. Check if the supplied string is of the form 2 * OD
    !inputString = !gadget.val

    !before = !inputString.before('*')
    !after = !inputString.after('*')

    --before should be a real number
    !unusedTestValue = !before.real()
    handle (2,441)
      !!alert.warning(|Please enter a distance value or string of the form '<val> * OD'|)
      return error 1 noalert
    endhandle

    if (!after.upCase().trim().neq('OD')) then
      !!alert.warning(|Please enter a distance value or string of the form '<val> * OD'|)
      return error 1 noalert
    endif

    --if we get here reformat the gadget value so it is in the proper format
    !formattedval = !before.trim() + ' * ' + !after.trim().upCase()
    !gadget.val = !formattedval.trim()

  endhandle

endmethod

define method .updateNSBC( !object is GADGET, !dummyAction is STRING)

  if (!object.eq(!!pipingDefaults.nonStandardBranchNotube)) then
    !!pipingSettings.nonStandardBranchNotube = !this.nonStandardBranchNotube.val
    return
  endif

  if (!object.val.eq(1)) then
    !object.setToolTip('Non Standard Branch Connections are not enabled for this Project')
  elseif (!object.val.eq(2)) then
    !object.setToolTip('Non Standard Branch Connections use tapping references from main branch Specification')
  elseif (!object.val.eq(3)) then
    !object.setToolTip('No Restriction on Non Standard Branch Connection sizes')
  else
    !text = !object.selection('dText')
    !object.setToolTip('Non Standard Branch Connections all use Table $!text')
  endif

  if (!object.val.leq(3)) then
    !!pipingSettings.nonStandardBranchTable =  !object.val.string()
  else
    !!pipingSettings.nonStandardBranchTable =  !object.selection()
  endif

  !!pipingSettings.nonStandardBranchNotube = !this.nonStandardBranchNotube.val

  !this.updateSettingsObject()
endmethod

------------------------------------------------------------------------
-- Method:      .getTableList
-- Description: gets a list of available tapping tables for use with NSBC
-- connections. This needs to be run on startup to make sure that the
-- current selection is available
--
------------------------------------------------------------------------
define method .getTableList(!option is GADGET )

  !dText[1] = 'Not Allowed'
  !rText[1] = 'none'
  !dText.append('From Specification')
  !rText.append('spec')
  !dText.append('No Restriction')
  !rText.append('None')

  var !coll coll all BRTAB with purp eq 'PTAP'
  if (!coll.set()) then
    do !a values !coll
      !dText.append(!a.dbref().namn)
      !rText.append(!a)
    enddo
  endif

  !option.dText = !dText
  !option.rText = !rText

endmethod

define method .updateComponentCreation()

  --component creation members
  !!pipingSettings.snapDist          = !this.snapDist.val
  !!pipingSettings.minTube           = !this.minTubeLength.val
  !!pipingSettings.autoAlign         = !this.align.val
  !!pipingSettings.autoCreate        = !this.createAdjacent.val
  !!pipingSettings.useAlternateSpec  = !this.adjacentSpec.val
  !!pipingSettings.skipConnected     = !this.skipConn.val

  --generic option members
  !!pipingSettings.descriptions      = !this.detailText.selection('rText')
  --component editor display options

endmethod

define method .componentCreationRefreshActions()
  --if the componenteditor form is both defined and shown then refresh the defaults in real time
  if (defined (!!componentcreation)) then
    if (!!componentcreation.shown()) then
      !!componentcreation.readOptions()
      !!componentcreation.setupoptions()
      -- Only tag if we're in create or re-select mode
      if (!!componentcreation.currentTask.eq('SELECTCOMPONENT')) then
        !!componentcreation.tag()
      elseif (!!componentcreation.currentTask.eq('RESELECT')) then
        !!componentcreation.tagReselect()
      endif
    endif
  endif

endmethod

define method .componentSelectionRefreshActions()
  --if the componenteditor form is both defined and shown then refresh the defaults in real time
  if (defined (!!componentselection)) then
    if (!!componentselection.shown()) then
      !!componentselection.readOptions()
      !!componentselection.setupoptions()
    endif
  endif

endmethod

define method .setComponentEditFrameGadgets()

  if (!!pipingSettings.fileName.eq('%PDMSDFLTS%/piping_settings_General')) then
    !currentSession = current session
    var !teams team
    !active = FALSE

    -- Go through all the teams for the current user and check if they are either in the PIPINGADMIN team or a free user
    do !team values !teams.split()
      if (!team.upCase().eq('PIPINGADMIN') OR !currentSession.user().access.upCase().eq('FREE')) then
        !active = TRUE
        break
      endif
    enddo
  else
    !active = TRUE
  endif

  !this.setGadgetsActive(!active)

  --component creation members

  !this.snapDist.val            = !!pipingSettings.snapDist
  if (!this.snapDist.val.eq('Datacon')) then
    !this.autoSnap.val = TRUE
    !this.snapDist.setToolTip ('Snap distance derived from Datacon Tube Tolerances')
  else
    !this.autoSnap.val = FALSE
    !this.snapDist.setToolTip ('Snap distance derived from expression <distance> or <val> * OD eg. 2 * OD')
  endif

  !this.minTubeLength.val = !!pipingSettings.minTube
  if (!this.snapDist.val.eq('Datacon')) then
    !this.autoDatacon.val = TRUE
    !this.minTubeLength.setToolTip ('Minimum Tube Length derived from Datacon Tube Tolerances')
  else
    !this.autoDatacon.val = FALSE
    !this.minTubeLength.setToolTip ('Minimum Tube Length derived from Expression <distance> or <val> * OD eg. 2 * OD')
  endif

  !this.align.val               = !!pipingSettings.autoAlign
  !this.createAdjacent.val      = !!pipingSettings.autoCreate
  !this.adjacentSpec.val        = !!pipingSettings.useAlternateSpec
  !this.skipConn.val            = !!pipingSettings.skipConnected

  --generic option members
  !this.detailText.select('rText',!!pipingSettings.descriptions)

  !nsbcSetting = !!pipingSettings.nonStandardBranchTable
  !test = !nsbcSetting.real()
  handle NONE
    !this.table.val = !test
  elsehandle ANY
    !this.table.select('rText', !nsbcSetting.dbref().string())
    handle ANY
      !!alert.error('Unable to find previously defined Specification $!nsbcSetting')
    endhandle
  endhandle

  !this.nonStandardBranchNotube.val = !!pipingSettings.nonStandardBranchNotube

endmethod

define method .updatesnapDist(!object is GADGET, !action is STRING)

  if (!action.eq('SELECT')) then
    !this.snapDist.val = 'Datacon'
    !this.snapDist.setToolTip ('Snap distance derived from Datacon Tube Tolerances')
  else
    !this.snapDist.val = !this.minTube()
    !this.snapDist.setToolTip ('Snap distance derived from Epression <distance> or <val> * OD eg. 2 * OD')
  endif
  !this.updateSettingsObject()

endmethod

define method .updateTubeDist(!object is GADGET, !action is STRING)

  if (!action.eq('SELECT')) then
    !this.minTubeLength.val = 'Datacon'
    !this.minTubeLength.setToolTip ('Minimum Tube Length derived from Datacon Tube Tolerances')
  else
    !this.minTubeLength.val = !this.minTube()
    !this.minTubeLength.setToolTip ('Minimum Tube Length derived from Expression <distance> or <val> * OD eg. 2 * OD')
  endif
  !this.updateSettingsObject()

endmethod

define method .minTube() is STRING

  var !tube tol tube
  !list= !tube.split()
  return !list[1]

endmethod
