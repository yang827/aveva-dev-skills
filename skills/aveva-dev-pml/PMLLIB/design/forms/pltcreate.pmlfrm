------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Create point using passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- If there is a loop defined, then map position onto the plane
  if(!this.loop.set()) then
    !newPosition = !this.plane.near(!position)
  else
    !newPosition = !position
  endif

  -- Look for position in list of positions
  !index = !this.positions.findFirst(!newPosition)

  -- Return if position has been found in the positions list
  if(!index.set()) then
    !!alert.warning('A vertex has already being defined at this position, ignoring point.')
    return
  endif

  -- Add position to list of positions
  !this.positions.append(!newPosition)

  -- Append radius to list
  !this.radii.append(0)

  -- No panel created, but vertices defined
  if(!this.loop.unset() and !this.positions.size() gt 0) then

    -- Tag the last point
    if(!this.positions.size() gt 1) then
      !last = !this.positions.size()
      !line = object GPHLINE(object LINE(!this.positions[!last - 1], !this.positions[!last]))
      !this.aidNumbers.append(!!aidNumbers.add(!line))
    endif

  -- Adding to a loop
  elseif (!this.loop.set() and !this.loop.mCount gt 0) then
    !prevPosition = !this.loop.members[!this.loop.mCount].position
    !line = object GPHLINE(object LINE(!prevPosition, !this.positions[!this.positions.size()]))
    !this.aidNumbers.append(!!aidNumbers.add(!line))
  endif

  -- Last definition
  !this.lastDefCount.append(1)
  !this.lastDefType.append('Point')
  !this.remove.tag = 'Remove Previous Point'

  -- Build/Create
  !this.build()

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      arc
--
-- Description: Create points using passed arc definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arc(!arc is ARC)

  -- Initialise Variables


  -- Get last point
  -- From list
  if(!this.loop.unset()) then
    if(!this.positions.size() gt 0) then
      !lastPosition = !this.positions[!this.positions.size()]
    endif

    -- From created points
  elseif (!this.loop.unset() and !this.loop.mCount gt 0) then
    !lastPosition = !this.loop.members[!this.loop.mCount].position
  endif

  -- Draw a line
  if(defined(!lastPosition)) then
    !line = object GPHLINE(object LINE(!arc.anglePosition(!arc.startAngle), !lastPosition))
    !this.aidNumbers.append(!!aidNumbers.add(!line))
  endif

  -- Number of currently defined points
  --!points = !this.positions.size()

  -- Add first vertex
  !this.positions.append(!arc.anglePosition(!arc.startAngle))
  !this.radii.append(0)

  -- Arc angle <= 90 degrees, only create one fillet point
  if(!arc.endAngle le 90) then
    !split = 1
  -- Arc angles > 90 and < 180
  elseif (!arc.endAngle.between(90, 180)) then
    !split = 2
  -- Arc angles > 180 and < 270
  elseif (!arc.endAngle.between(180, 270)) then
    !split = 3
  -- Arc angles > 270 and < 360
  else
    !split = 4
  endif

  -- Copy arc and get angle for each segment
  !newArc = !arc
  !angle  = !arc.endAngle / !split

  -- Populate vertices members
  do !i from 1 to !split
    !newArc.startAngle = !angle * (!i - 1)
    !newArc.endAngle   = !angle * !i
    !this.positions.append(!newArc.pole())
    !this.radii.append(!arc.radius)
  enddo

  -- Add Last vertex
  !this.positions.append(!arc.anglePosition(!arc.endAngle))
  !this.radii.append(0)

  -- Draw the arc
  !gphArc    = object GPHCIRCLE(!arc)
  !aidNumber = !!aidNumbers.add(!gphArc)
  !this.aidNumbers.append(!aidNumber)

  -- Last definition
  !this.lastDefCount.append(!split + 2)
  !this.lastDefType.append('Arc')
  !this.remove.tag = 'Remove Previous Arc'

  -- Build/Create
  !this.build()

endmethod
-- End of method definition for .arc(ARC)

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: Build panel/loop from current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build()

  -- Initialise Variables
  !newVertices = !this.positions.size()
  !reference   = !!ce

  -- No panel, not enough points, do nothing other than tag the points
  if(!this.extrusion.unset() and !newVertices lt 3) then

    -- Update form
    !this.updateForm()

    return

  -- Create a new panel
  elseif (!this.extrusion.unset() and !newVertices ge 3) then

    -- Define plane
    !this.plane  = !this.positions[1].plane(!this.positions[3], !this.positions[2])
    handle any
      -- 3 points must not be in line
      !!alert.message('Repick vertex because first 3 vertices cannot be in one straight line')
      !this.removeLast()
      return
    endhandle

    -- Derive correct orientation of the plane
    if (!this.elementType.upcase() ne 'PANEL' and !this.plane.orientation.zDir().wrt(world).angle(D).int() eq 0) then
      !this.plane.orientation = object ORIENTATION('Y is ' & !this.positions[1].direction(!this.positions[2]) & ' and Z is U')
    else
      !this.plane.orientation = object ORIENTATION('Y is ' & !this.positions[1].direction(!this.positions[2]) & ' and Z is ' & !this.plane.orientation.zDir())
    endif

    -- Build Panel
    !store = !!getStorageArea(!this.group, !this.area)

    -- If store is unset, can we create the panel in or above where we are
    if(!store.unset()) then
      -- set a temporary type variable as panels will be searched for as PANE
      if (!this.elementType.upcase() eq 'PANEL') then
        !tempType = 'PANE'
      else
        !tempType = !this.elementType.upcase()
      endif
      !store = !!dtbOwnerOfType(!!ce, !tempType)
      if(!store.unset()) then
        !!alert.warning('Unable to create ' + !this.elementType + ' within this hierarchy structure. Move to an element that can own one or set the appropriate storage area. ')

        -- Update form
        !this.updateForm()

        return
      endif

    endif

    -- Move to the store
    !!ce = !store

    NEW $!<this.elementType>
    AT  $!<this.plane.position>
    ORI $!<this.plane.orientation>

    -- Generate the aid axes
    !gphAxes             = object GPHAXES(!!ce)
    !gphAxes.description = 'Origin'
    !gphAxes.tag         = true
    !gphAxes.detail      = false
    !gphAxes.height      = 1000mm
    !!aidNumbers.replace(!this.aidAxes, !gphAxes)

    -- Load other data (material, etc)
    SPREF $!<this.specDefault.component>
    -- GWALL specific code
    if (!this.elementType.upcase() eq 'GWALL') then
      SPREF $_cdWallSpec_spre
      handle any
      endhandle
    endif

    -- Set reference to extrusion
    !this.extrusion = !!ce

    -- Create the loop
    NEW PLOOP
    HEIGHT $!<this.thickness.val>
    !justification = !this.justification.selection()
    SJUST  $!<justification>

     -- Set reference to loop
    !this.loop = !!ce

  endif

  -- Move to the last element of the loop
  if(!this.loop.mCount gt 0) then
    !!ce = !this.loop.members[!this.loop.mCount]
  else
    !!ce = !this.loop
  endif

  -- Define points
  do !i indices !this.positions
    NEW PAVE
    AT      $!<this.positions[$!<i>]>
    FRADIUS $!<this.radii[$!<i>]>
  enddo

  -- Tag vertices
  --!origin     = !this.extrusion.position
  --!lastVertex = !this.loop.members[!this.loop.mCount].position

  -- Return to reference
  !!ce = !reference

  -- Re-initialise Variables
  !this.positions.clear()
  !this.radii.clear()

  -- Update form
  !this.updateForm()

endmethod
-- End of method definition for .build()
