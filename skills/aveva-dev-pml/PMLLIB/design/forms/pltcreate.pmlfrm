-- File:            pltcreate.pmlfrm
--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Aug 11 14:17:42 BST 1998
--
--
-- Description:
-- Panel creation form
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  arc(ARC)                         -                   Create points using passed arc definition
--  build()                          -                   Build panel/loop from current data
--  cancel()                         -                   Apply form
--  close()                          -                   Close form
--  define3Points()                  -                   Setup EDG mode to define arc passing through three points
--  defineCLine()                    -                   Setup to derive point by mid-point of plines and panel
--  defineExplicit()                 -                   Setup EDG mode to define points explicitly
--  defineFRadTan()                  -                   Setup EDG mode to define arc of fixed radius passing through 2 points
--  defineFillet()                   -                   Setup EDG mode to define point using fillet method
--  defineOffset()                   -                   Setup EDG mode to define with relative offset from previous
--  definePoints()                   -                   Setup EDG mode for defining by graphic picks
--  defineTrace()                    -                   Setup to define edge by tracing another panel/extrusion
--  initialise()                     -                   Initialise the form
--  justification()                  -                   Set justifications
--  pltCreate()                      -                   Constructor
--  position(POSITION)               -                   Create point using passed position
--  removeLast()                     -                   Remove last vertices point
--  representation()                 -                   Set representation data to selection
--  thickness()                      -                   Set thickness
--  tidy()                           -                   Tidy up graphics
--  updateForm()                     -                   Update form information
--
------------------------------------------------------------------------

setup form !!pltCreate

  !!pltCreate.formTitle     = 'Create Panel'
  !!pltCreate.iconTitle     = 'Create Panel'
  !!pltCreate.callback      = '!this.initialise()'
  !!pltCreate.formRevision  = ' $Revision: 1.32 $ '

  -- Name Option
  option   .autoName at x0.5 y0.5 width 8

  -- Element Name
  text     .name ' ' at xmax ymin callback '!this.name.val = !!checkName(!this.name.val, ''NEW'')' width 36 is STRING

  -- Description
  path down
  halign right
  text     .description   'Description'  width 36 is STRING

  -- Thickness
--  path left
  text     .thickness 'Thickness' at xmin ymax+0.2 callback '!this.thickness()' width 12 is REAL format !!distanceFmt

  -- Justification
  option   .justification 'Justification' at xmax+2 ymin callback '!this.justification()' width 6

  -- Obst and Level Data
  frame .repFrame 'Representation' at xmin.autoName ymax width 50
    option   .perDefinedObs 'Predefined'   at x1       ymax callback '!this.representation() ' width 30
    text     .fromLevel     'Levels'       at xmin+4   ymax                                    width 2  scroll 3 is REAL
    text     .toLevel                      at xmax+1   ymin                                    width 2  scroll 3 is REAL
    option   .obstruction   'Obstruction ' at xmax+2.5 ymin                                    width 4
  exit

  -- Create Methods
  frame .crtFrame 'Create Methods'  at xmin.repFrame ymax.repFrame width 50

    -- Type of creation
    button .defPoints at x0.5 ymax pix unsel $!!cdpmPoints width 24 heig 24 tooltip 'Derive points from graphic picks'           callback '!this.definePoints()'
    path right
    hdist 0
    button .defCentreLine          pix unsel $!!cdpmClints width 24 heig 24 tooltip 'Derive points from centre & plines'   callback '!this.defineCLine()'
    button .defTrace               pix unsel $!!cdpmEdge   width 24 heig 24 tooltip 'Trace boundary of another extrusion/panel'  callback '!this.defineTrace()'
    button .defExplicit            pix                      width 24 heig 24 tooltip 'Explicitly defined position'                callback '!this.defineExplicit()'
    button .defOffset              pix                      width 24 heig 24 tooltip 'Point offset from previous'                 callback '!this.defineOffset()'
    button .defFillet              pix                      width 24 heig 24 tooltip 'Define arc fillet'                          callback '!this.defineFillet()'
    button .def3Points             pix                      width 24 heig 24 tooltip 'Derived arc passing through three points'   callback '!this.define3Points()'
    button .defFRadTan2            pix                      width 24 heig 24 tooltip 'Fixed radius arc, passing through 2 points' callback '!this.defineFRadTan()'

    para   .detail  at x1 ymax+0.2 width 45 lines 1
    -- Number of vertices created
    button .remove 'Remove Last Definition' at xmin ymax callback '!this.removeLast()'

  exit

  -- Bottom Line
  button .dismiss          'Cancel' at xmax form-size ymax+0.5 callback '!this.cancel()'
  button .apply            '  OK  ' at xmin form+0    ymin     callback '!this.apply()'

  toggle .displayModify    'Display modification form' at xmax+1 ymin states 'false' 'true'

  -- User Data

  -- Form members
  -- Current Active extrusion
  member .extrusion       is DBREF
  -- Loop Name
  member .loop            is DBREF
  -- Vertex Type
  member .vertexType      is STRING
  -- Extrusion plane
  member .plane           is PLANE

  -- Vertex definitions

  -- Created (i.e. after three points, we can create a panel)
  member .created         is BOOLEAN

  -- Vertices Data
  member .positions       is ARRAY
  member .radii           is ARRAY

  -- Aid number information
  member .aidNumbers      is ARRAY
  member .aidNumber       is REAL
  member .aidTag          is REAL
  member .aidAxes         is REAL

  -- Storage Areas
  member .group           is STRING
  member .area            is STRING

  -- Last number of definition points
  member .lastDefCount    is ARRAY
  member .lastDefType     is ARRAY

  -- element to create (handles soft types of panel)
  member .elementType     is STRING

  -- Default specification key
  member .specKey         is STRING

  -- Default specification data
  member .specDefault     is SPCDEFAULT

exit
-- End of form definition for !!pltCreate

------------------------------------------------------------------------
--
-- Method:      pltCreate
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltCreate()

  -- Naming method
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Name')
  !rText.append('false')
  !dText.append('Autoname')
  !rText.append('true')
  !this.autoName.dText      = !dText
  !this.autoName.rText      = !rText

  -- Justifications
    !dText    = ARRAY()
    !rText    = ARRAY()
    !dText.append('Top')
    !rText.append('UTOP')
    !dText.append('Centre')
    !rText.append('UCEN')
    !dText.append('Bottom')
    !rText.append('DBOT')
    !this.justification.dText = !dText
    !this.justification.rText = !rText

  -- Obstruction
  !dText    = ARRAY()
  !rText    = ARRAY()
  !dText.append('Hard')
  !rText.append('2')
  !dText.append('Soft')
  !rText.append('1')
  !dText.append('None')
  !rText.append('0')
  !this.obstruction.dText = !dText
  !this.obstruction.rText = !rText

  -- Define Icons
  !this.defExplicit.addPixmap(!!pml.getPathName('xyz24.png'))
  !this.defOffset.addPixmap(!!pml.getPathName('distancedirection24.png'))
  !this.defFillet.addPixmap(!!pml.getPathName('circlefillet24.png'))
  !this.def3Points.addPixmap(!!pml.getPathName('circle3pnt24.png'))
  !this.defFRadTan2.addPixmap(!!pml.getPathName('circlefrad2pnttan24.png'))

  -- Aid number
  !this.aidTag    = !!aidNumbers.add('Panel Creation')
  !this.aidNumber = !!aidNumbers.add('Panel Creation')
  !this.aidAxes   = !!aidNumbers.add('Panel Creation')

  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP" $<!!pltCreate.perDefinedObs$>

 !this.perDefinedObs.val = 2
 !this.representation()

 -- Set default storage area keys
 !this.group      = 'PANDP'
 !this.area       = 'PANEL'

 -- Set the cancel callback
 !this.cancelCall = '!this.close()'

endmethod
-- End of method definition for .pltCreate()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- set generic form title based on element type
  if (!this.elementType.upcase() eq 'GWALL') then
    !this.formTitle = 'Create User Defined Wall'
  else
    !this.formTitle = 'Create ' + !this.elementType
  endif
  !this.iconTitle = 'Create ' + !this.elementType

  -- Clear aid tags
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidTag)
  !this.name.val        = STRING()
  !this.description.val = STRING()
  !this.created         = false
  !this.extrusion       = object DBREF()
  !this.loop            = object DBREF()
  !this.plane           = object PLANE()
  !this.lastDefCount.clear()
  !this.lastDefType.clear()
  !this.positions.clear()
  !this.radii.clear()
  !this.aidNumbers.clear()
  !this.updateForm()

  -- Check if spec defaults have been loaded
  if(undefined(!!spcDefaults)) then
    call !!comDefineGlobal(object SPCDEFAULTS())
  endif

  -- Get Spec Defaults
  !default = !!spcDefaults.get(!this.specKey)
  if(!default.attributesData.set()) then
    !this.specDefault      = !default
    !this.thickness.val    = !default.attributesData[1]
  else
    !this.specDefault      = object SPCDEFAULT()
    !this.thickness.val    = 0
  endif

  -- if GWALL then default justification to bottom
  if (!this.elementType.set()) then
    if (!this.elementType.upcase() inset('GWALL','SCREED')) then
      !dText    = ARRAY()
      !rText    = ARRAY()
      !dText.append('Bottom')
      !rText.append('DBOT')
      !dText.append('Centre')
      !rText.append('UCEN')
      !dText.append('Top')
      !rText.append('UTOP')
      !this.justification.dText = !dText
      !this.justification.rText = !rText
    else
      !dText    = ARRAY()
      !rText    = ARRAY()
      !dText.append('Top')
      !rText.append('UTOP')
      !dText.append('Centre')
      !rText.append('UCEN')
      !dText.append('Bottom')
      !rText.append('DBOT')
      !this.justification.dText = !dText
      !this.justification.rText = !rText
    endif
  endif

  -- Specific code for .elementType eq GWall
  if (!this.elementType.upcase() eq 'GWALL') then
    !this.thickness.tag = '   Height'
    !this.thickness.val = 0
--     -- Get the default value from the cdWallSpecD form
--     if (defined (!!cdWallSpecD)) then
--       !wallSpecDefForm = !!cdWallSpecD
--       !spref = !wallSpecDefForm.spre.val
--       !dtRef = !wallSpecDefForm.spre.val.dbRef().dtRef
--       handle any
--         -- might not be a DTREF
--       endhandle
--       -- If there is a dtref then go through each data to find the HEIG data
--       if (defined (!dtRef)) then
--         do !i indices !dtRef.members
--           if (!dtRef.members[!i].dKey.upcase() eq 'HEIG') then
--             if (!dtRef.members[!i].purpose eq 'DESP') then
--               !despNum = !dtRef.members[!i].number
--               -- Having found the desp number read the correct wall spec defaults gadget
--               !despOnForm = !wallSpecDefForm.desp.dText[!despNum].split()
--               !heigDesp = !despOnForm[4].real()
--               -- Make sure units are used, until we completely code in mm.
--               -- (A design parameter is unit less but represents mm)
--               var !units SPLIT UNITS
--               if (!units[3] neq 'MM') then
--                 -- convert mm to inches
--                 !heigDesp = !heigDesp / 25.4
--               endif
--               !this.thickness.val = !heigDesp
--               -- we've found the desp so break out of do loop
--               break
--             endif
--           endif
--         enddo
--       endif
--     endif
  else
     !this.thickness.tag = 'Thickness'
  endif
  -- End of Specific code for .elementType eq GWall

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- If there is no panel created, then
  if(!this.loop.unset()) then
    -- Try to build again because could have been at wrong hierarchy
    !this.build()
    -- If there is still no panel created, then give a warning
    if(!this.loop.unset()) then
      !!alert.message('Unable to create ' + !this.elementType + ' with less than three vertices defined.')
      return
    endif
  endif

  -- Initialise Variables
  !reference = !!ce

   -- Apply data to panel
  !!ce = !this.extrusion
  DESC |$!this.description.val|
  !obstruction = !this.obstruction.selection()
  OBST  $!obstruction
  if(!this.fromLevel.val le !this.toLevel.val) then
    LEVEL $!this.fromLevel.val $!this.toLevel.val
  else
    LEVEL $!this.toLevel.val $!this.fromLevel.val
  endif

  -- Autoname
  if(!!pltCreate.autoName.selection().boolean()) then
    !name = !!namOpt.nameString(!!ce, '', false, false)

  -- Use specified
  else
    !name = !this.name.val
  endif

  -- Name
  if(!name.set()) then
    NAME $!<name>
    handle ANY
      -- Fix for DFN2216
      NAME /$!<name>
      handle ANY
      endhandle
    endhandle
  endif

  if (!this.elementType.upcase() neq 'GWALL') then
    SPRE $!<this.specDefault.component>
    handle any
    endhandle
  endif

  -- Close
  !this.close()

  -- OLD CODE and CALL TO PMDSUI
  if(!this.displayModify.val) then
    call !!dbeLoopEdit(!this.extrusion, !this.extrusion.type)
  endif

  !!ce = !reference

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()


  -- If there is no panel created, then give a warning
  if(!this.loop.set()) then
    if(!!alert.confirm('Created ' + !this.elementType + ' during the definition, do you want to retain the defined ' + !this.elementType + '?.').boolean().not()) then
      !!ce = !this.extrusion
      DELETE $!<this.elementType>
    endif
  endif

  -- Close
  !this.close()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Tidy
  !this.tidy()

  -- Hide form
  !this.hide()

  -- Remove EDG
  !!edgCntrl.remove('Panel Creation')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid elements
  do !i indices !this.aidNumbers
    !!aidNumbers.remove(!this.aidNumbers[!i])
  enddo
  !!aidNumbers.hide(!this.aidTag)
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      updateForm
--
-- Description: Update form information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateForm()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidTag)

  -- No vertices defined
  if(!this.loop.unset() and !this.positions.size() eq 0) then
    !this.detail.val      = 'No vertices currently defined'
    !this.remove.active   = false
    !this.tidy()

  -- No panel created, but vertices defined
  elseif (!this.loop.unset() and !this.positions.size() gt 0) then
    !this.detail.val      = !this.positions.size().string() & ' Vertices defined (no ' + !this.elementType + ' created)'
    !this.remove.active   = true

    -- Tag the origin
    AID TEXT NUMBER $!<this.aidTag> 'Origin' AT $!<this.positions[1]>

    -- Tag the last point
    if(!this.positions.size() gt 1) then
      !last = !this.positions.size()
      AID TEXT NUMBER $!<this.aidTag> 'Last Vertex' AT $!<this.positions[$!<last>]>
    endif

  -- More than 3 vertices
  elseif (!this.loop.set()) then

    -- See how many vertices are in the loop
    !last         = !this.loop.mCount

    -- No vertices, only tag panel origin
    if(!last eq 0) then

      !this.remove.active   = false
      !this.detail.val      =  'No vertices currently defined ( ' + !this.elementType + ' created)'
--       !this.tidy()
      !position = !this.extrusion.position
      AID TEXT NUMBER $!<this.aidTag> '$!<this.elementType> Origin' AT $!<position>
    -- Tag start of loop
    elseif (!last gt 0) then
      !this.remove.active   = true
      !this.detail.val      = !this.positions.size() + !this.loop.mCount & ' Vertices defined ( ' + !this.elementType + ' created)'
      !position = !this.loop.members[1].position
      AID TEXT NUMBER $!<this.aidTag> 'Origin' AT $!<position>
      if(!last gt 1) then
        !position = !this.loop.members[!last].position
        AID TEXT NUMBER $!<this.aidTag> 'Last Vertex' AT $!<position>
      endif
    endif
  endif

endmethod
-- End of method definition for .updateForm()

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Set representation data to selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .representation()

  -- Initialise Variables
  !key = !this.perDefinedObs.selection()

  -- Get representation from system
  -- OLD CODE with BACKWARDS CALLS
  $m "%PDMSUI%/CLIB/FILES/RDREP-DAT" $<KEY$> $<$!key$>
  if (defined(!!cdinRtn)) then
    !this.obstruction.select('RTEXT',!!cdinRtn)
    !this.fromLevel.val  = !!cdiaRtn[1].real()
    !this.toLevel.val    = !!cdiaRtn[2].real()
  endif

endmethod
-- End of method definition for .representation()

------------------------------------------------------------------------
--
-- Method:      thickness
--
-- Description: Set thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thickness()

  -- Initialise Variables
  !reference = !!ce


  if (!this.elementType neq 'GWALL') then
    -- If spec default is set, then check to see if we want to ignore it
    if(!this.specDefault.set()) then
      -- is there a acceptable range in the spec
      !specAnswer = !this.specDefault.component.answer
      !specMaxAns = !this.specDefault.component.maxAnswer
      if (!this.thickness.val.between(!specAnswer, !specMaxAns).not()) then
        if(!!alert.confirm('Do you want to override the default specification thickness? The Specification will be unset').boolean()) then
          !this.specDefault = object SPCDEFAULT()
          if (!this.extrusion.set()) then
            !!ce = !this.extrusion
            SPREF $!<this.specDefault.component>
          endif
        else
          !this.thickness.val = !this.specDefault.attributesData[1]
          return
        endif
      endif
    endif

    if (!this.loop.set()) then
      !!ce = !this.loop
      HEIGHT $!<this.thickness.val>
    endif
  endif

  !!ce = !reference

endmethod
-- End of method definition for .thickness()

------------------------------------------------------------------------
--
-- Method:      justification
--
-- Description: Set justifications
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .justification()

  -- Return if there is no loop
  if(!this.loop.unset()) then
    return
  endif

  -- Initialise Variables
  !reference = !!ce

  -- Move to loop and set justification
  !!ce = !this.loop
  !justification = !this.justification.selection()
  SJUST $!<justification>
  !!ce = !reference

endmethod
-- End of method definition for .justification()

------------------------------------------------------------------------
--
-- Method:      removeLast
--
-- Description: Remove last vertices point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeLast()

  -- Initialise Variables
  !removed        = false

  -- Get number of points that were last defined
  !last           = !this.lastDefCount.size()
  !lastDefCount   = !this.lastDefCount[!last]
  !lastDefType    = !this.lastDefType[!last]

  -- If there is no loop created, then we are looking at the .positions/.radii members
  if(!this.loop.unset()) then

    -- Get the last point in the list
    !lastPoint = !this.positions.size()

    -- If there are more than the last definition, remove them
    if(!lastPoint gt 0 and !lastPoint ge !lastDefCount) then

      !beginLast  = !lastPoint - !lastDefCount + 1
      !this.positions.removeFrom(!beginLast, !lastDefCount)
      !this.radii.removeFrom(!beginLast, !lastDefCount)
      !removed    = true

    endif

  -- Loop Defined
  else

    -- Get the last point in the list
    !lastPoint = !this.loop.mCount

    -- If there are more than the last definition, remove them
    if(!lastPoint gt 0 and !lastPoint ge !lastDefCount) then

      -- Current element
      !reference  = !!ce
      !!ce        = !this.loop

      !beginLast  = !lastPoint - !lastDefCount + 1

      DELETE PLOOP MEMB $!<beginLast> TO $!<lastPoint>

      !!ce        = REFERENCE
      !removed    = true

    endif

  endif

  -- If anything removed
  if(!removed) then

    -- Remove last definition
    !this.lastDefCount.remove(!last)
    !this.lastDefType.remove(!last)

    -- Update form
    !this.updateForm()

    -- Previous
    !previous = !last - 1

    -- Previous Definition now becomes the last definition
    if(!previous gt 0) then

      !prevDefType    = !this.lastDefType[!previous].upcase()

       -- Get the last aid item in the list
      !aidIndex       = !this.aidNumbers.size()

      -- If there is an aid item, then we'll remove it, unless its was a trace
      if(!aidIndex gt 0 and !lastDefType ne 'TRACE') then

        -- Remove aid from system and index list of the form
        !!aidNumbers.remove(!this.aidNumbers[!aidIndex])
        !this.aidNumbers.remove(!aidIndex)

        -- If the previous definition type was a point, then also remove it
        if(!aidIndex gt 1 and !prevDefType eq 'POINT' and !lastDefType eq 'ARC') then
          !!aidNumbers.remove(!this.aidNumbers[!aidIndex - 1])
          !this.aidNumbers.remove(!aidIndex - 1)
        endif

      endif
      !this.remove.tag = 'Remove Previous ' & !this.lastDefType[!previous]

    -- No previous definition
    else
      !this.remove.tag = 'Nothing to remove'
    endif

  endif

endmethod
-- End of method definition for .removeLast()

------------------------------------------------------------------------
--
-- Method:      definePoints
--
-- Description: Setup EDG mode for defining by graphic picks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePoints()

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition('Define vertex')
  !packet.action         = '!!pltCreate.position(!this.return[1].position)'
  !packet.key            = 'POS3D'
  !packet.description    = 'Panel Creation'
  !packet.type           = 'pos3D'
  !packet.priority       = 1
  !packet.remove         = false

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .definePoints()

------------------------------------------------------------------------
--
-- Method:      defineCLine
--
-- Description: Setup to derive point by mid-point of plines and panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineCLine()

  -- Get data
  $m "%PDMSUI%/DES/PANEL/RCENTLINE"
  if($!!cdRtnStatus neq 0) then
    return
  endif

  -- Add data to vertex members
  !this.positions.append(!!cdcnRtn.position())
  !this.radii.append(0)

  -- Current Definition
  !this.lastDefCount.append(1)
  !this.lastDefType.append('Point')
  !this.remove.tag = 'Remove Previous Point'

  -- Process data
  !this.build()

endmethod
-- End of method definition for .defineCLine()

------------------------------------------------------------------------
--
-- Method:      defineTrace
--
-- Description: Setup to define edge by tracing another panel/extrusion
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineTrace()

  -- Get data
  $m "%PDMSUI%/DES/CLIB/RGETVERT"
  if($!!cdRtnStatus neq 0) then
    return
  endif

  -- Get position & radii of vertices
  var !xyz EVALUATE (POSI WRT WORLD ) FOR ALL FROM !!cdpaRtn
  var !rad EVALUATE (FRAD WRT WORLD ) FOR ALL FROM !!cdpaRtn

  -- Add data to vertex members
  do !i indices !!cdpaRtn
    !this.positions.append(!xyz[!i].position())
    !this.radii.append(!rad[!i])
  enddo

  -- Current Definition
  !this.lastDefCount.append(!!cdpaRtn.size())
  !this.lastDefType.append('Trace')
  !this.remove.tag = 'Remove Previous Trace'

  -- Build
  !this.build()

endmethod
-- End of method definition for .defineTrace()

------------------------------------------------------------------------
--
-- Method:      defineExplicit
--
-- Description: Setup EDG mode to define points explicitly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineExplicit()

  -- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- Get position of last loop element
  if(!this.loop.set() and !this.loop.mCount gt 0) then
    !position = !this.loop.members[!this.loop.mCount].position

  -- Get last vertex position
  elseif (!this.positions.size() eq 0) then
    !position = N0

  -- Use last positions position
  else
    !position = !this.positions[!this.positions.size()]
  endif

  -- Show standard basic position definition
  !!pos3D.edit('!!pltCreate.position(!this.position())', !position, 'Define vertex', 'Vertex position', true, !this.elementType + ' Creation')

endmethod
-- End of method definition for .defineExplicit()

------------------------------------------------------------------------
--
-- Method:      defineOffset
--
-- Description: Setup EDG mode to define with relative offset from previous
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineOffset()

  -- Load associated form, if not loaded
  if(undefined(!!pos3DOffset)) then
    pml reload form !!pos3DOffset
  endif

  -- Get position of last loop element
  if(!this.loop.set() and !this.loop.mCount gt 0) then
    !position = !this.loop.members[!this.loop.mCount].position

  -- Get last vertex position
  elseif (!this.positions.size() eq 0) then
    !position = N0

  -- Use last positions position
  else
    !position = !this.positions[!this.positions.size()]
  endif

  -- Offset the position by 1000mm
  -- if(!!pos3DOffset.distance.val eq 0) then
  --   !refPosition = !position.offset(!!pos3DOffset.direction.val, 1000mm)
  -- endif

  -- Show standard basic position definition
  !!pos3DOffset.edit('!!pltCreate.position(!this.position())', !position, !position, 'Define vertex', 'Vertex position', true, !this.elementType + ' Creation')

endmethod
-- End of method definition for .defineOffset()

------------------------------------------------------------------------
--
-- Method:      defineFillet
--
-- Description: Setup EDG mode to define point using fillet method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineFillet()

  -- Initialise Variables
  !packet                   = object EDGPACKET()
  !packet.defineCircle('fillet')
  !packet.description       = 'Panel Creation'
  !packet.action            = '!!pltCreate.arc(!this.return[1])'
  !packet.type              = 'pos3D'
  !packet.priority          = 1
  !packet.remove            = false
  !packet.pickPacket.prompt = !this.elementType + ' arc (fillet)'

  -- Add to system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .defineFillet()

