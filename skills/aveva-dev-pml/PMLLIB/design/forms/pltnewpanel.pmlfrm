-- File:            pltnewpanel.pmlfrm
--   Type:          Form Definition
--   Group:         Panel :group: Plate Application
--     Keyword:     PLATE
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Fri Dec 05 09:41:00 1997
--
--
-- Description:
-- Form for creating a panel with arbitrary orientation and position
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkWrt()                       -                   Check wrt gadget input
--  display()                        -                   Draw Aid to show current plane definition
--  lockIt(BOOLEAN,GADGET,GADGET)    -                   Lock gadget values
--  onePick()                        -                   Set up event driven graphics
--  saveOri(EDGPICKDATA)             -                   Process orientation
--  savePosFirst(STRING)             -                   Process first position and set up next prompt
--  savePosSecond(STRING)            -                   Process second position and set up next prompt
--  savePosThird(STRING)             -                   Process third position and set up next prompt
--  start()                          -                   Load gadget values
--  threePick()                      -
--  tidy()                           -
--  trace()                          -
--
------------------------------------------------------------------------

-- Define form
setup form !!pltNewPanel

  !!pltNewPanel.formTitle     = 'Create Panel'
  !!pltNewPanel.iconTitle     = 'EXTRUSION CREATE'
  !!pltNewPanel.callback      = ''
  !!pltNewPanel.formRevision  = ' $Revision: 1.19 $ '

  -- Body of form definition

  member .points is ARRAY
  member .traced is DBREF
  member .vertexNo is ARRAY
  member .plane is PLANE
  member .extruType is STRING

     path down
     -- Element Name
     text .name |Name| at x 0.5 y 0.5 callback 'call !!nameGadget(!!pltNewPanel.name,|NEW|)' width 27 is STRING

     -- Justification
     option .just 'Justification'  width 6
     !justD = 'Top Centre Bottom'
     !!pltNewPanel.just.dText = !justD.split()

     text .thickness 'Thickness' width 12 is REAL
     text .angle 'Angle' width 6 is REAL

  -- Plane Pos and Ori Frame
  frame .pFrame 'Plane' at xmin.name ymax+0.25 width 30 height 3

     -- Plane Origin

     -- East
     option .east at xmin+1 ymin.pFrame+2 callback '!!pltNewPanel.display( )' width 8
     !listD = 'East West'
     !!pltNewPanel.east.dText = !listD.split()
     text .easting at xmax+1 ymin callback '!!pltNewPanel.display( )' width 12 is REAL format !!distanceFmt
     toggle .eastLock at xmax+1 ymin callback '!!pltNewPanel.lockIt(_eastLock.val.not(), _east, _easting)'

     --toggle heading
     paragraph .lock at xmin-0.8 ymin-1 text 'Lock'

     -- North
     option .north at xmin.east ymax.easting+0.25 callback '!!pltNewPanel.display()' width 8
     !listD = 'North South'
     !!pltNewPanel.north.dText = !listD.split()
     text .northing at xmax+1 ymin callback '!!pltNewPanel.display()' width 12 is REAL format !!distanceFmt
     toggle .northLock at xmax+1 ymin callback '!!pltNewPanel.lockIt(_northLock.val.not(), _north, _northing)'

     -- Up
     option .up at xmin.east ymax.northing+0.25 callback '!!pltNewPanel.display()' width 8
     !listD = 'Up Down'
     !!pltNewPanel.up.dText = !listD.split()
     text .uping at xmax+1 ymin callback '!!pltNewPanel.display()' width 12 is REAL format !!distanceFmt
     toggle .upLock at xmax+1 ymin callback '!!pltNewPanel.lockIt(_upLock.val.not(), _up, _uping)'

     -- Plane Orientation
     paragraph .oriPara1 at xmin.pFrame+1 ymax.uping+0.25 text 'Ori'
     option .oriAOpt at xmax ymin callback '!!pltNewPanel.display()' width 2
     !listD = 'X Y Z'
     !!pltNewPanel.oriAOpt.dText = !listD.split()
     paragraph .oriPara2 at xmax+0.5 ymin text 'is'
     text .orientA at xmax+0.5 ymin callback '!!pltNewPanel.display()' width 12 is STRING
     toggle .oriLock at xmax+1 ymin callback '!!pltNewPanel.lockIt(_oriLock.val.not(), _oriAOpt, _orientA)'

     -- Grain Orientation
     paragraph .oriPara3 at xmin.pFrame+1 ymax+0.25 text 'and'
     option .oriBOpt at xmax ymin callback '!!pltNewPanel.display()'  width 2
     !!pltNewPanel.oriBOpt.dText = !listD.split()
     paragraph .oriPara4 at xmax+0.5 ymin text 'is'
     text .orientB at xmax+0.5 ymin callback '!!pltNewPanel.display()' width 12 is STRING
     toggle .grainLock at xmax+1 ymin callback '!!pltNewPanel.lockIt(_grainLock.val.not(), _oriBOpt, _orientB)'

     -- Wrt
     text .wrt 'wrt    ' at xmin.up+6 ymax+0.25 callback '!!pltNewPanel.checkWrt()'  width 16 is STRING

  exit

     -- Radio Group for panel/plane creation method
     para .methodTag at xmin.pFrame ymax.pFrame+0.25 text 'Method'
     rgroup .methodrg at xmin ymax HORIZONTAL
       add tag '1 point ' callback '!!pltNewPanel.onePick()'
       add tag '3 points' callback '!!pltNewPanel.threePick()'
--       add tag 'Trace   ' callback '!!pltNewPanel.trace()'
     exit
     toggle .create 'Create Vertices From Definition' at xmin.pFrame ymax

  -- Bottom Line
  button .dismiss 'Cancel' at xmax form-size ymax+0.5 callback '!!pltNewPanel.tidy()' CANCEL
  button .apply   ' OK ' at xmin form+0    ymin callback '!!pltNewPanelGo()'  OK

exit
-- End of form definition for !!pltNewPanel
------------------------------------------------------------------------
--
-- Method:      start
--
-- Description:  Load gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .start()

-- Sort out thickness and angle
if (!this.extruType eq 'PANE' ) then
     !this.thickness.val  = !!cdPaneSpecD.thk.val.real()
      handle any
           !this.thickness.val = 1000mm
           !!pltNewPanel.thickness.active = true
      elsehandle none
           if (unset(!!cdPaneSpecD.thk.val.real() ) or !!cdPaneSpecD.thk.val.real() le 0 ) then
                !this.thickness.val = 1000mm
                !!pltNewPanel.thickness.active = true
           else
                !!pltNewPanel.thickness.active = false
           endif
      endhandle
      !!pltNewPanel.angle.active = false
elseif (!this.extruType eq 'REVO' or !this.extruType eq 'NREV' ) then
    !this.angle.val = 360
     !!pltNewPanel.thickness.active = false
    !!pltNewPanel.angle.active = true
else
    !this.thickness.val = 1000mm
     !!pltNewPanel.thickness.active = true
     !!pltNewPanel.angle.active = false
endif
-- Sort out position gadgets
 if (not !this.eastLock.val ) then
      !this.east.val = 1
      !this.easting.val = 0
 endif
 if (not !this.northLock.val ) then
      !this.north.val = 1
      !this.northing.val = 0
 endif
 if (not !this.upLock.val ) then
      !this.up.val = 1
      !this.uping.val = 0
 endif

-- Check Element is valid
!dbRef = !this.wrt.val.dbRef()
handle any
     !this.wrt.val = 'WORLD'
endhandle
if (!dbRef.unset() ) then
     !this.wrt.val = 'WORLD'
endif

-- Sort out initialisation gadgets
if (not !this.oriLock.val ) then
     if (!this.grainLock.val and !this.orientB.val eq 'N' ) then
          !this.oriAOpt.val = 2
          !this.orientA.val = 'N'
     else
          !this.oriAOpt.val = 2
          !this.orientA.val = 'N'
     endif
endif
if (not !this.grainLock.val ) then
     if (!this.orientA.val eq 'U' ) then
          !this.oriBOpt.val = 3
          !this.orientB.val = 'N'
     else
          !this.oriBOpt.val = 3
          !this.orientB.val = 'U'
     endif
endif

-- Reinitialise data behind form
!this.points.clear()
!this.points[1] = object POSITION()
!this.points[1].east = !this.easting.val
!this.points[1].north = !this.northing.val
!this.points[1].up = !this.uping.val
!this.points[1].origin = WORLD
!this.plane = object PLANE()
!this.plane.position = !this.points[1]
!string = !this.oriAOpt.selection() & ' is ' & !this.orientA.val & ' and ' & !this.oriBOpt.selection() & ' is ' & !this.orientB.val & ' WRT ' & !this.wrt.val
!gadgetOri = !string.orientation()
handle any
      !this.oriAOpt.val = 2
      !this.oriBOpt.val = 3
      !this.orientA.val = 'N'
      !this.orientB.val = 'U'
      !string = !this.oriAOpt.selection() & ' is ' & !this.orientA.val & ' and ' & !this.oriBOpt.selection() & ' is ' & !this.orientB.val & ' WRT ' & !this.wrt.val
      !gadgetOri = !string.orientation()
endhandle
!this.plane.orientation = !gadgetOri

-- Display current settings
!this.display()

endmethod
-- End of method definition for .start()
------------------------------------------------------------------------
--
-- Method:      lockIt
--
-- Description:  Lock gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Grey out gadget
--    2   R      GADGET      option gadget
--    3
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .lockIt(!active is BOOLEAN, !option is GADGET, !text is GADGET)

!option.active = !active
!text.active   = !active

endmethod
-- End of method definition for .lockIt(BOOLEAN, GADGET, GADGET)
------------------------------------------------------------------------
--
-- Method:      onePick
--
-- Description:  Set up event driven graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .onePick()

!!edgCntrl.remove('Create Panel Three Picks')
!!edgCntrl.remove('Create Panel One Pick')
!!edgCntrl.remove('Create Panel Trace')

!packet = object EDGPACKET()
!packet.defineWrapper('POSITION','!!pltNewPanel.savePosFirst(|ONE|)','Pick origin for panel')
!packet.description = 'Create Panel One Pick'

!!edgCntrl.add(!packet)
!this.start()

endmethod
-- End of method definition for .onePick()
------------------------------------------------------------------------
--
-- Method:      threePick
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .threePick()

!!edgCntrl.remove('Create Panel Three Picks')
!!edgCntrl.remove('Create Panel One Pick')
!!edgCntrl.remove('Create Panel Trace')

!packet = object EDGPACKET()
!packet.defineWrapper('POSITION','!!pltNewPanel.savePosFirst(|THREE|)','Pick origin for panel')
!packet.description = 'Create Panel Three Picks'

!!edgCntrl.add(!packet)
!this.start()

endmethod
-- End of method definition for .threePick()
------------------------------------------------------------------------
--
-- Method:      trace
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .trace()

!!edgCntrl.remove('Create Panel Three Picks')
!!edgCntrl.remove('Create Panel One Pick')
!!edgCntrl.remove('Create Panel Trace')

!packet = object EDGPACKET()
!packet.defineWrapper('POSITION','!!pltNewPanel.savePosFirst(|TRACE|)','Pick start point on panel')
!packet.description = 'Create Panel Trace'

!!edgCntrl.add(!packet)
!this.start()

endmethod
-- End of method definition for .trace()
------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

!!edgCntrl.remove('Create Panel Three Picks')
!!edgCntrl.remove('Create Panel One Pick')
!!edgCntrl.remove('Create Panel Trace')

AID CLEAR LINE 42001
handle any
endhandle
AID CLEAR TEXT 42002
handle any
endhandle
AID CLEAR TEXT 42001
handle any
endhandle
AID CLEAR SPHERE 42001
handle any
endhandle
AID CLEAR BOX 42001
handle any
endhandle
AID CLEAR ARROW 42001
handle any
endhandle

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      savePosFirst
--
-- Description:  Process first position and set up next prompt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .savePosFirst(!mode is STRING)

-- Save position
     !this.points[1] = !!edgGeomData.position.wrt(!this.wrt.val.dbRef())
-- Update position gadgets
     if (not !this.eastLock.val ) then
          if (!this.points[1].east lt 0) then
              !this.east.val = 2
          else
              !this.east.val = 1
          endif
          !this.easting.val = !this.points[1].east.abs()
     else
          !this.points[1].east = !this.easting.val
     endif
     if (not !this.northLock.val ) then
          if (!this.points[1].north lt 0) then
              !this.north.val = 2
          else
              !this.north.val = 1
          endif
     !this.northing.val = !this.points[1].north.abs()
     else
          !this.points[1].north = !this.northing.val
     endif
     if (not !this.upLock.val ) then
          if (!this.points[1].up lt 0) then
              !this.up.val = 2
          else
              !this.up.val = 1
          endif
          !this.uping.val = !this.points[1].up.abs()
     else
          !this.points[1].up = !this.uping.val
     endif
-- Save Orientation
     !this.plane.position = !this.points[1]
     !this.display()
-- Set up prompts for next stage
     if (!mode eq |THREE|) then
         !!edgCntrl.remove('Create Panel Three Picks')
         !packet = object EDGPACKET()
         !packet.defineWrapper('POSITION','!!pltNewPanel.savePosSecond(|THREE|)','Pick second point to define orientation')
         !packet.description = 'Create Panel Three Picks'
          !!edgCntrl.add(!packet)
     elseif (!mode eq |TRACE| ) then
         !this.traced = !!edgGeomData.pickedItem
-- Save Vertex Number
         !vertex = !!edgGeomData.nearestVertex
         !vertexNo[1] = !vertex.owner.members.findFirst(!vertex)
-- Set up prompts for next stage
         !!edgCntrl.remove('Create Panel Trace')
         !packet = object EDGPACKET()
         !packet.defineWrapper('ELEMENT','!!pltNewPanel.savePosSecond(|TRACE|)','Pick last point on panel')
         !packet.description = 'Create Panel Trace'
     else
-- Set up prompt for orientation
  !packet                = object EDGPACKET()
  !packet.key            = 'planePacket'
  !packet.description    = 'Create Panel One Pick'
  !packet.type           = 'gph'
  !packet.priority       = 0
  !packet.action         = '!!pltNewPanel.saveOri(!this.return[1])'
  !packet.remove         = false
  !packet.pickPacket.stdAny('Pick facet or grid to define orientation')
  !packet.pickPacket.picks[1].prompt         = STRING()
  !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
  !packet.pickPacket.picks[1].pick.stdGraphics()
  !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
  !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
  !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
  !packet.pickPacket.picks[1].pick.input[10] = /*
  !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'

  -- Set priority
  !packet.priority       = 1

  -- Add into EDG system
  !!edgCntrl.add(!packet)

     endif

endmethod
-- End of method definition for .savePosFirst(STRING)

------------------------------------------------------------------------
--
-- Method:      saveOri
--
-- Description:  Process orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA    Information from pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .saveOri(!pickData is EDGPICKDATA)

  -- Initialise Variables

  -- Special Case Picks (ie items that can be used as a plane in their
  -- own right)
  if(!pickData.type eq 'DESIGNAID') then

    if(!!aidNumbers.numbers[!pickData.point].objectType() inset('GPHPLANE','GPHLINEARGRID','GPHPLANTGRID','GPHRADIALGRID')) then

      -- Get plane

      if(!!aidNumbers.numbers[!pickData.point].objectType() eq 'GPHPLANE') then

        !plane = !!aidNumbers.numbers[!pickData.point].plane

      else

        !plane = !!aidNumbers.numbers[!pickData.point].plane()

      endif

    else

      !!alert.error('Unable to derived plane from picked element.')
    endif


  -- Use "plane" picked
  else

    !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
    handle any
      !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
    endhandle

  endif
-- Save the orientation
  !this.plane.orientation = !plane.orientation
     -- Update Gadgets
     !orientString = !this.plane.orientation.wrt(!this.wrt.val.dbRef()).string()
     if (!this.oriLock.val.not() ) then
          !this.oriAOpt.select('RTEXT', !orientString.part(1).trim() )
          !this.orientA.val = !orientString.before('and').after('is')
     endif
     if (!this.grainLock.val.not() ) then
          !this.oriBOpt.select('RTEXT', !orientString.after('and').before('is').trim() )
          !this.orientB.val = !orientString.after('and').after('is').before('WRT')
     endif
     -- Display orientation
     !this.display()



endmethod
-- End of method definition for .saveOri(EDGPICKDATA)
------------------------------------------------------------------------
--
-- Method:      savePosSecond
--
-- Description:  Process second position and set up next prompt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .savePosSecond(!mode is STRING)

     -- Save position
     !this.points[2] = !!edgGeomData.position
-- Display position of origin
     call !!clearAid('SPHERE', 42001)
     call !!drawAidSphere(200,!this.points[2],42001)
-- Set up prompts for next stage
     if (!mode eq |THREE|) then
         !!edgCntrl.remove('Create Panel Three Picks')
         !packet = object EDGPACKET()
         !packet.defineWrapper('POSITION','!!pltNewPanel.savePosThird(|THREE|)','Pick third point to define orientation')
         !packet.description = 'Create Panel Three Picks'

          !!edgCntrl.add(!packet)
     else
-- Save Vertex Number
         !vertex = !!edgGeomData.nearestVertex
         !vertexNo[3] = !vertex.owner.members.findFirst(!vertex)
--  Set up prompts for next stage
         !!edgCntrl.remove('Create Panel Trace')
         !packet = object EDGPACKET()
         !packet.defineWrapper('ELEMENT','!!pltNewPanel.savePosThird(|THREE|)','Pick  intermediate point on panel')
         !packet.description = 'Create Panel Trace'

         !!edgCntrl.add(!packet)
     endif

endmethod
-- End of method definition for .savePosSecond(STRING)

------------------------------------------------------------------------
--
-- Method:      savePosThird
--
-- Description:  Process third position and set up next prompt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .savePosThird(!mode is STRING)

     -- Save position
     !this.points[3] = !!edgGeomData.position
     -- Calculate Orientation
     !this.plane = !this.points[1].plane(!this.points[2], !this.points[3] )
     if (!this.plane.unset() ) then
-- Need another point to define plane
          return
     endif
     -- Update Gadgets
     !orientString = !this.plane.orientation.wrt(!this.wrt.val.dbRef()).string()
     if (!this.oriLock.val.not() ) then
          !this.oriAOpt.select('RTEXT', !orientString.part(1).trim() )
          !this.orientA.val = !orientString.before('and').after('is')
     endif
     if (!this.grainLock.val.not() ) then
          !this.oriBOpt.select('RTEXT', !orientString.after('and').before('is').trim() )
          !this.orientB.val = !orientString.after('and').after('is').before('WRT')
     endif
     -- Display orientation
     !this.display()

if (!mode eq 'TRACE' ) then
-- Determine order
     !vertex = !!edgGeomData.nearestVertex
     !vertexNo[2] = !vertex.owner.members.findFirst(!vertex)
     !this.points.clear()
     if (!vertexNo[2] gt !vertexNo[1]) then
          if (!vertexNo[3] gt !vertexNo[2]) then
               if (!vertexNo[3] gt !vertexNo[1]) then
-- Vertex Order 1 < 2 < 3
                     do !index from !vertexNo[1] to !vertexNo[3]
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
               endif
          else
-- Vertex Order 1 < 3 < 2
               if (!vertexNo[3] gt !vertexNo[1]) then
                     do !index from !vertexNo[3] to !vertex.owner.mCount
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
                     do !index from 1 to !vertexNo[1]
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
               else
-- Vertex Order 3 < 1 < 2
                     do !index from !vertexNo[1] to !vertex.owner.mCount
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
                     do !index from 1 to !vertexNo[3]
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
               endif
          endif
     else
          if (!vertexNo[3] gt !vertexNo[2]) then
                if (!vertexNo[3] gt !vertexNo[1]) then
-- Vertex Order 2 < 1 < 3
                     do !index from !vertexNo[3] to !vertex.owner.mCount
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
                     do !index from 1 to !vertexNo[1]
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
               else
-- Vertex Order 2 < 3 < 1
                     do !index from !vertexNo[1] to !vertex.owner.mCount
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
                     do !index from 1 to !vertexNo[3]
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
               endif
          else
-- Vertex Order 3 < 2 < 1
                     do !index from !vertexNo[3] to !vertexNo[1]
                          !this.points.append(!vertex.owner.members[!index].position())
                     enddo
           endif
     endif
endif

endmethod
-- End of method definition for .savePosThird(STRING)

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:  Draw Aid to show current plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display()
-- Clear Existing Aids
AID CLEAR LINE 42001
handle any
endhandle
AID CLEAR TEXT 42002
handle any
endhandle
AID CLEAR TEXT 42001
handle any
endhandle
AID CLEAR SPHERE 42001
handle any
endhandle
AID CLEAR BOX 42001
handle any
endhandle
AID CLEAR ARROW 42001
handle any
endhandle
-- Calculate new position
    !position = object POSITION()
    if (!this.east.val eq 1 ) then
        !position.east = !this.easting.val
    else
        !position.east = - !this.easting.val
    endif
    if (!this.north.val eq 1 ) then
         !position.north = !this.northing.val
    else
        !position.north = - !this.northing.val
    endif
    if (!this.up.val eq 1 ) then
         !position.up = !this.uping.val
    else
         !position.up = - !this.uping.val
    endif
    !position.origin = !this.wrt.val.dbRef()

-- Display position of origin

     call !!drawAidSphere(200,!position,42001)
-- Calculate Orientation

          !string = !this.oriAOpt.selection() & ' is ' & !this.orientA.val & ' and ' & !this.oriBOpt.selection() & ' is ' & !this.orientB.val & ' WRT ' & !this.wrt.val
          !gadgetOri = !string.orientation()
          handle any
               !this.oriAOpt.val = 2
               !this.oriBOpt.val = 3
               !this.orientA.val = 'N'
               !this.orientB.val = 'U'
               !string = !this.oriAOpt.selection() & ' is ' & !this.orientA.val & ' and ' & !this.oriBOpt.selection() & ' is ' & !this.orientB.val & ' WRT ' & !this.wrt.val
               !gadgetOri = !string.orientation()
          elsehandle none
               !this.plane.orientation = !gadgetOri
          endhandle
     -- Display orientation
          !size = 4000mm
          call !!aidOrientate(42001, |Origin|, !position, !size ,!gadgetOri)

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      checkWrt
--
-- Description: Check wrt gadget input
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkWrt()

-- Check Element is valid
call !!nameGadget(!!pltNewPanel.wrt, 'OLD')

if (!this.wrt.val eq 'unset' ) then
     !this.wrt.val = 'WORLD'
endif

!this.display( )


endmethod
-- End of method definition for .checkWrt()
