--
--
-- Description:
-- Panel/Plate Specification form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the form
--  checkTypes(DBREF)                BOOLEAN             Check is passed elements types are same as current settings
--  close()                          -                   Close the form down
--  defaultFloor()                   -                   Setup form for setting default floor
--  defaultPlate()                   -                   Setup form for setting default plate
--  description()                    -                   Return description from current settings
--  loadSpecs()                      -                   Load specifications
--  pltSpecification()               -                   Constructor
--  select()                         -                   Select a plate specification
--  setFloor(DBREF)                  -                   Setup form for editing floors
--  setPlate(DBREF)                  -                   Setup form for editing plate
--  setup()                          -                   Setup form to current settings
--  setup(STRING)                    -                   Setup for "CE" selection
--  setup(STRING,STRING,ASLSTRLNGDATA) -                   setup the form
--  setup(STRING,STRING,STRING,DBREF) -                   Setup form with passed data
--  setupList(DBREF)                 -                   Populate specRefs gadget with members of passed spec
--  thickness(STRING)                -                   Set the thickness
--  thicknessInput()                 -                   Set thickness input gadget state
--
------------------------------------------------------------------------

setup form !!pltSpecification

  !!pltSpecification.formTitle     = 'Plate Specification'
  !!pltSpecification.iconTitle     = ''
  !!pltSpecification.callback      = ''
  !!pltSpecification.formRevision  = ' $Revision: 1.14 $ '

  -- Body of form definition

  -- Option
  --  option .ce  at xmin y0.5 callback '!this.setup(!this.ce.selection())' width 7
  button    .ce 'CE' at xmin ymax callback '!this.setup(''CE'')'

  -- Data
  paragraph .ceName at xmax+1 ymin width 30 lines 1

  -- Specification Data
  frame .specFrame 'Specification Data' at xmin.ce ymax width 45

    button .load 'Specification' at x1        ymax     callback '!this.loadSpecs()'
    option .specification        at xmax+1    ymin     callback '!this.setupList(!this.specification.selection().dbRef())' width 21

    -- Available specs
    list   .specRefs             at x0.7 ymax+0.2 callback '!this.select()'        width 39 length 6

    -- Thickness
    path   down
    halign right
    text   .thickness 'Thickness' callback '!this.thickness(|test|)' width 14 is REAL format !!distanceFmt

  exit

  --   Options
  frame .optionFrame     'Options' at xmin ymax width 45

    -- Use selection as default
    toggle .useAsDefault ' Use as default thickness' at x2 ymax

  exit

  -- Bottom Line
  button .apply    'Apply'   at xmin form-0    ymax+0.5 callback '!this.apply()'
  button .dismiss  'Dismiss' at xmax form-size ymin     callback '!this.close()'

  -- Form Members

  -- Element
  member .element     is DBREF
  member .loop        is DBREF
  member .pltThk      is REAL

  -- Current Spec
  member .currentSpec is DBREF

  -- Spec and specification world Types
  member .type        is STRING
  member .spwl        is STRING

  -- Form Mode
  member .mode        is STRING

  -- Spec Search Mechanism
  member .search      is SPCSEARCH

  -- Spec Selection
  member .selection   is SPCDEFAULT

  -- Spec Default Data
  member .key         is STRING
  member .default     is SPCDEFAULT

  -- Force MM format object
  member .format       is FORMAT

  -- Action on apply
  member .action       is BLOCK

  --stair landing Data
  member .strLngData   is ASLSTRLNGDATA

  -- contains the old handrail data
  member .oldStrLngData is ASLSTRLNGDATA

exit
-- End of form definition for !!pltSpecification

------------------------------------------------------------------------
--
-- Method:      pltSpecification
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltSpecification()

  -- Define format to force to mm regardless of current settings
  !this.format           = object FORMAT()
  !this.format.units     = 'MM'
  !this.format.dp        = 2
  !this.format.dimension = 'L'
  !this.oldStrLngData    = !this.strLngData

endmethod
-- End of method definition for .pltSpecification()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !reference = !!ce

  -- Write to default
  if(!this.useAsDefault.val) then
    !this.default     = !this.selection
    if(!this.key.unset() ) then
      !this.key       = 'default-' & !this.spwl & '-' & !this.type
    endif
    !this.default.key = !this.key

    if(undefined(!!spcDefaults)) then
      call !!comDefineGlobal(object SPCDEFAULTS())
    endif

    !!spcDefaults.replace(!this.default)

    -- Update main bar menu
    if(!this.spwl eq 'STL' and !this.type eq 'PLT') then
      $M "%PDMSUI%/DES/PANEL/ISYSTEM"
    elseif (!this.spwl eq 'CIV' and !this.type eq 'FLR' ) then
      $M "%PDMSUI%/DES/CIVIL/ISYSTEM"
    endif

  endif

  -- Apply specification to element
  if(!this.mode eq 'SET') then
    !!ce = !this.element
    SPRE $!<this.selection.component>
    !!ce = !this.loop
    HEIGHT $!<this.thickness.val>
    !!ce = !reference
  endif

  --check for changes any
  if !this.strLngData.eq(!this.oldStrLngData) then
  -- no changes have been made
    return
  endif

  !this.strLngData.lngSpec  =  !this.selection.component
  !this.strLngData.lngThk   =  !this.thickness.val

  --update the old stair landing Data
  !this.oldStrLngData = !this.strLngData

  -- Execute the action
  if ( !this.action.set() ) then
    !this.action.evaluate()
  endif

endmethod
-- End of method definition for .apply()

