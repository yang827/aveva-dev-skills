------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for "CE" selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Setup type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!option is STRING)

  -- Initialise Variables

  -- Setup for current element
  if(!option eq 'CE') then
    !this.setup(!this.mode, !this.spwl, !this.type, !!ce)

  -- Pick
  elseif (!option eq 'PICK') then

  -- List
  elseif (!option eq 'LIST') then

  endif

endmethod
-- End of method definition for .setup(STRING)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode, SET or DEFAULT
--    2   R      STRING      Spec World Type
--    3   R      STRING      Spec Type
--    4   R      STRING      Element specification is to be applied to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!mode is STRING, !spwlType is STRING, !specType is STRING, !passedElement is DBREF)

  -- Initialise Variables
  !spwl          = !spwlType
  !type          = !specType

  -- Check passed element it set
  if(!passedElement.set()) then

    !types[1]      = 'PANE'
    !types[2]      = 'FLOOR'
    !types[3]      = 'SCREED'
    !element       = !!dtbOwnerOfTypes(!passedElement, !types)
    if(!element.unset()) then
      !!alert.warning('This function can only be used on a PANEL or one of its soft types.')
      return
    endif

    -- Check we have access to update item
    if(!element.set() and !!dbRefUpdate(!element).not()) then
      !!alert.warning(!!error.text)
      return
    endif

    -- cannot change spec of bent plate
    if( !element.purpose eq 'BPLT' ) then
      !!alert.warning('Specification of a bent panel cannot be changed')
      return
    endif
  else
    !element = object DBREF()
  endif

  -- Set Data
  if(!this.mode ne !mode or !this.type ne !type or !this.spwl ne !spwl) then
    !this.mode            = !mode.upcase()
    !this.type            = !type.upcase()
    !this.spwl            = !spwl.upcase()

    -- Set specification search rules
    !this.search          = object SPCSEARCH()
    !this.search.spwlType = !this.spwl
    !this.search.type     = !this.type
    !this.loadSpecs()

  endif

  -- Check element
  if(!this.checkTypes(!element).not()) then
    return
  endif

  -- Initialise Variables

  -- Set Form Title
  !this.description()

  -- Setup form
  !this.setup()

  -- Show form
  !this.show()

endmethod
-- End of method definition for .setup(STRING, STRING, STRING, DBREF)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form to current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables

  -- Setup to default
  if(!this.mode eq 'DEFAULT') then

    -- "Default" spec key
    !this.key       = 'default-' & !this.spwl & '-' & !this.type

    -- Get Default Spec from spcDefaults object
    if(undefined(!!spcDefaults)) then
      call !!comDefineGlobal(object SPCDEFAULTS())
    endif

    !this.default   = !!spcDefaults.get(!this.key)
    !this.selection = !this.default
    !this.loop      = object DBREF()
    if(!this.default.attributesData.set()) then
      !this.pltThk    = !this.default.attributesData[1]
    else
      !this.pltThk    = 0
    endif

    -- Set default flag
    !this.useAsDefault.val    = true
    !this.useAsDefault.active = false

  -- Setup with element
  elseif (!this.mode eq 'SET') then

    -- Get Loop
    !this.loop                = !!dtbMemberOfType(!this.element, 'PLOO', 1)
    !this.pltThk              = !this.loop.height
    !this.selection.component = !this.element.spref
    if (!this.selection.component.set()) then
      !dbType[1] = 'SPEC'
      !this.selection.specification = !!dtbOwnerOfTypes(!this.element.spref, !dbType)
    else
      !!pltSpecification.specRefs.val = 1
      handle any
      endhandle
    endif

    if (!this.search.specifications.empty()) then
      !this.useAsDefault.active = false
    else
      !this.useAsDefault.active = true
    endif

  endif

  -- Setup form with current selection
  if(!this.selection.specification.set()) then
    !this.setupList(!this.selection.specification)

  -- Use current selection
  else
    if (!this.search.specifications.empty().not()) then
      !this.setupList(!this.specification.selection().dbRef())
    endif
  endif

  -- Select current component
  if(!this.selection.component.set()) then
    !this.specRefs.select('RTEXT', !this.selection.component.string())
  endif

   -- Set thickness
  !this.thickness.val = !this.pltThk.string().real(!this.format)

  if (!this.search.specifications.empty()) then
    !this.thickness.active = false
    !this.apply.active     = false
  else
    -- Set thickness input gadget
    -- !this.thicknessInput()
    !this.thickness.active = true
    !this.apply.active     = true
    !this.select()
  endif

endmethod
-- End of method definition for .setup()
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup(!title is STRING, !action is STRING, !strLngData is ASLSTRLNGDATA)

  --set the data for form
  -- Change form title
  !this.formTitle      = !title
  !this.action         = object BLOCK(!action)
  !this.strLngData     = !strLngData
  !this.defaultPlate()
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setupList
--
-- Description: Populate specRefs gadget with members of passed spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupList(!specification is DBREF)

  -- If specification and current selection are the same, then we don't need
  -- to do anything
  if(!specification eq !this.currentSpec) then
    return
  endif

  -- Select the specification
  !this.specification.select('RTEXT', !specification.string())

  -- Initialise Variables
  !this.currentSpec = !specification
  !this.specRefs.clear()

  !minThk           = ARRAY()
  !maxThk           = ARRAY()
  !min              = ARRAY()
  !max              = ARRAY()
  !dText            = ARRAY()
  !rText            = ARRAY()

  -- Loop through members
  do !i indices !specification.members
    !minimum = !specification.members[!i].answer.string().real(!this.format).string(!!distanceFmt)
    !maximum = !specification.members[!i].maxAnswer.string().real(!this.format).string(!!distanceFmt)

    -- Sort Array
    !minThk.append(!specification.members[!i].answer.queryString().real())
    !maxThk.append(!specification.members[!i].maxAnswer.queryString().real())

    -- Range
    !min.append(!minimum.string(!!distanceFmt))
    !max.append(!maximum.string(!!distanceFmt))

    -- Reference element
    !rText.append(!specification.members[!i].string())
  enddo

  -- Sort on thicknesses
  !sort = !maxThk.sortedIndices()
  !min.reIndex(!sort)
  !max.reIndex(!sort)
  !minThk.reIndex(!sort)
  !maxThk.reIndex(!sort)
  !rText.reIndex(!sort)

  -- Build display
  !maxMin = !min.width() + 4
  !maxMax = !max.width()

  -- Alignment
  if(!!distanceFmt.units ne 'MM') then
    !align = 'L'
  else
    !align = 'R'
  endif

  do !i indices !rText

    if(!minThk[!i] ne !maxThk[!i]) then
      var !dprt COMPOSE SPACE 2 |$!min[$!i] TO | WIDTH $!maxMin $!align  |$!max[$!i]| WIDTH $!maxMax $!align
    else
      var !dprt COMPOSE SPACE 2 |$!min[$!i]    | WIDTH $!maxMin $!align
    endif
    !dText[!i] = !dprt[1]
  enddo

  !dText.insert(1, 'Unset')
  !rText.insert(1, 'Unset')

  !this.specRefs.dText = !dText
  !this.specRefs.rText = !rText

endmethod
-- End of method definition for .setupList(DBREF)


------------------------------------------------------------------------
--
-- Method:      checkTypes
--
-- Description: Check is passed elements types are same as current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be tested
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is element spre is unset or types are the same
--
------------------------------------------------------------------------

define method .checkTypes(!element is DBREF) is BOOLEAN

  -- Initialise Variables

  -- If element is set and spre is set, get spwl and spec type
  if(!element.set() and !element.spref.set()) then

    -- Get Spec and Spec world
    !types[1] = 'SPEC'
    !spec     = !!dtbOwnerOfTypes(!element.spref, !types)
    handle any
      !this.selection = object SPCDEFAULT()
      !this.element   = !element
      return true
    endhandle
    !spwl     = !spec.owner

    -- Get purposes
    !specType = !spec.purpose
    !spwlType = !spwl.purpose

    -- If spwl and spec type are different than the current, then do we want to change them?
    if(!this.type ne !specType or !this.spwl ne !spwlType) then
      if(!!alert.confirm('Element''s specification and form are of different types. Do you want to change the element to the form specification type?').boolean()) then
        !this.selection = object SPCDEFAULT()
        !this.element   = !element
        return true
      endif
      return false
    endif

    !this.selection = object SPCDEFAULT(!element.spref)
    !this.element   = !element
    return true

  endif

 !this.selection = object SPCDEFAULT()
 !this.element   = !element
 return true

endmethod
-- End of method definition for .checkTypes(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      description
--
-- Description: Return description from current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .description()

  -- Initialise Variables
  !title = ''
  !name  = ''
  !dText = ARRAY()
  !rText = ARRAY()

  -- Steel plate type
  if(!this.type eq 'PLT') then
    !title = 'Plate Specification'
    !name  = 'Plate'

  -- Civil Floor Plate
  elseif (!this.type eq 'FLR') then
    !title = 'Floor/Screed Specification'
    !name  = 'Floor/Screed'

    -- Unknown
  else
    !title = !this.type
  endif

  -- Default
  if(!this.mode eq 'DEFAULT') then
    !title    =  !title & ' (Default)'
    !name     = 'Default ' & !name

    -- Define Default Options
    !dText.append('Default')
    !rText.append('DEFAULT')
    !ceFlag   = false

  -- Form Pointer
  elseif (!this.mode eq 'FORM') then
    !title    = 'Form ' & !title
    !name     = 'Form ' & !name

    -- Define Default Options
    !dText.append('Form')
    !rText.append('FORM')
    !ceFlag   = false

  elseif (!this.mode eq 'SET') then
    !title    = 'Define ' & !title
    !name     = !this.element.flnn

     -- Define Default Options
    !dText.append('CE')
    !rText.append('CE')
    !dText.append('Pick')
    !rText.append('PICK')
    !dText.append('List')
    !rText.append('LIST')
    !ceFlag   = true

  endif

  -- Set Form Data
  !this.formTitle  = !title
  !this.ceName.val = !name
--  !this.ce.dText   = !dText
--  !this.ce.rText   = !rText
  !this.ce.active  = !ceFlag

endmethod
-- End of method definition for .description()

------------------------------------------------------------------------
--
-- Method:      loadSpecs
--
-- Description: Load specifications
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadSpecs()

  -- Find All Spec
  !this.search.search()
  !this.currentSpec = object DBREF()

  -- Update list
  if (!this.search.specifications.empty()) then
    !dText[1] = 'No Specifications'
    !this.specification.dText = !dText
  else
    !this.search.populateGadget(!this.specification)
  endif

endmethod
-- End of method definition for .loadSpecs()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select a plate specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  if (!this.specRefs.selection().upcase() eq 'UNSET') then
    !this.thickness.val = 0
    !this.thickness.active = false

    -- Set selection
    !this.selection = object SPCDEFAULT()
  else
    !this.thickness.active = true

    -- Set thickness input gadget
    !this.thicknessInput()

    -- Get Range of current selection
    !component = !this.specRefs.selection().dbRef()
    !minimum   = !component.answer
    !maximum   = !component.maxAnswer

   !this.thickness.val = !this.pltThk.string().real(!this.format)

    -- Set selection
    !this.selection = object SPCDEFAULT(!component)
    !this.thickness('use')
  endif

endmethod
-- End of method definition for .select()

------------------------------------------------------------------------
--
-- Method:      thicknessInput
--
-- Description: Set thickness input gadget state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thicknessInput()

  -- Get Range of current selection
  !component = !this.specRefs.selection().dbRef()
  !minimum   = !component.answer
  !maximum   = !component.maxAnswer

  -- Is there a range
  if(!minimum ne !maximum) then
    !this.thickness.active = true
  else
    !this.thickness.active = false
  endif

endmethod
-- End of method definition for .thicknessInput()

------------------------------------------------------------------------
--
-- Method:      thickness
--
-- Description: Set the thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      use or test
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thickness(!mode is STRING)

  -- Get Range of current selection
  !component = !this.specRefs.selection().dbRef()
  !minimum   = !component.answer.string().real(!this.format)
  !maximum   = !component.maxAnswer.string().real(!this.format)

  -- Is there a range
  if(!this.thickness.val.unset()) then
    !this.thickness.val = 0
  endif
  if(!this.thickness.val.between(!minimum,!maximum).not()) then
    if (!mode eq 'test') then
      !!alert.warning('Thickness must be within the range.')
    endif
    !this.thickness.val = !minimum
  endif

  -- Add thickness to selection list
  !this.selection.attributesName.clear()
  !this.selection.attributesData.clear()
  !this.selection.attributesName.append('thickness')
  !this.selection.attributesData.append(!this.thickness.val)

endmethod
-- End of method definition for .thickness(STRING)
