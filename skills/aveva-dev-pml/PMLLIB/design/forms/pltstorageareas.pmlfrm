-- Define form
setup form !!pltStorageAreas

  !!pltStorageAreas.formTitle     = 'Storage Areas'
  !!pltStorageAreas.iconTitle     = 'Storage Areas'
  !!pltStorageAreas.callback      = ''
  !!pltStorageAreas.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  path down

  -- List setting
  list   .list 'Storage Areas' width 50 length 4

exit

-- End of form definition for !!pltStorageAreas

if (undefined(!!storageAreas)) then
  pml load form !!storageAreas
endif

-- Link gadgets to group storage
call !!storageForGroup(!!pltStorageAreas.list, 'PANDP','NOCHECK')

-- Load gadgets
call !!storageAreasDisp()

-- pop up menu to allow storage area to be cleared
!popup = !this.newMenu('pltstorageareaPopup')
!popup.add('CALLBACK', 'Set',   'call !!storageAreasSet(!!pltStorageAreas.list.selection().part(1), !!pltStorageAreas.list.selection().part(2),|NOCHECK|)')
!popup.add('CALLBACK', 'Clear', 'call !!storageAreasSet(!!pltStorageAreas.list.selection().part(1), !!pltStorageAreas.list.selection().part(2),|UNSET|)')
!this.list.setPopup(!popup)
