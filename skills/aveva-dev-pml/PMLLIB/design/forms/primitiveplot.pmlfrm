---
-- Description:
--  Primitive creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  primitivePlot()                  -                   Constructor
--  showPlot(STRING)                 -                   set plot file name
--
------------------------------------------------------------------------

setup form !!primitivePlot dialog resize

  !this.iconTitle     = 'Primitives'
  !this.formTitle     = 'Primitives'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.12 $ '

  view .plot plot height 20 aspec 0.707 cursor pointer exit

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      primitivePlot
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .primitivePlot()

  -- Initialise Variables
  !this.plot.background = 'darkslate'

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: set plot file name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPlot(!plotFilename is STRING)

  !plotFileObject  = object FILE( '%PDMSUI%\des\plot\' + !plotFilename.lowcase() )
  !plotFile        = !plotFileObject.fullname()
  !this.plot.add(!plotFile)

endmethod
-- End of method definition
