--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form
--  coordinateSettings()             -                   Setting the format of positional gadgets according to present coordinate system.
--  displayPosition(POSITION)        -                   Display the passed position in posControl gadgets.
--  init()                           -                   Initialising the posControl gadgets for new position or current position
--  pickPositionMethod()             -                   EDG pick position.
--  posControl()                     -                   Method called every time the posControl gadgets change via the .changeAction
--  queryPosition()                  -                   Constructor
--  setWrt(POSITION)                 -                   Set up with new wrt item
--  tag(POSITION)                    -                   Tag position
--  tidy()                           -                   Tidy up aid graphics
--
------------------------------------------------------------------------

--Import DLL
import 'PositionControl'
handle ANY
endhandle

setup form !!queryPosition dialog docking
  !this.iconTitle = 'Position'
  !this.formTitle = 'Query Target Position'
  !this.callback  = '!this.init()'

  para .worldPosition text 'World Position'
  line .line1 at x0 ymax anchor left + right + top horizontal width 34
  frame .newPositionControl panel  anchor left + right + top at x0 ymax+.25 width 34 height 4
    container .netPositionContainer nobox PMLNetCONTROL 'NET' dock fill
  exit

  -- With respect to element
  para .elementPosition at x0 ymax+.25 text 'With Respect To Element'
  line .line2 at x0 ymax anchor left + right + top horizontal width 34
  text .wrt  at x0.5 ymax+.25 anchor l+t+r tooltip 'With Respect To' |WRT| call '!this.posControl()' width 28 string
  para .east  at xmin ymax+0.2 anchor l+t+r width to max.wrt lines 1
  para .north at xmin ymax anchor l+t+r width to max.wrt lines 1
  para .up    at xmin ymax anchor l+t+r width to max.wrt lines 1

  button .pickPosition at xmax form-size ymin anchor right + bottom callback '!this.pickPositionMethod()' pixmap width 16 height 16

  -- Form Members
  -- Store Position
  member .storedPosition   is POSITION

  -- Aid Graphics
  member .tag              is REAL

  -- EDG Description
  member .edgDescription   is STRING

  using namespace 'Aveva.Pdms.Presentation'
  member .posControl       is POSITIONCONTROL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      queryPosition
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryPosition()

  -- Initialise Variables
  !this.storedPosition = object POSITION('E0 wrt world')

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of the position control
  !this.posControl        = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                   = object SHIPGRID()
  !gridDefined            = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World')
  endif

  !this.coordinateSettings()

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'

  -- EDG Description
  !this.edgDescription        = 'Query Target Position'

  -- Aid graphic numbers
  !this.tag            = !!aidNumbers.add('Query Target Position')

  -- Error handle?
  !this.netPositionContainer.control = !this.posControl.handle()

  -- Whenever the posControl gadget changes
  !this.posControl.changeAction('!!queryPosition.posControl()')

  !this.pickPosition.setTooltip('Pick Target Position')
  !this.pickPosition.addPixmap(!!pml.getPathName('pickpos16.png'))
  !this.wrt.val = '/*'

endmethod
------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialising the posControl gadgets for new position or current position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Specific actions ????
  !position = !this.storedPosition
  !this.wrt.val = '/*'

  -- Display in the position gadget
  !this.posControl.xyz(!position.east, !position.north, !position.up)
  !this.displayPosition(!position.wrt(worl))
  !this.setWrt(!position)
  !this.tidy()
  !this.pickPositionMethod()

endmethod
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Initialise Variables
  !this.tidy()

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

  -- Hide this form
  !this.hide()

endmethod
------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.tag>

endmethod
------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Position to tag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tag(!position is POSITION)

  -- Initialise Variables
  AID CLEAR ALL $!<this.tag>

  -- Text description
  !endText      = 'Target Position'

  -- Aid info
  AID TEXT NUMBER $!<this.tag> '$!endText' AT $!<position>

endmethod
------------------------------------------------------------------------
--
-- Method:      coordinateSettings
--
-- Description: Setting the format of positional gadgets according to present coordinate system.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .coordinateSettings()

   -- Check if a ship grid system is defined
   !grid            = object SHIPGRID()
   !gridDefined     = !grid.position.set()
   if(!gridDefined)then
     !this.posControl.gridvisible(true)
     !this.posControl.gridFormat()
   else
      !this.posControl.gridvisible(false)
      var !coord coord
      if (!coord.eq('ENU'))then
        !this.posControl.enuFormat()
      else
        !this.posControl.xyzFormat()
      endif
   endif

 endmethod
------------------------------------------------------------------------
--
-- Method:      pickPositionMethod
--
-- Description: EDG pick position.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPositionMethod()

     !packet = object EDGPACKET()
     !packet.definePosition('Pick Target Position')
     !packet.priority    = 2
     !packet.remove      = true
     !packet.action = '!!queryPosition.displayPosition(!this.return[1].position.wrt(worl))'
     !!edgCntrl.add(!packet)

 endmethod
------------------------------------------------------------------------
--
-- Method:      displayPosition()
--
-- Description: Display the passed position in posControl gadgets.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Passed position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPosition(!position is POSITION)

  -- Display the passed position in the position control gadget
  !this.posControl.xyz(!position.east, !position.north, !position.up)

  -- Tag the new position
  !this.posControl()

endmethod
------------------------------------------------------------------------
--
-- Method:      posControl()
--
-- Description: Method called every time the posControl gadgets change via the .changeAction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .posControl()

  -- Get the Position
  !position       =  object POSITION()
  !newPos  = !this.posControl.xyz()
  !position.east  = !newPos[0]
  !position.north = !newPos[1]
  !position.up    = !newPos[2]
  !position.origin = /*

  -- Tag the new position
  !this.tag(!position)
  !this.setWrt(!position)

endmethod

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    target postion
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt(!position is POSITION)

   -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !this.wrt.val = '/*'
    !wrtElement = object DBREF('/*')
  endhandle

  -- Maintain/display the wrt in the gadget
  var !coord coord
  if (!coord.eq('ENU'))then
    !this.east.val  = 'E ' & !position.wrt(!wrtElement).east.string(!!distanceFmt)
    !this.north.val = 'N ' & !position.wrt(!wrtElement).north.string(!!distanceFmt)
    !this.up.val    = 'U ' & !position.wrt(!wrtElement).up.string(!!distanceFmt)
  else
    !this.east.val  = 'X ' & !position.wrt(!wrtElement).east.string(!!distanceFmt)
    !this.north.val = 'Y ' & !position.wrt(!wrtElement).north.string(!!distanceFmt)
    !this.up.val    = 'Z ' & !position.wrt(!wrtElement).up.string(!!distanceFmt)
  endif

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.fullName
  !this.wrt.setTooltip('wrt ' & !wrtElement.fullName)

endmethod
