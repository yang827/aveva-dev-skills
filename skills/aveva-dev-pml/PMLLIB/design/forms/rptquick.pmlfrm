-- Author:          P.Mooney
-- Created:         Wed Jul 9 18:11:01 BST 1997
--
--
-- Description:
-- Simplified version of main Reports form. All callbacks on the
-- gadgets go through !!rptSelect().
--
-- In future versions, associated functions should be made methods
-- of this form, apart from !!rptCrtQuick() which actually creates
-- the report.
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!rptQuick

  !!rptQuick.formTitle    = |Create a Quick Report|
  !!rptQuick.callback     = ||
  !!rptQuick.iconTitle    = |Quick|
  !!rptQuick.formRevision = | $$Revision: 1.10 $ |

  para     .file     at xmin ymax+1  text      |File      |
  text     .filename at xmax_file   ymin call |call !!rptSelect(!!rptQuick.filename)| width 43 scroll 120 string
  toggle   .term     |Term| at xmax ymin call |call !!rptSelect(!!rptQuick.term)|

  para     .types    at xmin_file  ymax+0.2 text |Types     |
  text     .type     at xmax_file  ymin call |call !!rptSelect(!!rptQuick.type)| width 51 scroll 80 string

  para     .withPara at xmin_file  ymax text |With      |
  text     .with     at xmax_file  ymin call |call !!rptSelect(!!rptQuick.with)| width 51 scroll 80 string

  para     .sortPara at xmin_file  ymax text |Columns   |
  text     .sort     at xmax_file  ymin call |call !!rptSelect(!!rptQuick.sort)| width 51 scroll 80 string

  para     .hiertext  at xmin_file ymax text |Hierarchy |
  text     .hierarchy at xmax_file ymin call |call !!rptSelect(!!rptQuick.hierarchy)| width 51 scroll 80 string

  button   .run      |Apply| at xmin_file ymax+1    call |call !!rptSelect(!!rptQuick.run)|
--  button   .SAVE     |Save as Template| at xmax+1 ymin
  button   .dismiss  |Dismiss|        at xmax FORM-SIZE ymin call |hide !!rptQuick|

exit
-- End of form definition for !!rptQuick
