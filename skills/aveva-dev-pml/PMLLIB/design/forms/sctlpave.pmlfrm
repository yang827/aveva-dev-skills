--
------------------------------------------------------------------------

-- Define form
setup form !!sctlPave

  !!sctlPave.formTitle     = 'Panel/Extrusion Vertex Editor'
  !!sctlPave.iconTitle     = 'VERTEX'
  !!sctlPave.callback      = ''
  !!sctlPave.formRevision  = ' $Revision: 1.11 $ '

-- Members
 member .panel is DBREF
-- member .origin is POSITION
-- member .plane is PLANE
 member .number is REAL
 member .current is DBREF

  -- Body of form definition


  -- Current Element Button
  button .element at x 0.5 y 0.5 ' CE ' call |!!sctlPaveCe(!!ce) |

    -- Create or Edit Toggle
    rgroup _radio
      add tag |Create| call |!!sctlPaveNew()|
      add tag |Modify|  call |!!sctlPaveEdit()|
      add tag |Pick  | call |!!sctlPavePick()|
    exit

   -- Create vertex with centre at given position
    button .fromPos tooltip 'Define point relatively' pixmap width 32 heig 32  callback |!!strPaveRelShow()|

    -- Create vertex with centre at given position
    button .centreArc tooltip 'Define arc using centre' pixmap width 32 heig 32  callback |!!strPaveCentShow()|

    -- Create vertex with fillet radius of selected circle
    button .filletArc tooltip 'Define arc using pole' pixmap width 32 heig 32 callback |!!strPaveFillShow()|

   -- Create vertex with given radius of selected circle
    button .radiusArc tooltip 'Define arc using radius only' pixmap width 32 heig 32 callback |!!strPaveRadShow()|

 -- Create vertex through given point
    button .throughArc tooltip 'Define arc using through point' pixmap width 32 heig 32 callback |!!strPaveThruShow()|

  -- Selected Vertex 2D Position and Radius
  frame .editor 'Vertex' at x 0.5 ymax
  -- Vertex X Position
     text .xPos 'X'  width 12 is REAL FORMAT !!distanceFmt

  -- Vertex Y Position
     text .yPos 'Y' at xmax+1 ymin width 12 is REAL FORMAT !!distanceFmt

  -- Vertices Radius
     text .radius 'Radius' at xmax+1 ymin width 10 is REAL FORMAT !!distanceFmt

    -- Delete current vertex
     button .delete |Cut| at xmin.xPos ymax+0.25  call |!!sctlPaveDelete()|

    -- Delete current vertex
     button .copy |Copy|  call |!!sctlPaveCopy()|

   -- Replace current vertex
     button .replace |Replace|  call |!!sctlPaveReplace()|

   -- Insert vertex After
     button .after |Insert After|  call |!!sctlPaveInsert(false)|
   -- Insert vertex Before
     button .before |Insert Before|  call |!!sctlPaveInsert(true)|

  exit
  -- Vertex list and focus
  list .vertices  'Vertex      X               Y               Radius' at xmin.editor ymax+0.1 call |!!sctlPaveSelect()| SINGLE width 58 length 10

  para .valid  at xmin ymax text '' width 50

  button .close 'Dismiss' at xmax.vertices-8 ymax.vertices call |!!sctlPaveDismiss()| cancel

exit
-- End of form definition for !!sctlPave

-- set icons
!!sctlPave.fromPos.addPixmap(!!pml.getPathName('2ddistdir.png'))
!!sctlPave.centreArc.addPixmap(!!pml.getPathName('2dcentre.png'))
!!sctlPave.filletArc.addPixmap(!!pml.getPathName('2dfillet.png'))
!!sctlPave.radiusArc.addPixmap(!!pml.getPathName('2dradius.png'))
!!sctlPave.throughArc.addPixmap(!!pml.getPathName('2dthrough.png'))
