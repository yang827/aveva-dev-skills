-- Define form
setup form !!sctlPlotView Resizeable

  !!sctlPlotView.formTitle     = |Plot File|
  !!sctlPlotView.iconTitle     = |Plotfile|
  !!sctlPlotView.callback      = | |
  !!sctlPlotView.formRevision  = | $Revision: 1.4 $ |

  -- Body of form definition

  view _plot plot
    width 30 height 15
    border on
  exit

exit
-- End of form definition for !!sctlPlotView
