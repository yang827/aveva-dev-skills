--
-- Description:
-- Form for spine points and curves i.e. 2D constructor for gensecs
--
------------------------------------------------------------------------

-- Define form
setup form !!sctlSpine

  !!sctlSpine.formTitle     = 'Curved Element Spine Editor'
  !!sctlSpine.iconTitle     = 'SPINE'
  !!sctlSpine.callback      = ''
  !!sctlSpine.formRevision  = ' $Revision: 1.10 $ '

-- Members
 member .spine is DBREF
 member .origin is POSITION
 member .plane is PLANE
 member .number is REAL
 member .current is DBREF

  -- Body of form definition

  -- Current Element Button
  button .element at x 0.5 y 0.5 ' CE ' callback |!!sctlSpineCe(!!ce)|

    -- Create or Edit Toggle
    rgroup _radio
      add tag |Create| call |!!sctlSpineNew()|
      add tag |Modify|  call |!!sctlSpineEdit()|
      add tag |Pick  | call |!!sctlSpinePick()|
    exit

  -- Create vertex with centre at given position
   button .fromPos tooltip 'Define point relatively' pixmap width 32 heig 32  callback |!!strSpineRelShow()|

-- Create vertex with centre at given position
    button .centreArc tooltip 'Define arc using centre' pixmap width 32 heig 32  callback |!!strCurveCentShow()|

    -- Create vertex with fillet radius of selected circle
    button .filletArc tooltip 'Define arc using pole' pixmap width 32 heig 32 callback |!!strSpineFillShow()|

   -- Create vertex with given radius of selected circle
    button .radiusArc tooltip 'Define arc using radius only'  pixmap width 32 heig 32 callback |!!strSpineRadShow()|

 -- Create vertex through given point
    button .throughArc tooltip 'Define arc using through point' pixmap width 32 heig 32 callback |!!strSpineThruShow()|

  -- Selected Vertex 2D Position

  frame .vEditor 'Point' at x 0.5 ymax
  -- Vertex X Position
     text .xPos 'X'  width 12 is REAL FORMAT !!distanceFmt

  -- Vertex Y Position
     text .yPos 'Y' at xmax+1 ymin width 12 is REAL FORMAT !!distanceFmt

    -- Delete current vertex
     button .delete |Cut| at xmin.xPos ymax+0.25  call |!!sctlSpineDelete()|

    -- Delete current vertex
     button .copy |Copy|  call |!!sctlSpineCopy()|

   -- Replace current vertex
     button .replace |Replace|  call |!!sctlSpineReplace()|

   -- Insert vertex After
     button .after |Insert After|  call |!!sctlSpineInsert(false)|
   -- Insert vertex Before
     button .before |Insert Before|  call |!!sctlSpineInsert(true)|

  exit

   frame .cEditor 'Curve' at x 0.5 ymax

-- Vertex X Position
  text .xCpos 'X'  width 10 is REAL

  -- Vertex Y Position
  text .yCpos 'Y' at xmax+0.5 ymin width 10 is REAL

  -- Vertices Radius
  text .radius 'Radius' at xmax+0.5 ymin width 8 is REAL


-- Vertex X Position
  text .xNpos 'X' at xmax+0.5 ymin width 10 is REAL

  -- Vertex Y Position
  text .yNpos 'Y' at xmax+0.5 ymin width 10 is REAL

    -- Delete current vertex
     button .cDelete |Cut| at xmin.xCpos ymax+0.25  call |!!sctlSpineDelete()|

    -- Delete current vertex
     button .cCopy |Copy|  call |!!sctlSpineCopy()|

   -- Replace current vertex
     button .cReplace |Replace|  call |!!sctlCurveReplace()|

   -- Insert vertex After
     button .cAfter |Insert After|  call |!!sctlCurveInsert(false)|
   -- Insert vertex Before
     button .cBefore |Insert Before|  call |!!sctlCurveInsert(true)|
   -- Curve Type
  option .curve at xmax+10 ymin width 7
      !options[1] = 'Centre'
      !options[2] = 'Through'
      !options[3] = 'Radius'
      !options[4] = 'Fillet'
   _curve.Dtext = !options
      !options[1] = 'CENT'
      !options[2] = 'THRU'
      !options[3] = 'RADI'
      !options[4] = 'FILL'
   _curve.Rtext = !options
  exit

  -- Vertex list and focus
  list .vertices ' No Type  Position X          Y    Radius Condition X          Y  Type' at xmin.cEditor ymax+0.2 call |!!sctlSpineSelect()| SINGLE width 70 length 8

 para .valid  at xmin ymax text '' width 50

   button .close 'Dismiss' at xmax.vertices-8 ymax.vertices call |!!sctlSpineDismiss()| cancel

exit
-- End of form definition for !!sctlSpine

-- set icons
!!sctlSpine.fromPos.addPixmap(!!pml.getPathName('2ddistdir.png'))
!!sctlSpine.centreArc.addPixmap(!!pml.getPathName('2dcentre.png'))
!!sctlSpine.filletArc.addPixmap(!!pml.getPathName('2dfillet.png'))
!!sctlSpine.radiusArc.addPixmap(!!pml.getPathName('2dradius.png'))
!!sctlSpine.throughArc.addPixmap(!!pml.getPathName('2dthrough.png'))
