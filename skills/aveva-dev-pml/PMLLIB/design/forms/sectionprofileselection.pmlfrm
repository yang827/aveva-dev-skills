--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  defaultJusLine(ARRAY)            -                   Sets the p-lines that the jusline should default when loading profile list
--  dismiss()                        -                   Dismiss form
--  loadGTypes()                     -                   Load generic types
--  loadPlines()                     -                   Load plines
--  loadProfiles()                   -                   Load profiles
--  loadSpecifications()             -                   Load specifications
--  sectionProfileSelection()        -                   Constructor
--  selectGType()                    -                   Select generic type
--  selectProfile()                  -                   Select profile
--  selectSpecification()            -                   Select specification
--  selectSpecification(DBREF)       BOOLEAN             Select specification
--  setup()                          -                   Setup form
--  setup(DBREF)                     -                   Setup form
--  setup(PROFILECATALOGUEDATA)      -                   Setup form
--  setup(STRING,STRING,PROFILECATALOGUEDATA) -                   Setup form
--

setup form !!sectionProfileSelection dialog dock size 38 21.5

  -- .net library
  using namespace 'Aveva.Pdms.Presentation'

  -- Form details
  !this.formTitle    = 'Section Profile Selection'
  !this.icontitle    = ''
  !this.callback     = ''
  !this.formrevision = ''

  -- Specification
  --frame    .sectionSpecList 'Profile Specification'                   anchor T+L  at xmin form+1       ymax+0.5                                         width 35
    para   .paSectionSpecList                                         anchor T+L    at xmin              ymin      text 'Profile Specification'           width 30 lines 1
    line   .lnSectionSpecList                                                       at xmin              ymax-0.2  anchor T+L+R HORIZ                     width 36
    option .specList        'Standard'                  tagwidth 12   anchor T+L+R  at xmin+1            ymax+0.2  callback '!this.selectSpecification()' width 19
    option .gtypeList       'Generic Type'              tagwidth 12   anchor T+L+R  at xmin              ymax      callback '!this.selectGType()'         width 19
    -- List of available profiles
    list   .profileList     'Profile Size'                            anchor T+L+R  at xmin              ymax+0.5  callback '!this.selectProfile()'       width 32  height 12
  --exit
  -- Justification
  --frame       .sectionJust  'Justification Rule for P-Line'           anchor T+L  at xmin form+1       ymax+0.5
    para      .paSectionJust                                          anchor T+L    at xmin.paSectionSpecList ymax+0.5  text 'Justification Rule for P-Line' width 30 lines 1
    line      .lnSectionJust                                                        at xmin                   ymax-0.2  anchor T+L+R HORIZ                   width 36
    option    .jusLine      'P-Line Justification'      tagwidth 20   anchor T+L+R  at xmin+2                 ymax+0.2                                       width 10
    option    .memLine      'Member Line Justification' tagwidth 20   anchor T+L+R  at xmin.jusLine           ymax                                           width 10
    option    .joiLine      'Joint Line Justification'  tagwidth 20   anchor T+L+R  at xmin.jusLine           ymax                                           width 10
  --exit

  --frame .task     'Perform Task'                                      anchor T+L  at xmin form+1            ymax+0.5                                    width 35
    para   .paTask                                                    anchor T+L  at xmin.paSectionSpecList  ymax+0.5  text 'Perform Task'               width 30 lines 1
    line   .lnTask                                                                at xmin                    ymax-0.2  anchor T+L+R HORIZ                width 36
    para   .paApply                                                   anchor B  at xmin+2                    ymax+1    pixmap                            width 16   height 16
    button .apply      linklabel  'Apply Changes'                     anchor B  at xmax.paApply+1.25         ymin      callback '!this.apply()'          width 10
    para   .paDismi                                                   anchor B  at xmax.apply+5              ymin      pixmap                            width 16   height 16
    button .dismiss    linklabel  'Dismiss'                           anchor B  at xmax.paDismi+1            ymin      callback '!this.dismiss()'        width 10
  --exit

  -- Form Members
  --------------------------------------------------------------------
  -- Action on apply
  member .action            is BLOCK

  -- Specifications
  member .specifications    is SPECIFICATIONS

  -- Generic Types
  member .genericTypes      is ARRAY

  -- Profiles
  member .profiles          is ARRAY

  -- Selected Profile data
  member .specification     is DBREF
  member .gtype             is DBREF
  member .profile           is DBREF
  member .justification     is STRING

  member .catalogueProfile  is PROFILECATALOGUEDATA

  -- Preferred settings for justification line
  member .jlines            is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      sectionProfileSelection
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sectionProfileSelection()

  -- Load Specifications
  !this.loadSpecifications()

  --pixmapfiles
  !this.paApply.addPixmap(!!pml.getPathName('accept.png'))
  !this.paDismi.addPixmap(!!pml.getPathName('discard.png'))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      defaultJusLine
--
-- Description: Sets the p-lines that the jusline should default when loading profile list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of plines
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultJusLine(!plines is ARRAY)

  -- Default justifications
  !this.jlines.clear()
  !this.jlines = !plines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadSpecifications
--
-- Description: Load specifications
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadSpecifications()

  -- Initialise Variables
  !descriptions = ARRAY()

  -- Load Specifications
  !this.specifications.purposeorstext('STL','STL')

  -- Get specification informat in the object (this should really be done in
  -- the object itself)
  !reindex  = !this.specifications.descriptions.sortedIndices()
  !this.specifications.descriptions.reindex(!reindex)
  !this.specifications.names.reindex(!reindex)
  !this.specifications.references.reindex(!reindex)
  !this.specifications.refStrings.reindex(!reindex)

  -- Bug in the specifications object in that the .descriptions don't
  -- hold the descriptions, so we need to get the inform from the element
  do !i indices !this.specifications.references
    !spec = !this.specifications.references[!i]
    if(!spec.description.empty()) then
      !descriptions.append('')
    else
      !descriptions.append(!spec.description)
    endif
  enddo

  -- Update specification gadget
  !this.specList.dtext  = !descriptions
  !this.specList.rtext  = !this.specifications.refStrings

  -- Select Passed specification
  !this.selectSpecification(!this.specification)

  -- Select specification
  !this.selectSpecification()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R     STRING               Title for form
--    2   R     STRING               Action to carry out
--    3   R     PROFILECATALOGUEDATA Profile Catalogue Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!title is STRING, !action is STRING, !catalogueData is PROFILECATALOGUEDATA)

  -- Change form title
  !this.formTitle         = !title
  !this.action            = object BLOCK(!action)
  !this.catalogueProfile  = !catalogueData

  -- Setup form
  !this.setup()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Profile to setup for with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!profile is DBREF)

  -- Initialise Variables
  !this.catalogueProfile = object PROFILECATALOGUEDATA(!profile)

  -- Set current information up
  !this.setup()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     PROFILECATALOGUEDATA Profile Catalogue Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!catalogueData is PROFILECATALOGUEDATA)

  -- Initialise Variables
  !this.catalogueProfile  = !catalogueData

  -- Setup form
  !this.setup()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.gtype           = !this.catalogueProfile.gTypeOwner
  !this.profile         = !this.catalogueProfile.catalogueReference
  !this.justification   = !this.catalogueProfile.justificationLine

  -- Select specification
  if(!this.catalogueProfile.set()) then
    !specification      = !this.catalogueProfile.catalogueReference.spow
    !this.selectSpecification(!specification)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectSpecification
--
-- Description: Select specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True set
--
------------------------------------------------------------------------

define method .selectSpecification(!specification is DBREF) is BOOLEAN

  -- Set Specifications
  if(!specification.set()) then
    if(!specification.type.neq('SPEC')) then
      return false
    endif
  endif

  -- Check if spec is in the list of specifications
  !index    = !this.specifications.references.findFirst(!specification)
  if(!index.unset()) then
    !index  = 1
  endif

  !this.specification = !this.specifications.references[!index]
  !this.specList.val  = !index

  -- Load GTypes
  !this.loadGTypes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectSpecification
--
-- Description: Select specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectSpecification()

  -- Set Specifications
  !this.specification = !this.specifications.references[!this.specList.val]

  -- Load GTypes
  !this.loadGTypes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadGTypes
--
-- Description: Load generic types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadGTypes()

  -- Initialise Variables
  !descriptions = ARRAY()


  -- Collect all SELE with question eq 'GTYP'
  !collection         = object COLLECTION()
  !collection.type('SELE')
  !collection.scope(!this.specification)
  !this.genericTypes  = !collection.results()

  -- Get descriptions
  do !i indices !this.genericTypes
    !gtype  = !this.genericTypes[!i]
    !descriptions.append(!gtype.description)
  enddo

  -- Sort into alphabetic order
  !reindex  = !descriptions.sortedIndices()
  !descriptions.reindex(!reindex)
  !this.genericTypes.reindex(!reindex)

  -- Update specification gadget
  !this.gtypeList.dtext = !descriptions

  -- Select current gtype
  !index    = !this.genericTypes.findFirst(!this.gtype)
  if(!index.unset()) then
    !index  = 1
  endif
  !this.gtypeList.val  = !index

  -- Select GType
  !this.selectGType()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectGType
--
-- Description: Select generic type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectGType()

  -- Get generic type
  !this.gtype = !this.genericTypes[!this.gtypeList.val]

  -- Select Profile
  !this.loadProfiles()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadProfiles
--
-- Description: Load profiles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadProfiles()

  -- Initialise Variables
  !descriptions = ARRAY()

  -- Collect all SPCO
  !collection         = object COLLECTION()
  !collection.type('SPCO')
  !collection.scope(!this.gtype)
  !this.profiles  = !collection.results()

  -- Get descriptions
  do !i indices !this.profiles
    !profile  = !this.profiles[!i]
    !descriptions.append(!profile.catr.namn)
  enddo

  -- Update specification gadget
  !this.profileList.dtext = !descriptions

  -- Select profile
  -- Select current gtype
  !index          = !this.profiles.findFirst(!this.profile)
  if(!index.unset()) then
    !this.profile = !this.profiles[1]
    !index        = 1
  endif
  !this.profileList.val  = !index

  -- Load P-Lines
  !this.loadPlines()

  -- Select Profile
  !this.selectProfile()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile()

  !this.profile = !this.profiles[!this.profileList.val]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadPlines
--
-- Description: Load plines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadPlines()

  -- Initialise Variables
  !pkeys    = ARRAY()

  -- Get all plines for selected profile
  !pkeys    = !this.profile.plname
  !pkeys.sort()

  -- Load pline gadgets
  !this.jusLine.dtext = !pkeys
  !this.memLine.dtext = !pkeys
  !this.joiLine.dtext = !pkeys

  -- Default NA
  !index              = !pkeys.findFirst('NA')

  -- if no NA then just pick the first
  if(!index.unset()) then
     !index = 1
  endif

  -- Current justification
  !jindex             = !pkeys.findFirst(!this.catalogueProfile.justificationLine)
  if(!jindex.unset()) then

    -- Look for preferred plines
    !preferred        = !pkeys.intersect(!this.jlines)
    if(!preferred.set()) then
      !jindex         = !pkeys.findFirst(!preferred.first())
    -- Assume NA
    else
      !jindex         = !index
    endif

  endif

  -- Set justification
  !this.jusLine.val   = !jindex

  -- Current member line
  !mindex       = !pkeys.findFirst(!this.catalogueProfile.memberLine)
  if(!mindex.unset()) then
    !mindex     = !index
  endif

  -- Set member line
  !this.memLine.val   = !mindex

  -- Current joint line
  !cindex = !pkeys.findFirst(!this.catalogueProfile.jointLine)
  if(!cindex.unset()) then
    !cindex     = !index
  endif

  !this.joiLine.val   = !cindex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Update the catalogue profile definition

  !this.catalogueProfile.catalogueReference = !this.profile
  !this.catalogueProfile.gTypeOwner         = !this.gtype
  !this.catalogueProfile.genericType        = !this.profile.icotyp
    handle (2,754)
      !!alert.warning('Please Select the Profile Size for the selected G-Type')
      return
    endhandle
  !this.catalogueProfile.justificationLine  = !this.jusLine.selection()
  !this.catalogueProfile.memberLine         = !this.memLine.selection()
  !this.catalogueProfile.jointLine          = !this.joiLine.selection()

  -- Execute the action
  !this.action.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Dismiss form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.hide()

endmethod
-- End of method
