--
--
-- Description:
-- Pipe component modification form for spec /Bore
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeInsulationSpec()           -
--  changeTracingSpec()              -
--  checkAccess(COMPMODITEM)         BOOLEAN             Check if we have access to modify the component
--  getBoreSelector(DBREF,STRING,BORE) DBREF
--  getBores()                       -
--  getDefaultComponent(DBREF,ARRAY,ARRAY) STRING              gets the default selection in the spec for the component
--  getDefaultSelector(DBREF)        DBREF
--  getSpecComponent(DBREF,ARRAY,ARRAY) STRING
--  getSpecs()                       -                   collects all the spec for piping, insulation and tracing
--  initialise()                     -                   Initialisation method
--  loadTubeComponents(SPECIFICATION,DBREF) -                   Load the available TUBE components for the spec
--  processBoreSelection()           -                   update list with new specification component for the selected bore
--  processSpecSelection()           -                   update list with new specification component for the selected spec
--  selectSpecification()            -                   Constructor
--  selectionStatus()                -
--  updateComponent(STRING)          -
--  updateList()                     -                   update the list for the active task
--

 setup form !!selectSpecification resizeable

   !this.formTitle = ' '
   !this.callback = '!this.initialise()'

   option .specList  'Specification  :  ' anchor left+right+top at x1 y0.5 width 15
   option .resetList 'Pipe/Branch Reset:' anchor left+right+top at x1 ymax.speclist width 15

   toggle .outSpec  'Change out of spec components?' callback |!this.outOfSpec = !this.outSpec.val| at x1 ymax.resetList+0.5

   option .boreList  'Bore :           'anchor left+right+top at x1 y0.5  width 8

   option .ispecList 'Insulation spec :'anchor left+right+top at x1 y0.5  width 10

   option .tspecList 'Tracing Spec :   'anchor left+right+top at x1 y0.5  width 10

   button .ok ' Apply 'callback '!this.updateList()' anchor right+bottom at  xmin ymax.outSpec OK

   button .cancel 'Dismiss' anchor right+bottom  at  xmax form - size ymin cancel

      !a[1] = 'Components Only'
      !a[2] = 'Pipe and Branches'
      !a[3] = 'Branch'

      !b[1] = '0'
      !b[2] = '1'
      !b[3] = '3'

      !this.resetList.dtext = !a
      !this.resetList.rtext = !b

   -- Form Members

   -- Selected Spec
   member .selectedSpec    is DBREF

   member .branchSpec      is DBREF

   -- Array to store
   member .columns         is ARRAY

   -- Array to store spec component selectors
   member .selectors       is ARRAY

   -- Compmoditem object
   member .componentObject is COMPMODITEM

   -- array of specborechange components
   member .componentObjects is ARRAY

   -- Specification object
   member .specification   is SPECIFICATION

   -- string for selection details
   member .noSelection     is STRING
   member .selectionType   is STRING

   -- stores the selected list items
   member .listSelection is ARRAY

   -- out of spec selection
   member .outOfSpec      is BOOLEAN

   -- active task
   member .activeTask     is STRING

   -- stores the status of the available spec
   member .availableStatus  is ARRAY

   -- store errors related to dac
   member .errors       is ARRAY

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      selectSpecification
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectSpecification()

      !this.outSpec.visible = FALSE
      --!this.getSpecs()
      --!this.getBores()

      !this.selectedSpec = object DBREF()
      !this.noSelection  = 'No selection available'
      !this.outOfSpec = FALSE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

     !checkComp = !!specBoreChange.compListGrid.getSelectedRowTags()
     !sprefUnset = false
     if !checkComp.size() eq 1 then
       if !this.componentObjects[!checkComp[1].real()].component.spref.unset() then
         !!alert.error('One of the selected components has no spref set. Please select a spref for the component before modifying.')
         return error 10000 noalert
       endif
     elseif !checkComp.size() gt 1 then
       do !val values !checkComp
         !sprefUnset = !this.componentObjects[!val.real()].component.spref.unset()
         handle (2,752)
         elsehandle any
	     	 	 !sprefUnset = TRUE
         endhandle
         if !sprefUnset then
           !!alert.error('One of the selected components has no spref set. Please select a spref for the component before modifying.')
           return error 10000 noalert
         endif
       enddo
     endif
	
     !this.branchSpec       = !!specborechange.currentSpec
     !this.activeTask       = !!specborechange.activeTask
     !this.listSelection    = !!specBoreChange.compListGrid.GetSelectedRowTags()
     !this.componentObjects = !!specborechange.components

     !this.errors         = ARRAY()
     !!specBoreChange.errors = ARRAY()

     -- get piping specs and update the spec list
     !this.getSpecs()

     if(!this.activeTask eq |MODSPEC|) then

       !this.formTitle = 'Select Piping Spec'

       !this.specList.visible  = TRUE
       !this.resetList.visible = TRUE
       !this.boreList.visible  = FALSE
       !this.ispecList.visible = FALSE
       !this.tspecList.visible = FALSE
       !this.outSpec.visible   = TRUE

       -- initialise the spec list selection with current element's pipe spec
       !currentElemSpec = !!specBoreChange.currentSpec.namn
       handle ANY
       elsehandle NONE
        !this.specList.select('DTEXT',!currentElemSpec)
       endhandle

     elseif(!this.activeTask eq |MODBORE|) then

       !this.formTitle = 'Select Bore'

       !this.specList.visible  = FALSE
       !this.resetList.visible = FALSE
       !this.boreList.visible  = TRUE
       !this.ispecList.visible = FALSE
       !this.tspecList.visible = FALSE
       !this.outSpec.visible   = FALSE

       !this.getBores()

       -- initialise the bore list selection with the hbore
       !indices = !!specBoreChange.compListGrid.GetSelectedRowTags()
       if !indices.size() eq 1 then
          !object = !this.componentObjects[!indices[1].real()].component
          !currentBore = !this.componentObjects[!indices[1].real()].aBore.string()
       elseif !indices.size() gt 1 then
          do !n values !indices
             !object = !this.componentObjects[!n.real()].component
             !aBore[!n.real()] = !this.componentObjects[!n.real()].aBore.string()
          enddo
          !aBore.unique()
          !currentBore = !aBore[1].string()

       endif

       handle ANY
       elsehandle NONE
        !this.boreList.select('DTEXT',!currentBore)
        handle (61,567)
        endhandle
       endhandle


     -- active task is to Modify Insulation Spec
     elseif(!this.activeTask eq |MODISPEC|) then

       !this.formTitle = 'Select Insulation Spec'

       !this.specList.visible  = FALSE
       !this.resetList.visible = FALSE
       !this.boreList.visible  = FALSE
       !this.ispecList.visible = TRUE
       !this.tspecList.visible = FALSE
       !this.outSpec.visible   = FALSE
       !indices = !!specBoreChange.compListGrid.GetSelectedRowTags()
       if !indices.size() eq 1 then
          !object = !this.componentObjects[!indices[1].real()].component
          !currentISpec = !this.componentObjects[!indices[1].real()].ispec.name
          handle any
            !currentISpec = 'None'
          endhandle
       elseif !indices.size() gt 1 then
          do !n values !indices
             !object = !this.componentObjects[!n.real()].component
             !ispec[!n.real()] = !this.componentObjects[!n.real()].ispec.name
             handle any
               !ispec[!n.real()] = 'None'
             endhandle
          enddo
          !ispec.unique()
          !currentISpec = !ispec[1].string()
       endif

       handle ANY
       elsehandle NONE
        !this.ispecList.select('DTEXT',!currentISpec.after('/'))
        handle (61,567)
        endhandle
       endhandle

     -- active task is to Modify Tracing Spec
     elseif(!this.activeTask eq |MODTSPEC|) then

       !this.formTitle = 'Select Tracing Spec'

       !this.specList.visible  = FALSE
       !this.resetList.visible = FALSE
       !this.boreList.visible  = FALSE
       !this.ispecList.visible = FALSE
       !this.tspecList.visible = TRUE
       !this.outSpec.visible   = FALSE
       !indices = !!specBoreChange.compListGrid.GetSelectedRowTags()
       if !indices.size() eq 1 then
          !object = !this.componentObjects[!indices[1].real()].component
          !currentTSpec = !this.componentObjects[!indices[1].real()].tspec.name
          handle any
            !currentTSpec = 'None'
          endhandle
       elseif !indices.size() gt 1 then
          do !n values !indices
             !object = !this.componentObjects[!n.real()].component
             !tspec[!n.real()] = !this.componentObjects[!n.real()].tspec.name
             handle any
               !tspec[!n.real()] = 'None'
             endhandle
          enddo
          !tspec.unique()
          !currentTSpec = !tspec[1].string()
       endif

       handle ANY
       elsehandle NONE
        !this.tspecList.select('DTEXT',!currentTSpec.after('/'))
        handle (61,567)
        endhandle
       endhandle

     endif
      !!specBoreChange.selectionStatus.visible = FALSE

     endmethod
     -- End of method definition

------------------------------------------------------------------------
--
-- Method:      getSpecs
--
-- Description: collects all the spec for piping, insulation and tracing
--              update the option list with available specs /Bore/Insu/tracing
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpecs()

       -- collecting available specification
      !pipeSpec = object SPECIFICATIONS()

      -- collect piping spec
      !pipeSpec.piping()
      !names        = !pipeSpec.names
      !unusedReferences   = !pipeSpec.references
      !unusedRefStrings   = !pipeSpec.refStrings

      !this.specList.dtext = !names

      !names.delete()
      -- collect insulation spec
      if !pipeSpec.insulation().not() then
         !names[1] = 'None'
      else
         !names = !pipeSpec.names
         !names.insert(1,'None')

      endif
      !this.ispecList.dtext =  !names

      !names.delete()
      -- collect tracing spec
      if !pipeSpec.tracing().not() then
         !names[1] = 'None'
      else
         !names = !pipeSpec.names
         !names.insert(1,'None')
      endif
     !this.tspecList.dtext =  !names

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getBores
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBores()

     !spec = !this.branchSpec
     !pipingSpec = object SPECIFICATION(!spec)
     !bores = !pipingSpec.bores
     !boreStrings = !bores.evaluate(object BLOCK('!bores[!evalIndex].string()') )
     !boreStrings.unique()
     $(
     var !seles coll all sele with (question of owner eq 'PBOR') for /$!this.speclist
     var !bores eval (ans) for all from !seles
     !bores.unique()
     $)
     !this.boreList.dtext = !boreStrings

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateList
--
-- Description: update the list for the active task
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateList()

  !activeTask = !this.activeTask
  !this.errors = ARRAY()

  if(!activeTask eq 'MODSPEC') then
    !this.processSpecSelection()
    !this.selectionStatus()

  elseif(!activeTask eq 'MODBORE') then
    !this.processBoreSelection()
    !this.selectionStatus()

  elseif(!activeTask eq 'MODISPEC') then
    !this.changeInsulationSpec()

  elseif(!activeTask eq 'MODTSPEC') then
    !this.changeTracingSpec()

  endif

  !!specBoreChange.components = !this.componentObjects
  !!specBoreChange.updateListData()
  !this.hide()

 -- !this.selectionStatus()
 endmethod
 -- End of method definition

------------------------------------------------------------------------
--
-- Method:     processSpecSelection
--
-- Description:  update list with new specification component for the selected spec
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .processSpecSelection()

      -- set the selected spec
      !selectedSpec = !this.specList.selection()
      !this.selectedSpec = object DBREF('/$!selectedSpec')

      --!components       = !this.componentObjects
      --!selectedIndices  = !this.listSelection

      do !index values !this.listSelection

         !componentObject      = !this.componentObjects[!index.real()]
         !this.componentObject = !componentObject
         if !this.componentObject.realComponent.type.neq('BRAN') then
            if(not !this.outOfSpec)then
              if(!componentObject.realComponent.spow neq !componentObject.realComponent.owner.pspec) then
                 !errorText = 'Element $!componentObject.designElement is from out-of-spec'
                 !this.errors.append(!errorText)
                 skip
              endif
            endif

            -- Check if we have access to modify the component
            !modifyComponent = !this.checkAccess(!componentObject)

            if !modifyComponent eq FALSE then
               !!alert.error('The current database does not have write access.')
               return
            endif

            skip if not !modifyComponent

            -- do not reselect if the selected spec is same as the component spec
            if(!componentObject.component.spow  eq  !this.selectedSpec ) then
               !errorText = 'Element $!componentObject.designElement spec is same as the selected spec'
               !this.errors.append(!errorText)
               !this.componentObject.newSpref = 'No selection available'
               !this.componentObject.newDescription = ''
               !this.componentObjects[!index.real()] = !this.componentObject
               skip
            endif
         endif

         !newSpecRef = !this.getSpecComponent(!this.selectedSpec,!componentObject.questions,!componentObject.answers)
         !this.updateComponent(!newSpecRef)

         !this.componentObjects[!index.real()] = !this.componentObject

      enddo

      !set = ARRAY()
      !selectedIndices = !this.listSelection.size()
      !setSize = !set.size()
      !errorSize = !this.errors.size()

      --does specification exist?
      if !errorSize.eq(!selectedIndices) then
         !!alert.error('No Spec components available please choose another spec.')
         --!this.ok.active = FALSE
         return
      endif
      if !this.errors.set() then
         !errorSize = !this.errors.size()
         !!alert.error('$!<errorSize> component(s) left unselected. Check the error log for more details')
         !!specBoreChange.errors = !this.errors
      endif

      --if !this.errors.size() neq !selectedIndices.size() then
        --!!specBoreChange.components = !this.componentObjects
        --!!specBoreChange.updateListData()
      --endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method:      getSpecComponent
--
-- Description:
--
-- Method Type: Function
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--     STRING    Available spec component name or returns 'No selection available'
------------------------------------------------------------------------

define method .getSpecComponent(!spec is DBREF,!questions is ARRAY,!answers is ARRAY) is STRING

  --!componentObject = !this.componentObject
  !type = !this.componentObject.componentType
  !unusedCurrentSpecRef = !this.componentObject.spref

  !specification = object SPECIFICATION(!spec)

  if(!type eq 'TUBE') then
     !specification.setSpecification(!spec)
     !this.loadTubeComponents(!specification,!spec)
  endif

  !unusedLoaded = !specification.loadTable(!type)
  !this.specification = !specification

  do !table values !specification.tables
     if(!table.type eq !type) then
        !componentTable = !table
        break
     endif
  enddo

  if undefined(!componentTable) then
     return !this.noSelection
  endif

  !tableQuestions = !questions
  !tableAnswers   = !answers

  do !i indices !tableQuestions
     if(!tableQuestions[!i] eq 'PBOR0') then
        !tableQuestions[!i] = 'PBOR1'
     endif
  enddo

  -- get components from the component table
  !components = !componentTable.components(!tableQuestions,!tableAnswers)
  handle ANY
    !components = ARRAY()
  elsehandle NONE
    if(!components.set()) then
       !specRefName = !components[1].name
       return !specRefName
    endif
  endhandle

  if !this.componentObject.component.type.eq('TEE').and(!components.unset()) then
    -- handle the old specs where you can have a 1.0 as the bore selector
    !answers[2] = object BORE(1)
    !components = !componentTable.components(!tableQuestions,!tableAnswers)
    handle ANY
    elsehandle NONE
      if(!components.set()) then
         !specRefName = !components[1].name
         return !specRefName
      endif
    endhandle
  endif

   do !i indices !questions
      if(!questions[!i] eq 'PBOR0') then
         !questions.insert(!i + 1,'PBOR1')
         !answers.insert(!i + 1,!answers[!i])
      endif
   enddo

  !typeSelector = !componentTable.selector
  !specRefName  = !this.getDefaultComponent(!typeSelector,!questions,!answers)
  return !specRefName

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getDefaultComponent
--
-- Description: gets the default selection in the spec for the component
--              if no matching selection criteria is available
-- Method Type: Function
--   [#] [R/RW] [Data Type]     [Description]
--    1   R       DBREF          Type selector
-- Return:
--   [Data Type] [Description]
--    STRING     Default spec component name or returns 'No selection available'
------------------------------------------------------------------------

define method .getDefaultComponent(!passedSelector is DBREF,!questions is ARRAY,!answers is ARRAY) is STRING

   do !i indices !questions
      if(!questions[!i].match('PBOR') gt 0 ) then
         !boreSelector = !this.getBoreSelector(!passedSelector,!questions[!i],!answers[!i])
         skip if !boreSelector eq !passedSelector
         if( !boreSelector.type eq 'SPCO') then
             return !boreSelector.name
         endif
         !passedSelector = !boreSelector
      endif
   enddo

   if( !boreSelector.unset() ) then
      return !this.noSelection

   elseif( !boreSelector.type eq 'SPCO') then
      return !boreSelector.name

   else
      -- get the default selector
      !defaultSpecComponent = !this.getDefaultSelector(!boreSelector)
      if(!defaultSpecComponent eq !boreSelector) then
         return !this.noSelection
      else
        return !defaultSpecComponent.name
      endif
   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getBoreSelector
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getBoreSelector(!passedSelector is DBREF,!question is STRING, !answer is BORE) is DBREF

    !boreQuestion = !passedSelector.question + !passedSelector.qualifier.string()
    if (!boreQuestion eq !question ) then
       do !selector values !passedSelector.members
          if(!selector.answer eq !answer) then
             return !selector
          endif
       enddo
    endif

    return !passedSelector

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getDefaultSelector
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getDefaultSelector(!selector is DBREF) is DBREF

    if(!selector.type eq 'SPCO' ) then
       return !selector
    endif

    !question = !selector.question
    !default  = !selector.default
    !tdefault = !selector.tdefault

    if !default eq 0 and !tdefault eq 'NONE' then
       return !selector

    elseif !tdefault eq 'EQUA' then
       !defaultSelector = !this.getDefaultSelector(!selector.member[1])
       -- var !spco coll all spco for $!selector
       -- if !spco.set() then
       --    return !spco[1].dbref()
       -- endif

    else
       do !sele values !selector.members
          skip if(!default neq 0 and (!sele.answer neq !default and !sele.maxans neq !default) )
          skip if(!tdefault neq 'NONE' and !sele.tanswer neq !tdefault )
          !defaultSelector = !this.getDefaultSelector(!sele)
       enddo

    endif

    if ( defined(!defaultSelector) and !defaultSelector.set() ) then
      return !defaultSelector
    else
      return !selector
    endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      processBoreSelection
--
-- Description: update list with new specification component for the selected bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processBoreSelection()

      --!components        = !this.componentObjects
      --!selectedIndices   = !this.listSelection
      !selectedBore      = !this.boreList.selection().bore()

      do !index values !this.listSelection

         !componentObject = !this.componentObjects[!index.real()]
         !this.componentObject = !componentObject

         -- Check if we have access to modify the component
         !modifyComponent = !this.checkAccess(!componentObject)
         skip if not !modifyComponent

         -- do not reselect if selected bore is same as the current bore
         if(!selectedBore eq  !componentObject.aBore ) then
            !errorText = 'Element $!componentObject.designElement bore is same as the selected bore'
            !this.errors.append(!errorText)
            !this.componentObject.newSpref = ''
            !this.componentObject.newDescription = ''
            !this.componentObjects[!index.real()] = !this.componentObject
            skip
          endif

         !questions = !componentObject.questions
         !answers   = !componentObject.answers
         -- change pbor0 to the selected bore
         !answers[1] = !selectedBore
         if !componentObject.component.type inset('TEE','OLET','VTWA') then
           if !componentObject.component.arrive.eq(3).or(!componentObject.component.arrive.eq(3)) then
             !answers[2] = !selectedBore
           endif
         endif

         !spec = !componentObject.component.spow

         !newSpecRef = !this.getSpecComponent(!spec,!questions,!answers)

         !this.updateComponent(!newSpecRef)

         !this.componentObjects[!index.real()] = !this.componentObject

      enddo


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeInsulationSpec
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeInsulationSpec()

   !currentElement = !!ce
   MARKDB

   !selectedIspec   = !this.ispecList.selection()
   if !selectedIspec.eq('None') then
      !ispec = =0
   else
      !ispec  = object DBREF('/$!selectedIspec')
   endif
   !set = ARRAY()

   do !index values !this.listSelection
     !!ce =  !this.componentObjects[!index.real()].realcomponent
     ispec $!ispec
     handle any
     endhandle
     !this.componentObjects[!index.real()].ispec = !ispec
     !set.append(1)
   enddo

   !selectedIndices = !this.listSelection.size()
   !setSize = !set.size()
   !!alert.message('$!<setSize> out of $!<selectedIndices> components modified')
   --!!specBoreChange.components = !this.componentObjects
   --!!specBoreChange.updateListData()

   ENDMARKDB

   !!ce = !currentElement

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeTracingSpec
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeTracingSpec()

  !currentElement = !!ce

    --MARKDB

 !selectedTspec = !this.tspecList.selection()
   if !selectedTspec.eq('None') then
      !tspec = =0
   else
      !tspec  = object DBREF('/$!selectedTspec')
   endif
   !set = ARRAY()


   do !index values !this.listSelection
     !!ce =  !this.componentObjects[!index.real()].realcomponent
     tspec $!tspec
     handle any
     endhandle
     !this.componentObjects[!index.real()].tspec = !tspec
     !set.append(1)
   enddo

   !selectedIndices = !this.listSelection.size()
   !setSize = !set.size()
   !!alert.message('$!<setSize> out of $!<selectedIndices> components modified')
   --!!specBoreChange.components = !this.componentObjects
   --!!specBoreChange.updateListData()

   --ENDMARKDB

  !!ce = !currentElement

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadTubeComponents
--
-- Description: Load the available TUBE components for the spec
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadTubeComponents(!specification is SPECIFICATION,!spec is DBREF)

  -- Initialise Variables
  !descriptions = ARRAY()
  !types        = ARRAY()
  !selectors    = ARRAY()

  -- Get available component types of specification
  !members = !spec.members

  -- Loop through and get the type
  do !i indices !members

    -- Ignore no selectors
    skip if(!members[!i].type ne 'SELE')

    -- Get Text answer
    !type = !members[!i].tanswer

    -- Get noun definition of type
    var !data nounDef $!<type> rptx
    handle ANY
      !name = !type
    elsehandle NONE
      !name = !data[1]
    endhandle

    !types.append(!type)

    -- Special Case Names
    if(!type eq 'ATTA') then
      !descriptions.append('Attachment Point')
    elseif (!type eq 'PCOM') then
      !descriptions.append('Piping Component')
    elseif (!type eq 'FTUB') then
      !descriptions.append('Fixed Length Tube')
    elseif (!type eq 'LJSE') then
      !descriptions.append('Lap-Joint with Stub End')
    elseif (!type eq 'SHU') then
      !descriptions.append('Standard Hook-up')
    else
      !descriptions.append(!name.substring(1,1) & !name.substring(2).lowcase())
    endif
    !selectors.append(!members[!i])

  enddo

  -- If there are no components, then return
  if(!types.empty()) then
    return
  endif

  -- Remove bolting from the component list
  !index      = !types.findFirst('BOLT')
  if(!index.set()) then
    !types.remove(!index)
    !descriptions.remove(!index)
    !selectors.remove(!index)
  endif

  -- Sort components into order
  !order              = !descriptions.sortedIndices()
  !types.reIndex(!order)
  !descriptions.reIndex(!order)
  !selectors.reIndex(!order)

  -- Set object members
  !specification.types         = !types
  !specification.descriptions  = !descriptions
  !specification.selectors     = !selectors

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectionStatus()

      --!components = !this.componentObjects
      --!indices  = !this.listSelection
      !set = ARRAY()
      !unset = ARRAY()

      do !index values !this.listSelection
        !componentObject = !this.componentObjects[!index.real()]
        !this.componentObject = !componentObject
        !newSpref = !componentObject.newSpref

        if(!newSpref eq '' or !newSpref eq !this.noSelection )then
           !unset.append(!index.real())
        else
           !set.append(!index.real())
        endif
      enddo

      !setSize = !set.size()
      -- checks to see if specification exists.
      if !setSize.eq(0) then
        --!!alert.error('Can not find components.')
        return
      endif
      !unsetSize = !unset.size()
      !totalSelection = !setSize + !unsetSize
      !!specBoreChange.selectionStatus.visible = true

      !!specBoreChange.selectionStatus.val = 'Selection available       : $!setSize                     Selection not available : $!unsetSize                           Total Selection             : $!totalSelection '
      !!specBoreChange.selectionStatus.background = 5

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      checkAccess
--
-- Description: Check if we have access to modify the component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     COMPMODITEM  Component Object
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if component have access rights, false otherwise
------------------------------------------------------------------------

define method .checkAccess(!componentObject is  COMPMODITEM) is BOOLEAN

     -- check dac of mtbe for tubes
     if(!componentObject.componentType eq 'TUBE') then

        !component = !componentObject.realComponent

        if(!component.type eq 'BRAN') then
           !attribute = 'HSTU'
        else
           !attribute = 'LSTU'
        endif

     else

        !component = !componentObject.component
        !attribute = 'SPREF'

     endif

     if(!!dbrefUpdate(!component).not()) then
        !this.errors.append(!!error.text)
        return FALSE
     endif

     !modAttrib = MODERR $!<attribute> of $!<component>

     if (!modAttrib.set() and !modAttrib.length().gt(0)) then
        !this.errors.append(!modAttrib)
        return FALSE
     endif

     return TRUE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateComponent
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     SpecRef string to be updated in component object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateComponent(!specRef is STRING)

         !element = !this.componentObject.designElement
         !this.componentObject.newSpref = !specRef

         if(!specRef eq !this.noSelection) then
            !errorText = 'No selection available for element $!<element>'
            !this.errors.append(!errorText)
            !this.componentObject.newDescription = 'unset'
            !this.componentObject.newDescription = ' '

         else
            !description = !specRef.dbref().dtxr
            handle ANY
              !description = 'unset'
            endhandle

            !material      = !specRef.dbref().mtxx
            handle ANY
              !material = 'unset'
            endhandle

            !fullDescription = !description + ' ' + !material
            !this.componentObject.newDescription = !fullDescription
            !this.componentObject.getnewbores()

         endif

endmethod
-- End of method definition

------------------------------------------------------------------------
