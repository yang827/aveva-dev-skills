-- File:            selectpipepeneform.pmlfrm
--   Type:          Function Definition
--   Group:         Pipe Penetrations
--     Keyword:
--   Module:        design
--   Replaces:
--
-- Author:          R Martin
-- Created:         24th May 2007
--
--
-- Description:
-- make an edg selection for a single pipe penetration and save the picked items in the _CD1to1pene form
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  highlight(BOOLEAN)               -
--  populate(ARRAY)                  -                   populate the old !!CD1TO1PENE form with data regarding the picked penetration items
--  selectPipePenetration()          -
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------


setup form !!selectPipePeneForm
  member .penetrated  is DBREF
  member .penetrating is DBREF
  member .pickedPenetrating is DBREF
  member .penetratedAidNum  is REAL
  member .penetratingAidNum is REAL
  member .type is STRING

  !this.penetratedAidNum  = !!aidNumbers.add('Penetrated')
  !this.penetratingAidNum = !!aidNumbers.add('Penetrating')
exit

-- Define function
define method .selectPipePenetration()

  -- unenhance the existing selection
  !this.highlight(FALSE)

  -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'singlePipePene'
  !packet.type        = 'singlePipePene'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = 'singlePipePene'
  !packet.action      = '!!selectPipePeneForm.populate(!this.return[1])'

  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('Pick Penetrated item')
  !packet.pickPacket.picks[2]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdElement('Pick Penetrating item')
  !!edgcntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      populate
--
-- Description: populate the old !!CD1TO1PENE form with data regarding the picked penetration items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populate(!data is ARRAY)

  !penetrated   = !data[1].item
  !penetrating  = !data[2].item
  !this.pickedPenetrating = !data[2].item
  -- If the user can't write to the penetrating item then stop
  if (!penetrating.dbwrite.not()) then
    !!alert.error('Unable to write to the penetrating item')
    return
  endif

  if (!penetrated.type inset('PANE','HPLATE','FLOOR','SCREED','CPLATE')) then
    !penetratedFound = TRUE
  else
    !penetratedOwners = !penetrated.ahlis
    !index = !penetratedOwners.size()
    !owner ='.owner'
    !penetratedFound  = FALSE

    do !i from !index to 1 by -1
      if (!penetrated$!owner$n.type inset('PANE','HPLATE','FLOOR','SCREED','CPLATE')) then
        !penetratedFound = TRUE
        !penetrated = !penetrated$!owner
        break
      else
        !owner = '$!owner' & '.owner'
      endif
    enddo
  endif

  if (!penetrating.type neq 'BRAN') then
    !penetratingOwners = !penetrating.ahlis
    !index = !penetratingOwners.size()
    !owner ='.owner'
    !penetratingFound = FALSE

    do !i from !index to 1 by -1
      if (!penetrating$!owner$n.type neq 'BRAN') then
        !owner = '$!owner' & '.owner'
      else
        !penetratingFound = TRUE
        !penetrating = !penetrating$!owner
        break
      endif
    enddo
  else
    !penetratingFound = TRUE
  endif

  if (!penetratedFound.not()) then
    !!cd1to1pene.hole.val = ''
    !!cd1to1pene.item.val = ''
    !!alert.warning('selected object cannot be penetrated please select again')
  elseif (!penetratingFound.not()) then
    !!cd1to1pene.hole.val = ''
    !!cd1to1pene.item.val = ''
    !!alert.warning('selected item is not a pipe/hvac/tray please select again')
  else

    !!cd1to1pene.hole.val = !penetrated.name
    handle any
      return
    elsehandle NONE
      !this.penetrated = !penetrated
    endhandle

    !!cd1to1pene.item.val = !penetrating.name
    handle any
      return
    elsehandle NONE
      !this.penetrating = !penetrating
    endhandle

    !this.highlight(TRUE)
    !!cd1to1pend.apply.active = TRUE

  endif

endmethod

define method .highlight(!mode is BOOLEAN)
  -- highlight the selected components
  -- this method needs refinement, the enhance colour
  -- needs to be linked to values that are appropriate for the autocolour of the model.

  unenhance all

  -- mode will be TRUE or FALSE dependent upon whether you want to switch on or turn off highlighting
  if !mode then

    if !this.penetrated.unset().not() then
      enhance $!this.penetrated colour $!!gphcolopt.highlight
      --!pos = !this.penetrated.position.wrt( /* )
      --aid text num $!this.penetratedAidNum 'Penetrated Item' at $!pos
    endif

    if !this.penetrating.unset().not() then
      enhance $!this.penetrating colour $!!gphcolopt.highlight
      --!pos = !this.penetrating.hpos.wrt( /* )
      --aid text num $!this.penetratingAidNum 'Penetrating Item' at $!pos
      --handle any
      --endhandle
    endif

  else
    unenhance $!this.penetrated
    handle any
    endhandle
    unenhance $!this.penetrating
    handle any
    endhandle
    --aid clear text $!this.penetratedAidNum
    --handle any
    --endhandle
    --aid clear text $!this.penetratingAidNum
    --handle any
    --endhandle
  endif

endmethod
-- End of function definition
