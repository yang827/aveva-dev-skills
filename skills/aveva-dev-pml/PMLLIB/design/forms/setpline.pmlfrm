--
--  Description:     Set justification P Line
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel call
--  setpline()                       -                   Constructor
--
------------------------------------------------------------------------

setup form !!setpline dialog resize

  -- Element pick gadget
  option    .pickType anchor t + l at xmin   ymax                           callback '!!stlPlines.loadPick(!this.pickType.selection())' width 6
  paragraph .ceName                at xmax+1 ymin              anchor t+l+r      text || width 28 lines 1

  -- Pline pick for choosing justification
  button    .pick 'Justification'  at xmin.pickType+1 ymax+0.2              callback '!!stlPlines.loadPick(|IDPL|)' width 10
  option    .just                  at xmax+1          ymin     anchor t+l+r callback |!!stlPlines.pLineFeedback(!this.just.selection(), !!stlPlines.item)| width 20

  -- Options for re-trimming attached sections
  paragraph .rflgpara              at xmin.pickType+1 ymax+0.2 text |Re-trim attached section.| width 16 height 1
  toggle    .rflg ||               at xmax+1 ymin          states |false| |true|

  -- Alter justification of picked item
  button    .dismiss 'Dismiss'     at xmax form-size ymax form+0.2 anchor b+r width 8 cancel
  button    .apply   'Apply'       at xmin form+0    ymin          anchor b+l width 8 callback '!!stlPlines.apply()'

  -- Undo event handlers
  member .undoApply            is UNDOABLE

exit

------------------------------------------------------------------------
--
-- Method:      setpline
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
define method .setpline()

  !this.formTitle  = |{title}|
  !this.callback   = '!!stlPlines.loadPick(|CE|)'
  !this.iconTitle  = 'Set Pline'
  !this.cancelCall = '!!setpline.cancel()'

  !pickOptions = ARRAY()
  !pickOptions.append('CE')
  !pickOptions.append('list')
  !pickOptions.append('Pick')

  !this.pickType.dtext = !pickOptions

  !this.undoApply.description('Set Joint PLINE')
  !this.apply.setUndoable(!this.undoApply)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: Cancel call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  !!edgcntrl.remove(!!stlPlines.sctnPacket)
  !!edgcntrl.remove(!!stlPlines.plinPacket)
  !!stlPlines.clearFeedback()

endmethod
-- End of method
