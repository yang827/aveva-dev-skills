--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          Ricky Thompson
-- Created:         <day> <date> <time> <year>
--
-- Description:     Select surface treatment from a list of available values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Apply()                          -                   Take user selections and update the main form
--  GenerateFaceList()               -                   Show data for existing FASPEC elements
--  Initialise()                     -                   Initialise the form each time it is displayed
--  PrintList()                      -                   Print the data grid contents
--  RefreshList()                    -                   Refresh Face spec list
--  sftAssignFace()                  -
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.Pdms.Presentation'

------------------------------------------------------------------------
-- Form:      sftAssignFace
------------------------------------------------------------------------

setup form !!sftAssignFace dialog docking size 65 18

-- Define titles and initialisation call
  !this.formTitle = 'Face Code Spec - Selection'
  !this.iconTitle = 'Face Code Spec - Selection'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path down
  vdist 0.5

  frame .frmFaspecList  'List of FASPEC elements'   at xmin form           ymax + 0.5 width 65 height 15
    container .conFaspecGrid PMLNetCONTROL 'NET'    at xmin                ymin + 0.5 dock fill
  exit

  path right
  button .btnOK      ' Apply '                      at xmin form + 5       ymax + 0.5 width 10 callback |!this.Apply()|
  button .btnPrint   ' Print '                      at xmax.btnOK + 3                 width 10 callback |!this.PrintList()|
  button .btnRefresh 'Refresh'                      at xmax.btnPrint + 3              width 10 callback |!this.RefreshList()|
  button .btnCANCEL  'Dismiss'                      at xmax.btnRefresh + 3 ymin.btnOK width 10 CANCEL

-- End of FORM definition

-- Define member variables
   member .ngcFaspecList      is  NETGRIDCONTROL
   member .FaspecHeadings     is  ARRAY

   member .Debug              is  BOOLEAN

-- Define collection data from PARAGON with PURPOSE filter
   member .SurfaceTreat       is  SFTGETTING

exit


------------------------------------------------------------------------
--
-- Method:      sftAssignFace
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftAssignFace()

-- Control of additional debugging messages during processing
  !this.Debug = FALSE
  if (defined(!!DEBUG) ) then
    !this.Debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for PAINT
  !this.ngcFaspecList = object NetGridControl()
  !this.conFaspecGrid.control = !this.ngcFaspecList.handle()

endmethod
-- End of method definition for .sftAssignList()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Initialise()

  if (!this.Debug) then
    $P Running sftAssignFace.Initialise()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Setup the display grid headings
  !this.FaspecHeadings[1] = 'NAME'
  !this.FaspecHeadings[2] = 'PASPEC'
  !this.FaspecHeadings[3] = 'DESCR'

  !this.FaspecHeadings[4] = 'STINRF'
  !this.FaspecHeadings[5] = 'STINCD'

  !this.FaspecHeadings[6] = 'STOURF'
  !this.FaspecHeadings[7] = 'STOUCD'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcFaspecList.columnExcelFilter(!f)
  !this.ngcFaspecList.outlookGroupStyle(!f)
  !this.ngcFaspecList.fixedHeaders(!f)
  !this.ngcFaspecList.fixedRows(!f)
  !this.ngcFaspecList.editableGrid(!f)
  !this.ngcFaspecList.singlerowselection(!t)
  !this.ngcFaspecList.setalternaterowcolor('lightgray')

-- Remove any previous selection
  !this.ngcFaspecList.clearrowselection()

-- Temporary code to populate the form for realism
--  !this.ShowExampleData()
  !this.GenerateFaceList()

endmethod
-- End of method definition for .Initialise()


------------------------------------------------------------------------
--
-- Method:      Apply()
--
-- Description: Take user selections and update the main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Apply()

-- Update main form with selected values
  !SelectedRowTags = !this.ngcFaspecList.GetSelectedRowTags()

  if (!SelectedRowTags.unset() ) then
    !!alert.error('No grid item selected')
    return
  endif

  !FaceRef = !this.ngcFaspecList.GetSelectedRows()[1][1]

  !InsideSRef = !this.ngcFaspecList.GetSelectedRows()[1][4]
  !Inside = !this.ngcFaspecList.GetSelectedRows()[1][5]

  !OutsideSRef = !this.ngcFaspecList.GetSelectedRows()[1][6]
  !Outside = !this.ngcFaspecList.GetSelectedRows()[1][7]

  !!sftAssignMain.UpdateInsideCode(!Inside, !InsideSRef, !FaceRef)
  !!sftAssignMain.UpdateOutsideCode(!Outside, !OutsideSRef, !FaceRef)

-- Close the current form
  hide !!sftAssignFace

endmethod
-- End of method definition for .Apply()


------------------------------------------------------------------------
--
-- Method:      GenerateFaceList()
--
-- Description: Show data for existing SRFTRT elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateFaceList()

  if (!this.Debug) then
    $P Running sftAssignFace.GenerateFaceList()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  if (NOT !this.SurfaceTreat.GetFaceOwnerPoint()) then
      return
  endif

  !allfaces = !this.SurfaceTreat.GetAllFaceSpec()

  !arrGridRowData = object ARRAY()
  do !face values !allfaces
     !item[1] = !face.dbref().name

     if (!face.dbref().paspec.set()) then
         !item[2] = !face.dbref().paspec.name
         !item[3] = !face.dbref().paspec.descr
     else
         -- should be error
         skip
     endif

     if (!face.dbref().stinrf.set()) then
        !item[4] = !face.dbref().stinrf.name
     else
        !item[4] = ''
     endif
     !item[5] = !face.dbref().stincd

     if (!face.dbref().stourf.set()) then
        !item[6] = !face.dbref().stourf.name
     else
        !item[6] = ''
     endif
     !item[7] = !face.dbref().stoucd
     !arrGridRowData.append(!item)
  enddo

-- Bind example data to grid
  !nds = object NETDATASOURCE('Face Codes', !this.FaspecHeadings, !arrGridRowData)
  !this.ngcFaspecList.bindToDataSource(!nds)

endmethod
-- End of method definition for .GenerateFaceList()

------------------------------------------------------------------------
--
-- Method:      PrintList()
--
-- Description: Print preview the grid data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .PrintList()

  if (!this.ngcFaspecList.getNumberRows().neq(0)) then
    !this.ngcFaspecList.PrintPreview()
  else
    !!alert.Error('No data to print')
  endif

endmethod
-- End of method definition for .PrintList()

------------------------------------------------------------------------
--
-- Method:      .RefreshList()
--
-- Description: Refresh Face spec list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .RefreshList()

  if (!this.Debug) then
      $P Running sftAssignFace.RefreshList()
  endif

  !this.GenerateFaceList()

endmethod
-- End of method definition for .RefreshList()
