--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          Ricky Thompson
-- Created:         <day> <date> <time> <year>
--
-- Description:     Select surface treatment from a list of available values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Apply()                          -                   Take user selections and update the main form
--  GenerateItemList()               -                   Show data for existing ITSPEC elements
--  Initialise()                     -                   Initialise the form each time it is displayed
--  PrintList()                      -                   Print the data grid contents
--  RefreshList()                    -                   Refresh Item spec list
--  sftAssignItem()                  -
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.Pdms.Presentation'
	
------------------------------------------------------------------------
-- Form:      sftAssignItem
------------------------------------------------------------------------

setup form !!sftAssignItem dialog docking size 65 18

-- Define titles and initialisation call
  !this.formTitle = 'Item Code Spec - Selection'
  !this.iconTitle = 'Item Code Spec - Selection'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path down
  vdist 0.5

  frame .frmItspecList  'List of FASPEC elements'   at xmin form           ymax + 0.5  width 65  height 15
    container .conItspecGrid PMLNetCONTROL 'NET'    at xmin                ymin + 0.5  dock fill
  exit

  path right
  button .btnOK      ' Apply '                      at xmin form + 5       ymax + 0.5  width 10  callback |!this.Apply()|
  button .btnPrint   ' Print '                      at xmax.btnOK + 3                  width 10  callback |!this.PrintList()|
  button .btnRefresh 'Refresh'                      at xmax.btnPrint + 3               width 10  callback |!this.RefreshList()|
  button .btnCANCEL  'Dismiss'                      at xmax.btnRefresh + 3 ymin.btnOK  width 10  CANCEL

-- End of FORM definition

-- Define member variables
   member .ngcItspecList      is  NETGRIDCONTROL
   member .ItspecHeadings     is  ARRAY

   member .Debug              is  BOOLEAN

-- Define collection data from PARAGON with PURPOSE filter
   member .SurfaceTreat      is  SFTGETTING
exit


------------------------------------------------------------------------
--
-- Method:      sftAssignItem
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftAssignItem()

-- Control of additional debugging messages during processing
  !this.Debug = FALSE
  if (defined(!!DEBUG) ) then
    !this.Debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for PAINT
  !this.ngcItspecList = object NetGridControl()
  !this.conItspecGrid.control = !this.ngcItspecList.handle()

endmethod
-- End of method definition for .sftAssignList()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Initialise()

  if (!this.Debug) then
    $P Running sftAssignItem.Initialise()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Setup the display grid headings
  !this.ItspecHeadings[1] = 'NAME'

  !this.ItspecHeadings[2] = 'STINRF'
  !this.ItspecHeadings[3] = 'STINCD'

  !this.ItspecHeadings[4] = 'STOURF'
  !this.ItspecHeadings[5] = 'STOUCD'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcItspecList.columnExcelFilter(!f)
  !this.ngcItspecList.outlookGroupStyle(!f)
  !this.ngcItspecList.fixedHeaders(!f)
  !this.ngcItspecList.fixedRows(!f)
  !this.ngcItspecList.editableGrid(!f)
  !this.ngcItspecList.singlerowselection(!t)
  !this.ngcItspecList.setalternaterowcolor('lightgray')

-- Remove any previous selection
  !this.ngcItspecList.clearrowselection()

-- Temporary code to populate the form for realism
--  !this.ShowExampleData()
  !this.GenerateItemList()

endmethod
-- End of method definition for .Initialise()

------------------------------------------------------------------------
--
-- Method:      Apply()
--
-- Description: Take user selections and update the main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Apply()

-- Update main form with selected values
  !SelectedRowTags = !this.ngcItspecList.GetSelectedRowTags()

  if (!SelectedRowTags.unset() ) then
    !!alert.error('No grid item selected')
    return
  endif

  !ItemRef = !this.ngcItspecList.GetSelectedRows()[1][1]

  !InsideSRef = !this.ngcItspecList.GetSelectedRows()[1][2]
  !Inside = !this.ngcItspecList.GetSelectedRows()[1][3]

  !OutsideSRef = !this.ngcItspecList.GetSelectedRows()[1][4]
  !Outside = !this.ngcItspecList.GetSelectedRows()[1][5]

  !!sftAssignMain.UpdateInsideCode(!Inside, !InsideSRef, !ItemRef)
  !!sftAssignMain.UpdateOutsideCode(!Outside, !OutsideSRef, !ItemRef)

-- Close the current form
  hide !!sftAssignItem

endmethod
-- End of method definition for .Apply()


------------------------------------------------------------------------
--
-- Method:      GenerateItemList()
--
-- Description: Show data for existing SRFTRT elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateItemList()

  if (!this.Debug) then
    $P Running sftAssignFace.GenerateItemList()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  if (NOT !this.SurfaceTreat.GetItemOwnerPoint()) then
      return
  endif

  !allfaces = !this.SurfaceTreat.GetAllItemSpec()

  !arrGridRowData = object ARRAY()

---- Bind example data to grid
  do !itemele values !allfaces
     !item[1] = !itemele.dbref().name

     if (!itemele.dbref().stinrf.set()) then
        !item[2] = !itemele.dbref().stinrf.name
     else
        !item[2] = ''
     endif
     !item[3] = !itemele.dbref().stincd

     if (!itemele.dbref().stourf.set()) then
        !item[4] = !itemele.dbref().stourf.name
     else
        !item[4] = ''
     endif
     !item[5] = !itemele.dbref().stoucd
    !arrGridRowData.append(!item)
  enddo

------ Bind example data to grid
  !nds = object NETDATASOURCE('Surface Treatments', !this.ItspecHeadings, !arrGridRowData)
  !this.ngcItspecList.bindToDataSource(!nds)

endmethod
-- End of method definition for .GenerateItemList()

------------------------------------------------------------------------
--
-- Method:      PrintList()
--
-- Description: Print preview the grid data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .PrintList()

  if (!this.ngcItspecList.getNumberRows().neq(0)) then
    !this.ngcItspecList.PrintPreview()
  else
    !!alert.Error('No data to print')
  endif

endmethod
-- End of method definition for .PrintList()

------------------------------------------------------------------------
--
-- Method:      .RefreshList()
--
-- Description: Refresh Face spec list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .RefreshList()

  if (!this.Debug) then
      $P Running sftAssignItem.RefreshList()
  endif

  !this.GenerateItemList()

endmethod
-- End of method definition for .RefreshList()
