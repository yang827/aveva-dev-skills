--
-- File:            sftAssignList.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          Ricky Thompson
-- Created:         <day> <date> <time> <year>
--
-- Description:     Select surface treatment from a list of available values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Apply()                          -                   Take user selections and update the main form
--  Clear()                          -                   Text gadget clear
--  GenerateSurfTreatList()          -                   Show data for existing SRFTRT elements
--  GridPopupHandler(ARRAY)          -                   Handle selection from Popup menu
--  Initialise()                     -                   Initialise the form each time it is displayed
--  SetBoth()                        -                   Take user selection in list and set as Inside/Outside value
--  SetInside()                      -                   Take user selection in list and set as Inside value
--  SetOutside()                     -                   Take user selection in list and set as Outside value
--  sftAssignList()                  -
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.Pdms.Presentation'
	
------------------------------------------------------------------------
-- Form:      sftAssignList
------------------------------------------------------------------------

--setup form !!sftAssignList dialog  size 50 12
setup form !!sftAssignList dialog docking size 55 20

-- Define titles and initialisation call
   !this.formTitle = 'Surface Treatment - Selection'
   !this.iconTitle = 'Surface Treatment - Selection'
   !this.initcall  = '!this.initialise()'

   hdist 1
   halign centre
   path down
   vdist 0.5

   frame .frmSurfTreatList  'List of SRFTRT elements'  at xmin form                ymin  width 60 height 14
     container .conSurfTreatGrid PMLNetCONTROL 'NET'   at xmin                     ymin + 0.5  dock fill
   exit

   path right
   para   .parInsideRef                                at xmin form + 1.2          ymax+0.5    text  'Inside Symbol Ref'
   text   .txtInsideRef                                at xmax.parInsideRef - 4.2              width 15 is STRING
   para   .parInside                                   at xmax.txtInsideRef + 3.2              text  'Inside Symbol Code'
   text   .txtInside                                   at xmax.parInside - 4                   width 10 is STRING

   para   .parOutsideRef                               at xmin form                ymax+0.5    text  'Outside Symbol Ref'
   text   .txtOutsideRef                               at xmax.parOutsideRef - 4               width 15 is STRING
   para   .parOutside                                  at xmax.txtOutsideRef + 2               text  'Outside Symbol Code'
   text   .txtOutside                                  at xmax.parOutside -3.8                 width 10 is STRING

   button .btnOK         ' Apply '                     at xmin form + 0.5          ymax + 0.5  CALLBACK '!this.Apply()'
   button .btnInside     ' Inside'                     at xmax.btnOK + 1                       CALLBACK '!this.SetInside()'
   button .btnOutside    'Outside'                     at xmax.btnInside + 1                   CALLBACK '!this.SetOutside()'
   button .btnBoth       '  Both '                     at xmax.btnOutside + 1                  CALLBACK '!this.SetBoth()'
   button .btnClear      ' Clear '                     at xmax.btnBoth + 1                     CALLBACK '!this.Clear()'
   button .btnCANCEL     'Dismiss'                     at xmax.btnClear + 1                    CANCEL

-- End of FORM definition

-- Right click menu for managing paint
  menu .mnuSurfaceTreatOptions popup
    !this.mnuSurfaceTreatOptions.add( 'CALLBACK', 'Inside Ref','!this.SetInside()' )
    !this.mnuSurfaceTreatOptions.add( 'CALLBACK', 'Outside Ref','!this.SetOutside()' )
    !this.mnuSurfaceTreatOptions.add( 'CALLBACK', 'In & Outside Ref','!this.SetBoth()' )

-- Define member variables
   member .ngcSurfTreatList   is  NETGRIDCONTROL
   member .SurfTreatHeadings  is  ARRAY

   member .Debug              is  BOOLEAN

-- Define collection data from PARAGON with PURPOSE filter
   member .SurfaceTreat       is  SFTGETTING
exit


------------------------------------------------------------------------
--
-- Method:      sftAssignList
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftAssignList()

-- Control of additional debugging messages during processing
  !this.Debug = FALSE
  if (defined(!!DEBUG) ) then
    !this.Debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for PAINT
  !this.ngcSurfTreatList = object NetGridControl()
  !this.conSurfTreatGrid.control = !this.ngcSurfTreatList.handle()

  !this.conSurfTreatGrid.popup = !this.mnuSurfaceTreatOptions

-- add PML event handlers to .Net control
  !this.ngcSurfTreatList.addeventhandler('OnPopup', !this, 'GridPopupHandler')

endmethod
-- End of method definition for .sftAssignList()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Initialise()

  if (!this.Debug) then
    $P Running sftList.Initialise()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Setup the display grid headings
  !this.SurfTreatHeadings[1] = 'NAME'
  !this.SurfTreatHeadings[2] = 'SURMATERIAL'
  !this.SurfTreatHeadings[3] = 'SHOPRIMER'
  !this.SurfTreatHeadings[4] = 'SURPREPARATION'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSurfTreatList.columnExcelFilter(!f)
  !this.ngcSurfTreatList.outlookGroupStyle(!f)
  !this.ngcSurfTreatList.fixedHeaders(!f)
  !this.ngcSurfTreatList.fixedRows(!f)
  !this.ngcSurfTreatList.editableGrid(!f)
  !this.ngcSurfTreatList.singlerowselection(!t)
  !this.ngcSurfTreatList.setalternaterowcolor('lightgray')

-- Remove any previous selection
  !this.ngcSurfTreatList.clearrowselection()

-- Temporary code to populate the form for realism
--  !this.ShowExampleData()
  !this.GenerateSurfTreatList()

-- Disable input on display fields
  !this.txtInside.SetEditable(TRUE)
  !this.txtInsideRef.SetEditable(FALSE)
  !this.txtOutside.SetEditable(TRUE)
  !this.txtOutsideRef.SetEditable(FALSE)

  !this.Clear()

endmethod
-- End of method definition for .Initialise()


------------------------------------------------------------------------
--
-- Method:      SetInside()
--
-- Description: Take user selection in list and set as Inside value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .SetInside()

  if (NOT !this.ngcSurfTreatList.GetSelectedRows().set() ) then
    !!alert.error('No selection has been made')
    return
  endif

  !this.txtInsideRef.val = !this.ngcSurfTreatList.GetSelectedRows()[1][1]

endmethod
-- End of method definition for .SetInside()


------------------------------------------------------------------------
--
-- Method:      SetOutside()
--
-- Description: Take user selection in list and set as Outside value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .SetOutside()

  if (NOT !this.ngcSurfTreatList.GetSelectedRows().set() ) then
    !!alert.error('No selection has been made')
    return
  endif

  !this.txtOutsideRef.val = !this.ngcSurfTreatList.GetSelectedRows()[1][1]

endmethod
-- End of method definition for .SetOutside()

------------------------------------------------------------------------
--
-- Method:      Clear()
--
-- Description: Clear Text gadget value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Clear()

  !this.txtInside.val = ''
  !this.txtInsideRef.val = ''
  !this.txtOutside.val = ''
  !this.txtOutsideRef.val = ''
  !this.ngcSurfTreatList.clearRowSelection()

endmethod
-- End of method definition for .Clear()

------------------------------------------------------------------------
--
-- Method:      SetBoth()
--
-- Description: Take user selection in list and set as Inside/Outside value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .SetBoth()

  !this.SetInside()
  !this.SetOutside()

endmethod
-- End of method definition for .SetBoth()

------------------------------------------------------------------------
--
-- Method:      Apply()
--
-- Description: Take user selections and update the main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Apply()

-- Update main form with selected values
  !!sftAssignMain.UpdateInsideCode(!this.txtInside.val.trim(), !this.txtInsideRef.val, '')
  !!sftAssignMain.UpdateOutsideCode(!this.txtOutside.val.trim(), !this.txtOutsideRef.val, '')

-- Close the current form
  hide !!sftAssignList

endmethod
-- End of method definition for .Apply()


------------------------------------------------------------------------
--
-- Method:      GenerateSurfTreatList()
--
-- Description: Show data for existing SRFTRT elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateSurfTreatList()

  if (!this.Debug) then
    $P Running sftAssignListMain.GenerateSurfTreatList()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  if (NOT !this.SurfaceTreat.GetSurfacePoint()) then
      return
  endif

  !allsrftrt = !this.SurfaceTreat.GetAllSurfaceCode()

-- Bind example data to grid
  !nds = object NETDATASOURCE('Surface Treatments', !this.SurfTreatHeadings, !allsrftrt)
  !this.ngcSurfTreatList.bindToDataSource(!nds)

endmethod
-- End of method definition for .GenerateSurfTreatList()

------------------------------------------------------------------------
--
-- Method:      GridPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GridPopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data[2].set() ) then
    !this.conSurfTreatGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .GridPopupHandler()
