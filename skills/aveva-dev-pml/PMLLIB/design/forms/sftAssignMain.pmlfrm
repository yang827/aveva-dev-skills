------------------------------------------------------------------------
-- Method:      PickElements
--
-- Description: Graphically pick elements for inclusion on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of DBREFs to be displayed
------------------------------------------------------------------------
define method .PickElements()

    if (!this.Debug) then
       $P Running sftAssignMain.PickElements()
    endif

    !this.edgSelected = object ARRAY()

    !packet1 = object EDGPACKET()
    !edgdesc = 'Pick Elements item (BRAN,SCTN,SUBS,EQUI,FRMW)'
    !packet1.elementPick(!edgdesc)

    !rule = 'TYPE INSET (|BRAN|,|SCTN|,|SUBS|,|EQUI|,|FRMW|)'
    !packet1.priority       = 1
    !packet1.pickpacket.picks[1].pick.input[3] = !rule
    !packet1.pickpacket.picks[1].pick.modifiable = FALSE
    !packet1.remove = FALSE

    !packet1.action = '!!sftAssignMain.ClickCallBack(!this.return[1].item)'
    !packet1.close = '!!sftAssignMain.CloseCallBack()'

    if (!!edgCntrl.add(!packet1).NOT()) then
       !!alert.error('Failed loading' + !!error.text)
    endif

    --!!edgCntrl.viewStack()

endmethod
-- End of method PickElements()

------------------------------------------------------------------------
--
-- Method:      .ClickCallBack()
--
-- Description: EDG Click Action callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ClickCallBack(!dbRef is DBREF)

   if (!this.Debug) then
    $P Running ClickCallBack()
  endif

   !this.edgSelected.append(!dbRef)

endmethod
-- End of method definition for .ClickCallBack

------------------------------------------------------------------------
--
-- Method:      .CloseCallBack()
--
-- Description: EDG CloseAction callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .CloseCallBack()

   if (!this.Debug) then
    $P Running CloseCallBack()
   endif

   !this.ShowtoGridControl(!this.edgSelected)

endmethod

------------------------------------------------------------------------
--
-- Method:      .ShowtoGridControl()
--
-- Description: Display selected item data to Grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ShowtoGridControl(!selectedItem is ARRAY)

   if (!this.jobStatus eq 'ADD') then
       !GridData = !this.ngcSelected.getRows()
       do !idx index !GridData
          !selectedItem.append(!GridData[$!idx][2].dbref())
       enddo
   endif

   if (!selectedItem.size().eq(0) OR !selectedItem[1].objecttype().neq('DBREF') ) then
       !this.ngcSelected.clearGrid()
       return
   endif

-- Generate the array of data for DTEXT
   !rowdata = !this.GenerateDisplayData(!selectedItem)

-- Clear displayed list before update
   !this.ngcSelected.ClearGrid()
   !this.ClearGadget()

-- Update the displayed data
   !this.UpdateDisplayedList(!rowdata)

endmethod
-- End of method definition for .ClickCallBack

------------------------------------------------------------------------
-- Method:      RemoveFromList
--
-- Description: Remove selected items from the displayed list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .RemoveFromList()

   !this.ngcSelected.deleteSelectedRows()

endmethod
-- End of method RemoveFromList()


------------------------------------------------------------------------
-- Method:      ReplaceWithOwner
--
-- Description: Replace the selected entry with the owning item
--              NOTE:
--              Need to add a check in case owner applies to more than one item in list
--              e.g. 2 branches listed but one selected for "replace with owner"
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ReplaceWithOwner()

  !GridData = !this.ngcSelected.GetRows()

-- Generate a list of DBREFs to be added and remove selected existing entries
  !extraRefs = array()
  do !loop values !this.ngcSelected.GetSelectedRowTags()
    !chosenRef = object DBREF(!this.ngcSelected.GetRow($!loop)[2])
    !extraRefs.append(!chosenRef.owner)
    !GridData.Remove($!loop)
  enddo

-- Generate a list of DBREFs for all existing entries that are left over
  !existingRefs = array()
  do !idx index !GridData
    !chosenRef = object DBREF(!GridData[$!idx][2])
    !existingRefs.append(!chosenRef)
  enddo
  !allRefs = array()
  !allRefs.appendarray(!existingRefs)
  !allRefs.appendarray(!extraRefs)

-- Generate the display data using the complete list of DBREFs
  !rowdata = !this.GenerateDisplayData(!allRefs)

-- Update the displayed data
  !this.UpdateDisplayedList(!rowdata)

  return
endmethod
-- End of method ReplaceWithOwner()


------------------------------------------------------------------------
-- Method:      ReplaceWithMembers
--
-- Description: Replace the selected entry with all of its members
--              NOTE: Only works for single selection at present
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ReplaceWithMembers()

  !GridData = !this.ngcSelected.GetRows()

-- Generate a list of DBREFs to be added and remove selected existing entries
  !extraRefs = array()
  do !loop values !this.ngcSelected.GetSelectedRowTags()
    !chosenRef = object DBREF(!this.ngcSelected.GetRow($!loop)[2])
    if ( !chosenRef.members.set() ) then
      !extraRefs.appendarray(!chosenRef.members)
      !GridData[$!loop].delete()
    else
      !!alert.warning(!chosenref.type + ' ' + !chosenref.name + ' has no members')
    endif
  enddo

-- Final tidy up and reindexing
  !GridData.Unique()

-- Generate a list of DBREFs for all existing entries that are left over
  !existingRefs = array()
  do !idx index !GridData
    !chosenRef = object DBREF(!GridData[$!idx][2])
    !existingRefs.append(!chosenRef)
  enddo
  !allRefs = array()
  !allRefs.appendarray(!existingRefs)
  !allRefs.appendarray(!extraRefs)

-- Generate the display data using the complete list of DBREFs
  !rowdata = !this.GenerateDisplayData(!allRefs)

-- Update the displayed data
  !this.UpdateDisplayedList(!rowdata)

  return

endmethod
-- End of method ReplaceWithMembers()


------------------------------------------------------------------------
