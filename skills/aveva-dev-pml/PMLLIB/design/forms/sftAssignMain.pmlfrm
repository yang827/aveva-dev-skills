-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ChangeAlternateFromList()
--
---- Make sure the form exists
  loadform !!sftAssignList
--
---- Pass control to other form
  show !!sftAssignList
--
endmethod
-- End of method ChangeAlternateFromList()


------------------------------------------------------------------------
-- Method:      ChangeAlternateFromSYSPEC
--
-- Description: Allow the user to select alternate values for the selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ChangeAlternateFromSYSPEC()

-- Currently restricted to single CATA or SECT - needs to handle multiples!
   do !rowTag values !this.ngcSelected.GetSelectedRowTags()

      -- New method on Grid Control : GetRow(STRING)
      !row = !this.ngcSelected.GetRow( !rowTag )

      if (!row[4].unset()) then
          !error = 'Selected item ' + !row[2] + ' does not have SPEC'
					!!alert.error(!error)
          skip
      endif

      -- Figure out the suggested Surface Treatment value if possible
      !itemSPEC = !row[4].dbref()
      !matchSpec = !this.SurfaceTreat.GetMatchingSpec(!itemSPEC)

      if (!matchSpec.unset()) then
			   -- does not matching SYSPEC
         skip
      endif

      -- New method on Grid Control : SetCellValue(rowTag,colTag,STRING))
      !this.ngcSelected.SetCellValue(!rowTag, 'PATREF', !matchSpec.name)
      if (!matchSpec.stinrf.set()) then
          !this.ngcSelected.SetCellValue(!rowTag, 'STINRF', !matchSpec.stinrf.name)
          !this.txtInside.val = !matchSpec.stinrf.name
      else
          !this.ngcSelected.SetCellValue(!rowTag, 'STINRF', '')
          !this.txtInside.val = ''
      endif
      !this.ngcSelected.SetCellValue(!rowTag, 'STINCD', !matchSpec.stincd)
      !this.txtInsideSCD.val = !matchSpec.stincd

      !this.ngcSelected.SetCellValue(!rowTag, 'PUINCD', '')
      !this.txtInsidePCD.val = ''

      if (!matchSpec.stourf.set()) then
          !this.ngcSelected.SetCellValue(!rowTag, 'STOURF', !matchSpec.stourf.name)
          !this.txtOutside.val = !matchSpec.stourf.name
      else
          !this.ngcSelected.SetCellValue(!rowTag, 'STOURF', '')
          !this.txtOutside.val = ''
      endif
      !this.ngcSelected.SetCellValue(!rowTag, 'STOUCD', !matchSpec.stoucd)
      !this.txtOutsideSCD.val = !matchSpec.stoucd

      !this.ngcSelected.SetCellValue(!rowTag, 'PUOUCD', '')
      !this.txtOutsidePCD.val = ''
   enddo

endmethod
-- End of method ChangeAlternateFromSYSPEC()

