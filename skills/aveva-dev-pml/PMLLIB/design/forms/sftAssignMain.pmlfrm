--  Description:     Main form used in Design for Surface Treatment
--                   Used for selection of elements and setting of attributes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  AddToView()                      -                   Display the selected item
--  Apply()                          -                   Take user selections and update the model
--  ApplyCellChanges(ARRAY)          -                   Check the changes made to editable cell and save if permitted
--  ChangeAlternateFromFASPEC()      -                   Allow the user to select alternate values for the selected entry
--  ChangeAlternateFromITSPEC()      -                   Allow the user to select alternate values for the selected entry
--  ChangeAlternateFromList()        -                   Allow the user to select alternate values for the selected entry
--  ChangeAlternateFromSYSPEC()      -                   Allow the user to select alternate values for the selected entry
--  ClearGadget()                    -                   Clear to gadget data
--  ClearGridCode()                  -                   Clear to the INSIDE and OUTSIDE Punch and Paint symbol code in Grid control
--  ClickCallBack(DBREF)             -                   EDG Click Action callback
--  CloseCallBack()                  -                   EDG Close Action callback
--  DisplayCodeData(ARRAY)           -                   Display code data o text box
--  GenerateDisplayData(ARRAY)       ARRAY               Generate the data array for the DTEXT to be displayed
--  Initialise()                     -                   Initialise form settings each time it is shown
--  PickElements()                   -                   Graphically pick elements for inclusion on the form
--  PopupHandler(ARRAY)              -                   Handle selection from Popup menu
--  PrintList()                      -                   Print the data grid contents
--  RemoveFromList()                 -                   Remove selected items from the displayed list
--  ReplaceWithMembers()             -                   Replace the selected entry with all of its members
--  ReplaceWithOwner()               -                   Replace the selected entry with the owning item
--  SaveToXLS()                      -                   Export the data grid contents to Excel file
--  ScopeChoice()                    -                   Deal with selection of scope choice radio buttons
--  ScopeSelection(STRING)           -                   Populate the data grid by choosing a method based on user settings on the form
--  SetAttribute(DBREF,ARRAY)        -                   Update the attribute for selected element
--  ShowtoGridControl(ARRAY)         -                   Display selected item data to Grid control
--  UpdateDisplayedList(ARRAY)       -                   Update the displayed data with the supplied array
--  UpdateGridCode()                 -                   Update the INSIDE and OUTSIDE Punch code for the selected entry to the value provided
--  UpdateInsideCode(STRING,STRING,STRING) -                   Update the INSIDE code for the selected entry to the value provided
--  UpdateOutsideCode(STRING,STRING,STRING) -                   Update the OUTSIDE code for the selected entry to the value provided
--  sftAssignMain()                  -
--
------------------------------------------------------------------------
-- Form:      sftAssignMain
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle (1000,0)
endhandle

import 'GridControl'
handle (1000,0)
endhandle

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

--- form definition
setup form !!sftAssignMain dialog docking size 60 26

-- Define titles and initialisation call
  !this.formTitle = 'Surface Treatment - Assignment'
  !this.iconTitle = 'Surface Treatment'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path right
  vdist 0.5

-- Framing for scope selection
  frame .frmScope           'Scope definition' at xmin form              width 58
    rtoggle   .currelem                   'CE' at xmin.frmScope + 2      tagwidth 2
    rtoggle   .idelem                     'ID' at xmax.currelem + 1      tagwidth 2
    rtoggle   .uselist                  'LIST' at xmax.idelem + 1        tagwidth 2
    option    .listlist                        at xmax.uselist + 1       width 30
    button    .btnPick          'Select Items' at xmax.listlist + 1.5    CALLBACK |!this.ScopeSelection('SELECT')|
    button    .btnAdd           '  Add Items ' at xmax.btnPick + 1       CALLBACK |!this.ScopeSelection('ADD')|
  exit
  path down

-- Framing for gadget showing all elements selected
  frame .frmSelected       'Selected elements' at xmin form              width 85 height 18
    container .conSelected PMLNetCONTROL 'NET' at xmin                   dock fill
  exit

  frame .frmFollData                           at xmin form              ymax  width 58 height 4
    para      .parInsideTcd                    at xmin.frmFollData + 1.8 ymin.frmFollData + 1 text ' In Surface'
    text      .txtInside                       at xmax.parInsideTcd -3.8 ymin.frmFollData + 1 width 20 is STRING
    para      .parInsideScd                    at xmax.txtInside + 1     ymin.frmFollData + 1 text 'SCode'
    text      .txtInsideScd                    at xmax.parInsideScd      ymin.frmFollData + 1 width 5 is STRING
    para      .parInsidePcd                    at xmax.txtInsideScd + 1  ymin.frmFollData + 1 text 'PCode'
    text      .txtInsidePcd                    at xmax.parInsidePcd      ymin.frmFollData + 1 width 5 is STRING
    button    .btnUpdateCD       'Update Code' at xmax.txtInsidePcd + 2  ymin.frmFollData + 1 width 11            CALLBACK '!this.UpdateGridCode()'
    para      .parOutsideTcd                   at xmin.frmFollData + 1   ymin.txtInside + 1.5 text 'Out Surface'
    text      .txtOutside                      at xmax.parOutsideTcd - 3 ymin.txtInside + 1.5 width 20 is STRING
    para      .parOutsideScd                   at xmax.txtOutside + 1    ymin.txtInside + 1.5 text 'SCode'
    text      .txtOutsideScd                   at xmax.parOutsideScd     ymin.txtInside + 1.5 width 5 is STRING
    para      .parOutsidePcd                   at xmax.txtOutsideScd + 1 ymin.txtInside + 1.5 text 'PCode'
    text      .txtOutsidePcd                   at xmax.parOutsidePcd     ymin.txtInside + 1.5 width 5 is STRING
    button    .btnClearCD         'Clear Code' at xmax.txtOutsidePcd + 2 ymin.txtInside + 1.5 width 11            CALLBACK '!this.ClearGridCode()'

  exit
  frame .frmButton                             at xmax.frmFollData + 1 ymin                 width 15 height 4
     button   .btnAPPLY                'Apply' at xmin.frmButton + 1.5   ymin.frmButton + 1   width 11            CALLBACK '!this.Apply()'
     button   .btnCANCEL             'Dismiss' at xmin.frmButton + 1.5   ymin.btnApply + 1.5  width 11            CANCEL
  exit
-- define PML popup menu
  menu .mnuPopup popup
  !this.mnuPopup.add( 'CALLBACK', 'Add to 3D view','!this.AddToView()' )
  !this.mnuPopup.add( 'SEPARATOR' )
  !this.mnuPopup.add( 'CALLBACK', 'Change codes from Surface Treatment','!this.ChangeAlternateFromLIST()' )
  !this.mnuPopup.add( 'CALLBACK', 'Change codes from System Spec','!this.ChangeAlternateFromSYSPEC()' )
  !this.mnuPopup.add( 'CALLBACK', 'Change codes from Face Spec','!this.ChangeAlternateFromFASPEC()' )
  !this.mnuPopup.add( 'CALLBACK', 'Change codes from Item Spec','!this.ChangeAlternateFromITSPEC()' )
  !this.mnuPopup.add( 'SEPARATOR' )
  !this.mnuPopup.add( 'CALLBACK', 'Replace with owner','!this.replaceWithOwner()' )
  !this.mnuPopup.add( 'CALLBACK', 'Replace with members','!this.replaceWithMembers()' )
  !this.mnuPopup.add( 'CALLBACK', 'Remove from list','!this.RemoveFromList()')
  !this.mnuPopup.add( 'SEPARATOR' )
  !this.mnuPopup.add( 'CALLBACK', 'Print Grid','!this.PrintList()' )
  !this.mnuPopup.add( 'CALLBACK', 'Grid to Excel file','!this.SaveToXLS()' )

-- End of FORM definition

  member .ngcSelected   is  NETGRIDCONTROL
  member .Headings      is ARRAY

  member .refInside     is DBREF
  member .refOutside    is DBREF

  member .Debug         is BOOLEAN

  member .edgSelected   is ARRAY
  member .jobStatus     is STRING

-- Define collection data from PARAGON with PURPOSE filter
  member .SurfaceTreat      is  SFTGETTING
exit

------------------------------------------------------------------------
-- Method:      sftAssignMain
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftAssignMain()

  !this.Headings.append('TYPE')
  !this.Headings.append('NAME')
  !this.Headings.append('PATREF')
  !this.Headings.append('PSPEC')
  !this.Headings.append('STINRF')
  !this.Headings.append('STINCD')
  !this.Headings.append('PUINCD')
  !this.Headings.append('STOURF')
  !this.Headings.append('STOUCD')
  !this.Headings.append('PUOUCD')

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for selected elements
  !this.ngcSelected = object NetGridControl()
  !this.conSelected.control = !this.ngcSelected.handle()

  !this.ngcSelected.addeventhandler('OnPopup', !this, 'PopupHandler')
  !this.ngcSelected.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcSelected.addeventhandler('AfterSelectChange', !this, 'DisplayCodeData')
  !this.conSelected.popup = !this.mnuPopup

-- callback for radio toggles (ID/CE/LIST)
  !this.frmScope.callback = '!this.scopechoice()'

  !this.frmscope.val = 1
  !this.listlist.active = FALSE

endmethod
-- End of method sftAssignMain()


------------------------------------------------------------------------
-- Method:      Initialise
--
-- Description: Initialise form settings each time it is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Initialise()

  !this.debug = FALSE
  if (defined(!!DEBUG) ) then
    !this.debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSelected.columnExcelFilter(!f)
  !this.ngcSelected.outlookGroupStyle(!f)
  !this.ngcSelected.fixedHeaders(!f)
  !this.ngcSelected.fixedRows(!t)
  !this.ngcSelected.editableGrid(!t)
  !this.ngcSelected.singlerowselection(!f)
  !this.ngcSelected.HeaderSort(!t)
  !this.ngcSelected.setalternaterowcolor('lightgray')

-- Remove any previous selection
  !this.ngcSelected.clearrowselection()

-- Read the standard Design LIST facility for existing LISTs to be included
  !this.listlist.active = !f
  !this.listlist.clear()
  if (defined(!!CDLIST) ) then
    do !listing index !!CDLIST
      !this.listlist.add(!!CDLIST[$!listing], !listing.string())
    enddo
  endif
  !this.uselist.active = !t
  if (!this.listlist.dtext.size().eq(0) ) then
    !this.uselist.active = !f
  endif

  !this.txtInside.Editable = !f
  !this.txtOutside.Editable = !f

endmethod
-- End of method Initialise()


------------------------------------------------------------------------
--
-- Method:      .ScopeChoice()
--
-- Description: Deal with selection of scope choice radio buttons
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ScopeChoice()

  if (!this.Debug) then
    $P Running sftAssignMain.ScopeChoice()
  endif

  if ( !this.frmScope.val.eq(1) ) then
    !this.listlist.active = FALSE
  elseif ( !this.frmScope.val.eq(2) ) then
    !this.listlist.active = FALSE
  elseif ( !this.frmScope.val.eq(3) ) then
    !this.listlist.active = TRUE
    !this.listlist.clear()
    do !listing index !!CDLIST
      !this.listlist.add(!!CDLIST[$!listing], !listing.string())
    enddo
    !this.listlist.val = 1
  endif

  return
endmethod
-- End of method definition for .ScopeChoice()


------------------------------------------------------------------------
-- Method:      ScopeSelection
--
-- Description: Populate the data grid by choosing a method based on user settings on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ScopeSelection(!jobStatus is STRING)

-- Confirmation before continuing at WORL or SITE level
   if ( !this.frmScope.val.eq(1) AND (!!CE.type.eq('WORL') OR !!CE.type.eq('SITE') ) ) then
      !answ = !!alert.confirm('Collecting data for ' + !!CE.type + ' level may take some time. Do you want to continue?')
      if (NOT !answ.boolean() ) then
        return
      endif
   endif

   !selected = ARRAY()
   !this.jobStatus = !jobStatus

-- Option chosen: CE
   if (!this.frmScope.val.eq(1) ) then
      !selected.append(!!CE)
      !this.ShowtoGridControl(!selected)

-- Option chosen: ID
   elseif (!this.frmScope.val.eq(2) ) then
       !this.PickElements()

-- Option chosen: LIST
   elseif (!this.frmScope.val.eq(3) ) then
     !listopt = !this.listlist.val
     if ( defined(!!CDlist$!listopt) ) then
       -- For each item in the list...
       do !list value !!CDlist$!listopt
           !selected.append(!list.dbref())
       enddo
     endif
     !this.ShowtoGridControl(!selected)
   endif

endmethod
-- End of method definition for .ScopeSelection()

