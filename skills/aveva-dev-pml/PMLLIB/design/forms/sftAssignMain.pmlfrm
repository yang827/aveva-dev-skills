------------------------------------------------------------------------
-- Method:      UpdateInsideCode
--
-- Description: Update the INSIDE code for the selected entry to the value provided
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateInsideCode(!code is STRING, !refno is STRING, !frefno is STRING)

  !this.txtInsideSCD.val = ''
  !this.txtInside.val = ''

  do !idx values !this.ngcSelected.GetSelectedRowTags()
-- Update the relevant grid cell with the new value
    !this.ngcSelected.SetCellValue(!idx, 'PATREF', !frefno)
    !this.ngcSelected.SetCellValue(!idx, 'STINRF', !refno)
    !this.ngcSelected.SetCellValue(!idx, 'STINCD', !code)
    !this.ngcSelected.SetCellValue(!idx, 'PUINCD', '')
    !this.ngcSelected.SetCellValue(!idx, 'PUOUCD', '')
  enddo

  !this.txtInside.val = !refno
  !this.txtInsideSCD.val = !code
  !this.txtInsidePCD.val = ''
  --!this.txtOutsidePCD.val = ''

endmethod
-- End of method UpdateInsideCode()

------------------------------------------------------------------------
-- Method:      UpdateOutsideCode
--
-- Description: Update the OUTSIDE code for the selected entry to the value provided
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateOutsideCode(!code is STRING, !refno is STRING, !frefno is STRING)

  !this.txtOutsideSCD.val = ''
  !this.txtOutside.val = ''

  do !idx values !this.ngcSelected.GetSelectedRowTags()
-- Update the relevant grid cell with the new value
    !this.ngcSelected.SetCellValue(!idx, 'PATREF', !frefno)
    !this.ngcSelected.SetCellValue(!idx, 'STOURF', !refno)
    !this.ngcSelected.SetCellValue(!idx, 'STOUCD', !code)
    !this.ngcSelected.SetCellValue(!idx, 'PUINCD', '')
    !this.ngcSelected.SetCellValue(!idx, 'PUOUCD', '')
  enddo
  !this.txtOutside.val = !refno
  !this.txtOutsideSCD.val = !code
  --!this.txtInsidePCD.val = ''
  !this.txtOutsidePCD.val = ''

endmethod
-- End of method UpdateOutsideCode()

------------------------------------------------------------------------
-- Method:      UpdateGridCode
--
-- Description: Update the INSIDE and OUTSIDE Punch code for the selected entry to the value provided
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateGridCode()

  !SelectedRowTags = !this.ngcSelected.GetSelectedRowTags()
  if (!SelectedRowTags.unset() ) then
    !!alert.error('No grid item selected')
    return
  endif

  !insideSymbolCode = !this.txtInsideSCD.val.trim()
  !insidePunchCode = !this.txtInsidePCD.val.trim()
  !outsideSymbolCode = !this.txtOutsideSCD.val.trim()
  !outsidePunchCode = !this.txtOutsidePCD.val.trim()

  do !idx values !SelectedRowTags
     -- Update the relevant grid cell with the new value
     !this.ngcSelected.SetCellValue(!idx, 'STINCD', !insideSymbolCode)
     !this.ngcSelected.SetCellValue(!idx, 'PUINCD', !insidePunchCode)
     !this.ngcSelected.SetCellValue(!idx, 'STOUCD', !outsideSymbolCode)
     !this.ngcSelected.SetCellValue(!idx, 'PUOUCD', !outsidePunchCode)
  enddo
  !this.ClearGadget()

endmethod
-- End of method UpdateGridCode()


------------------------------------------------------------------------
-- Method:      ClearGridCode
--
-- Description: Clear to the INSIDE and OUTSIDE Punch and Paint symbol code in Grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ClearGridCode()

  !SelectedRowTags = !this.ngcSelected.GetSelectedRowTags()

  if (!SelectedRowTags.unset() ) then
    !!alert.error('No grid item selected')
    return
  endif

  do !idx values !SelectedRowTags
     !this.ngcSelected.SetCellValue(!idx, 'STINCD', '')
     !this.ngcSelected.SetCellValue(!idx, 'PUINCD', '')
     !this.ngcSelected.SetCellValue(!idx, 'STOUCD', '')
     !this.ngcSelected.SetCellValue(!idx, 'PUOUCD', '')
  enddo

  !this.txtInsideSCD.val = ''
  !this.txtInsidePCD.val = ''
  !this.txtOutsideSCD.val = ''
  !this.txtOutsidePCD.val = ''

endmethod
-- End of method ClearGridCode()

------------------------------------------------------------------------
-- Method:      GenerateDisplayData
--
-- Description: Generate the data array for the DTEXT to be displayed
--              using the supplied array of DBREF items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateDisplayData(!arrSelected is ARRAY) is ARRAY

  if (!this.Debug) then
    $P Running sft.GenerateDisplayData
  endif

-- Make sure the scope has no duplicates
  !scope = !arrSelected.SortUnique()

-- Remove any items where an owning item above it is listed
  !checklist = !scope
  !finallist = !scope
-- Loop around all elements passed
  do !idx index !scope
    !owners = !scope[$!idx].OWNLST
-- Check the list of owners against each of the elements passed (except current one!)
    do !loop index !checklist
      if ( !idx.neq(!loop) AND !owners.FindFirst(!checklist[$!loop]).set() ) then
        !finallist[$!idx].delete()
      endif
    enddo
  enddo

  !arrReturn = object ARRAY()

-- Generate array of Row Data for display in the grid
  do !item values !finallist

     if (!item.Attributes().findfirst('Patreference').unset()) then
         !error = 'Selected item(' + !item.name + ') does not exist PATREF Attribute'
         !!alert.Error(!error)
 				 skip
     endif

     !rowdata = ARRAY()

     !rowdata[1] = !item.type
     !rowdata[2] = !item.name

     if (!item.Patref.unset()) then
         !rowdata[3] = ''
     else
         !rowdata[3] = !item.Patref.name
     endif

-- Figure out the suggested Surface Treatment value if possible
     !itemSPRE = !item.SPREF
     handle none
       if (!itemSPRE.set() ) then
         !safeCE = !!CE
         $!item.SPREF
         SPEC
         !rowdata[4] = !!CE.name
         !!CE = !safeCE
       endif
     elsehandle (2,201)
       !itemSPRE = !item.PSPEC
       handle none
          !rowdata[4] = !itemSPRE.name
       elsehandle (2,201)
          !rowdata[4] = ''
       endhandle
     endhandle

     if (!item.stinrf.unset()) then
         !rowdata[5] = ''
     else
         !rowdata[5] = !item.stinrf.name
     endif

     !rowdata[6] = !item.stincd
     !rowdata[7] = !item.puincd

     if (!item.stourf.unset()) then
         !rowdata[8] = ''
     else
         !rowdata[8] = !item.stourf.name
     endif

     !rowdata[9] = !item.stoucd
     !rowdata[10] = !item.puoucd

     !arrReturn.append(!rowdata)
  enddo

  return !arrReturn

endmethod
-- End of method GenerateDisplayData()


------------------------------------------------------------------------
-- Method:      UpdateDisplayedList
--
-- Description: Update the displayed data with the supplied array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateDisplayedList(!arrData is ARRAY)

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Bind example data to grid
  !nds = object NETDATASOURCE('Selected elements', !this.Headings, !arrData)
  !this.ngcSelected.bindToDataSource(!nds)

  !this.ngcSelected.SetEditableColumn(1, FALSE)
  !this.ngcSelected.SetEditableColumn(2, FALSE)
  !this.ngcSelected.SetEditableColumn(3, FALSE)
  !this.ngcSelected.SetEditableColumn(4, FALSE)
  !this.ngcSelected.SetEditableColumn(5, FALSE)
  !this.ngcSelected.SetEditableColumn(8, FALSE)

endmethod
-- End of method UpdateDisplayedList()

------------------------------------------------------------------------
--
-- Method:      PopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .PopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data[2].set() ) then
    !this.conSelected.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .PopupHandler()


------------------------------------------------------------------------
--
-- Method:      Apply()
--
-- Description: Take user selections and update the model
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Apply()

  !selected = !this.ngcSelected.GetSelectedRowTags()
  if (!selected.unset() ) then
     !!alert.error('No grid item selected')
     return
  endif

  !!alert.warning('Process selected rows and set attributes accordingly')
  do !row values !this.ngcSelected.GetSelectedRows()

     -- Update grid data to attribute of Branch elements
     !selectedElement = object DBREF()
     !selectedElement = !row[2].dbref()
     if (NOT !selectedElement.DBWRITE ) then
        !error = 'No WRITE access to ' + !selectedElement + ' Element'
        !!alert.error(!error)
        return
     endif

     !this.SetAttribute(!selectedElement,!row)

  enddo

-- Possibly retain all unset entries in the grid so the user can continue if needed?
  !this.RemoveFromList()
  !this.clearGadget()
endmethod
-- End of method definition for .Apply()

------------------------------------------------------------------------
--
-- Method:      SetAttribute
--
-- Description: Update the attribute for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- value      R     STRING    new status
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .SetAttribute(!element is DBREF,!gData is ARRAY)

  if (!this.Debug) then
    $P Running sftAssignMain.SetAttribute(DBREF)
  endif

  !safeCE = !!CE

-- Set new values in database
  $!element

  if (!gData[3] eq '') then
      PATREF unset
  else
      PATREF $!gData[3]
  endif

  if (!gData[5] eq '') then
      STINRF unset
  else
      STINRF $!gData[5]
  endif

  !element.STINCD = !gData[6]
  !element.PUINCD = !gData[7]

  if (!gData[8] eq '') then
      STOURF unset
  else
      STOURF $!gData[8]
  endif

  !element.STOUCD = !gData[9]
  !element.PUOUCD = !gData[10]

  !!CE = !safeCE

endmethod
-- End of method definition for .SetAttribute()

------------------------------------------------------------------------
--
-- Method:      .ClearGadget()
--
-- Description: Initialize gadget data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ClearGadget()

   if (!this.Debug) then
      $P Running sftDefineSpec.ClearGadget()
   endif

   !this.txtInside.val = ''
   !this.txtInsideSCD.val = ''
   !this.txtInsidePCD.val = ''
   !this.txtOutside.val = ''
   !this.txtOutsideSCD.val = ''
   !this.txtOutsidePCD.val = ''

endmethod
-- End of method definition for .ClearGadget()

------------------------------------------------------------------------
--
-- Method:      .ApplyCellChanges()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ApplyCellChanges(!data is ARRAY)

  if (!this.Debug) then
    $P Running sftAssignMain.ApplyCellChanges()
  endif

$(  q var !data
<ARRAY>
   [0]  <STRING> 'aaaaa'        (new value)
   [1]  <STRING> '1'            (row tag, sometimes =15353/363, the other 1,2,3)
   [2]  <STRING> 'STINCD'       (column header)
   [3]  <STRING> 'A'            (control flag)

$)

  if (!data[2] eq 'STINCD') then
      !this.txtInsideSCD.setvalue(!data[0],TRUE)
  elseif (!data[2] eq 'PUINCD') then
      !this.txtInsidePCD.setvalue(!data[0],TRUE)
  elseif (!data[2] eq 'STOUCD') then
      !this.txtOutsideSCD.setvalue(!data[0],TRUE)
  elseif (!data[2] eq 'PUOUCD') then
      !this.txtOutsidePCD.setvalue(!data[0],TRUE)
  endif

endmethod
-- End of method definition for .ApplyCellChanges()

------------------------------------------------------------------------
--
-- Method:      DisplayCodeData()
--
-- Description: Display code data o text box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .DisplayCodeData(!data is ARRAY)

  if (!this.Debug) then
    $P Running sftAssignMain.DisplayCodeData()
  endif

  if (!data.size().neq(1) ) then
    $P Incorrect array passed to DisplaySpecData()
    return
  endif

  if (!data.set()) then
      !this.ClearGadget()

      !this.txtInside.val = !this.ngcSelected.GetSelectedRows()[1][5]
      !this.txtInsideSCD.val = !this.ngcSelected.GetSelectedRows()[1][6]
      !this.txtInsidePCD.val = !this.ngcSelected.GetSelectedRows()[1][7]

      !this.txtOutside.val = !this.ngcSelected.GetSelectedRows()[1][8]
      !this.txtOutsideSCD.val = !this.ngcSelected.GetSelectedRows()[1][9]
      !this.txtOutsidePCD.val = !this.ngcSelected.GetSelectedRows()[1][10]

  endif

endmethod
-- End of method definition for .DisplayCodeData()

------------------------------------------------------------------------
--
-- Method:      AddToView()
--
-- Description: Display the selected item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .AddToView()

  if (!this.Debug) then
    $P Running sftAssignMain.AddToView()
  endif

-- If standard view is set then update it otherwise gracefully ignore this
  if ( !!gphviews.views.set() ) then
    AUTOCOLOUR OFF
    UNENHANCE ALL
    --REM ALL
    !itemlist = object ARRAY()
    do !idx index !this.ngcSelected.GetSelectedRowTags()
       !itemlist.append(!this.ngcSelected.GetSelectedRows()[!idx][2].dbref())
-- Update the relevant grid cell with the new value
    enddo

    do !element values !itemlist
       ADD $!element
    enddo
    !!gphviews.limits(!!gphviews.views[1], object volume(!itemlist ) )
    !!gphviews.rotate(!!gphviews.views[1], object volume(!itemlist ) )
  else
    if (!this.Debug) then
      $P Skipped update of graphical view HMmain.UpdateGraphics()
    endif
  endif

  return

endmethod
-- End of method definition for .AddToView()

------------------------------------------------------------------------
--
-- Method:      PrintList()
--
-- Description: Print preview the grid data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .PrintList()

  if (!this.ngcSelected.getNumberRows().neq(0)) then
    !this.ngcSelected.PrintPreview()
  else
    !!alert.Error('No data to print')
  endif

endmethod
-- End of method definition for .PrintList()

------------------------------------------------------------------------
--
-- Method:      .SaveToXLS()
--
-- Description: Save the grid data to Excel file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .SaveToXLS()

  if (!this.ngcSelected.getNumberRows().eq(0)) then
    !!alert.Error('No data to save')
    return
  endif

  using namespace 'AVEVA.PDMS.Presentation'
  !browser = object PMLFILEBROWSER('SAVE')

-- Default to first location from PDMSUSER evar
  !pdmsuser = !!evarSplit('PDMSUSER')
  !directory = !pdmsuser[1]

  !seedFile = 'PaintListData'
  !title = 'Save Paint List As'
  !existFlag = FALSE
  !filter = 'Microsoft Office Excel files (*.xls)|*.xls'
  !filterIndex = 1

-- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

-- Set selected file
  !savefile = object FILE( !Browser.File() )

  if ( !savefile.set() ) then
    !this.ngcSelected.saveGridToExcel(!savefile.string())
    handle (1000,0)
      !!alert.error('Could not write file: ' + !Savefile.String() + ' - ' + !!error.text )
    elsehandle none
      !!Alert.Message('File saved: ' + !Savefile.String() )
    endhandle
  endif

endmethod
-- End of method definition for .SaveToXLS()
