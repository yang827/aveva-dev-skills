--   Module:        Paragon
--   Replaces:
--
-- Author:          Sun You
-- Created:         <day> <date> <time> <year>
--
--
--  Description:     Selection of paint and definition of coating information
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ApplyCellChanges(ARRAY)          -                   Check the changes made to editable cell and save if permitted
--  ClearForm()                      -
--  CreatePaintSpec()                -                   Create paint spec data to design database
--  DeletePaintSpec()                -                   Delete paint spec data to design database
--  DisplaySpecData(ARRAY)           -                   Display spec data o text box
--  GenerateDisplayData(STRING)      ARRAY               Generate array of column data to be displayed for the retrieved data
--  GenerateFaceList()               -                   Show Face code data to combo box from catalogue database
--  GenerateItemList()               -                   Show Item Code data to combo box from catalogue database
--  GenerateSpecList()               -                   Show spec data to combo box from catalogue database
--  GenerateSurfTreatList()          -                   Show example data to demonstrate form controls
--  Initialise()                     -                   Initialise the form each time it is displayed
--  RefreshSpec()                    -                   Retrieve spec and surface treatment data from catalogue database
--  RetrieveSpec()                   -                   Show example data to demonstrate form controls
--  ToggleSelected(GADGET,STRING)    -                   When selected the toggle gadget, update the popup menu
--  UpdateSpec()                     -
--  putBoth()                        -                   put into Inside/Outside Treatment Code from Surface Treatment Combo Box
--  putInside()                      -                   put into Inside Treatment Code from Surface Treatment Combo Box
--  putOutside()                     -                   put into Outside Treatment Code from Surface Treatment Combo Box
--  sftDefineSpec()                  -                   Constructor
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.Pdms.Presentation'
	
------------------------------------------------------------------------
-- Form:      sftDefineSystemSpec
------------------------------------------------------------------------

--setup form !!sftDefineCoatings dialog  size 55 12
--setup form !!sftDefineCoatings dialog
setup form !!sftDefineSpec dialog docking size 58 26

-- Define titles and initialisation call
  !this.formTitle = 'Paint Spec Definition'
  !this.iconTitle = 'Paint Spec Definition'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path right
  vdist 0.5

  frame .frmAddSpec 'Add new paint Spec' at 0 0  width 35 height 2
    para      .paraName       at xmin.frmAddSpec + 1     ymin.frmAddSpec + 1     text          ' Name'
    text      .txtName        at xmax.paraName + 1       ymin.frmAddSpec + 1     width 37 is STRING
    COMBObox  .comboGadget    at xmin.paraName           ymax.paraName + 0.5         tagwid 6      '   Spec' scroll 50   width 37     tooltip 'specification list'
    button    .btnSpec        at xmax.comboGadget + 1.5                                        'Refresh'                        CALLBACK '!this.RefreshSpec()'

    rtoggle   .follspec       at xmin.frmAddSpec + 8     ymin.comboGadget + 1    tagwidth 10   'Following SPEC'            CALLBACK '!this.ToggleSelected('
    rtoggle   .follface       at xmax.follspec + 2       ymin.comboGadget + 1    tagwidth 10   'Following FACE'            CALLBACK '!this.ToggleSelected('
    rtoggle   .follitem       at xmax.follface + 2       ymin.comboGadget + 1    tagwidth 10   'Following ITEM'            CALLBACK '!this.ToggleSelected('

    COMBObox  .comboSft       at xmin.frmAddSpec + 1     ymin.follspec + 1.5     tagwid 6      'Surface'             width 20.5
    button    .btnInside      at xmax.comboSft + 1       ymin.follspec + 1.5                   'Inside'                          CALLBACK '!this.putInside()'
    button    .btnOutside     at xmax.btnInside + 1      ymin.follspec + 1.5                   'Outside'                         CALLBACK '!this.putOutside()'
    button    .btnBoth        at xmax.btnOutside + 1     ymin.follspec + 1.5                   'Both'                            CALLBACK '!this.putBoth()'
    para      .parInsideTcd   at xmin.frmAddSpec + 1     ymin.comboSft + 1.5     text          ' Inside Treatments Ref'
    text      .txtInside      at xmax.parInsideTcd - 6   ymin.comboSft + 1.5     width 22 is STRING
    para      .parInsideScd   at xmax.txtInside + 1      ymin.comboSft + 1.5     text          'Symbol Code'
    text      .txtInCode      at xmax.parInsideScd - 2   ymin.comboSft + 1.5     width 5 is STRING
    para      .parOutsideTcd  at xmin.frmAddSpec + 1     ymin.txtInside + 1.5    text          'Outside Treatments Ref'
    text      .txtOutside     at xmax.parOutsideTcd - 6  ymin.txtInside + 1.5    width 22 is STRING
    para      .parOutsideScd  at xmax.txtOutside + 1     ymin.txtInside + 1.5    text          'Symbol Code'
    text      .txtOutCode     at xmax.parOutsideScd - 2  ymin.txtInside + 1.5    width 5 is STRING
  exit

  frame .frmEvent ''  at xmin.frmAddSpec  ymax.frmAddSpec width 37 height 2
    button    .btnCreate    '  Crate '         at xmin.frmEvent + 1.6 ymin.frmEvent + 0.7  CALLBACK '!this.CreatePaintSpec()'
    button    .btnUpdate    ' Update '         at xmax.btnCreate + 1.6                     CALLBACK '!this.UpdateSpec()'
    button    .btnDelete    ' Delete '         at xmax.btnUpdate + 1.6                     CALLBACK '!this.DeletePaintSpec()'
    button    .btnRetrieve  'Retrieve'         at xmax.btnDelete + 1.6                     CALLBACK '!this.RetrieveSpec()'
    button    .btnDismiss   'Dismiss '         at xmax.btnRetrieve + 1.6                   CANCEL
  exit

  frame .frmSpecList  '' at xmin.frmAddSpec   ymax + 0.3  width 60 height 13
    container .conSpecGrid PMLNetCONTROL 'NET'   at xmin + 0.2  ymin + 0.5 dock fill
  exit

  path down

-- End of FORM definition

-- Define member variables
   member .ngcSpecList is  NETGRIDCONTROL

   member .SpecHeadings     is  ARRAY

   member .SelectedSpec     is  DBREF
   member .Debug             is  BOOLEAN
exit


------------------------------------------------------------------------
--
-- Method:      sftDefineSpec
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftDefineSpec()

-- Control of additional debugging messages during processing
  !this.Debug = FALSE
  if (defined(!!DEBUG) ) then
    !this.Debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for list of ALL COATINGS
  !this.ngcSpecList = object NetGridControl()
  !this.conSpecGrid.control = !this.ngcSpecList.handle()

-- add PML event handlers to .Net control
--  !this.ngcSpecList.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcSpecList.addeventhandler('AfterSelectChange', !this, 'DisplaySpecData')

endmethod
-- End of method definition for .sftDefineSpec()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .Initialise()

  if (!this.Debug) then
    $P Running sftDefineCoatings.Initialise()
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Setup the display grid headings
  !this.SpecHeadings[1] = 'NAME'
  !this.SpecHeadings[2] = 'PASPEC'
  !this.SpecHeadings[3] = 'STINRF'
  !this.SpecHeadings[4] = 'STINCD'
  !this.SpecHeadings[5] = 'STOURF'
  !this.SpecHeadings[6] = 'STOUCD'

  !t = true
  !f = false

-- Basic settings for PAINT grid
  !this.ngcSpecList.columnExcelFilter(!f)
  !this.ngcSpecList.outlookGroupStyle(!f)
  !this.ngcSpecList.fixedHeaders(!f)
  !this.ngcSpecList.fixedRows(!t)
  !this.ngcSpecList.editableGrid(!f)
  !this.ngcSpecList.singlerowselection(!t)
  !this.ngcSpecList.setalternaterowcolor('lightgray')


--  !this.txtSelectedPaint.SetEditable(FALSE)
  !this.frmAddSpec.val = 1
  !this.comboGadget.visible = TRUE
  !this.txtInside.editable = FALSE
  !this.txtOutside.editable = FALSE

  !this.RefreshSpec()
  !this.RetrieveSpec()

endmethod
-- End of method definition for .Initialise()


------------------------------------------------------------------------
--
-- Method:      GenerateSpecList()
--
-- Description: Show spec data to combo box from catalogue database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateSpecList()

  if (!this.Debug) then
    $P Running sftDefineSpec.GenerateSpecList()
  endif

   !this.comboGadget.clear()

   var !speclist collect all spec with purp eq 'PIPE' or purp eq 'HVAC' or purp eq 'STL'

   if (!speclist.unset() OR !speclist.size().eq(0) ) then
     !!alert.warning('Can not found SPEC(PURP=PIPE or HVAC or STL) on CATA Database')
   endif

    !this.comboGadget.clear()
    do !idx index !speclist
      !this.comboGadget.add(!speclist[$!idx].dbref().name)
    enddo


endmethod
-- End of method definition for .GenerateSpecList()

------------------------------------------------------------------------
--
-- Method:      GenerateFaceList()
--
-- Description: Show Face code data to combo box from catalogue database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateFaceList()

  if (!this.Debug) then
    $P Running sftDefineSpec.GenerateFaceList()
  endif

   !this.comboGadget.clear()

   var !faceowners collect all CATE with purp eq 'FACE'
   if (!faceowners.size().eq(0) ) then
      var !faceowners collect all SECT with PURP eq 'FACE'
   endif

   if (!faceowners.unset() ) then
      !!alert.error('Unable to locate owning SECT or CATE element (PURP=FACE)')
     return
   endif

  do !faceowner values !faceowners
--Currently restricted to single CATA or SECT - needs to handle multiples!
        !scope = !faceowner.dbref()
        var !allface collect all FACECO for $!scope
        handle any
--       Temporary handle in case SRFTRT element not in this version of PDMS
          !!alert.error(!!ERROR.TEXT)
          return
        endhandle
        !this.comboGadget.clear()
        do !idx index !allface
          !this.comboGadget.add(!allface[$!idx].dbref().name)
        enddo

  enddo

endmethod
-- End of method definition for .GenerateFaceList()


------------------------------------------------------------------------
--
-- Method:      GenerateItemList()
--
-- Description: Show Item Code data to combo box from catalogue database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateItemList()

   if (!this.Debug) then
    $P Running sftDefineSpec.GenerateItemList()
  endif

endmethod
-- End of method definition for .GenerateItemList()


------------------------------------------------------------------------
--
-- Method:      GenerateSurfTreatList()
--
-- Description: Show example data to demonstrate form controls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateSurfTreatList()

  if (!this.Debug) then
    $P Running sftDefineMain.GenerateSurfTreatList()
  endif

  !this.comboSft.clear()

  var !srftrtowners collect all CATE with PURP eq 'SURF'
  if (!srftrtowners.size().eq(0) ) then
    var !srftrtowners collect all SECT with PURP eq 'SURF'
  endif
  if (!srftrtowners.unset() ) then
    !!alert.error('Unable to locate owning SECT or CATE element (PURP=SURF)')
    return
  endif

  do !srftrtowner values !srftrtowners
--Currently restricted to single CATA or SECT - needs to handle multiples!
        !scope = !srftrtowner.dbref()
        var !allsrftrt collect all SRFTRT for $!scope
        handle any
--       Temporary handle in case SRFTRT element not in this version of PDMS
          !!alert.error(!!ERROR.TEXT)
          return
        endhandle

        do !idx index !allsrftrt
          !this.comboSft.add(!allsrftrt[$!idx].dbref().name)
        enddo

  enddo

endmethod
-- End of method definition for .GenerateSurfTreatList()


------------------------------------------------------------------------
--
-- Method:      RefreshSpec()
--
-- Description: Retrieve spec and surface treatment data from catalogue database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .RefreshSpec()

  if (!this.Debug) then
    $P Running sftDefineSpec.RefreshSpec()
  endif

-- Retrieve spec or face standard catalogue data to combo gadget
  if (!this.frmAddSpec.val eq 1 ) then
     !this.GenerateSpecList()
  elseif (!this.frmAddSpec.val eq 2 ) then
     !this.GenerateFaceList()
  else
     !this.GenerateItemList()
  endif

-- Retrieve surface treatment catalogue data to combo gadget
  !this.GenerateSurfTreatList()

  !this.ClearForm()

endmethod
-- End of method definition for .RefreshSpec()

------------------------------------------------------------------------
--
-- Method:      putInside()
--
-- Description: put into Inside Treatment Code from Surface Treatment Combo Box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .putInside()

  if (!this.Debug) then
    $P Running sftDefineSpec.putInside()
  endif

  if (!this.comboSft.DisplayText().trim() eq '') then
     !!alert.Error('Surface Reference does not accept null value')
     return
  endif

  !rtnBool = !!exists(!this.comboSft.DisplayText(),'SRFTRT','')
  if (!rtnBool.not()) then
     !!alert.Error('Surface Reference Value does not exist on Surface Treatment')
     return
  endif
  !this.txtInside.val =  !this.comboSft.dtext[!this.comboSft.val]

endmethod
-- End of method definition for .putInside()

------------------------------------------------------------------------
--
-- Method:      putOutside()
--
-- Description: put into Outside Treatment Code from Surface Treatment Combo Box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .putOutside()

  if (!this.Debug) then
    $P Running sftDefineSpec.putOutside()
  endif

  if (!this.comboSft.DisplayText().trim() eq '') then
     !!alert.Error('Surface Reference does not accept null value')
     return
  endif

  !rtnBool = !!exists(!this.comboSft.DisplayText(),'SRFTRT','')
  if (!rtnBool.not()) then
     !!alert.Error('Surface Reference Value does not exist on Surface Treatment')
     return
  endif
  !this.txtOutside.val =  !this.comboSft.dtext[!this.comboSft.val]

endmethod
-- End of method definition for .putInside()

------------------------------------------------------------------------
--
-- Method:      putBoth()
--
-- Description: put into Inside/Outside Treatment Code from Surface Treatment Combo Box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .putBoth()

  if (!this.Debug) then
    $P Running sftDefineSpec.putBoth()
  endif

  !this.putInside()
  !this.putOutside()

endmethod
-- End of method definition for .putBoth()

------------------------------------------------------------------------
--
-- Method:      .ToggleSelected()
--
-- Description: When selected the toggle gadget, update the popup menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ToggleSelected(!object is GADGET, !action is STRING)

   if (!this.Debug) then
      $P Running sftDefineSpec.ToggleSelected()
   endif

   !gadgetName = !object.name()

   if (!action eq 'SELECT') then
       if (!gadgetName.UpCase() eq 'FOLLSPEC') then
           !this.comboGadget.Tag = '   Spec'
           !this.comboGadget.visible = TRUE
           !this.frmAddSpec.val = 1
       elseif (!gadgetName.UpCase() eq 'FOLLFACE') then
           !this.comboGadget.Tag = '   Face'
           !this.comboGadget.visible = TRUE
           !this.frmAddSpec.val = 2
       elseif (!gadgetName.UpCase() eq 'FOLLITEM') then
           !this.comboGadget.visible = FALSE
           !this.frmAddSpec.val = 3
       endif
       !this.RefreshSpec()
       !this.RetrieveSpec()
   endif

endmethod
-- End of method definition for .ToggleSelected()


------------------------------------------------------------------------
--
-- Method:      CreatePaintSpec()
--
-- Description: Create paint spec data to design database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .CreatePaintSpec()

  if (!this.Debug) then
    $P Running sftDefineSpec.CreatePaintSpec()
  endif

  if (!this.frmAddSpec.val eq 3 ) then
      !comboValue = ''
  else
      !comboValue = !this.comboGadget.DisplayText()
      if (!comboValue eq '') then
          if ((!this.frmAddSpec.val eq 1) or (!this.frmAddSpec.val eq 2 )) then
             !!alert.Error('Specification not selected')
             return
          endif
      else
          !rtnBool = !!exists(!comboValue,'','')
          if (!rtnBool.not()) then
              !error = 'Value(' + !comboValue + ')' + 'does not exists in Database'
              !!alert.Error(!error)
              return
          endif
      endif
   endif

   if (!this.frmAddSpec.val eq 1 ) then
       var !insertpoint collect all ZONE with PURP eq 'SSPE'
   elseif (!this.frmAddSpec.val eq 2 ) then
       var !insertpoint collect all ZONE with PURP eq 'FSPE'
   else
       var !insertpoint collect all ZONE with PURP eq 'ISPE'
   endif

   if (!insertpoint.unset() ) then
       /*
       NEW SITE
       NEW ZONE
       if (!this.frmAddSpec.val eq 1 ) then
          PURP SSPE
       elseif (!this.frmAddSpec.val eq 2 ) then
          PURP FSPE
       else
          PURP ISPE
       endif
       !insertpoint[1] = !!CE
   endif

   !safeCE = !!CE
   $!insertpoint[1]
   TAIL

   if (!this.txtName.val neq '') then
       !rtnBool = !!exists(!this.txtName.val,'','')
       if (!rtnBool.not()) then
           if (!this.frmAddSpec.val eq 1 ) then
               NEW SYSPEC name $!this.txtName.val
           elseif (!this.frmAddSpec.val eq 2 ) then
               NEW FASPEC name $!this.txtName.val
           else
               NEW ITSPEC name $!this.txtName.val
           endif
       else
           if (!this.frmAddSpec.val eq 1 ) then
               NEW SYSPEC
           elseif (!this.frmAddSpec.val eq 2 ) then
               NEW FASPEC
           else
               NEW ITSPEC
           endif
       endif
   else
       if (!this.frmAddSpec.val eq 1 ) then
               NEW SYSPEC
           elseif (!this.frmAddSpec.val eq 2 ) then
               NEW FASPEC
           else
               NEW ITSPEC
           endif
   endif


   if ((!this.frmAddSpec.val eq 1) or (!this.frmAddSpec.val eq 2 )) then
     !!CE.Paspec = !comboValue.dbref()
   endif

   if (!this.txtIncode.val neq '') then
       !!CE.Stincd= !this.txtIncode.val.trim()
   endif

   if (!this.txtInside.val neq '') then
      !!CE.Stinrf =  !this.txtInside.val.dbref()
   endif

   if (!this.txtOutcode.val neq '') then
       !!CE.Stoucd = !this.txtOutcode.val.trim()
   endif

   if (!this.txtOutside.val neq '') then
      !!CE.Stourf = !this.txtOutside.val.dbref()
   endif

   !!CE = !safeCE

   !this.RetrieveSpec()

endmethod
-- End of method definition for .CreatePaintSpec()

------------------------------------------------------------------------
--
-- Method:      DeletePaintSpec()
--
-- Description: Delete paint spec data to design database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .DeletePaintSpec()

  if (!this.Debug) then
    $P Running sftDefineSpec.DeletePaintSpec()
  endif

  if ( !!alert.confirm('Delete Paint Spec - are you sure?').eq('YES') ) then
    !safeCE = !!CE

    do !row values !this.ngcSpecList.GetSelectedRows()
        !entry = !row[1]
        !element = !entry.dbref()

        $!element

        if (!this.frmAddSpec.val eq 1 ) then
            DELETE SYSPEC
        elseif (!this.frmAddSpec.val eq 2 ) then
            DELETE FASPEC
        else
            DELETE ITSPEC
        endif
    enddo
    !!CE = !safeCE

    !this.RefreshSpec()
    !this.RetrieveSpec()

  endif
endmethod
-- End of method definition for .DeletePaintSpec()

------------------------------------------------------------------------
--
-- Method:      RetrieveSpec()
--
-- Description: Show example data to demonstrate form controls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .RetrieveSpec()

  if (!this.Debug) then
    $P Running sftDefineSpec..RetrieveSpec()
  endif

-- Retrieve spec and surface treatment data from catalogue database
  --!this.RefreshSpec()

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  if (!this.frmAddSpec.val eq 1 ) then
      var !paintowners collect all ZONE with PURP eq 'SSPE'
  elseif (!this.frmAddSpec.val eq 2 ) then
      var !paintowners collect all ZONE with PURP eq 'FSPE'
  else
      var !paintowners collect all ZONE with PURP eq 'ISPE'
  endif

  if (!paintowners.unset() ) then
    !!alert.error('Can not find Paint Spec in Database (PURP=SSPE or FSPE or ISPE)')
    return
  endif

-- Currently restricted to single CATA or SECT - needs to handle multiples!
  !arrGridRowData = object ARRAY()

  do !paintowner values !paintowners
     !scope = !paintowner.dbref()

     if (!this.frmAddSpec.val eq 1 ) then
         var !allspec collect all SYSPEC for $!scope
     elseif (!this.frmAddSpec.val eq 2 ) then
         var !allspec collect all FASPEC for $!scope
     else
         var !allspec collect all ITSPEC for $!scope
     endif

     handle any
     --Temporary handle in case SRFTRT element not in this version of PDMS
       !!alert.error(!!ERROR.TEXT)
       return
     endhandle

     do !spec values !allspec
        !rowdata = !this.GenerateDisplayData(!spec)
        !arrGridRowData.append(!rowdata)
     enddo

  enddo
-- Bind example data to grid

  !nds = object NETDATASOURCE('Spec List', !this.SpecHeadings, !arrGridRowData)
  !this.ngcSpecList.bindToDataSource(!nds)

  !this.ngcSpecList.SetEditableColumn(2, FALSE)
  !this.ngcSpecList.SetEditableColumn(3, FALSE)
  !this.ngcSpecList.SetEditableColumn(5, FALSE)

  !this.ngcSpecList.clearrowselection()

endmethod
-- End of method definition for .RetrieveSpec()

------------------------------------------------------------------------
--
-- Method:      .ApplyCellChanges()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ApplyCellChanges(!data is ARRAY)

  if (!this.Debug) then
    $P Running sftDefineMain.ApplyCellChanges()
  endif

$(  q var !data
<ARRAY>
   [0]  <STRING> 'aaaaa'        (new value)
   [1]  <STRING> '=15353/363'   (row tag, sometimes =15353/363, the other 1,2,3)
   [2]  <STRING> 'STINCD'       (column header)
   [3]  <STRING> 'A'            (control flag)

$)

  !rowdata = !this.ngcSpecList.getRow(!data[1].real())
  q var !rowdata
  !item = !data[1].dbref()
  !item.$!data[2] = !data[0]
  handle(41,12)
     !error = 'Name ' + !data[0] + ' already used'
     !!alert.Error(!error)
     !data[3] = FALSE
     return
  endhandle

endmethod
-- End of method definition for .ApplyCellChanges()

------------------------------------------------------------------------
--
-- Method:      DisplaySpecData()
--
-- Description: Display spec data o text box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .DisplaySpecData(!data is ARRAY)

  if (!data.size().neq(1) ) then
    $P Incorrect array passed to DisplaySpecData()
    return
  endif

$(  q var !this.ngcSpecList.GetSelectedRows()
<ARRAY>
   [1]  <STRING> '=15392/25877'
   [2]  <STRING> 'PaSepc ref'
   [3]  <STRING> '//Surface-inside'
   [4]  <STRING> 'A'
   [5]  <STRING> '/Surface-outside'
   [6]  <STRING> 'B'
$)

  if (!data.unset()) then
  else

      !this.clearForm()

      !this.txtName.val = !this.ngcSpecList.GetSelectedRows()[1][1]
      !selItem = !this.ngcSpecList.GetSelectedRows()[1][2]

      if (!this.frmAddSpec.val eq 1 ) then
         !this.comboGadget.select('Dtext',!selItem)
         handle any
         endhandle
      elseif (!this.frmAddSpec.val eq 2 ) then
         !this.comboGadget.select('Dtext',!selItem)
         handle any
         endhandle
      else
         !this.combotem.select('Dtext',!selItem)
         handle any
         endhandle
      endif

      !this.comboSft.select('Dtext',!this.ngcSpecList.GetSelectedRows()[1][4])
      handle any
      endhandle

      if (!this.ngcSpecList.GetSelectedRows()[1][3] eq 'Nulref') then
         !this.txtInside.val = ''
      else
         !this.txtInside.val = !this.ngcSpecList.GetSelectedRows()[1][3]
      endif
      if (!this.ngcSpecList.GetSelectedRows()[1][4] eq 'unset') then
         !this.txtIncode.val = ''
      else
         !this.txtIncode.val = !this.ngcSpecList.GetSelectedRows()[1][4]
      endif

      if (!this.ngcSpecList.GetSelectedRows()[1][5] eq 'Nulref') then
         !this.txtOutside.val = ''
      else
         !this.txtOutside.val = !this.ngcSpecList.GetSelectedRows()[1][5]
      endif
      if (!this.ngcSpecList.GetSelectedRows()[1][6] eq 'unset') then
         !this.txtOutcode.val = ''
      else
         !this.txtOutcode.val = !this.ngcSpecList.GetSelectedRows()[1][6]
      endif

  endif

endmethod
-- End of method definition for .DisplaySpecData()

------------------------------------------------------------------------
--
-- Method:      Method:      UpdateSpec()
--
-- Description: Update griddata to SYSPEC,FASPEC,ITSPEC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateSpec()

  if (!this.Debug) then
    $P Running sftDefineMain.UpdateSpec()
  endif

-- grid check
  !selectedItems = !this.ngcSpecList.GetSelectedRows()
  if (!selectedItems.unset() ) then
    !!alert.error('Specification not selected')
    return
  endif

  !safeCE = !!CE

  do !idx index !selectedItems

-- Update the relevant grid cell with the new value
      !!CE = !selectedItems[!idx][1].dbref()
      $!!CE

      if (!this.txtName.val neq '') then
         if (!!exists(!this.txtName.val,'','')) then
         else
             !!CE.name = !this.txtName.val
         endif
      else
         !!alert.error('Name field does not allow null value!!')
         return
      endif

      if (!this.frmAddSpec.val eq 1 ) then
         if (!this.comboGadget.DisplayText().trim() eq '') then
            !specSelection = ''
         else
            !specSelection = !this.comboGadget.selection()
         endif
      elseif (!this.frmAddSpec.val eq 2 ) then
         if (!this.comboGadget.DisplayText().trim() eq '') then
            !specSelection = ''
         else
            !specSelection = !this.comboGadget.selection()
         endif
      else
         !specSelection = ''
      endif

     !nullRef = 'unset'
     if (!specSelection neq '') then
         if (NOT BADREF(!specSelection.dbref())) then
            !!CE.Paspec = !specSelection.dbref()
         endif
     else
         PASPEC  $!nullRef
     endif

     if (!this.txtInside.val neq '') then
         if (NOT BADREF(!this.txtInside.val.dbref())) then
            !!CE.stinrf = !this.txtInside.val.dbref()
         endif
     else
         STINRF $!nullRef
     endif

     if (!this.txtOutside.val.trim() neq '') then
         if (NOT BADREF(!this.txtOutside.val.dbref())) then
             !!CE.stourf = !this.txtOutside.val.dbref()
         endif
     else
         STOURF $!nullRef
     endif

     if (!this.txtIncode.val.trim() neq '') then
         !!CE.stincd = !this.txtIncode.val.trim()
     else
         !!CE.stincd = ''
     endif

     if (!this.txtOutcode.val.trim() neq '') then
         !!CE.stoucd = !this.txtOutcode.val.trim()
     else
         !!CE.stoucd = ''
     endif
  enddo

  !!CE = !safeCE
  !this.RetrieveSpec()
  --!this.ClearForm()

endmethod
-- End of method definition for .UpdateSpec()

------------------------------------------------------------------------
--
-- Method:      Method:      ClearForm()
--
-- Description: Clear form gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ClearForm()
  if (!this.Debug) then
    $P Running sftDefineMain.ClearForm()
  endif

  !this.txtName.val = ''
  !this.txtIncode.val = ''
  !this.txtInside.val = ''
  !this.txtOutside.val = ''
  !this.txtOutcode.val = ''

endmethod
-- End of method definition for .ClearForm()

------------------------------------------------------------------------
--
-- Method:      GenerateDisplayData()
--
-- Description: Generate array of column data to be displayed for the supplied HMHOLE element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GenerateDisplayData(!item is STRING) is ARRAY

  if (!this.Debug) then
    $P Running sftDefineSpec.GenerateDisplayData(ARRAY)
  endif
  !arrReturn = ARRAY()

  !arrReturn[1] = !item.dbref().name

  if (!item.dbref().PASPEC.set()) then
      !arrReturn[2] = !item.dbref().PASPEC.name
  else
      !arrReturn[2] = ''
  endif

  if (!item.dbref().STINRF.set()) then
      !arrReturn[3] = !item.dbref().STINRF.name
  else
      !arrReturn[3] = ''
  endif

  !arrReturn[4] = !item.dbref().STINCD

  if (!item.dbref().STOURF.set()) then
      !arrReturn[5] = !item.dbref().STOURF.name
  else
      !arrReturn[5] = ''
  endif

  !arrReturn[6] = !item.dbref().STOUCD

  return !arrReturn
endmethod
-- End of method definition for .GenerateDisplayData()
