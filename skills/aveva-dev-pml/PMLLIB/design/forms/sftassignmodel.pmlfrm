------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToView()                      -
--  apply()                          -
--  bothalternate()                  -                   In Pipe spec, system doing the twice call to changealternate(in) and changealternate(out)
--  changealternate(STRING,STRING)   -                   Allow the user to select alternate values for the selected entry
--  clearComboTitem()                -
--  clearTextGadget()                -
--  clickCallBack(DBREF)             -                   EDG Click Action callback
--  closeCallBack()                  -                   EDG CloseAction callback
--  generateDisplayData(ARRAY)       ARRAY
--  initClear()                      -
--  initialise()                     -                   Initialise form settings each time it is shown
--  pickElements()                   -
--  popupHandler(ARRAY)              -
--  printList()                      -
--  purposeCallback()                -                   Callback event when comboPurpose data for purpose is change
--  removefromlist()                 -                   Remove selected items from the displayed list
--  retrieveComboTitem()             -
--  saveToXLS()                      -                   Save the grid data to Excel file
--  scopeChoice()                    -                   Deal with selection of scope choice radio buttons
--  scopeselection(STRING)           -                   Populate the data grid by choosing a method based on user settings on the form
--  setAttribute(DBREF,ARRAY)        -
--  setTableItemToGadget()           -
--  sftAssignModel()                 -                   Constructor
--  showtoGridControl(ARRAY)         -                   Display selected item data to Grid control
--  tableItemCallback()              -                   Callback event when comboTitem data is change
--  tableitemlist()                  -                   Show the all selected item list to new form
--  updateDisplayedList(ARRAY)       -
--  updateGridCode(STRING)           -                   Update the INSIDE and OUTSIDE Punch code for the selected entry to the value provided
--  updateInOutsideCode(ARRAY,ARRAY,DBREF,STRING,STRING) -
--  updateTextGadget(ARRAY,ARRAY,DBREF,STRING) -                   Update the INSIDE or OUTSIDE Gadget value for the selected entry to the value provided
--

--
------------------------------------------------------------------------
-- Form:      sftAssignModel
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle (1000,0)
endhandle

import 'GridControl'
handle (1000,0)
endhandle

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

--- form definition
setup form !!sftAssignModel dialog docking size 60 26

-- Define titles and initialisation call
  !this.formTitle = 'Surface Treatment - Assignment'
  !this.iconTitle = 'Surface Treatment'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path right
  vdist 0.5

-- Framing for scope selection
  frame .frmScope           'Scope definition' at xmin form                anchor t+l+r width 85
    combobox  .comboGroup                      at xmin.frmScope + 1        width 5
    rtoggle   .cemem            'CE mem'       at xmax.comboGroup + 1      tagwidth 5
    rtoggle   .idelem           'ID'           at xmax.cemem + 1           tagwidth 2
    rtoggle   .currelem         'CE'           at xmax.idelem + 1          tagwidth 2
    rtoggle   .uselist          'LIST'         at xmax.currelem + 1
    option    .listlist                        at xmax.uselist + 1.5         width 20
    button    .btnpick          ' Select '     at xmax.listlist + 1.5      CALLBACK |!this.scopeselection('SELECT')|
    button    .btnadd           'Add Item '    at xmax.btnpick + 1         CALLBACK |!this.scopeselection('ADD')|
  exit
  path down

-- Framing for gadget showing all elements selected
  frame .frmselected       'Selected elements' at xmin form                anchor all width 85 height 18
    container .conSelected nobox PMLNetCONTROL 'NET' at xmin                     dock fill
  exit

  frame .frmfolldata                           at xmin form                ymax                 anchor b+l+r width 58       height 4
    para      .parapurp                        at xmin.frmfolldata + 1     ymin.frmfolldata + 1 text 'Table group'      width 8
    combobox  .comboPurpose                    at xmax.parapurp + 0.5      ymin.parapurp        scroll 50               width 4     tooltip 'TableGroup'
    para      .paratitem                       at xmax.comboPurpose + 1    ymin.parapurp        text 'Table item'       width 7
    combobox  .comboTitem                      at xmax.paratitem           ymin.parapurp        scroll 50               width 23    tooltip 'TableItem list'
    button    .btninside        'Inside'       at xmax.comboTitem +1       ymin.parapurp        width 9                 CALLBACK |!this.updateGridCode('IN')|
    button    .btnoutside       'Outside'      at xmax.btninside + 1       ymin.parapurp        width 9                 CALLBACK |!this.updateGridCode('OU')|
    button    .btnboth          'Both'         at xmax.btnoutside + 1      ymin.parapurp        width 9                 CALLBACK |!this.updateGridCode('BOTH')|
    para      .paraspec                        at xmin.frmfolldata + 1     ymax.parapurp + 0.5  text 'Specification'    width 9
    text      .txtSpec                         at xmax.paraspec - 0.5      ymin.paraspec        width 10 is STRING
    para      .parascd                         at xmax.txtSpec  + 0.5      ymin.paraspec        text 'Symbol code'      width 8.5
    text      .txtSymbolCode                   at xmax.parascd             ymin.paraspec        width 5 is STRING
    para      .parapcd                         at xmax.txtSymbolCode + 1   ymin.paraspec        text 'Punch code'       width 8
    text      .txtPunchCode                    at xmax.parapcd+.5          ymin.paraspec        width 5 is STRING
    button    .btnapply         ' Apply '      at xmax.txtPunchCode + 1    ymin.paraspec        width 9                 CALLBACK '!this.apply()'
    button    .btnunset         'SRFList'      at xmax.btnapply + 1        ymin.paraspec        width 9                 CALLBACK '!this.tableitemlist()'
    button    .btncancel        'Dismiss'      at xmax.btnunset + 1        ymin.paraspec        width 9                 CANCEL
  exit
-- define PML popup menu
  menu .mnupopup popup
  !this.mnupopup.add( 'CALLBACK', 'Add to 3D view','!this.addToView()' )
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Change Inside codes from Spec',|!this.changealternate('SPEC','IN')| )
  !this.mnupopup.add( 'CALLBACK', 'Change Outside codes from Spec',|!this.changealternate('SPEC','OU')| )
  !this.mnupopup.add( 'CALLBACK', 'Change IN/OUT codes from Spec',|!this.bothalternate()| )
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Change Inside codes from Face',|!this.changealternate('FACE','IN')| )
  !this.mnupopup.add( 'CALLBACK', 'Change Outside  codes from Face',|!this.changealternate('FACE','OU')| )
  !this.mnupopup.add( 'CALLBACK', 'Change IN/OUT codes from Face',|!this.changealternate('FACE','BOTH')| )
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Change codes from Table List','!this.tableitemlist()' )
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Remove selected list in Grid','!this.removefromlist()')
  !this.mnupopup.add( 'CALLBACK', 'Remove all list in Grid','!this.ngcSelected.clearGrid()')
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Print Grid','!this.printList()' )
  !this.mnupopup.add( 'CALLBACK', 'Grid to Excel file','!this.saveToXLS()' )

-- End of FORM definition

  member .ngcSelected         is  NETGRIDCONTROL
  member .headings            is ARRAY

  member .debug               is BOOLEAN

  member .edgSelected         is ARRAY

-- Clicked button is ADD or Select item
  member .jobStatus           is STRING

-- SURFACETREATMENT object
  member .surfaceTreat        is  SURFACETREATMENT

-- Purpose of TABGROUP
  member .purpose             is STRING

-- Selected table item on comboTitem
  member .selectedTableItem   is STRING

-- Rtext of selected table item on comboTitem
  member .selectedRtextSpec   is STRING

-- Data of selection Table item below CTABLE
  member .allTableItems       is ARRAY

-- SRFTREF data of GPART
  member .surfaceRef          is DBREF

-- Query expression is NAMN or NAME
  member .queryOption         is STRING
exit

------------------------------------------------------------------------
-- Method:      sftAssignModel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftAssignModel()

  !this.headings.append('TYPE')
  !this.headings.append('NAME')
  !this.headings.append('OWNER')
  !this.headings.append('PSPEC')
  !this.headings.append('INPRTR')
  !this.headings.append('STINRF')
  !this.headings.append('STINCD')
  !this.headings.append('PUINCD')
  !this.headings.append('OUPRTR')
  !this.headings.append('STOURF')
  !this.headings.append('STOUCD')
  !this.headings.append('PUOUCD')

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for selected elements
  !this.ngcSelected = object NETGRIDCONTROL()
  !this.conSelected.control = !this.ngcSelected.handle()

  !this.ngcSelected.addeventhandler('OnPopup', !this, 'PopupHandler')
  !this.conSelected.popup = !this.mnupopup

-- callback for radio toggles (ID/CE/LIST)
  !this.frmScope.callback = '!this.scopeChoice()'

  !this.frmScope.val = 1
  !this.listlist.active = FALSE

endmethod
-- End of method sftAssignModel()


------------------------------------------------------------------------
-- Method:      initialise
--
-- Description: Initialise form settings each time it is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

  !groupdtext = ARRAY()
  !groupdtext.append('ALL')
  !groupdtext.append('PIPE')
  !groupdtext.append('HVAC')
  !groupdtext.append('BRAN')
  !groupdtext.append('EQUI')
  --!groupdtext.append('FRMW')
  !groupdtext.append('STRU')
  --!groupdtext.append('NOZZ')

  !this.comboGroup.dtext = !groupdtext

  !dtext = ARRAY()
  !dtext.append('IPSP')
  !dtext.append('OPSP')
  !dtext.append('FACE')
  !dtext.append('GENE')

  !this.comboPurpose.dtext = !dtext

 -- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSelected.columnExcelFilter(!f)
  !this.ngcSelected.outlookGroupStyle(!f)
  !this.ngcSelected.fixedHeaders(!f)
  !this.ngcSelected.fixedRows(!t)
  !this.ngcSelected.editableGrid(!f)
  !this.ngcSelected.singlerowselection(!f)
  !this.ngcSelected.headerSort(!t)
  !this.ngcSelected.setalternaterowcolor('lightgray')

-- Remove any previous selection
  --!this.ngcSelected.clearrowselection()


-- Read the standard Design LIST facility for existing LISTs to be included
  !this.listlist.active = !f
  !this.listlist.clear()
  if (defined(!!cdlist) ) then
    do !listing index !!cdlist
      !this.listlist.add(!!cdlist[$!listing], !listing.string())
    enddo
  endif
  !this.uselist.active = !t
  if (!this.listlist.dtext.size().eq(0) ) then
    !this.uselist.active = !f
  endif

  !this.comboPurpose.callback = '!this.purposeCallback()'
  !this.comboTitem.callback = '!this.tableItemCallback()'

-- All member variable set initialize

  !this.initClear()

  !this.retrieveComboTitem()

endmethod
-- End of method initialise()


------------------------------------------------------------------------
--
-- Method:      .scopeChoice()
--
-- Description: Deal with selection of scope choice radio buttons
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .scopeChoice()

  if (!this.debug) then
    WRITE |Running sftAssignModel.scopeChoice()|
  endif

  if ( !this.frmScope.val.eq(4) ) then
    !this.listlist.active = TRUE
    !this.listlist.clear()
    do !listing index !!cdlist
      !this.listlist.add(!!cdlist[$!listing], !listing.string())
    enddo
    !this.listlist.val = 1
    !this.comboGroup.active = FALSE
  else
    if ( !this.frmScope.val.eq(1)) then
        !this.comboGroup.active = TRUE
    else
        !this.comboGroup.active = FALSE
    endif
    !this.listlist.active = FALSE
  endif

  return
endmethod
-- End of method definition for .scopeChoice()


------------------------------------------------------------------------
-- Method:      scopeselection
--
-- Description: Populate the data grid by choosing a method based on user settings on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .scopeselection(!jobStatus is STRING)

   if (!this.debug) then
    WRITE |Running sftAssignModel.scopeselection()|
   endif

-- Confirmation before continuing at WORL or SITE level
   if ( !this.frmScope.val.eq(1) AND (!!ce.type.eq('WORL') OR !!ce.type.eq('SITE') ) ) then
      !answ = !!alert.confirm('Collecting data for ' + !!ce.type + ' level may take some time. Do you want to continue?')
      if (NOT !answ.boolean() ) then
        return
      endif
   endif

   !selected = ARRAY()
   !this.jobStatus = !jobStatus

-- Option chosen: CE mem
   if (!this.frmScope.val.eq(1) ) then
      !this.surfaceTreat.getCeMemberWithOuprtr(!!ce, !this.comboGroup.selection('Dtext'))
      !this.showtoGridControl(!this.surfaceTreat.modelList)

-- Option chosen: ID
   elseif (!this.frmScope.val.eq(2) ) then
       !this.pickElements()

-- Option chosen: CE
   elseif (!this.frmScope.val.eq(3) ) then
      !unusedRef = !!ce.attribute('OUPRTR')
      handle (2,201)
        !error = !!ce.name + ' does not have OUPRTR Attribute'
        !!alert.error(!error)
        return
      endhandle
      !selected.append(!!ce)
      !this.showtoGridControl(!selected)

-- Option chosen: LIST
   elseif (!this.frmScope.val.eq(4) ) then
     !listopt = !this.listlist.val
     if ( defined(!!cdlist$!listopt) ) then
       -- For each item in the list...
       do !list value !!cdlist$!listopt
           !selected.append(!list.dbref())
       enddo
     endif
     !this.showtoGridControl(!selected)
   endif

endmethod
-- End of method definition for .scopeselection()

------------------------------------------------------------------------
-- Method:      PickElements
--
-- Description: Graphically pick elements for inclusion on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of DBREFs to be displayed
------------------------------------------------------------------------
define method .pickElements()

    if (!this.debug) then
       WRITE |Running sftAssignModel.pickElements()|
    endif

    !this.edgSelected = object ARRAY()

    !packet1 = object EDGPACKET()
    !edgdesc = 'Pick Elements item (PIPE,HVAC,BRAN,EQUI,STRU)'
    !packet1.elementPick(!edgdesc)

    !rule = 'TYPE INSET (|PIPE|,|HVAC|,|BRAN|,|EQUI|,|STRU|)'
    !packet1.priority       = 1
    !packet1.pickpacket.picks[1].pick.input[3] = !rule
    !packet1.pickpacket.picks[1].pick.modifiable = FALSE
    !packet1.remove = FALSE

    !packet1.action = '!!sftAssignModel.clickCallBack(!this.return[1].item)'
    !packet1.close = '!!sftAssignModel.closeCallBack()'

    if (!!edgCntrl.add(!packet1).not()) then
       !!alert.error('Failed loading' + !!error.text)
    endif

    --!!edgCntrl.viewStack()

endmethod
-- End of method PickElements()

------------------------------------------------------------------------
--
-- Method:      .clickCallBack()
--
-- Description: EDG Click Action callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clickCallBack(!dbref is DBREF)

   if (!this.debug) then
    WRITE |Running sftAssignModel.clickCallBack()|
   endif

   !this.edgSelected.append(!dbref)

endmethod
-- End of method definition for .clickCallBack

------------------------------------------------------------------------
--
-- Method:      .closeCallBack()
--
-- Description: EDG CloseAction callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .closeCallBack()

   if (!this.debug) then
    WRITE |Running sftAssignModel.closeCallBack()|
   endif

   !this.showtoGridControl(!this.edgSelected)

endmethod

------------------------------------------------------------------------
--
-- Method:      .showtoGridControl()
--
-- Description: Display selected item data to Grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showtoGridControl(!selectedItem is ARRAY)

   if (!this.debug) then
    WRITE |Running sftAssignModel.showtoGridControl()|
   endif

   if (!this.jobStatus eq 'ADD') then
       !gridData = !this.ngcSelected.getRows()
       do !idx index !gridData
          !selectedItem.append(!gridData[$!idx][2].dbref())
       enddo
   endif

   if (!selectedItem.size().eq(0) OR !selectedItem[1].objecttype().neq('DBREF') ) then
       !this.ngcSelected.clearGrid()
       return
   endif

-- Generate the array of data for DTEXT
   !rowdata = !this.generateDisplayData(!selectedItem)

-- Clear displayed list before update
   !this.ngcSelected.clearGrid()

-- Update the displayed data
   !this.updateDisplayedList(!rowdata)

endmethod
-- End of method definition for .showtoGridControl

------------------------------------------------------------------------
-- Method:      removefromlist
--
-- Description: Remove selected items from the displayed list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removefromlist()

   !this.ngcSelected.deleteSelectedRows()

endmethod
-- End of method removefromlist()

------------------------------------------------------------------------
-- Method:      bothalternate
--
-- Description: In Pipe spec,system doing the twice call to changealternate(in) and changealternate(out)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .bothalternate()
     !this.changealternate('SPEC','IN')
     !this.changealternate('SPEC','OU')
endmethod

------------------------------------------------------------------------
-- Method:      changealternate
--
-- Description: Allow the user to select alternate values for the selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changealternate(!cond1 is STRING, !cond2 is STRING)

   if (!this.debug) then
    WRITE |Running sftAssignModel.changealternate()|
   endif

-- Initialize to Text gadget Area due to change member variable such as !this.purpose
   !this.comboPurpose.select('Rtext','IPSP')
   !this.purposeCallback()

-- Currently restricted to single CATA or SECT - needs to handle multiples!
   do !rowTag values !this.ngcSelected.getSelectedRowTags()
--      -- New method on Grid Control : GetRow(STRING)
      !row = !this.ngcSelected.getRow( !rowTag )

      if (!cond1 eq 'SPEC') then
          -- !cond1 is SPEC
          if (!row[4] eq '') then
              !error = 'Selected item ' + !row[2] + ' does not have SPEC value'
			    		!!alert.error(!error)
              skip
          endif
          if (!this.queryOption eq 'NAMN') then
              !itemSPEC = !row[4].substring(2)
          else
              !itemSPEC = !row[4]
          endif

          if (!cond2 eq 'IN') then
              !this.purpose = 'IPSP'
              !question = 'IPSP'
          elseif (!cond2 eq 'OU') then
              !this.purpose = 'OPSP'
              !question = 'OPSP'
          endif
          !answer = !itemSPEC
      else
          -- !cond1 is FACE
          !element = !row[2].dbref()
          !search[1] = 'ZONE'
          !zoneDbref = !!dtbOwneroftypes(!element,!search)

          if (!zoneDbref.unset()) then
              !error = 'can not find Zone above selected item ' + !row[2]
					    !!alert.error(!error)
              skip
          endif
          !this.purpose = 'FACE'
          !question = 'FACE'
          !answer = !zoneDbref.facode
      endif

      !para = |'| + !this.purpose + |'|
      !this.surfaceTreat.getTablegroup(!para)
      !tabgroup = !this.surfaceTreat.tableGroup
      if (!tabgroup.unset() or !tabgroup.size().eq(0)) then
          !error = 'TABGRO element (PURP=' + !this.purpose + ') does not exists'
          !!alert.error(!error)
          skip
      endif

      !this.surfaceTreat.getMatchingFromCondition(!tabgroup, !question, !answer)
      !matchTableItem = !this.surfaceTreat.matchingItems

      if (!matchTableItem.unset()) then
          !error = 'Can not find matching data on ' + !tabgroup[1].dbref().name + ' TABGRO '
          !error = !error + ' : Question = ' + !question + '; Answer = ' + !answer
					!!alert.error(!error)
          skip
      endif

      !gpart = !matchTableItem[1].prtref
      if (BADREF(!gpart)) then
          !error = 'PRTREF of TABITEM(' + !matchTableItem[1] + ') is BAD Reference'
          !!alert.error(!error)
          skip
      endif

      !combo = object ARRAY()
      !code = object ARRAY()

-- Set Table group value
      !combo.append(!this.purpose)
-- Set Table item value
      !combo.append(!matchTableItem[1].name)
-- Set specification or facode
      !combo.append(!answer)
-- Set INPRTR or OUPUTR value
      !surfaceRef = !gpart.srftref
-- Set Symbol code and Punch code value
      if (!surfaceRef.set()) then
          !code.append(!gpart.stcd)
          !code.append(!gpart.pucd)
      else
          !code.append('')
          !code.append('')
      endif

      if (!cond2 eq 'BOTH') then
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, 'IN', !rowTag)
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, 'OU', !rowTag)
      else
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, !cond2, !rowTag)
      endif

    enddo

endmethod
-- End of method changealternate()

------------------------------------------------------------------------
-- Method:      UpdateInOutsideCode
--
-- Description: Update the INSIDE or OUTSIDE code for the selected entry to the value provided
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateInOutsideCode(!combo is ARRAY, !code is ARRAY, !srftref is DBREF, !inout is STRING, !rowTag is STRING)

-- Sample Data
-- !combo[1] = !this.comboPurpose.selection('Rtext')
-- !combo[2] = !this.comboTitem.selection('Dtext')
-- !combo[3] = !this.comboTitem.selection('Rtext')
-- !code[1] = !this.txtSymbolCode.val.trim()
-- !code[2] = !this.txtPunchCode.val.trim()
-- !srftref = SRFTREF of GPART
-- !inout = 'IN' or 'OU' or 'BOTH'

   if (!this.debug) then
    WRITE |Running sftAssignModel.updateInOutsideCode()|
   endif

   !paintref = !inout + 'PRTR'
   !strf = 'ST' + !inout + 'RF'
   !stcd = 'ST' + !inout + 'CD'
   !pucd = 'PU' + !inout + 'CD'

-- Update the relevant grid cell with the new value
   !this.ngcSelected.setCellValue(!rowTag, !paintref, !combo[2])
   if (!srftref.set()) then
       !this.ngcSelected.setCellValue(!rowTag, !strf, !srftref.name)
   else
       !this.ngcSelected.setCellValue(!rowTag, !strf, '')
   endif
   !this.ngcSelected.setCellValue(!rowTag, !stcd, !code[1])
   !this.ngcSelected.setCellValue(!rowTag, !pucd, !code[2])

endmethod

-- End of method UpdateInOutsideCode()

------------------------------------------------------------------------
-- Method:      updateGridCode
--
-- Description: Update the INSIDE and OUTSIDE Punch code for the selected entry to the value provided
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGridCode(!job is STRING)

   if (!this.debug) then
       WRITE |Running sftAssignModel.updateGridCode()|
   endif

  if (!this.ngcSelected.getSelectedRowTags().unset() ) then
      !!alert.error('No grid item selected')
      return
  endif

  if (!this.comboTitem.selection('Rtext').trim() eq '' ) then
        !surfaceRef = object DBREF()
    else
        !surfaceRef = !this.surfaceRef
  endif

  !combo = object ARRAY()
  !code = object ARRAY()

  !combo.append(!this.comboPurpose.selection('Rtext'))
  !combo.append(!this.comboTitem.selection('Dtext'))
  !combo.append(!this.comboTitem.selection('Rtext'))
  !code.append(!this.txtSymbolCode.val.trim())
  !code.append(!this.txtPunchCode.val.trim())

  do !rowTag values !this.ngcSelected.getSelectedRowTags()
     if (!job eq 'BOTH') then
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, 'IN', !rowTag)
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, 'OU', !rowTag)
     else
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, !job, !rowTag)
     endif
  enddo

endmethod
-- End of method updateGridCode()

------------------------------------------------------------------------
-- Method:      updateTextGadget
--
-- Description: Update the INSIDE or OUTSIDE Gadget value for the selected entry to the value provided
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateTextGadget(!combo is ARRAY, !code is ARRAY, !surfaceRef is DBREF, !inout is STRING)

-- Sample Data
-- !combo[1] = !this.comboPurpose.selection('Rtext')
-- !combo[2] = !this.comboTitem.selection('Dtext')
-- !combo[3] = !this.comboTitem.selection('Rtext')
-- !code[1] = !this.txtSymbolCode.val.trim()
-- !code[2] = !this.txtPunchCode.val.trim()
-- !inout = 'IN' or 'OU' or 'BOTH'

   if (!this.debug) then
       WRITE |Running sftAssignModel.updateTextGadget()|
   endif

   if (!combo[1] neq 'GENE') then
      !this.txtSpec.val = !combo[3]
   endif

   !this.comboPurpose.select('Rtext',!combo[1])
   !this.purposeCallback()

   if (!combo[2] eq '') then
       !this.comboTitem.select('Rtext',!combo[2])
   else
       !this.comboTitem.select('Dtext',!combo[2])
   endif
   !this.tableItemCallback()
   !this.txtSymbolCode.val = !code[1]
   !this.txtPunchCode.val = !code[2]

   do !rowTag values !this.ngcSelected.getSelectedRowTags()
     if (!inout eq 'BOTH') then
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, 'IN', !rowTag)
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, 'OU', !rowTag)
     else
        !this.updateInOutsideCode(!combo, !code, !surfaceRef, !inout, !rowTag)
     endif
  enddo

endmethod

-- End of method updateTextGadget()


------------------------------------------------------------------------
-- Method:      GenerateDisplayData
--
-- Description: Generate the data array for the DTEXT to be displayed
--              using the supplied array of DBREF items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateDisplayData(!arrSelected is ARRAY) is ARRAY

   if (!this.debug) then
    WRITE |Running sftAssignModel.generateDisplayData()|
   endif

-- Make sure the scope has no duplicates
  !scope = !arrSelected.sortUnique()

  !arrReturn = object ARRAY()

-- Generate array of Row Data for display in the grid
  do !item values !scope

     !rowdata = ARRAY()

     !rowdata[1] = !item.type
     !rowdata[2] = !item.name
     !rowdata[3] = !item.owner.name

-- Figure out the suggested Surface Treatment value if possible
     !itemSPRE = !item.spref
     handle none
       if (!itemSPRE.set() ) then
         !safeCE = !!ce
         if (BADREF(!itemSPRE)) then
            !rowdata[4] = ''
         else
            $!item.spref
            SPEC
            handle (2,111)
               !rowdata[4] = !item.spref.name
            elsehandle NONE
               !rowdata[4] = !!ce.name
            endhandle
         endif
         !!ce = !safeCE
       else
         !rowdata[4] = ''
       endif
     elsehandle (2,201)
       !itemSPRE = !item.pspec
       handle none
         !rowdata[4] = !itemSPRE.name
         handle (2, 754)
           !rowdata[4] = ''
         endhandle
       elsehandle (2,201)
          !rowdata[4] = ''
       endhandle
     endhandle

     if (!item.inprtr.unset()) then
         !rowdata[5] = ''
         !rowdata[6] = ''
         !rowdata[7] = ''
         !rowdata[8] = ''
     else
         !rowdata[5] = !item.inprtr.name
         if (!item.stinrf.unset()) then
             !rowdata[6] = ''
         else
             !rowdata[6] = !item.stinrf.name
         endif

         !rowdata[7] = !item.stincd
         !rowdata[8] = !item.puincd
     endif

     if (!item.ouprtr.unset()) then
         !rowdata[9] = ''
         !rowdata[10] = ''
         !rowdata[11] = ''
         !rowdata[12] = ''
     else
         !rowdata[9] = !item.ouprtr.name
         if (!item.stourf.unset()) then
             !rowdata[10] = ''
         else
             !rowdata[10] = !item.stourf.name
         endif

         !rowdata[11] = !item.stoucd
         !rowdata[12] = !item.puoucd
     endif

     !arrReturn.append(!rowdata)
  enddo

  return !arrReturn

endmethod
-- End of method GenerateDisplayData()


------------------------------------------------------------------------
-- Method:      UpdateDisplayedList
--
-- Description: Update the displayed data with the supplied array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateDisplayedList(!arrData is ARRAY)

   if (!this.debug) then
    WRITE |Running sftAssignModel.updateDisplayedList()|
   endif

-- setup controls for PML containers
   using namespace 'Aveva.Pdms.Presentation'

-- Bind example data to grid
   !nds = object NETDATASOURCE('Selected elements', !this.headings, !arrData)
   !this.ngcSelected.bindToDataSource(!nds)

endmethod
-- End of method UpdateDisplayedList()

------------------------------------------------------------------------
--
-- Method:      PopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data.size() gt 2) then
    !this.conSelected.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .popupHandler()


------------------------------------------------------------------------
--
-- Method:      Apply()
--
-- Description: Take user selections and update the model
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

   if (!this.debug) then
    WRITE |Running sftAssignModel.apply()|
   endif

   if (!this.ngcSelected.getSelectedRowTags().unset() ) then
       !!alert.error('No grid item selected')
       return
   endif

   !apply = !!alert.confirm('Process selected rows and set attributes accordingly?')
   if (!apply eq 'YES') then

     do !row values !this.ngcSelected.getSelectedRows()

       -- Update grid data to attribute of Branch elements
       !selectedElement = object DBREF()
       !selectedElement = !row[2].dbref()
       if (NOT !selectedElement.dbwrite ) then
         !error = 'No WRITE access to ' + !selectedElement + ' Element'
         !!alert.error(!error)
         return
       endif

       !this.setAttribute(!selectedElement,!row)
     enddo
   else
     return
   endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      SetAttribute
--
-- Description: Update the attribute for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- value      R     STRING    new status
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttribute(!element is DBREF,!gData is ARRAY)

  if (!this.debug) then
    WRITE |Running sftAssignModel.setAttribute(DBREF)|
  endif

  !safeCE = !!ce

-- Set new values in database
  $!element

  if (!gData[5] eq '') then
      INPRTR unset
  else
      INPRTR $!gData[5]
  endif

  if (!gData[9] eq '') then
      OUPRTR unset
  else
      OUPRTR $!gData[9]
  endif

  !!ce = !safeCE

endmethod
-- End of method definition for .setAttribute()

------------------------------------------------------------------------
--
-- Method:      AddToView()
--
-- Description: Display the selected item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToView()

  if (!this.debug) then
    WRITE |Running sftAssignModel.addToView()|
  endif

-- If standard view is set then update it otherwise gracefully ignore this
  if ( !!gphviews.views.set() ) then
    AUTOCOLOUR OFF
    UNENHANCE ALL
    --REM ALL
    !itemlist = object ARRAY()
    do !idx index !this.ngcSelected.getSelectedRowTags()
       !itemlist.append(!this.ngcSelected.getSelectedRows()[!idx][2].dbref())
-- Update the relevant grid cell with the new value
    enddo

    do !element values !itemlist
       ADD $!element
    enddo
    !!gphviews.limits(!!gphviews.views[1], object volume(!itemlist ) )
    !!gphviews.rotate(!!gphviews.views[1], object volume(!itemlist ) )
  else
    if (!this.debug) then
      WRITE |Skipped update of graphical view sftAssignModel.addToView()|
    endif
  endif

  return

endmethod
-- End of method definition for .addToView()

------------------------------------------------------------------------
--
-- Method:      PrintList()
--
-- Description: Print preview the grid data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printList()

  if (!this.ngcSelected.getNumberRows().neq(0)) then
    !this.ngcSelected.printPreview()
  else
    !!alert.error('There is no data in Grid Control to print')
  endif

endmethod
-- End of method definition for .printList()

------------------------------------------------------------------------
--
-- Method:      .saveToXLS()
--
-- Description: Save the grid data to Excel file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToXLS()

  if (!this.ngcSelected.getNumberRows().eq(0)) then
    !!alert.error('There is no data in Grid Control to save')
    return
  endif

  using namespace 'AVEVA.PDMS.Presentation'
  !browser = object PMLFILEBROWSER('SAVE')

-- Default to first location from PDMSUSER evar
  !pdmsuser = !!evarSplit('PDMSUSER')
  !directory = !pdmsuser[1]

  !seedFile = 'PaintListData'
  !title = 'Save Paint List As'
  !existFlag = FALSE
  !filter = 'Microsoft Office Excel files (*.xls)|*.xls'
  !filterIndex = 1

-- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

-- Set selected file
  !savefile = object FILE( !browser.file() )

  if ( !savefile.set() ) then
    !this.ngcSelected.saveGridToExcel(!savefile.string())
    handle (1000,0)
      !!alert.error('Could not write file: ' + !savefile.string() + ' - ' + !!error.text )
    elsehandle none
      !!alert.message('File saved: ' + !savefile.string() )
    endhandle
  endif

endmethod
-- End of method definition for .saveToXLS()

------------------------------------------------------------------------
--
-- Method:      RetrieveComboTitem()
--
-- Description: Retrieve Table items below Table group and assign it to dtext and rtext of comboTitemShow
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .retrieveComboTitem()

   if (!this.debug) then
      WRITE |Running sftAssignModel.retrieveComboTitem()|
   endif

   !para = |'| + !this.purpose + |'|

-- Getting all TABGROUP with purpose
   !this.surfaceTreat.getTablegroup(!para)
   !allTabgroup = !this.surfaceTreat.tableGroup

   if (!allTabgroup.unset() OR !allTabgroup.size().eq(0)) then
       !error = 'TABGRO element (PURP=' + !this.purpose + ') does not exist'
       !!alert.error(!error)
       return
   endif

-- Getting all TABITEM below TAQBGROUP
   !this.surfaceTreat.getTableItems(!allTabgroup)
   !this.allTableItems = !this.surfaceTreat.tableItems

   if (!this.allTableItems.unset() OR !this.allTableItems.size().eq(0)) then
      !!alert.error('TABITE element does not exist below CTABLE')
      return
   endif

   !dtext = object ARRAY()
   !rtext = object ARRAY()

   !this.allTableItems.sort()

   !dtext.append('')
   !rtext.append('')

   do !i index !this.allTableItems
      if(!this.allTableItems[!i][2].substring(1,1) ne '/') then
          !this.allTableItems[!i][2] = '/' & !this.allTableItems[!i][2]
      endif
      if(!this.allTableItems[!i][3].substring(1,1) ne '/') then
          !this.allTableItems[!i][3] = '/' & !this.allTableItems[!i][3]
          !this.queryOption = 'NAMN'
      else
          !this.queryOption = 'NAME'
      endif
      !name = !this.allTableItems[!i][2]
      !spec = !this.allTableItems[!i][3]
      !dtext.append(!name)
      !rtext.append(!spec)
   enddo

   !this.comboTitem.dtext = !dtext
   !this.comboTitem.rtext = !rtext

endmethod
-- End of method definition for .retrieveComboTitem()

------------------------------------------------------------------------
--
-- Method:      .tableItemCallback()
--
-- Description: Callback event when comboTitem data is change
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tableItemCallback()
    if (!this.comboTitem.selection().trim() neq '') then
       if ( !this.selectedTableItem neq !this.comboTitem.selection()) then
          !this.clearTextGadget()
          !this.selectedTableItem = !this.comboTitem.selection('Dtext')
          !this.selectedRtextSpec = !this.comboTitem.selection('Rtext')
          !this.setTableItemToGadget()
       endif
    else
       if (!this.selectedTableItem neq !this.comboTitem.selection()) then
          !this.clearTextGadget()
       endif
    endif
    !this.selectedTableItem = !this.comboTitem.selection('Dtext')
endmethod
-- End of method definition for .tableItemCallback()

------------------------------------------------------------------------
--
-- Method:      SetTableItemToGadget()
--
-- Description: Set queried table item data to text gadget in Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTableItemToGadget()

   if (!this.debug) then
      WRITE |Running sftAssignModel.RetrieveSurface()|
   endif

   if (!this.purpose neq 'GENE') then
       !this.txtSpec.val = !this.selectedRtextSpec
   endif

   !gpart = !this.selectedTableItem.dbref().prtref
   if (!gpart.unset()) then
      !error = 'PRTREF of GPART(' + !this.selectedTableItem + ') is unset'
      !!alert.error(!error)
      return
   elseif (BADREF(!gpart)) then
      !error = 'PRTREF of GPART(' + !this.selectedTableItem + ') is BAD Reference'
      !!alert.error(!error)
      return
   endif

   !this.txtSymbolCode.val = !gpart.stcd
   !this.txtPunchCode.val = !gpart.pucd
   !this.surfaceRef  = !gpart.srftre

   if (!this.surfaceRef.unset()) then
      !error = 'SRFTRE of GPART(' + !gpart.string() + ') is unset'
      !!alert.error(!error)
      return
   elseif (BADREF(!this.surfaceRef)) then
      !error = 'SRFTRE of GPART(' + !gpart.string() + ') BAD Reference'
      !!alert.error(!error)
      return
   endif

endmethod
-- End of method definition for .setTableItemToGadget()


------------------------------------------------------------------------
--
-- Method:      .purposeCallback()
--
-- Description: Callback event when comboPurpose data for purpose is change
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .purposeCallback()

   if (!this.debug) then
      WRITE |Running sftAssignModel.RetrieveSurface()|
   endif

   if (!this.purpose neq '') then
      if ( !this.purpose eq !this.comboPurpose.selection()) then
         return
      endif
   endif

   !this.purpose = !this.comboPurpose.selection()

   if ((!this.purpose eq 'IPSP') or (!this.purpose eq 'OPSP')) then
     !this.paraspec.val = 'Specification'
     !this.txtSpec.active = TRUE
   elseif ( !this.purpose eq 'FACE') then
     !this.paraspec.val = 'Face Code'
     !this.txtSpec.active = TRUE
   else
     !this.paraspec.val = 'Unused field'
     !this.txtSpec.active = FALSE
   endif

   !this.clearComboTitem()

   !this.retrieveComboTitem()

endmethod
-- End of method definition for .purposeCallback()

------------------------------------------------------------------------
-- Method:      tableitemlist
--
-- Description: Show the all selected item list to new form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tableitemlist()

  if (!this.ngcSelected.getSelectedRowTags().unset()) then
    !!alert.error('No grid item selected')
    return FALSE
  endif
---- Make sure the form exists
  loadform !!sftShowList

---- Pass control to other form
  show !!sftShowList

endmethod
-- End of method tableitemlist()

------------------------------------------------------------------------
--
-- Method:      InitClear()
--
-- Description: Clear for Initialize
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initClear()

  !this.jobStatus = ''
  !this.surfaceTreat = object SURFACETREATMENT()
  !this.purpose = 'IPSP'
  !this.selectedTableItem = ''
  !this.selectedRtextSpec = ''
  !this.allTableItems = object ARRAY()
  !this.surfaceRef = object DBREF()
  !this.queryOption = ''
  !this.ngcSelected.clearGrid()

endmethod
-- End of method definition for .initClear()

------------------------------------------------------------------------
--
-- Method:      ClearComboTitem()
--
-- Description: Clear member variable when Table purpose is changed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearComboTitem()

   !this.selectedTableItem = ''
   !this.selectedRtextSpec = ''
   !this.allTableItems = object ARRAY()
   !this.surfaceRef = object DBREF()

   !this.clearTextGadget()

endmethod
-- End of method definition for .clearComboTitem()

------------------------------------------------------------------------
--
-- Method:      ClearTextGadget()
--
-- Description: Clear to only text gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearTextGadget()
   !this.txtSpec.val = ''
   !this.txtSymbolCode.val = ''
   !this.txtPunchCode.val = ''
endmethod
-- End of method definition for .clearTextGadget()
