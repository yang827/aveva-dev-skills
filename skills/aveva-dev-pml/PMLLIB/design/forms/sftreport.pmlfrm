--
--  Description:     Main form used in Design for Surface Treatment Report & Calculations
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToView()                      -                   Add selected element to graphic view
--  calculate()                      -                   Calculate the surface area
--  checkValidation(DBREF)           BOOLEAN             Checking the current elements type. allowed SITE or ZONE level
--  closeCallback()                  -                   Close CallBack Function
--  exportToExcel()                  -                   Save the grid data to Excel file
--  getCurrentElement()              -                   Getting current element and set it to para gadget
--  initialise()                     -                   Initialise form settings each time it is shown
--  popupHandler(ARRAY)              -                   When mouse right button click on grid control, shown the sub menu
--  printList()                      -                   Print the grid data
--  removeFromList()                 -                   Remove selected items from the displayed list
--  sftreport()                      -                   Constructor
--  updateDisplayedList(ARRAY)       -                   Update refresh data to grid control
--
------------------------------------------------------------------------
-- Form:      sftreport
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle (1000,0)
endhandle

import 'GridControl'
handle (1000,0)
endhandle

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

--- form definition
setup form !!sftreport dialog docking

-- Define titles and initialisation call
  !this.formTitle = 'Surface Treatment - Report'
  !this.iconTitle = 'Surface Treatment'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path right
  vdist 0.5

-- Framing for scope selection
  frame .frmScope   	'Scope Definition' 	at xmin ymax 					anchor T+L+R	width 80
    button    .btnce  'CE'           			at xmin form + 1 width 4
    para      .parace              				at xmax.btnce + 2     							width 50
    button    .btncal	'Calculate' tooltip 'Calculate'         at xmax.frmScope - 10 anchor T+R		width 8

  exit

  path down

-- Framing for gadget showing all elements selected
  frame .frmselected       'Selected Elements' at xmin.frmScope ymax anchor T+L+B+R width 80 height 20
    container .conSelected nobox PMLNetCONTROL 'NET' at xmin                     dock fill
  exit

-- define PML popup menu
  menu .mnupopup popup
  !this.mnupopup.add( 'CALLBACK', 'Add to 3D view','!this.addToView()', 'ADD3DVIEW' )
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Remove selected list in Grid','!this.removeFromList()', 'REMOVE')
  !this.mnupopup.add( 'CALLBACK', 'Remove all list in Grid','!this.ngcSelected.clearGrid()', 'REMOVEALL')
  !this.mnupopup.add( 'SEPARATOR' )
  !this.mnupopup.add( 'CALLBACK', 'Export to Excel...','!this.exportToExcel()', 'EXCEL' )
  !this.mnupopup.add( 'CALLBACK', 'Print Preview...','!this.printList()', 'PRINT' )

-- End of FORM definition

  member .ngcSelected         is  NETGRIDCONTROL
  member .headings            is ARRAY

  member .debug               is BOOLEAN

-- SFTGRIDDATA object for fill up the grid control
  member .sftgrid             is  SFTGRIDDATA

exit

------------------------------------------------------------------------
-- Method:      sftReport
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftreport()

-- Initialise Gadget Callbacks
  !this.btnce.callback = '!this.getCurrentElement()'
  !this.btncal.callback = '!this.calculate()'

-- set grid headings
  !this.headings.append('Index')
  !this.headings.append('Zone')
  !this.headings.append('Owner/Owner')
  !this.headings.append('Branch')
  !this.headings.append('Item')
  !this.headings.append('Type')
  !this.headings.append('Group')
  !this.headings.append('In/Out')
  !this.headings.append('Surface')
  !this.headings.append('SCD')
  !this.headings.append('PCD')
  !this.headings.append('Area')

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for selected elements
  !this.ngcSelected = object NETGRIDCONTROL()
  !this.conSelected.control = !this.ngcSelected.handle()

  !this.ngcSelected.addeventhandler('OnPopup', !this, 'PopupHandler')
  !this.conSelected.popup = !this.mnupopup

endmethod
-- End of method sftReport()


------------------------------------------------------------------------
-- Method:      initialise
--
-- Description: Initialise form settings each time it is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

 -- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSelected.columnExcelFilter(!t)
  !this.ngcSelected.outlookGroupStyle(!f)
  !this.ngcSelected.fixedHeaders(!f)
  !this.ngcSelected.fixedRows(!f)
  !this.ngcSelected.editableGrid(!f)
  !this.ngcSelected.singlerowselection(!f)
  !this.ngcSelected.headerSort(!t)
  !this.ngcSelected.columnsummaries(!t)
  !this.ngcSelected.setalternaterowcolor('lightgray')

-- All member variable set initialize
  !this.ngcSelected.clearGrid()

-- Getting current element
  !this.getCurrentElement()

endmethod
-- End of method initialise()


------------------------------------------------------------------------
-- Method:      calculate
--
-- Description: calculate the data grid by choosing a method based on user settings on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculate()

   if (!this.debug) then
    WRITE |Running sftreport.calculate()|
   endif

  if (!this.parace.val eq '') then
      !error = 'Click the CE Button without WORLD Level'
      !!alert.error(!error)
      return
  endif

  !this.sftgrid = object SFTGRIDDATA()

  -- current element type and ce
  !ceType = !this.parace.val.dbref().type
  !ce = !this.parace.val.dbref()

  -- Array for the insert to Grid Control
  !allGrid = object ARRAY()

  -- ce type is SITE or ZONE
  if ((!ceType eq 'SITE') or (!ceType eq 'ZONE')) then

     -- collect all zone list from site or zone
     !allZones = !!collectAllFor('ZONE','',!ce)

     -- ZONE Lists
     do !zone values !allZones

         -- collect all member of zone element
         !rtnArray = !this.sftgrid.getZoneMem(!zone)
         !allGrid.appendArray(!rtnArray)

     enddo

  -- ce type is EQUI or STRU
  elseif ((!ceType eq 'EQUI') or (!ceType eq 'STRU')) then
     !this.sftgrid.getZone(!ce)
     !rtnArray = !this.sftgrid.setEquiStruData(!ce)
     !allGrid.appendArray(!rtnArray)

  -- ce type is PIPE,HVAC and BRAN
  elseif ((!ceType eq 'PIPE') or (!ceType eq 'HVAC') or (!ceType eq 'BRAN')) then
     !this.sftgrid.getZone(!ce)
     !rtnArray = !this.sftgrid.setPipeHvacBran(!ce)
     !allGrid.appendArray(!rtnArray)

  -- ce type is Others
  else
     !type = object ARRAY()
     !type[1] = 'SITE'
     !type[2] = 'ZONE'
     !type[3] = 'PIPE'
     !type[4] = 'HVAC'
     !type[5] = 'EQUI'
     !type[6] = 'STRU'
     !type[7] = 'BRAN'

     -- searching the parent element as above array
     !parentCe = !!firstParent( !type, !ce)

     if (!parentCe.unset()) then
          -- Error
         !error = 'The parent of the current element must be of type SITE, ZONE, PIPE, HVAC, EQUI, STRU or BRAN.'
         !!alert.error(!error)
         return

     -- searching parent element is SITE or ZONE
     elseif ((!parentCe.type eq 'SITE') or (!parentCe.type eq 'ZONE')) then
         !allZones = !!collectAllFor('ZONE','',!parentCe)
         do !zone values !allZones
            !rtnArray = !this.sftgrid.getZoneMem(!parentCe)
            !allGrid.appendArray(!rtnArray)
         enddo

     else
         !this.sftgrid.getZone(!parentCe)

         -- searching parent element is EQUI or STRU
         if ((!parentCe.type eq 'EQUI') or (!parentCe.type eq 'STRU')) then
              !rtnArray = !this.sftgrid.setEquiStruData(!parentCe)

         -- searching parent element is PIPE,HVAC or BRAN
         else
              !rtnArray = !this.sftgrid.setPipeHvacBran(!parentCe)

         endif
         !allGrid.appendArray(!rtnArray)

     endif
  endif

  -- Leading zero index
  !width = !allGrid.size().string().length().string()
  -- Index the rows
  do !i indices !allGrid
    !allGrid[!i][1] = !i.string('I' & !width)
  enddo

  !this.updateDisplayedList(!allGrid)

endmethod
-- End of method definition for .calculate()


------------------------------------------------------------------------
-- Method:      removeFromList
--
-- Description: Remove selected items from the displayed list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeFromList()

   !this.ngcSelected.deleteSelectedRows()

endmethod
-- End of method removeFromList()

------------------------------------------------------------------------
-- Method:      UpdateDisplayedList
--
-- Description: Update the displayed data with the supplied array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateDisplayedList(!arrData is ARRAY)

   if (!this.debug) then
    WRITE |Running sftreport.updateDisplayedList()|
   endif

-- setup controls for PML containers
   using namespace 'Aveva.Pdms.Presentation'

-- update Area heading to show current units
   do !index indices !this.headings
     skip if(!this.headings[!index].match('AREA') eq 0)
     !testArea = 1 sq mm
     !this.headings[!index] = 'AREA (' + !testArea.units().unitQualifier() + ')'
     break
   enddo

-- Bind example data to grid
   !nds = object NETDATASOURCE('Selected elements', !this.headings, !arrData)
   !this.ngcSelected.bindToDataSource(!nds)

endmethod
-- End of method UpdateDisplayedList()

------------------------------------------------------------------------
--
-- Method:      PopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupHandler(!data is ARRAY)

	!active = (!this.ngcSelected.getRows().size() neq 0)
	
	!this.mnupopup.setFieldProperty('ADD3DVIEW', 'active', !active )
	!this.mnupopup.setFieldProperty('REMOVE', 'active', !active )
	!this.mnupopup.setFieldProperty('REMOVEALL', 'active', !active )
	!this.mnupopup.setFieldProperty('EXCEL', 'active', !active )
	!this.mnupopup.setFieldProperty('PRINT', 'active', !active )

  !this.conSelected.showPopup(!data[0], !data[1])

endmethod
-- End of method definition for .popupHandler()

------------------------------------------------------------------------
--
-- Method:      PrintList()
--
-- Description: Print preview the grid data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printList()

  if (!this.ngcSelected.getNumberRows().neq(0)) then
    !this.ngcSelected.printPreview()
  else
    !!alert.error('No data to print')
  endif

endmethod
-- End of method definition for .printList()

------------------------------------------------------------------------
--
-- Method:      .exportToExcel()
--
-- Description: Save the grid data to Excel file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exportToExcel()

  if (!this.ngcSelected.getNumberRows().eq(0)) then
    !!alert.error('No data to save')
    return
  endif

  using namespace 'AVEVA.PDMS.Presentation'
  !browser = object PMLFILEBROWSER('SAVE')

-- Default to first location from PDMSUSER evar
  !pdmsuser = !!evarSplit('PDMSUSER')
  !directory = !pdmsuser[1]

  !seedFile = 'SurfaceTreatmentData'
  !title = 'Save Surface Treatment Data As'
  !existFlag = FALSE
  !filter = 'Microsoft Excel Files (*.xls)|*.xls'
  !filterIndex = 1

-- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

-- Set selected file
  !saveFile = object FILE( !browser.file() )

  if ( !saveFile.set() ) then
    !this.ngcSelected.saveGridToExcel(!saveFile.string())
    handle (1000,0)
      !!alert.error('Could not write file: ' + !saveFile.string() + ' - ' + !!error.text )
    elsehandle none
      !!alert.message('File saved: ' + !saveFile.string() )
    endhandle
  endif

endmethod
-- End of method definition for .exportToExcel()


------------------------------------------------------------------------
-- Method:      checkValidation
--
-- Description: checking the current elements type. System does not allowed WORLD level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkValidation(!dbref is DBREF) is BOOLEAN

  if (!this.debug) then
      WRITE |Running sftreport.checkValidation()|
  endif

    if (!dbref.type eq 'WORL') then
        return FALSE
    else
        return TRUE
    endif

endmethod
-- End of method checkValidation()

------------------------------------------------------------------------
-- Method:      getCurrentElement
--
-- Description: get and set Current Element to para gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCurrentElement()

  if (!this.debug) then
      WRITE |Running sftreport.getCurrentElement()|
  endif

   if (NOT !this.checkValidation(!!ce)) then
      !error = 'Current Element does not allow WORL Level'
      !!alert.error(!error)
      !this.parace.val = ''
      return
   endif
   !this.parace.val = !!ce.name

endmethod
-- End of method getCurrentElement()


------------------------------------------------------------------------
--
-- Method:      .closeCallback()
--
-- Description: Close CallBack Function
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .closeCallback()
  if (!this.debug) then
      WRITE |Running sftreport.closeCallback()|
  endif

  !this.sftgrid.unset()

  kill !!sftreport

endmethod
-- End of method definition for .closeCallback()

------------------------------------------------------------------------
--
-- Method:      AddToView()
--
-- Description: Display the selected item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToView()

  if (!this.debug) then
      WRITE |Running sftreport.addToView()|
  endif

-- If standard view is set then update it otherwise gracefully ignore this
  if ( !!gphviews.views.set() ) then
    UNENHANCE ALL
    !itemList = object ARRAY()
    do !idx index !this.ngcSelected.getSelectedRowTags()
       !itemList.append(!this.ngcSelected.getSelectedRows()[!idx][5].dbref())
-- Update the relevant grid cell with the new value
    enddo

    do !i values !!gphDrawLists.drawLists
      !i.addMembers(!itemList)
    enddo

$(  $P comment out as causes the view to jump around unexpectedly
    !volume   = object VOLUME(!itemList)
    !from     = !volume.from
    !to       = !volume.to
    !midPoint = !from.midPoint(!to)
    !through[1] = !midPoint.east
    !through[2] = !midPoint.north
    !through[3] = !midPoint.up
    -- find the current selected view
    !fmsys = object FMSYS()
    !form  = !fmsys.currentDocument()
    !form.view.through = !through
$)
  else
    if (!this.debug) then
      WRITE |Skipped update of graphical view sftreport.addToView()|
    endif
  endif

  return

endmethod
-- End of method definition for .addToView()
