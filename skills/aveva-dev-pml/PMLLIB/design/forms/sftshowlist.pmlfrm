import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.Pdms.Presentation'
	
------------------------------------------------------------------------
-- Form:      sftShowList
------------------------------------------------------------------------

--setup form !!sftShowList dialog docking size 60 20
layout form !!sftShowList dialog docking

-- Define titles and initialisation call
   !this.formTitle = 'Surface Treatment - Selection'
   !this.iconTitle = 'Surface Treatment - Selection'
   !this.initcall  = '!this.initialise()'

   hdist 1
   halign centre
   path down
   vdist 0.5
   path right
   frame .frmCondition                                                                                                width 60
    para      .paraPurp               at xmin.frmCondition + 1.5   ymin.frmCondition      text 'Table group'          width 8
    comboBox  .comboPurpose           at xmax.paraPurp + 0.5       ymin.paraPurp          tooltip 'Purpose of TABGRO' width 6
    para      .paraTitem              at xmax.comboPurpose + 3     ymin.paraPurp          text 'Table item'           width 7
    comboBox  .comboTitem             at xmax.paraTitem            ymin.paraPurp          scroll 50                   width 25
    para      .paraSpec               at xmin.frmCondition + 1.5   ymax.paraPurp + 0.5    text 'Specification'        width 10
    text      .txtSpec                at xmax.paraSpec - 1.5       ymin.paraSpec                                      width 8 is STRING
    para      .paraScd                at xmax.txtSpec + 1.5        ymin.paraSpec          text 'Symbol Code'          width 8.5
    text      .txtSymbolCode          at xmax.paraScd              ymin.paraSpec                                      width 8 is STRING
    para      .paraPcd                at xmax.txtSymbolCode + 1.5  ymin.paraSpec          text 'Punch Code'           width 8.5
    text      .txtPunchCode           at xmax.paraPcd - 0.5        ymin.paraSpec                                      width 8 is STRING
    para      .paraSrftrt             at xmin.frmCondition + 1     ymax.txtSpec + 0.5     text 'SurfaceTreat'         width 9
    text      .txtSrftrt              at xmax.paraSrftrt           ymin.paraSrftrt                                    width 16 is STRING
    para      .paraSurmat             at xmax.txtSrftrt + 1.5      ymin.paraSrftrt        text 'Material'
    text      .txtSurmat              at xmax.paraSurmat - 2       ymin.paraSrftrt                                    width 22 is STRING
    para      .paraShopPri            at xmin.frmCondition + 1.5   ymax.txtSrftrt + 0.5   text ' Shop Primer'         width 8
    text      .txtShopPri             at xmax.paraShopPri + 0.5    ymin.paraShopPri                                   width 5 is STRING
    para      .paraSurprep            at xmax.txtShopPri + 1.5     ymin.paraShopPri       text 'Preparation'          width 8
    text      .txtSurprep             at xmax.paraSurprep          ymin.paraShopPri                                   width 31 is STRING
   exit

   frame .frmSurfTreatList  'Coating Lists'  at xmin form                ymax + 0.5  width 60 height 10
     container .conSelCoatingGrid PMLNetCONTROL 'NET'   at xmin                     ymin + 0.5  dock fill
   exit

   path right

   --button .btnOK         ' Apply '                     at xmin form + 0.5          ymax + 0.5  CALLBACK '!this.Apply()'
   button .btnInside     ' Inside'                     at xmin form + 0.5   ymax + 0.5    width 10                    CALLBACK '!this.setInside()'
   button .btnOutside    'Outside'                     at xmax.btnInside + 1              width 10                    CALLBACK '!this.setOutside()'
   button .btnBoth       '  Both '                     at xmax.btnOutside + 1             width 10                    CALLBACK '!this.setBoth()'
   button .btnClear      ' Clear '                     at xmax.btnBoth + 1                width 10                    CALLBACK '!this.initClear()'
   button .btnCANCEL     'Dismiss'                     at xmax.btnClear + 1               width 10                    CANCEL

-- End of FORM definition

-- Define member variables
   member .ngcSelCoatingList   is  NETGRIDCONTROL
   member .coatingHeadings     is  ARRAY

   member .debug               is  BOOLEAN

-- SURFACETREATMENT object
  member .surfaceTreat         is  SURFACETREATMENT

-- Purpose of TABGROUP
  member .purpose              is STRING

-- Selected table item on comboTitem
  member .selectedTableItem    is STRING

-- Rtext of selected table item on comboTitem
  member .selectedRtextSpec    is STRING

-- Data of selection Table item below CTABLE
  member .allTableItems        is ARRAY

-- SRFTREF data of GPART
  member .surfaceRef           is DBREF

-- comboBox Value and text Value
  member .comboArray           is ARRAY
  member .codeArray            is ARRAY
exit


------------------------------------------------------------------------
--
-- Method:      sftShowList
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftShowList()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for PAINT
  !this.ngcSelCoatingList = object NETGRIDCONTROL()
  !this.conSelCoatingGrid.control = !this.ngcSelCoatingList.handle()

endmethod
-- End of method definition for .sftShowList()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  if (!this.debug) then
    WRITE |Running sftshowlist.initialise()|
  endif

  !dtext = ARRAY()
  !dtext.append('IPSP')
  !dtext.append('OPSP')
  !dtext.append('FACE')
  !dtext.append('GENE')

  !this.comboPurpose.dtext = !dtext

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Setup the display grid headings
  !this.coatingHeadings[1] = 'DESCRIPTION'
  !this.coatingHeadings[2] = 'MAKER'

    if (!!isImperialLength('DIST')) then
      !this.coatingHeadings[3] = 'THICKNESS (MIL)'
    else
      !this.coatingHeadings[3] = 'THICKNESS (MICRONS)'
    endif

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSelCoatingList.columnExcelFilter(!f)
  !this.ngcSelCoatingList.outlookGroupStyle(!f)
  !this.ngcSelCoatingList.fixedHeaders(!f)
  !this.ngcSelCoatingList.fixedRows(!f)
  !this.ngcSelCoatingList.editableGrid(!f)
  !this.ngcSelCoatingList.singlerowselection(!t)
  !this.ngcSelCoatingList.setAlternateRowColor('lightGray')

-- Remove any previous selection
  !this.ngcSelCoatingList.clearrowselection()

  !this.txtSpec.editable = !f
  !this.txtSymbolCode.editable = !f
  !this.txtPunchCode.editable = !f
  !this.txtSrftrt.editable = !f
  !this.txtSurmat.editable = !f
  !this.txtShopPri.editable = !f
  !this.txtSurprep.editable = !f

  !this.comboPurpose.callback = '!this.purposeCallback()'
  !this.comboTitem.callback = '!this.tableItemCallback()'

-- All member variable set initialize
  !this.initClear()
  --!this.setDataToArray()

endmethod
-- End of method definition for .initialise()


------------------------------------------------------------------------
--
-- Method:      SetInside()
--
-- Description: Take user selection in list and set as Inside value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setInside()

  if (!this.debug) then
      WRITE |Running sftshowList.setInside()|
  endif

  !this.setDataToArray()

  if (!!sftassignmodel.shown()) then
      !!sftassignmodel.updateTextGadget(!this.comboArray, !this.codeArray, !this.surfaceRef, 'IN')
  endif
endmethod
-- End of method definition for .setInside()


------------------------------------------------------------------------
--
-- Method:      SetOutside()
--
-- Description: Take user selection in list and set as Outside value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOutside()

   if (!this.debug) then
      WRITE |Running sftshowlist.setOutside()|
   endif

   !this.setDataToArray()

   if (!!sftassignmodel.shown()) then
       !!sftassignmodel.updateTextGadget(!this.comboArray, !this.codeArray, !this.surfaceRef, 'OU')
   endif

endmethod
-- End of method definition for .setOutside()

------------------------------------------------------------------------
--
-- Method:      SetBoth()
--
-- Description: Take user selection in list and set as Inside/Outside value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBoth()

  if (!this.debug) then
      WRITE |Running sftshowList.setBoth()|
  endif

  !this.setDataToArray()

  if (!!sftassignmodel.shown()) then
      !!sftassignmodel.updateTextGadget(!this.comboArray, !this.codeArray, !this.surfaceRef, 'BOTH')
  endif

endmethod
-- End of method definition for .setBoth()

------------------------------------------------------------------------
--
-- Method:      SetDataToArray()
--
-- Description: Set Data to member variable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDataToArray()

  if (!this.debug) then
      WRITE |Running sftshowList.setDataToArray()|
  endif

  if (!this.comboTitem.selection('Rtext').trim() eq '' ) then
      !this.surfaceRef = object DBREF()
  endif

  !this.comboArray = object ARRAY()
  !this.codeArray = object ARRAY()

  !this.comboArray.append(!this.comboPurpose.selection('Rtext'))
  !this.comboArray.append(!this.comboTitem.selection('Dtext'))
  !this.comboArray.append(!this.comboTitem.selection('Rtext'))

  !this.codeArray.append(!this.txtSymbolCode.val.trim())
  !this.codeArray.append(!this.txtPunchCode.val.trim())

endmethod
-- End of method definition for .setBoth()

------------------------------------------------------------------------
--
-- Method:      .purposeCallback()
--
-- Description: Callback event when comboPurpose data for purpose is change
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .purposeCallback()

    if (!this.debug) then
      WRITE |Running sftshowList.purposeCallback()|
    endif

    if (!this.purpose neq '') then
       if ( !this.purpose eq !this.comboPurpose.selection()) then
          return
       endif
    endif

    !this.purpose = !this.comboPurpose.selection()
    if (( !this.purpose eq 'IPSP') or  ( !this.purpose eq 'OPSP')) then
      !this.paraSpec.val = 'Specification'
      !this.txtSpec.active = TRUE
    elseif ( !this.purpose eq 'FACE') then
      !this.paraSpec.val = 'Face Code'
      !this.txtSpec.active = TRUE
    else
      !this.paraSpec.val = 'Unused field'
      !this.txtSpec.active = FALSE
    endif

    !this.clearComboTitem()
    !this.retrieveComboTitem()
    !this.setDataToArray()

endmethod
-- End of method definition for .purposeCallback()

------------------------------------------------------------------------
--
-- Method:      .tableItemCallback()
--
-- Description: Callback event when comboTitem data is change
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tableItemCallback()

   if (!this.debug) then
      WRITE |Running sftshowList.tableItemCallback()|
   endif

    if (!this.comboTitem.selection().trim() neq '') then
       if ( !this.selectedTableItem neq !this.comboTitem.selection()) then
          !this.clearTextGadget()
          !this.selectedTableItem = !this.comboTitem.selection('Dtext')
          !this.selectedRtextSpec = !this.comboTitem.selection('Rtext')
          !this.setTableItemToGadget()
       endif
    else
       if (!this.selectedTableItem neq !this.comboTitem.selection()) then
          !this.clearTextGadget()
       endif
    endif
    !this.selectedTableItem = !this.comboTitem.selection('Dtext')
    --!this.setDataToArray()
endmethod
-- End of method definition for .tableItemCallback()

------------------------------------------------------------------------
--
-- Method:      RetrieveComboTitem()
--
-- Description: Retrieve Table items below Table group and assign it to dtext and rtext of comboTitemShow
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .retrieveComboTitem()

   if (!this.debug) then
      WRITE |Running sftshowList.retrieveComboTitem()|
   endif

   !para = |'| + !this.purpose + |'|

-- Getting all TABGROUP with purpose
   !this.surfaceTreat.getTablegroup(!para)
   !allTabGroup = !this.surfaceTreat.tableGroup

   if (!allTabGroup.unset() OR !allTabGroup.size().eq(0)) then
      !error = 'TABGRO element (PURP=' + $!this.purpose + ') does not exists'
      !!alert.error(!error)
      return
   endif

-- Getting all TABITEM below TAQBGROUP
   !this.surfaceTreat.getTableItems(!allTabGroup)
   !this.allTableItems = !this.surfaceTreat.tableItems

   if (!this.allTableItems.unset() OR !this.allTableItems.size().eq(0)) then
      !!alert.error('TABITE element does not exist')
      return
   endif

   !dtext = object ARRAY()
   !rtext = object ARRAY()

   !this.allTableItems.sort()

   !dtext.append('')
   !rtext.append('')

   do !i index !this.allTableItems
      if(!this.allTableItems[!i][2].subString(1,1) ne '/') then
          !this.allTableItems[!i][2] = '/' & !this.allTableItems[!i][2]
      endif
      if(!this.allTableItems[!i][3].subString(1,1) ne '/') then
          !this.allTableItems[!i][3] = '/' & !this.allTableItems[!i][3]
      endif
      !name = !this.allTableItems[!i][2]
      !spec = !this.allTableItems[!i][3]
      !dtext.append(!name)
      !rtext.append(!spec)
   enddo

   !this.comboTitem.dtext = !dtext
   !this.comboTitem.rtext = !rtext

endmethod
-- End of method definition for .retrieveComboTitem()

------------------------------------------------------------------------
--
-- Method:      SetTableItemToGadget()
--
-- Description: Show spec data to combo box from catalogue database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTableItemToGadget()

   if (!this.debug) then
      WRITE |Running sftshowList.RetrieveSpecList()|
   endif

   using namespace 'Aveva.Pdms.Presentation'

   if (!this.purpose neq 'GENE') then
       !this.txtSpec.val = !this.selectedRtextSpec
   endif

   !gpart = !this.selectedTableItem.dbref().prtref
   if (!gpart.unset()) then
      !error = 'PRTREF of TABITEM(' + !this.selectedTableItem + ') is unset'
      !!alert.error(!error)
      return
   elseif (BADREF(!gpart)) then
      !error = 'PRTREF of TABITEM(' + !this.selectedTableItem + ') is BAD Reference'
      !!alert.error(!error)
      return
   endif

   !this.txtSymbolCode.val = !gpart.stcd
   !this.txtPunchCode.val = !gpart.pucd
   !this.surfaceRef  = !gpart.srftre

   if (!this.surfaceRef.unset()) then
      !error = 'SRFTRE of GPART(' + !gpart.string() + ') is unset'
      !!alert.error(!error)
      return
   elseif (BADREF(!this.surfaceRef)) then
      !error = 'SRFTRE of GPART(' + !gpart.string() + ') is BAD Reference'
      !!alert.error(!error)
      return
   endif

   !this.txtSrftrt.val = !this.surfaceRef.name
   !this.txtSurmat.val = !this.surfaceRef.surmat

   !this.txtShopPri.val = !this.surfaceRef.shopri.string()
   !this.txtSurprep.val = !this.surfaceRef.surpre

   !this.surfaceTreat.getCoatingList(!this.surfaceRef)
   !coatingList = !this.surfaceTreat.coatingList

-- Bind example data to grid
  !nds = object NETDATASOURCE('Selected Coatings', !this.coatingHeadings, !coatingList)
  !this.ngcSelCoatingList.bindToDataSource(!nds)

-- Set to member variable for send it to main form
  --!this.setDataToArray()

endmethod
-- End of method definition for .setTableItemToGadget()

------------------------------------------------------------------------
--
-- Method:      ClearTextGadget()
--
-- Description: Clear Text gadget value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearTextGadget()

  if (!this.debug) then
     WRITE |Running sftshowList.clearTextGadget)|
  endif

   !this.txtSpec.val = ''
   !this.txtSymbolCode.val = ''
   !this.txtPunchCode.val = ''
   !this.txtSrftrt.val = ''
   !this.txtSurmat.val = ''
   !this.txtShopPri.val = ''
   !this.txtSurprep.val = ''
   !this.ngcSelCoatingList.clearGrid()
endmethod
-- End of method definition for .clearTextGadget()

------------------------------------------------------------------------
--
-- Method:      ClearComboTitem()
--
-- Description: Clear member variable when Table purpose is changed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearComboTitem()

  if (!this.debug) then
     WRITE |Running sftshowList.clearComboTitem)|
  endif
   !this.selectedTableItem = ''
   !this.selectedRtextSpec = ''
   !this.allTableItems = object ARRAY()
   !this.surfaceRef = object DBREF()

   !this.clearTextGadget()

endmethod
-- End of method definition for .clearComboTitem()

------------------------------------------------------------------------
--
-- Method:      InitClear()
--
-- Description: Clear for Initialize
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initClear()

  if (!this.debug) then
      WRITE |Running sftshowList.initClear()|
  endif
  !this.purpose = 'IPSP'
  !this.surfaceTreat = object SURFACETREATMENT()
  !this.comboPurpose.select('Rtext','IPSP')
  !this.comboArray = object ARRAY()
  !this.codeArray = object ARRAY()
  !this.paraSpec.val = 'Specification'
  !this.txtSpec.active = TRUE

  !this.clearComboTitem()
  !this.retrieveComboTitem()

endmethod
-- End of method definition for .initClear()
