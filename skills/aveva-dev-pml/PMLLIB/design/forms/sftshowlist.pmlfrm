--
-- Description:     Select surface treatment from a list of available values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearComboTitem()                -
--  clearTextGadget()                -
--  initClear()                      -
--  initialise()                     -
--  purposeCallback()                -                   Callback event when comboPurpose data for purpose is change
--  retrieveComboTitem()             -
--  setBoth()                        -
--  setDataToArray()                 -
--  setInside()                      -
--  setOutside()                     -
--  setTableItemToGadget()           -
--  sftShowList()                    -
--  tableItemCallback()              -                   Callback event when comboTitem data is change
