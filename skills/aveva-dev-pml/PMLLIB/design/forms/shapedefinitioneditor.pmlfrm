------------------------------------------------------------------------
--
-- Method:      polygon
--
-- Description: Define a polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .polygonOriginChange(!gadget is GADGET, !select is STRING)
  !this.originChange(!this.po.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      polygon
--
-- Description: Define a polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .polygon()

  -- Don't allow unset value
  if(!this.polygon2.val.set().not() ) then
    !!alert.warning('Size of polygon must be set.')
    !this.polygon2.val = 5000.0
  endif
  -- Get rectangle
  !this.polygondimtype(!this.polygon1.val)
  !this.shape.polygon(!this.polygon1.val, !this.polygon2.val, !this.polygondimtype.selection('RTEXT'))
  !this.originChange(!this.po.val)
  !this.shape.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      polydimtype
--
-- Description: Set number of sides and permissible dimension type of polygon
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Number of sides
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .polygondimtype(!passedSides is REAL)

  -- Initialise Variables
  !sides            = !passedSides
  -- Don't allow unset value
  if(!sides.set().not() ) then
    !!alert.warning('Number of edges must be set.')
    !this.polygon1.val = 3
    !sides          = 3
  endif

  -- Don't allow values less than 3
  if(!sides le 2) then
    !!alert.warning('Number of edges must be greater than 2.')
    !this.polygon1.val = 3
    !sides          = 3
  endif

  -- Even number
  !even      = (!sides / 2 - int(!sides / 2)) eq 0

  -- Odd/even
  if(!even) then
    !dtext[1] = 'Distance across faces'
    !rtext[1] = 'faces'
    !dtext[2] = 'Distance across corners'
    !rtext[2] = 'corners'
    !dtext[3] = 'Length of edges'
    !rtext[3] = 'edges'
  else
    !dtext[1] = 'Distance across corners'
    !rtext[1] = 'corners'
    !dtext[2] = 'Length of edges'
    !rtext[2] = 'edges'
  endif

  -- Determine if we need to build the list
  if(!this.polygondimtype.dtext.size() eq !dtext.size()) then
    return
  endif

  -- Current selection
  !selection = !this.polygondimtype.selection()
  if(!selection.empty()) then
    !selection = !dtext[1]
  endif

  -- Define options
  !this.polygondimtype.dtext = !dtext
  !this.polygondimtype.rtext = !rtext

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectOriginChange
--
-- Description: Define a rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rectOriginChange(!gadget is GADGET, !select is STRING)
  !this.originChange(!this.ro.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lshapeOriginChange
--
-- Description: Define a rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lshapeOriginChange(!gadget is GADGET, !select is STRING)

  !this.originChange(!this.lo.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      originChange
--
-- Description: change the origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .originChange(!originNumber is REAL)

  if !this.shapeList.val.eq(1) then
    !this.shape.rectangle(!this.rectanglex.val, !this.rectangley.val)
  elseif !this.shapeList.val.eq(2) then

    if (!this.shape.derived) then
      !this.shape.lshape(!this.lshapealt.val)
    else
      !x = !this.lshapex1.val
      !y = !this.lshapey1.val
      if (!this.shape.description.unset()) then

        !this.shape.lshape(!this.lshapex1.val, !this.lshapex2.val, !this.lshapey1.val, !this.lshapey2.val)

      elseif (!this.shape.description eq 'L shape derived from 3 points' or !this.shape.description eq 'L Shape X: ' & !x.string(!!distanceFmt) & ' Y: ' & !y.string(!!distanceFmt) ) then
        if (!this.lshapealt.val eq 1) then
          !this.lshapeProfileArray[1].position = !this.shape.profile.position
          !this.shape.profile = !this.lshapeProfileArray[1]
        else
          !this.lshapeProfileArray[2].position = !this.shape.profile.position
          !this.shape.profile = !this.lshapeProfileArray[2]
        endif
        !this.shape.originPosition = !this.shape.profile.position
        !this.shape.description = 'L Shape X: ' & !x.string(!!distanceFmt) & ' Y: ' & !y.string(!!distanceFmt)
      endif
    endif

  elseif !this.shapeList.val.eq(3) then
--    circle
  elseif !this.shapeList.val.eq(4) then
      !this.shape.freeform(!this.elearray)
  elseif !this.shapeList.val.eq(5) then
--    polygon
  endif

  !this.shapemodifier.shapemodifier(!this.shape.profile)
  handle ANY
    -- cannot modify shape for origin change
    return
  endhandle

  !arrayOfOrigins = !this.shapemodifier.alternativeOrigins()
  if !originNumber.gt(!arrayOfOrigins.size()) then
    !!alert.warning('Origin point specified is greater than number of possible origin points on current shape')
    return
  endif

  if !this.shape.derived then

    if !originNumber.neq(0) then

      !profileArray = !this.shape.profile.edges()
      !profileOri = !this.shape.profile.orientation
      !newProfile = object PROFILE(!arrayOfOrigins[!originNumber], !profileOri, !profileArray)
      !this.shape.profile.position = !arrayOfOrigins[!originNumber]
      !this.shape.profile = !newProfile
      !this.shape.originPosition = !arrayOfOrigins[!originNumber]

    else

      !profileArray = !this.shape.profile.edges()
      !profileOri = !this.shape.profile.orientation
      !newProfile = object PROFILE(!this.shape.originalOrigin, !profileOri, !profileArray)
      !this.shape.profile.position = !this.shape.originalOrigin
      !this.shape.profile = !newProfile
      !this.shape.originPosition = !this.shape.originalOrigin
    endif
  else

    if !originNumber.neq(0) then

      --calculate x and y positions to offset shape by
      !xyposition = !this.shape.plane.xyoffset(!arrayOfOrigins[!originNumber])

      !x = !xyposition.x
      !y = !xyposition.y

      !this.shape.profile.translate(!x * -1,!y * -1)

    else

      !this.shape.profile = !this.shape.originalNonDerivedProfile

    endif

  endif

  !this.shape.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateShape
--
-- Description: update the shape with present definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateShape()
  --set relevant task pane active
  if !this.shapeList.val.eq(1) then
    !this.rectangle()
  elseif !this.shapeList.val.eq(2) then
    !this.lshape()
  elseif !this.shapeList.val.eq(3) then
    !this.circle()
  elseif !this.shapeList.val.eq(4) then
    !this.freeform()
  elseif !this.shapeList.val.eq(5) then
    !this.polygon()
  endif

endmethod
