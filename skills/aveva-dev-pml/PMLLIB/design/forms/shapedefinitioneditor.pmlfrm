  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.polygonTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.polygonTasks(false)')

