--
-- Description:
--    Basic shape definition form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  circle()                         -                   Define a circle
--  circleOriginChange(GADGET,STRING) -
--  circleTasks(BOOLEAN)             -                   Set freeform tasks
--  circlefromcentandrad(ARRAY)      -                   Define circle from centre and radius points
--  circlepickcentandrad()           -                   EDG pick for circle centre and radius points
--  clearVariables()                 -                   clear variables
--  dismiss()                        -                   Dismiss form
--  freeform()                       -                   Define a freeform picked shape
--  freeformOriginChange(GADGET,STRING) -
--  freeformPickPoints()             -                   Free form point picks to define shape
--  freeformPickPoints(POSITION)     -                   Free form point picks to define shape
--  freeformTasks(BOOLEAN)           -                   Set freeform tasks
--  getLshapePicks(EDGPOSITIONDATA)  -                   gather the 3 picks for lshape
--  lShapeRectangle(ARRAY)           -                   draw the lshape outer rectangle
--  lshape()                         -                   Define an L Shape
--  lshape(GADGET,STRING)            -                   Define an L Shape
--  lshape3pnts(ARRAY)               -                   Define an L shape from 3 passed points
--  lshapeCreate()                   -                   define the lshape room boundary
--  lshapeDimensions()               -                   Set correct lshape dimensions to correct lshape solution
--  lshapeMirror()                   -
--  lshapeModify()                   -                   modify an L Shape
--  lshapeOriginChange(GADGET,STRING) -                   Define a rectangle
--  lshapeTasks(BOOLEAN)             -                   Set lshape tasks
--  lshapealtchange(GADGET,STRING)   -                   Change to alternative Lshapes
--  originChange(REAL)               -                   Define a rectangle
--  pickLshape()                     -                   pick the lshape inner corner with 3rd pick
--  pickLshapeRectangle()            -
--  pickRectangle()                  -                   pick two opposite corner points to derive a rectangle
--  polygon()                        -                   Define a polygon
--  polygonOriginChange(GADGET,STRING) -
--  polygonTasks(BOOLEAN)            -                   Set polygon tasks
--  polygondimtype(REAL)             -
--  rectOriginChange(GADGET,STRING)  -                   Define a rectangle
--  rectangle()                      -                   Define a rectangle
--  rectangle(GADGET,STRING)         -                   Define a rectangle
--  rectangle2pnts(ARRAY)            -                   Define a rectangle from 2 passed corner points
--  rectangleTasks(BOOLEAN)          -                   Set rectangle tasks
--  selectShape()                    -
--  setup(FORM,STRING,STRING,STRING,SHAPEDEFINITION) -                   Form setup
--  shapeDefinitionEditor()          -                   Constructor
--  updateShape()                    -                   update the shape with present definition
--

setup form !!shapeDefinitionEditor dialog docking right

  !this.formTitle     = 'Shape definition'
  !this.iconTitle     = 'Shapes'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '

  option .shapeList 'Shapes:'       anchor top + left + right         at x0                       y0                  call '!this.selectShape()'             width 20

  frame .rectangleTaskPane panel    anchor top + left + right         at xmin.shapeList           ymax.shapeList

    para .rectanglepara             anchor top + left + right         at x0.5                     ymax                text 'Dimensions'
    line .rectL1                    anchor top + left + right         at x0                       ymax                horizontal width 32

    paragraph .rectanglePixmap      anchor top + left + right         at x4                       ymax                pixmap width 200 height 200

    valign centre
    text .rectangley                anchor top + left                 at x1                       y4.2                  callback '!this.rectangle('  width 8 is REAL format !!distanceFmt
    text .rectanglex                anchor top + left                 at x16.2                    ymax.rectanglePixmap  callback '!this.rectangle('  width 8 is REAL format !!distanceFmt

    para .rectOriginpara            anchor top + left + right         at x0.5                     ymax text 'Origin'
    line .rectL2                    anchor top + left + right         at x0                       ymax                horizontal width 32

    numericinput .ro 'Origin point:' tagwidth 13 at x2   ymax+0.2        callback '!this.rectOriginChange('  range 0 4  ndp 0  width 4

    para .rectanglepickpara                anchor top + left               at x0.5                     ymax+0.2 text 'Derive Methods'
    line .rectL3                    anchor top + left + right         at x0                     ymax                horizontal width 32

    button .pickpointsrectbutton1 linkLabel 'Pick Corner Points' at xmin.rectanglepickpara+1 ymax callback '!this.pickRectangle()'

    paragraph .rectacceptIcon           anchor top + left                 at x0                     ymax+0.2          pixmap width 16 height 16
    button .rectaccept  linkLabel 'Accept Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.apply()' width 16
    paragraph .rectdismissIcon           anchor top + left                 at x0                     ymax+0.2          pixmap width 16 height 16
    button .rectdismiss linkLabel 'Return'           anchor top + left + right      at xmax+0.5            ymin               callback '!this.dismiss()' width 20

  exit

  frame .freeformTaskPane panel                   anchor top + left + right       at xmin.shapeList       ymax.shapeList
    para .freeformPara                anchor top + left               at x0                     ymax text 'Pick Methods'

    line .freeformL1                    anchor top + left + right         at x0                     ymax                horizontal width 32

    button .pickpointsfreeformbutton1 linkLabel 'Pick Points' at xmin.rectanglepickpara+1 ymax callback '!this.freeformPickPoints()'

    para .lshapeoripara                anchor top + left               at x0.5                     ymax+0.2 text 'Origin'
    line .freeformL2                    anchor top + left + right         at x0                     ymax                horizontal width 32

    numericinput .fo 'Origin:' tagwidth 5 at x2   ymax+0.2        callback '!this.freeformOriginChange(' ndp 0   width 4

    paragraph .freeformacceptIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .freeformaccept  linkLabel 'Accept Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.apply()' width 16
    paragraph .freeformdismissIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .freeformdismiss linkLabel 'Return'           anchor top + left + right      at xmax+0.5            ymin                callback '!this.dismiss()' width 20

  exit

  frame .circleTaskPane panel                   anchor top + left + right      at xmin.shapeList       ymax.shapeList
    para .circlepara                  anchor top + left                 at x0.5                     ymax text 'Dimensions'

    line .circleL1                    anchor top + left + right         at x0                       ymax                horizontal width 32

    paragraph .circlePixmap           anchor top + left + right         at x4                       ymax                  pixmap width 200 height 200
    text .circletext1                 anchor top + left                 at x6.5                     y6                    callback '!this.circle()'  width 8 is REAL format !!distanceFmt

    para .circleoripara               anchor top + left                 at x0.5                     ymax.circlePixmap     text 'Origin'
    line .circleL3                    anchor top + left + right         at x0                       ymax                  horizontal width 32

    numericinput .co 'Origin:' tagwidth 5                               at x2                       ymax+0.2        callback '!this.circleOriginChange(' range 0 1 ndp 0   width 4
    --button .defineoriposcir linkLabel 'Define Origin Position'          at xmin                     ymax                  callback ''

    para .circlepickpara              anchor top + left                 at x0.5                     ymax+0.2              text 'Derived Methods'
    line .circleL2                    anchor top + left + right         at x0                       ymax                  horizontal width 32

    button .pickpointscircbutton1 linkLabel 'Centre and Radius' at x2 ymax+0.2 callback '!this.circlepickcentandrad()'

    paragraph .circacceptIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .circaccept  linkLabel 'Accept Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.apply()' width 16
    paragraph .circdismissIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .circdismiss linkLabel 'Return'           anchor top + left + right      at xmax+0.5            ymin               callback '!this.dismiss()' width 20

  exit

  frame .lshapeTaskPane panel       anchor top + left + right         at xmin.shapeList       ymax.shapeList
    para .lshapepara                anchor top + left                 at x0.5                     ymax text 'Dimensions'
    line .lshapeL1                  anchor top + left + right         at x0                       ymax                  horizontal width 32

    paragraph .lShapePixmap         anchor top + left + right         at x4                       ymax                  pixmap width 200 height 200

    text .lshapex1                   anchor top + left                 at x18                      ymax.lShapePixmap     callback '!this.lshape('  width 8 is REAL format !!distanceFmt
    text .lshapex2                   anchor top + left                 at x20.5                    ymin-1.8              callback '!this.lshape('  width 8 is REAL format !!distanceFmt
    text .lshapey1                   anchor top + left                 at x1                       y4                    callback '!this.lshape('  width 8 is REAL format !!distanceFmt
    text .lshapey2                   anchor top + left                 at x6.5                     ymin-1.2              callback '!this.lshape('  width 8 is REAL format !!distanceFmt

    -- Mirror L
    toggle .lshapexMirror 'Mirror in X' tagwidth 7                    at x2                       ymax.lShapePixmap     callback '!this.lshapeMirror()'
    toggle .lshapeyMirror 'Mirror in Y' tagwidth 7                    at x2                       ymax                  callback '!this.lshapeMirror()'

    para .lshapepickpara            anchor top + left + right         at x0.5                     ymax+0.2 text 'Origin'
    line .lshapeL2                  anchor top + left + right         at x0                       ymax                  horizontal width 32

    numericinput .lo 'Origin:' tagwidth 5                             at x2                       ymax+0.2              callback '!this.lshapeOriginChange(' range 0 6 ndp 0   width 4

    para .lshapederivepara          anchor top + left                 at x0.5                     ymax+0.2 text 'Derive Methods'
    line .lshapeL3                  anchor top + left + right         at x0                       ymax                  horizontal width 32

    button .pickpointslshapebutton1 linkLabel '3 Points' at xmin.rectanglepickpara+1 ymax callback '!this.pickLshapeRectangle()'
    numericinput .lshapealt 'Solution:' tagwidth 6                           at xmin                       ymax              callback '!this.lshapealtchange(' range 0 6 ndp 0   width 4

    paragraph .lshapeacceptIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .lshapeaccept  linkLabel 'Accept Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.apply()' width 16
    paragraph .lshapedismissIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .lshapedismiss linkLabel 'Return'           anchor top + left + right      at xmax+0.5             ymin                callback '!this.dismiss()' width 20

  exit

  frame .polygonTaskPane panel       anchor top + left + right         at xmin.shapeList       ymax.shapeList
    para .polygonpara                anchor top + left                 at x0.5                     ymax text 'Dimensions'
    line .polygonL1                  anchor top + left + right         at x0                       ymax                  horizontal width 32

    text .polygon1 'Number of Sides' tagwidth 12 anchor top + left + right  at x2                   ymax+0.2            callback '!this.polygon()'  width 6 is REAL
    option .polygondimtype at x2 ymax+0.2  width 15
    text .polygon2 '' tagwidth 0 anchor top + left + right  at xmax                   ymin           callback '!this.polygon()'  width 10 is REAL format !!distanceFmt

    para .polygonpickpara            anchor top + left + right         at x0.5                     ymax+0.2 text 'Origin'
    line .polygonL2                  anchor top + left + right         at x0                       ymax                  horizontal width 32

    numericinput .po 'Origin:' tagwidth 5                             at x2                       ymax+0.2              callback '!this.polygonOriginChange(' range 0 6 ndp 0   width 4

    paragraph .polygonacceptIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .polygonaccept  linkLabel 'Accept Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.apply()' width 16
    paragraph .polygondismissIcon           anchor top + left                 at x0                     ymax+0.2           pixmap width 16 height 16
    button .polygondismiss linkLabel 'Return'           anchor top + left + right      at xmax+0.5             ymin                callback '!this.dismiss()' width 20

  exit

  -- Form Members

  -- Reference Form
  member .form            is FORM

  -- Action
  member .action          is BLOCK

  -- Shape Definition
  member .shape           is SHAPEDEFINITION

  member .shapemodifier   is SHAPEMODIFIER


  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK

  --array of points to be held as form member
  --(for free-form pick)
  member .elearray is ARRAY

  --(for Lshape pick)
  member .lshapeArray is ARRAY

  -- lshape solution
  member .lshapeSolution is REAL
  member .lshapeOrigin   is REAL

  -- Built up array from lshape profile solutions (shapelshape.pmlobj)
  member .lshapeProfileArray is ARRAY

  --aid number, set when form constructed, so only set once
  --passed to shape object in .setup method
  member .shapeoutlinenum is REAL
  member .aidNumber       is REAL

  -- edg description
  member .edgDescription  is STRING

exit
-- End of form definition
------------------------------------------------------------------------
--
-- Method:      shapeDefinitionEditor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shapeDefinitionEditor()

  !this.quitCall = '!this.dismiss()'

  -- Set Icons
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.rectacceptIcon.addPixmap(!acceptIcon)
  !this.circacceptIcon.addPixmap(!acceptIcon)
  !this.lshapeacceptIcon.addPixmap(!acceptIcon)
  !this.freeformacceptIcon.addPixmap(!acceptIcon)
  !this.polygonacceptIcon.addPixmap(!acceptIcon)

  !returnIcon                   = !!pml.getpathname('back.png')
  !this.rectdismissIcon.addPixmap(!returnIcon)
  !this.circdismissIcon.addPixmap(!returnIcon)
  !this.lshapedismissIcon.addPixmap(!returnIcon)
  !this.freeformdismissIcon.addPixmap(!returnIcon)
  !this.polygondismissIcon.addPixmap(!returnIcon)

  !shapeIcon                    = !!pml.getpathname('shape-rectangle.png')
  !this.rectanglePixmap.addPixmap(!shapeIcon)
  !shapeIcon                    = !!pml.getpathname('shape-l.png')
  !this.lShapePixmap.addPixmap(!shapeIcon)
  !shapeIcon                    = !!pml.getpathname('shape-circle.png')
  !this.circlePixmap.addPixmap(!shapeIcon)

  -- Initialise Variables

  if (!this.rectanglex.val.unset()) then
    !this.clearVariables()
  endif

  !this.ro.modifiedEvents  = true
  !this.fo.modifiedEvents  = true
  !this.co.modifiedEvents  = true
  !this.lo.modifiedEvents  = true
  !this.po.modifiedEvents  = true
  !this.lshapealt.modifiedEvents = true

  !arrayOfShapes = ARRAY()

  !arrayOfShapes.append('Rectangle')
  !arrayOfShapes.append('L Shape')
  !arrayOfShapes.append('Circle')
  !arrayOfShapes.append('Free Form')
  !arrayOfShapes.append('Polygon')

  !this.shapeList.dtext = !arrayOfShapes

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!!ce')

  -- Initialise task panes
  !this.rectangleTasks(true)
  !this.circleTasks(false)
  !this.lshapeTasks(false)
  !this.freeformTasks(false)
  !this.polygonTasks(false)

  -- Set lshape gadgets
  !this.lshapealt.active = false
  !this.lo.active = false
  !this.lshapex1.seteditable(true)
  !this.lshapey1.seteditable(true)
  !this.lshapex2.seteditable(true)
  !this.lshapey2.seteditable(true)
  !this.lshapealt.val = 1
  !this.lshapexMirror.val = false
  !this.lshapeyMirror.val = false

  !this.edgDescription = 'Shape editor pick'

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      clearVariables
--
-- Description: clear variables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearVariables()

  -- Dimension variables

 !this.rectanglex.val   = 0
 !this.rectangley.val   = 0

 !this.circletext1.val  = 0

 !this.lshapex1.val     = 0
 !this.lshapey1.val     = 0
 !this.lshapex2.val     = 0
 !this.lshapey2.val     = 0

 !this.polygon1.val = 6
 !this.polygon2.val = 5000
 !this.polygondimtype(6)


endmethod
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Form setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!form is FORM, !formTitle is STRING, !applyTag is STRING, !action is STRING, !shape is SHAPEDEFINITION)

  !this.selectShape()
  !this.lshapeModify()

  -- Initialise Variables
  !this.formTitle   = !formTitle
  !this.form        = !form
  !this.rectaccept.tag = !applyTag
  !this.circaccept.tag = !applyTag
  !this.polygonaccept.tag = !applyTag
  !this.lshapeaccept.tag = !applyTag
  !this.freeformaccept.tag = !applyTag

  !this.shape       = !shape

  -- Define action of applying the form
  !block            = object BLOCK('!this.form.' & !action & '(!this.shape)')
  !this.action      = !block

  !this.shape.circle.derived = false
  !this.shape.rectangle.derived = false
  !this.shape.lshape.derived = false

  !this.shape.originalOrigin = !this.shape.profile.position

  !this.aidNumber         = !!aidNumbers.add('Shape Definition - Picked Points')
  !this.shapeoutlinenum   = !!aidNumbers.add('Shape Definition - Shape Outline')

  !this.shape.aidNumbers(!this.shapeoutlinenum)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  if (!this.shapeList.val eq(1)) then
    !this.rectangle()
  elseif (!this.shapeList.val eq(2)) then
    !this.lshapeCreate()
  elseif (!this.shapeList.val eq(3)) then
    !this.circle()
  elseif (!this.shapeList.val eq(4)) then
    !this.freeform()
  elseif (!this.shapeList.val eq(5)) then
    !this.polygon()
  endif

  !this.shape.profile.area()
  handle (2,834)
    !!alert.warning('Shape has self-intersecting lines')
    return
  endhandle
  if !this.shape.profile.area().eq(0) then
    !!alert.warning('Shape has zero area')
    return
  endif

  -- Initialise Variables
  !this.action.evaluate()

  -- Show original form
  !!accTaskManager.active(!this.form)
  !!aidNumbers.remove(!this.aidNumber)
  !!aidNumbers.remove(!this.shapeoutlinenum)

  -- escape from edg mode
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Dismiss form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  -- Show original form
  !!accTaskManager.active(!this.form)

  !!aidNumbers.remove(!this.aidNumber)
  !!aidNumbers.remove(!this.shapeoutlinenum)

  -- escape from edg mode
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Define a rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rectangle(!gadget is GADGET, !select is STRING)

  if (!gadget.val.lt(0)) then
    !!alert.error('Dimension value must be positive')
    return
  endif
  !this.rectangle()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rectangle
--
-- Description: Define a rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rectangle()

  -- Get rectangle
  !this.originChange(!this.ro.val)
  !this.shape.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickRectangle
--
-- Description: pick two opposite corner points to derive a rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickRectangle()


  -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'Accommodation'
  !packet.type        = 'Accommodation'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = !this.edgDescription
  !packet.action      = '!!shapeDefinitionEditor.rectangle2pnts(!this.return[1])'

  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('first point')
  !packet.pickPacket.picks[2]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdPosition('second point')

  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      rectangle2pnts
--
-- Description: Define a rectangle from 2 passed corner points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rectangle2pnts(!data is ARRAY)

  !position1  = !data[1]
  !position2  = !data[2]

  !pos1     = !position1.position
  !pos2     = !position2.position

  !profile = !this.shape.rectangle(!pos1,!pos2)
  if( !profile.area() eq 0mm2 ) then
    !!alert.error('Invalid rectangle defined. Zero length edge.')
    return
  endif

  !this.rectanglex.val = !this.shape.rectangle.xlen
  !this.rectangley.val = !this.shape.rectangle.ylen

  !this.originChange(!this.ro.val)

  !this.shape.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      lshape
--
-- Description: Define an L Shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lshape(!gadget is GADGET, !select is STRING)

  if (!gadget.val.lt(0) or !gadget.val.unset()) then
    !!alert.error('Dimension value must be positive')
    !gadget.val = 0
    return
  endif

  !this.lshape()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lshape
--
-- Description: Define an L Shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lshape()

  !this.lo.active = true
  !this.shape.lshape(!this.lshapex1.val, !this.lshapex2.val, !this.lshapey1.val, !this.lshapey2.val)
  !this.lshapeProfileArray[1] = !this.shape.lshape.profile
  !this.shape.draw()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      lshapeCreate()
--
-- Description: define the lshape room boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lshapeCreate()

  --!this.shape.lshape(!this.lshapex1.val, !this.lshapex2.val, !this.lshapey1.val, !this.lshapey2.val)
  if (!this.lshapexMirror.val or !this.lshapeyMirror.val) then
    !this.lshapeMirror()
  endif

  !this.originChange(!this.lo.val)
  !this.shape.draw()
  !this.lshapeSolution = !this.lshapealt.val
  !this.lshapeOrigin   = !this.lo.val

endmethod
------------------------------------------------------------------------
--
-- Method:      lshapeModify
--
-- Description: modify an L Shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lshapeModify()

  !this.lshapealt.val = !this.lshapeSolution
  handle ANY
    !this.lshapealt.val = 1
  endhandle
  !this.lo.val = !this.lshapeOrigin
  handle ANY
    !this.lo.val = 0
  endhandle


  !this.lshapealt.active = false
  !this.lshapex1.seteditable(true)
  !this.lshapey1.seteditable(true)
  !this.lshapex2.seteditable(true)
  !this.lshapey2.seteditable(true)

endmethod
------------------------------------------------------------------------
--
-- Method:      lshapeMirror
--
-- Description: Define an L Shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lshapeMirror()

  --re-generate lshape
  if (!this.shape.derived) then
    !this.shape.lshape(!this.lshapealt.val)
  else
    !this.shape.lshape(!this.lshapex1.val, !this.lshapex2.val, !this.lshapey1.val, !this.lshapey2.val)
  endif

  !this.shapemodifier.shapemodifier(!this.shape.profile)
  handle ANY
    return
  endhandle
  !this.shape.profile = !this.shapemodifier.mirror(!this.lshapexMirror.val, !this.lshapeyMirror.val)
  !this.shape.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectShape
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectShape()

  -- remove any existing graphic
  !!aidNumbers.hide(!this.shapeoutlinenum)
  !!aidNumbers.hide(!this.aidNumber)
  -- escape from edg mode
  !!edgCntrl.remove(!this.edgDescription)

  -- reset profile
  !shape = !this.shape.profile
  !this.shape.profile = object PROFILE()
  !this.shape.profile.position = !shape.position
  !this.shape.profile.orientation = !shape.orientation

  --set relevant task pane active
  if !this.shapeList.val.eq(1) then
    !this.rectangleTasks(true)
  elseif !this.shapeList.val.eq(2) then
    !this.lshapeTasks(true)
  elseif !this.shapeList.val.eq(3) then
    !this.circleTasks(true)
  elseif !this.shapeList.val.eq(4) then
    !this.freeformTasks(true)
  elseif !this.shapeList.val.eq(5) then
    !this.polygonTasks(true)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      rectangleTasks
--
-- Description: Set rectangle tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------


define method .rectangleTasks(!active is BOOLEAN)
  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.rectangleTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.rectangleTasks(false)')

  endif

  -- Show/hide task pane
  !this.rectangleTaskPane.visible = !active
endmethod

------------------------------------------------------------------------
--
-- Method:      freeformTasks
--
-- Description: Set freeform tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .freeformTasks(!active is BOOLEAN)
  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.freeformTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.freeformTasks(false)')

  endif

  -- Show/hide task pane
  !this.freeformTaskPane.visible = !active

endmethod

------------------------------------------------------------------------
--
-- Method:      freeformPickPoints
--
-- Description: Free form point picks to define shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .freeformPickPoints()

  --clear array of elements
  !this.elearray = ARRAY()

  -- Clear aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.shapeoutlinenum)

  -- Define packet
  !packet                 = object EDGPACKET()
  !packet.defineposition('Pick Multiple elements to define boundary, then press <esc>')
  !packet.description = !this.edgDescription
  !packet.priority    = 2
  !packet.remove          = false

  -- Define action on pick completion
  !packet.action          = '!!shapeDefinitionEditor.freeformPickPoints(!this.return[1].position.wrt(worl))'

  -- Define profile
  !packet.escape          = '!!shapeDefinitionEditor.freeform()'

  -- Add packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      freeformPickPoints
--
-- Description: Free form point picks to define shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .freeformPickPoints(!pickedPos is POSITION)


  -- store picked position
  !elearray = !this.elearray
  !shapePlane = !this.shape.plane
  !elearray.append(!shapePlane.near(!pickedPos))


  -- draw current shape
  if !elearray.maxIndex().gt(1) then
    !shape = object PROFILE(!this.shape.profile.position,!this.shape.profile.orientation,!elearray)
    !shape.close()
    -- clear previous graphic
    !!aidNumbers.hide(!this.aidNumber)
    -- draw shape
    !shape.draw(!this.aidNumber,1,4)
  endif

  -- store position
  !this.elearray = !elearray

  -- set origin range to match picked points
  !range[1] = 0
  !range[2] = !elearray.size()
  !range[3] = 1
  !this.fo.range = !range

  -- draw picked positions
  do !c indices !this.elearray
    !!drawAidText(!c.string(), !this.elearray[!c], !this.aidNumber)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      freeform
--
-- Description: Define a freeform picked shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .freeform()

  -- clear points
  !!aidNumbers.hide(!this.aidNumber)

  !this.shape.freeform(!this.elearray)

  !this.originChange(!this.fo.val)
  !this.shape.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      freeform
--
-- Description: Define a freeform picked shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .freeformOriginChange(!gadget is GADGET, !select is STRING)
  !this.originChange(!this.fo.val)
endmethod
-- End of method

