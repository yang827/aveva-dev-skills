------------------------------------------------------------------------
--
-- Method:      circle
--
-- Description: Define a circle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circle()

  if (!this.circletext1.val.lt(0)) then
    !!alert.error('Dimension value must be positive')
    return
  endif

  -- Get Circle
  !this.shape.circle(!this.circletext1.val)
  !this.originChange(!this.co.val)
  !this.shape.draw()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      circlepickcentandrad
--
-- Description: EDG pick for circle centre and radius points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .circlepickcentandrad()

  -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'Accommodation'
  !packet.type        = 'Accommodation'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = !this.edgDescription
  !packet.action      = '!!shapeDefinitionEditor.circlefromcentandrad(!this.return[1])'

  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('first point')
  !packet.pickPacket.picks[2]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdPosition('second point')

  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
--
-- Method:      circlefromcentandrad
--
-- Description: Define circle from centre and radius points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .circlefromcentandrad(!data is ARRAY)

  !centrePos = !data[1].position
  !radiusPos = !data[2].position
  !this.shape.circlefromcentandrad(!centrePos, !radiusPos)

  --put radius value of picked circle into radius text gadget

  !this.originChange(!this.co.val)

  !this.circletext1.val = !this.shape.circle.radius

  !this.shape.draw()

endmethod
