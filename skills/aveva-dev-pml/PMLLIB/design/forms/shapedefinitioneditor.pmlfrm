------------------------------------------------------------------------
--
-- Method:      picklshapeRectangle
--
-- Description: Pick 2 points to create outer lshape rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickLshapeRectangle()

  -- empty the previous profile array
  !this.shape.lshape.profileArray.clear()

  -- hide shown aids
  !!aidNumbers.hide(!this.shapeoutlinenum)

  -- lshape array
  !this.lshapeArray = ARRAY()

 -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'Accommodation'
  !packet.type        = 'Accommodation'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = !this.edgDescription
  !packet.action      = '!!shapeDefinitionEditor.lShapeRectangle(!this.return[1])'

  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('first point')
  !packet.pickPacket.picks[2]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdPosition('second point - define lshape outer rectangle')
  !packet.continue    = '!!shapeDefinitionEditor.pickLshape()'


  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      .lShapeRectangle()
--
-- Description: draw the lshape outer rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lShapeRectangle(!pick is ARRAY)

  !position1 = !pick[1]
  !position2 = !pick[2]

  !pos1      = !position1.position
  !pos2      = !position2.position

  !this.lshapeArray.append(!pos1)
  !this.lshapeArray.append(!pos2)


  !rectangle = object SHAPERECTANGLE()
  !rectangle.plane   = !this.shape.plane
  !rectangle.profile = !this.shape.profile

  !rectangle.rectangle(!pos1, !pos2).draw(!this.aidNumber,1,4)


endmethod
------------------------------------------------------------------------
--
-- Method:      .pickLshape()
--
-- Description: pick the lshape inner corner with 3rd pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickLshape()

  -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'Accommodation'
  !packet.type        = 'Accommodation'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = !this.edgDescription
  !packet.action      = '!!shapeDefinitionEditor.getLshapePicks(!this.return[1])'

  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('Lshape inner point')

  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      .getLshapePicks()
--
-- Description: gather the 3 picks for lshape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getLshapePicks(!pick is EDGPOSITIONDATA)

  !position = !pick.position
  !this.lshapeArray.append(!position)
  !this.lshape3pnts(!this.lshapeArray)

endmethod
------------------------------------------------------------------------
--
-- Method:      lshape3pnts
--
-- Description: Define an L shape from 3 passed points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lshape3pnts(!data is ARRAY)

  !!aidNumbers.hide(!this.aidNumber)

  !pos1  = !data[1]
  !pos2  = !data[2]
  !pos3  = !data[3]

  !numaltshapes = 1

  !this.shape.lshape(!numaltshapes,!pos1,!pos2,!pos3)
  !this.lshapeProfileArray = !this.shape.lshape.profileArray

  --set gadget active

  !this.lshapealt.active = true
  !this.lo.active = true


  --set range of values of gadget to !numaltshapes

  !range = ARRAY()
  !range.append(1)
  !range.append(!numaltshapes)
  !range.append(1)
  !this.lshapealt.range = !range

  -- Set Dimension values to correct solution
  !this.lshapeDimensions()

  !this.lshapex1.seteditable(false)
  !this.lshapey1.seteditable(false)
  !this.lshapex2.seteditable(false)
  !this.lshapey2.seteditable(false)

  !this.shape.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      lshapealtchange
--
-- Description: Change to alternative Lshapes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lshapealtchange(!gadget is GADGET, !select is STRING)

  !this.shape.lshape(!this.lshapealt.val)
  !this.originChange(!this.lo.val)
  !this.lshapeDimensions()
  !this.shape.draw()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      lshapeDimensions
--
-- Description: Set correct lshape dimensions to correct lshape solution
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lshapeDimensions()

  if (!this.lshapealt.val eq 1) then
    !this.lshapex1.val = !this.shape.lshape.lshapeSolution1[1]
    !this.lshapey1.val = !this.shape.lshape.lshapeSolution1[2]
    !this.lshapex2.val = !this.shape.lshape.lshapeSolution1[3]
    !this.lshapey2.val = !this.shape.lshape.lshapeSolution1[4]
  else
    !this.lshapex1.val = !this.shape.lshape.lshapeSolution2[1]
    !this.lshapey1.val = !this.shape.lshape.lshapeSolution2[2]
    !this.lshapex2.val = !this.shape.lshape.lshapeSolution2[3]
    !this.lshapey2.val = !this.shape.lshape.lshapeSolution2[4]
  endif


endmethod

