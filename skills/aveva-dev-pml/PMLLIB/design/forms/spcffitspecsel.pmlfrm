--
-- File:            spcffitspecsel.pmlfrm
--   Type:          Form Definition
--   Group:         Floor fittings Specification selector
--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Wed Jan 20 15:37:35 "GMT 1999
--
--
-- Description:
-- Specific Form for creation and modification of Floor fittings
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjustDirection()                -                   In modify mode this will immediately adjust the fitting direction Z
--  adjustRotation()                 -                   In modify mode this will immediately adjust the fitting rotation around the Z axis
--  apply()                          -                   Apply the form and apply the database attributes
--  autoSelect()                     -                   Automatic spec selection from the given preferences.
--  close()                          -                   Close form down
--  direction(DIRECTION)             -                   Setup to direction of offset
--  edit(DBREF)                      -
--  init(STRING,STRING)              -
--  initSpec(DBREF)                  -
--  initSpec(STRING,STRING)          -
--  noSpref()                        -                   Makes selection gadgets active/inactive if no specification is required
--  posCalcXyDist(POSITION)          -
--  preference(STRING,ANY)           -
--  selectionDone()                  BOOLEAN             Check to see if selection is complete (spec ref to SPCO)
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  showAxes()                       -                   Show Axes at position or proposed position
--  showDir(STRING)                  -                   Show the direction of a sub fitting by changing Axes
--  showFloorAid()                   -                   Show the floor aid
--  showRot()                        -                   Show the rotation of a sub fitting by changing Axes
--  spcFFitSpecSel()                 -                   Constructor
--  specAccept()                     -                   Create/Modify item
--  specCallback()                   -
--  stlCalcXYdist()                  -                   Calculate the Zdist for the fitting/fixing
--  strFitPosition(DBREF,POSITION)   ARRAY               Calculates the fitting position on the floor.
--  updateSubOri()                   -                   Setup to direction of offset
--  validateDistance(GADGET,STRING)  -                   Validate input to distance gadgets
--
 setup form !!spcFFitSpecSel

  !!spcFFitSpecSel.formTitle     = 'Floor Fittings'
  !!spcFFitSpecSel.iconTitle     = 'spcFFitSpecSel'
  !!spcFFitSpecSel.callback      = ''
  !!spcFFitSpecSel.formRevision  = ' $Revision: 1.14 $ '

  -- Form Members -------------------------------------------------
  -- Link to form which invoked this form
  member .mainForm       is FORM

  -- Elements
  member .element        is DBREF
  member .hpref          is DBREF
  member .onFloor        is DBREF
  member .onFloorLoop    is DBREF

  -- Flag for modify for initial time
  member .initialPass    is BOOLEAN

  -- Axes definition
  member .axes           is GPHAXES
  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Floor axes definition
  member .floorAid       is GPHPLANE
  -- Aid numbers for position & axes
  member .floorAidNumber is REAL

  -- Position
  member .position       is POSITION

  -- Position
  member .distance       is REAL

  -- Graphical Plane
  member .plane          is GPHPLANE
  member .planeNumber    is REAL

  --Common properties member
  member .properties     is COMPROP

  -- Beta angle store
  member .rotaAngle      is REAL

  -- Link to spec system
  member .specLink       is SPCLINK
  -- specification search criteria
  member .specSearch     is SPCSEARCH
  -- what was the old Userdata (define members)
  member .specData       is SPECDATA
  member .dflts          is SPECDFLTS

  -- members for CE Spec selection
  member .storeSpec      is STRING
  member .storeGtyp      is STRING
  member .storeStyp      is STRING
  member .storeSpre      is STRING

  -- Body of form definition -------------------------------------------------

  -- CE / Create Modify
  option .ce '' at xmin ymax   callback |call !!displaySpecSel('FFIT', 'OPTION') |  width 15
  var list _ce
    pairs |Create Standard|     |CREATE|
          |Create Compound|     |CREATEC|
          |Create Sub-Compound| |CREATES|
          |Modify CE|           |MODIFY|
  exit

  para .ceName at xmax ymin width 30 lines 2

 -- Spec selection
  frame .sframe at x0 ymax 'Specification Data' width 49

    -- Permissible Spec
    option .specifications '' at xmin+1 ymax width 25

    -- To allow creation without a spref, mainly for compound fittings.
    toggle .noSprefRequired    'No Selection' at xmax+1 ymin callback '!this.noSpref()'

    -- Default Select mode
    toggle .default    'Default' at xmin ymax
    toggle .autoSelect 'Auto'    at xmin ymax

    -- Available Types
    list .selected 'Current Selection' at x1   ymax width 43 length 4
    list .perms                        at xmin ymax width 43 length 4

    -- Display plot file
    path down
    halign right
    button .plotfile |Plotfile...|  callback |$p button should be inactive|

    para .question at xmin.perms ymin.perms-1 width 40 lines 1

    button .accept   |Properties...|   at xmin.perms+1    ymin.plotfile     callback '!this.specAccept()'

  exit

 -- Pline Settings
 frame .pframe at x0 ymax+0.2 |Positioning| width 49

   !xyDisPixmap  = !!pml.getPathName('xyz16.png')
   !xyDistPixmap = !!pml.getPathName('xyzi16.png')

   -- Justification of Section
   option   .justification |Reference Datum | call | !this.showAxes() | at x1 y1 width 15
   var list _justification
     pairs |Top Upwards     | |UTOP|
           |Top Downwards   | |DTOP|
           |Centre Upwards  | |UCEN|
           |Centre Downwards| |DCEN|
           |Bottom Upwards  | |UBOT|
           |Bottom Downwards| |DBOT|
   exit

   --text .distance at xmax+1 ymin || call | !this.showAxes() | width 19 is REAL format !!distanceFmt
   --!this.distance = 0

   text .xDistance   at x0 ymax |     X Position | call | !this.showAxes() | width 16 is REAL format !!distanceFmt
   !this.xDistance.val = 0

   text .yDistance  at x0 ymax  |     Y Position | call | !this.showAxes() | width 16 is REAL format !!distanceFmt
   !this.yDistance.val = 0

   -- button for xDistance/elevation pixmap
   button .xypix at xmax+8 ymin.yDistance-0.5 tooltip 'Position fitting' pixmap sel "$!<xyDisPixmap>" inact "$!<xyDistPixmap>" width 16  height 16 callback '!this.stlCalcXYdist()'

   toggle .xDistLock 'lock'    at xmax.xDistance+1 ymin.xDistance  callback '!this.xDistance.active = !this.xDistLock.val.not()'
   toggle .yDistLock 'lock'    at xmax.yDistance+1 ymin.yDistance  callback '!this.yDistance.active = !this.yDistLock.val.not()'

 exit

 frame .oframe at x0 ymax+0.2 |Orientation| width 49
   -- Direction
   text .direction at x1 ymax |Sub-fitting Direction ('Z') | call | !this.showDir('AndRotation') | width 16 is DIRECTION
   !this.direction.val = N

   path down
   halign right

    -- Beta Rotation Angle
   text .rotation  |Rotation Angle ('Z' axis) | call | !this.showRot() | width 16 is REAL
   !this.rotation.val = 0
 exit

  -- Bottom Line
  button .cancel  |Dismiss| at xmax form-size  ymax callback '!this.close()'
  button .ok      |Apply|   at xmin form-0     ymin     callback '!this.apply()'

-- End of form definition for !!spcFFitSpecSel
exit

------------------------------------------------------------------------
--
-- Method:      spcFFitSpecSel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcFFitSpecSel()

  -- Unset the initialise flag
  !this.initialPass = false

  -- Set the cancel call member
  !this.cancelCall = '!this.close()'

  -- Gadget validation calls
  !this.xDistance.validateCall = '!this.validateDistance('
  !this.yDistance.validateCall = '!this.validateDistance('
  !this.rotation.validateCall  = '!this.validateDistance('

  -- SPECIFICATION setup
  !this.specSearch          = object SPCSEARCH()
  !this.specSearch.spwlType = ''
  !this.specSearch.type     = ''
  !this.specSearch.search()

  -- Generate links
  -- link specification display gadget with the spec search data
  !this.specLink.specification(!this.specifications, !this.specSearch)
  -- link current selected spec item gadget
  !this.specLink.selection(!this.selected)
  -- link permissible selection gadget
  !this.specLink.permissible(!this.perms)
  -- link question gadget
  !this.specLink.question(!this.question)
  -- link default gadget
  !this.specLink.default(!this.default)
  -- link autoSelect gadget
  !this.specLink.autoSelect(!this.autoSelect)
  -- set action for selection which sets parameters
  !this.specLink.setAction('!!spcFFitSpecSel.specCallback()')

  -- Initialise the form with spec of correct type
  !this.initSpec('CIV', 'FFIT' )
  -- Initialise the form with the correct specs
  if (!this.specSearch.specifications.size() eq 0) then
    return
  endif
  !this.specCallback()

  -- Allocate aid numbers
  !this.aidNumber      = !!aidNumbers.add('Axes')
  !this.floorAidNumber = !!aidNumbers.add('Floor Aid')
  !this.planeNumber    = !!aidNumbers.add('Fitting Plane')

  -- Define default axes
  !gphAxes             = object GPHAXES()
  !gphAxes.tag         = false
  !gphAxes.detail      = false
  !gphAxes.position    = object POSITION('N0')
  !gphAxes.orientation = object ORIENTATION('Y is N')
  !this.axes           = !gphAxes

   -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!!spcFFitSpecSel.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!!spcFFitSpecSel.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!!spcFFitSpecSel.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!!spcFFitSpecSel.setDirection(')
  !this.direction.setPopup(!this.directionMenu)

  -- Distance
  -- !menu = !this.newMenu('distanceMenu')
--     !menu.add('CALLBACK', '0.0',              '!this.distance = 0
--     !this.showAxes()')
--     !menu.add('CALLBACK', '+/-',              '!this.distance = -1 * !this.distance
--     !this.showAxes()')
--     !menu.add('CALLBACK', 'Measure',          '!!spcFFitSpecSel.setMeasure(')
--     !menu.add('CALLBACK', 'Measure Shortest', '!!spcFFitSpecSel.setMeasure(')
--   !this.distance.setPopup(!this.distanceMenu)

  -- x Distance
  !menu = !this.newMenu('xDistanceMenu')
    !menu.add('CALLBACK', '0.0',              '!this.xDistance.val = 0
    !this.showAxes()')
    !menu.add('CALLBACK', '+/-',              '!this.xDistance.val = -1 * !this.xDistance.val
    !this.showAxes()')
  !this.xDistance.setPopup(!this.xDistanceMenu)

  -- y Distance
  !menu = !this.newMenu('yDistanceMenu')
    !menu.add('CALLBACK', '0.0',              '!this.yDistance.val = 0
    !this.showAxes()')
    !menu.add('CALLBACK', '+/-',              '!this.yDistance.val = -1 * !this.yDistance.val
    !this.showAxes()')
  !this.yDistance.setPopup(!this.yDistanceMenu)

    -- Direction
  !menu = !this.newMenu('rotationMenu')
    !menu.add('CALLBACK', '+/-',  '!this.rotation.val = -1 * !this.rotation.val
    !this.showRot()')
    !menu.add('CALLBACK', '0',    '!this.rotation.val = 0
    !this.showRot()')
    !menu.add('CALLBACK', '45',   '!this.rotation.val = 45
    !this.showRot()')
    !menu.add('CALLBACK', '-45',  '!this.rotation.val = -45
    !this.showRot()')
    !menu.add('CALLBACK', '90',   '!this.rotation.val = 90
    !this.showRot()')
    !menu.add('CALLBACK', '-90',  '!this.rotation.val = -90
    !this.showRot()')
    !menu.add('CALLBACK', '135',  '!this.rotation.val = 135
    !this.showRot()')
    !menu.add('CALLBACK', '-135', '!this.rotation.val = -135
    !this.showRot()')
    !menu.add('CALLBACK', '180',  '!this.rotation.val = 180
    !this.showRot()')
  !this.rotation.setPopup(!this.rotationMenu)


  -- Temporary deactivation of offset gadget
  --!this.distance.active = false

endmethod
-- End of method definition for .spcFFitSpecSel()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!dummyA is STRING, !mode is STRING )

  --initialise variables
  !dText = ARRAY()
  !rText = ARRAY()
  !this.rotaAngle = 0

  -- Initialise the form with the correct specs
  if (!this.specifications.rText.size() gt 1) then

    -- Option gadget on form used. Selection will be CREATE or MODIFY
    if (!mode.upcase() eq 'OPTION') then
      !mode = !this.ce.selection()
      -- Grey out the Apply button every time the create/modify pressed
      --!this.ok.active = false
      --!this.accept.active = false
    endif

-- **********************************************************************************************
-- CREATE MODE
-- **********************************************************************************************

    -- Floor fitting Creation mode, can be CREATE or MODIFY
    if (!mode.upcase() inset ('CREATE', 'CREATEC', 'CREATES')) then

      -- justification list is different for sub-fittings
      !dText.clear()
      !rText.clear()
      !dText[1] = |Top Upwards|
      !rText[1] = |UTOP|
      !dText[2] = |Top Downwards|
      !rText[2] = |DTOP|
      !dText[3] = |Centre Upwards|
      !rText[3] = |UCEN|
      !dText[4] = |Centre Downwards|
      !rText[4] = |DCEN|
      !dText[5] = |Bottom Upwards|
      !rText[5] = |UBOT|
      !dText[6] = |Bottom Downwards|
      !rText[6] = |DBOT|
      !this.justification.dText = !dText
      !this.justification.rText = !rText

      -- CREATE SUB FITTINGS VALIDATION
      -- ******************************
      if (!mode.upcase() eq 'CREATES') then
        -- if for a sub fitting
        !element = !!ce
        CMPF
          handle any
            !!alert.message('Navigate to a compound fitting of a Floor, or Screed.')
            if (!this.element.unset()) then
              !this.hide()
            endif
            return
          endhandle

        -- Must be a Floor sub fitting rather than a panels & plates fitting
        if (!!ce.owner.type inset ('SCREED', 'FLOOR')) then
          -- ok
        else
          !!alert.message('Navigate to a compound fitting of a Floor, or Screed.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif

        -- justification list is different for sub-fittings
        !dText.clear()
        !rText.clear()
        !dText[1] = |Owner Origin|
        !rText[1] = '0'

        if (!!ce.spref.unset() or !!ce.spref.badRef()) then
          -- its ok
        elseif (!!ce.spref.tmpRef.set() and  !!ce.spref.tmpRef.badRef().not()) then
          !dpls = !!ce.dpls
          -- construct the return and detail text arrays
          do !i indices !dpls
            !dText[!i + 1] = 'DPoint No ' & !dpls[!i]
            !rText[!i + 1] = !dpls[!i].string()
          enddo
        elseif (!!ce.spref.catRef.set() and  !!ce.spref.catRef.badRef().not()) then
          !ppls = !!ce.ppls
          -- construct the return and detail text arrays
          do !i indices !ppls
            !dText[!i + 1] = 'PPoint No ' & !ppls[!i]
            !rText[!i + 1] = !ppls[!i].string()
          enddo
        endif

        !this.justification.dText = !dText
        !this.justification.rText = !rText

      -- CREATE FITTING or COMPOUND FITTING FORM INITIALISATION
      -- ******************************************************
      else
        -- elseif for a fitting or compound
        !element = !!ce
        SCREED
        handle any
          FLOOR
          handle any
            !!alert.message('Navigate to a Floor or Screed.')
            if (!this.element.unset()) then
              !this.hide()
            endif
            return
          endhandle
        endhandle

      endif

-- **********************************************************************************************
-- CREATE MODE - Initial validation done above
-- **********************************************************************************************


       -- initialise the form in create mode
      !this.element = !!ce
      -- CREATE SUB FITTINGS FORM INITIALISATION
      -- ***************************************
      if (!mode.upcase() eq 'CREATES') then
        !floor = !!dtbGetOwnerType(!!ce, 'FLOOR SCREED')
        if (!floor.type inset ('FLOOR', 'SCREED')) then
          !this.onFloor = !floor
          !this.onFloorLoop = NULREF
          do !i indices !this.onFloor.members
            if (!this.onFloor.members[!i].type eq 'PLOO') then
              !this.onFloorLoop = !this.onFloor.members[!i]
              break
            endif
          enddo
          if (!this.onFloorLoop.unset()) then
            !!alert.message('Badly defined Floor or Screed.')
            return
          endif
          !this.ceName.val = 'Fitting on ' + !!ce.fullName
          !this.ce.select('RTEXT', !mode.upcase() )
          !this.justification.val = 1
          !this.distance  = 0
          !this.xDistance.val = 0
          !this.yDistance.val = 0
          !this.direction.val = U WRT /*
          !this.rotation.val  = 0
          !this.rotaAngle     = 0

        endif

      -- CREATE FITTINGS or COMPOUND FITTINGS FORM INITIALISATION
      -- ********************************************************
      else
        !this.onFloor = !!ce
        !!ce = !this.onFloor
        !this.onFloorLoop = NULREF
        do !i indices !this.onFloor.members
          if (!this.onFloor.members[!i].type eq 'PLOO') then
            !this.onFloorLoop = !this.onFloor.members[!i]
            break
          endif
        enddo
        if (!this.onFloorLoop.unset()) then
          !!alert.message('Badly defined Floor or Screed.')
          return
        endif
        !this.ceName.val = 'Fitting on ' + !!ce.fullName
        !this.ce.select('RTEXT', !mode.upcase() )
        !this.justification.select('RTEXT', 'UTOP')
        !this.distance  = 0
        !this.xDistance.val = 0
        !this.yDistance.val = 0
        !this.direction.val = U WRT /*
        !this.rotation.val  = 0
        !this.rotaAngle     = 0

      endif

      -- Update the sub-fitting frame gadgets
      !this.updateSubOri()

      -- The no specRef button may be on
      !this.noSpref()

      -- Show Axes
      !this.showAxes()

-- **********************************************************************************************
-- MODIFY MODE
-- **********************************************************************************************

    elseif (!mode.upcase() eq 'MODIFY') then

      -- If its a template go to the actual fitting and validate the fitting
      !fitting = !!dtbGetOwnerType(!!ce, 'PFIT CMPF SBFI')
      if (!fitting.set()) then
        -- Make sure this is a Floor fitting
        !floor = !!dtbGetOwnerType(!fitting, 'FLOOR SCREED')
        if (!floor.set()) then
          -- Navigate to the fitting
          !!ce = !fitting
        else
          !!alert.message('Navigate to a Floor fitting.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif
      else
        !!alert.message('Navigate to a Floor fitting.')
        if (!this.element.unset()) then
          !this.hide()
        endif
        return
      endif

      if (!!ce.type inset ('PFIT', 'CMPF', 'SBFI')) then

      -- MODIFY FITTING or COMPOUND FITTING FORM INITIALISATION
      -- ******************************************************
        if (!!ce.owner.type inset ('FLOOR', 'SCREED')) then
          -- For fittings or compound fittings

          -- justification list is different for sub-fittings
          !dText.clear()
          !rText.clear()
          !dText[1] = |Top Upwards|
          !rText[1] = |UTOP|
          !dText[2] = |Top Downwards|
          !rText[2] = |DTOP|
          !dText[3] = |Centre Upwards|
          !rText[3] = |UCEN|
          !dText[4] = |Centre Downwards|
          !rText[4] = |DCEN|
          !dText[5] = |Bottom Upwards|
          !rText[5] = |UBOT|
          !dText[6] = |Bottom Downwards|
          !rText[6] = |DBOT|
          !this.justification.dText = !dText
          !this.justification.rText = !rText

          -- Current fitting
          !this.element = !!ce
          !this.onFloor = !!ce.owner
          !this.onFloorLoop = NULREF
          do !i indices !this.onFloor.members
            if (!this.onFloor.members[!i].type eq 'PLOO') then
              !this.onFloorLoop = !this.onFloor.members[!i]
              break
            endif
          enddo
          if (!this.onFloorLoop.unset()) then
            !!alert.message('Badly defined Floor or Screed.')
            return
          endif
          !this.ceName.val = !!ce.fullName

          -- Justification
          !this.justification.select('RTEXT', !!ce.sjus)
          handle any
            -- posl set by other than appware
            !this.justification.select('RTEXT', 'UTOP')
          endhandle

          -- Distances
          !this.distance  = !!ce.position.up
          !this.xDistance.val = !!ce.position.east
          !this.yDistance.val = !!ce.position.north

          !this.direction.val = !!ce.orientation.wrt(world).zDir()

          -- Beta Angle and elevation
          !this.rotation.val = !!ce.bang
          !this.rotaAngle    = !!ce.bang

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

          -- Update the sub-fitting frame gadgets
          !this.updateSubOri()

          -- Set the initialise flag
          !this.initialPass = true

          -- Show Axes
          !this.showAxes()

      -- MODIFY SUB-FITTING FORM INITIALISATION
      -- **************************************
        elseif (!!ce.owner.owner.type inset('FLOOR', 'SCREED')) then
          -- For sub fittings

          -- Current fitting
          !this.element = !!ce
          !this.onFloor = !!ce.owner.owner
          !this.onFloorLoop = NULREF
          do !i indices !this.onFloor.members
            if (!this.onFloor.members[!i].type eq 'PLOO') then
              !this.onFloorLoop = !this.onFloor.members[!i]
              break
            endif
          enddo
          if (!this.onFloorLoop.unset()) then
            !!alert.message('Badly defined Floor or Screed.')
            return
          endif
          !this.ceName.val = !!ce.fullName

          -- justification list is different for sub-fittings
          !dText.clear()
          !rText.clear()
          !dText[1] = |Owner Origin|
          !rText[1] = '0'

          if (!!ce.owner.spref.unset() or !!ce.owner.spref.badRef()) then
            -- its ok
          elseif (!!ce.owner.spref.tmpRef.set() and  !!ce.owner.spref.tmpRef.badRef().not()) then
            !dpls = !!ce.owner.dpls
            -- construct the return and detail text arrays
            do !i indices !dpls
              !dText[!i + 1] = 'DPoint No ' & !dpls[!i]
              !rText[!i + 1] = !dpls[!i].string()
            enddo
          elseif (!!ce.owner.spref.catRef.set() and  !!ce.owner.spref.catRef.badRef().not()) then
            !ppls = !!ce.owner.ppls
            -- construct the return and detail text arrays
            do !i indices !ppls
              !dText[!i + 1] = 'PPoint No ' & !ppls[!i]
              !rText[!i + 1] = !ppls[!i].string()
            enddo
          endif

          !this.justification.dText = !dText
          !this.justification.rText = !rText

          !this.justification.select('RTEXT', !!ce.arrive.string() )

          -- Position from compound fitting
          !this.distance  = !!ce.delp.up
          !this.xDistance.val = !!ce.delp.east
          !this.yDistance.val = !!ce.delp.north

          -- Direction
          !this.direction.val   = !!ce.zDir.wrt(world)

          -- Beta Angle and elevation
          !this.rotation.val    = !!ce.bang
          !this.rotaAngle       = !!ce.bang

          -- With respect to code
          --!this.oldWrtElement = !this.element.owner
          --!this.newWrtElement = !this.onFloor
          --!this.wrt.val = !this.onFloor.fullName
          --!this.setWrt()

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

          -- Update the sub-fitting frame gadgets
          !this.updateSubOri()

          -- Set the initialise flag
          !this.initialPass = true

          -- Show Axes
          !this.showAxes()

        else
          !!alert.message('Wrong type of fitting.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif

      else
        !!alert.message('Wrong type of element.')
        if (!this.element.unset()) then
          !this.hide()
        endif
        return
      endif

      -- MODIFY GENERAL FORM INITIALISATION
      -- **********************************
      -- Initialise the form with known spref
      !this.initSpec(!this.element.spref)
      --!this.specCallback()

      -- If the item to be modified does not have a SPCO spref
      if (!this.specLink.selection().type eq 'SPCO') then
        !this.noSprefRequired.val = false
        !this.noSpref()
      else
        !this.noSprefRequired.val = true
        !this.noSpref()
      endif

    endif

    -- Show graphical aids for the actual floor
    !this.showFloorAid()

  else

    -- There are no specs of purp FFIT
    !this.hide()
    !!alert.message('There are no specifications for floor fittings.')
    return
  endif

endmethod
-- End of method definition for .init(STRING, STRING )

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description: Initialise Form with given spec type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Spec world type (PURP)
--    2   R      STRING      Spec type (PURP)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spwlType is STRING, !specType is STRING )

  !this.mainForm = !this.owner()

  -- check for change to current spec
  if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
    -- spec changed, reset form
    !this.specSearch.spwlType = !spwlType
    !this.specSearch.type     = !specType
    !this.specSearch.search()
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif
  !this.specLink.setup( object SPCSPECIFICATION() )

endmethod
-- End of method definition for .initSpec( STRING, STRING )

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description: Initialise Form with given SPEC or SPCO DBREF
--   Passing a null ref will just bring up the currently selected specs.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of SPCO used to initialise this form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spec is DBREF )

  if( badref(!spec) ) then
    -- initialise spec
    !this.specLink.setup( object SPCSPECIFICATION() )
  else
    -- get type of SPEC
    !specEl = SPEC OF $!spec
    !specType = !specEl.purp
    !spwlEl = SPWL OF $!spec
    !spwlType = !spwlEl.purp
    -- check that form is initialised for this type of object
    if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
      !this.specSearch.spwlType = !spwlType
      !this.specSearch.type     = !specType
      !this.specSearch.search()
      !this.specLink.specification(!this.specifications, !this.specSearch)
    endif
    -- set form to existing spec
    !this.specLink.specData.selector( !spec )
    !this.specLink.setup(!this.specLink.specData)
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif

  -- if dbref was known then no need to accept
  !this.ok.active = true

endmethod
-- End of method definition for .initSpec( DBREF )

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Initialise Form with given DBREF of an item with a spref
--   Passing a null ref will just bring up the currently selected specs.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit( !objectWithSpref is DBREF )

  if( badref(!objectWithSpref) ) then
    -- setup form gadgets for select from top level
    !this.specLink.setup( object SPCSPECIFICATION() )
  else
    -- setup form gadgets for spref already set
    !spref = !objectWithSpref.spref
    handle any
      !spref = object DBREF()
    endhandle
    if( !spref.set() ) then
      -- set form to existing spec
      !this.specLink.setup( !objectWithSpref )
    endif
  endif

endmethod
-- End of method definition for .edit( DBREF )

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove the event driven graphics in case the form was dismissed
  !!edgCntrl.remove('Position Floor Fitting')
  !!edgCntrl.remove('Pick floor fitting Z direction')

  -- Hide the Axes
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.floorAidNumber)

  -- Hide the Plane
  !!aidNumbers.hide(!this.planeNumber)

  -- Tidy the properties member
  !this.properties.deleteObject()

  -- Hide the form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      specAccept
--
-- Description: Create/Modify item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specAccept()

  -- Initialise Variables
  !selectedSpre = !this.specLink.selection()

  -- error if selection not complete - must be a SPCO
  if( !selectedSpre.type.upcase() ne 'SPCO' ) then
    !!alert.error( 'Specification selection not complete' )
    return
  endif

  -- Hide plot form because it would be repeated on property form
  !this.properties.hidePlot()

  -- Show the properties form
  !this.properties.editProperties()

endmethod
-- End of method definition for .specAccept()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the form and apply the database attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- First validate the direction
  !testGadget = !this.direction.val
  handle ANY
    !!alert.error('Invalid input for Direction gadget.')
    return
  endhandle

  -- Action will be create or modify
  !action =   !this.ce.selection()
  -- item could be fitting on Screed or Floor
  !item = !this.element
  -- selected spref is the new selection
  !selectedSpre = !this.specLink.selection()

  -- Navigate to Floor if in create mode
  !!ce = !item

-- ************************************************************
-- CREATE MODE - will all use modify mode when actually created
-- ************************************************************

  -- Create or modify on Screed or Floor
  if (!this.ce.selection().match('CREATE') eq 1 ) then
    if (!this.element.type inset ('FLOOR', 'SCREED')) then
      !!ce = !this.element
      if (!this.ce.selection() eq 'CREATE') then
        NEW PFIT
      elseif (!this.ce.selection() eq 'CREATEC') then
        NEW CMPF
      endif
    elseif (!this.element.type eq 'CMPF') then
      !!ce = !this.element
      NEW SBFI
    else
      !!alert.error('Not on a Floor')
      return
    endif
  endif

  -- Created now so go into modify mode
  !item = !!ce
  !action = 'MODIFY'

-- ************************************************************
-- MODIFY MODE - will all use modify mode when actually created
-- ************************************************************

  -- Even create is now in modify mode because required elements have now been created.
  if (!action eq 'MODIFY') then

    -- Set design parameters if there are any
    if (!this.noSprefRequired.val) then
      SPREF NULREF
      DESP UNSET
    else
      !this.properties.setProperties(!!ce)
      !this.properties.unsetDesiElement()
    endif

    -- ************************************
    -- APPLY FITTINGS or COMPOUND FITTINGS
    -- ************************************

    if (!item.type inset ('PFIT', 'CMPF')) then

      !sjus = !this.justification.selection()
      SJUS $!sjus

      !bang = !this.rotation.val
      BANG $!bang

      !pos = !this.axes.position
      POS $!pos

    -- ************************************
    -- APPLY SUB-FITTINGS
    -- ************************************

    elseif (!item.type eq 'SBFI') then

      !zDir = !this.axes.orientation.zDir()
      ZDIR $!zDir

      !bang = !this.rotation.val
      BANG $!bang

      !arrive = !this.justification.selection()
      ARRIVE $!arrive

      !xPos = !this.xDistance.val
      !yPos = !this.yDistance.val
      DELP X $!xPos  Y $!yPos

    else
      !!alert.error('Not at a fitting')
      return
    endif

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      selectionDone
--
-- Description: Check to see if selection is complete (spec ref to SPCO)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectionDone() is BOOLEAN

  -- Initialise Variables
  !result       = false
  -- Clear design parameters
  !selectedSpre = !this.specLink.selection()

  if(!selectedSpre.badRef().not()) then
    if(!selectedSpre.type.upcase() eq 'SPCO' and (!selectedSpre.catr.badRef().not() or !selectedSpre.tmpr.badRef().not()) ) then
    -- error if selection not complete - must be a SPCO
     !result = (!selectedSpre.type.upcase() eq 'SPCO')
    endif
  endif

  return !result

endmethod
-- End of method definition for .selectionDone() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      specCallBack
--
-- Description: Function called when spec selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specCallback()

  -- initialise variables
  !specSelection = !this.specLink.selection()

  -- Allow user to OK if got to a SPCO
  !selectionDone = !this.selectionDone()
  !this.ok.active       = !selectionDone
  !this.accept.active   = !selectionDone
  !this.plotfile.active = !selectionDone

  if (!this.accept.active eq false) then
    !this.ok.active = false
  else
    if (!specSelection eq !this.element.spref) then
      !this.properties.initialise(!this.element)
      !this.properties.unsetDesiElement()
    else
      !this.properties.initialise(!specSelection)
      -- if the properties are edited cache them
      !this.properties.autoCacheValues(true)
    endif

    -- Only if there are no properties for user input then make the Apply active.
    -- For templates
    !coll = ARRAY()
    if (!specSelection.tmpRef.set() and !specSelection.tmpRef.badRef().not()) then
      var !coll COLLECT ALL DDAT WITH (PURP INSET('ATTR', 'DESP')) FOR $!specSelection.tmpRef
    endif
    -- For non templates
    if (!specSelection.catRef.set() and !specSelection.catRef.badRef().not()) then
      if (!specSelection.catRef.dtRef.set() and !specSelection.catRef.dtRef.badRef().not()) then
        !dtRef = !specSelection.catRef.dtRef
        var !coll COLLECT ALL DATA WITH (PURP INSET('ATTR', 'DESP')) FOR $!dtRef
      endif
    endif
    if (!coll.size().eq(0)) then
      !this.accept.active = false
      !this.ok.active = true
    endif
  endif

  -- Set the plotfile callback
  -- We are now allowing for a SELE with a set ICON attribute
  -- to store plotfile information.
  -- Format will be ICON 'DirName FileName PlotStyle'
  -- example ICON 'FloorS AFloorPLOT LPLT' meaning
  -- %PDMSPLOTS/FloorS/AFloorPLOT displayed as a Landscape plot.
  -- PPLT = portrait plot

  if (!specSelection.type eq 'SELE') then
    if (!specSelection.icon eq '') then
      !this.plotfile.active = false
    else
      !this.plotfile.active = true
    endif
  elseif (!specSelection.type eq 'SPCO') then
    if (!this.properties.checkPlot()) then
      !this.plotfile.active = true
    else
      !this.plotfile.active = false
    endif
  endif
  --!selectedSpref = !specSelection.name
  --!this.plotfile.callback = |CALLSTL XSTLPLOT $!selectedSpref|
  !this.plotfile.callback = |!this.properties.displayPlot()|

endmethod
-- End of method definition for .specCallback()

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description: Set preferences for auto selection of spec from geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of selection key
--    2   R      ANY         Value of selection key
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference( !key is STRING, !answer is ANY )

  -- add the preference
  !this.specLink.specData.preference(!key, !answer)

endmethod
-- End of method definition for .preference( STRING, ANY )

------------------------------------------------------------------------
--
-- Method:      autoSelect
--
-- Description: Automatic spec selection from the given preferences.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoSelect()

  -- Find entries that conform to the preferences
  !this.specLink.actionAutoSelect()

  -- clear the preferences
  !this.specLink.specData.preferenceClear()

endmethod
-- End of method definition for .autoSelect()
------------------------------------------------------------------------
--
-- Method:      stlCalcXYdist
--
-- Description: Calculate the Zdist for the fitting/fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlCalcXYdist()

 !packet = object EDGPACKET()

  !packet.definePosition('Position Floor Fitting')
  !packet.description = 'Position Floor Fitting'
  !packet.action      = '!!spcFFitSpecSel.posCalcXyDist(!this.return[1].position)'
  !packet.type        = 'Positioning'
  !packet.key         = 'xyDistCalc'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .stlCalcXYdist()
------------------------------------------------------------------------
--
-- Method:      posCalcXyDist
--
-- Description: Action from the Calculate the Zdist for the fitting/fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posCalcXyDist( !passedPosition is POSITION )

  -- Call the function to populate the form gadgets with the returned information
  !returnedArray = !this.strFitPosition(!this.element, !passedPosition.wrt(world))

  -- A three part array is return from the above function
  -- Part one, maintain the distance value
  !this.distance = !returnedArray[1]

  -- Part two returned the Z distance
  if (!this.xDistance.active) then
    !this.xDistance.val = !returnedArray[2]
  endif

  -- Part three returned the elevation wrt the wrt gadget value
  if (!this.yDistance.active) then
    !this.yDistance.val = !returnedArray[3]
  endif

  -- Show Axes
  !this.showAxes()

  -- Only one pick was allowed per button press
  !!edgCntrl.remove('Position Floor Fitting')

endmethod
-- End of method definition for .posCalcXyDist( POSITION )

------------------------------------------------------------------------
--
-- Method:      strFitPosition
--
-- Description: Calculates the fitting position on the floor.
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .strFitPosition(!fitting is DBREF, !position is POSITION) is ARRAY

  -- initialise variables
  !mode = !this.ce.selection()

  if ((!mode eq 'MODIFY' and !this.element.type eq 'SBFI') or (!mode eq 'CREATES')) then
    if (!mode eq 'MODIFY') then

      if (!this.element.owner.sjus inset('UTOP ', 'DTOP')) then
        !sjus = 'TOP'
      elseif (!this.element.owner.sjus inset('UBOT ', 'DBOT')) then
        !sjus = 'BOTTOM'
      else
        !sjus = 'CENTRE'
      endif

      -- Plane normal to the panel
      !plane = !!edgTypes.panel.plane(!this.onFloor, !sjus )
      !plane.orientation = !this.element.owner.orientation
      !plane.position = !this.element.owner.pPosition[!this.justification.selection().real()]

    elseif (!mode eq 'CREATES') then

      if (!this.element.sjus inset('UTOP ', 'DTOP')) then
        !sjus = 'TOP'
      elseif (!this.element.sjus inset('UBOT ', 'DBOT')) then
        !sjus = 'BOTTOM'
      else
        !sjus = 'CENTRE'
      endif

      -- Plane normal to the panel
      !plane = !!edgTypes.panel.plane(!this.onFloor, !sjus )
      !plane.orientation = !this.element.orientation
      !plane.position = !this.element.pPosition[!this.justification.selection().real()]

    endif

  else

    if (!this.justification.selection() inset('UTOP ', 'DTOP')) then
      !sjus = 'TOP'
    elseif (!this.justification.selection() inset('UBOT ', 'DBOT')) then
      !sjus = 'BOTTOM'
    else
      !sjus = 'CENTRE'
    endif

    -- Plane normal to the panel
    !plane = !!edgTypes.panel.plane(!this.onFloor, !sjus )

  endif

  -- drawing the plane - debugging only
  !gplane  = object GPHPLANE(!plane)
  !gplane.detail = true
  --!gplane.draw(100)

  -- Map passed position onto plane
  !newPosition  = !plane.near(!position)

  -- Distance from start (xDistance)
  !xyPosition   = !plane.xyOffset(!newPosition)
  !distance     = !this.distance
  !xDistance    = !xyPosition.x
  !yDistance    = !xyPosition.y

  -- Make the return array
  !array[1] = !distance
  !array[2] = !xDistance
  !array[3] = !yDistance

  return !array

endmethod
-- End of method definition for .strFitPosition(DBREF, POSITION) ARRAY

------------------------------------------------------------------------
--
-- Method:      showAxes
--
-- Description: Show Axes at position or proposed position
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .showAxes()

  -- Initialise variables
  !sjus       = !this.justification.selection()
  !xDist      = !this.xDistance.val
  !xDist      = !this.yDistance.val
  !mode       = !this.ce.selection()

  -- Until offsets from datum are allowed always set distance member to zero
  !this.distance = 0
  -- Remember where we are and navigate to the subject Floor
  !element = !!ce
  !!ce = !this.onFloor

  -- Set the Axes height depending on units
  if (defined(!!gphAxesEdit)) then
    !this.axes.height = !!gphAxesEdit.size.val
  else
    !this.axes.height = 500mm
  endif

  -- *****************
  -- SUB-FITTING code
  -- *****************
 if ((!mode eq 'MODIFY' and !this.element.type eq 'SBFI') or (!mode eq 'CREATES')) then

   if (!mode eq 'MODIFY') then
     !this.position = !this.element.owner.pPosition[!this.justification.selection().real()].wrt(!this.element.owner)
     !this.axes.orientation = !this.element.orientation.wrt(world)
     !sjus = !this.element.owner.sjus
   else
     !this.position = !this.element.pPosition[!this.justification.selection().real()].wrt(!this.element)
     !this.axes.orientation = !this.element.orientation.wrt(world)
     !sjus = !this.element.sjus
   endif

   -- Set the direction gadget to the actual z direction.
   !this.direction.val = !this.axes.orientation.zDir()

   -- adjust position to the XY and offset settings
   !this.position.east  = !this.position.east + !this.xDistance.val
   !this.position.north = !this.position.north + !this.yDistance.val

   if (!sjus inset('UTOP', 'UCEN', 'UBOT')) then
     !this.position.up    = !this.position.up + !this.distance
   else
     !this.position.up    = !this.position.up - !this.distance
   endif

 else

    -- ************
    -- GENERAL code
    -- ************

    if (!mode eq 'MODIFY') then
      !this.position = !this.element.position.wrt(world)
      !this.axes.orientation = !this.element.orientation.wrt(world)
    else
      !this.position = !this.onFloor.position.wrt(world)
      !this.axes.orientation = !this.onFloor.orientation.wrt(world)
    endif

    -- Position axes elevation relative to the justification
    if (!this.justification.selection() inset('UTOP', 'DTOP')) then
      !sjus = 'TOP'
    elseif (!this.justification.selection() inset('UBOT', 'DBOT')) then
      !sjus = 'BOTTOM'
    else
      !sjus = 'CENTRE'
    endif

    if (!this.justification.selection() inset('UTOP', 'UCEN', 'UBOT')) then
      !orientation = 'Z is ' & !this.onFloor.orientation.zDir() & ' and Y is ' & !this.onFloor.orientation.yDir()
      !ori  = !orientation.orientation()
      !this.axes.orientation = !ori
    else
      !orientation = 'Z is ' & !this.onFloor.orientation.zDir().opposite() & ' and Y is ' & !this.onFloor.orientation.yDir()
      !ori  = !orientation.orientation()
      !this.axes.orientation = !ori
    endif

    -- Set the direction gadget to the actual z direction.
    !this.direction.val = !ori.zDir()

    -- Plane normal to the panel
    !plane    = !!edgTypes.panel.plane(!this.onFloor, !sjus )

    -- Map passed position onto plane
    !this.position  = !plane.near(!this.position)

    -- adjust position to the XY and offset settings
    !this.position = !this.position.wrt(!this.onFloor)
    !this.position.east  = !this.xDistance.val
    !this.position.north = !this.yDistance.val

    if (!this.initialPass) then
      !this.position.up  = !this.distance
    else
      if (!this.justification.selection() inset('UTOP', 'UCEN', 'UBOT')) then
        !this.position.up    = !this.position.up + !this.distance
      else
        !this.position.up    = !this.position.up - !this.distance
      endif
    endif

  endif

  !this.axes.position = !this.position

  !this.axes.draw(!this.aidNumber)

  -- Draw a graphical plane to indicate the fitting position
  !this.plane.description = 'Floor fitting'
  !this.plane.plane.orientation = !this.axes.orientation
  !this.plane.plane.position    = !this.axes.position
  !this.plane.x = !this.axes.height * 0.5
  !this.plane.y = !this.axes.height * 0.5
  !this.plane.filled(true)
  !this.plane.detail = false
  !this.plane.tag    = true
  !this.plane.description = 'Fitting'

  !this.plane.draw(!this.planeNumber)

  --Show the sub fitting rotation angle
    !this.showDir('AndRotation')

  -- Unset the initialise flag
  !this.initialPass = false

  -- Navigate back to original element
  !!ce = !element

endmethod
-- End of method definition for .showAxes()

------------------------------------------------------------------------
--
-- Method:      noSpref
--
-- Description: Makes selection gadgets active/inactive if no specification is required
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .noSpref()

  if (!this.noSprefRequired.val) then
    !this.specifications.active = false
    !this.default.active        = false
    !this.autoSelect.active     = false
    !this.selected.active       = false
    !this.question.active       = false
    !this.perms.active          = false
    !this.accept.active         = false
    !this.plotfile.active       = false
    !this.ok.active          = true
  else
    !this.specifications.active = true
    !this.default.active        = true
    !this.autoSelect.active     = true
    !this.selected.active       = true
    !this.question.active       = true
    !this.perms.active          = true
    !this.accept.active         = true
    !this.plotfile.active       = true
    !this.specCallback()
  endif

endmethod
-- End of method definition for .noSpref()

------------------------------------------------------------------------
--
-- Method:      adjustDirection
--
-- Description: In modify mode this will immediately adjust the fitting direction Z
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .adjustDirection()

  if (!!ce.type eq 'SBFI') then
    !zDir = !this.direction.val
    ZDIR $!zDir
  endif

  -- Always call the rotation method
  !this.adjustRotation()

endmethod
-- End of method definition for .adjustDirection()

------------------------------------------------------------------------
--
-- Method:      adjustRotation
--
-- Description: In modify mode this will immediately adjust the fitting rotation around the Z axis
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .adjustRotation()

    if (!this.rotation.val.between(-180, 180).not()) then
      !!alert.error('Rotation Angle must be between 180 and -180 degrees')
    else
      if (!!ce.type eq 'SBFI') then
        !bang     = !this.rotation.val
        BANG $!bang
      endif
    endif

endmethod
-- End of method definition for .adjustRotation()

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !dummyB is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Pick Direction
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineDirection('')
    !packet.pickPacket.prompt = 'Derive Z direction from graphics'
    !packet.description = 'Pick floor fitting Z direction'
    !packet.action = '!!spcFFitSpecSel.direction(!this.return[1])'
    !!edgCntrl.add(!packet)
    return

  -- Opposite  Direction
  elseif (!option eq 'OPPOSITE') then
    !this.direction.val = !this.direction.val.opposite()

  -- Direction
  else

    -- Check we have an orientation
    !unused = !this.axes.orientation
    handle any
      return
    endhandle

     -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction.val = !this.axes.orientation.wrt(world).xDir()
    elseif (!option.match('Y').boolean()) then
      !this.direction.val = !this.axes.orientation.wrt(world).yDir()
    endif

  endif

  -- Carry out action
  !this.showDir('AndRotation')

endmethod
-- End of method definition for .setDirection(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.direction.val = !direction

  -- Carry out action
  !this.showDir('AndRotation')

endmethod
-- End of method definition for .direction(DIRECTION)
------------------------------------------------------------------------
--
-- Method:      showDir
--
-- Description:  Show the direction of a sub fitting by changing Axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .showDir(!action is STRING)

  -- First validate the new direction
  !testGadget = !this.direction.val
  handle ANY
    !!alert.error('Invalid input for Direction gadget.')
    return
  endhandle

  if (!this.ce.selection() eq 'MODIFY') then

    !!ce = !this.element
    !this.axes.orientation = !this.axes.orientation.wrt(world)
    !newDir = !this.direction.val
    -- Try to maintain Y is N as PDMS does
    !this.axes.orientation = object ORIENTATION('z is ' & !newDir & ' and  Y is N wrt ' & !this.element.owner)
    handle any
      -- Or maintain Y as U as PDMS does
    !this.axes.orientation = object ORIENTATION('z is ' & !newDir & ' and  Y is U wrt ' & !this.element.owner)
    endhandle

    !this.rotation.val = !this.rotaAngle
    !this.rotaAngle = 0

  else

    !!ce = !this.element
    !this.axes.orientation = !this.axes.orientation.wrt(world)
    !newDir = !this.direction.val
    -- Try to maintain Y is N as PDMS does
    !this.axes.orientation = object ORIENTATION('z is ' & !newDir & ' and  Y is N wrt ' & !this.element)
    handle any
      -- Or maintain Y as U as PDMS does
    !this.axes.orientation = object ORIENTATION('z is ' & !newDir & ' and  Y is U wrt ' & !this.element)
    endhandle

    !this.rotaAngle = 0

  endif

  -- Update Rotation
  if (!action eq 'AndRotation') then
    !this.showRot()
  endif

endmethod
-- End of method definition for .showDir(STRING)
------------------------------------------------------------------------
--
-- Method:      showRot
--
-- Description:  Show the rotation of a sub fitting by changing Axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .showRot()

  -- Any number can be input, convert it to -180 to 180
  !numbOfRotations   = !this.rotation.val / 360
  !inteOfRotations  = !numbOfRotations.int()
  !remainder           = !this.rotation.val - !inteOfRotations * 360
  if (!remainder gt 180) then
    !this.rotation.val = !remainder - 360
  elseif (!remainder lt -180) then
    !this.rotation.val = !remainder + 360
  else
    !this.rotation.val = !remainder
  endif

  if (!this.rotation.val.between(-180, 180).not()) then
    !!alert.error('Rotation Angle must be between 180 and -180 degrees')
    return
  else

    -- Create a dummy box
    STRU
    NEW BOX XLEN 100MM YLEN 100MM ZLEN 100MM
    !ref = !!ce
    !ori = !this.axes.orientation.wrt(world)
    !zDir = !ori.zDir()
    !xDir = !ori.xDir()
    !pos = !this.axes.position.wrt(world)
    ORI Z IS $!zDir AND X IS $!xDir
    POS $!pos
    !!ce = !this.element

    !this.axes.orientation.origin = !ref
    !this.axes.orientation.alpha = 0
    !this.axes.orientation.beta = 0

    if (!this.ce.selection() eq 'MODIFY') then
      !this.axes.orientation.gamma = !this.rotation.val - !this.rotaAngle
    else
      !this.axes.orientation.gamma =  -1 * (!this.rotaAngle - !this.rotation.val)
    endif
    !this.rotaAngle = !this.rotation.val
    !this.axes.draw(!this.aidNumber)
    !this.plane.plane.orientation = !this.axes.orientation
    !this.plane.draw(!this.planeNumber)

    !this.axes.orientation = !this.axes.orientation.wrt(world)
    !!ce = !ref
    DELETE BOX
    !!ce = !this.element
  endif

endmethod
-- End of method definition for .showRot()

------------------------------------------------------------------------
--
-- Method:      updateSubOri
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .updateSubOri()

  if (!this.ce.selection() eq 'CREATES' or (!!ce.type eq 'SBFI')) then
    -- Activate the orientation frame - active for sub fittings
    !this.direction.active = true
  else
    -- Activate the orientation frame - active only for sub fittings
    !this.direction.active = false
  endif

endmethod
-- End of method definition for .updateSubOri()

------------------------------------------------------------------------
--
-- Method:      showFloorAid
--
-- Description:
--   Show the floor aid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .showFloorAid()

  -- Set the Axes height depending on units
  if (defined(!!gphAxesEdit)) then
    !size = !!gphAxesEdit.size.val
  else
    !size = 500mm
  endif

  -- Draw a graphical plane to indicate the fitting position
  if (!this.ce.selection() eq 'MODIFY' and !this.element.type eq 'SBFI') then
    !this.floorAid.plane.orientation = !this.element.owner.orientation
    !this.floorAid.plane.position    = !this.element.owner.position
    !this.floorAid.description = '        Compound Fitting'
  elseif(!this.ce.selection() eq 'CREATES') then
    !this.floorAid.plane.orientation = !this.element.orientation
    !this.floorAid.plane.position    = !this.element.position
    !this.floorAid.description = '        Compound Fitting'
  else
    !this.floorAid.plane.orientation = !this.onFloor.orientation
    !this.floorAid.plane.position    = !this.onFloor.position
    !this.floorAid.description = '        Floor/Screed'
  endif

  !this.floorAid.x = !size * 4
  !this.floorAid.y = !size * 4
  !this.floorAid.filled(false)
  !this.floorAid.detail = true
  !this.floorAid.tag    = true
  !this.floorAid.draw(!this.floorAidNumber)

endmethod
-- End of method definition for .showFloorAid()

