--
-- Description:
-- Specific Form for creation and modification of WALLS and DOORS
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the form and apply the database attributes
--  autoSelect()                     -                   Automatic spec selection from the given preferences.
--  close()                          -                   Close form down
--  edit(DBREF)                      -
--  init(STRING,STRING)              -
--  initSpec(DBREF)                  -
--  initSpec(STRING,STRING)          -
--  maintainNewPos()                 -                   Maintain the new pos member when the elevation is changed
--  preference(STRING,ANY)           -
--  selectionDone()                  BOOLEAN             check to see if selection is complete (spec ref to SPCO)
--  setWrt()                         -                   Set up with new wrt item
--  spcSbfiSpecSel()                 -                   Constructor
--  specAccept()                     -                   Create/Modify item
--  specCallback()                   -
--  stlCalcPos(STRING)               -
--  strSbfiPosition(DBREF,EDGPOSITIONDATA) -
--
------------------------------------------------------------------------

-- Define form
 setup form !!spcSbfiSpecSel

--  !!spcSbfiSpecSel.formTitle     = 'Doors & Windows'
  !!spcSbfiSpecSel.formTitle     = 'User Defined Wall Fittings'
  !!spcSbfiSpecSel.iconTitle     = 'spcSbfiSpecSel'
  !!spcSbfiSpecSel.callback      = ''
  !!spcSbfiSpecSel.formRevision  = ' $Revision: 1.12 $ '

  -- Form Members -------------------------------------------------
  -- Link to form which invoked this form
  member .mainForm       is FORM

  -- Elements
  member .element        is DBREF
  member .oldWrtElement  is DBREF
  member .newWrtElement  is DBREF

  -- Remember elevation input
  member .elevInput      is REAL

  -- Position
  member .position       is POSITIONLINK

  -- picked Position
  member .newPosition    is POSITION

  -- Zdir store
  member .zDir           is STRING
  -- Beta angle store
  member .beta           is REAL

  --Common properties member
  member .properties     is COMPROP

  -- Link to spec system
  member .specLink       is SPCLINK
  -- specification search criteria
  member .specSearch     is SPCSEARCH
  -- what was the old Userdata (define members)
  member .specData       is SPECDATA
  member .dflts          is SPECDFLTS

  -- members for CE Spec selection
  member .storeSpec      is STRING
  member .storeGtyp      is STRING
  member .storeStyp      is STRING
  member .storeSpre      is STRING

  -- Body of form definition -------------------------------------------------

  -- CE / Create Modify
  option .ce '' at xmin+0.1 ymax   callback |call !!displaySpecSbfi('SBFI', 'OPTION') |  width 9
  var list _ce
    pairs |Create|    |CREATE|
          |Modify CE| |MODIFY|
  exit

  para .ceName at xmax ymin width 35 lines 2

 -- Spec selection
  frame .sframe at x0 ymax 'Specification Data'

    -- Permissible Spec
    option .specifications '' at xmin+1 ymax width 20

    -- Default Select mode
    toggle .default    'Default Selection' at xmax+3 ymin
    toggle .autoSelect 'Auto Selection'    at xmin ymax

    -- Available Types
    list .selected 'Current Selection' at x1   ymax    width 45 length 5
    list .perms                        at xmin ymax  width 45 length 5

    -- Display plot file
    path down
    halign right
    button .plotfile |Plotfile...|  callback |$p button should be inactive|

    para .question at xmin.perms ymin.perms-1 width 40 lines 1

    button .accept      |Properties...|   at xmin.perms    ymin.plotfile     callback '!this.specAccept()'

  exit

 -- Pline Settings
 frame .pframe at x0 ymax+0.2 |Positioning|

   -- Through position, used for GWALLs only and relates to the position on the bottom surface of the GWALL
   text .throPosition   at x1 ymax |Through position| call | | width 25 is STRING
   !this.throPosition.val = 'E 0.0 N 0.0 U 0.0 WRT /*'

   !zdisPixmap  = !!pml.getPathName('xyz16.png')
   !zdisiPixmap = !!pml.getPathName('xyzi16.png')

   -- button for zdistance/elevation pixmap
   button .ppix at xmax+1 ymin tooltip 'Position Element' pixmap sel "$!<zdisPixmap>" inact "$!<zdisiPixmap>" width 16  height 16 callback '!this.stlCalcPos(|SBFI|)'

   -- Elevation
   text .elevation  at x1 ymax |       Elevation| call |!this.maintainNewPos() | width 20 is REAL format !!distanceFmt
   !this.elevation.val = 0

   -- Position locks
   toggle .elevnLock 'lock'    at xmax.elevation+1 ymin.elevation  callback '!this.elevation.active = !this.elevnLock.val.not()'

   -- With respect to :-
   text .wrt  at x1 ymax.elevation |wrt| call '!this.setWrt()' width 43 string

   -- Beta angle rotation
   -- text .beta  at x2 ymax+1 |Beta angle rotation  | call | | width 33 is REAL
   -- !this.beta.val = 0

   -- Direction
   -- text .zDir  at x2 ymax   |  Surface Direction  | call | | width 33 is STRING
   -- !this.zDir.val = 'N 45 E WRT /*'

 exit

 -- Bottom Line
 button .cancel  |Dismiss| at xmax form-size  ymax callback '!this.close()'      CANCEL
 button .ok      |Apply|   at xmin form-0     ymin callback '!this.apply()'

-- End of form definition for !!spcSbfiSpecSel
exit

------------------------------------------------------------------------
--
-- Method:      spcSbfiSpecSel
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcSbfiSpecSel()

  -- SPECIFICATION setup
  !this.specSearch          = object SPCSEARCH()
  !this.specSearch.spwlType = ''
  !this.specSearch.type     = ''
  !this.specSearch.search()

  -- Generate links
  -- link specification display gadget with the spec search data
  !this.specLink.specification(!this.specifications, !this.specSearch)
  -- link current selected spec item gadget
  !this.specLink.selection(!this.selected)
  -- link permissible selection gadget
  !this.specLink.permissible(!this.perms)
  -- link question gadget
  !this.specLink.question(!this.question)
  -- link default gadget
  !this.specLink.default(!this.default)
  -- link auto select gadget
  !this.specLink.autoSelect(!this.autoSelect)
  -- set action for selection which sets parameters
  !this.specLink.setAction('!!spcSbfiSpecSel.specCallback()')

  -- Initialise the form with spec of correct type
  !this.initSpec('CIV', 'SBFI' )
  !this.specCallback()

  -- initialise the elevation wrt dbrefs
  !this.oldWrtElement = WORLD
  !this.newWrtElement = WORLD
  !this.wrt.val = 'World'

  --  Position gadget is not editable by user
  !this.throPosition.setEditable(false)

  -- Default for Zdir
  !this.zDir = 'N WRT /*'

endmethod
-- End of method definition for .spcSbfiSpecSel()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!dummyKeyword is STRING, !mode is STRING )

  -- Initialise the form with the correct specs
  if (!this.specifications.rText.size() gt 1) then

    -- Option gadget on form used. Selection will be CREATE or MODIFY
    if (!mode.upcase() eq 'OPTION') then
        !mode = !this.ce.selection()
    endif

    -- Creation mode
    if (!mode.upcase() eq 'CREATE') then
      !element = !!ce
      !dbRef = !!dtbGetOwnerType(!!ce, 'GWALL')
      if (!dbRef.unset()) then
        !!alert.message('Navigate to a User Defined Wall.')
        if (!this.element.unset()) then
          !this.hide()
        endif
        return
      else
        !!ce = !dbRef
      endif

      -- initialise the form in create mode
      !this.element = !!ce
      !this.ceName.val = 'New Fitting in  ' + !!ce.fullName
      !this.beta = 0
      !this.zDir = 'n 45 e wrt /*'
      !this.elevation.val = 0

      -- record the elevation input
      !this.elevInput = !this.elevation.val

      -- With respect to code
      !this.oldWrtElement = !this.element
      !this.newWrtElement = !this.element
      !this.wrt.val = !this.element.fullName
      !this.setWrt()

      !this.ce.select('RTEXT', 'CREATE')

      -- Initialise the form with spec of correct type
      !this.initSpec('CIV', 'SBFI' )
      !this.specCallback()
      !!ce = !element

    -- Modification mode
    elseif (!mode.upcase() eq 'MODIFY') then

      -- Quick check to see if at the CMPF of the SBFI
      if (!!ce.type eq 'CMPF') then
        if (!!ce.owner.type eq 'GWALL') then
          -- navigate to the sub fitting
          SBFI 1
          handle any
            !!alert.message('Wrong type of fitting.')
            if (!this.element.unset()) then
              !this.hide()
            endif
            return
          endhandle
        endif
      endif

      -- Sub Fittings on Panel type walls
      if (!!ce.type eq 'SBFI') then

        if (!!ce.owner.owner.type eq 'GWALL') then

          -- Current fixing
          !this.element = !!ce
          !this.ceName.val = !!ce.fullName

          -- Position
          !this.throPosition.val = !!ce.owner.position.wrt(worl).string()

          -- Maintain newPosition member
          !this.newPosition = !!ce.pPosition[100].wrt(world)
          handle any
            !!alert.error('All GWALL fittings must have a PPoint number 100')
          endhandle

          -- Elevation
          if (defined(!!ce.desp[1])) then
            !this.elevation.val = !!ce.ddesp[1]
          else
            !this.elevation.val = 0
          endif

          -- record the elevation input
          !this.elevInput = !this.elevation.val

          -- z direction member
          -- I should be using the following line but there seems to be a bug.
          --!this.zDir = !!ce.zDir.wrt(world).string()
          !this.zDir = !!ce.ori.wrt(world).string().after('Z is ')

          -- Beta rotation angle member
          !this.beta = !!ce.bang

          -- With respect to code
          !this.oldWrtElement = !this.element.owner.owner
          !this.newWrtElement = !this.element.owner.owner
          !this.wrt.val = !this.element.owner.owner.fullName
          !this.setWrt()

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

        else
          !!alert.message('Wrong type of fitting.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif


      else
        !!alert.message('Wrong type of element.')
        if (!this.element.unset()) then
          !this.hide()
        endif
        return
      endif

      -- Initialise the form with known spref
      !this.initSpec(!this.element.spref)
      !this.specCallback()

    endif

  endif

endmethod
-- End of method definition for .init(STRING, STRING )
------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description:
--   Initialise Form with given spec type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Spec world type (PURP)
--    2   R      STRING      Spec type (PURP)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spwlType is STRING, !specType is STRING )

  !this.mainForm = !this.owner()

  -- check for change to current spec
  if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
    -- spec changed, reset form
    !this.specSearch.spwlType = !spwlType
    !this.specSearch.type     = !specType
    !this.specSearch.search()
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif
  !this.specLink.setup( object SPCSPECIFICATION() )

endmethod
-- End of method definition for .initSpec( STRING, STRING )

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description:
--   Initialise Form with given SPEC or SPCO DBREF
--   Passing a null ref will just bring up the currently selected specs.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of SPCO used to initialise this form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spec is DBREF )

  if( badref(!spec) ) then
    -- initialise spec
    !this.specLink.setup( object SPCSPECIFICATION() )
  else
    -- get type of SPEC
    !specEl = SPEC OF $!spec
    !specType = !specEl.purp
    !spwlEl = SPWL OF $!spec
    !spwlType = !spwlEl.purp
    -- check that form is initialised for this type of object
    if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
      !this.specSearch.spwlType = !spwlType
      !this.specSearch.type     = !specType
      !this.specSearch.search()
      !this.specLink.specification(!this.specifications, !this.specSearch)
    endif
    -- set form to existing spec
    !this.specLink.specData.selector( !spec )
    !this.specLink.setup(!this.specLink.specData)
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif

  -- if dbref was known then no need to accept
  !this.ok.active = true

endmethod
-- End of method definition for .initSpec( DBREF )

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description: Initialise Form with given spec type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Spec world type (PURP)
--    2   R      STRING      Spec type (PURP)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spwlType is STRING, !specType is STRING )

  !this.mainForm = !this.owner()

  -- check for change to current spec
  if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
    -- spec changed, reset form
    !this.specSearch.spwlType = !spwlType
    !this.specSearch.type     = !specType
    !this.specSearch.search()
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif
  !this.specLink.setup( object SPCSPECIFICATION() )

endmethod
-- End of method definition for .initSpec( STRING, STRING )

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Initialise Form with given DBREF of an item with a spref
--   Passing a null ref will just bring up the currently selected specs.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit( !objectWithSpref is DBREF )

  if( badref(!objectWithSpref) ) then
    -- setup form gadgets for select from top level
    !this.specLink.setup( object SPCSPECIFICATION() )
  else
    -- setup form gadgets for spref already set
    !spref = !objectWithSpref.spref
    handle any
      !spref = object DBREF()
    endhandle
    if( !spref.set() ) then
      -- set form to existing spec
      !this.specLink.setup( !objectWithSpref )
    endif
  endif

  -- grey out owning form until selection complete
--  !this.mainForm.setActive(false)

endmethod
-- End of method definition for .edit( DBREF )

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove the event driven graphics in case the form was dismissed
  !!edgCntrl.remove('Position User Defined Wall Fitting')

  -- Tidy the properties member
  !this.properties.deleteObject()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      specAccept
--
-- Description:
--   Create/Modify item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specAccept()

  -- Initialise Variables
  !selectedSpre = !this.specLink.selection()

  -- error if selection not complete - must be a SPCO
  if( !selectedSpre.type.upcase() ne 'SPCO' ) then
    !!alert.error( 'Specification selection not complete' )
    return
  endif

  -- Show the properties form
  !this.properties.editProperties()

  -- Set the ok button active
  !this.ok.active = true

endmethod
-- End of method definition for .specAccept()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Apply the form and apply the database attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Local variable for Modify
  -- action will be create or modify
  !action =   !this.ce.selection()
  -- item could be fitting or stwall OR fixing or wall
  !item = !this.element
  -- selected spref is the new selection
  !selectedSpre = !this.specLink.selection()

  -- Navigate to wall if in create mode
  !!ce = !item

  -- Create or modify on STWALL or WALL
  if (!this.ce.selection() eq 'CREATE') then
    if (!this.element.type eq 'GWALL') then
      !!ce = !this.element
      NEW CMPF
      var !sjus SJUS OF PLOOP 1 OF GWALL
      handle any
        -- no panel loop
        DELETE CMPF
        !!alert.error('GWALL must have a PLOO')
        return
      endhandle
      SJUS $!sjus
      NEW SBFI
      !item = !!ce
      !action = 'MODIFY'
    else
      !!alert.error('Not on a User Defined Wall')
    endif
  endif

  -- Even create is now in modify mode because required elements have now been created.
  if (!action eq 'MODIFY') then

    -- Set design parameters if there are any
    !this.properties.setProperties(!!ce)
    !this.properties.unsetDesiElement()

    -- item will be fitt or fixing. Next do sub fitting on wall
    if (!item.type eq 'SBFI') then

      -- Position
      !!ce =!item.owne
      POSITION $!this.newPosition
      !!ce =!item

      -- Elevation
      !diff = !item.position.wrt(!this.newWrtElement).up - !item.position.wrt(!item.owner.owner).up
      !despOne = !this.elevation.val - !diff
      DDESP N1 $!despOne

      -- z direction
      ZDIR $!this.zDir

      --Beta Angle may need setting to 0 , 90 or 180 degree
      !a = !!spcSbfiSpecSel.newPosition.wrt(worl).up.int()
      !b = !!ce.pPosition[100].wrt(worl).up.int()
      handle any
        !!alert.error('All GWALL fittings must have a PPoint number 100')
      endhandle
      !diffab = !a - !b
       --q var !a !b !diffab
      if (!diffab.between(-1, 1).not()) then
        if (!!ce.bang eq 180) then
          BANG 0
        else
          BANG 180
        endif
      endif
      -- do it again to check its worked if not must be 90 deg
      !a = !!spcSbfiSpecSel.newPosition.wrt(worl).up.int()
      !b = !!ce.pPosition[100].wrt(worl).up.int()
      handle any
        !!alert.error('All GWALL fittings must have a PPoint number 100')
      endhandle
      !diffab = !a - !b
     --  q var !a !b !diffab
      if (!diffab.between(-1, 1).not()) then
        BANG 90
      endif

    endif

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      selectionDone
--
-- Description:
--   check to see if selection is complete (spec ref to SPCO)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectionDone() is BOOLEAN

  -- Initialise Variables
  !result       = false
  -- Clear design parameters
  !selectedSpre = !this.specLink.selection()

  if(!selectedSpre.badRef().not()) then
    if(!selectedSpre.type.upcase() eq 'SPCO' and (!selectedSpre.catr.badRef().not() or !selectedSpre.tmpr.badRef().not()) ) then
    -- error if selection not complete - must be a SPCO
     !result = (!selectedSpre.type.upcase() eq 'SPCO')
    endif
  endif

  return !result

endmethod
-- End of method definition for .selectionDone() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      specCallBack
--
-- Description:
--   Function called when spec selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specCallback()

  -- initialise variables
  !specSelection = !this.specLink.selection()

  -- allow user to OK if got to a SPCO
  !selectionDone = !this.selectionDone()
  !this.accept.active   = !selectionDone
  !this.plotfile.active = !selectionDone

  if (!this.accept.active eq false) then
    !this.ok.active = false
  else
    if (!specSelection eq !this.element.spref) then
      !this.properties.initialise(!this.element)
      !this.properties.unsetDesiElement()
    else
      !this.properties.initialise(!specSelection)
      -- if the properties are edited cache them
      !this.properties.autoCacheValues(true)
    endif

    -- Only if there are no properties for user input then make the Apply active.
    -- For templates
    !coll = ARRAY()
    if (!specSelection.tmpRef.set() and !specSelection.tmpRef.badRef().not()) then
      var !coll COLLECT ALL DATA WITH (PURP INSET('ATTR', 'DESP')) FOR $!specSelection.tmpRef
    endif
    -- For non templates
    if (!specSelection.catRef.set() and !specSelection.catRef.badRef().not()) then
      if (!specSelection.catRef.dtRef.set() and !specSelection.catRef.dtRef.badRef().not()) then
        !dtRef = !specSelection.catRef.dtRef
        var !coll COLLECT ALL DATA WITH (PURP INSET('ATTR', 'DESP')) FOR $!dtRef
      endif
    endif
    if (!coll.size().eq(0)) then
      !this.accept.active = false
      !this.ok.active = true
    endif
  endif

  -- Set the plotfile callback
  -- We are now allowing for a SELE with a set ICON attribute
  -- to store plotfile information.
  -- Format will be ICON 'DirName FileName PlotStyle'
  -- example ICON 'WALLS AWALLPLOT LPLT' meaning
  -- %PDMSPLOTS/WALLS/AWALLPLT displayed as a Landscape plot.
  -- PPLT = portrait plot

  if (!this.specLink.selection().type eq 'SELE') then
    if (!this.specLink.selection().icon eq '') then
      !this.plotfile.active = false
    else
      !this.plotfile.active = true
    endif
  endif
  !selectedSpref = !this.specLink.selection().name
  !this.plotfile.callback = |CALLSTL XSTLPLOT $!selectedSpref|

endmethod
-- End of method definition for .specCallback()

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description:
--   set preferences for auto selection of spec from geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of selection key
--    2   R      ANY         Value of selection key
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference( !key is STRING, !answer is ANY )

  -- add the preference
  !this.specLink.specData.preference(!key, !answer)

endmethod
-- End of method definition for .preference( STRING, ANY )

------------------------------------------------------------------------
--
-- Method:      autoSelect
--
-- Description:
--   Automatic spec selection from the given preferences.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoSelect()

  -- Find entries that conform to the preferences
  !this.specLink.actionAutoSelect()

  -- clear the preferences
  !this.specLink.specData.preferenceClear()

endmethod
-- End of method definition for .autoSelect()
------------------------------------------------------------------------
--
-- Method:      stlCalcPos
--
-- Description:
--   Calculate the Zdist for the fitting/fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlCalcPos( !mode is STRING )

  -- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- navigate to SBFI if in modify mode or GWALL if in create mode
  !item = !this.element

  !prompt     = 'Pick Fitting Position on Vertical Surface of GWALL'
  !screenText = 'Through Position'
  !position   = !item.position.wrt(world)


  -- Show standard basic position definition
  !!pos3D.edit('!!spcSbfiSpecSel.strSbfiPosition(!!spcSbfiSpecSel.element, !!pos3D.positionData)', !position, !prompt, !screenText, false, 'Position User Defined Wall Fitting')


endmethod
-- End of method definition for .stlCalcPos( STRING )
------------------------------------------------------------------------
--
-- Method:      maintainNewPos
--
-- Description:
--   Maintain the new pos member when the elevation is changed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .maintainNewPos()

  -- Maintain new position member up
  -- Old input is always stored on .elevInput member
  if (!this.newPosition.unset()) then
    !this.newPosition = E0N0U0 WRT WORLD
  endif

  !diff = !this.elevation.val - !this.elevInput
  !this.newPosition.up = !this.newPosition.up + !diff


  -- re record elevation input
  !this.elevInput = !this.elevation.val

endmethod
-- End of method definition for .maintainNewPos()
------------------------------------------------------------------------
--
-- Method:      strSbfiPosition
--
-- Description: Calculates the sub fitting position on the GWALL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strSbfiPosition(!fitting is DBREF, !positionData is EDGPOSITIONDATA )

  -- initialise position variable
  !position = !positionData.position

  -- Could be that fitting is not as yet created so...
  if (!fitting.type eq 'SBFI') then
    !section = !fitting.owner.owner
  else
    !section = !fitting
  endif

  -- Panel based elements
  if (!section.hardType eq 'PANE') then

    -- remember the current element and navigate to the wall
    !element = !!ce
    !!ce = !section

    -- Beta Angle
    -- must be done on form apply

    -- Z direction
    !positionData.plane()
    if (!positionData.plane.set()) then
      !this.zDir = !positionData.plane.orientation.zDir().string()
    endif

    -- Elevation
    if (!this.elevation.active) then
      !elev = !!pos3D.position.position.wrt(!this.newWrtElement).up
      !this.elevation.val = !elev
      -- record the elevation input
      !this.elevInput = !this.elevation.val
    endif

    -- Split the new position info
    !this.newPosition = !!pos3D.position.position.wrt(!this.newWrtElement)
    !this.newPosition.up = !this.elevInput

    -- through position
    !this.throPosition.val  = !this.newPosition.wrt(world).string(!!distanceFmt)

    -- Maintain the newPosition elevation
    !this.maintainNewPos()

    -- navigate back to original element
    !!ce = !element

    -- Make the displayed elevation relative to the wall
    !this.oldWrtElement = !section
    !this.newWrtElement = !section
    !this.wrt.val = !section.fullName
    !this.setWrt()

  endif

endmethod
-- End of method definition for .strSbfiPosition(DBREF, EDGPOSITIONDATA )

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !wrtElement = object DBREF()
  endhandle

  -- use current positions origin if it null
  if(!wrtElement.unset()) then
    !wrtElement      = !this.oldWrtElement
  else
    !this.newWrtElement = !wrtElement
  endif

  -- Record elevation value from previous wrt element
  if (!this.oldWrtElement.type INSET ('STWALL', 'WALL')) then
    var !oldWrtX POS PPLINE IBOW OF $!this.oldWrtElement WRT WORLD
    !oldWrt = !oldWrtX.position().wrt(world).up
  else
    !oldWrt = !this.oldWrtElement.position.wrt(world).up
  endif

  -- New elevation wrt to the elevation wrt gadget value
  if (!this.newWrtElement.type INSET ('STWALL', 'WALL')) then
    var !newWrtX POS PPLINE IBOW OF $!this.newWrtElement  WRT WORLD
    !newWrt = !newWrtX.position().wrt(world).up
  else
    !newWrt = !this.newWrtElement.position.wrt(world).up
    handle (2,201)
      -- element may not have a position (example frmw)
      !!alert.message('Ref element does not have a position.')
      if (!this.oldWrtElement.type INSET ('STWALL', 'WALL')) then
        var !newWrtX POS PPLINE IBOW OF $!this.oldWrtElement WRT WORLD
       !newWrt = !newWrtX.position().wrt(world).up
      else
       !newWrt = !this.oldWrtElement.position.wrt(world).up
      endif
      -- reset wrt new element as it was
      !this.newWrtElement = !this.oldWrtElement
      !wrtElement = !this.newWrtElement
    endhandle
  endif

  -- Maintain/display the elevation in the gadget
  !this.elevation.val = !this.elevation.val + (!oldWrt - !newWrt)
  !this.oldWrtElement = !this.newWrtElement

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.fullName

  -- record the elevation input
  !this.elevInput = !this.elevation.val

endmethod
-- End of method definition for .setWrt()
