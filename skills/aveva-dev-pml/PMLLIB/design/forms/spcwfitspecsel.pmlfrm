--
-- File:            spcwfitspecsel.pmlfrm
--   Type:          Form Definition
--   Group:         Wall fittings Specification selector
--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          steve.bentley
-- Created:         Wed Jan 20 15:37:35 "GMT 1999
--
--
-- Description:
-- Specific Form for creation and modification of wall fittings
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjustDirection()                -                   In modify mode this will immediately adjust the fitting direction Z
--  adjustRotation()                 -                   In modify mode this will immediately adjust the fitting rotation around the Z axis
--  apply()                          -                   Apply the form and apply the database attributes
--  autoSelect()                     -                   Automatic spec selection from the given preferences.
--  close()                          -                   Close form down
--  direction(DIRECTION)             -                   Setup to direction of offset
--  edit(DBREF)                      -
--  init(STRING,STRING)              -
--  initSpec(DBREF)                  -
--  initSpec(STRING,STRING)          -
--  measure(LINE)                    -                   Setup to measure distance
--  noSpref()                        -                   Makes selection gadgets active/inactive if no specification is required
--  popWrt(STRING)                   -                   updates gadgets depending on the 'with' selection
--  posCalcZDist(POSITION)           -
--  preference(STRING,ANY)           -
--  selectionDone()                  BOOLEAN             Check to see if selection is complete (spec ref to SPCO)
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setMeasure(MENU,STRING)          -                   Setup to measure offset
--  setOffset()                      -                   Set the elevation offset to the offset of the current storage level.
--  setWrt()                         -                   Set up with new wrt item
--  showAxes()                       -                   Show Axes at position or proposed position
--  showDir(STRING)                  -                   Show the direction of a sub fitting by changing Axes
--  showRot()                        -                   Show the rotation of a sub fitting by changing Axes
--  spcWFitSpecSel()                 -                   Constructor
--  specAccept()                     -                   Create/Modify item
--  specCallback()                   -
--  stlCalcZDist()                   -                   Calculate the Zdist for the fitting/fixing
--  strFitPosition(DBREF,STRING,STRING,POSITION) ARRAY               Calculates the fixing/fitting position on the passed section/gensec.
--  updateSubOri()                   -                   Setup to direction of offset
--  validateDistance(GADGET,STRING)  -                   Validate input to distance gadgets
--
 setup form !!spcWFitSpecSel

  !!spcWFitSpecSel.formTitle     = 'Wall Fittings'
  !!spcWFitSpecSel.iconTitle     = 'spcWFitSpecSel'
  !!spcWFitSpecSel.callback      = ''
  !!spcWFitSpecSel.formRevision  = ' $Revision: 1.16 $ '

  -- Form Members -------------------------------------------------
  -- Link to form which invoked this form
  member .mainForm       is FORM

  -- Elements
  member .element        is DBREF
  member .oldWrtElement  is DBREF
  member .newWrtElement  is DBREF
  member .hpref          is DBREF
  member .onWall         is DBREF

  -- Axes definition
  member .axes           is GPHAXES
  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Position
  member .position       is POSITION

  -- Graphical Plane
  member .plane          is GPHPLANE
  member .planeNumber    is REAL

  -- Aid numbers for Inside/Outside text.
  member .aidNumberI     is REAL
  member .aidNumberO     is REAL

  --Common properties member
  member .properties     is COMPROP

  -- Beta angle store
  member .betaAngle      is REAL
  member .rotaAngle      is REAL

  -- Link to spec system
  member .specLink       is SPCLINK
  -- specification search criteria
  member .specSearch     is SPCSEARCH
  -- what was the old Userdata (define members)
  member .specData       is SPECDATA
  member .dflts          is SPECDFLTS

  -- members for CE Spec selection
  member .storeSpec      is STRING
  member .storeGtyp      is STRING
  member .storeStyp      is STRING
  member .storeSpre      is STRING

  -- Body of form definition -------------------------------------------------

  -- CE / Create Modify
  option .ce '' at xmin ymax   callback |call !!displaySpecSel('WFIT', 'OPTION') |  width 15
  var list _ce
    pairs |Create Standard| |CREATE|
          |Create Compound| |CREATEC|
          |Create Sub-Compound| |CREATES|
          |Modify CE|       |MODIFY|
  exit

  para .ceName at xmax ymin width 30 lines 2

 -- Spec selection
  frame .sframe at x0 ymax 'Specification Data' width 49

    -- Permissible Spec
    option .specifications '' at xmin+1 ymax width 25

    -- To allow creation without a spref, mainly for compound fittings.
    toggle .noSprefRequired    'No Selection' at xmax+1 ymin callback '!this.noSpref()'

    -- Default Select mode
    toggle .default    'Default' at xmin ymax
    toggle .autoSelect 'Auto'    at xmin ymax

    -- Available Types
    list .selected 'Current Selection' at x1   ymax    width 43 length 4
    list .perms                        at xmin ymax+1  width 43 length 4

    -- Display plot file
    path down
    halign right
    button .plotfile |Plotfile...|  callback |$p button should be inactive|

    para .question at xmin.perms ymin.perms-1 width 40 lines 1

    button .accept   |Properties...|   at xmin.perms    ymin.plotfile     callback '!this.specAccept()'

  exit

 -- Pline Settings
 frame .pframe at x0 ymax+0.2 |Positioning| width 49

   !zdisPixmap  = !!pml.getPathName('xyz16.png')
   !zdisiPixmap = !!pml.getPathName('xyzi16.png')

   -- Justification of Section
   option   .justification |Dist offset from| call | !this.showAxes() | at x1 y1 width 15
   var list _justification
     pairs |Outside of Wall | |OBOW|
           |Inside of Wall  | |IBOW|
   exit

   text .distance at xmax ymin || call | !this.showAxes() | width 8 is REAL format !!distanceFmt
   !this.distance.val = 0

   text .zDistance   at x1 ymax.justification |Dist along wall | call | !this.showAxes() | width 16 is REAL format !!distanceFmt
   !this.zDistance.val = 0

   text .elevation  at x1 ymax |       Elevation| call | !this.showAxes() | width 16 is REAL format !!distanceFmt
   !this.elevation.val = 0

   -- button for zdistance/elevation pixmap
   button .zpix at xmax+8 ymin-0.5 tooltip 'Position Fitting' pixmap sel "$!<zdisPixmap>" inact "$!<zdisiPixmap>" width 16  height 16 callback '!this.stlCalcZDist()'

   toggle .zDistLock 'lock'    at xmax.zDistance+1 ymin.zDistance  callback '!this.zDistance.active = !this.zDistLock.val.not()'
   toggle .elevnLock 'lock'    at xmax.elevation+1 ymin.elevation  callback '!this.elevation.active = !this.elevnLock.val.not()'

   -- With respect to :-
   text .wrt  at x1 ymax.elevation |wrt| call '!this.setWrt()
   !this.showAxes()' width 41 string
 exit

 frame .oframe at x0 ymax+0.2 |Sub-Fitting Orientation| width 49
   -- Direction
   text .direction at x1 ymax |Sub-Fitting Direction ('Z') | call | !this.showDir('AndRotation') | width 16 is DIRECTION
   !this.direction.val = N

   path down
   halign right

    -- Beta Rotation Angle
   text .rotation  |Rotation Angle ('Z' axis) | call | !this.showRot() | width 16 is REAL
   !this.rotation.val = 0
 exit

  -- Bottom Line
  button .cancel  |Dismiss| at xmax form-size  ymax callback '!this.close()'
  button .ok      |Apply|   at xmin form-0     ymin callback '!this.apply()'

-- End of form definition for !!spcWFitSpecSel
exit

------------------------------------------------------------------------
--
-- Method:      spcWFitSpecSel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcWFitSpecSel()

  -- Gadget validation calls
  !this.distance.validateCall  = '!this.validateDistance('
  !this.zDistance.validateCall = '!this.validateDistance('
  !this.elevation.validateCall = '!this.validateDistance('
  !this.rotation.validateCall  = '!this.validateDistance('

  -- SPECIFICATION setup
  !this.specSearch          = object SPCSEARCH()
  !this.specSearch.spwlType = ''
  !this.specSearch.type     = ''
  !this.specSearch.search()

  -- Generate links
  -- link specification display gadget with the spec search data
  !this.specLink.specification(!this.specifications, !this.specSearch)
  -- link current selected spec item gadget
  !this.specLink.selection(!this.selected)
  -- link permissible selection gadget
  !this.specLink.permissible(!this.perms)
  -- link question gadget
  !this.specLink.question(!this.question)
  -- link default gadget
  !this.specLink.default(!this.default)
  -- link autoSelect gadget
  !this.specLink.autoSelect(!this.autoSelect)
  -- set action for selection which sets parameters
  !this.specLink.setAction('!!spcWFitSpecSel.specCallback()')

  -- Initialise the form with spec of correct type
  !this.initSpec('CIV', 'WFIT' )
  -- Initialise the form with the correct specs
  if (!this.specSearch.specifications.size() eq 0) then
    return
  endif
  !this.specCallback()

  -- initialise the elevation wrt dbrefs
  !this.oldWrtElement = WORLD
  !this.newWrtElement = WORLD
  !this.wrt.val = 'World'

  -- Allocate aid numbers
  !this.aidNumber   = !!aidNumbers.add('Axes')
  !this.aidNumberI  = !!aidNumbers.add('Inside')
  !this.aidNumberO  = !!aidNumbers.add('Outside')
  !this.planeNumber = !!aidNumbers.add('Fitting Plane')

  -- Define default axes
  !gphAxes             = object GPHAXES()
  !gphAxes.tag         = false
  !gphAxes.detail      = false
  !gphAxes.position    = object POSITION('N0')
  !gphAxes.orientation = object ORIENTATION('Y is N')
  !this.axes           = !gphAxes

  -- Collect all levels to put on the wrt gadget as a right hand mouse pull down
  var !coll COLLECT ALL STRU WITH (PURP EQ 'LEVL') FOR /*

  !menu = !this.newMenu('WRTS')
  !menu.clear()
    !menu.add('CALLBACK', |CE       |,   '!this.popWrt(|ce|)')
    !menu.add('CALLBACK', |Structure|,   '!this.popWrt(|stru|)')
    !menu.add('CALLBACK', |Zone     |,   '!this.popWrt(|zone|)')
    !menu.add('CALLBACK', |Site     |,   '!this.popWrt(|site|)')
    !menu.add('CALLBACK', |World    |,   '!this.popWrt(|/*|)')
    !menu.add('MENU',     |Levels|,      'LEVELS')
--    !menu.add('CALLBACK', |Update   |,   '!this.popWrt(|update|)')
  !menu = !this.newMenu('LEVELS')
  !menu.clear()
  do !i indices !coll
    !name = !coll[!i].dbRef().namn
    !refe = !coll[!i].dbRef().refe
    !menu.add('CALLBACK', |$!name|, '!this.popWrt(|$!refe|)')
  enddo
  !this.wrt.setPopup(!this.wrts)

  -- Right hand button menu for Elevation
  !menu = !this.newMenu('PopElevation')
  !menu.clear()
    !menu.add('CALLBACK', |0.0|,   '!this.elevation.val = 0
    !this.setWrt()
    !this.showAxes()')
    !menu.add('CALLBACK', |Storage Level|,   '!this.setOffset()')
  !this.elevation.setPopup(!this.popElevation)

   -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!!spcWFitSpecSel.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!!spcWFitSpecSel.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!!spcWFitSpecSel.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!!spcWFitSpecSel.setDirection(')
  !this.direction.setPopup(!this.directionMenu)

  -- Distance
  !menu = !this.newMenu('distanceMenu')
    !menu.add('CALLBACK', '0.0',              '!this.distance.val = 0
    !this.showAxes()')
    !menu.add('CALLBACK', '+/-',              '!!spcWFitSpecSel.setMeasure(')
    !menu.add('CALLBACK', 'Measure',          '!!spcWFitSpecSel.setMeasure(')
    !menu.add('CALLBACK', 'Measure Shortest', '!!spcWFitSpecSel.setMeasure(')
  !this.distance.setPopup(!this.distanceMenu)

    -- Distance
  !menu = !this.newMenu('rotationMenu')
    !menu.add('CALLBACK', '+/-',  '!this.rotation.val = -1 * !this.rotation.val
    !this.showRot()')
    !menu.add('CALLBACK', '0',    '!this.rotation.val = 0
    !this.showRot()')
    !menu.add('CALLBACK', '45',   '!this.rotation.val = 45
    !this.showRot()')
    !menu.add('CALLBACK', '-45',  '!this.rotation.val = -45
    !this.showRot()')
    !menu.add('CALLBACK', '90',   '!this.rotation.val = 90
    !this.showRot()')
    !menu.add('CALLBACK', '-90',  '!this.rotation.val = -90
    !this.showRot()')
    !menu.add('CALLBACK', '135',  '!this.rotation.val = 135
    !this.showRot()')
    !menu.add('CALLBACK', '-135', '!this.rotation.val = -135
    !this.showRot()')
    !menu.add('CALLBACK', '180',  '!this.rotation.val = 180
    !this.showRot()')
  !this.rotation.setPopup(!this.rotationMenu)

  -- Set the cancel call member
  !this.cancelCall = '!this.close()'

endmethod
-- End of method definition for .spcWFitSpecSel()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!dummy is STRING, !mode is STRING )

  --initialise variables
  !dText = ARRAY()
  !rText = ARRAY()
  !this.rotaAngle = 0

  -- Initialise the form with the correct specs
  if (!this.specifications.rText.size() gt 1) then

    -- Option gadget on form used. Selection will be CREATE or MODIFY
    if (!mode.upcase() eq 'OPTION') then
      !mode = !this.ce.selection()
      -- Grey out the Apply button every time the create/modify pressed
      --!this.ok.active = false
      --!this.accept.active = false
    endif

-- **********************************************************************************************
-- CREATE MODE
-- **********************************************************************************************

    -- Wall fitting Creation mode, can be CREATE or MODIFY
    if (!mode.upcase() inset ('CREATE', 'CREATEC', 'CREATES')) then

      -- justification list is different for sub-fittings
      !dText.clear()
      !rText.clear()
      !dText[1] = |Outside of Wall |
      !rText[1] = |OBOW|
      !dText[2] = |Inside of Wall |
      !rText[2] = |IBOW|
      !this.justification.dText = !dText
      !this.justification.rText = !rText

      -- CREATE SUB FITTINGS VALIDATION
      -- ******************************
      if (!mode.upcase() eq 'CREATES') then
        -- if for a sub fitting
        !element = !!ce
        CMFI
        handle any
          FIXING
          handle any
            !!alert.message('Navigate to a compound fitting of a straight wall, or to a fixing of a curved wall.')
            if (!this.element.unset()) then
              !this.hide()
            endif
            return
          endhandle
        endhandle

        -- Must be a wall sub fitting rather than a beams & columns fitting
        if (!!ce.owner.type inset ('STWALL', 'PLDATU')) then
          -- ok
        else
          !!alert.message('Navigate to a compound fitting of a straight wall, or to a fixing of a curved wall.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif

        -- Wall of the current sub fitting must have a spref
        !wall = !!dtbGetOwnerType(!!ce, 'WALL STWALL')
        if (!wall.spref.badRef()) then
          !!alert.message('Wall badly defined.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif

        -- justification list is different for sub-fittings
        !dText.clear()
        !rText.clear()
        !dText[1] = |Compound Fitting|
        if (!!ce.type eq 'CMFI') then
          !rText[1] = !!ce.posl
        else
          !rText[1] = !!ce.owner.posl
        endif
        if (!rText[1].upcase() eq 'IBOW') then
          !dText[1] = 'Inside of Wall '
        else
          !dText[1] = 'Outside of Wall '
        endif

        !this.justification.dText = !dText
        !this.justification.rText = !rText

      -- CREATE FITTING or COMPOUND FITTING FORM INITIALISATION
      -- ******************************************************
      else
        -- elseif for a fitting or compound
        !element = !!ce
        STWALL
        handle any
          WALL
          handle any
            !!alert.message('Navigate to a Wall.')
            if (!this.element.unset()) then
              !this.hide()
            endif
            return
          endhandle
        endhandle

        -- The wall must have a spref
        if (!!ce.spref.badRef()) then
          !!alert.message('Wall badly defined.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif
      endif

-- **********************************************************************************************
-- CREATE MODE - Initial validation done above
-- **********************************************************************************************


       -- initialise the form in create mode
      !this.element = !!ce
      -- CREATE SUB FITTINGS FORM INITIALISATION
      -- ***************************************
      if (!mode.upcase() eq 'CREATES') then
        !wall = !!dtbGetOwnerType(!!ce, 'WALL STWALL')
        if (!wall.type eq 'STWALL') then
          !this.onWall = !wall
          !this.ceName.val = 'Fitting in ' + !!ce.fullName
          !this.ce.select('RTEXT', !mode.upcase() )
          !this.justification.val = 1
          !this.zDistance.val = !this.element.zDist
          !this.betaAngle = 0
          !this.elevation.val = 0

          -- With respect to code
          !this.oldWrtElement = !this.element
          !this.newWrtElement = !this.onWall
          !this.wrt.val = !this.onWall.fullName
          !this.setWrt()
        else
          -- must be a curved wall
          !this.onWall = !wall
          !this.ceName.val = 'Fitting in ' + !!ce.fullName
          !this.ce.select('RTEXT', !mode.upcase() )
          !this.justification.val = 1
          !this.zDistance.val = !this.element.owner.owner.zDist
          !this.betaAngle = 0
          !this.elevation.val = 0

          -- With respect to code
          !this.oldWrtElement = !this.element
          !this.newWrtElement = !this.onWall
          !this.wrt.val = !this.onWall.fullName
          !this.setWrt()

        endif

      -- CREATE FITTINGS or COMPOUND FITTINGS FORM INITIALISATION
      -- ********************************************************
      else
        !this.onWall = !!ce
        !this.ceName.val = 'Fitting in ' + !!ce.fullName
        !this.ce.select('RTEXT', !mode.upcase() )
        !this.justification.select('RTEXT', 'OBOW')
        !this.zDistance.val = 0
        !this.betaAngle = 0
        !this.elevation.val = 0

        -- With respect to code
        !this.oldWrtElement = !this.onWall
        !this.newWrtElement = !this.onWall
        !this.wrt.val = !this.onWall.fullName
        !this.setWrt()

      endif

      -- Update the sub-fitting frame gadgets
      !this.updateSubOri()

      -- The no specRef button may be on
      !this.noSpref()

      -- Show Axes
      !this.showAxes()

-- **********************************************************************************************
-- MODIFY MODE
-- **********************************************************************************************

    elseif (!mode.upcase() eq 'MODIFY') then

      -- If its a template go to the actual fitting and validate the fitting
      !fitting = !!dtbGetOwnerType(!!ce, 'FITT CMFI SBFI FIXING')
      if (!fitting.set()) then
        -- Make sure this is a wall fitting
        !wall = !!dtbGetOwnerType(!fitting, 'WALL STWALL')
        if (!wall.set()) then
          -- Navigate to the fitting
          !!ce = !fitting
        else
          !!alert.message('Navigate to a wall fitting.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif
      else
        !!alert.message('Navigate to a wall fitting.')
        if (!this.element.unset()) then
          !this.hide()
        endif
        return
      endif

      if (!!ce.type inset ('FITT', 'CMFI', 'SBFI')) then

      -- MODIFY FITTING or COMPOUND FITTING FORM INITIALISATION
      -- ******************************************************
        if (!!ce.owner.type eq 'STWALL') then
          -- For fittings or compound fittings

          -- justification list is different for sub-fittings
         !dText.clear()
         !rText.clear()
         !dText[1] = |Outside of Wall |
         !rText[1] = |OBOW|
         !dText[2] = |Inside of Wall |
         !rText[2] = |IBOW|
         !this.justification.dText = !dText
         !this.justification.rText = !rText

          -- Current fitting
          !this.element = !!ce
          !this.onWall = !!ce.owner
          !this.ceName.val = !!ce.fullName

          -- Justification
          !this.justification.select('RTEXT', !!ce.posl)
          handle any
            -- posl set by other than appware
            !this.justification.select('RTEXT', 'OBOW')
          endhandle

          -- Z distance
          !this.zDistance.val = !!ce.zDist

          -- Beta Angle and elevation
          !this.betaAngle    = !!ce.bang
          if (!this.justification.selection() eq 'OBOW') then
            if (!this.betaAngle eq 180) then
              !this.elevation.val = !!ce.delp.east
            elseif (!this.betaAngle eq 0) then
              !this.elevation.val = !!ce.delp.east * -1
            endif
          elseif (!this.justification.selection() eq 'IBOW') then
            if (!this.betaAngle eq 180) then
              !this.elevation.val = !!ce.delp.east * -1
            elseif (!this.betaAngle eq 0) then
              !this.elevation.val = !!ce.delp.east
            endif
          endif

          -- With respect to code
          !this.oldWrtElement = !this.element.owner
          !this.newWrtElement = !this.element.owner
          !this.wrt.val = !this.element.owner.fullName
          !this.setWrt()

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

          -- Update the sub-fitting frame gadgets
          !this.updateSubOri()

          -- Show Axes
          !this.showAxes()

      -- MODIFY SUB-FITTING FORM INITIALISATION
      -- **************************************
        elseif (!!ce.owner.owner.type eq 'STWALL') then
          -- For sub fittings

          -- Current fitting
          !this.element = !!ce
          !this.onWall = !!ce.owner.owner
          !this.ceName.val = !!ce.fullName

          -- Justification
          !this.justification.select('RTEXT', !!ce.owner.posl)
          handle any
            -- posl set by other than appware
            !this.justification.select('RTEXT', 'OBOW')
          endhandle

          !justification = !this.justification.selection()

          -- justification list is different for sub-fittings
          !dText.clear()
          !rText.clear()
          !dText[1] = |Compound Fitting|
          !rText[1] = !justification
          if (!rText[1].upcase() eq 'IBOW') then
            !dText[1] = 'Inside of Wall '
          else
            !dText[1] = 'Outside of Wall '
          endif

          !this.justification.dText = !dText
          !this.justification.rText = !rText

          -- Z distance from compound fitting
          if (!justification eq 'OBOW') then
            !this.zDistance.val = !!ce.owner.zDist + !!ce.delp.north
          else
            !this.zDistance.val = !!ce.owner.zDist - !!ce.delp.north
          endif

          -- Beta Angle and elevation
          !this.betaAngle    = !!ce.owner.bang
          if (!justification eq 'OBOW') then
            if (!this.betaAngle eq 180) then
              !this.elevation.val = !!ce.delp.east
            elseif (!this.betaAngle eq 0) then
              !this.elevation.val = !!ce.delp.east * -1
            endif
          elseif (!justification eq 'IBOW') then
            if (!this.betaAngle eq 180) then
              !this.elevation.val = !!ce.delp.east * -1
            elseif (!this.betaAngle eq 0) then
              !this.elevation.val = !!ce.delp.east
            endif
          endif

          -- With respect to code
          !this.oldWrtElement = !this.element.owner
          !this.newWrtElement = !this.onWall
          !this.wrt.val = !this.onWall.fullName
          !this.setWrt()

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

          -- Update the sub-fitting frame gadgets
          !this.updateSubOri()

          -- Show Axes
          !this.showAxes()

        else
          !!alert.message('Wrong type of fitting.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif


      -- MODIFY FIXING or COMPOUND FIXING FORM INITIALISATION
      -- ****************************************************
      -- Fixings on Gensec type walls
      elseif (!!ce.type eq 'FIXING') then

        if (!!ce.owner.owner.owner.type eq 'WALL') then
          -- For standard or compound fixings - in reality these are the same thing because any fixing can own a fixing

          -- justification list is different for sub-fittings
          !dText.clear()
          !rText.clear()
          !dText[1] = |Outside of Wall |
          !rText[1] = |OBOW|
          !dText[2] = |Inside of Wall |
          !rText[2] = |IBOW|
          !this.justification.dText = !dText
          !this.justification.rText = !rText

          -- Current fixing
          !this.element = !!ce
          !this.onWall = !!ce.owner.owner.owner
          !this.ceName.val = !!ce.fullName

          -- Justification
          !this.justification.select('RTEXT', !!ce.owner.posl)
          handle any
            -- posl set by other than appware
            !this.justification.select('RTEXT', 'OBOW')
          endhandle

          -- Z distance along the gensec wall
          !this.zDistance.val = !!ce.owner.owner.zDist

          -- Orientation and elevation
          !this.betaAngle    = 0
          if (!this.justification.selection() eq 'OBOW') then
            !this.elevation.val = !!ce.position.east * -1
          elseif (!this.justification.selection() eq 'IBOW') then
            !this.elevation.val = !!ce.position.east
          endif

          -- With respect to code
          !this.oldWrtElement = !this.element.owner.owner.owner
          !this.newWrtElement = !this.element.owner.owner.owner
          !this.wrt.val = !this.element.owner.owner.owner.fullName
          !this.setWrt()

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

          -- Update the sub-fitting frame gadgets
          !this.updateSubOri()

          -- Show Axes
          !this.showAxes()

        -- MODIFY SUB-FIXING FORM INITIALISATION
        -- *************************************
        elseif (!!ce.owner.owner.owner.owner.type eq 'WALL') then
          -- For a sub compound fixing

          -- Current fixing
          !this.element = !!ce
          !this.onWall = !!ce.owner.owner.owner.owner
          !this.ceName.val = !!ce.fullName

          -- Justification
          !this.justification.select('RTEXT', !!ce.owner.owner.posl)
          handle any
            -- posl set by other than appware
            !this.justification.select('RTEXT', 'OBOW')
          endhandle

          !justification = !this.justification.selection()

          -- justification list is different for sub-fittings
          !dText.clear()
          !rText.clear()
          !dText[1] = |Compound Fitting|
          !rText[1] = !justification
          if (!rText[1].upcase() eq 'IBOW') then
            !dText[1] = 'Inside of Wall '
          else
            !dText[1] = 'Outside of Wall '
          endif

          !this.justification.dText = !dText
          !this.justification.rText = !rText

          -- Z distance from compound fitting
          if (!justification eq 'OBOW') then
            !this.zDistance.val = !!ce.owner.owner.owner.zDist + !!ce.position.north
          else
            !this.zDistance.val = !!ce.owner.owner.owner.zDist - !!ce.position.north
          endif

          -- Orientation and elevation
          !this.betaAngle    = 0
          if (!this.justification.selection() eq 'OBOW') then
            !this.elevation.val = !!ce.position.east * -1
          elseif (!this.justification.selection() eq 'IBOW') then
            !this.elevation.val = !!ce.position.east
          endif

          -- With respect to code
          !this.oldWrtElement = !this.element.owner
          !this.newWrtElement = !this.onWall
          !this.wrt.val = !this.onWall.fullName
          !this.setWrt()

          -- Mode Gadget
          !this.ce.select('RTEXT', 'MODIFY')

          -- Update the sub-fitting frame gadgets
          !this.updateSubOri()

          -- Show Axes
          !this.showAxes()

        else
          !!alert.message('Wrong type of fixing.')
          if (!this.element.unset()) then
            !this.hide()
          endif
          return
        endif
      else
        !!alert.message('Wrong type of element.')
        if (!this.element.unset()) then
          !this.hide()
        endif
        return
      endif

      -- MODIFY GENERAL FORM INITIALISATION
      -- **********************************
      -- Initialise the form with known spref
      !this.initSpec(!this.element.spref)
      --!this.specCallback()

      -- If the item to be modified does not have a SPCO spref
      if (!this.specLink.selection().type eq 'SPCO') then
        !this.noSprefRequired.val = false
        !this.noSpref()
      else
        !this.noSprefRequired.val = true
        !this.noSpref()
      endif

    endif

  else

    -- There are no specs of purp WFIT
    !this.hide()
    !!alert.message('There are no specifications for wall fittings.')
    return
  endif

endmethod
-- End of method definition for .init(STRING, STRING )

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description: Initialise Form with given spec type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Spec world type (PURP)
--    2   R      STRING      Spec type (PURP)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spwlType is STRING, !specType is STRING )

  !this.mainForm = !this.owner()

  -- check for change to current spec
  if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
    -- spec changed, reset form
    !this.specSearch.spwlType = !spwlType
    !this.specSearch.type     = !specType
    !this.specSearch.search()
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif
  !this.specLink.setup( object SPCSPECIFICATION() )

endmethod
-- End of method definition for .initSpec( STRING, STRING )

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description: Initialise Form with given SPEC or SPCO DBREF
--   Passing a null ref will just bring up the currently selected specs.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of SPCO used to initialise this form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSpec( !spec is DBREF )

  if( badref(!spec) ) then
    -- initialise spec
    !this.specLink.setup( object SPCSPECIFICATION() )
  else
    -- get type of SPEC
    !specEl = SPEC OF $!spec
    !specType = !specEl.purp
    !spwlEl = SPWL OF $!spec
    !spwlType = !spwlEl.purp
    -- check that form is initialised for this type of object
    if( !spwlType ne !this.specSearch.spwlType or !specType ne !this.specSearch.type ) then
      !this.specSearch.spwlType = !spwlType
      !this.specSearch.type     = !specType
      !this.specSearch.search()
      !this.specLink.specification(!this.specifications, !this.specSearch)
    endif
    -- set form to existing spec
    !this.specLink.specData.selector( !spec )
    !this.specLink.setup(!this.specLink.specData)
    !this.specLink.specification(!this.specifications, !this.specSearch)
  endif

  -- if dbref was known then no need to accept
  !this.ok.active = true

endmethod
-- End of method definition for .initSpec( DBREF )

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Initialise Form with given DBREF of an item with a spref
--   Passing a null ref will just bring up the currently selected specs.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit( !objectWithSpref is DBREF )

  if( badref(!objectWithSpref) ) then
    -- setup form gadgets for select from top level
    !this.specLink.setup( object SPCSPECIFICATION() )
  else
    -- setup form gadgets for spref already set
    !spref = !objectWithSpref.spref
    handle any
      !spref = object DBREF()
    endhandle
    if( !spref.set() ) then
      -- set form to existing spec
      !this.specLink.setup( !objectWithSpref )
    endif
  endif

  -- grey out owning form until selection complete
--  !this.mainForm.setActive(false)

endmethod
-- End of method definition for .edit( DBREF )

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove the event driven graphics in case the form was dismissed
  !!edgCntrl.remove('Position Fitting')
  !!edgCntrl.remove('Pick fitting Z direction')

  -- Hide the Axes
  !!aidNumbers.hide(!this.aidNumber)

  -- Hide Inside/Outside text
  !!aidNumbers.hide(!this.aidNumberI)
  !!aidNumbers.hide(!this.aidNumberO)

  -- Hide the Plane
  !!aidNumbers.hide(!this.planeNumber)

  -- Tidy the properties member
  !this.properties.deleteObject()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      specAccept
--
-- Description: Create/Modify item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specAccept()

  -- Initialise Variables
  !selectedSpre = !this.specLink.selection()

  -- error if selection not complete - must be a SPCO
  if( !selectedSpre.type.upcase() ne 'SPCO' ) then
    !!alert.error( 'Specification selection not complete' )
    return
  endif

  -- Hide plot form because it would be repeated on property form
  --hide _cdStlPlot
  !this.properties.hidePlot()

  -- Show the properties form
  !this.properties.editProperties()

endmethod
-- End of method definition for .specAccept()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the form and apply the database attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- First validate the direction
  !testGadget = !this.direction.val
  handle ANY
    !!alert.error('Invalid input for Direction gadget.')
    return
  endhandle

  -- Local variable for Modify
  -- action will be create or modify
  !action =   !this.ce.selection()
  -- item could be fitting on stwall OR fixing on wall
  !item = !this.element
  -- selected spref is the new selection
  !selectedSpre = !this.specLink.selection()

  -- Navigate to wall if in create mode
  !!ce = !item

-- ************************************************************
-- CREATE MODE - will all use modify mode when actually created
-- ************************************************************

  -- Create or modify on STWALL or WALL
  if (!this.ce.selection().match('CREATE') eq 1 ) then
    if (!this.element.type eq 'STWALL') then
      !!ce = !this.element
      if (!this.ce.selection() eq 'CREATE') then
        NEW FITT
      elseif (!this.ce.selection() eq 'CREATEC') then
        NEW CMFI
      endif
    elseif (!this.element.type eq 'CMFI') then
      !!ce = !this.element
      NEW SBFI
    elseif (!this.element.type eq 'WALL') then
      !!ce = !this.element
      NEW JLDAT
      NEW PLDAT
      NEW FIXING
    elseif (!this.element.type eq 'FIXING') then
      !!ce = !this.element
      NEW FIXING
    else
      !!alert.error('Not on a Wall')
      return
    endif
  endif

  -- Created now so go into modify mode
  !item = !!ce
  !action = 'MODIFY'

-- ************************************************************
-- MODIFY MODE - will all use modify mode when actually created
-- ************************************************************

  -- Even create is now in modify mode because required elements have now been created.
  if (!action eq 'MODIFY') then

    -- Set design parameters if there are any
    if (!this.noSprefRequired.val) then
      SPREF NULREF
      DESP UNSET
    else
     !this.properties.setProperties(!!ce)
     !this.properties.unsetDesiElement()
   endif

    -- ************************************
    -- APPLY FITTINGS or COMPOUND FITTINGS
    -- ************************************

    if (!item.type inset ('FITT', 'CMFI')) then

      ZDIST $!this.zDistance.val

      POSL  $!this.justification

      -- Make sure the door/wall is always orientated upwards
      if (!this.justification.selection() eq 'IBOW') then
        !this.betaAngle = 180
        BANG 180
      elseif (!this.justification.selection() eq 'OBOW') then
        !this.betaAngle = 0
        BANG 0
      endif

      -- Relative elevation from wrt position
      if (!this.newWrtElement.type inset('STWALL', 'WALL')) then
        -- straight forward reading of gadget value
        !delp = !this.elevation.val
      else
        -- need to calculate the delp by subtracting the bottom of wall elevation from the wrt position.
        !pLine = !this.justification.selection()
        var !wallPos POS PPLINE $!pLine OF $!!ce.owner WRT $!this.newWrtElement
        !cePosWrtWrt = !wallPos.position().up
        !delp = !this.elevation.val - !cePosWrtWrt
      endif

      DELP W $!delp U $!this.distance.val

    -- ************************************
    -- APPLY SUB-FITTINGS
    -- ************************************

    elseif (!item.type eq 'SBFI') then

      !pos = !this.axes.position.wrt(owner)
      DELP $!pos

      -- For all modified sub fittings use the orientation value
      !this.adjustDirection()

    -- ************************************
    -- APPLY FIXINGS or COMPOUND FIXINGS
    -- ************************************

    elseif (!item.type eq 'FIXING' and !this.onWall.type eq 'WALL' and !item.owner.type eq 'PLDATU') then

      -- Z distance is set on the JLDATU of the PLDATU of the FIXING
      !!ce =!item.owner.owner
      ZDIST $!this.zDistance.val
      -- HPREF $!this.hpref taken out so that zdist is always from start

      -- Justification is set on the PLDATU of the FIXING
      !!ce =!item.owner
      POSL  $!this.justification

      -- navigate to the fixing
      !!ce = !item

      -- Make sure the fixing is always orientated upwards
     !orix = !this.axes.orientation.xDir()
     !oriz = !this.axes.orientation.zDir()
      ORI Y IS $!orix AND Z IS $!oriz
      AT $!this.axes.position

    -- ************************************
    -- APPLY SUB-FIXINGS
    -- ************************************
    elseif (!item.type eq 'FIXING' and !this.onWall.type eq 'WALL' and !item.owner.type eq 'FIXING') then

      !pos = !this.axes.position.wrt(owner)
      POS $!pos

      -- For all modified sub fixings use the orientation value
      !this.adjustDirection()

    else
      !!alert.error('Not at a Fitting or Fixing')
      return
    endif

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      selectionDone
--
-- Description: Check to see if selection is complete (spec ref to SPCO)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectionDone() is BOOLEAN

  -- Initialise Variables
  !result       = false
  -- Clear design parameters
  !selectedSpre = !this.specLink.selection()

  if(!selectedSpre.badRef().not()) then
    if(!selectedSpre.type.upcase() eq 'SPCO' and (!selectedSpre.catr.badRef().not() or !selectedSpre.tmpr.badRef().not()) ) then
    -- error if selection not complete - must be a SPCO
     !result = (!selectedSpre.type.upcase() eq 'SPCO')
    endif
  endif

  return !result

endmethod
-- End of method definition for .selectionDone() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      specCallBack
--
-- Description: Function called when spec selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specCallback()

  -- initialise variables
  !specSelection = !this.specLink.selection()

  -- Allow user to OK if got to a SPCO
  !selectionDone = !this.selectionDone()
  !this.ok.active       = !selectionDone
  !this.accept.active   = !selectionDone
  !this.plotfile.active = !selectionDone

  if (!this.accept.active eq false) then
    !this.ok.active = false
  else
    if (!specSelection eq !this.element.spref) then
      !this.properties.initialise(!this.element)
      !this.properties.unsetDesiElement()
    else
      !this.properties.initialise(!specSelection)
      -- if the properties are edited cache them
      !this.properties.autoCacheValues(true)
    endif

    -- Only if there are no properties for user input then make the Apply active.
    -- For templates
    !coll = ARRAY()
    if (!specSelection.tmpRef.set() and !specSelection.tmpRef.badRef().not()) then
      var !coll COLLECT ALL DATA WITH (PURP INSET('ATTR', 'DESP')) FOR $!specSelection.tmpRef
    endif
    -- For non templates
    if (!specSelection.catRef.set() and !specSelection.catRef.badRef().not()) then
      if (!specSelection.catRef.dtRef.set() and !specSelection.catRef.dtRef.badRef().not()) then
        !dtRef = !specSelection.catRef.dtRef
        var !coll COLLECT ALL DATA WITH (PURP INSET('ATTR', 'DESP')) FOR $!dtRef
      endif
    endif
    if (!coll.size().eq(0)) then
      !this.accept.active = false
      !this.ok.active = true
    endif
  endif

  -- Set the plotfile callback
  -- We are now allowing for a SELE with a set ICON attribute
  -- to store plotfile information.
  -- Format will be ICON 'DirName FileName PlotStyle'
  -- example ICON 'WALLS AWALLPLOT LPLT' meaning
  -- %PDMSPLOTS/WALLS/AWALLPLOT displayed as a Landscape plot.
  -- PPLT = portrait plot

  if (!specSelection.type eq 'SELE') then
    if (!specSelection.icon eq '') then
      !this.plotfile.active = false
    else
      !this.plotfile.active = true
    endif
  elseif (!specSelection.type eq 'SPCO') then
    if (!this.properties.checkPlot()) then
      !this.plotfile.active = true
    else
      !this.plotfile.active = false
    endif
  endif
  --!selectedSpref = !specSelection.name
  --!this.plotfile.callback = |CALLSTL XSTLPLOT $!selectedSpref|
  !this.plotfile.callback = |!this.properties.displayPlot()|

endmethod
-- End of method definition for .specCallback()

------------------------------------------------------------------------
--
-- Method:      preference
--
-- Description: Set preferences for auto selection of spec from geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of selection key
--    2   R      ANY         Value of selection key
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .preference( !key is STRING, !answer is ANY )

  -- add the preference
  !this.specLink.specData.preference(!key, !answer)

endmethod
-- End of method definition for .preference( STRING, ANY )

------------------------------------------------------------------------
--
-- Method:      autoSelect
--
-- Description: Automatic spec selection from the given preferences.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoSelect()

  -- Find entries that conform to the preferences
  !this.specLink.actionAutoSelect()

  -- clear the preferences
  !this.specLink.specData.preferenceClear()

endmethod
-- End of method definition for .autoSelect()
------------------------------------------------------------------------
--
-- Method:      stlCalcZDist
--
-- Description: Calculate the Zdist for the fitting/fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlCalcZDist()

 !packet = object EDGPACKET()

  !packet.definePosition('Position Fitting')
  !packet.description = 'Position Fitting'
  !packet.action      = '!!spcWFitSpecSel.posCalcZDist(!this.return[1].position)'
  !packet.type        = 'Positioning'
  !packet.key         = 'ZDistCalc'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .stlCalcZDist()
------------------------------------------------------------------------
--
-- Method:      posCalcZDist
--
-- Description: Action from the Calculate the Zdist for the fitting/fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posCalcZDist( !passedPosition is POSITION )

  -- Call the function to populate the form gadgets with the returned information
    !returnedArray = !this.strFitPosition(!this.element, !this.onWall.jusl, !this.justification.selection(), !passedPosition.wrt(world))

  -- A three part array is return from the above function
  -- Part one = hpref for wall or beta angle for stwall
  if (!this.element.type inset('WALL', 'JLDATU', 'PLDATU', 'FIXING')) then
    !this.hpref = !returnedArray[1].dbRef()
  else
    !this.betaAngle = !returnedArray[1]
  endif

  -- Part two returned the Z distance
  if (!this.zDistance.active) then
    !this.zDistance.val = !returnedArray[2]
  endif

  -- Part three returned the elevation wrt the wrt gadget value
  if (!this.elevation.active) then
    !this.elevation.val = !returnedArray[3]
  endif

  -- Show Axes
  !this.showAxes()

  -- Only one pick was allowed per button press
  !!edgCntrl.remove('Position Fitting')

endmethod
-- End of method definition for .posCalcZDist( POSITION )

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- initialise variable
  !jusLine = !this.onWall.jusLine

-- Only continue if the justification line is set, or else give error
if (!jusLine neq '') then

  -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !wrtElement = object DBREF()
  endhandle

  -- use current positions origin if it null
  if(!wrtElement.unset()) then
    !wrtElement      = !this.oldWrtElement
  else
    !this.newWrtElement = !wrtElement
  endif

  -- Record elevation value from previous wrt element
  if (!this.oldWrtElement.type inset ('STWALL', 'WALL')) then
    var !oldWrtX POS PPLINE $!jusLine OF $!this.oldWrtElement WRT WORLD
    !oldWrt = !oldWrtX.position().wrt(world).up
  else
    !oldWrt = !this.oldWrtElement.position.wrt(world).up
  endif

  -- New elevation wrt to the elevation wrt gadget value
  if (!this.newWrtElement.type inset ('STWALL', 'WALL')) then
    var !newWrtX POS PPLINE $!jusLine OF $!this.newWrtElement  WRT WORLD
    !newWrt = !newWrtX.position().wrt(world).up
  else
    !newWrt = !this.newWrtElement.position.wrt(world).up
    handle (2,201)
      -- element may not have a position (example frmw)
      !!alert.message('Ref element does not have a position.')
      if (!this.oldWrtElement.type inset ('STWALL', 'WALL')) then
        var !newWrtX POS PPLINE $!jusLine OF $!this.oldWrtElement WRT WORLD
       !newWrt = !newWrtX.position().wrt(world).up
      else
       !newWrt = !this.oldWrtElement.position.wrt(world).up
      endif
      -- reset wrt new element as it was
      !this.newWrtElement = !this.oldWrtElement
      !wrtElement = !this.newWrtElement
    endhandle
  endif

  -- Maintain/display the elevation in the gadget
  !this.elevation.val = !this.elevation.val + (!oldWrt - !newWrt)
  !this.oldWrtElement = !this.newWrtElement

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.fullName

else

  !!alert.warning('Wall justification line is unset')

endif

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      strFitPosition
--
-- Description: Calculates the fixing/fitting position on the passed section/gensec.
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .strFitPosition(!fitting is DBREF, !pLine is STRING, !pLineChoice is STRING, !position is POSITION) is ARRAY

  -- Could be that fitting is not as yet created so...
  !section = !!dtbGetOwnerType(!fitting, 'WALL STWALL')

  !this.distance.val = 0

  -- *******************
-- SCTN based element
-- *******************
  if(!section.hardType eq 'SCTN') then

    -- Get the plane of the passed pline
    !line    = !section.plStart.attribute(!pLine).line(!section.plEnd.attribute(!pLine))

    -- Plane normal to the pline
    !plPlane = object PLANE(!line.startPosition, !section.plOrientation.attribute(!pLineChoice))

    -- Determine the beta angle
    !bAngle = !plPlane.orientation.xDir().opposite().angle(U)
    if(!bAngle eq 0) then
      !mult = -1
    else
      !mult = 1
    endif

    -- drawing the plane - debugging only
    !gplane  = object GPHPLANE(!plPlane)
    !gplane.detail = true
    --!gplane.draw(100)

    -- Map passed position onto pline plane
    !newPosition  = !plPlane.near(!position)

   -- Adjust the position to be above bottom of wall
   var !a POS PPLINE $!pLineChoice OF $!this.onWall
   var !b POS PPLINE $!pLine OF $!this.onWall
   !aPos = !a.position()
   !bPos = !b.position()
   !abDif = !aPos.up - !bPos.up
   !newPosition.up = !newPosition.up - !abDif

    -- Distance from start (zdistance)
    !xyPosition   = !plPlane.xyOffset(!newPosition)
    !offset       = !xyPosition.x * !mult
    !zDistance    = !xyPosition.y

    -- Make the position relative to the wall
    !this.oldWrtElement = !section
    !this.newWrtElement = !section
    !this.wrt.val = !section.fullName
    !this.setWrt()

    -- Note - Do the actual dbase stuff in the apply of the form
    -- POSL $!pLine BANG $!bAngle ZDIST $!zDistance DELP X$!offset

    -- Make the return array
    !array[1] = !bAngle
    !array[2] = !zDistance
    !array[3] = !offset

    return !array

-- *********************
-- Gensec based elements
-- *********************
  elseif (!section.hardType eq 'GENSEC') then

    -- remember the current element and navigate to the wall
    !element = !!ce
    !!ce = !section

    -- Elevation calculated by edg picked position z from the bottom of the wall
    var !posiBowX POS PPLINE $!pLineChoice OF $!section WRT WORLD
    !posiBow = !posiBowX.position().up
    !offset       = !position.up - !posiBow

    -- Zdistance ( need to find out which segment of the wall position is on )
    var !segment ID SEGMENT PPLINE $!pLineChoice THROUGH  $!position VIA PLINE BOUND
    handle any
     var !segment ID SEGMENT PPLINE ANY THROUGH  $!position VIA PLINE BOUND
    endhandle
     var !zDistance PLDIST PPLINE $!pLineChoice THROUGH  $!position VIA PLINE BOUND
    handle any
     var !zDistance PLDIST PPLINE ANY THROUGH  $!position VIA PLINE BOUND
    endhandle

    -- Make the displayed elevation relative to the wall
    !this.oldWrtElement = !section
    !this.newWrtElement = !section
    !this.wrt.val = !section.fullName
    !this.setWrt()

    -- Adjust the zdist to be always from start
    !arc = !!edgTypes.wall.arc(!this.onWall)
    !this.hpref = !segment.dbRef()
    !!ce = !this.hpref
    -- Must be 1 or 3 or 5 -- Ring walls only
    if (!this.hpref.seq eq 3) then
      var !lena DER LEN OF PREV POINSP
      var !zDistance ($!zDistance + $!lena)
    elseif (!this.hpref.seq eq 5) then
      var !lena DER LEN OF PREV POINSP
      var !lenb DER LEN OF PREV POINSP
      var !zDistance ($!zDistance + $!lena + $!lenb)
    --elseif (!arc.angle() gt 180 and !this.hpref.seq eq 1) then
      --var !lena DER LEN
      --var !zDistance (( $!arc.radius * 2 * PI ) - $!zDistance)
    endif

    -- navigate back to original element
    !!ce = !element

    -- Make the return array
    !array[1] = !segment
    !array[2] = !zDistance.real(!!distanceFmt)
    !array[3] = !offset

    return !array

  endif

endmethod
-- End of method definition for .strFitPosition(DBREF, STRING, STRING, POSITION) ARRAY
------------------------------------------------------------------------
--
-- Method:      popWrt
--
-- Description: updates gadgets depending on the 'with' selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .popWrt(!refe is STRING)

  if (!this.wrt.val eq '') then
    return
  endif

  if (!refe eq 'update') then
    -- Collect all levels to put on the wrt gadget as a right hand mouse pull down
    var !coll COLLECT ALL STRU WITH (PURP EQ 'LEVL')
    !menu = !this.levels
    !menu.clear()
    do !i indices !coll
      !name  = !coll[!i].dbRef().namn
      !refea = !coll[!i].dbRef().refe
      !menu.add('CALLBACK', |$!name|, '!this.popWrt(|$!refea|)')
    enddo
  else
    !this.wrt.val = !refe
    !this.setWrt()
  endif

endmethod
-- End of method definition for .popWrt(STRING)
------------------------------------------------------------------------
--
-- Method:      showAxes
--
-- Description: Show Axes at position or proposed position
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .showAxes()

  -- Initialise variables
  !jusLine      = !this.onWall.jusl
  !pLine        = !this.justification.selection()
  !zDist        = !this.zDistance.val
  !elevn        = !this.elevation.val
  !offsetDist   = !this.distance.val
  !mode         = !this.ce.selection()
  !elementType  = !this.element.type
  !ownert       = !this.element.owner.type

  -- Remember where we are and navigate to the subject wall
  !element = !!ce
  !!ce = !this.onWall

  -- Set the Axes height depending on units
  if (defined(!!gphAxesEdit)) then
    !this.axes.height = !!gphAxesEdit.size.val
  else
    !this.axes.height = 500mm
  endif

  -- ******************
  -- ALL TYPES code
  -- ******************

  -- Navigate to STRU level
  STRU

  -- Positioning of axes
  var !pos (UP $!elevn FROM PPLIN $!pLine OF $!this.onWall NORMAL DIST $!zDist FROM START)
  !posInStru = !pos + ' wrt zone'
  !this.position = !posInStru.position()

  -- Elevation adjustment wrt
  if (!this.newWrtElement.type inset('WALL', 'STWALL')) then
    var !posWallStru POS PPLINE IBOW OF $!this.onWall WRT /*
    !posWrt = !posWallStru.position()
  else
    !posWrt = !this.newWrtElement.position.wrt(world)
  endif
  !this.position.up = !posWrt.up + !elevn

  -- Navigate back to wall
 !!ce = !this.onWall

  -- ******************
  -- SUB-FITTINGS code
  -- ******************
  if ((!mode eq 'CREATES') or ((!mode eq 'MODIFY' and ((!elementType eq 'SBFI') or (!elementType eq 'FIXING' and !ownert eq 'FIXING')))) ) then

      -- Orientation of axes
    !this.axes.orientation = !this.element.orientation

  else

    -- *********
    -- SCTN code
    -- *********
    if (!this.onWall.type eq 'STWALL') then

      -- Orientation of axes
      if (!pLine.eq('OBOW')) then
        !this.axes.orientation = object ORIENTATION('Y IS U WRT /* AND Z IS W WRT STWALL')
      else
        !this.axes.orientation = object ORIENTATION('Y IS U WRT /* AND Z IS E WRT STWALL')
      endif

    -- ***********
    -- GENSEC code
    -- ***********
    else

      -- Orientation of axes
      -- Use the edg arc to find the face angle
      !arc = !!edgTypes.wall.arc(!this.onWall)
      -- Next if is to ensure that the angle direction always works
      if (!arc.startAngle eq !arc.endAngle) then
        !arc.startAngle = 0
        !arc.endAngle   = 360
      endif
      !angle = !arc.angleDirection(!arc.near(!this.position ))
      !angleOpposite = !angle.opposite()
      !arci = !!edgTypes.pLine.arc(!this.onWall, 'IBOW')
      !arco = !!edgTypes.pLine.arc(!this.onWall, 'OBOW')
      if (!arco.radius gt !arci.radius) then
        !convex = true
      else
        !convex = false
      endif

      -- Consider justification selection

      -- Need to find out if its a concave or convex wall

      if (!pLine.eq('OBOW') and !convex) then
        !this.axes.orientation = object ORIENTATION('Y IS U WRT /* AND Z IS ' & !angle )
      elseif (!pLine.eq('OBOW') and !convex.not()) then
        !this.axes.orientation = object ORIENTATION('Y IS U WRT /* AND Z IS ' & !angleOpposite )
      elseif (!pLine.eq('IBOW') and !convex) then
        !this.axes.orientation = object ORIENTATION('Y IS U WRT /* AND Z IS ' & !angleOpposite )
      elseif (!pLine.eq('IBOW') and !convex.not()) then
        !this.axes.orientation = object ORIENTATION('Y IS U WRT /* AND Z IS ' & !angle )
      endif

    endif

  endif

  -- ************
  -- GENERAL code
  -- ************

  -- Initialise variables
  !ljustToInside   = object LINE()
  !ljustToOutside  = object LINE()

  -- Find out distances between wall justification and the inside and outside of the wall
  var !justPos     POS PPLIN $!pLine OF $!this.onWall NORMAL DIST 0 FROM START
  var !insidePos   POS PPLIN IBOW OF $!this.onWall NORMAL DIST 0 FROM START
  var !outsidePos  POS PPLIN OBOW OF $!this.onWall NORMAL DIST 0 FROM START

  -- Positions must be position objects
  !justPosition = !justPos.position()
  !insidePosition = !insidePos.position()
  !outsidePosition = !outsidePos.position()
  !justPosition.up = 0
  !insidePosition.up = 0
  !outsidePosition.up = 0

  -- Distance justification line to inside of wall
  !ljustToInside.startPosition  = !justPosition
  if (!insidePosition eq !justPosition) then
    !insideLength    = 0
  else
    !ljustToInside.endPosition    = !insidePosition
    !insideLength    = !ljustToInside.length()
  endif

  -- Distance justification line to outside of wall
  !ljustToOutside.startPosition = !justPosition
  if (!outsidePosition eq !justPosition) then
    !outsideLength    = 0
  else
    !ljustToOutside.endPosition    = !outsidePos.position()
    !outsideLength    = !ljustToOutside.length()
  endif

  -- Adjust the position member to be from the selected pline
  if (!pLine eq 'OBOW') then
    !offsetDist = !offsetDist + !outsideLength
  else
    !offsetDist = !offsetDist + !insideLength
  endif

  if ((!mode eq 'CREATES')) then
    !this.position = !this.position.offset(!this.element.orientation.zDir(), !offsetDist)
  elseif ((!mode eq 'MODIFY' and ((!elementType eq 'SBFI') or (!elementType eq 'FIXING' and !ownert eq 'FIXING'))))  then
    !this.position = !this.position.offset(!this.element.owner.orientation.zDir(), !offsetDist)
  else
    !this.position = !this.position.offset(!this.axes.orientation.zDir(), !offsetDist)
  endif

  !this.axes.position = !this.position

  !this.axes.draw(!this.aidNumber)

  -- Draw a graphical plane to indicate the fitting position
  !this.plane.description = 'Wall Fitting'
  !this.plane.plane.orientation = !this.axes.orientation
  !this.plane.plane.position    = !this.axes.position
  !this.plane.x = !this.axes.height * 0.5
  !this.plane.y = !this.axes.height * 0.5
  !this.plane.fill = 'OFF'

  !this.plane.draw(!this.planeNumber)

  -- Inside/Outside text positioning
  var !posIn  (UP 0 FROM PPLIN IBOW OF $!this.onWall NORMAL DIST $!zDist FROM START)
  var !posOut (UP 0 FROM PPLIN OBOW OF $!this.onWall NORMAL DIST $!zDist FROM START)
  !posInside = !posIn + ' wrt stru'
  !posOutside = !posOut + ' wrt stru'
  !positionInside =  !posInside.position()
  !positionOutside = !posOutside.position()

  -- Show the Inside/Outside aid text
  AID CLEAR TEXT $!this.aidNumberI
  handle any
  endhandle
  AID CLEAR TEXT $!this.aidNumberO
  handle any
  endhandle
  AID TEXT NUMBER $!this.aidNumberI 'Inside of Wall' AT $!positionInside
  AID TEXT NUMBER $!this.aidNumberO 'Outside of Wall' AT $!positionOutside

  --Show the subfitting rotation angle
  if ((!mode eq 'CREATES') or (!mode eq 'MODIFY' and !elementType eq 'SBFI' )) then
    !this.showDir('AndRotation')
  elseif ((!mode eq 'MODIFY') and (!elementType eq 'FIXING' and !ownert eq 'FIXING')) then
    !this.rotation.val = !this.element.number
    !this.rotaAngle = !this.rotation.val
    !this.showDir('AndRotation')
  endif

  -- Navigate back to original element
  !!ce = !element

endmethod
-- End of method definition for .showAxes()
------------------------------------------------------------------------
--
-- Method:      setOffset
--
-- Description: Set the elevation offset to the offset of the current storage level.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOffset()

  -- Use of current storage area if one exists
  if (defined(!!civLevels)) then

    -- Make sure level is set
    !level = !!civLevels.level().level()
    handle any
      -- Returning Array index unset
      !this.wrt.val = !this.onWall.fullName
      !this.setWrt()
      !this.elevation.val = 0
      !this.setWrt()
      !this.showAxes()
      return
    endhandle

    -- Uses the storage area for walls
      !specificLevel =  !!civLevels.level().stores[3]

    -- If the specific storage area set then set the value to that
    if (!specificLevel.set() and !specificLevel neq =0/0) then
      !this.wrt.val = !level.fullName
      !this.setWrt()
      !this.elevation.val = !!civLevels.level().offset()
    -- If the specific storage area unset then set the value to on element
    else
      !this.wrt.val = !this.onWall.fullName
      !this.setWrt()
      !this.elevation.val = 0
    endif

    -- new elevation level
    !this.setWrt()
    !this.showAxes()

  endif

endmethod
-- End of method definition for .setOffset()
------------------------------------------------------------------------
--
-- Method:      noSpref
--
-- Description: Makes selection gadgets active/inactive if no specification is required
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .noSpref()

  if (!this.noSprefRequired.val) then
    !this.specifications.active = false
    !this.default.active        = false
    !this.autoSelect.active     = false
    !this.selected.active       = false
    !this.question.active       = false
    !this.perms.active          = false
    !this.accept.active         = false
    !this.plotfile.active       = false
    !this.ok.active          = true
  else
    !this.specifications.active = true
    !this.default.active        = true
    !this.autoSelect.active     = true
    !this.selected.active       = true
    !this.question.active       = true
    !this.perms.active          = true
    !this.accept.active         = true
    !this.plotfile.active       = true
    !this.specCallback()
  endif

endmethod
-- End of method definition for .noSpref()
------------------------------------------------------------------------
--
-- Method:      adjustDirection
--
-- Description: In modify mode this will immediately adjust the fitting direction Z
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .adjustDirection()

  if (!!ce.type eq 'SBFI') then
    !zDir = !this.direction.val
    ZDIR $!zDir
  elseif (!!ce.type eq 'FIXING' and !!ce.owner.type eq 'FIXING') then
    !zDir = !this.direction.val
    !xDir = !!ce.ori.xDir()
    !yDir = !!ce.ori.yDir()
    -- Try to maintain Y which is Up on the wall
    -- Only Z is important because the adjust rotation sorts X and Y
    ORI Z IS $!zDir AND Y IS $!yDir
    handle any
      -- Maintain X
      ORI Z IS $!zDir AND X IS $!xDir
    endhandle
  endif

  -- Always call the rotation method
  !this.adjustRotation()

endmethod
-- End of method definition for .adjustDirection()

------------------------------------------------------------------------
--
-- Method:      adjustRotation
--
-- Description: In modify mode this will immediately adjust the fitting rotation around the Z axis
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .adjustRotation()

    if (!this.rotation.val.between(-180, 180).not()) then
      !!alert.error('Rotation Angle must be between 180 and -180 degrees')
    else
      if (!!ce.type eq 'SBFI') then
        !bang     = !this.rotation.val
        BANG $!bang
      elseif (!!ce.type eq 'FIXING' and !!ce.owner.type eq 'FIXING') then
        !ori = !this.axes.orientation
        ORI $!ori
        !bang     = !this.rotation.val
        NUMBER $!bang
        !this.rotaAngle = !this.rotation.val
      endif
    endif

endmethod
-- End of method definition for .adjustRotation()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!spcWFitSpecSel.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!spcWFitSpecSel.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  -- Simply plus or minus the current setting
  elseif (!option eq '+/-') then

    !this.distance.val = -1 * !this.distance.val

  -- Carry out action
  !this.showAxes()

  endif

endmethod
-- End of method definition for .setMeasure(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distance.val = 0
  else
    !this.distance.val = !line.length()
  endif

  -- Carry out action
  !this.showAxes()

endmethod
-- End of method definition for .measure(LINE)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Pick Direction
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineDirection('')
    !packet.pickPacket.prompt = 'Derive Z direction from graphics'
    !packet.description = 'Pick fitting Z direction'
    !packet.action = '!!spcWFitSpecSel.direction(!this.return[1])'
    !!edgCntrl.add(!packet)
    return

  -- Opposite  Direction
  elseif (!option eq 'OPPOSITE') then
    !this.direction.val = !this.direction.val.opposite()

  -- Direction
  else

    -- Check we have an orientation
    !unused = !this.axes.orientation
    handle any
      return
    endhandle

     -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction.val = !this.axes.orientation.wrt(world).xDir()
    elseif (!option.match('Y').boolean()) then
      !this.direction.val = !this.axes.orientation.wrt(world).yDir()
    endif

  endif

  -- Carry out action
  !this.showDir('AndRotation')

endmethod
-- End of method definition for .setDirection(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.direction.val = !direction

  -- Carry out action
  !this.showDir('AndRotation')

endmethod
-- End of method definition for .direction(DIRECTION)
------------------------------------------------------------------------
--
-- Method:      showDir
--
-- Description:  Show the direction of a sub fitting by changing Axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .showDir(!action is STRING)

  -- First validate the new direction
  !testGadget = !this.direction.val
  handle ANY
    !!alert.error('Invalid input for Direction gadget.')
    return
  endhandle

  if (!this.ce.selection() eq 'MODIFY') then

    !!ce = !this.element
    !this.axes.orientation = !this.axes.orientation.wrt(world)
    !newDir = !this.direction.val
    -- Try to maintain Y is N as PDMS does
    !this.axes.orientation = object ORIENTATION('Z IS ' & !newDir & ' AND  Y IS N WRT ' & !this.element.owner)
    handle any
      -- Or maintain Y as U as PDMS does
    !this.axes.orientation = object ORIENTATION('Z IS ' & !newDir & ' AND  Y IS U WRT ' & !this.element.owner)
    endhandle
    if (!this.element.type eq 'SBFI') then
      !this.rotation.val = !this.rotaAngle
      !this.rotaAngle = 0
    else
      !this.rotation.val = !this.rotaAngle
      !this.rotaAngle = 0
    endif

  elseif (!this.ce.selection() eq 'CREATES') then
    !!ce = !this.element
    !this.axes.orientation = !this.axes.orientation.wrt(world)
    !newDir = !this.direction.val
    -- Try to maintain Y is N as PDMS does
    !this.axes.orientation = object ORIENTATION('Z IS ' & !newDir & ' AND  Y IS N WRT ' & !this.element)
    handle any
      -- Or maintain Y as U as PDMS does
    !this.axes.orientation = object ORIENTATION('Z IS ' & !newDir & ' AND  Y IS U WRT ' & !this.element)
    endhandle
    if (!this.element.type eq 'CMFI') then
      !this.rotaAngle = 0
    else
      !this.rotaAngle = 0
    endif

  endif

  -- Update Rotation
  if (!action eq 'AndRotation') then
    !this.showRot()
  endif

endmethod
-- End of method definition for .showDir(STRING)
------------------------------------------------------------------------
--
-- Method:      showRot
--
-- Description:  Show the rotation of a sub fitting by changing Axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .showRot()

  !memory = !!ce
  -- Any number can be input, convert it to -180 to 180
  !numbOfRotations   = !this.rotation.val / 360
  !inteOfRotations  = !numbOfRotations.int()
  !remainder           = !this.rotation.val - !inteOfRotations * 360
  if (!remainder gt 180) then
    !this.rotation.val = !remainder - 360
  elseif (!remainder lt -180) then
    !this.rotation.val = !remainder + 360
  else
    !this.rotation.val = !remainder
  endif

  if (!this.rotation.val.between(-180, 180).not()) then
    !!alert.error('Rotation Angle must be between 180 and -180 degrees')
    return
  else

    -- Create a dummy box
    STRU
    NEW BOX XLEN 100MM YLEN 100MM ZLEN 100MM
    handle ANY
      !!alert.error(!!error.text)
      !!ce = !memory
      return
    endhandle
    !ref = !!ce
    !ori = !this.axes.orientation.wrt(world)
    !zDir = !ori.zDir()
    !xDir = !ori.xDir()
    !pos = !this.axes.position.wrt(world)
    ORI Z IS $!zDir AND X IS $!xDir
    POS $!pos
    !!ce = !this.element

    !this.axes.orientation.origin = !ref
    !this.axes.orientation.alpha = 0
    !this.axes.orientation.beta = 0
    --q var !this.rotation.val !this.rotaAngle
    if (!this.ce.selection() eq 'MODIFY') then
      !this.axes.orientation.gamma = !this.rotation.val - !this.rotaAngle
    else
      !this.axes.orientation.gamma =  -1 * (!this.rotaAngle - !this.rotation.val)
    endif
    !this.rotaAngle = !this.rotation.val
    !this.axes.draw(!this.aidNumber)
    !this.plane.plane.orientation = !this.axes.orientation
    !this.plane.draw(!this.planeNumber)

    !this.axes.orientation = !this.axes.orientation.wrt(world)
    !!ce = !ref
    DELETE BOX
    !!ce = !this.element
  endif

endmethod
-- End of method definition for .showRot()

------------------------------------------------------------------------
--
-- Method:      updateSubOri
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .updateSubOri()

  -- Initialise variables
  !jusLine    = !this.onWall.jusl
  !pLine      = !this.justification.selection()
  !zDist      = !this.zDistance.val
  !elevn      = !this.elevation.val
  !offsetDist = !this.distance.val
  !mode       = !this.ce.selection()

  if (!!ce.type eq 'SBFI') then
    -- Populate the orientation gadgets for all modified items
    !this.direction.val = !!ce.orientation.zDir().wrt(world)
    !this.distance.val  = !!ce.delp.up
    !this.rotation.val  = !!ce.bang

    -- Initialise rotation angle record member
    !this.rotaAngle = !this.rotation.val

  elseif (!!ce.type eq 'FIXING' and !!ce.owner.type eq 'FIXING') then

    -- Populate the orientation gadgets for all modified items
    !this.direction.val = !!ce.orientation.zDir().wrt(world)

    !this.distance.val  = !!ce.position.up

    -- For sub-fixing we need to consider that the distance is from the wall line not the fitting
    !elem = !!ce
    STRU
    var !pos (UP $!elevn FROM PPLIN $!jusLine OF $!this.onWall NORMAL DIST $!zDist FROM START)
    !posInStru = !pos + ' wrt zone'
    !posA      = !posInStru.position().wrt(!this.element.owner)
    !posB      = !this.element.position.wrt(!this.element.owner)
    !offsDiff  = !posB.up - !posA.up
    !this.distance.val = !offsDiff
    !!ce = !elem
   !this.rotation.val  = !!ce.number
   handle any
     !this.rotation.val  = 0
   endhandle

      -- Initialise rotation angle record member
      !this.rotaAngle = !this.rotation.val

  else
    -- Populate the orientation gadgets for all modified items
    !this.direction.val = !!ce.orientation.wrt(world).zDir()
    if (!!ce.type inset ('CMFI', 'FITT')) then
      if (!mode eq 'MODIFY') then
        !this.distance.val  = !!ce.delp.up
      else
        !this.distance.val  = 0
      endif
    else
      -- Fixings have position not delp
      if (!mode eq 'MODIFY') then
        !this.distance.val  = !!ce.position.up
      else
        !this.distance.val  = 0
      endif
    endif
    !this.rotation.val  = 0

      -- Initialise rotation angle record member
      !this.rotaAngle = 0

  endif

   if (!mode eq 'CREATES' or ((!!ce.type eq 'SBFI')  or (!!ce.type eq 'FIXING' and !!ce.owner.type eq 'FIXING'))) then
    -- Activate the orientation frame - active for subfittings
    !this.direction.active = true
    !this.rotation.active  = true
  else
    -- Activate the orientation frame - active only for subfittings
    !this.direction.active = false
    !this.rotation.active  = false
  endif

endmethod
-- End of method definition for .updateSubOri()

------------------------------------------------------------------------
--
-- Method:      validateDistance
--
-- Description:
--   Validate input to distance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDistance(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  endif

endmethod
-- End of method definition for .validateDistance()
