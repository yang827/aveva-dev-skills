------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjustPlaneToCentreline()        -                   in order to work out the offset radius we need accurately position the
--  apply()                          -                   this is the apply method which needs to reset the branch
--  applyRotation(PLANE,ARRAY,ARC)   PLANE
--  calculateAngles()                -                   exploratory method to find out what data we can harvest
--  calculateCentreline()            -                   Draw the arc representing the rotation angle from the plane
--  calculateOffsetFromPlane()       -                   method to work out the angle back the plane
--  calculateRotationDirection()     -
--  calculateRotationPlane()         -                   creat an arc object representing the direction from plane
--  dismiss()                        -
--  drawArc(ARC)                     -                   Draw the arc representing the rotation angle from the plane
--  drawArrow(POINTVECTOR)           -
--  drawLine(LINE)                   -
--  drawNewBranch(BOOLEAN,POSITION)  -
--  drawOrientation(ORIENTATION,POSITION) -
--  drawPlane(BOOLEAN,PLANE)         -
--  drawPlane(BOOLEAN,PLANE,REAL)    -
--  getBasicPosition(DIRECTION,PLANE,STRING) ARRAY
--  getBendPosition(POSITION,DBREF,ARRAY) PLANE
--  getBestFit(ARRAY)                POINTVECTOR
--  getIntersection(DBREF,POINTVECTOR) POINTVECTOR
--  getNewDirection(REAL)            DIRECTION
--  getNewSurfacePosition(DIRECTION) ARRAY
--  getNewSurfacePositionFromVector(ARRAY,DIRECTION) -                   method to set the new surface position and direction
--  getPlaneOffsetAngle(DIRECTION,POSITION) REAL                method to work out the angle projected onto the plane
--  getTubePosition(POSITION,DBREF)  PLANE               -
--  init()                           -
--  intersectInTube(DBREF,POINTVECTOR) POINTVECTOR
--  makePlane(POSITION,DIRECTION)    PLANE               makes a plane object from a position and a direction
--  netOnBranchDirectionChanged(ARRAY) -                   called when the branch direction is changed
--  netOnNudgeAlongChanged(ARRAY)    -
--  netOnNudgeAroundChanged(ARRAY)   -                   called when the nudge button is pressed on the control
--  netOnPlaneDirectionChanged(ARRAY) -                   called when the plane direction is changed. This is not the
--  netOnRotationChanged(ARRAY)      -                   called when rotation value is changed
--  planeTags()                      -                   Works out a set of direction tags to add to the drawn plane
--  resetPlane(ARRAY)                -
--  rotateAroundPlane(REAL)          -                   method to fire a vector down the plane at the passed angle
--  setPlaneOffsetAngle(ARRAY)       DIRECTION
--  specialBranchDirection()         -                   Constructor method
--  updateBranchDirectionText()      -                   method to work out the angle back the plane
--  updateCurrentConnection()        -                   method to put the new fixed attributes back into the
--
import 'Aveva.Pdms.Presentation.ConnectionPosition'
handle ANY
  --q var !!error
endhandle

setup form  !!specialBranchDirection

 !this.formTitle     = 'Locate Branch'
 !this.iconTitle     = 'Bran Dir'
 !this.callback      = '!this.init()'
 !this.formRevision  = ' $Revision: 1.0 $ '

 frame .axisControl panel |Rotation angle|  at  x0 ymax+0.2 width 47 hei 10
    container .netAxisFrame PMLNetCONTROL 'NET'  at x1 dock fill
    vdist 0
     --text .planeDirection at xmin y4  'Plane Direction' tagwid 10 call '!this.modifyPlaneDirection(!this.planeDirection.val)'width 16 is STRING
 exit
 path d
 button .apply ' OK ' at xmin.axisControl ymax call '!this.apply()'
 button .dismiss 'Dismiss' at xmax form - size ymin call '!this.dismiss()'

 --Hold branch to be connected into
 member .mainBranch is DBREF
 --Hold Branch to be connected
 member .connectedBranch is DBREF
 --Hold end to be connected head or tail (true False)
 member .connectedEnd is STRING
 -- hold end to be picked
 member .edgSelection is STRING
 -- the spec from which the tees are derived.
 -- currently this is the spec of the main branch
 member .teeSpec is DBREF

 member .headComponent     is PIPETAPPINGCONNECTION
 member .tailComponent     is PIPETAPPINGCONNECTION
 member .currentConnection is PIPETAPPINGCONNECTION

 -- tagging numbers

 member .branchCylinder               is REAL
 member .insertComponent              is DBREF
 member .currentRotationAngle         is REAL
 member .currentPlaneAngle            is REAL
 member .currentBranchDirection       is DIRECTION
 member .currentSurfacePosition       is POSITION
 member .currentVector                is POINTVECTOR
 member .newSurfacePosition           is POSITION
 member .newRotationAngle             is REAL
 member .newPlaneAngle                is REAL
 member .newBranchDirection           is DIRECTION
 member .tagAids                      is REAL
 member .tagPlaneNumber               is REAL
 member .tagLineNumber                is REAL
 member .tagArrowNumber               is REAL
 member .tagAxesNumber                is REAL
 member .rotationArc                  is ARC
 member .plane                        is PLANE
 member .componentOrTube              is STRING
 member .centreLine                   is LINE
 member .bendArc                      is ARC

 member .eLabel is STRING
 member .nLabel is STRING
 member .uLabel is STRING
 member .wLabel is STRING
 member .sLabel is STRING
 member .dLabel is STRING
 member .majorDirection is POINTVECTOR


 using nameSpace 'Aveva.Pdms.Presentation.ConnectionPosition'

 member .connectionPositionControl is CONNECTIONPOSITIONCONTROL
 member .intersect is PIPEINTERSECTION
 member .newIntersectPos is POSITION
 member .initialAngle is REAL

exit
------------------------------------------------------------------------
--
-- Method:      .specialBranchDirection
--
-- Description: Constructor method
--
------------------------------------------------------------------------
define method .specialBranchDirection()

   using nameSpace 'Aveva.Pdms.Presentation.ConnectionPosition'
  !this.connectionPositionControl = object CONNECTIONPOSITIONCONTROL()

  !this.netAxisFrame.control = !this.connectionPositionControl.handle()
  !this.connectionPositionControl.rotation(45)
  !this.connectionPositionControl.planeDirection('E 45 N 82 U')
  !this.connectionPositionControl.branchDirection('E 45 N 82 U')

  !this.connectionPositionControl.nudgeAlongDistance(5)
  !this.connectionPositionControl.nudgeAroundDistance(8)

  !this.connectionPositionControl.rotationAxisLabelNorth('0')
  !this.connectionPositionControl.rotationAxisLabelSouth('180')
  !this.connectionPositionControl.rotationAxisLabelEast('90')
  !this.connectionPositionControl.rotationAxisLabelWest('270')

  !this.connectionPositionControl.addEventHandler('onRotationChanged',!this, 'netOnRotationChanged')
  !this.connectionPositionControl.addEventHandler('onPlaneDirectionChanged', !this, 'netOnPlaneDirectionChanged')
  !this.connectionPositionControl.addEventHandler('onBranchDirectionChanged', !this, 'netOnBranchDirectionChanged')
  !this.connectionPositionControl.addEventHandler('onNudgeAlongChanged', !this, 'netOnNudgeAlongChanged')
  !this.connectionPositionControl.addEventHandler('onNudgeAroundChanged', !this, 'netOnNudgeAroundChanged')

   -- Aid Tags
  !this.tagAids      =   !!aidNumbers.add('Branch Manipulation')
  !this.tagPlaneNumber = !!aidNumbers.add('Branch Manipulation')
  !this.tagLineNumber  = !!aidNumbers.add('Branch Manipulation')
  !this.tagArrowNumber = !!aidNumbers.add('Branch Manipulation')
  !this.tagAxesNumber = !!aidNumbers.add('Branch Manipulation')

endmethod
------------------------------------------------------------------------
--
-- Method:      .netOnRotationChanged
--
-- Description: called when rotation value is changed
--
------------------------------------------------------------------------
define method .netOnRotationChanged(!a is ARRAY)
  --$p rotation changed to $!a[0]
  --!!alert.error('$!a[0]')
  -- when the rotation is changed the surface POSITION is rotated around the origin of the plane
  -- first we need the current angle rotated around the centreline

  !newAngle = !a[0]
  !this.newRotationAngle = !newAngle

  -- fire a vector down the plane at the passed angle
  -- sets the new branch direction and position
  !this.rotateAroundPlane(!newAngle)

  -- update the angle to the branch to the plane
  !this.calculateOffsetFromPlane()

  -- set the new direction
  !this.updateBranchDirectionText()
  !this.calculateRotationDirection()


endmethod
------------------------------------------------------------------------
--
-- Method:      .netOnPlaneDirectionChanged
--
-- Description: called when the plane direction is changed. This is not the
-- plane direction but the angle from the plane
--
------------------------------------------------------------------------
define method .netOnPlaneDirectionChanged(!a is ARRAY)

  !this.newBranchDirection = !this.setPlaneOffsetAngle(!a)

  !this.connectionPositionControl.branchDirection('$!this.newBranchDirection')
  !this.drawNewBranch(TRUE,!this.newSurfacePosition)

  -- set the direction on the direction gadget
  --!this.updateBranchDirectionText()

  --!this.calculateAngles()

endmethod

------------------------------------------------------------------------
--
-- Method:     .getPlaneOffsetAngle
--
-- Description: method to work out the angle projected onto the plane
--
------------------------------------------------------------------------
define method .setPlaneOffsetAngle(!angle is ARRAY) is DIRECTION


     -- projected is the direction along the plane of the offset branch
     !projected = !this.newBranchDirection.projected(!this.plane)
     !original = !this.newBranchDirection

     -- create a plane between the branch direction and the projected direction using a POINTVECTOR
     !tempVector = object POINTVECTOR()
     !tempVector.position = !this.newSurfacePosition
     !tempVector.direction = !original.cross(!projected)
     handle ANY
     -- $p handle
       -- we need to work out a direction for a new plane because the passed cross gives an error
       -- in order to create a new plane
       !tempVector.direction = !projected.cross(!this.plane.direction())
     endhandle
     !tempPlane = !tempVector.plane()
     -- orientate the plane so that the x direction is in the same direction as the current branch
     !zDir = !tempVector.direction.opposite()
     !xDir = !this.newBranchDirection
     !tempPlane.orientation =  x is $!projected and z is $!zDir
     -- orientation from the branch
      -- !tempPlane.orientation =  x is $!xDir and z is $!zDir

     --!this.drawPlane(TRUE,!tempPlane,567)

     -- create an arc staring at the existing branch direction running back through the plane
     !arc = object ARC()
     !arc.position = !tempPlane.position
     !arc.orientation = !tempPlane.orientation
     !arc .radius = 500mm
     !arc.startAngle = 0
     !arc.endAngle = 90
     !arc.sense = TRUE
     !arc = !arc.circle()
     -- temporary arc draw for debug
     --!this.drawArc(!arc)

     !line = !this.plane.intersection(!tempPlane)
     !line = !line.extendend(500mm)
     -- temporary line for debug
     --!this.drawLine(!line)

     !direction = !arc.angleDirection(!angle[0].real())
     -- debug code
     --!newLine = !line.pointVector()
     --!newLine.direction = !direction
     --!newNewLine = !newLine.line(550)
     --!this.drawLine(!newNewLine)


     !!arc = !arc

    -- now we need to use the angle passed.

return !direction

endmethod

------------------------------------------------------------------------
--
-- Method:      .netOnBranchDirectionChanged
--
-- Description: called when the branch direction is changed
--
------------------------------------------------------------------------
define method .netOnBranchDirectionChanged(!a is ARRAY)

  --  $p branch direction changed to $!a[0]
  --!!alert.error('$!a[0]')
  !dir = !a[0]
  !direction = !dir.direction()
  handle ANY
    !!alert.error('Cannot convert $!a[0] to a direction')
  elsehandle NONE
    !this.newBranchDirection = !direction
  endhandle

  -- update the angle to the branch to the plane
  !this.calculateOffsetFromPlane()

  !this.updateBranchDirectionText()

endmethod

------------------------------------------------------------------------
--
-- Method:      .netOnNudgeAroundChanged
--
-- Description: called when the nudge button is pressed on the control
-- !a[0] is either left or right
-- !a[1] is a real
--
------------------------------------------------------------------------
define method .netOnNudgeAroundChanged(!a is ARRAY)

   -- nudge direction is !a[0] and is either left or Right
   -- nudge amount is !a[1] this needs to be added or subtracted from the current rotation
   !currentAngle = !this.connectionPositionControl.rotation()
   if !a[0].eq('Right') then
     !newAngle = !currentAngle + !a[1]
     if !newAngle.gt(360) then
       !newAngle = !newAngle - 360
     endif
   else
     !newAngle = !currentAngle - !a[1]
     -- may need to work out what happens when it goes below 0
     if !newAngle.lt(0) then
       !newAngle = 360 - !newAngle
     endif
   endif

   !this.rotateAroundPlane(!newAngle)

   -- update the angle to the branch to the plane
   !this.calculateOffsetFromPlane()

   -- update the branch direction
   !this.updateBranchDirectionText()
   -- add the angle labels
   !this.calculateRotationPlane()

endmethod


------------------------------------------------------------------------
--
-- Method:      .netOnNudgeChanged
--
-- Description: called when the nudge button is pressed on the control
-- !a[0] is either left or right
-- !a[1] is a real
--
------------------------------------------------------------------------
define method .netOnNudgeAlongChanged(!a is ARRAY)
  --!!alert.error('$!a[0] $!a[1]')
  --q var !this.plane
    if !this.insertComponent.type inset('ELBO','BEND') and !this.currentConnection.componentOrTube.eq('COMPONENT') then
     -- we need another way of defining !this.plane
     !this.plane = !this.getBendPosition(!this.newSurfacePosition, !this.insertComponent,!a)
     !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
     !this.calculateRotationPlane()
    else
      !pv = !this.plane.pointVector()
      if !a[0].eq('Right') then
        !pvNew = !pv.offset(!a[1])
      else
         !pvNew = !pv.offset(-!a[1])
      endif
      !this.plane = !pvNew.plane()
      if !this.centreLine.set() then
        !intersection = !this.plane.intersection(!this.centreLine)
        !dist = !intersection.distance(!this.plane.position)
        --$p plane needs to be moved by $!dist
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
        !this.calculateRotationPlane()
      endif

      -- need a routine to check if the plane has moved
      !vector = object POINTVECTOR()
      !vector.position = !this.plane.position
      !vector.direction = !this.majorDirection.direction
      !points = !this.currentConnection.getInsertComponentAndPosition(!vector)
      if !points.unset() then
      -- this is for going off the end of the branch
        !this.resetPlane(!a)
      else
        --q var !points[1]
        !testComponent = !points[1][3]
        --q var !testComponent
        !type = !points[1][1]
        if !this.insertComponent.neq(!testComponent).or(!type.neq(!this.componentOrTube)) then
          !this.resetPlane(!a)
       endif
     endif
  endif


  !this.rotateAroundPlane(!this.connectionPositionControl.rotation())
  --!this.copyPlane()
  !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
  !this.calculateRotationPlane()


endmethod

------------------------------------------------------------------------
--
-- Method:      .resetPlane()
--
-- Description: Resets the plane to what it was before a nudge used when
-- the nudge exceeds the component boundaries
--
------------------------------------------------------------------------
define method .resetPlane(!a is ARRAY )

   !!alert.error('You are attempting to move outside the selected component ')
  -- reverse the action
  !pv = !this.plane.pointVector()
  if !a[0].eq('Right') then
  !pvNew = !pv.offset(-!a[1])
  else
  !pvNew = !pv.offset(!a[1])
  endif
  !this.plane = !pvNew.plane()

endmethod

------------------------------------------------------------------------
--
-- Method:      .rotateAroundPlane()
--
-- Description: method to fire a vector down the plane at the passed angle
-- the vector is parallel to the plane but the return vector may not be on
-- items like reducers or bends
--
------------------------------------------------------------------------
define method .rotateAroundPlane(!newAngle is REAL)

   -- set the rotation angle on the form
   !this.connectionPositionControl.rotation(!newAngle)

   -- get the direction flat to the plane
   !direction = !this.getNewDirection(!newAngle)
   -- pass the flat plane direction to get an array
   --q var !direction
   !newSurfacePositions = !this.getNewSurfacePosition(!direction)
   if !newSurfacePositions.unset() then
     return
   endif

     --!newSurfacePositions looks like this
     --[1]  <STRING> 'COMPONENT'
     --[2]  <DIRECTION> Y 42 Z WRT /*
     --[3]  <DBREF> =24104/2785
     --[4]  <POINTVECTOR> POINTVECTOR  POSITION X 3815.228mm Y -21910.567mm Z 35.506mm WRT /*  DIRECTION -X 41.379 Y 44.6921 Z WRT /*
    --q var !newSurfacePositions[1]

   -- now get the new surface POSITION from the ARRAY
   !this.getNewSurfacePositionFromVector(!newSurfacePositions,!direction)

  -- now we need to update the gadgets


endmethod

------------------------------------------------------------------------
--
-- Method:      .init
--
-- Description: form initialisation
--
------------------------------------------------------------------------
define method .init()

  !this.currentConnection = !!pipeTappings.currentConnection
  handle ANY
   return error 99 noalert
  endhandle
  !!pipeTappings.pickpoint.active = FALSE

  -- set the form variables
  !this.currentBranchDirection = !this.currentConnection.branchDirection
  !this.currentSurfacePosition = !!pipeTappings.currentConnection.surfacePosition
  !this.newIntersectPos = !this.currentSurfacePosition
  !this.newSurfacePosition = !this.currentSurfacePosition
  !this.mainBranch = !this.currentConnection.mainBranch
  !this.connectedBranch = !this.currentConnection.connectedBranch
  !this.connectedEnd = !this.currentConnection.headOrTail
  !this.componentOrTube = !this.currentConnection.componentOrTube
  !this.plane =   !!pipeTappings.currentConnection.plane
  !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)

  !this.newBranchDirection = !!pipeTappings.currentConnection.branchDirection

  -- now we need to evaluate the connection
  !pv = object POINTVECTOR()

  if !this.connectedEnd.eq('HEAD') then
    !pv.position = !this.connectedBranch.hPos.wrt(/* )
    !pv.direction = !this.connectedBranch.hDir.wrt(/* ).opposite()
  else
    !pv.position = !this.connectedBranch.tpos.wrt(/* )
    !pv.direction = !this.connectedBranch.tdir.wrt(/* ).opposite()
  endif

  !this.insertComponent = !this.currentConnection.insertComponent


  if !this.currentConnection.componentOrTube.eq('TUBE') then
    !startVector = !this.intersectInTube(!this.insertComponent, !pv )
  else
    !startVector = !this.getIntersection(!this.insertComponent, !pv )
  endif

  !this.calculateCentreline()

  !this.adjustPlaneToCentreline()
  --!!pipeTappings.currentConnection.drawPlane(!!pipeTappings.currentConnection.surfacePosition, !this.insertComponent,'HEAD' )
  if !this.centreLine.set() then
    !intersection = !this.plane.intersection(!this.centreLine)
    !dist = !intersection.distance(!this.plane.position)
    --$p plane needs to be moved by $!dist
    !this.plane.position = !intersection
    !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
  endif

  -- go and work out the rotation angles
  !this.calculateAngles()

  -- calculate the plane about which the rotation will be done
  !this.calculateRotationPlane()

  -- calculate the rotation around the plane
  !this.calculateRotationDirection()

  !this.initialAngle = !this.connectionPositionControl.rotation()

endmethod
------------------------------------------------------------------------
--
-- Method:      .calculateAngles
--
-- Description: exploratory method to find out what data we can harvest
--
------------------------------------------------------------------------
define method .calculateAngles()

  -- get the plane from the main form. This plane is in line with the tube
  --!this.plane =   !this.currentConnection.plane

  if !this.plane.unset() then
   --$p calculating new plane
   -- this is probably not called
   !this.plane = !this.currentConnection.getTubePosition(!this.currentConnection.surfacePosition, !this.currentConnection.insertComponent)
  endif

  -- calculate the offset from the plane
  !this.calculateOffsetFromPlane()

  -- set the branch direction gadget
  !this.updateBranchDirectionText()

endmethod

------------------------------------------------------------------------
--
-- Method:     .calculateOffsetFromPlane()
--
-- Description: method to work out the angle back the plane
--
------------------------------------------------------------------------
define method .calculateOffsetFromPlane()

  !projected = !this.newBranchDirection.projected(!this.plane)
  !angle = !projected.angle(!this.newBranchDirection)
  !pText = !angle.string(!!realFmt)
  !this.connectionPositionControl.planeDirection(!pText)

endmethod
------------------------------------------------------------------------
--
-- Method:     .updateBranchDirectionText()
--
-- Description: method to work out the angle back the plane
--
------------------------------------------------------------------------
define method .updateBranchDirectionText()

  !this.connectionPositionControl.branchDirection(!this.newBranchDirection.string())
  !this.drawNewBranch(TRUE,!this.newSurfacePosition)

endmethod

------------------------------------------------------------------------
--
-- Method:     .calculateRotationDirection()
--
-- Description: method to work out the angle projected onto the plane
--
------------------------------------------------------------------------
define method .calculateRotationDirection()

  !angle  =  !this.rotationArc.near(!this.newSurfacePosition)
  !s = !angle.string(!!realFmt).real()
  -- set the control value
  !this.connectionPositionControl.rotation(!s)
  !this.currentRotationAngle = !angle

endmethod

------------------------------------------------------------------------
--
-- Method:     .getPlaneOffsetAngle
--
-- Description: method to work out the angle projected onto the plane
--
------------------------------------------------------------------------
define method .getPlaneOffsetAngle(!direction is DIRECTION,!position  is POSITION) is REAL

  !onPlaneVector = object POINTVECTOR()
  !onPlaneVector.direction = !direction
  !onPlaneVector.position = !position
  !onPlaneDirection = !onPlaneVector.direction.projected(!this.plane)
  !planeAngle = !onPlaneDirection.angle(!!pipeTappings.currentConnection.branchDirection)
  !this.newPlaneAngle = !planeAngle
  !this.currentPlaneAngle = !planeAngle
  return !planeAngle

endmethod

------------------------------------------------------------------------
--
-- Method:      .intersectInTube
--
-- Description: returns a point vector at the surface position of the
-- intersection between the passed pointVector and tube
--
------------------------------------------------------------------------
define method .intersectInTube(!component is DBREF,!vector is POINTVECTOR)is POINTVECTOR

  !i = object PIPEINTERSECTION( )
  !pv = !i.impliedTubeIntersection(!component, !vector)
  --!i.display()
   --q var !pv
   return !pv

endmethod

------------------------------------------------------------------------
--
-- Method:      .getIntersection
--
-- Description: returns a point vector at the surface position of the
-- intersection between the passed pointVector and component
--
------------------------------------------------------------------------
define method .getIntersection(!component is DBREF, !vector is POINTVECTOR )is POINTVECTOR

  --!this.intersect = object PIPEINTERSECTION(!component is DBREF, !branch is DBREF , !end is STRING ,!option is STRING )
  !i = object PIPEINTERSECTION( )
  -- !component is DBREF, !branch is DBREF , !end is STRING ,!option is STRING

  !pv = !i.intersection(!component, !vector)
  --!i.display()

   return !pv

endmethod

------------------------------------------------------------------------
--
-- Method:      .dismiss
--
-- Description: dismiss button callback. Needs to clear the aid graphics
-- we need to think about undo options and what happens if the user presses
-- dismiss and how it should work
--
--
------------------------------------------------------------------------
define method .dismiss()

   aid clear all $!this.tagAids
   aid clear all $!this.tagPlaneNumber
   aid clear all $!this.tagLineNumber
   !!pipeTappings.pickpoint.active = TRUE
   !!pipeTappings.adjust.active = TRUE
   !this.hide()


endmethod
------------------------------------------------------------------------
--
-- Method:      .apply
--
-- Description: this is the apply method which needs to reset the branch
-- position and update the main form
--
--
------------------------------------------------------------------------
define method .apply()

 !this.updateCurrentConnection()
 -- allow the apply button to be used on the main form
 !!pipeTappings.apply.active = TRUE
 !this.dismiss()

endmethod
------------------------------------------------------------------------
--
-- Method:      .updateCurrentConnection
--
-- Description: method to put the new fixed attributes back into the
-- currentConnection (PIPETAPPINGCONNECTION) object
--
--
------------------------------------------------------------------------
define method .updateCurrentConnection()

  !this.currentConnection.branchDirection = !this.newBranchDirection
  !this.currentConnection.surfacePosition  = !this.newSurfacePosition
  -- move the branch
  !vector = object POINTVECTOR()
  !vector.direction = !this.newBranchDirection
  !vector.position = !this.newSurfacePosition
  !this.currentConnection.repositionBranch(!vector)
  !!pipeTappings.currentConnection = !this.currentConnection
  !this.init()
  -- now we need to initialise the connection so that it is capable of
  -- making a proper connection

  --!!pipeTappings.getStandardBranchConnection(!this.connectedBranch)
  -- reset the form to be in existing mode
  -- potentially this could be removed
  !!pipeTappings.setoption(true)
  !!pipeTappings.pickStubInBranch(!this.connectedBranch,TRUE )

endmethod
------------------------------------------------------------------------
--
-- Method:      .drawNewBranch
--
-- Description:
--
--
------------------------------------------------------------------------
define method .drawNewBranch(!mode is BOOLEAN, !dPosition is POSITION)

 if !this.connectedEnd .eq('HEAD') then
   !diameter = !this.connectedBranch.phod
 --Hold end to be connected head or tail (true False)
 else
   !diameter = !this.connectedBranch.ptod
 endif

 !height = 500mm
  aid CLEAR CYLI $!<this.tagAids>
  handle ANY
  --q var !!error
  endhandle
   if !mode then
   --q var !insert
     !pv = object POINTVECTOR()
     !pv.position  = !dPosition
     !pv.direction = !this.newBranchDirection
     !newPv = !pv.offset(!height / 2)
     !diameter = !diameter + 1mm
     --pin 9 at  $!<newPv.position>
     !posString = !newPv.position.string().before('WRT')

     --$P AID CYLINDER NUMBER $!<this.tagAids>  AT $!<posString>  ORI Z IS $!<pv.direction>  HEIGH $!<height> DIAM $!<diameter> FILLED ON
     AID CYLINDER NUMBER $!<this.tagAids>  AT $!<posString>  ORI Z IS $!<pv.direction>   HEIGH $!<height> DIAM $!<diameter> FILLED ON
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      planeSplit
--
-- Description: method to draw or remove the passed plane
--
--
------------------------------------------------------------------------
define method .drawPlane(!mode is BOOLEAN,!plane is PLANE,!aidNo is REAL)

  if !plane.unset() then
     --$p plane unset
    return
  endif

  --$p plane not unset
  --q var !mode

  if !mode then
       -- get the size of the plane

       !psize   =   1000mm
       !planePos  = !plane.position
       !planeDrn  = !plane.orientation.zDir().wrt(/* )

       -- draw the plane box
       aid translucency 35
        --$p $M /%PDMSUI%\des\clib\gplane $!psize $<plane $!planeDrn through $!planePos$> $<$> true $<$> $<$> $!this.tagPlaneNumber $<on$>
          $M /%PDMSUI%\des\clib\gplane $!psize $<plane $!planeDrn through $!planePos$> $<$> true $<$> $<$> $!aidNo $<on$>
       aid translucency 0
 else
       --AID CLEAR TEXT $!this.tagId
       AID CLEAR TEXT $!aidNo
       handle ANY
       endhandle
       AID CLEAR sphere $!aidNo
       -- AID CLEAR cylinder $!this.tagId
       handle ANY
       endhandle
       --AID CLEAR arrow $!this.tagId
       AID CLEAR arrow $!aidNo
       handle ANY
       endhandle
       AID CLEAR BOX $!aidNo
       handle ANY
       endhandle
  endif
  -- calculate and display the x,y,z tags for the current plane.
  !this.planeTags()

endmethod

------------------------------------------------------------------------
--
-- Method:      planeTags
--
-- Description: Works out a set of direction tags to add to the drawn plane
-- this method need to be simplified
--
------------------------------------------------------------------------
define method .planeTags()

   !directionArray = ARRAY()
   aid clear text $!this.tagPlaneNumber
   handle ANY
   endhandle
   !orientation = !this.plane.orientation
   !planePosition = !this.plane.position

   !directionE = object POINTVECTOR()
   !directionE.position = !planePosition
   !directionE.direction = !orientation.xDir().wrt(/* )
   !textpos = !directionE.offset(503mm).position

   -- now get the north
   !directionN = object POINTVECTOR()
   !directionN.position = !planePosition
   !directionN.direction = !orientation.yDir().wrt(/* )

   -- now the west
   !directionW = !directionE
   !directionW.direction = !directionW.direction.opposite()
   !textpos = !directionW.offset(503mm).position

   -- now the south
   !directions = !directionN
   !directions.direction = !directions.direction.opposite()

   !directionArray[1] = !directionE
   !directionArray[2] = !directionN
   !directionArray[3] = !directionW
   !directionArray[4] = !directions

   !this.majorDirection  = !this.getBestFit(!directionArray)

   !line = !this.majorDirection.line(500mm)
   !this.drawLine(!line)

endmethod

------------------------------------------------------------------------
--
-- Method:      .getBestFit
--
-- Description: calcULATES THE BEST FIR GOT THE MAJOR DIRECTION
--
--
------------------------------------------------------------------------

define method .getBestFit(!directions is ARRAY ) is POINTVECTOR

!angles = ARRAY()
do !a index !directions
  !b = !directions[!a].towards(!this.newIntersectPos)
  !angles.append(!directions[!a].direction.angle(!b.direction))
enddo

!index = !angles.sortedindices()


return !directions[!index[1]]
-- return the major direction

endmethod

------------------------------------------------------------------------
--
-- Method:      .getBasicPosition()
--
-- Description: method to provide orthogonal options for the rough pick
-- when locating branches.
-- parameters are nearest angle and string indicating tube or component
-- tube is easiest
-- This method is not yet implemented
--
------------------------------------------------------------------------
define method .getBasicPosition(!original is DIRECTION , !plane is PLANE,!component is STRING)is ARRAY

  -- !original is the angle tolerance which is passed in currently this is fixed at 45

  if !original.unset() then
    return object ARRAY()
  endif

  -- we have a direction and a plane we now need to work out the best orthogonal fit within the plane
  !ang[1] = !plane.orientation.xDir().wrt(/* )
  !ang[2] = !plane.orientation.yDir().wrt(/* )
  !ang[3] = !plane.orientation.zDir().wrt(/* )
  !ang[4] = !plane.orientation.xDir().wrt(/* ).opposite()
  !ang[5] = !plane.orientation.yDir().wrt(/* ).opposite()
  !ang[6] = !plane.orientation.zDir().wrt(/* ).opposite()

  !angles = ARRAY()

  do !a from 1 to 6
     !angles[!a] = !this.branchDirection.angle(!ang[!a])
  enddo

  !index = !angles.sortedindices()
  !this.branchDirection = !ang[!index[1]]
  --q var !this.branchDirection
  !vector = object POINTVECTOR()
  !vector.position = !this.plane.position
  !vector.direction = !this.branchDirection.opposite()
  !this.mainvector = !vector

endmethod
------------------------------------------------------------------------
--
-- Method:      .drawArc
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .drawArc(!arc is ARC)

  aid clear arc $!<this.tagAids>
  handle ANY
  endhandle
  !midPoint = !arc.anglePosition(!arc.angle() / 2)
  !arcStart = !arc.anglePosition(!arc.startAngle)
  !arcEnd   = !arc.anglePosition(!arc.endAngle)

  AID ARC NUMBER  $!<this.tagAids> $!<arcStart> TO $!<arcEnd> thru $!<midPoint>

endmethod

------------------------------------------------------------------------
--
-- Method:      .drawArc
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .drawLine(!line is LINE)

  aid clear line $!this.tagLineNumber
  handle ANY
  endhandle
  aid line number $!this.tagLineNumber  $!line.startPosition to $!line.endPosition lines dashed

endmethod

------------------------------------------------------------------------
--
-- Method:      .calculateCentreline
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .calculateCentreline()

  !this.centreLine = object LINE()
  --q var !this.currentConnection
  if !this.currentConnection.insertComponent.type inset('ELBO','BEND') and !this.currentConnection.componentOrTube.neq('TUBE') then
     !this.bendArc = !this.currentConnection.getBendArc(!this.currentConnection.insertComponent)
     --!this.drawArc(!this.bendArc)
  else
     -- if we are on a component not tube
     if !this.currentConnection.componentOrTube.eq('COMPONENT') then
     -- calculate the centreline
       !aDir = !this.currentConnection.insertComponent.aDir.wrt(/* )
       !lDir = !this.currentConnection.insertComponent.lDir.wrt(/* )
     elseif !this.currentConnection.componentOrTube.eq('TUBE') then
       if !this.currentConnection.insertComponent.type.eq('BRAN') then
         !lDir = !this.currentConnection.insertComponent.hDir.wrt(/* )
         !lPosition = !this.currentConnection.insertComponent.hPos
       else
         !lDir = !this.currentConnection.insertComponent.lDir.wrt(/* )
         !lPosition = !this.currentConnection.insertComponent.lPos.wrt(/* )
       endif
       !aDir =  !lDir.opposite()
       !vector = object POINTVECTOR()
       !vector.position  = !lPosition
       !vector.direction = !lDir
       !newVector = !vector.through(!this.currentConnection.branchPosition)
       !this.centreLine = !newVector.line(500mm)
       !this.centreLine = !this.centreLine.extendStart(500mm)
     endif
     if !aDir.opposite().eq(!lDir).and(!this.currentConnection.componentOrTube.neq('TUBE')) then
      -- its an inline component
      !this.centreLine.startPosition = !this.currentConnection.insertComponent.aPos.wrt(/* )
      !this.centreLine.endPosition   = !this.currentConnection.insertComponent.lPos.wrt(/* )
      if !this.centreLine.length().eq(0) then
         !this.centreLine = object LINE()
      endif
    endif
  endif

  if !this.centreLine.set() then
    !this.drawLine(!this.centreLine)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .calculateRotationPlane()
--
-- Description: create an arc object representing the direction from plane
-- this method is called once to setup the arc but may need to be re-evaluated
-- when the other parameters change
--
--
------------------------------------------------------------------------
define method .calculateRotationPlane()

  -- get the plane between the plane direction and the current branch direction

  !dir = !this.majorDirection.direction
  !this.newRotationAngle = !this.currentRotationAngle

  !ortho = !dir.orthogonal(!this.currentBranchDirection)
  handle(2,890)
  -- the current branch direction is already on the plane
   !ortho = !this.currentBranchDirection
  endhandle

  -- construct an arc on the plane between the two directions
  !this.rotationArc= object ARC()
  !this.rotationArc.position = !this.plane.position
  !this.rotationArc.orientation = !this.plane.orientation
  !zDir = !this.plane.orientation.zDir()
  !xDir = !this.majorDirection.direction.string().before('WRT')
  !string = 'X IS ' & !xDir & 'AND Z IS ' & !zDir
  !this.rotationArc.orientation = $!string
  --New orientation

  !this.rotationArc.radius = 500mm
  !this.rotationArc.startAngle = 0
  !this.rotationArc.endAngle = 370
  !this.rotationArc.sense = FALSE
  !this.rotationArc= !this.rotationArc.circle()

  -- calculate the major direction angle
  !newLabels[1] = !this.rotationArc.anglePosition(0)
  !newLabels[2] = !this.rotationArc.anglePosition(90)
  !newLabels[3] = !this.rotationArc.anglePosition(180)
  !newLabels[4] = !this.rotationArc.anglePosition(270)

    do !a index !newLabels
     !textpos = !newLabels[!a]
     !atext = (!a - 1) * 90
     AID text number  $!this.tagPlaneNumber '$!atext' at $!textpos
   enddo


  -- draw the arc
  !this.drawArc(!this.rotationArc)


endmethod

------------------------------------------------------------------------
--
-- Method:      .adjustPlaneToCentreline()
--
-- Description: in order to work out the offset radius we need accurately position the
-- plane on the centreline for tube and in line components a centreline is
-- generated based on arrive/leave positions
-- For bends and elbows there is an arc
-- This does not cover mitred bends or tees which turn through 90 degrees
--
------------------------------------------------------------------------
define method .adjustPlaneToCentreline()

-- we know the passed direction is correct about the centreline providing we are on the centreline
      if !this.centreLine.set() then
        !intersection = !this.plane.intersection(!this.centreLine)
        !dist = !intersection.distance(!this.plane.position)
        --$p plane needs to be moved by $!dist
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
      elseif !this.bendArc.set() then
        !intersections = !this.plane.intersections(!this.bendArc)
        do !a values !intersections
           if !this.bendArc.on(!a) then
              !intersection = !a
              break
           endif
        enddo
        !dist = !intersection.distance(!this.plane.position)
        handle any
          !!alert.error('A problem occurred calculating the plane intersection please try again.')
          !this.dismiss()
          return error 444 noalert
        endhandle
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
      endif

endmethod

------------------------------------------------------------------------
--
-- Method:      getNewSurfacePosition
--
-- Description: gets and returns an array of values relating to the
-- new branch positions
--
--
------------------------------------------------------------------------
define method .getNewSurfacePosition(!direction is DIRECTION ) is ARRAY

  -- we know the passed direction is correct about the centreline providing we are on the centreline
      if !this.centreLine.set() then
        !intersection = !this.plane.intersection(!this.centreLine)
        !dist = !intersection.distance(!this.plane.position)
        --$p plane needs to be moved by $!dist
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
      elseif !this.bendArc.set() then
        !intersections = !this.plane.intersections(!this.bendArc)
        do !a values !intersections
           if !this.bendArc.on(!a) then
              !intersection = !a
              break
           endif
        enddo
        !dist = !intersection.distance(!this.plane.position)
        handle ANY
          !!alert.error('You cannot move outside the selected component')
          return object ARRAY()
        endhandle
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane,!this.tagPlaneNumber)
      endif
   -- construct a vector in the opposite direction to the passed direction
   !pv = object POINTVECTOR()
   !pv.position = !this.plane.position
   !pv.direction = !direction
   --!pv = !pv.offset(1000)

   !pv.direction = !direction.opposite()
   --pin6 at $!pv.position
   --pin 6 direction $!pv.direction
   --q var !pv
   !points = !this.currentConnection.getInsertComponentAndPosition(!pv)
   return !points
   --!points looks like this
   --[1]  <STRING> 'COMPONENT'
   --[2]  <DIRECTION> Y 42 Z WRT /*
   --[3]  <DBREF> =24104/2785
   --[4]  <POINTVECTOR> POINTVECTOR  POSITION X 3815.228mm Y -21910.567mm Z 35.506mm WRT /*  DIRECTION -X 41.379 Y 44.6921 Z WRT /*


endmethod

------------------------------------------------------------------------
--
-- Method:      .getNewDirection
--
-- Description: gets and returns the new branch direction from the passed
-- rotation angle
--
--
------------------------------------------------------------------------
define method .getNewDirection(!angle is REAL ) is DIRECTION

 -- this is scary
 !this.calculateRotationPlane()

  --!d1 = !this.rotationArc.angleDirection(0)
  --$p arc direction = $!d1 major = $!this.majorDirection
  !d2 = !this.rotationArc.angleDirection(!angle)

  --!pos = !this.plane.position
  --pin3 at $!pos
  --pin 3 direction $!d2
 return !d2

endmethod

------------------------------------------------------------------------
--
-- Method:      .getNewSurfacePositionFromVector()
--
-- Description: method to set the new surface position and direction
-- based on the passed array details
--
--
------------------------------------------------------------------------
define method .getNewSurfacePositionFromVector(!a is ARRAY,!direction is DIRECTION)

   !inter = !a[1]
   do !b values !a
     if !b[3].eq(!this.insertComponent) then
       !inter = !b
       break
     endif
   enddo

   --passed array looks like this
   --[1]  <STRING> 'COMPONENT'
   --[2]  <DIRECTION> Y 42 Z WRT /*
   --[3]  <DBREF> =24104/2785
   --[4]  <POINTVECTOR> POINTVECTOR  POSITION X 3815.228mm Y -21910.567mm Z 35.506mm WRT /*  DIRECTION -X 41.379 Y 44.6921 Z WRT /*
   !type = !inter[1]
   !component = !inter[3]
   !passedVector = !inter[4]
   --!passedVector.direction = !inter[2].opposite()
   --!passedVector.direction = !passedVector.direction.opposite()


  if !type.eq('COMPONENT') then
    !vector = object POINTVECTOR()
    --!insert = 'COMPONENT'
    !vector = !this.intersect.intersection(!component,!passedVector)
    !copyPlane = !this.plane
    !copyPlaneDirection = !copyPlane.direction().cross(!direction)
    !copyPlaneXDirection = !copyPlane.direction()
    !ori = Z is $!copyPlaneDirection and x is $!copyPlaneXDirection
    !copyPlane.orientation =!ori
    !passedVector.direction = !direction
    !line = !inter[4].line(1000mm)
    !newLine = !line.projected(!copyPlane)
    !vector = !newLine.pointVector()

    !direction = !this.getNewDirection(!this.initialAngle)
    -- pass the flat plane direction to get an array
    !newSurfacePositions = !this.getNewSurfacePosition(!direction)

    !newInter = !newSurfacePositions[1]
    do !c values !newSurfacePositions
      if !c[3].eq(!this.insertComponent) then
        !newInter = !c
        break
      endif
    enddo
    !this.newIntersectPos = !newInter[4].position
  else
  	!passedVector.direction = !passedVector.direction.opposite()
    !vector = !this.intersect.impliedTubeIntersection(!component,!passedVector)
  endif

  --q var !vector
  -- set the new virtual branch direction and position
  !this.newBranchDirection = !vector.direction
  !this.newSurfacePosition = !vector.position

  -- redraw the branch
  !this.drawNewBranch(FALSE,!this.newSurfacePosition )
  !this.drawNewBranch(TRUE,!this.newSurfacePosition )

  -- redraw rotation plane aids
  !this.calculateRotationPlane()

endmethod

-----------------------------------------------------------------------
--
-- Method:      drawArrow
--
-- Description:
--
--
------------------------------------------------------------------------
define method .drawArrow(!pointVector is POINTVECTOR )

  aid clear text $!this.tagArrowNumber
  handle ANY
  endhandle
  aid clear arrow $!this.tagArrowNumber
  handle ANY
  endhandle
 !arrowPosition    = !pointVector.position
 !arrowDirection   = !pointVector.direction
 !height = 300
  AID ARROW NUMBER $!<this.tagArrowNumber> AT $!<arrowPosition> DIRECTION $!<arrowDirection> HEIGHT $!<height> PROPORTION 0.5
  AID TEXT NUMBER $!<this.tagArrowNumber> '$!arrowPosition' AT $!<arrowPosition>

endmethod

------------------------------------------------------------------------
--
-- Method:      method .getBendPosition
--
-- Description: method to orientate the plane according to the pick direction
--              for elbows and bends
--
------------------------------------------------------------------------
define method .getBendPosition(!passedPosition is POSITION, !element is DBREF,!move is ARRAY ) is PLANE

   -- this duplicates some of the code above
   !this.bendArc = !this.currentConnection.getBendArc(!element)
   !positions = !this.bendArc.intersections(!this.plane)
   --!positions = !bendArc.intersections(!finalPlane)
   !p = ARRAY()
   !q = ARRAY()
   do !a values !positions
     !p.append(!this.bendArc.anglePosition(!a))
     !q.append(!this.bendArc.angleDirection(!a))
   enddo

   if !p[1].distance(!this.plane.position).lt(!p[2].distance(!this.plane.position)) then
      !index = 1
   else
      !index = 2
   endif

   !this.plane.position = !this.bendArc.anglePosition(!this.bendArc.intersections(!this.plane)[!index])

   -- now we need to rotate the plane around the arc by a given position
   !newFinalPlane = !this.applyRotation(!this.plane,!move,!this.bendArc)

   !ori = !newFinalPlane.orientation.zDir()
   !dir = !q[!index].string()

   --!newOri = x is $!dir and z is $!ori

   --!newFinalPlane.orientation = !newOri
   return !newFinalPlane

endmethod

------------------------------------------------------------------------
--
-- Method:      method .applyRotation
--
-- Description: method to rotate a plane around an arc and return a plane
--              for elbows and bends
--
------------------------------------------------------------------------
--
define method .applyRotation(!plane is PLANE, !move is ARRAY, !arc is ARC)is PLANE

  -- calculate the distance
  if !move[1].lt(1) then
    !moveAngle = 0
  else
    !moveAngle = (!move[1] / (PI * (!arc.radius * 2)) * 180)
  endif

  !currentAngle = !arc.near(!plane.position)

  if !move[0].eq('Right')then
    !newAngle = !currentAngle + !moveAngle.value()
  else
    !newAngle = !currentAngle - !moveAngle.value()
  endif

  !newPlane = !plane

  !newPlane.position = !arc.anglePosition(!newAngle)
  !newPlaneDirection = !arc.angleTangent(!newAngle)
  !newPlaneXDirection = !plane.orientation.xDir()
  !ori = Z is $!newPlaneDirection and x is $!newPlaneXDirection
  !newPlane.orientation =!ori

  return !newPlane


endmethod

-----------------------------------------------------------------------
--
-- Method:      method .getTubePosition
--
-- Description: method to orientate the plane according to the pick direction
--
--
------------------------------------------------------------------------
define method .getTubePosition(!passedPosition is POSITION, !element is DBREF) is PLANE

-- now used to calculate the insert angle

   !finalPlane = object PLANE()
   -- need to handle branch tube
   if !element .type.eq('BRAN') then
      !lPosition = !element.hPos.wrt( /* )
      !lDir = !element.hDir.wrt( /* )
   else
      !lPosition = !element.lPos.wrt( /* )
      !lDir = !element.lDir.wrt( /* )
   endif
   !leavePV = object POINTVECTOR()
   !leavePV.position  = !lPosition
   !leavePV.direction = !lDir
   !testAngle = !lDir.angle(!this.currentBranchDirection)
   if !testAngle.gt(90) then
     !this.insertAngle = 180 - !testAngle
   else
     !this.insertAngle = !testAngle
   endif

   -- get a new POINTVECTOR through the picked position
   !centrelinePV = !leavePV.through(!passedPosition)
   !finalPlane = !centrelinePV.plane()
   -- this is the method for rounding the angle-- yet to be completed
   --!this.getBasicPosition(45,!finalPlane,'tube')
   !this.drawPlane(TRUE ,!finalPlane)

   return !finalPlane

endmethod
------------------------------------------------------------------------
--
-- Method:      makePlane
--
-- Description: makes a plane object from a position and a direction
-- used several times.
--
------------------------------------------------------------------------
define method .makePlane(!passedPosition is POSITION,!direction is DIRECTION)is PLANE

   !plane = object PLANE()
   !plane.position = !passedPosition
   !plane.orientation = z is $!direction
   return !plane

endmethod

------------------------------------------------------------------------
--
-- Method:      planeSplit
--
-- Description: method to orientate the plane according to the pick direction
--
--
------------------------------------------------------------------------
define method .drawPlane(!mode is BOOLEAN,!plane is PLANE)

  if !plane.unset() then
    return
  endif

  if !mode then
       -- get the size of the plane

       !psize   =   1000mm
       !planePos  = !plane.position
       !planeDrn  = !plane.orientation.zDir()

       -- draw the plane box
       aid translucency 35
       --$P $M /%PDMSUI%\des\clib\gplane $!psize $<plane $!planeDrn through $!planePos$> $<$> true $<$> $<$> 999 $<on$>
          $M /%PDMSUI%\des\clib\gplane $!psize $<plane $!planeDrn through $!planePos$> $<$> true $<$> $<$> 999 $<on$>
       aid translucency 0

 else
       --AID CLEAR TEXT $!this.tagId
       AID CLEAR TEXT $!this.tagPlaneNumber
       handle ANY
       endhandle
       AID CLEAR sphere $!this.tagPlaneNumber
       -- AID CLEAR cylinder $!this.tagId
       handle ANY
       endhandle
       --AID CLEAR arrow $!this.tagId
       AID CLEAR arrow $!this.tagPlaneNumber
       handle ANY
       endhandle
       AID CLEAR BOX $!this.tagPlaneNumber
       handle ANY
       endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .drawOrientation
--
-- Description: method to  draw an orientation used for debug and test
-- not required in everyday use
--
------------------------------------------------------------------------

define method .drawOrientation(!orientation is ORIENTATION,!xyPosition is POSITION )

--  POSITION <POSITION> E 29567.387mm S 4119.116mm U 15382.27mm WRT /*
--  ORIENTATION <ORIENTATION> Y is W 40.7013 N 38.5492 D WRT /* and Z is W 25 S 27.3123 U WRT /*

  aid clear line  $!this.tagAxesNumber
  handle ANY
  endhandle
  aid clear text  $!this.tagAxesNumber
  handle ANY
  endhandle
  aid clear arrow $!this.tagAxesNumber
  handle ANY
  endhandle
  !vector = object POINTVECTOR()
  !vector.position = !xyPosition
  !vector.direction = !orientation.xDir().wrt(/* )
  !line = !vector.line(750mm)
  !textpos = !line.endPosition
  !atext = 'X'
  aid line number $!this.tagAxesNumber  $!line.startPosition to $!line.endPosition lines dashed
  AID text number  $!this.tagAxesNumber '$!atext' at $!textpos
  !vector.direction = !orientation.xDir().wrt(/* ).opposite()
  !line = !vector.line(750mm)
  !textpos = !line.endPosition
  !atext = '-X'
  aid line number $!this.tagAxesNumber  $!line.startPosition to $!line.endPosition lines dashed
  AID text number  $!this.tagAxesNumber '$!atext' at $!textpos
  !vector.direction = !orientation.yDir().wrt(/* )
  !line = !vector.line(750mm)
  !textpos = !line.endPosition
  !atext = 'Y'
  aid line number $!this.tagAxesNumber  $!line.startPosition to $!line.endPosition lines dashed
  AID text number  $!this.tagAxesNumber '$!atext' at $!textpos
  !vector.direction = !orientation.yDir().wrt(/* ).opposite()
  !line = !vector.line(750mm)
  !textpos = !line.endPosition
  !atext = '-Y'
  aid line number $!this.tagAxesNumber  $!line.startPosition to $!line.endPosition lines dashed
  AID text number  $!this.tagAxesNumber '$!atext' at $!textpos
  !vector.direction = !orientation.zDir().wrt(/* )
  !line = !vector.line(750mm)
  !textpos = !line.endPosition
  !atext = 'Z'
  aid line number $!this.tagAxesNumber  $!line.startPosition to $!line.endPosition lines dashed
  AID text number  $!this.tagAxesNumber '$!atext' at $!textpos
  !vector.direction = !orientation.zDir().wrt(/* ).opposite()
  !line = !vector.line(750mm)
  !textpos = !line.endPosition
  !atext = '-Z'
  aid line number $!this.tagAxesNumber  $!line.startPosition to $!line.endPosition lines dashed
  AID text number  $!this.tagAxesNumber '$!atext' at $!textpos

endmethod

