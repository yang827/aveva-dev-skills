---
-- Description:
--  Pipe creation & modification form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appendList()                     -
--  deleteAid()                      -                   delete the graphical aid picked
--  drawPlane()                      -
--  enhance()                        -                   Enhancement colour of picked field in the list
--  initialise()                     -                   initialisation
--  modifyAid(ARRAY,STRING)          -                   modify the graphical aid picked
--  pickAid(STRING)                  -                   pickAid to modify
--  pickElements()                   -
--  pickLine()                       -
--  processLinePick(LINE)            -
--  processPlanePick(EDGPOSITIONDATA) -
--  processSctnPick(DBREF)           -
--  removeFromList()                 -                   Remove selected fields from the list for Z-distances
--  setUp(DBREF,STRING)              -
--  splitGenSectPane()               -                   Constructor
--  splitOnLine()                    -
--  tidy(BOOLEAN)                    -                   Remove all enhancements and aids if any
--  updateModifyDtls(STRING)         -                   update the form with details entered in the GPHPLANEEDIT form
--  validateDirTxt(STRING)           BOOLEAN             validate the text gadget for setting plane direction
--
------------------------------------------------------------------------

setup form !!splitGenSectPane dialog  dock right

  !this.formTitle     = 'Split Steel '
  !this.iconTitle     = 'Trim Sections'
  !this.callback      = '!this.setUp()'
  !this.initcall      = '!this.initialise()'
  !this.quitcall      = '!this.tidy(TRUE)'

  option .loadList 'Add to list' anchor left + right + top  at ymax+0.25 callback '!this.appendList()'  width 13.9
  path DOWN
  -- List of elements
  list .list      'Elements to split' anchor left + right + top   at xmin   ymax+0.25 callback|!this.enhance()|     columns multiple width 30 lines 10

  frame .splitOnFrame 'Define split-on' anchor left+right+top at xmin.list ymax.list+0.5 width 29.2
     option .splitOn        callback '!this.pickLine()'  width 15.8
     -- Plane size
     text .txtPlaneSize |Plane Size| anchor left at xmin.splitOn ymax.splitOn+0.5 callback |!this.validateDirTxt('SIZE')| width 7 is REAL format !!distanceFmt

     path RIGHT
     -- Fill/unfill
     toggle .togPlaneFill |Fill| anchor right at xmax.txtPlaneSize+3.2 callback |!this.drawPlane()| states |off| |on|

     path DOWN
     text .txtDirection 'Plane Direction'anchor left+right+top  at xmin.txtPlaneSize callback |!this.validateDirTxt('DRN')| tagwidth 11 width 8  is STRING  tooltip 'Set after graphical pick'

     path RIGHT
     toggle .togDirnLock  || anchor right at xmax.txtDirection+2.2 callback |!this.txtDirection.active = !this.togDirnLock.val.not()| states |off| |on|

     path DOWN
     button .modifyGphAid 'Modify Graphical aid line/plane'  anchor left+top+right  at xmin.txtDirection     callback '!this.pickAid(|MODIFY|)' width 23
     button .deleteGphAid 'Delete Graphical aid line(s)/plane(s)'  anchor left+top+right  at xmin.txtDirection     callback '!this.pickAid(|DELETE|)' width 23
  exit

  -- Gap at split for sections
  text .gap  'Clearance at split    ' callback || at xmin.list width 5 is REAL format !!distanceFmt tooltip 'Only for sections'

  -- Angle at split for sections
  text .angle  'Angle at split' callback || at xmin.list width 3 is REAL  tooltip 'Only for sections'

  path RIGHT
  hdist 1.0
  -- Option for angle direction
  option .about at xmax.list-8.5 width 5

  path DOWN

  -- Frame for connection at split option
  frame .connections 'Connections at split' anchor left+right+top at xmin.splitOnFrame ymax.splitOnFrame+0.5 width 32.2
     rToggle .noConn 'None'    at xmin+1.0    callback ||
     rToggle .nodes  'Nodes'   at xmin.noConn callback || tooltip 'Only for sections'
     rToggle .trim   'Trimmed' at xmin.nodes  callback || tooltip 'Only for sections'
     para .condition at xmin.trim  text 'This is applicable for sections only' width 25
  exit

  -- Split
  button .apply 'Split'  anchor left+top  at xmin.list      callback '!this.splitOnLine()' width 4

  -- Define pop-up for the list to remove picked field
  menu .pop1 popup

     !this.pop1.add( 'CALLBACK', 'Add ce', '!this.setUp(ce,|ce|)' ,'CE' )
     !this.pop1.add( 'CALLBACK', 'Add ce members', '!this.setUp(ce,|CEMEMBERS|)' ,'CEMEMBERS' )
     !this.pop1.add( 'CALLBACK', 'Add from current list', '!this.setUp(ce,|list|)','LIST' )
     !this.pop1.add( 'CALLBACK', 'Add by graphical pick', '!this.pickElements()','PICK' )
     !this.pop1.add( 'CALLBACK', 'Add from graphical window selection', '!this.setUp(ce,|window|)','WINDOW' )
     !this.pop1.add('separator')
     !this.pop1.add( 'CALLBACK', 'Remove Selected from list', '!this.removeFromList()' ,'REMSEL' )
     !this.pop1.add( 'CALLBACK', 'Clear list', '!this.tidy(FALSE)' , 'REMALL' )

  -- Form Members

  -- Stores the element to split
  member .elements   is ARRAY

  -- Stores the split point positions
  member .ptIntrsctn is ARRAY

  -- Stores the graphical aid lines to be used for splitting
  member .graphLine  is ARRAY

  -- Stores the graphical aid planes to be used for splitting
  member .graphPlane  is ARRAY

  -- Stores the dtext of the list
  member .listMem is ARRAY

  -- Flag, value is TRUE if graphical aid line is defined
  member .check is BOOLEAN

  -- Stores the definition of graphical plane
  member .plane is PLANE

  -- Stores the sections used for splitting
  member .splitOnSctn is ARRAY

  -- Flag , value is TRUE if the items to split list contains type SCTN
  member .sctnPresent is BOOLEAN

  -- Aid number for graphical line
  member .aidNumber   is ARRAY

  -- Define an undo object
  member .markForUndo is UNDOABLE

  -- Store the latest direction  entered
  member .dirLatest   is STRING

  -- Store the latest plane size entered
  member .planeSizLatest   is REAL

  -- Store the aid number reference of the picked aid for modification.
  member .pickedAid    is  REAL

  -- Store aids to be deleted
  member .aidsToDelete is  ARRAY

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      splitGenSectPane
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitGenSectPane()

  !heading[1] = 'Type'
  !heading[2] = 'Name'

  !this.list.setHeadings(!heading)

  -- Pop-up to remove items from the list
  !this.list.setPopUp(!this.pop1)

  -- This is for future use
  !about[1]   = 'About  X'
  !about[2]   = 'About -X'
  !about[3]   = 'About  Y'
  !about[4]   = 'About -Y'

  !this.about.dtext = !about

  -- Set two options for the user to split-on
  !splitOn[1]   = 'Pick Section(s) to split on'
  !splitOn[2]   = 'Define Graphical Aid Line(s) to split on'
  !splitOn[3]   = 'Define Graphical Aid Plane(s) to split on'

  !this.splitOn.dtext = !splitOn
  var !coordinate coordinate
  if(!coordinate eq 'ENU')then
    !this.txtDirection.val  =  'U'
  else
    !this.txtDirection.val  =  'Z'
  endif
  if (!!isImperialLength('DIST')) then
      !this.txtPlaneSize.val  =  40inch
  else
      !this.txtPlaneSize.val  =  1000mm
  endif

  !this.dirLatest         =  !this.txtDirection.val
  !this.planeSizLatest    =  !this.txtPlaneSize.val
  !this.txtDirection.active  =  FALSE

  -- Set options to append the list
  !loadList[1]  = 'CE'
  !loadList[2]  = 'CE Members'
  !loadList[3]  = 'Current list'
  !loadList[4]  = 'Graphical pick'
  !loadList[5]  = 'Graphical window selection'
  !this.loadList.dtext  =  !loadList

  !loadListRtext[1]  = 'CE'
  !loadListRtext[2]  = 'CEMEM'
  !loadListRtext[3]  = 'LIST'
  !loadListRtext[4]  = 'GPHPICK'
  !loadListRtext[5]  = 'GPHSEL'
  !this.loadList.rtext  =  !loadListRtext

  -- Make connections option inactive until we get sections to split and split-on
  !this.connections.active   =  FALSE
  !this.connections.val      =  1

  !this.sctnPresent   =  FALSE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialisation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Graphical line already exists?
  !this.check =  FALSE
  -- if split/split-on data is unset, make the split button inactive
  if(!this.list.dtext.set() AND (!this.graphLine.set() OR !this.graphPlane.set()))then
     !this.apply.active = TRUE
  else
     !this.apply.active = FALSE
  endif

  -- For future use
  !this.gap.val   = 0
  !this.angle.val = 0

  -- if split/split-on section is defined give the split button to the user
  if(!this.splitOn.val eq 1 AND !this.sctnPresent)then
     !this.connections.active   =  TRUE
     !this.connections.val      =  1
  endif

  -- Activate/deactivate plane direction text gadget
  if(!this.splitOn.val eq 3)then
     if(!this.togDirnLock.val)then
        !this.txtDirection.active   =  FALSE
     else
        !this.txtDirection.active   =  TRUE
     endif
     !this.txtPlaneSize.active   =  TRUE
     !this.togDirnLock.active    =  TRUE
     !this.togDirnLock.active    =  TRUE
  else
     !this.txtDirection.active   =  FALSE
     !this.txtPlaneSize.active   =  FALSE
     !this.togPlaneFill.active   =  FALSE
     !this.togDirnLock.active    =  FALSE
  endif

  !this.modifyGphAid.active   =  FALSE
  !this.deleteGphAid.active   =  FALSE

  -- Set POPUP field properties
  !this.pop1.setFieldProperty('REMSEL','ACTIVE',FALSE)
  !this.pop1.setFieldProperty('REMALL','ACTIVE',FALSE)


  -- This is for future use
  !this.gap.visible          =  FALSE
  !this.angle.visible        =  FALSE
  !this.about.visible        =  FALSE

  var !coordinate coordinate
  if(!coordinate eq 'ENU')then
    !this.txtDirection.val  =  'U'
  else
    !this.txtDirection.val  =  'Z'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setUp
--
-- Description: Setup
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setUp(!elemToAppend is DBREF,!appendType is STRING)

   -- Update the form list based on the mode used by the user.
   if(!appendType eq 'ce')then
      if(!elemToAppend.type inset('SCTN', 'GENSEC', 'PANE')) then
         !this.elements.append(ce)
      endif

    elseif(!appendType.upcase() eq 'CEMEMBERS' ) then

      !collectionTypes[1] = 'SCTN'
      !collectionTypes[2] = 'GENSEC'
      !collectionTypes[3] = 'PANE'

      !collection = object COLLECTION()
      !collection.scope(!elemToAppend)
      !collection.types(!collectionTypes)

      !expression = object EXPRESSION('(type of own) eq |$!elemToAppend.type| ')
      !collection.filter(!expression)
      !result = !collection.results()

      !this.elements.appendArray(!result)

   elseif(!appendType eq 'pick')then
      !this.elements.append(!elemToAppend)

   elseif(!appendType eq 'window')then
      -- Get elements
      !selection        =   object SELECTION()
      !selection.getCurrent()
      !items            =   !selection.getSelection()

      -- If Selection is empty
      if(!items.empty()) then
        -- Change the phrase - TO DO
        !!alert.error('Pick/Window select in the graphical view and retry')
        return
      endif

      -- Collect relevant types
      !collection       =   object COLLECTION()
      !collection.scope(!items)
      !collection.type('GENSEC')
      !collection.addType('SCTN')
      !collection.addType('PANE')

      !this.elements.appendArray(!collection.results())

   elseif(!appendType eq 'list')then
      if(!!cdclist.list.val ne 0)then
         do !i indices !!cdclist.list.rtext
            !this.elements.append(!!cdclist.list.rtext[!i].dbref())
         enddo
      endif
   endif

   !this.elements.unique()

   !block           =  object BLOCK('!this.elements[!evalIndex].flnn')

   !disText[1]      =  ARRAY()
   !disText[2]      =  !this.elements.evaluate(!block)

   -- Enhance colour of the elements selected
   do !i indices !this.elements
      -- use default highlight colour (!!gphColOpt.highlight.code)
      enhance $!this.elements[$!i] colour $!!gphColOpt.highlight.code
      !disText[1].append(!this.elements[!i].type)
   enddo

   -- Make groups from the types selected
   !sort   =  !disText[2].sortedIndices()

   !disText[1].reIndex(!sort)
   !disText[2].reIndex(!sort)

   !this.elements.reIndex(!sort)
   !this.listMem      =  !disText

   -- Set columns of the list
   !this.list.setColumns(!disText)

   if(!this.listMem.set())then
      -- Set POPUP field properties
      !this.pop1.setFieldProperty('REMSEL','ACTIVE',true)
      !this.pop1.setFieldProperty('REMALL','ACTIVE',true)

      if(!this.graphLine.set() or !this.graphPlane.set())then
         !this.apply.active   =   true
      endif
   endif

   !findSection = !this.listMem[1].find('SCTN')
   if(!findSection.set())then
      !this.sctnPresent        =  true
   else
      !this.sctnPresent        =  false
   endif

   if(!this.sctnPresent AND !this.splitOn.val eq 1)then
      !this.connections.active =  true
   else
      !this.connections.active =  false
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:      appendList
--
-- Description: append the element list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .appendList()

   !!edgCntrl.remove('Standard Element Pick')
   if(!this.loadList.selection().eq('CE') )then
      !this.setUp(ce,|ce|)
   elseif(!this.loadList.selection().eq('CEMEM') )then
      !this.setUp(ce,|ceMembers|)
   elseif(!this.loadList.selection().eq('LIST') )then
      !this.setUp(ce,|list|)
   elseif(!this.loadList.selection().eq('GPHPICK') )then
      !this.pickElements()
   elseif(!this.loadList.selection().eq('GPHSEL') )then
      !this.setUp(ce,|window|)
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:      pickElements
--
-- Description: pick elements through graphical pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickElements()

   -- Remove EDGs , if still active
   !!edgCntrl.remove('Standard Element Pick')
   !!edgCntrl.remove('Line between two points')
   !!edgCntrl.remove('Basic Position')

   !pickElements  =  object EDGPACKET()

   !pickElements.elementPick('Pick Section/Panel/Gensec to split or <esc> to finish')
   !pickElements.action       =  '!!splitGenSectPane.setUp(!this.return[1].item,|pick|)'

   !pickElements.pickpacket.picks[1].pick.input[3]   = |match('GENSEC SCTN PANE',TYPE) ge 1|
   !pickElements.pickpacket.picks[1].pick.modifiable = FALSE

   !!edgCntrl.add(!pickElements)
endmethod

------------------------------------------------------------------------
--
-- Method:      pickLine
--
-- Description: pick line
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickLine()
  -- Remove EDGs , if still active
  !!edgCntrl.remove('Standard Element Pick')
  !!edgCntrl.remove('Line between two points')
  !!edgCntrl.remove('Basic Position')

  do !i indices !this.aidNumber
     !!aidNumbers.remove(!this.aidNumber[!i])
  enddo

  !this.aidNumber.clear()
  -- Sections picked before should be unenhanced
  if(!this.splitOnSctn.set())then
     do !i indices !this.splitOnSctn
        UNENHANCE $!this.splitOnSctn[$!i]
     enddo
     !this.splitOnSctn.clear()
  endif

  !this.graphLine.clear()
  !this.graphPlane.clear()
  !this.apply.active   =  FALSE

  if(!this.splitOn.val eq 3)then
     if(!this.togDirnLock.val)then
        !this.txtDirection.active   =  FALSE
     else
        !this.txtDirection.active   =  TRUE
     endif
     !this.txtPlaneSize.active   =  TRUE
     !this.togPlaneFill.active   =  TRUE
     !this.togDirnLock.active    =  TRUE
     if(!this.graphPlane.set())then
        !this.modifyGphAid.active    =  TRUE
        !this.deleteGphAid.active    =  TRUE
     else
        !this.modifyGphAid.active    =  FALSE
        !this.deleteGphAid.active    =  FALSE
     endif
  else
     !this.txtDirection.active   =  FALSE
     !this.txtPlaneSize.active   =  FALSE
     !this.togPlaneFill.active   =  FALSE
     !this.togDirnLock.active    =  FALSE
     if(!this.splitOn.val eq 2 and !this.graphLine.set())then
        !this.modifyGphAid.active    =  TRUE
        !this.deleteGphAid.active    =  TRUE
     else
        !this.modifyGphAid.active    =  FALSE
        !this.deleteGphAid.active    =  FALSE
     endif
  endif

  -- Define EDG pick for picking split-on section/graphical split line
  if(!this.splitOn.val eq 1)then
     if(!this.sctnPresent)then
        !this.connections.active   =  TRUE
     endif

     !this.check    =  FALSE

     !sctnPacket    =  object EDGPACKET()
     !sctnPacket.elementPick('Pick a section to split on')

     !sctnPacket.action  =  '!!splitGenSectPane.processSctnPick(!this.return[1].item)'
     !sctnPacket.pickpacket.picks[1].pick.input[3]  = |match('SCTN',TYPE) eq 1|
     !sctnPacket.pickpacket.picks[1].pick.modifiable = FALSE

     !!edgCntrl.add(!sctnPacket)
  elseif(!this.splitOn.val eq 2)then
     !this.connections.active   =  FALSE
     !linePacket         =  object EDGPACKET()
     !linePacket.defineLine('pntPnt')

     !linePacket.remove  =  FALSE

     !linePacket.action  =  '!!splitGenSectPane.processLinePick(!this.return[1])'
     !linePacket.close   =  '!!splitGenSectPane.check = FALSE'

     !!edgCntrl.add(!linePacket)
  elseif(!this.splitOn.val eq 3)then
     !this.connections.active   =  FALSE
     !planePacket         =  object EDGPACKET()
     !planePacket.definePosition('Pick to position plane')

     !planePacket.remove  =  FALSE

     !planePacket.action  =  '!!splitGenSectPane.processPlanePick(!this.return[1])'
     !planePacket.close   =  '!!splitGenSectPane.check = FALSE'

     !!edgCntrl.add(!planePacket)
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      pickAid
--
-- Description: pick Aid to modify
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickAid(!operation is STRING)
  -- Define Packet
  !packetAid                   = object EDGPACKET()

  if(!operation eq 'MODIFY')then
     !packetAid.aidPick('Pick aid to be modified')
     !packetAid.action         = '!!splitGenSectPane.modifyAid(!this.return,|MODIFY|)'
     !packetAid.priority       = 2
     !packetAid.remove         = TRUE
  elseif(!operation eq 'DELETE')then
     --!this.aidsToDelete.clear()
     !packetAid.aidPick('Pick aid(s) to be deleted.<esc to finish>')
     !packetAid.action         = '!!splitGenSectPane.modifyAid(!this.return,|DELETE|)'
     !packetAid.priority       = 2
     !packetAid.close          = '!!splitGenSectPane.deleteAid()'
     --!packetAid.remove         = FALSE
  endif

  -- Add the EDG packet to the system
  !!edgCntrl.add(!packetAid)
endmethod
------------------------------------------------------------------------
--
-- Method:      processLinePick
--
-- Description: process line pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processLinePick(!lineDef is LINE)

   -- Define a GPHLINE
   !grLine   =   object GPHLINE(!lineDef)
   !grLine.style  =  2
   !grLine.colour =  231

   -- Register for an aid number
   !this.aidNumber.append(!!aidNumbers.add(!grLine))
   !this.graphLine.append(!grLine)

   -- If the elements to split list is set, make the split button active
   if(!this.listMem.set())then
      !this.apply.active   =  TRUE
   endif

   -- Activate the modify and delete options only if the aid line is defined.
   if(!this.graphLine.set())then
      !this.modifyGphAid.active    =  TRUE
      !this.deleteGphAid.active    =  TRUE
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:      processPlanePick
--
-- Description: process plane pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processPlanePick(!toProcess is EDGPOSITIONDATA)
   !this.plane   =   !toProcess.getPlane()

   -- Handling cases which are not supported by the getPlane() method.
   if(!this.plane.set().not())then
      -- change this to get plane
      if(!toProcess.plane.set())then
         !!plane = !toProcess.plane
         !toProcess.plane.position   = !toProcess.position
         !this.plane                 = !toProcess.plane
      else
         if(!toProcess.originaltype.set().not() and !toProcess.position.set())then
            !this.plane.position     =  !toProcess.position.wrt(worl)
            !this.plane.orientation  =  z is $!this.txtDirection.val wrt /*
         elseif(!toProcess.originaltype eq 'PPOINT')then
            !this.plane.position     =  !toProcess.item.ppos[!toProcess.ppoint].wrt(WORL)
            !planeDir                =  !toProcess.item.pdir[!toProcess.ppoint].wrt(WORL)
            !this.plane.orientation  =  z is $!planeDir
         elseif(!toProcess.originaltype eq 'PLINE')then
            !this.plane.position     =  !toProcess.position.wrt(WORL)
            if(!toProcess.item.type eq 'GENSEC')then
               !this.plane.orientation  =  !toProcess.item.orientation.wrt(WORL)
            else
               !this.plane.orientation  =  !toProcess.item.plor.attribute(!toProcess.pline).wrt(WORL)
            endif
         elseif(!toProcess.originaltype eq '3D_LINE')then
            !this.plane.position     =  !toProcess.position.wrt(WORL)
            !planeDir                =  !toProcess.pointvector.direction.wrt(WORL)
            !this.plane.orientation  =  z is $!planeDir
         elseif(!toProcess.originaltype eq 'ELEMENT')then
            if(!toProcess.item.type eq 'SCTN')then
               if(match('XGRD YGRD ZGRD',!toProcess.item.gtype) gt 0)then
                  !this.plane.position     =  !toProcess.position.wrt(WORL)
                  !xDir  =  !toProcess.item.ori.xDir().wrt(WORL)
                  !zDir  =  !toProcess.item.ori.zDir().wrt(WORL)

                  !this.plane.orientation  =  z is $!xDir  and x is $!zDir
               else
                  !this.plane.position     =  !toProcess.position.wrt(WORL)
                  !this.plane.orientation  =  !toProcess.item.orientation.wrt(WORL)
               endif
            else
               !this.plane.position     =  !toProcess.position.wrt(WORL)
               !this.plane.orientation  =  !toProcess.item.orientation.wrt(WORL)
            endif
         elseif(!toProcess.originaltype eq 'DESIGNAID')then
            !this.plane.position     =  !toProcess.position.wrt(worl)
            !this.plane.orientation  =  z is $!this.txtDirection.val wrt /*
         elseif(!toProcess.originaltype eq 'TUBING')then
            if(!toProcess.tubing eq 'LEAVE')then
               !this.plane.position     =  !toProcess.item.lpos.wrt(WORL)
               !planeDir                =  !toProcess.item.ldir.wrt(WORL)
            elseif(!toProcess.tubing eq 'HEAD')then
               !this.plane.position     =  !toProcess.item.hpos.wrt(WORL)
               !planeDir                =  !toProcess.item.hdir.wrt(WORL)
            endif
            !this.plane.orientation     =  z is $!planeDir
         else
            !!alert.error('This type is not taken care')
            return
         endif
      endif
   endif

   -- If the plane is still unset, come out.
   if(!this.plane.set().not())then
      return
   endif

   if(!this.togDirnLock.val)then
      !this.plane.orientation  =  z is $!this.txtDirection.val wrt /*
   else
      !this.txtDirection.val   =  !this.plane.orientation.zDir().string().before('WRT')
   endif

   !grPlane    =    object GPHPLANE(!this.plane)
   !this.graphPlane.append(!grPlane)
   !this.aidNumber.append(!!aidNumbers.add(!grPlane))

   -- Empty the aid to be modified/deleted data
   !this.pickedAid  =  REAL()

   !this.drawPlane()

   -- If the elements to split list is set, make the split button active
   if(!this.listMem.set())then
      !this.apply.active   =  TRUE
   endif

   -- Activate the modify and delete options only if the aid plane is defined.
   if(!this.graphPlane.set())then
      !this.modifyGphAid.active    =  TRUE
      !this.deleteGphAid.active    =  TRUE
   endif
endmethod
------------------------------------------------------------------------
--
-- Method:      drawPlane
--
-- Description: draw plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPlane()
   if(!this.graphPlane.set())then
      if(!this.pickedAid.set())then
         !toModify    =   !this.pickedAid
      else
         !toModify    =   !this.aidNumber.last()
      endif

      !!aidNumbers.numbers[!toModify].x  =  !this.txtPlaneSize.val.real()
      !!aidNumbers.numbers[!toModify].y  =  !this.txtPlaneSize.val.real()
      !!aidNumbers.numbers[!toModify].description = !this.txtDirection.val
      !!aidNumbers.numbers[!toModify].tag         = TRUE

      !!aidNumbers.numbers[!toModify].filled(!this.togPlaneFill.val)
      !!aidNumbers.numbers[!toModify].plane.orientation = z is $!this.txtDirection.val wrt /*

      !!aidNumbers.draw(!toModify)
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:      processSctnPick
--
-- Description: process the data from sctn pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processSctnPick(!sctnDef is DBREF)
   -- Hide existing AID line(s).
   do !i indices !this.aidNumber
      !!aidNumbers.hide(!this.aidNumber[!i])
   enddo

   ENHANCE $!sctnDef COLOUR CYAN
   !this.splitOnSctn.append(!sctnDef)
   !lineDef   =   object LINE(!sctnDef.poss,!sctnDef.pose)

   -- Define a gphline
   !grLine    =   object GPHLINE(!lineDef)

   !this.graphLine.append(!grLine)

   if(!this.listMem.set())then
      !this.apply.active   =  TRUE
   endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modifyAid
--
-- Description: modify the graphical aid picked
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyAid(!results is ARRAY,!operation is STRING)

  -- storing the aid number
  !aidNumber = !results[1].point
  -- Check we have picked a registered design aid
  !findFirst = !this.aidNumber.findFirst(!aidNumber)
  if(!findFirst.unset())then
     !!alert.error('The aid picked is not pertaining to the current functionality.')
     return
  endif

  -- Determine the type of edit
  !aidItem   = !!aidNumbers.get(!aidNumber)
  if(!operation eq 'MODIFY')then
     !this.pickedAid  =  !aidNumber
     -- Edit aid element
     !aidItem.edit(!aidNumber)
     handle any
       !!alert.error('Unable to find edit method for "' & !!aidNumbers.numbers[!aidNumber].objectType() & '"')
       return
     endhandle
     if(!aidItem.objectType() eq 'GPHPLANE')then
        if(!this.togDirnLock.val)then
           !!gphPlaneEdit.orientationFrame.active   =  FALSE
        endif
        !!gphPlaneEdit.ySize.active         =  FALSE
        !!gphPlaneEdit.cancelCall           =  '!!splitGenSectPane.updateModifyDtls(|CANCEL|)'
        !!gphPlaneEdit.okCall               =  '!!splitGenSectPane.updateModifyDtls(|OK|)'
     elseif(!aidItem.objectType() eq 'GPHLINE')then
        !!gphLineEdit.cancelCall            =  '!!splitGenSectPane.updateModifyDtls(|CANCEL|)'
        !!gphLineEdit.okCall                =  '!!splitGenSectPane.updateModifyDtls(|OK|)'
     endif
  elseif(!operation eq 'DELETE')then
     !existingPos  =  !this.aidsToDelete.findFirst(!aidNumber)
     if(!existingPos.unset())then
        !this.aidsToDelete.append(!aidNumber)
        if(!this.graphPlane.set())then
           !this.graphPlane[!this.aidNumber.findFirst(!aidNumber)].fill   = !!aidNumbers.numbers[!aidNumber].fill
           !this.graphPlane[!this.aidNumber.findFirst(!aidNumber)].colour = !!aidNumbers.numbers[!aidNumber].colour
           !!aidNumbers.numbers[!aidNumber].filled(FALSE)
        elseif(!this.graphLine.set())then
           !this.graphLine[!this.aidNumber.findFirst(!aidNumber)].colour = !!aidNumbers.numbers[!aidNumber].colour
        endif
        !!aidNumbers.numbers[!aidNumber].colour = 2
        !!aidNumbers.draw(!aidNumber)
     else
        if(!this.graphPlane.set())then
           !!aidNumbers.numbers[!aidNumber].fill   = !this.graphPlane[!this.aidNumber.findFirst(!aidNumber)].fill
           !!aidNumbers.numbers[!aidNumber].colour = !this.graphPlane[!this.aidNumber.findFirst(!aidNumber)].colour
        elseif(!this.graphLine.set())then
           !!aidNumbers.numbers[!aidNumber].colour = !this.graphLine[!this.aidNumber.findFirst(!aidNumber)].colour
        endif
        !!aidNumbers.draw(!this.aidsToDelete[!existingPos])
        !this.aidsToDelete[!existingPos].delete()
        !this.aidsToDelete.compress()
     endif
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      deleteAid
--
-- Description: delete the graphical aid picked
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteAid()

   if(!this.aidsToDelete.unset())then
      return
   endif

   !confirm  = !!alert.confirm('Delete the aid(s) highlighted in red?')
   if(!confirm eq 'NO')then
      do !i indices !this.aidsToDelete
         if(!this.graphPlane.set())then
            !!aidNumbers.numbers[!this.aidsToDelete[!i]].fill   = !this.graphPlane[!this.aidNumber.findFirst(!this.aidsToDelete[!i])].fill
            !!aidNumbers.numbers[!this.aidsToDelete[!i]].colour = !this.graphPlane[!this.aidNumber.findFirst(!this.aidsToDelete[!i])].colour
         elseif(!this.graphLine.set())then
            !!aidNumbers.numbers[!this.aidsToDelete[!i]].colour = !this.graphLine[!this.aidNumber.findFirst(!this.aidsToDelete[!i])].colour
         endif
         !!aidNumbers.draw(!this.aidsToDelete[!i])
      enddo
      !this.aidsToDelete.clear()
      return
   endif

   do !i indices !this.aidsToDelete
      !findFirst = !this.aidNumber.findFirst(!this.aidsToDelete[!i])
      !this.aidNumber[!findFirst].delete()
      !this.aidNumber.compress()

      if(!!aidNumbers.numbers[!this.aidsToDelete[!i]].objectType() eq 'GPHPLANE')then
         !this.graphPlane[!findFirst].delete()
         !this.graphPlane.compress()
      elseif(!!aidNumbers.numbers[!this.aidsToDelete[!i]].objectType() eq 'GPHLINE')then
         !this.graphLine[!findFirst].delete()
         !this.graphLine.compress()
      endif
      !!aidNumbers.remove(!this.aidsToDelete[!i])
   enddo
   !this.aidsToDelete.clear()

   if(!this.graphPlane.unset() AND !this.graphLine.unset())then
      !this.modifyGphAid.active    =  FALSE
      !this.deleteGphAid.active    =  FALSE
      !this.apply.active           =  FALSE
   endif
endmethod
------------------------------------------------------------------------
--
-- Method:      splitOnLine
--
-- Description: split on a defined line
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitOnLine()

  -- Store current element
  !refElem  =  !!ce

  -- Remove edg packets if not done so by the user
  !!edgCntrl.remove('Line between two points')
  !!edgCntrl.remove('Standard Element Pick')
  !!edgCntrl.remove('Basic Position')

  -- Update the GPHPLANE using the planes in !!aidNumbers to reflect any modifications done graphically
  if(!this.splitOnSctn.set().not())then
     do !i indices !this.aidNumber
        if(!this.graphLine.set())then
           !this.graphLine[!i]  = !!aidNumbers.numbers[!this.aidNumber[!i]]
        elseif(!this.graphPlane.set())then
           !this.graphPlane[!i] = !!aidNumbers.numbers[!this.aidNumber[!i]]
        endif
     enddo
  endif

  -- Going to verify whether the user is willing to define a new aid or use the previously defined one.
  -- If graphical aid line is already set
  if(!this.graphLine.set() AND !this.check) then
     do !i indices !this.graphLine
        !!aidNumbers.hide(!this.aidNumber[!i])
        !this.graphLine[!i].draw(!this.aidNumber[!i])
     enddo

     !confirm = !!alert.confirm('Continue splitting on the existing aid line(s)? Click NO to define new aid line(s).')

     if(!confirm eq 'NO')then
        !this.pickLine()
        return
     endif
  elseif(!this.graphPlane.set() AND !this.check) then
     do !i indices !this.graphPlane
        !!aidNumbers.hide(!this.aidNumber[!i])
        !this.graphPlane[!i].draw(!this.aidNumber[!i])
     enddo

     !confirm = !!alert.confirm('Continue splitting on the existing aid plane(s)? Click NO to define new aid plane(s).')

     if(!confirm eq 'NO')then
        !this.pickLine()
        return
     endif
  endif

  -- Start marking for UNDO operation
  !this.markForUndo.add()

  -- Flag to identify if any item has been split (Will be used in the end of the code)
  !splitAny   = FALSE

  -- Stores distances of intersection points from POINSP1 of the GENSEC
  !disPtIntr  = ARRAY()
  !errorText  = object ARRAY()
  do !i indices !this.elements

     if(!!dbrefupdate(!this.elements[!i]).not())then
       !errorText.append(!!error.text)
       skip
     endif

     -- Split gensecs
     if(!this.elements[!i].type eq 'GENSEC')then

        -- Clear to append with fresh values
        !this.ptIntrsctn.clear()

        !!ce     = !this.elements[!i]

        -- Gensec-spine converted to a profile object - DDC

        !spine   = !!dtbMemberOfType(!!ce,'SPINE',1)
        !profile = object PROFILE(!spine)

        --Deciding on which the split is going to happen
        if(!this.graphLine.set())then
           do !j indices !this.graphLine
              !intrsctn   =  !profile.intersections(!this.graphLine[!j].line)
              !this.ptIntrsctn.appendArray(!intrsctn)
           enddo
        elseif(!this.graphPlane.set())then
           do !j indices !this.graphPlane
              !intersctnLine =  !profile.plane().intersection(!this.graphPlane[!j].plane)
              !intrsctn      =  !profile.intersections(!intersctnLine)
              !this.ptIntrsctn.appendArray(!intrsctn)
           enddo
        endif

        !intrsctn.delete()

        -- If no intersections
        if(!this.ptIntrsctn.unset()) then
           skip
        endif

        -- Make intersection points collected unique
        !this.ptIntrsctn.unique()

        -- Remove duplicated intersection position values
        !frmt = object FORMAT()
        -- Check for how it works in imperial units
        !frmt.dp = 2
        !sPtIntrsctn = ARRAY()

        -- Format object cannot be used on position objects directly. So its converted to a string first
        do !j indices !this.ptIntrsctn
           !sPtIntrsctn.append(string(!this.ptIntrsctn[!j],!frmt))
        enddo

        !this.ptIntrsctn.clear()
        !sPtIntrsctn.unique()

        do !j indices !sPtIntrsctn
           !this.ptIntrsctn.append(!sPtIntrsctn[!j].position())
        enddo
        !sPtIntrsctn.delete()

        -- Get distances of the intersection points from start of the profile
        do !k indices !this.ptIntrsctn
           !disPtIntr[!k]= !!spineDisPos(!!ce,!this.ptIntrsctn[!k])
        enddo

        -- Sort based on distance from the start of the gensec
        !sort = !disPtIntr.sortedIndices()
        !disPtIntr.reIndex(!sort)
        !this.ptIntrsctn.reIndex(!sort)

        -- To find out the end directions (commented out due to bug in setting end direction in 12.0) Soma to study
        --!projLine = !this.graphLine.line.projected(!profile.plane())
        --!endDir   = !projLine.direction().orthogonal(!profile.plane().orientation.zDir())
        !endDir     =  object DIRECTION()
        -- Function to split gensec
        !!splitGensec(!!ce,!this.ptIntrsctn,!disPtIntr,!this.gap.val,!endDir)

        !disPtIntr.clear()
        !splitAny   =  TRUE
     endif
  enddo

  !newSctns      =  ARRAY()
  !newPanels     =  ARRAY()

  if(!this.graphLine.set())then
     !splitOnAid   =   !this.graphLine.size()
  elseif(!this.graphPlane.set())then
     !splitOnAid   =   !this.graphPlane.size()
  endif

  do !k from 1 to !splitOnAid
     do !i indices !this.elements
        -- Split sections
        if(!this.elements[!i].type eq 'SCTN')then

           !fitt      = !this.elements[!i].members
           !!ce       = !this.elements[!i]

           -- Create geometry to find out intersection
           !line      = object LINE(!!ce.poss,!!ce.pose)
           !lineDrn   = !line.direction()

           if(!this.graphLine.set())then
              !intrsctn  = !line.intersection(!this.graphLine[!k].line)
              handle ANY
                 !intrsctn = object POSITION()
              endhandle
           elseif(!this.graphPlane.set())then
              !intrsctn  = !line.intersection(!this.graphPlane[!k].plane)
              handle ANY
                 !intrsctn = object POSITION()
              endhandle
           endif

           -- If intersection does not lie on the section
           if(!intrsctn.unset() OR !line.onProjected(!intrsctn).not())then
              skip
           endif

           if(!this.splitOnSctn.set() AND !this.connections.active AND !this.connections.val ne 1)then
              -- Clash check to determine if node creation/trimming is possible
              DESCLASH
                 OVERRIDE ON
                 REMOVE OBST ALL
                 LIMITS NONE
                 IGNORE CONNECTION
                 REPORT SUMMARY OFF
                 REPORT HEADER OFF
                 REPORT MAIN OFF
                 REPORT GRAPHICS OFF
                 OBST $!this.splitOnSctn[$!k]
                 CHECK CE
              EXIT

              -- This is PML1 coding. Should be replaced later.
              var !count clash count all
              if(!count.split()[1].real() gt 0)then
                 !isClashing   =  TRUE
              else
                 !isClashing   =  FALSE
              endif
           else
              !isClashing = FALSE
           endif

           -- For future use
           !intrsctn1   =   !intrsctn.offset(!lineDrn.opposite(),(!this.gap.val / 2))
           !intrsctn2   =   !intrsctn.offset(!lineDrn,(!this.gap.val / 2))

           -- Check for minimum allowable length
           if(defined(!!stlTolEdit))then
              if(!!stlTolEdit.minimumlock.val)then
                 !minLenOfSctn   =  !!stlTolEdit.minimum.val
              else
                 !minLenOfSctn   =  200mm
              endif
           else
              !minLenOfSctn  =  200mm
           endif

           if((!intrsctn1.distance(!!ce.poss) lt !minLenOfSctn) OR (!intrsctn2.distance(!!ce.pose) lt !minLenOfSctn))then
              skip
           endif

           !modLength   =   !!ce.poss.distance(!intrsctn)

           -- Create a copy of the current section
           NEW SCTN COPY ATTR OF PRE
           !newSctn     =   !!ce

           if(!this.elements[!i].joie.unset().not())then
              !!ce.joie    =   !this.elements[!i].joie
           endif
           JOIS nulref

           $!this.elements[$!i]
           JOIE nulref

           -- Distribute fittings based on location
           do !j indices !fitt

              skip if(!fitt[!j].zdist le (!modLength - (!this.gap.val / 2)))
              if(!fitt[!j].zdist ge (!modLength + (!this.gap.val / 2)))then
                 !fitt[!j].zdist =   !fitt[!j].zdist - (!modLength + (!this.gap.val / 2))
                 !!ce            =   !newSctn
                 INCLUDE $!fitt[$!j]
              else
                 !!ce      =  !fitt[!j]
                 !deleteFitt = !!alert.confirm('Fitting $!fitt[$!j].flnn will be deleted. Do you want to delete?')
                 if(!deleteFitt eq 'YES')then
                    DELETE $!fitt[$!j].type
                 endif
              endif
           enddo

           -- To find out direction for endcut at intersection --FOR LATER USE
           if(!this.angle.val eq 0)then
              if(!this.graphLine.set())then
                 !orthDir         =   !line.direction().orthogonal(!this.graphLine[!k].line.direction())
                 !proPlaneOri     =   Z is $!orthDir
                 !proPlane        =   object PLANE(!newSctn.pose,!proPlaneOri)
                 !proLine         =   !this.graphLine[!k].line.projected(!proPlane)

                 !endDir          =   !orthDir.orthogonal(!proLine.direction())
              elseif(!this.graphPlane.set())then
                 !endDir          =   !this.graphPlane[!k].plane.orientation.zDir()
              endif
           else

              -- To find out directions based on the passed edge preparation angle
              !arc    =  object ARC()
              !arc.position =   !intrsctn
              if(!this.about.val lt 3) then

                 !angleDrn        = !this.elements[!i].orientation.xDir()
                 if(!this.about.val eq 2) then
                    !angleDrn     = !angleDrn.opposite()
                 endif

              else
                 !angleDrn        = !this.elements[!i].orientation.yDir()
                 if(!this.about.val eq 4) then
                    !angleDrn     = !angleDrn.opposite()
                 endif

              endif

              !arc.orientation    = Z is $!angleDrn
              !arc.radius     =   100 mm
              !arc.sense      =   TRUE


              !arc.startangle =   - (!this.angle.val / 2 )
              !arc.endangle   =     (!this.angle.val / 2 )


              !endDir1        =   !arc.startTangent()
              if((!lineDrn.angle(!endDir1) neq (!this.angle.val / 2 )) AND (!lineDrn.angle(!endDir1) neq (180 - !this.angle.val / 2 )))then
                 !endDir1     =   !endDir1.orthogonal(!angleDrn)
              endif

              !endDir2        =   !arc.endTangent()
              if((!lineDrn.angle(!endDir2) neq (!this.angle.val / 2 )) AND (!lineDrn.angle(!endDir2) neq (180 - !this.angle.val / 2 )))then
                 !endDir2     =   !endDir2.orthogonal(!angleDrn)
              endif

           endif

           -- Set end directions
           !newSctn.poss    =   !intrsctn2
           !!ce             =   !newSctn
           if(!this.angle.val eq 0)then
              !!ce.drns = !endDir.opposite()
           else
              !!ce.drns =!endDir1.opposite()
           endif

           !!ce         =   !this.elements[!i]
           !!ce.pose    =   !intrsctn1
           if(!this.angle.val eq 0)then
              !!ce.drne = !endDir
           else
              !!ce.drne = !endDir2
           endif

           UNENHANCE CE
           !newSctns.append(!newSctn)
           !splitAny   =  TRUE

           if(!isClashing)then
              !!ce      =  !this.splitOnSctn[!k]
              --!nodeDis  =  !!ce.poss.distance(!this.graphLine[!k].line.near(!intrsctn))
              !nodeDis  =  !!ce.poss.distance(!intrsctn)

              NEW SNODE ZDIST $!nodeDis
              NEW SJOI JLIN NA CREF $!this.elements[$!i] END
              if(defined(!!cdsreftol))then
                 JFREE $!!cdsreftol.jfree
              endif

              NEW SJOI JLIN NA CREF $!newSctn START
              !newSctn.jois   =   !!ce
              if(defined(!!cdsreftol))then
                 JFREE $!!cdsreftol.jfree
              endif
              if(!this.connections.active AND !this.connections.val eq 3)then
                 !trimData1 = !!trimToPline(!this.elements[!i],!this.splitOnSctn[!k],'END')
                 !trimData2 = !!trimToPline(!newSctn,!this.splitOnSctn[!k],'START')
                 -- Set position line and cutplane for the new sjoi
                 !!ce  =  !this.elements[!i].joie
                 POSL $!trimData1[1]
                 CUTPL $!trimData1[2]
                 -- Set position line and cutplane for the new sjoi
                 !!ce  =  !newSctn.jois
                 POSL $!trimData2[1]
                 CUTPL $!trimData2[2]
                 -- Reconnect and recalculate the split sections
                 !!ce  =  !this.elements[!i]
                 RECONNECT END RECALC
                 !!ce  =  !newSctn
                 RECONNECT START RECALC
              endif
           elseif(!isClashing.not() AND !this.connections.active AND !this.connections.val ne 1)then
              !noTrim          =  TRUE
              !noTrimElem[!i]  =  !this.elements[!i]
           endif
        -- Split panels
        elseif(!this.elements[!i].type eq 'PANE')then
           !ploo        =  !!dtbMemberOfType(!this.elements[!i],'PLOO',1)

           -- Take out profile for post-split enhancements
           !profile     =  object PROFILE(!ploo)
           -- Split profile based on the line passed
           if(!this.graphLine.set())then
              !newProfiles    =  !profile.split(!this.graphLine[!k].line)
              handle (2,785)
                 skip
              elsehandle(2,837)
                 skip
              endhandle
           elseif(!this.graphPlane.set())then
              !intersctnLine  =  !profile.plane().intersection(!this.graphPlane[!k].plane)
              handle (2,874)
                 skip
              endhandle
              !newProfiles    =  !profile.split(!intersctnLine)
              handle (2,785)
                 skip
              elsehandle(2,837)
                 skip
              endhandle
           endif

           -- Check if actually splits into two
           if(!newProfiles.size() eq 1)then
              skip
           endif

           !!ce  = !ploo

           -- To ensure that circular panels also can be split
           !writeProfile     =  FALSE
           do !j indices !!ce.members
              if(!!ce.members[!j].frad ne 0) then
                 !writeProfile          =  TRUE
                 !!ce.members[!j].frad  =  0
              endif
           enddo

           !panePlane   =  object PLANE(!this.elements[!i].pos,!this.elements[!i].ori)

           if(!this.graphLine.set())then
              !proLine     =  !this.graphLine[!k].line.projected(!panePlane)
           elseif(!this.graphPlane.set())then
              !proLine     =  !this.graphPlane[!k].plane.intersection(!panePlane)
           endif

           !startPos    =  !proLine.startposition

           !dirOrtho    =  !proLine.direction().orthogonal(!panePlane.direction())

           !!ce         =  !this.elements[!i]

           SPLIT PLANE $!dirOrtho THRO $!startPos
           handle ANY
              -- Delete duplicate vertices if any
              do !j from !ploo.members.size() to 2 by -1
                 !!ce   =  !ploo.members[!j]
                 if(!!ce eq !ploo.members.last() AND !!ce.pos.eq(!ploo.members.first().pos)) then
                    DELETE PAVE
                    skip
                 endif

                 if(!!ce.pos.eq(!ploo.members[!j - 1].pos))then
                    DELETE PAVE
                 endif
              enddo

              -- Try to split again
              !!ce      =  !this.elements[!i]

              SPLIT PLANE $!dirOrtho THRO $!startPos

              handle ANY
                 skip
              endhandle
           endhandle

           -- If FRAD gt 0 , DBWRITE using split profile
           if(!writeProfile)then

              NEX

              !!ce         =   !!dtbMemberOfType(!!ce,'PLOO',1)

              !newProfiles[2].dbWrite(!!ce)
              !!ce         =   !!ce.members.last()
              DELETE PAVE

              !!ce         =   !this.elements[!i]
              !!ce         =   !!dtbMemberOfType(!!ce,'PLOO',1)

              !newProfiles[1].dbWrite(!!ce)
              !!ce         =   !!ce.members.last()
              DELETE PAVE

           endif

           !!ce         =   !this.elements[!i]
           UNENHANCE CE

           do !j from 2 to !newProfiles.size()
              NEX
              handle (2,113)
                 !!alert.error('Could not split panel $!!ce')
                 break
              endhandle
              !newPanels.append(!!ce)
           enddo

           !splitAny   =  TRUE
        endif
     enddo

     !this.elements.appendArray(!newSctns)
     !this.elements.appendArray(!newPanels)
     !this.elements.unique()
  enddo

  !error  = ''
  do !err values !errorText
    !error = !error +  '' +  !err
    handle ANY
      skip
    endhandle
  enddo
  -- If no element has been split.
  if(!splitAny.not())then
     if(!error.trim().neq(''))then
       !!alert.warning(!error)
      else
        !!alert.warning('Could not split based on the split-on aid(s) passed.')
      endif
  endif

  -- If could not trim/create snode.
  if(defined(!noTrim))then
     !noTrimElem.compress()
     !noTrimText  =  ''
     do !i indices !noTrimElem
        if(!i ne !noTrimElem.size() OR (!i eq 1))then
           !noTrimText = !noTrimText + '$!noTrimElem[$!i].ref'
        else
           !noTrimText = !noTrimText + ' and $!noTrimElem[$!i].ref'
        endif
     enddo
     -- Soma to improve the phrase.
     if(!this.connections.val eq 2)then
        !!alert.warning('Could not create snode for $!noTrimText . If you want to retain the original SCTN, UNDO.')
     else
        !!alert.warning('Could not trim $!noTrimText .If you want to retain the original SCTN, UNDO.')
     endif
  endif

  -- Graphical line exists
  if(!this.splitOnSctn.set().not())then
     !this.check    = TRUE
  endif

  -- Make form tidy
  !this.tidy(FALSE)

  -- Reset current element
  !!ce  =  !refElem
  handle (2,822)
  endhandle

  !this.markForUndo.endundoable()

endmethod


------------------------------------------------------------------------
--
-- Method:      removeFromList
--
-- Description:
--   Remove selected fields from the list for Z-distances
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeFromList()

  if(!this.elements.set())then
     -- Collect the indices of picked fields
     !listVal             = !this.list.val

     -- Remove picked from the list
     do !i indices !listVal
        !this.listMem[1][!listVal[!i]].delete()
        !this.listMem[2][!listVal[!i]].delete()

        unenhance $!this.elements[$!listVal[$!i]]
        !this.elements[!listVal[!i]].delete()
     enddo

     !this.elements.compress()

     !this.listMem[1].compress()
     !this.listMem[2].compress()


     !this.list.setColumns(!this.listMem)

     !this.sctnPresent        = FALSE
     !this.connections.active = FALSE

     if(!this.listMem.set())then
        !findSection = !this.listMem[1].find('SCTN')
        if(!findSection.set() AND !this.splitOn.val eq 1)then
           !this.sctnPresent        =  TRUE
           !this.connections.active =  TRUE
        endif
     else
        -- Set POPUP field properties
        !this.pop1.setFieldProperty('REMSEL','ACTIVE',FALSE)
        !this.pop1.setFieldProperty('REMALL','ACTIVE',FALSE)

        if(!this.graphLine.set())then
           !this.apply.active = FALSE
        endif
     endif
  endif
endmethod


------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:
--   Remove all enhancements and aids if any
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy(!graphClear is BOOLEAN)

  -- Unenhance elements
  do !i indices !this.elements
     unenhance $!this.elements[$!i]
  enddo

  !this.elements.clear()
  !this.listMem.clear()

  !this.list.clear()
  !this.apply.active = FALSE

  -- Clear graphical AID
  if(!graphClear)then
     !this.graphLine.clear()
     !this.graphPlane.clear()

     -- Remove the aid number used from the registry
     do !i indices !this.aidNumber
        !!aidNumbers.remove(!this.aidNumber[!i])
     enddo

     -- Remove EDG packet if still active.
     !!edgCntrl.remove('Line between two points')
     !!edgCntrl.remove('Standard Element Pick')
     !!edgCntrl.remove('Basic Position')
  endif

  if(!this.splitOnSctn.set())then
     do !i indices !this.splitOnSctn
        UNENHANCE $!this.splitOnSctn[$!i]
     enddo

     !this.splitOnSctn.clear()
     !this.graphLine.clear()
     !this.graphPlane.clear()
  endif

  -- Put the 'section is in list' flag off
  !this.sctnPresent        =  FALSE
  !this.connections.active =  FALSE

  -- Set POPUP field properties
  !this.pop1.setFieldProperty('REMSEL','ACTIVE',FALSE)
  !this.pop1.setFieldProperty('REMALL','ACTIVE',FALSE)
endmethod

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description:
--   Enhancement colour of picked field in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhance()

  -- Collect the indices of picked fields
  !listVal             = !this.list.val

  -- Maintain uniqueness in enhancement colour
  do !i indices !this.elements

     enhance $!this.elements[$!i]  colour tan

  enddo

  -- Enhance picked with a different colour for ease of identification
  do !i indices !listVal

     enhance $!this.elements[$!listVal[$!i]] colour deeppink

  enddo

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      validateDirTxt
--
-- Description:
--   validate the text gadget for setting plane direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDirTxt(!gadget is STRING) is BOOLEAN

   if(!gadget eq 'DRN')then
      !planeOriTxt     =    'z is '+ !this.txtDirection.val.trim() + ' wrt /*'
      !unusedPlaneOri        =    !planeOriTxt.orientation()
      handle (2,813)
         !!alert.error('Only a valid direction should be passed.')
         !this.txtDirection.val  =  !this.dirLatest
         return FALSE
      elsehandle NONE
         --!this.txtDirection.val  = !this.txtDirection.val.trim()
         !this.txtDirection.val  = !this.txtDirection.val.direction().string().before('WRT').trim()
         !this.dirLatest         = !this.txtDirection.val
      endhandle
   elseif(!gadget eq 'SIZE')then
      if(!this.txtPlaneSize.val lt 0)then
         !!alert.warning('Plane size cannot be a negative value.')
         !this.txtPlaneSize.val   = !this.planeSizLatest
         return FALSE
      else
         !this.planeSizLatest    = !this.txtPlaneSize.val
      endif
   endif

   if(!this.graphPlane.set())then
      !this.drawPlane()
   endif

   return TRUE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateModifyDtls
--
-- Description: update the form with details entered in the GPHPLANEEDIT form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateModifyDtls(!type is STRING)
   if(!this.graphPlane.set())then
      if(!type eq 'OK')then
         !!gphPlaneEdit.close()
         if ( !!gphPlaneEdit.xSize.val.gt(0) ) then
         !this.txtPlaneSize.val  =  !!gphPlaneEdit.xSize.val
         else
            !!alert.warning('Plane size cannot be a negative value.')
            !this.txtPlaneSize.val   = !this.planeSizLatest
             !aidItem   = !!aidNumbers.get(!this.pickedAid)
             !aidItem.edit(!this.pickedAid)
            return
        endif
         !this.togPlaneFill.val  =  !!gphPlaneEdit.plane.fill.boolean()
         !!gphPlaneEdit.plane.description  =  before(!!gphPlaneEdit.orientation.orientation.zDir().wrt(WORL).string(),'WRT')
         !!gphPlaneEdit.plane.position(!!gphPlaneEdit.position.get())
         !!gphPlaneEdit.plane.orientation(!!gphPlaneEdit.orientation.get())
         !!gphPlaneEdit.plane.y  =  !!gphPlaneEdit.plane.x
         !!aidNumbers.replace(!!gphPlaneEdit.aidplane,!!gphPlaneEdit.plane)
         !!gphPlaneEdit.close()
      elseif(!type eq 'CANCEL')then
         !!gphPlaneEdit.close()
      endif
      !!aidNumbers.remove(!!gphPlaneEdit.aidNumber)
      kill !!gphPlaneEdit
    elseif(!this.graphLine.set())then
       if(!type eq 'OK')then
          !!gphLineEdit.apply()
       elseif(!type eq 'CANCEL')then
          !!gphLineEdit.close()
       endif
       !!aidNumbers.remove(!!gphLineEdit.aidNumber)
       kill !!gphLineEdit
    endif
endmethod
-- End of method definition
-- End of object definition
