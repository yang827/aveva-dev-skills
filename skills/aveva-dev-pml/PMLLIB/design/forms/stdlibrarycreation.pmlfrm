--
--  Description:     Standard Model Library Item Creation--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToDisplay()                   -                   Method to auto the current Design and add it to the view
--  create()                         -                   The creation call
--  create(POSITION)                 -                   Create the actual instance at the passed position
--  displayPosition(POSITION)        -                   Display and return the passed position.
--  firstShown()                     -                   Form first shown callback
--  getArea(GADGET,STRING,STRING)    -                   Gets all the data for the appWorld appArea an appData option gadgets
--  getMoveByResult(POSITION)        STRING              If we have an element being created as a zone member
--  getWorld(REAL)                   -                   Initialisation method run every time form is shown
--  init()                           -                   Initialisation method run every time form is shown
--  killCall()                       -                   When to form is closed
--  limits(DBREF)                    -                   Method to set the limits of the local view
--  pickPositionMethod()             -                   EDG pick position.
--  selectAssembly()                 -                   Called when you select an assembly element
--  selectCE()                       -                   Callback when CE is selected
--  tag(POSITION)                    -                   Tag position
--
------------------------------------------------------------------------
--
layout form !!stdLibraryCreation dialog dock R AutoAlign
--setup form !!stdLibraryCreation dialog dock R

  !this.formTitle     = 'Create Standard Model Library Item'
  !this.initcall      = '!this.init()'
  !this.quitcall      = |!this.killCall()|
  !this.killingcall   = |!this.killCall()|

  path down
  vdist 0
  hdist 0
  frame .createHere 'Storage Zone' anchor t+l+r width 33
    button .ce 'Zone' anchor l+t  callback |!this.selectCE()|
    para .hereName at xmax ymin anchor l+t+r width to max.createHere lines 2
  exit

  frame .selectHere 'Selection' anchor t+l+r width.createHere
    toggle .name 'Toggle Name/Description' call '!this.getWorld(1)'
    !tagw = 9
    option .world tagwid $!tagw 'Library:' at xmin anchor t+l+r call '!this.getWorld(2)' width to max.selectHere

    option .area tagwid $!tagw 'Library Area:' anchor t+l+r call '!this.getWorld(3)' width.world

    list .assemblyOpt 'Standard Model Library Items:' anchor t+l+r call '!this.selectAssembly()' single width to max.world height 10
  exit

  -- Component Creation
  frame .nameFrame 'New Instance' anchor t+l+r width.createHere
    !tagw = 5
    text .newName tagwidth $!tagw |Name| anchor l+r callback |!this.newName.val = !!checkName(!this.newName.val, 'NEW')| width to max.nameFrame  name
    toggle .autoName 'Use Autoname (if rules exist)' at x $!tagw call '!this.newName.active = !this.autoName.val.not()'

    !tagw = 10
    --para .yIsPara   at x0.5 ymax TEXT |Orientate Y is|
    text .yIsText tagwid $!tagw |Orientate Y is| at xmin.newName anchor l+r width to max.newName is DIRECTION
    --para .zIsPara   at x0.5 ymax TEXT |      and Z is|
    text .zIsText tagwid $!tagw |Orientate Z is| anchor l+r width.yIsText is DIRECTION

    button .create     linklabel 'Create and Position' anchor l+t  callback |!this.create()|
  exit

  frame  .localViewFrame PANEL anchor all width.createHere
    para .prompt at xmin.nameFrame ymax.nameFrame anchor t+l+r width to max.localViewFrame lines 1

    view .localview prompt .prompt givolume

      -- Input Modes
      -- Navigate
      inmode create _navi       type |DES_NAVIGATE|
      -- Standard Element Pick
      inmode create _pick       type |DES_PICK|
      -- Pick Any (Element, Ppoint, Pline)
      inmode create _pAny       type |DES_PICK_ANY|
      -- Plines
      inmode create _pLine      type |DES_PICK_PLINE|
      -- Ppoints
      inmode create _point      type |DES_PICK_POINT|
      -- Screen Position
      inmode create _screen     type |DES_3D_LINE|
      -- Laser Model rays
      inmode create _pickxgeom  type |DES_PICK_XGEOM|
      -- Default (Navigation)
      inmode create _pickDetail type |DES_PICK_DETAIL|
      -- Default (Navigation)
      inmode create _default    type |DES_NAVIGATE|

    exit
  exit

  -- Set Defaults for Modes
  !this.localview.navi.cursor     = 'Pointer'
  !this.localview.navi.prompt     = 'Navigate : '

  !this.localview.pick.cursor     = 'Pointer'
  !this.localview.pick.prompt     = 'Pick Element : '

  !this.localview.pAny.cursor     = 'Pointer'
  !this.localview.pAny.prompt     = 'Pick Any : '

  !this.localview.pLine.cursor    = 'Pointer'
  !this.localview.pLine.prompt    = 'Pick Pline : '

  !this.localview.point.cursor    = 'Pick'
  !this.localview.point.prompt    = 'Point Ppoint : '

  !this.localview.screen.cursor   = 'Crosshair'
  !this.localview.screen.prompt   = 'Pick 3D Position : '

  !this.localview.default.cursor  = 'Pointer'
  !this.localview.default.prompt  = 'Navigate : '

   -- Form Members
  member .drawlist            is DRAWLIST
  member .createHereElement   is DBREF
  member .selectedElement     is DBREF
  member .actualElementToCopy is DBREF
  -- Store Position
  member .storedPosition      is POSITION
  member .secondDisplacement  is STRING
  -- Aid Graphics
  member .tag                 is REAL
  member .modelAid            is REAL
  -- Undoable member
  member .undo                is UNDOABLE
  -- No :STDMODELITEM UDET member
  member .useUDET             is BOOLEAN

  !this.firstshowncall  = '!this.firstShown()'

exit
------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Form first shown callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  -- Should we depend on :STDMODELITEM UDET (NO according to 26 May 2010 Review)
  !this.useUDET = false
  -- Search for UDET
  if (!this.useUDET) then
    var !c collect all UDET with (Udname eq 'STDMODELITEM')
    if (!c.size().eq(0)) then
      !this.useUDET = false
    endif
  endif

  !background = !!gphviews.views.first().background
  handle ANY
    !background = 15
  endhandle
  !this.drawlist = object DRAWLIST()
  !this.localview.background = !background
  !this.localview.shaded     = TRUE
  !this.drawlist.attachview(!this.localview)
  !this.drawlist.removeall()
  !this.drawlist.holes(true)
  !this.drawlist.update()

   -- add the local view
  !!edgCntrl.addview(!this.localview)

  -- Aid graphic numbers
  !this.tag            = !!aidNumbers.add('Standard Model Library Item Position')

  -- Undoable
  !this.undo.description('')
  !this.undo.undoAction(|!!aidClear(!!stdLibraryCreation.tag.string(), 'ALL')|)
  !this.undo.redoAction('')

  -- Whatever happens on the Apply will be undoable
  !this.create.setUndoable(!!stdLibraryCreation.undo)

  -- Have we any data?
  var !a coll all APPLDW with purp eq 'STDM'
  if (!a.size() eq 0) then
    -- Marine or Plant
    !mod = !!module()
    if (!mod.modkey eq 'marodes') then
      !file = object FILE('%PDMSUI%/DATA/SMLdataMarine.pmlmac')
    else
      !file = object FILE('%PDMSUI%/DATA/SMLdataPlant.pmlmac')
    endif
    -- Check files exist before we ask the question
    if (!file.exists()) then
      !answer = !!alert.confirm('This MDB has no sample Standard Model Library data. Do yo want to load some for test/demo purposes?')
      if (!answer.boolean()) then
        -- load different for Marine or Plant
        !!runMacro(!file.string(), ||)
      endif
    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation method run every time form is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !this.modelAid = !!aidNumbers.add('Create Standard Model Aids')

  !this.selectCE()

  -- find the available template worlds
  !this.getWorld(1)

  var !coord COORD
  if (!coord eq 'ENU') then
    !this.yIsText.val = N
    !this.zIsText.val = U
  else
    !this.yIsText.val = Y
    !this.zIsText.val = Z
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      getWorld
--
-- Description: Initialisation method run every time form is shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL       Hierarchy Level APPDAR or APPLDW (1, 2 or 3)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getWorld(!level is REAL)

  if !level.eq(1) then
   !this.getArea(!this.world, 'APPLDW', '/*')
   !this.getArea(!this.area, 'APPDAR', '$!this.world')
  elseif !level.eq(2) then
   !this.getArea(!this.area, 'APPDAR', '$!this.world')
  endif
  !this.getArea(!this.assemblyOpt, 'APPLDA', '$!this.area')

  if !this.assemblyOpt.dtext[1].eq('None Found') then
    !this.selectAssembly()
  endif

  !!ce = !this.assemblyOpt.selection().dbref()
  handle ANY
    return
  elsehandle NONE
    !this.selectAssembly()
  endhandle

  -- Navigate back to Zone
  !!ce = !this.createHereElement
  handle ANY
    -- Might not be set yet
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      getArea
--
-- Description: Gets all the data for the appWorld appArea an appData option gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET       Gadget
--    2    R     STRING       Search for this element type
--    3    R     STRING       Search within this element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getArea(!gadget is GADGET, !searchItem is STRING, !source is STRING)

  if !source.eq('/*') then
    var !a coll all $!searchItem with purp eq 'STDM'
    handle ANY
           !a = ARRAY()
    endhandle
  else
    var !a coll all $!searchItem with purp eq 'STDM' for $!source
    handle ANY
       !a = ARRAY()
    endhandle
  endif
  if !a.size().eq(0) then
    !dtext[1] = 'None Found'
    !a[1]     = 'NONE Found'
    !this.localview.visible = FALSE
  else
    if !this.name.val then
      var !dtext eval name for all from !a
      -- Heading For list gadget
      !headings = ARRAY()
      !headings.append('Name')
      !this.assemblyOpt.setHeadings(!headings)
    else
      var !dtext eval desc for all from !a
      -- Heading For list gadget
      !headings = ARRAY()
      !headings.append('Description')
      !this.assemblyOpt.setHeadings(!headings)
    endif
  endif

  !gadget.dtext = !dtext
  !gadget.rtext = !a

endmethod
------------------------------------------------------------------------
--
-- Method:      selectAssembly
--
-- Description: Called when you select an assembly element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAssembly()

  !!ce = !this.assemblyOpt.selection().dbref()
  handle ANY
    return
  endhandle

  !this.selectedElement = !!ce

  !this.addToDisplay()

  -- Navigate back to Zone
  !!ce = !this.createHereElement
  handle ANY
    -- Might not be set yet
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      addToDisplay
--
-- Description: Method to auto the current Design and add it to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToDisplay()

  -- Clear the model aid graphics only
  !!aidClear(!this.modelAid.string(), 'ALL')

  !selected = !this.assemblyOpt.selection().dbref()
  handle ANY
      !!alert.error('No Assembly selected')
      return
  endhandle
  if !!ce.neq(!selected) then
    return
  endif

  -- Get information about the Design (i.e. volume)
  var !unusedVolumeTest VOL CE
  handle ANY
    --!!alert.confirm (|No Graphical Elements in this Assembly|)
    !this.localview.visible = FALSE
    return
  elsehandle NONE
    !this.localview.visible = TRUE
  endhandle

  !background = !!gphviews.views.first().background
  handle ANY
    !background = 15
  endhandle

  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)

  !direction[1]  = -0.57735
  !direction[2]  = 0.57735
  !direction[3]  = -0.57735

  !this.localview.direction = !direction

  !elementZone = object DBREF('ZONE 1 OF ' & !!ce.string() )
  !position = !elementZone.position
  !positionX = !position
  !positionY = !position
  !positionZ = !position
  !positionX.east  = !position.east + 500mm
  !positionY.north = !position.north + 1000mm
  !positionZ.up    = !position.up + 500mm
  AID TEXT NUMBER $!<this.modelAid> 'Origin' AT $!position
  var !coord COORD
  if (!coord eq 'ENU') then
    AID TEXT NUMBER $!<this.modelAid> 'E' AT $!positionX
    AID TEXT NUMBER $!<this.modelAid> 'N' AT $!positionY
    AID TEXT NUMBER $!<this.modelAid> 'U' AT $!positionZ
  else
    AID TEXT NUMBER $!<this.modelAid> 'X' AT $!positionX
    AID TEXT NUMBER $!<this.modelAid> 'Y' AT $!positionY
    AID TEXT NUMBER $!<this.modelAid> 'Z' AT $!positionZ
  endif
  !!drawAxes (!elementZone, !this.modelAid)

endmethod
------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description: Method to set the limits of the local view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Element to limit for view
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limits(!element is DBREF)

  -- Initialise Variables
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Get volume of item
  !volumeElement = !element
  !volume      = object VOLUME(!volumeElement)
  !volume.from = !volume.from.string(!format).position()
  !volume.to   = !volume.to.string(!format).position()

  -- Load view limits with Volume
  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  -- Set view Limits
  !this.localview.limits = !array

endmethod
------------------------------------------------------------------------
--
-- Method:      killCall
--
-- Description: When to form is closed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- tidy up method
define method .killCall()

  !!aidClear(!this.tag.string(), 'ALL')
  !!aidClear(!this.modelAid.string(), 'ALL')

  !this.hide()

endmethod
------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: The creation call
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

  -- Quick check for 'NONE Found'
  if (!this.assemblyOpt.selection('rtext') eq 'NONE Found') then
    !!alert.error('No Assembly found')
    return
  endif

  -- We actually need the ZONE 1 of this selection
  var !zone ZONE 1 of $!this.selectedElement
  handle ANY
    !!alert.error('Cannot create because we need a ZONE in the Application Data')
    return
  elsehandle NONE
    !zoneElement = object DBREF(!zone)
    if (!this.useUDET) then
      !this.actualElementToCopy = !zoneElement.members[1]
      -- Second displacement required
      !this.secondDisplacement = !this.getMoveByResult(!zoneElement.members[1].position)
    else
      if (!zoneElement.function eq 'Copy Members') then
        !this.actualElementToCopy = !zoneElement.members[1]
        -- Second displacement required
        !this.secondDisplacement = !this.getMoveByResult(!zoneElement.members[1].position)
        handle ANY
          -- Must be Piping
            !this.secondDisplacement = 'E0'
        endhandle
      else
        !this.actualElementToCopy = !zoneElement
        !this.secondDisplacement = 'E0'
      endif
    endif
  endhandle

  -- Pick a Position
  !this.pickPositionMethod()

endmethod
------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create the actual instance at the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create(!position is POSITION)

  -- Initialise variable
  !byPositionRequired = false

  !!ce      = !this.createHereElement
  TAIL
  !copyMe   = !this.actualElementToCopy.name
  !copyType = !this.actualElementToCopy.actType

  NEW $!copyType COPY LIKE $!copyMe
  handle ANY
    !!alert.error('Unable to create the new ' & !copyType & ' ' & !!error.text.after(|)|))
    return
  elsehandle NONE
    at $!position
    handle ANY
      -- Position will fail for a PIPE (I need to take a different action)
      -- i.e. BY should do it
      !byPositionRequired = true
    endhandle
    !y = !this.yIsText.val.string()
    !z = !this.zIsText.val.string()
    ORI Y IS $!y AND Z IS $!z
    handle ANY
      !!alert.message('Could not orientate this element')
    endhandle

    -- Naming
    if (!this.autoName.val) then
      call !!autoNameCe(false)
      handle ANY
        -- Naming rules could be corrupt
        !name = '/' & !!ce.refno.string()
      elsehandle NONE
        !name = !!ce.name
      endhandle
      if (!!ce.isnamed) then
        COPY MEMBERS OF $!copyMe rename $!copyMe $!name
      else
        COPY MEMBERS OF $!copyMe
      endif
    else
      !name = !this.newName.val
      NAME $!name
      handle ANY
        if (!this.newName.val.trim().length().gt(0)) then
          !!alert.error('Name input was invalid - the new element will be unnamed')
        endif
        COPY MEMBERS OF $!copyMe
      elsehandle NONE
        COPY MEMBERS OF $!copyMe rename $!copyMe $!name
      endhandle
    endif
  endhandle

  -- Positioning and Orientation
  if (!byPositionRequired) then
    BY $!position
  endif

  -- Second displacement required
  BY $!this.secondDisplacement
  handle ANY
  endhandle

  !this.displayPosition(!position)

endmethod
------------------------------------------------------------------------
--
-- Method:      selectCE
--
-- Description: Callback when CE is selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      'BUTTON' or 'INIT'
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectCE()

  !red = object COLOUR('BrightRed')
  !white = object COLOUR('White')
  !this.hereName.background = !white.code

  -- Find the first choice zone that we can
  var !zone ZONE
  handle ANY
    SITE
    handle ANY
      !this.createHereElement = object DBREF()
      !this.hereName.val = 'Navigate to a Zone!'
      !this.hereName.background = !red.code
      return
    endhandle
    var !c COLLECT ALL ZONE FOR CE
    if (!c.size().gt(0)) then
      !zone = !c[1]
    else
      WORLD
      var !c COLLECT ALL ZONE FOR CE
      if (!c.size().gt(0)) then
        !zone = !c[1]
      else
        !this.createHereElement = object DBREF()
        !this.hereName.val = 'Navigate to a Zone!'
        !this.hereName.background = !red.code
        return
      endif
    endif
  endhandle

  !zoneElement = object DBREF(!zone)
  !this.hereName.val = 'ZONE ' & !zoneElement.name

  !this.createHereElement = !zoneElement
  !!ce = !this.createHereElement

endmethod
------------------------------------------------------------------------
--
-- Method:      pickPositionMethod
--
-- Description: EDG pick position.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPositionMethod()

     !packet = object EDGPACKET()
     !packet.definePosition('Pick New Item position')
     !packet.priority    = 2
     !packet.remove      = true
     !packet.action = '!!stdLibraryCreation.create(!this.return[1].position.wrt(worl))'
     !!edgCntrl.add(!packet)

 endmethod
------------------------------------------------------------------------
--
-- Method:      displayPosition()
--
-- Description: Display and return the passed position.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Passed position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPosition(!position is POSITION)

  !this.storedPosition = !position

  -- Tag the new position
  !this.tag(!position)

endmethod
------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Position to tag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tag(!position is POSITION)

  -- Initialise Variables
  AID CLEAR ALL $!<this.tag>

  -- Text description
  if (!this.selectedElement.description.trim().length().gt(0)) then
    !text      = 'New ' & !this.selectedElement.description & ' Position'
  else
    !text      = 'New ' & !this.selectedElement.namn & ' Position'
  endif

  -- Aid info
  AID TEXT NUMBER $!<this.tag> '$!text' AT $!<position>

endmethod

------------------------------------------------------------------------
--
-- Method:      getMoveByResult
--
-- Description: If we have an element being created as a zone member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION   Position of zone member element in original zone
-- Return:
--   [Data Type] [Description]
--    STRING      How much to move the item by
--
------------------------------------------------------------------------
define method .getMoveByResult(!position is POSITION) is STRING

  !memory = !!ce

  !testPosition = !position

  !e = !testPosition.east
  !n = !testPosition.north
  !u = !testPosition.up
  !result = |E($!e) N($!n) U($!u) wrt CE  |

  !!ce = !memory

  return !result

endmethod
