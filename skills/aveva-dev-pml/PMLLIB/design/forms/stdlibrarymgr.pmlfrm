--   File:      stdlibrarymgr.pmlfrm
--   Type:      Form Definition
--   Group:     Design
--   Keyword:
--   Module:    Design
--
--  Author:          Steve Bentley
--  Created:         Mon May 10 10:16:00 2010
--
--  Description:     Standard Model Library Manager
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToDisplay()                   -                   Method to auto the current selection and add it to the view
--  captureDesign()                  -                   Method to build an assembly from a specified type
--  create(STRING)                   -                   Show the form to create a new world, area or data element
--  deleteCE()                       -                   delete function
--  deleteItem(GADGET)               -                   Delete the world, area or data
--  explorerPopUp(ARRAY)             -                   Display pop-up on explorer
--  explorerSelect(ARRAY)            -                   Selection made on explorer
--  firstShown()                     -                   Form first shown callback
--  getArea(GADGET,STRING,STRING)    -                   Gets all the data for the appWorld appArea an appData option gadgets
--  getDisplayText(ARRAY)            ARRAY               Get display text
--  getMoveByResult(POSITION)        STRING              If we have additional items we need to displace by this amount
--  getWorld(REAL)                   -                   refresh the form from world, area or data
--  init()                           -                   Initialise form
--  killCall()                       -                   tidy up method
--  limits(DBREF)                    -                   Method to set the limits of the local view
--  modify(GADGET)                   -                   Modify the world, area or data
--  newOrigin(POSITION)              -                   Move the origin of the library item
--  pickPositionMethod()             -                   EDG pick position.
--  selectAssembly(BOOLEAN)          -                   Select the assembly
--  selectCaptureType(BOOLEAN)       -                   What element type are we capturing
--  selectCurrent(DBREF)             -                   When at APPLDA level get the correct world and area gadgets
--  stdLibraryMgr()                  -                   Constructor
--  toggleName()                     -
--  track()                          -                   Form is a tracking form (Aligns the system explorer only)
--  validElement(GADGET,STRING)      -                   Validate input to element gadgets
--
layout form !!stdLibraryMgr dialog dock right AutoAlign
--setup form !!stdLibraryMgr dialog dock right

  import 'ExplorerAddin'
  handle ANY
  endhandle

  using namespace 'Aveva.Pdms.Presentation'

  !this.icontitle     = 'StdLibrary'
  !this.formTitle     = 'Standard Model Library Manager'
  !this.initcall      = '!this.init()'
  !this.quitcall      = |!this.killCall()|
  !this.killingcall   = |!this.killCall()|
  track 'DESICE'   callback '!this.track()'

  button .ce  ' CE '  callback |!this.selectCurrent(!!ce)|
  toggle .name 'Toggle Name/Description' callback '!this.toggleName()'

  path down
  vdist 0
  hdist 0
  !tagw = 8
  option .world   tagwid $!tagw  'Library' anchor t+r+l at xmin.ce callback '!this.getWorld(2)' width 15
  path right
  button .crWorld  linkLabel 'New Library' anchor t+r callback |!this.create('APPLDW')|

  option .area  tagwid $!tagw 'Library Area' anchor t+r+l  at xmin.world ymax  callback '!this.getWorld(3)' width 15
  button .crArea  linkLabel  'New Area'  anchor t+r callback |!this.create('APPDAR')|

  option .assemblyOption tagwid $!tagw 'Library Item' anchor t+r+l at xmin.world ymax  callback '!this.selectAssembly(true)' width 15
  button .crData  linkLabel  'New Item'  anchor t+r callback |!this.create('APPLDA')|

  frame .captureFrame 'Add to Standard Model Library Item' anchor t+r+l at xmin.world ymax+0.5 width to max form
    option .captureOption  anchor t+l callback '!this.selectCaptureType(true)' width 5
    text   .element at xmax+0.1 anchor t+r+l callback '!this.selectCaptureType(false)' width to max.captureFrame is STRING
    rgroup .copyOrInclude at xmin.captureOption ymax HORIZONTAL buttonwidth 5
      add tag 'Copy'    SELECT 'Copy'
      add tag 'Include' SELECT 'Include'
    exit
    button .captureData linklabel 'Apply' anchor t+r at xmax.element-size callback |!this.captureDesign()|
  exit

  path down
  Container .explorerFrame NOBOX PMLnetcontrol 'NET' anchor t+r+l  at xmin.world ymax+0.1 width.captureFrame hei 9
  -- Zone created automatically

  frame .secondTaskPanel panel anchor all width.captureFrame

    button .gNewOrigin linklabel 'Pick New Origin' anchor t+l callback |!this.pickPositionMethod()|

    line .ftpl12 anchor t+r+l  horizontal width to max.secondTaskPanel height 0.1

    frame  .localViewFrame PANEL anchor all width.ftpl12
      para .prompt at xmin.ftpl12 ymax.ftpl12 width to max.ftpl12 lines 1
      view .localView at xmin.ftpl12 prompt .prompt givolume

        -- Input Modes
        -- Navigate
        inmode create _navi       type |DES_NAVIGATE|
        -- Standard Element Pick
        inmode create _pick       type |DES_PICK|
        -- Pick Any (Element, Ppoint, Pline)
        inmode create _pAny       type |DES_PICK_ANY|
        -- Plines
        inmode create _pLine      type |DES_PICK_PLINE|
        -- Ppoints
        inmode create _point      type |DES_PICK_POINT|
        -- Screen Position
        inmode create _screen     type |DES_3D_LINE|
        -- Laser Model rays
        inmode create _pickxgeom  type |DES_PICK_XGEOM|
        -- Default (Navigation)
        inmode create _pickDetail type |DES_PICK_DETAIL|
        -- Default (Navigation)
        inmode create _default    type |DES_NAVIGATE|

        height 10 width to max.secondTaskPanel

      exit
    exit
      -- Set Defaults for Modes
    !this.localView.navi.cursor     = 'Pointer'
    !this.localView.navi.prompt     = 'Navigate : '

    !this.localView.pick.cursor     = 'Pointer'
    !this.localView.pick.prompt     = 'Pick Element : '

    !this.localView.pAny.cursor     = 'Pointer'
    !this.localView.pAny.prompt     = 'Pick Any : '

    !this.localView.pLine.cursor    = 'Pointer'
    !this.localView.pLine.prompt    = 'Pick Pline : '

    !this.localView.point.cursor    = 'Pick'
    !this.localView.point.prompt    = 'Point Ppoint : '

    !this.localView.screen.cursor   = 'Crosshair'
    !this.localView.screen.prompt   = 'Pick 3D Position : '

    !this.localView.default.cursor  = 'Pointer'
    !this.localView.default.prompt  = 'Navigate : '

  exit

  menu .editWorld
   !this.editWorld.add('callback','Modify Library' ,'!this.modify(!this.world)')
   !this.editWorld.add('callback','Delete Library' ,'!this.deleteItem(!this.world)')
   !this.world.setPopUp(!this.editWorld)

  menu .editArea
   !this.editArea.add('callback','Modify Area' ,'!this.modify(!this.area)')
   !this.editArea.add('callback','Delete Area' ,'!this.deleteItem(!this.area)')
   !this.area.setPopUp(!this.editArea)

  menu .editAssembly
   !this.editAssembly.add('callback','Modify Item' ,'!this.modify(!this.assemblyOption)')
   !this.editAssembly.add('callback','Delete Item' ,'!this.deleteItem(!this.assemblyOption)')
   !this.assemblyOption.setPopUp(!this.editAssembly)

  menu .explorePopUp popup
   !this.explorePopUp.add( 'CALLBACK', 'Delete','!this.deleteCE()','deleteSelected')

  -- Form Members
  member .assembly           is DBREF

  member .systemExplorer     is PMLEXPLORERCONTROL
  member .drawlist           is DRAWLIST
  member .explorerSelected   is DBREF

  member .captureDataType    is STRING
  member .rememberMe         is DBREF
  member .captureElement     is DBREF

  member .undo               is UNDOABLE

  -- Aid Graphics
  member .modelAid           is REAL
  -- No :STDMODELITEM UDET member
  member .useUDET             is BOOLEAN

  -- Message once members
  member .messageAddAdditional is BOOLEAN
  member .messageResetRefs     is BOOLEAN

  member .resetRoot            is BOOLEAN

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
--  !!appFormCntrl.registerForm(!this)
  !this.firstShownCall  = '!this.firstShown()'

exit
------------------------------------------------------------------------
--
-- Method:      stdLibraryMgr
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stdLibraryMgr()

  -- Should we depend on :STDMODELITEM UDET (NO according to 26 May 2010 Review)
  !this.useUDET = false
  -- Search for UDET
  if (!this.useUDET) then
    var !c collect all UDET with (Udname eq 'STDMODELITEM')
    if (!c.size().eq(0)) then
      !this.useUDET = false
    endif
  endif

  -- Validation call
  !this.element.validateCall = '!this.validElement('

  !this.modelAid = !!aidNumbers.add('Standard Model Manager Aids')

  !this.rememberMe = !!ce

  -- Have we any data?
  var !a coll all APPLDW with purp eq 'STDM'
  if (!a.size() eq 0) then
    -- Marine or Plant
    !mod = !!module()
    if (!mod.modkey eq 'marodes') then
      !file = object FILE('%PDMSUI%/DATA/SMLdataMarine.pmlmac')
    else
      !file = object FILE('%PDMSUI%/DATA/SMLdataPlant.pmlmac')
    endif
    -- Check files exist before we ask the question
    if (!file.exists()) then
      -- Make sure we have somewhere to load it
      if (!!ce.dbwrite) then
        !answer = !!alert.confirm('This MDB has no sample Standard Model Library data. Do you want to load some for test/demo purposes?')
        if (!answer.boolean()) then
         -- load different for Marine or Plant
         !!runMacro(!file.string(), ||)
        endif
      endif
    endif
  endif

  -- find the available template worlds
  !this.resetRoot = true
  !this.getWorld(1)
  !this.secondTaskPanel.visible = TRUE

  using namespace 'Aveva.Pdms.Presentation'
  !this.systemExplorer = object PMLEXPLORERCONTROL()
  !this.systemExplorer.initialise('DESI','/*')
  !this.explorerFrame.control = !this.systemExplorer.handle()

  --Add event handlers
  !this.systemExplorer.addeventhandler('OnSelectionChanged',!this, 'explorerSelect')
  !this.systemExplorer.addeventhandler('Onpopup', !this, 'explorerPopUp')

  -- What can we capture
  !rtext = ARRAY()
  !rtext.append('ZONE')
  !rtext.append('STRU')
  !rtext.append('EQUI')
  !rtext.append('PIPE')
  !rtext.append('HVAC')
  !rtext.append('CWAY')

  !this.captureOption.dtext = !rtext
  !this.captureOption.rtext = !rtext

  -- Undoable
  !this.undo.description('')
  !this.undo.undoAction('')
  !this.undo.redoAction('')

  -- Whatever happens on the Apply will be undoable
  !this.captureData.setUndoable(!!stdLibraryMgr.undo)

  !!ce = !this.rememberMe

  !this.captureData.active = false

  -- Message once settings
  !this.messageAddAdditional = true
  !this.messageResetRefs = true

endmethod
------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Form first shown callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  !background = !!gphviews.views.first().background
  handle ANY
    !background = 15
  endhandle
  !this.drawlist = object DRAWLIST()
  !this.drawlist.followSelection(true)
  !this.localView.background = !background
  !this.localView.shaded     = TRUE
  !this.drawlist.attachview(!this.localView)
  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.drawlist.holes(true)
  !this.drawlist.update()
  !this.limits(!!ce)
  handle ANY
  endhandle
   -- add the local view
  !!edgCntrl.addView(!this.localView)
  handle ANY
  endhandle

  !!ce = !this.rememberMe

endmethod
------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify the world, area or data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      world, area or data gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modify(!item is GADGET)

  if !item.dtext[1].eq('None Found') then
    !!alert.error('No assembly selected')

  else
    !selection = !item.selection()
    pml load form !!appDataCreate

    if !item.eq(!this.world) then
      !type = 'APPLDW'
      !formTitle = 'Modify Standard Model Library'
    elseif !item.eq(!this.area) then
      !type = 'APPDAR'
      !formTitle = 'Modify Standard Model Library Area'
    else
      !type = 'APPLDA'
      !formTitle = 'Modify Standard Model Library Data'
      !!appDataCreate.assemblyName = !selection.dbref().name
    endif

    !!appDataCreate.formTitle = !formTitle
    !!appDataCreate.type = !type
    handle ANY
      pml load form !!appDataCreate
      !!appDataCreate.type = !type
    endhandle

    !!appDataCreate.mode = 'modify'
    !!appDataCreate.name.val = !selection.dbref().name
    !!appDataCreate.desc.val = !selection.dbref().desc
    !!appDataCreate.current  = !selection.dbref()

    show !!appDataCreate

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      deleteItem
--
-- Description: Delete the world, area or data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      world, area or data gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteItem(!item is GADGET)

  if !item.dtext[1].eq('None Found') then
    !!alert.error('No Library Item selected')
  else
    !selection = !item.selection()
    !!ce = !selection.dbref()
    !!deleteCE()

    if !item.eq(!this.world) then
      !this.getWorld(1)
    elseif !item.eq(!this.area) then
      !this.getWorld(2)
    else
      !this.getWorld(3)
    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      explorerPopUp
--
-- Description: Display pop-up on explorer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      ???
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .explorerPopUp(!data is ARRAY)

  !element = object DBREF(!data[2])
  !!ce = !element
  !this.explorerFrame.popup = !this.explorePopUp
  if ((!element.type neq 'APPLDA' and !element.owner.type neq 'APPLDA') and (!element.dbwrite and !element.lock.not())) then
    !this.explorePopUp.setFieldProperty('deleteSelected','ACTIVE',true)
  else
    !this.explorePopUp.setFieldProperty('deleteSelected','ACTIVE',false)
  endif
  !this.explorerFrame.showPopUp(!data[0], !data[1])

endmethod
------------------------------------------------------------------------
--
-- Method:      explorerSelect
--
-- Description: Selection made on explorer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      ???
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .explorerSelect(!data is ARRAY)

  !element = object DBREF(!data[0])
  !!ce = !element
  !this.explorerSelected = !!ce
  !this.addToDisplay()

endmethod
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- find the available template worlds
  !this.getWorld(1)
  !this.secondTaskPanel.visible = TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Form is a tracking form (Aligns the system explorer only)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

  if !this.shown().not() then
    return
  else
    var !a APPLDA
    handle ANY
      return
    elsehandle NONE
      !this.systemExplorer.selectelement(!!ce.string())
      handle ANY
        return
      endhandle
    endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      getWorld
--
-- Description: refresh the form from world, area or data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL      1. world, 2. area or 3. data gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getWorld(!level is REAL)

  if !level.eq(1) then
    !this.getArea(!this.world, 'APPLDW', '/*')
    !this.getArea(!this.area, 'APPDAR', '$!this.world')
  elseif !level.eq(2) then
    !this.getArea(!this.area, 'APPDAR', '$!this.world')
  endif

  !this.getArea(!this.assemblyOption, 'APPLDA', '$!this.area')

  if !this.assemblyOption.dtext[1].eq('None Found') then
    !this.selectAssembly(true)
    !this.explorerFrame.active = FALSE
  else
    !this.selectAssembly(true)
    !this.explorerFrame.active = TRUE
  endif

  !!ce = !this.assemblyOption.selection().dbref()

  handle ANY
    !this.captureData.active = false
    return
  elsehandle NONE
    !this.selectCaptureType(false)
    !this.selectAssembly(true)
  endhandle


endmethod
------------------------------------------------------------------------
--
-- Method:      selectCurrent
--
-- Description: When at APPLDA level get the correct world and area gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      Application Data element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectCurrent(!element is DBREF)

  !!ce = !element
  !elementType = !!ce.type

  if (!elementType eq 'APPLDW') then
    !this.getArea(!this.world, 'APPLDW', '/*' )
    !this.world.select('rtext', !!ce.string())
    !this.getWorld(2)
  elseif    (!elementType eq 'APPDAR') then
    !this.getArea(!this.world, 'APPLDW', '/*' )
    !this.world.select('rtext', !!ce.owner.string())
    !this.getArea(!this.area, 'APPDAR', '$!this.world')
    !this.area.select('rtext', !!ce.string())
    !this.getWorld(2)
  else
    APPLDA
    handle ANY
      !!alert.error('Not at a Standard Model Library Item')
      return
    endhandle

    -- Check for a valid Standard Model Library
    if (!!ce.purpose.upcase() neq 'STDM') then
      !!alert.error('Not at a Standard Model Library Item')
      return
    endif

    !this.getArea(!this.world, 'APPLDW', '/*' )
    !this.world.select('rtext', !!ce.owner.owner.string())
    !this.getArea(!this.area, 'APPDAR', '$!this.world')
    !this.area.select('rtext', !!ce.owner.string())
    !this.getArea(!this.assemblyOption, 'APPLDA', '$!this.area')
    !this.assemblyOption.select('rtext', !!ce.string())

    !this.selectAssembly(true)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      getArea
--
-- Description: Gets all the data for the appWorld appArea an appData option gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Data gadget
--    2    R     STRING      Search item
--    3    R     STRING      Source of search
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getArea(!gadget is GADGET, !searchItem is STRING, !source is STRING)

  if !source.eq('/*') then
      var !a coll all $!searchItem with purp eq 'STDM'
      handle ANY
        !a = ARRAY()
      endhandle
  else
     var !a coll all $!searchItem with purp eq 'STDM' for $!source
     handle ANY
       !a = ARRAY()
     endhandle
  endif

  if !a.size().eq(0) then
    !dtext = !this.getDisplayText(!a)
    !this.localView.visible = FALSE
    !this.gNewOrigin.active = FALSE
  else
    !dtext = !this.getDisplayText(!a)
  endif


  !gadget.dtext = !dtext
  !gadget.rtext = !a

endmethod
------------------------------------------------------------------------
--
-- Method:      selectAssembly
--
-- Description: Select the assembly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAssembly(!resetMessages is BOOLEAN)

  !memory = !!ce


  if (!this.resetRoot) then
    !this.systemExplorer.resetRoot(!this.assemblyOption.selection())
  endif

  handle ANY
  endhandle
  !!ce = !this.assemblyOption.selection().dbref()
  handle ANY
    !this.assembly = object DBREF()
    return
  endhandle

  !this.assembly = !this.assemblyOption.selection().dbref()

  !this.explorerSelected = !!ce

  !this.addToDisplay()

  -- Reset Message if changing element
  if (!resetMessages) then
    !this.messageAddAdditional = true
    !this.messageResetRefs = true
  endif

  !!ce = !memory
  handle ANY
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Show the form to create a new world, area or data element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING    APPLDW, APPDAR or APPLDA
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create(!type is STRING)

  !!appDataCreate.type = !type
  handle ANY
    pml load form !!appDataCreate
    !!appDataCreate.type = !type
  endhandle
  !!appDataCreate.mode = 'new'

  if !type.eq('APPLDW') then
    !!appDataCreate.current = !!ce
    !!appDataCreate.formTitle = 'Create Standard Model Library'
  elseif !type.eq('APPDAR') then
    !!appDataCreate.current = !this.world.selection().dbref()
    handle ANY
      !!alert.error('Not at an Standard Model Library')
      return
    endhandle
    !!appDataCreate.formTitle = 'Create Standard Model Library Area'
  else
    !!appDataCreate.current =  !this.area.selection().dbref()
    handle ANY
      !!alert.error('Not at an Standard Model Library Area')
      return
    endhandle
    !!appDataCreate.formTitle = 'Create Standard Model Library Data'
  endif

  if !type.eq('APPLDW') then
    if (!!appDataCreate.current.dbwrite) then
      -- OK we should be able to create
    else
      !!alert.message(|This database is 'Read Only'|)
      return
    endif
  else
    if (!!appDataCreate.current.dbwrite and !!appDataCreate.current.lock.not()) then
      -- OK we should be able to create
    else
      !!alert.message(|This Library Element is either 'Read Only' or 'Locked'|)
      return
    endif
  endif

  show !!appDataCreate

endmethod
------------------------------------------------------------------------
--
-- Method:      captureDesign
--
-- Description: Method to build an assembly from a specified type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- method to build an assembly from a graphical selection
define method .captureDesign()

  -- Initialise variables
  !additionalItems = false

  !option = !this.copyOrInclude.selection()

  -- What are we capturing
  !copyMe   = !this.captureElement.name
  !createType = !this.captureElement.actType

  -- Check if we can write to this library item
  if (badref(!this.assembly)) then
    !!alert.message(|This Library Item is 'Invalid'|)
    return
  elseif (!this.assembly.dbwrite and !this.assembly.lock.not()) then
    -- OK we should be able to create in this assembly
  else
    !!alert.message(|This Library Item is either 'Read Only' or 'Locked'|)
    return
  endif

  -- What are we capturing
  !captureType = !this.captureDataType

  -- Abort if the assembly is already populated
  var !all coll all (ZONE MEM) for $!this.assembly
  if (!all.size().gt(0)) then
    if (!createType eq 'ZONE') then
      !!alert.message('You can not add an additional zone to this Library Item, because it already contains other items')
      return
    else
      if (!this.messageAddAdditional) then
        !answer = !!alert.confirm('Add additional elements to the Library Item? If you do, then a new ZONE will always be created when making a new instance in the design')
        if (!answer.boolean().not()) then
          return
        else
          !this.messageAddAdditional = false
        endif
      endif
      !additionalItems = true
    endif
  endif
  if (!all.size().eq(0)) then
    -- OK
  else
    if (!this.captureElement.hardType eq 'PIPE' and !option eq 'Copy') then
      if (!this.messageResetRefs) then
        !!alert.message('If you COPY a pipe separate from equipment then any connection references will need to be reset')
        !this.messageResetRefs = false
      endif
    endif
    if (!this.captureElement.hardType eq 'CWAY' and !option eq 'Copy') then
      if (!this.messageResetRefs) then
        !!alert.message('If you COPY a Cableway separate from equipment then any connection references will need to be reset')
        !this.messageResetRefs = false
      endif
    endif
  endif

  -- Try to navigate to the capture element
  !!ce = !this.captureElement
  handle NONE
    -- Check if we can capture this element
    if (!this.captureElement.dbwrite and !this.captureElement.lock.not()) then
      -- OK we should be able to capture this element
    else
      !!alert.message(|The element to capture is either 'Read Only' or 'Locked'|)
      return
    endif
    !answer = !!alert.confirm('Try to capture ' & !!ce.name & ' to use as a Standard Library Model Item?')
    if (!answer.boolean()) then
      -- We shall try!
    else
      return
    endif
  elsehandle ANY
    !!alert.error('Cannot navigate to a ' & !captureType & ' to use as a Standard Library Model Item!')
    return
  endhandle

  -- Small validation of the data element
  ZONE 1 of $!this.assembly
  handle ANY
    !!alert.error('Expected to find a ZONE in $!this.assembly')
    return
  endhandle

  -- A zone is a special case because we need a multi-discipline element
  if (!this.captureElement.type eq 'ZONE') then

    -- May need to convert this to a :STDMODELITEM
    !copyMe   = !this.captureElement.name
    if (!this.useUDET) then
      !createType = ':STDMODELITEM'
      -- TODO - Copy will not work in this scenario however in issued code we will not be using useUDET true.
    endif

    -- Test to see if /SML$!copyMe exists if so index the new names
    !prefix = '/SML_'
    do !i from 1 to 100
      !prefix = '/SML_' & !i.string()
      !unusedTestExist = object DBREF(!prefix  & !copyMe)
      handle (2,109)
        -- element does not exist
        break
      elsehandle NONE
        skip
      endhandle
    enddo

    if (!option eq 'Copy') then
      TAIL
      !command = 'NEW $!createType $!prefix$N$!copyMe COPY $!copyMe RENAME $!copyMe $!prefix$N$!copyMe'
      -- The above will fail if the copy me is unnamed
      if (!copyMe.substring(1, 1) eq '=') then
        !command = 'NEW $!createType $!prefix$N$!copyMe COPY $!copyMe'
      endif
    else
     TAIL
      !command = 'NEW $!createType COPY LIKE $!copyMe'
    endif

    $!command
    handle ANY
      !!alert.error('Unable to capture ' & !copyMe & ' to use as a Standard Library Model Item')
      !!alert.error('Because ' & !!error.text)
      return
    elsehandle NONE
      !newItem = !!ce
      -- Try to Position at E0
      at E0
      handle ANY
        -- May not have a position e.g. PIPE, HVAC, CWAY
      endhandle

      !this.rememberMe = !!ce
      -- Add this special function
      if (!this.useUDET.not() and !this.captureElement.actType neq 'ZONE') then
        !!ce.owner.function = 'Copy Members'
        if (!additionalItems) then
          !!ce.owner.function = 'Additional Items'
        endif
      endif

      if (!option eq 'Copy') then
        -- No action
      else
        do from 1 to !this.captureElement.mcount
          INCLUDE ACROSSDB MEMBERS OF $!copyMe
        enddo
        !!ce = !this.captureElement
        DELETE ZONE
        !!ce = !this.rememberMe
        NAME $!copyMe
      endif

      if (!this.useUDET) then
        -- all is OK as is
      else
        -- Tidy up the *-ZONE administrative ZONE
        PREV ZONE
        handle ANY
          -- It is possible that we have an actual type like a :STDMODELITEM (Base type ZONE owned by ZONE)
        elsehandle NONE
          if ((!!ce.owner.name & '-ZONE') eq !!ce.name) then
            DELETE ZONE
            handle ANY
              !!alert.error('There should be only 1 ZONE in this APPLDA. Please resolve')
            endhandle
            1 ZONE
          endif
        endhandle
      endif

      -- If we have just added a zone we will not need this message on this Assembly Item
      if (!createType eq 'ZONE') then
        !this.messageAddAdditional = false
      endif

    endhandle
  else
    -- Add this special function
    if (!this.useUDET.not() and !this.captureElement.type neq 'ZONE') then
      FUNC 'Copy Members'
      if (!additionalItems) then
        FUNC 'Additional Items'
      else
        APPLDA
        -- This must be occurring on the first element only (Not a zone)
        !copyMePosition = !this.captureElement.position
        handle ANY
          if (!this.captureElement.type inset('PIPE','HVAC')) then
            var !headPosition POS PH OF 1 BRAN of $!this.captureElement
            handle ANY
              var !headPosition 'X0 Y0 Z0 wrt /* '
            endhandle
          else
            var !headPosition 'X0 Y0 Z0 wrt /* '
          endif
          !copyMePosition = object POSITION(!headPosition)
        endhandle
        !func = !this.getMoveByResult(!copyMePosition)
        FUNC '$!func'
        1 ZONE
      endif
    endif

    -- Test to see if /SML$!copyMe exists if so index the new names
    !prefix = '/SML_'
    do !i from 1 to 100
      !prefix = '/SML_' & !i.string()
      !unusedTestExists = object DBREF(!prefix  & !copyMe)
      handle (2,109)
        -- element does not exist
        break
      elsehandle NONE
        skip
      endhandle
    enddo

    if (!option eq 'Copy') then
      !command = 'TAIL NEW $!createType $!prefix$N$!copyMe COPY $!copyMe RENAME $!copyMe $!prefix$N$!copyMe'
      -- The above will fail if the copy me is unnamed
      if (!copyMe.substring(1, 1) eq '=') then
        !command = 'NEW $!createType $!prefix$N$!copyMe COPY $!copyMe'
      endif
    else
      !command = 'INCLUDE ACROSSDB $!copyMe'
    endif

    $!command
    handle (41,12)
      -- Name already exists
      !!alert.error('Standard Library Model Item name already exists so new element is unnamed')
    elsehandle ANY
      !!alert.error('Unable to capture ' & !copyMe & ' to use as a Standard Library Model Item')
      !!alert.error('Because ' & !!error.text)
      return
    endhandle

    if (!option eq 'Copy') then
      !newItem = !!ce
    else
      1
      !newItem = !!ce
    endif
  endif

  !!ce = !newItem
  -- Remove any Spools as they are not allowed
  Protection OFF
  var !spools collect all (PSLIST HSLIST PPLIST) for ce
  do !r indices !spools
    !!ce = !spools[!r].dbref()
    !spoolType = TYPE
    DELETE $!spoolType
    if (!r eq 1) then
      !!alert.message('Spools were ignored')
    endif
  enddo
  Protection ON
  !!ce = !newItem
  if (!additionalItems) then
    -- We need to displace additional items by the same amount as the original Item
    var !moveBy FUNC of APPLDA
    $!moveBy
    handle ANY
      -- Someone may have changed the expected data
      !!alert.warning(|Please check the position of the added item|)
    endhandle
  else
    AT E0
    handle ANY
      -- Same as above and should work
      -- We need to displace additional items by the same amount as the original Item
      var !moveBy FUNC of APPLDA
      $!moveBy
      handle ANY
        -- Someone may have changed the expected data
        !!alert.warning(|Please check the position of the added item|)
      endhandle
    endhandle
  endif

  -- Confirm all is OK now
  !!alert.message(!newItem.name & ' can now be used as a Standard Library Model Item')

  -- Select the assembly so we see a picture of it
  !this.selectAssembly(false)

  -- Return
  return

endmethod
------------------------------------------------------------------------
--
-- Method:      addToDisplay
--
-- Description: Method to auto the current selection and add it to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToDisplay()

  !selected = !this.assemblyOption.selection().dbref()
  handle ANY
      !!alert.error('No Assembly selected')
      return
  endhandle
  if !!ce.neq(!selected) then
    return
  endif

  -- Clear the model aid graphics only
  !!aidClear(!this.modelAid.string(), 'ALL')

  -- Get information about the selection (i.e. volume)
  var !unusedTestVolume VOL CE
  handle ANY
    --!!alert.confirm (|No Graphical Elements in this Assembly|)
    !this.localView.visible = FALSE
    !this.gNewOrigin.active = FALSE
    return
  elsehandle NONE
    !this.localView.visible = TRUE
    !this.gNewOrigin.active = TRUE
  endhandle

  !background = !!gphviews.views.first().background
  handle ANY
    !background = 15
  endhandle

  -- Remove the original from the standard draw list
  REMOVE CE

  !this.drawlist.removeall()
  !this.drawlist.add(!!ce)
  !this.limits(!!ce)

  !direction[1]  = -0.57735
  !direction[2]  = 0.57735
  !direction[3]  = -0.57735

  !this.localView.direction = !direction

  !elementZone = object DBREF('ZONE 1 OF ' & !!ce.string() )
  !position = !elementZone.position
  !positionX = !position
  !positionY = !position
  !positionZ = !position
  !positionX.east  = !position.east + 500mm
  !positionY.north = !position.north + 1000mm
  !positionZ.up    = !position.up + 500mm
  AID TEXT NUMBER $!<this.modelAid> 'Origin' AT $!position
  var !coord COORD
  if (!coord eq 'ENU') then
    AID TEXT NUMBER $!<this.modelAid> 'E' AT $!positionX
    AID TEXT NUMBER $!<this.modelAid> 'N' AT $!positionY
    AID TEXT NUMBER $!<this.modelAid> 'U' AT $!positionZ
  else
    AID TEXT NUMBER $!<this.modelAid> 'X' AT $!positionX
    AID TEXT NUMBER $!<this.modelAid> 'Y' AT $!positionY
    AID TEXT NUMBER $!<this.modelAid> 'Z' AT $!positionZ
  endif
  !!drawAxes (!elementZone, !this.modelAid)

endmethod
------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description: Method to set the limits of the local view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Element to add
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limits(!element is DBREF)

  -- Initialise Variables
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Get volume of item
  !volume      = object VOLUME(!element)
  !volume.from = !volume.from.string(!format).position()
  !volume.to   = !volume.to.string(!format).position()

  -- Load view limits with Volume
  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  -- Set view Limits
  !this.localView.limits = !array

endmethod
------------------------------------------------------------------------
--
-- Method:      killCall
--
-- Description: tidy up method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Element to add
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .killCall()

  !!aidClear(!this.modelAid.string(), 'ALL')
  !this.hide()

endmethod
------------------------------------------------------------------------
--
-- Method:      selectCaptureType
--
-- Description: What element type are we capturing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     True or False to set; or just validate current setting
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectCaptureType(!option is BOOLEAN)

  if (!option) then
    !this.captureDataType = !this.captureOption.selection('rtext')

    $!this.captureDataType
    handle NONE
      !this.captureElement = !!ce
      !this.element.val = !!ce.name
      !this.captureData.active = true
      if (badref(!this.assembly)) then
        !this.captureData.active = false
      endif
    elsehandle ANY
      !this.captureData.active = false
      !!alert.error('Cannot navigate to a ' & !this.captureDataType & ' to use as a Standard Library Model Item!')
      return
    endhandle
  else
    !test = !this.element.val.dbref().type
    handle ANY
      !this.captureData.active = false
      return
    elsehandle NONE
      !element                   = !this.element.val.dbref()
      if (!element.type eq !this.captureOption.selection('rtext')) then
        !this.captureData.active = true
      else
        !this.captureData.active = false
      endif
      if (badref(!this.assembly)) then
        !this.captureData.active = false
      endif
      if( !this.captureData.active ) then
        !this.captureElement     = !element
      endif
    endhandle
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      getMoveByResult
--
-- Description: If we have additional items we need to displace by this amount
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION       Original position of first item (now at E0)
-- Return:
--   [Data Type] [Description]
--    STRING      How much to move the item by
--
------------------------------------------------------------------------
define method .getMoveByResult(!position is POSITION) is STRING

  !memory = !!ce

  !testPosition = !position

  !e = !testPosition.east
  !n = !testPosition.north
  !u = !testPosition.up
  !result = |BY E(-1 * $!e) N(-1 * $!n) U(-1 * $!u)|

  !!ce = !memory

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      validElement
--
-- Description: Validate input to element gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validElement(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    !this.captureData.active = false
    return error 1 'Invalid input.'
  endif

  !test = !gadget.val.dbref()
  handle ANY
    !this.captureData.active = false
    return error 1 'Element does not exist'
  endhandle

  !this.captureOption.select('rtext', !test.type)
  handle ANY
    !this.captureData.active = false
    return error 1 'Invalid element type'
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickPositionMethod
--
-- Description: EDG pick position.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPositionMethod()

     !packet = object EDGPACKET()
     !packet.definePosition('Pick position of new Origin')
     !packet.priority    = 2
     !packet.remove      = true
     !packet.action = '!!stdLibraryMgr.newOrigin(!this.return[1].position.wrt(worl))'
     !!edgCntrl.add(!packet)

 endmethod

------------------------------------------------------------------------
--
-- Method:      newOrigin
--
-- Description: Move the origin of the library item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      POSITION   New origin position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .newOrigin(!position is POSITION)

  -- Initialise variable
  !zones = !!collectAllFor ('ZONE', '', !this.assembly)
  if (!zones.size() eq 1) then
    !zone = !zones[1]
  else
    !!alert.error('Expected 1 ZONE in this assembly but ZONE 1 not found')
    return
  endif
  !zoneMembers = !!collectMembersOf (!zone, '')
  !relativePosition = !position.wrt(!zone)
  !easting  = !relativePosition.east * -1
  !northing = !relativePosition.north * -1
  !upping   = !relativePosition.up * -1
  do !i indices !zoneMembers
    !!ce = !zoneMembers[!i]
    BY EAST $!easting NORTH $!northing UP $!upping
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
  enddo

  -- We need to adjust the displacement value set on the APPLDA
  APPLDA
  !functionString = !!ce.function
  !split = !functionString.split()
  -- Expect 10 strings
  if (!split.size().eq(10)) then
    !originalEast  = !split[4].before(')')
    !originalNorth = !split[7].before(')')
    !originalUp    = !split[10].before(')')
    var !newEast    ($!originalEast - $!easting)
    var !newNorth   ($!originalNorth - $!northing)
    var !newUp      ($!originalUp - $!upping)
    -- Rebuild the function string
    !split[4]  = !newEast & ')'
    !split[7]  = !newNorth & ')'
    !split[10] = !newUp & ')'
    !newString = ''
    do !i indices !split
      if (!i eq 1) then
        !newString = !split[!i]
      else
        !newString = !newString & ' ' & !split[!i]
      endif
    enddo
    FUNC '$!newString'
  endif

  !this.addToDisplay()

endmethod
------------------------------------------------------
--
-- Method:      deleteCE
--
-- Description: delete function
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteCE()

  !element = !!ce
  -- Save colour
  !saveColour = !this.drawlist.colour(!element)
  !this.drawlist.colour(!element, !!gphColOpt.highlight.code)
  !!deleteCE()
  !this.drawlist.colour(!element, !saveColour)
  handle ANY
  endhandle

endmethod

------------------------------------------------------
--
-- Method:      ToggleName
--
-- Description: Toggle the option values to show the description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleName()

  !rtext = !this.world.rtext
  !dtext = !this.getDisplayText(!this.world.rtext)

  if (!dtext.set()) then
    !world = !this.world.selection()
    !this.world.dtext = !dtext
    !this.world.rtext = !rtext
    if (not !world.empty()) then
      !this.world.select('rtext', !world)
      handle any
        !this.getWorld(1)
        return
      endhandle
    endif
  endif

  !rtext = !this.area.rtext
  !dtext = !this.getDisplayText(!this.area.rtext)

  if (!dtext.set()) then
    !area = !this.area.selection()
    !this.area.dtext = !dtext
    !this.area.rtext = !rtext
    if (not !area.empty()) then
      !this.area.select('rtext', !area)
      handle any
        !this.getWorld(1)
        return
      endhandle
    endif
  endif

  !rtext = !this.assemblyOption.rtext
  !dtext = !this.getDisplayText(!this.assemblyOption.rtext)

  if (!dtext.set()) then
    !option = !this.assemblyOption.selection()
    !this.assemblyOption.clear()
    !this.assemblyOption.dtext = !dtext
    !this.assemblyOption.rtext = !rtext
    if (not !option.empty()) then
      !this.assemblyOption.select('rtext', !option)
      handle any
        !this.getWorld(2)
        return
      endhandle
    endif
  endif


endmethod
------------------------------------------------------
--
-- Method:      getDisplayText()
--
-- Description: Get display text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDisplayText(!rtext is ARRAY) is ARRAY

  if !rtext.size().eq(0) then
    !dtext[1] = 'None Found'
    !rtext[1] = 'NONE Found'
  elseif (!rtext[1] ne 'NONE Found') then
    if !this.name.val then
      var !dtext eval name for all from !rtext
    else
      var !dtext eval desc for all from !rtext
    endif
  else
    !dtext = ARRAY()
  endif

  return !dtext

endmethod
