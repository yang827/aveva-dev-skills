-- File:            stldividebentpanel.pmlfrm
--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     STL
--   Module:        design
--  Created:         Wed Apr  7 17:15:47 2010
--  Author:          M.Barlow
--
-- Description:
-- GUI to divide bent panel into planar panels
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form
--  confirmDeletePanel(DBREF)        -                   Confirm deletion of original bent panel
--  dividePanel(DBREF)               -                   Split bent panel into planar panels
--  edgPickPanel()                   -                   Setup EDG mode to pick bent panel
--  initialise()                     -                   Initialise the form
--  pickBentPanel(EDGPICKDATA)       -                   pick event for bent panel
--  stlDivideBentPanel()             -                   Constructor
--  updateForm()                     -                   Update form information - TRACK CE CALLBACK
--
------------------------------------------------------------------------

setup form !!stlDivideBentPanel

  track 'DESICE'    call '!this.updateForm()'

  path down
  frame  .fTasks      'Select Panel'
    button .bPick     'Pick Bent Panel'      width 18 at x1   y1
    button .bCurrent  'Divide Bent Panel CE' width 18
  exit

  -- Bottom Line
  button .dismiss        'Dismiss' at xmax form-size ymax+0.2

  -- Form members

  -- EDG
  member .edgDescription  is STRING

  -- Undo event handlers
  member .undoDivide      is UNDOABLE

  member .debug           is BOOLEAN
exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      stlDivideBentPanel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlDivideBentPanel()

  !this.debug = false

  !this.formTitle          = 'Divide Bent Panel'
  !this.iconTitle          = 'Divide Panel'
  !this.callback           = '!this.initialise()'

  -- callbacks
  !this.cancelCall         = '!this.close()'
  !this.dismiss.callback   = '!this.close()'
  !this.bPick.callback     = '!this.edgPickPanel()'
  !this.bCurrent.callback  = '!this.dividePanel(!!ce)'

  -- EDG
  !this.edgDescription     = 'Pick Next Panel'

  -- Initialise UNDO
  !this.undoDivide.description('Divide bent panel')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- initialise form gadgets for first pick
  !this.bPick.active       = true
  if( !!ce.type eq 'PANE' ) then
    !this.bCurrent.active  = !!ce.purp eq 'BPLT'
  elseif( !!ce.type eq 'BPANEL' ) then
  	!this.bCurrent.active = true
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove EDG
  !!edgCntrl.remove(!this.edgDescription)

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      updateForm
--
-- Description: Update form information - TRACK CE CALLBACK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateForm()

  -- check that form is shown
  if( !this.shown().not() ) then
    return
  endif

  if( !!ce.type eq 'PANE' ) then
    !this.bCurrent.active = !!ce.purp eq 'BPLT'
  elseif( !!ce.type eq 'BPANEL' ) then
  	!this.bCurrent.active = true
  else
    !this.bCurrent.active = false
  endif

endmethod
-- End of method definition for .updateForm()

-----------------------------------------------------------------------
--
-- Method:      pickBentPanel
--
-- Description: pick event for bent panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickBentPanel(!pickData is EDGPICKDATA)

  !this.dividePanel(!pickData.item)

endmethod
-- End of method definition for .pickFirstPanel()

------------------------------------------------------------------------
--
-- Method:      dividePanel
--
-- Description: Split bent panel into planar panels
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference to bent panel PANE element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dividePanel(!bentPanel is DBREF)

  if(!this.debug)then
		write '+Enter .dividePanel() - $!bentPanel'
	endif

  -- get data for bent panel element
  !bentPanelObject = object STLBENTPANEL(!bentPanel)
  handle any
    !!alert.error(!!error.text)
    if(!this.debug)then
		  write '-Leave .dividePanel() - couldnt create STLBENTPANEL'
	  endif
    return
  endhandle

  -- make divide operation undoable
  !this.undoDivide.add()
  !bentPanelOwner = !bentPanel.owner
  !savePanel      = !bentPanel
  -- create planar panels for bent panel
  !count = !bentPanelObject.decomposeToPanels(!bentPanelOwner)
  handle any
    !!alert.error(!!error.text)
    !count = 0
  endhandle
  -- confirm deletion of bent panel
  if( !count gt 0 ) then
    !this.confirmDeletePanel(!savePanel)
  endif
  -- make sure that CE is in correct place for undo
  !!ce = !savePanel
  handle any
    -- if the bent panel is deleted, then go to its owner
    !!ce = !bentPanelOwner
    handle any
    endhandle
  endhandle
  !this.undoDivide.endUndoable()

  -- set form gadgets
  !this.updateForm()

  if(!this.debug)then
		write '-Leave .dividePanel()'
	endif
endmethod
-- End of method definition for .dividePanel()

------------------------------------------------------------------------
--
-- Method:      edgPickPanel
--
-- Description: Setup EDG mode to pick bent panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgPickPanel()

	if(!this.debug)then
		write '+Enter .edgPickPanel()'
	endif

  -- Define edg packet for picking elements to be split
  !packet              =  object EDGPACKET()
  !packet.elementPick('Pick Bent Panel')
  !this.edgDescription = 'Divide Bent panel'
  !packet.description  = !this.edgDescription

   -- Add filter for Pick
  !packet.pickPacket.picks[1].pick.input[3]   = |( ( HARDTYPE eq 'PANE' and PURP EQ 'BPLT' ) or ( HARDTYPE eq 'BPANEL')  )|
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !packet.action          =   '!!stlDivideBentPanel.pickBentPanel(!this.return[1])'

  !packet.priority        =   1
  !packet.remove          =   true

  !!edgCntrl.add(!packet)

	if(!this.debug)then
		write '-Leave .edgPickPanel()'
	endif
	
endmethod
-- End of method definition for .edgPickPanel()


------------------------------------------------------------------------
--
-- Method:      confirmDeletePanel
--
-- Description: Confirm deletion of original bent panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Bent panel to be deleted
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirmDeletePanel(!bentPanel is DBREF)

  -- Test bent panel to see if it can be deleted
  !okDelete   = !bentPanel.moddel.attribute('NAME')
  if( !okDelete.not() ) then
    return
  endif

  !type = !bentPanel.type

  -- highlight panel to delete
  !colour = !!gphColOpt.highlight.code
  ENHANCE $!bentPanel COLOUR $!colour
  ENHANCE $!bentPanel TRANSL 40
  !result = !!alert.confirm('Do you want to delete the original bent panel?')
  if( !result eq 'YES' ) then
    !saveCe = !!ce
    !!ce = !bentPanel
    DELETE $!<bentPanel.type>
    handle any
    endhandle
    !!ce = !saveCe
    handle any
    endhandle
  endif
  ENHANCE $!bentPanel TRANSL 0
  handle any
  endhandle
  UNENHANCE $!bentPanel
  handle any
  endhandle

endmethod
-- End of method definition for .confirmDeletePanel()
