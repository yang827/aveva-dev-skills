--
-- File:            stlpanelthickness.pmlfrm
--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     STL
--   Module:        design
--  Created:         Mon Apr 12  9:09:15 2010
--
-- Description:
-- GUI to set steel panel thickness (replacement for PML 1 code)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Change panel thickness
--  close()                          -                   Close form
--  initialise()                     -                   Initialise the form for CE
--  initialise(DBREF)                -                   Initialise the form for given element
--  reconnect()                      -                   Reconnect panels at PALJ
--  stlPanelThickness()              -                   Constructor
--  undoRedoEvent()                  -                   Undo Redo event handler
--
------------------------------------------------------------------------

setup form !!stlPanelThickness at xr 0 yr 0

  -- Current Element
  button .bCE      |CE|        at x0.5 y0.2

  -- Element Name
  para   .name                 at xmax+1         ymin     width 24 lines 2

  -- Thickness
  text .thickness  |Thickness| at xmin.bCE       ymax+0.1 width 14 is REAL format !!distanceFmt

  -- Bottom Line
  button .bApply   |Apply|     at xmin form-0    ymax+0.3
  button .bDismiss |Dismiss|   at xmax form-size ymin ok

  -- Form members

  -- element reference
  member .element            is DBREF
  -- Table of element types against presentation name
  member .elementType        is ARRAY
  member .elementTypeName    is ARRAY
  -- Undo event handlers
  member .undoThickness      is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      stlPanelThickness
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlPanelThickness()

  !this.formTitle          = 'Plate Thickness'
  !this.iconTitle          = 'PLTTHK'
  !this.callback           = '!this.initialise()'

  -- callbacks
  !this.cancelCall         = '!this.close()'
  !this.bDismiss.callback  = '!this.close()'
  !this.bApply.callback    = '!this.apply()'
  !this.bCE.callback       = '!this.initialise()'

  -- Initialise UNDO
  !this.undoThickness.description('Panel Thickness')
  !this.undoThickness.undoAction('!!stlPanelThickness.undoRedoEvent()')
  !this.undoThickness.redoAction('!!stlPanelThickness.undoRedoEvent()')

  -- Initialise element type table
  !this.elementType[1]     = 'PANE'
  !this.elementType[2]     = 'FLOOR'
  !this.elementType[3]     = 'SCREED'
  !this.elementType[4]     = 'GWALL'
  !this.elementType[5]     = 'EXTR'
  !this.elementTypeName[1] = 'Panel'
  !this.elementTypeName[2] = 'Floor'
  !this.elementTypeName[3] = 'Screed'
  !this.elementTypeName[4] = 'General Wall'
  !this.elementTypeName[5] = 'Extrusion'

endmethod
-- End of method definition for .pltCreate()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form for CE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- initialise form gadgets for current element
  !this.initialise(!!ce)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form for given element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to edit
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!element is DBREF)

  -- initialise form gadgets for current element
  if (!element.badref() ) then
    return error 1 'Invalid element reference'
  endif

  !this.element = !element

  -- check that this element can be modified with this form
  !onPanel = !this.element.hardtype inset('PANE','EXTR')
  if( !onPanel.not() ) then
    -- try to climb to a panel
    -- get ancestors
    !ownerList = !this.element.ownlst
    -- invert the array to search upwards
    !ownerList.invert()
    do !ref values !ownerList
      if( !ref.hardtype inset('PANE','EXTR') ) then
        !this.element = !ref
        !onPanel = true
        break
      endif
    enddo
  endif

  if( !onPanel ) then
    -- this element can be modified using this form
    if( !this.element.purpose eq 'BPLT') then
      !this.name.val   = 'Thickness of bent panel cannot be changed'
      !onPanel         = false
    else
      if( !this.element.isNamed ) then
        !this.name.val = !this.element.namn
      else
        !this.name.val = !this.element.namesq
      endif
      -- look up element type name
      !index = !this.elementType.findFirst(!this.element.type)
      if(!index.unset()) then
        !type = !this.element.fulltype
      else
        !type = !this.elementTypeName[!index]
      endif
      if( !this.element.type eq 'GWALL' ) then
        !this.formTitle = 'General Wall Height'
        !this.thickness.tag = 'Height'
      else
        !this.formTitle = !type + ' Thickness'
        !this.thickness.tag = 'Thickness'
      endif
    endif
  else
    -- element not valid for this form
    !this.name.val     = 'Thickness of current element cannot be modified using this form'
  endif

  -- set active status of gadgets for this element
  !this.bApply.active    = !onPanel
  !this.thickness.active = !onPanel

  -- initialise to current thickness
  if( !onPanel ) then
    if( !this.element.hardtype eq 'PANE' ) then
      !height = !this.element.lohe
      handle any
        !this.bApply.active      = false
        !this.thickness.active   = false
        !this.name.val           = 'Cannot set thickness because boundary not defined'
        return error 2 'Cannot set thickness on this element because boundary not defined'
      endhandle
      if( not badref(!this.element.spref) ) then
        if( !this.element.spref.answer ge !this.element.spref.maxAnswer ) then
          !this.bApply.active    = false
          !this.thickness.active = false
          !this.name.val         = 'Element thickness fixed by specification'
        endif
      endif
    else
      !height = !this.element.height
    endif
    !this.thickness.val = !height
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      undoRedoEvent
--
-- Description: Undo Redo event handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undoRedoEvent()

  if( !this.shown() ) then
    !this.initialise()
  endif

endmethod
-- End of method definition for .undoRedoEvent()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Change panel thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  !thickness = !this.thickness.val

  -- check for range limited by Spec.
  if( !this.element.hardtype eq 'PANE' ) then
    if (not badref(!this.element.spref)) then
      if(!this.element.spref.answer lt !this.element.spref.maxAnswer) then
        -- range
        if(!thickness.unset()) then
          !thickness = !this.element.spref.answer
        endif
        if(!thickness.between(!this.element.spref.answer, !this.element.spref.maxAnswer).not()) then
          !!alert.warning('Thickness must be within the range ' + !this.element.spref.answer.string() + ' - ' + !this.element.spref.maxAnswer.string() )
          return
        endif
      endif
    endif
  endif

  !element   = !this.element
  if( !this.element.hardtype eq 'PANE' ) then
    !loop = PLOOP 1 of $!element
    handle any
      !this.name.val = 'Cannot set the thickness attribute for this element'
      !!alert.error('Cannot set the thickness attribute for this element')
      return
    endhandle
    !element = !loop
  endif

  -- make change thickness undoable
  !this.undoThickness.add()
  !element.height = !thickness
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    !this.reconnect()
  endhandle
  -- find any PALJ elements under this element that might need to be reconnected
  !this.undoThickness.endUndoable()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      reconnect
--
-- Description: Reconnect panels at PALJ
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reconnect()

  -- Get all PALJ beneath this element
  !joints = !!collectAllFor ('PALJ' ,'', !this.element)
  !saveCE = !!ce

  -- Loop through collection and reconnect all PALJ
  do !pJoint values !joints
    $!pJoint
    RECONN
    handle ANY
    endhandle
  enddo

  !!ce = !saveCE

endmethod
-- End of method definition for .reconnect()
