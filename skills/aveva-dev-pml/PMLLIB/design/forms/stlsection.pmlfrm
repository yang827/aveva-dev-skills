endmethod
-- End of method definition for .createWall()

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Display form with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form title
--    2   R      STRING      Element type being created
--    3   R      STRING      Storage group
--    4   R      STRING      Storage area
--    5   R      STRING      Prompt for EDG
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!title is STRING, !type is STRING, !group is STRING, !area is STRING, !prompt is STRING)

  -- Initialise Variables
  !edgDescription = 'Create ' & !type

  -- Alter toggle text
  if (!type.eq(|STWALL|)) then
    !this.gensec.tag = 'Create as WALL?'
  elseif (!type.eq(|SCTN|)) then
	  !this.gensec.tag = 'Create as GENSEC?'
  endif

  -- Check we can create a curved section at this point
  !store = !!getStorageArea(!group, !area)

  -- If store is unset, can we create the panel in or above where we are
  if(!store.unset()) then
    !store = !!dtbOwnerOfType(!!ce, !type)

    if(!store.unset()) then
      !!alert.warning('Unable to create ' & !title & ' within this hierarchy structure. Move to an element that can own one or set the appropriate storage area.')
      return

    -- Use new store
    else
    endif
  endif

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.key            = 'STLWRK'
  !packet.description    = !edgDescription
  !packet.type           = 'STLWRK'
  !packet.priority       = 0
  !packet.close          = '!!aidNumbers.hide(!!stlSection.aidNumber)'
  !packet.action         = '!!stlSection.define(!this.return[1])'
  !packet.remove         = false
  !packet.form           = !!stlSection

  -- Add to system
  if(!!edgCntrl.add(!packet)) then

    -- Initialise Variables
    !this.formTitle  = !title
    !this.type       = !type
    !this.storeGroup = !group
    !this.storeArea  = !area
    !this.store      = !store
    !this.edgDescription = !edgDescription
    !this.prompt     = !prompt

    -- Initialise Positions
    !this.reDefine()

  endif

endmethod
-- End of method definition for .create(STRING, STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide Aid number
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove event
  !!edgCntrl.remove(!this.edgDescription)
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      redefine
--
-- Description: Redefine start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reDefine()

  -- Unset start & end positions
  !this.start     = object POSITION()
  !this.end       = object POSITION()
  !this.startPick = object EDGPOSITIONDATA()
  !this.endPick   = object EDGPOSITIONDATA()
  !this.startConn = object DBREF()

  -- Setup form
  !this.setup()

endmethod
-- End of method definition for .reDefine()

------------------------------------------------------------------------
--
-- Method:      define
--
-- Description: Redefine start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA Picked position data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .define(!data is EDGPOSITIONDATA)

  -- make sure that the pos3d form has been loaded before trying to hide it
  if (undefined(!!pos3d)) then
    pml load form !!pos3d
  endif

  -- Start
  if(!this.start.unset() and !this.end.unset()) then

    !this.startConn = !data.item
    !this.startPick = !data
    !this.start     = !data.position

    !!pos3d.hide()

    -- Setup form
    !this.setup()

  -- Redefine end on confirm
  elseif (!this.start.set()) then

    if (!data.item.neq(!this.startConn)) then
      !this.endConn = !data.item
    else
    	!this.endConn = object DBREF()
    endif

    if !!stlTolerances.minLengthLock.not() and !!stlTolerances.maxLengthLock then
      if !this.start.distance(!data.position) le !!stlTolerances.maxLength then
        !!pos3d.hide()
      endif
    elseif !!stlTolerances.minLengthLock and !!stlTolerances.maxLengthLock.not() then
      if !this.start.distance(!data.position) ge !!stlTolerances.minLength then
        !!pos3d.hide()
      endif
    elseif !!stlTolerances.minLengthLock and !!stlTolerances.maxLengthLock then
      if ((!this.start.distance(!data.position) ge !!stlTolerances.minLength) and (!this.start.distance(!data.position) lt !!stlTolerances.maxLength))then
        !!pos3d.hide()
      endif
    endif

    -- Check Length
    if(!!stlTolerances.length(!this.start.distance(!data.position)).not()) then
      !!alert.error(!!error.text)
      return
    endif

    -- Set end position
    !this.endPick   = !data
    !this.end       = !data.position

    -- Allow change and confirm
    if(!this.confirm.val) then
      !this.setup()

    -- Build Section
    else
      !this.acceptUndo()
    endif

  endif

endmethod
-- End of method definition for .define(EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      acceptUndo
--
-- Description: Implement UNDO for Accept (build section)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptUndo()

  !undoCreateSection = object UNDOABLE()
  !undoCreateSection.description('Create Sections')
  !undoCreateSection.undoAction('!!stlSection.undoEvent()')
  !undoCreateSection.redoAction('!!stlSection.undoEvent()')
  !undoCreateSection.add()

  !this.accept()
  handle any
    !!alert.error(!!error.text)
  endhandle

  !undoCreateSection.endUndoable()


endmethod
-- End of method definition for .acceptUndo

------------------------------------------------------------------------
--
-- Method:      undoEvent
--
-- Description: Handle undo and redo event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undoEvent()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif

  if (!this.stringType.selection() eq 'SINGLE') then
    -- no change to last position for single mode
    return
  endif

  !this.last     = object POSITION()
  !this.lastPick = object EDGPOSITIONDATA()
  !this.lastConn = object DBREF()

  -- reinitialise the form to reset last position
  !this.reDefine()

endmethod
-- End of method definition for .undoEvent

------------------------------------------------------------------------
--
-- Method:      accept
--
-- Description: Accept form data (build section)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accept()

  -- Initialise Variables
  !reference = !!ce

  -- Move to default creation store
  !!ce       = !this.store
  handle any
  endhandle

  -- Section Definition object
  !section = object STLSCTN()
  !section.setType(!this.type)

  -- Define start/end position
  !section.startPosition  = !this.start.wrt(World)
  !section.endPosition    = !this.end.wrt(World)

  -- Define Connections
  !section.attachConnect  = !this.nodes.val
  if(!this.type eq 'STWALL') then
    !section.freeConnect    = true
  elseif(undefined(!!appDesMain.node)) then
    !section.freeConnect    = true
  else
    !section.freeConnect    = !!appDesMain.node.val
  endif

  -- Creation Data
  !section.storeGroup     = !this.storeGroup
  !section.storeArea      = !this.storeArea

  -- get the storage area
  !store = !!getStorageArea(!this.storeGroup, !this.storeArea)
  if(!store.unset()) then
    !store = !!ce
  endif

  !section.store = !store

  if (!this.type.eq(|SCTN|) or !this.type.eq(|GENSEC|)) then

    -- Create new section
    !section.create()

    -- Set section specification
    if(!!appDesMain.prfl.val) then
      call !!strSectionData(!section.reference)

      -- Set GTYP of the Section
      var !gtyp (GTYP of CATR of SPREF)
      handle ANY
      elsehandle NONE
        !section.reference.gtyp = !gtyp
      endhandle

    endif

  elseif (!this.type.eq(|WALL|)) then
  	
  	!section.create()
  	
  	if (!!appDesMain.prfl.val) then
  		call !!strSectionData(!section.reference)
  		
  		-- Set GTYP of the Wall
  		var !gtyp (GTYP of CATR of SPREF)
      handle ANY
  	  elsehandle NONE
  		  !section.reference.gtyp = !gtyp
      endhandle
  		
   endif

  elseif (!this.type.eq(|STWALL|)) then
  	
  	-->>>>>>>>>>>> Define Data on "old" section creation form <<<<<<<<<<<<<
    !oldSectionForm = !!cdSctn
    !oldSectionForm.ref1.clear()
    !oldSectionForm.ref2.clear()
    !oldSectionForm.area.val  = !store.string()

    -- Start Picks
    !dText = ARRAY()
    if(!this.startPick.items.empty().not()) then
      -- Convert dbref into string
      do !i indices !this.startPick.items
        !dText.append(!this.startPick.items[!i].string())
      enddo
      !oldSectionForm.ref1.dText = !dText
    elseif (not !this.startPick.item.badref()) then
      !dText.append(!this.startPick.item.string())
      !oldSectionForm.ref1.dText = !dText
    endif

    -- End Picks
    !dText = ARRAY()
    if(!this.endPick.items.empty().not()) then
      -- Convert dbref into string
      do !i indices !this.endPick.items
        !dText.append(!this.endPick.items[!i].string())
      enddo
      !oldSectionForm.ref2.dText = !dText
    elseif (not !this.endPick.item.badref()) then
      !dText.append(!this.endPick.item.string())
      !oldSectionForm.ref2.dText = !dText
    endif

    -- Positions
    !oldSectionForm.pos1.val = !section.startPosition.string().before('WRT')
    !oldSectionForm.pos2.val = !section.endPosition.string().before('WRT')

    -- Settings
    !oldSectionForm.aflg.val = true
    !oldSectionForm.dflg.val = true
    !oldSectionForm.cflg.val = true
    !oldSectionForm.fflg.val = true
    !oldSectionForm.tflg.val = !!stlTolerances.trim
    !oldSectionForm.sflg.val = true
    !oldSectionForm.jflg.val = !!stlTolerances.jointDominant
    !oldSectionForm.vflg.val = false

    !oldSectionForm.type.val = !this.type

    -- Run section creation form
    call !!runSynonym('CALLSTL MSCTN')
    STWALL 1

    !section.reference = !!ce

  endif
  !startConnected = false
  !endConnected = false

  -- Only connect the sections when the user sets the connect toggle
  if (!this.nodes.val) then
  	!this.connManager.anglePriority()
  	!startComp = false
  	!endComp = false
    -- Connect start and end, once compatibility is checked
    if (not !this.startConn.badref()) then
      !startComp = !this.connManager.checkCompatible(!this.startConn)
    endif

    if (not !this.endConn.badref()) then
      !endComp   = !this.connManager.checkCompatible(!this.endConn)
    endif

    if (!startComp) then
      !startConnected = !this.connManager.connectSections('Start', !section.reference, !this.startConn)
    endif

    if (!endComp) then
      !endConnected = !this.connManager.connectSections('End', !section.reference, !this.endConn)
    endif
  endif
  -- Connect ends to PNODEs if not done already
  if (!section.freeConnect and not !startConnected ) then
      !startJoint = object DBREF()
      !!strPnodeCreate(!section.reference, 'START', !startJoint )
  endif
  if (!section.freeConnect and not !endConnected ) then
      !endJoint = object DBREF()
      !!strPnodeCreate(!section.reference, 'END', !endJoint )
  endif

  -- Reset using string method types
    !this.lastConn  = !this.endConn
  -- Single
  if(!this.stringType.selection() eq 'SINGLE') then
    !this.last      = !this.end
    !this.lastPick  = !this.endPick
    !this.startConn = object DBREF()
    !this.endConn   = object DBREF()

    !this.start     = object POSITION()
    !this.end       = object POSITION()
    !this.startPick = object EDGPOSITIONDATA()
    !this.endPick   = object EDGPOSITIONDATA()

  -- Continuous
  elseif (!this.stringType.selection() eq 'CONTINUOUS') then
    !this.last      = !this.end
    !this.lastPick  = !this.endPick
    !this.startConn = !this.endConn
    !this.endConn   = object DBREF()

    !this.start     = !this.end
    !this.end       = object POSITION()
    !this.startPick = !this.endPick
    !this.endPick   = object EDGPOSITIONDATA()

  -- Radial
  else
    !this.last      = !this.end
    !this.lastPick  = !this.endPick
    !this.endConn   = object DBREF()

    !this.end       = object POSITION()
    !this.endPick   = object EDGPOSITIONDATA()

  endif

  -- Setup form
  !this.setup()

  -- Return to where we came from
  !!ce = !reference

endmethod
-- End of method definition for .accept()

------------------------------------------------------------------------
--
-- Method:      reject
--
-- Description: Reject end position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reject()

  -- Initialise End
  !this.end       = object POSITION()
  !this.endPick   = object EDGPOSITIONDATA()

  -- Setup form
  !this.setup()

endmethod
-- End of method definition for .reject()

------------------------------------------------------------------------
--
-- Method:      stringType
--
-- Description: Set of stringing type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stringType()

  -- to enable switching from Single mode to Continuous mode
  if (!this.stringType.selection() inset('CONTINUOUS','RADIAL') and !this.start.unset() and !this.end.unset()) then

    !this.start       = !this.last
    !this.startPick   = !this.lastPick
    if( not badref(!this.lastConn) ) then
      !this.startConn = !this.lastConn
    endif

    -- Setup form
    !this.setup()

    -- to enable switching from Continuous mode to Single mode
  elseif (!this.stringType.selection() eq 'SINGLE') then

    !this.reDefine()

  endif

endmethod
-- End of method definition for .stringType()

------------------------------------------------------------------------
--
-- Method:      explicit
--
-- Description: Explicit end definition form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .explicit()

  -- Start
  if(!this.start.unset() and !this.end.unset()) then
    !this.promptEnd = ' start'
    !prompt         = !this.prompt & !this.promptEnd
    !end            = 'Start'

    if(!this.last.unset()) then
      !position     = N0
    else
      !position     = !this.last
    endif

  -- Redefine end on confirm
  elseif (!this.start.set()) then
    !this.promptEnd = ' end'
    !prompt         = !this.prompt & !this.promptEnd
    !end            = 'End'

    if(!this.end.unset()) then
      !position     = !this.start
    else
      !position     = !this.end
    endif
  endif

  -- Show standard basic position definition
  !!pos3D.edit('!!stlSection.define(!!pos3D.positionData())', !position, !prompt, !end, false, !this.edgDescription)

endmethod
-- End of method definition for .explicit()

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset end form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset()

  -- Load associated form, if not loaded
  if(undefined(!!pos3DOffset)) then
    pml reload form !!pos3DOffset
  endif

  -- Start
  if(!this.start.unset() and !this.end.unset()) then
    !this.promptEnd = ' start'
    !prompt         = !this.prompt & !this.promptEnd
    !end       = 'Start'
    !position  = N0
    !reference = N0

  -- Redefine end on confirm
  elseif (!this.start.set()) then
    !this.promptEnd = ' end'
    !prompt         = !this.prompt & !this.promptEnd
    !end      = 'End'
    !position = !this.start

     if(!this.end.unset()) then
      !position  = !this.start
      !reference = !position
    else
      !position  = !this.end
      !reference = !this.start
    endif

  endif

  -- Show standard basic position definition
  !!pos3DOffset.edit('!!stlSection.define(!!pos3DOffset.positionData())', !reference, !position, !prompt, !end, false, !this.edgDescription)

endmethod
-- End of method definition for .offset()

------------------------------------------------------------------------
--
-- Method:      perpendicular
--
-- Description: Create section perpendicular from/to start
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of perpendicular pick from or to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .perpendicular(!type is STRING)

  -- Initialise Variables
  !this.perpendicular = !type.upcase()

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick straight Section/Wall to derive perpendicular '  & !type & !this.promptEnd)
  !packet.key            = 'STLWRK'
  !packet.description    = !this.edgDescription
  !packet.type           = 'STLWRK'
  !packet.priority       = 1
  !packet.close          = '!!stlSection.setActive(true)'
  !packet.action         = '!!stlSection.perpendicular(!this.return[1])'
  !packet.remove         = true
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE eq |SCTN|'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

  -- Grey out section form
  !this.setActive(false)

endmethod
-- End of method definition for .perpendicular(STRING)

------------------------------------------------------------------------
--
-- Method:      perpendicular
--
-- Description: Calculate the position for the current perpendicular setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Picked data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .perpendicular(!data is EDGPICKDATA)

  -- Initialise Variables
  !perpendicular      = !this.perpendicular
  !this.perpendicular = STRING()
  !positionData       = !data.positionData()

  -- Grey out section form
  !this.setActive(true)

  -- Get line of picked element
  !positionData.line()

  -- If there is no Line then given an error
  if(!positionData.line.unset()) then
    !!alert.warning('Unable to derive line from picked element.')
    return
  endif

  -- We must always be defining the "end" of the section, there for
  -- we need to get the start definition
  !this.startPick.line()

  -- Check first pick can be converted into a line
  if(!this.startPick.line.unset()) then
    !!alert.warning('Unable to derive line from "start" picked element.')
    return
  endif

  -- Perpendicular "FROM"
  if (!perpendicular eq 'FROM') then

    -- Define plane through the position on the first item
    !orientation           = object ORIENTATION('Z is ' & !this.startPick.line.direction() & ' and Y is U')
    handle any
      !orientation         = object ORIENTATION('Z is ' & !this.startPick.line.direction() & ' and Y is N')
    endhandle
    !plane                 = object PLANE(!this.start, !orientation)

    -- Get intersection
    !positionData.position = !plane.intersection(!positionData.line)
    handle any
      !!alert.warning('Unable to derive position.')
      return
    endhandle

  -- Perpendicular "TO"
  else
    !positionData.position = !positionData.line.near(!this.start)
  endif

  !this.define(!positionData)

endmethod
-- End of method definition for .perpendicular(EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      switchType
--
-- Description: Switch type event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Form gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .switchType(!gadget is GADGET, !dummySel is STRING)

  if (!gadget.val) then
  	if (!this.type.eq(|STWALL|)) then
  		!this.type = 'WALL'
  	elseif (!this.type.eq(|SCTN|)) then
  		!this.type = 'GENSEC'
  	endif
  elseif (!gadget.val.not()) then
  	if (!this.type.eq(|WALL|)) then
  		!this.type = 'STWALL'
  	elseif (!this.type.eq(|GENSEC|)) then
  		!this.type = 'SCTN'
  	endif
  endif

endmethod
-- End of method
