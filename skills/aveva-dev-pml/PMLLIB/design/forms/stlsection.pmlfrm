--
--
-- Description:
-- Section creation/definition form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accept()                         -                   Accept form data (build section)
--  acceptUndo()                     -                   Implement UNDO for Accept (build section)
--  close()                          -                   Close form
--  create(STRING,STRING,STRING,STRING,STRING) -                   Display form with passed data
--  createGensec()                   -                   Create Gensec
--  createSctn()                     -                   Create Standard section (SCTN)
--  createWall()                     -                   Create Wall
--  define(EDGPOSITIONDATA)          -                   Redefine start position
--  explicit()                       -                   Explicit end definition form
--  offset()                         -                   Offset end form
--  perpendicular(EDGPICKDATA)       -                   Calculate the position for the current perpendicular setting
--  perpendicular(STRING)            -                   Create section perpendicular from/to start
--  reDefine()                       -                   Redefine start position
--  reject()                         -                   Reject end position
--  setup()                          -                   Setup form
--  stlSection()                     -                   Constructor
--  stringType()                     -                   Set of stringing type
--  switchType(GADGET,STRING)        -
--  undoEvent()                      -                   Handle undo and redo event
--
------------------------------------------------------------------------

setup form !!stlSection

  !!stlSection.formTitle     = 'Section'
  !!stlSection.iconTitle     = 'Define Section'
  !!stlSection.callback      = ''
  !!stlSection.formRevision  = ' $Revision: 1.22 $ '

  -- Body of form definition

  -- String Method
  rgroup .stringType 'String Method' at xmin y0.2 callback '!this.stringType()' frame vertical
    add tag ' Single'      select 'SINGLE'
    add tag ' Continuous'  select 'CONTINUOUS'
    add tag ' Radial'      select 'RADIAL'
  exit

  -- Creation Option
  frame .createFrame  'Create Option' at xmin ymax width 23
    hdist 0
    toggle .nodes     'Secondary Nodes?' at x2 ymax states 'false' 'true'
    button .explicit at x1 ymax pix width 24 height 24 tooltip 'Define start/end explicitly'                          callback '!this.explicit()'
    button .offset              pix width 24 height 24 tooltip 'Define end a given distance and direction from start' callback '!this.offset()'
    button .perpFrom            pix width 24 height 24 tooltip 'Perpendicular from' callback '!this.perpendicular(''from'')'
    button .perpTo              pix width 24 height 24 tooltip 'Perpendicular to'   callback '!this.perpendicular(''to'')'
    toggle .gensec    'Create As GENSEC' at x2 ymax callback '!this.switchType(' states 'false' 'true'
  exit

  -- Verification
  frame .confirmFrame 'Verification' at xmin ymax width 23
    toggle .confirm   'Confirm'  at x2     ymax callback '!this.setup()' states 'false' 'true'
    button .accept    'Accept'   at xmax+1 ymin callback '!this.acceptUndo()'
    button .reject    'Reject'   at xmin   ymax callback '!this.reject()'
    halign right
    path down
    button .reDefine 'Redefine Start'           callback '!this.reDefine()'
  exit

  -- Dismiss
  button .dismiss 'Dismiss' callback '!this.close()' ok

  -- Form Members

  -- Positions
  member .start        is POSITION
  member .end          is POSITION
  member .last         is POSITION

  -- Pick Data
  member .startPick    is EDGPOSITIONDATA
  member .endPick      is EDGPOSITIONDATA
  member .lastPick     is EDGPOSITIONDATA

  -- Aid Number
  member .aidNumber    is REAL

  -- Creation Data
  -- Element Type
  member .type         is STRING
  -- Storage Group
  member .storeGroup   is STRING
  -- Store Area
  member .storeArea    is STRING
  -- Storage Area, by name
  member .store        is DBREF

  -- Perpendicular flag
  member .perpendicular  is STRING

  -- Edg Packet description
  member .edgDescription is STRING

  -- Edg Prompt
  member .prompt       is STRING
  member .promptEnd      is STRING

  -- Connection points
  member .startConn   is DBREF
  member .endConn     is DBREF
  member .lastConn    is DBREF
  member .connManager is SECTIONCONNECTIONMANAGER

exit
-- End of form definition for !!stlSection

------------------------------------------------------------------------
--
-- Method:      stlSection
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlSection()

  --  Icons
  !this.explicit.addPixmap(!!pml.getPathName('xyz24.png'))
  !this.offset.addPixmap(!!pml.getPathName('distancedirection24.png'))
  !this.perpFrom.addPixmap(!!pml.getPathName('perpendicularfrom24.png'))
  !this.perpTo.addPixmap(!!pml.getPathName('perpendicularto24.png'))

  -- Default of create nodes
  !this.nodes.val = true

  -- Default of create gensec
  !this.gensec.val = false
  !this.gensec.visible = false

  -- Aid number
  !this.aidNumber = !!aidNumbers.add('Create Section')

  -- Check that pos3d form has been defined
  if (undefined(!!pos3d)) then
    pml load form !!pos3d
  endif

endmethod
-- End of method definition for .stlSection()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Grey out relevant gadgets
  !this.confirm.active    = true
  !this.accept.active     = false
  !this.reject.active     = false

  if(!this.start.unset() and !this.end.unset()) then
    !this.reDefine.active   = false
    !this.offset.active     = false
    !this.perpFrom.active   = false
    !this.perpTo.active     = false
    !this.promptEnd         = ' start'

    -- Modify prompt string
    !!edgCntrl.setStackPrompt(!this.edgDescription, !this.prompt & !this.promptEnd)


  -- Un-grey relevant gadgets
  elseif (!this.start.set() and !this.end.unset()) then
    !this.reDefine.active   = true
    !this.offset.active     = true
    !this.promptEnd         = ' end'

    -- If start element can be converted into a line, then we will allow perpendiculars to be used
    !line = !this.startPick.getLine()
    if(!line.set()) then
      !this.perpFrom.active = true
      !this.perpTo.active   = true
    endif

    -- Modify prompt string
    !!edgCntrl.setStackPrompt(!this.edgDescription, !this.prompt & !this.promptEnd)

  elseif (!this.start.set() and !this.end.set()) then

    if(!this.confirm.val) then
      !this.accept.active   = true
      !this.reject.active   = true
      !this.confirm.active  = false
    endif

  endif

  -- Remove previous definition
  !!aidNumbers.hide(!this.aidNumber)

  -- Draw Definition
  if(!this.start.set()) then
    AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<this.start>
  endif

  -- Draw Definition
  if(!this.end.set()) then
    AID TEXT NUMBER $!<this.aidNumber> 'End' AT $!<this.end>
  endif

  -- Draw Definition
  if(!this.start.set() and !this.end.set()) then
    AID LINE NUMBER $!<this.aidNumber> $!<this.start> TO $!<this.end>
  endif

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      createSctn
--
-- Description: Create Standard section (SCTN)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSctn()

  -- Edit as standard section creation
  !this.create('Section', 'SCTN', 'BANDC', 'SECTION', 'Define section')

endmethod
-- End of method definition for .createSctn()

------------------------------------------------------------------------
