--    Type:          Form Definition
--    Group:         EQUI
--      Keyword:     EQUI
--    Module:        DESIGN
--
--  Created:         Tue Mar 18 17:13:45 2008
--
--  Description:     Choose form for stand-alone fixing elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actions(GADGET,STRING)           -                   Gadget callback actions for main form
--  change()                         -                   Set spref of design element to selected table item
--  changeUserType()                 -                   Callback if UDET is changed
--  chooseEdit(DBREF,BOOLEAN)        -                   Choose matching table items from selection table
--  chooseNew()                      -
--  clearSelection()                 -                   Reinitialise selection gadgets
--  clearView()                      -                   Clear the 3D view
--  close()                          -                   Close form down
--  coordinateSettings()             -                   Setting the format of positional gadgets according to present coordinate system.
--  create()                         -                   Create new FIXING element
--  createAction()                   -                   Callback to create a Design instance of the selected element
--  createUndoRedo()                 -                   Put form in safe state on undo & redo
--  dataGridOnPopup(ARRAY)           -
--  drawOrigin(DBREF,REAL)           -                   Draw origin
--  feedback()                       -                   Draw rotation axes
--  findOwner(DBREF)                 DBREF               Climb to SBFR or FRMW
--  firstShown()                     -                   Actions when form is shown for the first time
--  getUserType()                    STRING              Returns UDET if a UDET has been selected
--  initSelTableList()               -                   Initialise selection table option list
--  initSelTypeList()                -                   Initialise selection type option list
--  initTable(BOOLEAN)               -                   Initialise the selection table
--  initialise()                     -                   Form initialisation for create mode
--  initialise(DBREF)                -                   Form initialisation for modification of existing element
--  initialiseProperties(DBREF)      -                   Initialise properties for selected catalogue item
--  initialiseTables()               -                   Initialise table selection gadgets
--  madeSelection(DBREF)             -                   After select event
--  manageFrames(REAL)               -                   Manage the visibility of the create & modify frames
--  netAfterSelect(ARRAY)            -                   .net control After select event handler
--  next()                           -                   Reinitialise the form for the next create operation
--  packetClose()                    -                   Tidy up after EDG close
--  positionDone(ARRAY)              -                   Set FIXING position to given position
--  selectTableItem()                -                   Programmatically select from selection table
--  setPosition()                    -                   Set FIXING position from position control data
--  setPosition(EDGPOSITIONDATA)     -                   Set FIXING position from position control data
--  setWrt()                         -                   Callback for WRT field
--  stlStandAloneFixing()            -                   Constructor
--  tableSelect(ARRAY)               -                   After select event for .net control
--  tidy()                           -                   Tidy up aid graphics
--  updateTables()                   -
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle
import 'PositionControl'
handle ANY
endhandle
--- form definition
setup form !!stlStandAloneFixing dialog docking

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Grid control members
  member .netSelTabItems   is NETGRIDCONTROL

  member .posControl is POSITIONCONTROL
  -- Other members
  -- New element name
  member .newItemName      is STRING
  -- List of selection tables
  member .selTables        is ARRAY
  -- Selected selection table
  member .selectedSelTab   is SELECTIONTABLE
  -- Selection data object
  member .tableChooseData  is STCHOOSEDATA
  -- Properties data object
  member .comProp          is COMPROP

  -- Questions and answers
  member .choices          is ARRAY
  member .selectedItem     is DBREF

  -- Element currently being edited
  member .editElement      is DBREF
  -- Location (owner) of new or modified element
  member .ownerElement     is DBREF
  -- edit (2) or create (1) mode
  member .mode             is REAL
  -- Position control
  member .positionData         is EDGPOSITIONDATA

  -- Aid numbers for axes when created and on form
  member .aidAxes          is REAL
  member .aidNumber        is REAL

  -- EDG packet description for positioning
  member .packetDesc       is STRING
  -- Drawlist token for local 3D view
  member .drawlist         is REAL

  path down
  frame .topPart panel anchor all at x0 y0
    -- Create form header
    frame .frCreate panel anchor top + left + right width 50
      option .opAutoName  at xmin form ymin width 10
      text   .txName      anchor top + left + right at xmax.opAutoName+2 ymin.opAutoName width 30 is STRING
    exit

    -- Modify form header
    frame .frModify panel anchor top + left + right at xmin.frCreate ymin.frCreate width 50
      button .bnCe 'CE'   at xmin ymin
      para   .paCeName    anchor top + left + right at xmax.bnCe+2 ymin.bnCe text '' width 35
    exit

    -- UDET Type
    --option .udets         anchor left + top 'Purpose'  at xmin.frCreate ymax tagwidth 14 width 20
    --option .purpose        anchor left + top 'Purpose'  at xmin form ymax  callback '!this.updateTables()' tagwidth 8 width 20
    --toggle .tgDefault tagwid 6 'Default' at xmax+1 ymin

    -- Selection groups and tables
    option .opSelTables at xmin form tagwid 8 '' anchor left + right + top width 35
    option .opSelTypes               tagwid 8 '' anchor left + right + top width 35

    -- PML container to host .NET grid control
    container .conSelTabItems nobox PmlNetControl 'Table items' anchor all at xmin form ymax width 50 height 15
  exit

  -- line to cause vertical scroll on form
  line .scrollLine      at x30 y20 vert  width 0.1 heigh 0.1
  line .btLine          anchor left + right + bottom at x0 ymax.conSelTabItems horiz  width 50 heigh 0.4

  -- 3D view
  frame .frView3D panel anchor left + right + bottom at x0 ymax        width 30 height 8
    view .vwView3D volume
    exit
  exit

  -- Positioning Gadgets

  frame .positionFrame 'Component Position wrt World'      anchor left + right + bottom  at x0  ymin.frView3D width 30 hei 5
    container .netPositionFrame NOBOX PMLNetCONTROL 'NET' dock fill
  exit

  button .bnProperties anchor bottom + right 'Properties...' at xmax form-size ymin.frView3D+0.25   width 12
  button .bnPlotfile   anchor bottom + right 'Plotfile...'   at xmax form-size ymax+0.25          width 12

  button .bnApply      anchor bottom + right 'Insert'        at xmax form-size ymax+0.25          width 12
  button .bnNext       anchor bottom + right 'Apply'          at xmax form-size ymax+0.25          width 12
  button .bnChange     anchor bottom + right 'Apply'         at xmin           ymin              width 12

  menu .popupMenu
  !this.popupMenu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.netSelTabItems, ||, |Save As|)' )
  !this.popupMenu.add( 'callback', 'Print Preview...', '!this.netSelTabItems.printpreview()' )

exit

------------------------------------------------------------------------
--
-- Method:      stlStandAloneFixing
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stlStandAloneFixing()

  -- Form details
  !this.iconTitle      = 'ChFix'
  !this.initCall       = '!this.initialise()'
  !this.cancelCall     = '!this.close()'
  !this.firstShownCall = '!this.firstShown()'

  -- Set auto-scroll
  !this.autoScroll      = true

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Create grid control objects
  !this.netSelTabItems  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  !this.netSelTabItems.addEventHandler('OnPopup', !this, 'dataGridOnPopup')
  !this.netSelTabItems.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')
  -- Set grid properties
  !this.netSelTabItems.fixedHeaders(false)
  !this.netSelTabItems.fixedRows(false)
  !this.netSelTabItems.outlookGroupStyle(true)
  !this.netSelTabItems.columnExcelFilter(true)
  !this.netSelTabItems.headerSort(true)
  !this.netSelTabItems.columnSummaries(false)
  !this.netSelTabItems.singleRowSelection(true)
  !this.netSelTabItems.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.conSelTabItems.control = !this.netSelTabItems.handle()

  -- Set autoName option text
  !dText[1]              = |Name|
  !dText[2]              = |Autoname|
  !rText[1]              = |NAME|
  !rText[2]              = |AUTO|
  !this.opAutoName.dText = !dText
  !this.opAutoName.rText = !rText

  -- Callbacks
  !this.opAutoName.callback   = |!this.actions(|
  !this.txName.callback       = |!this.actions(|
  !this.bnCe.callback         = |!this.actions(|
  !this.opSelTables.callback  = |!this.actions(|
  !this.opSelTypes.callback   = |!this.actions(|
  !this.bnProperties.callback = |!this.comProp.editProperties()|
  !this.bnPlotfile.callback   = |!this.comProp.displayPlot()|
  !this.bnApply.callback      = |!this.createAction()|
  !this.bnNext.callback       = |!this.next()|
  !this.bnChange.callback     = |!this.change()|

  -- 3D view / local drawlist
  !this.vwView3D.shaded = true
  !viewDir[1]    = 0.57735
  !viewDir[2]    = 0.57735
  !viewDir[3]    = -0.57735
  !this.vwView3D.direction = !viewDir
  !this.drawlist = !!gphDrawlists.createDrawList()

  -- Default to create mode
  !this.mode        = 1

  -- configure specification table gadgets
  !this.tableChooseData.clearData()
  !this.tableChooseData.setTitle(|Component|)

  -- Element type to create
  !this.tableChooseData.setData(|FIXING|,'STFX','STFX')

  !this.initialiseTables()

using namespace 'Aveva.Pdms.presentation'
!this.posControl  = object POSITIONCONTROL()

-- Load ship grid data
!grid                   = object SHIPGRID()
!gridDefined            = !grid.position.set()

-- Only populate the grid data if a ship reference grid is available
if(!gridDefined) then

  do !i indices !grid.xID
    !xGridData[!i][1]     = !grid.xID[!i]
    !xGridData[!i][2]     = !grid.xOffset[!i]
  enddo

  do !i indices !grid.yID
    !yGridData[!i][1]     = !grid.yID[!i]
    !yGridData[!i][2]     = !grid.yOffset[!i]
  enddo

  do !i indices !grid.zID
    !zGridData[!i][1]     = !grid.zID[!i]
    !zGridData[!i][2]     = !grid.zOffset[!i]
  enddo

  -- Set grid data
  !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

  -- Initialise as grid control and Specify tags
  !this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

  -- Set position column heading
  !this.posControl.heading('World Position')
endif

!this.coordinateSettings()

!this.netPositionFrame.control = !this.posControl.handle()

!this.posControl.changeAction('!!stlStandAloneFixing.setPosition()')

!this.aidNumber = !!aidNumbers.add('InsertStructurePart')

  -- Aid number for created item
  !this.aidAxes   = !!aidNumbers.add('FIXINGAXES')
  -- Aid number for preview view on form
  !this.aidNumber = !!aidNumbers.add('InsertFixing')

endmethod
-- End of method definition for .stlStandAloneFixing()

------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Actions when form is shown for the first time
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.vwView3D)

  -- Add 3D view to local draw list
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3D)

endmethod
-- End of method definition for .firstShown()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Form initialisation for modification of existing element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Must be the DBREF of an FIXING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!element is DBREF)

  if(badref(!element)) then
    return error 1 |Component not found. Please select a valid component|
  endif

  if(!element.hardType neq 'FIXING') then
    return error 1 |The element selected is not a Fixing|
  endif

  -- Set modify mode
  -- Initialise properties
  !this.comProp      = object COMPROP(!element)
  -- Initialise selection table controller
  !this.tableChooseData.setData(!element,|STFX|,|STL|,|STFX|)

  -- Show modify frame
  !this.manageFrames(!this.tableChooseData.mode)
  !this.editElement  = !element
  !this.ownerElement = !element.owner

  -- Initialise Table part of the form
  !this.initialiseTables()
  -- pre-select this element in the table
  !this.selectTableItem()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Form initialisation for create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Initialise common parts of the form
  !this.editElement  = object DBREF()
  !this.ownerElement = object DBREF()

  -- Put form into initial create state
  !this.manageFrames(1)

  -- Initialise Table part of the form
  --!this.initialiseTables()

  -- Initialise the selected type
  !this.initTable(false)

  -- Select first row in the list - fires select callback
  !this.netSelTabItems.selectRow(1)
  handle any
  endhandle

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      initialiseTables
--
-- Description: Initialise table selection gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseTables()

  -- Set form title and list tags
  !this.formTitle       =  'Create Fixing'
  !this.opSelTables.tag = !this.tableChooseData.tableTag
  !this.opSelTypes.tag  = !this.tableChooseData.typeTag

  -- Set selection tables
  !this.selTables = !this.tableChooseData.getSelTabs()

  -- Populate the table list
  !this.initSelTableList()

  -- Populate the type list
  !this.initSelTypeList()

endmethod
-- End of method definition for .initialiseTables()

------------------------------------------------------------------------
--
-- Method:      initSelTableList
--
-- Description: Initialise selection table option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTableList()

  if (!this.selTables.size() gt 0) then
    if( !this.opSelTables.val eq 0 or !this.opSelTables.val gt !this.selTables.size() ) then
      !selectionTableIndex = 1
    else
      !selectionTableIndex = !this.opSelTables.val
    endif
    -- Populate table group option list
    !dText = !this.selTables.evaluate(object BLOCK(|!this.selTables[!evalIndex].name|))
    !this.opSelTables.dText = !dText
    !this.opSelTables.val   = !selectionTableIndex
    -- Set selected table
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!selectionTableIndex])
  else
    -- Set list for none
    !dText[1] = 'None'
    !this.opSelTables.dText = !dText
    -- Unset selected table group
    !this.selectedSelTab = object SELECTIONTABLE()
  endif

endmethod
-- End of method definition for .initSelTableList()

------------------------------------------------------------------------
--
-- Method:      initSelTypeList
--
-- Description: Initialise selection type option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTypeList()

  if (!this.selTables.size() gt 0) then

    -- Get types for selected table
    !types = !this.selectedSelTab.getTypes()

    -- Populate type list
    if (!types.set()) then
      !this.opSelTypes.dText = !types

      -- Select specified table type
      if (!this.tableChooseData.tableType.set()) then
        -- Get type index for specified type
        !typeIndex = REAL()
        do !ind indices !types
          if (!types[!ind].trim().upcase() eq !this.tableChooseData.tableType) then
            !typeIndex = !ind
            break
          endif
        enddo
        -- Select table type in option list and selectionTable object
        if (!typeIndex.set()) then
          !this.opSelTypes.val = !typeIndex
        else
          !!alert.warning(|Invalid table type specified in !this.tableChooseData global object. The first type in the table will be selected!|)
        endif
      endif

    else
      !dText[1] = 'None'
      !this.opSelTypes.dText = !dText
    endif

  else

    -- Set list for none
    !dText[1] = 'None'
    !this.opSelTypes.dText = !dText

  endif

endmethod
-- End of method definition for .initSelTypeList()

------------------------------------------------------------------------
--
-- Method:      initTable
--
-- Description: Initialise the selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Pre-select current design item if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTable(!preSelect is BOOLEAN)

  -- Clear 3D view
  !this.clearView()

  -- Show choose list
  if (!this.opSelTypes.selection() ne 'None') then
  	if !this.opSelTypes.val.eq(0) then
  		!this.opSelTypes.val = 1
  	endif
    !this.selectedSelTab.setType(!this.opSelTypes.val)
    if( !this.mode eq 1 ) then
      -- new selection
      !this.chooseNew()
    else
      -- edit
      !this.chooseEdit(!this.tableChooseData.getDesignItem(), !preSelect)
    endif
  else
    -- Clear choose list - note causes selection callback
    !this.netSelTabItems.clearGrid()
  endif

endmethod
-- End of method definition for .initTable()

------------------------------------------------------------------------
--
-- Method:      clearView
--
-- Description: Clear the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearView()

  -- Clear 3D view
  if (!this.drawlist.set()) then
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    !this.vwView3D.active = false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearView
--
-- Description: Clear the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dataGridOnPopup(!data is ARRAY)
  !this.conSelTabItems.popup = !this.popupMenu
  !this.conSelTabItems.showPopup(!data[0], !data[1])
endmethod

------------------------------------------------------------------------
--
-- Method:      selectTableItem
--
-- Description: Programmatically select from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectTableItem()

  -- find selection table for current design element
  !cTable       = !this.tableChooseData.getItemSelectionTable()
  if( !cTable.unset() ) then
    return
  endif
  !typeName     = !cTable.description
  !tableGroup   = !cTable.owner
  !tableName    = !tableGroup.name

  -- select table from table list
  !this.opSelTables.select('RTEXT',!tableName)
  handle any
    return
  endhandle
  !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
  !this.initSelTypeList()

  -- select type from type list
  !this.opSelTypes.select('RTEXT',!typeName)
  handle any
    return
  endhandle

  -- initialise selection table and pre-select for current design item
  !this.initTable(true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      actions
--
-- Description: Gadget callback actions for main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actions(!object is GADGET, !action is STRING)

  -- Autoname option
  if (!object eq !this.opAutoName and !action eq |SELECT|) then
    if (!this.opAutoName.selection() eq |NAME|) then
      !this.newItemName = object STRING()
      !this.txName.clear()
      !this.txName.active = true
    elseif (!this.opAutoName.selection() eq |AUTO|) then
      !this.txName.val = ''
      !this.txName.active = false
    endif

  -- Name text field
  elseif (!object eq !this.txName and !action eq |SELECT|) then
    -- Check for valid name
    !name = !!checkName(!this.txName.val, |NEW|)
    -- Set name field
    if (!name.set()) then
      -- Set new name
      !this.newItemName = !name
      !this.txName.val = !this.newItemName
    else
      -- Restore stored name
      !this.txName.val = !this.newItemName
    endif

  -- CE button
  elseif (!object eq !this.bnCe and !action eq |SELECT|) then
    !this.initialise(!!ce)

  -- Table group option list
  elseif (!object eq !this.opSelTables and !action eq |SELECT|) then
    if (!this.opSelTables.selection() eq 'None')then
      !!alert.warning('No selection tables available for Fixing components')
    else
      !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
      !this.initSelTypeList()
      !this.initTable(true)
    endif

  -- Selection table option list
  elseif (!object eq !this.opSelTypes and !action eq |SELECT|) then
    !this.initTable(true)

  endif

endmethod
-- End of method definition for .actions()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseNew()

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  !questions = ARRAY()
  !answers   = ARRAY()
  !userType  = !this.getUserType()
  if( !userType neq 'ALLTYPES' ) then
    !questions[1] = 'TYPE'
    !answers[1]   = !userType
  endif

  if (!questions.empty()) then
    !choiceItems = !this.selectedSelTab.choose(object DBREF(), |TEXT|, FALSE)
  else
    !choiceItems = !this.selectedSelTab.choose(object DBREF(), !questions, !answers, |TEXT|, FALSE)
  endif

  -- Save choices
  !this.choices.clear()
  do !ind indices !choiceItems
    !this.choices.append(!choiceItems[!ind].removeFirst())
  enddo

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()
  !this.netSelTabItems.resetColumnProperties()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)

  -- Select matching item in the list
  if( !choiceItems.size() gt 0 ) then
    !this.netSelTabItems.selectRow(1)
  endif

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      chooseEdit
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design item DBREF
--    2   R      BOOLEAN     Pre-select item if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseEdit(!designItem is DBREF, !preSelect is BOOLEAN)

  -- set up pre-select if required
  if( badref(!designItem) ) then
    return error 1 |Invalid design element|
  endif

  -- set reference of TABITEM if pre-selection required
  if( !preSelect ) then
    !selectItem   = !designItem.spref
  else
    !selectItem   = object DBREF()
  endif

  -- get user defined element type of this element
  !userType       = !designItem.actType
  if( !userType.subString(1,1) eq ':' ) then
    !userType     = !userType.subString(2)
  endif
  !questions      = ARRAY()
  !answers        = ARRAY()
  !questions[1]   = 'TYPE'
  !answers[1]     = !userType

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  !choiceItems = !this.selectedSelTab.choose(!designItem, !questions, !answers, |TEXT|, FALSE)

  -- Save choices
  !this.choices.clear()
  do !ind indices !choiceItems
    !this.choices.append(!choiceItems[!ind].removeFirst())
  enddo

  -- find pre-select item
  if( badref( !selectItem ) ) then
    !matchItemIndex = 0
  else
    !matchItemIndex = !this.choices.findFirst(!selectItem)
    if( !matchItemIndex.unset() ) then
      -- make sure that item is not filtered out by UDET
      !questions      = ARRAY()
      !answers        = ARRAY()
      -- Get choice from selection table (answer data types converted to text)
      !extraItems = !this.selectedSelTab.choose(!designItem, !questions, !answers, |TEXT|, FALSE)
      -- extract choices from results
      !extraChoice    = ARRAY()
      -- get array of chosen items
      do !ind indices !extraItems
        !extraChoice.append(!extraItems[!ind].removeFirst())
      enddo
      !matchItemIndex = !extraChoice.findFirst(!selectItem)
      if( !matchItemIndex.unset() ) then
        -- item still not found in this table
        !matchItemIndex = 0
      else
        -- item found - must be different type
        !choiceItems.insert(1, !extraItems[!matchItemIndex])
        !this.choices.insert(1, !selectItem)
        !matchItemIndex = 1
      endif
    endif
  endif

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()
  !this.netSelTabItems.resetColumnProperties()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)

  -- Select matching item in the list
  if( !matchItemIndex gt 0 ) then
    !this.netSelTabItems.selectRow(!matchItemIndex)
  endif

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      clearSelection
--
-- Description: Reinitialise selection gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearSelection()

  !mode = !this.mode
  !this.manageFrames(!mode)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      madeSelection
--
-- Description: After select event
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selected item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .madeSelection(!selectedItem is DBREF)

  -- only allow create button in create mode
  !this.bnApply.active  = ( !this.mode eq 1 )

  -- show selection in 3D view
  !!gphViews.limits(!this.vwView3D, !selectedItem)
  !drawlist             = !!gphDrawlists.drawlist(!this.drawlist)
  !drawlist.add(!selectedItem)
  !this.vwView3D.active = true
  !this.drawOrigin(!selectedItem, !this.aidNumber)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialiseProperties
--
-- Description: Initialise properties for selected catalogue item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selected item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseProperties(!selectedItem is DBREF)

  !this.comProp.initialise(!selectedItem)
  handle any
    !this.bnPlotfile.active = false
    !this.bnPlotfile.active   = false
  elsehandle none
    !this.comProp.editFormBlockOwn(true)
    !this.comProp.autoCacheValues(true)
    !this.bnPlotfile.active = true
    !this.bnPlotfile.active   =!this.comProp.checkPlot()
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .createAction()
--
-- Description: Callback to create a Design instance of the selected element
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .createAction()

  -- find a point where stand-alone fixing can be created
  !this.ownerElement          = !!dtbFindOwnerOfType(!!ce,'SBFR',false)
  if( !this.ownerElement.unset() ) then
    !this.ownerElement          = !!dtbFindOwnerOfType(!!ce,'FRMW',false)
    if( !this.ownerElement.unset() ) then
      !!alert.error('Stand-alone Fixing cannot be created at this level in the database, current element must be framework (FRMW) or below')
      return
    endif
  endif

  -- set state of form to move into the second phase of create
  !this.frView3D.visible      = false
  !this.positionFrame.visible = true
  !this.bnApply.active        = false
  !this.bnNext.active         = true
  !this.topPart.active        = false
  !this.bnProperties.active   = false

  -- create the new FIXING
  !this.create()

  -- set position gadget
  if(badref(!this.editElement)) then
    !this.position.setPositionNoAct(!this.ownerElement.position)
    !this.position.setWrt(!this.ownerElement)
    -- Set gadget with name of item
    !this.wrt.val = !this.ownerElement.name
  else
     !this.posControl.xyz(!this.editElement.position.east.string('D6').real(), !this.editElement.position.north.string('D6').real(), !this.editElement.position.up.string('D6').real())
  endif

  -- Define EDG positional pick


  !this.packetDesc       = 'Fixing Component Origin'
  !prompt                = 'Create Fixing - Select Fixing Position'
  !packet                = object EDGPACKET()
  !packet.initialisation = '!!stlStandAloneFixing.positionData  = object EDGPOSITIONDATA()'
  !packet.definePosition(!prompt)
  !packet.description    = !this.packetDesc
  !packet.remove         = TRUE
  !packet.action = '!!stlStandAloneFixing.setPosition(!this.return[1] ) '

  -- Add event to system
  !!edgCntrl.add(!packet)

  -- draw graphical feedback on created element
  !this.feedback()

endmethod
-- End of method definition for .createAction()

------------------------------------------------------------------------
--
-- Method:      packetClose
--
-- Description: Tidy up after EDG close
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .packetClose()

  !this.tidy()
  !this.positionFrame.visible = false
  !this.frView3D.visible      = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Callback for WRT field
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbref()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use owner
  if(!wrtItem.unset()) then
    !wrtItem = !!ce.owner
    handle any
      !wrtItem = object DBREF('WORLD')
    endhandle
  endif

  -- Set tagging method
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set FIXING position from position control data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  --!this.positionDone(!this.position.get())
  !this.positionDone(!this.posControl.xyz())

endmethod

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set FIXING position from position control data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!data is EDGPOSITIONDATA)

  -- Update position control gadget with the picked position
  !pickedPosition = !data.position.wrt(World)

  !this.posControl.xyz(!pickedPosition.east, !pickedPosition.north, !pickedPosition.up)

  !this.setPosition()

  --!evaluatedPosition   = !this.getPositionControlPos(!this.headposControl.xyz())

  -- store the picked position data derived from the form
  --!data.position        = !evaluatedPosition
  --!this.pickedHeadPosData  = !data

endmethod

-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      .positionDone()
--
-- Description: Set FIXING position to given position
--
-- Method Type: Function/Procedure
-- Arguments:
--    1   R     POSITION    New position of FIXING
--
------------------------------------------------------------------------
define method .positionDone(!posValues is ARRAY)

  !east  = !posValues[0].string()
  !north = !posValues[1].string()
  !up    = !posValues[2].string()

  !position   = object POSITION(' E  $!east  N  $!north  U $!up ' )

  -- initialise undo
  !undoCreate = object UNDOABLE()
  !undoCreate.description('Modify Fixing Component')
  !undoCreate.add()

  -- set FIXING position and initialise properties
  !this.editElement.position = !position
  !this.comProp.setProperties(!this.editElement)
  !this.comProp.unsetDesiElement()

    -- Set any attributes specified in selection table
  !attribs = !this.selectedSelTab.getDesAttributes(!this.selectedItem)
  do !ind indices !attribs
    !this.editElement.attribute(!attribs[!ind][1]) = !attribs[!ind][2]
  enddo

  -- Clear name field for next item
  !this.newItemName = object STRING()
  !this.txName.clear()

  -- Draw graphical feedback
  !this.feedback()

  !undoCreate.endUndoable()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      .create()
--
-- Description: Create new FIXING element
--
-- Method Type: Function/Procedure
-- Arguments:
--    1   R     EDGPOSITIONDATA    returned from EDG pick
--
------------------------------------------------------------------------
define method .create()

  -- initialise undo
  !undoCreate = object UNDOABLE()
  !undoCreate.description('Create Fixing Component')
  !undoCreate.undoAction('!!stlStandAloneFixing.createUndoRedo()')
  !undoCreate.redoAction('!!stlStandAloneFixing.createUndoRedo()')
  !undoCreate.add()

  !!ce = !this.ownerElement

  -- Create new design item and name it
  NEW FIXING
  handle any
    !!alert.error(!!error.text)
    !this.editElement = object DBREF()
  elsehandle none

    !this.editElement = !!ce

    -- set purpose for stand-alone fixings
    PURP STFX

    if (!this.opAutoName.selection() eq |AUTO|) then
      !autoName = !!namOpt.nameString(!!ce, object STRING(), false, false)
      if (!autoName.unset()) then
        !!alert.warning(|Unable to Autoname element because you do not have a fixing component autoname rule|)
        !this.opAutoName.val = 1
      else
        !!ce.name = '/' & !autoName
      endif
    else
      if (!this.newItemName.set()) then
        !!ce.name = !this.newItemName
      endif
    endif
  endhandle

  -- Set element properties
  !this.comProp.setProperties(!!ce)
  !this.comProp.unsetDesiElement()

  -- Set any attributes specified in selection table
  !attribs = !this.selectedSelTab.getDesAttributes(!this.selectedItem)
  do !ind indices !attribs
    !!ce.attribute(!attribs[!ind][1]) = !attribs[!ind][2]
  enddo

  -- Function searches tmpref and spref for a set description and stores it
  !description = !!getDescFromSpref(!!ce)

  -- If the returned description is set then apply it to the current element
  if (!description.trim().empty().not()) then
    !!ce.description = !description
  endif

  -- set the table selection for edit
  !this.tableChooseData.setData(!!ce,|FIXING|)

  !undoCreate.endUndoable()

endmethod
-- End of method definition for .create()

------------------------------------------------------------------------
--
-- Method:      manageFrames
--
-- Description: Manage the visibility of the create & modify frames
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manageFrames(!mode is REAL)

  !this.mode = !mode
  !this.topPart.active          = true

  -- Create mode
  if (!mode eq 1) then
    !this.formTitle       =  'Create Fixing'
    !this.frModify.visible      = false
    !this.frCreate.visible      = true
    !this.bnApply.active        = false
    !this.bnNext.visible        = true
    !this.bnNext.active         = false
    !this.bnChange.visible      = false
    !this.bnPlotfile.active     = false
    !this.bnProperties.active   = true
    !this.positionFrame.visible = false
    !this.frView3D.visible      = true
    !this.opAutoName.val        = 1
    !this.txName.val            = object STRING()
    !this.paCeName.val          = ''
    !this.newItemName           = object STRING()
  -- Modify mode
  elseif (!mode eq 2) then
    !this.formTitle       =  'Modify Fixing'
    !this.frCreate.visible      = false
    !this.frModify.visible      = true
    !this.bnApply.active        = false
    !this.bnNext.visible        = false
    !this.bnChange.visible      = true
    !this.bnPlotfile.active     = false
    !this.bnProperties.active   = true
    !this.positionFrame.visible = false
    !this.frView3D.visible      = true
    -- Set forms current element
    if (!this.tableChooseData.getDesignItem().badref()) then
      return error 1 |Component not found|
    endif
    !this.paCeName.val = !this.tableChooseData.getDesignItem().fullname
  endif

endmethod
-- End of method definition for .manageFrames()

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: .net control After select event handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!a is ARRAY)

  -- Item is selected
  if (!a[0].set()) then
    -- Selected table item
    !this.tableSelect(!a[0])
  else
    -- Item is not selected
    -- Deactivate buttons
    !this.clearSelection()
  endif

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      tableSelect
--
-- Description: After select event for .net control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tableSelect(!rowID is ARRAY)

  -- Item is selected
  !chosenItem = !rowID[1].real()
  handle any
    -- invalid selection
    -- Deactivate buttons
    !this.clearSelection()
    return
  endhandle

  -- Selected table item
  !this.selectedItem = !this.choices[!chosenItem]

  -- Show in 3D view
  if( !this.selectedItem.hardType eq 'TABITE' ) then
    -- points to a table item
    !gPart = !this.selectedItem.prtref
  else
    -- points directly to a GPART
    !gPart = !this.selectedItem
  endif

  -- show component in 3D view
  if (not badref(!gPart)) then
     -- Get local drawlist
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    if (not badref(!gPart.tmpref)) then
      !this.madeSelection(!gPart.tmpref)
    elseif (not badref(!gPart.catref)) then
      !this.madeSelection(!gPart.catref)
    else
      !this.vwView3D.active = false
    endif
  endif

  -- Initialise properties for new item
  !this.initialiseProperties(!this.selectedItem)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      change
--
-- Description: Set spref of design element to selected table item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .change()

--  !!CE = !this.tableChooseData.getDesignItem()
  if (badref(!this.editElement)) then
    !!alert.warning(|Bad selection table item definition, element will not be modified|)
  endif

  !undoModify = object UNDOABLE()
  !undoModify.description('Modify Equipment Table Select')
  !undoModify.add()
  !this.comProp.designElement(!this.tableChooseData.getDesignItem())
  !this.comProp.setProperties()
  !this.comProp.unsetDesiElement()

  -- Set any attributes specified in selection table
  !attribs = !this.selectedSelTab.getDesAttributes(!this.selectedItem)
  do !ind indices !attribs
    !this.tableChooseData.getDesignItem().attribute(!attribs[!ind][1]) = !attribs[!ind][2]
    handle any
      -- q var !!error.text
    endhandle
  enddo
  !undoModify.endUndoable()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .close()

  !this.comProp.deleteObject(true)
  !this.tidy()
    -- Remove applications events from system
  !!edgCntrl.remove(!this.packetDesc)
  handle any
  endhandle

  !this.hide()

endmethod
-- End of method definition for .close()

-------------------------------------------------------------------
--
-- Method:      .next()
--
-- Description: Reinitialise the form for the next create operation
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .next()

  -- Clear name field for next item
  !this.newItemName = object STRING()
  !this.txName.clear()

  --!!edgCntrl.remove('Fixing Component Origin')
  !!edgCntrl.remove(!this.packetDesc)

  -- Initialise common parts of the form
  !this.editElement  = object DBREF()
  !this.ownerElement = object DBREF()

  -- Put form into initial create state
  !this.manageFrames(1)
  -- Allow create button so that another instance can be made of the selected item
  !this.bnApply.active = true

  -- clear any aid graphics
  !this.tidy()

endmethod
-- End of method definition for .next()

------------------------------------------------------------------------
--
-- Method:      createUndoRedo
--
-- Description: Put form in safe state on undo & redo
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createUndoRedo()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif

  -- Initialise common parts of the form
  !this.editElement  = object DBREF()
  !this.ownerElement = object DBREF()

  -- Put form into initial create state
  !this.manageFrames(1)
  -- reset for undone element change
  !this.tidy()
  handle any
  endhandle
    -- Remove applications events from system
  !!edgCntrl.remove(!this.packetDesc)
  handle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidAxes)

  !!aidNumbers.hide(!this.aidNumber)
  --!this.position.unLockAll()

  -- Initialise common parts of the form
  !this.editElement  = object DBREF()
  !this.ownerElement = object DBREF()

  -- Put form into initial create state
  !this.manageFrames(1)
  -- Allow create button so that another instance can be made of the selected item
  !this.bnApply.active = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      feedback
--
-- Description: Draw rotation axes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .feedback()

  !element = !this.editElement
  -- Define Graphic Object
  !volume              = object LOCALVOLUME(!element, !element)
  handle any
    !volume            = object LOCALVOLUME()
  endhandle

  -- If volume then use the origin of the item (expanded)
  if(!volume.unset()) then
    !volume            = object LOCALVOLUME()
    !volume.wrt        = !element
    !volume.from       = !element.position
    !volume.from.east  = !volume.from.east  - 353.5mm
    !volume.from.north = !volume.from.north - 353.5mm
    !volume.from.up    = !volume.from.up    - 353.5mm

    !volume.to         = !element.position
    !volume.to.east    = !volume.to.east    + 353.5mm
    !volume.to.north   = !volume.to.north   + 353.5mm
    !volume.to.up      = !volume.to.up      + 353.5mm
  endif

  !box                 = !volume.box()
  !gphBox              = object GPHBOX(!box)

  -- Draw axes at the orientation
  !gAxes = object GPHAXES(!this.editElement.position, !this.editElement.orientation)
  !gAxes.height = 1.25 * max( !gphBox.box.xLength, !gphBox.box.yLength, !gphBox.box.zLength, 500mm )
  !gAxes.draw(!this.aidAxes)

endmethod
-- End of method definition

------------------------------------------------------------------------
