-- Method:      getUserType
--
-- Description: Returns UDET if a UDET has been selected
--              Returns 'ALLTYPES' if a UDET is not selected
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .getUserType() is STRING

  !return = 'ALLTYPES'

  -- set UDET if set
  --if( !this.udets.active ) then
   -- if( !this.udets.val gt 1 ) then
      -- A UDET has been selected
      --!return = !this.udets.selection()
    --endif
  --endif

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeUserType
--
-- Description: Callback if UDET is changed
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .changeUserType()

  -- refresh selection table
  !this.chooseNew()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      findOwner
--
-- Description: Climb to SBFR or FRMW
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .findOwner(!element is DBREF) is DBREF

  !ownerList = !element.ownLst
  !types     = ARRAY()
  !types[1]  = 'SBFR'
  !types[2]  = 'FRMW'
  !return    = object DBREF()

  -- invert the array and put the passed element at the top of the list
  !ownerList.invert()
  !ownerList.insert(1, !element)

  -- find the first element that matches one of the permissible types
  do !dbElement values !ownerList
    if (!types.findFirst(!dbElement.hardType.upcase()).set()) then
      !return = !dbElement
      break
    endif
  enddo

  return !return

endmethod
-- End of method definition

define method .updateTables()

  -- configure specification table gadgets
  !this.tableChooseData.clearData()
  !this.tableChooseData.setTitle(|Component|)

  !this.tableChooseData.setData(|FIXING|,'STFX','STFX')

  !this.initialiseTables()

  !this.initTable(true)
endmethod
------------------------------------------------------------------------
--
-- Method:      coordinateSettings
--
-- Description: Setting the format of positional gadgets according to present coordinate system.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coordinateSettings()

  !grid            = object SHIPGRID()
  !gridDefined     = !grid.position.set()
  if(!gridDefined)then
    !this.posControl.gridvisible(true)
    !this.posControl.gridFormat()
  else
    !this.posControl.gridvisible(false)
    var !coord coord
    if (!coord.eq('ENU'))then
      !this.posControl.enuFormat()
    else
      !this.posControl.xyzFormat()
    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      drawOrigin
--
-- Description: Draw origin
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawOrigin(!element is DBREF, !aidNumber is REAL)

  !aidAxes = object GPHAXES(!element)
  handle any
  elsehandle none
   !aidAxes.draw(!aidNumber)
  endhandle

endmethod
