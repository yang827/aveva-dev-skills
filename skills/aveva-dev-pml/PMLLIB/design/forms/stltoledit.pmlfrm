--
--
-- Description:
--   Tolerances setting form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Update global object and old form
--  edit()                           -                   Show form
--  initialise()                     -                   Initialisation for form
--  load()                           -                   Load the Steel tolerance settings from PDMSUSER directory
--  maxMin()                         -
--  save()                           -                   Save the Steel tolerance settings to a file in the PDMSUSER directory
--  stlTolEdit()                     -
--  toggleLocation(MENU,STRING)      -                   toggle the location for saving the location
--
------------------------------------------------------------------------

setup form !!stlTolEdit

  !this.formTitle     = 'Section Tolerances'
  !this.iconTitle     = 'StlTol'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.13 $ '

  !framePos = 'at x0 y0'
  -- Body of form definition

  -- Menu to save and load the Tolerance settings through an external file
  bar
    add 'File' .fileMenu
  exit

  -- End of modification

  -- Creation Settings
  frame .tabs tabset
    frame .createFrame 'Creation Constraints' $!framePos $* at xmin ymax

      -- Merge Data
      frame .mergeFrame 'Node Merge Radius' at y0.5 width 32
        text .primary   'Primary   ' width 14 is REAL format !!distanceFmt
        path down
        text .secondary 'Secondary ' width 14 is REAL format !!distanceFmt

        toggle .offEnds 'Nodes allowed off ends'  states 'false' 'true'
      exit

      -- Section Length
      frame .lengthFrame 'Length Constraints' width 32
        text .minimum at y1.3 'Minimum' callback '!this.maxMin()' width 14 is REAL format !!distanceFmt
        path right
        toggle .minimumLock states 'false' 'true'
        path down
        text .maximum 'Maximum' at xmin.minimum callback '!this.maxMin()' width 14 is REAL format !!distanceFmt
        path right
        toggle .maximumLock states 'false' 'true'

        paragraph .lenLock at xmin.minimumLock-2 ymin.minimumLock-0.8 text 'Active'

        -- toggle .minimumLock 'Minimum' states 'false' 'true'
        -- path right
        -- text .minimum callback '!this.maxMin()' width 14 is REAL format !!distanceFmt
        -- path down
        -- toggle .maximumLock at xmin.minimumLock 'Maximum' states 'false' 'true'
        -- path right
        -- text .maximum callback '!this.maxMin()' width 14 is REAL format !!distanceFmt
      exit

      path down
      -- Joint Settings
      rgroup .jointDominant 'Joint Type' horizontal frame
        add tag 'Subordinate ' select 'FALSE'
        add tag 'Dominant    ' select 'TRUE'
      exit

    exit

    -- Intersection data
    frame .reconnFrame 'Reconnection Constraints' $!framePos $*at xmin ymax+0.5

      frame .tolFrame 'Position Tolerances' at y0.5 width 30

        text .offset at y1.3 'Offset  ' width 14 is REAL format !!distanceFmt
        path right
        toggle .offsetLock states 'false' 'true'
        path down
        text .overhang 'Overhang' at xmin.offset width 14 is REAL format !!distanceFmt
        path right
        toggle .overhangLock states 'false' 'true'
        path down
        text .angle    'Angle   ' at xmin.offset width 14 is REAL format !!angleFmt
        path right
        toggle .angleLock states 'false' 'true'

        paragraph .intLock at xmin.offsetLock-2 ymin.offsetLock-0.8 text 'Active'

        -- toggle .offsetLock   'Offset  ' states 'false' 'true'
        -- path right
        -- text .offset   width 14 is REAL format !!distanceFmt
        -- path down
        -- toggle .overhangLock at xmin.offsetLock 'Overhang' states 'false' 'true'
        -- path right
        -- text .overhang width 14 is REAL format !!distanceFmt
        -- path down
        -- toggle .angleLock    at xmin.offsetLock 'Angle   ' states 'false' 'true'
        -- path right
        -- text .angle    width 14 is REAL
      exit

      path down
      -- Reconnection Settings
      frame .connFrame 'Reconnection' width 32
        toggle .reposition 'Reposition on connection' states 'false' 'true'
        toggle .trim       'Trim to best PLine'       states 'false' 'true'
       -- toggle .mitreEnds  ' Mitre ends'               at xmin ymax states 'false' 'true'
      exit

      frame .mitreFrame 'Mitre Offset' width 32
         text .mitreOffset 'Offset depth' tagwidth 15 at  ymax+0.3  width 10 is REAL
      exit
    exit
  exit

  -- Apply/Reset/Dismiss
  path down
  button .apply   at xmax form-18-size '  OK  '   callback '!this.apply()' ok
  path right
  button .reset   'Reset ' callback '!this.initialise()'
  button .dismiss 'Cancel' at xmax form-size cancel

  -- Form Member
  member .settings is STLTOLERANCES

  -- current location
  member  .currentLoc is STRING

exit
-- End of form definition for !!stlTolEdit

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description:
--   Constructor for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .stlTolEdit()

  !fileMenu = !this.newMenu('fileMenu')

  !fileMenu.add('callback', 'Save', '!!stlTolEdit.save()')
  !fileMenu.add('callback', 'Load', '!!stlTolEdit.load()')
  !fileMenu.add('SEPARATOR')
  !fileMenu.add('menu', 'Location', 'locationMenu')

  -- !this.newMenu('saveMenu')
  -- !this.saveMenu.add('callback', 'User'   , '!this.save(|User|)')
  -- !this.saveMenu.add('callback', 'Project', '!this.save(|Project|)')
  -- !this.saveMenu.add('callback', 'Company'   , '!this.save(|Company|)')
  --
  -- !this.newMenu('loadMenu')
  -- !this.loadMenu.add('callback', 'User'   , '!this.load(|User|)')
  -- !this.loadMenu.add('callback', 'Project', '!this.load(|Project|)')
  -- !this.loadMenu.add('callback', 'Company'   , '!this.load(|Company|)')

  !this.newMenu('locationMenu')
  !this.locationMenu.add('toggle', 'User'   , '!!stlTolEdit.toggleLocation(')
  !this.locationMenu.add('toggle', 'Project', '!!stlTolEdit.toggleLocation(')

  !this.currentLoc = 'USER'
  !this.locationMenu.select('User', true)

endmethod


------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.settings = !!stlTolerances

  -- Update form
  !this.primary.val       = !this.settings.primaryMerge
  !this.secondary.val     = !this.settings.secondaryMerge
  !this.offEnds.val       = !this.settings.nodesOfEnd
  !this.offset.val        = !this.settings.offset
  !this.offsetLock.val    = !this.settings.offsetLock
  !this.overhang.val      = !this.settings.overhang
  !this.overhangLock.val  = !this.settings.overhangLock
  !this.angle.val         = !this.settings.angle
  !this.angleLock.val     = !this.settings.angleLock
  !this.minimum.val       = !this.settings.minLength
  !this.minimumLock.val   = !this.settings.minLengthLock
  !this.maximum.val       = !this.settings.maxLength
  !this.maximumLock.val   = !this.settings.maxLengthLock
  !this.reposition.val    = !this.settings.reposition
--  !this.mitreEnds.val     = !this.settings.mitreEnds
  !this.trim.val          = !this.settings.trim
  !this.jointDominant.select(!this.settings.jointDominant.string())

  !this.mitreOffset.val   = !this.settings.mitreOffset

  -- Same form is used in Beams & Columns and Walls & Floors
  if (!!appcntrl.currentApp() eq 'CIVIL') then
    !this.formTitle = 'Wall Tolerances'
  else
    !this.formTitle = 'Section Tolerances'
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Show form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- Initialise Variables
  show !!stlTolEdit

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      maxmin
--
-- Description:
--   Check that maximum is
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .maxMin()

  if (!this.maximum.val le !this.minimum.val) then
    !!alert.warning('Maximum should be greater than minimum value.')
  endif

endmethod
-- End of method definition for .maxMin()


------------------------------------------------------------------------
--
-- Method:      save
--
-- Description:
--   Save the Steel tolerance settings to a file in the PDMSUSER directory
--   Added by Aveva-DDC on 05Jan2006
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING    Text to select the Save location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()

  -- Find out current proj mdb and session
   !proj = current project
   !sess = current session

   if( !this.currentLoc.eq('USER') ) then
      !evarStr  = 'PDMSUSER'
      -- create a file in the current user directory
      !fileName   = '%PDMSUSER%'  + '/' + !proj.code().lowcase() + '-' + !sess.name + '-' + 'StlTolSettings'
   elseif( !this.currentLoc.eq('PROJ') ) then
      !project = !proj.evar.subString(1,3)
      !evarStr  =  !project + 'DFLTS'
      !fileName = '%' + !project + 'DFLTS%/' + !proj.code().lowcase() + '-' + !sess.name + '-' + 'StlTolSettings'
   endif

   -- check if the environment variable is set
   if(!!evarSplit(!evarStr).unset()) then
     !!alert.error('Environment variable $!evarStr is not set.' )
     return
   endif

   !tolSettingsFile = object FILE()
   !tolSettingsFile.file(!fileName)

   !tolSettings = ARRAY()

   -- writing header information
   !tolSettings.append('$$* Data file for Steel Tolerance Settings')
   !tolSettings.append('')

   ---- checking for the units while saving
   --if(!!distanceFmt.units eq 'MM') then
   --   !disUnits = 'mm'
   --else
   --   !disUnits = 'Inch'
   --endif
   !localAngleFmt           = object FORMAT()
   !localAngleFmt.dimension = 'ANGLE'
   !localAngleFmt.units     = 'degree'
   !localAngleFmt.label     = 'UNITS'
   !localAngleFmt.dp        = 2
   !angleValue              = !this.angle.val.string(!localAngleFmt)
   !tolSettings.append(|!primaryMerge   = '| & !this.primary.val       & |'|)
   !tolSettings.append(|!secondaryMerge = '| & !this.secondary.val     & |'|)
   !tolSettings.append(|!nodesOfEnd     =  | & !this.offEnds.val            )
   !tolSettings.append(|!offset         = '| & !this.offset.val        & |'|)
   !tolSettings.append(|!offsetLock     =  | & !this.offsetLock.val         )
   !tolSettings.append(|!overhang       = '| & !this.overhang.val      & |'|)
   !tolSettings.append(|!overhangLock   =  | & !this.overhangLock.val       )
   !tolSettings.append(|!angle          =  | & !angleValue                  )
   !tolSettings.append(|!angleLock      =  | & !this.angleLock.val          )
   !tolSettings.append(|!minLength      = '| & !this.minimum.val       & |'|)
   !tolSettings.append(|!minLengthLock  =  | & !this.minimumLock.val        )
   !tolSettings.append(|!maxLength      = '| & !this.maximum.val       & |'|)
   !tolSettings.append(|!maxLengthLock  =  | & !this.maximumLock.val        )
   !tolSettings.append(|!reposition     =  | & !this.reposition.val         )
   !tolSettings.append(|!trim           =  | & !this.trim.val               )
   !tolSettings.append(|!jointDominant  =  | & !this.jointDominant.val      )

   -- Write data to file
   !tolSettingsFile.writeFile('OVERWRITE',!tolSettings)
   handle (41,319)
    if(!!error.text.subString(-3,3).eq('DNF')) then
      !directory      = object FILE('%' + !evarStr + '%')
      !directoryPath  = !directory.pathName()
      !!alert.error ('Cannot find file directory $!directoryPath')
      return
    elseif(!!error.text.subString(-3,3).eq('PNS')) then
      !!alert.error ('The file $!fileName is a read-only file.')
      return
    endif
    return
   endhandle

   -- Apply to old form and global instance
   !this.apply()
   hide !!stlTolEdit

endmethod
-- End of  definition for .save()


------------------------------------------------------------------------
--
-- Method:      load
--
-- Description:
--   Load the Steel tolerance settings from PDMSUSER directory
--   Added by Aveva-DDC on 05Jan2006
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING     Text to select the Load location

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

   -- Find out current proj and session
   !proj = current project
   !sess = current session

   if(!this.currentLoc.eq('USER')) then
      !evarStr  =  'PDMSUSER'
      -- create a file in the current user directory
      !fileName = '%PDMSUSER%/' + !proj.code().lowcase() + '-' + !sess.name + '-' + 'StlTolSettings'
   elseif(!this.currentLoc.eq('PROJ')) then
      !project = !proj.evar.subString(1,3)
      !evarStr  =  !project + 'DFLTS'
      !fileName = '%' + !project + 'DFLTS%/' + !proj.code().lowcase() + '-' + !sess.name + '-' + 'StlTolSettings'
   endif

   -- check if the environment variable is set
   if(!!evarSplit(!evarStr).unset()) then
     !!alert.error('Environment variable $!evarStr is not set.' )
     return
   endif

   -- open file for Tolerance Settings
   !tolSettingsFile = object FILE()
   !tolSettingsFile.file(!fileName)

   -- check for the existence of the file
   if(!tolSettingsFile.exists()) then

     -- read the file contents into an array
     !fileContents = !tolSettingsFile.readFile()

     -- Reading the content of the file and assigning values in the local variables
     do !linenum indices !fileContents
       $!fileContents[$!linenum]
     enddo

     -- Assigning the values to stlTolerances member from the local variables
     !this.settings.primaryMerge   = $!primaryMerge
     !this.settings.secondaryMerge = $!secondaryMerge
     !this.settings.nodesOfEnd     = $!nodesOfEnd
     !this.settings.offset         = $!offset
     !this.settings.offsetLock     = $!offsetLock
     !this.settings.overhang       = $!overhang
     !this.settings.overhangLock   = $!overhangLock
     !this.settings.angle          = $!angle
     !this.settings.angleLock      = $!angleLock
     !this.settings.minLength      = $!minLength
     !this.settings.minLengthLock  = $!minLengthLock
     !this.settings.maxLength      = $!maxLength
     !this.settings.maxLengthLock  = $!maxLengthLock
     !this.settings.reposition     = $!reposition
     !this.settings.trim           = $!trim
     !this.jointDominant.val       = $!jointDominant

   else
     return error 1 '$!fileName does not exist. Save settings to the file to load again.'
   endif

   -- Setting the values to the gadgets

   !this.primary.val      = !this.settings.primaryMerge
   !this.secondary.val    = !this.settings.secondaryMerge
   !this.offEnds.val      = !this.settings.nodesOfEnd
   !this.offset.val       = !this.settings.offset
   !this.offsetLock.val   = !this.settings.offsetLock
   !this.overhang.val     = !this.settings.overhang
   !this.overhangLock.val = !this.settings.overhangLock
   !this.angle.val        = !this.settings.angle
   !this.angleLock.val    = !this.settings.angleLock
   !this.minimum.val      = !this.settings.minLength
   !this.minimumLock.val  = !this.settings.minLengthLock
   !this.maximum.val      = !this.settings.maxLength
   !this.maximumLock.val  = !this.settings.maxLengthLock
   !this.reposition.val   = !this.settings.reposition
   !this.trim.val         = !this.settings.trim

endmethod
-- End of  definition for .load()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Update global object and old form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables

  !this.settings.primaryMerge    = !this.primary.val
  !this.settings.secondaryMerge  = !this.secondary.val
  !this.settings.nodesOfEnd      = !this.offEnds.val
  !this.settings.offset          = !this.offset.val
  !this.settings.offsetLock      = !this.offsetLock.val
  !this.settings.overhang        = !this.overhang.val
  !this.settings.overhangLock    = !this.overhangLock.val
  !this.settings.angle           = !this.angle.val
  !this.settings.angleLock       = !this.angleLock.val
  !this.settings.minLength       = !this.minimum.val
  !this.settings.minLengthLock   = !this.minimumLock.val
  !this.settings.maxLength       = !this.maximum.val
  !this.settings.maxLengthLock   = !this.maximumLock.val
  !this.settings.reposition      = !this.reposition.val
  !this.settings.trim            = !this.trim.val
--  !this.settings.mitreEnds       = !this.mitreEnds.val
  !this.settings.jointDominant   = !this.jointDominant.selection().boolean()

  -- set the mitre ends offset proportion
  !this.settings.mitreOffset     = !this.mitreOffset.val

  -- Check the maximum and minimum validity
  !this.maxMin()

  -- Apply to old form and global instance
  !!stlTolerances.apply(!this.settings)

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      toggleLocation()
--
-- Description: toggle the location for saving the location
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [MENU] [menu that has been picked]
--   [2] [R] [STRING] [user action]
--
------------------------------------------------------------------------

define method .toggleLocation(!menu is MENU, !dummyAction is STRING)

  -- get the last picked field
  !field = !menu.pickedField

  -- initialise all gadgets
  !menu.select('User', false)
  !menu.select('Project', false)

  -- select the picked field
  !menu.select(!field, true)

  if (!field eq 'User') then
    !this.currentLoc = 'USER'
  elseif (!field eq 'Project') then
    !this.currentLoc = 'PROJ'
  endif

endmethod
-- End of method definition for .toggleLocation(MENU, STRING)

------------------------------------------------------------------------
