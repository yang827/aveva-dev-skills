--
-- Description:
-- Form to manipulate curves by their centre and radius
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!strCurveCent

  !!strCurveCent.formTitle     = 'Curve Definition by Centre'
  !!strCurveCent.iconTitle     = 'CENTRE'
  !!strCurveCent.callback      = ''
  !!strCurveCent.formRevision  = ' $Revision: 1.9 $ '

-- Members
 member .circum is POSITION
 member .radius is REAL
 member .centre is POSITION

  -- Body of form definition

path down
  rgroup _radio
      add tag |Point on Circumference| call |!!strCurveCentPick('Radius')|
      add tag |Centre Point| call |!!strCurveCentPick('Centre')|
  exit
  text _value |Radius| call |!!strCurveCentRad()|  width 16 isou
  path right
  toggle _lock |Lock|

 -- Bottom Line
  button _accept | OK | at xmin_value ymax+0.4 call |!!strCurveCentAppl()| ok
  button _cancel |Cancel| at xmax+4 ymin call '!!strCurveCentDism()' cancel

exit
-- End of form definition for !!strCurveCent
-- Method List
-- .Pick
-- .Circ
-- .Cent
-- .radius
-- .Confirm
-- .Dismiss
-- .apply
