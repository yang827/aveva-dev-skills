--
-- Description:
-- Form for selecting specification of fitting or fixing
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!strFittSpec

  !!strFittSpec.formTitle     = 'Fitting Specification'
  !!strFittSpec.iconTitle     = 'FITTSPEC'
  !!strFittSpec.callback      = ''
  !!strFittSpec.formRevision  = ' $Revision: 1.6 $ '

member .mode is STRING
member .type is STRING
member .element is DBREF
member .owner is DBREF
member .specData is SPECDATA
member .desp is ARRAY

  -- Body of form definition

  path right

button .change | CE | call |!!strFittSpecCe()|

button .loadSpecs |Specs| call |!!strFittSpecInit()|

option .specifications | |  width 25

path down

paragraph .qTitle at xmin.change ymax text 'Question:'

paragraph .question at xmax ymin text || width 40

list .permissible 'Select one of the following answers' at xmin.change ymax+0.2 width 50 length 8

list .selected 'Selections already made : Choose answer to reselect' width 50 length 8

button .ok |Apply| call |!!strFittSpecApply()|

path right

toggle .default |Use Defaults|

button .cancel |Dismiss| at xmax.selected-10 ymin call |!!strFittSpecDism()| cancel

exit
-- End of form definition for !!strFittSpec
-- Now link gadgets

call !!specLinks(!!strFittSpec.specData, |SpecData|, !!strFittSpec.selected, !!strFittSpec.permissible)

call !!specAddLink(!!strFittSpec.specData, 'SPECS', !!strFittSpec.specifications )
call !!specAddLink(!!strFittSpec.specData, 'QUESTION', !!strFittSpec.question )
call !!specAddLink(!!strFittSpec.specData, 'DEFAULT', !!strFittSpec.default )
