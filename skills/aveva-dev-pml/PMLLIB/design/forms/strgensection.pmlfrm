--
-- Description:
-- Generic section definition methods.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form down
--  create(STRING,STRING,STRING,STRING,STRING,STRING) -                   Display form with passed data
--  create3Points(ARRAY)             -                   create curved beam using 3 position picks
--  createFree()                     -                   Create a free curved beam
--  createGensecConnect(GMFSPINE,BOOLEAN) -                   Create GENSEC from Spine and connect if required
--  createGensecConnectUndo(GMFSPINE,BOOLEAN) -
--  createSection()                  -                   Display form for creating section
--  createWall()                     -                   Display form for creating wall
--  defineCurve(STRING,STRING)       -                   Curve Construction packet
--  defineFree(EDGPOSITIONDATA)      -                   Define a free curved beam
--  measureRadius(LINE)              -                   Write measurement to radius gadget
--  measureRadius(MENU,STRING)       -                   Measure radius
--  radius()                         -                   Check radius
--  strGensection()                  -                   Constructor
--  tidy()                           -                   Tidy form
--  undoLastPick()                   -                   Undo last pick
--
------------------------------------------------------------------------

setup form !!strGensection

  !this.formTitle     = 'Curved Sections'
  !this.iconTitle     = 'CurSections'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  frame .createFrame 'Create Methods' at xmin ymax width 25
    hdist 0
    path right
    button .free           at x0.2 ymax                             pixmap width 16 height 16 tooltip 'Free definition'            callback '!this.defineCurve(''free'',''fillet'')'
    button .angle                                                   pixmap width 16 height 16 tooltip 'Right angle'                callback '!this.defineCurve(''langle'',''fillet'')'
    button .rectangle                                               pixmap width 16 height 16 tooltip 'Closed rectangle (fillet)'  callback '!this.defineCurve(''rectangle'',''fillet'')'
    button .openRectangle                                           pixmap width 16 height 16 tooltip 'Open rectangle (fillet)'    callback '!this.defineCurve(''openrectangle'',''fillet'')'
    button .swanNeck                                                pixmap width 16 height 16 tooltip 'Swan neck'                  callback '!this.defineCurve(''swanneck'',''fillet'')'
    button .slot                                                    pixmap width 16 height 16 tooltip 'Obloid'                     callback '!this.defineCurve(''obloid'',''centre'')'
    button .cRectangle                                              pixmap width 16 height 16 tooltip 'Closed rectangle (centre)'  callback '!this.defineCurve(''rectangle'',''centre'')'
    button .cOpenRectangle                                          pixmap width 16 height 16 tooltip 'Open rectangle (centre)'    callback '!this.defineCurve(''openrectangle'',''centre'')'

    toggle .connect   'Connect Ends?'  at x1     ymax+0.5 states 'false' 'true'

    -- Re-define last point
    button .undo 'Undo'  at xmin.free ymax.connect + 0.2 tooltip 'Undo last pick' callback '!this.undoLastPick()'

  exit

  -- Options
--  frame .radiusFrame at xmin ymax width 25

    -- Radius
    path down
    halign right
    text .radius 'Radius'  callback '!this.radius()' width 14 is REAL format !!distanceFmt

 -- exit

  -- Edg Description
  member .edgDescription is STRING

  -- Reference Plane
  member .plane          is PLANE

  -- Curve type for creation method
  member .radiusType     is STRING

  -- Path definition (array of positions)
  member .path           is ARRAY
  -- Radii for path
  member .radii          is ARRAY
  -- Radius Type
  member .radiiType      is ARRAY

  -- Member count
  member .count          is REAL

  -- Maximum number of picks before automatically create sections
  member .max            is REAL

    -- Creation Type
  member .mode           is STRING

  -- Storage Data
  member .store          is DBREF
  member .group          is STRING
  member .area           is STRING

  -- Element being created (must be of hardtype GENSEC)
  member .type           is STRING

  -- Display Prompt
  member .prompt         is STRING
  member .primaryPrompt  is STRING

  -- Aid numbers
  member .aidNumber      is REAL
  member .aidNumbers     is ARRAY

  -- Connection manager
  member .manager        is SECTIONCONNECTIONMANAGER

  -- Start and End elements
  member .startElement   is DBREF
  member .endElement     is DBREF

exit
-- End of form definition for !!strGensection

--------------------------------------------------------------------------
--
-- Method: strGensection
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------
define method .strGensection()

  -- Initialise Variables
  !this.radius.val     = 1000mm
  !this.edgDescription = 'Define Curved Section'

  -- Aid numbers
  !this.aidNumber      = !!aidNumbers.add('Spine definition')

  -- Icon Definitions
  !this.free.addPixmap(!!pml.getPathName('definepoints16.png'),!!pml.getPathName('definepoints16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.angle.addPixmap(!!pml.getPathName('definelangle16.png'),!!pml.getPathName('definelangle16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.rectangle.addPixmap(!!pml.getPathName('definerectangle16.png'),!!pml.getPathName('definerectangle16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.openRectangle.addPixmap(!!pml.getPathName('defineopenrectangle16.png'),!!pml.getPathName('defineopenrectangle16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.swanNeck.addPixmap(!!pml.getPathName('defineswanneck16.png'),!!pml.getPathName('defineswanneck16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.slot.addPixmap(!!pml.getPathName('defineslot16.png'),!!pml.getPathName('defineslot16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.cRectangle.addPixmap(!!pml.getPathName('definecrectangle16.png'),!!pml.getPathName('definecrectangle16.png'), !!pml.getPathName('unknownicon16.png'))
  !this.cOpenRectangle.addPixmap(!!pml.getPathName('definecopenrectangle16.png'),!!pml.getPathName('definecopenrectangle16.png'), !!pml.getPathName('unknownicon16.png'))

  -- Close down
  !this.cancelCall     = '!this.close()'

  -- Grey-out undo
  !this.undo.active    = false

  -- Distance
  !menu = !this.newMenu('radiusMenu')
    !menu.add('CALLBACK', 'Measure',                    '!this.measureRadius(')
    !menu.add('CALLBACK', 'Measure Shortest',           '!this.measureRadius(')
  !this.radius.setPopup(!this.radiusMenu)

endmethod
-- End of method definition for .strGensection()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide aids
  !this.tidy()

  -- Remove any associated event
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Make undo inactive
  !this.undo.active = false

  -- Hide aids
  !!aidNumbers.hide(!this.aidNumber)

  do !i indices !this.aidNumbers
    !!aidNumbers.hide(!this.aidNumbers[!i])
  enddo

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      createSection
--
-- Description: Display form for creating section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSection()

  -- Edit as standard section creation
  !this.create('Curved Section', 'GENSEC', 'BANDC', 'SECTION', 'Define curved section', 'SECTION')

endmethod
-- End of method definition for .createSection()

------------------------------------------------------------------------
