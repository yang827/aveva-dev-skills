------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Display form with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form title
--    2   R      STRING      Element type being created
--    3   R      STRING      Storage group
--    4   R      STRING      Storage area
--    5   R      STRING      Prompt for EDG
--    6   R      STRING      Mode SECTION or WALL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!title is STRING, !type is STRING, !group is STRING, !area is STRING, !prompt is STRING, !mode is STRING)

  -- Check we can create a curved section at this point
  !store = !!getStorageArea(!group, !area)

  -- If store is unset, can we create the panel in or above where we are
  if(!store.unset()) then
    !store = !!dtbOwnerOfType(!!ce, 'GENSEC')

    if(!store.unset()) then
      !!alert.warning('Unable to create ' & !title & ' within this hierarchy structure. Move to an element that can own one or set the appropriate storage area.')
      return

    -- Use new store
    else
    endif
  endif

  -- Initialise Variables
  !this.formTitle     = !title
  !this.type          = !type
  !this.group         = !group
  !this.area          = !area
  !this.primaryPrompt = !prompt
  !this.store         = !store
  !this.mode          = !mode

  -- Show form
  !this.show()

endmethod
-- End of method definition for .create(STRING, STRING, STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      defineCurve
--
-- Description: Curve Construction packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Construction method
--    2   R      STRING      Radius type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineCurve(!constructMethod is STRING, !radiusType is STRING)

  -- Initialise Variables
  !this.mode            = !constructMethod.upcase()
  !this.count           = 0
  !this.plane           = object PLANE()
  !this.radiusType      = !radiusType.upcase()

  -- Grey-out undo
  !this.undo.active     = false

  -- Clear out path Definitions
  !this.path.clear()
  !this.radii.clear()
  !this.radiiType.clear()

  !packet               = object EDGPACKET()
  !packet.key           = 'CurvedSection'
  !packet.description   = !this.edgDescription
  !packet.action        = '!!strGensection.create3Points(!this.return)'
  !packet.priority      = 1
  !packet.remove        = false
  !packet.type          = 'dbModify'
  !pickPacket           = object EDGPICKPACKET()

  -- Setup for different construction methods

  -- L angle - three position picks
  if(!this.mode eq 'LANGLE') then

    -- Set Data
    !pickPacket.key         = 'defineSpine'
    !pickPacket.description = 'Standard Define Spine'
    !pickPacket.picks.clear()
    !pickPacket.picks[1]    = object EDGPICKTYPE()
    !pickPacket.picks[1].stdPosition('start')
    !pickPacket.picks[2]    = object EDGPICKTYPE()
    !pickPacket.picks[2].stdPosition('end for first leg')
    !pickPacket.picks[3]    = object EDGPICKTYPE()
    !pickPacket.picks[3].stdPosition('end of last leg')

    !this.prompt            = !this.primaryPrompt & ' ' & '"right angle"'
    !this.max               = 3

  -- rectangle - three position picks
  elseif(!this.mode eq 'RECTANGLE') then

    -- Set Data
    !pickPacket.key         = 'defineSpine'
    !pickPacket.description = 'Standard Define Spine'
    !pickPacket.picks.clear()
    !pickPacket.picks[1]    = object EDGPICKTYPE()
    !pickPacket.picks[1].stdPosition('start')
    !pickPacket.picks[2]    = object EDGPICKTYPE()
    !pickPacket.picks[2].stdPosition('end for first leg')
    !pickPacket.picks[3]    = object EDGPICKTYPE()
    !pickPacket.picks[3].stdPosition('last point')

    !this.prompt            = !this.primaryPrompt & ' ' & '"closed rectangle"'
    !this.max               = 3

  -- openRectangle - three position picks
  elseif(!this.mode eq 'OPENRECTANGLE') then

    -- Set Data
    !pickPacket.key         = 'defineSpine'
    !pickPacket.description = 'Standard Define Spine'
    !pickPacket.picks.clear()
    !pickPacket.picks[1]    = object EDGPICKTYPE()
    !pickPacket.picks[1].stdPosition('start')
    !pickPacket.picks[2]    = object EDGPICKTYPE()
    !pickPacket.picks[2].stdPosition('end for first leg')
    !pickPacket.picks[3]    = object EDGPICKTYPE()
    !pickPacket.picks[3].stdPosition('last point')

    !this.prompt            = !this.primaryPrompt & ' ' & '"open rectangle"'
    !this.max               = 3

  -- swan neck - three position picks
  elseif(!this.mode eq 'SWANNECK') then

    -- Set Data
    !pickPacket.key         = 'defineSpine'
    !pickPacket.description = 'Standard Define Spine'
    !pickPacket.picks.clear()
    !pickPacket.picks[1]    = object EDGPICKTYPE()
    !pickPacket.picks[1].stdPosition('start')
    !pickPacket.picks[2]    = object EDGPICKTYPE()
    !pickPacket.picks[2].stdPosition('end for first leg')
    !pickPacket.picks[3]    = object EDGPICKTYPE()
    !pickPacket.picks[3].stdPosition('last point')

    !this.prompt            = !this.primaryPrompt & ' ' & '"swan neck"'
    !this.max               = 3

  -- OBLOID - three position picks
  elseif(!this.mode eq 'OBLOID') then

    -- Set Data
    !pickPacket.key         = 'defineSpine'
    !pickPacket.description = 'Standard Define Spine'
    !pickPacket.picks.clear()
    !pickPacket.picks[1]    = object EDGPICKTYPE()
    !pickPacket.picks[1].stdPosition('first centre')
    !pickPacket.picks[2]    = object EDGPICKTYPE()
    !pickPacket.picks[2].stdPosition('second centre')
    !pickPacket.picks[3]    = object EDGPICKTYPE()
    !pickPacket.picks[3].stdPosition('start/end side')

    !this.prompt            = !this.primaryPrompt & ' ' & '"obloid"'
    !this.max               = 3

   -- free - N number of position picks (close on escape)
  elseif(!this.mode eq 'FREE') then

    -- Set Data
    !pickPacket.key         = 'defineSpine'
    !pickPacket.description = 'Standard Define Spine'
    !pickPacket.picks.clear()
    !pickPacket.picks[1]    = object EDGPICKTYPE()
    !pickPacket.picks[1].stdPosition('')
    !packet.action          = '!!strGensection.defineFree(!this.return[1])'
    !packet.close           = '!!strGensection.createFree()'
    !packet.remove          = false

    !this.prompt            = !this.primaryPrompt & ' ' & '"free" <escape> to finish'
    !this.max               = 0

  endif

  !pickPacket.prompt        = !this.prompt
  !packet.pickPacket        = !pickPacket

  -- Add to edg system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .defineCurve(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      defineFree
--
-- Description: Define a free curved beam
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION   Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineFree(!positionData is EDGPOSITIONDATA)

  !passedPosition = !positionData.position

  -- Initialise Variables
  !this.undo.active     = true
  !position             = !passedPosition

  -- Increment count
  !this.count = !this.count + 1

  -- Aid number
  !this.aidNumbers[!this.count] = !!aidNumbers.add('Define free spine')

  -- Map onto plane
  if(!this.plane.set()) then
    !position = !this.plane.near(!position)
  endif

  -- Derive the working plane
  if(!this.count eq 3) then
    !plane      = object GMFPLANE()
    !this.plane = !plane.through3Points(!this.path[1], !this.path[2], !position)
    handle (2, 886)
    	!!alert.error('$!!error.text' & '. Cannot construct a plane using the picked points. Pick another point.')
    	!!aidNumbers.remove(!this.count)
    	!this.count	=	!this.count - 1
			return
    elsehandle ANY
    	!!alert.error('$!!error.text' & '. Cannot construct a plane using the picked points.')
    	!!aidNumbers.remove(!this.count)
    	!this.count	=	!this.count - 1    	
    	return
    endhandle
    	
  endif

  -- First point
  if(!this.count eq 1) then
    !text           = 'Origin'
    !this.startElement = !positionData.item
  -- Subsequent points
  else
    !text           = !this.count & ' Point'
    !previous       = !this.path[!this.count - 1]
    !previousRadius = !this.radii[!this.count - 1]
    !this.endElement = !positionData.item

    -- Distance between position and previous point
    !distance       = !position.distance(!previous)

    -- If second point, don't bother checking against previous radius
    if(!this.count eq 2) then
      -- Check if distance from point to previous is less than the radius
      if(!distance lt !this.radius.val) then
        !!alert.warning('Unable to fit defined radius between the previous point and derived position, maximum is ' & !distance & '.')
        !this.count  = !this.count - 1
        return
      endif

    -- Check if distance from point to previous is less then the adjacent radii
    else

      -- Add adjacent radii together
      !radiiMax = !this.radius.val + !previousRadius

      -- Check we can fit radius
      if(!distance lt !radiiMax) then
        !maximum = !distance - !previousRadius

        -- Check for zero distance
        if(!maximum eq 0) then
          if(!!alert.confirm('Unable to fit any subsequent points after this position, is this the last point?').boolean()) then

            -- Remember position data
            !this.path[!this.count]      = !position
            !this.radii[!this.count]     = !this.radius.val
            !this.radiiType[!this.count] = !this.radiusType

            -- Exit the event
            !!edgCntrl.retrieve()
            return
          endif

        else
          !!alert.warning('Unable to fit defined radius between the previous point and derived position, maximum is ' & !maximum & '.')
        endif
        !this.count  = !this.count - 1
        return
      endif
    endif

    -- Draw line
    AID LINE NUMBER $!<this.aidNumbers[$!<this.count>]> $!<previous> TO $!<position> LINESTYLE DASHDOT

  endif

  -- Remember position data
  !this.path[!this.count]      = !position
  !this.radii[!this.count]     = !this.radius.val
  !this.radiiType[!this.count] = !this.radiusType

  AID TEXT NUMBER $!<this.aidNumbers[$!<this.count>]> '$!text' AT $!<position>


endmethod
-- End of method definition for .defineFree(POSITION)

------------------------------------------------------------------------
--
-- Method:      create3Points
--
-- Description: create curved beam using 3 position picks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Data Array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create3Points(!data is ARRAY)

  -- Initialise Variables
  !spine          = object GMFSPINE()

  -- Find elements at start and end of GENSEC
  !this.startElement  = !data[1][1].item
  !this.endElement    = !data[1][3].item

  -- Get positions from data
  do !i from 1 to 3
    !position[!i] = !data[1][!i].position
  enddo

  -- L angle - three position picks
  if(!this.mode eq 'LANGLE') then

    -- Determine L angle
    !line[1]       = !position[1].line(!position[2])
    !referenceLine = !line[1].parallel(!position[3])
    !line[2]       = !position[2].line(!referenceLine.near(!position[2]))
    !arc           = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[1], !line[1].startPosition, !line[2], !line[2].endPosition)

    -- Define spine
    !spine.control(!position[1])
    !spine.fillet(!arc)
    !spine.control(!line[2].endPosition)

  -- rectangle - three position picks
  elseif(!this.mode eq 'RECTANGLE') then

    -- Determine Line Angle
    !line[1]       = !position[1].midPoint(!position[2]).line(!position[2])
    !line[5]       = !position[1].line(!line[1].startPosition)
    !referenceLine = !line[1].parallel(!position[3])
    !line[2]       = !position[2].line(!referenceLine.near(!position[2]))
    !line[4]       = !referenceLine.near(!position[1]).line(!position[1])
    !line[3]       = !line[2].endPosition.line(!line[4].startPosition)

    -- Determine the corner arcs
    !arc[1] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[1], !line[1].startPosition, !line[2], !line[2].endPosition)
    !arc[2] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[2], !line[2].startPosition, !line[3], !line[3].endPosition)
    !arc[3] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[3], !line[3].startPosition, !line[4], !line[4].endPosition)
    !arc[4] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[4], !line[4].startPosition, !line[5], !line[5].endPosition)

    -- Centre Arcs (offset the fillet arc to the position, then re-calculate the lines, this is easier then other methods)
    if(!this.radiusType eq 'CENTRE') then
      !arc[1].position = !line[1].endPosition
      !arc[2].position = !line[2].endPosition
      !arc[3].position = !line[3].endPosition
      !arc[4].position = !line[4].endPosition

      -- Re-calculate start/end positions
      !line[1] = !line[1].parallel(!arc[1].anglePosition(!arc[1].startAngle))
      !line[2] = !line[2].parallel(!arc[2].anglePosition(!arc[2].startAngle))
      !line[3] = !line[3].parallel(!arc[3].anglePosition(!arc[3].startAngle))
      !line[4] = !line[4].parallel(!arc[4].anglePosition(!arc[4].startAngle))
      !line[5] = !line[5].parallel(!arc[4].anglePosition(!arc[4].endAngle))

      !spine.control(!line[1].startPosition)
      !spine.centre(!arc[1])
      !spine.control(!line[2].proportion(0.5))
      !spine.centre(!arc[2])
      !spine.control(!line[3].proportion(0.5))
      !spine.centre(!arc[3])
      !spine.control(!line[4].proportion(0.5))
      !spine.centre(!arc[4])
      !spine.control(!line[5].endPosition)

    -- Define spine points
    elseif(!this.radiusType eq 'FILLET') then
      !spine.control(!line[1].startPosition)
      !spine.fillet(!arc[1])
      !spine.control(!line[2].proportion(0.5))
      !spine.fillet(!arc[2])
      !spine.control(!line[3].proportion(0.5))
      !spine.fillet(!arc[3])
      !spine.control(!line[4].proportion(0.5))
      !spine.fillet(!arc[4])
      !spine.control(!line[5].endPosition)
    endif

  -- openRectangle - three position picks
  elseif(!this.mode eq 'OPENRECTANGLE') then

    -- Determine Line Angle
    !line[2]       = !position[1].line(!position[2])
    !referenceLine = !line[2].parallel(!position[3])
    !line[1]       = !referenceLine.near(!position[1]).line(!position[1])
    !line[3]       = !position[2].line(!referenceLine.near(!position[2]))

    -- Determine the corner arcs
    !arc[1] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[1], !line[1].startPosition, !line[2], !line[2].endPosition)
    !arc[2] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[2], !line[2].startPosition, !line[3], !line[3].endPosition)

    -- Centre Arcs (offset the fillet arc to the position, then re-calculate the lines, this is easier then other methods)
    if(!this.radiusType eq 'CENTRE') then
      !arc[1].position = !line[1].endPosition
      !arc[2].position = !line[2].endPosition

      -- Re-calculate start/end positions
      !line[1] = !line[1].parallel(!arc[1].anglePosition(!arc[1].startAngle))
      !line[2] = !line[2].parallel(!arc[2].anglePosition(!arc[2].startAngle))
      !line[3] = !line[3].parallel(!arc[2].anglePosition(!arc[2].endAngle))

      !spine.control(!line[1].startPosition)
      !spine.centre(!arc[1])
      !spine.control(!line[2].proportion(0.5))
      !spine.centre(!arc[2])
      !spine.control(!line[3].endPosition)

    -- Define spine points
    elseif(!this.radiusType eq 'FILLET') then
      !spine.control(!line[1].startPosition)
      !spine.fillet(!arc[1])
      !spine.control(!line[2].proportion(0.5))
      !spine.fillet(!arc[2])
      !spine.control(!line[3].endPosition)
    endif

  -- swan neck - three position picks
  elseif(!this.mode eq 'SWANNECK') then

     -- Determine Line Angle
    !line[1]       = !position[1].line(!position[2])
    !referenceLine = !line[1].parallel(!position[3])
    !line[2]       = !position[2].line(!referenceLine.near(!position[2]))
    !line[3]       = !line[2].endPosition.line(!position[3])

    -- Determine the corner arcs
    !arc[1] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[1], !line[1].startPosition, !line[2], !line[2].endPosition)
    !arc[2] = !!appMathLib.gmfArc.fillet(!this.radius.val, !line[2], !line[2].startPosition, !line[3], !line[3].endPosition)
    handle any
      !!alert.error('Arc not valid for GENSEC Spine (radius too large?)')
    elsehandle none
      -- Define spine
      !spine.control(!line[1].startPosition)
      !spine.fillet(!arc[1])
      !spine.control(!line[2].proportion(0.5))
      !spine.fillet(!arc[2])
      !spine.control(!line[3].endPosition)
    endhandle

  -- slot - three position picks
  elseif(!this.mode eq 'OBLOID') then

    -- Define plane
    !plane              = !position[1].midPoint(!position[2]).plane(!position[3], !position[2])
    !plane.orientation  = object ORIENTATION('Y is ' & !position[1].direction(!position[2]) & ' and Z is ' & !plane.orientation.zDir())

    -- Define Arc
    !arc[1]             = object ARC(!position[1], !plane.orientation, 0, 180, !this.radius.val, true)
    !arc[1].orientation = object ORIENTATION('Y is ' & !arc[1].orientation.yDir().opposite() & ' and Z is ' & !arc[1].orientation.zDir().opposite())
    !arc[2]             = !arc[1]
    !arc[2].position    = !position[2]
    !arc[2].orientation = object ORIENTATION('Y is ' & !arc[1].orientation.yDir().opposite() & ' and Z is ' & !arc[1].orientation.zDir())

    !line[1]            = !arc[2].anglePosition(!arc[2].endAngle).line(!arc[1].anglePosition(!arc[1].startAngle))
    !line[2]            = !arc[1].anglePosition(!arc[1].endAngle).line(!arc[2].anglePosition(!arc[2].startAngle))

    -- Define spine
    !spine.control(!line[1].proportion(0.5))
    !spine.centre(!arc[1])
    !spine.control(!line[2].proportion(0.5))
    !spine.centre(!arc[2])
    !spine.control(!line[1].proportion(0.5))

  endif

  -- Define GENSEC
  !this.createGensecConnectUndo(!spine, !this.connect.val)

endmethod
-- End of method definition for .create3Points(ARRAY)

------------------------------------------------------------------------
--
-- Method:      createFree
--
-- Description: Create a free curved beam
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION   Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createFree()

  -- Initialise Variables
  !spine          = object GMFSPINE()
  !lastPoint      = !this.path.size()

  -- Check we have a minimum number of points
  if(!lastPoint lt 3) then
    !!alert.warning('Spine definition MUST contain at least three points.')

    -- Remove aid lines
    !this.tidy()
    return
  endif

  -- Start of spine
  !spine.control(!this.path[1])
  !previousLine = !this.path[1].line(!this.path[2])

  -- Process the points
  do !i from 2 to !lastPoint - 1

    -- Line from point to next
    !nextLine     = !this.path[!i].line(!this.path[!i + 1])

    -- Define fillet arc
    !arc = !!appMathLib.gmfArc.fillet(!this.radii[!i], !previousLine, !previousLine.startPosition, !nextLine, !nextLine.endPosition)
    !spine.fillet(!arc)

    -- If point is not penultimate, then workout the intermediate point
    if(!i lt !lastPoint - 1) then
      !spine.control(!nextLine.proportion(0.5))
    endif

    -- Next line becomes previous line for next point
    !previousLine = !nextLine
  enddo

  -- End of spine
  !spine.control(!this.path[!lastPoint])
  -- Define GENSEC
  !this.createGensecConnectUndo(!spine, !this.connect.val)

  -- Remove aid lines
  !this.tidy()

endmethod
-- End of method definition for .createFree()

------------------------------------------------------------------------
--
-- Method:      createGensecUndo
--
-- Description: Create GENSEC from Spine and connect if required
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFSPINE    Spine definition for GENSEC
--    2   R      BOOLEAN     Try to connect if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createGensecConnectUndo(!spine is GMFSPINE, !connect is BOOLEAN)

  if(!spine.points.empty()) then
    return
  endif

  !undoCreateGensec = object UNDOABLE()
  !undoCreateGensec.description('Create GENSEC')
  !undoCreateGensec.add()

  !this.createGensecConnect(!spine, !connect)
  handle any
    !!alert.error(!!error.text)
  endhandle

  !undoCreateGensec.endUndoable()

endmethod
-- End of method definition for .createFree()

------------------------------------------------------------------------
--
-- Method:      createGensecConnect
--
-- Description: Create GENSEC from Spine and connect if required
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFSPINE    Spine definition for GENSEC
--    2   R      BOOLEAN     Try to connect if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createGensecConnect(!spine is GMFSPINE, !connect is BOOLEAN)

  if(!spine.points.empty()) then
    return
  endif

  -- create GENSEC
  call !!strGensecCreate(!spine, !this.group, !this.area, !this.store, !this.type, !this.mode)
  !created = !!ce

  -- Attempt connection if user has checked connect toggle
  if (!connect) then
    -- Check element at start of GENSEC to see if compatible for connection
    if (!this.startElement.set()) then
      !startComp = !this.manager.checkCompatible(!this.startElement)
      if (!startComp) then
        !this.manager.connectSections('Start', !created, !this.startElement)
      endif
    endif

    -- Check element at end of GENSEC to see if compatible for connection
    if (!this.endElement.set()) then
      !endComp = !this.manager.checkCompatible(!this.endElement)
      if (!endComp) then
        !this.manager.connectSections('End', !created, !this.endElement)
      endif
    endif
  endif

endmethod
-- End of method definition for .createGensecConnect(ARRAY)

------------------------------------------------------------------------
--
-- Method:      measureRadius
--
-- Description: Measure radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureRadius(!menu is MENU, !dummy is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then
    !packet.defineMeasure('distance')

  -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then
    !packet.defineMeasure('shortest')
  endif

  !packet.description = !this.edgDescription
  !packet.action      = '!!strGensection.measureRadius(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .measureRadius(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measureRadius
--
-- Description: Write measurement to radius gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measureRadius(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.radius.val = 0
  else
    !this.radius.val = !line.length()
  endif

endmethod
-- End of method definition for .measureRadius(LINE)

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: Check radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .radius()

  -- Zero or less is not allowed
  if(!this.radius.val.unset()  or !this.radius.val le 0) then
    !!alert.warning('Unable to define a radius equal or less than zero.')
    !this.radius.val = 1000mm
  endif

endmethod
-- End of method definition for .radius()

------------------------------------------------------------------------
--
-- Method:      undoLastPick
--
-- Description: Undo last pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .undoLastPick()

  -- Initialise Variables

  -- Remove last definition
  !this.radii[!this.count].delete()
  !this.radiiType[!this.count].delete()
  !this.path[!this.count].delete()

  -- Remove last aid number
  !!aidNumbers.remove(!this.aidNumbers[!this.count])

  -- Decrement count
  !this.count = !this.count - 1

  -- Grey out undo command
  if(!this.count eq 0) then
    !this.undo.active = false
  elseif (!this.count lt 3) then
    !this.plane = object PLANE()
  endif

endmethod
-- End of method definition for .undoLastPick()
