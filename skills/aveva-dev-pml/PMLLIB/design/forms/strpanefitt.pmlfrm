--
--
-- Description:
-- Form for positioning a panel fitting
--
------------------------------------------------------------------------

-- Define form
setup form !!strPaneFitt

  !!strPaneFitt.formTitle     = 'Position Panel Fitting'
  !!strPaneFitt.iconTitle     = 'FITTING'
  !!strPaneFitt.callback      = ''
  !!strPaneFitt.formRevision  = ' $Revision: 1.9 $ '

member .posl   is  STRING
member .fitting is DBREF
member .mode is STRING
member .position is POSITION

  -- Body of form definition
path right
hdist 1
vdist 0.5

rgroup _radio
      add tag |Create| call |!this.changeMode('NEW') |
      add tag |Modify| call |!this.changeMode('MODIFY') |
      add tag |Pick  | call |!this.changeMode('PICK') |

exit

paragraph .element  at x 0.2 ymax + 0.2 text | | width 40
text .bang |Rotate by | at x 0.5 ymax + 0.5 call |!!strPaneFittBang()| width 10 is REAL
button .spec |Specification|  call | !!strFittSpecShow('MODIFY', 'FIXING') |

-- Position Line of Fitting
    option .just |Justification| at x 0.5 ymax+0.5 call |!!strPaneFittPosl()  | width 20

-- Bottom Line
  button .dismiss |Dismiss| at xmin_spec+7 ymax+0.5 call |!!strPaneFittDism()| ok

exit

    !dText[1] = | Top outwards |
    !dText[2] = | Top inwards |
    !dText[3] = | Centre outwards |
    !dText[4] = | Centre inwards |
    !dText[5] = | Bottom outwards |
    !dText[6] = | Bottom inwards |
    !rText[1] = |UTOP|
    !rText[2] = |DTOP|
    !rText[3] = |UCEN|
    !rText[4] = |DCEN|
    !rText[5] = |DBOT|
    !rText[6] = |UBOT|

    !!strPaneFitt.just.dText = !dText
    !!strPaneFitt.just.rText = !rText

-- End of form definition for !!strPaneFitt
------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode (NEW or MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
 define method .changeMode(!mode is STRING)

 !this.mode = !mode
 if (!mode eq |MODIFY| ) then
      !this.spec.callback = | !!strFittSpecShow('MODIFY', 'FIXING') |
 elseif (!mode eq |NEW| ) then
      !this.spec.callback = | !!strFittSpecShow('NEW', 'FIXING') |

 else

      !!edgCntrl.remove('Pick Panel Fitting')
     !!edgCntrl.remove('Position Panel Fitting')


     !packet = object EDGPACKET()
     !packet.defineWrapper('PANEL','!!strPaneFitt.changeOwner()','Pick a panel')
     !packet.description = 'Pick Panel Fitting'

!!edgCntrl.add(!packet)

 endif


endmethod
-- End of method definition for .changeMode(STRING)

------------------------------------------------------------------------
--
-- Method:      changeOwner
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
 define method .changeOwner()

 -- Check same gtype

 if (defined( !!strFittSpec) ) then
      if (!!strFittSpec.owner.gType eq !!edgGeomData.pickedItem.gType ) then
            !!strFittSpec.owner = !!edgGeomData.pickedItem
      else
            !!alert.warning('Gtype is different; use Create>Fitting to reselect specification')
            return
      endif
 endif

-- Build list of plines

       !owner = !!strFittSpec.owner

-- Enhance current owner
UNENHANCE ALL
call !!enhanceItem(!owner, 'Salmon' )
!!strPaneFitt.element.val = !owner.flnm

-- Switch back to create mode
   !this.mode = 'NEW'
   !this.radio.val = 1
   !this.spec.callback = | !!strFittSpecShow('NEW', 'FIXING') |
-- set up EDG
!!edgCntrl.remove('Pick Section Fitting')

!packet = object EDGPACKET()
!packet.defineWrapper('POSITION','!!strPaneFittConf()','Pick Position for Fitting')
!packet.description = 'Position Section Fitting'

!!edgCntrl.add(!packet)

endmethod
-- End of method definition for .changeOwner()
