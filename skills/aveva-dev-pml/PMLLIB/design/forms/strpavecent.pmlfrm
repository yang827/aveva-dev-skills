-- Description:
-- Define vertex with radius by centre
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!strPaveCent

  !!strPaveCent.formTitle     = 'Vertex definition by centre'
  !!strPaveCent.iconTitle     = 'CENTRE'
  !!strPaveCent.callback      = ''
  !!strPaveCent.formRevision  = ' $Revision: 1.7 $ '

  -- Members
 member .circum is POSITION
 member .radius is REAL
 member .centre is POSITION

  -- Body of form definition

path down
  rgroup _radio
      add tag |Point on Circumference| call |!!strPaveCentPick('Radius')|
      add tag |Centre Point| call |!!strPaveCentPick('Centre')|
  exit
  text _value |Radius| call |!!strPaveCentRad()|  width 16 is REAL format !!distanceFmt
  path right
  toggle _lock |Lock|
 -- Bottom Line
  button _accept | OK | at xmin_value ymax+0.5 call |!!strPaveCentAppl()| ok
  button _cancel |Cancel| call '!!strPaveCentDism()' cancel

-- End of form definition for !!strPaveCent
-- Method List
-- .Pick
-- .Circ
-- .Cent
-- .radius
-- .Confirm
-- .Dismiss
-- .apply


exit
-- End of form definition for ??Unknown??
