--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Wed Mar 18 10:03:57 1998
--
--
-- Description:
-- Form to define and modify a curve on a panel by its pole point and radius
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  confirm()                        -                   If confirming then show some aid graphics
--  dismiss()                        -                   Clear up EDG and aid graphics
--  go()                             -                   Complete the action i.e. create or modify the curve
--  pick(STRING)                     -
--  savePole()                       -                   Remember the fillet point and if radius already defined
--  saveRadius(REAL)                 -                   Complete the action i.e. create or modify the curve
--  typeRadius()                     -                   Save typed radius value and check if we have enough information
--
------------------------------------------------------------------------

setup form !!strPaveFill

  !!strPaveFill.formTitle     = 'Vertex definition by fillet'
  !!strPaveFill.iconTitle     = 'FILLET'
  !!strPaveFill.callback      = ''
  !!strPaveFill.formRevision  = ' $Revision: 1.10 $ '

-- Members
 member .radius is REAL
 member .pole is POSITION
 member .start is POSITION


path down
  rgroup _radio
      add tag |Pole Point| call |!!strPaveFill.pick('Pole')|
      add tag |Define Radius from Two Points| call |!!strPaveFill.pick('Start')|
  exit
  text _value |Radius| call |!!strPaveFill.typeRadius()|  width 16 is REAL format !!distanceFmt

-- Bottom Line
  button _accept | OK | call |!!strPaveFill.go()| ok
  path right
  button _cancel |Cancel| call '!!strPaveFill.dismiss()' cancel

exit
-- End of form definition for !!strPaveFill

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode POLE or START or FINISH
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick(!mode is STRING)

!!edgCntrl.remove('Panel Vertex Fillet Pole')
!!edgCntrl.remove('Panel Vertex Fillet Radius')

!packet = object EDGPACKET()

if (!mode.upcase() eq 'POLE' ) then
     !packet.defineWrapper('POSITION','!!strPaveFill.savePole()','Pick Position of Pole')
     !packet.description = 'Panel Vertex Fillet Pole'
     !this.radio.val = 1
elseif (!mode.upcase() eq 'START') then
     !packet.defineWrapper('POSITION','!!strPaveFill.saveRadius(1)','Define Radius:First Point')
     !packet.description = 'Panel Vertex Fillet Radius'
     !this.radio.val = 2
else
     !packet.defineWrapper('POSITION','!!strPaveFill.saveRadius(2)','Define Radius:Second Point')
     !packet.description = 'Panel Vertex Fillet Radius'
     !this.radio.val = 2
endif

!!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick(STRING)

------------------------------------------------------------------------
--
-- Method:      go
--
-- Description: Complete the action i.e. create or modify the curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .go()

-- clear aid graphics
call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40102)
call !!clearAid('TEXT', 40102)

-- Remember where we were
!refe = !!ce

!!ce = !!sctlPave.current

-- Handle first pole position
     if (!!sctlPave.radio.val eq 1) then
    -- Create new vertex
         if (!!ce.owner.type eq 'PLOO') then
               NEW PAVE
         else
               NEW VERT
         endif

     endif
     -- Set attributes

     !cPosString = !this.pole.string()
     POS $!cPosString
     !radius = !this.radius.string()
     FRADIUS $!radius

    -- Update Counters
     !!sctlPave.current = !!ce
     !!sctlPave.number = !!ce.owner.members.findFirst(!!ce)

-- Update List
call !!sctlPaveList(!!ce.owner)

!!ce = !refe

!this.dismiss()

endmethod
-- End of method definition for .go()
------------------------------------------------------------------------
--
-- Method:      savePole
--
-- Description: Remember the fillet point and if radius already defined
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .savePole()

-- Save Value
!this.pole = !!sctlPave.plane.near(!!edgGeomData.position)

-- Display position of origin
     call !!clearAid('SPHERE', 40102)
     call !!drawAidSphere(200,!this.pole,40102)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Pole',!this.pole , 40102)

-- Switch EDG
  !this.pick('START')

-- See if we have enough information to complete
if (Set(!this.radius) ) then
        !this.confirm()
endif

endmethod
-- End of method definition for .savePole()
------------------------------------------------------------------------
--
-- Method:      saveRadius
--
-- Description: Complete the action i.e. create or modify the curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL        First or second pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveRadius(!number is REAL)

if (!number eq 1) then
  -- Save Value
     !this.start = !!edgGeomData.position

-- Display position of origin
     call !!clearAid('SPHERE', 40103)
     call !!drawAidSphere(200,!this.start,40103)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Start',!this.start , 40103)
    -- Switch EDG
       !this.pick('END')
else
-- Clear aids
      call !!clearAid('SPHERE', 40103)
      call !!clearAid('TEXT', 40102)
-- Calculate Radius
     !this.radius = !this.start.distance( !!edgGeomData.position)
     !this.value.val = !this.radius

     -- Switch EDG
       !this.pick('POLE')

-- See if we have enough information to complete
      if (Set(!this.pole) ) then
             !this.confirm()
       endif
endif

endmethod
-- End of method definition for .saveRadius(REAL)

------------------------------------------------------------------------
--
-- Method:      confirm
--
-- Description: If confirming then show some aid graphics
-- otherwise complete action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirm()

-- Calculate arc given by points
---------------------------------------
-- Find Number of current Vertex
!number = !!sctlPave.current.owner.members.findFirst(!!sctlPave.current)
-- Find number of next
if (!number eq !!sctlPave.current.owner.mCount) then
     !endNo = 1
else
     !endNo = !number + 1
endif
-- Find number of previous
if (!!sctlPave.radio.val eq 1) then
     !startNo = !number
else
     if (!number eq 1) then
          !startNo = !!sctlPave.current.owner.mCount
     else
          !startNo = !number - 1
     endif
endif
-- Find positions of vertices
     !previous = !!sctlPave.current.owner.members[!startNo].position
     !next = !!sctlPave.current.owner.members[!endNo].position

-- Construct Arc from information available

     !arc = !this.pole.arcFillet(!previous, !next, !!sctlPave.plane.direction(), !this.radius)

-- Draw Aid Cylinder
    if (!this.radius lt 1000mm ) then
          !height = !this.radius
    else
          !height = 1000mm
    endif
    !diameter = 2 * !this.radius
    call !!clearAid('CYLI', 40101)
    call !!drawAidCylinder(!diameter, !height,  !arc.position, !!sctlPave.plane.orientation, True, 40101 )
-- Enable accept button
    !this.accept.active = True

endmethod
-- End of method definition for .confirm()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Clear up EDG and aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

!!edgCntrl.remove('Panel Vertex Fillet Pole')
!!edgCntrl.remove('Panel Vertex Fillet Radius')

call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40103)
call !!clearAid('TEXT', 40102)
call !!clearAid('SPHERE', 40102)

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      typeRadius
--
-- Description: Save typed radius value and check if we have enough information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .typeRadius()

-- Save radius
!this.radius = !this.value.val.real()

if(Set(!this.pole) ) then
        !this.confirm()
endif

endmethod
-- End of method definition for .typeRadius()
