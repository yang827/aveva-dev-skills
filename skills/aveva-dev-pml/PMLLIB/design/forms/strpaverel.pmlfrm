-- Created:         Mon Apr 6 11:51:28 BST 1998
--
--
-- Description:
-- Define a vertex relative to the current vertex
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrow()                          -
--  dismiss()                        -
--  go()                             -
--  pickDirection()                  -
--  pickDistance()                   -
--  saveDirection()                  -
--  saveDistance(EDGPICKDATA)        -
--  setup()                          -
--
------------------------------------------------------------------------

setup form !!strPaveRel

  !!strPaveRel.formTitle     = 'Distance and Direction'
  !!strPaveRel.iconTitle     = 'RELATIVE'
  !!strPaveRel.callback      = ''
  !!strPaveRel.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

  -- Body of form definition
path down
  rgroup _radio
      add tag |Define Direction using Position| call |!!strPaveRel.pickDirection()|
      add tag |Define Distance using Plane    | call |!!strPaveRel.pickDistance()|
  exit
  text _valDist |Distance | call |!!strPaveRel.arrow()|  width 16 is REAL format !!distanceFmt
  text _valDir  |Direction| call |!!strPaveRel.arrow()|  width 25 is DIRECTION

-- Bottom Line
  button _apply |Apply| call '!!strPaveRel.go()'
  path right
  button _cancel |Dismiss| at xmax+16 ymin call '!!strPaveRel.dismiss()' cancel

exit
-- End of form definition for !!strPaveRel

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

-- Set gadgets to sensible values
if (!!isImperialLegth('DIST') ) then
     !this.valDist.val = 36in
else
     !this.valDist.val = 1000mm
endif
!this.valDir.val = E WRT WORLD

!this.arrow()

endmethod
-- End of method definition for .setup()
------------------------------------------------------------------------
--
-- Method:     arrow
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arrow()

-- Draw Aid Arrow
!arrow = object ARROW()

-- Calculate position for arrow

!arrow.pos = !!sctlPave.current.position

-- Calculate direction for arrow
!arrow.dir = !this.valDir.val

-- Draw arrow
!arrow.ratio = 0.2
!arrow.length = !this.valDist.val
call !!clearAid('ARROW', 43003)

call !!drawAidArrow(43003, !arrow)

endmethod
-- End of method definition for .arrow()

------------------------------------------------------------------------
--
-- Method:      go
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .go()

!refe = !!ce

-- Calculate Position
!spacePos = !!sctlPave.current.position.offset(!this.valDir.val, !this.valDist.val)
!position = !!sctlPave.plane.near(!spacePos)

!!ce = !!sctlPave.current

     if (!!sctlPave.radio.val eq 1) then
    -- Create new vertex
         if (!!ce.owner.type eq 'PLOO') then
               NEW PAVE
         else
               NEW VERT
         endif

     endif
     -- Set attributes

     !cPosString = !position.string()
     POS $!cPosString

   -- Update Counters
     !!sctlPave.current = !!ce
     !!sctlPave.number = !!ce.owner.members.findFirst(!!ce)

-- Update List
call !!sctlPaveList(!!ce.owner)

!!ce = !refe

!this.arrow()

endmethod
-- End of method definition for .go()

------------------------------------------------------------------------
--
-- Method:      pickDirection
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickDirection()

!!edgCntrl.remove('Panel Vertex Relative Direction')
!!edgCntrl.remove('Panel Vertex Relative Distance')

!packet = object EDGPACKET()

!packet.defineWrapper('POSITION','!!strPaveRel.saveDirection()','Pick Position to Define Direction')
!packet.description = 'Panel Vertex Relative Direction'

!!edgCntrl.add(!packet)

!this.radio.val = 1

endmethod
-- End of method definition for .pickDirection()

------------------------------------------------------------------------
--
-- Method:      pickDistance
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickDistance()

  !!edgCntrl.remove('Panel Vertex Relative Direction')
!!edgCntrl.remove('Panel Vertex Relative Distance')

!packet = object EDGPACKET()
  !packet.key            = 'Panel Vertex Relative Distance'
  !packet.description    = 'Panel Vertex Relative Distance'
  !packet.type           = 'gph'
  !packet.priority       = 0
  !packet.action         = '!!strPaveRel.saveDistance(!this.return[1])'
  !packet.remove         = true
  !packet.pickPacket.stdAny('Pick Plane to Define Distance')
  !packet.pickPacket.picks[1].prompt         = STRING()
  !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
  !packet.pickPacket.picks[1].pick.stdGraphics()
  !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
  !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
  !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
  !packet.pickPacket.picks[1].pick.input[10] = /*
  !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'

!!edgCntrl.add(!packet)

!this.radio.val = 2

endmethod
-- End of method definition for .pickDistance()
------------------------------------------------------------------------
--
-- Method:      saveDistance
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveDistance(!pickData is EDGPICKDATA)

  -- Special Case Picks (ie items that can be used as a plane in their
  -- own right)
  if(!pickData.type eq 'DESIGNAID') then

    if(!!aidNumbers.numbers[!pickData.point].objectType() inset('GPHPLANE','GPHLINEARGRID','GPHPLANTGRID','GPHRADIALGRID')) then

      -- Get plane

      if(!!aidNumbers.numbers[!pickData.point].objectType() eq 'GPHPLANE') then

        !plane = !!aidNumbers.numbers[!pickData.point].plane

      else

        !plane = !!aidNumbers.numbers[!pickData.point].plane()

      endif

    else

      !!alert.error('Unable to derived plane from picked element.')
    endif


  -- Use "plane" picked
  else

    !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
    handle any
      !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
    endhandle

  endif

-- Construct Point vector at current point in given direction
!pointVector = object POINTVECTOR()
!pointVector.direction = !this.valDir.val
!pointVector.position = !!sctlPave.current.position

-- Construct Line from start point and direction
!line = object LINE()
!line.startPosition = !!sctlPave.current.position
!line.endPosition = !pointVector.intersection(!plane)

-- Save Length of Line
!this.valDist.val = !line.length()

!this.arrow()

!this.pickDirection()

endmethod
-- End of method definition for .saveDistance(EDGPICKDATA)
------------------------------------------------------------------------
--
-- Method:      saveDirection
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveDirection()

-- Save Value
!line = object LINE()
!line.startPosition = !!sctlPave.current.position
!line.endPosition = !!sctlPave.plane.near(!!edgGeomData.position)

!this.valDir.val = !line.direction()

!this.arrow()

!this.pickDistance()

endmethod
-- End of method definition for .saveDirection()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

call !!clearAid('ARROW', 43003)

!!edgCntrl.remove('Panel Vertex Relative Direction')
!!edgCntrl.remove('Panel Vertex Relative Distance')

endmethod
-- End of method definition for .dismiss()
