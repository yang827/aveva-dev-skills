-- File:            strpavethru.pmlfrm
--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Wed Mar 18 09:18:29 1998
--
--
-- Description:
-- Form to define a curve on a panel using a through point
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  confirm()                        -                   If confirming then show some aid graphics
--  dismiss()                        -                   Clear up EDG and aid graphics
--  go()                             -                   Complete the action i.e. create or modify the curve
--  pick()                           -
--  save()                           -                   Remember the through point
--
------------------------------------------------------------------------

setup form !!strPaveThru

  !!strPaveThru.formTitle     = 'Vertex definition through point'
  !!strPaveThru.iconTitle     = 'THROUGH'
  !!strPaveThru.callback      = ''
  !!strPaveThru.formRevision  = ' $Revision: 1.9 $ '

-- Members
 member .control is POSITION
 member .arc is ARC

  -- Body of form definition
path right

      button _accept | OK | call |!!strPaveThru.go()| ok
      paragraph _radius text |Radius is Unset        |
-- Bottom Line
  button _cancel |Cancel| call '!!strPaveThru.dismiss()' cancel

exit
-- End of form definition for !!strPaveThru

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick()

!!edgCntrl.remove('Panel Vertex Through')

!packet = object EDGPACKET()

!packet.defineWrapper('POSITION','!!strPaveThru.save()','Pick Through Point')
!packet.description = 'Panel Vertex Through'

!!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick()

------------------------------------------------------------------------
--
-- Method:      go
--
-- Description: Complete the action i.e. create or modify the curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .go()

-- clear aid graphics
call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40102)
call !!clearAid('TEXT', 40102)

-- Remember where we were
!refe = !!ce

!!ce = !!sctlPave.current

-- Split arc according to size
if (!this.arc.angle().abs() gt 135) then
     if (!this.arc.angle().abs() gt 270) then
           !arcs = !this.arc.split(3)
     else
           !arcs = !this.arc.split(2)
     endif
else
     !arcs[1] = !this.arc
endif

-- For each arc calculate pole position
!poles = object ARRAY()

do !each values !arcs

     !poles.append(!each.pole())

enddo

-- Handle first pole position
     if (!!sctlPave.radio.val eq 1) then
    -- Create new vertex
         if (!!ce.owner.type eq 'PLOO') then
               NEW PAVE
         else
               NEW VERT
         endif

     endif
     -- Set attributes

     !cPosString = !poles[1].string()
     POS $!cPosString
     !radius = !this.arc.radius.string()
     FRADIUS $!radius

-- If more than one pole position calculate additional vertex
     if (!poles.size() gt 1) then
          do !index from 2 to !poles.size()
               if (!!ce.owner.type eq 'PLOO') then
                     NEW PAVE
               else
                     NEW VERT
              endif

     -- Set attributes

              !cPosString = !poles[!index].string()
              POS $!cPosString
              !radius = !this.arc.radius.string()
              FRADIUS $!radius
          enddo
     endif

    -- Update Counters
     !!sctlPave.current = !!ce
     !!sctlPave.number = !!ce.owner.members.findFirst(!!ce)

-- Update List
call !!sctlPaveList(!!ce.owner)

!!ce = !refe

!this.dismiss()

endmethod
-- End of method definition for .go()
------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Remember the through point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()

-- Save Value mapped on to plane
!this.control = !!sctlPave.plane.near(!!edgGeomData.position)

-- Display position of origin
     call !!clearAid('SPHERE', 40102)
     call !!drawAidSphere(200,!this.control,40102)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Control',!this.control , 40102)

     !this.confirm()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      confirm
--
-- Description: If confirming then show some aid graphics
-- otherwise complete action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirm()


-- Calculate arc given by points
---------------------------------------
-- Find Number of current Vertex
!number = !!sctlPave.current.owner.members.findFirst(!!sctlPave.current)
-- Find number of next
if (!number eq !!sctlPave.current.owner.mCount) then
     !endNo = 1
else
     !endNo = !number + 1
endif
-- Find number of previous
if (!!sctlPave.radio.val eq 1) then
     !startNo = !number
else
     if (!number eq 1) then
          !startNo = !!sctlPave.current.owner.mCount
     else
          !startNo = !number - 1
     endif
endif
-- Find positions of vertices
     !previous = !!sctlPave.current.owner.members[!startNo].position
     !next = !!sctlPave.current.owner.members[!endNo].position

-- Construct Arc from information available
    !this.arc = !previous.arcThru(!this.control, !next, !!sctlPave.plane.direction() )

-- Draw Aid Cylinder
    if (!this.arc.radius lt 1000mm ) then
          !height = !this.radius
    else
          !height = 1000mm
    endif
    !diameter = 2 * !this.arc.radius
    call !!clearAid('CYLI', 40101)
    call !!drawAidCylinder(!diameter, !height,  !this.arc.position, !!sctlPave.plane.orientation, True, 40101 )
-- Enable accept button
    !this.accept.active = True
    !this.radius.val = 'Radius = ' & !this.arc.radius.string()

endmethod
-- End of method definition for .confirm()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Clear up EDG and aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

!!edgCntrl.remove('Panel Vertex Through')

call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40103)
call !!clearAid('TEXT', 40102)
call !!clearAid('SPHERE', 40102)

!this.accept.active = False
!this.radius.val = |Radius is Unset       |

endmethod
-- End of method definition for .dismiss()
