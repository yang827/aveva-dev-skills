--
--
-- Description:
-- Create section ring
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  circleDefine()                   -                   Define ring section explicitly
--  circlePacket(STRING)             -                   Circle Construction packet
--  close()                          -                   Close form
--  create(ARC)                      -                   create a curved beam
--  create(STRING,STRING,STRING,STRING,STRING,STRING) -                   Display form with passed data
--  createSection()                  -                   Display form for creating section
--  createWall()                     -                   Display form for creating wall
--  modify()                         -                   modify a curved beam or wall
--  strRingCreate()                  -                   Constructor
--
------------------------------------------------------------------------

setup form !!strRingCreate

  !!strRingCreate.formTitle     = 'Curved Sections'
  !!strRingCreate.iconTitle     = 'CurSection'
  !!strRingCreate.callback      = ''
  !!strRingCreate.formRevision  = ' $Revision: 1.16 $ '

  -- Body of form definition

  -- Arc Created
  rgroup .circle 'Circle Definition' frame horizontal
    add tag 'Arc  ' select 'ARC'
    add tag 'Full ' select 'FULL'
  exit

  -- Creation Methods
  frame .createFrame 'Creation Methods' at xmin ymax
    hdist 0
    button .cir3Pnt        at x0.2 y0.6 pixmap width 24 height 24 tooltip 'Through 3 points'                       callback '!this.circlePacket(''3pnt'')'
    button .cirCopy                     pixmap width 24 height 24 tooltip 'Derive from a picked item'              callback '!this.circlePacket(''derive'')'
    button .cirFillet                   pixmap width 24 height 24 tooltip 'Fillet'                                 callback '!this.circlePacket(''fillet'')'
    button .cirTan3Lines                pixmap width 24 height 24 tooltip 'Tangential to 3 lines'                  callback '!this.circlePacket(''tan3lines'')'
    button .cirFRadPntTan               pixmap width 24 height 24 tooltip 'Fixed radius, tangential to a circle'   callback '!this.circlePacket(''fixedradiuspnttan'')'
    button .cirFRad2PntTan at x0.2 ymax pixmap width 24 height 24 tooltip 'Fixed radius, passing through 2 points' callback '!this.circlePacket(''fixedradiuspntpnt'')'
    button .cirPntTan                   pixmap width 24 height 24 tooltip 'Tangential to a circle'                 callback '!this.circlePacket(''pnttan'')'
    button .cirTanTan                   pixmap width 24 height 24 tooltip 'Tangential to 2 circles'                callback '!this.circlePacket(''tantan'')'
    button .cirDia3d                    pixmap width 24 height 24 tooltip 'Derived diameter'                       callback '!this.circlePacket(''diameter3d'')'
    button .cirDia2d                    pixmap width 24 height 24 tooltip 'Derived diameter on working plane'      callback '!this.circlePacket(''diameter2d'')'
    button .cirFDia3d      at x0.2 ymax pixmap width 24 height 24 tooltip 'Fixed diameter'                         callback '!this.circlePacket(''fixeddiameter3d'')'
    button .cirFDia2d                   pixmap width 24 height 24 tooltip 'Fixed diameter on working plane'        callback '!this.circlePacket(''fixeddiameter2d'')'
    button .cirRad3d                    pixmap width 24 height 24 tooltip 'Derived radius'                         callback '!this.circlePacket(''radius3d'')'
    button .cirRad2d                    pixmap width 24 height 24 tooltip 'Derived radius on working plane'        callback '!this.circlePacket(''radius2d'')'
    button .cirFRad3d                   pixmap width 24 height 24 tooltip 'Fixed radius'                           callback '!this.circlePacket(''fixedradius3d'')'
    button .cirFRad2d      at x0.2 ymax pixmap width 24 height 24 tooltip 'Fixed radius on working plane'          callback '!this.circlePacket(''fixedradius2d'')'
    button .cirExplicit                 pixmap width 24 height 24 tooltip 'Define explicitly'                      callback '!this.circleDefine()'
  exit

  -- Modification Methods
  button .flipSense 'Flip Sense' at x0.2 ymax+0.5 callback '!this.modify()' tooltip 'Switch definition from major/minor arc'
  --option .modifyOption  'Modify' at x0.2 ymax+0.5 callback '!this.modify()' width 7

  -- Form Members

  -- Creation Type
  member .mode        is STRING

  -- Storage Data
  member .store       is DBREF
  member .group       is STRING
  member .area        is STRING

  -- Element being created (must be of hardtype GENSEC)
  member .type        is STRING

  -- Display Prompt
  member .prompt      is STRING

  -- Last created section
  member .lastSection is DBREF

exit
-- End of form definition for !!strRingCreate

------------------------------------------------------------------------
--
-- Method:      strRingCreate
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strRingCreate()

  -- Define Arc
  !this.cir3Pnt.addPixmap(!!pml.getPathName('circle3pnt24.png'))
  !this.cirCopy.addPixmap(!!pml.getPathName('circlecopy24.png'))
  !this.cirFillet.addPixmap(!!pml.getPathName('circlefillet24.png'))
  !this.cirTan3Lines.addPixmap(!!pml.getPathName('circletan3lines24.png'))
  !this.cirFRadPntTan.addPixmap(!!pml.getPathName('circlefixradpnttan24.png'))
  !this.cirFRad2PntTan.addPixmap(!!pml.getPathName('circlefrad2pnttan24.png'))
  !this.cirPntTan.addPixmap(!!pml.getPathName('circlepnttan24.png'))
  !this.cirTanTan.addPixmap(!!pml.getPathName('circletantan24.png'))
  !this.cirDia3d.addPixmap(!!pml.getPathName('circledia3d24.png'))
  !this.cirDia2d.addPixmap(!!pml.getPathName('circledia2d24.png'))
  !this.cirFDia3d.addPixmap(!!pml.getPathName('circlefixdia3d24.png'))
  !this.cirFDia2d.addPixmap(!!pml.getPathName('circlefixdia2d24.png'))
  !this.cirRad3d.addPixmap(!!pml.getPathName('circlerad3d24.png'))
  !this.cirRad2d.addPixmap(!!pml.getPathName('circlerad2d24.png'))
  !this.cirFRad3d.addPixmap(!!pml.getPathName('circlefixrad3d24.png'))
  !this.cirFRad2d.addPixmap(!!pml.getPathName('circlefixrad2d24.png'))
  !this.cirExplicit.addPixmap(!!pml.getPathName('constructexplicit24.png'))

  -- Modification options
  --!dText[1] = 'Definition...'
  --!dText[2] = 'Flip Start/End'
  --!dText[3] = 'Flip Sense'
  --!rText[1] = 'DEFINITION'
  --!rText[2] = 'ENDS'
  --!rText[3] = 'SENSE'
  --!this.modifyOption.dText = !dText
  --!this.modifyOption.rText = !rText

  -- Close form
  !this.cancelCall = '!this.close()'

endmethod
-- End of method definition for .strRingCreate()


------------------------------------------------------------------------
--
-- Method:      createSection
--
-- Description: Display form for creating section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSection()

  -- Edit as standard section creation
  !this.create('Ring Section', 'GENSEC', 'BANDC', 'SECTION', 'Define ring section', 'SECTION')

endmethod
-- End of method definition for .createSection()

------------------------------------------------------------------------
--
-- Method:      createWall
--
-- Description: Display form for creating wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createWall()

  -- Edit as standard section creation
  !this.create('Ring Wall', 'WALL', 'WANDF', 'WALL', 'Define ring wall', 'WALL')

endmethod
-- End of method definition for .createWall()

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Display form with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form title
--    2   R      STRING      Element type being created
--    3   R      STRING      Storage group
--    4   R      STRING      Storage area
--    5   R      STRING      Prompt for EDG
--    6   R      STRING      Mode SECTION or WALL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!title is STRING, !type is STRING, !group is STRING, !area is STRING, !prompt is STRING, !mode is STRING)

  -- Check we can create a curved section at this point
  !store = !!getStorageArea(!group, !area)

  -- If store is unset, can we create the panel in or above where we are
  if(!store.unset()) then
    !store = !!dtbOwnerOfType(!!ce, 'GENSEC')

    if(!store.unset()) then
      !!alert.warning('Unable to create ' & !title & ' within this hierarchy structure. Move to an element that can own one or set the appropriate storage area.')
      return

    -- Use new store
    else
    endif
  endif

  -- Initialise Variables
  !this.formTitle           = !title
  !this.type                = !type
  !this.group               = !group
  !this.area                = !area
  !this.prompt              = !prompt
  !this.store               = !store
  !this.mode                = !mode
  !this.flipSense.active    = false

  -- Show form
  !this.show()

endmethod
-- End of method definition for .create(STRING, STRING, STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove any edg event
  !!edgCntrl.remove('Define Ring Section')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      circlePacket
--
-- Description: Circle Construction packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Construction method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circlePacket(!constructMethod is STRING)

  -- Initialise Variables
  !packet                = object EDGPACKET()
  !packet.defineCircle(!constructMethod)
  !packet.input[1]       = 'CIRCLE'
  !packet.key            = 'RingSection'
  !packet.description    = 'Define Ring Section'
  !packet.action         = '!!strRingCreate.create(!this.return[1])'
  !packet.priority       = 1
  !packet.remove         = false
  !packet.type           = 'dbModify'

  -- Change prompt
  !packet.pickPacket.prompt = !this.prompt

  -- Add to edg system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition for .circlePacket(STRING)

------------------------------------------------------------------------
--
-- Method:      circleDefine
--
-- Description: Define ring section explicitly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circleDefine()

  -- Initialise Variables
  -- Load Ring Section definition form
  if(undefined(!!strRingEdit)) then
    pml load form !!strRingEdit
  endif

  -- kick off strRingEdit in create section mode
  if(!this.mode eq 'SECTION') then
    !!strRingEdit.createSection(!this.circle.selection())

  -- kick off strRingEdit in create wall mode
  elseif (!this.mode eq 'WALL') then
    !!strRingEdit.createWall(!this.circle.selection())
  endif

endmethod
-- End of method definition for .circleDefine()

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: create a curved beam
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Circle definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!passedArc is ARC)

 if(!passedArc.unset())then
   return
 endif
  -- If the passed arc diameter is zero or less then return with message
  if (!passedArc.radius le 0) then
    !!alert.error('Diameter too small. Element not created.')
    return
  endif

  -- Temporary fix to core bug re start angle and end angle being equal
  if (!passedArc.startAngle eq !passedArc.endAngle) then
    !passedArc.startAngle   = 0
    !passedArc.endAngle     = 360
  endif
  -- End of Temporary fix to core bug re start angle and end angle being equal

  -- Create section
  !section                  = !!strRingCreate(!passedArc, !this.group, !this.area, !this.store, !this.circle.selection().eq('FULL'), !this.type, !this.mode)

  -- Check section has been created
  if(!section.set()) then
    !this.lastSection       = !section
  endif

  -- Allow modification of last section
  !this.flipSense.active    = !this.lastSection.set()

endmethod
-- End of method definition for .create(ARC)

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: modify a curved beam or wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Validate current element
  --!section = !!ce
  !section = !!dtbGetOwnerType(!this.lastSection, !!dtbSoftTypes.stringSTypesFor('GENSEC'))

  if (!section.hardType eq 'GENSEC') then

    -- Check if it a "ring"
    if(!section.function.upcase() eq 'RING') then

      -- Load Ring Section definition form
      if(undefined(!!strRingEdit)) then
        pml load form !!strRingEdit
      endif

      -- Initialise to current element
      !!strRingEdit.setup(!section)

      -- Reverse the sense
      !!strRingEdit.circle.sense = !!strRingEdit.circle.sense.not()

      -- set the sense on the modify form
      if(!!strRingEdit.circle.sense) then
        !!strRingEdit.sense.val = 1
      else
        !!strRingEdit.sense.val = 2
      endif

      -- Apply the modification
      !!strRingEdit.circleData()
      !!strRingEdit.apply()

     -- To clear away the graphics but would remove edit form if shown
      if (!!strRingEdit.shown().not()) then
        !!strRingEdit.close()
      endif

    else
      -- Return an error
      !!alert.message('You must be at either a RING GENSEC or WALL, navigate to one before using this utility.')
      return
    endif

  endif

return

  -- Identify the option selected
  -- Old code deprecated
  if (!this.modifyOption.selection() eq 'DEFINITION') then
     call !!strSectionEdit(!this.lastSection)
  elseif (!this.modifyOption.selection() eq 'ENDS') then

    -- Always show modify definition
    !this.modifyOption.select('RTEXT','DEFINITION')

    -- Validate current element
    --!section = !!ce
    !section                            = !!dtbGetOwnerType(!this.lastSection, !!dtbSoftTypes.stringSTypesFor('GENSEC'))

      if (!section.hardType eq 'GENSEC') then

      -- Check if it a "ring"
      if(!section.function.upcase() eq 'RING') then

        -- Load Ring Section definition form
        if(undefined(!!strRingEdit)) then
          pml load form !!strRingEdit
        endif

        -- Initialise to current element
        !!strRingEdit.setup(!section)

        -- Transpose to start and end angles
        !startAngle                     = !!strRingEdit.circle.startAngle
        !!strRingEdit.circle.startAngle = !!strRingEdit.circle.endAngle
        !!strRingEdit.circle.endAngle   = !startAngle

        -- Reverse the sense
        !!strRingEdit.circle.sense      = !!strRingEdit.circle.sense.not()

        -- set the sense on the modify form
        if(!!strRingEdit.circle.sense) then
          !!strRingEdit.sense.val       = 1
        else
          !!strRingEdit.sense.val       = 2
        endif

        -- Apply the modification
        !!strRingEdit.apply()

        -- Re-initialise the form
        !!strRingEdit.setup(!section)

        -- To clear away the graphics but would remove edit form if shown
        if (!!strRingEdit.shown().not()) then
          !!strRingEdit.close()
        endif


      else
        -- Return an error
        !!alert.message('You must be at either a RING GENSEC or WALL, navigate to one before using this utility.')
      return
      endif

    else
      -- Return an error
      !!alert.message('You must be at either a RING GENSEC or WALL, navigate to one before using this utility.')
      return
    endif

  elseif (!this.modifyOption.selection() eq 'SENSE') then

    -- Always show modify definition
    !this.modifyOption.select('RTEXT','DEFINITION')

    -- Validate current element
    --!section = !!ce
    !section = !!dtbGetOwnerType(!this.lastSection, !!dtbSoftTypes.stringSTypesFor('GENSEC'))

    if (!section.hardType eq 'GENSEC') then

      -- Check if it a "ring"
      if(!section.function.upcase() eq 'RING') then

        -- Load Ring Section definition form
        if(undefined(!!strRingEdit)) then
          pml load form !!strRingEdit
        endif

        -- Initialise to current element
        !!strRingEdit.setup(!section)

        -- Reverse the sense
        !!strRingEdit.circle.sense = !!strRingEdit.circle.sense.not()

        -- set the sense on the modify form
        if(!!strRingEdit.circle.sense) then
          !!strRingEdit.sense.val = 1
        else
          !!strRingEdit.sense.val = 2
        endif

        -- Apply the modification
        !!strRingEdit.apply()

       -- To clear away the graphics but would remove edit form if shown
        if (!!strRingEdit.shown().not()) then
          !!strRingEdit.close()
        endif

      else
        -- Return an error
        !!alert.message('You must be at either a RING GENSEC or WALL, navigate to one before using this utility.')
      return
      endif

    else
      -- Return an error
      !!alert.message('You must be at either a RING GENSEC or WALL, navigate to one before using this utility.')
      return
    endif

  else
    -- Should not be a fourth option
  endif

endmethod
-- End of method definition for .modify()
