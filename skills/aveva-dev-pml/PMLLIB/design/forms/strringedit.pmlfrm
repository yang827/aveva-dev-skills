------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Setup form to create a "ring" gensec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of curve FULL or ARC
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is setup
--
------------------------------------------------------------------------

define method .create(!type is STRING) is BOOLEAN

  -- Initialise Variables
  !this.formTitle           = 'Create Section (Ring)'
  !this.ceName.val          = 'Create new section ring'

  -- Initialise Form
  !this.section             = object DBREF()

  -- If the circle is undefined, then we'll use a define a default 1M one
  if(!this.circle.unset()) then
    !this.circle            = object ARC(n0 , Y is N, 0, 180, 1000mm, true)
  endif

  -- If full circle type is passed, then force a 360 arc
  if(!type.upcase() eq 'FULL') then
    !this.circle.startAngle = 0
    !this.circle.endAngle   = 360
  endif

  -- Preview
  !this.setup()

  -- Return
  return true

endmethod
-- End of method definition for .create(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form to with current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables

  -- Set Angle & Radius Gadgets
  !this.updateGadgets()

  -- Set default position type
  !this.positionType.select('RTEXT', 'ORIGIN')
  !this.positionType()

  -- Set orientation
  !this.orientation.setOrientation(!this.circle.orientation)

  -- Set with respect to
  !this.setWrt()

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form to modify a "ring" gensec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Gensec to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if form was successfully set up
--
------------------------------------------------------------------------

define method .setup(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  if(!element.hardType ne 'GENSEC') then
    !!alert.warning('Can only modify curved sections')
    return false
  endif
  -- Get section
  !softTypes = !!dtbSoftTypes.stringSTypesFor('GENSEC')
  !type      = !!dtbGetOwnerType(!element, !softTypes)
  !section   = !type

  if(!type.hardType ne 'GENSEC') then
    !!alert.warning('Can only modify a sections that are defined as a "RING".')
    return false
  endif

  -- Check that section has been defined as a "RING", i.e. function is RING
  if(!section.function.upcase() ne 'RING') then
    !!alert.warning('Can only modify a sections that are defined as a "RING".')
    return false
  endif

  -- Get spine
  !spine = !!dtbMemberOfType(!section, 'SPINE', 1)

  -- If there is no spine, don't do anything
  if(!spine.unset()) then
    !!alert.warning('Element (' & !section.flnn & ') has no spine.')
    return false
  endif

  -- Title
  if(!element.type eq 'WALL') then
    !title = 'Modify Wall (Ring)'
  else
    !title = 'Modify Section (Ring)'
  endif

   -- Define Form members
  !this.formTitle  = !title
  !this.ceName.val = !section.flnn
  !this.section    = !section
  !this.spine      = !spine

   -- Convert gensec into an arc
  !this.circle     = !!edgTypes.gensec.arc(!section)

  -- Original sense
  !this.mirror      = !this.circle.sense

  -- Setup form with current data
  !this.setup()

  -- Return
  return true

endmethod
-- End of method definition for .setup(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Create Ring
  if(!this.section.unset() or !this.section.badRef()) then

    -- As this form is only ever shown from the !!strRingCreate form, then it should
    -- be OK to use the form to create the ring. Also we keep a consistent creation
    -- method.
    !!strRingCreate.create(!this.circle)
    return

  -- Modify Ring
  else

    -- Initialise Modify Variables
    !reference = !!ce

    -- Update Gensec position and orientation
    !!ce       = !this.section
    AT          $!<this.circle.position>
    ORIENTATION $!<this.circle.orientation>
    if(!this.circle.sense ne !this.mirror) then
      !this.section.lMirror = !this.section.lMirror.not()
      !this.mirror          = !this.circle.sense
    endif

    -- Set DRNS and DRNE directions always make perpendicular.
    DRNS  PERP
    DRNE  PERP

    -- Common Arc Data
    if (!this.circle.startAngle eq !this.circle.endAngle) then
      !angle                  = 360
      !this.circle.startAngle = 0
      !this.circle.endAngle   = 360
      !this.startAngle.val    = 0
      !this.endAngle.val      = 360
    else
      !angle                  = !this.circle.angle()
    endif
    !start                    = !this.circle.anglePosition(!this.circle.startAngle)
    !end                      = !this.circle.anglePosition(!this.circle.endAngle)

    if (!this.section.type.eq('WALL')) then
      -- Check sense of defined Curve data
      if (!this.circle.sense.not()) then
        !angle = !angle * -1
      endif
    endif

    -- Angle < 360, these are defined as point, curve, point
    if(!angle.sbetween(-360,360)) then

      -- Curve Point
      -- Angle of arc
      !angle          = !this.circle.angle()
      !midAngle       = !this.circle.proportion(0.5)
      if(!midAngle gt 180) then
        !midAngle     = !midAngle - 180
      endif
      !midPoint       = !this.circle.anglePosition(!midAngle)

      if(!this.circle.onProjected(!midPoint).not()) then
        !midAngle     = !midAngle + 180
        if(!midAngle ge 360) then
          !midAngle   = !midAngle - 360
        endif
        !midPoint       = !this.circle.anglePosition(!midAngle)
      endif

      !this.spine.members[1].position   = !start
      !this.spine.members[2].cPosition  = !this.circle.position
      !this.spine.members[2].position   = !midPoint
      !this.spine.members[2].radius     = !this.circle.radius
      !this.spine.members[3].position   = !end

      -- Modify section which have more than 3 points
      if(!this.spine.mCount gt 3) then

        -----------------------------------------------------------------------------
        --                                                                         --
        --  We may need to do something clever where fixing reference the items    --
        --  that are to be deleted.                                                --
        --                                                                         --
        -----------------------------------------------------------------------------

        -- Remove the last two element
        !!ce    = !this.spine
        !max    = !this.spine.mCount
        DELETE SPINE MEMBERS 4 TO $!<max>

      endif


    -- Arc = 360, these are defined as point, curve, point, curve, point
    else

      -- Curve Point
      !quarterPoint = !this.circle.anglePosition((!this.circle.startAngle + !angle * 0.25))
      !midPoint     = !this.circle.anglePosition((!this.circle.startAngle + !angle * 0.5))
      !threeQPoint  = !this.circle.anglePosition((!this.circle.startAngle + !angle * 0.75))

      !this.spine.members[1].position     = !start
      !this.spine.members[2].cPosition    = !this.circle.position
      !this.spine.members[2].position     = !quarterPoint
      !this.spine.members[2].radius       = !this.circle.radius
      !this.spine.members[3].position     = !midPoint

      -- Modify section previously defining an angle <= 180
      if(!this.spine.mCount eq 3) then
        !!ce                              = !this.spine.members.last()

        -- Create the new points
        NEW CURVE CURTYPE THRU RADIUS $!<this.circle.radius> RADS TRUE
        !!ce.cPosition                    = !this.circle.position
        !!ce.position                     = !threeQPoint
        NEW POINSP
        !!ce.position                     = !start

      -- Modify existing > 180 definition
      elseif (!this.spine.mCount eq 5) then
        !this.spine.members[4].cPosition  = !this.circle.position
        !this.spine.members[4].position   = !threeQPoint
        !this.spine.members[4].radius     = !this.circle.radius
        !this.spine.members[5].position   = !end

      -- Someone has played with the definition
      else
        !!alert.warning('Section "RING" has been modified by other means other than the Appware, unable to complete modification.')
        return
      endif

     -----------------------------------------------------------------------------
      --                                                                         --
      --  We may need to do something clever where fixing reference the items    --
      --  that are to be deleted.                                                --
      --                                                                         --
      -----------------------------------------------------------------------------

    endif

    -- Return to where we came from
    !!ce = !reference

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove('Define Ring Section')

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update setting data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateGadgets()

  -- Set gadget data
  !this.startAngle.val  = !this.circle.startAngle
  !this.endAngle.val    = !this.circle.endAngle
  !this.radius.val      = !this.circle.radius

  if(!this.circle.sense) then
    !this.sense.val = 1
  else
    !this.sense.val = 2
  endif

  -- If angle between the start & end is zero (or there about) then we will make
  -- a 360 angle
  if(!this.circle.angle() eq 0) then

    -- If there are five member of the spine, then we have a 360 spine
    if(!this.spine.members.size() eq 5) then
      !this.startAngle.val    = 0
      !this.endAngle.val      = 360
      !this.circle.startAngle = 0
      !this.circle.endAngle   = 360
    endif

  endif

  -- Fix the rounding error where 0 sometimes returns as 0.1785e8EX-04
  if (!this.startAngle.val.nint().eq(0)) then
    !this.startAngle.val = 0
  endif

  if (!this.endAngle.val.nint().eq(0)) then
    !this.endAngle.val   = 0
  endif

endmethod
-- End of method definition for .updateGadgets()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data to passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  -- Modify circle to information for new position
  !type = !this.positionType.selection()
  -- Origin position
  if(!type eq 'ORIGIN') then
    !newPosition           = !position
    !this.circle.position  = !newPosition

  -- Start position
  elseif (!type eq 'START') then
    !circle                = !this.circle.startPosition(!position)
    !this.circle           = !circle
    !newPosition           = !this.circle.anglePosition(!this.circle.startAngle)

  -- End position
  elseif (!type eq 'END') then
    !circle                = !this.circle.endPosition(!position)
    !this.circle           = !circle
    !newPosition           = !this.circle.anglePosition(!this.circle.endAngle)

  -- Radius position (assume zero degrees)
  else

    -- Map position onto arc plane
    !plane                 = object PLANE(!this.circle.position, !this.circle.orientation)
    !newPosition           = !plane.near(!position)

    -- Calculate distance from origin to new position
    !radius                = !this.circle.position.distance(!newPosition)
    !this.circle.radius    = !radius
    !newPosition           = !this.circle.anglePosition(0)

  endif

  -- Assign passed position to form
  !this.position.position(!newPosition, false, false)

  -- Update no position gadgets
  !this.updateGadgets()

  -- Show arc
  !this.preview()

endmethod
-- End of method definition for .setPosition(POSITION)

------------------------------------------------------------------------
--
-- Method:      setOrientation
--
-- Description: Set orientation data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOrientation()

  -- Set circle to orientation object
  !this.circle.orientation = !this.orientation.get()

  -- Set position data to current settings
  !this.positionType()

  -- Preview arc
  !this.preview()

endmethod
-- End of method definition for .setOrientation()

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Set position type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'ORIGIN') then
    !this.position.position(!this.circle.position, false, false)

  -- Start position
  elseif (!type eq 'START') then
    !this.position.position(!this.circle.anglePosition(!this.circle.startAngle), false, false)

  -- End position
  elseif (!type eq 'END') then
    !this.position.position(!this.circle.anglePosition(!this.circle.endAngle), false, false)

  -- Radius position (assume zero degrees)
  else
    !this.position.position(!this.circle.anglePosition(0), false, false)

  endif

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      circleData
--
-- Description: Set circle data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circleData()

  -- Set circle data to form settings
  if (!this.radius.val.unset() or !this.radius.val le 0) then
      !this.radius.val = !this.circle.radius
  endif
  if (!this.startAngle.val.unset() ) then
      !this.startAngle.val = !this.circle.startAngle
  endif
  if (!this.endAngle.val.unset() or !this.endAngle.val eq !this.startAngle.val) then
      !this.endAngle.val = !this.circle.endAngle
  endif
  !this.circle.radius     = !this.radius.val
  !this.circle.startAngle = !this.startAngle.val
  !this.circle.endAngle   = !this.endAngle.val
  !this.circle.sense      = !this.sense.val eq 1

  -- Set position data to current settings
  !this.positionType()

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .circleData()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !gphArc        = object GPHCIRCLE(!this.circle)
  !gphArc.detail = false
  !!aidNumbers.replace(!this.aidNumber, !gphArc)

  -- Tag Start/End
  !start         = !this.circle.anglePosition(!this.circle.startAngle)
  handle any
    !!alert.warning('Specified data produces a degenerate arc.')
    return
  endhandle
  !end           = !this.circle.anglePosition(!this.circle.endAngle)
  AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<start>
  AID TEXT NUMBER $!<this.aidNumber> 'End'   AT $!<end>

  -- Draw axes
  !gphAxes       = object GPHAXES(!this.circle.position, !this.circle.orientation)
  !!aidNumbers.replace(!this.aidAxes, !gphAxes)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!strRingEdit.orientation', 'Orientate Circle')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "gphPlaneEdit" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.priority = 2
  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)
