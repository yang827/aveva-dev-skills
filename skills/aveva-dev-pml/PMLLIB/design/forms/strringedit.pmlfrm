-- File:            strringedit.pmlfrm
--   Type:          Form Definition
--   Group:         String Handling
--     Keyword:     STR
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Aug 24 15:59:09 BST 1998
--
--
-- Description:
-- Standard ring stiffener creation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  circleData()                     -                   Set circle data
--  close()                          -                   Close form and tidy
--  create(STRING)                   BOOLEAN             Setup form to create a "ring" gensec
--  createSection(STRING)            -                   Create a section
--  createWall(STRING)               -                   Create a wall
--  edit(DBREF)                      -                   Edit passed gensec
--  pick()                           -                   Pick a section to edit
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  positionType()                   -                   Set position type
--  preview()                        -                   Preview the plane
--  setOrientation()                 -                   Set orientation data
--  setPosition()                    -                   Set position data
--  setPosition(POSITION)            -                   Set position data to passed position
--  setWrt()                         -                   Set up with new wrt item
--  setup()                          -                   Setup form to with current data
--  setup(DBREF)                     BOOLEAN             Setup form to modify a "ring" gensec
--  strRingEdit()                    -                   Construct
--  tidy()                           -                   Tidy up form data
--  updateGadgets()                  -                   Update setting data
--
------------------------------------------------------------------------

setup form !!strRingEdit

  !!strRingEdit.formTitle     = 'Section (Ring)'
  !!strRingEdit.iconTitle     = 'strRingEdit'
  !!strRingEdit.callback      = ''
  !!strRingEdit.formRevision  = ' $Revision: 1.19 $ '

  -- Body of form definition
  -- Bar Menu
  bar
  exit

  -- Current Element
  paragraph .ceName at xmin ymax width 36 lines 1

  -- Settings
  frame .settingsFrame 'Settings' at xmin ymax width 36

    -- Radius
    text .radius      'Radius ' at x1 ymax callback '!this.circleData()' width 14 is REAL format !!distanceFmt

    -- Angles
    frame .angleFrame 'Angles' at xmin ymax
      text .startAngle 'Start ' at x1 ymax callback '!this.circleData()' width 14 is REAL
      path down
      halign right
      text .endAngle   'End '              callback '!this.circleData()' width 14 is REAL
      rgroup .sense at xmin.startAngle ymax+0.3 horizontal
        add tag |Anti-Clockwise|  call |!this.circleData()|
        add tag |Clockwise|       call |!this.circleData()|
      exit

    exit
  exit

  -- Positioning Gadgets
  frame .posOriFrame 'Position & Orientation' at xmin ymax+0.2 width 36

    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax width 34

      -- Position being modified
      option .positionType callback '!this.positionType()' width 12

      path down
      halign left
      option .ew width 5
      option .ns width 5
      option .ud width 5
      text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
      text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
      text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
      toggle .xFlag at xmax+1 ymin.ew
      toggle .yFlag at xmin   ymin.ns
      toggle .zFlag at xmin   ymin.ud

      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    exit

    -- Orientation Gadgets and Setting
    frame .orientationFrame 'Orientation' at xmin ymax width 34

      -- EDG Set orientation
      button .edgOri3 tooltip 'Orientate using 3 picks (Origin,X,Y)' pixmap width 24 height 24  callback '!this.pickOrientation(''3picks'')'
      path right
      button .edgOri2 tooltip 'Orientate using 2 picks (X,Y)' pixmap width 24 height 24  callback '!this.pickOrientation(''2picks'')'

      text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
      text .zDir 'Z is ' at xmin ymax width 24 is STRING
      halign right
      path down
      paragraph .xDir width 31 lines 1
      halign left
    exit

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' callback '!this.setWrt()' width 26 string
  exit

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()'

  -- Form Members
  -- Basic definition of ring
  member .circle       is ARC

  -- Original Sense of arc
  member .mirror       is BOOLEAN

  -- Aid number being modified
  member .aidCircle    is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL
  member .aidAxes      is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Section
  member .section      is DBREF
  -- Spine
  member .spine        is DBREF

exit
-- End of form definition for !!strRingEdit

------------------------------------------------------------------------
--
-- Method:      strRingEdit
--
-- Description: Construct
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strRingEdit()

  -- Bar menu
  !bar = !this.bar
  !bar.add('Select',    'menuSelect')

  -- Select Item to modify
  !menu = !this.newMenu('menuSelect')
    !menu.add('CALLBACK', 'CE',         '!this.setup(!!ce)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Pick',       '!this.pick()')

  -- Define position types that can be modified
  !dText[1] = 'Origin'
  !rText[1] = 'ORIGIN'
  !dText[2] = 'Radius'
  !rText[2] = 'RADIUS'
  !dText[3] = 'Start Angle'
  !rText[3] = 'START'
  !dText[4] = 'End Angle'
  !rText[4] = 'END'
  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- Orientation Icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!strRingEdit.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!strRingEdit.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!strRingEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!strRingEdit.setPosition()')

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!strRingEdit.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!strRingEdit.setOrientation()')

  -- Aid Lines Number
  !this.aidNumber = !!aidNumbers.add('Ring Section')
  !this.aidAxes   = !!aidNumbers.add('Ring Section')

endmethod
-- End of method definition for .strRingEdit()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Edit passed gensec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Gensec to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if form was successfully set up
--
------------------------------------------------------------------------

define method .edit(!element is DBREF)


  var !coordinate coordinate
  !this.position.linkOption('!!strRingEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Initialise Variable

  -- Setup form
  if(!this.setup(!element)) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()
    !packet.positionLink('!!strRingEdit.position', 'Section')
    !packet.close          = '!!strRingEdit.tidy()'
    !packet.key            = 'RingSection'
    !packet.description    = 'Define Ring Section'
    !packet.form           = !!strRingEdit
    !packet.priority       = 0
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .edit(DBREF)

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Pick a section to edit
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick()

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick curved section to modify')
  !packet.action         = '!!strRingEdit.setup(!this.return[1].item)'
  !packet.key            = 'RingSection'
  !packet.description    = 'Define Ring Section'
  !packet.priority       = 1
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Only allow element with a hard type of gensec to be selected
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.pickPacket.picks[1].pick.input[3]   = 'hardType eq ''GENSEC'' and FUNC eq ''RING'''

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick()

