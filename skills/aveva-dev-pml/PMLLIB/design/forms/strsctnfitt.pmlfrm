--
--
-- Description:
-- Form to define position of fitting on section or wall
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!strSctnFitt

  !!strSctnFitt.formTitle     = 'Position Section Fitting'
  !!strSctnFitt.iconTitle     = 'FITTING'
  !!strSctnFitt.callback      = ''
  !!strSctnFitt.formRevision  = ' $Revision: 1.9 $ '

member .posl   is  STRING
member .fitting is DBREF
member .mode is STRING

  -- Body of form definition
path right
hdist 0.2
vdist 0.2

rgroup _radio
      add tag |Create| call |!this.changeMode('NEW') |
      add tag |Modify| call |!this.changeMode('MODIFY') |
      add tag |Pick  | call |!this.changeMode('PICK') |
exit

paragraph .element  at x 0.2 ymax + 0.2 text | | width 40
button .bang |Rotate 180| at x 0.2 ymax + 0.2 call |!!strSctnFittBang()|
button .spec |Spec...|  call | !!strFittSpecShow('MODIFY', 'FIXING') |

-- Position Line of Fitting
    option .just |Position Line |  call |!!strSctnFittPosl()| width 4

-- Bottom Line
  button .dismiss |Dismiss| at xmax-7 ymax + 0.2 call |!!strSctnFittDism()| ok

exit
-- End of form definition for !!strSctnFitt

------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode (NEW or MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
 define method .changeMode(!mode is STRING)

 !this.mode = !mode
 if (!mode eq |MODIFY| ) then
      !this.spec.callback = | !!strFittSpecShow('MODIFY', 'FIXING') |
 elseif (!mode eq |NEW| ) then
      !this.spec.callback = | !!strSctnSpecShow('NEW', 'FIXING') |
 else

     !!edgCntrl.remove('Pick Section Fitting')
     !!edgCntrl.remove('Position Section Fitting')


     !packet = object EDGPACKET()
     !packet.defineWrapper('SECTION','!!strSctnFitt.changeOwner()','Pick a wall or section')
     !packet.description = 'Pick Section Fitting'

!!edgCntrl.add(!packet)

 endif


endmethod
-- End of method definition for .changeMode(STRING)
------------------------------------------------------------------------
--
-- Method:      changeOwner
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
 define method .changeOwner()

 -- Check same gtype

 if (defined( !!strFittSpec) ) then
      if (!!strFittSpec.owner.gType eq !!edgGeomData.pickedItem.gType ) then
            !!strFittSpec.owner = !!edgGeomData.pickedItem
      else
            !!alert.warning('Gtype is different; use Create>Fitting to reselect specification')
            return
      endif
 endif

-- Build list of plines

      call !!strSctnFittPline(!!edgGeomData.pickedItem)
      !owner = !!strFittSpec.owner

-- Enhance current owner
UNENHANCE ALL
call !!enhanceItem(!owner, 'Salmon' )
!!strSctnFitt.element.val = !owner.flnm

-- Switch back to create mode
   !this.mode = 'NEW'
   !this.radio.val = 1
   !this.spec.callback = | !!strFittSpecShow('NEW', 'FIXING') |
-- set up EDG
!!edgCntrl.remove('Pick Section Fitting')

!packet = object EDGPACKET()
!packet.defineWrapper('POSITION','!!strSctnFittConf()','Pick Position for Fitting')
!packet.description = 'Position Section Fitting'

!!edgCntrl.add(!packet)

endmethod
-- End of method definition for .changeOwner()
