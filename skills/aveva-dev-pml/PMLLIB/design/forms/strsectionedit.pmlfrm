-- File:            strsectionedit.pmlfrm
--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Aug 4 14:05:05 BST 1998
--
--
-- Description:
--   Basic section creation/modification form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply Form
--  close()                          -                   Close form down
--  createSctn()                     -                   Create SCTN definition
--  direction()                      -                   Changes lines start/end position so the lines lies in the defined direction
--  edit(DBREF)                      -
--  length()                         -                   Define with new length
--  positionType()                   -                   Set position type
--  preview()                        -                   Preview new definition
--  setPosition()                    -                   Set position data
--  setPosition(POSITION)            -                   Set position data, with passed position
--  setWrt()                         -                   Set up with new wrt item
--  setup(DBREF)                     BOOLEAN             Setup form with passed element
--  setup(STRING)                    BOOLEAN             Setup form to create new section (default sections in for beams & columns)
--  setup(STRING,STRING,STRING)      BOOLEAN             Setup form to create new section, giving storage group and area
--  strSectionEdit()                 -                   Constructor
--  tidy()                           -                   Tidy up "aid" graphics
--  updateGadgets()                  -                   Update length and direction gadgets with current settings
--
---
------------------------------------------------------------------------

setup form !!strSectionEdit

  !!strSectionEdit.formTitle     = 'Section Definition'
  !!strSectionEdit.iconTitle     = 'Section'
  !!strSectionEdit.callback      = ''
  !!strSectionEdit.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  paragraph .name at xmin ymax width 35 lines 1

  -- Positions
  frame .positionFrame 'Position' at xmin ymax width 35

    -- Position being modified
    option .positionType callback '!this.positionType()' width 12

    path down
    halign left
    option .ew width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' at xmin.ud ymax+0.3 callback '!this.setWrt()' width 26 string

    para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

  exit

  -- Secondary settings
  frame .settingFrame 'Settings' at xmin ymax width 35

    -- Length
    text .length  'Length '      at xmin+4 ymax     callback '!this.length()'    width 14 is REAL format !!distanceFmt

    -- Direction of line
    text .direction 'Direction ' at x1     ymax+0.2 callback '!this.direction()' width 20 is DIRECTION

    -- End Direction
    rgroup .cutPlane 'End Direction' at xmin ymax+0.2 frame horizontal
      add tag ' Maintain' select 'LEAVE'
      add tag ' Perpendicular'    select 'PERP'
    exit

  exit

  -- Apply dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()'

  -- Form Members
  -- Aid line number being modified
  member .aidLine     is REAL

  -- Aid Number
  member .aidNumber   is REAL

  -- Line definition
  member .line        is GPHLINE

  -- From/To position
  member .position    is POSITIONLINK

  -- Current Section
  member .section     is DBREF
  member .wrtElement  is DBREF

  -- Storage Data
  member .group       is STRING
  member .area        is STRING

exit
-- End of form definition for !!strSectionEdit

------------------------------------------------------------------------
--
-- Method:      strSectionEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strSectionEdit()

  -- Set positioning types
  !dText[1] = 'Centre'
  !rText[1] = 'CENTRE'
  !dText[2] = 'Start'
  !rText[2] = 'START'
  !dText[3] = 'End'
  !rText[3] = 'END'

  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- Link Input Gadgets to Objects
  !this.position.linkInput('!!strSectionEdit.position',!this.x, !this.y, !this.z)

  -- Link Lock Gadgets to Objects
  !this.position.linkLock('!!strSectionEdit.position',!this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!strSectionEdit.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Set tagging method up
  !this.position.setAction('!!strSectionEdit.setPosition()')

  -- Get aid number
  !this.aidNumber = !!aidNumbers.add('Section Edit')
  !this.aidLine   = !!aidNumbers.add('Section Edit')

  -- Set defaults for form
  !this.position.position(object POSITION('N0'), false, true)
  !this.wrtElement = WORLD
  !this.wrt.val    = 'World'

  -- Options
  !dText[1] = 'Start'
  !rText[1] = 'START'
  !dText[2] = 'Centre'
  !rText[2] = 'CENTRE'
  !dText[3] = 'End'
  !rText[3] = 'END'

  -- Define datum option
  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

endmethod
-- End of method definition for .strSectionEdit()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if its OK to modify item
--
------------------------------------------------------------------------

-- Define method
define method .setup(!section is DBREF) is BOOLEAN

  -- Initialise Variables

  -- Editing a section
  if(!section.hardType eq 'SCTN') then
    !this.formTitle = 'Modify ' & !section.fullType
    !this.line = object GPHLINE(!!edgTypes.sctn.lineUnprojected(!section))
  else
    !!alert.message('Can only modify section or straight wall.')
    return false
  endif

  -- Can we modify Element
  if(!!dbRefUpdate(!section).not()) then
    !!alert.message(!!error.text)
    return false
  endif

  -- Name
  !this.name.val    = !section.flnn

  -- Setup form
  !this.apply.tag   = '  OK  '
  !this.dismiss.tag = 'Cancel'


  -- Set section data
  !this.section          = !section

  -- Graphical Line Setting
  !this.line.tag         = false
  !this.line.detail      = false

  -- Set Length and direction
  if (!this.line.line.startPosition.distance(!this.line.line.endPosition) eq 0) then
    !this.length.val       = 0
    !this.direction.val    = U
  else
    !this.length.val       = !this.line.line.length()
    !this.direction.val    = !this.line.line.direction()
  endif

  -- Un-Grey end direction (always perpendicular)
  !this.cutPlane.active = true

  -- Setup positions, etc with the selected datum
  !this.positionType()

  -- Return
  return true

endmethod
-- End of method definition for .setup(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form to create new section (default sections in for beams & columns)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of section to be created
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if its OK to create at current storage area
--
------------------------------------------------------------------------

-- Define method
define method .setup(!type is STRING) is BOOLEAN

 return !this.setup(!type, 'BANDC', 'SECTION')

endmethod
-- End of method definition for .setup(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form to create new section, giving storage group and area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of section to be created
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if its OK to create at current storage area
--
------------------------------------------------------------------------

-- Define method
define method .setup(!type is STRING, !group is STRING, !area is STRING) is BOOLEAN

  -- Initialise Variables
  !this.group = !group
  !this.area  = !area

  -- Check for storage area
  !store = !!getStorageArea(!this.group, !this.area)

  -- Can we create in the storage area
  if(!store.set()) then
    if(!!dbRefUpdate(!store).not()) then
      !!alert.warning('Unable to write to storage area (' & !!error.text  & ').')
      return false
    endif

  -- No are set
  else
    !!alert.message('No storage has been defined, on "Apply" will try an create in current hierarchy position.')
  endif

  -- Name
  !this.name.val    = 'New Section'

  -- Initialise Variables
  !this.apply.tag   = 'Apply'
  !this.dismiss.tag = 'Dismiss'
  !this.formTitle   = 'Create Section'

  -- Set section data
  !this.section          = object DBREF()

  -- Define a line
  if(!this.line.coreObject().unset()) then
    !line      = object LINE(n0, u1000)
    !this.line = object GPHLINE(!line)
  endif

  -- Graphical Line Setting
  !this.line.tag         = false
  !this.line.detail      = false

  -- Set Length and direction
  !this.length.val       = !this.line.line.length()
  !this.direction.val    = !this.line.line.direction()

  -- Grey-out end direction (always perpendicular)
  !this.cutPlane.select('PERP')
  !this.cutPlane.active = false

  -- Setup positions, etc with the selected datum
  !this.positionType()

  -- Return
  return true

endmethod
-- End of method definition for .setup(STRING, STRING, STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .edit(!section is DBREF)

  -- Link Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!strSectionEdit.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Setup form
  if(!this.setup(!section)) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()
    !packet.positionLink('!!strSectionEdit.position', 'Modify Position')
    !packet.close          = '!!strSectionEdit.tidy()'
    !packet.key            = 'explicitPosition'
    !packet.description    = 'Section Definition'
    !packet.form           = !!strSectionEdit
    !packet.priority       = 0
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .edit(DBREF)

------------------------------------------------------------------------
--
-- Method:      createSctn
--
-- Description: Create SCTN definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .createSctn()

  -- Setup form
  if(!this.setup('SCTN')) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()
    !packet.positionLink('!!strSectionEdit.position', 'Modify Position')
    !packet.close          = '!!strSectionEdit.tidy()'
    !packet.key            = 'explicitPosition'
    !packet.description    = 'Section Definition'
    !packet.form           = !!strSectionEdit
    !packet.priority       = 0
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .createSctn()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise Variables
  !refNo       = !!ce
  !line        = !this.line.coreObject()

  -- Modify Section
  if(!this.section.set()) then

    -- Move to section
    !!ce         = !this.section
    POSSTART $!<line.startPosition>
    POSEND   $!<line.endPosition>
    if(!this.cutPlane.selection() eq 'PERP') then
      DRNS PERP
      DRNE PERP
    endif
    !!ce         = !refNo

    -- Hide form
    !this.close()

  -- Create Section
  else

    !store = !!getStorageArea(!this.group, !this.area)

    -- Some way of checking we can create a section
    if(!store.unset()) then

    endif

    NEW SCTN
    POSSTART $!<line.startPosition>
    POSEND   $!<line.endPosition>
    DRNS PERP
    DRNE PERP
    SPREF /BS-SPEC/406.40x10.0
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide form
  !this.hide()

  -- Tidy up form
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove('Section Definition')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up "aid" graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide aid elements
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidLine)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update length and direction gadgets with current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateGadgets()

  -- Set gadget data
  !this.direction.val = !this.line.line.direction()
  !this.length.val    = !this.line.line.length()

endmethod
-- End of method definition for .updateGadgets()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data, with passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    New derived position
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  -- Modify circle to information for new position
  !type = !this.positionType.selection()

  -- Assign passed position to form
  !this.position.position(!position, false, false)

  -- Start position
  if(!type eq 'START') then
    !this.line.line.startPosition = !this.position.position()

  -- End position
  elseif (!type eq 'END') then
    !this.line.line.endPosition   = !this.position.position()

  -- Centre position
  else
    !this.line.line = !!appMathLib.gmfLine.copyAt(!this.line.line, !this.position.position())

  endif

  -- Update no position gadgets
  !this.updateGadgets()

  -- Show arc
  !this.preview()

endmethod
-- End of method definition for .setPosition(POSITION)

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Set position type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'START') then
    !this.position.position(!this.line.line.startPosition, false, true)

  -- Start position
  elseif (!type eq 'END') then
    !this.position.position(!this.line.line.endPosition, false, true)

  -- Centre position
  else
    !this.position.position(!this.line.line.proportion(0.5), false, true)
  endif

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview new definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidLine, !this.line)

  -- Tag end/start
  !position = !this.position.position()
  !tag      = !this.positionType.selection('DTEXT')
  AID TEXT NUMBER $!<this.aidLine> '$!tag' AT $!<position>

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Changes lines start/end position so the lines lies in the defined direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .direction()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'START') then
    !line = !this.line.line.direction(!this.direction.val)

  -- Start position
  elseif (!type eq 'END') then
    !line = !this.line.line.reverseSense().direction(!this.direction.val.opposite()).reverseSense()

  -- Centre position
  else

    -- Move line to the centre of the current definition
    !line = object LINE(!this.line.line.proportion(0.5), !this.line.line.endPosition)
    !line = !line.direction(!this.direction.val).setLengthStart(!this.line.line.length())

  endif

  !this.line.line = !line

  -- Redefine unposition gadgets
  !this.updateGadgets()

  -- Update position gadget
  !this.positionType()

endmethod
-- End of method definition for .direction()

------------------------------------------------------------------------
--
-- Method:      length
--
-- Description:  Define with new length
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .length()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'START') then
    !line = !this.line.line.setLengthEnd(!this.length.val)

  -- Start position
  elseif (!type eq 'END') then
    !line = !this.line.line.setLengthStart(!this.length.val)

  -- Centre position
  else

    -- Move line to the centre of the current definition
    !line = !this.line.line.offset(!this.line.line.direction(), !this.line.line.length() / 2)
    !line = !line.setLengthEnd(!this.length.val / 2)
    !line = !line.setLengthStart(!this.length.val)

  endif

  !this.line.line = !line

  -- Redefine unposition gadgets
  !this.updateGadgets()

  -- Update position gadget
  !this.positionType()

endmethod
-- End of method definition for .length()
