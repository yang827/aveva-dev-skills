--
--
-- Description:
-- Spine editing form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form
--  confirm()                        -                   Set confirm status
--  curveType(STRING)                -                   Select curve type
--  edit(DBREF)                      -                   Setup form for editing and add to event stack
--  measureRadius(LINE)              -                   Write measurement to radius gadget
--  measureRadius(MENU,STRING)       -                   Measure radius
--  pointType(STRING)                -                   Select point type
--  position()                       -                   Position
--  position(POSITION)               -                   Position
--  positionType()                   -                   Update position with current position data
--  preview()                        -                   Preview current and associated points
--  preview(GMFSPINEPOINT,GMFSPINEPOINT,GMFSPINEPOINT) -                   Preview passed point information
--  radius()                         -                   Set radius of item
--  remove()                         -                   Remove curve
--  remove(DBREF,BOOLEAN)            -                   Remove curve point and its previous/next control point
--  resolveCentre(GMFSPINEPOINT,GMFSPINEPOINT,GMFSPINEPOINT,POSITION,POSITION) BOOLEAN             Resolves centre defined curves with the new passed data
--  resolveFillet(POSITION,GMFSPINEPOINT,GMFSPINEPOINT,GMFSPINEPOINT,POSITION,POSITION) BOOLEAN             Resolves fillet defined curves with the new passed data
--  resolvePoint(POSITION,GMFSPINEPOINT,GMFSPINEPOINT,GMFSPINEPOINT,POSITION,POSITION) BOOLEAN             Resolves point definition with the new passed data
--  resolvePosition(POSITION)        BOOLEAN             Resolves the position of point with the passed position. If it can resolve the position, it will set !this.currentPoint's position
--  resolveRadius(REAL)              BOOLEAN             Resolves the radius for the passed spine point. If it can resolve the radius, it will set !this.currentPoint's position
--  selectCurve(REAL)                -                   Select the passed curve point
--  setup(DBREF)                     BOOLEAN             Setup form with passed section
--  strSpineEdit()                   -                   Constructor
--  tagPosition()                    -                   Tag position point
--  tidy()                           -                   Tidy graphics
--  tidyWorking()                    -                   Tidy graphics
--  update()                         -                   Determine the previous and next points
--  updateSpine()                    -                   Update the spine definition
--
------------------------------------------------------------------------

setup form !!strSpineEdit

  !this.formTitle     = 'Modify Section (Curved)'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  -- Bar menu
  bar
  exit

  -- Loop positioning
  frame .navigateFrame 'Spine Point' at xmin ymax

    -- Spine point
    option .pointType   at x0.5 ymax                               tooltip 'Spine point'            callback '!this.pointType(!this.pointType.selection())' width 5
    path right
    text   .sequence                                               tooltip 'Curve number      '     callback '!this.selectCurve(!this.sequence.val)' width 3 is REAL
    valign top
    button .next        at xmax ymin-0.1 pixmap height 3  width 7  tooltip 'Move to next curve'     callback '!this.selectCurve(!this.sequence.val + 1)'
    button .previous    at xmin ymax     pixmap height 3  width 7  tooltip 'Move to previous curve' callback '!this.selectCurve(!this.sequence.val - 1)'

    -- Curve type
    option .curveType   at xmax.1 ymin.sequence                    tooltip 'Curve type'             callback '!this.curveType(!this.curveType.selection())' width 6
  exit

  -- Create new curve
  --  button .createCurve at xmax+1           ymin+0.25 pixmap height 16 width 16 tooltip 'Create curve' callback '!this.create()'
  path right
  valign bottom
  button .removeCurve       pixmap height 16 width 16 tooltip 'Remove curve' callback '!this.remove()'

  -- Positioning command
  frame .attributesFrame 'Attributes' at xmin.navigateFrame ymax.navigateFrame width 40

    -- Origin/Position option
    option .positionType at x0.5   y1.25   callback '!this.positionType()' width 8
    text   .x        'X' at xmax+1 ymin                                    width 14 is REAL format !!distanceFmt
    path   down
    halign right
    text   .y        'Y'                                                   width 14 is REAL format !!distanceFmt
    text   .radius   'Radius'              callback '!this.radius()'       width 14 is REAL format !!distanceFmt

    button .accept   'Modify' at xmax ymin callback '!this.updateSpine()'

    -- Lock toggles
    toggle .xLock at xmax.x+1 ymin.x states 'false' 'true'
    toggle .yLock at xmax.y+1 ymin.y states 'false' 'true'

    paragraph .lock at xmax.x ymin.x-0.75 text 'Lock'

  exit

  -- Form members

  -- Event Description
  member .edgDescription   is STRING

  -- Gensec
  member .genericSection   is DBREF

  -- Spine Name
  member .spine            is DBREF

  -- Spine definition
  member .definition       is GMFSPINE

  -- Number of Curve points
  member .curves           is REAL

  -- Create mode
  member .create           is BOOLEAN

  -- Routing plane (gensec orientation/position)
  member .plane            is PLANE

  -- xyPosition
  member .xyPosition       is XYPOSITIONLINK

  -- Aid Numbers
  member .aidNumber        is REAL
  member .aidAxes          is REAL
  member .aidText          is REAL
  member .aidPrevious      is REAL
  member .aidNext          is REAL
  member .aidPreviousLine  is REAL
  member .aidNextLine      is REAL

  -- Previous Current and Next points
  member .previousPoint   is GMFSPINEPOINT
  member .previousControl is POSITION
  member .currentPoint    is GMFSPINEPOINT
  member .nextPoint       is GMFSPINEPOINT
  member .nextControl     is POSITION


exit
-- End of form definition for !!strSpineEdit

--------------------------------------------------------------------------
--
-- Method: strSpineEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------
define method .strSpineEdit()

  -- Initialise Variables
  !this.sequence.val       = 0
  !this.edgDescription     = ' Str Spine Editor'

  -- Define point types
  !dText                   = ARRAY()
  !rText                   = ARRAY()
  !dText[1]                = 'Start'
  !rText[1]                = 'START'
  !dText[2]                = 'Curve'
  !rText[2]                = 'CURVE'
  !dText[3]                = ' End '
  !rText[3]                = 'END'
  !this.pointType.dText    = !dText
  !this.pointType.rText    = !rText

  -- Define curve types
  !dText                   = ARRAY()
  !rText                   = ARRAY()
  !dText[1]                = 'Fillet'
  !rText[1]                = 'FILLET'
  !dText[2]                = 'Centre'
  !rText[2]                = 'CENTRE'
  !this.curveType.dText    = !dText
  !this.curveType.rText    = !rText

  -- build menu bar
  !bar = !this.bar
  !bar.add('Control',     'controlMenu')
  !bar.add('Settings',    'settingMenu')
--  !bar.add('Utilities',   'utilityMenu')

  -- Control menu
  !menu = !this.newMenu('controlMenu')
    !menu.add('callback', 'Close',     '!this.close()')

  -- Settings menu
  !menu = !this.newMenu('settingMenu')
    !menu.add('toggle', 'Confirm',     '!this.confirm()')
    !menu.add('toggle', 'Confirm on delete',     '')

  -- Settings menu
--  !menu = !this.newMenu('utilityMenu')
--    !menu.add('callback', 'Align control points',     '!this.alignControl()')

  -- Distance
  !menu = !this.newMenu('radiusMenu')
    !menu.add('CALLBACK', 'Measure',                    '!this.measureRadius(')
    !menu.add('CALLBACK', 'Measure Shortest',           '!this.measureRadius(')
  !this.radius.setPopup(!this.radiusMenu)

  -- Cancel callback
  !this.cancelCall = '!this.close()'

  -- Link xy position
  !this.xyPosition.linkInput('!!strSpineEdit.xyPosition',!this.x, !this.y)
  !this.xyPosition.linkLock('!!strSpineEdit.xyPosition',!this.xLock, !this.yLock)

  !this.xyPosition.setAction('!!strSpineEdit.position()')

  -- Set keyboard focus
  !this.keyboardFocus = !this.x

  -- Icon definitions
  !this.previous.addPixmap(!!pml.getPathName('downarrow7x3.png'))
  !this.next.addPixmap(!!pml.getPathName('uparrow7x3.png'))

  --  !this.createCurve.addPixmap(!!pml.getPathName('createArc16.png'), !!pml.getPathName('createArc16.png'), !!pml.getPathName('unknownIcon16.png'))
  !this.removeCurve.addPixmap(!!pml.getPathName('deletece16.png'),!!pml.getPathName('deletece16.png'), !!pml.getPathName('unknownicon16.png'))

  -- Set default settings
  !this.settingMenu.select('Confirm',           true)
  !this.settingMenu.select('Confirm on delete', true)

  -- Aid numbers
  !this.aidNumber       = !!aidNumbers.add('Structure Spine Editor')
  !this.aidAxes         = !!aidNumbers.add('Structure Spine Editor')
  !this.aidText         = !!aidNumbers.add('Structure Spine Editor')
  !this.aidPrevious     = !!aidNumbers.add('Structure Spine Editor')
  !this.aidNext         = !!aidNumbers.add('Structure Spine Editor')
  !this.aidPreviousLine = !!aidNumbers.add('Structure Spine Editor')
  !this.aidNextLine     = !!aidNumbers.add('Structure Spine Editor')

endmethod
-- End of method definition for .strSpineEdit()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with passed section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section name
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop can be modified
--
------------------------------------------------------------------------
define method .setup(!element is DBREF) is BOOLEAN


  -- Check if we have access to modify spine
  if(!!dbRefUpdate(!element).not()) then
    !!alert.warning(!!error.text)
    return false
  endif

  -- Initialise Variables
  !this.genericSection = !element
  !this.spine          = !!dtbMemberOfType(!element,'SPINE',1)
  !this.plane          = object PLANE(!element.position, !element.orientation)

  -- Get definition of spine
  !this.definition     = object GMFSPINE(!this.spine)

  -- Definition Data
  !this.curves         = !this.definition.curvePoints()

  -- Mode
  !this.create         = false

  -- Draw axes
  !axes                = object GPHAXES(!element)
  !axes.draw(!this.aidAxes)

  -- Set U, V or X, Y
  if (!!coords.isxyz() ) then
    if(!axes.xyz ) then
      !this.x.tag = 'U'
      !this.y.tag = 'V'
    else
      !this.x.tag = 'X'
      !this.y.tag = 'Y'
    endif
  else
    !this.x.tag = 'X'
    !this.y.tag = 'Y'
  endif

  -- Select the first vertex
  !this.pointType('START')

  -- Return
  return true

endmethod
-- End of method definition for .setup(DBREF) BOOLEAN

--------------------------------------------------------------------------
--
-- Method: edit
--
-- Description: Setup form for editing and add to event stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------

define method .edit(!element is DBREF)

  -- Initialise Variables
  !prompt = 'Modify spine'

  -- Setup form
  if(!this.setup(!element)) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()
    !packet.definePosition(!prompt)
    !packet.action         = '!!strSpineEdit.position(!this.return[1].position)'
    !packet.close          = '!!strSpineEdit.tidy()'
    !packet.key            = 'GenericSectionDefinition'
    !packet.description    = !this.edgDescription
    !packet.form           = !!strSpineEdit
    !packet.priority       = 0
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .edit(DBREF)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Remove any EDG state for form
  !!edgCntrl.remove(!this.edgDescription)

  -- Tidy graphics
  !this.tidy()

  -- Hide the form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()

  -- Remove
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

  -- Remove working aid numbers
  !this.tidyWorking()

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      tidyWorking
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidyWorking()

  -- Remove
  !!aidNumbers.hide(!this.aidText)
  !!aidNumbers.hide(!this.aidPrevious)
  !!aidNumbers.hide(!this.aidNext)
  !!aidNumbers.hide(!this.aidPreviousLine)
  !!aidNumbers.hide(!this.aidNextLine)

endmethod
-- End of method definition for .tidyWorking()

------------------------------------------------------------------------
--
-- Method:      confirm
--
-- Description: Set confirm status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirm()

  -- If confirm mode or we are creating a point, then un-grey the accept button
  if(!this.settingMenu.selected('Confirm')) then
    !this.accept.active = true

  -- Grey out accept button
  else
    !this.accept.active = false
  endif

endmethod
-- End of method definition for .confirm()

------------------------------------------------------------------------
--
-- Method:      pointType
--
-- Description: Select point type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Point Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointType(!type is STRING)

  -- Initialise Variables
  !dText     = ARRAY()
  !rText     = ARRAY()
  !pointType = !type.upcase().trim()
  !this.pointType.select('RTEXT', !pointType)

  -- Force previous and next control point to be unset
  !this.previousControl = object POSITION()
  !this.nextControl     = object POSITION()

  -- Start or End
  if(!pointType inset('START','END')) then

    -- Grey-out curve points
    !this.sequence.active    = false
    !this.previous.active    = false
    !this.next.active        = false
    !this.curveType.active   = false
    !this.radius.active      = false

    -- Stop start/end point being delete
    !this.removeCurve.active = false

    -- Update position type if we need to
    if(!this.currentPoint.type ne 'CONTROL') then
      !dText.append('Position')
      !rText.append('POSITION')
      !dText.append('Extend')
      !rText.append('EXTEND')
      !this.positionType.dText = !dText
      !this.positionType.rText = !rText

    endif
    if(!pointType eq 'START') then
      !this.currentPoint    = !this.definition.startPoint()
    else
      !this.currentPoint    = !this.definition.endPoint()
    endif

    -- Update position gadgets
    !this.positionType()

    -- Display current point
    !this.update()

  -- Curve definition
  else

    -- Grey-in curve points
    !this.sequence.active    = true
    !this.previous.active    = true
    !this.next.active        = true
    !this.curveType.active   = true
    !this.radius.active      = true

    -- Allow curves to be deleted
    !this.removeCurve.active = true

    -- Set selection to item
    !this.selectCurve(!this.sequence.val)

  endif
  !this.accept.active = false

endmethod
-- End of method definition for .pointType(STRING)

------------------------------------------------------------------------
--
-- Method:      curveType
--
-- Description: Select curve type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Point Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curveType(!type is STRING)

  -- Initialise Variables


  -- Check if we are defining by fillet, check we can handle it
  if(!type.upcase() eq 'FILLET') then
    if(!this.currentPoint.arc.angle() gt 170) then
      !!alert.warning('Unable to fillet curve of angle greater than 170 degrees.')
      !this.curveType.select('RTEXT','CENTRE')
      return
    endif
  endif

  !this.currentPoint.type    = !type

  -- Set curve type to passed type
  !this.curveType.select('RTEXT',!type)

  -- Fillet Curves
  if(!type eq 'FILLET') then
    !dText[1]                = 'Fillet'
    !rText[1]                = 'POLAR'

  -- Centre Curves
  else
    !dText[1]                = 'Centre'
    !rText[1]                = 'CENTRE'

  endif

  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- Update position gadgets
  !this.positionType()

endmethod
-- End of method definition for .curveType(STRING)

------------------------------------------------------------------------
--
-- Method:      selectCurve
--
-- Description: Select the passed curve point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Sequence
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectCurve(!curveNumber is REAL)

  -- Initialise Variables
  !sequence = !curveNumber
  !maximum  = !this.curves

  -- Check that we are in the bounds of the spine
  -- Off the start
  if(!sequence.unset() or !sequence le 0) then
    !sequence = 1

  -- Off the end
  elseif (!sequence gt !maximum) then
    !sequence = !maximum
  endif

  -- If sequence equals current sequence, then don't do anything
--  if(!sequence eq !this.sequence.val) then
--    return
--  endif

  -- Set Curve Type
  !this.currentPoint = !this.definition.curvePoint(!sequence)
  !this.curveType(!this.currentPoint.type)

  -- Set sequence
  !this.sequence.val = !sequence

  -- Set radius
  !this.radius.val   = !this.currentPoint.arc.radius

  -- Display current point
  !this.update()

endmethod
-- End of method definition for .selectCurve(REAL)

------------------------------------------------------------------------
--
-- Method:      updateSpine
--
-- Description: Update the spine definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateSpine()

  -- Initialise Variables
  !reference = !!ce
  !pointType = !this.pointType.selection()
  !point     = !this.currentPoint.point

  -- Update previous current and next

  if(!this.previousPoint.set()) then

    -- Preceding point is a curve so we may need to update?
    if(!this.previousPoint.arc.set()) then
    endif

  endif

  -- Update point

  -- Move control point
  if(!this.currentPoint.arc.unset()) then

    -- Move start
    if(!pointType eq 'START') then
      --!unusedStart = !this.definition.startPoint()

      -- Modify definition point
      !!ce   = !point
      AT  $!<this.currentPoint.position>


    -- Move end
    else
      !end   = !this.definition.endPoint()

      -- Modify definition point
      !!ce   = !point
      AT $!<this.currentPoint.position>
    endif


  -- Move/change curve
  else

    -- Change the radius
    !!ce = !point

    -- Setup curve to current definition
    CURTYPE $!<this.currentPoint.type>
    RADIUS $!<this.currentPoint.arc.radius>


    -- Fillet curve
    if(!this.currentPoint.type eq 'FILLET') then
      AT   $!<this.currentPoint.position>
      CPOS $!<this.currentPoint.arc.position>

    -- Centre Curve
    elseif (!this.currentPoint.type eq 'CENTRE') then
      AT   $!<this.currentPoint.arc.position>
      CPOS $!<this.currentPoint.position>

    endif

    -- Update previous and next control points
    if(!this.previousControl.set()) then
      PREVIOUS POINSP
      AT $!<this.previousControl>
    endif

    if(!this.nextControl.set()) then
      NEXT POINSP
      AT $!<this.nextControl>
    endif

  endif

  -- Get definition of spine
  !this.definition     = object GMFSPINE(!this.spine)

  -- Definition Data
  !this.curves         = !this.definition.curvePoints()

  -- Return to original item
  !!ce = !reference

  -- Grey-out modify button
  !this.accept.active  = false

endmethod
-- End of method definition for .updateSpine()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Determine the previous and next points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .update()

  -- Initialise Variables

  -- Start point
  if(!this.pointType.selection() eq 'START') then
    !this.previousPoint   = object GMFSPINEPOINT()
    !this.nextPoint       = !this.definition.curvePoint(1)

  -- End point
  elseif (!this.pointType.selection() eq 'END') then
    !this.previousPoint   = !this.definition.curvePoint(!this.curves)
    !this.nextPoint       = object GMFSPINEPOINT()

  -- Curve Point
  else

    -- Previous Point
    if(!this.sequence.val eq 1) then
      !this.previousPoint = !this.definition.startPoint()
    else
      !this.previousPoint = !this.definition.curvePoint(!this.sequence.val - 1)
    endif

    -- Next Point
    if(!this.sequence.val eq !this.curves) then
      !this.nextPoint     = !this.definition.endPoint()
    else
      !this.nextPoint     = !this.definition.curvePoint(!this.sequence.val + 1)
    endif

  endif

  -- Preview Current and associated points
  !this.preview()

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview current and associated points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .preview()

  -- Initialise Variables
  !this.preview(!this.currentPoint, !this.previousPoint, !this.nextPoint)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview passed point information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFSPINEPOINT Current point
--    2   R      GMFSPINEPOINT Previous point
--    3   R      GMFSPINEPOINT next point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .preview(!currentPoint is GMFSPINEPOINT, !previousPoint is GMFSPINEPOINT, !nextPoint is GMFSPINEPOINT)

  -- Initialise Variables
 !this.tidyWorking()
  !detailArc        = false
  !detailLine       = false

  -- Curve flag for points
  !arrive        = object LINE()
  !leave         = object LINE()

  -- Current point
  if(!currentPoint.arc.unset()) then
    !arrive.endPosition   = !currentPoint.position
    !leave.startPosition  = !currentPoint.position

  -- Current point is a Curve
  else
    !arrive.endPosition   = !currentPoint.arc.anglePosition(!currentPoint.arc.startAngle)
    !leave.startPosition  = !currentPoint.arc.anglePosition(!currentPoint.arc.endAngle)

    -- Arc definition
    !garc        = object GPHCIRCLE(!currentPoint.arc)
    !garc.tag    = false
    !garc.detail = !detailArc
    !garc.draw(!this.aidNumber)

  endif

  -- Draw Previous point
  if(!previousPoint.arc.unset()) then
    !arrive.startPosition = !previousPoint.position

  -- Previous is a Curve
  else
    if(!previousPoint.type eq 'FILLET') then
      !arrive.startPosition = !previousPoint.position
    else
      !arrive.startPosition = !previousPoint.arc.anglePosition(!previousPoint.arc.endAngle)
    endif

    -- Arc definition
    !garc         = object GPHCIRCLE(!previousPoint.arc)
    !garc.tag     = false
    !garc.detail  = !detailArc
    !garc.draw(!this.aidPrevious)

  endif

  -- Draw Next point
  if(!nextPoint.arc.unset()) then
    !leave.endPosition    = !nextPoint.position

  -- Next is a Curve
  else
    if(!nextPoint.type eq 'FILLET') then
      !leave.endPosition    = !nextPoint.position
    else
      !leave.endPosition    = !nextPoint.arc.anglePosition(!nextPoint.arc.startAngle)
    endif

    -- Arc definition
    !garc         = object GPHCIRCLE(!nextPoint.arc)
    !garc.tag     = false
    !garc.detail  = !detailArc
    !garc.draw(!this.aidNext)

  endif

  -- Draw arrive/leave lines
  if(!previousPoint.position.set()) then
    !gline        = object GPHLINE(!arrive)
    !gline.detail = !detailLine
    !gline.draw(!this.aidPreviousLine)
  endif

  if(!nextPoint.position.set()) then
    !gline        = object GPHLINE(!leave)
    !gline.detail = !detailLine
    !gline.draw(!this.aidNextLine)
  endif

  -- Tag current position point
  !this.tagPosition()

endmethod
-- End of method definition for .preview(GMFSPINEPOINT, GMFSPINEPOINT, GMFSPINEPOINT)

------------------------------------------------------------------------
--
-- Method:      tagPosition
--
-- Description: Tag position point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagPosition()

  -- Initialise Variables

  -- Get position from form gadget, as this hold the current position of
  -- "positionType" without the need to re-calculate it each time.
  !position      = !this.plane.threeDPosition(!this.xyPosition.xyPosition())

  -- Curve Point
  if(!this.pointType.selection() eq 'CURVE') then
    !text        = !this.pointType.selection('DTEXT').trim() & ' ' & !this.positionType.selection('DTEXT').trim()
  else
    !text        = !this.pointType.selection('DTEXT').trim() & ' ' & !this.positionType.selection('DTEXT').trim()
  endif
   AID TEXT NUMBER $!<this.aidText> '$!text' AT $!<position>

endmethod
-- End of method definition for .tagPosition()

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Update position with current position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .positionType()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidText)

  !type = !this.positionType.selection().trim().upcase()

  -- Position
  if(!type inset('POSITION','EXTEND')) then
    !position = !this.currentPoint.position

  -- Polar point
  elseif (!type eq 'POLAR') then
    !position = !this.currentPoint.arc.pole()

  -- Centre of arc
  elseif (!type eq 'CENTRE') then
    !position = !this.currentPoint.arc.position

  -- Unhandled types
  else
    return
  endif

  -- Update position gadget
  !this.xyPosition.xyPosition(!this.plane.xyOffset(!position),false, true)

   -- Tag current position point
  !this.tagPosition()

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .position()

  -- Initialise Variables

  -- Get position
  !newPosition = !this.xyPosition.xyPosition()

  -- Put position on sections plane
  !position = !this.plane.threeDPosition(!newPosition)

  -- Resolve the new position
  if(!this.resolvePosition(!position)) then

    -- Re-define position
    !this.xyPosition.xyPosition(!this.plane.xyOffset(!position), false, true)

    -- Update position
    if(!this.settingMenu.selected('Confirm').not()) then
      !this.updateSpine()

    -- Modify on accept
    else


      -- Allow modify button to be picked
      !this.accept.active  = true
    endif

    -- Update data
    !this.preview()

  -- Unable to resolve new radius
  else
    !this.positionType()
  endif


endmethod
-- End of method definition for .position()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position picked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .position(!position is POSITION)

  -- Initialise Variables

  -- Map position onto plane
  !newPosition = !this.plane.near(!position)

  -- Update xy gadgets
  !this.xyPosition.xyPosition(!this.plane.xyOffset(!newPosition), false, false)

  -- Update with position
  !this.position()

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      resolvePosition
--
-- Description: Resolves the position of point with the passed position. If it can resolve the position, it will set !this.currentPoint's position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can resolve the point
--
------------------------------------------------------------------------

define method .resolvePosition(!position is POSITION) is BOOLEAN

  -- Initialise Variables
--  !positionType         = !this.positionType.selection().trim().upcase()
  !point                = !this.currentPoint
  !previousPoint        = !this.previousPoint
  !nextPoint            = !this.nextPoint
  !this.previousControl = object POSITION()
  !this.nextControl     = object POSITION()
  !previousControl      = !this.previousControl
  !nextControl          = !this.nextControl

  -->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Centre Curve <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
  if(!point.type eq 'CENTRE') then

    -- Reposition point centre
    !point.arc.position     = !position

    if(!this.resolveCentre(!point, !previousPoint, !nextPoint, !previousControl, !nextControl)) then
      !this.currentPoint    = !point
      !this.previousControl = !previousControl
      !this.nextControl     = !nextControl
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint

    else
      return false
    endif

  -->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Fillet Curve <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
  elseif (!point.type eq 'FILLET') then

    if(!this.resolveFillet(!position, !point, !previousPoint, !nextPoint, !previousControl, !nextControl)) then
      !this.currentPoint    = !point
      !this.previousControl = !previousControl
      !this.nextControl     = !nextControl
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint
    else
      return false
    endif

  -- >>>>>> Point (with a point either the previous or next point should be unset as we <<<<<<<
  -- >>>>>> only recognise points at the start or end of the beam)                      <<<<<<<
  else

    -- Reposition point centre
    if(!this.resolvePoint(!position, !point, !previousPoint, !nextPoint, !previousControl, !nextControl)) then
      !this.currentPoint    = !point
      !this.previousControl = !previousControl
      !this.nextControl     = !nextControl
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint

    else
      return false
    endif
  endif
  return true

endmethod
-- End of method definition for .resolvePosition(POSITION) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: Set radius of item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius()

  -- Initialise Variables

  -- Check radius is > zero
  if(!this.radius.val le 0) then
    !!alert.warning('Radius must be greater than zero.')
    !this.radius.val = !this.currentPoint.arc.radius
    return
  endif

  !radius = !this.radius.val
  -- Resolve new arc
  if(!this.resolveRadius(!radius)) then

    !this.radius.val = !radius

    -- Update position
    if(!this.settingMenu.selected('Confirm').not()) then
      !this.updateSpine()

    -- Modify on accept
    else

      -- Allow modify button to be picked
      !this.accept.active  = true
    endif

    -- Update data
    !this.preview()

  -- Unable to resolve new radius
  else
    !this.radius.val = !this.currentPoint.arc.radius
  endif

endmethod
-- End of method definition for .radius()

------------------------------------------------------------------------
--
-- Method:      resolveRadius
--
-- Description: Resolves the radius for the passed spine point. If it can resolve the radius, it will set !this.currentPoint's position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        New radius
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can resolve the point
--
------------------------------------------------------------------------

define method .resolveRadius(!radius is REAL) is BOOLEAN

  -- Initialise Variables
  !point                = !this.currentPoint
  !previousPoint        = !this.previousPoint
  !nextPoint            = !this.nextPoint
  !this.previousControl = object POSITION()
  !this.nextControl     = object POSITION()
  !previousControl      = !this.previousControl
  !nextControl          = !this.nextControl

  -- Centre curve
  if(!point.type eq 'CENTRE') then

    !point.arc.radius   = !radius
    !previousControl    = object POSITION()
    !nextControl        = object POSITION()

    if(!this.resolveCentre(!point, !previousPoint, !nextPoint, !previousControl, !nextControl)) then
      !this.currentPoint    = !point
      !this.previousControl = !previousControl
      !this.nextControl     = !nextControl
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint
    else
      return false
    endif

  -- Fillet Curve
  elseif (!point.type eq 'FILLET') then

    !polePosition       = !point.arc.pole()
    !point.arc.radius   = !radius
    !angle              = !point.arc.angle() / 2
    !direction          = !polePosition.direction(!point.arc.position)
    !distance           = !radius / !angle.cosine()

    -- Determine centre position
    !point.arc.position = !polePosition.offset(!direction, !distance)
    !point.arc.radius   = !radius

    if(!this.resolveFillet(!polePosition, !point, !previousPoint, !nextPoint, !previousControl, !nextControl)) then
      !this.currentPoint    = !point
      !this.previousControl = !previousControl
      !this.nextControl     = !nextControl
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint
    else
      return false
    endif

  -- Point
  else
    !!alert.warning('Unable to modify radius of a control point.')
    return false
  endif

  -- Modify current arc radius
  !this.currentPoint = !point

  return true

endmethod
-- End of method definition for .resolveRadius(REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      resolveCentre
--
-- Description: Resolves centre defined curves with the new passed data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GMFSPINEPOINT New definition to check
--    2   RW     GMFSPINEPOINT Previous point definition
--    3   RW     GMFSPINEPOINT Next point definition
--    4   RW     POSITION      Previous control point
--    5   RW     POSITION      Next control point
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can resolve the point
--
------------------------------------------------------------------------

define method .resolveCentre(!point is GMFSPINEPOINT, !previousPoint is  GMFSPINEPOINT, !nextPoint is  GMFSPINEPOINT, !previousPosition is POSITION, !nextPosition is POSITION) is BOOLEAN

  -- Initialise Variables

  -- Point in space (start)
  if(!previousPoint.type ne 'CENTRE') then

    -- Fillet point
    if(!previousPoint.type eq 'FILLET') then
      !previousControl  = true
      !previousPosition = !previousPoint.position
      !previousArc      = !previousPoint.arc

    -- Position point
    else
      !previousControl  = false
      !previousPosition = !previousPoint.position
      !previousArc      = object ARC()
    endif

  -- Centre point
  elseif (!previousPoint.type eq 'CENTRE') then
    !previousControl  = true
    !previousPosition = !previousPoint.arc.anglePosition(!previousPoint.arc.endAngle)
    !previousArc      = !previousPoint.arc
  endif

  -- Point in space (end)
  if(!nextPoint.type ne 'CENTRE') then

    -- Fillet point
    if(!nextPoint.type eq 'FILLET') then
      !nextControl   = true
      !nextPosition  = !nextPoint.position
      !nextArc       = !nextPoint.arc

    -- Position point
    else
      !nextControl   = false
      !nextPosition  = !nextPoint.position
      !nextArc       = object ARC()
    endif

  -- Centre point
  elseif (!nextPoint.type eq 'CENTRE') then
    !nextControl     = true
    !nextPosition    = !nextPoint.arc.anglePosition(!nextPoint.arc.startAngle)
    !nextArc         = !nextPoint.arc

  endif

  -- Determine the arrive line
  if(!previousPoint.type ne 'CENTRE') then
    !arriveLine   = !!appMathLib.gmfLine.pntTan(!previousPosition, !point.arc, !point.arc.anglePosition(!point.arc.startAngle))
    handle any
      return false
    endhandle
  else
    !arriveLine = !!appMathLib.gmfLine.tanTan(!previousArc, !previousPosition, !point.arc, !point.arc.anglePosition(!point.arc.startAngle))
    handle any
      return false
    endhandle
  endif

 -- Determine the Leave line
  if(!nextPoint.type ne 'CENTRE') then
    !leaveLine  = !!appMathLib.gmfLine.pntTan(!nextPosition, !point.arc, !point.arc.anglePosition(!point.arc.endAngle))
    handle any
      return false
    endhandle
  else
    !leaveLine  = !!appMathLib.gmfLine.tanTan(!nextArc, !nextPosition, !point.arc, !point.arc.anglePosition(!point.arc.endAngle))
    handle any
      return false
    endhandle
  endif

  !point.position    = !point.arc.anglePosition(!point.arc.angle() / 1 + !point.arc.startAngle)

  -- Do the lines cross
  !iPosition = !arriveLine.intersection(!leaveLine)
  if(!arriveLine.onProjected(!iPosition)) then

    -- Flip line control point to opposite side of arc
    !point.position    = !point.arc.anglePosition(!point.arc.near(!iPosition) + 180)

    -- Determine the arrive line
    if(!previousPoint.type ne 'CENTRE') then
      !arriveLine = !!appMathLib.gmfLine.pntTan(!previousPosition, !point.arc, !point.position)
      handle any
        return false
      endhandle
    else
      !this.preview(!previousPoint, !point, !nextPoint)
      !arriveLine = !!appMathLib.gmfLine.tanTan(!previousArc, !previousPosition, !point.arc, !point.position)
      handle any
        return false
      endhandle
    endif

    -- Determine the Leave line
    if(!nextPoint.type ne 'CENTRE') then
      !leaveLine  = !!appMathLib.gmfLine.pntTan(!nextPosition, !point.arc, !point.position)
      handle any
        return false
      endhandle
    else
      !leaveLine  = !!appMathLib.gmfLine.tanTan(!nextArc, !nextPosition, !point.arc, !point.position)
      handle any
        return false
      endhandle
    endif

  endif

  -- If still overlapping lines, the we have an unresolved arc
  !iPosition = !arriveLine.intersection(!leaveLine)
  if(!arriveLine.onProjected(!iPosition)) then
    !!alert.warning('Unresolvable position')
    return false
  endif

  -- Update start/end angle of point
  !point.arc.startAngle         = !point.arc.near(!arriveLine.endPosition)
  !point.arc.endAngle           = !point.arc.near(!leaveLine.endPosition)
  !angle                        = !point.arc.angle()
  !point.position               = !point.arc.anglePosition(!point.arc.near(!iPosition))

  -- Modify previous arc
  if(!previousPoint.type eq 'CENTRE') then
    !previousPoint.arc.endAngle = !previousPoint.arc.near(!arriveLine.startPosition)

  elseif (!previousPoint.type eq 'FILLET') then
    !arcEnd                     = !previousArc.anglePosition(!previousArc.startAngle)
    !previousPoint.arc          = !!appMathLib.gmfArc.fillet(!previousArc.radius,  !arcEnd, !previousPosition, !arriveLine.endPosition)
    !arriveLine                 = !previousPoint.arc.anglePosition(!previousPoint.arc.endAngle).line(!point.arc.anglePosition(!point.arc.startAngle))
  endif

  -- Modify next arc
  if(!nextPoint.type eq 'CENTRE') then
    !nextPoint.arc.startAngle   = !nextPoint.arc.near(!leaveLine.startPosition)

  elseif (!nextPoint.type eq 'FILLET') then
    !arcEnd                     = !nextArc.anglePosition(!nextArc.endAngle)
    !nextPoint.arc              = !!appMathLib.gmfArc.fillet(!nextArc.radius,  !leaveLine.endPosition, !nextPosition, !arcEnd)
    !leaveLine                  = !point.arc.anglePosition(!point.arc.endAngle).line(!nextPoint.arc.anglePosition(!nextPoint.arc.startAngle))
  endif

  -- Update return data
  if(!previousControl) then
    !previousPosition = !arriveLine.proportion(0.5)
  else
    !previousPosition = object POSITION()
  endif

  if(!nextControl) then
    !nextPosition     = !leaveLine.proportion(0.5)
  else
    !nextPosition     = object POSITION()
  endif

  return true

endmethod
-- End of method definition for .resolveCentre(GMFSPINEPOINT,  GMFSPINEPOINT,  GMFSPINEPOINT, POSITION, POSITION) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      resolveFillet
--
-- Description: Resolves fillet defined curves with the new passed data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION      New fillet position
--    2   RW     GMFSPINEPOINT New definition to check
--    3   RW     GMFSPINEPOINT Previous point definition
--    4   RW     GMFSPINEPOINT Next point definition
--    5   RW     POSITION      Previous control point
--    6   RW     POSITION      Next control point
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can resolve the point
--
------------------------------------------------------------------------

define method .resolveFillet(!position is POSITION, !point is GMFSPINEPOINT, !previousPoint is  GMFSPINEPOINT, !nextPoint is  GMFSPINEPOINT, !previousPosition is POSITION, !nextPosition is POSITION) is BOOLEAN

  -- Initialise Variables
  !filletPosition    =  !position

  -- Point in space (start)
  if(!previousPoint.type ne 'CENTRE') then

    -- Fillet point
    if(!previousPoint.type eq 'FILLET') then
      !previousControl  = true
      !previousPosition = !previousPoint.arc.pole()
      !previousArc      = !previousPoint.arc

    -- Position point
    else
      !previousControl  = false
      !previousPosition = !previousPoint.position
      !previousArc      = object ARC()
    endif

  -- Centre point
  elseif (!previousPoint.type eq 'CENTRE') then
    !previousControl  = true
    !previousPosition = !previousPoint.arc.anglePosition(!previousPoint.arc.endAngle)
    !previousArc      = !previousPoint.arc
  endif

  -- Point in space (end)
  if(!nextPoint.type ne 'CENTRE') then

    -- Fillet point
    if(!nextPoint.type eq 'FILLET') then
      !nextControl   = true
      !nextPosition  = !nextPoint.arc.pole()
      !nextArc       = !nextPoint.arc

    -- Position point
    else
      !nextControl   = false
      !nextPosition  = !nextPoint.position
      !nextArc       = object ARC()
    endif

  -- Centre point
  elseif (!nextPoint.type eq 'CENTRE') then
    !nextControl     = true
    !nextPosition    = !nextPoint.arc.anglePosition(!nextPoint.arc.startAngle)
    !nextArc         = !nextPoint.arc

  endif

  -- Determine the arrive line
  if(!previousPoint.type ne 'CENTRE') then
    !arriveLine = !filletPosition.line(!previousPosition)
    handle any
      return false
    endhandle
  else
    !arriveLine = !!appMathLib.gmfLine.pntTan(!filletPosition, !previousArc, !previousPosition)
    handle any
      return false
    endhandle
  endif

 -- Determine the Leave line
  if(!nextPoint.type ne 'CENTRE') then
    !leaveLine = !filletPosition.line(!nextPosition)
    handle any
      return false
    endhandle
  else
    !leaveLine = !!appMathLib.gmfLine.pntTan(!filletPosition, !nextArc, !nextPosition)
    handle any
      return false
    endhandle
  endif

  !point.arc                    = !!appMathLib.gmfArc.fillet(!point.arc.radius, !arriveLine, !arriveLine.endPosition, !leaveLine, !leaveLine.endPosition)
  !point.position               = !filletPosition

  -- Modify previous arc
  if(!previousPoint.type eq 'CENTRE') then
    !previousPoint.arc.endAngle = !previousPoint.arc.near(!arriveLine.endPosition)
    !arriveLine                 = object LINE(!previousPoint.arc.anglePosition(!previousPoint.arc.endAngle), !point.arc.anglePosition(!point.arc.startAngle))
  elseif (!previousPoint.type eq 'FILLET') then
    !arcEnd                     = !previousArc.anglePosition(!previousArc.startAngle)
    !previousPoint.arc          = !!appMathLib.gmfArc.fillet(!previousArc.radius,  !arcEnd, !previousPosition, !arriveLine.startPosition)
    !arriveLine                 = !previousPoint.arc.anglePosition(!previousPoint.arc.endAngle).line(!point.arc.anglePosition(!point.arc.startAngle))
    !arriveLine                 = object LINE(!previousPoint.arc.anglePosition(!previousPoint.arc.endAngle), !point.arc.anglePosition(!point.arc.startAngle))
  endif

  -- Modify next arc
  if(!nextPoint.type eq 'CENTRE') then
    !nextPoint.arc.startAngle   = !nextPoint.arc.near(!leaveLine.endPosition)
    !leaveLine                  = object LINE(!point.arc.anglePosition(!point.arc.endAngle), !nextPoint.arc.anglePosition(!nextPoint.arc.startAngle))
  elseif (!nextPoint.type eq 'FILLET') then
    !arcEnd                     = !nextArc.anglePosition(!nextArc.endAngle)
    !nextPoint.arc              = !!appMathLib.gmfArc.fillet(!nextArc.radius, !leaveLine.startPosition, !nextPosition,  !arcEnd)
    !leaveLine                  = object LINE(!point.arc.anglePosition(!point.arc.endAngle), !nextPoint.arc.anglePosition(!nextPoint.arc.startAngle))
  endif

  -- Update return data
  if(!previousControl) then
    if(!arriveLine.startPosition.distance(!arriveLine.endPosition) gt 0) then
      !previousPosition = !arriveLine.proportion(0.5)
    else
      !previousPosition = !arriveLine.startPosition
    endif
  else
    !previousPosition   = object POSITION()
  endif

  if(!nextControl) then
    if(!leaveLine.startPosition.distance(!leaveLine.endPosition) gt 0) then
      !nextPosition     = !leaveLine.proportion(0.5)
    else
      !nextPosition     = !leaveLine.startPosition
    endif
  else
    !nextPosition       = object POSITION()
  endif

  return true

endmethod
-- End of method definition for .resolveFillet(POSITION, GMFSPINEPOINT,  GMFSPINEPOINT,  GMFSPINEPOINT, POSITION, POSITION) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      resolvePoint
--
-- Description: Resolves point definition with the new passed data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     POSITION      New position for point
--    2   RW     GMFSPINEPOINT New definition to check
--    3   RW     GMFSPINEPOINT Previous point definition
--    4   RW     GMFSPINEPOINT Next point definition
--    5   RW     POSITION      Previous control point
--    6   RW     POSITION      Next control point
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can resolve the point
--
------------------------------------------------------------------------

define method .resolvePoint(!position is POSITION, !point is GMFSPINEPOINT, !previousPoint is  GMFSPINEPOINT, !nextPoint is  GMFSPINEPOINT, !previousPosition is POSITION, !nextPosition is POSITION) is BOOLEAN

  -- Initialise Variables
  !positionType = !this.positionType.selection().trim().upcase()

  -- EXTEND end point
  if(!positionType eq 'EXTEND') then
    !end    = !this.pointType.selection().trim().upcase()

    -- Extend start
    if(!end eq 'START') then
     !line = !point.position.line(!nextPoint.arc.anglePosition(!nextPoint.arc.startAngle))
    else
     !line = !point.position.line(!previousPoint.arc.anglePosition(!previousPoint.arc.endAngle))
    endif

    -- Move start in direction through the given point
    !plane             = object PLANE()
    !plane.position    = !position
    !plane.orientation = object ORIENTATION('Z is ' & !line.direction())
    !position          = !plane.intersection(!line)
    !point.position    = !position

    return true

  endif

  -- Move point to new position
  !point.position = !position

  -- Next point defined
  if(!previousPoint.set()) then

    -- Next point a fillet curve
    if(!previousPoint.type eq 'FILLET') then

      -- Line from point to point
      !fillet      = !previousPoint.arc.pole()

      -- Resolve next fillet arc
      !arrivePoint = !previousPoint.arc.anglePosition(!previousPoint.arc.startAngle)
      !arriveLine  = !arrivePoint.line(!fillet)
      !leaveLine   = !fillet.line(!point.position)

      -- Re-calculate the arc
      !newArc      = !!appMathLib.gmfArc.fillet(!previousPoint.arc.radius, !arriveLine, !arriveLine.startPosition, !leaveLine, !leaveLine.endPosition)

      !newLeave    = !newArc.anglePosition(!newArc.endAngle)
      !newLine   = !fillet.line(!newLeave)

      if(!newLine.onProjected(!point.position)) then
        !!alert.warning('Invalid position (point lies within the fillet arc).')
        return false
      endif

      !previousPoint.arc = !newArc

    -- Previous point is a centre curve
    elseif (!previousPoint.type eq 'CENTRE') then

      -- Arrive Line
      !arriveLine    = !!appMathLib.gmfLine.pntTan(!point.position, !previousPoint.arc, !previousPoint.arc.anglePosition(!previousPoint.arc.endAngle))
      handle any
        return false
      endhandle

      !previousPoint.arc.endAngle = !previousPoint.arc.near(!arriveLine.endPosition)

    endif


  -- Next point defined
  elseif(!nextPoint.set()) then


    -- Next point a fillet curve
    if(!nextPoint.type eq 'FILLET') then

      -- Line from point to point
      !fillet     = !nextPoint.arc.pole()

      -- Resolve next fillet arc
      !arriveLine = !position.line(!fillet)
      !leavePoint = !nextPoint.arc.anglePosition(!nextPoint.arc.endAngle)
      !leaveLine  = !fillet.line(!leavePoint)

      -- Re-calculate the arc
      !newArc     = !!appMathLib.gmfArc.fillet(!nextPoint.arc.radius, !arriveLine, !arriveLine.startPosition, !leaveLine, !leaveLine.endPosition)

      !newArrive  = !newArc.anglePosition(!newArc.startAngle)
      !newLine    = !newArrive.line(!fillet)

      if(!newLine.onProjected(!position)) then
        !!alert.warning('Invalid position (point lies within the fillet arc).')
        return false
      endif

      !nextPoint.arc = !newArc

    -- Next point is a centre curve
    elseif (!nextPoint.type eq 'CENTRE') then

     -- Leave Line
      !leaveLine    = !!appMathLib.gmfLine.pntTan(!point.position, !nextPoint.arc, !nextPoint.arc.anglePosition(!nextPoint.arc.startAngle))
      handle any
        return false
      endhandle

      !nextPoint.arc.startAngle = !nextPoint.arc.near(!leaveLine.endPosition)

    endif

  endif

  return true

endmethod
-- End of method definition for .resolvePoint(POSITION, GMFSPINEPOINT,  GMFSPINEPOINT,  GMFSPINEPOINT, POSITION, POSITION) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      measureRadius
--
-- Description: Measure radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .measureRadius(!menu is MENU, !dummySelect is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()
  !packet = object EDGPACKET()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then
    !packet.defineMeasure('distance')

  -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then
    !packet.defineMeasure('shortest')
  endif

  !packet.description = !this.edgDescription
  !packet.action      = '!!strSpineEdit.measureRadius(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .measureRadius(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measureRadius
--
-- Description: Write measurement to radius gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measureRadius(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.radius.val = 0
  else
    !this.radius.val = !line.length()
  endif

  !this.radius()

endmethod
-- End of method definition for .measureRadius(LINE)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .remove()

  -- Initialise Variables
  !currentPoint     = !this.currentPoint
  !previousPoint    = !this.previousPoint
  !nextPoint        = !this.nextPoint
  !previousControl  = object POSITION()
  !nextControl      = object POSITION()
  !endFlag          = false

  -- Check that we always have at least one curve
  if(!this.curves eq 1) then
    !!alert.warning('Unable to delete the only curve from the spine (spine definitions must have at least one curve point).')
  endif

  -- Define new "Current" point

  -- If previous point is not a curve, then make next point the current
  -- Use previous point
  if(!previousPoint.type inset('FILLET', 'CENTRE')) then

    -- New current point
    !currentPoint  = !previousPoint

    -- Set sequence
    !sequence      = !this.sequence.val - 1

    -- If current curve is the second, then get the start point as the previous point
    if(!sequence eq 1) then
      !previousPoint = !this.definition.startPoint()
      if(!this.curves eq 2) then
        !previousFlag  = true
      else
        !previousFlag  = false
      endif

    -- Previous curve
    else
      !previousPoint = !this.definition.curvePoint(!sequence - 1)
      !previousFlag  = true

    endif

  -- Use next point
  else

    -- New current point
    !currentPoint    = !nextPoint

    -- Set sequence
    !sequence        = !this.sequence.val + 1

    -- If current curve is the second, then get the start point as the previous point
    if(!sequence eq !this.curves) then
      !nextPoint     = !this.definition.endPoint()
      if(!this.curves eq 2) then
        !previousFlag  = false
      else
        !previousFlag  = true
      endif
      !endFlag       = true

    -- Previous curve
    else
      !nextPoint     = !this.definition.curvePoint(!sequence + 1)
      !previousFlag  = false

    endif

  endif

  -->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Centre Curve <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
  if(!currentPoint.type eq 'CENTRE') then

    if(!this.resolveCentre(!currentPoint, !previousPoint, !nextPoint, !previousControl, !nextControl)) then

      -- Prompt to delete
      if(!this.settingMenu.selected('Confirm on delete')) then
        !this.preview(!currentPoint, !previousPoint, !nextPoint)
        if(!!alert.confirm('OK to delete curve?').boolean().not()) then
          !this.preview()
          return
        endif
      endif

      -- Remove the old curve and its control point
      !this.remove(!this.currentPoint.point, !previousFlag)
--      if(!!debug) then
--        return
--      endif

      -- Rebuild spine from the start
      !this.sequence.val    = !sequence

       -- Get definition of spine
      !this.definition      = object GMFSPINE(!this.spine)

      -- Definition Data
      !this.curves          = !this.definition.curvePoints()

      -- Set new definitions
      !this.currentPoint    = !currentPoint
      !this.previousControl = !previousControl
      if(!endFlag) then
        !this.nextControl   = !nextPoint.position
      else
        !this.nextControl   = !nextControl
      endif
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint

      -- Update spine
      !this.updateSpine()
      !this.pointType(!this.pointType.selection())

    else
      !!alert.warning('A' & !!error.text)
    endif

  -->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Fillet Curve <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
  elseif (!currentPoint.type eq 'FILLET') then
    !position = !currentPoint.position
    if(!this.resolveFillet(!position, !currentPoint, !previousPoint, !nextPoint, !previousControl, !nextControl)) then

      -- Prompt to delete
      if(!this.settingMenu.selected('Confirm on delete')) then
        !this.preview(!currentPoint, !previousPoint, !nextPoint)
        if(!!alert.confirm('OK to delete curve?').boolean().not()) then
          !this.preview()
          return
        endif
      endif

      -- Remove the old curve and its control point
      !this.remove(!this.currentPoint.point, !previousFlag)
--      if(!!debug) then
--        return
--      endif

      -- Rebuild spine from the start
      !this.sequence.val    = !sequence

       -- Get definition of spine
      !this.definition      = object GMFSPINE(!this.spine)

      -- Definition Data
      !this.curves          = !this.definition.curvePoints()

      -- Set new definitions
      !this.currentPoint    = !currentPoint
      !this.previousControl = !previousControl
      if(!endFlag) then
        !this.nextControl   = !nextPoint.position
      else
        !this.nextControl   = !nextControl
      endif
      !this.previousPoint   = !previousPoint
      !this.nextPoint       = !nextPoint

      -- Update spine
      !this.updateSpine()
      !this.pointType(!this.pointType.selection())

    else
      !!alert.warning('B' & !!error.text)
    endif

  endif

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove curve point and its previous/next control point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Curve point to remove
--    2   R      BOOLEAN     True if previous point is to be removed
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .remove(!curve is DBREF, !previousFlag is BOOLEAN)

  -- Initialise Variables
  !reference = !!ce

  -- Get previous/next controlling point
  if(!previousFlag) then
    !controlPoint = !curve.owner.members[!curve.sequence - 1]
  else
    !controlPoint = !curve.owner.members[!curve.sequence + 1]
  endif
  PIN1 AT $!curve
  PIN2 AT $!controlPoint
  -- Remove the curve and control point
--  if(!!debug.not()) then
    !!ce = !curve
    DELETE CURVE
    !!ce = !controlPoint
    DELETE POINSP
--  endif

  -- Return to reference
  !!ce = !reference
  handle any
  endhandle

endmethod
-- End of method definition for .remove(DBREF, BOOLEAN)

