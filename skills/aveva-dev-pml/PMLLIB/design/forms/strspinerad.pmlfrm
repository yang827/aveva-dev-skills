--   Type:          Form Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Thu Mar 26 08:28:56 1998
--
--
-- Description:
-- Form for radius definition of arc in spine
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  confirm()                        -                   If confirming then show some aid graphics
--  dismiss()                        -                   Clear up EDG and aid graphics
--  flip()                           -                   Switch between major and minor arc
--  go()                             -                   Complete the action i.e. create or modify the curve
--  pick(STRING)                     -
--  saveControl()                    -                   Remember the fillet point and if radius already defined
--  saveRadius(REAL)                 -                   Complete the action i.e. create or modify the curve
--  typeRadius()                     -                   Save typed radius value and check if we have enough information
--
------------------------------------------------------------------------

setup form !!strSpineRad

  !!strSpineRad.formTitle     = 'Vertex definition by radius'
  !!strSpineRad.iconTitle     = 'RADIUS'
  !!strSpineRad.callback      = ''
  !!strSpineRad.formRevision  = ' $Revision: 1.11 $ '

-- Members
 member .radius is REAL
 member .control is POSITION
 member .start is POSITION
 member .arc is ARC

  -- Body of form definition

path down
  rgroup _radio
      add tag |Control Point| call |!!strSpineRad.pick('Control')|
      add tag |Define Radius from Two Points| call |!!strSpineRad.pick('Start')|
  exit
  toggle _major |Major Arc| call |!!strSpineRad.flip()|
  path right
  text _value |Radius| call |!!strSpineRad.typeRadius()|  width 16 is REAL format !!distanceFmt

-- Bottom Line
  button _accept | OK | at xmin_major ymax call |!!strSpineRad.go()| ok
  button _cancel |Cancel| call '!!strSpineRad.dismiss()' cancel

exit
-- End of form definition for !!strSpineRad

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode CONTROL or START or FINISH
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick(!mode is STRING)

!!edgCntrl.remove('Spine Vertex Radius Control')
!!edgCntrl.remove('Spine Vertex Radius Radius')

!packet = object EDGPACKET()

if (!mode.upcase() eq 'CONTROL' ) then
     !packet.defineWrapper('POSITION','!!strSpineRad.saveControl()','Pick Control Point')
     !packet.description = 'Spine Vertex Radius Control'
     !this.radio.val = 1
elseif (!mode.upcase() eq 'START') then
     !packet.defineWrapper('POSITION','!!strSpineRad.saveRadius(1)','Define Radius:First Point')
     !packet.description = 'Spine Vertex Radius Radius'
     !this.radio.val = 2
else
     !packet.defineWrapper('POSITION','!!strSpineRad.saveRadius(2)','Define Radius:Second Point')
     !packet.description = 'Spine Vertex Radius Radius'
     !this.radio.val = 2
endif

!!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick(STRING)

------------------------------------------------------------------------
--
-- Method:      go
--
-- Description: Complete the action i.e. create or modify the curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .go()

-- clear aid graphics
call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40102)
call !!clearAid('TEXT', 40103)

-- Remember where we were
!refe = !!ce

!!ce = !!sctlSpine.current

-- Handle first pole position
     if (!!sctlSpine.radio.val eq 1) then
          NEW CURVE

     endif
     -- Set attributes

     CURTYPE RADI
-- Calculate midpoint of arc
     !arcs = !this.arc.split(2)
     !cPosString = !arcs[1].anglePosition(!arcs[1].endAngle)

     CPOS $!cPosString
     !radius = !!strSpineRad.radius.string()
     RADIUS $!radius

    -- Update Counters
     !!sctlSpine.current = !!ce
     !!sctlSpine.number = !!ce.owner.members.findFirst(!!ce)

-- Update List
call !!sctlSpineList(!!ce.owner)

!!ce = !refe

!this.dismiss()

endmethod
-- End of method definition for .go()
------------------------------------------------------------------------
--
-- Method:      saveControl
--
-- Description: Remember the fillet point and if radius already defined
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveControl()

-- Save Value mapped on to plane
!this.control = !!sctlSpine.plane.near(!!edgGeomData.position)

-- Display position of origin
     call !!clearAid('SPHERE', 40102)
     call !!drawAidSphere(200,!this.control,40102)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Control',!this.control , 40102)

-- Switch EDG
  !this.pick('START')

-- See if we have enough information to complete
if (Set(!this.radius) ) then
        !this.confirm()
endif

endmethod
-- End of method definition for .saveControl()
------------------------------------------------------------------------
--
-- Method:      flip
--
-- Description: Switch between major and minor arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flip()

-- See if we have enough information to complete
if (Set(!this.radius) and Set(!this.control) ) then
        !this.confirm()
endif

endmethod
-- End of method definition for .flip()

------------------------------------------------------------------------
--
-- Method:      saveRadius
--
-- Description: Complete the action i.e. create or modify the curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL        First or second pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveRadius(!number is REAL)

if (!number eq 1) then
  -- Save Value
     !this.start = !!edgGeomData.position

-- Display position of origin
     call !!clearAid('SPHERE', 40103)
     call !!drawAidSphere(200,!this.start,40103)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Start',!this.start , 40103)
    -- Switch EDG
       !this.pick('END')
else
-- Clear aids
      call !!clearAid('SPHERE', 40103)
      call !!clearAid('TEXT', 40102)
-- Calculate Radius
     !radius = !this.start.distance( !!edgGeomData.position)
-- Calculate Distance between vertices
-- Find Number of current Vertex
    !current = !!sctlSpine.current.owner.members.findFirst(!!sctlSpine.current)
-- Find number of next
if (!current eq !!sctlSpine.current.owner.mCount) then
     !endNo = 1
else
     !endNo = !current + 1
endif
-- Find number of previous
if (!!sctlSpine.radio.val eq 1) then
     !startNo = !current
else
     if (!current eq 1) then
          !startNo = !!sctlSpine.current.owner.mCount
     else
          !startNo = !current - 1
     endif
endif
-- Find positions of vertices
     !previous = !!sctlSpine.current.owner.members[!startNo].position
     !next = !!sctlSpine.current.owner.members[!endNo].position
-- Check Length
     !length = !previous.distance( !next)

     if (!length lt ( 2 * !radius ) ) then
          !this.radius = !radius
          !this.value.val = !radius

     -- Switch EDG
           !this.pick('POLE')

-- See if we have enough information to complete
           if (Set(!this.control ) ) then
                 !this.confirm()
           endif
     else
           error |Radius must be at least half distance between adjacent points|
     endif
endif

endmethod
-- End of method definition for .saveRadius(REAL)

------------------------------------------------------------------------
--
-- Method:      confirm
--
-- Description: If confirming then show some aid graphics
-- otherwise complete action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirm()


-- Calculate arc given by points
---------------------------------------
-- Find Number of current Vertex
!number = !!sctlSpine.current.owner.members.findFirst(!!sctlSpine.current)
-- Find number of next
if (!number eq !!sctlSpine.current.owner.mCount) then
     !endNo = 1
else
     !endNo = !number + 1
endif
-- Find number of previous
if (!!sctlSpine.radio.val eq 1) then
     !startNo = !number
else
     if (!number eq 1) then
          !startNo = !!sctlSpine.current.owner.mCount
     else
          !startNo = !number - 1
     endif
endif
-- Find positions of vertices
     !previous = !!sctlSpine.current.owner.members[!startNo].position
     !next = !!sctlSpine.current.owner.members[!endNo].position

-- Check Length
     !length = !previous.distance( !next)

     if (!length gt ( 2 * !this.radius) ) then
           !this.value.val = 0
           !this.radius = object REAL()
           error |Radius must be at least half distance between adjacent points|
           return
     endif

-- Construct Arc from information available
     !this.arc = !previous.arcRadius(!next, !this.control, !!sctlSpine.plane.direction(), !this.radius, !this.major.val)


-- Draw Aid Cylinder
    if (!this.radius lt 1000mm ) then
          !height = !this.radius
    else
          !height = 1000mm
    endif
    !diameter = 2 * !this.radius
    call !!clearAid('CYLI', 40101)
    call !!drawAidCylinder(!diameter, !height,  !this.arc.position, !!sctlSpine.plane.orientation, True, 40101 )
-- Enable accept button
    !this.accept.active = True


endmethod
-- End of method definition for .confirm()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Clear up EDG and aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

!!edgCntrl.remove('Spine Vertex Radius Control')
!!edgCntrl.remove('Spine Vertex Radius Radius')

call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40103)
call !!clearAid('TEXT', 40103)
call !!clearAid('SPHERE', 40102)

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      typeRadius
--
-- Description: Save typed radius value and check if we have enough information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .typeRadius()

-- Calculate Distance between vertices
-- Find Number of current Vertex
!number = !!sctlSpine.current.owner.members.findFirst(!!sctlSpine.current)
-- Find number of next
if (!number eq !!sctlSpine.current.owner.mCount) then
     !endNo = 1
else
     !endNo = !number + 1
endif
-- Find number of previous
if (!!sctlSpine.radio.val eq 1) then
     !startNo = !number
else
     if (!number eq 1) then
          !startNo = !!sctlSpine.current.owner.mCount
     else
          !startNo = !number - 1
     endif
endif
-- Find positions of vertices
     !previous = !!sctlSpine.current.owner.members[!startNo].position
     !next = !!sctlSpine.current.owner.members[!endNo].position
-- Check Length
     !length = !previous.distance( !next)

     if (!length le ( 2 * !this.value.val) ) then
     -- Save radius
           !this.radius = !this.value.val

           if(Set(!this.control) ) then
                 !this.confirm()
           endif
     else
           !this.value.val = 0
           error |Radius must be at least half distance between adjacent points|
     endif

endmethod
-- End of method definition for .typeRadius()
