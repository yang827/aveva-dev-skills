--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Thu Mar 26 08:30:42 1998
--
--
-- Description:
-- Form for  through point definition of arc in spine
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  confirm()                        -                   If confirming then show some aid graphics
--  dismiss()                        -                   Clear up EDG and aid graphics
--  go()                             -                   Complete the action i.e. create or modify the curve
--  pick()                           -
--  save()                           -                   Remember the through point
--
------------------------------------------------------------------------

setup form !!strSpineThru

  !!strSpineThru.formTitle     = 'Vertex definition through point'
  !!strSpineThru.iconTitle     = 'THROUGH'
  !!strSpineThru.callback      = ''
  !!strSpineThru.formRevision  = ' $Revision: 1.6 $ '

-- Members
 member .control is POSITION
 member .arc is ARC

  -- Body of form definition
path right

      button _accept | OK | call |!!strSpineThru.go()| ok
      paragraph  _radius text |Radius is Unset        |

-- Bottom Line
  button _cancel |Cancel| call '!!strSpineThru.dismiss()' cancel

exit
-- End of form definition for !!strSpineThru

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick()

!!edgCntrl.remove('Spine Vertex Through')

!packet = object EDGPACKET()

!packet.defineWrapper('POSITION','!!strSpineThru.save()','Pick Through Point')
!packet.description = 'Spine Vertex Through'

!!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick()

------------------------------------------------------------------------
--
-- Method:      go
--
-- Description: Complete the action i.e. create or modify the curve
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .go()

-- clear aid graphics
call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40102)
call !!clearAid('TEXT', 40102)

-- Remember where we were
!refe = !!ce

!!ce = !!sctlSpine.current

-- Handle first pole position
     if (!!sctlSpine.radio.val eq 1) then
    -- Create new vertex
          NEW CURVE

     endif
  -- Set attributes

     CURTYPE THRU
     !cPosString = !this.control.string()
     POS $!cPosString

 -- Update Counters
     !!sctlSpine.current = !!ce
     !!sctlSpine.number = !!ce.owner.members.findFirst(!!ce)

-- Update List
call !!sctlSpineList(!!ce.owner)

!!ce = !refe

!this.dismiss()

endmethod
-- End of method definition for .go()
------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Remember the through point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()

-- Save Value mapped on to plane
!this.control = !!sctlSpine.plane.near(!!edgGeomData.position)

-- Display position of origin
     call !!clearAid('SPHERE', 40102)
     call !!drawAidSphere(200,!this.control,40102)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Control',!this.control , 40102)

     !this.confirm()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      confirm
--
-- Description: If confirming then show some aid graphics
-- otherwise complete action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirm()


-- Calculate arc given by points
---------------------------------------
-- Find Number of current Vertex
!number = !!sctlSpine.current.owner.members.findFirst(!!sctlSpine.current)
-- Find number of next
if (!number eq !!sctlSpine.current.owner.mCount) then
     !endNo = 1
else
     !endNo = !number + 1
endif
-- Find number of previous
if (!!sctlSpine.radio.val eq 1) then
     !startNo = !number
else
     if (!number eq 1) then
          !startNo = !!sctlSpine.current.owner.mCount
     else
          !startNo = !number - 1
     endif
endif
-- Find positions of vertices
     !previous = !!sctlSpine.current.owner.members[!startNo].position
     !next = !!sctlSpine.current.owner.members[!endNo].position

-- Construct Arc from information available
     !this.arc = !previous.arcThru(!next, !this.control, !!sctlSpine.plane.direction() )

-- Draw Aid Cylinder
    if (!this.arc.radius lt 1000mm ) then
          !height = !this.radius
    else
          !height = 1000mm
    endif
    !diameter = 2 * !this.arc.radius
    call !!clearAid('CYLI', 40101)
    call !!drawAidCylinder(!diameter, !height,  !this.arc.position, !!sctlSpine.plane.orientation, True, 40101 )

-- Enable accept button
    !this.accept.active = True
    !this.radius.val = 'Radius = ' & !this.arc.radius.string()

endmethod
-- End of method definition for .confirm()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Clear up EDG and aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

!!edgCntrl.remove('Spine Vertex Through')

call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40103)
call !!clearAid('TEXT', 40102)
call !!clearAid('SPHERE', 40102)

endmethod
-- End of method definition for .dismiss()
