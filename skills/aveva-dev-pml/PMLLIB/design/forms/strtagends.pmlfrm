--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Dec 11 15:41:23 "GMT 1998
--
--
-- Description:
-- Functions for highlighting and tagging connected/unconnected ends.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  fullColour()                     -                   Set full colour
--  fullTag(BOOLEAN)                 -                   Tag fully connected
--  initialise()                     -                   Initialise Form
--  isEndAttached(DBREF,STRING)      BOOLEAN
--  noneColour()                     -                   Set full colour
--  noneTag(BOOLEAN)                 -                   Tag unconnected
--  partColour()                     -                   Set full colour
--  partTag(BOOLEAN)                 -                   Tag part connected
--  strTagEnds()                     -                   Constructor
--  tag(GADGET,STRING)               -                   Tag ends
--  tidy()                           -                   Tidy colours
--
------------------------------------------------------------------------

setup form !!strTagEnds

  !this.formTitle     = 'Highlight Connections'
  !this.iconTitle     = ''
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Current Element
  button    .ce 'CE' at xmin   ymax callback '!this.initialise()'
  paragraph .ceName  at xmax+1 ymin width 20 lines 1

  -- Tag connected
  path down
  frame .connectFrame 'Highlight' at xmin.ce ymax
    toggle .fullConnected ' Both ends connected'   callback '!this.tag(' states 'false' 'true'
    toggle .unconnected   ' Neither end connected' callback '!this.tag(' states 'false' 'true'
    toggle .partConnected ' One end unconnected'   callback '!this.tag(' states 'false' 'true'

    -- Button
    button .full '    '  at xmax.unconnected + 1 ymin.fullConnected
    button .none '    '  at xmax.unconnected + 1 ymin.unconnected
    button .part '    '  at xmax.unconnected + 1 ymin.partConnected
  exit

  -- Bottom line
  button .dismiss 'Dismiss' at xmax form-size ymax+0.2 callback '!this.tidy()' ok

  -- Form members
  member .elements   is ARRAY

  -- Elements with only start connected
  member .starts     is ARRAY
  -- Elements with only end connected
  member .ends       is ARRAY

  -- Elements with both ends connected
  member .bothEnds   is ARRAY

  -- Elements with both ends unconnected
  member .neitherEnd is ARRAY

  -- Colours
  member .fullColour is REAL
  member .noneColour is REAL
  member .partColour is REAL

  -- Aid Number
  member .aidNumber is REAL

exit
-- End of form definition for !!strTagEnds

------------------------------------------------------------------------
--
-- Method:      strTagEnds
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .strTagEnds()

  -- Initialise Variables
  !this.full.callback  = |!!colourSelectLoad('!!strTagEnds.fullColour()', 'Fully connected sections/walls', !this.fullColour)|
  !this.none.callback  = |!!colourSelectLoad('!!strTagEnds.noneColour()', 'Unconnected sections/walls',     !this.noneColour)|
  !this.part.callback  = |!!colourSelectLoad('!!strTagEnds.partColour()', 'Part connected sections/walls',  !this.partColour)|

  -- Close down callback
  !this.cancelCall     = '!this.tidy()'

  -- Colours
  !this.full.background   = 'green'
  !this.none.background   = 'red'
  !this.part.background   = 'blue'
  !this.fullColour        = !this.full.background
  !this.noneColour        = !this.none.background
  !this.partColour        = !this.part.background

  -- Aid Number
  !this.aidNumber      = !!aidNumbers.add('End Tagging')

endmethod
-- End of method definition for .strTagEnds()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Initialise Variables
  !this.ceName.val  = !!ce.flnn

  -- clear any existing tags. Needed if this is called from CE button
  !this.tidy()
  -- collects all hardtype SCTN/GENSEC that is not in a template, and does not own a template
  -- thus connections inside templates, and connections of template SCTN's & GENSEC's are not displayed
  !softTypes   = !!dtbSoftTypes.stringSTypesFor('SCTN') & !!dtbSoftTypes.stringSTypesFor('GENSEC')
  var !elements COLLECT ALL ($!softTypes) WITH ( BADREF(TMPL) OR NOT BADREF(TMPL 1) ) FOR CE

  !size = !elements.size()
  PROMPT 'Checking end connections for $!size elements'
--  var !startOnly  COLLECT ALL WITH (JOISTART ne NULREF and JOIEND eq NULREF ) from !elements
--  var !endOnly    COLLECT ALL WITH (JOISTART eq NULREF and JOIEND ne NULREF ) from !elements
--  var !neitherEnd COLLECT ALL WITH (JOISTART eq NULREF and JOIEND eq NULREF ) from !elements
--  var !bothEnds   COLLECT ALL WITH (JOISTART ne NULREF and JOIEND ne NULREF ) from !elements

  -- Has both ends connection
--  var !starts   COLLECT ALL WITH (JOISTART ne NULREF ) from !elements
--  var !ends     COLLECT ALL WITH (JOIEND   ne NULREF ) from !elements
--   !bothEnds         = !starts.intersect(!ends)
--
--   -- Neither end connect
--   !neitherEnd       = !elements.difference(!starts).difference(!ends)
--
--   -- Only one end
--   !startOnly        = !starts.difference(!ends)
--   !endOnly          = !ends.difference(!starts)
--   clock init all
  !neitherEnd = ARRAY()
  !bothEnds   = ARRAY()
  !endOnly    = ARRAY()
  !startOnly  = ARRAY()
  -- loop through elements to find connections
  do !item values !elements
    !itemRef = !item.dbRef()
--    !startConnections = !this.isEndAttached( !itemRef.joiS, !softTypes )
--    !endConnections   = !this.isEndAttached( !itemRef.joiE, !softTypes )
    -- THIS CODE IS IN-LINE FOR PERFORMANCE
    -- start connection
    !joint = !itemRef.joiS
    -- test for end not connected to a joint
    if( badref( !joint ) ) then
      !startConnections = false
    else
      -- test for end connected to a primary joint
      !pnode = ( PNOD OF $!joint )
      handle any
        -- must have found a secondary connection
        !startConnections = true
      elsehandle none
        -- find other connections to a PNODE
        var !connAtPnode COLLECT ALL ( PJOI FIXING SUBJ ) WITH ( NOT BADREF(CREF) ) FOR $!pnode EXCLUDE $!joint
        !startConnections = !connAtPnode.size() gt 0
      endhandle
    endif
    -- end connection
    !joint = !itemRef.joiE
    -- test for end not connected to a joint
    if( badref( !joint ) ) then
      !endConnections = false
    else
      -- test for end connected to a primary joint
      !pnode = ( PNOD OF $!joint )
      handle any
        -- must have found a secondary connection
        !endConnections = true
      elsehandle none
        -- find other connections to a PNODE
        var !connAtPnode COLLECT ALL ( PJOI FIXING SUBJ ) WITH ( NOT BADREF(CREF) ) FOR $!pnode EXCLUDE $!joint
        !endConnections = !connAtPnode.size() gt 0
      endhandle
    endif

    if( !startConnections and !endConnections ) then
        !bothEnds.append(!item)
    elseif( !startConnections.not() and !endConnections.not() ) then
        !neitherEnd.append(!item)
    elseif( !startConnections ) then
        !startOnly.append(!item)
    else
        !endOnly.append(!item)
    endif

  enddo

-- Write data to form members
  !this.elements    = !elements

  !this.starts      = !startOnly
  !this.ends        = !endOnly
  !this.bothEnds    = !bothEnds
  !this.neitherEnd  = !neitherEnd
--   clock read all

  -- Force all toggles out
  !this.fullConnected.val = false
  !this.unconnected.val   = false
  !this.partConnected.val = false

  -- Increment counts
  !size                   = !this.bothEnds.size()
  var !dprt COMPOSE '$!size' WIDTH 4 R
  !this.full.tag          = !dprt[1]

  !size                   = !this.neitherEnd.size()
  var !dprt COMPOSE '$!size' WIDTH 4 R
  !this.none.tag          = !dprt[1]

  !size                   = !this.starts.size() + !this.ends.size()
  var !dprt COMPOSE '$!size' WIDTH 4 R
  !this.part.tag          = !dprt[1]

  PROMPT DISMISS

  -- Unenhance all
  !this.tidy()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy colours
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()

  -- Unenhance all items in list
  !!aidNumbers.hide(!this.aidNumber)
  !list = !this.elements
  UNENHANCE ALL FROM !list

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      fullColour
--
-- Description: Set full colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fullColour()

  -- Initialise Variables
  !this.fullColour      = !!colourSelectGet()
  !this.full.background = !this.fullColour
  !this.fullTag(!this.fullConnected.val)

endmethod
-- End of method definition for .fullColour()

------------------------------------------------------------------------
--
-- Method:      noneColour
--
-- Description: Set full colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .noneColour()

  -- Initialise Variables
  !this.noneColour      = !!colourSelectGet()
  !this.none.background = !this.noneColour
  !this.noneTag(!this.unconnected.val)

endmethod
-- End of method definition for .noneColour()

------------------------------------------------------------------------
--
-- Method:      partColour
--
-- Description: Set full colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .partColour()

  -- Initialise Variables
  !this.partColour      = !!colourSelectGet()
  !this.part.background = !this.partColour
  !this.partTag(!this.partConnected.val)

endmethod
-- End of method definition for .partColour()

------------------------------------------------------------------------
--
-- Method:      fullTag
--
-- Description: Tag fully connected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for tag, false for untag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fullTag(!tag is BOOLEAN)

  -- Initialise Variables
  !list = !this.bothEnds
  if(!tag) then
    ENHANCE ALL FROM !list COLOUR $!<this.fullColour>
  else
    UNENHANCE ALL FROM !list
  endif


endmethod
-- End of method definition for .fullTag(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      noneTag
--
-- Description: Tag unconnected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for tag, false for untag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .noneTag(!tag is BOOLEAN)

  -- Initialise Variables
  !list = !this.neitherEnd
  if(!tag) then
    ENHANCE ALL FROM !list COLOUR $!<this.noneColour>
  else
    UNENHANCE ALL FROM !list
  endif

endmethod
-- End of method definition for .noneTag(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      partTag
--
-- Description: Tag part connected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for tag, false for untag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .partTag(!tag is BOOLEAN)

  -- Initialise Variables
  !list = ARRAY()
  !list.appendArray(!this.starts)
  !list.appendArray(!this.ends)

  if(!tag) then
    -- Tag relevant end
    do !i indices !this.starts
      !position = !this.starts[!i].dbRef().posEnd
      AID TEXT NUMBER $!<this.aidNumber> 'End' AT $!<position>
    enddo
    do !i indices !this.ends
      !position = !this.ends[!i].dbRef().posStart
      AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<position>
    enddo
    ENHANCE ALL FROM !list COLOUR $!<this.partColour>
  else
    !!aidNumbers.hide(!this.aidNumber)
    UNENHANCE ALL FROM !list
  endif

endmethod
-- End of method definition for .partTag(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description: Tag ends
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget picked
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tag(!gadget is GADGET, !selected is STRING)

  -- Initialise Variables
  if(!selected eq 'SELECT') then
    !tag = true
  else
    !tag = false
  endif

  -- Fully unconnected
  if(!gadget.name() eq 'PARTCONNECTED') then
    !this.partTag(!tag)

  -- Fully connected
  elseif (!gadget.name() eq 'FULLCONNECTED') then
    !this.fullTag(!tag)

  -- Fully connected
  elseif (!gadget.name() eq 'UNCONNECTED') then
    !this.noneTag(!tag)

  endif

endmethod
-- End of method definition for .tag(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      isEndAttached
--
-- Description: Returns all attached members to the given joint/fixing.
--   Typically called with JOIS or JOIE of section/gensec as the argument.
--   This can be an unset value or badref.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbref of joint to test for connection
--    2   R      STRING      list of connected element types to check
-- Return:
--   [Data Type] [Description]
--    ARRAY       of attached dbrefs. Zero length is no attachment
------------------------------------------------------------------------
define method .isEndAttached( !joint is DBREF, !dummyListOfTypes is STRING ) is BOOLEAN

  -- test for end not connected to a joint
  if( badref( !joint ) ) then
    return false
  endif

  -- test for end connected to a primary joint
  !pnode = ( PNOD OF $!joint )
  handle any
    -- must have found a secondary connection
    return true
  endhandle

  var !connAtPnode COLLECT ALL ( PJOI FIXING SUBJ ) WITH ( NOT BADREF(CREF) ) FOR $!pnode EXCLUDE $!joint
  return !connAtPnode.size() gt 0

endmethod
-- End of method definition for .isEndAttached( DBREF, STRING ) BOOLEAN
