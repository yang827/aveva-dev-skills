-- File:            tmpcheckvalidity.pmlfrm
--   Type:          Form Definition
--   Group:         Template Application

--     Keyword:     TMPL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Thu Jun 10 7:14:27 BST 1999
--
--
-- Description:
-- form definition to check for bad vvalue references
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkErrors()                    -                   Check VALIDV and DDDF attributes for badref spco names
--  close()                          -                   Close the form
--  initialise(STRING)               -                   Initialisation of the form
--  tmpCheckValidity()               -
--  update()                         -                   Apply the form and update the values in the DB
--

setup form !!tmpCheckValidity

  !this.formTitle     = 'Template Validity Checker'
  !this.iconTitle     = 'TmpChk'
  !this.callback      = '!this.initialise(''LOAD'')'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Bar menu
  bar
  exit

  option .whichElement tooltip 'What level to run the check on' at y0.2 width 5

  path right

  para .tmpl  text '' width 60 lines 1

  path down

  textpane .list 'Check list' at xmin_whichElement  width 80 height 20

  button .apply 'Correct Values' tooltip 'Run in Corrections to values listed' Apply


  -- members

  member .dbRef is DBREF


exit
-- End of form definition for !!tmpCheckValidity
------------------------------------------------------------------------
--
-- Method:      constructor()
--
-- Description:  Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmpCheckValidity()

   -- Define Bar Menu
  !bar = !this.bar
  !bar.add('Control',  'controlMenu')
  -- File menu
  !menu = !this.newMenu('controlMenu')
  !menu.add('callback', 'Check For Errors', '!this.checkErrors()')
  !menu.add('callback', 'Close',         '!this.close()')

  -- Load gadget with values
  !values = 'TMPL TMAR TPWL'
  !dText  = !values.split()
  !rText  = !values.split()

  !this.whichElement.dText = !dText
  !this.whichElement.rText = !rText

  !this.whichElement.callback = '!this.initialise(''GADGET'')'
  !this.apply.callback = '!this.update()'


endmethod
-- End of method definition for .tmpCheckValidity()

------------------------------------------------------------------------
--
-- Method:      close()
--
-- Description:  Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  hide !!tmpCheckValidity

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      initialise(STRING)
--
-- Description:  Initialisation of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!option is STRING)

-- test whether initialising the form or from "which element" gadget
if(!option.eq('GADGET')) then
  if(!this.whichElement.selection().eq('TMPL')) then

    !climb = !!dtbGetOwnerType( !!ce, 'TMPL' )
    if(!climb.unset()) then
       return error 1 'Cannot access TMPL from this level'
    else
      !this.dbRef = !climb
    endif

  elseif(!this.whichElement.selection().eq('TMAR')) then

    !climb = !!dtbGetOwnerType( !!ce, 'TMAR' )
    if(!climb.unset()) then
       return error 1 'Cannot access TMAR from this level'
    else
      !this.dbRef = !climb
    endif

  elseif(!this.whichElement.selection().eq('TPWL')) then
    !climb = !!dtbGetOwnerType( !!ce, 'TPWL' )
    if(!climb.unset()) then
       return error 1 'Cannot access TPWL from this level'
    else
      !this.dbRef = !climb
    endif

  endif

else
  -- form initialisation
  !this.dbRef = !!ce
  !type = !this.dbRef.hardType
  !this.whichElement.select('RTEXT',!type)
  handle any
    !this.whichElement.select('RTEXT','TMPL')
  endhandle
endif
  !this.tmpl.val  = !this.dbRef.fullName
endmethod
-- End of method definition for .initialise(STRING)
------------------------------------------------------------------------
--
-- Method:     update()
--
-- Description:  Apply the form and update the values in the DB
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  !arrayOfErrors = !this.list.val

  do !i values !arrayOfErrors

    !i = !i.after('ERROR :').before('is not a valid')

    -- change the value
    $!i
    handle any
      -- just in case some has tampered with the data
    endhandle
  enddo


  !this.checkErrors()


endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:      checkErrors()
--
-- Description:  Check VALIDV and DDDF attributes for badref spco names
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkErrors()

  !arrayOfErrors = ARRAY()

  -- get all ddats/vvalues  for element

  var !elements COLLECT ALL DDAT WITH MATCHWILD(DDDF,'* ID *') FOR $!<this.dbRef>
  var !elements APPEND COLLECT ALL VVALUE WITH MATCHWILD(VALIDV,'* ID *') FOR $!<this.dbRef>


  do !i values !elements
    !type = !i.dbRef().hardType
    if(!type.eq('DDAT')) then
      !testValue = !i.dbRef().evaluate(object BLOCK(!i.dbRef().dddf))
        handle any
        --badref
          !arrayOfErrors.append('ERROR : ' & !i & '  dddf ' & !i.dbRef().dddf.string() & ' is not a valid Ref')
        elsehandle none

        endhandle
    else
       !testValue = !i.dbRef().evaluate(object BLOCK(!i.dbRef().validv))
       handle any
       --badref
        !arrayOfErrors.append('ERROR : ' & !i & ' validv ' & !i.dbRef().validv.string() & ' is not a valid Ref')
       endhandle

    endif

  enddo


 if(!arrayOfErrors.empty()) then
   !arrayOfErrors[1] = ''
   !arrayOfErrors[2] = ''
   !arrayOfErrors[3] = '     ===================================================================='
   !arrayOfErrors[4] = ''
   !arrayOfErrors[5] = '                              NO ERRORS TO REPORT'
   !arrayOfErrors[6] = ''
   !arrayOfErrors[7] = '     ===================================================================='
 endif

 !this.list.val = !arrayOfErrors

endmethod
-- End of method definition for .checkErrors()
