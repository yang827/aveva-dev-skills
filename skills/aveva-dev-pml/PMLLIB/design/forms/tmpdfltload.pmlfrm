--
-- Description:
-- Displays current project template defaults from the Dataset Area (DDAR).
--
------------------------------------------------------------------------

-- Define form
setup form !!tmpDfltLoad at xr 0 yr 0.6

  !!tmpDfltLoad.formTitle     = 'Template Project Defaults'
  !!tmpDfltLoad.iconTitle     = 'ProjDflt'
  !!tmpDfltLoad.callback      = '!!tmpDfltInit()'
  !!tmpDfltLoad.formRevision  = ' $Revision: 1.4 $ '

-- Body of form definition

-- Current DDAR defaults
   para .dDarName1 width 40 lines 1
   path down
   vdist -.5
   para .dDarName2 width 60 lines 1
   vdist -.1
   para .dDarTitle width 60 lines 1

-- Available Parameters
   list .dDatList width 60 length 22

-- Dismiss
   button .dismiss |Dismiss| at xmax form-size ymax ok

exit

-- End of form definition for !!tmpDfltLoad
