--
--
-- Description:
-- form to create all dimension points from desp parameter datasets
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToList(STRING)                -                   Add the current information to the list.
--  autoBuild(DBREF)                 -                   Build Dimension Points from existing Design Param Datasets
--  checkDim(DBREF)                  BOOLEAN             Check that the two points are not coincident
--  close()                          -                   Close the dimensioning point form
--  copyPoint()                      -                   Copy the rule of the Associated points
--  copyPrevious()                   -                   Copy the rule previously selected point
--  edit()                           -                   setup the template data from old syntax PML1 Form
--  expressionChk(DBREF,STRING,STRING) -                   Check expression entered is correct.
--  initialise()                     -                   Initialise form
--  modifyPoint()                    -                   Enter list position into modify Gadgets
--  processRule(STRING,DBREF)        STRING              Convert Rule into Gadget string
--  processRule(STRING,GADGET)       STRING              Convert Rule into correct syntax from gadget
--  showOrigin()                     -                   Close the dimensioning point form
--  showPlot()                       -                   Show Plotfile Showing Dimension Details
--  showPoint(BOOLEAN)               -                   Display Point Details on Screen
--  testForDuplicate(REAL,ARRAY)     BOOLEAN             Test for duplicate in list when including into the list of points
--  tmpDptsCrt()                     -                   Constructor
--
------------------------------------------------------------------------


setup form !!tmpDptsCrt


  !this.formTitle     = 'Dimension Point Definition'
  !this.iconTitle     = 'Dimension Point Definition'
  !this.formRevision  = ' $Revision: 1.14 $ '

  bar
  exit

  path down
  para .templateText  at xmin ymax width 60 lines 1

  text .description 'Design Point Description'   tooltip 'Enter Dimension Point Description' width 34 scroll 34 is STRING

  text .dimNumber   'Design Parameter Number ' tooltip 'Dimension Number (in Pairs)' width 4 is REAL
  text .number at xmax.description-size ymin 'Dpoint No.'  tooltip 'Design Point Unique Number' width 4 is REAL

  frame .frame 'Rules For' at xmin form width 55
    !validSel = !!pml.getPathName('dialog16.png')
    text .dimPosition  'Dimension Position '  tooltip 'Set Rule For Position' width 37 scroll 250 is STRING
    text .dimExtension 'Dimension Extension' tooltip 'Set Rule For Extension' width 37 scroll 250 is STRING
    text .dimDirection 'Dimension Direction' tooltip 'Set Rule For Direction' width 37 scroll 250 is STRING
    button .posiExprBuilder  at xmax_dimPosition ymin_dimPosition tooltip 'Position Expression Builder' pixmap "$!<validSel>" width 16  height 16
    button .extnExprBuilder  at xmax_dimExtension ymin_dimExtension tooltip 'Extension Expression Builder' pixmap "$!<validSel>" width 16  height 16
    button .dDirExprBuilder  at xmax_dimDirection ymin_dimDirection tooltip 'Direction Expression Builder' pixmap "$!<validSel>" width 16  height 16
  exit

  -- Include/Replace/Remove
  vdist 0.5
  button .copyPrev 'Copy Last Point' tooltip 'Copy Last Point Displayed'
  path right
  button .copy 'Copy Partner' tooltip 'Copy Associated Dimension Point Rules'
  button .include  'Include' tooltip 'Add Dimension Point Details to the List Below'
  button .replace  'Replace'  tooltip 'Replace Dimension Point in the List Below'
  button .remove   'Remove' tooltip 'Remove Dimension Point From the List Below'



  -- Available Design Dimension Points

  -- 11.3 tooltip
  --  list .list |Dimension Points| call '!this.modifyPoint()' tooltip 'Select Point to Modify' at x1 ymax+0.5 width 55 length 10
  path down
  list .list at xmin form 'Dimension Points' width 60 length 10

  -- members

  -- store the template DBREF

  member .template is DBREF
  member .dimensions is COMPROP
  member .aidNumber is REAL
  member .despars   is ARRAY
  member .expressions is ARRAY
  member .localNames is ARRAY

  -- save previous point

  member .savePosRule is STRING
  member .saveRadRule is STRING
  member .saveDirRule is STRING

  -- graphic aid for tmpl origin

  member .origin is GPHPOSITION
  member .aidNumberO is REAL
  member .aidShown is BOOLEAN

exit
-- End of form definition for !!tmpDptsCrt

------------------------------------------------------------------------
--
-- Method:      tmpDptsCrt
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmpDptsCrt()

  !bar = !this.bar
  !bar.add('Control',  'ControlMenu')
  !bar.add('Display',  'DisplayMenu')

  -- File menu
  !menu = !this.newMenu('controlMenu')
  !menu.add('callback', 'AutoBuild', '!this.autoBuild(!this.template)')
  !menu.add('callback', 'Close',         '!this.close()')

  !menu = !this.newMenu('DisplayMenu')
  !menu.add('callback','Dimension Details...', '!this.showPlot()')
  !menu.add('TOGGLE','Template Origin', '!this.showOrigin()', 'TemplateOrigin')

  -- set callback to gadgets
  !this.callback = '!this.initialise()'
  !this.remove.callback  = '!this.addToList(''REMOVE'')'
  !this.list.callback    = '!this.modifyPoint()'
  !this.replace.callback = '!this.addToList(''REPLACE'')'
  !this.include.callback = '!this.addToList(''INCLUDE'')'
  !this.copy.callback    = '!this.copyPoint()'
  !this.posiExprBuilder.callback   = '!!comExprBuilder(''Position Rule Definition'', !this.despars,!this.expressions, !this.localNames, !this.dimPosition)'
  !this.extnExprBuilder.callback   = '!!comExprBuilder(''Extension Rule Definition'', !this.despars,!this.expressions, !this.localNames, !this.dimExtension)'
  !this.dDirExprBuilder.callback   = '!!comExprBuilder(''Direction Rule Definition'', !this.despars,!this.expressions, !this.localNames, !this.dimDirection)'
  !this.dimPosition.validatecall   = '!this.expressionChk(!this.list.selection().dbRef(), !this.dimPosition.val, |EXPLICIT|)'
  !this.dimExtension.validatecall  = '!this.expressionChk(!this.list.selection().dbRef(), !this.dimExtension.val, |RADI|)'
  !this.dimDirection.validatecall  = '!this.expressionChk(!this.list.selection().dbRef(), !this.dimDirection.val, |DDIR|)'
  !this.dimPosition.callback       = '!this.dimExtension.setFocus()'
  !this.dimExtension.callback      = '!this.dimDirection.setFocus()'
  !this.dimDirection.callback      = '!this.dimPosition.setFocus()'
  !this.copyPrev.callback          = '!this.copyPrevious()'

  -- Define default axes
  !this.aidNumberO    = !!aidNumbers.add('Origin')
  !origin             = object GPHPOSITION()
  !origin.tag         = false
  !origin.fill        = 'OFF'
  !origin.position    = object POSITION('N0')
  -- use axes size if set  --------------------------
  if (defined(!!gphAxesEdit)) then
    !origin.diameter = !!gphAxesEdit.size.val
  else
    !origin.diameter = 200 MM
  endif
  --------------------------------------------------------------
  !this.origin        = !origin

endmethod
-- End of method definition for .tmpDptsCrt()
------------------------------------------------------------------------
--
-- Method:     expressionChk(GADGET)
--
-- Description: Check expression entered is correct.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Element to check expression on]
--   [2] [R]    [STRING]    [Expression to check]
--   [3] [R]    [STRING]    [Expression type]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expressionChk(!element is DBREF, !expression is STRING, !expressionType is STRING)

  call !!tmpExpressionChk(!element, !expression, !expressionType)

endmethod
-- End of method definition for .expressionChk(GADGET)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: setup the template data from old syntax PML1 Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- get the template from old form

  !tmplForm = !!cdTmpMemb
  !template = !tmplForm.memb.selection().dbRef()

  if(!template.hardType.neq('TMPL')) then
    return ERROR 1 'No Template Selected in Template Browser'
  endif

  !this.template = !template

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      initialise()
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !this.edit()


  -- Initialise  Variables
  !dText = ARRAY()
  !rText = ARRAY()

  -- clear gadgets

  !this.description.val = ''
  !this.number.val = 0
  !this.dimNumber.val = 0
  !this.dimPosition.val = ''
  !this.dimExtension.val = ''
  !this.dimDirection.val = ''

  -- get the template description / full name

  !displayText  = !this.template.description
  handle any
    -- in case tmpl not selected in browser
    return
  endhandle

  if(!displayText.eq('')) then
    !displayText = !this.template.flnn
  endif

  !this.templateText.val = 'Template : ' & !displayText

  -- get all dim points for the current template and display

  --  var !dimPoints COLLECT ALL DPSP WITH PURP eq 'DIM' FOR $!<this.template>
  --
  --   var !desc EVALUATE DESC FOR ALL FROM !dimPoints
  --   var !numb EVALUATE NUMB FOR ALL FROM !dimPoints
  --   var !func EVALUATE FUNC FOR ALL FROM !dimPoints
  -- do it new way 'cos number needs to be numeric

  !dimPoints = !!collectAllFor(|DPSP|,|PURP eq 'DIM'| ,!this.template)
  if(!dimPoints.size().neq(0)) then
    !extractDesc = object BLOCK('!dimPoints[!evalIndex].description')
    !desc        = !dimPoints.evaluate(!extractDesc)

    !extractNumb = object BLOCK('!dimPoints[!evalIndex].number')
    !numb        = !dimPoints.evaluate(!extractNumb)

    !extractFunc = object BLOCK('!dimPoints[!evalIndex].function')
    !func        = !dimPoints.evaluate(!extractFunc)


    !sort = !numb.sortedIndices()
  endif
  -- sort them on Number

  do !i indices !sort
    var !compose  COMPOSE SPACE 2 '$!func[$!sort[$!i]]'  SPACE 2 '$!numb[$!sort[$!i]]' SPACE 2 '$!desc[$!sort[$!i]]' WIDTH 52
    !dText.append(!compose[1])
    !rText.append(!dimPoints[!sort[!i]].string())

  enddo

  -- redo the list

  !this.list.dText = !dText
  !this.list.rText = !rText

  !this.dimensions.initialise(!this.template, true)

  -- get desp's / exprs / lnames for expression builder for aid with rules

  !this.despars     = !this.dimensions.dKeyList('DESP')
  !this.expressions = !this.dimensions.dKeyList('EXPR')
  var !lnames SPLIT LNLST OF $!<this.template>
  !this.localNames  = !lnames

  -- populate the modify text fields with the current selected point from the list gadget

  if(!this.list.val.gt(0)) then
    !this.modifyPoint()
  endif

  if(!this.list.rText.size().leq(1)) then
    !this.copy.active = FALSE
  endif
  -- position Origin graphic sphere at tmpl

  !this.origin.position = !this.template.position
  !this.origin.draw(!this.aidNumberO)
  !this.aidShown = TRUE
  !this.displayMenu.setFieldProperty('TemplateOrigin', 'SELECTED', !this.aidShown)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      autoBuild(DBREF)
--
-- Description: Build Dimension Points from existing Design Param Datasets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoBuild(!tmpl is DBREF)


  -- Save original Position

  !refe     = !!ce

  -- best create a new dpse when the old tmpl app can cater for more than one DPSE

  !!ce    = !tmpl


  -- create a DPSE if there isn't one

  !pntSet = DPSE 1 OF $!tmpl
  handle any
    !!ce = !tmpl
    NEW DPSE
    !pntSet = !!ce
  elsehandle none
    -- before creating test see if there are already dimension points
    var !dPoints COLLECT ALL DPSP WITH PURP EQ 'DIM' FOR $!tmpl
    if(!dPoints.size().gt(0)) then
      !ask = !!alert.confirm('Template Already Has Dimension Points. Any Rules defined on the Points will be lost. Do you wish to regenerate them?')
      if(!ask.eq('NO')) then
        !!ce = !refe
        return
      else
        -- delete DPSP's that are dim points
        do !i values !dPoints
          !!ce = !i.dbRef()
          DELETE DPSP
        enddo
      endif
    endif
  endhandle


  -- get the desp's for the dimensions

  var !despars COLLECT ALL DDAT WITH PURP EQ 'DESP' FOR $!tmpl
  if(!despars.size().eq(0)) then
    !!alert.error('Current Template does not have any Design Parameter Datasets to build from.')
    return
  endif
  var !number EVALUATE NUMB FOR ALL FROM !despars
  var !title  EVALUATE DTIT FOR ALL FROM !despars
  var !dKey   EVALUATE DKEY FOR ALL FROM !despars

  -- create the points required.

  !!ce = !pntSet

  do !i indices !despars

    NEW DPSP PVIF 3 PURP DIM FUNC '$!number[$!i]' NUMB $!number[$!i]01 DESC '$!title[$!i] 1st Dim. Point ($!dKey[$!i])'
    NEW DPSP PVIF 3 PURP DIM FUNC '$!number[$!i]' NUMB $!number[$!i]02 DESC '$!title[$!i] 2nd Dim. Point ($!dKey[$!i])'

  enddo

  -- re-initialise the form for the new points

  !this.initialise()


  if(!this.list.rText.size().geq(2)) then
    !this.copy.active = TRUE
  endif


  -- Go Back to Original Position
  !!ce = !refe
  handle any
    -- in case it has been deleted
  endhandle


endmethod
-- End of method definition for .autoBuild(DBREF)
-----------------------------------------------------------------------
--
-- Method:      modifyPoint()
--
-- Description: Enter list position into modify Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPoint()

  -- save previous rules

  !this.savePosRule = !this.dimPosition.val
  !this.saveRadRule = !this.dimExtension.val
  !this.saveDirRule = !this.dimDirection.val

  -- clear aids from previous point
  !this.dimensions.hideAllDims()
  !this.showPoint(FALSE)
  -- get values from picked point
  !point = !this.list.selection().dbRef()

  !desc  = !point.description
  !func  = !point.function
  !numb  = !point.number
  !desc  = !point.desc


  -- enter data in the modify gadgets

  !this.description.val  = !desc

  !this.dimNumber.val    = !func.real()
  !this.number.val       = !numb.real()
  !this.dimPosition.val  = !this.processRule('POSITION', !point)
  !this.dimExtension.val = !this.processRule('RADIUS', !point)
  !this.dimDirection.val = !this.processRule('DDIR', !point)

  -- draw the dimension and point

  if(!this.checkDim(!point).not()) then
    !this.dimensions.displayDimension(!point.function.real(),true)
  endif

  !this.showPoint(TRUE)

endmethod
-- End of method definition for .modifyPoint()
-----------------------------------------------------------------------
--
-- Method:      showPoint(BOOLEAN)
--
-- Description: Display Point Details on Screen
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [BOOLEAN]   [TRUE = Show the point details]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPoint(!onOrOff is BOOLEAN)

  !refe = !!ce

  -- get point information
  if(!onOrOff) then
    !point  = !this.list.selection().dbRef()
    !aidPos = !point.position
    !number = !point.number
    !pointDir = !point.dDirection

    !!ce = !point

    var !aPos DP $!number POSITION OF TMPL
    !actualPos = !aPos.position()


    if(!this.aidNumber.unset()) then
      !this.aidNumber = !!aidNumbers.add('Points')
    endif

    -- display point definition
    AID SPHERE NUMBER $!<this.aidNumber> $!aidPos DIA 25mm
    AID SPHERE NUMBER $!<this.aidNumber> $!actualPos DIA 25mm
    AID ARROW NUMBER $!<this.aidNumber> AT $!aidPos DIR $!pointDir  HEIG 75 MM
  else
    if(!this.aidNumber.set()) then

      !!aidNumbers.hide(!this.aidNumber)

    endif
  endif

  !!ce = !refe
endmethod
-- End of method definition for .showPoint(BOOLEAN)
-----------------------------------------------------------------------
--
-- Method:      copyPoint()
--
-- Description: Copy the rule of the Associated points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPoint()

  !point = !this.list.selection().dbRef()

  -- get other dim point
  var !otherPoint COLLECT ALL DPSP WITH PURP EQ 'DIM' AND FUNC EQ '$!<point.function>' AND REFE NEQ $!<point.refe> FOR $!<point.owner>
  if(!otherPoint.size().gt(0)) then
    !rulePos = !this.processRule('POSITION',!otherPoint[1].dbRef())
    !ruleRad = !this.processRule('RADIUS',!otherPoint[1].dbRef())
    !ruleDir = !this.processRule('DDIR',!otherPoint[1].dbRef())
    -- input into gadgets
    !this.dimPosition.val  = !rulePos
    !this.dimExtension.val = !ruleRad
    !this.dimDirection.val = !ruleDir
  else
    !!alert.error('No Associated Point to Copy')
    return
  endif



endmethod
-- End of method definition for .copyPoint()
-----------------------------------------------------------------------
--
-- Method:      copyPrevious()
--
-- Description: Copy the rule that was previously displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPrevious()


  !this.dimPosition.val  = !this.savePosRule
  !this.dimExtension.val = !this.saveRadRule
  !this.dimDirection.val = !this.saveDirRule


endmethod
-- End of method definition for .copyPrevious()
-----------------------------------------------------------------------
--
-- Method:      checkDim(BOOLEAN)
--
-- Description: Check that the two points are not coincident
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Point to compare for coincidence]
-- Return:
--   [Data Type] [Description]
--   [BOOLEAN]   [TRUE if they are coincident]
--
------------------------------------------------------------------------

define method .checkDim(!point is DBREF) is BOOLEAN

  -- get other dim point
  var !otherPoint COLLECT ALL DPSP WITH PURP EQ 'DIM' AND FUNC EQ '$!<point.function>' FOR $!<point.owner>
  if(!otherPoint.size().gt(1)) then
    if(!otherPoint[1].dbRef().position.eq(!otherPoint[2].dbRef().position)) then
      return TRUE
    endif
  endif

  return FALSE

endmethod
-- End of method definition for .checkDim(DBREF) BOOLEAN
------------------------------------------------------------------------
--
-- Method:      addToList(STRING)
--
-- Description: Add the current information to the list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Which button pressed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToList(!buttonPicked is STRING)


  -- Get Data entered
  !refe = !!ce
  !description    = !this.description.val
  !dPointNo       = !this.dimNumber.val
  !number         = !this.number.val
  !rulePos        = !this.processRule('POSITION',!this.dimPosition)
  !ruleRad        = !this.processRule('RADIUS',!this.dimExtension)
  !ruleDir        = !this.processRule('DDIR',!this.dimDirection)


  !template       = !this.template
  -- *** OLD Stype SYNTAX ****
  var !dPointTmp      DPSE 1 OF $!template
  handle any
    -- create one if it ain't there
    !!ce = !template
    NEW DPSE
    !dPointSet = !!ce
  elsehandle none
    !dPointSet = !dPointTmp.dbRef()
  endhandle

  !listSelection = !this.list.val

  -- get current list values

  !listD      = !this.list.dText
  !listR      = !this.list.rText


  if(!buttonPicked.eq('INCLUDE')) then

    -- stop user including a duplicate Number
    if(!this.testForDuplicate(!number,!listR)) then
      !!alert.error('Duplicate Dimension Point in List.')
      return
    endif

    !this.dimensions.hideAllDims()
    !this.showPoint(FALSE)
    -- check the data is complete  -------------------------------------

    if(!description.eq('') or !dPointNo.eq(0) or !number.eq(0)) then
      !!alert.error('Not all Information has been entered, for the Dimension Point.')
      return
    endif
    ---------------------------------------------------------------------

    -- Create new Design Point (DPSP)

    !!ce = !dPointSet
    NEW DPSP PVIF 3 PURP DIM FUNC '$!dPointNo' NUMB $!number DESC '$!description'
    !dPoint = !!ce
    -- set the rules
    $!rulePos
    handle(2,29)
      -- do nothing because rule of pos doesn't exist
    elsehandle any
      !!alert.error('Invalid Rule Definition for Position.')
      DELETE DPSP
      return
    endhandle
    $!ruleRad
    handle(2,29)
      -- do nothing because rule of pos doesn't exist
    elsehandle any
      !!alert.error('Invalid Rule Definition for Extension.')
      DELETE DPSP
      return
    endhandle
    $!ruleDir
    handle(2,29)
      -- do nothing because rule of pos doesn't exist
    elsehandle any
      !!alert.error('Invalid Rule Definition for Direction.')
      DELETE DPSP
      return
    endhandle


    var !compose  COMPOSE SPACE 2 '$!dPointNo'  SPACE 2 '$!number' SPACE 2 '$!description' WIDTH 52
    !listD.insert(!listSelection + 1, !compose[1])
    !listR.insert(!listSelection + 1, !dPoint.string())



    -- set the new list up

    !this.list.dText = !listD
    !this.list.rText = !listR
    !this.list.val   = (!listSelection + 1)
    !this.dimensions.findDimensions()
    -- execute rules

    RULE REXE

    -- show the Point
    if(!this.checkDim(!dPoint).not()) then
      !this.dimensions.displayDimension(!dPoint.function.real(),true)
    endif
    !this.showPoint(TRUE)

    if(!this.list.rText.size().geq(2)) then
      !this.copy.active = TRUE
    endif

  elseif(!buttonPicked.eq('REPLACE') and !listSelection.neq(0) ) then

    !this.dimensions.hideAllDims()
    !this.showPoint(FALSE)

    -- check the data is complete   -------------------------------------
    if(!description.eq('') or !dPointNo.eq(0) or !number.eq(0)) then
      !!alert.error('Not all Information has been entered, for the Dimension Point.')
      return
    endif
    ---------------------------------------------------------------------

    !dPoint = !this.list.selection().dbRef()
    !listD.remove(!listSelection)
    !listR.remove(!listSelection)

    var !compose  COMPOSE SPACE 2 '$!dPointNo'  SPACE 2 '$!number' SPACE 2 '$!description' WIDTH 52
    !listD.insert(!listSelection, !compose[1])
    !listR.insert(!listSelection, !dPoint.string())

    -- goto point and replace attributes with data from modify gadgets
    !!ce = !dPoint

    PVIF 3 PURP DIM FUNC '$!dPointNo' NUMB $!number DESC '$!description'

    -- set the rules

    $!rulePos
    handle(2,29)
      -- do nothing because rule of pos doesn't exist
    elsehandle any
      !!alert.error('Invalid Rule Definition for Position.')
      return
    endhandle
    $!ruleRad
    handle(2,29)
      -- do nothing because rule of pos doesn't exist
    elsehandle any
      !!alert.error('Invalid Rule Definition for Extension.')
      return
    endhandle
    $!ruleDir
    handle(2,29)
      -- do nothing because rule of pos doesn't exist
    elsehandle any
      !!alert.error('Invalid Rule Definition for Direction.')
      return
    endhandle
    -- set the new list up

    !this.list.dText = !listD
    !this.list.rText = !listR
    !this.list.val   = !listSelection

    -- execute rules

    RULE REXE

    -- show the Point and dimension

    if(!this.checkDim(!dPoint).not()) then
      !this.dimensions.displayDimension(!dPoint.function.real(),true)
    endif
    !this.showPoint(TRUE)

  elseif(!buttonPicked.eq('REMOVE') and !listSelection.neq(0)) then

    !listPos = !this.list.val
    !dPoint = !this.list.selection().dbRef()
    !this.dimensions.hideAllDims()
    !this.showPoint(FALSE)

    !!ce = !dPoint
    DELETE DPSP

    !listD.remove(!listSelection)
    handle any
      -- removing from an empty list (someone will do it)
      return
    endhandle
    !listR.remove(!listSelection)


    -- redo list


    !this.list.dText = !listD
    !this.list.rText = !listR
    !this.list.val = !listPos - 1
    handle any
    endhandle

    if(!this.list.dText.set()) then
      !dPoint = !this.list.selection().dbRef()
    else
      !dPoint.delete()
    endif

    !this.dimensions.findDimensions()

    if(defined(!dPoint)) then
      if(!this.checkDim(!dPoint).not()) then
        !this.dimensions.displayDimension(!dPoint.function.real(),true)
      endif
      !this.showPoint(TRUE)
    endif
  endif

  if(!this.list.rText.size().eq(1)) then
    !this.copy.active = FALSE
  endif


  !!ce = !refe
  handle any
    -- in case it has been deleted
  endhandle


endmethod
-- End of method definition for .addToList(STRING)
------------------------------------------------------------------------
--
-- Method:    processRule(STRING,DBREF) STRING
--
-- Description: Convert Rule into Gadget string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Attribute Rule to Modify]
--   [2] [R]    [DBREF]     [DPOINT to edit rule of]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [With Rule Attribute removed]
--
------------------------------------------------------------------------

define method .processRule(!rule is STRING, !dbRef is DBREF) is STRING

  -- initialise Variables

  !refe = !!ce
  !pureRule =  STRING()

  -- for input into gadget
  !!ce = !dbRef
  var !getRule  RULE OF $!rule
  handle any
    -- in case the rule is not defined (core should return a null string)
    !getRule = STRING()
  elsehandle none
    !pureRule = !getRule.after('Rule').trim()
    !pureRule = !pureRule.replace(' ATTRIB', '')
  endhandle


  !!ce = !refe

  return !pureRule

endmethod
-- End of method definition for .processRule(STRING, DBREF) STRING
------------------------------------------------------------------------
--
-- Method:    processRule(STRING,GADGET) STRING
--
-- Description: Convert Rule into correct syntax from gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Attribute Rule to Modify]
--   [2] [R]    [GADGET]    [Gadget to read the rule from]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [string of rule in required format]
--
------------------------------------------------------------------------

define method .processRule(!rule is STRING, !gadget is GADGET) is STRING

  -- initialise Variables

  !refe = !!ce
  !pureRule =  STRING()

  -- for input from the gadget

  !ruleFromGadget  =  !gadget.val

  if(!ruleFromGadget.set() and !ruleFromGadget.neq('')) then
    !pureRule  =   'RULE SET ' & !rule  & ' (' & !ruleFromGadget & ' )'
  else
    !pureRule = 'RULE DELETE ' & !rule
  endif

  !!ce = !refe

  return !pureRule

endmethod
-- End of method definition for .processRule(STRING, GADGET) STRING


------------------------------------------------------------------------
--
-- Method:     showPlot()
--
-- Description: Show Plotfile Showing Dimension Details
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPlot()

  show !!tmpDptsPlot

endmethod
-- End of method definition for .showPlot()
------------------------------------------------------------------------
--
-- Method:     testForDuplicate(REAL,ARRAY) BOOLEAN
--
-- Description: Test for duplicate in list when including into the list of points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testForDuplicate(!number is REAL,!pointList is ARRAY) is BOOLEAN

  !test = FALSE

  do !i values !pointList
    if(!i.dbRef().number.eq(!number)) then
      !test = TRUE
      break
    endif
  enddo

  return !test

endmethod
-- End of method definition for .testForDuplicate(REAL,ARRAY) BOOLEAN
------------------------------------------------------------------------
--
-- Method:     showOrigin()
--
-- Description: Close the dimensioning point form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showOrigin()


  if(!this.aidShown) then
    !!aidNumbers.hide(!this.aidNumberO)
    !this.aidShown = FALSE
  else
    !this.origin.draw(!this.aidNumberO)
    !this.aidShown = TRUE
  endif

  !this.displayMenu.setFieldProperty('TemplateOrigin', 'SELECTED', !this.aidShown)

endmethod
-- End of method definition for .showOrigin()
------------------------------------------------------------------------
--
-- Method:     close()
--
-- Description: Close the dimensioning point form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.dimensions.hideAllDims()


  !this.showPoint(FALSE)

  !this.hide()

  !!aidNumbers.hide(!this.aidNumberO)
  !this.aidShown = FALSE
  !this.displayMenu.setFieldProperty('TemplateOrigin', 'SELECTED', !this.aidShown)

endmethod
-- End of method definition for .close()
