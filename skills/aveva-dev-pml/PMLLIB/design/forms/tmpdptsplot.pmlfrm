 setup form !!tmpDptsPlot

  !this.formTitle     = 'Dimension Point Plot'
  !this.iconTitle     = 'Dimension Point Plot'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.5 $ '


      !size = 'height 20 aspec 0.707'


    view .plot plot
      $!<size>
      borders on
      cursor pointer
      add "%PDMSPLOTS%/EQUIP/DPoint.plt"
      handle any

      endhandle
    exit

  exit
  -- end form definition
