--
-- Description:
-- Form for inputting and editing rules
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearExpression()                -                   ok form
--  initialise(DBREF,ATTRIBUTERULE)  -                   initialise form
--  ok()                             -                   ok form
--  showProperties()                 -                   ok form
--  testExpression()                 -
--  tmplExpression()                 -                   Constructor
--

-- Define form
setup form !!tmplExpression resize blocking

  !this.iconTitle     = 'AttrRule'
  !this.formTitle     = 'Attribute Rule'
--  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.12 $ '

  -- Information in the rule
  paragraph .type       anchor left + top at x1   y0   width 15
  paragraph .attribute  anchor left + top at xmax ymin width 45
  -- Number for Design parameters
--  numeric   .despNumber 'Design Parameter number' at xmin.type ymin.type range 1 100 step 1 ndp 0 width 3

  button .butClear 'Clear Rule' anchor left + top at x9 ymax+0.2
  path right
  button .test   'Test Expression' anchor left + top
  paragraph .testResult  anchor left + top + right  width 38 lines 3

  -- Main text pane
  text .text 'Expression' anchor left + top + right at x1 ymax tagwidth 8 width 65 scroll 256 is STRING

  -- Control which properties are shown
  frame .toggleFrame anchor left + top at xmin ymax+0.2
    path right
    paragraph .paraToggleFrame text 'Show Property Type'
    rtoggle .toggleTemplate 'Template'
    rtoggle .toggleElement  'Element'
    rtoggle .toggleOwner    'Element Owner'
  exit
  paragraph .ce anchor left + top + right at xmin ymax width 70 height 1

  list .list anchor all at xmin ymax columns single zerosel width 72 height 10

  button .ok     'OK'     anchor left + bottom  at xmin.text ymax+0.2 width 8
  button .cancel 'Cancel' anchor right + bottom at xmax form-size ymin width 8 cancel

  member .rule              is ATTRIBUTERULE
  member .currentTemplate   is DBREF

exit
-- end form definition

------------------------------------------------------------------------
--
-- Method:      .tmplExpression()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .tmplExpression()

  !this.ok.callback       = '!this.ok()'
  !this.butClear.callback = '!this.clearExpression()'
  !this.test.callback     = '!this.testExpression()'
  !this.testResult.val    = ''
  !this.toggleFrame.callback = |!this.showProperties()|
  !this.toggleFrame.val   = 1

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialise form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .initialise(!currentTemplate is DBREF, !attributeDefinition is ATTRIBUTERULE)

  -- Store the rule
  !this.rule = !attributeDefinition
  !this.testResult.val = ''
  !this.currentTemplate = !currentTemplate

  -- show type and attribute
  !this.attribute.val = 'Attribute: ' + !attributeDefinition.description
  !this.type.val      = 'Type: ' + !attributeDefinition.type
  -- Put existing rule string into the rule edit field
  if(!attributeDefinition.hasRule.not()) then
    !this.text.clear()
    !this.text.val = ''
  else
    !this.text.clear()
    !this.text.val = !attributeDefinition.rule
  endif

  -- Populate properties table
  !this.showProperties()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .test
--
-- Description: ok form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .testExpression()

  -- Get the expression
  !expression = !this.text.val
  if( !expression.trim().empty() ) then
    !this.testResult.val = ''
    return
  endif

  !result = !this.rule.testRule( !this.rule.element, !expression, !this.rule.attributeName )

  if( !result.empty() ) then

    -- Expression is valid - show result of expression
    -- had to use VAR here because some PML 1 expressions will not evaluate
    -- attempt to evaluate the expression at the element
    !element    = !this.rule.element
    !saveRef = !!ce
    !!ce = !element
    VAR !result ( $!<expression> )
    handle any
      -- this error should not happen because already tested in rule test method
    !this.testResult.val = 'Error: ' + !!error.text
    elsehandle none
      -- Can't do type check because all VAR results are string
      -- try PML 2 method
      !resultOfExpression  = !element.evaluate(object BLOCK(!expression))
      handle any
        !this.testResult.val = 'Result: ' + !result
      elsehandle none
        if( !resultOfExpression.objectType() eq 'REAL' ) then
          !this.testResult.val = 'Result: ' + !resultOfExpression.queryString()
        else
          !this.testResult.val = 'Result: ' + !result
        endif
      endhandle
    endhandle

    !!ce = !saveRef

  else

    -- Expression is not valid - show error
    !this.testResult.val = !result

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .ok
--
-- Description: ok form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- concatenate the textpane contents
  !expression = !this.text.val

  -- test the expression is correct and set the rule
  !this.rule.setRule(!expression)

  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .clearExpression
--
-- Description: ok form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clearExpression()

  -- concatenate the textpane contents
  !this.text.val = ''

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .showProperties
--
-- Description: ok form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .showProperties()

  -- concatenate the textpane contents
  !propertyType = !this.toggleFrame.val
  !element      = !this.rule.element

  if(!propertyType eq 2 ) then
    -- Element properties
    !targetElement = !element
  elseif(!propertyType eq 3 ) then
    -- Element owner properties
    !targetElement = !element.owner
  else
    -- default to Template properties
    !targetElement = !this.currentTemplate
  endif

  !tempProp = object COMPROP(!targetElement)

--  !tempProp.autoDelete(true)
--  !tempProp.deleteObject(false)
  !table    = !tempProp.getPropertyTable()
  !headings[1] = 'Type'
  !headings.appendArray(!table.tableHeadings)
  !this.list.setHeadings(!headings)
  !rows = ARRAY()
  do !row values !table.designParamTable
    !newRow = ARRAY()
    !newRow[1] = 'Design Parameter'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  do !row values !table.catParamTable
    !newRow = ARRAY()
    !newRow[1] = 'Catalogue Parameter'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  do !row values !table.expressionTable
    !newRow = ARRAY()
    !newRow[1] = 'Expression'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  do !row values !table.dataTable
    !newRow = ARRAY()
    !newRow[1] = 'Data'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  do !row values !table.attributeParamTable
    !newRow = ARRAY()
    !newRow[1] = 'Attributes'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  do !row values !table.specParamTable
    !newRow = ARRAY()
    !newRow[1] = 'Specification'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  do !row values !table.sbreParamTable
    !newRow = ARRAY()
    !newRow[1] = 'Sub-element'
    !newRow.appendArray(!row)
    !rows.append(!newRow)
  enddo
  -- show the list of properties available
  !this.list.setRows(!rows)
  !this.ce.val = !table.elementName

endmethod
-- End of method definition
