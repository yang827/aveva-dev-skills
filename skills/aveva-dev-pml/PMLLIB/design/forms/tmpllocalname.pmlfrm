--     Keyword:     TMPL
--   Module:        design
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Thu Oct 26 9:29:13 BST 2006
--
-- Description:
-- Local name setting
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkName()                      -                   Check for duplicate use of local name within given scope
--  initialise(DBREF,DBREF)          -                   initialise form
--  ok()                             -                   ok form
--  tmplLocalName()                  -                   Constructor
--

-- Define form
setup form !!tmplLocalName resize blocking

  !this.iconTitle     = 'LNAME'
  !this.formTitle     = 'Local Name'
--  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.12 $ '

  -- Main text pane
  text .txtLocalName 'Local Name' anchor left + top + right + bottom at xmin ymax width 21 scroll 21 NAME

  button .ok     'OK'     anchor left + bottom  at x1 ymax+0.2 width 6
  button .cancel 'Cancel' anchor right + bottom at xmax form-size ymin width 6 cancel

  member .scope       is DBREF
  member .element     is DBREF
  member .localName   is STRING

exit
-- end form definition

------------------------------------------------------------------------
--
-- Method:      .tmplLocalName()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .tmplLocalName()

  -- Initialise variables
  !this.ok.callback           = '!this.ok()'
  !this.txtLocalName.callback = '!this.checkName()'
  !this.localName             = ''

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialise form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .initialise(!scope is DBREF, !element is DBREF)

  -- Initialise form
  !this.scope     = !scope
  !this.element   = !element
  !this.localName = !element.lName
  if( !this.localName.set() ) then
    !this.txtLocalName.val = !this.localName
  else
    !this.txtLocalName.val = ''
    !this.localName        = ''
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check for duplicate use of local name within given scope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName()

  -- get new name and check its uniqueness
  !newLocalName = !this.txtLocalName.val
  -- empty value clears the name
  if( !newLocalName.trim().empty() ) then
    return
  endif

  -- put a slash in if there isn't one
   if(!newLocalName.subString(1,1) ne '/') then
      !newLocalName = '/' & !newLocalName
      !this.txtLocalName.val = !newLocalName
   endif
   -- check for name not changed
   if(!this.localName eq !newLocalName) then
    return
  endif

  -- check if name exists
  !strLocalNameList = !this.scope.lnlst
  if ( !strLocalNameList.unset() ) then
    return
  else
    !localNameList = !strLocalNameList.split()
    if( !localNameList.findFirst(!newLocalName).set() ) then
      !!alert.warning('Local name ' + !newLocalName + 'already used. Enter another name or Cancel')
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .ok
--
-- Description: ok form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- get the new Lname
  !newLocalName = !this.txtLocalName.val

  -- Goto the element and set Lname
  !!ce = !this.element
  -- Set the Lname
  if( !newLocalName.trim().empty() ) then
    -- empty value clears the name
    LNAME UNSET
  else
    LNAME $!newLocalName
  endif
  -- update the template parameters form
  if( !this.scope.type eq 'TMPL' ) then
    if( defined(!!tmplParamDefn) ) then
      if( !!tmplParamDefn.shown() ) then
        !!tmplParamDefn.populateMembers()
      endif
    endif
  endif

  !this.hide()

endmethod
-- End of method definition
