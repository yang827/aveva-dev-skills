--
-- Description:
-- from to list tmpl elements for Local name identification
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dismiss()                        -
--  initialise(STRING)               -
--  setLname()                       -
--
------------------------------------------------------------------------

-- Define form
setup form !!tmpLnameCrt

  !this.formTitle     = 'Define Local Names'
  !this.iconTitle     = 'Lnames'
  !this.callback      = '!this.initialise(||)'
  !this.formRevision  = ' $Revision: 1.11 $ '
  track    |DESICE| call '!this.initialise(|NAVI|)'
  -- Body of form definition

  -- Template Header
     para .tmpl at xmin ymax width 50 lines 1
     path down
     halign left

     list .list 'Template Members           Local Names' at xmin ymax call '!this.setLname()' width 50 length 12

--  Bottom Line
    button .dismiss 'Dismiss'  at xmax form-size ymax  call '!this.dismiss()' ok

-- member for TMPL

  member .template is DBREF

exit

-- End of form definition for !!tmpLnameCrt

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [flag to navigate ]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise(!option is STRING)

if(!option.eq('NAVI')) then
   !this.list.select('RTEXT',!!ce.string())
   handle any
   -- in case not in list
   endhandle

else

-- get tmp from browser (**** OLD STYLE  PML ****)
   !template = $_cdTmpMemb_memb
   if(!template.hardtype.neq('TMPL')) then
      return error 1 'A Template Has Not Been Selected in the Template Browser.'
   else
      !this.template = !template
   endif

   !tmpArrayDtext = ARRAY()
   !tmpArrayRtext = ARRAY()

   !this.tmpl.val = 'Template : ' & !template.flnn



-----------------------------------------------------------------
-- This block loads the list up staggered to show hierarchy depth
-- using old code to save time, until it can be changed.
-----------------------------------------------------------------
  -- Load design points
   var !coll COLLECT ALL (DPCA DPSP DPCY) FOR $!template
   !dflg = false   $* Ppoint flag

   if(arraySize(!coll) gt 0) then
     !dflg = true
     var !numb EVALUATE (NUMB + 1) FOR ALL FROM !coll IGNORE ANY |0|
     var !sort SORT !numb NUMERIC
     var !prim EVALUATE (VTEXT(!coll,VVAL(!sort,VVAL(!en)))) INDICES !sort COUNT !en
   endif

  -- Collect all members of the template (except properties and point set)
  -- and load into the member list.
   var !prim APPEND COLLECT ALL WITH (NOT TYPE INSET(|TMPL|,|DPSE|,|DDSE|,|DPCA|,|DPSP|,|DPCY|,|DDAT|,|VVALUE|,|ATTRRL|)) FOR $!template

  -- Load items into form
   if(!prim.size().gt(0)) then

    -- If there are some Ppoints, then display Point header
     if(!dflg) then
       !tmpArrayDtext.append('Design Points')
       !tmpArrayRtext.append('')
     endif

    -- Get depth down in the hierarchy
     var !tdep  (DDEPTH of $!template )
     var !depth EVALUATE ((DDEPTH - $!tdep - 1) * 4 + 2) FOR ALL FROM !prim
     var !tyse  EVALUATE (TYSEQU)   FOR ALL FROM !prim
     var !type  EVALUATE (TYPE)     FOR ALL FROM !prim
     var !pflg  EVALUATE (TYPE INSET (|DPCA|,|DPCY|,|DPSP|)) FOR ALL FROM !prim
     var !numb  EVALUATE (NUMB + 0) FOR ALL FROM !prim IGNORE ANY |0|
     var !lnam  EVALUATE (LNAME) FOR ALL FROM !prim IGNORE ANY ''

    -- Get deepest depth
     var !sort SORT !depth NUMERIC DESCEND
     !dpos  = !sort[1]
     !max   = !depth[$!dpos]
     !xflg  = false       $* Primitive header displayed

    -- Load into list
     do !i indices !prim

       !rmax = (!max.real() + 2 - !depth[!i].real())

      -- Compose the display string, if we are showing a design point, show the numb
       if(!pflg[!i].boolean()) then
         !ntxt = (|(| & !numb[!i] & |)|)
         var !dprt COMPOSE SPACE 1 |$!ntxt| WIDTH 5 R SPACE 1 |$!type[$!i]| WIDTH 4 SPACE 1  SPACE $!rmax |   $!lnam[$!i]|

      -- Standard Primitive
       else

        -- Display primitive header
         if(!xflg.not()) then
           !xflg = true
          !tmpArrayDtext.append('Primitives')
          !tmpArrayRtext.append('')

         endif


        var !dprt COMPOSE SPACE $!depth[$!i] |$!type[$!i]| WIDTH 4 SPACE 1 |$!tyse[$!i]| WIDTH 3 R SPACE $!rmax |   $!lnam[$!i]|
       endif
       !tmpArrayDtext.append('$!dprt[1]')
       !tmpArrayRtext.append('$!prim[$!i]')
     enddo
      !this.list.dText = !tmpArrayDtext
      !this.list.rText = !tmpArrayRtext
   endif

-- try and go to ce in the list
   !this.list.select('RTEXT', !!ce.string())
   handle any
   -- in case not in the list
   endhandle

endif
------------------------------------------------------------------------------
-- End of Old Block
------------------------------------------------------------------------------


endmethod
-- End of method definition for .initialise(STRING)

------------------------------------------------------------------------
--
-- Method:      setLname()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setLname()


-- Show form for Local naming (when at an element)
   if(!this.list.selection('RTEXT').neq('') ) then

      show !!tmpLnameSet
   endif



endmethod
-- End of method definition for .setLname()

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dismiss()

!!ce = !this.template

 ---handle any
   -- in case it has been deleted
 --endhandle


endmethod
-- End of method definition for .dismiss()
