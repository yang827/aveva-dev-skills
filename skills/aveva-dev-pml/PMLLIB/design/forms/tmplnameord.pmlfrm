--     Keyword:     TMPL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Thu Nov 20 08:14:33 GMT 1997
--
--
-- Description:
-- form to reorder lnames in TMPL LCNFA array
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  initialise()                     -
--  move(STRING)                     -
--  navigate()                       -
--  reOrder()                        -
--  tmpLnameOrd()                    -
--
------------------------------------------------------------------------

-- Define form
setup form !!tmpLnameOrd

   !!tmpLnameOrd.formTitle     = 'Local Name Rule Sequence'
   !!tmpLnameOrd.iconTitle     = 'ReOLnames'
   !!tmpLnameOrd.callback      = '!!tmpLnameOrd.initialise()'
   !!tmpLnameOrd.formRevision  = ' $Revision: 1.19 $ '

-- Body of form definition

-- Header including the Template name
   para .tmpl at xmin ymax width 40 lines 1
   path down
   halign left

-- List of Local Names
   list .list 'Local Names'  at xmin ymax call '!!tmpLnameOrd.navigate()' width 30 length 10

   button .top at xmax.list+1 ymin.list+1 tooltip 'Move to the top of the list'  pix height 20 width 20 call |!!tmpLnameOrd.move('TOP')|
   path down
   button .up  tooltip 'Move up one place in the list'   pix height 20 width 20 call |!!tmpLnameOrd.move('UP')|
   button .down  tooltip 'Move down one place in the list' pix height 20 width 20 call |!!tmpLnameOrd.move('DOWN')|
   button .bot tooltip 'Move to the bottom of the list' pix height 20 width 20 call |!!tmpLnameOrd.move('BOTTOM')|

-- Bottom Line
   button .ok   |  OK  | at xmin.list  ymax.list call '!!tmpLnameOrd.reOrder()' OK
   button .cancel |Cancel| at xmax form-size ymin call '!!aidClear(|19000|,|ALL|)'  CANCEL


exit

!this.cancelCall = '!!aidClear(|19000|,|ALL|)'

-- End of form definition for !!tmpLnameOrd
------------------------------------------------------------------------
--
-- Method:      tmpLnameOrd
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Which button pressed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tmpLnameOrd()

   !this.top.addPixmap(!!pml.getPathName('upuparrow16.png'))
   !this.up.addPixmap(!!pml.getPathName('uparrow16.png'))
   !this.down.addPixmap(!!pml.getPathName('downarrow16.png'))
   !this.bot.addPixmap(!!pml.getPathName('downdownarrow16.png'))

endmethod
-- End of method definition for .tmpLnameOrd()

------------------------------------------------------------------------
--
-- Method:      <initialise>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Which button pressed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()
-- Initialise Variables
   !refe = !!ce
   !display = ARRAY()
   !replace = ARRAY()
   !template = $_cdTmpMemb_memb
-- Header Set
   !this.tmpl.val = 'Template : ' & !template.flnn

-- get the local names from the template (DTEXT)

   !display = !template.rSeqfa
   !exLnam  = object BLOCK('!display[!evalIndex].lnam')
-- Convert to LNAME instead of DBREF
   !newDisp     = !display.evaluate(!exLnam)
-- Re-state the display array
   !display.delete()
   !display = !newDisp
   if(!display.unset()) then
      !display = !template.lnlst.split()
    handle any
--   don't do anything if there are no local names
     return error 1 'Template Selected Has No Local Names Set.'
    endhandle
   endif

-- get the Ref of the lnames (lnid is pseudo so have to do it via loop)
   !!ce = !template
   do !i indices !display
      !temp[!i] = (lnid $!display[$!i] )
      !replace.append(!temp[!i].string())
   enddo

-- Load list with data
   !this.list.dText = !display
   !this.list.rText = !replace

!!ce = !refe
endmethod
-- End of method definition for .initialise()


------------------------------------------------------------------------
--
-- Method:      <move>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Which button pressed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .move(!move is STRING)

-- get data from form (arrays) and selected
   !lnamePlacing = !this.list.val
   !lname        = !this.list.selection('DTEXT')
   !listSize     = !this.list.dText.size()
   !disp = !this.list.dText
   !repl = !this.list.rText

 if(!move.eq('TOP')) then
    !lnameDis = !disp.remove(!lnamePlacing)
    !lnameRep = !repl.remove(!lnamePlacing)
    !disp.insert(1,!lnameDis)
    !repl.insert(1,!lnameRep)
 elseif(!move.eq('BOTTOM')) then
    !lnameDis = !disp.remove(!lnamePlacing)
    !lnameRep = !repl.remove(!lnamePlacing)
    !disp.append(!lnameDis)
    !repl.append(!lnameRep)

 elseif(!move.eq('DOWN')) then
    !lnameDis = !disp.remove(!lnamePlacing)
    !lnameRep = !repl.remove(!lnamePlacing)
-- wrap around when at bottom
    if(!listSize.neq(!lnamePlacing)) then
       !disp.insert((!lnamePlacing + 1),!lnameDis)
       !repl.insert((!lnamePlacing + 1),!lnameRep)
    else
       !disp.insert(1,!lnameDis)
       !repl.insert(1,!lnameRep)
    endif
 elseif(!move.eq('UP')) then
    !lnameDis = !disp.remove(!lnamePlacing)
    !lnameRep = !repl.remove(!lnamePlacing)
-- wrap around when at the top
    if(!lnamePlacing.neq(1)) then
       !disp.insert((!lnamePlacing - 1),!lnameDis)
       !repl.insert((!lnamePlacing - 1),!lnameRep)
    else
       !disp.append(!lnameDis)
       !repl.append(!lnameRep)
    endif
 endif
-- Load list with data
   !this.list.dText = !disp
   !this.list.rText = !repl
-- Go Back to selected
   !this.list.select('DTEXT',!lname)

-- Reload Form List
endmethod
-- End of method definition for .move(STRING)


------------------------------------------------------------------------
--
-- Method:      <navigate>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Which button pressed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .navigate()

 !item = !this.list.selection('RTEXT')
 !displ = !this.list.selection('DTEXT')
 !!ce  = !item.dbRef()
 call !!aidClear('19000','ALL')
 call !!aidAxes(19000,!displ,!!ce.position, 500mm)
 handle any
   -- There are cases where the selected element does not have a position
   return
 endhandle

endmethod
-- End of method definition for .navigate()
------------------------------------------------------------------------
--
-- Method:      <reOrder>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Which button pressed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .reOrder()
 !refe = !!ce
 !refes = !this.list.rText
 do !i indices !refes
    !!ce = !refes[!i].dbRef()
-- PDMS COMMAND
   RSEQN $!i
 enddo
!!ce = !refe
endmethod
-- End of method definition for .reOrder()
