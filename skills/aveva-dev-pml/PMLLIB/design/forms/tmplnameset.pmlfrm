--
--
-- Description:
-- Form for setting the lname
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkName()                      -
--  initialise()                     -
--  setName()                        -
--
------------------------------------------------------------------------

-- Define form
setup form !!tmpLnameSet

  !!tmpLnameSet.formTitle     = '   Local Name Definition   '
  !!tmpLnameSet.iconTitle     = 'LnamDef'
  !!tmpLnameSet.callback      = '!!tmpLnameSet.initialise()'
  !!tmpLnameSet.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition

  text .name at xmax ymin+0.1 call '!!tmpLnameSet.checkName()' WIDTH 20 SCROLL 20 NAME

  !!tmpLnameSet.name.val = 'unset'

 -- Attribute Button
  path down
  halign right

 -- Bottom Line
  button .apply   | OK | at xmin form+0 ymax+0.5 call '!!tmpLnameSet.setName()' OK
  button .dismiss |Cancel| at xmax form-size ymin  CANCEL



exit
-- End of form definition for !!tmpLnameSet

------------------------------------------------------------------------
--
-- Method:      <initialise>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

-- Goto the element and set Lname
   !!ce = !!tmpLnameCrt.list.selection('RTEXT').dbRef()
-- get the current lname setting

     !lname = !!tmpLnameCrt.list.selection('DTEXT').part(3)

   if(!lname.eq('') ) then
      !lname = 'unset'
   endif

!this.name.val = !lname
!this.name.setFocus()


endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      <setName>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setName()

-- get the name the user wishes for the Lname
   !newName = !this.name
-- Goto the element and set Lname
   !!ce = !!tmpLnameCrt.list.selection('RTEXT').dbRef()
-- Set the Lname
   LNAME $!newName
   -- Re load Crt form
   !!tmpLnameCrt.initialise('')

endmethod
-- End of method definition for .setName()


------------------------------------------------------------------------
--
-- Method:      <checkName>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName()

-- goto the picked element

  !element = !!tmpLnameCrt.list.selection().dbRef()

-- get the name the user wishes for the Lname

   !newName = !this.name.val
-- put a slash in if there isn't one
   if(!newName.subString(1,1) ne '/') then
      !newName = '/' & !newName
      !this.name.val = !newName
   endif
-- Get the TMPL refe

   !!ce = !element

   var !temp TMPL
   !tmpl = !temp.dbRef()

--  check whether lname already used
  if (!tmpl.lnlst.unset()) then
    return
  elseif(!tmpl.lnlst.match(!newName) ne 0) then
     !this.name.val = 'unset'
     return error 1 'Local name already exists'
  endif


endmethod
-- End of method definition for .checkName()
