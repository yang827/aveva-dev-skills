-- Description:
--  Define parameterisation of Design Template members
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form
--  copyRulesFrom(DBREF)             -                   Populate the rules list with rules from the given element
--  feedback()                       -                   Provide graphical feedback on the current item
--  feedback(DBREF)                  -                   Provide graphical selection feedback - including rotation axes
--  initialise()                     -                   Initialise form
--  initialise(DBREF)                -                   Initialise form
--  isCopyable()                     BOOLEAN             Check if given element rules can be copied
--  isPasteable()                    BOOLEAN             Check if given element is repeatable
--  isRepeatable(DBREF)              BOOLEAN             Check if given element is repeatable
--  localName()                      -                   Define local name for the selected element
--  navigate()                       -                   Popup menu callback- Navigate to selected element
--  pasteRules()                     -                   Populate the rules list with rules from the given element
--  pickCopyRules()                  -
--  populateMembers()                -                   Populate the Template Members list
--  populateRules()                  -                   Populate the rules list with rules for the currently
--  populateRules(DBREF)             -                   Populate the rules list with rules for this element
--  refresh()                        -                   Refresh form if attribute is changed
--  repeatRule()                     -                   Define repeat rule for the selected element
--  rules()                          -                   Populate the rules list with rules for the currently
--  scanMembers(DBREF,STRING)        ARRAY               CALLED RECURSIVELY - scan Template to find Template members
--  tidy()                           -                   Tidy up aid graphics
--  tmplParamDefn()                  -                   Constructor
--
------------------------------------------------------------------------

setup form !!tmplParamDefn dialog dock right

  !this.iconTitle     = 'TmplParam'
  !this.formTitle     = 'Template Member Parameters'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.12 $ '
--  track 'DBCHANGED' call '!this.dbChanged()'

  -- Template Header
  paragraph .head   anchor left + top at xmin ymax width 50 lines 1
  path down
  halign left

  -- Template Members
  list .lstMembers |Template Members|  anchor left + right + top + bottom at xmin ymax call |!this.populateRules()| width 50 length 12

  frame .functionFrame panel           anchor left + right + bottom    at x0  ymax width 50
    path right
    -- Modify Local Name
    button .butCopyRules |Copy Rules|         anchor left + bottom  at xmin  ymax call |!this.copyRulesFrom(!this.currentTemplateItem)| width 13
    button .butLname     |Set Local Name|     anchor left + bottom  call |!this.localName()| width 13
    button .butRepeat    |Define Repeat Rule| anchor left + bottom  call |!this.repeatRule()| width 13
    button .butCopyRulesFrom |Copy Rules From...|  anchor left + bottom at xmin.butCopyRules ymax+0.2 call |!this.pickCopyRules()| width 13
    button .butRefresh   |Refresh|            anchor left + bottom  call |!this.initialise()| width 13
    toggle .togAxes      |Show Axes|          anchor left + bottom  call |!this.feedback()|
  exit

  -- Box Attributes
  line .ruleLine      anchor left + right + bottom    at x0  ymax horiz width 52 height 0.2

    -- Pick items rules are to be copied from
    button .butPasteRules |Paste Rules|  anchor right + bottom at x34 ymax+0.2 call |!this.pasteRules()| width 13

    -- List of parameterisation rules
    list .lstRules 'Rules' anchor left + right + bottom   at xmin.lstMembers ymax-0.4 call |!this.rules()| width 50 length 10

  -- Bottom Line
  button .butDismiss |Dismiss|  anchor right + bottom at xmax form-size ymax+0.2 call |!this.close()| ok

  -- Form Members

  -- Design Template this form is editing
  member .currentTemplate       is DBREF
  member .currentTemplateItem   is DBREF

  member .attrHeadings          is ARRAY
  member .ruleHeadings          is ARRAY
  member .strIndent             is STRING

  -- Aid numbers for position & axes
  member .aidAxes               is REAL
  member .aidBox                is REAL

  -- EDG Description
  member .packet                is EDGPACKET
  member .edgDescription        is STRING

  -- Undo event handlers
  member .undoCopyRule          is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      tmplParamDefn
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplParamDefn()

  -- Register form to show in any application, but not on start-up
  !!appFormCntrl.registerForm(!this,ARRAY(),ARRAY(),false,false)

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'
  !this.killingCall       = '!this.tidy()'

  -- Attribute Table Headings
  !this.attrHeadings[1] = 'Element'
  !this.attrHeadings[2] = 'Rules'
  !this.attrHeadings[3] = 'Local Name'
  !this.attrHeadings[4] = 'Repeat'

  -- Rule Table Headings
  !this.ruleHeadings[1] = 'Attribute'
  !this.ruleHeadings[2] = 'Description'
  !this.ruleHeadings[3] = 'Rule'
  !this.strIndent       = '. '

  -- Aid Number
  !this.aidAxes   = !!aidNumbers.add('TemplateMember')
--  !this.aidBox    = !!aidNumbers.add('BoxPrimitive')
  !this.edgDescription    = 'Copy rules from element'

  -- Popup Menu
  !menu = !this.newMenu('Members')
  !menu.add('callback', 'Navigate To',  '!this.navigate()')

  !this.lstMembers.popup = !menu

  -- Initialise Panels
  !this.initialise()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Clear feedback & EDG & hide the form
  !this.tidy()
  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
--  !!aidNumbers.hide(!this.aidBox)
  !!aidNumbers.hide(!this.aidAxes)
  -- unenhance current item if set
  call !!enhanceItem(!this.currentTemplateItem, '')
  handle any
  endhandle

  -- This section highlights the selected element if the user has a dedicated template view
  -- as created from the template browser form, P-43545
  !viewToken = !!CDTMPMEMB.memberView.viewToken
  handle any
    !viewToken = 1
  endhandle
  !drawlist = !!gphdrawlists.drawlists[!viewToken]
  handle any
    return
  endhandle

  !drawlist.unhighlight(!this.currentTemplate)
  !drawlist.update()
  ----

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !temp = !!tmpGetCurrentTemplate()
  if(badref(!temp)) then
    !!alert.warning('No Design Template Selected')
    return
  endif

  !this.initialise(!temp)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!template is DBREF)

  -- Initialise Variables
  !this.currentTemplate = !template

  -- output title or name
  if(!this.currentTemplate.description.trim().empty().not()) then
    !this.head.val = 'Template: ' + !this.currentTemplate.description.trim()
  else
    !this.head.val = 'Template: ' + !this.currentTemplate.flnm
  endif

  -- remember current selection if still there after repopulation
  !selectedMember = !this.lstMembers.selection()

  -- clear lists
  !this.lstMembers.clear()
  !this.lstMembers.setHeadings(!this.attrHeadings)
  !this.lstRules.clear()
  !this.lstRules.setHeadings(!this.ruleHeadings)

  -- disable buttons until member selected
  !this.butLname.active         = false
  !this.butRepeat.active        = false
  !this.butCopyRules.active     = false
  !this.butPasteRules.active    = false
  !this.butCopyRulesFrom.active = true

  !this.populateMembers()
  !this.lstMembers.select('RTEXT',!selectedMember)
  handle none
    !this.populateRules()
  elsehandle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      populateMembers
--
-- Description: Populate the Template Members list
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateMembers()

  -- walk the structure to find parameterised members
  !membersArray = !this.scanMembers(!this.currentTemplate,'')

  !this.lstMembers.setRows(!membersArray[2])
  !this.lstMembers.rtext = !membersArray[1]

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      scanMembers
--
-- Description: CALLED RECURSIVELY - scan Template to find Template members
--              and display information about rules & repeats
--              The data returned is used to populate the template members list.
--              The array has two elements:
--              [1] contains an array of RTEXT (string references of member elements)
--              [2] contains a two dimensional array
--                  Each element of the array represents a row in the table
--                  Each row contains:
--                    [1]  Element Name as Type + Sequence Number (names not used in Templates)
--                    [2]  Rule count for this element - 'No Rules' or 'n Rules'
--                    [3]  Local Name
--                    [4]  Repeat indicator - 'Repeated' or null string
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       element whose members are scanned
--    2   R      STRING      Indentation string used to indicate member hierarchy
-- Return:
--   [Data Type] [Description]
--    ARRAY       Members and member data as described above
--
------------------------------------------------------------------------

define method .scanMembers(!element is DBREF, !indent is STRING) is ARRAY

  !tempArray      = object ARRAY()
  !returnArray[1] = object ARRAY()
  !returnArray[2] = object ARRAY()
  !members        = !element.members

  do !member values !members

    -- skip datasets
    skip if (!member.hardType eq 'DDSE')

    -- skip repeated elements, except for the master

    if( !member.attlis.findFirst('TMRREF').set() ) then
      if( not badref(!member.tmrref) ) then
      -- this is a repeat element
        if( not badref(!member.tmrref.tmrMaster) ) then
          -- back pointer should be valid, but tested just in case
          -- if repeat master reference does not point to self, then this is not a repeat master
          skip if(!member neq !member.tmrref.tmrMaster)
        endif
      endif
    endif

    if( !member.hardType eq 'DPSE' )then
      skip if( !member.mcount eq 0 )
      -- special presentation of Design Point sets
      !tempArray[1]  = !indent + 'Points'
      !tempArray[2]  = ' '
      !tempArray[3]  = ' '
      !tempArray[4]  = ' '
    elseif( !member.hardType eq 'TMRPSE' ) then
      skip if( !member.mcount eq 0 )
      !tempArray[1]  = !indent + 'Repeats'
      !tempArray[2]  = ' '
      !tempArray[3]  = ' '
      !tempArray[4]  = ' '
    else
      -- Right justify type sequence in 4 spaces
      !typeSequence = '   ' + !member.tySequence.string()
      !typeSequence = !typeSequence.subString( (!typeSequence.length() - 3), 4 )
      -- get 'name' - The element can't actually be named, so type and sequence is used
      !tempArray[1]  = !indent + !member.type + !typeSequence
      -- Put Design point number in brackets
      if( !member.owner.hardType eq 'DPSE' ) then
        !tempArray[1] = !tempArray[1] + ' (dpps' + !member.number.string() + ')'
      endif
      -- get number of rules
      !ruleCount = !member.rlis.size()
      if( !ruleCount eq 0 ) then
        !tempArray[2]  = 'No Rules'
      elseif( !ruleCount eq 1 ) then
        !tempArray[2]  = '1 Rule'
      else
        !tempArray[2]  = !ruleCount.string() + ' Rules'
      endif

      -- Get local name
      !localName = !member.lname
      if( !localName.set() ) then
        !tempArray[3] = !localName.subString(2)
      else
        !tempArray[3] = ''
      endif

      -- Repeat members
      !tempArray[4] = '    --    '
      if( !this.isRepeatable(!member) ) then
        !tempRepeatRef = !member.tmrref
        handle any
        elsehandle none
          if( not badref(!tempRepeatRef) ) then
            !tempArray[4] = 'Repeated'
          else
            !tempArray[4] = ' '
          endif
        endhandle
      endif

    endif

    -- put reference number into first array element for list Rtext
    !returnArray[1].append(!member.string())
    -- add to list of elements
    !returnArray[2].append(!tempArray)

    -- walk the structure to find parameterised members
    !localIndent = !indent + !this.strIndent

    !tempResult = !this.scanMembers(!member, !localIndent)
    if( !tempResult.set() ) then
      !returnArray[1].appendArray(!tempResult[1])
      !returnArray[2].appendArray(!tempResult[2])
    endif
  enddo

  return !returnArray

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      populateRules
--
-- Description: Populate the rules list with rules for the currently
--              selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateRules()

  -- unenhance current item if set
  call !!enhanceItem(!this.currentTemplateItem, '')
  handle any
  endhandle

  -- This section highlights the selected element if the user has a dedicated template view
  -- as created from the template browser form, P-43545
  !viewToken = !!CDTMPMEMB.memberView.viewToken
  handle any
    !viewToken = 1
  endhandle
  !drawlist = !!gphdrawlists.drawlists[!viewToken]
  handle any
    -- continue to update table if template not drawn
  elsehandle none
    !drawlist.unhighlight(!this.currentTemplate)
    !drawlist.update()
  endhandle

  -- get new selection
  !elementRef = !this.lstMembers.selection()
  !this.currentTemplateItem = !elementRef.dbref()
  handle any
    -- A member has been deleted but the list is not updated
    !this.initialise()
    return
  endhandle

  !this.populateRules(!this.currentTemplateItem)

  -- enable buttons now member selected
  !adminElements[1]          = 'DPSE'
  !adminElements[2]          = 'TMRPSE'
  !this.butLname.active      = ( !adminElements.findFirst(!this.currentTemplateItem.hardType).unset() )
  !this.butCopyRules.active  = !this.isCopyable()
  !this.butPasteRules.active = !this.isPasteable()
  !this.butRepeat.active     = !this.isRepeatable(!this.currentTemplateItem)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      populateRules
--
-- Description: Populate the rules list with rules for this element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Element reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateRules(!element is DBREF)

  -- Get rules for this element
  !rules = object ELEMENTRULES(!element)
  var !coordinate coordinate
  !ruleTable     = object ARRAY()
  !ruleRow       = object ARRAY()
  !rtext         = object ARRAY()

  -- Loop through attributes to find those with rules
  do !attributeDefinition values !rules.attributeRules
    !attrib     = !attributeDefinition.attributeName.upcase()

    if( !attributeDefinition.canHaveRule ) then
      -- attribute that can have a rule gets an entry in the table
      !ruleRow[1] = !attrib.subString(1,1) + !attrib.subString(2).lowcase()
      !ruleRow[2] = !attributeDefinition.description

      if(!coordinate eq 'XYZ') then
        -- In XYZ mode, the special attribute names must remain Northing etc.
        -- but the display text can change to XYZ style.
        if(!ruleRow[2].upcase().eq('EASTING') ) then
          !ruleRow[2] = 'X'
        elseif(!ruleRow[2].upcase().eq('NORTHING')) then
          !ruleRow[2] = 'Y'
        elseif(!ruleRow[2].upcase().eq('UPPING')) then
          !ruleRow[2] = 'Z'
        endif
      endif

      if( !attributeDefinition.hasRule ) then
        if( !attributeDefinition.type eq 'DESPARAM' ) then
           -- Design parameter rules have to be handled separately
           -- Loop through DESP rules
           do !despIndex indices !attributeDefinition.ruleArray
             !attrib     = 'DESPARAM NUMB ' + !despIndex.string() + ' '
             !ruleRow[1] = 'Desparam[' + !despIndex.string() + ']'
             !ruleRow[2] = 'Design Parameter'
             !ruleRow[3] = !attributeDefinition.ruleArray[!despIndex]
             -- add to table for display
             !ruleTable.append(!ruleRow)
             !rtext.append(!attrib)
           enddo
           -- add an entry for the next design parameter
           !nextIndex = !attributeDefinition.ruleArray.maxIndex() + 1
           !attrib     = 'DESPARAM NUMB ' + !nextIndex.string() + ' '
           !ruleRow[1] = 'Desparam[' + !nextIndex.string() + ']'
           !ruleRow[2] = 'Design Parameter'
           !ruleRow[3] = '----------  None  ----------'
        else
          -- simple attribute rule - just add to table
          !ruleRow[3] = !attributeDefinition.rule
        endif

      else
        !ruleRow[3]   = '----------  None  ----------'
      endif
      -- add to table for display
      !ruleTable.append(!ruleRow)
      !rtext.append(!attrib)
    endif

  enddo

  -- Add rules to list gadget
  !this.lstRules.setRows(!ruleTable)
  !this.lstRules.rtext = !rtext

  -- Provide feedback on selected item
  !this.feedback(!element)

  -- ensure we navigate to item
  -- creation of ELEMENTRULES obj
  -- only navigates if rules present
  !!ce = !element

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copyRulesFrom
--
-- Description: Populate the rules list with rules from the given element
-- Attributes must match and rules should be legal.
-- Rules will be deleted if rule is empty in 'from' element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Element reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyRulesFrom(!fromElement is DBREF)

  -- Get rules for this element
  !rules = object ELEMENTRULES(!fromElement)
  !rules.addToRulePasteBuffer()
  !this.butPasteRules.active = !this.isPasteable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pasteRules
--
-- Description: Populate the rules list with rules from the given element
-- Attributes must match and rules should be legal.
-- Rules will be deleted if rule is empty in 'from' element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Element reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pasteRules()

  -- Get rules for this element
  if( not defined(!!globalRulePasteBuffer) ) then
    return
  endif
  !rules = !!globalRulePasteBuffer
  !toElement = !this.currentTemplateItem
  -- Initialise position change undo
  !this.undoCopyRule.description('Copy Rules')
  !this.undoCopyRule.undoAction('!!tmplParamDefn.refresh()')
  !this.undoCopyRule.redoAction('!!tmplParamDefn.refresh()')
  !this.undoCopyRule.add()
  !changed = !rules.copyRulesTo(!toElement)
  if( !changed ) then
    !!ce = !toElement
    RULE EXECUTE ALL ON ALL FOR CE
  endif
  !this.undoCopyRule.endUndoable()

  -- Provide feedback on selected item
  !this.refresh()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form if attribute is changed
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif
  if(badref(!this.currentTemplateItem)) then
    return
  endif

  !this.populateRules(!this.currentTemplateItem)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      feedback
--
-- Description: Provide graphical feedback on the current item
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .feedback()

  !this.feedback(!this.currentTemplateItem)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      feedback
--
-- Description: Provide graphical selection feedback - including rotation axes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .feedback(!element is DBREF)

  !!aidNumbers.hide(!this.aidAxes)

  if( !this.togAxes.val ) then

    -- Set graphical aid axes length
    !axesLength = 500mm

    -- allow for elements without their own orientation
    !orientation = !element.orientation
    handle any
      !orientation = !element.owner.orientation
      handle any
        !orientation = !element.owner.owner.orientation
        handle any
          !orientation = object ORIENTATION('Y IS N AND Z IS U')
        endhandle
      endhandle
    endhandle

    -- Draw axes at the orientation
    !gAxes = object GPHAXES(!element.position, !orientation)
    handle any
      -- No axis shown for objects without position and orientation
    elsehandle none
      !gAxes.height = !axesLength
      !gAxes.draw(!this.aidAxes)
    endhandle

  endif

  !!enhanceItem(!element, !!gphColOpt.highlight().string())
  handle any
  endhandle

  -- This section highlights the selected element if the user has a dedicated template view
  -- as created from the template browser form, P-43545
  !viewToken = !!CDTMPMEMB.memberView.viewToken
  handle any
    !viewToken = 1
  endhandle
  !drawlist = !!gphdrawlists.drawlists[!viewToken]
  handle any
    return
  endhandle

  !drawlist.unhighlight(!this.currentTemplate)
  !drawlist.update()
  !drawlist.highlight(!element,18)
  ----

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      rules
--
-- Description: Populate the rules list with rules for the currently
--              selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rules()

  !attribute = !this.lstRules.selection()
  if(not defined(!!tmplExpression)) then
    pml reload form !!tmplExpression
  endif

   -- Get definition of attribute
  !attribDefn = object ATTRIBUTERULE()
  !attribDefn.getRule(!this.currentTemplateItem, !attribute.upcase().trim())
  -- show rule editor (blocking)
  show !!tmplExpression
  !!tmplExpression.initialise(!this.currentTemplate, !attribDefn)

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      localName
--
-- Description: Define local name for the selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .localName()

  show !!tmplLocalName
  !!tmplLocalName.initialise(!this.currentTemplate, !this.currentTemplateItem)

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      repeatRule
--
-- Description: Define repeat rule for the selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .repeatRule()

  -- get any repeat rule associated with the current item
--  !repeat = object COMREPEAT(!this.currentTemplateItem)
  !repeat = object COMREPEAT(!this.currentTemplateItem)
  if( badref(!repeat.repeatSet) ) then
    -- set reference of repeat set
    !repeatSet = object DBREF('TMRPSE 1 OF ' + !this.currentTemplateItem.string())
    handle any
      -- if no repeat set - create one
      !!ce = !this.currentTemplateItem
      NEW TMRPSE
      !repeatSet = !!ce
    endhandle
    !repeat.repeatSet = !repeatSet
  endif
  -- show the repeat definition form
  show !!tmplRepeats
  !!tmplRepeats.initialise(!repeat)

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      isRepeatable
--
-- Description: Check if given element is repeatable
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isRepeatable(!element is DBREF) is BOOLEAN

  if(!element.hardType eq 'TMRREL') then
    -- At repeat definition element - find repeated element
    !isRepeatable = ( not badref(!element.tmrMaster) )
  else
    -- The element must have a TMRREF attribute to be repeatable
    !repeatPointerAttrib = 'TMRREF'
    !isRepeatable = !element.attlis.findFirst(!repeatPointerAttrib).set()
  endif
  return !isRepeatable

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      isPasteable
--
-- Description: Check if given element is repeatable
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isPasteable() is BOOLEAN

  if( badref(!this.currentTemplateItem) ) then
    return false
  endif
  if( not defined(!!globalRulePasteBuffer) ) then
    return false
  endif

  return (not !this.currentTemplateItem.hardType inset('TMRPSE','DPSE'))

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      isCopyable
--
-- Description: Check if given element rules can be copied
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isCopyable() is BOOLEAN

  if( badref(!this.currentTemplateItem) ) then
    return false
  endif

  return (not !this.currentTemplateItem.hardType inset('TMRPSE','DPSE'))

endmethod
-- End of method definition

-------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Popup menu callback- Navigate to selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

  !selectedElement = !this.lstMembers.selection()
  !ref = !selectedElement.dbref()
  handle any
    return
  endhandle
  !!ce = !ref

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Pick element to copy rules from
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickCopyRules()

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick item to copy rules')
  !packet.action         = '!!tmplParamDefn.copyRulesFrom(!this.return[1].item)'
  !packet.key            = 'Copy Rules'
  !packet.description    = !this.edgDescription
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
