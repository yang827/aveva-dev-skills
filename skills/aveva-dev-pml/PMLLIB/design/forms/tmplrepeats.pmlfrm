---
--
-- Description:
--  Design Template Repeats definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Initialise form from repeat object
--  clear()                          -                   Initialise form from repeat object
--  close()                          -                   Close form
--  feedback()                       -                   Draw rotation axes
--  initialise()                     -                   Initialise form from repeat object
--  initialise(COMREPEAT)            -                   Initialise form from repeat object
--  numberRule()                     -                   callback for number-off rule
--  packetClose()                    -                   Tidy up after EDG close
--  packetEscape()                   -                   Tidy up after EDG close
--  redoApplyCallback()              -                   Refresh form if attribute is changed
--  selectType(GADGET,STRING)        -                   Set REAL attribute data if in edit mode
--  setAxis()                        -                   Show axis feedback
--  setPosition()                    -                   Set position data
--  setPosition(POSITION)            -                   Set position data
--  setWrt()                         -                   Set up with new wrt item
--  showAxis()                       -                   Show axis feedback
--  showAxis(POINTVECTOR)            -                   Set position data
--  testExpression(STRING)           BOOLEAN             Test expression
--  tidy()                           -                   Tidy up aid graphics
--  tmplRepeats()                    -                   Constructor
--  undoApplyCallback()              -                   Refresh form if attribute is changed
--  updateGadgets()                  -
--  validateAngle(GADGET,STRING)     -
--  validateDistance(GADGET,STRING)  -                   Check REAL distance attribute data input
--
------------------------------------------------------------------------

setup form !!tmplRepeats dialog resize

  !this.iconTitle     = 'Repeats'
  !this.formTitle     = 'Repeats'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.12 $ '
--  track 'DBCHANGED' call '!this.dbChanged()'

  -- Element to be repeated
  paragraph .paraRepeatElement anchor left + top + right  at x0.5 ymax width 38
  path right
  -- Expression for number of copies
  text   .txtNumberCopies  'Number of Repeats:' anchor left + top + right  at xmin.paraRepeatElement ymax callback |!this.numberRule()| tagwidth 18 width 22 is STRING

  -- Set type of repeat
  frame  .frameRepeatType panel  anchor left + right + top  at xmin.paraRepeatElement ymax

    path down
    line .lineC      anchor left + right + top  at x0 ymax  horiz width 41 heigh 0.2
    rtoggle .rtogOffset |Cartesian| tagwidth 6 at xmin ymax

    -- one panel for each repeat type
    frame .frameOffset panel anchor left + right + top  at xmax-1   ymin
      path down
      text      .txtOffsetX  '       X'   at ymax.rtogOffset+.2 anchor left + right + top tagwidth 10 width 22 is REAL format !!distanceFmt
      text      .txtOffsetY  '       Y'   anchor left + right + top tagwidth 10 width 22 is REAL format !!distanceFmt
      text      .txtOffsetZ  '       Z'   anchor left + right + top tagwidth 10 width 22 is REAL format !!distanceFmt
    exit

    line .lineL      anchor left + right + top  at x0 ymax  horiz width 41 heigh 0.2
    rtoggle .rtogLinear |Linear|    tagwidth 6 at xmin ymax

    frame .frameLinear panel anchor left + right + top  at xmax-1   ymin
      path down
      text   .txtLinearDist  'Distance:'  anchor left + right + top tagwidth 10 width 22 is REAL format !!distanceFmt
      text   .txtLinearDir   'Direction:' anchor left + right + top tagwidth 10 width 22 is DIRECTION
    exit

    line .lineR      anchor left + right + top  at x0 ymax  horiz width 41 heigh 0.2
    rtoggle .rtogRadial |Radial|    tagwidth 6 at xmin ymax

  -- Positioning Gadgets
    frame .frameRadial panel anchor left + right + top  at xmax-1  ymin
      path right
      path down
      text      .txtAngle        'Angle:'          at xmin.txtLinearDist ymax+.2 anchor left + right + top tagwidth 10 width 22 is REAL
      text      .txtAxis         'Axis Direction:' anchor left + right + top            tagwidth 10 width 22 is DIRECTION
      text      .txtRadialOffset 'Axis Step:'      anchor left + right + top            tagwidth 10 width 22 is REAL format !!distanceFmt
      toggle    .rtogRotate      'Rotate Element'  anchor left + right + top at xmin.txtRadialOffset+10  ymax
      halign left
      path right
      paragraph .paraPosition  at xmin.txtRadialOffset ymax  text  'Axis Position:' width 9
      path down
      option .ew    anchor left + bottom  at xmin.paraPosition ymax width 6
      option .ns    anchor left + bottom  width 6
      option .ud    anchor left + bottom  width 6
      text   .x     anchor left + right + bottom at xmax+1 ymin.ew width 22 is REAL format !!distanceFmt
      text   .y     anchor left + right + bottom at xmin   ymin.ns width 22 is REAL format !!distanceFmt
      text   .z     anchor left + right + bottom at xmin   ymin.ud width 22 is REAL format !!distanceFmt
--    toggle .xFlag anchor right + bottom        at xmax+1 ymin.ew
--    toggle .yFlag anchor right + bottom        at xmin   ymin.ns
--    toggle .zFlag anchor right + bottom        at xmin   ymin.ud
--    para   .lock  anchor right + bottom        at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
      --  Reference (wrt)
      text .wrt 'wrt:' anchor left + right + bottom  at xmin.txtAngle+.2  ymax.ud+0.2  tagwid 10 callback '!this.setWrt()' width 22 string

    exit
  exit

  line .acLine      anchor left + right + top  at x0 ymax  horiz width 41.5 heigh 0.5

  -- Action Buttons
  button .butApply   'OK'     anchor left + bottom   at x1  ymax               callback '!this.apply()'  width 8
  button .butDismiss 'Cancel' anchor right + bottom  at xmax.acLine-size  ymin callback '!this.close()'  width 8 cancel

  -- Form Members

  -- Primitive this form is editing
  member .repeatDefinition      is COMREPEAT
--  member .editElement           is DBREF

  -- Position
  member .position              is POSITIONLINK

  -- Aid numbers for position & axes
  member .aidRotateAxis         is REAL

  -- EDG Description
  member .packet                is EDGPACKET
  member .edgDescription        is STRING

  -- Undo event handlers
  member .undoApply             is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      tmplRepeats
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplRepeats()

  -- Register form to show in any application, but not on start up
  !!appFormCntrl.registerForm(!this,ARRAY(),ARRAY(),false,false)

  -- Initialise Variables
  !this.cancelCall        = '!this.close()'
  !this.killingCall       = '!this.tidy()'
--  !this.editElement       = object DBREF()
  !this.frameRepeatType.callback = |!this.selectType(|
  !this.frameRepeatType.val = 1
  !this.txtAxis.val         = object DIRECTION('U wrt /*')
  !this.txtAxis.callback    = |!this.setAxis()|
  -- activate Offset repeat section of the form first
  !this.frameOffset.active = true
  !this.frameLinear.active = false
  !this.frameRadial.active = false

  -- Aid Number
  !this.aidRotateAxis   = !!aidNumbers.add('CentreOfRotation')

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!tmplRepeats.position', !this.x, !this.y, !this.z)
  -- Link Position Lock Gadgets to Objects
--  !this.position.linkLock('!!tmplRepeats.position', !this.xFlag, !this.yFlag, !this.zFlag)
  -- Link Position Option Gadgets to Objects
  !this.position.linkOption('!!tmplRepeats.position', !this.ew, !this.ns, !this.ud, 'ENU')
  -- Set Position Action
  !this.position.setAction('!!tmplRepeats.setPosition()')

  -- Set initial measurement
  !this.position.setPosition(object POSITION('E0N0U0 wrt World'))
  !this.position.setWrt(World)

  -- Define EDG positional pick
  !this.edgDescription        = 'Centre of Rotation'
  !this.packet                = object EDGPACKET()
  !this.packet.positionLink('!!tmplRepeats.position', 'Origin of Rotation')
--  !this.packet.close          = '!!tmplRepeats.packetClose()'
--  !this.packet.escape         = '!!tmplRepeats.packetEscape()'
--  !this.packet.key            = 'CofR'
  !this.packet.description    = !this.edgDescription
  -- !this.packet.form           = !!tmplRepeats
  !this.packet.priority       = 1
  !this.packet.remove         = false
  !this.packet.type           = 'dbModify'

  -- Initialise Panels
  !this.initialise()

  -- Initialise create button undo
  !this.undoApply.description('Define Repeat')
  !this.undoApply.undoAction('!!tmplRepeats.undoApplyCallback()')
  !this.undoApply.redoAction('!!tmplRepeats.redoApplyCallback()')
  !this.butApply.setUndoable(!this.undoApply)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use owner
  if(!wrtItem.unset()) then
    !wrtItem = !!ce.owner
    handle any
      !wrtItem = object DBREF('WORLD')
    endhandle
  endif

  -- Set tagging method
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  -- Set repeat rotate axis position
  !this.repeatDefinition.origin = !position
  !this.showAxis()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setAxis
--
-- Description: Show axis feedback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAxis()

  -- Set repeat rotate axis direction
  !this.repeatDefinition.axisDirection = !this.txtAxis.val
  !this.showAxis()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showAxis
--
-- Description: Show axis feedback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAxis()

  -- Set repeat rotate axis position
  !position  = !this.repeatDefinition.origin
  !direction = !this.repeatDefinition.axisDirection
  !vector    = object POINTVECTOR(!position, !direction)
  !this.showAxis(!vector)

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      showAxis
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAxis(!vector is POINTVECTOR)

  !gVector = object GPHPOINTVECTOR(!vector)
  !gVector.length = 1000mm
--  !gVector.draw(!this.aidRotateAxis)
  !!aidNumbers.hide(!this.aidRotateAxis)
  !!aidNumbers.replace(!this.aidRotateAxis, !gVector)
  !!aidNumbers.draw(!this.aidRotateAxis)
  !position = !vector.position
  AID CLEAR TEXT $!this.aidRotateAxis
  handle any
  endhandle
  AID TEXT NUMBER $!this.aidRotateAxis 'Rotation Axis' AT $!position

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateDistance
--
-- Description: Check REAL distance attribute data input
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDistance(!gadget is GADGET, !action is STRING)

  -- return if not a VALIDATE action
  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  if ( !gadget.val lt 0 ) then

    -- look up gadget in table to find corresponding attribute
    !index = !this.attributegadgetName.findFirst(!gadget.name())
    if ( !index.unset() ) then
      !attributeName = 'distance'
    else
      !attributeName = !this.attributeName[!index]
    endif
    !warning = 'Please enter a positive value for ' +  !attributeName
    return error 1 |$!warning|

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateDistance
--
-- Description: Check REAL distance attribute data input
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateAngle(!gadget is GADGET, !action is STRING)

  -- return if not a VALIDATE action
  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  if ( !gadget.val lt 0 or !gadget.val gt 180 ) then

    -- look up gadget in table to find corresponding attribute
    !index = !this.attributegadgetName.findFirst(!gadget.name())
    if ( !index.unset() ) then
      !attributeName = 'torus'
    else
      !attributeName = !this.attributeName[!index]
    endif
    !warning = 'Angle must be in range 0 to 180 degrees for ' +  !attributeName
    return error 1 |$!warning|

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      close
--
