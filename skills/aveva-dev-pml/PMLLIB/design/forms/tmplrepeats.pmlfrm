------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidRotateAxis)
  handle any
  endhandle

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)
  handle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      feedback
--
-- Description: Draw rotation axes
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .feedback()

  !element = !this.editElement
  -- Define Graphic Object
  !volume              = object LOCALVOLUME(!element, !element)
  handle any
    !volume            = object LOCALVOLUME()
  endhandle

  -- If volume then use the origin of the item (expanded)
  if(!volume.unset()) then
    !volume            = object LOCALVOLUME()
    !volume.wrt        = !element
    !volume.from       = !element.position
    !volume.from.east  = !volume.from.east  - 353.5mm
    !volume.from.north = !volume.from.north - 353.5mm
    !volume.from.up    = !volume.from.up    - 353.5mm

    !volume.to         = !element.position
    !volume.to.east    = !volume.to.east    + 353.5mm
    !volume.to.north   = !volume.to.north   + 353.5mm
    !volume.to.up      = !volume.to.up      + 353.5mm
  endif

  !box                 = !volume.box()
  !gphBox              = object GPHBOX(!box)

  -- Display new position
--  !!aidNumbers.replace(!this.aidBox, !gphBox)

  -- Draw axes at the orientation
  !gAxes = object GPHAXES(!this.editElement.position, !this.editElement.orientation)
  !gAxes.height = 1.25 * max( !gphBox.box.xLength, !gphBox.box.yLength, !gphBox.box.zLength, 500mm )
  !gAxes.draw(!this.aidRotateAxis)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form from repeat object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form from repeat object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .initialise(!objRepeat is COMREPEAT)

  -- Initialise Variables
  !this.clear()

  if( badref(!objRepeat.repeatElement) ) then
    !!alert.error('Repeat element is not valid')
    return
  endif

  -- save repeat object on this form
  !this.repeatDefinition = !objRepeat

  -- show name (type + sequ) or LNAME if set
  !repeatElement = !objRepeat.repeatElement
  !localName     = !repeatElement.lname
  handle any
    !localName = object STRING()
  endhandle
  if(!localName.set()) then
    !this.paraRepeatElement.val = 'Local Name: ' + !localName
  else
    !temp = !objRepeat.repeatElement.fullname
    !index = !temp.match(' of TMPLATE')
    if( !index gt 0 ) then
      !temp = !temp.subString(1,!index)
    endif
    !this.paraRepeatElement.val = !temp
  endif

  -- number of copies rule
  !this.txtNumberCopies.val = !objRepeat.numberRule

  -- repeat type
  if(!objRepeat.repeatType.empty()) then
    return
  endif

  if(!objRepeat.repeatType eq 'CARTESIAN') then

    !this.frameRepeatType.val = 1
    -- Set repeat type parameters
    !this.txtOffsetX.val      = !objRepeat.xOffset
    !this.txtOffsetY.val      = !objRepeat.yOffset
    !this.txtOffsetZ.val      = !objRepeat.zOffset
    -- show cartesian panel
    !this.frameOffset.active  = true
    !this.frameLinear.active  = false
    !this.frameRadial.active  = false

  elseif(!objRepeat.repeatType eq 'LINEAR') then

    !this.frameRepeatType.val = 2
    -- Set repeat type parameters
    !this.txtLinearDist.val   = !objRepeat.offsetDistance
    !this.txtLinearDir.val    = !objRepeat.offsetDirection.wrt(WORLD)
    -- show linear panel
    !this.frameOffset.active  = false
    !this.frameLinear.active  = true
    !this.frameRadial.active  = false

  elseif(!objRepeat.repeatType eq 'RADIAL') then

    !this.frameRepeatType.val = 3
    -- Set repeat type parameters
    !this.rtogRotate.val      = !objRepeat.rotateElement
    !this.txtAngle.val        = !objRepeat.angle
    !this.txtRadialOffset.val = !objRepeat.radius
    !this.txtAxis.val         = !objRepeat.axisDirection
      -- set position
    !this.position.setPosition(!objRepeat.origin)
    !this.position.setWrt(!objRepeat.origin.origin)

    -- Set gadget with name of item
    !this.wrt.val = !objRepeat.origin.origin.name

    -- show radial panel
    !this.frameOffset.active = false
    !this.frameLinear.active = false
    !this.frameRadial.active = true
    -- set rotation position edg
    !!edgCntrl.add(!this.packet)

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:updateGadgets
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGadgets()

 var !coordinate coordinate

 if (!coordinate.eq('XYZ')) then
   !this.txtOffsetX.tag = 'U'
   !this.txtOffsetY.tag = 'V'
   !this.txtOffsetZ.tag = 'W'
 else
   -- update the cartesian tags
   !this.txtOffsetX.tag = 'X'
   !this.txtOffsetY.tag = 'Y'
   !this.txtOffsetZ.tag = 'Z'
 endif

 !this.position.linkOption('!!tmplRepeats.position', !this.ew, !this.ns, !this.ud, !coordinate)

endmethod
------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Initialise form from repeat object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .clear()

  !this.updateGadgets()

  -- Initialise Variables
  !this.paraRepeatElement.val = ' '
  -- number of copies rule
  !this.txtNumberCopies.val = ''
  -- repeat type
  !this.frameRepeatType.val = 1
  -- Set repeat type parameters
  !this.txtOffsetX.val      = 0
  !this.txtOffsetY.val      = 0
  !this.txtOffsetZ.val      = 0
  !this.txtLinearDist.val   = 0
  !this.txtLinearDir.val    = object DIRECTION('U WRT /*')
  !this.rtogRotate.val      = false
  !this.txtAngle.val        = 0
  !this.txtRadialOffset.val = 0
  !this.txtAxis.val         = object DIRECTION('U wrt /*')
  -- clear position link for rotation origin
  -- Remove applications events from system
  !this.tidy()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectType
--
-- Description: Set REAL attribute data if in edit mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectType(!gadget is GADGET, !action is STRING)

  -- return if not a MODIFY action
  if ( !action.upcase() ne 'SELECT' ) then
    return
  endif

  -- show panel relevant to type
  if( !gadget.val eq 1 ) then
    -- show cartesian panel
    !this.frameOffset.active = true
    !this.frameLinear.active = false
    !this.frameRadial.active = false
    !this.tidy()
  elseif( !gadget.val eq 2 ) then
    -- show linear panel
    !this.frameOffset.active = false
    !this.frameLinear.active = true
    !this.frameRadial.active = false
    !this.tidy()
  elseif( !gadget.val eq 3 ) then
    -- show radial panel
    !this.frameOffset.active = false
    !this.frameLinear.active = false
    !this.frameRadial.active = true
    !this.tidy()
    !this.setPosition()
    !!edgCntrl.add(!this.packet)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Initialise form from repeat object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  -- Number of copies expression
  !this.repeatDefinition.numberRule = !this.txtNumberCopies.val

  -- Set repeat type parameters
  if(!this.frameRepeatType.val eq 1) then
    !this.repeatDefinition.repeatType = 'CARTESIAN'
    -- Cartesian
    !this.repeatDefinition.xOffset    = !this.txtOffsetX.val
    !this.repeatDefinition.yOffset    = !this.txtOffsetY.val
    !this.repeatDefinition.zOffset    = !this.txtOffsetZ.val
  elseif(!this.frameRepeatType.val eq  2) then
    !this.repeatDefinition.repeatType      = 'LINEAR'
    -- Linear
    !this.repeatDefinition.offsetDistance  = !this.txtLinearDist.val
    !this.repeatDefinition.offsetDirection = !this.txtLinearDir.val
  elseif(!this.frameRepeatType.val eq 3) then
    !this.repeatDefinition.repeatType    = 'RADIAL'
    -- Radial
    !this.repeatDefinition.rotateElement = !this.rtogRotate.val
    !this.repeatDefinition.angle         = !this.txtAngle.val
    !this.repeatDefinition.radius        = !this.txtRadialOffset.val
    !this.repeatDefinition.axisDirection = !this.txtAxis.val
    !this.repeatDefinition.origin        = !this.position.get()
  endif

  -- save changes to the database
  !this.repeatDefinition.save()
  if(!this.testExpression(!this.repeatDefinition.numberRule)) then
    !this.tidy()
    !this.hide()
  endif

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      numberRule
--
-- Description: callback for number-off rule
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .numberRule()

  !rule = !this.txtNumberCopies.val
  if(!this.testExpression(!rule)) then
    -- rule is OK - replace the rule in the object so current
    -- valid expression in this field is recorded
    !this.repeatDefinition.numberRule = !this.txtNumberCopies.val
  else
    -- rule is wrong - reset current rule
    !this.txtNumberCopies.val = !this.repeatDefinition.numberRule
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .testExpression
--
-- Description: Test expression
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .testExpression(!expression is STRING) is BOOLEAN

  -- Get the expression
  if( !expression.trim().empty() ) then
    return true
  endif
  !saveRef = !!ce
  -- had to use VAR here because some PML 1 expressions will not evaluate
  -- attempt to evaluate the expression at the element
--  !block  = object BLOCK(!expression)
--  !result = !element.evaluate(!block)
  -- go to element to evaluate the expression in context - if modifying existing element
  !handleTestError = ( not badref(!this.repeatDefinition.element) )
  if( !handleTestError ) then
    !!ce     = !this.repeatDefinition.element
  endif
  !result  = true
  VAR !unusedTempResult ( $!<expression> )
  handle (47,15)
    !!alert.error('Expression syntax invalid: ' + !!error.command.after('('))
    !result = false
  elsehandle any
    if( !handleTestError ) then
      !!alert.error('Expression invalid: ' + !!error.text)
      !result = false
    endif
  endhandle
  !!ce = !saveRef
  return !result

endmethod
-- End of method definition
