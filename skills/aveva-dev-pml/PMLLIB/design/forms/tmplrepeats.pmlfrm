  !this.hide()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      undoApplyCallback
--
-- Description: Refresh form if attribute is changed
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undoApplyCallback()

  -- Nothing to do if the form is not currently shown
  if(!this.shown().not()) then
    return
  endif
  -- reset for undone element change
  !this.tidy()
  handle any
  endhandle
  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)
  handle any
  endhandle
  -- get rid of form
  !this.close()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      redoApplyCallback
--
-- Description: Refresh form if attribute is changed
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .redoApplyCallback()

  -- reset for redone element change
  !this.undoApplyCallback()

endmethod
-- End of method definition

