------------------------------------------------------------------------
--
-- Method:   loadGrid
--
-- Description: Populate the results grid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadGrid()

  !gridname = 'Templates'

  using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE(!gridname, !this.headings, !this.displayTable)
  !this.dataGrid.bindToDataSource(!nds)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   close
--
-- Description: close the form
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.templateRefs = ARRAY()
  !this.displayTable = ARRAY()
  !this.dataGrid.clearGrid()
  !this.hide()

endmethod
-- End of method definition
