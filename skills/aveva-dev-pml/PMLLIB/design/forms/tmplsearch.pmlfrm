--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buildTable(ARRAY)                -
--  close()                          -                   close the form
--  initialise()                     -
--  loadGrid()                       -                   Populate the results grid
--  navigate()                       -                   Navigate to selected element
--  netAfterSelectChangeCallback(ARRAY) -                   Callback on dataGrid popup
--  netPopupCallback(ARRAY)          -                   Callback on dataGrid popup
--  search()                         -
--  showAll()                        -
--  tmplSearch()                     -
--
import 'GridControl'
handle any
endhandle

--- form definition
setup form !!tmplSearch dialog dock bottom

  using namespace 'Aveva.Pdms.Presentation'
  -- my .Net control
  member .dataGrid is NETGRIDCONTROL

  !this.formTitle = 'Design Template Search'
  !this.iconTitle = 'TempSearch'
  !this.callback  = '!this.initialise()'

  -- Search criteria on left hand side
	path down
	vdis 0
  frame .frSearch 'Search Criteria' anchor T+L+b height 10
    paragraph .paraName         anchor left + top   at ymin.frSearch+0.75       width 26 lines 1
    text      .textName         anchor left + top   at ymax-0.1   width 26 is STRING
    paragraph .paraDesc         anchor left + top                      width 26 lines 1
    text      .textDescription  anchor left + top   at ymax-0.1   width 26 is STRING
    paragraph .paraGtype        anchor left + top                      width 26 lines 1
    text      .textGtype        anchor left + top   at ymax-0.1   width 6 is STRING
    button    .butAll  linklabel 'Show All Templates'   anchor t+l at xmin.paraName ymax+.35 tooltip 'Show All Templates'  callback '!this.showAll()'
    button    .search           'Search'            at xmax.frSearch-10 ymin-.2 anchor left + top  tooltip 'Search for Design Templates'  callback '!this.search()' width 8
  exit

  -- Search results on right hand side
  frame  .pmlFrame2  'Search Results'    anchor all            at xmax.frSearch+0.5 ymin.frSearch height.frSearch
    container .dataFrame nobox PMLNetCONTROL 'NET'  DOCK FILL
  exit

  -- Form members

  -- Table headings
  member .headings         is ARRAY
  -- array of templates, aligned with table content
  member .templateRefs     is ARRAY
  -- array of rows (array) displayed in the grid
  member .displayTable     is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:   tmplSearch
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tmplSearch()

  using namespace 'Aveva.Pdms.Presentation'

  -- create instance of .Net control
  !this.dataGrid = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control
  !this.dataGrid.addeventhandler('OnPopup', !this, 'NETPopupCallback')
  !this.dataGrid.addeventhandler('AfterSelectChange', !this, 'NETAfterSelectChangeCallback')

  -- add .Net control to PML container
  !this.dataFrame.control = !this.dataGrid.handle()

   -- configure grid presentation
  !this.dataGrid.editableGrid(FALSE)
  !this.dataGrid.columnExcelFilter(true)
  !this.dataGrid.outlookGroupStyle(true)
  !this.dataGrid.fixedHeaders(FALSE)
  !this.dataGrid.fixedRows(FALSE)
  !this.dataGrid.errorIcon(TRUE)
  !this.dataGrid.updates(FALSE)

  -- define dataGrid popup menu
  !menu = !this.newMenu('dataGridPopup')
  !menu.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.dataGrid, ||, |Save As|)' )
  !menu.add( 'callback', 'Print Preview...', '!this.dataGrid.printpreview()' )
  !this.dataFrame.popup = !menu

  !this.cancelCall  = '!this.close()'
  -- initialise form labels
  --!this.paraHeading.val = 'Specify search criteria'
  !this.paraName.val    = 'Name (All or Part):'
  !this.paraDesc.val    = 'Description (All or Part):'
  !this.paraGtype.val   = 'Generic Type:'

  -- define table headings
  !this.headings[1] = 'Name'
  !this.headings[2] = 'Description'
  !this.headings[3] = 'Type'
  !this.headings[4] = 'Area'
  !this.headings[5] = 'World'

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   initialise
--
-- Description: Initialise form to show an empty search results table
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  --!this.gridControl()
  !this.displayTable = ARRAY()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   showAll
--
-- Description: Show all Design Templates, ignoring criteria fields
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showAll()

  -- Get Template worlds first to restrict scope of search
  VAR !templateWorlds COLLECT ALL TPWL
  -- Get templates with the world
  VAR !templates COLLECT ALL TMPL FROM !templateWorlds HIER

  -- build the table to be displayed in the grid
  !this.buildTable(!templates)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   search
--
-- Description: Action the search using the provided search criteria
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .search()

  -- collect criteria
  !name        = !this.textName.val.trim()
  !description = !this.textDescription.val.trim()
  !gType       = !this.textGtype.val.trim()

  -- show all templates if no search criteria
  !temp = !name + !description + !gType
  if( !temp.empty() ) then
    !this.showAll()
    return
  endif

  -- Get Template worlds first to restrict scope of search
  VAR !templateWorlds COLLECT ALL TPWL

  -- build search expression for the given criteria
  !expression = ''
  if(!name.empty().not()) then
    -- case sensitive name search
    !expression = |matchwild(name,'*| + !name + |*')|
  endif
  if(!description.empty().not()) then
    -- description search - not case sensitive
    if( !expression.empty().not() ) then
      !expression = !expression + | and |
    endif
    !expression = !expression + |matchwild(upcase(description),'*| + !description.upcase() + |*')|
  endif
  if(!gType.empty().not()) then
    -- GTYP search - not case sensitive
    if( !expression.empty().not() ) then
      !expression = !expression + | and |
    endif
    !expression = !expression + |matchwild(upcase(gtype),'*| + !gType.upcase() + |*')|
  endif

  -- Get templates matching the criteria
  VAR !templates COLLECT ALL TMPL WITH ( $!expression ) FROM !templateWorlds HIER

  -- build the table to be displayed in the grid
  !this.buildTable(!templates)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   buildTable
--
-- Description: Populate table for give list of TMPL elements
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      ARRAY       Array of string TMPL references
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buildTable(!templates is ARRAY)

  !this.displayTable = ARRAY()
  !this.templateRefs = ARRAY()
  -- get data for each item (row) in the table
  do !strTemplate values !templates
    !template = !strTemplate.dbref()
    -- name
    !row[1]   = !template.namn
    -- description
    !row[2]   = !template.description
    -- GTYP
    !row[3]   = !template.gtyp
    -- Template area name
    !row[4]   = !template.owner.namn
    -- Template world name
    !row[5]   = !template.owner.owner.namn
    !this.displayTable.append(!row)
    !this.templateRefs.append(!template)
  enddo

  -- populate the grid with this data
  !this.loadGrid()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:   netPopupCallback
--
-- Description: Callback on dataGrid popup
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupCallback(!a is ARRAY)

  !this.dataFrame.showPopup(!a[0], !a[1])

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:  netAfterSelectChangeCallback
--
-- Description: Callback on dataGrid popup
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChangeCallback(!a is ARRAY)

  !this.navigate()

endmethod
-- End of method definition
-------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Navigate to selected element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

  -- get selected elements from the grid
  !selectedElements = !this.dataGrid.getSelectedRowTags()
  if( !selectedElements.size() neq 1 ) then
    return
  endif
  -- navigate to the element
  !index = !selectedElements[1].real()
  !!ce = !this.templateRefs[!index]
  handle any
  endhandle

endmethod
-- End of method

