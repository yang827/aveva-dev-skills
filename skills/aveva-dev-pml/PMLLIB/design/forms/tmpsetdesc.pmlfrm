-- File:            tmpsetdesc.pmlfrm
--   Type:          Form Definition
--   Group:         Template Application
--     Keyword:     TMPL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Mon 14 June 1999
--
--
-- Description:
-- Form for setting the Description of a vvalue
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  initialise()                     -
--  setDesc()                        -                   Set the Description of the VValue
--  tmpSetDesc()                     -                   Constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!tmpSetDesc

  !this.formTitle     = 'Valid Value Description'
  !this.iconTitle     = 'VValDesc'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  text .desc at xmax ymin  WIDTH 32 string

  !this.desc.val = 'unset'

 -- Attribute Button
  path down
  halign right

 -- Bottom Line
  button .apply   | OK | at xmin form+0 ymax+0.5  OK
  button .dismiss |Cancel| at xmax form-size ymin  CANCEL



exit
-- End of form definition for !!tmpSetDesc
------------------------------------------------------------------------
--
-- Method:      tmpSetDesc
--
-- Description:   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tmpSetDesc()


    !this.apply.callback ='!this.setDesc()'

endmethod
-- End of method definition for .tmpSetDesc()

------------------------------------------------------------------------
--
-- Method:      <initialise>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  !mainForm = !!tmpSetValidVals
  !currentVVal = !mainForm.list.curPos()[1]
  !this.desc.val = !mainForm.descriptions[!currentVVal]
  handle any
    -- in case there is no value (shouldn't happen)
  endhandle
  !this.desc.setFocus()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setDesc
--
-- Description:  Set the Description of the VValue
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDesc()

  !mainForm = !!tmpSetValidVals
  !currentVVal = !mainForm.list.curPos()[1]
  !mainForm.descriptions[!currentVVal] = !this.desc.val

endmethod
-- End of method definition for .setDesc()
