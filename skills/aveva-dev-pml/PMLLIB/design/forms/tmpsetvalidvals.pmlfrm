-- End of method definition for .ok()


------------------------------------------------------------------------
--
-- Method:     evaluateValue
--
-- Description: Evaluate  the VValue whether a string/ref/or real
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [VValue to EVALUATE VVALUE is real string reference]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evaluateValue(!value is DBREF) is STRING

   !testValue = !value.evaluate(object BLOCK(!value.validv))

    handle any
      !newValue = !value.validv.string().part(3)
    elsehandle none
      if(!testValue.set()) then
      !newValue = !testValue.fullName
      handle any
       -----------------------------------------------------
       -- fudge for designing TMPL elements in imperial ------------
       if(!testValue.objectType().eq('REAL')) then
          if(!value.validv.upcase().match('IN').neq(0)) then
            !newValue = !value.validv.part(2) & 'in'
          else
                !newReal = !value.evaluate(object BLOCK(!value.validv))
                !newValue = !newReal.string()
          endif
       elseif(!testValue.objectType().eq('STRING')) then
            !newValue = !value.validv
       -- fix for logical data
       else
            !newValue = !value.validv
       endif
       -----------------------------------------------------
      endhandle
       else
        !newValue = 'Unset'
       endif
    endhandle

  return !newValue

endmethod
-- End of method definition for .evaluateValue(DBREF) STRING


------------------------------------------------------------------------
--
-- Method:     processData
--
-- Description: Process data in the text pane into correct format (if possible)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Array of elements to be valid values for the dataset]
--
------------------------------------------------------------------------

define method .processData() is ARRAY

 -- extract data from text pane. Expect it in lines and space separated values

  !newData = ARRAY()
  !form = !!cdDdse
  !data = !this.list.val

    do !i values !data
      -- "'" I assume a string
      if(!i.match(|'|).neq(0)) then
        !newData.append(!i)
      else
      !newData.appendArray(!i.split())
      endif
    enddo
    !allData[1] = !newData
    !allData[2] = !this.descriptions

  return !allData

endmethod
-- End of method definition for .processData() ARRAY
------------------------------------------------------------------------
--
-- Method:     actionOnPick
--
-- Description: Pick element and test if it has a spco and use it in the text pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .actionOnPick(!data is ANY)

  !this.addElement(!data.item)
  !!edgCntrl.remove('Pick Component with Spref')

endmethod
-- End of method definition for .actionOnPick(ANY)
------------------------------------------------------------------------
--
-- Method:     climbToSpref
--
-- Description: Climb to Spref element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Dbref to get spref from]
-- Return:
--   [Data Type] [Description]
--   [DBREF]     [Return the first owner with a spref]
--
------------------------------------------------------------------------

define method .climbToSpref(!dbRef is DBREF) is DBREF

  -- initialise variables

  !owners = !dbRef.ownLst
  !owners.invert()
  !owners.insert(1,!dbRef)
  !testForSpref = object DBREF()
  !returnRef    = object DBREF()

  -- find the first spref

  do !i values !owners
     !testForSpref = !i.spref
     handle any
       -- No spref so continue
       skip
     endhandle
     if(!testForSpref.unset().not()) then
       if( !testForSpref.hardType eq 'TABITE' ) then
         if( !testForSpref.prtref.badref() ) then
           skip
         else
           !testForSpref = !testForSpref.prtref
         endif
       endif
       !returnRef = !testForSpref
       break
     endif
  enddo

  return !returnRef

endmethod
-- End of method definition for .climbToSpref(DBREF) DBREF
------------------------------------------------------------------------
--
-- Method:      addCe
--
-- Description: Add CE to the list, whether a design element or a spco
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addCe()

  -- add ce to the list
  !this.addElement(!!ce)

endmethod
-- End of method definition for .addCe()
------------------------------------------------------------------------
--
-- Method:      addElement
--
-- Description: Add element to the list, whether a design element or a spco
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addElement(!element is DBREF)

  !isSPRE   = !this.dataset.purpose.eq('SPRE')
  handle any
    !form   = !!cdDdse
    !isSPRE = !form.purp.selection().eq('SPRE')
  endhandle
  !isSBRE   = !this.dataset.purpose.eq('SBRE')
  handle any
    !form   = !!cdDdse
    !isSBRE = !form.purp.selection().eq('SBRE')
  endhandle

  !elementToAdd = !element

  if(!isSPRE or !isSBRE) then
    if(!element.hardType eq 'TABITE') then
      -- go to GPART
      if( !element.prtref.badref().not() ) then
        !elementToAdd = !element.prtref
      endif
    endif
    if(!elementToAdd.hardType inset('SPCO','GPART') ) then
      if( !elementToAdd.isNamed.not() ) then
        !!alert.error('Can only add named elements as valid values')
        return
      endif
    elseif(!this.climbToSpref(!elementToAdd).set()) then
      !elementToAdd = !this.climbToSpref(!elementToAdd)
      if( !elementToAdd.isNamed.not() ) then
        !!alert.error('Can only add named elements as valid values')
        return
      endif
    else
      !!alert.error('Cannot find a SPCO, GPART or TABITEM from the Current Element.')
      return
    endif
    if( !elementToAdd.tmpref.set() and !isSPRE) then
      !!alert.error('Cannot add elements that reference Design Templates')
      return
    endif
  else
    -- for adding elements for repeats
    if( !element.isNamed.not() ) then
      !!alert.error('Can only add named elements as valid values')
      return
    endif
  endif
  -- update list with new name
  !list = !this.list.val
  !list.append(!elementToAdd.fullName)
  !list.unique()
  !this.list.clear()
  !this.list.val = !list

endmethod
-- End of method definition for .addElement()

------------------------------------------------------------------------
--
-- Method:     pickElement
--
-- Description: Pick Element to copy spref into list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickElement()

  !packet = object EDGPACKET()

  !packet.elementPick('Identify Element to use')
  !packet.description = 'Pick Component with Spref'
  !packet.action      = '!!tmpSetValidVals.actionOnPick(!this.return[1])'
  !packet.type        = 'Picking'
  !packet.key         = 'PickSpref'

  !packet.pickPacket.picks[1].pick.modifiable = false


  !!edgCntrl.add(!packet)



endmethod
-- End of method definition for .pickElement()
------------------------------------------------------------------------
--
-- Method:     cancel
--
-- Description: Cancel form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  !form = !!cdDdse
  -- grey in maxmin gadgets

  !form.max.active = TRUE
  !form.min.active = TRUE

-- activate the form
  !form.setActive(true)

endmethod
-- End of method definition for .cancel()
