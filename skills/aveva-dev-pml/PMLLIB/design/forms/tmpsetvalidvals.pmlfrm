--
--
-- Description:
-- form to set the valid values of the data set
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actionOnPick(ANY)                -                   Pick element and test if it has a spco and use it in the text pane
--  addCe()                          -                   Add CE to the list, whether a design element or a spco
--  addDescription()                 -                   Set Description of VValue
--  addElement(DBREF)                -                   Add element to the list, whether a design element or a spco
--  cancel()                         -                   Cancel form
--  climbToSpref(DBREF)              DBREF               Climb to Spref element
--  evaluateValue(DBREF)             STRING              Evaluate  the VValue whether a string/ref/or real
--  initialise(BOOLEAN)              -                   Initialise form
--  ok()                             -                   OK the data to the ddat
--  pickElement()                    -                   Pick Element to copy spref into list
--  processData()                    ARRAY               Process data in the text pane into correct format (if possible)
--  tmpSetValidVals()                -                   Constructor
--
------------------------------------------------------------------------

setup form !!tmpSetValidVals

  !this.formTitle     = 'Set Valid Values'
  !this.iconTitle     = 'SetVals'
  !this.callback      = '!this.initialise(TRUE)'
  !this.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

     textpane .list 'List of Valid Values'  at xmin ymax  width 42 length 12

     -- Add ce when its a reference list

     path down

     button .add  'Add CE'       tooltip 'Add Current Element To List' at ymax+0.25 width 8
     button .pick 'Pick Element' tooltip 'Pick Element To Add to List' at xmax form-size ymin width 10
     button .rule 'Rule Definition...' tooltip 'Define Rules associated with Sub Reference' at xmin_add ymax+0.25 width 16

  --  Bottom Line

    button .apply   'OK'  width 8  OK
    path right
    button .cancel 'Cancel'  at xmax form-size width 8  cancel


  -- Members for storing the data of the attribute rules
     member .attributeRules  is ARRAY
     member .dataset         is DBREF
     member .descriptions    is ARRAY

exit
-- End of form definition for !!tmpSetValidVals

------------------------------------------------------------------------
--
-- Method:      tmpSetValidVals
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmpSetValidVals()

      -- callbacks
     !this.add.callback      =  '!this.addCe()'
     !this.pick.callback     =  '!this.pickElement()'
     !this.rule.callback     =  'show !!tmpSubRefRules'
     !this.apply.callback    =  '!this.ok()'
     !this.cancel.callback   =  '!this.cancel()'


  -- Modify Menu
    !menu = !this.newMenu('Description')
    !menu.add('callback', 'Add Description...',  '!this.addDescription()')

    !this.list.popup = !menu

endmethod
-- End of method definition for .tmpSetValidVals()


------------------------------------------------------------------------
--
-- Method:      addDescription
--
-- Description: Set Description of VValue
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addDescription()

  show !!tmpSetDesc

endmethod
-- End of method definition for .addDescription()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!showForm is BOOLEAN)

  -- if application change
    !this.setActive(TRUE)

  !form     = !!cdDdse
  !this.attributeRules.clear()

  -- grey out dataset form while this form is displayed
  if(!showForm) then
    !form.setActive(false)
  endif
  -- initialise variables


  !dDatType = !form.purp.selection()
  !dataset  =  !form.data.selection()

  !this.dataset = !dataset.dbRef()

    -- get all vvalues
  if(!dataset.neq('')) then

     var !vVals COLLECT ALL VVALUE FOR $!dataset

     var !desc EVALUATE DESC FOR ALL FROM !vVals

     !value = ARRAY()

     -- EVALUATE expression
     !evaluation = ARRAY()
     do !i indices !vVals
       !evaluation[!i] = !this.evaluateValue(!vVals[!i].dbRef())
       if(!evaluation[!i].eq('Unset')) then
         !evaluation[!i] = 'NULREF'
       endif
     enddo


     -- display current values to the text pane
     !this.list.val = !evaluation
     !this.descriptions = !desc

  endif

-- test for ddat type

  if(!dDatType inset('DESP','ATTR','EXPR')) then
     !this.add.active  = FALSE
     !this.rule.active = FALSE
     !this.attributeRules.clear()
     !this.pick.active = FALSE
   elseif(!dDatType inset('SPRE')) then
     !this.add.active  = TRUE
     !this.rule.active = FALSE
     !this.attributeRules.clear()
     !this.pick.active = TRUE
    else
     !this.add.active  = TRUE
     !this.rule.active = TRUE
     !this.pick.active = TRUE
   endif

  -- set attribute rules if they is any

    if(!this.dataset.set() and !this.rule.active.eq(TRUE)) then
      var !currentRules COLLECT ALL ATTRRL FOR $!this.dataset
      var !description  EVALUATE DESC FOR ALL FROM !currentRules
      var !purpose      EVALUATE PURP FOR ALL FROM !currentRules
      var !attName      EVALUATE ATTNAM FOR ALL FROM !currentRules
      var !attRule      EVALUATE ATTRUL FOR ALL FROM !currentRules

      do !i indices !currentRules
         !newRule[1] = !description[!i]
         !newRule[2] = !purpose[!i]
         !newRule[3] = !attName[!i]
         !newRule[4] = !attRule[!i]
         !this.attributeRules.append(!newRule)
        -- !dText.append(!description[!i])
        -- !rText.append(!attName[!i])
      enddo


    else
    -- clear holding array
     !this.attributeRules.clear()
    endif

--------------------------------------------------------------------------
-- End of setting DDSE form values
--------------------------------------------------------------------------

-- Set focus to the text pane

   !this.list.setFocus()

-- grey out maxmin gadgets

  if(!showForm) then
    !form.max.active = FALSE
    !form.min.active = FALSE
  endif

endmethod
-- End of method definition for .initialise(BOOLEAN)

