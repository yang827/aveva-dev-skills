-- Created:         Wed Mar 17 14:39:38 "GMT 1999
--
--
-- Description:
-- form to get the rule definitions for sub (Equi) components
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToList(STRING)                -                   Add the current information to the list.
--  cancel()                         -                   Cancel Form
--  checkData()                      -                   Check the gadget are complete
--  editRule()                       -                   Display current selection for editing
--  exprBuilder()                    -                   Run the expression builder form
--  initialise()                     -                   Initialise Form
--  ok()                             -                   OK Form
--  setAttNames()                    -                   Set option gadget for attribute names based on the
--  setFocusToRule()                 -                   Set focus for typing in the rule
--  tmpSubRefRules()                 -                   Constructor
--
------------------------------------------------------------------------

setup form !!tmpSubRefRules

  -- Body of form definition

  text .description 'Description'   tooltip 'Rule Description' tagwidth 12 width 39 scroll 100 STRING
  path down
  halign left
  option .purpose  'Purpose'  tooltip 'Select Element Type for the Rule Definition' tagwidth 12 width 37
  option .attName  'Attribute'  tooltip 'Attribute Name Rule is to be Applied to'   tagwidth 12 width 37
  text   .attRule  'Associated Rule'  tooltip 'Rule Definition For Attribute'       tagwidth 12 width 37 scroll 100 string

  !validSel = !!pml.getPathName('dialog16.png')
  button .extnExprBuilder  at xmax_attRule ymin_attRule tooltip 'Attribute Rule Expression Builder' pixmap sel "$!<validSel>" inact "$!<validSel>" width 16  height 16
  halign right
  button .removeRule  'Remove'  tooltip 'Remove Selected Rule from List'
  path left
  button .replaceRule 'Replace' tooltip 'Replace Details of Selected Rule'
  button .includeRule 'Include' tooltip 'Include Details of Rule Above into List'

  halign left

  list .list 'Rules Defined'  at xmin_description ymax  width 50 length 4
  -- allowed at 11.3?? maybe 11.5 then
  --list .list 'Rules Defined'  call '!this.editRule()' tooltip 'Select from this list to edit Details.' at xmin_attRule ymin+0.5 width 48 length 4
  path down

 --  Bottom Line

    button .done   'OK'    width 8 ok
    path right
    button .cancel 'Cancel'  at xmax form-size   width 8 cancel


    --  member for storing data for each attribute

     member .attributeRules  is ARRAY
     member .dataset         is DBREF
    -- member .template        is DBREF
    -- member .dimensions      is COMPROP
    --  member .despars         is ARRAY
    -- member .expressions     is ARRAY
    -- member .localNames      is ARRAY
    -- member .tmpCheck        is DBREF
     member .mainForm        is FORM

exit
-- End of form definition for !!tmpSubRefRules

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmpSubRefRules()

  !this.formTitle     = 'Associated Rule Definition'
  !this.iconTitle     = 'AssRule'
  !this.callback      = '!this.initialise()'

  -- Main Form
  !this.mainForm = !!cdDdse

  -- options for Purpose

       !dText[1] = 'Sub-Equipment Reference'
   --  !dText[2] = 'ASL Sub-Fixing Reference'
   --  !dText[3] = 'Steel Section'
   --  !dText[4] = 'Design Primitive'
   --  !dText[5] = 'General Section'
   --  !dText[6] = 'Gensec Curve'
   --  !dText[7] = 'Fixing or Fitting'

       !rText[1] = 'SUBE'
    -- !rText[2] = 'ASL'
    -- !rText[3] = 'SCTN'
    -- !rText[4] = 'PRIM'
    -- !rText[5] = 'GENSEC'
    -- !rText[6] = 'CURVE'
    -- !rText[7] = 'FIXING'

     !this.purpose.dText = !dText
     !this.purpose.rText = !rText

     -- options for Attribute Name

     !dText.clear()
     !rText.clear()

     !dText[1] = 'Sub-Equipment Position'
     !dText[2] = 'Sub-Equipment Orientation'

     !rText[1] = 'POSITION'
     !rText[2] = 'ORIENTATION'


     !this.attName.dText = !dText
     !this.attName.rText = !rText

     -- grey out list buttons until there is data to add in.

     !this.includeRule.active = FALSE
     !this.removeRule.active  = FALSE
     !this.replaceRule.active = FALSE

     -- callbacks
     !this.description.callback =  '!this.checkData()'
     !this.purpose.callback     =  '!this.setAttNames()'
     !this.attName.callback     =  '!this.setFocusToRule()'
     !this.attRule.callback     =  '!this.checkData()'
     !this.removeRule.callback  =  '!this.addToList(|REMOVE|)'
     !this.replaceRule.callback =  '!this.addToList(|REPLACE|)'
     !this.includeRule.callback =  '!this.addToList(|INCLUDE|)'
     !this.list.callback        =  '!this.editRule()'
     !this.done.callback        =  '!this.ok()'
     !this.cancel.callback      =  '!this.cancel()'
     !this.extnExprBuilder.callback   = '!this.exprBuilder()'
endmethod
------------------------------------------------------------------------
--
-- Method:      exprBuilder()
--
-- Description: method to invoke the expression builder form and to switch
--              the remove/include buttons on
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exprBuilder()

   !!comExprBuilder('|Attribute Rule Definition|', !this.mainForm.despars,!this.mainForm.expressions, !this.mainForm.localNames, !this.attRule)

   !this.includeRule.active = TRUE
   !this.removeRule.active  = TRUE
   !this.replaceRule.active = TRUE

endmethod
-- End of method definition for .exprBuilder()
------------------------------------------------------------------------
--
-- Method:      setAttNames()
--
-- Description: Set option gadget for attribute names based on the
--              element type to have the rule
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttNames()

   -- options for Attribute Name

     !dText = ARRAY()
     !rText = ARRAY()

   if(!this.purpose.selection().eq('SUBE')) then
      !dText[1] = 'Sub-Equipment Position'
      !dText[2] = 'Sub-Equipment Orientation'

      !rText[1] = 'POSITION'
      !rText[2] = 'ORIENTATION'
-- this is not needed until ASL and steelwork subref are used
   elseif(!this.purpose.selection().eq('ASL')) then
      -- better descriptions required
         !dText[1] = 'Distance Along ASL'
         !dText[2] = 'Offset From Axis'
         !dText[3] = 'Fixing Orientation'

         !rText[1] = 'ZDIST'
         !rText[2] = 'DELP'
         !rText[3] = 'ORIENTATION'
   elseif(!this.purpose.selection().eq('SCTN')) then
      !dText[1] = 'Section Start Position'
      !dText[2] = 'Section End Position'
      !dText[3] = 'Section Rotation'

      !rText[1] = 'POSS'
      !rText[2] = 'POSE'
      !rText[3] = 'BANG'
   elseif(!this.purpose.selection().eq('PRIM')) then
      !dText[1] = 'Element Position'
      !dText[2] = 'Element Orientation'

      !rText[1] = 'POSITION'
      !rText[2] = 'ORIENTATION'
   elseif(!this.purpose.selection().eq('GENSEC')) then
      !dText[1] = 'General Section Position'
      !dText[2] = 'General Section Orientation'

      !rText[1] = 'POSITION'
      !rText[2] = 'ORIENTATION'
   elseif(!this.purpose.selection().eq('CURVE')) then
      !dText[1] = 'Curve Position'
      !dText[2] = 'Conditioning Position'

      !rText[1] = 'POSITION'
      !rText[2] = 'CPOS'
   elseif(!this.purpose.selection().eq('FIXING')) then
      !dText[1] = 'Distance Along Section'
      !dText[2] = 'Offset From Axis'
      !dText[3] = 'Fixing Orientation'

      !rText[1] = 'POSITION'
      !rText[2] = 'DELP'
      !rText[3] = 'ORIENTATION'
   endif

     !this.attName.dText = !dText
     !this.attName.rText = !rText

     !this.attRule.setFocus()

endmethod
-- End of method definition for .setAttNames()
------------------------------------------------------------------------
--
-- Method:      initialise()
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- grey out parent form

    !!tmpSetValidVals.setActive(FALSE)

    if(!this.description.val.eq('') or !this.attRule.val.eq('')) then
         !this.includeRule.active = FALSE
         !this.removeRule.active  = FALSE
         !this.replaceRule.active = FALSE
    else
         !this.includeRule.active = TRUE
         !this.removeRule.active  = TRUE
         !this.replaceRule.active = TRUE
    endif

  -- initialise variables

    !newRule = ARRAY()
    !dText   = ARRAY()
    !rText   = ARRAY()

    !this.attributeRules.clear()

    !this.description.setFocus()

    !this.dataset = !!tmpSetValidVals.dataset

  -- get data from element

    if(!this.dataset.set()) then
      !this.attributeRules = !!tmpSetValidVals.attributeRules
      do !i indices !this.attributeRules
        !dText.append(!this.attributeRules[!i][1])
        !rText.append(!this.attributeRules[!i][3])
      enddo
      !this.list.dText = !dText
      !this.list.rText = !rText
    else
     !this.list.clear()
    endif

        if(!this.list.set()) then
           !this.editRule()
           handle any
             -- if no rules exist
           endhandle
        endif

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      addToList(STRING)
--
-- Description: Add the current information to the list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToList(!buttonPicked is STRING)

  -- Get Data entered

    !description   = !this.description.val
    !purpose       = !this.purpose.selection()
    !attribute     = !this.attName.selection()
    !rule          = !this.attRule.val

  -- store in an array
    !newRule = ARRAY()
    !newRule[1] = !description
    !newRule[2] = !purpose
    !newRule[3] = !attribute
    !newRule[4] = !rule

    !listSelection = !this.list.val

  -- get current list values

    !listD      = !this.list.dText
    !listR      = !this.list.rText


     if(!buttonPicked.eq('INCLUDE')) then

        -- check the data is complete  -------------------------------------

       if(!description.eq('') or !rule.eq('') ) then
         !!alert.error('Not all Information has been entered, for the rule definition.')
         return
       endif
       ---------------------------------------------------------------------

       !listD.append(!description)
       !listR.append(!attribute)

       !this.attributeRules.append(!newRule)

       -- set the new list up

       !this.list.dText = !listD
       !this.list.rText = !listR
       !this.list.val   = !listD.size()

     elseif(!buttonPicked.eq('REPLACE') and !listSelection.neq(0) ) then

       -- check the data is complete   -------------------------------------
       if(!description.eq('') or !rule.eq('') ) then
         !!alert.error('Not all Information has been entered, for the rule definition.')
         return
       endif
       ---------------------------------------------------------------------
       !listD[!listSelection] = !description
       !listR[!listSelection] = !attribute
       !this.attributeRules[!listSelection] = !newRule

       -- set the new list up

       !this.list.dText = !listD
       !this.list.rText = !listR
       !this.list.val   = !listSelection

     elseif(!buttonPicked.eq('REMOVE')) then
       !listD.remove(!listSelection)
         handle any
         -- removing from an empty list (someone will do it)
         --  return
         endhandle
       !listR.remove(!listSelection)
       !this.attributeRules.remove(!listSelection)
        handle any
         -- in case arrays get out of step
        -- return
        endhandle
       -- clear data gadgets
--       !this.description.val = ''
--       !this.attRule.val     = ''
         !this.list.dText = !listD
         !this.list.rText = !listR
         !this.editRule()
         handle ANY
          -- in case nothing in the list
         endhandle
     endif

endmethod
-- End of method definition for .addToList(STRING)
------------------------------------------------------------------------
--
-- Method:      checkData()
--
-- Description: Check the gadget are complete
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkData()


  if(!this.attRule.val.trim().neq('') and !this.description.val.trim().neq('')) then

       -- reinstate list buttons

     !this.includeRule.active = TRUE
     !this.removeRule.active  = TRUE
     !this.replaceRule.active = TRUE
  else
     !this.includeRule.active = FALSE
     !this.removeRule.active  = FALSE
     !this.replaceRule.active = FALSE
  endif

endmethod
-- End of method definition for .checkData()
------------------------------------------------------------------------
--
-- Method:      setFocusToRule()
--
-- Description: Set focus for typing in the rule
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFocusToRule()

  !this.attRule.setFocus()

endmethod
-- End of method definition for .setFocusToRule()
------------------------------------------------------------------------
--
-- Method:      editRule()
--
-- Description: Display current selection for editing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .editRule()

  !selection = !this.list.val
  !data      = !this.attributeRules[!selection]

  !this.description.val = !data[1]
  handle any
    -- in case the attribute is not as expected
  endhandle
  !this.purpose.select('RTEXT',!data[2])
  handle any
    -- in case the attribute is not as expected
  endhandle
  !this.attName.select('RTEXT',!data[3])
   handle any
    -- in case the attribute is not as expected
  endhandle
  !this.attRule.val = !data[4]
  handle any
    -- in case the attribute is not as expected
  endhandle

  !this.checkData()

endmethod
-- End of method definition for .editRule()
------------------------------------------------------------------------
--
-- Method:      ok()
--
-- Description: OK Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()

  !!tmpSetValidVals.setActive(TRUE)

  !!tmpSetValidVals.attributeRules = !this.attributeRules

endmethod
-- End of method definition for .ok()
------------------------------------------------------------------------
--
-- Method:      cancel()
--
-- Description: Cancel Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  !!tmpSetValidVals.setActive(TRUE)

endmethod
-- End of method definition for .cancel()
