--
-- File:            view3dcntrl.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        DESIGN
--   Application:   VIEW
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Jan 28 14:05:31 GMT 1997
--
--
-- Description:
-- Controlling form for all 3D graphic views.
-- Nearly all the menu options that can be found on a normal 3D Volume
-- View form are located on this form too. This allows other views in
-- other applications to come under control of this main form.
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!view3DCntrl

  !!view3DCntrl.formTitle     = |3D View Controls|
  !!view3DCntrl.iconTitle     = |3D Views|
  !!view3DCntrl.callback      = |call !!view3DCntrlInit()|
  !!view3DCntrl.formRevision  = | $Revision: 1.12 $ |

  -- Body of form definition

  -- Bar menu
  bar
    add |Control| .cntrl
    add |Views|  .forms
    add |Look|     .look
    add |ISO|      .iso
    add |Limits|   .limits
    add |Rotation| .rotation
--    if(not !control) then
--      add |Clipping| .clipping
--    endif
  exit

  -- Control Menu
  menu .cntrl
    add |Borders On/Off|       |call !!view3DSetAll(_views, 'Borders')|
    add |Shading On/Off|       |call !!view3DSetAll(_views, 'Shaded')|
    add |Background Colour...| |call !!colourSelectLoad('call !!view3DColSetAll(!!view3DCntrl.views)','Background Colour', 15)|
    add |ID Colour...|         |  |
    add |Perspective On/Off|   |call !!view3DSetAll(_views, 'Perspective')|
    add |Walkthrough On/Off|   |call !!view3DSetAll(_views, 'Walkthrough')|
--    add |Step Size...|         ||
--    add |Data...|              ||
--    add separator
--    add |Close|                ||
  exit

  -- View Forms Menu
  menu .forms
    add |Add|        |call !!view3DForms('ADD', '')|
    add |Remove|     |call !!view3DForms('REMOVE', '')|
    add separator
    add |Remove all| |call !!view3DForms('REMALL', '')|
  exit

  -- Look direction
  menu .look
    add |Down|        |call !!view3DAllDir(_views, 'Down')|
    add |North|       |call !!view3DAllDir(_views, 'North')|
    add |South|       |call !!view3DAllDir(_views, 'South')|
    add |East|        |call !!view3DAllDir(_views, 'East')|
    add |West|        |call !!view3DAllDir(_views, 'West')|
    add |Up|          |call !!view3DAllDir(_views, 'Up')|
--    add |Explicit...| ||
--    add |Clipbox|     menu _lClip
  exit

  -- Isometric Direction Menu
  menu .iso
    add |One|         |call !!view3DAllDir(_views, 'W 45 S 53.264 D')|
    add |Two|         |call !!view3DAllDir(_views, 'W 45 N 53.264 D')|
    add |Three|       |call !!view3DAllDir(_views, 'E 45 N 53.264 D')|
    add |Four|        |call !!view3DAllDir(_views, 'E 45 S 53.264 D')|
  exit

  -- Limits Menu
  menu .limits
    add |CE|            |call !!view3DAllLimits(_views, 'CE')|
    add |Owner|         |call !!view3DAllLimits(_views, 'OWNER')|
--    add |Pick|          | |
    add |Drawlist|      |call !!view3DAllLimits(_views, 'DRAW')|
    add |Obstruct list| |call !!view3DAllLimits(_views, 'OBST')|
--    add |Explicit...|   | |
    add |Clipbox|       |call !!view3DAllLimits(_views, 'CLIP')|
    add sep
--    add |Window|        | |
--    add |Limit Box|     menu .zoom
    add sep
    add |Global|        |call !!view3DAllLimits(_views, 'GLOBAL')|
  exit

  menu .rotation
    add |CE Origin|   |call !!view3DRotateAll(_views, 'ORIGIN')|
    add |CE Centroid| |call !!view3DRotateAll(_views, 'CE')|
    add |Owner|       |call !!view3DRotateAll(_views, 'OWNER')|
--  add |Pick|        |call !!view3DRotateAll(_views, 'ID')|
--  add |Cursor|      |call !!view3DRotateAll(_views, 'PICK')|
    add |Limits Box|  |call !!view3DRotateAll(_views, 'LIMITS')|
--  add |Clipbox|     |call !!view3DRotateAll(_views, 'CLIP')|
  exit

  ----------------------------------------------------------------------
  -- List of current forms to apply action to
  ----------------------------------------------------------------------

  list .list call |call !!view3DCntrl()| multi width 50 length 6

  ----------------------------------------------------------------------
  -- Form Members
  --
  -- .allViews      ARRAY   All views currently built
  -- .views         ARRAY   All currently active views
  -- .designViews   ARRAY   All Design Views
  -- .active        ARRAY   Current Active Selection (this maybe
  --                        deprecated later - not used?)
  -- .actionStack   ARRAY   Action stack - holds;
  --                          [1] Name of Application
  --                          [2] User Call-back function
  ----------------------------------------------------------------------

  member .allViews      is ARRAY
  member .views         is ARRAY
  member .designViews   is ARRAY
  member .active        is ARRAY
  member .actionStack   is ARRAY

  ----------------------------------------------------------------------
  -- These members should be READ ONLY. They are used to set the default
  -- prompts on Design Views (View.inMode.prompt).
  ----------------------------------------------------------------------

  member .naviPrompt    is STRING
  member .pickPrompt    is STRING
  member .pAnyPrompt    is STRING
  member .ppLinePrompt  is STRING
  member .pointPrompt   is STRING
  member .screenPrompt  is STRING
  member .defaultPrompt is STRING

  member .snapPrompt     is STRING
  member .midPrompt      is STRING
  member .pickedPrompt   is STRING
  member .intersecPrompt is STRING
  member .propPrompt     is STRING
  member .fracPrompt     is STRING

  _naviPrompt    = 'Navigate : '
  _pickPrompt    = 'Pick item : '
  _pAnyPrompt    = 'Pick Any : '
  _ppLinePrompt  = 'Pick Pline : '
  _pointPrompt   = 'Pick Point : '
  _screenPrompt  = 'Pick Screen : '
  _defaultPrompt = ''

  _snapPrompt     = 'Snap to'
  _midPrompt      = 'Midpoint'
  _pickedPrompt   = 'Picked Pos'
  _intersecPrompt = 'Intersection'
  _propPrompt     = 'Proportional'
  _fracPrompt     = 'Fractional'

exit
-- End of form definition for !!view3DCntrl

