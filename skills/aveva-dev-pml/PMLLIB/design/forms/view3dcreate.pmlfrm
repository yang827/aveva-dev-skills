-- Description:
-- Graphical View creation form.
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------


setup form !!view3DCreate at xr 0 yr 0

  !!view3DCreate.formTitle    =  'Graphical View'
  !!view3DCreate.iconTitle    =  'Graphic View'
--  !!view3DCreate.callback     =  'call !!view3DCreateInit'
  !!view3DCreate.formRevision =  ' $$Revision: 1.7 $ '

  -- Title
  text   .title |Title | at xmin ymax width 24 scroll 24 string
  !!view3DCreate.title.val = |3D Volume View|

  -- View type
  path down
  halign right
  option _vtyp  |View type | width 16
  var list _vtyp pairs |Design|          |DESI|
                       |Navigation only| |NAVI|
  exit

  -- Bar menu required
  toggle _bflg  |Bar Menu| states |false| |true|

  -- Bottom Line
  button _apply   |Apply|   at xmin form-0 ymax form+0.25 call |call !!view3DForms('ADD', !!view3DCreate.title.val)| apply
  button _dismiss |Dismiss| at xmax form-size ymin ok

exit
-- End of form definition for !!view3DCreate

!!view3DCreate.bflg.val = TRUE
