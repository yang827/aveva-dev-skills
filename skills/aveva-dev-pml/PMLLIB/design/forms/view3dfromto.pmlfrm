--
-- File:            view3dfromto.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:      _CD3DVOL
--
-- Author:          P.Mooney
-- Created:         Fri Jun 13 10:02:12 BST 1997
--
--
-- Description:
-- Defines the From - To limits of a clip box i.e. 2 corners.
-- It will update the clipping data form if a gadget is changed.
-- Member applyFunc is a STRING holding the name of the function to the
-- callback on the text gadgets/Apply button.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  view3DFromTo()                   -                   Constructor
--

setup form !!view3DFromTo

  !!view3DFromTo.formTitle     = 'Graphic Form '
  !!view3DFromTo.iconTitle     = 'Graphic '
  !!view3DFromTo.callback      = ''
  !!view3DFromTo.formRevision  = ' $Revision: 1.7 $ '

  --------------------------
  -- Body of form definition
  --------------------------

  bar
    add |General|             _GEN
    add |Cursor|              _CURSOR
    add |Intersections|       _INTS
  exit

    -- General
    menu _GEN
      add |CE|                |CALLIBD I3DVOL CE|
      add |Clear CE|          |CALLIBD I3DVOL CE $$<$$> CLEAR|
      add |Owner|             |CALLIBD I3DVOL CE $$<$$> OWNER|
    exit

    -- Cursor
    menu _CURSOR
      add |Elements|          |CALLIBD I3DVOL ID ID|
      add |Design Points|     |CALLIBD I3DVOL ID IDP|
      add |Plines|            |CALLIBD I3DVOL ID IDPL|
      add |3D Picks|          |CALLIBD I3DVOL ID 3D|
      add |2D Picks|          |CALLIBD I3DVOL ID 2D|
    exit

      menu _INTS
        add |Element|         menu _IELEM
        add |Design Point|    menu _IPPNT
        add |Plines|          menu _IPLIN
      exit

        menu _IELEM
          add |to Element|      |CALLIBD I3DVOL INTS ID ID|
          add |to Design Point| |CALLIBD I3DVOL INTS ID IDP|
          add |to Pline|        |CALLIBD I3DVOL INTS ID IDPL|
        exit

        menu _IPPNT
          add |to Design Point| |CALLIBD I3DVOL INTS IDP IDP|
          add |to Element|      |CALLIBD I3DVOL INTS IDP ID|
          add |to Pline|        |CALLIBD I3DVOL INTS IDP IDPL|
        exit

       menu _IPLIN
          add |to Pline|        |CALLIBD I3DVOL INTS IDPL IDPL|
          add |to Design Point| |CALLIBD I3DVOL INTS IDPL IDP|
          add |to Element|      |CALLIBD I3DVOL INTS IDPL ID|
        exit

  para .viewTitle at xmin ymax width 30

  -------------------------------
  -- Define XYZ for corner 1 data
  -------------------------------

  para .txt1 at xmin ymax text |From:|
  option .x1o at xmin+1 ymax callback  |call !!view3DFromToCB('Update')| width 5
  text .x1  at xmax+1 ymin callback  |call !!view3DFromToCB('Update')| width 14 isou
  var  _x1 (0)
  toggle .x1t  states |false| |true|
  var    _x1T |false|


  option .y1o at xmin_x1O ymax+0.2 callback |call !!view3DFromToCB('Update')| width 5
  text .y1  at xmax+1 ymin callback |call !!view3DFromToCB('Update')| width 14 isou
  var  _y1 (0)
  toggle .y1t states |false| |true|
  var    _y1T |false|


  option .z1o at xmin_x1O ymax+0.2 callback |call !!view3DFromToCB('Update')| width 5
  text .z1  at xmax+1 ymin callback |call !!view3DFromToCB('Update')| width 14 isou
  var  _z1 (0)
  toggle .z1t states |false| |true|
  var    _z1T |false|

  -------------------------------
  -- Define XYZ for corner 2 data
  -------------------------------

  para .txt2 at xmin_txt1 ymax+0.2 text |to:|
  option .x2o at xmin+1 ymax callback |call !!view3DFromToCB('Update')| width 5
  text .x2  at xmax+1 ymin callback |call !!view3DFromToCB('Update')| width 14 isou
  var  _x2 (0)
  toggle .x2t  states |false| |true|
  var    _x2T |false|


  option .y2o at xmin_x2O ymax+0.2 callback |call !!view3DFromToCB('Update')| width 5
  text .y2  at xmax+1 ymin callback |call !!view3DFromToCB('Update')| width 14 isou
  var  _y2 (0)
  toggle .y2t states |false| |true|
  var    _y2T |false|


  option .z2o at xmin_x2O ymax+0.2 callback |call !!view3DFromToCB('Update')| width 5
  text .z2  at xmax+1 ymin callback |call !!view3DFromToCB('Update')| width 14 isou
  var  _z2 (0)
  toggle .z2t states |false| |true|
  var    _z2T |false|

  -------------
  -- Lock texts
  -------------

  para .ltx1 at xmax form-5 ymin_txt1 text |Lock|
  para .ltx2 at xmin_ltx1   ymin_txt2 text |Lock|


  button .apply  | Apply | at xmin form+1 ymax form+0.5 callback |call !!view3DFromToCB('Apply')|
  button .cancel |Dismiss| at xmax form-9 ymin          callback |!this.hide()| ok

  ---------------------------------------------
  -- MEMBERS
  --  These *maybe* used instead of the gadgets
  --  defined in the old form _CD3DVDAT
  ---------------------------------------------

  member .title     is STRING
  member .xmac      is STRING
  member .macro     is STRING
  member .margs     is STRING
  member .cmd       is STRING
  member .query     is STRING
  member .pass      is STRING

  -- Functions to run when buttons are pressed
  member .applyFunc   is STRING
  member .dismissFunc is STRING
  member .textFunc    is STRING

  member .currentView is GADGET

exit
-- End of form definition for !!view3DFromTo

  ---------------------------------
  -- SET MEMBERS DEFAULT VALUES
  ---------------------------------

  !!view3DFromTo.textFunc  = |!!view3DFromToCB('Update')|
  !!view3DFromTo.applyFunc = |!!view3DFromToCB('Apply')|
  ------------------------------------------------------------------------
--
-- Method:      view3DFromTo
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .view3DFromTo()

   var !coord coord
   if(!coord.eq('ENU'))then
    !eastDtext[1]                   = 'East'
    !eastDtext[2]                   = 'West'
    !northDtext[1]                  = 'North'
    !northDtext[2]                  = 'South'
    !upDtext[1]                     = 'Up'
    !upDtext[2]                     = 'Down'
   else
    !eastDtext[1]                   = 'X'
    !eastDtext[2]                   = '-X'
    !northDtext[1]                  = 'Y'
    !northDtext[2]                  = '-Y'
    !upDtext[1]                     = 'Z'
    !upDtext[2]                     = '-Z'
   endif
   !rText[1]                        = ''
   !rText[2]                        = '-'
   !this.x1o.dText                  = !eastDtext
   !this.y1o.dText                  = !northDtext
   !this.z1o.dText                  = !upDtext
   !this.x2o.dText                  = !eastDtext
   !this.y2o.dText                  = !northDtext
   !this.z2o.dText                  = !upDtext
   !this.x1o.rText                  = !rText
   !this.y1o.rText                  = !rText
   !this.z1o.rText                  = !rText
   !this.x2o.rText                  = !rText
   !this.y2o.rText                  = !rText
   !this.z2o.rText                  = !rText

endmethod
-- End of method definition for .view3DFromTo()
