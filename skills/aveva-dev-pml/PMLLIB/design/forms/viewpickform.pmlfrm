--
--
-- Description:
-- Simple form to replace the "Status Form" with the single cancel button
--
------------------------------------------------------------------------

setup form !!viewPickForm

  !!viewPickForm.formTitle     = 'Picking'
  !!viewPickForm.iconTitle     = 'Picking'
  !!viewPickForm.callback      = '!!view3DPickCB(|INIT|)'
  !!viewPickForm.formRevision  = ' $Revision: 1.5 $ '

  ---------------------------
  -- Body of form definition
  ---------------------------

  para   .text   at xmin+0.5 ymax+0.5 width 30 lines 3

  button .ok     |  OK  | at xmin ymax  call |call !!view3DPickCB('OK')| OK
  button .cancel |Cancel| at x26  ymin  call |call !!view3DPickCB('CANCEL')| CANCEL

  member .currentView    is GADGET
  member .userFunction   is STRING
  member .numPicks       is REAL
  member .picksNeeded    is REAL
  member .elements       is ARRAY

exit
-- End of form definition for !!viewPickForm

  !!viewPickForm.text.val     = 'When you have finished picking elements, click the Ok button'
  !!viewPickForm.userFunction = ''
