-- Created:         Wed Aug 27 12:29:47 1997
--
--
-- Description:
-- Mark the given position along a specified p-line
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Pline
--    2   R      DBREF       Element
--    3   R      REAL        ZDistance
--    4   R      REAL        Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidPlineDraw(!pLine is STRING, !element is DBREF, !dist is REAL, !number is REAL)

-- Clear any existing
AID CLEAR ARROW $!number
handle any
endhandle

AID CLEAR TEXT $!number
handle any
endhandle

-- Find Section
if (!element.hardType eq |SCTN| ) then
     !sctn = !element
elseif (!element.owner.hardType eq |SCTN|) then
     !sctn = !element.owner
elseif (!element.owner.owner.hardType eq |SCTN|) then
     !sctn = !element.owner.owner
elseif (!element.owner.owner.owner.hardType eq |SCTN|) then
     !sctn = !element.owner.owner.owner
else
     return
endif

!start = !sctn.plStart.attribute(!pLine).wrt(WORLD)
handle any
    !start = !sctn.poss
    !end = !sctn.pose
elsehandle none
    !end = !sctn.plEnd.attribute(!pLine).wrt(WORLD)
endhandle

if (!element.hardType eq 'SCTN') then
-- Limbo old syntax
     var !string   PPLIN $!pLine OF $!element DISTANCE $!dist
     !position = !string.position()
else
    !line = !!consLinePos(!start, !end)
    !position = !!consPosNearLine(!element.position, !line)
endif
--
!textPos = !!consPosDistDir(500, !element.plori.attribute(!pLine).yDir(),  !position)

-- Add aids
!arrow = object ARROW()
!arrow.length = 500mm
!arrow.dir =  !element.plori.attribute(!pLine).yDir()
!arrow.pos = !position

call !!drawAidArrow(!number, !arrow)

call !!drawAidText(!pLine, !textPos, !number)

endfunction
-- End of function definition for !!aidPlineDraw
