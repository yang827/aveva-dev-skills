--
--
-- Description:
--    Aligns the current selection/component
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!alignComponent()

  -- Test to see if common global object for common pipe actions is available
  if(undefined(!!pipingActions)) then
    !!pipingActions = object PIPINGACTIONS('pipingActions')
  endif

  -- Determine if there is a valid selection or component
  !selection        = object SELECTION()
  !selection.getCurrent()
  !selected         = !selection.getSelection()

  -- Align Single selection
  if(!selected.empty() and !!ce.type.neq('WORL') and !!ce.owner.type eq 'BRAN') then
    if(!!pipingActions.alignComponent(!!ce).not()) then
      !!alert.message(!!error.text)
    endif

  -- Align selection of components
  else
    if(!!pipingActions.alignComponents(!selected).not()) then
      !!alert.message(!!error.text)
    endif
  endif

endfunction
-- End of function definition
