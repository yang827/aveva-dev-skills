$(
------------------------------------------------------------------------

Macro:   applypipepenetration.pmlfnc                           $Revision: 1.0 $
Author:  Richard Martin

Macro Generic Type: Definition, Declaration

------------------------------------------------------------------------
$)

define function !!applyPipePenetration()

  -- we first need to get the intersect points for the selection we have already made
  -- we can use a modified version of the original single penetration method for doing this
  !!pipe1to1pene()

  -- if hole management is activated then use the following
  if !!isThisHmProj() then

    -- call the hole management application
    loadform !!hmDefinition

    -- define the penetration list for HMDefinition
    -- [n][1] penetrated panel reference
    -- [n][2] pipe reference
    -- [n][3] intersection point (position)
    -- [n][4] atta reference

    !holeData = ARRAY()
    !holeData.append(!!cd1to1pend.penetrated)
    !holeData.append(!!cd1to1pend.penetrating.owner)
    !holeData.append(!!cd1to1pend.origin)
    !holeData.append(!!cd1to1pend.penetrating)
    !!hmDefinition.multiPenetrationData.clear()
    !!hmDefinition.multiPenetrationData.append(!holeData)
    !!hmDefinition.direction = !!cd1to1pend.direction

    -- if we have no write access to the panel being penetrated then we can't have a subfitting so don't append
    !writeAccess = !!cd1to1pend.penetrated.dbwrite

    if !writeAccess then
      !!hmDefinition.penetrating.append(!!cd1to1pend.subfitting)
    endif

    -- show the hole definition form
    show !!hmDefinition
  else
    --if hole management is not activated then use the standard penetration app
    --we need to apply the default hole type here
    !form = !!cdmpene
    !shown = !form.shown()
    if(!shown) then
      !!ce = !!cd1to1pend.penetrated
      $M "%PDMSUI%/DES/PENS/XMPENE" HOLE BRAN
    endif
  endif

endfunction
