-- File:            aslcmpspref.pmlfnc
--   Type:          Function Definition
--   Group:         Access, Stairs :group: Ladders Application
--     Keyword:     ASL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Fri Oct 10 13:32:03 BST 1997
--
--
-- Description:
-- function to change the spref's of components below the current position
-- This is done by creating a DDSE at the same level as the tmpl, one down
-- from the gensec, and setting up DDAT's to reflect the setting chosen.
-- If their is already one created use it and modify the existing ddat's.
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Option for dflt]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslCmpSpref(!option is STRING)


-- set original Position
   !refe = !!ce

-- Goto form current element
   !!ce = !!aslCmpSpref.currentRefe

DDSE 1
 handle any
 -- if there isn't one already create one
  NEW DDSE
 endhandle

 -- use existing DDAT's
  !ddat = !!collectAllFor(|DDAT|,||,!!ce)

  do !index indices !!aslCmpSpref.dkey
    !!ce = !ddat[!index]
    handle any
--  If indexes is more than there are DDATS then create a new one
     NEW DDAT
    endhandle
-- Get this data from form members
   DKEY $!!aslCmpSpref.dkey[$!index]
   DDDF $!!aslCmpSpref.dddf[$!index]
   DTIT '$!!aslCmpSpref.dtit[$!index]'
-- Get The Property from the relevant option gadget.

   if(!option.eq('DFLT')) then
-- The Text string needed from the prop dddf is the ref no. from ( ID =434/34332)
      !rText = !!aslCmpSpref.dddf[!index].part(3)
-- Reset the option gadget to show the default
      !!aslCmpSpref.specSel$!!<aslCmpSpref.dkey[$!index]>.select('RTEXT',!rText)
   else
-- Set the DDPR to the new value on the form
      !newProp = !!aslCmpSpref.specSel$!!aslCmpSpref.dkey[$!index]$n.selection('RTEXT')
      DDPR $!newProp
   endif
  enddo

-- Execute the rules if requested
-- 1 - No rules
-- 2 - All Rules
-- 3 - Rules on References

-- only do this if not dflt... may need to consider if the item is locked.



   if(!option.neq('DFLT')) then
-- Collect all items which are lock
   !coll = !!collectAllFor(||,|Lock|,!!aslCmpSpref.currentRefe)

    !lflg = FALSE
    if(!coll.size() gt 0) then
       !lflg = true
       !confirm = !!alert.confirm(|The item or one of its offspring is lock, OK to EVALUATE rules? This will reset the lock back after evaluation.|)
       if(!confirm eq 'NO') then
           return
       endif
    endif

-- Unlock locked elements
    if(!lflg) then
       !max = !coll.size()

       do !i from 1 to !max
          !!ce = !coll[!i]
           UNLOCK
       enddo
          !!ce = !!aslCmpSpref.currentRefe

       if(!!aslCmpSpref.executeRules.val.eq(2)) then
         !!ce = !!aslCmpSpref.currentRefe
         RULE REXE
       elseif(!!aslCmpSpref.executeRules.val.eq(3)) then
         RULE EXECUTE SPREF ON ALL FOR $!!aslCmpSpref.currentRefe
       else
       -- do nothing
       endif

      -- Go backwards through the collection (first order search) and relock
      -- all the items in the list
      do !i from !max to 1
         !!ce = !coll[$!i]
         LOCK
      enddo

     else
-- if not locked do it anyway
       if(!!aslCmpSpref.executeRules.val.eq(2)) then
          !!ce = !!aslCmpSpref.currentRefe
          RULE REXE
       elseif(!!aslCmpSpref.executeRules.val.eq(3)) then
          RULE EXECUTE SPREF ON ALL FOR $!!aslCmpSpref.currentRefe
       else
       -- do nothing
       endif

     endif
    endif
-- Back To Original element

   !!ce = !refe
endfunction
-- End of function definition for !!aslCmpSpref
