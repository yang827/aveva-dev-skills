--   Group:         Access, Stairs :group: Ladders Application
--     Keyword:     ASL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Fri Oct 10 13:32:03 BST 1997
--
--
-- Description:
-- function to COLLECT ALL Reference DDAT's and create a form with the
-- option gadgets for selection
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [BOOLEAN]   [Whether to show form or not]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslCmpSprefInvo(!showForm is BOOLEAN) is BOOLEAN

-- Set original Hierarchy position

   !refe = !!ce

-- at GENSEC

-- COLLECT ALL ddat with ref attributes


      !refDDats = !!collectAllFor(|DDAT|,|TYPE OF OWNER OF OWNER EQ 'TMPL' $
                                   AND PTYP EQ 'SPRE' AND LDISP EQ TRUE|,!!ce)


-- only show form if ref type ddats exist

   if(!refDDats.size().neq(0)) then


-- Evaluate DDDF to get spec to select from

      !extractDddf = object BLOCK('!refDDats[!evalIndex].dddf')
      !dddfs       = !refDDats.evaluate(!extractDddf)

-- Evaluate DTIT to get spec to select from

      !extractDtit = object BLOCK('!refDDats[!evalIndex].dtit')
      !dtits       = !refDDats.evaluate(!extractDtit)
      !tlen        = !dtits.width()

-- Evaluate DKEY to get spec to select from

      !extractDkey = object BLOCK('!refDDats[!evalIndex].dkey')
      !dKeys       = !refDDats.evaluate(!extractDkey)

--    go to each one in the DB and collect the selection list from the spec

      do !sprefs indices !refDDats
--   get the Spre name from the DDDF
      !!ce = !refDDats[!sprefs].dddf.part(3).dbRef()
      handle any
--   if the ddat is not set up properly
       skip
      endhandle
      !!selection[$!sprefs] = !!collectAllFor(|SPCO|,||,!!ce.owner)


      enddo

   !return = TRUE

   else

-- do nothing
   !return = FALSE
   return !return
   return
   endif

-- Go Back to GENSEC

   !!ce = !refe

------------------------------------------------------------------
-- Info has been collected, now populate a form
------------------------------------------------------------------

-- Kill existing form definition

   kill !!aslCmpSpref


-- Define form
setup form !!aslCmpSpref

   !!aslCmpSpref.formTitle     = |HandRail Component Selection|
   !!aslCmpSpref.iconTitle     = |HRCmpSel|
   !!aslCmpSpref.formRevision  = | $Revision: 1.14 $ |

-- Members to allow creation of the ddats at the gensec level using these values

   member .currentRefe is DBREF
   member .dddf is ARRAY
   member .dtit is ARRAY
   member .dkey is ARRAY
   member .ddpr is ARRAY

-- Put the Option Gadgets in
   path down


-- Populate the form members with the DDATS from the TMPL.

   !!aslCmpSpref.dddf = !dddfs
   !!aslCmpSpref.dkey = !dKeys
   !!aslCmpSpref.dtit = !dtits

-- for each Reference DDAT create an option gadget and populate with permissibles
   do !index indices !refDDats
      !spcoName = ARRAY()
      !spcoRefe = ARRAY()

-- add permissibles to the option gadget

      do !spcoIndex indices !!selection[!index]
       !spcoName[!spcoIndex]  = !!selection[!index][!spcoIndex].name
       !spcoRefe[!spcoIndex]  = !!selection[!index][!spcoIndex].string()
      enddo

-- compose text to justify right

     var !text COMPOSE |$!refDDats[$!index].dtit| WIDTH $!tlen R

     option .specSel$!dKeys[$!index] |$!text[1]| call || width 25
     handle any
--   if a dkey is duplicated, then don't build the form
      exit
      return error 1 |Not able to modify Component spref's from this element,$
                      check dataset elements are not duplicated.|
     endhandle

-- Enter the Values of the option gadgets

     !!aslCmpSpref.specSel$!dKeys[$!index]$n.dText = !spcoName
     !!aslCmpSpref.specSel$!dKeys[$!index]$n.rText = !spcoRefe
-- Try and set default
     !!dddfNew = $!!aslCmpSpref.dddf[$!index]

     !!aslCmpSpref.specSel$!dKeys[$!index]$n.select('DTEXT',!!dddfNew.name )

    handle any
    endhandle

   enddo

-- Execute rules or not

   frame .rules at xmin ymax |Rule Execution|
    rgroup .executeRules
       add tag |Do Not Execute Rules| call ||
       add tag |Execute All Reference Rules| call ||
       add tag |Execute All Rules| call ||
    exit
   exit



   button .apply  |Apply| at x 1 ymax+1 call |!!aslCmpSpref('')| apply
path right
   button .default |Default| at xmax+12 ymin call |!!aslCmpSpref('DFLT')|
   button .dismiss |Dismiss| at xmax form-size cancel

exit

-- Form Initialisation
-- If Gensec has a ddse (ie modifying an existing, then get spref's already set)

-- setup ce in the form

   !!aslCmpSpref.currentRefe = !!ce

   !setSprefs = DEPL
   if(!setSprefs.set()) then

      do !props indices !setSprefs
         !prop = PROP $!setSprefs[$!props]
--     Try to set existing
        !!aslCmpSpref.specSel$!setSprefs[$!props]$n.select('DTEXT',!prop)
        handle any
         -- do nothing if can't find gadget
        endhandle
      enddo

   endif


if(!showForm) then
   show !!aslCmpSpref
endif

-- Goto back to original

   !!ce = !refe

  return !return

endfunction
-- End of function definition for !!aslCmpSprefInvo
