--
-- Description:
-- Function to realign fitting with posts
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslFittToPostAlg(!dbRef is DBREF)

!refe = !!ce

-- from the passed gid level COLLECT ALL fittings with links
   !fitt = !!collectAllFor('FITT', 'LREF OF LNKI1 OF LNKS1 OF FITT NEQ NULREF', !dbRef)

-- Goto each fitting and restate zdist along the sctn thro LREF

   do !ind indices !fitt
      !!ce = !fitt[!ind]
      ZDIST THRO LREF OF LNKI 1 OF LNKS 1 OF CE
   enddo

!!ce = !refe
endfunction
-- End of function definition for !!aslFittToPostAlg
