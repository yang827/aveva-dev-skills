--
--
-- Description:
-- Function to get all Functions from DDSE elements and run each one.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Item to execute rules on]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslFunctionExec(!gid is DBREF)

-- To return to original position

   !refe =  !!ce

-- COLLECT ALL macros associated with CE for repeat

   if(!gid.type eq |TMPL| and !gid.owner.type neq |TMAR|) then
      OWNER $* go up a level
      !gid = !!ce
   endif

 if(TYPE OF OWNER OF $!gid NEQ |TMAR|) then $* do it (don't repeat in templ area)

    !tmpl = !!collectAllFor(|TMPL|,||,!gid)

    if(!tmpl.size() neq 0) then
      do !tind indices !tmpl
      !ddat = !!collectAllFor(|DDAT|,|OWNER OF DDSE EQ $!tmpl[$!tind] AND PURP EQ 'FUNC'|,!tmpl[!tind])
      !extddpr   = object BLOCK('!ddat[!evalIndex].ddpr')
      !ddpr      = !ddat.evaluate(!extddpr)
       if(!ddat.size() neq 0) then
          do !ind indices !ddat
          var !function $!ddpr[$!ind]
             !!ce = !tmpl[!tind].owner
             $!function
             $!function
             handle any
                error |error in $!ddpr[$!ind]|
             endhandle
          enddo
       endif
      enddo
    endif
 endif

-- go back to original

   !!ce = !refe


endfunction
-- End of function definition for !!aslFunctionExec
