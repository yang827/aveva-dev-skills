--
--
-- Description:
-- Function to Pick Start and End of ASL geometry
-- SEE SYNOPSIS AT BOTTOM OF FILE
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslGeom()

-- get data from EDG object (new EDG)
   !pickedData = !!getEdgData()

-- !whichEnd = !!aslSpec.startDef.val
   if(!!aslSpec.startPos.item.unset()) then
-- start position
-- clear aids from graphics
     !!aidClear(|15003|,|ALL|)
-- Depress toggle to select start WP
   !!aslSpec.reDef.val = True
   !!aslSpec.reDefEnd.val = false
-- Reposition aids
     !!aidAxes(15003, |First WP|, !pickedData.pos, 500)
-- set start pos gadget
     !!aslSpec.startPos = !pickedData
-- show angle of ASL and Max length
    if(!!aslSpec.whichPick.val neq |Point2Point|) then

--  Determine direction of item picked (if no direction can be
--  determined use the form direction)
     if(!!edgGeomData.vector.direction.origin.unset()) then
        !direction = !!aslSpec.direction.val
     else
        !cntdItemDir = !!edgGeomData.vector.direction
     endif


-- Get Derived End Pos from max length, angle and direction

      if(!!aslSpec.whichPick.val eq |Normal| or !!aslSpec.whichPick.val eq |Point2Plane|) then
         !aslPlane     = !!planePntDir(!!aslSpec.startPos.pos, !cntdItemDir)
         !pickDir      = !!aslSpec.startPos.vec.direction
         !uPlane       = !!planePntDir(!!aslSpec.startPos.pos,U)
         !pickOnUPlane = !!directionOnPlane(!pickDir,!uPlane)

         !directTmp  = !!normalToDirs(!cntdItemDir, !pickOnUPlane)
         !direction  = !!normalToDirs(!cntdItemDir, !directTmp)
         !!aslSpec.direction.val   = !direction
      else
      -- use direction value from form
        !direction = !!aslSpec.direction.val
      endif

-- Get default values

   !angle     = !!aslSpec.angle.val
   !height    = !!aslSpec.maxLength
   !upOrDown  = !!aslSpec.topOrBot.selection('Rtext').direction()

-- Geometric Calculator To Determine End Point

    !endDerPos = !!getDerivedEnd(!angle, !direction, !!aslSpec.startPos.pos, !height, !upOrDown)

    !!aslSpec.endDerPos = !endDerPos

-- Construct line between start and derived end
    !!aidLine(15003,!!aslSpec.startPos.pos,!!aslSpec.endDerPos)
-- Mark derived end
    !!aidSphere(15004,!!aslSpec.endDerPos, 100)
    endif
-- Change prompt to end position
    !!edgGeomPrmpt('ASL Picking','Define Second WP : ','')
-- Depress toggle to select end WP
   !!aslSpec.reDefEnd.val = True
   !!aslSpec.reDef.val = False

-- Populate Start Position gadgets
   !!load3Ddata(!!aslSpec.startPos.pos,|Start|)

-- Lock the position as the fixed point to allow the tmpl to change the gensec angle

   !!aslSpec.firstWpFix.val = TRUE
   !!aslWpLock(!!aslSpec.firstWpFix,'First')

-- ******Set End Position gadget*******
   else

   !!aslSpec.endPos = !pickedData

--  Determine direction of item picked (if no direction can be
--  determined use the form direction)

--  put this in the pick data object (to do)

    !cntdItemDir = !!aslSpec.startPos.dir
    !upOrDown  = !!aslSpec.topOrBot.selection('Rtext').direction()

-- Get Angle and direction (in case changed)

    !angle     = !!aslSpec.angle.val.real()
    !height    = !!aslSpec.maxLength
    !direction = !!aslSpec.direction.val

-- And Recalculate to determine end point

    !endDerPos = !!getDerivedEnd(!angle, !direction, !!aslSpec.startPos.pos, !height, !upOrDown)

    !!aslSpec.endDerPos = !endDerPos

-- Clear End Pos Aids
    !!aidClear(|15004|,|ALL|)

-- set up Plane datum
     !plane = object VECTOR()
     !plane.direction = U
     !plane.position = !!aslSpec.endPos.pos    $* should be lowest point(to do)
     !aslDir = !!directionFromTo(!!aslSpec.startPos.pos, !!aslSpec.endDerPos)
     !newDir = !!directionOnPlane(!aslDir,!plane)
     !sctnDir = !cntdItemDir

-- End Position depends on Button Selected ************* 3rd Button **********
    if(!!aslSpec.whichPick.val eq |Point2Plane|) then

--  Redefine EndPos
       !planeVert = object VECTOR()
       !planeVert.direction = !sctnDir
       !planeVert.position  = !!aslSpec.startPos.pos
       !aslDir              = !!directionFromTo(!!aslSpec.startPos.pos, !!aslSpec.endPos.pos)
       !newAslDir           = !!directionOnPlane(!aslDir,!planeVert)
       !aslLine             = !!lineDirPos(!newAslDir,!!aslSpec.startPos.pos)
       !!aslSpec.endPos.pos = !!pos3DPlaneLine(!plane,!aslLine)

-- change angle in form to show calculated angle

       !angle = !!anglePlaneLine(!plane, !aslLine).abs()
       !!aslSpec.angle.val = !angle

-- show next step with colour

       !!aslSpec.eval.background = 'LightGold'

--                          ************* 2nd Button **************

    elseif(!!aslSpec.whichPick.val eq |Normal|) then

-- set the plane direction for cal the endpos , 0 for walkways

           if(!!aslSpec.angle.val eq 0) then
              !endPlaneDir = !aslDir
           else
              !endPlaneDir = U
           endif

           !aslPlane  = !!planePntDir(!!aslSpec.startPos.pos, !sctnDir)
           !newDir    = !!directionOnPlane(!aslDir,!aslPlane)

           !aslLine   = !!lineDirPos(!newDir,!!aslSpec.startPos.pos)
           !endPlane  = !!planePntDir(!!aslSpec.endPos.pos, !endPlaneDir)
----------------this needs to be put into form variables and not here maybe ??--------
           !pickDir       = !!aslSpec.endPos.vec.direction
----------------------------------------------------------------------
-- In modify mode the startPos.vec.direction will not be set, therefore
-- the direction can be derived from the poss/pose of existing sctn.This
-- area has to be worked on when the EDG geomdata is passing the correct
-- values.
----------------------------------------------------------------------

         !uPlane        = !!planePntDir(!!aslSpec.startPos.pos,U)
         !pickOnUPlane  = !!directionOnPlane(!pickDir,!uPlane)
         !directTmp  = !!normalToDirs(!cntdItemDir, !pickOnUPlane)
         !direction  = !!normalToDirs(!cntdItemDir, !directTmp)
         !!aslSpec.direction.val   = !direction

------ info calculated on first pick -----------------------
--  Redefine EndPos
     !!aslSpec.endPos.pos = !!pos3DPlaneLine(!endPlane, !aslLine)


    else
--  Calculate angle and direction of picked points (When Point2Point)

     !calcAngle = !!getAngPlanePts(!plane, !!aslSpec.startPos.pos)
     !!aslSpec.angle.val = !calcAngle.abs()
-- And now direction
       !aslDir = !!directionFromTo(!!aslSpec.startPos.pos, !!aslSpec.endPos.pos)
       !newDir = !!directionOnPlane(!aslDir,!plane)
       !!aslSpec.direction.val = !newDir
-- show next step with colour
    !!aslSpec.eval.background = 'LightGold'
    endif
--  Display end axes
     !!aidAxes(15004, |Second WP|, !!aslSpec.endPos.pos, 500)

--   Construct line between start and end
     !!aidLine(15004, !!aslSpec.startPos.pos,  !!aslSpec.endPos.pos)
--   Clear aid for derived length
     !!aidClear(|15003|,|LINE|)
--   Populate Start Position gadgets
     !!load3Ddata(!!aslSpec.endPos.pos,|End|)
--   ungrey the spec selection
     !!specStatus(True,False)
   endif

endfunction
-- End of function definition for !!aslGeom



-- Synopsis.
-- ---------
-- The picking of the start/end of the ASL component is driven by 3 buttons
-- for choosing the type of pick. The selection of one of these buttons will
-- determine how the second point is determined. The following is a
-- description of each:-
--
-- Button 1 - Point to Point
-- Selection of "Point To Point", will grey out the spec selection and the
-- direction and angle gadgets, as these will be determined by the two picks.
-- The second point is determined by the exact point chosen by the event.
-- Therefore it is the raw position back from EDG with no intervention from
-- the ASL form. The angle, direction and spec gadgets are greyed out because
-- they are not used to determine the second point.
--
-- Button 2 - Point to Plane/Angle
-- Selection of the "Point to Plane/Angle", uses the first pick to determine
-- the direction of the ASL component. The item picked is interrogated to find
-- it's direction (for a sctn :- along it's length). From it's direction the
-- ASL form can determine the direction of the ASL component (normal to the
-- item's direction). This button also uses the angle on the form to project
-- the line of the ASL component from the first WP. This angle is taken from
-- the specification item selected from the spec selection part of the form.
-- So this button relies on the spec selection in order to calculate the end
-- end position from the EDG second pick. The second pick in the EDG defines
-- the plane, and the aslGeom functions calculates then end position on the
-- plane picked, using the direction normal to the first picked item, and the
-- angle from the spec selection.
--
-- Button 3 - Point to Plane/Line
-- Selection of the "Point to Plane/Line", uses a similar mechanism to Button
-- 2, except that it uses the EDG picked position to determine the angle of the
-- ASL component, rather than using the Spec selected angle. The direction of
-- the ASL component is still normal to the first item picked.
--
