-- Define function
define function !!aslHandrailInvo(!mode is STRING)

-- Set up edg

   if(!!edgInUse()) then
       !nameOfApp   = !!edgNameOfApp()
       !!setMessage(1,!nameOfApp)
       !!error(05002)
   endif

  ----------------------------------------------------------------------
  -- Set EDG to pick elements (PICK) and only sections (See Qualifier)
  ----------------------------------------------------------------------

  !args              = object EDGPUSHPARAMS()
  !args.pickHandler  = 'DEFAULT'
  !args.inMode       = 'PICK'
  !args.userFunction = '!!aslHandrail.pick()'
  !args.rootPrompt   = 'Define Rail Start : '
  !args.appName      = 'Handrail Definition'
  !args.showPickForm = TRUE
  !args.elementQual  = 'type eq |SCTN|'

  !!edgPush(!args)



-- Create ASL (create stop CE being picked)
if(undefined(!!aslHandrail)) then
   pml load form !!aslHandrail
endif

   if(!mode.eq('CREATE')) then
      !!aslHandrail.checkMode = 'CREATE'
      show !!aslHandrail
     -- !!aslHandrail.ce.active = false
   else
      !!aslHandrail.checkMode = 'MODIFY'
      show !!aslHandrail
   --   !!aslHandrail.ce.active = true
   endif


-- Set mode of form

   !!aslHandrail.mode.select('RTEXT', !mode)



endfunction
-- End of function definition for !!aslHandrailInvo
