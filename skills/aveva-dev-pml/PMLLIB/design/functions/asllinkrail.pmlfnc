--
--
-- Description:
-- Function called by EDG to collect arrays of
-- posts and brackets to link
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function

define function !!aslLinkRail()


-- get data from EDG object (new EDG)
   !pickData = !!edgGeomData

-- When PickedItem is unset event is picking a Post
   if(!!aslLinkRail.pickedItem.unset()) then
--    Set A global Variable to distinguish between Post and Bracket
       !!aslLinkRail.pickedItem     = !pickData.pickedItem
--    Save Post Picked item, in case bracket is reselected
       !!aslLinkRail.pickedItemSave = !!aslLinkRail.pickedItem
--    Append form array with post item
       !!aslLinkRail.posts.append(!pickData.pickedItem)
--    Set button for Bracket picking on init form
       !!aslLinkRailInit(!!aslLinkRail.bracket,'BRACKET', 'RED','NORMAL')
--    Reset EDG for Bracket
       !!edgGeomPrmpt('ASL Rail Linking','Pick Rail Bracket for Post : ','')
       !args              = object EDGPUSHPARAMS()
       !args.appName      = 'ASL Rail Linking'
       !args.elementQual  = 'type of owner of tmpl eq |FITT|'
       !!edgUpdateApp(!args)
--    Don't allow the accept button to be pressed until a bracket is picked
       !!aslLinkRail.accept.active = FALSE
--    Enhance the post picked
      ENHANCE $!pickData.pickedItem COLOUR 23
   else
--   ******* Second pick ******* for bracket
--   Append Array with bracket data
      !!aslLinkRail.brackets.append(!pickData.pickedItem)
--   Reset the Global variable so the next pick is a Post
      !!aslLinkRail.pickedItem = object DBREF()
--   Set button for post picking on init form
      !!aslLinkRailInit(!!aslLinkRail.post,'POST', 'RED','NORMAL')
--   Enhance the bracket picked
      ENHANCE OWNER  OF $!pickData.pickedItem COLOUR 24
--   Reset EDG for Post
      !!edgGeomPrmpt('ASL Rail Linking','Pick Rail Post to Link : ','')
       !args              = object EDGPUSHPARAMS()
       !args.appName      = 'ASL Rail Linking'
       !args.elementQual  = 'type eq |SCTN|'
       !!edgUpdateApp(!args)

   endif

-- Only allow the accept button to be active if the arrays are equal

   if(!!aslLinkRail.posts.size().eq(!!aslLinkRail.brackets.size())) then
      !!aslLinkRail.accept.active = True
   endif

endfunction
-- End of function definition for !!aslLinkRail
