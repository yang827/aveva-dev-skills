--
--
-- Description:
-- function to link the picked posts to the corresponding
-- brackets with lnks and lnki's
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslLinkRailExec(!posts is ARRAY, !brackets is ARRAY)


-- store current position in hierarchy
   !refe = !!ce

-- go through each post and link to the corresponding bracket

  do !index indices !posts
      !!ce = !posts[!index]
--   Try to use an existing Lnkset
      LNKS 1
       handle any
         NEW LNKS
         NEW LNKI
       elsehandle none
        LNKI 1
       endhandle
-- Store the link for referencing back to post
   !postLink = !!ce

---------------------------------------------------------
-- Note : - That Appware assumes the bracket is a fitting
---------------------------------------------------------

-- Try to Set LREF of LNKI to Bracket
    LREF LNKI 1 of LNKS 1 OF FITT OF $!brackets[$!index]
-- No LNKI on the bracket so create
   handle any
     !!ce = !brackets[!index]
     FITT
     NEW LNKS
     NEW LNKI

   elsehandle none
     GOTO LREF
   endhandle

-- Store the link for reference back to Bracket
   !bracketLink = !!ce

-- link Bracket to Post

   LREF $!postLink
    handle(2,18)
     UNLOCK ALL
     LREF $!postLink
     LOCK
    endhandle

   GOTO LREF

-- Link Post to Bracket (This will restate LREF if line 55 had no error)
   LREF $!bracketLink
    handle(2,18)
     UNLOCK ALL
     LREF $!bracketLink
     LOCK
    endhandle

  enddo

-- Goto back to Original Element

   !!ce = !refe

   UNENHANCE ALL

endfunction
-- End of function definition for !!aslLinkRailExec
