--
--
-- Description:
-- initialisation for link control form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [Gadget calling this function]
--   [2] [R]    [STRING]    [Gadget Name post/Bracket]
--   [3] [R]    [STRING]    [Colour of gadget]
--   [4] [R]    [STRING]    [Flag for Operation]
--                           NORMAL = when form is Initialised
--                           OTHER  = from the Buttons Post and Bracket
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslLinkRailInit(!gadget is GADGET, !option is STRING, !colour is STRING, !operation is STRING)


-- change colour of button and set form member to the option selected.

   if(!!aslLinkRail.whichPick.unset()) then
      !!aslLinkRail.whichPick = !!aslLinkRail.post
   endif

    !!aslLinkRail.whichPick.background = 205
    !!aslLinkRail.whichPick            = !gadget
    !!aslLinkRail.whichPick.val        = !option
    !!aslLinkRail.whichPick.background = !colour

-- Don't do this on form initialisation
   if(!operation.neq('NORMAL')) then

-- For reselection(if user has picked the wrong thing)
    if(!option eq 'POST') then
       !!aslLinkRail.pickedItem = object DBREF()
-- Remove picked item from the array
       !post = !!aslLinkRail.posts.removeLast()
       !!aslLinkRail.accept.active = FALSE
--   Reset EDG for Post
       !!edgGeomPrmpt('ASL Rail Linking','Pick Rail Post to Link : ','')
       !args              = object EDGPUSHPARAMS()
       !args.appName      = 'ASL Rail Linking'
       !args.elementQual  = 'type  eq |SCTN|'
       !!edgUpdateApp(!args)
--   Active accept 'cos equal number of posts/brackets
       if(!!aslLinkRail.posts.size().neq(0)) then
          !!aslLinkRail.accept.active = TRUE
       endif
--   unenhance post removed from array
       UNENHANCE $!post
    elseif(!option.eq('BRACKET')) then
-- Reload controlling variable .pickedItem to recognise bracket is to be picked
       !!aslLinkRail.pickedItem = !!aslLinkRail.pickedItemSave
-- Remove picked item from the array
       !bracket = !!aslLinkRail.brackets.removeLast()
--   Reset EDG for Post
       !!edgGeomPrmpt('ASL Rail Linking','Pick Rail Bracket For Post : ','')
       !args              = object EDGPUSHPARAMS()
       !args.appName      = 'ASL Rail Linking'
       !args.elementQual  = 'type of owner of tmpl eq |FITT|'
       !!edgUpdateApp(!args)
--   Don't allow accept until equal number of items on the arrays
       !!aslLinkRail.accept.active = FALSE
--   unenhance post removed from array
       UNENHANCE OWNER OF $!bracket
    endif
   endif

endfunction
-- End of function definition for !!aslLinkRailInit
