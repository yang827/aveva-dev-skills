--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function


   define function !!aslLinkRailInvo()


--    Set up edg

      if(!!edgInUse()) then
          !nameOfApp   = !!edgNameOfApp()
          !!setMessage(1,!nameOfApp)
          !!error(05002)
      endif

      -----------------------------------
      -- Set EDG to pick elements (PICK)
      -----------------------------------

      !args              = object EDGPUSHPARAMS()
      !args.pickHandler  = '!!edgPickFast'
      !args.inMode       = 'PICK'
      !args.userFunction = '!!aslLinkRail()'
      !args.rootPrompt   = 'Pick Rail Post to link : '
      !args.appName      = 'ASL Rail Linking'
      !args.showPickForm = False
      !args.elementQual  = 'type eq |SCTN|'

      !!edgPush(!args)

--    show Form

      show !!aslLinkRail

-- Accept button inactive

   !!aslLinkRail.accept.active = FALSE
endfunction
-- End of function definition for !!aslLinkRailInvo
