-- Author:          A.Kirkland
-- Created:         Thu Sep 4 08:16:30 BST 1997
--
--
-- Description:
-- Function to realign the owning GENSEC
-- with the TMPL selected, because the step/going will have forced
-- a change to the angle and length of the ASL component if the TMPL is
-- governed by the gradient formula eg 2h + g = 630.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function

define function !!aslRealign(!gensec is DBREF,!whichEnd is STRING) is BOOLEAN

!return = TRUE
!refe   = !!ce

-- Get the distance from the Dataset
-- ***** OLD STYLE PML *****

     var !adjustmentTmp (PROP ADJU OF $!gensec )
      handle any
       !return = FALSE
      endhandle
     var !actualAngleTmp (PROP ANGL OF $!gensec )
      handle any
       !return = FALSE
      endhandle
     var !dfltAngleTmp   (PRDE ANGL OF $!gensec )
      handle any
       !return = FALSE
      endhandle

-- Convert to PML II

    !adjustment  = !adjustmentTmp.real()
    !actualAngle = !actualAngleTmp.real()
    !dfltAngle   = !dfltAngleTmp.real()

----------------------------------------
!uPlane    = !!planePntDir(!gensec.position,U)

--!zDir       = !!directionFromTo(!gensec.poss, !gensec.pose)
!zDir      = !gensec.zDir.wrt(world)

!genSecDir = !!directionOnPlane(!zDir,!uPlane)


!!ce = !gensec


 if(!whichEnd eq 'START') then
    POINSP 1 OF SPINE 1 OF CE
     if(!actualAngle gt !dfltAngle) then
        !adjustment = !adjustment.abs()
     endif
 else
    POINSP 2 OF SPINE 1 OF CE
     if(!actualAngle lt !dfltAngle) then
        !adjustment = !adjustment.abs()
     endif
 endif

-- PDMS SYNTAX to reposition the start or end of the GENSEC

   MOVE $!genSecDir DIST $!adjustment

!!ce = !refe

return !return

endfunction
-- End of function definition for !!aslRealign
