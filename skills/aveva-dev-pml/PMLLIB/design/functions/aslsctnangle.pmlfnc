--
--
-- Description:
-- Derives specification angle from the passed section/gensection.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslSctnAngle(!section is DBREF) is REAL

  -- Don't do anything if there is no passed item
  if(!section.unset()) then
    return REAL()
  endif

  -- Get Start/End position ends
  !start = !section.posStart
  !end   = !section.posEnd

  -- Define reference plane
  !plane = object PLANE(!start, Z is U wrt World)

  -- Project end onto plane
  !refEnd = !plane.near(!end)

  -- Calculate angle between the three positions
  return !start.angle(!refEnd, !end)

endfunction
-- End of function definition for !!aslSctnAngle
