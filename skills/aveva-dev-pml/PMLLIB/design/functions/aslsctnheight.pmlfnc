--
--
-- Description:
-- Calculates the vertical height of a section used for a ASL item.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!aslSctnHeight(!section is DBREF) is REAL

  -- Don't do anything if there is no passed item
  if(!section.unset()) then
    return REAL()
  endif

  -- Calculate height
  !height = ABS(!section.posEnd.up - !section.posStart.up)

  -- Return height
  return !height

endfunction
-- End of function definition for !!aslSctnHeight
