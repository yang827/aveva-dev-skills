-- Created:         Wed Sep 17 16:39:17 BST 1997
--
--
-- Description:
-- Function to convert SCTN to a Gensec
-- ignoring fitting and joints
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Sctn passed to convert]
--   [2] [R]    [BOOLEAN]   [Delete flag to delete the sctn passed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslSctnToGensec(!sctn is DBREF, !deleteFlg is BOOLEAN)

-- will create the GENSEC along side the sctn in the db
-- unless the delete flag is set to true , in which case the
-- sctn is deleted.

-- reference to return to

   !refe = !!ce
-- To avoid changing CE by reference
   !currentSctn = !sctn

-- Goto Sctn to convert

   !!ce =  !sctn

-- if type not sctn forget it.
   if(!sctn.hardType neq 'SCTN') then
      return error 1 'Not at Sctn'
   endif

   !poss = !sctn.poss.wrt(world)
   !pose = !sctn.pose.wrt(world)
   !spre = !sctn.spre
   !jusl = !sctn.jusl
   !drns = !sctn.drns.wrt(world)
   !drne = !sctn.drne.wrt(world)
   !gtyp = !sctn.gtyp

-- PDMS COMMAND SYNTAX

   NEW GENSEC
   SPRE $!spre
   JUSL $!jusl
   GTYP $!gtyp
   NEW SPINE
   DRNS $!drns
   DRNE $!drne
   NEW POINSP AT $!poss
   NEW POINSP AT $!pose


 if(!deleteFlg) then
    !!ce = !currentSctn
      DELETE SCTN
 else
-- Return to original position in the hierarchy.
    !!ce = !refe
 endif

endfunction
-- End of function definition for !!aslSctnToGensec
