--
--
-- Description:
-- function to extract the default information from
-- the current spco level for inclusion into the aslspec form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslSpecCriteria()

!currentSelected = !!getSpecSelection(!!aslSpec.specData)

-- Don't do anything if selection is not a spco
   if(!currentSelected.set() and !currentSelected.hardType.neq('SPCO')) then

     !!aslSpec.angle.val = 0
     !!aslSpec.maxLength = 0
   else
--  Get Default standard information from spec
--  reset dflts first
      !!aslSpec.dflts = object SPECDFLTS()
--  Get current spre from form

     if(!currentSelected.set()) then
        !!aslSpec.dflts    = !!getDflts(!currentSelected)
     endif
--  Get Preferred Angle (not when auto select is used)

    !whichCriteria = !!aslSpec.dflts.ques.findFirst(|PREA|)
    if(!whichCriteria.unset()) then
       !!aslSpec.angle.val = 0
    else
       !angle  = !!aslSpec.dflts.answ[!whichCriteria]
       !!aslSpec.angle.val = !angle
    endif

-- Get Maximum Length
   !whichCriteria = !!aslSpec.dflts.ques.findFirst(|MAXL|)
    if(!whichCriteria.unset()) then
      !!aslSpec.maxLength = 0
    else
      !maxL  = !!aslSpec.dflts.answ[!whichCriteria]
      !!aslSpec.maxLength = !maxL
    endif

   endif

endfunction
-- End of function definition for !!aslSpecCriteria
