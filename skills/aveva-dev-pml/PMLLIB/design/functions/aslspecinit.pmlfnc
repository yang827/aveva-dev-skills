-- File:            aslspecinit.pmlfnc
--   Type:          Function Definition
--   Group:         Access, Stairs :group: Ladders Application
--     Keyword:     ASL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Tue Sep 30 10:41:57 BST 1997
--
--
-- Description:
-- initialisation for aslSpec form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1  [R   ] [STRING]     Option:
--                                  DEFAULT   - set default weld spec
--                                  MODIFY    - modify the passed items spec
--                                              from the selection list
--                                  LOAD      - load form, when initialising
--    2  [R]    [DBREF]      Item to have its specRef changed
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

-- Define function
define function !!aslSpecInit(!option is STRING, !dummy is ANY)


-- Initialise Variable to be modifiable

   !optionChoice = !option

-- Default setting of Option to be the .mode value

   if(!option eq 'LOAD') then
      !optionChoice = !!aslSpec.mode.selection('RTEXT')
   endif

-- show form

   if(undefined(!!aslSpec)) then
     show !!aslSpec
   endif

-- Set Spec data when option is LOAD
-- unset method is not working for arrays
   if(unset(!!aslSpec.specifications.dText)) then
       call !!aslSpecLoad()
   endif

------------------ Create/Modify ------------------


if(!optionChoice eq |CREATE| or !optionChoice eq |MODIFY|) then
-- Depress toggle to select start WP
   !!aslSpec.reDefEnd.val = False
   !!aslSpec.reDef.val = True
   !!aslSpec.firstWpFix.val = False
   !!aslSpec.secondWpFix.val = False
   !!aslWpLock(!!aslSpec.firstWpFix,'First')
   !!aslWpLock(!!aslSpec.secondWpFix,'First')

---------- Create

   if(!optionChoice eq |CREATE|) then
     !!whichPick(!!aslSpec.ptNrm,true,false, 'RED')
   -- check at level for creation
      SBFR
       handle any
        FRMW
         handle any
          TMPL
           handle any
            call !!edgPop(-1)
            return error 1 |Unable to access SCTN.|
    -- the above line  don't seem to be returning
            return
           endhandle
         endhandle
       endhandle
   -- Set Data



 -- !onam = !owner.flnn
    !!aslSpec.refe       = !!ce

    !!aslSpec.ceName.val = |New Section for | &  !!ce.flnn
    !!aslSpec.formTitle  = |Access Stairs & Ladders. (Creation)|


---------- Modify

   elseif (!optionChoice eq |MODIFY|) then

         SCTN
         handle any
         GENSEC
          handle any
--           CALLIBD RVECDATP ID $<Identify sctn/GENSEC$> $<sctn GENSEC$>
--           golabel /ABORT if($!!cdRtnStatus neq 0)
--            !sctn = $!!cdpnRtn
          elsehandle  NONE
              !sctn = !!ce
          endhandle
         elsehandle none
              !sctn = !!ce
         endhandle



    -- Set form up for current element type
     !spre  = !sctn.spref
     handle any
      var !spre DELETE
      !spre = ||              $* if no spre in list
     endhandle

     !!aslSpec.ce.active = TRUE
     !!aslSpec.ceName.val = !sctn.flnn
     !!aslSpec.formTitle  = |Access Stairs & Ladders. (Modify)|

-- set form to existing spec

   !!specLoad(!!aslSpec.specData,'REF',!sctn)
   !!specLoad(!!aslSpec.specData,'SPCO',!sctn.spre)
   !!specLoad(!!aslSpec.specData,'ACTION','!!aslSpecCriteria')
   !!specSetUp(!!aslSpec.specData)

-- select all entries when modify
--   !!aslSpec.sort.select('Rtext','ALL')
-- get data from SCTN to load form

   !!ce = !!aslSpec.ceName.val.dbRef()

   -- !aslDir = $P get direction
   -- !angle  = $P get Angle

-- positional data
    !poss = POSS WRT WORLD
    !pose = POSE WRT WORLD
    !!aslSpec.startPos.pos = !pose
    !!aslSpec.endPos.pos   = !poss
-- into 3D gadgets
    !!load3Ddata(!!aslSpec.startPos.pos,|Start|)
    !!load3Ddata(!!aslSpec.endPos.pos,|End|)
-- set start position for modify
  -- !!redefstart(true)
-- Put aids at start and end
   !!aidAxes(15003, |First WP|, !!aslSpec.startPos.pos, 500)
   !!aidAxes(15004, |Second WP|, !!aslSpec.endPos.pos, 500)
   !!aidLine(15003,!!aslSpec.startPos.pos,!!aslSpec.endPos.pos)

    !optionChoice = |SPRE|

   endif

endif

endfunction
-- End of function definition for !!aslSpecInit
