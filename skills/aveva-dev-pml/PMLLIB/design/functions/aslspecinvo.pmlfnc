--
-- Author:          A.Kirkland
-- Created:         Wed Oct 1 12:24:50 BST 1997
--
--
-- Description:
-- invoke aslSpec form and set up EDG
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [String]    [Mode of operation]
--                      1 - Option:
--                                      CREATE  - create fitting
--                                      MODIFY  - modify the current item
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslSpecInvo(!option is STRING)


-- Set up edg

   if(!!edgInUse()) then
       !nameOfApp   = !!edgNameOfApp()
       !!setMessage(1,!nameOfApp)
       !!error(05002)
   endif

  ----------------------------------------------------------------------
  -- Set EDG to pick elements (PICK) and only sections (See Qualifier)
  ----------------------------------------------------------------------

  !args              = object EDGPUSHPARAMS()
  !args.pickHandler  = 'DEFAULT'
  !args.inMode       = 'PICK'
  !args.userFunction = '!!aslGeom()'
  !args.rootPrompt   = 'Define First WP : '
  !args.appName      = 'ASL Picking'
  !args.showPickForm = TRUE
  !args.elementQual  = ''

  !!edgPush(!args)

-- show Form
if(undefined(!!aslSpec)) then
   pml reload form !!aslSpec
endif



-- Create ASL (create stop CE being picked)

   if(!option.eq('CREATE')) then
    call !!aslSpecInit('CREATE',!!ce)
    show !!aslSpec
    !!aslSpec.ce.active = false
   elseif (!option.eq('MODIFY')) then
    call !!aslSpecInit('MODIFY',!!ce)
    show !!aslSpec
      !!aslSpec.ce.active = true
   endif


-- Set mode of form

   !!aslSpec.mode.select('RTEXT', !option)


endfunction
-- End of function definition for !!aslSpecInvo
