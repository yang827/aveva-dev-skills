--
--
-- Description:
-- load asl specs into ASL spec form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslSpecLoad()


-- Initialise Variables
   !specs   = ARRAY()
   !message = STRING()

-- Get all messages

  call !!findSpecs('STL','ASL',object Dbref(),!message,!specs)

-- If there are no specs, the we can't set any
   if(!specs.unset()) then
     return error 1 'Unable to find any ASL specifications.'
   endif

-- Load Spec gadget with data
   !block  = object BLOCK('!specs[!evalIndex].description')
   !dText  = !specs.evaluate(!block)
   !block  = object BLOCK('!specs[!evalIndex].string()')
   !rText  = !specs.evaluate(!block)
   !!aslSpec.specifications.dText = !dText
   !!aslSpec.specifications.rText = !rText
   !!aslSpec.specifications.val   = 1

   call !!specLoad(!!aslSpec.specData, 'AUTO',  false )
   call !!specLoad(!!aslSpec.specData, 'SPEC',  !!aslSpec.specifications.selection().dbRef() )
   call !!specLoad(!!aslSpec.specData, 'SPCO',  object DBREF() )
   call !!specLoad(!!aslSpec.specData, 'REF',   object DBREF() )
   call !!specLoad(!!aslSpec.specData, 'STANDARD',  true )
   call !!specLoad(!!aslSpec.specData, 'ACTION', '!!aslSpecCriteria()' )

-- Re-load specification
   call !!specSetUp(!!aslSpec.specData)

endfunction
-- End of function definition for !!aslSpecLoad
