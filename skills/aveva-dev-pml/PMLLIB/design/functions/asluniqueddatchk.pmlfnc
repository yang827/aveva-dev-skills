--
--
-- Description:
-- Sort unique instances of two arrays of DDAT references
-- based on there dkeys.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [RW]   [Array]     [First array of references]
--   [2] [R]    [Array]     [Second array of references]
-- Return:
--   [Data Type] [Description]
--   [Array]     [Via Argument list]
--
------------------------------------------------------------------------

-- Define function
define function !!aslUniqueDdatChk(!master is ARRAY, !array is ARRAY)

-- Evaluate dkey for both arrays

   !dKeyExtract  = object BLOCK('!master[!evalIndex].dKey')
   !dKeyOfMaster = !master.evaluate(!dKeyExtract)

   !dKeyExtract = object BLOCK('!array[!evalIndex].dKey')
   !dKeyOfArray = !array.evaluate(!dKeyExtract)

-- Check the DDAT's Dkey of the second array is not in the first

   do !ind indices !array
    if(!dKeyOfMaster.findFirst(!dKeyOfArray[!ind]).unset()) then
       !master.append(!array[!ind])
    endif
   enddo


endfunction
-- End of function definition for !!aslUniqueDdatChk
