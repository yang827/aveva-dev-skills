--
-- Description:
-- Function to lock to selected WP for datm positioning
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aslWpLock(!gadgetPressed is GADGET, !whichWP is STRING)

-------------------------------------------------------------------------
-- If the Toggle is depressed (TRUE) then set gadgets to grey out (FALSE)
-------------------------------------------------------------------------

if(!gadgetPressed.val) then
   !trueOrFalse = False
else
   !trueOrFalse = True
endif

------------------------------------------------------------
-- Grey out all gadgets relating to the !whichWP to lock it
------------------------------------------------------------

if(!whichWP eq 'First') then
   !!aslSpec.xO.active = !trueOrFalse
   !!aslSpec.yO.active = !trueOrFalse
   !!aslSpec.zO.active = !trueOrFalse
   !!aslSpec.x.active  = !trueOrFalse
   !!aslSpec.y.active  = !trueOrFalse
   !!aslSpec.z.active  = !trueOrFalse
elseif(!whichWP eq 'Second') then
   !!aslSpec.xO1.active = !trueOrFalse
   !!aslSpec.yO1.active = !trueOrFalse
   !!aslSpec.zO1.active = !trueOrFalse
   !!aslSpec.x1.active  = !trueOrFalse
   !!aslSpec.y1.active  = !trueOrFalse
   !!aslSpec.z1.active  = !trueOrFalse
endif

endfunction
-- End of function definition for !!aslWpLock
