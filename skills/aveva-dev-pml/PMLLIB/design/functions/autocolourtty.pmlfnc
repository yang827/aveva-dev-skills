--   Type:          Function Definition
--   Group:         Design
--   Keyword:     Drawing
--   Module:        Design
--   Replaces:
--
-- Author:          James Field
-- Created:         9 July 2008
--
--
-- Description:
-- Load 3D autoColours for TTY - called by review from C#
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!autocolourtty()

  AUTOCOLOUR ON

  -- Create a temporary global variable to store the data
  if (defined(!!tmpGphColOpt)) then
    !!tmpGphColOpt.delete()
  endif

  -- Set core defaults
  !!tmpGphColOpt = object GPHCOLOPT()
  !!tmpGphColOpt.default(true)
		
  -- Get 3D colour setup file for system and user
  !optionFiles = object ARRAY()
  var !marine evar  'MARINE'
  if(!marine.upcase().eq('YES')) then
    !optionFiles = !!comGetOptFiles('marhdes-col.pmldat')
  else
    !optionFiles = !!comGetOptFiles('des-col.pmldat')
  endif

  -- In marine user options can be defined in outfitting or hull design so
  -- if no user options for hull design see if any for outfitting
  !outfitting = false
  if(!marine.upcase().eq('YES')) then
    if (undefined(!optionFiles[2])) then
	  !userOptionFiles = object ARRAY()
	  !userOptionFiles = !!comGetOptFiles('marodes-col.pmldat')
	  if (defined(!userOptionFiles[2])) then
	    !outfitting = true
	    !optionFiles[2] = !userOptionFiles[2]
	  endif
    endif
  endif

  -- Load element rules
  !!ruleStore = object RULESTORE()
  if(!marine.upcase().eq('YES')) then
    if (!outfitting) then
      !!ruleStore.element.filename = 'marodes-element-rules.pmldat'
    else
      !!ruleStore.element.filename = 'marhdes-element-rules.pmldat'
    endif
  else
    !!ruleStore.element.filename = 'des-element-rules.pmldat'
  endif
  !!ruleStore.element.load()

  -- If a system options file has been found, load the data
  if (defined(!optionFiles[1])) then

    -- load options file
    !localName = !optionFiles[1].fullName()
    $m "$!<localName>"
    handle any
      return
    endhandle
  endif

  -- if a user options file has been found, load the options
  if (defined(!optionFiles[2])) then

    -- load options file
    !localName = !optionFiles[2].fullName()
    $m "$!<localName>"
    handle any
      return
    endhandle
  endif

  AUTOCOLOUR RESET

  do !entry values !!tmpGphColOpt.autoColourRules
    !entry.setAutoColour()
      handle any
        write 'Error in loading the autoColours'
      endhandle
  enddo

  AUTOCOLOUR ON

  REPR HOLES ON

  !!tmpGphColOpt.delete()

endfunction
-- End of function !!autocolourtty
