-- Author:          J.Wyatt
-- Created:         23/10/2009
--
-- Description:
-- Checks for a defaults file that contains alternative headings for cable
-- import/export in design.  If the file exist it loads the alternative
-- headings and returns them as an array.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Whether the headings are required for IMPORT or EXPORT
-- Return:
--   [Data Type] [Description]
--    ARRAY       Original heading names and their corresponding alternatives
--
------------------------------------------------------------------------
define function !!cableHeaderDflts(!importExport is STRING) is ARRAY

  !array = ARRAY()
  -- Load the default file
  !headerListFile = object FILE('%PDMSDFLTS%/CableHeaderRefs.pmldat')
  !rows = !headerListFile.readfile()
  handle (160,9)
    return !array
  endhandle
  do !row values !rows
    -- Ignore any comments
    if !row.substring(1,2).eq('--') then

    elseif (!row.match(',').eq(0) OR !row.trim().match(',').eq(1)) then
  -- LENGTH attribute needs to be different for IMPORT and EXPORT
    elseif !row.split(',')[1].eq('LENGTH') then
      !split = ARRAY()
      if !importExport.eq('IMPORT') then
        !split[1] = ':EstCableLeng'
      elseif !importExport.eq('EXPORT') then
        !split[1] = 'CBTOLE'
      endif
      !split[2] = !row.split(',')[2]
      !array.append(!split)
    else
      !split = !row.split(',')
      !array.append(!split)
    endif
  enddo

  return !array

endfunction
-- end of function definition
