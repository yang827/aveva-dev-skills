-- Created:
--
--
--
-- Description:
--     Set up EDG pick for setting head or tail of Cable Tray Branch
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     REAL         1-Head/ 2-Tail

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!cabtraybranchpickpos(!number is REAL)

      if (!number eq 1) then
    	  !headOrTail = 'Head'
      else
    	  !headOrTail = 'Tail'
      endif

     !packet = object EDGPACKET()
     !packet.definePosition('Pick ' & !headOrTail  & ' position')
     !packet.description = 'cableTrayPosition'
     !packet.priority    = 2
     !packet.remove      = true
     !packet.action = '!!cabtraybranchsetpos(!this.return[1].position.wrt(worl))'
     !!edgCntrl.add(!packet)

endfunction
