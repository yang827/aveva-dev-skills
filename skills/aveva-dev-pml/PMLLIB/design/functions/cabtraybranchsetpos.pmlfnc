--
--
--
-- Description:
--     Set up position on gadgets representing position on CDCTBRAT form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     POSITION     Position which will be set on !!CDCTBRAT form

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!cabtraybranchsetpos(!position is POSITION)


  !!cdctbrat.ewopt.val = 1
  !!cdctbrat.ewpos.val = !position.wrt(!!ce.owner.owner).east.string(!!distancefmt)
  !!cdctbrat.nsopt.val = 1
  !!cdctbrat.nspos.val = !position.wrt(!!ce.owner.owner).north.string(!!distancefmt)
  !!cdctbrat.udopt.val = 1
  !!cdctbrat.udpos.val = !position.wrt(!!ce.owner.owner).up.string(!!distancefmt)

  !!edgcntrl.remove('cableTrayPosition')



endfunction
