--
-- File:          cblFillLevelCheckOnCable.pmlfnc
-- Type:          Function Definition
-- Group:         Cabling Application
-- Keyword:
-- Module:        design
-- Replaces:
-- Author:
-- Created:
--
-- Description:   Check the fill level of  a cable along its route.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF       Cable element
-- Return:
--   [Data Type] [Description]
--    ARRAY       of DBREF of elements where fill level is exceeded by this cable
------------------------------------------------------------------------

define function !!cblFillLevelCheckOnCable(!element is DBREF) is ARRAY

  if (!element.type.neq('CABLE') ) then
    return object ARRAY()
  endif

  !fillLevelExceeded           = object ARRAY()
  -- get list of branches associated with this cable
  !cableWayBranches            = !element.cwlist
  handle (2,202)(2,201)(127,8)
    -- cable element has no path
    return object ARRAY()
  endhandle

  -- check current fill level against maximum fill level for each branch
  do !cwbran values !cableWayBranches
    if (!cwbran.maxFil lt !cwbran.fLevel ) then
      !fillLevelExceeded.append(!cwbran)
    endif
  enddo

  -- get list of RNODE elements associated with this cable
  !rNodesList = !element.cbrnls

  do !rnode values !rNodesList
    if (!rnode.owner.owner.maxFil lt !rnode.fLevel ) then
      !fillLevelExceeded.append(!rnode)
    endif
  enddo

  -- get list of POINTR elements on this cable route
  !pointRList    = !element.cbpref
  handle (2,202)
    !pointRList  = object ARRAY()
  endhandle

  do !pointr values !pointRList
    if (!pointr.owner.owner.type.eq('CWBRAN'))then
        if (!pointr.owner.owner.maxFil lt !pointr.fLevel ) then
          !fillLevelExceeded.append(!pointr)
        endif
     endif
  enddo
  return  !fillLevelExceeded

endfunction
-- End of function definition for !!cblFillLevelCheckOnCable
