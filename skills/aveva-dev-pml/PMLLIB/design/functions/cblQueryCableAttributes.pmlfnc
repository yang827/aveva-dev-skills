--
--
--
-- Description:
--    Query Cable Attributes
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Cabling DB Element


-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!cblQueryCableAttributes(!cable is DBREF)
    !temp = !!ce

    $!cable
    WRITE |------------------------------------------------------|
    WRITE |   ! ! ! ! ! ! Query Cable Attributes ! ! ! ! ! !     |
    WRITE |------------------------------------------------------|
    WRITE |FLNM - Full name of the element|
    QUERY FLNM
    WRITE |CBSTA - Cable routing status|
    QUERY CBSTA
    WRITE |CBPREF - References to POINTR forming route of a cable|
    QUERY CBPREF
    WRITE |CBRNLS - List of route nodes that cable passes|
    QUERY CBRNLS
    WRITE |CBRRLS - List of route nodes and route attachments that cable passes|
    QUERY CBRRLS
    WRITE |CWLIST - Get all cableways that cable passes|
    QUERY cwlist
    WRITE |CBTOLE - Total Length of Cable|
    QUERY VAR !cable.cbtole.string('D2')
    WRITE |CBGELE - Geometric Length of cable|
    QUERY VAR !cable.cbgele.string('D2')
    WRITE |CBRWGL - Raw Geometric Length of cable|
    QUERY VAR !cable.cbrwgl.string('D2')
    WRITE |CBFRLE - Free Length of cable|
		!tempRealValues = object ARRAY()
    !tempRealValues = !cable.cbfrle
    handle ANY
    endhandle
    do !tempRealValue values !tempRealValues
     QUERY VAR !tempRealValue.string('D2')
    enddo
-- Following one produced output with refs
--   check !cable
   !eleCollection = object COLLECTION()
   !eleCollection.scope(!cable)
   !eleCollection.type('POINTR')
   !eleCollection.addtype('EXTGEO')
   !pointExtgeo= !eleCollection.results()
   WRITE |Number of elements under RPATH|
   QUERY VAR !pointExtgeo.size()
   !distancesFromHead = ARRAY()

   do !myElement values !pointExtgeo
      !distancesFromHead.append(!myElement.distfh[1])
   enddo

   !index =  !distancesFromHead.sortedIndices()

   !sortedPointExtgeo = ARRAY()
   do !indices values !index
    !sortedPointExtgeo.append(!pointExtgeo[!indices])
   enddo
   WRITE |------------------------------------------------------|
   WRITE |List of all elements under RPATH and their distances from head |
   WRITE |------------------------------------------------------|
   do !myElementTwo values !sortedPointExtgeo
    QUERY VAR !myElementTwo.type
      if (!myElementTwo.type eq 'EXTGEO' ) then
        QUERY VAR !myElementTwo.distfh[1].string('D2')
        QUERY VAR !myElementTwo.distfh[2].string('D2')
      else
        QUERY VAR !myElementTwo.distfh[1].string('D2')
      endif
    enddo
  !temp
endfunction
