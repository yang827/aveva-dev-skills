define function !!cblRouteCable(!cable is DBREF, !graph is MDRCONNECTIONGRAPH, !zone is ARRAY) is BOOLEAN

       !rt = object MDRROUTER()
       !m  = object MDRBASEMANAGER()
       !cm = object CABLEMANAGER()
       !unusedConnectionManager = object MDRCONNECTIONMANAGER()
       --!connectionManager = object MDRCONNECTIONMANAGER()
       !cm.unRouteCable(!cable)
       if(!cable.staref.set() and !cable.endref.set())then
         !start = !cable.staref.worpos
         !end   = !cable.endref.worpos
       else
         !!alert.message('Cable $!cable.flnn is not Connected.')
         !cable.cbsta = 2
         return
       endif

       !cm.setConnectionsGraph(!graph)
       !routes = !!mdrCreateRoutesArray(!zone)
       !rps = !!mdrFilterOutRoutePoints(!rt.findNearestRoutePointsOnRoutesArray(!m.createRoutePoint(!start), !routes))
       if(!rps.unset())then
       	 !!alert.message('Cableway does not have attachment point for routing')
         !cable.cbsta = 2
       	 return false
       endif
       !rp1 = !rps[1]

       !rps = !!mdrFilterOutRoutePoints(!rt.findNearestRoutePointsOnRoutesArray(!m.createRoutePoint(!end), !routes))
       !rp2 = !rps[1]

       !route1 = !rt.generateFreeRoute(!m.createRoutePoint(!start), !rp1, !rp1.owningRoute())
       !route2 = !rt.generateFreeRoute(!m.createRoutePoint(!end), !rp2, !rp2.owningRoute())

       !connPoints = !cm.findRoute(!cable, !rp1, !rp2)


       if ( not !cm.routeCable(!cable, !connPoints) ) then
         !cable.cbsta = 2
          return false
       endif


       !route = !m.createRoute(!cable)
       !route.insertRouteAtHead(!route1)
       !route.insertRouteAtTail(!route2.reversed())
       !route.dbUpdate()
       return true
endfunction
