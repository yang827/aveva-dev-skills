define function !!cblRouteCablePRP(!cable is DBREF, !start is MDRROUTEPOINT,  !end is MDRROUTEPOINT, !prps is ARRAY, !graph is MDRCONNECTIONGRAPH) is BOOLEAN
       !cm = object CABLEMANAGER()
       !cm.unrouteCable(!cable)
       !cm.setConnectionsGraph(!graph)
       !connPoints = !cm.findRoutePRP(!cable, !start, !end, !prps)
       return !cm.routeCable(!cable, !connPoints)
endfunction
