--
-- File:            cblautoname.pmlfnc
--   Type:          Function Definition
--   Group:         Cabling Application
--
--     Keyword:
--   Module:        design
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:
--
--
--
-- Description:
--    Get the autoname
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Element Type


-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!cblautoname(!type is STRING, !owner is DBREF) is STRING

    !flag = FALSE
    !elements = object ARRAY()
    !ce   = !!ce
    !coll = object COLLECTION()
    !coll.type(!type)
    !coll.scope(!owner)
    !express  = object EXPRESSION('NAME neq FULLNAME')
    !coll.filter(!express)

-- Zone with no cways,cables,Rnodes
    if !coll.results().empty() then
      -- Navigate to where we can create the element
      !!ce = !owner
      if !type.eq('RNODE') then
      	new RTFEAT
      endif
      new $!type
      handle ANY
        return ''
      endhandle
      !elements.append(!!ce)
      !flag = true
    else
      !elements = !coll.results()
    endif

    do !i indices !elements
      -- temporarily set the purpose to CABL. This is in case the naming is
      -- dependent on purpose
      if !type.eq('ZONE') then
        !cablePurpose = 'CABL'
        !purp = !elements[!i].purpose
        !elements[!i].purpose = !cablePurpose
      endif
      !name = !!namOpt.nameString(!elements[!i], '', false, false)
      if !type.eq('ZONE') then
       !elements[!i].purpose = !purp
      endif
    enddo


  if !flag then
  	if !type.eq('RNODE') then
      RTFEAT
      delete RTFEAT
      handle (41,229)
      endhandle
    else
    delete $!type
    handle (41,229)
    endhandle
  endif
  endif
  !!ce = !ce
	
	if (!name.unset() ) then
		!name = ''
	endif 	
	
  return !name


endfunction
