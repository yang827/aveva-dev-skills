--
--
-- Description:
-- Check connections integrity.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      DBREF       Element to be checked
-- Return:
--   [Data Type] [Description]
--    BOOLEAN Return true if branches are connected; false isn't
--
------------------------------------------------------------------------

-- Define function
define function !!cblconnectioncheck (!firstElement is DBREF, !secondElement is DBREF) is BOOLEAN
  !branches = !firstElement.conbra
  !check = !branches.findfirst(!secondElement)
  if (!check.unset() ) then
    return false
  endif
  return true
endfunction
-- End of function definition for !!cblconnectioncheck
