--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Element Type


-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!cbldisconnectbranches()

  !cwayObject = object CABLEWAY()
  -- make a global instance of cableway object
  !!cableway  = !cwayObject
  !cwayObject.pick('DISCONNECT')

endfunction
