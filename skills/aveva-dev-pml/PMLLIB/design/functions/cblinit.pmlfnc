--
-- File:            cblinit.pmlfnc
--   Type:          Function Definition
--   Group:         Cabling Application
--
--     Keyword:     INIT
--   Module:        design
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:
--
--
--
-- Description:
--    Initialise the cabling forms
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Task - Create or modify
--    2   R     STRING       Cabling DB Element
--    3   R     STRING         Form to be shown

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!cblinit(!task is STRING,!element is STRING,!form is STRING)
	!bool = FALSE
if (!task.upcase().eq('CREATE') and !element.upcase().eq('CABLE')) then
--check if the Cabling System Licence is Valid
  !obj = object MDRLICENCEMANAGER()
	!licenceError= !obj.getLicence('CABLES')
	!error = !obj.lastError()
 if (!licenceError  eq 1) then
   !!alert.warning('CABLE-DESIGN licence will expire at midnight.')
  elseif (!licenceError  gt 1) then
   !!alert.warning('CABLE-DESIGN licence will expire after ' & !licenceError  & ' midnights have passed.')
  elseif (!licenceError LT 0) then
--Alert the user of invalid licence/seat
	!!alert.error('$!error')
		-- raise a flag
		!bool = TRUE
endif
endif
if (!bool) then
	return
else
    -- see if cabling application is loaded
    if undefined(!!cbldflts) then
     !!alert.error('Cabling application not loaded correctly')
     return
    endif

    if !form.lowcase().eq('!!cblcway') then
     !dfltZone = !!cbldflts.cwayzonedefault
      if !dfltZone.set() and !task.upcase().eq('CREATE') and !element.upcase().eq('CWAY')then
        !!ce = !dfltZone
      elseif !dfltZone.unset() and !task.upcase().eq('CREATE')then
       if !!ce.type.eq('WORL') or !!ce.type.eq('SITE')then
         !!alert.error('Cannot create below ' & !!ce.type & '. Navigate to correct hierarchy')
         return
       endif
      endif

     if !task.upcase().eq('MODIFY') then

        $!element
        handle ANY
          -- see if we can navigate to cwbran
          CWBRAN
          handle ANY
          !!alert.error('Not able to navigate to $!element from current position. Navigate to the branch')
           return
          endhandle

            if !element.upcase().eq('POINTR') then
              pointr 1 of rpath 1 of ce
              handle ANY
                !!alert.error('No route points created for this branch')
                return
              endhandle
            endif

            if !element.upcase().eq('RNODE') then
              rnode 1 of rtfeat 1 of ce
              handle ANY
                !!alert.error('No route nodes created for this branch')
                return
              endhandle
            endif

            if !element.upcase().eq('RATTA') then
              ratta 1 of conseq 1 of ce
              handle ANY
                !!alert.error('No route attachment points created for this branch')
                return
              endhandle
            endif
        endhandle

     endif


     if !task.upcase().eq('CREATE') then
       !ce = !!ce
       if !element.eq('CWAY') then
          !own = 'ZONE'
       elseif  !element.eq('CABLE') then
          !own = 'ZONE'
       elseif !element.eq('CWBRAN') then
          !own = 'CWAY'
       else
          !own = 'CWBRAN'
       endif
       $!own
        handle ANY
         !!alert.error('Cannot Create $!element at the current position in hierarchy')
         return
        endhandle
       !!ce = !ce
     endif

     if undefined(!!cblcway) then
       pml load form !!cblcway
     endif

     if !task.upcase().eq('MODIFY') then
      !!cblcway.currentElement()
     else
      !!cblcway.setTask(!task, !element)
     endif
       show !!cblcway
    endif

    if !form.lowcase().eq('!!cblmtrl') then
        !mattask = !task
        if !task.upcase().eq('CREATE') then
          if !element.upcase().eq('CTMTRL') then
           !ce = !!ce
           --navigate to CWBRAN
           CWBRAN
           handle ANY
            !!alert.error('Cannot create $!element at the current position in the hierarchy')
            return
           elsehandle NONE
           	!cwbran  = !!ce
            --see if material already exists
            CTMTRL 1
            handle ANY
            elsehandle NONE
              !!alert.warning('CTMTRL already exists for this branch')
              !mattask = 'MODIFY'
              --return
            endhandle
           endhandle
           if !mattask.neq('MODIFY') then
            !!ce = !ce
           endif
           !type = 'CTMTRL'
          endif

          if !element.upcase().eq('COMPONENTS') then
            !ce = !!ce
            --navigate to CTMTRL
            CTMTRL
            handle ANY
              --see if we can navigate to branch'
              CWBRAN
              handle ANY
                !!alert.error('Cannot create material elements at the current position in the hierarchy')
                return
              elsehandle NONE
              	!cwbran  = !!ce
                CTMTRL 1
                handle ANY
                 !!alert.error('No CTMTRL exists for the current branch')
                 return
                endhandle
              endhandle
            elsehandle NONE
            	!cwbran  = !!ce.owner
              !!ce = !ce
            endhandle
            !type = 'CTSTRA'
          endif
        endif


        if !task.upcase().eq('MODIFY') then

          if !element.upcase().eq('CTMTRL') then
            CTMTRL
           handle ANY
            --try to navigate to branch
            CWBRAN
            handle ANY
            !!alert.error('Not able to navigate to CTMTRL from current position')
            return
            elsehandle NONE
            !cwbran  = !!ce
            CTMTRL 1
             handle ANY
             !!alert.error('No CTMTRL created for current branch')
             return
             endhandle
            endhandle
           elsehandle NONE
           	 !cwbran  = !!ce.owner
           endhandle

          !type = 'CTMTRL'
        else
          !material = object ARRAY()
          !material.append('CTSTRA')
          !material.append('CTTEE')
          !material.append('CTREDU')
          !material.append('CTBEND')
          !material.append('CTRISE')
          !material.append('CTCROS')

          do !i from 1 to !material.size()
            --navigate
            $!material[$!i]
            handle ANY
              if !i.eq(!material.size()) then
                !!alert.error('Cannot navigate to material element')
                return
              endif
            elsehandle NONE
            	!cwbran = !!ce.owner.owner
              !type = !!ce.type
              break
            endhandle
          enddo
        endif
       endif

       if(defined (!cwbran))then
       	 if(!cwbran.hpos.eq(!cwbran.tpos))then
       	 	 !!alert.warning('Head and Tail Position of the Cable Way branch are same.Can not Dress for branch which has zero length.')
       	 	 return
       	 endif
       endif

        show !!cblmtrl
       !!cblmtrl.setTask(!mattask, !type)
      --if !task.upcase().eq('MODIFY') then
      -- !!cblmtrl.currentElement()
      --endif
    endif

    if !form.lowcase().eq('!!cblcwaycopy') then
      if !!ce.type.eq('CWBRAN') or !!ce.type.eq('CWAY') or !!ce.type.eq('ZONE') then
        show !!cblcwaycopy
      else
        -- try to navigate to CWBRAN
        CWBRAN
        handle ANY
          !!alert.error('You must be at CWAY zone or below to copy a CWAY element')
        elsehandle NONE
         show !!cblcwaycopy
        endhandle
      endif
    endif

    if !form.lowcase().eq('!!cblcablecopy') then
      if (!!ce.type neq 'CABLE' and !!dtbFindOwnerOfType(!!ce, 'CABLE', false).unset()) then
        !!alert.error('Navigate to CABLE Element and try again.')
      elseif (!!ce.dbWrite.not()) then
        !!alert.error('Cannot copy cable: Read only database')
      elseif (!!ce.owner.modAtt.attribute('members').not() ) then
        !!alert.error('Cannot copy cable: You do not have access rights to copy a cable here')
      else
        show !!cblcablecopy
      endif
    endif

    if !form.lowcase().eq('!!cblcable') then
      !dfltZone = !!cbldflts.cablezonedefault
      if (!dfltZone.set() and !task.upcase().eq('CREATE') and !element.upcase().eq('CABLE')) then
       !!ce = !dfltZone
      elseif(!dfltZone.unset() and !task.upcase().eq('CREATE'))then
        if !!ce.type.eq('WORL') or !!ce.type.eq('SITE')then
          !!alert.error('Cannot create below ' & !!ce.type & '. Navigate to correct hierarchy')
          return
        endif
      endif

      if undefined(!!cblcable) then
        pml load form !!cblcable
      endif

      if !task.upcase().eq('MODIFY') then
        --!!cblcable.currentElement()
        if(!!ce.type.eq('CABLE'))then
          !!cblcable.setTask(!task, 'CABLE')
        else
          CABLE
          handle ANY
            !!alert.error('You must be at CABLE or below to modify CABLE')
            return
          endhandle

          !!cblcable.setTask(!task, 'CABLE')
        endif
      else
       !!cblcable.setTask(!task, !element)
      endif
      show !!cblcable
    endif

    if !form.lowcase().eq('!!cblcnode') then
      if undefined(!!cblcnode) then
        pml load form !!cblcnode
      endif
      -- try to navigate to ZONE or CNODE
        !ce = !!ce
        if !task.upcase().eq('MODIFY') then
        	CNODE
        	handle ANY
           !!alert.error('Navigate to a CNODE and modify')
            return
          elsehandle NONE
         	 !!cblcnode.setTask(!task,'CNODE')
           show !!cblcnode
         endhandle
        else
         ZONE
         handle ANY
           !!alert.error('You must be at ZONE or below to perform this action')
           return
         elsehandle NONE
         	!!ce = !ce
         	!!cblcnode.setTask(!task,'CNODE')
           show !!cblcnode
         endhandle
        endif

    endif

    if !form.lowcase().eq('!!cblmodtmpl') then
      if undefined(!!cblmodtmpl) then
        pml load form !!cblmodtmpl
      endif
      !!cblmodtmpl.init()
    endif

    if !form.lowcase().eq('!!cbldflts') then
      if undefined(!!cbldflts) then
      pml load form !!cbldflts
      endif
      show !!cbldflts
    endif

endif
endfunction
