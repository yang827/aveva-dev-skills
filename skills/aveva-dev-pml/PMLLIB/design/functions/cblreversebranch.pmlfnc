--   Type:          Function Definition
--   Group:         Cabling Application
--
--     Keyword:
--   Module:        design
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:         21st July 2008
--
--
--
-- Description:
--    Reverse the branch order
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!cblreversebranch()

 --store current element
 !dbElement  = !!ce

 --navigate to branch
 CWBRAN
 handle ANY
 	!!alert.error('Not able to navigate to branch') 	
 	return
 endhandle

 -- see if branch is dressed
 CTMTRL 1
 handle ANY
 elsehandle NONE
 	!mem = !!ce.members
 	if !mem.set() then
 	 !!alert.error('Cannot reverse a dressed branch')
 	 !!ce = !dbElement
 	 return
 	else
 	 CWBRAN
 	endif	
 endhandle

 -- put in forwards mode
 var !mode mode
 FORWARDS

 !cwaymanager = object CABLEWAYMANAGER()
 !bran = !!ce

 -- head and tail references
 !hdconn = !!ce.hdconn
 !tlconn = !!ce.tlconn

 --reset  array
 !resetElements  = object ARRAY()
 !resetPoints    = object ARRAY()
 !resetZdis      = object ARRAY()

 -- collect all points
 !col = object COLLECTION()
 !col.scope(!bran)
 !col.type('POINTR')
 !points = !col.results()
 !size   = !points.size()

 -- elements that refer to point
 !elements = object ARRAY()
 !elements.append('RNODE')
 !elements.append('RATTA')

 -- collect elements
 !elementCol = object COLLECTION()
 !elementCol.types(!elements)
 !elementCol.scope(!bran)
 !branElements = !elementCol.results()

 -- put the elements to reset array

 do !item values  !branElements
  !resetElements.append(!item)
  -- new posref
  !posref  = !item.posref
  !newPosrefNum = !size - !item.posref.tysequence

  if !item.posref.tysequence.eq(1) or !item.posref.tysequence.eq(!size) then
  	if !item.distfp.neq(0) then
      !newPosrefNum = !size - !item.posref.tysequence
    else
      !newPosrefNum = !size + 1 - !item.posref.tysequence
    endif
  endif


  !resetPoints.append(!newPosrefNum)
  !distfp = !item.distfp
  if !distfp.eq(0) then
  	!resetZdis.append(0)
    skip
  endif

  -- get the length of segment
  !firstPos = !item.posref.position.wrt(/* )
  !secondPos = pos of next POINTR of $!posref wrt /*
  handle ANY
  	-- this is last POINTR
  	!resetZdis.append(0)
  	skip
  endhandle
  !line = object LINE(!firstPos,!secondPos)
  !length = !line.length()
  !newZdis = !length - !distfp
  !resetZdis.append(!newZdis)
 enddo

 --disconnect branches

  !cwaymanager.disconnecthead(!bran)
  !cwaymanager.disconnecttail(!bran)


 !rpath = rpath 1 of $!bran
 !!ce = !rpath

 --reverse
 $m "%PDMSUI%/CLIB/FILES/MREOREV"

 -- set the correct references
 do !i from 1 to !resetElements.size()
  !!ce = !resetElements[!i]
  !posref = POINTR $!resetPoints[$!i] of $!rpath
  !!ce.posref = !posref
  !!ce.pkdis = 0
  !!ce.zdistance = !resetZdis[!i]
 enddo

 -- reset mode
 $!mode


 -- connect branches
 do !tail values !hdconn
  if !tail.type.eq('HATTA') or !tail.type.eq('TATTA') then
    !tail = !tail.owner
  elseif !tail.type.eq('RATTA') then
    !tail = !tail.owner.owner
  endif
  !cwaymanager.connectbranches(!bran, !tail)
 enddo
 do !head values !tlconn
  if !head.type.eq('HATTA') or !head.type.eq('TATTA') then
    !head = !head.owner
  elseif !head.type.eq('RATTA')then
    !head = !head.owner.owner
  endif
  !cwaymanager.connectbranches(!bran, !head)
 enddo

 --navigate to original element
 !!ce = !dbElement

endfunction
