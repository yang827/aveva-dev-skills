--   Module:        design
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:         Mon May 05 2008
--
-- Description:
--    Get the main dimensions of tray
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Element Type


-- Return:
--   [Data Type] [Description]
--    ARRAY       array of relevant attributes for preliminary dressing
------------------------------------------------------------------------

define function !!cbltraydimensions(!appdata is DBREF, !type is STRING) is ARRAY

  !dimensions   = object ARRAY()
  !col = object COLLECTION()
  !col.scope(!appdata)
  !col.type(!type)

  do !item values !col.results()
    !data = object ARRAY()
    if !type.upcase().eq('CTSTRA') then
      !data.append(!item.trayw)
      !data.append(!item.olength)
      !data.append(!item.trayh)
    elseif !type.upcase().eq('CTREDU') then
    	if !item.cttype.eq('RIGH')then
    	  !data.append(0)
    	elseif !item.cttype.eq('LEFT')then
    		!data.append(1)
    	else
    	  !data.append(2)
    	endif
      !data.append(!item.trayw)
      !data.append(!item.trayrw)
      !data.append(!item.olength)
      !data.append(!item.trayh)
    elseif !type.upcase().eq('CTBEND') then
    	if !item.cttype.eq('RIGH')then
    	  !data.append(0)
    	else
    	  !data.append(1)
    	endif
      !data.append(!item.angle)
      !data.append(!item.trayw)
      !data.append(!item.alength)
      !data.append(!item.llength)
      !data.append(!item.trayh)
    elseif !type.upcase().eq('CTTEE') then
    	if !item.cttype.eq('RIGH')then
    	  !data.append(0)
    	else
    	  !data.append(1)
    	endif
      !data.append(!item.angle)
      !data.append(!item.trayw)
      !data.append(!item.traysw)
      !data.append(!item.alength)
      !data.append(!item.llength)
      !data.append(!item.slength)
      !data.append(!item.trayh)
    elseif !type.upcase().eq('CTCROS') then
      !data.append(!item.trayw)
      !data.append(!item.traysw)
      !data.append(!item.trayow)
      !data.append(!item.alength)
      !data.append(!item.llength)
      !data.append(!item.slength)
      !data.append(!item.sslength)
      !data.append(!item.trayh)
    elseif !type.upcase().eq('CTRISE') then
      if !item.cttype.eq('INSI') then
      	!data.append(1)
      else
        !data.append(0)
      endif
      !data.append(!item.angle)
      !data.append(!item.trayw)
      !data.append(!item.alength)
      !data.append(!item.llength)
      !data.append(!item.trayh)
    endif
    !dimensions.append(!data)
  enddo
   return !dimensions
