--   Type:          Function Definition
--   Group:         Cabling Application
--
--     Keyword:
--   Module:        design
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:         Mon May 05 2008
--
-- Description:
--    Get the main dimensions of tray
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Element Type


-- Return:
--   [Data Type] [Description]
--    BOOLEAN       returns true if dimensions are loaded
------------------------------------------------------------------------

define function !!cbltraydimfromfile(!trayObject is CABLETRAYMANAGER) is BOOLEAN


-- initialise input file name
  !folderUser        = object FILE('%PDMSUSER%')
  !homeDirectory  = !folderUser.directory()

-- Use new std browser and check for file browser already loaded
  Import 'pmlfilebrowser'
    handle (1000,0)
    endhandle

-- If previous used use last used directory
  if (defined(!!saveTrayData )) then
     !homeDirectory = !!saveTrayData.directory()
  endif

  using namespace 'Aveva.Pdms.Presentation'
  !fileBrowser = object PMLFILEBROWSER('OPEN')
  !fileBrowser.show(!homeDirectory.string(), '', 'Load Dimensions', false, 'csv files (*.csv)|*.csv', 1)
  !file = !fileBrowser.file()

-- abandon if form browser cancelled
  if( !file.empty() ) then
    return FALSE
  endif

-- Remember location of directory and filename if previously run in session.

  !!saveTrayData    = object FILE()
  !!saveTrayData    = object FILE('$!file')

 -- create arrays for each type of Element
 !bendArray = object ARRAY()
 !straArray = object ARRAY()
 !reduArray = object ARRAY()
 !teeArray  = object ARRAY()
 !crosArray = object ARRAY()
 !riseArray = object ARRAY()

 -- reset all values

  !trayObject.readdefaultdimforctbend(!bendArray)
  !trayObject.readdefaultdimforctstra(!straArray)
  !trayObject.readdefaultdimforctredu(!reduArray)
  !trayObject.readdefaultdimforcttee(!teeArray)
  !trayObject.readdefaultdimforctrise(!riseArray)
  !trayObject.readdefaultdimforctcros(!crosArray)

 -- read the FILE
 !dataFile = object FILE(!file)
 !lines = !dataFile.readfile()

 do !line values !lines
   !data = object ARRAY()
   !lineSplit = !line.split(',')
   if !lineSplit[1].upcase().eq('CTSTRA') then
     !data.append(!lineSplit[2].real())
     !data.append(!lineSplit[3].real())
     !data.append(!lineSplit[4].real())
     --see if any data is unset
     do !val values !data
       if !val.unset() then
         !!alert.error('Data not correct for CTSTRA')
         return FALSE
       endif
     enddo
     !straArray.append(!data)
   elseif !lineSplit[1].upcase().eq('CTREDU') then
   	 !data.append(!lineSplit[2].real())
     !data.append(!lineSplit[3].real())
     !data.append(!lineSplit[4].real())
     !data.append(!lineSplit[5].real())
     !data.append(!lineSplit[6].real())
      --see if any data is unset
     do !val values !data
       if !val.unset() then
         !!alert.error('Data not correct for CTREDU')
         return FALSE
       endif
     enddo
     !reduArray.append(!data)
   elseif !lineSplit[1].upcase().eq('CTBEND') then
     !data.append(!lineSplit[2].real())
     !data.append(!lineSplit[3].real())
     !data.append(!lineSplit[4].real())
     !data.append(!lineSplit[5].real())
     !data.append(!lineSplit[6].real())
     !data.append(!lineSplit[7].real())
      --see if any data is unset
     do !val values !data
       if !val.unset() then
         !!alert.error('Data not correct for CTBEND')
         return FALSE
       endif
     enddo
     !bendArray.append(!data)
   elseif !lineSplit[1].upcase().eq('CTTEE') then
     !data.append(!lineSplit[2].real())
     !data.append(!lineSplit[3].real())
     !data.append(!lineSplit[4].real())
     !data.append(!lineSplit[5].real())
     !data.append(!lineSplit[6].real())
     !data.append(!lineSplit[7].real())
     !data.append(!lineSplit[8].real())
     !data.append(!lineSplit[9].real())
      --see if any data is unset
     do !val values !data
       if !val.unset() then
         !!alert.error('Data not correct for CTTEE')
         return FALSE
       endif
     enddo
     !teeArray.append(!data)
   elseif !lineSplit[1].upcase().eq('CTCROS') then
     !data.append(!lineSplit[2].real())
     !data.append(!lineSplit[3].real())
     !data.append(!lineSplit[4].real())
     !data.append(!lineSplit[5].real())
     !data.append(!lineSplit[6].real())
     !data.append(!lineSplit[7].real())
     !data.append(!lineSplit[8].real())
     !data.append(!lineSplit[9].real())
      --see if any data is unset
     do !val values !data
       if !val.unset() then
         !!alert.error('Data not correct for CTCROS')
         return FALSE
       endif
     enddo
     !crosArray.append(!data)
   elseif !lineSplit[1].upcase().eq('CTRISE') then
     !data.append(!lineSplit[2].real())
     !data.append(!lineSplit[3].real())
     !data.append(!lineSplit[4].real())
     !data.append(!lineSplit[5].real())
     !data.append(!lineSplit[6].real())
     !data.append(!lineSplit[7].real())
      --see if any data is unset
     do !val values !data
       if !val.unset() then
         !!alert.error('Data not correct for CTRISE')
         return FALSE
       endif
     enddo
     !riseArray.append(!data)
   endif

 enddo

 -- see if any of the arrays are empty
 -- initialise variable for loading. Allow loading if at least one is set
 !load = FALSE

 if !bendArray.unset() then
 	!!alert.warning('No CTBEND values loaded')
 else
  !load = TRUE
 endif
 if !straArray.unset() then
 	!!alert.warning('No CTSTRA values loaded')
 else
  !load = TRUE
 endif
 if !reduArray.unset() then
 	!!alert.warning('No CTREDU values loaded')
 else
  !load = TRUE
 endif
 if !teeArray.unset() then
 	!!alert.warning('No CTTEE values loaded')
 else
  !load = TRUE
 endif
 if !riseArray.unset() then
 	!!alert.warning('No CTRISE values loaded')
 else
  !load = TRUE
 endif
 if !crosArray.unset() then
 	!!alert.warning('No CTCROS values loaded')
 else
  !load = TRUE
 endif

 -- load the object data
 if !load then
  !trayObject.readdefaultdimforctbend(!bendArray)
  !trayObject.readdefaultdimforctstra(!straArray)
  !trayObject.readdefaultdimforctredu(!reduArray)
  !trayObject.readdefaultdimforcttee(!teeArray)
  !trayObject.readdefaultdimforctrise(!riseArray)
  !trayObject.readdefaultdimforctcros(!crosArray)
  return TRUE
 else
  return FALSE
 endif

endfunction
