--
-- File:            cbltraydimfromspec.pmlfnc
--   Type:          Function Definition
--   Group:         Cabling Application
--
--     Keyword:
--   Module:        design
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:         Tue May 06 2008
--
-- Description:
--    Get the main dimensions of tray
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        Reference of TABGRO
--    2   R      STRING       Element Type


-- Return:
--   [Data Type] [Description]
--    ARRAY       returns array of  loaded dimensions
------------------------------------------------------------------------

define function !!cbltraydimfromspec(!tgroup is DBREF, !type is STRING) is ARRAY

  -- create arrays for return
  !returnArray = object ARRAY()

  -- collect tabitem
  !col = object COLLECTION()
  !col.scope(!tgroup)
  !col.type('TABQUE')
  !express = object EXPRESSION('TANSWER EQ |$!type|')
  !col.filter(!express)
  !colResult = !col.results()

  -- loop through and filter the type
  !elementArray = object ARRAY()
  --!boreArray   = object ARRAY()

  do !item values !colResult
   --if !item.tanswer.eq(!type) then
     -- if type is CTSTRA then load only fixed length tubes
      if !type.eq('CTSTRA') then
        !tcol = object COLLECTION()
        !tcol.scope(!item.owner)
        !tcol.type('TABQUE')
        do !ans values !tcol.results()
          if !ans.tquestion.eq('CTTYP') or !ans.purpose.eq('STYP') then
           if !ans.tanswer.eq('F') or !ans.tanswer.eq('FL') then
             !elementArray.append(!item.owner)
            endif
          endif
        enddo
      else
      !elementArray.append(!item.owner)
      endif
   --endif
  enddo

  -- if no fixed length found then load variable length tubes
  if (!elementArray.size()eq 0) then
     do !item values !colResult
     --if !item.tanswer.eq(!type) then
        if !type.eq('CTSTRA') then
          !tcol = object COLLECTION()
          !tcol.scope(!item.owner)
          !tcol.type('TABQUE')
          do !ans values !tcol.results()
            if !ans.tquestion.eq('CTTYP') or !ans.purpose.eq('STYP') then
            if !ans.tanswer.eq('V') or !ans.tanswer.eq('VL') then
               !elementArray.append(!item.owner)
              endif
            endif
          enddo
        else
        !elementArray.append(!item.owner)
        endif
     --endif
    enddo
  endif


 -- now we have an array with tabitems for the type
 -- add the parameters to return array

 do !mat values !elementArray
  !data = object ARRAY()
  if !type.eq('CTSTRA') then
    -- TODO SB (22May08)
    -- This is a get round solution to a crash that occurs if a sparse array is passed to
    -- the core cable tray manager object !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
    -- as in line 3301 of cblMtrl.pmlfrm
    -- I have tried to supply reasonable defaults
    -- It must be noted that a CTABLE may not hold all the answers to these 3 questions
    !data = ARRAY()
    !data[1] = 0
    !data[2] = 0
    !data[3] = 10
    -- End of TODO insert
    !tcol = object COLLECTION()
     !tcol.scope(!mat)
     !tcol.type('TABQUE')
     do !tab values !tcol.results()
       !answer = !tab.tanswer.real()
       handle any
        !answer = 0
       endhandle

      !purp   = !tab.purpose


      if !purp.eq('WIDT') then
        !data[1] = !answer
      elseif !purp.eq('HEIG') then
       !data[3] = !answer
      endif
    enddo
   -- get the default height and length
   !tcol = object COLLECTION()
   !tcol.scope(!mat.owner)
   !tcol.type('TABHQU')
   do !quest values !tcol.results()
    if !quest.tquestion.eq('OLENG') or !quest.purpose.eq('LENG') then
      !data[2] = !quest.tdefault.real()
      handle any
       !data[2] = !quest.default
      endhandle
      if (!data[2].unset()) then
         !data[2] = !quest.default
      endif

    elseif !quest.tquestion.eq('TRAYH') or !quest.purpose.eq('HEIG') then
      !data[3] = !quest.tdefault.real()
      handle any
       !data[3] = !quest.default
      endhandle
      if (!data[3].unset()) then
         !data[3] = !quest.default
      endif

    endif
   enddo
    if !data[3].eq(0) then
      !data[3] = 10
    endif
   !returnArray.append(!data)

  elseif !type.eq('CTREDU') then
    -- TODO SB (22May08)
    -- This is a get round solution to a crash that occurs if a sparse array is passed to
    -- the core cable tray manager object !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
    -- as in line 3301 of cblMtrl.pmlfrm
    -- I have tried to supply reasonable defaults
    -- It must be noted that a CTABLE may not hold all the answers to these 5 questions
    !data = ARRAY()
    !data[1] = 0
    !data[2] = 0
    !data[3] = 0
    !data[4] = 0
    !data[5] = 10
    -- End of TODO insert

    !tcol = object COLLECTION()
     !tcol.scope(!mat)
     !tcol.type('TABQUE')
     do !tab values !tcol.results()
       !answer = !tab.tanswer.real()
       handle any
        !answer = 0
       endhandle
       if (!answer.unset()) then
         !answer = 0
       endif

      !purp   = !tab.purpose


      if !purp.eq('STYP') then
       -- R, L or C
        if (!tab.tanswer.upcase().trim().match('L') eq 1) or (!tab.tanswer.upcase().trim().match('LH') eq 1) then
          !data[1] = 1
        elseif (!tab.tanswer.upcase().trim().match('R') eq 1) or (!tab.tanswer.upcase().trim().match('RH') eq 1) then
          !data[1] = 0
        else
          !data[1] = 2
        endif
      elseif !purp.eq('WIDT') then
        !data[2] = !answer
      elseif !purp.eq('LWID') then
        !data[3] = !answer
      elseif !purp.eq('LENG') then
        !data[4] = !answer
      elseif !purp.eq('HEIG') then
        !data[5] = !answer
      endif
    enddo

    -- get the length
    if !data[4].eq(0) then
      !p1pos = !mat.prtref.catref.ppos[1]
      !p2pos = !mat.prtref.catref.ppos[2]
      !line = object LINE(!p1pos, !p2pos)
      handle ANY
       skip
      endhandle
      !data[4] = !line.length()
    endif

    !returnArray.append(!data)

  elseif !type.eq('CTBEND') then
    -- TODO SB (22May08)
    -- This is a get round solution to a crash that occurs if a sparse array is passed to
    -- the core cable tray manager object !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
    -- as in line 3301 of cblMtrl.pmlfrm
    -- I have tried to supply reasonable defaults
    -- It must be noted that a CTABLE may not hold all the answers to these 6 questions
    !data = ARRAY()
    !data[1] = 0
    !data[2] = 90
    !data[3] = 0
    !data[4] = 0
    !data[5] = 0
    !data[6] = 10
    !data[7] = 0
    -- End of TODO insert

    !tcol = object COLLECTION()
     !tcol.scope(!mat)
     !tcol.type('TABQUE')
     !count = 0
     do !tab values !tcol.results()
       !answer = !tab.tanswer.real()
       handle any
        !answer = 0
       endhandle
       if (!answer.unset()) then
         !answer = 0
       endif

      !purp   = !tab.purpose


      if !purp.eq('STYP') then
       !count = 1
       -- R, L
        if (!tab.tanswer.upcase().trim().match('L') eq 1) or (!tab.tanswer.upcase().trim().match('LH') eq 1) then
         !data[1] = 1
        elseif (!tab.tanswer.upcase().trim().match('R') eq 1) or (!tab.tanswer.upcase().trim().match('RH') eq 1)then
         !data[1] = 0
        else
         !data[1] = 0
         !count = 0
        endif
      elseif  !purp.eq('ANGL') then
        !data[2] = !answer
      elseif !purp.eq('WIDT') then
        !data[3] = !answer
      elseif !purp.eq('RADI') then
        !data[7] = !answer
      elseif !purp.eq('ALEN') then
        !data[4] = !answer
      elseif !purp.eq('LLEN') then
        !data[5] = !answer
      elseif !purp.eq('HEIG') then
        !data[6] = !answer
      endif

    enddo
    -- get the length

    if !data[4].eq(0) or !data[5].eq(0) then
     !p0pos = !mat.prtref.catref.ppos[0]
      !p1pos = !mat.prtref.catref.ppos[1]
      !p2pos = !mat.prtref.catref.ppos[2]
      !line = object LINE(!p0pos, !p1pos)
      handle ANY
       skip
      endhandle
      !data[4] = !line.length()
      !line = object LINE(!p0pos, !p2pos)
      !data[5] = !line.length()
    endif

    !returnArray.append(!data)

     -- If no STYP was specified then we will create a entry for o and 1 L and R
     if (!count eq 0) then
       !data[1] = 1
       !returnArray.append(!data)
       !count = 0
     endif

  elseif !type.eq('CTTEE') then
    -- TODO SB (22May08)
    -- This is a get round solution to a crash that occurs if a sparse array is passed to
    -- the core cable tray manager object !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
    -- as in line 3301 of cblMtrl.pmlfrm
    -- I have tried to supply reasonable defaults
    -- It must be noted that a CTABLE may not hold all the answers to these 8 questions
    !data = ARRAY()
    !data[1] = 0
    !data[2] = 90
    !data[3] = 0
    !data[4] = 0
    !data[5] = 0
    !data[6] = 0
    !data[7] = 0
    !data[8] = 10
    !data[9] = 0
    -- End of TODO insert

    !tcol = object COLLECTION()
     !tcol.scope(!mat)
     !tcol.type('TABQUE')
     !count = 0
     do !tab values !tcol.results()
       !answer = !tab.tanswer.real()
       handle any
        !answer = 0
       endhandle
       if (!answer.unset()) then
         !answer = 0
       endif

      !purp   = !tab.purpose


      if !purp.eq('STYP') then
        !count = 1
       -- R, L
        if (!tab.tanswer.upcase().trim().match('L') eq 1) or (!tab.tanswer.upcase().trim().match('LH') eq 1) then
          !data[1] = 1
        elseif (!tab.tanswer.upcase().trim().match('R') eq 1) or (!tab.tanswer.upcase().trim().match('RH') eq 1) then
          !data[1] = 0
        else
          !data[1] = 0
          !count = 0
        endif
      elseif !purp.eq('ANGL') then
        !data[2] = !answer
      elseif !purp.eq('WIDT') then
        !data[3] = !answer
      elseif !purp.eq('BRWI') then
        !data[4] = !answer
      elseif !purp.eq('RADI') then
        !data[9] = !answer
      elseif !purp.eq('ALEN') then
        !data[5] = !answer
      elseif !purp.eq('LLEN') then
        !data[6] = !answer
      elseif !purp.eq('SLEN') then
        !data[7] = !answer
      elseif !purp.eq('HEIG') then
        !data[8] = !answer
      endif
    enddo

    if !data[5].eq(0) or !data[6].eq(0) or !data[7].eq(0) then
      !p0pos = !mat.prtref.catref.ppos[0]
      !p1pos = !mat.prtref.catref.ppos[1]
      !p2pos = !mat.prtref.catref.ppos[2]
      !p3pos = !mat.prtref.catref.ppos[3]
      !line = object LINE(!p0pos, !p1pos)
      handle ANY
       skip
      endhandle
      !data[5] = !line.length()
      !line = object LINE(!p0pos, !p2pos)
      !data[6] = !line.length()
      !line = object LINE(!p0pos, !p3pos)
      !data[7] = !line.length()
    endif

    !returnArray.append(!data)

     -- If no STYP was specified then we will create a entry for o and 1 L and R
     if (!count eq 0) then
       !data[1] = 1
       !returnArray.append(!data)
       !count = 0
     endif

   elseif !type.eq('CTCROS') then
    -- TODO SB (22May08)
    -- This is a get round solution to a crash that occurs if a sparse array is passed to
    -- the core cable tray manager object !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
    -- as in line 3301 of cblMtrl.pmlfrm
    -- I have tried to supply reasonable defaults
    -- It must be noted that a CTABLE may not hold all the answers to these 8 questions
    !data = ARRAY()
    !data[1] = 0
    !data[2] = 0
    !data[3] = 0
    !data[4] = 0
    !data[5] = 0
    !data[6] = 0
    !data[7] = 0
    !data[8] = 10
    !data[9] = 0
    -- End of TODO insert

    !tcol = object COLLECTION()
     !tcol.scope(!mat)
     !tcol.type('TABQUE')
     !count = 0
     do !tab values !tcol.results()
       !answer = !tab.tanswer.real()
       handle any
        !answer = 0
       endhandle
       if (!answer.unset()) then
         !answer = 0
       endif

      !purp   = !tab.purpose


      if !purp.eq('WIDT') then
        !data[1] = !answer
        !data[2] = !answer
        !data[3] = !answer
      elseif !purp.eq('BRWI') then
        !data[2] = !answer
      elseif !purp.eq('OWID') then
        !data[3] = !answer
      elseif !purp.eq('RADI') then
        !data[9] = !answer
      elseif !purp.eq('ALEN') then
        !data[4] = !answer
      elseif !purp.eq('LLEN') then
        !data[5] = !answer
      elseif !purp.eq('SLEN') then
        !data[6] = !answer
      elseif !purp.eq('SSLE') then
        !data[7] = !answer
      elseif !purp.eq('HEIG') then
        !data[8] = !answer
      endif
    enddo

    -- get the length
    if !data[4].eq(0) or !data[5].eq(0) or !data[6].eq(0) or !data[7].eq(0) then
      !p0pos = !mat.prtref.catref.ppos[0]
      !p1pos = !mat.prtref.catref.ppos[1]
      !p2pos = !mat.prtref.catref.ppos[2]
      !p3pos = !mat.prtref.catref.ppos[3]
      !p4pos = !mat.prtref.catref.ppos[4]
      handle ANY
        !p4pos = !p3pos
      endhandle
      !line = object LINE(!p0pos, !p1pos)
      handle ANY
       skip
      endhandle
      !data[4] = !line.length()
      !line = object LINE(!p0pos, !p2pos)
      !data[5] = !line.length()
      !line = object LINE(!p0pos, !p3pos)
      !data[6] = !line.length()
      !line = object LINE(!p0pos, !p4pos)
      !data[7] = !line.length()
    endif

    !returnArray.append(!data)

  elseif !type.eq('CTRISE') then
    -- TODO SB (22May08)
    -- This is a get round solution to a crash that occurs if a sparse array is passed to
    -- the core cable tray manager object !this.cableway.cwtm.readdefaultdimforctrise(!valueArray)
    -- as in line 3301 of cblMtrl.pmlfrm
    -- I have tried to supply reasonable defaults
    -- It must be noted that a CTABLE may not hold all the answers to these 6 questions
    !data = ARRAY()
    !data[1] = 1
    !data[2] = 90
    !data[3] = 0
    !data[4] = 0
    !data[5] = 0
    !data[6] = 10
    !data[7] = 0
    -- End of TODO insert
    !tcol = object COLLECTION()
     !tcol.scope(!mat)
     !tcol.type('TABQUE')
     do !tab values !tcol.results()
       !answer = !tab.tanswer.real()
       handle any
        !answer = 0
       endhandle
       if (!answer.unset()) then
         !answer = 0
       endif

      !purp   = !tab.purpose


      if !purp.eq('STYP') then
        if !tab.tanswer.eq('IR') then
         !data[1] = 1
        else
         !data[1] = 0
        endif
      elseif  !purp.eq('ANGL') then
        !data[2] = !answer
      elseif !purp.eq('WIDT') then
        !data[3] = !answer
      elseif !purp.eq('RADI') then
        !data[7] = !answer
      elseif !purp.eq('ALEN') then
        !data[4] = !answer
      elseif !purp.eq('LLEN') then
        !data[5] = !answer
      elseif !purp.eq('HEIG') then
        !data[6] = !answer
      endif
    enddo

    if !data[4].eq(0) or !data[5].eq(0) then
      !p0pos = !mat.prtref.catref.ppos[0]
      !p1pos = !mat.prtref.catref.ppos[1]
      !p2pos = !mat.prtref.catref.ppos[2]
      !line = object LINE(!p0pos, !p1pos)
      handle ANY
       skip
      endhandle
      !data[4] = !line.length()
      !line = object LINE(!p0pos, !p2pos)
      !data[5] = !line.length()
    endif

    !returnArray.append(!data)

  endif

 enddo

return !returnArray

endfunction
