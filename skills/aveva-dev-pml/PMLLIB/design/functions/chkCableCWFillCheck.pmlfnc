-- Author:          S.Bentley
-- Created:         Thu May 29 08:00:00 BST 2008
--
--
-- Description:
-- Check Cableway fill levels.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkCableCWFillCheck (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true



  if(!element.flevel.between(-0.1, 0.1)) then
  	enhance $!element colour blue
  	remove CTMTRL 1 of $!element
  	handle ANY
  	endhandle
    !return.messages.append(|Fill level is 0 - Colour Blue|)
    !return.passed = false
  elseif(!element.flevel gt 100) then
  	enhance $!element colour red
  	remove CTMTRL 1 of $!element
  	handle ANY
  	endhandle
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Red|)
    !return.passed = false
  elseif(!element.flevel.between(30, 60)) then
  	enhance $!element colour Green
  	remove CTMTRL 1 of $!element
  	handle ANY
  	endhandle
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Green|)
    !return.passed = false
   elseif(!element.flevel.between(60, 90)) then
  	enhance $!element colour ForestGreen
  	remove CTMTRL 1 of $!element
  	handle ANY
  	endhandle
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour ForestGreen|)
    !return.passed = false
   elseif(!element.flevel.between(90, 100)) then
  	enhance $!element colour Plum
  	remove CTMTRL 1 of $!element
  	handle ANY
  	endhandle
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Plum|)
    !return.passed = true

  else
  	enhance $!element colour Cyan
  	remove CTMTRL 1 of $!element
  	handle ANY
  	endhandle
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Cyan|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkCableCWFillCheck
