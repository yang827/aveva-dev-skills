--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Thu May 29 11:30:00 BST 2008
--
--
-- Description:
-- Check Cable tray fill levels.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkCableTrayFillCheck (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  !type = !element.type
  if(!element.flevel.between(-0.1, 0.1)) then
  	enhance ALL (CTRAY $!type) FOR $!element colour blue
  	enhance ALL with (TYPE OF OWNER eq 'CTFEAT') FOR $!element colour blue
    !return.messages.append(|Fill level is 0 - Colour Blue|)
    !return.passed = false
  elseif(!element.flevel gt 100) then
  	enhance ALL (CTRAY $!type) FOR $!element colour red
  	enhance ALL with (TYPE OF OWNER eq 'CTFEAT') FOR $!element colour red
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Red|)
    !return.passed = false
  elseif(!element.flevel.between(30, 60)) then
  	enhance ALL (CTRAY $!type) FOR $!element colour green
  	enhance ALL with (TYPE OF OWNER eq 'CTFEAT') FOR $!element colour green
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Green   |)
    !return.passed = false
  elseif(!element.flevel.between(60, 90)) then
  	enhance ALL (CTRAY $!type) FOR $!element colour ForestGreen
  	enhance ALL with (TYPE OF OWNER eq 'CTFEAT') FOR $!element colour ForestGreen
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour ForestGreen   |)
    !return.passed = false

  elseif(!element.flevel.between(90, 100)) then
  	enhance ALL (CTRAY $!type) FOR $!element colour Plum
  	enhance ALL with (TYPE OF OWNER eq 'CTFEAT') FOR $!element colour Plum
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Plum   |)
    !return.passed = false
  else
  	enhance ALL (CTRAY $!type) FOR $!element colour Cyan
  	enhance ALL with (TYPE OF OWNER eq 'CTFEAT') FOR $!element colour Cyan
    !return.messages.append(|Fill level is | & !element.flevel.nint().string() & | - Colour Cyan|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkCableTrayFillCheck
