--
--
-- Description:
-- Check connections integrity.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkConnectionErrors (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- Record current db position
  !memory = !!ce
  !!ce = !element

  !numberOfErrors = !element.nconnerrors
  do !j from 1 to !numberOfErrors
    !errorText = CONNERROR $!j
    !return.messages.append(!errorText)
  enddo
  !return.passed = false

  -- Navigate back to original db position
  !!ce = !memory

  return !return

endfunction
-- End of function definition for !!chkConnectionErrors
