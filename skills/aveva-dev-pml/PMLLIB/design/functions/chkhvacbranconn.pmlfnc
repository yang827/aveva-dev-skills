--
--
-- Description:
-- Check that HVAC Branches are connected or capped.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacBranConn (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

   if(!element.href eq nulref) then
    if(!element.hcon eq 'CLOS' or !element.hcon eq 'OPEN') then
    else
      !return.messages.append(|Head not connected or capped|)
      !return.passed = false
    endif
  endif
  if(!element.tRef eq nulref) then
    if(!element.tcon eq 'CLOS' or !element.tcon eq 'OPEN') then
    else
      !return.messages.append(|Tail not connected or capped|)
      !return.passed = false
    endif
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacBranConn
