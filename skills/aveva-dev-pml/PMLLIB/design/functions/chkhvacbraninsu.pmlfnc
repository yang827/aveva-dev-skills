-- Created:         Fri Jul 10 08:54:50 BST 1998
--
--
-- Description:
-- Check that the HVAC Branch is insulated.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacBranInsu (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  if(!element.iSpec.unset()) then
    !return.messages.append(|Branch is uninsulated|)
    !return.passed = false
  else
    if(!element.inthi lt 1mm) then
      !return.messages.append(|No insulation thickness specified|)
      !return.passed = false
    endif
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacBranInsu
