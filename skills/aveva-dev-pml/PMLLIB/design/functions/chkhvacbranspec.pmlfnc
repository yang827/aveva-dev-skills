-- Author:          S.Bentley
-- Created:         Fri Jul 10 08:54:50 BST 1998
--
--
-- Description:
-- Check that the HVAC Branch spec (Pspec) and Detailing Spec (DSCODE) are set.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacBranSpec (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- if spec set
  if(!element.pspec.unset()) then
    !return.messages.append(|No Specification defined|)
    !return.passed = false
  endif

  -- if detailing spec set
  if(!element.dscode.trim().length() eq 0) then
    !return.messages.append(|No Detailing Specification defined|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacBranSpec
