-- Author:          S.Bentley
-- Created:         Wed May 31 08:54:50 BST 2006
--
-- Description:
-- Check that an HVAC branch connector item is on the main to which it is suppose to be fitted.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacBrcoAlign (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- variables
  !shape = !element.wdesp[40].lowcase()
  !shapeMain = !element.wdesp[30].lowcase()
  !depthOff = !element.desp[11].abs()
  if (!shapeMain eq 'circ') then
    !mainDepth = !element.desp[2]
  else
    !mainDepth = !element.desp[3]
   endif
  if (!shape eq 'circ') then
    !brcoDepth = !element.desp[41]
  else
    !brcoDepth = !element.desp[42]
  endif
  !halfMainDepth = !mainDepth / 2
  !halfBrcoDepth = !brcoDepth / 2

  -- Check the branch connector is no deeper than the main
  if (!brcoDepth gt !mainDepth) then
    !return.messages.append(|Branch Connector depth is greater than Main|)
    !return.passed = false
  endif

  -- Check the branch connector fits within the main depth considering offset
  if ((!halfBrcoDepth + !depthOff) gt !halfMainDepth) then
    !return.messages.append(|Branch Connector is not fitted on Main|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacBrcoAlign
