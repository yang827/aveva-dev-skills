-- File:            chkhvaccompjnts.pmlfnc
--   Type:          Function Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jul 10 08:54:50 BST 1998
--
--
-- Description:
-- Check that joint codes for ce match prev and next.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacCompJnts (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- variables for current element
  if (!element.arri eq 1) then
     !jaa = !element.desp[58]
     !jab = !element.desp[68]
     !acon = !element.acon
   elseif (!element.arri eq 2) then
     !jaa = !element.desp[59]
     !jab = !element.desp[69]
     !acon = !element.acon
   elseif (!element.arri eq 3) then
     !jaa = !element.desp[60]
     !jab = !element.desp[70]
     !acon = !element.acon
   endif
  if (!element.leav eq 1) then
     !jla = !element.desp[58]
     !jlb = !element.desp[68]
     !lcon = !element.lcon
   elseif (!element.leav eq 2) then
     !jla = !element.desp[59]
     !jlb = !element.desp[69]
     !lcon = !element.lcon
   elseif (!element.leav eq 3) then
     !jla = !element.desp[60]
     !jlb = !element.desp[70]
     !lcon = !element.lcon
   endif
   -- For Male/Female compatibility
   -- MALE is 638644
   -- FEMA is 560742
   if (!jaa.value() eq 638644) then
     !jaa = 560742
   elseif (!jaa.value() eq 560742) then
     !jaa = 638644
   endif

   if (!jla.value() eq 638644) then
     !jla = 560742
   elseif (!jla.value() eq 560742) then
     !jla = 638644
   endif

  -- variables for previous element
  if(!element.seq gt 1) then
    -- There is a previous element to get previous duct joints from.
    !prev = REFE OF PREV OF $!element
    if (!prev.leav eq 1) then
      !jlap = !prev.desp[58]
      !jlbp = !prev.desp[68]
      !lconp = !prev.lcon
    elseif (!prev.leav eq 2) then
      !jlap = !prev.desp[59]
      !jlbp = !prev.desp[69]
      !lconp = !prev.lcon
    elseif (!prev.leav eq 3) then
      !jlap = !prev.desp[60]
      !jlbp = !prev.desp[70]
      !lconp = !prev.lcon
    endif
  else
    -- This is the first element of the bran so the prev duct joints must come from a connection.
    if (!element.owne.href.set()) then
      if (!element.owne.href.type inset('TEE','BRCO','THRE','AHU','HFAN')) then
        !prev  = !element.owne.href
        if ((6 - (!prev.leav + !prev.arri)) eq 1) then
          !jlap = !prev.desp[58]
          !jlbp = !prev.desp[68]
          !lconp = !prev.ppcon[1]
        elseif ((6 - (!prev.leav + !prev.arri)) eq 2) then
          !jlap = !prev.desp[59]
          !jlbp = !prev.desp[69]
          !lconp = !prev.ppcon[2]
        elseif ((6 - (!prev.leav + !prev.arri)) eq 3) then
          !jlap = !prev.desp[60]
          !jlbp = !prev.desp[70]
          !lconp = !prev.ppcon[3]
        endif
      elseif (!element.owne.href.type eq 'NOZZ') then
        !prev  = !element.owne.href
        !jlap = !jaa
        !jlbp = !prev.desp[5]
        !lconp = !element.acon
      elseif (!element.owne.href.type eq 'BRAN') then
        if (!element.owne.href.href.set()) then
          if (!element.owne.href.mCount gt 0 and !element.owne.href.href.ref.eq(!element.owne.ref)) then
            -- When the HREF is a bran then look at the HREF of the referred branch. Branches connected Head to Head
            -- There is a member in the referred branch so get the prev duct joints from the first member
            !prev = !element.owne.href.member[1]
            if (!prev.arri eq 1) then
              !jlap = !prev.desp[58]
              !jlbp = !prev.desp[68]
              !lconp = !prev.acon
            elseif (!prev.arri eq 2) then
              !jlap = !prev.desp[59]
              !jlbp = !prev.desp[69]
              !lconp = !prev.acon
            elseif (!prev.arri eq 3) then
              !jlap = !prev.desp[60]
              !jlbp = !prev.desp[70]
              !lconp = !prev.acon
            endif
          elseif (!element.owne.href.mCount eq 0 and !element.owne.href.href.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the prev duct joints branch head size
            !prev  = !element.owne.href
            !jlap = !jaa
            !jlbp = !jab
            !lconp = !prev.hcon
          endif
        endif
        if (!element.owne.href.tRef.set()) then
          if (!element.owne.href.mCount gt 0 and !element.owne.href.tRef.ref.eq(!element.owne.ref)) then
            -- When the HREF is a bran then look at the TREF of the referred branch. Branches connected Head to Tail
            -- There is a member in the referred branch so get the prev duct joints from the last member
            !prev = !element.owne.href.member[!element.owne.href.mCount]
            if (!prev.leav eq 1) then
              !jlap = !prev.desp[58]
              !jlbp = !prev.desp[68]
              !lconp = !prev.lcon
            elseif (!prev.leav eq 2) then
              !jlap = !prev.desp[59]
              !jlbp = !prev.desp[69]
              !lconp = !prev.lcon
            elseif (!prev.leav eq 3) then
              !jlap = !prev.desp[60]
              !jlbp = !prev.desp[70]
              !lconp = !prev.lcon
            endif
          elseif (!element.owne.href.mCount eq 0 and !element.owne.href.tRef.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the prev duct joints branch head size
            !prev  = !element.owne.href
            !jlap = !jaa
            !jlbp = !jab
            !lconp = !prev.tcon
          endif
        endif
      endif
    else
      -- Href must be unset so we cant check any connected element so just pass it.
      !jlap = !jaa
      !jlbp = !jab
      !lconp = !acon
    endif
  endif

  -- variables for next element
  if(!element.seq neq !element.owne.mCount) then
    -- There is a next element to get next duct joints from.
    !next = REFE OF NEXT OF $!element
    if (!next.arri eq 1) then
      !jaan = !next.desp[58]
      !jabn = !next.desp[68]
      !aconn = !next.acon
    elseif (!next.arri eq 2) then
      !jaan = !next.desp[59]
      !jabn = !next.desp[69]
      !aconn = !next.acon
    elseif (!next.arri eq 3) then
      !jaan = !next.desp[60]
      !jabn = !next.desp[70]
      !aconn = !next.acon
    endif
  else
    -- This is the last element of the bran so the next duct joints must come from a connection.
    if (!element.owne.tRef.set()) then
      if (!element.owne.tRef.type inset('TEE','BRCO','THRE','AHU','HFAN')) then
        !next  = !element.owne.tRef
        if ((6 - (!next.leav + !next.arri)) eq 1) then
          !jaan = !next.desp[58]
          !jabn = !next.desp[68]
          !aconn = !next.ppcon[1]
        elseif ((6 - (!next.leav + !next.arri)) eq 2) then
          !jaan = !next.desp[59]
          !jabn = !next.desp[69]
          !aconn = !next.ppcon[2]
        elseif ((6 - (!next.leav + !next.arri)) eq 3) then
          !jaan = !next.desp[60]
          !jabn = !next.desp[70]
          !aconn = !next.ppcon[3]
        endif
      elseif (!element.owne.tRef.type eq 'NOZZ') then
        !next  = !element.owne.tRef
        !jaan = !jla
        !jabn = !next.desp[5]
        !aconn = !element.acon
      elseif (!element.owne.tRef.type eq 'BRAN') then
        if (!element.owne.tRef.href.set()) then
          if (!element.owne.tRef.mCount gt 0 and !element.owne.tRef.href.ref.eq(!element.owne.ref)) then
            -- When the TREF is a bran then look at the HREF of the referred branch. Branches connected Tail to Head
            -- There is a member in the referred branch so get the next duct joints from the first member
            !next = !element.owne.tRef.member[1]
            if (!next.arri eq 1) then
              !jaan = !next.desp[58]
              !jabn = !next.desp[68]
              !aconn = !next.acon
            elseif (!next.arri eq 2) then
              !jaan = !next.desp[59]
              !jabn = !next.desp[69]
              !aconn = !next.acon
            elseif (!next.arri eq 3) then
              !jaan = !next.desp[60]
              !jabn = !next.desp[70]
              !aconn = !next.acon
            endif
          elseif (!element.owne.tRef.mCount eq 0 and !element.owne.tRef.href.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the next duct joints branch head size
            !next = !element.owne.href
            !jaan = !jla
            !jabn = !jlb
            !aconn = !next.hcon
          endif
        endif
        if (!element.owne.tRef.tRef.set()) then
          if (!element.owne.tRef.mCount gt 0 and !element.owne.tRef.tRef.ref.eq(!element.owne.ref)) then
            -- When the TREF is a bran then look at the TREF of the referred branch. Branches connected Tail to Tail
            -- There is a member in the referred branch so get the next duct joints from the last member
            !next = !element.owne.tRef.member[!element.owne.tRef.mCount]
            if (!next.leav eq 1) then
              !jaan = !next.desp[58]
              !jabn = !next.desp[68]
              !aconn = !next.acon
            elseif (!next.leav eq 2) then
              !jaan = !next.desp[59]
              !jabn = !next.desp[69]
              !aconn = !next.lcon
            elseif (!next.leav eq 3) then
              !jaan = !next.desp[60]
              !jabn = !next.desp[70]
              !aconn = !next.acon
            endif
          elseif (!element.owne.tRef.mCount eq 0 and !element.owne.tRef.tRef.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the next duct joints branch head size
            !next = !element.owne.href
            !jaan = !jla
            !jabn = !jlb
            !aconn = !next.tcon
          endif
        endif
      endif
    else
      -- Href must be unset so we cant check any connected element so just pass it.
      !jaan = !jla
      !jabn = !jlb
      !aconn = !lcon
    endif
  endif
    -- So from the above the current arrive a size and current arrive b size  and current arrive conn
    -- should equal      the previous leave a size and previous leave b size  and previous leave conn
    -- and               the current  leave a size and current  leave b size  and current leave conn
    -- should equal      the next    arrive a size and next    arrive b size  and next arrive conn

  if (!jaa.value() eq !jlap.value() and !jab.value() eq !jlbp.value() and (!acon eq !lconp or !acon eq 'MAIN' or !lconp eq 'MAIN')) then
  else
    !return.messages.append(|Arrive Joint does not match Previous|)
    !return.passed = false
  endif

  if (!jla.value() eq !jaan.value() and !jlb.value() eq !jabn.value() and (!lcon eq !aconn or !lcon eq 'MAIN' or !aconn eq 'MAIN')) then
  else
    !return.messages.append(|Leave Joint does not match Next|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacCompJnts
