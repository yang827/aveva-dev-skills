-- File:            chkhvaccompsizs.pmlfnc
--   Type:          Function Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jul 10 08:54:50 BST 1998
--
--
-- Description:
-- Check that duct cross-sections of ce match previous and next.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacCompSizs (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- variables for current element
  if (!element.arri eq 1) then
     !xsaa = !element.desp[2]
     !xsab = !element.desp[3]
     !acon = !element.acon
   elseif (!element.arri eq 2) then
     !xsaa = !element.desp[4]
     !xsab = !element.desp[5]
     !acon = !element.acon
   elseif (!element.arri eq 3) then
     !xsaa = !element.desp[41]
     !xsab = !element.desp[42]
     !acon = !element.acon
   endif
  if (!element.leav eq 1) then
     !xsla = !element.desp[2]
     !xslb = !element.desp[3]
     !lcon = !element.lcon
   elseif (!element.leav eq 2) then
     !xsla = !element.desp[4]
     !xslb = !element.desp[5]
     !lcon = !element.lcon
   elseif (!element.leav eq 3) then
     !xsla = !element.desp[41]
     !xslb = !element.desp[42]
     !lcon = !element.lcon
   endif

  -- variables for previous element
  if (!element.seq gt 1) then
    -- There is a previous element to get previous duct sizes from.
    !prev = REFE OF PREV OF $!element
    if (!prev.leav eq 1) then
      !xslap = !prev.desp[2]
      !xslbp = !prev.desp[3]
      !lconp = !prev.lcon
    elseif (!prev.leav eq 2) then
      !xslap = !prev.desp[4]
      !xslbp = !prev.desp[5]
      !lconp = !prev.lcon
    elseif (!prev.leav eq 3) then
      !xslap = !prev.desp[41]
      !xslbp = !prev.desp[42]
      !lconp = !prev.lcon
    endif
  else
    -- This is the first element of the bran so the prev duct sizes must come from a connection.
    if (!element.owne.href.set()) then
      if (!element.owne.href.type inset('TEE','BRCO','THRE','AHU','HFAN')) then
        !prev  = !element.owne.href
        if ((6 - (!prev.leav + !prev.arri)) eq 1) then
          !xslap = !prev.desp[2]
          !xslbp = !prev.desp[3]
          !lconp = !prev.ppcon[1]
        elseif ((6 - (!prev.leav + !prev.arri)) eq 2) then
          !xslap = !prev.desp[4]
          !xslbp = !prev.desp[5]
          !lconp = !prev.ppcon[2]
        elseif ((6 - (!prev.leav + !prev.arri)) eq 3) then
          !xslap = !prev.desp[41]
          !xslbp = !prev.desp[42]
          !lconp = !prev.ppcon[3]
        endif
      elseif (!element.owne.href.type eq 'NOZZ') then
        !prev  = !element.owne.href
        !xslap = !prev.desp[2]
        !xslbp = !prev.desp[3]
        !lconp = !element.acon
      elseif (!element.owne.href.type eq 'BRAN') then
        if (!element.owne.href.href.set()) then
          if (!element.owne.href.mCount gt 0 and !element.owne.href.href.ref.eq(!element.owne.ref)) then
            -- When the HREF is a bran then look at the HREF of the referred branch. Branches connected Head to Head
            -- There is a member in the referred branch so get the prev duct sizes from the first member
            !prev = !element.owne.href.member[1]
            if (!prev.arri eq 1) then
              !xslap = !prev.desp[2]
              !xslbp = !prev.desp[3]
              !lconp = !prev.acon
            elseif (!prev.arri eq 2) then
              !xslap = !prev.desp[4]
              !xslbp = !prev.desp[5]
              !lconp = !prev.acon
            elseif (!prev.arri eq 3) then
              !xslap = !prev.desp[41]
              !xslbp = !prev.desp[42]
              !lconp = !prev.acon
            endif
          elseif (!element.owne.href.mCount eq 0 and !element.owne.href.href.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the prev duct sizes branch head size
            !prev  = !element.owne.href
            !xslap = !prev.:hxysize[1]
            !xslbp = !prev.:hxysize[2]
            !lconp = !prev.hcon
          endif
        endif
        if (!element.owne.href.tRef.set()) then
          if (!element.owne.href.mCount gt 0 and !element.owne.href.tRef.ref.eq(!element.owne.ref)) then
            -- When the HREF is a bran then look at the TREF of the referred branch. Branches connected Head to Tail
            -- There is a member in the referred branch so get the prev duct sizes from the last member
            !prev = !element.owne.href.member[!element.owne.href.mCount]
            if (!prev.leav eq 1) then
              !xslap = !prev.desp[2]
              !xslbp = !prev.desp[3]
              !lconp = !prev.lcon
            elseif (!prev.leav eq 2) then
              !xslap = !prev.desp[4]
              !xslbp = !prev.desp[5]
              !lconp = !prev.lcon
            elseif (!prev.leav eq 3) then
              !xslap = !prev.desp[41]
              !xslbp = !prev.desp[42]
              !lconp = !prev.lcon
            endif
          elseif (!element.owne.href.mCount eq 0 and !element.owne.href.tRef.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the prev duct sizes branch head size
            !prev  = !element.owne.href
            !xslap = !prev.:hxysize[1]
            !xslbp = !prev.:hxysize[2]
            !lconp = !prev.tcon
          endif
        endif
      endif
    else
      -- Href must be unset so we cant check any connected element so just pass it.
      !xslap = !xsaa
      !xslbp = !xsab
      !lconp = !acon
    endif
  endif

  -- variables for next element
  if (!element.seq neq !element.owne.mCount) then
    -- There is a next element to get next duct sizes from.
    !next = REFE OF NEXT OF $!element
    if (!next.arri eq 1) then
      !xsaan = !next.desp[2]
      !xsabn = !next.desp[3]
      !aconn = !next.acon
    elseif (!next.arri eq 2) then
      !xsaan = !next.desp[4]
      !xsabn = !next.desp[5]
      !aconn = !next.acon
    elseif (!next.arri eq 3) then
      !xsaan = !next.desp[41]
      !xsabn = !next.desp[42]
      !aconn = !next.acon
    endif
  else
    -- This is the last element of the bran so the next duct sizes must come from a connection.
    if (!element.owne.tRef.set()) then
      if (!element.owne.tRef.type inset('TEE','BRCO','THRE','AHU','HFAN')) then
        !next  = !element.owne.tRef
        if ((6 - (!next.leav + !next.arri)) eq 1) then
          !xsaan = !next.desp[2]
          !xsabn = !next.desp[3]
          !aconn = !next.ppcon[1]
        elseif ((6 - (!next.leav + !next.arri)) eq 2) then
          !xsaan = !next.desp[4]
          !xsabn = !next.desp[5]
          !aconn = !next.ppcon[2]
        elseif ((6 - (!next.leav + !next.arri)) eq 3) then
          !xsaan = !next.desp[41]
          !xsabn = !next.desp[42]
          !aconn = !next.ppcon[3]
        endif
      elseif (!element.owne.tRef.type eq 'NOZZ') then
        !next  = !element.owne.tRef
        !xsaan = !next.desp[2]
        !xsabn = !next.desp[3]
        !aconn = !element.acon
      elseif (!element.owne.tRef.type eq 'BRAN') then
        if (!element.owne.tRef.href.set()) then
          if (!element.owne.tRef.mCount gt 0 and !element.owne.tRef.href.ref.eq(!element.owne.ref)) then
            -- When the TREF is a bran then look at the HREF of the referred branch. Branches connected Tail to Head
            -- There is a member in the referred branch so get the next duct sizes from the first member
            !next = !element.owne.tRef.member[1]
            if (!next.arri eq 1) then
              !xsaan = !next.desp[2]
              !xsabn = !next.desp[3]
              !aconn = !next.acon
            elseif (!next.arri eq 2) then
              !xsaan = !next.desp[4]
              !xsabn = !next.desp[5]
              !aconn = !next.acon
            elseif (!next.arri eq 3) then
              !xsaan = !next.desp[41]
              !xsabn = !next.desp[42]
              !aconn = !next.acon
            endif
          elseif (!element.owne.tRef.mCount eq 0 and !element.owne.tRef.href.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the next duct sizes branch head size
            !next = !element.owne.href
            !xsaan = !next.:hxysize[1]
            !xsabn = !next.:hxysize[2]
            !aconn = !next.hcon
          endif
        endif
        if (!element.owne.tRef.tRef.set()) then
          if (!element.owne.tRef.mCount gt 0 and !element.owne.tRef.tRef.ref.eq(!element.owne.ref)) then
            -- When the TREF is a bran then look at the TREF of the referred branch. Branches connected Tail to Tail
            -- There is a member in the referred branch so get the next duct sizes from the last member
            !next = !element.owne.tRef.member[!element.owne.tRef.mCount]
            if (!next.leav eq 1) then
              !xsaan = !next.desp[2]
              !xsabn = !next.desp[3]
              !aconn = !next.lcon
            elseif (!next.leav eq 2) then
              !xsaan = !next.desp[4]
              !xsabn = !next.desp[5]
              !aconn = !next.lcon
            elseif (!next.leav eq 3) then
              !xsaan = !next.desp[41]
              !xsabn = !next.desp[42]
              !aconn = !next.lcon
            endif
          elseif (!element.owne.tRef.mCount eq 0 and !element.owne.tRef.tRef.ref.eq(!element.owne.ref)) then
            -- There are no members in the referred branch so get the next duct sizes branch head size
            !next = !element.owne.href
            !xsaan = !next.:hxysize[1]
            !xsabn = !next.:hxysize[2]
            !aconn = !next.tcon
          endif
        endif
      endif
    else
      -- Href must be unset so we cant check any connected element so just pass it.
      !xsaan = !xsla
      !xsabn = !xslb
      !aconn = !lcon
    endif
  endif
    -- So from the above the current arrive a size and current arrive b size  and current arrive conn
    -- should equal      the previous leave a size and previous leave b size  and previous leave conn
    -- and               the current  leave a size and current  leave b size  and current leave conn
    -- should equal      the next    arrive a size and next    arrive b size  and next arrive conn

  if     (!xsaa.value() eq !xslap.value() and !xsab.value() eq !xslbp.value() and (!acon eq !lconp or !acon eq 'MAIN' or !lconp eq 'MAIN')) then
  elseif (!xsab.value() eq !xslap.value() and !xsaa.value() eq !xslbp.value() and (!acon eq !lconp or !acon eq 'MAIN' or !lconp eq 'MAIN')) then
  else
    !return.messages.append(|Arrive does not match Previous Leave|)
    !return.passed = false
  endif

  if     (!xsla.value() eq !xsaan.value() and !xslb.value() eq !xsabn.value() and (!lcon eq !aconn or !lcon eq 'MAIN' or !aconn eq 'MAIN')) then
  elseif (!xslb.value() eq !xsaan.value() and !xsla.value() eq !xsabn.value() and (!lcon eq !aconn or !lcon eq 'MAIN' or !aconn eq 'MAIN')) then
  else
    !return.messages.append(|Leave does not match next Arrive|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacCompSizs
