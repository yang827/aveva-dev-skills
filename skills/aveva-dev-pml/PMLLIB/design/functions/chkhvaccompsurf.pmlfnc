--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jul 10 08:54:50 BST 1998
--
--
-- Description:
-- Check weight of component is less than the maximum.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacCompSurf (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  if(!element.desp[87] eq 0) then
    !return.messages.append(|Surface Area has not been calculated.|)
    !return.passed = false
    return !return
  endif

  if(!element.desp[82] gt 40M2 ) then
    !return.messages.append(|External Surface Area is | & !element.desp[82].string(!!areaFmt))
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacCompSurf
