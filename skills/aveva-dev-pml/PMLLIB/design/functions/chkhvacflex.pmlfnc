--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Mon Jul 03 14:54:50 BST 2006
--
-- Description:
-- Check for HVAC Flex components
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacFlex (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- variables
  !shape = !element.wdesp[40].lowcase()
  !catref = !element.catref
  if (!catref eq /CFLEX ) then
    !length   = !element.desp[6]
  elseif (!catref eq /CBENDFLEX ) then
    !aext   = !element.desp[15]
    !radius = !element.desp[8]
    !angle  = !element.desp[9]
    !lext   = !element.desp[17]
    !duct   = !element.desp[2]
    -- Length = arrive extension + arc along back + leave extension
    !length = (!aext + ((2 * (PI * (!radius + !duct))) * (!angle.value() / 360)) + !lext)
  else
    !return.messages.append(|Invalid Flex component|)
  endif

  -- Check the flex is long enough
  if (!length lt 100mm) then
    !return.messages.append(|Flex length is less than 100mm|)
    !return.passed = false
  endif
  -- Check the flex is not too long
  if (!length gt 6000mm) then
    !return.messages.append(|Flex length | & !length.string(!!distanceFmt) & | is more than 6000mm|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacFlex
