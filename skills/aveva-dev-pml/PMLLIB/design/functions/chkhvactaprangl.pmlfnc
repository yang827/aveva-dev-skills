--
--
-- Description:
-- Check for maximum tapr angle.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacTaprAngl (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- variables
  !aOff = !element.desp[10].abs()
  !bOff = !element.desp[11].abs()
  !xsaa = !element.desp[2].abs()
  if (!element.wdesp[3] eq 'DIAM') then
    !xsab = 0mm
  else
    !xsab = !element.desp[3].abs()
  endif
  !xsla = !element.desp[4].abs()

  if (!element.wdesp[5] eq 'DIAM') then
    !xslb = 0mm
  else
    !xslb = !element.desp[5].abs()
  endif
  !leng = !element.desp[6].abs()
  !aext = !element.desp[15].abs()
  !lext = !element.desp[17].abs()
  !aa = ABS(!aOff + (!xsaa / 2) - (!xsla / 2))
  !ab = ABS(!aOff + (!xsla / 2) - (!xsaa / 2))
  !la = ABS(!bOff + (!xsab / 2) - (!xslb / 2))
  !lb = ABS(!bOff + (!xslb / 2) - (!xsab / 2))

  !maxOff = MAX(!aa, !ab, !la, !lb )
  !leng = !leng - !aext - !lext

  !maxAngle = ATANT(!maxOff, !leng)

  if(!maxAngle gt 22.5degrees ) then
    !return.messages.append(|Maximum angle is | & !maxAngle.string(!!angleFmt))
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacTaprAngl
