--
--
-- Description:
-- Check for implied tube less than 1mm.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkHvacTubiExis (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  if(!element.itle gt 1mm) then
    !return.messages.append(|Implied length is | & !element.itle.string(!!distanceFmt) & | long|)
    !return.passed = false
  endif

  return !return

endfunction
-- End of function definition for !!chkHvacTubiExis
