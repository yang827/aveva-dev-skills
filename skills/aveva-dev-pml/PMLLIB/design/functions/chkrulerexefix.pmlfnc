--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jul 10 08:54:50 BST 1998
--
--
-- Description:
-- Check rules integrity.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!chkRuleRexeFix (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- Record current db position
  !memory = !!ce
  !!ce = !element

  -- Try to fix the errors on the passed element
  CHECKRULES PATCH REEXECUTE CE
  handle ANY
    !return.messages.append(!!error.text)
    !return.passed = false
    return !return
  endhandle

  -- Do a collection of the elements with error
  var !collect collect all with (nruleerrors gt 0) for ce

  -- Loop through all the elements collected to find out how many errors per element in the collection
  do !i indices !collect
    -- Loop through all the elements with errors
    !return.messages.append('Errors for ' & !collect[!i].dbref().fullname )
    !numberOfErrors = !collect[!i].dbref().nruleerrors
    !!ce = !collect[!i].dbref()
    do !j from 1 to !numberOfErrors
      !errorText = RULEERROR $!j
      !return.messages.append('  ' & !errorText)
    enddo
    !return.passed = false
  enddo

  -- Navigate back to original db position
  !!ce = !memory

  return !return

endfunction
-- End of function definition for !!chkRuleRexeFix
