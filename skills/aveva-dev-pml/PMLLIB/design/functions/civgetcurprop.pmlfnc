--
--
-- Description:
-- Function to get the current property values
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--         r     COMPROPDATA     common property object
-- Return:
--   [Data Type] [Description]
--    string        design parameters
--
------------------------------------------------------------------------

define function !!civGetCurProp(!comProp is COMPROPDATA) is STRING

  -- current property purposes is an array of string like DESP, EXPR, PARA etc
  !purposeList = !comProp.purposeList
  -- Initialise variables
  !purpose = REAL()
  !return = ''

  -- Loop through array of purposes to find the array position of DESP
  do !i indices !purposeList
    if (!purposeList[!i] eq 'DESP') then
      !purpose = !i
      break
    endif
  enddo

  if (!purpose.set()) then
    -- Loop through array of DESPs
    !propertyList = !comProp.propertyData[!purpose]
    do !i indices !propertyList
      if (!i eq 1) then
        if (!propertyList[!i].ptyp eq 'DIST') then
          !return = |( | & !propertyList[!i].dKey & | | & !comProp.currentValues[!purpose][!i].string(!!distanceFmt)
        else
          !return = |( | & !propertyList[!i].dKey & | | & !comProp.currentValues[!purpose][!i]
        endif
      else
        if (!propertyList[!i].ptyp eq 'DIST') then
          !return = !return & |, | & !propertyList[!i].dKey & | | & !comProp.currentValues[!purpose][!i].string(!!distanceFmt)
        else
          !return = !return & |, | & !propertyList[!i].dKey & | | & !comProp.currentValues[!purpose][!i]
        endif
      endif
    enddo
  else
    !return = ''
    return !return
  endif

  -- Return the string
  if (!return.subString(1,1) eq '(') then
   !return = !return & ' )'
  endif

  return !return

endfunction
-- End of function definition for !!civGetCurProp
