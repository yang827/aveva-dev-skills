-- Define function
define function !!civNewGensecShow()

 -- Check valid specification
  var !specRef |$_CDSTLSPECD_SPRE|
  handle any
  endhandle

  if( Unset(!specRef) or length(!specRef ) le 0) then
      !!messageFile.error(156, 001)
  endif

-- show form
show !!stlNewGensec

-- set up event driven graphics to three point mode
!!stlNewGensec.threePick()

!!stlNewGensec.methodrg.val = 2

!!stlNewGensec.create.val = True


endfunction
-- End of function definition for !!civNewGensecShow
