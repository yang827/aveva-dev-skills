-- File:            civwallheight.pmlfnc
--   Type:          Function Definition
--   Group:         Wall and Floors Application
--     Keyword:     CIVIL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Fri Sep 26 15:28:02 1997
--
--
-- Description:
-- Change the design parameter of the wall associated with the DKEY HEIG
-- by the value given wrt to element given
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R    DBREF        Wall
--    2    R    REAL         Distance
--    3    R    DBREF        Element defining orientation of distance
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!civWallHeight(!element is DBREF, !value is REAL, !wrt is DBREF , !mode is STRING)

  -- Validate element
  if (!element.type eq 'STWALL' or !element.type eq 'WALL' ) then

    -- Get dataset information
    !message = STRING()
    !template = BOOLEAN()
    !cata[1] = object DBREF()
    !desp[1] = object DBREF()
    !data[1] = object DBREF()
    !attr[1] = object DBREF()
    !plot[1] = object DBREF()

    -- Find design parameter
    if (!!findDataSet(!element.spre, !message, !template, !cata, !desp, !data, !attr, !plot ) ) then
      if (!desp.size() gt 0) then
        do !index from 1 to !desp.size()
          if (!desp[!index].dKey eq 'HEIG') then
            if (!template) then
                   !expression = !desp[!index].ddprop
            else
                   !expression = !desp[!index].pprop
            endif
            !number = !expression.after('[').before(']').real()

            -- Calculate change wrt to element
            !!vector = object POSITION()
            !!vector.up = !value
            !!vector.east = 0
            !!vector.north = 0
            !!vector.origin = !wrt
            if (!mode eq 'TOP') then
                 !height = !value
            else
                 !old = $!expression
                 !height = !old - !value
            endif

            -- Change value
            !refe = !!ce
            !!ce = !element
            DESP NUMBER $!number $!height
            if (!mode eq 'TOP') then
                 BY D $!value WRT $!wrt
            endif

            -- Rexecute any rules
            if (!template ) then
                  !lock = LOCK
                  UNLOCK ALL
                  RULE REXECUTE
                  LOCK ALL
                  if (not !lock) then
                       UNLOCK
                  endif
            else
                  RULE REXECUTE
            endif
            !!ce = !refe
          endif
        enddo
      endif
    endif
  endif

endfunction
-- End of function definition for !!civWallHeight
