-- File:            cladatahandle.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        design
--   Replaces:      DCLADAT
--
-- Author:          A.Kirkland
-- Created:         Tue Dec 9 16:15:46 GMT 1997
--
--
-- Description:
-- replace STLWRK/DCLADAT for clash data handling
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Option for loading setting etc]
--               SET     - Set clash data and save to old to file
--               OBST    - Set Obstructions
--               RESTORE - Load restore file
--   [2] [R]    [ARRAY]   [Define Obstruction list (items)]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!claDataHandle(!option is STRING,!items is ARRAY)


-- Initialise Variables

-- *** OLD STYLE PML ***
   var !uniq UNIQUE
   var !user USER

-- convert array to string

 !limitString = ' '
   do !string indices !items
      !limitString = !limitString & ' ' & !items[!string]
   enddo


   !file = '%PDMSUSER%/$!user$N-$!uniq'

-- Save Clasher Data
 if(!option.eq('SET')) then
   DESCLASH
     SAVE ALL $!file OVER

     OVERRIDE ON
     REMOVE OBST ALL
     AUTO $!limitString
      handle any
      -- if array of dbrefs is null
         LIMITS NONE
      endhandle
     IGNORE CONNECTION
     REPORT SUMMARY OFF
     REPORT HEADER OFF
     REPORT MAIN OFF
     REPORT GRAPHICS OFF
   EXIT

-- Load Obstruction List
 elseif (!option.eq('OBST')) then
   if(!items.set()) then
      var !site (SITE OF $!items[1])
      -- find obstruction from the limits and not from passed array
      -- *** OLD STYLE PML ***
      var !limits CLASH LIMITS
      -- assume current world 'cos MDB too much
      if(!limits.neq('None')) then
      -- do it this way rather than the WIN option in clasher
          var !newItems  COLLECT ALL (SCTN GENSEC) WITHIN $!limits FOR $!site
          !newItems.unique()
      endif
   else
          !newItems = !items
   endif
   DESCLASH
     do !obstruction values !newItems
       OBST $!obstruction
     enddo
   EXIT

-- Reload old data
 elseif (!option.eq('RESTORE')) then
   DESCLASH
     RESTORE $!file
     handle any
     elsehandle none
       openfile "$!file" read !funit
       closefile $!funit DELETE
     endhandle
   EXIT
 endif

endfunction
-- End of function definition for !!claDataHandle
