--
--
-- Description:
-- function to clash passed array against the preset obstruction list.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!claRailPoints(!railsToClash is ARRAY) is CLASHDATA

-- initialise variables
   !clashPoints = object CLASHDATA()
   !clashPoses  = ARRAY()
   !clashItems  = ARRAY()
   !clashObsts  = ARRAY()

 DESCLASH MIDPOINT ON EXIT
 do !indx indices !railsToClash


   DESCLASH CHECK $!railsToClash[$!indx] EXIT

   var !ccnt CLASH COUNT ALL
   !allClashes = !ccnt.split()
   !clashCount = (!allClashes[1].real() + !allClashes[2].real() + !allClashes[3].real() + !allClashes[4].real())

   do !aindx to !clashCount
     var !clashPos   CLASH $!aindx POS
     var !clashItem  CLASH $!aindx FIRST
     var !clashObst  CLASH $!aindx SECOND
     !clashItems.append(!clashItem.dbRef())
     !clashObsts.append(!clashObst.dbRef())
     !clashPoses.append(!clashPos.position())
   enddo


 enddo
 DESCLASH MIDPOINT OFF EXIT

-- load object with arrays from the clash
   !clashPoints.items = !clashItems
   !clashPoints.obsts = !clashObsts
   !clashPoints.poses = !clashPoses


return !clashPoints

endfunction
-- End of function definition for !!claRailPoints
