--
-- Description:
-- clear colour background from passed gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [Gadget to rem colour from]
--   soon to be an array for all gadgets
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!clearColour(!gadget is GADGET)

!gadget.background = 205

endfunction
-- End of function definition for !!clearColour
