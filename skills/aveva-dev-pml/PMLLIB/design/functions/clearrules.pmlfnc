--
--
-- Description:
-- function to clear all rules from a tmpl
-- for use when training
-- This function will not clear rules from
-- TMPL's in the TPWL.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function

define function !!clearRules(!dbRef is DBREF)

        !refe = !!ce

-- If under the TMPL World don't do anything
        !!ce = !dbRef
-- Navigate to TPWL
        TPWL
        handle any
                !elements = !!collectAllFor('','type neq |DDSE|',!dbRef)

                do !index indices !elements
                        !!ce = !elements[!index]
                        RULE DELETE ALL
                enddo

-- Go back to original

         !!ce = !refe
        endhandle

endfunction
-- End of function definition for !!clearRules
