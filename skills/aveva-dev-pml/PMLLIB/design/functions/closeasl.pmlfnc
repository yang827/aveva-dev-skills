--
-- Description:
-- Dismiss ASL form and close EDG and clear aid lines
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!closeAsl()

-- Clear EDG
   !!edgPop(-1)
-- Clear aid lines
   !!aidClear(|ALL|,|ALL|)
-- Reset Positional Members
   !!aslSpec.startPos = object EDGDATA()
   !!aslSpec.endPos   = object EDGDATA()
-- Clear start and end positional gadgets
   !!load3Ddata(!!aslSpec.startPos.pos,|Start|)
   !!load3Ddata(!!aslSpec.endPos.pos,|End|)

endfunction
-- End of function definition for !!closeAsl
