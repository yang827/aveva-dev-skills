-- File:            colenhancetmpl.pmlfnc
--   Type:          Function Definition
--   Group:         Colour handling routines

--     Keyword:     COLOUR
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Aug 12 8:58:57 BST 1998
--
--
-- Description:
-- function to enhance passed dbref if it has a tmpl beneath it
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [element to enhance]
--   [2] [R]    [Real]      [Colour to enhance]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!colEnhanceTmpl(!element is DBREF, !colour is REAL)

!tmpl = !!collectAllFor('TMPL','',!element)

do !ind values !tmpl
 ENHANCE $!ind COLOUR $!colour
enddo


endfunction
-- End of function definition for !!colEnhanceTmpl
