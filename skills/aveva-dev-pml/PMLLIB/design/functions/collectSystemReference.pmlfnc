--
--
-- Description:
--    Collecting systems reference particular type
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Where to create pipe
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!collectSystemReference(!type is STRING, !dtext is ARRAY, !rtext is ARRAY)

  !systemRefs = object ARRAY()
  !systemgrup = object ARRAY()

  !systems = object COLLECTION()
  !systems.addtype('SYGPAR')


  do !systemElent values !systems.results()
    if  (!systemElent.purpose.eq(!type)) then
       !systemgrup.append(!systemElent)
    endif
  enddo

  do !i values !systemgrup
    !systems.scope(!i)
    !systems.type('SYSGRP')
      do !j values !systems.results()
        !systemRefs.append(!j)
      enddo
  enddo
  !dtext.clear()
  !rtext.clear()

  !dtext[1] = 'No System'
  !rtext[1] = 'Nulref'

  do !i index !systemRefs
    if (!systemRefs[!i].description.unset() or !systemRefs[!i].description.eq('')) then
      !dtext.append(!systemRefs[!i].name)
    else
      !dtext.append(!systemRefs[!i].description)
  endif

  !rtext.append(!systemRefs[!i].name)

  enddo



endfunction
-- End of function definition
