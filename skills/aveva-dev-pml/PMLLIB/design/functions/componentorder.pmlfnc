--
--
-- Description:
--    Orders the passed components into their hierarchy sequence, the
--    indices of the returned array correspond to the sequence of the
--    component in the hierarchy
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of database elements
-- Return:
--   [Data Type] [Description]
--    ARRAY       Hierarchical orders sequence of components
--
------------------------------------------------------------------------

define function !!componentOrder(!componentList is ARRAY) is ARRAY

  -- Initialise Variables
  !components     = !componentList

  -- Define return array
  do !component values !components
    !index            = !component.sequence
    !sequence[!index] = !component
  enddo

  return !sequence

  do !i indices !components
    !sequence[!i] = !components[!i].sequence
  enddo

  -- Sort into order
  !indices = !sequence.sortedIndices()
  !components.reindex(!indices)

  -- Return ordered list
  return !components

endmethod
