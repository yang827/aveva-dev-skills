--
--
-- Description:
-- find ppoint offset tolerance
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]    [Element to check for wobbly ppoints can be spco or component]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY        has one, three or 4 members,
-- 1) TRUE/FALSE for if it has a wobbly ppoint
-- 2) the ppoint number
-- 3) the offTol value
-- 4) the slope reference of the branch if it has one
--
------------------------------------------------------------------------

-- Define function
define function !!componentSlope(!component is DBREF )is ARRAY

!return[1] = FALSE
!ptref = !component.ptre
handle ANY
 return !return
endhandle

do !a values !ptref.members
  if !a.offTol.set() then
     !return[1] = TRUE
     skip if !a.number.unset()
     !return[2] = !a.number
     !return[3] = !component.ppOffTol[!a.number]
     break
  endif
enddo

if !component.type.eq('SPCO') then
  return !return
endif

if !component.owner.sloref.set() then
   !return[4] = !component.owner.sloref
endif

return !return

endfunction
-- end of function definition for !!componentSlope
