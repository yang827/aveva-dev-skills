--
-- Description:
-- function to create a sctn and set the spec form
-- the form specification selection
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!createAsl()


-- Find out which WP is which
   if(!!aslSpec.startPos.pos.up gt !!aslSpec.endPos.pos.up) then
    !topWP        = !!aslSpec.startPos
    !bottomWP     = !!aslSpec.endPos
   else
    !topWP        = !!aslSpec.endPos
    !bottomWP     = !!aslSpec.startPos
   endif

-- Initialise Variables

   !selectedSpre = !!aslSpec.selected.selection().dbRef()
   !ce           = !!aslSpec.refe

-- create sctn (maybe)
   !!ce = !ce
   handle any
     !ce = !!ce
   endhandle

   if(!!aslSpec.mode.selection('Rtext') eq |CREATE|) then
------------------------------------------
-- temp block while sort out gensecs.
      if(!!aslSpec.gensec.val eq FALSE) then
         NEW SCTN
      else
         NEW GENSEC
         POS  $!bottomWP.pos
         NEW SPINE
         NEW POINSP
         NEW POINSP
         GENSEC
      endif
------------------------------------------
-- leave in create mode
   !!aslSpec.refe = !!ce
--   !!aslSpec.ceName.val = !!aslSpec.refe.flnn
   else
-- modify to do !!!!!
      !!ce = !!aslSpec.ceName.val.dbRef()
      !!aslSpec.refe = !!ce
      UNLOCK ALL

   endif
-- Set name of SCTN
   !flnn = !!ce.flnn

-- position start and end

      POSS  $!bottomWP.pos
      POSE  $!topWP.pos

-- set ends perp to start with
   DRNS PERP
   DRNE PERP


-- Temporary set drne and drns for space managed spre

-- Find out direction of ASL
   !aslDir = !!aslSpec.direction.val
   !endPlane = !!planePntDir(!!aslSpec.startPos.pos, !aslDir)

-- set spre
   SPRE $!selectedSpre

-- set correct gtyp
   !gtype = !selectedSpre.catRef.gtyp
    handle any
    -- in case spre references a tmpl
      !gtype = !selectedSpre.tmpr.gtyp
    endhandle

   GTYP $!gtype
    handle any
    -- in case gtype of catr is unset
    endhandle

-- Set DRNE and DRNS
   if(!gtype neq |LADD|) then
    DRNE $!endPlane.direction
    DRNS $!endPlane.direction
   endif
-- If ASL Component is vertical :-
   if(!!aslSpec.angle.val eq 90) then
      !rotate = !!aslSpec.direction.val
      ROTATE THRO CE ABOUT Z WRT CE AND Y IS $!rotate
   endif

-- set desp parameters
   !!genPropertyShow(!selectedSpre,|NEW|,|$!flnn|,|!!aslTmplCrt()|,|!!dismiss()|)

-- Switch to modify mode (not any more - leave in creat mode)

--   !!aslSpec.mode.select('Rtext',  'MODIFY')
--   !!aslSpec.formTitle = |Access Stairs & Ladders. (Modify)|
--   !!aslSpec.ce.active = true


endfunction
-- End of function definition for !!createAsl
