--
--
-- Description:
-- Create a link in a specific linkset.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item linkset it to be created beneath
--    2   R      LINK        Object containing link data
-- Return:
--   [Data Type] [Description]
--    DBREF       Link created
--
------------------------------------------------------------------------

-- Define function
define function !!createLink (!item is DBREF, !link is LINK) is DBREF

  -- Initialise Variables
  !currentItem = !!ce

  -- Check we have access to create the link
--  if(!!dbRefUpdate(!item,!message).not()) then
--    !!alert.error(!message)
--    return object DBREF()
--  endif

  -- Check we can create the linkset in the item
  if(!item.list.findFirst('LNKI').unset()) then
    !!alert.error('Unable to create a link beneath (' & !item.flnn & ').')
    return object DBREF()
  endif

  -- Navigate to !item
  !!ce = !item

  -- Create Item
  NEW LNKI
  if(!link.description.set()) then
    DESC |$!link.description|
  endif
  if(!link.function.set()) then
    FUNC |$!link.function|
  endif
  if(!link.purpose.set()) then
    PURP $!link.purpose
  endif
  if(!link.number.set()) then
    NUMB $!link.number
  endif
  if(!link.fpoNumber.set()) then
    FPONUMB $!link.fpoNumber
  endif
  if(!link.tpoNumber.set()) then
    TPONUMB $!link.tpoNumber
  endif
  if(!link.mflg.set()) then
    MFLG $!link.mflg
  endif
  if(!link.dKey.set()) then
    DKEY $!link.dKey
  endif
  if(!link.gType.set()) then
    GTYP $!link.gType
  endif

  !returnDbRef = !!ce

  -- Return to Original Position
  !!ce = !currentItem

  return !returnDbRef

endfunction
-- End of function definition for !!createLink
