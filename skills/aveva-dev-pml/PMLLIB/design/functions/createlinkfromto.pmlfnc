--
--
-- Description:
-- Creates a link between to existing linksets.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Linkset fist link is to be created in
--    2   R      LINK        Link object containing link data
--    3   R      DBREF       Linkset second link is to be created in
--    4   R      LINK        Link object containing link data
-- Return:
--   [Data Type] [Description]
--    ARRAY       DBREF array containing links created
--
------------------------------------------------------------------------

-- Define function
define function !!createLinkFromTo (!fromLinkSet is DBREF, !fromLink is LINK, !toLinkSet is DBREF, !toLink is LINK) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()
  !currentItem = !!ce

  -- Create Link elements in linksets
  !returnArray[1] = !!createLink(!fromLinkSet, !fromLink)
  !returnArray[2] = !!createLink(!toLinkSet, !toLink)

  -- Create Links between items
  !!ce = !returnArray[1]
  LREF $!returnArray[2]
  !!ce = !returnArray[2]
  LREF $!returnArray[1]

  -- Return to where we came from
  !!ce = !currentItem

  return !returnArray

endfunction
-- End of function definition for !!createLinkFromTo
