--
--
-- Description:
-- Create a linkset beneath the passed item.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item linkset it to be created beneath
--    2   R      LINKSET     Object containing linkset data
-- Return:
--   [Data Type] [Description]
--    DBREF       Linkset created
--
------------------------------------------------------------------------

-- Define function
define function !!createLinkSet (!item is DBREF, !linkSet is LINKSET) is DBREF


  -- Initialise Variables
  !currentItem = !!ce

  -- Check we have access to create the link
--  if(!!dbRefUpdate(!item,!message).not()) then
--    !!alert.error(!message)
--    return object DBREF()
--  endif

  -- Check we can create the linkset in the item
  if(!item.list.findFirst('LNKS').unset()) then
    !!alert.error('Unable to create a linkset beneath (' & !item.flnn & ').')
    return object DBREF()
  endif

  -- Navigate to !item
  !!ce = !item

  -- Create Item
  NEW LNKS
  if(!linkSet.description.set()) then
    DESC |$!linkSet.description|
  endif
  if(!linkSet.function.set()) then
    FUNC |$!linkSet.function|
  endif
  if(!linkSet.purpose.set()) then
    PURP $!linkSet.purpose
  endif
  if(!linkSet.number.set()) then
    NUMB $!linkSet.number
  endif

  !returnDbRef = !!ce

  -- Return to Original Position
  !!ce = !currentItem

  return !returnDbRef

endfunction
-- End of function definition for !!createLinkSet
