-- Define function
define function !!createVolumeModel(!action is STRING)

  -- Initialise Variables

  -- Check form exists
  if(undefined(!!genVolumeModel)) then
    PML RELOAD FORM !!genVolumeModel
  endif

  -- Create element
--  show !!genVolumeModel
  !!genVolumeModel.initialise(!action)

endfunction
-- End of function definition
