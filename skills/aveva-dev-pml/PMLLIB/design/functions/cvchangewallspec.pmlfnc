--
--
-- Description:
-- Change Wall Specification of Specified Elements
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvChangeWallSpec()

  -- Remember where we were

  !refe = !!ce
  !list = ARRAY()

  -- Build up list of elements based on mode

  if (!!cvWallSpec.mode.upcase() eq |CE| ) then
    -- Current Element Mode
    !list[1] = !!cvWallSpec.element

  elseif (!!cvWallSpec.mode.upcase() eq |LIST| ) then
    -- List Mode
    -- Extract members of current list
    !list = !!getCurrentList()

    if (!list.unset()) then
      -- Reset mode to CE
      call !!cvWallSpecCe()
      handle any
      endhandle
      !!messageFile.error(149, 1)

    endif

  elseif (!!cvWallSpec.mode.upcase() eq |PICK| ) then

    !unenhanceList = ARRAY()
    PROMPT DISMISS
    PROMPT OFF

    -- Pick all items
    do !i

      -- Identify Element
      PROMPT LOAD ESCAPE |Identify Wall.|
      var !pick PICK
      handle any
         break
      endhandle

      -- Check for generic type
      !type = (TYPE of $!pick[1] )

      if (!type eq 'STWALL' or !type eq 'WALL') then
        !element = !pick[1].dbRef()
        !index = !list.findFirst(!element)
        if (!index.unset()) then
          !list.append(!element)
          !unenhanceList.append(!pick[1])
          ENHANCE $!element
        else
          !list.remove(!index)
          !unenhanceList.remove(!index)
          UNENHANCE $!element
        endif
      endif

    enddo

    PROMPT ON
    UNENHANCE ALL FROM !unenhanceList

  else
    -- Default Mode
    !setDefault = true

  endif

  -- For each element we have found
  do !i indices !list
    if (!list[!i].type eq |STWALL| or !list[!i].type eq |WALL|) then
      !!ce = !list[!i]

      -- Set design parameters
      if (defined(!!cdcaDesp)) then
        do !j indices !!cdcaDesp
          DESP NUMBER $!j $!!cdcaDesp[$!j]
        enddo
      endif

      -- Set specification
      SPREF $!!cvWallSpec.spre
    endif
  enddo

  if (!!cvWallSpec.dflt.val or !setDefault) then
    -- Default Mode
    !!cvWallSpec.default = !!cvWallSpec.current

    if (defined(!!cdcaDesp)) then
      !!cvWallSpec.default.desp = ARRAY()
      do !i indices !!cdcaDesp
        !!cvWallSpec.default.desp[!i] = !!cdcaDesp[!i].real()
      enddo
    endif

    !!appDesMain.wallSpec.val = !!cvWallSpec.default.spre.catRef.namn & '(' & !!cvWallSpec.default.just & ')'
    handle any
      !!appDesMain.wallSpec.val = !!cvWallSpec.default.spre.tmpr.namn & '(' & !!cvWallSpec.default.just & ')'
    endhandle

  endif

  !!ce = !refe

endfunction
-- End of function definition for !!cvChangeWallSpec
