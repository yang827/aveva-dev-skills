--
-- Description:
-- Create a new floor element and a panel under it.
-- Then bring up 2D panel editor to allow user to define points.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvCreateFloor(!type is STRING)

call !!sctlCrElem(!type, |WANDF| )

call !!cvCreatePanel(!type)

endfunction
-- End of function definition for !!cvCreateFloor
