-- Created:         Thu Jul 10 11:52:01 1997
--
--
-- Description:
-- Create a Panel and bring up 2D panel editor
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      FLOOR/SCREED
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvCreatePanel(!type is STRING)

  -- Check valid specification

  if(!type.upcase() ne 'WALL' and ( Unset(!!cdFlorSpecD.spre.val) or length(!!cdFlorSpecD.spre.val) le 0 ) ) then
       !!messageFile.error(157, 2)
  endif

  -- Find a floor first
  if (!type.unset() or !type.empty()) then
    !owner = 'FLOOR'
    FLOOR
    handle any
      SCREED
      handle any
        WALL
        handle any
        elsehandle none
             !owner = 'WALL'
        endhandle
      elsehandle none
        !owner = 'SCREED'
      endhandle
     endhandle

  else
    $!type
    handle any
    endhandle
    !owner = !type
  endif

  if (!owner.upcase() eq 'WALL') then
    -- Navigate to current wall
    WALL
    handle any
      !unusedWall = !!sctlCrElem(|WALL|, |WANDF|)
    endhandle
  elseif (!owner.upcase() eq 'SCREED') then
    -- Navigate to current floor
    SCREED
    handle any
      -- -- Prompt user if ok to create new SCREED
      -- !answer = !!alert.confirm('No screed found - OK to create new')
      -- if (!answer ne 'YES') then
      --     return
      -- endif
      !floor = !!sctlCrElem(|SCREED|, |WANDF|)
    endhandle
  else
    -- Navigate to current floor
    FLOOR
    handle any
      -- -- Prompt user if ok to create new FLOOR
      -- !answer = !!alert.confirm('No floor found - OK to create new')
      -- if (!answer ne 'YES') then
      --     return
      -- endif
      !floor = !!sctlCrElem(|FLOOR|, |WANDF|)
    endhandle
  endif

  -- Now create the panel
  !panel = !!sctlCrElem('PANE', |WANDF| )

  if (Set(!panel.spre) and Set(!panel.spre.tmpr) ) then

    -- Set design parameters
    var !!cdcaAttr DELETE
    var !!cdcaAttd DELETE
    var !!cdcaDesp DELETE
    var !!cdcaPass DELETE
    !!cdcaPass[1] = 'Set Template Parameters'
    !!cdcaPass[2] = 'CALLCIV MPANELTMPL'
    !!cdcaPass[3] = ''
    $m "%PDMSUI%/DES/CLIB/XSETPROP" $<DEFINE$> $<$!<panel.spre>$> !!cdcaPass $<$!<panel>$>

  else
    -- Set up EDG
    call !!sctlPaveShow(!panel, !panel.position, !panel.ori, 'CREATE')
  endif

endfunction
-- End of function definition for !!cvCreatePanel
