-- Description:
-- Create a curved wall segment using 2D constructor
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvCreateSbWall()

  -- Check Wall Specification Set
  if (Undefined(!!cvWallSpec) or Unset(!!cvWallSpec.default.spre) ) then
    !!messageFile.error(157, 1)
  endif

  -- Navigate to current wall
  WALL
  handle any
    !unusedWall = !!sctlCrElem(|WALL|, |WANDF|)
  endhandle

  call !!sctlCrElem(|WALL|, |WANDF| )

  if (!!ce.type eq |WALL| and Set(!!ce.spre) and Set(!!ce.spre.tmpr) ) then
    -- Set design parameters
    var !!cdcaAttr DELETE
    var !!cdcaAttd DELETE
    var !!cdcaDesp DELETE
    var !!cdcaPass DELETE
    !!cdcaPass[1] = 'Set Template Parameters'
    !!cdcaPass[2] = '!!cvChangeWallSpec()'
    !!cdcaPass[3] = ''
    $m "%PDMSUI%/DES/CLIB/XSETPROP" $<MODIFY$> $<$!!<ce.owner.spre>$> $<!!cdcaPass$> $<$!!<ce.owner>$>

  else
    -- Set up EDG
    !pnode = !!strPnodeCreate(!!ce.owner, 'START', !!ce.owner.joiS)
    !pnode = !!strPnodeCreate(!!ce.owner, 'END', !!ce.owner.joiE)
    call !!sctlSpineShow(!!ce.owner, 'CREATE' )
  endif

endfunction
-- End of function definition for !!cvCreateSbWall
