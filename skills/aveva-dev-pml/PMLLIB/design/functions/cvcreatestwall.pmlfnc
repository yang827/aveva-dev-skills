-- Define function
define function !!cvCreateStWall()

  -- Check Wall Specification Set
  if (Undefined(!!cvWallSpec) or Unset(!!cvWallSpec.default.spre) ) then
    !!messageFile.error(157, 1)
  endif

  -- Navigate to current wall
  WALL
  handle any
    -- Prompt user if ok to create new WALL
    -- !answer = !!alert.confirm('No wall found - OK to create new')
    -- if (!answer ne 'YES') then
    --   return
    -- endif
    !unusedWall = !!sctlCrElem(|WALL|, |WANDF|)

  endhandle

  -- Create the straight wall using old PML!
  -- $M "%PDMSUI%/DES/STLWRK/XSCTNDEF" $<STWALL$>

  -- New Form for section definition in default mode for standard straight wall
  !!stlSection.createWall()

endfunction
-- End of function definition for !!cvCreateStWall
