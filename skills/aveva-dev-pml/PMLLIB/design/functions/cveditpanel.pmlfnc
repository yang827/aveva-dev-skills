--
-- Description:
-- Find panel and start up event driven graphics in edit mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvEditPanel()

  -- Find an extrusion
  NXTR
  handle any
    NREV
    handle any
      PANEL 1
      handle any
        EXTR
        handle any
          REVO
          handle any
            !!messageFile.error(157, 5)
          endhandle
        endhandle
      endhandle
    endhandle
  endhandle

  -- Output a more sensible error message

  -- Show panel editing form
  if (!!ce.hardType eq 'PANE' and Set(!!ce.spre) and Set(!!ce.spre.tmpr) ) then
    -- Set design parameters
    var !!cdcaAttr DELETE
    var !!cdcaAttd DELETE
    var !!cdcaDesp DELETE
    var !!cdcaPass DELETE
    !!cdcaPass[1] = 'Set Template Parameters'
    !!cdcaPass[2] = 'CALLCIV MPANELTMPL'
    !!cdcaPass[3] = ''
    $m "%PDMSUI%/DES/CLIB/XSETPROP" $<MODIFY$> $<$!!<ce.spre>$> $<!!cdcaPass$> $<$!!<ce>$>

  else
    -- Set up EDG
    !panel = !!ce
    call !!sctlPaveShow(!panel, !panel.position, !panel.ori, 'MODIFY')

  endif

endfunction
-- End of function definition for !!cvEditPanel
