--
--
-- Description:
-- Find a Sbwall and edit spine using 2D constructor
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!cvEditSbWall()

  SBWALL

  if (!!ce.type eq |WALL| and Set(!!ce.spre) and Set(!!ce.spre.tmpr) ) then
    -- Set design parameters
    var !!cdcaAttr DELETE
    var !!cdcaAttd DELETE
    var !!cdcaDesp DELETE
    var !!cdcaPass DELETE
    !!cdcaPass[1] = 'Set Template Parameters'
    !!cdcaPass[2] = '!!cvChangeWallSpec()'
    !!cdcaPass[3] = ''
    $m "%PDMSUI%/DES/CLIB/XSETPROP" $<MODIFY$> $<$!!<ce.owner.spre>$> $<!!cdcaPass$> $<$!!<ce.owner>$>

  else
    -- Set up EDG
    SPINE 1
    call !!sctlSpineShow(!!ce.owner, 'MODIFY')

  endif

endfunction
-- End of function definition for !!cvEditSbWall
