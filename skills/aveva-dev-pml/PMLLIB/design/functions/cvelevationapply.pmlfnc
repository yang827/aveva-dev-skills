--
--
-- Description:
-- Move the element to the specified elevation
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationApply()

!refe = !!ce

!list = ARRAY()

-- Build Array of Elements

if (!!cvElevation.name.val eq 'Element') then
-- Single Element
     !list[1] = !!cvElevation.element.val.dbRef()
else
-- List
     !list = !!getCurrentList()
     if (!list.unset() ) then
          !!messageFile.error(149, 1)
     endif
endif

do !member from 1 to !list.size()
-- Calculate Current position wrt datum
     !current = !list[!member].position.wrt(!!cvElevation.datum.val.dbRef() )
     handle any
          !current = !list[!member].owner.position.wrt(!!cvElevation.datum.val.dbRef() )
          handle any
               !current = !list[!member].owner.owner.position.wrt(!!cvElevation.datum.val.dbRef() )
               handle any
                    !current = !list[!member].owner.owner.owner.position.wrt(!!cvElevation.datum.val.dbRef() )
                    handle any
                          !!messageFile.error(157, 10)
                          return
                    endhandle
               endhandle
          endhandle
     endhandle

-- Calculate Movement
     !move = !!cvElevation.z.val.real() - !current.up
     !element = !!cvElevation.datum.val.dbRef()
-- Special Case handling for walls
     if (!!cvElevation.mode eq 'TOP') then
          !walls = !!collectAllFor('STWALL WALL','',!list[!member])
          if (!walls.size() gt 0) then
               do !index from 1 to !walls.size()
                    call !!civWallHeight(!walls[!index], !move, !element, 'TOP')
               enddo
          endif
     elseif (!!cvElevation.mode eq 'BOTTOM') then
          !walls = !!collectAllFor('STWALL WALL','',!list[!member])
          if (!walls.size() gt 0) then
               do !index from 1 to !walls.size()
                    !!ce = !walls[!index]
                    call !!civWallHeight(!walls[!index], !move, !element, 'BOTTOM')
               enddo
          endif
     endif
-- Move Element
     !!ce = !list[!member]
     BY U $!move WRT $!element
-- Make sure PNODE is in correct position
     if (!!cvElevation.mode eq 'TOP') then
          !nodes = !!collectAllFor('PNOD','',!list[!member])
          do !index values !nodes
                    !!ce = !index
                    BY D $!move WRT $!element
          enddo
     endif

enddo

-- Recalculate Value
!!ce = !refe
if (!!cvElevation.mode ne 'TOP' and !!cvElevation.mode ne 'BOTTOM' ) then
     !!cvElevation.z.val = !!cvElevation.element.val.dbRef().position.wrt(!!cvElevation.datum.val.dbRef() ).up.string()
     handle any
     endhandle
     call !!cvElevationValue()
endif

return

endfunction
-- End of function definition for !!cvElevationApply
