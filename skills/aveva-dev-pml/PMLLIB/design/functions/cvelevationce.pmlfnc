--
-- Description:
-- Set Form Values to those for current element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationCe(!element is DBREF)

UNENHANCE ALL

!!cvElevation.element.val = !element.fullName

!!cvElevation.name.val = 'Element'

call !!enhanceItem(!element, 'salmon')

endfunction
-- End of function definition for !!cvElevationCe
