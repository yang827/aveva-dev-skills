-- Description:
-- Dismiss Form and clear up EDG etc
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationDism()

-- Clear Aid Graphics

call !!clearAid('ARROW', 43011)
call !!clearAid('BOX', 43012)

-- Clear EDG

!!edgCntrl.remove('Element Elevation')
!!edgCntrl.remove('Point Elevation')

-- Unenhance element(s)

UNENHANCE ALL

endfunction
-- End of function definition for !!cvElevationDism
