-- Define function
define function !!cvElevationElem()

UNENHANCE ALL

-- Check Element is valid
call !!nameGadget(!!cvElevation.element, 'OLD')

call !!enhanceItem(!!edgGeomData.pickedItem,'salmon')

endfunction
-- End of function definition for !!cvElevationElem
