--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationElev(!mode is STRING)

!!edgCntrl.remove('Point Elevation')
!!edgCntrl.remove('Element Elevation')
!!edgCntrl.remove('Navigate Elevation')

!!cvElevation.mode = !mode

!packet = object EDGPACKET()
if (!mode eq 'TOP' ) then
     !prompt = 'Pick the Elevation for Top:'
elseif (!mode eq 'BOTTOM' ) then
     !prompt = 'Pick the Elevation for Bottom:'
else
     !prompt = 'Pick the Elevation:'
endif
!packet.defineWrapper('POSITION','!!cvElevationPos()',!prompt)
!packet.description = 'Point Elevation'

!!edgCntrl.add(!packet)


endfunction
-- End of function definition for !!cvElevationElev
