-- Define function
define function !!cvElevationInit()

!!cvElevation.datum.val = 'World'

call !!cvElevationCe(!!ce)

!!cvElevation.z.val = !!ce.position.wrt(WORLD).up.string()
handle any
     !!cvElevation.z.val = !!ce.owner.position.wrt(WORLD).up.string()
     handle any
          !!cvElevation.z.val = !!ce.owner.owner.position.wrt(WORLD).up.string()
          handle any
               !!cvElevation.z.val = !!ce.owner.owner.owner.position.wrt(WORLD).up.string()
          endhandle
     endhandle
endhandle

call !!cvElevationValue()

endfunction
-- End of function definition for !!cvElevationInit
