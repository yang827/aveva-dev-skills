-- Description:
-- Set form to operate on current list rather than specified element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationList()

UNENHANCE ALL

-- Change Form settings
!!cvElevation.name.val = 'Current List'
!!cvElevation.element.val = ''

-- Unenhance elements from current list

-- Set EDG for picking position

if (!!cvElevation.radio.val eq 3) then
     call !!cvElevationElev('TOP')
elseif (!!cvElevation.radio.val eq 2) then
     call !!cvElevationElev('BOTTOM')
else
    !!cvElevation.radio.val = 1
    call !!cvElevationElev('DEFAULT')
endif

endfunction
-- End of function definition for !!cvElevationList
