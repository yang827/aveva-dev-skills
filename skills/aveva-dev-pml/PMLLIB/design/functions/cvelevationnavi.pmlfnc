-- Description:
-- Put event driven graphics into navigate mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationNavi()

!!edgCntrl.remove('Point Elevation')
!!edgCntrl.remove('Element Elevation')
!!edgCntrl.remove('Navigate Elevation')

!packet = object EDGPACKET()

!packet.defineWrapper('ELEMENT','!!edgNavigate()','Navigate')
!packet.description = 'Navigate Elevation'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvElevationNavi
