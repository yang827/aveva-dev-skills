-- Description:
-- Move the owner of the currently specified owner
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationOwner()

if (!!cvElevation.name.val eq 'Element') then
     call !!cvElevationCe(!!cvElevation.element.val.dbRef().owner)
else
     call !!cvElevationCe(!!ce.owner)
endif

endfunction
-- End of function definition for !!cvElevationOwner
