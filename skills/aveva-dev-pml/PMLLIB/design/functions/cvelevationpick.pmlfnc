--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationPick()

-- Set up EDG to pick the element

!!edgCntrl.remove('Point Elevation')
!!edgCntrl.remove('Element Elevation')
!!edgCntrl.remove('Navigate Elevation')

!packet = object EDGPACKET()
!packet.defineWrapper('ELEMENT','!!cvElevationSave()','Pick an element')
!packet.description = 'Element Elevation'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvElevationPick
