-- Define function
define function !!cvElevationPos()

!!cvElevation.z.val = !!edgGeomData.position.wrt(!!cvElevation.datum.val.dbRef()).up.string()

call !!cvElevationValue()

endfunction
-- End of function definition for !!cvElevationPos
