-- Description:
-- Save the element picked as the element to be moved
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationSave()

UNENHANCE ALL

!!cvElevation.element.val = !!edgGeomData.pickedItem.fullName

!!cvElevation.name.val = 'Element'

call !!enhanceItem(!!edgGeomData.pickedItem,'salmon')

endfunction
-- End of function definition for !!cvElevationSave
