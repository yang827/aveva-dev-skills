-- Define function
define function !!cvElevationShow()

-- Show form
show !!cvElevation

-- Set up EDG for Picking a Position

!!cvElevation.radio.val = 1

call !!cvElevationElev('DEFAULT')

endfunction
-- End of function definition for !!cvElevationShow
