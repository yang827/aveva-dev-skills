-- Define function
define function !!cvElevationValue()

-- Clear Aids
call !!clearAid('ARROW', 43011)
call !!clearAid('BOX', 43012)

-- Define objects
!arrow = object ARROW()
!box = object BOX()

-- Calculate position for arrow

!arrow.pos.east = 0
!arrow.pos.north = 0
!arrow.pos.up = !!cvElevation.z.val.real() + 2000
!arrow.pos.origin = !!cvElevation.datum.val.dbRef()

-- Calculate direction for arrow
!arrow.dir.east = 0
!arrow.dir.north = 0
!arrow.dir.up = -1
!arrow.dir.origin = !!cvElevation.datum.val.dbRef()

-- Draw arrow
!arrow.ratio = 0.5
!arrow.length = 2000
call !!drawAidArrow(43011, !arrow)

-- Calculate position for box
!box.x = 1000
!box.y = 1000
!box.z = 100
!box.pos = !arrow.pos
!box.pos.up = !box.pos.up - 2050
!box.ori.alpha = 0
!box.ori.beta = 0
!box.ori.gamma = -1
!box.ori.origin = !!cvElevation.datum.val.dbRef()
!box.wrt = !!cvElevation.datum.val.dbRef()

-- Draw Box
call !!drawAidBox(43012, !box)

endfunction
-- End of function definition for !!cvElevationValue
