-- Description:
-- Change the reference element for the value
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvElevationWrt()

-- Check Element is valid
call !!nameGadget(!!cvElevation.datum, 'OLD')

-- Recalculate Value
if (!!cvElevation.datum.val ne 'unset') then
     !!cvElevation.z.val = !!cvElevation.element.val.dbRef().position.wrt(!!cvElevation.datum.val.dbRef() ).up.string()

-- Redisplay arrow
    call !!cvElevationValue()
endif
endfunction
-- End of function definition for !!cvElevationWrt
