-- Created:         Fri Mar 14 11:19:47 GMT 1997
--
--
-- Description:
-- Create a floor that follows the edges of a floor
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!cvFloorTraceFl()

  !ref = !!ce

  -- Find Element from EDG pick
  !panel = !!edgGeomData.pickedItem

  if (!panel.hardType ne 'PANE') then
    !!messageFile.error(157, 5)
  endif

  -- Find Panel Loop
  !message = STRING()
  !ploo = !!findFirstMember(!panel,|PLOO|, ||, !message)
  if (!ploo eq nulref) then
    !!messageFile.warning(157, 3)
    return
  endif

  !points = !ploo.mCount
  if (!points lt 3) then
    !!messageFile.warning(157, 4)
    return
  endif

  -- Calculate Position of panel vertices
  !positions = ARRAY()
  do !pave values !ploo.members
    !positions.append(!pave.pos.wrt(World))
  enddo

  -- get position of panel
  !panelPos = !panel.pos.wrt(World)

  -- Remember justification
  !!ce = !panel
  !ploo = PLOO 1
  !!ce = !ref

  -- get the storage area
  !store = !!getStorageArea('WANDF', 'SCREED')
  if(!store.unset()) then
    !store = !!ce
  endif

  -- navigate to storage area and create screed
  !!ce = !store
  NEW SCREED
  !posString = !panelPos.string()
  POS $!<posString>
  !newPanel = !!ce
  NEW PLOO
  !tstring = !!cdFloorSpec.thick.val
  if (!tstring.trim() eq '') then
    !thickness = 10
  else
    !thickness = !tstring.real()
  endif
  HEIGHT $!thickness

  -- Set Justification
  -- If panels are close use opposite justification
  !space = !newPanel.position.wrt(WORLD).up - !panel.position.wrt(WORLD).up
  if (!space.abs() lt !!ce.height) then
    if (!ploo.sjust eq 'DBOT' ) then
      !sjust = 'UTOP'
    elseif (!ploo.sjust eq 'UBOT' ) then
      !sjust = 'DTOP'
    elseif (!ploo.sjust eq 'DCEN' ) then
      !sjust = 'UCEN'
    elseif (!ploo.sjust eq 'UCEN' ) then
      !sjust = 'DCEN'
    elseif (!ploo.sjust eq 'UTOP' ) then
      !sjust = 'DBOT'
    else
      !sjust = 'UBOT'
    endif
  else
    -- Otherwise use the same justification
    !sjust = !ploo.sjust
  endif

  SJUST $!sjust

  -- Create Points
  do !i indices !positions
    NEW PAVE
    !posString = !positions[!i].string()
    POS $!<posString>
  enddo

  -- For each panel fitting in original panel create a cofitting
  !panelString = !panel.string()
  var !fittings COLLECT ALL (PFIT CMPF SBFI) FOR $!panelString
  do !fitting values !fittings
    NEW COFI
    PFREF $!fitting
  enddo

endfunction
-- End of function definition for !!cvFloorTraceFl
