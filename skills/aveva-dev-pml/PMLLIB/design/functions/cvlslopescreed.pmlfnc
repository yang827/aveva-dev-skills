--
--
-- Description:
-- Show slope screed form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Screed to update
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!cvlSlopeScreed(!element is DBREF)

  -- Check orientation has been loaded
  if(undefined(!!cvlSlopeScreed)) then
    pml reload form !!cvlSlopeScreed
  endif

  -- Setup form
  !!cvlSlopeScreed.setup(!element)

endfunction
-- End of function definition
