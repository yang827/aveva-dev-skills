-- Created:         Wed May 28 12:14:47 1997
--
--
-- Description:
-- Create a negative pyramid under the selected panel to model panel slope
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopeApp()

-- Check that low point has been set

if (!!cvPanelSlope.lowPoint.unset() ) then

     !!messageFile.error(157, 7)
     return

endif

!refe = !!ce

!message = STRING()
!ploo = object DBREF()

!panel = !!edgGeomData.pickedItem

if (!panel.type ne |PANE|) then

    !!messageFile.error(157, 5)
    return

endif

-- Find out the information we want as new EDG does not give it
 !extruInfo = !!lineOnExtrusion(!!edgGeomData.pickVector, !!edgGeomData.pickedItem)

-- Find vertices which make up selected edge
!first = !extruInfo.vertex
!vertexNumber = !first.owner.members.findFirst(!first)
if (!first.owner.members.size() eq !vertexNumber) then
     !second=!first.owner.members[1]
else
     !second=!first.owner.members[!vertexNumber + 1 ]
endif
-- Calculate Length of Edge
!distance = !first.position.distance(!second.position)

-- Calculate Mid-Point of Edge
 !ploo = !first.owner
handle any
    !ploo = !!findFirstMember(!panel, 'PLOO', '', !message)
endhandle
if (!ploo.sjust eq |DBOT| or !ploo.sjust eq |UBOT|) then
     !pPoint = 3
else
     !pPoint = 1
endif
!midPoint = !!consMidPoint(!first.ppos[!pPoint].wrt(!panel),  !second.ppos[!pPoint].wrt(!panel))

-- Find Position of Point on Plane of Panel
!plane = !!consPlanePanel(!panel, !pPoint, !ploo)
!planePoint = !!consPointOnPlane(!!cvPanelSlope.lowPoint, !plane)

-- Find Position of Point on Edge
!line = !!consLinePos(!first.ppos[!pPoint], !second.ppos[!pPoint], !message)
!linePoint = !!consPosNearLine(!planePoint, !line)

-- Determine height of negative pyramid
!height = !linePoint.distance( !planePoint)

-- Determine orientation of negative pyramid
!ori = !!consDirTo(!linePoint, !planePoint, !message)
if (!ori.unset() )then
     !!messageFile.error(157, 11)
endif

-- Determine maximum depth of pyramid
-- This pyramid needs
!negMax = (!height / !!cvPanelSlope.slope.val.real() )
-- Check existing pyramids to see if there is already one deeper
!npyr = ARRAY()
!npyr = !!collectAllFor('NPYR', '', !panel)
!size = !npyr.size()
if (!size gt 0) then
     do !index from 1 to !size
          if (!negMax lt ( !npyr[!index].xtop / 2 ) ) then
                !negMax = !npyr[!index].xtop / 2
          endif
      enddo
endif

-- Now check for confirmation
!increase = ( !ploo.height - !negMax ) lt !!cvPanelSlope.thick.val.real()


if (!!cvPanelSlope.confirm.val or !increase ) then
-- Identify Edge Picked
-- Mark with depth

    if (!increase ) then
           !message = 'OK to increase thickness to ' & STRING( (!!cvPanelSlope.thick.val.real() + !negMax ), 'D2') & ' and slope top of panel'
    else
           !message = 'OK to slope top of panel'
    endif

-- Enhance Panel Selected
    call !!enhanceItem(!panel,'salmon')

-- Ask User to Confirm
     !answer = !!alert.confirm(!message)
     UNENHANCE ALL
     if (!answer eq 'NO') then
           return
     endif
endif
-- Alter Panel Thickness if required
!change = 0
!adjust = 0
if (( !ploo.height - !negMax ) lt !!cvPanelSlope.thick.val.real() ) then
     !!ce = !ploo
     !value = !!cvPanelSlope.thick.val.real() + !negMax
     if (!ploo.sjust eq |UBOT| OR !ploo.sjust eq |DBOT|) then
          !change = !value - !ploo.height
          !adjust = !change
     else
          !change = !ploo.height - !value
     endif
     HEIGHT $!value
endif

-- Alter Negative Pyramids to have consistent depth

if (!size gt 0) then
     do !index from 1 to !size
          !!ce = !npyr[!index]
          !xtop = !!ce.xtop
          !value = !negMax * 2
          XTOP $!value
          XBOTTOM $!negMax
          !value = !negMax / 2
          XOFF $!value
          !value = ( !xtop / 8 - !negMax / 4  ) - !adjust
          BY X $!value WRT CE
      enddo
endif

-- Create negative Pyramid

!!ce = !panel

NEW NPYR
!posString = !midPoint.wrt(!panel).string().before('WRT')
POS $!posString
HEIGHT $!height
!oriString = !ori.string()

if (!oriString.before('WRT').trim().length() gt 1)then
     ORI P0 IS $!oriString
else
     ORI P0 IS $!oriString AND X IS D
endif
XBOTTOM $!negMax
YBOTTOM $!distance
YTOP 0
XTOP ( $!negMax * 2 )
XOFF ($!negMax / 2 )
!offset = !linePoint.wrt(!!ce).north - !midPoint.wrt(!!ce).north
YOFF $!offset
BY Y ($!offset / 2 ) WRT CE
BY Z ($!height / 2 ) WRT CE
!value = - !negMax / 4 - !change
BY X $!value WRT CE
if (!ploo.sjust eq |UTOP| OR !ploo.sjust eq |DTOP|) then
    !thick = -1 * !ploo.height
    BY X $!thick WRT CE
endif



!!ce = !refe

endfunction
-- End of function definition for !!cvPanelSlopeApp
