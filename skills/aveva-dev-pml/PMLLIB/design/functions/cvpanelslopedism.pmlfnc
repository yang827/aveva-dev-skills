-- Define function
define function !!cvPanelSlopeDism()

!!edgCntrl.remove('Panel Slope Low Point')

!!edgCntrl.remove('Panel Slope Edge')

call !!clearAid('SPHERE', 43002)

-- Clear Value
!!cvPanelSlope.lowPoint = object POSITION()

UNENHANCE ALL

endfunction
-- End of function definition for !!cvPanelSlopeDism
