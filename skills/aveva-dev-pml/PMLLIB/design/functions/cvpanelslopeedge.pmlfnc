-- Description:
-- Set up EDG to pick an edge of a panel
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopeEdge()

!!edgCntrl.remove('Panel Slope Edge')
!!edgCntrl.remove('Panel Slope Navigate')

!packet = object EDGPACKET()
!packet.defineWrapper('PANEL','!!cvPanelSlopeApp()','Pick an edge to slope panel from')
!packet.description = 'Panel Slope Edge'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvPanelSlopeEdge
