-- Define function
define function !!cvPanelSlopeInit()

if (!!isImperialLength('DIST')) then
     !!cvPanelSlope.thick.val = 3in
else
     !!cvPanelSlope.thick.val = 75mm
endif

!!cvPanelSlope.slope.val = 20
!!cvPanelSlope.percent.val = 5

-- Clear Value
!!cvPanelSlope.lowPoint = object POSITION()

!!cvPanelSlope.radio.val = 1

endfunction
-- End of function definition for !!cvPanelSlopeInit
