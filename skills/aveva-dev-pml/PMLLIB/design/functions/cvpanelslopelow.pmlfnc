--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopeLow()

!!edgCntrl.remove('Panel Slope Low Point')

!packet = object EDGPACKET()
!packet.defineWrapper('POSITION','!!cvPanelSlopeSave()','Pick the Low Point')
!packet.description = 'Panel Slope Low Point'


!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvPanelSlopeLow
