-- Description:
-- Put event driven graphics into navigate mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopeNavi()

!!edgCntrl.remove('Panel Slope Navigate')
!!edgCntrl.remove('Panel Slope Edge')

!packet = object EDGPACKET()
!packet.defineWrapper('ELEMENT','!!edgNavigate()','Navigate')
!packet.description = 'Panel Slope Navigate'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvPanelSlopeNavi
