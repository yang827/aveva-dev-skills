-- Description:
-- Calculate percentage value based on slope
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopePcnt()

!!cvPanelSlope.percent.val = 100 / !!cvPanelSlope.slope.val

endfunction
-- End of function definition for !!cvPanelSlopePcnt
