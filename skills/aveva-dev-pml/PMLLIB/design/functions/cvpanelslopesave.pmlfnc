--
-- Description:
-- Save picked position as a member of the form for low point
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopeSave()

-- Extract information from EDG
!!cvPanelSlope.lowPoint = !!edgGeomData.position
 !position = !!cvPanelSlope.lowPoint

-- Draw Aid Sphere at Point

if (!!edgGeomData.pickedItem.set() and !!edgGeomData.pickedItem.badref().not() and !!edgGeomData.pickedItem.type eq |PANE| ) then
     !message = STRING()
     !ploo = !!findFirstMember(!!edgGeomData.pickedItem, 'PLOO', '', !message)
     if (!ploo.height gt 500) then
          !diameter = !ploo.height
     else
          !diameter = 500
     endif
     !position.up = !position.up + !ploo.height
else
    !diameter = 500
endif

call !!clearAid('SPHERE', 43002)
call !!drawAidSphere(!diameter,!!cvPanelSlope.lowPoint,43002)

-- Prompt User for Edge
call !!cvPanelSlopeEdge()

!!cvPanelSlope.radio.val = 2

endfunction
-- End of function definition for !!cvPanelSlopeSave
