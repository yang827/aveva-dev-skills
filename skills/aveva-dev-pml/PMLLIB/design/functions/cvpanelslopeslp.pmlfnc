-- Description:
-- Set the slope gadget value based on the percentage value
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelSlopeSlp()

!!cvPanelSlope.slope.val =  100 / !!cvPanelSlope.percent.val

endfunction
-- End of function definition for !!cvPanelSlopeSlp
