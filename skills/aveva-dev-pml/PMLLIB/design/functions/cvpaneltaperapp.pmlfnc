--
--
-- Description:
-- Create Taper as NPYR under Panel to taper edge
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelTaperApp()

!refe = !!ce

!message = STRING()
!ploo = object DBREF()

!panel = !!edgGeomData.pickedItem

if (!panel.type ne |PANE|) then

    !!messageFile.error(157, 5)
    return

endif
-- Find out the information we want as new EDG does not give it
 !extruInfo = !!lineOnExtrusion(!!edgGeomData.pickVector, !!edgGeomData.pickedItem)

-- Find vertices which make up selected edge
!first = !extruInfo.vertex

!vertexNumber = !first.owner.members.findFirst(!first)
if (!first.owner.members.size() eq !vertexNumber) then
     !second=!first.owner.members[1]
else
     !second=!first.owner.members[!vertexNumber + 1 ]
endif
-- Calculate Length of Edge
!distance = !first.position.distance( !second.position)

-- Calculate Mid-Point of Edge

!midPoint = !!consMidPoint(!first.pPos[1].wrt(!panel),  !second.pPos[1].wrt(!panel))

-- Find Position of Point on Plane of Panel
!plane = !!consPlanePanel(!panel, 1, !ploo)
!planePoint = !!consPointOnPlane(!!edgGeomData.position, !plane)

-- Find Position of Point on Edge
!line = !!consLinePos(!first.pPos[1], !second.pPos[1], !message)
!linePoint = !!consPosNearLine(!planePoint, !line)

-- Determine height of negative pyramid
!height = (!ploo.height - !!cvPanelTaper.thick.val.real() ) * !!cvPanelTaper.slope.val.real()
if (!height lt 0) then
     !!messageFile.error(157, 6)
     return
endif

-- Determine orientation of negative pyramid
!ori = !!consDirTo(!linePoint, !planePoint, !message)
if (!ori.unset()) then
      !!messageFile.error(157, 11)
      return
endif

-- Now check for confirmation

if (!!cvPanelTaper.confirm.val) then
-- Identify Edge Picked
-- Enhance Panel Selected
    call !!enhanceItem(!panel,'salmon')
-- Mark with depth
    !value = !!cvPanelTaper.thick.val.real()
    call !!drawAidText(!value.string('D0'), !midPoint.wrt(WORLD), 43001 )
-- Ask User to Confirm
     !answer = !!alert.confirm('OK to taper bottom of panel')
     UNENHANCE ALL
     call !!clearAid('TEXT', 43001)
     if (!answer eq 'NO') then
           return
     endif
endif

-- Create negative Pyramid

!!ce = !panel

NEW NPYR
!posString = !midPoint.wrt(!panel).string().before('WRT')
POS $!posString
!value = 2 * !height
HEIGHT $!value
!oriString = !ori.string()
ORI P0 IS $!oriString AND X IS D

-- Set size
!depth = (2 * (!ploo.height - !!cvPanelTaper.thick.val.real() ) )
XBOTTOM $!depth
!width = 2 * !distance
YBOTTOM $!width
XTOP 0
YTOP $!width
!value = !depth / 2
XOFF $!value

-- Move it to correct position

BY Z ($!height / 2 ) WRT CE


!!ce = !refe


endfunction
-- End of function definition for !!cvPanelTaperApp
