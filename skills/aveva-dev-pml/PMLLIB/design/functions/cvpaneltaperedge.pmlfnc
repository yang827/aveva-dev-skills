--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelTaperEdge()

!!edgCntrl.remove('Panel Taper Edge')
!!edgCntrl.remove('Panel Taper Navigate')

!packet = object EDGPACKET()
!packet.defineWrapper('PANEL','!!cvPanelTaperApp()','Pick an edge to taper')
!packet.description = 'Panel Taper Edge'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvPanelTaperEdge
