-- Define function
define function !!cvPanelTaperInit()

if (!!isImperialLength('DIST')) then
     !!cvPanelTaper.thick.val = 8in
else
     !!cvPanelTaper.thick.val = 200mm
endif

!!cvPanelTaper.slope.val = 5

!!cvPanelTaper.percent.val = 20

!!cvPanelTaper.radio.val = 1

call !!cvPanelTaperEdge()

endfunction
-- End of function definition for !!cvPanelTaperInit
