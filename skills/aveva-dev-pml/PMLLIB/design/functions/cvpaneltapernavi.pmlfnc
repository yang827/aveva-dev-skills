--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvPanelTaperNavi()

!!edgCntrl.remove('Panel Taper Edge')
!!edgCntrl.remove('Panel Taper Navigate')

!packet = object EDGPACKET()
!packet.defineWrapper('PANEL','!!edgNavigate()','Navigate')
!packet.description = 'Panel Taper Navigate'


!!edgCntrl.add(!packet)


endfunction
-- End of function definition for !!cvPanelTaperNavi
