-- Define function
define function !!cvSetCurLevel()

!!cdCivApp.level.val = !!cdCivApp.floor.val.dbRef().owner.up.string()
handle any
     !!cdCivApp.level.val = |<unset>|
     return
endhandle

endfunction
-- End of function definition for !!cvSetCurLevel
