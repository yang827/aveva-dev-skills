--
-- Description:
-- Method to set up event driven graphics for cvTraceFloor Form
-- to navigate to picked object
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceFloorNavi()

!!edgCntrl.remove('Trace Floor')

!packet = object EDGPACKET()
!packet.defineWrapper('ELEMENT','!!edgNavigate()','Navigate')
!packet.description =  'Trace Floor'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvTraceFloorNavi
