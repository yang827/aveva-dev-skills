--
--
-- Description:
-- Method to set up event driven graphics for CvTraceFloor Form
-- to trace screed around floor
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceFloorScre()

  -- Trap templates
  if (Defined(!!cdFlorSpecD) and !!cdFlorSpecD.spre.val ne '' and Set(!!cdFlorSpecD.spre.val.dbRef().tmpr) ) then
       !!messageFile.error(157, 8)
       return
  endif

  if (undefined(!!cvTraceFloor)) then
    pml load form !!cvTraceFloor
  endif
  !!cvTraceFloor.radio.val = 2

  !!edgCntrl.remove('Trace Floor')

  !packet = object EDGPACKET()
  !packet.defineWrapper('PANEL','!!cvFloorTraceFl()','Pick a Floor to Trace with Screed')
  !packet.description =  'Trace Floor'
  !packet.form = !!cvTraceFloor
  !packet.remove = false

  !!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvTraceFloorScre
