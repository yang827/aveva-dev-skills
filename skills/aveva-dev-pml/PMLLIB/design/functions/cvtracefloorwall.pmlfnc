--
--
-- Description:
-- Method to set up event driven graphics for CvTraceFloor Form
-- to trace walls
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceFloorWall()

  -- Trap templates
  if (Defined(!!cvWallSpec) and Set(!!cvWallSpec.default) and Set(!!cvWallSpec.default.spre) and Set(!!cvWallSpec.default.spre.tmpr) ) then
    !!messageFile.error(157, 9)
    return
  endif

  if (undefined(!!cvTraceFloor)) then
    pml load form !!cvTraceFloor
  endif
  !!cvTraceFloor.radio.val = 1

  !!edgCntrl.remove('Trace Floor')

  !packet = object EDGPACKET()
  !packet.defineWrapper('PANEL','!!cvWallTraceLoop()','Pick a Floor to Trace with Walls')
  !packet.description = 'Trace Floor'
  !packet.form = !!cvTraceFloor
  !packet.remove = false

  !!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvTraceFloorWall
