-- Author:          S.Hudson,,,
-- Created:         Mon Jul 14 17:08:36 1997
--
--
-- Description:
-- Create Floor and connect to traced walls
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!cvTraceWallApply()

  !ref = !!ce

  !size = !!cvTraceWall.points.size()

  if (!size gt 2) then

    -- get the storage area
    !store = !!getStorageArea('WANDF', 'SCREED')
    if(!store.unset()) then
      !store = !!ce
    endif

    -- navigate to storage area and create floor
    !!ce = !store
    NEW FLOOR
    !posString = !!cvTraceWall.points[1].wrt(World).string()
    POS $!<posString>
    NEW PLOO
    !tstring = !!cdFloorSpec.thick.val
    if (!tstring.trim() eq '') then
      !thickness = 10
    else
      !thickness = !tstring.real()
    endif
    HEIGHT $!thickness

    -- Set Justification
    SJUST DTOP

    -- Create Points

     do !i indices !!cvTraceWall.points
       NEW PAVE
       !pave[!i] = !!ce
       !posString = !!cvTraceWall.points[!i].wrt(World).string()
       POS $!<posString>
     enddo

    -- create links to all walls
    !noWalls = !!cvTraceWall.walls.size()
    if (!noWalls gt 1) then
      -- For each wall
      do !index from 1 to !noWalls
        !jusl = !!cvTraceWall.walls[!index].jusl
        if (!jusl.occurs('BOW') gt 0 ) then
          !jusl = !jusl.replace(|BOW|,|TOW|)
        else
          !jusl = !jusl.replace(|TOW|,|BOW|)
        endif

        if (!index lt !size) then
          !linear = !!cvWallLinJoint(!!cvTraceWall.walls[!index], !jusl, !pave[!index] )
        else
          !linear = !!cvWallLinJoint(!!cvTraceWall.walls[!index], !jusl, !pave[!index] )
        endif
      enddo
    endif
  endif

  !!cvTraceWall.accept.active = False
  !!cvTraceWall.reverse.active = False

  -- clear any highlighted elements
  do !i indices !!cvTraceWall.walls
    !!enhanceItem(!!cvTraceWall.walls[!i], '')
  enddo

  !!ce = !ref

endfunction
-- End of function definition for !!cvTraceWallApply
