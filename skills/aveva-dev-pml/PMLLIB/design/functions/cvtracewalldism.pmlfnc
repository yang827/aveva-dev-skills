--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceWallDism()

  !!edgCntrl.remove('Trace Wall')

  -- clear any highlighted elements
  do !i indices !!cvTraceWall.walls
    !!enhanceItem(!!cvTraceWall.walls[!i], '')
  enddo

endfunction
-- End of function definition for !!cvTraceWallDism
