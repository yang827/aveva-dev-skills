-- Description:
-- Trace around walls from picked wall
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceWallFind()

  -- Clear array
  !!cvTraceWall.walls = ARRAY()

  -- Set Direction
  if (!!cvTraceWall.direction) then
    !string = |START|
  else
    !string = |END|
  endif

  -- clear any highlighted elements
  do !i indices !!cvTraceWall.walls
    !!enhanceItem(!!cvTraceWall.walls[!i], '')
  enddo

  -- Find Points for Panel
  !!cvTraceWall.points = !!sctlTraceElement (!!edgGeomData.pickedItem, !string, !!cvTraceWall.sense, !!cvTraceWall.walls)

  !!cvTraceWall.reverse.active = True
  !!cvTraceWall.accept.active = True

endfunction
-- End of function definition for !!cvTraceWallFind
