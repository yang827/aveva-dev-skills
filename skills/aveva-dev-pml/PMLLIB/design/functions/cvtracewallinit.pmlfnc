-- Define function
define function !!cvTraceWallInit()

!!cvTraceWall.sense = True
!!cvTraceWall.direction = True

!!cvTraceWall.reverse.active = false
!!cvTraceWall.accept.active = false

endfunction
-- End of function definition for !!cvTraceWallInit
