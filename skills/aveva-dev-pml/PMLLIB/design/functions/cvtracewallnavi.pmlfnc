-- Description:
-- Put event driven graphics into navigate mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceWallNavi()

!!edgCntrl.remove('Trace Wall')
!!edgCntrl.remove('Trace Wall Navigate')

!packet = object EDGPACKET()
!packet.defineWrapper('ELEMENT','!!edgNavigate()','Navigate')
!packet.description = 'Trace Wall Navigate'


!!edgCntrl.add(!packet)



endfunction
-- End of function definition for !!cvTraceWallNavi
