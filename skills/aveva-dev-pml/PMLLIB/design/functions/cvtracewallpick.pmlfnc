-- Description:
-- Set up EDG to pick a wall to trace from
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceWallPick()

!!edgCntrl.remove('Trace Wall')
!!edgCntrl.remove('Trace Wall Navigate')

!packet = object EDGPACKET()
!packet.defineWrapper('SECTION','!!cvTraceWallFind()','Pick a Wall to Trace with Floor')
!packet.description = 'Trace Wall'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!cvTraceWallPick
