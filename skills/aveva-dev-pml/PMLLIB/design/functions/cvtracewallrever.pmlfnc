--
-- Description:
-- Try an alternative trace with different direction or sense
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvTraceWallRever()

if (!!cvTraceWall.sense and !!cvTraceWall.direction) then
     !!cvTraceWall.sense = False
elseif (not !!cvTraceWall.sense and  !!cvTraceWall.direction) then
     !!cvTraceWall.direction = False
elseif (not !!cvTraceWall.sense and not !!cvTraceWall.direction) then
     !!cvTraceWall.sense = True
elseif ( !!cvTraceWall.sense and not !!cvTraceWall.direction) then
     !!cvTraceWall.direction = True
endif

-- Try again
call !!cvTraceWallFind()

endfunction
-- End of function definition for !!cvTraceWallRever
