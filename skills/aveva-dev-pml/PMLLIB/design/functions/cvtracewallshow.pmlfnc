-- Define function
define function !!cvTraceWallShow()

-- Trap templates
if (defined(!!cdFlorSpecD) and !!cdFlorSpecD.spre.val.dbRef().set() and !!cdFlorSpecD.spre.val.dbRef().tmpr.set()) then
     !!messageFile.error(157, 8)
     return
endif

-- Show form
show !!cvTraceWall

-- Set up EDG
call !!cvTraceWallPick()

endfunction
-- End of function definition for !!cvTraceWallShow
