--
--
-- Description:
-- Pick two wall ends and mitre them
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallCrMitre()

  !refe = !!ce

  label /START

  -- Pick ends
  do !index from 1 to 2
    -- Call Macro
    $M "%PDMSUI%/DES/CLIB/RVECDATP" $<ID$> $<Pick end of wall to be mitred$> $<STWALL$>
     if($!!cdRtnStatus neq 0) then
           return
     endif
    !walls[!index] = !!cdpnRtn.dbRef()
    !ends[!index] =  !!cdcnEnd
  enddo

  -- What if user has picked the same wall twice ?
  -- Start all over again.
  if (!walls[1] eq !walls[2]) then
    !!alert.message('The same wall was picked twice. Repick 2 walls to mitre together.')
    golabel /START
  endif

  -- Mitre ends

  call !!strMitre (!walls[1], !ends[1], !walls[2], !ends[2])

  !!ce = !refe

endfunction
-- End of function definition for !!cvWallCrMitre
