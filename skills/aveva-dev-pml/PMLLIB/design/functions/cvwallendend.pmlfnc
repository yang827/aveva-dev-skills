--
-- Description:
-- Pick two wall ends, connect and mitre them
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallEndEnd()

  -- Define Event packet for picking walls
  !packet             = object EDGPACKET()
  !packet.description = 'Civil Wall Ends Connect'
  !packet.key         = 'CIVWALLENDS'
  !packet.type        = 'DBMODIFY'
  !packet.action      = '!!cvlWallEndsMove(0,  !this.return[1])'
  !packet.close       = '!!cvlWallEndsMove(-1, !this.return)'
  !packet.remove      = false

  -- Define the picks
  !packet.pickPacket.prompt = ''

  -- Rule for picking
  !rule = 'TYPE inset(|WALL|,|STWALL|) and !!dbRefUpdatable(CE)'

  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('First wall end')
  !packet.pickPacket.picks[1].pick.input[3]   = !rule
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.pickPacket.picks[1].action          = '!!cvlWallEndsMove(1, !this.return[1])'

  !packet.pickPacket.picks[2]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdElement('Second wall end')
  !packet.pickPacket.picks[2].pick.input[3]   = !rule
  !packet.pickPacket.picks[2].pick.modifiable = false
  !packet.pickPacket.picks[2].action          = '!!cvlWallEndsMove(2, !this.return[1])'

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endfunction
-- End of function definition for !!cvWallEndEnd
