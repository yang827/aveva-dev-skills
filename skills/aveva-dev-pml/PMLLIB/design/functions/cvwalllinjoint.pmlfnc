--
--
-- Description:
-- Create a section linear joint between the given wall and the given panel vertices
-- Only first vertex is connected at present as using SELJ
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Wall
--    2   R      string      Pline in wall to be used
--    3   R      dbref       Panel Vertex to connect first vertex
-- Return:
--   [Data Type] [Description]
--    dbref       SELJ
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallLinJoint(!wall is DBREF, !posl is STRING, !first is DBREF) is DBREF

-- Forget it if cannot connect to panel vertex
if ( not !!dbRefUpdate(!first) ) then
      return object DBREF()
endif

!refe = !!ce
-- Create Linear Joint

!!ce = !wall

!return = !!sctlCrElem (|SELJ|,|WANDF|)

-- Create First Vertex
!firstVertex = !!sctlCrElem (|SEVE|, |WANDF|)
POSL $!posl
!element = !first.string()
ZDIST THROUGH $!element
LINK VERTEX $!first TO VERTEX $!firstVertex

-- Finish
!!ce = !refe
return !return

endfunction
-- End of function definition for !!cvWallLinJoint
