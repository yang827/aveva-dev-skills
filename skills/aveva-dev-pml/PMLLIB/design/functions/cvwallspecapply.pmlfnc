-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecApply()

  -- initialise variables for design parameters
  var !!cdcaAttr DELETE
  var !!cdcaAttd DELETE
  var !!cdcaDesp DELETE
  var !!cdcaPass DELETE

  -- set default mode
  !mode = 'DEFINE'

  if (!!cvWallSpec.mode.upcase() eq 'CE' ) then
    -- Current Element Mode
    !!cdcaPass[1] = 'Modify Values for Current Element'

  elseif (!!cvWallSpec.mode.upcase() eq 'LIST' ) then
    -- List Mode
    !!cdcaPass[1] = 'Modify Values for Current List'

  elseif (!!cvWallSpec.mode.upcase() eq 'PICK' ) then
    -- Pick Mode
    !!cdcaPass[1] = 'Modify Values for Picked Walls'

  else
    -- Default Mode
    !!cdcaPass[1] = 'Set Default Values'

  endif

  !!cdcaPass[2] = '!!cvChangeWallSpec()'
  !!cdcaPass[3] = '!!cvWallSpecCancel()'

  $m "%PDMSUI%/DES/CLIB/XSETPROP" $!<mode> $<$!!<cvWallSpec.current.spre>$> $<!!cdcaPass$> $<$!!<cvWallSpec.element>$>

endfunction
-- End of function definition for !!cvWallSpecApply
