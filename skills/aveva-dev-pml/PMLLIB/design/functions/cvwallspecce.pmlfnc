-- Define function
define function !!cvWallSpecCe()

     !!cvWallSpec.mode = |CE|

     !!cvWallSpec.element = !!ce

     !!cvWallSpec.ceName.val = FLNM
-- temporary fix

-- Save information from form
     if (!!ce.spref.set() ) then
          !!cvWallSpec.current.spre = !!ce.spre

          !!cvWallSpec.current.spec = !!ce.spre.owner.owner

          !!cvWallSpec.current.gtyp = !!ce.spre.owner

          if (!!ce.hardType eq 'SCTN' ) then

               !!cvWallSpec.current.just = !!ce.jusl
               !!cvWallSpec.current.meml = !!ce.meml
               !!cvWallSpec.current.jLin = !!ce.jLin
               !!cvWallSpec.current.desp = !!ce.desp

          elseif (!!ce.hardType eq 'GENSEC' ) then

               !!cvWallSpec.current.just = !!ce.jusl
               !!cvWallSpec.current.meml = !!ce.meml
               !!cvWallSpec.current.jLin = !!ce.jlnStart
               !!cvWallSpec.current.desp = !!ce.desp

          endif

    endif

-- Update Form

-- Update Spec etc
     call !!cvWallSpecLoad()

-- Update Pline gadgets

     !!cvWallSpec.just.select('RTEXT', !!cvWallSpec.current.just.string() )
     handle any
     endhandle
     !!cvWallSpec.meml.select('RTEXT', !!cvWallSpec.current.meml.string() )
     handle any
     endhandle
     !!cvWallSpec.jLin.select('RTEXT', !!cvWallSpec.current.jLin.string() )
     handle any
     endhandle


endfunction
-- End of function definition for !!cvWallSpecCe
