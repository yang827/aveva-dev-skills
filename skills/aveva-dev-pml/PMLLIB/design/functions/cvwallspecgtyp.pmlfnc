--
--
-- Description:
-- Load available wall profiles into gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecGtyp(!element is DBREF) is BOOLEAN

if (Set(!element) ) then

-- Find Selectors under Spec

    if (!element.mCount gt 0) then

--  Default to first member of list

         !position = 1

--  Collect information we need from members

         do !index from 1 to !element.mCount()

              !gtypes[!index] = !element.members[!index]

--  Check if this one currently selected
              if (!gtypes[!index] eq !!cvWallSpec.current.gtyp) then
                    !position = !index
              endif

--  Load arrays for gadgets
              !desc[!index] = !gtypes[!index].desc

              !memberString[!index] = !gtypes[!index].string()

         enddo

-- Setup gadget

         !!cvWallSpec.gtyp.dText = !desc

         !!cvWallSpec.gtyp.rText = !memberString

-- Save setting

         !!cvWallSpec.current.gtyp = !gtypes[!position]

         !!cvWallSpec.gtyp.val = !position

-- Update List

         call !!cvWallSpecList(!!cvWallSpec.current.gtyp)

         return

     endif

endif

-- Something went wrong so tell the user

!desc[1] = |None Available|

!!cvWallSpec.gtyp.dText = !desc

!desc[1] = |Nulref|

!!cvWallSpec.gtyp.rText = !desc

!!cvWallSpec.current.gtyp = NULREF

endfunction
-- End of function definition for !!cvWallSpecGtyp
