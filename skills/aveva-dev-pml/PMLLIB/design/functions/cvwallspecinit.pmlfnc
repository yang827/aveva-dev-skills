-- Define function
define function !!cvWallSpecInit() is BOOLEAN

-- default material selection removed (6/7/98)
-- if (defined(!!sctlMaterial) and Set (!!cvWallSpec.current.spec) and !!cvWallSpec.material eq !!sctlMaterial.default) then
--      return
-- endif
if (!!cvWallSpec.current.spec.set()) then
     return
endif

--  Get Wall Specifications and set remaining gadgets

call !!cvWallSpecLoad()

endfunction
-- End of function definition for !!cvWallSpecInit
