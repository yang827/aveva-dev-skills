-- Created:         Mon Feb 24 15:54:43 GMT 1997
--
--
-- Description:
-- Method to apply wall specification to current list
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Selector specified for Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecList(!element is DBREF)

if (Set(!element) ) then

-- Find Components under Selector

    if (!element.mCount gt 0) then

 -- Extract Catalogue References

         do !index from 1 to !element.mCount

              !sprefs[!index] = !element.members[!index]

         -- Only include if element is SPCO
              if ( !sprefs[!index].type eq |SPCO| ) then

                 if ( Set(!sprefs[!index].catRef) ) then

         -- Has a catalogue reference
                    !desc[!index] = !sprefs[!index].catRef.name
                    !refer[!index] = !sprefs[!index].string()

                 elseif ( Set(!sprefs[!index].tmpr) ) then

         -- Has a template reference
                    !desc[!index] = !sprefs[!index].tmpr.name
                    !refer[!index] = !sprefs[!index].string()

                 else
         -- Does not have valid catref or tmpref
                    !sprefs[!index].delete()

                 endif
              else
         -- Is not a SPCO
                    !sprefs[!index].delete()
              endif

         enddo

 -- Remove any blanks

         !sprefs.compress()
         !desc.compress()

-- Sort arrays in order of description

         !sort = !desc.sortedIndices()

         !desc.reindex(!sort)
         !refer.reindex(!sort)
         !sprefs.reindex(!sort)

-- Save values against gadget

         !!cvWallSpec.spre.dText = !desc
         !!cvWallSpec.spre.rText = !refer

         !position = !sprefs.findFirst(!!cvWallSpec.current.spre)
         if (Unset(!position) ) then
              !position = 1
         endif

         !!cvWallSpec.current.spre = !sprefs[!position]
         !!cvWallSpec.spre.val = !position

         !!cvWallSpecSpre(!!cvWallSpec.current.spre)

         return

     endif

endif

-- Something went wrong so tell the user

!desc[1] = |None Available|

!!cvWallSpec.spre.dText = !desc

!refer[1] = |Nulref|

!!cvWallSpec.spre.rText = !refer

!!cvWallSpec.current.spre = NULREF

endfunction
-- End of function definition for !!cvWallSpecList
