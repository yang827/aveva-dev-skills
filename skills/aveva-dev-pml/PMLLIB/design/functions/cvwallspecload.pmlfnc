--
--
-- Description:
-- Method to load available specifications into Form
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecLoad()

!message = STRING()
!specs[1] = object DBREF()
!material = object DBREF()

-- default material selection removed (6/7/98)
-- if (defined(!!sctlMaterial)  )then
--      !material = !!sctlMaterial.default
--
-- -- Save material used for this form
--      !!cvWallSpec.material = !!sctlMaterial.default
--
-- endif

if ( !!findSpecs(|STL|,|WALL|,!material,!message,!specs) ) then

     !position = 1

     do !index from 1 to !specs.size()

          !desc[!index] = !specs[!index].desc
          !text[!index] = !specs[!index].string()
          if (!specs[!index] eq !!cvWallSpec.current.spec ) then
               !position = !index
          endif

     enddo

     !!cvWallSpec.spec.dText = !desc

     !!cvWallSpec.spec.rText = !text

     !!cvWallSpec.current.spec = !specs[!position]

     !!cvWallSpec.spec.val = !position

      !!cvWallSpec.apply.active = true

else

     !specDesc[1] = |No Wall Specs Found|

     !text[1] = |nulref|

     !!cvWallSpec.spec.dText = !specDesc

     !!cvWallSpec.spec.rText = !text

     !!cvWallSpec.apply.active = false

endif


-- Update gtypes

call !!cvWallSpecGtyp(!!cvWallSpec.current.spec)

endfunction
-- End of function definition for !!cvWallSpecLoad
