--
-- Description:
-- Method to set details of Current Element
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [STRING] [Mode]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecSetCe(!mode is STRING)

  if (!mode.upcase() eq 'CE') then
    !!cvWallSpecCe()

  elseif (!mode.upcase() eq 'LIST') then

    var !numb ($_CDCLIST_NAME)
    if (!numb.real() eq 0) then
      !!alert.error('No List Defined')
      if (!!cvWallSpec.mode.upcase() eq 'CE') then
        !!cvWallSpec.ce.select('dtext', 'CE')
      elseif (!!cvWallSpec.mode.upcase() eq 'PICK') then
        !!cvWallSpec.ce.select('dtext', 'Pick')
      else
        !!cvWallSpec.ce.select('dtext', 'CE')
        !!cvWallSpecCe()
      endif

    else
      !!cvWallSpecColl()
    endif

  elseif (!mode.upcase() eq 'PICK') then
    !!cvWallSpecPick()

  elseif (!mode.upcase() eq 'DEFAULT') then
    !!cvWallSpecDflt()

  endif

endfunction
-- End of function definition for !!cvWallSpecSetCe
