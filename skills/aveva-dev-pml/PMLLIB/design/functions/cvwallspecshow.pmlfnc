--
--
-- Description:
-- Show the wall specification form for the specified use
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     String      Mode (DFLT, CE or FORM)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecShow(!mode is STRING)


-- show form
show !!cvWallSpec

if (!mode.upcase() eq |CE| ) then

    if (!!ce.hardType eq 'SCTN' or !!ce.hardType eq 'GENSEC' ) then

         call !!cvWallSpecSetCe('CE')

         !!cvWallSpec.wflg.active = True
         !!cvWallSpec.fflg.active = True
         !dText[1] = 'CE'
         !dText[2] = 'List'
         !dText[3] = 'Pick'
         !!cvWallSpec.ce.dText = !dText
         !!cvWallSpec.ce.active = true

     else

         call !!cvWallSpecSetCe('Default')

         !!cvWallSpec.wflg.active = False
         !!cvWallSpec.fflg.active = False
         !dText[1] = 'Default'
         !!cvWallSpec.ce.dText = !dText
         !!cvWallSpec.ce.active = false

         !!messageFile.error(155, 17)

     endif

else

     call !!cvWallSpecSetCe('Default')

     !!cvWallSpec.wflg.active = False
     !!cvWallSpec.fflg.active = False
     !dText[1] = 'Default'
     !!cvWallSpec.ce.dText = !dText
     !!cvWallSpec.ce.active = false

endif


endfunction
-- End of function definition for !!cvWallSpecShow
