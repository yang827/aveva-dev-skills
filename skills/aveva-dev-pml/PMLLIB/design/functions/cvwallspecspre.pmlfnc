-- Description:
-- Method to load details of selected spref
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Specification Component
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallSpecSpre(!spre is DBREF)

-- Set Pline Values

!message = STRING()

-- Update Gadgets

call !!sctlPlineList(!spre, |NULL|, !message, !!cvWallSpec.just )

call !!sctlPlineList(!spre, |NULL|, !message, !!cvWallSpec.meml )

call !!sctlPlineList(!spre, |NULL|, !message, !!cvWallSpec.jLin )

-- Save Current Settings
!!cvWallSpec.current.just = !!cvWallSpec.just.dText[1]
!!cvWallSpec.current.meml = !!cvWallSpec.meml.dText[1]
!!cvWallSpec.current.jLin = !!cvWallSpec.jLin.dText[1]
!!cvWallSpec.current.spre = !spre

-- Display updated plot

-- call !!sctlDisplayPlot ( !spre, true, false)
handle any
endhandle

endfunction
-- End of function definition for !!cvWallSpecSpre
