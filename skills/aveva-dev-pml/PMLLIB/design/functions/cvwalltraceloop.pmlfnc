-- Created:         Fri Mar 14 11:08:19 GMT 1997
--
--
-- Description:
-- Given a panel create walls around following the edges of the panel
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!cvWallTraceLoop()

  !ref = !!ce

  -- Find Element from EDG pick
  !panel = !!edgGeomData.pickedItem

  if (!panel.hardType ne 'PANE') then
    !!messageFile.warning(157, 5)
    return
  endif

  -- Find Panel Loop
  !message = STRING()
  !ploo = !!findFirstMember(!panel,|PLOO|, ||, !message)
  if (!ploo eq nulref) then
    !!messageFile.warning(157, 3)
    return
  endif

  !points = !ploo.mCount
  if (!points lt 3) then
    !!messageFile.warning(157, 4)
    return
  endif

  -- Calculate Position of panel vertices
  !positions = ARRAY()
  do !pave values !ploo.members
    !positions.append(!pave.pos.wrt(World))
  enddo

  -- Section Definition object
  !section = object STLSCTN()

  -- Define Connections
  !section.attachConnect  = false
  !section.freeConnect    = true

  -- Creation Data
  !section.type           = 'STWALL'
  !section.storeGroup     = 'WANDF'
  !section.storeArea      = 'WALL'

  -- get the storage area
  !store = !!getStorageArea(!section.storeGroup, !section.storeArea)
  if(!store.unset()) then
    !store = !!ce
  endif

  -->>>>>>>>>>>> Define Data on "old" section creation form <<<<<<<<<<<<<
  !oldSectionForm = !!cdSctn

  !oldSectionForm.type.val  = !section.type
  !oldSectionForm.area.val  = !store.string()
  -- Settings
  !oldSectionForm.aflg.val = true
  !oldSectionForm.dflg.val = true
  !oldSectionForm.cflg.val = true
  !oldSectionForm.fflg.val = true
  !oldSectionForm.tflg.val = !!stlTolerances.trim
  !oldSectionForm.sflg.val = true
  !oldSectionForm.jflg.val = !!stlTolerances.jointDominant
  !oldSectionForm.vflg.val = false

  !walls = ARRAY()

  -- now create walls between subsequent points
  do !i indices !positions

    !dText[1] = '=0/0'
    !oldSectionForm.ref1.dText = !dText
    !oldSectionForm.ref2.dText = !dText

    -- Define start/end position
    !section.startPosition  = !positions[!i].wrt(World)
    if ((!i + 1) gt !positions.size()) then
      !nextIndex = 1
    else
      !nextIndex = !i + 1
    endif
    !section.endPosition    = !positions[!nextIndex].wrt(World)

    if (!section.startPosition ne !section.endPosition) then
      -- Positions
      !oldSectionForm.pos1.val = !section.startPosition.string().before('WRT')
      !oldSectionForm.pos2.val = !section.endPosition.string().before('WRT')

      -- Run section creation form
      call !!runSynonym('CALLSTL MSCTN')
      !walls.append(!!cdpnRtn.dbRef())

      if (!i gt 1) then
        !!sctlMitreSCTN(!walls[!i - 1], 'END', !walls[!i], 'START', !message)
      endif
    endif
  enddo

  if (!walls.size() gt 2) then
    -- Mitre Last wall with first wall
    !!sctlMitreSCTN(!walls[!walls.size()], 'END', !walls[1], 'START', !message)
  endif

  !!ce = !ref

endfunction
-- End of function definition for !!cvWallTraceLoop
