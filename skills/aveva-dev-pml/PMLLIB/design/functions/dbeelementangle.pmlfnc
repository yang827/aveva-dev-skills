define function !!dbeElementAngle(!element is DBREF)

  -- Initialise Variables

  -- Check orientation has been loaded
  if(undefined(!!dbeElementAngle)) then
    pml reload form !!dbeElementAngle
  endif

  -- Setup form
  !!dbeElementAngle.setup(!element)

endfunction
-- End of function definition
