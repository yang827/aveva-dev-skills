--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Nov 3 17:33:06 "GMT 1998
--
--
-- Description:
-- Display the standard loop edit form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to search from
--    2   R      STRING      List of elements that can be edited
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!dbeLoopEdit(!element is DBREF, !elementType is STRING)

  -- Initialise Variables
  !types = !elementType.split()

  -- If loop edit form is not built, then build it
  if(undefined(!!dbeLoopEdit)) then
    pml reload form !!dbeLoopEdit
  endif

  -- Get the owning element type
  !owner = !!dtbOwnerOfTypes(!element, !types)

  -- If there is no owner of the passed type, give message
  if(!owner.unset()) then
    !!alert.warning('Unable to find element type(s) of "' & !elementType & '".')
    return
  endif

  -- Try to stop the user modifying another extrusion when the current extrusion definition is incomplete
  if (!!dbeLoopEdit.extrusion.set()) then
    if ((!!dbeLoopEdit.shown()) and (!element eq !!dbeLoopEdit.extrusion)) then
      return
    elseif ((!!dbeLoopEdit.shown()) and (!element neq !!dbeLoopEdit.extrusion)) then
      -- Check to see if there is a volume for this extrusion
      !volume = !!dbeLoopEdit.extrusion.gvolume
      handle any
        !volume = 0
      endhandle
      if (!volume.gt(0).not()) then
        if (!!alert.confirm('DB element being modified has no volume! Are you sure you want to modify another element?').upcase() eq 'NO') then
          return
        endif
      endif

    -- Remove any EDG state for form
    !!edgCntrl.remove('Loop Definition')
    !!edgCntrl.remove('LOOPEDIT')

    endif
  endif

  -- Show form with relevant element
  !!dbeLoopEdit.edit(!owner)

endfunction
-- End of function definition for !!dbeLoopEdit
