-------------------------------------------------------------------
--
--  Description:  Function to load and show the default bend selection form
--
------------------------------------------------------------------------
define function !!defaultBendSelection(!tubeDiameter is REAL, !element is STRING, !flow is REAL, !reset is REAL)

  !!defaultBendSelection.arriveOD = !tubeDiameter
  handle any
    pml load form !!defaultBendSelection
    !!defaultBendSelection.arriveOD = !tubeDiameter
  endhandle

  !!defaultBendSelection.element = !element.dbref()

  if (!flow.eq(0)) then
    !!defaultBendSelection.mode = 'Forwards'
  else
    !!defaultBendSelection.mode = 'Backwards'
  endif

  !!defaultBendSelection.reset = !reset.boolean()

  show !!defaultBendSelection

endfunction
