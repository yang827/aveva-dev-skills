--
-- Description:
--    Instigates event which will delete a range of piping component
--    within the same branch
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!deletePipingRange()

  -- Test to see if common global object for common pipe actions is available
  if(undefined(!!pipingActions)) then
    !!pipingActions = object PIPINGACTIONS('pipingActions')
  endif

  -- Action piping component delete range
  !!pipingActions.deleteComponentRange()

endfunction
-- End of function definition
