--
-- Description:
-- Toggle between the two states of the passed option
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget
--    2   R      STRING      Set command
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!desAutoClaInit(!menu is MENU, !dummyString is STRING)

  var !clash AUTOCLASH
  !menu.select('Auto Clash', !clash.boolean())

endfunction
-- End of function definition for !!desAutoClaInit
