--
-- Description:
-- To find the position of the centre of an element with no position ie (FRMW)
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [DBREF to find centre of]
-- Return:
--   [Data Type] [Description]
--   [POSITION]  [Midpoint position of DBREF]
--
------------------------------------------------------------------------
-- Define function
define function !!desFindCentrePos(!dbRef is DBREF) is POSITION

!volume = object VOLUME(!dbRef)

return !volume.from.midpoint(!volume.to)

endfunction
-- End of function definition for !!desFindCentrePos(DBREF) POSITION
