--
--
-- Description:
-- Returns all specified design message files as an array.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Message file names, without their extension.
--
------------------------------------------------------------------------

-- Define function
define function !!designMsgFiles() is ARRAY

  !returnArray = ARRAY()
  !returnArray.append('asl42')
  !returnArray.append('civ43')
  !returnArray.append('gvd20')
  !returnArray.append('plt44')
  !returnArray.append('stl41')
  !returnArray.append('sctl40')

  return !returnArray

endfunction
-- End of function definition for !!designMsgFiles
