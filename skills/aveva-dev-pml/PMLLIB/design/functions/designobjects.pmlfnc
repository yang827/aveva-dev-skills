-- Define function
define function !!designObjects()

  -- Load design objects
--  call !!loadObject('<objectName>')
    call !!loadObject('link')
    call !!loadObject('linkset')
    call !!loadObject('sctnspec')

endfunction
-- End of function definition for !!designObjects
