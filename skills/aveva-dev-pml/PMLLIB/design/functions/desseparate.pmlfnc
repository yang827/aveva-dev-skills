--
-- Description:
-- Remove the current element into a new administrative element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!desSeparate()

!refe = !!ce
!element = !refe
!types = 'SCTN,GENSEC,BRAN,PNODE,SNODE,SPINE,JLDATUM,PLDATUM,PANEL,PLOOP,PAVE,SELJ,PALJ'
-- Check type of owner
if (!types.match(!element.owner.hardType) gt 0) then
     !element = !element.owner
     if (!types.match(!element.owner.hardType) gt 0) then
          !element = !element.owner
          if (!types.match(!element.owner.hardType) gt 0) then
                 !!messageFile.error(146, 27)
          endif
     endif
endif
-- Don't do anything if only one member
if(!element.owner.mCount le 1 ) then
     return
endif
!message = 'Ok to separate '  & !element.flnm & ' into new administrative element'
!answer = !!alert.confirm(!message)
if (!answer ne 'YES') then
     return
endif
-- Create new owner
!old = !element.owner
!type = !element.owner.type
NEW $!type COPY ATTRIBUTES OF $!old

!owner = !!ce
-- Name it
if( !!namOpt.auto() ) then
  !name = !!namOpt.nameString(!owner, ||, true, false)
  if (!name.unset().not()) then
    NAME /$!name
  endif
endif

-- Move element into this one
INCLUDE $!element
$!element
-- Rename it
if( !!namOpt.auto()  ) then
  !name = !!namOpt.nameString(!element, ||, true, false)
  if (!name.unset().not()) then
    NAME /$!name
  endif
endif
-- Workaround for bug with include
ADD CE

!!ce = !refe

endfunction
-- End of function definition for !!desSeparate
