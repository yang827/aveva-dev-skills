--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!desUnionGlobal()

  !!desUnionValue = object DUNION()

  !paths = !!searchPaths('design-dunion.dat')

  if (!paths.size() gt 0) then

    -- If paths[1].file is zero size, then return
    if(!paths[1].file.size() eq 0) then
      return
    endif

    !!desUnionValue.load(!paths[1].file.fullName())

  endif

endfunction
-- End of function definition for !!desUnionGlobal
