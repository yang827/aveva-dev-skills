--
--
-- Description:
--    Directs the current selection/component
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!directComponent()

  -- Test to see if common global object for common pipe actions is available
  if(undefined(!!pipingActions)) then
    !!pipingActions = object PIPINGACTIONS('pipingActions')
  endif

  -- Determine if there is a valid selection or component
  !selection        = object SELECTION()
  !selection.getCurrent()
  !selected         = !selection.getSelection()

  -- If there is a single selection, check to see if its a piping component
  if(!selected.size() eq 1) then
    if(!selected.first().owner.type eq 'BRAN') then
      !component  = !selected.first()
    endif
  -- Check current element
  elseif (!!ce.owner.type eq 'BRAN' and !!ce.type.neq('WORL')) then
    !component    = !!ce
  endif

  -- P-28015 fix to align head and tail if there are no components
  if !!ce.type.eq('BRAN').and(!!ce.mcount.eq(0)) then
    if !!ce.hpos.eq(!!ce.tpos) then
      !!alert.error('Cannot align branch - hpos and tpos are the same')
      return
    endif
    !!ce.hdir = !!ce.hpos.direction(!!ce.tpos)
    handle ANY
      -- position unset
    endhandle
    !!ce.tdir = !!ce.tpos.direction(!!ce.hpos)
    handle ANY
      -- position unset
    elsehandle NONE
      return
    endhandle
  endif
  -- Direct Single component
  if(defined(!component)) then
    if(!!pipingActions.directComponent(!component).not()) then
      !!alert.message(!!error.text)
    endif

  -- Direct selection of components
  else
    if(!!pipingActions.directComponents(!selected).not()) then
      !!alert.message(!!error.text)
    endif
  endif

return

endfunction
-- End of function definition
