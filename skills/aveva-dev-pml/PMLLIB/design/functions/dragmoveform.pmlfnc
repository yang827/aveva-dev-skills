--
--  Description:     Display and initialise form shared by Drag Move and Move commands
--
----------------------------------------------------------------------
--

define function !!dragMoveForm(!drag is BOOLEAN, !mode is STRING)

-- Initialise Variables
  if(not defined(!!desDragMove)) then
    pml load form !!desDragMove
  endif

  !!desDragMove.setDrag(!drag)
  !!desDragMove.setMode(!mode)

  if( !!desDragMove.shown() ) then
    -- form already shown
    !!desDragMove.init()
  else
    -- Form not shown - show form and initialise it
    show !!desDragMove
  endif

endfunction
-- End of function definition
