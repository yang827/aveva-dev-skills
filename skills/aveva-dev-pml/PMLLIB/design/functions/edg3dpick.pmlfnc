-- Created:         Wed Jun 25 14:54:12 BST 1997
--
--
-- Description:
-- Sets up EDG to pick single element. Code is very similar to
-- !!edg3DPicks(), the only difference is the para text and the argument
-- to !!edg3DPickCB() is ONE. It
-- displays a small form which is the equivalent of the old "Status Form"
-- containing an OK and CANCEL button.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Calling App's Callback function after picking
--    2   R      STRING      Element qualifier
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if added to stack OK.
--
------------------------------------------------------------------------

define function !!edg3DPick(!callback is STRING, !elemQualifier is STRING) is BOOLEAN

  !pickStack = object EDGPICKSTACK()
  show !!edg3DPickFrm

  ----------------------------------------------------------------------
  -- Add Callback to stack and set-up form to be displayed.
  ----------------------------------------------------------------------

  !pickStack.callback  = !callback
  !pickStack.nameOfApp = 'EDG3DPick'
  !pickStack.elements  = ARRAY()
  !pickStack.dText     = 'Please pick a single element.'

  !!edg3DPickFrm.stack.append(!pickStack)

  !!edg3DPickFrm.text.val = 'Please pick a single element.'

  ----------------------------------------------------------------------
  -- Set EDG to pick elements (PICK) and only sections (See Qualifier)
  ----------------------------------------------------------------------

  !args              = object EDGPUSHPARAMS()
  !args.pickHandler  = '!!edgPickFast'
  !args.inMode       = 'PICK'
  !args.userFunction = '!!edg3DPickCB(|ONE|)'
  !args.appName      = 'EDG3DPick'
  !args.showPickForm = FALSE
  !args.elementQual  = !elemQualifier
  !args.rootPrompt   = 'Please a single element'

  !bResult = !!edgPush(!args)

  return !bResult

--  !bResult = !!edgGeomPrmpt('EDG3DPick', 'Please pick elements', '')

endfunction
-- End of function definition for !!edg3DPick
