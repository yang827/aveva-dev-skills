-- File:            edg3dpickcb.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Mon Jun 30 11:36:07 BST 1997
--
--
-- Description:
-- Call back after edgPickMode has done its stuff. Appends Dbref to the
-- others stored on the stack for simple picking.
--
-- When the pick is completed (!option eq ONE or OK) the users callback
-- function is called with an array of the Dbrefs collected.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'MANY'   - add Dbref to array of elements
--                                      for App on top of stack, then
--                                      return
--                           'ONE'    - Add Dbref to stack, pop stack.
--                           'OK'     - Does nothing but Pop stack
--                           'CANCEL' - pops stack & returns
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edg3DPickCB(!option is STRING)

  if(!option eq 'MANY') then
    !last = !!edg3DPickFrm.stack.maxIndex()
    !!edg3DPickFrm.stack[!last].elements.append(!!edgGeomData.pickedItem)
    return

  elseif(!option eq 'ONE') then
    !last = !!edg3DPickFrm.stack.maxIndex()
    !!edg3DPickFrm.stack[!last].elements.append(!!edgGeomData.pickedItem)

  elseif(!option eq 'OK') then
    -- OK button pressed, don't do anything but call User Function

  elseif(!option eq 'CANCEL') then
    !bResult = !!edgPop(!!edg3DPickFrm.stack.last().nameOfApp)
    !!edg3DPickFrm.stack.deleteFrom(!!edg3DPickFrm.stack.maxIndex() , 1)

    if(!!edg3DPickFrm.stack.maxIndex() eq 0) then
      !!edg3DPickFrm.hide()
    endif

    return
  endif

  --------------------------------------------------------------
  -- Hide form if no going to be no more stuff on stack.
  -- Run user function.
  -- Pop edg3DPick off stack.
  -- Reset edgPickStack.
  --------------------------------------------------------------

  if(!!edg3DPickFrm.stack.maxIndex() eq 1) then
    !!edg3DPickFrm.hide()
  endif

  !function = !!edg3DPickFrm.stack.last().callback
  $!<function>(!!edg3DPickFrm.stack.last().elements)

  !bResult = !!edgPop(!!edg3DPickFrm.stack.last().nameOfApp)
  !!edg3DPickFrm.stack.deleteFrom(!!edg3DPickFrm.stack.maxIndex() , 1)

  if(!!edg3DPickFrm.stack.set()) then
    !!edg3DpickFrm.text.val = !!edg3DPickFrm.stack.last().dText
  endif

endfunction
-- End of function definition for !!edg3DPickCB
