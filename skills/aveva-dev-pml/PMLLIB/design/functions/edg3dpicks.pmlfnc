--
--
-- Description:
-- Sets up a picking loop to capture a set of elements picked. It
-- displays a small form which is the equivalent of the old "Status Form"
-- containing only the Cancel button.
--
-- Once the STOP button is pressed, it calls the !callback function with
-- an array argument of the elements picked.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View to operate on
--    2   R      STRING      The function to call when the STOP button
--                           is pressed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edg3DPicks(!callback is STRING, !elemQualifier is STRING) is BOOLEAN

  !pickStack = object EDGPICKSTACK()

  show !!edg3DPickFrm

  ----------------------------------------------------------------------
  -- Add Callback to stack and set-up form to be displayed.
  ----------------------------------------------------------------------

  !pickStack.callback  = !callback
  !pickStack.nameOfApp = 'EDG3DPicks'
  !pickStack.elements  = ARRAY()
  !pickStack.dText     = 'When you have finished picking elements, click the Ok button'

  !!edg3DPickFrm.stack.append(!pickStack)

  !!edg3DPickFrm.text.val = 'When you have finished picking elements, click the Ok button'

  ----------------------------------------------------------------------
  -- Set EDG to pick elements (PICK) and only sections (See Qualifier)
  ----------------------------------------------------------------------

  !args              = object EDGPUSHPARAMS()
  !args.pickHandler  = '!!edgPickFast'
  !args.inMode       = 'PICK'
  !args.userFunction = '!!edg3DPickCB(|MANY|)'
  !args.appName      = 'EDG3DPicks'
  !args.showPickForm = FALSE
  !args.elementQual  = !elemQualifier
  !args.rootPrompt   = 'Please pick elements'
  !args.optionPrompt = ' '

  !unusedBResult = !!edgPush(!args)
--  !bResult = !!edgGeomPrmpt('EDG3DPicks', 'Please pick elements', '')

endfunction
-- End of function definition for !!edg3DPicks
