--
-- File:            edggeomfilt.pmlfnc
--   Type:          Function Definition
--   Group:         EDG
--     Keyword:     EDG
--   Module:        DESIGN
--   Application:   EDG
--   Replaces:      DGEOMFILT
--
-- Author:          P.Mooney
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- Set all filters for all handlers in the DESIGN views.
-- Gets the rules defined in the forms Element Filter, PLine Filter
-- and Point Filter. It then sets the Qualifiers for these types of
-- Pick.
--
-- If any qualifiers have been set on the EDG Stack, they will
-- override any user defined ones.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgGeomFilt()

 !qualifiers  = ARRAY()

 --------------------------------------------------------------------
 -- Set Loop data (get rules from lists and test them...)
 --------------------------------------------------------------------

 !elementInset = ''
 !pLineInset = ''
 !pointInset = ''

 if (!!edgGeomTBar.elementFilter.unset().not() and !!edgGeomTBar.elementFilter.upcase().trim() ne 'NO RULE') then
   !elementRule = !!ruleStore.element.getRule(!!edgGeomTBar.elementFilter)
   handle (12, 004)
     -- no rule found
   elsehandle none
     !elementInset = !elementRule.insetString()
   endhandle
 endif
 if (!!edgGeomTBar.pLineFilter.unset().not() and !!edgGeomTBar.pLineFilter.upcase().trim() ne 'NO RULE') then
   !pLineRule = !!ruleStore.pLine.getRule(!!edgGeomTBar.pLineFilter)
   handle (12, 004)
     !pLineInset = ''
   elsehandle none
     !pLineInset = !pLineRule.insetString()
   endhandle
 endif
 if (!!edgGeomTBar.pointFilter.unset().not() and !!edgGeomTBar.pointFilter.upcase().trim() ne 'NO RULE') then
   !pointRule = !!ruleStore.point.getRule(!!edgGeomTBar.pointFilter)
   handle (12, 004)
     -- no rule found
   elsehandle none
     !pointInset = !pointRule.insetString()
   endhandle
 endif

--------------------------------------------------------------------------
-- As there are several instances where plines are allowed a filter, ie
-- on the PICK PLINE command, we need to replicate the functionality of
-- the old _cdcPlines form. This is done by putting URULE[3] into the
-- userdata of the form.
--------------------------------------------------------------------------

 if(undefined(!pLineRule) or !pLineRule.rule.trim() eq '') then
   var USER _cdcPlines || 1
 else
   !tempRule = !pLineRule.rule
   var USER _cdcPlines |WITH ($!tempRule)|
 endif

 ----------------------------------------------------------------------
 --  Store qualifiers in the inmode input array.
 --  Positions in the input array are as follows:
 --
 --  [1]  - pline qualifier                   (logical expression)
 --  [2]  - point (ppoint/dpoint) qualifier   (logical expression)
 --  [3]  - element qualifier                 (logical expression)
 --  [4]  - aid qualifier                     (text expression)
 --  [5]  - tubi qualifier                    (logical expression)
 --
 -- NOTE: At the moment, each INMODE has an array of qualifiers set.
 -- This may change to only 1 in the future.
 ----------------------------------------------------------------------

 !argPline   = !!view3DCntrl.actionStack.last().pLineQual
 !argPPoint  = !!view3DCntrl.actionStack.last().pointQual
 !argElement = !!view3DCntrl.actionStack.last().elementQual
 !argAid     = !!view3DCntrl.actionStack.last().aidQual
 !argTubi    = !!view3DCntrl.actionStack.last().tubiQual

 if(not !argPline.unset()) then
   !qualifiers[1] = !argPline
 else
   !qualifiers[1] = !pLineInset
 endif

 if(not !argPPoint.unset()) then
   !qualifiers[2] = !argPPoint
 else
   !qualifiers[2] = !pointInset
 endif

 if(not !argElement.unset()) then
   !qualifiers[3] = !argElement
 else
   !qualifiers[3] = !elementInset
 endif

 if(not !argAid.unset()) then
   !qualifiers[4] = !argAid
 else
   !qualifiers[4] = ''
 endif

 if(not !argTubi.unset()) then
   !qualifiers[5] = !argTubi
 else
   !qualifiers[5] = ''
 endif

 !qualifiers[6] = ''
 !qualifiers[7] = ''
 !qualifiers[8] = ''

 do !i indices !!view3DCntrl.designViews
   !!view3DCntrl.designViews[!i].pany.input   = !qualifiers
   !!view3DCntrl.designViews[!i].pick.input   = !qualifiers
   !!view3DCntrl.designViews[!i].point.input  = !qualifiers
   !!view3DCntrl.designViews[!i].ppLine.input = !qualifiers
   !!view3DCntrl.designViews[!i].screen.input = !qualifiers
 enddo

endfunction
-- End of function definition for !!edgGeomFilt
