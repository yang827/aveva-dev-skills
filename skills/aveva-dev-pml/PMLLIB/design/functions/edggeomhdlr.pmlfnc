-- File:            edggeomhdlr.pmlfnc
--   Type:          Function Definition
--   Group:         EDG
--     Keyword:     EDG
--   Module:        DESIGN
--   Application:   EDG
--   Replaces:      DGEOMHDLR
--
-- Author:          P.Mooney
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- Callback on option gadget Pick Type on form FGEOMTBAR. When the Pick
-- type is changed the inmode of the view is changed to allow only
-- certain items to be picked.
--
-- HOW: Checks PickType is valid, stores PickType in _CD3DFORMS_IMOD
--      and sets inmode on all Design Views. It also sets the prompt for
--      the new inmode.
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Pick Type: PICK, PPLINE, POINT, SCREEN,
--                                      PANY
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if set the views inmode with !pickType  ok.
--
------------------------------------------------------------------------

define function !!edgGeomHdlr(!pickType is STRING) is BOOLEAN

  -------------------------------------------------------
  -- Valid Pick Type? (and for the current Handler?)
  -- If no !pickType is empty, it is set to a valid type.
  -- in !!edgHandlerChk()
  -------------------------------------------------------

  if(!!edgHandlerChk('', !pickType) eq FALSE) then
    return FALSE
  endif

  !!edgGeomData.itemType = !pickType

  ------------------------------------------------------
  -- Get root & option prompts from App on top of stack.
  -- If root prompt not set then use defaults set on
  -- !!view3DCntrl form.
  ------------------------------------------------------

  !last    = !!view3DCntrl.actionStack.maxIndex()

  if(!last gt 0) then
    !rPrompt = !!view3DCntrl.actionStack[!last].rootPrompt
    !oPrompt = !!view3DCntrl.actionStack[!last].optionPrompt
  else
    !rPrompt = ''
    !oPrompt = ''
  endif

  if(!rPrompt.empty() or $
     !rPrompt.unset()     ) then

    if(!pickType eq 'PICK') then
      !rPrompt = !!view3DCntrl.pickPrompt

    elseif(!pickType eq 'PPLINE') then
      !rPrompt = !!view3DCntrl.ppLinePrompt

    elseif(!pickType eq 'POINT') then
      !rPrompt = !!view3DCntrl.pointPrompt

    elseif(!pickType eq 'SCREEN') then
      !rPrompt = !!view3DCntrl.screenPrompt

    elseif(!pickType eq 'PANY') then
      !rPrompt = !!view3DCntrl.panyPrompt
    endif
  endif

  if(!oPrompt.unset() or !oPrompt.empty()) then

      if(!!edgGeomData.option eq 'DIST ') then

        if(!!edgGeomData.value eq 0) then
          !oPrompt = !!view3DCntrl.snapPrompt
        else
          !oPrompt = 'Distance ' & !!edgGeomData.value
        endif

      elseif(!!edgGeomData.option eq 'FRAC ') then
        if(!!edgGeomData.value eq 0.5) then
          !oPrompt = !!view3DCntrl.midPrompt
        else
          !oPrompt = !!view3DCntrl.fracPrompt & ' ' & !!edgGeomData.value
        endif

      elseif(!!edgGeomData.option eq 'PROP ') then

        if(!!edgGeomData.value eq 0.5) then
          !oPrompt = !!view3DCntrl.midPrompt
        else
          !oPrompt = !!view3DCntrl.propPrompt
        endif

      elseif(!!edgGeomData.option eq 'EXACT') then
        !oPrompt = !!view3DCntrl.pickedPrompt

      else
        !oPrompt = ''
      endif
  endif

  do !x indices !!view3DCntrl.designViews
    !!view3DCntrl.designViews[!x].setInMode(!pickType)
    !!view3DCntrl.designViews[!x].inMode.prompt = !rPrompt & !oPrompt & ' '
  enddo

  return TRUE

endfunction
-- End of function definition for !!edgGeomHdlr
