--
-- File:            edggeomprmpt.pmlfnc
--   Type:          Function Definition
--   Group:         EDG
--     Keyword:     EDG
--   Module:        DESIGN
--   Application:   EDG
--   Replaces:      DGEOMPMT
--
-- Author:          P.Mooney
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- Sets the forms text gadgets to the !root and !optionPrmpt parameters
-- passed in. This function should be called after a application has put
-- itself on the stack, to change prompts already set.
--
-- The 2 prompts, Root and Option are joined together to be displayed
-- on the same form as the view i.e. "Pick Connection Type" "Panel"
-- would be the 2 arguments. The RootPrmpt argument will usually be
-- equal to ''.
--
-- NOTE: each TYPE of inmode has its own prompt. Only setting the
--       current inmode here.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of the application
--    2   R      STRING      Root Prompt
--    3   R      STRING      Option Prompt
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if everything went ok.
--
------------------------------------------------------------------------

define function !!edgGeomPrmpt(!appName is STRING, !rootPrmpt is STRING, !optionPrmpt is STRING) is BOOLEAN

 ------------------------------------
 -- DECLARE VARIABLES
 ------------------------------------

 ------------------------------------------------------
 -- Update Prompts on stack. Find where the application
 -- is on the stack.
 ------------------------------------------------------

 if(!appName.empty()) then
   -- Old Appware, assume top of stack

   if(!!view3DCntrl.actionStack.unset()) then
     !!alert.error('Sorry, no application registered on stack yet')
     return
   endif

   !last = !!view3DCntrl.actionStack.maxIndex()

   !!view3DCntrl.actionStack[!last].rootPrompt   = !rootPrmpt
   !!view3DCntrl.actionStack[!last].optionPrompt = !optionPrmpt
 else
   do !x indices !!view3DCntrl.actionStack
     if(!!view3DCntrl.actionStack[!x].appName eq !appName) then
       break
     endif
   enddo

   if(!!view3DCntrl.actionStack[!x].appName neq !appName) then
     !!alert.error(|Error: Could not find "$!appName" on stack|)
     return
   else
--     if( !rootPrmpt.set() and not !rootPrmpt.empty()) then
       !!view3DCntrl.actionStack[!x].rootPrompt   = !rootPrmpt
--     endif

--     if(!optionPrmpt.set() and  not !optionPrmpt.empty()) then
       !!view3DCntrl.actionStack[!x].optionPrompt = !optionPrmpt
--     endif
   endif
 endif

 !falseInMode = STRING()
 !falseInMode = ''

 call !!edgGeomHdlr(!falseInMode)

 return TRUE

------------------------------------------------------------------
------------------------------------------------------------------
------------------------------------------------------------------

  ------------------------------------------------------
  -- Get root & option prompts from App on top of stack.
  -- If root prompt not set then use defaults set on
  -- !!view3DCntrl form.
  ------------------------------------------------------

  !last    = !!view3DCntrl.actionStack.maxIndex()

  !rPrompt = !!view3DCntrl.actionStack[!last].rootPrompt
  !oPrompt = !!view3DCntrl.actionStack[!last].optionPrompt

  if(!rPrompt.empty() or $
     !rPrompt.unset()     ) then

    if(!!view3DCntrl.actionStack[!x].inMode eq 'PICK') then
      !rPrompt = !!view3DCntrl.pickPrompt

    elseif(!!view3DCntrl.actionStack[!x].inMode eq 'PPLINE') then
      !rPrompt = !!view3DCntrl.ppLinePrompt

    elseif(!!view3DCntrl.actionStack[!x].inMode eq 'POINT') then
      !rPrompt = !!view3DCntrl.pointPrompt

    elseif(!!view3DCntrl.actionStack[!x].inMode eq 'SCREEN') then
      !rPrompt = !!view3DCntrl.screenPrompt

    elseif(!!view3DCntrl.actionStack[!x].inMode eq 'PANY') then
      !rPrompt = !!view3DCntrl.panyPrompt
    endif
  endif

  if(!oPrompt.unset()) then
    !oPrompt = ''
  endif

  ------------------------------------
  -- Set the prompt on each View form
  ------------------------------------

  do !i indices !!view3DCntrl.designViews
    !!view3DCntrl.designViews[!i].inMode.prompt   = !rPrompt & !oPrompt & ' '
  enddo

  return TRUE

endfunction
-- End of function definition for !!edgGeomPrmpt
