-- Author:          P.Mooney
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- Checks that the pick type (handler) and pick option are compatible.
-- This function assumes !!edgGeomTBar.ptyp.rText holds all valid
-- inmodes for 3D views.
--
-- If the PickType is empty it is set to the default type.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   W      STRING      Pick Handler (RPick etc.)
--                           If arg is empty, set to current
--                           inmode.
--    2   W      STRING      Pick Type    (SCREEN, PPLINE etc.)
--                           If arg is empty, set to default.
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN      TRUE if !handler and !pickType are compatible or
--                 PickType is valid.
--                 FALSE if not.
--
------------------------------------------------------------------------

define function !!edgHandlerChk(!handler is STRING, !pickType is STRING) is BOOLEAN

  ------------------------------
  -- Defaults if Params unset...
  ------------------------------

  if(!handler.empty()) then
--    var !handler '$_cdGeomData_Hdlr'
  endif

  if(!pickType.empty()) then
    !pickType = !!edgGeomTBar.ptyp.selection()
  endif

  -------------------------------
  -- Ignore NAVIgation Pick Types
  -------------------------------

  if(!pickType eq 'NAVI') then
    return TRUE
  endif

 ------------------------------------------------------------------------------
 -- If !pickType is 3D line (SCREEN) and !handler is RINTER then don't allow it
 ------------------------------------------------------------------------------

 if(!pickType eq 'SCREEN' and !handler eq 'RINTER') then
   var !!cdRtnStatus  1
   !!alert.warning('Cannot derive intersection from screen picking.')

   -- var list _cdGeomTBar_ptyp SEL REPL |$_cdGeomData_ptyp| EXIT

   !!edgGeomTBar.ptyp.select('RTEXT', |$_cdGeomData_ptyp|)

   return FALSE
 endif

 !!edgGeomTBar.ptyp.select('RTEXT', |$!pickType|)
 handle any
   !!alert.warning('Pick option has invalid input mode defined.')
   !!edgGeomTBar.ptyp.select('RTEXT', |$_cdGeomData_ptyp|)
   return FALSE
 endhandle

 var list _cdGeomData_ptyp SEL REPL |$!pickType| EXIT
-- var _cdGeomData_Hdlr |$!handler|

 return TRUE

endfunction
-- End of function definition for !!edgHandlerChk
