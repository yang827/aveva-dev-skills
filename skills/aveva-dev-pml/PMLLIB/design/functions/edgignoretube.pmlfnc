-- Author:          P.Mooney
-- Created:         Tue Apr 22 14:12:16 BST 1997
--
--
-- Description:
-- Returns TRUE is component should be ignored.
-- Gets the user defined options set on form _cdGeomSnap. The user can
-- ignore ATTA's, WELD's, ZERO LENGTH items and INLINE components.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element in question:
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE  - should ignore component
--                FALSE - don't ignore component
--
------------------------------------------------------------------------

define function !!edgIgnoreTube(!dbRef is DBREF) is BOOLEAN

  !szAtta       = $_cdGeomSnap_atta
  !szWeld       = $_cdGeomSnap_weld
  !szZero       = $_cdGeomSnap_zero
  !szInLine     = $_cdGeomSnap_str

  !ignoreAtta   = !szAtta.boolean()
  !ignoreWeld   = !szWeld.boolean()
  !ignoreZero   = !szZero.boolean()
  !ignoreInLine = !szInLine.boolean()

  if(not !ignoreAtta and not !ignoreWeld and not !ignoreZero and not !ignoreInLine) then
    return FALSE
  endif

  if(!ignoreAtta and !dbRef.type eq 'ATTA') then
    return TRUE
  endif

  if(!ignoreWeld and !dbRef.type eq 'WELD') then
    return TRUE
  endif

  if(!ignoreZero) then
    if(!!distanceFromTo(!dbRef.pPos[!dbRef.arrive], !dbRef.pPos[!dbRef.leave]) eq 0) then
      return TRUE
    endif
  endif

  return FALSE

endfunction
-- End of function definition for !!edgIgnoreTube
