-- Created:         Thu Apr 24 14:53:24 BST 1997
--
--
-- Description:
-- Complex method of loading the EDG toolkit options into a list gadget,
-- later used to build the FGEOMTBAR form. The list gadget is used
-- later by the callback on the button.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgInitOptions()

  !array = ARRAY()
  !file  = ARRAY()
  !uTyp  = ARRAY()
  !oFlg  = ARRAY()

  !newArray  = ARRAY()
  !numbArray = ARRAY()

  !newArray.append(|MNAVI\\\\NAVI\CURSOR\Navigate\'Navigate'\CALLGPH|)
  !numbArray.append('1')

  !counter = REAL()
  !counter = 1

  ---------------------------------------------------
  -- Areas to look for Options for EDG Toolkit form
  ---------------------------------------------------

  !file[1] = '%PDMSUI%/DES/DFLTS/DES-GEOMOPT'
  !file[2] = '%PDMSDFLTS%/DES-GEOMOPT'
  !file[3] = '%PDMSUSER%/DES-GEOMOPT'
  !uTyp[1] = 'AVEVA Supplied'
  !uTyp[2] = 'PDMS Defaults'
  !uTyp[3] = 'USER Defined'

  ---------------------------------
  -- Users write access to files
  ---------------------------------

  !oFlg[1] = false
  !oFlg[2] = false
  !oFlg[3] = true

  !!edgData.list.clear()

  do !indices indices !file
     !array = !!readFile(!file[!indices])
     handle any
       -- File not Found
       skip
     endhandle

     !array.unique()

     do !i indices !array
       if((!array[!i] neq '') and  (!array[!i].subString(1,1) neq '#')) then
         !newArray.append(!array[!i])
         !counter = !counter + 1
         !numbArray.append(!counter.string())
       endif
     enddo

     !eval = object BLOCK('!newArray[!evalIndex].part(7, |\|)')
     !!edgData.list.dText = !newArray.evaluate(!eval)
     !!edgData.list.rText = !newArray

     !!edgData.val.dText  = !numbArray
     !!edgData.val.rText  = !numbArray
  enddo

endfunction
-- End of function definition for !!edgInitOptions
