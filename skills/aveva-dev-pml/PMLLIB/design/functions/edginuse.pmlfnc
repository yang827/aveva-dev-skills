--
--
-- Description:
-- Checks to see what is on the EDG actions stack. Returns TRUE if an
-- application is using EDG.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if 1 or more applications are on the stack
--
------------------------------------------------------------------------

define function !!edgInUse() is BOOLEAN

  if( (!!view3DCntrl.actionStack.empty()) or $
      (!!view3DCntrl.actionStack.unset())    ) then
    return FALSE
  else
    return TRUE
  endif

endfunction
-- End of function definition for !!edgInUse
