-- Created:         Mon Apr 28 18:44:14 BST 1997
--
--
-- Description:
-- Returns the name of the current application using the EDG tool kit.
-- This is the application on the top of the stack.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      The name of the application on the top of the stack
--
------------------------------------------------------------------------

define function !!edgNameOfApp() is STRING

  if(!!view3DCntrl.actionStack.set()) then
    !object = !!view3DCntrl.actionStack.last()
    return !object.appName
  else
    return ''
  endif

endfunction
-- End of function definition for !!edgNameOfApp
