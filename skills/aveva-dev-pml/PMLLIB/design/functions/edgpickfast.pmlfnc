-- File:            edgpickfast.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Thu Sep 11 14:14:17 BST 1997
--
--
-- Description:
--
-- Very fast way of returning basic information on worked out by core.
-- NO position or direction information is worked out. The UserFunction
-- is called as soon as the data is assigned.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Reference to the VIEW gadget the pick was made in
--                           VIEW.inMode.data[] stores data on pick.
--    2   R      STRING      The mode the VIEW was in i.e. PANY, PPOINT....
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgPickFast(!view is GADGET, !dummyInMode is STRING)

  !!edgGeomData              = object EDGGEOMDATA()

  !!edgGeomData.pickType     = !view.inMode.data[1]
  !!edgGeomData.tubeEnd      = !view.inMode.data[2]
  !!edgGeomData.pickedItem        = !view.inMode.data[3]
  !!edgGeomData.number       = !view.inMode.data[4]
  !!edgGeomData.pLineKey     = !view.inMode.data[5]
  !!edgGeomData.aidType      = !view.inMode.data[6]
  !!edgGeomData.pickPosition = !view.inMode.data[7]
  !!edgGeomData.pickLine     = !view.inMode.data[8]

  !!edgGeomData.pickVector.position  = !view.inMode.data[7]
  !!edgGeomData.pickVector.direction = !view.inMode.data[8]

  ---------------------------------------------------------
  -- ALL GeomData HAS NOW BEEN SET.
  -- RUN THE USERS FUNCTION.
  ---------------------------------------------------------

  !params   = !!view3DCntrl.actionStack.last()
  !callback = !params.userFunction

  $!callback

endfunction
-- End of function definition for !!edgPickFast
