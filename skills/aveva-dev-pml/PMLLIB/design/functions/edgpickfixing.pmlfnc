--
-- Description:
-- define object packet for picking fixings for
-- the penetration application
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgPickFixing()


  !packet = object EDGPACKET()

  !packet.definePosition('Identify Penetration')
  !packet.description = 'Nearest Fixing Pick'
  !packet.action      = '!!penPickFixing(!this.return[1])'
  !packet.type        = 'Positioning'
  !packet.key         = 'NearestFixing'

  -- force picking type for this operation
    !!edgPosCntrl.setPick(!!edgPosCntrl.picks[7])
    !!edgPosCntrl.setPickType(!!edgPosCntrl.pickTypes[1])

    !!edgCntrl.add(!packet)


endfunction
-- End of function definition for !!edgPickFixing
