-- File:            edgpickmode.pmlfnc
--   Type:          Function Definition
--   Group:         EDG
--     Keyword:     EDG
--   Module:        DESIGN
--   Application:   EDG
--   Replaces:      RPICK
--
-- Author:          P.Mooney
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- This is the main callback function for picks made on a view gadget
-- for Event Driven Graphics.
--
-- Sets !!edgGeomData form to be read by other Appware functions.
-- The pick type (ELEMENT, DESIGNAID, TUBING) determines what function
-- gets called to set-up this data.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Reference to the VIEW gadget the pick was made in
--                           VIEW.inMode.data[] stores data on pick.
--    2   R      STRING      The mode the VIEW was in i.e. PANY, PPOINT....
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgPickMode(!view is GADGET, !dummyInMode is STRING)

  !pickedEdge      = object PICKEDEDGE()
  !error           = BOOLEAN()
  !bResult         = BOOLEAN()
  !bDataAlreadySet = BOOLEAN()
  !bDataAlreadySet = FALSE

  -- WARNING: inmode.data elements will always be set. They maybe
  -- ' ' for unset, but not ''

  !!edgGeomData.pickType     = !view.inMode.data[1]
  !!edgGeomData.tubeEnd      = !view.inMode.data[2]
  !!edgGeomData.pickedItem        = !view.inMode.data[3]
  !!edgGeomData.number       = !view.inMode.data[4]
  !!edgGeomData.pLineKey     = !view.inMode.data[5]
  !!edgGeomData.aidType      = !view.inMode.data[6]
  !!edgGeomData.pickPosition = !view.inMode.data[7]
  !!edgGeomData.pickLine     = !view.inMode.data[8]

  !!edgGeomData.pickVector.position  = !view.inMode.data[7]
  !!edgGeomData.pickVector.direction = !view.inMode.data[8]

  ---------------------------------------------------------------------
  -- Blank out other !!edgGeomData members that might have been set on a
  -- previous pick
  ---------------------------------------------------------------------

  !!edgGeomData.position     = object POSITION()
  !!edgGeomData.direction    = object DIRECTION()
  !!edgGeomData.vector       = object VECTOR()
  !!edgGeomData.itemLength   = REAL()
  !!edgGeomData.tubeLength   = REAL()
  !!edgGeomData.end          = ''
  !!edgGeomData.realPosition = object POSITION()


  --------------------------------------
  -- DESIGNAID
  --------------------------------------

  if(!!edgGeomData.pickType eq 'DESIGNAID') then

    if(!!edgWorkPoint.list.val neq 0) then

      do !x indices !!edgWorkPoint.aidArray
        if(!!edgWorkPoint.aidArray[!x].aidNumb eq !!edgGeomData.number) then
          !!edgGeomData           = !!edgWorkPoint.aidArray[!x].edgGeomData
          !!edgGeomData.position  = !!edgWorkPoint.aidArray[!x].aidPos
          !!edgGeomData.direction = !!edgWorkPoint.aidArray[!x].aidDir
          !bDataAlreadySet = TRUE
          break
        endif
      enddo

      if(!!edgGeomData.position.unset()) then
        return
      endif
    endif

  elseif(!!edgGeomData.pickType eq 'AXES') then

    -- DO NOTHING - this is a special type of drawing aid (Graphics-> Axes...)
    return

  --------------------------------------
  -- 3D_LINE   (pos in space)
  --------------------------------------

  elseif(!!edgGeomData.pickType eq '3D_LINE') then
    !!edgGeomData.position  = !!edgGeomData.pickPosition
    !!edgGeomData.direction = !!edgGeomData.pickLine

  elseif(!!edgGeomData.pickType eq 'EXTRU') then
    !pickedEdge = !!lineOnExtrusion(!!edgGeomData.pickLine, !!edgGeomData.pickedItem)

  --------------------------------------
  -- TUBING
  --------------------------------------

  elseif(!!edgGeomData.pickType eq 'TUBING') then

    if(|$_cdGeomTube_FlgA| eq 'true') then
      !error =  !!edgTube('OriginToOrigin')

    elseif(|$_cdGeomTube_FlgB| eq 'true') then
      !error =  !!edgTube('TubeLength')

    elseif(|$_cdGeomTube_FlgC| eq 'true') then
      !error =  !!edgTube('Tube+Components')
    endif

    if(!error eq TRUE) then
      return
    endif

  --------------------------------------
  -- ELEMENT
  --------------------------------------

  elseif(!!edgGeomData.pickType eq 'ELEMENT') then

    if(!!edgGeomData.pickedItem.hardType eq 'SCTN') then
      !bResult = !!edgSctn()

    elseif(!!edgGeomData.pickedItem.type eq 'PANE') then
      !bResult = !!edgPane()

    else
      !!edgGeomData.position   = !!edgGeomData.pickedItem.pos
      !!edgGeomData.direction  = !!edgGeomData.pickedItem.pdir[0]
      handle any
        !tempDir = 'U'
        !!edgGeomData.direction  = !tempDir.direction()
      endhandle
    endif

    if(!bResult eq FALSE) then
      return
    endif

  --------------------------------------
  -- PLINE
  --------------------------------------

  elseif(!!edgGeomData.pickType eq 'PLINE') then

    !bResult = !!edgPline()
    if(!bResult eq FALSE) then
      return
    endif

  --------------------------------------
  -- PPOINT
  --------------------------------------

  elseif(!!edgGeomData.pickType eq 'PPOINT') then

    !!edgGeomData.position  = !!edgGeomData.pickedItem.pPos[!!edgGeomData.number].wrt(World)
    !!edgGeomData.direction = !!edgGeomData.pickedItem.pdir[!!edgGeomData.number]

  --------------------------------------
  -- PIN
  --------------------------------------

  elseif(!!edgGeomData.pickType eq 'PIN') then

    !!edgGeomData.position  = !!posOfPin(1)
    !!edgGeomData.direction = !!dirOfPin(1)

  --------------------------------------
  -- DPOINT
  --------------------------------------

  elseif(!!edgGeomData.pickType eq 'DPOINT') then
    !!edgGeomData.position  = !!edgGeomData.pickedItem.dpps[!!edgGeomData.number]
    !!edgGeomData.direction = !!edgGeomData.pickedItem.dpdi[!!edgGeomData.number]

  --------------------------------------
  -- CATCH ALL MISSED TYPES
  --------------------------------------

  else
    !!edgGeomData.position  = !!edgGeomData.pickedItem.pos
    !!edgGeomData.direction = !!edgGeomData.pickedItem.pdir[0]
    handle any
        !tempDir = 'U'
        !!edgGeomData.direction  = !tempDir.direction()
    endhandle
  endif

  ------------------------------------------------
  -- DONE SPECIAL CASES, NOW GENERIC WORK FOR THE
  -- DIFFERENT Options. FLAG bDataAlreadySet may
  -- have been set if an Working Point was picked.
  ------------------------------------------------

  !!edgGeomData.position  = !!edgGeomData.position.wrt(WORLD)
  !!edgGeomData.direction = !!edgGeomData.direction.wrt(WORLD)


  if(not !bDataAlreadySet) then
    if(!!edgGeomData.option eq 'DIST ' AND !!edgGeomData.itemLength.set()) then
      !!edgGeomData.position = !!dirPosDist(!!edgGeomData.direction, !!edgGeomData.position, !!edgGeomData.value)

    elseif(!!edgGeomData.option eq 'FRAC ' and not !!edgGeomData.itemLength.unset()) then

      if(!!edgGeomData.value neq 0 OR !!edgGeomData.value.unset()) then
        !distance              = !!edgGeomData.itemLength * (1 / !!edgGeomData.value)
        !!edgGeomData.position = !!dirPosDist(!!edgGeomData.direction, !!edgGeomData.position, !distance)
      else
        !!alert.message('No value supplied for fractional calculation')
        return
      endif

    elseif(!!edgGeomData.option eq 'PROP ' and not !!edgGeomData.itemLength.unset()) then
      !distance              = !!edgGeomData.itemLength * !!edgGeomData.value
      !!edgGeomData.position = !!dirPosDist(!!edgGeomData.direction, !!edgGeomData.position, !distance)

    elseif(!!edgGeomData.option eq 'EXACT') then
      if(!!edgGeomData.realPosition.origin.set()) then
        !!edgGeomData.position = !!edgGeomData.realPosition
      endif
    endif
  endif

  --------------------------------------------------------
  -- BELOW IS CODE FOR OLD MACROS. IT COPIES THE
  -- DATA FROM !!edgGeomData TO _cdGeomData and
  -- _cdGeomPick
  --------------------------------------------------------

 -- var !tempLin CONST LINE $!!edgGeomData.pickLine THRO $!!edgGeomData.pickPosition
  var _cdGeomData_hdlr |$!!edgGeomData.pickHandler|
  var _cdGeomData_x    |$!!edgGeomData.position.east|
  var _cdGeomData_y    |$!!edgGeomData.position.north|
  var _cdGeomData_z    |$!!edgGeomData.position.up|

  !temp = !!edgGeomData.direction.string().before('WRT')
  var _cdGeomData_dir  |$!temp|

  if(!!edgGeomData.vector.position.east.set()) then
    var !tempVec CONST LINE $!!edgGeomData.vector.direction THRO $!!edgGeomData.vector.position
    var _cdGeomData_vec  |$!tempVec|
    var _cdGeomPick_vec  |$!tempVec|
  else
    var _cdGeomData_vec  ||
    var _cdGeomPick_vec  ||
  endif

  var _cdGeomData_lin  CONST LINE $!!edgGeomData.pickLine THRO $!!edgGeomData.pickPosition
  var list _cdGeomData_item CLEAR
    add |$!!edgGeomData.pickedItem|
  exit

  var _cdGeomPick_item |$!!edgGeomData.pickedItem|

  if(!!edgGeomData.pLineKey.set() AND !!edgGeomData.pLineKey neq ' ') then
    var _cdGeomData_data |$!!edgGeomData.pLineKey|
    var _cdGeomPick_data |$!!edgGeomData.pLineKey|

  elseif(!!edgGeomData.number.set()) then
    var _cdGeomData_data |$!!edgGeomData.number|
    var _cdGeomPick_data |$!!edgGeomData.number|
  endif

  var _cdGeomData_type |$!!edgGeomData.pickType|
  var _cdGeomPick_type |$!!edgGeomData.pickType|
  var _cdGeomData_end  |$!!edgGeomData.end|
  var _cdGeomPick_end  |$!!edgGeomData.end|

  ---------------------------------------------------------
  -- ALL GeomData HAS NOW BEEN SET.
  -- RUN THE USERS FUNCTION (OR MACRO FOR OLD STYLE STUFF).
  -- THIS BIT IS NOT TO PML 2 STANDARD BUT MUST BE DONE.
  ---------------------------------------------------------

  if(!!edgInUse() eq TRUE) then
    !params   = !!view3DCntrl.actionStack.last()
    !callback = !params.userFunction

    if(!callback.match('!!') gt 0) then
      $!callback
    else
      $M "%PDMSUI%/DES/GEOM/DRUNMACRO" $<$!callback$>
    endif
  endif

endfunction
-- End of function definition for !!edgPickMode
