--
--
-- Description:
-- define object packet for picking Plines for
-- general use.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgPickPline(!sctn is DBREF)

  -- Define Packet
  !packet = object EDGPACKET()

  !packet.pLinePick('Identify Pline')
  !packet.description = 'Pline Pick'
  !packet.action      = '!!genSelectPline(!this.return[1])'
  !packet.type        = 'Picking'
  !packet.key         = 'PickPline'

  -- Make it so that the pline filter can not be set
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Set it so only the section can be picked
  !packet.pickPacket.picks[1].pick.input[3]   = 'refe eq ' & !sctn.refe

  -- Set current pline filter settings
  !packet.pickPacket.picks[1].pick.input[1]   = !!edgplinefilter.inmode

  -- Add event to the system
  !!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!edgPickPline
