--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Wed Apr 30 14:21:45 BST 1997
--
--
-- Description:
-- Handles EDG calculations in regard PLines.
-- Sets !!edgGeomData to;
--      Item Length
--      Which end of Pline was picked
--      position at the picked end
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgPline() is BOOLEAN

  !headPos        = object POSITION()
  !tailPos        = object POSITION()

  !vectorArg      = object VECTOR()

  !distanceToHead = REAL()
  !distanceToTail = REAL()


  if(!!edgGeomData.pickedItem.hardType eq 'SCTN') then
    if(|$_cdGeomSctn_plFlg| eq 'UNCUT') then
      !headPos = !!edgGeomData.pickedItem.plStart.attribute(!!edgGeomData.pLineKey)
      !tailPos = !!edgGeomData.pickedItem.plEnd.attribute(!!edgGeomData.pLineKey)
    else
      !headPos = !!edgGeomData.pickedItem.plStCut.attribute(!!edgGeomData.pLineKey)
      !tailPos = !!edgGeomData.pickedItem.plEnCut.attribute(!!edgGeomData.pLineKey)
    endif
  endif

  ----------
  -- LINEAR?
  ----------

  !!edgGeomData.itemLength = !!distanceFromTo(!headPos, !tailPos)

  !vectorArg.position   = !!edgGeomData.pickPosition
  !vectorArg.direction  = !!edgGeomData.pickLine

  !!edgGeomData.realPosition = !!lineIntersec(!headPos, !tailPos, !vectorArg)
  !distanceToHead           = !!distanceFromTo(!!edgGeomData.realPosition, !headPos)
  !distanceToTail           = !!distanceFromTo(!!edgGeomData.realPosition, !tailPos)

  ---------------------
  -- END OF LINEAR?
  ---------------------

  !!edgGeomData.vector.position  = !headPos
  !!edgGeomData.vector.direction = !!directionFromTo(!headPos, !tailPos)

  if(!distanceToTail gt !distanceToHead) then
    !!edgGeomData.end         = 'Start'
    !!edgGeomData.position    = !headPos
    !!edgGeomData.direction   = !!directionFromTo(!headPos, !tailPos)
  else
    !!edgGeomData.end         = 'End'
    !!edgGeomData.position    = !tailPos
    !!edgGeomData.direction   = !!directionFromTo(!tailPos, !headPos)
  endif

  return TRUE

endfunction
-- End of function definition for !!edgPline
