--
-- File:            edgpop.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Mon Apr 28 15:54:37 BST 1997
--
--
-- Description:
-- Accepts ANY type of argument. Normally it will take the name of the
-- application (STRING) to remove from the stack.
-- If a REAL is passed removes !appNo from stack and compress is it. If
-- negative 1 is passed, removes what is on the top of the stack. Do NOT
-- use a REAL unless you are testing the EDG mechanisms.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         REAL;
--                             Indices of the application in the stack
--                             to remove. -1 means remove the last
--                             application. USED FOR TESTING ONLY
--                           STRING;
--                             Name of application to delete. The proper
--                             way to pop something off the stack.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if function has no errors
--
------------------------------------------------------------------------

define function !!edgPop(!arg1 is ANY) is BOOLEAN

  !lastApp      = REAL()
  !appNo        = REAL()
  !appName      = STRING()
  !arrayIndices = ARRAY()

  ----------------------------------------------------------------
  -- REAL argument type
  ----------------------------------------------------------------

  if(!arg1.objectType() eq 'REAL') then
    !appNo = !arg1

    if(!!view3DCntrl.actionStack.empty())then
      return TRUE
    endif

    if(!appNo eq -1) then
      !lastApp = !!view3DCntrl.actionStack.maxIndex()
      !!view3DCntrl.actionStack.deleteFrom(!lastApp)
    else
      !!view3DCntrl.actionStack.deleteFrom(!appNo, 1)
      handle any
        !!alert.error('Invalid Application Number')
        return FALSE
      endhandle

      !!view3DCntrl.actionStack.compress()
    endif

  ----------------------------------------------------------------
  -- STRING argument type
  ----------------------------------------------------------------

  elseif(!arg1.objectType() eq 'STRING') then
    !appName      = !arg1

    do !x indices !!view3DCntrl.actionStack
      if(!!view3DCntrl.actionStack[!x].appName eq !appName) then
        !arrayIndices.append(!x)
      endif
    enddo

    if(!arrayIndices.size() eq 0) then
      return false

    elseif(!arrayIndices.size() gt 1) then
      -- App could be stack more than once, remove one on top of stack
      !!view3DCntrl.actionStack.deleteFrom(!arrayIndices.last(), 1)

    else
      !!view3DCntrl.actionStack.deleteFrom(!arrayIndices[1], 1)
    endif

    !!view3DCntrl.actionStack.compress()

  endif

  -------------------------------------------
  -- SET VIEWS TO COMPLY WITH OBJECT NOW ON
  -- TOP OF THE STACK
  -------------------------------------------

  call !!edgSetViews(!!edgData.list.val, '')

  if(!!view3DCntrl.actionStack.unset()) then
     !!edgGeomTBar.hide()

     do !x indices !!view3DCntrl.designViews
       !!view3DCntrl.designViews[!x].runInMode('NATIVE')
     enddo

    !!edgGeomData.optionPmt = ''
    !!edgGeomData.rootPmt   = ''

    do !x indices !!view3DCntrl.designViews
      !!view3DCntrl.designViews[!x].owner().prompt.val = ''
    enddo

    return TRUE

  elseif( (!!view3DCntrl.actionStack.last().showPickForm eq FALSE) or $
          (!!view3DCntrl.actionStack.last().showPickForm.unset() )    ) then

    !!edgGeomTBar.hide()

    do !x indices !!view3DCntrl.designViews
      !!view3DCntrl.designViews[!x].setInMode(!!view3DCntrl.actionStack.last().inMode)
    enddo
  else
    show !!edgGeomTBar

    -- Test if Working Points is on Stack (not best way to do this...)

    if(!!view3DCntrl.actionStack.last().appName eq 'Working Points') then
      show !!edgWorkPoint
    endif
  endif

  -----------------------------------
  -- Reset Prompts for Views
  -----------------------------------

  if(!!view3DCntrl.actionStack.set()) then
    !nameOfApp = !!view3DCntrl.actionStack.last().appName
    !root      = !!view3DCntrl.actionStack.last().rootPrompt
    !option    = !!view3DCntrl.actionStack.last().optionPrompt

    call !!edgGeomPrmpt(!nameOfApp, !root, !option)
  endif

  -----------------------------------
  -- Reset Qualifiers for views
  -----------------------------------

  call !!edgGeomFilt()

  return TRUE

endfunction
-- End of function definition for !!edgPop
