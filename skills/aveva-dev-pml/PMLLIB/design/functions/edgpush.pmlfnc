--
-- Author:          P.Mooney
-- Created:         Mon Apr 28 15:29:25 BST 1997
--
--
-- Description:
-- Adds new application details to the stack, making it the new
-- function in control.
--
--  . Checks the arguments are OK
--  . Adds them to the stack
--  . Sets the mode for each DesignView for the new Application
--  . Show/Hide toolbar, depending on what the new application wants.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      EDGPUSHPARAMS  See Object Definition file for description
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if added to stack
--
------------------------------------------------------------------------

define function !!edgPush(!args is EDGPUSHPARAMS) is BOOLEAN

--!bResult  = BOOLEAN()

  ---------------------------------------------------------------
  -- Set what type of items can be picked (PANY, PPOINT....)
  -- If no !pickType is empty, it is set to a valid type.
  -- in !!edgHandlerChk()
  ---------------------------------------------------------------

--  !bResult = !!edgGeomHdlr(!args.inMode)
--  if(!bResult eq FALSE) then
--    return FALSE
--  else
--    !!edgGeomTBar.pTYP.select('RTEXT', |$!args.inMode|)
--  endif

  if(!!edgHandlerChk('', !args.inMode) eq FALSE) then
    return FALSE
  endif

  !!edgGeomData.itemType = !args.inMode

  ---------------------------------------------------------------
  -- Check the arguments set. Make sure the Root and Option
  -- Prompt are OK.
  -- Add on '(' to end of function - callbacks need to be of the
  -- the form  '!!myFunction('
  ---------------------------------------------------------------

  if( (!args.pickHandler eq 'DEFAULT')  or $
      (!args.pickHandler.empty()     )  or $
      (!args.pickHandler.unset()     )) then
    !args.pickHandler = '!!edgPickMode('
  else
    !args.pickHandler = !args.pickHandler + '('
  endif

  ---------------------------------------------------------------
  -- PUT SUPPLIED DATA ONTO actionStack
  ---------------------------------------------------------------

  !!view3DCntrl.actionStack.append(!args)

  -------------------------------------------
  -- SET VIEWS TO NEW CALLBACK AND IF IN NAVI
  -- MODE, DEFAULT TO DISTANCE
  -------------------------------------------

  if(!!edgData.list.selection().part(5, '\') eq 'NAVI') then
    do !x from 2 to 100
      !pickOption   = !!edgData.list.rText[!x]
      !eventHandler = !pickOption.part(2, '\')
      if(!eventHandler eq 'DIST ') then
        break
      endif
    enddo

    call !!edgSetViews(!x, '')
    !!edgData.list.val = !x
  else
    -- This would be better if the EDGPUSHPARAMS had the Option Value
    -- specified ('DIST', '100')
    call !!edgSetViews(!!edgData.list.val, '')
  endif

  call !!edgGeomFilt()

  ---------------------------------------------
  -- SET VIEWS TO DEFAULT PICKING AND SHOW
  -- TOOLKIT FORM
  ---------------------------------------------

  if(!args.showPickForm eq TRUE) then
    show !!edgGeomTBar
  else
    !!edgGeomTBar.hide()
  endif

  return TRUE

endfunction
-- End of function definition for !!edgPush
