-- File:            edgsctn.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Wed Apr 30 17:40:14 BST 1997
--
--
-- Description:
-- Works out the position of SCTN picked. Also, the RealPosition,
-- ItemLength...
--
-- It works by getting the Head & Tail positions of the section. These
-- are dependent on what the user has selected as Head & Tail from
-- Settings-> Section Start/End.
--
-- NOTE: old VAR syntax has been used to speed up performance. Functions
--       that should be used are;
--
--       !!distanceFromTo(!pos1, !pos2)
--       !!directionFromTo(!headPos, !tailPos)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if everything went OK.
--
------------------------------------------------------------------------

define function !!edgSctn() is BOOLEAN

  ------------------------------------------------------------
  -- POS.START TO POS.end
  ------------------------------------------------------------

  if(|$_cdGeomSctn_ScAFlg| eq 'POS') then
    !headPos = !!edgGeomData.pickedItem.posStart
    !tailPos = !!edgGeomData.pickedItem.posEnd

  ------------------------------------------------------------
  -- MEMBER LINE W.P.
  ------------------------------------------------------------

  elseif(|$_cdGeomSctn_ScBFlg| eq 'MMWP') then

    if(!!edgGeomData.pickedItem.memLine.set()) then
      !attrib = !!edgGeomData.pickedItem.memLine
    else
      !attrib = 'NA'
    endif

    !sctn1 = !!edgGeomData.pickedItem.joiStart.owner.owner
    !sctn2 = !!edgGeomData.pickedItem.joiEnd.owner.owner

    if(!sctn1.memLine.set()) then
      !pos1  = !sctn1.plStart.attribute(!sctn1.memLine)
      !pos2  = !sctn1.plEnd.attribute(!sctn1.memLine)
    else
      !pos1  = !sctn1.plStart.attribute('NA')
      !pos2  = !sctn1.plEnd.attribute('NA')
    endif
    var !beam1Line CONST LINE JOIN $!pos1 TO $!pos2

    if(!sctn2.memLine.set()) then
      !pos1  = !sctn2.plStart.attribute(!sctn2.memLine)
      !pos2  = !sctn2.plEnd.attribute(!sctn2.memLine)
    else
      !pos1  = !sctn2.plStart.attribute('NA')
      !pos2  = !sctn2.plEnd.attribute('NA')
    endif
    var !beam2Line CONST LINE JOIN $!pos1 TO $!pos2

    !headPos = !!edgGeomData.pickedItem.plStart.attribute(!attrib)
    !tailPos = !!edgGeomData.pickedItem.plEnd.attribute(!attrib)
    var !pickedSctnLine CONST LINE JOIN $!headPos TO $!tailPos

    var !szHeadPos  CONST POS INTER $!pickedSctnLine $!beam1Line
    var !szTailPos  CONST POS INTER $!pickedSctnLine $!beam2Line

    !headPos = !szHeadPos.position()
    !tailPos = !szTailPos.position()

  ------------------------------------------------------------
  -- JUSTIFICATION W.P.
  ------------------------------------------------------------

  elseif(|$_cdGeomSctn_ScCFlg| eq 'JJWP') then

    if(!!edgGeomData.pickedItem.jusLine.set()) then
      !attrib = !!edgGeomData.pickedItem.jusLine
    else
      !attrib = 'NA'
    endif

    !sctn1 = !!edgGeomData.pickedItem.joiStart.owner.owner
    !sctn2 = !!edgGeomData.pickedItem.joiEnd.owner.owner

    if(!sctn1.jusLine.set()) then
      !pos1  = !sctn1.plStart.attribute(!sctn1.jusLine)
      !pos2  = !sctn1.plEnd.attribute(!sctn1.jusLine)
    else
      !pos1  = !sctn1.plStart.attribute('NA')
      !pos2  = !sctn1.plEnd.attribute('NA')
    endif
    var !beam1Line CONST LINE JOIN $!pos1 TO $!pos2

    if(!sctn2.jusLine.set()) then
      !pos1  = !sctn2.plStart.attribute(!sctn2.jusLine)
      !pos2  = !sctn2.plEnd.attribute(!sctn2.jusLine)
    else
      !pos1  = !sctn2.plStart.attribute('NA')
      !pos2  = !sctn2.plEnd.attribute('NA')
    endif
    var !beam2Line CONST LINE JOIN $!pos1 TO $!pos2

    !headPos = !!edgGeomData.pickedItem.plStart.attribute(!attrib)
    !tailPos = !!edgGeomData.pickedItem.plEnd.attribute(!attrib)
    var !pickedSctnLine CONST LINE JOIN $!headPos TO $!tailPos

    var !szHeadPos  CONST POS INTER $!pickedSctnLine $!beam1Line
    var !szTailPos  CONST POS INTER $!pickedSctnLine $!beam2Line

    !headPos = !szHeadPos.position()
    !tailPos = !szTailPos.position()

  endif

  --------------------------------------------------------------
  -- We now know where the Head & Tail of the WHOLE beam are.
  -- If intermediate button pressed and
  -- consider SNODs, Joints & Fittings, get nearest SNOD, FITT
  -- or JOIN.
  --------------------------------------------------------------

  var !itemLength CONST DIST $!headPos TO $!tailPos
  !!edgGeomData.itemLength = !itemLength.real()

  if((!!edgGeomTBar.sflg.val eq TRUE  ) and $
     ( (|$_cdGeomSnap_Node| eq 'true') or  $
       (|$_cdGeomSnap_Join| eq 'true') or  $
       (|$_cdGeomSnap_Fitt| eq 'true')   )) then

    !memberCount = !!edgGeomData.pickedItem.mCount()

    if(!memberCount gt 0) then

      !zDistDbRef   = object EDGZDISTDBREF()
      !realDistance = REAL()

      var !line1 CONST LINE JOIN $!headPos TO $!tailPos
      var !line2 CONST LINE $!!edgGeomData.pickLine THROUGH $!!edgGeomData.pickPosition
      var !realPos CONST POS INTER $!line1 $!line2
      !!edgGeomData.realPosition = !realPos.position()

      var !realDist  CONST DIST $!!edgGeomData.realPosition TO $!headPos
      !realDistance = !realDist.real()

      ---------------------------------------------------------------
      -- Build !array with ZDistances, Head (0) at front and Distance
      -- away from Head for each SNOD/FITT/JOINT that is a member of
      -- the SCTN.
      ---------------------------------------------------------------

      !array = ARRAY()

      !zDistDbRef.zDist = 0
      !zDistDbRef.item = object DBREF()
      !array.append(!zDistDbRef)

      do !i from 1 to !memberCount
        if((!!edgGeomData.pickedItem.member[!i].type eq 'SNOD')  and $
           (|$_cdGeomSnap_Node| eq 'true')               ) then
          !zDistDbRef.zDist = !!edgGeomData.pickedItem.member[!i].zDistance
          !zDistDbRef.item = !!edgGeomData.pickedItem.member[!i]
          !array.append(!zDistDbRef)
        elseif((!!edgGeomData.pickedItem.member[!i].type eq 'FITT')  and $
               (|$_cdGeomSnap_Fitt| eq 'true')               ) then
          !zDistDbRef.zDist = !!edgGeomData.pickedItem.member[!i].zDistance
          !zDistDbRef.item = !!edgGeomData.pickedItem.member[!i]
          !array.append(!zDistDbRef)
        endif
      enddo

      !zDistDbRef.zDist = !!edgGeomData.itemLength
      !zDistDbRef.item = object DBREF()
      !array.append(!zDistDbRef)

      ---------------------------------------
      -- Sort !array of objects by ZDistance
      ---------------------------------------

      !memberSort   = object BLOCK('!array[!evalIndex].zDist')
      !extractZDist = !array.evaluate(!memberSort)
      !order        = !extractZDist.sortedIndices()
      !array.reIndex(!order)

      -- Work out if near SNOD, FITT, JOINT

      do !x from 1 to !array.maxIndex()
        if(!x eq !array.maxIndex()) then
          -- !x is now last in array, thus picked Tail.

          var !dir     CONST DIR   $!headPos TO $!tailPos
          var !index   $!x - 1
          var !plane   CONST PLANE $!dir THROUGH $!headPos DIST $!array[$!index].zDist
          var !hPos CONST POS   $!plane

          var !plane   CONST PLANE $!dir THROUGH $!headPos DIST $!!edgGeomData.itemLength
          var !tPos CONST POS   $!plane

          !headPos = !hPos.position()
          !tailPos = !tPos.position()
        else
          !after    = ABS(!array[!x + 1].zDist - !array[!x].zDist) / 2

          if(!x neq 1) then
            !before = ABS(!array[!x - 1].zDist - !array[!x].zDist) / 2
          else
            !before = 0
          endif

          if(!realDistance lt (!array[!x].zDist + !after)  and $
             !realDistance gt (!array[!x].zDist - !before)) then

            var !dir    CONST DIR   $!headPos TO $!tailPos
            var !plane  CONST PLANE $!dir THROUGH $!headPos DIST $!array[$!x].zDist
            var !hPos   CONST POS   $!plane

            if(!realDistance lt !array[!x].zDist) then
              !index = !x - 1
            else
              !index = !x + 1
            endif

            var !plane   CONST PLANE $!dir THROUGH $!headPos DIST $!array[$!index].zDist
            var !tPos CONST POS   $!plane

            !headPos = !hPos.position()
            !tailPos = !tPos.position()

            break

          endif
        endif
      enddo

    endif
  endif

  var !dir  CONST DIR $!headPos TO $!tailPos

  !!edgGeomData.vector.position  = !headPos
  !!edgGeomData.vector.direction = !dir.direction()

  var !line1 CONST LINE JOIN $!headPos TO $!tailPos
  var !line2 CONST LINE $!!edgGeomData.pickLine THROUGH $!!edgGeomData.pickPosition
  var !realPos CONST POS INTER $!line1 $!line2
  !!edgGeomData.realPosition = !realPos.position()

  var !length CONST DIST $!headPos TO $!tailPos
  !!edgGeomData.itemLength    = !length.real()

  var !distHead  CONST DIST $!!edgGeomData.realPosition TO $!headPos
  var !distTail  CONST DIST $!!edgGeomData.realPosition TO $!tailPos

  !distanceToHead = !distHead.real()
  !distanceToTail = !distTail.real()

  if(!distanceToTail gt !distanceToHead) then
    !!edgGeomData.end         = 'Start'
    !!edgGeomData.position    = !headPos
    var !dir  CONST DIR $!headPos TO $!tailPos
    !!edgGeomData.direction   = !dir.direction()
  else
    !!edgGeomData.end         = 'End'
    !!edgGeomData.position    = !tailPos
    var !dir  CONST DIR $!tailPos TO $!headPos
    !!edgGeomData.direction   = !dir.direction()
  endif

  return TRUE

endfunction
-- End of function definition for !!edgSctn
