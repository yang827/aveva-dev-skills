--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Thu Apr 24 14:53:24 BST 1997
--
--
-- Description:
-- Callback on !!edgGeomTBar for most of the buttons. Sets the design views
-- mode to what the user has chosen. Also changes the colour of the
-- current button on the Pick toolbar to red.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Number of selected line in !edgData.list
--    2   R      ANY         New button pressed. NO LONGER USED -
--                           pass ''
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgSetViews(!optionNumber is REAL, !dummyGadget is ANY)

  -----------------------------------------
  -- Set colour of the last button to clear
  -- Set colour of active button to RED
  -----------------------------------------

  if(!!edgGeomTBar.lastGadget.set()) then
    !!edgGeomTBar.lastGadget.background = 205
  endif

  if(!optionNumber eq 1) then
    -- Navigate button, name different
    !!edgGeomTBar.lastGadget = !!edgGeomTBar.n
  else
    !!edgGeomTBar.lastGadget = !!edgGeomTBar.a$!optionNumber$nB
  endif

  !!edgGeomTBar.lastGadget.background = 'RED'

  !!edgData.list.val = !optionNumber
  !pickOption            = !!edgData.list.rText[!optionNumber]

  -----------------------------------------------------------
  -- We have got the string specifying the Pick options. Strip
  -- out the various options
  -----------------------------------------------------------

  !eventHandler         = !pickOption.part(1, '\')
  !inMode               = !pickOption.part(5, '\').trim()
  !!edgGeomData.option  = !pickOption.part(2, '\')
  !szTemp               = !pickOption.part(3, '\').trim()

  if(!szTemp.upcase() eq 'ASK') then
    !szTemp3            = |!!edgGeomTBar.a$!optionNumber|
    !szTemp2            = |$$$!szTemp3|
    !szTemp             = |$!szTemp2|

    !!edgGeomData.value = !szTemp.real()

    if (!!edgGeomData.value.unset()) then
      !!edgGeomData.value = 0
    endif
  else
    !!edgGeomData.value = !szTemp.real()
  endif

  if(!inMode.empty())then
    !inMode  = !!edgGeomTBar.pTYP.selection()
  endif

  if(!!edgHandlerChk(!eventHandler, !inMode) eq FALSE) then
    return
  endif

  --------------------------------------------------
  -- GET PICK HANDLER FROM OBJECT ON STACK AND SET
  -- VIEWS. ASSUME NAVI INMODE IS FOR NAVIGATE, NOT
  -- TO PICK NAVIGATEABLE INMODE.
  --------------------------------------------------

  if (!!view3DCntrl.actionStack.set()) then
    !pushObject = !!view3DCntrl.actionStack.last()
    !callback   = 'call ' & !pushObject.pickHandler
  else
    !callback = ''
  endif

  if(!inMode eq 'NAVI') then
    do !x indices !!view3DCntrl.designViews
      !!view3DCntrl.designViews[!x].runInMode('NATIVE')
    enddo
  else
    do !x indices !!view3DCntrl.designViews
      !!view3DCntrl.designViews[!x].callback = !callback
    enddo

    call !!edgGeomHdlr(!inMode)
  endif

--  call !!edgGeomHdlr(!inMode)

endfunction
-- End of function definition for !!edgSetViews
