--
--
-- Description:
-- Sets up EDG for define Working Points.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgSetWP()

  !bResult = BOOLEAN()

  SHOW !!edgWorkPoint

  !!edgGeomTBar.wpShown = TRUE

  ----------------------------------------------------------------------
  -- Set EDG to pick elements (PICK) and only sections (See Qualifier)
  ----------------------------------------------------------------------

  !args              = object EDGPUSHPARAMS()
  !args.pickHandler  = 'DEFAULT'
  !args.inMode       = 'PICK'
  !args.userFunction = '!!edgWorkCBack()'
  !args.appName      = 'Working Points'
  !args.showPickForm = TRUE
  !args.elementQual  = 'TYPE eq |SCTN|'

  !bResult = !!edgPush(!args)

  !bResult = !!edgGeomPrmpt('Working Points', '', ' A big one')

  ----------------------------------------------------------------------
  -- Initialise form !!edgWorkPoint
  ----------------------------------------------------------------------

  !!edgWorkPoint.aid.aidNumb   = 0
  !!edgWorkPoint.aid.aidPos    = object POSITION()
  !!edgWorkPoint.aid.aidOwner  = object DBREF()
  !!edgWorkPoint.aid.ownerType = STRING()
  !!edgWorkPoint.east.val      = 0
  !!edgWorkPoint.north.val     = 0
  !!edgWorkPoint.up.val        = 0

endfunction
-- End of function definition for !!edgSetWP
