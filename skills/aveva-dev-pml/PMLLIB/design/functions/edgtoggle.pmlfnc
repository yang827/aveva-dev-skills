-- Author:          P.Mooney
-- Created:         Mon Jul 28 15:31:16 BST 1997
--
--
-- Description:
-- Callback to make toggle buttons look like radio buttons. It is
-- nonsense to consider panels as outside lines and fittings/vertices.
-- This sets the toggle buttons accordingly.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to describe which toggle button was
--                           pressed. 'PFIT', 'VERT', 'LINES' are
--                           examples
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgToggle(!toggleOption is STRING)

  if(!toggleOption eq 'LINES') then
    var _cdGeomSnap_Pfit |false|
    var _cdGeomSnap_Vert |false|
  elseif(!toggleOption eq 'PFIT' or !toggleOption eq 'VERT') then
    var _cdGeomSnap_Line |false|
  endif

endfunction
-- End of function definition for !!edgToggle
