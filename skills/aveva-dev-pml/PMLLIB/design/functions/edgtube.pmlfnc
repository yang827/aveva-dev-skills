--
-- File:            edgtube.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Thu Apr 17 17:12:21 BST 1997
--
--
-- Description:
-- Handles calculations needed for the EDG in relation to tubing.
-- Works out; TubeLength
--            Which end of tube was picked and hence;
--            Position of element at the picked end
--
-- The form !!edgGeomData has nearly everything set - The pick vector and
-- the pickline and the Dbref of the first element.
-- Likewise, values are set in !!edgGeomData, thus no return
-- arguments.
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Sets what the start and end positions of
--                           the tube should be eg. OriginToOrigin
--                           (see comment in code)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     FALSE if no error occurred
--
------------------------------------------------------------------------

define function !!edgTube(!startEnd is STRING) is BOOLEAN

  !headOrigin     = object POSITION()
  !tailOrigin     = object POSITION()
  !headPos        = object POSITION()
  !tailPos        = object POSITION()

  !headDir        = object DIRECTION()
  !tailDir        = object DIRECTION()

  !vectorArg      = object VECTOR()

  !nextElement    = object DBREF()

  !distanceToHead = REAL()
  !distanceToTail = REAL()

  !noNextElement  = object BOOLEAN()
  !noNextElement  = FALSE

  -------------------------------------------------------------
  -- Is the tube the first element of the branch?
  -------------------------------------------------------------

  if(!!edgGeomData.pickedItem.type eq 'BRAN' or !!edgGeomData.pickedItem.type eq 'HANG') then
    !headOrigin  = !!edgGeomData.pickedItem.hpos.wrt(world)
    !headPos     = !!edgGeomData.pickedItem.hpos.wrt(world)
    !headDir     = !!edgGeomData.pickedItem.hdir

    do !i from 1
      if(not !!edgIgnoreTube(!!edgGeomData.pickedItem.members[!i]) ) then
        !tailOrigin  = !!edgGeomData.pickedItem.members[!i].pos.wrt(world)
        !tailPos     = !!edgGeomData.pickedItem.members[!i].pPos[!!edgGeomData.pickedItem.members[!i].arrive].wrt(world)
        !tailDir     = !!edgGeomData.pickedItem.members[!i].pdir[!!edgGeomData.pickedItem.members[!i].arrive]

        !nextElement = !!edgGeomData.pickedItem.members[!i]
        break
      endif
    enddo

  -------------------------------------------------------------
  -- Tube is not first element in branch.
  -- Check if we have got a ATTA, WELD etc....
  -------------------------------------------------------------
  else
    if(!!edgIgnoreTube(!!edgGeomData.pickedItem)) then
       do !i from !!edgGeomData.pickedItem.sequ to 0 by -1
         if (!i eq 0) then
           !headOrigin  = !!edgGeomData.pickedItem.owner.hpos.wrt(world)
           !headPos     = !!edgGeomData.pickedItem.owner.hpos.wrt(world)
           !headDir     = !!edgGeomData.pickedItem.owner.hdir
         elseif(not !!edgIgnoreTube(!!edgGeomData.pickedItem.owner.member[!i])) then
           !headOrigin  = !!edgGeomData.pickedItem.owner.member[!i].pos.wrt(world)
           !headPos     = !!edgGeomData.pickedItem.owner.member[!i].pPos[!!edgGeomData.pickedItem.leave].wrt(world)
           !headDir     = !!edgGeomData.pickedItem.owner.member[!i].pdir[!!edgGeomData.pickedItem.leave]
           break
         endif
       enddo
    else
      !headOrigin  = !!edgGeomData.pickedItem.pos.wrt(world)
      !headPos     = !!edgGeomData.pickedItem.pPos[!!edgGeomData.pickedItem.leave].wrt(world)
      !headDir     = !!edgGeomData.pickedItem.pdir[!!edgGeomData.pickedItem.leave]
    endif

    -----------------------------------------------------
    -- Work out where other end of tube is (Tail)
    -----------------------------------------------------

    !nextElement = !!edgGeomData.pickedItem.owner.members[!!edgGeomData.pickedItem.sequ + 1]
    handle any
      !noNextElement = TRUE

      !tailOrigin  = !!edgGeomData.pickedItem.owner.tPos.wrt(world)
      !tailPos     = !!edgGeomData.pickedItem.owner.tPos.wrt(world)
      !tailDir     = !headDir
    elsehandle none
      do !i from !nextElement.sequ to !!edgGeomData.pickedItem.owner.mCount()
        if(not !!edgIgnoreTube(!nextElement.owner.members[!i])) then
          !tailOrigin  = !nextElement.owner.members[!i].pos.wrt(world)
          !tailPos     = !nextElement.owner.members[!i].pPos[!nextElement.arrive].wrt(world)
          !tailDir     = !nextElement.owner.members[!i].pdir[!nextElement.arrive]
          break
        endif
      enddo
    endhandle
  endif

  !!edgGeomData.tubeLength = !!distanceFromTo(!headPos, !tailPos)
  !!edgGeomData.itemLength = !!distanceFromTo(!headPos, !tailPos)
  !!edgGeomData.direction  = !!directionFromTo(!headPos, !tailPos)

  !vectorArg.position   = !!edgGeomData.pickPosition
  !vectorArg.direction  = !!edgGeomData.pickLine

  !!edgGeomData.realPosition         = !!lineIntersec(!headPos, !tailPos, !vectorArg)
  !distanceToHead       = !!distanceFromTo(!!edgGeomData.realPosition, !headPos)
  !distanceToTail       = !!distanceFromTo(!!edgGeomData.realPosition, !tailPos)

  !!edgGeomData.vector.position  = !headPos
  !!edgGeomData.vector.direction = !!directionFromTo(!headPos, !tailPos)

  -------------------------------------------------------------
  -- store EDG pickline & position
  -------------------------------------------------------------

  !!edgGeomData.vector.direction = !!directionFromTo(!headPos, !tailPos)
  !!edgGeomData.vector.position  = !headPos

  -------------------------------------------------------------
  -- Assign position (maybe direction if tail). It can be;
  --  . the leave to arrive of the components
  --  . the Tube plus components
  --  . The origin to origin of the 2 components
  -------------------------------------------------------------

  if(!distanceToTail gt !distanceToHead) then
    !!edgGeomData.end = 'Start'
  else
    !!edgGeomData.end = 'End'
  endif

  -----------------
  -- TubeLength
  -----------------

  if(!startEnd eq 'TubeLength') then
    if(!distanceToTail gt !distanceToHead) then
      !!edgGeomData.position    = !headPos
    else
      !!edgGeomData.position    = !tailPos
      !!edgGeomData.direction   = !!directionFromTo(!tailPos, !headPos)
    endif

  -----------------
  -- OriginToOrigin
  -----------------

  elseif (!startEnd eq 'OriginToOrigin') then
    if(!distanceToTail gt !distanceToHead) then
      !!edgGeomData.position    = !headOrigin
    else
      !!edgGeomData.position    = !tailOrigin
      !!edgGeomData.direction   = !!directionFromTo(!tailPos, !headPos)
    endif

  ------------------
  -- Tube+Components
  ------------------

  elseif (!startEnd eq 'Tube+Components') then
    if(!distanceToTail gt !distanceToHead) then

      if(!!edgGeomData.pickedItem.type eq 'BRAN' or !!edgGeomData.pickedItem.type eq 'HANG') then
        !!edgGeomData.position = !!edgGeomData.pickedItem.hpos
      else
        !!edgGeomData.position   = !!edgGeomData.pickedItem.pPos[!!edgGeomData.pickedItem.arrive].wrt(world)
      endif
    else
      if(!noNextElement eq TRUE) then
        !!edgGeomData.position   = !tailPos
        !!edgGeomData.direction  = !!directionFromTo(!tailPos, !headPos)
      else
        !!edgGeomData.position   = !nextElement.pPos[!nextElement.leave].wrt(world)
        !!edgGeomData.direction  = !!directionFromTo(!tailPos, !headPos)
      endif
    endif
  else
    !!alert.error('This message does not use new message system!')
    return TRUE
  endif

  ---------------------------------------------------------------------------
  -- If pick Origin to Origin or Tube+Component then may be of the line of
  -- the tube. Get the nearest position on the line of the tube.
  ---------------------------------------------------------------------------

  !!edgGeomData.position = !!posNearLine(!!edgGeomData.position, !headPos, !tailPos)

  return FALSE

endfunction
-- End of function definition for !!edgTube
