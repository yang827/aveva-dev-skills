--
-- File:            edgupdateapp.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Sep 9 15:56:55 BST 1997
--
--
-- Description:
--
-- This allows a quick way of changing an applications settings
-- on the fly instead of popping the app off the stack & pushing
-- it back on.
--
-- If the calling application is not on the top of the stack, the Views
-- will not be modified, only the object on the stack.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      EDGPUSHPARAMS  contains members to be modified.
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN      TRUE  if stack modified ok.
--                 FALSE if; 1. Stack empty
--                           2. App Name not found on stack
--
------------------------------------------------------------------------

define function !!edgUpdateApp(!args is EDGPUSHPARAMS) is BOOLEAN

  !arrayIndices = ARRAY()
  !x            = REAL()


  if(!!view3DCntrl.actionStack.set()) then
    do !x indices !!view3DCntrl.actionStack
      if(!!view3DCntrl.actionStack[!x].appName eq !args.appName) then
        !arrayIndices.append(!x)
      endif
    enddo

    if(!arrayIndices.size() geq 1) then

      -- App could be on stack more than once, use one on top of stack
      !copy = !!view3DCntrl.actionStack[!arrayIndices.last()]

      if(!args.rootPrompt.set() AND NOT !args.rootPrompt.empty()) then
        !copy.rootPrompt   = !args.rootPrompt
      endif

      if(!args.optionPrompt.set() AND NOT !args.optionPrompt.empty()) then
        !copy.optionPrompt = !args.optionPrompt
      endif

      if(!args.elementQual.set() AND NOT !args.elementQual.empty()) then
        !copy.elementQual  = !args.elementQual
      endif

      if(!args.pointQual.set() AND NOT !args.pointQual.empty()) then
        !copy.pointQual    = !args.pointQual
      endif

      if(!args.aidQual.set() AND NOT !args.empty()) then
        !copy.aidQual      = !args.aidQual
      endif

      if(!args.tubiQual.set() AND NOT !args.tubiQual.empty()) then
        !copy.tubiQual     = !args.tubiQual
      endif

      if(!args.userFunction.set() AND NOT !args.userFunction.empty()) then
        !copy.userFunction = !args.userFunction
      endif

      if(!args.inMode.set() AND NOT !args.inMode.empty()) then
        !copy.inMode       = !args.inMode
      endif


      !!view3DCntrl.actionStack[!arrayIndices.last()] = !copy

      -----------------------------------------------
      -- call major functions if app on top of stack
      -- to set inmode, prompts and qualifiers.
      -----------------------------------------------

      if(!arrayIndices.last() eq !!view3DCntrl.actionStack.size()) then
        call !!edgGeomHdlr(!copy.inMode)
        call !!edgGeomFilt()
      endif

    else
      return FALSE
    endif

  else
    return FALSE
  endif

  return TRUE

endfunction
-- End of function definition for !!edgUpdateApp
