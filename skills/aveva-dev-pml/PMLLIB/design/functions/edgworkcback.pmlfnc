--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Jun 3 11:05:28 BST 1997
--
--
-- Description:
-- User callback function for Working Points when a user does a button
-- up on a view.
--
-- Projects Direction of pick line onto a plane pointing UP. Using
-- !!normalToDirs(), work out direction normal to beam, on correct
-- side of beam picked.
-- Stores data in !!edgWorkPoint.aid object (EDGAID).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgWorkCBack()

  !rTexts   = ARRAY()
  !counter  = REAL()
  !aidNumb  = REAL()

  !aidNumb  = 90000
  !counter  = 1

  --------------------------------------------
  -- Find nearest number to 90001 that is not
  -- used.
  --------------------------------------------

  !rTexts   = !!edgWorkPoint.list.rText

  if(not !rTexts.empty()) then
    do !x from 90001 to 90100

      if(!counter gt !rTexts.maxIndex()) then
        !aidNumb = !x
        break
      endif

      if(!rTexts[!counter].real() neq !x) then
        !aidNumb = !x
        break
      endif

      !counter = !counter + 1
    enddo
  else
    !aidNumb  = 90001
  endif

  var !line      CONST LINE PROJECTION LINE $!!edgGeomData.pickLine THROUGH $!!edgGeomData.position ON PLANE U THROUGH $!!edgGeomData.position
  var !mappedDir CONST DIR  $!line
  !normalPLine   = !mappedDir.direction()

  !dirTmp        = !!normalToDirs(!!edgGeomData.direction, !normalPLine)

  ---------------------------------------
  -- possible picked exactly on plane...
  ---------------------------------------

  if(!dirTmp.origin.unset()) then
    !dirTmp   = !!edgGeomData.direction
    !normalDir = !!edgGeomData.direction
  else
    !normalDir = !!normalToDirs(!!edgGeomData.direction, !dirTmp)
  endif

  var !plane CONST PLANE $!normalDir THROUGH $!!edgGeomData.position DIST $!!edgWorkPoint.offset
  var !sPos  CONST POS NEAR $!!edgGeomData.position ON $!plane
  !tempPos   = !sPos.position()

  AID CLEAR SPHERE $!aidNumb
  handle any
  endhandle
  AID CLEAR ARROW  $!aidNumb
  handle any
  endhandle
  AID SPHERE NUMB  $!aidNumb $!tempPos DIAM 200
  AID ARROW  NUMB  $!aidNumb AT $!tempPos DIR $!normalDir HEIGHT 130

  AID CLEAR ARROW  90213
  handle any
  endhandle
  AID CLEAR ARROW  90214
  handle any
  endhandle
  AID CLEAR ARROW  90215
  handle any
  endhandle
  AID ARROW  NUMB  90213 AT $!!edgGeomData.position DIR $!!edgGeomData.direction HEIGHT 300
  AID ARROW  NUMB  90214 AT $!!edgGeomData.position DIR $!normalDir              HEIGHT 300
  AID ARROW  NUMB  90215 AT $!!edgGeomData.position DIR $!dirTmp                 HEIGHT 300

  ----------------------------------
  -- STORE DATA
  ----------------------------------

  !!edgWorkPoint.east.val  = !tempPos.east.real()
  !!edgWorkPoint.north.val = !tempPos.north.real()
  !!edgWorkPoint.up.val    = !tempPos.up.real()

  !!edgWorkPoint.aid.aidNumb   = !aidNumb
  !!edgWorkPoint.aid.aidPos    = !tempPos
  !!edgWorkPoint.aid.aidDir    = !normalDir
  !!edgWorkPoint.aid.aidOwner  = !!edgGeomData.pickedItem
  !!edgWorkPoint.aid.ownerType = !!edgGeomData.pickedItem.type
  handle any
    -- most likely picked a Sphere already defined.
  endhandle
  !!edgWorkPoint.aid.edgGeomData = !!edgGeomData

endfunction
-- End of function definition for !!edgWorkCBack
