-- File:            edgworkpoints.pmlfnc
--   Type:          Function Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Thu Apr 24 14:53:24 BST 1997
--
--
-- Description:
-- Sets up EDG for defining Working points.
--
-- Maintains the list on the form and the corresponding object array
-- !!edgWorkPoint.aidArray. It also acts as the callback for the
-- buttons on the form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'APPLY'   -
--                           'ADD'     - Adds Working Point to the list
--                           'MODIFY'  -
--                           'REMOVE'  - Removes WP from the list.
--                           'DISMISS' - Clears aid lines & hides form
--                                       and pops WP application off stack.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!edgWorkPoints(!arg1 is STRING)

  !dTextArray  = ARRAY()
  !rTextArray  = ARRAY()
  !rText       = STRING()
  !dText       = STRING()

  ------------------------------------------------------------------------
  -- Only perform !options if element has been picked. Dismiss is handled
  -- after IF statement.
  ------------------------------------------------------------------------

  if(!arg1 eq 'APPLY') then

  elseif(!arg1 eq 'AIDTEXT') then

    if(!!edgWorkPoint.aidText.val eq TRUE) then
      do !x from 1 to !!edgWorkPoint.aidArray.maxIndex()
        !numb = !!edgWorkPoint.aidArray[!x].aidNumb
        !pos  = !!edgWorkPoint.aidArray[!x].aidPos
        AID TEXT NUMB   $!numb |$!numb| AT $!pos
        AID SPHERE NUMB $!numb $!pos DIAM 200
      enddo
    else
      do !x from 1 to !!edgWorkPoint.aidArray.maxIndex()
        !numb = !!edgWorkPoint.aidArray[!x].aidNumb
        !pos  = !!edgWorkPoint.aidArray[!x].aidPos
        AID CLEAR TEXT $!numb
        handle any
          -- text not yet shown, sphere just added.
        endhandle
      enddo
    endif

  elseif(!arg1 eq 'ADD') then
    !rTextArray  = !!edgWorkPoint.list.rText
    !dTextArray  = !!edgWorkPoint.list.dText

    ---------------------------
    -- Is nothing selected yet?
    -- Don't ADD twice
    ---------------------------

    if(!!edgWorkPoint.aid.aidNumb eq 0) then
      !!alert.warning('You must pick something first')
      return
    endif

    do !x from 1 to !rTextArray.maxIndex()
      if(!rTextArray[!x] eq !!edgWorkPoint.aid.aidNumb.string()) then
        return
      endif
    enddo

    ------------------------------------------------
    -- store new object in array and add text to
    -- list gadget
    ------------------------------------------------

    !rText       = !!edgWorkPoint.aid.aidNumb.string()
    !dText       = 'Aid ' & !!edgWorkPoint.aid.aidNumb

    !newObject   = object EDGAID()

    !newObject.aidNumb     = !!edgWorkPoint.aid.aidNumb
    !newObject.aidPos      = !!edgWorkPoint.aid.aidPos
    !newObject.aidDir      = !!edgWorkPoint.aid.aidDir
    !newObject.aidOwner    = !!edgGeomData.pickedItem
    !newObject.ownerType   = !!edgWorkPoint.aid.ownerType

    !newObject.edgGeomData = !!edgWorkPoint.aid.edgGeomData

    !!edgWorkPoint.aidArray.append(!newObject)

    !rTextArray.append(!rText)
    !dTextArray.append(!dText)

    !rTextArray.sort()
    !dTextArray.sort()

    !aidNumSort = object BLOCK('!!edgWorkPoint.aidArray[!evalIndex].aidNumb')
    !aidNumbers = !!edgWorkPoint.aidArray.evaluate(!aidNumSort)
    !order      = !aidNumbers.sortedIndices()

    !!edgWorkPoint.aidArray.reIndex(!order)

    !!edgWorkPoint.list.dText = !dTextArray
    !!edgWorkPoint.list.rText = !rTextArray

    -- Show aid number as aid text for new point?

    if(!!edgWorkPoint.aidText.val eq TRUE) then
      AID TEXT NUMB $!!edgWorkPoint.aid.aidNumb |$!!edgWorkPoint.aid.aidNumb| AT $!!edgWorkPoint.aid.aidPos
    endif

  elseif(!arg1 eq 'MODIFY') then

  -----------------------------------------------
  -- REMOVE
  --   remove item selected on list from RText
  --   and DText. Remove from AidArray. Clear
  --   sphere and arrow representing it.
  -----------------------------------------------

  elseif(!arg1 eq 'REMOVE') then
    if(!!edgWorkPoint.list.val gt 0) then

      !rTextArray  = !!edgWorkPoint.list.rText
      !dTextArray  = !!edgWorkPoint.list.dText

      !aidNumb     = !!edgWorkPoint.list.rText[!!edgWorkPoint.list.val].part(1, ' ').real()

      !rTextArray.deleteFrom(!!edgWorkPoint.list.val, 1)
      !dTextArray.deleteFrom(!!edgWorkPoint.list.val, 1)

      !rTextArray.sort()
      !dTextArray.sort()

      !rTextArray.compress()
      !dTextArray.compress()

      !!edgWorkPoint.list.dText = !dTextArray
      !!edgWorkPoint.list.rText = !rTextArray

      !index = 0

      do !x from 1 to !!edgWorkPoint.aidArray.maxIndex()
        if(!!edgWorkPoint.aidArray[!x].aidNumb eq !aidNumb) then
          !index = !x
        endif
      enddo

      !!edgWorkPoint.aidArray[!index].delete()
      !!edgWorkPoint.aidArray.compress()

      AID CLEAR SPHERE $!aidNumb
      handle any
      endhandle
      AID CLEAR ARROW  $!aidNumb
      handle any
      endhandle
      AID CLEAR TEXT   $!aidNumb
      handle any
      endhandle
    endif
  endif

  -----------------------------------------------
  -- DISMISS
  --   Tidy up any arrows showing actual position
  --   and a sphere that may have been displayed
  --   but not added.
  -----------------------------------------------

  if(!arg1 eq 'DISMISS') then
    do !x from 90210 to 90215
      AID CLEAR ARROW $!x
      handle any
      endhandle
    enddo

    !index = 0

    do !x from 1 to !!edgWorkPoint.aidArray.maxIndex()
      if(!!edgWorkPoint.aidArray[!x].aidNumb eq !!edgWorkPoint.aid.aidNumb) then
        !index = !x
      endif
    enddo

    if(!index eq 0) then
      AID CLEAR SPHERE $!!edgWorkPoint.aid.aidNumb
      handle any
      endhandle
      AID CLEAR ARROW  $!!edgWorkPoint.aid.aidNumb
      handle any
      endhandle
    endif

    -------------------------------------
    -- Hide form & remove App from stack
    -------------------------------------

    !!edgWorkPoint.hide()
    !!edgPop('Working Points')
  endif

endfunction
-- End of function definition for !!edgWorkPoints
