--
--
-- Description:
-- Navigate to picked object
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
--
------------------------------------------------------------------------
define function !!equDbTrack()

  !form = !!appDesMain
  !gadget = !form.mtbNavigation

  !action = !gadget.selection()

  if (!action eq 'SUBE') then
    SUBE
    handle any
      EQUI
      handle any
      endhandle
    endhandle
  elseif (!action eq 'EQUI') then
    EQUI
    handle any
    endhandle
  endif

endfunction
-- End of function definition for !!equDbTrack
