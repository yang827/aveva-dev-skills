--
--  File:            equiconn.pmlfnc
--    Type:          Function Definition
--    Group:         Undefined
--    Keyword:       Undefined
--    Module:        Cabling
--  Author:          Joe Wyatt
--  Created:         Fri May 30 11:39:31 2008
--
--  Description:     Disconnects cables from the selected Equipment
--                   (EQUI) and/or Electrical Connections (ELCONN)
--
----------------------------------------------------------------------
define function !!equiconn()

  !equi = !!ce
  !disconnect = ARRAY()

  if !equi.type.eq('EQUI') then

    if !equi.elcxrf.set() then
      !confirm1 = !!alert.confirm('Disconnect all Cables directly connected to this Equipment?')
      if !confirm1.eq('YES') then
        !disconnect.append(!equi)
      endif
    endif

    -- Check to see if there are any elconns
    !findElconns = object COLLECTION()
    !findElconns.type('ELCONN')
    !findElconns.scope(!equi)
    !exp = object EXPRESSION('NOT(UNSET(ELCXRF))')
    !findElconns.filter(!exp)
    !elconns = !findElconns.results()

    -- List elconns with connected cables and ask if they should be disconnected
    if !elconns.set() then
      !message = ''
      !message = !message & 'The following Electrical Connections (ELCONNs) belonging to Equipment ' & !equi.flnm & ' have cables connected:'
      do !elconn value !elconns
        !message = !message & '
- ' & !elconn.flnn
      enddo

      if !disconnect.unset() then
        !message = !message & '

Disconnect all connected cables from these Electrical Connections?'
      else
        !message = !message & '

Also disconnect all connected cables from these Electrical Connections?'
      endif
      !confirm2 = !!alert.confirm(!message)
      if !confirm2.eq('YES') then
        !disconnect.appendArray(!elconns)
      elseif !disconnect.unset() then
        return
      endif
    endif

    -- If there are no connected cables on EQUI or associated ELCONNs return
    if !disconnect.unset() then
      !!alert.message('No Cables connected to Equipment or associated Electrical Connections (ELCONNs)')
      return
    endif


  -- If ELCONN is selected and connected cables exist ask for confirmation before continuing
  elseif !equi.type.eq('ELCONN') then
    if !equi.elcxrf.unset() then
      !!alert.message('No Cables Connected to Electrical Connection (ELCONN)')
      return
    endif

    !confirm1 = !!alert.confirm('Disconnect all Cables directly connected to this Electrical Equipment (ELCONN)?')
    if !confirm1.eq('YES') then
      !disconnect.append(!equi)
    else
      return
    endif


  -- If neither EQUI or ELCONN is selected try to navigate to EQUI before returning
  else
    EQUI
    handle ANY
      !!alert.message('Navigate to an Equipment (EQUI) or Electrical Connection (ELCONN) to disconnect')
    elsehandle NONE
      !!equiconn()
    endhandle
    !!ce = !equi
    return

  endif

  !undo = object UNDOABLE()
  !undo.description('Disconnect Equipment')
  !undo.add()
  !disconnectedCables  = ' '
  -- Disconnect cables from chosen equi/elconns
  do !item values !disconnect
    do !cable values !item.elcxrf
      !!ce = !cable
      if ( !!dbRefUpdatable(!!ce)) then
        !disconnectedCables = !disconnectedCables & !!ce.flnn & '; '
        handle ANY
        endhandle
        if !!ce.staref eq !item then
          staref unset
          feqdes unset
          cbsta 0
        elseif !!ce.endref eq !item then
          endref unset
          teqdes unset
          cbsta 0
        endif
      else
      !stringMessage  = !!error.text
      !!alert.error(!stringMessage )

      endif
    enddo
  enddo

  !!alert.message('Disconnected Cables: ' & !disconnectedCables)
  !undo.endundoable()
  !!ce = !equi

endfunction
