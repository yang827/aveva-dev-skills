--
-- Description:
-- Display and initialise equipment csv import form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!equiLoadCsv()

-- Initialise Variables
  if(not defined(!!spreadsheetImport)) then
    pml reload form !!spreadsheetImport
  endif

  if( !!spreadsheetImport.shown() ) then
    -- form already shown - warn user
    !!alert.error('The Spreadsheet import form is already displayed. Please close it before continuing.')
    return
  endif

  -- Form not shown - show form and initialise it
  show !!spreadsheetImport
  -- configure the form to process an equipment list
  !!spreadsheetImport.setDataHandler( object EQUILOADER() )
  -- Set the form title based on the application name
  !!spreadsheetImport.formTitle = !!appCntrl.currentAppObj().title + ' Data Import'
  -- start with the file open dialogue
  !!spreadsheetImport.browse()

endfunction
-- End of function definition
