--
-- Author:          M.Barlow
-- Created:         Fri Dec 18 14:41:50 "GMT 1998
--
--
-- Description:
-- Evaluates rules on all items owned by given dbref, including ASL
-- special rules
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!evaluateRules(!gid is DBREF)

-- Initialise Variables
  !refe = !!ce
  !!ce  = !gid
  !lflg = false            $* Any items locked

-- If we are at the world level, don't allow this

  if(!gid.type eq |WORL|) then
    return error 1 |Unable to EVALUATE rules from the this level.|
  endif

  -- Check we have read/write access to EVALUATE the rules.
  if( not !!dbRefUpdate(!gid ) ) then
    !!ce = !refe
    return error 1 |Unable to modify read-only data.|
  endif

  -- find all templates
  var !collTmpl COLLECT ALL TMPL FOR CE
  if(!collTmpl.size() le 0) then
    return
  endif

  do !template values !collTmpl

   !lflg = false            $* Any items locked

   !templateRef = !template.dbRef()
   !!ce = !templateRef
   -- Collect all items which are locked
   -- !coll = !!collectAllFor(||,|Lock|,!gid)
    var !coll COLLECT ALL WITH (LOCK) FOR $!template

    if(!coll.size() gt 0) then
      !lflg = true
     --!confirm = !!alert.confirm(|The item or one of its offspring is lock, OK to EVALUATE rules? This will reset the lock back after evaluation.|)
     -- if(!confirm eq 'NO') then
     --   return
     -- endif
    endif

   -- Unlock locked elements
    if(!lflg) then
      !max = !coll.size()

      do !i from 1 to !max
        !!ce = !coll[!i].dbRef()
        UNLOCK
        handle any
          -- may be a read only db
          -- relock those already unlocked
          do !relockIndex from !i to 1
            !!ce = !coll[!relockIndex].dbRef()
            LOCK
            handle any
            endhandle
          enddo
          !!ce = !refe
          return error 1 |Unable to modify read-only data.|
        endhandle
      enddo

    endif

    !!ce = !templateRef

   -- Check we have read/write access to EVALUATE the rules.
    if( not !!dbRefUpdate(!templateRef ) ) then
     -- Go backwards through the collection (first order search) and relock
     -- all the items in the list
      if(!lflg) then
        do !i from !max to 1
          !!ce = !coll[$!i].dbRef()
          LOCK
        enddo
      endif
      !!ce = !refe
      return error 1 |Unable to modify read-only data.|
    endif

   -- general repeat function (generic) (don't run it in the TPWL)
      !tmarRef = !!dtbGetOwnerType( !!ce, 'TMAR' )
      if( !tmarRef.unset() ) then
        !!genRepeat(!templateRef)
   -- run any functions not generic
        !!aslFunctionExec(!templateRef)
      endif
      !!ce = !templateRef
     -- Re-evaluate the rules
      RULE EXECUTE SPRE ON ALL FOR CE
      RULE REXE

     -- Go backwards through the collection (first order search) and relock
     -- all the items in the list
    if(!lflg) then
      do !i from !max to 1
        !!ce = !coll[$!i].dbRef()
        LOCK
      enddo
    endif

  enddo

  -- End
 !!ce = !refe


endfunction
-- End of function definition for !!evaluateRules
