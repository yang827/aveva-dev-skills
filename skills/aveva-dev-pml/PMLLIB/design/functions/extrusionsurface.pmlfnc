-- Author:          N.Holmes
-- Created:         Mon Mar 24 16:21:20 WAT 1997
--
--
-- Description:
-- Returns the extrusion/panel surface as a plane definition (vector).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Extrusion/Panel name
--    2   R      STRING      Top or Bottom Surface of extrusion
-- Return:
--   [Data Type] [Description]
--    VECTOR      Plane definition
--
------------------------------------------------------------------------

-- Define function
define function !!extrusionSurface (!extrusion is DBREF, !surface is STRING) is VECTOR

  -- Initialise Variables
  !returnVector            = object VECTOR()
  !returnVector.position   = !extrusion.pos.wrt(!extrusion)
  !returnVector.direction  = !extrusion.ori.zDir().wrt(!extrusion)

  -- Compensate for thickness of extrusion
  if(!extrusion.type eq 'EXTRU') then
    !thickness = !extrusion.height
  else

    -- Get Ploop Data
    !ploop     = (PLOOP 1 of $!extrusion )
    !thickness = !ploop.heig

    -- Justified to the TOP
    if(!ploop.sjus.match('TOP') gt 0) then

      !returnVector.position.up = !returnVector.position.up - !thickness

    -- Justified to the CENTRE
    elseif (!ploop.sjus.match('CEN') gt 0) then

      !returnVector.position.up = !returnVector.position.up - !thickness / 2

    -- Justified to the BOTTOM
    else

    endif

  endif

  -- Upper Surface
  if(!surface.upcase().subString(1,1) eq 'T') then
    !returnVector.position.up     = !returnVector.position.up + !thickness

  -- Lower Surface
  else
    !returnVector.direction.east  = !returnVector.direction.east  * -1
    !returnVector.direction.north = !returnVector.direction.north * -1
    !returnVector.direction.up    = !returnVector.direction.up    * -1
  endif

  -- Return
  return !returnVector

endfunction
-- End of function definition for !!extrusionSurface
