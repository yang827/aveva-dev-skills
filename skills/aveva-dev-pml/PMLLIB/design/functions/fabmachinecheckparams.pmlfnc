--   Module:        Design
--   Replaces:      n/a
--
-- Author:          Ognian Nikolov
-- Created:         Thu Jul 14 2011 09:55:00
--
-- Description:     Function to perform a limited check on FMBSST parameter validity
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL      Value of FMBSST Constant factor STFC
--    2    R      REAL      Value of FMBSST Proportional factor STFP
--    3    R      BOOLEAN   TRUe: allow zero for both factors, false otherwise

-- Return:
--   0 - parameters are valid
--   1 - the STFP/STFC combination is invalid
--  -1 - the STFP/STFC combination could be invalid for some bend angles

-- Used in \PMLLIB\design\forms\fabmachinedat.pmlfrm and \PMLLIB\design\forms\fabmachinemgr.pmlfrm

----------------------------------------------------------------------------------------------------

define function !!fabMachineCheckParams(!stfc is REAL, !stfp is REAL, !allowZeros is BOOLEAN) is REAL

-- return constants, do not change!
	!valid = 0
	!invalid = 1
	!potentiallyInvalid = -1
	
	if(!allowZeros AND (!stfc EQ 0) AND (!stfp EQ 0)) then
-- this is a valid case
		return !valid
	endif

-- bend angle = 0:
	!val0 = !stfc
	
-- bend angle = 180o:
	!val1 = !stfc - !stfp * 3.14159 / 2.

-- valid limits
	!valMin = 0.0000011
	!valMax = 1.0
	
	if((!val0 LT !valMin) AND (!val1 LT !valMin)) then
		return !invalid
	endif
	
	if((!val0 GT !valMax) AND (!val1 GT !valMax)) then
		return !invalid
	endif
	
	if((!val0 LT !valMin) OR (!val0 GT !valMax)) then
		return !potentiallyInvalid
	endif
	
	if((!val1 LT !valMin) OR (!val1 GT !valMax)) then
		return !potentiallyInvalid
	endif

	return !valid

endfunction
