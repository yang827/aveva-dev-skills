define function !!fabMachineNCs()

  if defined(!!productionChecksEnabled) and !!productionChecksEnabled.not() then
    -- prevent the form from being shown if production checks is disabled
    !!alert.warning('Form disabled')
    return
  endif

  if (defined(!!fabMachineNCs) and !!fabMachineNCs.shown()) then
    -- No need to show but run the initialisation
    !!fabMachineNCs.init()
  else
    show !!fabMachineNCs
  endif

endfunction
