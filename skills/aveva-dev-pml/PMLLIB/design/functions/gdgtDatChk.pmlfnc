--
--  Description:     Checks the gadgets passed as an argument for any negative data.
--
----------------------------------------------------------------------

define function !!gdgtDatChk(!gadget is GADGET)
	
	--Check if !gadget.val is set and if not return error message
	if ( !gadget.val.unset()) then
		!!alert.error('Enter a positive value!')
		!gadget.clear()
		!gadget.setvalue(0,FALSE)
	endif
	
	--Check if !gadget.val is Positive and if not return error message
	if ( !gadget.val lt 0 ) then
		!!alert.error('Enter a positive value!')
		!gadget.clear()
		!gadget.setvalue(0,FALSE)
	endif
endfunction
