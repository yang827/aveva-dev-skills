--
--
-- Description:
-- Change the Properties of the specified element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genChangeProp(!element is DBREF)

!copy = !element
!refe = !!ce

!!ce = !copy

-- Set properties
if (!!genProperty.current.size() gt 0) then

       do !count from 1 to !!genProperty.current.size()
            !value = !!genProperty.current[!count]
            DESP NUMBER $!count $!value
       enddo
-- Rexecute any rules
       if (Set(!copy.spref.tmpr) ) then
            !lock = LOCK
            UNLOCK ALL
            RULE REXECUTE
            LOCK ALL
            if (not !lock) then
                 UNLOCK
            endif
       else
            RULE REXECUTE
       endif
else
       return error 1 'No properties found'
endif


!!ce = !refe

endfunction
-- End of function definition for !!genChangeProp
