--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Mon Apr 7 15:03:37 BST 1997
--
--
-- Description:
-- Remove all rules from template members.
-- Delete all datasets etc under template
-- Include all template members into template owner
-- Delete template
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genDemolishTmpl(!element is DBREF)

-- Check has template
!refe = !!ce
!copy = !element

!message = STRING()
!template = !!findFirstMember(!copy, |TMPL|, || , !message)

!!ce = !template
handle any
     !template = TMPL
     !copy = !template.owner
     !!ce = !template
     handle any
          !!messageFile.error(155, 008)
     endhandle
endhandle

-- Ask for confirmation
!message = 'Ok to include contents of template '  & !template.flnm & ' into owner and remove all rules'
!answer = !!alert.confirm(!message)
if (!answer ne 'YES') then
     return
endif

UNLOCK ALL
!position = !copy.position
!ori = !copy.orientation
!owner = !copy.owner
-- Check we can include all members into owner

!size = !template.mCount

!members = !template.members

do !index from 1 to !size
     !type = !members[!index].type
     if (!type eq |DDSE|  or !type eq |DPSE| or !type eq |LNKS| or !type eq |PORS| ) then
          skip
     else
-- Try to move element
          !!ce = !owner
          !included = !members[!index]
          INCLUDE $!included
          handle any
    -- Cannot move one so undo what we have done
                !!ce = !template
                if (!index gt 1) then
                     !end = !index - 1
                     do !undo from 1 to !end
                         !included = !members[!undo]
                         INCLUDE $!included
                     enddo
                endif
                LOCK ALL
                !!ce = !refe
                !!messageFile.error(155, 009)
          endhandle
     endif
enddo

-- Now remove rules from elements and position elements

do !index from 1 to !size

     !type = !members[!index].type
     if (!type eq |DDSE|  or !type eq |DPSE| or !type eq |LNKS| or !type eq |PORS| ) then
          skip
     else
-- Remove rules
          !!ce = !members[!index]
          RULE DELETE ALL ON ALL FOR CE
          AT $!position
          ORI $!ori
     endif
enddo

-- Finally delete template itself

!!ce = !template
DELETE TMPL
!!ce = !copy
!type = !copy.type
DELETE $!type
-- Make sure we can still see the walls
add ce
!!ce = !refe
handle any
endhandle

endfunction
-- End of function definition for !!genDemolishTmpl
