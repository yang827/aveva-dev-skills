--    Group:         Common
--    Keyword:       FileName
--    Module:        Design
--  Author:          Simon Bailey
--  Created:         28/09/2010 16:16:07
--
--  Description:     Converts a string into a valid filename by replacing
--                   illegal characters with underscores
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     String to convert
--
-- Return:
--   [Data Type] [Description]
--   STRING      A valid  filename
--
------------------------------------------------------------------------

define function !!generateFileName(!baseName is STRING) is STRING

  !fileName = !baseName

  -- Array of characters that cannot be used in a filename
  !characters = '\ / : * ? " < > |'
  !characterArray = !characters.split()

  -- Replace each character in turn
  do !character values !characterArray
    !fileName = !fileName.replace(!character, '_')
  enddo
  return !fileName

endfunction
