--
--
-- Description:
-- function to get the components of a spec when more than one level of spcos
-- are in the spec. (example RAIL and its fittings)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genGetLevel(!form is FORM) is ARRAY

!specElements = ARRAY()

 -- we are at the top level and only need the main component
    !specElements[1] = !!getSpecSelection(!form.specData)
    !specElements[2] = object DBREF()
    !comment = !specElements[1].comm
     handle any
     -- if its a sele selected do nothing and return null array
      !specElements = ARRAY()
      return !specElements
      return
    endhandle
   if(!comment.eq('')  ) then
   -- do nothing (assumption MAIN)
   elseif(!comment.neq('MAIN')  ) then
 -- its a sub tmpl below the MAIN (ie FITT)
    !specElements[2] = !!getSpecSelection(!form.specData)
 -- *** OLD STYLE PML ***
    var !element (REFE OF SPCO 1 OF OWNER OF OWNER OF $!specElements[2] )
    !specElements[1] = !element.dbRef()

   endif


 return !specElements

endfunction
-- End of function definition for !!genGetLevel
