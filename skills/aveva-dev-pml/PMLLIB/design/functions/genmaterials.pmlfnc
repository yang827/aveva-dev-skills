-- Created:         Tue Feb 11 15:42:57 GMT 1997
--
--
-- Description:
-- Find all the materials available from properties database.
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--    1   RW     ARRAY of DBREF  SOLID name holding data
--    2   RW     ARRAY of REAL   Densities
--    3   RW     ARRAY of STRING Descriptions
-- Return:
--   [Data Type] [Description]
--    Boolean        Status
------------------------------------------------------------------------

-- Define function
define function !!genMaterials(!soli is ARRAY, !dens is ARRAY, !desc is ARRAY) is BOOLEAN

!with = |SREF of OWNER eq 'STD' and TEMP lt 0Kelvin|
!sden = !!collectAllFor(|SDEN|,!with, WORLD )

if (Set(!sden) and Defined(!sden) ) then

     !soliFromSden = object BLOCK('!sden[!evalIndex].owner.owner')
     !soli = !sden.evaluate(!soliFromSden)

     !densFromSden = object BLOCK('!sden[!evalIndex].dens')
     !dens = !sden.evaluate(!densFromSden)

     !descFromSoli = object BLOCK('!soli[!evalIndex].desc')
     !desc = !soli.evaluate(!descFromSoli)

     return true

else

     return false

endif


endfunction
-- End of function definition for !!genMaterials
