--
--
-- Description:
--    Instigates primitive create and modification form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Action   = CREATE or MODIFY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genPrimitives(!action is STRING)

  -- Initialise Variables

  -- Check form exists
  if(undefined(!!genPrimitives)) then
    PML RELOAD FORM !!genPrimitives
  endif

  -- Create Primitive
  if( !action.upcase() eq 'CREATE' ) then
    hide !!genPrimitives
    show !!genPrimitives
  elseif( !action.upcase() eq 'MODIFY' ) then
    show !!genPrimitives
    !!genPrimitives.edit(!!ce)
  endif

endfunction
-- End of function definition
