--
-- Description:
-- Load property form with information from current element
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genPropertyCe()

-- Set all values of gadgets to values of current element

!sizeData = !!genProperty.default.size()
-- Extract design parameters from element
!desp = !!ce.desPara
handle any
endhandle
!sizeCE = !desp.size()

if (!sizeData gt 0) then
        do !index from 1 to !sizeData
               !gadget = '!!genProperty.dv' & !index
               if (!index gt !sizeCE) then
       -- Existing design parameters incomplete
                    !!editGadget(!gadget, |0| )
                    !desp[!index] = 0
               else
                    !!editGadget(!gadget, !desp[!index].string() )
               endif
        enddo

        !!genProperty.current = !desp

endif

endfunction
-- End of function definition for !!genPropertyCe
