--
-- Description:
-- Load property form with information from default values
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genPropertyDflt()

-- Set all values of gadgets to default values

!size = !!genProperty.default.size()

if (!size gt 0) then

        do !index from 1 to !size
               !gadget = '!!genProperty.dv' & !index
               !!editGadget(!gadget, !!genProperty.default[!index].string() )
        enddo

        !!genProperty.current = !!genProperty.default

endif

endfunction
-- End of function definition for !!genPropertyDflt
