--
--
-- Description:
-- Check whether value given is within maxmin limits
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genPropertyMaxm(!desp is REAL) is BOOLEAN

!max = !!genProperty.maxMin[!desp][1]
!min = !!genProperty.maxMin[!desp][2]
!value = !!genProperty.dv$!desp$n.val.real()
 if(!value.between(!min,!max)) then
  !return = TRUE
 else
  !return = FALSE
 endif


return !return


endfunction
-- End of function definition for !!genPropertyMaxm
