--
--
-- Description:
-- Save property value against .current member of form
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Gadget Number in Form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!genPropertySet(!number is REAL)

!gadget = '!!genProperty.dv' & !number

!value = $!<gadget>.val.real()

if (!!genProperty.current[!number].objectType() eq 'REAL' ) then

     !!genProperty.current[!number] = $!<gadget>.val
else
     !!genProperty.current[!number] = $!<gadget>.val.string()
endif

if(defined(!!genProperty.maxMin[!number]) and !!genProperty.maxMin[!number].set()) then
   if(!!genPropertyMaxm(!number).not()) then
      !error = 'Value ' & !value & ' is not between the range of '$
                 & !!genProperty.maxMin[!number][2] & ' and ' & $
                 !!genProperty.maxMin[!number][1]
      return error 1 |$!error|
   endif
endif

endfunction
-- End of function definition for !!genPropertySet
