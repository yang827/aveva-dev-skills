--
-- File:            genpropertyshow.pmlfnc
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        design
--   Replaces:      FSETPROP
--
-- Author:          S.Hudson,,,
-- Created:         Tue Mar 4 16:02:18 GMT 1997
--
--
-- Description:
-- Build form for displaying property values
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      dbref           Prompt for information for this SPCO
--    2   R      String          Mode (NEW, MODIFY or QUERY)
--    3   R      String          Title for form
--    4   R      Function        Apply Function
--    5   R      Function        Dismiss Function
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

define function !!genPropertyShow(!spre is DBREF, !mode is STRING, !title is STRING, !apply is STRING, !dismiss is STRING)

-- Initialise variables
!message = STRING()
!template = BOOLEAN()
!cata[1] = object DBREF()
!desp[1] = object DBREF()
!data[1] = object DBREF()
!attr[1] = object DBREF()
!plot[1] = object DBREF()
-- Get information from dataset

if (not !!findDataSet(!spre, !message, !template, !cata, !desp, !data, !attr, !plot ) ) then

      !!genProperty.current.clear()
      handle any
      endhandle
      if (!apply.length() gt 0) then
          $!apply
           return
      else
           return error 1 $!message
      endif

endif

-- Check if there is anything to prompt for

if ( (!mode.upcase() eq |NEW| or !mode.upcase() eq |MODIFY| ) and !desp.size() le 0) then

     !!genProperty.current.clear()
     handle any
     endhandle
     if (!apply.length() gt 0) then
          $!apply
           return
      else
           return error 1 $!message
      endif

endif


-- Kill existing form definition
kill !!genProperty

-- Define form
setup form !!genProperty

  !!genProperty.formTitle     = !title
  !!genProperty.iconTitle     = |PROPERTIES|
-- define initialisation depending on mode
  if (!mode.upcase() eq |NEW|) then
        !!genProperty.callback      = | call !!genPropertyDflt() |
  else
        !!genProperty.callback      = | call !!genPropertyCe() |
  endif

  !!genProperty.formRevision  = | $Revision: 1.23 $ |

 -- Members

  member .current is ARRAY
  member .default is ARRAY
  member .maxMin is ARRAY
  member .specComp is DBREF

  !!genProperty.specComp = !spre

  -- Body of form definition

-- Catalogue Properties

if (!cata.size() le 0) then

     para _ctxt at xmin ymax text |No Catalogue Properties|

else

     frame _ctxt at xmin ymax |Catalogue Properties:|

     do !index from 1 to !cata.size()
-- Display values
           if (!template) then
                 !expression = !cata[!index].ddpr
           else
                 !expression = !cata[!index].ppro
           endif
           !result1 = $!expression
           handle any
                !value = |$!expression|
                handle any
                     !value = |0|
                endhandle
           elsehandle none
                !value = !result1.string()
           endhandle
           !text = !cata[!index].dTitle
           !length = !text.length()
           do !count from !length to 16
                 !text = !text & ' '
           enddo
           para _cT$!index at xmin_ctxt+1 ymax text |$!text|
           para _cV$!index at xmax+1 ymin text |$!value|
     enddo

     exit

endif
 -- Information

if (!data.size() le 0) then

     para _etxt at xmin ymax text |No Other Information|

else

    -- frame _etxt at xmin ymax |Reference|
     para _etxt at xmin ymax text |Reference:|

     do !index indices  !data
-- Display values
           if (!template) then
                !expression = !data[!index].ddpr
           else
                 !expression = !data[!index].ppro
           endif
           !result2 = $!expression
           handle any
                !value = |$!expression|
                handle any
                     !value = |0|
                endhandle
           elsehandle none
                !value = !result2.string()
           endhandle
           !text = !data[!index].dTitle
           !length = !text.length()
           do !count from !length to 16
                 !text = !text & ' '
           enddo
           para _eT$!index at xmin_etxt+1 ymax text |$!text|
           para _eV$!index at xmax+1 ymin text |$!value|
     enddo

     --exit

endif
-- Design Parameters
!!genProperty.default.clear()
!!genProperty.maxMin.clear()

if (!desp.size() le 0) then

     para _dtxt at xmin.etxt ymax text |No Design Parameters|

else

--     frame _dtxt at xmin ymax |Design Parameters|
     para _dtxt at xmin.etxt ymax text |Design Parameters:|

     do !index from 1 to !desp.size()
-- Display values
           !text = !desp[!index].dTitle
          !length = !text.length()
           do !count from !length to 16
                 !text = !text & ' '
           enddo
           para _dT$!index at xmin_dtxt+1 ymax text |$!text|

           if (!mode.upcase() eq |QUERY| ) then
      -- We can't change design parameters
                 if (!template) then
                      !expression = !desp[!index].ddprop
                 else
                       !expression = !desp[!index].pprop
                 endif
                 !result3 = $!expression
                 handle any
                       !value = |$!expression|
                       handle any
                            !value = |0|
                       endhandle
                 elsehandle none
                      !value = !result3.string()
                 endhandle
                 para _dV$!index at xmax ymin text |$!value|
           else
      -- We want to change design parameters
                if (!desp[!index].pType eq 'ANG' or !desp[!index].pType eq 'TAPER') then
                     text _dV$!index at xmax+1 ymin call |!!genPropertySet($!index)| width 10 is REAL
                elseif (!desp[!index].pType eq 'BORE' ) then
                     text _dV$!index at xmax+1 ymin call |!!genPropertySet($!index)| width 10 is REAL Format !!boreFmt
                else
                   text _dV$!index at xmax+1 ymin call |!!genPropertySet($!index)| width 10 is REAL Format !!distanceFmt
                endif
           endif
      -- Save default value
          if (!template) then
               !expression = !desp[!index].dddf
               !result4 = $!expression
               handle any
                     !value = |$!expression|
                     handle any
                          !value = |0|
                     endhandle
               elsehandle none
                     !value = !result4.string()
               endhandle

               !maxEx = !desp[!index].maxMin
               !!genProperty.maxMin[!index] = !maxEx
          else
               !expression = !desp[!index].dprop
               !result4 = $!expression
               handle any
                     !value = |$!expression|
                     handle any
                          !value = |0|
                     endhandle
               elsehandle none
                     !value = !result4.string()
               endhandle
          endif
          !!genProperty.default[!index] = !value

     enddo

endif

-- Plotfile

 if(!plot.size() gt 0) then

   -- Plotfile name
    if(!template) then
     !plotfile =  !plot[1].ddpr
     !plotDir  =  !plot[1].dddf
    else
     !plotfile =  !plot[1].ppro
     !plotDir  =  !plot[1].dpro
    endif


      !plotfile = !plotfile.trim(|R|,|)|).trim(|L|,|(|)
--var !plotf (trim(trim(trim(vtext(!plotf),'L',|(|),|R|,|)|)))
      var !plotf $!plotfile

   -- Plotfile directory

      !plotDir = !plotDir.trim(|R|,|)|).trim(|L|,|(|)

-- make pure string (messy) - to sort out
   var  !plotd $!plotDir
   -- Check that there is a plotfile
    var !plotf FILE "%PDMSPLOTS%/$!plotd/$!plotf" FULLNAME
    handle any
    elsehandle none

    !max = 0

     -- Portrait or landscape
      !ptyp = !plot[1].ptyp
      if(!ptyp eq |LPLT|) then
        !max  = MIN(!max,16)
        !max  = MAX(!max,12)
        !size = |height | & !max & | aspec  1.414|
      else
        !max  = MIN(!max,20)
        !max  = MAX(!max,16)
        !size = |height | & !max & | aspec 0.707|
      endif

     -- Define plotview
      view _plot at xmax form+1 ymin_ctxt plot
        $!size
        borders on
        cursor crosshair
        add /$!plotf
      exit
    endhandle
  endif



-- If we are changing properties add buttons for modification

if (!mode.upcase() eq |NEW| or !mode.upcase() eq |MODIFY| ) then
     button _ok  |Apply| at x 1 ymax+1
     if (!apply.length() gt 0) then
               _ok.callback = !apply
     endif
     button _def |Default| at xmax+4 ymin call |!!genPropertyDflt()|
     button _reset |Reset| at xmax+4 ymin reset
endif

-- If a dismiss function has been supplied add it to cancel button
button _cancel |Dismiss| at xmax+4 ymin cancel

exit

if (!dismiss.length() gt 0) then
     !!genProperty.cancelCall = !dismiss
endif

-- End of form definition for !!genProperty

-- Show Form

!!genProperty.show()

endfunction
-- End of function definition for !!genPropertyShow
