--
--
-- Description:
-- function to pick nearest fixing on a wall or gensec.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--   [1] [R]    [Data from EDG pick]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!genSelectPline(!data is ANY) is DBREF


  -- initialise variables

  !pLineSelected = !data.pLine

  -- set the gadget on the old form


 var list _cdFitSpec_JUST SEL REPL |$!pLineSelected| exit
 handle any
   var list _cdFitSpec_JUST SEL REPL |NA| exit
   handle any
   endhandle
 endhandle

 $m "%PDMSUI%/DES/STLWRK/IFITSPECD"

  !!edgCntrl.remove('Pline Pick')


endfunction
-- End of function definition for !!genSelectPline
