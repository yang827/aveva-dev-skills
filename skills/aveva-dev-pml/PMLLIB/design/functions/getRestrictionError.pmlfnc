--
--
-- Description:
-- Sets the Error string returned from the restriction objects.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--      1   R     DBREF        if valid ref, use to pass to cache object
--      2   R     DBREF        if !restriction not set, use this to directly access error at specified index
-- Return:
--   [Data Type] [Description]
--   STRING        Error string generated by specified restriction
------------------------------------------------------------------------

-- Define function
define function !!getRestrictionError(!restriction is DBREF, !restrictionNumber is REAL) is STRING
  !retstr = object STRING()
  !retstr = ''
  if (undefined(!!restrictionErrors)) then
    return !retstr
  endif
  if (badref(!restriction)) then
    !retstr = !!restrictionErrors.getErr(!restrictionNumber)
  else
    !retstr = !!restrictionErrors.getErr(!restriction)
  endif
  return !retstr

endfunction
-- End of function definition for !!setRestrictionError
