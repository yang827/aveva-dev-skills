--
--  Description:     Gets the available spec components for a specification component type and bore
--
----------------------------------------------------------------------
define function !!getSpecComponents(!spec is STRING, !type is STRING, !bore is STRING) is ARRAY

  !questions = object ARRAY()
  !answers = object ARRAY()

  !boreReal = $!bore
  !boreObject = object BORE(!boreReal)
  handle ANY
    !boreObject = object BORE($!bore)
  endhandle
  !specifications = object SPECIFICATION(!spec.dbref())
  !specifications.allowTubes = TRUE
  !specifications.loadComponents()
  !specifications.loadBores()
  !specifications.loadTable(!type)
  !specifications.subTypes(!type, 1, !boreObject)

  !questions.append('PBOR1')
  !answers.append(!boreObject)

  !components = !specifications.components(!type, !questions, !answers)

  return !components

endmethod
