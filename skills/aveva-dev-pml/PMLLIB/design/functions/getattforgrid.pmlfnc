--
--
--
-- Description:
--    Initialise the cabling forms
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY       ARRAY of elements with attributes. First ARRAY
--                          element should be the type of element and second
--                          should be the collection scope

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!getattforgrid(!input is ARRAY) is ARRAY

 !collect = object COLLECTION()
 !collect.type(!input[1])
 !collect.scope(!input[2])
 !elements = !collect.results()

  -- create array for data
 !items = object ARRAY()

  --get data into array
 do !i from 1 to !elements.size()
  !data = object ARRAY()
  do !j from 3 to !input.size()
   !att[!j] = !elements[!i].$!<input[$!j]>
   if !att[!j].objecttype().eq('DBREF') then
   	!dbatt[!j] =	!elements[!i].$!<input[$!j]>.namn
   	!data.append(!dbatt[!j])
   elseif !att[!j].objecttype().eq('POSITION') then
   	!posatt[!j] = !elements[!i].$!<input[$!j]>.string()
   	!data.append(!posatt[!j])
   elseif !att[!j].objecttype().eq('DIRECTION') then
   	!diratt[!j] = !elements[!i].$!<input[$!j]>.string()
   	!data.append(!diratt[!j])
   else
    !data.append(!att[!j])
   endif
  enddo
  !items.append(!data)
 enddo

 return !items


endfunction
