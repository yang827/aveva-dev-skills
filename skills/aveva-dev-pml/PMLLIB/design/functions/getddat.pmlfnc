--
-- File:            getddat.pmlfnc
--   Type:          Function Definition
--   Group:         Structural
--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Tue Sep 30 10:41:57 BST 1997
--
--
-- Description:
-- List of all data set elements for passed template.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--         1 - Template/DDSE Name/SPCO name
-- Global Arguments:
-- Returns:
-- Standard Return Status Variables:
--         !!cdRtnStatus:
--                    0  = Successful call
--                    1  = Fatal error
--                    -1 = Warning
--         !!cdRtnText: Status text when !!cdRtnStatus =1,-1
--         !!cdpnRtn - Dataset element (DDSE) (below TMPL)
--         !!cdcnRtn - Dataset element below item (not below a TMPL)
--         !!cdpaRtn - Data element of DDSE (DDAT)
--
--
------------------------------------------------------------------------

$:debug$:
$d1=CE

-- initialise status vars
 var !!cdRtnStatus (0)
 var !!cdRtnText   ||

-- Initialise Variables
 var !gid  |$1|
 var !!cdpnRtn DELETE
 var !!cdcnRtn DELETE
 var !!cdpaRtn DELETE
 var !ncnt     0

-- See if we are at a DDSE or below one
 var !ddse[1] (DDSE OF $!gid )
 handle any

  -- If the <gid> passed is to a SPCO, then we need to see
  -- if we can get the DDSE of the TMPR of the item
   var !ddse[1] (DDSE1 OF TMPR OF $!gid )
   handle any

    -- if we are at a TMAR, then don't continue
     if(TYPE of $!gid eq |TMAR|) then
       var !!cdRtnStatus (1)
       var !!cdRtnText   |No dataset found.|
       return
     endif

    -- If we are at a TMPL, then see if there is a DDSE beneath
     if(TYPE of $!gid eq |TMPL|) then
       var !ddse[1] (DDSE 1 OF $!gid )
       handle any
         var !!cdRtnStatus (1)
         var !!cdRtnText   |No dataset found.|
         return
       endhandle

    -- See if item itself has a TMPL and/or a DDSE
     else

      -- Get the first DDSE of the item template item
       var !ddse[2] (DDSE 1 OF $!gid )
       handle any
       endhandle

      -- Get TMPL of item
       var !ddse[1] (DDSE 1 OF TMPL 1 OF $!gid )
       handle any
       endhandle

     endif
   endhandle
 endhandle

-- No Data set found
 if(undefined(!ddse)) then
   var !!cdRtnStatus (1)
   var !!cdRtnText   |No dataset found.|
   return
 endif

-- Loop through DDSE and get all DDAT
 do !i indices !ddse
   var !ddat APPEND COLLECT MEMB OF $!ddse[$!i]
 enddo

-- No Data element
 if(arraySize(!ddat) eq 0) then
   var !!cdRtnStatus (-1)
   var !!cdRtnText   |Dataset contains no members.|

-- Get DATA element of DDSE
 else
   var !list[1] |!!cdpnRtn|
   var !list[2] |!!cdcnRtn|
   var !ncnt 0
   do !i indices !ddse
     var !ncnt $!ncnt + 1
     var $!list[$!ncnt] |$!ddse[$!i]|
   enddo
   var !!cdpaRtn EVALUATE (VTEXT(!ddat,VVAL(!en))) INDICES !ddat COUNT !en
 endif
 var !!cdpnRtn |$!ddse[1]|

--q var !!cdpnRtn !!cdcnRtn !!cdpaRtn

return $* >>>>>>>>>> End of Code getddat.pmlfnc <<<<<<<<<<
