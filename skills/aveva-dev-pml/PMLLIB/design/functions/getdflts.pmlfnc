--
--
-- Description:
-- Get spec dflts from current selected spco from ASL form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Selected spre in the ASL form]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!getDflts(!spre is DBREF) is SPECDFLTS

  !defaults = object SPECDFLTS()
  !owner     = !spre.owner
  !criterion = !!collectAllFor(|SPCO|, |owner of owner eq $!owner|, !owner)

  !extractQuest = object BLOCK('!criterion[!evalIndex].tans')
  !questions    = !criterion.evaluate(!extractQuest)
  !extractAnswer = object BLOCK('!criterion[!evalIndex].answ')
  !answers      = !criterion.evaluate(!extractAnswer)

  !defaults.crit = !criterion
  !defaults.ques = !questions
  !defaults.answ = !answers

return !defaults

endfunction
-- End of function definition for !!getDflts
