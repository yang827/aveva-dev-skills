--
--
-- Description:
-- Returns a LINK object of the passed link element, using the passed
-- LINK object as a mask. Any unset member of the object is NOT set.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Link item, link object is to be extracted from
--    2   R      LINK        Link object used as mask
-- Return:
--   [Data Type] [Description]
--    LINK       Contains link element data
--
------------------------------------------------------------------------

-- Define function
define function !!getLinkMask (!item is DBREF, !mask is LINK) is LINK

  -- Initialise Variables
  !link             = object LINK()
  if(!mask.description.set()) then
    !link.description = !item.desc
  endif
  if(!mask.function.set()) then
    !link.function    = !item.func
  endif
  if(!mask.purpose.set()) then
    !link.purpose     = !item.purp
  endif
  if(!mask.number.set()) then
    !link.number      = !item.numb
  endif
  if(!mask.tpoNumber.set()) then
    !link.tpoNumber   = !item.tpoN
  endif
  if(!mask.fpoNumber.set()) then
    !link.fpoNumber   = !item.fpoN
  endif
  if(!mask.mflg.set()) then
    !link.mflg        = !item.mflg
  endif
----------------------------------------------------
--- ( removed until the works for Unset objects) ---
--  if(!mask.laxes.set()) then
--    !link.laxes       = !item.laxes
--  endif
----------------------------------------------------
  if(!mask.gType.set()) then
    !link.gType       = !item.gtyp
  endif
  if(!mask.dKey.set()) then
    !link.dKey        = !item.dKey
  endif

  return !link

endfunction
-- End of function definition for !!getLinkMask
