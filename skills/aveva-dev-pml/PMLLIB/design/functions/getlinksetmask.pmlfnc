--
--
-- Description:
-- Returns a LINKSET object of the passed linkset element, using the passed
-- LINKSET object as a mask. Any unset member of the object is NOT set.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Linkset item, linkset object is to be extracted from
--    2   R      LINKSET     Linkset object used as mask
-- Return:
--   [Data Type] [Description]
--    LINKSET     Contains linkset element data
--
------------------------------------------------------------------------

-- Define function
define function !!getLinkSetMask (!item is DBREF, !mask is LINKSET) is LINKSET

  -- Initialise Variables
  !linkSet             = object LINKSET()
  if(!mask.description.set()) then
    !linkSet.description = !item.desc
  endif
  if(!mask.function.set()) then
    !linkSet.function    = !item.func
  endif
  if(!mask.purpose.set()) then
    !linkSet.purpose     = !item.purp
  endif
  if(!mask.number.set()) then
    !linkSet.number      = !item.numb
  endif

  return !linkSet

endfunction
-- End of function definition for !!getLinkSetMask
