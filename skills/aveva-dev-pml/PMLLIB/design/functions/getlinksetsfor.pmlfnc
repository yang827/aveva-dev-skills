--
--
-- Description:
-- Returns all the items that are linked to the passed item which have
-- the attributes supplied within the passed Link Object Mask.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to be scanned
--    2   R      LINKSET     Link Set object containing attribute mask
-- Return:
--   [Data Type] [Description]
--   ARRAY        Items linked to passed item
--
------------------------------------------------------------------------

-- Define function
define function !!getLinkSetsFor (!item is DBREF, !linkSetMask is LINKSET) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Collect all Links for Item
  !linkSets    = !!collectAllFor('LNKS','',!item)

  -- Loop through all
  do !i indices !linkSets

    -- Only Save links that are the same as the passed mask
    if(!!getLinkSetMask(!linkSets[!i],!linkSetMask) eq !linkSetMask) then
      !returnArray.append(!linkSets[!i])
    endif
  enddo

  -- Return Link
  return !returnArray

endfunction
-- End of function definition for !!getLinkSetsFor
