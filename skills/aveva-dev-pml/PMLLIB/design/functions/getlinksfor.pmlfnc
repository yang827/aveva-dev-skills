--
--
-- Description:
-- Returns all the items that are linked to the passed item which have
-- the attributes supplied within the passed Link Object Mask.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to be scanned
--    2   R      LINK        Link object containing attribute mask
-- Return:
--   [Data Type] [Description]
--   ARRAY        Items linked to passed item
--
------------------------------------------------------------------------

-- Define function
define function !!getLinksFor (!item is DBREF, !linkMask is LINK) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Collect all Links for Item
  !links       = !!collectAllFor('LNKI','LREF ne Nulref',!item)

  -- Loop through all
  do !i indices !links

    -- Only Save links that are the same as the passed mask
    if(!!getLinkMask(!links[!i],!linkMask) eq !linkMask) then
      !returnArray.append(!links[!i])
    endif
  enddo

  -- Return Link
  return !returnArray

endfunction
-- End of function definition for !!getLinksFor
