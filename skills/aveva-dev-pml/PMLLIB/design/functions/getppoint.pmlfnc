--
--
-- Description:
-- PML Function to collect a ppoint with a given purpose.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!getppoint (!forThisElement is DBREF, !purpose is STRING) is REAL

  -- Initialise variables
  !return = object REAL()
  !return = 0

  -- Remember element
  !memory = !!ce

  -- For catalogue elements
  !!ce = !forThisElement.ptref
  handle ANY
    -- Try for a template based component
    !!ce = !forThisElement.tmpref
    handle ANY
    elsehandle NONE
      var !collect collect all (DPCA DPSP DPCY) with (PURP eq '$!purpose') for ce
      do !i indices !collect
        !return = !collect[!i].dbref().number
        break
      enddo
    endhandle
  elsehandle NONE
    var !collect collect all (PTAX PTMI PTCA) with (PURP eq '$!purpose') for ce
    do !i indices !collect
      !return = !collect[!i].dbref().number
      break
    enddo
  endhandle

  -- Navigate back to original element
  !!ce = !memory

  -- Return the ppoint number
  return !return

endfunction
-- End of function definition for !!getppoint
