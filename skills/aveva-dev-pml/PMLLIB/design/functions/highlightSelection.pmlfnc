--
--  Description:     highlight selected elements
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!highlightSelection()
  -- get highlight colour
  !colour = !!gphcolopt.highlight()

  -- unenhance all
  unenhance all

  !selection = object SELECTION()
  !selection.getCurrent()

  -- get selected element
  !members = !selection.getSelection()
  if (!members.unset()) then
    return
  endif

  -- highlight selected element
  do !element values !members
    ENHANCE $!<element> COLOUR $!<colour.code>
    handle any
    endhandle
  enddo

endfunction
