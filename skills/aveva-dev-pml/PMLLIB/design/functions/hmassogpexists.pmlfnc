--
--
-- Description:
-- function to test for existence of an association group suitable for holes
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--   BOOLEAN     True if valid ASSOGP exists
------------------------------------------------------------------------

-- Define function
define function !!hmassogpexists() is BOOLEAN
  !assogpList = object COLLECTION()
  !assogpList.addtype(|ASSOGP|)
  !assogpList.filter(object EXPRESSION(|PURP eq 'HOLE' and dbwrite|))
  !elemList = !assogpList.results()

-- If no existing and writeable ASSOGP item was found use the hmconrol object method to attempt to
-- create one (requires an ASSOWL to be present)
  if ( undefined(!elemList[1]) ) then
  	!control = object HMCONTROL()
  	!created = !control.createOwningHierarchy()	
    return !created
  endif
  return TRUE
endfunction
-- End of function definition for !!hmassogpexists
