-- File:            hmcheckexistinghole.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--
--     Keyword:     GENERAL
--   Module:        design
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         March 2008
--
--
-- Description:
--    Checks if a virtual hole exists in the current location
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Clashing element
--    2   R      Position    Clash Position
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
------------------------------------------------------------------------

define function !!hmCheckExistingHole(!element is DBREF, !panel is DBREF, !position is POSITION) is BOOLEAN

  -- First find if the current element contains any ATTA, FITT or DPCA elements
  !find = object COLLECTION()
  if (!element.type eq 'BRAN') then
    !find.type('ATTA')
    !find.filter(object EXPRESSION('attype eq |PENI|'))
  elseif (!element.type eq 'SCTN') then
    !find.type('FITT')
    !find.filter(object EXPRESSION('gtyp eq |PENI|'))
  elseif (!element.type eq 'GENSEC') then
    !find.type('FIXING')
    !find.filter(object EXPRESSION('gtyp eq |PENI|'))
    !oldCe = !!ce
    !!ce = !element
    !penPos = !position.wrt( world )
    VAR !seg ID SEGMENT PPLINE CGEO THROUGH  $!penPos VIA PLINE BOUND
    handle any
      VAR !seg ID SEGMENT PPLINE NA THROUGH  $!penPos VIA PLINE BOUND
      handle any
        VAR !seg ID SEGMENT PPLINE any THROUGH  $!penPos VIA PLINE BOUND
        handle any
          -- not much we can do here
          return FALSE
        endhandle
      endhandle
    endhandle
    !!seg = !seg
    !!ce = !oldCe
 	
  elseif (!element.type eq 'EQUI' or !element.type eq 'SUBE' or !element.type eq 'TMPL') then
   !find.type('DPCA')
   !find.filter(object EXPRESSION('purp eq |HOLE|'))
  elseif (!element.type eq 'CWBRAN' or !element.type eq 'CWAY') then
   !find.type('RNODE')
   !find.filter(object EXPRESSION('rntype eq |PENE|'))
   -- Also find the RPATH
   !findRPath = object COLLECTION()
   !findRPath.type('RPATH')
   !findRPath.scope(!element)
   !rPath = !findRPath.results()[1]
   -- If the item is a CWBRAN then we need to normalise the clash position onto the RPATH
   !path = object COMPATH(!rPath)
   !position = !path.near(!position)
  endif
  !find.scope(!element)
  !attachments = !find.results()
  if (!attachments.size() eq 0) then
    return FALSE
  endif

 -- find out if any of the attachments have an association and if so is its location the same
 -- as the supplied clash position
 do !item values !attachments
   !assoc = !item.assos
   !holeAssociation = object DBREF()
   do !association values !assoc
     -- avoid MDS and other associations
     skip if( !association.type neq 'ASSOC' )
     skip if( !association.owner.purpose neq 'HOLE' )
     !holeAssociation = !association
     break
   enddo
   skip if (badref(!holeAssociation) )
   if (!position.near(!item.pos.wrt(worl), 5mm )) then
     return TRUE
   endif
   -- Are the clashing items the same and
   -- does the clash position lie within the profile of the virtual hole.
   !hole = object HMHOLE(!holeAssociation)
   if (!hole.holeOwner eq !panel) then
     !virtualHole = !hole.virtualHole
     if (!hole.fixiType.upcase() eq 'FREE') then
   	   !find = object COLLECTION()
   	   !find.type('LOOP')
   	   !find.scope(!virtualHole)
       !freeProfile = !find.results()
       !fixingProfile = object PROFILE(!freeProfile[1])
     else
       !fixingProfile = !!hmFindHoleProfile(!virtualHole)
     endif
     if (!fixingProfile.isWithin(!position)) then
       return TRUE
     endif
     if (!fixingProfile.onProfile(!position)) then
     	  return TRUE
     endif
   endif
 enddo

 return FALSE

endfunction
-- End of function definition
