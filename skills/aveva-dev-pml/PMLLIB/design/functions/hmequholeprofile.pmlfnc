--
--
-- Description:
--    Instigates equipment penetration hole identification form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element in equipment to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!hmEquHoleProfile(!element is DBREF)

  -- Check form exists
  if(undefined(!!hmEquHoleProfile)) then
    pml reload form !!hmEquHoleProfile
  endif

  -- Create Primitive
  show !!hmEquHoleProfile
  !!hmEquHoleProfile.initialise(!element)

endfunction
-- End of function definition
