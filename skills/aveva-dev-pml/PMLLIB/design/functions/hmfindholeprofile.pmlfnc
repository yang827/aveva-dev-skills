--   Replaces:
--
-- Author:          Martin Ward
-- Created:         March 2008
--
--
-- Description:
--    Gets a hole profile from a given catalogue instance
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element referencing catalogue with hole definition
-- Return:
--   [Data Type] [Description]
--   PROFILE      Profile definition or unset profile if error
------------------------------------------------------------------------

define function !!hmFindHoleProfile(!element is DBREF) is PROFILE

  !result = object PROFILE()
  if (badref(!element)) then
    return object PROFILE()
  endif

  -- try to find a catalogue element with a profile
  !searchIn = ARRAY()
  !geometry = !element.catref.gmref
  handle any
  elsehandle none
    !searchIn.append(!geometry)
  endhandle
  !negGeometry = !element.catref.ngmref
  handle any
  elsehandle none
    !searchIn.append(!negGeometry)
  endhandle

  if( !searchIn.empty().not() ) then
    -- Find the first SLOO with PURP eq HPGE and use that as the virtual hole profile
    !find = object COLLECTION()
    !find.type('SLOO')
    !find.scope(!searchIn)
    !find.filter(object EXPRESSION('PURP eq |HPGE|'))
    !sLoop = !find.results()

    if (!sLoop.empty().not() ) then
      -- get profile from catalogue loop
      !result = object PROFILE(!sLoop[1], !element)
      handle ANY
        return object PROFILE()
      endhandle
      return !result.mergePoints().mergeLines()
    else
      -- try for first loop
--      !result = object PROFILE(!geometry.member[1].member[1],!element)
--      handle any
        return object PROFILE()
--      endhandle
--      return !result
    endif

  endif

  -- Catalogue profile not found - try for Template profile
  -- Ensure this element contains an extrusion referenced by a PORT with PURP = HOLE
  !finder = object COLLECTION()
  !finder.addtype(|PORI|)
  !finder.addScope(!element)
  !finder.filter(object EXPRESSION(|PURP of OWNER inset('HOLE','HPGE') and not badref(tarf)|))
  !holeExtrusion = !finder.results()
  if (!holeExtrusion.empty() ) then
    -- Fix for P-26137 Free holes do not have a PORI element so see if we can find the extrusion directly
    !finder = object COLLECTION()
    !finder.type(|EXTR|)
    !finder.addScope(!element)
    !holeExtrusion = !finder.results()
    !holeElement = !holeExtrusion[1]
    !profileElement = LOOP 1 OF $!<holeElement>
    handle any
      return object PROFILE()
    elsehandle NONE
      !result = object PROFILE(!profileElement)
    endhandle

  else

    -- found potential hole profile
    !holeElement = !holeExtrusion[1].tarf
    if( !holeElement.hardType inset('EXTR', 'NXTR') ) then
      !profileElement = LOOP 1 OF $!<holeElement>
      handle any
        return object PROFILE()
      endhandle
      -- Get the profile of the HOLE extrusion
      !result = object PROFILE(!profileElement)
      handle ANY
        return object PROFILE()
      endhandle
      return !result.mergePoints().mergeLines()
    else
      return object PROFILE()
    endif

  endif

  return !result

endfunction
-- End of function definition
