-- File:            hvacposition.pmlfnc
--   Type:          Function Definition
--   Group:         HVAC
--     Keyword:     POSITION
--   Module:        design
--
-- Author:          Steve Bentley
--  Created:         Mon Jun  8 11:02:25 2009
--
-- Description:      Show the HVAC position form in a specific mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    Keyword 1 (head or tail)
--   [2] [R]    [STRING]    Keyword 2 (new or old)
--   [2] [R]    [STRING]    Keyword 3 (store or return)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!hvacPosition(!option is STRING, !mode is STRING, !action is STRING)

  if (defined(!!hvacPosition) and (!!hvacPosition.action.lowcase() neq !action.lowcase())) then
    !!hvacPosition.close()
    kill !!hvacPosition
  elseif (defined(!!hvacPosition) and (!!hvacPosition.newOrOld.lowcase() neq !mode.lowcase())) then
    !!hvacPosition.close()
    kill !!hvacPosition
  elseif (defined(!!hvacPosition) and (!!hvacPosition.headOrTail.lowcase() neq !option.lowcase())) then
    !!hvacPosition.close()
    kill !!hvacPosition
  endif

  if (!mode eq 'old' and !action eq 'return') then
    !!hvacPositionShowAttributes = true
  else
    !!hvacPositionShowAttributes = false
  endif

  show !!hvacPosition
  !!hvacPositionShowAttributes.delete()

  -- Head or Tail
  if (!option eq 'head') then
    !!hvacPosition.headOrTail = 'Head'
  elseif (!option eq 'tail') then
    !!hvacPosition.headOrTail = 'Tail'
  endif
  !!hvacPosition.formTitle = !!hvacPosition.headOrTail & ' Position'

  -- New or Old
  if (!mode eq 'old') then
    !!hvacPosition.newOrOld = 'Old'
  elseif (!mode eq 'new') then
    !!hvacPosition.newOrOld = 'New'
  endif

  -- Store or just Return
  if (!action eq 'store') then
    !!hvacPosition.action = 'Store'
  elseif (!action eq 'return') then
    !!hvacPosition.action = 'Return'
  endif

  -- Initialise the form with the specific options
  !!hvacPosition.init()

endfunction
-- End of function definition
