import 'PMLFileBrowser'
handle any
endhandle

import 'GridControl'
handle (1000,0)
endhandle

import 'MarApi'
handle (1000,0)
endhandle

define function !!insulationReport()

using namespace 'Aveva.Marine.Utility'
!util = object MarUtil()
!path = !util.TBEnvironmentGet('SB_SHIPPRINT')

using namespace 'Aveva.Pdms.Presentation'
!browser = object PMLFILEBROWSER('SAVE')
!browser.show(!path, 'insulationReport', 'title', false, 'Excel Files (*.xls)|*.xls',1)
if (!browser.file().eq('')) then
  return
endif

!ngc = object NETGRIDCONTROL()
!table = ARRAY()

-- Define columns
!headings = 'Space FaceNo Area Insulation Thickness Density Volume Weight Price'
!heads = !headings.split()

var !col collect all (SPMLFA) WHERE (not(unset(spmfcl))) for $!!CE

onerror continue
do !X TO !col.SIZE()
  !row = ARRAY()
  --Space
  !row[1] = FLNN of own of own of $!col[$!X]
  --Area
  !area = spmara of own of $!col[$!X]
  !row[3] = !area / 1000000
  --Insulation
  !row[4] = SPMFCL of $!col[$!X]
  --Face
  !row[2] = FLNN of $!col[$!X]
  --Goto insulation component
  var !cmp COLLECT ALL (INSCMP) WHERE (PURP eq 'HPLA') for /$!row[4]
  if (!cmp.size() gt 0) then
    --Thickness
    !row[5] = THICKNESS of $!cmp[1]
    --Density
    !row[6] = DNSTY of $!cmp[1]
    --Volume
    !vol = !area * !row[5]
    !row[7] = !vol / 1000000000
    --Weight
    !row[8] = !row[6] * !vol
    --Price
    !row[9] = (PRICEE of $!cmp[1]) * !row[3]
  else
    $P No INSCMP defined for $!insu
  endif

  !table[$!X] = ARRAY()
  !table[$!X].AppendArray( !row)
enddo

!data = object NETDATASOURCE('source', !heads, !table, FALSE)
!ngc.bindToDataSource( !data)

!ngc.SaveGridToExcel( !browser.file())

endfunction
