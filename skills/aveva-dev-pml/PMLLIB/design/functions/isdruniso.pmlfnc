--
-- File:            isdruniso.pmlfnc
--   Type:          Function Definition
--   Module:        ISODRAFT
--
-- Author:          M Barlow
-- Created:         02 Sept 2003
--
--
-- Description:
-- Function to display iso drawings in Design module.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Key word of SYS, STA or SHO
--    2   R      BOOLEAN     true or false to allow system highlighting to be toggled on/off
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!isdRunIso(!type is STRING, !toggle is BOOLEAN)

  -- Store the units so that they are retained after processing
  !savedUnits = object COMUNITS(true)

  -- <jw> mar09 <P-17552> LOAD the MDS OPTION DEFAULTS via the object MDSOPTIONDEFS
  --                      if MDS is installed and MDS OPTION DEFAULTS (e.g. !!mpu)
  --                      are not loaded
  if undefined(!!mpu) then
    --<RM> 14/03/11 search for MDSOPTIONDEFS in the search path. if we can find it then MDS is installed
    !!pml.getPathName('mdsoptiondefs.pmlobj')
    handle (44,33)
      --mds is not installed
    elsehandle NONE
      !!mdsDesIsoFlag = '1'
      !unusedLoadMdsOptions = object MDSOPTIONDEFS()
    endhandle
  endif
  -- <jw> mar09 <P-17552> END

  if( not defined(!!isdPreviewIsometric)) then
    !!isdPreviewIsometric = object ISDPREVIEWISOCONTROL()
  endif

  if(!type eq 'SYS') then

    ISODRAFTMODE
    !!isdPreviewIsometric.produceSystemIso()
    handle any
      !!alert.warning(!!error.text)
    endhandle
    EXIT
    --!!isdPreviewIsometric.form.enhanceSheet(!!isdPreviewIsometric.form.controlMenu.selected(|Highlight...|))
    !!isdPreviewIsometric.form.enhanceSheet(!!isdPreviewIsometric.form.enhance.val)

  elseif (!type eq 'STA') then

    ISODRAFTMODE
    !!isdPreviewIsometric.produceStandardIso()
    handle any
      !!alert.warning(!!error.text)
    endhandle
    EXIT
    --!!isdPreviewIsometric.form.enhanceSheet(!!isdPreviewIsometric.form.controlMenu.selected(|Highlight...|))
    !!isdPreviewIsometric.form.enhanceSheet(!!isdPreviewIsometric.form.enhance.val)

  else
    !!isdPreviewIsometric.showSystem(!toggle)

  endif

  -- Reset units
  !savedUnits.restoreSavedUnitsByPtype('DIST')
  !savedUnits.restoreSavedUnitsByPtype('BORE')

endfunction
-- End of function definition
