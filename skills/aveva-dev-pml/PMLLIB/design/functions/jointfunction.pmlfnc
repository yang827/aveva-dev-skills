-- Author:          N.Holmes
-- Created:         Tue Mar 25 17:52:42 WAT 1997
--
--
-- Description:
-- Executes the functions of the passed type for the given joint
-- on the joint.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Joint to have its function executed on
--    2   R      STRING      Function type of joint to be executed
--    3   RW     STRING      Error message if a function doesn't exist
--                           or it was unable to execute the function
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is successfully executed a function
--
------------------------------------------------------------------------

-- Define function
define function !!jointFunction (!joint is DBREF, !functionType is STRING, !errorMsg is STRING) is BOOLEAN

  -- Initialise Variables
  !currentElement = !!ce
  !catRef         = !joint.catRef
  !errorMsg       = ''

  -- If there is no catref for the joint, then we don't do anything
  if(!catRef.unset()) then
    !errorMsg     = 'No catalogue reference.'
    return false
  endif

  -- Get Dtref of Catalogue Item
  !dtRef          = !catRef.dtRef

  -- If there is no Data sets, then we don't do anything (when the direct
  -- querying of DTREF from a joint works properly the above can be removed)
  if(!dtRef.unset()) then
    !errorMsg     = 'No catalogue dataset.'
    return false
  endif

  -- Collect All Data elements for the Dtre, with the Purpose the same
  -- as the passed Function Type
  !dataElements   = !!collectMembersOf(!dtRef, 'PURP eq |' & !functionType.subString(1,4).upcase() & '|')

  -- Is there a Valid property
  if(!dataElements.unset()) then
    !errorMsg     = 'No function of type ' & !functionType & ' found.'
    return false
  endif

  -- Get Property key
  !property       = !dataElements[1].dKey

  -- Get Property (may need a limbo function later)
  var !function  (PROP $!property OF $!joint )

  -- Move to Joint (functions will only execute at the joint)
  !!ce            = !joint

  -- Execute Function
  !flag = !!command(!function)

  -- Return to Original item
  !!ce            = !currentElement

  if(!flag) then
    !errorMsg     = ''
    return true
  else
    !errorMsg     = 'Unable to execute function [' & !function & '] contact your Appware developer.'
    return false
  endif

endfunction
-- End of function definition for !!jointFunction
