--
--
-- Description:
-- Reposition the joint/section end dependent of on whether the jfree on
-- the joint is set. If the force flag is passed, this will position the
-- joint regardless of the jfree, but leave the JFREE as was.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Joint
--    2   R      BOOLEAN     Force Flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!jointRePosition (!joint is DBREF, !forceFlag is BOOLEAN)

  -- Initialise Variables
  !message        = STRING()
  !currentElement = !!ce

  -- Check we have access
  if(!!dbRefUpdate(!joint,!message).not()) then
    !!alert.error(!message)
    return
  endif

  -- Move to Joint
  !!ce = !joint

  -- Check if we are repositioning the joint using the setting of JFRE
  if(!forceFlag.not() or !joint.jfre.not()) then

    RECONN RECALC

  -- Forceable Set Position
  else

    JFRE FALSE
    DELP N0
    RECONN RECALC
    JFRE TRUE

  endif

  -- Execute any Joint Function (don't bother with any errors)
  !unusedFlag = !!jointFunction(!joint,'RPOS',!message)

  -- Return
  !!ce = !currentElement

endfunction
-- End of function definition for !!jointRePosition
