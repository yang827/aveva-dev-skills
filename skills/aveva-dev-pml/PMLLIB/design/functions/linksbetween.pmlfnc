-- Created:         Wed Mar 19 16:01:06 WAT 1997
--
--
-- Description:
-- Returns any links between the two passed items. This will only
-- look for linksets directly beneath the passed item and check the
-- links within them.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       First Item
--    2   R      DBREF       Second Item
-- Return:
--   [Data Type] [Description]
--    ARRAY       Link elements between items
--
------------------------------------------------------------------------

-- Define function
define function !!linksBetween (!from is DBREF, !to is DBREF) is ARRAY

  -- Collect All LinkSets
  !linkSetFrom = !!collectAllFor('LNKI','OWNER of LNKS eq ' & !from & ' and not(unset(LREF))', !from)
  !linkSetTo   = !!collectAllFor('LNKI','OWNER of LNKS eq ' & !to & ' and not(unset(LREF))', !to)

  -- Get All Link references between items
  !block       = object BLOCK('!linkSetFrom[!evalIndex].lref')
  !linkRefFrom = !linkSetFrom.evaluate(!block)
  !block       = object BLOCK('!linkSetTo[!evalIndex].lref')
  !linkRefTo   = !linkSetTo.evaluate(!block)

  -- Add the Link references to the Links
  !linkSetFrom.appendArray(!linkRefFrom)
  !linkSetTo.appendArray(!linkRefTo)

  -- Return the intersection of the to arrays, if there is an intersection then
  -- those are the items which are the link elements
  return  !linkSetFrom.intersect(!linkSetTo)
endfunction
-- End of function definition for !!linksBetween
