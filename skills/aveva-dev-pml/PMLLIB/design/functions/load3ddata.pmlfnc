--   Group:         3D Positioning ALL
--     Keyword:     POS
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Mar 19 15:57:59 GMT 1997
--
--
-- Description:
-- Load positional gadgets with 3D pos data from
-- from objects, taken from event picks
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [POSITION]  [Position object held by form]
--   [2] [R]    [STRING]    [Start or End of ASL component]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!load3Ddata(!position is POSITION,!gadget is STRING)

-- Default value for position (constructor/method needed for OO)

   if(!position.east.unset()) then
      !position = E0 N0 U0
   endif

-- determine start or end
if(!gadget eq |Start|) then
   !gad = ''
else
   !gad = '1'
endif

-- Get values for Gadgets

   !xPos = !position.east
   !yPos = !position.north
   !zPos = !position.up

-------------------- Set Form to XYZ position --------------------

---------- X ----------
 if(!!aslSpec.xT$!<gad>.val.not()) then
   if(!xPos ge 0) then
     !!aslSpec.xO$!<gad>.select('Dtext','East')
   else
     !!aslSpec.xO$!<gad>.select('Dtext','West')
   endif

     !!aslSpec.x$!<gad>.val = (dist(!xPos.abs()))
 endif
---------- Y ----------
 if(!!aslSpec.yT$!<gad>.val.not()) then
   if(!yPos ge 0) then
     !!aslSpec.yO$!<gad>.select('Dtext','North')
   else
     !!aslSpec.yO$!<gad>.select('Dtext','South')
   endif

     !!aslSpec.y$!<gad>.val = (dist(!yPos.abs()))
  endif
---------- Z ----------
 if(!!aslSpec.zT$!<gad>.val.not()) then
   if(!zPos ge 0) then
     !!aslSpec.zO$!<gad>.select('Dtext','Up')
   else
     !!aslSpec.zO$!<gad>.select('Dtext','Down')
   endif

     !!aslSpec.z$!<gad>.val = (dist(!zPos.abs()))
 endif
endfunction
-- End of function definition for !!load3Ddata
