--
-- Description:
--   Import data from Macro
--
------------------------------------------------------------------------

define function !!macroImport()

-- initialise input file name
  --!inputFile           = object FILE()
  !folderUser        = object FILE('%PDMSUSER%')
  !homeDirectory  = !folderUser.directory()

-- Use new std browser and check for file browser already loaded
  Import 'pmlfilebrowser'
    handle (1000,0)
    endhandle

-- If previous used use last used directory
  if (defined(!!saveImportmacro )) then
     !homeDirectory = !!saveImportmacro.directory()
  endif

  using namespace 'Aveva.Pdms.Presentation'
  !fileBrowser = object PMLFILEBROWSER('OPEN')
  !fileBrowser.show(!homeDirectory.string(), '', 'Import Macro', false, '', 1)
  !file = !fileBrowser.file()

-- abandon if form browser cancelled
  if( !file.empty() ) then
    return
  endif

-- Remember location of directory and filename if previously run in session.

  !!saveImportmacro    = object FILE()
  !!saveImportmacro    = object FILE('$!file')

-- Run macro and trap any errors if found

  $m "$!file"
    handle ANY
      !!alert.message('Error found in Macro $!file - $!!error.text')
    elsehandle (44,33)
      !!alert.message('FNF:File not found')
    elsehandle NONE
      !!alert.message('Macro $!file successfully executed')
    endhandle

endmethod

-- End of function definition

return
