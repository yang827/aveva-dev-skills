-- Define function
define function !!makeRepeatDdat(!dbRef is DBREF)

!refe = !!ce

!!ce = !dbRef
-- only create at siblings of TMPLs

   if(!!ce.hardType.eq('TMPL')) then
      return error 1 'Cannot create a repeat data set at TMPL level'
   endif

DDSE 1
handle any
FUNC 'Master Repeat'
NUMB 1

NEW DDSE

NEW DDATA PURP EXPR DKEY WRTO PTYP STRI DTIT 'With Respect To'
DDPR ( 'POINSP 1 OF SPINE 1 OF GENSEC' )
DDDF ( 'POINSP 1 OF SPINE 1 OF GENSEC' )


NEW DDATA PURP EXPR DKEY ATTR PTYP STRI DTIT 'Rule To Set'
DDPR ( 'POSS' )


NEW DDATA PURP EXPR DKEY NOFF PTYP INT DTIT 'Calc No.Off'
DDPR ( 'Expression for No Off')
DDDF ( 0 )

NEW DDATA PURP EXPR DKEY RULE PTYP STRI DTIT 'Repeat Rule'
DDPR ( ' U ' )
DDDF ( ' D ' )


NEW DDATA PURP EXPR DKEY DIST PTYP DIST DTIT 'Which Prop To Use'
DDPR ( 'Expression for distance' )
DDDF ( 1200 )
elsehandle none

endhandle

show !!dtsreptdisp

!!ce = !refe

endfunction
-- End of function definition for !!makeRepeatDdat
