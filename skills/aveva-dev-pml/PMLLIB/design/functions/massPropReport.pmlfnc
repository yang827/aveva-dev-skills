import 'PMLFileBrowser'
handle any
endhandle

import 'GridControl'
handle (1000,0)
endhandle

define function !!massPropReport()

using namespace 'Aveva.Pdms.Presentation'
!browser = object PMLFILEBROWSER('SAVE')
!browser.show('', 'massPropReport.xls', 'title', false, 'Excel Files (*.xls)|*.xls',1)
if (!browser.file().eq('')) then
  return
endif

!ngc = object NETGRIDCONTROL()
!table = ARRAY()


var !col collect all (SPMLSA) for $!!CE
if (!col.SIZE() gt 0) then
-- Define columns
   !headings = 'Space Est.Weight Calc.Weight X Y Z Est.Area Calc.Area Est.BW Calc.BW Est.FW Calc.FW'
   !heads = !headings.split()
   onerror continue
   do !X TO !col.SIZE()
     !row = ARRAY()
     --Space
     !row[1] = FLNN of own of $!col[$!X]
     --Estimated Weight
     !ewei = SPMEWS of $!col[$!X]
     !row[2] = !ewei / 1000
     --Calculated Weight
     !cwei = SPMCWS of $!col[$!X]
     !row[3] = !cwei / 1000
     --COG X
     !xcog = SPMCOS[1] of $!col[$!X]
     !row[4] = !xcog / 1000
     --COG Y
     !ycog = SPMCOS[2] of $!col[$!X]
     !row[5] = !ycog / 1000
     --COG Z
     !zcog = SPMCOS[3] of $!col[$!X]
     !row[6] = !zcog / 1000
     --Estimated Area
     !cwei = SPMEAS of $!col[$!X]
     !row[7] = !cwei / 1000
     --Calculated Area
     !cwei = SPMCAS of $!col[$!X]
     !row[8] = !cwei / 1000
     --Estimated Butt weld
     !cwei = SPMEWB of $!col[$!X]
     !row[9] = !cwei / 1000
     --Calculated Butt weld
     !cwei = SPMCWB of $!col[$!X]
     !row[10] = !cwei / 1000
     --Estimated Fillet weld
     !cwei = SPMEWL of $!col[$!X]
     !row[11] = !cwei / 1000
     --Calculated Fillet weld
     !cwei = SPMCWL of $!col[$!X]
     !row[12] = !cwei / 1000
     !table[$!X] = ARRAY()
     !table[$!X].AppendArray( !row)
   enddo
endif

var !col collect all (SPMBSA) for $!!CE
if (!col.SIZE() gt 0) then
-- Define columns
   !headings = 'Space Est.Weight Calc.Weight X Y Z'
   !heads = !headings.split()
   onerror continue
   do !X TO !col.SIZE()
     !row = ARRAY()
     --Space
     !row[1] = FLNN of own of $!col[$!X]
     --Estimated Weight
     !ewei = SPMEWS of $!col[$!X]
     !row[2] = !ewei / 1000
     --Calculated Weight
     !cwei = SPMCWS of $!col[$!X]
     !row[3] = !cwei / 1000
     --COG X
     !xcog = SPMCOS[1] of $!col[$!X]
     !row[4] = !xcog / 1000
     --COG Y
     !ycog = SPMCOS[2] of $!col[$!X]
     !row[5] = !ycog / 1000
     --COG Z
     !zcog = SPMCOS[3] of $!col[$!X]
     !row[6] = !zcog / 1000


     !table[$!X] = ARRAY()
     !table[$!X].AppendArray( !row)
   enddo
endif


var !col collect all (SPMPSA) for $!!CE
if (!col.SIZE() gt 0) then
-- Define columns
   !headings = 'Space Est.Area Calc.Area'
   !heads = !headings.split()
   onerror continue
   do !X TO !col.SIZE()

     !row = ARRAY()
     --Space
     !row[1] = FLNN of own of $!col[$!X]
    --Estimated Area
     !ewei = SPMEAS of $!col[$!X]
     !row[2] = !ewei / 1000
     --Calculated Area
     !cwei = SPMCAS of $!col[$!X]
     !row[3] = !cwei / 1000

     !table[$!X] = ARRAY()
     !table[$!X].AppendArray( !row)
   enddo
endif

!data = object NETDATASOURCE('source', !heads, !table, FALSE)
!ngc.bindToDataSource( !data)

!ngc.SaveGridToExcel( !browser.file())

endfunction
