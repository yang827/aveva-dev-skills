define function !!mdrCreateRoutesArray(!zone is ARRAY) is ARRAY
       !m = object MDRBASEMANAGER()
       !ret = ARRAY()
       !a = ARRAY()
       !col = object COLLECTION()
       !col.type('CWBRAN')
       !col.scope(!zone)
       !all = !col.results()
       do !i from 1 to !all.size()
         !a.append(!all[!i].string())
       enddo
       do !b values !a
          !route = !m.createRoute(object DBREF(!b))
          !ret.append(!route)
       enddo
       return !ret
endfunction
