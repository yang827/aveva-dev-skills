define function !!mdrFilterOutRoutePoints(!routePoints is ARRAY) is ARRAY
!out = ARRAY()
do !rp values !routePoints
   if (!rp.type().match('routepoint') eq 0) then
      !out.append(!rp)
   endif
enddo
   return !out

endfunction
