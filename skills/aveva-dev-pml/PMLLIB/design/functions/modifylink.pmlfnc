--   Group:         Link maintenance
--     Keyword:     LINKS
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Mar 21 14:21:10 WAT 1997
--
--
-- Description:
-- Modifies the passed link, with the set link object data
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item link element to be modified
--    2   R      LINK        Object containing link data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!modifyLink (!item is DBREF, !link is LINK)

  -- Initialise Variables
  !currentItem = !!ce
  !message     = STRING()

  -- Check we have access to create the link
  if(!!dbRefUpdate(!item,!message).not()) then
    !!alert.error(!message)
    return object DBREF()
  endif

  -- Navigate to !item
  !!ce = !item

  -- Create Item
  if(!link.description.set()) then
    DESC |$!link.description|
  endif
  if(!link.function.set()) then
    FUNC |$!link.function|
  endif
  if(!link.purpose.set()) then
    PURP $!link.purpose
  endif
  if(!link.number.set()) then
    NUMB $!link.number
  endif
  if(!link.fpoNumber.set()) then
    FPONUMB $!link.fpoNumber
  endif
  if(!link.tpoNumber.set()) then
    TPONUMB $!link.tpoNumber
  endif
  if(!link.mflg.set()) then
    MFLG $!link.mflg
  endif
  if(!link.dKey.set()) then
    DKEY $!link.dKey
  endif
  if(!link.gType.set()) then
    GTYP $!link.gType
  endif

  -- Return to Original Position
  !!ce = !currentItem

endfunction
-- End of function definition for !!modifyLink
