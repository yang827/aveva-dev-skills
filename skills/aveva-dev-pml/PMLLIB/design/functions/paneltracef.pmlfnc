--
-- File:            paneltracef.pmlfnc
--   Type:          Function Definition
--   Group:         Wall and Floors Application design
--     Keyword:     Civils
--   Module:        design
--   Replaces:
--
-- Author:          A.Johnson
-- Created:         Wed Apr 30 16:45:37 BST 1997
--
--
-- Description:
-- Given a panel with attached walls, this function will
-- determine the vertices required for a bracing panel
-- or 'carpet'. Assumes each panel vertex is attached
-- to a single STWALL and each panel has a single PLOO.
--
-- Requires functions memberOfType, distanceFromTo, pos3D4Pnts,
--                    lineFromTo and pos3DLineLine
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
--    2   R      REAL        Position Equality Tolerance
-- Return:
--   [Data Type] [Description]
--    ARRAY       Position Array of Calculated Vertices
--
------------------------------------------------------------------------

-- Define function
define function !!panelTraceF(!panel is DBREF, !tol is REAL) is ARRAY

--traces wall assuming a closed panel loop and each vertex references a single wall only

--initialise new array variables

  !newVertices = ARRAY()
  !newVertices.clear()

--find vertices describing current panel element

  !paves = !!memberOfType('PLOO',1,!panel).members
  !nElements = !paves.size()

--loop to determine new vertex or intersect position

--do for each vertex from vertex 1 to vertex N where there are N vertices in panel

  do !i from 1 to !nElements

--   unset intersect, points  and reqdn for later check

     !intersect = object POSITION()
     !pnt1      = object POSITION()
     !pnt2      = object POSITION()
     !pnt3      = object POSITION()
     !pnt4      = object POSITION()
     !reqdn     = REAL()

--   setup vertices to be considered

     if (!i eq 1) then

        !nm1 = !nElements
        !n   = 1
        !np1 = 2

     elseif (!i eq !nElements) then

        !nm1 = !nElements - 1
        !n   = !nElements
        !np1 = 1

     else

        !nm1 = !i - 1
        !n   = !i
        !np1 = !i + 1

     endif

--   Define jusl string for each considered vertex (unset if no
--   attached wall)

     !juslnp1 = STRING()
     !jusln   = STRING()
     !juslnm1 = STRING()

     if (!paves[!np1].mvert.set() ) then
        !juslnp1 = !paves[!np1].mvert.owner.owner.jusl
     endif
     if (!paves[!n].mvert.set() ) then
        !jusln   = !paves[!n].mvert.owner.owner.jusl
     endif
     if (!paves[!nm1].mvert.set() ) then
        !juslnm1 = !paves[!nm1].mvert.owner.owner.jusl
     endif

--   unset required edges

     !reqdEdge12 = STRING()
     !reqdEdge34 = STRING()

--   Check if current vertex(n) has a connected wall

--   if vertex n has CONNECTED walls then

     if ( !paves[!n].mvert.set() ) then

--      if vertex (n+1) has connected wall(n+1) and the start or end of connected wall(n+1)
--         is at vertex n then

--                   intersect wall(n+1) and wall(n)

--      elseif vertex(n-1) has connected wall(n-1) and the start or end of connected wall(n-1)
--         is at vertex n then

--                   intersect wall(n-1) and wall(n)

--      determine which attached wall (np1 or nm1) is required

        if (!paves[!np1].mvert.set() ) then

           if (!!distanceFromTo(!paves[!np1].mvert.owner.owner.plStart.attribute(!juslnp1).wrt(World),$
               !paves[!n].pos.wrt(World)) lt !tol or$
               !!distanceFromTo(!paves[!np1].mvert.owner.owner.plEnd.attribute(!juslnp1).wrt(World),$
               !paves[!n].pos.wrt(World)) lt !tol ) then
 --             $p Reqdn = np1

              !reqdn = !np1

           endif

        endif

        if (!paves[!nm1].mvert.set() ) then

           if (!!distanceFromTo(!paves[!nm1].mvert.owner.owner.plStart.attribute(!juslnm1).wrt(World),$
               !paves[!n].pos.wrt(World)) lt !tol or$
               !!distanceFromTo(!paves[!nm1].mvert.owner.owner.plEnd.attribute(!juslnm1).wrt(World),$
               !paves[!n].pos.wrt(World)) lt !tol ) then

              !reqdn = !nm1

           endif

        endif

        if ( !reqdn.set() ) then

--      find required plines(currently defined as that opposite to Jusl) for
--      intersection

           if (!paves[!reqdn].mvert.owner.owner.jusl eq 'IBOW') then

              !reqdEdge12 = 'OBOW'

           elseif (!paves[!reqdn].mvert.owner.owner.jusl eq 'OBOW') then

              !reqdEdge12 = 'IBOW'

           endif

           if (!paves[!n].mvert.owner.owner.jusl eq 'IBOW') then

              !reqdEdge34 = 'OBOW'

           elseif (!paves[!n].mvert.owner.owner.jusl eq 'OBOW') then

              !reqdEdge34 = 'IBOW'

           endif

--         Determine Pnts1-4 to describe start/end of lines to be intersected

           !pnt1 = !paves[!reqdn].mvert.owner.owner.plStart.attribute(!reqdEdge12).wrt(World)
           !pnt2 = !paves[!reqdn].mvert.owner.owner.plEnd.attribute(!reqdEdge12).wrt(World)
           !pnt3 = !paves[!n].mvert.owner.owner.plStart.attribute(!reqdEdge34).wrt(World)
           !pnt4 = !paves[!n].mvert.owner.owner.plEnd.attribute(!reqdEdge34).wrt(World)

        endif

--      else (must intersect an edge with wall n)

--      if vertex(n+1) is further away from other end of wall(i.e. from vertex n) than
--      vertex(n-1) then

--                   intersect wall(n) with edge from vertex(n) to vertex(n+1)

--      else

--                   intersect wall(n) with edge from vertex(n) to vertex(n-1)

--      endif

--      Which end of element [n] corresponds to pave[n]

--      if at start then find distance from end or if at end find distance from
--      start

        if ( !reqdn.unset() ) then

           if (!paves[!n].mvert.owner.owner.joiS.owner.pos.wrt(World)$
              eq !paves[!n].pos.wrt(World)) then

              !reqEndPos = !paves[!n].mvert.owner.owner.joiE.owner.pos.wrt(World)

           else

              !reqEndPos = !paves[!n].mvert.owner.owner.joiS.owner.pos.wrt(World)

           endif

--      determine distances from np1 and nm1 vertices

           !distnp1 = !!distanceFromTo(!paves[!np1].pos.wrt(World),!reqEndPos)
           !distnm1 = !!distanceFromTo(!paves[!nm1].pos.wrt(World),!reqEndPos)

--      choose required vertex for intersection

           if (!distnp1.abs() gt !distnm1.abs() ) then

              !reqdn = !np1

           else

              !reqdn = !nm1

           endif

--      find required pline and determine Pnts for intersection

           if (!paves[!n].mvert.owner.owner.jusl eq 'IBOW') then

              !reqdEdge34 = 'OBOW'

           elseif (!paves[!n].mvert.owner.owner.jusl eq 'OBOW') then

              !reqdEdge34 = 'IBOW'

           endif

           !pnt1 = !paves[!n].pos.wrt(World)
           !pnt2 = !paves[!reqdn].pos.wrt(World)
           !pnt3 = !paves[!n].mvert.owner.owner.plStart.attribute(!reqdEdge34).wrt(World)
           !pnt4 = !paves[!n].mvert.owner.owner.plEnd.attribute(!reqdEdge34).wrt(World)

        endif

--   elseif vertex n has UNCONNECTED walls then

     elseif (!paves[!n].mvert.unset() ) then

--       if vertex(n+1) has connected wall(n+1) and the end or start of wall(n+1) is at
--          vertex(n) then
--       if vertex(n-1) has connected wall(n-1) and the end or start of wall(n-1) is at
--          vertex(n) then

--                 intersect wall(n+1) and wall(n-1)

         if (!paves[!np1].mvert.set() and !paves[!nm1].mvert.set() ) then

--          determine required plines (opposite to Jusl)

            if (!paves[!np1].mvert.owner.owner.jusl eq 'IBOW') then
               !reqdEdge12 = 'OBOW'
            elseif (!paves[!np1].mvert.owner.owner.jusl eq 'OBOW') then
               !reqdEdge12 = 'IBOW'
            endif

            if (!paves[!nm1].mvert.owner.owner.jusl eq 'IBOW') then
               !reqdEdge34 = 'OBOW'
            elseif (!paves[!nm1].mvert.owner.owner.jusl eq 'OBOW') then
               !reqdEdge34 = 'IBOW'
            endif

--       if start/end of Jusl plines corresponds with vertex n then use 'opposite' plines
--       to describe Pnts for intersection

            if (!!distanceFromTo(!paves[!np1].mvert.owner.owner.plStart.attribute(!juslnp1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol or$
                !!distanceFromTo(!paves[!np1].mvert.owner.owner.plEnd.attribute(!juslnp1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol and$
                !!distanceFromTo(!paves[!nm1].mvert.owner.owner.plStart.attribute(!juslnm1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol or$
                !!distanceFromTo(!paves[!nm1].mvert.owner.owner.plEnd.attribute(!juslnm1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol ) then

                !pnt1 = !paves[!np1].mvert.owner.owner.plStart.attribute(!reqdEdge12).wrt(World)
                !pnt2 = !paves[!np1].mvert.owner.owner.plEnd.attribute(!reqdEdge12).wrt(World)
                !pnt3 = !paves[!nm1].mvert.owner.owner.plStart.attribute(!reqdEdge34).wrt(World)
                !pnt4 = !paves[!nm1].mvert.owner.owner.plEnd.attribute(!reqdEdge34).wrt(World)

            endif

--       elseif vertex(n+1) has connected wall(n+1) and end or start of wall(n+1) is at
--              vertex(n) then

--
--                   intersect wall(n+1) with edge vertex(n) and vertex(n-1)

         elseif (!paves[!np1].mvert.set() and !paves[!nm1].mvert.unset() ) then

--          determine required pline (opposite to Jusl)

            if (!paves[!np1].mvert.owner.owner.jusl eq 'IBOW') then
               !reqdEdge12 = 'OBOW'
            elseif (!paves[!np1].mvert.owner.owner.jusl eq 'OBOW') then
               !reqdEdge12 = 'IBOW'
            endif

--       if start/end of Jusl pline of np1 corresponds with vertex n then use 'opposite' pline
--       to describe Pnts for intersection with edge(line) between vertices n and nm1

            if (!!distanceFromTo(!paves[!np1].mvert.owner.owner.plStart.attribute(!juslnp1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol or$
                !!distanceFromTo(!paves[!np1].mvert.owner.owner.plEnd.attribute(!juslnp1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol ) then

                !pnt1 = !paves[!np1].mvert.owner.owner.plStart.attribute(!reqdEdge12).wrt(World)
                !pnt2 = !paves[!np1].mvert.owner.owner.plEnd.attribute(!reqdEdge12).wrt(World)
                !pnt3 = !paves[!n].pos.wrt(World)
                !pnt4 = !paves[!nm1].pos.wrt(World)

            endif

--       elseif vertex(n-1) has connected wall(n-1) and end or start of wall(n-1) is at
--              vertex(n) then

--
--                   intersect wall(n-1) with edge vertex(n) and vertex(n+1)

         elseif (!paves[!np1].mvert.unset() and !paves[!nm1].mvert.set() ) then

--          determine required pline (opposite to Jusl)

            if (!paves[!nm1].mvert.owner.owner.jusl eq 'IBOW') then
               !reqdEdge34 = 'OBOW'
            elseif (!paves[!nm1].mvert.owner.owner.jusl eq 'OBOW') then
               !reqdEdge34 = 'IBOW'
            endif

--       if start/end of Jusl pline of nm1 corresponds with vertex n then use 'opposite' pline
--       to describe Pnts for intersection with edge(line) between vertices n and np1

            if (!!distanceFromTo(!paves[!nm1].mvert.owner.owner.plStart.attribute(!juslnm1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol or$
                !!distanceFromTo(!paves[!nm1].mvert.owner.owner.plEnd.attribute(!juslnm1).wrt(World),$
                !paves[!n].pos.wrt(World)) lt !tol ) then

                !pnt1 = !paves[!n].pos.wrt(World)
                !pnt2 = !paves[!np1].pos.wrt(World)
                !pnt3 = !paves[!nm1].mvert.owner.owner.plStart.attribute(!reqdEdge34).wrt(World)
                !pnt4 = !paves[!nm1].mvert.owner.owner.plEnd.attribute(!reqdEdge34).wrt(World)

            endif

         endif

     endif

--   if line definition points have not been defined then set intersection
--   point to position of current vertex

     if (!pnt1.origin.unset() ) then

        !intersect = !paves[!n].pos.wrt(World)

     elseif (!intersect.origin.unset() ) then

--   if line definition points Pnt1-4 are set then obtain required intersection point by
--   intersecting lines pnt1-pnt2 and pnt3-pnt4

        !intersect = !!pos3D4Pnts(!pnt1,!pnt2,!pnt3,!pnt4)

     endif

--   append intersect value to NewVertices Array

     !newVertices.append(!intersect)

  enddo

--return array of new panel vertices

  return !newVertices

endfunction
-- End of function definition for !!panelTraceF
