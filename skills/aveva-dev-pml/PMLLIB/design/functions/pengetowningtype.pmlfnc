--
-- Description:
-- function to return the correct owning type of penetration
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Penetration item to get owner from]
-- Return:
--   [Data Type] [Description]
--
--   [DBREF]    [Return the owner relating to penetration]
--
------------------------------------------------------------------------

define function !!penGetOwningType(!item is DBREF) is DBREF


 -- !owningRef = refe of sctn of $!item

  --handle any
   --!owningRef = REFE of STWALL of $!item
   --handle any
    -- !owningRef = REFE of WALL of $!item
    -- handle any
     --  !owningRef = REFE of GENSEC  of $!item
     --  handle any
      --   !owningRef = object dbref()
      -- endhandle
     --endhandle
   ---endhandle
  --endhandle

  -- set softTypes up to search for

  !gensec    = !!dtbSoftTypes.stringSTypesFor('GENSEC')
  !sctn      = !!dtbSoftTypes.stringSTypesFor('SCTN')
  !panel     = !!dtbSoftTypes.stringSTypesFor('PANE')
  !softTypes = !gensec & !sctn & !panel

  -- get owner
  !owningRef = !!dtbGetOwnerType(!item, !softTypes)

  return !owningRef

endfunction
-- End of function definition for !!penGetOwningType
