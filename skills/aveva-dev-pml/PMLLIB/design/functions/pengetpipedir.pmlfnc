--
--
-- Description:
-- function to determine the direction of the pipe
-- for curved gensecs
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Fixing ref]
-- Return:
--   [Data Type] [Description]
--   [Direction] [Direction of the pipe]
--
------------------------------------------------------------------------

define function !!penGetPipeDir(!dummyFixing is DBREF) is DIRECTION

  !refe = !!ce

  !direction = PL DIR OF CREF WRT WORLD
  handle any
    -- in case you are at the CMPF level fixing, in which case use the SUBF level
    FIXING 1
    handle any
      !direction = object DIRECTION()
    elsehandle none
     !direction = PL DIR OF CREF WRT WORLD
     handle any
       !direction = object DIRECTION()
     endhandle
    endhandle
  endhandle

  !!ce = !refe

  return !direction

endfunction
-- End of function definition for !!penGetPipeDir
