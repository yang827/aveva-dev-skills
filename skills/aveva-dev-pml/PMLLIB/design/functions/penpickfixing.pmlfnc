-- Author:          A.Kirkland
-- Created:         Mon Oct 5 17:16:52 BST 1998
--
--
-- Description:
-- function to pick nearest fixing on a wall or gensec.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--   [1] [R]    [Data from EDG pick]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!penPickFixing(!data is ANY) is DBREF


  -- initialise variables

     !fixPos       = ARRAY()
     !dist         = ARRAY()
     !position     = !data.position
     !topLevelItem = object DBREF()

 -- test if item picked is owned by a tmpl
    !tmplOwnership = !!penTestTmplOwner(!data.item, !topLevelItem)

 -- first test - is the item under a template
 if(!tmplOwnership) then
   !item = !topLevelItem

 -- Check Item picked for type (if GENSEC or STWALL get nearest fixing)
 elseif(!data.item.hardType inset ('SCTN','STWALL','GENSEC')  ) then
   ------------------------------------------------------------------
   -- do this bit cos straight walls are sctns ----------------------
   if(!data.item.hardType.eq('GENSEC')) then
     !search = 'FIXING'
     !own    = 'FIXING'
   elseif(!data.item.hardType.eq('STWALL')) then
     !search = 'SBFI'
     !own    = 'CMFI'
   else
      !search = 'FITT'
      !own    = 'SCTN'
   endif
   ------------------------------------------------------------------
   -- COLLECT ALL fixings/sbfi(stwall)
      var !fixings COLLECT ALL $!search WITH HARDTYPE OF  OWNER EQ '$!own' FOR $!<data.item>
   -- var !fixings COLLECT ALL $!search WITH HARDTYPE OF  OWNER EQ '$!own' AND GTYP EQ 'PENH' FOR $!<data.item>
      -- go thro each fixing/SBFI and calc distance from pick intersection with GENSEC/STWALL
         do !ind indices !fixings
            !fixPos[!ind] = !fixings[!ind].dbRef().position.wrt(worl)
            !dist[!ind]   = !position.distance(!fixPos[!ind])
         enddo

         -- Sort distances to find shortest distance (first element in sort)
            if(!dist.empty().not()) then
               var !sort SORT !dist  NUMERIC
               !first    = !sort[1]
               !item     = !fixings[!first.real()].dbRef()
            else
               !!alert.error('No fixings exist on picked  ' & !data.item.type)
               !!edgCntrl.remove('Nearest Fixing Pick')
               return
            endif

 -- If pick is an atta goto cref -------------------------------------
 elseif(!data.item.hardType.eq('ATTA')) then

   if(!data.item.cref.neq(nulref)) then
     !item = !data.item.cref
   else
     !!alert.error('Picked ' & !data.item & ' has no Reference.')
     !!edgCntrl.remove('Nearest Fixing Pick')
     return
   endif

 -- If pick is fixing/sbfi goto picked element (STWALL:(() -------------------------------------
 elseif(!data.item.hardType inset('FIXING','SBFI','CMFI','FITT')) then

     !item = !data.item

 -- Alert navigate problems if none of the above are picked ----------
 else
    !!alert.error('Not able to navigate to fixing from picked ' & !data.item.type)
    !!edgCntrl.remove('Nearest Fixing Pick')
    return
 endif

 --  Select item in penetration list

  !form = !!cdMpene
  !list = !form.list.rText
  !isInList = !list.findFirst('$!item')

 -- check that the element is in the list

 if(!isInList.set()) then
   var list _cdMpene_List SEL REPL |$!item| exit
   $M "%PDMSUI%/DES/PENS/IMPENE" $<GRAPH$>
 else
   -- just navigate to it
      !!ce = !item
      !!alert.error ('Identified item is not in the current list.')
 endif

 -- remove edg event from stack
    !!edgCntrl.remove('Nearest Fixing Pick')

endfunction
-- End of function definition for !!penPickFixing
