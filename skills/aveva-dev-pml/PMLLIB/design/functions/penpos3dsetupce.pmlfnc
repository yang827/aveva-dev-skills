--
--
-- Description:
-- function to setup ce to that selected penetration
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!penPos3DSetupCe()

  !refe = !!ce
  !form = !!cdMpene
  if(!form.shown().not()) then
    !!alert.error('Cannot Navigate to penetration, penetration list is not shown.')
    return
  endif

  !item = !form.list.selection().dbRef()
  handle any
    -- a dummy value
    !!alert.error('Penetration hole not selected in the penetration list.')
     return
  endhandle

  if(!item.hardType.eq('ATTA')) then
    !!alert.error('Penetration Hole cannot be modified in the Piping Application.')
    return
  endif

    if(not(!item.hardType inset('CMPF','CMFI','PFIT','FITT','SBFI'))) then
    !!alert.error('Penetration Hole not selected.')
    return
  endif


  !!ce = !item

  !!pos3DExplicit()

  !!ce = !refe

endfunction
-- End of function definition for !!penPos3DSetupCe
