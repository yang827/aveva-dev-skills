-- File:            pensplitmulti.pmlfnc
--   Type:          Function Definition
--   Group:         Penetration Application

--     Keyword:     PENS
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Thu Aug 20 10:53:40 BST 1998
--
--
-- Description:
-- function to split a multi-penetration back to single penetrations
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]     [Cmpf/fi to split back to single penetrations]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!penSplitMulti(!cmpf is STRING)

  -- check the penetration form has data to pass
  if(!cmpf.eq('')) then
    !!alert.error('Penetration List has no multi-penetrations loaded.')
    return
  endif
  !refe = !!ce
  !position = object POSITION()
  !owner = object DBREF()
  if(!cmpf.dbRef().hardType.eq('FIXING')) then
    !!alert.error('Not able to undo merge for GENSECS.')
    return
  endif
  !multi = !cmpf.dbRef()
  handle any
    -- in case a panel is selected in the penetration list
     !!alert.error('A Multi-Penetration is not selected in the Penetration List.')
     return
  endhandle
  !type =  !multi.type
  !sjus =  !multi.sjus
  -- just in case passed dbref is a SBFI
  if(!type.eq('SBFI')) then
    !multi = !cmpf.dbRef().owner
    !type  = !multi.type
  elseif(not(!type  inset('CMFI','CMPF'))) then
    !!alert.error('A Multi-Penetration is not selected in the Penetration List.')
    return
  endif

  -- are you sure ??

  !ok = !!alert.confirm('Undo Merge, Are you sure?')
  if(!ok.upcase().eq('NO')) then
    return
  endif

  var !sbfi COLLECT ALL SBFI FOR $!multi
  if(!sbfi.size().eq(1)) then
    -- already a single penetration
       return
  endif
  do !ind indices !sbfi
    -- is it stored in the undo gvar (should be on merge form eventually)
    !findSbfi = !!dummyGvarForData.sbfitting.findFirst(!sbfi[!ind].dbRef())
    handle any
      -- in case no data is stored in dummygvarfordata
     !owner    = object DBREF()
     !position = !sbfi[!ind].dbRef().cref.position.wrt(worl)
    elsehandle none
      var !chkPos (DELP OF $!sbfi[$!ind])
       if(!findSbfi.unset() and !chkPos.eq('E 0 N 0 U 0')) then
         skip
       elseif(!findSbfi.unset()) then
          !owner    = object DBREF()
          !position = !sbfi[!ind].dbRef().cref.position.wrt(worl)
       else
       -- get data from object store
         !owner    = !!dummyGvarForData.owner[!findSbfi]
         !position = !!dummyGvarForData.position[!findSbfi]
       endif
    endhandle
     if(!owner.badRef().not() or !owner.unset().not()) then
        !!ce = !owner
        INCL $!sbfi[$!ind]
        handle any
        elsehandle none
          -- reposition the sbfi at default (can be made better when SJG fixes positioning problem)
          !!ce = !sbfi[!ind].dbRef()
          DELP N0U0E0
        endhandle
      else
        !!ce = !multi.owner
        NEW $!type
        if(!type.eq('CMPF')) then
          MOVE E THRO $!position
          MOVE N THRO $!position
          INCL $!sbfi[$!ind]
          SJUS $!sjus
          handle any
            -- null string
          endhandle
         -- reposition the sbfi at default (can be made better when SJG fixes positioning problem)
          !!ce = !sbfi[!ind].dbRef()
          DELP N0U0E0

        else
          var !posl POSL OF $!multi
          ZDIST THRO $!position
          POSL $!posl
          handle any
          endhandle
            INCL $!sbfi[$!ind]
        -- reposition the sbfi at default (can be made better when SJG fixes positioning problem)
          !!ce = !sbfi[!ind].dbRef()
          PIN 1 AT $!position
        -- I definitely need this positioning lark to be fixed (******AK******)
        -- this bit is no substitute.
         var !posString PIN 1 POS WRT CE
          DELP $!posString
          PIN 1 OFF
          $m "%PDMSUI%/DES/PENS/RGETDIR" $<$!sbfi[$!ind]$>
          ZDIR $!!cdwnrtn WRT WORLD
          var !!cdwnrtn DELETE
        endif
       endif

  enddo

  -- get rid of the spre of the cmpf/cmfi
  !!ce = !multi
   var !multiRef REFE
  -----------------------------------------
  -- remove tmpl if any exist (include block to remove kickplate and nxtr if exist
  !nxtr = '/ref(' & !multiRef & ')'
  SPRE NULREF
  !!ce = !nxtr.dbRef()
  handle any
  elsehandle none
    DELETE NXTR
  endhandle

  var !tmpl COLLECT ALL TMPL FOR $!multi

  do !it values !tmpl
    !!ce = !it.dbRef()
     DELETE TMPL
     handle (2,500) (2,501) (2,502) (2,503) (2,504)
       -- DAC errors (Very unlikely)
        !!alert.warning('Template not deleted - ' & !!error.text)
        handle ANY
          -- Just in case the concatenated text is too long
          !!alert.warning(!!error.text)
        endhandle
     elsehandle any
       -- in case geometry is valid and locked
     endhandle
  enddo
  ---------------------------------------------
  -- rebuild list with the single penetrations.
 $M "%PDMSUI%/DES/PENS/IMPENE" $<$!multi$> $<TRUE$>
 handle any
 endhandle

  !!ce = !refe


endfunction
-- End of function definition for !!penSplitMulti
