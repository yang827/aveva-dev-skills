--
--  File:            pipe1to1pene.pmlfnc
--    Type:          Function Definition
--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Undefined
--  Created:         Wed Jul 11  8:59:22 2007

--
--  Description:     Undefined
--
----
----------------------------------------------------------------------

define function !!pipe1to1pene()

  if (undefined(!!hmDefinition)) then
    pml load form !!hmDefinition
  endif

  !!hmDefinition.frmSingleMerged.val = 1

  $:debug$:

  -- Initialise Variables
  !hvac = false

  --!item = !!cd1to1pene.hole.val
  var !crflg |$_CDPENEDEF_CRFLG|     $* can the hole spre be set
  var !cflg  |$_CD1TO1PEND_CFLG|     $* confirm yes or no
  var !cmpf  |$_CD1TO1PEND_NEWC|     $* whether create new or not
  var !styp  (part(|$_CDPENEDEF_ILIST|,1,'\'))
  -- var !refe refe
  !form = !!cdpenedef

  $(
  $* Pick Data
  var !ITEM  |$_CDGEOMPICK_ITEM|
  var !unusedData  |$_CDGEOMPICK_DATA|
  var !unusedVec   |$_CDGEOMPICK_VEC|
  var !unusedEnd   |$_CDGEOMPICK_END|
  var !unusedType  |$_CDGEOMPICK_TYPE|


  $* Test whether to create new CMPF or not

  if($!CMPF) then
     var !TEST |hardtype of $!ITEM neq 'PANE'|
  $* var !TEST |type of $!ITEM neq 'PANE' and type of $!ITEM neq 'SCTN'|
  else
     var !TEST |type of $!ITEM neq 'CMPF' and type of $!ITEM neq 'SBFI'|
  endif

  $* Check what we are picking
  $* Defining the item to be penetrated
  $)

  -- should not happen now but i've kept the if statement just in case
  if(empty(|$_CD1TO1PENE_HOLE|)) then
    $(
    var _CD1TO1PENE_HOLE |$!ITEM|
    if($!TEST) then
      var _CD1TO1PENE_HOLE ||
      CALLGEOM DGEOMPMT $<Invalid type, Pick item to be penetrated.$>
    else
      enhance $!ITEM col 9
      refresh
      CALLGEOM DGEOMPMT $<Pick item to Penetrate.$>
    endif
    $)
  -- Define the item to penetrate (ie we can now create the penetration)
  --elseif (empty(|$_CD1TO1PENE_ITEM|)) then
  else

    --var _CD1TO1PENE_ITEM |$!ITEM|

--    var !tempPENE |$_CD1TO1PENE_ITEM|
--    var !temppane |$_CD1TO1PENE_HOLE|

    !pane = !!selectPipePeneForm.penetrated
    !picked = !!selectPipePeneForm.pickedPenetrating
    !writeAccess = !pane.dbwrite
    if (!pane.type eq 'HPLATE'or !pane.type eq 'CPLATE' ) then
      !writeAccess = FALSE
    endif

    if($!cflg) then
      confirm at xr 0.05 yr 0.7 |OK to create penetration ?|
      if(not $_CALERT_USERDATA) then
        return
      endif
    endif

    !!ce=!picked            $* goto where the user picked

    -- Get Data
    if(TYPE eq |BRAN|) then
      var !bdir HDIR
      var !bpos HPOS wrt worl
      var !diam PH OD
      var !line |line $!bdir through $!bpos|
      var !pflg true
    elseif(TYPE of OWNE eq |BRAN|) then
      var !diam PL OD
      var !line |PL of $!picked|
      var !pflg true
    elseif(TYPE eq |SCTN|) then
      var !poss poss
      var !pose pose
      -- var !SDIR const dir $!poss to $!pose
      var !line const line join $!poss to $!pose

      var !pflg false
    else
      return   error 1  |Invalid component.|
    endif

    -- goto panel or hole for penetration
    !!ce=!pane

    $M "%PDMSUI%/CLIB/FILES/RXYZDIR" ORI CE
    handle (2,211)
      -- ORI cannot be evaluated for the picked item - probably a curved plate
      -- default ori to that of the penetrating object
      !pdir = !picked.orientation.zDir().string()
      !ppos = !picked.position.wrt( world ).string()
    elsehandle none
    var !pdir |$!!cdcartn[3]|
    var !ppos (POS of PANE wrt worl)
    handle any
      var !ppos (POS of HPLATE wrt worl)
      handle any
        var !ppos (POS of FLOOR wrt worl)
        handle any
          var !ppos (POS of SCREED wrt worl)
          handle any
            var !ppos (POS of STWALL wrt worl)
            endhandle
          endhandle
        endhandle
      endhandle
    endhandle

    var !plan |plane $!pdir through $!ppos|

    var !intr const pos inter $!line $!plan
    --------------------------------------------------------------------------------
    -- Track penetration position and direction for use later
    !penPos = !intr.position()
    !penDir = !pdir.direction()
    --------------------------------------------------------------------------------

    if !writeAccess and !!isThisHmProj().not() then
      -- create sbfi and atta in pipe
      if($!cmpf) then                          $* create new CMPF
        NEW CMPF at $!intr wrt world
        SJUS UTOP
        GTYPE PENH
      else                                     $* include in picked hole
        CMPF $* goto owner if picked is a SBFI
      endif

      NEW SBFI delp $!intr wrt world
      -- do this until core is fixed
      delp e0n0u0

      GTYPE PENH

      if($!crflg) then
        SPRE $_CDPENEDEF_HLIST      $* only set the hole spre if default allows
      endif

      var !sbfi REFE

      --item
      !!ce=!picked

      if($!pflg) then                         $* it is a pipe or HVAC
        NEW ATTA
        var !atta refe

        if (type of owner of branch eq 'PIPE') then
        	!!hmDefinition.type = 'PIPE'
        	SEL
        	handle any
            SEL wi spec $_CDPENEDEF_ISPEC stype $!styp $* depending on defaults
            handle ANY
              SEL wi spec $!!cdpencla.spec.selection() stype $!styp $* try the clash setting instead
              handle ANY
                delete ATTA
                unenhance all
                aid clear all
                return error 1 |Incorrect Default ATTA Spec.|
              endhandle
            endhandle
          endhandle
          ORI
          --THRO $!SBFI $* not doing it thro the sbfi because its not put in the correct place
          THRO $!intr wrt worl
          atty PENI
          --------------------------------------------------------------------------------
          !penItem = !!ce
          --------------------------------------------------------------------------------
          CREF $!sbfi

          -- set the properties
          !form.itemProp.setProperties(!!ce)
          var !od PL OD
          var !clea desp numb 1
           -- **************************************************** HVAC ********************************************************
        elseif (type of owner of branch eq 'HVAC') then
          !hvac = true
          !aValue = '0'
          !bValue = '0'
          if (MCOUNT eq 1) then
            var !aValue :hxysize[1]
            var !bValue :hxysize[2]
          else
            var !aValue desp[4] of prev
            var !bValue desp[5] of prev
          endif
          !aValueReal = !aValue.real()
          handle ANY
            !aValueReal = 0
          endhandle
          !bValueReal = !bValue.real()
          handle ANY
            !bValueReal = 0
          endhandle
          DESP N100 0
          DESP N2 $!aValue
          DESP N3 $!bValue
          DESP N4 $!aValue
          DESP N5 $!bValue
          DESP N41 $!aValue
          DESP N42 $!bValue
          DESP N33 6
          if (WDESP[40] of prev eq 'RECT') then
        	  !!hmDefinition.type = 'RECT'
            spref /AvevaHVACSPEC-Penetrations/Rectangular-Marker
            handle ANY
              !!alert.error('The Aveva HVAC Penetration Spec is not available')
              $!sbfi
              end
              delete cmpf
              $!atta
              delete atta
              return
            endhandle
          elseif (WDESP[40] of prev eq 'CIRC') then
        	  !!hmDefinition.type = 'CIRC'
            spref /AvevaHVACSPEC-Penetrations/Circular-Marker
            handle ANY
              !!alert.error('The Aveva HVAC Penetration Spec is not available')
              $!sbfi
              end
              delete cmpf
              $!atta
              delete atta
              return
            endhandle
          else
        	  !!hmDefinition.type = 'OVAL'
            spref /AvevaHVACSPEC-Penetrations/FlatOval-Marker
            handle ANY
              !!alert.error('The Aveva HVAC Penetration Spec is not available')
              $!sbfi
              end
              delete cmpf
              $!atta
              delete atta
              return
            endhandle
          endif

          ORI
          THRO $!intr wrt worl
          atty PENI
          --------------------------------------------------------------------------------
          !penItem = !!ce
          --------------------------------------------------------------------------------
          CREF $!sbfi

          -- Use Clasher to put ATTA at the midpoint on the Panel or Plate
          -- The Markers have a default thickness on desp[33] (temporarily change to 3000 to make sure we clash)
          var !thickness (DESP[33])
          DESP n33 3000
          DESCLASH
          -- First save the current clasher set-up
          SAVE SETUP /%PDMSWK%/ClasherSetup OVER
          REMOVE OBSTRUCTION ALL
          OVERRIDE ON
          MIDPOINT ON
          OBSTRUCTION $!pane
          CHECK $!atta
          var !clashCount CLASH COUNT CLASHES
          if (!clashCount.real() gt 0) then
            var !middlePosition CLASH 1 POSITION
            !error = false
          else
            !error = true
          endif
          RESTORE /%PDMSWK%/ClasherSetup
          EXIT
          if (!error) then
            var !panelType TYPE OF $!pane
            !!alert.error('Item does not pass through ' & !panelType )
          else
            -- Set the marker thickness back to it's original setting
            DESP n33 $!thickness
            AT $!middlePosition WRT /*

            -- Compound fitting for HVAC at middle position also
            GOTO CREF
            END
            SJUST UCEN
            1 SBFI
            DELP $!middlePosition WRT /*
            $!atta

            -- Call the modify HVAC Penetration item form
            call !!displaySpecSel('HPEN', 'MODIFY')

            -- Set design parameters if there are any
            !!spcHvacPenSpecSel.properties.setProperties(!!ce)
            !!spcHvacPenSpecSel.properties.unsetDesiElement()

            -- Design parameter forty is the HVAC item shape
            var !shape PROP SHAP
            handle any
              DESP N40 MAIN
              !shape = 'MAIN'
            endhandle
            -- Design parameter one is always description
            DESP N1 PENI

            -- Set Duct size design parameters if they are unset
            if (!shape inset ('RECT','OVAL','MAIN')) then
              if (DESP[4] eq 0) then
                DESP N4 (DESP[2])
              endif
              if (DESP[5] eq 0) then
                DESP N5 (DESP[3])
              endif
            elseif (!shape inset ('CIRC')) then
              if (DESP[4] eq 0) then
                DESP N4 (DESP[2])
              endif
            endif

            -- Set the implied tube
            -- The LSTU is stored on a LSTU property
            var !impliedTubeString (prop lstu)
            handle ANY
            elsehandle NONE
              !impliedTube = !impliedTubeString.dbref()
              handle ANY
              elsehandle NONE
                !!ce.lstube = !impliedTube
                handle ANY
                endhandle
              endhandle
            endhandle

            -- Set ATTYP PENI for penetration items
            if (TYPE eq 'ATTA') then
              var !propertyType (prop type)
              handle ANY
                -- Do nothing
              elsehandle NONE
                if (!propertyType eq 'PENI') then
                  !!ce.attyp = !propertyType
                endif
              endhandle
            endif
          endif
        endif
      endif
    else
      -- sort out the atta for when we just have an atta and a fixing
      !!ce=!picked

      if($!pflg) then                         $* it is a pipe or HVAC

        NEW ATTA
        var !atta refe

        if (type of owner of branch eq 'PIPE') then
        	!!hmDefinition.type = 'PIPE'
        	SEL
        	handle any
            SEL wi spec $_CDPENEDEF_ISPEC stype $!styp $* depending on defaults
              handle ANY
              SEL wi spec $!!cdpencla.spec.selection() stype $!styp $* try the clash setting instead
              handle ANY
                delete ATTA
                unenhance all
                aid clear all
                return error 1 |Incorrect Default ATTA Spec.|
              endhandle
            endhandle
          endhandle

          ORI
          --THRO $!SBFI $* not doing it thro the sbfi because its not put in the correct place
          THRO $!intr wrt worl
          atty PENI
          --------------------------------------------------------------------------------
          !penItem = !!ce
          --------------------------------------------------------------------------------
          --CREF $!SBFI

          -- set the properties
          !form.itemProp.setProperties(!!ce)
          var !od PL OD
          var !clea desp numb 1
           -- **************************************************** HVAC ********************************************************
        elseif (type of owner of branch eq 'HVAC') then
          !hvac = true
          !aValue = '0'
          !bValue = '0'
          if (MCOUNT eq 1) then
            var !aValue :hxysize[1]
            var !bValue :hxysize[2]
          else
            var !aValue desp[4] of prev
            var !bValue desp[5] of prev
          endif
          !aValueReal = !aValue.real()
          handle ANY
            !aValueReal = 0
          endhandle
          !bValueReal = !bValue.real()
          handle ANY
            !bValueReal = 0
          endhandle
          DESP N100 0
          DESP N2 $!aValue
          DESP N3 $!bValue
          DESP N4 $!aValue
          DESP N5 $!bValue
          DESP N41 $!aValue
          DESP N42 $!bValue
          DESP N33 6
          if (WDESP[40] of prev eq 'RECT') then
        	  !!hmDefinition.type = 'RECT'
            spref /AvevaHVACSPEC-Penetrations/Rectangular-Marker
            handle ANY
              !!alert.error('The Aveva HVAC Penetration Spec is not available')
--              $!SBFI
--              end
--              delete cmpf
              $!atta
              delete atta
              return
            endhandle
          elseif (WDESP[40] of prev eq 'CIRC') then
        	  !!hmDefinition.type = 'CIRC'
            spref /AvevaHVACSPEC-Penetrations/Circular-Marker
            handle ANY
              !!alert.error('The Aveva HVAC Penetration Spec is not available')
--              $!SBFI
--              end
--              delete cmpf
              $!atta
              delete atta
              return
            endhandle
          else
        	  !!hmDefinition.type = 'OVAL'
            spref /AvevaHVACSPEC-Penetrations/FlatOval-Marker
            handle ANY
              !!alert.error('The Aveva HVAC Penetration Spec is not available')
--              $!SBFI
--              end
--              delete cmpf
              $!atta
              delete atta
              return
            endhandle
          endif

          ORI
          THRO $!intr wrt worl
          atty PENI
          --------------------------------------------------------------------------------
          !penItem = !!ce
          --------------------------------------------------------------------------------
          --CREF $!SBFI

          -- Use Clasher to put ATTA at the midpoint on the Panel or Plate
          -- The Markers have a default thickness on desp[33] (temporarily change to 3000 to make sure we clash)
          var !thickness (DESP[33])
          DESP n33 3000
          DESCLASH
          -- First save the current clasher set-up
          SAVE SETUP /%PDMSWK%/ClasherSetup OVER
          REMOVE OBSTRUCTION ALL
          OVERRIDE ON
          MIDPOINT ON
          OBSTRUCTION $!pane
          CHECK $!atta
          var !clashCount CLASH COUNT CLASHES
          if (!clashCount.real() gt 0) then
            var !middlePosition CLASH 1 POSITION
            !error = false
          else
            !error = true
          endif
          RESTORE /%PDMSWK%/ClasherSetup
          EXIT
          if (!error) then
            var !panelType TYPE OF $!pane
            !!alert.error('Item does not pass through ' & !panelType )
          else
            -- Set the marker thickness back to it's original setting
            DESP n33 $!thickness
            AT $!middlePosition WRT /*

            -- Compound fitting for HVAC at middle position also
--            GOTO CREF
--            END
--            SJUST UCEN
--            1 SBFI
--            DELP $!middlePosition WRT /*
            $!atta

            -- Call the modify HVAC Penetration item form
            call !!displaySpecSel('HPEN', 'MODIFY')

            -- Set design parameters if there are any
            !!spcHvacPenSpecSel.properties.setProperties(!!ce)
            !!spcHvacPenSpecSel.properties.unsetDesiElement()

            -- Design parameter forty is the HVAC item shape
            var !shape PROP SHAP
            handle any
              DESP N40 MAIN
              !shape = 'MAIN'
            endhandle
            -- Design parameter one is always description
            DESP N1 PENI

            -- Set Duct size design parameters if they are unset
            if (!shape inset ('RECT','OVAL','MAIN')) then
              if (DESP[4] eq 0) then
                DESP N4 (DESP[2])
              endif
              if (DESP[5] eq 0) then
                DESP N5 (DESP[3])
              endif
            elseif (!shape inset ('CIRC')) then
              if (DESP[4] eq 0) then
                DESP N4 (DESP[2])
              endif
            endif

            -- Set the implied tube
            -- The LSTU is stored on a LSTU property
            var !impliedTubeString (prop lstu)
            handle ANY
            elsehandle NONE
              !impliedTube = !impliedTubeString.dbref()
              handle ANY
              elsehandle NONE
                !!ce.lstube = !impliedTube
                handle ANY
                endhandle
              endhandle
            endhandle

            -- Set ATTYP PENI for penetration items
            if (TYPE eq 'ATTA') then
              var !propertyType (prop type)
              handle ANY
                -- Do nothing
              elsehandle NONE
                if (!propertyType eq 'PENI') then
                  !!ce.attyp = !propertyType
                endif
              endhandle
            endif
          endif
        endif
      endif
    endif
  $(
  else                                    $* it is a sctn
    var !SDIST const dist $!poss to $!INTR
    NEW FITT
    GTYP PENI
    SPRE $_CDPENEDEF_SLIST
    handle any
      delete fitt
      return error 1 |Default settings not correctly set up. Please check Specifications with System Administrator|
    endhandle
    ZDIST $!SDIST
    POSL NAL
    --------------------------------------------------------------------------------
    !penItem = !!ce
    --------------------------------------------------------------------------------
    CREF $!SBFI
    -- set the properties
    !form.steelProp.setProperties(!!ce)
  $)
  endif

  if !writeAccess and !!isThisHmProj().not() then
    $!sbfi
    if($!crflg) then
      -- set the properties
      !form.holeProp.setProperties(!!ce)

      -- set diam based on atta details rather than the default diam data
      var !diam prop diam
      handle any
      -- find out which desP is the diam
      elsehandle none
        if(|$!diam| neq |unset|) then
          var !dtas coll all data wi (dkey eq |DIAM|) for dtre
          var !dpno eval numb for all from !dtas
          var !ndia ($!od + (2 * $!clea))
          desp numb $!dpno[1] $!ndia
        endif
      endhandle
    endif
    --$* CALLGEOM DNATIVE
  endif

  -- Navigate to the atta for HVAC because you may wish to set properties
  if (!hvac) then
    $!atta
  endif

  !!cd1to1pend.origin = !penPos
  !!cd1to1pend.direction = !penDir
  !!cd1to1pend.penetrated = !pane
  !!cd1to1pend.penetrating = !atta.dbref()

  if !writeAccess and !!isThisHmProj().not() then
    !!cd1to1pend.subfitting = !sbfi.dbref()
  endif

  --CALLPEN I1TO1PENE
  $M "%PDMSUI%/DES/PENS/I1TO1PENE"
  UNENHANCE ALL

  -- load up penetration form with new penetration created ----
  -- (assume owning panel for new list)

  --  !form = !!cdmpene
  --  !shown = !form.shown()
  --  if(!shown) then
  --    !!ce = !pane.dbref()
  --    CALLPEN XMPENE HOLE
  --    !!ce = !REFE.DBREF()
  --  endif
  ------------------------------------------------------------


endfunction
