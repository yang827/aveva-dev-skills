--  File:            pipeSimpleAutoRoute.pmlfnc
--    Type:          Function Definition
--    Group:         Pipe
--      Keyword:     Pipe
--    Module:        design
--  Author:          Daniel(Jaehun Choi)
--  Created:         23 July 2010
--
--  Description:     Pipe Simple Auto Route
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pipeSimpleAutoRoute(!element is DBREF, !positions is ARRAY)
  if (!element.type neq 'BRAN' and !element.owner neq 'PIPE') then
    return
  endif

  if (undefined(!!rtrDefaults)) then
    pml reload form !!rtrDefaults
  endif

  -- Change direction using...
  -- !dir   = !!rtrDefaults.dirChange.selection()
  if (!!rtrDefaults.gap.val.unset()) then
    !gap = 100
  else
    !gap = !!rtrDefaults.gap.val
  endif

  if (!!rtrDefaults.round.val.unset()) then
    !round = 10
  else
    !round = !!rtrDefaults.round.val
  endif

  ROUTER
    --CONFIGURATION DIRECTION  $!dir
    CONFIGURATION DIRECTION  ELBOW
    CONFIGURATION PRSPACE    $!gap
    CONFIGURATION PRROUNDING $!round
  EXIT
--
--  CALLR XROUTER
--  KILL _CDROUTER


  -- Start alpha file off to store all message going to command line
  router
    --config error mess
    config error off
  exit

  !order[1] = !element.ref.string()

  do !branch values !order
    $!branch
  -------------------------------------------------------------------------------
  -- Set branch status (bstat) to zero - "not Routed"
  -- Branches at this stage in macro have been blown away, any errors while
  -- processing will now pick up later it is not routed
  -------------------------------------------------------------------------------
    BSTAT 0
    -- Set the BRLOCK for each branch
--    CALLR MSETBRLOC
--    $M "$:ROUTER$:MSETBRLOC"
--    $M "$:ROUTER$:MSETRLOC"
    -- Set the RLOC for each component of current branch
    --CALLR MSETRLOC
  enddo

  !hpos = !element.hpos.wrt( /* )
  !tpos = !element.tpos.wrt( /* )

  !hposStr = 'E ' & !hpos.east.string('D2') & ' N ' & !hpos.north.string('D2') & ' U ' & !hpos.up.string('D2')
  !tposStr = 'E ' & !tpos.east.string('D2') & ' N ' & !tpos.north.string('D2') & ' U ' & !tpos.up.string('D2')

  router
  config error off
  clear all

  do !point values !positions

    !pointStr = 'E ' & !point.east.string('D2') & ' N ' & !point.north.string('D2') & ' U ' & !point.up.string('D2')

    skip if (!hposStr eq !pointStr or !tposStr eq !pointStr)

    new point at $!point after $!element
  enddo

  route $!element

  handle none
    EXIT
    BSTAT 1
  elsehandle (61,721)
    EXIT
    BSTAT 2
  elsehandle any
    exit
    --!!alert.error(!!ERROR.TEXT)
  endhandle

endfunction
