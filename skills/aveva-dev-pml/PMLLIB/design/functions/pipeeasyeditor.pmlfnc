--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pipeeasyeditor()
  if (undefine(!!pipeeasyeditor)) then
    pml reload form !!pipeeasyeditor
    handle any
      pml reload form !!pipeeasyeditor
    endhandle
  endif
  -- show form
  show !!pipeeasyeditor
endfunction
