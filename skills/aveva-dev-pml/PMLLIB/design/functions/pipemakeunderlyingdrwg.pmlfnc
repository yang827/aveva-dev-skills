--
--  File:            pipemakeunderlyingdrwg.pmlfnc
--    Type:          Function Definition
--    Group:         Pipe
--      Keyword:     Pipe
--    Module:        draft
--  Author:          Daniel(Jaehun Choi)
--  Created:
--
--  Description:     make underlying drawing for pipe spool drawing
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
--    2   R      STRING      Option file path
--    3   R      STRING      Unique ID of calling process
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pipemakeunderlyingdrwg(!spoolname is STRING,!optionFile is STRING,!uniqueId is STRING)

  !element = !spoolname.dbref()
  if (!element.badref()) then
    return
  endif

  !pipeSpoolDwg = object PIPESPOOLDWG(!uniqueId)
  !path[1] = !pipeSpoolDwg.makeUnderlyingDrwg(!element, !optionFile)
  handle ANY
    !pipeSpoolDwg.writeErrorMessage(!!error.line,!!error.text)
    !pipeSpoolDwg.createResultFile()
    return
  endhandle
  if !path[1].set() then
    !pipeSpoolDwg.resultList.writeFile('append',!path)
  endif

endfunction
-- End of function definition for pipemakeunderlyingdrwg
