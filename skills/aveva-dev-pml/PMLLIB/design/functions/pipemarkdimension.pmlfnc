--  Description:     Function used to create pipe or pipe spool dimension on 3D view
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pipemarkdimension()
  -- define object for creating pipe dimension
  if (undefined(!!pipemodeldimension)) then
   !!pipeModelDimension = object PIPEMODELDIMENSION()
  endif

  -- creating pipe model dimension
  !!pipeModelDimension.drawDimension(!!ce)

endfunction
