$(D
Create Penetrations
Arguments:
Global Arguments:
Returns:
$)

--$:debug$:

define function !!pipeMultipene()

  if (undefined(!!hmDefinition)) then
    pml load form !!hmDefinition
  endif

  !!hmDefinition.frmSingleMerged.val = 2

  -- change for penetrating sections which does single and multiple from the same form
  if (!!cdpencla.ptyp.selection() eq 'SINGLE') then
    !!hmDefinition.frmSingleMerged.val = 1
  endif

  -- Initialise Variables
  var !taro |$_CDPENCLA_TARO|
  var !objo |$_CDPENCLA_OBJO|
  var !cflg |$_CDPENCLA_CFLG|  $* Confirm
  var !ptyp |$_CDPENCLA_PTYP|  $* Multi or Single Penetration
  var !tflg false
  var !oflg false
  var !type |$_CDPENCLA_USERDATA|
  var !refe REFE
  var !!cdpapenobj delete $* used to pass penetrating elems to XMPENE
  var !spec |$_CDPENCLA_SPEC|

  -- Clear any penetration aid text
  AID CLEAR TEXT 17000
  handle ANY
  endhandle

  -- Set spec selection
  if(|$!spec| eq |DFLT|) then
    var !sel  |SEL|
  else
    var !sel  |SEL with SPEC $!spec|
  endif

  -- Set data for specific types
  -- Branch
  if(|$!type| eq |BRAN|) then
    var !etyp |ATTA|
    var !gtyp |ATTY PENI|
    var !pcmd |THRO|
    var !ocmd |ORI|
    !!hmDefinition.type = 'PIPE'

  -- Section
  elseif(!type.eq(|SCTN|)) then
    var !etyp |FITT|
    var !gtyp |GTYP PENI|
    var _CDHLORIT_ITEM |true|
    var !pcmd |ZDIST THRO|
    var !ocmd ||
    !!hmDefinition.type = 'SCTN'
  endif

  -- If lists are defined, then load into relevant arrays
  if(part(|$!taro|,1) eq |LIST|) then
    var !tarn (part(|$!taro|,2))
    if(defined(!!cdlist$!tarn)) then
      var !pentar coll all from !!cdlist$!tarn
    else
      return error 1 |No elements in the "Penetrated" list.|
    endif
    unenhance all from !pentar
    var !tflg true
  endif

  if(part(|$!objo|,1) eq |LIST|) then
    var !objn (part(|$!objo|,2))
    if(defined(!!cdlist$!objn)) then
      var !penobj coll all from !!cdlist$!objn
    else
      return error 1 |No elements in the "Penetrate" list.|
    endif
    unenhance all from !penobj
    var !oflg true
  endif

  -- Check if lists are used
  if($!tflg and $!oflg) then
    if(|$!taro| eq |$!objo|) then
      return error 1 |The same list can not be used for both penetrated and penetrating items.|
    endif

    -- Check if there are any items in both lists
    var !coll coll all from !pentar
    var !coll append coll all from !penobj
    var !asiz (arraysize(!coll))
    var !sort sort unique !coll
    var !bsiz (arraysize(!sort))
    var !more $!asiz - $!bsiz

    if($!more neq 0) then

      -- Initialise Variables
      var !tsiz (arraysize(!pentar))
      -- var !osiz (arraysize(!penobj))

      -- Find out which ones are duplicated
      var !sort sort !coll last !last
      var !subt subt !coll !sort !last
      var !dupl eval (vtex(!subt(vval(!en))) eq ||) indices !subt count !en
      do !indx indices !dupl
        if($!dupl[$!indx]) then
          var !nind $!indx + 1
          var !nval $!sort[$!nind]
          var !vval $!sort[$!indx]

          enhance $!coll[$!vval] col 2
          var !ditm append |$!coll[$!vval]|
          var !tnum append ($!vval)
          var !onum append ($!nval - $!tsiz)

        endif
      enddo

      -- Remove from penetrating list
      confirm |$!more elements exist in both lists, ok to remove from "Penetrating" list?|
      if($_CALERT_USERDATA) then
        do !indx values !tnum
          var !pentar[$!indx] delete
        enddo

      -- Remove from penetrate list
      else
        confirm |Ok to remove from "Penetrated" list?|
        if($_CALERT_USERDATA) then
          do !indx values !onum
            var !penobj[$!indx] delete
          enddo
        else
          unenhance all from !ditm
          return error 1 |Cannot perform penetration with duplications in the list.|
        endif
      endif
      unenhance all from !ditm
    endif
  endif

  -- Highlight !PENOBJ list is defined
  if($!oflg) then
    enhance all from !penobj col 2
  endif

  -- Pick items to be Penetrated
  if(|$!taro| eq |ID|) then

    $M "%PDMSUI%/CLIB/FILES/RPICKLOOP" $<identify item to be penetrated.$> 2 $<FLOOR PANE SCTN STWALL SBWALL HPLATE CPLATE$>
    golabel /END if($!!cdrtnstatus neq 0)
    var !pentar coll all from !!cdpartn

  -- Highlight Relevant lists
  else
    enhance all from !pentar col 2
  endif

  -- Setup Clasher so that items are check against the PENTAR list
  golabel /END if(undefined(!pentar))
  var !sctnon coll all from !pentar

  if(arraysize(!sctnon) gt 0) then

    -- Save Clash Data
    $M "%PDMSUI%/DES/STLWRK/DCLADAT" SET

    -- Set Obstructions
    var !!cdpapass coll all from !sctnon
    $M "%PDMSUI%/DES/STLWRK/DCLADAT" OBST !!cdpapass

  endif

  -- Pick items to penetrate
  if(|$!objo| eq |ID|) then
    if(!type.eq('SCTN')) then
      !sections = !!dtbSofttypes.stringStypesFor('SCTN')
      !gensecs  = !!dtbSofttypes.stringStypesFor('GENSEC')
      !type = !sections & !gensecs
    endif
    $M "%PDMSUI%/CLIB/FILES/RPICKLOOP" $<identify items that penetrate.$> 2 $<$!type$>
    golabel /END if($!!cdrtnstatus neq 0)
    var !penobj coll all from !!cdpartn
  endif

  -- If there are no element in the lists, abort
  golabel /END if(undefined(!pentar) or undefined(!penobj))

  -- Perform Clash Check on items in !PENOBJ list
  var !objitem delete   $* Items which are going to penetrate
  var !taritem delete   $* Items which are going to be penetrated e.g panel
  DESCLASH MIDPOINT ON EXIT

  !tube = ARRAY()

  do !indx indices !penobj

    DESCLASH CHECK $!penobj[$!indx] EXIT

    var !ccnt           clash count all
    var !ccnt           ($!ccnt A A A )

    do !aindx from 1 to $!ccnt
      var !cpos  CLASH $!aindx POS
      var !cobj  CLASH $!aindx FIRST
      var !ctar  CLASH $!aindx SECOND
      if(match(|$!cobj|,|(tube)|) gt 0) then
--        !tube[!indx] = TRUE
        !tube.append(TRUE)
        var !cobj (before(|$!cobj|,|(tube)|))
      else
--        !tube[!indx] = FALSE
        !tube.append(FALSE)
      endif
      if(match(|$!ctar|,|(tube)|) gt 0) then
        var !ctar (before(|$!ctar|,|(tube)|))
      endif
      var !atyp  (TYPE of $!cobj )
      var !btyp  (TYPE of $!ctar )
      var !objitem append (REFE of $!cobj )
      var !taritem append (REFE of $!ctar )
      var !penposi append |$!cpos|
    enddo

  enddo
  DESCLASH MIDPOINT OFF EXIT
  unenhance all from !pentar
  unenhance all from !penobj

  if(undefined(!taritem)) then
    error |Unable to determine elements to penetrate.|
    golabel /END
  elseif(undefined(!objitem)) then
    error |Unable to determine elements to penetrate with.|
    golabel /END
  endif

  -- Confirm
  if($!cflg) then
    do !i indices !objitem
      AID TEXT NUMB 17000 |<$!atyp - $!btyp - $!indx>| at $!penposi[$!i] wrt World
    enddo

    confirm |OK to penetrate items?|
    AID CLEAR TEXT 17000
    golabel /END if(not $_CALERT_USERDATA)
  endif

  -- Go and do the penetrations

  if !!isThisHmProj() then
    !holedata = object ARRAY()
  endif

  -- array of processed objects to avoid processing the same item twice
  !processedObjItem = ARRAY()

  do !i indices !objitem

    -- skip any elements already processed
    skip if( !processedObjItem.findFirst(!objitem[!i]).set() )
    !processedObjItem.append(!objitem[!i])

    -- Check if there is already a connection between item in the current straight
    $M "%PDMSUI%/DES/PENS/RPENEXTS" $<$!objitem[$!i]$> $<$!taritem[$!i]$>
    skip if($!!cdlnrtn)

    -- Create Panel/Section fitting
    $!taritem[$!i]
    handle ANY
      break
    endhandle

    if(HARDTYPE eq |SCTN|) then
      NEW CMFI ZDIST THRO $!penposi[$!i] wrt World
      POSL NA
      --PIN 1 at $!PENPOSI[$!i]
      --var !PosString PIN 1 POS wrt ce
      NEW SBFI
      --DELP $!PosString
      --PIN 1 OFF
        delp $!penposi[$!i] wrt worl
    elseif (HARDTYPE eq |GENSEC|) then
      --var !PPL pkey of onpline ppline any  through $!PENPOSI[$!i]  bound
      var !ppl Jusl
      var !seg id segment ppline NA through  $!penposi[$!i] via pline bound
      handle any
       var !seg id segment ppline any through  $!penposi[$!i] via pline bound
      endhandle
      var !z pldist ppline $!ppl through  $!penposi[$!i] via pline bound
      handle any
       var !z pldist ppline any through  $!penposi[$!i] via pline bound
      endhandle

      NEW JLDATUM
      HPREF $!seg
      ZDIST $!z
      NEW PLDATU POSL $!ppl
      NEW FIXING POS $!penposi[$!i] wrt World
      GTYP PENH
      NEW FIXING POS $!penposi[$!i] wrt World
      GTYP PENH
    else
      !writeAccess = !!ce.dbwrite
      if !writeAccess and !!isThisHmProj().not() then
        -- create sbfi and atta in pipe
        if(|$!ptyp| eq |MULTI|) then
          if($!i eq 1) then
            NEW CMPF AT $!penposi[$!i] wrt /*
            AT X(pos[1]) y(pos[2]) SJUS UTOP
            GTYP PENH
            var !cmpfgrp refe
          endif
          var !spos |$!penposi[$!i] wrt /*|
          $!cmpfgrp                        $* goto CMPF grp if already created
        else
          NEW CMPF AT $!penposi[$!i] wrt /*
          AT X(pos[1]) y(pos[2]) SJUS UTOP
          GTYP PENH
          var !spos |E0N0U0|
        endif

        NEW SBFI DELP $!spos
        --  NEW PFIT AT $!PENPOSI[$!i] wrt /*
        --  AT X(pos[1]) Y(pos[2]) SJUS UTOP
      endif

      if !writeAccess and !!isThisHmProj().not() then
        GTYP PENH
        var !href REFE
      elseif !writeAccess.not() and !!isThisHmProj().not() then
        !!alerterror('You do not have sufficient privileges to write to this element')
        return
      endif

      if !!isThisHmProj() then

        -- set up array to store hole data [1] = panel, [2] = pipe, [3] = intersection point
        !holeDataElements = object ARRAY()

        -- append the panel, pipe and intersection to an array so we can pass it to hole management
        !holeDataElements.append(!taritem[!i].dbref())
        if (!!hmDefinition.type eq 'PIPE') then
          if (!objitem[!i].dbref().type neq 'BRAN') then
            !holeDataElements.append(!objitem[!i].dbref().owner)
          else
            !holeDataElements.append(!objitem[!i].dbref())
          endif
        else
          !holeDataElements.append(!objitem[!i].dbref())
        endif
        !holeDataElements.append(!penposi[!i].position())
      endif
    endif

    -- Create Pipe/Section atta/fitt
    $!objitem[$!i]
    handle ANY
      break
    endhandle
    NEW $!etyp
    handle(41,8)
    -- gensec penetrating ----------------------------------------------------

      var !ppl Jusl
      handle any
        !gensec    = !!dtbSofttypes.stringStypesFor('GENSEC')
        !owningRef = !!dtbGetOwnerType(!!ce, !gensec )
        !!ce = !owningRef
        var !ppl Jusl
      endhandle

      var !seg id segment ppline NA through  $!penposi[$!i] via pline bound
      handle any
       var !seg id segment ppline any through  $!penposi[$!i] via pline bound
      endhandle
      var !z pldist ppline $!ppl through  $!penposi[$!i] via pline bound
      handle any
       var !z pldist ppline any through  $!penposi[$!i] via pline bound
      endhandle

      NEW JLDATUM
      HPREF $!seg
      ZDIST $!z
      NEW PLDATU POSL $!ppl
      NEW FIXING POS $!penposi[$!i] wrt World
                GTYP PENI
      NEW FIXING POS $!penposi[$!i] wrt World
                   GTYP PENI
    ------------------------------------------------------------------------------
    elsehandle (2,500) (2,501) (2,502) (2,503) (2,504)
      -- DAC errors
      !!alert.error(!!error.text)
      return
    elsehandle NONE
      -- add the atta reference to hole management if necessary
      if !!isThisHmProj() then
        !holeDataElements.append(!!ce)
        !holedata.append(!holeDataElements)
      endif
      if (!etyp eq 'ATTA') then
      $!sel
      handle ANY
        delete ATTA
        return error 1 |Incorrect Default ATTA Spec.|
      endhandle
      $!gtyp
      $!ocmd
      if (!tube[!i]) then
        thro $!penposi[$!i] wrt worl
      else
      at $!penposi[$!i] wrt worl
      endif
      elseif (!etyp eq 'FITT') then
        ZDIST THRO $!penposi[$!i] wrt worl
      endif
    endhandle
    CREF $!href
    handle any
      -- temporary handle if hole managed, need to sort out what really needs to happen
    endhandle
    var !!cdpapenobj append REFE
  enddo

  if !!isThisHmProj() then
    -- populate the hm form for multi-penetrations
    loadform !!hmDefinition
    !!hmDefinition.multiPenetrationData.clear()
    !!hmDefinition.multiPenetrationData = !holedata
    --!!hmDefinition.Multi = TRUE
    show !!hmDefinition
  else
    -- Show penetration modification form
    if(defined(!!cdpapenobj)) then
      if(|$_CDPENEAPP_USERDATA| eq |STLWRK|) then
        var user _CDMPENE |ITEM| 2
      endif
      $M "%PDMSUI%/DES/PENS/XMPENE" GVAR !!cdpapenobj
    endif
  endif

  -- End
  label /END
  UNENHANCE ALL from !pentar
  handle ANY
  endhandle
  UNENHANCE ALL from !penobj
  handle ANY
  endhandle
  AID CLEAR TEXT 17000
  handle ANY
  endhandle

  -- Restore original clash data
  $M "%PDMSUI%/DES/STLWRK/DCLADAT" LOAD

  -- Return to original element
  $!refe

endfunction
