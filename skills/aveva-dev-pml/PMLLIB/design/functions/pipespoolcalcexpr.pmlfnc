--    Group:         Pipe
--      Keyword:     Pipe
--    Module:        common
--  Author:          Daniel(Jaehun Choi)
--  Created:
--
--  Description:     calculate evaluation on pipe spool
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pipespoolcalcexpr(!entryName is STRING, !query is STRING) is STRING
  !spoolManager = object PIPESPOOLMANAGER()
  !entry = $!entryName

  if (!entry.type neq 'PPIECE' and !entry.type neq 'PSPOOL') then
    !unusedSpoolElement = object DBREF('/' & !entry.spln)
    handle any
    endhandle
  endif

  if (!query.upcase() eq 'QTY') then
    if (!entry.type eq 'PPIECE') then
      !result = !entry.ppCutLength.nint()
    else
      !result = 1
    endif

  elseif (!query.upcase() eq 'AC') then
    if (!entry.type eq 'PPIECE') then
      !result = !entry.ppFinLength.nint()
    else
      !result = 1
    endif

  elseif(!query.upcase() eq 'INS_FIX') then
    if (!entry.:PIECETYPE.upcase().occurs('FIX') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'INS_PENI') then
    if (!entry.:PIECETYPE.upcase().occurs('PENI') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif
  elseif(!query.upcase() eq 'INS_ADJ') then
    if (!entry.:PIECETYPE.upcase().occurs('ADJ') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'IN_AC') then
    if (!entry.:TREAT.empty() OR !entry.:TREAT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:TREAT.part(1,',')

  elseif(!query.upcase() eq 'OUT_AC') then
    if (!entry.:TREAT.empty() OR !entry.:TREAT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:TREAT.part(2,',')

  elseif (!query.upcase() eq 'IN_PAINT') then
    if (!entry.:PAINT.empty() OR !entry.:PAINT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:PAINT.part(1,',')


  elseif (!query.upcase() eq 'OUT_PAINT') then
    if (!entry.:PAINT.empty() OR !entry.:PAINT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:PAINT.part(2,',')

  elseif (!query.upcase() eq 'INSUL') then
    !mtoElements = !spoolManager.getMtoElements(!entry)
    !result = 'O'
    do !entry values !mtoElements
      skip if (!entry.type inset ('WELD','ATTA'))

      if (!entry.ispec.badref()) then
        !result = ''
        break
      endif
    enddo

  elseif (!query.upcase() eq 'TOT_WEIGHT') then
    !result = !!pipespoolgetweight(!entry).string('D2')

  elseif(!query.upcase() eq 'BD_NOR') then
    if (!entry.:BENDCON.upcase().occurs('NOR') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'BD_COLD') then
    if (!entry.:BENDCON.upcase().occurs('COLD') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'BD_HF') then
    if (!entry.:BENDCON.upcase().occurs('HF') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'SHIP_XPOS') then
    !wvol = !entry.wvol
    !xCentre = ( !wvol[1] + !wvol[4] ) / 2
    !yCentre = ( !wvol[2] + !wvol[5] ) / 2
    !zCentre = ( !wvol[3] + !wvol[6] ) / 2

    !centrePos = E $!xCentre N $!yCentre U $!zCentre

    !result = !!comTranslateShipPosition(!centrePos)[1]
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() eq 'SHIP_YPOS') then
    !wvol = !entry.wvol
    !xCentre = ( !wvol[1] + !wvol[4] ) / 2
    !yCentre = ( !wvol[2] + !wvol[5] ) / 2
    !zCentre = ( !wvol[3] + !wvol[6] ) / 2

    !centrePos = E $!xCentre N $!yCentre U $!zCentre

    !result = !!comTranslateShipPosition(!centrePos)[2]
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() eq 'SHIP_ZPOS') then
    !wvol = !entry.wvol
    !xCentre = ( !wvol[1] + !wvol[4] ) / 2
    !yCentre = ( !wvol[2] + !wvol[5] ) / 2
    !zCentre = ( !wvol[3] + !wvol[6] ) / 2

    !centrePos = E $!xCentre N $!yCentre U $!zCentre

    !result = !!comTranslateShipPosition(!centrePos)[3]
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() eq 'FLG_ROT') then
    -- ANGLE OF FLANGE ROTATE
    !components = !entry.belrfa

    !flangeList = object ARRAY()
    do !entry values !components
      skip if (!entry.type ne 'FLAN')

      !flangeList.append(!entry)
    enddo

    !angleList = object ARRAY()
    do !i from 1 to !flangeList.size() - 1
      !cosAngle  = !flangeList[!i].pzdir[1].dot(!flangeList[!i + 1].pzdir[1])
      handle any
        skip
      endhandle

      !angle     = acos(!cosAngle)
      if (abs(nint(!angle)) eq 90 OR nint(!angle) eq 0) then
        skip
      endif


      !angleList.append(!angle)
    enddo

    !flangeRotateAngle  = 0
    if (!angleList.set()) then
      !flangeRotateAngle = !angleList.last()
    endif

    if (!flangeRotateAngle eq 0) then
      !result = ''
    else
      !result = !flangeRotateAngle.nint().string()
    endif

  elseif(!query.upcase() eq 'BORE') then
    !result = !entry.abore

  else
    !result = ''

  endif

  --$p >> [ result get spool item : $!result ]

  return !result.string()
endfunction
