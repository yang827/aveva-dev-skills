--  Author:          Daniel(Jaehun Choi)
--  Created:         23 July 2010
--
--  Description:     make spool dimension on a spool drawing
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pipespooldim(!taskRef is DBREF, !spoolRef is DBREF, !viewRef is DBREF)
  !parameter = object ARRAY()

  do !tkpara value !taskRef.mem
    !index = !parameter.size() + 1
    !parameter[!index] = object ARRAY()
    !parameter[!index].append(!tkpara.function)
    !parameter[!index].append(!tkpara.pType)
    !parameter[!index].append(!tkpara.tpValue)
  enddo

  !dimLayerRef = !!collectAllFor('LAYE',|purpose eq 'DIMA'|, !viewRef)
  !!ce = !dimLayerRef[1]
  handle any
    return
  endhandle

  !spoolDim = object PIPESPOOLDIMENSION()
  !spoolDim.dimOptions = !parameter
  !spoolDim.spoolRef   = !spoolRef

  !spoolDim.createDimension(!viewRef)
endfunction
