--
-- Description:
-- Function to do a Data Consistency Check (added to the valid pipe spool check)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--      1     R     STRING     Pipe element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Is the pipe valid to datacon
------------------------------------------------------------------------
-- Define function
define function !!pipeValidDataCheck(!element is STRING) is BOOLEAN
  !errorOfInterest = false

  CHECK $!element !unusedElementList !errorList
  -- We are only interested in error codes 22-55, 57, 63-84, 87, 89-91
  do !i indices !errorList
    !error[!i] = !errorList[!i].split()
    do !j indices !error[!i]
      if (!error[!i][!j].real().between(22, 25)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().between(27, 31)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().between(33, 34)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().between(36, 52)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().between(54, 55)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().eq(57)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().between(63, 84)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().eq(87)) then
        !errorOfInterest = true
      elseif (!error[!i][!j].real().between(89, 91)) then
        !errorOfInterest = true
      endif
      if (!errorOfInterest) then
        break
      endif
    enddo
    if (!errorOfInterest) then
      break
    endif
  enddo

  !validDataCheck = !errorOfInterest.not()
  return !validDataCheck

-- List of datacon messages we are interested in for Spools
-- *******************************************************************************************************

-- 22 - REFERENCE SPREF UNSET'
-- 23 - REFERENCE SPREF REFERS TO A NON-EXISTENT SPCOM'
-- 24 - SPREF PROBLEM, CATREF IN SPCOM IS UNSET'
-- 25 - SPREF PROBLEM, CATREF IN THE SPCOM REFERS TO NON-EXISTENT<cr>#SCATALOGUE COMPONENT'
-- 26 - SPREF PROBLEM, GTYPE OF CATALOGUE COMPONENT IS NOT SAME AS TYPE<cr>#SOF DESIGN DATA COMPONENT'
-- 27 - ANGLE OF COMPONENT IS LESS THAN MINIMUM ANGLE<cr>#SSPECIFIED IN SPREF'
-- 28 - ANGLE OF COMPONENT IS GREATER THAN MAXIMUM ANGLE<cr>#SSPECIFIED IN SPREF'
-- 29 - CATREF PROBLEM IN ACCESSING P-POINTS FOR #F'
-- 30 - ARRIVE P-POINT NOT IN PTSET OF CATALOGUE COMPONENT'
