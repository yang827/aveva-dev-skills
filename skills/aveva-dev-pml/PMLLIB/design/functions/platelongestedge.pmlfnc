--
-- Author:          N.Holmes
-- Created:         Fri Feb 14 18:10:34 GMT 1997
--
--
-- Description:
-- Reorientates all element beneath a panel/plate so that its
-- orientation is the same as the longest edge.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel Name
-- Return:
--   [Data Type] [Description]
--    STRING      Returned message
--
------------------------------------------------------------------------

-- Define function
define function !!plateLongestEdge (!panel is DBREF) is STRING

  -- Initialise Variables
  !returnString = 'Aborted plate longest edge detection.'

  -- Check we have passed a PANEL
  if(!panel.type neq 'PANE') then
    !!alert.error('Element ' & !panel & ' is not a panel.')
    return !returnString
  endif

  -- Prompt
  !name = !panel.name
  PROMPT 'Processing $!name'

  -- Direction of Panel
  !yDir         = !panel.ori.yDir().wrt(!panel)
  !xDir         = !panel.ori.xDir().wrt(!panel)

  -- Panel Plane
  !plane           = object VECTOR()
  !plane.direction = !panel.ori.zDir().wrt(World)
  !plane.position  = !panel.pos.wrt(World)

  -- May be a better way of getting ploop
  !ploop        = (PLOOP 1 of $!panel )

  -- Collect all Paves' for loop
  !paves        = !!collectAllFor('PAVE','',!ploop)

  -- Extract all positions from Paves
  !block        = object BLOCK('!paves[!evalIndex].pos')
  !positions    = !paves.evaluate(!block)

  -- Lengths of Edges
  !lengths      = !!loopEdgeLengths(!positions)

  -- Sort lengths into descending order (OLD FORMAT) should be
  -- replaced at 11.2 with
  !array        = !lengths.sortedIndices()
  !array.invert()

--  var !sort sort !lengths numeric descending
--  !block        = object block('!sort[!evalIndex].real()')
--  !array        = !sort.evaluate(!block)

  -- Get Direction of Edge for Item & align edge direction against
  -- the Panel plane
  !edgeDir      = !!vertexEdgeDir(!paves[!array[1]])
  !edgeDir      = !!directionOnPlane(!edgeDir,!plane).wrt(!panel)

  -- Angle plate need orientating
  !xAngle        = !!angleFrom2Dirs(!xDir, !edgeDir)
  !yAngle        = !!angleFrom2Dirs(!yDir, !edgeDir)
  !angle         = !yAngle

  if(!xAngle lt 90) then
    !angle = !angle * -1
  endif

  if(!angle.nint() eq 0 or !angle.nint().abs() eq 180) then
    !returnString = 'No need to re-orientate.'
    return !returnString
  else
    !returnString = 'Re-Orientated by ' & !angle & 'degrees.'
  endif

  -- Rotate about Z axes of Panel
  call !!rotateExtrusion(!panel, !angle)
  handle any
    !returnString = !!error.text
  endhandle

  return !returnString

endfunction
-- End of function definition for !!plateLongestEdge
