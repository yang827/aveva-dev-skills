--
--
-- Description:
-- function to call standard positioning form for positioning panel fitting
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!plt3DPospFit()

-- Load associated form, if not loaded
  if(undefined(!!pos3D)) then
    pml reload form !!pos3D
  endif

  -- get element owner type pane/floor if not at a fitting

  !form = !!cdPfitSpec
  !item = !form.ceName.val.dbRef()
  handle any
    -- in create mode therefore put position at owner origin
    !softTypes = !!dtbSoftTypes.stringSTypesFor('PANE')
    !softTypesTemp = !softTypes & ' BPANEL'
    !softTypes = !softTypesTemp
    !item      = !!dtbGetOwnerType(!!ce,!softTypes)
  endhandle

    if (unset(!item)) then
     !!alert.error('Fitting Unset')
     return
    endif
    !prompt     = 'Pick Fitting Position'
    !screenText = 'Through Position'

    !position   = !item.position.wrt(worl)

  -- Show standard basic position definition
    !!pos3D.edit('!!pltSetOldForm(!!pos3D.positionData.position)', !position, !prompt, !screenText, false, 'Position Panel Fitting')


endfunction
-- End of function definition for !!plt3DPospFit
