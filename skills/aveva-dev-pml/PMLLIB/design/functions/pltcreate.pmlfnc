-- Created:         Wed Aug 26 10:34:44 BST 1998
--
--
-- Description:
-- generic panel creation function
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type to create (must be hardtype of PANEL
--    2   R      STRING      Storage area GROUP
--    3   R      STRING      Storage area AREA
--    4   R      STRING      Spec key
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pltCreate(!type is STRING, !group is STRING, !area is STRING, !key is STRING)

  -- load the panel creation form
  if (undefined(!!pltCreate)) then
    pml load form !!pltCreate
  endif

  -- set form members
  !!pltCreate.elementType  = !type
  !!pltCreate.group        = !group
  !!pltCreate.area         = !area
  !!pltCreate.specKey      = !key

  -- Show forms
  if (!!pltCreate.shown()) then
    !!pltCreate.initialise()
  else
    show !!pltCreate
  endif

endfunction
-- End of function definition for !!pltCreate
