--
-- Description:
-- function to pass edg argument information from pltvertexcusor to
-- MVERT for vertex creation (Panels)
------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Return:
--   [Data Type] [Description]
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if we are going to create a vertex
--    2   R      POSITION    New /Modify Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!pltLoopVertex (!createFlag is BOOLEAN, !position is POSITION)

 $M "%PDMSUI%/DES/PANEL/MVERT" $<$!createFlag$> $<$!position$>

endfunction
-- End of function definition for !!pltLoopVertex
