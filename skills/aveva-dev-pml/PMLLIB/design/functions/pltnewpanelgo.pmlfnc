--
--
-- Description:
-- Create new panel and display 2D-constructor
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!pltNewPanelGo()

  !!pltNewPanel.tidy()

  -- Now create the panel
  call !!sctlCrElem(!!pltNewPanel.extruType, |PANDP| )

  -- Save the justification and representation
  if ( !!pltNewPanel.just.selection() eq 'Top' ) then
      if (!!pltNewPanel.extruType eq 'PANE') then
           SJUST DTOP
      else
           !!ce = !!ce.owner
           !value = !!ce.height
           BY D $!value WRT OWNER
           !!ce = LOOP 1
      endif
  elseif( !!pltNewPanel.just.selection() eq 'Centre' ) then
      if (!!pltNewPanel.extruType eq 'PANE') then
           SJUST DCEN
      else
           !!ce = !!ce.owner
           !value = !!ce.height / 2
           BY D $!value WRT OWNER
           !!ce = LOOP 1
      endif
  endif

  if (!!pltNewPanel.extruType eq 'PANE' and Set(!!ce.spre) and Set(!!ce.spre.tmpr) ) then
  -- template
  else
  -- non-template
       !!ce = !!ce.owner
  endif
  -- Set the position
  !posString = !!pltNewPanel.points[1].string()
  POS $!posString

  -- Set the orientation
  !oriString = !!pltNewPanel.plane.orientation.string()
  ORI $!oriString

  -- If it is a template
  if (!!pltNewPanel.extruType eq 'PANE' and Set(!!ce.spre) and Set(!!ce.spre.tmpr) ) then
    -- Set design parameters
    var !!cdcaAttr DELETE
    var !!cdcaAttd DELETE
    var !!cdcaDesp DELETE
    var !!cdcaPass DELETE
    !!cdcaPass[1] = 'Set Template Parameters'
    !!cdcaPass[2] = 'CALLCIV MPANELTMPL'
    !!cdcaPass[3] = ''
    $m "%PDMSUI%/DES/CLIB/XSETPROP" $<DEFINE$> $<$!!<ce.spre>$> $<!!cdcaPass$> $<$!!<ce>$>

  else
    -- Otherwise bring up vertex editor
       if (!!pltNewPanel.extruType eq 'PANE' ) then
            !!ce = PLOO 1
       else
            !!ce = LOOP 1
       endif
  -- Use the points already given
       if (!!pltNewPanel.create.val ) then
            do !vertex values !!pltNewPanel.points
                 !posString = !vertex.wrt(!!ce.owner).string()
                 if (!!pltNewPanel.extruType eq 'PANE' ) then
                     NEW PAVE
                 else
                     NEW VERT
                 endif
                 POSITION $!posString
            enddo
            if (!!pltNewPanel.extruType eq 'PANE' ) then
                     !!ce = PLOO 1
                 else
                     !!ce = LOOP 1
                 endif
      endif
      call !!sctlPaveShow(!!ce.owner, !!ce.owner.position, !!ce.owner.ori, 'CREATE')

  endif

endfunction
-- End of function definition for !!pltNewPanelGo
