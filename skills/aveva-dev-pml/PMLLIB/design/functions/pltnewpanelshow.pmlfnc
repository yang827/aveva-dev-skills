--
--
-- Description:
-- Show the PltNewPanel Form and set up event driven graphics
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Type i.e  PANEL, NEXTR
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!pltNewPanelShow(!type is STRING)

-- show form
show !!pltNewPanel

!!pltNewPanel.extruType = !type

if (!type eq 'PANE' ) then
     !!pltNewPanel.formTitle     = 'Create Panel'
elseif (!type eq 'NXTR' ) then
     !!pltNewPanel.formTitle     = 'Create Negative Extrusion'
elseif (!type eq 'REVO' ) then
     !!pltNewPanel.formTitle     = 'Create Solid of Revolution'
elseif (!type eq 'NREV' ) then
     !!pltNewPanel.formTitle     = 'Create Negative of Revolution'
else
     !!pltNewPanel.formTitle     = 'Create Extrusion'
endif

-- set up event driven graphics to three point mode
!!pltNewPanel.threePick()

!!pltNewPanel.methodrg.val = 2

!!pltNewPanel.create.val = True

endfunction
-- End of function definition for !!pltNewPanelShow
