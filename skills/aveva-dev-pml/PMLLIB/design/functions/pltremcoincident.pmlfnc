-- Author:          N.Holmes
-- Created:         Thu Aug 13 12:05:20 BST 1998
--
--
-- Description:
-- Removes coincident points of the passed panel.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pltRemCoincident(!element is DBREF)

  -- Initialise Variables
  !deleteList = ARRAY()

  -- If not at panel/extrusion
  if(not !element.hardType inset('PANE', 'EXTRU')) then
    !!alert.warning('This utility can only be used on extrusion loops.')
    return
  endif

  -- Get Loop or Ploop
  !loop   = PLOOP 1 of $!<element>
  handle any
    !loop = LOOP  1 of $!<element>
  endhandle

  -- Reference Plane
  !plane        = object PLANE(!element.position, !element.orientation)

  -- Get first position
  !previous = !plane.near(!loop.member[1].position)

  -- Go through loop members and remove co-incident
  do !i from 2 to !loop.mCount

    -- Get position
    !position = !plane.near(!loop.member[!i].position)
    !distance = !previous.distance(!position)
    if(!distance lt 0.01mm) then
      !deleteList.append(!loop.member[!i])
    endif
    !previous = !position

  enddo

  -- Loop through delete list and remove the co-incident points
  do !i indices  !deleteList

    !!ce  = !deleteList[!i]
    !type = !deleteList[!i].type
    DELETE $!<type>
  enddo

  !!ce = !element

endfunction
-- End of function definition for !!pltRemCoincident
