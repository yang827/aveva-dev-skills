--     Keyword:     PLATE
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Tue Oct 20 17:27:22 BST 1998
--
--
-- Description:
-- function to call standard positioning form for positioning panel fitting
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [POSITION]  [Position to put fitting]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pltSetOldForm(!position is POSITION)

  -- get owning level

    !softTypes = !!dtbSoftTypes.stringSTypesFor('PANE')
    !softTypesTemp = !softTypes & ' BPANEL'
    !softTypes = !softTypesTemp
    !owner     = !!dtbGetOwnerType(!!ce,!softTypes)
    !newPosition = !position

    if(!owner.type.neq('BPANEL'))then
    	!plane     = object PLANE(!owner.position.wrt(worl), !owner.orientation.wrt(worl))
    	!newPosition = !plane.near(!position)
    else
    	-- Keep picked position, do not map to owners plane
    	!newPosition = !position.wrt(worl)
    endif

    !formd              = !!cdPfitSpecD
    !form               = !!cdPfitSpec
    !formd.posStore.val = !newPosition.string(!!distanceFmt)
    !form.posStore.val  = !newPosition.string()
    !formd.position     = !newPosition
    !form.position      = !newPosition

     !aid = !!aidNumbers.add('New Position')
     AID TEXT NUMBER $!<aid> 'New Position' AT $!<newPosition>
     !formd.aidNumber.val = '$!aid'

endfunction
-- End of function definition for !!pltSetOldForm
