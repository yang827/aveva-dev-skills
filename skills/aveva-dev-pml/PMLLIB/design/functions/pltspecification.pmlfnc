-- File:            pltspecification.pmlfnc
--   Type:          Function Definition
--   Group:         Panel :group: Plate Application
--     Keyword:     PLATE
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Sep 3 13:40:59 BST 1998
--
--
-- Description:
-- Determine the form for modifying the panel thickness.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of specification PLATE or FLOOR
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pltSpecification(!type is STRING)

   -- Build specification form
   if(undefined(!!pltSpecification)) then
     pml load form !!pltSpecification
   endif

  -- Plate Invocation
  if(!type.upcase() eq 'PLATE') then
    !!pltSpecification.defaultPlate()

  -- Floor Invocation
  elseif (!type.upcase() eq 'FLOOR') then
    !!pltSpecification.defaultFloor()

  endif

endfunction
-- End of function definition for !!pltSpecification
