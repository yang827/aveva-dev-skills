--   Group:         Panel :group: Plate Application
--     Keyword:     PLATE
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Sep 3 13:40:59 BST 1998
--
--
-- Description:
-- Determine the form for modifying the panel thickness.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of specification PLATE or FLOOR
--    2   R      DBREF       Element to set thickness on
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pltThickness(!type is STRING, !element is DBREF)

  -- Check type

  -- Get "PANE" of passed item
  !types[1]      = 'PANE'
  !types[2]      = 'FLOOR'
  !types[3]      = 'SCREED'
  !panel    = !!dtbOwnerOfTypes(!element, !types)

  if(!panel.unset()) then
    !!alert.warning('This function can only be used on a PANEL or one of its soft types.')
    return
  endif

  -- Plate Invocation
  if(!type.upcase() eq 'PLATE') then

    -- Show specification form
    if(undefined(!!pltSpecification)) then
      pml load form !!pltSpecification
    endif

    -- Show form
    !!pltSpecification.setPlate(!panel)

  -- Floor Invocation
  elseif(!type.upcase() eq 'FLOOR') then

    -- Show specification form
    if(undefined(!!pltSpecification)) then
      pml load form !!pltSpecification
    endif

    -- Show form
    !!pltSpecification.setFloor(!panel)

  endif

endfunction
-- End of function definition for !!pltThickness
