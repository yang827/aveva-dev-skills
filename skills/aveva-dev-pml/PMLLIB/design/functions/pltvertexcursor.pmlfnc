--
--
-- Description:
-- function to introduce Event Driven Graphics cursor picking
-- for vertex creation (Panels)
-----------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Return:
--   [Data Type] [Description]
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True if we are going to create a vertex
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!pltVertexCursor (!createFlag is BOOLEAN)


  -- Define Mode Prompt
  if(!createFlag) then
    !prompt = 'Create vertex'
  else
    !prompt = 'Modify vertex'
  endif

  -- Define Packet
  !packet             = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.action      = 'call !!pltLoopVertex(' & !createFlag & ', !this.return[1].position)'
  !packet.key         = 'vertexEditCursor'
  !packet.type        = 'VertexEdit'
  !packet.priority    = 1
  !packet.remove      = false
  !packet.description = 'Vertex Edit'

  !!edgCntrl.add(!packet)


endfunction
-- End of function definition for !!pltVertexCursor
