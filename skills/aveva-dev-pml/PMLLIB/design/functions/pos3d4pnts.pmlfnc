--
--
-- Description:
-- Returns 3d intersection of lines between point1-point2 and point3-point4
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION        Position 1
--    2    R     POSITION        Position 2
--    3    R     POSITION        Position 3
--    4    R     POSITION        Position 4
-- Return:
--   [Data Type] [Description]
--    POSITION    Intersect Position
--
------------------------------------------------------------------------

-- Define function
define function !!pos3D4Pnts(!pnt1 is POSITION,!pnt2 is POSITION,!pnt3 is POSITION,!pnt4 is POSITION) is POSITION

!line1 = !!lineFromTo(!pnt1,!pnt2)
!line2 = !!lineFromTo(!pnt3,!pnt4)
!intersect = !!pos3DLineLine(!line1,!line2)

return !intersect

endfunction
-- End of function definition for !!pos3D4Pnts
