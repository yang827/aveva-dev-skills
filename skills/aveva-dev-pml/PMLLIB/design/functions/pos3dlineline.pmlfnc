--
-- File:            pos3dlineline.pmlfnc
--   Type:          Function Definition
--   Group:         3d positioning
--     Keyword:     POS
--   Module:        design
--   Replaces:      const pos inter <line> <line>
--
-- Author:          A.Johnson
-- Created:         Tue Apr 22 11:33:39 BST 1997
--
--
-- Description:
-- Function to return position of intersection of two lines
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VECTOR      Line
--    2   R      VECTOR      Line
-- Return:
--   [Data Type] [Description]
--    POSITION    Intersection of the supplied lines
--
------------------------------------------------------------------------

-- Define function
define function !!pos3DLineLine(!line1 is VECTOR,!line2 is VECTOR) is POSITION

!line1Str  = 'Line ' & !line1.direction & ' Thro ' & !line1.position
!line2Str  = 'Line ' & !line2.direction & ' Thro ' & !line2.position
var !pos CONST POS INTER $!line1Str  $!line2Str

return !pos.position()

endfunction
-- End of function definition for !!pos3DLineLine
