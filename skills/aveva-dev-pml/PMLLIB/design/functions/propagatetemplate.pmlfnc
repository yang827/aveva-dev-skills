--
-- Author:          malcolm.barlow
-- Created:         Thu January 30 12:00:00 GMT 2007
--
-- Description:
-- Update the given Design Template Instance, forcing any changes to the Design
-- Template definition to be made to the instance
-- This function can be used for batch updates
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design Template instance DBREF
-- Return:
--   [Data Type] [Description]
--    COMPROPERROR  Common properties error object containing errors logged
--                  during this propagate operation
--
------------------------------------------------------------------------

define function !!propagateTemplate(!templateInstance is DBREF) is COMPROPERROR

-- Initialise Variables
  -- create an error object to log any errors found during the update
  !errorObject = object COMPROPERROR()

  if( badref(!templateInstance) ) then
    -- handle bad input argument
    !errorObject.addError('FAIL')
    !errorObject.setErrorText('Cannot access element - bad reference')
    !errorObject.setErrorContext('Find update element')
    return !errorObject
  endif

  -- update the Design Template Instance
  !instanceObject = object COMPROP(!templateInstance)
  handle any
    !errorObject.addError('FAIL')
    !errorObject.setErrorText(!!error.text)
    !errorObject.setErrorContext('Read element Properties')
    !errorObject.setErrorCommand(!!error.command)
    !errorObject.setErrorLine(!!error.line)
  elsehandle none
    -- tell the instanceObject to force changes to the Design
    -- Template definition to be made to the instance
    !errorObject = !instanceObject.propagateChanges()
  endhandle

  -- delete the object
  !instanceObject.delete()
  handle any
  endhandle

  return !errorObject

endfunction
-- End of function definition
