--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!reDefStart(!startOrEnd is BOOLEAN)

 if(!startOrEnd) then
   !!aslSpec.reDefEnd.val = !!aslSpec.reDef.val.not()
-- only reset start if form shown
   if(!!aslSpec.shown()) then
      !!aslSpec.startPos = object EDGDATA()
   endif
  if(!!aslSpec.mode.selection('Rtext') eq |CREATE|) then
     !!aslSpec.startPos = object EDGDATA()
     !!aslSpec.endPos   = object EDGDATA()
     !!edgGeomPrmpt('ASL Picking','Define First WP : ', '')
--   !!edgGeomPrmpt('ASL Picking','Define First WP : ','')
     !!aidClear(|ALL|,|ALL|)
     !!aslSpec.firstWpFix.val = False
     !!aslWpLock(!!aslSpec.firstWpFix,'First')

-- Clear start and end positional gadgets
     !!load3Ddata(!!aslSpec.startPos.pos,|Start|)
     !!load3Ddata(!!aslSpec.endPos.pos,|End|)
-- reset form to create
 --     !!aslSpec.ceName.val = |New Section |
      !!aslSpec.mode.select('Rtext','CREATE')
  endif
    !!clearColour(!!aslSpec.eval)
   -- if(!!aslSpec.whichPick.val eq |Point2Point|) then
    --   !!whichPick(!!aslSpec.pt2pt,false,false,'RED')
   -- endif
 else
-- modify second WP
   !!aslSpec.reDef.val = !!aslSpec.reDefEnd.val.not()
-- set start.item to ce (dummy for now - eventually connected item)
   !!aslSpec.startPos.item = !!ce
 endif
endfunction
-- End of function definition for !!reDefStart
