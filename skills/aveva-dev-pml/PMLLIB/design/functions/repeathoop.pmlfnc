--
--
-- Description:
-- Function to repeat hoops, specific to a tmpl.
--
------------------------------------------------------------------------

define function !!repeatHoop()

  -- at sctn owning tmpls
  !asl = REFE

  var !riser COLLECT ALL WITH FUNC EQ 'Repeat' FOR CE
  var !rItem COLLECT ALL WITH (FUNC EQ 'Master Repeat')  FOR CE

  if(undefined(!rItem[1])) then
    error |Hoops cannot be repeated, check template setup.|
  endif

  -- for one repeat at the moment
  do !i indices !rItem
    !elementRef = !rItem[!i].dbRef()
    !rItem[!i].delete()
    !rItem[!i] = !elementRef
    !!ce = !rItem[!i]    $* goto repeat item, and get rule info for repetition

    var !tmpl TMPL
    var !type HARDTYPE
    !orrf = !rItem[1].orrf

    var !attr  DEPR ATTR
    handle any
      error |Repeat element does not have required ddse's|
      skip
    endhandle

    var !noff  LDPR NOFF
    var !rule  DEPR RULE
    var !dist  (DIST(REAL(DEPR DIST)))

    -- repeat riser !rnum of times
    if (arraySize(!riser) gt 1) then $*-- use existing treads
      var !del COLLECT ALL  WITH (FUNC EQ 'Repeat') FOR $!tmpl

      do !d indices !del
        $!del[$!d]
        DELETE $!type      $*-- delete for now but should use existing
      enddo
    endif

    !!ce = !rItem[!i] $*-- make sure creation is after repeat for rules to work

    var !flnm FLNM
    LAST
    do !j to $!noff
      NEW $!type COPY  $!rItem[$!i] $* cant use like
      ORRF $!orrf
      FUNC 'Repeat'
      $!attr $!rule ($!dist  * $!j) WRT $!flnm $* $!rItem[$!i]
      if(upc(|$!attr|) eq |POSS|) then
        RULE SET POSE ($!rule ($!dist  * $!j) FROM ATTRIB POSE OF $!flnm )
        RULE SET POSS ($!rule ($!dist  * $!j) FROM ATTRIB POSS OF $!flnm )
      else
        RULE SET $!attr ($!rule ($!dist  * $!j) WRT $!flnm ) $* $!rItem[$!i]
      endif
      var !numb ($!j + 1 )
      NUMB ($!numb)
    enddo
  enddo

  -- return to ASL component
  !!ce = !asl

endfunction
-- End of function definition for !!repeatHoop
