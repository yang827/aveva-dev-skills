--
--
-- Description:
--
-- Function to repeat treads on a stair, specific to a tmpl.
--
------------------------------------------------------------------------

define function !!repeatRung()

  -- at sctn owning tmpls
  !stair = REFE

  -- properties of the stair
  -- these may come from the defaults area
  var !lenOld  DER LENG
  !leng = $!lenOld
  !leng = (!leng - (REAL(PROP RDIA) / 2) ) $* specific to this ladder
  var !step  (DIST(REAL(PROP STEP))) $* dist function in case inches
  var !angle  (PROP ANGL)
  handle any
    var !angle (90) $* for vertical ladders
  endhandle

  !riser = !!collectAll(||, |FUNC EQ 'Repeat'|,|TMPL 1 OF CE|)
  var !rItem COLLECT ALL WITH (FUNC EQ 'Master Repeat') FOR TMPL 1 OF CE
  !tstep = ($!step / SIN ($!angle)) $* true step dist

  !rnum  = (int (!leng  / !tstep))

  if(undefined(!rItem[1])) then
    error |Rungs cannot be repeated, check template setup.|
  endif

  -- for one repeat at the moment
  !!ce = !rItem[1].dbRef() $* goto repeat item, and get rule info for repetition
  var !tmpl TMPL
  var !type HARDTYPE
  -- the orrf is required for  for each repeat for the update
  !orrf = !rItem[1].dbRef().orrf

  -- repeat riser !rnum of times
  if (arraySize(!riser) gt 1) then $*-- use existing treads
    var !del COLLECT ALL  WITH (FUNC EQ 'Repeat') FOR $!tmpl
    do !d indices !del
      $!del[$!d]
      DELETE $!type      $*-- delete for now but should use existing
    enddo
  endif

  --  first rung exists set rule
  $!rItem[1]

  --  Rule set poss ( S ( ATTRIB CDPR LWID / 2 ) U ( ATTRIB CDPR RDIA / 2 ) )
  --  Rule set pose ( N ( ATTRIB CDPR LWID / 2 ) U ( ATTRIB CDPR RDIA / 2 ) )
  --  commented out (I don't think this part is necessary) ak

  -- create the rest
  -- at the bottom of the list because of rules pointing to sctns
  -- already in the list
  LAST

  do !i to !rnum
    var !ntrd ($!i)

    NEW $!type COPY  $!rItem[1] $* cant use like
    var !flnm FLNM OF $!rItem[1]
    ORRF $!orrf
    FUNC 'Repeat'
    RULE SET POSE (D ($!ntrd  * $!tstep) FROM ATTRIB POSE OF $!flnm )
    RULE SET POSS (D ($!ntrd  * $!tstep) FROM ATTRIB POSS OF $!flnm )

    --Rule set poss ( S ( ATTRIB CDPR LWID / 2 ) U  ($!ntrd * $!tstep) e (cdpr land))
    --Rule set POSE ( N ( ATTRIB CDPR LWID / 2 ) U  ($!ntrd * $!tstep) e (cdpr land))
    var !numb ($!ntrd + 1 )
    NUMB ($!numb)
  enddo

  -- return to stair
  $!stair

endfunction
-- End of function definition for !!repeatRung
