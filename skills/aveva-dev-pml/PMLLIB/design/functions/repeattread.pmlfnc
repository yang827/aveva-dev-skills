define function !!repeatTread()

  -- Initialise Variables
  -- at the sctn of the stair
  var !stair REFE

  -- properties of the stair
  -- these may come from the defaults area
  var !leng DER LENG
  var !angle ABS(REAL(PROP ANGL))
  var !riser COLLECT ALL SCTN WITH GTYPE EQ 'REPT'  FOR TMPL 1 OF CE
  var !rItem COLLECT ALL SCTN WITH (GTYPE EQ 'REPT' AND NUMB EQ 1)  FROM !riser
  var !tstep (REAL (PROP STEP) / SIN (REAL (PROP ANGL))) $* true step dist
  var !tlen ($!leng - ((REAL (PROP DEPT OF SCTN 1 OF TMPL 1) / 2) / TAN (REAL (PROP ANGL)) + (REAL (PROP STEP) / SIN (REAL (PROP ANGL)))))
  var !rnum ((INT ($!tlen / $!tstep)) - 1)
  var !nstep ($!leng / $!rnum)

  if(undefined(!rItem[1])) then
    error |Rungs cannot be repeated, check template setup.|
  endif

  $!rItem[1]    $* goto repeat item, and get rule info for repetition
  var !tmpl TMPL

  -- repeat riser !rnum of times
  if (arraySize(!riser) gt 1) then $*-- use existing treads
    var !del COLLECT ALL SCTN WITH NUMB NEQ 1 AND GTYP EQ |REPT| FOR $!tmpl
    do !d indices !del
      $!del[$!d]
      DELETE SCTN      $*-- delete for now but should use existing
    enddo
  endif

  --  first rung exists set rule
  var !rcnt ABS($!rnum - 1)
  $!rItem[1]
  var !orrf ORRF
  RULE SET POSS (W(CDPR WIDTH / 2 ) S(RPRO DEPT OF SCTN 1  / 2 ) U(RPRO DEPT OF SCTN 1  / 2 / TAN (CDPR ANGL) + ($!nstep))) $* CDPR STEP / SIN (CDPR ANGL)))
  RULE SET POSE (E(CDPR WIDTH / 2) S(RPRO DEPT OF SCTN 1  / 2 ) U(RPRO DEPT OF SCTN 1  / 2 / TAN (CDPR ANGL) +  ($!nstep))) $* CDPR STEP / SIN (CDPR ANGL)))

  -- create the rest
  do !i to $!rcnt
    var !ntrd ($!i + 1)
    NEW SCTN COPY LIKE $!rItem[1] $* BY U ($!tstep * $!ntrd) BANG ($!angle - 180)
    ORRF $!orrf
    RULE SET POSS (W(CDPR WIDTH / 2 ) S(RPRO DEPT OF SCTN 1  / 2 ) U(RPRO DEPT OF SCTN 1  / 2 / TAN (CDPR ANGL) + ABS($!ntrd * $!nstep)))        $* CDPR STEP / SIN (CDPR ANGL))))
    RULE SET POSE ( E( CDPR WIDTH / 2 ) S(RPRO DEPT OF SCTN 1 / 2 ) U(RPRO DEPT OF SCTN 1  / 2 / TAN (CDPR ANGL) + ABS($!ntrd * $!nstep))) $*CDPR STEP / SIN (CDPR ANGL))))
    NUMB ($!ntrd)
  enddo

  -- return to stair
  $!stair

endfunction
-- End of function definition for !!repeatTread
