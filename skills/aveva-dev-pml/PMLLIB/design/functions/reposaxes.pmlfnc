--
--
-- Description:
-- Function to re-position aid axes for position changes
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!rePosAxes(!whichEnd is STRING)

 if(!whichEnd eq |Start|) then
   !aidNo = |15003|
   !dText = |First WP|
   !pos   = !!aslSpec.startPos.pos
 else
   !aidNo = |15004|
   !dText = |Second WP|
   !pos   = !!aslSpec.endPos.pos
 endif

-- clear aids from graphics
     !!aidClear(!aidNo,|ALL|)
     !!aidClear(|15004|,|LINE|)
-- Reposition Axes
     !no = !aidNo.real()
     !!aidAxes(!no, !dText, !pos, 500)

 -- Construct line between start and end
     !!aidLine(15004, !!aslSpec.startPos.pos,  !!aslSpec.endPos.pos)

endfunction
-- End of function definition for !!rePosAxes
