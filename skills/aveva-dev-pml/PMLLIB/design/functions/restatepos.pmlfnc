-- Author:          A.Kirkland
-- Created:         Wed Mar 19 16:38:33 GMT 1997
--
--
-- Description:
-- Read positional gadgets with 3D pos data and
-- pass back to position from objects
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [Gadget - Direction position Value]
--   [2] [R]    [GADGET]    [Gadget - Position Value Distance]
--   [3] [RW]   [REAL]      [Gadget Object For Position]
--   [4] [R]    [STRING]    [Start or end]
--   [5] [RW]   [REAL]      [Gadget - Angle of ASL Component]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!reStatePos(!dirGad is GADGET, !valGad is GADGET,!posVal is REAL,!whichEnd is STRING,!dummyAngle is REAL)

  -- Get new value
  !dir = !dirGad.selection('Rtext')
  !val = !valGad.val.real()
  if(!dir eq |-|) then
     !val = (!val * -1)
  endif

  -- Pass new value to Position object
  !posVal = !val

  -- Recalculate Angle
  !plane = object VECTOR()
  !plane.direction = U
  !plane.position = !!aslSpec.endPos.pos
  !aslDir = !!directionFromTo(!!aslSpec.startPos.pos, !!aslSpec.endDerPos)

  -- in case modify mode
  handle any
    !aslDir = !!directionFromTo(!!aslSpec.startPos.pos, !!aslSpec.endPos.pos)
  endhandle

  -- Calculate angle and direction of picked points (When Point2Point)
  !calcAngle = !!getAngPlanePts(!plane, !!aslSpec.startPos.pos)
  !!aslSpec.angle.val = !calcAngle.abs()

  -- And now direction
  !aslDir = !!directionFromTo(!!aslSpec.startPos.pos, !!aslSpec.endPos.pos)
  !newDir = !!directionOnPlane(!aslDir,!plane)

  -- when a vertical ladder don't put calculated dir in form
  if(!newDir neq D wrt /* and !newDir neq U wrt /* ) then
    !!aslSpec.direction.val = !newDir
  endif

  -- Display new axes
  !!rePosAxes(!whichEnd)

  -- Remove colour from pick to avoid confusion
  !!aslSpec.pt2pt.background = 205
  !!aslSpec.ptNrm.background = 205
  !!aslSpec.ptLev.background = 205

endfunction
-- End of function definition for !!reStatePos
