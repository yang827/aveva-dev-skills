-- File:            rotateextrusion.pmlfnc
--   Type:          Function Definition
--   Group:         Panel :group: Plate Application
--     Keyword:     PLATE
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Feb 5 16:51:11 GMT 1997
--
--
-- Description:
-- Rotates vertices of a loop about the axes of the owning loop.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Extrusion/Panel to be rotated
--    2   R      REAL        Angle of rotation about the origin
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!rotateExtrusion (!pExtrusion is DBREF, !angle is REAL)

  -- If the angle is zero, then we don't need to do anything
  if(!angle eq 0) then
    return
  endif

  -- Initialise Variables
  !currentItem = !!ce

  -- Get Panel/Extrusion
  !extrusion   = (PANE of $!pExtrusion )
  handle any
    !extrusion = (EXTRU of $!pExtrusion )
    handle any
      !!alert.error('Can only rotate a Extrusion or Panel.')
      return
    endhandle
  endhandle

  -- Collect all Members of Extrusion
  !allMembers = !!collectMembersOf(!extrusion, 'TYPE ne |LNKS|')
  !members    = !!collectMembersOf(!extrusion, 'TYPE ne |LNKS| and TYPE ne |PLOO| and TYPE ne |LOOP| and TYPE ne |PALJ|')

  -- Get Difference between the allMembers and members without vertices
  !modMembers = !allMembers.difference(!members)

  -- Get all vertices for the ModMembers
  do !i indices !modMembers
    !members.appendArray(!!collectAllFor('VERT PAVE', '', !modMembers[!i]))
  enddo

  -- Collect all the position of the vertices wrt World
  !block      = object BLOCK('!members[!evalIndex].pos.wrt(World)')
  !positions  = !members.evaluate(!block)

  -- Get All Beta Angles for items
  !block      = object BLOCK('!members[!evalIndex].bang')
  !bAngle     = !members.evaluate(!block)

  -- Move to loop item
  !!ce       = !extrusion

  ROTATE THROUGH $!extrusion ABOUT Z WRT $!extrusion BY $!angle
  handle any
    !!ce = !currentItem
  endhandle

  -- Loop through all vertices and re-position
  do !i indices !members

    !!ce = !members[!i]
    AT $!positions[$!i]

    -- If we are at a none PAVE or VERT, then we want to re-orientate the
    -- item back to its original orientation
    if (!!ce.type ne 'PAVE' and !!ce.type ne 'VERT') then

      -- Get the BANG and subtract the Angle of rotation
      !bang  = !bAngle[!i] - !angle
      BANG $!bang
    endif

  enddo

  -- Return back to current element
  !!ce = !currentItem

endfunction
-- End of function definition for !!rotateExtrusion
