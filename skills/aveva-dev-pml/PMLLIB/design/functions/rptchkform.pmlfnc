--
--
-- Description:
-- Goes through the gadgets of the form to make sure they are correct.
-- This is usually done when a report is requested (Apply button is
-- pressed on Quick Report form).
--
-- Repeatedly calls !!rptSelect() to check each gadget in turn.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form to apply checks to.
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if all gadgets are valid.
--
------------------------------------------------------------------------

define function !!rptChkForm(!form is FORM) is BOOLEAN

  if(!form.name() eq 'RPTQUICK') then
    !bResult1 = !!rptSelect(!form.sort)

  elseif(!form.name() eq 'RPTMAIN') then
    -- Special stuff for main reports form
    -- *future development*
  endif

  -------------------------------------
  -- Check common gadgets
  -------------------------------------

  !bResult2 = !!rptSelect(!form.filename)
  !bResult3 = !!rptSelect(!form.type)
  !bResult4 = !!rptSelect(!form.with)
  !bResult5 = !!rptSelect(!form.hierarchy)


  !bResult = !bResult1 AND !bResult2 AND !bResult3 AND !bResult4 AND !bResult5

  return !bResult

endfunction
-- End of function definition for !!rptChkForm
