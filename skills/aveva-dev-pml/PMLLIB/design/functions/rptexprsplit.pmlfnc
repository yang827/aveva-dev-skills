--
-- File:            rptexprsplit.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     RPT
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Fri Aug 8 11:46:48 BST 1997
--
--
-- Description:
--
-- Does the same as the Split() function but takes into account expressions in
-- brackets. Example: 'name owner (position in site)' will give
--                     Array[1] = 'name'
--                     Array[2] = 'owner'
--                     Array[3] = '(position in site)'
--
-- HOW: It splits the whole string, then loops through each element of
-- the array created to find '(' chars. When found, it builds up a string
-- until the ')' char is found. It then adds that as normal to the return
-- array. It can handle to multiple sets of brackets e.g.
--  '(name) owner (position in site)'
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The string with '(' & ')' in it.
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       the string split into its components.
--
------------------------------------------------------------------------

define function !!rptExprSplit(!wholeString is STRING) is ARRAY

  !returnArray = ARRAY()
  !tempArray   = ARRAY()
  !count       = REAL()
  !flag        = BOOLEAN()
  !string      = STRING()

  !tempArray   = Split(!wholeString)
  !count       = 1
  !flag        = FALSE
  !string      = ''

  -----------------------------------------------------
  -- Loop through each string to look for '('
  -- character. Glue expression back together.
  --   !x     is counter for !tempArray
  --   !count is for !returnArray (what will be returned)
  --   !flag  is TRUE if '(' found
  -----------------------------------------------------

  do !x indices !tempArray

    if(!flag eq TRUE) then
      !string = !string + ' ' + !tempArray[!x]

      if(!tempArray[!x].match(')') gt 0) then
        !flag                = FALSE
        !returnArray[!count] = !string
        !string              = ''
        !count               = !count + 1
      endif

    elseif(!tempArray[!x].match('(') gt 0) then

      if(!tempArray[!x].match(')') gt 0) then
        !returnArray[!count] = !tempArray[!x]
        !count               = !count + 1
      else
        !flag   = TRUE
        !string = !string + !tempArray[!x]
      endif
    else
      !returnArray[!count] = !tempArray[!x]
      !count               = !count + 1
    endif
  enddo

  return !returnArray

endfunction
-- End of function definition for !!rptExprSplit
