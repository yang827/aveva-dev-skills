-- Author:          P.Mooney
-- Created:         Tue Aug 12 15:29:31 BST 1997
--
--
-- Description:--
-- See if the string passed in is a valid "expression" i.e. NAME, HBORE, HREF.
-- If the string evaluates to a STRING or LOGICAL etc then it is ok.
-- If !displayError is TRUE then an error message is displayed, else it is
-- ignored. The calling function is left to deal with it.
--
-- Arguments:
--          1 - Name of gadget i.e. Form.Gadget
--          2 - TRUE or FALSE - display error message or not.
--
-- Returns:
--          TRUE  if expression is valid
--          FALSE if not good expression
--
-------------------------------------------------------------------------------

define function !!rptGoodExprType(!text is STRING, !displayError is BOOLEAN) is BOOLEAN

   if(length(!text) eq 0) then
      return TRUE
   endif

   -- first count number of quotes
   var !blocks SPLIT |$!text| |'|
   var !size (ARRAYSIZE (!blocks))
   if ($!size eq (2 * int($!size/2))) then
      return error 1 |Quote mismatch in expression|
   endif

   -- check the type of the expression to see if it is valid

--   onerror golabel /HandleError
   var !unusedTest EXPTYP ($!text)
   handle any
      if(!displayError eq TRUE) then
         error |Expression is not valid|
      endif
      return FALSE
   endhandle
   return TRUE

--   label /HandleError
   if(!displayError eq TRUE) then
      error |Expression is not valid|
   endif
--   onerror return
   return FALSE

endfunction
-- End of function definition for !!rptGoodExprType
