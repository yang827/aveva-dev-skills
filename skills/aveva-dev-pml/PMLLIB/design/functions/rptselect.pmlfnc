--   Type:          Function Definition
--   Group:         2D Positioning design
--     Keyword:     POS
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Wed Aug 13 10:24:48 BST 1997
--
--
-- Description:
-- callback on all gadgets for Quick reports form. This will be a
-- collection of methods in the future.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget to be validated (or actioned in the
--                           case of the toggle button)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN
--
------------------------------------------------------------------------

define function !!rptSelect(!gadget is GADGET) is BOOLEAN

  !bStatus = TRUE

  if(!gadget.name() eq 'TERM') then

    if(!!rptQuick.term.val eq true) then
      !!rptQuick.filename.active = false
      !!rptQuick.file.active     = false
    else
      !!rptQuick.filename.active = true
      !!rptQuick.file.active     = true
    endif

  elseif(!gadget.name() eq 'FILENAME') then
    -- commented for Space in File(P-1319)
    -- if(!!rptQuick.filename.val.match(' ') gt 0) then
    --   !!alert.warning('File name must not contain spaces')
    --   !bStatus = FALSE
    -- endif

    ----------------------
    -- CHECK TYPE
    ----------------------

  elseif(!gadget.name() eq 'TYPE') then

    !tempVal = !gadget.val

    if (trim(!tempVal) ne '') then
      var !empty[1] | |
      var !empty[1] DELETE
      var !test     COLLECT ALL ($!tempVal) FROM !empty
      handle ANY
        !!alert.warning(|Expression '$!tempVal' is incorrect in 'Types' field
$!!error.text|)
        !bStatus = FALSE
      endhandle
    endif

    ----------------------
    -- CHECK FILTER
    ----------------------

  elseif(!gadget.name() eq 'WITH') then
    !tempVal = !gadget.val

    if (trim(|$!tempVal|) ne ||) then
      var !empty[1] | |
      var !empty[1] DELETE
      var !test     COLLECT ALL WITH ($!tempVal ) FROM !empty
      handle ANY
        !!alert.warning(|Expression '$!tempVal' is incorrect in 'With' field
$!!error.text|)
        !bStatus = FALSE
      endhandle
    endif

    ----------------------
    -- CHECK SORT
    ----------------------

  elseif (!gadget.name() eq 'SORT') then
    !exprArray = !!rptExprSplit(!gadget.val)

    if( NOT !exprArray.empty()) then

      do !x from 1 to !exprArray.maxIndex()
        if(!!rptGoodExprType(!exprArray[!x], FALSE) eq FALSE) then
          !!alert.warning(|Expression "$!exprArray[$!x]" is not correct in sort (Columns) field|)
          !bStatus = FALSE
        endif
      enddo
    endif

    ----------------------
    -- CHECK HIERARCHY
    ----------------------

  elseif (!gadget.name() eq 'HIERARCHY') then

    !tempVal = !gadget.val

    if (trim(|$!tempVal|) ne ||) then
      var !empty[1] | |
      var !empty[1] DELETE
      var !test     COLLECT ALL FOR $!tempVal FROM !empty
      handle ANY
        !!alert.warning(|Expression '$!tempVal' is incorrect in 'Hierarchy' field
$!!error.text|)
        !bStatus = FALSE
      endhandle
    endif

    ----------------------
    -- Run Quick Report
    ----------------------

  elseif (!gadget.name() eq 'RUN') then

    -- need to check all gadgets are ok before creating report

    !bResult = !!rptChkForm(!gadget.owner())

    if(defined(!gadget.owner().sort)) then
      if(!gadget.owner().sort.val eq '') then
        !!alert.warning('No columns to produce report with')
        !bResult = False
      endif
    endif

    if(!bResult eq TRUE) then
      !form             = !gadget.owner()

      !report           = object RPTPROPERTIES()
      !report.filename  = !form.filename.val
      !report.macName   = '%pdmswk%/TMP.MAC'
      !report.types     = !form.type.val
      !report.with      = !form.with.val
      !report.hierarchy = !form.hierarchy.val
      !report.saveMac   = TRUE
      --      !report.saveMac   = FALSE

      if(!form.term.val eq TRUE OR !form.filename.val.empty()) then
        !report.term     = TRUE
        !report.filename = ''
      endif



      !exprArray = !!rptExprSplit(!form.sort.val)

      do !x indices !exprArray
        !column           = object RPTCOLUMN()
        !column.expr      = !exprArray[!x]
        !column.value     = 'On'
        !column.sort      = '0 to 9'

        !report.columns.append(!column)
      enddo

      !bResult = !!rptCrtQuick(!report)

      if(!bResult eq TRUE) then
        $M "$!report.macName"
      endif
    endif
  endif

  return !bStatus

endfunction
-- End of function definition for !!rptSelect
