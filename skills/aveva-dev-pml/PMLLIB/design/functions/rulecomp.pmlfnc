-- Author:          M.Barlow
-- Created:         Fri 21 Nov 10:08:00 GMT 1997
--
--
-- Description:
-- Given a string containing a position rule, extract ENU components
-- Return array has three strings. The first is E/W component, next is
-- N/S component and last is U/D component. The first letter of the string
-- indicates the direction.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      From query on position rule
-- Return:
--   [Data Type] [Description]
--   ARRAY       Three strings for E, N, U
--
------------------------------------------------------------------------

-- Define function
define function !!ruleComp (!rule is STRING) is ARRAY

  -- Find where components start
  -- East/West
  !compIndex[1] = !rule.match('E (')
  if(!compIndex[1] eq 0) then
    -- try for a W component
    !compIndex[1] = !rule.match('W (')
  endif
  -- North/South
  !compIndex[2] = !rule.match('N (')
  if(!compIndex[2] eq 0) then
    -- try for a S component
    !compIndex[2] = !rule.match('S (')
  endif
  -- Up/Down
  !compIndex[3] = !rule.match('U (')
  if(!compIndex[3] eq 0) then
    -- try for a D component
    !compIndex[3] = !rule.match('D (')
  endif
  !compIndex[4] = !rule.trim().length()

  -- find order of components in the string
  !compOrder = !compIndex.sortedIndices()

  -- Loop through components in order
  do !i to 3

    !compI = !compOrder[!i]
    -- Get component
    if( !compIndex[!compI] eq 0 ) then
      -- No component, return null string
      !ruleComp[!compI] = ''
    else
      !compLength  = !compIndex[!compOrder[!i + 1]] - !compIndex[!compI] - 1
      if(!compLength eq 0) then
        !ruleComp[!compI] = ''
      else
        !ruleComp[!compI] = !rule.subString(!compIndex[!compI],!compLength)
      endif
    endif
  enddo

  return !ruleComp

endfunction
-- End of function definition for !!ruleComp
