--
-- File:            sctlcrelem.pmlfnc
--   Type:          Function Definition
--   Group:         GENERAL STRUCTURAL
--     Keyword:
--   Module:        design
--   Replaces:      NEW Structural Element
--
-- Author:          S.Hudson,,,
-- Created:         Mon Feb 10 15:10:53 GMT 1997
--
--
-- Description:
-- Create a structural element using defaults for ...
-- Autoname
-- Storage Area
-- Specification
-- Material
--
-- CHANGE THIS AT YOUR PERIL MUCH OF THE STRUCTURAL APPLICATION
-- DEPENDS ON IT!
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of Element
--    2   R      STRING      Application
-- Return:
--   [Data Type] [Description]
--    DBREF       Element Created
------------------------------------------------------------------------

-- Define function
define function !!sctlCrElem(!type is STRING, !application is STRING) is DBREF

  !refe = !!ce

  --------------------
  -- Find Storage Area
  --------------------
  if (!type eq 'FIXING') then
    !!ce = !!strFittSpec.owner
    handle any
    endhandle
    call !!dbRefUpdate(!!ce)

  elseif (!type eq 'EXTR' or !type eq 'NXTR') then
    call !!dbRefUpdate(!!ce)

  elseif (!type eq 'GENSEC') then
    !store = !!findStorageArea(!application, 'SCTN')
    if (Undefined(!store) or Unset(!store) ) then
      call !!dbRefUpdate(!!ce)
      !!ce = !refe
    else
      !!ce = !store
    endif

  elseif (!type eq 'PANE' ) then
    !store = !!findStorageArea(!application, 'PANEL')
    if (Undefined(!store) or Unset(!store) ) then
      call !!dbRefUpdate(!!ce)
      !!ce = !refe
    else
      !!ce = !store
    endif

  elseif (!type eq 'FLOOR' or !type eq 'SCREED') then
    !store = !!findStorageArea(!application, 'FLOOR')
    if (Undefined(!store) or Unset(!store) ) then
      call !!dbRefUpdate(!!ce)
      !!ce = !refe
    else
      !!ce = !store
    endif

  elseif (!type eq 'WALL' or !type eq 'STWALL') then
    !store = !!findStorageArea(!application, 'WALL')
    if (Undefined(!store) or Unset(!store) ) then
      call !!dbRefUpdate(!!ce)
      !!ce = !refe
    else
      !!ce = !store
    endif

  else
    !store = !!findStorageArea(!application, !type)
    if (Undefined(!store) or Unset(!store) ) then
      call !!dbRefUpdate(!!ce)
      !!ce = !refe
    else
      !!ce = !store
    endif

  endif


  --------------------
  -- Create Element
  --------------------

  if (!type eq |FIXING| ) then
    !string = !!strFittSpec.type

    if (!string eq 'FIXING') then
         NEW JLDATU
         NEW PLDATU

    else
      -- Create compound fitting if required
      CMPF
      handle any
        CMFI
        handle any
          PANEL
          handle none
            NEW CMPF
          elsehandle any
            NEW CMFI
          endhandle
        endhandle
      endhandle
    endif
    NEW $!string
  else
    NEW $!type
  endif

  !return = !!ce

  --------------------
  -- Set Dunion Attribute
  --------------------
  !dunionVal = !!draDunion.getValue(!return.type)
  if (!dunionVal.unset().not()) then
    DUNION $!<dunionVal>
  endif

  --------------------
  -- Set Name
  --------------------
  if(!!namOpt.auto()) then
    !name = !!namOpt.nameString(!return, ||, true, false)
    if (!name.unset().not()) then
      NAME /$!name
    endif
  endif

  --------------------
  -- Set Design Parameters
  --------------------
  if (!return.type eq |STWALL| or !return.type eq |WALL| ) then
    !noOfDesp = !!cvWallSpec.default.desp.size()
    handle any
      !noOfDesp = 0
    endhandle
    !despString = ' '
    if (!noOfDesp gt 0) then
      do !index from 1 to !noOfDesp
        !despString = !despString  & !!cvWallSpec.default.desp[!index] & ' '
      enddo
      DESP $!despString
    endif

  elseif (!return.type eq |SCTN| or !return.type eq |GENSEC|) then
    -- Extract design parameters from form
    !despString = ''
    do !index
      var list _cdStlSpecD_Desp SEL $!index exit
      handle any
        break
      endhandle
      !despString = !despString  & |$_cdStlSpecD_Desp| & ' '
    enddo
    if (!despString.trim().length() gt 0) then
      DESP $!despString
    endif

  elseif (!type eq 'FIXING') then
    !noOfDesp = !!strFittSpec.desp.size()
    handle any
      !noOfDesp = 0
    endhandle
    !despString = ' '
    if (!noOfDesp gt 0) then
      do !index from 1 to !noOfDesp
        !despString = !despString  & !!strFittSpec.desp[!index] & ' '
      enddo
      DESP $!despString
    endif

  endif

  --------------------
  -- Set Specification
  --------------------
  if (!return.type eq |STWALL| or !return.type eq |WALL| ) then
    SPRE $!!cvWallSpec.default.spre
    handle any
      !!messageFile.error(157, 001)
    endhandle
    -- Make a template
    if (Set(!!cvWallSpec.default.spre) ) then
      if ( Set(!!cvWallSpec.default.spre.tmpr) ) then
        NEW SPINE
        NEW POINSP
        NEW POINSP
        BY N 1000
        WALL
        NEW TMPL
        !template = !!cvWallSpec.default.spre.tmpr
        COPY REXECUTE $!template
        !!ce = !return
      else
        -- Set GTYPE
        !value =  !!cvWallSpec.default.spre.catRef.gtyp
        GTYPE $!value
        -- Create Spine
        if (!return.type eq |WALL| ) then
          NEW SPINE
        endif
      endif
     endif

  elseif (!return.type eq |PANE|) then
  -- Panels
  -- No specification set
    SPREF $!!cdPaneSpecD.spre
    handle any
      NEW PLOO
      !value = !!pltNewPanel.thickness.val
      handle any
        !value = 0
      endhandle
      HEIGHT $!value
    elsehandle none
      -- Make Template
      if (Set(!!cdPaneSpecD.spre.val.dbRef().tmpr) ) then
        NEW TMPL
        !template = !!cdPaneSpecD.spre.val.dbRef().tmpr
        COPY REXECUTE $!template
        !!ce = !return
      else
        -- Create loop
        NEW PLOO
        !value = !!cdPaneSpecD.thk.val
        handle any
          !value = 0
        endhandle
        HEIGHT $!value
      endif
    endhandle

  elseif (!return.type eq |EXTR| or !return.type eq |NXTR|) then
    -- Extrusions
    !value = !!pltNewPanel.thickness.val
    handle any
      !value = 0
    endhandle
    HEIGHT $!value
    NEW LOOP

  elseif (!return.type eq |SCTN| or !return.type eq |GENSEC|) then
    var !specRef |$_cdStlSpecD_Spre|
    handle any
    endhandle
    if (!specRef.set() and !specRef.trim().length() gt 0) then
      SPREF $!specRef
    endif
    -- Make a template
    if (Set(!specRef) ) then
      if ( Set(!specRef.dbRef().tmpr) ) then
        NEW TMPL
        !template = !specRef.tmpr
        COPY REXECUTE $!template
        !!ce = !return
      else
        -- Set GTYPE
        !value =  !specRef.dbRef().catRef.gtyp
        GTYPE $!value
        -- Create Spine
        if (!return.type eq |GENSEC| ) then
          NEW SPINE
        endif
      endif
    else
      NEW SPINE
    endif

  elseif (!type eq |FIXING|) then
    -- Fittings
    !string = !!strFittSpec.specData.currentSelection.string()
    SPREF $!string
    handle any
      !!messageFile.error(157, 002)
    endhandle
    -- Make Template
    if (Set(!!strFittSpec.specData.currentSelection.tmpr) ) then
      NEW TMPL
      !template = !!strFittSpec.specData.currentSelection.tmpr
      COPY REXECUTE $!template
      !!ce = !return
    endif
  endif

  --------------------
  -- Set Justification
  --------------------
  if (!return.type eq |STWALL| or !return.type eq |WALL|) then
    !value = |$!!<cvWallSpec.default.just>|
    handle any
    endhandle
    if (!value.set() and !value.trim().length() gt 0) then
      !!ce = !return
      JUSL $!value
      !value = |$!!<cvWallSpec.default.meml>|
      MEML $!value
      !value = |$!!<cvWallSpec.default.jLin>|
      if (!return.type eq |WALL|) then
        JLNS $!value
        JLNE $!value
        SPINE 1
      else
        JLIN $!value
      endif
    endif

  elseif (!return.type eq |SCTN| or !return.type eq |GENSEC|) then
    !value = |$_cdStlSpecD_Just|
    handle any
    endhandle
    if (!value.set() and !value.trim().length() gt 0) then
      !!ce = !return
      JUSL $!value
      !value = |$_cdStlSpecD_Meml|
      MEML $!value
      !value = |$_cdStlSpecD_Jlin|
      if (!return.type eq |GENSEC|) then
        JLNS $!value
        JLNE $!value
        SPINE 1
      else
        JLIN $!value
      endif
    endif

  endif

  return !return

endfunction
-- End of function definition for !!sctlCrElem
