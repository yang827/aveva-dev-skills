--
-- Description:
-- Replace current curve with details from paste buffer
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlCurveReplace()

!refe = !!ce
!!ce = !!sctlSpine.current
!position = 'E' & !!sctlSpine.xCpos.val & ' N' & !!sctlSpine.yCpos.val & ' U0'
POS $!position
!position = 'E' & !!sctlSpine.xNpos.val & ' N' & !!sctlSpine.yNpos.val & ' U0'
CPOS $!position
!radius = !!sctlSpine.radius.val.string()
RADIUS $!radius
!type = !!sctlSpine.curve.selection()
CURTYPE $!type

-- Now update list
!spine = !!ce.owner
!!sctlSpine.number = !spine.members.findFirst(!!ce)
call !!sctlSpineList(!spine)
!!ce = !refe

endfunction
-- End of function definition for !!sctlCurveReplace
