--
--
-- Description:
-- Set cutplane based on a given direction
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       SCTN
--    2   R      String      End
--    3   R      Vector      CutPlane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlCutPlane(!sctn is DBREF, !end is STRING, !cutPlane is VECTOR)

  -- Navigate to SCTN
  !refe = !!ce
  !!ce = !sctn
  !message = STRING()

  -- At END
  if (!end.upcase().subString(1,1) inset ('E','X')) then
    if (!cutPlane.set()) then
      -- Calculate Direction from Start to End
      !line = !!consLinePos (!sctn.poss, !sctn.pose ,!message)

      -- Calculate Angle between Directions
      !angle = !!consAngPlaneLine ( !cutPlane, !line )
      if (!angle gt 90 ) then
           !direction = !!consOppoDir(!cutPlane.direction).string()
      else
           !direction = !cutPlane.direction.string()
      endif
      DRNE $!direction

    else
      DRNE PERP

    endif
  -- At START
  else
    if (!cutPlane.set()) then
      -- Calculate Direction from End To Start
      !line = !!consLinePos (!sctn.pose, !sctn.poss ,!message)
      -- Calculate Angle between Directions
      !angle = !!consAngPlaneLine ( !cutPlane, !line )
      if (!angle gt 90 ) then
           !direction = !!consOppoDir(!cutPlane.direction).string()
      else
           !direction = !cutPlane.direction.string()
      endif
      DRNS $!direction

    else
      DRNS PERP

    endif
  endif

  !!ce = !refe

endfunction
-- End of function definition for !!sctlCutPlane
