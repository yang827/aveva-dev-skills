--
-- File:            sctldisplayplot.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:      XSTLPLOT
--
-- Author:          S.Hudson,,,
-- Created:         Mon Feb 24 16:28:45 GMT 1997
--
--
-- Description:
-- Display plot view of catalogue item if available
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      object dbref Element
--    2   R      Boolean      Display if not already displayed
--    3   R      Boolean      Display Error message
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlDisplayPlot(!element is DBREF, !force is BOOLEAN, !error is BOOLEAN)

-- Save Current Element
!refe = !!ce
!message = STRING()

if (defined(!!sctlPlotView) and  !!sctlPlotView.shown() or !force ) then

-- Catalogue Reference
     if (Set(!element.catRef) ) then
    -- Find Catalogue Item
          !!ce = !element.catRef
          handle any
                if (defined(!!sctlPlotView) ) then
                    !!sctlPlotView.hide()
                endif
                !!ce = !refe
                if (!error) then
                     !!messageFile.error(155, 002)
                else
                     !!messageFile.errorNoAlert(155, 002)
                endif
          endhandle
     -- Find Dataset
          !!ce = !!ce.dtRef
          handle any
               if (defined(!!sctlPlotView) ) then
                    !!sctlPlotView.hide()
               endif
               !!ce = !refe
               if (!error) then
                     !!messageFile.error(155, 003)
               else
                     !!messageFile.errorNoAlert(155, 003)
               endif
          endhandle
-- Template Reference
      else
     -- Find Template Reference
          !!ce = !element.tmpr
          handle any
                if (defined(!!sctlPlotView) ) then
                    !!sctlPlotView.hide()
                endif
                !!ce = !refe
                if (!error) then
                     !!messageFile.error(155, 004)
                else
                    !!messageFile.errorNoAlert(155, 004)
                endif
          endhandle
     -- Find Dataset
          !!ce = !!findFirstMember(!element.tmpr, 'DDSE', '', !message)
          if (Unset(!!ce) ) then
               if (defined(!!sctlPlotView) ) then
                    !!sctlPlotView.hide()
                endif
               !!ce = !refe
               if (!error) then
                     !!messageFile.error(155, 005)
               else
                     !!messageFile.errorNoAlert(155, 005)
               endif
          endif
      endif

-- find first data item with purpose PLOT

      !dataset = !!ce
      !data = !!findFirstMember(!dataset, 'DATA', 'PLOT', !message )
      if (Undefined(!data) or Unset(!data) ) then
           if (defined(!!sctlPlotView) ) then
                  !!sctlPlotView.hide()
           endif
           !!ce = !refe
           if (!error) then
                !!messageFile.error(155, 006)
           else
                !!messageFile.errorNoAlert(155, 006)
           endif
      endif
      !!ce = !refe

      -- extract data

      !filename = |%PDMSPLOTS%/| & $!data.dprop & |/| & $!data.pprop

      !info = STRING()
      !message = STRING()

      if (not !!findFile(!filename , 'ENTRY', !message, !info) ) then
          if (defined(!!sctlPlotView) ) then
                !!sctlPlotView.hide()
          endif
          !!ce = !refe
              if (!error) then
                  !!messageFile.error(155, 007, !filename)
              else
                  !!messageFile.errorNoAlert(155, 007, !filename)
              endif
      endif

      -- show plot form
      show !!sctlPlotView

      if ( !filename ne !!sctlPlotView.plot.val ) then
          -- Modify Aspect Ratio if necessary
          if (!data.ptyp eq |LPLT|) then
               !!sctlPlotView.plot.setSize(20, 30  )
          else
               !!sctlPlotView.plot.setSize(30, 15 )
          endif
          -- Display the plot file
          !!sctlPlotView.plot.add( !filename )
      endif

endif

!!ce = !refe
return

endfunction
-- End of function definition for !!sctlDisplayPlot
