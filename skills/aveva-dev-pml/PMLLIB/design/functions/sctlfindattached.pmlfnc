-- Created:         Mon Apr 28 09:18:10 BST 1997
--
--
-- Description:
-- Find the most appropriate attached element to a node
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlFindAttached(!wall is DBREF, !end is STRING, !sense is BOOLEAN, !type is STRING) is DBREF

  -- Initialise Variables

  -- Get Attached Start/End joint
  -- Going from End to Start
  if(!end.upcase() eq 'END') then
    !joint = !wall.joiS
    !unconend = 'START'
  else
    !joint = !wall.joiE
    !unconend = 'END'
  endif

  -- Check for unset end
  if(!joint.unset() ) then
    !!alert.error('Section ' & !unconend & ' is unconnected.')
    return object DBREF()
  endif

  -- Vector Definition of Section (Start to End)
  !wallYDir = !wall.ori.zDir().wrt(World)
  !wallXDir = !wall.ori.xDir().wrt(World)

  -- Reference Plane
  !plane           = object VECTOR()
  !plane.direction = !wall.ori.yDir().wrt(World)
  !plane.position  = !wall.pos.wrt(World)

  -- If we are going from End to Start, then transpose Y directions
  if(!end.upcase() ne 'END') then
    !wallYDir.east  = !wallYDir.east   * -1
    !wallYDir.north = !wallYDir.north  * -1
    !wallYDir.up    = !wallYDir.up     * -1
  endif

  -- If sense is anti-clock-wise, then transpose xDir
  if((!sense and !end.upcase() ne 'END') or (!sense.not() and !end.upcase() eq 'END')) then

    !wallXDir.east  = !wallXDir.east   * -1
    !wallXDir.north = !wallXDir.north  * -1
    !wallXDir.up    = !wallXDir.up     * -1

  endif

  -- Collect all other connections to the Node
  !node = !joint.owner

  -- Set node type

  !type = !node.type.upcase()

  -- Collect all Joints (excluding the current joint)
  !joints = !!collectAllFor('PJOI SJOI','REF ne ' & !joint.ref & ' and CREF ne Nulref',!node)

  -- Check there are other joints
  if(!joints.unset() and !node.type.upcase() ne 'SNOD' ) then
    !!alert.error('No other walls connected to the ' & !unconend & ' of wall ' & !wall.flnn)
    return object DBREF()
  endif

  -- Get all ends of joint
  !block = object BLOCK('!joints[!evalIndex].cend')
  !ends  = !joints.evaluate(!block)

  -- Get Sections to which joints are attached
  !block   = object BLOCK('!joints[!evalIndex].cref')
  !section = !joints.evaluate(!block)

  -- Get ends of joint for owning element of snode
  if (!node.type.upcase() eq 'SNOD') then
     -- Append section start and end to relevant arrays
     !section.append(!node.owner)
     !ends.append('start')
     !section.append(!node.owner)
     !ends.append('end')
  endif

  -- Get all directions of attached beams
  !block      = object BLOCK('!!sectionDirection(!section[!evalIndex],!ends[!evalIndex]).wrt(World)')
  !directions = !section.evaluate(!block)

  -- Map all directions on to the default plane
  !block      = object BLOCK('!!directionOnPlane(!directions[!evalIndex],!plane)')
  !mapDirs    = !directions.evaluate(!block)

  -- Calculate the directions for X
  !block      = object BLOCK('!!angleFrom2Dirs(!wallXDir,!mapDirs[!evalIndex])')
  !xAngle     = !mapDirs.evaluate(!block)

  -- Calculate the directions for Y
  !block      = object BLOCK('!!angleFrom2Dirs(!wallYDir,!mapDirs[!evalIndex])')
  !yAngle     = !mapDirs.evaluate(!block)

  -- Loop through the directions and determine the angle in terms of 360
  do !i indices !xAngle

    -- Within 180 from 0
    if(!xAngle[!i] le 90 and !yAngle[!i] le 90 or !xAngle[!i] le 90 and !yAngle[!i] ge 90) then
      !angle[!i] = !yAngle[!i]
    else
      !angle[!i] = 360 - !yAngle[!i]
    endif

  enddo

  -- Sort by indices
  var !sort SORT !angle NUMERIC

  -- Get Section for sort list
  !index = !sort[1].real()

  -- Return end via argument list
  !end   = !ends[!index]

  -- Return Section
  !temp = !section[!index]
  return  !temp

endfunction
-- End of function definition for !!sctlFindAttached
