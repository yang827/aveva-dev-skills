-- Define function
define function !!sctlFittZDist()

-- Extract Information
!element = !!ce

if (!element.type eq |SCTN| or !element.type eq |STWALL|) then

     !value = !!sctlZDistOfPos(!element, !!edgGeomData.position )

elseif (!element.owner.type eq |SCTN| or !element.owner.type eq |STWALL|) then

     !value = !!sctlZDistOfPos(!element.owner, !!edgGeomData.position )

endif

-- Set Gadget
var _cdFitSpec_DIST $!value

$M "%PDMSUI%/DES/STLWRK/IFITSPECD"

--

endfunction
-- End of function definition for !!sctlFittZDist
