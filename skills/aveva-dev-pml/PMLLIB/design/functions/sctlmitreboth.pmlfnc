--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Thu Mar 27 16:38:23 BST 1997
--
--
-- Description:
-- Mitre both ends of given element provided they are connected via PNODE's
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Element must be SCTN or STWALL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlMitreBoth(!element is DBREF)

-- Mitre First End
     if (!element.joiS ne nulref and !element.joiS.set() and (!element.joiS.type eq |PJOI| or !element.joiS.type eq |FIXING|) and !element.joiS.owner.mCount eq 2  ) then
        if(Set(!element.joiS.owner.members[1].cref) and Set(!element.joiS.owner.members[2].cref) ) then
-- Find First Element owned by PNODE
           !first = !element.joiS.owner.members[1].cref
           if(!first.joiS ne nulref and !first.joiS.owner eq !element.joiS.owner) then
                 !firstEnd = |START|
           else
                 !firstEnd = |END|
           endif
-- Find Second Element owned by PNODE
           !second= !element.joiS.owner.members[2].cref
           if(!second.joiS ne nulref and !second.joiS.owner eq !element.joiS.owner) then
                 !secondEnd = |START|
           else
                 !secondEnd = |END|
           endif
           call !!strMitre(!first, !firstEnd, !second, !secondEnd )
        endif
     endif
-- Mitre Second End
    if (!element.joiE ne nulref and !element.joiE.set() and ( !element.joiE.type eq |PJOI| or !element.joiE.type eq |FIXING| ) and !element.joiE.owner.mCount eq 2) then
        if(Set(!element.joiE.owner.members[1].cref) and Set(!element.joiE.owner.members[2].cref) ) then
-- Find First Element owned by PNODE
           !first = !element.joiE.owner.members[1].cref
           if(!first.joiS ne nulref and !first.joiS.owner eq !element.joiE.owner) then
                 !firstEnd = |START|
           else
                 !firstEnd = |END|
           endif
-- Find Second Element owned by PNODE
           !second= !element.joiE.owner.members[2].cref
           if(!second.joiS ne nulref and !second.joiS.owner eq !element.joiE.owner) then
                 !secondEnd = |START|
           else
                 !secondEnd = |END|
           endif
           call !!strMitre(!first, !firstEnd, !second, !secondEnd )
        endif
     endif

return

endfunction
-- End of function definition for !!sctlMitreBoth
