--
-- File:            sctlmitresctn.pmlfnc
--   Type:          Function Definition
--   Group:         CIVIL
--     Keyword:
--   Module:        design
--   Replaces:      MSCTNMITRE but allows for differing sizes
--
-- Author:          S.Hudson,,,
-- Created:         Thu Mar 6 15:06:03 GMT 1997
--
--
-- Description:
-- Check the specified ends of two SCTN's are connected and
-- set the cutplanes to mitre them
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       First SCTN
--    2   R      String      End of first SCTN
--    3   R      dbref       Second SCTN
--    4   R      String      End of second SCTN
--    5   RW     Status      Message
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Status (True is Success)
--
------------------------------------------------------------------------

-- Define function
define function !!sctlMitreSCTN(!first is DBREF, !firstEnd is STRING, !second is DBREF, !secondEnd is STRING, !message is STRING) is BOOLEAN

  -- Check Arguments
  if (!first.unset()) then
    !message = |First Section not defined|
    return false
  endif

  if (!second.unset()) then
    !message = |Second Section not defined|
    return false
  endif

  if (!first.hardType ne |SCTN| and  !first.hardType ne |GENSEC| ) then
    !message = |First Section not a SCTN or GENSEC|
    return false
  endif

  if (!second.hardType ne |SCTN| and !second.hardType ne |GENSEC| ) then
    !message = |Second Section not a SCTN or GENSEC|
    return false
  endif

  if ( |$_CDSREFTOL_MITRE| eq |true| ) then
    -- Find all the plines for the two sections
    !firstProfile = object DBREF()
    !secondProfile = object DBREF()
    !firstPlines = ARRAY()
    !secondPlines = ARRAY()

    if (not !!findPlines(!first, |NULL|, !message, !firstProfile, !firstPlines) ) then
      !message = |First Profile: | & !message
      return false
    endif

    if (not !!findPlines(!second, |NULL|, !message, !secondProfile, !secondPlines) ) then
      !message = |Second Profile: | & !message
      return false
    endif

    -- Compile list of matching plines
    !pLines = ARRAY()
    do !index1 from 1 to !firstPlines.size()
      do !index2 from 1 to !secondPlines.size()
        if (!firstPlines[!index1].pkey eq !secondPlines[!index2].pkey ) then
          !pLines.append(!firstPlines[!index1].pkey)
          break
        endif
      enddo
    enddo

    -- If less than three matching plines use simplified method
    if (!pLines.size() le 3) then
      !cutPlane = !!sctlSimpleMitre(!first, !firstEnd, !second, !secondEnd)

    else
      -- Use Plines to establish Plane
      !planePoint = ARRAY()

      -- Find Intersection of Plines
      do !index from 1 to !pLines.size()
        !firstLine = !!consLinePlin(!first, !pLines[!index], !firstEnd)
        !secondLine = !!consLinePlin(!second, !pLines[!index], !secondEnd)
        !intersection[!index]=!!consPosInter(!firstLine, !secondLine)

        -- Only use if set
        if(!intersection[!index].set() ) then
          -- Point is only suitable if it is significant distance from first
          if (!planePoint.size() eq 0) then
            !planePoint.append(!intersection[!index])
          else
            if (!planePoint[1].distance( !intersection[!index]) gt 10mm ) then
              !planePoint.append(!intersection[!index])
              if (!planePoint.size() ge 3) then
                break
              endif
            endif
          endif
        endif
      enddo

      -- If there are enough points construct a plane
      if (!planePoint.size() ge 3) then
        !cutPlane = !!consPlaneThro(!planePoint[1], !planePoint[2], !planePoint[3], !message)
      else
        -- otherwise use simple mitre
        !cutPlane = !!sctlSimpleMitre(!first, !firstEnd, !second, !secondEnd)
      endif
    endif
  else
    -- No mitring
    !cutPlane = object VECTOR()

  endif

  -- Set End Direction for First Section
  !!sctlCutPlane(!first, !firstEnd, !cutPlane )

  -- Set End Direction for Second Section
  !!sctlCutPlane(!second, !secondEnd, !cutPlane )

  return true

endfunction
-- End of function definition for !!sctlMitreSCTN
