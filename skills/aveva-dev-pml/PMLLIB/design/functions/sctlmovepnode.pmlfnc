--
--
-- Description:
-- Move any attached PNODE's to the end of the SCTN
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       SCTN etc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlMovePnode(!element is DBREF)

if (!element.hardType ne |SCTN| ) then
     return
endif
-- Save passed element just in case we pass !!ce
!wall = !element
!pos = !element.poss
!poss = !pos.string()
!pos = !element.pose
!pose = !pos.string()

!refe = !!ce

-- Navigate to node at start

if (!wall.joiS ne nulref and !wall.joiS.set()) then
     !!ce = !wall.joiS.owner
     if (Type eq 'PNOD') then
           NPOS $!poss
-- Make sure all joints are JFREE true
           !joints = !!ce.members
           do !joint values !joints
               if (!joint.type eq |PJOI| ) then
                    if (not !joint.jfree ) then
                         !!ce = !joint
                         JFREE TRUE
                    endif
                endif
           enddo
     endif
endif

-- Navigate to node at end

if (!wall.joiE ne nulref and !wall.joiE.set()) then
     !!ce = !wall.joiE.owner
     if (Type eq 'PNOD') then
           NPOS $!pose
-- Make sure all joints are JFREE true
           !joints = !!ce.members
           do !joint values !joints
               if (!joint.type eq |PJOI| ) then
                    if (not !joint.jfree ) then
                         !!ce = !joint
                         JFREE TRUE
                    endif
                endif
           enddo
     endif
endif

!!ce = !refe

endfunction
-- End of function definition for !!sctlMovePnode
