-- Define function
define function !!sctlPaveCe(!element is DBREF)

-- handle all types of extrusion
!type = !element.type
!message = STRING()

-- Extract panel loop
if (Set(!element) ) then
     -- handle all types of extrusion
     if (!element.type eq 'PANE' ) then
          !type = 'PLOO'
     else
          !type = 'LOOP'
     endif
     !ploo = !!findFirstMember(!element, !type, '', !message)
     !!sctlPave.panel = !element
endif
-- If no loop try to find panel or extrusion
if (!ploo.unset() ) then
    !type = 'PLOO'
    !!sctlPave.panel = PANEL
    handle any
         !type = 'LOOP'
         !!sctlPave.panel = EXTRU
         handle any
              !!sctlPave.panel = NXTR
              handle any
                   !!messageFile.error(155, 020)
              endhandle
         endhandle
    endhandle
    !ploo = !!findFirstMember(!!sctlPave.panel, !type, '', !message)
    if (!ploo.unset() ) then
         !!messageFile.error(155, 021)
    endif
endif

!!sctlPave.number = !ploo.mCount
if (!ploo.mCount ge 1) then
      !!sctlPave.current = !ploo.members[!ploo.mCount]
else
      !!sctlPave.current = object DBREF()
endif
-- Update List gadget
call !!sctlPaveList(!ploo)

-- Check to make sure everything is loaded
--    if(undefined(!!aidConstructors)) then
--       !aidConstructors = object AIDCONSTRUCTORS()
--       !aidConstructors.globalInstance()
--     endif

-- Change Plane for EDG
-- !plane = object PLANE()
-- !plane.orientation = !!sctlPave.panel.orientation
-- !plane.position = !!sctlPave.panel.position
-- !gphPlane = object GPHPLANE(!plane)
-- !!edgPosCntrl.setPlane(!gphPlane)

-- Save this plane

-- !!sctlPave.plane = !plane

-- Reinitialise paste buffer
!!sctlPave.xPos.val = 0
!!sctlPave.yPos.val = 0
!!sctlPave.radius.val = 0

endfunction
-- End of function definition for !!sctlPaveCe
