--
-- Description:
-- Create a new vertex at the picked position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveCreate()

-- Navigate to vertex
!!ce = !!sctlPave.panel
!type = !!ce.type
!element = !!ce
if (!type eq 'PANE') then
     PLOO 1
else
     LOOP 1
endif
!ploo = !!ce
!panelVertices = !!ce.members
if (!!ce.mCount eq 0) then
   !!sctlPave.number = 1
elseif (!!sctlPave.number gt !!ce.mCount) then
   !!ce = !panelVertices[!panelVertices.size()]
   !!sctlPave.number = !panelVertices.size() + 1
else
   !!ce = !panelVertices[!!sctlPave.number]
   !!sctlPave.number = !!sctlPave.number + 1
endif
-- Create new vertex
if (!type eq 'PANE') then
     NEW PAVE
else
     NEW VERT
endif
!posString = !!edgGeomData.position.wrt(!element).string()
POS $!posString
!!sctlPave.current = !!ce

!!ce = REFE

-- Update Form
call !!sctlPaveList(!ploo)

endfunction
-- End of function definition for !!sctlPaveCreate
