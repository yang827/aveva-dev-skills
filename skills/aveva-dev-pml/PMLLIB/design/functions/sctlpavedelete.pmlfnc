--
-- Description:
-- Delete Current vertex
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveDelete()

-- Copy vertex into buffer
!!sctlPave.xPos.val = !!sctlPave.vertices.selection('DTEXT').part(2).real(!!distanceFmt)
!!sctlPave.yPos.val = !!sctlPave.vertices.selection('DTEXT').part(3).real(!!distanceFmt)
!!sctlPave.radius.val = !!sctlPave.vertices.selection('DTEXT').part(4).real(!!distanceFmt)

-- Navigate to vertex to be deleted

!refe = !!ce
!!ce = !!sctlPave.current

-- Remember loop
!ploo = !!ce.owner

-- Work out new current vertex
!!sctlPave.number = !ploo.members.findFirst(!!ce) - 1
if (!!sctlPave.number eq 0 ) then
     !!sctlPave.number = 1
     if (!ploo.mCount lt 2) then
          !!sctlPave.current = !ploo
     else
          !!sctlPave.current = !ploo.members[2]
     endif
else
     !!sctlPave.current = !ploo.members[!!sctlPave.number]
endif
-- Delete vertex
if (!!ce.owner.type eq 'PLOO' ) then
     DELETE PAVE
else
     DELETE VERT
endif
-- Redisplay list
call !!sctlPaveList(!ploo)

!!ce = !refe
handle any
endhandle

endfunction
-- End of function definition for !!sctlPaveDelete
