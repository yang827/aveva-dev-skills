--
--
-- Description:
-- Tidy up on closing form including EDG and aid graphics
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveDismiss()

-- Check panel validity
!deleted = false
!volume = !!sctlPave.panel.rvol
handle any
     !volume = 0
endhandle

if (!volume lt 1 ) then
    !question = 'OK to delete ' &  !!sctlPave.panel.type & ' as geometry is invalid'
    !answer = !!alert.confirm(!question)
    if (!answer eq 'NO' ) then
          !!sctlPave.show()
          return
    else
          !!ce = !!sctlPave.panel
          DELETE PANEL
          !deleted = true
          if ( (!!ce.type eq 'FLOOR' or !!ce.type eq 'SCREED' or !!ce.type eq 'WALL') and !!ce.mCount eq 0) then
                   !question = !!ce.type & ' element is now empty OK to delete'
                   !answer = !!alert.confirm(!question)
                   if (!answer eq 'YES' ) then
                       !ownerType = !!ce.type
                       DELETE $!ownerType
                   endif
          endif
    endif

endif

!!edgCntrl.remove('Panel Vertex Position')

call !!clearAid('TEXT', 43800 )
call !!clearAid('TEXT', 43801 )
-- Clear Up Sub-Forms

if (defined(!!strPaveCent) and !!strPaveCent.shown() ) then
     !!strPaveCentDism()
endif
if (defined(!!strPaveFill) and !!strPaveFill.shown() ) then
     !!strPaveFill.dismiss()
endif
if (defined(!!strPaveRad) and !!strPaveRad.shown() ) then
     !!strPaveRad.dismiss()
endif
if (defined(!!strPaveThru) and !!strPaveThru.shown() ) then
     !!strPaveThru.dismiss()
endif

-- Delete Panel if less than three vertices
if (not !deleted) then
     !!ce = !!sctlPave.panel
     if (!!ce.type eq |PANE| ) then
          PLOO 1
          handle any
          elsehandle none
              !loop = !!ce
              !!ce = !!ce.owner
              if (!loop.mCount lt 3) then
                    DELETE PANEL
              endif
          endhandle
     else
          LOOP 1
          handle any
          elsehandle none
              !loop = !!ce
              !!ce = !!ce.owner
              if (!loop.mCount lt 3) then
                    !type = !!ce.type
                    DELETE $!type
              endif
          endhandle
     endif
endif


endfunction
-- End of function definition for !!sctlPaveDismiss
