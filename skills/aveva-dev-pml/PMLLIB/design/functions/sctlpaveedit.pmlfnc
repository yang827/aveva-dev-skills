-- Description:
-- Set up EDG to move current vertex to picked position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveEdit()

!!edgCntrl.remove('Panel Vertex Position')

-- set radio gadget
!!sctlPave.radio.val = 2

if (!!sctlPave.current.set() and !!sctlPave.current.fRadius gt 0 ) then

     call !!strPaveFillShow()

else

     !packet = object EDGPACKET()
     !packet.defineWrapper('POSITION','!!sctlPaveMove()','Pick New Position for Vertex')
     !packet.description = 'Panel Vertex Position'

     !!edgCntrl.add(!packet)

endif

endfunction
-- End of function definition for !!sctlPaveEdit
