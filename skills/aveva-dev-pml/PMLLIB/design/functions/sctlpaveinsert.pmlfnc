--
--
-- Description:
-- Insert new vertex from buffer after current
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Insert vertex before rather than after
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveInsert(!before is BOOLEAN)

-- Find place to create vertex

!refe = !!ce
!message = STRING()

if (set(!!sctlPave.current) ) then
     !!ce = !!sctlPave.current
     !type = !!ce.owner.type
     if (!before) then
-- go to previous vertex
         PREV
         handle any
-- if first in list go to owner
               OWNER
         endhandle
     endif
else
     if (!!sctlPave.panel.type eq 'PANE' ) then
          !type = 'PLOO'
     else
          !type = 'LOOP'
     endif
     !ploo = !!findFirstMember(!!sctlPave.panel, !type, '', !message)
     if (!ploo.mCount ge 1) then
          !!ce = !ploo.members[!ploo.mCount]
     else
          !!ce = !ploo
     endif
endif

--Add new vertex with values in buffer
if (!type eq 'PLOO') then
     NEW PAVE
else
     NEW VERT
endif
!!sctlPave.current = !!ce
!position = 'E' & !!sctlPave.xPos.val.string(!!distanceFmt) & ' N' & !!sctlPave.yPos.val.string(!!distanceFmt) & ' U0'
AT $!position
!radius = !!sctlPave.radius.val.string(!!distanceFmt)
FRADIUS $!radius

-- No update list
!ploo = !!ce.owner
!!sctlPave.number = !ploo.members.findFirst(!!ce)
call !!sctlPaveList(!ploo)
!!ce = !refe

endfunction
-- End of function definition for !!sctlPaveInsert
