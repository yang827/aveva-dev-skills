--
--
-- Description:
-- Update List gadget with values from form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveList(!ploo is DBREF)

-- Clear Aid Text
call !!clearAid('TEXT', 43800 )
call !!clearAid('TEXT', 43801 )

-- Fill List gadget with values
!size = !ploo.members.size()
if (!size gt 0) then
     do !index from 1 to !size
-- Vertex
          !string = !index.string()
          !characters = !string.length()
           do !fill from !characters to 4
                 !string = !string & ' '
           enddo
           !list[!index] = !string
           !numbers[!index] = !ploo.member[!index].string()
-- X
          !string = !ploo.member[!index].position.east.string(!!distanceFmt)
          !characters = !string.length()
           do !fill from !characters to 8
                 !string =  ' ' & !string
           enddo
           !list[!index] = !list[!index] + !string
-- Y
          !string = !ploo.member[!index].position.north.string(!!distanceFmt)
          !characters = !string.length()
           do !fill from !characters to 16
                 !string = ' ' & !string
           enddo
           !list[!index] = !list[!index] & !string
-- Radius
          !string = !ploo.member[!index].fRadius.string(!!distanceFmt)
          !characters = !string.length()
           do !fill from !characters to 16
                 !string = ' ' & !string
           enddo
           !list[!index] = !list[!index] & !string
-- Add aid text
           !xyPosition = !ploo.member[!index].position
--           !xyPosition.up = 0
           if (!index eq !!sctlPave.number ) then
                 !text =  !index.string('D0') & '*'
                 call !!drawAidText(!text, !xyPosition.wrt(WORLD), 43801 )

           else
                 !text = !index.string('D0')
                 call !!drawAidText(!text, !xyPosition.wrt(WORLD), 43800 )

           endif
     enddo
     !!sctlPave.vertices.dText = !list
     !!sctlPave.vertices.rText = !numbers
     !!sctlPave.vertices.val = !!sctlPave.number
else
     !list[1] = 'None'
     !!sctlPave.vertices.dText = !list
     !!sctlPave.vertices.rText = !list
     !!sctlPave.vertices.val = 1
endif

-- Check panel validity
!volume = !!sctlPave.panel.rvol
handle any
     !volume = 0
endhandle
if (!volume gt 1 ) then
     !!sctlPave.valid.val = ''
else
     !!sctlPave.valid.val = 'Panel Geometry Incorrect'
endif
-- if distance and direction change arrow
if (defined(!!strPaveRel) and !!strPaveRel.shown() ) then
      !!strPaveRel.arrow()
endif


endfunction
-- End of function definition for !!sctlPaveList
