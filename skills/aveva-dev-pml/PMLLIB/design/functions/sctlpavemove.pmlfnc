-- Description:
-- Move vertex to position picked
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveMove()

-- Navigate to vertex
!!ce = !!sctlPave.panel
if (!!ce.type eq 'PANE' ) then
     PLOO 1
else
     LOOP 1
endif
!ploo = !!ce
!panelVertices = !!ce.members

-- Modify vertex
!!ce = !panelVertices[!!sctlPave.number]
!posString = !!edgGeomData.position.wrt(!!ce.owner.owner).string()
POS $!posString
!!sctlPave.current = !!ce

!!ce = REFE

-- Update Form
call !!sctlPaveList(!ploo)

endfunction
-- End of function definition for !!sctlPaveMove
