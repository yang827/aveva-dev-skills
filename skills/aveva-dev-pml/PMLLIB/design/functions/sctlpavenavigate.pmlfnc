--
-- Description:
-- Navigate to picked vertex
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveNavigate()

-- change current vertex indication

call !!clearAid('TEXT', 43801 )
!text = !!sctlPave.number.string('D0')
call !!drawAidText(!text, !!sctlPave.current.position.wrt(WORLD), 43800 )

!!sctlPave.current = !!edgGeomData.nearestVertex
!!sctlPave.number = !!sctlPave.current.owner.members.findFirst(!!sctlPave.current)

-- mark current vertex
     !text = !!sctlPave.number.string('D0') & '*'
     call !!drawAidText(!text, !!sctlPave.current.position.wrt(WORLD), 43801 )

-- Select correct vertex on list
!!sctlPave.vertices.val = !!sctlPave.number

-- if distance and direction change arrow
if (defined(!!strPaveRel) and !!strPaveRel.shown() ) then
      !!strPaveRel.arrow()
endif
-- Switch to Edit

call !!sctlPaveEdit()

endfunction
-- End of function definition for !!sctlPaveNavigate
