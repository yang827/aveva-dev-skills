-- Define function
define function !!sctlPaveNew()

!!edgCntrl.remove('Panel Vertex Position')
!!edgCntrl.remove('Panel Vertex Navigation')
!!edgCntrl.remove('Panel Vertex Creation')

!!sctlPave.radio.val = 1

!packet = object EDGPACKET()

!packet.defineWrapper('POSITION','!!sctlPaveCreate()','Pick Position to Create Vertex')
!packet.description = 'Panel Vertex Position'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!sctlPaveNew
