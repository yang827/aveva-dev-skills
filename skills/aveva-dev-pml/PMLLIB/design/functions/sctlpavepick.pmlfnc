-- Description:
-- Set up EDG to change the current vertex to the picked position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPavePick()

!!edgCntrl.remove('Panel Vertex Position')
!!sctlPave.radio.val = 3

!packet = object EDGPACKET()

!packet.defineWrapper('PANELVERTEX','!!sctlPaveNavigate()','Pick Current Vertex', !!sctlPave.panel)
!packet.description = 'Panel Vertex Position'

!!edgCntrl.add(!packet)



endfunction
-- End of function definition for !!sctlPavePick
