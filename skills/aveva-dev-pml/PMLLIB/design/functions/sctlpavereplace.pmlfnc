--
-- Description:
-- Replace current vertex with values from buffer
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveReplace()

-- Replace current vertex with values in buffer

!refe = !!ce
!!ce = !!sctlPave.current
!position = 'E' & !!sctlPave.xPos.val.string(!!distanceFmt) & ' N' & !!sctlPave.yPos.val.string(!!distanceFmt) & ' U0'
AT $!position
!radius = !!sctlPave.radius.val.string(!!distanceFmt)
FRADIUS $!radius

-- No update list
!ploo = !!ce.owner
!!sctlPave.number = !ploo.members.findFirst(!!ce)
call !!sctlPaveList(!ploo)
!!ce = !refe

endfunction
-- End of function definition for !!sctlPaveReplace
