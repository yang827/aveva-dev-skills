--
--
-- Description:
-- Select current vertex from list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveSelect()

-- change current vertex indication

call !!clearAid('TEXT', 43801 )
!text = !!sctlPave.number.string('D0')
call !!drawAidText(!text, !!sctlPave.current.position.wrt(WORLD), 43800 )

!!sctlPave.number = !!sctlPave.vertices.val
!!sctlPave.current = !!sctlPave.vertices.selection().dbRef()

-- mark current vertex
     !text = !!sctlPave.number.string('D0') & '*'
     call !!drawAidText(!text, !!sctlPave.current.position.wrt(WORLD), 43801 )

-- if distance and direction change arrow
if (defined(!!strPaveRel) and !!strPaveRel.shown() ) then
      !!strPaveRel.arrow()
endif

-- if editing then pop up form to edit the vertex

if (!!sctlPave.radio.val eq 2) then
     if (!!sctlPave.current.set() and !!sctlPave.current.fRadius gt 0 ) then

          !!edgCntrl.remove('Panel Vertex Position')
          call !!strPaveFillShow()

     endif
endif

endfunction
-- End of function definition for !!sctlPaveSelect
