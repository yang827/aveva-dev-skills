--
--
-- Description:
-- Show the form and set up EDG
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
--    2   R      POSITION    2D plane position
--    3   R      ORIENTATION 2D Plane orientation
--    4   R      STRING      Mode (Create, Edit or Navigate)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPaveShow(!panel is DBREF, !dummyPosition is POSITION, !dummyOri is ORIENTATION, !mode is STRING)

-- Now show form
show !!sctlPave

-- Save Parameters as members of form
!!sctlPave.panel = !panel
-- !!sctlPave.origin = !position
-- !!sctlPave.plane.orientation = !ori
-- !!sctlPave.plane.position = !position
!!sctlPave.number = 1

-- Initialise Form
call !!sctlPaveCe(!panel)

-- Set up event driven graphics
if(!mode.upcase() eq |CREATE| ) then
     call !!sctlPaveNew()
elseif (!mode.upcase() eq |MODIFY| ) then
     call !!sctlPaveEdit()
else
     call !!sctlPaveNavigate()
endif

endfunction
-- End of function definition for !!sctlPaveShow
