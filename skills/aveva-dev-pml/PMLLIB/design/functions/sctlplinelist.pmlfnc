-- File:            sctlplinelist.pmlfnc
--   Type:          Function Definition
--   Group:         Form List Maintenance
--     Keyword:     LST
--   Module:        design
--   Replaces:      DSETPLINE
--
-- Author:          S.Hudson,,,
-- Created:         Mon Feb 24 09:03:18 GMT 1997
--
--
-- Description:
-- Load list gadget with available plines
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     dbref object Element
--    2   R     String       Rule
--    3   RW    String       Status Message
--    4   RW    List Object  List
-- Return:
--   [Data Type] [Description]
--    Boolean     Status ( Success is True)
--
------------------------------------------------------------------------

-- Define function
define function !!sctlPlineList(!element is DBREF, !rule is STRING, !message is STRING, !list is GADGET) is BOOLEAN

!profile = object DBREF()
!pLines[1] = object DBREF()

if ( !!findPlines(!element, !rule, !message, !profile, !pLines) ) then

-- Determine PKEY's
     !pkeys = object BLOCK('!pLines[!evalIndex].pKey')
     !elements = object BLOCK('!pLines[!evalIndex].string()')

-- Load List gadget

     !list.dText = !pLines.evaluate(!pkeys)
     !list.rText = !pLines.evaluate(!elements)
     return True

else

-- Load some default values

     !default[1] = |NA|
     !list.dText = !default
     !default[1] = |Nulref|
     !list.rText = !default
     return false

endif

endfunction
-- End of function definition for !!sctlPlineList
