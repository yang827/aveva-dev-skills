--
-- Description:
-- Calculate Simple Mitre based on bisecting the direction of the sections
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       First Section
--    2   R      string      First Section End
--    3   R      dbref       Second Section
--    4   R      string      Second Section End
-- Return:
--   [Data Type] [Description]
--    Plane       CutPlane required
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSimpleMitre(!first is DBREF, !firstEnd is STRING, !second is DBREF, !secondEnd is STRING)  is VECTOR

  !message = STRING()

  -- Calculate directions of two SCTN
  if (!firstEnd.upcase().subString(1,1) inset ('E','X')) then
       !firstDir = !!consDirTo( !first.pose, !first.poss, !message)
  else
       !firstDir = !!consDirTo( !first.poss, !first.pose, !message)
  endif
  if (!secondEnd.upcase().subString(1,1) inset ('E','X') ) then
       !secondDir = !!consDirTo( !second.pose, !second.poss, !message)
  else
       !secondDir = !!consDirTo( !second.poss, !second.pose, !message)
  endif

  -- Construct Positions in Given Direction
  !thirdPos = object POSITION()
  !thirdPos.east = 0
  !thirdPos.north = 0
  !thirdPos.up = 0
  !thirdPos.origin = WORLD
  !firstPos = !!consPosDistDir( 10000, !firstDir, !thirdPos)
  !secondPos = !!consPosDistDir( 10000, !secondDir, !thirdPos)

  -- Calculate Plane with these Positions
  return !!consPlaneThro(  !firstPos, !secondPos, !thirdPos, !message)

endfunction
-- End of function definition for !!sctlSimpleMitre
