--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineCe(!element is DBREF)

!message = STRING()
!!sctlSpine.spine = object DBREF()
-- Extract spine
if (Set(!element) and !element.hardType eq 'GENSEC' ) then
    !spine = !!findFirstMember(!element, 'SPINE', '', !message)
    !!sctlSpine.spine = !element
endif

if (!!sctlSpine.spine.unset() ) then
    !spine = SPINE 1
    !!sctlSpine.spine = !spine.owner
    if (!spine.unset() ) then
         return error 1 |No Gensec found|
    endif
endif
!!sctlSpine.number = !spine.mCount
if (!spine.mCount ge 1) then
      !!sctlSpine.current = !spine.members[!spine.mCount]
else
      !!sctlSpine.current = object DBREF()
endif
-- Update List gadget
call !!sctlSpineList(!spine)

-- Check to make sure everything is loaded
   if(undefined(!!aidConstructors)) then
      !aidConstructors = object AIDCONSTRUCTORS()
      !aidConstructors.globalInstance()
    endif

-- Change Plane for EDG
!plane = object PLANE()
!plane.orientation = !!sctlSpine.spine.orientation
!plane.position = !!sctlSpine.spine.position
!gphPlane = object GPHPLANE(!plane)
!!edgPosCntrl.setPlane(!gphPlane)

-- Save this plane
!!sctlSpine.plane = !plane

-- Reinitialise gadgets
!!sctlSpine.xPos.val = 0
!!sctlSpine.yPos.val = 0
!!sctlSpine.xCpos.val = 0
!!sctlSpine.yCpos.val = 0
!!sctlSpine.radius.val = 0
!!sctlSpine.yNpos.val = 0
!!sctlSpine.xNpos.val = 0
!!sctlSpine.curve.val = 4

endfunction
-- End of function definition for !!sctlSpineCe
