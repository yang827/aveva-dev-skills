--
-- Description:
-- Create a new spine point at the picked position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineCreate()

-- Navigate to vertex
!!ce = !!sctlSpine.spine
SPINE 1
!spine = !!ce
!spineVertices = !!ce.members
if (!!ce.mCount eq 0) then
   !!sctlSpine.number = 1
elseif (!!sctlSpine.number gt !!ce.mCount) then
   !!ce = !spineVertices[!spineVertices.size()]
   !!sctlSpine.number = !spineVertices.size() + 1
else
   !!ce = !spineVertices[!!sctlSpine.number]
   !!sctlSpine.number = !!sctlSpine.number + 1
endif
-- Create new vertex
NEW POINSP
!position = !!edgGeomData.position.wrt(!!ce.owner.owner)
!position.up = 0
!posString = !position.string()
POS $!posString
!!sctlSpine.current = !!ce

!!ce = REFE

-- Update Form
call !!sctlSpineList(!spine)

endfunction
-- End of function definition for !!sctlSpineCreate
