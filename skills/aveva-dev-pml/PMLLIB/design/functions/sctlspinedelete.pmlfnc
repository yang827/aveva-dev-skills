--
--
-- Description:
-- Delete current spine point or curve
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineDelete()

-- copy details to paste buffer
if (!!sctlSpine.vertices.selection('DTEXT').part(2) eq 'Point') then
     !!sctlSpine.xPos.val = !!sctlSpine.vertices.selection('DTEXT').part(3).real(!!distanceFmt)
     !!sctlSpine.yPos.val = !!sctlSpine.vertices.selection('DTEXT').part(4).real(!!distanceFmt)
     !!sctlSpine.number = !!sctlSpine.vertices.val
     !!sctlSpine.current = !!sctlSpine.vertices.selection().dbRef()
elseif (!!sctlSpine.vertices.selection('DTEXT').part(2) eq 'Curve') then
      !!sctlSpine.xCpos.val = !!sctlSpine.vertices.selection('DTEXT').part(3).real(!!distanceFmt)
     !!sctlSpine.yCpos.val = !!sctlSpine.vertices.selection('DTEXT').part(4).real(!!distanceFmt)
     !!sctlSpine.radius.val = !!sctlSpine.vertices.selection('DTEXT').part(5).real(!!distanceFmt)
     !!sctlSpine.xNpos.val = !!sctlSpine.vertices.selection('DTEXT').part(6).real(!!distanceFmt)
     !!sctlSpine.yNpos.val = !!sctlSpine.vertices.selection('DTEXT').part(7).real(!!distanceFmt)
     !!sctlSpine.curve.select('RTEXT', !!sctlSpine.vertices.selection('DTEXT').part(8) )
     !!sctlSpine.number = !!sctlSpine.vertices.val
     !!sctlSpine.current = !!sctlSpine.vertices.selection().dbRef()
endif


-- Navigate to vertex to be deleted

!refe = !!ce
!!ce = !!sctlSpine.current

-- Remember loop
!spine = !!ce.owner

-- Check that element is of correct type
if (!!ce.type eq |POINSP| ) then

-- Check that deleting element will not give invalid spine
     !number = !spine.members.findFirst(!!ce)
     if (!spine.mCount gt 3) then
          if (!number eq 1) then
               !previous = !spine.mCount
               !next = 2
          elseif (!number eq !spine.mCount) then
               !next = 1
               !previous = !number - 1
          else
               !next = !number + 1
               !previous = !number - 1
          endif
          if (!spine.members[!next].type eq |CURVE| and !spine.members[!previous].type eq |CURVE| ) then
                !!messageFile.error(155, 011)
                return
          endif
     endif
-- Work out new current vertex
     !!sctlSpine.number = !number - 1
     if (!!sctlSpine.number eq 0 ) then
          !!sctlSpine.number = !spine.mCount
     endif
     !!sctlSpine.current = !spine.members[!!sctlSpine.number]

     -- Delete vertex
     DELETE POINSP

elseif (!!ce.type eq |CURVE| ) then
-- Deleting a CURVE can never give invalid spine

-- Work out new current vertex
    !!sctlSpine.number = !spine.members.findFirst(!!ce) - 1
     if (!!sctlSpine.number eq 0 ) then
          !!sctlSpine.number = 1
          if (!spine.mCount lt 2) then
               !!sctlSpine.current = !spine
          else
               !!sctlSpine.current = !spine.members[2]
          endif
     else
          !!sctlSpine.current = !spine.members[!!sctlSpine.number]
     endif
    -- Delete vertex
     DELETE CURVE

else

    !!ce = !refe
    return

endif

-- Redisplay list
call !!sctlSpineList(!spine)
!!ce = !refe
handle any
endhandle

endfunction
-- End of function definition for !!sctlSpineDelete
