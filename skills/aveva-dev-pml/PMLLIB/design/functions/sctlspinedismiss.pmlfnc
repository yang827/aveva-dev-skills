--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineDismiss()

-- Check panel validity
!deleted = false
!volume = !!sctlSpine.spine.rvol
handle any
     !volume = 0
endhandle

if (!volume lt 1 ) then

    !answer = !!alert.confirm('OK to delete curved element as geometry is invalid')
    if (!answer eq 'NO' ) then
         -- Show  Form
          !!sctlSpine.show()
          return
    else
          !!ce = !!sctlSpine.spine
          !type = !!ce.type
          DELETE $!type
          !deleted = true
          if (!!ce.type eq 'WALL' and !!ce.mCount eq 0) then
                   !answer = !!alert.confirm('Wall element is now empty OK to delete')
                   if (!answer eq 'YES' ) then
                       DELETE WALL
                   endif
          endif
    endif

endif

-- Clear EDG
!!edgCntrl.remove('Spine Point Position')

--Clear other forms
if (defined(!!strCurveCent) and !!strCurveCent.shown() ) then
     !!strCurveCentDism()
endif
if (defined(!!strSpineFill) and !!strSpineFill.shown() ) then
     !!strSpineFill.dismiss()
endif
if (defined(!!strSpineRad) and !!strSpineRad.shown() ) then
     !!strSpineRad.dismiss()
endif
if (defined(!!strSpineThru) and !!strSpineThru.shown() ) then
     !!strSpineThru.dismiss()
endif

-- Clear aids
call !!clearAid('TEXT', 43900 )
call !!clearAid('TEXT', 43901 )


-- Delete spine if less than two vertices
if ( not !deleted ) then
     !!ce = !!sctlSpine.spine
     if (!!ce.type eq |WALL| ) then
          SPINE 1
          handle any
          elsehandle none
              !loop = !!ce
              !!ce = !!ce.owner
              if (!loop.mCount lt 2) then
                   DELETE WALL
              else
-- Now move PNODE's attached to ends to first and last points of spine
                    call !!strPnodeSpine(!!sctlSpine.spine)
                    call !!sctlMitreBoth(!!sctlSpine.spine)
              endif
          endhandle
     else
          SPINE 1
          handle any
          elsehandle none
              !loop = !!ce
              !!ce = !!ce.owner
              if (!loop.mCount lt 2) then
                    DELETE GENSEC
              else
-- Now move PNODE's attached to ends to first and last points of spine
                   call !!strPnodeSpine(!!sctlSpine.spine)
                   call !!sctlMitreBoth(!!sctlSpine.spine)
              endif
          endhandle
     endif
endif

endfunction
-- End of function definition for !!sctlSpineDismiss
