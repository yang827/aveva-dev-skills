-- Description:
-- Set up EDG to move current spine point to picked position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineEdit()

-- Don't do anything if already using one of curve forms
if (defined(!!strCurveCent) and !!strCurveCent.shown() ) then
     return
endif

!!edgCntrl.remove('Spine Point Position')
!!edgCntrl.remove('Spine Curve Definition')
!!edgCntrl.remove('Spine Point Navigation')
!!sctlSpine.radio.val = 2

!packet = object EDGPACKET()

!packet.defineWrapper('POSITION','!!sctlSpineMove()','Pick New Position for Spine Point')
!packet.description = 'Spine Point Position'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!sctlSpineEdit
