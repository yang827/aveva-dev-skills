--
--
-- Description:
-- Insert new spine point from buffer after current
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN      Before
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineInsert(!before is BOOLEAN)

--Add new vertex with values in buffer

!refe = !!ce
!message = STRING()

if (set(!!sctlSpine.current) ) then
     !!ce = !!sctlSpine.current
-- if inserting before then go to previous vertex
     if (!before) then
          PREVIOUS
          handle any
-- if first vertex then go to owner (insert at start)
               END
          endhandle
      endif
else
     !spine = !!findFirstMember(!!sctlSpine.spine, 'SPINE', '', !message)
     if (!spine.mCount ge 1) then
          !!ce = !spine.members[!spine.mCount]
     else
          !!ce = !spine
     endif
endif
NEW POINSP
!!sctlSpine.current = !!ce
!position = 'E' & !!sctlSpine.xPos.val.string(!!distanceFmt) & ' N' & !!sctlSpine.yPos.val.string(!!distanceFmt) & ' U0'
AT $!position

-- No update list
!spine = !!ce.owner
!!sctlSpine.number = !spine.members.findFirst(!!ce)
call !!sctlSpineList(!spine)
!!ce = !refe

endfunction
-- End of function definition for !!sctlSpineInsert
