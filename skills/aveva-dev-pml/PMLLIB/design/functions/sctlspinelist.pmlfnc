--
--
-- Description:
-- Update List gadget with information on spine
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineList(!spine is DBREF)

-- Clear Aid Text
call !!clearAid('TEXT', 43900 )
call !!clearAid('TEXT', 43901 )

-- Fill List gadget with values
!size = !spine.members.size()
if (!size gt 0) then
     do !index from 1 to !size
-- Vertex
                !string = !index.string('D0')
                if (!string.length() eq 1) then
                     !string = '  ' & !string
                elseif (!string.length() eq 2) then
                     !string = ' ' & !string
                endif
          if(!spine.members[!index].type eq 'POINSP') then
-- Type

                !list[!index] = !string & ' Point '
                !numbers[!index] = !spine.member[!index].string()
-- X
                !string = !spine.member[!index].position.east.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                      !string =  ' ' & !string
                enddo
                !list[!index] = !list[!index] + !string
-- Y
                !string = !spine.member[!index].position.north.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                      !string = ' ' & !string
                enddo
                !list[!index] = !list[!index] & !string
          else
-- Curve
                !list[!index] = !string & ' Curve '
                !numbers[!index] = !spine.member[!index].string()
-- X
                !string = !spine.member[!index].position.east.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                      !string =  ' ' & !string
                enddo
                !list[!index] = !list[!index] + !string
-- Y
                !string = !spine.member[!index].position.north.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                      !string = ' ' & !string
                enddo
                !list[!index] = !list[!index] & !string
-- Radius
                !string = !spine.member[!index].radius.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                       !string = ' ' & !string
                enddo
                !list[!index] = !list[!index] & !string
-- Conditioning Point
-- X
                !string = !spine.member[!index].cPosition.east.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                      !string =  ' ' & !string
                enddo
                !list[!index] = !list[!index] + !string
-- Y
                !string = !spine.member[!index].cPosition.north.string(!!distanceFmt)
                !characters = !string.length()
                do !fill from !characters to 10
                      !string = ' ' & !string
                enddo
                !list[!index] = !list[!index] & !string
-- Type
                !string = !spine.member[!index].curType
                !list[!index] = !list[!index] & ' ' & !string
           endif
-- Add aid text
           if (!index eq !!sctlSpine.number ) then
                 !text =  !index.string('D0') & '*'
                 call !!drawAidText(!text, !spine.member[!index].position.wrt(WORLD), 43901 )
           else
                 !text = !index.string('D0')
                 call !!drawAidText(!text, !spine.member[!index].position.wrt(WORLD), 43900 )
           endif

     enddo
-- Update List gadget
     !!sctlSpine.vertices.dText = !list
     !!sctlSpine.vertices.rText = !numbers
     !!sctlSpine.vertices.val = !!sctlSpine.number
else
     !list[1] = 'None'
     !!sctlSpine.vertices.dText = !list
     !!sctlSpine.vertices.rText = !list
     !!sctlSpine.vertices.val = 1
endif

-- Check panel validity
!volume = !!sctlSpine.spine.rvol
handle any
     !volume = 0
endhandle
if (!volume gt 1 ) then
     !!sctlSpine.valid.val = ''
else
     !!sctlSpine.valid.val = 'Spine Geometry Incorrect'
endif


-- if distance and direction change arrow
if (defined(!!strSpineRel) and !!strSpineRel.shown() ) then
      !!strSpineRel.arrow()
endif

endfunction
-- End of function definition for !!sctlSpineList
