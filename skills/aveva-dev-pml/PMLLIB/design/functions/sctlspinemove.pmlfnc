--
-- Description:
-- Move spine point to position picked
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineMove()

-- Navigate to vertex
!!ce = !!sctlSpine.spine
SPINE 1
!spine = !!ce
!spineVertices = !!ce.members

-- Modify vertex
!!ce = !spineVertices[!!sctlSpine.number]
!position = !!edgGeomData.position.wrt(!!ce.owner.owner)
!position.up = 0
!posString = !position.string()
POS $!posString
!!sctlSpine.current = !!ce

!!ce = REFE

-- Update Form
call !!sctlSpineList(!spine)

endfunction
-- End of function definition for !!sctlSpineMove
