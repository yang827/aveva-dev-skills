--
-- Description:
-- Navigate to picked vertex
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineNavi()

-- change current vertex indication

call !!clearAid('TEXT', 43801 )
!text = !!sctlSpine.number.string('D0')
call !!drawAidText(!text, !!sctlSpine.current.position.wrt(WORLD), 43800 )

!!sctlSpine.current = !!edgGeomData.nearestVertex
!!sctlSpine.number = !!sctlSpine.current.owner.members.findFirst(!!sctlSpine.current)

-- mark current vertex
     !text = !!sctlSpine.number.string('D0') & '*'
     call !!drawAidText(!text, !!sctlSpine.current.position.wrt(WORLD), 43801 )
-- Select correct vertex on list
!!sctlSpine.vertices.val = !!sctlSpine.number

-- if distance and direction change arrow
if (defined(!!strSpineRel) and !!strSpineRel.shown() ) then
      !!strSpineRel.arrow()
endif
-- Switch to Edit

call !!sctlSpineEdit()


endfunction
-- End of function definition for !!sctlSpineNavi
