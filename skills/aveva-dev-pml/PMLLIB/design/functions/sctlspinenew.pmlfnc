-- Define function
define function !!sctlSpineNew()

-- Don't do anything if using one of curve creation forms
if (defined(!!strCurveCent) and !!strCurveCent.shown() ) then
     return
endif

!!edgCntrl.remove('Spine Point Position')
!!edgCntrl.remove('Spine Curve Definition')
!!edgCntrl.remove('Spine Point Navigation')
!!sctlSpine.radio.val = 1

!packet = object EDGPACKET()

!packet.defineWrapper('POSITION','!!sctlSpineCreate()','Pick Position to Create Spine Point')
!packet.description = 'Spine Point Position'


!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!sctlSpineNew
