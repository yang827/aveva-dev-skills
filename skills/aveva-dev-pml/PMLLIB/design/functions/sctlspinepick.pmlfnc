-- Description:
-- Set up EDG to change current spine point to the picked position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpinePick()

!!edgCntrl.remove('Spine Point Position')
!!edgCntrl.remove('Spine Curve Definition')
!!edgCntrl.remove('Spine Curve Definition')
!!sctlPave.radio.val = 3

!packet = object EDGPACKET()
!packet.defineWrapper('PICKVERTEX','!!sctlSpineNavi()','Pick Current Point', !!sctlSpine.spine)
!packet.description = 'Spine Point Position'

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!sctlSpinePick
