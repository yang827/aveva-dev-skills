-- Description:
-- Replace current spine point with values from buffer
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineReplace()

!refe = !!ce
!!ce = !!sctlSpine.current
!position = 'E' & !!sctlSpine.xPos.val.string(!!distanceFmt) & ' N' & !!sctlSpine.yPos.val.string(!!distanceFmt) & ' U0'
AT $!position

-- No update list
!spine = !!ce.owner
!!sctlSpine.number = !spine.members.findFirst(!!ce)
call !!sctlSpineList(!spine)
!!ce = !refe

endfunction
-- End of function definition for !!sctlSpineReplace
