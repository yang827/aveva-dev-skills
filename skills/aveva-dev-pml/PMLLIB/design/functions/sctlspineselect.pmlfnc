--
--
-- Description:
-- Select current vertex from list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineSelect()

-- change current vertex indication

call !!clearAid('TEXT', 43901 )
!text = !!sctlSpine.number.string('D0')
call !!drawAidText(!text, !!sctlSpine.current.position.wrt(WORLD), 43900 )

-- Update current vertex
!!sctlSpine.number = !!sctlSpine.vertices.val
!!sctlSpine.current = !!sctlSpine.vertices.selection().dbRef()

-- mark current vertex
     !text =  !!sctlSpine.number.string('D0') & '*'
     call !!drawAidText(!text, !!sctlSpine.current.position.wrt(WORLD), 43901 )

-- if distance and direction change arrow
if (defined(!!strSpineRel) and !!strSpineRel.shown() ) then
      !!strSpineRel.arrow()
endif

endfunction
-- End of function definition for !!sctlSpineSelect
