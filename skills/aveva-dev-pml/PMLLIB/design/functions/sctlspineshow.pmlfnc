--
--
-- Description:
-- Show the form and set up EDG
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlSpineShow(!spine is DBREF, !mode is STRING)

if (!spine.type ne |GENSEC| and !spine.type ne |WALL| ) then
     WALL
     handle any
          GENSEC
     endhandle
     !element = !!ce
else
     !element = !spine
endif

-- Show form
show !!sctlSpine

-- Save Parameters as members of form
!!sctlSpine.spine = !element
!!sctlSpine.origin = !element.position
!!sctlSpine.plane.orientation = !element.orientation
!!sctlSpine.plane.position = !element.position
!!sctlSpine.number = 1

-- Set up event driven graphics
if (!mode.upcase() eq 'CREATE' ) then
     call !!sctlSpineNew()

elseif (!mode.upcase() eq 'MODIFY' ) then
     call !!sctlSpineEdit()

else
     call !!sctlSpineNavi()
endif

-- Set up form for current element
call !!sctlSpineCe(!element)

endfunction
-- End of function definition for !!sctlSpineShow
