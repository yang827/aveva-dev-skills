-- Created:         Fri Mar 14 15:19:37 GMT 1997
--
--
-- Description:
-- String Element between given nodes
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      String      Type ( STCN or STWALL )
--    2   R      String      Application
--    3   R      dbref       Start Node
--    4   R      dbref       End Node
-- Return:
--   [Data Type] [Description]
--    dbref       Section Created
--
------------------------------------------------------------------------

-- Define function
define function !!sctlStringElem(!type is STRING, !application is STRING, !start is DBREF, !end is DBREF) is DBREF

  !refe = !!ce

  -- Find Storage Area
  !store = !!findStorageArea(!application, !type)
  if (undefined(!store) or Unset(!store) ) then
    call !!dbRefUpdate(!refe)
    !!ce = !refe

  else
    !!ce = !store
  endif

  -- Create Element
  STRING $!type FROM $!start TO $!end
  if (!type eq |STWALL| or !type eq |WALL| ) then
    CHANGETYPE TO $!type
  endif
  !return = REFE

  -- Set Name
  if(!!namOpt.auto() ) then
    !name = !!namOpt.nameString(!return, ||, true, false)
    if (!name.unset().not()) then
      NAME /$!name
    endif
  endif

  -- Set Design Parameters
  if (!type eq |STWALL| or !type eq |WALL| ) then
    !noOfDesp = !!cvWallSpec.default.desp.size()
    !despString = ' '
    if (!noOfDesp gt 0) then
         do !index from 1 to !noOfDesp
             !despString = !despString  & !!cvWallSpec.default.desp[!index] & ' '
         enddo
         DESP $!despString
    endif
  endif

  -- Set Specification
  if (!type eq |STWALL| or !type eq |WALL| ) then
    SPRE $!!cvWallSpec.default.spre
    handle any
      !!messageFile.error(157, 001)
    endhandle

    -- Make a template
    if (Set(!!cvWallSpec.default.spre.tmpr) ) then
      NEW TMPL
      !template = !!cvWallSpec.default.spre.tmpr
      COPY REXECUTE $!template
      !!ce = !return

    else
      -- Set GTYPE
      !value =  !!cvWallSpec.default.spre.catRef.gtyp
      GTYPE $!value
    endif
  endif

  -- Set Justification
  if (!type eq |STWALL| or !type eq |WALL| ) then
    JUSL $!!cvWallSpec.default.just
    MEML $!!cvWallSpec.default.meml
    JLIN $!!cvWallSpec.default.jLin
  endif

  !!ce = REFE

  return !return

endfunction
-- End of function definition for !!sctlStringElem
