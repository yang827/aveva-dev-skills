-- Created:         Mon Apr 28 08:53:07 BST 1997
--
--
-- Description:
-- Trace around connected linear elements returning
-- elements and positions
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sctlTraceElement(!element is DBREF, !passedEnd is STRING, !sense is BOOLEAN, !loopRefs is ARRAY) is ARRAY

  -- Initialise Variables
  !wall = !element
  !end  = !passedEnd
  !type = STRING()
  !type.unset()

  -- Initialise Loop Variables
  !loop = ARRAY()
  !loop.clear()
  !loopRefs.clear()
  !alreadyHit = ARRAY()
  !alreadyHit.clear()

  -- Loop for each encountered element

  do !i

  -- Checks if node is a pnode, whether node has been encountered previously,
  -- and appends appropriate vertex to result array

    if (!type eq 'PNOD' or !i eq 1) then

       if (!end.upcase() eq 'START' ) then
          break if ( !alreadyHit.findFirst(!wall.poss.wrt(World)).set() )
          !loop.append(!wall.poss.wrt(World))
          !alreadyHit.append(!wall.poss.wrt(World))
       else
          break if ( !alreadyHit.findFirst(!wall.pose.wrt(World)).set() )
          !loop.append(!wall.pose.wrt(World))
          !alreadyHit.append(!wall.pose.wrt(World))
       endif

    endif

  -- Checks for snode and appends appropriate vertex to result array

    if (!type eq 'SNOD' ) then

       if (!thisEnd.upcase() eq 'START') then
          !loop.append(!thisWall.pose.wrt(World))
          !alreadyHit.append(!thisWall.poss.wrt(World))
       else
          !loop.append(!thisWall.poss.wrt(World))
          !alreadyHit.append(!thisWall.pose.wrt(World))
       endif

    endif

    -- Enhance Item
    call !!enhanceItem(!wall, !!gphColOpt.highlight().string())

    -- Set thisWall to account for no attached walls
    !thisWall = !wall

    -- Set thisEnd to account for snodes
    !thisEnd = !end

    -- Add wall into dbref trace array
    !loopRefs.append(!wall)

    -- Get the next wall
    !wall = !!sctlFindAttached(!thisWall,!end,!sense,!type)

    -- Break if no further elements and append appropriate
    -- vertex to result array

    if ( !wall.unset() and !end.upcase() eq 'START' ) then
       !loop.append(!thisWall.pose.wrt(World))
       break
    elseif ( !wall.unset() and !end.upcase() eq 'END' ) then
       !loop.append(!thisWall.poss.wrt(World))
       break
    endif

    break if(!i gt 100)

  enddo

  return !loop

endfunction
-- End of function definition for !!sctlTraceElement
