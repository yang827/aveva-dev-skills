--
--
-- Description:
-- Calculate zdist of given position of given element.
--   Position is relaxed on to element.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Element (hard type of SCTN)
--    3   R      position    Position not necessarily on pline
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!sctlZDistOfPos(!element is DBREF, !position is POSITION) is REAL

  if (!element.hardType ne |SCTN| ) then
    !!messageFile.error(155, 001)
  endif

  -- Calculate distance from start to this new position
  !startDist = !element.poss.distance(!position)
  !endDist = !element.poss.distance( !position)

  if (!endDist gt !startDist and !endDist gt !element.leng) then
    return ( -1 * !startDist)
  else
    return ( !startDist)
  endif

endfunction
-- End of function definition for !!sctlZDistOfPos
