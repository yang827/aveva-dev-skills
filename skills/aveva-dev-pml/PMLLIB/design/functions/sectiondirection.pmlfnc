--
--
-- Description:
-- Returns the direction of a section from start to end (default z direction)
-- or end to start.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section name
--    2   R      STRING      Start or End
-- Return:
--   [Data Type] [Description]
--   DIRECTION    Section direction
--
------------------------------------------------------------------------

-- Define function
define function !!sectionDirection (!section is DBREF, !end is STRING) is DIRECTION

  -- Initialise Variables
  !returnDir = !section.ori.zDir()

  -- If we are going from End to Start, then transpose Y directions
  if(!end.upcase() eq 'END') then
    !returnDir.east  = !returnDir.east   * -1
    !returnDir.north = !returnDir.north  * -1
    !returnDir.up    = !returnDir.up     * -1
  endif

  return !returnDir

endfunction
-- End of function definition for !!sectionDirection
