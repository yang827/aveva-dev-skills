-- Author:          N.Holmes
-- Created:         Mon Mar 24 18:09:27 WAT 1997
--
--
-- Description:
-- Re-positions passed sections start and end at the passed positions, if
-- necessary. The function can force JFREE joint to be re calculated, to the
-- new positions by passing true for the force flag. If the force flag is
-- set to false, then the current setting of JFREE will be used to reposition.
-- Force flag will put the JFREE back to its original setting when complete.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section to have its ends moved
--    2   R      POSITION    Section Start Position
--    3   R      POSITION    Section End Position
--    4   R      BOOLEAN     JFREE force flag.

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sectionPosition (!section is DBREF, !posStart is POSITION, !posEnd is POSITION, !forceFlag is BOOLEAN)


  -- Initialise Variables
  !currentElement = !!ce

  -- Move to Section
  !!ce = !section

  -- Modify Start
  if(!!distanceFromTo(!section.poss,!posStart) gt 0) then
    POSS $!posStart

    -- Modify Joint Start
    if(!section.joist.set()) then
      call !!jointRePosition(!section.joiS,!forceFlag)
    endif
  endif

  -- Modify End
  if(!!distanceFromTo(!section.pose,!posEnd) gt 0) then
    POSE $!posEnd

    -- Modify Joint End
    if(!section.joiEnd.set()) then
      call !!jointRePosition(!section.joiE,!forceFlag)
    endif
  endif

  -- Return
  !!ce = !currentElement

endfunction
-- End of function definition for !!sectionPosition
