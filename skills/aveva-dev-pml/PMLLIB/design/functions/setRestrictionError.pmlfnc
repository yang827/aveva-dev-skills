--
-- Description:
-- Sets the Error string returned from the restriction objects.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!setRestrictionError(!assoc is DBREF, !restri is DBREF, !err is STRING)
  if (undefined(!!restrictionErrors)) then
    !!restrictionErrors = object HMRESTRICTIONERRORS()
  endif
  !!restrictionErrors.initialise(!assoc, !restri, TRUE)
  !!restrictionErrors.setErr(!err)

endfunction
-- End of function definition for !!setRestrictionError
