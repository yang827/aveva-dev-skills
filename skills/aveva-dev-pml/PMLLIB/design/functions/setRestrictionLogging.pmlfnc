--
-- Description:
-- Sets whether or not a restriction error log file should be generated by the restriction cache object.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1    R      BOOLEAN     Switch error logging on/off
--   2    R      BOOLEAN     Should open log in APPEND mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!setRestrictionLogging(!onOff is BOOLEAN, !append is BOOLEAN)
  if (undefined(!!restrictionErrors)) then
    !!restrictionErrors = object HMRESTRICTIONERRORS()
  endif
  !!restrictionErrors.fileErrors(!onOff, !append)

endfunction
-- End of function definition for !!setRestrictionError
