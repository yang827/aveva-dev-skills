--
--
--
-- Description:
--    Initialise the cabling forms
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     FORM        form for which field property is to be changed
--    2   R     STRING      coordinate system (ENU or XYZ)
--

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!setcoordinate(!form is FORM, !coord is STRING)

 --set the coordinate
 coordinate $!coord

 --update menu
 if !coord.eq('ENU') then
 	!form.syscoord.setfieldproperty('Enucoord','SELECTED',TRUE)
 	!form.syscoord.setfieldproperty('Xyzcoord','SELECTED',FALSE)
 elseif !coord.eq('XYZ') then
 	!form.syscoord.setfieldproperty('Enucoord','SELECTED',FALSE)
 	!form.syscoord.setfieldproperty('Xyzcoord','SELECTED',TRUE)
 endif


endfunction
