--
--
-- Description: function to show the specchange form at pipe or bran level
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R
--    2   R
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
-- Define function
define function !!specborechange(!startpoint is STRING)


if undefined( !!specborechange ) then
  pml load form !!specborechange
endif

!!specborechange.element = !startpoint

show !!specborechange

endfunction
-- end of function definition
