--
--
-- Description:
-- function to grey out spec selection on main ASL form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [BOOLEAN]   [True  - Active]
--                          [False - Inactive]
--   [2] [R]    [BOOLEAN]   [True  - called from angle or direction gadget]
--                          [False - not called from angle or direction]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!specStatus(!status is BOOLEAN,!vector is BOOLEAN)

    !!aslSpec.loadSpec.active = !status
    !!aslSpec.specifications.active = !status
    !!aslSpec.selected.active = !status
    !!aslSpec.perms.active = !status
--    !!aslSpec.sort.active = !status
--    !!aslSpec.spre.active = !status
    !!aslSpec.direction.active = !status
    !!aslSpec.angle.active = !status

    if(!vector) then
       !!aslSpec.direction.active = !status
       !!aslSpec.angle.active = !status
    endif

endfunction
-- End of function definition for !!specStatus
