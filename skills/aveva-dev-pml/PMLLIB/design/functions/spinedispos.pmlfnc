--
-- Author:          Jaideep (DDC - Chennai)
-- Created:
--
--
--
-- Description:
--    Returns the distance of a passed position from the start point
--    of the spine (Use with caution for closed spines) - DDC
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!spineDisPos(!element is DBREF, !position is POSITION) is REAL

if(!element.hardType ne |GENSEC| ) then
    !!alert.error('Element is not a GENSEC')
    return
endif

-- Extract position wrt world
!posOnElement = !position.wrt(WORLD)

-- Extract geometry of the profile
!spine        = !!dtbMemberOfType(!element,'SPINE',1)
!profile      = object PROFILE(!spine)
!polyLine     = !profile.edges()

-- Check whether the position lies on the profile
!posOnProfile = !profile.near(!posOnElement)
!disPosPro    = !posOnProfile.distance(!posOnElement)

-- Method !profile.onProfile() doesnt allow much tolerance. So using this method
if(!disPosPro lt 0.1mm) then
else
   !!alert.error('Position does not lie on the spine')
   return
endif

-- Finding the nearest edge(s) of the profile
!edgeProx     = !profile.nearEdges(!posOnElement)

-- For circular profiles
if((!polyLine.size() eq 1) AND (!polyLine[1].objectType() eq 'ARC')) then
   -- Single , completely circular profiles cannot be handled otherwise
   !polyLines = !polyLine[1].split(2)

   !polyLines[1].sense = !polyLine[1].sense
   !polyLines[2].sense = !polyLine[1].sense
   !polyLine  = !polyLines
endif

-- Calculate distance from start point of the profile to the position
!distPos      = 0
do !i indices !polyLine
   if(!profile.isClosed().not() AND (!i neq !edgeProx.first() AND !i neq !edgeProx.last())) then
      !distPos = !distPos + !polyLine[!i].length()
      skip
   endif

   !type      = !polyLine[!i].objectType()
   !tolerance = !posOnElement.distance(!polyLine[!i])

   -- Check if the position is on the geometry (line/arc)
   if(!tolerance lt 0.1mm) then   $* Method !polyLine[!i].on() doesnt allow much tolerance.
      if(!type eq 'LINE') then

         -- To make sure that the position is not on the extended line
         if(!polyLine[!i].onProjected(!posOnElement)) then
            !polyStart = !polyLine[!i].startposition
            !disStPos  = !polyStart.distance(!posOnElement)
            !distPos   = !distPos + !disStPos
            break
         else

            !distPos = !distPos + !polyLine[!i].length()
         endif

      elseif(!type eq 'ARC') then

         !arcStartAng  = !polyLine[!i].startangle
         !arcStartPos  = !polyLine[!i].anglePosition(!arcStartAng)
         if(!arcStartPos.near(!posOnElement,0.01mm)) then

            !arcLength = 0
         else
            !newArc    = !polyLine[!i].endposition(!posOnElement)
            !arcLength = !newArc.length()

         endif
         !distPos = !distPos + !arcLength
         break
      endif
   else

      !distPos = !distPos + !polyLine[!i].length()
   endif

enddo

return  !distPos

endfunction
-- End of function definition for !!spineDisPos
