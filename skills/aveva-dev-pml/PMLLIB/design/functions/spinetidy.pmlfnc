--
--
--
-- Description:
--    Removes extra POINSP if any and converts CURVEs to a modifiable curType
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!spineTidy(!gensec is DBREF) is DBREF

-- Store CE
!refElem  =  !!ce
if(!gensec.hardType ne |GENSEC| ) then
   !!alert.error('Only GENSECs can be handled')
   return
endif

-- Extract geometry of the profile
!spine        =   !!dtbMemberOfType(!gensec,'SPINE',1)
!profile      =   object PROFILE(!spine)

-- Take out members of the spine
!spineMem     =   !spine.members

-- Collect all curves and corresponding arcs
!collCurve    =   ARRAY()
!collArc      =   ARRAY()

do !i indices !spineMem
   skip if(!spineMem[!i].type eq 'POINSP')
   !collCurve.append(!spineMem[!i])
enddo
!collCurve.compress()

!edges     =   !profile.edges()
do !i indices !edges
   skip if(!edges[!i].objectType() eq 'LINE')
   !collArc.append(!edges[!i])
enddo
!collArc.compress()

-- Convert all the curves into either of type CENT or FILL
do !i indices !collCurve
   if((!collCurve[!i].curType ne 'FILL') AND (!collCurve[!i].curType ne 'CENT'))then
      !arcAngle   =  !collArc[!i].angle()

      !collCurve[!i].bulgeFactor =  0
      !collCurve[!i].radius      =  !collArc[!i].radius
      if(!arcAngle  ge 170)then
         !arcEndAngle = !collArc[!i].endangle
         !collCurve[!i].curType     =  'CENT'
         !collCurve[!i].position    =  !collArc[!i].position

         if(!collArc[!i].sense) then
            !collCurve[!i].cposition = !collArc[!i].anglePosition(!arcEndAngle - (!arcAngle / 2))
         else
            !collCurve[!i].cposition = !collArc[!i].anglePosition(!arcEndAngle + (!arcAngle / 2))
         endif
      else
         !collCurve[!i].curType     =  'FILL'
         !collCurve[!i].cposition   =  !gensec.position
         !collCurve[!i].position    =  !collArc[!i].pole()
      endif
   endif
enddo

-- Delete redundant poinsps
do !i indices !spineMem
   skip if((!i eq 1) OR (!spineMem[!i].type eq 'CURVE') or (!i eq !spineMem.size()))
   if(!spineMem[!i + 1].type eq 'POINSP')then
      $!spineMem[$!i]
      DELETE POINSP
   endif
enddo

!!ce  = !spine.members[2]
if((!!ce.type eq 'POINSP') AND (!spine.members.size() gt 2))then
   DELETE POINSP
endif

-- Reset CE
!!ce   =  !refElem
handle (2,822)
endhandle

return  !gensec
endfunction
-- End of function definition for !!spineTidy
