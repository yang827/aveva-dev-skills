--
--
-- Description:
-- function to create event packet for picking position for calculating the zdist
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!stlCalcZDist()

!packet = object EDGPACKET()

  !packet.definePosition('Position Element')
  !packet.description = 'Position Element'
  !packet.action      = '!!posCalcZDist(!this.return[1])'
  !packet.type        = 'Positioning'
  !packet.key         = 'ZDistCalc'


  !!edgCntrl.add(!packet)



endfunction
-- End of function definition for !!stlCalcZDist
