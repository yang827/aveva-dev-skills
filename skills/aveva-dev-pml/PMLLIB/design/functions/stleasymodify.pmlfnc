--
--  Description:     Utilities for Easy Modifying On Steel-work
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action Type
--    2   R      BOOLEAN     Offset Flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!stlEasyModify(!taskType is STRING, !offsetFlag is BOOLEAN)

  -- check catalogue OK for tasks requiring a joint
  if (!taskType inset('JOINT','JOINT_NEIGHBOUR')) then
    !unusedTestJoint = object DBREF('/ENDCUTS/ANGLE/JOIN')
    handle any
      !!alert.error('This function is not available because the catalogue does not contain special joint /ENDCUTS/ANGLE/JOIN. Please contact your System Administrator')
      -- deactivate both buttons they require this joint
      !!appDesMain.btnAttachToModel.active              = false
      handle any
      endhandle
      !!appDesMain.btnAttachToModelWithNeighbour.active = false
      handle any
      endhandle
      return
    endhandle
  endif

  !!stlModify  = object STLSIMPLEMODIFY()

  if (!taskType.eq('PANEL_DEFAULT_SPEC')) then

    !!stlModify.setPanelDefaultSpec()
    return

  endif

  -- Initialise variables
  !prompt               = 'Pick plane or line on destination element'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.pickPacket.picks[1].stdGraphics('')

  if (!taskType inset ('ENDCUT','COPY_OTHER_PARTS','CREATE_PANEL_USING_SCTN','CHANGE_SPEC')) then
    -- check if there are selected elements or not
    if (!!stlModify.checkSelectedElements().not()) then
      return
    endif

    !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|SCTN|,|GENSEC|)'
    !packet.pickPacket.picks[1].pick.modifiable = false
  elseif (!taskType eq 'JOINT') then
    if (!!stlModify.checkSelectedElements().not()) then
      return
    endif

    if (!!stlModify.checkSectionGtype().not()) then
      return
    endif

    !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|SCTN|)'
    !packet.pickPacket.picks[1].pick.modifiable = false
  elseif (!taskType eq 'JOINT_NEIGHBOUR') then
    -- no selection needed for this function
    !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|SCTN|)'
    !packet.pickPacket.picks[1].pick.modifiable = false
  endif

  !packet.escape        = '!!edgCntrl.escape()'
  !packet.remove        = true

  if (!taskType.eq('ENDCUT')) then
    !prompt               = 'Pick plane or line on destination element < ESC >  to exit'

    if (!offsetFlag) then
      !packet.action      = '!!stlModify.trimSelectedSections(!this.return[1], true)'
    else
      !packet.action      = '!!stlModify.trimSelectedSections(!this.return[1], false)'
    endif

  elseif(!taskType.eq('TRIMTO')) then
    !!stlModify.trimTo()
    return

  elseif (!taskType.eq('ENDCUT_DELETE')) then
    !prompt               = 'Pick End of SCTN or GENSEC Part < ESC >  to exit'
    !packet.action        = '!!stlModify.deleteEndcut(!this.return[1])'
    !packet.remove        = false

  elseif (!taskType.eq('JOINT')) then
    !prompt               = 'Pick Owner Element < ESC >  to exit'
    !packet.action        = '!!stlModify.insertJointWithSelectedItems(!this.return[1])'

  elseif (!taskType.eq('JOINT_NEIGHBOUR')) then
    !prompt               = 'Pick Owner Element < ESC >  to exit'
    !packet.action        = '!!stlModify.insertJointWithAdjacencyElem(!this.return[1])'

  elseif (!taskType.eq('DELETE_JOINT')) then
    !prompt               = 'Pick target joint < ESC >  to exit'
    !packet.action        = '!!stlModify.deleteJoint(!this.return[1])'
    !packet.remove        = false

  elseif (!taskType.eq('COPY_OTHER_PARTS')) then
    !prompt               = 'Pick owner element'
    !packet.action        = '!!stlModify.copyFromOtherPart(!this.return[1], false)'

  elseif (!taskType.eq('SCTN_MITRE')) then
    !!stlModify.simpleSctnMitre()
    return

  elseif (!taskType.eq('INSERT_OTHER_PARTS')) then
    !prompt               = 'Pick element, please'
    !packet.action        = '!!stlModify.copyFromOtherPart(!this.return[1], true)'

  elseif (!taskType.eq('CHANGE_SPEC')) then
    !prompt               = 'Pick source element, please'
    !packet.action        = '!!stlModify.changeSpec(!this.return[1])'

  elseif (!taskType.eq('CREATE_SCTN_USING_PANEL')) then
    !defaultSpec = !!appDesMain.spre.val

    if (!defaultSpec.upcase() eq 'UNSET') then
      !!alert.error(|Please select a default profile specification|)
      return
    endif

    !prompt               = 'Pick target panel, please'
    !packet.action        = |!!stlModify.createSctnUsingPanel(!this.return[1])|

  elseif (!taskType.eq('CREATE_PANEL_USING_SCTN')) then
    !prompt               = 'Pick target sctn, please'
    !!stlModify.createPanelUsingSCTN()
    return
  endif

  --Change the type of EDG data depending on the task
  if (!taskType inset ('ENDCUT_DELETE','DELETE_JOINT','COPY_OTHER_PARTS','INSERT_OTHER_PARTS','CHANGE_SPEC')) then
    !packet.elementPick(!prompt)
  else
    !packet.definePosition(!prompt)
  endif

  -- Add event to system
  !!edgCntrl.add(!packet)
endfunction
