-- Description:
-- Joint dominant/subordinate function
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Dominant/subordinate
--    2   R      STRING      End of section
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!stlJointDomSub(!mode is BOOLEAN, !end is STRING) is BOOLEAN

  !!stlDomSub = object STLJOINTPRIORITY()
  !!stlDomSub.setup(!mode, !end)

  return true
endfunction
