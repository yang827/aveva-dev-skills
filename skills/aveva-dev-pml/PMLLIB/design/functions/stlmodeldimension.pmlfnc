--  Description:     Dimension Utilities For SCTN / PANEL On Outfitting Design
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN    True for draw dimension or false for tidy dimension
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!stlModelDimension(!makeFlag is BOOLEAN)

  -- Define global instance to allow for created dimensions to be deleted
  if( not defined(!!stlModelDimension) ) then
    !!stlModelDimension = object STLMODELDIMENSION()
  endif

  -- If make flag is true, it'll be made dimension On Current 3D View.
  if (!makeFlag) then
    !!stlModelDimension.drawDimension(!!ce)
  else
    !!stlModelDimension.tidy()
  endif

endfunction
