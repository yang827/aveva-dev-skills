--
--
-- Description:
-- Create a GENSEC from information on form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!stlNewGensecGo()

  !!stlNewGensec.tidy()

  -- Now create the panel
  call !!sctlCrElem('GENSEC', |BANDC| )

  if (Set(!!ce.owner.spre) and Set(!!ce.owner.spre.tmpr) ) then
  -- template
  else
  -- non-template
       !!ce = !!ce.owner
  endif
  -- Set the position
  !posString = !!stlNewGensec.points[1].string()
  POS $!posString

  -- Set the orientation
  !oriString = !!stlNewGensec.plane.orientation.string()
  ORI $!oriString

  -- If it is a template
  if (Set(!!ce.spre) and Set(!!ce.spre.tmpr) ) then

    -- Set design parameters
    var !!cdcaAttr DELETE
    var !!cdcaAttd DELETE
    var !!cdcaDesp DELETE
    var !!cdcaPass DELETE
    !!cdcaPass[1] = 'Set Template Parameters'
    !!cdcaPass[2] = 'CALLCIV MPANELTMPL'
    !!cdcaPass[3] = ''
    $m "%PDMSUI%/DES/CLIB/XSETPROP" $<DEFINE$> $<$!!<ce.spre>$> $<!!cdcaPass$> $<$!!<ce>$>

  -- Otherwise bring up vertex editor
  else
            !!ce = SPINE 1

  -- Use the points already given
       if (!!stlNewGensec.create.val ) then
            do !vertex values !!stlNewGensec.points
                 !posString = !vertex.wrt(!!ce.owner).string()
                 NEW POINSP
                 POSITION $!posString
            enddo
            !!ce = SPINE 1
      endif
      call !!sctlSpineShow(!!ce.owner, 'CREATE')

  endif

endfunction
-- End of function definition for !!stlNewGensecGo
