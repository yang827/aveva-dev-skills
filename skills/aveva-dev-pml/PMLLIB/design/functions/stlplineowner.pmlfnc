--
--
-- Description:
-- Returns owning item that contains the  PLINES.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!stlPlineOwner(!element is DBREF) is DBREF

  -- Initialise Variables
  !owner = !element

  -- Loop up the owner stack until we find an owner with
  -- plines defined against it
  do

    -- Check if item has a plnames result
    !unusedPlNames = !owner.plNames
    handle any
      if(!owner.fullType eq 'WORLD') then
        return object DBREF()
      endif
      !owner = !owner.owner
    elsehandle none
      return !owner
    endhandle
  enddo

endfunction
-- End of function definition for !!stlPlineOwner
