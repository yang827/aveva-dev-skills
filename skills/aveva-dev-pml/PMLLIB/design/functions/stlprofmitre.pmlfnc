-- Define function
define function !!stlProfMitre()

  -- has to be a global instance for EDG callbacks
  !!stlProfMitre = object STLPROFMITRE()
  !!stlProfMitre.pickProfiles(false)

endfunction
-- End of function definition for !!stlProfMitre
