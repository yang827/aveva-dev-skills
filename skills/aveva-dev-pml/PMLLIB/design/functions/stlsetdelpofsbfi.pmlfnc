--
--
-- Description:
-- function to replace the core that no longer works.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Sbfitting to position (either steelwork or panel)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!stlSetDelpOfSbfi(!sbfi is DBREF,!newOwner is DBREF)



-- positioning the subfitting thro the appware (temporary fix)


-- Initialise Variables

!refe             = !!ce

-- load single penetration store object in case the user reverts back to the single.

-- use a global variable to speed up this change (should really convert the merge form the PML 11, but no time

   if(undefined(!!dummyGvarForData)) then
      !!dummyGvarForData = object PENDEMERGEPENS()
   endif

   !!dummyGvarForData.load(!sbfi)

-- get position of sbfi wrt to the new owning cmpf

   !sbfiPos = !sbfi.position.wrt(!newOwner)

   !!ce = !newOwner

   INCL $!sbfi

   handle any
   endhandle

   !!ce = !sbfi
   -- get the offset position without the wrt cmpf to prepare for delp

      !east = !sbfiPos.east
      !north = !sbfiPos.north
      !up = !sbfiPos.up

   DELP E $!east N $!north U $!up

!!ce = !refe

endfunction
-- End of function definition for !!stlSetDelpOfSbfi
