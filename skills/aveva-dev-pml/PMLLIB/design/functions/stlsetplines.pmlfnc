--     Keyword:     STEEL
--   Module:        design
--   Replaces:
--
-- Author:          J.Hennings
-- Created:         Tue 01/06/2010
--
--
-- Description:
-- Modify Pline function
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Title of form
--    2   R      STRING      Attribute to be queried
--    3   R      STRING      List of element types
--    4   R      STRING      List of element types
--    5   R      STRING      Rule for plines
--    6   R      STRING      Prompt for form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!stlSetPLines(!title is STRING, !attr is STRING, !gtype is STRING, !targetTypes is STRING, !rule is ANY, !tag is STRING) is BOOLEAN

  -- Set values on old PML1 form
  var _CDSETPLDAT_TITLE  !title
  var _CDSETPLDAT_ATTR   !attr
  var _CDSETPLDAT_GTYP   !gtype
  var _CDSETPLDAT_HPOS   !targetTypes
  var _CDSETPLDAT_RULE   !rule
  var _CDSETPLDAT_PROMPT !tag

  if( defined(!!setPLine) ) then
    !shown = !!setPLine.shown()
  else
    -- Load generic Pline form
    pml load form !!setPLine
    !shown = false
  endif

  -- Set the form title
  !!setPLine.formTitle = |$_CDSETPLDAT_TITLE|

  -- Load the PLINE control object
  !!stlPLines = object STLPLINECNTRL()
  !!stlPLines.setup(!attr, !gtype, !targetTypes, !rule, !tag)
  !!stlPLines.formState(false)

  -- If form is on, re-initialise
  if(!shown) then
    !!stlPLines.loadPick('CE')
  else
    show !!setPLine
  endif

  return true

endfunction
