--
--
-- Description:
-- Connect > Connect function
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      BOOLEAN    Connect or disconnect?
-- Return:
--   [Data Type] [Description]
--     BOOLEAN    Successful?
--
------------------------------------------------------------------------

define function !!stlwrkConnect(!mode is BOOLEAN) is BOOLEAN

  !!stlConnect = object STLWRKCONN()
  !!stlConnect.init()

  if (!mode) then
    !!stlConnect.pickDominantSection()
  else
    !!stlConnect.pickDisconnEnd()
  endif

  return true
endfunction
