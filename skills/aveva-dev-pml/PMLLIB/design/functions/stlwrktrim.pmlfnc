-- Author:          J.Hennings
-- Created:         Tue 01/06/2010
--
--
-- Description:
-- Steelwork trim function
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Force?
--    2    R     BOOLEAN     Current or best pline?
--    3    R     BOOLEAN     Trim all incoming sections?
--    4    R     STRING      Dbref of section
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!stlwrkTrim(!mode is BOOLEAN, !currentPLine is BOOLEAN, !trimIncoming is BOOLEAN, !sRef is STRING) is BOOLEAN

  !!stlTrim = object STLTRIMCNTRL()
  if (!mode) then
    !!stlTrim.setupForce()
  else
    !!stlTrim.setup(!currentPLine, !trimIncoming, !sRef)
  endif

  return true
endfunction
