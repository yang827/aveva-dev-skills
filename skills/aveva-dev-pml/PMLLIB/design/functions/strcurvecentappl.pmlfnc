--
--
-- Description:
-- Complete action i.e
-- Create a new curve if in create mode
-- or Modify existing curve if in edit mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strCurveCentAppl()

-- clear aid graphics
call !!clearAid('CYLI', 40101)
-- bug fix
AID CLEAR CYLI ALL


-- Remember where we were
!refe = !!ce

 !!ce = !!sctlSpine.current

if (!!sctlSpine.radio.val eq 1) then
    -- Create new vertex
     NEW CURVE
    -- Update Counters
    !!sctlSpine.current = !!ce
    !!sctlSpine.number = !!ce.owner.members.findFirst(!!ce)
endif

-- Set attributes

!posString = !!strCurveCent.centre.string()
POS $!posString

!cpos = !!strCurveCent.circum.string()
!cPosString = !cpos.string()
CPOS $!cPosString
!radius = !!strCurveCent.radius.string()
RADIUS $!radius

CURTYP CENT

-- Update List
call !!sctlSpineList(!!ce.owner)

-- Close form if creating
if (!!sctlSpine.radio.val eq 1) then
      !!strCurveCent.hide()
endif

!!ce = !refe

call !!strCurveCentDism()

endfunction
-- End of function definition for !!strCurveCentAppl
