--
-- Description:
-- Save the point picked as centre of curve and
-- and see if we have enough information to complete
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strCurveCentCent()

-- Save Value
!!strCurveCent.centre = !!edgGeomData.position

-- Switch EDG
call !!strCurveCentPick('CIRCUM')

-- See if we have enough information to complete
if (Set(!!strCurveCent.radius) and Set(!!strCurveCent.circum)) then
      call !!strCurveCentConf()
endif

endfunction
-- End of function definition for !!strCurveCentCent
