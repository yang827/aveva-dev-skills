--
-- Description:
-- Save the point picked as point on circumference
-- and see if we have enough information to complete
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strCurveCentCirc()

-- Save Value
!!strCurveCent.circum = !!edgGeomData.position

-- Switch EDG
call !!strCurveCentPick('CENTRE')

-- Check if Centre is set
if (Set(!!strCurveCent.centre) ) then
      if (!!strCurveCent.lock.val.not() ) then
           !!strCurveCent.radius = !!strCurveCent.circum.distance( !!strCurveCent.centre)
           !!strCurveCent.value.val = !!strCurveCent.radius.string('D0')
      endif
      if (Set(!!strCurveCent.radius) and !!strCurveCent.radius gt 0 ) then
           call !!strCurveCentConf()
      endif
endif

endfunction
-- End of function definition for !!strCurveCentCirc
