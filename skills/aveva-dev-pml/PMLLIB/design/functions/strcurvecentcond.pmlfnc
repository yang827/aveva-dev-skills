--
--
-- Description:
-- Calculate conditioning point
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Spine
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strCurveCentCond(!spine is DBREF) is POSITION

!message = STRING()
-- Calculate midpoint of point before and after
!midPoint = !!consMidPoint(!spine.members[!!sctlSpine.number - 1].Position, !spine.members[!!sctlSpine.number + 1].Position)

-- Calculate direction between centre and midpoint
if (!!strCurveCent.hand.val) then
      !direction = !!consDirTo(!midPoint, !!strCurveCent.centre, !message)
else
      !direction = !!consDirTo( !!strCurveCent.centre, !midPoint, !message)
endif
-- Calculate conditioning point as radius in direction from centre

!return = object POSITION()
!return.east = !!strCurveCent.centre.wrt(WORLD).east + !!strCurveCent.radius * !direction.wrt(WORLD).east
!return.north = !!strCurveCent.centre.wrt(WORLD).north + !!strCurveCent.radius * !direction.wrt(WORLD).north
!return.up = !!strCurveCent.centre.wrt(WORLD).up + !!strCurveCent.radius * !direction.wrt(WORLD).up
!return.origin = WORLD

return !return

endfunction
-- End of function definition for !!strCurveCentCond
