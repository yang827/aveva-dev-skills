--
--
-- Description:
-- If confirming then show some aid graphics
-- otherwise complete action
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strCurveCentConf()

-- Clear Aid first
call !!clearAid('CYLI', 40101)

-- Draw Aid Cylinder
    if (!!strCurveCent.radius lt 1000mm ) then
          !height = !!strCurveCent.radius
    else
          !height = 1000mm
    endif
    !diameter = 2 * !!strCurveCent.radius
    call !!drawAidCylinder(!diameter, !height,  !!strCurveCent.centre, !!sctlSpine.plane.orientation, True, 40101 )
-- Enable accept button
    !!strCurveCent.accept.active = True

endfunction
-- End of function definition for !!strCurveCentConf
