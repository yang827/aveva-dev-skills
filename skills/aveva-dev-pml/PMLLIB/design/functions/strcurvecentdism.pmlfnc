-- Define function
define function !!strCurveCentDism()

!!edgCntrl.remove('Spine Centre Centre')
!!edgCntrl.remove('Spine Centre Radius')

call !!clearAid('CYLI', 40101)

endfunction
-- End of function definition for !!strCurveCentDism
