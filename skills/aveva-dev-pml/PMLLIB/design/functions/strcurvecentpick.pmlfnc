--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode (CENTRE or RADIUS)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strCurveCentPick(!mode is STRING)

!!edgCntrl.remove('Spine Centre Centre')
!!edgCntrl.remove('Spine Centre Radius')


!packet = object EDGPACKET()


if (!mode.upcase() eq 'CENTRE' ) then
     !packet.defineWrapper('POSITION','!!strCurveCentCent()','Pick Position of Curve Centre')
     !packet.description = 'Spine Centre Centre'
     !!strCurveCent.radio.val = 2
else
     !packet.defineWrapper('POSITION','!!strCurveCentCirc()','Pick Position of Curve Circumference')
     !packet.description = 'Spine Centre Radius'
     !!strCurveCent.radio.val = 1
endif

!!edgCntrl.add(!packet)


endfunction
-- End of function definition for !!strCurveCentPick
