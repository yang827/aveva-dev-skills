-- Define function
define function !!strCurveCentRad()

-- Save radius
!!strCurveCent.radius = !!strCurveCent.value.val.real()

!!strCurveCent.lock.val = True

if(Set(!!strCurveCent.centre) and Set(!!strCurveCent.circum)  ) then
      call !!strCurveCentConf()
endif

endfunction
-- End of function definition for !!strCurveCentRad
