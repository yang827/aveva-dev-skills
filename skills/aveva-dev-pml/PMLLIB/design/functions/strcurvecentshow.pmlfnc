-- Define function
define function !!strCurveCentShow()

!message = object STRING()
!spine = !!findFirstMember(!!sctlSpine.spine, 'SPINE', '', !message)
!spineVertices = !spine.members
-- Check that a curve is sensible here
-- First vertex must be POINSP not CURVE
if (!spine.mCount eq 0) then
   !!messageFile.error(155, 010)
   return
endif

-- Check if current element is curve
if (!!sctlSpine.radio.val eq 2 and !!sctlSpine.current.type ne 'CURVE') then
      return
else
-- Check valid to create curve here
    if (!!sctlSpine.number ge !spine.mCount) then
        !!messageFile.error(155, 012)
        return
    elseif (!spineVertices[!!sctlSpine.number + 1].type eq 'CURVE' ) then
        !!messageFile.error(155, 011)
        return
    endif
endif
-- Show Form

show !!strCurveCent

-- check current element is not CURVE

if (!spineVertices[!!sctlSpine.number].type eq 'CURVE') then
   !!sctlSpine.radio.val = 2
else
   !!sctlSpine.radio.val = 1
endif

-- if editing curve
if (!!sctlSpine.radio.val eq 2) then

    !!strCurveCent.circum = !!sctlSpine.current.pPos[7]
    !!strCurveCent.centre = !!sctlSpine.current.pPos[6]
    !!strCurveCent.radius = !!sctlSpine.current.radius
    !!strCurveCent.value.val = !!strCurveCent.radius.string('D0')

else

    !!strCurveCent.centre = object POSITION()
    !!strCurveCent.circum = object POSITION()
    !!strCurveCent.radius = REAL()
    !!strCurveCent.value.val = ''

endif
!!strCurveCent.accept.active = False

-- set up EDG
if (!!strCurveCent.radio.val eq 1) then
     call !!strCurveCentPick('CIRCUM')
else
     call !!strCurveCentPick('CENTRE')
endif

endfunction
-- End of function definition for !!strCurveCentShow
