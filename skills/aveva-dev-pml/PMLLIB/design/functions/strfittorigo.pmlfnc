--
--
-- Description:
-- Orientate fitting in accordance with pick
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!strFittOriGo(!pickData is EDGPICKDATA)

  -- Initialise Variables

  -- Special Case Picks (ie items that can be used as a plane in their
  -- own right)
  if(!pickData.type eq 'DESIGNAID') then

    if(!!aidNumbers.numbers[!pickData.point].objectType() inset('GPHPLANE','GPHLINEARGRID','GPHPLANTGRID','GPHRADIALGRID')) then

      -- Get plane

      if(!!aidNumbers.numbers[!pickData.point].objectType() eq 'GPHPLANE') then

        !plane = !!aidNumbers.numbers[!pickData.point].plane

      else

        !plane = !!aidNumbers.numbers[!pickData.point].plane()

      endif

    else

      !!alert.error('Unable to derived plane from picked element.')
    endif


  -- Use "plane" picked
  else

    !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
    handle any
      !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
    endhandle

  endif
-- Find element
  !refe = !!ce
  !!ce = SBFI 1
  handle any
      !!ce = FIXING
      handle any
           !!ce = !refe
           !!alert.error(' Unable to find fitting ')
           return
      endhandle
  endhandle


-- Use the orientation
  !zDirString = !plane.orientation.zDir().string()
  ZDIR $!zDirString
  handle any
  endhandle

  !!ce = !refe

endfunction
-- End of function definition for !!strFittOriGo
