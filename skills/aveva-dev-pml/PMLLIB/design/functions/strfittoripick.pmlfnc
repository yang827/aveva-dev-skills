--
-- Description:
-- Set up EDG to prompt for orientation of fitting
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!strFittOriPick()

-- Set up prompt for orientation
  !packet                = object EDGPACKET()
  !packet.key            = 'planePacket'
  !packet.description    = 'Orientate Fitting'
  !packet.type           = 'gph'
  !packet.priority       = 0
  !packet.action         = '!!strFittOriGo(!this.return[1])'
  !packet.remove         = true
  !packet.pickPacket.stdAny('Pick facet or grid to define orientation')
  !packet.pickPacket.picks[1].prompt         = STRING()
  !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
  !packet.pickPacket.picks[1].pick.stdGraphics()
  !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
  !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
  !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
  !packet.pickPacket.picks[1].pick.input[10] = /*
  !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'

  -- Set priority
  !packet.priority       = 1

  -- Add into EDG system
  !!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!strFittOriPick
