-- Description:
-- Modify the position of a fitting
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strFittPosition()

!refe = !!ce

if (!!ce.type eq |FITT| or !!ce.type eq |FIXING| or !!ce.type eq |CMFI| or ( !!ce.type eq |SBFI| and !!ce.owner.type eq |CMFI| ) ) then
      call !!strSctnFittShow('MODIFY')
elseif (!!ce.type eq |PFIT| or !!ce.type eq |CMPF|  or ( !!ce.type eq |SBFI| and !!ce.owner.type eq |CMPF| ) ) then
      call !!strPaneFittShow('MODIFY')
else
      FITT
      handle any
           FIXING
           handle any
                PFIT
                handle any
                     CMPF
                     handle any
                     endhandle
                endhandle
           endhandle
       endhandle
       if (!!ce.type eq |FITT| or !!ce.type eq |FIXING| )then
           call !!strSctnFittShow('MODIFY')
       elseif (!!ce.type eq |PFIT| or !!ce.type eq |CMPF| ) then
          call !!strPaneFittShow('MODIFY')
       endif
endif
!!ce = !refe

endfunction
-- End of function definition for !!strFittPosition
