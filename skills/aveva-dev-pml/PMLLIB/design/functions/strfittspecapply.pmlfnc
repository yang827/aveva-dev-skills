-- Define function
define function !!strFittSpecApply()

  if (!!strFittSpec.specData.currentSelection.unset() or !!strFittSpec.specData.currentSelection.type neq 'SPCO' ) then
    !!messageFile.error(155, 014)
  endif

  -- initialise variables for design parameters
  var !!cdcaAttr DELETE
  var !!cdcaAttd DELETE
  var !!cdcaDesp DELETE
  var !!cdcaPass DELETE

  -- set default mode
  !mode = 'MODIFY'

  if (!!strFittSpec.mode eq |CE| or !!strFittSpec.mode eq |MODIFY|) then
    -- Current Element Mode
    !!cdcaPass[1] = 'Modify Current Element'
    !!cdcaPass[2] = '!!strFittSpecEdit(|CE|)'

  elseif (!!strFittSpec.mode eq |List| ) then
    -- List Mode
    !!cdcaPass[1] = 'Modify Current List'
    !!cdcaPass[2] = '!!strFittSpecEdit(|LIST|)'

  elseif (!!strFittSpec.mode eq |Pick| ) then
    -- Pick Mode
    !!cdcaPass[1] = 'Modify Picked Fittings'
    !!cdcaPass[2] = '!!strFittSpecEdit(|PICK|)'

  else
    -- Create Mode
    !!cdcaPass[1] = 'Create Fitting'
    !mode = 'DEFINE'

    if (!!strFittSpec.type eq |PFIT| or !!strFittSpec.type eq |CMPF| ) then
      !!cdcaPass[2] = '!!strPaneFittShow(|NEW|)'

    elseif (!!strFittSpec.type eq |SBFI| ) then
      !unusedFindPanel = PANEL
      handle any
        !!cdcaPass[2] = '!!strSctnFittShow(|NEW|)'
      elsehandle none
        !!cdcaPass[2] = '!!strPaneFittShow(|NEW|)'
      endhandle

    else
      !!cdcaPass[2] = '!!strSctnFittShow(|NEW|)'

    endif

  endif

  -- set spec component reference
  !spref = !!strFittSpec.specData.currentSelection
  !element = !!strFittSpec.element

  -- set cancel function
  !!cdcaPass[3] = '!!strFittSpecDism()'

  $m "%PDMSUI%/DES/CLIB/XSETPROP" $!<mode> $<$!<spref>$> $<!!cdcaPass$> $<$!<element>$>

endfunction
-- End of function definition for !!strFittSpecApply
