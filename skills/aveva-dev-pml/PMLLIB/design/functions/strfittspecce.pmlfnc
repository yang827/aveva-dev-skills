--
--
-- Description:
-- Update the form for the current element
-- if the current element is a fitting set the form to the current spec
-- if the element is a panel or section create the fitting on this element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strFittSpecCe()

!refe = !!ce

-- Fixing
   if (!!ce.type eq |FIXING| ) then
             !!strFittSpec.specData.reference = !!ce
             !!strFittSpec.type = !!ce.type
-- Fitting
   elseif (!!ce.type eq |FITT| ) then
             !!strFittSpec.specData.reference = !!ce
             !!strFittSpec.type = !!ce.type
-- Panel Fitting
   elseif (!!ce.type eq |FITT| ) then
             !!strFittSpec.specData.reference = !!ce
             !!strFittSpec.type = !!ce.type
-- Compound Fitting
   elseif (!!ce.type eq |FITT| ) then
             !!strFittSpec.specData.reference = !!ce
             !!strFittSpec.type = !!ce.type
-- Sub - fitting
   elseif (!!ce.type eq |FITT| ) then
             !!strFittSpec.specData.reference = !!ce
             !!strFittSpec.type = !!ce.type
-- Section
   elseif (!!ce.hardType eq |SCTN| ) then
             !!strFittSpec.specData.reference = object DBREF()
             !!strFittSpec.type = 'FITT'
             !!strFittSpec.owner = !!ce
-- Gensec
   elseif (!!ce.hardType eq |GENSEC| ) then
             !!strFittSpec.specData.reference = object DBREF()
             !!strFittSpec.type = 'FIXING'
             !!strFittSpec.owner = !!ce
-- Panel
   elseif (!!ce.hardType eq |GENSEC| ) then
             !!strFittSpec.specData.reference = object DBREF()
             !!strFittSpec.type = 'PFIT'
             !!strFittSpec.owner = !!ce
-- Try to find one from here
   else
-- Fixing
        FIXING
        handle any
-- Fitting
             FITT
             handle any
-- Panel Fitting
                  PFIT
                  handle any
-- Compound Fitting
                       CMPF
                       handle any
-- Sub - fitting
                            SUBF
                            handle any
                                 return
                            endhandle
                       endhandle
                  endhandle
             endhandle
         endhandle
    !!strFittSpec.specData.reference = !!ce
    !!strFittSpec.type = !!ce.type

    endif

!!strFittSpec.owner = !!ce
!!ce = !refe
call !!strFittSpecInit()

endfunction
-- End of function definition for !!strFittSpecCe
