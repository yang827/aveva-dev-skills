--
--
-- Description:
-- Change the specification and design parameters of the given element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode (CE, LIST, PICK)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strFittSpecEdit(!mode is STRING)

  !list = ARRAY()

  -- Build up list of elements based on mode
  if (!mode eq |CE| ) then
    -- Current Element Mode
    if (!!strFittSpec.specData.reference.set() ) then
      !list[1] = !!strFittSpec.specData.reference
    else
      !list[1] = !!ce
    endif

  elseif (!mode eq |LIST| ) then
    -- List Mode

    -- Extract members of current list

    !list = !!getCurrentList()

    if (!list.unset()) then
      !!messageFile.error(146, 021)

    endif

  elseif (!mode eq |PICK| ) then
    -- Pick Mode

    -- Set up event driven graphics

    -- check if EDG is being used

    -- setup EDG

    return

  endif

  -- For each element we have found
  do !element values !list

    if (!element.type eq |FITT| or !element.type eq |FIXING| or !element.type eq |PFIT|) then
      !!ce = !element

      -- Set design parameters
      if (defined(!!cdcaDesp)) then
        do !i indices !!cdcaDesp
          DESP NUMBER $!i $!!cdcaDesp[$!i]
        enddo
      endif

      -- Set specification
      !spec = !!strFittSpec.specData.currentSelection
      SPREF $!spec

    endif
  enddo

endfunction
-- End of function definition for !!strFittSpecEdit
