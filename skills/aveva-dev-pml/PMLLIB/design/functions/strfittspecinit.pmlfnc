--
--
-- Description:
-- Build a list of available specifications based on the current element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strFittSpecInit()

if (!!strFittSpec.type.unset() ) then
      if (!!ce.hardType eq 'SCTN' ) then
                !!strFittSpec.type = 'FITT'
      elseif (!!ce.hardType eq 'GENSEC' ) then
                !!strFittSpec.type = 'FIXING'
      elseif (!!ce.hardType eq 'PANEL' ) then
                !!strFittSpec.type = 'PFIT'
      else
                SCTN
                handle none
                     !!strFittSpec.type = 'FITT'
                elsehandle any
                     STWALL
                     handle none
                          !!strFittSpec.type = 'FITT'
                     elsehandle any
                          GENSEC
                          handle none
                               !!strFittSpec.type = 'FIXING'
                          elsehandle any
                               SBWALL
                               handle none
                                    !!strFittSpec.type = 'FIXING'
                               elsehandle any
                                    PANEL
                                    handle none
                                    !!strFittSpec.type = 'PFIT'
                                    elsehandle any
                                          return error 1
                                    endhandle
                               endhandle
                          endhandle
                     endhandle
                endhandle
      endif
endif

!!strFittSpec.owner = !!ce

!message = STRING()
!specs[1] = object DBREF()

if (!!strFittSpec.type eq 'PFIT' or !!strFittSpec.type eq 'CMPF' or (!!strFittSpec.type eq 'SBFI' and (!!ce.owner.type eq 'PANE' or !!ce.owner.type eq 'CMPF' )  ) ) then
     !type = |PFIT|
else
     !type = |FITT|
endif

if ( !!findSpecs(|STL|,!type, object dbref(),!message,!specs) ) then

!position = 1
-- Build list of specs
     do !index from 1 to !specs.size()

          !desc[!index] = !specs[!index].desc
          !text[!index] = !specs[!index].string()
          if (Defined(!!strFittSpec.specData.reference) and !!strFittSpec.specData.reference.set() ) then
               if(!!strFittSpec.specData.reference.badRef()) then
                      !!strFittSpec.specData.reference = object DBREF()
               else
                    if( !specs[!index] eq !!strFittSpec.specData.reference.spref ) then
                         !position = !index
                    endif
               endif
          endif

     enddo

     !!strFittSpec.specifications.dText = !desc

     !!strFittSpec.specifications.rText = !text

     !!strFittSpec.specData.specName = !specs[!position]

     !!strFittSpec.specifications.val = !position

else

     !specDesc[1] = |No Fitting Specs Found|

     !text[1] = |nulref|

     !!strFittSpec.specifications.dText = !specDesc

     !!strFittSpec.specifications.rText = !text

endif


endfunction
-- End of function definition for !!strFittSpecInit
