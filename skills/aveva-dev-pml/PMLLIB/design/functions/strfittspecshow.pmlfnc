-- File:            strfittspecshow.pmlfnc
--   Type:          Function Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Wed Aug 20 16:08:35 1997
--
--
-- Description:
-- Show the form for the fitting specification
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode (NEW, MODIFY, LIST, PICK)
--    2   R      STRING      Type (SBFI, CMPF, FITT, FIXING, CMFI, PFIT)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strFittSpecShow(!mode is STRING, !type is STRING)

  -- load form
  show !!strFittSpec

  -- Save arguments against form
  !!strFittSpec.mode = !mode
  if (!type.set() and !type.length() gt 0) then
    !!strFittSpec.type = !type
  else
    !!strFittSpec.type = STRING()
  endif

  -- load information about current element
  if (!mode eq |MODIFY| )  then
      call !!strFittSpecCe()

  else
    -- try to find something to create the fitting on
    if (!type.set() and !type.length() gt 0) then
      if(!type eq 'SBFI') then
         CMPF
         handle any
           CMFI
           handle any
             PANEL
             handle any
               SCTN
               handle any
                 STWALL
                 handle any
                     !!strFittSpec.type = STRING()
                 endhandle
               endhandle
             endhandle
           endhandle
         endhandle
       elseif (!type eq 'CMPF' or !type eq 'PFIT') then
         PANEL
         handle any
           !!strFittSpec.type = STRING()
         endhandle
       elseif (!type eq 'FITT' or !type eq 'CMFI') then
         SCTN
         handle any
           STWALL
           handle any
             !!strFittSpec.type = STRING()
           endhandle
         endhandle
       elseif (!type eq 'FIXING') then
         GENSEC
         handle any
           SBWALL
           handle any
             !!strFittSpec.type = STRING()
           endhandle
         endhandle
       else
         !!strFittSpec.type = STRING()
       endif
     endif

    -- Change type to something we can create on
    if (!!strFittSpec.type.unset() ) then
      CMPF
      handle any
        CMFI
        handle any
          PANEL
          handle any
            SCTN
            handle any
              STWALL
              handle any
                GENSEC
                handle any
                  WALL
                  handle any
                    !!messageFile.error(155, 22)
                  elsehandle none
                    !!strFittSpec.type = 'FIXING'
                  endhandle
                elsehandle none
                  !!strFittSpec.type = 'FIXING'
                endhandle
              elsehandle  NONE
                !!strFittSpec.type = 'FITT'
              endhandle
            elsehandle  NONE
              !!strFittSpec.type = 'FITT'
            endhandle
          elsehandle  NONE
            !!strFittSpec.type = 'PFIT'
          endhandle
        elsehandle  NONE
          !!strFittSpec.type = 'SBFI'
        endhandle
      elsehandle  NONE
        !!strFittSpec.type = 'SBFI'
      endhandle
    endif

  endif

  -- load specifications that could be used
  call !!strFittSpecInit()

endfunction
-- End of function definition for !!strFittSpecShow
