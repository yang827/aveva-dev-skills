--
--
-- Description:
-- Create straight unconnected section (SCTN).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GMFSPINE    Spine in terms of a GMFSPINE
--    2   R      STRING      Storage Group
--    3   R      STRING      Storage Area
--    4   R      DBREF       Default storage area, if unable to find one in the store system
--    5   R      STRING      Type of element (soft type) of GENSEC
--    6   R      STRING      Application mode, WALL or SECTION
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!strGensecCreate(!spine is GMFSPINE, !group is STRING, !area is STRING, !defaultStore is DBREF, !elementType is STRING, !mode is STRING )

  -- Initialise Variables

  -- Check we can create a curved section at this point
  !store     = !!getStorageArea(!group, !area)

  -- If store is unset, can we create the panel in or above where we are
  if(!store.unset()) then
    !store   = !defaultStore
  endif

  -- Define a "spine" from the passed definition of lines and arcs
  !gensection               = object STRGENSEC(!spine)
  !gensection.type          = !elementType

  -- Define Connections
  if(undefined(!!appDesMain.node)) then
    !gensection.freeConnect = true
  else
    !gensection.freeConnect = !!appDesMain.node.val
  endif

  -- Section store Data
  !gensection.storeGroup    = !group
  !gensection.storeArea     = !area
  !gensection.store         = !store

  -- Create section
  !gensection.create()

  if (!mode eq 'WALL') then
    call !!strSectionData(!gensection.genericSection)

  else
    -- Assign specification data
    if(!!appDesMain.prfl.val) then
      call !!strSectionData(!gensection.genericSection)
    endif
  endif

  -- Return to reference
  !!ce = !gensection.genericSection

endfunction
-- End of function definition for !!strGensecCreate
