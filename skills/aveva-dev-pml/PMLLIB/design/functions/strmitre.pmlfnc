-- File:            strmitre.pmlfnc
--   Type:          Function Definition
--   Group:         Common to all Structural Applications

--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Nov 12 14:42:22 "GMT 1998
--
--
-- Description:
-- Mitre passed ends of given sections, any error will be returned via
-- then public_error text member (!!error.text)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       From section
--    2   R      STRING      End of from section
--    3   R      DBREF       To section
--    4   R      STRING      End of to section
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is it could mitre the ends
--
------------------------------------------------------------------------

define function !!strMitre(!fromSection is DBREF, !passedFromEnd is STRING, !toSection is DBREF, !passedToEnd is STRING) is BOOLEAN

  -- Check the validity of the passed elements
  if (!!dbRefUpdate(!fromSection)) then
    if (!fromSection.spref.badref()) then
      return false
    endif
  else
    return false
  endif
  if (!!dbRefUpdate(!toSection)) then
    if (!toSection.spref.badref()) then
      return false
    endif
  else
    return false
  endif

  -- Initialise Variables
  !reference = !!ce
  !fromEnd   = !passedFromEnd.trim().upcase()
  !toEnd     = !passedToEnd.trim().upcase()

  -- Special case flags for sections used as walls (via softtype)
  !fromWall  = false
  !toWall    = false

  -- Flip directions (true if end to end or start to start, false if end to start)
  !flipFlag = !fromEnd.eq(!toEnd)

  -- From Section
  -->> Hard type SCTN
  if(!fromSection.hardType eq 'SCTN') then

    -- Soft type SCTN
    if(!fromSection.type eq 'SCTN') then

      -- Local volume of section
      !fromVolume       = object LOCALVOLUME(!fromSection, !fromSection)

    -- Soft type STWALL
    elseif (!fromSection.type eq 'STWALL') then

      !fromWall         = true

      -- Pline information
      !fromInside       = !!edgTypes.pLine.line(!fromSection, 'IBOW')
      !fromOutside      = !!edgTypes.pLine.line(!fromSection, 'OBOW')

      -- Lines are always going away from the connection point
      if(!fromEnd eq 'END') then
        !fromInside     = !fromInside.reverseSense()
        !fromOutside    = !fromOutside.reverseSense()
      endif

    -- Unknown soft type
    else
      return false

    endif

    -- Orientation of section
    !fromSide           = !fromSection.orientation.xDir()
    !fromTop            = !fromSection.orientation.yDir()
    !fromPath           = !fromSection.orientation.zDir()

  -->> Hard type GENSEC
  elseif (!fromSection.hardType eq 'GENSEC') then

    -- Soft type GENSEC
    if(!fromSection.type eq 'GENSEC') then
      !!alert.warning('Unable to mitre a GENSEC.')
      return false

    -- Soft type WALL
    elseif (!fromSection.type eq 'WALL') then

      !fromWall = true

      -- Pline information
      !fromInside      = !!edgTypes.pLine.arc(!fromSection, 'IBOW')
      !fromOutside     = !!edgTypes.pLine.arc(!fromSection, 'OBOW')

     -- Arc are always going away from the connection point
     if(!fromEnd eq 'START') then
       !fromInsideTan  = object POINTVECTOR(!fromInside.anglePosition(!fromInside.startAngle),   !fromInside.startTangent().opposite())
       !fromOutsideTan = object POINTVECTOR(!fromOutside.anglePosition(!fromOutside.startAngle), !fromOutside.startTangent().opposite())
     else
       !fromInsideTan  = object POINTVECTOR(!fromInside.anglePosition(!fromInside.endAngle),     !fromInside.endTangent())
       !fromOutsideTan = object POINTVECTOR(!fromOutside.anglePosition(!fromOutside.endAngle),   !fromOutside.endTangent())
     endif

    -- Unknown soft type
    else
      return false

    endif

    -- Orientation of section
    !fromSide         = !fromSection.orientation.xDir()
    !fromPath         = !fromSection.orientation.yDir()
    !fromTop          = !fromSection.orientation.zDir()
  endif

  -- To Section
  -->> Hard type SCTN
  if(!toSection.hardType eq 'SCTN') then

    -- Soft type SCTN
    if(!toSection.type eq 'SCTN') then

      -- Local volume of section
      !toVolume      = object LOCALVOLUME(!toSection, !toSection)

    -- Soft type STWALL
    elseif (!toSection.type eq 'STWALL') then

      !toWall        = true

      -- Pline information
      !toInside      = !!edgTypes.pLine.line(!toSection, 'IBOW')
      !toOutside     = !!edgTypes.pLine.line(!toSection, 'OBOW')

      -- Lines are always going away from the connection point
      if(!toEnd eq 'END') then
        !toInside    = !toInside.reverseSense()
        !toOutside   = !toOutside.reverseSense()
      endif

    -- Unknown soft type
    else
      return false

    endif

    -- Orientation of section
    !toSide          = !toSection.orientation.xDir()
    !toTop           = !toSection.orientation.yDir()
    !toPath          = !toSection.orientation.zDir()

  -->> Hard type GENSEC
  elseif (!toSection.hardType eq 'GENSEC') then

    -- Soft type GENSEC
    if(!toSection.type eq 'GENSEC') then
      !!alert.warning('Unable to mitre a GENSEC.')
      return false

    -- Soft type WALL
    elseif (!toSection.type eq 'WALL') then

      !toWall        = true

      -- Pline information
      !toInside      = !!edgTypes.pLine.arc(!toSection, 'IBOW')
      !toOutside     = !!edgTypes.pLine.arc(!toSection, 'OBOW')

     -- Arc are always going away from the connection point
     if(!toEnd eq 'START') then
       !toInsideTan  = object POINTVECTOR(!toInside.anglePosition(!toInside.startAngle),   !toInside.startTangent().opposite())
       !toOutsideTan = object POINTVECTOR(!toOutside.anglePosition(!toOutside.startAngle), !toOutside.startTangent().opposite())
     else
       !toInsideTan  = object POINTVECTOR(!toInside.anglePosition(!toInside.endAngle),     !toInside.endTangent())
       !toOutsideTan = object POINTVECTOR(!toOutside.anglePosition(!toOutside.endAngle),   !toOutside.endTangent())
     endif

    -- Unknown soft type
    else
      return false

    endif

    -- Orientation of section
    !toSide          = !toSection.orientation.xDir()
    !toPath          = !toSection.orientation.yDir()
    !toTop           = !toSection.orientation.zDir()

  endif

  -- Check orientation of Sections
  -- If the "top" direction of the two sections are not parallel, then return
  if(!fromTop.isParallel(!toTop).not()) then
    !!error.text = 'Elements "Y" axis of both elements have to be parallel before the ends can be mitred.'
    return false
  endif

  -- Wall to wall mitre
  if(!fromWall and !toWall) then

    -- Do we flip the intersection data
    if(!flipFlag) then
      !temporary    = !toInside
      !toInside     = !toOutside
      !toOutside    = !temporary
      if(defined(!toInsideTan)) then
        !temporaryTan = !toInsideTan
        !toInsideTan  = !toOutsideTan
        !toOutsideTan = !temporaryTan
      endif
    endif

    -- Determine the intersection
    -->>>>>>>>>>>>>>>>>> Line to Line intersection <<<<<<<<<<<<<<<<<<--
    if(!fromInside.objectType() eq 'LINE' and !toInside.objectType() eq 'LINE') then

      -- Point 1
      !point[1] = !fromInside.intersection(!toInside)
      handle (2,870)
--      Lines passed to method are parallel
          !point[1] = !fromInside.endPosition
      endhandle
      !point[2] = !fromOutside.intersection(!toOutside)
      handle (2,870)
--      Lines passed to method are parallel
          !point[2] = !fromOutside.endPosition
      endhandle

      -- If distance between points is zero, then we can't do anything
      if(!point[1].distance(!point[2]) eq 0) then
        !!alert.warning('Unable to mitre ends, thickness of "from" section is zero.')
        return false
      endif

      -- Direction
      !edgeDirection = !point[1].direction(!point[2])
      !vertDirection = !edgeDirection.orthogonal(!fromInside.direction())
      !direction     = !edgeDirection.orthogonal(!vertDirection)

    -->>>>>>>>>>>>>>>>>> Line to Arc intersection <<<<<<<<<<<<<<<<<<--
    elseif (!fromInside.objectType() eq 'LINE' and !toInside.objectType() eq 'ARC') then

      -- Intersection points
      !insideAngles  = !toInside.intersections(!fromInside)
      !outsideAngles = !toOutside.intersections(!fromOutside)

      -- Determine the nearest point to the "start" of the "from" line
      !point[1]      = !toInside.anglePosition(!insideAngles[1])
      !point[2]      = !toInside.anglePosition(!insideAngles[2])

      -- Use the nearest intersection to the start of the line start
      if(!point[1].distance(!fromInside.startPosition) le !point[2].distance(!fromInside.startPosition)) then
        !point[2]   = !toOutside.anglePosition(!outsideAngles[1])
      else
        !point[1]   = !point[2]
        !point[2]   = !toOutside.anglePosition(!outsideAngles[2])
      endif

      -- Test if the points are outside the bounds of the arc
      if(!toInside.onProjected(!point[1]).not()) then
        !point[1]    = !fromInside.intersection(!toInsideTan)
      endif

      -- Point is out side of arc definition
      if(!toOutside.onProjected(!point[2]).not()) then
        !point[2]    = !fromOutside.intersection(!toOutsideTan)
      endif

       -- Direction
      !edgeDirection = !point[1].direction(!point[2])
      !vertDirection = !edgeDirection.orthogonal(!fromInside.direction())
      !direction     = !edgeDirection.orthogonal(!vertDirection)

    -->>>>>>>>>>>>>>>>>> Arc to Line intersection <<<<<<<<<<<<<<<<<<--
    elseif (!fromInside.objectType() eq 'ARC' and !toInside.objectType() eq 'LINE') then

      -- Intersection points
      !insideAngles  = !fromInside.intersections(!toInside)
      !outsideAngles = !fromOutside.intersections(!toOutside)

      -- Determine the nearest point to the "start" of the "from" line
      !point[1]      = !fromInside.anglePosition(!insideAngles[1])
      !point[2]      = !fromInside.anglePosition(!insideAngles[2])

      -- Use the nearest intersection to the start of the line start
      if(!point[1].distance(!toInside.startPosition) le !point[2].distance(!toInside.startPosition)) then
        !point[2]    = !fromOutside.anglePosition(!outsideAngles[1])
      else
        !point[1]    = !point[2]
        !point[2]    = !fromOutside.anglePosition(!outsideAngles[2])
      endif

      -- Test if the points are outside the bounds of the arc
      if(!fromInside.onProjected(!point[1]).not()) then
        !point[1]    = !toInside.intersection(!fromInsideTan)
      endif

      -- Point is out side of arc definition
      if(!fromOutside.onProjected(!point[2]).not()) then
        !point[2]    = !toOutside.intersection(!fromOutsideTan)
      endif

      -- Direction
      !edgeDirection = !point[1].direction(!point[2])
      !vertDirection = !edgeDirection.orthogonal(!toInside.direction().opposite())
      !direction     = !edgeDirection.orthogonal(!vertDirection)

    -->>>>>>>>>>>>>>>>>> Arc to Arc intersection <<<<<<<<<<<<<<<<<<--
    else

      -- Determine if the tangent lines of the arc are parallel
      !angle         = !fromInsideTan.direction.angle(!toInsideTan.direction)
      if(!angle.sbetween(180,0)) then

        -- Intersection points
        !insideAngles  = !toInside.intersections(!fromInside)
        !outsideAngles = !toOutside.intersections(!fromOutside)

        -- If either angle arrays are unset, then abort
        if(!insideAngles.empty() or !outsideAngles.empty()) then
          !!alert.warning('Unable to resolve mitre.')
          return false
        endif

        -- Determine the nearest point to the "start" of the "from" line
        !point[1]      = !toInside.anglePosition(!insideAngles[1])
        !point[2]      = !toInside.anglePosition(!insideAngles[2])

        -- Use the nearest intersection to the start of the line start
        if(!point[1].distance(!fromInsideTan.position) le !point[2].distance(!fromInsideTan.position)) then
          !point[2]   = !toOutside.anglePosition(!outsideAngles[1])
        else
          !point[1]   = !point[2]
          !point[2]   = !toOutside.anglePosition(!outsideAngles[2])
        endif

        -- Test if the points are outside the bounds of the inside arc
        !onTo          = !toInside.onProjected(!point[1])
        !onFrom        = !fromInside.onProjected(!point[1])

        -- Intersection is not on either of the arc
        if(!onTo.not() and !onFrom.not()) then
          !point[1]    = !fromInsideTan.intersection(!toInsideTan)

        -- Intersection in on the "to" arc but not the "from" arc
        elseif (!onTo and !onFrom.not()) then
          !angles      = !toInside.intersections(!fromInsideTan)

          -- Use nearest intersection to point vector
          if(!fromInsideTan.position.distance(!toInside.anglePosition(!angles[1])) le !fromInsideTan.position.distance(!toInside.anglePosition(!angles[2]))) then
            !point[1]  = !toInside.anglePosition(!angles[1])
          else
            !point[1]  = !toInside.anglePosition(!angles[2])
          endif

        -- Intersection in on the "from" arc but not the "to" arc
        elseif (!onTo.not() and !onFrom) then
          !angles      = !fromInside.intersections(!toInsideTan)

          -- Use nearest intersection to point vector
          if(!toInsideTan.position.distance(!fromInside.anglePosition(!angles[1])) le !toInsideTan.position.distance(!fromInside.anglePosition(!angles[2]))) then
            !point[1]  = !fromInside.anglePosition(!angles[1])
          else
            !point[1]  = !fromInside.anglePosition(!angles[2])
          endif
        endif

        -- Test if the points are outside the bounds of the outside arc
        !onTo          = !toOutside.onProjected(!point[2])
        !onFrom        = !fromOutside.onProjected(!point[2])

        -- Intersection is not on either of the arc
        if(!onTo.not() and !onFrom.not()) then
          !point[2]    = !fromOutsideTan.intersection(!toOutsideTan)

        -- Intersection in on the "to" arc but not the "from" arc
        elseif (!onTo and !onFrom.not()) then
          !angles      = !toOutside.intersections(!fromOutsideTan)

          -- Use nearest intersection to point vector
          if(!fromOutsideTan.position.distance(!toOutside.anglePosition(!angles[1])) le !fromOutsideTan.position.distance(!toOutside.anglePosition(!angles[2]))) then
            !point[2]  = !toOutside.anglePosition(!angles[1])
          else
            !point[2]  = !toOutside.anglePosition(!angles[2])
          endif

        -- Intersection in on the "from" arc but not the "to" arc
        elseif (!onTo.not() and !onFrom) then
          !angles      = !fromOutside.intersections(!toOutsideTan)

          -- Use nearest intersection to point vector
          if(!toOutsideTan.position.distance(!fromOutside.anglePosition(!angles[1])) le !toOutsideTan.position.distance(!fromOutside.anglePosition(!angles[2]))) then
            !point[2]  = !fromOutside.anglePosition(!angles[1])
          else
            !point[2]  = !fromOutside.anglePosition(!angles[2])
          endif
        endif

        -- Direction
        !edgeDirection = !point[1].direction(!point[2])
        !vertDirection = !toTop
        !direction     = !edgeDirection.orthogonal(!vertDirection)
      else
        !direction     = !toInsideTan.direction
      endif

    endif

  -- Handle all other instance
  else
      if (!fromSection.cutlength gt 0) then
          !direction = !fromSection.poss.direction(!fromSection.pose)
      elseif(!toSection.cutlength gt 0) then
          !direction = !toSection.pose.direction(!toSection.poss)
      else
          return false
      endif
  endif

--  !midPoint      = !point[1].midPoint(!point[2])

  !toDirection   = !direction
  !fromDirection = !toDirection.opposite()

--  pin1 at $!point[1] direction $!toDirection
--  pin2 at $!point[2] direction $!toDirection
--  pin3 at $!midPoint direction $!fromDirection

  -- Set "from" Direction
  -- "from" start direction
  !!ce      = !fromSection
  if(!fromEnd eq 'START') then
    DRNSTART $!<fromDirection>

    -- Set the cutplane of the joint start reference
    if (!fromSection.joiStart.neq(nulref)) then
      !!ce = !!ce.joiStart
      CUTPLANE $!<fromDirection>
      handle any
        -- must be a bad link
      endhandle
    endif

  -- "from" end direction
  else
    DRNEND $!<fromDirection>

    -- Set the cutplane of the joint end reference
    if (!fromSection.joiEnd.neq(nulref)) then
      !!ce = !!ce.joiEnd
      CUTPLANE $!<fromDirection>
      handle any
        -- must be a bad link
      endhandle
    endif

  endif

  -- Set "to" Direction
  -- "to" start direction
  !!ce      = !toSection
  if(!toEnd eq 'START') then
    DRNSTART $!<toDirection>

    -- Set the cutplane of the joint start reference
    if (!toSection.joiStart.neq(nulref)) then
      !!ce = !toSection.joiStart
      CUTPLANE $!<toDirection>
      handle any
        -- must be a bad link
      endhandle
    endif

  -- "to" end direction
  else
    DRNEND $!<toDirection>

    -- Set the cutplane of the joint end reference
    if (!toSection.joiEnd.neq(nulref)) then
      !!ce = !toSection.joiEnd
      CUTPLANE $!<toDirection>
      handle any
        -- must be a bad link
      endhandle
    endif

  endif

  -- Return
  !!ce = !reference

  return true

endfunction
-- End of function definition for !!strMitre

-- Old code, may need to use the SCTN code for handle mitre of sections
-- when the function is used more widely for all structural mitres.
  -- Initialise Variables
  !reference = !!ce
  !fromEnd   = !passedFromEnd.trim().upcase()
  !toEnd     = !passedToEnd.trim().upcase()

  -- Flip directions (true if end to end or start to start, false if end to start)
  !flipFlag = !fromEnd.eq(!toEnd)

  -- Section SCTN
  if(!fromSection.hardType eq 'SCTN') then
    !fromSide      = !fromSection.orientation.xDir()
    !fromTop       = !fromSection.orientation.yDir()
    !fromPath      = !fromSection.orientation.zDir()

    -- Local volume of section
    !fromVolume    = object LOCALVOLUME(!fromSection, !fromSection)
    if (!fromSection.type eq 'STWALL') then
      !fromVolume.from = !fromSection.plStart.otow.wrt(world)
      !fromVolume.to   = !fromSection.plEnd.ibow.wrt(world)
      !fromVolume.wrt  = WORLD
    endif

    -- From default plane
    !orientation   = object ORIENTATION('Y is ' & !fromTop & ' and X is ' & !fromPath)
    !fromPlaneFrom = object PLANE(!fromVolume.from, !orientation)
    !fromPlaneTo   = object PLANE(!fromVolume.to,   !orientation)

    -- Useful when debugging
    -- !gplane = object GPHPLANE(!fromPlaneFrom)
    -- !gplane.description = 'fromPlaneFrom'
    -- !gplane.tag = true
    -- !gplane.draw(98)
    -- !gplane = object GPHPLANE(!fromPlaneTo)
    -- !gplane.description = 'fromPlaneTo'
    -- !gplane.tag = true
    -- !gplane.draw(99)

  endif

  -- Section SCTN
  if(!fromSection.hardType eq 'SCTN') then
    !toSide        = !toSection.orientation.xDir()
    !toTop         = !toSection.orientation.yDir()
    !toPath        = !toSection.orientation.zDir()

    -- Local volume of section
    !toVolume      = object LOCALVOLUME(!toSection, !toSection)
    if (!toSection.type eq 'STWALL') then
      !toVolume.from = !toSection.plStart.otow.wrt(world)
      !toVolume.to   = !toSection.plEnd.ibow.wrt(world)
      !toVolume.wrt  = WORLD
    endif

    -- From default plane
    !orientation   = object ORIENTATION('Y is ' & !toTop & ' and X is ' & !toPath)
    !toPlaneFrom   = object PLANE(!toVolume.from, !orientation)
    !toPlaneTo     = object PLANE(!toVolume.to,   !orientation)

    -- Useful when debugging
    -- !gplane = object GPHPLANE(!toPlaneFrom)
    -- !gplane.description = 'toPlaneFrom'
    -- !gplane.tag = true
    -- !gplane.draw(100)
    -- !gplane = object GPHPLANE(!toPlaneTo)
    -- !gplane.description = 'toPlaneTo'
    -- !gplane.tag = true
    -- !gplane.draw(101)

  endif

  -- If the "top" direction of the two sections are not parallel, then return
  if(!fromTop.isParallel(!toTop).not()) then
    !!error.text = 'Elements "Y" axis of both elements have to be parallel before the ends can be mitred.'
    return false
  endif

  -- Use different planes for IF start to end / end to start  ELSE  end to end / start to start
  if(!flipFlag.not()) then
    !lineFrom = !fromPlaneFrom.intersection(!toPlaneFrom)
    !lineTo   = !fromPlaneTo.intersection(!toPlaneTo)
  else
    !lineFrom = !fromPlaneFrom.intersection(!toPlaneTo)
    !lineTo   = !fromPlaneTo.intersection(!toPlaneFrom)
  endif

  -- Define start from point on the to line
  !point         = !lineTo.near(!lineFrom.startPosition)
  !plane         = !lineFrom.startPosition.plane(!lineFrom.endPosition, !point)

  !directionA   = !plane.orientation.zDir()
  !directionB   = !directionA.opposite()

    -- Useful when debugging
    -- !gplane = object GPHPLANE(!plane)
    -- !gplane.description = 'plane'
    -- !gplane.tag = true
    -- !gplane.detail = true
    -- !gplane.draw(102)

  -- Set End Directions
  -- "from" section
  !!ce      = !fromSection
  if(!fromEnd eq 'START') then
    if(!fromPath.angle(!directionA) lt 90) then
      DRNSTART $!directionA
    else
      DRNSTART $!directionB
    endif
    -- Set the cutplane of the joint start reference
    if (!!ce.joiS.neq(nulref)) then
      !!ce = !!ce.joiS
      CUTPLANE DRNS OF CREF
      handle any
        -- must be a bad link
      endhandle
    endif
  else
    if(!fromPath.opposite().angle(!directionA) lt 90) then
      DRNEND   $!directionA
    else
      DRNEND   $!directionB
    endif
    -- Set the cutplane of the joint end reference
    if (!!ce.joiE.neq(nulref)) then
      !!ce = !!ce.joiE
      CUTPLANE DRNE OF CREF
      handle any
        -- must be a bad link
      endhandle
    endif

  endif

  -- "to" section
  !!ce      = !toSection
  if(!toEnd eq 'START') then
    if(!toPath.angle(!directionA) lt 90) then
      DRNSTART $!directionA
    else
      DRNSTART $!directionB
    endif
    -- Set the cutplane of the joint start reference
    if (!!ce.joiS.neq(nulref)) then
      !!ce = !!ce.joiS
      CUTPLANE DRNS OF CREF
      handle any
        -- must be a bad link
      endhandle
    endif
  else
    if(!toPath.opposite().angle(!directionA) lt 90) then
      DRNEND   $!directionA
    else
      DRNEND   $!directionB
    endif
    -- Set the cutplane of the joint end reference
    if (!!ce.joiE.neq(nulref)) then
      !!ce = !!ce.joiE
      CUTPLANE DRNE OF CREF
      handle any
        -- must be a bad link
      endhandle
    endif


  endif

  -- Return
  !!ce = !reference
  return true
