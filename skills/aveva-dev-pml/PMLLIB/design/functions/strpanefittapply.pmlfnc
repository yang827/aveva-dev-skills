--
-- Description:
-- Create fitting at given position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaneFittApply()

-- Create Fitting
if (!!strPaneFitt.mode eq 'NEW') then
     call !!sctlCrElem('FIXING','WANDF')
     !!strPaneFitt.fitting = !!ce
else
     !!ce = !!strPaneFitt.fitting
endif

-- Set Justification
if (!!ce.type eq 'SBFI' ) then


     !refe = !!ce
     !!ce = !!ce.owner

     !just = !!strPaneFitt.just.selection('RTEXT')

     SJUSTIFICATION $!just

     !!ce = !refe
-- Set delpos
     !position = !!edgGeomData.position.wrt(!!strFittSpec.owner).string()

     DELPOS $!position

else

     !just = !!strPaneFitt.just.selection('RTEXT')

     SJUSTIFICATION $!just

-- Set position
     !position = !!edgGeomData.position.wrt(!!strFittSpec.owner).string()

     POS $!position

endif
endfunction
-- End of function definition for !!strPaneFittApply
