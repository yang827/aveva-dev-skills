--
-- Description:
-- Rotate current fitting by given angle
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaneFittBang()

PFIT
handle any
     SBFI
     handle any
          CMPF
          handle any
                !!ce = !!strPaneFitt.fitting
          endhandle
     endhandle
endhandle

if (!!ce.type eq 'PFIT' or !!ce.type eq 'CMPF' or !!ce.type eq 'SBFI') then
      !value = !!ce.bang + !!strPaneFitt.bang.val.real()
      if (!value gt 180) then
            !value = !value - 360
      elseif (!value lt -180) then
            !value = !value - 360
      endif

      BANG $!value
endif


endfunction
-- End of function definition for !!strPaneFittBang
