--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaneFittConf()

if (!!strPaneFitt.mode eq 'MODIFY') then
     !panel = !!strPaneFitt.fitting.owner
     if (!panel.type neq |PANE| ) then
          !panel = !panel.owner
     endif
else
     !panel = !!strFittSpec.owner
     if (!panel.type ne |PANE| ) then
          !panel = !panel.owner
          if (!panel.type ne |PANE| ) then
               !panel = PANEL
          endif
     endif
endif
-- Find Loop
!message = STRING()
!ploo = !!findFirstMember(!panel, 'PLOO', '', !message)

-- Calculate plane of panel
!plane = !!consPlanePanel(!panel, 1, !ploo)

-- $P plane $!plane.direction $!plane.position
-- Map position on to that plane
!position = !!consPointOnPlane( !!edgGeomData.position, !plane)

-- Display cylinder at that point
-- !height = 3 * !ploo.height
-- !diameter = !height
-- call !!drawAidCylinder(!diameter, !height,  !position, !plane.orientation, True, 43201 )

-- Save Position
!!strPaneFitt.position = !position

call !!strPaneFittApply()

endfunction
-- End of function definition for !!strPaneFittConf
