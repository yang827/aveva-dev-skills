-- Define function
define function !!strPaneFittDism()

!!edgCntrl.remove('Position Panel Fitting')

-- Clean up graphics
AID CLEAR CYLI 43201
handle any
endhandle

UNENHANCE ALL

endfunction
-- End of function definition for !!strPaneFittDism
