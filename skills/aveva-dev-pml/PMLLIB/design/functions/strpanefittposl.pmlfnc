--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaneFittPosl()

-- Save Value from gadget
 !!strPaneFitt.posl = !!strPaneFitt.just.selection('RTEXT')

PFIT
handle any
     SBFI
     handle any
          CMPF
          handle any
          endhandle
     endhandle
endhandle

-- Save value of gadget
      !value = !!strPaneFitt.posl
if (!!ce.type eq 'PFIT' or !!ce.type eq 'CMPF') then
-- Set pline
      SJUST $!value

elseif  ( !!ce.type eq 'SBFI') then
-- Set pline
      !refe = !!ce
      !!ce = !!ce.owner
      SJUST $!value
      !!ce = !refe

endif



endfunction
-- End of function definition for !!strPaneFittPosl
