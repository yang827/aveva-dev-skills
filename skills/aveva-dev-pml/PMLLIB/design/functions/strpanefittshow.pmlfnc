--
--
-- Description:
-- Set up form and Event driven graphics
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode (NEW , MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaneFittShow(!mode is STRING)

  -- Save design parameters
  if (defined(!!cdcaDesp)) then
    !!strFittSpec.desp = ARRAY()
    do !i indices !!cdcaDesp
      !!strFittSpec.desp[!i] = !!cdcaDesp[!i].real()
    enddo
  endif

  -- hide specifications forms
  if (!mode eq 'NEW') then
    if (defined(!!strFittSpec) ) then
      hide !!strFittSpec
    endif
    if (defined(!!cdSetProp) ) then
      hide _cdSetProp
    endif
  endif

  show !!strPaneFitt

  -- Save mode
  !!strPaneFitt.mode = !mode
  if (!mode eq 'NEW') then
    !!strPaneFitt.radio.val = 1
  else
    !!strPaneFitt.radio.val = 2
  endif

  -- save element
  if (!mode neq 'NEW') then
    PFIT
    handle any
      SBFI
      handle any
        CMPF
        handle any
          !!messageFile.error(155, 018)
        endhandle
      endhandle
    endhandle
    !!strPaneFitt.fitting = !!ce
  endif

  -- set up EDG
  !!edgCntrl.remove('Position Panel Fitting')

  !packet = object EDGPACKET()
  !packet.defineWrapper('POSITION','!!strPaneFittConf()','Pick Position for Fitting')
  !packet.description = 'Position Panel Fitting'

  !!edgCntrl.add(!packet)

  -- Find owner
  if (!mode eq 'NEW') then
    !owner = !!strFittSpec.owner
  else
    -- Find owning sections
    if (!!strPaneFitt.fitting.hardType eq 'PFIT' or !!strPaneFitt.fitting.hardType eq 'CMPF' ) then
      !owner = !!strPaneFitt.fitting.owner
    else
      !owner = !!strPaneFitt.fitting.owner.owner
    endif
  endif

  call !!enhanceItem(!owner, 'Salmon' )
  !!strPaneFitt.element.val = !owner.flnm

  -- Set value of gadget
  if (!mode neq 'NEW') then
    !!strPaneFitt.just.select('RTEXT',!!strPaneFitt.fitting.sjust)
  endif

endfunction
-- End of function definition for !!strPaneFittShow
