--
--
-- Description:
-- Complete action i.e.
-- Create a new vertex with radius if in create mode
-- or Modify existing vertex if in edit mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveCentAppl()

-- clear aid graphics
call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40102)
call !!clearAid('TEXT', 40102)

-- Remember where we were
!refe = !!ce

!!ce = !!sctlPave.current

-- Find pole positions to define this arc
!polePos = !!strPaveCentInter(!!ce)

-- Handle first pole position
     if (!!sctlPave.radio.val eq 1) then
    -- Create new vertex
         if (!!ce.owner.type eq 'PLOO') then
               NEW PAVE
         else
               NEW VERT
         endif

     endif
     -- Set attributes

     !cPosString = !polePos[1].string()
     POS $!cPosString
     !radius = !!strPaveCent.radius.string()
     FRADIUS $!radius

-- If more than one pole position calculate additional vertex
     if (!polePos.size() gt 1) then
          do !index from 2 to !polePos.size()
               if (!!ce.owner.type eq 'PLOO') then
                     NEW PAVE
               else
                     NEW VERT
              endif

     -- Set attributes

              !cPosString = !polePos[!index].string()
              POS $!cPosString
              !radius = !!strPaveCent.radius.string()
              FRADIUS $!radius
          enddo
     endif

    -- Update Counters
     !!sctlPave.current = !!ce
     !!sctlPave.number = !!ce.owner.members.findFirst(!!ce)

-- Update List
call !!sctlPaveList(!!ce.owner)

!!ce = !refe

endfunction
-- End of function definition for !!strPaveCentAppl
