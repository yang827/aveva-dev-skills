--
-- Description:
-- Save the point picked as centre of curve and
-- and see if we have enough information to complete
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveCentCent()

-- Save Value
!!strPaveCent.centre = !!sctlPave.plane.near(!!edgGeomData.position)

-- Display position of origin
     call !!clearAid('SPHERE', 40102)
     call !!drawAidSphere(200,!!strPaveCent.centre,40102)
     call !!clearAid('TEXT', 40102)
     call !!drawAidText('Centre',!!strPaveCent.centre , 40102)

-- Switch EDG
call !!strPaveCentPick('CIRCUM')

-- See if we have enough information to complete
if (Set(!!strPaveCent.radius) and Set(!!strPaveCent.circum) ) then
      call !!strPaveCentConf()
endif


endfunction
-- End of function definition for !!strPaveCentCent
