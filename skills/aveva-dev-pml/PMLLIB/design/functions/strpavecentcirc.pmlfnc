--
--
-- Description:
-- Save the point picked as point on circumference
-- and see if we have enough information to complete
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveCentCirc()

-- Save Value
!!strPaveCent.circum = !!sctlPave.plane.near(!!edgGeomData.position)

-- Switch EDG
call !!strPaveCentPick('CENTRE')

-- Check if Centre is set
if (Set(!!strPaveCent.centre) ) then
      if (!!strPaveCent.lock.val.not() ) then
           !!strPaveCent.radius = !!consDistPos(!!strPaveCent.circum, !!strPaveCent.centre)
           !!strPaveCent.value.val = !!strPaveCent.radius
      endif
      if (Set(!!strPaveCent.radius) and !!strPaveCent.radius gt 0 ) then
           call !!strPaveCentConf()
      endif
endif

endfunction
-- End of function definition for !!strPaveCentCirc
