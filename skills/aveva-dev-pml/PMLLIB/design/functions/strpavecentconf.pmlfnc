--
--
-- Description:
-- If confirming then show some aid graphics
-- otherwise complete action
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveCentConf()

-- Draw Aid Cylinder
    if (!!strPaveCent.radius lt 1000mm ) then
          !height = !!strPaveCent.radius
    else
          !height = 1000mm
    endif
    !diameter = 2 * !!strPaveCent.radius
    call !!clearAid('CYLI', 40101)
    call !!drawAidCylinder(!diameter, !height,  !!strPaveCent.centre, !!sctlPave.plane.orientation, True, 40101 )
-- Enable accept button
    !!strPaveCent.accept.active = True

endfunction
-- End of function definition for !!strPaveCentConf
