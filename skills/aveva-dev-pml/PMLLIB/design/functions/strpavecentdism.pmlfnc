-- Define function
define function !!strPaveCentDism()

!!edgCntrl.remove('Panel Vertex Centre Centre')
!!edgCntrl.remove('Panel Vertex Centre Radius')

call !!clearAid('CYLI', 40101)
call !!clearAid('SPHERE', 40102)
call !!clearAid('TEXT', 40102)

endfunction
-- End of function definition for !!strPaveCentDism
