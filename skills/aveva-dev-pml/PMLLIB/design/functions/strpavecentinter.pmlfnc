--
--
-- Description:
-- Calculate intersection point(s) from centre and radius
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      vertex of extrusion
-- Return:
--   [Data Type] [Description]
--    ARRAY      Array of intersection points
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveCentInter(!vertex is DBREF) is ARRAY

-- Find Number of current Vertex
!number = !vertex.owner.members.findFirst(!vertex)
-- Find number of next
if (!number eq !vertex.owner.mCount) then
     !endNo = 1
else
     !endNo = !number + 1
endif
-- Find number of previous
if (!!sctlPave.radio.val eq 1) then
     !startNo = !number
else
     if (!number eq 1) then
          !startNo = !vertex.owner.mCount
     else
          !startNo = !number - 1
     endif
endif
-- Find positions of vertices
     !previous = !vertex.owner.members[!startNo].position
     !next = !vertex.owner.members[!endNo].position

-- Construct Arc from information available

!arc = !!strPaveCent.centre.arcCentre(!previous, !next, !!strPaveCent.circum, !!sctlPave.plane.direction(), !!strPaveCent.radius)

-- Split arc according to size
if (!arc.angle().abs() gt 135) then
     if (!arc.angle().abs() gt 270) then
           !arcs = !arc.split(3)
     else
           !arcs = !arc.split(2)
     endif
else
     !arcs[1] = !arc
endif

-- For each arc calculate pole position
!return = object ARRAY()

do !each values !arcs

     !return.append(!each.pole())

enddo

return !return


endfunction
-- End of function definition for !!strPaveCentInter
