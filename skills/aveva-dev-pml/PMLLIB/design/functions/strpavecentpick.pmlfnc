-- Define function
define function !!strPaveCentPick(!mode is STRING)

!!edgCntrl.remove('Panel Vertex Centre Centre')
!!edgCntrl.remove('Panel Vertex Centre Radius')

!packet = object EDGPACKET()

if (!mode.upcase() eq 'CENTRE' ) then
     !packet.defineWrapper('POSITION','!!strPaveCentCent()','Pick Position of Curve Centre')
     !packet.description = 'Panel Vertex Centre Centre'
     !!strPaveCent.radio.val = 2
else
     !packet.defineWrapper('POSITION','!!strPaveCentCirc()','Pick Position of Curve Circumference')
     !packet.description = 'Panel Vertex Centre Radius'
     !!strPaveCent.radio.val = 1
endif

!!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!strPaveCentPick
