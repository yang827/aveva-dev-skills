-- Define function
define function !!strPaveCentRad()

-- Save radius
!!strPaveCent.radius = !!strPaveCent.value.val.real()

!!strPaveCent.lock.val = True

if(Set(!!strPaveCent.centre) and Set(!!strPaveCent.circum) ) then
      call !!strPaveCentConf()
endif

endfunction
-- End of function definition for !!strPaveCentRad
