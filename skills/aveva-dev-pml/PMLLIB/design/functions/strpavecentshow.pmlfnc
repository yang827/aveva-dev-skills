-- Define function
define function !!strPaveCentShow()

if (!!sctlPave.panel.type eq 'PANE' ) then
     !type = 'PLOO'
else
     !type = 'LOOP'
endif

!message = object STRING()
!ploo = !!findFirstMember(!!sctlPave.panel, !type, '', !message)
-- Check that a curve is sensible here
-- First vertex must be POINSP not CURVE
if (!ploo.mCount le 2) then
   !!messageFile.error(155, 012)
   return
endif

-- Don't show form if no radius
if (!!sctlPave.radio.val eq 2 and !!sctlPave.current.fRadius.abs() lt 1mm ) then
     return
endif

-- Hide other of forms
if (defined(!!strPaveFill) and !!strPaveFill.shown() ) then
     !!strPaveFill.hide()
     !!strPaveFill.dismiss()
endif
if (defined(!!strPaveRad) and !!strPaveRad.shown() ) then
     !!strPaveRad.hide()
     !!strPaveRad.dismiss()
endif
if (defined(!!strPaveThru) and !!strPaveThru.shown() ) then
     !!strPaveThru.hide()
     !!strPaveThru.dismiss()
endif


-- Show Form

show !!strPaveCent

-- if editing curve
if (!!sctlPave.radio.val eq 2) then

-- Calculate existing centre position
    !!strPaveCent.centre = !!sctlPave.current.pPos[8]
-- Calculate point on mid-point of existing arc
-- Construct line from centre to pole position
    !line = !!sctlPave.current.pPos[8].line(!!sctlPave.current.pPos[1])
-- Extend start to actual arc as this is mid-point on existing arc
    !!strPaveCent.circum = !line.extendStart(-1 * !!sctlPave.current.fRadius).startPosition
    !!strPaveCent.radius = !!sctlPave.current.fRadius
    !!strPaveCent.value.val = !!strPaveCent.radius
    !!strPaveCent.radio.val = 1

else

    !!strPaveCent.circum = object POSITION()
    !!strPaveCent.centre = object POSITION()
    !!strPaveCent.radius = REAL()
    !!strPaveCent.value.val = 0
    !!strPaveCent.radio.val = 2

endif

!!strPaveCent.accept.active = False

-- set up EDG
if (!!strPaveCent.radio.val eq 1) then
     call !!strPaveCentPick('CIRCUM')
else
     call !!strPaveCentPick('CENTRE')
endif



endfunction
-- End of function definition for !!strPaveCentShow
