--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveFillShow()

    if (!!sctlPave.panel.type eq 'PANE' ) then
          !type = 'PLOO'
     else
          !type = 'LOOP'
     endif

!message = object STRING()
!ploo = !!findFirstMember(!!sctlPave.panel, !type, '', !message)
-- Check that a curve is sensible here
-- First vertex must be POINSP not CURVE
if (!ploo.mCount le 2) then
   !!messageFile.error(155, 012)
   return
endif

-- Don't show form if no radius
if (!!sctlPave.radio.val eq 2 and !!sctlPave.current.fRadius.abs() lt 1mm ) then
     return
endif

-- Hide other of forms
if (defined(!!strPaveCent) and !!strPaveCent.shown() ) then
     !!strPaveCent.hide()
     !!strPaveCentDism()
endif
if (defined(!!strPaveRad) and !!strPaveRad.shown() ) then
     !!strPaveRad.hide()
     !!strPaveRad.dismiss()
endif
if (defined(!!strPaveThru) and !!strPaveThru.shown() ) then
     !!strPaveThru.hide()
     !!strPaveThru.dismiss()
endif

-- Show Form

show !!strPaveFill

-- if editing curve
if (!!sctlPave.radio.val eq 2) then

-- Calculate existing centre position
    !!strPaveFill.pole = !!sctlPave.current.position
    !!strPaveFill.radius = !!sctlPave.current.fRadius
    !!strPaveFill.value.val = !!strPaveFill.radius
    !!strPaveFill.radio.val = 1

else

    !!strPaveFill.pole = object POSITION()
    !!strPaveFill.radius = REAL()
    !!strPaveFill.value.val = 0
    !!strPaveFill.radio.val = 1

endif

!!strPaveFill.accept.active = False

-- set up EDG

 !!strPaveFill.pick('POLE')


endfunction
-- End of function definition for !!strPaveFillShow
