-- Define function
define function !!strPaveRelShow()

-- Check that there is at least one vertex

!refe = !!ce
!!ce = !!sctlPave.panel
if (!!sctlPave.panel.type eq |PANE|) then
    PLOO 1
else
    LOOP 1
endif
!loop = !!ce
!!ce = !refe
if (!loop.mCount lt 1) then
    return
endif

-- Hide other of forms
if (defined(!!strPaveCent) and !!strPaveCent.shown() ) then
     !!strPaveCent.hide()
     !!strPaveCentDism()
endif
if (defined(!!strPaveRad) and !!strPaveRad.shown() ) then
     !!strPaveRad.hide()
     !!strPaveRad.dismiss()
endif
if (defined(!!strPaveFill) and !!strPaveFill.shown() ) then
     !!strPaveFill.hide()
     !!strPaveFill.dismiss()
endif
if (defined(!!strPaveThru) and !!strPaveThru.shown() ) then
     !!strPaveThru.hide()
     !!strPaveThru.dismiss()
endif

-- Show Form

show !!strPaveRel

!!strPaveRel.setup()

-- set up EDG

!!strPaveRel.pickDirection()


endfunction
-- End of function definition for !!strPaveRelShow
