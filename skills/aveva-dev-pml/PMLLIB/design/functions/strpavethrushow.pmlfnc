--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPaveThruShow()

if (!!sctlPave.panel.type eq 'PANE' ) then
     !type = 'PLOO'
else
     !type = 'LOOP'
endif

!message = object STRING()
!ploo = !!findFirstMember(!!sctlPave.panel, !type, '', !message)
-- Check that a curve is sensible here
-- First vertex must be POINSP not CURVE
if (!ploo.mCount le 2) then
   !!messageFile.error(155, 012)
   return
endif

-- Don't show form if no radius
if (!!sctlPave.radio.val eq 2 and !!sctlPave.current.fRadius.abs() lt 1mm ) then
     return
endif

-- Hide other of forms
if (defined(!!strPaveCent) and !!strPaveCent.shown() ) then
     !!strPaveCent.hide()
     !!strPaveCentDism()
endif
if (defined(!!strPaveFill) and !!strPaveFill.shown() ) then
     !!strPaveFill.hide()
     !!strPaveFill.dismiss()
endif
if (defined(!!strPaveRad) and !!strPaveRad.shown() ) then
     !!strPaveRad.hide()
     !!strPaveRad.dismiss()
endif


-- Show Form

show !!strPaveThru

!!strPaveThru.control = object POSITION()

-- set up EDG

!!strPaveThru.pick()

!!strPaveThru.accept.active = False


endfunction
-- End of function definition for !!strPaveThruShow
