--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Fri Feb 20 17:07:56 1998
--
--
-- Description:
-- Create a Pnode at the given end of the specified gensec or section
-- (equivalent to CALLSTL LPNODE)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Gensec or SCTN
--    2   R      STRING      START or END
--    3   R      DBREF       Joint at end
-- Return:
--   [Data Type] [Description]
--   DBREF        PNODE
--
------------------------------------------------------------------------

-- Define function
define function !!strPnodeCreate(!element is DBREF, !end is STRING, !joint is DBREF) is DBREF

  !return = object DBREF()

  !wallBeam = !element
  if (!wallBeam.hardType ne 'GENSEC' and !wallBeam.hardType ne 'SCTN') then
    !!messageFile.error(155, 017)
    return !return
  endif
  !endJoint = !joint

  !refe = !!ce

  -- Check we can create PNODEs
  if (defined(!!appDesMain.node) and !!appDesMain.node.val) then
    -- Find Position for PNODE
    if (!end eq 'START' ) then
      !position = !wallBeam.poss.wrt(STRU)
      handle any
        !position = !wallBeam.pos.wrt(STRU)
      endhandle
    else
      !position = !wallBeam.pose.wrt(STRU)
      handle any
        !position = !wallBeam.pos.wrt(STRU)
      endhandle
    endif

  elseif (!wallBeam.type eq 'STWALL' or !wallBeam.type eq 'WALL' ) then
    -- Find Position for PNODE
    if (!end eq 'START' ) then
      !position = !wallBeam.poss.wrt(STRU)
      handle any
        !position = !wallBeam.pos.wrt(STRU)
      endhandle
    else
      !position = !wallBeam.pose.wrt(STRU)
      handle any
        !position = !wallBeam.pos.wrt(STRU)
      endhandle
    endif
    !position.up = 0
  endif
  -- Find Tolerance
       var !tolerance $_CDSREFTOL_PNODE
       handle any
           var !tolerance 1mm
       endhandle

       if (defined(!!appDesMain.node) and !!appDesMain.node.val) then
  -- Find PNODE storage area
            !store = !!findStorageArea('BANDC', 'PNODE')
            if (Undefined(!store) or Unset(!store) ) then
                 call !!dbRefUpdate(!!ce)
                 !store = !refe
            endif
            !scanElement = !store.string()
       else
            !struElement = STRU
            !scanElement = !struElement.string()
            !store = FRMW
       endif

  -- Scan available PNODEs for any within tolerance
       var !coll COLLECT ALL PNODE FOR $!scanElement

       !found = False
       do !node values !coll
                 !existing = !node.dbRef().nPos.wrt(World)
             -- Calculate distance between two positions
             !dist = !position.distance(!existing)
             if ( !dist lt !tolerance.real() ) then
                  !found = true
                  !!ce = !node.dbRef()
                  !return = !!ce
                  if (!!ce.mCount eq 0 or !wallBeam ne !!ce.member[1].cref ) then
                       break
                  endif
             endif
         enddo
         if (not !found) then
              !!ce = !store
              NEW PNODE
              !return = !!ce
              !positionString = !position.string()
              NPOS $!positionString
              if( !!namOpt.auto() ) then
                   !name = !!namOpt.nameString(!!ce, ||, true, false)
                   if (!name.unset().not()) then
                        NAME /$!name
                   endif
              endif
         endif
  -- Now connect end to this PNODE
         if (!endJoint.unset() or !endJoint eq nulref) then
              if (!wallBeam.hardType eq 'SCTN') then
                   NEW PJOI
              else
                   NEW FIXING
              endif
              if( !!namOpt.auto() ) then
                   !name = !!namOpt.nameString(!!ce, ||, true, false)
                   if (!name.unset().not()) then
                        NAME /$!name
                   endif
              endif
              !elementString = !wallBeam.string()
              CREF $!elementString $!end
              JFREE TRUE
         else
              if (!endJoint.owner ne !!ce ) then
                   !string = !endJoint.string()
                   INCLUDE $!string
              endif
         endif

  !!ce = !refe
  return !return

endfunction
-- End of function definition for !!strPnodeCreate
