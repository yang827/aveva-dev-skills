--
--
-- Description:
-- Move the PNODE's at the end of this GENSEC to the first and last POINSP positions
-- and remitre them accordingly
-- .
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strPnodeSpine(!element is DBREF)

if (!element.hardType ne |GENSEC| ) then
     return
endif
-- Save passed element just in case we pass !!ce
!wall = !element
!pos = !element.poss
-- handle any
--    !pos = !element.pos
-- endhandle
!pos = !element.pose
-- handle any
--    !pos = !element.pos
-- endhandle

!refe = !!ce

-- Navigate to node at start

if (!wall.joiS ne nulref and !wall.joiS.set()) then
     !!ce = !wall.joiS.owner
     if (!!ce.type eq 'PNOD' ) then
-- otherwise create or find  pnode at required position
           !!ce = !!strPnodeCreate(!wall, 'START', !wall.joiS)
-- Make sure all joints are JFREE true
           !joints = !!ce.members
           do !joint values !joints
               if (!joint.type eq |PJOI| or !joint.type eq |FIXING| ) then
                    if (not !joint.jfree ) then
                         !!ce = !joint
                         JFREE TRUE
                    endif
                endif
           enddo
     endif
endif

-- Navigate to node at end

if (!wall.joiE ne nulref and !wall.joiE.set()) then
     !!ce = !wall.joiE.owner
     if (!!ce.type eq 'PNOD') then
-- otherwise create or find pnode at required position
           !!ce = !!strPnodeCreate(!wall, 'END', !wall.joiE)
-- Make sure all joints are JFREE true
           !joints = !!ce.members
           do !joint values !joints
               if (!joint.type eq |PJOI| or !joint.type eq |FIXING| ) then
                    if (not !joint.jfree ) then
                         !!ce = !joint
                         JFREE TRUE
                    endif
                endif
           enddo
     endif
endif

!!ce = !refe


endfunction
-- End of function definition for !!strPnodeSpine
