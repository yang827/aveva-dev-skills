--
-- File:            strringcreate.pmlfnc
--   Type:          Function Definition
--   Group:         Common to all Structural Applications

--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Nov 11 15:16:18 "GMT 1998
--
--
-- Description:
-- Create "ring" section.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc defining the "ring"
--    2   R      STRING      Storage Group
--    3   R      STRING      Storage Area
--    4   R      DBREF       Default storage area, if unable to find one in the store system
--    5   R      BOOLEAN     True if a full ring is to be created
--    6   R      STRING      Type of element (soft type) of GENSEC
--    7   R      STRING      Application mode, WALL or SECTION
-- Return:
--   [Data Type] [Description]
--    DBREF       GENSEC created
--
------------------------------------------------------------------------

define function !!strRingCreate(!passedArc is ARC, !group is STRING, !area is STRING, !defaultStore is DBREF, !fullRing is BOOLEAN, !elementType is STRING, !mode is STRING ) is DBREF

  -- Initialise Variables
  !arc       = !passedArc

  -- Check we can create a curved section at this point
  !store     = !!getStorageArea(!group, !area)

  -- If store is unset, can we create the panel in or above where we are
  if(!store.unset()) then
    !store   = !defaultStore
  endif

  -- If full circle is set, make arc 360
  if(!fullRing) then
    !arc.startAngle = 0
    !arc.endAngle   = 360
  endif

  -- If we are creating a WALL, then always force Z to be up
  if(!elementType eq 'WALL') then

    -- Check that the wall to be created is vertical
    if ( (!arc.orientation.zDir().wrt(world).angle(D).int() eq 0) or (!arc.orientation.zDir().wrt(world).angle(U).int() eq 0) ) then
      -- ok
    else
      !answer = !!alert.confirm('The Wall will not be Vertical! Do you wish to continue?')
      if (!answer eq 'NO') then
        return object DBREF()
      endif
    endif

    -- Is arc facing down
    if(!arc.orientation.zDir().wrt(world).angle(D).int() eq 0) then
      !start           = !arc.anglePosition(!arc.startAngle)
      !end             = !arc.anglePosition(!arc.endAngle)
      !arc.orientation = object ORIENTATION('Y is ' & !arc.orientation.yDir().opposite() & ' and Z is U')

      -- Handle none 360 arcs
      if(!fullRing.not()) then
        !arc.startAngle  = !arc.near(!start)
        !arc.endAngle    = !arc.near(!end)
      endif
      !arc.sense       = !arc.sense.not()

    endif
  endif

  -- Define Curve data
  if (!arc.startAngle eq !arc.endAngle) then
    !angle = 360
    !arc.startAngle = 0
    !arc.endAngle = 360
  else
    !angle     = !arc.angle()
  endif

  if (!arc.sense.not()) then
    !angle = !angle * -1
  endif
  !start     = !arc.anglePosition(!arc.startAngle)
  !end       = !arc.anglePosition(!arc.endAngle)

  -- Move to creation area
  !!ce = !store

  -- Create Element
  NEW $!<elementType>
  FUNC 'RING'
  !section = !!ce

  -- Position and orientate
  POSITION    $!<arc.position>
  ORIENTATION $!<arc.orientation>

  -- Create Spine
  NEW SPINE

  -- If the angle is <= 360 we define spine as point, curve, point
  if(!angle.sbetween(-360,360)) then

    -- Curve Position
    !midPoint  = !arc.anglePosition((!arc.startAngle + !angle / 2))

    -- How many points are there
    NEW POINSP
    POSITION  $!<start>
    NEW CURVE CURTYPE THRU RADIUS $!<arc.radius> RADS TRUE
    CPOSITION $!<arc.position>
    POSITION  $!<midPoint>
    NEW POINSP
    POSITION  $!<end>

  -- If the angle is > 180 we define the spine as point, curve, point, curve, point
  else

    -- Curve Position
    !midPoint  = !arc.anglePosition((!arc.startAngle + !angle / 2))
    !curve1    = !arc.anglePosition((!arc.startAngle + !angle * .25))
    !curve2    = !arc.anglePosition((!arc.startAngle + !angle * .75))

    -- How many points are there
    NEW POINSP
    POSITION  $!<start>
    NEW CURVE CURTYPE THRU RADIUS $!<arc.radius> RADS TRUE
    CPOSITION $!<arc.position>
    POSITION  $!<curve1>
    NEW POINSP
    POSITION  $!<midPoint>
    NEW CURVE CURTYPE THRU RADIUS $!<arc.radius> RADS TRUE
    CPOSITION $!<arc.position>
    POSITION  $!<curve2>
    NEW POINSP
    POSITION  $!<end>

  endif

  -- Update Spine
  !!ce            = !section

  -- Set DRNS and DRNE directions always make these perpendicular.
  DRNS PERP
  DRNE PERP

  if (!mode eq 'WALL') then
    call !!strSectionData(!section)

  else
    -- Assign specification data
    if(!!appDesMain.prfl.val) then
      call !!strSectionData(!section)
    endif
  endif

  -- Return to reference
  !!ce = !section

  -- Return
  return !section

endfunction
-- End of function definition for !!strRingCreate
