-- Author:          N.Holmes
-- Created:         Wed Nov 11 15:16:18 "GMT 1998
--
--
-- Description:
-- Create straight unconnected section (SCTN).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line defining the section
--    2   R      STRING      Storage Group
--    3   R      STRING      Storage Area
--    4   R      DBREF       Default storage area, if unable to find one in the store system
--    5   R      STRING      Type of element (soft type) of SCTN
--    6   R      STRING      Application mode, WALL or SECTION
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!strSctnCreate(!passedLine is LINE, !group is STRING, !area is STRING, !defaultStore is DBREF, !elementType is STRING, !mode is STRING )

  -- Initialise Variables
  !line                  = !passedLine

  -- Check we can create a curved section at this point
  !store     = !!getStorageArea(!group, !area)

  -- If store is unset, can we create the panel in or above where we are
  if(!store.unset()) then
    !store   = !defaultStore
  endif

  -- Section Definition object
  !section               = object STLSCTN()
  !section.type          = !elementType

  -- Define start/end position
  !section.startPosition = !line.startPosition.wrt(World)
  !section.endPosition   = !line.endPosition.wrt(World)

  -- Define Connections
  if(undefined(!!appDesMain.node)) then
    !section.freeConnect = true
  else
    !section.freeConnect = !!appDesMain.node.val
  endif

  -- Section store Data
  !section.storeGroup    = !group
  !section.storeArea     = !area
  !section.store         = !store

  -- Create section
  !section.create()

  if (!mode eq 'WALL') then
    call !!strSectionData(!section.reference)

  else
    -- Assign specification data
    if(!!appDesMain.prfl.val) then
      call !!strSectionData(!section.reference)
    endif
  endif

  -- Return to reference
  !!ce = !section.reference

endfunction
-- End of function definition for !!strSctnCreate
