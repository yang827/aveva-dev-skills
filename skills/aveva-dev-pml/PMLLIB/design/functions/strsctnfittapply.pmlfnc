--
--
-- Description:
-- Create fitting at given position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strSctnFittApply()

-- Disable button
!!strSctnFitt.bang.active = True

-- Create Fitting
if (!!strSctnFitt.mode eq 'NEW') then
     call !!sctlCrElem('FIXING','WANDF')
     !!strSctnFitt.fitting = !!ce
else
     !!ce = !!strSctnFitt.fitting
endif

-- Set Position Line
-- Try to find p-line from event driven graphics
if (!!edgGeomData.pLineKey.set() and not !!edgGeomData.pLineKey.trim().empty() ) then
     !pLine = !!edgGeomData.pLineKey
else
     !pLine = !!strSctnFitt.just.selection('DTEXT')
endif
-- Set position line
if (!!strSctnFitt.fitting.type eq |FIXING| ) then
     !!ce = !!ce.owner
     POSL $!pLine
     !!ce = !!strSctnFitt.fitting
elseif (!!strSctnFitt.fitting.type eq |SBFI| ) then
     !!ce = !!ce.owner
     POSL $!pLine
     !!ce = !!strSctnFitt.fitting
else
     POSL $!pLine
endif

-- Set zdistance
if (!!strSctnFitt.fitting.type eq |FIXING| ) then
--     Calculate zdist along gensec
     !poinSp = object DBREF()
     !value = !!strZDistOfPos(!!strFittSpec.owner, !!edgGeomData.position, !poinSp )
     !!ce = !!ce.owner.owner
     HPREF $!poinSp
     ZDIST $!value
     !!ce = !!strSctnFitt.fitting
elseif (!!strSctnFitt.fitting.type eq |SBFI| ) then
--     !posString = !!edgGeomData.position.wrt(WORLD).string()
--     delpos $!posString
     !!ce = !!ce.owner
     !posString = !!edgGeomData.position.string()
     ZDIST THROUGH $!posString
     !!ce = !!strSctnFitt.fitting
else
     !posString = !!edgGeomData.position.string()
     ZDIST THROUGH $!posString
endif


endfunction
-- End of function definition for !!strSctnFittApply
