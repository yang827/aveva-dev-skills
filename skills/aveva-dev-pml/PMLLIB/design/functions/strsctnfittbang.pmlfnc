--
--
-- Description:
-- Rotate current fitting by 180 degrees
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strSctnFittBang()

FIXING
handle any
     FITT
     handle any
          CMFI
          handle any
               !!ce = !!strSctnFitt.fitting
               handle any
               endhandle
          endhandle
     endhandle
endhandle

if (!!ce.type eq 'FITT' or !!ce.type eq 'CMFI') then
      if (!!ce.bangle ge 180) then
           !value = !!ce.bangle - 180
      else
           !value = !!ce.bangle + 180
      endif
      if (!value ge 360) then
           !value = !value - 360
      endif
      BANG $!value

elseif (!!ce.type eq 'FIXING' ) then

      ROTATE BY 180 THROUGH POS

endif


endfunction
-- End of function definition for !!strSctnFittBang
