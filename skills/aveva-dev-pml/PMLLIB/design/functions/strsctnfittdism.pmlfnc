-- Define function
define function !!strSctnFittDism()

!!edgCntrl.remove('Position Section Fitting')
!!edgCntrl.remove('Pick Section Fitting')

-- Clean up graphics
AID CLEAR ARROW 43200
handle any
endhandle

AID CLEAR TEXT 43200
handle any
endhandle

UNENHANCE ALL

endfunction
-- End of function definition for !!strSctnFittDism
