-- Define function
define function !!strSctnFittPosl()

-- Save Value from gadget
 !!strSctnFitt.posl = !!strSctnFitt.just.selection('DTEXT')

FIXING
handle any
     FITT
     handle any
          SBFI
          handle any
               CMFI
               handle any
               endhandle
          endhandle
     endhandle
endhandle
-- Save value of gadget
      !value = !!strSctnFitt.posl
if (!!ce.type eq 'FITT') then
-- Set pline
      POSL $!value
-- Draw Pline
      call !!aidPlineDraw(!value, !!ce.owner, !!strSctnFitt.fitting.zDist , 43200)
elseif (!!ce.type eq 'FIXING') then
-- Set pline
      !fixing = !!ce
      !!ce = PLDATU
      POSL $!value
      !!ce = !fixing
-- Draw Pline
--      call !!aidPlineDraw(!value, !!strFittSpec.owner, !!strSctnFitt.fitting.zDist , 43200)
elseif (!!ce.owner.type eq |CMFI| ) then
          !subFitting = !!ce
          !!ce = !!ce.owner
          POSL $!value
          !!ce = !subFitting
else
      -- Draw aid half way along member
     if (!!strFittSpec.owner.hardType eq |GENSEC| ) then



     else
           if (!!strFittSpec.owner.set()  ) then
                !zDist = !!strFittSpec.owner.leng / 2
                call !!aidPlineDraw(!value, !!strFittSpec.owner, !zDist, 43200)
           endif
    endif



endif



endfunction
-- End of function definition for !!strSctnFittPosl
