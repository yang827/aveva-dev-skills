--
--
-- Description:
-- Set up form and EDG
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode (NEW, MODIFY etc)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strSctnFittShow(!mode is STRING)

  -- Save design parameters
  if (defined(!!cdcaDesp)) then
    !!strFittSpec.desp = ARRAY()
    do !i indices !!cdcaDesp
      !!strFittSpec.desp[!i] = !!cdcaDesp[!i].real()
    enddo
  endif

  -- hide specifications forms
  if (!mode eq 'NEW') then
    if (defined(!!strFittSpec) ) then
         hide !!strFittSpec
    endif
    if (defined(!!cdSetProp) ) then
      hide _cdSetProp
    endif
  endif

  show !!strSctnFitt

  -- Save mode
  !!strSctnFitt.mode = !mode

  -- save element
  if (!mode neq 'NEW') then
    FIXING
    handle any
      FITT
      handle any
        SBFI
        handle any
          CMFI
          handle any
            !!messageFile.error(155, 015)
          endhandle
        endhandle
      endhandle
    endhandle
    !!strSctnFitt.fitting = !!ce
    !!strSctnFitt.radio.val = 2
    !!strSctnFitt.radio.active = false

  else
    if (undefined(!!strFittSpec) or !!strFittSpec.specData.currentSelection.unset() or !!strFittSpec.specData.currentSelection.type neq 'SPCO' ) then
      !!messageFile.error(155, 014)
    endif
    !!strSctnFitt.radio.val = 1
    !!strSctnFitt.radio.active = true
  endif

  -- set up EDG
  !!edgCntrl.remove('Position Section Fitting')

  !packet = object EDGPACKET()
  !packet.defineWrapper('POSITION','!!strSctnFittConf()','Pick Position for Fitting')
  !packet.description = 'Position Section Fitting'

  !!edgCntrl.add(!packet)

  -- Build list of plines
  if (!mode eq 'NEW') then
    call !!strSctnFittPline(!!strFittSpec.owner)
    !owner = !!strFittSpec.owner
  else
    -- Find owning sections
    if (!!strSctnFitt.fitting.hardType eq 'FIXING' ) then
      !owner = !!strSctnFitt.fitting.owner.owner.owner
      if (!owner.hardType neq 'GENSEC') then
        !owner = !owner.owner
        if (!owner.hardType neq 'GENSEC') then
          !owner = !owner.owner
          if (!owner.hardType neq 'GENSEC') then
            !owner = !owner.owner
          endif
        endif
      endif
    elseif (!!strSctnFitt.fitting.hardType eq 'FITT' or !!strSctnFitt.fitting.hardType eq 'CMFI' ) then
          !owner = !!strSctnFitt.fitting.owner
    else
          !owner = !!strSctnFitt.fitting.owner.owner
    endif
    call !!strSctnFittPline(!owner)
  endif

  call !!enhanceItem(!owner, 'Salmon' )
  !!strSctnFitt.element.val = !owner.flnm

  if (!mode neq 'NEW') then
    if (!!strSctnFitt.fitting.type eq 'FIXING' and !!strSctnFitt.fitting.owner.type eq 'JLDATU' ) then
      !!strSctnFitt.just.select('DTEXT',!!strSctnFitt.fitting.owner.posl)
    elseif (!!strSctnFitt.fitting.type eq 'SBFI' ) then
      !!strSctnFitt.just.select('DTEXT',!!strSctnFitt.fitting.owner.posl)
    else
      !!strSctnFitt.just.select('DTEXT',!!strSctnFitt.fitting.posl)
    endif
  endif

endfunction
-- End of function definition for !!strSctnFittShow
