-- File:            strsctntogensec.pmlfnc
--   Type:          Function Definition
--   Group:         Common to all Structural Applications
--     Keyword:     SCTL
--   Module:        design
--   Replaces:
--
-- Author:          S.Hudson,,,
-- Created:         Fri Oct 24 17:42:23 1997
--
--
-- Description:
-- Convert a section type element to a gensec type element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Mode i.e. WALL or SCTN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strSctnToGensec(!mode is STRING)

  -- Check element is a SCTN
  if (!mode eq 'WALL' ) then
    if (!!ce.type ne 'STWALL') then
      STWALL
      handle any
        !!messageFile.error(155, 015)
      endhandle
    endif

  else
    if (!!ce.type ne 'SCTN') then
      SCTN
      handle any
        !!messageFile.error(155, 016)
      endhandle
    endif

  endif

  !message = 'Ok to convert '  & !!ce.flnm & ' into curved element'
  !answer = !!alert.confirm(!message)
  if (!answer ne 'YES') then
    return
  endif

  -- Save geometry
  !old = !!ce

  -- Save joints
  -- OLD SYNTAX FOR EFFICIENCY
  var !snodes COLLECT ALL SNODE FOR CE

  -- Save fittings
  -- OLD SYNTAX FOR EFFICIENCY
  var !fittings COLLECT ALL FITT FOR CE

  -- Save compound Fittings
  -- OLD SYNTAX FOR EFFICIENCY
  var !compound COLLECT ALL CMFI FOR CE

  -- Create new element
  if (!mode eq 'WALL' ) then
    NEW WALL
    !new = WALL
    NEW SPINE
  else
       NEW GENSEC
       !new = GENSEC
       NEW SPINE
  endif
  if (!!namOpt.auto() ) then
    !name =  !!namOpt.nameString(!new, ||, true, false)
    if (!name.unset().not()) then
      NAME /$!name
    endif
  endif

  NEW POINSP
  NEW POINSP POS E 1000

  -- Handle geometry
  !!ce = !new
  !string = !old.posStart.string()
  POSS $!string
  !string = !old.posEnd.string()
  POSE $!string
  !string = !old.joiStart.string()
  JOIS $!string
  handle any
  endhandle
  !string = !old.joiEnd.string()
  JOIE $!string
  handle any
  endhandle
  !string = !old.yDir.string()
  SPINE 1
  YDIR $!string
  END
  !string = !old.drnStart.string()
  DRNS $!string
  -- End direction appears to need to be reversed
  !string = !old.drnEnd.opposite().string()
  DRNE $!string
  !string = !old.spref.string()
  SPREF $!string
  handle any
  endhandle
  !string = !old.matRef.string()
  MATREF $!string
  handle any
  endhandle

  -- Copy everything else
  COPY LIKE $!old

  -- Handle joints
  -- For each node
  if (!snodes.size() gt 0) then
    do !index from 1 to !snodes.size()
      --   Create Node
      NEW JLDATU
      !string = !snodes[!index].dbRef().zDist.string()
      ZDIST $!string
      -- For each joint or compound joint
      !count = !snodes[!index].dbRef().mCount()
      if (!count gt 0) then
        do !joint from 1 to !count
          if (!snodes[!index].dbRef().members[!joint].type eq 'SJOI') then
            -- Secondary joint
            NEW PLDATU
            !string = !snodes[!index].dbRef().members[!joint].posLine
            POSL $!string
            NEW FIXING
            !string = !snodes[!index].dbRef().members[!joint].string()
            COPY LIKE $!string
            !string = !snodes[!index].dbRef().members[!joint].cref.string()
            CREF $!string
            handle any
            endhandle
            !string = !snodes[!index].dbRef().members[!joint].spref.string()
            SPREF $!string
            handle any
            endhandle

          elseif (!snodes[!index].dbRef().members[!joint].type eq 'SJOI') then
            -- Compound Joint
            NEW PLDATU
            !string = !snodes[!index].dbRef().members[!joint].posLine
            POSL $!string
            NEW FIXING
            !string = !snodes[!index].dbRef().members[!joint].string()
            COPY LIKE $!string
            !string = !snodes[!index].dbRef().members[!joint].spref.string()
            SPREF $!string
            handle any
            endhandle
            -- Sub Joint
            !subCount = !snodes[!index].dbRef().members[!joint].mCount
            if (!subCount gt 0) then
              do !subJoint from 1 to !subCount
                NEW FIXING
                !string = !snodes[!index].dbRef().members[!joint].members[!subJoint].string()
                COPY LIKE $!string
                !string = !snodes[!index].dbRef().members[!joint].members[!subJoint].cref.string()
                CREF $!string
                handle any
                endhandle
                !string = !snodes[!index].dbRef().members[!joint].members[!subJoint].spref.string()
                SPREF $!string
                handle any
                endhandle
                END
              enddo
            endif
          endif
        enddo
      endif
    enddo
  endif

  -- Handle fittings
  -- For each fitting
  if (!fittings.size() gt 0) then
       do !index from 1 to !fittings.size()
             NEW JLDATU
             !string = !fittings[!index].dbRef().zDist.string()
             ZDIST $!string
             NEW PLDATU
             !string = !fittings[!index].dbRef().posLine
             POSL $!string
             NEW FIXING
             !string = !fittings[!index].dbRef().string()
             COPY LIKE $!string
             !string = !fittings[!index].dbRef().cref.string()
             CREF $!string
             handle any
             endhandle
             !string = !fittings[!index].dbRef().spref.string()
             SPREF $!string
             handle any
             endhandle
       enddo
  endif

  -- For each Compound Fitting
  if (!compound.size() gt 0) then
    do !index from 1 to !compound.size()
      NEW JLDATU
      !string = !compound[!index].dbRef().zDist.string()
      ZDIST $!string
      NEW PLDATU
      !string = !compound[!index].dbRef().posLine
      POSL $!string
      NEW FIXING
      !string = !compound[!index].dbRef().string()
      COPY LIKE $!string
      !string = !compound[!index].dbRef().spref.string()
      SPREF $!string
      handle any
      endhandle
      !subCount = !compound[!index].dbRef().mCount
      if (!subCount gt 0) then
        do !subJoint from 1 to !subCount
          NEW FIXING
          !string = !compound[!index].dbRef().members[!subJoint].string()
          COPY LIKE $!string
          !string = !compound[!index].dbRef().members[!subJoint].cref.string()
          CREF $!string
          handle any
          endhandle
          !string = !compound[!index].dbRef().members[!subJoint].spref.string()
          SPREF $!string
          handle any
          endhandle
          END
        enddo
      endif
    enddo
  endif

  -- Delete existing
  !!ce = !old
  if (!mode eq 'WALL' ) then
    DELETE STWALL
  else
    DELETE SCTN
  endif
  !!ce = !new

endfunction
-- End of function definition for !!strSctnToGensec
