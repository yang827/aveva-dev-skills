-- Author:          N.Holmes
-- Created:         Wed Aug 26 08:46:22 BST 1998
--
--
-- Description:
-- Assigns default specification data to the passed section.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section to be updated
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if data has been assigned
--
------------------------------------------------------------------------

define function !!strSectionData(!section is DBREF) is BOOLEAN

  -- Check we have access to update the section
  if(!!dbRefUpdate(!section).not()) then
    !!alert.warning(!!error.text)
    return false
  endif

  -- Reference to OLD form
  if (!section.type eq 'WALL' or !section.type eq 'STWALL') then
    !specForm = !!cdWallSpecD
  else
    !specForm  = !!cdStlSpecD
  endif

  -- Initialise Variables
  !reference     = !!ce

  -- Get Specification
  !specString    = !specForm.spre.val

  -- If there is no spec Component defined, then don't do anything
  if(!specString.trim().empty()) then
    return true
  endif

  -- Get Spec component
  !specRef = !specString.dbRef()
  handle any
    return false
  endhandle


  -- Move to element
  !!ce       = !section

  -- Set Attributes
  -- Set gtype
  !gtype = object STRING()
  if (not !specRef.catref.badref() ) then
      !gtype = !specRef.catref.gtype
  elseif (not !specRef.tmpref.badref() ) then
      !gtype = !specRef.tmpref.gtype
  endif
  if (!gtype.set() ) then
      !section.gtype = !gtype
  else
      GTYPE unset
  endif
  -- Set Justification
  !justification = !specForm.just.val
  JUSLINE $!<justification>
  handle any
  endhandle

  -- Set Member Line
  !memberLine    = !specForm.meml.val
  MEMLINE $!<memberLine>
  handle any
  endhandle

  -- Set Joint Line
  !jointLine     = !specForm.jLin.val

  -- Set Section Joint Line
  if(!section.hardType eq'SCTN') then
    JLINE $!<jointLine>
    handle any
    endhandle

  -- Set Gensec Joint Lines
  elseif (!section.hardType eq'GENSEC') then
    JLNSTART $!<jointLine>
    handle any
    endhandle
    JLNEND $!<jointLine>
    handle any
    endhandle
  endif

   -- Set Attribute Definitions from default property set
   !specForm.defaultProp.setProperties(!section)

  -- Return
  !!ce       = !reference
  return true

endfunction
-- End of function definition for !!strSectionData
