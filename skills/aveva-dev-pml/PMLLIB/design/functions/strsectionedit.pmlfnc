-- Created:         Thu Aug 6 09:30:04 BST 1998
--
--
-- Description:
-- Display the appropriate section editing form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section to be edited
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!strSectionEdit(!passedDbRef is DBREF)

  -- Initialise Variables
  !validTypes = !!dtbSoftTypes.stringSTypesFor('GENSEC') + !!dtbSoftTypes.stringSTypesFor('SCTN') + ' GWALL '

  -- Get section from passed DBREF
  if(!passedDbRef.badref().not()) then
    !section = !!dtbGetOwnerType(!passedDbRef, !validTypes)
  else
    !section = object DBREF()
  endif

  -- Determine the Relevant editing form
  if(!section.unset()) then

    -- Define event packet to pick element
    !packet                = object EDGPACKET()
    !packet.elementPick('Pick Section to modify')
    !packet.action         = '!!cdpnRtn = !this.return[1].item'
    !packet.continue       = '!!strSectionEdit(!!cdpnRtn)'
    !packet.key            = 'Modify Section Definition'
    !packet.description    = 'Modify Section Definition'
    !packet.priority       = 1
    !packet.remove         = true
    !packet.type           = 'dbModify'

    -- Restricted Pick
    !packet.pickPacket.picks[1].pick.input[3]   = |match('| & !validTypes & |',TYPE) gt 0|
    !packet.pickPacket.picks[1].pick.modifiable = false

    -- Add to edg system
    !!alert.message('You must be at either a SCTN or GENSEC, pick one.')
    !!edgCntrl.add(!packet)
    return

  -- Element passed
  else

    -- Straight Section (SCTN)
    if(!section.hardType eq 'SCTN') then

      -- Load Section definition form
      if(undefined(!!strSectionEdit)) then
        pml load form !!strSectionEdit
      endif

      -- Show form
      !!strSectionEdit.edit(!section)

    -- Generic Section (GENSEC)
    elseif (!section.hardType eq 'GENSEC') then

      -- Check if it a "ring"
      if(!section.function.upcase() eq 'RING') then

        -- Load Ring Section definition form
        if(undefined(!!strRingEdit)) then
          pml load form !!strRingEdit
        endif

        !!strRingEdit.edit(!section)

      -- Handle Gensec not created as ring sections
      else

        -- Load Curve Section definition form
        if(undefined(!!strSpineEdit)) then
          pml load form !!strSpineEdit
        endif

        !!strSpineEdit.edit(!section)
      endif

    -- Generic Wall (PANEL)
    elseif(!section.type.eq('GWALL')) then

      -- Load Section definition form
      if(undefined(!!dbeLoopEdit)) then
        pml load form !!dbeLoopEdit
      endif

      -- Show form
      !!dbeLoopEdit.edit(!section)

    -- Return an error
    --else
    --!!alert.message('You must be at either a SCTN or GENSEC, navigate to one before using this utility.')
    endif

  endif

endfunction
-- End of function definition for !!strSectionEdit
