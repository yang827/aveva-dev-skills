-- Author:          N.Holmes
-- Created:         Wed Aug 26 08:46:22 BST 1998
--
--
-- Description:
-- Assigns passed specification to the passed element.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to have its specref updated
--    2   R      DBREF       Specification to be assigned to item
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if data has been assigned
--
------------------------------------------------------------------------

define function !!strSpecRef(!element is DBREF, !specReference is DBREF) is BOOLEAN

  -- Check element has a "Specref"
  if(!element.attributes().findFirst('Spref').unset()) then
    !!messageFile.warning(153, 15, !element.flnn)
    return false
  endif

  -- Check specReference passed is a SPCO
  if(!specReference.set()) then
    if(!specReference.hardType ne 'SPCO') then
      !!messageFile.warning(153, 16, !specReference.flnn)
      return false
    endif
  endif

  -- Check we have access to update the section
  if(!!dbRefUpdate(!element).not()) then
    !!alert.warning(!!error.text)
    return false
  endif

  -- Initialise Variables
  !reference = !!ce

  -- Assign Specification Reference
  !!ce       = !element

  -- Get current Data
  !currentSpecRef = !element.spref

  -- If current specref and passed are the same, return
  if(!currentSpecRef eq !specReference) then
    !!ce     = !reference
    return false
  endif

  -- Determine previous spec Reference type (catalogue or template)
  if(!currentSpecRef.set()) then

    -- Catalogue defined
    if(!currentSpecRef.tmpRef.set()) then

      -- If previous spec Reference was a template, remove it the template pointing at the same one
      !index = 1

      -- Loop through elements members
      do

        !template = !!dtbMemberOfType(!element, 'TMPL', !index)

        -- Is there a template
        if(!template.set()) then

          -- Check if template is same as old spec references template, remove it if it is
          if(!currentSpecRef.tmpRef eq !template.orrf) then
            !!ce = !template
            UNLOCK ALL
            DELETE TMPL
            handle ANY
              !!alert.warning('Template not deleted - ' & !!error.text)
              handle ANY
                -- Just in case the concatenated text is too long
                !!alert.warning(!!error.text)
              endhandle
            endhandle
            break
          endif
          !index = !index + 1
        else
          break
        endif

      enddo
    endif
  endif

  -- If specref is unset, then unset gtype and return (we may need to consider
  -- what we do if the current spec ref was a template, do we remove the template?)
  if(!specReference.unset()) then

    -- Unset SpecRef and Gtype
    SPREF NULREF
    handle any
    endhandle
    GTYPE UNSET
    handle any
    endhandle
    !!ce     = !reference
    return true

  -- Set New Spec Reference
  else

    SPREF $!<specReference>
    handle any
      !!ce     = !reference
      return false
    endhandle
  endif

  -- Catalogue Definitions
  if(!specReference.catRef.set()) then

    -- Set Gtype
    !gType = !specReference.catRef.gType
    GTYPE  $!<gType>
    handle any
    endhandle

  -- Design Template Definitions
  elseif (!specReference.tmpRef.set()) then

    -- Set Gtype
    !gType = !specReference.tmpRef.gType
    GTYPE  $!<gType>
    handle any
    endhandle

    -- Create template
    NEW TMPL
    COPY REXEC $!<specReference.tmpRef>
    handle any
    endhandle

  -- Unknown definitions
  else
    !!alert.warning('Specification component "' & !specReference.flnn & '" does not reference a catalogue/template definition.')
    return false
  endif

  -- Return
  !!ce       = !reference
  return true

endfunction
-- End of function definition for !!strSpecRef
