--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strSpineRadShow()

!message = object STRING()
!spine = !!findFirstMember(!!sctlSpine.spine, 'SPINE', '', !message)
!spineVertices = !spine.members
-- Check that a curve is sensible here

-- First vertex must be POINSP not CURVE
if (!spine.mCount eq 0) then
   !!messageFile.error(155, 010)
   return
endif

-- Check if current element is curve
if (!!sctlSpine.radio.val eq 2 and !!sctlSpine.current.type ne 'CURVE') then
      return
else
-- Check valid to create curve here

    if (!!sctlSpine.number ge !spine.mCount) then
        !!messageFile.error(155, 012)
        return
    elseif (!spineVertices[!!sctlSpine.number + 1].type eq 'CURVE' ) then
        !!messageFile.error(155, 011)
        return
    endif
endif

-- Hide other of forms
if (defined(!!strCurveCent) and !!strCurveCent.shown() ) then
     !!strCurveCent.hide()
     !!strCurveCentDism()
endif
if (defined(!!strSpineFill) and !!strSpineFill.shown() ) then
     !!strSpineFill.hide()
     !!strSpineFill.dismiss()
endif
if (defined(!!strSpineThru) and !!strSpineThru.shown() ) then
     !!strSpineThru.hide()
     !!strSpineThru.dismiss()
endif

-- Show Form

show !!strSpineRad

-- if editing curve
if (!!sctlSpine.radio.val eq 2) then

-- Calculate existing centre position
    !!strSpineRad.control = !!sctlSpine.current.pPos[7]
    !!strSpineRad.radius = !!sctlSpine.current.radius
    !!strSpineRad.value.val = !!strSpineRad.radius

-- set up EDG

    !!strSpineRad.pick('START')

else

    !!strSpineRad.control = object POSITION()
    !!strSpineRad.radius = REAL()
    !!strSpineRad.value.val = 0

 -- set up EDG

    !!strSpineRad.pick('CONTROL')


endif

!!strSpineRad.accept.active = False

endfunction
-- End of function definition for !!strSpineRadShow
