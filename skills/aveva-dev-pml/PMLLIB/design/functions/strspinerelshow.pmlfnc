-- Define function
define function !!strSpineRelShow()

-- Check that there is at least one vertex

!refe = !!ce
!!ce = !!sctlSpine.spine
SPINE 1
!spine = !!ce
!!ce = !refe
if (!spine.mCount lt 1) then
    return
endif

-- Hide other of forms
if (defined(!!strCurveCent) and !!strCurveCent.shown() ) then
     !!strCurveCent.hide()
     !!strCurveCentDism()
endif
if (defined(!!strSpineFill) and !!strSpineFill.shown() ) then
     !!strSpineFill.hide()
     !!strSpineFill.dismiss()
endif
if (defined(!!strSpineThru) and !!strSpineThru.shown() ) then
     !!strSpineThru.hide()
     !!strSpineThru.dismiss()
endif
if (defined(!!strSpineRad) and !!strSpineRad.shown() ) then
     !!strSpineRad.hide()
     !!strSpineRad.dismiss()
endif

-- Show Form

show !!strSpineRel

!!strSpineRel.setup()

-- set up EDG

!!strSpineRel.pickDirection()

endfunction
-- End of function definition for !!strSpineRelShow
