--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strSpineThruShow()

!message = object STRING()
!spine = !!findFirstMember(!!sctlSpine.spine, 'SPINE', '', !message)
!spineVertices = !spine.members
-- Check that a curve is sensible here

-- First vertex must be POINSP not CURVE
if (!spine.mCount eq 0) then
   !!messageFile.error(155, 010)
   return
endif

-- Check if current element is curve
if (!!sctlSpine.radio.val eq 2 and !!sctlSpine.current.type ne 'CURVE') then
      return
else
-- Check valid to create curve here

    if (!!sctlSpine.number ge !spine.mCount) then
        !!messageFile.error(155, 012)
        return
    elseif (!spineVertices[!!sctlSpine.number + 1].type eq 'CURVE' ) then
        !!messageFile.error(155, 011)
        return
    endif
endif

-- Hide other of forms
if (defined(!!strCurveCent) and !!strCurveCent.shown() ) then
     !!strCurveCent.hide()
     !!strCurveCentDism()
endif
if (defined(!!strSpineRad) and !!strSpineRad.shown() ) then
     !!strSpineRad.hide()
     !!strSpineRad.dismiss()
endif
if (defined(!!strSpineFill) and !!strSpineFill.shown() ) then
     !!strSpineFill.hide()
     !!strSpineFill.dismiss()
endif

-- Show Form

show !!strSpineThru

-- if editing curve
if (!!sctlSpine.radio.val eq 2) then

-- Calculate existing centre position
    !!strSpineThru.control = !!sctlSpine.current.pPos[7]

else

    !!strSpineThru.control = object POSITION()

endif

!!strSpineThru.accept.active = False

-- set up EDG

 !!strSpineThru.pick()

endfunction
-- End of function definition for !!strSpineThruShow
