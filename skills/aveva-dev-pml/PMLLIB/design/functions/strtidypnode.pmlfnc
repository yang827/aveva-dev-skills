-- Author:          S.Hudson,,,
-- Created:         Fri Apr 3 15:39:40 GMT 1998
--
--
-- Description:
-- Delete all PJOI's and FIXINGS belonging to given PNODE
-- except those connected to the specified ends
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Pnode
--    2   R      dbref       First SCTN
--    3   R      String      End of first SCTN
--    4   R      dbref       Second SCTN
--    5   R      String      End of second SCTN

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strTidyPnode(!pnode is DBREF, !element1 is DBREF, !end1 is STRING, !element2 is DBREF, !end2 is STRING)

if (!end1.upcase() eq 'START' ) then
    !jointOne = !element1.joiS
else
    !jointOne = !element1.joiE
endif
if (!end2.upcase() eq 'START' ) then
    !jointTwo = !element2.joiS
else
    !jointTwo = !element2.joiE
endif

do !joint values !pnode.members

    if (!joint ne !jointOne and !joint ne !jointTwo) then
        if ( !joint.type eq 'PJOI' or !joint.type eq 'PCOJ' or !joint.type eq 'FIXING' ) then
             !type = !joint.type
             !!ce = !joint
             DELETE $!type
        endif
     endif

enddo

endfunction
-- End of function definition for !!strTidyPnode
