--
--
-- Description:
-- Calculate zdist along GENSEC of given position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Element (hard type of GENSEC)
--    3   R      position    Position not necessarily on pline
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!strZDistOfPos(!element is DBREF, !position is POSITION, !segment is DBREF ) is REAL

if (!element.hardType ne |GENSEC| ) then
      !!messageFile.error(155, 001)
endif
!refe = !!ce

!!ce = !element

!posString = !position.string()
var !segStr PPLINE NA SEGMENT THROUGH $!posString VIA SPINE UNBOUND

!segment = !segStr.dbRef()

var !returnString PPLINE NA PLDIST THROUGH $!posString VIA SPINE UNBOUND OF $!segStr

!!ce = !refe
return  !returnString.real()


endfunction
-- End of function definition for !!strZDistOfPos
