-- Created:         Tue Oct 21 16:04:17 1997
--
--
-- Description:
-- Create a panel fitting on the given panel in the given direction from the given point
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
--    2   R      POSITION    Position
--    3   R      DIRECTION   Direction
--    4   RW     VECTOR      Plane
-- Return:
--   [Data Type] [Description]
--   DBREF        Panel Fitting
--
------------------------------------------------------------------------

-- Define function
define function !!supPanelAttach(!panel is DBREF, !pos is POSITION, !dir is DIRECTION, !plane is VECTOR) is DBREF

-- Remember where we are
!refe = !!ce
!ploo = object DBREF()

-- Construct planes for each side of panel
!planeOne = !!consPlanePanel(!panel, 1, !ploo)

!planeThree = !!consPlanePanel(!panel, 3, !ploo)

-- Construct line from position and direction
!line = object VECTOR()
!line.position = !pos
!line.direction = !dir

-- Find intersections
!posOne = !!consPosPlaneLine(!line, !planeOne)
!posThree = !!consPosPlaneLine(!line, !planeThree)

-- Find nearest intersection
!distOne = !posOne.distance( !pos)
!distThree = !posThree.distance( !pos)

if (!distOne gt !distThree) then
    !just = 'DBOT'
    !posString = !posThree.wrt(!panel).string()
    !plane = !planeThree
else
    !just = 'UTOP'
    !posString = !posOne.wrt(!panel).string()
    !plane = !planeOne
endif

-- Create fitting
!!ce = !panel
NEW PFIT
SJUST $!just
POS $!posString
!panelFitting = !!ce

!!ce = !refe

return !panelFitting

endfunction
-- End of function definition for !!supPanelAttach
