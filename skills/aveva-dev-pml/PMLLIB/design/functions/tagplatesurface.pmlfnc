-- Created:         Thu Feb 27 10:37:34 GMT 1997
--
--
-- Description:
-- Tag the passed panels surface (at centroid)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel to be tagged
--    2   R      STRING      Surface to be tagged
--    3   R      REAL        Tag number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!tagPlateSurface (!panel is DBREF, !surface is STRING, !tagNumber is REAL)

  -- If a unset DBREF is passed, then untag the item
  if(!panel.unset()) then
    call !!clearAid('ARROW',!tagNumber)
    return
  endif

  -- Initialise Variables
  if(!surface.upcase().subString(1,1) eq 'T') then
    !direction = object DIRECTION('U')
  else
    !direction = object DIRECTION('D')
  endif
  !direction.origin = !panel

  -- Get Volume of Panel
  !volume          = !!localVolume(!panel, !panel)

  !position        = object POSITION()
  !position.east   = (!volume.from.east  + !volume.to.east)  / 2
  !position.north  = (!volume.from.north + !volume.to.north) / 2

  if(!direction.up eq 1) then
    !position.up     = !volume.to.up
  else
    !position.up     = !volume.from.up
  endif

  !position.origin = !volume.from.origin

  -- Draw Arrow
  call !!drawArrow(!direction, !position, !tagNumber, 500)

endfunction
-- End of function definition for !!tagPlateSurface
