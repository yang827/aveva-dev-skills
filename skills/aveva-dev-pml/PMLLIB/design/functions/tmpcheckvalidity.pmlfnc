--
-- File:            tmpcheckvalidity.pmlfnc
--   Type:          Function Definition
--   Group:         TMP
--     Keyword:     TEMPLATE
--   Module:        DESIGN
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Thu 16th Jan 14:00 GMT 2003
--
--
-- Description:
-- Function to check a tmpl is valid in terms of catalogue references
-- Note this function could become the main area for potential tmpl checks
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [PDMS TMPL dbRef]
--   [2] [R/W]  [DBREF]     [PDMS Element that is at fault]
-- Return:
--   [Data Type] [Description]
--   [BOOLEAN]   [True if tmpl is valid]
--
------------------------------------------------------------------------
-- Define function
define function !!tmpCheckValidity(!dbRef is DBREF, !element is DBREF) is BOOLEAN

var !references coll all NOZZ for $!dbRef
var !references append coll all (SCTN GENSEC) with spre eq nulref or spre neq nulref for $!dbRef

do !i values !references
-- test is different for a nozzle (SPREF is still CATR!!)
   if(!i.dbRef().type.eq('NOZZ')) then
      !attr = 'catref'
   else
      !attr = 'spref'
   endif
-- check the catref/spref is set
   if(!i.dbRef().attribute(!attr).badref().not()) then
     if(!i.dbRef().attribute(!attr).catref.badref()) then
      !element = !i.dbRef()
      return FALSE
     else
      skip
     endif
   else
    !element = !i.dbRef()
    return FALSE
   endif
enddo

return TRUE

endfunction
-- End of function definition for !!tmpCheckValidity(!dbRef)
