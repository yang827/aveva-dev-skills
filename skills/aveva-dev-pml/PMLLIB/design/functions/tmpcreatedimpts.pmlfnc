--
--
-- Description:
--
-- Function to create Design Points based on the desp parameters available
-- Will put into a form when I get chance.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!tmpCreateDimPts(!tmpl is DBREF)

  -- Save original Position

  !refe     = !!ce
  !template = !tmpl
  -- best create a new dpse when the old tmpl app can cater for more than one DPSE

  !!ce    = !template

-- create a DPSE if there isn't one
  !pntSet = DPSE 1 OF $!template
  handle any
    !!ce = !template
    NEW DPSE
    !pntSet = !!ce
  endhandle



  var !desPars COLLECT ALL DDAT WITH PURP EQ 'DESP' FOR $!template
  var !number EVALUATE NUMB FOR ALL FROM !desPars
  var !title  EVALUATE DTIT FOR ALL FROM !desPars

  -- create the points required.

  !!ce = !pntSet
  do !i indices !desPars

    NEW DPSP PVIF 3 PURP DIM FUNC '$!number[$!i]' NUMB $!number[$!i]01 DESC '$!title[$!i] Dimension Point'
    NEW DPSP PVIF 3 PURP DIM FUNC '$!number[$!i]' NUMB $!number[$!i]02 DESC '$!title[$!i] Dimension Point'

  enddo


  -- Go Back to Original Position
  !!ce = !refe

endfunction
-- End of function definition for !!tmpCreateDimPts
