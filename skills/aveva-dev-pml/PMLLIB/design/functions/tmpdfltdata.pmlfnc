-- Author:          A.Kirkland
-- Created:         Fri Aug 29 12:13:34 BST 1997
--
--
-- Description:
-- Display  dflt dataset records to relevant form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Gadget]    [Gadget to write the dataset records in]
--   [2] [R]    [Boolean]   [Flag for header setting]
--   [3] [R]    [String]    [Header Title]
--   [4] [R]    [Array]     [Dataset to extract data from]
--   [5] [R]    [Array]     [Descriptions of Dataset]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!tmpDfltData(!gadgetList is GADGET, !flag is BOOLEAN,!dummyHeaderName is STRING, !datasets is ARRAY, !datasetDescs is ARRAY)

-- Initialise Variables

   !load  = ARRAY()

do !ind indices !datasets

-- display top line of each DDSE with DDSE description
   !load.append(| |)
   !load.append(!datasetDescs[$!ind])
   !load.append(|-----------------------------------------------------------|)
   !ddse = !datasets[$!ind].dbRef()

-- Load Parameter information

  !mess        = object STRING()
  !dataset     = object DBREF()
  !dataRecords = object ARRAY()

  !status = !!dtsExtract(!ddse,!mess,!dataset,!dataRecords)

  skip if(not !status)


-- **** OLD STYLE PML ****

-- Get Data records from passed dataset

   var !dKey EVALUATE (DKEY) FOR ALL FROM !dataRecords IGNORE ANY
   var !dtit EVALUATE (DTIT) FOR ALL FROM !dataRecords IGNORE ANY
   -- var !ptyp EVALUATE (PTYP) FOR ALL FROM !dataRecords IGNORE ANY
   var !purp EVALUATE (PURP) FOR ALL FROM !dataRecords IGNORE ANY
   var !numb EVALUATE (NUMB) FOR ALL FROM !dataRecords IGNORE ANY
   -- var !ddpr EVALUATE (DESC) FOR ALL FROM !dataRecords IGNORE ANY
   var !temp EVALUATE (DDDF) FOR ALL FROM !dataRecords IGNORE ANY
   var !dddf EVALUATE (TRIM(TRIM(TRIM(VTEXT(!temp,VVAL(!en)),'L',|(|),|R|,|)|))) INDICES !temp COUNT !en

--  Display Information

    !dsiz = (max(!dtit.width(),12))
    !xsiz = (max(!dddf.width(),10))


-- Header


 if(!flag) then

   var !dprt COMPOSE SPACE 1 |Type| WIDTH 10 C SPACE 2 |Key| WIDTH 4 SPACE 2 |Description| WIDTH $!dsiz C SPACE 2 |Default| WIDTH $!xsiz C

-- Compose Header for Ddat list

     !!tmpDfltLoad.dDarTitle.val = !dprt[1]


 endif


-- Sort **** OLD STYLE PML ****
   var !order SORT !purp !numb

-- Compile first column (the type of ddat)
-- if it is a desp then show the desp number [n]

 do !i values !order
  -- Set Type info
   if(!numb[!i.real()].real() neq 0) then
      !pdat = !purp[!i.real()] & '[' & !numb[!i.real()] & ']'
   else
      !pdat = !purp[!i.real()]
   endif

-- **** OLD STYLE PML ****

   var !dprt COMPOSE SPACE 1 |$!pdat| WIDTH 10 L SPACE 2 |$!dKey[$!i]| WIDTH 4 SPACE 2 |$!dtit[$!i]| WIDTH $!dsiz SPACE 2 |$!dddf[$!i]| WIDTH $!xsiz C

-- load the array with the data from each data record
   !load.appendArray(!dprt)

-- and load the form list gadget
   !gadgetList.dText = !load


 enddo

enddo


endfunction
-- End of function definition for !!tmpDfltData
