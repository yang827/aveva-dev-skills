--
-- Description:
-- Function to perform method  of the form TmpDfltLoad
--
-- Method [TmpDfltInit] for form [TmpDfltLoad]
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!tmpDfltInit()

-- get data set area for current mdb

-- ***** OLD STYLE PML *****
   var !tpwl COLLECT ALL TPWL WITH FUNC EQ 'ASL'
   do !tpwls values !tpwl
    var !ddar APPEND COLLECT MEMB OF $!tpwls WITH TYPE EQ 'DDAR'
   enddo


-- only one a the moment

   !area = !ddar[1].dbRef()
    handle any
     return error 1 |No DataSet Area available.|
    endhandle
-- ***** OLD STYLE PML *****
   var !datasets COLLECT ALL DDSE FOR $!area
   var !datasetDescs EVALUATE DESC FOR ALL FROM !datasets

-- Empty List (not sure this is necessary)
   !dText[1] = ||
   !rText[1] = ||

   !!tmpDfltLoad.dDatList.dText = !dText
   !!tmpDfltLoad.dDatList.rText = !rText


-- Write Data

   !desc = !area.desc

-- ************OLD SYNTAX *************
   var !dprt COMPOSE |Defaults:| SPACE 1 |$!desc| WIDTH 30
---------------------------------------

   if(defined(!dprt[1])) then
     !!tmpDfltLoad.dDarName1.val = !dprt[1]
   endif
   if(defined(!dprt[2])) then
     !!tmpDfltLoad.dDarName2.val = !dprt[2]
   else
     !!tmpDfltLoad.dDarName2.val = ||
   endif

-- Display Parameter Information

 call !!tmpDfltData(!!tmpDfltLoad.dDatList, true, !!tmpDfltLoad.dDarTitle.val, !datasets, !datasetDescs )


endfunction
-- End of function definition for !!tmpDfltInit
