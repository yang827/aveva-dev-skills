--
-- Author:          A.Kirkland
-- Created:         Wed Oct 29 08:43:05 GMT 1997
--
--
-- Description:
-- Function to export rules to the tmpl
-- if setting the rules in the design area.
-- Will only do this if the orrf is set.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!tmpExportRules(!dbRef is DBREF)

  -- Save original Position

  !refe = !!ce

  -- Get rules from the passed dbref
  !testFunc =   !dbRef.func.upcase().eq('MASTER REPEAT') or !dbRef.func.upcase().eq('REPEAT')
      handle ANY
     !testFunc = false
     -- in case func attribute doesn't exist
      endhandle

  if(!testFunc) then
      !!alert.error('Can''t export master repeat rule')
      return
  endif

      !rules = !!datalRules(!dbRef, '')

  -- get invalid values out of the way

  if(!rules.unset()) then
    -- do nothing 'cos there is't any rules to export
    return
  endif


    -- loop thro the rules and set on the orrf
    do !ind indices !rules
    -- goto the element with a rule

       if(!rules[!ind].part(1).neq('Rule')) then
          !!ce = !rules[!ind].dbRef()
          handle ANY
            !string = '/' & !rules[!ind]
            !!ce = !string.dbRef()
          endhandle
          !savCe = !!ce
       else
           -- orrf is valid so export rules
              !!ce = !savCe.orrf
              handle ANY
                -- in case orrf is nulref
                skip
              endhandle
              skip if(!testFunc)
              handle ANY
                -- in case func not an attribute
              endhandle

        -- set the rule
           $!rules[$!ind]
           handle ANY
             -- no rule
           endhandle
       endif
    enddo



  -- Go Back to Original Position
  !!ce = !refe

endfunction
-- End of function definition for !!tmpExportRules
