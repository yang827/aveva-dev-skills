-- File:            tmpexpressionchk.pmlfnc
--   Type:          Function Definition
--   Group:         Template Application

--     Keyword:     TMPL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Oct 11 14:13:08 BST 2000
--
--
-- Description:
-- function to check a valid expression for tmpl rules
-- Uses the new !!error member .command to alert an invalid rule expression
--
-- This function could be tidied up when we have more time
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [PDMS Element (primitive) to test the expression on]
--   [2] [R]    [STRING]    [Expression to test]
--   [3] [R]    [STRING]    [Key word to express the type of rule to be set (POSITION etc).]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tmpexpressionchk(!element is DBREF, !expression is STRING, !expressionType is STRING)

-- don't check if the string is empty

   if(!expression.trim().empty()) then
        return true
   endif

-- Initialise Variables

  !ref   = !!ce
  !!ce   = !element
  handle ANY
   return
  endhandle
-- Rule setting on the parameterisation form for POSITIONING CARTESIAN

  if(!expressionType.upcase().eq('CARTESIAN')) then
    if(!element.hardtype.eq('SCTN')) then
       !pos = 'POSS'
    else
       !pos = 'POS'
    endif
    RULE SET $!pos ( X ($!expression ) )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('X').substring(-2)
      return error 1 '$!reason

$!message'
    endhandle

-- Rule setting on the parameterisation form for POSITIONING EXPLICIT

  elseif(!expressionType.upcase().eq('EXPLICIT')) then
    RULE SET POS ($!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET POS')
      return error 1 '$!reason

$!message'
    endhandle

-- Orientation

  elseif(!expressionType.upcase().eq('ORI')) then
    RULE SET ORI( N IS  $!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET ORI')
      return error 1 '$!reason

$!message'
    endhandle
-- Orientation

  elseif(!expressionType.upcase().eq('REAL')) then
    !attribute = !!cdtmppdef.rule.selection().part(1,'\').upcase().substring(1,4)
    RULE SET $!attribute ( $!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET $!attribute')
      return error 1 '$!reason

$!message'
    endhandle

-- Direction

  elseif(!expressionType.upcase().eq('DIR')) then
    !attribute = !!cdtmppdef.rule.selection().part(1,'\').upcase().substring(1,4)
    RULE SET $!attribute ( $!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET $!attribute')
      return error 1 '$!reason

$!message'
    endhandle

-- DDirection

  elseif(!expressionType.upcase().eq('DDIR')) then
    !attribute = 'DDIR'
   RULE SET $!attribute ( $!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET $!attribute')
      return error 1 '$!reason

$!message'
    endhandle

-- Radi

  elseif(!expressionType.upcase().eq('RADI')) then
    !attribute = 'RADI'
   RULE SET $!attribute ( $!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET $!attribute')
      return error 1 '$!reason

$!message'
    endhandle



-- SPREF/CATREF

  elseif(!expressionType.upcase().eq('SPRE')) then
    !attribute = !!cdtmppdef.rule.selection().part(1,'\').upcase().substring(1,4)
    RULE SET $!attribute ( $!expression )
    handle ANY
      !reason = !!error.text
      !message =  !!error.command.after('RULE SET $!attribute')
      return error 1 '$!reason

$!message'
    endhandle

-- If a check is not required (gadget already has a callback)

  elseif(!expressionType.upcase().eq('NOCHECK')) then
  -- don't do anything
  return true
  endif

  !!ce = !ref
  return true

endfunction
-- End of function definition
