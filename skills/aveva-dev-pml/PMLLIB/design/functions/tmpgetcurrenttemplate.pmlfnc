--
-- Description:
-- Get current Design Template definition from the Design Template browser
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   DBREF        Current Template definition DBREF, or unset if none
--
------------------------------------------------------------------------

define function !!tmpGetCurrentTemplate() is DBREF

-- Initialise Variables
-- get TMPL from browser (**** OLD STYLE  PML ****)
  !template = $_cdTmpMemb_memb
  handle any
    !template = object DBREF()
    return !template
  endhandle
  if(!template.hardtype.neq('TMPL')) then
     !template = object DBREF()
  endif
  return !template

endfunction
-- End of function definition
