--
-- Author:          malcolm.barlow
-- Created:         May 25 2007
--
-- Description:
-- Copy elements from !original to a TMPL element
-- This logic is a modified version of the original logic in PML 1
-- macro ITMPTMP and MTMPTMP
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element selected for TMPL copy
-- Return:
--   [Data Type] [Description]
--    DBREF       New TMPL element, or unset if not a valid copy
--
------------------------------------------------------------------------

define function !!tmplCopyFrom( !original is DBREF, !tmplOwner is DBREF ) is DBREF

  !templateObject = object TMPLTOOLS()
  !template       = !templateObject.copyFrom(!original, !tmplOwner, false, false)
  return !template

endfunction
-- End of function definition
