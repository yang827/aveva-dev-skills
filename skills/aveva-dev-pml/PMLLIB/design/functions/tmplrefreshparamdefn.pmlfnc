--
-- Description:
-- Update Design Template parameterisation form if shown
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tmplRefreshParamDefn()

-- Initialise Variables
  if(not defined(!!tmplParamDefn)) then
    return
  endif

  if( !!tmplParamDefn.shown() ) then
    -- initialise form for the current template
    !!tmplParamDefn.initialise()
  endif

endfunction
-- End of function definition
