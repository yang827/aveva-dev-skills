--
-- Description:
-- Display and initialise Design Template parameterisation form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tmplShowParamDefn()

-- Initialise Variables
  if(not defined(!!tmplParamDefn)) then
    pml reload form !!tmplParamDefn
  endif

  -- get current template name
  !temp = !!tmpGetCurrentTemplate()
  -- check for good reference
  if( badref(!temp) ) then
    return error 1 'Bad Design Template Reference'
  endif

  if( !!tmplParamDefn.shown() ) then
    -- initialise form for the current template
    !!tmplParamDefn.initialise(!temp)
  else
    -- Form not shown - it will initialise itself
    show !!tmplParamDefn
  endif

endfunction
-- End of function definition
