--
-- Description:
-- Display and initialise Design Template propagation form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tmplShowPropagate()

-- Initialise Variables
  if(not defined(!!tmplPropagate)) then
    pml reload form !!tmplPropagate
  endif

  if( !!tmplPropagate.shown() ) then

    -- form already shown - choose new element
    -- get current template name
    !temp = !!tmpGetCurrentTemplate()
    if(badref(!temp)) then
      !temp = !!ce
    endif

    -- initialise form for the current template
    !!tmplPropagate.initialise(!temp)

  else

    -- Form not shown - it will initialise itself
    show !!tmplPropagate

  endif

endfunction
-- End of function definition
