--
-- Author:          malcolm.barlow
-- Created:         May 25 2007
--
-- Description:
-- Validate element !original to see if a TMPL copy can be created
-- from this element
-- The actual element used as the base element for the copy
-- This logic is a modified version of the original logic in PML 1
-- macro ITMPTMP
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element selected for TMPL copy
-- Return:
--   [Data Type] [Description]
--    DBREF       Element that will be copied, or unset if not a valid copy
--
------------------------------------------------------------------------

define function !!tmplValidateCopy( !original is DBREF ) is DBREF

  !templateObject   = object TMPLTOOLS()
  !tmplOwnerElement = !templateObject.validateCopy(!original, true)
  return !tmplOwnerElement

endfunction
-- End of function definition
