-- File:            tmpunlinkfromoriginal.pmlfnc
--   Type:          Function Definition
--   Group:         Templates
--     Keyword:     UNLINK
--   Module:        DESIGN
--   Replaces:      MUNTIE
--
-- Author:          A.Kirkland
-- Created:         Thu Oct 31 14:00 GMT 2002
--
--
-- Description:
-- Function unlink a template or number of templates from the original
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Element to unlink from original]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!tmpUnlinkFromOriginal(!dbRef is DBREF)
-- Initialise Variables
   !ref = !!ce

-- Don't do anything if the user is above at an element that can't own a template
   !element = !!dtbOwnerOfType(!dbRef, 'TMPL')
   if(!element.unset()) then
      return error 1 'Only templates and their offspring can be unlinked.'
   endif

-- collect all the templates below the element to untie
   var !templates COLL ALL TMPL FOR $!element

-- There are no templates below, but see if there is one above
   if(!templates.empty()) then
      !element = !!dtbOwnerOfType(!element.owner, 'TMPL')
      if(!element.unset()) then
        !!ce = !ref
        return error 1 'No templates to unlink from the original.'
      endif
   -- having found another element, see if there are any templates to untie
   var !templates COLL ALL TMPL FOR $!element
   endif


   if(!templates.empty()) then
      return error 1 'No templates to unlink from the original.'
   else
-- Confirm
     !confirm = !!alert.confirm('OK to unlink and unlock element $!element.name ?')
     if(!confirm.eq('NO')) then
       return
     endif

-- loop through the collection of templates and untie each one.
     do !i values !templates
       -- I would like to do this without navigating, but PDMS won't let me
       !!ce = !i.dbRef()
       UNLOCK ALL
       UNTIE $!i
       handle ANY
       -- if the template is locked
          !!ce = !ref
          return error 1 '$!!error.text'
       endhandle
     enddo

   -- unset the spref
     !!ce = !element
     SPREF NULREF
   endif

-- navigate to the element unlinked
   !!ce = !element

endfunction
-- End of function definition for !!tmpUnlinkFromOriginal(!element)
