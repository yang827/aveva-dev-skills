--   Group:         Template Application

--     Keyword:     TMPL
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Oct 28 9:20:49 "GMT 1998
--
--
-- Description:
-- function to update all instances of the passed tmpl from a given level
-- end.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Template instance]
--   [2] [R]    [DBREF]     [Level to search from]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tmpUpdtInstances(!instance is DBREF, !levelSearch is DBREF)

  !refe = !!ce

  var !tmpls COLLECT ALL TMPL WITH ORRF EQ $!instance FOR $!levelSearch

  do !index values !tmpls
    !!ce = !index.dbRef()
    UNLOCK ALL
    DELETE TMPL
    NEW TMPL COPY REXE $!instance

  enddo

  !!ce = !refe
  handle any
    -- just in case  originally at the deleted tmpl
  endhandle

endfunction
-- End of function definition for !!tmpUpdtInstances
