-- Author:          Jaideep (DDC - Chennai)
-- Created:
--
--
--
-- Description:
--    Trims the passed section to the best possible pline of another section
--
----------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!trimToPline(!toTrim is DBREF,!trimOn is DBREF,!end is STRING) is ARRAY

   !retArray  =  ARRAY()
   -- Cannot handle types other than SCTN
   if(!toTrim.hardType ne |SCTN| OR !trimOn.hardType ne |SCTN| ) then
      !!alert.error('Item to trim and item to trim on should be of type SCTN')
      return
   endif

   -- Create a line from the section to trim
   if(!end.lowcase() eq 'end')then
      !line     =  object LINE(!toTrim.poss,!toTrim.pose)
   elseif(!end.lowcase() eq 'start')then
      !line     =  object LINE(!toTrim.pose,!toTrim.poss)
   endif

   -- Define an arbitrary check length
   !length  =  100000mm

   -- Collect all the valid plines of the trim-on section and their zdir
   !collectPlines  =  object COLLECTION()
   !collectPlines.scope(PSTR OF CATR OF $!trimOn)
   !collectPlines.type('plin')

   -- See if any rule is defined in the pline filter form
   if(defined(!!edgPlineFilter))then
      !rule    =  !!edgPlineFilter.rule()

      if(!rule.set() AND !rule ne '')then
         !expr    =  object EXPRESSION(!rule)
         !collectPlines.filter(!expr)
      endif
   endif

   !plines   =  !collectPlines.results()

   -- Process data from the pline
   do !i indices !plines
      !plineLDir[!i]  =  !trimOn.plor.attribute(!plines[!i].pkey).zDir().wrt(worl)
      !cutPlAng[!i]   =  !line.direction().angle(!plineLDir[!i])
   enddo

   -- Sort plines based on angle
   !sort     =   !cutPlAng.sortedIndices()
   !cutPlAng.reIndex(!sort)
   !plines.reIndex(!sort)
   !plineLDir.reIndex(!sort)
   !plines.invert()
   !plineLDir.invert()

   -- Define a constant for reference
   !minimumAngle   =   !cutPlAng.last()

   do !i indices !plines
      if(!line.direction().angle(!plineLDir[!i]) ge !minimumAngle)then
         !plineLine       =  object LINE(!trimOn.plst.attribute(!plines[!i].pkey).wrt(worl),!trimOn.plen.attribute(!plines[!i].pkey).wrt(worl))
         !intersection    =  !line.intersection(!plineLine)
         handle ANY
            break
         endhandle
         !minimumAngle    =  !line.direction().angle(!plineLDir[!i])
         if(!intersection.distance(!line.startposition) le !length)then
            !length       =  !intersection.distance(!line.startposition)
            !endDir       =  !plineLDir[!i]
            !pline        =  !plines[!i]
         endif
      else
         if(undefined(!pline))then
            !minimumAngle =  !line.direction().angle(!plineLDir[!i])
            !length       =  100000mm
            !plines.insert(!i + 1,!plines[!i])
            !plineLDir.insert(!i + 1,!plineLDir[!i])
         endif
      endif
   enddo

   if(defined(!pline))then
      !retArray.append(!pline.pkey)
      !retArray.append(!endDir)
   else
      !!alert.warning('Could not trim the section')
   endif

   return !retArray

endfunction
-- End of function definition for !!spineTidy
