--
--
-- Description:
-- Returns the edge direction of a vertex, i.e. direction from
-- the vertex to the next one in the loop.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Vertex edge direction is to be derived from
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction from vertex to next in the loop
--
------------------------------------------------------------------------

-- Define function
define function !!vertexEdgeDir (!vertex is DBREF) is DIRECTION

  -- Get Position of vertex
  !posA   = !vertex.pos

  -- Get next item
  !next   = (NEXT of $!vertex )
  handle any
    !next = (FIRST of $!vertex )
  endhandle

  -- Get Position of next item
  !posB   = !next.pos

  -- Construct direction from the two positions
  return !!directionFromTo(!posA, !posB)

endfunction
-- End of function definition for !!vertexEdgeDir
