-- File:            vew3dwindowset.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:      M3DV-WIN
--
-- Author:          P.Mooney
-- Created:         Thu Aug 14 14:36:20 BST 1997
--
--
-- Description:
-- Gets a list of DBreferences and sets the window around them. This is
-- like doing a zoom but more exactly.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       contains the 2 positions to derive the;
--                             . radius (distance between the 2 pos)
--                             . centre position between the 2 points.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!vew3DWindowSet(!dbRefs is ARRAY)

  !array  = ARRAY()
  !pos    = object POSITION()

  if(!dbRefs.maxIndex() gt 1) then

    !array[1]  = !dbRefs[1].east
    !array[2]  = !dbRefs[2].east
    !array[3]  = !dbRefs[1].north
    !array[4]  = !dbRefs[2].north
    !array[5]  = !dbRefs[1].up
    !array[6]  = !dbRefs[2].up

    -- get centre point of volume

    !xyzPos[1]  = (!dbRefs[1].east  + !dbRefs[2].east ) / 2
    !xyzPos[2]  = (!dbRefs[1].north + !dbRefs[2].north) / 2
    !xyzPos[3]  = (!dbRefs[1].up    + !dbRefs[2].up   ) / 2

    !centrePos        = object POSITION()
    !centrePos.east   = !xyzPos[1]
    !centrePos.north  = !xyzPos[2]
    !centrePos.up     = !xyzPos[3]
    !centrePos.origin = WORLD

    -- get radius of view (distance between 2 items picked)

    !pos1 = object POSITION()
    !pos2 = object POSITION()

    !pos1.east   = !dbRefs[1].east
    !pos1.north  = !dbRefs[1].north
    !pos1.up     = !dbRefs[1].up
    !pos1.origin = WORLD

    !pos2.east   = !dbRefs[2].east
    !pos2.north  = !dbRefs[2].north
    !pos2.up     = !dbRefs[2].up
    !pos2.origin = WORLD

    -- Set calling views window

    !!viewPickForm.currentView.through    = !xyzPos


    -- Determine plane of view

    !view = !!viewPickForm.currentView.fullName()

    var !vDir    GADGET $!view VOL DIR
    var !plane   CONST PLANE $!vDir THROUGH $!centrePos
    var !iPos1   CONST POS NEAR $!pos1 ON $!plane
    var !iPos2   CONST POS NEAR $!pos2 ON $!plane

    var !dist CONST DIST $!iPos1 TO $!iPos2

    !!viewPickForm.currentView.radius     = !dist.real()


  endif

endfunction
-- End of function definition for !!vew3DWindowSet
