--
-- Author:          N.Holmes
-- Created:         Wed Jan 29 15:42:36 GMT 1997
--
--
-- Description:
-- Adds a graphical view created by another piece of Appware to the array
-- !!view3DCntrl.allViews[] as the last element. This is so it can be
-- controlled via one form and the appware programmer does not have to
-- implement Limits->CE, ISO->3 etc....
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be added to the allViews array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DAddView(!view is GADGET)

  -- Insert View reference as last element and Break.
  do !i
    if(!!view3DCntrl.allViews.unset() or undefined(!!view3DCntrl.allViews[!i])) then
      !!view3DCntrl.allViews[!i] =  !view
      break
    endif
  enddo

  -- Redisplay Current Forms
  call !!view3DCntrlDisp()

endfunction
-- End of function definition for !!view3DAddView
