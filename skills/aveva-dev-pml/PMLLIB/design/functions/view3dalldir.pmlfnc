--
--
-- Description:
-- Update Look -> Down/North/South etc for all forms selected on
-- !!view3DCntrl.list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of selected forms
--    2   R      STRING      "Down", "North", "South", "East", "West", "Up"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DAllDir(!forms is ARRAY, !direction is STRING)

   if(!forms.unset()) then
      !!alert.message('No Views selected.')
   else
      !tempArray = !forms
      !tempArray.compress()

      do !x from 1 to !tempArray.maxIndex()
         call !!view3DDir(!tempArray[!x], !direction)
      enddo
   endif


endfunction
-- End of function definition for !!view3DAllDir
