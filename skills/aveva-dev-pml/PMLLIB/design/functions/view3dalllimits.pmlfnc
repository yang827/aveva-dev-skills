-- Author:          P. Mooney
-- Created:         Wed Jan 29 10:11:14 GMT 1997
--
--
-- Description:
-- Update Limits for CE/Drawlist etc for all Views selected on
-- !!view3DCntrl.list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Possible sparse array of selected forms
--    2   R      STRING      CE, OWNER, DRAW, OBST, CLIP, GLOBAL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DAllLimits(!views is ARRAY, !limit is STRING)

   if(!views.unset()) then
      !!alert.message('No Views selected.')
   else
      !tempArray = !views
      !tempArray.compress()

      do !x from 1 to !tempArray.maxIndex()
         call !!view3DLimits(!tempArray[!x], !limit)
      enddo
   endif

endfunction
-- End of function definition for !!view3DAllLimits
