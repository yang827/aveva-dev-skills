--
-- Author:          P.Mooney
-- Created:         Wed Jun 18 15:17:13 BST 1997
--
--
-- Description:
-- Used mainly as a callback on the 3D Views for setting the
-- Limits -> Clipbox.
--
-- Gets the clipData held on the same form as the view and sets up the
-- the box. Toggles between enable/disable the Clip Box.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The View currently working with. It will be
--                           on the same form as the CLIPVIEWDATA object.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DClpBox(!view is GADGET)

  !clipArray  = ARRAY()
  !clipString = STRING()
  !fullName   = STRING()
  !fullName   = !view.fullName()

  !clipData = object VIEWCLIPDATA()
  !clipData = !view.owner().clipData

  !xLen     = !clipData.xLen
  !yLen     = !clipData.yLen
  !zLen     = !clipData.zLen
  !ori      = !clipData.ori
  !east     =  'E ' & !clipData.pos.east
  !north    = ' N ' & !clipData.pos.north
  !up       = ' U ' & !clipData.pos.up
  !pos      = !east & !north & !up

  if(!xLen.unset() or !yLen.unset() or !zLen.unset()) then
    !!alert.message('The Clip Box for this view has not yet been defined. Use Clipping-> Box-> Attributes...')
    return
  endif

  if(!xLen eq 0 or !yLen eq 0 or !zLen eq 0) then
    !!alert.message('The Clip Box for this view has not yet been defined. Use Clipping-> Box-> Attributes...')
    return
  endif

  -------------------------------------------------
  -- Find out if view is in enable/disable mode
  -------------------------------------------------

  var !clipString GADGET $!fullName VOL CLIP
  !clipArray = !clipString.split()

  if(!clipArray[2] eq 'Disable') then
    !toggle = 'Enable'
  else
    !toggle = 'Disable'
  endif

  CLIP AT   $!pos
  CLIP XLEN $!xLen YLEN $!yLen ZLEN $!zLen
  CLIP ORI  $!ori

  edit $!fullName volume
    CLIP $!toggle
  exit

endfunction
-- End of function definition for !!view3DClpBox
