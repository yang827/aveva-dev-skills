--
--
-- Description:
-- Maintains view control picking list.
-- If a form is selected, the form is shown/made active
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DCntrl()

  -- Determine which item has been selected
  !old = !!view3DCntrl.active.difference(!!view3DCntrl.list.val)
  !new = !!view3DCntrl.list.val.difference(!!view3DCntrl.active)

  -- Add item picked
  if(!new.set()) then

    -- Selected Item
    !viewNumber = !!view3DCntrl.list.rText[!new[1].real()].real()
    !!view3DCntrl.views[!viewNumber] = !!view3DCntrl.allViews[!viewNumber]

    -- If form is not shown, then show it
    if(!!view3DCntrl.views[!viewNumber].owner().shown().not()) then
      !form = !!view3DCntrl.views[!viewNumber].owner().string()
      show !!$!form free
    endif

  -- Remove item picked
  else
    !tempString = !!view3DCntrl.list.rText[!old[1].real()]
    !viewNumber = !tempString.real()
    !!view3DCntrl.views[!viewNumber].delete()
  endif

  -- Set current active selection to current selection
  !!view3DCntrl.active = !!view3DCntrl.list.val

endfunction
-- End of function definition for !!view3DCntrl
