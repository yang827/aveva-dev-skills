--
--
-- Description:
-- Displays current 3D Graphical View forms.
-- Maintains list of views on the !!view3DCntrl form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DCntrlDisp()

  -- If there are no view, empty list
  if(!!view3DCntrl.allViews.unset()) then
--    call !!view3DCntrlInit()
    return
  endif

  -- Load all Form titles into List of views
  !block   = object BLOCK(|!!view3DCntrl.allViews[!evalIndex].owner().formTitle|)
  !views   = !!view3DCntrl.allViews.evaluate(!block)

  -- If there are no forms defined, then don't do anything else
  if(!views.set()) then

    !views.compress()
    !!view3DCntrl.list.dText = !views

    !block   = object BLOCK(|!evalIndex.string()|)
    !numbers = !!view3DCntrl.allViews.evaluate(!block)
    !numbers.compress()
    !!view3DCntrl.list.rText = !numbers

    -- Select previous entries
    !block = object BLOCK(|!evalIndex.string()|)
    !array = !!view3DCntrl.views.evaluate(!block)

    !array.compress()
    !!view3DCntrl.list.select(|RTEXT|,!array)

    -- Store the indices of viewed (Active) forms in Array

    !block = object BLOCK(|!evalIndex.real()|)
    !array = !!view3DCntrl.views.evaluate(!block)

    -- Re-set Active select list with current selection
    !!view3DCntrl.active = !array

  endif

endfunction
-- End of function definition for !!view3DCntrlDisp
