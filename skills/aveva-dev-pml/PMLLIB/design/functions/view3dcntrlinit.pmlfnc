--
--
-- Description:
-- Initialise Graphical View control form.
-- Clear arrays and build list of views that may already be defined with
-- the standard name - !!view3DX, where X is a number starting at 1.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DCntrlInit()

  -- Empty All View list
  !!view3DCntrl.allViews.clear()
  !!view3DCntrl.views.clear()

  -- All graphical views
  do !i from 1 to 20
    if(defined(!!view3D$!i)) then
      !!view3DCntrl.allViews[!i] = !!view3D$!<i>.view
    endif
  enddo

  -- Redisplay Current Forms
  call !!view3DCntrlDisp()

endfunction
-- End of function definition for !!view3DCntrlInit
