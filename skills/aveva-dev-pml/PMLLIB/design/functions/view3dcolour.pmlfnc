--
--
-- Description:
-- Set Background colour of passed view to specified colour
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be modified
--    2   R      REAL        Colour code number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DColour(!view is GADGET, !code is REAL)

  !view.background = !code

endfunction
-- End of function definition for !!view3DColour
