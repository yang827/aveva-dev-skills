-- Created:         Wed Jan 29 13:52:47 GMT 1997
--
--
-- Description:
-- Toggle between the two states of the passed option
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DColourSet(!view is GADGET)

  -- Get form name and gadget name
  !form    = !view.owner().string()
  !name    = !view.name()

  -- Set command string for colour action buttons
  !command = 'call !!view3DColour(!!' + !form + '.' + !name + ',!!colourSelectGet())'

  -- Display colour selection form
  call !!colourSelectLoad(!command,'Background Colour',_view.background)

endfunction
-- End of function definition for !!view3DColourSet
