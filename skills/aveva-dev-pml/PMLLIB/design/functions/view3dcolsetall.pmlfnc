--
-- Description:
-- Toggle between the two states of the passed option
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DColSetAll(!dummyView is ARRAY)

  !tempArray = ARRAY()
  !tempArray = !!view3DCntrl.views
  !tempArray.compress()

  do !x from 1 to !tempArray.maxIndex()
    !tempArray[!x].background =  !!colourSelect.setColour
  enddo

endfunction
-- End of function definition for !!view3DColSetAll
