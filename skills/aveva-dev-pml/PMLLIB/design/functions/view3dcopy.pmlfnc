-- Created:         Thu Jun 19 16:51:25 BST 1997
--
--
-- Description:
-- An array of DBrefs is passed in. Their total VOLUME is worked out
-- and a VIEWCLIPDATA object is set-up. This can be used to define a
-- box to contain all the objects.
--
-- This function is called mainly after Limits-> Pick is selected from
-- the 3D View menu. The user has picked a collection of objects, thus
-- this is the argument to this function.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Elements to get volume for.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DCopy(!arrayDbRefs is ARRAY) is VIEWCLIPDATA

  !clipData = object VIEWCLIPDATA()

  if(NOT !arrayDbRefs.empty()) then
    !volume = object VOLUME()
    !volume = !!volumeOfList(!arrayDbRefs)

    ----------------------------------
    -- Get the pos in the middle
    -- of the box
    ----------------------------------

    !clipData.pos.east   = (!volume.from.east  + !volume.to.east ) / 2
    !clipData.pos.north  = (!volume.from.north + !volume.to.north) / 2
    !clipData.pos.up     = (!volume.from.up    + !volume.to.up   ) / 2
    !clipData.pos.origin = WORLD
    !clipData.ori        = !!viewClipData.ori.val.orientation()

    !clipData.xLen      = ABS((!clipData.pos.east  - !volume.from.east ) * 2)
    !clipData.yLen      = ABS((!clipData.pos.north - !volume.from.north) * 2)
    !clipData.zLen      = ABS((!clipData.pos.up    - !volume.from.up   ) * 2)

  endif

  return !clipData

endfunction
-- End of function definition for !!view3DCopy
