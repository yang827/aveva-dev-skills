--
--
-- Description:
-- Converts passed string direction to view direction.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be changed
--    2   R      STRING      View direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DDir(!view is GADGET, !dirString is STRING)

  -- Convert string into direction
  !direction = !dirString.direction()

  -- Convert Direction into Array
  !array[1]  = !direction.east
  !array[2]  = !direction.north
  !array[3]  = !direction.up

  -- Set View Gadget Direction
  !view.direction = !array

endfunction
-- End of function definition for !!view3DDir
