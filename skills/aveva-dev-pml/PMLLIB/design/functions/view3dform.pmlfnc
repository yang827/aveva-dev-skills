-- File:            view3dform.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        DESIGN
--   Application:   VIEW
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Jan 29 16:19:36 GMT 1997
--
--
-- Description:
-- Build 3D Graphic View Forms.
--
-- The member FormType is set to 'Design' by default so EDG functions
-- can access it.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Number of the form
--    2   R      STRING      Title of form, if unset() then uses default
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DForm(!number is REAL, !titleArg is STRING) is GADGET

  !form    = |!!view3D| + !number.string()

  if(!titleArg.empty()) then
    !title = 'Design - 3D Volume View'
  else
    !title = !titleArg
  endif

  kill       $!form
  setup form $!form resize

    $!<form>.formTitle     = |(| + !number.string() + |) | + !title
    $!<form>.iconTitle     = ||
    $!<form>.formRevision  = | $Revision: 1.9 $ |

    ------------------------------------------------------------------
    -- Build bar menu? Flag on 'Graphical View' form used. Better if
    -- a parameter passed in the future so this function can be used
    -- anywhere.
    ------------------------------------------------------------------

    if(!!view3DCreate.bflg.val eq TRUE) then

      -- Bar menu
      bar
        add |Control|  .cntrl
        add |Look|     .look
        add |ISO|      .iso
        add |Limits|   .limits
        add |Rotation| .rotation
        add |Clipping| .clipping
      exit

      -- Control Menu
      menu .cntrl
        add |Borders On/Off|       |call !!view3DSet(_view, 'Borders')|
        add |Shading On/Off|       |call !!view3DSet(_view, 'Shaded')|
        add |Background Colour...| |call !!view3DColourSet(_view)|
        add |ID Colour...|         menu .idColours
        add |Perspective On/Off|   |call !!view3DSet(_view, 'Perspective')|
        add |Walkthrough On/Off|   |call !!view3DSet(_view, 'Walkthrough')|
        add |Step Size...|         |call !!notDoneYet()|
        add |Data...|              |call !!notDoneYet()|
        add separator
        add |Close|                |call !!notDoneYet()|
      exit

      -- Highlight Menu
      menu .idColours
        add |Red|     |_view.Highlight = 'Red'|
        add |Yellow|  |_view.Highlight = 'Yellow'|
        add |Green|   |_view.Highlight = 'Green'|
        add |Cyan|    |_view.Highlight = 'Cyan'|
        add |White|   |_view.Highlight = 'White'|
      exit

      -- Look direction
      menu .look
        add |Down|        |call !!view3DDir(_view, 'Down')|
        add |North|       |call !!view3DDir(_view, 'North')|
        add |South|       |call !!view3DDir(_view, 'South')|
        add |East|        |call !!view3DDir(_view, 'East')|
        add |West|        |call !!view3DDir(_view, 'West')|
        add |Up|          |call !!view3DDir(_view, 'Up')|
        add |Explicit...| |call !!notDoneYet()|
        add |Clipbox|     menu .lClip
      exit

      -- Isometric Direction Menu
      menu .iso
        add |One|         |call !!view3DDir(_view, 'W 45 S 53.264 D')|
        add |Two|         |call !!view3DDir(_view, 'W 45 N 53.264 D')|
        add |Three|       |call !!view3DDir(_view, 'E 45 N 53.264 D')|
        add |Four|        |call !!view3DDir(_view, 'E 45 S 53.264 D')|
      exit

      -- Limits Menu
      menu .limits
        add |CE|            |call !!view3Dlimits(_view, 'CE')|
        add |Owner|         |call !!view3Dlimits(_view, 'OWNER')|
        add |Pick|          |call !!view3DPick(_view, '!!view3DPickDo', -1)|
        add |Drawlist|      |call !!view3Dlimits(_view, 'DRAW')|
        add |Obstruct list| |call !!view3Dlimits(_view, 'OBST')|
        add |Explicit...|   |call !!viewShowFT('LIMITS', '', $!<form>.view, $!number)|
        add |Clipbox|       |call !!view3Dlimits(_view, 'CLIP')|
        add sep
        add |Window|        |call !!view3DPick(_view, '!!vew3DWindowSet', 2)|
        add |Limit Box|     menu .zoom
        add sep
        add |Global|        |call !!view3Dlimits(_view, 'GLOBAL')|
      exit


      -- Rotation Menu
      menu .rotation
        add |CE Origin|   |call !!view3DRotate(_view, 'ORIGIN')|
        add |CE Centroid| |call !!view3DRotate(_view, 'CE')|
        add |Owner|       |call !!view3DRotate(_view, 'OWNER')|
        add |Pick|        |call !!view3DPick(_view, '!!view3DRotateWrap', -1)|
        add |Cursor|      |call !!view3DPick(_view, '!!view3DRotateWrap', 1)|
        add |Limits Box|  |call !!view3DRotate(_view, 'LIMITS')|
        add |Clipbox|     |call !!view3DRotate(_view, 'CLIPBOX')|
      exit

      -- Clipping Menu
      menu .clipping
        add |Enable/Disable| |call !!view3DGen(_view, 'Enable/Disable')|
        add |Cap On/Off|     |call !!view3DGen(_view, 'Cap_On/Off')|
        add |Box|             menu .clipbox
        add |Cap Colour|      menu .cCol
      exit

       -- Clip box
       menu .clipbox
         add |Attributes...|    |call !!viewShowClip($!<form>.view, $!number)|
         add |Limits...|        |call !!viewShowFT('CLIPDATA', '', $!<form>.view, $!number)|
       exit

       -- Clip cap colours
       menu .cCol
         add |Default| |CALLG MVOLCNTRL $!<form>.view CLIP $<CAP COL DEFAULT$>|
         add |Red|     |CALLG MVOLCNTRL $!<form>.view CLIP $<CAP COL 2$>|
         add |Yellow|  |CALLG MVOLCNTRL $!<form>.view CLIP $<CAP COL 4$>|
         add |Green|   |CALLG MVOLCNTRL $!<form>.view CLIP $<CAP COL 5$>|
         add |Cyan|    |CALLG MVOLCNTRL $!<form>.view CLIP $<CAP COL 6$>|
         add |White|   |CALLG MVOLCNTRL $!<form>.view CLIP $<CAP COL 10$>|
       exit
    endif

    -- Prompt Line
    para .prompt width 80 lines 1

    -- Graphical View
    view .view at xmin ymax prompt .prompt volume

      width 110 aspect 1.404
      limits auto

      -- Create input modes
      inmode create _navi    type |DES_NAVIGATE|
      inmode create _pick    type |DES_PICK|
      inmode create _pAny    type |DES_PICK_ANY|
      inmode create _pPline  type |DES_PICK_PLINE|
      inmode create _point   type |DES_PICK_POINT|
      inmode create _screen  type |DES_3D_LINE|
      inmode create _default type |DES_NAVIGATE|
    exit

    _view.navi.prompt    = !!view3DCntrl.naviPrompt
    _view.navi.cursor    = 'pointer'

    _view.pick.prompt    = !!view3DCntrl.pickPrompt
    _view.pick.cursor    = 'pointer'

    _view.pAny.prompt    = !!view3DCntrl.panyPrompt
    _view.pAny.cursor    = 'pointer'

    _view.pPline.prompt  = !!view3DCntrl.ppLinePrompt
    _view.pPline.cursor  = 'pointer'

    _view.point.prompt   = !!view3DCntrl.pointPrompt
    _view.point.cursor   = 'pointer'

    _view.screen.prompt  = !!view3DCntrl.screenPrompt
    _view.screen.cursor  = 'pointer'

    _view.default.prompt = !!view3DCntrl.defaultPrompt
    _view.default.cursor = 'pointer'

    --------------------------------
    -- MEMBERS
    --------------------------------

    member .clipData  is VIEWCLIPDATA

  exit
  -- End of form !!view3D<val> --

  ------------------------------
  -- Set view data
  ------------------------------
  $!<form>.view.background = |Black|
  $!<form>.view.shaded     = true

  show $!<form> FREE

  ------------------------------
  -- Set ClipData object
  ------------------------------

  !tempOri =  'Y is N and Z is U'

  $!<form>.clipData.pos.up     = 0
  $!<form>.clipData.pos.east   = 0
  $!<form>.clipData.pos.north  = 0
  $!<form>.clipData.xLen       = 0
  $!<form>.clipData.yLen       = 0
  $!<form>.clipData.zLen       = 0
  $!<form>.clipData.ori        = !tempOri.orientation()

  -- End of form definition
  return $!<form>.view

endfunction
-- End of function definition for !!view3DForm
