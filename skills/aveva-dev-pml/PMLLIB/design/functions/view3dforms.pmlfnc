-- File:            view3dforms.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        DESIGN
--   Application:   VIEW
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Jan 29 15:42:36 GMT 1997
--
--
-- Description:
-- Creates/Removes 3D graphical views.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      string      Option, ADD, REMOVE or REMALL
--    2   R      STRING      Title of form - if unset uses default name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DForms (!option is STRING, !title is STRING)

  -- Add New Graphics View
  if(!option eq |ADD|) then

    -- Get next available form
    do !i
      if(!!view3DCntrl.allViews.unset() or undefined(!!view3DCntrl.allViews[!i])) then
        if(!title.unset()) then
          !!view3DCntrl.allViews[!i] =  !!view3DForm(!i, 'Design - 3D Volume View')
          !!view3DCntrl.designViews.append(!!view3DCntrl.allViews[!i])
          break
        else
          !!view3DCntrl.allViews[!i] =  !!view3DForm(!i, !title)
          !!view3DCntrl.designViews.append(!!view3DCntrl.allViews[!i])
          break
        endif
      endif
    enddo

  -- Remove selected Graphic Views
  elseif (!option eq |REMOVE| or !option eq |REMALL|) then

    -- Remove only highlighted ones ELSE All Views
    if(!option eq |REMOVE|) then
      !views = !!view3DCntrl.views
    else
      !views = !!view3DCntrl.allViews
    endif

    -- Get each entry selected and hide each form
    do !view values !views
      !view.owner().hide()
    enddo

    !!view3DCntrl.views.clear()
    !!view3DCntrl.active.clear()
  endif

  -- Redisplay Current Forms
  call !!view3DCntrlDisp()

endfunction
-- End of function definition for !!view3DForms
