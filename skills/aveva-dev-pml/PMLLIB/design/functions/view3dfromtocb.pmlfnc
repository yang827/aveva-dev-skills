-- File:            view3dfromtocb.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Fri Jun 13 13:47:59 BST 1997
--
--
-- Description:
-- Call back for the Apply button on the View3DLimits form.
-- Sets !!viewClipData form and draws new box. If CLIP BOX is enabled,
-- it will set the new clip box and enable it.
-- HOW IT WORKS: Construct a position from the midpoint between the 2
-- corners and draws the AID BOX.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'CLIPDATA' set clipbox on pressing the
--                                      Apply button
--                           'DISMISS'  Clear aid box
--                           'LIMITS'   Sets the limits for the
--                                      (!!view3DFromTo.) CurrentView
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DFromToCB(!option is STRING)

  !temp    = STRING()
  !fromPos = POSITION
  !toPos   = POSITION

  ---------------------------------
  -- Get First corners co-ordinates
  ---------------------------------

  !temp          = !!view3DFromTo.x1O.selection() & !!view3DFromTo.x1.val
  !fromPos.east  = !temp.real()

  !temp          = !!view3DFromTo.y1O.selection() & !!view3DFromTo.y1.val
  !fromPos.north = !temp.real()

  !temp          = !!view3DFromTo.z1O.selection() & !!view3DFromTo.z1.val
  !fromPos.up    = !temp.real()

  ---------------------------------
  -- Get second corner co-ords
  ---------------------------------

  !temp          = !!view3DFromTo.x2O.selection() & !!view3DFromTo.x2.val
  !toPos.east    = !temp.real()

  !temp          = !!view3DFromTo.y2O.selection() & !!view3DFromTo.y2.val
  !toPos.north   = !temp.real()

  !temp          = !!view3DFromTo.z2O.selection() & !!view3DFromTo.z2.val
  !toPos.up      = !temp.real()

  ----------------------------------
  -- Get the pos in the middle
  -- of the box
  ----------------------------------

  !middleEast    = (!fromPos.east  + !toPos.east ) / 2
  !middleNorth   = (!fromPos.north + !toPos.north) / 2
  !middleUp      = (!fromPos.up    + !toPos.up   ) / 2

  !xLen          = ABS((!middleEast  - !fromPos.east ) * 2)
  !yLen          = ABS((!middleNorth - !fromPos.north) * 2)
  !zLen          = ABS((!middleUp    - !fromPos.up   ) * 2)

  ----------------------------------
  -- Draw the box
  ----------------------------------

  !east  =  'E ' & !middleEast
  !north = ' N ' & !middleNorth
  !up    = ' U ' & !middleUp
  !pos   = !east & !north & !up

  AID CLEAR BOX  90210
  handle any
    -- Box does not yet exist
  endhandle
  AID BOX   NUMB 90210 AT $!pos XLEN $!xLen YLEN $!yLen ZLEN $!zLen FILL OFF

  --------------------------------------------------------------------
  -- Hit the DISMISS button on View3DFromTo
  --------------------------------------------------------------------

  if(!option eq 'DISMISS') then
    AID CLEAR BOX  90210

  --------------------------------------------------------------------
  -- If user hit Apply button on !!view3DFromTo
  -- set the CLIPDATA object for the correct form
  --------------------------------------------------------------------

  elseif(!option eq 'CLIPDATA') then

    if(!!view3DFromTo.currentView.unset())then
      !!alert.warning('No view is currently set')
      return
    endif

    -- SET UP NEW OBJECT & ASSIGN IT TO CurrentView

    !clipData           = object VIEWCLIPDATA()
    !clipData.pos.east  = !middleEast
    !clipData.pos.north = !middleNorth
    !clipData.pos.up    = !middleUp
    !clipData.xLen      = !xLen
    !clipData.yLen      = !yLen
    !clipData.zLen      = !zLen
    !clipData.ori       = !!view3DFromTo.currentView.owner().clipData.ori

    !!view3DFromTo.currentView.owner().clipData = !clipData

    --------------------------------------------------------------
    -- If!!viewClipData Pointing at same view, update its gadgets
    --------------------------------------------------------------

    if(!!viewClipData.currentView eq !!view3DFromTo.currentView) then
      !!viewClipData.x.val     = !clipData.pos.east.abs().string()
      !!viewClipData.y.val     = !clipData.pos.north.abs().string()
      !!viewClipData.z.val     = !clipData.pos.up.abs().string()
      !!viewClipData.xLen.val  = !clipData.xLen.string()
      !!viewClipData.yLen.val  = !clipData.yLen.string()
      !!viewClipData.zLen.val  = !clipData.zLen.string()
      !!viewClipData.ori.val   = !clipData.ori.string()

      -- Set selector gadgets for East/West (''/'-') etc...

      if(!clipData.pos.east lt 0) then
        !!viewClipData.xO.select('RTEXT', '-')
      else
        !!viewClipData.xO.select('RTEXT', '')
      endif

      if(!clipData.pos.north lt 0) then
        !!viewClipData.yO.select('RTEXT', '-')
      else
        !!viewClipData.yO.select('RTEXT', '')
      endif

      if(!clipData.pos.up lt 0) then
        !!viewClipData.zO.select('RTEXT', '-')
      else
        !!viewClipData.zO.select('RTEXT', '')
      endif
    endif

  -------------------------------------------------------------
  -- LIMITS - Apply button pressed.
  --------------------------------------------------------------

  elseif(!option eq 'LIMITS') then
    !volume      = object VOLUME()
    !volume.from = !fromPos
    !volume.to   = !toPos

    !array[1]    = !volume.from.east
    !array[2]    = !volume.to.east
    !array[3]    = !volume.from.north
    !array[4]    = !volume.to.north
    !array[5]    = !volume.from.up
    !array[6]    = !volume.to.up

    !!view3DFromTo.currentView.limits = !array

  endif

endfunction
-- End of function definition for !!view3DFromToCB
