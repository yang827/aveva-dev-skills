-- Author:          P.Mooney
-- Created:         Wed Jun 18 17:38:48 BST 1997
--
--
-- Description:
-- Collection of small bits of code that do not need a whole function
-- to themselves.
--
-- Mainly applies to Clip Box functionality.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'Enable/Disable' - switch for clipping
--                           'Cap_On/Off'     - switch for caps in clipping
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DGen(!view is GADGET, !option is STRING)

  !fullName = STRING()
  !fullName = !view.fullName()

  --------------------------------------------
  -- Toggle between Enable/Disable clipping.
  -- !!view3DClpBox() contains EDIT syntax for
  -- a view + other CLIP related syntax.
  --------------------------------------------

  if(!option eq 'Enable/Disable') then

    !!view3DClpBox(!view)

  ---------------------------
  -- Toggle Caps for clipping
  ---------------------------

  elseif(!option eq 'Cap_On/Off') then
    var !capString GADGET $!fullName VOLUME CLIP CAP
    !capArray = !capString.split()

    if(!capArray[3] eq 'Off') then
      !toggle = 'On'
    else
      !toggle = 'Off'
    endif

    EDIT $!fullName volume
      CLIP CAP $!toggle
    EXIT

  -------------------------------------------------
  --
  --
  -------------------------------------------------

  elseif(!option.upcase() eq 'COPYPICKS') then

  endif

endfunction
-- End of function definition for !!view3DGen
