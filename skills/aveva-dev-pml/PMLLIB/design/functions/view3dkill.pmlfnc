--
-- Author:          N.Holmes
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- Kills a 3D view and removes it from the control form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form to be killed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DKill (!form is FORM)

  -- Collect all forms for all the views
  !block      = object BLOCK('!!view3DCntrl.allViews[!evalIndex].owner().name()')
  !forms      = !!view3DCntrl.allViews.evaluate(!block)

  -- Find all entries for the passed form
  !formName   = !form.name()

  -- Determine view(s) which are owned by the form
  !entries    = !forms.find(!formName)

  -- If there are no entries, form is not in !allViews
  if(!entries.unset()) then
--    call !!view3DCntrlDisp()
    return
  endif

  -- Remove entries from !!view3DCntrl
  do !i values !entries

    -- Remove view entry from list of all forms
    !!view3DCntrl.allViews[!i].delete()

    -- Remove entry from current selected list, if it is selected
    if(defined(!!view3DCntrl.views[!i])) then
      if(!!view3DCntrl.views[!i].set()) then
        !!view3DCntrl.views[!i].delete()
      endif
    endif
  enddo

  -- Kill the form
  kill !!$!form

  -- Refresh the Control form display
  call !!view3DCntrlDisp()

endfunction
-- End of function definition for !!view3DKill
