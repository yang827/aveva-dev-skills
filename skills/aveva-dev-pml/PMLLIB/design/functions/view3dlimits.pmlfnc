-- File:            view3dlimits.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        DESIGN
--   Replaces:      M3DV-LIMIT
--
-- Author:          N.Holmes
-- Created:         Mon Feb 3 14:52:09 GMT 1997
--
--
-- Description:
-- Changes view limits for passed 3D form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be modified
--    2   R      STRING      Option =  CE, OWNER, DRAW, OBST, CLIP,
--                                     GLOBAL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DLimits (!view is GADGET, !option is STRING)

  !volume = object VOLUME()

  -----------------------------
  -- Current element
  -----------------------------

  if(!option.upcase() eq 'CE') then
    !volume = !!volume(!!ce)

  -----------------------------
  -- Owning Element
  -----------------------------

  elseif (!option.upcase() eq 'OWNER') then
    !volume = !!volume(!!ce.owner)

  ------------------------------
  -- Drawlist or Obstruction List
  ------------------------------

  elseif (!option.upcase() eq 'DRAW' or !option.upcase() eq 'OBST') then

    -- Drawlist
    if(!option.upcase() eq 'DRAW') then
      var !coll COLLECT ALL FROM DRAWLIST
      !type = 'Draw list'
    else
      var !coll COLLECT ALL FROM OBST
      !type = 'Obstruction list'
    endif

    -- Check we have some items in the list
    if(!coll.unset()) then
      !!alert.error('No Element in the ' + !type + ', unable to derive limits.')
      return
    endif

    !block    = object BLOCK('!coll[!evalIndex].dbRef()')
    !list     = !coll.evaluate(!block)
    !volume   = !!volumeOfList(!list)

  -----------------------------
  -- CLIP BOX
  -----------------------------

  elseif(!option.upcase() eq 'CLIP') then
    !clipData = object VIEWCLIPDATA()
    !clipData = !view.owner().clipData

    if(!clipData.pos.origin.unset()) then
      !!alert.warning('No Clip Box has been defined for this View. Use Clipping -> Box')
      return
    endif

    !volume.from.origin = WORLD
    !volume.from.east   = !clipData.pos.east  - abs(!clipData.xLen / 2)
    !volume.from.north  = !clipData.pos.north - abs(!clipData.yLen / 2)
    !volume.from.up     = !clipData.pos.up    - abs(!clipData.zLen / 2)

    !volume.to.origin   = WORLD
    !volume.to.east     = !clipData.pos.east  + abs(!clipData.xLen / 2)
    !volume.to.north    = !clipData.pos.north + abs(!clipData.yLen / 2)
    !volume.to.up       = !clipData.pos.up    + abs(!clipData.zLen / 2)

  --------------------------------------------------------------
  -- GLOBAL LIMITS (AUTO /SITE)
  -- This uses EDIT syntax because I do not have the ability to
  -- query the Auto limits.
  --------------------------------------------------------------

  elseif(!option.upcase() eq 'GLOBAL') then
    !fullName = STRING()
    !fullName = !view.fullName()

    edit $!fullName volume
      limit auto
    exit

    return
  endif

  -- draw AID BOX around volume.
--  call !!drawVolume(!volume, 1, World)

  --------------------------------------------------
  -- Load !array for view limits with !volume limits
  --------------------------------------------------

  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  !view.limits = !array

endfunction
-- End of function definition for !!view3DLimits
