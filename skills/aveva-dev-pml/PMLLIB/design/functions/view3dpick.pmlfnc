--
--
-- Description:
-- Sets up a picking loop to capture a set of elements picked. It
-- displays a small form which is the equivalent of the old "Status Form"
-- containing only the Cancel button.
--
-- Once the STOP button is pressed, it calls the !callback function with
-- an array argument of the elements picked.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View to operate on
--    2   R      STRING      The function to call when the STOP button
--                           is pressed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DPick(!view is GADGET, !callback is STRING, !picksNeeded is REAL)

  ----------------------------------------------------------------------
  -- Initialise form !!viewPickForm
  ----------------------------------------------------------------------

  show !!viewPickForm

  !!viewPickForm.currentView     = !view
  !!viewPickForm.userFunction    = !callback
  !!viewPickForm.picksNeeded     = !picksNeeded
  !!viewPickForm.elements.clear()

  ----------------------------------------------------------------------
  -- Set EDG to pick elements (PICK) and only sections (See Qualifier)
  ----------------------------------------------------------------------

  !args              = object EDGPUSHPARAMS()
  !args.pickHandler  = '!!edgPickFast'
  !args.inMode       = 'PICK'
  !args.userFunction = '!!view3DPickCB(|ADD|)'
  !args.appName      = 'ViewPickForm'
  !args.showPickForm = FALSE
  !args.elementQual  = ''

  !bResult = !!edgPush(!args)
  !bResult = !!edgGeomPrmpt('ViewPickForm', 'Please pick elements', '')

endfunction
-- End of function definition for !!view3DPick
