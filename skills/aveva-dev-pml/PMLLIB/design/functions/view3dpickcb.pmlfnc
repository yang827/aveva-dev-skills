--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Wed Jun 25 16:58:03 BST 1997
--
--
-- Description:
-- Callback for pick loop. By default, !!view3DPickCB(|ADD|) is what the
-- core calls on button up (set by !!view3DPick()). OK & CANCEL options
-- are used when pressing the buttons on the !!viewPickForm.
--
-- ADD option checks to see if reached we have got the right number of
-- PicksNeeded. If PicksNeeded eq -1 then it will go on forever until
-- the users presses OK.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'ADD'    - appends Dbref picked to array
--                                      elements on the !!viewPickForm
--                           'OK'     - Pops View Pick of the stack and
--                                      calls the user function with an
--                                      array argument of all the Dbrefs.
--                           'CANCEL' - Just Pop stack, don't run user
--                                      function
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DPickCB(!option is STRING)

  if(!option eq 'ADD') then
    !!viewPickForm.elements.append(!!edgGeomData.pickedItem)
    !!viewPickForm.numPicks = !!viewPickForm.numPicks + 1

    if(!!viewPickForm.numPicks eq !!viewPickForm.picksNeeded) then
      !bResult = !!edgPop('ViewPickForm')
      hide !!viewPickForm
      $!!viewPickForm.userFunction(!!viewPickForm.elements)
    endif

  elseif(!option eq 'OK') then
    !bResult = !!edgPop('ViewPickForm')
    $!!viewPickForm.userFunction(!!viewPickForm.elements)

  elseif(!option eq 'CANCEL') then
    !bResult = !!edgPop('ViewPickForm')

  elseif(!option eq 'INIT') then
    !!viewPickForm.numPicks    = 0
    !!viewPickForm.picksNeeded = 0
  endif

endfunction
-- End of function definition for !!view3DPickCB
