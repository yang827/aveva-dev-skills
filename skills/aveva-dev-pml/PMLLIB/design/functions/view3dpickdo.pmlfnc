--
--
-- Description:
-- Form option Limits-> Pick on 3D View form.
-- When user presses the OK button to stop the pick loop, this
-- function is called with an Array of elements picked to the original
-- function.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       DBrefs picked.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DPickDo(!dbRefs is ARRAY)

  !array  = ARRAY()
  !volume = object VOLUME()

  if(!dbRefs.unset()) then
    return
  endif

  !volume = !!volumeOfList(!dbRefs)

  !array[1]    = !volume.from.east
  !array[2]    = !volume.to.east
  !array[3]    = !volume.from.north
  !array[4]    = !volume.to.north
  !array[5]    = !volume.from.up
  !array[6]    = !volume.to.up

  !!viewPickForm.currentView.limits = !array

--  !!drawVolume(!volume, 1, World)

endfunction
-- End of function definition for !!view3DPickDo
