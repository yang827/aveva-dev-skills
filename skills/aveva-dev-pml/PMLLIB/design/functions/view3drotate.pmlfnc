-- File:            view3drotate.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Mar 11 10:55:22 GMT 1997
--
--
-- Description:
-- Rotate the VIEW about CE, OWNER, ORIGIN etc...
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The View to be updated
--               STRING      empty, view to be updated in !!viewPickForm.currentView
--    2   R      STRING      Rotate options:
--                           CE          - Current elements centroid\ Handle as an uncaptured
--                           OWNER       - owner of ce centroid     / item
--                           ID          - pick items centroid
--                           ORIGIN      - rotate about the CE origin
--                           PICK        - exacted position on picked item
--                           CLIPBOX     - use clip box
--                           LIMITS      - centre of limits box
--
--               ARRAY       list of 1 or more DBrefs picked.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DRotate(!view is GADGET, !option is ANY)

  !limits = ARRAY()

  if(!option.objectType() eq 'STRING') then

    if(!option eq 'CE') then
      !array[1]     = !!ce.pos.wrt(world).east
      !array[2]     = !!ce.pos.wrt(world).north
      !array[3]     = !!ce.pos.wrt(world).up
      !view.through = !array

    elseif(!option eq 'OWNER') then
      !a = !!ce.owner
      if(!a.unset()) then
        !!alert.message('World does not have an owner.')
        return
      endif

      !b = !!ce.owner.pos
      handle any
        !!alert.message('The owner does not have a position')
        return
      endhandle

      if(!b.unset()) then
        !!alert.message('The owner does not have a position.')
        return
      endif

      !array[1]     = !!ce.owner.pos.wrt(world).east
      !array[2]     = !!ce.owner.pos.wrt(world).north
      !array[3]     = !!ce.owner.pos.wrt(world).up
      !view.through = !array

    elseif(!option eq 'LIMITS') then
      !limits       = !view.limits
      !array[1]     = (!limits[1] + !limits[2]) / 2
      !array[2]     = (!limits[3] + !limits[4]) / 2
      !array[3]     = (!limits[5] + !limits[6]) / 2
      !view.through = !array

    endif

  elseif(!option.objectType() eq 'ARRAY') then

    if(!option.maxIndex() eq 1) then
      !array[1]     = !option[1].pos.wrt(world).east
      !array[2]     = !option[1].pos.wrt(world).north
      !array[3]     = !option[1].pos.wrt(world).up
      !view.through = !array
    else
      !array        = ARRAY()
      !volume       = object VOLUME()
      !volume       = !!volumeOfList(!option)

      !array[1]     = (!volume.from.east  + !volume.to.east ) / 2
      !array[2]     = (!volume.from.north + !volume.to.north) / 2
      !array[3]     = (!volume.from.up    + !volume.to.up   ) / 2
      !view.through = !array
    endif

  endif

endfunction
-- End of function definition for !!view3DRotate
