-- File:            view3drotateall.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Mar 11 13:46:52 GMT 1997
--
--
-- Description:
-- Basically a DO loop to change the rotation for ALL views by
-- calling View3DRotate for each one.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of View gadgets to update.
--                           This can be a sparse array.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DRotateAll(!views is ARRAY, !option is STRING)

  !x     = REAL()
  !array = ARRAY()

  if(!views.unset()) then
    !!alert.error('No views selected.')
    return
  endif

  if(!option.unset()) then
    !!alert.error('!option parameter is unset for function !!view3DRotateAll')
  endif

  !array = !views
  !array.compress()

  do !x from 1 to !array.maxIndex()
    call !!view3DRotate(!array[!x], !option)
  enddo

endfunction
-- End of function definition for !!view3DRotateAll
