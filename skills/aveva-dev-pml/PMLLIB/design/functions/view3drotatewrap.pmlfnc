--
--
-- Description:
-- Wrapper function to call view3DRotate with extra parameter, the
-- current view.
-- This function does the job polymorphism because 1 or 2 parameter
-- signatures would be better. See below;
--
--
--    !!view3DRotate(ARRAY)           : called from ViewPickCB()
--                                      Array of DBrefs to rotate around
--
--    !!view3DRotate(GADGET, STRING)  : called direct form Views form menu
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       list of DB refs picked.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DRotateWrap(!dbRefs is ARRAY)

  call !!view3DRotate(!!viewPickForm.currentView, !dbRefs)

endfunction
-- End of function definition for !!view3DRotateWrap
