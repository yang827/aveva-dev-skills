--   Module:        DESIGN
--   Replaces:      M3DV-LOOK
--
-- Author:          N.Holmes
-- Created:         Wed Jan 29 13:52:47 GMT 1997
--
--
-- Description:
-- Toggle between the two states of the passed option
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget
--    2   R      STRING      Set command
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!view3DSet(!view is GADGET, !setString is STRING)

  -- EyeMode     (boolean)
  if(!setString.upcase() eq 'EYEMODE') then

    !view.eyeMode         = !view.eyeMode.not()

  -- Shaded      (boolean)
  elseif (!setString.upcase() eq 'SHADED') then

    !view.shaded          = !view.shaded.not()

  -- Borders      (boolean)
  elseif (!setString.upcase() eq 'BORDERS') then

    !view.borders         = !view.borders.not()

  -- WalkThrough (Boolean) (eye on pulldown)
  elseif (!setString.upcase() eq 'WALKTHROUGH') then

    !view.walkThrough     = !view.walkThrough.not()

  -- Projection  (PARALLEL/PERSPECTIVE)
  elseif (!setString.upcase() eq 'PERSPECTIVE') then

    if(!view.projection eq 'PARALLEL') then
      !view.projection    = 'PERSPECTIVE'
    else
      !view.projection    = 'PARALLEL'
    endif
  endif

endfunction
-- End of function definition for !!view3DSet
