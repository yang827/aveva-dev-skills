-- File:            view3dsetall.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        DESIGN
--   Replaces:      M3DV-LOOK
--
-- Author:          P.Mooney
-- Created:         Wed Mar5 15:10:30 GMT 1997
--
--
-- Description:
-- Takes array of view gadgets passed as argument 1 and loops through each
-- gadget calling !!view3DSet() to toggle between the 2 states of the option
-- passed (e.g. Borders on/off)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of View gadgets
--    2   R      STRING      Set command
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!view3DSetAll(!views is ARRAY, !setString is STRING)

  if(!views.unset()) then
    !!alert.message('No views selected.')
    return
  endif

  if(!setString.unset()) then
    !!alert.error('Parameter !setString is unset')
    return
  endif

  !array = !views
  !array.compress()

  do !x from 1 to !array.maxIndex()
    call !!view3DSet(!array[!x], !setString)
  enddo

endfunction
-- End of function definition for !!view3DSetAll
