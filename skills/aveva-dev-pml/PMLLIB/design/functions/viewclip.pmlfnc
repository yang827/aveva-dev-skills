-- File:            viewclip.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Mon Jun 9 16:19:01 BST 1997
--
--
-- Description:
-- Callback on nearly all gadget on ViewClipData form. It's main
-- function is to draw an AID BOX from the data entered from the text
-- gadgets from !!viewClipData.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'APPLY'   draws AID BOX, sets CLIP BOX
--                           'RESET'   sets gadgets back to original values
--                                     and resets calling forms CLIPDATA
--                           'DISMISS' Clears, AID BOX, hides ViewClipData
--                                     form
--                           ''        Default, draws AID BOX with new
--                                     values typed in.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if init was OK, FALSE otherwise.
--
------------------------------------------------------------------------

define function !!viewClip(!option is STRING) is BOOLEAN

  if(!option eq 'RESET') then
    !!viewClipData.currentView.owner().clipData = !!viewClipData.resetClipData
    !!viewClipData.x.val                        = !!viewClipData.resetClipData.pos.east.string()
    !!viewClipData.y.val                        = !!viewClipData.resetClipData.pos.north.string()
    !!viewClipData.z.val                        = !!viewClipData.resetClipData.pos.up.string()
    !!viewClipData.xLen.val                     = !!viewClipData.resetClipData.xLen.string()
    !!viewClipData.yLen.val                     = !!viewClipData.resetClipData.yLen.string()
    !!viewClipData.zLen.val                     = !!viewClipData.resetClipData.zLen.string()
    !!viewClipData.ori.val                      = !!viewClipData.resetClipData.ori.string()
    return TRUE
  endif

  if(!option eq 'DISMISS') then
    AID CLEAR BOX  90210
    handle any
      -- Box does not yet exist
    endhandle

    !!viewClipData.hide()
  endif

  -----------------------------------------
  -- Set Clipping area to what has already
  -- been defined & Draw BOX
  -----------------------------------------

  !xLen  = !!viewClipData.xLen.val
  !yLen  = !!viewClipData.yLen.val
  !zLen  = !!viewClipData.zLen.val
  !ori   = !!viewClipData.ori.val
  !east  =  'E ' & !!viewClipData.xO.selection() & !!viewClipData.x.val
  !north = ' N ' & !!viewClipData.yO.selection() & !!viewClipData.y.val
  !up    = ' U ' & !!viewClipData.zO.selection() & !!viewClipData.z.val
  !pos   = !east & !north & !up

  if(!!viewClipData.x.val.empty() or !!viewClipData.y.val.empty() or !!viewClipData.z.val.empty()) then
    return TRUE
  endif

  if(!xLen.empty() or !yLen.empty() or !zLen.empty()) then
    return TRUE
  endif

  ----------------------------------
  -- SET VIEWS ClipData OBJECT
  ----------------------------------

  !!viewClipData.currentView.owner().clipData.pos  = !pos.position()
  !!viewClipData.currentView.owner().clipData.xLen = !xLen.real()
  !!viewClipData.currentView.owner().clipData.yLen = !yLen.real()
  !!viewClipData.currentView.owner().clipData.zLen = !zLen.real()
  !!viewClipData.currentView.owner().clipData.ori  = !ori.orientation()

  AID CLEAR BOX  90210
  handle any
    -- Box does not yet exist
  endhandle
  AID BOX   NUMB 90210 AT $!pos XLEN $!xLen YLEN $!yLen ZLEN $!zLen ORI $!ori FILL OFF

  ----------------------------------------------------
  -- SET CLIP BOX TO NEW POS IF APPLY BUTTON PRESSED
  -- IF View3DFromTo also working on same form, update
  -- its gadgets also.
  ----------------------------------------------------

  if(!option eq 'APPLY') then

    if(!!viewClipData.currentView eq !!view3DFromTo.currentView) then
      if(!!view3DFromTo.shown()) then
        call !!viewShowFT('CLIPDATA', '', !!viewClipData.currentView, 0)
      endif
    endif
  endif

  return TRUE

endfunction
-- End of function definition for !!viewClip
