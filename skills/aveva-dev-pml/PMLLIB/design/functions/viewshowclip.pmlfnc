--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Jun 10 14:16:52 BST 1997
--
--
-- Description:
-- Acts a bit like the old X Macros...
-- Show the clipping form with the data from the calling Design
-- View form. Each calling form has a member VIEWCLIPDATA that
-- replicates what is on the !!viewClipData form.
--
-- The ViewClipData form is shown BEFORE the gadgets are set to get
-- round a bug when a show is performed from a menu.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget
--    2   R      REAL        Number of the View gadget calling
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!viewShowClip(!view is GADGET, !number is REAL)

  !clipData = object VIEWCLIPDATA()

  show !!viewClipData

  !clipData                    = !view.owner().clipData

  !!viewClipData.resetClipData = !clipData
  !!viewClipData.x.val         = !clipData.pos.east.abs().string()
  !!viewClipData.y.val         = !clipData.pos.north.abs().string()
  !!viewClipData.z.val         = !clipData.pos.up.abs().string()
  !!viewClipData.xLen.val      = !clipData.xLen.string()
  !!viewClipData.yLen.val      = !clipData.yLen.string()
  !!viewClipData.zLen.val      = !clipData.zLen.string()
  !!viewClipData.ori.val       = !clipData.ori.string()

  if(!clipData.pos.east lt 0) then
    !!viewClipData.xO.select('RTEXT', '-')
  else
    !!viewClipData.xO.select('RTEXT', '')
  endif

  if(!clipData.pos.north lt 0) then
    !!viewClipData.yO.select('RTEXT', '-')
  else
    !!viewClipData.yO.select('RTEXT', '')
  endif

  if(!clipData.pos.up lt 0) then
    !!viewClipData.zO.select('RTEXT', '-')
  else
    !!viewClipData.zO.select('RTEXT', '')
  endif


  !!viewClipData.para1.val     = 'NEW View number ' & !number
  !!viewClipData.currentView   = !view

  -------------------------
  -- show AID BOX
  -------------------------

  !!viewClip('')

endfunction
-- End of function definition for !!viewShowClip
