--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Jun 17 17:20:16 BST 1997
--
--
-- Description:
-- Sets up form !!view3DFromTo and shows it.
-- Works out 2 corners furthest away from each other from the object
-- CLIPDATA stored on the same form as the View gadget.
--
-- ori not taken into account !!!!!!!!!!!!!!!!!!!!!!!!!!!
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option to say where to get the data from to
--                           populate the gadgets.
--    2   R      STRING
--    3   R      GADGET      The View to work with
--    4   R      REAL        The number of the Design View
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!viewShowFT(!option is STRING, !applyFunc is STRING, !view is GADGET, !dummyNumber is REAL)

  !toPos    = object POSITION()
  !fromPos  = object POSITION()
  !clipData = object VIEWCLIPDATA()

  !clipData = !view.owner().clipData

  show !!view3DFromTo

  !!view3DFromTo.currentView   = !view
  !!view3DFromTo.viewTitle.val = !view.owner().formTitle

  -----------------------------------------------------------
  -- set callbacks on gadgets (Apply, Dismiss & Text gadgets)
  -----------------------------------------------------------

  if(!applyFunc eq '') then
    !!view3DFromTo.applyFunc = |!!view3DFromToCB('| & !option & |')|
  else
    !!view3DFromTo.applyFunc = !applyFunc
  endif

  !!view3DFromTo.textFunc    = |!!view3DFromToCB('UPDATE')|
  !!view3DFromTo.dismissFunc = |!!view3DFromToCB('DISMISS')|

  --------------------------------------------------------------------------
  -- Check the !option to see where to get the volume data from
  --------------------------------------------------------------------------

  if(!option eq 'CLIPDATA') then

    -- From POSITION

    !fromPos.east  = !clipData.pos.east  - (!clipData.xLen / 2)
    !fromPos.north = !clipData.pos.north - (!clipData.yLen / 2)
    !fromPos.up    = !clipData.pos.up    - (!clipData.zLen / 2)

    -- To POSITION

    !toPos.east    = !clipData.pos.east  + (!clipData.xLen / 2)
    !toPos.north   = !clipData.pos.north + (!clipData.yLen / 2)
    !toPos.up      = !clipData.pos.up    + (!clipData.zLen / 2)

  elseif(!option eq 'LIMITS') then
    !limits = ARRAY()
    !limits = !view.limits

    -- From POSITION

    !fromPos.east  = !limits[1]
    !fromPos.north = !limits[3]
    !fromPos.up    = !limits[5]

    -- To POSITION

    !toPos.east    = !limits[2]
    !toPos.north   = !limits[4]
    !toPos.up      = !limits[6]

  else
    !!alert.error('Unknown option "$!option" given to !!viewShowFT()')

  endif

  --------------------------------------
  -- SET GADGETS ON !!view3DFromTo
  -- First, text gadgets, then selectors
  --------------------------------------

  !!view3DFromTo.x1.val  = !fromPos.east.abs().string()
  !!view3DFromTo.y1.val  = !fromPos.north.abs().string()
  !!view3DFromTo.z1.val  = !fromPos.up.abs().string()

  !!view3DFromTo.x2.val  = !toPos.east.abs().string()
  !!view3DFromTo.y2.val  = !toPos.north.abs().string()
  !!view3DFromTo.z2.val  = !toPos.up.abs().string()

  ------------------------------------------------------------------
  -- 'From' SET OF SELECTOR GADGETS
  ------------------------------------------------------------------

  if(!fromPos.east lt 0) then
    !!view3DFromTo.x1O.select('RTEXT', '-')
  else
    !!view3DFromTo.x1O.select('RTEXT', '')
  endif

  if(!fromPos.north lt 0) then
    !!view3DFromTo.y1O.select('RTEXT', '-')
  else
    !!view3DFromTo.y1O.select('RTEXT', '')
  endif

  if(!fromPos.up lt 0) then
    !!view3DFromTo.z1O.select('RTEXT', '-')
  else
    !!view3DFromTo.z1O.select('RTEXT', '')
  endif

  ---------------------------------
  -- 'To' SET OF SELECTOR GADGETS
  ---------------------------------

  if(!toPos.east lt 0) then
    !!view3DFromTo.x2O.select('RTEXT', '-')
  else
    !!view3DFromTo.x2O.select('RTEXT', '')
  endif

  if(!toPos.north lt 0) then
    !!view3DFromTo.y2O.select('RTEXT', '-')
  else
    !!view3DFromTo.y2O.select('RTEXT', '')
  endif

  if(!toPos.up lt 0) then
    !!view3DFromTo.z2O.select('RTEXT', '-')
  else
    !!view3DFromTo.z2O.select('RTEXT', '')
  endif

endfunction
-- End of function definition for !!viewShowFT
