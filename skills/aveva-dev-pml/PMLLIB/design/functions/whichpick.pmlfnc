--
-- Description:
-- function to highlight which button chosen on
-- the form for picking purposes
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [Gadget calling this function]
--   [2] [R]    [BOOLEAN]   [Grey spec selection out]
--   [3] [R]    [BOOLEAN]   [Is function called from angle or direction gadget]
--   [4] [R]    [STRING]    [Colour of gadget]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!whichPick(!gadget is GADGET, !active is BOOLEAN,!dummyFromVec is BOOLEAN,!colour is STRING)

-- set normal button as default
   if(!!aslSpec.whichPick.unset()) then
      !!aslSpec.whichPick = !!aslSpec.ptNrm
   endif

    !!aslSpec.whichPick.background = 205
    !!aslSpec.whichPick            = !gadget
    !!aslSpec.whichPick.background = !colour
    !!specStatus(!active,false)

-- Grey out the Picking type gadget
   if(!active.not()) then
      !!aslSpec.topOrBot.active = false
   else
      !!aslSpec.topOrBot.active = true
   endif

endfunction
-- End of function definition for !!whichPick
