------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  $(
  frame .accessToolbar toolbar 'ASL Modeller Toolbar'
  exit
  !!appTbarCntrl.addToolbar('accessToolbar', 'ACCESS')
  $)
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('PLATFORM')
  !menu.add('MENU', |Corner|, 'PCORN', 'Corner')
  !menu.add('MENU', |Rectangular|, 'PRECT', 'Rectangular')
  !menu.add('MENU', |Return Access|, 'PRETU', 'ReturnAccess')
  !menu.add('MENU', |Walkway|, 'PWALK', 'Walkway')
  !menu.add('MENU', |Floorplate|, 'PFLOU', 'Floorplate')
  !menu.add('MENU', |Circular|, 'PCIRC', 'Circular')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PCORN')
  !menu.add('FORM', |Define...|, 'CDWWCR', 'Define')
  !menu.add('FORM', |On ID Sections...|, 'CDWWCROS', 'OnIDSections')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PRECT')
  !menu.add('FORM', |Define...|, 'CDPLTF', 'Define')
  !menu.add('FORM', |On ID Sections...|, 'CDPLTFOS', 'OnIDSections')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PRETU')
  !menu.add('FORM', |Define...|, 'CDWWRR', 'Define')
  !menu.add('FORM', |On ID Sections...|, 'CDWWRROS', 'OnIDSections')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PWALK')
  !menu.add('FORM', |Define...|, 'CDWW', 'Define')
  !menu.add('FORM', |On ID Sections...|, 'CDWWOS', 'OnIDSections')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PFLOU')
  !menu.add('FORM', |Define...|, 'CDFPLATE', 'Define')
  !menu.add('FORM', |On ID Sections...|, 'CDFPLATEO', 'OnIDSections')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PCIRC')
  !menu.add('FORM', |Round...|, 'CDCH', 'Round')
  !menu.add('FORM', |Six Sides...|, 'CDCISIX', 'SixSides')
  !menu.add('FORM', |Eight Sides...|, 'CDCIEIGHT', 'EightSides')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('STAIR')
  !menu.add('MENU', |Top Flight|, 'STF', 'topflight')
  !menu.add('MENU', |Bottom Flight|, 'SBF', 'bottomflight')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('STF')
  !menu.add('FORM', |Height & Angle...|, 'CDSTAIRT', 'HeightAngle')
  !menu.add('FORM', |Height & Length...|, 'CDSTAIRTL', 'HeightLength')
  !menu.add('FORM', |FFL to FFL...|, 'CDSTAIRPP', 'FFLtoFFL')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('SBF')
  !menu.add('FORM', |Height & Angle...|, 'CDSTAIRB', 'HeightAngle')
  !menu.add('FORM', |Height & Length...|, 'CDSTAIRBL', 'HeightLength')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('LADDER')
  !menu.add('FORM', |Step...|, 'CDSTEPLAD', 'Step')
  !menu.add('FORM', |Front Exit...|, 'CDLADDFE', 'FrontExit')
  !menu.add('MENU', |Side Exit|, 'LADDSE', 'SideExit')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('LADDSE')
  !menu.add('FORM', |Single...|, 'CDLADDSSE', 'Single')
  !menu.add('FORM', |Double...|, 'CDLADDDSE', 'Double')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('POSTS')
  !menu.add('FORM', |Between Handrail Ends...|, 'CDPOSTBE', 'betweenHandrailEnds')
  !menu.add('FORM', |Between Posts...|, 'CDPOSTBP', 'BetweenPosts')
  !menu.add('FORM', |Between End and Post...|, 'CDPOSTEP', 'BetweenEndandPost')
  !menu.add('FORM', |At Explicit...|, 'CDPOSTPE', 'AtExplicit')
  !menu.add('CALLBACK', |At P-Point|, |CALLAC MPOSTP|, 'AtP-Point')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('CPOSTS')
  !menu.add('FORM', |At Explicit Corner...|, 'CDCPOST', 'AtExplicitCorner')
  !menu.add('CALLBACK', |On Floorplate|, |CALLAC MPOSTF|, 'OnFloorplate')
  !menu.add('CALLBACK', |At Intersection of Rails|, |CALLAC MPOSTI|, 'AtIntersectionofRails')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PJOINTS')
  !menu.add('CALLBACK', |Ball|, |CALLAC MJOINTB|, 'Ball')
  !menu.add('CALLBACK', |Cone|, |CALLAC MJOINTC|, 'Cone')
  !menu.add('CALLBACK', |Tee|, |CALLAC MJOINTT|, 'Tee')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('RAILS')
  !menu.add('CALLBACK', |Only|, |CALLAC MRAIL|, 'Only')
  !menu.add('FORM', |Closure...|, 'CDCLOS', 'Closure')
  !menu.add('CALLBACK', |End Pad|, |CALLAC MPAD|, 'EndPad')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('KICKP')
  !menu.add('FORM', |Along Floorplate Edge...|, 'CDKICKPL', 'AlongFloorplateEdge')
  !menu.add('FORM', |Along Edge with Cut Out...|, 'CDKICKPLC', 'AlongEdgewithCutOut')
  !menu.add('FORM', |Around Floorplate...|, 'CDKICKR', 'AroundFloorplate')
  !menu.add('FORM', |Between Posts...|, 'CDKICKP', 'BetweenPosts')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('FLOORP')
  !menu.add('MENU', |Circular|, 'FCIRC', 'Circular')
  !menu.add('MENU', |Square|, 'FSQUA', 'Square')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('FCIRC')
  !menu.add('FORM', |ID Cursor...|, 'CDFLCLCC', 'IDCursor')
  !menu.add('FORM', |Explicit...|, 'CDFLCLCE', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('FSQUA')
  !menu.add('FORM', |ID Cursor...|, 'CDFLRLCC', 'IDCursor')
  !menu.add('FORM', |Explicit...|, 'CDFLCLSE', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('MENU', |Move|, 'MOVE', 'Move')
  !menu.add('MENU', |Drag|, 'DRAG', 'Drag')
  !menu.add('MENU', |Plane Move|, 'PLMOVE', 'PlaneMove')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Reference Point|, |CALLAC MPOSRP|, 'ReferencePoint')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('MOVE')
  !menu.add('FORM', |Distance...|, 'CDMOVEDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDMOVETHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDMOVECLE', 'Clearance')
  !menu.add('FORM', |Towards...|, 'CDMOVETO', 'Towards')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('DRAG')
  !menu.add('FORM', |Distance...|, 'CDDRAGDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDDRAGTHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDDRAGCLE', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PLMOVE')
  !menu.add('FORM', |Distance...|, 'CDMOPLDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDMOPLTHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDMOPLCLE', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('CONN')
  !menu.add('MENU', |Primitive|, 'PCONN', 'Primitive')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Reference Point|, |CALLAC MPOSRPC|, 'accessReferencePoint')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('PCONN')
  !menu.add('CALLBACK', |ID Point|, |CALLE MCONN|, 'IDPoint')
  !menu.add('FORM', |Explicit...|, 'CDCONNE', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('SLIDE')
  !menu.add('CALLBACK', |To P-Point|, |CALLAC MSLIDE|, 'ToPpoint')
  !menu.add('CALLBACK', |To Pline|, |CALLAC MSLIDEP|, 'ToPline')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('SJOINT')
  !menu.add('CALLBACK', |Torus to Cylinder|, |CALLAC MSJOIN|, 'TorustoCylinder')
  !menu.add('CALLBACK', |Cylinder to Torus|, |CALLAC MSJOINB|, 'CylindertoTorus')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('STRETCH')
  !menu.add('CALLBACK', |All Sides...|, |CALLAC ISTALL|, 'AllSides')
  !menu.add('CALLBACK', |ID P-Point...|, |CALLAC ISTIDP|, 'IDPpoint')
  !menu.add('CALLBACK', |To P-Point|, |CALLAC ISTTPP|, 'ToPpoint')
  !menu.add('CALLBACK', |To Pline|, |CALLAC ISTTPL|, 'ToPline')
  !menu.add('CALLBACK', |Clearance to P-Point...|, |CALLAC ISTCLE|, 'ClearancetoPpoint')
  !menu.add('CALLBACK', |Clearance to Pline...|, |CALLAC ISTCLP|, 'ClearancetoPline')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('MODORI')
  !menu.add('MENU', |Structure|, 'MODORIT', 'Structure')
  !menu.add('MENU', |Substructure|, 'MODORIU', 'Substructure')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('MODORIT')
  !menu.add('CALLBACK', |ID P-Point|, |CALLAC MMODORII STRU|, 'IDP-Point')
  !menu.add('FORM', |Explicit...|, 'CDSTRUORI', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')

  !menu = object APPMENU('MODORIU')
  !menu.add('CALLBACK', |ID P-Point|, |CALLAC MMODORII SUBS|, 'IDP-Point')
  !menu.add('FORM', |Explicit...|, 'CDSUBSORI', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'ACCESS')


endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  -- !this.displayMenu()
  -- !this.graphMenu()
  -- !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  -- !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
