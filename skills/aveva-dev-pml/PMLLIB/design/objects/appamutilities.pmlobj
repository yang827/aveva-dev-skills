------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

!mod = !!module()
if (!mod.modkey neq 'marodes') then
   return
endif

 frame .pipeUtilitiesToolbar toolbar 'Pipe Utilities'


   -- draw branch
    !pixmap = !!pml.getPathName('drawbranch.png')
    button .drawBranch       tooltip '2D Pipe Sketching'                      pixmap "$!<pixmap>" width 16 height 16 callback '!!pipeeasyeditor()'

    -- Below button will be activated only if productionChecksEnabled is true.
    -- ( Fixed : #95494)
    !!pipeSetProductionCheckOption()
    if (!!productionChecksEnabled) then
      -- create pipe spool drawing
      !pixmap = !!pml.getPathName('createpipespooldwg.png')
      button .createPipeSpoolDwg  tooltip 'Create Pipe Spool Drawing'       pixmap "$!<pixmap>" width 16 height 16 callback '!!pipeSpooldrawing()'
    endif

    --!pixmap = !!pml.getPathName('stubintee.png')
   -- button .createStubin  tooltip 'Connect Stubin Branch'       pixmap "$!<pixmap>" width 16 height 16 callback 'show !!pipeStubin'
    -- pipe Dim
    !pixmap = !!pml.getPathName('distancedirection24.png')
    button .pipeDim tooltip 'Show Pipe Dimensions' pixmap "$!<pixmap>" width 16 height 16 callback |!!pipemarkdimension()|

    -- pipe Dim
    !pixmap = !!pml.getPathName('delmodeldim.png')
    button .pipeDimClear tooltip 'Clear Pipe Dimensions' pixmap "$!<pixmap>" width 16 height 16 callback |Aid Clear all|

  exit

  !!appTbarCntrl.addToolbar('pipeUtilitiesToolbar','PIPE')

endmethod
-- End of method definition for .toolbars()

