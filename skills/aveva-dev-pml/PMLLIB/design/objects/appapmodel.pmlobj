--
--  Description:     Add-in Object for ImPLANT-MCAD import
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appAPModel()                     -                   Constructor method
--  initialise()                     -                   initialisation for ImPLANT-MCAD GUI
--  modifyMenus()                    -                   Add ImPLANT-MCAD functions to Equipment application menus
--
------------------------------------------------------------------------
define object APPAPMODEL
endobject
-- End of object definition for appAPModel

------------------------------------------------------------------------
--
-- Method:      .appAPModel()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appAPModel()
  -- create global variable !!appAPModel so that methods of this object can be called from elsewhere
  !!appAPModel = !this
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Add ImPLANT-MCAD functions to Equipment application menus
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  -- add option to menu in Equipment app
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', |MEI Import|, 'show !!equImportManager', 'importModelEqui')
  !menu.add('CALLBACK', |MEI Export|, 'show !!meiExport', 'exportModelEqui')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  -- Equipment application create menu
  !menu = object APPMENU('sysCrt')
  !menu.add('CALLBACK', |Copy Mechanical Equipment Model...|, |show !!equCopyModel|, 'equiCopyModel')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation for ImPLANT-MCAD GUI
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- load up ImPLANT-MCAD forms etc. if this is the first time it's loaded
  !this.modifyMenus()

endmethod
-- End of method definition
