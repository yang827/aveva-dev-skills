endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .cablToolbar toolbar 'Cable Trays Toolbar'
  --  para _SPEC at xmax_LIST ymin text |Specification : Not Set| width 40 lines 1
    !iconSize = !!comSysOpt.iconSize()
    -- current spec
    !specPixmap = !!pml.getPathName('cablspec' & !iconSize & '.png')
    button .cablSpecSel tooltip 'Set Default Cable Tray Specification' pixmap "$!<specPixmap>" width $!<iconSize> height $!<iconSize> callback |show _CDCTSPEC|
    text   .cablSpec    tooltip 'Default Cable Tray Specification' width 25 string
    !!appDesMain.cablSpec.setEditable(false)
  exit
  !!appTbarCntrl.addToolbar('cablToolbar', 'CABL')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('CALLBACK', |Move...|, |!!dragMoveForm(false,'')|, 'Move')
  !menu.add('CALLBACK', |Drag...|, |!!dragMoveForm(true,'')|, 'Drag')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Branch|, 'BRANPOS', 'Branch')
  !menu.add('MENU', |Component|, 'COMPPOS', 'Component')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('BRANPOS')
  !menu.add('FORM', |General...|, 'CDBRATG', 'General')
  !menu.add('FORM', |Distance...|, 'CDBRPOSDI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDBRPOSTH', 'Through')
  !menu.add('CALLBACK', |Move...|, |!!dragMoveForm(false,'BRANCH')|, 'Move')
  !menu.add('CALLBACK', |Drag...|, |!!dragMoveForm(true,'BRANCH')|, 'Drag')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('COMPPOS')
  !menu.add('FORM', |Distance...|, 'CDDIST', 'Distance')
  !menu.add('FORM', |Through...|, 'CDTHRO', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDCLEA', 'Clearance')
  !menu.add('FORM', |Plane Through...|, 'CDPLANE', 'PlaneThrough')
  !menu.add('FORM', |Plane Clearance...|, 'CDPLANECL', 'PlaneClearance')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Component|, 'ORICOMP', 'Component')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('ORICOMP')
  !menu.add('CALLBACK', |Swap Branch|, |CALLC MSWAPB|, 'SwapBranch')
  !menu.add('CALLBACK', |Change Exit|, |CALLC MMODEXP|, 'ChangeExit')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('CONN')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Branch...|, 'CDCONNCTB', 'cablBranch')
  !menu.add('MENU', |Component|, 'CONNCOMP', 'cablComponent')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('CONNCOMP')
  !menu.add('CALLBACK', |To Previous|, |CALLC MCONPCTC|, 'ToPrevious')
  !menu.add('CALLBACK', |To Next|, |CALLC MCONNCTC|, 'ToNext')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('REORDER')
  !menu.add('FORM', |Before/After...|, 'CDREOAFT', 'Before/After')
  !menu.add('CALLBACK', |Reverse|, |CALLG MREOREV|, 'Reverse')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('MODCABLCOMP')
  !menu.add('FORM', |Route...|, 'CDMODCTR', 'Route')
  !menu.add('CALLBACK', |Connection Ref.|, |CALLG IUCONN|, 'ConnectionRef')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('MODMAIN')
  !menu.add('FORM', |Specification...|, 'CDMODCTPS', 'cablSpecification')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('MODCABLBRAN')
  !menu.add('FORM', |Explicit...|, 'CDCTBRAT', 'Explicit')
  !menu.add('FORM', |Specification...|, 'CDMODCTBS', 'Specification')
  !menu.add('FORM', |Reselect...|, 'CDMODBRRE', 'Reselect')
  !!appMenuCntrl.addMenu(!menu, 'CABL')


endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
