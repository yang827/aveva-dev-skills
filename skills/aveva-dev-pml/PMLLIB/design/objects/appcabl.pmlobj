-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !!appMenuCntrl.addMenu(!menu, 'CABL')
endmethod
-- End of method definition for .queryMenu()

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Default Spec...|, |SHOW _CDCTSPEC|, 'cablDefaultSpec')
  !menu.add('FORM', |Choose Options...|, 'CDCHOOSEO', 'cablChooseOptions')
  !!appMenuCntrl.addMenu(!menu, 'CABL')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Import Cable Tray Data...', |!!pipeLoadCsv()|, 'CableTrayCsvImport')
  !menu.add('CALLBACK', 'Cable Trays...', |CALLG XUTILITIES $$<Cable Trays$$> $$<CABL$$> $$<DES$$>|, 'CableTraysUtil')
  !!appMenuCntrl.addMenu(!menu, 'CABL')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Main...|, 'CDCTPIPE', 'cablMain')
  !menu.add('FORM', |Branch...|, 'CDCTBRAN', 'cablBranch')
  !menu.add('FORM', |Components...|, 'CDCTCOMP', 'cablComponents')
  !!appMenuCntrl.addMenu(!menu, 'CABL')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Main|, 'MODMAIN', 'cablMain')
  !menu.add('MENU', |Branch|, 'MODCABLBRAN', 'cablBranch')
  !menu.add('MENU', |Component|, 'MODCABLCOMP', 'cablComponent')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Fill...|, 'CDFILL', 'cablFill')
  !menu.add('FORM', |Unfill...|, 'CDUNFILL', 'cablUnfill')
  !!appMenuCntrl.addMenu(!menu, 'CABL')
endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
--
-- Method:      .deleteMenu()
--
-- Description: Adds options to the Delete menu
--
-- Method Type: Procedure
