--
--
-- Description:     Object for Cabling System application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPCABLINGSYSTEM
endobject
-- End of object definition for appcablingsystem

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Position|, 'POSITION')
  !bmenu.add(|Orientate|, 'ORI')
--  !bmenu.add(|Connect|, 'CONN')
  !!appMenuCntrl.addBarMenu(!bmenu, 'CABLINGSYSTEM')
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('sysView')
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')
endmethod
-- End of method definition for .displayMenu()

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('sysGph')
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')
endmethod
-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |List of Cables...|, |show !!cbllistcables|, 'CblListCables')
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

endmethod
-- End of method definition for .queryMenu()

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Cabling Defaults...|, |show !!cbldflts|, 'cablDefault')
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Cabling System...', |CALLG XUTILITIES $$<Cabling System$$> $$<CABL$$> $$<DES$$>|, 'CablingSystemUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Branch Tasks...', |!!cblbranchtasks()|, 'CWBRANTASKS')
  !menu.add('CALLBACK', 'Check Branch Connections...', |show !!cblconnections|, 'CblCheckIntegrity')
  !menu.add('CALLBACK', 'Split Branches...', |show !!cblsplitbranch|, 'CblSplit')
  !menu.add('CALLBACK', 'Merge Branches...', |!!cblmergebranches()|, 'CblMergeBranch')
  !menu.add('CALLBACK', 'Connect Branches...', |!!cblconnectbranches()|, 'CblConnectBranch')
  !menu.add('CALLBACK', 'Disconnect Branches...', |!!cbldisconnectbranches()|, 'CblDisconnectBranch')
  !menu.add('CALLBACK', 'Reverse Branch...', |!!cblreversebranch()|, 'CblReverseBranch')
  !menu.add('CALLBACK', 'Disconnect Equipment...', |!!equiconn()|, 'equidisconn')
  !menu.add('CALLBACK', 'Import Cables...', |!!cableloadcsv()|, 'CblCableImport')
  !menu.add('CALLBACK', 'Export Cables...', |SHOW !!cableExport|, 'CblCableExport')
  !menu.add('CALLBACK', 'Cable Data...', |SHOW !!cblcableRouting|, 'CblCableRouting')
  !menu.add('CALLBACK', 'Mark Route Nodes...', |SHOW !!cblMarkRouteNodes|, 'CblMarkRouteNodes')
  !menu.add('CALLBACK', 'CableTrays Volumes...', |SHOW !!cblCableTrayVolumes|, 'cblCableTrayVolumes')
  !menu.add('CALLBACK', 'Fill Level Check...', |SHOW !!cblcwayfilllevelcheck|, 'cblCwayFillLevelCheck')

  !cableexist   = object MDRLICENCEMANAGER()
  if !cableexist.hascablinglicence('CABLES').not() then
   !menu.menu.setFieldProperty('CblCableImport', 'active', FALSE)
   !menu.menu.setFieldProperty('CblCableRouting', 'active', FALSE)
  endif

  !menu.add(|SEPARATOR|)
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.removeSystem('Copy')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Cableway...', |!!cblinit('Create','CWAY','!!cblcway')|, 'Cblcreatecway')
  !menu.add('CALLBACK', 'Cableway Branch...', |!!cblinit('Create','CWBRAN','!!cblcway')|, 'Cblcreatecwbran')
  !menu.add('MENU', 'Branch Elements', |CWBRANELEMENTS|, 'Cblcwbranelements')
  !menu.add('MENU', 'Material', |CWMATERIAL|, 'Cblcreatecwmtrl')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Control Node...', |!!cblinit('Create','CNODE','!!cblcnode')|, 'Cblcreatecnode')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Cable...', |!!cblinit('Create','CABLE','!!cblcable')|, 'Cblcreatecable')
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Copy', |COPYCABLE|, 'Cblcopy')
  !cableexist   = object MDRLICENCEMANAGER()
  if !cableexist.hascablinglicence('CABLES').not() then
  !menu.menu.setFieldProperty('Cblcreatecable', 'active', FALSE)
  endif
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')


endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Cableway...', |!!cblinit('Modify','CWAY','!!cblcway')|, 'Cblmodifycway')
  !menu.add('CALLBACK', 'Cableway Branch...', |!!cblinit('Modify','CWBRAN','!!cblcway')|, 'Cblmodifycwbran')
  !menu.add('MENU', 'Branch Elements', |MCWBRANELEMENTS|, 'Cblcwbranelementsmodify')
  !menu.add('CALLBACK', 'Cableway Segment...', |show !!cblmovesegment|, 'Cblcwbransectionmodify')
  !menu.add('MENU', 'Material', |MCWMATERIAL|, 'Cblmodifycwmtrl')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Control Node...', |!!cblinit('Modify','CNODE','!!cblcnode')|, 'Cblmodifycnode')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Cable...', |!!cblinit('Modify','CABLE','!!cblcable')|, 'Cblmodifycable')

  !cableexist   = object MDRLICENCEMANAGER()
  if !cableexist.hascablinglicence('CABLES').not() then
   !menu.menu.setFieldProperty('Cblmodifycable', 'active', FALSE)
  endif

  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')
endmethod
-- End of method definition for .modifyMenu()

