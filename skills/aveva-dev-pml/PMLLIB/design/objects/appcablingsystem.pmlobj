------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  frame .cablingsystemtoolbar toolbar 'Cabling System Toolbar'
    !iconSize = !!comSysOpt.iconSize()

    !icon     = !!pml.getPathName('cblcrecway16.png')
    button .cblcrecway tooltip 'Create Cableway'  pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Create','CWAY','!!cblcway')|

    !icon     = !!pml.getPathName('cblcrecwbr16.png')
    button .cblcrecwbr tooltip 'Create Cableway Branch' pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Create','CWBRAN','!!cblcway')|

    !icon     = !!pml.getPathName('cblmodcwbr16.png')
    button .cblmodcwbr tooltip 'Modify Cableway Branch'        pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Modify','CWBRAN','!!cblcway')|

    !icon     = !!pml.getPathName('cblcrecabl16.png')
    button .cblcrecabl tooltip 'Create Cable'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Create','CABLE','!!cblcable')|

    !icon     = !!pml.getPathName('cblmodcabl16.png')
    button .cblmodcabl tooltip 'Modify Cable'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Modify','CABLE','!!cblcable')|

    !icon     = !!pml.getPathName('cblcremat16.png')
    button .cblcremat tooltip 'Create Cableway Material'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Create','CTMTRL','!!cblmtrl')|

    !icon     = !!pml.getPathName('cblmodmat16.png')
    button .cblmodmat tooltip 'Modify Cableway Material'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('Modify','CTMTRL','!!cblmtrl')|

    !icon     = !!pml.getPathName('cblcopcabl16.png')
    button .cblcopcabl tooltip 'Copy Cable'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('','','!!cblcablecopy')|

    !icon     = !!pml.getPathName('cblcopele16.png')
    button .cblcopele tooltip 'Copy Cableway Element'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('','','!!cblcwaycopy')|

    !icon = !!pml.getPathName('cablspec16.png')
    button .cblspec tooltip 'Cabling Defaults' pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!cblinit('','','!!cbldflts')|

  exit

  !!appTbarCntrl.addToolbar('CablingSystemToolbar', 'CABLINGSYSTEM')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
    !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
     !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('COPYCABLE')
  !menu.add('CALLBACK', |Cableway Elements...|, |!!cblinit('','','!!cblcwaycopy')|, 'Cwaycopy')
  --!cableexist   = object MDRLICENCEMANAGER()
  --if !cableexist.hascablinglicence('CABLES') then
   !menu.add('CALLBACK', |Cable Elements...|, |!!cblinit('','','!!cblcablecopy')|, 'Cablecopy')
  --endif

  !cableexist   = object MDRLICENCEMANAGER()
  if !cableexist.hascablinglicence('CABLES').not() then
   !menu.menu.setFieldProperty('Cablecopy', 'active', FALSE)
  endif
      !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('CWBRANELEMENTS')
  !menu.add('CALLBACK', 'Route Point...', |!!cblinit('Create','POINTR','!!cblcway')|, 'Cblcreatepointr')
  !menu.add('CALLBACK', 'Route Node...', |!!cblinit('Create','RNODE','!!cblcway')|, 'Cblrnod')
  !menu.add('CALLBACK', 'Route Attachment Point...', |!!cblinit('Create','RATTA','!!cblcway')|, 'Cblratta')
  --!menu.add('CALLBACK', 'Material...', |!!cblinit('Create','CTMTRL','!!cblmtrl')|, 'Cblcreatecwmtrl')
  --!menu.add('CALLBACK', 'Material Elements...', |!!cblinit('Create','COMPONENTS','!!cblmtrl')|, 'Cblcreatecwmtrlcomp')
      !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('CWMATERIAL')
  !menu.add('CALLBACK', 'Main...', |!!cblinit('Create','CTMTRL','!!cblmtrl')|, 'Cblcreatemain')
  !menu.add('CALLBACK', 'Elements...', |!!cblinit('Create','COMPONENTS','!!cblmtrl')|, 'Cblcreatecomp')
      !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('MCWBRANELEMENTS')
  !menu.add('CALLBACK', 'Route Point...', |!!cblinit('Modify','POINTR','!!cblcway')|, 'Cblmodifypointr')
  !menu.add('CALLBACK', 'Route Node...', |!!cblinit('Modify','RNODE','!!cblcway')|, 'Cblmodifyrnode')
  !menu.add('CALLBACK', 'Route Attachment Point...', |!!cblinit('Modify','RATTA','!!cblcway')|, 'Cblmodifyratta')
  --!menu.add('CALLBACK', 'Material...', |!!cblinit('Modify','CTMTRL','!!cblmtrl')|, 'Cblmodifycwmtrl')
      !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('MCWMATERIAL')
  !menu.add('CALLBACK', 'Main...', |!!cblinit('Modify','CTMTRL','!!cblmtrl')|, 'Cblmodifymain')
  !menu.add('CALLBACK', 'Elements...', |!!cblinit('Modify','COMPONENTS','!!cblmtrl')|, 'Cblmodifycomp')
  --!menu.add('CALLBACK', 'Element...', |!!cblinit('','','!!cblmodtmpl')|, 'Cblmodifytmpl')
      !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  --!menu = object APPMENU('SPLITBRANCH')
  --!menu.add('CALLBACK', |Split on Point...|, |!!cblsegmentsplit('POINT')|, 'Splitpoint')
  --!menu.add('CALLBACK', |Split on Segment...|, |!!cblsegmentsplit('SEGMENT')|, 'Splitsegment')
  --    !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')



  --!menu = object APPMENU('CWAYRPATH')
  --!menu.add('CALLBACK', |Route Point...|, |!!cblinit('Modify','POINTR','!!cblcway')|, 'pointrmodify')
  --!menu.add('CALLBACK', |Curve...|, |!!cblinit('Modify','CURVE','!!cblcway')|, 'curvemodify')
  --!menu.add('CALLBACK', |External Geometry...|, |!!cblinit('Modify','EXGEO','!!cblcway')|, 'extgeomodify')
  --!menu.add('CALLBACK', |Route Section...|, |!!cblinit('Modify','EXGEO','!!cblcway')|, 'rsectmodify')
      !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')



endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
