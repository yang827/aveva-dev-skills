endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .civilToolbar toolbar 'Walls && Floors Toolbar'
    !iconSize = !!comSysOpt.iconSize()
    $(

    already created in another app
    -- Switching Applications
    !stlPixmap = !!pml.getPathName('stlwrkapp' & !iconSize & '.png')
    !stlIPixmap = !!pml.getPathName('stlwrkappi' & !iconSize & '.png')
    !pltPixmap = !!pml.getPathName('panelapp' & !iconSize & '.png')
    !pltIPixmap = !!pml.getPathName('panelappi' & !iconSize & '.png')
    !civPixmap = !!pml.getPathName('civilapp' & !iconSize & '.png')
    !civIPixmap = !!pml.getPathName('civilappi' & !iconSize & '.png')
    button _BBANDC tooltip 'Beams & Columns Application' pixmap sel "$!<stlPixmap>" inact "$!<stlIPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLIB XAPPLOAD DES STLWRK _CDSTLAPP $<$> true false $<Beams & Columns$>|
    button _BPANDP tooltip 'Panels & Plates Application' pixmap sel "$!<pltPixmap>" inact "$!<pltIPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLIB XAPPLOAD DES PANEL _CDPLTAPP $<$> true false $<Panels & Plates$>|
    button _BFANDW tooltip 'Walls & Floors Application' pixmap sel "$!<civPixmap>" inact "$!<civIPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLIB XAPPLOAD DES CIVIL _CDCIVAPP $<$> true false $<Walls & Floors$>|
    $)

    -- Default Specifications
  -- default material selection removed (6/7/98)
  --   !bmatPixmap = !!PML.getPathName('materialspec' & !iconSize & '.png')
  --   button .bMat tooltip 'Set Default Material Specification' pixmap "$!<bmatPixmap>" width $!<iconSize> height $!<iconSize> form !!SctlMaterial
  --   text   .material tooltip 'Default Material Specification' width 10 string
  --   !!cdCivApp.material.setEditable(false)
  --   !!cdCivApp.material.val = 'Unset'
    !bwallPixmap = !!pml.getPathName('wallspec' & !iconSize & '.png')
    button .bWallSpec tooltip 'Set Default Wall Specification' pixmap "$!<bwallPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLCIV XWALLSPEC DFLT|
    text   .wallSpec tooltip 'Default Wall Specification' width 20 string
    !!appDesMain.wallSpec.setEditable(false)
    !!appDesMain.wallSpec.val = 'Unset'
    !bfloPixmap = !!pml.getPathName('floorspec' & !iconSize & '.png')
    button .bFloSpec tooltip 'Set Default Floor/Screed Specification' pixmap "$!<bfloPixmap>" width $!<iconSize> height $!<iconSize> callback |!!pltSpecification('FLOOR')|
    text   .floorSpec tooltip 'Default Floor/Screed Specification' width 20 string
    !!appDesMain.floorSpec.setEditable(false)
    !!appDesMain.floorSpec.val = 'Unset'
    -- Storage Areas
    --!wallsPixmap = !!PML.getPathName('wallstorage' & !iconSize & '.png')
    --button .bWall tooltip 'Set Wall Storage Area' pixmap "$!<wallsPixmap>" width $!<iconSize> height $!<iconSize>
    --text   .wall tooltip 'Wall Storage Area' width 15 string
    --!!cdCivApp.wall.setEditable(false)
    --!!cdCivApp.wall.val = 'Unset'
    --!floorsPixmap = !!PML.getPathName('floorstorage' & !iconSize & '.png')
    --button .bFloor tooltip 'Set Floor Storage Area' pixmap "$!<floorsPixmap>" width $!<iconSize> height $!<iconSize>
    --text   .floor tooltip 'Floor Storage Area' width 15 string
    --!!cdCivApp.floor.setEditable(false)
    --!!cdCivApp.floor.val = 'Unset'
  exit
  !!appTbarCntrl.addToolbar('civilToolbar', 'CIVIL')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  --  $* -------------------- Create Menu --------------------
  --    $* Create composite elements
  !menu = object APPMENU('CRTCPST')
  !menu.add('CALLBACK', |Wall...|, |CALLG XCRTPURP CWALL $$<Create Compound Wall$$>|, 'Wall')
  !menu.add('CALLBACK', |Floor...|, |CALLG XCRTPURP CFLOOR $$<Create Compound Floor$$>|, 'Floor')
  !menu.add('CALLBACK', |Screed...|, |CALLG XCRTPURP CSCREE $$<Create Compound Screed$$>|, 'Screed')
  !menu.add('SEPARATOR')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --    $* Create Wall
  !menu = object APPMENU('CRTWALL')
  !menu.add('CALLBACK', |Straight...|, |!!stlSection.createWall()|, 'Straight')
  !menu.add('CALLBACK', |Ring...|, |!!strRingCreate.createWall()|, 'Ring')
  !menu.add('CALLBACK', |User Defined...|, |!!pltCreate('GWall', 'WANDF', 'WALL', '')|, 'UserDefined')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --    $* Create Wall Fittings
  !menu = object APPMENU('CRTWALLFITT')
       -- The single fitting may be a PFIT or FITT depending on the current element
  !menu.add('CALLBACK', |Standard...|, |call !!displayspecsel('WFIT', 'CREATE')|, 'Standard')
  !menu.add('CALLBACK', |Compound...|, |call !!displayspecsel('WFIT', 'CREATEC')|, 'Compound')
  !menu.add('CALLBACK', |Sub-Compound...|, |call !!displayspecsel('WFIT', 'CREATES')|, 'Sub-Compound')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --    $* Create Floor Fittings
  !menu = object APPMENU('CRTFLOORFITT')
  !menu.add('CALLBACK', |Standard...|, |call !!displayspecsel('FFIT', 'CREATE')|, 'Standard')
  !menu.add('CALLBACK', |Compound...|, |call !!displayspecsel('FFIT', 'CREATEC')|, 'Compound')
  !menu.add('CALLBACK', |Sub-Compound...|, |call !!displayspecsel('FFIT', 'CREATES')|, 'Sub-Compound')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --  $* -------------------- Modify Menu --------------------
  --    $* Modify Wall
  !menu = object APPMENU('MODWALL')
  !menu.add('CALLBACK', |Specification...|, |CALLCIV XWALLSPEC|, 'Specification')
  !menu.add('CALLBACK', |Definition...|, |call !!strSectionEdit(!!ce)|, 'Definition')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Justification...|, |CALLSTL XSETPLINE $<Wall Justification$> JUSL $<STWALL WALL$> $<STWALL WALL$> NULL $<Identify wall.$>|, 'Justification')
  !menu.add('CALLBACK', |Member Line...|, |CALLSTL XSETPLINE $<Wall Member Line$> MEML $<STWALL WALL$> $<STWALL WALL$> NULL $<Identify wall.$>|, 'MemberLine')
  !menu.add('CALLBACK', |Joint Line...|, |CALLSTL XSETPLINE $<Joint Line$> JLIN $<STWALL WALL$> $<STWALL WALL$> NULL $<Identify wall.$>|, 'JointLine')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Split...|, 'CDWSPLIT', 'Split')
  !menu.add('FORM', |Splice...|, 'CDWSPLICE', 'Splice')
  !menu.add('FORM', |Merge...|, 'CDWALLMERGE', 'Merge')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |CutPlane...|, |CALLSTL XCUTPLANE Wall|, 'CutPlane')
  !menu.add('CALLBACK', |Mitre Ends|, |!!cvWallCrMitre()|, 'MitreEnds')
  --     add |Straight to Curved|      |call !!strSctnToGensec('WALL')|
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --    $* Modify Floor/Screed
  !menu = object APPMENU('MODFLOOR')
  !menu.add('CALLBACK', |Specification...|, |call !!pltThickness('FLOOR', !!ce)|, 'Specification')
  !menu.add('CALLBACK', |Thickness...|, |CALLPLT XPLTTHK|, 'Thickness')
  !menu.add('CALLBACK', |Definition...|, |!!dbeLoopEdit(!!ce, 'FLOOR SCREED NXTR')|, 'Definition')
  !menu.add('CALLBACK', |Screed Slope...|, |call !!cvlSlopeScreed(!!ce)|, 'ScreedSlope')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Justification...|, |CALLPLT XSETSJUS|, 'Justification')
  !menu.add('FORM', |Representation...|, 'CDREPSET', 'Representation')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Split...|, |CALLPLT MPSPLIT|, 'Split')
  --     add |Fall...|                 |!!CvPanelSlopeShow()|
  --     add |Taper...|                form !!CvPanelTaper
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --    $* Modify Fitting
  !menu = object APPMENU('MODFITTING')
  !menu.add('CALLBACK', |Definition...|, |CALLSTL XFITSPEC MODIFY $<$> $<$> CIV|, 'Definition')
  !menu.add('CALLBACK', |Position Line...|, |CALLSTL XSETPLINE $<Position Line$> POSL $<FITT CMFI$> $<STWALL$> NULL $<Identify fitting$>|, 'PositionLine')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --   $* Joint Modification
     --menu _JOINT
       --add |Specification...|    |CALLSTL XJOINSPEC|
       --add |Position Line...|    |CALLSTL XSETPLINE $<Position Line$> POSL $<SJOI SCOJ SUBJ$> $<STWALL$> NULL $<Identify end of wall or joint.$>|
       --add |Joint Line...|       |CALLSTL XSETPLINE $<Joint Line$> JLIN $<SJOI SCOJ SUBJ$> $<SJOI SCOJ SUBJ$>  NULL $<Identify end of wall or joint.$>|
       --add |Joint Like|          menu _JLIKE
     --exit
      -- menu _JLIKE
         --add |Maintain Pline|    |CALLSTL MJOINLIKE true|
         --add |Use copied Pline|  |CALLSTL MJOINLIKE false|
       --exit
  --  $* -------------------- Position Menu --------------------
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.insertAfter('Explicitly', 'CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR $<Position Relatively$> $<CALLCIV$> $<XWALLMOVE$> $<$> $<$> $<$> |, 'civilRelatively')
  !menu.add('SEPARATOR')
       -- add |Elevation...|              |call !!cvElevationShow()|
  !menu.add('CALLBACK', |Floor/Screed Origin|, |CALLPLT MMOVEORIG|, 'FloorScreedOrigin')
  !menu.add('MENU', |Extend Wall|, 'EXTENDWALL', 'ExtendWall')
       -- Taken out for 11.2 bonus pack until a fuller solution done for 11.3
  --     add |Drag Explicitly...|        |CALLIBD X3DPOS $$<Drag Explicitly$$> CALLSTL MSCTNDRAG $$<$$> $$<$$> $$<$$>|
  !menu.add('CALLBACK', |Align Wall Connections|, |CALLSTL MNODEALIGN|, 'AlignWallConnections')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --     $* Extend Sections
  !menu = object APPMENU('EXTENDWALL')
  !menu.add('FORM', |Through...|, 'CDSCTNEXT', 'Through')
  !menu.add('FORM', |By...|, 'CDEXTSCTN', 'By')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --   $* ------------------ Orientate ------------------
  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !menu.add('SEPARATOR', 'civilOriSep')
  !menu.add('MENU', |B Angle|, 'BANG', 'BetaAngle')
  !menu.add('MENU', |Flip|, 'FLIP', 'Flip')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --     $* Flip Menu
  !menu = object APPMENU('FLIP')
  !menu.add('CALLBACK', |Wall|, |CALLCIV MFLIP CE|, 'Wall')
  !menu.add('CALLBACK', |Walls|, |CALLCIV MFLIP|, 'Walls')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --     $* Set Beta Angle
  !menu = object APPMENU('BANG')
  !menu.add('CALLBACK', |-180 Degrees|, |BANG -180|, '-180Degrees')
  !menu.add('CALLBACK', |-90 Degrees|, |BANG -90|, '-90Degrees')
  !menu.add('CALLBACK', |0 Degrees|, |BANG 0|, '0Degrees')
  !menu.add('CALLBACK', |90 Degrees|, |BANG 90|, '90Degrees')
  !menu.add('CALLBACK', |180 Degrees|, |BANG 180|, '180Degrees')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --   $* ------------------- Connections -------------------
  !menu = object APPMENU('CONN')
  !menu.add('CALLBACK', |Disconnect|, |CALLCIV MWALLDISC|, 'civilDisconnect')
  !menu.add('CALLBACK', |Wall to Wall|, |CALLCIV MWALLCONN|, 'civilWalltoWall')
  !menu.add('CALLBACK', |Wall Ends|, |call !!cvwallendend()|, 'civilWallEnds')
       --add |Floor to Wall/Floor...| form _CDFLTOOLB
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Trim|, 'WFTRIM', 'civilTrim')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  --     $* Disconnect
       --menu _WFDISC
         --add |Wall|         |CALLCIV MWALLDISC|
         --add |Floor|        |CALLCIV MFLDISC FLOOR|
         --add |Floor Edges|  |CALLCIV MFLDISC EDGES|
         --add |Floor Edge|   |CALLCIV MFLDISC EDGE|
         --add |Floor Vertex| |CALLCIV MFLDISC VERT|
       --exit
  --     $* Trim
  !menu = object APPMENU('WFTRIM')
  !menu.add('CALLBACK', |Connected Walls|, |call !!stlWrkTrim(false, false, true, '')|, 'Connected Walls')
  !menu.add('CALLBACK', |Wall End|, |call !!stlWrkTrim(false, false, false, '')|, 'WallEnd')
         --add |Floors|            |CALLPLT MFLTRIM|
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.settingsMenu()
  !this.queryMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
