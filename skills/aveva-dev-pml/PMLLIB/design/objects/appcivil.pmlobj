--
-- Description:     Object for Walls & Floors application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPCIVIL
endobject
-- End of object definition for APPCIVIL

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Position|, 'POSITION')
  !bmenu.add(|Orientate|, 'ORI')
  !bmenu.add(|Connect|, 'CONN')
  !!appMenuCntrl.addBarMenu(!bmenu, 'CIVIL')
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Walls & Floors...', |CALLG XUTILITIES $$<Walls & Floors$$> $$<CIVIL$$> $$<DES$$>|, 'WallsFloorsUtil')
      -- add |Walls & Floors ToolBar...|   |Show !!CvToolbar at xr 0 yr 1|
  -- if($!!CDLNPENE) then
  -- !menu.add('SEPARATOR')
  -- !menu.add('CALLBACK', |Penetrations...|, |CALLPEN XPENEAPP WALL $<Walls$>|, 'Penetrations')
  -- endif
     -- New A,S & L commented out until finished
     -- add |Access Stairs & Ladders...| |show !!AslMainMenu|
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Structure...|, |CALLG XCRTPURP STRU $$<Create Structure$$>|, 'Structure')
  !menu.insertAfter('Structure', 'CALLBACK', |Framework...|, |CALLG XCRTPURP FRMW $$<Create Framework$$>|, 'Framework')
  !menu.insertAfter('Framework', 'CALLBACK', |Sub-Frame...|, |CALLG XCRTPURP SBFR $$<Create Sub-Frame$$>|, 'SubFrame')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Compound|, 'CRTCPST', 'civilCompound')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Wall|, 'CRTWALL', 'civilWall')
  !menu.add('CALLBACK', |Floor...|, |!!pltCreate('Floor', 'WANDF', 'FLOOR', 'default-CIV-FLR')|, 'civilFloor')
  !menu.add('CALLBACK', |Screed...|, |!!pltCreate('Screed', 'WANDF', 'SCREED', 'default-CIV-FLR')|, 'civilScreed')
  !menu.add('FORM', |Trace Boundary...|, 'civtracefloor', 'civilTraceBoundary')
  !menu.add('FORM', |Negative Extrusion...|, 'dbeNExtrusion', 'civilNegativeExtrusion')
  !menu.add('MENU', |Wall Fitting|, 'CRTWALLFITT', 'civilWallFitting')
  !menu.add('MENU', |Floor Fitting|, 'CRTFLOORFITT', 'civilFloorFitting')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Wall|, 'MODWALL', 'civilWall')
  !menu.add('MENU', |Floor/Screed|, 'MODFLOOR', 'civilFloorScreed')
    --add |Joints|                  menu _JOINT
  !menu.add('CALLBACK', |Wall Fitting...|, |call !!displayspecsel('WFIT', 'MODIFY')|, 'civilWallFitting')
  !menu.add('CALLBACK', |Floor Fitting...|, |call !!displayspecsel('FFIT', 'MODIFY')|, 'civilFloorFitting')
  !menu.add('CALLBACK', |Negative Extrusion...|, |!!dbeLoopEdit(!!ce, 'NXTR')|, 'civilNegativeExtrusion')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Draft Edge Drawing...|, 'DesUnion', 'civilDraftEdgeDrawing')
  !menu.add('FORM', |Material...|, 'CDSETMATR', 'civilMaterial')
  --  add |Break Template|          |call !!GenDemolishTmpl(!!CE)|
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')
endmethod
-- End of method definition for .modifyMenu()

