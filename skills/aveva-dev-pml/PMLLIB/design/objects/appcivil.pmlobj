------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
   --add |Storage Areas...|     |show !!civStorageAreas|
  !menu.add('FORM', |Storage Areas...|, |civlevels|, 'civilStorageAreas')
  !menu.add('CALLBACK', |Wall Tolerances...|, |!!stlTolerances.edit()|, 'civilWallTolerances')
   --add |Wall Tolerances...|   form _CDSREFTOL
  !menu.add('FORM', |Floor Tolerances...|, 'CDPREFTOL', 'civilFloorTolerances')
   -- System settings
  if ($!!cdlndesadmin) then
    !menu.add('CALLBACK', |Draft Edge Defaults...|, |!!dradunion.edit()|, 'civilDraftEdgeDefaults')
  endif
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')
endmethod
-- End of method definition for .settingsMenu()

