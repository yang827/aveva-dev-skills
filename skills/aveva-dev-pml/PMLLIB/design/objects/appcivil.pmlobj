--
------------------------------------------------------------------------
define method .deleteMenu()
  !menu = object APPMENU('sysDel')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Tidy Wall Joints...|, 'CDDELJOIN', 'civilTidyWallJoints')
   --add |Tidy Floor Joints...|  form _CDDELLJOIN
  !menu.add('FORM', |Tidy Nodes...|, 'CDDELNODE', 'civilTidyNodes')
