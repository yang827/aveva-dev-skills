-- File:            appdtmp.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        design
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Thu Jan 29 15:54:31 2004
--
--
-- Description:     Object for Design Templates application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPDTMP
endobject
-- End of object definition for APPDTMP

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !!appMenuCntrl.addBarMenu(!bmenu, 'DTMP')
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('sysView')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .displayMenu()

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('sysGph')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Template Browser...|, 'CDTMPMEMB', 'TemplateBrowser')
  !menu.add('CALLBACK', 'Template Search...',|show !!tmplSearch|, 'DesignTemplatesSearch')
  !menu.add('FORM', |Template Properties...|, 'CDTMPPARA', 'TemplateProperties')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .queryMenu()

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Propagate Changes...',|!!tmplShowPropagate()|, 'DesignTemplatesPropagate')
  !menu.add('CALLBACK', 'Design Templates...', |CALLG XUTILITIES $$<Design Templates$$> $$<DTMP$$> $$<DES$$>|, 'DesignTemplatesUtil')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('CALLBACK', |Template World...|, |CALLTMP XTMPCRT TPWL|, 'dtmpCreateTemplateWorld')
  !menu.add('CALLBACK', |Template Area...|, |CALLTMP XTMPCRT TMAR|, 'dtmpCreateTemplateArea')
  !menu.add('CALLBACK', |Template...|, |CALLTMP XTMPTMP|, 'dtmpCreateTemplate')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Primitives...|, |!!genPrimitives('CREATE')|, 'dtmpCreatePrimitives')
  !menu.add('CALLBACK', |Nozzles...|, |CALLE XNOZZ NEW $<CALLE MNOZZ NEW$>|, 'dtmpCreateNozzles')
--  !menu.add('FORM', |Negative Extrusion...|, |dbeNExtrusion|, 'dtmpCreateNegativeExtrusion')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Property Definitions...|, |CALLTMP XDDSE true|, 'dtmpCreatePropertyDefinitions')
  !menu.add('CALLBACK', |Points...|, |CALLTMP XDPSE true|, 'dtmpCreatePoints')
  !menu.add('FORM', |Dimension Points ...|, 'tmpDptsCrt', 'dtmpCreateDimensionPoints')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Template World...|, |CALLTMP XTMPCRT TPWL false|, 'dtmpModTemplateWorld')
  !menu.add('CALLBACK', |Template Area...|, |CALLTMP XTMPCRT TMAR false|, 'dtmpModTemplateArea')
  !menu.add('CALLBACK', |Template...|, |CALLTMP XTMPCRT TMPL false|, 'dtmpModTemplate')
  !menu.add('CALLBACK', |Template Item...|, |CALLTMP XTMPCRT $$<$$> false|, 'dtmpModTemplateItem')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Negative Extrusion|, 'MODPANE', 'dtmpModNegativeExtrusion')
  !menu.add('CALLBACK', |Primitives...|, |!!genPrimitives('MODIFY')|, 'dtmpModifyPrimitives')
  !menu.add('CALLBACK', |Nozzle Specification...|, |CALLE XNOZZSPEC|, 'dtmpModNozzleSpecification')
  !menu.add('CALLBACK', |Nozzle Attributes...|,|CALLE XNOZZATT CE|, 'dtmpNozzleAttributes')
  !menu.add('CALLBACK', |Angle...|, 'call !!dbeElementAngle(!!ce)', 'dtmpAngle')
  !menu.add('FORM', |Representation...|, 'CDREPSET', 'dtmpModRepresentation')
  !menu.add('SEPARATOR')
    --add |Template Origin...|    |CALLTMP XTMPORIG|
  !menu.add('CALLBACK', |Property Definitions...|, |CALLTMP XDDSE false|, 'dtmpModPropertyDefinitions')
  !menu.add('CALLBACK', |Points...|, |CALLTMP XDPSE false|, 'dtmpPoints')
  !menu.add('CALLBACK', |Dimension Points ...|, |show !!tmpDptsCrt|, 'dtmpModDimensionPoints')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Parameterisation...|, |!!tmplShowParamDefn()|, 'dtmpModParameterisation')
--  !menu.add('CALLBACK', |Local Names...|, |show !!tmpLnameCrt free|, 'dtmpLocalNames')
  !menu.add('CALLBACK', |Order Local Names...|, |show !!tmpLnameOrd free|, 'dtmpOrderLocalNames')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
--
-- Method:      .deleteMenu()
--
-- Description: Adds options to the Delete menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteMenu()
  !menu = object APPMENU('sysDel')
  !menu.add('CALLBACK', |Template World|, |CALLTMP MTMPDEL TPWL|, 'dtmpTemplateWorld')
  !menu.add('CALLBACK', |Template Area|, |CALLTMP MTMPDEL TMAR|, 'dtmpTemplateArea')
  !menu.add('CALLBACK', |Template|, |CALLTMP MTMPDEL TMPL|, 'dtmpTemplate')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  $(
  frame .dtmpToolbar toolbar 'Design Templates Toolbar'
  exit
  !!appTbarCntrl.addToolbar('dtmpToolbar', 'DTMP')
  $)
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MODPANE')
  !menu.add('CALLBACK', |Boundary...|, |!!dbeLoopEdit(!!ce, 'NXTR')|, 'Boundary')
  !menu.add('CALLBACK', |Thickness...|, |CALLPLT XPLTTHK|, 'Thickness')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')
endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
