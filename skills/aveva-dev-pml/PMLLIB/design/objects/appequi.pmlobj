------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Equipment Associations...', |show !!equAssociate|, 'EquipmentAss')
  !menu.add('CALLBACK', 'Equipment Report...', |show !!equipReport|, 'EquipmentRep')
  !menu.add('CALLBACK', 'Import Equipment Data...', |!!equiLoadCsv()|, 'EquipmentCsvImport')
  !menu.add('CALLBACK', 'Equipment...', |CALLG XUTILITIES $$<Equipment$$> $$<EQUI$$> $$<DES$$>|, 'EquipmentUtil')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Equipment...|, 'equiBasic', 'equiEquipment')
  !menu.add('FORM', |Sub-Equipment...|, 'CDSUBEQ', 'equiSubEquipment')
  !menu.add('CALLBACK', |Primitives...|, |!!genPrimitives('CREATE')|, 'equiCreatePrimitives')
  !menu.add('CALLBACK', |Nozzles...|, |CALLE XNOZZ NEW $<CALLE MNOZZ NEW$>|, 'equiCreateNozzles')
  !menu.add('FORM', |Standard Equipment...|, 'equCreateStd', 'equiStandard')
  !menu.add('FORM', |Electrical Component...|, 'equElecChoose', 'equiElecChoose')
  !menu.add('CALLBACK', |Points...|, |CALLTMP XDPSEEQ true|, 'equCreatePoints')

  !!appMenuCntrl.addMenu(!menu, 'EQUI')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Representation...|, 'CDREPSET', 'Representation')
  !menu.add('MENU', |Stretch/Trim|, 'STRETCH', 'StretchTrim')
  !menu.add('MENU', |Slide|, 'SLIDE', 'Slide')
  !menu.add('CALLBACK', |Equipment Specification...|, |show !!equModSpref|, 'equiEquipmentSpecification')
  !menu.add('CALLBACK', |Nozzle Specification...|, |CALLE XNOZZSPEC|, 'equiNozzleSpecification')
  !menu.add('CALLBACK', |Nozzle Attributes...|,|CALLE XNOZZATT CE|, 'equiNozzleAttributes')
  !menu.add('CALLBACK', |Electrical Component...|, |!!equElecModify()|, 'equiModifyELCONN')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Equipment Origin|, 'MODORIG', 'equiEquipmentOrigin')
  !menu.add('MENU', |Sub-Equipment Origin|, 'MODORIGS', 'equiSubEquipmentOrigin')
  !menu.add('CALLBACK', |Primitives...|, |!!genPrimitives('MODIFY')|, 'equiModifyPrimitives')
  !menu.add('CALLBACK', |Points...|, |CALLTMP XDPSEEQ true|, 'equModifyPoints')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')
endmethod
-- End of method definition for .modifyMenu()

