------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .equiToolbar toolbar 'Equipment Toolbar'
    !iconSize = !!comSysOpt.iconSize()
    !createPixmap = !!pml.getPathName('createelement' & !iconSize & '.png')
    !mPropPixmap = !!pml.getPathName('modifyprop' & !iconSize & '.png')
    !posAtPixmap = !!pml.getPathName('positionat' & !iconSize & '.png')
    !oriRtPixmap = !!pml.getPathName('orirotate' & !iconSize & '.png')
    -- create standard equipment
    button .mtbCreate      'Create Standard Equipment'  tooltip 'Create Standard Equipment' pixmap "$!<createPixmap>" width $!iconSize height $!iconSize callback |show !!equCreateStd|
    -- modify properties
    button .mtbProperties  'Modify Properties'          tooltip 'Modify Properties'        pixmap  "$!<mPropPixmap>"   width $!iconSize height $!iconSize callback |!!comProp(!!ce, 'EDIT')|
    -- modify position
    button .mtbPosition    'Modify Position'            tooltip 'Modify Position'          pixmap  "$!<posAtPixmap>"   width $!iconSize height $!iconSize callback |!!pos3DExplicit()|
    -- modify orientation
    button .mtbOrientation 'Modify Orientation'         tooltip 'Modify Orientation'       pixmap  "$!<oriRtPixmap>"   width $!iconSize height $!iconSize callback |CALLIB UFORMS ORI _CDROTAT|
    option .mtbNavigation  tooltip 'Navigation Level'         width 14
    var list _mtbNavigation pairs 'Equipment'     'EQUI'
                                  'Sub Equipment' 'SUBE EQUI'
                                  'Element'           ''
    exit
  exit
  !!appTbarCntrl.addToolbar('equiToolbar', 'EQUI')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('CALLBACK', |Move...|, |!!dragMoveForm(false,'')|, 'Move')
  !menu.add('CALLBACK', |Drag...|, |!!dragMoveForm(true,'')|, 'Drag')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Equipment Point|, 'PPEAT', 'EquipmentPoint')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('PPEAT')
  !menu.add('FORM', |At Explicit...|, 'CDEPEX', 'AtExplicit')
  !menu.add('FORM', |At General...|, 'CDEPATG', 'AtGeneral')
  !menu.add('FORM', |Through...|, 'CDEPMOVTH', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDEPMOVCL', 'Clearance')
  !menu.add('FORM', |Towards...|, 'CDEPMOVTO', 'Towards')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('MOVEPP')
  !menu.add('FORM', |Through...|, 'CDPMOVETH', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDPMOVECL', 'Clearance')
  !menu.add('FORM', |Towards...|, 'CDPMOVETO', 'Towards')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Primitive|, 'OPRIM', 'Primitive')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('OPRIM')
  !menu.add('FORM', |Point...|, 'CDORIP', 'Point')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('CONN')
  !menu.add('MENU', |Primitive|, 'PCONN', 'Primitive')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('PCONN')
  !menu.add('CALLBACK', |ID Point|, |CALLE MCONN|, 'IDPoint')
  !menu.add('FORM', |Explicit...|, 'CDCONNE', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('SLIDE')
  !menu.add('CALLBACK', |To P-Point|, |CALLAC MSLIDE|, 'toPpoint')
  !menu.add('CALLBACK', |To Pline|, |CALLAC MSLIDEP|, 'toPline')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('STRETCH')
  !menu.add('CALLBACK', |All Sides...|, |CALLAC ISTALL|, 'AllSides')
  !menu.add('CALLBACK', |ID P-Point...|, |CALLAC ISTIDP|, 'IDPpoint')
  !menu.add('CALLBACK', |To P-Point|, |CALLAC ISTTPP|, 'ToPpoint')
  !menu.add('CALLBACK', |To Pline|, |CALLAC ISTTPL|, 'ToPline')
  !menu.add('CALLBACK', |Clearance to P-Point...|, |CALLAC ISTCLE|, 'ClearanceToPpoint')
  !menu.add('CALLBACK', |Clearance to Pline...|, |CALLAC ISTCLP|, 'ClearanceToPline')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('MODORIG')
  !menu.add('CALLBACK', |ID Point|, |CALLE MMODORII|, 'IDPoint')
  !menu.add('FORM', |Explicit...|, 'CDMODORIE', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('MODORIGS')
  !menu.add('CALLBACK', |ID Point|, |CALLE MMODORIIS|, 'IDPoint')
  !menu.add('FORM', |Explicit...|, 'CDMODORIES', 'Explicit')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
