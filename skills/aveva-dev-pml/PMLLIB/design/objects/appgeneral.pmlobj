--
--
-- Description:     Object for General application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  modifyMenus()                    -                   Modifies menus for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPGENERAL
endobject
-- End of object definition for APPGENERAL

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Modifies menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.utilsMenu()
endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'General...', |CALLG XUTILITIES $$<General$$> $$<GEN$$> $$<DES$$>|, 'GeneralUtil')
  !!appMenuCntrl.addMenu(!menu, 'GEN')
endmethod
-- End of method definition for .utilsMenu()
