--
--
-- Description:     Object for Hole Management application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appHoleManagement()              -                   Constructor method
--  holeManagedUtilsMenu()           -                   Adds hole management options to the Utilities menu
--  initialise()                     -                   initialisation for penetration application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  toolbars()                       -                   Creates toolbars for this application
--
------------------------------------------------------------------------
define object APPHOLEMANAGEMENT
endobject
-- End of object definition for appHoleManagement

------------------------------------------------------------------------
--
-- Method:      .appHoleManagement()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appHoleManagement()
  -- create global variable !!appHoleManagement so that methods of this object can be called from elsewhere
  !!appHoleManagement = !this
endmethod
-- End of method definition for .appHoleManagement()

------------------------------------------------------------------------
--
-- Method:      .holeManagedUtilsMenu()
--
-- Description: Adds hole management options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .holeManagedUtilsMenu()

  -- add option to menu in Piping app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Pipe Penetration|, 'penPipe', 'PenPipe')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('penPipe')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!branPenCreate|, 'PipeHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'PipeHoleModify')
  !menu.add('CALLBACK', 'Seal Plates...', |SHOW !!sealplates|, 'PipeSealPlates')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  -- add option to menu in HVAC app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |HVAC Penetration|, 'penHVAC', 'PenHVAC')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  !menu = object APPMENU('penHVAC')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!branPenCreate|, 'HVACHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'HVACHoleModify')
  !menu.add('CALLBACK', 'Seal Plates...', |SHOW !!sealplates|, 'HVACSealPlates')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  --  Civil app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Floor Penetration|, 'penFloor', 'PenFloor')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  !menu = object APPMENU('penFloor')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Create Fitting Hole...', |SHOW !!hmFittHole|, 'FittHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'FloorHoleModify')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  -- add option to menu in Steelwork app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Steel Penetration|, 'penSteel', 'PenSteel')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  !menu = object APPMENU('penSteel')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!stlPenCreate|, 'SteelHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'SteelHoleModify')
  !menu.add('CALLBACK', 'Seal Plates...', |SHOW !!sealplates|, 'SteelSealPlates')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  -- add option to menu in Panels & Plates app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Steel Penetration|, 'penPanel', 'PenPanel')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  !menu = object APPMENU('penPanel')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!stlPenCreate|, 'PanelHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Create Fitting Hole...', |SHOW !!hmFittHole|, 'FittHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'PanelHoleModify')
  !menu.add('CALLBACK', 'Seal Plates...', |SHOW !!sealplates|, 'PanelSealPlates')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  -- add option to menu in Equipment app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Equipment Penetration|, 'penEqui', 'PenEqui')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('penEqui')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!equiPenCreate|, 'EquiHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'EquiHoleModify')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  -- add option to menu in Cabling system app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Cable Way Penetration|, 'penCway', 'PenCway')
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

  !menu = object APPMENU('penCway')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!cWBranPenCreate|, 'cWayHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'cWayHoleModify')
  !!appMenuCntrl.addMenu(!menu, 'CABLINGSYSTEM')

    -- add option to menu in cable tray app
  !menu = object APPMENU('sysUtil')
  !menu.add('MENU', |Cable Tray Penetration|, 'penTray', 'PenTray')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

  !menu = object APPMENU('penTray')
  !menu.add('CALLBACK', 'Create Penetration...', |SHOW !!branPenCreate|, 'TrayHolePenetration')
  !menu.add('CALLBACK', 'Create Hole...', |SHOW !!genPenCreate|, 'GenHolePenetration')
  !menu.add('CALLBACK', 'Modify...', '!!hmModify()', 'TrayHoleModify')
  !!appMenuCntrl.addMenu(!menu, 'CABL')

endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  -- Equipment application modify menu
  !menu = object APPMENU('sysMod')
  !menu.add('CALLBACK', |Penetration Profile...|, |!!hmEquHoleProfile(!!ce)|, 'equiModifyHoleProfile')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  -- Design Template application modify menu
  !menu = object APPMENU('sysMod')
  !menu.add('CALLBACK', |Penetration Profile...|, |!!hmEquHoleProfile(!!tmpGetCurrentTemplate())|, 'tmplModifyHoleProfile')
  !!appMenuCntrl.addMenu(!menu, 'DTMP')

endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation for penetration application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- load up penetration forms if this is the first time its loaded
  if( !!isThisHmProj() ) then
    !this.holeManagedUtilsMenu()
  endif
  !this.modifyMenus()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  if( !!isThisHmProj() ) then
    !this.toolbars()
  endif
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  frame .penetrationUtilitiesBar toolbar 'Penetration Utilities'
    !iconSize         = !!comSysOpt.iconSize()
    !hmUtility        = !!pml.getPathName('hmutility16.png')
    !hmUtilityCreate  = !!pml.getPathName('hmutilitycreate16.png')
    !hmUtilityModify  = !!pml.getPathName('hmutilitymodify16.png')
    !hmUtilityManager = !!pml.getPathName('hmutilitymanager16.png')

    button .btnUtility          tooltip 'Hole Management Utility'  pixmap "$!<hmUtility>"          width $!<iconSize> height $!<iconSize> callback |show !!hmUtility|
    button .btnUtilityCreate    tooltip 'Create Penetration'       pixmap "$!<hmUtilityCreate>"    width $!<iconSize> height $!<iconSize> callback |show !!branPenCreate|
    button .btnUtilityModify    tooltip 'Modify Penetration'       pixmap "$!<hmUtilityModify>"    width $!<iconSize> height $!<iconSize> callback |!!hmModify()|
    button .btnUtilityManager   tooltip 'Hole Manager'             pixmap "$!<hmUtilityManager>"   width $!<iconSize> height $!<iconSize> callback |show !!holeManMain|
  exit

  -- register this toolbar with all three structures applications
  !!appTbarCntrl.addToolbar('penetrationUtilitiesBar', 'PIPE')
  !!appTbarCntrl.addToolbar('penetrationUtilitiesBar', 'HVACADV')

endmethod
-- End of method definition for .toolbars()
