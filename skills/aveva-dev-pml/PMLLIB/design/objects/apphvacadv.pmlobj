--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Thu Jan 29 17:30:56 2004
--
--
-- Description:     Object for HVAC application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appHvacAdv()                     -                   Constructor
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPHVACADV
endobject
-- End of object definition for APPHVACADV

------------------------------------------------------------------------
--
-- Method:      .appHvacAdv()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appHvacAdv()

  -- Call main HVAC control object global instance (!!hvacControl)
  if(undefined(!!hvacControl)) then
    call !!comDefineGlobal(object HVACCONTROL())
  endif

endmethod
-- End of method definition for constructor
------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Position|, 'POSITION')
  !bmenu.add(|Orientate|, 'ORI')
  !!appMenuCntrl.addBarMenu(!bmenu, 'HVACADV')
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('sysView')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .displayMenu()

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('sysGph')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Item Details|, 'QUERPROP', 'hvacItemDetails')
  !menu.add('MENU', |Position|, 'QUERPOS', 'Position')
  !menu.add('CALLBACK', |Orientation|, |CALLHV MBARQUERY QORI|, 'hvacOrientation')
  !menu.add('CALLBACK', |Gap to next|, |CALLHV MBARQUERY GAP|, 'hvacGapToNext')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .queryMenu()

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Ductwork Defaults...|, |CALLHV FLOADDEFLTS|, 'hvacDuctworkDefaults')
  !menu.add('TOGGLE', 'Retain Material in Modification', '', 'hvacRetainMaterial')
  --ADD |Detailing Spec... | |CALLHV FCURRENTSP|
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Import HVAC Data...', |!!pipeLoadCsv()|, 'HvacCSVImport')
  !menu.add('CALLBACK', 'HVAC Designer...', |CALLG XUTILITIES $$<HVAC Designer$$> $$<HVACADV$$> $$<DES$$>|, 'HVACDesignerUtil')
  !menu.add('SEPARATOR')
  -- $* ADD |HVAC Data Consistency...  | |CALLHV MBARUTIL DATAC|
  !menu.add('CALLBACK', |Specification Generator...|, |CALLHV MBARUTIL SPECGEN|, 'hvacSpecificationGenerator')
  !menu.add('MENU', |HVAC Tiles/Grid Layout|, 'HVACGRID', 'hvacTilesGridLayout')
  !menu.add('MENU', |Autofill with Straights|, 'AUTOFILL', 'hvacAutofillWithStraights')
  !menu.add('CALLBACK', |HVAC Assemblies...|, |SHOW !!hvacassemblymgr| ,'hvacassemblymgr')
  !menu.add('CALLBACK', |Automatic Itemising...|, |CALLHV MBARUTIL ITEMIZ|, 'hvacAutomaticItemising')
  !menu.add('CALLBACK', |Surface Area & Weight...|, |CALLHV FSRF|, 'hvacSurfaceAreaWeight')
  !menu.add('CALLBACK', |Centre of Gravity...|, |CALLHV FCOFG|, 'hvacCentreofGravity')
  !menu.add('CALLBACK', |HVAC Spooling...|, |show !!hvacspool|, 'hvacSpool')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |HVAC...|, |CALLHV XMAINCONTROL|, 'HVAC')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |HVAC...|, |CALLHV XMAINCONTROL
  calldct MMODIFY|, 'HVAC')
  !menu.add('FORM', |Split HVAC...|, |hvacsplitting|, 'SPLITHVAC')
  !menu.add('CALLBACK', |Merge Branches|, |!!mergeHvacBranches = object hvacmerge()|, 'MERGEBRANCHES')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
--
-- Method:      .deleteMenu()
--
-- Description: Adds options to the Delete menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteMenu()
  !menu = object APPMENU('sysDel')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')
endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .hvacadvToolbar toolbar 'HVAC Designer Toolbar'
    option _DETSPECNAMINP   tooltip 'Default HVAC Specification' callback | $$M "$$!!cdhDirDetSpec/X$$_DETSPECNAMINP"
!!hvacControl.writeSavedSpec(!!APPDESMAIN.DETSPECNAMINP.selection('RTEXT'))| width 25
  exit
  !!appTbarCntrl.addToolbar('hvacadvToolbar', 'HVACADV')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('CALLBACK', |Move...|, |!!dragMoveForm(false,'')|, 'Move')
  !menu.add('CALLBACK', |Drag...|, |!!dragMoveForm(true,'')|, 'Drag')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  --  $* Orientation Menu
  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  !menu = object APPMENU('QUERPOS')
  !menu.add('CALLBACK', |Origin |, |CALLHV MBARQUERY QPOS|, 'Origin')
  !menu.add('CALLBACK', |Position PA|, |CALLHV MBARQUERY QPA|, 'PositionPA')
  !menu.add('CALLBACK', |Position PL|, |CALLHV MBARQUERY QPL|, 'PositionPL')
  !menu.add('CALLBACK', |Position P3|, |CALLHV MBARQUERY QP3|, 'PositionP3')
  !menu.add('CALLBACK', |Position PH|, |CALLHV MBARQUERY QPH|, 'PositionPH')
  !menu.add('CALLBACK', |Position PT|, |CALLHV MBARQUERY QPT|, 'PositionPT')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  !menu = object APPMENU('QUERPROP')
  !menu.add('CALLBACK', |Brief Description|, |CALLHV MPROPERTY|, 'BriefDescription')
  !menu.add('CALLBACK', |Item Number |, |CALLHV MBARQUERY ITEMNO|, 'ItemNumber')
  !menu.add('CALLBACK', |Detailing Spec |, |CALLHV MBARQUERY DSCODE|, 'DetailingSpec')
  -- $* ADD |Spec Reference   | |CALLHV MBARQUERY SPREF|
  !menu.add('CALLBACK', |Insulation Depth |, |CALLHV MBARQUERY INSU|, 'InsulationDepth')
  !menu.add('CALLBACK', |Taper Side Angles|, |CALLHV MQTAPERANGS|, 'TaperSideAngles')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  !menu = object APPMENU('HVACGRID')
  !menu.add('CALLBACK', |1. Setting Out Point...|, |CALLHV FNDATUM|, '1SettingOutPoint')
  !menu.add('CALLBACK', |2. Grid from S.O.P...|, |CALLHV FNGRID|, '2GridfromSOP')
  !menu.add('CALLBACK', |3. Apply Tiles in Grid...|, |CALLHV FNTILE|, '3ApplyTilesinGrid')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  !menu = object APPMENU('AUTOFILL')
  !menu.add('CALLBACK', |Show Gaps...|, |CALLHV FSHOWGAPS|, 'ShowGaps')
  !menu.add('CALLBACK', |Fill Gaps...|, |CALLHV MBARUTIL AUTOFILL|, 'FillGaps')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
