--
--
-- Description:     Object for Panels & Plates application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPPANEL
endobject
-- End of object definition for APPPANEL

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Position|, 'POSITION')
  !bmenu.add(|Orientate|, 'ORI')
  !bmenu.add(|Connect|, 'CONN')
  !!appMenuCntrl.addBarMenu(!bmenu, 'PANEL')
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Panels & Plates...', |CALLG XUTILITIES $$<Panels & Plates$$> $$<PANEL$$> $$<DES$$>|, 'PanelsPlatesUtil')
  -- if($!!CDLNPENE) then
  -- !menu.add('SEPARATOR')
  -- !menu.add('CALLBACK', |Penetrations|, |CALLPEN XPENEAPP PANEL Panel & Plates|, 'Penetrations')
  --  endif
   -- New A,S & L Application commented out until finished
   -- add |Access Stairs & Ladders...| |show !!aslMainMenu|
  !!appMenuCntrl.addMenu(!menu, 'PANEL')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Structure...|, |CALLG XCRTPURP STRU $$<Create Structure$$>|, 'Structure')
  !menu.insertAfter('Structure', 'CALLBACK', |Framework...|, |CALLG XCRTPURP FRMW $$<Create Framework$$>|, 'Framework')
  !menu.insertAfter('Framework', 'CALLBACK', |Sub-Frame...|, |CALLG XCRTPURP SBFR $$<Create Sub-Frame$$>|, 'SubFrame')
  !menu.insertAfter('SubFrame', 'CALLBACK', |Panel...|, |!!pltCreate('Panel', 'PANDP', 'PANEL', 'default-STL-PLT')|, 'Panel')
  !menu.insertAfter('Panel', 'FORM', |Bent Panel...|, |stlBentPanelCreate|, 'BentPanel')
  !menu.insertAfter('BentPanel', 'FORM', |Negative Extrusion...|, |dbeNExtrusion|, 'NegativeExtrusion')
  !menu.insertAfter('NegativeExtrusion', 'MENU', |Fittings|, 'panelCrtFitt', 'Fittings')
  !menu.insertAfter('Fittings', 'CALLBACK', |Fixing...|, |show !!stlstandalonefixing|, 'CreateFixing')
  --   $*if($!!CDLNPENE) then
  -- !menu.add('SEPARATOR')
  --   $*  add |Penetrations...|   |CALLPEN XPENEAPP PANEL Panel & Plates|
  --   $*endif
  !!appMenuCntrl.addMenu(!menu, 'PANEL')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Representation...|, 'CDREPSET', 'panelRepresentation')
  !menu.add('CALLBACK', |Extrusion/Panel...|, |!!dbeLoopEdit(!!ce, 'PANE NXTR BPOPEN')|, 'ExtrusionPanel')
  !menu.add('FORM', |Justification...|, |stlPanelJustification| ,|Justification|)
  !menu.add('CALLBACK', |Specification...|, |call !!pltThickness('PLATE', !!ce)|, 'Specification')
  !menu.add('FORM', |Thickness...|, |stlPanelThickness| ,|Thickness|)
  !menu.add('CALLBACK', |Split...|, |show !!splitgensectpane|, 'Split')
  !menu.add('FORM', |Split Bent Panel...|, |stlDivideBentPanel|, 'SplitBentPanel')
  !menu.add('CALLBACK',|Merge|,|!!mergeObject = object mergegensectpane('Merge')|,'Merge')
  !menu.add('CALLBACK', |Fitting...|, |CALLPLT XPFITSPEC MODIFY|, 'Fitting')
  --   $*if($!!CDLNPENE) then
  --   $*  add |Penetrations...|    menu _MODPEN
  --   $*endif
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Draft Edge Drawing...|, 'DesUnion', 'DraftEdgeDrawing')
  !menu.add('FORM', |Material...|, 'CDSETMATR', 'Material')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')
endmethod
-- End of method definition for .modifyMenu()

