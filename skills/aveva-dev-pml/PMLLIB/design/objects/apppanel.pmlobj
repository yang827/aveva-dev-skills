------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .panelToolbar toolbar 'Panels && Plates Toolbar'
    !iconSize = !!comSysOpt.iconSize()
    -- Switching Applications
    $(
    commented out because it's already created in another application
    !stlPixmap  = !!PML.getPathName('stlwrkapp' & !iconSize & '.png')
    !stlIPixmap = !!PML.getPathName('stlwrkappi' & !iconSize & '.png')
    !pltPixmap  = !!PML.getPathName('panelapp' & !iconSize & '.png')
    !pltIPixmap = !!PML.getPathName('panelappi' & !iconSize & '.png')
    !civPixmap  = !!PML.getPathName('civilapp' & !iconSize & '.png')
    !civIPixmap = !!PML.getPathName('civilappi' & !iconSize & '.png')
    button _BBANDC 'Beams & Columns Application' tooltip 'Beams & Columns Application' pixmap sel "$!<stlPixmap>" inact /$!<stlIPixmap> width $!<iconSize> height $!<iconSize> callback |CALLIB XAPPLOAD DES STLWRK _CDSTLAPP $<$> true false $<Beams & Columns$>|
    button _BPANDP 'Panels & Plates Application' tooltip 'Panels & Plates Application' pixmap sel "$!<pltPixmap>" inact /$!<pltIPixmap> width $!<iconSize> height $!<iconSize> callback |CALLIB XAPPLOAD DES PANEL _CDPLTAPP $<$> true false $<Panels & Plates$>|
    button _BFANDW 'Walls & Floors Application' tooltip 'Walls & Floors Application'  pixmap sel "$!<civPixmap>" inact /$!<civIPixmap> width $!<iconSize> height $!<iconSize> callback |CALLIB XAPPLOAD DES CIVIL _CDCIVAPP $<$> true false $<Walls & Floors$>|
    $)
    -- Auto Naming
    --   toggle   _AUTO |Auto Name|  at XMAX+0.5 YMIN_BFANDW
  -- default material selection removed (6/7/98)
  --   !bmatPixmap = !!PML.getPathName('materialspec' & !iconSize & '.png')
  --   button .bMat     tooltip 'Set Default Material Specification' pixmap "$!<bmatPixmap>" width $!<iconSize> height $!<iconSize> form !!SctlMaterial
  --   text   .material tooltip 'Default Material Specification' width 10 string
  --   !!cdPltApp.material.setEditable(false)
  --   !!cdPltApp.material.val = 'Unset'
    !bpanelPixmap = !!pml.getPathName('panelspec' & !iconSize & '.png')
    button .bPanelSpec  tooltip 'Set Default Panel Specification' pixmap "$!<bpanelPixmap>" width $!<iconSize> height $!<iconSize> callback |!!pltSpecification('PLATE')|
    text   .panelSpec tooltip 'Default Panel Specification' width 20 string
    !!appDesMain.panelSpec.setEditable(false)
    !!appDesMain.panelSpec.val = 'Unset'
    -- Panel Storage
    !bpanePixmap = !!pml.getPathName('panelstorage' & !iconSize & '.png')
    button .bPanelStorage tooltip 'Set Panel Storage Area' pixmap "$!<bpanePixmap>" width $!<iconSize> height $!<iconSize>
    text   .panelStorage  tooltip 'Panel Storage Area' width 25 string
    !!appDesMain.panelStorage.setEditable(false)
    !!appDesMain.panelStorage.val = 'Unset'
    -- Joint storage
    !bljoiPixmap = !!pml.getPathName('jointstorage' & !iconSize & '.png')
    button .bLjoiStorage tooltip 'Set Panel Linear Joint Storage Area' pixmap "$!<bljoiPixmap>" width $!<iconSize> height $!<iconSize>
    text   .ljoiStorage  tooltip 'Panel Linear Joint Storage Area' width 25 string
    !!appDesMain.ljoiStorage.setEditable(false)
    !!appDesMain.ljoiStorage.val = 'Unset'
  exit
  !!appTbarCntrl.addToolbar('panelToolbar', 'PANEL')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  --   $* -------------------- Create Panel Fittings --------------------
  !menu = object APPMENU('panelCrtFitt')
  !menu.add('CALLBACK', |Single...|, |CALLPLT XPFITSPEC CREATE PFIT|, 'Single')
  !menu.add('CALLBACK', |Compound...|, |CALLPLT XPFITSPEC CREATE CMPF|, 'Compound')
  !menu.add('CALLBACK', |Sub-Compound...|, |CALLPLT XPFITSPEC CREATE SBFI|, 'SubCompound')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  --   $* -------------------- Modify Panel Fittings --------------------
  --   menu _MODFITT
  --     add |Single...|       |call !!strFittSpecShow('MODIFY','PFIT')|
  --     add |Compound...|     |call !!strFittSpecShow('MODIFY','CMPF')|
  --     add |Sub-Compound...| |call !!strFittSpecShow('MODIFY','SBFI')|
  --   exit
  --   $* ------------------ Position ------------------
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Panel Origin|, |CALLPLT MMOVEORIG|, 'PanelOrigin')
  !menu.add('CALLBACK', |Level Vertices|, |CALLPLT MVERTLEVEL|, 'LevelVertices')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  --   $* ------------------ Orientate ------------------
  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |B Angle|, 'BANG', 'BetaAngle')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  --     $* Set Beta Angle
  !menu = object APPMENU('BANG')
  !menu.add('CALLBACK', |-180 Degrees|, |BANG -180|, '-180Degrees')
  !menu.add('CALLBACK', |-90 Degrees|, |BANG -90|, '-90Degrees')
  !menu.add('CALLBACK', |0 Degrees|, |BANG 0|, '0Degrees')
  !menu.add('CALLBACK', |90 Degrees|, |BANG 90|, '90Degrees')
  !menu.add('CALLBACK', |180 Degrees|, |BANG 180|, '180Degrees')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  --   $* ------------------- Connections -------------------
  !menu = object APPMENU('CONN')
  !menu.add('MENU', |Disconnect|, 'PANEDISC', 'panelDisconnect')
  !menu.add('FORM', |Connect...|, 'CDPLTTOOLB', 'panelConnect')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Trim|, |CALLPLT MPANETRIM|, 'panelTrim')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  --     $* Disconnect
  !menu = object APPMENU('PANEDISC')
  !menu.add('CALLBACK', |Panel|, |CALLPLT MPLTDISC PANEL|, 'Panel')
  !menu.add('CALLBACK', |Edges|, |CALLPLT MPLTDISC EDGES|, 'Edges')
  !menu.add('CALLBACK', |Edge|, |CALLPLT MPLTDISC EDGE|, 'Edge')
  !menu.add('CALLBACK', |Vertex|, |CALLPLT MPLTDISC VERT|, 'Vertex')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  -- $(
  !menu = object APPMENU('CRPEN')
  !menu.add('CALLBACK', |for Pipework...|, |CALLPEN XPENCLA BRAN Piping|, 'forPipework')
  !menu.add('CALLBACK', |for Steelwork...|, |CALLPEN XPENCLA SCTN Section|, 'forSteelwork')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  !menu = object APPMENU('MODPEN')
  !menu.add('CALLBACK', |Items...|, |CALLPEN XMPENE ITEM|, 'Items')
  !menu.add('CALLBACK', |Holes...|, |CALLPEN XMPENE HOLE|, 'Holes')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

  -- $)

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.settingsMenu()
  !this.queryMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
