--
--
-- Description:     Object for Penetrations application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appPenetrations()                -                   Constructor method
--  initialise()                     -                   initialisation for penetration application
--  modifyMenus()                    -                   Runs all other menu creation methods
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPPENETRATIONS
endobject
-- End of object definition for APPPENETRATIONS

------------------------------------------------------------------------
--
-- Method:      .appPenetrations()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appPenetrations()
  -- create global variable !!appPenetrations so that methods of this object can be called from elsewhere
  !!appPenetrations = !this
endmethod
-- End of method definition for .appPenetrations()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds old penetrations options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  -- add option to menu in Piping app
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Penetrations...', 'CALLPEN XPENEAPP PIPE Pipework', 'PipePenetration')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  -- add option to menu in HVAC app
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Penetrations...', 'CALLPEN XPENEAPP HVACADV HVAC', 'HVACPenetration')
  !!appMenuCntrl.addMenu(!menu, 'HVACADV')

  -- add option to menu in Civil app
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Penetrations...', 'CALLPEN XPENEAPP WALL $<Walls$>', 'CivilPenetration')
  !!appMenuCntrl.addMenu(!menu, 'CIVIL')

  -- add option to menu in Steelwork app
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Penetrations...', 'CALLPEN XPENEAPP STLWRK Steelwork', 'SteelworkPenetration')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  -- add option to menu in Panels & Plates app
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Penetrations...', 'CALLPEN XPENEAPP PANEL Panels & Plates', 'PanelsPlatesPenetration')
  !!appMenuCntrl.addMenu(!menu, 'PANEL')

endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  -- !this.utilsMenu()
endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation for penetration application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  -- load up penetration forms etc. if this is the first time it's loaded
  if (undefined(!!cdPenCla)) then
    !!runsynonym('CALLPEN INIT')
    handle ANY
      -- loading Penetrations application has failed!
      var !!cdLnPene false
    elsehandle none
      -- Only configure the application utilities menu if this is not a hole managed object
      !this.utilsMenu()
    endhandle
  endif
endmethod
-- End of method definition for .initialise()
