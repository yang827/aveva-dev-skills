------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Piping Defaults...|, |pipingdefaults|, 'pipingdefaults')
  !menu.add('CALLBACK', |Default Spec...|, |CALLP FPSPEC TRUE|, 'pipeDefaultSpec')
  !menu.add('FORM', |Choose Options...|, 'CDCHOOSEO', 'pipeChooseOptions')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Import Pipe Data...', |!!pipeLoadCsv()|, 'PipeworkCsvImport')
  !menu.add('CALLBACK', 'Pipework...', |CALLG XUTILITIES $$<Pipework$$> $$<PIPE$$> $$<DES$$>|, 'PipeworkUtil')
  !menu.add('FORM', |Pipe Splitting...|, |pipesplitting|, 'pipesplitting')
--  !menu.add('FORM' , |Pipe Assemblies...|, |pipeassemblymgr|, 'pipeassemblymgr')
  !menu.add('CALLBACK' , |Pipe Assemblies...|, |SHOW !!pipeassemblymgr !!pipeassemblymgr.setview()| ,'pipeassemblymgr')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Pipe Isometric...|, |!!isdRunIso('STA', true)|, 'PipeIsometric' )
  !menu.add('CALLBACK', |System Isometric...|, |!!isdRunIso('SYS', true)|, 'SystemIsometric')
  !menu.add('TOGGLE', |Show Pipe System|, |!!isdRunIso('SHO', !this.sysUtil.selected('Show Pipe System') )|, 'ShowPipeSystem')
  !menu.add('SEPARATOR')

  !!pipeSetProductionCheckOption()

  if !!productionChecksEnabled then
    !menu.add('TOGGLE', |Production Checks|, '', 'Pipe Checking')
    !menu.add('CALLBACK' , |Fabrication Machine Manager...|, |SHOW !!fabMachineMgr| ,'fabMachineMgr')
    !menu.add('CALLBACK' , |Bending Machine NC Output...|, |!!fabMachineNCs()| ,'fabMachineNCs')
  endif

  if ($!!cdRouterExists) then
   !menu.add('SEPARATOR')
   !file = object FILE('%PDMSUI%/DES/ROUTER/XROUTER')
   if(!file.exists())then
     !menu.add('CALLBACK', |Pipe Router...|, |CALLR XROUTER|, 'PdmsRouter')
   else
     !menu.add('CALLBACK', |Pipe Router...|, |!!alert.error('Pipe Router is not installed properly.')|, 'PdmsRouter')
   endif
  endif
  !!appMenuCntrl.addMenu(!menu, 'PIPE')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Pipe...|, 'CDPIPE', 'Pipe')
  !menu.add('FORM', |Branch...|, 'CDBRAN', 'Branch')
  !menu.add('FORM', |Components...|, 'CDCOMP', 'Components')
  !menu.add('CALLBACK', |Non-standard Branch Connection...|, |show !!pipetappings|, 'NonStandardBranch')
  --       $*if($!!CDLNPENE) then
  -- !menu.add('SEPARATOR')
  --       $*  add |Pipe Penetration...| |CALLPEN XPENEAPP PIPE Pipework|
  --       $*endif
  !!appMenuCntrl.addMenu(!menu, 'PIPE')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Pipe|, 'MODPIPE', 'Pipe')
  !menu.add('MENU', |Branch|, 'MODBRAN', 'Branch')
  !menu.add('MENU', |Component|, 'MODCOMP', 'pipeComponent')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Branch Slope...|, 'CDAUTOSL', 'Slope')
  !menu.add('CALLBACK' , |Pipe Slope...|, |show !!pipeSlopeForm|)
  !!appMenuCntrl.addMenu(!menu, 'PIPE')
endmethod
-- End of method definition for .modifyMenu()

