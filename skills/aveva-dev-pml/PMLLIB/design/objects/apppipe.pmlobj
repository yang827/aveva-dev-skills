------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .pipeToolbar toolbar 'Pipework Toolbar'
    -- para _SPEC at xmax_LIST ymin text |Specification : Not Set| width 40 lines 1
    !iconSize = !!comSysOpt.iconSize()
    -- current spec
    !pipespecPixmap = !!pml.getPathName('pipespec' & !iconSize & '.png')
    button .pipeSpecSel tooltip 'Set Default Pipe Specification' pixmap "$!<pipespecPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLP FPSPEC TRUE|
    text .pipeSpec tooltip 'Default Pipe Specification' width 25 string
    !!appdesmain.pipeSpec.setEditable(false)

    -- Create Pipe
   !pixmap = !!pml.getPathName('createpipe-16.png')
    button .createPipe tooltip 'Show pipe creation form' pixmap "$!<pixmap>" width 16 height 16 callback '!!createPipe(!!ce)'

    -- Modify Pipe
   !pixmap = !!pml.getPathName('modifypipe-16.png')
    button .modifyPipe tooltip 'Show pipe modification form' pixmap "$!<pixmap>" width 16 height 16 callback '!!modifyPipe(!!ce)'

    -- Component Creation
    !pixmap = !!pml.getPathName('componentcreate-16.png')
    button .createComponent tooltip 'Show pipe component creation form' pixmap "$!<pixmap>" width 16 height 16 callback 'show !!componentCreation'

    -- Reselect Component
    !pixmap = !!pml.getPathName('componentselect-16.png')
    button .selectComponent tooltip 'Show pipe component selection form' pixmap "$!<pixmap>" width 16 height 16 callback 'show !!componentSelection'

    -- Delete Range of components
    !pixmap = !!pml.getPathName('rangedelete16.png')
    button .reangeDelete    tooltip 'Delete range of piping components' pixmap "$!<pixmap>" width 16 height 16 callback '!!deletePipingRange()'

    -- Re-align selection
    !pixmap = !!pml.getPathName('aligncomponent16.png')
    button .alignComponent  tooltip 'Align selection/component'         pixmap "$!<pixmap>" width 16 height 16 callback '!!alignComponent()'

    -- Re-direct selection
    !pixmap = !!pml.getPathName('directcomponent16.png')
    button .directComponent  tooltip 'Direct selection/component'       pixmap "$!<pixmap>" width 16 height 16 callback '!!directComponent()'

    -- Re-direct selection
    !pixmap = !!pml.getPathName('stubintee.png')
    button .nonStandardBranchConnection  tooltip 'Create non-standard branch connection'       pixmap "$!<pixmap>" width 16 height 16 callback 'show !!pipetappings'

 --   option .slopeDirection 'Slope' tooltip  'Current slope direction'          callback '!!setPipeSlopeOption( !!appdesmain.slopeDirection.selection(|rtext|) )' width 4
--    text   .slopeAngle 'Angle'  at xmax tooltip 'Current slope angle or ratio' callback '!!setPipeSlopeAngle(!!appdesmain.slopeAngle.val,!!appdesmain.slopeAngle )'    width 8 is STRING

  exit

  !!appTbarCntrl.addToolbar('pipeToolbar', 'PIPE')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('CALLBACK', |Move...|, |!!dragMoveForm(false,'')|, 'Move')
  !menu.add('CALLBACK', |Drag...|, |!!dragMoveForm(true,'')|, 'Drag')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Branch|, 'BRANPOS', 'Branch')
  !menu.add('MENU', |Component|, 'COMPPOS', 'Component')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('BRANPOS')
  !menu.add('FORM', |General...|, 'CDBRATG', 'General')
  !menu.add('FORM', |Distance...|, 'CDBRPOSDI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDBRPOSTH', 'Through')
  !menu.add('CALLBACK', |Move...|, |!!dragMoveForm(false,'BRANCH')|, 'Move')
  !menu.add('CALLBACK', |Drag...|, |!!dragMoveForm(true,'BRANCH')|, 'Drag')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('COMPPOS')
  !menu.add('FORM', |Distance...|, 'CDDIST', 'Distance')
  !menu.add('FORM', |Through...|, 'CDTHRO', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDCLEA', 'Clearance')
  !menu.add('FORM', |BoP/ToP...|, 'CDBOP', 'BoP/ToP')
  !menu.add('FORM', |Plane Through...|, 'CDPLANE', 'PlaneThrough')
  !menu.add('FORM', |Plane Clearance...|, 'CDPLANECL', 'PlaneClearance')
  !menu.add('FORM', |Drag BoP/ToP...|, 'CDDRAGBOP', 'DragBoP/ToP')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Component|, 'ORICOMP', 'Component')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('ORICOMP')
  !menu.add('FORM', |Leave...|, 'CDORILEA', 'Leave')
  !menu.add('FORM', |Offset...|, 'componentOriOff', 'Offset')
  !menu.add('FORM', |Slope...|, 'componentSlope', 'Slope')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('CONN')
  !menu.add('FORM', |Branch...|, 'CDCONNBR', 'pipeBranch')
  !menu.add('FORM', |Component...|, 'CDCONN', 'pipeComponent')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('MODCOMP')
  !menu.add('FORM', |General|, 'CDCOMP', 'General')
  !menu.add('CALLBACK', |Arrive/Leave...|, |show _CDCOMPALP
   CALLP ICOMPALP|, 'ArriveLeave')
  !menu.add('FORM', |Route...|, 'CDMODROUT', 'Route')
  !menu.add('FORM', |Leave Tube...|, 'CDMODLSTU', 'LeaveTube')
  !menu.add('CALLBACK', |Connection Ref...|, |CALLG IUCONN|, 'ConnectionRef')
  !menu.add('FORM', |Detail Plotfile...|, 'splDetailPlt', 'DetailPlotfile')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('MODPIPE')
  !menu.add('FORM', |Specification...|, 'CDMODPISP', 'pipeSpecification')
  !menu.add('CALLBACK' , |Component bore/Specification...| , '!!specborechange(|PIPE|)', 'bore/Specification')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('MODBRAN')
  !menu.add('FORM', |Explicit...|, 'CDBRAT', 'Explicit')
  !menu.add('FORM', |Specification...|, 'CDMODBRSP', 'Specification')
  !menu.add('FORM', |Reselect...|, 'CDMODBRRE', 'Reselect')
  !menu.add('CALLBACK' , |Component bore/Specification...| , '!!specborechange(|BRAN|)', 'bore/Specification')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  --   $* Perform any user specific menu bar definition (see also /BAR above)
  --   $* Added by MHL for ABB developments 18 Mar 1996
  --   $* May be superseded by future customization mechanism
  --    CALLP DBARLOCAL MENU
  --    handle any
  --    endhandle

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
