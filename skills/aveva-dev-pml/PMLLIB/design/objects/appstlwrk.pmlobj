------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  !iconSize = !!comSysOpt.iconSize()

  frame .structuresToolbar toolbar 'Structures Applications'
    -- Switching Applications
    !stlPixmap  = !!pml.getPathName('stlwrkapp' & !iconSize & '.png')
    !pltPixmap  = !!pml.getPathName('panelapp' & !iconSize & '.png')
    !civPixmap  = !!pml.getPathName('civilapp' & !iconSize & '.png')

    button _BBANDC tooltip 'Beams & Columns Application' pixmap "$!<stlPixmap>" width $!<iconSize> height $!<iconSize> callback |!!appxload('DES', 'STLWRK', false)|
    button _BPANDP tooltip 'Panels & Plates Application' pixmap "$!<pltPixmap>" width $!<iconSize> height $!<iconSize> callback |!!appxload('DES', 'PANEL', false)|
    button _BFANDW tooltip 'Walls & Floors Application'  pixmap "$!<civPixmap>"  width $!<iconSize> height $!<iconSize> callback |!!appxload('DES', 'CIVIL', false)|
  exit
  -- register this toolbar with all three structures applications
  !!appTbarCntrl.addToolbar('structuresToolbar', 'STLWRK')
  !!appTbarCntrl.addToolbar('structuresToolbar', 'PANEL')
  !!appTbarCntrl.addToolbar('structuresToolbar', 'CIVIL')
  !!appTbarCntrl.addToolbar('structuresToolbar', 'ASL')

  frame .stlwrkToolbar toolbar 'Beams && Columns Toolbar'
    -- Current Profile
    !sspecPixmap = !!pml.getPathName('steelspec' & !iconSize & '.png')
    button .sSpec tooltip 'Set Default Profile Specification' pixmap "$!<sspecPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLSTL XSTLSPEC DFLT|
    text   .spre  tooltip 'Default Profile Specification' width 20 string
    !!appDesMain.spre.setEditable(false)
    !!appDesMain.spre.val = 'Unset'
    -- Primary Nodes
    !nodesOn  = !!pml.getPathName('nodeson' & !iconSize & '.png')
    button .node toggle 'Primary Nodes' tooltip 'Primary Nodes' pixmap "$!<nodesOn>" width $!<iconSize> height $!<iconSize>
    var    _NODE |false|
    -- Profile on/off
    !profileOn  = !!pml.getPathName('profileon' & !iconSize & '.png')
    button .prfl toggle 'Profile' tooltip 'Profile' pixmap "$!<profileOn>" width $!<iconSize> height $!<iconSize>
    var    _PRFL |true|
    -- Section Storage
    !bsctnPixmap = !!pml.getPathName('sctnstorage' & !iconSize & '.png')
    button .bSctn tooltip 'Set Section Storage Area' pixmap "$!<bsctnPixmap>" width $!<iconSize> height $!<iconSize>
    text   .sctns tooltip 'Section Storage Area' width 25 string
    !!appDesMain.sctns.setEditable(false)
    !!appDesMain.sctns.val = 'Unset'
    -- Node storage
    !bnodePixmap = !!pml.getPathName('nodestorage' & !iconSize & '.png')
    button .bNode tooltip 'Set Node Storage Area' pixmap "$!<bnodePixmap>" width $!<iconSize> height $!<iconSize>
    text   .nodes tooltip 'Node Storage Area' width 25 string
    !!appDesMain.nodes.setEditable(false)
    !!appDesMain.nodes.val = 'Unset'
  exit
  !!appTbarCntrl.addToolbar('stlwrkToolbar', 'STLWRK')
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  --   -- -------------------- Create Fittings --------------------
  !menu = object APPMENU('stlwrkCrtFitt')
  !menu.add('CALLBACK', |Single...|, |CALLSTL XFITSPEC CREATE FITT|, 'Single')
  !menu.add('CALLBACK', |Compound...|, |CALLSTL XFITSPEC CREATE CMFI|, 'Compound')
  !menu.add('CALLBACK', |Sub-Compound...|, |CALLSTL XFITSPEC CREATE SBFI|, 'SubCompound')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --   -- ----------------------- Create Sections ----------------------
  !menu = object APPMENU('CRTSCTN')
  !menu.add('CALLBACK', |Straight...|, |!!stlSection.createSCTN()|, 'Straight')
  !menu.add('CALLBACK', |Curved...|, |!!strGenSection.createSection()|, 'Curved')
  !menu.add('CALLBACK', |Ring...|, |!!strRingCreate.createSection()|, 'Ring')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Bracing configurations...|, 'CDBRACING', 'Bracingconfigurations')
  !menu.add('CALLBACK', |Multiple attached...|, |CALLSTL XSCTNCOPY|, 'Multipleattached')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Specials...|, 'CDSCTNCRT', 'Specials')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --   -- ----------------------- Create Menu ----------------------
  --    -- Primitives
  !menu = object APPMENU('PRIMS')
  !menu.add('CALLBACK', |Positive...|, |CALLSTL XEXT true _CDLOOP|, 'Positive')
  !menu.add('CALLBACK', |Negative...|, |$$P Negative Loop Form|, 'Negative')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --    -- Loading Data
  !menu = object APPMENU('LOAD')
  !menu.add('CALLBACK', |Single Point|, |$$P Load Point|, 'SinglePoint')
  !menu.add('CALLBACK', |Distributed|, |$$P Distributed|, 'Distributed')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --    -- Nodes
  !menu = object APPMENU('MNODE')
  !menu.add('CALLBACK', |Primary...|, |$$P Primary Node Form|, 'Primary')
  !menu.add('CALLBACK', |Secondary...|, |$$P Secondary Node Form|, 'Secondary')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --   -- ------------------ Connections ------------------
  !menu = object APPMENU('CONN')
  !menu.add('CALLBACK', |Disconnect|, |call !!stlwrkConnect(false)|, 'stlwrkDisconnect')
  !menu.add('CALLBACK', |Connect|, |call !!stlwrkConnect(true)|, 'stlwrkConnect')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Trim to Pline|, 'PLINCONN', 'stlwrkTrimToPline')
  !menu.add('MENU', |Trim to Section|, 'SCTNCONN', 'stlwrkTrimToSection')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Joint Dominant|, |call !!stljointdomsub(true, '')|, 'stlwkrJointDominant')
  !menu.add('CALLBACK', |Joint Subordinate|, |call !!stljointdomsub(false, '')|, 'stlwrkJointSubordinate')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --      -- Pline Connection
  !menu = object APPMENU('PLINCONN')
  !menu.add('CALLBACK', |Pick|, |call !!stlWrkTrim(false, false, false, '')|, 'Pick')
  !menu.add('CALLBACK', |Pick (force)|, |call !!stlWrkTrim(true, false, false, '')|, 'Pick(force)')
  !menu.add('CALLBACK', |all attached|, |call !!stlWrkTrim(false, false, true, '')|, 'allAttached')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --      -- Section Connection
  !menu = object APPMENU('SCTNCONN')
  !menu.add('CALLBACK', |Pick|, |call !!stlWrkTrim(false, true, false, '')|, 'Pick')
  !menu.add('CALLBACK', |all attached|, |call !!stlWrkTrim(false, true, true, '')|, 'allattached')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --   -- ------------------ Position ------------------
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Extend|, 'EXTEND', 'Extend')
  !menu.add('CALLBACK', |Drag Explicitly...|, |CALLIBD X3DPOS $$<Drag Explicitly$$> CALLSTL MSCTNDRAG $$<$$> $$<$$> $$<$$>|, 'DragExplicitly')
  !menu.add('CALLBACK', |Align Secondary Nodes|, |CALLSTL MNODEALIGN|, 'AlignSecondaryNodes')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --     -- Extend Sections
  !menu = object APPMENU('EXTEND')
  !menu.add('FORM', |Through...|, 'CDSCTNEXT', 'Through')
  !menu.add('FORM', |By...|, 'CDEXTSCTN', 'By')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --   -- ------------------ Orientate ------------------
  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |B Angle|, 'BANG', 'BetaAngle')
  !menu.add('CALLBACK', |Flip|, |CALLSTL MFLIP|, 'stlwrkFlip')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --     -- Set Beta Angle
  !menu = object APPMENU('BANG')
  !menu.add('CALLBACK', |-180 Degrees|, |BANG -180|, '-180Degrees')
  !menu.add('CALLBACK', |-90 Degrees|, |BANG -90|, '-90Degrees')
  !menu.add('CALLBACK', |0 Degrees|, |BANG 0|, '0Degrees')
  !menu.add('CALLBACK', |90 Degrees|, |BANG 90|, '90Degrees')
  !menu.add('CALLBACK', |180 Degrees|, |BANG 180|, '180Degrees')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --   -- ------------------ Modify Menu ------------------
  --     -- Joint Modification
  !menu = object APPMENU('JOINT')
  !menu.add('CALLBACK', |Specification...|, |CALLSTL XJOINSPEC|, 'Specification')
  !menu.add('CALLBACK', |Position Line...|, |call !!stlsetplines('Position Line', 'POSL', 'SJOI SCOJ FIXING', 'SCTN GENSEC', 'NULL', 'Identify end of section or joint.')|, 'PositionLine')
  !menu.add('CALLBACK', |Joint Line...|, |call !!stlsetplines('Joint Line', 'JLIN', 'SJOI SCOJ FIXING', 'SJOI SCOJ SUBJ FIXING', 'NULL', 'Identify end of section or joint.')|, 'JointLine')
  !menu.add('MENU', |Joint Like|, 'JLIKE', 'JointLike')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  !menu = object APPMENU('JLIKE')
  !menu.add('CALLBACK', |Maintain Pline|, |call !!stljointlike(true)|, 'MaintainPline')
  !menu.add('CALLBACK', |Use copied Pline|, |call !!stljointlike(false)|, 'UseCopiedPline')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --     -- Fittings Modification
  !menu = object APPMENU('FITTS')
  !menu.add('CALLBACK', |Definition...|, |CALLSTL XFITSPEC MODIFY|, 'Definition')
  !menu.add('CALLBACK', |Position Line...|, |call !!stlsetplines('Position Line', 'POSL', 'FITT CMFI', 'SCTN', 'NULL', 'Identify fitting.')|, 'PositionLine')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --     -- Section Modifications
  !menu = object APPMENU('MSCTNS')
  !menu.add('CALLBACK', |Specification...|, |CALLSTL XSTLSPEC|, 'Specification')
  !menu.add('CALLBACK', |Definition...|, |call !!strSectionEdit(!!ce)|, 'Definition')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Justification...|, |call !!stlsetplines('Section Justification', 'JUSL', 'SCTN GENSEC', 'SCTN GENSEC', 'NULL', 'Identify section.')|, 'Justification')
  !menu.add('CALLBACK', |Member Line...|, |call !!stlsetplines('Section Member Line', 'MEML', 'SCTN GENSEC', 'SCTN GENSEC', 'NULL', 'Identify section.')|, 'MemberLine')
  !menu.add('CALLBACK', |Joint Line...|, |call !!stlsetplines('Joint Line', 'JLIN', 'SCTN GENSEC', 'SCTN GENSEC', 'NULL', 'Identify section.')|, 'JointLine')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Split...|, |show !!splitgensectpane|, 'Split')
  !menu.add('FORM', |Splice...|, 'CDSPLIT', 'Splice')
  !menu.add('CALLBACK',|Merge|,|!!mergeObject = object mergegensectpane('Merge')|,'Merge')
  !menu.add('CALLBACK',|Fillet...|,|!!mergeObject = object mergegensectpane('Fillet')|,'Fillet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |CutPlane...|, |CALLSTL XCUTPLANE|, 'CutPlane')
  !menu.add('CALLBACK', |Mitre Ends|, |call !!stlProfMitre()|, 'MitreEnds')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')

  --     -- Penetration modification
  --      --menu _MODPEN
  --      --  add |Items...|  |CALLPEN XMPENE ITEM|
  --      --  add |Holes...|  |CALLPEN XMPENE HOLE|
  --      --exit

endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.displayMenu()
--  !this.graphMenu()
  !this.utilsMenu()
  !this.settingsMenu()
  !this.queryMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
