------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Storage Areas...|, |strStorageAreas|, 'stlwrkStorageAreas')
  !menu.add('CALLBACK', |Tolerances...|, |!!stlTolerances.edit()|, 'stlwrkTolerances')
  if ($!!cdLnDesAdmin) then
    !menu.add('CALLBACK', |Draft Edge Defaults...|, |!!dradunion.edit()|, 'stlwrkDraftEdgeDefaults')
  endif
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Mark section|, |CALLSTL GSCTNTAG CE true|, 'Marksection')
  !menu.add('CALLBACK', |Unmark section|, |CALLSTL GSCTNTAG $$<$$> false|, 'Unmarksection')
  !!appMenuCntrl.addMenu(!menu, 'STLWRK')
endmethod
-- End of method definition for .settingsMenu()

