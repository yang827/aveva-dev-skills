------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .suppToolbar toolbar 'Hangers & Supports'
    -- !iconSize = !!comSysOpt.iconSize()
    !iconSize = 16
    -- Specification settings
    !bspecPixmap = !!pml.getPathName('hangerspec' & !iconSize & '.png')
    button .bHangSpec tooltip 'Set Default Hanger Specification' pixmap "$!<bspecPixmap>" width $!<iconSize> height $!<iconSize> form _CDHSPEC
    text   .hangSpec tooltip 'Default Hanger Specification' width 20 string
    !!appDesMain.hangSpec.setEditable(false)
    !!appDesMain.hangSpec.val = 'Unset'
    !bsspecPixmap = !!pml.getPathName('steelspec' & !iconSize & '.png')
    button .bSteelSpec tooltip 'Set Default Steel Specification' pixmap "$!<bsspecPixmap>" width $!<iconSize> height $!<iconSize> form _CDSSPEC
    text   .steelSpec tooltip 'Default Steel Specification' width 20 string
    !!appDesMain.steelSpec.setEditable(false)
    !!appDesMain.steelSpec.val = 'Unset'
    -- REST Storage
    !brestPixmap = !!pml.getPathName('reststorage' & !iconSize & '.png')
    button .bRest tooltip 'Set Restraint Storage Area' pixmap "$!<brestPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLSUP MSSREFDAT REST|
    text   .rests tooltip 'Restraint Storage Area' width 15 string
    !!appDesMain.rests.setEditable(false)
    !!appDesMain.rests.val = 'Unset'
    -- FRMW Storage
    !bfrmwPixmap = !!pml.getPathName('frmwstorage' & !iconSize & '.png')
    button .bFrmw tooltip 'Set Framework Storage Area' pixmap "$!<bfrmwPixmap>" width $!<iconSize> height $!<iconSize> callback |CALLSUP MSSREFDAT FRMW|
    text   .frmws tooltip 'Framework Storage Area' width 15 string
    !!appDesMain.frmws.setEditable(false)
    !!appDesMain.frmws.val = 'Unset'
  exit
  !!appTbarCntrl.addToolbar('suppToolbar', 'SUPP')

  frame .suppUtilitiesToolbar toolbar 'H&S Utilities'
    button .supsh toggle  tooltip 'Show Support Plane'  pixmap call |CALLSUP MSUPSHOW $$_SUPSH|
    button .maxsp         tooltip 'Maximum Span'        pixmap call |CALLSUP IMAXSPAN|
    button .supax         tooltip 'Support Axes'        pixmap call |show _CDSBFRAX|
    button .sren          tooltip 'Rename Supports'     pixmap call |CALLSUP ISUPREN|
    button .smov          tooltip 'Move Support'        pixmap call |CALLSUP XSUPMOV MOVE|
    button .scop          tooltip 'Copy Support'        pixmap call |CALLSUP XSUPMOV COPY|
    button .msr           tooltip 'Measure Support'     pixmap call |show _CDSMEASURE|
    button .bldhs         tooltip 'Build Single Hanger' pixmap call |CALLSUP XSBUILD HANGER SINGLE|
    button .bldha         tooltip 'Build Hangers'       pixmap call |CALLSUP XSBUILD HANGER ALL|

    !!appDesMain.supsh.addPixmap(!!pml.getPathName('supportplane_on' & !iconSize & '.png'))
    !!appDesMain.maxsp.addPixmap(!!pml.getPathName('maximumspan' & !iconSize & '.png'))
    !!appDesMain.supax.addPixmap(!!pml.getPathName('supportaxes' & !iconSize & '.png'))
    !!appDesMain.sren.addPixmap(!!pml.getPathName('renamesupports' & !iconSize & '.png'))
    !!appDesMain.smov.addPixmap(!!pml.getPathName('movesupport' & !iconSize & '.png'))
    !!appDesMain.scop.addPixmap(!!pml.getPathName('copysupport' & !iconSize & '.png'))
    !!appDesMain.msr.addPixmap(!!pml.getPathName('measuresupport' & !iconSize & '.png'))
    !!appDesMain.bldhs.addPixmap(!!pml.getPathName('buildsinglehang' & !iconSize & '.png'))
    !!appDesMain.bldha.addPixmap(!!pml.getPathName('buildhangers' & !iconSize & '.png'))
  exit
  !!appTbarCntrl.addToolbar('suppUtilitiesToolbar', 'SUPP')


  frame .suppSupportToolbar toolbar 'H&S Support Creation'
    button .suppos    tooltip 'Position Support Plane'  pixmap call |CALLSUP XSUPCNTRL POSPLANE|
    button .crsup     tooltip 'Create Framework'        pixmap call |CALLSUP XSUPCNTRL CFRMW|
    button .crsbfr    tooltip 'Create SubFramework'     pixmap call |CALLSUP XSUPCNTRL CSBFR|
    button .crtemmem  tooltip 'Create Template Hangers' pixmap call |CALLSUP XSUPCNTRL CTEMM|
    button .conftem   tooltip 'Create Support Template' pixmap call |CALLSUP XSUPCNTRL CFTEM|
    button .modtem    tooltip 'Modify Support Template' pixmap call |CALLSUP XSUPCNTRL MODTEM|
    button .stran     tooltip 'Section Profiles'        pixmap call |CALLSUP XSUPCNTRL CALSEL|
    button .bldsup    tooltip 'Build Support'           pixmap call |CALLSUP XSUPCNTRL BLDSUP|

    !!appDesMain.suppos.addPixmap(!!pml.getPathName('positionsupportplane' & !iconSize & '.png'))
    !!appDesMain.crsup.addPixmap(!!pml.getPathName('createfrmw' & !iconSize & '.png'))
    !!appDesMain.crsbfr.addPixmap(!!pml.getPathName('createsbfr' & !iconSize & '.png'))
    !!appDesMain.crtemmem.addPixmap(!!pml.getPathName('createtemplatehangers' & !iconSize & '.png'))
    !!appDesMain.conftem.addPixmap(!!pml.getPathName('createsupporttemp' & !iconSize & '.png'))
    !!appDesMain.modtem.addPixmap(!!pml.getPathName('modifysupporttemp' & !iconSize & '.png'))
    !!appDesMain.stran.addPixmap(!!pml.getPathName('sectionprofiles' & !iconSize & '.png'))
    !!appDesMain.bldsup.addPixmap(!!pml.getPathName('buildsupport' & !iconSize & '.png'))
  exit
  !!appTbarCntrl.addToolbar('suppSupportToolbar', 'SUPP')

endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  -- $* Create Support Menu
  !menu = object APPMENU('CSUPPORT')
  !menu.add('CALLBACK', |Copy...|, |CALLSUP XSUPMOV COPY|, 'Copy')
  !menu.add('CALLBACK', |Framework...|, |CALLSUP MCRSUPP SUPPORT|, 'Framework')
  !menu.add('CALLBACK', |Subframework|, |CALLSUP MCRSUPP PLANE|, 'Subframework')
  !menu.add('CALLBACK', |Template...|, |CALLSUP XSUPCNTRL CFTEM|, 'Template')
  !menu.add('CALLBACK', |Members...|, |CALLSUP ISTEMCR|, 'Members')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Create Hanger Menu
  !menu = object APPMENU('CHANGER')
  !menu.add('CALLBACK', |Standard Config...|, |CALLSUP XSHOWHANG STD|, 'StandardConfig')
  !menu.add('CALLBACK', |User-Defined...|, |CALLSUP XSHOWHANG UD|, 'User-Defined')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Connect Menu
  !menu = object APPMENU('CONN')
  !menu.add('MENU', |Hanger|, 'CONHANG', 'suppHanger')
  !menu.add('FORM', |Component...|, 'CDCONN', 'suppComponent')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Position Menu
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('MENU', |Move|, 'MOVE', 'Move')
  !menu.add('MENU', |Drag|, 'DRAG', 'Drag')
  !menu.add('MENU', |Plane Move|, 'PLMOVE', 'PlaneMove')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Support Plane...|, 'CDSUPPOS', 'SupportPlane')
  !menu.add('CALLBACK', |Move Support...|, |CALLSUP XSUPMOV MOVE|, 'MoveSupport')
  !menu.add('MENU', |Component|, 'COMPPOS', 'Component')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Orientate Menu
  if (|$!!cdcnhsMode| eq |TEMPLATE|) then
    !menu = object APPMENU('ORI')
    !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
    !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
    !menu.add('SEPARATOR')
    !menu.add('MENU', |Component|, 'ORICOMP', 'Component')
    !menu.add('FORM', |Member...|, 'CDSTORI', 'Member')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')
  elseif (|$!!cdcnhsMode| eq |STRUCTURAL|) then
    !menu = object APPMENU('ORI')
    !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
    !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
    !menu.add('SEPARATOR')
    !menu.add('MENU', |Component|, 'ORICOMP', 'Component')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')
  endif

  !menu = object APPMENU('RELOAD')
  !menu.add('CALLBACK', |Standard Configs|, |CALLSUP ISUPPAPP RELOAD CFG|, 'StandardConfigs')
  !menu.add('CALLBACK', |Hanger Specs|, |CALLSUP ISUPPAPP RELOAD SPEC|, 'HangerSpecs')
  !menu.add('CALLBACK', |Support Steel|, |CALLSUP XSUPPSTL DEFAULT
   CALLSUP XSUPPSTL ALL STEELPRO
   CALLSUP XSUPPSTL ALL STLSPAC|, 'SupportSteel')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Control Menu
  !menu = object APPMENU('CONTROL')
  !menu.add('TOGGLE', 'Support Creation', '!this.suppSupportToolbar.visible = !this.suppSupportToolbar.visible.not()', 'SupportCreation')
  !menu.add('TOGGLE', 'General', '!this.suppUtilitiesToolbar.visible = !this.suppUtilitiesToolbar.visible.not()', 'General')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  !!appDesMain.control.callback = '!this.control.setFieldProperty(|SupportCreation|, |SELECTED|, !this.suppSupportToolbar.visible)
  !this.control.setFieldProperty(|General|, |SELECTED|, !this.suppUtilitiesToolbar.visible)'

  -- $* Build Menu
   !menu = object APPMENU('CLEAR')
  !menu.add('CALLBACK', |All|, |AID CLEAR ALL|, 'ClearAidAll')
  !menu.add('CALLBACK', |Text|, |AID CLEAR TEXT ALL|, 'ClearAidTexts')
  !menu.add('CALLBACK', |Line|, |AID CLEAR LINE ALL|, 'ClearAidLines')
  !menu.add('CALLBACK', |Axes|, |AXES OFF|, 'ClearAxis')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')
  !menu = object APPMENU('BUILD')
  !menu.add('CALLBACK', |Support|, |CALLSUP XSBUILD SUPPORT|, 'Support')
  !menu.add('MENU', |Hanger|, 'HANGBLD', 'Hanger')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  !menu = object APPMENU('HANGBLD')
  !menu.add('CALLBACK', |Single|, |CALLSUP XSBUILD HANGER SINGLE|, 'Single')
  !menu.add('CALLBACK', |All|, |CALLSUP XSBUILD HANGER ALL|, 'All')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Reconnect hanger
  !menu = object APPMENU('CONHANG')
  !menu.add('CALLBACK', |Head|, |CALLSUP XHCON HEAD|, 'Head')
  !menu.add('CALLBACK', |Tail|, |CALLSUP XHCON TAIL|, 'Tail')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Modify member menu
  !menu = object APPMENU('MODMEM')
  !menu.add('FORM', |Orientation...|, 'CDSTORI', 'Orientation')
  !menu.add('FORM', |Justification...|, 'CDSTJUST', 'Justification')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Move
  !menu = object APPMENU('MOVE')
  !menu.add('FORM', |Distance...|, 'CDMOVEDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDMOVETHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDMOVECLE', 'Clearance')
  !menu.add('FORM', |Towards...|, 'CDMOVETO', 'Towards')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Drag
  !menu = object APPMENU('DRAG')
  !menu.add('FORM', |Distance...|, 'CDDRAGDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDDRAGTHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDDRAGCLE', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Plane Move
  !menu = object APPMENU('PLMOVE')
  !menu.add('FORM', |Distance...|, 'CDMOPLDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDMOPLTHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDMOPLCLE', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Hanger Position
  !menu = object APPMENU('HANGPOS')
  !menu.add('FORM', |General...|, 'CDBRATG', 'General')
  !menu.add('FORM', |Distance...|, 'CDBRPOSDI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDBRPOSTH', 'Through')
  !menu.add('MENU', |Move|, 'HGMOVE', 'Move')
  !menu.add('MENU', |Drag|, 'HGDRAG', 'Drag')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Component Position
  !menu = object APPMENU('COMPPOS')
  !menu.add('FORM', |Distance...|, 'CDDIST', 'Distance')
  !menu.add('FORM', |Through...|, 'CDTHRO', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDCLEA', 'Clearance')
  !menu.add('FORM', |Plane Through...|, 'CDPLANE', 'PlaneThrough')
  !menu.add('FORM', |Plane Clearance...|, 'CDPLANECL', 'PlaneClearance')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Orientate Component
  !menu = object APPMENU('ORICOMP')
  !menu.add('FORM', |Leave...|, 'CDORILEA', 'Leave')
  !menu.add('FORM', |P-Point...|, 'CDORIOFF', 'Ppoint')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Modify Support
  !menu = object APPMENU('MODSUPP')
  !menu.add('CALLBACK', |Autoclassify...|, |CALLSUP XMSUPNAM|, 'Autoclassify')
  !menu.add('CALLBACK', |Configuration...|, |CALLSUP ISUPCFG|, 'Configuration')
  !menu.add('CALLBACK', |Template...|, |CALLSUP ITEMMOD|, 'Template')
  !menu.add('CALLBACK', |Reserved Volume...|, |CALLSUP IMPVOL|, 'ReservedVolume')
  !menu.add('MENU', |Attributes|, 'MODSUPATT', 'Attributes')
  !menu.add('CALLBACK', |Detail Text...|, |CALLSUP ISDTEX|, 'DetailText')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  if (|$!!cdcnhsMode| eq |TEMPLATE|) then
    --   $* Modify Hanger (TEMPLATE)
    !menu = object APPMENU('MODHANG')
    !menu.add('CALLBACK', |Configuration...|, |CALLSUP XMODHCON|, 'Configuration')
    !menu.add('FORM', |Attributes...|, 'CDHANGATT', 'Attributes')
    !menu.add('CALLBACK', |Anchor Point...|, |CALLSUP XHANGANCH|, 'AnchorPoint')
    !menu.add('FORM', |Spacer Profile...|, 'CDSTLSPAC', 'SpacerProfile')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')
  else
    --   $* Modify Hanger (STRUCTURAL)
    !menu = object APPMENU('MODHANG')
    !menu.add('CALLBACK', |Configuration...|, |CALLSUP XMODHCON|, 'Configuration')
    !menu.add('FORM', |Attributes...|, 'CDHANGATT', 'Attributes')
    !menu.add('FORM', |Spacer Profile...|, 'CDSTLSPAC', 'SpacerProfile')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')
  endif

  -- $* Hanger move
  !menu = object APPMENU('HGMOVE')
  !menu.add('FORM', |Distance...|, 'CDHGMOVDI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDHGMOVTH', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDHGMOVCL', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Hanger Drag
  !menu = object APPMENU('HGDRAG')
  !menu.add('FORM', |Distance...|, 'CDHGDRADI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDHGDRATH', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDHGDRACL', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Modify support attributes
  !menu = object APPMENU('MODSUPATT')
  !menu.add('CALLBACK', |Support...|, |CALLSUP FSUPATT|, 'Support')
  !menu.add('CALLBACK', |Support SBFR...|, |CALLSUP MSUPATT PLANE|, 'SupportSBFR')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')

  -- $* Defaults
  if ($!!cdlnhsAdmin) then
    !menu = object APPMENU('DFLTS')
    !menu.add('MENU', |Admin|, 'DFLTADM', 'Admin')
    !menu.add('MENU', |Application|, 'DFLTAPP', 'Application')
    !menu.add('MENU', |User|, 'DFLTUSR', 'User')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')

    !menu = object APPMENU('DFLTADM')
    !menu.add('FORM', |Main...|, 'CDHSDFLTS', 'Main')
    !menu.add('FORM', |Classification...|, 'CDHNCDFLTS', 'Classification')
    !menu.add('FORM', |Pipe ID...|, 'CDHIDFLTS', 'PipeID')
    !menu.add('FORM', |Materials...|, 'CDPMDFLTS', 'Materials')
    !menu.add('FORM', |ATTA Selection...|, 'CDATDFLTS', 'ATTASelection')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')

    !menu = object APPMENU('DFLTAPP')
    !menu.add('FORM', |Main...|, 'CDAPDFLTS', 'Main')
    !menu.add('FORM', |Support Atts...|, 'CDSADFLTS', 'SupportAtts')
    !menu.add('FORM', |Pipe Atts...|, 'CDPADFLTS', 'PipeAtts')
    !menu.add('FORM', |Max Span...|, 'CDMSDFLTS', 'MaxSpan')
    !menu.add('FORM', |HVAC...|, 'CDHVDFLTS', 'HVAC')
    !!appMenuCntrl.addMenu(!menu, 'SUPP')

    !menu = object APPMENU('DFLTUSR')
    !menu.add('FORM', |Main...|, 'CDHSUDFLTS', 'Main')
    if (|$!!cdcnhsMode| eq |TEMPLATE|) then
      !menu.add('FORM', |Frame...|, 'CDFRMDFLTS', 'Frame')
    endif
    !!appMenuCntrl.addMenu(!menu, 'SUPP')
  else
    !menu = object APPMENU('DFLTS')
    !menu.add('FORM', |Main...|, 'CDHSUDFLTS', 'Main')
    if (|$!!cdcnhsMode| eq |TEMPLATE|) then
      !menu.add('FORM', |Frame...|, 'CDFRMDFLTS', 'Frame')
    endif
    !!appMenuCntrl.addMenu(!menu, 'SUPP')
  endif

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
