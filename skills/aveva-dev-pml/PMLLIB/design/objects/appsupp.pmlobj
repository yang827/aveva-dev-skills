  !menu.add('MENU', |Member|, 'MODMEM', 'suppMember')
  !menu.add('MENU', |Hanger|, 'MODHANG', 'suppHanger')
  !menu.add('FORM', |Component...|, 'CDHCOMP', 'suppComponent')
