------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Storage Areas...|, 'CDSSREFDAT', 'suppStorageAreas')
  !menu.add('MENU', |Defaults|, 'DFLTS', 'suppDefaults')
  !menu.add('MENU', |Reload Specs|, 'RELOAD', 'suppReloadSpecs')
  !menu.add('FORM', |Choose Options...|, 'CDHCHOOSEO', 'suppChooseOptions')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('CALLBACK', 'Hangers & Supports...', |CALLG XUTILITIES $$<Hangers & Supports$$> $$<SUPP$$> $$<DES$$>|, 'HangersSupportsUtil')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Toolboxes|, 'CONTROL', 'Toolboxes')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Renumber...|, |CALLSUP ISUPREN|, 'Renumber')
  !menu.add('MENU', |Build|, 'BUILD', 'Build')
  !menu.add('CALLBACK', |Max Span...|, |CALLSUP IMAXSPAN|, 'MaxSpan')
  !menu.add('CALLBACK', |Steel Profiles...|, |CALLSUP IFCALSEL|, 'SteelProfiles')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Measure...|, 'CDSMEASURE', 'Measure')
  !menu.add('FORM', |Support Axes...|, 'CDSBFRAX', 'SupportAxes')
  !menu.add('MENU', |Clear Aid|, |CLEAR|, 'Clear')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Schedules...|, 'CDSUPPSCHED', 'Schedules')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Structure...|, |CALLG XCRTPURP STRU $$<Create Structure$$>|, 'Structure')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Support|, 'CSUPPORT', 'Support')
  !menu.add('MENU', |Hanger|, 'CHANGER', 'Hanger')
  !menu.add('FORM', |Component...|, 'CDHCOMP', 'Component')
  !!appMenuCntrl.addMenu(!menu, 'SUPP')
endmethod
-- End of method definition for .createMenu()

