--
--  Description:     Object for retrieving clash details based on its index
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  avaclash(REAL)                   -                   Constructor
--
define object AVACLASH

  --Clash index number
    member .clashIndex is REAL

  --Clash type (HH, HS, etc)
    member .clashType is STRING

  --Clash extent (Touching, Clash, Clearance)
    member .clashExtent is STRING

  --Clasher element reference
    member .clasher is DBREF

  --Clasher element type (tube)
    member .clasherType is STRING

  --Clashee element reference
    member .clashee is DBREF

  --Clashee element Type
    member .clasheeType is STRING

  --Clash position
    member .clashPosition is POSITION

--End of form definition
endobject
------------------------------------------------------------------------
--
-- Method:     avaclash
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]           [R/RW] [Data Type] [Description]
--   !clashIndex    R      REAL        Index of clash
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .avaclash(!clashIndex is REAL)

    --Get clash data
    var !tempType    CLASH $!clashIndex TYPE
    var !tempClasher CLASH $!clashIndex FIRST
    var !tempClashee CLASH $!clashIndex SECOND
    var !tempPos     CLASH $!clashIndex POSITION

    --Get the clash number
    !this.clashIndex = !clashIndex

    --Get the clash type and extent
    !this.clashType   = !tempType.split().first()
    !this.clashExtent = !tempType.split().last()

    --Get the clash items
    !splitClasher     = !tempClasher.split(' ')
    !this.clasher     = object DBREF(!splitClasher[1])
    !this.clasherType = !tempClasher

    !splitClashee     = !tempClashee.split(' ')
    !this.clashee     = object DBREF(!splitClashee[1])
    !this.clasheeType = !tempClashee

    --Get the clash position
    !this.clashPosition = object POSITION(!tempPos)

--End of method
endmethod
