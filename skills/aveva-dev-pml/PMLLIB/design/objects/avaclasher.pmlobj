--  branchesCheckTypeSet(STRING)     BOOLEAN
--  check()                          -
--  check(ARRAY)                     -
--  check(DBREF)                     -
--  clashCountGet()                  REAL
--  clashTypeGetAt(REAL)             ARRAY
--  clashesIgnoredGet()              ARRAY
--  clashesWithinIgnore(STRING)      BOOLEAN
--  clashesWithinInclude(STRING)     BOOLEAN
--  clearanceGet()                   REAL
--  clearanceSet(REAL)               BOOLEAN
--  colourMajorGet()                 STRING
--  colourMajorSet(STRING)           BOOLEAN
--  colourObstructGet()              STRING
--  colourObstructSet(STRING)        BOOLEAN
--  command(STRING)                  -                   Sets the Report option of: Report of Duplicate Clashes.
--  connectionsIgnore()              -
--  connectionsIgnore(STRING)        BOOLEAN
--  connectionsInclude()             -
--  end()                            -
--  exclusionAdd(DBREF)              BOOLEAN
--  exclusionClear()                 -
--  exclusionGetAt(REAL)             DBREF
--  exclusionListGet()               ARRAY
--  exclusionRemove(DBREF)           BOOLEAN
--  exclusionRemoveAt(REAL)          BOOLEAN
--  limitsAutoSet(ARRAY)             -
--  limitsAutoSet(DBREF)             -
--  limitsClear()                    -
--  limitsGet()                      ARRAY
--  limitsSet(DBREF,DBREF)           -
--  limitsSet(POSITION,POSITION)     -
--  midpointGet()                    BOOLEAN
--  midpointSet(BOOLEAN)             -
