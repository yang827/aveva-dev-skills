--  overrideSet(BOOLEAN)             -
--  reportLevelSet(ARRAY)            BOOLEAN
--  reportPositionSet(STRING)        BOOLEAN
--  reportSettingsGet()              -
--  reportSettingsSet(STRING,BOOLEAN) BOOLEAN
--  reportSignificantIgnore(STRING)  BOOLEAN
--  reportSignificantInclude(STRING) BOOLEAN
--  reportUnderSet(STRING)           BOOLEAN
--  restoreDefaults()                -
--  start()                          -
--  switchToBoolean(STRING)          BOOLEAN
--  touchesIgnore()                  -
--  touchesInclude()                 -
--  touchingGapGet()                 REAL
--  touchingGapSet(REAL)             BOOLEAN
--  touchingOverlapGet()             REAL
--  touchingOverlapSet(REAL)         BOOLEAN
--
define object AVACLASHER

   -- object members

   -- Report graphical feedback option: TRUE - ON , FALSE - OFF
   member .reportGraphical is BOOLEAN

   -- Report header option: TRUE - ON , FALSE - OFF
   member .reportHeader is BOOLEAN

   -- Report obstruction option: TRUE - ON , FALSE - OFF
   member .reportObstruct is BOOLEAN

   -- Report main body option: TRUE - ON , FALSE - OFF
   member .reportMain is BOOLEAN

   -- Report position option: WORLD , SITE , OFF
   member .reportPosition is STRING

   -- Report approved option: TRUE - ON , FALSE - OFF
   member .reportApproved is BOOLEAN

   -- Report reference option: TRUE - ON , FALSE - OFF
   member .reportReference is BOOLEAN

   -- Report number option: TRUE - ON , FALSE - OFF
   member .reportNumbering is BOOLEAN

   -- Report primary option: TRUE - ON , FALSE - OFF
   member .reportPrimary is BOOLEAN

   -- Report primary option: First , Second, Both
   member .reportDuplicate is STRING

   -- Report significant option: TRUE - ON , FALSE - OFF
   member .reportSignificant is BOOLEAN

   --Report significant list
   member .reportSignificantList is ARRAY

   -- Report Level option : Clashes, Touches, Clearances.
   member .reportLevels is ARRAY

   -- Report Format option : New , Default.
   member .reportFormat is STRING

   -- Report Macro option : TRUE - ON , FALSE - OFF
   member .reportMacro is BOOLEAN

   -- Report Macro option : TRUE - ON , FALSE - OFF
   member .reportSummary is BOOLEAN

endobject
------------------------------------------------------------------------
--
-- Method:  Start
--
-- Description: Start desclash.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .start()

  --Start desclash
  DESCLASH

endmethod
------------------------------------------------------------------------
--
-- Method:  End
--
-- Description: Exit desclash.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .end()

  --Stop desclash
  EXIT

endmethod
------------------------------------------------------------------------
--
-- Method:  SwitchToBoolean
--
-- Description: Transforms ON/OFF STRING to BOOLEAN.
--
-- Method Type: Function
-- Arguments:
--   [#]       [R/RW]   [Data Type]   [Description]
--    Option    R        STRING        value of: ON OFF
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       TRUE if argument is 'On'  , FALSE if argument is not 'On'
--
------------------------------------------------------------------------
define method .switchToBoolean(!option is STRING) is BOOLEAN

  if (!option eq 'On'or !option eq 'ON') then
     return TRUE
  else
     return FALSE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:  Check
--
-- Description: Checks all elements for clashes.
--
-- Method Type: Procedure
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .check()

  --Check element
  CHECK ALL

endmethod
------------------------------------------------------------------------
--
-- Method:  Check
--
-- Description: Checks element or group for clashes.
--
-- Method Type: Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]  [Description]
--   !element    R      DBREF        element or group to check
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .check(!element is DBREF)

  --Check element
  CHECK $!element

endmethod
------------------------------------------------------------------------
--
-- Method:  Check
--
-- Description: Checks elements from ARRAY for clashes.
--
-- Method Type: Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]            [Description]
--   !elements   R      ARRAY of DBREFs        elements to check
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .check(!elements is ARRAY)

  --Declare variables
  !elementsList = object STRING()
  !elementsList = ''

  --Create STRING of DBREF arguments
  do !element values !elements
     !elementsList = !elementsList & ' ' & !element
  enddo

  --Check all elements from the list
  CHECK $!elementsList

endmethod
------------------------------------------------------------------------
--
-- Method:  BoxCheck
--
-- Description: Box checks all elements.
--
-- Method Type: Procedure
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .boxCheck()

  --Check element
  BOXCHECK ALL

endmethod
------------------------------------------------------------------------
--
-- Method:  BoxCheck
--
-- Description: Box checks element or group.
--
-- Method Type: Procedure
-- Arguments:
--   [#]       [R/RW] [Data Type]  [Description]
--   !element   R      DBREF        element or group to boxcheck,
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .boxCheck(!element is DBREF)

  --Check element
  BOXCHECK $!element

endmethod
------------------------------------------------------------------------
--
-- Method:  BoxCheck
--
-- Description: Box checks elements from ARRAY.
--
-- Method Type: Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]            [Description]
--   !elements   R      ARRAY of DBREFs        elements to check
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .boxCheck(!elements is ARRAY)

  --Declare variables
  !elementsList = object STRING()
  !elementsList = ''

  --Create STRING of DBREF arguments
  do !element values !elements
     !elementsList = !elementsList & ' ' & !element
  enddo

  --Check all elements from the list
  BOXCHECK $!elementsList

endmethod
------------------------------------------------------------------------
--
-- Method:  AddCheck
--
-- Description: Check adds all elements.
--
-- Method Type: Procedure
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addCheck()

  --Check element
  CHECKADD ALL

endmethod
------------------------------------------------------------------------
--
-- Method:  AddCheck
--
-- Description: Checks and adds elements from the list.
--
-- Method Type: Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]          [Description]
--   !elements   R      ARRAY of DBREFs      elements to check
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addCheck(!elements is ARRAY)

  --Declare variables
  !elementsList = object STRING()
  !elementsList = ''

  --Create STRING of DBREF arguments
  do !element values !elements
     !elementsList = !elementsList & ' ' & !element
  enddo

  --Check all elements from the list
  CHECKADD $!elementsList

endmethod
------------------------------------------------------------------------
--
-- Method:      ObstructionAdd
--
-- Description: Adds element to obstruction list. Returns FALSE if element
--              was not added.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
--   !element [R]    DBREF       Element that is to be added to the list.
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     TRUE if element has been added.
--
------------------------------------------------------------------------
define method .obstructionAdd(!element is DBREF) is BOOLEAN

   !world = /*

   --Adds element to obstruction list
   if (!element eq !world) then
      OBST All
   else
      OBST $!element

      --handle if element is already in the obstruction list or Currently OBS ALL
      handle (69,8)
         return FALSE
      elsehandle (69,67)
         return FALSE
      elsehandle ANY
         return ERROR NOALERT
      endhandle

   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      ObstructionRemove
--
-- Description: Removes element from obstruction list. Returns FALSE if
--              element was not on the list and cannot be removed.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
--   !element [R]    DBREF       Element that is to be removed from the list.
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     FALSE if element is not on the list.
--
------------------------------------------------------------------------
define method .obstructionRemove(!element is DBREF) is BOOLEAN

   --Removes element from obstruction list (if not unset or empty)
   if (!element.set()) then

      !world = /*

      if (!element eq !world) then
         REM OBST ALL
         return TRUE
      endif

      REM OBST $!element
      return TRUE

   endif
   --handle if element is not on the list
   handle (69,11)
      return FALSE
   endhandle

   return FALSE

endmethod
------------------------------------------------------------------------
--
-- Method:      ObstructionRemoveAt
--
-- Description: Removes element at given index from obstruction list. Returns
--              TRUE if the element was successfully removed from the obstruction list.
--
-- Method Type: Function
-- Arguments:
--   [#]    [R/RW] [Data Type] [Description]
--   !index [R]    REAL        Index of element from the list.
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     TRUE if Element has been removed from the obstruction list.
--
------------------------------------------------------------------------
define method .obstructionRemoveAt(!index is REAL) is BOOLEAN

   --Get the element pointed by index as DBREF
   !element = !this.obstructionGetAt(!index)

   --Removes the element from the obstruction list
   return !this.obstructionRemove(!element)

endmethod
------------------------------------------------------------------------
--
-- Method:      ObstructionClear
--
-- Description: Clears obstruction list (what means ALL).
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .obstructionClear()

  --Clears obstruction list (what means ALL)
  REM OBST ALL

endmethod
------------------------------------------------------------------------
--
-- Method:      ObstructionGetAt
--
-- Description: Provides elements at given index. If an element with the given
--              index does not exit, an unset DBREF element is returned.
--
-- Method Type: Function
-- Arguments:
--   [#]    [R/RW] [Data Type] [Description]
--   !index [R]    REAL        Index of element from the list.
-- Return:
--   [Data Type] [Description]
--   DBREF       DBREF of the element given by the index.
--
------------------------------------------------------------------------
define method .obstructionGetAt(!index is REAL) is DBREF

   --Gets the obstruction list, takes the element given by the index and converts it to DBREF format
   !obstructionList = !this.obstructionListGet()

   --Returns a DBREF of the element given by the index or returns empty DBREF object if index number is incorrect
   if (!obstructionList.size() ge !index) then
      !element = !obstructionList[!index]
   else
      !unsetDB = object DBREF()
      return !unsetDB
   endif

   return !element

endmethod
------------------------------------------------------------------------
--
-- Method:      ObstructionListGet
--
-- Description: Provides ARRAY of element defining obstruction list. If the
--              obstruction list is empty an unset and empty ARRAY is returned.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       ARRAY of DBREFs defining obstruction list.
--
------------------------------------------------------------------------
define method .obstructionListGet() is ARRAY

   --Provides ARRAY of STRINGs defining obstruction list
   --VAR !obstructionSTRING CLASH OBST
   --!obstructionARRAYList = !obstructionSTRING.split(' ')
   VAR !obstructionARRAYList SPLIT CLASH OBST

   --Checks if obstruction list is empty and return empty and unset ARRAY or if consists of all elements and return worl (/*)
   if (!obstructionARRAYList.size() eq 1 and !obstructionARRAYList[1] eq 'None') then
      !emptyARRAY = ARRAY()
      return !emptyARRAY
   elseif (!obstructionARRAYList.size() eq 1 and !obstructionARRAYList[1] eq 'All') then
      !obstructionARRAYList[1] = '/*'
   endif

   --Converts ARRAY of STRINGs to ARRAY of DBREF for obstruction list
   !obstructionList = ARRAY()
   do !index indices !obstructionARRAYList
      !obstructionList.append(!obstructionARRAYList[!index].dbref())
      handle ANY
      endhandle
   enddo

   return !obstructionList.unique()

endmethod
------------------------------------------------------------------------
--
-- Method:      ExclusionAdd
--
-- Description: Adds element to exclusion list. Returns FALSE if the element
--              is already on the list.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
--   !element [R]    DBREF       Element that is to be added to the exclusion list.
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     FALSE if element is already in the exclusion list.
--
------------------------------------------------------------------------
define method .exclusionAdd(!element is DBREF) is BOOLEAN

 --Adds element to exclusion list
   EXCL $!element

 --handle if element is already in the exclusion list
   handle (69,80)
      return FALSE
   elsehandle ANY
      return ERROR NOALERT
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      ExclusionRemove
--
-- Description: Removes element from exclusion list. Returns FALSE if the
--              elements is not on the exclusions list.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW] [Data Type] [Description]
--   !element [R]    DBREF       DBREF of the element from the exclusion list.
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     FALSE if element is not at the exclusion list.
--
------------------------------------------------------------------------
define method .exclusionRemove(!element is DBREF) is BOOLEAN

   --Removes element from exclusion list
   REM EXCL $!element

   --handle if element is not at the exclusion list
   handle (69,81)
      return FALSE
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      ExclusionRemoveAt
--
-- Description: Removes element at given index from exclusion list. Returns
--              TRUE if the element was successfully removed.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--   !index  [R]    REAL        Index of element from the list.
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     TRUE if element has been removed from the exclusion list.
--
------------------------------------------------------------------------
define method .exclusionRemoveAt(!index is REAL) is BOOLEAN

 --Get the element pointed by index as DBREF
   !element = !this.exclusionGetAt(!index)

 --Removes the element from the exclusion list
   return !this.exclusionRemove(!element)

endmethod
------------------------------------------------------------------------
--
-- Method:      ExclusionClear
--
-- Description: Clears obstruction list (what means ALL).
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exclusionClear()

 --Clears obstruction list (what means ALL)
   REM EXCL ALL

endmethod
------------------------------------------------------------------------
--
-- Method:      ExclusionGetAt
--
-- Description: Provides elements at given index. If there is no element
--              with the specified index as unset element is returned.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--   !index  [R]    REAL        Index of element from the list.
-- Return:
--   [Data Type] [Description]
--   DBREF       DBREF of the element given by the index.
--
------------------------------------------------------------------------
define method .exclusionGetAt(!index is REAL) is DBREF

 --Gets the exclusion list, takes the element given by the index and converts it to DBREF format
   !exclusionList = !this.exclusionListGet()

 --Returns a DBREF of the element given by the index or returns empty DBREF object if index number is incorrect
   if (!exclusionList.size() ge !index) then
      !element = !exclusionList[!index]
   else
      !unsetDB = object DBREF()
      return !unsetDB
   endif

   return !element

endmethod
------------------------------------------------------------------------
--
-- Method:      ExclusionListGet
--
-- Description: Provides ARRAY of element defining exclusion list. If there
--              are no elements on the exclusion list an unset and empty
--              ARRAY is returned.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       ARRAY of DBREFs defining exclusion list.
--
------------------------------------------------------------------------
define method .exclusionListGet() is ARRAY

 --Provides ARRAY of element defining exclusion list
 --  VAR !exclusionSTRING CLASH EXCL
 --  !exclusionARRAYList = !exclusionSTRING.split(' ')
 VAR !exclusionARRAYList SPLIT CLASH EXCL

 --Checks if obstruction list is empty and return empty and unset ARRAY
   if (!exclusionARRAYList.size() eq 1 and !exclusionARRAYList[1] eq 'None') then
      !emptyARRAY = ARRAY()
      return !emptyARRAY
   endif

 --Converts ARRAY of STRINGs to ARRAY of DBREF for obstruction list
   !exclusionList = ARRAY()
   do !index indices !exclusionARRAYList
      !exclusionList.append(!exclusionARRAYList[!index].dbref())
      handle ANY
      endhandle
   enddo

   return !exclusionList.unique()

endmethod
------------------------------------------------------------------------
--
-- Method: RestoreDefaults
--
-- Description: Method for setting the clash system defaults.
--
-- Method Type: Procedure
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .restoreDefaults()

   -- Restoring defaults

   !!runMacro('%PDMSUI%\des\clasher\dclasher','true true')
   handle any
      write |Missing Clasher System Defaults macro file ('%PDMSUI%\des\clasher\dclasher')|
   endhandle

endmethod
------------------------------------------------------------------------
--
-- Method: OverrideSet
--
-- Description: Method for setting the clash override option.
--
-- Method Type: Function
-- Arguments:
--   [#]    [R/RW]   [Data Type]   [Description]
--   !set   R        BOOLEAN       TRUE - OVERRIDE ON, FALSE - OVERRIDE OFF
-- Return:
--   [Data Type] [Description]
--    STRING      Colour name e.g brightred, black
--
------------------------------------------------------------------------
define method .overrideSet(!set is BOOLEAN)

   --Setting the clash override option
   if(!set eq TRUE) then
      OVERRIDE ON
   else
      OVERRIDE OFF
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: ColourMajorSet
--
-- Description: Method for setting the clash major colour for graphical representation.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--    Colour  R        STRING        Colour name e.g brightred, black
-- Return:
--   [Data Type] [Description]
--    BOOLEAN       TRUE - No errors , FALSE - Errors found. - WRONG COLOUR NAME
--
------------------------------------------------------------------------
define method .colourMajorSet(!colour is STRING) is BOOLEAN

   -- Set the Clash major representation colour
   COLOUR CLASH $!colour

   handle any
      return FALSE
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ColourObstructSet
--
-- Description: Method for setting the clash obstruction items colour for graphical representation.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--    Colour  R        STRING        Colour name e.g brightred, black
-- Return:
--   [Data Type] [Description]
--    BOOLEAN       TRUE - No errors , FALSE - Errors found. - WRONG COLOUR NAME
--
------------------------------------------------------------------------
define method .colourObstructSet(!colour is STRING) is BOOLEAN

   -- Set the Clash obstruction items representation colour
   COLOUR OBST $!colour

   handle any
      return FALSE
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ColourObstructGet
--
-- Description: Method for Getting the clash obstruction items colour for graphical representation.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Colour name e.g brightred, black
--
------------------------------------------------------------------------
define method .colourObstructGet() is STRING

   -- Get the Clash obstruction items representation colour
   var !colour COLOUR OBST

   return !colour

endmethod
------------------------------------------------------------------------
--
-- Method: ColourMajorGet
--
-- Description: Method for Getting the clash major colour for graphical representation .
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Colour name e.g brightred, black
--
------------------------------------------------------------------------
define method .colourMajorGet() is STRING

   -- Get the Clash major representation colour
   var !colour COLOUR CLASH

   return !colour

endmethod
------------------------------------------------------------------------
--
-- Method: MidpointSet
--
-- Description: Method for setting the midpoint clash option.
--
-- Method Type: Procedure
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--    !set    R        BOOLEAN       TRUE - MIDPOINT ON , FALSE - MIDPOINT OFF.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .midpointSet(!set is BOOLEAN)

   -- Setting the midpoint option
   if(!set) then
      MIDPOINT ON
   else
      MIDPOINT OFF
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: MidpointGet
--
-- Description: Method for checking the setting of midpoint clash option.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       TRUE - MIDPOINT ON , FALSE - MIDPOINT OFF.
--
------------------------------------------------------------------------
define method .midpointGet() is BOOLEAN

   -- Checking the midpoint option
   var !check CLASH MIDPOINT

   -- Setting the return value
   if(!check eq 'ON') then
      return TRUE
   else
      return FALSE
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: TouchingOverlapSet
--
-- Description: Method sets the touch overlap value.
--
-- Method Type: Function
-- Arguments:
--   [#]         [R/RW]  [Data Type]   [Description]
--    !overlap    R       REAL          Touch overlap value.
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       TRUE - Acceptable !overlap value , FALSE - Wrong !overlap value.
--
------------------------------------------------------------------------
define method .touchingOverlapSet(!overlap is REAL) is BOOLEAN

   --Set the touch overlap value
   TOUCH OVER $!overlap

   --Overlap value must be greater than Touching gap
   handle any
      return FALSE
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: TouchingOverlapGet
--
-- Description: Method to read the current clash overlap value.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]   [Description]
--    REAL          Current clash overlap value.
--
------------------------------------------------------------------------
define method .touchingOverlapGet() is REAL

   -- read the overlap value
   var !overlap CLASH TOUching OVErlap

   return !overlap.real()

endmethod
------------------------------------------------------------------------
--
-- Method: TouchingGapSet
--
-- Description: Method sets the clash touch gap value.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--    !gap    R        REAL          Touch gap value.
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       TRUE - Acceptable !gap value , FALSE - Wrong !gap value.
--
------------------------------------------------------------------------
define method .touchingGapSet(!gap is REAL) is BOOLEAN

   --Set the touch gap value
   TOUCH GAP $!gap

   -- Touch gap value must be lower  than Clearance and  Overlap
   handle any
      return FALSE
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: TouchingGapGet
--
-- Description: Method to read the current clash touch gap value.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]   [Description]
--    REAL          Current clash touch gap value.
--
------------------------------------------------------------------------
define method .touchingGapGet() is REAL

   -- read the gap value
   var !gap CLASH TOUching GAP

   return !gap.real()

endmethod
------------------------------------------------------------------------
--
-- Method: ClearanceSet
--
-- Description: Method sets the clash clearance value.
--
-- Method Type: Function
-- Arguments:
--   [#]           [R/RW]   [Data Type]   [Description]
--    !clearance    R        REAL          Touch gap value.
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN      TRUE - Acceptable !clearance value , FALSE - Wrong !clearance value.
--
------------------------------------------------------------------------
define method .clearanceSet(!clearance is REAL) is BOOLEAN

   -- Set the touch clearance value
   CLEARANCE $!clearance

   -- Clearance value must be greater than Touching gap
   handle any
      return FALSE
   endhandle

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ClearanceGet
--
-- Description: Method to read the current clash clearance value.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]   [Description]
--    REAL          Current clash clearance value.
--
------------------------------------------------------------------------
define method .clearanceGet() is REAL

   -- read the clearance value
   var !clearance CLASH Clearance

   return !clearance.real()

endmethod
------------------------------------------------------------------------
--
-- Method: ClashesWithinIgnore
--
-- Description: Method to set Ignored clashes within selected Type.
--              If the supplied type is valid TRUE is returned.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--   !type    R        STRING        One of significant types e.g SIT ZON PIP BRA EQU STR SUBS HANG RESTR PTR FRMW SBFRM.
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .clashesWithinIgnore(!type is STRING) is BOOLEAN

   if (!type.set()) then
      -- add the Type argument to IGNORE list
      NOCheck WIThin $!type
      handle any
         return FALSE
      endhandle
   else
      return FALSE
   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ClashesWithinInclude
--
-- Description: Method to restore clash checking within selected Type.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW]   [Data Type]   [Description]
--    !type    R        STRING        One of significant types e.g SIT ZON PIP BRA EQU STR SUBS HANG RESTR PTR FRMW SBFRM.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .clashesWithinInclude(!type is STRING) is BOOLEAN

   if (!type.set()) then
      -- Restores clash checking within the !type argument
      WIThin $!type
      -- Element !type is not in the list of those set for NOCHECK
      handle any
         return FALSE
      endhandle

   else
      -- !!alert.error('$!type is not a significant type for CLASH RESTORE')
      return FALSE
   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ClashesIgnoredGet
--
-- Description: Method to get types ignored within CLASH check.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]   [Description]
--    ARRAY         ARRAY of STRINGs representing ignored types.
--
------------------------------------------------------------------------
define method .clashesIgnoredGet() is ARRAY

   -- ARRAY of STRINGs representing ignored types
   !list = ARRAY()

   -- get the STRING with ignored types
   var !string clash ignore

   --  create ARRAY of STRINGs representing ignored types
   !list = !string.split()

   return !list

endmethod
------------------------------------------------------------------------
--
-- Method: ConnectionsIgnore
--
-- Description: Method to set clashes to ignore  connections checking of the argument Type.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW]   [Data Type]   [Description]
--    !type    R        STRING        Type of IGNORE CONN SYNTAX: 'ALL' 'WITHSPEC'
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .connectionsIgnore(!type is STRING) is BOOLEAN

   if (!type eq 'ALL') then
      -- ignore all connections during subsequent clash checking
      IGNORE CONNECTIONS
   elseif (!type eq 'WITHSPEC') then
       -- ignore connections with specifications defined
      IGNORE CONNECTIONS WITH SPECIFICATIONS
   else
      return FALSE
   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ConnectionsIgnore
--
-- Description: Method to set clashes to ignore all connections checking at steelwork junctions.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .connectionsIgnore()

   -- ignore all connections during subsequent clash checking
   IGNORE CONNECTIONS

endmethod
------------------------------------------------------------------------
--
-- Method: ConnectionsInclude
--
-- Description: Method includes all steelwork connections during subsequent clash checking.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .connectionsInclude()

   -- include all steelwork connections during subsequent clash checking
   INCLUDE CONNECTIONS

endmethod
------------------------------------------------------------------------
--
-- Method: TouchesIgnore
--
-- Description: Method sets to Ignore all touches during subsequent clash checking.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .touchesIgnore()

   -- Ignore all touches
   IGNORE TOUCHES

endmethod
------------------------------------------------------------------------
--
-- Method: TouchesInclude
--
-- Description: Method restores the default situation, where touches are detected and stored with the current clash list.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .touchesInclude()

   -- Include all touches
   INCLUDE TOUCHES

endmethod
------------------------------------------------------------------------
--
-- Method: BranchesCheckTypeSet
--
-- Description: Method sets BRANCH CHECKING - OPTION.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW]   [Data Type]   [Description]
--   !type    R        STRING        BRANCH CHECKING OPTIONS: 'ACHECK' 'BCHECK'.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .branchesCheckTypeSet(!type is STRING) is BOOLEAN

   if (!type eq 'ACHECK') then
      -- *** BRANCH CHECKING - OPTION A ***
      BRANCH A
   elseif (!type eq 'BCHECK') then
      -- *** BRANCH CHECKING - OPTION B ***
      BRANCH B
   else
      return FALSE
   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: BranchesCheckTypeGet
--
-- Description: Method that checks the branch type.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Branch check type : 'ACHECK' 'BCHECK'
--
------------------------------------------------------------------------
define method .branchesCheckTypeGet() is STRING

   -- get the Branch Check Type
   var !type CLASH options

   return !type

endmethod
------------------------------------------------------------------------
--
-- Method:  LimitsSet
--
-- Description: Set volumetric limits based on two corners.
--
-- Method Type: Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type] [Description]
--   !position1  R      POSITION    First corner position.
--   !position2  R      POSITION    Second corner position.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsSet(!position1 is POSITION, !position2 is POSITION)

 --Set limits
   LIMITS $!position1 TO $!position2

endmethod
------------------------------------------------------------------------
--
-- Method:  LimitsSet
--
-- Description: Sets corners of box to origins of named elements.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]         [Description]
--   !element1   R      DBREF               First element which origin is taken to make limits.
--   !element2   R      DBREF               Second element which origin is taken to make limits.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsSet(!element1 is DBREF, !element2 is DBREF)

 --Set limits
   LIMITS $!element1 TO $!element2

endmethod
------------------------------------------------------------------------
--
-- Method:  LimitsAutoSet
--
-- Description: Set limits box encapsulating all given elements.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]         [Description]
--   !element   R      DBREF                Element which is taken to define limits using AUTO function.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsAutoSet(!element is DBREF)


 --Set limits
   AUTO $!element

endmethod
------------------------------------------------------------------------
--
-- Method:  LimitsAutoSet
--
-- Description: Set limits box encapsulating all given elements.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]        [R/RW] [Data Type]         [Description]
--   !elements   R      ARRAY of DBREFs     Elements which are taken to define limits.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsAutoSet(!elements is ARRAY)

 --Declare variables
   !elementsList = object STRING()
   !elementsList = ''

 --Create STRING of DBREF arguments
   do !element values !elements
      !elementsList = !elementsList & ' ' & !element
   enddo

 --Set limits
   AUTO $!elementsList

endmethod
------------------------------------------------------------------------
--
-- Method:  LimitsGet
--
-- Description: Gets limits. If limits are set to NONE returns an empty and unset ARRAY.
--
-- Method Type: Function
-- Arguments:
--   [#]        [R/RW] [Data Type]         [Description]
-- Return:
--   [Data Type] [Description]
--   ARRAY       ARRAY of two positions, in limits are set
--               to NONE the ARRAY has unset elements.
--
------------------------------------------------------------------------
define method .limitsGet() is ARRAY

   --Declare variables
   !positionARRAY = ARRAY()


   --Get limits from clasher
   var !tempPos CLASH LIMITS

   if (!tempPos eq 'None') then
      return !positionARRAY
   else
      !tempPos1 = !tempPos.before(' to ')
      !tempPos2 = !tempPos.after(' to ')
      !positionARRAY[1] = object POSITION(!tempPos1)
      !positionARRAY[2] = object POSITION(!tempPos2)
   endif

   return !positionARRAY

endmethod
------------------------------------------------------------------------
--
-- Method:  LimitsClear
--
-- Description: Clear set limits.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsClear()

   --Set limits
   LIMITS NONE

endmethod
------------------------------------------------------------------------
--
-- Method:  ClashCountGet
--
-- Description:  Returns number of clashes.
--
-- Method Type: Function
-- Arguments:
--   [#]      [R/RW]   [Data Type]   [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Number of clashes of type !type.
--
------------------------------------------------------------------------
define method .clashCountGet() is REAL
   --Define variables
   !clashCountAll = 0

   do
      !clashCountAll = !clashCountAll + 1
      var !tempType CLASH $!clashCountAll TYPE
      handle (69,111)
         !clashCountAll = !clashCountAll - 1
         break
      endhandle
   enddo

   return !clashCountAll

endmethod
------------------------------------------------------------------------
--
-- Method:  ClashTypeGetAt
--
-- Description: Retrieve the type of clash for the given clash index.
--
-- Method Type: Function
-- Arguments:
--   [#]         [R/RW] [Data Type] [Description]
--  !clashIndex    R       REAL      Index of the clash to be checked.
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] - clash type ('HH', 'HS', etc.)
--                [2] - clash extent ('touch', 'clearance', etc)
--
------------------------------------------------------------------------
define method .clashTypeGetAt(!clashIndex is REAL) is ARRAY

   --Variable definition
   !clashType = object ARRAY()

   --Get type of Clash
   var !tempType  CLASH $!clashIndex TYPE

   --Split clash type
   !clashType[1] = !tempType.split().first()
   !clashType[2] = !tempType.split().last()

   --Return type
   return !clashType

endmethod
------------------------------------------------------------------------
--
-- Method: ReportPositionSet
--
-- Description: Shows clash positions with regard to argument coordinates.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--    Type    R      STRING      Clash position with regard to: WORLD , SITE , OFF.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .reportPositionSet(!type is STRING) is BOOLEAN

   -- Case the !type of: WORLD, SITE, OFF
   if (!type eq 'WORLD') then
      -- Shows clash positions in World coordinates
      REPORT POSITION WORLD
      -- Set the avaclasher position member
      !this.reportPosition = 'WORLD'
   elseif (!type eq 'SITE') then
      -- Shows clash positions in Site coordinates
      REPORT POSITION SITE
      -- Set the avaclasher position member
      !this.reportPosition = 'SITE'
   elseif (!type eq 'OFF') then
      -- Suppresses clash positions
      REPORT POSITION OFF
      -- Set the avaclasher position member
      !this.reportPosition = 'OFF'
   else
      --!!alert.error('$!type is not a valid type for REPORT POSITION')
      return FALSE
   endif

   return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method: ReportSignificantInclude
--
-- Description: Method to add significant types in report significant option.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--   !type   R      STRING      Available sig's are: PTRA SITE ZONE PIPE REST FRMW SBFR SUBE SUBS STRU EQUI BRAN HANG
-- Return:
--   [Data Type]   [Description]
--   BOOLEAN       TRUE - successful, false - unsuccessful or unavailable if SIGNIFICANT option in OFF
--
------------------------------------------------------------------------
define method .reportSignificantInclude(!type is STRING) is BOOLEAN
   --check if SIGNIFICANT option is ON
   if(!this.reportSignificant eq TRUE) then
      if (!type.set()) then
         -- add the Type argument to SIGNIFICANT list
         SEC $!type
         handle any
            return FALSE
         endhandle
      else
         return FALSE
      endif
      -- Type added successfully
      return TRUE
   else
      --SIGNIFICANT option is OFF
      return FALSE
   endif
endmethod
------------------------------------------------------------------------
--
-- Method: ReportSignificantIgnore
--
-- Description: Method to remove significant types in report significant option.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--   !type   R      STRING      Available sig's are: PTRA SITE ZONE PIPE REST FRMW SBFR SUBE SUBS STRU EQUI BRAN HANG
-- Return:
--   [Data Type]   [Description]
--   BOOLEAN       TRUE - successful, false - unsuccessful or unavailable if SIGNIFICANT option in OFF
--
------------------------------------------------------------------------
define method .reportSignificantIgnore(!type is STRING) is BOOLEAN
   --check if SIGNIFICANT option is ON
   if(!this.reportSignificant eq TRUE) then
      if (!type.set()) then
         -- remove the Type argument from SIGNIFICANT list
         REMOVE SECTIONS $!type
         handle any
            return FALSE
         endhandle
      else
         return FALSE
      endif
      -- Type removed successfully
      return TRUE
   else
      --SIGNIFICANT option is OFF
      return FALSE
   endif
endmethod
------------------------------------------------------------------------
--
-- Method:  ReportSettingsGet
--
-- Description: Set the avaclasher members based on the system CLASH REPORT settings.
--
-- Method Type: Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reportSettingsGet()
   -- ARRAY of Report Level Settings
   !levels   = ARRAY()

   -- ARRAY of Report Settings
   !settings = ARRAY()

   -- Creating a STRING of Report Level Settings
   var !reportSettings clash report

   -- Creating a STRING of Report Level Settings
   var !reportLevels clash report level

   -- Creating an ARRAY of Report Settings
   !settings = !reportSettings.split()

   -- Creating an ARRAY of Report Level Settings
   !levels   = !reportLevels.split()

   -- Removing the Levels setting from the Report Setting records
   !settings.removeFrom(11,!levels.size())

   -- Removing the ALL record from the Levels ARRAY
   !levels.removefirst()

   -- Setting the avaclasher REPORT OPTION members
   !this.reportGraphical   = !this.switchToBoolean(!settings[1].upcase())

   !this.reportHeader      = !this.switchToBoolean(!settings[2].upcase())

   !this.reportSummary     = !this.switchToBoolean(!settings[3].upcase())

   !this.reportMain        = !this.switchToBoolean(!settings[4].upcase())

   !this.reportPosition    = !settings[5].upcase()

   !this.reportObstruct    = !this.switchToBoolean(!settings[6].upcase())

   !this.reportNumbering   = !this.switchToBoolean(!settings[7].upcase())

   !this.reportApproved    = !this.switchToBoolean(!settings[8].upcase())

   !this.reportPrimary     = !this.switchToBoolean(!settings[9].upcase())

   !this.reportDuplicate   = !settings[10].upcase()

   !this.reportLevels      = !levels

   !this.reportReference   = !this.switchToBoolean(!settings[11].upcase())

   !this.reportMacro       = !this.switchToBoolean(!settings[12].upcase())

   !this.reportFormat      = !settings[13].upcase()

   if(!settings.size() lt 14) then
      !significant[1] = ''
      !this.reportSignificant = TRUE
      !this.reportSignificantList = !significant
   else
      if(!settings[14].upcase() eq 'OFF') then
         !this.reportSignificant = FALSE
         !this.reportSignificantList = ARRAY()
      else
         !significant = !settings.removeFrom(14, !settings.size() - 13)
         !this.reportSignificant = TRUE
         !this.reportSignificantList = !significant
      endif
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: ReportLevelSet
--
-- Description: Sets Report Level Options: Clashes Touches Clearances.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--    Types   R      ARRAY       Report Level Options: Clashes Touches Clearances.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN       TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .reportLevelSet(!types is ARRAY) is BOOLEAN

   -- Checking if there is anything to do
   if (!types.size() eq 0) then
      return FALSE
   endif

   -- Initialising the REPORT level option VALUE
   !levels = ''
   -- Initialising the Report option change flag: FALSE - wrong types in !types ARRAY
   !flag   = FALSE

   -- Checking the !types values
   !clashes    = !types.findFirst('Clashes')
   !clearances = !types.findFirst('Clearances')
   !touches    = !types.findFirst('Touches')

   -- Setting the Report level option values
   if (!clashes.set()) then
      !levels = !levels & ' Clashes'
      !flag = TRUE
   endif
   if ( !clearances.set()) then
      !levels = !levels & ' Clearances'
      !flag = TRUE
   endif
   if ( !touches.set()) then
      !levels = !levels & ' Touches'
      !flag = TRUE
   endif

   -- Applying the change of Report level options
   if (!flag) then
      REPORT ALL $!levels
      return TRUE
   else
      return FALSE
   endif

endmethod
------------------------------------------------------------------------
--
-- Method: ReportSettingsSet
--
-- Description: Sets Report Level Options: Clashes Touches Clearances.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--    Option  R      STRING      Report Options: HEADER OBSTRUCT MAIN APPROVED REF NUMBER PRIMARY SIGNIFICANT SUMMARY
--    Set     R      BOOLEAN     Report Option value: TRUE - On , FALSE - Off
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .reportSettingsSet(!option is STRING,!set is BOOLEAN) is BOOLEAN

   -- List of available report On/Off options
   !options = 'GRAPHICS HEADER OBSTRUCT MAIN APPROVED REF NUMBER PRIMARY SIGNIF SUMMARY'

   -- Creating an ARRAY of options
   !available = !options.split()

   -- Checking the value to be set
   if(!set eq TRUE) then
      !value = 'ON'
   else
      !value = 'OFF'
   endif

   -- Checking if the option from the argument is appropriate
   !case = !available.findFirst(!option)

   -- Changing the argument report option on the argument value and updating the avaclasher members
   if (!case.set()) then
      !opt = !available[!case]
      REPORT $!opt $!value
      !this.reportSettingsGet()
      return TRUE
   else
      return FALSE
   endif

endmethod

------------------------------------------------------------------------
--
-- Method:  ReportUnderSet
--
-- Description: Sets the Report option of: Report of Duplicate Clashes.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--    Type    R      STRING      Report of Duplicate Clashes: First, Second, Both
-- Return:
--   [Data Type] [Description]
--    BOOLEAN       TRUE - No errors , FALSE - Errors found.
--
------------------------------------------------------------------------
define method .reportUnderSet(!type is STRING) is BOOLEAN

   if (!type eq 'FIRST') then
      -- Report of Duplicate Clashes: First
      REPORT FIRST
      -- Set the avaclasher Duplicate member
      !this.reportDuplicate = 'FIRST'
   elseif (!type eq 'SECOND') then
      -- Report of Duplicate Clashes: Second
      REPORT SECOND
      -- Set the avaclasher Duplicate member
      !this.reportDuplicate = 'SECOND'
   elseif (!type eq 'BOTH') then
      -- Report of Duplicate Clashes: Both
      REPORT BOTH
      -- Set the avaclasher Duplicate member
      !this.reportDuplicate = 'BOTH'
   else
      --!!alert.error('$!type is not a valid type for Report of Duplicate Clashes')
      return FALSE
   endif

   return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:  command
--
-- Description: Sets the Report option of: Report of Duplicate Clashes.
--
-- Method Type: Function
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
--    Type    R      STRING      Action to be invoked on the clasher
-- Return:
--   [Data Type] [Description]
--    None
--
------------------------------------------------------------------------
define method .command(!command is STRING)

   $!command

endmethod
