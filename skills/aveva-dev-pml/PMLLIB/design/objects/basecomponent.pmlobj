-- Created:         14/12/2006 15:32
--
--
-- Description:
--    assembly object containing the original assembly item and eventually its replacement
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  basecomponent(DBREF,DBREF)       -
--  copycomponent()                  BOOLEAN             -
--
define object BASECOMPONENT

  member .origin        is DBREF
  member .newcomp       is DBREF
  member .type          is STRING
  member .cref          is DBREF
  member .crfa          is ARRAY
  member .href          is DBREF
  member .tref          is DBREF
  member .commandstring is ARRAY



endobject
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .basecomponent(!source is DBREF, !branch is DBREF)

!this.origin = !source
!this.type   = !source.type
!this.cref   = !source.cref
handle any
endhandle
!this.crfa = !source.crfa
handle any
endhandle

if !source.type.eq('BRAN') then
  !this.href    = !source.href
  !this.tref    = !source.tref
  !this.newcomp = !branch
else
   !this.copycomponent()
endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .copycomponent() is BOOLEAN

   !this.commandstring.append('NEW $!this.origin.type copy $!this.origin')
   NEW $!this.origin.type copy $!this.origin
   handle any
     -- in the unlikely event of it failing to copy, print the error to the command window
     --$P failed to create $$!this.origin.type copying $!this.origin
     !this.commandstring.append('Error: failed to copy like' )
     !this.newcomp = object DBREF()
     --$P error
   endhandle
   !this.newcomp = !!ce

endmethod
-------------------------------------------------------------------------------------------
