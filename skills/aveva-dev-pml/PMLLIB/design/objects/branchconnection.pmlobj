-- Created:         Fri Jan 23 09:00:00 GMT 2004
--
--
-- Description:
--    Branch connection information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  branchConnection(DBREF,STRING)   -                   Constructor
--  briefDescription()               STRING              Returns the brief textual description of the connection
--  connect(DBREF,STRING)            -                   Connect element to passed element and connection point
--  detailDescription()              ARRAY               Returns the detail textual description of the connection
--  updateElement()                  -                   Update element end with data position, direction, conn and bore
--
------------------------------------------------------------------------

define object BRANCHCONNECTION

  -- Branch Name
  member .branch        is DBREF

  -- End of branch
  member .end           is STRING

  -- Connection set
  member .set           is BOOLEAN

  -- Connection to other component
  member .reference     is DBREF

  -- Head/Tail of reference component
  member .referenceEnd  is STRING

  -- Connection Bore
  member .bore          is BORE

  -- Connection Position
  member .position      is POSITION

  -- Connection Direction
  member .direction     is DIRECTION

  -- Connection Type
  member .connection    is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      branchConnection
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element, either branch or below or only branch
--    2   R      STRING      End to extract information from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .branchConnection(!element is DBREF, !end is STRING)

  -- Initialise Variable
  !this.branch        = !element

  -- Branch head information
  if(!end.upcase() eq 'HEAD') then
    !this.end           = 'Head'
    !this.set           = !element.lHead
    !this.reference     = !element.hReference
    !this.referenceEnd  = !element.hEnd
    !this.bore          = !element.hBore
    !this.position      = !element.hPosition
    !this.direction     = !element.hDirection
    !this.connection    = !element.hConnection

    -- Branch tail information
  else
    !this.end           = 'Tail'
    !this.set           = !element.lTail
    !this.reference     = !element.tReference
    !this.referenceEnd  = !element.tEnd
    !this.bore          = !element.tBore
    !this.position      = !element.tPosition
    !this.direction     = !element.tDirection
    !this.connection    = !element.tConnection
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      briefDescription
--
-- Description: Returns the brief textual description of the connection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .briefDescription() is STRING

  -- Initialise variables
  !description      = 'unset'

  -- Unset end
  if(!this.set.not()) then
    !description    = 'undefined'

    -- If component is connected, then return the connection
  elseif (!this.reference.set()) then

    if !this.reference.badref() then
      !description = 'Unknown Reference'
      return !description
    endif

    -- Named reference
    if(!this.reference.isNamed) then
      !description  = !this.reference.flnm

    else
      !type         = !this.reference.fullType
      !description  = !type.substring(1,1) & !type.substring(2).lowcase() & ' ' & !this.reference.tysequence & ' of ' & !this.reference.owner.flnm
    endif

    if(!this.referenceEnd.set() and !this.referenceEnd.empty().not()) then
      !description  = !this.referenceEnd & ' of ' & !description
    endif

    if(!description.length() gt 20) then
      !description = !description.substring(1, 20) & '...'
    endif

    -- End is positioned
  elseif (!this.position.wrt(World).near(N0, 0.1mm).not()) then
    !description    = 'Positioned'

  endif

  -- Return
  return !description

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      detailDescription
--
-- Description: Returns the detail textual description of the connection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .detailDescription() is ARRAY

  -- Initialise variables
  -- Bore
  !description[1]     = 'unset'
  -- Connection Type
  !description[2]     = 'unset'
  -- Reference
  !description[3]     = 'unset'
  -- Direction
  !description[4]     = 'unset'
  -- Position information
  !description[5]     = 'unset'
  !description[6]     = 'unset'
  !description[7]     = 'unset'

  -- Unset end
  if(!this.set.not()) then
    !description[1]   = 'Undefined'
    !description[2]   = ''
    !description[3]   = 'Undefined'
    !description[4]   = ''
    !description[5]   = ''
    !description[6]   = ''
    !description[7]   = ''

    -- Define detailed information
  else

    -- Bore
    if (!!isImperialLength('BORE').not()) then
      !description[1]   = 'Bore: ' & !this.bore.string()
    else
      !description[1]   = 'Bore: ' & !this.bore.string(!!boreFmt)
    endif

    -- Connection
    !description[2]   = 'Connection Type: ' & !this.connection

    -- Reference
    if(!this.reference.set()) then

      if (!this.reference.badref()) then
        !name = 'Unknown Reference'
      elseif(!this.reference.isNamed) then
        !name         = !this.reference.flnm
      else
        !type         = !this.reference.fullType
        !name         = !type.substring(1,1) & !type.substring(2).lowcase() & ' ' & !this.reference.tysequence & ' of ' & !this.reference.owner.flnm
      endif
      if(!this.referenceEnd.set() AND !this.referenceEnd.empty().not()) then
        !name         = !this.referenceEnd & ' of ' & !name
      endif
      !name           = 'Connected to ' & !name
    else
      !name           = 'Unconnected'
    endif

    !description[3]   = !name

    -- Direction
    !direction        = 'Direction: ' & !this.direction.wrt(World)
    !description[4]   = !direction.string().before('WRT').trim()

    -- Position
    !position         = !this.position.wrt(World)

    var !coord coord
    if(!coord.eq('ENU'))then
      if(!position.east ge 0) then
        !x              = 'E'
      else
        !x              = 'W'
      endif
      if(!position.north ge 0) then
        !y              = 'N'
      else
        !y              = 'S'
      endif
      if(!position.up ge 0) then
        !z              = 'U'
      else
        !z              = 'D'
      endif
    else
      if(!position.east ge 0) then
        !x              = 'X'
      else
        !x              = '-X'
      endif
      if(!position.north ge 0) then
        !y              = 'Y'
      else
        !y              = '-Y'
      endif
      if(!position.up ge 0) then
        !z              = 'Z'
      else
        !z              = '-Z'
      endif
    endif
    !description[5]   = 'Position:   ' & !x & ' ' & !position.east.abs().string(!!distanceFmt)
    !description[6]   = '                ' & !y & ' ' & !position.north.abs().string(!!distanceFmt)
    !description[7]   = '                ' & !z & ' ' & !position.up.abs().string(!!distanceFmt)

  endif

  -- Return
  return !description

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateElement
--
-- Description: Update element end with data position, direction, conn and bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

  -- Initialise Variables
  !reference    = !!ce
  !!ce          = !this.branch

  -- Branch head information
  if(!this.end.upcase() eq 'HEAD') then
    !!ce.hBore = !this.bore
    handle ANY
    elsehandle NONE
      SELECT HSTU
    endhandle

    HPOSITION $!<this.position>
    HDIRECTION $!<this.direction>
    HCONNECTION $!<this.connection>
    handle ANY
    endhandle
    LHEAD TRUE

    -- Branch tail information
  else
    !!ce.tBore = !this.bore
    handle ANY
    endhandle
    TPOSITION $!<this.position>
    TDIRECTION $!<this.direction>
    TCONNECTION $!<this.connection>
    handle ANY
    endhandle
    LTAIL TRUE
  endif

  -- Return to reference
  !!ce  = !reference

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      connect
--
-- Description: Connect element to passed element and connection point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connect(!element is DBREF, !connectionPoint is STRING)

  -- Initialise Variables
  !reference  = !!ce
  !!ce        = !this.branch

  -- Create connection
  if(!element.type eq 'BRAN') then
    CONNECT P$!<this.end> TO P$!<connectionPoint> OF $!<element>
    handle (42,64)
      !!alert.error('Unable to select hstu for $!!ce.hBore bore')
    elsehandle none
      if !connectionPoint.upcase().eq('HEAD') then
        -- we are connecting to a head
        -- we must check the pa of the first mem of the branch we are connecting to
        -- tconn must be set to this
        goto tref
        handle any
          return
        endhandle
        first mem
        handle any
          return
        endhandle
        !firstArrive = pa conn

        !!ce = !this.branch
        tconn $!firstArrive

        -- we must also get the hconn of the branch we are connecting to
        -- this must be set to the pl of the last component of our branch
        last mem
        handle any
          return
        endhandle
        !lastLeave = pl conn
        bran
        goto tref
        bran
        hconn $!lastLeave

      else
      	-- we are connecting to a tail
      	-- we must check pl of last mem of branch we are connecting to
      	-- hconn must be set to this
      	goto href
      	handle any
          return
        endhandle
        last mem
        handle any
          return
        endhandle
        !lastLeave = pl conn

        !!ce = !this.branch
        hconn $!lastLeave
      	-- we must also get the tcon of the branch we are connecting to
      	-- this must be set to the pa of the first mem of our branch
      	first mem
      	handle any
          return
        endhandle
        !firstArrive = pa conn
        bran
        goto href
        bran
      	tconn $!firstArrive
    	endif
    endhandle
  else
    CONNECT P$!<this.end> TO $!<connectionPoint> OF $!<element>
    handle (42,94) (7,40)
      -- this is probably due to model editor blob
      Tpos pos of $!<element>
      tdir p1 of $!<element>
      !!ce.tbor = !element.lbore
      !!ce.tconn = 'BWD'
    elsehandle (42,64)
      !!alert.error('Unable to select hstu for $!!ce.hBore bore')
    endhandle
  endif

endmethod
-- End of object definition
