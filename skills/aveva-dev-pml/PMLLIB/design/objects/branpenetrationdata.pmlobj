--  Description:     -- Raw penetration data--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  branPenetrationData()            -                   Constructor
--  branPenetrationData(DBREF,DBREF,POSITION,BOOLEAN) -                   Constructor
--  createMarker()                   DBREF               Create Penetration ATTA
--  createPenetrationComponent()     DBREF               Create Penetration component in pipe
--  findMarkerCreationPoint()        DBREF               Find correct point in list of tube ATTA elements to
--  getHoleData()                    ARRAY               Return hole data in a form suitable for hmDefinition
--  getHoleType()                    STRING
--  getPenetratedFace(DBREF,POINTVECTOR) ARRAY               Process data from penetrated items pick
--  hvacAtta(DBREF)                  BOOLEAN             Create ATTA for HVAC penetration
--  intersectWithPointVector(DBREF,POINTVECTOR) ARRAY               Return intersection between point vector and penetrated
--  isCableTray()                    BOOLEAN             Return true for cable tray, false for pipe
--  isStraight(DBREF)                BOOLEAN
--  processData()                    BOOLEAN             Constructor
--  processHVACData()                BOOLEAN             Constructor
--  processPipeData()                BOOLEAN             Constructor
--  processTrayData()                BOOLEAN             Create Penetration ATTA in cable tray
--  setLeave(BOOLEAN)                -                   Set ATTA direction to Leave if true, or to arrive if false
--  setMarker(STRING)                -                   Set the marker type
--  setPenetrated(DBREF)             -                   Set the penetrated item (could be higher in hierarchy than
--  setSpecification(STRING)         -                   Constructor
--
-- Description:
-- Raw penetration data
--
------------------------------------------------------------------------
--

define object BRANPENETRATIONDATA

  -- Penetrated item (actual item)
  member .penetrated           is DBREF
  -- Penetrated item (selected item - possibly higher level object than penetrated)
  member .penetratedObject     is DBREF
  -- Penetrating item
  member .penetrating          is DBREF
  -- Penetrating object (= item or owner of item depending on type)
  member .penetratingObject    is DBREF
  -- DBREF of element created at the penetration (e.g. ATTA)
  member .penetratingMarker    is DBREF
  -- DBREF of offset marker (e.g. COUP)
  member .offsetMarker         is DBREF
  -- Penetrating type is the 'significant' type for this penetration
  member .penetratingType      is STRING
  -- Valid penetrating type list
  member .penetratingTypes     is ARRAY
  -- penetrating position
  member .position             is POSITION
  -- true if tube penetration
  member .tube                 is BOOLEAN
  -- true if penetration ATTA aligned with leave (only used when .tube is false)
  member .alignWithLeave       is BOOLEAN
  -- Specification
  member .specification        is STRING
  -- Marker Type
  member .markerType           is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      branPenetrationData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .branPenetrationData()

  -- Initialise Variables
  !this.penetratingTypes[1] = 'PIPE'
  !this.penetratingTypes[2] = 'HVAC'
  !this.alignWithLeave      = true

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      branPenetrationData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference to the penetrating item
--    2   R      DBREF       Reference to the penetrated item
--    3   R      POSITION    Position of penetration
--    4   R      BOOLEAN     True if this is implied tube
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .branPenetrationData(!penetrating is DBREF, !penetrated is DBREF, !position is POSITION, !tube is BOOLEAN)

  -- Initialise Variables
  !this.branPenetrationData()
  !this.penetrating = !penetrating
  !this.penetrated  = !penetrated
  !this.position    = !position
  !this.tube        = !tube
  !this.penetratedObject = !penetrated

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setPenetrated
--
-- Description: Set the penetrated item (could be higher in hierarchy than
--              clashed item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Penetrated item reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPenetrated(!penetrated is DBREF)

  -- Initialise Variables
  !this.penetratedObject = !penetrated

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Set the ATTA specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      ATTA Specification reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpecification(!specification is STRING)

  -- Initialise Variables
  !this.specification = !specification

endmethod
-- End of function definition
------------------------------------------------------------------------
--
-- Method:      setMarker
--
-- Description: Set the marker type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Marker Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMarker(!markerType is STRING)

  -- Initialise Variables
  !this.markerType = !markerType

endmethod
-- End of function definition
------------------------------------------------------------------------
--
-- Method:      setLeave
--
-- Description: Set ATTA direction to Leave if true, or to arrive if false
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True to align ATTA with leave
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLeave(!leave is BOOLEAN)

  -- Initialise Variables
  !this.alignWithLeave = !leave

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      processData
--
-- Description: Create the penetration ATTA
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processData() is BOOLEAN

  -- Find out type of penetration being created
  !ownerItems = !this.penetrating.ownlst
  !ownerItems.append(!this.penetrating)
  !ownerItems.invert()
  !this.penetratingType = ''
  do !item values !ownerItems
    !type  = !item.type
    !index = !this.penetratingTypes.findFirst(!type )
    skip if( !index.unset() )
    !this.penetratingType = !type
    break
  enddo

  if( !this.penetratingType eq 'PIPE' ) then
    if( !this.isCableTray() ) then
      !result = !this.processTrayData()
    else
      !result = !this.processPipeData()
    endif
  elseif( !this.penetratingType eq 'HVAC' ) then
    !result = !this.processHVACData()
  else
    -- invalid penetrating object
    return false
  endif

  return !result

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      processPipeData
--
-- Description: Create Penetration ATTA in pipe
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processPipeData() is BOOLEAN

  -- Determine the penetrating object from the penetrating item
  !penetrating = !this.penetrating

  if (!penetrating.type neq 'BRAN') then
    !this.penetratingObject = !penetrating.owner
  else
    !this.penetratingObject = !penetrating
  endif

  -- Create Pipe penetrating marker
  !!ce = !penetrating
  handle ANY
    return false
  endhandle

  -- If the marker type is anything other than an ATTA and the clash is
  -- not in the tube warn the user and set the marker type to ATTA.
  if(!this.tube.not() and !this.markerType neq 'ATTA') then
    !answer = !!alert.confirm('The penetration marker type is not an ATTA and the clash is not with tube. Do you want to change the marker type to an ATTA?')
    if (!answer.boolean()) then
      !this.markerType = 'ATTA'
    else
      return FALSE
    endif
  endif

  if( !this.markerType eq 'ATTA' ) then
    -- create ATTA that marks the penetration position
    !this.penetratingMarker = !this.createMarker()
  else
    -- create penetration marker component
    !this.penetratingMarker = !this.createPenetrationComponent()
  endif

  return !this.penetratingMarker.set()

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      createMarker
--
-- Description: Create Penetration ATTA
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .createMarker() is DBREF

  -- add the atta reference to hole management if necessary
  !penetratingMarker = object DBREF()

  -- set CE to the next create point in the sequence
  !!ce = !this.findMarkerCreationPoint()

  NEW ATTA
  handle (2,500) (2,501) (2,502) (2,503) (2,504)
    -- DAC errors
    !!alert.error(!!error.text)
    return !penetratingMarker
  endhandle

  -- Set spec selection
  if(!this.specification eq |DFLT|) then
    -- Use the choose options to select the component
    if (!!cdChooseO.defSel.val) then
      SEL
      handle ANY
        CHOOSE ALL
        handle ANY
          delete ATTA
          !errorString = 'No ATTA found in the current specification'
          !!alert.error(!errorString)
          return !penetratingMarker
        endhandle
      endhandle
    else
      CHOOSE ALL
      handle ANY
        delete ATTA
        !errorString = 'No ATTA found in the current specification'
        !!alert.error(!errorString)
        return !penetratingMarker
      endhandle
    endif
  else
    -- set a default DESP on ATTA to avoid command line warning message
    DESP 0
    SEL with SPEC $!<this.specification>
    handle ANY
      delete ATTA
      !!alert.error(|Incorrect ATTA Specification|)
      return !penetratingMarker
    endhandle
  endif
  -- catref will be unset if user has cancelled component selection
  if( badref(!!ce.spref) ) then
    DELETE ATTA
    !!alert.message('Penetration marker selection was cancelled')
    return !penetratingMarker
  endif

  ATTY PENI
  ORI

  if (!this.tube) then
    THRO $!<this.position>
    -- adjust penetration position to ATTA position
    !this.position = !!ce.position
  else
    -- penetration at a component
    -- if straight component, ORI is standard
    !arriveDirection  = !this.penetrating.aDir
    handle any
      -- have to assume straight through piece - this error should not happen
      !linear = true
    elsehandle none
      -- find out if arrive and leave are parallel within a tolerance
      !leaveDirection = !this.penetrating.lDir
      !linear = ( abs(180 - !arriveDirection.angle(!leaveDirection).abs()) lt 1 )
    endhandle
    if( !linear.not() ) then
      -- assume shape is an arc and calculate a tangent direction at the penetration point
      -- this is only used if the penetrated item is non-planar
      !plane  = !this.penetrating.aPos.plane(!this.position,!this.penetrating.lPos)
      handle any
        if( !this.penetrating.aPos.distance(!this.position) lt !this.penetrating.lPos.distance(!this.position) ) then
          !direction = !this.penetrating.aDir
        else
          !direction = !this.penetrating.lDir
        endif
      elsehandle none
        !pvArrive   = object POINTVECTOR(!this.penetrating.aPos,!this.penetrating.aDir)
        !pvLeave    = object POINTVECTOR(!this.penetrating.lPos,!this.penetrating.lDir)
        !polar      = !pvArrive.line(1000mm).intersection(!pvLeave.line(1000mm))
        -- check for curved component or angular (zero radius)
        !radius = !this.penetrating.radius
        handle any
          !radius = 0mm
        endhandle
        if ( !radius eq 0mm ) then
          -- check if nearer to arrive or leave side
          !aDistance = !pvArrive.line(1000mm).distance(!this.position)
          !lDistance = !pvLeave.line(1000mm).distance(!this.position)
          if( !aDistance lt !lDistance ) then
            !direction = !this.penetrating.aDir
            !normalisedPosition = !pvArrive.line(1000mm).near(!this.position)
          else
            !direction = !this.penetrating.lDir
            !normalisedPosition = !pvLeave.line(1000mm).near(!this.position)
         endif
        else
          -- construct arc representing CL of curved component
          !arc        = !polar.arcFillet(!pvArrive.position, !pvLeave.position, !plane.pointVector().direction, !this.penetrating.radius)
          -- nudge ATTA position onto CL of bend. Original clash position may be off of CL.
          !direction   = !arc.angleTangent(!arc.near(!this.position))
          !normalisedPosition = !arc.anglePosition(!arc.near(!this.position))
        endif
        !this.position = !normalisedPosition
      endhandle
      !pv            = object POINTVECTOR(!this.position, !direction)
      !planes        = !this.getPenetratedFace(!this.penetrated, !pv)
      !penetrationDirection = !planes[1].orientation.zdir()
      ORI Y IS $!penetrationDirection
      handle any
      endhandle
    endif
    AT $!<this.position>
  endif

  -- auto name the ATTA
  CALL !!autonamece(false)
  handle any
  endhandle

  return !!ce

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      createPenetrationComponent
--
-- Description: Create Penetration component in pipe
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .createPenetrationComponent() is DBREF

  !markerType           = !this.markerType

  -- add the atta reference to hole management if necessary
  !penetratingComponent = object DBREF()

  NEW $!markerType
  handle (2,500) (2,501) (2,502) (2,503) (2,504)
    -- DAC errors
    !!alert.error(!!error.text)
    return !penetratingComponent
  endhandle

  -- Set spec selection
  if(!this.specification eq |DFLT|) then
    -- Use the choose options to select the component
    if (!!cdChooseO.defSel.val) then
      SEL
      handle ANY
        CHOOSE ALL
        handle ANY
          delete $!markerType
          !errorString = 'There are no ' & !markerType & 's in the current specification'
          !!alert.error(!errorString)
          return !penetratingComponent
        endhandle
      endhandle
    else
      CHOOSE ALL
      handle ANY
        delete $!markerType
        !errorString = 'There are no ' & !markerType & 's in the current specification'
        !!alert.error(!errorString)
        return !penetratingComponent
      endhandle
    endif
  else
    SEL with SPEC $!<this.specification>
    handle ANY
      delete $!<markerType>
      !!alert.error(|Incorrect penetration component Specification|)
      return !penetratingComponent
    endhandle
  endif
  -- catref will be unset if user has cancelled component selection
  if( badref(!!ce.spref) ) then
    DELETE $!<markerType>
    !!alert.message('Penetration component selection was cancelled')
    return !penetratingComponent
  endif

  -- set position and orientation
  ORI
  if (!this.tube) then
    THRO $!<this.position>
    -- adjust penetration position to ATTA position
    !this.position = !!ce.position
  else
    AT $!<this.position>
  endif

  --check if marker type is COUP and if it is has ORIC set as COMPTYPE so is for sloping deck and has DESPAR to angle it
  if (!markerType.eq('COUP') and !!ce.catref.compType.eq('ORIC')) then
    !pv           = object POINTVECTOR()
    !pv.position  = !this.position
    !pv.direction = !!ce.pDir[2]
    !planes       = !this.getPenetratedFace(!this.penetrated, !pv)
    -- choose the plane going in the direction of the branch
    -- find first side of panel hit by pipe
    if( !planes[1].orientation.zdir().dot(!!ce.pDir[2]).gt(0) ) then
      !usePlane   = 1
    else
      !usePlane   = 2
    endif
    !facePosition    = !planes[!usePlane].position
    !distance        = !pv.position.distance(!facePosition)
    !directionToFace = !pv.position.direction(!facePosition)
    if( !directionToFace.angle(!pv.direction) gt 1degree ) then
      !distance      = !distance * -1
    endif

    --set Loffline to TRUE for COUP so pipe is not split in production checks/pipe sketches
    !!ce.loff = TRUE

    --angle to deck using despars
    !direction = !planes[!usePlane].direction().wrt(!!ce)
    !designParams[1] = !direction.east
    !designParams[2] = !direction.north
    !designParams[3] = !direction.up
    !designParams[4] = !distance
    !!ce.desp        = !designParams

    -- force flange on top of hull panel
    if(!this.penetrated.type eq 'HPLATE' and !usePlane eq 2) then
      --flip the component
      -- get current P3 direction and calculate the new direction DESP
      !p3Dir       = !!ce.pDir[3].opposite()
      -- flip the coupling
      FLIP
      ORI
      !newDirectionComponents = !p3Dir.wrt(!!ce)
      !designParams[1] = !newDirectionComponents.east
      !designParams[2] = !newDirectionComponents.north
      !designParams[3] = !newDirectionComponents.up
      !designParams[4] = !distance
      !!ce.desp        = !designParams
    endif
  endif

  -- auto name the component
  CALL !!autonamece(false)
  handle any
  endhandle

  return !!ce

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      processTrayData
--
-- Description: Create Penetration ATTA in cable tray
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processTrayData() is BOOLEAN

  -- Determine the penetrating object from the penetrating item
  !penetrating = !this.penetrating
  if (!penetrating.type neq 'BRAN') then
    !this.penetratingObject = !penetrating.owner
  else
    !this.penetratingObject = !penetrating
  endif

  -- Create Pipe penetrating marker
  !!ce = !penetrating
  handle ANY
    return false
  endhandle

  -- If the marker type is anything other than an ATTA and the clash is
  -- not in the tube warn the user and set the marker type to ATTA.
  if(!this.tube.not() and !this.markerType neq 'ATTA') then
    !answer = !!alert.confirm('The penetration marker type is not an ATTA and the clash is not with tube. Do you want to change the marker type to an ATTA?')
    if (!answer.boolean()) then
      !this.markerType = 'ATTA'
    else
      return FALSE
    endif
  endif

  NEW $!<this.markerType>
  handle (2,500) (2,501) (2,502) (2,503) (2,504)
    -- DAC errors
    !!alert.error(!!error.text)
    return false
  endhandle

  -- add the atta reference to hole management if necessary
  !this.penetratingMarker =!!ce

  -- Set spec selection
  -- Use the choose options to select the component
  if (!!cdChooseO.defSel.val) then
    SEL
    handle ANY
      CHOOSE ALL
      handle ANY
        delete $!<this.markerType>
        !errorString = 'There are no ' & !this.markerType & 's in the current specification'
        !!alert.error(!errorString)
        return FALSE
      endhandle
    endhandle
    -- if unset spref then choose was cancelled
    if( badref(!!ce.spref) ) then
      delete $!<this.markerType>
       !!alert.error('Penetration marker selection was cancelled')
      return FALSE
    endif
  else
    CHOOSE ALL
    handle ANY
      delete $!<this.markerType>
      !errorString = 'There are no ' & !this.markerType & 's in the current specification'
      !!alert.error(!errorString)
      return FALSE
    endhandle
    -- if unset spref then choose was cancelled
    if( badref(!!ce.spref) ) then
      delete $!<this.markerType>
       !!alert.error('Penetration marker selection was cancelled')
      return FALSE
    endif
  endif

  if (!this.markerType eq 'ATTA') then
    ATTY PENI
  endif

  if (!this.tube) then
    -- set default orientation used if open side orientation not found
    ORI
    !refElement = !!ce
    NEXT
    handle (2,113)
      PREVIOUS
      handle (2,113)
        !refElement = object DBREF()
      endhandle
    endhandle
    if( !refElement.set() ) then
      -- next or previous found
      !refElement    = !!ce
      -- find P30 or P31 most perpendicular to the tube direction
      !!ce           = !this.penetratingMarker
      !tubeDirection = !!ce.pDir[!!ce.leave]
      !pDir30        = !refElement.pDir[30]
      handle any
        !pDir30      = object DIRECTION()
      endhandle
      !pDir31        = !refElement.pDir[31]
      handle any
        !pDir31      = object DIRECTION()
      endhandle
      -- if there is no P30 or P31, leave in default ORI
      if( !pDir30.set() or !pDir31.set() ) then
        if( !pDir30.set() ) then
          !dot30       = !tubeDirection.dot(!pDir30).abs()
        else
          !dot30       = 2
        endif
        if( !pDir31.set() ) then
          !dot31       = !tubeDirection.dot(!pDir31).abs()
        else
          !dot31       = 2
        endif
        -- closest to 0 is likely to be the best open side orientation
        if( !dot31 lt !dot30 ) then
          ORI AND Z IS P31 OF $!refElement
        else
          ORI AND Z IS P30 OF $!refElement
        endif
      endif
    endif
    -- set position of ATTA
    THRO $!<this.position>
    -- adjust penetration position to ATTA position
    !this.position = !!ce.position
  else
    ORI Y IS Y WRT PREV AND Z IS Z WRT PREV
    handle (2,113)
      ORI
    endhandle
    !straight = !this.isStraight(!this.penetrating)
    handle any
      !straight = false
    endhandle
    if( !straight ) then
      THRO $!<this.position>
      !this.position = !!ce.position
    else
      AT $!<this.position>
    endif
  endif

  -- name the ATTA
  CALL !!autonamece(false)
  handle any
  endhandle

  !this.penetratingType = 'TRAY'

  return true

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      processHVACData
--
-- Description: Create Penetration ATTA in HVAC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processHVACData() is BOOLEAN

  -- Determine the penetrating object from the penetrating item
  !penetrating = !this.penetrating
  if (!penetrating.type neq 'BRAN') then
    !this.penetratingObject = !penetrating.owner
  else
    !this.penetratingObject = !penetrating
  endif

  -- Create HVAC ATTA
  !!ce = !penetrating
  handle ANY
    return false
  endhandle

  -- set CE to the next create point in the sequence
  !!ce = !this.findMarkerCreationPoint()

  NEW ATTA
  handle (2,500) (2,501) (2,502) (2,503) (2,504)
    -- DAC errors
    !!alert.error(!!error.text)
    return false
  elsehandle NONE
    !this.penetratingMarker =!!ce
    !done = !this.hvacAtta(!this.penetratingMarker)
    handle any
      !done = false
    endhandle
    if( !done.not() ) then
      !!ce = !this.penetratingMarker
      DELETE ATTA
      return false
    endif
  endhandle

  return true

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      hvacAtta
--
-- Description: Set HVAC penetration ATTA properties
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Hole data
--
------------------------------------------------------------------------
define method .hvacAtta(!atta is DBREF) is BOOLEAN

  !!ce = !atta
  !previous = object DBREF()

  PREVIOUS
  handle any
    -- get parameters from the branch
    !aValue = !atta.owner.attribute(':hxysize')[1].real()
    handle ANY
      !aValue = 0
    endhandle
    !bValue = !atta.owner.attribute(':hxysize')[2].real()
    handle ANY
      !bValue = 0
    endhandle
  elsehandle none
    if(!this.alignWithLeave) then
      -- use leave dimensions
      !aParameter= 4
      !bParameter= 5
    else
      -- use arrive dimensions
      !aParameter= 2
      !bParameter= 3
    endif
    !previous = !!ce
    -- get parameters from previous component
    !aValue = !previous.desp[!aParameter]
    handle ANY
      !aValue = 0
    endhandle
    !desp5  = !previous.wdesp[!bParameter]
    handle ANY
      !desp5 = ''
    endhandle
    if(!desp5 eq 'DIAM') then
      -- circular piece
      !bValue = 0
    else
      !bValue = !previous.desp[!bParameter]
      handle ANY
        !bValue = 0
      endhandle
      -- handle case where DESP 5 has been set wrong on old data
      if( !bValue eq 788296 ) then
        -- this is the hash code for DIAM so !bValue set for circular ATTA
        !bValue = 0
      endif
    endif
  endhandle

  if( !aValue.unset() ) then
    !aValue = 0
  endif
  if( !bValue.unset() ) then
    !bValue = 0
  endif

  !!ce = !atta

  DESP N100 0
  DESP N2 $!aValue
  DESP N3 $!bValue
  DESP N4 $!aValue
  DESP N5 $!bValue
  DESP N41 $!aValue
  DESP N42 $!bValue
  DESP N33 6
  -- Default Works fit property WKSF true
  DESP N36 TRUE

  -- type of component
  !hvacComponentType = ''
  if( not badref(!previous) ) then
    !hvacComponentType = !previous.wDesp[40]
  endif
  if( !hvacComponentType.empty() ) then
    if( !bValue eq 0 ) then
      !hvacComponentType = 'CIRC'
    else
      !hvacComponentType = 'RECT'
    endif
  endif
  if (!hvacComponentType eq 'RECT') then
    !markerComponent = '/AvevaHVACSPEC-Penetrations/Rectangular-Marker'
  elseif (!hvacComponentType eq 'CIRC') then
    !markerComponent = '/AvevaHVACSPEC-Penetrations/Circular-Marker'
  elseif (!hvacComponentType eq 'OVAL') then
    !markerComponent = '/AvevaHVACSPEC-Penetrations/FlatOval-Marker'
  else
    -- default to rectangular
    !hvacComponentType = 'RECT'
    !markerComponent = '/AvevaHVACSPEC-Penetrations/Rectangular-Marker'
  endif

  !this.penetratingType = !hvacComponentType
  DESP N40 $!hvacComponentType
  handle any
    DESP N40 MAIN
    !shape = 'MAIN'
  endhandle

  SPREF $!<markerComponent>
  handle ANY
    !!alert.error('The Aveva HVAC Penetration Spec is not available')
    return false
  endhandle

  if( !this.tube ) then
    !straight = true
  else
    !straight   = !this.isStraight(!this.penetrating)
    handle any
      !straight = false
    endhandle
  endif

  -- set penetration type
  ATTY PENI

  -- orientate with PL of penetrating component
  !penetrating = !this.penetrating

  if( !straight ) then
    -- straight component
    ORI Z IS PL OF $!penetrating AND X IS P6 OF $!penetrating
    handle (2,113) (2,252)
      ORI
    endhandle
    THRO $!<this.position>
  else
    -- component with PA and PL not parallel
    if( !this.alignWithLeave ) then
      ORI Z IS PL OF $!penetrating AND X IS P6 OF $!penetrating
      handle (2,113)
        ORI
      endhandle
      THRO $!<this.position>
    else
      -- align with start
      ORI Z IS Z WRT $!penetrating AND X IS X WRT $!penetrating
      handle (2,113)
        ORI
      endhandle
      -- map position onto PA
      !paVector = object POINTVECTOR(!this.penetrating.aPos.wrt(world), !this.penetrating.aDir.wrt(world))
      !position = !paVector.line(1000mm).near(!this.position)
      AT $!position
    endif
    !this.position  = !!ce.position
  endif

  -- name the ATTA
  CALL !!autonamece(false)
  handle any
  endhandle

  -- Design parameter forty is the HVAC item shape
  var !shape PROP SHAP
  handle any
    DESP N40 MAIN
    !shape = 'MAIN'
  endhandle
  -- Design parameter one is always description
  DESP N1 PENI

  -- Set Duct size design parameters if they are unset
  if (!shape inset ('RECT','OVAL','MAIN')) then
    if (DESP[4] eq 0) then
      DESP N4 (DESP[2])
    endif
    if (DESP[5] eq 0) then
      DESP N5 (DESP[3])
    endif
  elseif (!shape inset ('CIRC')) then
    if (DESP[4] eq 0) then
      DESP N4 (DESP[2])
    endif
  endif

  -- Set the implied tube
  -- The LSTU is stored on a LSTU property
  var !impliedTubeString (prop lstu)
  handle ANY
  elsehandle NONE
    !impliedTube = !impliedTubeString.dbref()
    handle ANY
    elsehandle NONE
      !!ce.lstube = !impliedTube
      handle ANY
      endhandle
    endhandle
  endhandle

  -- Set ATTYP PENI for penetration items
  if (!!ce.hardType eq 'ATTA') then
    var !propertyType (prop type)
    handle ANY
      -- Do nothing
    elsehandle NONE
      if (!propertyType eq 'PENI') then
        !!ce.attyp = !propertyType
      endif
    endhandle
  endif

  return true

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      isStraight
--
-- Description: True if arrive and leave co-linear
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if straight
--
------------------------------------------------------------------------
define method .isStraight( !item is DBREF ) is BOOLEAN

  !aDirection  = !item.pdirection[!item.arrive]
  !lDirection  = !item.pdirection[!item.leave]
  if( !aDirection.isParallel(!lDirection).not() ) then
    return false
  endif
  !pvArrive    = object POINTVECTOR( !item.pposition[!item.arrive], !aDirection)
  !planeArrive = !pvArrive.plane()
  !nearPoint   = !planeArrive.near(!item.pposition[!item.leave])
  !return      = !item.pposition[!item.arrive].near(!nearPoint, 1mm )
  return !return

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getHoleData
--
-- Description: Return hole data in a form suitable for hmDefinition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Hole data
--
------------------------------------------------------------------------
define method .getHoleData() is ARRAY

  if (!this.penetratedObject.hardType eq 'HPANEL' or !this.penetratedObject.hardType eq 'CPANEL') then
    !holeDataElement[1] = !this.penetrated
  else
    !holeDataElement[1] = !this.penetratedObject
  endif
  !holeDataElement[2] = !this.penetratingObject
  !holeDataElement[3] = !this.position
  !holeDataElement[4] = !this.penetratingMarker
  -- get penetration component if any
  if( !this.offsetMarker.set() ) then
    !holeDataElement[5] = !this.offsetMarker
  endif
  return !holeDataElement

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getHoleType
--
-- Description: Return hole type for hmDefinition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Hole type
--
------------------------------------------------------------------------
define method .getHoleType() is STRING

  return !this.penetratingType

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      .getPenetratedFace
--
-- Description: Process data from penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .getPenetratedFace(!item is DBREF, !pv is POINTVECTOR) is ARRAY

  -- set penetrating data for each type of penetrated object
  if( !item.hardType eq 'HPLATE' ) then
    !plateThickness = !item.thickness
    if (!item.knuckl) then
      !hitArray = !this.intersectWithPointVector(!item, !pv)
      !plane    = !hitArray[1].plane()
      -- knuckled panel - Find intersection between penetrating object vector and panel
      !penetratedDirection = !hitArray[1].direction
      !panelPosition       = !hitArray[1].position
    else
      -- planar hull panel
      !panelPosition       = !item.position
      !plane               = object PLANE(!panelPosition, !item.orientation)
      !penetratedDirection = !item.ori.zdir()
    endif
  elseif( !item.hardType eq 'CPLATE' ) then
    -- curved plate
    !hitArray = !this.intersectWithPointVector(!item, !pv)
    !plane    = !hitArray[1].plane()
    !plateThickness      = !item.thickness
    !penetratedDirection = !hitArray[1].direction
    !panelPosition       = !hitArray[1].position
  else
    -- outfitting panel
    !plateThickness      = !item.lohe
    -- put plane on top face, allowing for loop justification
    !vertex              = object DBREF('PAVE 1 OF PLOOP 1 OF $!<item>')
    !panelPosition       = !vertex.ppos[3]
    !plane               = object PLANE(!panelPosition, !item.orientation)
    !penetratedDirection = !item.ori.zdir()
  endif

  -- store the penetrated position and plane of penetrated item
  !altDirection          = !penetratedDirection.opposite()
  !yDirection            = !plane.orientation.yDir()
  !altOrientation        = object ORIENTATION( |Z IS | + !altDirection.string() + | AND Y IS | + !yDirection.string() )
  !altPosition           = !plane.pointVector().offset( !plateThickness * -1 ).position
  !altPlane              = object PLANE( !altPosition, !altOrientation )

  -- find intersection between face plane and point vector
  !position          = !plane.intersection(!pv)
  !plane.position    = !position
  -- find intersection between alternate face plane and point vector
  !position          = !altPlane.intersection(!pv)
  !altPlane.position = !position

  !return[1] = !plane
  !return[2] = !altPlane

  return !return

endmethod

----------------------------------------------------------------------
--
-- Method:      intersectWithPointVector
--
-- Description: Return intersection between point vector and penetrated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item being penetrated
--    2   R      POINTVECTOR penetration vector
-- Return:
--   [Data Type] [Description]
--    ARRAY of POINTVECTOR  Two point vectors at penetration - one for each side of material
--
------------------------------------------------------------------------
define method .intersectWithPointVector(!element is DBREF, !pv is POINTVECTOR) is ARRAY

  if( badref(!element) or !pv.unset() ) then
    return ARRAY()
  endif

  -- find all hits on selected object
  !hitArray = !pv.intersections(!element, true)

  -- return empty array if not hits
  if( !hitArray.empty() ) then
    return ARRAY()
  endif

  -- get nearest hits to position of point vector
  if( !hitArray.size() eq 1 ) then
    -- this should not happen
    !hitArray[2] = object POINTVECTOR(!hitArray[1].position, !hitArray[1].direction.opposite())
  elseif( !hitArray.size() gt 2 ) then
    !minDistance1 = 999metre
    !minDistance2 = 999metre
    !minIndex1    = 1
    !minIndex2    = 1
    do !hitIndex indices !hitArray
      !hitPoint   = !hitArray[!hitIndex].position
      !distance   = !hitPoint.distance(!pv.position)
      if( !distance leq !minDistance1 ) then
        !minDistance2 = !minDistance1
        !minIndex2    = !minIndex1
        !minDistance1 = !distance
        !minIndex1    = !hitIndex
      elseif( !distance gt !minDistance1 and !distance lt !minDistance2 ) then
        !minDistance2 = !distance
        !minIndex2    = !hitIndex
      endif
    enddo
    !nearestHit[1] = !hitArray[!minIndex1]
    !nearestHit[2] = !hitArray[!minIndex2]
    !hitArray      = !nearestHit
  endif

  return !hitArray

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      findMarkerCreationPoint
--
-- Description: Find correct point in list of tube ATTA elements to
--              create new ATTA
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   DBREF        Element to be used as creation point in list
--
------------------------------------------------------------------------
define method .findMarkerCreationPoint() is DBREF

  if( !this.tube ) then

    -- collect all ATTA's between penetration component and new component
    -- Find the correct sequence for the new ATTA in the list
    if( !!ce.type eq 'BRAN') then
      !penetrationFromPV = object POINTVECTOR(!!ce.phPos, !!ce.hDir)
      !nextComponent     = !!ce.members[1]
      handle any
        !nextComponent   = object DBREF()
      endhandle
    else
      !penetrationFromPV = object POINTVECTOR(!!ce.pos, !!ce.lDir)
      !nextComponent     = !!ce.owner.members[!!ce.sequence + 1]
      handle any
        !nextComponent   = object DBREF()
      endhandle
    endif

    -- Find the correct sequence for the new ATTA in the list
    !newPosition    = !penetrationFromPV.line(1000mm).near(!this.position)
    !distance       = !penetrationFromPV.position.distance(!newPosition)
    !newCreatePoint = !!ce

    do
      break if(!nextComponent.unset())
      break if(!nextComponent.type neq 'ATTA')
      break if(!distance lt !penetrationFromPV.line(1000mm).near(!nextComponent.position).distance(!penetrationFromPV.position) )
      -- set new previous component for create
      !newCreatePoint = !nextComponent
      -- try the next member of the branch
      !nextComponent  = !nextComponent.owner.members[!nextComponent.sequence + 1]
      handle any
        break
      endhandle
    enddo

  else

    -- not TUBE so return CE
    !newCreatePoint = !!ce

  endif

  -- set CE to the next create point in the sequence
  return !newCreatePoint

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      isCableTray
--
-- Description: Return true for cable tray, false for pipe
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True for cable tray, false for pipe
--
------------------------------------------------------------------------
define method .isCableTray() is BOOLEAN

  if (!this.penetrating.type eq 'BRAN') then
    !penetratingBranch = !this.penetrating
  else
    !penetratingBranch = !this.penetrating.owner
  endif

  -- Create Pipe penetrating marker
  !block  = object BLOCK('STEXT OF TEXT 1 OF PSPEC OF ' + !penetratingBranch.string())
  !return = !block.evaluate().upcase().eq('TRAY')
  handle ANY
    return false
  endhandle

  return !return

endmethod
-- End of function definition
