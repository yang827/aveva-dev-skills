--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCore()                        -
--  cable()                          -                   Constructor
--  cable(DBREF)                     -                   Constructor
--  checkOutsideDiameter()           STRING              Calculate the outside diameter of a cable and return warning string
--  create()                         BOOLEAN
--  create(REAL)                     BOOLEAN
--  createCores(REAL)                -                   modifies an existing cable element
--  createExtgeo()                   -                   create a core element and append its data to the list gadget
--  createPointr()                   -
--  deleteCbl()                      -                   deletes an existing cable element
--  deleteCore(DBREF)                -                   deletes an existing core element
--  deleteExtgeo()                   -
--  deletePointr()                   -
--  highlight(STRING)                -
--  modify()                         -                   modifies an existing cable element
--  updateCore(DBREF)                -
--  updateData(STRING)               ARRAY
--  updateExtgeo(DBREF)              -
--  updatePointr(DBREF)              -
--
------------------------------------------------------------------------

define object CABLE

  -- object members

  -- standard element data
  member .activeElement  is DBREF
  member .dbref          is DBREF
  member .name           is STRING
  member .owner          is DBREF
  member .desc           is STRING
  member .func           is STRING
  member .purp           is STRING
  member .iclass         is STRING
  member .number         is REAL
  member .area           is REAL
  member .pos            is POSITION
  member .ori            is ORIENTATION
  member .spref          is DBREF

  -- cable specific data
  member .startDesc      is STRING
  member .endDesc        is STRING
  member .markrf         is ARRAY
  member .routNode       is ARRAY
  member .cexes          is ARRAY
  member .staRef         is DBREF
  member .endRef         is DBREF
  member .staPoint       is REAL
  member .endPoint       is REAL
  member .cbStatus       is REAL
  member .fillChk        is BOOLEAN
  member .system         is ARRAY
  member .raneq					 is REAL

  -- array of references to child core elements
  member .cores          is ARRAY
  -- array of references to child core elements
  member .extgeos        is ARRAY
  --member .rpath          is DBREF

  member .pointr         is DBREF
  member .pointrDesc     is DBREF
  member .pointrFunc     is DBREF

  member .pointrs        is ARRAY
  member .pointrpos      is POSITION

  -- core member data
  member .coreDbref      is DBREF
  member .coreName       is STRING
  member .coreOwner      is DBREF
  member .coreDesc       is STRING
  member .coreFunc       is STRING
  member .corePurp       is STRING
  member .coreHref       is DBREF
  member .coreTref       is DBREF

  member .extgeo         is DBREF
  member .extgeoDesc     is STRING
  member .extgeoFunc     is STRING
  member .extgeoHref     is DBREF
  member .extgeoTref     is DBREF

  -- aid text numbers
  member .startAidNum    is REAL
  member .endAidNum      is REAL
  member .errors         is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      cable
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cable()

 -- default constructor, don't need to set initial values because these will be assigned during cable creation

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      cable
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element, either branch or below or only branch
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cable(!element is DBREF)

  -- Initialise Variables
  !this.dbref           = !element
  !this.name            = !element.namn
  !this.owner           = !element.owner
  !this.desc            = !element.description
  !this.func            = !element.function
  !this.purp            = !element.purpose
  !this.iclass          = !element.iclass
  !this.number          = !element.number
  !this.area            = !element.area
  !this.fillChk 				= !element.filChk
  !this.system  				= !element.mdsysf
  --!this.pos             = !element.position
  --!this.ori             = !element.ori
  !this.spref           = !element.spref

  -- cable specific data
  !this.startDesc       = !element.feqdes
  !this.endDesc         = !element.teqdes
  !this.markrf          = !element.markrf
  !this.routNode        = !element.routnd
  !this.cexes           = !element.cexes
  !this.staRef          = !element.staRef
  !this.endRef          = !element.endRef
  !this.staPoint        = !element.staPoint
  !this.endPoint        = !element.endPoint
  !this.cbStatus        = !element.cbStatus

  handle ANY
    -- attrib nor available at t15
  endhandle
 !this.raneq						= !element.raneq
  -- collect all child core references
  !collCores = object COLLECTION()
  !collCores.type('CORE')
  !collCores.scope(!this.dbref)
  --!express!collCores = object EXPRESSION('')
  --!collCores.filter(!expressCoreNum)
  !collCoresResults = !collCores.results()

  -- set the cores reference to be an array of core objects
  -- iterate through the collection and create objects for each
  do !i from 1 to !collCoresResults.size()
    !this.cores.append(object core(!collCoresResults[!i]))
  enddo

  -- collect all child pointr references
  !collPointrs = object COLLECTION()
  !collPointrs.type('POINTR')
  !collPointrs.scope(!this.dbref)
  !collPointrsResults = !collPointrs.results()

  -- set the cores reference to be an array of core objects
  -- iterate through the collection and create objects for each
  do !i from 1 to !collPointrsResults.size()
    !this.pointrs.append(!collPointrsResults[!i])
  enddo

  -- collect all child pointr references
  !collExtgeos = object COLLECTION()
  !collExtgeos.type('EXTGEO')
  !collExtgeos.scope(!this.dbref)
  !collExtgeosResults = !collExtgeos.results()

  -- set the cores reference to be an array of core objects
  -- iterate through the collection and create objects for each
  do !i from 1 to !collExtgeosResults.size()
    !this.extgeos.append(!collExtgeosResults[!i])
  enddo

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()is BOOLEAN

     !undo               = object UNDOABLE()
    !undo.add()
  -- Navigate to default storage area if set
    !!ce = !!cbldflts.cableZoneDefault
    handle ANY
		endhandle
  -- When loading from external file double check name here,
  -- Entry could be duplicated in the file
  if !this.name.unset().not() then
    if !this.name.eq('/') then
    	!name = ''
    elseif !this.name.substring(1,1).neq('=') and !this.name.substring(1,1).neq('/') then
      !name = '/' + !this.name
    else
      !name = !this.name
    endif
  endif
  !name = !!checkName(!name,'NEW')
  if !this.name.unset() then
  	!this.errors.append('Element Already exists, cannot create')
    !return = FALSE
  else
    --Create cable
    NEW CABLE
    handle ANY
      !this.errors.append(!!error.text)
      !return = FALSE
    elsehandle NONE
      --Update Data
      !this.dbref = !!ce
      !!ce.name  = !this.name
      handle ANY
      endhandle
      !this.errors = !this.updateData(|CREATE|)
      !return = TRUE
    endhandle
    New RPATH
  endif 	

  !undo.endUndoable()
  return !return


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!numCores is REAL)is  BOOLEAN
  --Create cable
  if !this.create() then
    !return = TRUE
    -- if spref is set then find out the required core data and apply to the core object
    if !this.spref.unset().not() then
      if !numCores.neq(0) then
        do !i from 1 to !numCores.real()
          !thisCore = object CORE()
          !thisCore.create()
        enddo
      endif
    endif
  else
    !return = FALSE
  endif

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createPointr
--
-- Description: creates the routing point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPointr()

  !undo               = object UNDOABLE()
  !undo.add()
  --!!ce = !this.dbref
  if (!!ce.type.eq('CABLE')) then
     !rpath   = rpath 1 of ce
     $!rpath
     NEW POINTR
     handle ANY
     --No route points created
     endhandle
   elseif(!!ce.type.eq('POINTR'))then
   	 !!ce = !this.pointr
     NEW POINTR
   endif
   !this.pointr = !!ce
  --!this.loadData(!this.cableobj.dbref.name, |POINTRCREATE|)
  !undo.endUndoable()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: createExtgeo()
--
-- Description: create a extgeo element and append its data to the list gadget
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createExtgeo()

   !undo               = object UNDOABLE()
   !undo.add()
   !!ce = !this.dbref
   if(!!ce.type.eq('CABLE')) then
     !rpath   = rpath 1 of ce
     $!rpath
     --!this.cableway.pointr  = pointr 1 of rpath 1 of ce
     NEW EXTGEO
     handle ANY
     --No route points created
     endhandle
   elseif(!!ce.type.eq('EXTGEO'))then
   	!!ce = !this.extgeo
     NEW EXTGEO
   endif
   !this.extgeo = !!ce
   !undo.endUndoable()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addCore
--
-- Description: add a core element to the cores member list and create it via the core object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addCore()

  !core = object CORE()
  !!ce = !this.dbref
  !coredb = !core.create()
  !this.cores.append(!core)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: modifies an existing cable element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()
	
  !obj = object MDRLICENCEMANAGER()
	!licenceError= !obj.getLicence('CABLES')
	!error = !obj.lastError()
  if (!licenceError LT 0) then
	--Alert the user of invalid licence/seats
		!!alert.error('$!error')
    return
  else
    --Update Data
    !this.errors = !this.updateData(|MODIFY|)
    if !this.errors.set() then
      !name = !this.dbref.name
      if !this.errors.size().eq(1) then
        !errorMessage = 'The following attribute on ' & !name & ' can not be modified:
' & !this.errors[1]
      else
        !errorMessage = 'The following attributes on ' & !name & ' can not be modified:
'
        do !message values !this.errors
          !errorMessage = !errorMessage & '- ' & !message & '
'
        enddo
        !errorMessage = !errorMessage.substring(1, !errorMessage.length() - 1)
      endif
      !!alert.error(!errorMessage)
    endif
  endif
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createCores
--
-- Description: modifies an existing cable element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createCores(!numCores is REAL)

  -- this method is only called when the core spec is unset because it creates
  -- blank core objects based on the number specified in the form
  -- cores which have already been created must be modified in a new part of the form
  -- so we can maintain data integrity for core data which has already been set.
  if !this.cores.unset() then
    do !i from 1 to !numCores
      !core = object CORE()
      !coredb = !core.create()
      !this.cores.append(!core)
    enddo
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteCbl
--
-- Description: deletes an existing cable element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCbl()

  !undo               = object UNDOABLE()
  !undo.add()

  !!ce = !this.dbref
  delete cable

  !undo.endUndoable()
endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteCore
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCore(!ref is DBREF)

  -- loop through the cores member to try and find the passed reference.
  -- if we can't find it then there is a problem and we do nothing more.
  do !i from 1 to !this.cores.size()
    if !this.cores[!i].dbref.eq(!ref) then
      -- we have the correct core so delete it using the core method
      !delCore = !!alert.confirm('Do you really want to delete core $!this.cores[$!i].dbref.flnn?')
      if(!delCore.eq('YES'))then
        !this.cores[!i].deleteCore()
        !this.cores[!i].delete()
      else
        return
      endif
    endif
  enddo
  !this.cores.compress()

endmethod

------------------------------------------------------------------------
--
-- Method:      deletePointr
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletePointr()

  -- loop through the cores member to try and find the passed reference.
  -- if we can't find it then there is a problem and we do nothing more.

  !undo               = object UNDOABLE()
  !undo.add()

   do !i from 1 to !this.pointrs.size()
    if !this.pointrs[!i].eq(!this.pointr) then
      !!ce = !this.pointrs[!i]
  delete POINTR
    endif
  enddo


  !undo.endUndoable()
endmethod


------------------------------------------------------------------------
--
-- Method:      deleteExtgeo
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteExtgeo()

  -- loop through the cores member to try and find the passed reference.
  -- if we can't find it then there is a problem and we do nothing more.

  !undo               = object UNDOABLE()
  !undo.add()
  do !i from 1 to !this.extgeos.size()
    if !this.extgeos[!i].eq(!this.extgeo) then
      !!ce = !this.extgeos[!i]
  delete EXTGEO
    endif
  enddo

  !undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      updateCore
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCore(!ref is DBREF)

  -- loop through the cores member to try and find the passed reference.
  -- if we can't find it then there is a problem and we do nothing more.
  do !i from 1 to !this.cores.size()
    if !this.cores[!i].dbref.eq(!ref) then
      --we have the correct core so update it using the core method
      !this.cores[!i].dbref.desc = !this.coreDesc
      handle(2,796)
      endhandle
      !this.cores[!i].dbref.func = !this.coreFunc
      handle(2,796)
      endhandle
      !this.cores[!i].dbref.purp = !this.corePurp
      handle(2,796)
      endhandle
      !this.cores[!i].dbref.staRef = !this.coreHref
      handle(2,796)
      endhandle
      !this.cores[!i].dbref.endRef = !this.coreTref
      handle(2,796)
      endhandle
    endif
  enddo

endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updatePointr
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatePointr(!ref is DBREF)

  -- loop through the cores member to try and find the passed reference.
  -- if we can't find it then there is a problem and we do nothing more.
  do !i from 1 to !this.pointrs.size()
    if !this.pointrs[!i].dbref.eq(!ref) then
      --we have the correct core so update it using the core method
      !this.pointrs[!i].dbref.desc = !this.pointrDesc
      handle(2,796)
      endhandle
      !this.pointrs[!i].dbref.func = !this.pointrFunc
      handle(2,796)
      endhandle
    endif
enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateExtgeo
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateExtgeo(!ref is DBREF)

  -- loop through the cores member to try and find the passed reference.
  -- if we can't find it then there is a problem and we do nothing more.
  do !i from 1 to !this.extgeos.size()
    if !this.extgeos[!i].dbref.eq(!ref) then
      --we have the correct core so update it using the core method
      !this.extgeos[!i].dbref.desc = !this.extgeoDesc
      handle(2,796)
      endhandle
      !this.extgeos[!i].dbref.func = !this.extgeoFunc
      handle(2,796)
      endhandle
      !this.extgeos[!i].dbref.staRef = !this.extgeoHref
      handle(2,796)
      endhandle
      !this.extgeos[!i].dbref.endRef = !this.extgeoTref
      handle(2,796)
      endhandle
    endif
enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method: updateData
--
-- Description: Updates the modified data
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData(!mode is STRING) is ARRAY

  -- mode is either CREATE or MODIFY
  !errors = object ARRAY()
  -- write the member variable values back to the cable element this allows the calling form to
  -- only make permanent changes when it has purposefully altered the object member values.

  -- now write the variables back to the dbref
  if !this.name.unset().not() then
    if !this.name.substring(1,1).neq('=') and !this.name.substring(1,1).neq('/') then
      !name = '/' + !this.name
    else
      !name = !this.name
    endif
    !!ce.name             = !name
    handle ANY
      --!errors.append('Name (NAME) - ' & !!error.text)
    endhandle
  endif

  if !this.desc.unset().not() then
    !this.dbref.description      = !this.desc
      handle ANY
        !errors.append('Description (DESC) - ' & !!error.text)
      endhandle
  endif

  if !this.desc.unset().not() then
    !this.dbref.function         = !this.func
      handle ANY
        !errors.append('Function (FUNC)  - ' & !!error.text)
      endhandle
  endif

  if !this.purp.unset().not() then
    !this.dbref.purpose          = !this.purp
      handle ANY
        !errors.append('Purpose (PURP) - ' & !!error.text)
      endhandle
  endif

  if !this.iclass.unset().not() then
    !this.dbref.iclass          = !this.iclass
      handle ANY
        !errors.append('Interference class (ICLASS) - ' & !!error.text)
      endhandle
  endif

  if !this.number.unset().not() then
    !this.dbref.number           = !this.number
      handle ANY
        !errors.append('Number (NUMB) - ' & !!error.text)
      endhandle
  endif

  if !this.area.unset().not() then
    !this.dbref.area             = !this.area
      handle ANY
        !errors.append('Area (AREA) - ' & !!error.text)
      endhandle
  endif

  if !this.pos.unset().not() then
    !this.dbref.position         = !this.pos
      handle ANY
        !errors.append('Position (POS) - ' & !!error.text)
      endhandle
  endif

  if !this.ori.unset().not() then
    !this.dbref.ori              = !this.ori
      handle ANY
        !errors.append('Orientation (ORI) - ' & !!error.text)
      endhandle
  endif

  if !this.spref.unset().not() then
    !this.dbref.spref            = !this.spref
      handle ANY
        !errors.append('Specification Reference (SPREF) - ' & !!error.text)
      endhandle
  endif

    -- cable specific data
  if !this.startDesc.unset().not() then
    !this.dbref.feqdes           = !this.startDesc
      handle ANY
        !errors.append('From Equipment Description (FEQDES) - ' & !!error.text)
      endhandle
  endif

  if !this.endDesc.unset().not() then
    !this.dbref.teqdes           = !this.endDesc
      handle ANY
        !errors.append('To Equipment Description (TEQDES) - ' & !!error.text)
      endhandle
  endif

  if !this.markrf.unset().not() then
    --!!ce.markrf           = !this.markrf[1]
    markrf $!this.markrf[1]
    handle ANY
      !errors.append('Cable Mark points (MARKRF) - ' & !!error.text)
    endhandle
  endif

  if !this.routNode.unset().not() then
    !this.dbref.routnd           = !this.routNode
      handle ANY
        !errors.append('Cable Preliminary Route Point (ROUTND) - ' & !!error.text)
      endhandle
  endif

  if !this.cexes.unset().not() then
    !this.dbref.cexes            = !this.cexes
      handle ANY
        !errors.append('Excess Lengths (CEXES) - ' & !!error.text)
      endhandle
  endif

  if !this.staRef.unset().not() then
    !this.dbref.staRef           = !this.staRef
      handle ANY
        !errors.append('Cable Start Reference (STAREF) - ' & !!error.text)
      endhandle
  endif

  if !this.endRef.unset().not() then
    !this.dbref.endRef           = !this.endRef
      handle ANY
        !errors.append('Cable End reference (ENDREF) - ' & !!error.text)
      endhandle
  endif

  if !this.staPoint.unset().not() then
    !this.dbref.staPoint         = !this.staPoint
      handle ANY
        !errors.append('Cable Start Connection Point (STAPOINT) - ' & !!error.text)
      endhandle
  endif

  if !this.endPoint.unset().not() then
    !this.dbref.endPoint         = !this.endPoint
      handle ANY
        !errors.append('Cable End Connection Point (ENDPOINT) - ' & !!error.text)
      endhandle
  endif

  if !this.cbStatus.unset().not() then
    !this.dbref.cbStatus         = !this.cbStatus
      handle ANY
        !errors.append('Routing Status (CBSTATUS) - ' & !!error.text)
      endhandle
  endif
  if !this.fillChk.unset().not() then
    !this.dbref.filChk         = !this.fillChk
      handle ANY
        !errors.append('Fill Check (FILLCHK) - ' & !!error.text)
      endhandle
  endif
  if !this.system.unset().not() then
    !this.dbref.mdsysf         = !this.system
      handle ANY
        !errors.append('Model and Design Elements (MDSYSF) - ' & !!error.text)
      endhandle
  else
  	$!this.dbref.name Mdsysf Unset
  	handle ANY
      !errors.append('Model and Design Elements (MDSYSF) - ' & !!error.text)
    endhandle
  endif
  if !this.raneq.unset().not() then
    !this.dbref.raneq          = !this.raneq
      handle ANY
        !errors.append('Proximity Distance (RANEQ) - $!!error.text')
      endhandle
  endif
  return !errors

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: highlight
--
-- Description: highlights the start and end point of the cable
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight(!mode is STRING)

  aid clear all
  if(!mode eq 'TRUE')then
    !this.startAidNum = !!aidNumbers.add('CableStart')
    !this.endAidNum   = !!aidNumbers.add('CableEnd')
    aid clear text $!this.endAidNum
    handle ANY
    endhandle
    aid clear text $!this.startAidNum
    handle ANY
    endhandle
    unenhance all
  endif
  -- this method needs refinement, the enhance colour
  -- needs to be linked to values that are appropriate for the autocolour of the model.
  if !this.startAidNum.unset() then
    !this.startAidNum = !!aidNumbers.add('CableStart')
  else
    !num = !this.startAidNum
    aid clear text $!num
    handle ANY
    endhandle
  endif

  if !this.endAidNum.unset() then
    !this.endAidNum = !!aidNumbers.add('CableEnd')
  else
  !num  = !this.endAidNum
    aid clear text $!num
    handle ANY
    endhandle
  endif

  unenhance all

  -- mode will be TRUE or FALSE dependent upon whether you want to switch on or turn off highlighting
  if !mode.eq('TRUE') then
    if !this.staRef.unset().not() then
      enhance $!this.staRef colour $!!gphcolopt.aids
      !pos = !this.staRef.position.wrt( /* )
      aid text num $!this.startAidNum '<Start>' at $!pos
      --aid text num $!this.startAidNum '<Start>' at $!this.staRef.position
    endif

    if !this.endRef.unset().not() then
      enhance $!this.endRef colour $!!gphcolopt.aids
      !pos = !this.endRef.position.wrt( /* )
      aid text num $!this.endAidNum '<End>' at $!pos
      --aid text num $!this.endAidNum '<End>' at $!this.endRef.position
    endif
  else
    aid clear all
    unenhance all
    -- do nothing we have already un-enhanced
  endif

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: checkOutsideDiameter
--
-- Description: Calculate the outside diameter of a cable and return warning string if
--              unset or set to 0mm.  If no error, returns blank string
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  STRING      Warning message (blank if no warning)
------------------------------------------------------------------------

define method .checkOutsideDiameter() is STRING

  !warning = ''

  if (!this.spref.unset()) then
    !warning = 'Cable spec is not set. This will lead to incorrect fill level calculations '
  else
    !result = !this.spref.propre.attribute('OUTD')
    if( !result.unset() ) then
      !warning = 'Chosen cable specification has an unset Outside Diameter, this will lead to incorrect fill level calculations'
    elseif( !result eq 0mm) then
      !warning = 'Chosen cable specification has an Outside Diameter of 0, this will lead to incorrect fill level calculations'
    endif
  endif

  return !warning

endmethod
--End of method definition

-- End of object definition
