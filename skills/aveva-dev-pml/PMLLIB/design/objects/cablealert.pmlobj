--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  CableAlert()                     -
--  showConnectionStatusMessage(REAL) -
--
define object CableAlert
 --array of strings
 $(
enum TConnectionStatus
	{
		CS_SUCCESS=0,
		CS_FAIL_TYPE,
		CS_FAIL_HEAD,
		CS_FAIL_TAIL,
		CS_FAIL_SEGMENT,
		CS_FAIL_BRANCH,
		CS_FAIL_CRBRANCH
};
$)

  member .alerts is Array


define method .CableAlert()
  !this.alerts.Append('Cable connection error.Incorrect branch type')
  !this.alerts.Append('Cable connection error.Incorrect head connection')
  !this.alerts.Append('Cable connection error.Incorrect tail connection')
  !this.alerts.Append('Cable connection error.Incorrect segment connection')
  !this.alerts.Append('Cable connection error.Incorrect branch connection')
  !this.alerts.Append('Cable connection error.Incorrect crbranch connection')
endmethod

define method .showConnectionStatusMessage(!code is REAL)
    if !code gt !this.alerts.Size() or !code lt 0 then
      !!alert.Error('Unrecognized error code')
    elseif !code eq 0 then
      !!alert.Message('Connections OK.')
    else
      !!alert.Error(!this.alerts[!code])
    endif
endmethod

endobject
