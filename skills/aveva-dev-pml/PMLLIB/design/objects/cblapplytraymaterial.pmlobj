--
-- Description:
-- Finding a specification for cable tray component
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyMaterial(DBREF)             -
--  applyMaterialForRiserStraight(DBREF,DBREF) -                   Creates CTRAY and assigns spref
--  cblapplytraymaterial(DBREF)      -
--  checkAngle()                     BOOLEAN             Method checks if the angle on selected tray is the same as the angle on cable tray component
--  collectTabitemOfType(DBREF,STRING) -
--  collectTabitemWithWidth(ARRAY,REAL,STRING) -                   Method collects tabitem of selected width
--  compareDistance(ARRAY,REAL)      ARRAY               Test distance values against given distance
--  dressWholeBranch (DBREF)         -
--  findAnswers(ANY,EXPRESSION)      ARRAY               Search TABQUE for answers
--  findAnswersOwner(ANY,EXPRESSION) ARRAY               Search TABQUE for answers and evaluate the owner
--  findOffset(REAL,REAL)            REAL
--  findSpecificationForStraight(REAL) DBREF
--  getNearestAngle(REAL)            REAL
--  orientComponent(DBREF)           -                   Orient the CTRAY component to match the CTMTRL
--  orientRiserStraight(DBREF,REAL,REAL,STRING) -                   Orient the CTSTRA created for risers when using tiers
--  positionTrayInComponent (DBREF,DBREF) -
--  specForCTBEND(STRING,REAL,REAL,REAL,STRING) DBREF               Finds spec for CTBEND based on the given design attributes
--  specForCTCROS(STRING,REAL,REAL,REAL) DBREF               Finds spec for CTCROS based on the given design attributes
--  specForCTREDU(STRING,REAL,REAL,REAL) DBREF               Finds spec for CTREDU based on the given design attributes
--  specForCTRISE(STRING,REAL,REAL,REAL,STRING) DBREF               Finds spec for CTRISE based on the given design attributes
--  specForCTSTRA(STRING,REAL,REAL)  DBREF               Finds spec for CTSTRA based on the given design attributes
--  specForCTTEE(STRING,REAL,REAL,REAL) DBREF               Finds spec for CTTEE based on the given design attributes
--  specForCableTrayComponent(DBREF) DBREF
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define object CBLAPPLYTRAYMATERIAL

  -- Current specification selection
  member .cableTraySpec            is DBREF

  -- Default straight length
  member .defaultLength            is REAL

  -- Arrays of Tabitems for each type
  member .tableOfCTSTRA            is ARRAY
  member .tableOfCTBEND            is ARRAY
  member .tableOfCTRISE            is ARRAY
  member .tableOfCTREDU            is ARRAY
  member .tableOfCTTEE             is ARRAY
  member .tableOfCTCROS            is ARRAY

  -- Current width of components
  member .ctstraWidth              is REAL
  member .ctbendWidth              is REAL
  member .ctriseWidth              is REAL
  member .ctreduWidth              is REAL
  member .ctteeWidth               is REAL
  member .ctcrosWidth              is REAL

  -- Arrays of tabitems with correct width
  member .tableOfCTSTRAWidth       is ARRAY
  member .tableOfCTBENDWidth       is ARRAY
  member .tableOfCTRISEWidth       is ARRAY
  member .tableOfCTREDUWidth       is ARRAY
  member .tableOfCTTEEWidth        is ARRAY
  member .tableOfCTCROSWidth       is ARRAY

endobject
------------------------------------------------------------------------
--
-- Method: cblapplytraymaterial
--
-- Description: This is constructor which is setting class member
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
define method .cblapplytraymaterial(!cableTrayMaterial  is DBREF)

  if (!cableTrayMaterial.type.eq('CTMTRL')) then
    !this.cableTraySpec = !cableTrayMaterial.ctspe
  else
    !this.cableTraySpec = object DBREF()
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: dressWholeBranch
--
-- Description: This method apples cable tray to whole branch
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dressWholeBranch (!cableWayMaterial is DBREF)

  -- Check that there are material elements to dress
  if !cableWayMaterial.type.eq('CTMTRL') then
    !items = !cableWayMaterial.members
     if !items.unset() then
       !!alert.error('No material elements available for applying material')
       return
     endif
  endif

  do !component values  !items
    -- progress bar
    !progress = (!component.sequence / !items.size()) * 100
    !!fmsys.setprogress(!progress)
    !trays = !component.members
    if (!trays.size() lt 1) then
      !this.applyMaterial(!component)
    endif
  enddo

  !!fmsys.setprogress(0)

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: specForCableTrayComponent
--
-- Description: This method gathers the required design attributes and then calls
--              individual component methods to find the required specification
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       CTMTRL element
-- Return:
-- [Data Type] [Description]
--  DBREF       Suitable specification for CTRAY
--
------------------------------------------------------------------------
define method .specForCableTrayComponent(!component is DBREF) is DBREF

  if !component.badref() then
    !!alert.error('Material Element is Deleted. Cannot apply the material.')
    return false
  endif

  !type   =  !component.type
  !width  =  !component.trayw
 ------------------ CTSTRA ------------------
  if !type.eq('CTSTRA') then
    !olength = !component.olength
    return !this.specForCTSTRA(!type,!width,!olength)
  -------------------------------------------
  ------------------ CTBEND -----------------
  elseif !type.eq('CTBEND') then
    !cangle = !component.angle.value().nint()
    !cttype = !component.cttype
    !frad   = !component.radius
    return !this.specForCTBEND(!type,!width,!cangle,!frad,!cttype)
  -------------------------------------------
  ------------------ CTRISE -----------------
  elseif !type.eq('CTRISE') then
    !cangle = !component.angle.value().nint()
    !cttype = !component.cttype
    !frad   = !component.radius
    return !this.specForCTRISE(!type,!width,!cangle,!frad,!cttype)
  -------------------------------------------
  ------------------ CTREDU -----------------
  -- Note dressing with reducers is not implemented.
  elseif !type.eq('CTREDU') then
    !lwidth  = !component.trayrw
    !olength = !component.olength
    return !this.specForCTREDU(!type,!width,!lwidth,!olength)
  -------------------------------------------
  ------------------ CTTEE ------------------
  elseif !type.eq('CTTEE') then
    !brwidth  = !component.traysw
    !frad     = !component.radius
    return !this.specForCTTEE(!type,!width,!brwidth,!frad)
  -------------------------------------------
  ------------------ CTCROS------------------
  elseif !type.eq('CTCROS') then
    !brwidth  = !component.traysw
    !frad     = !component.radius
    return !this.specForCTCROS(!type,!width,!brwidth,!frad)
  -------------------------------------------
  endif
 return object DBREF()

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: specForCTSTRA
--
-- Description: Finds spec for CTSTRA based on the given design attributes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Tray component type
--  2   R      REAL        Tray component width
--  3   R      REAL        Tray overall length
-- Return:
-- [Data Type] [Description]
-- DBREF        Suitable tray specification
--
------------------------------------------------------------------------
define method .specForCTSTRA(!type is STRING,!width is REAL,!olength is REAL) is DBREF

  -- Collect items of the correct type
  if !this.tableOfCTSTRA.empty() then
    !this.collectTabitemOfType(!this.cableTraySpec,!type)
  endif

  -- Filter for items with the correct width
  if(!this.ctstraWidth.neq(!width)) then
    !this.ctstraWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTSTRA,!width,!type)
  endif

  -- Decide if the straight is fixed or variable length
  if !olength.neq(!this.defaultLength) then
    !stype = 'VL'
  else
    !stype = 'FL'
  endif

  -- Filter for items of the correct subtype
  if !stype.eq('FL') then
    !express = object EXPRESSION('TANSWER EQ |FL| or TANSWER EQ |F|')
  else
    !express = object EXPRESSION('TANSWER EQ |VL| or TANSWER EQ |V|')
  endif
  !specItem = !this.findAnswersOwner(!this.tableOfCTSTRAWidth, !express)

  -- Choose the first available item
  if !specItem.set() then
    return !specItem[1]
  else
    -- Put out error if no component available
    !!alert.warning('Cannot find CTSTRA element with width $!width')
    return object DBREF()
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: specForCTBEND
--
-- Description: Finds spec for CTBEND based on the given design attributes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Tray type
--  2   R      REAL        Tray width
--  3   R      REAL        Tray angle
--  4   R      REAL        Tray radius
--  5   R      STRING      Tray sub-type
-- Return:
-- [Data Type] [Description]
--  DBREF       Suitable tray specification
--
------------------------------------------------------------------------
define method .specForCTBEND(!type is STRING,!width is REAL,!cangle is REAL,!frad is REAL,!cttype is STRING) is DBREF

  -- Collect items of the correct type
  if !this.tableOfCTBEND.empty() then
    !this.collectTabitemOfType(!this.cableTraySpec, !type)
  endif

  -- Filter for items with the correct width
  if(!this.ctbendWidth.neq(!width)) then
    !this.ctbendWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTBEND,!width,!type)
  endif

  -- Filter for items with the correct angle
  !matAngleOptions = !this.findAnswersOwner(!this.tableOfCTBENDWidth, object EXPRESSION(' PURP EQ |ANGL| AND TANSWER EQ |$!cangle|'))

  -- If there are no answers for the angle then select the closest standard angle and try again
  if (!matAngleOptions.set().not()) then
    !cangle = !this.getNearestAngle(!cangle)
    !matAngleOptions = !this.findAnswersOwner(!this.tableOfCTBENDWidth, object EXPRESSION(' PURP EQ |ANGL| AND TANSWER EQ |$!cangle|'))
  endif

  -- If only one item matches choose this
  if (!matAngleOptions.size() eq 1) then
    return !matAngleOptions[1]
  else
    -- Find if bend is right or left handed
    if !cttype.eq('RIGH') then
      !express = object EXPRESSION('TANSWER EQ |R| or TANSWER EQ |RH|')
    else
      !express = object EXPRESSION('TANSWER EQ |L| or TANSWER EQ |LH|')
    endif

    -- Filter for items of the correct hand
    !specItem = !this.findAnswersOwner(!matAngleOptions, !express)

    -- Filter for items of the correct radius
    !filetRadius = !this.findAnswers(!specItem,object EXPRESSION(' PURP EQ |RADI| AND TANSWER NEQ ||'))
    !final       = !this.compareDistance(!filetRadius,!frad)

    -- Choose the first item available
    if !final.set() then
      return  !final[1]
    elseif !specItem.set() then
      return  !specItem[1]
    else
      -- Put out error if no component available
      !!alert.warning('Cannot find $!cttype CTBEND element with width $!width and angle $!cangle')
      return object DBREF()
    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: specForCTRISE
--
-- Description: Finds spec for CTRISE based on the given design attributes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Tray type
--  2   R      REAL        Tray width
--  3   R      REAL        Tray Angle
--  4   R      REAL        Tray radius
--  5   R      STRING      Tray sub-type
-- Return:
-- [Data Type] [Description]
--  DBREF       Suitable tray specification
--
------------------------------------------------------------------------
define method .specForCTRISE(!type is STRING,!width is REAL,!cangle is REAL,!frad is REAL,!cttype is STRING) is DBREF

  -- Collect items of the correct type
  if !this.tableOfCTRISE.empty() then
    !this.collectTabitemOfType(!this.cableTraySpec, !type)
  endif

  -- Filter for items of the correct width
  if(!this.ctriseWidth.neq(!width)) then
    !this.ctriseWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTRISE,!width,!type)
  endif

  -- Filter for items with the correct angle
  !matAngleOptions = !this.findAnswersOwner(!this.tableOfCTRISEWidth, object EXPRESSION(' PURP EQ |ANGL| AND TANSWER EQ |$!cangle|'))

  -- If there are no answers for the angle then select the closest standard angle and try again
  if (!matAngleOptions.set().not()) then
    !cangle = !this.getNearestAngle(!cangle)
    !matAngleOptions = !this.findAnswersOwner(!this.tableOfCTRISEWidth, object EXPRESSION(' PURP EQ |ANGL| AND TANSWER EQ |$!cangle|'))
  endif

  -- Find if inside or outside radius riser
  if !cttype.eq('OUTS') then
    !express = object EXPRESSION('TANSWER EQ |OR| or TANSWER EQ |ER|')
  else
    !express = object EXPRESSION('TANSWER EQ |IR| ')
  endif
  -- Filter for items of the correct sub-type
  !specItem = !this.findAnswersOwner(!matAngleOptions, !express)

  -- Filter for items of the correct radius
  !filetRadius = !this.findAnswers(!specItem,object EXPRESSION(' PURP EQ |RADI| AND TANSWER NEQ ||'))
  !final       = !this.compareDistance(!filetRadius,!frad)

  -- Choose the first item from those available
  if !final.set() then
    return  !final[1]
  elseif !specItem.set() then
    return  !specItem[1]
  else
    -- Put out error if no component available
    !!alert.warning('Cannot find $!cttype CTRISE element with width $!width and angle $!cangle')
    return object DBREF()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: specForCTTEE
--
-- Description: Finds spec for CTTEE based on the given design attributes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Tray type
--  2   R      REAL        Tray width
--  3   R      REAL        Tray branch width
--  4   R      REAL        Tray radius
-- Return:
-- [Data Type] [Description]
--  DBREF       Suitable tray specification
--
------------------------------------------------------------------------
define method .specForCTTEE(!type is STRING,!width is REAL,!brwidth is REAL,!frad is REAL) is DBREF

  -- Collect items of correct type
  if(!this.tableOfCTTEE.empty()) then
    !this.collectTabitemOfType(!this.cableTraySpec,!type)
  endif

  -- Filter for items of the correct width
  if(!this.ctteeWidth.neq(!width)) then
    !this.ctteeWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTTEE,!width,!type)
  endif

  -- Filter for items with the correct branch width
  !branchWidth = !this.findAnswers(!this.tableOfCTTEEWidth,object EXPRESSION('PURP eq |BRWI| and TANSWER NEQ ||'))
  !specItem    = !this.compareDistance(!branchWidth,!brwidth)

  -- Filter for items with the correct radius
  !filetRadius = !this.findAnswers(!specItem,object EXPRESSION('PURP EQ |RADI| AND TANSWER NEQ ||'))
  !final       = !this.compareDistance(!filetRadius,!frad)

  -- Choose the first item from those available
  if(!final.set()) then
    return  !final[1]
  elseif(!specItem.set()) then
    return  !specItem[1]
  else
    -- Put out error if no component available
    !!alert.warning('Cannot find CTTEE element with width $!width and branch width $!brwidth ')
    return object DBREF()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: specForCTCROS
--
-- Description: Finds spec for CTCROS based on the given design attributes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Tray type
--  2   R      REAL        Tray width
--  3   R      REAL        Tray branch width
--  4   R      REAL        Tray radius
-- Return:
-- [Data Type] [Description]
--  DBREF       Suitable tray specification
--
------------------------------------------------------------------------
define method .specForCTCROS(!type is STRING,!width is REAL,!brwidth is REAL,!frad is REAL) is DBREF

  -- Collect items of correct type
  if(!this.tableOfCTCROS.empty()) then
    !this.collectTabitemOfType(!this.cableTraySpec,!type)
  endif

  -- Filter for items of the correct width
  if(!this.ctcrosWidth.neq(!width)) then
    !this.ctcrosWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTCROS,!width,!type)
  endif

  -- Filter for items with the correct branch width
  !branchWidth = !this.findAnswers(!this.tableOfCTCROSWidth,object EXPRESSION('PURP eq |BRWI| and TANSWER NEQ ||'))
  !specItem    = !this.compareDistance(!branchWidth,!brwidth)

  -- Filter for items with the correct radius
  !filetRadius = !this.findAnswers(!specItem,object EXPRESSION(' PURP EQ |RADI| AND TANSWER NEQ ||'))
  !final       = !this.compareDistance(!filetRadius,!frad)

  -- Choose the first item from those available
  if !final.set() then
    return  !final[1]
  elseif !specItem.set() then
    return  !specItem[1]
  else
    -- Put out error if no component available
    !!alert.warning('Cannot find CTCROS element with width $!width and branch width $!brwidth ')
    return object DBREF()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: specForCTREDU
--
-- Description: Finds spec for CTREDU based on the given design attributes
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Tray type
--  2   R      REAL        Tray width
--  3   R      REAL        Tray reducing width
--  4   R      REAL        Tray overall length
-- Return:
-- [Data Type] [Description]
--  DBREF       Suitable tray specification
--
------------------------------------------------------------------------
define method .specForCTREDU(!type is STRING,!width is REAL,!lwidth is REAL,!olength is REAL) is DBREF

  -- Collect items of correct type
  if(!this.tableOfCTREDU.empty()) then
    !this.collectTabitemOfType(!this.cableTraySpec,!type)
  endif

  -- Filter for items of the correct width
  if(!this.ctreduWidth.neq(!width)) then
    !this.ctreduWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTREDU,!width,!type)
  endif

  !leaveWidth  = !this.findAnswers(!this.tableOfCTREDUWidth,object EXPRESSION('PURP eq |LWID| and TANSWER NEQ ||'))
  !specItem    = !this.compareDistance(!leaveWidth,!lwidth)

  !overallLength = !this.findAnswers(!specItem,object EXPRESSION(' PURP EQ |LENG| AND TANSWER NEQ ||'))
  !final         = !this.compareDistance(!overallLength,!olength)

    -- Choose the first item from those available
  if !final.set() then
    return  !final[1]
  else
    -- Put out error if no component available
    !!alert.warning('Cannot find CTREDU element with width $!width and leave width $!lwidth ')
    return object DBREF()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: applyMaterial
--
-- Description: This method apples cable tray to single tray component
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyMaterial(!component is DBREF)

  if !component.badref() then
    !!alert.error('Material Element is Deleted. Cannot apply the material.')
    return
  endif

  if !this.cableTraySpec.unset() then
    !!alert.error('Specification not set for Material')
    return
  endif

  --units
--  !saveUnits = object COMUNITS(true)
--  mm BORE
--  mm DISTANCE

  !tabItem = !this.specForCableTrayComponent(!component)

  if (!tabItem.unset()) then
    return
  endif

  -- Mark database
  !undo               = object UNDOABLE()
  !undo.description('Dress')
  !undo.add()

  !this.positionTrayInComponent (!component, !tabItem)

  --End undo mark
  !undo.endUndoable()
  handle ANY
  endhandle

  --reset units
  --  !saveUnits.restoreSavedBoreDist()

 endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: positionTrayInComponent
--
-- Description: This method positions trays inside tray component
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .positionTrayInComponent (!component is DBREF, !tabItem is DBREF)

  --get length if the item is Straight'
  if !component.type.eq('CTSTRA') then
    !height = !component.olength
  else
    !height = 0
  endif

  !!ce = !component

  if !!ce.tierheight.size().lt(2) then
    -- see if there are more than 1 CTRAY
    if !!ce.members.size().gt(1) then
      do !i from 2 to !!ce.members.size()
        CTRAY $!i
        delete CTRAY
      enddo
    endif

    CTRAY 1
    handle ANY
      new CTRAY
    endhandle
    !!ce.spref  = !tabItem
    !!ce.height = !height

    -- Orient the tray component in the CTMTRL
    !this.orientComponent(!!ce)

  else
    -- see if there are more cable trays
    if !!ce.members.size().gt(!!ce.tierheight.size()) then
      if !!ce.type.neq('CTRISE') then
        do !i from (!!ce.tierheight.size() + 1) to !!ce.members.size()
          CTRAY $!i
          handle ANY
          endhandle
          delete CTRAY
        enddo
      else
        -- delete straights
        !dbElement = !!ce
        do !tray values !!ce.members
          !!ce = !tray
          if !!ce.spref.set() then
            if !!ce.spref.catref.gtype.neq('ELBO') then
              delete CTRAY
            endif
          endif
        enddo
        -- delete extras
        !!ce = !dbElement
        do !i from (!!ce.tierheight.size() + 1) to !!ce.members.size()
          CTRAY $!i
          handle ANY
          elsehandle NONE
            delete CTRAY
          endhandle
        enddo
      endif
    endif
    do !j from 1 to !!ce.tierheight.size()
      CTRAY $!j
      handle ANY
        new CTRAY
      endhandle
      -- reset position to 0 0 0
      POSITION E0 N0 U0
      !!ce.spref = !tabItem
      !!ce.height = !height
      !upDistance = !component.tierheight[!j]
      by up $!upDistance

      -- Orient the tray component within the CTMTRL
      !this.orientComponent(!!ce)

      -- move risers
      if !j.gt(1) then
        if !!ce.owner.type.eq('CTRISE') then
          !yOffset = !this.findOffset(!!ce.owner.angle, !upDistance)
          if !!ce.owner.cttype.eq('OUTS') then
            by y $!yOffset
          else
            by y -$!yOffset
          endif
        endif
      endif

    enddo
  endif

  -- change the drawing levels
  !!ce = !component
  level 0 1

  if (!component.type.eq('CTRISE') )then
    !tabItemForStraight = !this.findSpecificationForStraight(!component.trayw)
    !this.applyMaterialForRiserStraight(!component, !tabItemForStraight)
  endif
  !!ce = !component

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: findOffset
--
-- Description: This method finds offset
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findOffset(!angle is REAL, !height is REAL) is REAL

  !x = object REAL()
  !r = object REAL()
  !sinus = object REAL()
  !sinus = sin((180 - !angle) / 2)

  if ( abs(!sinus) gt 0.0000001) then
    !r = (!height) / !sinus
    !x = !r * cos((180 - !angle) / 2)
  else
    !x = 0
  endif

  return !x

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: getNearestAngle
--
-- Description: This method finds angle
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getNearestAngle(!value is REAL) is REAL

  !cangle = object REAL()

  if !value.leq(16) then
    !cangle = 15
  elseif !value.gt(16) and !value.lt(31) then
    !cangle = 30
  elseif !value.gt(31) and !value.lt(46) then
    !cangle = 45
  elseif !value.gt(46) and !value.lt(61) then
    !cangle = 60
  else
    !cangle = 90
  endif

  return !cangle

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: collectTabitemOfType
--
-- Description: Method collects tabitem of selected type
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .collectTabitemOfType(!cableTraySpec is DBREF, !type is STRING)

    -- collect tabitem
    !colResult = !this.findAnswers(!cableTraySpec, object EXPRESSION('TANSWER EQ |$!type|'))

    if !type.eq('CTSTRA') then
      -- get default length
      !tcol = object COLLECTION()
      !tcol.scope(!colResult[1].owner.owner)
      handle any
      endhandle
      !tcol.type('TABHQU')
      do !quest values !tcol.results()
        if !quest.purpose.eq('LENG') then
          !stringLength         = !quest.tdefault
          !this.defaultLength   = !stringLength.real()
          handle any
            !this.defaultLength = !quest.default
            !stringLength       = '0'
          endhandle
          if ( !this.defaultLength.unset() ) then
            !this.defaultLength = !quest.default
          endif
          break
        endif
      enddo
    endif

    !tabItems = object ARRAY()

    !owner = object BLOCK('!colResult[!evalIndex].owner')
    !tabItems = !colResult.evaluate(!owner)

    if !type.eq('CTSTRA') then
      !this.tableOfCTSTRA = !tabItems
    elseif !type.eq('CTBEND') then
      !this.tableOfCTBEND = !tabItems
    elseif !type.eq('CTRISE') then
      !this.tableOfCTRISE = !tabItems
    elseif !type.eq('CTREDU') then
      !this.tableOfCTREDU  = !tabItems
    elseif !type.eq('CTTEE') then
      !this.tableOfCTTEE  = !tabItems
    elseif !type.eq('CTCROS') then
      !this.tableOfCTCROS = !tabItems
    endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: collectTabitemWithWidth
--
-- Description: Method collects tabitem of selected width
--              Width is stored as a string in TANSWER.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      ARRAY       Scope of search for table items
--  2   R      STRING      Width in mm as a string
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .collectTabitemWithWidth(!selection is ARRAY, !width is REAL, !type is STRING)

  !allAnswers          = object ARRAY()
  !selectionWithWidth  = object ARRAY()
  -- get all answers with purpose WIDT
  !allAnswers  =  !this.findAnswers(!selection, object EXPRESSION('PURP eq |WIDT| AND TANSWER NEQ ||'))

  -- find components matching given width
  !selectionWithWidth  =  !this.compareDistance(!allAnswers, !width)

  if !type.eq('CTSTRA') then
    !this.tableOfCTSTRAWidth = !selectionWithWidth
  elseif !type.eq('CTBEND') then
    !this.tableOfCTBENDWidth = !selectionWithWidth
  elseif !type.eq('CTRISE') then
    !this.tableOfCTRISEWidth = !selectionWithWidth
  elseif !type.eq('CTREDU') then
    !this.tableOfCTREDUWidth = !selectionWithWidth
  elseif !type.eq('CTTEE') then
    !this.tableOfCTTEEWidth  = !selectionWithWidth
  elseif !type.eq('CTCROS') then
    !this.tableOfCTCROSWidth = !selectionWithWidth
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: applyMaterialForRiserStraight
--
-- Description: Creates CTRAY and assigns spref
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyMaterialForRiserStraight(!riser is DBREF, !tabItemForStraight is DBREF)

--  !collection = object COLLECTION()
--  !collection.type('CTRISE')
--  !collection.scope(CTMTRL)
--  !result = !collection.results()
--  do !riser values !result
  !straightForRiser  = object ARRAY()
  !noOfStraights  = ( !riser.tierheight.size() - 1 ) * 2
  !!ce = !riser
  !type = !!ce.cttype
  LAST MEM
  do !straight from 1 to !noOfStraights
    !unusedStraight = !straight
    new CTRAY
    if(defined(!tabItemForStraight) and !tabItemForStraight.set())then
      !!ce.spref  = !tabItemForStraight
    endif
    !straightForRiser.append(!!ce)
  enddo

  !arriveStraight  = object ARRAY()
  !leaveStraight   = object ARRAY()
  !arriveStraightIndx = !straightForRiser.size() / 2
  do !arrive from 1 to !arriveStraightIndx
    !arriveStraight.append(!straightForRiser[!arrive])
  enddo
  do !leave from (!arriveStraightIndx + 1 )  to !straightForRiser.size()
    !leaveStraight.append(!straightForRiser[!leave])
  enddo
  !tierHeightReverse  = !!ce.owner.tierheight.invert()
  !revisedTierHeight  = object ARRAY()
  do !val index !tierHeightReverse
    !tierHei   = abs ( !!ce.owner.tierheight.last() - !!ce.owner.tierheight[!val] )
    !revisedTierHeight.append(!tierHei)
  enddo

  do !arriveStr index !arriveStraight
    !!ce = !arriveStraight[!arriveStr]
    if(!!ce.owner.cttype eq 'INSI')then
      !ctraySeq = !arriveStr
      !tierHeightAtt = !revisedTierHeight
    else
      !ctraySeq = !arriveStr + 1
      !tierHeightAtt = !!ce.owner.tierheight
    endif
    -- Orient the CTRAY correctly after being created
    !this.orientRiserStraight(!!ce, 1, !ctraySeq, 'aydir')
    --!!ce.height = !tierHeightAtt[!ctraySeq ]
    !!ce.height = abs ( !this.findOffset(!!ce.owner.angle , !tierHeightAtt[!ctraySeq] ))
  enddo

  do !leaveStr index !leaveStraight
    !!ce = !leaveStraight[!leaveStr]
    if(!!ce.owner.cttype eq 'INSI')then
      !ctraySeq = !leaveStr
      !tierHeightAtt = !revisedTierHeight
    else
      !ctraySeq = !leaveStr + 1
      !tierHeightAtt = !!ce.owner.tierheight
    endif
    -- Orient the CTRAY correctly after being created
    !this.orientRiserStraight(!!ce, 2, !ctraySeq, 'lydir' )
    --!!ce.height = !tierHeightAtt[!ctraySeq]
    !!ce.height = abs ( !this.findOffset(!!ce.owner.angle , !tierHeightAtt[!ctraySeq]))
  enddo

--enddo

 endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: findSpecificationForStraight
--
-- Description: This method finds specification for straights
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findSpecificationForStraight(!width is REAL )  is DBREF

  if !this.tableOfCTSTRA.empty() then
    !this.collectTabitemOfType(!this.cableTraySpec, |CTSTRA|)
  endif

  if (!this.tableOfCTSTRA.empty()) then
    return object DBREF()
  endif

  if(!this.ctstraWidth.neq(!width)) then
    -- get the element with correct width
    !this.ctstraWidth = !width
    !this.collectTabitemWithWidth(!this.tableOfCTSTRA,!width,'CTSTRA')
  endif

  if (!this.tableOfCTSTRAWidth.empty()) then
    return object DBREF()
  endif

  !lastSelection = !this.findAnswersOwner(!this.tableOfCTSTRAWidth, object EXPRESSION('TANSWER EQ |VL| or TANSWER EQ |V|'))

  !specification = !lastSelection[1]
  if (!specification.unset()) then
    !!alert.error('Can not find required variable length straight')
  else
    return !specification
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: checkAngle
--
-- Description: Method checks if the angle on selected tray is the same as the angle on cable tray component
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkAngle()  is BOOLEAN

  !ownAngle = !!ce.owner.angle.nint()
  !angle = !!ce.pDir[1].angle(!!ce.pDir[2])
  if (!angle gt 90) then
    !angle = 180 - !angle
  endif
  if abs(!ownAngle - !angle ) gt 1  then
    !typeElement = !!ce.owner.type
    !!alert.warning('Angle on $!typeElement does not match  angle on selected tray $!!ce.name ')
  endif

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: compareDistance
--
-- Description: Test distance values against given distance from
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      ARRAY       Table items to test
--  2   R      REAL        Distance
-- Return:
-- [Data Type] [Description]
--  ARRAY       Components matching distance, or empty if no match
--
------------------------------------------------------------------------
define method .compareDistance(!allAnswers is ARRAY, !distance is REAL) is ARRAY

  if( !allAnswers.empty() ) then
    return ARRAY()
  endif

  -- have to apply rough 'nominal' unit conversion for an imperial user using a metric catalogue
  !searchValueMapped = !distance.convertUnits('inch').value() * 25

  -- exact comparison using same units
  !searchValueExact = !distance.dbUnits().value()

  !selectionWithWidth = object ARRAY()

  -- test answers with required value having converted both to mm
  do !val values !allAnswers
    !answer     = !val.tAnswer.real().dbUnits().value()
    handle any
      skip
    endhandle
    -- alternate answer for rough 'nominal' conversion for a metric user using an imperial catalogue
    !answerAlt  = !val.tAnswer.real().convertUnits('inch').value() * 25
    handle any
      skip
    endhandle

    -- tolerance of 1mm on the answer - the value is already converted to DB units
    -- so the test is < 1. It should not be < 1mm
    if (( abs(!answer - !searchValueExact) lt 1 ) or ( abs(!answer - !searchValueMapped) lt 1 )) then
      !selectionWithWidth.append(!val.owner)
    elseif ( abs(!answerAlt - !searchValueExact) lt 1 )  then
      !selectionWithWidth.append(!val.owner)
    endif

  enddo

 return !selectionWithWidth

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: findAnswers
--
-- Description: Search TABQUE for answers
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF or ARRAY of DBREF   Scope of search
--  2   R      EXPRESSION  Search criteria
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of TABQUE matching criteria
--
------------------------------------------------------------------------
define method .findAnswers(!scope is ANY, !expression is EXPRESSION) is ARRAY

  !table   = object COLLECTION()
  !table.scope(!scope)
  !table.type('TABQUE')
  !table.filter(!expression)
  !answers = !table.results()

  return !answers

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: findAnswersOwner
--
-- Description: Search TABQUE for answers and evaluate the owner
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF or ARRAY of DBREF   Scope of search
--  2   R      EXPRESSION  Search criteria
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of TABQUE matching criteria
--
------------------------------------------------------------------------
define method .findAnswersOwner(!scope is ANY, !expression is EXPRESSION) is ARRAY

  !answers = !this.findAnswers(!scope, !expression)

  !owner = object BLOCK('!answers[!evalIndex].owner')
  !ansOwner = !answers.evaluate(!owner)

  return !ansOwner

endmethod
--End of method definition
------------------------------------------------------------------------
--
-- Method: orientComponent
--
-- Description: Orient the CTRAY component to match the CTMTRL
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF      The CTRAY element to orient
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .orientComponent(!ctray is DBREF)

  !ctmtrl = !ctray.owner

  -- Set axis of rotation for component
  !pos  = !ctray.position
  !rDir = U wrt $!ctray

  -- Get CTMTRL p-point directions
  !pDir1 = !ctmtrl.pDir[1]
  !pDir2 = !ctmtrl.pDir[2]

  -- Orient p1 of the component to p1 of CTMTRL
  ori p1 is $!pDir1
  -- Check this is correct. Bends can be multi-handed
  -- In this situation p1 should be oriented to p2 if CTMTRL
  if ( !ctray.pDir[2].angle(!ctmtrl.pDir[2]).nint().gt(0.1)  ) then
    ori p1 is $!pDir2 and p2 is $!pDir1
  endif

  -- For CTEE's we check P3 to P3 CTRAY to CTMTRL and rotate if required
  if ( !ctmtrl.type.eq(|CTTEE|) )then
    if ( !ctray.pDir[3].angle(!ctmtrl.pDir[3]).nint().gt(0.1) ) then
      ROTATE through $!pos about $!rDir by 180
    endif
  endif

  -- check the bend and riser angles match the CTMTRL
  if ( !ctmtrl.type.eq('CTBEND') or !ctmtrl.type.eq('CTRISE') ) then
    !this.checkAngle()
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method: orientRiserStraight
--
-- Description: Orient the CTSTRA created for risers when using tiers
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF      The CTRAY element to orient
--  2   R      REAL       P-point number to connect to
--  3   R      REAL       Tray number to connect to
--  4   R      STRING     Required direction attribute from point-r
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .orientRiserStraight(!ctray is DBREF, !point is REAL, !seq is REAL, !dir is STRING)

  !!ce = !ctray
  -- Connect P1 of CTRAY to required point on the adjacent TRAY
  conn P1 to P$!point of CTRAY$!seq of owner

  -- Set parameters for rotation if required
  !pos  = !ctray.position
  !rDir = !ctray.pDir[1]

  -- Set the required open direction of the tray needed
  if ( !dir.eq(|aydir|) )then
    !wantedOpenDir  = !ctray.owner.posref.aydir
  elseif ( !dir.eq(|lydir|) )then
    !wantedOpenDir  = !ctray.owner.posref.lydir
  endif

    -- Find the open direction of the tray
  !p0Dir = !!ce.spref.catref.pDir[0]
  !p1Dir = !!ce.spref.catref.pDir[1]
  !p2Dir = !!ce.spref.catref.pDir[2]

  if(!p0Dir.eq(U)) then
    !currentOpenDir = p0 dir wrt world
  elseif(!p1Dir.eq(U)) then
    !currentOpenDir = p1 dir wrt world
  elseif(!p2Dir.eq(U)) then
    !currentOpenDir = p2 dir wrt world
  else
    return
  endif

  -- Calc angle between current and required tray open directions
  !angle = !currentOpenDir.angle(!wantedOpenDir).nint()
  !!ce = !ctray
  -- Rotate the tray if required
  if ( !angle.gt(0.1) )then
    -- Rotate thro $!pos about $!rDir by $!angle
    !currentOpenDir = !ctray.pDir[0]
    -- Check we rotated the right way and correct if needed
    !angle = !currentOpenDir.angle(!wantedOpenDir).nint()
    if ( !angle.gt(0.1) )then
     -- Rotate thro $!pos about $!rDir by $!angle
    endif
  endif

endmethod
-- End of method definition
