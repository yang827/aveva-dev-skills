-- Last Modified:
-- Description: Cable free route object
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cblFreeRoute(DBREF)              -                   constructor
--  clearAids()                      -                   Creation of aid text and lines
--  createPoints()                   -                   creates route points
--  initPacket()                     -                   initialize array member
--  markPoints(EDGPOSITIONDATA)      -                   marks route points
--  pick(STRING,STRING)              -                   EDG to pick route point
--

define object CBLFREEROUTE

  --array of positions
  member .positions is ARRAY

  --array of fradius values
  member .radius is ARRAY

  --cable
  member .cable is DBREF

  --aid number
  member .aidNumber  is REAL

endobject

---------------------------------------------------------------------------
--
-- Method:      cblFreeRoute
--
-- Description: constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cblFreeRoute(!cable is DBREF)

  !this.cable     = !cable

  --Register Aid numbers
  !this.aidNumber     = !!aidNumbers.add('Points')

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      initPacket
--
-- Description: initialise array member
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initPacket()

  !this.positions    = object ARRAY()
  !this.radius       = object ARRAY()

  if !this.cable.staref.set() then
    !this.positions[1] = !this.cable.staref.pos.wrt(worl)
    !this.radius[1]    = 0
  endif

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: EDG to pick route point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1    R     STRING      Instance of the object, i.e. !!cblCable.freeRoute
--  2    R     STRING      EDG description
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick(!instance is STRING, !edgDescription is STRING)

  !!edgCntrl.remove(!!cblCable.edgDescription)
  !packet                = object EDGPACKET()
  !packet.initialisation = !instance & '.initPacket()'
  !packet.action         = !instance & '.markPoints(!this.return[1])'

  !packet.description    = !edgDescription
  !packet.pickPacket.stdPosition('Pick to define position <Esc> to finish')
  !packet.remove         = false
  !packet.escape         = !instance & '.createPoints()'
  !!edgCntrl.add(!packet)

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      markPoints
--
-- Description: marks route points
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .markPoints(!pick is EDGPOSITIONDATA)

  !pickPos = !pick.position.wrt(worl)
  !this.positions.append(!pickPos)
  if !pick.item.badref() then
    !this.radius.append(0.0)
  elseif (!pick.item.type.eq(|POINTR|)) then
    !this.radius.append(!pick.item.fradius)
  else
    !this.radius.append(0.0)
  endif
  !number = !this.positions.size()
  !aidNumber = !this.aidNumber
  aid text number $!aidNumber 'Point $!number' at $!pickPos

endmethod
--End of method definition

---------------------------------------------------------------------------
--
-- Method:      createPoints
--
-- Description: creates route points
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPoints()

  if !this.cable.endref.set() then
    !this.positions.append(!this.cable.endref.pos.wrt(worl))
    !this.radius.append(0)
  endif

  !ce = !!ce
  !!ce = !this.cable

  --navigate to RPATH or create new if none
  RPATH 1
  handle ANY
  	new RPATH
  endhandle

  -- Check if already routed. If so, warn and don't create points.
  if !!ce.members.set() then
  	!!alert.error('Cable already has route points')
  else
    !confirm = !!alert.confirm('Create Free Route?')
    if !confirm.eq('YES') then
      do !i indices !this.positions
        new POINTR
        !!ce.position = !this.positions[!i]
        !!ce.fradius = !this.radius[!i]
      enddo
      !!ce = !this.cable
      -- set CBSTATUS to 5 (Manually Routed)
      CBSTA 5
      -- RLSELECT needs to be set to show cable as complete
      RLSEL CE
      if(!!cblCable.shown())then
        !!cblCable.setTask(|MODIFY|,|POINTR|)	
      endif
    endif
  endif

  !this.clearAids()
  !!ce = !ce

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: clearAids
--
-- Description: Creation of aid text and lines
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAids()

  aid clear text $!this.aidNumber
  handle ANY
  endhandle

endmethod
--End of method definition
