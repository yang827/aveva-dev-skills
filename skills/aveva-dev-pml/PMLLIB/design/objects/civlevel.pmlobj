--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Sep 29 08:33:29 BST 1998
--
--
-- Description:
-- Contains data about a civil "level".
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  badRef()                         BOOLEAN             Checks if level is a bad reference
--  buildStoreList()                 ARRAY               Build the storage display list
--  civLevel(DBREF)                  -                   Constructor
--  elevation(DBREF)                 REAL                Return Elevation of level
--  elevation(REAL)                  BOOLEAN             Set Elevation of level
--  elevation(REAL,DBREF)            BOOLEAN             Set Elevation of level
--  level()                          DBREF               Return level
--  level(DBREF)                     -                   Define level
--  offset()                         REAL                Return current offset
--  offset(REAL)                     BOOLEAN             Set offset
--  offsets()                        ARRAY               Return all offsets
--  plane()                          PLANE               Return reference plane of level
--  plane(DBREF)                     PLANE               Return reference plane of level wrt to passed item
--  setStorageAreas()                -                   Set currently defined storage areas
--  setStore(REAL,BOOLEAN,DBREF)     -                   Return all storage areas
--  storeDisplay(GADGET)             -
--  storeGroup(STRING)               -                   Set store group and its areas and titles definitions
--
------------------------------------------------------------------------

define object CIVLEVEL

  -- Level (Structure)
  member .level        is DBREF

  -- Plane of level
  member .plane        is PLANE

  -- Storage areas elements (array of DBREFs)
  member .stores       is ARRAY

  -- Store group
  member .storeGroup   is STRING

  -- Permissible store areas for the store group
  member .storeAreas   is ARRAY

  -- Title of each store area for the group
  member .storeTitles  is ARRAY

  -- Storage display
  member .storeDisplay is ARRAY

  -- Current Offset value
  member .offset       is REAL

  -- Previous offsets
  member .offsets      is ARRAY

endobject
-- End of object definition for CIVLEVEL

------------------------------------------------------------------------
--
-- Method:      civLevel
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Structure used as level
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .civLevel(!level is DBREF)

  -- Level
  !this.level       = !level

  -- Plane of level (including current offset)
  !this.plane       = object PLANE(!this.level.position.wrt(World), !this.level.orientation.wrt(World))

  -- Current Offset value
  !this.offset      = 0

endmethod
-- End of method definition for .civLevel(DBREF)

------------------------------------------------------------------------
--
-- Method:      level
--
-- Description: Return level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Structure used as level
--
------------------------------------------------------------------------

define method .level() is DBREF
  return !this.level
endmethod
-- End of method definition for .level() DBREF

------------------------------------------------------------------------
--
-- Method:      storeGroup
--
-- Description: Set store group and its areas and titles definitions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store group
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storeGroup(!group is STRING)

  -- Get all areas for the group
  !storeAreas = !!storageGroupData(!group)
  handle any
    return
  endhandle

  -- Assign group to object
  !this.storeGroup = !group

  -- Get areas keys and titles for group
  do !i indices !storeAreas.areas
    !this.storeAreas[!i]  = !storeAreas.areas[!i].name
    !this.storeTitles[!i] = !storeAreas.areas[!i].title
    !this.stores[!i]      = object DBREF()
  enddo

  -- Build display list
  !this.buildStoreList()

endmethod
-- End of method definition for .storeGroup(STRING)

------------------------------------------------------------------------
--
-- Method:      level
--
-- Description: Define level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Structure used as level
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .level(!level is DBREF)
  !this.civLevel(!level)
endmethod
-- End of method definition for .level(DBREF)

------------------------------------------------------------------------
--
-- Method:      badRef
--
-- Description: Checks if level is a bad reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Structure used as level
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .badRef() is BOOLEAN

  -- Initialise Variables
  if(!this.level.badRef()) then
    !this.level = object DBREF()
    !this.stores.clear()
    !this.storeTypes.clear()
    return true
  else
    return false
  endif

endmethod
-- End of method definition for .badRef() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Return Elevation of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--    REAL        Elevation
--
------------------------------------------------------------------------

define method .elevation(!wrt is DBREF) is REAL
  return !this.level.position.wrt(!wrt).up
endmethod
-- End of method definition for .elevation(DBREF) REAL

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set Elevation of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Elevation
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if elevation has changed
--
------------------------------------------------------------------------

define method .elevation(!elevation is REAL) is BOOLEAN

  -- Initialise Variables
  return !this.elevation(!elevation, !this.level.owner)

endmethod
-- End of method definition for .elevation(REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set Elevation of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Elevation
--    2   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if elevation has changed
--
------------------------------------------------------------------------

define method .elevation(!elevation is REAL, !wrt is DBREF) is BOOLEAN

  -- Initialise Variables
  !reference   = !!ce
  !position    = !this.level.position.wrt(!wrt)

  -- If there is no difference between the new elevation and old, return
  if(!position.up - !elevation eq 0) then
    return false
  endif

  -- Check we have access to update the element
  if(!!dbRefUpdate(!this.level).not()) then
    !!alert.warning(!!error.text)
    return false
  endif

  -- Modify elevation of "level" element
  !!ce         = !this.level

  -- Define new position
  !position.up = !elevation
  AT $!<position>

  -- Redefine the object
  !this.level(!this.level)

  -- Return to original item
  !!ce         = !reference

  -- Return
  return true

endmethod
-- End of method definition for .elevation(REAL, DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return reference plane of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane
--
------------------------------------------------------------------------

define method .plane() is PLANE
  return !this.plane
endmethod
-- End of method definition for .plane() PLANE

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Return reference plane of level wrt to passed item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Frame of reference
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane
--
------------------------------------------------------------------------

define method .plane(!wrt is DBREF) is PLANE
  return object PLANE(!this.plane.position.wrt(!wrt), !this.plane.orientation.wrt(!wrt))
endmethod
-- End of method definition for .plane(DBREF) PLANE

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset from plane
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if offset has been changed
--
------------------------------------------------------------------------

define method .offset(!offset is REAL) is BOOLEAN

  -- Initialise Variables

  -- Put current offset into offset list
  !this.offsets.append(!this.offset)

  -- Remove passed offset from the list
  !index = !this.offsets.findFirst(!offset)
  if(!index.set()) then
    !this.offsets.remove(!index)
  endif

  -- Remove duplications
  !this.offsets.unique()

  -- Sort into order
  !this.offsets.sort()

  -- Set new offset
  !this.offset = !offset

  -- Offset plane (using original elevation)
  !position            = !this.level.position.wrt(World)
  !position.up         = !position.up + !offset
  !this.plane.position = !position

  return true

endmethod
-- End of method definition for .offset(REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Return current offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Current Offset values
--
------------------------------------------------------------------------

define method .offset() is REAL
  return !this.offset
endmethod
-- End of method definition for .offset() REAL

------------------------------------------------------------------------
--
-- Method:      offsets
--
-- Description: Return all offsets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Current list of offsets
--
------------------------------------------------------------------------

define method .offsets() is ARRAY
  return !this.offsets
endmethod
-- End of method definition for .offsets() ARRAY

------------------------------------------------------------------------
--
-- Method:      setStorageAreas
--
-- Description: Set currently defined storage areas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStorageAreas()

  -- Initialise Variables
  !reference = !!ce

  -- Loop through the current storage areas
  do !i indices !this.storeAreas

    if (!this.stores[!i].badRef()) then

      -- Unset the store because it was a bad reference
      !this.stores[!i] = object DBREF()

      -- Rebuild the store list because we had a bad reference
      !this.buildStoreList()

    endif

    -- Replace with new storage area
    if(!this.stores[!i].set()) then
      !type = 'NOCHECK'
      !!ce  = !this.stores[!i]
      call !!storageAreasSet(!this.storeGroup,!this.storeAreas[!i], !type)
      !!ce  = !reference

    -- Unset current storage area
    else
      !type = 'UNSET'
      call !!storageAreasSet(!this.storeGroup,!this.storeAreas[!i], !type)

    endif

  enddo

endmethod
-- End of method definition for .setStorageAreas()

------------------------------------------------------------------------
--
-- Method:      setStore
--
-- Description: Return all storage areas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Storage areas index
--    2   R      BOOLEAN     true = set name, false = unset
--    2   R      DBREF       Element to use as store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStore(!index is REAL, !set is BOOLEAN, !dummyStore is DBREF)

  -- Initialise Variable
  !reference = !!ce

  -- Set store
  if(!set) then
    !type = 'NOCHECK'
  else
    !type = 'UNSET'
  endif

  -- Set store
  !newStore = !!storageAreasSet(!this.storeGroup, !this.storeAreas[!index], !type)
  handle any
  elsehandle none

    -- Set current store
    !this.stores[!index] = !newStore
    !this.buildStoreList()

  endhandle

  -- Return
  !!ce       = !reference

endmethod
-- End of method definition for .setStore(REAL, BOOLEAN, DBREF)

------------------------------------------------------------------------
--
-- Method:      storageAreas
--
-- Description: Return all storage areas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storeDisplay(!gadget is GADGET)

  -- Initialise Variable
  !block = object BLOCK('!evalIndex.string()')
  !rText = !this.storeDisplay.evaluate(!block)

  -- Update gadget
  !gadget.dText = !this.storeDisplay
  !gadget.rText = !rText

endmethod
-- End of method definition for .storeDisplay(GADGET)

------------------------------------------------------------------------
--
-- Method:      buildStoreList
--
-- Description: Build the storage display list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Current list of offsets
--
------------------------------------------------------------------------

define method .buildStoreList() is ARRAY

  -- Initialise Variables
  !this.storeDisplay.clear()
  !padding = '                        '

  -- Maximum title width (negate so we work from the right-hand-side)
  !titleWidth = !this.storeTitles.width() * -1

  -- Loop through the list
  do !i indices !this.storeAreas

    -- Named storage areas
    !string = !padding & !this.storeTitles[!i]
    !string = !string.subString(-1, !titleWidth)

    -- Set the display string
    if(!this.stores[!i].badRef().not()) then
      !string = !string & '    ' & !this.stores[!i].flnn
    else
      !string = !string & '    unset'
    endif
    !this.storeDisplay[!i] = !string
  enddo

endmethod
-- End of method definition for .buildStoreList() ARRAY
