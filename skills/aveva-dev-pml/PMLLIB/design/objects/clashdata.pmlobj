--
-- Description:
-- object to store clash data from DESCLASH
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  crtConnection(DBREF)             -
--
------------------------------------------------------------------------

-- Define object
define object CLASHDATA
  -- Clash Items
  member .items    is ARRAY
  -- Clash Obstructions
  member .obsts    is ARRAY
  -- Clash Positions
  member .poses    is ARRAY
endobject
-- End of object definition for CLASHDATA

------------------------------------------------------------------------
--
-- Method:      <createConnection>
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Spref of tmpl for fitting]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .crtConnection(!fitting is DBREF)

-- initialise
   !template = !fitting.tmpr
   !warningMessage = STRING()
   !fittings = ARRAY()

-- PDMS commands to create the fitting on the clashed obstruction list

   do !allFitts indices !this.items
      !!ce = !this.obsts[!allFitts]

      NEW FITT
--  skip if not a SCTN
      handle any
       skip
      endhandle
      !fittings[!allFitts] = !!ce
      SPRE $!fitting



      ZDIST THRO $!this.items[$!allFitts]
      NEW TMPL COPY  $!template

   -- find which pline to use
   -- *** OLD STYLE SYNTAX ***
      var !pLines PROP PLIN OF FITT
       handle any
    -- if prop not set cannot do the POSL
         !warningMessage = 'Fitting does not have the dataset PLIN for positioning'
       elsehandle none
         !availPlines = !pLines.split()
         !usePline = 'NA'
    -- go through each to find which is best
         do !plin indices !availPlines
           var !tmpDir PPLIN $!availPlines[$!plin] OF SCTN DIR WRT WORLD
           !pLineDir = !tmpDir.direction()
            if(!pLineDir eq !!aslHandrail.railSide) then
               !usePline = !availPlines[!plin]
               break
            endif

         enddo
    -- set POSL
        FITT
        RULE REXE
        POSL $!usePline

        if(!!ce.orientation.xDir().wrt(sctn).string().part(1) inset('S','-Y')) then
          BANG 180
        endif


       endhandle

   enddo

-- link posts to fittings

   !!aslLinkRailExec(!this.items,!fittings)

-- rexe rules of handrails after fittings have been positioned.

   -- get owners uniquely (instead of block EVALUATE (too slow))
   !owners = ARRAY()
   do !posts indices !this.items
      !owners[!posts] = !this.items[!posts].owner.owner
   enddo
   !owners.unique()



-- go to each rail and rexe rules
   do !rails values !owners
    !!ce = !rails

     !!evaluateRules(!rails)

   enddo



endmethod
-- End of method definition for .crtConnection(DBREF)
