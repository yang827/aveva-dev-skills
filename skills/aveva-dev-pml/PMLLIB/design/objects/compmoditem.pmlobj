--
--
-- Description:
-- compmoditem object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  bendRadius(STRING)               -
--  compmoditem(DBREF)               -
--  compmoditem(DBREF,STRING)        -
--  getBendRadius()                  -                   gets the component bend radius from the supplied spcom
--  getBores()                       -
--  getDesc()                        -
--  getILTube()                      -
--  getNewBores()                    -
--  getPBore(REAL,DBREF)             BORE                gets the ppoint bores from a spref
--  getRadius()                      -
--  getTube()                        -
--  machineTest(DBREF)               REAL
--  makeLine()                       ARRAY
--  setChoices()                     -                   sets the new bores from the alternative component
--  setChoicesAlt(STRING)            -                   sets the new bores from the alternative component for components in LIMBOSPEC or with no spec
--  testBendRadius(DBREF,ARRAY,ARRAY) REAL
--

-- Define Object
define object COMPMODITEM

  -- component data - REF,TYPE,PDMS NAME
  member .component           is DBREF
  member .realcomponent       is DBREF
  member .componentType       is STRING
  member .designElement       is STRING

  -- component's bore data
  member .abore               is BORE
  member .lbore               is BORE
  member .pbor3               is BORE

  -- component's spec data
  member .spref               is DBREF
  member .description         is STRING
  member .material            is STRING
  member .stype               is STRING

  -- leave tube data: specRef and length
  member .leavetube           is DBREF
  member .tubeBeginComp       is DBREF
  member .tubeLength          is REAL
  member .tubeOD               is REAL

  member .bendRadius          is REAL
  member .errorlines          is ARRAY
  member .errorflag           is BOOLEAN

  -- store the selector choices
  member .questions           is ARRAY
  member .answers             is ARRAY

  -- New spec component available in the selected spec
  member .newSpref            is STRING

  -- description of new spec component
  member .newDescription      is STRING

  -- bore of new component
  member .newAbore            is BORE
  member .newLbore            is BORE
  member .newPbor3            is BORE

  member .ispec               is DBREF
  member .tspec               is DBREF

endobject
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- constructor method
-- Given a dbref work out what to do with it
define method .compmoditem(!comp is DBREF)

     !this.component      = !comp
     !this.componentType  = !comp.type
     !this.designElement  = !comp.flnn
     !this.spref          = !comp.spref
     !this.newSpref       =  ''

     if !this.componentType eq 'TUBI' then

        -- set component type as TUBE (as in Spec) instead of TUBI
        !this.componentType  = 'TUBE'

        -- store the mtbe (Material tube beginning component) of tube
        --!this.tubeBeginComp  = !comp.mtbe
        !tubeRefString         = !comp.string()
        !tubeBeginCompStr      = !tubeRefString.after('IL TUB OF').trim()
        !tubeBeginningComponent = !tubeBeginCompStr.dbref()
        !this.realcomponent     = !tubeBeginningComponent

        -- set the tube length
        !this.tubeLength     = !comp.itle.int()
        !this.ispec          = !this.realcomponent.ispec
        !this.tspec          = !this.realcomponent.tspec
     else
        !this.realcomponent  = !comp
        if !comp.type.eq('BRAN') then
          !this.leavetube      = !comp.hstu
          !this.tubeLength     = !comp.ltle.int()
          !this.tubeOD         = !comp.phod
        else
          !this.leavetube      = !comp.lstu
          !this.tubeOD         = !comp.lod
          handle any
            !this.tubeOD = object REAL()
          endhandle
          !this.tubeLength     = !comp.ltle.int()
          handle any
            !this.tubeLength = 0
          endhandle
        endif
        !this.ispec          = !comp.ispec
        !this.tspec          = !comp.tspec
     endif

-- go and get

        -- get the description and material
        !this.getDesc()

        -- get the current bores
        !this.getBores()

      if !comp.spref.set() then
        -- get the current selector questions and answers
--CW - P-25646 --setting spec for multiple 'LIMOSPECS'....i.e LIMBOSPEC_12
        if !this.spref.owner.quest.eq('LIMB') then
          !this.setChoicesAlt('LIMBO')
          handle ANY
            !!alert.warning('Failed to load component in LIMBOSPEC ' & !comp.flnn & '. Some functionality may not work for this component.')
          endhandle
        else
          !this.setChoices()
        endif
      else
        !this.setChoicesAlt('NOSPEC')
      endif

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- constructor method
-- This is a special case where the component leave tube is zero length
define method .compmoditem(!comp is DBREF, !type is STRING)

     !this.realcomponent     = !comp
     if !comp.type.eq('BRAN') then
       if !comp.hstu.unset().or(!comp.hstu.badref()) then
        !this.component         = object DBREF()
        !this.spref             = object DBREF()
       else
        !this.component         = !comp.hstu
        !this.spref             = !comp.hstu
       endif
       !this.designElement     = 'head tube of ' & !comp.flnn
     else
        !this.component          = !comp.lstu
         !this.spref             = !comp.lstu
         !this.designElement     = 'ileave tube of ' & !comp.flnn
     endif
     !this.componentType     = !type


     !this.newSpref          =  ''
     !tubeRefString          = !comp.string()

     -- set the tube length
     !this.tubeLength     = 0
     !this.ispec          = !comp.ispec
     !this.tspec          = !comp.tspec

     -- get the description and material
     !this.getDesc()

     -- get the current bores
     !this.getBores()

     -- get the current selector questions and answers
     if !this.spref.set() then
       if !this.spref.owner.name.eq('/*LIMBOSPEC') then
         !this.setChoicesAlt('LIMBO')
       else
         !this.setChoices()
       endif
     elseif !comp.type.eq('BRAN') then
        !this.setChoicesAlt('NOSPEC')
     else
       if !comp.spref.set() then
         --Used so that branches with components with Null ref for lstu can be loaded
         !spec = '/' + !comp.spref.name.after('/').before('/')
         var !sp coll all with Tanswer eq 'TUBE' for $!spec
         !a = !sp[1].dbref()
         var !sp2 coll all with Answer eq $!comp.abore for $!a
         !b = !sp2[1].dbref()
         var !sp3 coll all SPCO for $!b
         !this.spref = !sp3[1].dbref()
         !this.component = !sp3[1].dbref()
         !this.setChoices()
       else
         --We have to do something else, but what is another matter.
         !this.setChoicesAlt('NOSPEC')
       endif
     endif

endmethod
--------------------------------------------------------------------------------------

$(
--------------------------------------------------------------------------------------
-- method to convert the current item into tube
define method .getTube()

   !this.componentType = 'TUBE'
   !this.designElement = flnn of next tubi of $!this.component
   !this.spref         = !this.component.lstu

   -- get the description and material
   !this.getDesc()
   -- get the current bores
   !this.getBores()

endmethod
