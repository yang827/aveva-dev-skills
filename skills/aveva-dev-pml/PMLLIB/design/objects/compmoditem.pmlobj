--------------------------------------------------------------------------------------
--
-- Method:      getILTube
-- Description: gets the leave tube length and sets the tube length
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getILTube()

      !this.ltubelength = !this.component.ltlength.int()

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
--
-- Method:      getBores
--
-- Description: gets the component bores
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBores()

    if !this.realcomponent.type.eq('BRAN') then
         !this.abore = !this.realcomponent.hbore
         !this.lbore =  !this.realcomponent.hbore

    if(!this.realcomponent.ppls.findfirst(3).set() ) then
       !this.pbor3 = !this.realcomponent.ppbore[3]
       handle (2,201)(2,759)
       endhandle
    endif

  else
    if (!this.realcomponent.spref.set()) then
        !this.abore =  !this.realcomponent.abore
        !this.lbore =  !this.realcomponent.lbore
        handle (2,201)(2,759)
        endhandle
				
        if(!this.realcomponent.ppls.findfirst(3).set() ) then
           !this.pbor3 = !this.realcomponent.ppbore[3]
           handle (2,201)(2,759)
           endhandle
        endif
    else
      --P-13341 gets the arrive and leave bore for components with no spec set
      !currentElement = !!ce
      !!ce = !this.realcomponent
      do
        prev
        handle any
          --Its hit the start of the branch.
          !this.abore =  !!ce.owner.hbore
          handle any
            -- If the branch has no hbore attribute then we cant do anything
            !!alert.error('Failed to load form some specs not set')
            return
          endhandle
          break
        endhandle

        if !!ce.spref.set() then
          !this.abore =  !!ce.lbore
          break
        endif
      enddo

      !!ce = !this.realcomponent

      do
        next
        handle any
          !this.lbore = !this.abore
          break
        endhandle

        if !!ce.spref.set() then
          !this.lbore = !!ce.abore
          break
        endif
      enddo

      !!ce = !currentElement
      --ENdFix P-13341
    endif
        endif

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
--
-- Method:      getBendRadius
--
-- Description: gets the component bend radius from the supplied spcom
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBendRadius( )

    -- there are two mechanisms for getting a bend radius from a spcom
    !table = object COMPONENTTABLE(!this.newSpref.dbref())

    !radius = !this.testBendRadius(!this.newSpref.dbref(),!table.questions(),!table.answers(!this.newSpref.dbref()))

    !this.bendRadius(!radius.string())

    -- the radius selector
    -- the zone bending machine at zone level

endmethod
--------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      testBendRadius
--
-- Description: Called to test if a radius can be machine defined or spec defined
--
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .testBendRadius(!component is DBREF,!questions is ARRAY, !answers is ARRAY )is REAL

 !radius = REAL()
 do !a index !questions
      if !questions[!a].match('RAD').eq(1) then
         -- the radius is set in the spec
         !radius = !answers[!a].real()
         return !radius
      endif
enddo

-- if it gets here it couldn't find the right radius in the spec so now we need to test the dbfrad
if !component.catref.compType.eq('VAR') then
  !radius = !this.machineTest(!this.component)
  if !radius.gt(-1) then
    return !radius
  else
    !radius = 0
  endif
endif
return !radius

endmethod
------------------------------------------------------------------------


--------------------------------------------------------------------------------------
--
-- Method:      getRadius
--
-- Description: gets the component bend radius based on arrive and leave points
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRadius()

     !adir = !this.component.adir
     !ldir = !this.component.ldir
     !angle = !adir.angle(!ldir) / 2
     !adj = !this.component.apos.distance(!this.component.pos)
     if !adj.eq(0) then
        !this.bendRadius = 0
     else
        !this.bendRadius = tan( !angle ) * !adj
     endif

endmethod
--------------------------------------------------------------------------------------

define method .makeLine() is ARRAY

   !line = !this.designElement & '   ' & !this.componentType & ' ' & !this.spref.name & '    ' & !this.description & ' ' & !this.material $
            & '   ' & !this.abore & ' ' & !this.lbore & '  ' & !this.pbor3

    return !line

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
 define method .makeheader()is ARRAY

    !line = 'Type' & '  ' & 'Component' & ' ' & 'Description/material' $
            & ' ' & 'Arrive Bore' & '   ' & 'Leave bore' & '    ' & 'P3 Bore'

    return !line

 endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
--
-- Method:      setChoices
--
-- Description: gets the selector questions and answers
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setChoices()

    !questions = ARRAY()
    !answers   = ARRAY()

    !specRef = !this.spref
    var !choices CHOICE with $!<specRef> number
    !number = !choices.real()

    -- modified routine for selecting component choices to get round the problem of spaces in stypes.
    do !a to !number from 2
      var !question CHOICE with $!<specRef> QUESTION $!a
      !question = !question.replace('PBOR 0','PBOR0').replace('PBOR 1','PBOR1').replace('PBOR 2','PBOR2').replace('PBOR 3','PBOR3').replace('PBOR 4','PBOR4')
      !questions.append(!question)
      var !answer  CHOICE with $!<specRef> ANSWER $!a
      if !question.matchwild('PBOR*') then
          !boreAnswer = object BORE(!answer)
          handle ANY
            !answers.append(!this.abore)
          elsehandle NONE
            --P-13280: Allows the actual bore of each lstu to be gained instead of the value specified by the component.
            if !this.componentType.eq('TUBE') and !boreAnswer.set() then
      				!this.abore = !boreAnswer
      				!this.lbore = !boreAnswer
      			endif
            !answers.append(!boreAnswer)
          endhandle
      else
        var !answer CHOICE with $!<specRef> ANSWER $!a
        !answers.append(!answer)
     endif
    enddo

    !this.questions = !questions
    !this.answers   = !answers

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setChoicesAlt
--
-- Description: gets the selector questions and answers for components
--          with no spref set and components with a spref in LIMBOSPEC.
--          Manually builds q and a using available data.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setChoicesAlt(!opFlag is STRING)

    !questions = ARRAY()
    !answers   = ARRAY()

    if !opFlag.eq('LIMBO') then
      -- Get spec from the name of the specRef for the component
      !specRef = !this.spref
      !specName = !this.spref.name.split('/')
      if !specName[1].eq('') then
        !specName.removeFirst()
      endif
      !specNameStr = '/' + !specName[1]
      !spec = !specNameStr.dbref()
    elseif !opFlag.eq('NOSPEC') then
      !spec = !this.realcomponent.owner.pspec
      handle any
        !spec = !this.realcomponent.owner.owner.pspec
        handle any
          return
        endhandle
      endhandle
      !specNameStr = !spec.name
    endif

    -- Get all sele of spec
    !tanswer = !this.component.type
    handle any
      !tanswer = !this.componentType
    endhandle
    var !a coll all SELE with TANS eq !tanswer for $!spec

    -- Search through sele and collect all SPCO and check they are all of same dDepth
    do !b to !a.size()
      !spec = !a[!b].dbref()
      var !spcoArray coll all SPCO for $!spec
    enddo
    !spec = !spcoArray[1].dbref()

    -- Assumption made that first spco found has same dDepth of others if this is not true process may fail.
    !dDepth = !spcoArray[1].dbref().dDepth - !specNameStr.dbref().dDepth

    do !x to !dDepth from 2
      var !question CHOICE with $!<spec> QUESTION $!x
      !question = !question.replace('PBOR 0','PBOR0').replace('PBOR 1','PBOR1').replace('PBOR 2','PBOR2').replace('PBOR 3','PBOR3').replace('PBOR 4','PBOR4')
      !questions.append(!question)
      if !question.matchwild('PBOR*') then
        if (!question eq 'PBOR0') then
          !answer = !this.abore.string()
        elseif (!question eq 'PBOR1') then
          !answer = !this.abore.string()
        elseif (!question eq 'PBOR2') then
          !answer = !this.lbore.string()
        elseif (!question eq 'PBOR3') then
          !answer = !this.pbor3.string()
        elseif (!question eq 'PBOR4') then
          !answer = !this.pbor3.string()
        endif
        !boreAnswer = object BORE(!answer)
        handle ANY
          !answers.append(!this.abore)
        elsehandle NONE
          !answers.append(!boreAnswer)
        endhandle
      elseif (!question eq 'STYP') then
        !answer = !this.stype
         !answers.append(!answer)
      elseif (!question eq 'SHOP') then
        !answer = 'TRUE'
        !answers.append(!answer)
      else
        !answers.append('unset')
      endif
    enddo

    !this.questions = !questions
    !this.answers   = !answers

endmethod
------------------------------------------------------------------------
--
-- Method:  getNewBores
--
-- Description: sets the new bores from the alternative component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getNewBores()

  -- Check if there is a new Spec Ref before getting new bores
  if (!this.newSpref neq '') then

     !spref = !this.newSpref.dbref()
     handle any
       return
     endhandle

     !arrive = !this.component.arrive
     handle any
       !arrive = 1
     endhandle
     !leave  = !this.component.leave
     handle any
       !leave = 2
     endhandle

   -- check if the current element has a pbor3
     !unusedCheck = !this.component.ppbore[3]
     handle any
       -- no pbor3
     elsehandle NONE
        !spare         = (6 - (!arrive + !leave))
        !this.newPbor3 = !this.getPBore(!spare,!spref)
     endhandle

     !this.newAbore = !this.getPBore(!arrive,!spref)
     !this.newLbore = !this.getPBore(!leave,!spref)

  -- No Spec Ref so reset bores
  else
     !unsetBore = object BORE()
     !this.newAbore = !unsetBore
     !this.newLbore = !unsetBore
     !this.newPbor3 = !unsetBore
  endif

endmethod
--------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:  getPBore
--
-- Description: gets the ppoint bores from a spref
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--------------------------------------------------------------------------------------
define method .getPBore(!number is REAL, !spref is DBREF)is BORE

  !bore = !spref.ppbore[!number]
  handle ANY
    return object bore()
 endhandle
 return !bore

endmethod
--------------------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:     MachineTest
--
-- Description: Called to test if a radius can be machine defined
--
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .machineTest(!component is DBREF ) is REAL
  !bendMacList = object ARRAY()
  --Appending the bendmacref of branch,pipe,zone of the component in the array
  !bendMacList.append(!this.component.owner.bendmacref)
  !bendMacList.append(!this.component.owner.owner.bendmacref)
  !bendMacList.append(!this.component.owner.owner.owner.bendmacref)

  --if the bendmacref is set for any of the branch,pipe or zone then storing it.
  do !bendMacRef values !bendMacList
    if(!bendMacRef.set()) then
      !macList = !bendMacRef
      break
    endif
  enddo

  if !macList.unset().or(!macList.badref()) then
    return -1
  else
    var !machines collect all FMBDIM for $!macList
    do !a values !machines
       -- fix to add a tolerance to the outside diameters
      !radiusDiff = abs(!a.dbref().od - !this.tubeOD)
      handle ANY
         -- if any of the values are unset then its not a match
         return -1
      endhandle
      !radiusTest = !radiusDiff.lt(1mm)
      if !radiusTest then
        if !a.dbref().wThickness.neq(0) then
          -- test the wall thickness
          !wallDiff = abs(!a.dbref().wThickness - !component.pwallth[1] )
          if !wallDiff.lt(0.1mm) then
             return !a.dbref().bradius * !this.tubeOD
          endif
        else
        return !a.dbref().bradius * !this.tubeOD
        endif
      endif
    enddo
  endif

  return -1

endmethod
------------------------------------------------------------------------
