$)

--------------------------------------------------------------------------------------
--
-- Method:      getDesc
--
-- Description: gets the component dtxr and mtxx
-- Note
-- Limited to dtxr and mtxx because this is what is commonly used.
-- Extending to other types is possible but only if needed.
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDesc()

        !this.description   = !this.component.dtxr
        handle ANY
          !this.description = 'unset '
        endhandle

        !this.material      = !this.component.mtxx
        handle ANY
          !this.material = 'unset'
        endhandle

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
--
-- Method:      bendradius
--
-- Description: sets the component radius
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .bendRadius(!value is STRING)

       !this.bendRadius = !value.real()

endmethod
