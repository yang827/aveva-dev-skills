--
-- File:            componentdefault.pmlobj
--   Type:          Object Definition
--   Group:         Database Element
--     Keyword:     Default element
--   Module:        Design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Jan 21 15:00:00 GMT 2004
--
--
-- Description:
--    Default Piping Object for components of Component Creation and
--    Modification.
--    As we don't have inheritance this object should be the default
--    object for all other component types and have the same method
--    interface.
--    Where there are any specific requirements for a specific component
--    type, then these should be held in the object for that component.
--
-- Problems:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjacentComponents()             ARRAY               Returns the potential component types which can be created
--  alignmentData()                  -
--  arriveLeave()                    ARRAY               Get Arrive Leave of Component
--  arriveLeave(REAL,REAL)           -                   Set Arrive Leave of Tee
--  baseClass()                      COMPONENTDEFAULT    Returns the base class information from the object
--  checkBoreIndex()                 REAL                Returns the check bore index
--  checkComponents()                -
--  component()                      DBREF               Sets up the object for the passed component
--  component(DBREF)                 BOOLEAN             Sets up the object for the passed component
--  componentDefault()               -                   Constructor
--  copy(ANY)                        BOOLEAN             Copy the bases information from passed component object
--  initialise()                     -                   Reinitialise this object
--  multiBore(BOOLEAN)               -                   Set check bore to leave bore
--  realign()                        -                   Realigns the component with its original definition.
--  type()                           STRING              Returns the type of the object
--  type(STRING)                     -                   Sets type member of object
--

define object COMPONENTDEFAULT

  -- Component
  member .component               is DBREF

  -- Type of component
  member .type                    is STRING

  -- Permissible Type of components
  member .types                   is ARRAY

  -- Specification
  member .specification           is DBREF

  -- Arrive Leave
  member .arrive                  is REAL
  member .leave                   is REAL
  member .checkBore               is REAL

  -- Possibly connected elements
  member .possibleAdjacent        is ARRAY

  -- Alignment Point Information
    -- -1 Arrive, 0 Origin, 1 Leave
    member .alignmentPoint        is REAL
    -- Position relation to .alignmentPoint
    member .alignmentPosition     is POSITION
    -- Ppoint alignment direction is take from (i.e. ORI and P<va> is .alignmentDirection)
    member .alignmentDPoint       is REAL
    -- Direction for alignmentDPoint
    member .alignmentDirection    is DIRECTION

    -- Leave Direction, should handle replace meant of angle elbows
    -- with variable angle bends
    member .alignmentLDirection   is DIRECTION
  --CW -- multiBore boolean to tell if a selectable component is multiBore (reducing p1 boreE not equal p2 bore)
    member .multiBore             is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      componentDefault
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentDefault()

  -- Initialise Variables
  !this.initialise()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      baseClass
--
-- Description: Returns the base class information from the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]        [Description]
--    COMPONENTDEFAULT  Base Class information
--
------------------------------------------------------------------------

define method .baseClass() is COMPONENTDEFAULT
  return !this
endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Reinitialise this object
--              Must be present for interface inheritance
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]        [Description]
--
------------------------------------------------------------------------

define method .initialise()
  -- Initialise Variables
  -- Flow configuration
  !this.multiBore = false
  !this.arrive    = 1
  !this.leave     = 2
  !this.checkBore = -1

  -- Alignment information
  !this.alignmentPoint  = 0
  !this.alignmentDPoint = 0
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copy
--
-- Description: Copy the bases information from passed component object
--              into the current object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Component Object
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successfully copied
--
------------------------------------------------------------------------

define method .copy(!object is ANY) is BOOLEAN

  -- Get the basic information for the object
  !baseClass                = !object.baseClass()

  -- Copy only relevant base class information into this object
  !this.component           = !baseClass.component
  !this.alignmentPosition   = !baseClass.alignmentPosition
  !this.alignmentDirection  = !baseClass.alignmentDirection
  !this.alignmentLDirection = !baseClass.alignmentLDirection
  !this.arrive              = !baseClass.arrive
  !this.leave               = !baseClass.leave
  !this.checkBore           = !baseClass.checkBore

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Sets up the object for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Component
--
------------------------------------------------------------------------

define method .component() is DBREF
  return !this.component
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Sets up the object for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Successfully loaded
--
------------------------------------------------------------------------

define method .component(!component is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.component = !component
  !this.type      = !component.type
  !this.arrive    = !component.arrive
  !this.leave     = !component.leave

  -- Define Alignment Information
  !this.alignmentData()

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      type
--
-- Description: Returns the type of the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING        Ppoint index for check bore (-1 is no check bore)
--
------------------------------------------------------------------------
define method .type() is STRING
--CW
--!this.checkComponents()
  return !this.type
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      type
--
-- Description: Sets type member of object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .type(!type is STRING)
  !this.type = !type.upcase()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      checkBoreIndex
--
-- Description: Returns the check bore index
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Ppoint index for check bore (-1 is no check bore)
--
------------------------------------------------------------------------
define method .checkBoreIndex() is REAL
  return !this.checkBore
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Get Arrive Leave of Component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two element array of Arrive and Leave
--
------------------------------------------------------------------------

define method .arriveLeave() is ARRAY

  -- Initialise Variables
  !return[1] = !this.arrive
  !return[2] = !this.leave
  !return[3] = !this.checkBore

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Set Arrive Leave of Tee
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arriveLeave(!arrive is REAL, !leave is REAL)
  -- if checkBore was P Leave, then set checkBore to the new leave
  !swapCheckBore = ( !this.multiBore and !this.checkBore eq !this.leave )
  !this.arrive  = !arrive
  !this.leave   = !leave
  if( !swapCheckBore ) then
    !this.checkBore = !leave
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      multiBore
--
-- Description: Set check bore to leave bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two element array of Arrive and Leave
--
------------------------------------------------------------------------

define method .multiBore(!boreChange is BOOLEAN)

  !this.multiBore = !boreChange
  if ( !boreChange ) then
   !this.checkBore = !this.leave
  endif

  return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      alignmentDatas
--
-- Description: Set the alignment data for the current component
--              For alignment point,      -1 is Arrive
--                                         0 is Origin
--                                         1 is Leave
--              For alignment direction  -ve is Leave
--                                     0 +ve is Ppoint
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .alignmentData()

  -- Get alignment information
  if(!this.component.set()) then

    -- Get alignment position
    if(!this.alignmentPoint.eq(-1)) then
      !this.alignmentPosition   = !this.component.aPosition
      handle any
      	!this.alignmentPosition = !this.component.pos
      endhandle
    elseif(!this.alignmentPoint.eq(1)) then
      !this.alignmentPosition   = !this.component.lPosition
      handle any
      	!this.alignmentPosition = !this.component.pos
      endhandle
    else
      !this.alignmentPosition   = !this.component.position
    endif

    -- Get alignment direction
    if(!this.alignmentDPoint lt 0) then
      !this.alignmentDirection  = !this.component.lDirection

    else
			
			!unsetPPL = !this.component.ppLst.findFirst(!this.alignmentDPoint).unset()
			handle any
				!unsetPPL = TRUE
			endhandle
      -- Check that component has alignment Direction point
      if(!unsetPPL) then
        !this.alignmentDPoint   = 0
      endif

      !this.alignmentDirection  = !this.component.pDirection[!this.alignmentDPoint]
    endif

    -- Leave Direction
    !this.alignmentLDirection = !this.component.lDirection

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      realign
--
-- Description: Realigns the component with its original definition.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .realign()

  -- Initialise Variables
  var !mode MODE
  FORWARDS
  !reference  = !!ce

  -- Move to component
  if(!this.component.set()) then
    !!ce      = !this.component

    -- Set the arrive and leave data
    !this.component.arrive  = !this.arrive
    !this.component.leave   = !this.leave

    -- Alignment of pleave
    if(!this.alignmentDPoint lt 0) then
      -- Reorient component
      ORI AND PL IS $!<this.alignmentDirection>
      handle ANY
        ORI
      endhandle

    else
      -- Reorient component
      ORI AND P$!<this.alignmentDPoint> IS $!<this.alignmentDirection>
      handle ANY
        -- [1]
        ORI
      endhandle
    endif

    -- Set leave direction
    DIRECTION $!<this.alignmentLDirection>
    handle ANY
    endhandle

    -- Reposition component
    if(!this.alignmentPoint.eq(-1)) then
      POSITION PA AT $!<this.alignmentPosition>
      handle any
      endhandle
    elseif(!this.alignmentPoint.eq(1)) then
      POSITION PL AT $!<this.alignmentPosition>
      handle any
      endhandle
    else
      AT $!<this.alignmentPosition>
      handle any
      endhandle
    endif
    !!ce      = !reference
  endif

  -- Revert Mode
  $!<mode>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      adjacentComponents
--
-- Description: Returns the potential component types which can be created
--              adjacent to the component type.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of component types (only one side)
--
------------------------------------------------------------------------

define method .adjacentComponents() is ARRAY
  return !this.possibleAdjacent
endmethod
-- End of method definition
--------------------------------------------------------------------------
----
---- Method:     checkComponents
----
---- Description: check to see if items have different arrive and leavebores
----
----
--------------------------------------------------------------------------

define method .checkComponents()

  !this.multiBore = false

 -- on opening pdms no need to check the current element
  if (!!ce.type.eq('WORL').or(!!ce.type.eq('TUBI'))) then
  	return
  endif
  	
  if (!!ce.owner.type.neq('BRAN')) then
  	return
  endif
  -- find if item has a differing arrive/leave bore
  if( not badref(!this.component) ) then
    !item             = !this.component
    !this.multiBore   = !item.ppbor[1].neq(!item.ppbor[2])
    handle any
      !this.multiBore = false
    endhandle
  endif

endmethod
-- End of method definition
