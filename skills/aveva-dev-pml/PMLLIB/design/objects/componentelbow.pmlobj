-- Created:         10/03/2010
--
--
-- Description:
--    Piping Elbow Object for Component Creation and Modification
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjacentComponents()             ARRAY               Returns the potential component types which can be created
--  alignmentData()                  -                   Set the alignment data for the current component
--  arriveLeave()                    ARRAY               Get Active Leave of Component
--  arriveLeave(REAL,REAL)           -                   Set Active Leave of Component
--  baseClass()                      COMPONENTDEFAULT    Returns the base class information from the object
--  checkBoreIndex()                 REAL                Returns the check bore index
--  component()                      DBREF               Sets up the object for the passed component
--  component(DBREF)                 BOOLEAN             Sets up the object for the passed component
--  componentElbow()                 -                   Constructor
--  copy(ANY)                        BOOLEAN             Copies the passed object information info the current
--  define(DBREF)                    -                   Set any component specification data
--  modify()                         -                   Set any component specification data for current componen
--  realign()                        -                   Realigns the component with its original definition.
--  type()                           STRING              Returns the type of the object
--  type(STRING)                     -                   Sets type member of object
--


define object COMPONENTELBOW

  -- Basic Class for components
  member .baseClass              is COMPONENTDEFAULT

  -- Members specific to elbow
  -- Angle
  member .angle              is REAL
  member .minAngle           is REAL
  member .maxAngle           is REAL

  --
  member .isRangeDefined      is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      componentElbow
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentElbow()

  -- Initialise Variables

  -- Default alignment is by the origin of the component
  !this.baseClass.alignmentPoint   = 0
  -- Default alignment direction is using P0 (negative is -1 is PL)
  !this.baseClass.alignmentDPoint  = -1

  -- Set permissible * OD for radii (at some stage this could
  -- be loaded from a company/project configuration file)
  !this.angle = 90.0
  !this.minAngle = 90.0
  !this.maxAngle = 90.0

  !this.isRangeDefined = false

  -- Permissible Types
  !this.baseClass.types.append('Elbow')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      baseClass
--
-- Description: Returns the base class information from the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type]        [Description]
--    COMPONENTDEFAULT  Base Class information
--
------------------------------------------------------------------------

define method .baseClass() is COMPONENTDEFAULT

  return !this.baseClass.baseClass()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copy
--
-- Description: Copies the passed object information info the current
--              object definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Component Object
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successfully copied
--
------------------------------------------------------------------------

define method .copy(!object is ANY) is BOOLEAN

  -- Copy base class information
  !this.baseClass.copy(!object)

  -- If this and passed object are the same type, copy all relevant data
  if(!this.objectType() eq !object.objectType()) then
    !this.angle              = !object.angle
    !this.minAngle           = !object.minAngle
    !this.maxAngle           = !object.maxAngle
    !this.isRangeDefined      = !object.isRangeDefined

  endif

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Sets up the object for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Component
--
------------------------------------------------------------------------

define method .component() is DBREF
  return !this.baseClass.component()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Sets up the object for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Successfully loaded
--
------------------------------------------------------------------------

define method .component(!component is DBREF) is BOOLEAN

  -- Perform initial setup for component
  !valid = !this.baseClass.component(!component)

  -- navigate to a component
  !copyCe = !!ce
  !!ce = !component

  !index = REAL()
  -- Set angle information
  if(!valid) then
    !this.angle = !component.angle
    -- find the number of questions
    var !choices choice number
    do !a from 1 to !choices.real()
      var !question Choice question $!a
      if !question.match('ANG').eq(1) then
         !index = !a
         break
      endif
    enddo

    --var !choices split CHOICE
    --!index = !choices.findFirst('ANGL')

    if(!index.set()) then
    	--!index = (!index + 1) / 2
      var !minAngle CHOICE answ $!index
      var !maxAngle CHOICE maxAnsw $!index

      !this.minAngle = REAL(!minAngle)
      !this.maxAngle = REAL(!maxAngle)

      !this.isRangeDefined = true

    endif
  endif

  -- Return
  return !valid

  -- reset current component
  !!ce = !copyCe

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      type
--
-- Description: Returns the type of the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING        Ppoint index for check bore (-1 is no check bore)
--
------------------------------------------------------------------------
define method .type() is STRING

  return !this.baseClass.type()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      type
--
-- Description: Sets type member of object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .type(!type is STRING)

  !this.baseClass.type(!type)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      checkBoreIndex
--
-- Description: Returns the check bore index
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Ppoint index for check bore (-1 is no check bore)
--
------------------------------------------------------------------------
define method .checkBoreIndex() is REAL

  return !this.baseClass.checkBoreIndex()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Get Active Leave of Component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two element array of Arrive and Leave
--
------------------------------------------------------------------------

define method .arriveLeave() is ARRAY

  return !this.baseClass.arriveLeave()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Set Active Leave of a component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arriveLeave(!arrive is REAL, !leave is REAL)

  !this.baseClass.arrive  = !arrive
  !this.baseClass.leave   = !leave
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      alignmentData
--
-- Description: Set the alignment data for the current component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .alignmentData()
  !this.baseClass.alignmentData()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      realign
--
-- Description: Realigns the component with its original definition.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .realign()

  -- update component definition
  !this.component(!this.baseClass.component)
  !this.baseClass.realign()

  -- check if the angle is the defined range
  if( !this.isRangeDefined ) then
    !angle = !this.baseClass.component.angle
    if (!angle lt !this.minAngle or !angle gt !this.maxAngle) then
    	if (!this.angle lt !this.minAngle or !this.angle gt !this.maxAngle) then
    	  !this.baseClass.component.angle = !this.angle
    	else
    	   !this.baseClass.component.angle = !this.maxAngle
    	   !this.angle = !this.maxAngle
    	endif
    endif
  else
  	!this.angle = !this.baseClass.component.angle
  endif
	

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Set any component specification data for current component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()
  !this.define(!this.baseClass.component)

  !this.baseClass.component.angle =!this.angle
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      define
--
-- Description: Set any component specification data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to modify with specific data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .define(!component is DBREF)

  -- Set angle
  !component.angle = !this.angle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      adjacentComponents
--
-- Description: Returns the potential component types which can be created
--              adjacent to the component type.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of component types (only one side)
--
------------------------------------------------------------------------

define method .adjacentComponents() is ARRAY
  return !this.baseClass.adjacentComponents()
endmethod
-- End of method definition
