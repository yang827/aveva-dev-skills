--    REAL        Ppoint index for check bore (-1 is no check bore)
--
------------------------------------------------------------------------
define method .checkBoreIndex() is REAL

  return !this.checkBore

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Get Arrive Leave of Component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two element array of Arrive and Leave
--
------------------------------------------------------------------------

define method .arriveLeave() is ARRAY

  -- Initialise Variables
  !return[1] = !this.arrive
  !return[2] = !this.leave
  !return[3] = !this.checkBore

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      arriveLeave
--
-- Description: Set Arrive Leave of Tee
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arriveLeave(!arrive is REAL, !leave is REAL)
  !this.arrive  = !arrive
  !this.leave   = !leave
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      adjacentComponents
--
-- Description: Returns the potential component types which can be created
--              adjacent to the component type.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of component types (only one side)
--
------------------------------------------------------------------------
define method .adjacentComponents() is ARRAY

    return !this.possibleAdjacent

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      GetUDAvalues
--
-- Description: saves the current uda settings
--
--
------------------------------------------------------------------------
define method .GetUDAValues()

!this.udanames = !this.component.udalis
!values = ARRAY()
do !a values !this.udanames
  !values.append(!this.component.$!<a>)
enddo

!this.udavalues = !values

endmethod

------------------------------------------------------------------------
--
-- Method:      reSetUDAvalues
--
-- Description: restores the current uda settings
--
--
------------------------------------------------------------------------

define method .reSetAttributeValues(!destination is DBREF)

do !a index !this.udanames
  !udaname = !this.udanames[!a]
  !destination.$!<udaname> = !this.udavalues[!a]
  handle ANY
    skip
  endhandle
enddo
!destination.planu       = !this.planu
!destination.pstyp       = !this.pstype
!destination.description = !this.description

endmethod

------------------------------------------------------------------------
--
-- Method:      unsetUDAvalues
--
-- Description: any new pspools need to have old data cleaned out
--
--
------------------------------------------------------------------------
define method .unsetAttributeValues()

do !a index !this.udanames
  !udaname = !this.udanames[!a]
  !value = !this.component.$!<udaname>
  !type = !value.objectType()
  if !type.eq('STRING') then
    !this.component.$!<udaname> = ''
    handle ANY
      -- q var !!error
    endhandle
  elseif !type.eq('REAL') then
    !this.component.$!<udaname> = object REAL()
    handle ANY
      -- q var !!error
    endhandle
  else
    !save = !!ce
    !!ce = !this.component
    !$!<udaname> default
    handle ANY
      skip
    endhandle
    !$!<udaname>  unset
    handle ANY
      skip
    endhandle
    !!ce = !save
  endif
enddo

  !this.component.planu       = ''
  !save = !!ce
  !!ce = !this.component
  pstyp  unset
  !!ce = !save
  !this.component.description = ''


endmethod

------------------------------------------------------------------------
--
-- Method:      Getvolume
--
-- Description: builds a volume object for the spool
--
--
--
------------------------------------------------------------------------
define method .getvolume()

  !this.actualvol = !this.component.nvol
  handle ANY
    this.actualvol = 0
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      Drawvolume
--
-- Description: Draws a box around the spool
--
--
--
------------------------------------------------------------------------
define method .drawvolume()

  !box = !this.volume.box()
  !unusedOri = !box.orientation
  --aid box number $!this.boxnumber ori $!ori at $!box.position xlength $!box.xlength ylength $!box.ylength zlength $!box.zlength
  --aid text number $!this.boxnumber '$!this.spoolname' at $!box.position

endmethod

------------------------------------------------------------------------
--
-- Method:      Drawnewvolume
--
-- Description: Draws a box around the spool
--
--
--
------------------------------------------------------------------------
define method .drawnewvolume()

  !box = !this.volume.box()
  !unusedOrientation = !box.orientation
  !position = !box.position
  !position.up =!position.up + 450
  --aid box number $!this.boxnumber ori $!ori at $!box.position xlength $!box.xlength ylength $!box.ylength zlength $!box.zlength
  --aid text number $!this.boxnumber 'new name is $!this.newspoolname' at $!POSITION

endmethod
