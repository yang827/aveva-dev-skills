--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .type(!type is STRING)

  !this.type = !type.upcase()

endmethod
-- End of method definition

