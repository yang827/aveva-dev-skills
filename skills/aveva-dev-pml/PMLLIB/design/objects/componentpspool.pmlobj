------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  GetUDAValues()                   -
--  adjacentComponents()             ARRAY               Returns the potential component types which can be created
--  arriveLeave()                    ARRAY               Get Arrive Leave of Component
--  arriveLeave(REAL,REAL)           -                   Set Arrive Leave of Tee
--  checkBoreIndex()                 REAL                Returns the check bore index
--  component()                      DBREF               Sets up the object for the passed component
--  componentPspool()                -
--  componentPspool(DBREF)           BOOLEAN
--  copy(ANY)                        BOOLEAN             Copy the bases information from passed component object
--  drawnewvolume()                  -
--  drawvolume()                     -
--  getvolume()                      -
--  reSetAttributeValues(DBREF)      -
--  type()                           STRING              Returns the type of the object
--  type(STRING)                     -                   Sets type member of object
--  unsetAttributeValues()           -
--


define object COMPONENTPSPOOL

  -- Component
  member .component               is DBREF

  member .spoolname               is STRING
  member .newspoolname            is STRING
  member .named                   is BOOLEAN

  -- Type of component
  member .type                    is STRING

  -- list of components
  member .componentlist           is ARRAY
  member .startpoints             is ARRAY
  member .endpoints               is ARRAY

  -- Arrive Leave
  member .arrive                  is ARRAY
  member .leave                   is ARRAY

--  member .tagend                  is REAL
--  member .newtag                  is REAL
--  member .boxnumber               is REAL

  member .volume                  is VOLUME
  member .actualvol               is REAL
  member .haschanged              is BOOLEAN
  member .match                   is STRING
  member .numbersmatched          is REAL
  member .pipePieces              is ARRAY
  member .planu                   is STRING
  member .description             is STRING
  member .pstype                  is STRING
  member .udavalues               is ARRAY
  member .udanames                is ARRAY
  member .psarfa                  is ARRAY
  member .pslrfa                  is ARRAY


endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      componentDefault
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentPspool()

  -- Initialise Variables
  -- Flow configuration

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copy
--
-- Description: Copy the bases information from passed component object
--              into the current object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Component Object
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successfully copied
--
------------------------------------------------------------------------

define method .copy(!object is ANY) is BOOLEAN

  -- Get the basic information for the object
  !baseClass                = !object.baseClass()

  -- Copy only relevant base class information into this object
  !this.component           = !baseClass.component
  !this.alignmentPosition   = !baseClass.alignmentPosition
  !this.alignmentDirection  = !baseClass.alignmentDirection
  !this.alignmentLDirection = !baseClass.alignmentLDirection
  !this.arrive              = !baseClass.arrive
  !this.leave               = !baseClass.leave
  !this.checkBore           = !baseClass.checkBore

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Sets up the object for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Component
--
------------------------------------------------------------------------

define method .component() is DBREF

  return !this.component

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Sets up the object for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Successfully loaded
--
------------------------------------------------------------------------

define method .componentPspool(!component is DBREF) is BOOLEAN


 -- Aid graphic numbers
--  !this.tagend            = !!aidNumbers.add('Spool Tagging')
--  !this.newtag            = !!aidNumbers.add('Spool Tagging')
--  !this.boxnumber         = !!aidNumbers.add('Spool Tagging')
  -- Initialise Variables
  !this.component     = !component
  !this.type          = !component.type
  !this.componentlist = !component.belrfa
  if (!component.name.unset()) then
    !this.named = FALSE
  else
    !this.named = TRUE
    !this.spoolname     = !component.name
  endif
  --- if the spool is unnamed what do we do in the renaming process?????????????????????
  !this.startpoints   = !component.psarfa
  !this.endpoints     = !component.pslrfa
  !this.pipePieces    = !component.pprfa
  !this.planu         = !component.planu
  !this.description   = !component.description
  !this.pstype        = !component.pstyp
  !this.PSARFA        = !component.PSARFA
  !this.PSARFA.sort()
  !this.PSLRFA        = !component.PSLRFA
  !this.PSLRFA.sort()
  !this.GetUDAValues()
  !this.getvolume()
  -- Return
  return TRUE


endmethod
-- End of method definition

------------------------------------------------------------------------
