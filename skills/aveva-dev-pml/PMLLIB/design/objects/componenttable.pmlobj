-- Created:         Fri Jan 23 09:00:00 GMT 2004
--
--
-- Description:
--    Component Table for a type within a specification
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  answers(DBREF)                   ARRAY               Returns answers for passed component
--  available(ARRAY,ARRAY)           ARRAY               Checks the answer list for the passed questions and
--  componentData(STRING,ARRAY,ARRAY) ARRAY               Get all sub-types for passed Bore
--  componentTable(DBREF)            -                   Constructor
--  components(ARRAY,ARRAY)          ARRAY               Returns list of components conforming to given questions and answers
--  loadTable()                      -                   Load table with data form component, this works on the
--  maxAnswers(DBREF)                ARRAY               Returns maximum answers for passed component
--  questionIndex(DBREF)             REAL                Get index of question for passed element, i.e. the QUES
--  questionIndex(STRING)            REAL                Return the question/answer index for the passed question
--  questions()                      ARRAY               Returns list questions for table
--  subTypes(REAL,BORE)              ARRAY               Get all sub-types for passed Bore
--
------------------------------------------------------------------------

define object COMPONENTTABLE

  -- Specification
  member .specification       is DBREF

  -- Component Table Type
  member .type                is STRING

  -- Component Type Selector
  member .selector            is DBREF

  -- List of questions for type
  member .questionList        is ARRAY

  -- List of components for the type
  member .components          is ARRAY

  -- List of answers to the questions (2D array, each element of the array
  -- relates to answers for the question)
  member .answers             is ARRAY

  member .maxAnswers             is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      componentTable
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selector holding Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .componentTable(!passedSelector is DBREF)

  -- Initialise Variables
  !selector = !passedSelector

  -- Check at question of selector is TYPE
  if(!selector.owner.question ne 'TYPE') then

    -- Loop up until we find the owner selector
    do !owner values !selector.ownLst.invert()
      if(!owner.owner.question eq 'TYPE') then
        !selector = !owner
        break
      endif
    enddo

  endif

  -- Get Specification
  if(!selector.owner.type ne 'SPEC') then
    do !owner values !selector.ownLst.invert()
      if(!owner.owner.type eq 'SPEC') then
        !this.specification = !owner
        break
      endif
    enddo
  else
    !this.specification = !selector.owner
  endif

  -- If specification is unset, we could not find a spec
  if(!this.specification.unset()) then
    return
  endif

  -- Set Data
  !this.selector      = !selector
  !this.type          = !selector.tAnswer

  -- Load Table
  !this.loadTable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      questionIndex
--
-- Description: Return the question/answer index for the passed question
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question
-- Return:
--   [Data Type] [Description]
--    REAL       Index
--
------------------------------------------------------------------------

define method .questionIndex(!question is STRING) is REAL
  return !this.questionList.findFirst(!question)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      components
--
-- Description: Returns list of components conforming to given questions and answers
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of questions
--    2   R      ARRAY       List of answer to supplied questions
-- Return:
--   [Data Type] [Description]
--    ARRAY       Index of components matching questions and answers
--
------------------------------------------------------------------------

define method .components(!questions is ARRAY, !answers is ARRAY) is ARRAY

  -- Initialise Variables
  !components = ARRAY()

  -- Get component indices
  !available  = !this.available(!questions, !answers)

  -- Loop through components
  do !i values !available
    !components.append(!this.components[!i])
  enddo

  return !components

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      questions
--
-- Description: Returns list questions for table
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Questions
--
------------------------------------------------------------------------

define method .questions() is ARRAY
  return !this.questionList
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      answers
--
-- Description: Returns answers for passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    ARRAY       Answers
--
------------------------------------------------------------------------

define method .answers(!component is DBREF) is ARRAY

  -- Initialise Variables
  !answers    = ARRAY()
  !index      = !this.components.findFirst(!component)

  -- Element not found
  if(!index.unset()) then
    return !answers
  endif

  -- Loop through questions and answers
  do !i indices !this.questionList
    !answers.append(!this.answers[!i][!index])
    handle ANY
    endhandle
  enddo

  return !answers

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      maxAnswers
--
-- Description: Returns maximum answers for passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    ARRAY       Answers
--
------------------------------------------------------------------------

define method .maxAnswers(!component is DBREF) is ARRAY

  -- Initialise Variables
  !answers    = ARRAY()
  !index      = !this.components.findFirst(!component)

  -- Element not found
  if(!index.unset()) then
    return !answers
  endif

  -- Loop through questions and answers
  do !i indices !this.questionList
    !answers.append(!this.maxAnswers[!i][!index])
    handle ANY
    endhandle
  enddo

  return !answers

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      available
--
-- Description: Checks the answer list for the passed questions and
--              answers and replies components matching criteria
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of questions
--    2   R      ARRAY       List of answer to supplied questions
-- Return:
--   [Data Type] [Description]
--    ARRAY       Index of components matching questions and answers
--
------------------------------------------------------------------------

define method .available(!questions is ARRAY, !answers is ARRAY) is ARRAY

  -- Initialise Variables
  !components = ARRAY()

  -- We will work on the assumptions that the supplied questions are right
  do !i indices !questions
    !indices[!i]        = !this.questionIndex(!questions[!i])
  enddo

  -- Loop through the questions and check against the answer table
  do !i indices !indices
    !!bores = !this.answers[!indices[!i]]
    !available[!i]  = !this.answers[!indices[!i]].find(!answers[!i])
    -- Convert answer type to real in case of getting an format error
    --  '(2,779)   Method <STRING>.EQ(<REAL>) not found'
    handle (2, 779)
      !realAnswer = !answers[!i].real()
      !available[!i]  = !this.answers[!indices[!i]].find(!realAnswer)
      handle ANY
        !!alert.warning('Unable to search answers as there seems to be a problem with the specification for this component type.')
        return !components
      endhandle
    elsehandle ANY
      !!alert.warning('Unable to search answers as there seems to be a problem with the specification for this component type.')
      return !components
    endhandle
    if(!available[!i].empty()) then
      return !components
    endif
  enddo

  -- If there is more than 1 then get the intersection of the answers
  if(!indices.size() gt 1) then
    !results    = !available[1]

    -- Get the intersection of the answers
    do !i from 2 to !indices.size()
      !temp     = !results.intersect(!available[!i])

      -- If temporary array is empty, then there is no components
      if(!temp.empty()) then
        return !components
      endif
      !results  = !temp
    enddo

  -- Only single question
  else
    !results    = !available[1]
  endif

  -- Return
  return !results

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadTable
--
-- Description: Load table with data form component, this works on the
--              assumption that all branches within the table are the same.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadTable()

  -- Initialise Variables
  !this.components.clear()
  !this.questionList.clear()
  !this.answers.clear()
  !this.maxAnswers.clear()

  -- Get all component for type
  var !specComponents collect all (SPCO) for $!<this.selector>

  -- No component found
  if(!specComponents.empty()) then
    return
  endif

  -- Question List
  var !choices split CHOICE with $!<specComponents[1]>

  -- Split into questions
  !questions = ARRAY()
  do !i from 3 to !choices.size() by 2
    !question   = !choices[!i]
    if(!question eq 'PBOR') then
      !boreID   = !choices[!i + 1].subString(1,1).real()
      !question = !choices[!i] & !boreID
    endif
    !questions.append(!question)
  enddo

  -- Set Question List
  !this.questionList  = !questions

  -- Type selector level
  !typeDepth          = !this.selector.dDepth + 1

  -- Loop through the components and build up the answer table
  do !i indices !specComponents
    !component    = !specComponents[!i].dbref()
    !elements     = !component.ownLst.from(!typeDepth)
    !elements.append(!component)

    -- Get Answer
    do !j indices !elements

      -- Get question index
      !index      = !this.questionIndex(!elements[!j])
      skip if(defined(!this.answers[!index][!i]))
      -- Get Answer
      if(!elements[!j].tAnswer.empty().not()) then
        !this.answers[!index][!i] = !elements[!j].tAnswer
      else
        !this.answers[!index][!i] = !elements[!j].answer
      endif

      !this.maxAnswers[!index][!i] = !elements[!j].maxAnswer
    enddo

    -- Add component to list
    !this.components[!i]  = !component

  enddo

  -- Define addition PBOR questions and answers to handle flipped
  -- components and discrepancy between PBOR0 and PBOR1

  -- Rules are if PBOR0 exists and no PBOR1, then create a column
  -- PBOR1 which is a copy of PBOR0
  !index0   = !this.questionList.findFirst('PBOR0')
  !index1   = !this.questionList.findFirst('PBOR1')
  if(!index0.set() and !index1.unset()) then
    !this.questionList.append('PBOR1')
    !index1 = !this.questionList.size()

    -- Update all the answers
    !this.answers[!index1] = !this.answers[!index0]
    !this.maxAnswers[!index1] = !this.maxAnswers[!index0]

  endif

  -- Rules are if PBOR1 exists and no PBOR2, then create a column
  -- PBOR2 which is a copy of PBOR1
  !index1   = !this.questionList.findFirst('PBOR1')
  !index2   = !this.questionList.findFirst('PBOR2')
  if(!index1.set() and !index2.unset()) then
    !this.questionList.append('PBOR2')
    !index2 = !this.questionList.size()

    -- Update all the answers
    !this.answers[!index2] = !this.answers[!index1]
    !this.maxAnswers[!index2] = !this.maxAnswers[!index1]

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      questionIndex
--
-- Description: Get index of question for passed element, i.e. the QUES
--              of it's parent. If the question is not in the question list
--              then it will add it to the list.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    REAL        Returns the indices
--
------------------------------------------------------------------------

define method .questionIndex(!element is DBREF) is REAL

  -- Initialise Variables
  !question = !element.owner.question

  -- Handle bore questions
  if(!question eq 'PBOR') then
    !qualifier = !element.owner.qualifier
    --if(!qualifier eq 0) then
    --  !qualifier  = 1
    --endif
    !question = 'PBOR' & !qualifier
  endif

  -- Check question list for index
  !index = !this.questionList.findFirst(!question)
  if(!index.unset()) then
    !this.questionList.append(!question)
    !index  = !this.questionList.size()
  endif

  -- Return
  return !index

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      subTypes
--
-- Description: Get all sub-types for passed Bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        PBORE number
--    2   R      BORE        Bore
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of Stypes available for passed bore
--
------------------------------------------------------------------------

define method .subTypes(!boreNumber is REAL, !nominalBore is BORE) is ARRAY

  -- Initialise Variables
  !stypes       = ARRAY()

  -- Define Questions and Answers
  !questions[1] = 'PBOR' & !boreNumber
  !answers[1]   = !nominalBore

  -- Get component indices matching questions and answers
  !indices      = !this.available(!questions, !answers)

  -- Get Question/Answer Index
  !index        = !this.questionIndex('STYP')

  -- Loop through the indices
  if(!index.set()) then
    do !i indices !indices

      -- Component has stype
      if(defined(!this.answers[!index][!indices[!i]])) then
        !stypes[!i] = !this.answers[!index][!indices[!i]]

      -- Component group has stype, but component doesn't have one
      else
        !stypes[!i] = STRING()
      endif
    enddo
    !stypes.unique()
  endif

  return !stypes

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentData
--
-- Description: Get all sub-types for passed Bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question to return
--    2   R      ARRAY       Questions to check for
--    3   R      ARRAY       Answers to questions
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of Answers to question for component type
--
------------------------------------------------------------------------

define method .componentData(!question is STRING, !questions is ARRAY, !answers is ARRAY) is ARRAY

  -- Initialise Variables
  !results        = ARRAY()

  -- Get component indices matching questions and answers
  !indices        = !this.available(!questions, !answers)

  -- Get Question/Answer Index
  !index          = !this.questionIndex(!question)
--CW set index for reducing flanges and reducing couplings
  if !index.unset() then
   !index = 2
  endif

  -- Loop through the indices
  do !i indices !indices
    !results[!i]  = !this.answers[!index][!indices[!i]]
  enddo

  !results.unique()
  -- Handle problem where someone has a badly defined specification
  -- and a unique action can not be performed on the list
  handle (2,779)

    -- Determine which is the predominant answer type
    !type           = ARRAY()
    do !i indices !results
      !type.append(!results[!i].objectType())
    enddo
    !types          = !type
    !types.unique()

    -- Determine which we have most of
    !objectType     = !types[1]
    !objectCount    = 0
    do !i indices !types
      !count        = !type.find(!types[!i])
      skip if(!count.unset())
      skip if(!count.size() lt !objectCount)
      !objectCount  = !count.size()
      !objectType   = !types[!i]
    enddo

    -- Extract all results of object Type
    !indices        = !type.find(!objectType)
    !newResults     = ARRAY()
    do !index values !indices
      !newResults.append(!results[!index])
    enddo
    !results        = !newResults
    !results.unique()
  endhandle

  return !results

endmethod
-- End of method definition
