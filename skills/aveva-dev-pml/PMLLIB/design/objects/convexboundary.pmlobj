--
--  Description:     --    Find convex hull of given set of points and arcs--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(ARRAY)                       -                   Clear data list and add passed array of arc position or
--  add(PLANE,ARRAY)                 -                   Clear data list and add passed array of arc position or
--  append(ARRAY)                    -                   Append passed array of arc/position objects
--  convexBoundary()                 -                   Constructor
--  convexHullXYPoints(ARRAY)        ARRAY               Return the convex hull of the given set of 2D points
--  getXYPoints(PLANE,ARRAY)         ARRAY               Get xyPosition objects of given array of objects on plane !plane
--  mapObjectsToPlane()              ARRAY               Map objects onto the reference plane
--  plane(PLANE)                     -                   Define plane that data is mapped to
--  points()                         PROFILE             Return convex hull without arcs merged into profile
--  processData(ARRAY)               ARRAY               Converts input data into data that can interpreted by this object
--  profile()                        PROFILE             Get convex hull profile for a collection of position,
--  tangentPoints()                  ARRAY               Given array of POSITION, LINE and ARC objects, return all tangent
--  unionArcs(PROFILE)               PROFILE             Convert all arcs to profiles and union them
--
------------------------------------------------------------------------
--
-- Description:
--    Find convex hull of given set of points and arcs
--
------------------------------------------------------------------------
--

define object CONVEXBOUNDARY

  -- List of objects mapped to the given plane (Array of Arcs)
  member .mappedObjects   is ARRAY

  -- Plane points and arcs are projected onto (Y is the initial direction of the plane)
  member .plane           is PLANE

  -- Input data
  member .data            is ARRAY

  -- points mapped onto plane as array of xyPosition objects
  member .xyPoints        is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      convexBoundary
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .convexBoundary()

  -- Initialise Variables
  !this.plane.position    = object POSITION('E0 wrt /*')
  !this.plane.orientation = object ORIENTATION('Y IS Y AND Z IS Z')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Define plane that data is mapped to
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plane(!plane is PLANE)

  !this.plane = !plane

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Clear data list and add passed array of arc position or
--              line objects and map to plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Arc, Position or line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!data is ARRAY)

  -- Initialise Variables
  !this.data.clear()
  !this.data             = !this.processData(!data)
  -- Map points to plane
  !this.mappedObjects    = !this.mapObjectsToPlane()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Clear data list and add passed array of arc position or
--              line objects and map to given plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
--    2   R      ARRAY       Arc, Position or line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!plane is PLANE, !data is ARRAY)

  -- Initialise Variables
  !this.data.clear()
  !this.plane            = !plane
  !this.data             = !this.processData(!data)
  -- Map points to plane
  !this.mappedObjects    = !this.mapObjectsToPlane()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      processData
--
-- Description: Converts input data into data that can interpreted by this object
--              The input array can contain Position, Line, Arc and Profile object
--              The output array contains only Position and circle Arc objects
--              Lines are converted to two points and Profiles are converted to
--              points and arcs
--              THIS IS CALLED RECURSIVELY - don't set object members
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Arc, Position, Line or Profile objects
-- Return:
--   [Data Type] [Description]
--    ARRAY       Points and circle Arcs
--
------------------------------------------------------------------------

define method .processData(!data is ARRAY) is ARRAY

  -- Initialise Variables
  !pointData    = ARRAY()
  !arcData      = ARRAY()
  !profileData  = ARRAY()

  do !index indices !data

    !objectType = !data[!index].objectType()

    if( !objectType eq 'POSITION' ) then
      -- copy position to output
      !pointData.append(!data[!index])

    elseif( !objectType eq 'LINE' ) then
      -- get end points
      !pointData.append(!data[!index].startPosition)
      !pointData.append(!data[!index].endPosition)

    elseif(!objectType eq 'ARC' ) then
      -- copy arc circle to output
      !arcData.append(!data[!index].circle())

    elseif(!objectType eq 'PROFILE' ) then
      -- split into edges and process the edges
      !profileData.appendArray( !this.processData(!data[!index].edges()) )

    endif

  enddo

  -- get rid of duplicate points - may occur with straight edges
  !pointData.unique()

  !pointData.appendArray(!arcData)
  !pointData.appendArray(!profileData)

  return !pointData

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      points
--
-- Description: Return convex hull without arcs merged into profile
--              Note that return PROFILE will only be a closed
--              profile if input data is valid
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROFILE     Convex hull without arcs merged into profile
--
------------------------------------------------------------------------

define method .points() is PROFILE

  -- Initialise Variables
  !this.xyPoints           = !this.getXYPoints(!this.plane,!this.mappedObjects)
  -- get array of points on convex hull
  !convexHullXYPointsArray = !this.convexHullXYPoints(!this.xyPoints)
  -- convert from xyPositions of 3D Positions
  !points = ARRAY()
  do !xyPosition values !convexHullXYPointsArray
    !points.append(!this.plane.threeDPosition(!xyPosition))
  enddo

  -- create profile from points and plane
  !rawProfile = object PROFILE(!this.plane.position, !this.plane.orientation, !points)

  !profile = !rawProfile.mergePoints().mergeLines()

  return !profile

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      profile
--
-- Description: Get convex hull profile for a collection of position,
--              line and arc objects.
--              First find all tangent points on arcs
--              Get convex hull of the resulting set of points
--              Union original arcs with convex hull
--              Note that return PROFILE will only be a closed
--              profile if input data is valid
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROFILE     Convex hull without arcs merged into profile
--
------------------------------------------------------------------------

define method .profile() is PROFILE

  -- If the input data contains only one object return this as a profile
  if( !this.mappedObjects.size() eq 1 ) then
    !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !this.mappedObjects)
    return !profile
  endif

  -- find all tangents between all arcs
  !tangentPoints           = !this.tangentPoints()
  !this.xyPoints           = !this.getXYPoints(!this.plane,!tangentPoints)
  -- get array of points on convex hull
  !convexHullXYPointsArray = !this.convexHullXYPoints(!this.xyPoints)
  -- convert from xyPositions of 3D Positions
  !points = ARRAY()
  do !xyPosition values !convexHullXYPointsArray
    !points.append(!this.plane.threeDPosition(!xyPosition))
  enddo

  if( !points.empty() ) then

    -- this could be a circle contains circles case
    -- look for the first arc in data and set it as the profile
    !profile = object PROFILE()
    do !index indices !this.mappedObjects
      !type = !this.mappedObjects[!index].objectType()
      if( !type eq 'ARC' ) then
        !arcArray[1] = !this.mappedObjects[!index].circle()
        !profile     = object PROFILE(!this.plane.position, !this.plane.orientation, !arcArray)
        break
      endif
    enddo

  else

    -- convert points to Profile
    !profile = object PROFILE(!this.plane.position, !this.plane.orientation, !points)

  endif

  !unionProfile = !this.unionArcs( !profile )

  return !unionProfile.mergePoints().mergeLines().mergeArcs()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getXYPoints
--
-- Description: Get xyPosition objects of given array of objects on plane !plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane on which two positions are mapped
--    2   R      ARRAY       Array of Arc or Position objects
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getXYPoints(!plane is PLANE, !objects is ARRAY) is ARRAY

  -- Initialise Variables
  !return = ARRAY()
  -- loop through array of arc or position objects and calculate the
  -- XYposition on the given plane
  do !index indices !objects
    !objectType = !objects[!index].objectType()
    if( !objectType eq 'POSITION' ) then
      !return.append(!plane.xyOffset(!objects[!index]))
    else
      -- go for position member (arcs)
      !pos = !objects[!index].position
      handle any
        skip
      endhandle
      !return.append(!plane.xyOffset(!pos))
    endif
  enddo

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      convexHullXYPoints
--
-- Description: Return the convex hull of the given set of 2D points
--              This method uses a modified version of the 'Graham scan'
--              algorithm:
--              Find point at minimum Y. If >1 at minimum Y tie break with Max X.
--              Call this point P.
--              Sort remaining points angularly about P as a centre.
--              For points at the same angle choose only the furthest from P
--              Now consider each of the remaining points in the sorted array in sequence.
--              Push P[1] and P[2] onto a stack S
--              while i < N
--              {
--                 Let PT1 = the top point on S
--                 Let PT2 = the second top point on s
--                 if (P[i] is strictly right of the line PT2 to PT1) then
--                     Push P[i] onto S
--                     increment i
--                 else
--                     Pop the top point PT1 off S
--                 endif
--              }
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       ARRAY of xyPosition objects
-- Return:
--   [Data Type] [Description]
--    ARRAY       of XPPosition objects representing the convex hull of the input points
--                If less than three points returned then this is a degenerate input data set
--
------------------------------------------------------------------------

define method .convexHullXYPoints(!data is ARRAY) is ARRAY

  -- initialise array as stack of point indices
  !stack          = ARRAY()
  !stackTop       = 0
  !return         = ARRAY()

  -- return input array if less than three points
  if( !data.size() lt 3 ) then
    return !data
  endif

  -- find start point at minimum y --
  !minimumY       = !data[1].y
  !maximumX       = !data[1].x
  !minIndex       = 1

  -- loop through points to find start point at minimum y
  do !index indices !data
    skip if( !index eq 1 )
    !xyPos        = !data[!index]
    skip if( !xyPos.y gt !minimumY )
    if( !xyPos.y lt !minimumY ) then
      !minimumY   = !xyPos.y
      !maximumX   = !xyPos.x
      !minIndex   = !index
      skip
    endif
    -- must be equal y - choose maximum X
    skip if( !xyPos.x le !maximumX )
    -- must be min Y max X
    !minimumY   = !xyPos.y
    !maximumX   = !xyPos.x
    !minIndex   = !index
  enddo

  -- Order points by angle --

  -- loop through points and record cosine of angle with X direction
  !startX       = !data[!minIndex].x
  !startY       = !data[!minIndex].y
  !cosAngle     = ARRAY()
  !distance     = ARRAY()
  do !index indices !data
    -- use value 2 to mark eliminated point
    !cosAngle[!index] = 2
    !distance[!index] = 0
    -- skip the start point
    skip if( !index eq !minIndex )
    !x                = !data[!index].x -!startX
    !y                = !data[!index].y -!startY
    !distance[!index] = sqrt( !x * !x + !y * !y )
    -- ignore point coincident with start point
    skip if( !distance[!index] lt 0.01mm )
    -- record cosine of angle for this point
    !cosAngle[!index] = !x / !distance[!index]
  enddo

  -- sort the angles
  !sortIndices = !cosAngle.sortedIndices()

  -- pass through the array of angles to eliminate '2' points and points on same angle
  !vertex[1]   = !minIndex
  !lastAngle   = 2
  do !index values !sortIndices
    !currentCosAngle = !cosAngle[!index]
    -- if a 2 found then the remaining are rejected vertices
    break if( !currentCosAngle eq 2 )
    if( !lastAngle eq !currentCosAngle ) then
      -- angle to last point and this point are the same - choose the furthest point from the start point
      skip if( !distance[!index] le !distance[!vertex.last()] )
      -- this point replaces the last value because it is further from the start
      !vertex[!vertex.maxIndex()] = !index
    else
      -- next vertex
      !vertex.append(!index)
      !lastAngle = !currentCosAngle
    endif
  enddo

  -- if there are less than three points remaining this is a degenerate case
  -- if there are three points remaining they must be convex
  if( !vertex.size() le 3 ) then
    do !index values !vertex
      !return.append(!data[!index])
    enddo
    if( !vertex.size() eq 3 ) then
      -- close the curve
      !return.append(!return[1])
    endif
    return !return
  endif

  -- loop through sorted vertices to find points strictly to the right --
  -- add the first point to the end of the vertex list to close the curve
  !vertex.append(!vertex[1])
  !stack[1]   = !vertex[1]
  !stack[2]   = !vertex[2]
  !i          = 3
  do
    !stackTop         = !stack.maxIndex()
    !index            = !vertex[!i]
    !xTopOfStack      = !data[!stack[!stackTop]].x - !data[!stack[!stackTop - 1]].x
    !yTopOfStack      = !data[!stack[!stackTop]].y - !data[!stack[!stackTop - 1]].y
    !xCurrent         = !data[!index].x            - !data[!stack[!stackTop]].x
    !yCurrent         = !data[!index].y            - !data[!stack[!stackTop]].y
    !crossProduct     = !xTopOfStack * !yCurrent - !xCurrent * !yTopOfStack
    if( !crossProduct geq 0 ) then
      -- This edge is co-linear of concave with stack top edge
      -- pop the last point
      !stack.removeLast()
      -- safety check that stack is not reduced below two elements - should not happen
      break if( !stack.size() lt 2 )
    else
        -- push vertex on stack
      !stack.append(!index)
      !i = !i + 1
      break if( !i gt !vertex.size() )
    endif
  enddo

  -- build array of points to return
  do !index values !stack
    !return.append(!data[!index])
  enddo

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      append
--
-- Description: Append passed array of arc/position objects
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of Arc or Position objects
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .append(!data is ARRAY)

  -- Initialise Variables
  !this.data.appendArray(!data)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      mapObjectsToPlane
--
-- Description: Map objects onto the reference plane
--              The mapping is to closest point on the plane
--              Arc normals are not projected to their intersection with the plane
--              Arcs centres are mapped to the plane but the arc geometry itself is not
--              projected onto the plane
--              The original arc diameter is used to create a new arc (full circle)
--              Objects of wrong type are not mapped into the output array
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of objects mapped onto the plane
--
------------------------------------------------------------------------

define method .mapObjectsToPlane() is ARRAY

  -- Initialise Variables
  !return = ARRAY()
  !plane  = !this.plane

  -- Loop through input data projecting each element onto the given plane
  do !i indices !this.data
    !type = !this.data[!i].objectType()

    -- Map arc to reference plane
    if(!type.eq('ARC')) then
      !arc              = !this.data[!i]
      !arc.position     = !plane.near(!arc.position)
      !arc.orientation  = !plane.orientation
      !return.append(!arc)

    -- Map position to plane
    elseif (!type.eq('POSITION')) then
      !position         = !plane.near(!this.data[!i])
      !return.append(!position)

    endif

  enddo

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tangentPoints
--
-- Description: Given array of POSITION, LINE and ARC objects, return all tangent
--              points between all objects in the array
--              Position is returned for POSITION objects
--              Objects must have been mapped to a plane before using this method
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of tangent points
--
------------------------------------------------------------------------

define method .tangentPoints() is ARRAY

  -- Initialise Variables
  !points               = object ARRAY()

  -- replace line objects by point objects in mapped object array
  !comparePoints = ARRAY()
  !compareArcs   = ARRAY()
  do !index indices !this.mappedObjects
    !type = !this.mappedObjects[!index].objectType()
    if( !type eq 'POSITION' ) then
      !comparePoints.append(!this.mappedObjects[!index])
    elseif( !type eq 'ARC' ) then
      !compareArcs.append(!this.mappedObjects[!index])
    endif
  enddo

  !comparePoints.unique()
  -- Put points directly into output ARRAY
  !points = !comparePoints

  -- find all point to arc tangents
  do !point values !comparePoints
    do !arc values !compareArcs
      !tangentAngles = !arc.tangents(!point)
      do !tangentAngle values !tangentAngles
        !points.append(!arc.anglePosition(!tangentAngle))
      enddo
    enddo
  enddo

  -- find all arc to arc tangents
  !compareArcsSize = !compareArcs.size()
  do !fromIndex from 1 to !compareArcsSize - 1
    !fromArc = !compareArcs[!fromIndex]
    do !toIndex from !fromIndex + 1 to !compareArcsSize
      !toArc = !compareArcs[!toIndex]
      !points.appendArray(!fromArc.tangents(!toArc))
      !points.appendArray(!toArc.tangents(!fromArc))
    enddo
  enddo

  -- remove duplicate points
  !points.unique()

  return !points

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      unionArcs
--
-- Description: Convert all arcs to profiles and union them
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of tangent points
--
------------------------------------------------------------------------

define method .unionArcs(!profile is PROFILE) is PROFILE

  -- find all arcs
  !arcs   = ARRAY()
  do !index indices !this.mappedObjects
    !type = !this.mappedObjects[!index].objectType()
    if( !type eq 'ARC' ) then
      !arcs.append(!this.mappedObjects[!index])
    endif
  enddo

  if( !arcs.size() gt 0 ) then

    if( !profile.isClosed() ) then
      !union[1] = !profile
    else
      -- use first arc as a profile
      !arcArray[1] = !arcs[1].circle()
      !union[1]    = object PROFILE(!this.plane.position, !this.plane.orientation, !arcArray)
      -- now union with the remaining arcs
      !arcs.removeFirst()
    endif

    do !arc values !arcs
      !arcArray[1] = !arc.circle()
      !arcProfile  = object PROFILE(!this.plane.position, !this.plane.orientation, !arcArray)
      !union = !union[1].union(!arcProfile)
    enddo
    return !union[1]

  else

    -- no arcs - just return given profile
    return !profile

  endif

endmethod
-- End of method definition
