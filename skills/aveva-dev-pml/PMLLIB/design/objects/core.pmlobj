--
--
--
-- Description:
--    core information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  core()                           -                   Constructor
--  core(DBREF)                      -                   Constructor
--  create()                         DBREF
--  deletecore()                     -
--  deletecore(DBREF)                -
--  highlight(STRING)                -
--  modify()                         -                   modifies an existing core element
--  updateData(STRING,DBREF)         ARRAY
--
------------------------------------------------------------------------

define object CORE

  -- object members

  -- standard element data
  member .dbref           is DBREF
  member .name            is STRING
  member .owner           is DBREF
  member .desc            is STRING
  member .func            is STRING
  member .purp            is STRING

  -- core specific data
  member .staRef            is DBREF
  member .endRef            is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      core
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .core()

 -- default constructor, don't need to set initial values because these will be assigned during core creation

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      core
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element is core element, thus we are initialising with an existing core element.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .core(!element is DBREF)

  if !element.type.eq('CORE') then
    -- Initialise Variables
    !this.dbref           = !element
    !this.name            = !element.namn
    !this.owner           = !element.owner
    !this.desc            = !element.description
    !this.func            = !element.function
    !this.purp            = !element.purpose

    -- core specific data
    !this.staRef            = !element.staRef
    !this.endRef            = !element.endRef
  endif
endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      Create
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()is DBREF

  -- THERE SEEMS TO BE A BUG IN THE CODE WHERE IF THERE IS ANOTHER CORE IN THE MEMBERS LIST
  -- YOU CANNOT CREATE ANOTHER CORE AT CABLE LEVEL
  -- TEMP CODE - TRY TO NAVIGATE TO A CORE ELEMENT
  CORE 1
  handle ANY
  endhandle
  -- TEMP CODE - TRY TO NAVIGATE TO A CORE ELEMENT

  --Create core
  NEW CORE
  !core = !!ce
   --Update Data
  !error = !this.updateData(|CREATE|, !core)

  return !this.dbref

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: modifies an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  --Update Data
  --!core = !this.dbref
  !core = !!ce
  --!error = !this.updateData(|MODIFY|,!core)
  !error = !this.updateData(|MODIFY|, !core)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      delete
--
-- Description: deletes an existing core element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletecore()

  !!ce = !this.dbref
  delete core

endmethod

------------------------------------------------------------------------
--
-- Method:      delete(!ce)
--
-- Description: deletes an existing core element with supplied reference
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletecore(!ce is DBREF)

  !!ce = !ce
  delete core

endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method: updateData
--
-- Description: Updates the modified data
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData(!mode is STRING, !core is DBREF) is ARRAY

$(
  -- mode is either CREATE or MODIFY
  !errors = object ARRAY()
  -- write the member variable values back to the cable element this allows the calling form to
  -- only make permanent changes when it has purposefully altered the object member values.

  -- now write the variables back to the dbref
  if !this.name.unset().not() then
    if !this.name.substring(1,1).neq('=') and !this.name.substring(1,1).neq('/') then
      !name = '/' + !this.name
    else
      !name = !this.name
    endif
    !!ce.name             = !name
    handle ANY
      !errors.append('name  + $!!error.text')
    endhandle
  endif

  if !this.desc.unset().not() then
    !this.dbref.description      = !this.desc
      handle ANY
        !errors.append('description  + $!!error.text')
      endhandle
  endif

  if !this.func.unset().not() then
    !this.dbref.function         = !this.func
      handle ANY
        !errors.append('function  + $!!error.text')
      endhandle
  endif

  if !this.purp.unset().not() then
    !this.dbref.purpose          = !this.purp
      handle ANY
        !errors.append('purpose  + $!!error.text')
      endhandle
  endif

  if !this.staRef.unset().not() then
    !this.dbref.staRef           = !this.staRef
      handle ANY
        !errors.append('staRef  + $!!error.text')
      endhandle
  endif

  if !this.endRef.unset().not() then
    !this.dbref.endRef           = !this.endRef
      handle ANY
        !errors.append('endRef  + $!!error.text')
      endhandle
  endif
$)

  -- mode is either CREATE or MODIFY
  !errors = object ARRAY()
  -- write the member variable values back to the core element this allows the calling form to
  -- only make permanent changes when it has purposefully altered the object member values.

  ----------------------------------------------------------------------
  -------- temp code - until we know what data needs to be assigned ----
  ----------------------------------------------------------------------


  if !!ce.neq(!this.dbref) and !this.dbref.unset().not() then
    -- there is an error
    !!alert.error('current element is different from element being modified - cannot update')
    return
  else
    if !mode.eq('CREATE') then

      -- do nothing, all dbref attributes are set default until we modify
      --!this.dbref = !core
      !!ce = !core
      !this.name = !!ce.name

    else

      -- now write the variables back to the dbref
      if !this.name.unset().not() then
        if !this.name.substring(1,1).neq('=') then
          !name = '/' + !this.name
          !!ce.name             = !name
            handle (2,796)
              --$p !!error.txt
            endhandle
            handle ANY
              !errors.append('name ' + $!!error.text)
            endhandle
        endif
      endif
      !!ce.description      = !this.desc
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('description ' + $!!error.text)
        endhandle
      !!ce.function         = !this.func
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('function ' + $!!error.text)
        endhandle
      !!ce.purpose          = !this.purp
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('purpose ' + $!!error.text)
        endhandle

      -- core specific data
      !!ce.staRef           = !this.staRef
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('staRef ' + $!!error.text)
        endhandle
      !!ce.endRef           = !this.endRef
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('endRef ' + $!!error.text)
        endhandle

  $(
      !!ce.stapoint         = !this.StaPoint
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('stapoint ' + $!!error.text)
        endhandle
      !!ce.endpoint         = !this.EndPoint
        handle (2,796)
        endhandle
        handle ANY
          !errors.append('endpoint ' + $!!error.text)
        endhandle
  $)
    endif
  endif

  return !errors

endmethod
--End of method definition

------------------------------------------------------------------------
--
-- Method: highlight
--
-- Description: highlights the start and end point of the core
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .highlight(!mode is STRING)

  -- need to decide if this method is required for this object
  -- if so how we need to figure out how it will be utilised

  $(

  unenhance all
  aid clear text 1
  handle ANY
  endhandle
  aid clear text 2
  handle ANY
  endhandle

  -- mode will be TRUE or FALSE dependent upon whether you want to switch on or turn off highlighting
  if !mode.eq('TRUE') then
    if !this.StaRef.unset().not() then
      enhance $!this.StaRef colour $!!gphcolopt.highlight
      !pos = !this.StaRef.position.wrt( /* )
      aid text num 1 'START' at $!pos
    endif

    if !this.EndRef.unset().not() then
      enhance $!this.EndRef colour $!!gphcolopt.highlight
      !pos = !this.EndRef.position.wrt( /* )
      aid text num 2 'END' at $!pos
    endif
  else
    -- do nothing we have already unenhanced
  endif

  $)

endmethod
--End of method definition

-- End of object definition
