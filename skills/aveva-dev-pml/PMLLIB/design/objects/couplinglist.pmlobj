-- Author:          Tony Martin
-- Created:         14/03/2013 09:05:28
--
--
-- Description:
-- object to gather coupling data for special branch connections.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignComponentLists(DBREF)       -
--  couplingList(DBREF,FORM)         -
--  couplingList(DBREF,FORM,BORE)    -
--  fillBores(REAL)                  -
--  getCategories()                  -                   get a list of the categories of components
--  getCouplingParameters(DBREF)     ARRAY               get the chei, cdia, and flen from the passed spcom
--  getDefaultBores(DBREF,BORE)      ARRAY
--  getParameters(STRING)            ARRAY
--  getTappingsFromSpec(BOOLEAN)     -
--  getcatRefs()                     -
--  populateComponents()             -
--  populateLists()                  -
--
define object COUPLINGLIST

member .categories         is ARRAY
member .descriptions       is ARRAY
member .material           is ARRAY
member .specComponents     is ARRAY
member .categoryComponents is ARRAY
member .bores              is ARRAY
member .chei               is ARRAY
member .cdia               is ARRAY
member .flen               is ARRAY
member .initialCollection  is ARRAY
member .couplingGadget     is GADGET
member .boreGadget         is GADGET
member .form               is FORM
member .currentBore        is BORE

endobject
------------------------------------------------------------------------
-- alternate constructor method
------------------------------------------------------------------------
define method .couplingList(!spec is DBREF,!form is FORM,!bore is BORE )

!this.currentBore = !bore
!this.couplingList(!spec,!form)

endmethod
------------------------------------------------------------------------
-- constructor method
-------------------------------------------------------------------------
define method .couplingList(!spec is DBREF,!form is FORM )

!this.form = !form


!this.couplingGadget =  !!pipetappings.couplingType
!this.boreGadget     =  !!pipetappings.boreSize

-- collect all of the relevant sizes for the spec entries

  -- collection definition for elements that reference design templates
  !spcoCollection = object COLLECTION()
  !spcoCollection.type('SPCO')
  !spcoCollection.scope(!spec)

  !spcoCollection.filter(object EXPRESSION( |COMPTYPE of catref eq 'PTAP'| ))
  !this.initialCollection = !spcoCollection.results()

-- get the categories
!this.getCategories()

-- get the catRefs
!this.getcatRefs()

-- get the bores
--!this.getComponentDetails(!comps is ARRAY)



endmethod

------------------------------------------------------------------------
--
-- Method:      .getCategories()
--
-- Description: get a list of the categories of components
--
------------------------------------------------------------------------
define method .getCategories()

 !categories = ARRAY()
 -- !this.initialCollection is a list of spcoms
 do !a values !this.initialCollection
   !categories.append( cate of catref of $!a)
 enddo
 !this.categories = !categories.unique()

endmethod

------------------------------------------------------------------------
--
-- Method:      .getTappingsFromSpec
--
-- Description: coll all of the couplings with a COMPTYPE eq 'TAPP'
--
------------------------------------------------------------------------
define method .getcatRefs()

-- find the category components for each listed category
do !a values !this.categories
  !catRefs    = ARRAY()
  !components = ARRAY()
  !bores      = ARRAY()
  !chei       = ARRAY()
  !cdia       = ARRAY()
  !flen       = ARRAY()
  !descriptions = ARRAY()
   do !b values !this.initialCollection
      if !b.catref.owner.eq(!a) then
         !components.append(!b.string())
         !catRefs.append (!b.catref.string() )
         !bores.append(!b.catref.ppbor[1].string())
         !chei.append(rprop chei of catref of $!b)
         !cdia.append(rprop cdia of catref of $!b)
         !flen.append(rprop flen  of catref of $!b)
         !descriptions.append(!b.dtxr)
      endif
  enddo
  --!descriptions.unique()
  !this.chei               .append( !chei      )
  !this.cdia               .append( !cdia      )
  !this.flen               .append( !flen      )
  !this.bores              .append( !bores     )
  !this.specComponents     .append( !components)
  !this.categoryComponents .append( !catRefs   )
  !this.descriptions       .append( !descriptions)
enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      populateLists()
--
-- Description: populate the description and bore lists
--
------------------------------------------------------------------------
define method .populateComponents()

!components = ARRAY()
!descriptions = ARRAY()

do !a index !this.categories
  !test = !this.bores[!a].findFirst(!this.currentBore.string()).gt(0)
  handle None
     if !test then
       !index = !this.bores[!a].findFirst(!this.currentBore.string())
       !components.append(!this.specComponents[!a][!index])
       !descriptions.append(!this.descriptions[!a][!index])
     endif
  elsehandle any
    -- cater for not being able to find one of the entries
  endhandle
enddo


!components.insert(1,'none')
!descriptions.insert(1,'none')

!this.couplingGadget.dtext = !descriptions
!this.couplingGadget.rtext = !components

endmethod

------------------------------------------------------------------------
--
-- Method:      populateLists()
--
-- Description: populate the description and bore lists
--
------------------------------------------------------------------------
define method .populateLists()

!list[1] = 'none'
do !a values !this.categories
  !list.append(!a.string() )
enddo

!descriptions = !this.descriptions

!descriptions.insert(1,'none')

!this.couplingGadget.dtext = !descriptions
!this.couplingGadget.rtext = !list
!bores[1] = 'unset'
!this.boreGadget.dtext = ARRAY()

if !list.size().eq(1) then
  !!alert.error('No Boss connections available for the current specification')
  !this.form.stubinType.val = 1
  !this.form.GETTUBEBORES(!this.form.stubinType.selection('rtext'))
  !this.form.couplingType.active = FALSE
  !this.form.boreSize.active = FALSE
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .fillBores
--
-- Description: called by the category gadget to select the available
-- and available components
--
------------------------------------------------------------------------
define method .fillBores(!category is REAL)

!item = !category - 1
!this.boreGadget.dtext = !this.bores[!item]
handle any
return
endhandle
!this.boreGadget.rtext = !this.specComponents[!item]


endmethod
------------------------------------------------------------------------
--
-- Method:      .getParameters
--
-- Description: called by the category gadget to select the available
-- and available components
--
------------------------------------------------------------------------
define method .getParameters(!component is STRING )is ARRAY

!return = ARRAY()
do !a index !this.specComponents
     !index =  !this.specComponents[!a].findFirst(!component)
     if !index.set() then
       !return[1] = !this.chei[!a][!index]
       !return[2] = !this.cdia[!a][!index]
       !return[3] = !this.flen[!a][!index]
       break
    endif
enddo

return !return

endmethod
------------------------------------------------------------------------
--
-- Method:      .getTappingsFromSpec
--
-- Description: coll all of the couplings with a COMPTYPE eq 'PTAP'
--
------------------------------------------------------------------------
define method .getTappingsFromSpec(!test is BOOLEAN )

if !test.not() then
  return
endif

var !a COLL ALL SPCO WITH COMPTYPE OF CATREF EQ 'PTAP' FOR $!this.teeSpec
var !b eval dtxr for all from !a
!b.unique()
!b.insert(1,'None')
!this.couplingType.dtext = !b
var !c evaluate p1 bore for all from !a
!c.unique()
!this.boreSize.dtext = !c

endmethod

------------------------------------------------------------------------
--
-- Method:      .getDefaultBores
--
-- Description: get a list of bores below the current bore
--
------------------------------------------------------------------------
define method .getDefaultBores(!spec is DBREF,!currentBore is BORE )is ARRAY

!specObject = object SPECIFICATION(!spec)
!bores = !specObject.bores

if !currentBore.unset() then
  return !bores
else
  !index = !bores.findFirst( !currentBore )
  handle ANY
    return !bores
  endhandle
  !return = !bores.from(!index)
endif

endmethod
------------------------------------------------------------------------
--
-- Method:      getCouplingParameters
--
-- Description: get the chei, cdia, and flen from the passed spcom
--
------------------------------------------------------------------------
define method .getCouplingParameters(!specom is DBREF)is ARRAY

!cate  = !specom.catref.owner
!index = !this.categories.findFirst(!cate)
!index2 = !this.specComponents[!index].findFirst(!specom)
!chei = !this.chei[!index][!index2]
!cdia = !this.cdia[!index][!index2]
!flen = !this.flen[!index][!index2]

!return[1] = !chei
!return[2] = !cdia
!return[3] = !flen

return !return

endmethod
------------------------------------------------------------------------

define method .alignComponentLists(!spref is DBREF )

!category = !spref.catref.owner
!index = !this.categories.findFirst(!category)

!this.couplingGadget.select('rtext',!category.string())

endmethod
