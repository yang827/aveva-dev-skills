-- File:            cvlscreedslope.pmlobj
--   Type:          Object Definition
--   Group:         Wall and Floors Application

--     Keyword:     CIVIL
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Apr 21 10:28:09 BST 1999
--
--
-- Description:
--  Define screed slopes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cvlScreedSlope()                 -                   Constructor, using passed floor to define boundary
--  define()                         BOOLEAN             Define slope
--  derive()                         BOOLEAN             Derive definition with exiting data
--  direction()                      DIRECTION           Returns direction on the screed plane of the slope
--  direction(DIRECTION)             -                   Define direction on the screed plane of the slope
--  draw()                           -                   Draw basic slop
--  edge(LINE)                       -                   Make x axes of plane the rotation axes
--  extremities()                    -                   Returns the extremities of the loop definition (using the points)
--  extrusion()                      -                   Derive the negative extrusion points
--  negativePlane()                  PLANE               Sets the negative plane definition
--  plane(PLANE)                     -                   Set planes (passed plane is screed plane)
--  position()                       POSITION            Returns position on the screed plane of the slope
--  position(POSITION)               -                   Define slope position
--  setThrough()                     -                   Recalculates the set through point onto the current plane
--  setup(DBREF)                     BOOLEAN             Constructor, using passed floor to define boundary
--  slope()                          REAL                Returns the slope angle from screed plane
--  slope(REAL)                      -                   Define slope angle from screed plane (changing the slop only changes the plane and negative plane)
--  through()                        POSITION            Returns a through point on the slope surface (if unset through point, an point 1M from origin will be returned)
--  through(POSITION)                -                   Move slope through the passed point, change slope and direction
--  through(POSITION,BOOLEAN)        -                   Move slope through the passed point, change slope and direction if required
--  tidy()                           -                   Remove aid graphics
--  towards(POSITION)                -                   Define direction on the screed plane of the slope towards a the passed position
--  type(STRING)                     -                   Set slope type
--
------------------------------------------------------------------------

define object CVLSCREEDSLOPE

  -- Slope Type (Straight or Conical)
  member .type           is STRING

  -- Screed
  member .screed         is DBREF
  member .screedLoop     is DBREF

  -- Floor plane (orientated about the Z axes of screen, X in the direction of the slope rotation line)
  member .screedPlane    is PLANE

  -- Bottom of screed
  member .bottomPlane    is PLANE

  -- Angle Plane
  member .anglePlane     is PLANE

  -- Negative extrusion
  member .negative       is DBREF
  member .negativeLoop   is DBREF

  -- Conical Plane
  member .conicalPlane   is PLANE

  -- Slope plane
  member .negativePlane  is PLANE

  -- Slope Data
  -- Angle from screed plane to slope surface
  member .angle          is REAL

  -- Reference Plane (surface plane of slope)
  member .surfacePlane   is PLANE

  -- Through position
  member .through        is POSITION

  -- Bounding Box
  member .extremities    is ARRAY

  -- Point Rotation Mode
  member .rotationType   is STRING

  -- Rotation Line
  member .rotationLine   is LINE

  -- Offset (distance about the extremities)
  member .offset         is REAL

  -- Aid Number
  member .aidNumber      is REAL

  -- Private Members for passing data about
  member .extrusion      is ARRAY
  member .height         is REAL

endobject
-- End of object definition for CVLSCREEDSLOPE

----------------------------------------------------------------------
--
-- Method:      cvlScreedSlope
--
-- Description: Constructor, using passed floor to define boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Floor Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cvlScreedSlope()

  -- Initialise Variables
  !this.type      = 'STRAIGHT'
  !this.offset    = 100mm
  !this.angle     = 2

  -- Aid Number
  !this.aidNumber = !!aidNumbers.add('Sloped Screed')

endmethod
-- End of method definition for .cvlScreedSlope()

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Constructor, using passed floor to define boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Floor Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .setup(!screed is DBREF) is BOOLEAN

  -- Initialise Variables
  !reference = !!ce


  -- If a floor has not been passed, return
  if(not !screed.fullType inset('SCREED')) then
    !!error.text = !screed.flnn & ' must be a "Screed" element.'
    return false
  endif

  -- Hide old graphics
  !this.tidy()

  -- Floor
  !!ce                   = !screed
  !this.screed           = !screed

  -- Get Loop 1 of floor
  !this.screedLoop       = !!dtbMemberOfType(!!ce,'PLOO',1)
  !this.bottomPlane      = !!edgTypes.screed.plane(!this.screed ,'bottom')

  -- Initialise Defaults
  !this.through          = object POSITION()

  -- Derive from current element
  if(!this.derive().not()) then

    -- Define Reference Plane
    !this.plane(object PLANE(!screed.position, !screed.orientation))

    -- Rotation about a point
    !this.rotationType   = 'POINT'

  endif

  !!ce                   = !reference
  return true

endmethod
-- End of method definition for .setup(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      derive
--
-- Description: Derive definition with exiting data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop exists
--
------------------------------------------------------------------------

define method .derive() is BOOLEAN

  -- Initialise Variables
  !this.negative      = object DBREF()
  !this.negativeLoop  = object DBREF()

  -- Rotation about a point
  !this.rotationType  = 'POINT'
  !this.type          = 'STRAIGHT'

  -- Get Negative extrusion with function of "SLOPE"
  var !collection COLLECT ALL NXTR WITH (FUNCTION eq 'SLOPE') FOR $!<this.screed>

  -- Derive the type of straight slope from the negative extrusion
  if(!collection.empty().not()) then

    -- Set negative loop
    !this.negative       = !collection[1].dbref()

    -- Get Loop of the negative
    !negativeLoop        = !!dtbMemberOfType(!this.negative,'LOOP',1)

    -- If loop is define, then try and derive the data
    if(!negativeLoop.set()) then

      -- Negative loop
      !this.negativeLoop = !negativeLoop

      -- Determine if we are a slope to a point or edge slope

      -- Slope to a point, is where the Y direction of the negative is parallel to the screed
      if(!this.negative.orientation.yDir().isParallel(!this.bottomPlane.direction())) then

        -- We need to map the negative loop position onto the plane defined by the loop members
        !direction = !this.negative.pDirection[1].opposite()
        !offset    = !this.negativeLoop.members[1].position.up
        !origin    = !this.negative.position.offset(!direction, !offset)
        !plane     = object PLANE(!origin, object ORIENTATION('Y is ' & !this.negative.orientation.xdir() & ' and Z is ' & !this.bottomPlane.direction()))
        !line      = object LINE(!this.negativeLoop.members[1].position, !this.negativeLoop.members[2].position)
        !angle     = !plane.orientation.yDir().angle(!line.direction())

      -- Derive whether we are looking at a sloped screed about an edge
      else

        -- Negative as a plane
        !xDirection         = !this.negative.orientation.xdir()
        !yDirection         = !this.negative.orientation.yDir()
        !zDirection         = !this.negative.orientation.zDir()

        !this.rotationType  = 'EDGE'

        -- Slope line
        !slopeLine          = object LINE(!this.negativeLoop.members[1].position, !this.negativeLoop.members[2].position)

        -- Project the negative position onto the slope line (this is the plane origin)
        !planeOrigin        = !slopeLine.near(!this.negative.position)

        -- Rotation Line
        !this.rotationLine  = object LINE(!planeOrigin, !planeOrigin.offset(!zDirection, 1000mm))

        -- Surface plane
        --!unusedSurfacePlane       = object PLANE(!planeOrigin, object ORIENTATION('Y is ' & !xDirection & ' and X is '  & !zDirection))

        -- Define plane
        !direction          = !this.rotationLine.direction().projected(!this.bottomPlane)
        !plane              = object PLANE(!planeOrigin, object ORIENTATION('X is ' & !direction & ' and Z is ' & !this.bottomPlane.direction()))

        -- Angle Plane
        !aPlane             = object PLANE(!planeOrigin, object ORIENTATION('X is ' & !plane.orientation.yDir() & ' and Y is ' & !this.bottomPlane.direction()))

        -- Project the second point in the negative direction onto the angle plane
        !xyPosition         = !aPlane.xyOffset(!aPlane.intersection(object POINTVECTOR(!this.negativeLoop.members[2].position, !zDirection)))

        -- Start of slope line onto aPlane
        !angle              = ATAN(!xyPosition.y / !xyPosition.x)

      endif

      -- Set Angle
      !this.angle = !angle

      -- Set the plane
      !this.plane(!plane)

      return true

    endif

  -- Check for conical slopes
  else

    -- Get negative solids of revolution
    var !collection COLLECT ALL NREV FOR $!<this.screed>

    -- Check if there is a NREV that conforms to the "SLOPE" type
    if(!collection.empty().not()) then

      -- Rules = X direction is the same as Z of screed
      --         There are only four vertices that define the extrusion
      --         The first point is at 0,0,0
      !valid = false
      do !i indices !collection

        -- Get dbref pointer
        !revolution = !collection[!i].dbref()

        -- Ignore if X is not parallel to Z of owner
        skip if(!this.screed.orientation.zDir().isParallel(!revolution.orientation.xdir()).not())

        -- Ignore if there are not 4 vertices
        skip if(!revolution.members[1].mcount ne 4)

        -- Ignore if first item is not at 0,0,0
        skip if(!revolution.members[1].members[1].position.near(!revolution.position,1mm).not())

        -- Assume we have a conical slope

        -- Set negative loop
        !this.negative     = !revolution

        -- Get Loop of the negative
        !this.negativeLoop = !revolution.members[1]

        !valid = true
        break
      enddo

      -- If valid negative solids of revolution, get data
      if(!valid) then

        -- Conical slope
        !this.type = 'CONICAL'

        -- We need to map the negative loop position onto the plane defined by the loop members
        !origin    = !this.negative.pPosition[1]
        !plane     = object PLANE(!origin, object ORIENTATION('Y is ' & !this.negative.orientation.yDir() & ' and Z is ' & !this.bottomPlane.direction()))
        !line      = object LINE(!this.negativeLoop.members[1].position, !this.negativeLoop.members[2].position)
        !angle     = !plane.orientation.yDir().angle(!line.direction())

        -- Set Angle
        !this.angle = !angle

        -- Set the plane
        !this.plane(!plane)

        return true
      endif
    endif
  endif

  return false

endmethod
-- End of method definition for .derive() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Remove aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw basic slop
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Initialise Variables

  -- Remove old Aid graphics
  !!aidNumbers.hide(!this.aidNumber)

--   --Plane
--   !gPlane        = object GPHPLANE(!this.anglePlane)
--   !gPlane.detail = true
--   !gPlane.draw(!this.aidNumber)

  -- Draw straight for slope
  if(!this.type eq 'STRAIGHT') then

    -- Map the position of the extremities[1] & [4] onto the angle plane
    -- Straight Slope
    !xyPosition[1]   = !this.anglePlane.xyOffset(!this.extremities[1])
    !xyPosition[2]   = !this.anglePlane.xyOffset(!this.extremities[4])

    -- Offset for the angle
    !xyPosition[1].y = !xyPosition[1].x * tan(!this.angle)
    !xyPosition[2].y = !xyPosition[2].x * tan(!this.angle)

    -- Derive line from the extremity positions
    !slopeLine       = !this.anglePlane.threeDPosition(!xyPosition[1]).line(!this.anglePlane.threeDPosition(!xyPosition[2]))

    -- Projected Bottom Line
    !bottomLine     = !slopeLine.projected(!this.bottomPlane)

    -- Resultant positive extrusion in screed Y plane
    AID LINE NUMBER $!<this.aidNumber> $!<slopeLine.startPosition>  TO $!<slopeLine.endPosition>
    AID LINE NUMBER $!<this.aidNumber> $!<bottomLine.startPosition> TO $!<bottomLine.endPosition>
    AID LINE NUMBER $!<this.aidNumber> $!<slopeLine.endPosition>    TO $!<bottomLine.endPosition>
    AID LINE NUMBER $!<this.aidNumber> $!<slopeLine.startPosition>  TO $!<bottomLine.startPosition>

    -- Draw rotation point
    if(!this.rotationType eq 'POINT') then
      AID TEXT NUMBER $!<this.aidNumber> 'Origin' AT $!<this.surfacePlane.position>
    else
      !midPoint = !this.rotationLine.proportion(0.5)
      AID TEXT NUMBER $!<this.aidNumber> 'Rotation Line' AT $!<midPoint>

      AID LINE NUMBER $!<this.aidNumber> $!<this.rotationLine.startPosition>  TO $!<this.rotationLine.endPosition>
    endif

  -- Draw Conical slope
  else

    -- Map the position of the extremities[1] & [4] onto the angle plane
    -- Straight Slope
    !xyPosition[1]   = object XYPOSITION(0,0)
    !xyPosition[2]   = !this.anglePlane.xyOffset(!this.extremities[4])

    -- Offset for the angle
    !xyPosition[2].y = !xyPosition[2].x * tan(!this.angle)

    -- Derive line from the extremity positions
    !slopeLine       = !this.anglePlane.threeDPosition(!xyPosition[1]).line(!this.anglePlane.threeDPosition(!xyPosition[2]))

    -- Projected Bottom Line
    !bottomLine     = !slopeLine.projected(!this.bottomPlane)

    -- Resultant positive extrusion in screed Y plane
    AID LINE NUMBER $!<this.aidNumber> $!<slopeLine.startPosition>  TO $!<slopeLine.endPosition>
    AID LINE NUMBER $!<this.aidNumber> $!<bottomLine.startPosition> TO $!<bottomLine.endPosition>
    AID LINE NUMBER $!<this.aidNumber> $!<slopeLine.endPosition>    TO $!<bottomLine.endPosition>
    AID LINE NUMBER $!<this.aidNumber> $!<slopeLine.startPosition>  TO $!<bottomLine.startPosition>

    -- Origin
    AID TEXT NUMBER $!<this.aidNumber> 'Origin' AT $!<this.surfacePlane.position>

  endif

  -- Slope Direction Arrow
  !slopeDirection  = !slopeLine.direction().opposite()
  !length          = MIN(!slopeLine.length() * 0.25, 1000mm)
  !midPoint        = !slopeLine.proportion(0.5)
  !midPoint        = !midPoint.offset(!slopeDirection.opposite(), !length)
  AID ARROW NUMBER $!<this.aidNumber> AT $!<midPoint> DIRECTION $!<slopeDirection> HEIGHT $!<length>

  -- Screed Direction Arrow
  !screedDirection = !this.screedPlane.orientation.yDir()
  !length          = MIN(!bottomLine.length() * 0.25, 500)
  !midPoint        = !bottomLine.proportion(0.5)
  AID ARROW NUMBER $!<this.aidNumber> AT $!<midPoint> DIRECTION $!<screedDirection> HEIGHT $!<length>
  !midPoint        = !midPoint.offset(!screedDirection, !length)
  AID TEXT NUMBER  $!<this.aidNumber> 'Screed Direction' AT $!<midPoint>

  -- Calculate slope arc
  if(!bottomLine.direction().angle(!slopeLine.direction()) le 0.01) then
    !origin       = !bottomLine.startPosition
  else
    !origin       = !bottomLine.intersection(!slopeLine)
  endif

  -- Determine the furthest end of the bottom line
  if(!origin.distance(!bottomLine.startPosition) gt !origin.distance(!bottomLine.endPosition)) then
    !topEnd       = !slopeLine.startPosition
    !bottomEnd    = !bottomLine.startPosition
  else
    !topEnd       = !slopeLine.endPosition
    !bottomEnd    = !bottomLine.endPosition
  endif

  !orientation    = object ORIENTATION('Y is ' & !bottomEnd.direction(!topEnd) & ' and X is ' & !origin.direction(!bottomEnd))
  !radius         = !origin.distance(!bottomLine.proportion(0.5))
  if(!radius lt 1mm) then
    !radius = 1000mm
  endif
  !arc            = object ARC(!origin, !orientation, 0, !this.angle, !radius, true)

  -- Draw slope arc
  !max            = 6
  !angle          = !this.angle.abs()
  !segment        = !angle / !max
  !from           = !arc.anglePosition(0)
  do !i from 1 to !max
    !to           = !arc.anglePosition(!segment * !i)
    AID LINE NUMBER $!<this.aidNumber> $!<from> TO $!<to>
    !from         = !to
  enddo

  -- Tag angle
  !position       = !arc.anglePosition(!angle / 2)
  AID TEXT NUMBER $!<this.aidNumber> '$!this.angle' AT $!<position>

  -- Tag through point
  if(!this.through.set()) then
    !through      = !this.through()
    AID TEXT NUMBER $!<this.aidNumber> 'Through' AT $!<through>

    -- If the through position does not lie on the line, then we need to
    -- draw some information lines, etc
    if(!slopeLine.near(!through).near(!through, 5mm).not()) then

      -- Map through point onto bottom plane
      !bottomPoint = !this.bottomPlane.near(!through)
      AID LINE NUMBER $!<this.aidNumber> $!<origin> TO $!<bottomPoint>
      AID LINE NUMBER $!<this.aidNumber> $!<origin> TO $!<through>

      !orientation    = object ORIENTATION('Y is ' & !bottomPoint.direction(!through) & ' and X is ' & !origin.direction(!bottomPoint))
      !position       = !origin.line(!bottomPoint).proportion(0.75)
      !radius         = !origin.distance(!position)
      !angle          = !origin.angle(!bottomPoint, !through)
      !arc            = object ARC(!origin, !orientation, 0, !this.angle, !radius, true)

      -- Draw slope arc
      !max            = 6
      !segment        = !angle / !max
      !from           = !arc.anglePosition(0)
      do !i from 1 to !max
        !to           = !arc.anglePosition(!segment * !i)
        AID LINE NUMBER $!<this.aidNumber> $!<from> TO $!<to>
        !from         = !to
      enddo

      -- Tag angle
      !position       = !arc.anglePosition(!angle / 2)
      AID TEXT NUMBER $!<this.aidNumber> '($!angle)' AT $!<position>

    endif

  endif

--   -- Draw the extrusion boundary
--   !this.extrusion()
--   !from    = !this.extrusion[4]
--   do !i indices !this.extrusion
--     !to    = !this.extrusion[!i]
--     AID LINE NUMBER $!<this.aidNumber> $!<from> TO $!<to>
--     AID TEXT NUMBER $!<this.aidNumber> '$!i' AT $!<to>
--     !from  = !to
--   enddo
--
--   -- Draw the extremities
--   !from    = !this.extremities[4]
--   do !i indices !this.extremities
--     !to    = !this.extremities[!i]
--     AID LINE NUMBER $!<this.aidNumber> $!<from> TO $!<to>
--     !from  = !to
--   enddo

endmethod
-- End of method definition for .draw()

------------------------------------------------------------------------
--
-- Method:      type
--
-- Description: Set slope type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Slope type (STRAIGHT or CONICAL)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .type(!type is STRING)

  -- Initialise Variables
  !newType   = !type.upcase()

  -- Ignore swapping to the same type
  if(!newType eq !this.type) then
    return
  endif

  !this.type = !newType

  if(!type eq 'CONICAL') then
    !this.rotationLine = object LINE()
    !this.rotationType = 'POINT'
  endif

  -- Recalculate
  !this.extremities()

endmethod
-- End of method definition for .type(STRING)

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Set planes (passed plane is screed plane)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Screed plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plane(!plane is PLANE)

  -- Initialise Variables
  !this.screedPlane    = !plane

  -- Offset Position
  !offset              = TAN(!this.angle) * 1000mm
  !offsetPosition      = !this.screedPlane.threeDPosition(object XYPOSITION(0,1000mm)).offset(!this.screedPlane.direction(), !offset)

  -- Rotation about a point
  if(!this.rotationType eq 'POINT') then

    -- Get direction of reference plane
    !xDirection        = !plane.orientation.xdir()
    !yDirection        = !plane.position.direction(!offsetPosition)

    -- Define reference plane
    !this.surfacePlane        = object PLANE(!plane.position, object ORIENTATION('X is ' & !xDirection & ' and Y is ' & !yDirection))

  -- Rotation about a line
  else

    -- Move reference line through the plane position
    !this.rotationLine = !plane.position.line(!plane.position.offset(!this.rotationLine.direction(), 1000mm))

    -- Derive new plane
    !newPlane          = !plane.position.plane(!offsetPosition, !this.rotationLine.endPosition)
    !xDirection        = !this.rotationLine.direction()
    !zDirection        = !newPlane.direction()

    -- If the angle between the new plane and the screed plane is > 90, then
    -- we invert the X and Z directions
    if(!zDirection.angle(!this.screedPlane.direction()) gt 90) then
      !zDirection      = !zDirection.opposite()
    endif

    !this.surfacePlane = object PLANE(!plane.position, object ORIENTATION('X is ' & !xDirection & ' and Z is ' & !zDirection))

  endif

  -- Set through point
  !this.setThrough()

  -- Define slope plane (plane of the extrusion)
  !this.negativePlane()

  -- Angle Plane
  !this.anglePlane     = object PLANE(!this.surfacePlane.position, object ORIENTATION('X is ' & !this.screedPlane.orientation.yDir() & ' and Y is ' & !this.screedPlane.orientation.zDir()))

  -- Derive the extremities
  !this.extremities()

endmethod
-- End of method definition for .plane(PLANE)

------------------------------------------------------------------------
--
-- Method:      negativePlane
--
-- Description: Sets the negative plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .negativePlane() is PLANE

  -- Rotation about a point, then the plane's X is the same as the screed plane's Y
  if(!this.rotationType eq 'POINT') then
    !this.negativePlane = object PLANE(!this.surfacePlane.position, object ORIENTATION('Y is ' & !this.screedPlane.direction() & ' and Z is ' & !this.screedPlane.orientation.xdir()))

  -- Rotation line, then X is in the screed plane's Y
  else
    !this.negativePlane = object PLANE(!this.surfacePlane.position, object ORIENTATION('Y is ' & !this.surfacePlane.direction() & ' and Z is ' & !this.surfacePlane.orientation.xdir()))
  endif

endmethod
-- End of method definition for .negativePlane() PLANE

------------------------------------------------------------------------
--
-- Method:      extremities
--
-- Description: Returns the extremities of the loop definition (using the points)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extremities()

  -- Initialise Variables
  !extension    = !this.offset
  !this.extremities.clear()

  -- Loop through each point of the loop
  do !i indices !this.screedLoop.members
    !xyPosition = !this.screedPlane.xyOffset(!this.screedLoop.members[!i].position)
    !x[!i]      = !xyPosition.x
    !y[!i]      = !xyPosition.y
  enddo

  -- Sort into order
  !x.sort()
  !y.sort()

  -- Return array
  -- Straight Slope extremities
  if(!this.type eq 'STRAIGHT') then
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x[1] - !extension,     !y[1] - !extension)))
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x.last() + !extension, !y[1] - !extension)))
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x.last() + !extension, !y.last() + !extension)))
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x[1] - !extension,     !y.last() + !extension)))
  else
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x[1] - !extension,     !y[1] - !extension)))
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x.last() + !extension, !y[1] - !extension)))
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x.last() + !extension, !y.last() + !extension)))
    !this.extremities.append(!this.screedPlane.threeDPosition(object XYPOSITION(!x[1] - !extension,     !y.last() + !extension)))
  endif

  -- Define extrusion
  !this.draw()

endmethod
-- End of method definition for .extremities()

------------------------------------------------------------------------
--
-- Method:      slope
--
-- Description: Returns the slope angle from screed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Slope form screed plane
--
------------------------------------------------------------------------

define method .slope() is REAL
  return !this.angle
endmethod
-- End of method definition for .slope() REAL

------------------------------------------------------------------------
--
-- Method:      slope
--
-- Description: Define slope angle from screed plane (changing the slop only changes the plane and negative plane)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Slope form screed plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slope(!angle is REAL)

  -- Initialise Variables
  !this.angle     = !angle

  -- Calculate the direction of the reference plane
  !offset         = TAN(!this.angle) * 1000mm
  !offsetPosition = !this.screedPlane.threeDPosition(object XYPOSITION(0,1000mm)).offset(!this.screedPlane.direction(), !offset)

  -- X position on reference plane (as X axes should be the same, regardless
  -- of slope we can use the plane in any start)
  !xPosition      = !this.surfacePlane.threeDPosition(object XYPOSITION(1000mm, 0))

  -- Y position on new reference plane
  !yPosition      = !this.screedPlane.threeDPosition(object XYPOSITION(0, 1000mm)).offset(!this.screedPlane.direction(), !offset)

  -- New plane
  !plane          = !this.surfacePlane.position.plane(!xPosition, !yPosition)

  !this.surfacePlane.orientation = object ORIENTATION('Z is ' & !plane.direction() & ' and X is ' & !this.surfacePlane.orientation.xdir())

  -- Set through point
  !this.setThrough()

  -- Set negative plane
  !this.negativePlane()

  -- Extrusion
  !this.draw()

endmethod
-- End of method definition for .slope(REAL)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Returns direction on the screed plane of the slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Primary direction of slope
--
------------------------------------------------------------------------

define method .direction() is DIRECTION
  return !this.screedPlane.orientation.yDir()
endmethod
-- End of method definition for .direction() DIRECTION

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Define direction on the screed plane of the slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Primary direction of slope
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Ignore direction, when rotation about a line
  if(!this.rotationType ne 'POINT') then
    !!alert.warning('Can only direct slopes which are defined about a point origin.')
    return
  endif

  -- Map direction onto screed plane
  !screedDirection   = !direction.projected(!this.screedPlane)

  -- Derive new orientation of the plane
  !plane             = !this.screedPlane
  !plane.orientation = object ORIENTATION('Y is ' & !screedDirection & ' and Z is ' & !this.screedPlane.direction())

  -- Unset the through position, as it has no meaning
  --!this.through      = object POSITION()

  -- Update planes
  !this.plane(!plane)

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      towards
--
-- Description: Define direction on the screed plane of the slope towards a the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to be mapped onto screed plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .towards(!position is POSITION)

  -- Ignore direction, when rotation about a line
  if(!this.rotationType ne 'POINT') then
    !!alert.warning('Can only direct slopes towards a point which are defined about a point origin.')
    return
  endif

  -- Map position onto screed plane
  !newPosition       = !this.screedPlane.near(!position)

  -- New direction
  !direction         = !this.screedPlane.position.direction(!newPosition)

  -- Define new direction
  !this.direction(!direction)

endmethod
-- End of method definition for .towards(POSITION)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Returns position on the screed plane of the slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION   Primary position of slope
--
------------------------------------------------------------------------

define method .position() is POSITION
  return !this.screedPlane.position
endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Define slope position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Start of slope as a position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Initialise Variables
  !this.rotationType = 'POINT'
  !this.rotationLine = object LINE()
  !plane             = !this.screedPlane
  !plane.position    = !position
  !through           = !this.through
  !this.through      = object POSITION()

  -- Modify position of planes
  !this.plane(!plane)

  -- Modify position of plane and maintain through point
  if(!through.set()) then
    !this.through(!through, true)
  endif

endmethod
-- End of method definition for .position(POSITION)

------------------------------------------------------------------------
--
-- Method:      setThrough
--
-- Description: Recalculates the set through point onto the current plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setThrough()

  -- Initialise Variables

  -- If the through point is set, project in screed direction onto the plane
  if(!this.through.set()) then

    -- Point vector
    !pointVector  = object POINTVECTOR(!this.through, !this.screedPlane.direction())

    -- Intersect with reference plane
    !this.through = !this.surfacePlane.intersection(!pointVector)

  endif

endmethod
-- End of method definition for .setThrough()

------------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Returns a through point on the slope surface (if unset through point, an point 1M from origin will be returned)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Through point of slope
--
------------------------------------------------------------------------

define method .through() is POSITION

  -- Initialise Variables
  !position = object POSITION()

  -- If there is no through point, then calculate one
  if(!this.through.unset()) then

    -- Position on the Y of the screed plane
    !yPosition = !this.screedPlane.threeDPosition(object XYPOSITION(0, 1000mm ))

    -- Position on slope is intersection of point vector from Y position in
    -- direction of screed panel with the slope plane
    !position  = !this.surfacePlane.intersection(object POINTVECTOR(!yPosition, !this.screedPlane.direction()))

  -- Use current setting
  else
    !position = !this.through
  endif

  -- Return
  return !position

endmethod
-- End of method definition for .through() POSITION

------------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Move slope through the passed point, change slope and direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Point on slope
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .through(!position is POSITION)

  -- Set through point, changing direction if possible
  !this.through(!position, false)

endmethod
-- End of method definition for .through(POSITION)

------------------------------------------------------------------------
--
-- Method:      through
--
-- Description: Move slope through the passed point, change slope and direction if required
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Point on slope
--    2   R      BOOLEAN     Maintain direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .through(!position is POSITION, !directionLock is BOOLEAN)

  -- Rotation about a point
  if(!this.rotationType eq 'POINT' and !directionLock.not()) then

    -- Update through point
    !this.through    = object POSITION()

    -- Direction from screed position
    !direction       = !this.screedPlane.position.direction(!position)

    -- Get Direction onto screed plane
    !screedDirection = !direction.projected(!this.screedPlane)

    -- Angle Plane
    !anglePlane      = object PLANE(!this.screedPlane.position, object ORIENTATION('X is ' & !screedDirection & ' and Y is ' & !this.screedPlane.direction()))

    -- Position in terms of XY on angle plane
    !xyPosition      = !anglePlane.xyOffset(!position)

    -- Angle
    !this.angle      = ATAN(!xyPosition.y / !xyPosition.x)

    -- Derive screed plane
    !plane           = object PLANE(!this.screedPlane.position, object ORIENTATION('Y is ' & !screedDirection & ' and Z is ' & !this.screedPlane.direction()))

    -- Update Plane
    !this.plane(!plane)

  -- Direction is locked or rotate about a line
  else

    -- Update through point
    !this.through  = !position

    -- X position on reference plane (as X axes should be the same, regardless
    -- of slope we can use the plane in any start)
    !xPosition     = !this.surfacePlane.threeDPosition(object XYPOSITION(1000mm, 0))

    -- Reference plane, through the three positions
    !plane         = !this.surfacePlane.position.plane(!xPosition, !position)

    -- Derive point vector at Y 1000 on the screed plane (in the screed direction)
    !yPosition     = !this.screedPlane.threeDPosition(object XYPOSITION(0, 1000mm))
    !pointVector   = object POINTVECTOR(!yPosition, !this.screedPlane.direction())

    -- Project the y position in the direction of the screed onto the reference plane
    !iPosition     = !plane.intersection(!pointVector)

    -- Derive angle
    !angle         = !this.screedPlane.position.angle(!yPosition, !iPosition)

    -- If angle between the screed direction and yPosition to iPosition is
    -- not equal to zero, then we have a negative angle
    if(!pointVector.direction.angle(!yPosition.direction(!iPosition)) ne 0) then
      !angle = !angle * -1
    endif

    -- Update slope
    !this.slope(!angle)

  endif

endmethod
-- End of method definition for .through(POSITION, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      edge
--
-- Description: Make x axes of plane the rotation axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Edge of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edge(!line is LINE)

  -- Initialise Variables
  !this.rotationType   = 'EDGE'
  !newLine             = object LINE(!line.startPosition.wrt(!this.screed), !line.endPosition.wrt(!this.screed))

  -- Always take the lower end to be the start of the line
  if(!newLine.startPosition.up lt !newLine.endPosition.up) then
    !this.rotationLine = !line
  else
    !this.rotationLine = !line.reverseSense()
  endif

  -- Define plane relative to the passed edge
  -- Map Sloop X direction onto screed plane
  !xDirection = !this.rotationLine.direction().projected(!this.screedPlane)
  !plane      = object PLANE(!this.rotationLine.startPosition, object ORIENTATION('Z is ' & !this.screedPlane.direction() & ' and X is ' & !xDirection))

  -- Update plane
  !this.plane(!plane)

endmethod
-- End of method definition for .edge(LINE)

------------------------------------------------------------------------
--
-- Method:      define
--
-- Description: Define slope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN    True if created
--
------------------------------------------------------------------------

define method .define() is BOOLEAN

  -- Initialise Variables
  !reference = !!ce

  -- Derive the extrusion
  !this.extrusion()

  -- Set floor height
  !!ce    = !this.screedLoop
  !height = !this.height
  HEIGHT $!<height>

  -- If negative is wrong for slope type, then we will delete it
  if(!this.negative.set()) then

    if(!this.negative.type eq 'NXTR' and !this.type eq 'CONICAL') then
      !!ce               = !this.negative
      DELETE NXTR
      !this.negative     = object DBREF()
      !this.negativeLoop = object DBREF()

    elseif (!this.negative.type eq 'NREV' and !this.type eq 'STRAIGHT') then
      !!ce               = !this.negative
      DELETE NREV
      !this.negative     = object DBREF()
      !this.negativeLoop = object DBREF()

    endif
  endif


  -- If there is no extrusion collected, then we need to define one
  if(!this.negative.unset()) then

    -- Move to floor
    !!ce                 = !this.screed

    -- Create Straight Slope
    if(!this.type eq 'STRAIGHT') then
      NEW NXTR FUNCTION 'SLOPE'

    -- Create Conical Slope
    else
      NEW NREV
    endif

    !this.negative       = !!ce
    NEW LOOP
    !this.negativeLoop   = !!ce

  -- Use first negative extrusion
  else

    -- Create Loop
    if(!this.negativeLoop.unset()) then

      NEW LOOP
      !this.negativeLoop = !!ce
    endif

  endif

  !newVertex   = !this.negativeLoop.members.size().neq(4)

  -- Orientate the negative in the slope plane
  !!ce         = !this.negative

  if(!this.type eq 'STRAIGHT') then

    -- Define plane normal to the screed plane
    !newPlane     = object PLANE(!this.negativePlane.position, object ORIENTATION('Z is ' & !this.screedPlane.orientation.yDir() & ' and Y is ' & !this.negativePlane.direction()))

    -- Convert the extremities of the positive extrusion on the a plane normal to the screed plane
    !position[1]  = !newPlane.near(!this.bottomPlane.near(!this.extremities[1]))
    !position[2]  = !newPlane.near(!this.bottomPlane.near(!this.extremities[2]))
    !position[3]  = !position[2].offset(!this.screedPlane.direction(), !this.height)
    !position[4]  = !position[1].offset(!this.screedPlane.direction(), !this.height)

    -- Convert the position into XY's on the new plane
    do !i indices !position
      !xyPosition = !newPlane.xyOffset(!position[!i])
      !x[!i]      = !xyPosition.x
      !y[!i]      = !xyPosition.y
    enddo

    -- Sort Y into order
    !y.sort()

    -- Derive a line from between the extremities
    !line         = !newPlane.threeDPosition(object XYPOSITION(0, !y[1])).line(!newPlane.threeDPosition(object XYPOSITION(0, !y.last())))

    -- Extend the ends by the offset
    !line         = !line.extendEnd(!this.offset)
    !line         = !line.extendStart(!this.offset)

    !plane        = object PLANE(!line.startPosition, !this.negativePlane.orientation)
    !height       = !line.length()
    HEIGHT      $!<height>

  else
    !plane        = object PLANE(!this.screedPlane.position, object ORIENTATION('X is ' & !this.screedPlane.direction() & ' and Y is ' & !this.screedPlane.orientation.yDir()))
    ANGLE 360
  endif

  -- Set Position and orientation
  ORIENTATION $!<plane.orientation>
  POSITION    $!<plane.position>

  -- Build loop
  !!ce        = !this.negativeLoop

  -- Define vertices
  do !i indices !this.extrusion

    if(!newVertex) then
      NEW VERT
    else
      !!ce    = !this.negativeLoop.members[!i]
      handle any
        !!alert.warning('Negative loop has been modified using some other utility, other than the screed slope utility.')
        return false
      endhandle
    endif

    -- Position vertex
    POSITION $!<this.extrusion[$!<i>]>

  enddo

  !!ce = !reference
  handle any
    !!ce = !this.screed
  endhandle

  -- Return
  return true

endmethod
-- End of method definition for .define() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      extrusion
--
-- Description: Derive the negative extrusion points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extrusion()

  -- If angle is zero, then return
  if(!this.angle eq 0) then
    return ARRAY()
  endif

  -- Initialise Variables
  !offset      = !this.offset

  -- Default direction of point vectors
  !direction   = !this.screedPlane.direction().projected(!this.negativePlane)

  -- Straight Extrusion
  if(!this.type eq 'STRAIGHT') then

    -- Define point vectors at extremities of the boundary
    !minimumPV   = object POINTVECTOR(!this.negativePlane.near(!this.extremities[1]), !direction)
    !maximumPV   = object POINTVECTOR(!this.negativePlane.near(!this.extremities[4]), !direction)

    -- First Point and second point are the extremities mapped onto the surface plane
    !points[1]   = !this.surfacePlane.intersection(!minimumPV).wrt(!this.screed)
    !points[2]   = !this.surfacePlane.intersection(!maximumPV).wrt(!this.screed)

    -- Extremities mapped onto bottom plane
    !positionA   = !this.bottomPlane.near(!this.extremities[1])
    !positionB   = !this.bottomPlane.near(!this.extremities[4])

    -- If the rotation is about a line, then potentially the we need to
    -- recalculate the offset. So that the negative extrusion remove all of
    -- the positive.
    if(!this.rotationType ne 'POINT') then

      -- Derive the height of the screed loop
      !this.extrusion = !points

      -- End Plane
      !xDirection     = !this.screedPlane.orientation.yDir()
      !zDirection     = !this.extremities[1].direction(!this.extremities[2])
      !endPlane       = object PLANE(!this.extremities[2], object ORIENTATION('X is ' & !xDirection & ' and Z is ' & !zDirection))

      -- Point[1] projected on to the end plane
      !lineA          = object LINE(!this.extrusion[1], !endPlane.intersection(object POINTVECTOR(!this.extrusion[1], !this.negativePlane.direction())))
      !lowPointA      = !this.bottomPlane.near(!lineA.endPosition)

      -- Point[2] projected on to the end plane
      !lineB          = object LINE(!this.extrusion[2], !endPlane.intersection(object POINTVECTOR(!this.extrusion[2], !this.negativePlane.direction())))
      !lowPointB      = !this.bottomPlane.near(!lineB.endPosition)

      -- Height
      !this.height    = !lowPointA.distance(!lineA.endPosition).max(!lowPointB.distance(!lineB.endPosition))
      -- !this.height()

      -- Derive upper extend position on the end plane
      !position1      = !this.negativePlane.near(!positionA.offset(!this.bottomPlane.direction(), !this.height))
      !position2      = !this.negativePlane.near(!positionB.offset(!this.bottomPlane.direction(), !this.height))

      -- Derive the minimum offset
      !offset         = !points[1].distance(!position1).min(!points[2].distance(!position2)) + !this.offset

      -- Determine the direction of the slope
      -- Slope Up
      if(!points[1].up gt !points[2].up) then
        !points[4]    = !points[1].offset(!direction, !offset).wrt(!this.screed)
        !points[3]    = !maximumPV.through(!points[4]).position

      -- Slope Down
      else
        !points[3]    = !points[2].offset(!direction, !offset).wrt(!this.screed)
        !points[4]    = !minimumPV.through(!points[3]).position.wrt(!this.screed)
      endif

      -- Remember extrusion
      !this.extrusion = !points

    else

      -- Determine the direction of the slope
      -- Slope Up
      if(!points[1].up gt !points[2].up) then
        !points[4]    = !points[1].offset(!direction, !offset).wrt(!this.screed)
        !points[3]    = !maximumPV.through(!points[4]).position

      -- Slope Down
      else
        !points[3]    = !points[2].offset(!direction, !offset).wrt(!this.screed)
        !points[4]    = !minimumPV.through(!points[3]).position.wrt(!this.screed)
      endif

      -- Remember extrusion
      !this.extrusion = !points

      -- Derive height
      !this.height    = !this.bottomPlane.near(!this.extrusion[4]).distance(!this.extrusion[4])
       --!this.height()

    endif

  -- Conical Slope
  else

    -- Determine the point longest dimension
    do !i indices !this.extremities
      !distances[!i] = !this.screedPlane.position.distance(!this.extremities[!i])
    enddo
    !distances.sort().invert()

    -- Define the points
    !points[1] = !this.negativePlane.threeDPosition(object XYPOSITION(0,0))
    !points[2] = !this.negativePlane.threeDPosition(object XYPOSITION(!distances[1],!distances[1] * !this.angle.tangent()))
    !points[3] = !this.negativePlane.threeDPosition(object XYPOSITION(!distances[1],!distances[1] * !this.angle.tangent() + !this.offset))
    !points[4] = !this.negativePlane.threeDPosition(object XYPOSITION(0,!distances[1] * !this.angle.tangent() + !this.offset))

    -- Remember extrusion
    !this.extrusion = !points

    -- Height
    !this.height    = !this.bottomPlane.near(!this.extrusion[4]).distance(!this.extrusion[4]) - !this.offset

  endif

endmethod
-- End of method definition for .extrusion()
