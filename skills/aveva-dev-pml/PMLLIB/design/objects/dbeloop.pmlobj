-- File:            dbeloop.pmlobj
--   Type:          Object Definition
--   Group:         Database routines

--     Keyword:     DTB
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Oct 13 9:00:53 BST 1999
--
--
-- Description:
-- Generic Design loop editing object.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjacent(REAL)                   ARRAY               Return edge at the passed
--  bestIntersection(ARC,ARC)        POSITION            Return (via arg list) the modified passed arc for the intersection
--  bestIntersection(ARC,LINE)       POSITION            Returns the best intersection point between the passed arc and line
--  bestIntersection(LINE,ARC)       POSITION            Returns the best intersection point between the passed line and arc
--  bestIntersection(LINE,LINE)      POSITION            Returns the best intersection point between the passed lines
--  dbeLoop()                        BOOLEAN             Constructor, using passed database element
--  dbeLoop(ARRAY)                   BOOLEAN             Constructor, using passed array of lines and arcs
--  dbeLoop(DBREF)                   BOOLEAN             Constructor, using passed database element
--  dbeLoop(PROFILE)                 BOOLEAN             Constructor, using passed profile
--  definition()                     ARRAY               Returns loop definition
--  dumpDefinition()                 -                   Dump definition
--  edge(REAL)                       ANY                 Returns edge, if passed index > the end, the return start, likewise if < 1, then use last
--  fillet(REAL,ARC,ARC)             ARC                 Resolves fillet for passed arc and arc
--  fillet(REAL,ARC,LINE)            ARC                 Resolves fillet for passed arc and lines
--  fillet(REAL,LINE,ARC)            ARC                 Resolves fillet for passed line and arc
--  fillet(REAL,LINE,LINE)           ARC                 Resolves fillet for passed line and lines
--  fillet(REAL,REAL,REAL)           DBELOOPSOLUTION     Resolves fillet between the passed two edges
--  fitArcBetween(REAL,REAL,REAL,BOOLEAN) DBELOOPSOLUTION     Fits an arc between the passed edges of the specified radius
--  insertPoints(REAL,ARRAY)         DBELOOPSOLUTION     Insert a path of points into an line edge
--  isCorner(REAL,STRING)            BOOLEAN             Determine if the passed end of an edge is a corner, i.e. line at either side.
--  isFillet(REAL)                   BOOLEAN             Determine if the passed edge is a fillet curve with respect to its adjacent edges
--  mirror(LINE,REAL,REAL)           DBELOOPSOLUTION     Mirror boundary about a line
--  movePoint(REAL,STRING,POSITION)  DBELOOPSOLUTION     Move a corner to a new position
--  next(REAL)                       REAL                Return next edge index of passed edge
--  plane()                          PLANE               Returns plane of loop
--  previous(REAL)                   REAL                Return previous edge index of passed edge
--  range(REAL,REAL)                 ARRAY               Returns the range of edges for the passed from-to items
--  removeBetween(REAL,REAL)         DBELOOPSOLUTION     Removes the edges between passed edge indices, without resolving the corner, i.e. create a line between the start and end of the from to.
--  replace(ARRAY)                   -                   Replace current profile definition with passed array of lines and arcs
--  replace(PROFILE)                 -                   Replace current profile definition with passed profile
--  resolveCorner(REAL,REAL)         DBELOOPSOLUTION     Resolves an open corner between the end and start of the passed edges (coincident ends do not get resolved) Edges do not need to be consecutive to allow for deleted edge(s).
--  resolveCorner(REAL,STRING,POSITION) DBELOOPSOLUTION     Resolve only the passed end of an edge with the supplied position for the opposite end
--  resolveEdge(REAL,ANY)            DBELOOPSOLUTION     Resolves an existing edge with a new definition for that edge
--  resolveEnd(REAL,POSITION)        DBELOOPSOLUTION     Resolve only the end of an edge with the supplied position for the opposite end
--  resolvePoint(ARC,ARC)            BOOLEAN             Return (via arg list) the modified passed arc for the intersection
--  resolvePoint(ARC,LINE)           BOOLEAN             Returns (via arg list) the modified passed arc and line at the best intersection point between the two
--  resolvePoint(LINE,ARC)           BOOLEAN             Returns (via arg list) the modified passed line and arc at the best intersection point between the two
--  resolvePoint(LINE,LINE)          BOOLEAN             Return (via arg list) the modified passed lines for the intersection
--  resolveStart(REAL,POSITION)      DBELOOPSOLUTION     Resolve only the start end of an edge with the supplied position for the opposite end
--  reverse(REAL,REAL)               DBELOOPSOLUTION     Reverse sense of edges
--  reverseEdge(ARC)                 ARC                 Returns an arc with is the reverse of the passed, maintaining orientation, position, etc.
--  reverseEdge(LINE)                LINE                Returns reversed edge line (same as .reverseSense() on a line, but is defined for a consistent interface within this object)
--  reverseEdge(REAL)                DBELOOPSOLUTION     Reverses the sense of the edge and tries and resolves the adjacent edge
--  rotate(XYPOSITION,REAL,REAL,REAL) DBELOOPSOLUTION     Rotate about a point
--  rotationPoint(REAL,STRING)       POSITION            Returns the rotation point for the end of an edge
--  save()                           BOOLEAN             Save profile definition
--  tangentArc(REAL,ARC,ARC,BOOLEAN) ARC                 Tangent arc between the passed arcs, using the sense as the controlling mechanism to determine the tangent arc used
--  tangentArc(REAL,ARC,LINE,BOOLEAN) ARC                 Tangent arc between the passed arc and line, using the sense and start of line
--  tangentArc(REAL,ARC,POSITION,BOOLEAN) ARC                 Tangent arc between the passed arc and point, using the sense of the arc
--  tangentArc(REAL,LINE,ARC,BOOLEAN) ARC                 Tangent arc between the passed line and arc, using the sense and end of line
--  tangentArc(REAL,LINE,LINE,BOOLEAN) ARC                 Tangent arc between the passed line and line (user end and start of line)
--  tangentArc(REAL,POSITION,ARC,BOOLEAN) ARC                 Tangent arc between the passed point and arc, using the sense of the arc
--  tangentArc(REAL,POSITION,POSITION,BOOLEAN) ARC                 Tangent arc between the passed positions. Concave is assumed to be into the profile.
--  tangentLine(ARC,ARC)             LINE                Tangent line between the passed arcs, using the sense as the controlling mechanism to determine the tangent line used
--  tangentLine(ARC,LINE)            LINE                Tangent line between the passed arc and line, using the sense and start of line
--  tangentLine(ARC,POSITION)        LINE                Tangent line between the passed arc and point
--  tangentLine(LINE,ARC)            LINE                Tangent line between the passed line and arc, using the sense and end of line
--  tangentLine(LINE,LINE)           LINE                Forces a unset line to be returned
--  tangentLine(POSITION,ARC)        LINE                Tangent line between the passed point and arc
--  tangentLine(POSITION,POSITION)   LINE                Tangent line between the passed points (line definition, but is defined for completeness)
--  tangentialEnds(REAL)             ARRAY               Returns an array of booleans, true for each end when it is tangential to its adjacent
--  tangentialLineEdge(REAL,REAL)    DBELOOPSOLUTION     Resolves an edge between the passed to edges to be tangential
--  translate(REAL,REAL,REAL,REAL)   DBELOOPSOLUTION     Move whole boundary about a line
--
------------------------------------------------------------------------

define object DBELOOP

  -- Boundary
  member .loop               is DBREF

  -- Profile
  member .profile            is PROFILE

  -- Size (Quick check for number of edges)
  member .size               is REAL

  -- Plane
  member .plane              is PLANE

  -- Defined action on resolving edges
  -- Insert derived edges normal the edge
  member .insertNormalEdge   is BOOLEAN

  -- Merge co-linear edges
  member .mergeCoLinear      is BOOLEAN

  -- Tolerances
  member .near               is REAL
  member .nearAngle          is REAL


endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeLoop
--
-- Description: Constructor, using passed database element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop to populate boundary
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop loaded
--
------------------------------------------------------------------------

define method .dbeLoop() is BOOLEAN

  -- Define action on resolve
  !this.insertNormalEdge = true
  !this.mergeCoLinear    = true

  -- Default tolerance
  !this.near             = 0.001mm
  !this.nearAngle        = 0.01

endmethod
-- End of method of .dbeLoop()

------------------------------------------------------------------------
--
-- Method:      dbeLoop
--
-- Description: Constructor, using passed database element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop to populate boundary
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop loaded
--
------------------------------------------------------------------------

define method .dbeLoop(!loop is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.dbeLoop()

  -- Define profile
  !profile = object PROFILE(!loop)
  !profile.close()
  !size    = !profile.numberEdges()
  handle ANY
    !size  = 0
  endhandle

  -- Define profile
  !this.loop             = !loop
  !this.profile          = object PROFILE(!profile)
  !this.plane            = !this.profile.plane()
  !this.size             = !size

endmethod
-- End of method of .dbeLoop()

------------------------------------------------------------------------
--
-- Method:      dbeLoop
--
-- Description: Constructor, using passed array of lines and arcs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of lines and arcs
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop loaded
--
------------------------------------------------------------------------

define method .dbeLoop(!definition is ARRAY) is BOOLEAN

  -- Initialise Variables
  !this.dbeLoop()

  -- Define profile
  !profile = object PROFILE(n0, y is n, !definition)
  !profile.close()
  !size    = !profile.numberEdges()
  handle ANY
    !size  = 0
  endhandle

  -- Define profile
  !this.profile          = !profile
  !this.plane            = !profile.plane()
  !this.size             = !size

endmethod
-- End of method of .dbeLoop()

------------------------------------------------------------------------
--
-- Method:      dbeLoop
--
-- Description: Constructor, using passed profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile definition
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop loaded
--
------------------------------------------------------------------------

define method .dbeLoop(!passedProfile is PROFILE) is BOOLEAN

  -- Initialise Variables
  !this.dbeLoop()

  -- Define profile (copy profile)
  !profile = object PROFILE(!passedProfile)
  !profile.close()
  !size    = !profile.numberEdges()
  handle ANY
    !size  = 0
  endhandle

  -- Define profile
  !this.profile          = !profile
  !this.plane            = !profile.plane()
  !this.size             = !size

endmethod
-- End of method of .dbeLoop()

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save profile definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop loaded
--
------------------------------------------------------------------------

define method .save() is BOOLEAN

  -- Initialise Variables
  !this.profile.dbWrite(!this.loop)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: Returns plane of loop
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PLANE       Plane
--
------------------------------------------------------------------------

define method .plane() is PLANE
  return !this.plane
endmethod
-- End of method of .plane() PLANE

------------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Returns loop definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Boundary definition
--
------------------------------------------------------------------------

define method .definition() is ARRAY
  return !this.profile.edges()
endmethod
-- End of method of .definition() ARRAY

------------------------------------------------------------------------
--
-- Method:      edge
--
-- Description: Returns edge, if passed index > the end, the return start, likewise if < 1, then use last
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    ANY         Edge definition
--
------------------------------------------------------------------------

define method .edge(!index is REAL) is ANY

  -- Initialise Variables
  if(!index lt 1) then
    return !this.profile.edge(!this.size)
  elseif (!index gt !this.size) then
    return !this.profile.edge(1)
  else
    return !this.profile.edge(!index)
  endif

endmethod
-- End of method of .edge(REAL)

------------------------------------------------------------------------
--
-- Method:      reverseEdge
--
-- Description: Reverses the sense of the edge and tries and resolves the adjacent edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution
--
------------------------------------------------------------------------

define method .reverseEdge(!edgeIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution  = object DBELOOPSOLUTION()

  -- Get adjacent edges
  !fromIndex = !this.previous(!edgeIndex)
  !toIndex   = !this.next(!edgeIndex)
  !from      = !this.profile.edge(!fromIndex)
  !to        = !this.profile.edge(!toIndex)

  -- Only handle edge which are between lines
  if(!from.objectType() eq 'LINE' and !to.objectType() eq 'LINE') then

    !edge    = !this.profile.edge(!edgeIndex)
    !edge    = !this.reverseEdge(!edge)

    -- Move adjacent edges
    if(!edge.objectType() eq 'LINE') then
      !from.endPosition = !edge.startPosition
      !to.startPosition = !edge.endPosition
    else
      !from.endPosition = !edge.anglePosition(!edge.startAngle)
      !to.startPosition = !edge.anglePosition(!edge.endAngle)
    endif

    -- Define solution
    !solution.edgeNumbers.append(!fromIndex)
    !solution.edgeNumbers.append(!edgeIndex)
    !solution.edgeNumbers.append(!toIndex)
    !solution.edges.append(!from)
    !solution.edges.append(!edge)
    !solution.edges.append(!to)
    !solution.edgeIndex = 2

    return !solution

  -- Ignore any none line-line reverse
  else
    return object DBELOOPSOLUTION()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reverseEdge
--
-- Description: Returns an arc with is the reverse of the passed, maintaining orientation, position, etc.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         Arc
-- Return:
--   [Data Type] [Description]
--    ARC         Reversed arc
--
------------------------------------------------------------------------

define method .reverseEdge(!passedArc is ARC) is ARC

  -- Initialise Variables
  !arc            = !passedArc
  !arc.sense      = !passedArc.sense.not()
  !arc.startAngle = !passedArc.endAngle
  !arc.endAngle   = !passedArc.startAngle
  return !arc

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reverseEdge
--
-- Description: Returns reversed edge line (same as .reverseSense() on a line, but is defined for a consistent interface within this object)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line
-- Return:
--   [Data Type] [Description]
--    LINE        Reversed line
--
------------------------------------------------------------------------

define method .reverseEdge(!passedLine is LINE) is LINE
  return !passedLine.reverseSense()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolveEdge
--
-- Description: Resolves an existing edge with a new definition for that edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      ANY         New edge definition
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION Solution to problem
--
------------------------------------------------------------------------

define method .resolveEdge(!edgeIndex is REAL, !edge is ANY) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution         = object DBELOOPSOLUTION()
  !edges            = !this.profile.edges()
--  !isCircle         = !edges.size() eq 1 and !edges[1].objectType() eq 'ARC' and !edges[1].angle() eq 360

  -- Special case for "full circles"
  if(!this.profile.isCircle()) then
    !edges[1]         = !edge
    !solution.profile = object PROFILE(!this.profile.position, !this.profile.orientation, !edges)
    return !solution
  endif

  -- Define remainder of solution
  !newEdge          = !edge
  !adjacentIndex[1] = !this.previous(!edgeIndex)
  !adjacentIndex[2] = !this.next(!edgeIndex)

  !oneAfterIndex[1] = !this.previous(!adjacentIndex[1])
  !oneAfterIndex[2] = !this.next(!adjacentIndex[2])

  -- Get adjacent edge indices
  !adjacent[1]      = !this.profile.edge(!adjacentIndex[1])
  !adjacent[2]      = !this.profile.edge(!adjacentIndex[2])

  -- [1] Edge is a fillet
  if(!this.profile.isFillet(!edgeIndex)) then

    !newEdge = !this.fillet(!newEdge.radius, !adjacent[1], !adjacent[2])

    if(!newEdge.unset()) then
      return object DBELOOPSOLUTION()
    endif

  -- [1] Edge is not a fillet
  else

    -- Initialise Variables for end
    !end[1] = 'start'
    !end[2] = 'end'

    -- [2] Resolve adjacent edges about the new edge
    do !i from 1 to 2

      -- [3] If end is a corner, then resolve as an intersection
      if(!this.isCorner(!edgeIndex, !end[!i])) then

        -- Best intersection between edge and adjacent
        if(!i eq 1) then
          !iPosition                  = !this.bestIntersection(!adjacent[!i], !newEdge)
          !adjacent[!i].endPosition   = !iPosition
          !newEdge.startPosition      = !iPosition
        else
          !iPosition                  = !this.bestIntersection(!newEdge, !adjacent[!i])
          !adjacent[!i].startPosition = !iPosition
          !newEdge.endPosition        = !iPosition
        endif

      -- [3] Resolve corner with an arc
      else

        -- Get the one after the adjacent
        !oneAfter[!i]   = !this.profile.edge(!oneAfterIndex[!i])

        -- [4] If adjacent is fillet, then we will resolve it as one
        if(!this.profile.isFillet(!adjacentIndex[!i])) then

          if(!i eq 1) then
            !adjacent[!i] = !this.fillet(!adjacent[!i].radius, !oneAfter[!i], !newEdge)
          else
            !adjacent[!i] = !this.fillet(!adjacent[!i].radius, !newEdge, !oneAfter[!i])
          endif

        -- [4] Adjacent is not a fillet
        else

          !tangentialEnds = !this.tangentialEnds(!adjacentIndex[!i])

          -- [5] If both ends of the adjacent edge were tangential to their adjacent
          --     then we should resolve the edge to maintain tangency
          if(!tangentialEnds[1] or !tangentialEnds[2]) then

            -- Resolve a tangential line
            if(!adjacent[!i].objectType() eq 'LINE') then
              if(!i eq 1) then
                !resolved[!i] = !this.tangentLine(!oneAfter[!i], !newEdge)
              else
                !resolved[!i] = !this.tangentLine(!newEdge, !oneAfter[!i])
              endif

            endif

            -- Assigned a resolved edge to the adjacent edge
            if(defined(!resolved) and !resolved[!i].set()) then

              !adjacent[!i] = !resolved[!i]
            endif

          -- [5] End
          endif

          -- [5] If there has been on resolved edge, then try resolving the corner.
          --     When there is not sensible result, we will just fill in between the empty edges
          if(undefined(!resolved[!i]) or !resolved[!i].unset()) then
            if(!i eq 1) then
              !this.resolvePoint(!adjacent[!i], !newEdge)
            else
              !this.resolvePoint(!newEdge, !adjacent[!i])
            endif

          -- [5] End
          endif

        -- [4] End
        endif

      -- [3] End
      endif

    -- [2] End
    enddo

  -- [1] End
  endif

  -- Build solution
  if(defined(!oneAfter[1]) and !oneAfterIndex[1] ne !oneAfterIndex[2] and !edges.size() gt 3) then
    !solution.edgeNumbers.append(!oneAfterIndex[1])
    !solution.edges.append(!oneAfter[1])
  endif

  !solution.edgeNumbers.append(!adjacentIndex[1])
  !solution.edges.append(!adjacent[1])

  !solution.edgeNumbers.append(!edgeIndex)
  !solution.edges.append(!newEdge)
  !solution.edgeIndex = !solution.edges.size()

  !solution.edgeNumbers.append(!adjacentIndex[2])
  !solution.edges.append(!adjacent[2])

  if(defined(!oneAfter[2]) and !edges.size() gt 3) then
    !solution.edgeNumbers.append(!oneAfterIndex[2])
    !solution.edges.append(!oneAfter[2])
  endif

  return !solution

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolveCorner
--
-- Description: Resolves an open corner between the end and start of the passed edges (coincident ends do not get resolved) Edges do not need to be consecutive to allow for deleted edge(s).
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        From index
--    2   R      REAL        To index
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .resolveCorner(!fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)
  !solution.edgeIndex = 1
  !from               = !this.profile.edge(!fromIndex)
  !to                 = !this.profile.edge(!toIndex)

  -- Get best intersection
  if(!this.resolvePoint(!from, !to)) then
    !solution.edges.append(!from)
    !solution.edges.append(!to)
  endif

  -- Return, unresolved corner
  if(!solution.edges.empty()) then
    !!error.text = 'Unable to resolve the corner (' & !!error.text & ').'
    return object DBELOOPSOLUTION()
  else
    return !solution
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolveCorner
--
-- Description: Resolve only the passed end of an edge with the supplied position for the opposite end
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      STRING      End
--    3   R      POSITION    New position of opposite end of edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .resolveCorner(!edgeIndex is REAL, !end is STRING, !position is POSITION) is DBELOOPSOLUTION

  -- Initialise Variables
  if(!end.upcase() eq 'START') then
    return !this.resolveStart(!edgeIndex, !position)
  else
    return !this.resolveEnd(!edgeIndex, !position)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolveStart
--
-- Description: Resolve only the start end of an edge with the supplied position for the opposite end
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      POSITION    New position of opposite end of edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .resolveStart(!edgeIndex is REAL, !position is POSITION) is DBELOOPSOLUTION

  -- Get adjacent item
  !adjacentIndex            = !this.previous(!edgeIndex)
  !adjacent                 = !this.profile.edge(!adjacentIndex)

  -- Range of edges to be included in the modify list
  !solution                 = object DBELOOPSOLUTION()

  -- Adjacent is a line, use best intersection
  if(!adjacent.objectType() eq 'LINE') then

    -- Define solution
    !solution.edgeNumbers.append(!edgeIndex)
    !solution.edges.append(object LINE(!adjacent.endPosition, !position))

  -- Adjacent is an arc
  else

    -- Determine if edge end is tangential to adjacent
    !tangentialEnds        = !this.tangentialEnds(!adjacentIndex)

    -- If end is tangential, then we will roll about the adjacent arc
    if(!tangentialEnds[2]) then

      !edge                = !this.tangentLine(!adjacent, !position)
      !solution.edgeNumbers.append(!adjacentIndex)
      !solution.edgeNumbers.append(!edgeIndex)
      !solution.edges.append(!adjacent)
      !solution.edges.append(!edge)

    -- End is not tangential to the arc, so we will just define a line from
    -- the start of the adjacent arc
    else
      !solution.edgeNumbers.append(!edgeIndex)
      !solution.edges.append(object LINE(!adjacent.anglePosition(!adjacent.endAngle), !position))
    endif

  endif

  -- Return
  return !solution

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolveEnd
--
-- Description: Resolve only the end of an edge with the supplied position for the opposite end
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      POSITION    New position of opposite end of edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .resolveEnd(!edgeIndex is REAL, !position is POSITION) is DBELOOPSOLUTION

  -- Get adjacent item
  !adjacentIndex            = !this.next(!edgeIndex)
  !adjacent                 = !this.profile.edge(!adjacentIndex)

  -- Range of edges to be included in the modify list
  !solution                 = object DBELOOPSOLUTION()

  -- Adjacent is a line, use best intersection
  if(!adjacent.objectType() eq 'LINE') then

    -- Define solution
    !solution.edgeNumbers.append(!edgeIndex)
    !solution.edges.append(object LINE(!position, !adjacent.startPosition))

  -- Adjacent is an arc
  else

    -- Determine if edge end is tangential to adjacent
    !tangentialEnds        = !this.tangentialEnds(!adjacentIndex)

    -- If end is tangential, the we will role about the adjacent arc
    if(!tangentialEnds[1]) then

      !edge                = !this.tangentLine(!position, !adjacent)
      !solution.edgeNumbers.append(!edgeIndex)
      !solution.edgeNumbers.append(!adjacentIndex)
      !solution.edges.append(!edge)
      !solution.edges.append(!adjacent)

    -- End is not tangential to the arc, so we will just define a line from
    -- the start of the adjacent arc
    else
      !solution.edgeNumbers.append(!edgeIndex)
      !solution.edges.append(object LINE(!position, !adjacent.anglePosition(!adjacent.startAngle)))
    endif

  endif


  -- Return, unresolved corner
  if(!solution.edges.empty()) then
    !!error.text = 'Unable to resolve the end of edge (' & !!error.text & ').'
    return object DBELOOPSOLUTION()
  else
    return !solution
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolvePoint
--
-- Description: Return (via arg list) the modified passed arc for the intersection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW      ARC        From arc
--    2   RW      ARC        To arc
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .resolvePoint(!from is ARC, !to is ARC) is BOOLEAN

  -- Initialise Variables
  !iPosition = !this.bestIntersection(!from, !to)

  -- Redefine the from and to edges
  if(!iPosition.set()) then
    !from.endAngle = !from.near(!iPosition)
    !to.startAngle = !to.near(!iPosition)
    return true
  else
    return false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolvePoint
--
-- Description: Return (via arg list) the modified passed lines for the intersection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW      LINE        From line
--    2   RW      LINE        To line
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .resolvePoint(!from is LINE, !to is LINE) is BOOLEAN

  -- Initialise Variables
  !iPosition = !this.bestIntersection(!from, !to)

  -- Redefine the from and to edges
  if(!iPosition.set()) then
    !from.endPosition = !iPosition
    !to.startPosition = !iPosition
    return true
  else
    return false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolvePoint
--
-- Description: Returns (via arg list) the modified passed arc and line at the best intersection point between the two
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARC         Arc to intersect
--    2   RW     LINE        Line to intersect
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .resolvePoint(!from is ARC, !to is LINE) is BOOLEAN

  -- Get best intersection
  !iPosition = !this.bestIntersection(!from, !to)

  -- Redefine the from and to edges
  if(!iPosition.set()) then
    !from.endAngle    = !from.near(!iPosition)
    !to.startPosition = !iPosition
    return true
  else
    return false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resolvePoint
--
-- Description: Returns (via arg list) the modified passed line and arc at the best intersection point between the two
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     LINE        Line to intersect
--    2   RW     ARC         Arc to intersect
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .resolvePoint(!from is LINE, !to is ARC) is BOOLEAN

  -- Get best intersection
  !iPosition = !this.bestIntersection(!from, !to)

  -- Redefine the from and to edges
  if(!iPosition.set()) then
    !from.endPosition = !iPosition
    !to.startAngle    = !to.near(!iPosition)
    return true
  else
    return false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertPoints
--
-- Description: Insert a path of points into an line edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      ARRAY       Positions
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Derived solution
--
------------------------------------------------------------------------

define method .insertPoints(!edgeIndex is REAL, !positions is ARRAY) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution         = object DBELOOPSOLUTION()
  !edge             = !this.profile.edge(!edgeIndex)
  !plane            = !this.profile.plane()
  !edges            = ARRAY()

  -- Check we are at a corner
  if(!edge.objectType() ne 'LINE') then
    !!error.text = 'Can only insert a point within a line edge.'
    return object DBELOOPSOLUTION()
  endif

  -- Single points
  if(!positions.size() eq 1) then
    !fromPosition   = !plane.near(!positions[1])
    !toPosition     = !fromPosition

  -- Multiple points
  else
    !from           = !plane.near(!positions[1])
    !fromPosition   = !from
    do !i from 2 to !positions.size()
      !to           = !plane.near(!positions[!i])
      !edges.append(object LINE(!from, !to))
      !from         = !to
    enddo
    !toPosition     = !from

  endif

  -- Get solutions for adjacent edges
  !previousSolution = !this.resolveStart(!edgeIndex, !fromPosition)
  !nextSolution     = !this.resolveEnd(!edgeIndex, !toPosition)

  -- Solution
  !solution           = !previousSolution
  !solution.edgeIndex = !solution.edges.size()
  if(!edges.empty().not()) then
    !solution.edges.appendArray(!edges)
  endif
  !solution.edgeNumbers.appendArray(!nextSolution.edgeNumbers)
  !solution.edgeNumbers.append(!edgeIndex)
  !solution.edgeNumbers.unique()
  !solution.edges.appendArray(!nextSolution.edges)

  -- Return
  return !solution

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      movePoint
--
-- Description: Move a corner to a new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      STRING      End of edge to be repositioned
--    3   R      POSITION    New position of corner
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Derived solution
--
------------------------------------------------------------------------

define method .movePoint(!edgeIndex is REAL, !end is STRING, !passedPosition is POSITION) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution         = object DBELOOPSOLUTION()
  !position         = !this.profile.plane().near(!passedPosition)

  -- Check we are at a corner
  if(!this.isCorner(!edgeIndex, !end).not()) then
    return object DBELOOPSOLUTION()
  endif

  -- Resolve start
  if(!end.upcase() eq 'START') then
    !start          = true
    !adjacentIndex  = !this.previous(!edgeIndex)
    !adjacentEnd    = 'end'
  else
    !start          = false
    !adjacentIndex  = !this.next(!edgeIndex)
    !adjacentEnd    = 'start'
  endif

  -- Resolve the from line
  if(!start) then
    !adjacentSolution = !this.resolveCorner(!adjacentIndex, !end, !position)
    !edgeSolution     = !this.resolveCorner(!edgeIndex, !adjacentEnd, !position)

    -- Solution
    !solution           = !adjacentSolution
    !solution.edgeIndex = !solution.edges.size() + 1
    !solution.edgeNumbers.appendArray(!edgeSolution.edgeNumbers)
    !solution.edges.appendArray(!edgeSolution.edges)

  else
    !edgeSolution     = !this.resolveCorner(!edgeIndex, !adjacentEnd, !position)
    !adjacentSolution = !this.resolveCorner(!adjacentIndex, !end, !position)

    -- Solution
    !solution           = !edgeSolution
    !solution.edgeIndex = !solution.edges.size()
    !solution.edgeNumbers.appendArray(!adjacentSolution.edgeNumbers)
    !solution.edges.appendArray(!adjacentSolution.edges)

  endif

  -- Return
  return !solution

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotatePoint
--
-- Description: Returns the rotation point for the end of an edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    1   R      STRING      End to edge
-- Return:
--   [Data Type] [Description]
--    POSITION    Rotation position
--
------------------------------------------------------------------------

define method .rotationPoint(!edgeIndex is REAL, !end is STRING) is POSITION

  -- Initialise Variables
  !edge         = !this.profile.edge(!edgeIndex)

  -- If edge is arc, then the rotation point is its origin.
  if(!edge.objectType() eq 'ARC') then
    return !edge.position
  endif

  -- Determine the rotation point
  !tangentEnds  = !this.tangentialEnds(!edgeIndex)

  -- Rotate about start
  if(!end.upcase() eq 'START') then
    !index      = !this.previous(!edgeIndex)
    !tangential = !tangentEnds[1]
    !otherEnd   = 'end'
  else
    !index      = !this.next(!edgeIndex)
    !tangential = !tangentEnds[2]
    !otherEnd   = 'start'
  endif

  -- Adjacent
  !adjacent     = !this.profile.edge(!index)

  -- If previous end is tangential, the we need to derive the rotation point
  if(!adjacent.objectType() eq 'ARC') then

    -- If edge is tangential, the derive the rotation position
    if(!tangential) then
      !position = !adjacent.position

    -- Use the appropriate end of arc edge
    else
      !position = !adjacent.anglePosition(!adjacent.attribute(!otherEnd & 'Angle'))
    endif

  -- Get appropriate end of line edge
  else
    !position   = !edge.attribute(!end & 'Position')
  endif

  -- Rotate edge
  return !position

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bestIntersection
--
-- Description: Return (via arg list) the modified passed arc for the intersection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC        From arc
--    2   R      ARC        To arc
-- Return:
--   [Data Type] [Description]
--    POSITION    Best intersection position
--
------------------------------------------------------------------------

define method .bestIntersection(!from is ARC, !to is ARC) is POSITION

  -- Initialise Variables

  -- Determine intersections between the edges
  !intersections  = !from.intersections(!to)

  -- Handle no intersections
  if(!intersections.empty()) then
    !!error.text  = 'No intersections'
    return object POSITION()
  endif

  -- Loop through intersections
  do !i indices !intersections
    !position[!i] = !from.anglePosition(!intersections[!i])
    !onFrom[!i]   = !from.onProjected(!position[!i])
    !onTo[!i]     = !to.onProjected(!position[!i])
    if(!onFrom[!i] and !onTo[!i]) then
      !iPosition  = !position[!i]
      break
    endif
    !distance[!i] = !position[!i].distance(!from.anglePosition(!from.endAngle)) + !position[!i].distance(!to.anglePosition(!to.startAngle))
  enddo

  -- [2] If intersection position is no defined, try and derive the best one
  if(undefined(!iPosition)) then

    -- [2] First intersection point intersects with either the line or arc
    if(!onFrom[1] or !onTo[1]) then
      !iPosition = !position[1]

    -- [2] Second intersection point intersects with either the line or arc
    elseif (!onFrom[2] or !onTo[2]) then
      !iPosition = !position[2]

    -- [2] Derive the best point
    else

      -- We will use the point with the shortest accumulated between the
      -- intersections point end the ends
      if(!distance[1] le  !distance[2]) then
        !iPosition = !position[1]
      else
        !iPosition = !position[2]
      endif

    -- [2] End
    endif

  -- [2] End
  endif

  return !iPosition

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bestIntersection
--
-- Description: Returns the best intersection point between the passed lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        From line
--    2   R      LINE        To line
-- Return:
--   [Data Type] [Description]
--    POSITION    Best intersection position
--
------------------------------------------------------------------------

define method .bestIntersection(!from is LINE, !to is LINE) is POSITION

  -- Initialise Variables
  !iPosition = !from.pointVector().intersection(!to.pointVector())
  handle ANY
    !!error.text = !!error.text.after(')').trim()
    return object POSITION()
  endhandle

  return !iPosition

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bestIntersection
--
-- Description: Returns the best intersection point between the passed arc and line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARC         Arc to intersect
--    2   R     LINE        Line to intersect
-- Return:
--   [Data Type] [Description]
--    POSITION    Best intersection position
--
------------------------------------------------------------------------

define method .bestIntersection(!from is ARC, !to is LINE) is POSITION

  -- Initialise Variables
  !arc    = !this.reverseEdge(!from)
  !line   = !to.reverseSense()

  -- Invert the definitions so we always
  return !this.bestIntersection(!line, !arc)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bestIntersection
--
-- Description: Returns the best intersection point between the passed line and arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     LINE        Line to intersect
--    2   R     ARC         Arc to intersect
-- Return:
--   [Data Type] [Description]
--    POSITION    Best intersection position
--
------------------------------------------------------------------------

define method .bestIntersection(!from is LINE, !to is ARC) is POSITION

  -- Initialise Variables
  !toStart    = !to.anglePosition(!to.startAngle)
  !iPositions = !from.intersections(!to)

  -- Handle no intersections
  if(!iPositions.empty()) then
    return !from.near(!to.position)

    !!error.text = 'No intersections'
    return object POSITION()
  endif

  -- Define arc with each its start at each of the intersections
  do !i indices !iPositions

    -- Use any intersection of the existing edges
    !onLine[!i]   = !from.onProjected(!iPositions[!i])
    !onArc[!i]    = !to.onProjected(!iPositions[!i])
    if(!onLine[!i] and !onArc[!i]) then
      !iPosition  = !iPositions[!i]
      break
    endif
    !distance[!i] = !from.endPosition.distance(!iPositions[!i])
  enddo

  -- [1] If intersection position is no defined, try and derive the best one
  if(undefined(!iPosition)) then

    -- If there is only one intersection point, then we must use it
    if(!iPositions.size() eq 1) then
      !iPosition = !iPositions[1]
    else

      -- Use intersection point nearest to the passed line start
      if(!distance[1] le !distance[2]) then
        !iPosition = !iPositions[1]
      else
        !iPosition = !iPositions[2]
      endif
    endif

  -- [1] End
  endif

  -- Return
  return !iPosition

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeBetween
--
-- Description: Removes the edges between passed edge indices, without resolving the corner, i.e. create a line between the start and end of the from to.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        From index
--    2   R      REAL        To index
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .removeBetween(!fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeIndex = 1
  !from               = !this.profile.edge(!fromIndex)
  !to                 = !this.profile.edge(!toIndex)

  -- Get end of from item
  if(!from.objectType() eq 'ARC') then
    !start = !from.anglePosition(!from.endAngle)
  else
    !start = !from.endPosition
  endif

  -- Get start of to item
  if(!to.objectType() eq 'ARC') then
    !end   = !to.anglePosition(!to.startAngle)
  else
    !end   = !to.startPosition
  endif

  -- Define line
  !solution.edges.append(object LINE(!start, !end))

  -- Return, unresolved corner
  if(!solution.edges.empty()) then
    !!error.text = 'Unable to resolve the corner (' & !!error.text & ').'
    return object DBELOOPSOLUTION()
  else
    return !solution
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isCorner
--
-- Description: Determine if the passed end of an edge is a corner, i.e. line at either side.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
--    2   R      STRING      End
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if edge is a fillet
--
------------------------------------------------------------------------

define method .isCorner(!edgeIndex is REAL, !end is STRING) is BOOLEAN

  -- Edge types
  !edge            = !this.profile.edge(!edgeIndex)

  -- Return on arcs
  if(!edge.objectType() eq 'ARC') then
    !!error.text   = 'Can only have corners between two adjacent line edges.'
    return false
  endif

  -- Check start corner
  if(!end.upcase() eq 'START') then
    !adjacentIndex = !this.previous(!edgeIndex)
  else
    !adjacentIndex = !this.next(!edgeIndex)
  endif

  -- Get adjacent edge
  !adjacent        = !this.profile.edge(!adjacentIndex)

  -- Return on arcs
  if(!adjacent.objectType() eq 'ARC') then
    !!error.text   = 'Can only have corners between two adjacent line edges.'
    return false
  endif

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isFillet
--
-- Description: Determine if the passed edge is a fillet curve with respect to its adjacent edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if edge is a fillet
--
------------------------------------------------------------------------

define method .isFillet(!edgeIndex is REAL) is BOOLEAN

  -- Edge types
  !filletFlag       = false
  !edge             = !this.profile.edge(!edgeIndex)

  -- Ignore none arc edges
  if(!edge.objectType() ne 'ARC') then
    return false

  -- Don't allow arc >= 180 to be classes as fillets
  else
    if(!edge.angle() ge 180) then
      return false
    endif
  endif

  -- Edge information
  !direction[1]     = !edge.startTangent()
  !direction[2]     = !edge.endTangent().opposite()

  -- Initialise Variables
  !adjacentIndex[1] = !this.previous(!edgeIndex)
  !adjacentIndex[2] = !this.next(!edgeIndex)

  -- Get data of adjacent elements
  do !i from 1 to 2
    !adjacent[!i]               = !this.profile.edge(!adjacentIndex[!i])

    -- Edge Line
    if(!adjacent[!i].objectType() eq 'LINE') then
      !adjacentLine[!i]        = true
      if(!i eq 1) then
        !adjacentDirection[!i] = !adjacent[!i].direction().opposite()
        !position = !adjacent[!i].endPosition
      else
        !adjacentDirection[!i] = !adjacent[!i].direction()
        !position = !adjacent[!i].startPosition
      endif

    -- Edge Arc
    else
      !adjacentLine[!i]        = false
      if(!i eq 1) then
        !adjacentDirection[!i] = !adjacent[!i].endTangent().opposite()
        !position = !adjacent[!i].anglePosition(!adjacent[!i].endAngle)
      else
        !adjacentDirection[!i] = !adjacent[!i].startTangent()
        !position = !adjacent[!i].anglePosition(!adjacent[!i].startAngle)
      endif
    endif
    !tangential[!i] = !direction[!i].angle(!adjacentDirection[!i]) ge 180 - !this.nearAngle
  enddo

  -- Rules for defining fillet
  -- [1] Only consider
  if(!tangential[1] and !tangential[2]) then

    -- [2] Adjacent arc both lines
    if(!adjacentLine[1] and !adjacentLine[2]) then
      !filletFlag = true

    -- [2] Adjacent are both arcs
    elseif (!adjacentLine[1].not() and !adjacentLine[2].not()) then

      -- [3] Adjacent arcs must have the same sense
      if((!adjacent[1].sense eq !adjacent[2].sense) and !adjacent[1].radius gt !edge.radius and !adjacent[2].radius gt !edge.radius ) then
        !filletFlag = true

      -- [3] End
      endif

    -- [2] Adjacent are a line and an arc
    else

      -- [3] Adjacent arc must be greater than the edge
      if(!adjacentLine[1].not() and !adjacent[1].radius gt !edge.radius or !adjacentLine[2].not() and !adjacent[2].radius gt !edge.radius) then
        !filletFlag = true
      -- [3] End
      endif
    -- [2] End
    endif
  -- [1] End
  endif

  -- Return
  return !filletFlag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description: Resolves fillet for passed line and lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Fillet radius
--    2   RW     LINE        Previous line
--    3   RW     LINE        Next line
-- Return:
--   [Data Type] [Description]
--    ARC         Fillet arc
--
------------------------------------------------------------------------

define method .fillet(!radius is REAL, !firstLine is LINE, !secondLine is LINE) is ARC

  -- Get the angle between the adjacent lines
  !angle = !firstLine.direction().angle(!secondLine.direction())

  -- Fillet angle of zero degrees
  if(!angle le !this.nearAngle or !angle ge 180 - !this.nearAngle) then
    !!error.text = 'Edges are parallel.'
    return object ARC()
  endif

  -- Derive the fillet point
  !iPosition                  = !firstLine.pointVector().intersection(!secondLine.pointVector())
  !arc                        = !iPosition.arcFillet(!firstLine.startPosition, !secondLine.endPosition, !this.plane.direction(), !radius)
  !firstLine.endPosition      = !arc.anglePosition(!arc.startAngle)
  !secondLine.startPosition   = !arc.anglePosition(!arc.endAngle)

  -- Return
  return !arc

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description: Resolves fillet for passed arc and lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Fillet radius
--    2   RW     ARC         Previous arc
--    3   RW     LINE        Next line
-- Return:
--   [Data Type] [Description]
--    ARC         Fillet arc
--
------------------------------------------------------------------------

define method .fillet(!radius is REAL, !previous is ARC, !next is LINE) is ARC

  -- Initialise Variables
  !arc            = !this.reverseEdge(!previous)
  !line           = !next.reverseSense()

  -- Get fillet
  !fillet         = !this.fillet(!radius, !line, !arc)

  -- Invert the definitions so we always
  if(!fillet.set()) then
    !fillet       = !this.reverseEdge(!fillet)
    !previous     = !this.reverseEdge(!arc)
    !next         = !line.reverseSense()
    return !fillet
  else
    return object ARC()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description: Resolves fillet for passed line and arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Fillet radius
--    3   RW     LINE        Previous line
--    2   RW     ARC         Next arc
-- Return:
--   [Data Type] [Description]
--    ARC         Fillet arc
--
------------------------------------------------------------------------

define method .fillet(!radius is REAL, !line is LINE, !arc is ARC) is ARC

  -- Initialise Variables

  -- Check that we can fit a fillet radius in between the arc
  !offset = !line.near(!arc.position).distance(!arc.position)

  -- If radius of arc + new radius < offset, then we can not produce a fillet
  if(!offset gt !arc.radius) then
    !!error.text = 'No intersection between edges.'
    return object ARC()
  endif

  -- Make sure the fillet radius is less than the arc we arc filleting with
  if(!radius ge !arc.radius) then
    !!error.text = 'Fillet radius  must be less that the adjacent arc.'
    return object ARC()
  endif

  -- Define the reference arc
  !referenceArc        = !arc

  -- Get best intersection between line and arc
  !bestIntersection    = !this.bestIntersection(!line, !arc)

  -- Determine if arc is internal or external. Project arc position onto
  -- the line, if the direction of the point to the intersection is the
  -- same as the line to the intersection. then we have an internal fillet
  !lineDirection = !line.startPosition.direction(!bestIntersection)
  !arcDirection  = !line.near(!arc.position).direction(!bestIntersection)

  -- If distance is less than the radius, we have an internal arc
  if(!lineDirection.angle(!arcDirection) le !this.nearAngle) then
    !referenceArc.radius = !arc.radius - !radius

  -- Arc is external
  else
    !referenceArc.radius = !arc.radius + !radius
  endif

  -- Determine the side of the line we offset
  if(!arc.sense) then
    !offsetPosition      = !arc.anglePosition(!arc.startAngle + 10)
  else
    !offsetPosition      = !arc.anglePosition(!arc.startAngle - 10)
  endif
  !offsetDirection       = !line.near(!offsetPosition).direction(!offsetPosition)

  -- Define the offset line
  !offsetLine            = !line.offset(!offsetDirection, !radius)

  -- Get intersection of offsetLine and referenceArc
  !iPosition             = !offsetLine.intersections(!referenceArc)
  if(!iPosition.empty()) then
        !!error.text     = 'Edges do not intersection.'
    return object ARC()
  endif

  -- Use the intersection position nearest to the end of the passed line
  if(!line.near(!iPosition[1]).distance(!line.endPosition) le !line.near(!iPosition[2]).distance(!line.endPosition)) then
    !centre = !iPosition[1]
  else
    !centre = !iPosition[2]
  endif

  !arc.startAngle      = !arc.near(!centre)
  !line.endPosition    = !line.near(!centre)
  !fillet              = object ARC(!centre, object ORIENTATION('Z is ' & !this.plane.direction() & ' and X is ' & !centre.direction(!line.endPosition)), 0, 180, !radius, false)
  !fillet.endAngle     = !fillet.near(!arc.anglePosition(!arc.startAngle))

  -- Check angle
  if(!fillet.angle() gt 180) then
    !fillet.sense = !fillet.sense.not()
  endif

  -- Return arc
  return !fillet

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description: Resolves fillet for passed arc and arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     REAL        Fillet radius
--    3   RW     ARC         Previous arc
--    2   RW     ARC         Next arc
-- Return:
--   [Data Type] [Description]
--    ARC         Fillet arc
--
------------------------------------------------------------------------

define method .fillet(!radius is REAL, !from is ARC, !to is ARC) is ARC

  -- Initialise Variables

  -- Check that passed fillet radius is less than both adjacent arcs
  if(!radius ge !from.radius or !radius ge !to.radius) then
    !!error.text = 'Fillet radius MUST be smaller than the arcs on either side.'
    return object ARC()
  endif

  -- Check that the radius is at least will fit
  !minimumRadius = (!from.position.distance(!to.position) - !from.radius - !to.radius) / 2
  if(!minimumRadius gt !radius) then
    !!error.text = 'Minimum radius must be (' & !minimumRadius & ')'
    return object ARC()
  endif

  -- Check that the adjacent arcs are the same sense
  if(!from.sense ne !to.sense) then
    !!error.text = 'Arc must be of the same sense'
    return object ARC()
  endif

  -- Get extended radii of from and to arcs
  !radiusFrom = !radius + !from.radius
  !radiusTo   = !radius + !to.radius

  !fromArc         = !from
  !fromArc.radius  = !radiusFrom
  !toArc           = !to
  !toArc.radius    = !radiusTo

  -- Get intersections of points

  !intersections   = !fromArc.intersections(!toArc)

  if (!intersections.size() lt 2) then
    !!error.text = 'Arcs do not intersect'
    return object ARC()
  endif

  do !i indices !intersections
    !position[!i]           = !fromArc.anglePosition(!intersections[!i])
    !testFromArc            = !from
    !testFromArc.endAngle   = !intersections[!i]
    !testToArc              = !to
    !testToArc.startAngle   = !to.near(!position[!i])
    !angle[!i]              = !testFromArc.angle() + !testToArc.angle()
  enddo

  if(!angle[1] le !angle[2]) then
    !centre = !position[1]
  else
    !centre = !position[2]
  endif

  -- Define the arc
  !arc            = !from
  !arc.position   = !centre
  !arc.sense      = !arc.sense.not()
  !arc.radius     = !radius
  !arc.startAngle = !arc.near(!from.position)
  !arc.endAngle   = !arc.near(!to.position)

  -- Modify passed arcs
  !from.endAngle      = !from.near(!arc.position)
  !to.startAngle      = !to.near(!arc.position)

  -- Return
  return !arc

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillet
--
-- Description: Resolves fillet between the passed two edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     REAL        Fillet radius
--    2   RW     REAL        From edge
--    3   RW     REAL        To edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION Solution to problem
--
------------------------------------------------------------------------

define method .fillet(!radius is REAL, !fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)

  -- Get "from" & "to" edge
  !from    = !this.profile.edge(!fromIndex)
  !to      = !this.profile.edge(!toIndex)

  -- Derive the fillet
  !fillet  = !this.fillet(!radius, !from, !to)

  -- Return, unresolved corner
  if(!fillet.unset()) then
    return object DBELOOPSOLUTION()

  -- Define solution
  else
    !solution.edges.append(!from)
    !solution.edges.append(!fillet)
    !solution.edgeIndex = !solution.edges.size()
    !solution.edges.append(!to)
    return !solution
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fitArcBetween
--
-- Description: Fits an arc between the passed edges of the specified radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     REAL        Radius
--    2   RW     REAL        From edge
--    3   RW     REAL        To edge
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION Solution to problem
--
------------------------------------------------------------------------

define method .fitArcBetween(!passedRadius is REAL, !fromIndex is REAL, !toIndex is REAL, !concave is BOOLEAN) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution = object DBELOOPSOLUTION()
  !edgeArc  = object ARC()

  -- Set radius to default of zero, if an unset radius is passed
  if(!passedRadius.unset()) then
    !radius = 0
  else
    !radius = !passedRadius.abs()
  endif

  -- Range of edges to be included in the modify list
  !range    = !this.range(!fromIndex, !toIndex)

  -- Get data of "from" item
  !from            = !this.profile.edge(!fromIndex)
  !fromLine        = !from.objectType() eq 'LINE'
  if(!fromLine) then
    !fromPosition  = !from.endPosition
    !fromDirection = !from.direction()
  else
    !fromPosition  = !from.anglePosition(!from.endAngle)
    !fromDirection = !from.endTangent()
  endif

  -- Get data of "to" item
  !to              = !this.profile.edge(!toIndex)
  !toLine          = !to.objectType() eq 'LINE'
   if(!toLine) then
    !toPosition    = !to.startPosition
    !toDirection   = !to.direction().opposite()
  else
    !toPosition    = !to.anglePosition(!to.startAngle)
    !toDirection   = !to.startTangent().opposite()
  endif

  -- Define some constants
  !sense           = !concave.eq(!this.profile.sense())
  !chord           = !fromPosition.distance(!toPosition)
  !direction       = !fromPosition.direction(!toPosition)

  -- If the distance between the from and to positions is zero, then we
  -- have a fillet.
  if(!chord eq 0) then

    -- A radius must be defined
    if(!radius eq 0) then
      !!error.text = 'A radius must be defined for a fillet.'
      return object DBELOOPSOLUTION()
    endif

    return !this.fillet(!radius, !fromIndex, !toIndex)

  -- If the adjacent edges are lines or the radius is less than or equal
  -- to the chord length, the we are fitting a semi-circle in
  elseif (!fromLine and !toLine or !radius le !chord / 2) then

    -- If radius is zero, then we will use half the chord length as the radius
    if(!radius le 0) then
      !radius = !chord / 2
    endif

    -- Get tangent arc between two points
    !arc      = !this.tangentArc(!radius, !fromPosition, !toPosition, !concave)

    -- Handle unset arcs
    if(!arc.unset()) then
      return object DBELOOPSOLUTION()
    endif

    -- Define solution
    !solution.edgeNumbers.appendArray(!range)
    !solution.edges.append(!arc)

    -- Handle the index to the correct edge
    if(!radius eq !chord / 2) then
      !solution.edgeIndex = 1
    else
      !solution.edgeIndex = 2
    endif

    return !solution

  -- Assume we are fitting between arcs, where the adjacent edge is a line
  -- then we will assume its an arc of zero radius
  else

    -- Get tangent arc between two points
    !arc      = !this.tangentArc(!radius, !from, !to, !concave)

    -- Handle unset arcs
    if(!arc.unset()) then
      return object DBELOOPSOLUTION()
    endif

    -- Define solution
    if(!fromLine.not() and !from.radius gt 0) then
      !solution.edgeNumbers.append(!fromIndex)
      !solution.edges.append(!from)
    endif

    !solution.edgeNumbers.appendArray(!range)
    !solution.edges.append(!arc)
    !solution.edgeIndex = !solution.edges.size()

    if(!toLine.not() and !to.radius gt 0) then
      !solution.edgeNumbers.append(!toIndex)
      !solution.edges.append(!to)
    endif

    return !solution

  -- [1] End
  endif

  -- Return, unresolved corner
  if(!arc.unset()) then
    !!error.text = 'Unable to fit arc between edges.'
    return object DBELOOPSOLUTION()

  -- Define solution
  else
    return !solution
  endif

  -- Return
  return !solution

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fitArcBetween
--
-- Description: Fits an arc between the passed edges of the specified radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     REAL        Radius
--    2   RW     REAL        From edge
--    3   RW     REAL        To edge
--    4   RE     BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION Solution to problem
--
------------------------------------------------------------------------

define method .fitArcBetween(!passedRadius is REAL, !fromIndex is REAL, !toIndex is REAL, !concave is BOOLEAN) is DBELOOPSOLUTION

  -- Initialise Variables
  !radius   = !passedRadius
  !solution = object DBELOOPSOLUTION()
  !edgeArc  = object ARC()

  -- Set radius to default of zero, if an unset radius is passed
  if(!radius.unset()) then
    !radius = 0
  endif

  -- Range of edges to be included in the modify list
  !range    = !this.range(!fromIndex, !toIndex)

  -- Get "from" & "to" edge
  !from     = !this.profile.edge(!fromIndex)
  !fromLine = !from.objectType() eq 'LINE'
  !to       = !this.profile.edge(!toIndex)
  !toLine   = !to.objectType() eq 'LINE'

  -- Set sense
  !sense    = !concave.eq(!this.profile.sense())

  -- [1]  Fit arc between two lines
  if(!fromLine and !toLine) then

    -- Straight edge between two lines
    !edgeLine        = object LINE(!from.endPosition, !to.startPosition)
    !edgeLength      = !edgeLine.length()

    -- If radius <= zero, then we will use a radius of half the edge line length
    if(!radius le 0) then
      !radius = !edgeLength / 2
    endif

    -- Direction
    if(!sense) then
      !direction   = !this.plane.direction().orthogonal(!edgeLine.direction())
    else
      !direction   = !edgeLine.direction().orthogonal(!this.plane.direction())
    endif

    -- Orientation of arc
    !orientation = object ORIENTATION('Z is ' & !this.plane.direction() & ' and Y is ' & !direction)

    -- Basic arc definition
    !edgeArc     = object ARC(!edgeLine.proportion(0.5), !orientation, 0, 90, !radius, true)

    -- [2] Arc is larger than the edge line (chord)
    if(!radius gt !edgeLength / 2) then
      !edgeArc            = !edgeArc.chord(!edgeLength)
      !edgeArc.position   = !edgeArc.position.offset(!direction.opposite(), !edgeArc.radius -!edgeArc.chordHeight())

    -- [2] End
    endif

    !edgeArc.sense      = !sense.not()

    -- Define start/end angle
    !edgeArc.startAngle = !edgeArc.near(!edgeLine.startPosition)
    !edgeArc.endAngle   = !edgeArc.near(!edgeLine.endPosition)

    -- Define solution
    !solution.edgeNumbers.appendArray(!range)
    !solution.edges.append(!edgeArc)

    -- Handle the index to the correct edge
    if(!edgeArc.anglePosition(!edgeArc.startAngle).distance(!from.endPosition) ge !this.near) then
      !solution.edgeIndex = 2
    else
      !solution.edgeIndex = 1
    endif

  -- [1] Fit arc between to arcs
  elseif (!fromLine.not() and !toLine.not()) then

    -- Check that the radius is at least will fit
    !minimumRadius = (!from.position.distance(!to.position) - !from.radius - !to.radius) / 2
    if(!minimumRadius gt !radius) then
      !!error.text = 'Unable to fit arc between arcs, minimum radius must be (' & !minimumRadius & ')'
      return object DBELOOPSOLUTION()
    endif

    -- Centre line between the two arcs
    !centreLine = !from.position.line(!to.position)

    -- Directions from centre line to from and to end and start
    !fromNormal = !centreLine.near(!from.anglePosition(!from.endAngle)).direction(!from.anglePosition(!from.endAngle))
    --!toNormal   = !centreLine.near(!to.anglePosition(!to.startAngle)).direction(!to.anglePosition(!to.startAngle))

    -- [2] Arc between arcs of the same sense
    if(!from.sense eq !to.sense) then

      -- Concave arc
      if(!concave) then
        !radiusFrom = !radius + !from.radius
        !radiusTo   = !radius + !to.radius
        !offsetFlag = !from.sense.not()

      -- Convex arc
      else
        !radiusFrom = !radius - !from.radius
        !radiusTo   = !radius - !to.radius
        !offsetFlag = !from.sense

        -- If it is not possible to fit a convex arc, revert to concave
        if(!radiusFrom le 0 or !radiusTo le 0) then
          !radiusFrom = !radius + !from.radius
          !radiusTo   = !radius + !to.radius
          !offsetFlag = !from.sense.not()
        endif
      endif

    -- [2] Arcs of different sense
    else

      -- Concave arc
      if(!concave) then
        !radiusFrom = !radius + !from.radius
        !radiusTo   = !radius - !to.radius
        !offsetFlag = !from.sense.not()

      -- Convex arc
      else
        !radiusFrom = !radius - !from.radius
        !radiusTo   = !radius + !to.radius
        !offsetFlag = !from.sense
      endif

    endif

    -- Define modified arcs
    !fromArc         = !from
    !fromArc.radius  = !radiusFrom
    !toArc           = !to
    !toArc.radius    = !radiusTo

    -- Get intersections of points
    !intersections   = !fromArc.intersections(!toArc)

    -- If there are less that two intersections points, then we can not resolve the fitting of an arc
    if(!intersections.size() le 1) then
      !!error.text = 'Unable to fit arc between adjacent arcs.'
      return object DBELOOPSOLUTION()
    endif

    do !i indices !intersections
      !position[!i]  = !fromArc.anglePosition(!intersections[!i])
      !direction[!i] = !centreLine.near(!position[!i]).direction(!position[!i])
    enddo

    if(!fromNormal.angle(!direction[1]) le !this.nearAngle and !offsetFlag) then
      !centre = !position[1]
    else
      !centre = !position[2]
    endif

    -- Define the arc
    !edgeArc            = !from
    !edgeArc.position   = !centre
    !edgeArc.sense      = !offsetFlag
    !edgeArc.radius     = !radius
    !edgeArc.startAngle = !edgeArc.near(!from.position)
    !edgeArc.endAngle   = !edgeArc.near(!to.position)

    -- Modify adjacent
    !from.endAngle      = !from.near(!edgeArc.anglePosition(!edgeArc.startAngle))
    !to.startAngle      = !to.near(!edgeArc.anglePosition(!edgeArc.endAngle))

    -- Define the solution
    !solution.edgeNumbers.append(!fromIndex)
    !solution.edgeNumbers.appendArray(!range)
    !solution.edgeNumbers.append(!toIndex)

    !solution.edges.append(!from)
    !solution.edges.append(!edgeArc)
    !solution.edges.append(!to)
    !solution.edgeIndex = !solution.edges.size()

  -- [1] End
  endif

  -- Return, unresolved corner
  if(!edgeArc.unset()) then
    !!error.text = 'Unable to fit arc between edges.'
    return object DBELOOPSOLUTION()

  -- Define solution
  else
    return !solution
  endif

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      tangentialEnds
--
-- Description: Returns an array of booleans, true for each end when it is tangential to its adjacent
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two element array [1] start tangency
--                                  [2] end tangency
--
------------------------------------------------------------------------

define method .tangentialEnds(!edgeIndex is REAL) is ARRAY

  -- Initialise Variables
  !adjacentIndex[1] = !this.previous(!edgeIndex)
  !adjacentIndex[2] = !this.next(!edgeIndex)

  -- Edge types
  !edge             = !this.profile.edge(!edgeIndex)

  -- Direction of edge
  if(!edge.objectType() eq 'LINE') then
    !direction[1] = !edge.direction()
    !direction[2] = !direction[1].opposite()
    !position[1]  = !edge.startPosition
    !position[2]  = !edge.endPosition
  else
    !direction[1] = !edge.startTangent()
    !direction[2] = !edge.endTangent().opposite()
    !position[1]  = !edge.anglePosition(!edge.startAngle)
    !position[2]  = !edge.anglePosition(!edge.endAngle)
  endif

  -- Get data of adjacent elements
  do !i from 1 to 2
    !adjacent[!i]            = !this.profile.edge(!adjacentIndex[!i])

    -- Direction of edge
    if(!adjacent[!i].objectType() eq 'LINE') then
      if(!i eq 1) then
        !adjacentDirection = !adjacent[!i].direction().opposite()
      else
        !adjacentDirection = !adjacent[!i].direction()
      endif
    else
      if(!i eq 1) then
        !adjacentDirection = !adjacent[!i].endTangent().opposite()
      else
        !adjacentDirection = !adjacent[!i].startTangent()
      endif
    endif
    !return[!i] = !direction[!i].angle(!adjacentDirection) ge 180 - !this.nearAngle
  enddo

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentialLineEdge
--
-- Description: Resolves an edge between the passed to edges to be tangential
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        From index
--    2   R      REAL        To index
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .tangentialLineEdge(!fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)
  !from               = !this.profile.edge(!fromIndex)
  !to                 = !this.profile.edge(!toIndex)

  -- Get tangent line
  !tangentLine        = !this.tangentLine(!from, !to)


  -- Get best intersection
  if(!tangentLine.set()) then
    !solution.edges.append(!from)
    !solution.edges.append(!tangentLine)
    !solution.edgeIndex = 2
    !solution.edges.append(!to)
    return !solution
  else
    !!error.text = 'Unable to resolve tangential edge (' & !!error.text & ').'
    return object DBELOOPSOLUTION()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Tangent line between the passed arcs, using the sense as the controlling mechanism to determine the tangent line used
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARC         First Arc
--    2   RW     ARC         Second Arc
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is ARC, !to is ARC) is LINE

  -- Technique to derive the tangent line of two arcs, using the sense of the arc
  !xyFrom     = !this.plane.xyOffset(!from.position)
  !x1         = !xyFrom.x
  !y1         = !xyFrom.y
  !r1         = !from.radius
  if(!from.sense.not()) then
    !r1       = !r1 * -1
  endif

  !xyTo       = !this.plane.xyOffset(!to.position)
  !x2         = !xyTo.x
  !y2         = !xyTo.y
  !r2         = !to.radius
  if(!to.sense.not()) then
    !r2       = !r2 * -1
  endif

  -- Vector D from centre to centre
  !dx = !x2 - !x1
  !dy = !y2 - !y1
  !jx = -1 * !dy
  !jy = !dx

  -- Length of D
  !dl = sqrt(!dx * !dx + !dy * !dy)
  !f  = (!r1 - !r2) / !dl

  !ff = !f * !f

  !f0 = sqrt(1 - !ff)

  -- Handle invalid tangent
  handle ANY
    !!error.text = 'No derivable tangent line for arcs'
    return object LINE()
  endhandle

  !f1 = !r1 / !dl
  !f2 = !r2 / !dl
  !d1 = !f * !dx - !f0 * !jx
  !d2 = !f * !dy - !f0 * !jy
  !start = !this.plane.threeDPosition(object XYPOSITION(!x1 + !f1 * !d1, !y1 + !f1 * !d2))
  !end   = !this.plane.threeDPosition(object XYPOSITION(!x2 + !f2 * !d1, !y2 + !f2 * !d2))
  !line = object LINE(!start, !end)

  -- Redefine start/end of adjacent edges
  -- If from arc has a radius of zero, then we have most probable passed
  -- a dummy arc to resolve a point to arc tangent line. In this case, we
  -- will ignore the setting of the from arc
  if(!from.radius gt 0) then
    !from.endAngle = !from.near(!line.startPosition)
  endif

  if(!to.radius gt 0) then
    !to.startAngle = !to.near(!line.endPosition)
  endif

  return !line

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Tangent line between the passed arc and line, using the sense and start of line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARC         Arc
--    2   RW     LINE        Line
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is ARC, !to is LINE) is LINE

  -- Initialise Variables
  !arc    = !this.reverseEdge(!from)
  !line   = !to.reverseSense()

  -- Derive tangent line
  !tangentLine   = !this.tangentLine(!line, !arc)

  -- Invert the definitions
  if(!tangentLine.set()) then
    !from        = !this.reverseEdge(!arc)
    !to          = !line.reverseSense()
    !tangentLine = !tangentLine.reverseSense()
  endif

  -- Return
  return !tangentLine

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Tangent line between the passed line and arc, using the sense and end of line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       LINE        Line
--    2   RW      ARC         Arc
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is LINE, !to is ARC) is LINE

  -- To maintain sense of the tangent, we will convert the line to
  -- a zero radius arc
  !fromArc = object ARC(!from.endPosition, !to.orientation, 0, 180, 0, !to.sense)
  return !this.tangentLine(!fromArc, !to)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Forces a unset line to be returned
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line
--    2   R      LINE        Line
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is LINE, !to is LINE) is LINE
  return object LINE(!from.endPosition, !to.startPosition)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Tangent line between the passed point and arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
--    2   RW     ARC         Arc
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is POSITION, !to is ARC) is LINE

  -- To maintain sense of the tangent, we will convert the line to
  -- a zero radius arc
  !fromArc = object ARC(!from, !to.orientation, 0, 180, 0, !to.sense)
  return !this.tangentLine(!fromArc, !to)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Tangent line between the passed arc and point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARC         Arc
--    2   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is ARC, !to is POSITION) is LINE

  -- To maintain sense of the tangent, we will convert the line to
  -- a zero radius arc
  !toArc = object ARC(!to, !from.orientation, 0, 180, 0, !from.sense)
  return !this.tangentLine(!from, !toArc)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentLine
--
-- Description: Tangent line between the passed points (line definition, but is defined for completeness)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
--    2   R      POSITION    Position
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentLine(!from is POSITION, !to is POSITION) is LINE
  return object LINE(!from, !to)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed arcs, using the sense as the controlling mechanism to determine the tangent arc used
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   RW     ARC         First Arc
--    3   RW     ARC         Second Arc
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    ARC         Defined arc
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is ARC, !to is ARC, !concave is BOOLEAN) is ARC

  -- Initialise Variables
  !sense       = !concave.eq(!this.profile.sense())

  !tangentLine = !this.tangentLine(!from, !to)

  -- Handle zero radius arc at the start
  if(!from.radius eq 0) then
    !fromStart = !from.position
    !fromEnd   = !from.position
  else
    !fromStart = !from.anglePosition(!from.startAngle)
    !fromEnd   = !from.anglePosition(!from.endAngle)
  endif

  -- Handle zero radius arc at the end
  if(!to.radius eq 0) then
    !toStart   = !to.position
    !toEnd     = !to.position
  else
    !toStart   = !to.anglePosition(!to.startAngle)
    !toEnd     = !to.anglePosition(!to.endAngle)
  endif

  -- Check that the radius is at least will fit
  !minimumRadius = (!from.position.distance(!to.position) - !from.radius - !to.radius) / 2
  if(!minimumRadius gt !radius) then
    !!error.text = 'Unable to fit arc between arcs, minimum radius must be (' & !minimumRadius & ')'
    return object ARC()
  endif

  -- Arc between arcs of the same sense
  if(!from.sense eq !to.sense) then

    -- Concave arc
    if(!concave) then
      !radiusFrom = !radius + !from.radius
      !radiusTo   = !radius + !to.radius
      !offsetFlag = !from.sense.not()

    -- Convex arc
    else
      !radiusFrom = !radius - !from.radius
      !radiusTo   = !radius - !to.radius
      !offsetFlag = !from.sense

      -- If it is not possible to fit a convex arc, revert to concave
      if(!radiusFrom le 0 or !radiusTo le 0) then
        !radiusFrom = !radius + !from.radius
        !radiusTo   = !radius + !to.radius
        !offsetFlag = !from.sense.not()
      endif
    endif

  -- Arcs of different sense
  else

    -- Concave arc
    if(!concave) then
      !radiusFrom = !radius + !from.radius
      !radiusTo   = !radius - !to.radius
      !offsetFlag = !from.sense.not()

    -- Convex arc
    else
      !radiusFrom = !radius - !from.radius
      !radiusTo   = !radius + !to.radius
      !offsetFlag = !from.sense
    endif

  endif

  -- Define modified arcs
  !fromArc         = !from
  !fromArc.radius  = !radiusFrom
  !toArc           = !to
  !toArc.radius    = !radiusTo

  -- Get intersections of points
  !intersections   = !fromArc.intersections(!toArc)

  -- If there are less that two intersections points, then we can not resolve the fitting of an arc
  if(!intersections.size() le 1) then
    !!error.text   = 'Unable to fit arc between adjacent arcs.'
    return object ARC()
  endif

  -- Centre line between the two arcs
  !centreLine      = !from.position.line(!to.position)

  do !i indices !intersections
    !arc[!i]            = !fromArc
    !arc[!i].position   = !fromArc.anglePosition(!intersections[!i])
    !arc[!i].sense      = !offsetFlag
    !arc[!i].radius     = !radius
    !arc[!i].startAngle = !arc[!i].near(!from.position)
    !arc[!i].endAngle   = !arc[!i].near(!to.position)
  enddo

  -- Define tangent arc
  if(!arc[1].angle() le !arc[2].angle()) then
    !edgeArc = !arc[1]
  else
    !edgeArc = !arc[2]
  endif

  -- Modify adjacent
  if(!from.radius gt 0) then
    !from.endAngle    = !from.near(!edgeArc.anglePosition(!edgeArc.startAngle))
  endif
  if(!to.radius gt 0) then
    !to.startAngle    = !to.near(!edgeArc.anglePosition(!edgeArc.endAngle))
  endif

  -- Return
  return !edgeArc

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed arc and line, using the sense and start of line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   RW     ARC         Arc
--    3   R      LINE        Line
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is ARC, !to is LINE, !concave is BOOLEAN) is ARC
  return !this.tangentArc(!radius, !from, !to.startPosition, !concave)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed line and arc, using the sense and end of line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   R      LINE        Line
--    3   RW     ARC         Arc
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is LINE, !to is ARC, !concave is BOOLEAN) is ARC
  return !this.tangentArc(!radius, !from.endPosition, !to, !concave)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed arc and point, using the sense of the arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   RW     ARC         Arc
--    3   R      POSITION    Position
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is ARC, !to is POSITION, !concave is BOOLEAN) is ARC

  -- Initialise Variables
  !arc          = !this.reverseEdge(!from)

  -- Derive tangent line
  !tangentArc   = !this.tangentArc(!radius, !to, !arc, !concave)

  -- Invert the definitions
  if(!tangentArc.set()) then
    !from       = !this.reverseEdge(!arc)
    !tangentArc = !this.reverseEdge(!tangentArc)
    return !tangentArc
  else
    return object ARC()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed point and arc, using the sense of the arc
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   R      POSITION    Position
--    3   RW     ARC         Arc
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is POSITION, !to is ARC, !concave is BOOLEAN) is ARC

  !arc = object ARC(!from, !to.orientation, 0, 90, 0, !to.sense)
  return !this.tangentArc(!radius, !arc, !to, !concave)

--   !position      = !to.plane().near(!from)
--   !distance      = !to.position.distance(!position)
--   !!error.text   = 'TangentArc Position - Arc'
--
--   -- Handle positions within the arc
--   if(!distance le !to.radius) then
--     !!error.text = 'The point must lie outside the arc definition.'
--     return object ARC()
--   endif
--
--   -- Check that we can create a curve between the point and the arc
--   -- i.e. the distance from the point to the centre, must be equal or
--   -- less than  r(of arc) + R(new radius) * 2
--   !minimum  = !to.radius + !radius * 2
--   if(!distance gt !minimum) then
--     !!error.text = 'Minimum distance between point and arc must be ' & !minimum.string(!!distanceFmt) & '.'
--     return object ARC()
--   endif
--
--   -- Determine the tangent side
--   !tangentLine   = !this.tangentLine(!from, !to)
--
--
--
--   pin1 at $!tangentLine.startPosition
--   pin2 at $!tangentLine.endPosition
--
--   -- Return
--   return object ARC()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed line and line (user end and start of line)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   R      LINE        Line
--    3   R      LINE        Line
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is LINE, !to is LINE, !concave is BOOLEAN) is ARC
  return !this.tangentArc(!radius, !from.endPosition, !to.startPosition, !concave)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tangentArc
--
-- Description: Tangent arc between the passed positions. Concave is assumed to be into the profile.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Radius of arc
--    2   R      POSITION    From point
--    3   R      POSITION    To point
--    4   R      BOOLEAN     Concave/Convex flag
-- Return:
--   [Data Type] [Description]
--    LINE        Defined Line
--
------------------------------------------------------------------------

define method .tangentArc(!radius is REAL, !from is POSITION, !to is POSITION, !concave is BOOLEAN) is ARC

  -- Initialise Variables
  !arc            = object ARC()

  -- Derive side of arc's centre
  !side           = !concave.eq(!this.profile.sense())

  -- Direction
  !direction      = !from.direction(!to)
  if(!side) then
    !direction    = !this.plane.direction().orthogonal(!direction)
  else
    !direction    = !direction.orthogonal(!this.plane.direction())
  endif

  -- Orientation of arc
  !orientation    = object ORIENTATION('Z is ' & !this.plane.direction() & ' and Y is ' & !direction)

  -- Basic arc definition
  !arc            = object ARC(!from.midPoint(!to), !orientation, 0, 90, !radius, true)

  -- Offset arc if it is > than the distance between the positions
  if(!radius gt !from.distance(!to) / 2) then
    !newArc       = !arc.chord(!from.distance(!to))
    !arc.position = !arc.position.offset(!direction.opposite(), !arc.radius - !newArc.chordHeight())
  endif

  -- Set sense
  !arc.sense      = !side.not()

  -- Define start/end angle
  !arc.startAngle = !arc.near(!from)
  !arc.endAngle   = !arc.near(!to)

  -- Return
  return !arc


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror boundary about a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Mirror Line
--    2   R      REAL        From Edge
--    3   R      REAL        To Edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .mirror(!line is LINE, !fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)

  -- Get a copy of the profile
  !profile = object PROFILE(!this.profile)

  -- Mirror the profile
  !profile.mirror(!line)

  !solution.edges     = !profile.edges()
  !solution.edgeIndex = !fromIndex

  -- Return
  return !solution

endmethod
-- End of method of .previous(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      translate
--
-- Description: Move whole boundary about a line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X offset
--    2   R      REAL        Y offset
--    3   R      REAL        From Edge
--    4   R      REAL        To Edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .translate(!x is REAL, !y is REAL, !fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)

  -- Get a copy of the profile
  !profile = object PROFILE(!this.profile)

  -- Mirror the profile
  !profile.translate(!x, !y)

  !solution.edges     = !profile.edges()
  !solution.edgeIndex = !fromIndex

  -- Return
  return !solution

endmethod
-- End of method of .previous(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate about a point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  Point of rotation
--    2   R      REAL        Rotation angle
--    3   R      REAL        From Edge
--    4   R      REAL        To Edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .rotate(!xyPosition is XYPOSITION, !angle is REAL, !fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)

  -- Get a copy of the profile
  !profile = object PROFILE(!this.profile)

  -- Mirror the profile
  !profile.rotate(!angle, !this.plane().threeDPosition(!xyPosition))

  !solution.edges     = !profile.edges()
  !solution.edgeIndex = !fromIndex

  -- Return
  return !solution

endmethod
-- End of method of .previous(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      reverse
--
-- Description: Reverse sense of edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        From Edge
--    2   R      REAL        To Edge
-- Return:
--   [Data Type] [Description]
--    DBELOOPSOLUTION  Solution to the passed problem
--
------------------------------------------------------------------------

define method .reverse(!fromIndex is REAL, !toIndex is REAL) is DBELOOPSOLUTION

  -- Initialise Variables
  !solution            = object DBELOOPSOLUTION()

  -- Range of edges to be included in the modify list
  !solution.edgeNumbers.append(!fromIndex)
  !solution.edgeNumbers.appendArray(!this.range(!fromIndex, !toIndex))
  !solution.edgeNumbers.append(!toIndex)

  -- Get a copy of the profile
  !profile = object PROFILE(!this.profile)

  -- Mirror the profile
  !profile.reverse()

  !solution.edges     = !profile.edges()
  !solution.edgeIndex = !fromIndex

  -- Return
  return !solution

endmethod
-- End of method of .previous(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      adjacent
--
-- Description: Return edge at the passed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    ARRAY       Index of edges to either side of the edge
--
------------------------------------------------------------------------

define method .adjacent(!index is REAL) is ARRAY

  -- Initialise Variables
  !return  = ARRAY()

  -- Check index is valid
  if(!this.size eq 0 or !this.size lt !index) then
    !!error.text = 'Value out of range'
    return ARRAY()
  endif

  -- Get previous and next indices
  !return[1] = !this.previous(!index)
  !return[2] = !this.next(!index)

  -- Return
  return !return

endmethod
-- End of method of .adjacent(REAL) ANY

------------------------------------------------------------------------
--
-- Method:      previous
--
-- Description: Return previous edge index of passed edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    REAL        Previous edge index number
--
------------------------------------------------------------------------

define method .previous(!index is REAL) is REAL

  -- If index is at the start of the definition, return the last
  if(!index le 1) then
    return !this.size
  else
    return !index - 1
  endif
endmethod
-- End of method of .previous(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      next
--
-- Description: Return next edge index of passed edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Edge index
-- Return:
--   [Data Type] [Description]
--    REAL        Next edge index number
--
------------------------------------------------------------------------

define method .next(!index is REAL) is REAL

  -- If index is at the start of the definition, return the last
  if(!index ge !this.size) then
    return 1
  else
    return !index + 1
  endif

endmethod
-- End of method of .next(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: Replace current profile definition with passed array of lines and arcs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       New profile definition as lines and arcs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace(!newDefinition is ARRAY)

  -- Initialise Variables
  !definition = !newDefinition
  !definition.compress()

  !this.profile = object PROFILE(!this.plane.position, !this.plane.orientation, !definition)
  !this.profile.close()
  !this.size    = !this.profile.numberEdges()
  handle ANY
    !this.size  = 0
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: Replace current profile definition with passed profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     New profile definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace(!profile is PROFILE)

  -- Initialise Variables
  !this.plane   = !profile.plane()
  !this.profile = !profile
  !this.profile.close()
  !this.size    = !this.profile.numberEdges()
  handle ANY
    !this.size  = 0
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      range
--
-- Description: Returns the range of edges for the passed from-to items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        From
--    2   R      REAL        To
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of edges within the range (excluding the from and to values)
--
------------------------------------------------------------------------

define method .range(!from is REAL, !to is REAL) is ARRAY

  -- Initialise Variables
  !range = ARRAY()

  -- Edge not bridging the closing edge
  if(!from le !to) then
    do !i from !from to !to
      !range.append(!i)
    enddo

  -- Edge bridging the closing edge
  elseif (!from gt !to) then
    do !i from !from to !this.profile.edges().size()
      !range.append(!i)
    enddo
    do !i from 1 to !to
      !range.append(!i)
    enddo
  endif

  -- Remove the first and last element of the array (as these are derived from the resolveEdge)
  !range.remove(1)
  if(!range.empty().not()) then
    !range.remove(!range.size())
  endif

  -- Return
  return !range

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dumpDefinition
--
-- Description: Dump definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dumpDefinition()

  -- Initialise Variables
  !array      = ARRAY()
  !array.append('!!boundary = ARRAY()')
  !definition = !this.definition()

  do !i indices !definition

    if(!definition[!i].objectType() eq 'LINE') then
      !line = !definition[!i]
      !array.append('!!boundary.append(object LINE(' & !line.startPosition & ' , ' & !line.endPosition & ' ))')
    elseif (!definition[!i].objectType() eq 'ARC') then
      !arc  = !definition[!i]
      !array.append('!!boundary.append(object ARC(' & !arc.position & ' , ' & !arc.orientation & ' , ' & !arc.startAngle & ' , ' & !arc.endAngle & ' , ' & !arc.radius & ' , ' & !arc.sense & '))')
    endif

  enddo

  -- Write to file
  !file = object FILE('boundary.pmlmac')
  !file.writefile('overwrite',!array)
  !file.close()

endmethod
-- End of method
