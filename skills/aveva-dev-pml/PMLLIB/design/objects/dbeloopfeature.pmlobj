--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Jan 7 12:05:10 "GMT 2000
--
--
-- Description:
-- Loop feature object.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbeloopfeature(DBELOOPFEATURE)   -                   Constructor, using passed feature
--  dbeloopfeature(PROFILE)          -                   Constructor, using passed profile
--  dbeloopfeature(PROFILE,STRING)   -                   Constructor, using passed profile and description
--  features(DBREF)                  ARRAY               Returns the all profiles for passed element
--  intersect(PLANE)                 -                   Intersect the profile onto the plane
--  limits()                         -                   Sets the limits of the passed profiles
--  mirror(STRING)                   -                   Mirror about axes
--  onto(PLANE)                      -                   Set plane to passed plane making position and orientate of the feature the same as the plane
--  origin(POSITION)                 -                   Modify origin of feature
--  position(POSITION)               -                   Modify position of feature
--  project(PLANE)                   -                   Project the profile onto the passed plane
--  rotate(REAL)                     -                   Rotate about axes by given angle
--
------------------------------------------------------------------------

define object DBELOOPFEATURE

  -- Description
  member .description is STRING

  -- Profile
  member .profile     is PROFILE

  -- Limits of the feature (Array of XYPOSITION's)
  member .limits      is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeloopfeature
--
-- Description: Constructor, using passed profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeloopfeature(!profile is PROFILE)

  -- Initialise Variables
  !this.profile     = object PROFILE(!profile)
  !this.description = STRING()
  !this.limits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeloopfeature
--
-- Description: Constructor, using passed profile and description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile definition
--    2   R      STRING      Description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeloopfeature(!profile is PROFILE, !description is STRING)

  -- Initialise Variables
  !this.profile     = object PROFILE(!profile)
  !this.description = !description
  !this.limits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeloopfeature
--
-- Description: Constructor, using passed feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOPFEATURE Feature definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeloopfeature(!feature is DBELOOPFEATURE)

  -- Initialise Variables
  if(!feature.profile.unset()) then
    !this.profile     = object PROFILE()
    !this.description = STRING()
    !this.limits.clear()
  else
    !this.profile     = object PROFILE(!feature.profile)
    !this.description = !feature.description
    !this.limits      = !feature.limits
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Modify position of feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Initialise Variables
  !this.profile.position = !this.profile.plane().near(!position)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      origin
--
-- Description: Modify origin of feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New origin
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origin(!position is POSITION)

  -- Initialise Variables
  !plane      = !this.profile.plane()

  -- Get new position in terms of the plane
  !xyPosition = !plane.xyOffset(!position)

  -- Offset the profile
  !this.profile.translate(!xyPosition.x * -1, !xyPosition.y * -1)

  -- Move origin to new position
  !this.profile.position = !plane.near(!position)

  -- Set limits
  !this.limits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      onto
--
-- Description: Set plane to passed plane making position and orientate of the feature the same as the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE     Profile definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .onto(!plane is PLANE)

  -- Initialise Variables
  !this.profile.position    = !plane.position
  !this.profile.orientation = !plane.orientation

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      project
--
-- Description: Project the profile onto the passed plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .project(!plane is PLANE)

  -- Initialise Variables
  !position = !plane.near(!this.profile.position)

  -- Profile and plane are in the same direction
  if(!plane.direction().angle(!this.profile.plane().direction()) eq 0) then
    !this.profile.position = !position

  -- Profile and plane are parallel
  elseif (!plane.direction().isParallel(!this.profile.plane().direction())) then
    !edges        = !this.profile.edges()
    !this.profile = object PROFILE(!position, !plane.orientation, !edges)

  -- Convert profile into a polyline
  else
    !polyline     = !this.profile.polyline(0.5)
    !edges        = !polyline.edges()
    !this.profile = object PROFILE(!position, !plane.orientation, !edges)

  endif

  -- Set limits
  !this.limits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      intersect
--
-- Description: Intersect the profile onto the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .intersect(!plane is PLANE)

  -- Initialise Variables
  !profilePlane = !this.profile.plane()
  !position     = !plane.intersection(!profilePlane.pointVector())

  -- Profile and plane are in the same direction
  if(!plane.direction().angle(!this.profile.plane().direction()) eq 0) then
    !this.profile.position = !position

  -- Profile and plane are parallel
  elseif (!plane.direction().isParallel(!this.profile.plane().direction())) then
    !edges        = !this.profile.edges()
    !this.profile = object PROFILE(!position, !plane.orientation, !edges)

  -- Convert profile into a polyline
  else

    !polyline     = !this.profile.polyline(0.5)
    !edges        = !polyline.edges()
    !direction    = !profilePlane.direction()
    do !j indices !edges
      !lines[!j]  = object LINE(!plane.intersection(object POINTVECTOR(!edges[!j].startPosition, !direction)), !plane.intersection(object POINTVECTOR(!edges[!j].endPosition, !direction)))
    enddo
    !this.profile = object PROFILE(!position, !plane.orientation, !lines)

  endif

  -- Set limits
  !this.limits()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror about axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror(!axes is STRING)

  if(!axes.upcase() eq 'X') then
    !pv = object POINTVECTOR(!this.profile.position, !this.profile.orientation.xDir())
  else
    !pv = object POINTVECTOR(!this.profile.position, !this.profile.orientation.yDir())
  endif

  !line = !pv.line(1000mm)
  !this.profile.mirror(!line)

  -- Set limits
  !this.limits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate about axes by given angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL)

  !this.profile.rotate(!angle, !this.profile.position)

  -- Set limits
  !this.limits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      features
--
-- Description: Returns the all profiles for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database element
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of features
--
------------------------------------------------------------------------

define method .features(!element is DBREF) is ARRAY

  -- Initialise Variables
  !features        = ARRAY()

  -- Derive the profile from the passed item
  if(!element.hardType eq 'SCTN') then

    -- Get profile that could be used
    !geometry      = !element.gstr.members
    handle any
      !!error.text = 'Section does not have a catalogue defined profile.'
      return ARRAY()
    endhandle

    -- Catalogue component
    !component = !element.catr.flnn

    -- Get all S profiles
    do !i indices !geometry
      skip if(!geometry[!i].type ne 'SPRO')
      !index                        = !features.size() + 1
      !profile = object PROFILE(!geometry[!i], !element)
      !features[!index]             = object DBELOOPFEATURE(!profile, 'SPRO ' & !i & ' of catalogue geometry "' & !component & '"')
    enddo

    -- Check we have some profiles
    if(!features.empty()) then
      !!error.text = 'Catalogue definition of the section does not have any profiles defined.'
      return ARRAY()
    endif

    -- Offset profile using justification
    !jusLine     = !element.jusLine
    !offsetLine  = object LINE(!element.plst.attribute(!jusLine), !element.plst.attribute('NA'))

    -- Offset all profiles
    if(defined(!offsetLine) and !offsetLine.length() gt 0) then
      !direction = !offsetLine.direction()
      !offset    = !offsetLine.length()

      do !i indices !profiles
        !features[!i].position(!profiles[!i][2].position.offset(!direction, !offset))
      enddo

    endif

  -- Derive the profile from the passed item
  else

    -- Is the current element a loop
    if(!element.hardType inset('PLOO','LOOP')) then
      !loop = !element

    -- Check if we can access a loop element, either directly below the
    -- passed element or if there is one above
    else

      -- Build list of elements
      !ownerList = !element.ownLst
      !ownerList.invert()
      !members   = !element.members
      !members.appendArray(!ownerList)

      do !member values !members

        -- If the member is a loop, then we will use it
        if (!member.hardType inset('PLOO','LOOP')) then
          !loop = !member
          break
        endif
      enddo

      -- Check if there is a loop
      if(undefined(!loop)) then

        -- Can we derive an arc from the element
        !arc[1] = !!edgTypes.attribute(!element.fullType).arc(!element)
        handle ANY
          !!error.text = 'No loop element found.'
          return ARRAY()
        endhandle
        !profile = object PROFILE(!arc[1].position, !arc[1].orientation, !arc)
        !features[1]   = object DBELOOPFEATURE(!profile, 'Profile (arc) of "'& !element.flnn & '"')
        return !features

      endif

    endif

    -- Owning profile
    !owner                  = !loop.owner
    !index                  = !features.size() + 1
    !features[!index]       = object DBELOOPFEATURE(object PROFILE(!loop), 'Profile of "'& !owner.flnn & '"')

    -- If owning item is a positive, then we will also get the negative extrusions
    if(!owner.type.substring(1,1) ne 'N' or !owner.type.substring(1,1) ne 'Y') then

      -- Get all loops of the owning element
      var !loops COLLECT ALL (LOOP) FOR $!owner

      if(!loops.empty().not()) then
        do !i indices !loops
          skip if(!loops[!i].dbref() eq !loop)
          !index            = !features.size() + 1
          !features[!index] = object DBELOOPFEATURE(object PROFILE(!loops[!i].dbref()), 'Negative profile [' & !loops[!i].dbref().owner.tySequence & '] of "'& !owner.flnn & '"')
        enddo
      endif
    endif
  endif

  -- Return
  return !features

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description: Sets the limits of the passed profiles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limits()

  -- Handle unset profiles
  if(!this.profile.unset()) then
    return
  endif

  !this.limits  = !this.profile.limits()

endmethod
-- End of method
