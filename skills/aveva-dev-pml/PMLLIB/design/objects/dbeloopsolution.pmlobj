define object DBELOOPSOLUTION

  -- Solution description
  member .description is STRING

  -- Edges
  member .edges       is ARRAY

  -- Edge numbers affected
  member .edgeNumbers is ARRAY

  -- Original edge within the new edges list
  member .edgeIndex   is REAL

  -- Profile (used to pass complete profile definitions)
  member .profile     is PROFILE

endobject
-- End of object definition
