--
--  Description:     Facade object for legacy Design MOVE/DRAG commands
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   Re-initialise object
--  desMoveCommand()                 -                   Constructor
--  dragBy()                         -                   issue MOVE BY command
--  dragClearance(STRING,ANY)        -                   DRAG MOVE relative to target object
--  dragRelative(STRING,ANY)         -                   DRAG MOVE relative to target object
--  dragThrough(ANY)                 -                   DRAG MOVE relative to target object
--  dragThrough(STRING,ANY)          -                   DRAG MOVE relative to target object
--  dragTowards(ANY)                 -                   DRAG MOVE relative to target object
--  moveBy()                         -                   issue MOVE BY command
--  moveClearance(STRING,ANY)        -                   MOVE with clearance to target object
--  moveClearanceCommand(DBREF,STRING,STRING,DIRECTION,REAL,DIRECTION,STRING,ANY) -                   issue MOVE command
--  moveCommand(DBREF,STRING,STRING,DIRECTION,REAL,DIRECTION,STRING,ANY) -                   issue MOVE command
--  moveRelative(STRING,ANY)         -                   MOVE relative to target object
--  moveThrough(ANY)                 -                   DRAG MOVE relative to target object
--  moveThrough(STRING,ANY)          -                   DRAG MOVE relative to target object
--  moveThroughCommand(DBREF,STRING,STRING,DIRECTION,DIRECTION,ANY) -                   issue MOVE command
--  moveTowards(ANY)                 -                   MOVE with clearance to target object
--  moveTowardsCommand(DBREF,STRING,STRING,REAL,ANY) -                   issue MOVE command
--  setClearance(REAL)               -                   Set clearance from target
--  setDirection(DIRECTION)          -                   Set direction to move
--  setDistance(REAL)                -                   Set distance to move
--  setElement(DBREF)                -                   Set element to modify (from element origin)
--  setElement(DBREF,REAL)           -                   Set element to modify (from P-point)
--  setOrigin(STRING)                -                   Set origin key for move
--  setPlane(DIRECTION)              -
--  setTarget(DBREF)                 -                   Set target element
--  setTarget(POSITION)              -                   Set target position
--  setTarget(STRING)                -                   Set target special case function
--
----------------------------------------------------------------------

define object DESMOVECOMMAND

  -- element to move
  member .element             is DBREF
  -- reference (from) key
  member .from                is STRING
  -- direction to move
  member .direction           is DIRECTION
  member .worldDirection      is DIRECTION
  -- distance or clearance (depending on the command)
  member .distance            is REAL
  -- target type
  member .targetType          is STRING
  -- target element
  member .targetElement       is DBREF
  -- status indicator - one per row
  member .targetPosition      is POSITION
  -- plane move direction
  member .planeDirection      is DIRECTION
  -- function
  member .function            is STRING
  -- aids
  member .aidNumber           is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      desMoveCommand
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .desMoveCommand()

  -- Aids
  !this.aidNumber = !!aidNumbers.add('DesignMove')

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Re-initialise object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()

  -- Initialise Variables
  !this.element         = object DBREF()
  !this.from            = '0'
  !this.direction       = object DIRECTION()
  !this.worldDirection  = object DIRECTION()
  !this.planeDirection  = object DIRECTION()
  !this.distance        = 0mm
  !this.targetType      = ''
  !this.targetElement   = object DBREF()
  !this.targetPosition  = object POSITION()
  !this.function        = ''

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      setElement
--
