-- End of method
-------------------------------------------------------------------
--
-- Method:      moveBy
--
-- Description: issue MOVE BY command
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveBy()

  !direction = !this.direction
  !distance  = !this.distance
  !!ce       = !this.element

  -- handle special pipe head, pipe tail case
  if( !this.from inset('PH', 'PT') ) then
    !fromKey = !this.from
    BRANCH
  else
    !fromKey = ''
  endif

  -- try move command
  MOVE $!fromKey $!direction DIST $!distance
  handle(2,107)
    -- WRT element deleted - use world instead
    !direction = !this.worldDirection
    MOVE $!fromKey $!direction DIST $!distance
  endhandle

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      moveRelative
--
-- Description: MOVE relative to target object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveRelative(!option is STRING, !target is ANY)

  if( badref( !this.direction.origin ) ) then
    -- use saved world direction
    !direction = !this.worldDirection
  else
    !direction = !this.direction
  endif

  !this.moveCommand(!this.element, 'MOVE', !this.from, !direction, !this.distance, !this.planeDirection, !option, !target)

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      dragBy
--
-- Description: issue MOVE BY command
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dragBy()

  !direction = !this.direction
  !distance  = !this.distance
  !!ce       = !this.element

  -- handle special pipe head, pipe tail case
  if( !this.from inset('PH', 'PT') ) then
    !fromKey = !this.from
    BRANCH
  else
    !fromKey = ''
  endif

  -- try move command
  DRAG MOVE $!fromKey $!direction DIST $!distance
  handle(2,107)
    -- WRT element deleted - use world instead
    !direction = !this.worldDirection
    DRAG MOVE $!direction DIST $!distance
  elsehandle(61,154)
    !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
  endhandle

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      dragRelative
