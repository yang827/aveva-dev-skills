-------------------------------------------------------------------
--
-- Method:      moveCommand
--
-- Description: issue MOVE command
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCommand(!element is DBREF, !command is STRING, !origin is STRING, !direction is DIRECTION, !distance is REAL, !planeDirection is DIRECTION, !option is STRING, !target is ANY)

  if( !target.objectType() inset('DBREF','POSITION') ) then
    !commandTail = !target.string()
  elseif( !target.objectType() eq 'STRING' ) then
    !commandTail = !target
  else
    return ERROR 1 'Error in Move arguments'
  endif

  -- set plane syntax if required
  if( !planeDirection.unset() ) then
    !planeCommand = ''
  else
    !planeCommand = 'PLANE ' + !planeDirection.string()
  endif

 !!ce  = !element

  -- handle special pipe head, pipe tail case
  if( !origin inset('PH', 'PT') ) then
    !fromKey = !origin
    BRANCH
  else
    !pPoint  = !origin.real()
    handle any
      !fromKey = ''
    elsehandle none
      !fromKey = 'P' + !pPoint.string('D0')
      if( !pPoint eq 0 ) then
        -- allow for elements without P0
        !fromKey = ''
      endif
    endhandle
  endif

  -- try move command
  if( !commandTail inset('NEXT','PREV') ) then
    -- NEXT and PREV move command on pipe items
    $!command $!fromKey $!direction $!planeCommand DISTANCE $!distance $!option $!commandTail
		handle (41,66) (2,113)
	  	var !mode MODE
	    if (!mode eq 'Forwards') then
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PT'
	      else
	        !commandTail = 'PH'
	      endif
	    else
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PH'
	      else
	        !commandTail = 'PT'
	      endif
	    endif
  		-- Modified MOVE command
      $!command $!fromKey $!direction $!planeCommand DISTANCE $!distance $!option $!commandTail
      handle(61,154)
        -- drag broken connection
        !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
      endhandle
    elsehandle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
	  endhandle
  else
    -- move command for other cases (TAIL, HEAD, CE)
    $!command $!fromKey $!direction $!planeCommand DISTANCE $!distance $!option $!commandTail
    handle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
    endhandle
  endif

endmethod
-- End of method
-------------------------------------------------------------------
--
-- Method:      moveClearanceCommand
--
-- Description: issue MOVE command
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveClearanceCommand(!element is DBREF, !command is STRING, !origin is STRING, !direction is DIRECTION, !distance is REAL, !planeDirection is DIRECTION, !option is STRING, !target is ANY)

  if( !target.objectType() inset('DBREF','POSITION') ) then
    !commandTail = !target.string()
  elseif( !target.objectType() eq 'STRING' ) then
    !commandTail = !target
  else
    return ERROR 1 'Error in Move arguments'
  endif

  -- set plane syntax if required
  if( !planeDirection.unset() ) then
    !planeCommand = ''
  else
    !planeCommand = 'PLANE ' + !planeDirection.string()
  endif

  !fromKey = ''
  if( !origin.trim().empty().not() ) then
    !pPoint  = !origin.real()
    handle any
      -- not a p-point
      !fromKey = !origin
    elsehandle none
      -- P-point
      !fromKey = 'P' + !pPoint.string('D0')
      if( !pPoint eq 0 ) then
        -- allow for elements without P0
        !fromKey = ''
      endif
    endhandle
  endif

 !!ce  = !element

  -- try move command
  if( !commandTail inset('NEXT','PREV') ) then
    -- NEXT and PREV move command on pipe items
    $!command $!fromKey $!direction $!planeCommand CLEARANCE $!distance $!option $!commandTail
		handle (41,66) (2,113)
	  	var !mode MODE
	    if (!mode eq 'Forwards') then
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PT'
	      else
	        !commandTail = 'PH'
	      endif
	    else
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PH'
	      else
	        !commandTail = 'PT'
	      endif
	    endif
  		-- Modified MOVE command
      $!command $!fromKey $!direction $!planeCommand CLEARANCE $!distance $!option $!commandTail
      handle(61,154)
        -- drag broken connection
        !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
      endhandle
    elsehandle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
		endhandle
  else
    -- move command for other cases (TAIL, HEAD, CE)
    $!command $!fromKey $!direction $!planeCommand CLEARANCE $!distance $!option $!commandTail
    handle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
    endhandle
  endif

endmethod
-- End of method
-------------------------------------------------------------------
--
-- Method:      moveThroughCommand
--
-- Description: issue MOVE command
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveThroughCommand(!element is DBREF, !origin is STRING, !command is STRING, !direction is DIRECTION, !planeDirection is DIRECTION, !target is ANY)

  if( !target.objectType() inset('DBREF','POSITION') ) then
    !commandTail = !target.string()
  elseif( !target.objectType() eq 'STRING' ) then
    !commandTail = !target
  else
    return ERROR 1 'Error in Move arguments'
  endif

  -- set plane syntax if required
  if( !planeDirection.unset() ) then
    !planeCommand = ''
  else
    !planeCommand = 'PLANE ' + !planeDirection.string()
  endif

  !fromKey = ''
  if( !origin.trim().empty().not() ) then
    !pPoint  = !origin.real()
    handle any
      -- not a p-point
      !fromKey = !origin
    elsehandle none
      -- P-point
      !fromKey = 'P' + !pPoint.string('D0')
      if( !pPoint eq 0 ) then
        -- allow for elements without P0
        !fromKey = ''
      endif
    endhandle
  endif

  !!ce  = !element

  -- try move command
  if( !commandTail inset('NEXT','PREV') ) then
    -- NEXT and PREV move command on pipe items
    $!command $!fromKey $!direction $!planeCommand THROUGH $!commandTail
		handle (41,66) (2,113)
	  	var !mode MODE
	    if (!mode eq 'Forwards') then
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PT'
	      else
	        !commandTail = 'PH'
	      endif
	    else
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PH'
	      else
	        !commandTail = 'PT'
	      endif
	    endif
  		-- Modified MOVE command
      $!command $!fromKey $!direction $!planeCommand THROUGH $!commandTail
      handle(61,154)
        -- drag broken connection
        !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
      endhandle
    elsehandle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
		endhandle
  else
    -- move command for other cases (TAIL, HEAD, CE)
    $!command $!fromKey $!direction $!planeCommand THROUGH $!commandTail
    handle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
    endhandle
  endif

endmethod
-- End of method
-------------------------------------------------------------------
--
-- Method:      moveTowardsCommand
--
-- Description: issue MOVE command
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveTowardsCommand(!element is DBREF, !command is STRING, !origin is STRING, !distance is REAL, !target is ANY)

  if( !target.objectType() inset('DBREF','POSITION') ) then
    !commandTail = !target.string()
  elseif( !target.objectType() eq 'STRING' ) then
    !commandTail = !target
  else
    return ERROR 1 'Error in Move arguments'
  endif

  !fromKey = ''
  if( !origin.trim().empty().not() ) then
    !pPoint  = !origin.real()
    handle any
      !fromKey = !origin
    elsehandle none
      !fromKey = 'P' + !pPoint.string('D0')
      if( !pPoint eq 0 ) then
        -- allow for elements without P0
        !fromKey = ''
      endif
    endhandle
  endif

  !!ce  = !element

  -- try move command
  if( !commandTail inset('NEXT','PREV') ) then
    -- NEXT and PREV move command on pipe items
    $!command $!fromKey TOWARDS $!commandTail DISTANCE $!distance
		handle (41,66) (2,113)
	  	var !mode MODE
	    if (!mode eq 'Forwards') then
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PT'
	      else
	        !commandTail = 'PH'
	      endif
	    else
	      if( !commandTail eq 'NEXT' ) then
	        !commandTail = 'PH'
	      else
	        !commandTail = 'PT'
	      endif
	    endif
  		-- Modified MOVE command
      $!command  $!fromKey TOWARDS $!commandTail DISTANCE $!distance
      handle(61,154)
        -- drag broken connection
        !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
      endhandle
    elsehandle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
		endhandle
  else
    -- move command for other cases (TAIL, HEAD, CE)
    $!command  $!fromKey TOWARDS $!commandTail DISTANCE $!distance
    handle(61,154)
      -- drag broken connection
      !!alert.warning(!!error.text + ': Use UNDO to return to original position.')
    endhandle
  endif

endmethod
-- End of method
