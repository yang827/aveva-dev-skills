--    2   R      ANY         target Element or position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dragRelative(!option is STRING, !target is ANY)

  if( badref( !this.direction.origin ) ) then
    -- use saved world direction
    !direction = !this.worldDirection
  else
    !direction = !this.direction
  endif

  !this.moveCommand(!this.element, 'DRAG MOVE', !this.from, !direction, !this.distance, !this.planeDirection, !option, !target)

endmethod
-- End of method

