-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElement(!element is DBREF)

  -- Initialise Variables
  !this.element  = !element
  !this.from     = '0'

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      setElement
--
-- Description: Set element to modify (from P-point)
