-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
--  File:            desmovethroughtab.pmlobj
--    Type:          Object Definition
--    Group:         General
--      Keyword:     Design
--    Module:        Design
--  Author:          M. Barlow
--  Created:         Tue Mar 29 21:02:09 2011
--
--  Description:     Presenter object for the Move Through tab on the drag & move form (!!desDragMove).
-- This handles events and behaviour associated with the Move Through tab.
-- Take Care! - This object and its parent form are closely coupled.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyButtonClicked()             -                   Callback for APPLY button on distance tab
--  closeTab()                       -                   Event handler for tab made inactive
--  desMoveThroughTab()              -                   Constructor
--  edgPickPosition()                -                   Configure EDG for position pick
--  edgPickTarget()                  -                   Configure EDG for element pick
--  edgPickWRT()                     -                   Configure EDG for WRT element pick
--  initialiseTab(FORM)              -                   Initialise Distance tab
--  onThrSelectOptionChanged()       -                   Callback for target selection option
--  setAids(REAL,REAL)               -                   Set aid numbers to be used for source element and target
--  setDrag(BOOLEAN)                 -                   Set drag mode on or off
--  setElement(DBREF)                -                   Set element to be moved
--  setMode(STRING)                  -                   Set move mode
--  setNameGadget(DBREF)             -                   Set name gadget to given target
--  setTargetName(STRING)            -                   Set name gadget to given target name
--  setTargetPosition(EDGPOSITIONDATA) -                   Callback for EDG position pick
--  setTargetPosition(POSITION)      -                   Set target position
--  setTextBoxWrtElement(STRING)     -                   Set the text of a WRT TextBox to the value of the DBREF
--  showTab()                        -                   Event handler for tab made active
--  targetPositionFeedback(POSITION) -                   Draw target feedback (circle)
--  thrSetSelectOptionItems(STRING)  -                   Set target selection options according to current target
--  thrShowAdditionalControls(STRING) -                   Control display of controls based on target selection
--  updateElementAids()              -                   Draw element feedback (direction arrow)
--
----------------------------------------------------------------------

define object DESMOVETHROUGHTAB

  -- Members
  -- This is a presenter object for this form
  member .form               is FORM
  -- Current element
  member .element            is DBREF

  -- MOVE command wrapper object
  member .moveCommandObject  is DESMOVECOMMAND

  -- modes
  member .dragMode           is BOOLEAN
  member .mode               is STRING

  -- Coordinates
  member .targetPosition     is POSITION

  member .coordOptionString  is STRING
    -- aids
  member .aidNumber          is REAL
  member .aidTarget          is REAL
  member .enhanced           is COMENHANCE

endobject

------------------------------------------------------------------------
--
-- Method:      desMoveThroughTab
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .desMoveThroughTab()

  -- set to move mode by default
  !this.dragMode = false
  !this.mode     = ''

endmethod

------------------------------------------------------------------------
--
-- Method:      initialiseTab
--
-- Description: Initialise Distance tab
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Reference to owning form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialiseTab(!form is FORM)

  -- store reference to form
  !this.form = !form

  -- Set Move Through tab tooltips
  !this.form.thrWrtCeButton.setTooltip('Select Current Element as WRT Element')
  !this.form.thrWrtOwnerButton.setTooltip('Select Current Element Owner as WRT Element')
  !this.form.thrWrtWorldButton.setTooltip('Select World as WRT Element')
  !this.form.thrWrtPickButton.setTooltip('Pick WRT Element')
  !this.form.thrNamePickButton.setTooltip('Pick Target Element')
  !this.form.thrPickPosButton.setTooltip('Pick Target Position')
  !this.form.thrApplyButton.setTooltip('Move Element Through Target')
  !this.form.thrPlaneToggle.setTooltip('Plane Through Target')

  -- Set Move Through tab callbacks
  !this.form.thrOriginOption.callback   = '!this.mThrough.updateElementAids()'
  !this.form.thrSelectOption.callback   = '!this.mThrough.onThrSelectOptionChanged()'
  !this.form.thrDirectionText.callback  = '!this.mThrough.setTextBoxWrtElement(||)'
  !this.form.thrWrtText.callback        = '!this.mThrough.setTextBoxWrtElement(||)'
  !this.form.thrWrtCeButton.callback    = '!this.mThrough.setTextBoxWrtElement(|CE|)'
  !this.form.thrWrtOwnerButton.callback = '!this.mThrough.setTextBoxWrtElement(|OWNER|)'
  !this.form.thrWrtWorldButton.callback = '!this.mThrough.setTextBoxWrtElement(|/*|)'
  !this.form.thrWrtPickButton.callback  = '!this.mThrough.edgPickWRT()'
  !this.form.thrNameText.callback       = '!!checkName(!this.thrNameText.val, |OLD|)'
  !this.form.thrNamePickButton.callback = '!this.mThrough.edgPickTarget()'
  !this.form.thrPickPosButton.callback  = '!this.mThrough.edgPickPosition()'
  !this.form.thrApplyButton.callback    = '!this.onThrApplyButtonClicked()'
  !this.form.thrPlaneToggle.callback    = '!this.thrPlaneDirText.active = !this.thrPlaneToggle.val'

  -- Set Move Through tab icons
  !this.form.thrWrtCeButton.addPixmap(!!pml.getPathName('ce16.png'))
  !this.form.thrWrtOwnerButton.addPixmap(!!pml.getPathName('group16.png'))
  !this.form.thrWrtWorldButton.addPixmap(!!pml.getPathName('world16.png'))
  !this.form.thrWrtPickButton.addPixmap(!!pml.getPathName('pick16.png'))
  !this.form.thrNamePickButton.addPixmap(!!pml.getPathName('pick16.png'))
  !this.form.thrPickPosButton.addPixmap(!!pml.getPathName('pickpos16.png'))

  -- initialise gadgets
  !this.form.thrPlaneToggle.val         = false
  !this.coordOptionString               = 'X'
  !this.form.thrPlaneDirText.val        = !this.coordOptionString

  !this.thrShowAdditionalControls('')

  -- set to move mode by default
  !this.dragMode = false

endmethod

------------------------------------------------------------------------
--
-- Method:      .showTab
--
-- Description: Event handler for tab made active
--
------------------------------------------------------------------------

define method .showTab()

  -- Default Coordinate Values
  var !coordinate coordinate
  if(!coordinate.eq('XYZ'))then
    !this.coordOptionString = 'X'
  else
    !this.coordOptionString = 'E'
  endif

  ------------------------------------------------------
  -- Initialise Move Distance Tab Gadgets
  ------------------------------------------------------
  !this.form.thrDirectionText.val  = !this.coordOptionString
  !this.form.thrWrtText.val        = '/*'
  !this.form.thrNameText.val       = 'unset'

  -- enable plane direction if required
  !this.form.thrPlaneDirText.active = !this.form.thrPlaneToggle.val

endmethod

------------------------------------------------------------------------
--
-- Method:      closeTab
--
-- Description: Event handler for tab made inactive
--
------------------------------------------------------------------------

define method .closeTab()

  -- Remove applications events from system
  !!edgCntrl.remove('Pick Target Element')
  !!edgCntrl.remove('Pick Target Position')
  -- clear aids
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidTarget)
  -- clear highlight
  !this.enhanced.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      setDrag
--
-- Description: Set drag mode on or off
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True: Drag   False: Move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDrag(!drag is BOOLEAN)

  -- Remove applications events from system
  !this.dragMode = !drag

endmethod

------------------------------------------------------------------------
--
-- Method:      setMode
--
-- Description: Set move mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Move type: empty for basic move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMode(!mode is STRING)

  -- Remove applications events from system
  !this.mode = !mode

endmethod

------------------------------------------------------------------------
--
-- Method:      setAids
--
-- Description: Set aid numbers to be used for source element and target
--              element or position feedback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Source element aid number
--    2   R      REAL        Target element aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAids(!sourceNumber is REAL, !targetNumber is REAL)

  -- Remove applications events from system
  !this.aidNumber = !sourceNumber
  !this.aidTarget = !targetNumber

endmethod

------------------------------------------------------------------------
--
-- Method:      setTextBoxWrtElement
--
-- Description: Set the text of a WRT TextBox to the value of the DBREF
--              Defaults to WORLD if there is an error
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      WRT element name or key word
--                           ||       Name in WRT gadget
--                           |string| Name of WRT element passed as argument
--                           OWNER    Owner of this element
--                           CE       Self
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTextBoxWrtElement(!wrtText is STRING)

  if (!wrtText eq ||) then
    !wrtElement   = !this.form.thrWrtText.val.dbRef()
    handle any
      !wrtElement = World
    endhandle
  elseif (!wrtText eq |OWNER|) then
    -- climb to element with an ORI - stop at world
    !wrtElement = !!ce.owner
    handle any
      !wrtElement = World
    endhandle
    do
      if( !wrtElement.dDep eq 0 ) then
        !wrtElement = World
        break
      endif
      !unusedOrientation = !wrtElement.orientation
      handle any
        -- climb up a level because this element has no ORI
        !wrtElement = !wrtElement.owner
        skip
      endhandle
      -- found element
      break
    enddo
  elseif (!wrtText eq |CE|) then
    !wrtElement   = !!ce
    handle any
      !wrtElement = World
    endhandle
  else
    !wrtElement   = !wrtText.dbRef()
    handle any
      !wrtElement = World
    endhandle
  endif

  if (!wrtElement.unset()) then
    !wrtElement = World
  endif

  !this.form.thrWrtText.val = !wrtElement.fullName

  -- update current element feedback
  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
--
-- Method:      setElement
--
-- Description: Set element to be moved
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be moved
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElement(!element is DBREF)

  -- Store the CE
  !this.element = !element

  -- Determine the type of element, such as Branch
  !name         = !this.element.namn
  !ownerType    = !this.element.owner.type

  -- handle P-points
  if( !this.mode eq 'BRANCH' ) then
    -- only head and tail available
    !pDisplay = ARRAY()
    !pReplace = ARRAY()
    !pDisplay[1] = 'Head'
    !pReplace[1] = 'PH'
    !pDisplay[2] = 'Tail'
    !pReplace[2] = 'PT'
  else
    !pPointList   = !this.element.ppls
    handle any
      !pPointList = ARRAY()
    endhandle
    if( !pPointList.empty() ) then
      -- find p-points on primitive (limit to 12 in case we get very large p-point lists in future)
      do !pNumber from 1 to 12
        !pPos = !this.element.pPosition[!pNumber]
        handle any
          break
        endhandle
        break if(!pPos.up.unset())
       !pPointList.append( !pNumber )
      enddo
    endif
    !pDisplay = ARRAY()
    !pReplace = ARRAY()
    !pDisplay[1] = 'Origin'
    !pReplace[1] = '0'
    !pPointList.unique()
    -- substitute arrive and leave if this component has PA PL
    !arrive   = !this.element.arrive
    handle any
      !arrive = -1
    endhandle
    !leave    = !this.element.leave
    handle any
      !leave  = -1
    endhandle
    do !pNumber values !pPointList
      if( !pNumber eq !arrive ) then
        !pDisplay.append('Arrive')
      elseif( !pNumber eq !leave ) then
        !pDisplay.append('Leave')
      else
        !pDisplay.append('P' + !pNumber.string())
      endif
      !pReplace.append(!pNumber.string())
    enddo
  endif
  !this.form.thrOriginOption.dText  = !pDisplay
  !this.form.thrOriginOption.rText  = !pReplace
  !this.form.thrOriginOption.active = ( !pDisplay.size() gt 1 )
  !this.form.thrOriginOption.val    = 1

  if (!ownerType eq 'BRAN') then
    var !mode MODE
    if (!mode eq 'Forwards') then
      !defaultDirection = !this.element.aDir
    else
      !defaultDirection = !this.element.lDir
    endif
    !this.form.thrDirectionText.val = !defaultDirection.string().before( ' WRT' )
    !this.setTextBoxWrtElement(!defaultDirection.origin.string())
    !this.thrSetSelectOptionItems('BRANCH')
  else
    !this.form.thrDirectionText.val = !this.coordOptionString
    !this.setTextBoxWrtElement('OWNER')
    !this.thrSetSelectOptionItems('')
  endif

  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
-- *********************************************************************
-- * Move Through Events & Methods
-- *********************************************************************
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      onThrSelectOptionChanged
--
-- Description: Callback for target selection option
--
------------------------------------------------------------------------
define method .onThrSelectOptionChanged()

  !this.thrShowAdditionalControls(!this.form.thrSelectOption.selection())

endmethod

------------------------------------------------------------------------
--
-- Method:      thrSetSelectOptionItems
--
-- Description: Set target selection options according to current target
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of move BRANCH item or other
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .thrSetSelectOptionItems(!mode is STRING)

  !this.form.thrSelectOption.clear()

  -- basic element select and position select
  !this.form.thrSelectOption.add('Element', 'IDCUR')
  !this.form.thrSelectOption.add('Position', 'IDP')

  -- special cases for branch components
  if (!mode eq 'BRANCH') then
    !this.form.thrSelectOption.add('Next', 'NEXT')
    !this.form.thrSelectOption.add('Tail', 'PT')
    !this.form.thrSelectOption.add('Previous', 'PREV')
    !this.form.thrSelectOption.add('Head', 'PH')
    !this.form.thrSelectOption.add('Current', 'CE')
  endif

  -- default to element selection
  !this.form.thrSelectOption.val = 1
  !this.thrShowAdditionalControls('IDCUR')

endmethod

------------------------------------------------------------------------
--
-- Method:      thrShowAdditionalControls
--
-- Description: Control display of controls based on target selection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of target (element:IDCUR, position:IDP, special)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .thrShowAdditionalControls(!mode is STRING)

  !this.form.thrNameText.visible         = false
  !this.form.thrNamePickButton.visible   = false
  !this.form.thrPickPosButton.visible    = false

  -- clear target aids
  !!aidNumbers.hide(!this.aidTarget)
  !this.enhanced.clear()

  if (!mode eq 'IDP') then
    -- Position gadgets
    !this.form.thrPickPosButton.visible  = true
    if( !this.targetPosition.set() ) then
      !this.targetPositionFeedback(!this.targetPosition)
    endif
    -- prepare for EDG position pick
    !this.edgPickPosition()
  elseif (!mode eq 'IDCUR') then
    -- Element gadgets
    !this.form.thrNameText.visible       = true
    -- prepare for EDG element pick
    !this.form.thrNamePickButton.visible = true
    -- reset feedback if set
    !target = object DBREF(!this.form.thrNameText.val)
    handle any
    elsehandle none
      !this.setNameGadget(!target)
    endhandle
  endif

  -- clear target aids
  !!aidNumbers.hide(!this.aidTarget)

endmethod

------------------------------------------------------------------------
--
-- Method:      applyButtonClicked
--
-- Description: Callback for APPLY button on distance tab
--
------------------------------------------------------------------------
define method .applyButtonClicked()

  -- get target
  if( !this.form.thrSelectOption.active ) then
    !select  = !this.form.thrSelectOption.selection()
  else
    !select  = ''
  endif

  -- get move parameters
  -- construct direction from direction and WRT
  !direction = !this.form.thrDirectionText.val.direction()
  !wrt       = !this.form.thrWrtText.val.dbRef()
  !direction.origin = !wrt
  -- from point
  !origin    = !this.form.thrOriginOption.selection()

  -- plane through target
  !plane     = !this.form.thrPlaneToggle.val
  if( !plane ) then
    !planeNormal = !this.form.thrPlaneDirText.val.direction()
  else
    !planeNormal = object DIRECTION()
  endif

  -- initialise move command object
  !this.moveCommandObject.clear()
  !this.moveCommandObject.setElement(!this.element)
  !this.moveCommandObject.setOrigin(!origin)
  !this.moveCommandObject.setDirection(!direction)
  !this.moveCommandObject.setPlane(!planeNormal)

  if (!select eq 'IDCUR' ) then

    -- Target is a named element
     if(!this.form.thrNameText.val eq 'unset') then
      -- Name Option must have a valid name
      return ERROR 1 'Unable to perform move. The Name is unset.'
    else
      !name = !!checkName(!this.form.thrNameText.val, 'OLD')
      if (!name.set()) then
        --MOVE $!direction WRT $!wrt DIST $!distance $!relative $!!CDPNRTN
        if( !this.dragMode ) then
          !this.moveCommandObject.dragThrough(object DBREF(!name))
          handle any
            !!alert.error(!!error.text)
            return
          endhandle
        else
          !this.moveCommandObject.moveThrough(object DBREF(!name))
          handle any
            !!alert.error(!!error.text)
            return
          endhandle
        endif
      endif
    endif

  elseif (!select eq 'IDP') then

    if( !this.targetPosition.unset() ) then
      !!alert.error('Target position is not set. Please pick a target position.')
      return
    endif

    -- Target is a position
    if( !this.dragMode ) then
      !this.moveCommandObject.dragThrough(!this.targetPosition)
      handle any
        !!alert.error(!!error.text)
        return
      endhandle
    else
      !this.moveCommandObject.moveThrough(!this.targetPosition)
      handle any
        !!alert.error(!!error.text)
        return
      endhandle
    endif

  else

    -- special pipe cases - head, tail etc.
    !this.moveCommandObject.moveThrough(!select)
    handle any
      !!alert.error(!!error.text)
      return
    endhandle

  endif

  -- update feedback
  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
--
-- Method:      edgPickWRT
--
-- Description: Configure EDG for WRT element pick
--
------------------------------------------------------------------------
define method .edgPickWRT()

  -- Define EDG element pick for target element
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick Reference Element')
  !packet.action         = '!!desDragMove.mThrough.setTextBoxWrtElement(!this.return[1].item.string())'
  !packet.description    = 'Pick Reference Element'
  !packet.priority       = 1
  !packet.remove         = true

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      edgPickTarget
--
-- Description: Configure EDG for element pick
--
------------------------------------------------------------------------
define method .edgPickTarget()

  -- Define EDG element pick for target element
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick Target Element')
  !packet.action         = '!!desDragMove.mThrough.setNameGadget(!this.return[1].item)'
  !packet.description    = 'Pick Target Element'
  !packet.priority       = 1
  !packet.remove         = true

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      setNameGadget
--
-- Description: Set name gadget to given target
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF        Target element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNameGadget(!target is DBREF)

  !this.form.thrNameText.val = !target.fullName
  -- graphical feedback
  !!aidNumbers.hide(!this.aidTarget)
  !this.enhanced.clear()
  !this.enhanced.addItem(!target)

endmethod

------------------------------------------------------------------------
--
-- Method:      setTargetName
--
-- Description: Set name gadget to given target name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Target element name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTargetName(!targetName is STRING)

  !name = !!checkName(!targetName, |OLD|)
  if( !name.set() ) then
    !this.setNameGadget(object DBREF(!name))
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .edgPickPosition()
--
-- Description: Configure EDG for position pick
--
------------------------------------------------------------------------
define method .edgPickPosition()

  -- Define EDG element pick for target position
  !packet                = object EDGPACKET()
  !packet.definePosition('Pick Target Position')
  !packet.action         = '!!desDragMove.mThrough.setTargetPosition(!this.return[1])'
  !packet.description    = 'Pick Target Position'
  !packet.priority       = 1
  !packet.remove         = true
  !packet.type           = 'Positioning'
  !packet.key            = 'MoveTargetPosition'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      setTargetPosition
--
-- Description: Callback for EDG position pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     EDGPOSITIONDATA    EDG pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTargetPosition(!pickData is EDGPOSITIONDATA)

  !this.setTargetPosition(!pickData.position)
  !this.enhanced.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      setTargetPosition
--
-- Description: Set target position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     POSITION    Target position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTargetPosition(!position is POSITION)

  !this.targetPosition = !position
  -- show graphical feedback
  !this.targetPositionFeedback(!position)

endmethod

------------------------------------------------------------------------
--
-- Method:      .targetPositionFeedback
--
-- Description: Draw target feedback (circle)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     POSITION    Draw feedback at given position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .targetPositionFeedback(!position is POSITION)

  !direction        = !this.form.thrDirectionText.val.direction()
  !wrt              = !this.form.thrWrtText.val.dbRef()
  !direction.origin = !wrt
  !pointVector      = object POINTVECTOR(!position, !direction)
  !plane            = !pointVector.plane()
  !arc              = object ARC(!position, !plane.orientation, 0, 180, 250mm, true)
  !point            = object GPHPOSITION(!position)
  !point.diameter   = 50mm
  !point.draw(!this.aidTarget, true)
  !arc.circle().draw(!this.aidTarget,1,16)
  !arc.radius       = 100mm
  !arc.circle().draw(!this.aidTarget,1,16)

endmethod

------------------------------------------------------------------------
--
-- Method:      .updateElementAids()
--
-- Description: Draw element feedback (direction arrow)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateElementAids()

  -- construct direction from direction and WRT
  !direction = !this.form.thrDirectionText.val.direction()
  !wrt       = !this.form.thrWrtText.val.dbRef()
  !direction.origin = !wrt
  !origin           = !this.form.thrOriginOption.selection().trim()
  if( !origin.empty() ) then
    !position       = !this.element.position
  elseif( !origin eq 'PH' ) then
    !position       = !this.element.phPos
    handle any
      !position     = !this.element.position
    endhandle
  elseif( !origin eq 'PT' ) then
    !position       = !this.element.ptPos
    handle any
      !position     = !this.element.position
    endhandle
  else
    !position       = !this.element.pPos[!origin.real()]
    handle any
      !position     = !this.element.position
    endhandle
  endif
  !pointVector      = object POINTVECTOR(!position, !direction)
  !point            = object GPHPOINTVECTOR(!pointVector)
  !point.detail     = true
  !point.wrtWorld   = false
  !point.length     = 1000mm
  !point.draw(!this.aidNumber, true)
  !plane            = !pointVector.plane()
  !gphPlane         = object GPHPLANE(!plane)
  !gphPlane.x       = 500mm
  !gphPlane.y       = 500mm
  !gphPlane.draw(!this.aidNumber, false)

  -- update target position aids if drawn
  if( !this.targetPosition.set() and !this.form.thrPickPosButton.visible ) then
    !this.targetPositionFeedback(!this.targetPosition)
  endif

endmethod
