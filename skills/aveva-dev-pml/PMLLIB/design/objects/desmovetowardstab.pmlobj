--  File:            desmovetowardstab.pmlobj
--    Type:          Object Definition
--    Group:         General
--      Keyword:     Design
--    Module:        Design
--  Author:          D. Horrocks
--  Created:         Tue Mar 29 21:02:20 2011
--
--  Description:     Presenter object for the Move Towards tab on the drag & move form (!!desDragMove).
-- This handles events and behaviour associated with the Move Towards tab.
-- Take Care! - This object and its parent form are closely coupled.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyButtonClicked()             -                   Callback for APPLY button on Towards tab
--  closeTab()                       -                   Event handler for tab made inactive
--  desMoveTowardsTab()              -                   Constructor
--  edgPickPosition()                -                   Configure EDG for position pick
--  edgPickTarget()                  -                   Configure EDG for element pick
--  highlightElement(DBREF,BOOLEAN)  -                   Highlight element
--  initialiseTab(FORM)              -                   Initialise Distance tab
--  onTowSelectOptionChanged()       -                   Callback for target selection option
--  setAids(REAL,REAL)               -                   Set aid numbers to be used for source element and target
--  setDrag(BOOLEAN)                 -                   Set drag mode on or off
--  setElement(DBREF)                -                   Set element to be moved
--  setMode(STRING)                  -                   Set move mode
--  setNameGadget(DBREF)             -                   Set name gadget to given target
--  setTargetName(STRING)            -                   Set name gadget to given target name
--  setTargetPosition(EDGPOSITIONDATA) -                   Callback for EDG position pick
--  setTargetPosition(POSITION)      -                   Set target position
--  showTab()                        -                   Event handler for tab made active
--  targetPositionFeedback(POSITION,DIRECTION) -                   Draw target feedback (circles)
--  towSetSelectOptionItems(STRING)  -                   Set target selection options according to current target
--  towShowAdditionalControls(STRING) -                   Control display of controls based on target selection
--  updateElementAids()              -                   Draw element feedback (direction arrow)
--
----------------------------------------------------------------------

define object DESMOVETOWARDSTAB

  -- Members
  -- This is a presenter object for this form
  member .form               is FORM
  -- Current element
  member .element            is DBREF

  -- MOVE command wrapper object
  member .moveCommandObject  is DESMOVECOMMAND

  -- modes
  member .dragMode           is BOOLEAN
  member .mode               is STRING

  -- Coordinates
  member .targetPosition     is POSITION

  -- aids
  member .aidNumber          is REAL
  member .aidTarget          is REAL
  member .enhanced           is COMENHANCE

endobject

------------------------------------------------------------------------
--
-- Method:      desMoveTowardsTab
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .desMoveTowardsTab()

  -- set to move mode by default
  !this.dragMode = false
  !this.mode     = ''

endmethod

------------------------------------------------------------------------
--
-- Method:      initialiseTab
--
-- Description: Initialise Distance tab
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Reference to owning form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialiseTab(!form is FORM)

  -- store reference to form
  !this.form = !form

  -- Set Move Towards tab tooltips
  !this.form.towNamePickButton.setTooltip('Pick Target Element')
  !this.form.towPickPosButton.setTooltip('Pick Target Position')
  !this.form.towApplyButton.setTooltip('Move Element Towards')

  -- Set Move Towards tab callbacks
  !this.form.towOriginOption.callback   = '!this.mTowards.updateElementAids()'
  !this.form.towSelectOption.callback   = '!this.mTowards.onTowSelectOptionChanged()'
  !this.form.towNameText.callback       = '!this.mTowards.setTargetName(!this.towNameText.val)'
  !this.form.towNamePickButton.callback = '!this.mTowards.edgPickTarget()'
  !this.form.towPickPosButton.callback  = '!this.mTowards.edgPickPosition()'
  !this.form.towApplyButton.callback    = '!this.onTowApplyButtonClicked()'

  -- Set Move Towards tab icons
  !this.form.towNamePickButton.addPixmap(!!pml.getPathName('pick16.png'))
  !this.form.towPickPosButton.addPixmap(!!pml.getPathName('pickpos16.png'))

  !this.towShowAdditionalControls('')

  -- set to move mode by default
  !this.dragMode = false

endmethod

------------------------------------------------------------------------
--
-- Method:      .showTab
--
-- Description: Event handler for tab made active
--
------------------------------------------------------------------------

define method .showTab()

  ------------------------------------------------------
  -- Initialise Move Towards Tab Gadgets
  ------------------------------------------------------
  !this.form.towDistanceText.val   = 0mm
  !this.form.towNameText.val       = 'unset'

endmethod

------------------------------------------------------------------------
--
-- Method:      closeTab
--
-- Description: Event handler for tab made inactive
--
------------------------------------------------------------------------

define method .closeTab()

  -- Remove applications events from system
  !!edgCntrl.remove('Pick Target Element')
  !!edgCntrl.remove('Pick Target Position')
  -- clear aids
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidTarget)
  -- clear highlight
  !this.enhanced.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      setDrag
--
-- Description: Set drag mode on or off
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True: Drag   False: Move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDrag(!drag is BOOLEAN)

  -- Remove applications events from system
  !this.dragMode = !drag

endmethod

------------------------------------------------------------------------
--
-- Method:      setMode
--
-- Description: Set move mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Move type: empty for basic move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMode(!mode is STRING)

  -- Remove applications events from system
  !this.mode = !mode

endmethod

------------------------------------------------------------------------
--
-- Method:      setAids
--
-- Description: Set aid numbers to be used for source element and target
--              element or position feedback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Source element aid number
--    2   R      REAL        Target element aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAids(!sourceNumber is REAL, !targetNumber is REAL)

  -- Remove applications events from system
  !this.aidNumber = !sourceNumber
  !this.aidTarget = !targetNumber

endmethod

------------------------------------------------------------------------
--
-- Method:      setElement
--
-- Description: Set element to be moved
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be moved
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElement(!element is DBREF)

  -- Store the CE
  !this.element = !element

  -- Determine the type of element, such as Branch
  !name         = !this.element.namn
  !ownerType    = !this.element.owner.type

  if( !this.mode eq 'BRANCH' ) then
    -- only head and tail available
    !pDisplay = ARRAY()
    !pReplace = ARRAY()
    !pDisplay[1] = 'Head'
    !pReplace[1] = 'PH'
    !pDisplay[2] = 'Tail'
    !pReplace[2] = 'PT'
  else
    -- handle P-points
    !pPointList   = !this.element.ppls
    handle any
      !pPointList = ARRAY()
    endhandle
    if( !pPointList.empty() ) then
      -- find p-points on primitive (limit to 12 in case we get very large p-point lists in future)
      do !pNumber from 1 to 12
        !pPos = !this.element.pPosition[!pNumber]
        handle any
          break
        endhandle
        break if(!pPos.up.unset())
       !pPointList.append( !pNumber )
      enddo
    endif
    !pDisplay = ARRAY()
    !pReplace = ARRAY()
    !pDisplay[1] = 'Origin'
    !pReplace[1] = '0'
    !pPointList.unique()
    -- substitute arrive and leave if this component has PA PL
    !arrive   = !this.element.arrive
    handle any
      !arrive = -1
    endhandle
    !leave    = !this.element.leave
    handle any
      !leave  = -1
    endhandle
    do !pNumber values !pPointList
      if( !pNumber eq !arrive ) then
        !pDisplay.append('Arrive')
      elseif( !pNumber eq !leave ) then
        !pDisplay.append('Leave')
      else
        !pDisplay.append('P' + !pNumber.string())
      endif
      !pReplace.append(!pNumber.string())
    enddo
  endif
  !this.form.towOriginOption.dText  = !pDisplay
  !this.form.towOriginOption.rText  = !pReplace
  !this.form.towOriginOption.active = ( !pDisplay.size() gt 1 )
  !this.form.towOriginOption.val    = 1

  if (!ownerType eq 'BRAN') then
    !this.towSetSelectOptionItems('BRANCH')
  else
    !this.towSetSelectOptionItems('')
  endif

  -- update current element feedback
  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
-- *********************************************************************
-- * Move Towards Events & Methods
-- *********************************************************************
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      onTowSelectOptionChanged
--
-- Description: Callback for target selection option
--
------------------------------------------------------------------------
define method .onTowSelectOptionChanged()

  !this.towShowAdditionalControls(!this.form.towSelectOption.selection())

endmethod

------------------------------------------------------------------------
--
-- Method:      towSetSelectOptionItems
--
-- Description: Set target selection options according to current target
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of move BRANCH item or other
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .towSetSelectOptionItems(!mode is STRING)

  !this.form.towSelectOption.clear()

  -- basic element select and position select
  !this.form.towSelectOption.add('Element', 'IDCUR')
  !this.form.towSelectOption.add('Position', 'IDP')

  -- special cases for branch components
  if (!mode eq 'BRANCH') then
    !this.form.towSelectOption.add('Next', 'NEXT')
    !this.form.towSelectOption.add('Tail', 'PT')
    !this.form.towSelectOption.add('Previous', 'PREV')
    !this.form.towSelectOption.add('Head', 'PH')
    !this.form.towSelectOption.add('Current', 'CE')
  endif

  -- default to element selection
  !this.form.towSelectOption.val = 1
  !this.towShowAdditionalControls('IDCUR')

endmethod

------------------------------------------------------------------------
--
-- Method:      towShowAdditionalControls
--
-- Description: Control display of controls based on target selection
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of target (element:IDCUR, position:IDP, special)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .towShowAdditionalControls(!mode is STRING)

  !this.form.towNameText.visible         = false
  !this.form.towNamePickButton.visible   = false
  !this.form.towPickPosButton.visible    = false

  -- clear target aids
  !!aidNumbers.hide(!this.aidTarget)
  !this.enhanced.clear()

  if (!mode eq 'IDP') then
    -- Position gadgets
    !this.form.towPickPosButton.visible  = true
    if( !this.targetPosition.set() ) then
      !this.updateElementAids()
    endif
    -- prepare for EDG position pick
    !this.edgPickPosition()
  elseif (!mode eq 'IDCUR') then
    -- Element gadgets
    !this.form.towNameText.visible       = true
    -- prepare for EDG element pick
    !this.form.towNamePickButton.visible = true
    -- reset feedback if set
    !target = object DBREF(!this.form.towNameText.val)
    handle any
    elsehandle none
      !this.setNameGadget(!target)
    endhandle
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      applyButtonClicked
--
-- Description: Callback for APPLY button on Towards tab
--
------------------------------------------------------------------------
define method .applyButtonClicked()

  -- get target
  if( !this.form.towSelectOption.active ) then
    !select  = !this.form.towSelectOption.selection()
  else
    !select  = ''
  endif

  -- get move parameters
  !distance  = !this.form.towDistanceText.val
  -- from point
  !origin    = !this.form.towOriginOption.selection()

  -- initialise move command object
  !this.moveCommandObject.clear()
  !this.moveCommandObject.setElement(!this.element)
  !this.moveCommandObject.setOrigin(!origin)
  !this.moveCommandObject.setDistance(!distance)

  if (!select eq 'IDCUR' ) then

    -- Target is a named element
     if(!this.form.towNameText.val eq 'unset') then
      -- Name Option must have a valid name
      return ERROR 1 'Unable to perform move. The Name is unset.'
    else
      !name = !!checkName(!this.form.towNameText.val, 'OLD')
      if (!name.set()) then
        if( !this.dragMode ) then
          !this.moveCommandObject.dragTowards(object DBREF(!name))
          handle any
            !!alert.error(!!error.text)
            return
          endhandle
        else
          !this.moveCommandObject.moveTowards(object DBREF(!name))
          handle any
            !!alert.error(!!error.text)
            return
          endhandle
        endif
      endif
    endif

  elseif (!select eq 'IDP') then

    if( !this.targetPosition.unset() ) then
      !!alert.error('Target position is not set. Please pick a target position.')
      return
    endif

    -- Target is a position
    if( !this.dragMode ) then
      !this.moveCommandObject.dragTowards(!this.targetPosition)
      handle any
        !!alert.error(!!error.text)
        return
      endhandle
    else
      !this.moveCommandObject.moveTowards(!this.targetPosition)
      handle any
        !!alert.error(!!error.text)
        return
      endhandle
    endif

  else

    -- special pipe cases - head, tail etc.
    !this.moveCommandObject.moveTowards(!select)
    handle any
      !!alert.error(!!error.text)
      return
    endhandle

  endif

  -- update current element feedback
  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
--
-- Method:      edgPickTarget
--
-- Description: Configure EDG for element pick
--
------------------------------------------------------------------------
define method .edgPickTarget()

  -- Define EDG element pick for target element
  !packet                = object EDGPACKET()
  !packet.elementPick('Pick Target Element')
  !packet.action         = '!!desDragMove.mTowards.setNameGadget(!this.return[1].item)'
  !packet.description    = 'Pick Target Element'
  !packet.priority       = 1
  !packet.remove         = true

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      setNameGadget
--
-- Description: Set name gadget to given target
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF        Target element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNameGadget(!target is DBREF)

  !this.form.towNameText.val = !target.fullName
  -- graphical feedback
  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
--
-- Method:      setTargetName
--
-- Description: Set name gadget to given target name
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     STRING       Target element name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTargetName(!targetName is STRING)

  !name = !!checkName(!targetName, |OLD|)
  if( !name.set() ) then
    !this.setNameGadget(object DBREF(!name))
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .edgPickPosition()
--
-- Description: Configure EDG for position pick
--
------------------------------------------------------------------------
define method .edgPickPosition()

  -- Define EDG element pick for target position
  !packet                = object EDGPACKET()
  !packet.definePosition('Pick Target Position')
  !packet.action         = '!!desDragMove.mTowards.setTargetPosition(!this.return[1])'
  !packet.description    = 'Pick Target Position'
  !packet.priority       = 1
  !packet.remove         = true
  !packet.type           = 'Positioning'
  !packet.key            = 'MoveTargetPosition'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      setTargetPosition
--
-- Description: Callback for EDG position pick
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     EDGPOSITIONDATA    EDG pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTargetPosition(!pickData is EDGPOSITIONDATA)

  !this.setTargetPosition(!pickData.position)
  !this.enhanced.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      setTargetPosition
--
-- Description: Set target position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     POSITION    Target position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTargetPosition(!position is POSITION)

  !this.targetPosition = !position
  -- show graphical feedback
  !this.updateElementAids()

endmethod

------------------------------------------------------------------------
--
-- Method:      .targetPositionFeedback
--
-- Description: Draw target feedback (circles)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     POSITION    Draw feedback at given position
--    2   R     DIRECTION   Direction of plane normal
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .targetPositionFeedback(!position is POSITION, !direction is DIRECTION)

  !pointVector      = object POINTVECTOR(!position, !direction)
  !plane            = !pointVector.plane()
  !arc              = object ARC(!position, !plane.orientation, 0, 180, 250mm, true)
  !point            = object GPHPOSITION(!position)
  !point.diameter   = 50mm
  !point.draw(!this.aidTarget, true)
  !arc.circle().draw(!this.aidTarget,1,16)
  !arc.radius       = 100mm
  !arc.circle().draw(!this.aidTarget,1,16)

endmethod

------------------------------------------------------------------------
--
-- Method:      .updateElementAids()
--
-- Description: Draw element feedback (direction arrow)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateElementAids()

  !!aidNumbers.hide(!this.aidTarget)
  !!aidNumbers.hide(!this.aidNumber)

  -- from position
  !origin           = !this.form.towOriginOption.selection().trim()
  if( !origin.empty() ) then
    !position       = !this.element.position
  elseif( !origin eq 'PH' ) then
    !position       = !this.element.phPos
    handle any
      !position     = !this.element.position
    endhandle
  elseif( !origin eq 'PT' ) then
    !position       = !this.element.ptPos
    handle any
      !position     = !this.element.position
    endhandle
  else
    !position       = !this.element.pPos[!origin.real()]
    handle any
      !position     = !this.element.position
    endhandle
  endif

  !positionTarget   = ( !this.targetPosition.set() and !this.form.towPickPosButton.visible )
  -- update target position aids if drawn
  if( !positionTarget ) then
    -- target position
    !direction      = !position.line(!this.targetPosition).direction()
    handle any
      !this.highlightElement(!this.element,true)
      return
    endhandle
  else
    -- target element
    !targetElement  = object DBREF(!this.form.towNameText.val)
    handle any
      !this.highlightElement(!this.element,true)
      return
    endhandle
    !direction      = !position.line(!targetElement.position).direction()
    handle any
      !this.highlightElement(!this.element,true)
      return
    endhandle
  endif

  if( !positionTarget ) then
    -- display target position feedback
    !this.targetPositionFeedback(!this.targetPosition,!direction)
    !this.enhanced.clear()
  else
    -- display target element feedback
    !this.highlightElement(!targetElement, true)
  endif

  -- from element feedback
  !pointVector      = object POINTVECTOR(!position, !direction)
  !point            = object GPHPOINTVECTOR(!pointVector)
  !point.detail     = true
  !point.length     = 1000mm
  !point.draw(!this.aidNumber, true)
  !plane            = !pointVector.plane()
  !gphPlane         = object GPHPLANE(!plane)
  !gphPlane.x       = 500mm
  !gphPlane.y       = 500mm
  !gphPlane.draw(!this.aidNumber, false)

endmethod
------------------------------------------------------------------------
--
-- Method:      .highlightElement
--
-- Description: Highlight element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF       Element to highlight
--    2   R     BOOLEAN     True to clear existing enhanced items
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightElement(!element is DBREF, !clear is BOOLEAN)

  if( !clear ) then
    !this.enhanced.clear()
  endif
  !this.enhanced.addItem(!element)

endmethod
