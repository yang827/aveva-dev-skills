--
-- Created:         3rd April 1998
--
-- Description:
-- Dunion object to save default dunion attribute for differing types of element
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copyToGlobal()                   -                   copy the object to the global instance
--  default()                        -                   Default options settings
--  display()                        ARRAY               Format data for a list gadget
--  draDunion()                      -                   Constructor
--  edit()                           -                   show form draDunionEdit
--  getValue(STRING)                 REAL                Get Dunion Value From .value array
--  globalInstance()                 -                   copy the object to the global instance
--  load()                           -                   Load options from system files
--  save()                           -                   Save options settings
--  setValue(STRING,REAL)            -
--  translateValue(REAL)             STRING
--

-- Define object
define object DRADUNION

  member .type is ARRAY
  member .value is ARRAY
  member .description is ARRAY

  member .global is BOOLEAN
  member .filename is STRING

endobject
-- End of object definition for DRADUNION
------------------------------------------------------------------------
--
-- Method: draDunion()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
-----------------------------------------------------------------------
define method .draDunion()

  !this.description[1] = 'Zone'
  !this.description[2] = 'Structure'
  -- !this.description[3] = 'Substructure'
  !this.description[3] = 'Framework'
  !this.description[4] = 'Subframe'
  !this.description[5] = 'CWall'
  !this.description[6] = 'CFloor'
  !this.description[7] = 'CScreed'


  !this.type[1] = 'ZONE'
  !this.type[2] = 'STRU'
  -- !this.type[3] = 'SUBS'
  !this.type[3] = 'FRMW'
  !this.type[4] = 'SBFR'
  !this.type[5] = 'CWALL'
  !this.type[6] = 'CFLOOR'
  !this.type[7] = 'CSCREE'



  -- set file name
  !this.filename = 'des-dunion.pmldat'

  -- initialise global flag
  !this.global = false

  -- set the default values
  !this.default()

endmethod
-- End of method definition for .draDunion()
-----------------------------------------------------------------------
--
-- Method:      default(BOOLEAN)
--
-- Description: Default options settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .default()

  !this.setValue('ZONE',2)
  !this.setValue('STRU',2)
  -- !this.setValue('SUBS',1)
  !this.setValue('FRMW',2)
  !this.setValue('SBFR',0)
  !this.setValue('CWALL',2)
  !this.setValue('CFLOOR',2)
  !this.setValue('CSCREE',1)


endmethod
-- End of method definition for .default()
------------------------------------------------------------------------
--
-- Method:      display()
--
-- Description: Format data for a list gadget
--
-- Method Type: Function
--
-- Return:
--    [ARRAY] [Two Dimensional Array of Strings]
--
------------------------------------------------------------------------
define method .display() is ARRAY

  !returnArray[1] = ARRAY()

  -- string of spaces  12345678901234567890
  !spaces           = '                    '
  !separatorWidth   = 3

  -- get the length of the longest description
  !length = !this.description.width()

  -- Build Display Array
  do !i indices !this.type

    !separatorString = !spaces.subString(1, !length + !separatorWidth - !this.description[!i].length())

    !returnArray[1][!i] = !this.description[!i] + !separatorString + !this.translateValue(!this.value[!i])
  enddo

  !returnArray[2] = !this.type

  return !returnArray

endmethod
-- End of method definition for .display() ARRAY
------------------------------------------------------------------------
--
-- Method:      translatevalue()
--
-- Description: Translate Values into Dunion Description
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .translateValue(!xx is REAL) is STRING


  if (!xx eq 0) then
    !returnValue =  'Always Shown'
  elseif (!xx eq 1) then
    !returnValue = 'Not Shown Between Members'
  elseif (!xx eq 2) then
    !returnValue = 'Not Shown Between Members and Peers'
  endif

  return !returnValue

endmethod
-- End of method definition for .translateValue(REAL) STRING
------------------------------------------------------------------------
--
-- Method:      getValue()
--
-- Description: Get Dunion Value From .value array
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .getValue(!typeValue is STRING) is REAL


      !index = !this.type.findFirst(!typeValue.upcase())
    if (!index.unset()) then
      !dUnionValue = REAL()
    else
      !dUnionValue = !this.value[!index]
  endif
  return !dUnionValue

endmethod
-- End of method definition for .getValue(STRING) REAL

-----------------------------------------------------------------------
--
-- Method:      setValue()
--
-- Description:
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .setValue(!typeValue is STRING, !choiceVal is REAL)

  !index = !this.type.findFirst(!typeValue)

  !this.value[!index] = !choiceVal

endmethod
-- End of method definition for .setValue(STRING, REAL)



-------------------------------------------------------------------------
--
-- Method:      copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()


  -- copy this object to !!draDunion
  !!draDunion     = !this
  !this.global = true

endmethod
-- End of method definition for .copyToGlobal()


-------------------------------------------------------------------------
--
-- Method:      globalInstance()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .globalInstance()

  -- create the global variable
  !!draDunion = !this

  -- load the options
  !!draDunion.load()

endmethod
-- End of method definition for .globalInstance()
--
------------------------------------------------------------------------
--
-- Method: save()
--
-- Description: Save options settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

  -- write header information
  !saveContents.append('-- Data file for edge drawing default settings')
  !saveContents.append('')

  -- options are not saved if they are the same as the default values
  -- currently the default values are put in here directly, this is
  -- for performance reasons, it would be better to have a member for
  -- each existing member, that held its default value.


  ----------------------------------------------------------------------
  -- system options are only saved if the user has administrator status
  ----------------------------------------------------------------------

  if (!!comAdminStatus()) then
    do !i indices !this.type
      -- example defaults file string    !!tmpDraDunion.setValue('STRU', 0)
      !saveContents.append(|!!tmpDraDunion.setValue('| + !this.type[!i] + |', | & !this.value[!i] & |)|)
    enddo
  endif
  -- end of system options


  !!writeFile('%PDMSUSER%/' + !this.filename, 'OVERWRITE', !saveContents)

endmethod
-- End of method definition for .save()
------------------------------------------------------------------------
--
-- Method: load()
--
-- Description: Load options from system files
--
-- Method Type: Procedure
--
--
--
------------------------------------------------------------------------
define method .load()

   -- get the locations of system options file and user options file

  !optionFiles = !!comGetOptFiles(!this.filename)

  -- create a temporary global variable to store the data
  if (defined(!!tmpDraDunion)) then
    !!tmpDraDunion.delete()
  endif
  -- set !!tmpDraDunion to instance of !!draDunion
  !!tmpDraDunion = !this

  -- if a system users options file has been found, load the data
  if (defined(!optionFiles[1])) then


    -- load options file
    !localName = !optionFiles[1].fullName()

    $m "$!<localName>"
    handle any
      !!messageFile.warning(146, 31, !optionFiles[1].fullName())
      !this.default()
    endhandle
  endif

  -- if a general users options file has been found, load the options
  if (defined(!optionFiles[2])) then

    -- load options file
    !localName = !optionFiles[2].fullName()
    $m "$!<localName>"
    handle any
      !!messageFile.warning(146, 32, !optionFiles[2].fullName())
      !this.default()
    endhandle
  endif

  -- copy temporary object to this object and reset the global value
  -- !storeGlobal = !this.global
  !this = !!tmpDraDunion
  -- !this.global = !storeGlobal

  -- !this.coreSettings()

  !!tmpDraDunion.delete()



endmethod
-- End of method definition for .load()
------------------------------------------------------------------------
--
-- Method: edit()
--
-- Description: show form draDunionEdit
--
-- Method Type: Procedure
--
--
--
------------------------------------------------------------------------
define method .edit()

  show !!draDunionEdit

endmethod
-- End of method definition for .edit()
------------------------------------------------------------------------
