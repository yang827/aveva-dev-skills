-- Created:         Thu Nov 20 09:40:39 1997
--
--
-- Description:
-- Dunion object to save default dunion attribute for differing types of element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbRef(DBREF)                     -                   Set value for given element
--  get(STRING)                      REAL                Get value for given type
--  load(STRING)                     -                   Load Values from file
--  save(STRING)                     -                   Save values to specified filename
--  set(STRING,REAL)                 -                   Set value for given type
--
------------------------------------------------------------------------

-- Define object
define object DUNION

member .type is ARRAY
member .value is ARRAY

endobject
-- End of object definition for DUNION

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description:  Load Values from file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       File Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .load(!filename is STRING)

  -- initialise values
  !this.type.clear()
  !this.value.clear()

  -- Check Validity of Filename
  !file = object FILE(!filename)
  if (!file.exists()) then
    -- Read Lines of File
    !lines = !file.readFile()

    !types = 'ZONE,STRU,SUBS,FRMW,SBFR,WALL,FLOOR,SCREED'

    do !index indices !lines

      skip if (!lines[!index].trim().subString(1, 1) eq '#' or !lines[!index].trim().empty())

      -- Check Validity of Type
      !elemType = !lines[!index].part(1)
      if (!types.occurs(!elemType) gt 0) then
        -- Check validity of number
        !number = !lines[!index].part(2).real().int()
        handle any
        elsehandle none
          if (!number lt 1) then
               !number = 0
          elseif (!number gt 1) then
               !number = 2
          endif
          -- Save line
          !this.type.append(!elemType)
          !this.value.append(!number)
        endhandle
      endif
    enddo
  endif

endmethod
-- End of method definition for .load(STRING)
------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save values to specified filename
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .save(!filename is STRING)

  if (!this.type.size() gt !this.value.size() ) then
    !size = !this.value.size()
  else
    !size = !this.type.size()
  endif

  !lines[1] = '# Default Dunion Attribute Values'
  !lines[2] = '# Format : Type   Value(0,1,2)'
  if (!size gt 0) then
    do !index from 1 to !size
      !lines[!index + 2] = !this.type[!index] & ' ' & !this.value[!index].string()
    enddo
  endif

  call !!writeFile(!filename, 'OVER', !lines)

endmethod
-- End of method definition for .save(STRING)
------------------------------------------------------------------------
--
-- Method:      dbRef
--
-- Description: Set value for given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF     Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbRef(!element is DBREF)

  !index = !this.type.findFirst(!element.type)
  if ( !index.set() and !index gt 0) then
    !refe = !!ce
    !!ce = !element
    !dUnionValue = !this.value[!index]
    DUNION $!dUnionValue
    !!ce = !refe
  endif

endmethod
-- End of method definition for .dbRef(DBREF)
------------------------------------------------------------------------
--
-- Method:      set
--
-- Description: Set value for given type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Type
--    1    R      REAL       Value (0,1,2)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .set(!elemType is STRING, !dUnionValue is REAL)

  !index = !this.type.findFirst(!elemType)
  if (!index gt 0) then
    !this.value[!index] = !dUnionValue
  else
    !this.type.append(!elemType)
    !this.value.append(!dUnionValue)
  endif

endmethod
-- End of method definition for .set(STRING, REAL)
------------------------------------------------------------------------
--
-- Method:      get
--
-- Description: Get value for given type
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .get(!elemType is STRING) is REAL

  !index = !this.type.findFirst(!elemType)
  if ( !index gt 0) then
    return !this.value[!index]
  else
    return REAL()
  endif

endmethod
-- End of method definition for .get(STRING) REAL
