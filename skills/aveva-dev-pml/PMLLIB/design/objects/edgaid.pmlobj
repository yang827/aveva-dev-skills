--
--
-- Description:
-- stores all data associated with spheres when creating Working Points
-- or lines when creating Working Lines etc.
--
-- Member edgGeomData is a complete copy of the object populated by
-- edgPickMode function. When the user picks on a working point, they
-- will get what ever was picked on to derive that working point. Only
-- the Position & Direction will be different.
--
------------------------------------------------------------------------

define object EDGAID

  member .aidNumb     is REAL
  member .aidPos      is POSITION
  member .aidDir      is DIRECTION
  member .aidOwner    is DBREF
  member .ownerType   is STRING
  member .edgGeomData is EDGGEOMDATA

endobject
-- End of object definition for EDGAID
