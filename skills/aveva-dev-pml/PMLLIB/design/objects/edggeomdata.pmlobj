--
-- This is a copy of the !!edgGeomData form but in object format.
-- In the future edgGeomData should be of type this object.
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------


define object EDGGEOMDATA

-- old form stuff
--  para .para width 52 lines 1
--  list .val  |Numb|      at xmin ymax width 3 length 12
--  list .list |Available| at xmax ymin width 40 length 12

  -----------------------------------------------------------
  -- This replicates the array in !!form.view.inMode.data[]
  -----------------------------------------------------------

  member .pickType     is STRING
  member .pickedItem   is DBREF
  member .position     is POSITION
  member .realPosition is POSITION
  member .direction    is DIRECTION
  member .tubeEnd      is STRING
  member .number       is REAL
  member .pLineKey     is STRING
  member .aidType      is STRING

  ------------------------------------------------------------
  -- These members replace gadgets on _cdGeomData not already
  -- done by the above members.
  ------------------------------------------------------------

  member .snapOn       is BOOLEAN
  member .pickFunction is STRING
  member .pickLine     is DIRECTION
  member .pickPosition is POSITION
  member .items        is ARRAY
  member .data         is STRING
  member .type         is STRING
  member .end          is STRING

  -------------------------------------------------------------------------
  -- .vector     - is from the start of the element picked to the opposite
  --               end. This is for anything considered as a linear item.
  --               If not linear, left unset.
  -- .pickVector - The PickLine and PickPosition put into a VECTOR object
  -------------------------------------------------------------------------

  member .vector       is VECTOR
  member .pickVector   is VECTOR

  member .tubeLength   is REAL
  member .itemLength   is REAL

  -------------------------------------------------------------------------
  -- Root and Option prompts displayed in the Para gadget on the same form
  -- as the view gadget.
  -- Option is PROP, DIST etc..
  -------------------------------------------------------------------------

  member .rootPmt      is STRING
  member .optionPmt    is STRING
  member .option       is STRING
  member .promptStack  is ARRAY
  member .pickHandler  is STRING
  member .param        is STRING
  member .value        is REAL
  member .itemType     is STRING

  -------------------------------------------------------------------------
  -- PANEL information
  -------------------------------------------------------------------------

  member .nearestVertex is DBREF
  member .nearestLine   is VECTOR
  member .edgePos       is POSITION
  member .lineDist      is REAL


endobject
-- End of object definition for EDGGEOMDATA
