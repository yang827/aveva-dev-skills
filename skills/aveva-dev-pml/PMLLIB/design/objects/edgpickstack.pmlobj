--
--
-- Description:
-- When the EDG functions are called to do one or more picks (!!edg3DPick() &
-- !!edg3DPicks()) they are stacked on top of each other. This object is
-- what goes on the stack.
--
------------------------------------------------------------------------

define object EDGPICKSTACK

  member .callback  is STRING
  member .nameOfApp is STRING
  member .elements  is ARRAY
  member .dText     is STRING

endobject
-- End of object definition for EDGPICKSTACK
