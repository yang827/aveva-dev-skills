-- File:            edgpushparams.pmlobj
--   Type:          Object Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Fri May 23 16:35:52 BST 1997
--
--
-- Description:
-- Holds the parameters to be passed to the !!edgPush() function.
--
-- NOTE: If the Qualifiers are left unset, any qualifiers set in the Filters
-- forms (FFILTELEM, FFILTPLIN, FFILTPPNT) will be used. If the qualifiers
-- are set to '' this means NO qualifiers should be used for this pick.
--
--
--  .pickHandler   Function to be called by core when button-up on a
--                 pick is performed. 'DEFAULT' should be the norm.
--  .inMode        Pick Type: PICK, PPLINE, POINT, SCREEN, PANY
--                 PICK == Element, SCREEN == 3D Line......
--  .userFunction  Function to be called after the PickHandler function
--                 has run.
--  .appName       Name of the users application. This name will be
--                 used to remove it from the stack later.
--  .elementQual   Qualifiers, eg: |TYPE  EQ 'PANE'|
--  .pointQual                     |OWNER EQ 'PANE'|
--  .pLineQual                     |(CCON eq 'ANY' or PKEY eq 'NA')|
--  .aidQual
--  .tubiQual                      |
--  .rootPrompt    First part of prompt  in PARA gadget on View form
--  .optionPrompt  Second part of prompt
--  .showPickForm  TRUE  - shows Pick form
--                 FALSE - hides Pick form
--
------------------------------------------------------------------------

define object EDGPUSHPARAMS

  -- USER SETTABLE MEMBERS

  member .pickHandler   is STRING
  member .inMode        is STRING
  member .userFunction  is STRING
  member .appName       is STRING
  member .elementQual   is STRING
  member .pointQual     is STRING
  member .pLineQual     is STRING
  member .aidQual       is STRING
  member .tubiQual      is STRING
  member .rootPrompt    is STRING
  member .optionPrompt  is STRING
  member .showPickForm  is BOOLEAN

endobject
-- End of object definition for EDGPUSHPARAMS
