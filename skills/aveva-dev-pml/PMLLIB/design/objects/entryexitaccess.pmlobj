-- File:            entryexitaccess.pmlobj
--   Type:          Object Definition
--   Group:
--
--     Keyword:     Entry Exit Access
--   Module:        Design
--   Replaces:
--
-- Author:          Neil.Holmes
-- Created:         Friday Jul 6 13:00:00 GMT 2007
--
-- Description:
--    Object for holding entry/exit accesses
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accessType()                     STRING              Returns access type
--  accessType(STRING)               BOOLEAN             Modify access type
--  accessTypeFlip()                 -                   Flip orientation of access
--  accessTypeFlip(STRING)           BOOLEAN             Modify access type and flip the orientation
--  aidNumber(REAL)                  -                   Set aid number
--  direction()                      DIRECTION           Direction of access (Y)
--  draw()                           -                   Draw ceiling grid
--  draw(BOOLEAN)                    -                   Draw ceiling grid
--  entryExitAccess()                -                   Constructor
--  entryExitAccess(DBREF)           BOOLEAN             Constructor
--  modifyDefinition()               BOOLEAN             Modify ACCPNT definition
--  offset(DIRECTION,REAL)           -                   Offset position by passed direction and value
--  position(POSITION)               -                   Set position
--  refLevel(REAL)                   -                   Set reference level
--  tidy()                           -                   Tidy up aid graphics
--
------------------------------------------------------------------------

define object ENTRYEXITACCESS

  -- DB Element referenced
  member .dbElement       is DBREF

  -- Name of element
  member .name            is STRING

  -- Function
  member .function        is STRING

  -- Number
  member .number          is REAL

  -- Reference Level (implied level of LNDLEV array when owned by a STRTWR )
  member .refLevel        is REAL

  -- Entry/Exit type
  member .accessType      is STRING

  -- Position
  member .position        is POSITION

  -- Orientation
  member .orientation     is ORIENTATION

  -- Size
  member .openingSize     is ARRAY

  -- Aid graphics
  member .aidNumber       is REAL

  -- Tag access
  member .tag             is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     entryExitAccess
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .entryExitAccess()

  -- Initialise Variables
  !this.tag = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     entryExitAccess
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Access point element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid
--
------------------------------------------------------------------------

define method .entryExitAccess(!element is DBREF) is BOOLEAN

  -- Check if element is ACCPNT
  if(!element.type.neq('ACCPNT')) then
    !!error.text     = 'Element :' & !element.namn & ' an entry/exit access.'
    return false
  endif

  -- Initialise Variables
  !this.dbElement   = !element
  if(!element.isnamed) then
    !this.name        = !element.namn
  endif
  !this.function      = !element.function
  !this.accessType    = !element.accType
  !this.position      = !element.position
  !this.orientation   = !element.orientation
  !this.openingSize   = !element.opnsiz

  -- Access Point Number
  !this.number        = !element.sequence

  -- Get relevant landing level (until REFLEV exists)
  !index              = !element.ahlist.findFirst('STRTWR')
  if(!index.set()) then
    !stairTower       = !element.ownLst[!index]
    -- Get level from LNDLEV
    !lIndex           = !stairTower.lndLevel.findFirst(!this.position.up)
    if(!lIndex.set()) then
      !this.refLevel  = !lIndex
    else
      !this.refLevel  = REAL()
    endif
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     aidNumber
--
-- Description: Set aid number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidNumber(!number is REAL)
  !this.aidNumber = !number
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     direction
--
-- Description: Direction of access (Y)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Y direction
--
------------------------------------------------------------------------

define method .direction() is DIRECTION
  return !this.orientation.yDir()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)
  !this.position  = !position
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     refLevel
--
-- Description: Set reference level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refLevel(!level is REAL)
  !this.refLevel  = !level
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     offset
--
-- Description: Offset position by passed direction and value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Direction of offset
--    2   R      READ        Distance to move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!direction is DIRECTION, !distance is REAL)
  !this.position  = !this.position.offset(!direction, !distance)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     accessType
--
-- Description: Returns access type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Return access type (as a readable string)
--
------------------------------------------------------------------------

define method .accessType() is STRING
  if(!this.accessType.eq('ENTR')) then
    !type = 'Entry'
  elseif (!this.accessType.eq('EXIT')) then
    !type = 'Exit'
  elseif (!this.accessType.eq('BOTH')) then
    !type = 'Entry/Exist'
  else
    !type = !this.accessType
  endif
  return !type
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     accessType
--
-- Description: Modify access type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Access type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True of updated
--
------------------------------------------------------------------------

define method .accessType(!type is STRING) is BOOLEAN

  -- Initialise Variables
  !accessType       = !type.upcase().substring(1,4)

  -- If access type is same as current, then don't do anything
  if(!accessType.eq(!this.accessType)) then
    !!error.text    = 'Access type is same as current setting.'
    return false
  endif

  -- Check passed type
  if(not !accessType inset('ENTR','EXIT','BOTH')) then
    !!error.text    = 'Access type must be either Entry, Exit or Both.'
    return false
  endif

  -- Set access type
  !this.accessType  = !accessType

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     accessTypeFlip
--
-- Description: Flip orientation of access
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accessTypeFlip()
  !orientation      = object ORIENTATION('Y is ' & !this.orientation.yDir().opposite() & ' and Z is ' & !this.orientation.zDir())
  !this.orientation = !orientation
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     accessTypeFlip
--
-- Description: Modify access type and flip the orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Access type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True of updated
--
------------------------------------------------------------------------

define method .accessTypeFlip(!type is STRING) is BOOLEAN

  -- Initialise Variables
  !update           = !this.accessType(!type)

  -- Switch orientation
  if(!update) then
    !this.accessTypeFlip()
   endif

  -- Return
  return !update

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     draw
--
-- Description: Draw ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()
  !this.draw(true)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     draw
--
-- Description: Draw ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Tidy existing graphics
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!clear is BOOLEAN)

  -- Don't draw if there is no aid number
  if(!this.aidNumber.unset())then
    return
  endif

  -- Remove current graphics
  if(!clear) then
    !this.tidy()
  endif

  -- Opening size
  if(!this.openingSize.size().eq(2)) then
    !width      = !this.openingSize[1]
    !height     = !this.openingSize[2]
    !length     = !width * 0.5

    -- Draw box definition

    -- Directions (Y is the direction of opening)
    !xDirection = !this.orientation.xDir()
    !yDirection = !this.orientation.yDir()
    !zDirection = !this.orientation.zDir()

    -- Lines
    !baseline   = object LINE(!this.position.offset(!xDirection, !width * -0.5), !this.position.offset(!xDirection, !width * 0.5))
    !topLine    = !baseline.offset(!zDirection, !height)
    !leftline   = object LINE(!baseline.startPosition, !topLine.startPosition)
    !rightline  = object LINE(!baseline.endPosition, !topLine.endPosition)
    !lrline     = object LINE(!baseline.startPosition, !topLine.endPosition)
    !rlline     = object LINE(!baseline.endPosition, !topLine.startPosition)
    !baseline.draw(!this.aidNumber, 1, 2)
    !topLine.draw(!this.aidNumber, 1, 2)
    !leftline.draw(!this.aidNumber, 1, 2)
    !rightline.draw(!this.aidNumber, 1, 2)
    !lrline.draw(!this.aidNumber, 1, 2)
    !rlline.draw(!this.aidNumber, 1, 2)

    AID ARROW NUMBER $!<this.aidNumber> AT $!<this.position> DIRECTION $!<yDirection> HEIGHT $!<length>

    -- Text
    if(!this.tag) then
      !description = !this.accessType()

      if(!this.name.set()) then
        !description  = !description & ' - ' & !this.name
      endif

      if(!this.refLevel.set()) then
        !description  = '(Level:' & !this.refLevel & ') ' & !description
      endif

      !description    = '[Access:' & !this.number & '] ' & !description

      -- Tag information
      AID TEXT NUMBER $!<this.aidNumber> '$!description' AT $!<this.position>
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     modifyDefinition
--
-- Description: Modify ACCPNT definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if updated successfully
--
------------------------------------------------------------------------

define method .modifyDefinition() is BOOLEAN

  -- Initialise Variables

  -- Check element defined
  if(!this.dbElement.unset()) then
    !!error.text  = 'No element to modify.'
    return false
  endif

  -- Modify Element
  !this.dbElement.position      = !this.position
  !this.dbElement.orientation   = !this.orientation

  --!this.dbElement.name          = !this.name
  --!this.dbElement.function      = !this.function
  --!this.dbElement.accType       = !this.accessType
  --!this.dbElement.opnSize       = !this.openingSize

  -- Return
  return true

endmethod
-- End of method
