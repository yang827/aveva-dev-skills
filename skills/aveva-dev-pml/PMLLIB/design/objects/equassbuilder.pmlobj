--
--  Description:     -- Object for building an Equipment association--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   reinitialise this object
--  debug()                          BOOLEAN             Returns true if debug mode switched on (!!assocDebug = true)
--  equAssBuilder()                  -                   Constructor
--  equAssBuilder(DBREF)             -                   Constructor - build object from existing association element
--  getAssocStorageArea()            DBREF               Make an instance of the selected association definition
--  getDefinition(DBREF)             BOOLEAN             Get association definition for this association
--  getMembers(DBREF)                -                   Get members for this association
--  getParameterDefn()               ARRAY               Make an instance of the selected association definition
--  getParameters()                  ARRAY               Get parameters for this association
--  instance()                       DBREF               Make an instance of the selected association definition
--  save(DBREF)                      -                   Save settings in this object to an existing ASSMBR element
--  setName(STRING)                  -                   Set Association element name
--  setParameters(STRING,ARRAY)      -                   Set parameters for this association
--  stdAssociationDefinition(STRING) BOOLEAN             Find standard association given type
--  update()                         DBREF               Update an instance of the selected association definition
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            equassbuilder.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Object for building an Equipment association
--
------------------------------------------------------------------------
--

define object EQUASSBUILDER

  -- Association definition element
  member .assDefinition            is EQUASSDEFINITION
  -- Association element
  member .association              is DBREF
  -- array of association design parameters
  member .designParameters         is ARRAY
  -- Operation to be performed (LE, GE, EQ)
  member .operation                is STRING
  -- array of members (ASSMEMBER)
  member .assMembers               is ARRAY
  -- Array of ASSMBR elements in the instanced association
  member .assMbrElement            is ARRAY
  -- Association name
  member .assocName                is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      equAssBuilder
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equAssBuilder()

    !this.clear()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: reinitialise this object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Initialise variables
  !this.assocName     = ''
  !this.assDefinition = object EQUASSDEFINITION()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      equAssBuilder
--
-- Description: Constructor - build object from existing association element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association member element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equAssBuilder(!association is DBREF)

  !this.clear()

  if( badref(!association) ) then
    -- leave object unset if bad reference
    return
  endif

  -- Association definition
  if( !this.getDefinition(!association).not() ) then
    -- association is not a standard equipment association
    return
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getDefinition
--
-- Description: Get association definition for this association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association member element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true is definition retrieved OK
--
------------------------------------------------------------------------
define method .getDefinition(!association is DBREF) is BOOLEAN

  if( badref(!association) ) then
    -- leave object unset if bad reference
    return false
  endif

  -- get association definition
  if( !this.assDefinition.getDefinition(!association).not() ) then
    -- association is not a standard equipment association
    return false
  endif

  -- Association element
  !this.association      = !association

  -- Association name
  !this.assocName        = !association.namn

  -- get members
  !this.getMembers(!association)

  -- array of parameters
  -- ddesp converts MM to current units
  !realDesignParameters    = !this.association.ddesp
  -- wdesp converts real to word
  !wordDesignParameters    = !this.association.wdesp
  if( defined(!wordDesignParameters[1]) ) then
    !this.operation        = !wordDesignParameters[1]
  endif
  if( defined(!realDesignParameters[2]) ) then
    !this.designParameters = !realDesignParameters.from(2)
  endif

  return true

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      stdAssociationDefinition
--
-- Description: Find standard association given type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Association Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if found - false if invalid
--
------------------------------------------------------------------------
define method .stdAssociationDefinition(!associationType is STRING) is BOOLEAN

  !success = !this.assDefinition.stdAssociationDefinition(!associationType)
  return !success

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setName
--
-- Description: Set Association element name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Valid name of element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setName(!name is STRING)

  !this.assocName = !name

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setParameters
--
-- Description: Set parameters for this association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Operation (LE, GE, EQ)
--    2   R      ARRAY       Parameters for this association
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setParameters(!operation is STRING, !parameters is ARRAY)

  !this.operation        = !operation
  !this.designParameters = !parameters

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getParameters
--
-- Description: Get parameters for this association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Parameters for this association
--
------------------------------------------------------------------------
define method .getParameters() is ARRAY

  -- get operation and design parameters in on array to return
  !result[1] = !this.operation
  !result[2] = !this.designParameters
  return !result

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getMembers
--
-- Description: Get members for this association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association member element
-- Return:
--   [Data Type] [Description]
--    ARRAY       Parameters for this association
--
------------------------------------------------------------------------
define method .getMembers(!association is DBREF)

  -- Array of ASSMBR elements in the instanced association
  !this.assMbrElement = ARRAY()
  !this.assMembers    = ARRAY()
  VAR !assMbrs COLLECT ALL ASSMBR FOR $!<association>

  do !strAssMbr values !assMbrs
    !assMbr = !strAssMbr.dbref()
    -- get details of member and add to the list
    !this.assMbrElement.append(!assMbr)
    !this.assMembers.append(object ASSMEMBER(!assMbr))
  enddo

endmethod
-- End of function definition

-------------------------------------------------------------------
--
-- Method:      instance
--
-- Description: Make an instance of the selected association definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .instance() is DBREF

  -- Initialise variables
  !assDefinition   = !this.assDefinition.assDefinition
  !assDescription  = !this.assDefinition.assDefinitionDesc
  !saveRef         = !!ce

  -- go to Association storage area
  !storageArea = !this.getAssocStorageArea()
  handle any
    !storageArea = object DBREF()
  endhandle
  if( !storageArea.unset() ) then
    return object DBREF()
  endif

  -- validate parameters
  -- skip if null parameter
  !hasParameters = false
  -- get array of EQUASSPARAMETER objects - 1 for each parameter
  !parameterArray = !this.getParameterDefn()
  if( !parameterArray.empty().not() ) then
    if( !parameterArray[1].name.trim().empty().not() ) then

      -- parameter required - is there a parameter and operator to store?
      if( !this.operation.empty() ) then
        !!alert.error( 'Parameter required' )
        return object DBREF()
      else
        if( !this.designParameters.empty() ) then
          !!alert.error( 'Parameter required' )
          return object DBREF()
        endif
      endif
      -- parameters OK
      !hasParameters = true
    endif
  endif

  -- Create Association
  !!ce = !storageArea
  NEW ASSOC COPY DEF $!<assDefinition>
  !!ce.description = !assDescription
  !temp            = !this.assocName.trim()
  if(!temp.empty().not()) then
    NAME $!<temp>
    handle any
    endhandle
  endif
  !assocRef         = !!ce
  !this.association = !!ce

  -- Find association members
  !lName           = !this.assDefinition.assMemberLnames[1]
  VAR !tempMbr LNID $!<lName>
  !this.assMbrElement[1] = object DBREF(!tempMbr)
  !lName                 = !this.assDefinition.assMemberLnames[2]
  VAR !tempMbr LNID $!<lName>
  !this.assMbrElement[2] = object DBREF(!tempMbr)

  -- find restrictions and copy definition descriptions
  VAR !restrictEls COLL ALL RESTRI FOR $!<assocRef>
  do !restrict values !restrictEls
    !restriction = !restrict.dbref()
    -- copy description from RESDEF
    !restriction.description = !restriction.assdfs[1].description
    handle any
      skip
    endhandle
  enddo

  -- skip if null parameter
  if( !hasParameters ) then

    -- set design parameter
    !!ce = !assocRef
    !operation = !this.operation.trim().upcase()
    DESP NUMB 1 $!<operation>
        -- DDESP - Design parameter properties of type DIST need to have
        -- units conversion applied as the DESP attribute always stores values in metric
    !parameter = !this.designParameters[1]
    DDESP NUMB 2 $!<parameter>

  endif

  !!ce = !saveRef
  return !assocRef

endmethod
-- End of function definition

-------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update an instance of the selected association definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .update() is DBREF

  -- Initialise variables
  !saveRef         = !!ce
  !assDefinition   = !this.assDefinition.assDefinition

  -- go to Association member
  !!ce             = !this.association

  -- Update Association
  !!ce.description = !this.assDefinition.assDefinitionDesc
  !temp = !this.assocName.trim()
  if(!temp.empty().not()) then
    NAME $!<temp>
    handle any
    endhandle
  endif
  !assocRef        = !!ce

  -- Find association members
  !lName           = !this.assDefinition.assMemberLnames[1]
  VAR !tempMbr LNID $!<lName>
  !this.assMbrElement[1] = object DBREF(!tempMbr)
  !lName                 = !this.assDefinition.assMemberLnames[2]
  VAR !tempMbr LNID $!<lName>
  !this.assMbrElement[2] = object DBREF(!tempMbr)

  -- get array of EQUASSPARAMETER objects - 1 for each parameter
  !parameterArray = !this.getParameterDefn()

  -- skip if null parameter
  if( !parameterArray.empty().not() ) then
    if( !parameterArray[1].name.empty().not() ) then

      -- parameter required - is there a parameter and operator to store?
      !okToStoreParameters = true
      if( !this.operation.empty() ) then
        !!alert.error( 'Parameter required' )
        !okToStoreParameters = false
      else
        if( !this.designParameters.empty() ) then
          !!alert.error( 'Parameter required' )
          !okToStoreParameters = false
        endif
      endif

      if( !okToStoreParameters ) then
        -- set design parameter
        !!ce = !assocRef
        !operation = !this.operation.trim().upcase()
        DESP NUMB 1 $!<operation>
        -- DDESP - Design parameter properties of type DIST need to have
        -- units conversion applied to the value as the DESP attribute always stores values in metric
        !parameter = !this.designParameters[1]
        DDESP NUMB 2 $!<parameter>
        handle any
          -- use default if something wrong with this value
          !default = !parameterArray[1].default
          DDESP NUMB 2 $!<default>
        endhandle
      endif

    endif
  endif

  !!ce = !saveRef
  return !assocRef

endmethod
-- End of function definition

---------------------------------------------------------------
--
-- Method:      getParameterDefn
--
-- Description: Make an instance of the selected association definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getParameterDefn() is ARRAY

  -- Initialise variables
  return !this.assDefinition.getParameterDefn()

endmethod
-- End of function definition

---------------------------------------------------------------
--
-- Method:      getAssocStorageArea
--
-- Description: Make an instance of the selected association definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAssocStorageArea() is DBREF

  -- Initialise variables
  !storageArea = object DBREF()
  VAR !assocWorlds COLLECT ALL ASSOWL

  -- find first group with purpose ASEQ for equipment associations
  do !assocWorld values !assocWorlds
    VAR !assocGroups COLLECT MEMBERS OF $!<assocWorld> WITH ( HARDTYPE eq |ASSOGP| AND PURP EQ |ASEQ| AND DACCRE )
    do !equipGroup values !assocGroups
      !equipGroupRef = !equipGroup.dbref()
      if( !!dbRefUpdatable(!equipGroupRef) ) then
        -- found writable storage group
        !storageArea = !equipGroupRef
        break
      endif
    enddo
  enddo

  -- if storage area not found - just go for the first writable group
  -- directly owned by a world
  if( !storageArea.unset() ) then
    do !assocWorld values !assocWorlds
      VAR !assocGroups COLLECT MEMBERS OF $!<assocWorld> WITH ( HARDTYPE eq |ASSOGP| AND UNSET(PURP) AND DACCRE )
      do !equipGroup values !assocGroups
        !equipGroupRef = !equipGroup.dbref()
        if( !!dbRefUpdatable(!equipGroupRef) ) then
          -- found writable storage group
          !storageArea = !equipGroupRef
          break
        endif
      enddo
    enddo
  endif

  return !storageArea

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save settings in this object to an existing ASSMBR element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      DBREF of the ASSMBR element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save(!associationMember is DBREF)

  if( badref(!associationMember)) then
    -- leave object unset if bad reference
    return
  endif

  !saveCE = !!ce

  !!ce = !saveCE

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Returns true if debug mode switched on (!!assocDebug = true)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if debug mode switched on. False otherwise
--
------------------------------------------------------------------------
define method .debug() is BOOLEAN

  -- output trace if enabled
  !debugOn = false
  !debugOn = !!assocDebug
  handle any
    !debugOn = false
  endhandle
  return !debugOn

endmethod
-- End of function definition
