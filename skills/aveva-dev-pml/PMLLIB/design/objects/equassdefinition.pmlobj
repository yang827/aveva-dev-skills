--
--  Description:     -- Object for building an Equipment association--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   reinitialise this object
--  equAssDefinition()               -                   Constructor
--  getDefinition(DBREF)             BOOLEAN             Get association definition for given association
--  getParameterDefn()               ARRAY               get parameters for this definition
--  installed()                      BOOLEAN             Returns true if definitions found, false otherwise
--  lookUpStdDefinition(STRING)      REAL                Get association definition reference from association type
--  lookUpStdType(STRING)            REAL                Get association type from definition reference
--  stdAssociationDefinition(STRING) BOOLEAN             Find standard association given type
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            equassbuilder.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Object for building an Equipment association
--
------------------------------------------------------------------------
--

define object EQUASSDEFINITION

  -- Association definition element
  member .assDefinition            is DBREF
  -- Association definition name
  member .assDefinitionName        is STRING
  -- Association definition description
  member .assDefinitionDesc        is STRING
  -- array of parameters (ASSPARAM)
  member .assParameters            is ARRAY
  -- array of members (ASSMEMBER)
  member .assMembers               is ARRAY
  -- association type
  member .assType                  is STRING
  -- association type description
  member .assTypeDesc              is STRING
  -- Association member Lnames for this association - 1 element for each ASSMBR
  member .assMemberLnames          is ARRAY
  -- lookup table of association types against association definition and its member local names
  member .associationTypes         is ARRAY
  member .associationDefinitions   is ARRAY
  member .associationMembDefns     is ARRAY
  member .associationDesc          is ARRAY
   -- array of parameters definitions in the look-up table
  member .assParameterDefn         is ARRAY
 -- index into look-up table of definitions
  member .tableIndex               is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      equAssDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equAssDefinition()

  -- Initialise lookup table of standard associations
  -- Association descriptions
  !this.associationTypes[1]       = 'STDMATE'
  !this.associationTypes[2]       = 'STDALIGN'
  !this.associationTypes[3]       = 'STDPARALLEL'
  !this.associationTypes[4]       = 'STDPARALLELOFFSET'
  !this.associationTypes[5]       = 'STDDISTANCE'
  !this.associationTypes[6]       = 'STDELEVATION'
  !this.associationTypes[7]       = 'STDHORIZDIST'
  !this.associationTypes[8]       = 'STDABOVELINE'
  -- corresponding names of association definitions
  !this.associationDefinitions[1] = '/AV-STDMATE'
  !this.associationDefinitions[2] = '/AV-STDALIGN'
  !this.associationDefinitions[3] = '/AV-STDPARALLEL'
  !this.associationDefinitions[4] = '/AV-STDPARALLELOFFSET'
  !this.associationDefinitions[5] = '/AV-STDDISTANCE'
  !this.associationDefinitions[6] = '/AV-STDELEVATION'
  !this.associationDefinitions[7] = '/AV-STDHORIZDIST'
  !this.associationDefinitions[8] = '/AV-STDABOVELINE'
  -- corresponding member local names
  !tempMembName[1] = '/STDMATE-M1'
  !tempMembName[2] = '/STDMATE-M2'
  !this.associationMembDefns[1]   = !tempMembName
  !tempMembName[1] = '/STDALIGN-M1'
  !tempMembName[2] = '/STDALIGN-M2'
  !this.associationMembDefns[2]   = !tempMembName
  !tempMembName[1] = '/STDPARALLEL-M1'
  !tempMembName[2] = '/STDPARALLEL-M2'
  !this.associationMembDefns[3]   = !tempMembName
  !tempMembName[1] = '/STDPAROFFSET-M1'
  !tempMembName[2] = '/STDPAROFFSET-M2'
  !this.associationMembDefns[4]   = !tempMembName
  !tempMembName[1] = '/STDDISTANCE-M1'
  !tempMembName[2] = '/STDDISTANCE-M2'
  !this.associationMembDefns[5]   = !tempMembName
  !tempMembName[1] = '/STDELEVATION-M1'
  !tempMembName[2] = '/STDELEVATION-M2'
  !this.associationMembDefns[6]   = !tempMembName
  !tempMembName[1] = '/STDHORIZDIST-M1'
  !tempMembName[2] = '/STDHORIZDIST-M2'
  !this.associationMembDefns[7]   = !tempMembName
  !tempMembName[1] = '/STDABOVELINE-M1'
  !tempMembName[2] = '/STDABOVELINE-M2'
  !this.associationMembDefns[8]   = !tempMembName
  -- Association descriptions
  !this.associationDesc[1]        = 'Mate'
  !this.associationDesc[2]        = 'Align'
  !this.associationDesc[3]        = 'Parallel'
  !this.associationDesc[4]        = 'Parallel Offset'
  !this.associationDesc[5]        = 'True Distance'
  !this.associationDesc[6]        = 'Elevation'
  !this.associationDesc[7]        = 'Horizontal Distance'
  !this.associationDesc[8]        = 'Above Line'
  -- parameters
  !maxDistanceParameter           = object EQUASSPARAMETER('Max. Separation', 'DIST', 0.5mm)
  !tolDistanceParameter           = object EQUASSPARAMETER('Tolerance', 'DIST', 0.5mm)
--  !minDistanceParameter           = object EQUASSPARAMETER('Min. Separation', 'DIST', 0mm)
--  !eqDistanceParameter            = object EQUASSPARAMETER('Separation', 'DIST', 0mm)
  !nullParameter                  = object EQUASSPARAMETER()
  !this.assParameterDefn[1][1]    = !maxDistanceParameter
  !this.assParameterDefn[2][1]    = !tolDistanceParameter
  !this.assParameterDefn[3][1]    = !nullParameter
  !this.assParameterDefn[4][1]    = !maxDistanceParameter
  !this.assParameterDefn[5][1]    = !maxDistanceParameter
  !this.assParameterDefn[6][1]    = !maxDistanceParameter
  !this.assParameterDefn[7][1]    = !maxDistanceParameter
  !this.assParameterDefn[8][1]    = !maxDistanceParameter

  -- initialise object members
  !this.clear()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: reinitialise this object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Initialise variables
  !this.assDefinition     = object DBREF()
  !this.assDefinitionName = ''
  !this.assDefinitionDesc = ''
  !this.assMemberLnames   = ARRAY()
  !this.assParameters     = ARRAY()
  !this.tableIndex        = 0

endmethod
-- End of function definition

---------------------------------------------------------------------
--
-- Method:      installed
--
-- Description: Returns true if definitions found, false otherwise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .installed() is BOOLEAN

  -- check that each standard definition can be found
  do !definitionName values !this.associationDefinitions
    !assDefinition = object DBREF(!definitionName)
    handle any
      return false
    endhandle
  enddo
  return true

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      stdAssociationDefinition
--
-- Description: Find standard association given type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Association Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if found - false if invalid
--
------------------------------------------------------------------------
define method .stdAssociationDefinition(!associationType is STRING) is BOOLEAN

  -- Initialise object variables
  !this.clear()

  -- Search table for Association definition corresponding to the given type
  !this.assType         = !associationType.upcase().trim()
  !this.tableIndex      = !this.lookUpStdDefinition(!this.assType)
  if( !this.tableIndex lt 1 ) then
    return false
  endif

  -- get association definition element
  !this.assDefinitionName = !this.associationDefinitions[!this.tableIndex]
  !assDefinition          = object DBREF(!this.assDefinitionName)
--  handle any
--    return false
--  endhandle
  !this.assDefinition   = !assDefinition

  -- get required member local names
  !this.assMemberLnames = !this.associationMembDefns[!this.tableIndex]

  -- get type description
  !this.assTypeDesc     = !this.associationDesc[!this.tableIndex]

  -- get definition description
  !this.assDefinitionDesc = !assDefinition.description

  -- get required parameters
  !this.assParameters   = !this.assParameterDefn[!this.tableIndex]

  return true

endmethod
-- End of function definition

-------------------------------------------------------------------
--
-- Method:      lookUpStdDefinition
--
-- Description: Get association definition reference from association type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Association Type
-- Return:
--   [Data Type] [Description]
--   REAL         Index into definition table - 0 if not found
--
------------------------------------------------------------------------
define method .lookUpStdDefinition(!associationType is STRING) is REAL

  -- Look up type
  !index                = !this.associationTypes.findFirst(!associationType)
  if( !index.unset() ) then
    !index = 0
  endif

  return !index

endmethod
-- End of function definition

-------------------------------------------------------------------
--
-- Method:      lookUpStdType
--
-- Description: Get association type from definition reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Association definition element name
-- Return:
--   [Data Type] [Description]
--   REAL         Index into definition table - 0 if not found
--
------------------------------------------------------------------------
define method .lookUpStdType(!assDefinitionName is STRING) is REAL

  -- Initialise variables
  !index                = !this.associationDefinitions.findFirst(!assDefinitionName)
  if( !index.unset() ) then
    return 0
  endif
  -- get association definition element
  !assTypeName  = !this.associationTypes[!index]
  !this.assType = !assTypeName

  return !index

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getDefinition
--
-- Description: Get association definition for given association
--              This only finds standard associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Association instance element (ASSOC)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Association definition found for given association
--
------------------------------------------------------------------------
define method .getDefinition(!association is DBREF) is BOOLEAN

  -- Initialise object variables
  !this.clear()

  if( badref(!association)) then
    -- leave object unset if bad reference
    return false
  endif

  -- Association definition element
  !this.assDefinition            = !association.adefrf
  handle any
    -- leave object unset if bad definition reference
    return false
  endhandle

  !this.assDefinitionName        = !this.assDefinition.name
  handle any
    -- leave object unset if bad definition reference
    return false
  endhandle

  -- get association type from look-up table
  !this.tableIndex               = !this.lookUpStdType(!this.assDefinitionName)
  if( !this.tableIndex lt 1 ) then
    return false
  endif

  -- get required member local names
  !this.assMemberLnames = !this.associationMembDefns[!this.tableIndex]

  -- get type description
  !this.assTypeDesc     = !this.associationDesc[!this.tableIndex]

  -- get definition description
  !this.assDefinitionDesc = !this.assDefinition.description

  -- get required parameters
  !this.assParameters   = !this.assParameterDefn[!this.tableIndex]

  return true

endmethod
-- End of function definition

---------------------------------------------------------------
--
-- Method:      getParameterDefn
--
-- Description: get parameters for this definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getParameterDefn() is ARRAY

  -- Initialise variables
  return !this.assParameters

endmethod
-- End of function definition
