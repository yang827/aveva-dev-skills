--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Equipment association member object to work with form !!equAssociate
--
--  Created:         Mon Oct 13 17:19:14 2008
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  climbToSignificant(DBREF)        DBREF               From the given element, climb to a significant element for
--  equAssMember()                   -                   Constructor
--  findFaces(DBREF)                 ARRAY               Preview the plane
--  getMyRefPlaneData(EDGPICKDATA)   -                   Build an ASSMEMBER for the picked item
--  initialise(ASSMEMBER)            DBREF               Initialise association member with passed ASSMEMBER
--  initialise(DBREF)                DBREF               Initialise association member with passed element
--  isLinearPlineElement(DBREF)      BOOLEAN             Return true if the element hardtype is in the linear elements list
--  isPlanarHullElement(DBREF)       BOOLEAN             Return true if the element hardtype is in the planar hull elements list
--  matingFaceSet()                  BOOLEAN             Return true if this mating face is set
--  packetTidy()                     -                   Tidy up after EDG close
--  panelSurface(DBREF,STRING)       POINTVECTOR         Preview the plane
--  pickReferencePlane(STRING)       -                   Define edg event that picks a P-point D-point or Pline
--  setAidNumber(STRING)             REAL                Set allocated aid number for this object
--  setFaceOption(GADGET)            -                   Set given option gadget to face list for this object
--  setReferencePlane(REAL)          -                   Set reference plane from the list
--  showBox()                        -                   Show aid box around this item
--  showFace()                       -                   Show selected mating face for this item
--  showFaces()                      -                   Show candidate mating faces for this item
--  tidy()                           -                   Tidy up aid graphics
--  validElement(DBREF)              BOOLEAN             Validate that element is a valid association member reference
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

define object EQUASSMEMBER

  -- Association data
  member .element               is DBREF

  -- list of mating faces for me  (ARRAY of ASSMEMBER)
  member .myMatingFaces         is ARRAY

  -- Selected My Mating Face
  member .matingFace            is ASSMEMBER

  -- face option gadget reference
  member .faceOptionGadget      is GADGET

  -- Aid numbers for position & axes
  member .aidNumber             is REAL
  member .aidBox                is REAL
  member .edgDescription        is STRING

  -- linear steel elements with Plines
  member .linearElementTypes    is ARRAY
  -- planar hull elements
  member .planarHullTypes       is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      equAssMember
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .equAssMember()

  -- Initialise Variables
  !this.element         = object DBREF()
  !this.edgDescription  = 'Pick Reference Plane'
  -- linear steel elements with Plines
  !this.linearElementTypes[1] = 'SCTN'
  !this.linearElementTypes[2] = 'GENSEC'
  !this.linearElementTypes[3] = 'HSTIFF'
  !this.linearElementTypes[4] = 'HPILLR'
  -- planar hull elements
  !this.planarHullTypes[1]    = 'HPLATE'
  !this.planarHullTypes[2]    = 'HBRCKT'
  !this.planarHullTypes[3]    = 'HDOPLA'
  !this.planarHullTypes[4]    = 'HRSOF'
  !this.planarHullTypes[5]    = 'HPANEL'

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise association member with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!passedElement is DBREF) is DBREF

  -- Initialise Variables
  if( badref(!passedElement) ) then
    return object DBREF()
  endif

  -- Find significant element level
  !element                = !this.climbToSignificant(!passedElement)

  -- check that this is a 'true' 3D model element
  if( !this.validElement(!element).not() ) then
    return object DBREF()
  endif

  -- Set Element
  !this.element           = !element

  -- get candidate mating faces for this element
  !this.myMatingFaces     = !this.findFaces(!this.element)
  if( !this.myMatingFaces.empty() ) then
  !this.matingFace        = object ASSMEMBER()
  else
    !this.matingFace      = !this.myMatingFaces[1]
  endif

  return !this.element

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise association member with passed ASSMEMBER
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element represented by this object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!passedAssMember is ASSMEMBER) is DBREF

  -- Initialise Variables
  if( badref(!passedAssMember.amemrf) ) then
    return object DBREF()
  endif

  -- Set Element
  !this.element           = !passedAssMember.getMemberReference()
  !this.matingFace        = !passedAssMember

  -- get candidate mating faces for this element
  !this.myMatingFaces     = !this.findFaces(!this.element)

  return !this.element

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validElement
--
-- Description:
--   Validate that element is a valid association member reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element represented by this object
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True = valid association member reference. False otherwise
--
------------------------------------------------------------------------

define method .validElement(!passedElement is DBREF) is BOOLEAN

  -- Initialise Variables
  if( badref(!passedElement) ) then
    return false
  endif

  -- Find significant element level
  !validOwnerHardTypes[1] = 'ZONE'
  !validOwnerHardTypes[2] = 'BLOCK'
  !validOwnerHardTypes[3] = 'BBLOCK'

  -- check that this is a 'true' 3D model element
  -- get number of owners
  !ownerList = !passedElement.ownlst

  -- invert the array and put the passed element at the top of the list
  !ownerList.invert()

  -- find the first element that matches one of the permissible types
  do !dbElement values !ownerList
    if ( !validOwnerHardTypes.findFirst(!dbElement.hardType.upcase()).set() ) then
      -- found a valid owner in the list
      return true
    endif
  enddo

  -- if fallen through to here, then a match has not been found, so element is not valid
  return false

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      setAidNumber
--
-- Description:
--   Set allocated aid number for this object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Aid number
-- Return:
--   [Data Type] [Description]
--    REAL        Allocated aid number
--
------------------------------------------------------------------------

define method .setAidNumber(!aidDescription is STRING) is REAL

  -- use given aid number to show face feedback
  !this.aidNumber = !!aidNumbers.add(!aidDescription)
  return !this.aidNumber

endmethod
-- End of method definition

---------------------------------------------------------------------
--
-- Method:      showFaces
--
-- Description:
--   Show candidate mating faces for this item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showFaces()

  -- provide graphical feedback
  !!aidNumbers.hide(!this.aidNumber)
  do !face values !this.myMatingFaces
    !face.showPlane( !this.aidNumber )
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showFace
--
-- Description: Show selected mating face for this item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showFace()

  -- don't show face if not set
  if( !this.matingFace.posEv.unset() or !this.matingFace.dirEv.unset() ) then
    return
  endif

  -- Select a plane and show aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  !this.matingFace.showPlane( !this.aidNumber )

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      showBox
--
-- Description:
--   Show aid box around this item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showBox()

  -- Define Graphic Object
  !volume              = object LOCALVOLUME(!this.element, !this.element)
  handle any
    !volume = object LOCALVOLUME()
  endhandle

  -- If volume then use the origin of the item (expanded)
  if(!volume.unset()) then
    !volume            = object LOCALVOLUME()
    !volume.wrt        = !this.element
    !volume.from       = !this.element.position
    !volume.from.east  = !volume.from.east  - 353.5mm
    !volume.from.north = !volume.from.north - 353.5mm
    !volume.from.up    = !volume.from.up    - 353.5mm

    !volume.to         = !this.element.position
    !volume.to.east    = !volume.to.east    + 353.5mm
    !volume.to.north   = !volume.to.north   + 353.5mm
    !volume.to.up      = !volume.to.up      + 353.5mm
  endif

  !box                 = !volume.box()
  !gphBox              = object GPHBOX(!box)

  -- draw box
  !gphBox.draw(!this.aidNumber, false)

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setFaceOption
--
-- Description: Set given option gadget to face list for this object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Option gadget for these faces
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFaceOption(!optionGadget is GADGET)

  !this.faceOptionGadget = !optionGadget
  !this.faceOptionGadget.clear()
  !dText[1] = 'Select...'
  !rText[1] = '0'

  -- get list of face purposes
  do !index indices !this.myMatingFaces
    !rText[!index + 1] = !index.string()
    !dText[!index + 1] = !this.myMatingFaces[!index].purpose
  enddo

  -- set gadget
  !this.faceOptionGadget.dText  = !dText
  !this.faceOptionGadget.rText  = !rText

  -- set active if there are options
  !this.faceOptionGadget.active = !rText.size().gt(1)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setReferencePlane
--
-- Description: Set reference plane from the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setReferencePlane(!refPlaneIndex is REAL)

  -- Select a plane and show aid graphics
  !this.matingFace    = !this.myMatingFaces[!refPlaneIndex]

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove applications events from system
  !!edgCntrl.remove(!this.edgDescription)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickReferencePlane
--
-- Description: Define edg event that picks a P-point D-point or Pline
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Global object name of this object as a string for action callback
--    2   R      STRING      Packet description to be added into EDG system with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickReferencePlane(!objectName is STRING)

  -- Initialise Variables

  -- check if this element has P-lines
  !pLines = !this.element.plname
  handle any
    !pLines = object ARRAY()
  endhandle

  -- Packet definition
  !packet                 = object EDGPACKET()

  if( !pLines.empty() ) then

    -- Pick P-points only
    !packet.pickPacket.stdPpoint('Pick Reference P-point')

  else

    if( !this.isLinearPlineElement(!this.element) ) then
    -- Pick Plines only
    !packet.pickPacket.stdPline('Pick Reference P-Line')
    else
      -- probably a joint of fixing - try for a P-point
      !packet.pickPacket.stdPpoint('Pick Reference P-point')
    endif

  endif

    -- Allow picks only on current element
    -- can't do isAncestor expression - so check to be done after pick
--  !packet.pickPacket.picks[1].pick.input[3]   = 'ref of prmown eq ' & !this.element.refe
  !packet.description = !this.edgDescription
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.close                               = !objectName + '.packetTidy()'
  !packet.escape                              = !objectName + '.packetTidy()'
  !packet.action                              = !objectName + '.getMyRefPlaneData(!this.return[1])'
  !packet.priority        = 3
  !!edgCntrl.add(!packet)

  !!enhanceItem(!this.element, 'violet')
  handle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      packetTidy
--
-- Description: Tidy up after EDG close
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .packetTidy()

  -- clean up colour enhance
  !!enhanceItem(!this.element, '')
  handle any
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getMyRefPlaneData
--
-- Description: Build an ASSMEMBER for the picked item
--              EDG callback from !this.pickReferencePlane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Pick Data
--    2   R      STRING      Action to be carried out
-- Return:
--   [Data Type] [Description]
--    DBREF      Vertex picked
--
------------------------------------------------------------------------

define method .getMyRefPlaneData(!pickData is EDGPICKDATA)

  -- clear up highlighting
  !this.packetTidy()

  -- Initialise Variables
  !pickedElement = !pickData.item

  -- check that picked element is in the hierarchy of this member
  if( !pickedElement ne !this.element ) then
    -- check hierarchy - abort if picked element does not belong to this member
    if( !pickedElement.ownlst.findFirst(!this.element).unset() ) then
      !!alert.error('The selected reference plane must belong to the Association member ' + !this.element.fullname + '. Please select another reference plane.' )
      return
    endif
  endif

  if( !pickData.type eq 'PPOINT' ) then

    !pPoint = !pickData.point
    !tempAssMem           = object ASSMEMBER()
    !tempAssMem.amemrf    = !this.element
    !tempAssMem.ppNumb    = !pPoint
    !tempAssMem.tarf      = !pickedElement
    !tempAssMem.posEv     = !pickedElement.ppos[!pPoint]
    !tempAssMem.dirEv     = !pickedElement.pdir[!pPoint]
    !tempAssMem.purpose   = 'MYFA'

  elseif( !pickData.type eq 'DPOINT' ) then

    !dPoint = !pickData.point
    !tempAssMem           = object ASSMEMBER()
    !tempAssMem.amemrf    = !this.element
    !tempAssMem.tarf      = !pickedElement
    !tempAssMem.numb      = !dPoint
    !tempAssMem.posEv     = !pickedElement.dpps[!dPoint]
    !tempAssMem.dirEv     = !pickedElement.dpdir[!dPoint]
    !tempAssMem.purpose   = 'MYFA'

  elseif( !pickData.type eq 'PLINE' ) then

    !pLine = !pickData.pLine
    !tempAssMem           = object ASSMEMBER()
    !tempAssMem.amemrf    = !this.element
    !tempAssMem.tarf      = !pickedElement
    !tempAssMem.pKey      = !pLine
    !tempAssMem.posEv     = !pickedElement.plStart.attribute(!pLine).wrt( /* )
    !tempAssMem.dirEv     = !pickedElement.plOri.attribute(!pLine).zDir().wrt( /* )
    !tempAssMem.purpose   = 'MYFA'

  else

    !tempAssMem           = object ASSMEMBER()

  endif

  -- abort if something wrong
  if( badref(!tempAssMem.amemrf) ) then
    return
  endif

  -- unset any standard plane selection
  !this.faceOptionGadget.val = 1

  -- store the plane
  !this.matingFace    = !tempAssMem

  -- draw feedback
  !!aidNumbers.hide(!this.aidNumber)
  !tempAssMem.showPlane( !this.aidNumber )

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      findFaces
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findFaces(!element is DBREF) is ARRAY

  -- Initialise variables
  -- List of mating faces (ASSMEMBER OBJECTS)
  !faceList        = object ARRAY()

  -- get type of element and record in the description field
  -- data may be used to recover associations pointing to deleted elements
  !elementType = !element.acttyp

  -- Find faces on given element type
  !dPointList = !element.dpls
  handle any
    !dPointList = object ARRAY()
  endhandle

  -- Get ZDIR face if found
  !unusedOri = !element.orientation
  handle any
  elsehandle none
    -- This element has an ori so set XYFA to Z direction through POS
    !zDirAssMem           = object ASSMEMBER()
    !zDirAssMem.stdElement(!element)
  endhandle

  -- find Design points identified as mating faces
  if( !dPointList.empty().not() ) then
    -- search for Design points with purpose TOFA (top) , BOFA (bottom) , MAFA (match)
    VAR !facePoints COLLECT ALL DPSE MEMBERS WITH (matchwild(purp,|??FA|) ) for $!<element>
    do !index indices !facePoints
      !tempAssMem           = object ASSMEMBER()
      !tempAssMem.stdDesignPoint(!element, !facePoints[!index].dbref() )
      !faceList.append(!tempAssMem)
    enddo
  endif

  if( !faceList.empty() ) then
    -- No Design point faces - try face pPoints
    !tempPointList = !element.ppls
    handle any
      !tempPointList = object ARRAY()
    endhandle
    -- loop through p-points looking for FAce purpose
    do !pPoint values !tempPointList
      !purpose = !element.ppurp[!pPoint]
      handle any
        -- This could happen where design points are reported as ppoints by PPLS
        skip
      endhandle
      skip if( !purpose.matchwild(|??FA|).not() )
      -- we have a P-point with a match purpose
      !tempAssMem           = object ASSMEMBER()
      !tempAssMem.stdPpoint(!element, !pPoint)
      !faceList.append(!tempAssMem)
    enddo
  endif

  if( !faceList.empty() ) then

    !elementType = !element.hardType

    -- try panel surface
    if( !elementType eq 'PANE' ) then

      !faceList[1]   = object ASSMEMBER()
      !faceList[2]   = object ASSMEMBER()
       -- get point vectors of two sides of the panel
      !sidePv[1]     = !this.panelSurface(!element,|TOP|)
      !sidePv[2]     = !this.panelSurface(!element,|BOT|)
       -- record an expression for point
      !faceList[1].amemrf  = !element
      !faceList[1].posEv   = !sidePv[1].position
      !faceList[1].dirEv   = !sidePv[1].direction
      !faceList[1].purpose = 'TOFA'
      !faceList[1].posExpression = 'PPOS 3 OF PAVE 1 OF PLOOP 1 OF AMEMRF WRT /*'
      !faceList[1].dirExpression = 'PDIR 3 OF PAVE 1 OF PLOOP 1 OF AMEMRF WRT /*'
      !faceList[1].actType       = !elementType
      !faceList[1].savPosition   = !faceList[1].posEv
      !faceList[2].amemrf  = !element
      !faceList[2].posEv   = !sidePv[2].position
      !faceList[2].dirEv   = !sidePv[2].direction
      !faceList[2].purpose = 'BOFA'
      !faceList[2].posExpression = 'PPOS 1 OF PAVE 1 OF PLOOP 1 OF AMEMRF WRT /*'
      !faceList[2].dirExpression = 'PDIR 1 OF PAVE 1 OF PLOOP 1 OF AMEMRF WRT /*'
      !faceList[2].actType       = !elementType
      !faceList[2].savPosition   = !faceList[2].posEv
      -- Add ZDIR if found
      if( defined( !zDirAssMem ) ) then
        !faceList.append(!zDirAssMem)
      endif

    elseif( !this.isLinearPlineElement(!element) ) then

      -- find owner of element as amemrf - could be a TMPL - go to its owner
      !elementOwner = !element.owner
      if( !elementOwner.hardType eq 'TMPL' ) then
        -- climb above template if at TMPL element
        !elementOwner = !elementOwner.owner
      elseif( !element.hardType inset('SCTN','GENSEC') ) then
        -- make the AMEMRF and ASSTAR the same, leaving only hull elements with a different owner
        !elementOwner = !element
      endif
      -- get z direction of element as line direction
      !direction = !element.zDir
      handle any
        -- use default if not possible to get ZDIR
        !zDirAssMem         = object ASSMEMBER()
        !zDirAssMem.amemrf  = !elementOwner
        !zDirAssMem.tarf    = !element
        !zDirAssMem.purpose = 'ZDIR'
        !zDirAssMem.posEv   = !element.pos.wrt( /* )
        !zDirAssMem.dirEv   = !element.ori.zDir()
        !zDirAssMem.actType     = !elementType
        !zDirAssMem.savPosition = !zDirAssMem.posEv
        !faceList.append(!zDirAssMem)
      elsehandle none
        -- get list of p-lines for this element
        !pLines = !element.plname

        if( !pLines.empty().not() ) then
          -- loop through P-lines and create a line for each
          do !index indices !pLines
            !pLine         = !pLines[!index]
            -- drop through if getting data from p-line fails
          !position = !element.plStart.attribute(!pLine).wrt( /* )
            !pFace         = object ASSMEMBER()
             -- record an expression for point
            !pFace.amemrf  = !elementOwner
            !pFace.tarf    = !element
            !pFace.posEv   = !position
            !pFace.dirEv   = !direction
            !pFace.purpose = !pLine
            !pFace.posExpression = 'PLSTART ' + !pLine + ' OF ASSTAR WRT /*'
            !pFace.dirExpression = 'ZDIR OF ASSTAR WRT /*'
            !pFace.actType       = !elementType
            !pFace.savPosition   = !pFace.posEv
            !faceList.append(!pFace)
          enddo
        endif
      endhandle

    elseif( !this.isPlanarHullElement(!element) ) then

      -- Planar hull elements
      !temp[1]             = 'HPANEL'
      !hPanel              = !!dtbOwnerOfTypes(!element,!temp)
      !faceList[1]         = object ASSMEMBER()
      !faceList[1].amemrf  = !hPanel
      !faceList[1].tarf    = !element
      !faceList[1].posEv   = !element.pos.wrt( /* )
      !faceList[1].dirEv   = !element.orientation.zDir()
      !faceList[1].purpose = 'TOFA'
      !faceList[1].actType = !elementType
      !faceList[1].savPosition   = !faceList[1].posEv

    else

      -- OTHER ELEMENT TYPES - add ZDIR face if found
      if( defined( !zDirAssMem ) ) then
        !faceList.append(!zDirAssMem)
      endif

    endif

  else

    -- D-points or P-points have been found - add a ZDIR
    if( defined( !zDirAssMem ) ) then
      !faceList.append(!zDirAssMem)
    endif

  endif

  -- always try zdir

  return !faceList

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      panelSurface
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelSurface(!panel is DBREF, !surface is STRING) is POINTVECTOR

-- Initialise default plane which is the plane of the PANEL element
  !plane = object PLANE(!panel.position, !panel.orientation)
  !pv    = !plane.pointVector()
  if( !surface eq |BOT| ) then
    -- reverse the direction for bottom
    !pv.direction = !pv.direction.opposite()
  endif

  -- Get Ploop - return PANEL element plane if no PLOOP
  !loop = PLOOP 1 of $!panel
  handle any
    return !pv
  endhandle
  -- get first vertex of loop - return PANEL element plane if no first vertex
  !vertex = !loop.members[1]
  handle any
    return !pv
  endhandle

  if( !surface.upcase().trim() eq  'TOP' ) then
    -- return top plane
    !pv = object POINTVECTOR(!vertex.pPosition[3], !vertex.pDirection[3])
  elseif( !surface.upcase().trim() eq  'BOT' ) then
    -- return bottom plane
    !pv = object POINTVECTOR(!vertex.pPosition[1], !vertex.pDirection[1])
  elseif( !surface.upcase().trim() eq  'CEN' ) then
    -- return centre plane
    !pv = object POINTVECTOR(!vertex.pPosition[2], !vertex.pDirection[2])
  endif
  -- if !surface argument is incorrect then default PANEL plane is returned

  return !pv

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      .climbToSignificant
--
-- Description: From the given element, climb to a significant element for
--              Association. Returns significant element if found, or
--              null DBREF if no candidate found
-- NOTE test to find that the selected element is in correct Design hierarchy
-- is done separately
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .climbToSignificant(!element is DBREF) is DBREF

  -- if this element is owned by a TMPL, go to the TMPL owner
  !types[1] = 'TMPL'
  !tmpl = !!dtbOwnerOfTypes(!element, !types)
  if( !tmpl.set() ) then
    -- this element is a member of a TMPL, so the significant element is its owner
    return !tmpl.owner
  endif

  -- if element has a spref it is used, even if it is not primary
  -- if it has a spref, there is a chance that it has plines or ppoints
  !temp = !element.spref
  handle any
    !temp = object DBREF()
  endhandle

  if( !temp.unset() ) then
    if( !this.isPlanarHullElement(!element) ) then
      -- accept a planar hull element
      return !element
    endif
    -- find the primary owner of this element
    !primaryOwner = !element.prmown
    handle any
      return object DBREF()
    endhandle
    -- handle special cases
    !primaryType = !primaryOwner.hardType
    if( !primaryType inset('SNOD') ) then
      -- go to owning element in these cases
      !primaryOwner = !primaryOwner.owner
    endif
    if( !primaryType inset('SITE','ZONE','STRU','FRMW','SBFR','PNOD') ) then
      -- Cannot use this element type
      return object DBREF()
    endif

    return !primaryOwner
  else
    -- the given element has a spref, so it could have ppoints or plines
    !primaryType = !element.hardType
    if( !primaryType inset('NOZZ','ELCONN') ) then
      -- special case - Treat NOZZ and ELCONN as primitives
      -- find the primary owner of this element
      !primaryOwner = !element.prmown
      handle any
        return !element
      endhandle
      return !primaryOwner
    else
      return !element
    endif
  endif

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .matingFaceSet
--
-- Description: Return true if this mating face is set
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .matingFaceSet() is BOOLEAN

  return !this.matingFace.assMemberSet()

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .isLinearPlineElement
--
-- Description: Return true if the element hardtype is in the linear elements list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .isLinearPlineElement(!element is DBREF) is BOOLEAN

  return !this.linearElementTypes.findFirst(!element.hardType).set()

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      .isPlanarHullElement
--
-- Description: Return true if the element hardtype is in the planar hull elements list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .isPlanarHullElement(!element is DBREF) is BOOLEAN

  return !this.planarHullTypes.findFirst(!element.hardType).set()

endmethod
-- End of method definition
