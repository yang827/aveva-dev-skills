--
--  Description:     -- Object representing an equipment association parameter--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  equAssParameter()                -
--  equAssParameter(STRING,STRING,REAL) -                   Constructor - build object from arguments
--  realValue()                      REAL                return REAL current value of parameter
--  setValue(REAL)                   -                   Constructor - build object from arguments
--  stringValue()                    STRING              return STRING current value of parameter
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            equassparameter.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
--
-- Description:
-- Object representing an equipment association parameter
--
------------------------------------------------------------------------
--

define object EQUASSPARAMETER

  -- Association parameter name
  member .name           is STRING
  -- Parameter type
  member .type           is STRING
  -- Default value
  member .default        is REAL
  -- current value
  member .value          is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      assMember
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equAssParameter()

  -- Parameter Name
  !this.name        = ''
  -- Parameter type
  !this.type        = ''
  -- Default value
  !this.default     = 0

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      equAssParameter
--
-- Description: Constructor - build object from arguments
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter name
--    2   R      STRING      Parameter type
--    3   R      ANY         Default value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .equAssParameter(!name is STRING, !type is STRING, !default is REAL)

  !this.name    = !name
  !this.type    = !type
  !this.default = !default
  !this.value   = !default

endmethod

-- End of function definition

----------------------------------------------------------------------
--
-- Method:      setValue
--
-- Description: Constructor - build object from arguments
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      String current value of this field
--
------------------------------------------------------------------------
define method .setValue(!value is REAL)

  !this.value = !value

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      stringValue
--
-- Description: return STRING current value of parameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      String current value of this field
--
------------------------------------------------------------------------
define method .stringValue() is STRING

  return !this.value.string()

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      realValue
--
-- Description: return REAL current value of parameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Real current value of this field
--
------------------------------------------------------------------------
define method .realValue() is REAL

  return !this.value

endmethod
-- End of function definition
