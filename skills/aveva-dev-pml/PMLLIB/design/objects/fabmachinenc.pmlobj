--   Type:          Object Definition
--   Group:         Document production
--     Keyword:     Fabrication
--   Module:        Design
--
-- Author:          Steve Bentley
-- Created:         2009/09/09
--
-- Description: Main object to be used to create Fabrication Machine NC Reports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  fabMachineNC(ARRAY,FILE)         -                   Constructor
--  fabMachineNC(DBREF)              -                   Constructor
--  formatUnits(REAL)                STRING              Format to current distance units
--  getBendingActivityTable(DBREF)   ARRAY
--  getBendingTable(DBREF)           ARRAY
--  getReportForPipePieceArray()     -
--  getReportForPipeSpool()          -                   Get pipe piece information
--  getSpool(DBREF)                  DBREF               return the spool owning a passed pipe piece
--  saveReport(BOOLEAN)              -                   Write a Fabrication Machine NC Report
--
define object FABMACHINENC

  -- Members
  -- pipePieces is an ARRAY of DBREFS
  member .pipeSpool         is DBREF
  member .pipeSpoolManager  is PIPESPOOLMANAGER
  member .pipePieces        is ARRAY
  member .bendingTable      is ARRAY
  member .bendingActivities is ARRAY
  member .file              is FILE
  member .fileContents      is ARRAY
  member .mtoTags           is ARRAY
  member .commentPrefix     is STRING

endobject
------------------------------------------------------------------------
--
-- Method:      fabMachineNC
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      DBREF of a Pipe Spool
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fabMachineNC(!pipeSpool is DBREF)

  -- Import the file browser
  Import 'PMLFILEBROWSER'
  handle any
  endhandle

  -- Set the pope spool member
  !this.pipeSpool = !pipeSpool

  -- Get all the members of the spool
  !this.pipeSpoolManager = object PIPESPOOLMANAGER()
  !this.pipePieces       = !this.pipeSpoolManager.getPipePieces(!this.pipeSpool)

  -- Set a comment prefix
  !this.commentPrefix = '-- '

endmethod
------------------------------------------------------------------------
--
-- Method:      fabMachineNC
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      DBREF of a Pipe Spool
--    2    R     FILE       Report File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fabMachineNC(!pipePieceArray is ARRAY, !file is FILE)

  -- Import the file browser
  Import 'PMLFILEBROWSER'
  handle any
  endhandle
  !this.pipePieces = !pipePieceArray

  -- Set a comment prefix
  !this.commentPrefix = '-- '

  !this.file = !file

endmethod
------------------------------------------------------------------------
--
-- Method:      getReportForPipePieceArray
--
-- Description: Get pipe piece information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getReportForPipePieceArray()

  !memory = !!ce

  -- Write the results to file
  !this.saveReport(false)

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      getReportForPipeSpool
--
-- Description: Get pipe piece information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getReportForPipeSpool()

  !memory = !!ce

  -- Write the results to file
  !this.saveReport(true)

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      saveReport
--
-- Description:
--   Write a Fabrication Machine NC Report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveReport(!showBrowser is BOOLEAN)

  -- Initialise variables
  !fileWriteRecord = ARRAY()
  !comment = !this.commentPrefix
  !machineNumber        = '---'
  !numberOfActions      = 0
  !checkSum             = '---'
  !cutLength            = '---'
  !bendRadius      = '---'
  !outsideDiameter = '---'
  !wallThickness   = '---'
  !materialCode    = '---'

  -- This method will show the browser if  requested (Usually for a 1off Pipe Spool report)
  if (!showBrowser) then
    -- Seems like we have to do 1 file per pipe spool
    !element = !this.pipeSpool
    !!ce = !element
    Using Namespace 'Aveva.Pdms.Presentation'
    !browser = object PMLFILEBROWSER('save')
    !fileName = !element.name.replace('/', '') & '.txt'
    !browser.show(|%PDMSUSER%|, !fileName, 'save Report', false, 'Text File (*.txt)|*.txt', 1)
    -- Initialise Variables
    !file     = !!file(!browser.file())

    if(!file.unset()) then
      return
    endif
    -- Store the file on the object member
    !this.file = !file
  else
  	-- File must have been already specified
  	!file = !this.file
  endif

  !dimensionsArray = ARRAY()
  !dimensionsArray[1] = ARRAY()

  -- Add headings to the dimGrid
  !headings = ARRAY()
  !headings.append('Machine')
  !headings.append('NoA')
  !headings.append('Dir')
  !headings.append('B.Rad')
  !headings.append('Ch.sum')
  !headings.append('Quantity')
  !headings.append('O.D.')
  !headings.append('Thk')
  !headings.append('Material_Code')


  -- Time and User information
  !dateTime = object DATETIME()
  !session  = CURRENT SESSION

  -- File header
  !fileWriteRecord.append(!comment & 'Bending Machine Report File')
  !fileWriteRecord.append(!comment & '~~~~~~~~~~~~~~~~~~~~~~~~~~~')
  !fileWriteRecord.append('')
  !fileWriteRecord.append(!comment & '  Created By : ' & !session.name)
  !fileWriteRecord.append(!comment & '        Date : ' & !dateTime)

  -- Need to do per pipe piece
  do !k indices !this.pipePieces

    -- First have to get the Pipe Spool Manager for this Pipe Piece
    !pipeSpool = !this.getSpool(!this.pipePieces[!k])

    -- Invalid Spool? (hence invalid pipe piece. We need to record this)
    !validSpool = !pipeSpool.psvld
    -- If it is valid it may still be a manual bend rather than machine bent .mcbent
    !machineBent = !this.pipePieces[!k].mcbent

    -- Set the pipe spool member
    !this.pipeSpool = !pipeSpool

    if (!validSpool and !machineBent) then
    	
      -- Bending Table
      !this.bendingTable = !this.getBendingTable(!this.pipePieces[!k])
-- Temporary query of 2 dimensional array
--      do !j indices !this.bendingTable
--        -- This is the Bending Table
--        q var !this.bendingTable[!j]
--      enddo

      -- Bending Activities Table
      !this.bendingActivities = !this.getBendingActivityTable(!this.pipePieces[!k])
-- Temporary query of 2 dimensional array
--      do !j indices !this.bendingActivities
--        -- This is the Bending Activity
--        q var !this.bendingActivities[!j]
--      enddo

      -- Make a single array of all the bending activities
      !allActivities = ARRAY()
      !allActivities.append('ACT   ACTION   OPE')
      do !j indices !this.bendingActivities
        !feed = !this.bendingActivities[!j][1].real(!!distanceFmt)
        if (!feed neq 0) then
          !allActivities.append(' 1   (Feed)   ' &  !this.bendingActivities[!j][1])
        endif
        if (!this.bendingActivities[!j][2].real() neq 0) then
          !allActivities.append(' 2   (Turn)   ' &  !this.bendingActivities[!j][2])
        endif
        if (!this.bendingActivities[!j][3].real() neq 0) then
          !allActivities.append(' 3   (Bend)   ' &  !this.bendingActivities[!j][3])
        endif
        -- This will pick up the first feed
        if (undefined(!directionOfFirstFeed)) then
        	if (!feed lt 0) then
        	  !directionOfFirstFeed = 1
        	else
        	  !directionOfFirstFeed = 0
        	endif
        endif      	
      enddo

      -- Some data has to come from the bend rather than the pipe spool manager object
      !bendArray = !this.pipePieces[!k].cmprfa
      -- See if we have a bend
      !bendRadius      = '---'
      !outsideDiameter = '---'
      !wallThickness   = '---'
      !materialCode    = '---'
      do !m indices !bendArray
        if (!bendArray[!m].type eq 'BEND') then
          !bendRadius      = !bendArray[!m].radius.string(!!distanceFmt)
          !outsideDiameter = !bendArray[!m].aod.string(!!distanceFmt)
          var !wallThickness pwallt(1)of $!bendArray[$!m]
          handle ANY
          elsehandle NONE
            var !units split units
            if (!units[3].upcase() neq 'MM') then
            	!wallThickness = !wallThickness & 'in'
            endif
          endhandle
          !materialCode    = !bendArray[!m].mtxx
          handle ANY
          endhandle
          break
        endif
      enddo

      -- Get the corresponding values
      !machineNumber        = !this.bendingTable[1][2]
       handle ANY
       endhandle
      !numberOfActions      = !allActivities.size() - 1
       handle ANY
       endhandle
      !directionOfFirstFeed = !directionOfFirstFeed
      !bendRadius           = !bendRadius
      !checkSum             = !this.bendingTable[1][4]
       handle ANY
       endhandle
      !cutLength            = !this.pipePieces[!k].ppCutLength.string(!!distanceFmt)
       handle ANY
       endhandle
      !outsideDiameter      = !outsideDiameter
      !wallThickness        = !wallThickness
      !materialCode         = !materialCode

      !dimensionsArray = ARRAY()
      !dimensionsArray[1] = ARRAY()
      !dimensionsArray[1].append(!machineNumber)
      !dimensionsArray[1].append(!numberOfActions)
      !dimensionsArray[1].append(!directionOfFirstFeed)
      !dimensionsArray[1].append(!bendRadius)
      !dimensionsArray[1].append(!checkSum)
      !dimensionsArray[1].append(!cutLength)
      !dimensionsArray[1].append(!outsideDiameter)
      !dimensionsArray[1].append(!wallThickness)
      !dimensionsArray[1].append(!materialCode)
      !dimensionsArray.insert(1, !headings)

    else
    	
    endif

    -- Dimensions Table
    !fileWriteRecord.append('')
    !fileWriteRecord.append(!comment & '***** Pipe Spool ' & !pipeSpool.fullname )
    !fileWriteRecord.append(!comment & '***** Bending Activities for Pipe Piece ' & !this.pipePieces[!k].fullname )
    -- Create an underline
    !line = '***** Bending Activities for Pipe Piece ' & !this.pipePieces[!k].fullname
    !underline = ''
    do from 1 to !line.length()
      !underline = !underline & '~'
    enddo
    !fileWriteRecord.append(!comment & !underline)
    !fileWriteRecord.append('')

    if (!validSpool and !machineBent) then
    	
      -- Initial column widths
      !col1 = 3
      !col2 = 3
      !col3 = 3
      !col4 = 3
      !col5 = 3
      !col6 = 3
      !col7 = 3
      !col8 = 3
      !col9 = 3
      -- Loop through dimensions
      do !i indices !dimensionsArray
        -- Get 9 column widths (includes header)
        !col1 = (MAX(!col1, !dimensionsArray[!i][1].string().length()))
        !col2 = (MAX(!col2, !dimensionsArray[!i][2].string().length()))
        !col3 = (MAX(!col3, !dimensionsArray[!i][3].string().length()))
        !col4 = (MAX(!col4, !dimensionsArray[!i][4].string().length()))
        !col5 = (MAX(!col5, !dimensionsArray[!i][5].string().length()))
        !col6 = (MAX(!col6, !dimensionsArray[!i][6].string().length()))
        !col7 = (MAX(!col7, !dimensionsArray[!i][7].string().length()))
        !col8 = (MAX(!col8, !dimensionsArray[!i][8].string().length()))
        !col9 = (MAX(!col9, !dimensionsArray[!i][9].string().length()))
      enddo
      -- Loop through array again
      do !i indices !dimensionsArray

        var !nextLines COMPOSE |$!dimensionsArray[$!i][1]| width $!col1 L spaces 2 $
        |$!dimensionsArray[$!i][2]| width $!col2 L spaces 2 $
        |$!dimensionsArray[$!i][3]| width $!col3 L spaces 2 $
        |$!dimensionsArray[$!i][4]| width $!col4 L spaces 2 $
        |$!dimensionsArray[$!i][5]| width $!col5 L spaces 2 $
        |$!dimensionsArray[$!i][6]| width $!col6 L spaces 2 $
        |$!dimensionsArray[$!i][7]| width $!col7 L spaces 2 $
        |$!dimensionsArray[$!i][8]| width $!col8 L spaces 2 $
        |$!dimensionsArray[$!i][9]| width $!col9 L

        !fileWriteRecord.appendArray(!nextLines)

      enddo

      !fileWriteRecord.append('')

      -- Write Bending Activities to file
      do !j indices !allActivities
        -- With preceding spaces
        !fileWriteRecord.append('        ' & !allActivities[!j])
      enddo

      -- Delete this variable because we restart on every pipe piece
      !directionOfFirstFeed.delete()

    else
    	if (!machineBent) then
  	    -- Just write a line informing this Piece is invalid.
        !fileWriteRecord.append(!comment & 'INVALID Pipe Piece!!  - No NC Output (The Spool needs a successful validation) ')
      else
  	    -- Just write a line informing this Piece is invalid.
        !fileWriteRecord.append(!comment & 'Manually bent Pipe Piece!!  - No NC Output ')
      endif
    endif
  enddo

  -- Footer
  !fileWriteRecord.append('')
  !fileWriteRecord.append(!comment & 'End of Bending Machine Report File')

  -- Close the file
  !file.writefile('overwrite',!fileWriteRecord)
  !file.close()

  -- Read the file and store all contents on object member .fileContents
  !this.fileContents = !file.readFile()

endmethod

------------------------------------------------------------------------
--
-- Method:      getBendingTable
--
-- Description: Get bending table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      This will be a pipe piece dbref
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Report
--
------------------------------------------------------------------------
define method .getBendingTable(!pipePiece is DBREF ) is ARRAY

  -- Checksum is not implemented

  -- Initialise Variables
  !result = ARRAY()
  !pipePieceIndex = '---'
  !bendingMachine = '---'
  !bendingMachineClutch = '---'
  !bendingMachineCheckSum = '---'

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Bending Table
  !bendingTables = !pipeSpoolManager.getBendingTables(!this.pipeSpool)
  -- Welding Table
  !weldingTables = !pipeSpoolManager.getWeldingTables(!this.pipeSpool)
  !this.mtoTags  = !pipeSpoolManager.getMtoElements(!this.pipeSpool)

  -- Find the bending and welding table for this pipe piece
  -- Loop through the array to find the index of the array where .pipePiece matches !pipePiece
  !index = 0
  do !i indices !bendingTables
    if (!bendingTables[!i].pipePiece() eq !pipePiece) then
      !index = !i
      break
    endif
  enddo
  !bendingTable = !bendingTables[!index]
  handle ANY
    -- I assume there is no bending of this pipe piece
    return !result
  endhandle
  !index = 0
  do !i indices !weldingTables
    if (!weldingTables[!i].pipePiece() eq !pipePiece) then
      !index = !i
      break
    endif
  enddo
  !weldingTable = !weldingTables[!index]
  handle ANY
    -- I assume there is no welding of this pipe piece
    !index = !i
    !weldingTable = !weldingTables[!i]
  endhandle

  -- Get the pipe Piece index for the MTO Elements array .findFirst method
  !pipePieceIndex = !this.mtoTags.findFirst(!pipePiece).string()
  -- Get the bending machine directly from the object
  !bendingMachine = !bendingTable.bendingMachine().namn
  -- Get the bending machine check sum directly from the object
  !bendingMachineCheckSum = !bendingTable.checkSum().string(!!distanceFmt)
  handle ANY
    -- Because the checksum is not implemented at VM11.6 SP1
  endhandle

  -- Code to get Bending Machine Clutch tag
  if (!bendingTable.clutchArriveTube()) then
    if (!weldingTable.arriveFlangeWelded()) then
      !bendingMachineClutch = !this.mtoTags.findFirst(!weldingTable.arriveFlange()).string()
    else
      -- Need the end point tag
      !bendingMachineClutch = 'Start'
    endif
  else
    if (!weldingTable.leaveFlangeWelded()) then
      !bendingMachineClutch = !this.mtoTags.findFirst(!weldingTable.leaveFlange()).string()
    else
      -- Need the end point tag
      !bendingMachineClutch = 'End'
    endif
  endif

  !result[1] = ARRAY()
  !result[1][1] = !pipePieceIndex
  !result[1][2] = !bendingMachine
  !result[1][3] = !bendingMachineClutch
  !result[1][4] = !bendingMachineCheckSum

  -- Example return array
  --    -- Create a 2 dimensional array ***************** Only ever 1 line long
  --  !result = ARRAY()
  --  !result[1] = ARRAY()
  --  !result[1][1] = '01'
  --  !result[1][2] = '2'
  --  !result[1][3] = '2B'
  --  !result[1][4] = '2345'

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getBendingActivityTable
--
-- Description: Get bending activities table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      This will be a pipe piece dbref
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Report
--
------------------------------------------------------------------------
define method .getBendingActivityTable(!pipePiece is DBREF ) is ARRAY

  -- Initialise Variables
  !result = ARRAY()

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Bending Table
  !bendingTables = !pipeSpoolManager.getBendingTables(!this.pipeSpool)

  -- Find the bending table for this pipe piece
  -- Loop through the array to find the index of the array where .pipePiece matches !pipePiece
  !index = 0
  do !i indices !bendingTables
    if (!bendingTables[!i].pipePiece() eq !pipePiece) then
      !index = !i
      break
    endif
  enddo
  !bendingTable = !bendingTables[!index]
  handle ANY
    -- I assume there is no bending of this pipe piece
    return !result
  endhandle

 do !i indices !bendingTable.activities()

   -- Get the feed directly from the object
   !feed = !this.formatUnits(!bendingTable.activities()[!i].feed())
   -- Get the rotate directly from the object
   !rotate = !bendingTable.activities()[!i].rotate().string('D2')
   -- Get the bend directly from the object
   !bend = !bendingTable.activities()[!i].bend().string('D2')

   !result[!i] = ARRAY()
   !result[!i][1] = !feed
   !result[!i][2] = !rotate
   !result[!i][3] = !bend

  enddo

  -- Example return array
  -- Create a 2 dimensional array *****************
  --  !result = ARRAY()
  --  !result[1] = ARRAY()
  --  !result[1][1] = '300'
  --  !result[1][2] = '0.0'
  --  !result[1][3] = '90.0'
  --  !result[2] = ARRAY()
  --  !result[2][1] = '400'
  --  !result[2][2] = '45.0'
  --  !result[2][3] = '90.0'

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      formatUnits
--
-- Description: Format to current distance units
-- Values returned from bending activities in core are always in mm. This
-- method takes this into account and then converts to the current units.
-- This ensures that values are correct when imperial is used.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R      REAL     Value to be formatted
-- Return:
--   [Data Type] [Description]
--    STRING      Input value formatted to current units
------------------------------------------------------------------------
define method .formatUnits(!value is REAL)is STRING

  -- Set the value to mm
  !mmValue = $!value mm
  -- Convert to the current distance format
  !result  = !mmValue.string(!!distanceFmt)

  -- Return the result
  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getSpool
--
-- Description: return the spool owning a passed pipe piece
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       DBREF     Pipe Piece
-- Return:
--   [Data Type] [Description]
--     DBREF     Pipe Spool
--
------------------------------------------------------------------------
define method .getSpool(!piece is DBREF) is DBREF

  -- Memory
  !memory = !!ce
  !spool = object DBREF()

  !!ce = !piece
  PIPE
  var !pslist collect all PSLIST for ce
  do !i indices !pslist
    var !pspool collect all PSPOOL for $!pslist[$!i]
    do !j indices !pspool
      !!ce = !pspool[!j].dbref()
      !listOfPieces = !!ce.melrfa
      !test = !listOfPieces.findFirst(!piece)
      if (!test.set()) then
      	!spool = !!ce
        -- Navigate back to the original
        !!ce = !memory
        return !spool
      endif
    enddo
  enddo

  -- Navigate back to the original
  !!ce = !memory
  return !spool

endmethod
-- End of method
