--
-- File:          hmHoleType.pmlobj
-- Type:          Object Definition
-- Group:         Hole Management Application
--
-- Keyword:       UTILITIES
-- Module:        design
-- Replaces:
--
-- Author:        Malcolm Barlow
-- Created:
--
-- Description:
--    Hole type data and parameters for specific hole type
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  freeHoleType()                   -                   Set this object to represent a free hole type
--  getAnswer(REAL)                  STRING              Get answers to given question
--  getDisplayText()                 STRING              Get replacement text of selection gadget
--  getLastParameterValue(STRING)    REAL                Get last temporary stored value for this parameter or the default value
--  getOrientationPointNumber()      REAL                Get orientation P-point number (purpose HMOR)
--  getParameterDefault(STRING)      REAL                Return parameter default for given parameter key
--  getParameterTitle(STRING)        STRING              Return parameter title for given parameter key
--  getQuestions()                   ARRAY               Get selection criteria with 2D array as supplied by SELECTIONTABLE
--  getReplacementText()             STRING              Get replacement text of selection gadget
--  getSecondaryType()               STRING              Get hole part secondary type
--  getUserParameters()              ARRAY               Return user parameter list keys for current selected type
--  hasCoaming()                     BOOLEAN             Returns TRUE if this has coaming
--  hmHoleType()                     -                   Constructor
--  hmHoleType(DBREF)                -                   Constructor
--  isFreeHole()                     BOOLEAN             Returns TRUE if this is a free (user defined boundary) hole
--  loadFromCatalogue(DBREF)         BOOLEAN             Load hole management system GPART
--  loaded()                         BOOLEAN             Catalogue data loaded OK
--  parameters()                     ARRAY               Return parameter list keys for current selected type
--  setAnswers(ARRAY)                -                   Set answers to selection criteria with array as supplied by SELECTIONTABLE
--  setLastParameterValue(ARRAY)     -                   Allows a new set of temporary default parameter values to be stored
--  setLastParameterValue(HMHOLETYPE) -                   Allows a new set of temporary default parameter values to be stored
--  setQuestions(ARRAY)              -                   Set selection criteria with 2D array as supplied by SELECTIONTABLE
--  specification()                  DBREF               Return SPECREF for this hole type
--

------------------------------------------------------------------------

define object HMHOLETYPE

  -- Table of standard (hull) hole GPART data
  -- Hole selection (SPREF) May be a TABITEM or GPART
  member .holeSelection       is DBREF
  -- GPART element for this hole type
  member .gPartElement        is DBREF
  -- Detail text for GPART element
  member .gPartText           is STRING
  -- Replacement text for GPART element in gadgets (array of string GPART/TABITEM references)
  member .gPartRText          is STRING
  -- P-point used to define hole orientation
  member .fixingOriPpoint     is REAL
  -- Array of property keys corresponding to the GPART parameters
  member .parameterKeys       is ARRAY
  -- Array of boolean - true if corresponding property key is a user parameter
  member .userParameterKeys   is ARRAY
  -- Array of DESP values last used for this GPART type
  member .lastParameterValues is ARRAY
  -- SECTYPE attribute of GPART
  member .secondaryType       is STRING
  -- TRUE if the secondary type indicates that this has coaming (SECTYPE has substring after '/')
  member .withCoaming         is BOOLEAN
  -- True is this is a non-catalogue (free) hole management - false if GPART catalogue hole
  member .freeHole            is BOOLEAN
  -- True is this is a valid hole management GPART - false otherwise
  member .valid               is BOOLEAN

  -- Maximum Design Parameters on a form
  member .maxDesPar           is REAL
  -- String used to contain error message for this object (if .valid is false)
  member .error               is STRING
  -- switch for debug output
  member .debug               is BOOLEAN
  -- true if metric project
  member .metric              is BOOLEAN
  -- reserved property keys (DKEY) that the user must not use in their own data sets
  member .reservedKeys        is ARRAY

  -- Selection criteria for this part (Questions)
  member .questions           is ARRAY
  -- Answers to Selection criteria for this part
  member .answers             is ARRAY

  -- Common properties object for this part
  member .comProp             is COMPROP

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmHoleType
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmHoleType()

  -- Initialise Variables
  !this.maxDesPar      = 6
  !this.debug          = false
  -- this object is not valid until all data is successfully loaded
  !this.valid          = false
  -- initialise for catalogue hole
  !this.freeHole       = false
  -- initialise coaming
  !this.withCoaming    = false
  -- reserved property keys
  !this.reservedKeys[1] = 'HTHK'
  !this.reservedKeys[2] = 'HPTH'
  !this.reservedKeys[3] = 'PTHK'
  !this.reservedKeys[4] = 'OLAP'
  !this.reservedKeys[5] = 'CRAD'
  !this.reservedKeys[6] = 'CMHT'
  !this.reservedKeys[7] = 'CMTK'

  -- Set the metric member to TRUE for metric projects and FALSE for imperial projects
  !this.metric = !!isImperialLength('DIST').not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hmHoleType
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       of hole GPART element in the catalogue
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmHoleType(!gPart is DBREF)

  -- Initialise Variables
  !this.hmHoleType()
  !this.loadFromCatalogue(!gPart)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      freeHoleType
--
-- Description: Set this object to represent a free hole type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .freeHoleType()

  -- Initialise Variables
  -- clear hole spec selection reference and GPART reference
  !this.holeSelection       = object DBREF()
  !this.gPartElement        = object DBREF()
  -- Detail text for free hole
  !this.gPartText           = 'User Defined'
  -- Replacement text for free hole
  !this.gPartRText          = 'TMPL'
  -- P-points used to define hole orientation (not used for free hole)
  !this.fixingOriPpoint     = 0
  -- Array of parameter keys (not used for free hole)
  !this.parameterKeys       = ARRAY()
  -- (not used for free hole)
  !this.userParameterKeys   = ARRAY()
  -- (not used for free hole)
  !this.lastParameterValues = ARRAY()
  -- SECTYPE attribute of GPART (not used for free hole)
  !this.secondaryType       = ''
  -- Always false for free holes
  !this.withCoaming         = false
  -- Indicate that this is a free hole
  !this.freeHole            = true
  -- Free hole fully defined
  !this.valid               = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadFromCatalogue
--
-- Description: Load hole management system GPART
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ole part reference
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if this GPART is valid - false otherwise
--
------------------------------------------------------------------------
define method .loadFromCatalogue(!holePart is DBREF) is BOOLEAN

  if( badref(!holePart) ) then
    !this.error = 'Invalid catalogue hole'
    !this.valid = false
    return false
  endif

  if( !holePart.hardType eq 'TABITE' ) then
    if( badref( !holePart.prtref ) ) then
      !this.error = 'Invalid catalogue hole'
      !this.valid = false
      return false
    endif
    !gPart = !holePart.prtref
  elseif( !holePart.hardType eq 'GPART' ) then
    !gPart = !holePart
  else
    -- invalid hole part element
    !this.error = 'Invalid catalogue hole'
    !this.valid = false
    return false
  endif

  -- reset GPART data
  !this.holeSelection   = !holePart
  !this.gPartElement    = !gPart
  !this.gPartText       = ''
  !this.gPartRText      = ''
  !this.parameterKeys.clear()
  !this.fixingOriPpoint = 9
  !this.lastParameterValues.clear()

  -- initialise search for P-points
  !find = object COLLECTION()
  !find.filter(object EXPRESSION('PURP eq |HMOR|'))

  -- Validate catalogue data found
  !propertiesRef = !gPart.catref.dtref
  handle any
    -- mark this object as invalid
    !this.error = 'No DTREF for ' + !gPart.fullname
    !this.valid = false
    return false
  endhandle

  -- Store valid parts
  !this.gPartText     = !gPart.detref.rtext
  handle any
    !this.error = 'GPART not valid for a managed hole (RTEXT)'
    !this.valid = false
    return false
  endhandle
  -- original reference stored - could be TABITEM or GPART
  !this.gPartRText    = !this.holeSelection.string()
  !this.secondaryType = !gPart.secType
  !this.withCoaming   = !this.secondaryType.after('/').empty().not()

  -- Find out the fixing ppoint ori number
  !pointSet = !gPart.catref.ptre
  handle any
    !this.error = 'GPART not valid for a managed hole (point set)'
    !this.valid = false
    return false
  endhandle
  !find.scope(!pointSet)
  !pPoints = !find.results()
  if (!pPoints.empty() ) then
    -- try P9
    !find.filter(object EXPRESSION('NUMBER eq 9 '))
    !pPoints = !find.results()
    if (!pPoints.empty() ) then
      !this.error = 'Unable to use Hole management as the catalogue needs updating. Please contact the Systems Administrator'
      !this.valid = false
      return false
    endif
  endif
  -- store orientation P-point for each GPART
  !this.fixingOriPpoint = !pPoints[1].number
  -- Process number of parameters from data set in catalogue
  !properties = !propertiesRef.member
  do !number indices !properties
    skip if( !properties[!number].purpose neq 'DESP' )
    !key                             = !properties[!number].dKey
    !this.parameterKeys[!number]     = !key
    -- mark keys for users to specify with TRUE and reserved keys as FALSE
    !this.userParameterKeys[!number] = !this.reservedKeys.findFirst(!key).unset()
  enddo

  !this.comProp = object COMPROP(!holePart)

  -- Catalogue data loaded OK
  !this.valid = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getReplacementText
--
-- Description: Get replacement text of selection gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Reference for hole GPART
--
------------------------------------------------------------------------
define method .getReplacementText() is STRING

  return !this.gPartRText

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDisplayText
--
-- Description: Get replacement text of selection gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Description for hole GPART
--
------------------------------------------------------------------------
define method .getDisplayText() is STRING

  return !this.gPartText

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSecondaryType
--
-- Description: Get hole part secondary type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      hole GPART secondary type
--
------------------------------------------------------------------------
define method .getSecondaryType() is STRING

  return !this.secondaryType

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loaded
--
-- Description: Catalogue data loaded OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if catalogue hole data loaded
--
------------------------------------------------------------------------
define method .loaded() is BOOLEAN

  return !this.valid

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      parameters
--
-- Description: Return parameter list keys for current selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of parameter keys (DKEYS)
--
------------------------------------------------------------------------
define method .parameters() is ARRAY

  return !this.parameterKeys

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getUserParameters
--
-- Description: Return user parameter list keys for current selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of user parameter keys (DKEYS)
--
------------------------------------------------------------------------
define method .getUserParameters() is ARRAY

  !return = ARRAY()
  do !index indices !this.parameterKeys
    skip if( !this.userParameterKeys[!index].not() )
    !return.append(!this.parameterKeys[!index])
  enddo

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      specification
--
-- Description: Return SPECREF for this hole type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       SPREF for this hole type
--
------------------------------------------------------------------------
define method .specification() is DBREF

  return !this.holeSelection

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getParameterTitle
--
-- Description: Return parameter title for given parameter key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter (data property) key
-- Return:
--   [Data Type] [Description]
--    STRING      Title of given parameter key
--
------------------------------------------------------------------------
define method .getParameterTitle(!key is STRING) is STRING

  !return = !this.gPartElement.prti.attribute(!key)
  handle any
    !return = 'unset'
  endhandle

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getParameterDefault
--
-- Description: Return parameter default for given parameter key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter (data property) key
-- Return:
--   [Data Type] [Description]
--    REAL       Default parameter value
--
------------------------------------------------------------------------
define method .getParameterDefault(!key is STRING) is REAL

  -- Executed at GPART so RPROP should return the default
  !return = !this.gPartElement.rProp.attribute(!key)
  handle any
    !return = object REAL()
  endhandle

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLastParameterValue
--
-- Description: Allows a new set of temporary default parameter values to be stored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Array of design parameters
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLastParameterValue(!parameterValues is ARRAY)

  -- clear current last set of values
  !this.lastParameterValues.clear()

  -- store values
  !this.lastParameterValues = !parameterValues

  -- zero any remaining values
  do !index from !this.lastParameterValues.size() + 1 to !this.parameterKeys.size()
    !this.lastParameterValues[!index] = 0
  enddo

  -- set COMPROP values
  !this.comProp.currentValues('DESP', !this.parameterKeys, !this.lastParameterValues)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLastParameterValue
--
-- Description: Allows a new set of temporary default parameter values to be stored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      HMHOLETYPE  Copy design parameters from given hole definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLastParameterValue(!holeDefinition is HMHOLETYPE)

  -- clear current last set of values
  !this.lastParameterValues.clear()

  -- store values
  do !index indices !this.parameterKeys
    !value = !holeDefinition.comProp.getCurrentDesignParameter(!this.parameterKeys[!index])
    if(!value.set()) then
      !this.lastParameterValues[!index] = !value
    else
      !this.lastParameterValues[!index] = 0
    endif
  enddo

  -- set COMPROP values
  !this.comProp.currentValues('DESP', !this.parameterKeys, !this.lastParameterValues)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getLastParameterValue
--
-- Description: Get last temporary stored value for this parameter or the default value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter (data property) key
-- Return:
--   [Data Type] [Description]
--    REAL       Last parameter value
--
------------------------------------------------------------------------
define method .getLastParameterValue(!key is STRING) is REAL

  -- clear current last set of values
  !index = !this.parameterKeys.findFirst(!key)
  if( !index.unset() ) then
    -- wrong key for this object
    return object REAL()
  endif

  -- store values
  if( defined(!this.lastParameterValues[!index]) ) then
    !return = !this.lastParameterValues[!index]
  else
    !return = !this.getParameterDefault(!key)
  endif

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOrientationPointNumber
--
-- Description: Get orientation P-point number (purpose HMOR)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL       HMOR P-point number
--
------------------------------------------------------------------------
define method .getOrientationPointNumber() is REAL

  return !this.fixingOriPpoint

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hasCoaming
--
-- Description: Returns TRUE if this has coaming
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if this has coaming
--
------------------------------------------------------------------------
define method .hasCoaming() is BOOLEAN

  return !this.withCoaming

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isFreeHole
--
-- Description: Returns TRUE if this is a free (user defined boundary) hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if this is a free hole - FALSE for GPART
--
------------------------------------------------------------------------
define method .isFreeHole() is BOOLEAN

  return !this.freeHole

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setQuestions
--
-- Description: Set selection criteria with 2D array as supplied by SELECTIONTABLE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       2D questions array as supplied by SELECTIONTABLE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setQuestions(!questions is ARRAY)

  !this.questions = !questions

endmethod

------------------------------------------------------------------------
--
-- Method:      getQuestions
--
-- Description: Get selection criteria with 2D array as supplied by SELECTIONTABLE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D questions array as supplied by SELECTIONTABLE
--
------------------------------------------------------------------------
define method .getQuestions() is ARRAY

  return !this.questions

endmethod

------------------------------------------------------------------------
--
-- Method:      setAnswers
--
-- Description: Set answers to selection criteria with array as supplied by SELECTIONTABLE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of answers to selection criteria as supplied by SELECTIONTABLE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAnswers(!answers is ARRAY)

  !this.answers = !answers

endmethod

------------------------------------------------------------------------
--
-- Method:      getAnswer
--
-- Description: Get answers to given question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Question number
-- Return:
--   [Data Type] [Description]
--    ARRAY       answer array as supplied by SELECTIONTABLE
--
------------------------------------------------------------------------
define method .getAnswer(!number is REAL) is STRING

  return !this.answers[!number][1]

endmethod
