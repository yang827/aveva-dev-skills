-- File:          hmPenetrationData.pmlobj
-- Type:          Object Definition
-- Group:         Hole Management Application
--
-- Keyword:       UTILITIES
-- Module:        design
-- Replaces:
--
-- Author:        Malcolm Barlow
-- Created:
--
-- Description:
--    Penetration data for single penetrations
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  calculatePenetratingAttributes() -                   Calculate attributes of penetration sub-fixing
--  createCoaming(DBREF)             DBREF               apply coaming to a hole
--  createPenetratingFixing(DBREF)   DBREF               Create sub-fixing for each penetrating item
--  createVirtualFixing(DBREF)       DBREF               Create virtual FIXING and FRMW for this penetration
--  drawAxes(REAL)                   -                   Draw aid lines showing axes for this penetration
--  getItemList()                    ARRAY               Get list of elements in this penetration in an array
--  getOffsetPenetratingMarker()     DBREF               Get the DBREF of the offset penetrating marker element
--  getPenetrated()                  DBREF               Get raw penetrated item  - could be CPLATE or HPLATE
--  getPenetratedObject()            DBREF               Get significant penetrated item
--  getPenetratedThickness()         REAL                Get penetrated thickness
--  getPenetrating()                 DBREF               Get the DBREF of the penetrating element
--  getPenetratingDesignParameters() ARRAY               Returns design parameters for penetration sub-fixing (units converted)
--  getPenetratingFixingType()       STRING              Get type of penetration required for penetrating item
--  getPenetratingMarker()           DBREF               Get the DBREF of the penetrating marker element
--  getPosition()                    POSITION            Get position of penetration
--  getSCTNHoleSize(DBREF)           ARRAY               Returns minimum height and width needed for sctn penetration
--  getSectionHoleType()             STRING              Returns the type of hole required for this Section penetration
--  getTrayPosition(DBREF)           POSITION            Return position of tray penetration from AHRP p-point of tray mark atta
--  getTraySize(DBREF)               ARRAY               Return size of tray adjacent to cable tray mark atta
--  getVirtualDesignParameters()     ARRAY
--  getVirtualHole()                 DBREF               Get virtual hole fixing DBREF
--  getVirtualPenetration()          DBREF               Get virtual penetrating sub-fixing DBREF
--  getVirtualSpref()                DBREF               Returns spref for this virtual hole fixing
--  hmPenetrationData()              -                   Constructor
--  hmPenetrationData(DBREF,DBREF,DBREF) -                   Constructor
--  isCableTray()                    BOOLEAN             Return true for cable tray, false for pipe
--  isPlanarPanel()                  BOOLEAN             Returns true if the target panel is planar
--  modifyVirtualFixing()            DBREF               Modify virtual hole FIXING
--  penetratingDir()                 DIRECTION           Returns the zDirection is derived from the penetrating item
--  roundUpParameter(REAL)           REAL                Round up a design parameter to the next 1mm for metric
--  setAngle(REAL)                   -                   Sets angle of rotation of Hole fixing
--  setClearance(REAL)               -                   Sets penetration clearance
--  setCoaming(DBREF)                -                   Sets Coaming reference
--  setCoamingJustification(STRING)  -                   Sets Coaming justification BACK or FRONT
--  setGap(REAL)                     -                   Sets penetration offset
--  setHoleType(HMHOLETYPE)          -                   set object defining hole to be created
--  setOffset(REAL,REAL)             -                   Sets penetration offset
--  setOffsetPenetratingMarker(DBREF) -                   Set reference to virtual penetration fixing
--  setPenetrated(DBREF)             -                   Set raw penetrated item  - could be CPLATE or HPLATE
--  setPenetratedObject()            DBREF               Set significant penetrated item from raw penetrated item
--  setPenetratedThickness()         -                   Determine penetrated thickness from penetrated object
--  setPenetratedThickness(REAL)     -                   Set penetrated thickness explicitly
--  setPenetratingFixingAttributes(DBREF) -                   Set attributes of penetration sub-fixing
--  setPlane(PLANE)                  -                   Sets the plane for the virtual penetration
--  setPosition(POSITION)            -                   Force set penetration position with given position
--  setVirtualFixingAttributes(DBREF) -                   Set attributes of virtual hole fixing
--  setVirtualFixingParameters(DBREF) -                   Set design parameters and SPREF of virtual hole fixing
--  setVirtualHole(DBREF)            -                   Set reference to virtual hole fixing
--  setVirtualHoleType(STRING)       -                   set type of virtual fixing
--  setVirtualPenetration(DBREF)     -                   Set reference to virtual penetration fixing
--  updateCoaming()                  -                   update coaming
--  usePenetratingMarkerPosition()   -                   Clean up the position data using penetrating marker
--  xDir()                           DIRECTION           Returns X direction for the hole fixing
--  zDir()                           DIRECTION           Returns Z direction of the target panel if planar
--

------------------------------------------------------------------------

define object HMPENETRATIONDATA

  -- Penetrated item (actual item)
  member .penetrated           is DBREF
  -- Penetrated item (selected item - possibly higher level object than penetrated)
  member .penetratedObject     is DBREF
  -- DBREF of element created at the penetration (e.g. ATTA)
  member .penetratedMarker     is DBREF
  -- DBREF of penetration marker offset element (e.g. offset RNODE in CWAY)
  member .offsetPenetratingMarker is DBREF
  -- Thickness of penetrated item
  member .thickness            is REAL

  -- Penetrating item
  member .penetrating          is DBREF
  -- DBREF of element created at the penetration (e.g. ATTA)
  member .penetratingMarker    is DBREF
  -- Penetrating type is the 'significant' type for this penetration
  member .penetratingType      is STRING
  -- penetrating position
  member .position             is POSITION
  -- plane of penetrated item at the penetration position
  member .plane                is PLANE
  -- Virtual Fixing Type ('FREE' for Template)
  member .fixingType           is STRING
  -- Virtual Sub-Fixing SPECREF
  member .fixingSpref          is DBREF
  -- Hole shape required for penetrating item 'CIRC' or 'RECT'
  member .holeShapeRequirement is STRING
  -- Width & height for 'RECT' (including clearance)
  member .rectangularClearance is ARRAY
  -- Diameter of 'CIRC' (including clearance)
  member .circularClearance    is REAL
  -- Original fixing orientation
  member .originalFixingDir    is DIRECTION

  -- Hole type definition for this hole
  member .holeDefinition       is HMHOLETYPE
  -- clearance value
  member .clearance            is REAL
  -- angle of rotation
  member .angle                is REAL
  -- X & Y offset
  member .xOffset              is REAL
  member .yOffset              is REAL
  -- cable way gap
  member .gap                  is REAL
  -- Virtual Penetration Fixing (the owner fixing)
  member .virtualHoleRef       is DBREF
  -- Virtual Penetration Fixing (the sub-fixing)
  member .virtualPenetration   is DBREF
  -- Database item where the fixing will be created
  member .virtualStorageArea   is DBREF
  -- Coaming Justification ('FRONT', 'BACK')
  member .coamingJustification is STRING
  -- Coaming Justification ('FRONT', 'BACK')
  member .coamingFixing        is DBREF
  -- true if metric project
  member .metric               is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmPenetrationData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmPenetrationData()

  -- Initialise Variables
  !this.clearance            = 0
  !this.xOffset              = 0
  !this.yOffset              = 0
  !this.angle                = 0
  !this.gap                  = 0
  !this.coamingJustification = 'FRONT'
  !this.fixingType           = ''
  !this.originalFixingDir    = object DIRECTION('EAST WRT WORLD')

  -- Set the metric member to TRUE for metric projects and FALSE for imperial projects
  !this.metric = !!isImperialLength('DIST').not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hmPenetrationData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmPenetrationData(!penetrating is DBREF, !penetratingMarker is DBREF, !penetrated is DBREF)

  -- Initialise Variables
  !this.hmPenetrationData()
  -- set penetration data
  !this.penetrating       = !penetrating
  !this.penetratingMarker = !penetratingMarker
  !this.setPenetrated(!penetrated)
  !this.position          = !this.penetratingMarker.position
  if( !penetrating.type eq 'BRAN' ) then
    !this.penetratingType = !this.penetrating.owner.type
  else
    !this.penetratingType = !penetrating.type
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPenetrated
--
-- Description: Get raw penetrated item  - could be CPLATE or HPLATE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1DBREF       Raw penetrated item
--
------------------------------------------------------------------------
define method .getPenetrated() is DBREF

  return !this.penetrated

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPenetrated
--
-- Description: Set raw penetrated item  - could be CPLATE or HPLATE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Raw penetrated item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPenetrated(!penetrated is DBREF)

  !this.penetrated = !penetrated
  !this.setPenetratedObject()
  !this.setPenetratedThickness()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPenetratedObject
--
-- Description: Set significant penetrated item from raw penetrated item
-- e.g. CPLATE or HPLATE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF      of significant Penetrated item
--
------------------------------------------------------------------------
define method .setPenetratedObject() is DBREF

  if( !this.penetrated.type eq 'CPLATE' ) then
    !this.penetratedObject = !this.penetrated.hrdprx[1]
  elseif( !this.penetrated.type eq 'HPLATE' ) then
    !this.penetratedObject = !this.penetrated.owner
  else
    !this.penetratedObject = !this.penetrated
  endif

  -- set plane for this object if not already set
  if( !this.plane.unset() ) then

    if( !this.isPlanarPanel() ) then
      !this.plane = object PLANE(!this.penetratedObject.position.wrt(world), !this.penetratedObject.orientation.wrt(world))
    endif

  endif

  return !this.penetratedObject

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPenetratedObject
--
-- Description: Get significant penetrated item
--              e.g. CPANEL for CPLATE; HPANEL for HPLATE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Significant Penetrated item
--
------------------------------------------------------------------------
define method .getPenetratedObject() is DBREF

  return !this.penetratedObject

endmethod
-- End of method

