------------------------------------------------------------------------
--
-- Method:      setCoaming()
--
-- Description: Sets Coaming reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Coaming justification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCoaming(!coaming is DBREF)

  !this.coamingFixing = !coaming

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setCoamingJustification()
--
-- Description: Sets Coaming justification BACK or FRONT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Coaming justification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCoamingJustification(!justify is STRING)

  if( !justify.upcase() eq 'BACK' ) then
    !this.coamingJustification = 'BACK'
  else
    !this.coamingJustification = 'FRONT'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setHoleType()
--
-- Description: set object defining hole to be created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      HMHOLETYPE   Hole type definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHoleType(!holeDefinition is HMHOLETYPE)

  !this.holeDefinition = !holeDefinition

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setVirtualHoleType()
--
-- Description: set type of virtual fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole virtual fixing type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setVirtualHoleType(!holeType is STRING)

  !this.fixingType = !holeType

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      usePenetratingMarkerPosition()
--
-- Description: Clean up the position data using penetrating marker
--              Position data from clasher may be incorrect if
--              multi-penetration and on the edge of an HPLATE
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .usePenetratingMarkerPosition()

  !this.position = !this.penetratingMarker.position

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getVirtualSpref()
--
-- Description: Returns spref for this virtual hole fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       of fixing SPREF
--
------------------------------------------------------------------------
define method .getVirtualSpref() is DBREF

  return !this.virtualHoleRef.spref

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getDesignParameters()
--
-- Description: Returns design parameters for this virtual hole fixing (units converted)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of fixing design parameters
--
------------------------------------------------------------------------
define method .getVirtualDesignParameters() is ARRAY

  return !this.virtualHoleRef.ddesp

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getPenetratingDesignParameters()
--
-- Description: Returns design parameters for penetration sub-fixing (units converted)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of fixing design parameters
--
------------------------------------------------------------------------
define method .getPenetratingDesignParameters() is ARRAY

  return !this.virtualPenetration.ddesp

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .modifyVirtualFixing()
--
-- Description: Modify virtual hole FIXING
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of modified fixing
--
------------------------------------------------------------------------
define method .modifyVirtualFixing() is DBREF

  -- calculate requirements of the penetrating item - shape, dimensions, clearance
  !this.calculatePenetratingAttributes()

  -- set attributes of the new virtual hole
  !this.setVirtualFixingParameters(!this.virtualHoleRef)
  !this.setVirtualFixingAttributes(!this.virtualHoleRef)

  -- modify sub-fixing attributes
  !this.setPenetratingFixingAttributes(!this.virtualPenetration)

  return !this.virtualHoleRef

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      .createVirtualFixing()
--
-- Description: Create virtual FIXING and FRMW for this penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of STRU owning this penetration
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of FRMW element for the new fixing
--
------------------------------------------------------------------------
define method .createVirtualFixing(!storageArea is DBREF) is DBREF

  -- clear any existing hole reference
  !this.virtualPenetration = object DBREF()
  !this.virtualStorageArea = !storageArea

  -- Create elements
  !safeCE = !!ce

  !!ce    = !this.virtualStorageArea
  NEW FRMW
  handle any
    return object DBREF()
  endhandle
  !returnRef           = !!ce
  NEW FIXING
  !this.virtualHoleRef = !!ce

  -- calculate requirements of the penetrating item - shape, dimensions, clearance
  !this.calculatePenetratingAttributes()

  -- set parameters of the new virtual hole
  !this.setVirtualFixingParameters(!this.virtualHoleRef)

  -- initialise original orientation
  !this.originalFixingDir = !this.xDir()

  -- set virtual hole fixing attributes
  !this.setVirtualFixingAttributes(!this.virtualHoleRef)

  -- Execute any naming rules that have been defined
  !!ce = !this.virtualHoleRef
  CALL !!autonamece(false)
  handle any
  endhandle

  -- create sub-fixing
  !subFixing = !this.createPenetratingFixing(!this.virtualHoleRef)

  -- modify sub-fixing attributes
  !this.setPenetratingFixingAttributes(!subFixing)

  !!ce = !safeCE

  return !returnRef

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .setVirtualFixingAttributes()
--
-- Description: Set attributes of virtual hole fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Hole fixing
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setVirtualFixingAttributes(!virtualHole is DBREF)

  !safeCE = !!ce
  !!ce     = !virtualHole

  -- Get penetrated item thickness
  if( !this.thickness eq 0 ) then
    !plateThickness = 1mm
  else
    !plateThickness = !this.thickness
  endif
  !thickness      = !plateThickness * 2
  !factor         = 60mm / ( !thickness + 60mm )
  !thicknessClear = !thickness + !thickness * !factor

  -- set clearance
  !!ce.excess      = !this.clearance

  -- set offset by encoding values in the description attribute
  !offset          = 'xoffset' & !this.xOffset.string() & 'yoffset' & !this.yOffset.string()
  !!ce.description = !offset

  -- determine a frame of reference for the offsets, and set the virtual orientation
  !direction = !this.zDir()
  !xOffDir   = !this.xDir()

  !yOffDir   = !direction.orthogonal(!xOffDir)

  -- get properties of the penetrated item
  !position  = !this.position
  !position  = !position.offset(!xOffDir, !this.xOffset)
  !position  = !position.offset(!yOffDir, !this.yOffset)
  !!ce.pos   = !position

  -- opposite direction if coaming is on the back of the plate
  if( !this.holeDefinition.hasCoaming() ) then
    if( !this.coamingJustification eq 'BACK' ) then
      !direction = !direction.opposite()
    endif
  endif

  if( !this.holeDefinition.isFreeHole().not() and !this.holeDefinition.loaded() ) then

    -- orientate fixing if standard catalogue type hole
    !pPointNumber    = !this.holeDefinition.getOrientationPointNumber()
    !pPointOriNumber = 'P' + !pPointNumber.string()
    !fixingDirection = !this.originalFixingDir
    if( !this.holeDefinition.hasCoaming() ) then
      if( !this.coamingJustification eq 'BACK' ) then
        !fixingDirection = !this.originalFixingDir.opposite()
      endif
    endif
    ORI P1 is $!<direction> and $!<pPointOriNumber> is $!<fixingDirection>
    handle (61,7)
      -- on creation just ori the p1
      ORI P1 is $!<direction>
    endhandle
    ROTATE ABOUT P1 BY $!<this.angle>

  endif

  !!ce = !safeCE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .setVirtualFixingParameters()
--
-- Description: Set design parameters and SPREF of virtual hole fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Hole fixing
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setVirtualFixingParameters(!virtualHole is DBREF)

  !safeCE = !!ce
  !!ce     = !virtualHole

  -- Parameters and SPREF not set for Free hole
  if( !this.holeDefinition.isFreeHole() ) then
    DESP  UNSET
    SPREF UNSET
    !!ce = !safeCE
    return
  endif

  -- Clear out any free hole template if one exists
  !templateCount = !virtualHole.mcount('TMPL')
  if (!templateCount eq 1) then
      TMPL 1
      DELETE TMPL
  endif

  -- Get penetrated item thickness
  if( !this.thickness eq 0 ) then
    !plateThickness = 1mm
  else
    !plateThickness = !this.thickness
  endif
  !thickness      = !plateThickness * 2
  !factor         = 60mm / ( !thickness + 60mm )
  !thicknessClear = !thickness + !thickness * !factor

  -- Cannot set Parameters and SPREF if no current selection
  if( !this.holeDefinition.loaded().not() ) then
    DESP  UNSET
    SPREF UNSET
    !!ce = !safeCE
    return
  endif

  -- set Design Parameters
  -- The system introduces thickness design parameters and
  -- it tries to set minimum dimensions based on hole clearance
  !parameterKeys = !this.holeDefinition.parameters()
  !keys   = ARRAY()
  !values = ARRAY()
  do !index to !parameterKeys.size()
    !key        = !parameterKeys[!index]
    !keys.append(!key)
    if( !key eq 'HTHK' ) then
      !values.append(!thickness)
    elseif( !key eq 'HPTH' ) then
      !values.append(!plateThickness)
    elseif( !key eq 'FDIA' ) then
      -- Set diameter at least as big as penetrating requirement
      !lastValue = !this.holeDefinition.getLastParameterValue(!key)
      if( !this.holeShapeRequirement eq 'CIRC' ) then
        !requiredValue = !this.circularClearance
      elseif (!this.holeShapeRequirement eq 'OVAL' ) then
        !requiredValue = !this.rectangularClearance[1].max( !this.rectangularClearance[2])
      elseif( !this.holeShapeRequirement eq 'RECT' ) then
        !width  = !this.rectangularClearance[1]
        !height = !this.rectangularClearance[2]
        !requiredValue = sqrt( !width * !width + !height * !height )
      else
        !requiredValue = !lastValue
      endif
      if( !lastValue.unset() or !requiredValue gt !lastValue ) then
        !values.append(!requiredValue)
      else
        !values.append(!lastValue)
      endif
    elseif( !key eq 'FWID' ) then
      -- Set width at least as big as penetrating requirement
      !lastValue = !this.holeDefinition.getLastParameterValue(!key)
      if( !this.holeShapeRequirement eq 'CIRC' ) then
        !requiredValue = !this.circularClearance
      elseif (( !this.holeShapeRequirement eq 'RECT' ) and (!this.holeDefinition.secondaryType eq 'TYPE HO')) then
        !width  = !this.rectangularClearance[1]
        !height = !this.rectangularClearance[2]
        !requiredValue = sqrt( !width * !width + !height * !height )
      elseif( !this.holeShapeRequirement inset('RECT', 'OVAL') ) then
        !requiredValue = !this.rectangularClearance[1]
      else
        !requiredValue = !lastValue
      endif
      if( !lastValue.unset() or !requiredValue gt !lastValue ) then
        !values.append(!requiredValue)
      else
        !values.append(!lastValue)
      endif
    elseif( !key eq 'FHEI' ) then
      -- Set height at least as big as penetrating requirement
      !lastValue = !this.holeDefinition.getLastParameterValue(!key)
      if( !this.holeShapeRequirement eq 'CIRC' ) then
        !requiredValue = !this.circularClearance
      elseif( !this.holeShapeRequirement inset('RECT', 'OVAL' )) then
        !requiredValue = !this.rectangularClearance[2]
      else
        !requiredValue = !lastValue
      endif
      if( !lastValue.unset() or !requiredValue gt !lastValue ) then
        !values.append(!requiredValue)
      else
        !values.append(!lastValue)
      endif
    else
      -- All other cases use the last set or default value
      !values.append(!this.holeDefinition.getLastParameterValue(!key))
    endif
    -- set design parameter corresponding to the property key
--    DDESP N$!<index> $!<value>
  enddo

  -- set catalogue selection reference
  !this.holeDefinition.setLastParameterValue(!values)
  !this.holeDefinition.comProp.forceHiddenDesignParameters(true)
  !this.holeDefinition.comProp.setProperties(!!ce)
  !this.holeDefinition.comProp.unsetDesiElement()

  !!ce = !safeCE
  handle any
    -- in case element has been deleted
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .createPenetratingFixing()
--
-- Description: Create sub-fixing for each penetrating item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Hole fixing to own new sub-fixing
-- Return:
--   [Data Type] [Description]
--    DBREF       of new penetration sub-fixing or design point (for CWAY)
--
------------------------------------------------------------------------
define method .createPenetratingFixing(!virtualHoleFixing is DBREF) is DBREF

  !!ce = !virtualHoleFixing

  if( !this.getPenetratingFixingType() eq 'CWAY' ) then

    -- CWAY does not have a sub-fixing because the hole typically does not coincide with
    -- the cable way itself because the cable supports do not pass through the hole
    -- Only cable passes through a penetration. A Design point marks the penetration point.
    -- Add merged hole DPCA to same DPSE
    !pointSetRef = object DBREF()
    do !member values !!ce.members
      skip if(!member.hardType neq 'DPSE')
      skip if(!member.purpose neq 'HOLE')
      !pointSetRef = !member
      break
    enddo
    if( !pointSetRef.unset() ) then
      NEW DPSE PURP HOLE
      NEW DPCA PURP HOLE
    else
      !!ce = !pointSetRef
      NEW DPCA AFTER LAST MEM
      handle any
        NEW DPCA
      endhandle
      PURP HOLE
    endif
    !this.virtualPenetration = !!ce

  else

    -- create sub-fixing for other disciplines - allow for merged penetrations with more than one sub-fixing
    NEW FIXING AFTER LAST MEMBER
    handle (2,113)
      -- first sub-fixing
      NEW FIXING
    endhandle
    !this.virtualPenetration = !!ce

    -- Execute any naming rules that have been defined
    PURP HOLE
    CALL !!autonamece(false)
    handle any
    endhandle

  endif

  return !this.virtualPenetration

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .setPenetratingFixingAttributes()
--
-- Description: Set attributes of penetration sub-fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element where attributes are set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPenetratingFixingAttributes(!virtualPenetrationFixing is DBREF)

  if( !virtualPenetrationFixing.hardType eq 'DPCA' ) then
    -- this is a cableway penetration which does not have a sub-fixing
    !virtualPenetrationFixing.position = !this.penetratingMarker.position.wrt( world )
    !this.penetratingMarker.yOff       = !this.gap
    -- calculate offset of offset RNODE from penetration in frame of reference of the penetration RNODE
    !offset                            = !virtualPenetrationFixing.owner.owner.position.wrt(!this.penetratingMarker)
    !this.offsetPenetratingMarker.xOff = !offset.east
    !this.offsetPenetratingMarker.yOff = !offset.north
    !this.offsetPenetratingMarker.zOff = !offset.up
    return
  endif

  !!ce             = !virtualPenetrationFixing
  -- get normal direction from owning fixing
  !direction       = !this.penetratingDir()
  if( !direction.unset() ) then
    !direction       = !this.zDir()
  endif
  !localHoleType   = object HMHOLETYPE(!this.fixingSpref)
  if( !localHoleType.loaded() ) then
    !pPointOriNumber = 'P' + !localHoleType.getOrientationPointNumber().string()
  else
    -- this will force an error that will be handled below
    !pPointOriNumber = 'P'
  endif

  if( !this.penetratingMarker.hardType neq 'COUP' ) then
    !!ce.cref        = !this.penetratingMarker
    handle (2,21)
      -- Item can not be cross referenced
    endhandle
  endif

  -- Position at the penetrating marker
  !position        = !this.penetratingMarker.position.wrt( world )
  !!ce.pos         = !position

  -- Get penetrated item thickness
  if( !this.thickness eq 0 ) then
    !plateThickness = 1mm
  else
    !plateThickness = !this.thickness
  endif
  !thickness      = !plateThickness * 2
  !factor         = 60mm / ( !thickness + 60mm )
  !thicknessClear = !thickness + !thickness * !factor

  -- set clearance
  !!ce.excess      = !this.clearance

  !holeType = !this.getPenetratingFixingType()
  -- create clearance shape for each hole type
  -- Change the spre based on the type of penetration
  if (!holeType inset('PIPE', 'CIRC', '') ) then
    !clearance = !this.circularClearance
    DDESP $!<clearance> $!<thicknessClear> 0 0
    !!ce.spref = !this.fixingSpref
    ORI P1 is $!<direction>
  elseif(!holeType eq 'RECT') then
    -- rectangular HVAC penetrating item
    !widthDirection = !this.penetratingMarker.pDir[6]
    !width          = !this.rectangularClearance[1]
    !height         = !this.rectangularClearance[2]
     DDESP $!<width> $!<height> 0 $!<thicknessClear> 0 0
    !!ce.spref      = !this.fixingSpref
    ORI P1 is $!<direction> and $!<pPointOriNumber> is $!<widthDirection>
    handle any
      ORI P1 is $!<direction>
    endhandle
  elseif(!holeType eq 'OVAL') then
    -- oval HVAC penetrating item
    !widthDirection = !this.penetratingMarker.pDir[6]
    !width          = !this.rectangularClearance[1]
    !height         = !this.rectangularClearance[2]
    if (!width lt !height) then
      !width = !height
    endif
    DDESP $!<width> $!<height> $!<thicknessClear> 0 0
    !!ce.spref      = !this.fixingSpref
    ORI P1 is $!<direction> and $!<pPointOriNumber> is $!<widthDirection>
    handle any
      ORI P1 is $!<direction>
    endhandle

  elseif(!holeType eq 'SCTN') then

    !widthDirection = !this.originalFixingDir
    if( !this.holeShapeRequirement eq 'CIRC' ) then
      !clearance = !this.circularClearance
      DDESP $!<clearance> $!<thicknessClear> 0 0
      !!ce.spref      = !this.fixingSpref
      ORI P1 is $!<direction>
    else
      !width          = !this.rectangularClearance[1]
      !height         = !this.rectangularClearance[2]
      DDESP $!<width> $!<height> 0 $!<thicknessClear> 0 0
      !!ce.spref      = !this.fixingSpref
      ORI P1 is $!<direction> and $!<pPointOriNumber> is $!<widthDirection>
      handle any
        ORI P1 is $!<direction>
      endhandle
    endif

  elseif(!holeType eq 'TRAY') then

    -- override the position to be the AHRP p-point position
    !this.position   = !this.getTrayPosition(!this.penetratingMarker)
    !!ce.pos         = !this.position
    -- rectangular cable tray penetrating item
    !widthDirection = !this.penetratingMarker.orientation.zDir().orthogonal(!this.penetratingMarker.pDir[!this.penetratingMarker.leave])
    !traySize       = !this.getTraySize(!this.penetratingMarker)
    !width          = !traySize[1]
    !height         = !traySize[2]
     DDESP $!<width> $!<height> 0 $!<thicknessClear> 0 0
    !!ce.spref      = !this.fixingSpref
    ORI P1 is $!<direction> and $!<pPointOriNumber> is $!<widthDirection>
    handle any
      ORI P1 is $!<direction>
    endhandle

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .calculatePenetratingAttributes()
--
-- Description: Calculate attributes of penetration sub-fixing
--              to be used when virtual fixing and sub-fixing are created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculatePenetratingAttributes()

  !holeType = !this.getPenetratingFixingType()
  -- create clearance shape for each hole type
  -- Change the spre based on the type of penetration
  if (!holeType eq 'PIPE' or !holeType eq '' ) then
    !this.fixingSpref          = object DBREF('/HM-HOLE/TYPE-D')
    -- Get OD rounded to nearest 1mm or 1/32 inch
    !attaOD                    = !this.roundUpParameter(!this.penetratingMarker.pod[1])
    !clearance                 = !attaOD + (2 * !this.clearance)
    !this.holeShapeRequirement = 'CIRC'
    !this.circularClearance      = !clearance
  elseif (!holeType eq 'CIRC') then
    -- circular HVAC penetrating item
    !this.fixingSpref          = object DBREF('/HM-HOLE/TYPE-D')
    !od        = !this.roundUpParameter(!this.penetratingMarker.ddesp[4])
    !clearance = (!od + 2 * !this.clearance)
    !this.holeShapeRequirement = 'CIRC'
    !this.circularClearance    = !clearance
  elseif(!holeType eq 'RECT') then
    -- rectangular HVAC penetrating item
    !this.fixingSpref          = object DBREF('/HM-HOLE/TYPE-HR')
    !width  = !this.roundUpParameter( !this.penetratingMarker.ddesp[4] )
    !height = !this.roundUpParameter( !this.penetratingMarker.ddesp[5] )
    !width  = (!width + 2  * !this.clearance)
    !height = (!height + 2 * !this.clearance)
    !this.holeShapeRequirement    = 'RECT'
    !this.rectangularClearance[1] = !width
    !this.rectangularClearance[2] = !height
  elseif(!holeType eq 'OVAL') then
    -- oval HVAC penetrating item
    !this.fixingSpref          = object DBREF('/HM-HOLE/TYPE-HO')
    !width  = !this.roundUpParameter(!this.penetratingMarker.ddesp[4] )
    !height = !this.roundUpParameter(!this.penetratingMarker.ddesp[5] )
    --if the width is less than the height the sub-fixing disappears!
    if (!width lt !height) then
      !width = !height
    endif
    !width  = (!width + 2 * !this.clearance)
    !height = (!height + 2 * !this.clearance)
    !this.holeShapeRequirement    = 'OVAL'
    !this.rectangularClearance[1] = !width
    !this.rectangularClearance[2] = !height
  elseif(!holeType eq 'SCTN') then
    if( !this.getSectionHoleType() eq 'CIRC' ) then
      !this.fixingSpref             = object DBREF('/HM-HOLE/TYPE-D')
      !this.holeShapeRequirement    = 'CIRC'
      !res = !this.getSCTNHoleSize(!this.penetrating)
      !this.circularClearance       = !res[1]
     else
      !this.fixingSpref             = object DBREF('/HM-HOLE/TYPE-HR')
      !this.holeShapeRequirement    = 'RECT'
      !res = !this.getSCTNHoleSize(!this.penetrating)
      !this.rectangularClearance[1] = !res[1]
      !this.rectangularClearance[2] = !res[2]
    endif
  elseif(!holeType eq 'CWAY') then
    -- there is no sub-fixing on a CWAY penetration
    -- A Design point marks the penetration
    !this.fixingSpref             = object DBREF()
    !cableWay                     = !this.penetrating
    !width                        = !cableWay.vWidth
    !height                       = !cableWay.vHeight
    !this.holeShapeRequirement    = 'CWRE'
    !this.rectangularClearance[1] = !width
    !this.rectangularClearance[2] = !height
  elseif(!holeType eq 'TRAY') then
    -- rectangular HVAC penetrating item
    !this.fixingSpref             = object DBREF('/HM-HOLE/TYPE-HR')
    !this.rectangularClearance    = !this.getTraySize(!this.penetratingMarker)
    !this.holeShapeRequirement    = 'RECT'
    -- override the position to be the AHRP p-point position
    !this.position                = !this.getTrayPosition(!this.penetratingMarker)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      getSectionHoleType(!sctn is dbref)
--
-- Description: Returns the type of hole required for this Section penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     dbref      sctn under consideration
-- Return:
--   [Data Type]      [Description]
--    STRING           type of hole required - CIRC or RECT
--
------------------------------------------------------------------------
define method .getSectionHoleType() is STRING

  !section = !this.penetrating
  !return  = 'RECT'

  -- find the shape and parameters from the GTYP
  if( not !section.hardtype inset('SCTN', 'GENSEC') ) then
    return !return
  endif

  !gType = !section.gtype
  if( !gType.empty() ) then
    -- get the GTYP from the catalogue if it is unset on the element
    !gType = !section.catref.gtype
    handle any
      !gType = ''
    endhandle
  endif

  if ( !gType inset('TUBE', 'CTUB') ) then
    -- return circle for tubular
    !return = 'CIRC'
  endif

  return !return

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getSCTNHoleSize(!sctn is dbref)
--
-- Description: Returns minimum height and width needed for sctn penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     dbref      sctn under consideration
-- Return:
--   [Data Type]      [Description]
--    ARRAY of real   [1] = width [2] = height
--
------------------------------------------------------------------------
define method .getSCTNHoleSize(!sctn is DBREF) is ARRAY

  !parameter1 = !sctn.catref.para[1]
  handle any
    --if this fails then bail out with zeros
    !res[1] = 0
    !res[2] = 0
    return !res
  endhandle
  !height = !!comConvertUnknownValue(!parameter1,'MM')

  -- special cases that need to be tested by name
  !genAngle = (!sctn.catref.pstref.flnn eq 'Generic-Angle-Profile/PTSS')
  handle any
    !genAngle = false
  endhandle
  !hpptss = (!sctn.catref.pstref.flnn eq 'HP-PTSS')
  handle any
    !hpptss = false
  endhandle
  !cbrv = (!sctn.catref.pstref.flnn eq 'GENERAL-BEAMS-PTSS-RECT-VARI')
  handle any
    !cbrv = false
  endhandle
  !joiner = (!sctn.catref.pstref.flnn eq 'MHULL/PANEL-SUPPORT/JOIN/PTSS')
  handle any
    !joiner = false
  endhandle

  -- find the shape and parameters from the GTYP
  !gType = !sctn.gtype
  if( !gType.empty() ) then
    -- get the GTYP from the catalogue if it is unset on the element
    !gType = !sctn.catref.gtype
    handle any
      !gType = ''
    endhandle
  endif

  if ( !gType inset('TUBE', 'RBAR', 'SBAR', 'CTUB', 'HBAR') ) then
     -- tubes and solid bar don't have the same catalog parameters as other SCTN elements
     !width = !height
  elseif (!gType eq 'BULB') then
    -- bulbs don't have a catalog param with the max width so have to mess around a bit
    !width = !!comConvertUnknownValue(!sctn.catref.para[2],'MM') + !!comConvertUnknownValue(!sctn.catref.para[3],'MM') + !!comConvertUnknownValue(!sctn.catref.para[4],'MM')
    handle any
      !width = 0mm
    endhandle
  elseif (!genAngle or !hpptss) then
    !width = !!comConvertUnknownValue(!sctn.catref.para[2],'MM') + !!comConvertUnknownValue(!sctn.catref.para[3],'MM')
    handle any
      !width = 0mm
    endhandle
  elseif (!cbrv) then
    --may not have any parameters set. Default to 500 x 500
    if (!sctn.catref.para.unset()) then
      !height = 500mm
      !width = 500mm
    else
      !width = !!comConvertUnknownValue(!sctn.catref.para[2],'MM')
      handle any
        !width = 500mm
      endhandle
    endif
  elseif (!joiner) then
    --wall/panel joiner has 2 sides that can be of different heights
    !h1      = 2 * !!comConvertUnknownValue(!sctn.catref.para[3],'MM')
    handle any
      !h1    = 0mm
    endhandle
    !h2      = 2 * !!comConvertUnknownValue(!sctn.catref.para[4],'MM')
    handle any
      !h2    = 0mm
    endhandle
    !height  = !h1.max(!h2)
    !width = !!comConvertUnknownValue(!sctn.catref.para[1],'MM') + (2 * !!comConvertUnknownValue(!sctn.catref.para[2],'MM') )
    handle any
      !width = 0mm
    endhandle
  else
    !width = !!comConvertUnknownValue(!sctn.catref.para[2],'MM')
    handle any
      !width = 0mm
    endhandle
  endif
  --and add whatever clearance the user has specified
  !res[1] = (!width + 2 * !this.clearance)
  !res[2] = (!height + 2 * !this.clearance)
  !res[1] = !this.roundUpParameter(!res[1])
  !res[2] = !this.roundUpParameter(!res[2])
  return !res
endmethod


------------------------------------------------------------------------
--
-- Method:      isPlanarPanel()
--
-- Description: Returns true if the target panel is planar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if the target panel is planar
--
------------------------------------------------------------------------
define method .isPlanarPanel() is BOOLEAN

  if( !this.penetrated.hardType inset('CPLATE','CPANEL','CTWALL','SCTN','GENSEC','BPANEL') ) then
    return false
  elseif( !this.penetrated.hardType eq 'HPLATE' ) then
    return !this.penetrated.knuckl.not()
  endif
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      zDir()
--
-- Description: Returns Z direction of the target panel if planar
--               Otherwise the zDirection is derived from the penetrating item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Normal direction of penetration
--
------------------------------------------------------------------------
define method .zDir() is DIRECTION

  !planar = !this.isPlanarPanel()
  if(!planar) then
    !dir = !this.penetrated.ori.zDir()
  else
    if( !this.plane.set() ) then
      !dir = !this.plane.direction()
    else
      -- Unable to find the zdir of the penetrated item
      -- So take the direction of the penetrating item
      -- Note that this could detach the fixing from the penetrated surface
      !dir = !this.penetratingDir()
    endif
  endif

  return !dir

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      penetratingDir()
--
-- Description: Returns the zDirection is derived from the penetrating item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Normal direction of penetration
--
------------------------------------------------------------------------
define method .penetratingDir() is DIRECTION

  -- Get direction of the penetrating item
  !penetratingType = !this.penetrating.type
  if (!penetratingType eq 'BRAN') then
    !dir = !this.penetratingMarker.pDir[2]
  elseif (!penetratingType eq 'SCTN') then
    !dir = !this.penetrating.zDir
  elseif (!penetratingType eq 'GENSEC') then
    !dir = !this.penetratingMarker.ori.yDir()
  elseif (!penetratingType eq 'CWBRAN') then
    !dir = !this.penetratingMarker.posref.pDir[2]
    handle any
      !dir = !this.penetratingMarker.yDir()
    endhandle
  else
    -- should not get here
    !dir = object DIRECTION()
  endif

  return !dir

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      xDir()
--
-- Description: Returns X direction for the hole fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Calculated X direction
--
------------------------------------------------------------------------
define method .xDir() is DIRECTION

  !zDirection = !this.zDir()
  !defaultDirection   = !zDirection.orthogonal( S )
  handle (2,890)
    !defaultDirection = !zDirection.orthogonal( D )
  endhandle
  !mapToPlane         = false
  -- handle special alignment cases
  if( !this.penetratingType eq 'HVAC' ) then
    -- x direction of HVAC mapped onto the plane of the fixing
    !xDirection       = !this.penetratingMarker.pDir[6]
    handle any
      -- use default alignment
      !xDirection     = !defaultDirection
    elsehandle none
      !mapToPlane     = true
    endhandle
  elseif( !this.penetratingType eq 'CWBRAN') then
    -- tray open side is the key direction, so derive x direction from this
    !openSideDir      = !this.penetratingMarker.ori.zDir().wrt(world)
    handle (2,779)
      --only seems to happen for wall joiners... can't find orientation of fitting. Try sctn instead
      !openSideDir = !this.penetratingMarker.owner.ori.zDir().wrt(world)
    endhandle
    !xDirection       = !openSideDir.orthogonal(!zDirection)
    handle any
      -- use default alignment
      !xDirection     = !defaultDirection
    elsehandle none
      !mapToPlane     = true
    endhandle
  elseif  (!this.penetratingType inset('SCTN', 'GENSEC')) then
    -- derive x direction from penetrating marker
    !pmDir      = !this.penetratingMarker.ori.zDir().wrt(world)
    handle (2,779)
      --only seems to happen for wall joiners... can't find orientation of fitting. Try sctn instead
      !pmDir = !this.penetratingMarker.owner.ori.zDir().wrt(world)
      handle any
      -- use y as default
        !pmDir = !this.yDir()
      endhandle
    endhandle
    !xDirection       = !zDirection.orthogonal(!pmDir)
    handle any
      -- use default alignment
      !xDirection     = !defaultDirection
    elsehandle none
      !mapToPlane     = true
    endhandle

  elseif( !this.fixingType eq 'TRAY' ) then

 --   !widthDirection = !this.penetratingMarker.orientation.zDir().orthogonal(!this.penetratingMarker.pDir[!this.penetratingMarker.leave])
    -- x direction of HVAC mapped onto the plane of the fixing
    !xDirection       = !this.penetratingMarker.orientation.zDir().orthogonal(!zDirection)
    handle any
      -- use default alignment
      !xDirection     = !defaultDirection
    elsehandle none
      !mapToPlane     = true
    endhandle

  else
    -- no special alignment
    !xDirection       = !defaultDirection
  endif

  if( !mapToPlane ) then
    -- handles case where penetrating items is not orthogonal to penetrated
    !pv               = object POINTVECTOR(!this.penetratingMarker.position,!zDirection)
    !plane            = !pv.plane()
    !xDirection       = !xDirection.projected(!plane)
    handle any
      !xDirection     = !defaultDirection
    endhandle
  endif
  return !xDirection

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      roundUpParameter()
--
-- Description: Round up a design parameter to the next 1mm for metric
--              and 1 / 32 inch for imperial. Input value must match the
--              current units
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Original value
-- Return:
--   [Data Type] [Description]
--    REAL        rounded value
--
------------------------------------------------------------------------
define method .roundUpParameter(!value is REAL) is REAL

  -- Fix for imperial: note all despars stored in mm immaterial of the
  -- project units
  !format           = object FORMAT()
  !format.dimension = 'L'
  if (!this.metric) then
    -- use 0.999 to prevent whole numbers from being increased by 1
    !tempValue      = int(!!comValueConvert(!value,'MM') + 0.999)
    !unitObject     = object UNIT('mm')
    return !tempValue.cast(!unitObject)
  else
    -- round up by 1/32 inch
    !tempValue            = !!comValueConvert(!value,'INCH')
    !format.units         = 'INCH'
    !format.inchSeparator = '.'
    !format.denominator   = 32
    !format.fraction      = true
    !tempValue            = !tempValue.string(!format).real(!format)
    if( !tempValue lt !value ) then
      -- Add 1/32nd inch to round up
      !tempValue = !tempValue + 1/32in
    endif
    return !tempValue
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createCoaming
--
-- Description: apply coaming to a hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Coaming storage area (STRU)
-- Return:
--   [Data Type] [Description]
--    DBREF       New coaming fixing
--
------------------------------------------------------------------------
define method .createCoaming(!coamingStorage is DBREF) is DBREF

  -- Only apply coaming if the penetrated item is a hull plate
  if( not !this.penetratedObject.hardType inset('HPANEL','CPANEL','CTWALL','BPANEL')) then
    !this.coamingFixing = object DBREF()
    return !this.coamingFixing
  endif

  !!ce    = !coamingStorage
  NEW FRMW
  NEW FIXING

  -- copy the hole but delete its members
  !virtualHoleFixing = !this.virtualHoleRef
  COPY $!<virtualHoleFixing>
  DELETE FIXING MEMBERS
  PURP COAM
  CALL !!autonamece(false)
  handle any
  endhandle
  !this.coamingFixing = !!ce

  -- Set the HTHK parameter to 0 so that the virtual hole extrusion can not be seen
  !fixingProperties = !virtualHoleFixing.prls
  !index            = !fixingProperties.findFirst('HTHK')
  if( !index.set() ) then
      DDESP N $!index 0
  endif

  return !this.coamingFixing

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateCoaming
--
-- Description: update coaming
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateCoaming()

  -- Delete the coaming fixing if it has been modified to an item without coaming

  -- Don't do anything if the coaming has already been deleted.
  if (badref(!this.coamingFixing)) then
    return
  endif

  !coaming = !this.holeDefinition.hasCoaming()

  !saveRef = !!ce
  if (!coaming.not() and !this.coamingFixing.set()) then
    -- coaming not required, but there is some - delete it
    !!ce = !this.coamingFixing.owner
    DELETE FRMW
  elseif (!coaming) then
    -- coaming is required
    if(!this.virtualHoleRef.spre neq !this.coamingFixing.spre) then
      -- specification reference has changed
      !!ce = !this.coamingFixing.owner
      DELETE FRMW
    else
      -- specification reference unchanged, copy attributes
      !!ce = !this.coamingFixing
      COPY $!<this.virtualHoleRef>
      DELETE FIXING MEMBERS
      PURP COAM
      -- Set the HTHK parameter to 0 so that the virtual hole extrusion cannot be seen
      !thickIndex = !this.virtualHoleRef.prls.findFirst('HTHK')
      if( !thickIndex.set() ) then
        DDESP N$!<thickIndex> 0
      endif
    endif
  endif
  !!ce = !saveRef
  handle any
  endhandle

endmethod
-- End of method definition for .updateCoaming()

------------------------------------------------------------------------
--
-- Method:      drawAxes
--
-- Description: Draw aid lines showing axes for this penetration
--              The calling function must manage the aid lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number for this aid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawAxes(!aidNumber is REAL)

  !direction = !this.zDir()
  !xOffDir   = !this.xDir()
  !pv        = object POINTVECTOR(!this.position, !direction)
  !pv1       = !pv.offset(!this.thickness * 0.5)
  !strOrientation   = 'Z is ' + !direction.string() + ' and X is ' + !xOffDir.string()
  !axesOrientation  = object ORIENTATION(!strOrientation)
  !axes             = object GPHAXES(!pv1.position, !axesOrientation)
  -- We want XYZ labels in Plant and Marine
  !xyz              = !!coords.isxyz()
  handle any
    !xyz            = true
  endhandle
  !axes.xyz         = !xyz.not()
  !axes.tag         = false
  !axes.detail      = false
  !axes.visibleZ    = false
  !axes.draw(!aidNumber,false)

endmethod
-- End of method definition
----------------------------------------------------------------------
--
-- Method:      isCableTray
--
-- Description: Return true for cable tray, false for pipe
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True for cable tray, false for pipe
--
------------------------------------------------------------------------
define method .isCableTray() is BOOLEAN

  if (!this.penetrating.type eq 'BRAN') then
    !penetratingBranch = !this.penetrating
  else
    !penetratingBranch = !this.penetrating.owner
  endif

  -- Create Pipe penetrating marker
  !block  = object BLOCK('STEXT OF TEXT 1 OF PSPEC OF ' + !penetratingBranch.string())
  !return = !block.evaluate().upcase().eq('TRAY')
  handle ANY
    return false
  endhandle

  return !return

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getTraySize
--
-- Description: Return size of tray adjacent to cable tray mark atta
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY     [1] width,   [2] Height
--
------------------------------------------------------------------------
define method .getTraySize(!trayMarker is DBREF) is ARRAY

  !return        = ARRAY()
  !tempPointList = !trayMarker.ppls
  handle any
    !tempPointList = object ARRAY()
  endhandle
  -- search p-points for AHRP (AVEVA Hole Management Rectangular Ppoint) purpose
  -- which must be positioned at the centre of the sub-fixing rectangle
  -- pointing along the tray (-Y)
  -- and have PPWID and PPHEI properties set to required width and height
  !hmTrayPoint = -1
  do !pPoint values !tempPointList
    !purpose = !trayMarker.pPurp[!pPoint]
    handle any
      -- This could happen where design points are reported as ppoints by PPLS
      skip
    endhandle
    if( !purpose eq |AHRP| ) then
      -- we have a P-point  matching the purpose
      !hmTrayPoint = !pPoint
      break
    endif
  enddo
  if( !hmTrayPoint eq -1 ) then
    -- catalogue not configured correctly - no AHMP p-point
    !return = ARRAY()
  else
    -- PPWID and PPHEI are bores. Convert to distance avoiding nearest bore conversion
    !return[1] = !trayMarker.ppwid[!hmTrayPoint].string().real() + 2 * !this.clearance
    !return[2] = !trayMarker.pphei[!hmTrayPoint].string().real() + 2 * !this.clearance
  endif

  return !return

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getTrayPosition
--
-- Description: Return position of tray penetration from AHRP p-point of tray mark atta
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   POSITION     Derived from AHRP P-point - or atta origin
--
------------------------------------------------------------------------
define method .getTrayPosition(!trayMarker is DBREF) is POSITION

  -- search p-points for AHRP (AVEVA Hole Management Rectangular Ppoint) purpose
  -- which must be positioned at the centre of the sub-fixing rectangle
  -- pointing along the tray (-Y)
  -- and have PPWID and PPHEI properties set to required width and height
  !tempPointList = !trayMarker.ppls
  handle any
    !tempPointList = object ARRAY()
  endhandle
  !hmTrayPoint = -1
  do !pPoint values !tempPointList
    !purpose = !trayMarker.pPurp[!pPoint]
    handle any
      -- This could happen where design points are reported as ppoints by PPLS
      skip
    endhandle
    if( !purpose eq |AHRP| ) then
      -- we have a P-point  matching the purpose
      !hmTrayPoint = !pPoint
      break
    endif
  enddo
  if( !hmTrayPoint eq -1 ) then
    -- catalogue not configured correctly - no AHMP p-point
    !return = !trayMarker.position
  else
    !return = !trayMarker.pPos[!hmTrayPoint]
  endif
  return !return.wrt(world)

endmethod
-- End of function definition
