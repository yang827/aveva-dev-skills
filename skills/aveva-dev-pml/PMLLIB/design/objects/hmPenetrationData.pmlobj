-- End of method

------------------------------------------------------------------------
--
-- Method:      getOffsetPenetratingMarker
--
-- Description: Get the DBREF of the offset penetrating marker element
--              for cable way (offset RNODE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Penetrating marker element
--
------------------------------------------------------------------------
define method .getOffsetPenetratingMarker() is DBREF

  return !this.offsetPenetratingMarker

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPenetratingFixingType
--
-- Description: Get type of penetration required for penetrating item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       of penetration fixing GPART
-- Return:
--   [Data Type] [Description]
--    STRING      Penetrating fixing type
--
------------------------------------------------------------------------
define method .getPenetratingFixingType() is STRING

  if( !this.fixingType.empty().not() ) then
    return !this.fixingType
  endif

  !penetratingType = !this.penetratingType

  if (!penetratingType eq 'PIPE') then
    if( !this.isCableTray() ) then
      !holeType     = 'TRAY'
    else
      !holeType     = 'PIPE'
    endif
  elseif (!penetratingType eq 'HVAC') then
    -- get basic type before suffix
    !fixingType   = !this.virtualPenetration.spref.sectyp
    handle any
      !holeType   = 'RECT'
    elsehandle none
      if (!fixingType eq 'TYPE D') then
        !holeType = 'CIRC'
      elseif (!fixingType eq 'TYPE HR') then
        !holeType = 'RECT'
      elseif (!fixingType eq 'TYPE HO') then
        !holeType = 'OVAL'
      else
        !holeType = 'RECT'
      endif
    endhandle
  elseif (!penetratingType inset('SCTN','GENSEC')) then
    !holeType     = 'SCTN'
  elseif (!penetratingType eq 'CWBRAN') then
    !holeType     = 'CWAY'
  else
    !holeType     = ''
  endif

  return !holeType

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getItemList
--
-- Description: Get list of elements in this penetration in an array
--              suitable for HMCONTROL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of item DBREFs in HMCONTROL format
--
------------------------------------------------------------------------
define method .getItemList()is ARRAY

  !itemList      = ARRAY()
  -- penetrated item must be first. Must be lower level element otherwise
  -- ASSTAR will not be set in ASSMBR
  !itemList[1]   = !this.penetrated
  -- penetrating item is second
  !itemList[2]   = !this.penetrating
  !itemList[3]   = !this.penetratingMarker
  !itemList[4]   = !this.virtualHoleRef
  !itemList[5]   = !this.virtualPenetration
  if( !this.offsetPenetratingMarker.set() ) then
    !itemList.append(!this.offsetPenetratingMarker)
  endif
  if( not badref(!this.coamingFixing) ) then
    !itemList.append(!this.coamingFixing)
  endif

  return !itemList

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setVirtualHole
--
-- Description: Set reference to virtual hole fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Virtual hole fixing
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setVirtualHole(!virtualHole is DBREF)

  !this.virtualHoleRef     = !virtualHole
  !this.position           = !virtualHole.position
  !this.virtualStorageArea = !virtualHole.owner.owner
  !this.holeDefinition     = object HMHOLETYPE()
  if( !this.virtualHoleRef.spref.unset() ) then
    if( !this.virtualHoleRef.mcount('TMPL') eq 1 ) then
      -- this is a free hole
      !this.holeDefinition.freeHoleType()
    endif
  else
    if( not badref(!this.virtualHoleRef.spref) ) then
      !this.holeDefinition.loadFromCatalogue(!this.virtualHoleRef.spref)
    endif
  endif
  !pPointNumber            = !this.holeDefinition.getOrientationPointNumber()
  !this.originalFixingDir  = !this.virtualHoleRef.pDir[!pPointNumber].wrt(world)
  handle any
    !this.originalFixingDir = !this.xDir()
  endhandle
endmethod
-- End of method

