-- End of method

------------------------------------------------------------------------
--
-- Method:      setPenetratedThickness
--
-- Description: Determine penetrated thickness from penetrated object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPenetratedThickness()

  !penetratedType = !this.penetrated.type
  if( !penetratedType eq 'CPLATE' ) then
    !this.thickness = !this.penetrated.thickn
  elseif (!penetratedType inset('CTWALL','BPANEL')) then
    !this.thickness = !this.penetrated.wThickness
  elseif (!penetratedType inset('SCTN','GENSEC','STWALL','WALL')) then
    -- for sctn and gensec we find the penetrating thickness from a vector intersect
    !marker = !this.penetratingMarker
    if (!this.penetratingMarker.type inset('ATTA','COUP')) then
      !pos  = !marker.position
    elseif (!this.penetratingMarker.type.eq('FITT')) then
      !!ce = !marker
      !pos = !!ce.position.wrt(world)
    else
      !pos = !marker.position
    endif

    -- create a point vector and perform an intersection operation
    !dir  = !this.penetratingDir()
    !pv   = object POINTVECTOR(!pos,!dir)
    !hits = !pv.intersections(!this.penetrated, true)

    if (!hits.unset()) then
      !this.thickness = 0
      return
    endif

    -- Pick the first and last hits on the penetrated object
    !hit1 = !hits[1]
    !hit2 = !hits[!hits.size()]
    !parallelFaces         = !hit1.direction.angle(!hit2.direction.opposite()).lt(0.1)
    !temp                  = 1 - !hit1.direction.dot(!dir).abs()
    !orthogonalPenetration = !temp.lt(0.01)
    if( !parallelFaces.and(!orthogonalPenetration) ) then
      -- penetration orthogonal to surface
      !this.thickness = !hit1.position.distance(!hit2.plane())
      !this.position  = !hit1.position.midpoint(!hit2.position)
      !this.plane     = !hit1.plane()
      !this.plane.position = !this.position
    else
      !this.thickness = !hit1.position.distance(!hit2.position)
      !this.position  = !hit1.position.midpoint(!hit2.position)
      !this.plane     = object PLANE()
    endif
  else
    !this.thickness = !this.penetrated.lohe
  endif

endmethod
-- End of method

