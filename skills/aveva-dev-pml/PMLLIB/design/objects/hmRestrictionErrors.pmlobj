-- File:          hmRestrictionErrors.pmlobj
-- Type:          Object Definition
-- Group:         Hole Management Application
--
-- Keyword:       UTILITIES
-- Module:        design
-- Replaces:
--
-- Author:        Thomas Morey
-- Created:
--
-- Description:
--    Storage area for restriction test results
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  fileErrors(BOOLEAN,BOOLEAN)      -                   Switch on/off saving errors to log file
--  getErr(DBREF)                    STRING              Return the stored error for restriction specified in DBREF
--  getErr(REAL)                     STRING              get the Error recorded at index .
--  getRestrictionIndex(DBREF)       REAL                Returns the index in testedRestrictions of specified restriction component
--  getTimeDate()                    STRING              Return current time and date
--  hmRestrictionErrors()            -                   Constructor
--  initialise()                     -                   Clear all data
--  initialise(DBREF,DBREF,BOOLEAN)  -                   initialisation routine
--  logErr()                         -                   Write the latest error to the log file
--  setErr(STRING)                   -                   Set the error string for the current restriction
--
------------------------------------------------------------------------

define object HMRESTRICTIONERRORS

  --dbref of association this object is in relation to
  member .assoc is DBREF

  --expected number of restrictions
  member .maxNumRestrictions is REAL
  --list of whether or not expected restrictions have been called
  member .testedRestrictions is ARRAY
  --list of error codes returned from restrictions
--  member .errors is ARRAY
  --index into arrays of current restriction
  member .errIndex is REAL

  --whether to log errors to an output file
  member .logErrors is BOOLEAN
  --whether to open in append of overwrite mode
  member .logAppend is BOOLEAN
  --file to store error strings
  member .errorFile is FILE

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmRestrictionErrors
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmRestrictionErrors()
  !this.errorFile = object FILE('%PDMSUSER%/HMValidationDump.log')
  !this.logErrors = FALSE
  !this.logAppend = TRUE
--  !this.initCacheStrings()
  !this.initialise()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialisation routine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
    --clear all data
    !this.assoc	= object DBREF()
    !this.testedRestrictions = object ARRAY()
    !this.maxNumRestrictions = 0
    !this.errIndex = 0

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialisation routine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of association
--    2   R      DBREF       DBREF of restriction
--    3   R      BOOLEAN     if TRUE and restriction has already been listed then re-initialise from scratch
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!assoc is DBREF, !component is DBREF, !reset is BOOLEAN)
  -- test whether association passed is same as previous
  if (!assoc ne !this.assoc) then
    --clear existing data
    !this.initialise()
  endif
  --check whether restriction has already been tested
  --If so then probably want to reset as the underlying data
  --may well have changed
  if (!this.getRestrictionIndex(!component) gt 0) then
    if (!reset eq TRUE) then
      !this.initialise()
    endif
  endif
  	--if the restriction has not already been initialised then do the full initialisation
  !this.assoc = !assoc
  !restInfo = object HMRESTRICTIONINFO(!assoc, !component)
  !this.testedRestrictions.append(!restInfo)
  !this.errIndex = !this.testedRestrictions.size()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRestrictionIndex
--
-- Description: return the index of a restriction that has already been processed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--      1         DBREF      DBREF of a restriction component
-- Return:
--   [Data Type] [Description]
--   REAL         index of specified restriction
------------------------------------------------------------------------
define method .getRestrictionIndex(!component is DBREF) is REAL
--  !numTested = !this.testedRestrictions.size()

--  if (!numTested gt 0) then
    !ind = 0
    do !rest values !this.testedRestrictions
      !ind = !ind + 1
      if (!rest.restri eq !component) then
        return !ind
      endif
    enddo
--  endif
  return 0


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setErr
--
-- Description: set the Error for the current restriction.
-- Recommend using the setRestrictionError function if calling this method
-- via the global !!restrictionErrors object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R        STRING    Error description
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .setErr(!errStr is STRING)
  if (!this.errIndex eq 0) then
    return
  endif
  !this.testedRestrictions[!this.errIndex].error = !errStr
  if (!this.logErrors eq TRUE) then
    !this.logErr()
  endif
--  !this.errIndex = !this.errIndex+1

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getErr
--
-- Description: get the Error for the passed restriction.
-- Recommend using the getRestrictionError function if calling this method
-- via the global !!restrictionErrors object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R        STRING    Error description
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getErr(!restri is DBREF) is STRING
  !ind = !this.getRestrictionIndex(!restri)
  !retstr = !this.getErr(!ind)
  return !retstr
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getErr
--
-- Description: get the Error recorded at index .
-- Recommend using the getRestrictionError function if calling this method
-- via the global !!restrictionErrors object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R        STRING    Error description
-- Return:
--   [Data Type] [Description]
--   STRING        Stored error for specified restriction
------------------------------------------------------------------------
define method .getErr(!index is REAL) is STRING
  !retstr = object STRING()
  !retstr = ''
  if (!index le 0) then
    return !retstr
  endif
  if (!index le !this.testedRestrictions.size()) then
    !retstr = !this.testedRestrictions[!index].error
  endif
  return !retstr

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fileErrors
--
-- Description: Start/stop recording errors to log file.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R        BOOLEAN   Switch on/off error recording
--    2   R        BOOLEAN   if switching on, should we just append to the file if it already exists.
--                           the append mode setting only has an effect when the file is being opened
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .fileErrors(!onOff is BOOLEAN, !append is BOOLEAN)
  if (!onOff eq FALSE) then
    --close the log file
    if (!this.errorFile.isOpen() eq TRUE) then
    	!stamp = 'Log stopped at ' + !this.getTimeDate()
    	!this.errorFile.writeRecord(!stamp)
      !this.errorFile.close()	
    endif
  endif
  !this.logErrors = !onOff
  !this.logAppend = !append

endmethod

------------------------------------------------------------------------
--
-- Method:      getTimeDate
--
-- Description: return a time and date string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Time and date
------------------------------------------------------------------------
define method .getTimeDate() is STRING
  !dt = object DATETIME()
  !dft = object DATEFORMAT('T:')
  !dfy = object DATEFORMAT('D/M/Y')
  !ds = !dt.second().string()

  !str = !dft.string(!dt) + !ds + '   ' + !dfy.string(!dt)
  return !str
endmethod


------------------------------------------------------------------------
--
-- Method:      logErr
--
-- Description: log the latest error to be recorded
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .logErr()
  if (!this.errorFile.isOpen().not()) then
    --open the file if necessary
    !mode = 'OVERWRITE'
    if (!this.logAppend eq TRUE) then
    	!mode = 'APPEND'
    endif
    !this.errorFile.open(!mode)
    handle any
      !this.errorFile.open('OVERWRITE')
      handle any
        write 'unable to open logfile'
        !this.logErrors = FALSE
        return
      endhandle
    endhandle
   	!stamp = 'Log started at ' + !this.getTimeDate()
    handle any
      !this.logErrors = FALSE
      return
    endhandle
    !this.errorFile.writeRecord(!stamp)
    handle any
      !this.logErrors = FALSE
      return
    endhandle
  endif
  !opstring = !this.assoc.name + '  ' + !this.testedRestrictions[!this.errIndex].resdef.pmlname + '  ' + $
              !this.testedRestrictions[!this.errIndex].error
  handle any
    !this.logErrors = FALSE
    return
  endhandle

  !this.errorFile.writeRecord(!opstring)
  handle any
    !this.logErrors = FALSE
    return
  endhandle

endmethod
