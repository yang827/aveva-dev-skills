-- Replaces:
--
-- Author:        Thomas Morey
-- Created:
--
-- Description:
--    Cached data for restriction tests
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hmRestrictionInfo(DBREF,DBREF)   -                   Constructor
--  initialise(DBREF)                -                   initialisation routine
--


------------------------------------------------------------------------

define object HMRESTRICTIONINFO
  -- association
  member .assoc is DBREF
  --restriction object
  member .restri is DBREF
  --RESDEF object defining restriction
  member .resdef is DBREF
  --error generated by testEV
  member .error is STRING
  --does this hmrestrictioninfo object contain valid data
  member .isValid is BOOLEAN
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmRestrictionInfo
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmRestrictionInfo(!assoc is DBREF, !restri is DBREF)
  !this.assoc = !assoc
  !this.initialise(!restri)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialisation routine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!restri is DBREF)
  !this.isValid = FALSE
  if ((badref(!this.assoc)) or (badref(!restri)))then
    return
   endif
  !this.restri = !restri
  --find restriction definition
  !lname = !restri.lname

  !find = object COLLECTION()
  !find.type('RESDEF')
  !find.scope(!this.assoc.adefrf)
  handle any
    return
  endhandle
  !expr = object EXPRESSION('lname eq |$!lname|')
  handle any
    return
  endhandle
  !find.filter(!expr)
  handle any
    return
  endhandle
  !resdefs = !find.results()
  handle any
    return
  endhandle
  if (!resdefs.size() ge 1) then
  	!this.resdef = !resdefs[1]
  	!this.isValid = TRUE
  endif
  return

endmethod
-- End of method
