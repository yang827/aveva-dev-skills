--
-- File:            hmconfig.pmlobj
--   Type:          Object Definition
--   Group:
--     Keyword:     Hole Management
--   Module:        All
-- Author:          Ricky Thompson
--  Created:        <date/time>
--
--
-- Description:
--   Object which handles configuration settings for the Hole Management system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hmConfig()                       -                   Constructor
--  loadConfigurationFile()          BOOLEAN             Load configuration file "%PDMSDFLTS%\des-holemgt-config"
--  setDefaultGlobalConfiguration()  -                   Set global hole management configuration object
--
------------------------------------------------------------------------

define object HMCONFIG

  member .assDef             is DBREF
  member .equiPenAssDef      is DBREF
  member .genAssDef          is DBREF
  member .fittAssDef         is DBREF
  member .cWayAssDef         is DBREF
  member .interface          is BOOLEAN
  member .columns            is ARRAY
  member .clearExisting      is BOOLEAN
  member .navigateOnSelect   is BOOLEAN
  member .viewOnSelect       is BOOLEAN
  member .autoRequest        is BOOLEAN
  member .markerTypes        is ARRAY

  member .debug     is BOOLEAN
endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      hmConfig
--
-- Description: Constructor for default settings
--              File "%PDMSDFLTS%\des-holemgt-config" will override these (if found)

--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmConfig()

-- Control output of additional messages to command window for debugging
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

-- Define the standard AssDef element name and reference
  !this.assDef        = object DBREF()
  !this.equiPenAssDef = object DBREF()
  !this.genAssDef     = object DBREF()
  !this.fittAssDef    = object DBREF()
  !this.cWayAssDef    = object DBREF()

-- Allow External API to create new entries in HM system (e.g. Will PENETRATIONS appware create Managed Holes)
  !this.interface = TRUE

-- Additional columns to be displayed for each HOLE on the main HM form (e.g. UDAs on ASSOC element)
  !this.columns = object ARRAY()

-- Default settings for Main form view control flags
  !this.clearExisting = TRUE
  !this.navigateOnSelect = TRUE
  !this.viewOnSelect = TRUE
-- Default settings for auto request
  !this.autoRequest = FALSE
-- Penetration marker type
  !this.markerTypes = object ARRAY()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadConfigurationFile
--
-- Description: Load configuration file "%PDMSDFLTS%\des-holemgt-config"
--              into the global hole management configuration object
--              !!holeManagementConfiguration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if loaded OK, false otherwise
--
------------------------------------------------------------------------

define method .loadConfigurationFile() is BOOLEAN

  !cfgFile = !!hmUniquePath('des-holemgt-config','')
  if ( !cfgFile.set() ) then
    -- run the hole management configuration macro which loads settings
    -- into global variable !!holeManagementConfiguration
    !!runmacro(!cfgFile.name(),'')
    handle ANY
      !this.setDefaultGlobalConfiguration()
      return false
    endhandle
  else
    !this.setDefaultGlobalConfiguration()
    return false
  endif
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDefaultGlobalConfiguration
--
-- Description: Set global hole management configuration object
--              !!holeManagementConfiguration to default settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if loaded OK, false otherwise
--
------------------------------------------------------------------------

define method .setDefaultGlobalConfiguration()

-- Define the standard AssDef element name and reference
  !this.assDef = object DBREF(|/HM-CHECK|)
  handle any
    -- handling an error here allows the entry into Design/Outfitting
    -- without penetrations
    !this.assDef = object DBREF()
  endhandle
  !this.equiPenAssDef = object DBREF(|/HM-CHECK-EQUI-PEN|)
  handle any
    -- handling an error here allows the application to run OK but
    -- without equipment penetrations
    !this.equiPenAssDef = object DBREF()
  endhandle
  !this.genAssDef = object DBREF(|/HM-CHECK-GEN|)
  handle any
    -- handling an error here allows the application to run OK but
    -- without general penetrations
    !this.genAssDef = object DBREF()
  endhandle
  !this.fittAssDef = object DBREF(|/HM-CHECK-FITT|)
  handle any
    -- handling an error here allows the application to run OK but
    -- without fitting penetrations
    !this.fittAssDef = object DBREF()
  endhandle
  !this.cWayAssDef = object DBREF(|/HM-CHECK-CWAY|)
  handle any
    -- handling an error here allows the application to run OK but
    -- without cable way penetrations
    !this.cWayAssDef = object DBREF()
  endhandle

-- Allow External API to create new entries in HM system (e.g. Will PENETRATIONS appware create Managed Holes)
  !this.interface = TRUE

-- Additional columns to be displayed for each HOLE on the main HM form (e.g. UDAs on ASSOC element)
  !this.columns = object ARRAY()

-- Default settings for Main form view control flags
  !this.clearExisting    = TRUE
  !this.navigateOnSelect = TRUE
  !this.viewOnSelect     = TRUE
  !this.autoRequest      = FALSE

-- Penetration Marker Type
  !this.markerTypes.append('ATTA')
  !this.markerTypes.append('COUP')

  !!holeManagementConfiguration = !this

endmethod
