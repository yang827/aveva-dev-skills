--
-- Description:
--    This global object controls information flow from penetration
--    creation forms to the !!hmDefinition form. A global object
--    !!hmCreateController must be created when a penetration is
--    first created.
--    This object is required to avoid a bug when !!hmDefinition was
--    shown directly from a penetration create form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hmCreateController()             -                   Constructor
--  processBranchPenetrations()      -                   Process stored penetrations
--  processCableWayPenetrations(BOOLEAN) -                   Process stored penetrations
--  processSteelProfilePenetrations() -                   Process stored penetrations
--  setPenetrations(ARRAY)           -                   Set the array of penetrations to be processed
--
------------------------------------------------------------------------

define object HMCREATECONTROLLER

  -- array of penetration objects to be processed by !!hmDefinition
  member .penetrations    is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmCreateController
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmCreateController()

  -- Initialise Variables
  !this.penetrations = ARRAY()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPenetrations
--
-- Description: Set the array of penetrations to be processed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY of penetration objects
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPenetrations(!penetrations is ARRAY)

  -- store new penetrations ready for processing
  !this.penetrations = !penetrations

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      processBranchPenetrations
--
-- Description: Process stored penetrations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processBranchPenetrations()

  -- populate the hm form for multi-penetrations
  if( not defined(!!hmDefinition) ) then
    loadform !!hmDefinition
  endif
  !!hmDefinition.setPenetrationData(!this.penetrations)
  !!hmDefinition.processPenetrationData()
  show !!hmDefinition

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      processSteelProfilePenetrations
--
-- Description: Process stored penetrations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processSteelProfilePenetrations()

  -- currently identical to pipe penetrations
  !this.processBranchPenetrations()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      processCableWayPenetrations
--
-- Description: Process stored penetrations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true if penetrations are merged
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .processCableWayPenetrations(!merged is BOOLEAN)

  -- populate the hm form for multi-penetrations
  if( not defined(!!hmCWayDefinition) ) then
    loadform !!hmCWayDefinition
  endif
  !!hmCWayDefinition.merged = !merged
  !!hmCWayDefinition.setPenetrationData(!this.penetrations)
  !!hmCWayDefinition.processPenetrationData()
  show !!hmCWayDefinition

endmethod
-- End of method
