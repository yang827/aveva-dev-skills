------------------------------------------------------------------------
--
-- Method:      zDir
--
-- Description: Return the normal to the virtual hole
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .zDir() is DIRECTION

  if (!this.debug) then
    write 'Running hmHole.zDir()'
  endif

-- If already set then just return current value
  if ( !this.zDirection.set() ) then
    return !this.zDirection
  endif

  !this.zDirection = object DIRECTION()

  !virtualHole = !this.getVirtualHole()
  if( badref(!virtualHole) ) then
    return !this.zDirection
  endif

  if( !this.getType().upcase() eq 'FREE' ) then
    !this.zDirection = !virtualHole.ori.zDir()
  else
    !this.zDirection = !virtualHole.pDir[1]
    handle any
      !this.zDirection = object DIRECTION()
    endhandle
  endif

  return !this.zDirection
endmethod
-- End of method definition for .zDir()

------------------------------------------------------------------------
--
-- Method:      getPrimaryHole
--
-- Description: Return the target reference (AMEMRF of LNAM eq /PrimaryHole)
--              of approved hole
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPrimaryHole() is DBREF

  if (!this.debug) then
    write 'Running hmHole.getPrimaryHole()'
  endif

  !dbrReturn = object DBREF()

  -- Locate the ASSMBR element marked as /HoleOwner
  !hole = !this.findMemberElement(|ASSMBR|, object EXPRESSION(|LNAME eq '/PrimaryHole'|) )

  -- If no problems, grab the AMEMRF of this element
  if (!hole.size().eq(1) ) then
    !dbrReturn = !hole[1].amemrf
  endif

  return !dbrReturn

endmethod
-- End of method definition for .getPrimaryHole()

------------------------------------------------------------------------
--
-- Method:      getPrimaryHoleProfile
--
-- Description: Return PROFILE object of approved hole
--              (AMEMRF of LNAM eq /PrimaryHole)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPrimaryHoleProfile() is PROFILE

  if (!this.debug) then
    write 'Running hmHole.getPrimaryHoleProfile()'
  endif

  !holeProfile = object PROFILE()

  -- Locate the ASSMBR element marked as /HoleOwner
  !hole = !this.getPrimaryHole()

  -- If hole not found return unset PROFILE
  if (!hole.unset() ) then
    return !holeProfile
  endif

  return !this.getHoleProfile(!hole)

endmethod
-- End of method definition for .getPrimaryHole()

------------------------------------------------------------------------
--
-- Method:      getHoleProfile
--
-- Description: Return PROFILE object of given association member reference.
--              Unset object returned if no hole found
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getHoleProfile(!associationReference is DBREF) is PROFILE

  if (!this.debug) then
    write 'Running hmHole.getHoleProfile()'
  endif

  !hole     = !associationReference
  !holeType = !hole.type
  if (!holeType eq 'NXTR') then
    !holeProfile = object PROFILE(!hole.member[1])
  elseif(!holeType eq 'PFIT') then
    !holeProfile = object PROFILE(!!hmFindHoleProfile(!hole))
  elseif(!holeType eq 'CMFI') then
    if (!hole.member[1].type.eq('SBFI')) then
      !holeProfile = object PROFILE(!!hmFindHoleProfile(!hole.members[1]))
    elseif (!hole.member[1].type.eq('TMPL')) then
      !holeProfile = object PROFILE(!hole.member[1].member[1].member[1])
    endif
  elseif (!holeType eq ('JLDATU')) then
    !plDatu  = !hole.member[1]
    !fixings = !plDatu.members
    if (!fixings[!fixings.size()].spref.set()) then
      !holeProfile = object PROFILE(!!hmFindHoleProfile(!fixings[!fixings.size()]))
    else
      !holeProfile = object PROFILE(!fixings[1].member[1].member[1].member[1])
    endif
  elseif(!holeType eq 'WLOPEN') then
    !path = object COMPATH(!hole)
    !holeProfile = !path.profile()
  elseif (!holeType eq 'HHOLE') then
    !holeProfile = object PROFILE(!hole)
    handle ANY
      !holeProfile = object PROFILE()
    endhandle
  elseif(!holeType eq 'LOOP') then
    -- This is a special case. Ceiling inner loops only exist with a hole in a ceiling panel
    -- The loop must be checked but it is not the main hole definition so its profile
    -- is added to the secondary holes array
    -- check only ceiling inner loops
    if( !hole.owner.hardType eq 'BNDLIN' and !hole.owner.owner.hardType inset('CEILIN','CLNPNG') ) then
      !holeProfile = object PROFILE(!hole)
    endif
  elseif (!holeType eq 'CHOLE') then
    -- cannot get the boundary shape of a CHOLE
    !holeProfile = object PROFILE()
  else
    -- hole not associated with other element types
    !holeProfile = object PROFILE()
  endif

  return !holeProfile

endmethod
-- End of method definition for .getPrimaryHole()

----------------------------------------------------------------------
--
-- Method:      getTrayPosition
--
-- Description: Return position of tray penetration from AHRP p-point of tray mark atta
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   POSITION     Derived from AHRP P-point - or atta origin
--
------------------------------------------------------------------------
define method .getTrayPosition(!trayMarker is DBREF) is POSITION

  -- search p-points for AHRP (AVEVA Hole Management Rectangular Ppoint) purpose
  -- which must be positioned at the centre of the sub-fixing rectangle
  -- pointing along the tray (-Y)
  -- and have PPWID and PPHEI properties set to required width and height
  !tempPointList = !trayMarker.ppls
  handle any
    !tempPointList = object ARRAY()
  endhandle
  !hmTrayPoint = -1
  do !pPoint values !tempPointList
    !purpose = !trayMarker.pPurp[!pPoint]
    handle any
      -- This could happen where design points are reported as ppoints by PPLS
      skip
    endhandle
    if( !purpose eq |AHRP| ) then
      -- we have a P-point  matching the purpose
      !hmTrayPoint = !pPoint
      break
    endif
  enddo
  if( !hmTrayPoint eq -1 ) then
    -- catalogue not configured correctly - no AHMP p-point
    !return = !trayMarker.position
  else
    !return = !trayMarker.pPos[!hmTrayPoint]
  endif
  return !return.wrt(world)

endmethod
-- End of function definition
