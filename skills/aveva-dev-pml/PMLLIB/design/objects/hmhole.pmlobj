--
------------------------------------------------------------------------
define method .setStatusComment(!value is STRING)

  if (!this.debug) then
    write 'Running hmHole.setStatusComment()'
  endif

  !this.statusComment = !value

endmethod
-- End of method definition for .setStatusComment()


------------------------------------------------------------------------
--
-- Method:      setComment
--
-- Description: Set the COMMENT member variable to the supplied string
--              Store the value on the DESCRIPTION attribute of the ASSOC element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setComment(!value is STRING)

  if (!this.debug) then
    write 'Running hmHole.setComment()'
  endif

  !statusItem = !this.findMemberElement(|ASTATU|, object EXPRESSION(|LNAME EQ '/Status'|) )

  if (!statusItem.size().eq(1) ) then
    !this.comment = !value
    !statusItem[1].description = !value
  endif

endmethod
-- End of method definition for .setComment()
------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set the Position member variable to the supplied string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPosition(!value is STRING)


  !originItem = !this.findMemberElement(|DDAT|, object EXPRESSION(|LNAME of ASREQU EQ '/DesignData' and DKEY eq 'ORIG'|) )

  if (!originItem.size().eq(1) ) then
    !value = '|' & !value & '|'
    !originItem[1].ddpro = !value
  endif

endmethod
-- End of method definition for .setPosition()
