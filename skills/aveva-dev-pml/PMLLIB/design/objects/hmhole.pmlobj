------------------------------------------------------------------------
--
-- Method:      getComment
--
-- Description: Retrieve comment from DESC attribute on ASTATU with LNAME /Status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getComment() is STRING

  if (!this.debug) then
    write 'Running hmHole.getComment()'
  endif

-- If already set then just return current value
  if (!this.comment.set() ) then
    return !this.comment
  endif

  !strReturn = STRING()

  !statusItem = !this.findMemberElement(|ASTATU|, object EXPRESSION(|LNAME EQ '/Status'|) )

  if (!statusItem.size().eq(1) ) then
    !strReturn = !statusItem[1].description
  endif

  return !strReturn

endmethod
-- End of method definition for .getComment()


------------------------------------------------------------------------
--
-- Method:      GetStatusComment
--
-- Description: Return latest comment from Status history for this hole
--              i.e. the most recent system-generated NOTE in status history
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getStatusComment() is STRING

  if (!this.debug) then
    write 'Running hmHole.getStatusComment()'
  endif

-- If already set then just return current value
  if (!this.statusComment.set() ) then
    return !this.statusComment
  endif

  !strReturn = STRING()

  if (!this.statusComment.set() ) then
    !strReturn = !this.statusComment
  else
    if ( !this.statusHistory.unset() ) then
      !this.statusHistory = !this.getStatusHistory()
    endif
    if (!this.statusHistory.size().gt(0) ) then
      !strReturn = !this.statusHistory.last().split('|')[4]
    endif
  endif
  return !strReturn

endmethod
-- End of method definition for .getStatusComment()


------------------------------------------------------------------------
--
-- Method:      GetPrimaryElement
--
-- Description: Return the Primary Element below ASSOC (PRIMEM=TRUE)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPrimaryElement() is DBREF

  if (!this.debug) then
    write 'Running hmHole.getPrimaryElement()'
  endif

-- If already set then just return current value
  if (!this.primaryElement.set() ) then
    return !this.primaryElement
  endif

  !dbrReturn = object DBREF()

  !primaryItem = !this.findMemberElement(|ASSMBR|, object EXPRESSION(|PRIMEM eq TRUE|) )

  if (!primaryItem.size().eq(1) ) then
    !dbrReturn = !primaryItem[1]
  endif

  return !dbrReturn
endmethod
-- End of method definition for .getPrimaryElements()


------------------------------------------------------------------------
--
-- Method:      GetSecondaryElements
--
-- Description: Return the secondary elements below ASSOC (i.e. not PRIMEM!)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getSecondaryElements() is ARRAY

  if (!this.debug) then
    write 'Running hmHole.getSecondaryElements()'
  endif

-- If already set then just return current value
  if (!this.secondaryElements.set() ) then
    return !this.secondaryElements
  endif

  !arrReturn = ARRAY()
  !arrReturn = !this.findMemberElement(|ASSMBR|, object EXPRESSION(|PRIMEM eq FALSE|) )

  return !arrReturn
endmethod
-- End of method definition for .getSecondaryElements()

------------------------------------------------------------------------
--
-- Method:      GetVirtualHole
--
-- Description: Return the Owning Fixing DBREF
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getVirtualHole() is DBREF

  -- For General holes the fixing will be stored in the primary element
  if (!this.holeType eq 'GEN') then
    if (not badref(!this.primaryElement.amemrf)) then
      if (!this.primaryElement.amemrf.type eq 'FIXING') then
        return !this.primaryElement.amemrf
      endif
    endif
  endif

  do !i values !this.secondaryElements
    if (badref(!i.amemrf)) then
      skip
    endif
    if(!i.amemrf.type eq 'FIXING' and !i.amemrf.owner.type neq 'FIXING') then
      return !i.amemrf
    endif
  enddo

  -- if we get here then we have not found the owning fixing which is a problem
  -- this will produce an error in the getVirtualHole call because we are not returning a dbref
  -- this needs to be handled at the call
endmethod
-- End of method definition for .getVirtualHole()
-----------------------------------------------------------------------
--
-- Method:      getVirtualHoleProfile
--
-- Description: Return the virtual hole (Owning Fixing) PROFILE object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getVirtualHoleProfile() is PROFILE

  !profile     = object PROFILE()
  -- get virtual hole profile
  !virtualHole = !this.getVirtualHole()
  if (!virtualHole.unset()) then
    return !profile
  endif

  if (!virtualHole.spre.set()) then
    -- catalogue profile
    !profile    = !!hmFindHoleProfile(!virtualHole)
    handle any
      !profile  = object PROFILE()
    endhandle
  else
    -- design template profile
    !loop      = object COLLECTION()
    !loop.scope(!virtualHole)
    !loop.type('loop')
    !result    = !loop.results()
    !profile   = object PROFILE(!result[1])
    handle ANY
      !profile = object PROFILE()
    endhandle
  endif

  return !profile

endmethod
-- End of method definition for .getVirtualHoleProfile()

------------------------------------------------------------------------
--
-- Method:      getHoleOwner
--
-- Description: Return the HoleOwner below ASSOC (LNAM eq /HoleOwner)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getHoleOwner() is DBREF

  if (!this.debug) then
    write 'Running hmHole.getHoleOwner()'
  endif

-- If already set then just return current value
  if (!this.holeOwner.set() ) then
    return !this.holeOwner
  endif

  !dbrReturn = object DBREF()

-- Locate the ASSMBR element marked as /HoleOwner
  !ownerItem = !this.findMemberElement(|ASSMBR|, object EXPRESSION(|LNAME eq '/HoleOwner'|) )

-- If no problems, grab the AMEMRF of this element
  if (!ownerItem.size().eq(1) ) then
    !dbrReturn = !ownerItem[1].amemrf
    !tarf      = !ownerItem[1].asstar
    handle ANY
      !this.hullPlate = object DBREF()
    elsehandle NONE
      !this.hullPlate = !tarf
    endhandle
  endif

  if (!dbrReturn.set() and (not badref(!dbrReturn)))  then
    if (!dbrReturn.hardType eq 'PANE') then
      !this.plateThickness = !dbrReturn.lohe
    elseif (!dbrReturn.type eq 'HPLATE' or !dbrReturn.type eq 'CPLATE') then
      !this.plateThickness = !dbrReturn.thickn
    elseif (!dbrReturn.type eq 'HPANEL' or !dbrReturn.type eq 'CPANEL') then
      !this.plateThickness = !tarf.thickn
      handle ANY
      endhandle
    elseif (!dbrReturn.type eq 'CTWALL' or !dbrReturn.type eq 'BPANEL') then
      !this.plateThickness = !dbrReturn.wThickness
      handle ANY
      endhandle
    elseif (!dbrReturn.type inset ('SCTN','GENSEC','STWALL','WALL')) then
      !this.plateThickness = !ownerItem[1].realev
      handle ANY
      endhandle
    endif
  endif

  return !dbrReturn

endmethod
-- End of method definition for .getHoleOwner()
------------------------------------------------------------------------
--
-- Method:      getHoleOwners
--
-- Description: Return the HoleOwners below ASSOC (LNAM eq /HoleOwner<number>)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getHoleOwners() is ARRAY

  if (!this.debug) then
    write 'Running hmHole.getHoleOwners()'
  endif

-- If already set then just return current value
  if (!this.holeOwners.set() ) then
    return !this.holeOwners
  endif

-- Locate all the ASSMBR element marked as /HoleOwner<number>
  !findHoleOwners = object COLLECTION()
  !findHoleOwners.type('ASSMBR')
  !findHoleOwners.scope(!this.element)
  !findHoleOwners.filter(object EXPRESSION(|matchwild(lname,'/HoleOwner?') and not badref(amemrf)|))
  !holeOwners = !findHoleOwners.results()

  !returnPanels = object ARRAY()

-- If no problems, grab the AMEMRF of the elements
  do !assMember values !holeOwners
    !returnPanels.append(!assMember.amemrf)
  enddo

  return !returnPanels
endmethod
-- End of method definition for .getHoleOwner()

------------------------------------------------------------------------
--
-- Method:      getHoleTarget
--
-- Description: Return the target reference (ASSTAR of LNAM eq /HoleOwner)
--              if set - otherwise return the amemrf
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getHoleTarget() is DBREF

  if (!this.debug) then
    write 'Running hmHole.getHoleTarget()'
  endif

  !dbrReturn = object DBREF()

  -- Locate the ASSMBR element marked as /HoleOwner
  !ownerItem = !this.findMemberElement(|ASSMBR|, object EXPRESSION(|LNAME eq '/HoleOwner'|) )

  -- If no problems, grab the AMEMRF of this element
  if (!ownerItem.size().eq(1) ) then
    if( badref( !ownerItem[1].asstar ) ) then
      !dbrReturn = !ownerItem[1].amemrf
    else
      !dbrReturn = !ownerItem[1].asstar
    endif
  endif

  return !dbrReturn

endmethod
-- End of method definition for .getHoleTarget()

------------------------------------------------------------------------
--
-- Method:      GetStatusHistory
--
-- Description: Collect all stored data for status changes on this hole
--              Returns a pipe-delimited array (i.e. DATE|USER|STATUS|NOTE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getStatusHistory() is ARRAY

  if (!this.debug) then
    write 'Running hmHole.getStatusHistory()'
  endif

-- If already set then just return current value
  if (!this.statusHistory.set() ) then
    return !this.statusHistory
  endif

  !arrReturn = ARRAY()

-- Identify the storage point
  !ddselist = !this.findMemberElement(|DDSE|, object EXPRESSION(|LNAME OF OWNER eq '/StatusHistory'|) )
  if (!ddselist.size().lt(1) ) then
-- This is acceptable if status has not been applied yet there will be no status history!
     if (!this.status.set() AND !this.status.neq('') ) then
       !!alert.error(|Unable to locate DDSE with LNAME OF OWNER /StatusHistory for | + !this.element.name)
     endif
     return !arrReturn
  endif

-- Populate the return variable
  do !item values !ddselist
-- The following code is not used as cannot query DDSE member individually
-- (only returns data from first one)
--    !sDate = !item.tcdp.date
--    !sUser = !item.tcdp.user
--    !sStat = !item.tcdp.stat
--    !sNote = !item.tcdp.comm
--    !statusHistory.append(!item.tcdp.stat + '|' + !item.tcdp.comm + '|' + !item.tcdp.date + '|' + !item.tcdp.user)

-- Replacement code starts here
    !sStat = ''
    !sNote = ''
    !sDate = ''
    !sUser = ''

    do !memb values !item.members
      if (!memb.dkey.eq('DATE') ) then
        !sDate = !memb.ddprop.replace(|( '|,||).replace(|' )|,||)
      endif
      if (!memb.dkey.eq('USER') ) then
        !sUser = !memb.ddprop.replace(|( '|,||).replace(|' )|,||)
      endif
      if (!memb.dkey.eq('STAT') ) then
        !sStat = !memb.ddprop.replace(|( '|,||).replace(|' )|,||)
--        if (!sStat.eq('')) then
--            !sStat = '<unset>'
--        endif
      endif
      if (!memb.dkey.eq('COMM') ) then
        !sNote = !memb.ddprop.replace(|( '|,||).replace(|' )|,||)
      endif
    enddo
    !arrReturn.append(!sDate + '|' + !sUser + '|' + !sStat + '|' + !sNote)
  enddo

-- Return the array of data found
  return !arrReturn

endmethod
-- End of method definition for .getStatusHistory()


------------------------------------------------------------------------
--
-- Method:      GetStatus
--
-- Description: Return status value from ASTATU with LNAME eq /Status (i.e. GTYPE)
--              Value stored and retrieved as 4 chars GTYPE value (use FULLSTATUS for proper word)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getStatus() is STRING

  if (!this.debug) then
    write 'Running hmHole.getStatus()'
  endif

-- If already set then just return current value
  if (!this.status.set() ) then
    return !this.status
  endif

  !strReturn = STRING()

  !statusItem = !this.findMemberElement(|ASTATU|, object EXPRESSION(|LNAME eq '/Status'|) )

  if (!statusItem.size().eq(1) ) then
    !strReturn = !statusItem[1].gtype
  endif

  return !strReturn
endmethod
-- End of method definition for .getStatus()


------------------------------------------------------------------------
--
-- Method:      getFullStatus
--
-- Description: Return full length status value (use STATUS for 4 char GTYPE value)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getFullStatus() is STRING

  if (!this.debug) then
    write 'Running hmHole.getFullStatus()'
  endif

  !strReturn = STRING()

-- If already set then just return empty value
  if (NOT !this.status.set() ) then
    return !strReturn
  endif

  !strReturn = !this.translateStatus(!this.status)

  return !strReturn
endmethod
-- End of method definition for .getStatus()


------------------------------------------------------------------------
--
-- Method:      ReadMemberData
--
-- Description: Read model data for this hole and populate member variables as needed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .readMemberData() is BOOLEAN

  if (!this.debug) then
    write 'Running hmHole.readMemberData()'
  endif

  !this.valid = TRUE
-- Find Hole Type
  !this.holeType = !this.element.desc

-- Retrieve Hole Owner and set member accordingly
  !this.holeOwner = !this.getHoleOwner()
  if (badref(!this.holeOwner)) then
    !this.valid = FALSE
  endif

-- Retrieve other Hole Owners and set member accordingly
  !this.holeOwners = !this.getHoleOwners()
  do !panel values !this.holeOwners
    if (badref(!panel)) then
      !this.valid = FALSE
    endif
  enddo


-- Retrieve primary element and set member accordingly
  !this.primaryElement = !this.getPrimaryElement()

-- Retrieve secondary elements and set member variable accordingly
  !this.secondaryElements = !this.getSecondaryElements()

-- Retrieve status comment to member variable
  !this.statusComment = !this.getStatusComment()

-- Retrieve status to member variable
  !this.status = !this.getStatus()

-- Retrieve full wording of status to member variable
  !this.fullStatus = !this.getFullStatus()

-- Retrieve comment at ASSOC level
  !this.comment = !this.getComment()

-- Retrieve ORIGIN data from ASREQU with LNAME /DesignData
  !this.origin = !this.getOrigin()

-- Retrieve RATING data from ASREQU with LNAME /DesignData
  !this.rating = !this.getRating()

-- Retrieve Desp data from ASREQU with LNAME /DesignData
  !this.fixiDesp = !this.getDesp()

-- Retrieve type data from ASREQU with LNAME /DesignData
  !this.fixiType = !this.getType()

-- Retrieve nominal bore data from ASREQU with LNAME /DesignData
  !this.nomBore = !this.getNomBore()

-- Retrieve status history to member variable
  !this.statusHistory = !this.getStatusHistory()

-- Retrieve the virtual Hole DBREF
  !this.virtualHole = !this.getVirtualHole()
  handle ANY
  endhandle

-- Retrieve the coaming DBREF
  !this.coaming = !this.getCoamingElement()

-- Retrieve the sealPlate DBREF
  !this.sealPlate = !this.getSealPlate()

-- Retrieve the extra wall opening DBREF
  !this.extraWallOpening = !this.getExtraWallOpening()

  return true
endmethod
-- End of method definition for .readMemberData()


------------------------------------------------------------------------
--
-- Method:      TranslateStatus
--
-- Description: Translate the supplied 4 char GTYPE value to a full length status value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .translateStatus(!value is STRING) is STRING

  if (!this.debug) then
    write 'Running hmHole.translateStatus()'
  endif

  !strReturn = STRING()

  if (!value.eq('REQU') ) then
    !strReturn = 'REQUESTED'
  elseif (!value.eq('ACKN') ) then
    !strReturn = 'ACKNOWLEDGED'
  elseif (!value.eq('REJE') ) then
    !strReturn = 'REJECTED'
  elseif (!value.eq('APPR') ) then
    !strReturn = 'APPROVED'
  elseif (!value.eq('REDU') ) then
    !strReturn = 'REDUNDANT'
  elseif (!value.eq('WITH') ) then
    !strReturn = 'WITHDRAWN'
  elseif (!value.eq('') OR !value.unset()) then
    !strReturn = object STRING()
  else
    !strReturn = 'UNKNOWN'
  endif

  return !strReturn
endmethod
-- End of method definition for .translateStatus()


------------------------------------------------------------------------
--
-- Method:      findMemberElement
--
-- Description: Find a specific element in the ASSOC hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      GTYPE of element to search for
--    2    R     EXPRESSION  The PML expression to be used when filtering results
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findMemberElement(!gtype is STRING, !expr is EXPRESSION) is ARRAY

  if (!this.debug) then
   write 'Running hmHole.findMemberElement(STRING, EXPRESSION)'
  endif
  if (!this.element.unset()) then
    !result = ARRAY()
    return !result
  endif
  !find = object COLLECTION()
  !find.scope(!this.element)
  !find.type(!gtype)
  !find.filter(!expr)

  return !find.results()

endmethod
-- End of method definition for .findMemberElement()
------------------------------------------------------------------------
--
-- Method:      claimHole
--
-- Description: Claim the association hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--   BOOLEAN can the hole be claimed
--
------------------------------------------------------------------------
define method .claimHole() is BOOLEAN

if (!this.element.dbexno gt 1) then
  --var !unusedClaim CLAIMLIST EXTRACT
  EXTRACT CLAIM $!<this.element> HIER
  handle (2,622) (2,636)
    !!alert.message('Attempting a Global claim. Please wait and click Global Status button to view progress')
    return  FALSE
  elsehandle ANY
    !!alert.error(!!error.text)
    return FALSE
  endhandle
  CLAIM $!<this.element> HIER
else
  CLAIM $!<this.element> HIER
  handle ANY
    !!alert.error(!!error.text)
    return FALSE
  endhandle
endif

return TRUE

endmethod
-- End of method definition for .claimHole()
------------------------------------------------------------------------
--
-- Method:      unclaimHole
--
-- Description: Unclaim the ASSOC hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .unclaimHole()

UNCLAIM $!<this.element> HIER

endmethod
-- End of method definition for .unclaimHole()
------------------------------------------------------------------------
--
-- Method:      issueHole
--
-- Description: issue the ASSOC hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .issueHole()

  UNCLAIM $!<this.element> HIER
  EXTRACT ISSUE $!<this.element> HIER

endmethod
-- End of method definition for .unclaimHole()
------------------------------------------------------------------------
--
-- Method:      getDesignation
--
-- Description: Return the hull hole designation
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .getDesignation() is STRING

  !type        = !this.getType().after('TYPE').trim().upcase()
  !sParameters = !this.getDesp()
  !aParameters = !sParameters.split()

  if( !type eq 'D' ) then
    -- Round Hole
    !numberParameters = 1
  elseif( !type eq 'HO' ) then
    -- Symmetrical manhole
    !numberParameters = 2
  elseif( !type eq 'HOR' ) then
    -- Unsymmetrical manhole
    !numberParameters = 3
  elseif( !type eq 'HE' ) then
    -- Elliptical hole
    !numberParameters = 2
  elseif( !type eq 'HO' ) then
    -- Super elliptical hole
    !numberParameters = 3
  elseif( !type eq 'HER' ) then
    -- Elliptical rectangular hole
    !numberParameters = 4
  elseif( !type eq 'HR' ) then
    -- Rectangular hole
    !numberParameters = 3
  elseif( !type eq 'HRM' ) then
    -- Rectangular hole with ears
    !numberParameters = 4
  elseif( !type eq 'HT' ) then
    -- Triangular hole
    !numberParameters = 3
  else
    -- should not get here
    return !type
  endif

  -- assemble hull hole designation string
  !designation = !type + !aParameters[1]
  do !i from 2 to !numberParameters
    if( undefined(!aParameters[!i]) ) then
      !designation = !designation + '*0'
    else
      !designation = !designation + '*' + !aParameters[!i]
    endif
  enddo

  return !designation

endmethod
-- End of method definition for .getDesignation()

