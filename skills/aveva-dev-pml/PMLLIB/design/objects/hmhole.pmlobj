------------------------------------------------------------------------
--
-- Method:      setStatusOnMerge
--
-- Description: Update the status for this hole as a result of merging in other holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStatusOnMerge() is BOOLEAN

  if (!this.debug) then
    write 'Running hmHole.setStatusOnMerge()'
  endif

  !safeCE = !!ce
-- Validation checks could be added here as required - return false on failure

-- Retain old value for winding back in case of failure
  !oldStatus = !this.getStatus()
  !oldStatusComment = !this.getStatusComment()

-- Set new values for MERGED hole (I.e. status unset)
  !this.setStatusComment(|Multiple holes merged. Previous status value cleared|)
  !this.setStatus('')

-- Add information to the history of status changes but rewind if it fails
  if ( NOT !this.storeStatusChange() ) then
      !!alert.warning(|Error updating status, change not made - $!!error.text|)
      !this.setStatus(!oldStatus)
      !this.setStatusComment(!oldStatusComment)
      !!ce = !safeCE
      return false
  endif

  !!ce = !safeCE
  return true

endmethod
-- End of method definition for .setStatusOnMerge()


------------------------------------------------------------------------
--
-- Method:      SetStatusOnSplit
--
-- Description: Update the status for this hole as a result of splitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStatusOnSplit() is BOOLEAN

  if (!this.debug) then
    write 'Running hmHole.setStatusOnSplit()'
  endif

-- Validation checks could be added here as required - return false on failure
  !safeCE = !!ce

-- Retain old value for winding back in case of failure
  !element = !this.findMemberElement(|ASTATU|, object EXPRESSION(|LNAME eq '/Status'|) )
  !statusItem = !element[1]

  !oldGtype = !statusItem.gtype
--  !oldDesc = !statusItem.DESC

  !statusItem.gtype = ''
  !this.status = !statusItem.gtype

  !this.setStatusComment(|Hole split - Status reverted to default value|)

  -- Add information to the history of status changes but rewind if it fails
  if ( NOT !this.storeStatusChange() ) then
      !!alert.warning(|Error updating status, change not made - $!!error.text|)
      !statusItem.gtype = !oldGtype
      !this.status = !statusItem.gtype
      !this.statusComment = !statusItem.descr

      !!ce = !safeCE
      return false
  endif

 !!ce = !safeCE
  return true

endmethod
-- End of method definition for .setStatusOnSplit()


