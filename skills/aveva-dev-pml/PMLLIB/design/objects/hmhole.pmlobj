--
-- File:            hmhole.pmlobj
--   Type:          Object Definition
--   Group:
--     Keyword:     Hole Management
--   Module:        DESIGN
-- Author:          Richard.Thompson
--  Created:        <date/time>
--
--
-- Description:
--   Object representing a single hole in the Hole Management system
--   (Mainly used to manage 3D objects and attributes)
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  claimHole()                      BOOLEAN             Claim the association hierarchy
--  findMemberElement(STRING,EXPRESSION) ARRAY
--  getAssociation()                 DBREF               Return the ASSOC element for this hole
--  getCoamingElement()              DBREF               Return the coaming element
--  getComment()                     STRING              Scan ASSOC element to return the current HOLE comment
--  getDesignation()                 STRING              Return the hull hole designation
--  getDesp()                        STRING
--  getExtraWallOpening()            DBREF               Return the extra wall opening
--  getFixingType()                  STRING              Return the Hole Fixing Type code
--  getFullStatus()                  STRING              Return full length status value (use STATUS for 4 char GTYPE value)
--  getHoleOwner()                   DBREF               Return the HoleOwner below ASSOC (LNAM eq /HoleOwner)
--  getHoleOwners()                  ARRAY               Return the HoleOwners below ASSOC (LNAM eq /HoleOwner<number>)
--  getHoleProfile(DBREF)            PROFILE             Return PROFILE object of given association member reference.
--  getHoleTarget()                  DBREF               Return the target reference (ASSTAR of LNAM eq /HoleOwner)
--  getHoleType()                    STRING              Return the Hole Type code
--  getNomBore()                     STRING              Locate the NOMBORE from the ASREQU with LNAME /DesignData
--  getOrigin()                      POSITION            Scan ASSOC element to return a POSITION object representing the origin point
--  getPrimaryElement()              DBREF               Scan ASSOC element to return the DBREF of the Primary Element (PRIMEM=TRUE)
--  getPrimaryHole()                 DBREF               Return the target reference (AMEMRF of LNAM eq /PrimaryHole)
--  getPrimaryHoleProfile()          PROFILE             Return PROFILE object of approved hole
--  getRating()                      STRING              Locate the RATING from the ASREQU with LNAME /DesignData
--  getSealPlate()                   DBREF               Return the seal plate panel
--  getSecondaryElements()           ARRAY               Scan ASSOC element to return an ARRAY of DBREFs for non-Primary Elements
--  getStatus()                      STRING              Scan ASSOC element to return the current STATUS value (GTYPE on ASTATU)
--  getStatusComment()               STRING              Scan ASSOC element to return the current STATUS comment
--  getStatusHistory()               ARRAY               Scan ASSOC element to return stored status history data for the current hole
--  getTrayPosition(DBREF)           POSITION            Return position of tray penetration from AHRP p-point of tray mark atta
--  getType()                        STRING              Locate the types from the ASREQU with LNAME /DesignData
--  getVirtualHole()                 DBREF
--  getVirtualHoleProfile()          PROFILE             Return the virtual hole (Owning Fixing) PROFILE object
--  hmHole()                         -                   Constructor - create empty instance of this object
--  hmHole(DBREF)                    -                   Constructor - create fully loaded instance using ASSOC element as DBREF parameter
--  issueHole()                      -                   issue the ASSOC hierarchy
--  readMemberData()                 BOOLEAN             Use defined ASSOC element to populate member variables for the current hole
--  setComment(STRING)               -                   Set the COMMENT member variable to the supplied string
--  setDespars(STRING)               -                   Set the despars to the supplied string
--  setHoleType(STRING)              -                   Set the hole type to the supplied string
--  setPosition(STRING)              -                   Set the Position member variable to the supplied string
--  setStatus(STRING)                BOOLEAN             Update the status for this hole and populate the status history
--  setStatusComment(STRING)         -                   if does not find LNAME is /Status below assoc element, automatically create ASTATU
--  setStatusOnMerge()               BOOLEAN             Update the status for this hole as a result of merging in other holes
--  setStatusOnSplit()               BOOLEAN             Update the status for this hole as a result of splitting
--  storeStatusChange()              BOOLEAN             Add the current status data to the history (following a change)
--  translateStatus(STRING)          STRING              Translate the supplied 4 char GTYPE value to a full length status value
--  unclaimHole()                    -                   Unclaim the ASSOC hierarchy
--  validation()                     BOOLEAN             Evaluation Test
--  zDir()                           DIRECTION           Return the normal to the virtual hole
--
------------------------------------------------------------------------

define object HMHOLE

  member .element            is DBREF
  member .status             is STRING
  member .fullStatus         is STRING
  member .statusComment      is STRING
  member .holeOwner          is DBREF
  member .holeOwners         is ARRAY
  member .primaryElement     is DBREF
  member .secondaryElements  is ARRAY
  member .holeType           is STRING
  member .comment            is STRING
  member .origin             is POSITION
  member .rating             is STRING
  member .nomBore            is STRING
  member .fixiDesp           is STRING
  member .fixiType           is STRING
  member .statusHistory      is ARRAY
  member .virtualHole        is DBREF
  member .valid              is BOOLEAN
  member .plateThickness     is REAL
  member .coaming            is DBREF
  member .zDirection         is DIRECTION
  member .sealPlate          is DBREF
  member .extraWallOpening   is DBREF
  member .hullPlate          is DBREF

  member .debug              is BOOLEAN

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      hmHole
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmHole()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hmHole(DBREF)
--
-- Description: Constructor - alternate using DBREF parameter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmHole(!item is DBREF)

-- First run the standard constructor method
  !this.hmHole()

  if (!this.debug) then
    !name = !item.name
    write 'Running hmHole.hmHole(DBREF) for $!name'
  endif

  if (!item.hardty.neq('ASSOC') ) then
    ASSOC
    handle any
      !!alert.error(!item.hardty + ' ' + !item.name + ' is not a managed hole')
      return
    endhandle
  endif

-- Add more validation checks here if required

-- Set member variable
  !this.element = !item

-- Gather all associated data and set other member variables
  if (NOT !this.readMemberData() ) then
    !!alert.error('Error reading hole data for ' + !item.hardty + ' ' + !item.name)
    return
  endif

endmethod
-- End of method definition for .hmHole()


------------------------------------------------------------------------
--
-- Method:      validation
--
-- Description: Validate the restrictions on this association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validation() is BOOLEAN

  if (!this.debug) then
    write 'Running hmHole.validation()'
  endif

  !result = !this.element.testev
  handle any
    !result =  false
  endhandle

  return !result

endmethod
-- End of method definition for .validation()


------------------------------------------------------------------------
--
-- Method:      setStatus
--
-- Description: Update the status for this hole and populate the status history
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- value      R     STRING    new status
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStatus(!newValue is STRING) is BOOLEAN

  if (!this.debug) then
    write 'Running hmHole.setStatus(STRING)'
  endif

  !ableToModify = !this.claimHole()
  if (!ableToModify.not()) then
    return FALSE
  endif

  !safeCE = !!ce
  !statusItem = !this.findMemberElement(|ASTATU|, object EXPRESSION(|LNAME EQ '/Status'|) )

  if (!statusItem.size().eq(1) ) then

    !elem = !statusItem[1]

-- Retain old value for winding back in case of failure
    !oldStatus = !this.getStatus()
    !oldStatusComment = !this.getStatusComment()
    !oldFullStatus = !this.getFullStatus()

-- Set new values in database
    if (!newValue.eq('') ) then
      $!elem
      GTYPE UNSET
      $!safeCE
    else
      !elem.gtype = !newValue
    endif
    !this.status = !elem.gtype
    !this.fullStatus = !newValue

    if (!newValue.eq('') ) then
      !this.setStatusComment(|Status changed from $!oldFullStatus to <unset>|)
    elseif (!oldFullStatus.unset() ) then
      !this.setStatusComment(|Status changed from <unset> to $!newValue|)
    else
      !this.setStatusComment(|Status changed from $!oldFullStatus to $!newValue|)
    endif

-- Add information to the history of status changes but rewind if it fails
    if ( NOT !this.storeStatusChange() ) then
      !elem.gtype = !oldStatus
      !this.status = !elem.gtype
      !this.fullStatus = !oldFullStatus
      !this.setStatusComment(!oldStatusComment)
      !!alert.warning(|Error updating status history, change not made - $!!error.text|)

      !!ce = !safeCE
      return false
    endif

  else

    !!alert.error(|Error locating a single STATUS for | + !this.element.name)
  endif

  !!ce = !safeCE
  return true

endmethod
-- End of method definition for .setStatus()


------------------------------------------------------------------------
--
-- Method:      storeStatusChange
--
-- Description: Add the current status data to the history (following a change)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storeStatusChange() is BOOLEAN

  if (!this.debug) then
    write 'Running hmHole.storeStatusChange()'
  endif

-- Identify the storage point
  !insertPoint = !this.findMemberElement(|ASREQU|, object EXPRESSION(|LNAME EQ '/StatusHistory'|) )

-- Add new hierarchy elements AFTER any existing items
  $!insertPoint[1]
  handle (2,752)
    return  false
  endhandle

  TAIL
  NEW DDSE
  handle any
    return false
  endhandle

  !workDate = object DATETIME()
  !currYear = !workDate.year().string()
  !currMon  = |0| + !workDate.month().string()
  !currMon  = !currMon.substring(!currMon.length() - 1)
  !currDay  = |0| + !workDate.date().string()
  !currDay  = !currDay.substring(!currDay.length() - 1)
  !currHour = |0| + !workDate.hour().string()
  !currHour = !currHour.substring(!currHour.length() - 1)
  !currMin  = |0| + !workDate.minute().string()
  !currMin = !currMin.substring(!currMin.length() - 1)
  !currDate = || + !currYear + !currMon + !currDay + !currHour + !currMin
  NEW DDAT
  DKEY DATE
  DDPROP |$!currDate|

  !currSess = current session
  !currUser = !currSess.user().name + | (| + !currSess.name + |)|
  NEW DDAT
  DKEY USER
  DDPROP |$!currUser|

  NEW DDAT
  DKEY STATUS
  DDPROP |$!this.status|

  NEW DDAT
  DKEY COMM
  DDPROP |$!this.statusComment|

-- Return true if no problems
  return true

endmethod
-- End of method definition for .storeStatusChange()


------------------------------------------------------------------------
--
-- Method:      setStatusComment
--
-- Description: Set the StatusComment member variable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
