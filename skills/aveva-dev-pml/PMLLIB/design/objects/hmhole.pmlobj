------------------------------------------------------------------------
--
-- Method:      getHoleType
--
-- Description: Return the Hole Type code
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Hole type code
--
------------------------------------------------------------------------

define method .getHoleType() is STRING

  return !this.element.description

endmethod
-- End of method definition for .getHoleType()

------------------------------------------------------------------------
--
-- Method:      getFixingType
--
-- Description: Return the Hole Fixing Type code
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Hole type code
--
------------------------------------------------------------------------

define method .getFixingType() is STRING

  !holeType   = !this.holeType

  if (!holeType eq 'PIPE') then
    !holeDefinitionType   = 'PIPE'
  elseif (!holeType eq 'DUCT') then
    -- get basic type before suffix
    !fixingType           = !this.getType().before('/')
    if (!fixingType eq 'TYPE D') then
      !holeDefinitionType = 'CIRC'
    elseif (!fixingType eq 'TYPE HR') then
      !holeDefinitionType = 'RECT'
    elseif (!fixingType eq 'TYPE HO') then
      !holeDefinitionType = 'OVAL'
    else
      !holeDefinitionType = ''
    endif
  elseif (!holeType eq 'STRU') then
    !holeDefinitionType   = 'SCTN'
  elseif (!holeType eq 'CWAY') then
    !holeDefinitionType   = 'CWAY'
  elseif (!holeType eq 'TRAY') then
    !holeDefinitionType   = 'RECT'
  else
    !holeDefinitionType   = ''
  endif

  return !holeDefinitionType

endmethod
-- End of method definition for .getFixingType()

------------------------------------------------------------------------
--
-- Method:      GetOrigin
--
-- Description: Locate the origin data from the ASREQU with LNAME /DesignData
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getOrigin() is POSITION

  if (!this.debug) then
    write 'Running hmHole.getOrigin()'
  endif

-- If already set then just return current value
  if (!this.origin.set() ) then
    return !this.origin
  endif

  !posReturn = object POSITION()

  !originItem = !this.findMemberElement(|DDAT|, object EXPRESSION(|LNAME of ASREQU EQ '/DesignData' and DKEY eq 'ORIG'|) )
  if (!originItem.size().eq(1) ) then
 -- Set return value based on DDPROP (after removing unwanted chars)
    if ( !originItem[1].ddprop.set() AND !originItem[1].ddprop.match('Unset').eq(0) ) then
      !posReturn = object POSITION( !originItem[1].ddprop.replace(|''|,|'|).replace(|( '|,||).replace(|' )|,||) )
      handle (2,109)(2,107)
        -- This is required if the penetrating object has been deleted
        -- Or if the JLDATU hierarchy of a penetrating GENSEC has been deleted.
        !position  = !originItem[1].ddprop.replace(|''|,|'|).replace(|( '|,||).replace(|' )|,||).before('WRT')
        !posReturn = object POSITION(!position)
      endhandle
    endif
  endif

  return !posReturn

endmethod
-- End of method definition for .getOrigin()


------------------------------------------------------------------------
--
-- Method:      GetRating
--
-- Description: Locate the RATING from the ASREQU with LNAME /DesignData
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]     [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getRating() is STRING

  if (!this.debug) then
    write 'Running hmHole.getRating()'
  endif

-- If already set then just return current value
  if (!this.rating.set() ) then
    return !this.rating
  endif

  !strReturn = object STRING()

  !ratingItem = !this.findMemberElement(|DDAT|, object EXPRESSION(|LNAME of ASREQU eq '/DesignData' and DKEY eq 'RATI'|) )
  if (!ratingItem.size().eq(1) ) then
 -- Set return value based on DDPROP (after removing unwanted chars)
    if (!ratingItem[1].ddprop.set() ) then
      !strReturn = !ratingItem[1].ddprop.replace(|( '|,||).replace(|' )|,||)
    endif
  endif

  return !strReturn

endmethod
-- End of method definition for .getRating()
