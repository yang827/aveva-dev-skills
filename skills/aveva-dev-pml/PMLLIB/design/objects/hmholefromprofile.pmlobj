--   Group:         General Application
--     Keyword:     GEN
--   Module:        Design
--   Replaces:
--
-- Author:          M.Barlow
--  Created:        19/05/2008
--
--
-- Description:
--   Object for creating a Managed Hole from a penetration profile
--   definition in an existing catalogue Design Template item.
--   Hole management configuration must be initialised before this
--   object is used
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createManagedHole()              -                   Create entry in Hole Management system
--  createVirtualFixing()            DBREF               Create virtual penetration and FIXING for this profile
--  findNearestPlate(DBREF,PROFILE)  DBREF               Find nearest plate on the given HPANEL
--  getPenetrated()                  ARRAY               Get current penetrated elements
--  getPenetrating()                 ARRAY               Get current penetrating elements
--  getProfile()                     PROFILE             Return profile object
--  hmHoleFromProfile()              -                   Constructor
--  isValidProfile()                 BOOLEAN             Check that profile object is valid
--  modify(HMHOLE)                   -                   Modify virtual penetration and FIXING for this profile
--  modifyExtraWallOpening()         -                   Modify the extra wall opening
--  modifyVirtualFixing()            -                   Modify virtual penetration and FIXING for this profile
--  setHoleType(STRING)              -                   Purpose to identify type of hole
--  setPenetrated(DBREF,POSITION,PLANE) -                   Process penetrated items data
--  setPenetrating(DBREF)            PROFILE             Element used to make the hole. Must have a hole boundary.
--
------------------------------------------------------------------------

--- form definition
define object HMHOLEFROMPROFILE

  -- Element given as penetrating item. Must have a valid hole profile
  member .penetratingElement  is DBREF
  -- profile extracted from penetrating item
  member .penetratingProfile  is PROFILE

  -- Define member for currently loaded appware
  member .penetrated          is DBREF
  member .thickness           is REAL
  member .plane               is PLANE

  -- dbref of panel
  member .pickedItem          is DBREF
  -- Type of fixing
  member .fixiType            is STRING
  -- Type of hole
  member .holeType            is STRING

  -- position of hole in panel
  member .holePosition        is POSITION

  -- this member stores the reference to the created hole fixing so we can modify ones that have already been created during dynamic preview
  member .virtualHoleRef      is DBREF

  -- member to hold the hole information in modify mode
  member .hmHole              is HMHOLE

  -- Penetration geometry
  member .penetratedPosition  is POSITION
  member .panelPosition       is POSITION
  member .plateThickness      is REAL
  member .penetratedDirection is DIRECTION
  member .penetratedProfile   is PROFILE
  member .extraWallOpening    is DBREF

  -- Database item where the fixing will be created
  member .penetratingElementLocation      is DBREF

endobject

------------------------------------------------------------------------
-- Method:      hmHoleFromProfile
--
-- Description: Constructor
------------------------------------------------------------------------
define method .hmHoleFromProfile()

  -- Initialise member variables
  !this.fixiType  = 'FREE'
  !this.holeType  = 'PROF'

  -- find virtual hole store
  VAR !vhStore COLLECT ALL STRU WITH (PURP eq 'HOLE' and dbwrite)
  if (!vhStore.empty() ) then
    return error 1 |Unable to locate hole management ZONE (PURP=HOLE)|
  endif

  !this.penetratingElementLocation = !vhStore[1].dbref()

  -- clear hole reference
  !this.virtualHoleRef = object DBREF()

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      setHoleType
--
-- Description: Purpose to identify type of hole
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole type (purpose)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHoleType(!holeType is STRING)

  -- Initialise member variables
  !this.holeType = !holeType

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      setPenetrating
--
-- Description: Element used to make the hole. Must have a hole boundary.
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element which will be used to make the hole
-- Return:
--   [Data Type] [Description]
--    PROFILE     Profile of hole required. If unset this element is unsuitable
--                as a managed hole penetration
--
------------------------------------------------------------------------
define method .setPenetrating(!penetratingElement is DBREF) is PROFILE

  -- Initialise member variables
  !this.penetratingElement = !penetratingElement

  !this.penetratingProfile = !!hmFindHoleProfile(!penetratingElement)
  handle ANY
    !this.penetratingProfile = object PROFILE()
  endhandle

  if( !this.penetratingProfile.unset() ) then
    return object PROFILE()
  endif

  if( !this.penetratingProfile.isValidClosed().not() ) then
    return object PROFILE()
  endif

  return !this.penetratingProfile

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      getPenetrating
--
-- Description: Get current penetrating elements
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of penetrating element DBREFs
--
------------------------------------------------------------------------
define method .getPenetrating() is ARRAY

  -- Initialise member variables
  if( badref(!this.penetratingElement) ) then
    !penetratingArray    = ARRAY()
  else
    !penetratingArray[1] = !this.penetratingElement
  endif

  return !penetratingArray

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getProfile
--
-- Description: Return profile object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROFILE     Profile object for this object
--
------------------------------------------------------------------------
define method .getProfile() is PROFILE

  return !this.penetratingProfile

endmethod

------------------------------------------------------------------------
--
-- Method:      isValidProfile
--
-- Description: Check that profile object is valid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if Profile object is OK - Set, valid and closed
--
------------------------------------------------------------------------
define method .isValidProfile() is BOOLEAN

  if( !this.penetratingProfile.unset() ) then
    return false
  endif

  return !this.penetratingProfile.isValidClosed()

endmethod

----------------------------------------------------------------------
--
-- Method:      .setPenetrated()
--
-- Description: Process penetrated items data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       EDG Item picked to be penetrated
--    2   R      DBREF       EDG pick position
--    3   R      DBREF       EDG plane picked or unset plane
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if Profile object is OK - Set, valid and closed
--
------------------------------------------------------------------------
define method .setPenetrated(!item is DBREF, !position is POSITION, !plane is PLANE)

  !this.pickedItem       = !item
  !this.penetrated       = object DBREF()
  !this.penetratedProfile = object PROFILE()

  -- set penetrated data for each type of penetrated object
  if( !item.hardType eq 'HPLATE' ) then
    !this.plateThickness = !item.thickness
    if (!item.knuckl) then
      -- knuckled panel - must have a picked face
      if(!plane.unset()) then
        return error 1 'Plane on Penetrated item is invalid'
      endif
      !this.penetratedDirection = !plane.direction()
      !this.panelPosition       = !plane.position
      !this.plane               = !plane
    else
      -- planar hull panel - get geometry from hull panel
      !this.panelPosition       = !item.position.wrt(world)
      !this.plane               = object PLANE(!this.panelPosition, !item.orientation.wrt(world))
      !this.penetratedDirection = !item.ori.zdir().wrt(world)
    endif
    !this.penetratedPosition    = !this.plane.position
    -- add the HPANEL
    !this.penetrated            = !item.owner
    !this.penetratedProfile     = object PROFILE(!this.penetrated)
    handle any
      !this.penetratedProfile   = object PROFILE()
    endhandle
  elseif( !item.hardType eq 'CPLATE' ) then
    -- curved plate
    if(!plane.unset()) then
      return error 1 'Plane on Penetrated item is invalid'
    endif
    !this.plateThickness        = !item.thickness
    !this.penetratedDirection   = !plane.direction()
    !this.panelPosition         = !plane.position
    !this.penetratedPosition    = !plane.position
    !this.plane                 = !plane
    -- add the CPANEL
    !this.penetrated            = !item.hrdprx[1]
  elseif( !item.hardType eq 'CTWALL' or !item.hardType eq 'BPANEL' ) then
    -- Wall element
    if(!plane.unset()) then
      return error 1 'Plane on Penetrated item is invalid'
    endif
    !this.plateThickness        = !item.wThickness
    !this.penetratedDirection   = !plane.direction()
    !this.penetratedPosition    = !plane.position
    !this.plane                 = !plane
    -- add the CTWALL
    !this.penetrated            = !item
  else
    -- outfitting panel
    !this.plateThickness        = !item.lohe
    -- put plane on top face, allowing for loop justification
    !vertex                     = object DBREF('PAVE 1 OF PLOOP 1 OF $!<item>')
    !this.penetratedPosition    = !vertex.ppos[3].wrt(world)
    !this.panelPosition         = !item.position.wrt(world)
    !this.plane                 = object PLANE(!this.panelPosition, !item.orientation.wrt(world))
    !this.penetratedDirection   = !item.ori.zdir().wrt(world)
    !this.penetrated            = !item
    !this.penetratedProfile     = object PROFILE(!this.penetrated)
    handle any
      !this.penetratedProfile   = object PROFILE()
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      getPenetrated
--
-- Description: Get current penetrated elements
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of penetrated element DBREFs
--
------------------------------------------------------------------------
define method .getPenetrated() is ARRAY

  -- Initialise member variables
  if( badref(!this.penetrated) ) then
    !penetratedArray    = ARRAY()
  else
    !penetratedArray[1] = !this.penetrated
  endif

  return !penetratedArray

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .createVirtualFixing()
--
-- Description: Create virtual penetration and FIXING for this profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of FRMW element for the new fixing
--
------------------------------------------------------------------------
define method .createVirtualFixing() is DBREF

  -- clear any existing hole reference
  !this.virtualHoleRef = object DBREF()

  -- initialise variables
  !returnRef           = object DBREF()
  !fullName            = !this.penetratingElement.fullName

  if( !this.isValidProfile().not() ) then
    return error 1 |Hole profile for $!<fullName> is not set or invalid|
  endif

  -- get properties of the penetrated item
  !position            = !this.penetratedPosition
  !direction           = !this.penetratedDirection
  !thickness           = !this.plateThickness
  !plane               = !this.plane

  -- get direction of penetrating item
  !penetratingOri      = !this.penetratingProfile.orientation

  -- test for parallel normal directions using dot product because tolerance is too tight in .isParallel()
  if( abs( !penetratingOri.zdir().dot(!direction).abs() - 1.0 ) gt 0.00001  ) then
    return error 2 |$!<fullName> does not lie in the same plane as the penetrated item|
  endif

  -- test for penetrating item within bounds of penetrated item (where penetrated bounds are known)
  if( !this.penetratedProfile.set() ) then
    if( !this.penetratedProfile.isWithin(!this.penetratingElement.position).not() ) then
      !intersections = !this.penetratedProfile.intersections(!this.penetratingProfile)
      handle any
        return error 2 |$!<fullName> does not lie in the same plane as the penetrated item|
      endhandle
      if( !intersections.empty() ) then
        return error 3 |$!<fullName> does not lie within the boundary of the penetrated item|
      endif
    endif
  endif

  -- clear the created items array on initialise
  !this.holePosition   = !position

  -- Create elements
  !safeCE = !!ce

  !!ce    = !this.penetratingElementLocation
  NEW FRMW
  !returnRef           = !!ce
  NEW FIXING
  !this.virtualHoleRef = !!ce
  -- Execute any naming rules that have been defined
  CALL !!autonamece(false)
  handle any
  endhandle
  -- position the fixing at the penetrating item
  !!ce.orientation = !this.penetratingProfile.orientation
  !!ce.position    = !this.penetratingElement.position.wrt( world )
  NEW TMPL
  NEW EXTR
  !!ce.height = (!thickness * 2 )
  NEW LOOP
  !this.penetratingProfile.dbWrite(!!ce)
  EXTR
  MOVE $!<direction> THROUGH $!<position>
  -- find out if direction is into the extrusion or away from it
  !extrusionDirection = !!ce.ori.zdir().wrt(world)
  if( !extrusionDirection.angle(!direction) lt 1 ) then
    -- extrusion on top of plate
    !distance         = (!thickness * 1.5 )
    !tempDirection    = !direction.opposite()
    MOVE $!<tempDirection> dist $!<distance>
  else
    -- extrusion on material side of plate
    !distance         = (!thickness / 2 )
    MOVE $!<direction> dist $!<distance>
  endif

  !!ce = !safeCE

  return !returnRef

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .createManagedHole()
--
-- Description: Create entry in Hole Management system
--              Virtual hole must be created before this
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .createManagedHole()

  if( badref( !this.virtualHoleRef ) ) then
    return error 1 |Virtual hole not found|
  endif

  if( badref( !this.pickedItem ) ) then
    return error 2 |No penetrated item has been defined for the current hole|
  endif

  if( badref( !this.penetratingElement ) ) then
    return error 3 |No penetrating item has been defined for the current hole|
  endif

  -- create and populate the holeElemColl object and pass it to hole management
  -- minimum required elements are the panel and the hole fixing reference
  !holeElemColl            = object HOLEELEMCOLL()
  !holeElemColl.panel      = !this.pickedItem
  !holeElemColl.holeFixing = !this.virtualHoleRef
  !holeElemColl.fitting    = !this.penetratingElement

  -- Create the associations
  !interface = object HMCONTROL()
  !result    = !interface.createFittHole(!holeElemColl, !this.holePosition, 'Free', '', !this.holeType)
  if (!result.not()) then
    return error 4 'Unable to create the Managed Hole Association'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .modify()
--
-- Description: Modify virtual penetration and FIXING for this profile
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .modify(!hole is HMHOLE)

  !this.hmHole = !hole

  !this.penetrated          = !this.hmHole.getHoleOwner()
  !this.penetratingElement  = !this.hmHole.getPrimaryElement().amemrf
  !this.virtualHoleRef      = !this.hmHole.getVirtualHole()
  !this.plateThickness      = !this.hmHole.plateThickness
  !this.pickedItem          = !this.hmHole.getHoleTarget()
  !this.extraWallOpening    = !this.hmHole.extraWallOpening.amemrf

  -- Find hole profile requirement
  !this.penetratingProfile = !!hmFindHoleProfile(!this.penetratingElement)

  -- if the hole owner is an HPANEL and the picked item is not a HPLATE
  -- then the plate has probably been regenerated. Need to find a new
  -- plate near to penetrating item to get thickness
  if( !this.penetrated.hardType eq 'HPANEL' and !this.pickedItem.hardType eq 'HPANEL' ) then
    -- reference to plate must be bad. Find new picked item
    !this.pickedItem = !this.findNearestPlate(!this.penetrated, !this.penetratingProfile)
    if( !this.pickedItem.unset() ) then
      -- penetrating position must be outside the panel
      return error 1 |Penetrating item is not inside the penetrated panel boundary|
    endif
  endif

  if( !this.isValidProfile().not() ) then
    !fullName = !this.virtualHoleRef.fullName
    return error 1 |Hole profile for $!<fullName> is not set or invalid|
  endif

  !position = !this.pickedItem.position
  -- Since we cannot get an EDG pick plane, pass the penetrating plane
  !plane    = !this.penetratingProfile.plane()

  !penetrated = !this.pickedItem
  !this.setPenetrated(!penetrated, !position, !plane)
  !this.modifyVirtualFixing()
  if (!this.extraWallOpening.set()) then
    !this.modifyExtraWallOpening()
  endif

  -- update the graphics view
  do !i values !!gphDrawLists.drawLists
    !i.add(!this.penetrated)
    !i.add(!this.virtualHoleRef)
    !i.colour(!this.virtualHoleRef,6)
    !i.add(!this.penetratingElement.owner)
    if (!this.extraWallOpening.set()) then
      !i.add(!this.extraWallOpening.owner.owner)
      handle ANY
      endhandle
    endif
  enddo

  !position = !this.virtualHoleRef.position.wrt(worl)
  !through[1] = !position.east
  !through[2] = !position.north
  !through[3] = !position.up
  -- find the current selected view
  !fmsys = object FMSYS()
  !form  = !fmsys.currentDocument()
  !form.view.through = !through
  !form.view.radius = 1000mm

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .modifyVirtualFixing()
--
-- Description: Modify virtual penetration and FIXING for this profile
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .modifyVirtualFixing()

  !thickness           = !this.plateThickness
  !position            = !this.penetratedPosition
  !direction           = !this.penetratedDirection
  !fullName            = !this.penetratingElement.fullName

  -- get direction of penetrating item
  !penetratingOri      = !this.penetratingProfile.orientation

  -- test for parallel normal directions using dot product because tolerance is too tight in .isParallel()
  if( abs( !penetratingOri.zdir().dot(!direction).abs() - 1.0 ) gt 0.00001  ) then
    return error 2 |$!<fullName> does not lie in the same plane as the penetrated item|
  endif

  -- test for penetrating item within bounds of penetrated item (where penetrated bounds are known)
  if( !this.penetratedProfile.set() ) then
    if( !this.penetratedProfile.isWithin(!this.penetratingElement.position).not() ) then
      !intersections = !this.penetratedProfile.intersections(!this.penetratingProfile)
      handle any
        return error 2 |$!<fullName> does not lie in the same plane as the penetrated item|
      endhandle
      if( !intersections.empty() ) then
        return error 3 |$!<fullName> does not lie within the boundary of the penetrated item|
      endif
    endif
  endif

  -- Modify elements
  !safeCE = !!ce

  -- Find the loop of the virtual hole profile
  !find = object COLLECTION()
  !find.type('LOOP')
  !find.scope(!this.hmHole.virtualHole)
  !loop = !find.results()
  if (!loop.empty() ) then
   return error 1 'Unable to modify the virtual hole'
  else
    !!ce = !loop[1]
    DELETE LOOP MEM
  endif

  -- position the fixing at the penetrating item
  FIXING
  !!ce.orientation = !this.penetratingProfile.orientation
  !!ce.position    = !this.penetratingElement.position.wrt( world )

  -- write new penetration hole profile
  !!ce = !loop[1]
  !this.penetratingProfile.dbWrite(!!ce)
  EXTR
  !!ce.height      = (!thickness * 2 )
  MOVE $!<direction> THROUGH $!<position>
  -- find out if direction is into the extrusion or away from it
  !extrusionDirection = !!ce.ori.zdir().wrt(world)
  if( !extrusionDirection.angle(!direction) lt 1 ) then
    -- extrusion on top of plate
    !distance         = (!thickness * 1.5 )
    !tempDirection    = !direction.opposite()
    MOVE $!<tempDirection> dist $!<distance>
  else
    -- extrusion on material side of plate
    !distance         = (!thickness / 2 )
    MOVE $!<direction> dist $!<distance>
  endif

  !!ce = !safeCE

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .findNearestPlate()
--
-- Description: Find nearest plate on the given HPANEL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Hull Panel element
--    2   R      PROFILE     Profile requirement of penetrating element
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of HPLATE element near to point or unset is outside boundary
--
------------------------------------------------------------------------
define method .findNearestPlate(!hullPanel is DBREF, !profile is PROFILE) is DBREF

  !hullPanelProfile = object PROFILE(!hullPanel)
  handle any
    return object DBREF()
  endhandle

  !position = !profile.position

  -- check that position is within boundary
  if( !hullPanelProfile.isWithout(!position) ) then
    -- check for boundary overlap
    !intersections = !hullPanelProfile.intersections(!profile)
    handle any
      -- Probably profiles not in the same plane
      return object DBREF()
    endhandle
    if( !intersections.empty() ) then
      return object DBREF()
    endif
  endif

  -- Find all HPLATE in the panel
  !find           = object COLLECTION()
  !find.type('HPLATE')
  !find.scope(!hullPanel)
  !plates         = !find.results()

  -- loop through plates to find one containing the position
  !nearPlate      = object DBREF()
  do !plate values !plates
    !plateProfile = object PROFILE(!plate)
    !outside      = !plateProfile.isWithout(!position)
    handle any
      skip
    endhandle
    skip if(!outside)
    !nearPlate    = !plate
    break
  enddo

  -- if no containing plate found, try for overlaps
  if( !nearPlate.unset() ) then
    do !plate values !plates
      !plateProfile  = object PROFILE(!plate)
      !intersections = !plateProfile.intersections(!profile)
      skip if( !intersections.empty() )
      !nearPlate     = !plate
      break
    enddo
  endif

  return !nearPlate

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .modifyExtraWallOpening()
--
-- Description: Modify the extra wall opening
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .modifyExtraWallOpening()

  -- set the master wall opening
  !opening = !this.penetratingElement
  -- set the extra wall opening
  !extraWallOpening = !this.extraWallOpening
  if (badref(!extraWallOpening)) then
    !!alert.error('The projected opening is incorrectly set up')
    return
  endif

  !wall      = !extraWallOpening.owner.owner
  !wallPath  = RPATH 1 of $!wall
  handle ANY
    !!alert.error('Cannot find a suitable RPATH for selected wall')
    return
  endhandle
  !polyLine   = object PMLPOLYLINE(!wallPath)

  !actualPosition  = !opening.position.wrt(World)
  !openingPosition = !polyLine.near(!actualPosition)
  if !openingPosition.unset() then
    !!alert.error('Unable to find the opening position')
    return
  endif
  !rPath = object RPATHPOSITIONING(!wallPath)
  !rPath.setPositionNear(!openingPosition, FALSE)

  !extraWallOpening.wJusLine  = !wall.wJusLine
  !extraWallOpening.zDistance = !rPath.zDistance
  !extraWallOpening.posRef    = !rPath.referencePoint
  !extraWallOpening.vertDirection = TRUE

  !safeCE = !!ce
  !!ce = !extraWallOpening
  !!ce = !opening
  RPATH 1
  !profile = object PROFILE(!!ce)
  !!ce = !extraWallOpening
  RPATH 1
  DELETE RPATH MEM
  !profile.dbWrite(!!ce)

  !!ce = !safeCE

endmethod
-- End of method definition
