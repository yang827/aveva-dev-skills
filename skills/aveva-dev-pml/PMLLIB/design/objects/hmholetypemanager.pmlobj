--
-- Description:
--    Hole type data and hole type parameters
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  choose(ARRAY,ARRAY)              -                   Select components that conform to the given criteria
--  clearSelection()                 -                   Select by index into list
--  getChooseDText()                 ARRAY               Get display text of selection gadget
--  getChooseRText()                 ARRAY               Get replacement text of selection gadget
--  getDisplayText()                 ARRAY               Get display text of selection gadget
--  getHoleClassDescriptions()       ARRAY               Get list of hole class descriptions
--  getHoleClassDescriptions(STRING) ARRAY               Get list of hole class descriptions
--  getHoleClassReferences()         ARRAY               Get list of hole class references
--  getHoleClassReferences(STRING)   ARRAY               Get list of hole class references
--  getLastParameterValue(STRING)    REAL                Return last parameter value of current selection for given parameter key
--  getParameterDefault(STRING)      REAL
--  getParameterTitle(STRING)        STRING
--  getQuestions()                   ARRAY               Get questions for selected type
--  getReplacementText()             ARRAY               Get replacement text of selection gadget
--  getSelectedHoleClass()           STRING              Get current hole class
--  getSelectedHoleType()            STRING              Get current hole type
--  getUniqueAnswers(REAL)           ARRAY               Get unique answers to given question for selected type
--  getUserParameters()              ARRAY               Return parameter list keys for current selected type
--  hasCoaming()                     BOOLEAN             Returns TRUE if selected hole type has coaming
--  hmHoleTypeManager()              -                   Constructor
--  holeTypeLoaded(STRING)           BOOLEAN             Search the hole group list to see if this type is loaded
--  initialiseTables()               -                   Initialise table selection gadgets
--  isSelected()                     BOOLEAN             True if a hole type is selected
--  loadFromCatalogue()              -                   Load all hole types from the catalogue
--  loadHoleType(STRING)             -                   Load hole type from the catalogue
--  loaded()                         BOOLEAN             Catalogue data loaded OK
--  parameters()                     ARRAY               Return parameter list keys for current selected type
--  select(DBREF)                    BOOLEAN             Select by reference. The reference must lead to a valid
--  select(REAL)                     BOOLEAN             Select by index into list
--  select(STRING)                   BOOLEAN             Select by replacement text
--  selectHoleClass(STRING)          -                   Select hole class and initialise hole types for that class
--  selectHoleType(DBREF)            -                   Select type (CTABLE) using CTABLE DBREF
--  selectHoleType(STRING)           -                   Select type (CTABLE) using the CTABLE description
--  selected()                       HMHOLETYPE          Return selected item definition
--  setLastParameterValue(ARRAY)     -                   Set last parameter value of current selection
--  setLastParameterValue(HMHOLETYPE) -                   Copy parameter value of current selection from given hole type
--

------------------------------------------------------------------------

define object HMHOLETYPEMANAGER

  -- Table of hole GPART data
  -- List of GPART hole elements - ARRAY of hmHoleType
  member .holeParts              is ARRAY
  -- Hole group for each .holeParts member (ARRAY of STRING). STANDARD for old standard holes;
  -- TMPL for non-catalogue user defined boundary; Selection table type (CTABLE description) for table selected holes
  member .holeGroups             is ARRAY
  -- Detail text for GPART elements
  member .gPartText              is ARRAY
  -- Replacement text for GPART elements in gadgets (array of string GPART references)
  member .gPartRText             is ARRAY
  -- Two dimensional array. Each element contains an array of property keys
  -- corresponding to the GPART parameters
  member .parameterKeys          is ARRAY
  -- Two dimensional array. Each element contains an array of DESP values
  -- last used for the corresponding GPART type
  member .lastUsedParameters     is ARRAY

  -- Index to current selected hole type
  member .selected               is REAL

  -- List of selection table groups (TABGRO DBREFs)
  member .holeClassTables        is ARRAY
  -- List of selection table group replacement text for gadgets (TABGRO STRING references)
  member .holeClassReferences    is ARRAY
  -- List of selection table group display text for gadgets (TABGRO STRING descriptions)
  member .holeClassDescriptions  is ARRAY

  -- Array of SELECTIONTABLE objects - one for each hole class (TABGROUP). Could be sparse - only loaded when first used
  member .holeSelectionTables    is ARRAY
  -- ARRAY of ARRAY of strings containing types (CTABLEs) for each SELECTIONTABLE. Could be sparse - only loaded when first used
  member .holeTypes              is ARRAY
  -- Index to current hole class selected in .holeSelectionTables
  member .selectedHoleClass      is REAL
  -- Key to current hole class selection
  member .selectedClass          is STRING
  -- Purpose of TABGRO for current selected class
  member .selectedHoleClassPurpose is STRING
  -- Currently selected hole type - Array of indexes into the holeParts array
  member .selectedHoleTypes      is ARRAY
  -- Currently selected hole type
  member .selectedType           is STRING
  -- Hole types matching selection criteria - Array of indexes into the holeParts array
  member .holeChooseList         is ARRAY
  -- switch for debug output
  member .debug                  is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmHoleTypeManager
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmHoleTypeManager()

  -- Initialise Variables
  !this.debug                    = false
  !this.selectedHoleClass        = 0
  !this.selectedClass            = 'STANDARD'
  !this.selectedHoleClassPurpose = ''
  !this.selected                 = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadFromCatalogue
--
-- Description: Load all hole types from the catalogue
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadFromCatalogue()

  -- reset GPART data
  !this.holeParts.clear()
  !this.gPartText.clear()
  !this.gPartRText.clear()
  !this.parameterKeys.clear()
  !this.lastUsedParameters.clear()
  !this.selected          = 0
  !this.selectedHoleTypes = ARRAY()

  -- Load standard hole types (legacy data)
  -- Locate all GPARTS with PURP hole and type FIXING (uses PML1 as PML2 cant collect CATA data from DESI dbs)
  !gParts = ARRAY()
  var !gPartList collect all GPART with PURP  eq 'HOLE' and PRITYPE eq 'FIXING'
  do !gPartRef values !gPartList
    !gParts.append(!gPartRef.dbref() )
  enddo

  -- for each hole GPART load data from the catalogue
  do !index indices !gParts
    !holePart = object HMHOLETYPE(!gParts[!index])
    if(!holePart.loaded()) then
      !this.holeParts.append(!holePart)
      !this.gPartRText.append(!holePart.getReplacementText())
      !this.gPartText.append(!holePart.getDisplayText())
      !this.holeGroups.append('STANDARD')
    endif
  enddo

  -- Add a free hole on the end of the catalogue hole list
  !holePart = object HMHOLETYPE()
  !holePart.freeHoleType()
  !this.holeParts.append(!holePart)
  !this.gPartRText.append(!holePart.getReplacementText())
  !this.gPartText.append(!holePart.getDisplayText())
  !this.holeGroups.append('TMPL')

  -- Load user defined hole data from penetration selection tables
  -- configure user specification tables
  !this.initialiseTables()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loaded
--
-- Description: Catalogue data loaded OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if catalogue hole data loaded
--
------------------------------------------------------------------------
define method .loaded() is BOOLEAN

  return !this.holeParts.empty().not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getReplacementText
--
-- Description: Get replacement text of selection gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      of string Reference for hole GPART
--
------------------------------------------------------------------------
define method .getReplacementText() is ARRAY

  !return     = ARRAY()
  if( !this.selectedClass eq 'STANDARD' ) then
    -- standard legacy hole types
    !indexArray = !this.holeGroups.find(!this.selectedClass)
    do !index values !indexArray
      !return.append(!this.gPartRText[!index])
    enddo
  elseif( !this.selectedClass eq 'TMPL' ) then
    -- user defined boundary type
    !return[1] = 'TMPL'
  else
    -- user defined from selection table
    !return    = !this.holeTypes[!this.selectedHoleClass]
  endif

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDisplayText
--
-- Description: Get display text of selection gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      of string Description for hole GPART
--
------------------------------------------------------------------------
define method .getDisplayText() is ARRAY

  !return     = ARRAY()
  if( !this.selectedClass eq 'STANDARD' ) then
    -- standard legacy hole types
    !indexArray = !this.holeGroups.find(!this.selectedClass)
    do !index values !indexArray
      !return.append(!this.gPartText[!index])
    enddo
  elseif( !this.selectedClass eq 'TMPL' ) then
    -- user defined boundary type
    !return[1] = 'None'
  else
    -- user defined from selection table
    !return    = !this.holeTypes[!this.selectedHoleClass]
  endif

  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isSelected
--
-- Description: True if a hole type is selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if catalogue hole data loaded
--
------------------------------------------------------------------------
define method .isSelected() is BOOLEAN

  return !this.selected.gt(0)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selected
--
-- Description: Return selected item definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    HMHOLETYPE  Definition of selected hole
--
------------------------------------------------------------------------
define method .selected() is HMHOLETYPE

  if( !this.isSelected().not() ) then
    return object HMHOLETYPE()
  else
    return !this.holeParts[!this.selected]
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearSelection()
--
-- Description: Select by index into list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index into hole GPART list
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if entry found
--
------------------------------------------------------------------------
define method .clearSelection()

  !this.selected = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      select(REAL)
--
-- Description: Select by index into list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index into hole GPART list
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if entry found
--
------------------------------------------------------------------------
define method .select(!index is REAL) is BOOLEAN

  if( !index.unset() ) then
    return false
  endif
  if( !index lt 1 or !index gt !this.holeParts.size() ) then
    return false
  endif

  !this.selected = !index
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      select(STRING)
--
-- Description: Select by replacement text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      GPART replacement text (string reference)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if entry found
--
------------------------------------------------------------------------
define method .select(!holeTypeKey is STRING) is BOOLEAN

  -- standard legacy hole types
  !index = !this.gPartRText.findFirst(!holeTypeKey)
  if( !this.holeParts[!index].unset() ) then
    -- this is a hole table (CTABLE)
    !this.selectHoleType(!holeTypeKey)
  else
    return !this.select(!index)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      select(DBREF)
--
-- Description: Select by reference. The reference must lead to a valid
--              hole GPART
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Hole GPART
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if entry found
--
------------------------------------------------------------------------
define method .select(!holeRef is DBREF) is BOOLEAN

  if( badref(!holeRef) ) then
    return false
  endif

  !refType  = !holeRef.hardType
  if( !refType eq 'GPART' ) then
    -- GPART reference
    !tableItem = object DBREF()
    !gPartRef  = !holeRef
  elseif( !refType eq 'TABITE' ) then
    -- Selection Table reference
    !tableItem = !holeRef
    !gPartRef  = !tableItem.prtref
    -- Check that GPART is OK
    if( badref(!gPartRef)) then
      return false
    endif
  else
    -- not a GPART or TABITE - see if SPREF of given item leads to a GPART or TABITE
    -- try to go to the GPART
    !try    = !holeRef.spref
    handle any
      return false
    endhandle
    if( !try.hardType eq 'GPART' ) then
      !tableItem = object DBREF()
      !gPartRef = !try
    elseif( !try.hardType eq 'TABITE' ) then
      !tableItem = !try
      !gPartRef  = !try.prtref
      -- Check that GPART is OK
      if( badref(!gPartRef)) then
        return false
      endif
    endif
  endif

  -- if reference is to a selection table, make sure that it is loaded and initialised
  if( !tableItem.set() ) then
    -- make sure that table is loaded and selected
    !class  = !tableItem.owner.owner.string()
    !this.selectHoleClass(!class)
    !cTable = !tableItem.owner
    !this.selectHoleType(!cTable)
    !index  = !this.gPartRText.findFirst(!tableItem.string())
    !this.selectedHoleClassPurpose = !cTable.owner.purpose
  else
    !this.selectHoleClass('STANDARD')
    !index  = !this.gPartRText.findFirst(!gPartRef.string())
    !this.selectedHoleClassPurpose = ''
  endif

  -- find replacement text to get selection index
  return !this.select(!index)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      parameters
--
-- Description: Return parameter list keys for current selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of parameter keys (DKEYS)
--
------------------------------------------------------------------------
define method .parameters() is ARRAY

  if( !this.isSelected() ) then
    return !this.holeParts[!this.selected].parameters()
  else
    return ARRAY()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getUserParameters
--
-- Description: Return parameter list keys for current selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of parameter keys (DKEYS)
--
------------------------------------------------------------------------
define method .getUserParameters() is ARRAY

  if( !this.isSelected() ) then
    return !this.holeParts[!this.selected].getUserParameters()
  else
    return ARRAY()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      parameterTitle
--
-- Description: Return parameter title of current selection for given parameter key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter key
-- Return:
--   [Data Type] [Description]
--    STRING      Parameter title
--
------------------------------------------------------------------------
define method .getParameterTitle(!key is STRING) is STRING

  if( !this.isSelected() ) then
    return !this.holeParts[!this.selected].getParameterTitle(!key)
  else
    return ''
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      parameterDefault
--
-- Description: Return parameter default of current selection for given parameter key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter key
-- Return:
--   [Data Type] [Description]
--    REAL       Default parameter value
--
------------------------------------------------------------------------
define method .getParameterDefault(!key is STRING) is REAL

  if( !this.isSelected() ) then
    return !this.holeParts[!this.selected].getParameterDefault(!key)
  else
    return object REAL()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getLastParameterValue
--
-- Description: Return last parameter value of current selection for given parameter key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter key
-- Return:
--   [Data Type] [Description]
--    REAL       Last parameter value
--
------------------------------------------------------------------------
define method .getLastParameterValue(!key is STRING) is REAL

  if( !this.isSelected() ) then
    return !this.holeParts[!this.selected].getLastParameterValue(!key)
  else
    return object REAL()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLastParameterValue
--
-- Description: Set last parameter value of current selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       design parameters
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLastParameterValue(!parameters is ARRAY)

  if( !this.isSelected() ) then
    !this.holeParts[!this.selected].setLastParameterValue(!parameters)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLastParameterValue
--
-- Description: Copy parameter value of current selection from given hole type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      HMHOLETYPE  Hole type definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLastParameterValue(!holeDefinition is HMHOLETYPE)

  if( !this.isSelected() ) then
    !this.holeParts[!this.selected].setLastParameterValue(!holeDefinition)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hasCoaming
--
-- Description: Returns TRUE if selected hole type has coaming
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if this has coaming
--
------------------------------------------------------------------------
define method .hasCoaming() is BOOLEAN

  if( !this.isSelected() ) then
    return !this.holeParts[!this.selected].hasCoaming()
  else
    return false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSelectedHoleClass
--
-- Description: Get current hole class
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING     Description of current selected hole class
--
------------------------------------------------------------------------
define method .getSelectedHoleClass() is STRING

  return !this.selectedClass

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSelectedHoleType
--
-- Description: Get current hole type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Description for current selected hole type
--
------------------------------------------------------------------------
define method .getSelectedHoleType() is STRING

  return !this.selectedType

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getHoleClassReferences
--
-- Description: Get list of hole class references
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       String references for RTEXT
--
------------------------------------------------------------------------
define method .getHoleClassReferences(!purpose is STRING) is ARRAY

  !this.selectedHoleClassPurpose = !purpose

  -- return selection table references for gadget replacement text and selection in this object
  return !this.getHoleClassReferences()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getHoleClassReferences
--
-- Description: Get list of hole class references
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       String references for RTEXT
--
------------------------------------------------------------------------
define method .getHoleClassReferences() is ARRAY

  !result  = ARRAY()
  !purpose = !this.selectedHoleClassPurpose

  do !index indices !this.holeClassTables
    skip if( !this.holeClassTables[!index].purpose.upcase() neq !purpose.upcase() )
    !result.append(!this.holeClassReferences[!index])
  enddo

  -- return selection table references for gadget replacement text and selection in this object
  return !result

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getHoleClassDescriptions
--
-- Description: Get list of hole class descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       String descriptions for DTEXT
--
------------------------------------------------------------------------
define method .getHoleClassDescriptions(!purpose is STRING) is ARRAY

  !this.selectedHoleClassPurpose = !purpose

  -- return selection table descriptions for gadget display text and selection in this object
  return !this.getHoleClassDescriptions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getHoleClassDescriptions
--
-- Description: Get list of hole class descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       String descriptions for DTEXT
--
------------------------------------------------------------------------
define method .getHoleClassDescriptions() is ARRAY

  !result = ARRAY()
  !purpose = !this.selectedHoleClassPurpose
  do !index indices !this.holeClassTables
    skip if( !this.holeClassTables[!index].purpose.upcase() neq !purpose.upcase() )
    !result.append(!this.holeClassDescriptions[!index])
  enddo

  -- return selection table descriptions for gadget display text and selection in this object
  return !result

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialiseTables
--
-- Description: Initialise table selection gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseTables()

  -- Set selection tables
  -- Find tables matching specified application and purpose
  -- collection object not working across DB types, so use OLD SYNTAX
  VAR !holeClasses COLLECT ALL TABGRO WITH ( MATCHWILD(PURP,'?PEN') )
  -- store information to be used as gadget display and replacement text
  !this.holeClassTables       = ARRAY()
  !this.holeClassDescriptions = ARRAY()
  !this.holeClassReferences   = !holeClasses
  do !holeClass values !this.holeClassReferences
    !this.holeClassTables.append(!holeClass.dbref())
    !this.holeClassDescriptions.append(!holeClass.dbref().description.trim())
  enddo

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      selectHoleClass
--
-- Description: Select hole class and initialise hole types for that class
--              Note that hole classes are only loaded from the catalogue
--              when first used to improve performance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole class name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectHoleClass(!selectedClass is STRING)

  if( !selectedClass eq 'STANDARD' ) then
    -- standard legacy hole types
    !this.selectedClass = 'STANDARD'
  elseif( !selectedClass eq 'TMPL' ) then
    -- user defined boundary type
    !this.selectedClass = 'TMPL'
  else
    -- user defined from selection table
    !selectionIndex     = !this.holeClassReferences.findFirst(!selectedClass)
    if( not defined(!this.holeSelectionTables[!selectionIndex]) ) then
      -- selection table not loaded - load from catalogue
      !this.holeSelectionTables[!selectionIndex] = object SELECTIONTABLE(!this.holeClassTables[!selectionIndex])
      -- each table may have sub-tables (CTABLEs) for penetration types
      !this.holeTypes[!selectionIndex] = !this.holeSelectionTables[!selectionIndex].getTypes()
    endif

    !this.selectedClass     = !selectedClass
    !this.selectedHoleClass = !selectionIndex

  endif

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      selectHoleType
--
-- Description: Select type (CTABLE) using the CTABLE description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole type name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectHoleType(!selectedType is STRING)

  if( !this.holeTypeLoaded(!selectedType).not() ) then
    -- load hole type from the catalogue
    !this.loadHoleType(!selectedType)
  else
    -- set type in the class selection table object
    !this.holeSelectionTables[!this.selectedHoleClass].setType(!selectedType)
  endif

  -- return list of holes of this type
  !this.selectedHoleTypes = !this.holeGroups.find(!selectedType)
  !this.selectedType      = !selectedType

  -- clear individual selection
  !this.selected          = 0

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      selectHoleType
--
-- Description: Select type (CTABLE) using CTABLE DBREF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of CTABLE in the current class
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectHoleType(!cTable is DBREF)

  !description = !cTable.description
  !this.selectHoleType(!description)

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      holeTypeLoaded
--
-- Description: Search the hole group list to see if this type is loaded
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole type name
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if already loaded
--
------------------------------------------------------------------------
define method .holeTypeLoaded(!selectedType is STRING) is BOOLEAN

  return !this.holeGroups.findFirst(!selectedType).set()

endmethod
-- End of method definition

----------------------------------------------------------------------
--
-- Method:      loadHoleType
--
-- Description: Load hole type from the catalogue
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hole type name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadHoleType(!selectedType is STRING)

  -- set type in the class selection table object
  !this.holeSelectionTables[!this.selectedHoleClass].setType(!selectedType)
  !questions = !this.holeSelectionTables[!this.selectedHoleClass].getQuestions()

  do !tableItem values !this.holeSelectionTables[!this.selectedHoleClass].items
    skip if( !tableItem.lActive.not() )
    skip if( badref( !tableItem.prtref ) )
    !holePart = object HMHOLETYPE(!tableItem)
    skip if(!holePart.loaded().not())
    !holePart.setQuestions(!questions)
    !answers = ARRAY()
    -- Get answers for each question
    do !ind indices !tableItem.members
      !answers.append(!this.holeSelectionTables[!this.selectedHoleClass].getAnswer(!tableItem, !ind))
    enddo
    !holePart.setAnswers(!answers)
    !this.holeParts.append(!holePart)
    !this.gPartRText.append(!holePart.getReplacementText())
    !this.gPartText.append(!holePart.getDisplayText())
    !this.holeGroups.append(!selectedType)
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getQuestions
--
-- Description: Get questions for selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of string questions for selected type
--
------------------------------------------------------------------------
define method .getQuestions() is ARRAY

  return !this.holeSelectionTables[!this.selectedHoleClass].getQuestions()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getUniqueAnswers
--
-- Description: Get unique answers to given question for selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Question number
-- Return:
--   [Data Type] [Description]
--    ARRAY       of string unique answers to given question for selected type
--
------------------------------------------------------------------------
define method .getUniqueAnswers(!questionNumber is REAL) is ARRAY

  !answers = ARRAY()
  -- loop thro selected hole parts to get answers to the question
  do !index values !this.selectedHoleTypes
    !answers.append(!this.holeParts[!index].getAnswer(!questionNumber))
  enddo

  !answers.unique()

  return !answers

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      choose()
--
-- Description: Select components that conform to the given criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Questions
--    2   R      ARRAY       Answers to questions
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choose(!questions is ARRAY, !answers is ARRAY)

  if( !questions.empty() ) then
    !choiceTableItems = !this.holeSelectionTables[!this.selectedHoleClass].choose(object DBREF(), |TEXT|, false)
  else
    !choiceTableItems = !this.holeSelectionTables[!this.selectedHoleClass].choose(object DBREF(), !questions, !answers, |TEXT|, false)
  endif

  !selected = ARRAY()
  do !tableItem values !choiceTableItems
    !index = !this.gPartRText.findFirst(!tableItem[1].string())
    if( !index.set() ) then
      !selected.append(!index)
    endif
  enddo

  !this.holeChooseList = !selected

endmethod

------------------------------------------------------------------------
--
-- Method:      getChooseRText
--
-- Description: Get replacement text of selection gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      of string Reference for hole GPART
--
------------------------------------------------------------------------
define method .getChooseRText() is ARRAY

  !return     = ARRAY()
  do !holePartIndex values !this.holeChooseList
    !return.append(!this.gPartRText[!holePartIndex])
  enddo
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getChooseDText
--
-- Description: Get display text of selection gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      of string Description for hole GPART
--
------------------------------------------------------------------------
define method .getChooseDText() is ARRAY

  !return     = ARRAY()
  do !holePartIndex values !this.holeChooseList
    !return.append(!this.gPartText[!holePartIndex])
  enddo
  return !return

endmethod
-- End of method
