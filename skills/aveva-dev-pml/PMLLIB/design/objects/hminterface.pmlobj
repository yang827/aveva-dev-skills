--   Type:          Object Definition
--   Group:
--     Keyword:     Hole Management
--   Module:        All
-- Author:          R.Thompson
--  Created:         Wed Aug  8 14:45:23 2007
--
--  Description:     Object providing the external API for the Hole Management system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createAccomHole(ARRAY,POSITION)  BOOLEAN             Deal with a request for a new managed hole by ACCOM appware
--  createCWayHole(ARRAY,POSITION)   BOOLEAN
--  createDuctHole(ARRAY,POSITION)   BOOLEAN             Deal with a request for a new managed hole by HVAC appware
--  createPipeHole(ARRAY,POSITION)   BOOLEAN             Deal with a request for a new managed hole by PIPE appware
--  createStruHole(ARRAY,POSITION)   BOOLEAN             Deal with a request for a new managed hole by Structural appware
--  createTrayHole(ARRAY,POSITION)   BOOLEAN             Deal with a request for a new managed hole by (old)cable tray appware
--  hmInterface()                    -
--  removeManagedHole(HMHOLE)        BOOLEAN             Remove an unwanted managed hole
--  submitRequest(HMHOLE)            BOOLEAN             Submit a request to the other discipline for the managed hole
--
------------------------------------------------------------------------

define object HMINTERFACE

  member .hmControl is HMCONTROL
  member .debug     is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      debug
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmInterface()

-- Control output of additional messages to command window for debugging
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      createPipeHole
--
-- Description: Deal with a request for a new managed hole by PIPE appware
--              NOTE: First element in "members" array will be used as
--                    the "hole owner" (i.e. the penetrated item)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPipeHole(!members is ARRAY, !origin is POSITION) is BOOLEAN


-- if required carry out further data validation checks here


-- Call the relevant method and return the result
  return !this.hmControl.createNewHole(!members, !origin, 'PIPE')

endmethod
-- End of method


------------------------------------------------------------------------
