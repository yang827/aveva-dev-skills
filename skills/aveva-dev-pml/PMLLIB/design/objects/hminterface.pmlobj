------------------------------------------------------------------------
--
-- Method:      removeManagedHole
--
-- Description: Attempt to remove an unwanted managed hole
--              (HM system will decide if allowable or not)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeManagedHole(!item is HMHOLE) is BOOLEAN

  return !this.hmControl.removeManagedHole(item)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      submitRequest
--
-- Description: Submit a request to the other discipline for the managed hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .submitRequest(!item is HMHOLE) is BOOLEAN

  return !this.hmControl.submitRequest(item)

endmethod
-- End of method
