-- Created:
--
-- Description:
--    Penetration data for merged penetration
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addPenetration(HMPENETRATIONDATA) -                   Append HMPENETRATION penetration to secondary list
--  addPenetrations(ARRAY)           -                   Append list of HMPENETRATION penetrations to secondary list
--  averagePosition()                POSITION            Calculate average position of all penetrations
--  centredPosition(BOOLEAN)         -                   Tells .createVirtualFixing to find a position
--  clear()                          -                   Clear penetrations list
--  createCoaming(DBREF)             DBREF               apply coaming to hole
--  createVirtualFixing(DBREF)       DBREF               Create virtual FIXING and FRMW for this penetration
--  drawAxes(REAL)                   -                   Draw aid lines showing axes for this penetration
--  editProfile()                    BOOLEAN             callback to show loop editor for free hole boundary
--  fitProfile(DBREF)                -                   Fit convex hull profile around the sub fixings
--  getItemList()                    ARRAY               Get list of elements in this penetration in an array
--  getPosition()                    POSITION            Get position of penetration
--  getVirtualDesignParameters()     ARRAY
--  getVirtualHole()                 DBREF               Get virtual hole (fixing) DBREF
--  getVirtualSpref()                DBREF               Get virtual spref
--  hmMergedPenetration()            -                   Constructor
--  hmVirtualPenetration(DBREF)      -
--  modifyPosition(BOOLEAN)          -                   Tells .modifyVirtualFixing to recalculate its position
--  modifyVirtualFixing()            DBREF               Modify virtual penetration and FIXING for this penetration
--  projectProfileToPlane(PROFILE,PLANE) PROFILE             Projects a profile onto a given plane, using a chordal approximation for the curves
--  setAngle(REAL)                   -                   Sets angle of rotation
--  setClearance(REAL)               -                   Sets clearance for all members of this merged penetration
--  setCoamingJustification(STRING)  -                   Set side of plate for coaming (FRONT/BACK)
--  setCreated(BOOLEAN)              -                   Tell the object if its penetration data represents existing fixings
--  setGap(REAL)                     -                   Sets penetration offset
--  setHoleType(HMHOLETYPE)          -                   set object defining hole to be created
--  setMasterPenetration(HMPENETRATIONDATA) -                   Set HMPENETRATION data to be used as the master penetration
--  setOffset(REAL,REAL)             -                   Sets penetration offset
--  setPlane(PLANE)                  -                   Sets the plane for the virtual penetration
--  updateCoaming()                  -                   Update any hole coaming (marine only)
--  updateFreeHoleProfile(DBREF)     -                   Update TMPL and EXTR element for free hole boundary
--

------------------------------------------------------------------------

define object HMMERGEDPENETRATION

  -- Master penetration data - holds Virtual hole details and first sub-fixing
  member .masterPenetrationData is HMPENETRATIONDATA
  -- Array of HMPENETRATIONDATA for this virtual penetration for second and subsequent sub-fixings
  member .multiPenetrationData  is ARRAY

  -- Hole type definition for this hole
  member .holeDefinition       is HMHOLETYPE
  -- clearance value
  member .clearance            is REAL
  -- angle of rotation
  member .angle                is REAL
  -- X & Y offset
  member .xOffset              is REAL
  member .yOffset              is REAL
  -- Virtual Penetration Fixing (the owner fixing)
  member .virtualHoleRef       is DBREF
  -- Virtual Penetration Fixing (the sub-fixing)
  member .virtualPenetration   is DBREF
  -- Database item where the fixing will be created
  member .virtualStorageArea   is DBREF
  -- Coaming Fixing DBREF
  member .coamingFixing        is DBREF
  -- Created set true when merged hole has been created. False before create method called
  member .created              is BOOLEAN
  -- If true, tells the next call to .modifyVirtualFixing to recalculate the position
  member .recalculatePosition  is BOOLEAN
  -- If true, the position of the merged penetration is centred on the penetrating items
  -- If false, the given offsets are used from the master penetration
  member .centredPosition      is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      hmMergedPenetration
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmMergedPenetration()

  -- Initialise Variables
  !this.clearance           = 0
  !this.xOffset             = 0
  !this.yOffset             = 0
  !this.angle               = 0
  !this.created             = false
  !this.recalculatePosition = false
  !this.centredPosition     = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hmMergedPenetration
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       build from existing merged penetration
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hmVirtualPenetration(!virtualPenetration is DBREF)

  -- Initialise Variables
  !this.hmVirtualPenetration()
  -- set penetration data
  !this.virtualPenetration = !virtualPenetration

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMasterPenetration
--
-- Description: Set HMPENETRATION data to be used as the master penetration
--              This clears the list of secondary penetrations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      HMPENETRATIONDATA  Object for master penetrating item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMasterPenetration(!penetrationData is HMPENETRATIONDATA)

  !this.clear()
  !this.masterPenetrationData = !penetrationData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addPenetrations
--
-- Description: Append list of HMPENETRATION penetrations to secondary list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      of HMPENETRATIONDATA Objects
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addPenetrations(!penetrationData is ARRAY)

  if( !this.created ) then
    -- this merged hole already created - need to process new penetration data
    do !index indices !penetrationData
      !this.addPenetration(!penetrationData[!index])
    enddo
  else
    -- merged hole not created yet - just add to list
    !this.multiPenetrationData.appendArray(!penetrationData)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addPenetration
--
-- Description: Append HMPENETRATION penetration to secondary list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]        [Description]
--    1   R      HMPENETRATIONDATA  Object for new penetrating item
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addPenetration(!penetrationData is HMPENETRATIONDATA)

  if( !this.created ) then

    -- this merged hole already created - need to process new penetration data
    !this.multiPenetrationData.append(!penetrationData)
    !index = !this.multiPenetrationData.maxIndex()
    -- set reference for this penetration
    !this.multiPenetrationData[!index].setVirtualPenetration(!this.virtualHoleRef)
    -- create sub-fixing
    !subFixing = !this.multiPenetrationData[!index].createPenetratingFixing(!this.virtualHoleRef)
    !this.multiPenetrationData[!index].calculatePenetratingAttributes()
    -- modify sub-fixing attributes
    !this.multiPenetrationData[!index].setPenetratingFixingAttributes(!subFixing)
    -- fit a new profile to the hole
    if( !this.masterPenetrationData.holeDefinition.isFreeHole() ) then
      !this.updateFreeHoleProfile(!this.masterPenetrationData.getVirtualHole())
    endif

  else

    -- merged hole not created yet - just add to list
    !this.multiPenetrationData.append(!penetrationData)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Clear penetrations list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.multiPenetrationData = ARRAY()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCreated
--
-- Description: Tell the object if its penetration data represents existing fixings
--              i.e. modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True to tell the object that its penetration data
--                           represents existing fixings. False for new data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCreated(!created is BOOLEAN)

  !this.created = !created
  if(!created) then
    -- set necessary variables from existing data
    !this.virtualHoleRef = !this.masterPenetrationData.getVirtualHole()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getItemList
--
-- Description: Get list of elements in this penetration in an array
--              suitable for HMCONTROL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of item DBREFs in HMCONTROL format
--
------------------------------------------------------------------------
define method .getItemList()is ARRAY

  -- Get items from master penetration first
  !itemList      = !this.masterPenetrationData.getItemList()

  -- get data from other penetrations
  do !index indices !this.multiPenetrationData
    -- penetrated and virtual hole ref not needed
    !tempItemList = !this.multiPenetrationData[!index].getItemList().from(2)
    !tempItemList.remove(3)
    !itemList.appendArray(!tempItemList)
  enddo

  return !itemList

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getVirtualHole
--
-- Description: Get virtual hole (fixing) DBREF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       virtual hole DBREF
--
------------------------------------------------------------------------
define method .getVirtualHole() is DBREF

  return !this.masterPenetrationData.getVirtualHole()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getVirtualSpref
--
-- Description: Get virtual spref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       virtual spref
--
------------------------------------------------------------------------
define method .getVirtualSpref() is DBREF

  return !this.masterPenetrationData.getVirtualSpref()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setHoleType()
--
-- Description: set object defining hole to be created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      HMHOLETYPE   Hole type definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHoleType(!holeDefinition is HMHOLETYPE)

  !this.holeDefinition = !holeDefinition
  !this.masterPenetrationData.setHoleType(!holeDefinition)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getPosition
--
-- Description: Get position of penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Penetration position
--
------------------------------------------------------------------------
define method .getPosition() is POSITION

  return !this.masterPenetrationData.position

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setClearance()
--
-- Description: Sets clearance for all members of this merged penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Clearance value applied to all penetrating items
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setClearance(!clearance is REAL)

  !this.clearance = !clearance
  !this.masterPenetrationData.setClearance(!clearance)
  do !index indices !this.multiPenetrationData
    !this.multiPenetrationData[!index].setClearance(!clearance)
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPlane()
--
-- Description: Sets the plane for the virtual penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Plane of virtual penetration
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPlane(!plane is PLANE)

  !this.masterPenetrationData.setPlane(!plane)
  do !index indices !this.multiPenetrationData
    !this.multiPenetrationData[!index].setPlane(!plane)
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setAngle()
--
-- Description: Sets angle of rotation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation of virtual hole fixing
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAngle(!angle is REAL)

  !this.angle = !angle

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      setOffset()
--
-- Description: Sets penetration offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset in X direction
--    2   R      REAL        Offset in Y direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOffset(!xOffset is REAL, !yOffset is REAL)

  !this.xOffset = !xOffset
  !this.yOffset = !yOffset

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      setGap()
--
-- Description: Sets penetration offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Gap for cable way penetration
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGap(!gap is REAL)

  !this.masterPenetrationData.setGap(!gap)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setCoamingJustification()
--
-- Description: Set side of plate for coaming (FRONT/BACK)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      FRONT or BACK
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCoamingJustification(!justify is STRING)

  !this.masterPenetrationData.setCoamingJustification(!justify)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyPosition()
--
-- Description: Tells .modifyVirtualFixing to recalculate its position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Position reset if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyPosition(!resetPosition is BOOLEAN)

  !this.recalculatePosition = !resetPosition

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      centredPosition()
--
-- Description: Tells .createVirtualFixing to find a position
--              centred on the collection of penetrating items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Position centred if true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .centredPosition(!centredPosition is BOOLEAN)

  !this.centredPosition = !centredPosition

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getDesignParameters()
--
-- Description: Returns design parameters for this penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of fixing design parameters
--
------------------------------------------------------------------------
define method .getVirtualDesignParameters() is ARRAY

  return !this.masterPenetrationData.getVirtualDesignParameters()

endmethod
-- End of method definition for .getDesignParameters()

------------------------------------------------------------------------
--
-- Method:      .modifyVirtualFixing()
--
-- Description: Modify virtual penetration and FIXING for this penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of FRMW element for the new fixing
--
------------------------------------------------------------------------
define method .modifyVirtualFixing() is DBREF

  -- force set the merged penetration position and apply rotation and offset
  !this.masterPenetrationData.setAngle(!this.angle)
  !this.masterPenetrationData.setOffset(!this.xOffset,!this.yOffset)
  -- recalculate the centred position only if centred positioning is allowed and
  -- the user has asked for it to be recalculated after adding a new penetrating item
  if( !this.recalculatePosition and !this.centredPosition ) then
    !this.masterPenetrationData.setPosition(!this.averagePosition())
  endif
  -- this is a one shot setting - set it to false
  !this.recalculatePosition = false
  -- set the virtual fixing Design Parameters
  !this.masterPenetrationData.setHoleType(!this.holeDefinition)

  -- calculate requirements of the penetrating item - shape, dimensions, clearance
  !this.masterPenetrationData.modifyVirtualFixing()

  -- force secondary sub-fixings to stay in place otherwise they are moved by offset and rotate
  do !index indices !this.multiPenetrationData

    !subFixing = !this.multiPenetrationData[!index].getVirtualPenetration()
    -- modify sub-fixing attributes
    !this.multiPenetrationData[!index].calculatePenetratingAttributes()
    !this.multiPenetrationData[!index].setPenetratingFixingAttributes(!subFixing)

  enddo

  -- fit a new profile to the hole
  if( !this.masterPenetrationData.holeDefinition.isFreeHole() ) then
    !this.updateFreeHoleProfile(!this.masterPenetrationData.getVirtualHole())
  endif

  return !this.virtualHoleRef

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      .createVirtualFixing()
--
-- Description: Create virtual FIXING and FRMW for this penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of STRU owning this penetration
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of FRMW element for the new fixing
--
------------------------------------------------------------------------
define method .createVirtualFixing(!storageArea is DBREF) is DBREF

  -- clear any existing hole reference
  !this.virtualPenetration = object DBREF()
  !this.virtualStorageArea = !storageArea

  -- recalculate virtual hole position now that all sub-fixings are created
  if( !this.multiPenetrationData.empty().not() ) then
    -- find out the average hole position
    !pos = !this.averagePosition()
    -- now force set the merged penetration position and apply rotation and offset
    !this.masterPenetrationData.setAngle(!this.angle)
    !this.masterPenetrationData.setOffset(!this.xOffset,!this.yOffset)
    if( !this.centredPosition ) then
      -- find out the average hole position
      !pos = !this.averagePosition()
      !this.masterPenetrationData.setPosition(!pos)
    endif
  endif

  !returnRef           = !this.masterPenetrationData.createVirtualFixing(!storageArea)
  !this.virtualHoleRef = !this.masterPenetrationData.getVirtualHole()

  -- create secondary sub-fixings
  do !index indices !this.multiPenetrationData

    -- set reference for this penetration
    !this.multiPenetrationData[!index].setVirtualPenetration(!this.virtualHoleRef)

    -- create sub-fixing
    !subFixing = !this.multiPenetrationData[!index].createPenetratingFixing(!this.virtualHoleRef)

    !this.multiPenetrationData[!index].calculatePenetratingAttributes()

    -- modify sub-fixing attributes
    !this.multiPenetrationData[!index].setPenetratingFixingAttributes(!subFixing)

  enddo

  -- fit a new profile to the hole
  if( !this.masterPenetrationData.holeDefinition.isFreeHole() ) then
    !this.updateFreeHoleProfile(!this.masterPenetrationData.getVirtualHole())
  endif

  -- record state of this merged penetration
  !this.created = true

  return !returnRef

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      .averagePosition()
--
-- Description: Calculate average position of all penetrations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of STRU owning this penetration
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of FRMW element for the new fixing
--
------------------------------------------------------------------------
define method .averagePosition() is POSITION

  -- recalculate virtual hole position now that all sub-fixings are created
  if( !this.multiPenetrationData.empty().not() ) then

    -- find out the average hole position
    !pos          = !this.masterPenetrationData.getPosition().wrt(world)
    !xPosition    = !pos.east
    !yPosition    = !pos.north
    !zPosition    = !pos.up
    do !index indices !this.multiPenetrationData
       !pos       = !this.multiPenetrationData[!index].getPosition().wrt(worl)
       !xPosition = !xPosition + !pos.east
       !yPosition = !yPosition + !pos.north
       !zPosition = !zPosition + !pos.up
    enddo
    !averageCount = !this.multiPenetrationData.size() + 1
    !xPosition    = (!xPosition / !averageCount)
    !yPosition    = (!yPosition / !averageCount)
    !zPosition    = (!zPosition / !averageCount)
    !pos.east     = !xPosition
    !pos.north    = !yPosition
    !pos.up       = !zPosition

  else

    -- return current master position
    !pos = !this.masterPenetrationData.getPosition()

  endif

  return !pos

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .updateFreeHoleProfile()
--
-- Description: Update TMPL and EXTR element for free hole boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of virtual hole FIXING element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateFreeHoleProfile(!virtualHole is DBREF)

  !safeCE = !!ce
  !!ce     = !virtualHole

  -- Get penetrated item thickness
  !plateThickness = !this.masterPenetrationData.getPenetratedThickness()
  -- Calculate the thickness of the display graphics for the virtual hole
--  if (!plateThickness.lt(50mm)) then
--    !factor = 2
--  else
--    !factor         = ( 100mm / !plateThickness )
--    if (!factor.lt(0.1)) then
--      !factor = 0.1
--    endif
--  endif
--  !thickness      =  (!plateThickness + (!plateThickness * ( !factor * 2 )))
  !thickness      =  !plateThickness * 2

  !templateCount = !virtualHole.mcount('TMPL')
  if( !templateCount eq 0 ) then
    NEW TMPL
    NEW EXTR
    !!ce.height = !thickness
    NEW LOOP
  else
    TMPL 1
    EXTR 1
    handle any
      NEW EXTR
    endhandle
    !!ce.height = !thickness
    LOOP 1
    handle any
      NEW LOOP
    endhandle
    DELETE LOOP MEMBER
  endif

  !this.fitProfile(!!ce)

  -- move extrusion to be centred on the FIXING position which should be in the middle of the plate
  EXTR
  MOVE P2 OF VERT 1 OF LOOP 1 UP WRT FIXING THROUGH FIXING
  !extrusion = object DBEGEXTRUSION(!!ce)
  handle any
    !!ce = !safeCE
    handle any
      return
    endhandle
    return
  endhandle

  !extrusion.removeCoincident(FALSE)
  !!ce = !safeCE
  handle any
    return
  endhandle

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      .fitProfile()
--
-- Description: Fit convex hull profile around the sub fixings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of LOOP element where profile is created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fitProfile(!loopElement is DBREF)

  -- Find plane of the penetrated surface from the virtual hole
  !orientation      = !this.virtualHoleRef.ori
  !position         = !this.virtualHoleRef.pos
  !penetrationPlane = object PLANE(!position,!orientation)
  -- Merged Holes
  !data[1] = !!hmFindHoleProfile(!this.masterPenetrationData.getVirtualPenetration())
  do !index indices !this.multiPenetrationData
    -- Set up the data from the profiles of the sub fixings
    !data.append(!!hmFindHoleProfile(!this.multiPenetrationData[!index].getVirtualPenetration()))
  enddo
  -- Find out the plane of the owning fixing
  !plane    = !data[1].plane()
  -- Use the convexBoundary object to work out the profile
  !boundary = object CONVEXBOUNDARY()
  !boundary.add(!plane,!data)
  !profile = !boundary.profile()

  !projectedProfile = !this.projectProfileToPlane(!profile,!penetrationPlane)
  handle any
    !projectedProfile = !profile
  endhandle

  !projectedProfile.dbWrite(!loopElement)

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      .editProfile()
--
-- Description: callback to show loop editor for free hole boundary
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if loop editor shown
--
------------------------------------------------------------------------
define method .editProfile() is BOOLEAN

  -- find loop to edit
  !saveCE = !!ce

  !!ce    = !this.masterPenetrationData.getVirtualHole()
  LOOP 1 OF EXTR 1 OF TMPL 1
  handle any
    return false
  endhandle
  !loop   = !!ce

  !!ce    = !saveCE

  !!dbeLoopEdit(!loop,'EXTR')

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createCoaming
--
-- Description: apply coaming to hole
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of coaming storage area
-- Return:
--   [Data Type] [Description]
--    DBREF       of new coaming fixing or unset if none created
--
------------------------------------------------------------------------
define method .createCoaming(!coamingStorage is DBREF) is DBREF

  !this.coamingFixing = !this.masterPenetrationData.createCoaming(!coamingStorage)

  return !this.coamingFixing

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateCoaming
--
-- Description: Update any hole coaming (marine only)
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of coaming storage area
-- Return:
--   [Data Type] [Description]
--    DBREF       of new coaming fixing or unset if none created
--
------------------------------------------------------------------------
define method .updateCoaming()

  !this.masterPenetrationData.updateCoaming()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      drawAxes
--
-- Description: Draw aid lines showing axes for this penetration
--              The calling function must manage the aid lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number for this aid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawAxes(!aidNumber is REAL)

  !this.masterPenetrationData.drawAxes(!aidNumber)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      projectProfileToPlane()
--
-- Description: Projects a profile onto a given plane, using a chordal approximation for the curves
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to be mapped to the plane
--    2   R      PLANE       Plane to map profile to
-- Return:
--   [Data Type] [Description]
--    PROFILE     Mapped profile
--
------------------------------------------------------------------------
define method .projectProfileToPlane(!profile is PROFILE,!profilePlane is PLANE) is PROFILE

  -- check if the virtual fixing profile lies on the face, if not project it onto the face
  if ( NOT !profile.plane().orientation.zdir().isparallel(!profilePlane.orientation.zdir())) then

  !chordalApproximation = !profile.mergePoints().mergeLines().polyLine()
  !pvStart              = !profile.plane().pointVector()
  !pvEnd                = !pvStart
  !edgeArray            = ARRAY()
  do !edge values !chordalApproximation.edges()
    !pvStart.position   = !edge.startPosition
    !pvEnd.position     = !edge.endPosition
    !line               = object LINE(!profilePlane.intersection(!pvStart), !profilePlane.intersection(!pvEnd))
    !edgeArray.append(!line)
  enddo
  !projectedProfile = object PROFILE(!profilePlane.position,!profilePlane.orientation,!edgeArray)

  -- Check the profile is closed and use it on the loop
  if (!projectedProfile.isClosed().not()) then
    !projectedProfile.close()
  endif

  return !projectedProfile

  else

    return !profile

  endif

endmethod
-- End of method definition
