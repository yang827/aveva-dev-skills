-- File:          hmpenetratedcontrol.pmlobj
-- Type:          Form Definition
-- Group:         General Application
-- Keyword:       Penetration
-- Module:        Design
--
-- Description:
-- Shared control for selecting penetrated objects
--
--  Author:          Undefined
--  Created:         Mon Jan 28 10:46:44 2008
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hmPenetratedControl()            -                   Constructor
--  initialise(GADGET)               -
--  isSet()                          BOOLEAN             Return true if penetrated item is set
--  planarPenetratedOrientation()    ORIENTATION         Returns the penetrated orientation if the target panel is
--  setPenetrated(DBREF,POSITION,PLANE) -                   Process data from penetrated items pick
--  tidy()                           -                   Tidy up state of this control
--  updatePenetrated()               -                   Update penetrated items list and highlight penetrated items
--
------------------------------------------------------------------------
--

define object HMPENETRATEDCONTROL

  -- List of picked penetrated elements
  member .penetratedRaw          is ARRAY
  -- List of penetrated items
  member .penetrated             is ARRAY
  -- List of elements highlighted
  member .enhancePenetrated      is ARRAY

  -- Penetration geometry
  member .penetratedPosition     is POSITION
  member .panelPosition          is POSITION
  member .plateThickness         is REAL
  member .penetratedDirection    is DIRECTION
  member .plane                  is PLANE
  member .pickedItem             is DBREF

  -- form list gadget to update
  member .listGadget             is GADGET

endobject

------------------------------------------------------------------------
--
-- Method:      .hmPenetratedControl()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .hmPenetratedControl()

  !this.penetrated.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget to be updated with current penetrated list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise( !gadget is GADGET )

  -- Initialise penetrated element list
  !this.penetrated.clear()
  !this.penetratedRaw.clear()
  !this.enhancePenetrated.clear()
  !this.listGadget = !gadget
  !gadget.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      .tidy()
--
-- Description: Tidy up state of this control
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .tidy()

  !enhanceList = !this.enhancePenetrated
  UNENHANCE ALL FROM !enhanceList
  handle any
  endhandle

endmethod

----------------------------------------------------------------------
--
-- Method:      .setPenetrated()
--
-- Description: Process data from penetrated items pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .setPenetrated(!item is DBREF, !position is POSITION, !plane is PLANE)

  !this.penetratedRaw[1] = !item
  !this.pickedItem       = !item

  -- set penetrating data for each type of penetrated object
  if( !item.hardType eq 'HPLATE' ) then
    !this.plateThickness = !item.thickness
    if (!item.knuckl) then
      -- knuckled panel - must have a picked face
      if(!plane.unset()) then
        !!alert.error('Please Pick a facet')
        return
      endif
      !this.penetratedDirection = !plane.direction()
      !this.panelPosition       = !plane.position
    else
      -- planar hull panel
      !this.panelPosition       = !item.position.wrt(worl)
      !plane                    = object PLANE(!this.panelPosition, !item.orientation.wrt(worl))
      !this.penetratedDirection = !item.ori.zdir().wrt(worl)
    endif
    -- add the HPANEL
    !this.penetrated[1]       = !item.owner
  elseif( !item.hardType eq 'CPLATE' ) then
    -- curved plate
    if(!plane.unset()) then
      !!alert.error('Please Pick a facet')
      return
    endif
    !this.plateThickness      = !item.thickness
    !this.penetratedDirection = !plane.direction()
    !this.panelPosition       = !plane.position
    -- add the CPANEL
    !this.penetrated[1]       = !item.hrdprx[1]
  else
    -- outfitting panel
    !this.plateThickness      = !item.lohe
    -- put plane on top face, allowing for loop justification
    !vertex                   = object DBREF('PAVE 1 OF PLOOP 1 OF $!<item>')
    !this.panelPosition       = !vertex.ppos[3].wrt(worl)
    !plane                    = object PLANE(!this.panelPosition, !item.orientation.wrt(worl))
    !this.penetratedDirection = !item.ori.zdir().wrt(worl)
    !this.penetrated[1]       = !item
  endif

  -- store the penetrated position and plane of penetrated item
  !this.penetratedPosition    = !position
  !this.plane                 = !plane
  !this.updatePenetrated()

endmethod

------------------------------------------------------------------------
--
-- Method:      .updatePenetrated()
--
-- Description: Update penetrated items list and highlight penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .updatePenetrated()

  !dText                  = ARRAY()
  !rText                  = ARRAY()
  !oldList                = !this.enhancePenetrated
  !this.enhancePenetrated = ARRAY()

  -- unenhance old list
  UNENHANCE ALL FROM !oldList

  do !item values !this.penetrated
    !dText.append(!item.fullname)
    !rText.append(!item.string())
    -- to avoid bug where HPANEL cannot be highlighted
    if( !item.hardType eq 'HPANEL' ) then
      var !temp COLL ALL HPLATE FOR $!item
      !this.enhancePenetrated.appendArray(!temp)
    elseif( !item.hardType eq 'CPANEL' ) then
      var !temp COLL ALL CPLATE FOR $!item
      !this.enhancePenetrated.appendArray(!temp)
    else
      !this.enhancePenetrated.append(!item.string())
    endif
  enddo

  !this.listGadget.dText = !dText
  !this.listGadget.rText = !rText

  -- enhance new list
  !enhance = !this.enhancePenetrated
  ENHANCE ALL FROM !enhance COL 2

endmethod

------------------------------------------------------------------------
--
-- Method:      .isSet()
--
-- Description: Return true if penetrated item is set
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .isSet() is BOOLEAN

  return !this.penetrated.empty().not()

endmethod

------------------------------------------------------------------------
--
-- Method:      planarPenetratedOrientation()
--
-- Description: Returns the penetrated orientation if the target panel is
--              planar. Required to calculate initial orientation of a
--              virtual hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   ORIENTATION  ORI if planar panel. Unset if ORI cannot be determined
--
------------------------------------------------------------------------
define method .planarPenetratedOrientation() is ORIENTATION

  -- initialise return variable for non-planar object
  !orientation    = object ORIENTATION()
  !penetrated     = !this.penetrated[1]
  !penetratedType = !penetrated.hardType
  handle any
    return !orientation
  endhandle
  -- special case for HPLATE
  if( !penetratedType eq 'HPLATE' ) then
    -- cannot get orientation for a knuckled panel
    if( !penetrated.knuckl.not() ) then
      !orientation = !penetrated.orientation
    endif
  endif
  if ( !penetratedType inset('PANE','HPANEL') ) then
    !orientation = !penetrated.orientation
  endif
  return !orientation

endmethod
-- End of method definition
