--
-- File:            hmrestriction.pmlobj
--   Type:          Object Definition
--   Group:
--     Keyword:     Hole Management
--   Module:        All
-- Author:          Ricky Thompson
--  Created:        13 December 2006
--
-- Description:
--   Object used to verify an association in the Hole Management system
--       1.  Check have at least 2 ASSMBRs
--       2.  Check all ASSMBRs have AMEMRF set


------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkMemberElements()            BOOLEAN             Make sure that at least two ASSMBR elements exist
--  gatherData()                     BOOLEAN             Collect all key information for member variables
--  hmRestriction()                  -                   Constructor method
--  testEv()                         BOOLEAN             Make sure that at least one ASSMBR exists and AMEMRF is set
--
------------------------------------------------------------------------

define object HMRESTRICTION

 -- ASSOCIATION = ASSOC element  (compulsory member)
 -- COMPONENT   = RESTRI element (compulsory member)
   member .association  is DBREF
   member .component    is DBREF

-- Additional members required to simplify processing
   member .hmHole       is HMHOLE

   member .debug        is BOOLEAN
endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      hmRestriction
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmRestriction()

  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      testEv
--
-- Description: Make sure that at least one ASSMBR exists and AMEMRF is set
--              Make sure that each ASSMBR has AMEMRF set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testEv() is BOOLEAN

-- Manually trigger the CONSTRUCTOR - does not get run automatically at the moment
  !this.hmRestriction()

-- Grab all relevant data for this association before starting
  !this.gatherData()

-- Basic check on quantity and type of members referenced
  if ( NOT !this.checkMemberElements() ) then
    if (!this.debug ) then
      write 'Failed check in hmRestriction.checkMemberElements()'
    endif
    return FALSE
  endif

-- Once all checks completed successfully...
  return TRUE

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      gatherData
--
-- Description: Collect all key information for member variables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatherData() is BOOLEAN

-- Gather all hole data for this association
  !this.hmHole = object HMHOLE(!this.association)


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      checkMemberElements
--
-- Description: Make sure that at least two ASSMBR elements exist
--              Make sure that each ASSMBR has the AMEMRF attribute set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkMemberElements() is BOOLEAN

-- 1.  Verify that at least two ASSMBR elements exist
  !total = 0
  if (!this.hmHole.primaryElement.set() and !this.hmHole.secondaryElements[1].set() ) then
    !total = 1 + !this.hmHole.secondaryElements.size()
  endif

  if (!total.lt(2) ) then
    if (!this.debug ) then
      write '$P Less than 2 ASSMBR found in hmRestriction.checkMemberElements()'
    endif
    !!setRestrictionError(!this.association, !this.component, |Not enough ASSMBR elements in the hole association|)
    return FALSE
  endif

-- 2.  Add conditional check to verify that each ASSMBR has a valid reference set
  !totalSet = 0
  if (NOT BADREF(!this.hmHole.primaryElement.amemrf) ) then
    !totalSet = 1
  endif
  !check = object COLLECTION()
  !check.addtype('ASSMBR')
  !check.scope(!this.hmHole.secondaryElements)
  !check.filter(object EXPRESSION(|not BADREF(AMEMRF)|) )
  !totalSet = !totalSet + !check.results().size()

-- Must be at least two ASSMBR and all ASSMBR must have AMEMRF set
  if ( !totalSet.neq(!total) ) then
    if (!this.debug ) then
      write 'One or more ASSMBR have invalid AMEMRF in hmRestriction.checkMemberElements()'
    endif
    !!setRestrictionError(!this.association, !this.component, |One or more ASSMBR elements have an invalid AMEMRF|)
    return FALSE
  endif
  !!setRestrictionError(!this.association, !this.component, |No Error|)
  return TRUE
endmethod
-- End of method
