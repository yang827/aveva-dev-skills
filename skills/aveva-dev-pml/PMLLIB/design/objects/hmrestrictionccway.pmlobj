--
-- File:            hmrestrictionccway.pmlobj
--   Type:          Object Definition
--   Group:
--     Keyword:     Hole Management
--   Module:        All
-- Author:          Martin Ward
--  Created:        April 2008
--
-- Description:
--   Object used to verify an association in the Hole Management system
--    1.  Loop all ASSMBRs
--    1.1.  Pull out position info for all RNODE, FIXING, DPCA and PFIT
--    2.  Check all node positions are same as FIXING pos
--    3.  Check PFIT pos is same as FIXING pos
--    4.  Check DPCA positions are same as penetration positions (nodes)

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkCoincident()                BOOLEAN             check the RNODE and fixing hierarchy are coincident
--  gatherData()                     -
--  hmRestrictionCCWay()             -                   Constructor method
--  testEv()                         BOOLEAN
--
------------------------------------------------------------------------

define object HMRESTRICTIONCCWAY

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .association   is DBREF
   member .component     is DBREF

   member .allAssMbr     is ARRAY

   -- Additional members required to simplify processing
   member .hmHole       is HMHOLE


   member .debug         is BOOLEAN
endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      hmRestrictionCCWay
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hmRestrictionCCWay()

  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      testEv
--
-- Description: make sure that the penetration components are coincident
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testEv() is BOOLEAN

-- Manually trigger the CONSTRUCTOR - does not get run automatically at the moment
  !this.hmRestrictionCCWay()

  !this.gatherData()

-- If key data not located then fail
  if (!this.allAssMbr.unset() ) then
    if (!this.debug ) then
      write 'Assmbr list unset in hmRestrictionCCWay.testEv()'
    endif
    return FALSE
  endif

-- Check on profile of Hole Owner
  if ( NOT !this.checkCoincident() ) then
    if (!this.debug ) then
      write 'Failed check in hmRestrictionCCWay.checkCoincident()'
    endif
    return FALSE
  endif

-- Once all checks completed successfully...
  return TRUE

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      GatherData
--
-- Description: Collect all key information for member variables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatherData()

-- Gather all hole data for this association
  !this.hmHole = object HMHOLE(!this.association)

  !this.allAssMbr = object ARRAY()

-- Locate ALL the Assmbr elements for this ASSOCIATION
  !find = object COLLECTION()
  !find.type('ASSMBR')
  !find.scope(!this.hmHole.element)
  !this.allAssMbr = !find.results()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      checkCoincident
--
-- Description: check RNODE and FIXING hierarchy are coincident
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkCoincident() is BOOLEAN

  !nodePenetrationPos = ARRAY()
  !nodeOffsetPos      = ARRAY()
  !dpcaPos            = ARRAY()
  !pFitPos          = object POSITION()
--    1.  Loop all ASSMBRs
  do !item values !this.allAssMbr
    if (BADREF(!item.amemrf)) then
      !!setRestrictionError(!this.association, !this.component, |Bad reference in an AMEMRF field in one of the elements in the hole association|)
      return FALSE
    endif
--    1.1.  Pull out position info for all RNODE, FIXING, DPCA and PFIT
    if (!item.amemrf.hardType eq 'RNODE') then
      if (!item.amemrf.rnType eq 'PENE') then
        !nodePenetrationPos.append(!item.amemrf.pos)
      elseif (!item.amemrf.rnType eq 'OFFS') then
        !nodeOffsetPos.append(!item.amemrf.pos)
      endif
    elseif (!item.amemrf.hardType eq 'FIXING') then
      !fixingPos = !item.amemrf.pos
    elseif (!item.amemrf.hardType eq 'DPCA') then
      !dpcaPos.append(!item.amemrf.pos)
    elseif (!item.amemrf.hardType eq 'PFIT') then
      !pFitPos = !item.posev
    elseif (!item.amemrf.type eq 'CMFI') then
      if (!item.amemrf.member[1].type.eq('SBFI')) then
        !sFit = !item.amemrf.members[1]
      elseif (!item.amemrf.member[1].type.eq('TMPL')) then
        skip
      endif
      !pFitPos = !sFit.position.wrt(Worl)
    elseif (!item.amemrf.type eq 'JLDATU') then
      !plDatu = !item.amemrf.member[1]
      !fixings = !plDatu.members
      do !val values !fixings
        if (!val.spref.set()) then
          !pFitPos = !val.position.wrt(Worl)
        endif
      enddo
    endif
  enddo
--    2.  Check all node positions are same as FIXING pos

  if (!nodePenetrationPos.size() eq 0 or !nodeOffsetPos.size() eq 0 or undefined(!fixingPos) or !dpcaPos.size() eq 0 ) then
    !!setRestrictionError(!this.association, !this.component, |Critical data missing from hole association|)
    return FALSE
  endif

  -- Check all the fixing position is equal to all the node offset position (within 1mm)
  do !position values !nodeOffsetPos
    if (!position.near(!fixingPos, 1mm ).not()) then
      !!setRestrictionError(!this.association, !this.component, |Fixing position is different from node offset position|)
      return FALSE
    endif
  enddo

--    3.  Check PFIT pos is same as FIXING pos
  -- check that primary hole is aligned with virtual hole position
  if( !pFitPos.set() ) then
    if (!pFitPos.near(!fixingPos, 1mm ).not()) then
      !!setRestrictionError(!this.association, !this.component, |Fixing position is different from PFIT position|)
      return FALSE
    endif
  endif

--    4. Check DPCA positions are same as penetration positions (nodes)
  if( !nodePenetrationPos.size() neq !dpcaPos.size() ) then
    !!setRestrictionError(!this.association, !this.component, |DPCA positions different from Node Penetration positions|)
    return FALSE
  endif
  !tempDpcaPos       = !dpcaPos
  do !nodePos values !nodePenetrationPos
    !coincidentFound = false
    do !index indices !tempDpcaPos
      -- skip if position already matched
      skip if( !tempDpcaPos[!index].unset() )
      -- skip if not coincident
      skip if( !nodePos.near(!tempDpcaPos[!index], 0.1mm).not() )
      -- coincident point found - clear position so it cannot be matched again
      !tempDpcaPos[!index] = object POSITION()
      !coincidentFound     = true
    enddo
    -- every node position must be matched
    if( !coincidentFound.not() ) then
      !!setRestrictionError(!this.association, !this.component, |DPCA positions different from Node Penetration positions|)
      return FALSE
    endif
  enddo

  !!setRestrictionError(!this.association, !this.component, |No Error|)
  return TRUE

endmethod
-- End of method
