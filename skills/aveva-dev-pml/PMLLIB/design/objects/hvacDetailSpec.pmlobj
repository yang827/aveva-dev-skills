--   Module:        Design
--
-- Author:          Steve Bentley
-- Created:         Tue Sep 30 09:00:00 BST 2008
--
-- Description:
-- Object to manage all detailing specifications for HVAC
--
-- To use this object to upgrade a flat file spec usually in %pdmsdflts%/hvacadvspecs
-- to be a TABGRO/CTABLE based spec in the database:
-- Example - In Paragon... MAS project
-- !a = object HVACDETAILSPEC()
-- !a.readSpec('TUTORIAL')      This creates a macro file in %pdmsuser% named NewTUTORIAL
-- You may wish to edit this spec to be active/inactive..... or put in a specific hierarchy etc
-- A spec is active if TABGRO %purp DSPE (change to %PURP NONE to make it inactive)
-- A spec by default will be put in the SPWLD /HVAC_Detailing_Specifications
-- !a.runNewMacro('TUTORIAL')   This runs the macro to create the CTABLE elements in the database

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hvacDetailSpec()                 -                   Constructor
--  readSpec(STRING)                 -                   Read the spec from the old style file usually in pdmsdflts/hvacadvspecs
--  runNewMacro(STRING)              -                   Run the new macro ($m/%PDMSUSER%/New$$!specName)
--  writeMacro(FILE)                 -                   Write new macro from old style file usually in pdmsdflts/hvacadvspecs
--
define object HVACDETAILSPEC

  -- Members
  member .currentSpec          is STRING
  member .listOfSpecs          is ARRAY
  member .listOfVisibleSpecs   is ARRAY
  member .listOfInvisibleSpecs is ARRAY

endobject
-- End of object definition
------------------------------------------------------------------------
--
-- Method:      .hvacDetailSpec()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .hvacDetailSpec()

  -- Intentionally empty constructor at this version

endmethod
-- End of method definition for .hvacDetailSpec()
------------------------------------------------------------------------
--
-- Method:      .readSpec
--
-- Description: Read the spec from the old style file usually in pdmsdflts/hvacadvspecs
--
------------------------------------------------------------------------
define method .readSpec(!fileString is STRING)

  !file = object FILE('%PDMSDFLTS%/hvacadvspecs/x' & !fileString)
  if (!file.exists()) then
  	-- OK
  	!this.writeMacro(!file)
  else
  	!!alert.error('Bad file name, File does not exist')
  	return
  endif

endmethod
-- End of method definition for .readSpec(STRING)
------------------------------------------------------------------------
--
-- Method:      .writeMacro
--
-- Description: Write new macro from old style file usually in pdmsdflts/hvacadvspecs
--
------------------------------------------------------------------------
define method .writeMacro(!fileObject is FILE)

  -- Initialise variables
  !lines = ARRAY()

  -- Open another file to write to (with massaged lines that use the initial array)
  !specName = !fileObject.name().part(-1, '/')
  !newFile = object FILE('%PDMSUSER%/New' & !specName)
  !newFile.open('overwrite')

  -- Run the actual file as a macro because it creates global variables that we can make use of
  !lines.append(|-- Run the spec macro to get spec settings|)
  !lines.append(|$m/%pdmsdflts%/hvacadvspecs/| & !specName)
  !lines.append(|handle (47,15)|)
  !lines.append(|  -- We know there will be a syntax error on the CALLDCT synonyms at the end of the file|)
  !lines.append(|endhandle|)
  !lines.append(||)

  -- Input top lines of new macro
  !lines.append(|-- Macro to input HVAC_Detailing_Specifications|)
  !lines.append(|/$:AVEVAHVACCATA$:|)
  !lines.append(|OLD SPWLD /HVAC_Detailing_Specifications|)
  !lines.append(|handle ANY|)
  !lines.append(|  NEW SPWLD /HVAC_Detailing_Specifications|)
  !lines.append(|  DESC 'Spec world for HVAC Detailing Specs'|)
  !lines.append(|  PURP HVAC|)
  !lines.append(|endhandle|)
  !lines.append(|tail|)
  !lines.append(||)

  -- ** New Spec
  !lines.append(|NEW TABGROUP /$$!!detSpecNamInp|)
  !lines.append(|DESC 'HVAC Detail Spec - $$!!detSpecNamInp'|)
  !lines.append(|PURP DSPE|)
  !lines.append(|SPTYPE $$!!materialInp|)
  !lines.append(||)

  -- ** Rectangular headings
  !lines.append(|NEW CTABLE /$$!!detSpecNamInp$N-RECT|)
  !lines.append(|DESC 'Rectangular - $$!!detSpecNamInp'|)
  !lines.append(|PURP RECT|)
  !lines.append(|SPTYPE HVAC|)
  !lines.append(||)

  !lines.append(|NEW TABHEADER|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'RectMIN'|)
  !lines.append(|PURP RMIN|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Rectangular Minimum'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'RectMAX'|)
  !lines.append(|PURP RMAX|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Rectangular Maximum'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Joints'|)
  !lines.append(|PURP JNTS|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Joints'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Std Leng'|)
  !lines.append(|PURP STDL|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Standard Length'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Gauge'|)
  !lines.append(|PURP GAUG|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Thickness of Material'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Stif size'|)
  !lines.append(|PURP STIF|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Stiffener Size'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Max Spac'|)
  !lines.append(|PURP SPAC|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Maximum Stiffener Spacing'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  -- Rectangular Values
  do !j from 1 to 15
    !lines.append(|NEW TABITEM /$$!!detSpecNamInp$N-RECT$N$!j |)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'RectMIN'|)
    !lines.append(|PURP RMIN|)
    !lines.append(|TQUES 'Rectangular Minimum'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NMININP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'RectMAX'|)
    !lines.append(|PURP RMAX|)
    !lines.append(|TQUES 'Rectangular Maximum'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NMAXINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Joints'|)
    !lines.append(|PURP JNTS|)
    !lines.append(|TQUES 'Joints'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NJNTINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Std Leng'|)
    !lines.append(|PURP STDL|)
    !lines.append(|TQUES 'Standard Length'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NLENINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Gauge'|)
    !lines.append(|PURP GAUG|)
    !lines.append(|TQUES 'Thickness of Material'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NGAUINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Stif size'|)
    !lines.append(|PURP STIF|)
    !lines.append(|TQUES 'Stiffener Size'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NSTIINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Max Spac'|)
    !lines.append(|PURP SPAC|)
    !lines.append(|TQUES 'Maximum Stiffener Spacing'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!rr$N$!j$NSPAINP'|)
    !lines.append(||)

  enddo

  -- ** Circular headings
  !lines.append(|NEW CTABLE /$$!!detSpecNamInp$N-CIRC|)
  !lines.append(|DESC 'Circular - $$!!detSpecNamInp'|)
  !lines.append(|PURP CIRC|)
  !lines.append(|SPTYPE HVAC|)
  !lines.append(||)

  !lines.append(|NEW TABHEADER|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'CircMIN'|)
  !lines.append(|PURP CMIN|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Circular Minimum'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'CircMAX'|)
  !lines.append(|PURP CMAX|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Circular Maximum'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Joints'|)
  !lines.append(|PURP JNTS|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Joints'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Std Leng'|)
  !lines.append(|PURP STDL|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Standard Length'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Gauge'|)
  !lines.append(|PURP GAUG|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Thickness of Material'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Stif size'|)
  !lines.append(|PURP STIF|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Stiffener Size'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Max Spac'|)
  !lines.append(|PURP SPAC|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Maximum Stiffener Spacing'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  -- Circular Values
  do !j from 1 to 8
    !lines.append(|NEW TABITEM /$$!!detSpecNamInp$N-CIRC$N$!j |)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'CircMIN'|)
    !lines.append(|PURP CMIN|)
    !lines.append(|TQUES 'Circular Minimum'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NMININP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'CircMAX'|)
    !lines.append(|PURP CMAX|)
    !lines.append(|TQUES 'Circular Maximum'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NMAXINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Joints'|)
    !lines.append(|PURP JNTS|)
    !lines.append(|TQUES 'Joints'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NJNTINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Std Leng'|)
    !lines.append(|PURP STDL|)
    !lines.append(|TQUES 'Standard Length'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NLENINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Gauge'|)
    !lines.append(|PURP GAUG|)
    !lines.append(|TQUES 'Thickness of Material'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NGAUINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Stif size'|)
    !lines.append(|PURP STIF|)
    !lines.append(|TQUES 'Stiffener Size'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NSTIINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Max Spac'|)
    !lines.append(|PURP SPAC|)
    !lines.append(|TQUES 'Maximum Stiffener Spacing'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!cr$N$!j$NSPAINP'|)
    !lines.append(||)

  enddo

  -- ** Oval headings
  !lines.append(|NEW CTABLE /$$!!detSpecNamInp$N-OVAL|)
  !lines.append(|DESC 'Flat Oval - $$!!detSpecNamInp'|)
  !lines.append(|PURP OVAL|)
  !lines.append(|SPTYPE HVAC|)
  !lines.append(||)

  !lines.append(|NEW TABHEADER|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'OvalMIN'|)
  !lines.append(|PURP OMIN|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Flat Oval Minimum'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'OvalMAX'|)
  !lines.append(|PURP OMAX|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Flat Oval Maximum'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Joints'|)
  !lines.append(|PURP JNTS|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Joints'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Std Leng'|)
  !lines.append(|PURP STDL|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Standard Length'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Gauge'|)
  !lines.append(|PURP GAUG|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Thickness of Material'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Stif size'|)
  !lines.append(|PURP STIF|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Stiffener Size'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  !lines.append(|NEW TABHQUESTION|)
  !lines.append(|DESC 'Max Spac'|)
  !lines.append(|PURP SPAC|)
  !lines.append(|ANSTYP TEXT|)
  !lines.append(|TQUES 'Maximum Stiffener Spacing'|)
  !lines.append(|QTYPE TEXT|)
  !lines.append(||)

  -- Flat Oval Values
  do !j from 1 to 8
    !lines.append(|NEW TABITEM /$$!!detSpecNamInp$N-OVAL$N$!j |)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'OvalMIN'|)
    !lines.append(|PURP OMIN|)
    !lines.append(|TQUES 'Flat Oval Minimum'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NMININP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'OvalMAX'|)
    !lines.append(|PURP OMAX|)
    !lines.append(|TQUES 'Flat Oval Maximum'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NMAXINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Joints'|)
    !lines.append(|PURP JNTS|)
    !lines.append(|TQUES 'Joints'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NJNTINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Std Leng'|)
    !lines.append(|PURP STDL|)
    !lines.append(|TQUES 'Standard Length'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NLENINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Gauge'|)
    !lines.append(|PURP GAUG|)
    !lines.append(|TQUES 'Thickness of Material'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NGAUINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Stif size'|)
    !lines.append(|PURP STIF|)
    !lines.append(|TQUES 'Stiffener Size'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NSTIINP'|)
    !lines.append(||)

    !lines.append(|NEW TABQUESTION|)
    !lines.append(|DESC 'Max Spac'|)
    !lines.append(|PURP SPAC|)
    !lines.append(|TQUES 'Maximum Stiffener Spacing'|)
    !lines.append(|QTYPE TEXT|)
    !lines.append(|TANS '$$!!fr$N$!j$NSPAINP'|)
    !lines.append(||)

  enddo
  -- Input bottom lines of new macro

  !lines.append(|-- End of Macro|)

  !newFile.writeFile('OVERWRITE', !lines)
  !newFile.close()

endmethod
-- End of method definition for .writeMacro(FILE)
------------------------------------------------------------------------
--
-- Method:      .runNewMacro
--
-- Description: Run the new macro ($m/%PDMSUSER%/New$$!specName)
--
------------------------------------------------------------------------
define method .runNewMacro(!fileString is STRING)

  -- Run the new macro
  !file = '%PDMSUSER%/Newx' & !fileString
  $m/$!file

  -- Because the pdmsdflts macro has been run, this is now the current Spec
  !this.currentSpec = '/$!!detSpecNamInp'
  handle ANY
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method definition for .runNewMacro(STRING)
