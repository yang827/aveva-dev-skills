--   File:          hvacmerge.pmlobj
--   Type:          Object Definition
--   Group:         Merging two HVAC branches

--   Keyword:       HVAC
--   Module:        design
--   Replaces:
--
--  Author:          prashant.srivastava
--  Created:         Thu Jul 19 14:41:04 2007
--
--  Description:     -- Object to merge HVAC branches.--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hvacMerge()                      -                   pick the branch which is to be merged
--  merge(DBREF,DBREF)               -                   merge the two picked branches
--  mergeToBranch()                  -                   pick the branch to merge to
--
------------------------------------------------------------------------
define object HVACMERGE

  -- store definitions of first EDG packet
  member .pick  is EDGPACKET

  -- Member for first branch
  member .mergingBranch is DBREF

  -- Member for second branch
  member .mergeToBranch is DBREF

endobject
------------------------------------------------------------------------
--
-- Method:      hvacMerge
--
-- Description: pick the branch which is to be merged
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hvacMerge()

  !packet = object EDGPACKET()

  !packet.description = 'Merge'
  !packet.action      = '!!mergeHvacBranches.mergingBranch = !this.return[1].item'
  !packet.elementPick('First pick a connected branch to merge')
  !packet.remove = TRUE
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE  of owner of BRAN eq |HVAC|'
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !packet.pickPacket.picks[1].numberofpicks   = 1
  !packet.escape  = ''
  !packet.continue = '!!mergeHvacBranches.mergeToBranch()'

  !!edgCntrl.add(!packet)
  !this.pick = !packet

endmethod
------------------------------------------------------------------------
--
-- Method:      mergeToBranch
--
-- Description: pick the branch to merge to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mergeToBranch()

  -- Enhance the first branch
  !mergingBran = !!mergeHvacBranches.mergingBranch

  -- check if dbref stored in pick
  if (!mergingBran.unset()) then
    return
  endif

  -- Validate picks
  if (!!mergeHvacBranches.mergingBranch.owner.type.eq('BRAN')) then
    !mergingBran = !!mergeHvacBranches.mergingBranch.owner
  endif

  if (!mergingBran.type.eq('BRAN') and !mergingBran.owner.type.eq('HVAC')) then
    -- That is correct
  else
    !!alert.error('Invalid element for merge - ' & !mergingBran.name )
    return
  endif
  enhance $!mergingBran colour $!!gphcolopt.highlight.code

  !packetTo = !this.pick

  !packetTo.description = 'Merge to'
  !packetTo.action      = '!!mergeHvacBranches.mergeToBranch = !this.return[1].item'
  !packetTo.elementPick('Secondly pick the branch to merge to')
  !packetTo.remove = TRUE
  !packetTo.pickPacket.picks[1].pick.input[3]   = 'TYPE  of owner of BRAN eq |HVAC|'
  !packetTo.pickPacket.picks[1].pick.modifiable = FALSE
  !packetTo.pickPacket.picks[1].numberofpicks   = 1
  !packetTo.escape   = ''
  !packetTo.continue = '!!mergeHvacBranches.merge(!!mergeHvacBranches.mergeToBranch,!!mergeHvacBranches.mergingBranch)'

  !!edgCntrl.add(!packetTo)

endmethod
------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: merge the two picked branches
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      HVAC branch to merge to
--    2    R     DBREF      HVAC branch to be merged
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .merge(!testMergeTo is DBREF,!testMergingBran is DBREF)

  -- check if dbref stored in pick
  if (!testMergeTo.unset()) then
    return
  endif

  -- Initialise variables
  !mergingBran = !testMergingBran
  !mergeTo     = !testMergeTo

  -- Validate picks
  if (!testMergingBran.owner.type.eq('BRAN')) then
    !mergingBran = !testMergingBran.owner
  endif
  if (!testMergeTo.owner.type.eq('BRAN')) then
    !mergeTo = !testMergeTo.owner
  endif

  -- We should not really need this code because EDG pick should have filtered OK
  if (!mergingBran.type.eq('BRAN') and !mergingBran.owner.type.eq('HVAC')) then
    -- That is correct
  else
    !!alert.error('Invalid element for merge - ' & !mergingBran.name )
    return
  endif
  if (!mergeTo.type.eq('BRAN') and !mergeTo.owner.type.eq('HVAC')) then
    -- That is correct
  else
    !!alert.error('Invalid element for merge - ' & !mergeTo.name )
    return
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Merged HVAC Branches')
  !undo.undoAction('')
  !undo.redoAction('')
  !undo.add()

  enhance $!mergeTo colour $!!gphcolopt.highlight.code

  --checks whether the branches are connected
  if (!mergeTo.href.eq(!mergingBran)) then
   !confirm = !!alert.confirm('Do you really want to merge the two branches?')

   --merges the branches
   if(!confirm.eq('YES'))then

    !mem = !mergingBran.members
    !!ce = !mergeTo

    do !i from !mem.size() to 1 by -1
     include $!mem[$!i] before first mem
     handle ANY
       !!alert.error('Cannot merge branches ' & !!error.text.after(|)|))
       handle ANY
         !!alert.error(!!error.text)
       endhandle
       unenhance all
       return
     endhandle
    enddo
   else
    unenhance all
    return
   endif
  elseif(!mergeTo.tref.eq(!mergingBran)) then
   !confirm = !!alert.confirm('Do you really want to merge the two branches?')
   if(!confirm.eq('YES'))then

    !mem = !mergingBran.members
    !!ce = !mergeTo

    do !i from 1 to !mem.size()
     include $!mem[$!i] after last mem
     handle ANY
       !!alert.error('Cannot merge branches ' & !!error.text.after(|)|))
       handle ANY
         !!alert.error(!!error.text)
       endhandle
       unenhance all
       return
     endhandle
    enddo
   else
    unenhance all
    return
   endif
  else
   !!alert.message('Branches cannot be merged. (You can only merge branches originally connected to each other)')
   unenhance all
   return
  endif

  -- Capture all head information of merging branch
  !mergingBranHref = !mergingBran.href
  if (!mergingBranHref.unset()) then
    !mergingBranReconnectH = false
  elseif (!mergingBranHref.type.eq('BRAN')) then
    !mergingBranReconnectH = true
    !mergingBranPointH = 'PT OF'
  elseif (!mergingBranHref.type.eq('NOZZ')) then
    !mergingBranReconnectH = true
    !mergingBranPointH = ''
  else
    !mergingBranReconnectH = true
    !mergingBranPointH = 'P3 OF'
  endif
  !mergingBranHpos = !mergingBran.hpos
  !mergingBranHdir = !mergingBran.hdir
  !mergingBranHbor = !mergingBran.hbor
  !mergingBranHcon = !mergingBran.hcon
  !mergingBranHstube = !mergingBran.hstube
  !mergingBranHxySize = !mergingBran.attribute(':hxysize')

  -- Capture all tail information of merging branch
  !mergingBranTref = !mergingBran.tref
  if (!mergingBranTref.unset()) then
    !mergingBranReconnectT = false
  elseif (!mergingBranTref.type.eq('BRAN')) then
    !mergingBranReconnectT = true
    !mergingBranPointT = 'PH OF'
  elseif (!mergingBranTref.type.eq('NOZZ')) then
    !mergingBranReconnectT = true
    !mergingBranPointT = ''
  else
    !mergingBranReconnectT = true
    !mergingBranPointT = 'P3 OF'
  endif
  !mergingBranTpos = !mergingBran.tpos
  !mergingBranTdir = !mergingBran.tdir
  !mergingBranTbor = !mergingBran.tbor
  !mergingBranTcon = !mergingBran.tcon

  -- Navigate to the merged to branch
  !!ce = !mergeTo

  --set the head and tail reference/position of the merged branch
  if(!mergeTo.href.eq(!mergingBran))then
    if (!mergingBranReconnectH) then
      FCONN PH TO $!mergingBranPointH $!mergingBranHref
      handle ANY
      endhandle
    endif
    !mergeTo.hpos = !mergingBranHpos
    !mergeTo.hdir = !mergingBranHdir
    !mergeTo.hbor = !mergingBranHbor
    !mergeTo.hcon = !mergingBranHcon
    !mergeTo.hstube = !mergingBranHstube
    :hxysize $!mergingBranHxySize[1] $!mergingBranHxySize[2]

  elseif(!mergeTo.tref.eq(!mergingBran))then
    if (!mergingBranReconnectH) then
      FCONN PT TO $!mergingBranPointT $!mergingBranTref
      handle ANY
      endhandle
    endif
    !mergeTo.tpos = !mergingBranTpos
    !mergeTo.tdir = !mergingBranTdir
    !mergeTo.tbor = !mergingBranTbor
    !mergeTo.tcon = !mergingBranTcon

  endif

  --Unenhance the branches
  unenhance all

  -- Navigate to the merging branch
  !!ce = !mergingBran

  -- Delete the branch merged
  delete $!mergingBran.type
  handle ANY
  endhandle

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  -- Macro completed successfully

endmethod
