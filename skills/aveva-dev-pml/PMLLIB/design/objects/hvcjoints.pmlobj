-- File:            hvcjoints.pmlobj
--   Type:          Object Definition
--   Group:         HVAC
--     Keyword:     Joints
--   Module:        Design
--
-- Author:          Steve Bentley
-- Created:         Tue Jul 12 09:00:00 BST 2006
--
-- Description:
-- Object to manage all joints for HVAC
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAllData()                     -                   Get all the Joint information (Set member STRINGs  Values of all DATA elements)
--  getAllJointDataSet(STRING,STRING) ARRAY               Get the All Joint information as an array
--  getJointData(STRING)             STRING              Get the Joint information (STRING  Value of DATA element)
--  getJointDataSet(STRING,STRING)   DBREF               Get the Joint information (DBREF  DTSET element)
--  hvcJoints()                      -                   Constructor
--
define object HVCJOINTS

  -- Members

  -- Rectangular joints. (Array of DBREFS (DTSET elements)
  member .rectangularJoints is ARRAY
  -- Circular joints. (Array of DBREFS (DTSET elements)
  member .circularJoints is ARRAY
  -- Flat Oval joints. (Array of DBREFS (DTSET elements)
  member .flatOvalJoints is ARRAY
  -- Where to look for the joints
  member .rectangularJointsStorage is DBREF
  member .circularJointsStorage    is DBREF
  member .flatOvalJointsStorage    is DBREF

  -- Store the derived dataset so data can be derived from this.
  member .jointDataSet is DBREF

  -- Store the current data
  member .currentDescription is STRING
  member .currentCode        is STRING
  member .currentAlpha       is STRING
  member .currentNumeric     is STRING
  member .currentADimension  is STRING
  member .currentBDimension  is STRING
  member .currentCDimension  is STRING

endobject
-- End of object definition
------------------------------------------------------------------------
--
-- Method:      .hvcJoints()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .hvcJoints()

  -- Set defaults for the object members
  if (!!cdHVACunits eq 'MM') then
    !this.rectangularJointsStorage = object DBREF('/$:AVEVAHVACCATA$:-Joints-RECT ')
    !this.circularJointsStorage    = object DBREF('/$:AVEVAHVACCATA$:-Joints-CIRC ')
    !this.flatOvalJointsStorage    = object DBREF('/$:AVEVAHVACCATA$:-Joints-FOVA ')
  else
    !this.rectangularJointsStorage = object DBREF('/$:AVEVAHVACCATA$:-Joints-RECT-Imp ')
    !this.circularJointsStorage    = object DBREF('/$:AVEVAHVACCATA$:-Joints-CIRC-Imp ')
    !this.flatOvalJointsStorage    = object DBREF('/$:AVEVAHVACCATA$:-Joints-FOVA-Imp ')
  endif

endmethod
-- End of method definition for .hvcJoints()
------------------------------------------------------------------------
--
-- Method:      .getJointDataSet
--
-- Description: Get the Joint information (DBREF  DTSET element)
--
------------------------------------------------------------------------
define method .getJointDataSet(!code is STRING, !shape is STRING) is DBREF

  !result = object DBREF()
  !trimmedCode = !code.trim()

  if (!shape.lowcase() eq 'rect') then
    !element = !this.rectangularJointsStorage
  elseif (!shape.lowcase() eq 'circ') then
    !element = !this.circularJointsStorage
  elseif (!shape.lowcase() eq 'fova') then
    !element = !this.flatOvalJointsStorage
  endif

  var !collect COLLECT ALL DTSET WITH (FUNC eq '$!trimmedCode') FOR $!element

  !result = !collect[1].dbref()
  handle ANY
    return error 1 'Joint code not recognised. Check your joint code input.'
  endhandle

  -- Set the object member
  !this.jointDataSet = !result

  return !result

endmethod
-- End of method definition for .getJointDataSet()
------------------------------------------------------------------------
--
-- Method:      .getJointData
--
-- Description: Get the Joint information (STRING  Value of DATA element)
--
------------------------------------------------------------------------
define method .getJointData(!code is STRING) is STRING

  !result = ''

  var !collect COLLECT ALL DATA WITH (DKEY eq '$!code') FOR $!this.jointDataSet

  !result = !collect[1].dbref().pprop
  handle ANY
  elsehandle NONE
    if (!collect[1].dbref().ptyp eq 'TEXT') then
      !result = !collect[1].dbref().pprop.after(|( '|).before(|' )|)
    elseif (!collect[1].dbref().ptyp eq 'REAL') then
      !result = !collect[1].dbref().pprop.after(|( |).before(| )|)
    endif
  endhandle

  return !result

endmethod
-- End of method definition for .getJointData()
------------------------------------------------------------------------
--
-- Method:      .getAllData
--
-- Description: Get all the Joint information (Set member STRINGs  Values of all DATA elements)
--
------------------------------------------------------------------------
define method .getAllData()

  !this.currentDescription = !this.getJointData('DESC')
  !this.currentCode        = !this.getJointData('CODE')
  !this.currentAlpha       = !this.getJointData('ALPH')
  !this.currentNumeric     = !this.getJointData('NUME')
  !this.currentADimension  = !this.getJointData('HVJA')
  !this.currentBDimension  = !this.getJointData('HVJB')
  !this.currentCDimension  = !this.getJointData('HVJC')

endmethod
-- End of method definition for .getAllData()
------------------------------------------------------------------------
--
-- Method:      .getAllJointDataSet
--
-- Description: Get the All Joint information as an array
--
------------------------------------------------------------------------
define method .getAllJointDataSet(!arrayType is STRING, !shape is STRING) is ARRAY

  !result = object ARRAY()

  if (!shape.lowcase() eq 'rect') then
    !element = !this.rectangularJointsStorage
  elseif (!shape.lowcase() eq 'circ') then
    !element = !this.circularJointsStorage
  elseif (!shape.lowcase() eq 'fova') then
    !element = !this.flatOvalJointsStorage
  endif

  var !collect COLLECT ALL DTSET FOR $!element

  -- Loop through all dtset elements and get the Description for Dtext or the Function for Rtext
  if (!arrayType.upcase() eq 'DTEXT') then
    do !i indices !collect
      !result[!i] = !collect[!i].dbref().description
      handle ANY
      endhandle
    enddo
  elseif (!arrayType.upcase() eq 'RTEXT') then
    do !i indices !collect
      !result[!i] = !collect[!i].dbref().function
      handle ANY
      endhandle
    enddo
  endif

  return !result

endmethod
-- End of method definition for .getAllJointDataSet()
