--
--
-- Description:
-- Control object for Isometric Drawing preview (MVC pattern)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   Clear object members and related form
--  displayResults()                 -                   Display the results
--  displaySheets()                  -                   Display list of sheets generated
--  findSystem()                     -                   Find the elements that define the system
--  getIsodrawSheets()               -                   Get sheets generated by isodraw run
--  getIsodrawStatus()               STRING              Return Isodraw status
--  isdPreviewIsoControl()           -                   Constructor
--  prepareToDetail(STRING)          -                   Preprocessing for detailing 'SYS' or 'STD'
--  produceStandardIso()             -                   Produce standard isometric (Called from function)
--  produceSystemIso()               -                   Produce system isometric (Called from function)
--  scanPipeNetwork(DBREF)           -                   Identify the elements that make up the pipe network defined as the system
--  setOptionsFile(STRING)           -                   Set the options file to be used 'SYS' or 'STD'
--  showSystem(BOOLEAN)              -                   Enhance the pipe network defined as the system
--
------------------------------------------------------------------------

define object ISDPREVIEWISOCONTROL

  -- Associated form
  member .form        is FORM

  -- Options file
  member .optionsFile is STRING

  -- Actual selected element
  member .selectedElement is DBREF
  -- Element to be processed (Standard isometric)
  member .isoElement      is DBREF
  -- Array of elements to be processed (System Isometric)
  member .isoElements is DBREF

  -- Array of types of elements for which an iso can be produced
  member .detailTypes is ARRAY

  -- Message filename
  member .messageFile is STRING

  member .plotFileList        is ARRAY
  member .rootNameList        is ARRAY
  member .pipeNameList        is ARRAY
  member .sheetList           is ARRAY
  member .sheetNameList       is ARRAY
  member .plotStatusList      is ARRAY
  member .sheetListReturnText is ARRAY

  member .branchList     is ARRAY
  member .systemNumber   is REAL
  member .standardNumber is REAL
  member .interactive    is BOOLEAN
  member .status         is STRING

endobject
-- End of object definition for isdPreviewIsoControl

------------------------------------------------------------------------
--
-- Method:      isdPreviewIsoControl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isdPreviewIsoControl()

  -- identifies the form associated with this control object
  var !device device
  !this.interactive = ( !device.upcase() eq 'GRAPHICS' )
  if ( !this.interactive ) then
    if( not defined(!!isdPreviewIso)) then
      pml load form !!isdPreviewIso
    endif
    !this.form = !!isdPreviewIso
  endif

  -- Initialise types of elements for which an iso can be produced.
  -- P-10505 fix to DUN874: J.M. McCoy 20-08-08: add PSPOOL & PSLIST
  -- to permissible types
  !this.detailTypes[1] = 'BRAN'
  !this.detailTypes[2] = 'PIPE'
  !this.detailTypes[3] = 'FIELD'
  !this.detailTypes[4] = 'SPOOL'
  !this.detailTypes[5] = 'SPLDRG'
  !this.detailTypes[6] = 'PSPOOL'
  !this.detailTypes[7] = 'PSLIST'

  !this.systemNumber = 0
  !this.standardNumber = 0

endmethod
-- End of method definition for .isdPreviewIsoControl()

----------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: clear data for new isometric
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()

  !this.plotFileList = ARRAY()
  !this.rootNameList = ARRAY()
  !this.pipeNameList = ARRAY()
  !this.sheetList = ARRAY()
  !this.sheetNameList = ARRAY()
  !this.plotStatusList = ARRAY()
  !this.sheetListReturnText = ARRAY()

  -- Clear previous results on form
  if ( !this.interactive ) then
    !this.form.clear()
    handle ANY
      -- Form may no longer exist
      pml reload form !!isdPreviewIso
      !this.form = !!isdPreviewIso
    endhandle
  endif

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      displaySheets
--
-- Description: Display list of sheets generated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displaySheets()

  !this.status = !this.getIsodrawStatus()

  if ( !this.status neq 'OK' ) then
    !!alert.warning('Isodraw has failed: $!this.status')
    -- Read messages
    !messFile = !this.messageFile
    !messageFileObject = object FILE(!this.messageFile)
    if( not !messageFileObject.exists() ) then
      !!alert.error(|Cannot find message file | + !messFile)
    else
      -- load messages form
      if( not defined(!!isdPreviewMessages)) then
        pml load form !!isdPreviewMessages
      endif
      !array       = !messageFileObject.readFile()
      !!isdPreviewMessages.message.dtext = !array
      !!isdPreviewMessages.show()
    endif

  else

    -- get list of sheets generated
    !this.getIsodrawSheets()

    -- Display results and list messages
    !this.displayResults()

  endif

endmethod
-- End of method definition for .displaySheets()

------------------------------------------------------------------------
--
-- Method:      produceStandardIso
--
-- Description: Produce standard isometric
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .produceStandardIso()

  -- Get module information could be Design or Spooler
  !module = !!module()

  -- Detail CE - check type is valid for detailing
  -- P-10505 fix to DUN874: J.M. McCoy 21-08-08: add PSPOOL & PSLIST
  -- to types in returned error messages

  !this.selectedElement = !!ce
  !this.isoElement      = !!dtbOwnerOfTypes(!this.selectedElement, !this.detailTypes)
  if (!this.isoElement.unset()) then
    -- Cannot access from this level
    if (!module.appkey.upcase() inset('DES')) then
       return error 1 |Utility only available for PIPE, BRANCH, PSLIST or PSPOOL|
    else
       return error 1 |Utility only available for SPLDRG, FIELD, SPOOL, PIPE, BRANCH, PSLIST or PSPOOL|
    endif
  endif

  -- Specific handle for HVAC branch
  if (!this.isoElement.owner.type eq 'HVAC') then
    return error 1 |Utility not available for an HVAC branch|
  endif

  -- Clear previous results
  !this.clear()

  -- Increment document number
  !this.standardNumber = !this.standardNumber + 1

  -- prepare to detail the selected element
  !this.prepareToDetail(|STD|)

  !this.messageFile = '%PDMSWK%\' & 'stdmess' & !this.standardNumber.string()
  mess "$!this.messageFile" over

  !name = !this.isoElement.string()
  !type = !this.isoElement.acttype

  --if PIPCA are found produced detailed plotfiles
  var !textdp TEXTPOS DETAILPLOTS
  !textdpsplit = !textdp.split()
  !size = !textdpsplit.size()
  !n = !size.real()
  if (!n gt 1) then
    if (!textdpsplit[$!n] ne 'NSBCOFF') then
      !ref = !!ce
      !errorArray = !!pipestarttappingdrwg(!this.isoElement)
      if !errorArray.set() then
        do !i values !errorArray
          !!alert.warning(!i)
        enddo
      endif
      !!ce = !ref
    endif
  endif

  -- Detail drawing
  DETAIL $!type $!name
  handle any
  endhandle

  -- display sheets
  !this.displaySheets()

endmethod
-- End of method definition for .produceStandardIso()

------------------------------------------------------------------------
--
-- Method:      produceSystemIso
--
-- Description: Produce system isometric
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .produceSystemIso()

  -- Check options file
  if ( !this.optionsFile eq || ) then
    return error 1 |No options file selected|
  endif

  !this.findSystem()

  -- Clear previous results
  !this.clear()

  -- Increment document number
  !this.systemNumber = !this.systemNumber + 1
  !systemName = |System| + !this.systemNumber.string()

  -- prepare to detail the selected element
  !this.prepareToDetail(|SYS|)

  !this.messageFile = '%PDMSWK%\' &'sysmess' + !this.systemNumber.string()
  mess "$!this.messageFile" over

  -- Detail drawing
  do !branch values !this.branchList
    add $!branch
  enddo
  DETAIL all as |$!systemName|
  handle any
  endhandle

  -- display sheets
  !this.displaySheets()

endmethod
-- End of method definition for .produceSystemIso()

------------------------------------------------------------------------
--
-- Method:      showSystem
--
-- Description: Enhance the pipe network defined as the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    BOOLEAN    Enhance on/off
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showSystem(!option is BOOLEAN)

  unenhance all
  if (!option.not()) then
    return
  endif

  -- Check options file
  if ( !this.optionsFile eq || ) then
    return error 1 |No options file selected|
  endif

  !this.findSystem()
  handle ANY
    !!alert.error(!!error.text)
    !module = !!module()
    if (!module.appkey.upcase() inset('DES')) then
      !!appDesMain.sysutil.select('Show Pipe System', false)
    else
      !!spooler.utilities.select('Show Pipe System', false)
    endif
    return
  endhandle

  -- enhance pipe
  do !branch values !this.branchList
    add $!branch
    enhance $!branch colour $!!gphColOpt.highlight.code
  enddo

endmethod
-- End of method definition for .showSystem()

------------------------------------------------------------------------
--
-- Method:      findSystem
--
-- Description: Find the elements that define the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findSystem()

  !this.branchList = ARRAY()

  -- Detail CE - check type is valid for detailing
  !this.selectedElement = !!ce
  !validTypes[1] = 'BRAN'
  !this.isoElement = !!dtbOwnerOfTypes(!this.selectedElement, !validTypes)

  if (!this.isoElement.unset()) then

    -- test for pipe
    if( !this.selectedElement.type eq 'PIPE' ) then
      !pipeMembers = !this.selectedElement.members
      do !branch values !pipeMembers
        if(!branch.type eq 'BRAN') then
          !this.branchList.append(!branch)
        endif
      enddo
      !pipeBranches = !this.branchList
      do !scanBranch values !pipeBranches
        -- scan for pipe network
        !this.scanPipeNetwork(!scanBranch)
      enddo
    else
      -- Cannot access from this level
      return error 1 |Utility only available for PIPE or BRANCH|
    endif

  else

    -- Specific handle for HVAC branch
    if (!this.isoElement.owner.type eq 'HVAC') then
      return error 1 |Utility not available for an HVAC system|
    endif

    -- at a branch element
    !this.branchList[1] = !this.isoElement

    -- scan for pipe network
    !this.scanPipeNetwork(!this.isoElement)

  endif

endmethod
-- End of method definition for .findSystem()

-----------------------------------------------------------------------
--
-- Method:      prepareToDetail
--
-- Description: Preprocessing for detailing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Iso type SYS or STD
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .prepareToDetail(!isoType is STRING)

  -- Isometric type is SYS or STD
  options default
  -- options file
  !this.setOptionsFile(!isoType)

  $M "$!<this.optionsFile>"
  handle any
    write |Options file problem: $!!error.text|
    options default
  endhandle

endmethod
-- End of method definition for .prepareToDetail()

----------------------------------------------------------------------
--
-- Method:      getIsodrawStatus
--
-- Description: Return Isodraw status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Status
--
------------------------------------------------------------------------

define method .getIsodrawStatus() is STRING

  -- Check Isodraw status
  var !status isodraw status
  handle any
    -- Isodraw has not run
    !status = 'FAILED'
  endhandle
  return !status

endmethod
-- End of method definition for .getIsodrawStatus()

----------------------------------------------------------------------
--
-- Method:      getIsodrawSheets
--
-- Description: Get sheets generated by isodraw run
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getIsodrawSheets()

  -- Get list of drwgs
  var !isoCountTemp isodraw number
  handle any
    -- Isodraw has not run
    !isoCountTemp = '0'
  endhandle
  !isoCount = !isoCountTemp.real()

  !unusedDirectory = ''
  !sheetCount = 0

  -- loop through isodraft plots
  do !plot to !isoCount

    -- Plotfile details
    var !plotFile isodraw plotfile $!plot filename
    var !hyperplant hyperplant
    if (!hyperplant.match('ON') GT 0 ) then
      !plotFile = !plotFile & '.plt'
    endif
    var !drawingType isodraw plotfile $!plot type
    if ( !drawingType.upcase() eq 'PLOT' or !drawingType.upcase() eq 'BOTH' ) then
      !rootName = !plotFile.after('/')
    else
      -- ????? -- The type may be a pdf for instance so do not issue a warning
      -- return silently
      -- return error 1 |Plot output format should be type PLOT|
      return
    endif

    -- Number of drwgs in plotfile not used to loop through here
    var !unusedNumberOfDrawings isodraw plotfile $!plot number
    -- Drwg details (only use first sheet of multiple plotfile in list)
    var !pipeName isodraw plotfile $!plot drawing 1 title
    var !sheet isodraw plotfile $!plot drawing 1 sheet
    var !sheetName '$!pipeName Sht $!sheet'
    -- Plotted or failed status not used here
    var !plotStatus isodraw plotfile $!plot drawing 1 status

    -- Add to display list
    !sheetCount = !sheetCount + 1
    !this.plotFileList.append(!plotFile)
    !this.rootNameList.append(!rootName)
    !this.pipeNameList.append(!pipeName)
    !this.sheetList.append(!sheet)
    !this.sheetNameList.append(!sheetName)
    !this.plotStatusList.append(!plotStatus)
    !this.sheetListReturnText.append('$!rootName$N_isodraftsheet$!sheetCount')

    -- Store plotfile for later deletion
    -- !!isoPlotFiles.append(!rootName)

  enddo

endmethod
-- End of method definition for .getIsodrawSheets()

----------------------------------------------------------------------
--
-- Method:      displayResults
--
-- Description: Display the results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayResults()

  if ( !this.interactive ) then
    !this.form.setDisplay(!this.sheetNameList,!this.rootNameList,!this.messageFile)
    !this.form.show('FREE')
--    !this.form.maximised=false
  else
    !transferFile = object FILE('previewisotransfer.txt')
    !transferArray[1] = !this.messageFile
    !transferArray[2] = !this.status
    !transferArray.appendArray(!this.sheetNameList)
    !transferArray.appendArray(!this.rootNameList)
    !transferFile.writefile('OVERWRITE', !transferArray)
  endif

endmethod
-- End of method definition for .displayResults()

-----------------------------------------------------------------------
--
-- Method:      setOptionsFile
--
-- Description: Set the options file to be used
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Iso type SYS or STD
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOptionsFile(!isoType is STRING)

  -- Assign option file for Imperial/Metric units
  !unitSelect = !!distanceFmt.units
  if( !unitSelect eq 'MM' ) then
  -- Isometric type is SYS or STD
  if( !isoType eq 'SYS' ) then
    !fileName   = '\SYS\previewisosys.txt'
  else
    !fileName = '\STD\previewisostd.txt'
    endif
  else
    -- Isometric type is SYS or STD
    if( !isoType eq 'SYS' ) then
      !fileName = '\SYS\previewisosysinch.txt'
    else
      !fileName = '\STD\previewisostdinch.txt'
    endif
  endif

  -- Look in PDMSUSER directory ******
  !optionsFile = object FILE('%PDMSUSER%' & !fileName)

  if (!optionsFile.exists().not()) then

    -- Look in Project defaults directory ******
    var !projectCode project code
    !projectFile = '%' & !projectCode & 'ISO%' & !fileName
    !optionsFile = object FILE(!projectFile)

    if (!optionsFile.exists().not()) then

      -- Look in PDMSDFLTS directory ******
      !optionsFile = object FILE('%PDMSDFLTS%' & !fileName)

      if (!optionsFile.exists().not()) then

        !!alert.error('Options file cannot be found')
        return

      endif

    endif

  endif

  -- Set the member
  !this.optionsFile = !optionsFile.fullname()

endmethod
-- End of method definition for .setOptionsFile()

-----------------------------------------------------------------------
--
-- Method:      scanPipeNetwork
--
-- Description: Identify the elements that make up the pipe network defined as the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     DBREF     Any branch element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .scanPipeNetwork(!scanRoot is DBREF)

  !validTypes[1] = 'BRAN'
  -- Isometric type is SYS or STD
  !list = !scanRoot.members
  !list.appendArray(!scanRoot.connections)
  do !element values !list
    !connections = !element.connections
    !connections.append(!element)
    do !connItem values !connections
      !connBranch = !!dtbOwnerOfTypes(!connItem, !validTypes)
      if (!connBranch.set()) then
        if( !this.branchList.findFirst(!connBranch).unset() ) then
          !this.branchList.append(!connBranch)
          !this.scanPipeNetwork(!connBranch)
        endif
      endif
    enddo
  enddo
  return

endmethod
-- End of method definition for .scanPipeNetwork()
