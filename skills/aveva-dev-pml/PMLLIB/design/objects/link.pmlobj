-- Description:
-- Contains information for a link definition.
--
------------------------------------------------------------------------

-- Define object
define object LINK

  -- Description
  member .description is STRING
  -- Function
  member .function    is STRING
  -- Purpose
  member .purpose     is STRING
  -- Number
  member .number      is REAL
  -- Gtype
  member .gType       is STRING
  -- From Port Number
  member .fpoNumber   is REAL
  -- To Port Number
  member .tpoNumber   is REAL
  -- Master Link
  member .mflg        is BOOLEAN
  -- Dkey
  member .dKey        is STRING
  -- Local Axes (removed at present as an Unset ORIENTATION object
  -- is returning true when you use .set() on it!!)
--  member .laxes       is ORIENTATION

endobject
-- End of object definition for LINK
