--
--
-- Description:
-- Object to merge generic section.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  enhance(EDGPICKDATA,COLOUR)      -                   Enhance colour of picked elements
--  merge()                          -                   Process merge
--  mergeGenSectPane(STRING)         -                   Constructor
--  optGensec(ARRAY)                 -
--  optPanel(ARRAY)                  -
--  optSctn(ARRAY)                   -
--  pickPacket()                     -
--  tidy(ARRAY)                      -                   Make the graphical canvas tidy
--

------------------------------------------------------------------------


define object MERGEGENSECTPANE

  -- store definitions of first EDG packet
  member .pick  is EDGPACKET

  -- Store picked elements in an array
  member .pickedItems  is ARRAY

  -- Store positions of picked elements in an array
  member .pickedPoint is ARRAY

  -- Store current element
  member .refItem is DBREF

  -- Store the type of operation selected by the user
  member .operation is STRING

  -- Aid number for profile start and end
  member .aidNumberPro is REAL

  -- Aid number for merging ends
  member .aidNumberMerg is REAL

  -- Define an undo object
  member .markForUndo is UNDOABLE

  -- Colour
  member .standardColour is COLOUR

endobject
-- End of object definition for MERGEGENSECTPANE

------------------------------------------------------------------------
--
-- Method:      mergeGenSectPane
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mergeGenSectPane(!opt is STRING)

  !this.standardColour = object COLOUR('TURQUOISE')
  !this.operation     =  !opt

  -- Clean the object members
  !this.pickedItems.clear()
  !this.pickedPoint.clear()

  -- Define EDG packet for picking elements to be split

  !packet             =   object EDGPACKET()
  if(!opt eq 'Merge')then
     !packet.elementPick('Pick Panel/Section or End of first gensec to merge')
     !packet.description     =   'Pick Gensec/Panel/Section to merge'

     -- Add filter for Pick
     !packet.pickPacket.picks[1].pick.input[3]   = |match('GENSEC PANE SCTN',TYPE) gt 0|
     !packet.pickPacket.picks[1].pick.modifiable = FALSE
  else
     !packet.elementPick('Pick end of first gensec/section to fillet')
     !packet.description     =   'Pick Gensec/Section to fillet'

     -- Add filter for Pick

     !packet.pickPacket.picks[1].pick.input[3]   = |match('GENSEC SCTN',TYPE) gt 0|
     !packet.pickPacket.picks[1].pick.modifiable = FALSE
  endif
  !packet.action          =   '!!mergeObject.enhance(!this.return[1], !!gphColOpt.highlight)'

  !packet.priority        =   2
  !packet.remove          =   TRUE

  !packet.continue        = '!!mergeObject.pickPacket()'
  !!edgCntrl.add(!packet)
  !this.pick  =  !packet

endmethod
-- End of method definition for .mergeGenSectPane()

------------------------------------------------------------------------
--
-- Method:      pickPacket
--
-- Description: pick further elements based on the first pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPacket()

  !completePicks          =   !this.pick
  !completePicks.action   =   '!!mergeObject.enhance(!this.return[1], !!mergeObject.standardColour)'
  if(!this.pickedItems.set().not())then
     return
  endif

  if(!this.pickedItems[1].type eq 'GENSEC')then

     if(!this.operation eq 'Merge')then
        !completePicks.pickPacket.prompt  =  'Pick the end of second gensec to merge'
        !completePicks.pickPacket.picks[1].pick.input[3]   = |match('GENSEC',TYPE) eq 1|
     else
        !completePicks.pickPacket.prompt  =  'Pick the end of second gensec or Section to fillet'
        !completePicks.pickPacket.picks[1].pick.input[3]   = |TYPE INSET('GENSEC','SCTN')|
     endif

     !completePicks.pickPacket.picks[1].pick.modifiable = FALSE
     !completePicks.continue     =  '!!mergeObject.merge()'
     !completePicks.escape       =  '!!mergeObject.merge()'

  elseif(!this.pickedItems[1].type eq 'SCTN')then

     if(!this.operation eq 'Merge')then
        !completePicks.pickPacket.prompt  =  'Pick the end of second Section to merge'
        !completePicks.pickPacket.picks[1].pick.input[3]   = |match('SCTN',TYPE) eq 1|
     else
        !completePicks.pickPacket.prompt  =  'Pick the end of second gensec or Section to fillet'
        !completePicks.pickPacket.picks[1].pick.input[3]   = |TYPE INSET('GENSEC','SCTN')|
     endif

     !completePicks.pickPacket.picks[1].pick.modifiable = FALSE
     !completePicks.continue     =  '!!mergeObject.merge()'
     !completePicks.escape       =  '!!mergeObject.merge()'

  else
     -- panel
     !completePicks.pickPacket.prompt  =  'Pick Panel to merge or <esc> to finish'
     !completePicks.remove             =  FALSE
     !completePicks.pickPacket.picks[1].pick.input[3]     =   |match('PANE1',TYPE) eq 1|
     !completePicks.pickPacket.picks[1].pick.modifiable   =   FALSE
     !completePicks.escape   =  '!!mergeObject.merge()'
  endif

  !!edgCntrl.add(!completePicks)

endmethod
-- End of method definition for .pickPacket()
------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: merge based on the type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .merge()

-- Store current element as a member of the object
!this.refItem   =   !!ce

!toMerge        =   !!mergeObject.pickedItems
!toMerge.unique()

!size   =  !toMerge.size()

-- Cannot merge if only one section is picked
if(!size eq 1) then
   !!alert.error('At least two items should be picked')
   !this.tidy(!toMerge)
   !this.markForUndo.endundoable()
   return
endif

-- Register for aid numbers
!this.aidNumberPro  =  !!aidNumbers.add('Graphical aids to represent profile start and end')
!this.aidNumberMerg =  !!aidNumbers.add('Graphical aids to represent merging ends')

  -- UNDO
  !this.markForUndo.add()

if(!toMerge[1].type eq 'GENSEC')then
   -- GENSEC to GENSEC or SCTN merge
   !this.optGensec(!toMerge)
elseif(!toMerge[1].type eq 'PANE')then
   !this.optPanel(!toMerge)
elseif(!toMerge[1].type eq 'SCTN' and !toMerge[2].type eq 'GENSEC')then
   -- SCTN to GENSEC merge - swap elements
   !temp[1] = !toMerge[2]
   !temp[2] = !toMerge[1]
   !this.optGensec(!temp)
else
   -- SCTN to SCTN merge
   !this.optSctn(!toMerge)
endif

!this.markForUndo.endundoable()
!!ce   =   !this.refItem
handle any
endhandle

endmethod
-- End of method definition for .merge()

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: Enhance colour of picked elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhance(!pickData is EDGPICKDATA, !colour is COLOUR)

   -- Deselect if already picked element has been picked.
   !isPicked = !this.pickedItems.find(!pickData.item)

   if(!isPicked.set())then
      !this.pickedItems[!isPicked[1]].delete()
      !this.pickedPoint[!isPicked[1]].delete()
      UNENHANCE $!pickData.item
      !this.pickedItems.compress()
      !this.pickedPoint.compress()
   else
      -- Append if the item is picked for the first time
      !this.pickedItems.append(!pickData.item)
      ENHANCE $!pickData.item COLOUR $!colour.code
      !this.pickedPoint.append(!pickData.pickline)
   endif

endmethod

-- End of method definition for .enhance()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Make the graphical canvas tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy(!elements is ARRAY)
   do !i indices !elements
      UNENHANCE $!elements[$!i]
      !!aidNumbers.remove(!this.aidNumberPro)
      !!aidNumbers.remove(!this.aidNumberMerg)
   enddo
endmethod

-- End of method definition for .tidy()
-----------------------------------------------------------------------------------------
--
-- Method:      optGensec
--
-- Description: Give the user options to choose the end result while merging gensec elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------------------------

define method .optGensec(!toMerge is ARRAY)

   do !i indices !toMerge
      if(!toMerge[!i].type eq 'SCTN') then
        !sctn        = !toMerge[!i]
        !firstPlane  = !profile[1].plane()
        if( !sctn.poss.distance(!firstPlane) gt 0.1mm or !sctn.pose.distance(!firstPlane) gt 0.1mm ) then
          !!alert.error('GENSEC and SCTN elements picked are not coplanar')
          !this.tidy(!toMerge)
          return
        endif
        !line[1]     = object LINE(!sctn.poss, !sctn.pose)
        !profile[!i] = object PROFILE(!sctn.poss,!profile[1].orientation,!line)
        handle any
          !!alert.error('GENSEC and SCTN elements picked are not coplanar')
          !this.tidy(!toMerge)
          return
        endhandle
      else
        !spine[!i]   =  !!dtbMemberOfType(!toMerge[!i],'SPINE',1)
        !profile[!i] =  object PROFILE(!spine[!i])
      endif
      !zDir[!i]      =  !profile[!i].orientation.zDir()
      !plane[!i]     =  !profile[!i].plane()

      -- Gensec elements picked should be coplanar
      if(!zDir[!i] eq !zDir[1] OR !zDir[!i].opposite() eq !zDir[1]) then
         if(!plane[!i].position.distance(!plane[1]) gt 0.1mm) then
            !!alert.error('Gensec elements picked are not coplanar')
            !this.tidy(!toMerge)
            return
         endif
      else
         !!alert.error('Gensec elements picked are not coplanar')
         !this.tidy(!toMerge)
         return
      endif
   enddo

   !pickedPosOnFirstGen   =   !this.pickedPoint[1].intersection(!plane[1])
   !pickedPosOnSecGen     =   !this.pickedPoint[2].intersection(!plane[2])

   -- Manipulate the end picked for first gensec.
   if((!pickedPosOnFirstGen.distance(!toMerge[1].poss)) gt (!pickedPosOnFirstGen.distance(!toMerge[1].pose)))then
      !firstGensecPos   =   'End'
      !markerFirst      =   !toMerge[1].pose
   else
      !firstGensecPos   =   'Start'
      !markerFirst      =   !toMerge[1].poss
   endif

   -- Manipulate the end picked for second gensec.
   if((!pickedPosOnSecGen.distance(!toMerge[2].poss)) gt (!pickedPosOnSecGen.distance(!toMerge[2].pose)))then
      !secGensecPos   =   'End'
      !markerSec      =   !toMerge[2].pose
   else
      !secGensecPos   =   'Start'
      !markerSec      =   !toMerge[2].poss
   endif

    -- Mark the ends picked
   if(!markerFirst.distance(!markerSec) lt 200mm)then
      AID TEXT NUM $!this.aidNumberMerg 'End-1 & End-2 ' at $!markerSec
   else
      AID TEXT NUM $!this.aidNumberMerg 'End-1' at $!markerFirst
      AID TEXT NUM $!this.aidNumberMerg 'End-2' at $!markerSec
   endif

   -- Bring the gensec profile in the same sense.
   if(!firstGensecPos eq 'End')then
      if(!secGensecPos eq 'End')then
         !profile[2].reverse()
      endif

   else
      !profile[1].reverse()
      if(!secGensecPos eq 'End')then
         !profile[2].reverse()
      endif

   endif

   !collToAdd      =   !profile[2].edges()
   !collLineArc    =   !profile[1].edges()

   !firstGeom      =   !collLineArc.last()
   !secGeom        =   !collToAdd.first()
   !markForIntr    =   !collLineArc.size()

   if(!firstGeom.objectType() eq 'ARC' AND !secGeom.objectType() eq 'ARC' )then
      !firstTan    =   !firstGeom.endTangent()
      !secTan      =   !secGeom.startTangent()
      !angleTan    =   !firstTan.angle(!secTan)
      !pointV1     =   object POINTVECTOR(!firstGeom.anglePosition(!firstGeom.endangle),!firstTan)
      !pointV2     =   object POINTVECTOR(!secGeom.anglePosition(!secGeom.startangle),!secTan)

      !line1       =   !pointV1.line(50mm)
      !line2       =   !pointV2.line(50mm)

      if((!firstGeom.position.distance(!secGeom.position) lt 0.1mm) AND (!firstGeom.radius.int() eq !secGeom.radius.int()))then
         if(!this.operation eq 'Fillet')then
            !!alert.error('These ends cannot make a fillet!!')
            !this.tidy(!toMerge)
            return
         endif

         !constArc1   =   !firstGeom.endPosition(!secGeom.anglePosition(!secGeom.startangle))
         !constArc2   =   !firstGeom.endPosition(!secGeom.anglePosition(!secGeom.endangle))
         !constArc3   =   !secGeom.startPosition(!firstGeom.anglePosition(!firstGeom.startangle))
         !constArc4   =   !secGeom.startPosition(!firstGeom.anglePosition(!firstGeom.endangle))

         if((!constArc2.angle() lt !constArc1.angle()) OR (!constArc3.angle() lt !constArc4.angle()))then
            !!alert.error('Cannot perform this operation on the selected ends!!')
            !this.tidy(!toMerge)
            return
         endif

         !replArc  =   !firstGeom.endPosition(!secGeom.anglePosition(!secGeom.endangle))

         if((!replArc.angle() ge 180) AND (!toMerge[1].function ne 'RING'))then
            !!alert.error('Cannot perform this operation on the selected ends!!')
            !this.tidy(!toMerge)
            return
         endif

         if(!replArc.angle() lt 360)then
            !collLineArc[!markForIntr]  =  !replArc
            !collToAdd[1].delete()
            !collToAdd.compress()
         endif

      else
         if(!line1.distance(!line2) gt 0.01mm)then
            !!alert.error('Cannot perform this operation on the selected ends!!')
            !this.tidy(!toMerge)
            return
         endif

         if((!angleTan lt 179.5) AND (!angleTan gt 0.5))then
            if(!this.operation eq 'Merge')then
               !!alert.error('These ends cannot be merged!!')
               !this.tidy(!toMerge)
               return
            endif
            !interSctnPt  =   !pointV1.intersection(!pointV2)

            !constrLine1  = object LINE(!firstGeom.anglePosition(!firstGeom.endangle),!interSctnPt)
            !constrLine2  = object LINE(!secGeom.anglePosition(!secGeom.startangle),!interSctnPt)

            if((!constrLine1.direction() eq !firstGeom.endTangent().opposite()) OR (!constrLine2.direction() eq !secGeom.startTangent()))then
               !!alert.error('These ends cannot make a fillet!!')
               !this.tidy(!toMerge)
               return
            endif

            !newLine1     =   object LINE(!firstGeom.anglePosition(!firstGeom.endangle),!interSctnPt)
            !collLineArc.append(!newLine1)
            !newLine2     =   object LINE(!interSctnPt,!secGeom.anglePosition(!secGeom.startangle))
            !collToAdd.insert(1,!newLine2)
         else
            if(!this.operation eq 'Fillet')then
               !!alert.error('These ends cannot make a fillet!!')
               !this.tidy(!toMerge)
               return
            endif
            if(!line1.direction() eq !line2.direction().opposite())then
               !!alert.error('These ends cannot be merged!!')
               !this.tidy(!toMerge)
               return
            endif
         endif
      endif
   elseif(!firstGeom.objectType() eq 'LINE')then
       if(!secGeom.objectType() eq 'LINE')then
          if(!firstGeom.distance(!secGeom) gt 0.01mm)then
             !!alert.error('Cannot perform this operation on the selected ends!!')
             !this.tidy(!toMerge)
             return
          endif
          if(!this.operation eq 'Merge')then

             !checkDis[1]  =  !firstGeom.endPosition.distance(!secGeom.startPosition)
             !checkDis[2]  =  !firstGeom.endPosition.distance(!secGeom.endPosition)
             !checkDis[3]  =  !firstGeom.startPosition.distance(!secGeom.startPosition)
             !checkDis[4]  =  !firstGeom.startPosition.distance(!secGeom.endPosition)

             !shortestDis  =  !checkDis[1]
             !checkDis.sort()
             if(!checkDis[1] ne !shortestDis)then
                !!alert.error('Cannot merge the selected ends!!')
                !this.tidy(!toMerge)
                return
             endif
          endif

          !interSctnPt  =  !firstGeom.intersection(!secGeom)
          handle (2,870)
             if(!this.operation eq 'Fillet')then
               !!alert.error('These ends cannot make a fillet!!')
               !this.tidy(!toMerge)
               return
             endif
          elsehandle NONE
             if(!this.operation eq 'Merge')then
                !!alert.error('These ends are not collinear and cannot be merged!!')
                !this.tidy(!toMerge)
                return
             endif

             !constrLine1  = !firstGeom.to(!interSctnPt)
             !constrLine2  = !secGeom.from(!interSctnPt)
             if((!constrLine1.direction() eq !firstGeom.direction().opposite()) OR (!constrLine2.direction() eq !secGeom.direction().opposite()))then
                !!alert.error('These ends cannot make a fillet!!')
                !this.tidy(!toMerge)
                return
             endif

          endhandle
       else
          !pointV1      =   object POINTVECTOR(!secGeom.anglePosition(!secGeom.startangle),!secGeom.startTangent())
          !line1        =   !pointV1.line(50)

          if(!firstGeom.distance(!line1) gt 0.01mm)then
             !!alert.error('Cannot perform this operation on the selected ends!!')
             !this.tidy(!toMerge)
             return
          endif

          !interSctnPt  =   !pointV1.intersection(!firstGeom)
          handle (2,877)
             if(!this.operation eq 'Fillet')then
                !!alert.error('These ends cannot make a fillet!!')
                !this.tidy(!toMerge)
                return
             endif
             if(!firstGeom.direction() eq !line1.direction().opposite())then
               !!alert.error('These ends cannot be merged!!')
               !this.tidy(!toMerge)
               return
             endif
          elsehandle NONE
             if(!this.operation eq 'Merge')then
                !!alert.error('These ends are not collinear and cannot be merged!!')
                !this.tidy(!toMerge)
                return
             endif
             !constrLine1  = !firstGeom.to(!interSctnPt)
             !constrLine2  = object LINE(!secGeom.anglePosition(!secGeom.startangle),!interSctnPt)

             if((!constrLine1.direction() eq !firstGeom.direction().opposite()) OR (!constrLine2.direction() eq !secGeom.startTangent()))then
                !!alert.error('These ends cannot make a fillet!!')
                !this.tidy(!toMerge)
                return
             endif
             !newLine1     =   object LINE(!interSctnPt,!secGeom.anglePosition(!secGeom.startangle))
             !collToAdd.insert(1,!newLine1)
          endhandle
       endif
   else
      !pointV1      =   object POINTVECTOR(!firstGeom.anglePosition(!firstGeom.endangle),!firstGeom.endTangent())
      !line1        =   !pointV1.line(50)

      if(!secGeom.distance(!line1) gt 0.01mm)then
         !!alert.error('Cannot perform this operation on the selected ends!!')
         !this.tidy(!toMerge)
         return
      endif

      !interSctnPt  =   !pointV1.intersection(!secGeom)
      handle (2,877)
         if(!this.operation eq 'Fillet')then
            !!alert.error('These ends cannot make a fillet!!')
            !this.tidy(!toMerge)
            return
         endif
         if(!line1.direction() eq !secGeom.direction().opposite())then
            !!alert.error('These ends cannot be merged!!')
            !this.tidy(!toMerge)
            return
         endif
      elsehandle NONE
         if(!this.operation eq 'Merge')then
            !!alert.error('These ends are not collinear and cannot be merged!!')
            !this.tidy(!toMerge)
            return
         endif

         !constrLine1  = !secGeom.from(!interSctnPt)
         !constrLine2  = object LINE(!firstGeom.anglePosition(!firstGeom.endangle),!interSctnPt)

         if((!constrLine1.direction() eq !secGeom.direction().opposite()) OR (!constrLine2.direction() eq !firstGeom.endTangent().opposite()))then
            !!alert.error('These ends cannot make a fillet!!')
            !this.tidy(!toMerge)
            return
         endif
         !newLine1     =   object LINE(!firstGeom.anglePosition(!firstGeom.endangle),!interSctnPt)
         !collLineArc.append(!newLine1)
      endhandle
   endif

   !firstGeom.delete()
   !secGeom.delete()

   !markForIntr     =   !collLineArc.size()

   do !i indices !collToAdd
      !collLineArc.append(!collToAdd[!i])
   enddo


   if(!this.operation eq 'Fillet')then

      -- Ask user intervention for deciding the radius of the curve of the gensec
      if (!!isImperialLength('DIST')) then
          !inputRadius = !!alert.input('Enter curve radius',|4'|)
      else
          !inputRadius = !!alert.input('Enter curve radius','1000')
      endif
      !radius = $!inputRadius

      -- Smoothen the profile based on the intersection point.
      !pole         =   !collLineArc[!markForIntr].intersection(!collLineArc[!markForIntr + 1])
      !direction    =   !profile[1].orientation.zDir()
      !posStart     =   !collLineArc[!markForIntr].startPosition
      !posEnd       =   !collLineArc[!markForIntr + 1].endPosition
      !arc          =   !pole.arcFillet(!posStart,!posEnd,!direction,!radius)

      handle ANY
         !!alert.error('These ends cannot make a fillet!!')
         !this.tidy(!toMerge)
         return
      endhandle

      -- Modify the end positions of existing lines
      !collLineArc[!markForIntr].endPosition       = !arc.anglePosition(!arc.startangle)
      !collLineArc[!markForIntr + 1].startPosition = !arc.anglePosition(!arc.endangle)

      !collLineArc.insert(!markForIntr + 1,!arc)
   endif

   -- Confirm before proceeding further
   if(!this.operation eq 'Merge')then
      !check   =   !!alert.confirm('Are you sure you want to merge these ends?')
   else
      AID TEXT NUM $!this.aidNumberMerg 'Fillet Point' at $!pole
      !check   =   !!alert.confirm('Are you sure you want to fillet these ends?')
   endif

   if(!check eq 'NO')then
      !this.tidy(!toMerge)
      return
   endif

   -- Create merge profile based on the profiles passed
   !mergeProfile   =  object PROFILE(!toMerge[1].pos,!toMerge[1].ori,!collLineArc)

   -- Remove close points and collinear lines. Tolerance supplied is empirical.
   !mergeProfile.mergePoints(1)

   -- To remove additional poinsp from a closed profile.
   if(!mergeProfile.isClosed())then

      !collLineArc    =   !mergeProfile.edges()

      !firstGeom      =   !collLineArc.first()
      !secGeom        =   !collLineArc.last()

      if(!firstGeom.objectType() eq 'ARC' AND !secGeom.objectType() eq 'ARC')then
         if(!firstGeom.position.distance(!secGeom.position) lt 1mm)then
            !replArc        =  !firstGeom.startPosition(!secGeom.anglePosition(!secGeom.startangle))

            if(!replArc.angle() lt 360)then
               !collLineArc[1] =  !replArc
               !collLineArc[!collLineArc.size()].delete()
               !collLineArc.compress()

               !mergeProfile   =   object PROFILE(!toMerge[1].pos,!toMerge[1].ori,!collLineArc)

               -- This is to remove redundant points. Tolerance is empirical
               !mergeProfile.mergePoints(1)
            endif
         endif
      endif
      !firstGeom.delete()
      !secGeom.delete()
   endif

   -- Collect all fittings
   !collection = object COLLECTION()
   !collection.scope(!toMerge)
   !collection.type('JLDATU')
   !jldatuColl = !collection.results()

   do !i indices !jldatuColl
      !jldatuPos[!i]    = !jldatuColl[!i].pos.wrt(world)
   enddo

   !!ce = !!dtbMemberOfType(!toMerge[1],'SPINE',1)
   !mergeProfile.dbWrite(!!ce)

   !!ce = !toMerge[1]
   -- Reposition all fittings
   do !i indices !jldatuColl
      !posOnProfile     = !mergeProfile.near(!jldatuPos[!i])
      !newZdist         = !!spineDisPos(!!ce,!posOnProfile)
      INCLUDE $!jldatuColl[$!i]
      handle ANY
      endhandle
      !jldatuColl[!i].zDist  =  !newZdist
   enddo

   !this.tidy(!toMerge)

   !!ce = !toMerge[2]
   if(!!ce eq !this.refItem)then
      !this.refItem = !toMerge[1]
   endif
   if( !!ce.type eq 'SCTN' ) then
     DELETE SCTN
   else
     DELETE GENSEC
   endif

   -- This removes the additional POINSPs if any and convert the GENSEC to a modifiable one.
   if(!toMerge[1].function ne 'RING')then
      !toMerge[1]  =  !!spineTidy(!toMerge[1])
   endif
   -- Reset current element
   !!ce  =  !this.refItem
endmethod
-- End of method definition for .optGensec()
-----------------------------------------------------------------------------------------
--
-- Method:      optPanel
--
-- Description: If user picks panels to merge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------------------------

define method .optPanel(!toMerge is ARRAY)
   do !i indices !toMerge
      -- Take out the profile
      !!ce          =  !toMerge[!i]
      !ploo[1]      =  !!dtbMemberOfType(!!ce,'PLOO',1)
      !profile[!i]  =  object PROFILE(!ploo[1])
      !plane[!i]    =  !profile[!i].plane()

      !zDir[!i]     =  !toMerge[!i].orientation.zDir()

      if(!zDir[!i] eq !zDir[1] OR !zDir[!i].opposite() eq !zDir[1]) then
         -- The tolerance applied below is empirical. Revisit if required.
         if(!plane[!i].position.distance(!plane[1]) gt 1mm) then
            !!alert.error('Panels picked are not coplanar')
            !this.tidy(!toMerge)
            return
         endif
      else
         !!alert.error('Panels picked are not coplanar')
         !this.tidy(!toMerge)
         return
      endif
   enddo

   !toDelete        =     ARRAY()
   !inclFittNxtr    =     ARRAY()
   !newNxtr         =     ARRAY()
   !storeForCheck   =     ARRAY()
   !checkProForNxtr =     ARRAY()

   !toDelete.append(!toMerge[1])
   !checkProForNxtr.append(!profile[1])

   !count         =  !profile.size()
   do !j from 1 to !count
      do !i indices !profile
         -- First profile is always the merge-to profile so skip it.
         skip if(!i eq 1)
         !noIntersection  =  BOOLEAN()
         !noIntersection  =  !profile[1].isIntersecting(!profile[!i]).not()
         handle any
            skip
         endhandle
         -- skip if the profiles are neither intersecting nor lying within each other.
         if(!noIntersection.set())then
            skip if(!noIntersection AND !profile[1].isWithin(!profile[!i]).not() AND !profile[!i].isWithin(!profile[1]).not())
         endif

         !union   =  !profile[1].union(!profile[!i])
         handle ANY
            skip
         endhandle
         if(!union.unset())then
            skip
         endif

         -- If the union is valid proceed ,else skip
         skip if(!union[1].isValidClosed().not())

         -- If there are negative profiles in the union
         if(!union.size() gt 1)then
            if(!profile.size() ne (!storeForCheck.size() + 1))then
               !storeForCheck.append(!profile[!i])
               !storeForCheck.unique()
               skip
            endif
         endif

         -- Merge redundant lines.
         !union[1].mergeLines()
         !profile[1]   =  !union[1]

         !findInStore  =  !storeForCheck.find(!profile[!i])
         if(!findInStore.set())then
            !storeForCheck[!findInStore[1]].delete()
         endif

         -- Collect new negative extrusions
         do !k indices !union
            skip if(!k eq 1 OR !union[!k].isValidClosed().not())
            do !p indices !profile
               skip if(!p eq 1)
               if(!profile[!p].intersect(!union[!k]).set())then
                  !union[!k]  =  !union[!k].difference(!profile[!p])[1]
               endif
            enddo

            if(!union[!k].set())then
               !union[!k].mergeLines()
               if(!union[!k].isValidClosed())then
                  !newNxtr.append(!union[!k])
               endif
            endif
         enddo

         --Delete the profiles,append the element for deletion.
         !checkProForNxtr.append(!profile[!i])
         !profile[!i].delete()
         !toDelete.append(!toMerge[!i])

      enddo

      -- If the current profile doesn't find any other profile for merging, shuffle the array.
      if((!j ne !count) AND (!toDelete.size() eq 1))then
         !indexArray      =  !profile.indices()
         !firstIndex      =  !indexArray.removeFirst()
         !lastIndex       =  !indexArray.removeLast()

         !indexArray.insert(1,!lastIndex)
         !indexArray.append(!firstIndex)

         !profile.reIndex(!indexArray)
         !toMerge.reIndex(!indexArray)
         !toDelete[1]        =  !toMerge[1]
         !checkProForNxtr[1] =  !profile[1]

      endif

      -- Check if merging is completed
      if(!profile.size() eq 1)then
         break
      endif
   enddo

   -- If any panel cannot be merged in, put a flag
   if(!profile.size() gt 1)then
      !inComplete = TRUE
   else
      !inComplete = FALSE
   endif

   !toDelete.unique()
   if(!toDelete.size() eq 1)then
      !!alert.error('No merging point/edges were found!!')
      !this.tidy(!toMerge)
      return
   endif

   -- Give a feel of the resulting panel
   do !i indices !toDelete
      ENHANCE $!toDelete[$!i] colour DEEPPINK
   enddo

   if(!inComplete)then
      !confirm  =  !!alert.confirm('Some panels could not be merged.Would you like to proceed merging as shown?')
   else
      !confirm  =  !!alert.confirm('Would you like to proceed merging as shown?')
   endif

   if(!confirm eq 'NO')then
      !this.tidy(!toMerge)
      return
   endif

   -- mark the loop for later assignment of attributes in the merged loop
   !masterLoop         =  !!dtbMemberOfType(!toDelete[1],'PLOO',1)

   -- Collect fittings in an array
   do !i indices !toDelete
      !inclFittNxtr.appendArray(!toDelete[!i].members)
   enddo

   !!ce = !toMerge[1].owner

   -- Create a new PANE
   NEW PANE COPY ATT OF $!toDelete[1]
    handle ANY
        !!alert.error( 'Cannot merge panels: ' & !!error.text )
        !this.tidy(!toMerge)
        return
    endhandle
   if(!inclFittNxtr.set())then
      !inclFittNxtr.unique()
      !negExtrCount   =  0
      do !i indices !inclFittNxtr
         -- NXTR should not be duplicated while merging.
         if(!inclFittNxtr[!i].type eq 'NXTR')then
            !loop     =  !!dtbMemberOfType(!inclFittNxtr[!i],'LOOP',1)
            !loopProfile[!i]  =   object PROFILE(!loop)

            !skipThisIndex  =  FALSE
            do !j indices !checkProForNxtr
               skip if(!toDelete[!j] eq !inclFittNxtr[!i].owner)
               if(!checkProForNxtr[!j].intersect(!loopProfile[!i]).set())then
                  !newLoopPro     =  !checkProForNxtr[!j].difference(!loopProfile[!i])
                  !newLoopProAlt  =  !loopProfile[!i].difference(!checkProForNxtr[!j])

                  if(!newLoopProAlt.set())then
                     !loopProfile[!i]   =  !newLoopProAlt[1]
                     do !k indices !newLoopProAlt
                        skip if(!k eq 1 OR !newLoopProAlt[1].isWithin(!newLoopProAlt[!k]))
                        !newNxtr.append(!newLoopProAlt[!k])
                     enddo
                  else
                     if(!newLoopPro.unset())then
                        !skipThisIndex  =  TRUE
                        break
                     endif
                  endif
               endif
            enddo

            skip if(!skipThisIndex)

            if(!loopProfile[!i].set())then
               !loopProfile[!i].mergeLines()
               skip if(!loopProfile[!i].isValidClosed().not())
            endif

            -- Write the new profile
            !currentPane  =  !!ce
            $!loop
            !loopProfile[!i].dbWrite(!!ce)
            !!ce  =  !currentPane

            !negExtrCount    =   !negExtrCount + 1

            if(!negExtrCount eq 1)then
               INCLUDE $!inclFittNxtr[$!i]
               !currentPane  =  !!ce
               $!loop
               !loopProfile[!i].dbWrite(!!ce)
               !!ce  =  !currentPane
               skip
            endif

            do !j indices !loopProfile
               skip if(!loopProfile[!i] eq !loopProfile[!j])
               if((!loopProfile[!i].difference(!loopProfile[!j]).unset()) AND (!loopProfile[!i].position eq !loopProfile[!j].position))then
                  !loopProfile[!i].delete()
                  !inclFittNxtr[!i].delete()
                  break
               endif
            enddo

            if(defined(!inclFittNxtr[!i]))then
               INCLUDE $!inclFittNxtr[$!i]
               !currentPane  =  !!ce
               $!loop
               !loopProfile[!i].dbWrite(!!ce)
               !!ce  =  !currentPane
            endif
         elseif(!inclFittNxtr[!i].type ne 'PLOO')then
            !posInclFittNxtr      =  !inclFittNxtr[!i].pos
            INCLUDE $!inclFittNxtr[$!i]
            !inclFittNxtr[!i].pos = !posInclFittNxtr
            -- If the element doesn't have the attribute position.
            handle (41,232)
            endhandle
         endif
      enddo
   endif

   -- Create a new PLOO under PANE and DBWRITE the merged profile.
   NEW PLOO
   !profile[1].dbWrite(!!ce)
   copy attributes of $!masterLoop
   handle ANY
   endhandle

   !profileThickness  =  !!ce.height

   do !i indices !newNxtr
      NEW NXTR
      !!ce.height  =  !profileThickness
      NEW LOOP
      !newNxtr[!i].dbWrite(!!ce)
   enddo

   -- Make the graphics tidy
   !this.tidy(!toMerge)

   -- Navigate to PANEL level
   PANE
   !newPane    =  !!ce

   -- Delete irrelevant COFITTINGS
   !allCofi    =  object COLLECTION()
   !allCofi.scope(!newPane)
   !allCofi.type('COFI')
   !collCofi   =  !allCofi.results()

   do !i indices !collCofi
      if(!collCofi[!i].pfref.owner eq !newPane)then
         $!collCofi[$!i]
         DELETE COFI
      endif
   enddo

   -- Merge up overlapping NXTRs
   !allNxtr    =  object COLLECTION()
   !allNxtr.scope(!newPane)
   !allNxtr.type('NXTR')
   !collNxtr   =  !allNxtr.results()
   !nxtrToDelete   =   ARRAY()
   do !i indices !collNxtr
      !nxtrLoop[!i]    =  !!dtbMemberOfType(!collNxtr[!i],'LOOP',1)
      !nxtrProfile[!i] =  object PROFILE(!nxtrLoop[!i])

      do !j indices !nxtrProfile
         skip if(!i eq !j or !nxtrToDelete.findFirst(!j).set())
         if(!nxtrProfile[!j].isWithin(!nxtrProfile[!i]))then
            !nxtrToDelete.append(!j)
         elseif(!nxtrProfile[!i].isWithin(!nxtrProfile[!j]))then
            !nxtrProfile[!i] =  !nxtrProfile[!j]
            !nxtrToDelete.append(!j)
         else
            skip if(!nxtrProfile[!j].isIntersecting(!nxtrProfile[!i]).not())
            !unionNxtrPro    =  !nxtrProfile[!i].union(!nxtrProfile[!j])
            --handle ANY
              -- skip
            --endhandle
            if(!unionNxtrPro[1] ne !nxtrProfile[!i])then
               !nxtrProfile[!i] =  !unionNxtrPro[1]
               !nxtrToDelete.append(!j)
            endif
         endif
      enddo
   enddo

   !nxtrToDelete.unique()
   do !i indices !nxtrToDelete
      !nxtrLoop[!nxtrToDelete[!i]].delete()
      !nxtrProfile[!nxtrToDelete[!i]].delete()
      !!ce  =  !collNxtr[!nxtrToDelete[!i]]
      DELETE NXTR
   enddo

   do !i indices !nxtrLoop
      !!ce = !nxtrLoop[!i]
      !nxtrProfile[!i].mergeLines()
      !nxtrProfile[!i].dbWrite(!!ce)
   enddo

   -- Delete the merged panels
   do !i indices !toDelete
      $!toDelete[$!i]
      DELETE PANE
        handle ANY
            !!alert.error( 'Cannot delete merged panel: ' & !toDelete[!i].flnn & ' ' & !!error.text )
        endhandle
   enddo

   -- Reset current element
   !!ce   =   !this.refItem
endmethod
-- End of method definition for .optPanel()
-----------------------------------------------------------------------------------------
--
-- Method:      optSctn
--
-- Description: If user picks sections to merge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------------------------

define method .optSctn(!toMerge is ARRAY)

   -- Create a line based on the first section
   !sctnLine      =   object LINE(!toMerge[1].poss,!toMerge[1].pose)

   -- Flag to check whether the sections should be merged to a gensec if the user picks two non-collinear sections
   !mergeToGensec =   FALSE
   !allBanglesSame = true

   -- Append sections to delete in an ARRAY
   !toDelete = ARRAY()

   do !i indices !toMerge
      !startPos[!i]   =   !toMerge[!i].poss
      !endPos[!i]     =   !toMerge[!i].pose
      !line[!i]       =   object LINE(!startPos[!i],!endPos[!i])

      if (!i eq 1) then
          !bangle = !toMerge[1].bangle
          !yDir   = !toMerge[1].yDir.wrt(world)
          !zDir   = !toMerge[1].zDir.wrt(world)
          !jusl   = !toMerge[1].jusl
          skip
      endif

      if (!bangle ne !toMerge[!i].bangle) then
          !allBanglesSame = false
      endif

      !intersection   =   !line[1].intersection(!line[!i])
      handle (2,870)
         if(!this.operation eq 'Fillet')then
            !!alert.error('Fillet cannot act on parallel sections!!')
            !this.tidy(!toMerge)
            return
         endif
      elsehandle NONE
         -- If only two sections are picked which are not parallel, merge them to a gensec?
         if(!this.operation eq 'Fillet' AND (!line[1].distance(!line[!i]) eq 0))then
            !mergeToGensec = TRUE
            break
         else

            if(!this.operation eq 'Fillet')then
               !!alert.error('Fillet can act on coplanar sections only!!')
            else
               !!alert.error('Merge can act on collinear sections only!!')
            endif
            !this.tidy(!toMerge)
            return
         endif
      endhandle

      -- If the sctn elements are parallel but not collinear then return.
      !distance   =  !line[1].distance(!line[!i])
      if(!distance gt 1mm)then
         !!alert.error('Merge can act on collinear sections only!!')
         !this.tidy(!toMerge)
         return
      endif

      -- Make a union of the lines to arrive at the merged sctn.
      !sctnLine   =  !sctnLine.union(!line[!i])
      !toDelete.append(!toMerge[!i])
   enddo

   -- If the user opts for merging into a gensec....
   if(!mergeToGensec)then
      if (!allBanglesSame) then
          !confirm  =  !!alert.confirm('Filleting will remove all fittings. OK to Proceed?')
      else
          !confirm  =  !!alert.confirm('Filleting will make rotation of profiles identical(' & !bangle & ') and remove all fittings. OK to Proceed?')
      endif

      if(!confirm eq 'NO')then
         !this.tidy(!toMerge)
         return
      endif
      -- Input the radius the new curve should be imparted.
      if (!!isImperialLength('DIST')) then
          !inputRadius = !!alert.input('Enter curve radius',|4'|)
      else
          !inputRadius = !!alert.input('Enter curve radius','1000')
      endif
      !radius = $!inputRadius

      -- This value is purely empirical
      !minimumDist    =  10mm

      !pickedPosOnFirstSctn   =   !line[1].intersection(!this.pickedPoint[1])
      !pickedPosOnSecSctn     =   !line[2].intersection(!this.pickedPoint[2])

      !isIntersectionOnLine1 = !line[1].onProjected(!intersection)
      !lineEndChanged    = FALSE
      if(!isIntersectionOnLine1)then
         if(!pickedPosOnFirstSctn.distance(!line[1].endPosition) lt !pickedPosOnFirstSctn.distance(!line[1].startPosition))then
            !line[1].startPosition = !line[1].endPosition
            !lineEndChanged    = TRUE
         endif

      else
         if(!intersection.distance(!line[1].endPosition) gt !intersection.distance(!line[1].startPosition))then
            !line[1].startPosition = !line[1].endPosition
            !lineEndChanged    = TRUE
         endif
      endif

      !line[1].endPosition = !intersection
      if(!line[1].length() lt !minimumDist)then
         if(!lineEndChanged)then
            !line[1].startPosition = !toMerge[1].poss
            if(!line[1].length() lt !minimumDist)then
               !!alert.error('Could not fillet based on the end picked.')
               !this.tidy(!toMerge)
               return
            endif
         else
            !line[1].startPosition = !toMerge[1].pose
            if(!line[1].length() lt !minimumDist)then
               !!alert.error('Could not fillet based on the end picked.')
               !this.tidy(!toMerge)
               return
            endif
         endif
      endif

      !isIntersectionOnLine2 = !line[2].onProjected(!intersection)

      !lineEndChanged    = FALSE
      if(!isIntersectionOnLine2)then
         if(!pickedPosOnSecSctn.distance(!line[2].endPosition) gt !pickedPosOnSecSctn.distance(!line[2].startPosition))then
            !line[2].endPosition = !line[2].startPosition
            !lineEndChanged      = TRUE
         endif

      else
         if(!intersection.distance(!line[2].endPosition) lt !intersection.distance(!line[2].startPosition))then
            !line[2].endPosition = !line[2].startPosition
            !lineEndChanged      = TRUE
         endif
      endif

      !line[2].startPosition = !intersection
      if(!line[2].length() lt !minimumDist)then
         if(!lineEndChanged)then
            !line[2].endPosition = !toMerge[2].pose
            if(!line[2].length() lt !minimumDist)then
               !!alert.error('Could not fillet based on the end picked.')
               !this.tidy(!toMerge)
               return
            endif
         else
            !line[2].endPosition = !toMerge[2].poss
            if(!line[2].length() lt !minimumDist)then
               !!alert.error('Could not fillet based on the end picked.')
               !this.tidy(!toMerge)
               return
            endif
         endif
      endif

      !arcDir      =   !line[1].direction().cross(!line[2].direction())
      !arcStart    =   !line[1].startPosition
      !arcEnd      =   !line[2].endPosition
      !arc         =   !intersection.arcFillet(!arcStart,!arcEnd,!arcDir,!radius)
      handle ANY
         !this.tidy(!toMerge)
         return
      endhandle

      !line[1].endPosition    =  !arc.anglePosition(!arc.startangle)
      !line[2].startPosition  =  !arc.anglePosition(!arc.endangle)

      -- Collect the lines and arc in an array
      !arrLineArc[1]  =  !line[1]
      !arrLineArc[2]  =  !arc
      !arrLineArc[3]  =  !line[2]

      !oriGensec      =   Z is $!arcDir

      AID TEXT NUM $!this.aidNumberPro 'Start' at $!arrLineArc[1].startPosition
      AID TEXT NUM $!this.aidNumberPro 'End'   at $!arrLineArc[3].endPosition
      AID TEXT NUM $!this.aidNumberPro 'Fillet Point'  at $!intersection

      !gensecOk = !!alert.confirm('Click Yes to fillet and create a gensec through these points.')
      if(!gensecOk eq 'NO')then
         !this.tidy(!toMerge)
         return
      endif
      !this.tidy(!toMerge)

      -- Create new GENSEC under the same hierarchy
      !!ce        = !toMerge[1]
      NEW GENSEC
      !newGensec  =  !!ce
      !!ce.pos    =  !toMerge[1].pos
      !!ce.ori    =  Z is $!arcDir
      !!ce.spref  =  !toMerge[1].spref
      !!ce.gtyp   =  !toMerge[1].gtyp
      if( !jusl.empty().not() ) then
        !!ce.jusl = !jusl
      endif

      --*** The code below was written with an intention to add fittings
      --But the types supported by SCTN is not supported by GENSEC (For future reference)
      --!inclMem    =  !toMerge[1].members
      --!inclMem.appendArray(!toMerge[2].members)
      --
      --do !i indices !inclMem
      --   !zDist   = !inclMem[!i].pos
      --   handle ANY
      --   endhandle
      --   INCLUDE $!inclMem[$!i]
      --   !inclMem[!i].zDist  =  !zDist
      --   handle ANY
      --   endhandle
      --enddo

      NEW SPINE
      !newSpine = !!ce

      -- Create the profile from the collection of lines and arc.
      !genProfile     =   object PROFILE(!line[1].startPosition,!oriGensec,!arrLineArc)

      !genProfile.dbWrite(!!ce)

      -- Delete the merged sections
      !!ce = !toMerge[1]
      DELETE SCTN

      !!ce = !toMerge[2]
      DELETE SCTN

      !newSpine.yDir = !yDir

      !newGensec.bang    = !bangle
      if( !newGensec.zDir.angle(!zDir) gt 1 ) then
        -- have to mirror profile if defined in opposite direction
        !newGensec.lMirror = true
        !newGensec.bang    = !bangle * -1
      endif

      !newGensec  =   !!spineTidy(!newGensec)

   else
     -- confirm before merging
      !sctnOk = !!alert.confirm('Click Yes  to merge the highlighted sections.')

      if(!sctnOk eq 'NO')then
         !this.tidy(!toMerge)
         return
      endif

      !toMerge[1].poss = !sctnLine.startPosition
      !toMerge[1].pose = !sctnLine.endPosition
      !!ce             = !toMerge[1]
      UNENHANCE CE

      -- Include all the fittings and nodes to the new sctn
      do !i indices !toDelete
         skip if(!toDelete[!i] eq !toMerge[1])
         !fittColl  =  !toDelete[!i].members
         do !j indices !fittColl
            !fittPos  =  !fittColl[!j].pos
            handle (2,201)
            endhandle
            INCLUDE $!fittColl[$!j]
            !fittColl[!j].pos   =   !fittPos
            handle (2,201)
            elsehandle (41,232)
               !fittColl[!j].zDist = !fittPos.distance(!toMerge[1].poss)
               handle any
               endhandle
            endhandle
         enddo
      enddo

      -- Delete the merged sections
      do !i indices !toDelete
         !!ce = !toDelete[!i]
         if(!!ce eq !this.refItem)then
           !this.refItem  =  !toMerge[1]
         endif
         UNENHANCE CE
         DELETE SCTN
      enddo
   endif

   -- Reset current element
   !!ce =  !this.refItem
endmethod
-- End of method definition for .optPanel()
