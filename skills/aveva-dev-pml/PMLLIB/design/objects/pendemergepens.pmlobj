--     Keyword:     PENS
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Thu Aug 20 8:45:25 BST 1998
--
--
-- Description:
-- object to store the single penetration data in case the user wishes to revert back to
-- single penetrations.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  load(DBREF)                      -                   Load object with data of the old position/owner etc.
--

define object PENDEMERGEPENS

  -- Ex  owning cmpf/fi
     member .owner      is ARRAY
  -- Actual sbfitting
     member .sbfitting  is ARRAY
  -- position of old cmpf/fi wrt worl (can be populated from cmpf/fi or cref)
  -- put it at delp n0u0e0 for all cos core don't work
     member .position      is ARRAY
  -- cref of sbfitting
     member .cref is ARRAY


endobject
-- End of object definition for PENDEMERGEPENS

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description:
--   Load object with data of the old position/owner etc.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Single penetration to have its data stored.]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load(!singleHole is DBREF)


  !this.sbfitting.append(!singleHole)
  !this.owner.append(!singleHole.owner)
  !this.position.append(!singleHole.owner.position.wrt(WORLD))
  !this.cref.append(!singleHole.cref)


endmethod
-- End of method definition for .load(DBREF)
