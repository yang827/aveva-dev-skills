-- Created:        24/05/2010 12:40:21
-- Last Modified:
-- Description:
-- General information for anchor points
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  canAnchor(DBREF)                 BOOLEAN             Returns true if the supplied element is suitable for anchoring
--  getHorizontalTypeList(ARRAY,ARRAY) -                   Retrieves a list of the allowed anchor types for a horizontal branch leg
--  getMethodList()                  ARRAY               Retrieves a list of the allowed anchor methods
--  getTypeList()                    ARRAY               Retrieves a list of the allowed anchor types
--  getVerticalTypeList(ARRAY,ARRAY) -                   Retrieves a list of the allowed anchor types for a vertical branch leg
--  pipeSlopeAnchorInfo()            -                   Constructor
--

------------------------------------------------------------------------
--

define object PIPESLOPEANCHORINFO

  member .typeNone      is STRING
  member .typeEnd       is STRING
  member .typeComponent is STRING
  member .typePosition  is STRING

  member .methodTop     is STRING
  member .methodCentre  is STRING
  member .methodBottom  is STRING

endobject

------------------------------------------------------------------------
--
-- Method:   .pipeSlopeAnchorInfo
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .pipeSlopeAnchorInfo()

  !this.typeNone      = 'None'
  !this.typeEnd       = 'End'
  !this.typeComponent = 'Component'
  !this.typePosition  = 'Position'

  !this.methodTop     = 'Top'
  !this.methodCentre  = 'Centre'
  !this.methodBottom  = 'Bottom'

endmethod
-- End of method .pipeSlopeAnchorInfo

-----------------------------------------------------------------------
--
-- Method:   getTypeList
--
-- Description: Retrieves a list of the allowed anchor types
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of strings containing all the allowed anchor types
--
------------------------------------------------------------------------
define method .getTypeList() is ARRAY

  !list = ARRAY()
  !list.append(!this.typeNone)
  !list.append(!this.typeEnd)
  !list.append(!this.typeComponent)
  !list.append(!this.typePosition)
  return !list

endmethod
-- End of method .getTypeList

-----------------------------------------------------------------------
--
-- Method:   getHorizontalTypeList
--
-- Description: Retrieves a list of the allowed anchor types for a horizontal branch leg
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of strings containing all the allowed anchor types
--
------------------------------------------------------------------------
define method .getHorizontalTypeList(!dtext is ARRAY, !rtext is ARRAY)

  !rtext = !this.getTypeList()

  !dtext.clear()
  !dtext.append('None')
  !dtext.append('Leg start')
  !dtext.append('Leg component')
  !dtext.append('Leg position')

endmethod
-- End of method .getHorizontalTypeList

-----------------------------------------------------------------------
--
-- Method:   getVerticalTypeList
--
-- Description: Retrieves a list of the allowed anchor types for a vertical branch leg
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of strings containing all the allowed anchor types
--
------------------------------------------------------------------------
define method .getVerticalTypeList(!dtext is ARRAY, !rtext is ARRAY)

  !this.getHorizontalTypeList(!dtext, !rtext)

  -- Remove position entry
  !index = !rtext.findFirst(!this.typePosition)
  if (!index.set()) then
    !dtext.remove(!index)
    !rtext.remove(!index)
  endif

  -- Remove component entry
  !index = !rtext.findFirst(!this.typeComponent)
  if (!index.set()) then
    !dtext.remove(!index)
    !rtext.remove(!index)
  endif

endmethod
-- End of method .getVerticalTypeList


-----------------------------------------------------------------------
--
-- Method:   getMethodList
--
-- Description: Retrieves a list of the allowed anchor methods
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of strings containing all the allowed anchor methods
--
------------------------------------------------------------------------
define method .getMethodList() is ARRAY

  !list = ARRAY()
  !list.append(!this.methodTop)
  !list.append(!this.methodCentre)
  !list.append(!this.methodBottom)
  return !list

endmethod
-- End of method .getMethodList

------------------------------------------------------------------------
--
-- Method:      .canAnchor()
--
-- Description: Returns true if the supplied element is suitable for anchoring
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF
-- Return:
-- [Data Type]            [Description]
--  ARRAY                  Component names
--
------------------------------------------------------------------------

define method .canAnchor(!element is DBREF) is BOOLEAN

  if (!element.type inset('GASK', 'ATTA')) then
    return false
  else
    return true
  endif

endmethod
-- End of method canAnchor
