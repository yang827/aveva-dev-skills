-- Group:          Piping Application
--
-- Keyword:        PIPING
-- Module:         design
-- Replaces:
--
-- Author:         S.Bailey
-- Created:        21/07/2010 14:31:03
-- Last Modified:
-- Description:
-- Object representing a fixed point - used by the sloping pipe code
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAnchorMethod()                STRING              Get the anchor method
--  getAnchorType()                  STRING              Get the anchor type
--  getComponent()                   PIPESLOPECOMPONENT  Get the component
--  getDistance()                    REAL                Get the anchor distance
--  getFromElement()                 DBREF               Get the dbRef of the element used to anchor with respect to
--  getFromMethod()                  STRING              Get the anchor 'from' method - whether to anchor relative
--  getHeight()                      REAL                Get height of the anchor point
--  getOffset()                      REAL                Get height of the anchor point
--  getPosition()                    POSITION            Get the anchor position
--  isFixedEnd()                     BOOLEAN             Constructor
--  isSet()                          BOOLEAN             Returns true if the anchor point is set
--  isUnset()                        BOOLEAN             Returns true if the anchor point is unset
--  pipeSlopeAnchorPoint()           -                   Constructor
--  setAnchorMethod(STRING)          -                   Set the anchor method
--  setAnchorType(STRING)            -                   Set the anchor type
--  setAnchorTypeEnd(POSITION)       -                   Set the anchor type to 'End'
--  setAnchorTypeNone()              -                   Clear the anchor type
--  setComponent(PIPESLOPECOMPONENT) -                   Set the anchor component
--  setDistance(REAL)                -                   Set the anchor distance
--  setFromElement(DBREF)            -                   Set the dbRef of the element used to anchor with respect to
--  setFromMethod(STRING)            -                   Set the anchor 'from' method - whether to anchor relative
--  setOffset(REAL)                  -                   Set height of the anchor point
--  setPipeRadius(REAL)              -                   Set pipe radius
--  setPosition(POSITION)            -                   Set the anchor position
--  setVertical(BOOLEAN)             -                   Sets the anchor type list for vertical or horizontal
--


------------------------------------------------------------------------
--
------------------------------------------------------------------------

define object PIPESLOPEANCHORPOINT

  member .anchorType is STRING
  member .anchorComponent is PIPESLOPECOMPONENT
  member .anchorMethod is STRING
  member .offset is REAL
  member .distance is REAL
  member .fromMethod is STRING
  member .fromElement is DBREF
  member .position is POSITION
  member .anchorTypeList is ARRAY
  member .anchorInfo is PIPESLOPEANCHORINFO
  member .pipeRadius is REAL

endobject

------------------------------------------------------------------------
--
-- Method:   pipeSlopeAnchorPoint
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pipeSlopeAnchorPoint()

  !anchorInfo = object PIPESLOPEANCHORINFO()
  !this.anchorType = !this.anchorInfo.typeNone

  !this.distance = 0
  !this.offset = 0
  !this.pipeRadius = 0.0

  !this.anchorMethod = !anchorInfo.methodBottom
  !this.fromMethod = !anchorInfo.methodTop

endmethod
-- End of method .pipeSlopeAnchorPoint

------------------------------------------------------------------------
--
-- Method:   isSet
--
-- Description: Returns true if the anchor point is set
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the anchor point has been set
--
------------------------------------------------------------------------
define method .isSet() is BOOLEAN

  return !this.anchorType ne !this.anchorInfo.typeNone

endmethod
-- End of method .isSet

------------------------------------------------------------------------
--
-- Method:   isUnset
--
-- Description: Returns true if the anchor point is unset
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the anchor point has not been set
--
------------------------------------------------------------------------
define method .isUnset() is BOOLEAN

  return !this.anchorType eq !this.anchorInfo.typeNone

endmethod
-- End of method .isUnset


------------------------------------------------------------------------
--
-- Method:   isFixedEnd
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the anchor type is set to 'End'
--
------------------------------------------------------------------------
define method .isFixedEnd() is BOOLEAN

  return !this.anchorType eq !this.anchorInfo.typeEnd

endmethod
-- End of method .isFixedEnd

------------------------------------------------------------------------
--
-- Method:   getAnchorType
--
-- Description: Get the anchor type
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  STRING      Anchor type
--
------------------------------------------------------------------------
define method .getAnchorType() is STRING

  return !this.anchorType

endmethod
-- End of method .getAnchorType

------------------------------------------------------------------------
--
-- Method:   getOffset
--
-- Description: Get height of the anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  REAL        The height of the anchor position
--
------------------------------------------------------------------------
define method .getOffset() is REAL

  return !this.offset

endmethod
-- End of method .getOffset

------------------------------------------------------------------------
--
-- Method:   getDistance
--
-- Description: Get the anchor distance
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  REAL        Distance from leg start
--
------------------------------------------------------------------------
define method .getDistance() is REAL

  return !this.distance

endmethod
-- End of method .getDistance


------------------------------------------------------------------------
--
-- Method:   getFromElement
--
-- Description: Get the dbRef of the element used to anchor with respect to
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  DBREF        Element reference
--
------------------------------------------------------------------------
define method .getFromElement() is DBREF

  return !this.fromElement

endmethod
-- End of method .getFromElement

------------------------------------------------------------------------
--
-- Method:   setAnchorType
--
-- Description: Set the anchor type
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Anchor type
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAnchorType(!anchorType is STRING)

  if (!this.anchorTypeList.findFirst(!anchorType).unset()) then
    return error 1 'Unknown anchor type'
  endif

  !this.anchorType = !anchorType

endmethod
-- End of method .setAnchorType

------------------------------------------------------------------------
--
-- Method:   setAnchorTypeNone
--
-- Description: Clear the anchor type
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .setAnchorTypeNone()

  !this.anchorType = !this.anchorInfo.typeNone

endmethod
-- End of method .setAnchorTypeNone

------------------------------------------------------------------------
--
-- Method:   setAnchorTypeEnd
--
-- Description: Set the anchor type to 'End'
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .setAnchorTypeEnd(!position is POSITION)

  !this.anchorType = !this.anchorInfo.typeEnd
  !this.position = !position

endmethod
-- End of method .setAnchorTypeEnd

------------------------------------------------------------------------
--
-- Method:   getHeight
--
-- Description: Get height of the anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  REAL        The height of the anchor position
--
------------------------------------------------------------------------
define method .getHeight() is REAL
  return !this.getPosition().up
endmethod
-- End of method .getHeight

------------------------------------------------------------------------
--
-- Method:   getPosition
--
-- Description: Get the anchor position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  REAL        The anchor position
--
------------------------------------------------------------------------
define method .getPosition() is POSITION

  if (!this.anchorType eq !this.anchorInfo.typeNone) then
    !position = object POSITION()
  elseif (!this.anchorType eq !this.anchorInfo.typeEnd) then
    !position = !this.position
  else
    if (!this.anchorType eq !this.anchorInfo.typePosition) then
      !position = !this.position
    elseif (!this.anchorType eq !this.anchorInfo.typeComponent) then
      !position = !this.anchorComponent.getPosition()
    endif
    !positionUp = !position.up

    -- According to the anchor method (top, bottom or centre) find the vertical distance
    -- between the fixed position and top or bottom of pipe
    !deltaComponent = 0
    if (!this.fromElement.set()) then
      if (!this.anchorMethod eq !this.anchorInfo.methodTop) then
        !deltaComponent = -!this.pipeRadius
      elseif (!this.anchorMethod eq !this.anchorInfo.methodBottom) then
        !deltaComponent = !this.pipeRadius
      endif
    endif

    -- If component is being anchored relative to another element calculate the height
    -- of the reference point
    !deltaElement = 0
    if (!this.fromElement.set()) then
      -- Use the local volume to derive the top/bottom/centre positions
      !elementVolume = object LOCALVOLUME(!this.fromElement, /* )
      !elementBox = !elementVolume.box()

      !positionUp  = !elementBox.position.wrt(/* ).up
      if (!this.fromMethod eq !this.anchorInfo.methodTop) then
        !deltaElement = !elementBox.zLength / 2.0
      elseif (!this.fromMethod eq !this.anchorInfo.methodBottom) then
        !deltaElement = -!elementBox.zLength / 2.0
      endif

    endif

    !position.up = !positionUp - !this.offset + !deltaComponent + !deltaElement
  endif

  return !position
endmethod
-- End of method .getPosition

------------------------------------------------------------------------
--
-- Method:   getComponent
--
-- Description: Get the component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type]          [Description]
--  PIPESLOPECOMPONENT   Pipe slope component
--
------------------------------------------------------------------------
define method .getComponent() is PIPESLOPECOMPONENT

  if (!this.anchorType eq !this.anchorInfo.typeComponent) then
    return !this.anchorComponent
  else
    return object PIPESLOPECOMPONENT()
  endif

  return !this.anchorComponent

endmethod
-- End of method .getComponent

------------------------------------------------------------------------
--
-- Method:   getAnchorMethod
--
-- Description: Get the anchor method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  STRING      Anchor method
--
------------------------------------------------------------------------
define method .getAnchorMethod() is STRING
  return !this.anchorMethod
endmethod
-- End of method .getAnchorMethod

------------------------------------------------------------------------
--
-- Method:   getFromMethod
--
-- Description: Get the anchor 'from' method - whether to anchor relative
--              to the top, bottom or centre
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  STRING      Anchor method
--
------------------------------------------------------------------------
define method .getFromMethod() is STRING
  return !this.fromMethod
endmethod
-- End of method .getFromMethod

------------------------------------------------------------------------
--
-- Method:   setPosition
--
-- Description: Set the anchor position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        The anchor position
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPosition(!position is POSITION)

  !this.position = !position

endmethod
-- End of method .setPosition

------------------------------------------------------------------------
--
-- Method:   setComponent
--
-- Description: Set the anchor component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]         [Description]
--  1   R      PIPESLOPECOMPONENT  Component to anchor
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setComponent(!component is PIPESLOPECOMPONENT)

  !this.anchorComponent = !component

endmethod
-- End of method .setComponent

------------------------------------------------------------------------
--
-- Method:   setFromElement
--
-- Description: Set the dbRef of the element used to anchor with respect to
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--   1  R      DBREF        Element reference
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFromElement(!element is DBREF)

  !this.fromElement = !element

endmethod
-- End of method .setFromElement

------------------------------------------------------------------------
--
-- Method:   setOffset
--
-- Description: Set height of the anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        The height of the anchor position
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOffset(!offset is REAL)

  !this.offset = !offset

endmethod
-- End of method .setOffset


------------------------------------------------------------------------
--
-- Method:   setPipeRadius
--
-- Description: Set pipe radius
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Pipe radius
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPipeRadius(!pipeRadius is REAL)

  !this.pipeRadius = !pipeRadius

endmethod
-- End of method .setPipeRadius


------------------------------------------------------------------------
--
-- Method:   setDistance
--
-- Description: Set the anchor distance
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Distance from leg start
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDistance(!distance is REAL)

  !this.distance = !distance

endmethod
-- End of method .setDistance

------------------------------------------------------------------------
--
-- Method:   setAnchorMethod
--
-- Description: Set the anchor method
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Anchor method
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAnchorMethod(!method is STRING)

  !this.anchorMethod = !method

endmethod
-- End of method .setAnchorMethod

------------------------------------------------------------------------
--
-- Method:   setFromMethod
--
-- Description: Set the anchor 'from' method - whether to anchor relative
--              to the top, bottom or centre
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       STRING     Anchor method
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFromMethod(!method is STRING)

  !this.fromMethod = !method

endmethod
-- End of method .setFromMethod

------------------------------------------------------------------------
--
-- Method:   setVertical
--
-- Description: Sets the anchor type list for vertical or horizontal

--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      BOOLEAN     True for vertical
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setVertical(!useVerticalSet is BOOLEAN)

  !tempArray = ARRAY()
  if (!useVerticalSet) then
    !this.anchorInfo.getVerticalTypeList(!tempArray, !this.anchorTypeList)
  else
    !this.anchorInfo.getHorizontalTypeList(!tempArray, !this.anchorTypeList)
  endif

endmethod
-- End of method .setVertical
