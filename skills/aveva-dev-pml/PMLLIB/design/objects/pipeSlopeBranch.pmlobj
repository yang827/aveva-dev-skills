-- Created:        27/10/2010 14:39:59
-- Last Modified:
-- Description:
-- Object used to apply represent a branch and apply a slope to it.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjustLegPositions(BOOLEAN)      -                   Adjust branch leg positions so that fixed head and tail
--  calculateComponentOffsets()      -                   Calculates how much a component will be moved by.
--  calculateLegPositions(REAL,REAL,BOOLEAN) -                   Does an initial calculation of branch leg positions
--  checkBranchLegs()                -                   Generates warning messages to notify the user of conditions
--  findBranchLegs(REAL)             -                   Finds all the branch legs within the branch
--  findHorizontalLeg(DBREF)         PIPESLOPEBRANCHLEG  Finds the first horizontal leg containing a specified component
--  getBranch()                      DBREF               Return the branch reference
--  getBranchLeg(REAL)               PIPESLOPEBRANCHLEG  Returns a single branch leg
--  getBranchLegIndex(DBREF)         REAL                Finds the index to the branch leg containing a specific component
--  getBranchLegs()                  ARRAY               Returns all the branch legs
--  getComponentOffset(PIPESLOPECOMPONENT,BOOLEAN) REAL                Get the offset for a component
--  getNumberOfLegs()                REAL                Returns the number of legs in the branch
--  isBranchLegValid(REAL)           BOOLEAN             Finds whether a branch leg is valid
--  isFinishFixed()                  BOOLEAN             Find whether the finish of the last branch leg is fixed
--  isStartFixed()                   BOOLEAN             Find whether the start of the first branch leg is fixed
--  pipeSlopeBranch(DBREF,REAL)      -                   Constructor
--  reconnectComponents()            -                   Reconnects components after they have been moved
--  repositionBranch(PIPESLOPECOMPONENT,REAL,BOOLEAN) -                   Repositions a branch based on the offset of a component/branch
--  setBranchLegAnchorType(PIPESLOPEBRANCHLEG,REAL,REAL,STRING) -                   Set the type of anchoring
--  setComponentOffset(PIPESLOPECOMPONENT,REAL,BOOLEAN) -                   Set the offset for a component in the middle of a branch
--  setFinishOffset(REAL,REAL)       -                   Set the offset for the start of a branch leg
--  setStartOffset(REAL,REAL)        -                   Set the offset for the start of a branch leg
--  shiftDownstreamLegs(REAL,REAL,BOOLEAN) -                   Shifts branch legs in the downstream direction (towards branch tail)
--  shiftUpstreamLegs(REAL,REAL,BOOLEAN) -                   Shifts branch legs in the upstream direction (towards branch head)
--  updateBranchLegs(PIPESLOPEBRANCHLEG,REAL) -                   After a branch leg is modified, update the rest of the
--
------------------------------------------------------------------------

define object PIPESLOPEBRANCH

  member .branch is DBREF
  member .branchLegs is ARRAY
  member .validBranchLegs is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:   pipeSlopeBranch()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       Branch reference
--  2   RW    REAL         Leg number
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeSlopeBranch(!branch is DBREF, !legNumber is REAL)

  !this.branch = !branch
  !this.findBranchLegs(!legNumber)

endmethod
-- End of method .pipeSlopeBranch

------------------------------------------------------------------------
--
-- Method:      .findBranchLegs
--
-- Description: Finds all the branch legs within the branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   RW    REAL         Leg number
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findBranchLegs(!legNumber is REAL)

  !components = !!collectAllFor('', 'TYPE NE |TUBI|' , !this.branch)
  !components.append(!this.branch)

  do
    !this.branchLegs.append(object PIPESLOPEBRANCHLEG(!this.branch, !components, !legNumber))
    break if (!components.empty())
  enddo

endmethod
-- End of method .findBranchLegs
------------------------------------------------------------------------
--
-- Method:      .findHorizontalLeg
--
-- Description: Finds the first horizontal leg containing a specified component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   RW     DBREF       Component
-- Return:
-- [Data Type]               [Description]
--  PIPESLOPEBRANCHLEG        Copy of leg containing component or empty object
------------------------------------------------------------------------
define method .findHorizontalLeg(!component is DBREF) is PIPESLOPEBRANCHLEG

  !index = 0
  do !branchLeg value !this.branchLegs
    !index = !index + 1
    skip if (not !branchLeg.isLegHorizontal())
    if (!branchLeg.containsElement(!component)) then
      return !branchLeg
    endif
  enddo

  return object BRANCHLEG()
endmethod
-- End of method .findHorizontalLeg


------------------------------------------------------------------------
--
-- Method:      .calculateLegPositions
--
-- Description: Does an initial calculation of branch leg positions
--              without constraining the head/tail position.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Slope angle to be applied to branch
--  2   RW     REAL        Initial offset to apply to branch
--  3   R      BOOLEAN     Calculate forwards or backwards
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculateLegPositions(!angle is REAL, !offset is REAL, !calculateForwards is BOOLEAN)

  if (!calculateForwards) then
    do !branchLeg value !this.branchLegs
      !branchLeg.calculateLegPosition(!angle, !offset, !calculateForwards)
    enddo
  else
    do !legIndex from !this.branchLegs.size() to 1 by -1
      !this.branchLegs[!legIndex].calculateLegPosition(!angle, !offset, !calculateForwards)
    enddo
  endif

endmethod
-- End of method .calculateLegPositions

------------------------------------------------------------------------
--
-- Method:      .adjustLegPositions
--
-- Description: Adjust branch leg positions so that fixed head and tail
--              positions are restored.
--              Only used as part of the initial calculation
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      BOOLEAN     Calculate forwards or backwards
--  2   R      REAL        Offset to
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .adjustLegPositions(!calculateForwards is BOOLEAN)

  -- Assumes that at this point there are no fixed components within the branch leg...
  if (!calculateForwards) then
    !legIndex = 1

    do !branchLeg value !this.branchLegs
      if (!branchLeg.isStartPositionFixed()) then
        !shift = -!branchLeg.getOffset()
        !this.setStartOffset(!legIndex, !shift)
      endif
      if (!branchLeg.isFinishPositionFixed()) then
        !shift = -!branchLeg.getOffset() - !branchLeg.getDrop()
        !this.setFinishOffset(!legIndex, !shift)
      endif
      !legIndex = !legIndex + 1
    enddo

  else
    do !legIndex from !this.branchLegs.size() to 1 by -1
      !branchLeg = !this.branchLegs[!legIndex]
      if (!branchLeg.isFinishPositionFixed()) then
        !shift = -!branchLeg.getOffset() - !branchLeg.getDrop()
        !this.setFinishOffset(!legIndex, !shift)
      endif
      if (!branchLeg.isStartPositionFixed()) then
         !shift = -!branchLeg.getOffset()
         !this.setStartOffset(!legIndex, !shift)
      endif
    enddo
  endif

  -- Adjust branches to maintain connections lost when bend angles change

  !legCount = !this.branchLegs.size()
  if (!legCount gt 1) then
    !shift = !this.branchLegs[1].adjustStartConnections(!this.branchLegs[2], true)
    !this.shiftDownstreamLegs(2 , !shift, true)

    !shift = !this.branchLegs[!legCount].adjustFinishConnections(!this.branchLegs[!legCount - 1], true)
    !this.shiftUpstreamLegs(!legCount - 1 , !shift, true)
  endif

  !this.calculateComponentOffsets()

endmethod
-- End of method .adjustLegPositions

------------------------------------------------------------------------
--
-- Method:      .setStartOffset
--
-- Description: Set the offset for the start of a branch leg
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Offset for finish of branch leg)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setStartOffset(!legIndex is REAL, !initialShift is REAL)

  !shift = !initialShift
  !this.shiftUpstreamLegs(!legIndex - 1, !shift, true)
  !shift = !initialShift
  !this.shiftDownstreamLegs(!legIndex, !shift, true)

endmethod
-- End of method .setStartOffset

------------------------------------------------------------------------
--
-- Method:      .setFinishOffset
--
-- Description: Set the offset for the start of a branch leg
--
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Offset for finish of branch leg
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFinishOffset(!legIndex is REAL, !initialShift is REAL)

  !shift = !initialShift
  !this.shiftDownstreamLegs(!legIndex + 1, !shift, true)
  !shift = !initialShift
  !this.shiftUpstreamLegs(!legIndex, !shift, true)

endmethod
-- End of method .setFinishOffset

------------------------------------------------------------------------
--
-- Method:      .getComponentOffset
--
-- Description: Get the offset for a component
--              This routine assumes that the component is a member of the branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Component to retrieve the offset from
-- Return:
-- [Data Type] [Description]
--  REAL        Offset for component
------------------------------------------------------------------------

define method .getComponentOffset(!component is PIPESLOPECOMPONENT, !searchForwards is BOOLEAN) is REAL

  -- First find component
  !offset = REAL()
  do !branchLeg values !this.branchLegs
    !offset = !branchLeg.getComponentOffset(!component, !searchForwards)
    break if (!offset.set())
  enddo

  return !offset

endmethod
-- End of method .getComponentOffset

------------------------------------------------------------------------
--
-- Method:      .setComponentOffset
--
-- Description: Set the offset for a component in the middle of a branch
--              and recalculate positions for the whole branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]         [Description]
--  1   R      PIPESLOPECOMPONENT  Copy of component whose offset needs setting
--  2   R      REAL                Offset for component
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setComponentOffset(!component is PIPESLOPECOMPONENT, !offset is REAL, !forwards is BOOLEAN)

    do !branchLegIndex indices !this.branchLegs

      !componentIndex = !this.branchLegs[!branchLegIndex].getComponentIndex(!component, !forwards)
      if (!componentIndex.set()) then
        !calculatedShift = !this.branchLegs[!branchLegIndex].setComponentOffset(!componentIndex, !offset)

        !shift = !calculatedShift
        !this.shiftUpstreamLegs(!branchLegIndex - 1, !shift, false)

        !shift = !calculatedShift
        !this.shiftDownstreamLegs(!branchLegIndex + 1, !shift, false)

        break
      endif
    enddo

endmethod

-- End method .setComponentOffset

------------------------------------------------------------------------
--
-- Method:      .shiftUpstreamLegs
--
-- Description: Shifts branch legs in the upstream direction (towards branch head)
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]         [Description]
--  1   R      REAL                Index to branch leg
--  2   R      REAL                Amount to shift leg (downwards)
--  3   R      BOOLEAN             Ignore fixing of branch leg finish
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shiftUpstreamLegs(!legIndex is REAL, !shift is REAL, !ignoreFixedFinish is BOOLEAN)

  if (!legIndex le 0 or !shift.abs() lt !!pipeSlopeUtilities.distanceTolerance) then
    return
  endif

  if (!this.branchLegs[!legIndex].reverseShiftLeg(!shift, !ignoreFixedFinish)) then
    !this.shiftUpstreamLegs(!legIndex - 1, !shift, false)
  endif

endmethod
-- End of method .shiftUpstreamLegs

------------------------------------------------------------------------
--
-- Method:      .shiftDownstreamLegs
--
-- Description: Shifts branch legs in the downstream direction (towards branch tail)
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]         [Description]
--  1   R      REAL                Index to branch leg
--  2   R      REAL                Amount to shift leg (downwards)
--  3   R      BOOLEAN             Ignore fixing of branch leg start
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .shiftDownstreamLegs(!legIndex is REAL, !shift is REAL, !ignoreFixedStart is BOOLEAN)

  if (!legIndex gt !this.branchLegs.size() or !shift.abs() lt !!pipeSlopeUtilities.distanceTolerance) then
    return
  endif
 if (!this.branchLegs[!legIndex].forwardShiftLeg(!shift, !ignoreFixedStart )) then
    !this.shiftDownstreamLegs(!legIndex + 1, !shift, false)
  endif

endmethod
-- End of method .shiftDownstreamLegs

------------------------------------------------------------------------
--
-- Method:      .getBranch
--
-- Description: Return the branch reference
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getBranch() is DBREF

  return !this.branch

endmethod
-- End of method .getBranch

------------------------------------------------------------------------
--
-- Method:      getBranchLegs
--
-- Description: Returns all the branch legs
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
-- ARRAY       Array of branch legs
------------------------------------------------------------------------

define method .getBranchLegs() is ARRAY

  return !this.branchLegs

endmethod
-- End of method .getBranchLegs

------------------------------------------------------------------------
--
-- Method:      getBranchLeg
--
-- Description: Returns a single branch leg
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
--  1   r      REAL        Index to branch leg
-- Return:
-- [Data Type] [Description]
--  PIPESLOPEBRANCHLEG   Branch leg
------------------------------------------------------------------------

define method .getBranchLeg(!legIndex is REAL) is PIPESLOPEBRANCHLEG

  return !this.branchLegs[!legIndex]

endmethod
-- End of method .getBranchLeg

------------------------------------------------------------------------
--
-- Method:      getBranchLegIndex
--
-- Description: Finds the index to the branch leg containing a specific component
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
--  1   r      REAL        Element to find
-- Return:
-- [Data Type] [Description]
--  REAL        Index to branch leg
--
------------------------------------------------------------------------

define method .getBranchLegIndex(!element is DBREF) is REAL

  do !branchLegIndex indices !this.branchLegs
    if (!this.branchLegs[!branchLegIndex].containsElement(!element)) then
      return !branchLegIndex
    endif
  enddo

  return 0

endmethod
-- End of method .getBranchLegIndex

------------------------------------------------------------------------
--
-- Method:      getNumberOfLegs
--
-- Description: Returns the number of legs in the branch
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
-- REAL        Number of legs
------------------------------------------------------------------------

define method .getNumberOfLegs() is REAL

  return !this.branchLegs.size()

endmethod
-- End of method .getNumberOfLegs

------------------------------------------------------------------------
--
-- Method:      .updateBranchLegs
--
-- Description: After a branch leg is modified, update the rest of the
--              pipe to match
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
--  1   R      PIPESLOPEBRANCHLEG   The branch leg that has changed
--  2   R      REAL                 Index to the branch leg
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBranchLegs(!branchLeg is PIPESLOPEBRANCHLEG, !branchLegIndex is REAL)

  -- Modify anchor points for adjacent legs to ensure they are consistent
  -- e.g. If the start of one leg is anchored, the finish of the previous leg is also anchored

  -- If the start of the leg has been fixed, fix the finish of the next leg to match
  !ignoreFixedFinish = false
  if (!branchLegIndex gt 1) then
    if (!branchLeg.isStartPositionFixed()) then
      if (!this.branchLegs[!branchLegIndex - 1].isFinishPositionFixed().not()) then
        !ignoreFixedFinish = true
        !this.branchLegs[!branchLegIndex - 1].fixFinishPosition(true)
      endif
    elseif (!this.branchLegs[!branchLegIndex - 1].isFinishPositionFixed()) then
      !this.branchLegs[!branchLegIndex - 1].fixFinishPosition(false)
    endif

    -- Adjust for bend angle change at branch head
    if (!branchLeg.isLegHorizontal() and !branchLegIndex eq 2) then
      if ( not (!branchLeg.isFirstAnchorPointSet() or !branchLeg.isSecondAnchorPointSet()) $
                                                  and !this.branchLegs[!branchLegIndex - 1].isLegVertical()) then
        -- Find adjustment
        !shift = !this.branchLegs[1].adjustStartConnections(!branchLeg, false)

        -- Adjust current leg
        !branchLeg.shiftLegStart(!shift)
        -- Adjust start leg
        !this.branchLegs[1].lengthenLegFinish(!shift)

      endif
    endif

    !startHeight = !branchLeg.getAdjustedStartPosition().up
    !finishHeight = !this.branchLegs[!branchLegIndex - 1].getAdjustedFinishPosition().up
    !shift = !finishHeight - !startHeight
    !this.shiftUpstreamLegs(!branchLegIndex - 1, !shift, !ignoreFixedFinish)

  endif

  -- If the end of the leg has been fixed, fix the start of the next leg to match
  !ignoreFixedStart = false
  if (!branchLegIndex lt !this.branchLegs.size()) then

    if (!branchLeg.isFinishPositionFixed()) then
      if (!this.branchLegs[!branchLegIndex + 1].isStartPositionFixed().not()) then
        !ignoreFixedStart = true
        !this.branchLegs[!branchLegIndex + 1].fixStartPosition(true)
      endif
    elseif (!this.branchLegs[!branchLegIndex + 1].isStartPositionFixed()) then
      !this.branchLegs[!branchLegIndex + 1].fixStartPosition(false)
    endif

    -- Adjust for bend angle change at branch tail
    if (!branchLeg.isLegHorizontal() and (!branchLegIndex + 1 eq !this.branchLegs.size())) then
      if ( not (!branchLeg.isFirstAnchorPointSet() or !branchLeg.isSecondAnchorPointSet()) $
                                                  and !this.branchLegs[!branchLegIndex + 1].isLegVertical()) then
        -- Find adjustment
        !shift = !this.branchLegs[!branchLegIndex + 1].adjustFinishConnections(!branchLeg, false)
        -- Adjust current leg
        !branchLeg.shiftLegStart(!shift)
        -- Adjust final leg
        !this.branchLegs[!branchLegIndex + 1].shiftLegStart(!shift)
        !shift = -!shift
        !this.branchLegs[!branchLegIndex + 1].lengthenLegFinish(!shift)
      endif
    endif

  -- Adjust downstream branch legs
    !finishHeight = !branchLeg.getAdjustedFinishPosition().up
    !startHeight = !this.branchLegs[!branchLegIndex + 1].getAdjustedStartPosition().up
    !shift = !startHeight - !finishHeight

    !this.shiftDownstreamLegs(!branchLegIndex + 1, !shift, !ignoreFixedStart)
  endif

  -- Update actual leg
  !this.branchLegs[!branchLegIndex] = !branchLeg
  !this.calculateComponentOffsets()

endmethod
-- End of method .updateBranchLegs

------------------------------------------------------------------------
--
-- Method:   calculateComponentOffsets
--
-- Description: Calculates how much a component will be moved by.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .calculateComponentOffsets()

  do !branchLeg value !this.branchLegs
    !branchLeg.calculateComponentOffsets()
  enddo

endmethod
-- End of method .calculateComponentOffset


------------------------------------------------------------------------
--
-- Method:   repositionBranch
--
-- Description: Repositions a branch based on the offset of a component/branch
--              connecting to another branch. The component is assumed to exist
--              within this branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- 1   R      DBREF       Component
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .repositionBranch(!component is PIPESLOPECOMPONENT, !offset is REAL, !calculateForwards is BOOLEAN)

  -- Find branch leg containing component
  do !branchLegIndex indices !this.branchLegs
    !componentIndex = !this.branchLegs[!branchLegIndex].getComponentIndex(!component, true)
    break if (!componentIndex.set())
  enddo

  !shift = !offset - !this.branchLegs[!branchLegIndex].components[!componentIndex].getOffset()
  if (!componentIndex eq 1) then
    !this.setStartOffset(!branchLegIndex, !shift)
  elseif (!componentIndex eq !this.branchLegs[!branchLegIndex].getComponentCount()) then
    !this.setFinishOffset(!branchLegIndex, !shift)
  else
    !this.setComponentOffset(!this.branchLegs[!branchLegIndex].components[!componentIndex], !offset, true)
  endif

endmethod
-- End of method .repositionBranch

------------------------------------------------------------------------
--
-- Method:      .reconnectComponents
--
-- Description: Reconnects components after they have been moved
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reconnectComponents()

  do !branchLeg value !this.branchLegs
    !branchLeg.reconnectComponents()
  enddo

endmethod
-- End of method reconnectComponents

------------------------------------------------------------------------
--
-- Method:      .isStartFixed
--
-- Description: Find whether the start of the first branch leg is fixed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the start of the first branch leg is fixed
------------------------------------------------------------------------

define method .isStartFixed() is BOOLEAN

  return !this.branchLegs[1].isStartPositionFixed()

endmethod
-- End of method isStartFixed

------------------------------------------------------------------------
--
-- Method:      .isFinishFixed
--
-- Description: Find whether the finish of the last branch leg is fixed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the finish of the last branch leg is fixed
------------------------------------------------------------------------

define method .isFinishFixed() is BOOLEAN

  return !this.branchLegs[!this.branchLegs.size()].isFinishPositionFixed()

endmethod
-- End of method isFinishFixed


------------------------------------------------------------------------
--
-- Method:      .checkBranchLegs
--
-- Description: Generates warning messages to notify the user of conditions
--              likely to cause problems when applying the slope
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .checkBranchLegs()

  !this.validBranchLegs[1] = true

  -- Check for branch legs that don't line up with each other
  do !legIndex from 1 to !this.branchLegs.size() - 1
    !finishPosition  = !this.branchLegs[!legIndex].getAdjustedFinishPosition()
    !startPosition = !this.branchLegs[!legIndex + 1].getAdjustedStartPosition()
    !distance = !finishPosition.distance(!startPosition)

    if (!distance gt !!pipeSlopeUtilities.distanceTolerance) then

      !this.validBranchLegs[!legIndex] = false
      !this.validBranchLegs[!legIndex + 1] = false
      -- Build warning message and add it to the global list
      !firstLeg = !this.branchLegs[!legIndex].getLegNumber()
      !secondLeg = !firstLeg + 1
      !warning = 'Finish of leg ' + !firstLeg.string() + ' and start of leg ' + !secondLeg.string() + ' will not match'
      !!pipeSlopeMessages.addWarning(!warning)
    else
      -- Set next leg to valid (current leg has already been set as appropriate)
      !this.validBranchLegs[!legIndex + 1] = true
    endif
  enddo

  -- Check for movement of components within vertical legs and also check for fixed position ATTAs
  do !branchLeg values !this.branchLegs
    if (!branchLeg.getComponentCount() gt 2) then
      !components = !branchLeg.getComponents()
      !components.removeFirst()
      !components.removeLast()
      if (!branchLeg.isLegVertical()) then
        do !component values !components
          if (!component.getOffset().abs() gt !!pipeSlopeUtilities.distanceTolerance) then
            !legNumber = !branchLeg.getLegNumber().string()
            !!pipeSlopeMessages.addWarning('Component(s) in vertical leg ' + !legNumber + ' will be moved when the pipe is sloped')
            break
          endif
        enddo
      else
        -- Check for support ATTAs
        do !component values !components
          !dbRef = !component.dbRef()
          if (!dbRef.type EQ 'ATTA' and !dbRef.atty inset('', 'WELD', 'HANG')) then
            !legNumber = !branchLeg.getLegNumber().string()
            !!pipeSlopeMessages.addWarning('Leg ' + !legNumber + ' contains support ATTAs which will not be moved when the pipe is sloped')
            break
          endif
        enddo
        -- Check for penetration ATTAs
        do !component values !components
          !dbRef = !component.dbRef()
          if (!dbRef.type EQ 'ATTA' and !dbRef.atty eq 'PENI') then
            !legNumber = !branchLeg.getLegNumber().string()
            !!pipeSlopeMessages.addWarning('Leg ' + !legNumber + ' contains penetration ATTAs which will not be moved when the pipe is sloped')
            break
          endif
        enddo
      endif
    endif
  enddo

  -- Check for branch leg angles and legs with no slope length
  !legIndex = 1
  do !branchLeg values !this.branchLegs
    if (!branchLeg.isLegHorizontal()) then
      -- Check angle
      if (!branchLeg.isFixedHorizontal().not()) then
        if (!branchLeg.isStartPositionFixed().not() or !branchLeg.isFinishPositionFixed().not()) then

          if (abs(!branchLeg.getAdjustedAngle() - !branchLeg.getAngle()) gt !!pipeSlopeUtilities.angleTolerance) then
             !this.validBranchLegs[!legIndex] = false
            !warning = 'Leg angle for leg ' + !branchLeg.getLegNumber().string() + ' will not match the requested angle'
            !!pipeSlopeMessages.addWarning(!warning)
          endif
        endif
      endif

      -- Check slope length
      if (!branchLeg.getSlopeLength() lt !!pipeSlopeUtilities.distanceTolerance) then
        !warning = 'Leg ' + !branchLeg.getLegNumber().string() + ' cannot be sloped.'
        !!pipeSlopeMessages.addWarning(!warning)
      endif
    endif
    !legIndex = !legIndex + 1
  enddo

endmethod
-- End of method .checkBranchLegs

------------------------------------------------------------------------
--
-- Method:      .isBranchLegValid
--
-- Description:  Finds whether a branch leg is valid
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the leg is valid
------------------------------------------------------------------------

define method .isBranchLegValid(!branchLegIndex is REAL) is BOOLEAN

  return !this.validBranchLegs[!branchLegIndex]

endmethod
-- End of method isBranchLegValid

------------------------------------------------------------------------
--
-- Method:      .setBranchLegAnchorType
--
-- Description: Set the type of anchoring
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .setBranchLegAnchorType(!branchLeg is PIPESLOPEBRANCHLEG, !branchLegIndex is REAL, !anchorNumber is REAL, !anchorType is STRING)

  if (!anchorNumber eq 1) then
    !otherAnchor = 2
  else
    !otherAnchor = 1
  endif

  -- If both anchors are being cleared, attempt to eliminate any mismatch at the branch ends and adjust the branch angle
  if (!branchLeg.isLegHorizontal()) then
    !anchorInfo = object PIPESLOPEANCHORINFO()
    if (!anchorType eq !anchorInfo.typeNone and !branchLeg.getAnchorPoint(!otherAnchor).isUnset()) then

      -- Check for mismatch with preceding leg
      !noMismatch = true
      if (!branchLegIndex gt 1) then
        !finishPosition  = !this.branchLegs[!branchLegIndex - 1].getAdjustedFinishPosition()
        !startPosition = !this.branchLegs[!branchLegIndex].getAdjustedStartPosition()

        if (abs(!finishPosition.up - !startPosition.up) ge !!pipeSlopeUtilities.distanceTolerance) then
          !startPosition.up = !finishPosition.up
          !branchLeg.setAngle(!branchLeg.getAngle(), !startPosition)
          !noMismatch = false
        endif
      -- Check for mismatch with following leg
      elseif (!noMismatch and !branchLegIndex lt !this.branchLegs.size()) then
        !finishPosition  = !this.branchLegs[!branchLegIndex].getAdjustedFinishPosition()
        !startPosition = !this.branchLegs[!branchLegIndex + 1].getAdjustedStartPosition()

        if (abs(!finishPosition.up - !startPosition.up) ge !!pipeSlopeUtilities.distanceTolerance) then
          !finishPosition.up = !startPosition.up
          !branchLeg.setAngle(!branchLeg.getAngle(), !finishPosition)
          !noMismatch = false
        endif
      endif

      -- Check angle
      if (!noMismatch and !branchLeg.isFixedHorizontal().not()) then
        if (abs(!branchLeg.getAngle() - !branchLeg.getAdjustedAngle()) gt !!pipeSlopeUtilities.angleTolerance) then
          -- If first anchor has been released, preserve the finish position, otherwise preserve the start position
          if (!anchorNumber eq 1) then
            !position  = !this.branchLegs[!branchLegIndex].getAdjustedFinishPosition()
          else
            !position  = !this.branchLegs[!branchLegIndex].getAdjustedStartPosition()
          endif
          !branchLeg.setAngle(!branchLeg.getAngle(), !position)
        endif
      endif
    endif
  endif

  !offset = !branchLeg.getOffset()
  if (!anchorNumber eq 1) then
    !branchLeg.setFirstAnchorType(!anchorType, !offset)
  else
    !offset = !offset + !branchLeg.getDrop()
    !branchLeg.setSecondAnchorType(!anchorType, !offset)
  endif

endmethod
-- End of method .setBranchLegAnchorType
