-- Description:
-- Object used to apply represent a branch leg and apply a slope to it.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adjustFinishConnections(PIPESLOPEBRANCHLEG,BOOLEAN) REAL                Adjust finish connections to compensate for the effect of
--  adjustStartConnections(PIPESLOPEBRANCHLEG,BOOLEAN) REAL                Adjust start connections to compensate for the effect of
--  applySlope()                     -                   Moves all the components within the branch leg
--  calculateComponentOffsets()      -                   Calculates and sets the offsets for all components in a branch leg
--  calculateLegPosition(REAL,REAL,BOOLEAN) -                   Perform an initial calculation of the branch leg position,
--  calculateOffsetAndDrop(REAL)     -                   Calculates the offset and drop for a branch leg when an
--  calculateShift(REAL)             REAL                Calculates the shift of a branch leg needed to achieve the specified angle
--  calculateTubeLength()            REAL                Calculates the total length of tube within a branch leg
--  canSlopeFinish(REAL)             BOOLEAN             Decides whether the finish of the leg can be tilted
--  canSlopeStart(REAL)              BOOLEAN             Decides whether the start of the leg can be tilted
--  containsElement(DBREF)           BOOLEAN             Finds whether a branch leg contains a specific element
--  findConnections()                -                   Finds all the connections within the branch leg
--  findIsLegVertical()              BOOLEAN             Determines whether a leg is nominally vertical
--  findNonRotatableComponents()     -                   Sets some components as non-rotatable
--  fixFinishPosition(BOOLEAN)       -                   Fixes the finish leg position to its initial value
--  fixStartPosition(BOOLEAN)        -                   Fixes the start leg position to its initial value
--  forwardShiftHorizontalLeg(REAL,BOOLEAN) BOOLEAN             Shift a horizontal leg in the forwards direction
--  forwardShiftLeg(REAL,BOOLEAN)    BOOLEAN             Shift a leg in the forwards direction
--  forwardShiftVerticalLeg(REAL)    BOOLEAN             Shift a vertical leg in the forwards direction
--  getAdjustedAngle()               REAL                Returns the calculated leg angle
--  getAdjustedDrop()                REAL                Returns the leg's adjusted drop
--  getAdjustedFinishPosition()      POSITION            Returns the leg's adjusted finish position
--  getAdjustedStartPosition()       POSITION            Returns the leg's adjusted start position
--  getAnchorPoint(REAL)             PIPESLOPEANCHORPOINT Returns the specified anchor point
--  getAngle()                       REAL                Returns the leg angle
--  getBranch()                      DBREF               Returns dbRef for the owning branch
--  getComponentCount()              REAL                Returns the number of components in the branch leg
--  getComponentIndex(PIPESLOPECOMPONENT,BOOLEAN) REAL                Find the index to a component/branch within the component list
--  getComponentOffset(PIPESLOPECOMPONENT,BOOLEAN) REAL                If possible, finds the component within a branch leg and returns
--  getComponents()                  ARRAY               Returns the number of components in the branch leg
--  getDrop()                        REAL                Returns the leg's drop
--  getFinishComponent()             PIPESLOPECOMPONENT  Returns the last component in the branch leg
--  getFinishPosition()              POSITION            Returns the leg's finish position
--  getFirstAnchorComponent(BOOLEAN) PIPESLOPECOMPONENT  Returns the first anchor component
--  getHorizontalDistance(POSITION)  REAL                Finds the distance between the leg start and a position
--  getHorizontalLength()            REAL                Fetches the horizontal leg length
--  getLegNumber()                   REAL                Get the leg number
--  getLength()                      REAL                Finds the leg length
--  getOffset()                      REAL                Get the leg offset
--  getSlopeLength()                 REAL                Finds the slope leg length (horizontal)
--  getStartComponent()              PIPESLOPECOMPONENT  Returns the first component in the branch leg
--  getStartPosition()               POSITION            Returns the leg's start position
--  initialiseAnchorPoints()         -                   Initialise leg anchor points
--  isFinishPositionFixed()          BOOLEAN             Finds whether the leg finish is fixed
--  isFirstAnchorPointSet()          BOOLEAN             Returns true if the leg's first anchor point is set
--  isFixedHorizontal()              BOOLEAN             Returns true if the leg is fixed as horizontal
--  isLegHorizontal()                BOOLEAN             Returns true if the leg is horizontal
--  isLegValid()                     BOOLEAN             Returns true if the leg is valid
--  isLegVertical()                  BOOLEAN             Returns true if the leg is Vertical
--  isSecondAnchorPointSet()         BOOLEAN             Returns true if the leg's second anchor point is set
--  isStartPositionFixed()           BOOLEAN             Finds whether the leg start is fixed
--  lengthenLegFinish(REAL)          BOOLEAN             Lengthen a leg from the leg finish
--  lengthenLegStart(REAL)           BOOLEAN             Lengthen a leg from the leg start
--  pipeSlopeBranchLeg(DBREF,ARRAY,REAL) -                   Constructs a branch leg from a list of components, starting
--  reconnectComponents()            -                   Connects components after they have been moved
--  reset()                          -                   After a slope is applied, clears all calculated values for the leg
--  reverseShiftHorizontalLeg(REAL,BOOLEAN) BOOLEAN             Shift a horizontal leg in the reverse direction
--  reverseShiftLeg(REAL,BOOLEAN)    BOOLEAN             Shift a leg in the reverse direction
--  reverseShiftVerticalLeg(REAL)    BOOLEAN             Shift a vertical leg in the reverse direction
--  rotateComponents()               -                   After the components have been moved, attempt to align them
--  setAnchorComponent(REAL,REAL)    -                   Set the anchor component
--  setAnchorDistance(REAL,REAL)     -                   Set the anchor distance
--  setAnchorFromElement(REAL,DBREF) -                   Set the anchor from element
--  setAnchorFromMethod(REAL,STRING) -                   Set the anchor from method for an anchor point
--  setAnchorOffset(REAL,REAL)       -                   Set the anchor distance
--  setAnchorPoint(REAL,STRING)      -                   Set the anchor method for an anchor point
--  setAnchorRadius(PIPESLOPEANCHORPOINT) -
--  setAnchorTypeEnd(REAL)           -                   Set the anchor type to end
--  setAnchorTypeNone(REAL)          STRING              Set the anchor type to 'None'
--  setAngle(REAL)                   -                   Set the leg angle without any recalculation
--  setAngle(REAL,BOOLEAN)           -                   Set the leg angle by moving the leg start or finish
--  setAngle(REAL,POSITION)          -                   Set the leg angle ensuring the leg passes through a specified point
--  setComponentOffset(REAL,REAL)    REAL                Sets the offset for a component and attempts to move the rest of
--  setFirstAnchorType(STRING,REAL)  -                   Set the first anchor type
--  setFixedHorizontal(BOOLEAN,BOOLEAN) REAL                Forces the leg to be horizontal
--  setOffset(REAL)                  -                   Set the leg offset
--  setSecondAnchorType(STRING,REAL) -                   Set the second anchor type
--  shiftFinishPosition(REAL)        -                   Set the leg angle by shifting the finish position
--  shiftLegFinish(REAL)             BOOLEAN             Shift the leg finish
--  shiftLegStart(REAL)              BOOLEAN             Shift the leg start
--  shiftStartPosition(REAL)         -                   Set the leg angle by shifting the start position
--  shortenLegFinish(REAL)           BOOLEAN             Shorten a leg from the leg finish
--  shortenLegStart(REAL)            BOOLEAN             Shorten a leg from the leg start
--
------------------------------------------------------------------------

define object PIPESLOPEBRANCHLEG

  member .branch is DBREF
  member .startPosition is POSITION
  member .finishPosition is POSITION
  member .components is ARRAY             $* All PipeSlopeComponents within the branch leg - can include the branch head/tail
  member .componentRefs is ARRAY          $* DbRefs of all the components within the leg - excludes the branch head/tail
  member .connectionArrays is ARRAY
  member .connectionDirections is ARRAY
  member .legNumber is REAL

  member .drop is REAL
  member .offset is REAL
  member .angle is REAL

  member .isLegVertical is BOOLEAN
  member .fixedHorizontal is BOOLEAN
  member .anchorPoints is ARRAY
  member .slopeLength is REAL
  member .startSlopeDistance is REAL
  member .finishSlopeDistance is REAL

  member .anchorInfo is PIPESLOPEANCHORINFO

endobject
-- End of method .pipeSlopeBranchLeg


------------------------------------------------------------------------
--
-- Method:      .pipeSlopeBranchLeg
--
-- Description: Constructs a branch leg from a list of components, starting
--              at the head of the pipe. As the components are added to the
--              leg, they are removed from the component list.
--
-- Method Type: Constructor
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       Branch
--  2   RW     ARRAY       Branch members
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pipeSlopeBranchLeg(!branch is DBREF, !components is ARRAY, !legNumber is REAL)

  -- Construct the branch leg
  !this.legNumber = !legNumber
  !legNumber = !legNumber + 1
  !this.branch = !branch

  -- Create a new pipe slope component
  !componentRef = !components.removeFirst()
  !this.components.append(object PIPESLOPECOMPONENT(!componentRef, true))

  -- If component isn't a branch, add its DbRef to the list of components
  if (!componentRef ne !branch) then
      !this.componentRefs.append(!componentRef)
  endif

  -- Add components to the branch leg until a change of direction is encountered
  do
    break if (!components.empty())

    -- Create new pipe slope component
    !componentRef = !components.first()
    !nextComponent = object PIPESLOPECOMPONENT(!componentRef, false)
    !this.components.append(!nextComponent)

    -- If component isn't a branch, add its DbRef to the list of component references
    if (!componentRef ne !branch) then
      !this.componentRefs.append(!componentRef)
    endif

    if (!nextComponent.changesDirection()) then
      break
    else
      !components.removeFirst()
    endif
  enddo

  -- Initialise various members
  !this.startPosition = !this.getStartComponent().getPosition()
  !this.finishPosition = !this.getFinishComponent().getPosition()
  !this.startSlopeDistance = 0
  !this.finishSlopeDistance = !this.getHorizontalLength()
  !this.slopeLength = !this.finishSlopeDistance

  !this.isLegVertical = !this.findIsLegVertical()
  !this.fixedHorizontal = !this.isLegVertical.not()
  !this.drop = 0
  !this.offset = 0

  -- Find connections between components so that they can restored later
  !this.findConnections()

  !this.findNonRotatableComponents()
  !this.initialiseAnchorPoints()

endmethod
-- End of method .pipeSlopeBranchLeg

------------------------------------------------------------------------
--
-- Method:      .calculateLegPosition
--
-- Description: Perform an initial calculation of the branch leg position,
--              based on the slope to apply, the amount preceding legs have
--              been offset downward and the direction to work in
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Angle of slope
--  2   RW     REAL        Offset (downwards)
--  3   R      BOOLEAN     Direction to work - from head end (true) or from tail end (false)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculateLegPosition(!angle is REAL, !offset is REAL, !forwards is BOOLEAN)

  !this.angle = !angle
  !this.fixedHorizontal = false

  -- If the pipe is vertical, try to absorb the offset by either lengthening or shortening the pipe
  if (!this.isLegVertical and !offset ne 0) then
    !tubeLength = !this.calculateTubeLength()

    if (!forwards) then
      if (!this.startPosition.up gt !this.finishPosition.up) then
        if (!offset gt 0) then
          -- Shorten pipe
          !lengthChange = min(!tubeLength, !offset)
          !this.offset = !offset
          !this.drop   = -!lengthChange
          !offset      = !offset - !lengthChange
        else
          -- Lengthen pipe
          !this.offset = !offset
          !this.drop = -!offset
          !offset = 0
        endif
      else
        if (!offset gt 0) then
          -- Lengthen pipe
          !this.offset = !offset
          !this.drop = -!offset
          !offset = 0
        else
          -- Shorten pipe
          !lengthChange = min(!tubeLength, abs(!offset))
          !this.offset = !offset
          !this.drop = !lengthChange
          !offset = !offset + !lengthChange
        endif
      endif
    else

      if (!this.startPosition.up gt !this.finishPosition.up) then
        if (!offset gt 0) then
          -- Lengthen pipe
          !this.offset = 0
          !this.drop = !offset
          !offset = 0
        else
          -- Shorten pipe
          !lengthChange = min(!tubeLength, abs(!offset))
          !this.offset = !offset + !lengthChange
          !this.drop = -!lengthChange
          !offset = !offset + !lengthChange

        endif
      else
        if (!offset gt 0) then
          -- Shorten pipe at finish
          !lengthChange = min(!tubeLength, abs(!offset))
          !this.offset = !offset - !lengthChange
          !this.drop = !lengthChange
          !offset = !offset - !lengthChange
        else
          -- Lengthen pipe
          !this.offset = 0
          !this.drop = !offset
          !offset = 0
        endif
      endif
    endif

  elseif (!this.isLegHorizontal()) then
    -- Horizontal leg
    !this.offset = !offset

    -- Force leg to horizontal if it can be sloped
    !newAngle = !angle
    if (not (!this.canSlopeStart(!angle) and !this.canSlopeFinish(!angle))) then
      !newAngle = 0
      !this.fixedHorizontal = true
    endif

    !this.drop = !this.calculateShift(!newAngle)
    if(!forwards) then
      !offset = !offset + !this.drop
    else
      !this.offset  = !offset - !this.drop
      !offset = !offset - !this.drop
    endif

  endif
endmethod
-- End of method .calculateLegPosition

------------------------------------------------------------------------
--
-- Method:      .findConnections
--
-- Description: Finds all the connections within the branch leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .findConnections()

  -- Return if the leg doesn't contain any intermediate components
  if (!this.components.size() le 2) then
    return
  endif

  if (!this.components[1].isBranch()) then
    !firstLegSequenceNumber = !this.components[2].dbRef().sequ
  else
    !firstLegSequenceNumber = !this.components[1].dbRef().sequ
  endif

  if (!this.components[!this.components.size()].isBranch()) then
    !lastLegSequenceNumber = !this.components[!this.components.size() - 1].dbRef().sequ
  else
    !lastLegSequenceNumber = !this.components[!this.components.size()].dbRef().sequ
  endif

  !lastAddedSequenceNumber = 0
  do !component value !this.components

    -- Skip if the component is a branch, has already been added or is an ATTA
    !componentRef = !component.dbRef()
    skip if (!component.isBranch() or !componentRef.sequ le !lastAddedSequenceNumber or !componentRef.type eq 'ATTA')

    !branchConnections = !component.dbRef().brconn
    if (!branchConnections.size() gt 0)  then
      !connections = ARRAY()

      -- Fill the array of connections with those components that are within this branch leg
      do !connection value !branchConnections
        if (!connection.sequ ge !firstLegSequenceNumber and !connection.sequ le !lastLegSequenceNumber) then
          !connections.append(!connection)
        endif
      enddo

      if (!connections.size() gt 0) then
        !connections.insert(1, !component.dbRef())
        !lastAddedSequenceNumber = !connections.last().sequ

        -- Work out the direction to connect in and store it as the first element of the connection array

        -- If the first connected component is immediately adjacent to the branch head, connect forwards
        !size = !this.components.size()
        !lastConnection = !connections.last()
        if (!this.components[1].isBranch() and !connections[1] eq !this.components[2].dbRef() and !connections[1].atlen eq 0 ) then
          !direction = 'FORWARDS'

        -- If the last connected component is immediately adjacent to the branch tail, connect backwards
        elseif (!this.components[!size].isBranch() and !lastConnection eq !this.components[!size - 1].dbRef() and !lastConnection.ltlen eq 0 ) then
          !direction = 'BACKWARDS'

        -- If the first connected component is at the leg start, connect forwards
        elseif (!this.components[1].dbRef eq !connections[1]) then
          !direction = 'FORWARDS'

        -- If the last connected component is the leg finish, connect backwards
        elseif (!lastConnection eq !this.components[!size].dbRef()) then
          !direction = 'BACKWARDS'
        else $* Default to forwards
          !direction = 'FORWARDS'
        endif
        !this.connectionDirections.append(!direction)
        !this.connectionArrays.append(!connections)
      endif
    endif
  enddo

endmethod
-- End of method findConnections


------------------------------------------------------------------------
--
-- Method:      .findNonRotatableComponents
--
-- Description: Sets some components as non-rotatable
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .findNonRotatableComponents()

  -- Ignore components in a vertical branch as they are never rotated
  if (!this.isLegVertical()) then
    return
  endif

  !componentCount = !this.components.size()
  -- Check head
  !startSlopePosition = !this.components[1].getPosition()
  if (!this.components[1].isHead()) then
    !href = !this.branch.href
    !pipe = !this.branch.owner

    -- Set the head as non-rotatable if it is connected to anything apart from a member of the owning pipe
    !nonRotatable = !href.set() and (!href.owner ne !pipe and !href.owner.owner ne !pipe)
    if (!nonRotatable) then
      !this.components[1].setAsRotatable(false)
      -- As the head is not rotatable, nothing in the branch can be sloped until a component is found which
      -- has an offTol set on its leave ppoint.
      do !componentIndex from 2 to !componentCount
        !this.components[!componentIndex].setAsRotatable(false)
        if (!componentIndex ne !componentCount) then
          !componentRef = !this.components[!componentIndex].dbRef()
          !startSlopePosition = !componentRef.lpos.wrt( /* )
          if (!componentRef.ppOffTol[!componentRef.leave] ne 0) then
            break
          endif
        else
          !startSlopePosition = !this.components[!componentIndex].getPosition()
        endif
      enddo
    endif
  endif

  -- Check tail
  !finishSlopePosition = !this.components[!componentCount].getPosition()
  if (!this.components[!componentCount].isTail()) then
    !tref = !this.branch.tref
    !pipe = !this.branch.owner

     -- Set the tail as non-rotatable if it is connected to anything apart from a member of the owning pipe
    !nonRotatable = !tref.set() and (!tref.owner ne !pipe and !tref.owner.owner ne !pipe)

    if (!nonRotatable) then
      !componentCount = !this.components.size()
      !this.components[!componentCount].setAsRotatable(false)

      -- As the tail is not rotatable, nothing in the branch can be rotated until a component is found which
      -- has an offTol set on its arrive ppoint
      do !componentIndex from !componentCount - 1 to 1 by -1
        !this.components[!componentIndex].setAsRotatable(false)
        if (!componentIndex ne 1) then
          !componentRef = !this.components[!componentIndex].dbRef()
          !finishSlopePosition = !componentRef.apos.wrt ( /* )
          if (!componentRef.ppOffTol[!componentRef.arrive] ne 0) then
            break
          endif
        else
          !finishSlopePosition = !this.components[!componentCount].getPosition()
        endif
      enddo
    endif
  endif

  !this.startSlopeDistance = !this.getHorizontalDistance(!startSlopePosition)
  !this.finishSlopeDistance = !this.getHorizontalDistance(!finishSlopePosition)
  !this.slopeLength = !this.finishSlopeDistance - !this.startSlopeDistance
  !this.slopeLength = max(!this.slopeLength, 0)

endmethod
-- End of method .findNonRotatableComponents

------------------------------------------------------------------------
--
-- Method:      .calculateShift
--
-- Description: Calculates the shift of a branch leg needed to achieve the specified angle
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Angle
--
-- Return:
-- [Data Type] [Description]
--  REAL        Calculated shift
--
------------------------------------------------------------------------
define method .calculateShift(!angle is REAL) is REAL

  !currentDrop = !this.startPosition.up - !this.finishPosition.up + !this.drop
  !requiredDrop = tan(!angle) * !this.slopeLength
  !shift = !requiredDrop - !currentDrop

  if (!shift.abs() gt !!pipeSlopeUtilities.distanceTolerance) then
    return !shift
  else
    return 0
  endif

endmethod
-- End of method .calculateShift

------------------------------------------------------------------------
--
-- Method:      .calculateTubeLength
--
-- Description: Calculates the total length of tube within a branch leg
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  REAL        Tube length
--
------------------------------------------------------------------------
define method .calculateTubeLength() is REAL

  !tubeLength = 0
  do !componentIndex from 1 to !this.components.size() - 1
    !tubeLength = !tubeLength + !this.components[!componentIndex].dbRef().ltlen
  enddo
  return !tubeLength

endmethod
-- End of method .calculateTubeLength

------------------------------------------------------------------------
--
-- Method:      .applySlope
--
-- Description: Moves all the components within the branch leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .applySlope()
  -- Move each component in turn, ensuring that each component is only moved once
  -- as components may belong to more than one branch
  !finishComponentRef = !this.getFinishComponent().dbRef()
  !movedComponents = ARRAY()

  do !component values !this.components

    !componentRef = !component.dbRef()
    !offset = !component.offset

    -- Skip if the component has already been moved and it isn't a branch tail
    skip if (!movedComponents.findFirst(!componentRef).set() and !component.isTail().not())

    -- Only move finish component if it is the branch tail, otherwise it will be moved
    -- as the start of the next branch leg
    skip if (!componentRef eq !finishComponentRef and !component.isTail().not())

    -- Ignore support ATTAs

    skip if (!component.isSupportAttachment())
    !component.moveDown()

    !movedComponents.append(!componentRef)
  enddo

endmethod
-- End of method .applySlope

------------------------------------------------------------------------
--
-- Method:      .reset
--
-- Description: After a slope is applied, clears all calculated values for the leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .reset()

  !this.startPosition = !this.getStartComponent().getPosition()
  !this.finishPosition = !this.getFinishComponent().getPosition()

  -- Reset the anchor offsets and position if there is no anchoring or an end is anchored
  if (!this.anchorPoints[1].getAnchorType() inset (!this.anchorInfo.typeNone, !this.anchorInfo.typeEnd)) then
    !this.anchorPoints[1].setPosition(!this.startPosition)
    !this.anchorPoints[1].setOffset(0)
  endif
  if (!this.anchorPoints[2].getAnchorType() inset (!this.anchorInfo.typeNone, !this.anchorInfo.typeEnd)) then
    !this.anchorPoints[2].setPosition(!this.finishPosition)
    !this.anchorPoints[2].setOffset(0)
  endif

  !this.drop = 0.0
  !this.offset = 0.0

    do !component values !this.components
      !component.setOffset( 0.0 )
    enddo

  !this.findNonRotatableComponents()

endmethod
-- End of method .reset

------------------------------------------------------------------------
--
-- Method:      .rotateComponents
--
-- Description: After the components have been moved, attempt to align them
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .rotateComponents()

  if (!this.isLegVertical) then
    return
  endif

   var !initialMode mode
  !initialCE = !!ce

  !startComponent = !this.getStartComponent()
  !finishComponent = !this.getFinishComponent()

  !startPosition = !startComponent.getPosition()

  -- Displace the start position in the horizontal plane to allow for any non-rotatable components at the
  -- start of the leg.
  !position = !finishComponent.getPosition()
  !position.up = !startPosition.up
  !direction = !startPosition.direction(!position)
  !startPosition = !startPosition.offset(!direction, !this.startSlopeDistance)

  -- Similarly, displace the finish position
  !finishPosition = !finishComponent.getPosition()
  !finishPosition = !finishPosition.offset(!direction, !this.finishSlopeDistance - !this.getHorizontalLength())

  -- Find arrive and leave directions
  if (!startPosition ne !finishPosition) then
    !arriveDir  = !startPosition.direction(!finishPosition)
    !leaveDir  = !arriveDir.opposite()

    -- Direct start component
    forward
    !startComponent.direct(!arriveDir, true)

    -- Orient intermediate components
    do !component value !this.components
      skip if (!component.dbRef() eq !startComponent.dbRef() or !component.dbRef eq !finishComponent.dbRef())
      !component.orient(!leaveDir)
    enddo

    -- Direct finish component
    backward
    !finishComponent.direct(!leaveDir, false)

    !!ce = !initialCE
    $!<initialMode>
  endif

endmethod
-- End of method .rotateComponents

------------------------------------------------------------------------
--
-- Method:   getFirstAnchorComponent
--
-- Description: Returns the first anchor component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       BOOLEAN    Search from end rather than start of leg
-- Return:
-- [Data Type]            [Description]
-- PIPESLOPECOMPONENT      First anchor component
--
------------------------------------------------------------------------
define method .getFirstAnchorComponent(!reverseDirection is BOOLEAN) is PIPESLOPECOMPONENT

  !anchorPoints = !this.anchorPoints
  if (!reverseDirection) then
    !anchorPoints.invert()
  endif

  !anchorComponent = object PIPESLOPECOMPONENT()
  do !anchorPoint value !anchorPoints
    !anchorComponent = !anchorPoint.getComponent()
    break if(!anchorComponent.set())
  enddo

  return !anchorComponent

endmethod
-- End of method .getFirstAnchorComponent

------------------------------------------------------------------------
--
-- Method:   getStartComponent
--
-- Description: Returns the first component in the branch leg
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type]            [Description]
-- PIPESLOPECOMPONENT      Finish component
--
------------------------------------------------------------------------
define method .getStartComponent() is PIPESLOPECOMPONENT

  return !this.components.first()

endmethod
-- End of method .getStartComponent

------------------------------------------------------------------------
--
-- Method:   getFinishComponent
--
-- Description: Returns the last component in the branch leg
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type]            [Description]
-- PIPESLOPECOMPONENT      Finish component
--
------------------------------------------------------------------------
define method .getFinishComponent() is PIPESLOPECOMPONENT

  return !this.components.last()

endmethod
-- End of method .getFinishComponent

------------------------------------------------------------------------
--
-- Method:   getComponents
--
-- Description: Returns the number of components in the branch leg
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
-- REAL         Number of components
--
------------------------------------------------------------------------
define method .getComponents() is ARRAY

  return !this.components

endmethod
-- End of method .getComponents

------------------------------------------------------------------------
--
-- Method:   getComponentCount
--
-- Description: Returns the number of components in the branch leg
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
-- REAL         Number of components
--
------------------------------------------------------------------------
define method .getComponentCount() is REAL

   return !this.components.size()

endmethod
-- End of method .getComponentCount

------------------------------------------------------------------------
--
-- Method:      .getDrop
--
-- Description: Returns the leg's drop
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Drop
--
------------------------------------------------------------------------

define method .getDrop() is REAL
  return !this.drop
endmethod
-- End of method .getDrop

------------------------------------------------------------------------
--
-- Method:      .getBranch
--
-- Description: Returns dbRef for the owning branch
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  DBREF       Branch reference
--
------------------------------------------------------------------------
define method .getBranch() is DBREF
  return !this.branch
endmethod
-- End of method .getBranch

------------------------------------------------------------------------
--
-- Method:      .getLegNumber
--
-- Description: Get the leg number
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  REAL        Leg number
--
------------------------------------------------------------------------
define method .getLegNumber() is REAL
  return !this.legNumber
endmethod
-- End of method .getLegNumber

------------------------------------------------------------------------
--
-- Method:      .getAdjustedDrop
--
-- Description: Returns the leg's adjusted drop
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Adjusted drop
--
------------------------------------------------------------------------
define method .getAdjustedDrop() is REAL

  if (!this.isLegVertical) then
    return 0.0mm
  else
    return !this.startPosition.up - !this.finishPosition.up + !this.drop
  endif
endmethod
-- End of method .getAdjustedDrop

------------------------------------------------------------------------
--
-- Method:      .getOffset
--
-- Description: Get the leg offset
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Offset
--
------------------------------------------------------------------------
define method .getOffset() is REAL
  return !this.offset
endmethod
-- End of method .getOffset

------------------------------------------------------------------------
--
-- Method:   getLength
--
-- Description: Finds the leg length
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type]            [Description]
--  REAL                   Length
--
------------------------------------------------------------------------
define method .getLength() is REAL
  return !this.startPosition.distance(!this.finishPosition)
endmethod
-- End of method .getLength

------------------------------------------------------------------------
--
-- Method:   getHorizontalLength
--
-- Description: Fetches the horizontal leg length
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type]            [Description]
--  REAL                   Length
--
------------------------------------------------------------------------
define method .getHorizontalLength() is REAL
  return !this.getHorizontalDistance(!this.finishPosition)
endmethod
-- End of method .getHorizontalLength

------------------------------------------------------------------------
--
-- Method:   getSlopeLength
--
-- Description: Finds the slope leg length (horizontal)
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type]            [Description]
--  REAL                   Length
--
------------------------------------------------------------------------
define method .getSlopeLength() is REAL
  return !this.slopeLength
endmethod
-- End of method .getSlopeLength

------------------------------------------------------------------------
--
-- Method:   getHorizontalDistance
--
-- Description: Finds the distance between the leg start and a position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       POSITION   Position to measure to
-- Return:
-- [Data Type]            [Description]
--  REAL                   Distance
--
------------------------------------------------------------------------
define method .getHorizontalDistance(!position is POSITION) is REAL

  !endPosition = !position
  !endPosition.up = !this.startPosition.up
  !distance = !this.startPosition.distance(!endPosition)
  if (!distance lt !!pipeSlopeUtilities.distanceTolerance) then
     return 0
  else
    return !distance
  endif

endmethod
-- End of method .getHorizontalDistance

------------------------------------------------------------------------
--
-- Method:      .getStartPosition
--
-- Description: Returns the leg's start position
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  POSITION    Start position
--
------------------------------------------------------------------------
define method .getStartPosition() is POSITION
  return !this.startPosition
endmethod
-- End of method .getStartPosition

------------------------------------------------------------------------
--
-- Method:      .getFinishPosition
--
-- Description: Returns the leg's finish position
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  POSITION    Finish position
--
------------------------------------------------------------------------
define method .getFinishPosition() is POSITION
  return !this.finishPosition
endmethod
-- End of method .getFinishPosition

------------------------------------------------------------------------
--
-- Method:      .getAdjustedStartPosition
--
-- Description: Returns the leg's adjusted start position
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  POSITION    Adjusted start position
--
------------------------------------------------------------------------
define method .getAdjustedStartPosition() is POSITION
  !startPosition = !this.startPosition
  !startPosition.up = !startPosition.up - !this.offset
  return !startPosition
endmethod
-- End of method .getAdjustedStartPosition

------------------------------------------------------------------------
--
-- Method:      .getAdjustedFinishPosition
--
-- Description: Returns the leg's adjusted finish position
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  POSITION    Adjusted finish position
--
------------------------------------------------------------------------
define method .getAdjustedFinishPosition() is POSITION
  !finishPosition = !this.finishPosition
  !finishPosition.up  = !finishPosition.up - !this.offset - !this.drop
  return !finishPosition
endmethod
-- End of method .getAdjustedFinishPosition

------------------------------------------------------------------------
--
-- Method:      .isLegValid
--
-- Description: Returns true if the leg is valid
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if valid
--
------------------------------------------------------------------------
define method .isLegValid() is BOOLEAN
  return !this.branch.set()
endmethod
-- End of method .isLegValid

------------------------------------------------------------------------
--
-- Method:      .isLegVertical
--
-- Description: Returns true if the leg is Vertical
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if Vertical
--
------------------------------------------------------------------------
define method .isLegVertical() is BOOLEAN
  return !this.isLegVertical
endmethod
-- End of method .isLegVertical

------------------------------------------------------------------------
--
-- Method:      .isLegHorizontal
--
-- Description: Returns true if the leg is horizontal
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if horizontal
--
------------------------------------------------------------------------
define method .isLegHorizontal() is BOOLEAN
  return !this.isLegVertical.not()
endmethod
-- End of method .isLegHorizontal

------------------------------------------------------------------------
--
-- Method:      .isFirstAnchorPointSet
--
-- Description: Returns true if the leg's first anchor point is set
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if first anchor is set
--
------------------------------------------------------------------------
define method .isFirstAnchorPointSet() is BOOLEAN
  return !this.anchorPoints[1].isSet()
endmethod
-- End of method .isFirstAnchorPointSet

------------------------------------------------------------------------
--
-- Method:      .isSecondAnchorPointSet
--
-- Description: Returns true if the leg's second anchor point is set
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if second anchor is set
--
------------------------------------------------------------------------
define method .isSecondAnchorPointSet() is BOOLEAN
  return !this.anchorPoints[2].isSet()
endmethod
-- End of method .isSecondAnchorPointSet

------------------------------------------------------------------------
--
-- Method:      .isStartPositionFixed
--
-- Description: Finds whether the leg start is fixed
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the start position is fixed
--
------------------------------------------------------------------------
define method .isStartPositionFixed() is BOOLEAN
  return !this.anchorPoints[1].isFixedEnd()
endmethod
-- End of method .isStartPositionFixed

------------------------------------------------------------------------
--
-- Method:      .isFinishPositionFixed
--
-- Description: Finds whether the leg finish is fixed
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the finish position is fixed
--
------------------------------------------------------------------------
define method .isFinishPositionFixed() is BOOLEAN
  return !this.anchorPoints[2].isFixedEnd()
endmethod
-- End of method .isFinishPositionFixed

------------------------------------------------------------------------
--
-- Method:      .fixStartPosition
--
-- Description: Fixes the start leg position to its initial value
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R `     BOOLEAN     Whether to fix or unfix the start position
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fixStartPosition(!fixedStartPosition is BOOLEAN)

  if (!fixedStartPosition) then
    !this.anchorPoints[1].setAnchorTypeEnd(!this.startPosition)
    if(!this.anchorPoints[2].isSet()) then
      !this.fixedHorizontal = false
    endif
  elseif (!this.anchorPoints[1].isFixedEnd()) then
    !this.anchorPoints[1].setAnchorTypeNone()
  endif

endmethod
-- End of method .fixStartPosition

------------------------------------------------------------------------
--
-- Method:      .fixFinishPosition
--
-- Description: Fixes the finish leg position to its initial value
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R `     BOOLEAN     Whether to fix of unfix the finish position
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .fixFinishPosition(!fixedFinishPosition is BOOLEAN)

  if (!fixedFinishPosition) then
    !this.anchorPoints[2].setAnchorTypeEnd(!this.finishPosition)
    if(!this.anchorPoints[1].isSet()) then
      !this.fixedHorizontal = false
    endif
  elseif (!this.anchorPoints[2].isFixedEnd()) then
    !this.anchorPoints[2].setAnchorTypeNone()
  endif

endmethod
-- End of method .fixFinishPosition

------------------------------------------------------------------------
--
-- Method:      .isFixedHorizontal
--
-- Description: Returns true if the leg is fixed as horizontal
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if fixed as horizontal
--
------------------------------------------------------------------------
define method .isFixedHorizontal() is BOOLEAN
  return !this.fixedHorizontal
endmethod
-- End of method .isFixedHorizontal

------------------------------------------------------------------------
--
-- Method:      .findIsLegVertical
--
-- Description: Determines whether a leg is nominally vertical
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the leg is vertical
------------------------------------------------------------------------
define method .findIsLegVertical() is BOOLEAN

  if (!this.startPosition.eq(!this.finishPosition)) then
    return true
  endif

  !direction = !this.startPosition.direction(!this.finishPosition)
  return !!pipeSlopeUtilities.isDirectionVertical(!direction)
endmethod
-- End of method .findIsLegVertical

------------------------------------------------------------------------
--
-- Method:      .getAdjustedAngle
--
-- Description: Returns the calculated leg angle
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Angle
------------------------------------------------------------------------
define method .getAdjustedAngle() is REAL

  !angle = atan(!this.getAdjustedDrop() / !this.slopeLength)
  handle any
    !angle = 0
  endhandle

  return !angle

endmethod
-- End of method .getAdjustedAngle

------------------------------------------------------------------------
--
-- Method:      .getAngle
--
-- Description: Returns the leg angle
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Angle
------------------------------------------------------------------------
define method .getAngle() is REAL

  return !this.angle

endmethod
-- End of method .getAngle

------------------------------------------------------------------------
--
-- Method:      .setOffset
--
-- Description: Set the leg offset
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Offset
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOffset(!offset is REAL)

  !angle = atan(!this.getAdjustedDrop() / !this.getHorizontalLength())
  return !angle

endmethod
-- End of method .setOffset

------------------------------------------------------------------------
--
-- Method:   setAngle
--
-- Description: Set the leg angle without recalculating any ensuring the leg passes through a specified point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Angle
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAngle(!angle is REAL)
  !this.angle = !angle
endmethod
-- End of method .setAngle()

------------------------------------------------------------------------
--
-- Method:   setAngle
--
-- Description: Set the leg angle ensuring the leg passes through a specified point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Angle
--  1   R       POSITION   Fixed position
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAngle(!angle is REAL, !fixedPosition is POSITION)

  -- Calculate offset for start of branch leg
  !distance = max(!this.getHorizontalDistance(!fixedPosition) - !this.startSlopeDistance, 0)
  !distance = min(!distance, !this.slopeLength)
  !offset = tan(!angle) * !distance
  !this.offset = !this.startPosition.up - !fixedPosition.up - !offset
  !!pipeSlopeUtilities.roundDistanceToZero(!this.offset)

  -- Calculate drop, allowing for any existing slope on the leg
  !this.drop = tan(!angle) * !this.slopeLength
  !this.drop = !this.drop - (!this.startPosition.up - !this.finishPosition.up)
  !!pipeSlopeUtilities.roundDistanceToZero(!this.drop)

endmethod
-- End of method .setAngle(REAL, POSITION)

------------------------------------------------------------------------
--
-- Method:   setAngle
--
-- Description: Set the leg angle by moving the leg start or finish
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Angle
--  1   R       BOOLEAN    Adjust start or finish position
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAngle(!angle is REAL, !forwards is BOOLEAN)

  if (!this.anchorPoints[1].isSet() and !this.anchorPoints[2].isSet()) then
    return error 1 'Branch leg angle could not be changed as two anchor points have already been set'
  elseif (!this.anchorPoints[1].isUnset() and !this.anchorPoints[2].isUnset()) then
    if (!forwards) then
      !fixedPosition = !this.getAdjustedStartPosition()
    else
      !fixedPosition = !this.getAdjustedFinishPosition()
    endif
  elseif (!this.anchorPoints[1].isSet()) then
    !fixedPosition = !this.anchorPoints[1].getPosition()
  elseif (!this.anchorPoints[2].isSet()) then
    !fixedPosition = !this.anchorPoints[2].getPosition()
  endif

  !this.setAngle(!angle, !fixedPosition)

endmethod
-- End of method .setAngle(REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:   getAnchorPoint
--
-- Description: Returns the specified anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Index to required anchor point
-- Return:
-- [Data Type]            [Description]
--  PIPESLOPEANCHORPOINT   Anchor point
--
------------------------------------------------------------------------
define method .getAnchorPoint(!anchorNumber is REAL) is PIPESLOPEANCHORPOINT

  if (!anchorNumber lt 1 or !anchorNumber gt !this.anchorPoints.size()) then
    return error 1 'Anchor number out of range'
  endif
  return !this.anchorPoints[!anchorNumber]
endmethod
-- End of method .getAnchorPoint

------------------------------------------------------------------------
--
-- Method:   setAnchorTypeNone
--
-- Description: Set the anchor type to 'None'
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Anchor to set
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorTypeNone(!anchorNumber is REAL) is STRING

 !this.anchorPoints[!anchorNumber].setAnchorTypeNone()

endmethod
-- End of method .setAnchorTypeNone

------------------------------------------------------------------------
--
-- Method:   setFixedHorizontal
--
-- Description: Forces the leg to be horizontal
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Anchor to set
--  2   R      BOOLEAN     Calculation direction
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setFixedHorizontal(!fixedHorizontal is BOOLEAN, !forwards is BOOLEAN) is REAL
  !newAngle = !this.angle
  !this.fixedHorizontal = !fixedHorizontal
  if (!fixedHorizontal) then
    if (!this.anchorPoints[1].isSet() and !this.anchorPoints[2].isSet()) then
      if (!forwards) then
        !this.anchorPoints[2].setAnchorTypeNone()
      else
        !this.anchorPoints[1].setAnchorTypeNone()
      endif
    endif
    !newAngle = 0
  endif

  !this.setAngle(!newAngle, !forwards)

endmethod
-- End of method .setFixedHorizontal

------------------------------------------------------------------------
--
-- Method:      .shiftFinishPosition
--
-- Description: Set the leg angle by shifting the finish position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Angle of slope
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shiftFinishPosition(!angle is REAL)

    !this.drop = !this.drop + !this.calculateShift(!angle)

endmethod
-- End of method .shiftFinishPosition

------------------------------------------------------------------------
--
-- Method:      .shiftStartPosition
--
-- Description: Set the leg angle by shifting the start position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Angle of slope
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .shiftStartPosition(!angle is REAL)

  !shift = !this.calculateShift(!angle)
  !this.offset = !this.offset - !shift
  !this.drop = !this.drop + !shift

endmethod
-- End of method .shiftStartPosition

------------------------------------------------------------------------
--
-- Method:      .lengthenLegStart
--
-- Description: Lengthen a leg from the leg start
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R/W       REAL      Shift in leg position (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .lengthenLegStart(!shift is REAL) is BOOLEAN

  if (!this.getFirstAnchorComponent(false) eq !this.getStartComponent()) then
    return false
  else
    !this.offset = !this.offset + !shift
    !this.drop = !this.drop - !shift
    !shift = 0.0
    return true
  endif

endmethod
-- End of method .lengthenLegStart

------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      .lengthenLegFinish
--
-- Description: Lengthen a leg from the leg finish
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R/W       REAL      Shift (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .lengthenLegFinish(!shift is REAL) is BOOLEAN

  if (!this.getFirstAnchorComponent(true) eq !this.getFinishComponent()) then
    return false
  else
    !this.drop = !this.drop + !shift
    !shift = 0.0
    return true
  endif

endmethod
-- End of method .lengthenLegFinish

------------------------------------------------------------------------
--
-- Method:      .shortenLegStart
--
-- Description: Shorten a leg from the leg start
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R/W       REAL      Shift in leg position (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .shortenLegStart(!shift is REAL) is BOOLEAN

  -- When shifting a vertical branch leg up or down, this routine adjusts the branch
  -- leg offset, effectively shortening the leg at its start and absorbing some
  -- or all of the shift. The amount of shortening is restricted to the amount of tube
  -- between the leg start component and the closest fixed position component (if any)
  !result = true
  if (!shift ne 0) then

    !result = false
    !anchorHeight = REAL()
    !anchorComponent = !this.getFirstAnchorComponent(false)
    if (!anchorComponent.set()) then
      !anchorHeight = !anchorPoint.getHeight()
    endif

    if (!anchorComponent ne !this.getStartComponent()) then

      !finishComponent = !this.getFinishComponent()
      !tubeLength = 0
      do !component value !this.components
        break if (!component eq !finishComponent)
        !tubeLength = !tubeLength + !component.dbRef().ltlen

        if (!component eq !anchorComponent) then
          !componentHeight = !component.getPosition().up
          !heightChange = !anchorHeight - !componentHeight
          if (!shift gt 0) then
            !tubeLength = !tubeLength - !heightChange
          else
            !tubeLength = !tubeLength + !heightChange
          endif

        endif
      enddo

      if (!shift gt 0) then
        !lengthChange =  min(!tubeLength + !this.drop,  !shift)
      else
        !lengthChange = -min(!tubeLength - !this.drop, -!shift)
      endif
      !this.offset = !this.offset + !lengthChange
      !this.drop = !this.drop - !lengthChange
      !shift = !shift - !lengthChange
      if (!shift ne 0 and !anchorComponent.unset()) then
        !result = true
      endif
     endif
  endif

  return !result

endmethod
-- End of method .shortenLegStart

------------------------------------------------------------------------
--
-- Method:      .shortenLegFinish
--
-- Description: Shorten a leg from the leg finish
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R/W       REAL      Shift in leg position (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .shortenLegFinish(!shift is REAL) is BOOLEAN

  -- When shifting a vertical branch leg up or down, this routine adjusts the branch
  -- leg drop, effectively shortening the leg at its finish, absorbing some or all of the shift.
  -- The amount of shortening is restricted to the amount of tube between the
  -- leg finish component and the closest fixed position component (if any)

  !result = true
  if (!shift ne 0) then
    !result = false
    !anchorHeight = REAL()
    !anchorComponent = !this.getFirstAnchorComponent(true)
    if (!anchorComponent.set()) then
      !anchorHeight = !anchorPoint.getHeight()
    endif

    if (!anchorComponent ne !this.getFinishComponent()) then

      -- Find the amount of tube between the leg finish and the closest fixed
      -- position component.
      !startComponent = !this.getStartComponent()
      !finishComponent = !this.getFinishComponent()
      !this.components.invert()
      !tubeLength = 0
      do !component value !this.components
        skip if (!component eq !finishComponent)
        !tubeLength = !tubeLength + !component.dbRef().ltlen

        if (!component eq !anchorComponent) then
          !componentHeight = !component.position.wrt(/* ).up
          !heightChange = !anchorHeight - !componentHeight
          if (!shift gt 0) then
            !tubeLength = !tubeLength - !heightChange
          else
            !tubeLength = !tubeLength + !heightChange
          endif
          break
        endif
      enddo
      !this.components.invert()

      -- Find how much to change the leg length, given that the drop may not
      -- be zero at this point.

      if (!shift gt 0) then
        !lengthChange =  min(!tubeLength - !this.drop, !shift)
      else
        !lengthChange = -min(!tubeLength + !this.drop, -!shift)
      endif
      !this.drop = !this.drop + !lengthChange
      !shift = !shift - !lengthChange

      if (!shift ne 0 and !anchorComponent.unset()) then
        !result = true
      endif
    endif
  endif

  return !result

endmethod
-- End of method .shortenLegFinish

------------------------------------------------------------------------
--
-- Method:      .forwardShiftLeg
--
-- Description: Shift a leg in the forwards direction
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Shift (downwards)
--  2   R       BOOLEAN     Override fixing of the start position
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Whether to adjust adjacent legs
--
------------------------------------------------------------------------
define method .forwardShiftLeg(!shift is REAL, !ignoreFixedStart is BOOLEAN) is BOOLEAN

  !result = false
  if (!this.isStartPositionFixed().not() or !ignoreFixedStart) then
    if (!this.isLegVertical()) then
      !result = !this.forwardShiftVerticalLeg(!shift)
    else
      !result = !this.forwardShiftHorizontalLeg(!shift, !ignoreFixedStart)
    endif
  endif

  !this.calculateComponentOffsets()
  return !result

endmethod
-- End of method .forwardShiftLeg

------------------------------------------------------------------------
--
-- Method:      .forwardShiftVerticalLeg
--
-- Description: Shift a vertical leg in the forwards direction
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Shift (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Whether to adjust adjacent legs
--
------------------------------------------------------------------------
define method .forwardShiftVerticalLeg(!shift is REAL) is BOOLEAN

  if (!shift gt 0) then
    if (!this.startPosition.up gt !this.finishPosition.up) then
      if (!this.shortenLegStart(!shift)) then
        return !this.shiftLegFinish(!shift)
      endif
    else
      return !this.lengthenLegStart(!shift)
    endif
  else
    if (!this.startPosition.up gt !this.finishPosition.up) then
      return !this.lengthenLegStart(!shift)
    else
      if (!this.shortenLegStart(!shift)) then
        return !this.shiftLegFinish(!shift)
      endif
    endif
  endif

  return false
endmethod
-- End of method .forwardShiftVerticalLeg


------------------------------------------------------------------------
--
-- Method:      .forwardShiftHorizontalLeg
--
-- Description: Shift a horizontal leg in the forwards direction
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Shift (downwards)
--  2   R       BOOLEAN     Override fixing of the start position
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Whether to adjust adjacent legs
--
------------------------------------------------------------------------
define method .forwardShiftHorizontalLeg(!shift is REAL, !ignoreFixedStart is BOOLEAN) is BOOLEAN

  !result = false
  !numberOfAnchorPoints = !this.anchorPoints[1].isSet().real() + !this.anchorPoints[2].isSet().real()

  if (!numberOfAnchorPoints eq 2) then
    !this.fixedHorizontal = false
  endif

  if (!this.isStartPositionFixed() and !ignoreFixedStart) then
    !numberOfAnchorPoints = !numberOfAnchorPoints - 1
  endif

  if (!numberOfAnchorPoints eq 0) then
    !this.offset = !this.offset + !shift
    !result = true
  elseif (!numberOfAnchorPoints eq 1) then
    -- Find position of anchor
    if (!this.anchorPoints[1].isSet()) then
      !anchorPosition = !this.anchorPoints[1].getPosition()
    else
      !anchorPosition = !this.anchorPoints[2].getPosition()
    endif

    -- Calculate the new drop between the start and the anchor position
    !newStart = !this.getAdjustedStartPosition().up - !shift
    !drop = !newStart - !anchorPosition.up

    -- Allow for a non-sloping region at the start of the leg
    !horizontalDistance = !this.getHorizontalDistance(!anchorPosition) - !this.startSlopeDistance

    -- If the anchor point is within the non-sloping region, don't shift the pipe
    if (!this.slopeLength le 0 or !horizontalDistance le 0) then
      return false
    else
        !horizontalDistance = min(!this.slopeLength, !horizontalDistance)
        !angle = atan(!drop / !horizontalDistance)

        handle any
          !angle = 90 deg
        endhandle

      -- Only shift leg if angle is (arbitrarily) less than 45 degrees
      if (!angle.abs() le 45 deg) then
        !this.setAngle(!angle, !anchorPosition)
        !result = true
      endif
    endif

  endif

  return !result
endmethod
-- End of method .forwardShiftHorizontalLeg

------------------------------------------------------------------------
--
-- Method:      .reverseShiftLeg
--
-- Description: Shift a leg in the reverse direction
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Shift (downwards)
--  2   R       BOOLEAN     Override fixing of the finish position
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Whether to adjust adjacent legs
--
------------------------------------------------------------------------
define method .reverseShiftLeg(!shift is REAL, !ignoreFixedFinish is BOOLEAN) is BOOLEAN

 !result = false
  if (!this.isFinishPositionFixed().not() or !ignoreFixedFinish) then
    if (!this.isLegVertical()) then
      !result = !this.reverseShiftVerticalLeg(!shift)
    else
      !result = !this.reverseShiftHorizontalLeg(!shift, !ignoreFixedFinish)
    endif
  endif
  !this.calculateComponentOffsets()
  return !result

endmethod
-- End of method .reverseShiftLeg

------------------------------------------------------------------------
--
-- Method:      .reverseShiftVerticalLeg
--
-- Description: Shift a vertical leg in the reverse direction
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Shift (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Whether to adjust adjacent legs
--
------------------------------------------------------------------------
define method .reverseShiftVerticalLeg(!shift is REAL) is BOOLEAN

  if (!shift gt 0) then
    if (!this.startPosition.up gt !this.finishPosition.up) then
      return !this.lengthenLegFinish(!shift)
    else
      if (!this.shortenLegFinish(!shift)) then
        return !this.shiftLegStart(!shift)
      endif
    endif
  else
    if (!this.startPosition.up gt !this.finishPosition.up) then
      if (!this.shortenLegFinish(!shift)) then
        return !this.shiftLegStart(!shift)
      endif
    else
      return !this.lengthenLegFinish(!shift)
    endif
  endif

  return false
endmethod
-- End of method .reverseShiftVerticalLeg

------------------------------------------------------------------------
--
-- Method:      .reverseShiftHorizontalLeg
--
-- Description: Shift a horizontal leg in the reverse direction
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Shift (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     Whether to adjust adjacent legs
--
------------------------------------------------------------------------
define method .reverseShiftHorizontalLeg(!shift is REAL, !ignoreFixedFinish is BOOLEAN) is BOOLEAN

  !result = false

  !numberOfAnchorPoints = !this.anchorPoints[1].isSet().real() + !this.anchorPoints[2].isSet().real()
  if (!numberOfAnchorPoints eq 2) then
    !this.fixedHorizontal = false
  endif
  if (!this.isFinishPositionFixed() and !ignoreFixedFinish) then
    !numberOfAnchorPoints = !numberOfAnchorPoints - 1
  endif

  if (!numberOfAnchorPoints eq 0) then
    !this.offset = !this.offset + !shift
    !result = true
  elseif (!numberOfAnchorPoints eq 1) then

    -- Find position of anchor
    if (!this.anchorPoints[1].isSet()) then
      !anchorPosition = !this.anchorPoints[1].getPosition()
    else
      !anchorPosition = !this.anchorPoints[2].getPosition()
    endif

    -- Calculate the new drop between the finish and the anchor position
    !newFinish = !this.getAdjustedFinishPosition().up - !shift
    !drop = !anchorPosition.up - !newFinish

    !horizontalDistance = !this.finishSlopeDistance - !this.getHorizontalDistance(!anchorPosition)

    -- If the anchor point is within the non-sloping region, don't shift the pipe
    if (!this.slopeLength le 0 or !horizontalDistance le 0) then
      return false
    else
      !horizontalDistance = min(!this.slopeLength, !horizontalDistance)
      !angle = atan(!drop / !horizontalDistance)

      handle any
        !angle = 90 deg
      endhandle
        -- Only shift leg if angle is (arbitrarily) less than 45 degrees
      if (!angle.abs() le 45 deg) then
        !this.setAngle(!angle, !anchorPosition)
        !result = true
      endif
    endif
  endif

  return !result

endmethod
-- End of method .reverseShiftHorizontalLeg

------------------------------------------------------------------------
--
-- Method:   setFirstAnchorType
--
-- Description: Set the first anchor type
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Anchor to set
--  2   R       REAL       Offset
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setFirstAnchorType(!anchorType is STRING, !offset is REAL)

  !this.anchorPoints[1].setAnchorType(!anchorType)

  if (!this.isLegVertical) then
    if (!anchorType ne !this.anchorInfo.typeNone) then
      if (!this.anchorPoints[2].isSet()) then
        !this.offset = 0.0
        !this.drop = 0.0
      else
        !this.drop = !this.drop + !this.offset
        !this.offset = 0
      endif
    endif
  else
    if (!anchorType ne !this.anchorInfo.typeNone) then
      if (!this.anchorPoints[2].isSet() and !this.fixedHorizontal) then
        !this.fixedHorizontal = false
      endif
      !this.anchorPoints[1].setPosition(!this.components.first().getPosition())
      !this.anchorPoints[1].setComponent(!this.components.first())
      !this.anchorPoints[1].setDistance( 0.0 )
    endif

    if (!this.fixedHorizontal) then
      !angle = 0
    else
      !angle = !this.angle
    endif

    -- Find and set anchor component pipe radius
    !this.setAnchorRadius(!this.anchorPoints[1])

    if (!anchorType eq !this.anchorInfo.typeNone) then
      if (!this.anchorPoints[2].isSet()) then
        !this.setAngle(!angle, !this.anchorPoints[2].getPosition())
      else
        !this.offset = !offset
      endif
    else
      if (!this.anchorPoints[2].isSet()) then
        !this.calculateOffsetAndDrop(1)
      else
        !this.setAngle(!angle, !this.anchorPoints[1].getPosition())
      endif
    endif
  endif
endmethod
-- End of method .setFirstAnchorType

------------------------------------------------------------------------
--
-- Method:   setAnchorTypeEnd
--
-- Description: Set the anchor type to end
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Anchor to set
--  2   R       REAL       Offset
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorTypeEnd(!anchorNumber is REAL)

  if (!anchorNumber eq 1) then
    !this.setFirstAnchorType(!this.anchorInfo.typeEnd, !this.offset)
  else
    !this.setSecondAnchorType(!this.anchorInfo.typeEnd, !this.offset)
  endif
endmethod
-- End of method .setAnchorTypeEnd

------------------------------------------------------------------------
--
-- Method:   setSecondAnchorType
--
-- Description: Set the second anchor type
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Anchor to set
--  2   R       REAL       Requested offset - not always used
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setSecondAnchorType(!anchorType is STRING, !offset is REAL)

  !this.anchorPoints[2].setAnchorType(!anchorType)

  if (!this.isLegVertical) then
    if (!anchorType ne !this.anchorInfo.typeNone) then
      if (!this.anchorPoints[1].isSet()) then
        !this.offset = 0.0
        !this.drop = 0.0
      else
        !this.drop = -!this.offset
      endif
    endif
  else
    -- Clear fixed horizontal flag if both anchors are set
    if (!anchorType ne !this.anchorInfo.typeNone) then
      if (!this.anchorPoints[1].isSet() and !this.fixedHorizontal) then
        !this.fixedHorizontal = false
      endif
      !this.anchorPoints[2].setPosition(!this.components.last().getPosition())
      !this.anchorPoints[2].setComponent(!this.components.last())
      !this.anchorPoints[2].setDistance(!this.getLength())
    endif

    -- Set angle
    if (!this.fixedHorizontal) then
      !angle = 0
    else
      !angle = !this.angle
    endif

    -- Set anchor component radius
    !this.setAnchorRadius(!this.anchorPoints[1])

    if (!anchorType eq !this.anchorInfo.typeNone) then
      if (!this.anchorPoints[1].isSet()) then
        !this.setAngle(!angle, !this.anchorPoints[1].getPosition())
      else
        !this.offset = !offset - !this.drop
      endif
    else
      if (!this.anchorPoints[1].isSet()) then
        !this.calculateOffsetAndDrop(2)
      else
        !this.setAngle(!angle, !this.anchorPoints[2].getPosition())
      endif
    endif
  endif
endmethod
-- End of method .setSecondAnchorType

------------------------------------------------------------------------
--
-- Method:   setAnchorFromElement
--
-- Description: Set the anchor from element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL    Anchor to set
--  1   R       DBREF   Element to anchor with respect to
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorFromElement(!anchorNumber is REAL, !element is DBREF)

  !this.anchorPoints[!anchorNumber].setFromElement(!element)
  !this.setAnchorRadius(!this.anchorPoints[!anchorNumber])
  !this.calculateOffsetAndDrop(!anchorNumber)

endmethod
-- End of method .setAnchorFromElement


------------------------------------------------------------------------
--
-- Method:   setAnchorComponent
--
-- Description: Set the anchor component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL    Anchor to set
--  1   R       DBREF   Component to anchor
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorComponent(!anchorNumber is REAL, !componentIndex is REAL)

  !component = !this.components[!componentIndex]
  !this.anchorPoints[!anchorNumber].setComponent(!this.components[!componentIndex])
  !this.calculateOffsetAndDrop(!anchorNumber)

endmethod
-- End of method .setAnchorComponent

------------------------------------------------------------------------
--
-- Method:   setAnchorDistance
--
-- Description: Set the anchor distance
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL    Anchor to set
--  1   R       REAL    Distance of anchor from leg start
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorDistance(!anchorNumber is REAL, !sourceDistance is REAL)

  -- Constrain the distance to fit within the branch leg
  !distance = max(min(!this.getLength(), !sourceDistance), 0)
  !this.anchorPoints[!anchorNumber].setDistance(!distance)

  !line = object LINE(!this.getStartPosition(), !this.getFinishPosition())
  !proportion = !distance / !this.getLength()
  !fixedPosition = !line.proportion(!proportion)
  !this.anchorPoints[!anchorNumber].setPosition(!fixedPosition)
  !this.setAnchorRadius(!this.anchorPoints[!anchorNumber])
  !this.calculateOffsetAndDrop(!anchorNumber)

endmethod
-- End of method .setAnchorDistance

------------------------------------------------------------------------
--
-- Method:   setAnchorOffset
--
-- Description: Set the anchor distance
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL    Anchor to set
--  1   R       REAL    Offset
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------

define method .setAnchorOffset(!anchorNumber is REAL, !offset is REAL)

  !this.anchorPoints[!anchorNumber].setOffset(!offset)
  !this.calculateOffsetAndDrop(!anchorNumber)

endmethod
-- End of method .setAnchorOffset


------------------------------------------------------------------------
--
-- Method:   setAnchorPoint
--
-- Description: Set the anchor method for an anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL    Anchor to set
--  1   R       STRING  Anchor method
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorPoint(!anchorNumber is REAL, !method is STRING)

  !this.anchorPoints[!anchorNumber].setAnchorMethod(!method)
  !this.calculateOffsetAndDrop(!anchorNumber)

endmethod
-- End of method .setAnchorPoint

------------------------------------------------------------------------
--
-- Method:   setAnchorFromMethod
--
-- Description: Set the anchor from method for an anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL    Anchor to set
--  1   R       STRING  Anchor from method
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------
define method .setAnchorFromMethod(!anchorNumber is REAL, !method is STRING)

  !this.anchorPoints[!anchorNumber].setFromMethod(!method)
  !this.calculateOffsetAndDrop(!anchorNumber)

endmethod
-- End of method .setAnchorFromMethod

------------------------------------------------------------------------
--
-- Method:      .calculateOffsetAndDrop
--
-- Description: Calculates the offset and drop for a branch leg when an
--              anchor point is changed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   RW      REAL        Anchor number
--
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculateOffsetAndDrop(!fixedAnchorNumber is REAL)
  if (!this.isFirstAnchorPointSet() and !this.isSecondAnchorPointSet()) then
    !firstPosition = !this.anchorPoints[1].getPosition()
    !secondPosition = !this.anchorPoints[2].getPosition()

    !separation = !this.getHorizontalDistance(!secondPosition) - !this.getHorizontalDistance(!firstPosition)
    if (!separation lt 0) then

      !this.anchorPoints.invert()
      if (!fixedAnchorNumber eq 1) then
        !anchorNumber = 2
      else
        !anchorNumber = 1
      endif
      !!pipeSlopeMessages.addAlert('Anchor points will be reversed so that the first anchor point is closer to the leg start than the second')
    endif

    !separation = !separation.abs()
    if (!separation lt !!pipeSlopeUtilities.distanceTolerance) then
      !angle = 0
      !!pipeSlopeMessages.addWarning('Anchor points are too close together, slope angle set to zero')
    else
      !angle = atan((!firstPosition.up - !secondPosition.up) / !separation)
    endif

  else
    if (!this.fixedHorizontal) then
      !angle = 0
    else
      !angle = !this.angle
    endif
  endif

  !this.setAngle(!angle, !this.anchorPoints[!fixedAnchorNumber].getPosition())

endmethod
-- End of method .calculateOffsetAndDrop

------------------------------------------------------------------------
--
-- Method:      .initialiseAnchorPoints
--
-- Description: Initialise leg anchor points
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .initialiseAnchorPoints()

  !this.anchorPoints.append(object PIPESLOPEANCHORPOINT())
  !this.anchorPoints.append(object PIPESLOPEANCHORPOINT())

  !startComponent = !this.getStartComponent()

  -- If the branch head is not connected to the current pipe, fix the start position
  if (!startComponent.isBranch()) then
    !pipeMembers = !!collectAllFor('', '', !this.branch.owner)
    if (!pipeMembers.findFirst(!this.branch.href).unset()) then
      !this.anchorPoints[1].setAnchorTypeEnd(!startComponent.getPosition())
    endif
  endif

  !finishComponent = !this.getFinishComponent()
  -- If the branch tail is not connected to the current pipe, fix the finish position
  if (!finishComponent.isBranch()) then
    !pipeMembers = !!collectAllFor('', '', !this.branch.owner)
    if (!pipeMembers.findFirst(!this.branch.tref).unset()) then
      !this.anchorPoints[2].setAnchorTypeEnd(!finishComponent.getPosition())
    endif
  endif

  !pipeRadius = max(!this.branch.phod, !this.branch.ptod) / 2.0

  !this.anchorPoints[1].setPosition(!this.startPosition)
  !this.anchorPoints[1].setComponent(!startComponent)
  !this.anchorPoints[1].setVertical(!this.isLegVertical)
  !this.anchorPoints[1].setPipeRadius(!pipeRadius)

  !this.anchorPoints[2].setPosition(!this.finishPosition)
  !this.anchorPoints[2].setComponent(!finishComponent)
  !this.anchorPoints[2].setVertical(!this.isLegVertical)
  !this.anchorPoints[2].setDistance(!this.getLength())
  !this.anchorPoints[2].setPipeRadius(!pipeRadius)

endmethod
-- End of method .initialiseAnchorPoints

------------------------------------------------------------------------
--
-- Method:      .canSlopeStart
--
-- Description: Decides whether the start of the leg can be tilted
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Angle of slope
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if leg start can be tilted
------------------------------------------------------------------------
define method .canSlopeStart(!angle is REAL) is BOOLEAN

  !startComponent = !this.getStartComponent()
  !startComponentRef = !startComponent.dbRef()

  -- Handle branch head
  if (!startComponent.isBranch()) then
      -- If connected to a tee, only allow sloping about the long axis
      !connectionRef = !startComponentRef.href
      if (!connectionRef.set() and !connectionRef.type eq 'TEE') then
        -- Potentially allow sloping if the tail is connected to ppoint 3 - determined by
        -- comparing directions
        if (!startComponentRef.hdir eq !connectionRef.pdir[3]) then
          -- If the tee is vertically oriented, only allow sloping only if the offTol is big enough
          if (!!pipeSlopeUtilities.isDirectionVertical(!connectionRef.adir)) then
            if (!connectionRef.ppOffTol[3] lt !angle.abs()) then
              !!pipeSlopeMessages.addMessage('Leg ' + !this.legNumber.string() + ' not sloped. A larger offset tolerance should be set on the initial tee.')
              return false
            endif
          endif
        endif
      endif
    return (!this.slopeLength ne 0)

  -- If the component is a tee in the horizontal plane, only allow sloping about the long axis.
  elseif (!this.getStartComponent().isHorizontalTee()) then
    if (!startComponentRef.leave eq 3) then
      return (!this.slopeLength ne 0)
    else
      return false
    endif
  endif

  !arriveDirection = !startComponentRef.adir
  !type = !startComponentRef.type
  if (!type eq 'ELBO') then
    if (!!pipeSlopeUtilities.isDirectionVertical(!arriveDirection)) then
      -- Allow sloping for vertical plane elbows where the bend angle is greater than 90 deg
      if ((!arriveDirection.up gt 0 and !angle ge 0.0) or $
          (!arriveDirection.up lt 0 and !angle le 0.0)) then
        return true
      endif
    else
      return true
    endif
  elseif (!type eq 'BEND') then
    return true
  endif

  if (!!pipeSlopeUtilities.isDirectionVertical(!arriveDirection)) then
    -- Check component leave direction against offset tolerance
    !offsetTolerance = !startComponentRef.ppOffTol[!startComponentRef.leave]

    if (!angle.abs() le !offsetTolerance) then
      return true
    endif
  else
    return true
  endif

  !!pipeSlopeMessages.addMessage('Leg ' + !this.legNumber.string() + ' not sloped. Start elbow angle would be less than 90 degrees')
  return false
endmethod
-- End of method .canSlopeStart

------------------------------------------------------------------------
--
-- Method:      .canSlopeFinish
--
-- Description: Decides whether the finish of the leg can be tilted
--
-- Method Type: Procedure
-- [#] [R/RW]  [Data Type] [Description]
--  1   R       REAL        Angle of slope
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if leg finish can be tilted
------------------------------------------------------------------------
define method .canSlopeFinish(!angle is REAL) is BOOLEAN

  !finishComponent = !this.getFinishComponent()
  !finishComponentRef = !finishComponent.dbRef()

  if (!finishComponent.isBranch()) then
      -- If connected to a tee, only allow sloping about the long axis
      !connectionRef = !finishComponentRef.tref

      if (!connectionRef.set() and !connectionRef.type eq 'TEE') then
        -- Potentially allow sloping if the tail is connected to ppoint 3 - determined by
        -- comparing directions

        if (!finishComponentRef.tdir eq !connectionRef.pdir[3]) then
           -- If the tee is vertically oriented, only allow sloping only if the offTol is big enough
          if (!!pipeSlopeUtilities.isDirectionVertical(!connectionRef.adir)) then
            if (!connectionRef.ppOffTol[3] lt !angle.abs()) then
              !!pipeSlopeMessages.addMessage('Leg ' + !this.legNumber.string() + ' not sloped. A larger offset tolerance should be set on the final tee.')
              return false
            endif
          endif
        endif
      endif
      return (!this.slopeLength ne 0)
  -- If the component is a tee in the horizontal plane, only allow sloping about the long axis.
  elseif (!this.getFinishComponent().isHorizontalTee()) then
    if (!finishComponentRef.arrive eq 3) then
      return (!this.slopeLength ne 0)
    else
      return false
    endif
  endif

  !leaveDirection = !finishComponentRef.ldir
  !type = !finishComponentRef.type
  if (!type eq 'ELBO') then
    if (!!pipeSlopeUtilities.isDirectionVertical(!leaveDirection)) then
      -- Allow sloping for elbows where the bend angle is greater than 90 deg
      if ((!leaveDirection.up gt 0 and !angle le 0.0) or $
          (!leaveDirection.up lt 0 and !angle ge 0.0)) then
        return true
      endif
    else
      return true
    endif
  elseif (!type eq 'BEND') then
    return true
  endif

  if (!!pipeSlopeUtilities.isDirectionVertical(!leaveDirection)) then
    -- Check component arrive direction against offset tolerance
    !offsetTolerance = !finishComponentRef.ppOffTol[!finishComponentRef.leave]
    if (!angle.abs() le !offsetTolerance) then
      return true
    endif
  else
    return true
  endif
  !!pipeSlopeMessages.addMessage('Leg ' + !this.legNumber.string() + ' not sloped. Finish elbow angle would be less than 90 degrees')
  return false
endmethod
-- End of method .canSlopeFinish

------------------------------------------------------------------------
--
-- Method:      .shiftLegStart
--
-- Description: Shift the leg start
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Shift (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if successful
------------------------------------------------------------------------
define method .shiftLegStart(!shift is REAL) is BOOLEAN

  if (!this.isStartPositionFixed().not()) then
    !this.offset = !this.offset + !shift
    return true
  endif

  return false
endmethod
-- End of method .shiftLegStart

------------------------------------------------------------------------
--
-- Method:      .shiftLegFinish
--
-- Description: Shift the leg finish
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Shift (downwards)
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .shiftLegFinish(!shift is REAL) is BOOLEAN

  if (!this.isFinishPositionFixed().not()) then
    !this.offset = !this.offset + !shift
    return true
  endif

  return false
endmethod
-- End of method .shiftLegFinish

------------------------------------------------------------------------
--
-- Method:   calculateComponentOffsets()
--
-- Description: Calculates and sets the offsets for all components in a branch leg
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .calculateComponentOffsets()

  -- Find offset for components in a horizontal leg
  if (!this.isLegHorizontal()) then

    do !component values !this.components
      if (!component eq !this.getStartComponent()) then
        !offset = !this.offset
      elseif (!component eq !this.getFinishComponent()) then
        !offset = !this.offset + !this.drop
      else
        !componentPosition = !component.getPosition()
        !length = !this.getHorizontalDistance(!componentPosition) - !this.startSlopeDistance
        if (!length le 0) then
          !offset = !this.offset
        elseif (!length ge !this.slopeLength) then
          !offset = !this.offset + !this.drop
        else
          !offset = !this.offset + !this.drop * !length / !this.getHorizontalLength()
        endif
      endif
      !component.setOffset(!offset)
    enddo
  else
    -- Find offsets for components in a vertical leg

    -- First set offsets for the start and finish components
    !componentCount = !this.components.size()
    !this.components[1].setOffset(!this.offset)
    !this.components[!componentCount].setOffset(!this.offset + !this.drop)

    -- Move intermediate components
   !offset = !this.offset
   !startComponentTop = !this.components[1].top()
   !startComponentBottom = !this.components[1].bottom()
   !finishComponentTop = !this.components[!componentCount].top()
   !finishComponentBottom = !this.components[!componentCount].bottom()

    -- If any components are above the branch leg, move them down to fit within it
    if (!this.startPosition.up gt !this.finishPosition.up) then
      !upperLimit = !startComponentBottom
      !lowerLimit = !finishComponentTop
      !start = 2
      !end = !this.components.size() - 1
      !step = 1
    else
      !upperLimit = !finishComponentBottom
      !lowerLimit = !startComponentTop
      !start = !this.components.size() - 1
      !end = 2
      !step = -1
    endif

    do !componentIndex from !start to !end by !step
      !shift = !this.components[!componentIndex].top() - !upperLimit
      -- Only move the component if it would remain within the leg boundaries
      if (!shift gt 0 and (!this.components[!componentIndex].bottom() + !shift) gt !lowerLimit) then
        !offset = !this.components[!componentIndex].getOffset() + !shift
        !this.components[!componentIndex].setOffset(!offset)
        !upperLimit = !upperLimit - !shift
      endif
    enddo

    -- If any components are below the branch leg, move them up to fit within it
    if (!this.startPosition.up gt !this.finishPosition.up) then
      !upperLimit = !startComponentBottom
      !lowerLimit = !finishComponentTop
      !start = !this.components.size() - 1
      !end = 2
      !step = -1
    else
      !upperLimit = !finishComponentBottom
      !lowerLimit = !startComponentTop
      !start = 2
      !end = !this.components.size() - 1
      !step = 1
    endif

    do !componentIndex from !start to !end by !step
      !shift = !lowerLimit - !this.components[!componentIndex].bottom()
      -- Only move the component if it would remain within the leg boundaries
      if (!shift lt 0 and (!this.components[!componentIndex].top() + !shift) lt !upperLimit) then
        !offset = !this.components[!componentIndex].getOffset() + !shift
        !this.components[!componentIndex].setOffset(!offset)
        !lowerLimit = !lowerLimit - !shift
      endif
    enddo

  endif
endmethod
-- End of method .calculateOffsets


------------------------------------------------------------------------
--
-- Method:   getComponentIndex()
--
-- Description: Find the index to a component/branch within the component list
--              Comparison is performed based on the dbRef.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- 1   R      DBREF       Component reference
-- 2   R      BOOLEAN     Whether to search from start to finish or vice versa
-- Return:
-- [Data Type] [Description]
--  REAL        Index to the component or unset if not found
--
------------------------------------------------------------------------
define method .getComponentIndex(!component is PIPESLOPECOMPONENT, !searchForwards is BOOLEAN) is REAL

    -- Search forwards or backwards through the intermediate components
    if (!searchForwards) then
      do !componentIndex indices !this.components
        if (!this.components[!componentIndex].equals(!component)) then
          return !componentIndex
        endif
      enddo
    else
      do !componentIndex from !this.components.size() to 1 by -1
        if (!this.components[!componentIndex].equals(!component)) then
          return !componentIndex
        endif
      enddo
    endif

  return REAL()

endmethod
-- End of method .getComponentIndex

------------------------------------------------------------------------
--
-- Method:   containsElement
--
-- Description: Finds whether a branch leg contains a specific element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- 1   R      DBREF       Element reference
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the element was found
--
------------------------------------------------------------------------

define method .containsElement(!element is DBREF) is BOOLEAN

  if (!element eq !this.branch) then
    return true
  else
    return !this.componentRefs.findFirst(!element).set()
  endif

endmethod
-- End of method containsElement

------------------------------------------------------------------------
--
-- Method:   getComponentOffset
--
-- Description: If possible, finds the component within a branch leg and returns
--              the offset.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- 1   R      DBREF       Component reference
-- 2   R      BOOLEAN     Whether to search from start to finish or vice versa
-- Return:
-- [Data Type] [Description]
--  REAL        Component offset or unset if component not found
--
------------------------------------------------------------------------

define method .getComponentOffset(!component is PIPESLOPECOMPONENT, !searchForwards is BOOLEAN) is REAL

  !componentIndex = !this.getComponentIndex(!component, !searchForwards)
  if (!componentIndex.set()) then
    return !this.components[!componentIndex].getOffset()
  endif
  return REAL()

endmethod
-- End of method getComponentOffset()


------------------------------------------------------------------------
--
-- Method:   setComponentOffset()
--
-- Description: Sets the offset for a component and attempts to move the rest of
--              the branch leg and components to match. The leg slope is not altered in
--              the process.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     REAL         Index to component to modify
--  2   R     REAL         The new offset for the component
--
-- Return:
-- [Data Type] [Description]
--  REAL        How much the start/finish of the leg moved
--
------------------------------------------------------------------------
define method .setComponentOffset(!componentIndex is REAL, !offset is REAL) is REAL

  -- Handle vertical and horizontal legs separately
  if (!this.isLegVertical) then

    !shift = !offset - !this.components[!componentIndex].getOffset()
    -- Attempt to set component offsets for a leg with the start height above the finish
    if (!this.startPosition.up gt !this.finishPosition.up) then
      if (!shift lt 0) then $* Move up

        if (!this.isStartPositionFixed()) then
          -- Check the available implied tube
          !tubeLength = 0
          do !index from 1 to !componentIndex - 1
            !tubeLength = !tubeLength + !this.components[!index].ltlen()
          enddo
          !tubeLength = !tubeLength + !offset - !this.components.first().getOffset()
          if (!shift.abs() gt !tubeLength) then
            -- Insufficient tube to accommodate the change in position so return without doing anything
            return 0
          endif
        endif
        -- Adjust component offset
        !this.components[!componentIndex].setOffset(!offset)

        -- Adjust the components that are earlier in the branch leg
        do !index from !componentIndex - 1 to 1 by -1
          !shift =  !this.components[!index].bottom() - !this.components[!index + 1].top()
          if (!shift lt 0) then
            !this.components[!index].shiftDown(!shift)
          else
            !shift = 0
             break
          endif
        enddo
      else $* Move down

        if (!this.isFinishPositionFixed()) then
          -- Check the length of implied tube available
          !tubeLength = 0
          do !index from !componentIndex to !this.components.size() - 1
            !tubeLength = !tubeLength + !this.components[!index].ltlen()
          enddo
          !tubeLength = !tubeLength - !offset + !this.components.last().getOffset()
          if (!shift.abs() gt !tubeLength) then
            -- Insufficient tube to accommodate the change in position so return without doing anything
            return 0
          endif
        endif

        -- Adjust component offset
        !this.components[!componentIndex].setOffset(!offset)

        -- Adjust the components that are later in the branch leg
        do !index from !componentIndex + 1 to !this.components.size()
          !shift =  !this.components[!index].top() - !this.components[!index - 1].bottom()
          if (!shift gt 0) then
            !this.components[!index].shiftDown(!shift)
          else
            !shift = 0
            break
          endif
        enddo

      endif

    else  $* Start below finish

      if (!shift lt 0) then $* Move up
        if (!this.isFinishPositionFixed()) then
          -- Check the length of implied tube available
          !tubeLength = 0
          do !index from !componentIndex to !this.components.size() - 1
            !tubeLength = !tubeLength + !this.components[!index].ltlen()
          enddo
          !tubeLength = !tubeLength + !offset - !this.components.last().getOffset()
          if (!shift.abs() gt !tubeLength) then
            -- Insufficient tube to accommodate the change in position so return without doing anything
            return 0
          endif
        endif

        -- Adjust component offset
        !this.components[!componentIndex].setOffset(!offset)

        -- Adjust the components that are later in the branch leg
        do !index from !componentIndex + 1 to !this.components.size()
          !shift =  !this.components[!index - 1].top() - !this.components[!index].bottom()
          if (!shift lt 0) then
            !this.components[!index].shiftDown(!shift)
          else
            !shift = 0
            break
          endif
        enddo

      else  $* Move down

        if (!this.isStartPositionFixed()) then
          -- Check the length of implied tube available
          !tubeLength = 0
          do !index from 1 to !componentIndex - 1
            !tubeLength = !tubeLength + !this.components[!index].ltlen()
          enddo
          !tubeLength = !tubeLength + !offset - !this.components.last().getOffset()
          if (!shift.abs() gt !tubeLength) then
            -- Insufficient tube to accommodate the change in position so return without doing anything
            return 0
          endif
        endif

        -- Adjust component offset
        !this.components[!componentIndex].setOffset(!offset)

        -- Adjust the components that are later in the branch leg
        do !index from !componentIndex - 1 to 1 by -1
          !shift =  !this.components[!index].top() - !this.components[!index + 1].bottom()
          if (!shift gt 0) then
            !this.components[!index].shiftDown(!shift)
          else
            !shift = 0
            break
          endif
        enddo

      endif

    endif
  else
    -- Horizontal leg - simply displace components. Do not move if either end is fixed.
    !shift = 0
    if (!this.isFirstAnchorPointSet().not() and !this.isSecondAnchorPointSet().not()) then
      !shift = !offset - !this.components[!componentIndex].getOffset()

      do !component values !this.components
        !component.shiftDown(!shift)
      enddo
      !this.offset = !this.offset + !shift
    endif

  endif

  !this.offset = !this.components.first().getOffset()
  !this.drop = !this.components.last().getOffset() - !this.offset

  return !shift

endmethod
-- End of method .setComponentOffset

------------------------------------------------------------------------
--
-- Method:   reconnectComponents
--
-- Description: Connects components after they have been moved
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .reconnectComponents()

  !directionIndex = 0
  do !connections value !this.connectionArrays

    !directionIndex = !directionIndex + 1
    !direction = !this.connectionDirections[!directionIndex]

    if (!direction eq 'BACKWARDS') then
      -- Connect to the last component, working backwards along the branch leg
      do !connectionIndex from !connections.size() - 1 to 1 by -1
        -- Reconnect everything except the leg start which should not be moved
        if (!connections[!connectionIndex] ne !this.getStartComponent().dbRef()) then
          !!ce = !connections[!connectionIndex]
          !p3dir = p3dir
          handle (2,201)
            if (!!ce.adir.isParallel(!!ce.ldir)) then
              connect to next
            else
              connect to next and pa is pa
            endif
          elsehandle none
            if (!p3Dir.isParallel(!!ce.ldir)) then
              connect to next
            else
              connect to next and p3 is $!p3dir
            endif
          endhandle
        endif
      enddo
    else
      -- Connect to the first component, working forwards along the branch leg
      do !connectionIndex from 2 to !connections.size()
        -- Reconnect everything except the leg finish which should not be moved
        if (!connections[!connectionIndex] ne !this.getFinishComponent().dbRef()) then
          !!ce = !connections[!connectionIndex]
          !p3dir = p3dir
          handle (2, 201)
            if (!!ce.adir.isParallel(!!ce.ldir)) then
              connect to prev
            else
              connect to prev and pl is pl
            endif
          elsehandle none
            if (!p3Dir.isParallel(!!ce.adir)) then
              connect to prev
            else
              connect to prev and p3 is $!p3dir
            endif

          endhandle
        endif
      enddo
    endif

  enddo

endmethod
-- End of method .reconnectComponents


------------------------------------------------------------------------
--
-- Method:   adjustStartConnections
--
-- Description: Adjust start connections to compensate for the effect of
--              bend angles changing. Only done for vertical legs
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]         [Description]
--  1   R     PIPESLOPEBRANCHLEG   Previous branch leg
--  2   R     BOOLEAN              If set, apply adjustment to current leg
--
-- Return:
-- [Data Type] [Description]
--  REAL        Calculate change in leg finish position
--
------------------------------------------------------------------------
define method .adjustStartConnections(!nextLeg is PIPESLOPEBRANCHLEG, !apply is BOOLEAN) is REAL

  if (!this.isLegHorizontal()) then
    return 0
  endif

  !finishComponentRef = !this.components.last().dbRef()
  if (not (!finishComponentRef.type inset('BEND', 'ELBO'))) then
    return 0
  endif

  -- Return if the finish component is not connected to anything
  if (!this.connectionArrays.size() eq 0 or !finishComponentRef ne !this.connectionArrays.last().last()) then
    return 0
  endif

  !arriveDir = !finishComponentRef.adir
  !leaveDir = !finishComponentRef.ldir
  !angle = 90deg - !arriveDir.angle(!leaveDir)

  if (abs(!angle) lt !!pipeSlopeUtilities.angleTolerance) then
    !angle = 0
  endif

  !newAngle = !nextLeg.getAdjustedAngle()
  if (abs(!newAngle) lt !!pipeSlopeUtilities.angleTolerance) then
    !newAngle = 0
  endif

  -- There may be a small separation between components even though they are considered to be connected.
  -- This needs to be taken into account as it can affect the final tube gradient
  !connectionArray = !this.connectionArrays.last()
  !penultimateComponentRef = !connectionArray[!connectionArray.size() - 1]
  !separation = !finishComponentRef.apos.distance(!penultimateComponentRef.lpos)

  -- Find the radius
  !distance = !finishComponentRef.pos.distance(!finishComponentRef.apos)
  !radius = !distance / tan(45deg + !angle / 2)

  !currentOffset = !radius * ( 1.0 - tan ( 45deg + !angle / 2) )
  !newOffset = !radius * ( 1.0 - tan ( 45deg + !newAngle / 2) )

  !shift = !newOffset - !currentOffset + !separation

  if (abs(!shift) lt !!pipeSlopeUtilities.distanceTolerance) then
    return 0
  endif

  if (!apply) then
    !this.drop = !this.drop + !shift
  endif

  return !shift
endmethod
-- End of method .adjustStartConnections

------------------------------------------------------------------------
--
-- Method:   adjustFinishConnections
--
-- Description: Adjust finish connections to compensate for the effect of
--              bend angles changing. Only done for vertical legs
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]         [Description]
--  1   R     PIPESLOPEBRANCHLEG   Previous branch leg
--  2   R     BOOLEAN              If set, apply adjustment to current leg
--
-- Return:
-- [Data Type] [Description]
--  REAL        Calculate change in leg finish position
--
-------------------------------------------------------------------------
define method .adjustFinishConnections(!previousLeg is PIPESLOPEBRANCHLEG, !apply is BOOLEAN) is REAL

  if (!this.isLegHorizontal()) then
    return 0
  endif

  !startComponentRef = !this.components[1].dbRef()
  if (not (!startComponentRef.type inset('BEND', 'ELBO'))) then
    return 0
  endif

  -- Return if the finish component is not connected to anything
  if (!this.connectionArrays.size() eq 0 or !startComponentRef ne !this.connectionArrays.first()[1]) then
    return 0
  endif

  !arriveDir = !startComponentRef.adir
  !leaveDir = !startComponentRef.ldir
  !angle = !leaveDir.angle(!arriveDir) - 90deg

  if (abs(!angle) lt !!pipeSlopeUtilities.angleTolerance) then
    !angle = 0
  endif

  !newAngle = !previousLeg.getAdjustedAngle()

  if (abs(!newAngle) lt !!pipeSlopeUtilities.angleTolerance) then
    !newAngle = 0
  endif

   -- Find the radius
  !distance = !startComponentRef.pos.distance(!startComponentRef.lpos)
  !radius = !distance / tan(45deg - !angle / 2)
  -- Find the change in position
  !currentOffset = !radius * ( 1.0 - tan ( 45deg - !angle / 2) )
  !newOffset = !radius * ( 1.0 - tan ( 45deg - !newAngle / 2) )

  !shift = !newOffset - !currentOffset

  if (abs(!shift) lt !!pipeSlopeUtilities.distanceTolerance) then
    return 0
  endif

  if (!apply) then
    !this.offset = !this.offset + !shift
    !this.drop = !this.drop - !shift
  endif

  return !shift

endmethod
-- End of method .adjustFinishConnections

------------------------------------------------------------------------
--
-- Method:   Set anchor radius
--
-- Description: Sets the pipe radius for an anchor point
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R       REAL       Anchor number
--
------------------------------------------------------------------------
define method .setAnchorRadius(!anchorPoint is PIPESLOPEANCHORPOINT)

  -- Anchor radius is only relevant to anchoring by component or position
  if (!anchorPoint.getAnchorType() eq !this.anchorInfo.typeComponent) then
    !componentRef = !anchorPoint.getComponent().dbRef()
    -- Use average of arrive and leave outside diameters in case component is a reducer
    -- Something more sophisticated may be needed later
    if (!componentRef.type eq 'BRAN') then
      !radius = (!componentRef.hbore.real() + !componentRef.tbore.real()) / 4.0
    else
      !radius = (!componentRef.aod + !componentRef.lod)/ 4.0
    endif
    !anchorPoint.setPipeRadius(!radius)

  elseif (!anchorPoint.getAnchorType() eq !this.anchorInfo.typePosition) then

    -- Find horizontal distance from the leg start to the anchor position
    !startPosition = !this.getAdjustedStartPosition()
    !finishPosition = !this.getAdjustedFinishPosition()
    !line = object LINE(!startPosition, !finishPosition)
    !line = !line.setLengthEnd(!anchorPoint.getDistance())
    !distance = !this.getHorizontalDistance(!line.endPosition)

    -- Find the component whose arrive and leave bracket the anchor position
    do !componentRef values !this.componentRefs
       if (!this.getHorizontalDistance(!componentRef.lpos) ge !distance) then
        if (!this.getHorizontalDistance(!componentRef.apos) le !distance) then
          -- Use average diameter (see above)
          !diameter = (!componentRef.aod + !componentRef.lod) / 2.0
          break
        else
          !diameter = !componentRef.aod
          break
        endif
      endif
    enddo

    -- If no diameter has been set, use the branch tail diameter
    if (undefined(!diameter)) then
      !diameter = !this.branch.ptod
    endif
    !anchorPoint.setPipeRadius(!diameter / 2.0)
  endif
endmethod
-- End of method .setAnchorRadius
