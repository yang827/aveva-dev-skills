-- Created:        08/06/2010 16:56:35
-- Last Modified:
-- Description:
-- Object used to represent a component or branch end in a sloping pipe.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  bottom()                         REAL                Returns the height of the top of component
--  changesDirection()               BOOLEAN             Test whether a component changes the branch direction
--  dbRef()                          DBREF               Returns the components database reference
--  direct(DIRECTION,BOOLEAN)        -                   Sets a component's direction and nominal direction - assumes forwards/backwards is correctly set
--  equals(PIPESLOPECOMPONENT)       BOOLEAN             Compares this component to another, based on DBREF and branch head/tail status
--  getBranch()                      DBREF               Returns the branch for the component
--  getOffset()                      REAL                Return the components offset (downward) from its original position
--  getPosition()                    POSITION            Returns the component position
--  height()                         REAL                Returns the height of the component
--  isBranch()                       BOOLEAN             Returns true if component is a branch
--  isHead()                         BOOLEAN             Returns true if component is the head of a branch
--  isHorizontalTee()                BOOLEAN             Tests whether a component is a tee in the horizontal plane
--  isMoveable()                     BOOLEAN             Test whether a component can be moved
--  isRotatable(DIRECTION)           BOOLEAN             Test whether a component is allowed to be rotated
--  isSupportAttachment()            BOOLEAN             Tests whether a component is a support attachment
--  isTail()                         BOOLEAN             Returns true if component is the tail of a branch
--  isTee()                          BOOLEAN             Tests whether a component is a tee
--  ltlen()                          REAL                Returns the leave tube length
--  moveDown()                       -                   Changes a components position to move it downwards by its offset
--  orient(DIRECTION)                -                   Sets a component's orientation.
--  pipeslopeComponent(DBREF,BOOLEAN) -
--  setAsRotatable(BOOLEAN)          -                   Set whether the component can be rotated
--  setOffset(REAL)                  -                   Set the components offset (downward) from its original position
--  shiftDown(REAL)                  -                   Shifts a component downwards
--  top()                            REAL                Returns the height of the top of component
--
------------------------------------------------------------------------

define object PIPESLOPECOMPONENT

  member .dbRef is DBREF
  member .isBranch is BOOLEAN
  member .isHead is BOOLEAN
  member .offset is REAL
  member .isRotatable is BOOLEAN
  member .isMoveable is BOOLEAN

endobject

------------------------------------------------------------------------
--
-- Method:   pipeSlopeComponent()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- 1   R      DBREF       Piping component or branch
-- 2   R      BOOLEAN     True if the component represents the branch head
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .pipeslopeComponent(!component is DBREF, !isBranchHead is BOOLEAN)

  !this.dbRef = !component
  !this.offset = 0mm

  if (!component.type eq 'BRAN') then
    !this.isBranch = true
    !this.isHead = !isBranchHead
  else
    !this.isBranch = false
    !this.isHead = false
  endif

  -- Decide whether the component can be rotated and set the rotatable flag accordingly
  if (!this.isSupportAttachment()) then
    !this.isRotatable = false
    !this.isMoveable = false
  else
    !this.isRotatable = true
    !this.isMoveable = true
  endif

endmethod
-- End of method .pipingSlopeComponent


------------------------------------------------------------------------
--
-- Method:   changesDirection()
--
-- Description: Test whether a component changes the branch direction
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
-- BOOLEAN     Returns true if the component changes the branch direction
--
------------------------------------------------------------------------

define method .changesDirection() is BOOLEAN
  !directionChanges = false

  if (!this.isBranch.not()) then
    !dbRef = !this.dbRef
    !arriveDirection = !dbRef.adir
    !leaveDirection = !dbRef.ldir

    -- Ignore any change of direction that is less than the ppoint offTol
    !tolerance = !dbRef.ppofftol[!dbRef.leave].abs()
    handle any
      -- In case an offTol could not be found, for example for a 'blob' elbow
      !tolerance = 0
    elsehandle none
      !tolerance = !tolerance + !dbRef.ppofftol[!dbRef.arrive].abs()
    endhandle
    if (!arriveDirection.angle(!leaveDirection) lt (180deg - !tolerance)) then
      !directionChanges = true
    endif

  endif
  return !directionChanges

endmethod
-- End of method .changesDirection


------------------------------------------------------------------------
--
-- Method:   getPosition()
--
-- Description: Returns the component position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- POSITION     Component  position
--
--
------------------------------------------------------------------------

define method .getPosition() is POSITION
  !component = !this.dbRef
  if (!component.type eq 'BRAN') then
    if (!this.isHead) then
      !position = !component.hposition.wrt(/* )
    else
      !position = !component.tposition.wrt(/* )
    endif
  else
    !position = !component.position.wrt( /* )
  endif

  return !position

endmethod
-- End of method .getPosition

------------------------------------------------------------------------
--
-- Method:   isBranch()
--
-- Description: Returns true if component is a branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- BOOLEAN     True if component is a branch
--
--
------------------------------------------------------------------------

define method .isBranch() is BOOLEAN

  return !this.isBranch

endmethod
-- End of method .isBranch

------------------------------------------------------------------------
--
-- Method:   isHead()
--
-- Description: Returns true if component is the head of a branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
-- BOOLEAN     True if component is the head of a branch
--
--
------------------------------------------------------------------------

define method .isHead() is BOOLEAN

  return !this.isHead

endmethod
-- End of method .isHead


------------------------------------------------------------------------
--
-- Method:   isTail()
--
-- Description: Returns true if component is the tail of a branch
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
-- BOOLEAN     True if component is the tail of a branch
--
--
------------------------------------------------------------------------

define method .isTail() is BOOLEAN

  return !this.isBranch and !this.isHead.not()

endmethod
-- End of method .isTail


------------------------------------------------------------------------
--
-- Method:   getBranch()
--
-- Description: Returns the branch for the component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- BOOLEAN     True if component is a branch
--
--
------------------------------------------------------------------------

define method .getBranch() is DBREF

  if (!this.isBranch) then
    return !this.dbRef
  else
    return !this.dbRef.owner

  endif

endmethod
-- End of method .getBranch

------------------------------------------------------------------------
--
-- Method:   dbRef()
--
-- Description: Returns the components database reference
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- DBREF       Component database reference
--
--
------------------------------------------------------------------------

define method .dbRef() is DBREF

  return !this.dbRef

endmethod
-- End of method .dbRef

------------------------------------------------------------------------
--
-- Method:   ltlen()
--
-- Description: Returns the leave tube length
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- REAL       Leave tube length
--
--
------------------------------------------------------------------------


define method .ltlen() is REAL

  return !this.dbRef.ltlen

endmethod
-- End of method .ltlen

------------------------------------------------------------------------
--
-- Method:   moveDown()
--
-- Description: Changes a components position to move it downwards by its offset
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .moveDown()

  if (abs(!this.offset) gt 0.001mm) then $* Arbitrary number...
    !position = !this.getPosition()
    !position.up = !position.up - !this.offset
    if (!this.isBranch) then
      if (!this.isHead) then
        !this.dbRef.hpos = !position
      else
        !this.dbRef.tpos = !position
      endif
    else
      !this.dbRef.pos = !position
    endif
  endif
endmethod

-- End of method .moveDown

------------------------------------------------------------------------
--
-- Method:   direct()
--
-- Description: Sets a component's direction and nominal direction - assumes forwards/backwards is correctly set
--              and that the calling routine will restore ce.
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .direct(!dir is DIRECTION, !arrive is BOOLEAN)

  if (!this.isRotatable(!dir)) then

    !componentRef = !this.dbRef
    !!ce = !componentRef
    if (!this.isBranch) then
      if (!this.isHead()) then
        hdir $!dir
        handle any
        endhandle
      else
        tdir $!dir
        handle any
        endhandle
      endif
    else
      if (!!ce.type inset ('ELBO', 'BEND')) then
        dir $!dir
        handle any
        endhandle
      else
        dir $!dir
        handle any
          if (!arrive) then
--            ori pl is pl and pa is $!dir
              ori pa is $!dir

          else
--            ori pa is pa and pl is $!dir
            ori pa is $!dir
          endif
        endhandle
      endif
      -- Set the nominal direction on the leave
      if (!componentRef.ppofftol[!componentRef.leave] ne 0deg) then
        if (!!pipeSlopeUtilities.isDirectionVertical(!componentRef.ldir)) then
          !dir = object DIRECTION('U')
        endif
        !componentRef.nomdir = !dir
        handle (41, 232) $* Current element does not have an attribute NOMDIR
        endhandle
      endif
    endif
   endif
endmethod
-- End of method .direct

------------------------------------------------------------------------
--
-- Method:   orient()
--
-- Description: Sets a component's orientation and nominal direction.
--              Assumes forwards mode and that any change to ce will be
--              reset by the calling method
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .orient(!dir is DIRECTION)

  !componentRef = !this.dbRef

  -- Set the nominal direction on the leave, arrive or p3 as appropriate
  if (!componentRef.ppofftol[!componentRef.leave] ne 0) then
    !leaveDir = !dir.opposite()
    !componentRef.nomdir = !leaveDir
  elseif (!componentRef.ppofftol[!componentRef.arrive] ne 0) then
    !componentRef.nomdir = !dir
  else
    !offTol = !componentRef.ppofftol[3]
    handle none
      if (!offTol gt 0deg) then
        !p3Dir = !componentRef.pDir[3]
        !componentRef.nomdir = !p3Dir
      endif
    elsehandle (2, 225) $* P3 no found
    endhandle
  endif

  if (!this.isRotatable.not()) then
    return
  endif

  !!ce = !componentRef
  !p3Dir = !componentRef.pDir[3]
  handle (2, 201)
--    ori
    -- Currently, a component won't orient on a direction if an offTol has been set. To get round this,
    -- if the arrive has an offTol then the leave is oriented instead. A component should not normally
    -- have an offTol set on both arrive and leave.
    if (!componentRef.ppofftol[!componentRef.arrive] ne 0) then
      !leaveDir = !dir.opposite()
       ori pl is $!leaveDir
       !componentRef.nomdir = !leaveDir
    else
      ori pa is $!dir
    endif
  elsehandle none
--    ori and p3 is $!p3Dir
--    handle (61, 7)
--      ori
--    endhandle

    ori pa is $!dir and p3 is $!p3Dir
    handle (61, 7)
      ori pa is $!p3Dir
    endhandle

  endhandle

endmethod
-- End of method .orient

------------------------------------------------------------------------
--
-- Method:   isMoveable()
--
-- Description: Test whether a component can be moved
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .isMoveable() is BOOLEAN

  return !this.isMoveable

endmethod
-- End of method .isMoveable

------------------------------------------------------------------------
--
-- Method:   isRotatable()
--
-- Description: Test whether a component is allowed to be rotated
--              towards a specific direction
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  DIRECTION   Direction to test against
--
-- Return:
-- [Data Type] [Description]
-- BOOLEAN     Returns true if the rotation is allowed
--
------------------------------------------------------------------------
define method .isRotatable(!dir is DIRECTION) is BOOLEAN

  if (!this.isRotatable.not()) then
    return false
  endif

  !dbRef = !this.dbRef

  if (not !this.isTee()) then
    return true
  endif

  -- Allow rotation if there is no connection to the component
  if (!dbRef.cref.unset()) then
    return true
  endif

  -- Find normal to plane of component
  !dir1 = !dbRef.pDirection[1]
  !dir2 = !dbRef.pDirection[2]

  if (!dir1.isParallel(!dir2)) then
    !dir2 = !dbRef.pDirection[3]
    !inlineDirection = !dir1
  elseif (!dir1.isParallel(!dbRef.pDirection[3])) then
    !inlineDirection = !dir1
  else
    !inlineDirection = !dir2
  endif

  -- Only allow rotation when the component arms are approximately orthogonal
  if (!dir1.angle(!dir2) lt 60deg) then
    return false
  endif

  !normal = !dir1.orthogonal(!dir2)

  -- Assess whether the component is nominally in the horizontal or vertical plane
  if (!normal.angle(object DIRECTION('U')).sine().abs() gt sine(60deg)) then
    !horizontal = false
  else
    !horizontal = true
  endif

  if (!horizontal) then
    -- Allow rotation only if the direction is nominally orthogonal to the inline direction of the component
    if (!dir.angle(!inlineDirection).sine().abs() gt sine(60deg)) then
      return true
    else
      return false
    endif
  endif

  return true

endmethod
-- End of method .isRotatable

------------------------------------------------------------------------
--
-- Method:   height()
--
-- Description: Returns the height of the component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- REAL        Height
--
------------------------------------------------------------------------

define method .height() is REAL

  !position = !this.getPosition()
  return !position.up

endmethod
-- End of method .height


------------------------------------------------------------------------
--
-- Method:   top()
--
-- Description: Returns the height of the top of component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- REAL        Height of the top of component
--
--
------------------------------------------------------------------------

define method .top() is REAL

  if (!this.isBranch) then
    !top = !this.getPosition().up
  else
    !arrivePosition = !this.dbRef.apos.wrt(/* )
    !leavePosition = !this.dbRef.lpos.wrt(/* )
    !top = !arrivePosition.up.max(!leavePosition.up)
  endif

  return !top - !this.offset

endmethod
-- End of method .top

------------------------------------------------------------------------
--
-- Method:   bottom()
--
-- Description: Returns the height of the top of component
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]

-- Return:
-- [Data Type] [Description]
-- REAL        Height of the top of component
--
--
------------------------------------------------------------------------
define method .bottom() is REAL

  if (!this.isBranch) then
    !bottom = !this.getPosition().up
  else
    !arrivePosition = !this.dbRef.apos.wrt(/* )
    !leavePosition = !this.dbRef.lpos.wrt(/* )
    !bottom = !arrivePosition.up.min(!leavePosition.up)
  endif
  return !bottom - !this.offset
endmethod
-- End of method .bottom

------------------------------------------------------------------------
--
-- Method:   setOffset()
--
-- Description: Set the components offset (downward) from its original position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Offset
--
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setOffset(!offset is REAL)

  if (!this.isMoveable) then
    !this.offset = !offset
  endif

endmethod
-- End of method .setOffset

------------------------------------------------------------------------
--
-- Method:   setAsRotatable()
--
-- Description: Set whether the component can be rotated
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      BOOL        True if component is rotatable
--
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setAsRotatable(!isRotatable is BOOLEAN)

  !this.isRotatable = !isRotatable

endmethod
-- End of method .setAsRotatable

------------------------------------------------------------------------
--
-- Method:   getOffset()
--
-- Description: Return the components offset (downward) from its original position
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
-- REAL         Offset
--
--
------------------------------------------------------------------------
define method .getOffset() is REAL

  return !this.offset

endmethod
-- End of method .getOffset

------------------------------------------------------------------------
--
-- Method:   shiftDown()
--
-- Description: Shifts a component downwards
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Shift  (downwards)
--
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .shiftDown(!shift is REAL)

  !this.offset = !this.offset + !shift

endmethod
-- End of method .shiftDown

------------------------------------------------------------------------
--
-- Method:   equals
--
-- Description: Compares this component to another, based on DBREF and branch head/tail status
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Shift
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the two components are equal
--
------------------------------------------------------------------------
define method .equals(!component is PIPESLOPECOMPONENT) is BOOLEAN

  if (!this.dbRef eq !component.dbRef) then
    if (!this.isBranch) then
      return (!this.isHead eq !component.isHead)
    else
      return true
    endif
  endif

  return false
endmethod
-- End of method .equals

------------------------------------------------------------------------
--
-- Method:   isHorizontalTee
--
-- Description: Tests whether a component is a tee in the horizontal plane
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the component is a tee in the horizontal plane
--
------------------------------------------------------------------------

define method .isHorizontalTee() is BOOLEAN

  if (!this.isTee()) then
    -- Create a plane from the tee ppoint positions
    !position1 = !this.dbRef.ppos[1]
    !position2 = !this.dbRef.ppos[2]
    !position3 = !this.dbRef.ppos[3]
    !plane = !position1.plane(!position2, !position3)
    -- Find plane normal
    !normal = !plane.pointVector().direction
    return !!pipeSlopeUtilities.isDirectionVertical(!normal)
  else
    return false
  endif

endmethod
-- End of method isHorizontalTee
------------------------------------------------------------------------
--
-- Method:   isTee
--
-- Description: Tests whether a component is a tee
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the component is a tee
--
------------------------------------------------------------------------
define method .isTee() is BOOLEAN
  return ( !this.dbRef.type eq 'TEE' )
endmethod
-- End of method isTee

------------------------------------------------------------------------
--
-- Method:   isSupportAttachment
--
-- Description: Tests whether a component is a support attachment
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the component is a support attachment
--
------------------------------------------------------------------------

define method .isSupportAttachment() is BOOLEAN

  return (!this.dbRef.type eq 'ATTA' and (!this.dbRef.atty inset ('', 'WELD', 'HANG')))

endmethod
-- End of method isSupportAttachment
