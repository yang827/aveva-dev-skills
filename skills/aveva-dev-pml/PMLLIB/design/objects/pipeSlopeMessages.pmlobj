-- Last Modified:
-- Description:
-- Maintains a list of errors and messages generated by the Sloping Pipes form
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAlert(STRING)                 -                   Add an alert to the list
--  addError(STRING)                 -                   Add an error to the list
--  addMessage(STRING)               -                   Add a message to the list
--  addWarning(STRING)               -                   Add a warning to the list
--  clear()                          -                   Remove all messages
--  getMessages(ARRAY)               -                   Returns all the available messages
--  messageCount()                   REAL                Returns the number of messages
--

------------------------------------------------------------------------
--
------------------------------------------------------------------------

define object PIPESLOPEMESSAGES

  member .severity is ARRAY
  member .text     is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:   .addAlert
--
-- Description: Add an alert to the list
--
-- Method Type: Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Warning text
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addAlert(!alertText is STRING)

  !this.severity.append('Alert')
  !this.text.append(!alertText)
  if (!!ttyMode().not()) then
    !!alert.warning(!alertText)
  endif

endmethod
-- End of method .addWarning

------------------------------------------------------------------------
--
-- Method:   .addError
--
-- Description: Add an error to the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Error text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addError(!errorText is STRING)

  !this.severity.append('Error')
  !this.text.append(!errorText)

endmethod
-- End of method .addError

------------------------------------------------------------------------
--
-- Method:   .addMessage
--
-- Description: Add a message to the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Message text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addMessage(!messageText is STRING)

  !this.severity.append('Message')
  !this.text.append(!messageText)

endmethod
-- End of method .addMessage

------------------------------------------------------------------------
--
-- Method:   .addWarning
--
-- Description: Add a warning to the list
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      STRING      Warning text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addWarning(!warningText is STRING)

  !this.severity.append('Warning')
  !this.text.append(!warningText)

endmethod
-- End of method .addWarning

------------------------------------------------------------------------
--
-- Method:   .clear
--
-- Description: Remove all messages
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clear()

  !this.severity = ARRAY()
  !this.text = ARRAY()

endmethod
-- End of method .clear

------------------------------------------------------------------------
--
-- Method:   .messageCount
--
-- Description: Returns the number of messages
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Number of messages
--
------------------------------------------------------------------------
define method .messageCount() is REAL

  return !this.text.size()

endmethod
-- End of method .messageCount

------------------------------------------------------------------------
--
-- Method:   .getMessages
--
-- Description: Returns all the available messages
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   RW     ARRAY       Array to store the messages
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getMessages(!messages is ARRAY)

  do !index indices !this.severity
    !row[1] = !this.severity[!index]
    !row[2] = !this.text[!index]
    !messages.append(!row)
  enddo

endmethod
-- End of method .getMessages
