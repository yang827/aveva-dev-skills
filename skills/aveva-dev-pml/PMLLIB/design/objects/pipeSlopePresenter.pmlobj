------------------------------------------------------------------------
--
-- Method:   findBranchLegIndex
--
-- Description: Given a database reference, finds the branch leg index
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       Any database element
-- Return:
-- [Data Type] [Description]
--  REAL        The branch leg index or zero
--
------------------------------------------------------------------------

define method .findBranchLegIndex(!element is DBREF) is REAL

  !legIndex = 0

  !findBranch = object EXPRESSION('BRAN')
  !branch = !findBranch.evaluate(!element)

  if (!branch.set()) then
    !legIndex = !this.pipeSlope.getBranchLegIndex(!branch, !element)
  endif

  return !legIndex

endmethod
-- End of method .findBranchLegIndex


------------------------------------------------------------------------
--
-- Method:   saveState
--
-- Description: Save the current state
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .saveState()

  -- Make a copy of this object but delete the copied savedState array to
  -- prevent an exponential growth in the amount of saved information
  !this.savedStates.append(!this)
  !this.savedStates[!this.savedStates.size()].savedStates.clear()

endmethod

-- End of method .saveState

------------------------------------------------------------------------
--
-- Method:   back
--
-- Description: Restores the last saved state
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .back()

  if (!this.savedStates.empty().not()) then

     -- Remove last entry from the stack
    !lastState = !this.savedStates.removeLast()

    -- Restore all attributes except the savedStack
    !this.angle             = !lastState.angle
    !this.pipe              = !lastState.pipe
    !this.pipeSlope         = !lastState.pipeSlope
    !this.currentLegIndex   = !lastState.currentLegIndex
    !this.currentBranchLeg  = !lastState.currentBranchLeg
    !this.forwards          = !lastState.forwards
    !this.anchorNumber      = !lastState.anchorNumber
    !this.canApply          = !lastState.canApply
  endif

endmethod
-- End of method .back

------------------------------------------------------------------------
--
-- Method:   canApply
--
-- Description: Tests whether an apply operation can be performed
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if a back operation can be performed
--
------------------------------------------------------------------------
define method .canApply() is BOOLEAN

  return !this.canApply

endmethod
-- End of method .canApply

------------------------------------------------------------------------
--
-- Method:   canGoBack
--
-- Description: Tests whether an back operation can be performed
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if a back operation can be performed
--
------------------------------------------------------------------------
define method .canGoBack() is BOOLEAN

  return !this.savedStates.empty().not()

endmethod
-- End of method .canGoBack

------------------------------------------------------------------------
--
-- Method:   canSlopeCurrentBranchLeg
--
-- Description: Tests whether the slope for the current branch leg can be modified
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if a branch can be modified
--
------------------------------------------------------------------------
define method .canSlopeCurrentBranchLeg() is BOOLEAN

  return !this.currentBranchLeg.getSlopeLength() ge !!pipeSlopeUtilities.distanceTolerance

endmethod
-- End of method .canSlopeCurrentBranchLeg

------------------------------------------------------------------------
--
-- Method:   quit
--
-- Description: Used to tidy up when the owning form is closed or hidden
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .quit()

  !this.pipe = object DBREF()
  !this.pipeSlope = object PIPESLOPE()
  !this.savedStates.clear()

endmethod
-- End of method .canGoBack
